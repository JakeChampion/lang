@noinline
function raw_arr_box(x: f64): f64 {
  return x + 1.0;
}

@noinline
function overwrite(p: usize): i32 {
  __store_i32(p, 7);
  return 0;
}

@noinline
function live(n: i32): i32[] {
  overwrite(__raw_scratch(8));
  return __raw_array(__raw_arr_box(n));
}

@noinline
function fresh(n: i32): i32[] {
  return __raw_array(__raw_arr_box(n));
}

@noinline
function many(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64, j: i64, k: i64, l: i64, n: i32): i32[] {
  return __raw_array(__raw_arr_box((a + b + c + d + e + f + g + h + i + j + k + l) as i32 + n));
}

@noinline
function cleanup(own old: i32[], n: i32): i32[] {
  let p: usize = __raw_arr_box(n);
  __store_i64(p + 8, old[0] as i64);
  return __raw_array(p);
}

@noinline
function checked_cleanup(n: i32): i32 {
  let c: i32[] = cleanup([n], 1);
  return c[0];
}

function main(): i32 {
  let a: i32[] = fresh(3);
  let b: i32[] = many(1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64, 10i64, 11i64, 12i64, 2);
  let c: i32 = checked_cleanup(17);
  let d: i32[] = live(5);
  if (a.len() != 3 || b.len() != 80 || c != 17 || d.len() != 5 || raw_arr_box(1.25) != 2.25) {
    return 91;
  }
  return 0;
}
