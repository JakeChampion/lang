import "./kernel";
import "./linear";
import "std/binary";

function reference(view: kernel.View, offset: i64, radius: f64): Option[linear.Reference] {
  let real: f64 = -2.5 + ((view.x + 128 + offset) as f64 + 0.5) * view.step;
  let imaginary: f64 = 2.0 - ((view.y + 128) as f64 + 0.5) * view.step;
  let ref: linear.Reference = linear.reference(real, imaginary, radius * view.step, view.limit, 1e-8);
  let first: linear.Start = linear.prefix(ref, -2.5 + (view.x as f64 + 0.5) * view.step, 2.0 - (view.y as f64 + 0.5) * view.step, view.limit);
  if (first.steps >= 64) { return Some(ref); }
  return None;
}

function count(pixels: kernel.Pixels, at: i32): i32 {
  if (f64_from_bits(pixels.magnitudes[at]) <= 0.0) { return -1; }
  return pixels.counts[at];
}

function sample(z: i32, x: i64, y: i64): void {
  let step: f64 = 4.0 / ((1 as i64 << (z + 8) as i64) as f64);
  let view: kernel.View = kernel.View { size: 256, x: x * 256, y: y * 256, step: step, limit: 256 + 64 * z };
  let ref: Option[linear.Reference] = None;
  let neighbor: Option[linear.Reference] = None;
  if (z >= 20) {
    ref = reference(view, 0, 182.0);
    // The larger radius includes the same tile when the center moves east.
    neighbor = reference(view, 256, 406.0);
  }
  let direct: kernel.Pixels = kernel.render(view, None);
  let accelerated: kernel.Pixels = kernel.render(view, ref);
  let shifted: kernel.Pixels = kernel.render(view, neighbor);
  let seed: i64 = (x ^ y ^ z as i64 * 131) & 4294967295;
  let index: i32 = 0;
  while (index < 801) {
    let px: i32 = 0;
    let py: i32 = 0;
    if (index < 289) {
      px = index % 17 * 255 / 16;
      py = index / 17 * 255 / 16;
    } else if (index < 545) {
      seed = (seed * 1664525 + 1013904223) & 4294967295;
      px = (seed >> 24) as i32;
      seed = (seed * 1664525 + 1013904223) & 4294967295;
      py = (seed >> 24) as i32;
    } else {
      let edge: i32 = index - 545;
      let at: i32 = edge / 4 * 255 / 63;
      if (edge % 4 == 0) { px = 0; py = at; }
      if (edge % 4 == 1) { px = 255; py = at; }
      if (edge % 4 == 2) { px = at; py = 0; }
      if (edge % 4 == 3) { px = at; py = 255; }
    }
    let at: i32 = py * 256 + px;
    let real: f64 = -2.5 + ((view.x + px as i64) as f64 + 0.5) * step;
    let imaginary: f64 = 2.0 - ((view.y + py as i64) as f64 + 0.5) * step;
    let bytes: u8[] = binary.append_u64_be([], f64_bits(real) as u64);
    bytes = binary.append_u64_be(bytes, f64_bits(imaginary) as u64);
    bytes = binary.append_u32_be(bytes, view.limit as u32);
    bytes = binary.append_u32_be(bytes, count(accelerated, at) as u32);
    bytes = binary.append_u32_be(bytes, count(direct, at) as u32);
    bytes = binary.append_u32_be(bytes, count(shifted, at) as u32);
    match (stdout().write_bytes(bytes)) { Ok(_) => {}, Err(_) => { exit(1); }, }
    index = index + 1;
  }
}
function main(): i32 {
CALLS
  return 0;
}
