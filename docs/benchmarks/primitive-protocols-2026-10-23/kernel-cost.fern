import "std/f64";
import "std/utf8";
import "std/string";
import "std/i32";

function main(): i32 {
  let before: i64 = __heap_alloc_count();
  let checksum: i32 = 0;
  let i: i32 = 0;
  while (i < 10000) {
    let n: f64 = (i as f64 - 5000.0) / 7.0;
    checksum = checksum + n.to_string().len() + n.to_string_prec(4).len();
    let c: char = (i * 113 % 1114112) as char;
    checksum = checksum + utf8.utf8_encode(c).len() + string.string_from_codepoint(c).len();
    i = i + 1;
  }
  let allocations: i64 = __heap_alloc_count() - before;
  print(checksum);
  print(allocations);
  return 0;
}
