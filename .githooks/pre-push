#!/usr/bin/env bash
# pre-push — the cheap lint gates, before a slip costs a CI round trip.
# The source lints are here because they hold the tables that a new fixture,
# document or stdlib module needs a row in.
#
# Installed per clone by `make hooks` (core.hooksPath). Runs the part of
# `make lint-all` that finishes in seconds and fails CI most often;
# check-sources, deadcode and freeze stay in CI's lint lane. `make fmt-check`
# rebuilds bin/fern, and that compiles the compiler with the stage0 pin when
# compiler/ or the stdlib changed, so a construct that stage0 cannot compile
# fails here. The hook also checks each program file that the push changes
# alone (scripts/check-changed-programs), and compares the lint ratchets with
# the main that the push is on (scripts/check-ratchets), for a push of
# the checked-out branch. Keeps going after a failure and reports the set, like lint-all.
# `git push --no-verify` skips it.
set -uo pipefail

# A push that only deletes refs has nothing to lint. A branch is compared
# with its merge base on origin/main, as CI compares it: after a merge of
# main, the changes of main are not the changes of the branch.
zero=0000000000000000000000000000000000000000
deleting_only=yes
ranges=()
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    "$zero") continue ;;
  esac
  deleting_only=no
  [ "$local_sha" = "$(git rev-parse HEAD)" ] || continue
  base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || continue
  ranges+=("$base $local_sha")
done
[ "$deleting_only" = no ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

status=0
for gate in "go build ./..." "go vet ./..." "make gofmt-check" "make fmt-check" \
            "make actionlint" "make testnames" \
            "go test ./internal/testing/sourcelint/"; do
  echo "pre-push ==> $gate"
  if ! sh -c "$gate"; then echo "pre-push FAILED: $gate"; status=1; fi
done
if [ "${#ranges[@]}" -gt 0 ]; then
  for range in "${ranges[@]}"; do
    echo "pre-push ==> scripts/check-changed-programs $range"
    # shellcheck disable=SC2086
    if ! scripts/check-changed-programs $range; then echo "pre-push FAILED: check-changed-programs"; status=1; fi
    # A merge of main brings the findings of main, so compare with the main
    # that the push is on, as the Lint lane does.
    base=$(git merge-base "${range##* }" origin/main 2>/dev/null) || base=${range%% *}
    echo "pre-push ==> scripts/check-ratchets $base"
    if ! scripts/check-ratchets "$base"; then echo "pre-push FAILED: check-ratchets"; status=1; fi
  done
fi
if [ "$status" -ne 0 ]; then
  echo "pre-push: fix the failures above, or 'git push --no-verify' to push anyway" >&2
fi
exit $status
