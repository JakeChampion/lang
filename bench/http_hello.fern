import "std/http";

function main(): i32 {
  let wire: string = "GET /hello HTTP/1.1\r\nHost: bench\r\nUser-Agent: perf-bench\r\nAccept: */*\r\n\r\n";
  let total: i64 = 0i64;
  let i: i32 = 0;
  while (i < 4000) {
    match (http.http_parse_request(wire)) {
      Some(req) => {
        let resp: HttpResponse = http.ok("hello " + req.path);
        let out: string = http.http_serialize_response(resp);
        total = total + (out.len() + req.headers.len()) as i64;
      },
      None => {
        return 100;
      }
    }
    i = i + 1;
  }
  return (total % 97i64) as i32;
}
