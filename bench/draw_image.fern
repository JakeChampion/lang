import "std/android/draw";

function main(): i32 {
  let px = __alloc_u8(600 * 300 * 4);
  let s = 7;
  for i in 0..600 * 300 * 4 {
    s = s * 1103515245 + 12345 & 2147483647;
    px = px.with(i, (s >> 19 & 255) as u8);
  }
  let img = draw.Image { width: 600, height: 300, pixels: px };
  let f = draw.offscreen(512, 256);
  for r in 0..64 {
    f.image(r % 3 - 1, 0, 512, 256, img);
  }
  let acc = 0;
  for y in 0..256 {
    acc = acc * 31 + f.pixel(y * 2 + 1, y);
  }
  draw.release(f);
  return (acc & 2147483647) % 97;
}
