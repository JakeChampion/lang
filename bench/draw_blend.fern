import "std/android/draw";

// A frame of w by h pixels, each with all four bytes set from a seed.
function noisy(w: i32, h: i32, seed: i32): draw.Frame {
  let f = draw.offscreen(w, h);
  let s = seed;
  for y in 0..h {
    for x in 0..w {
      s = s * 1103515245 + 12345 & 2147483647;
      f.store(x, y, 1, 1, s >> 3);
    }
  }
  return f;
}

function main(): i32 {
  let f = noisy(512, 256, 7);
  let layer = noisy(512, 256, 11);
  for r in 0..64 {
    f.blend_frame(layer, 0, 0, 3 + r * 4);
  }
  let acc = 0;
  for y in 0..256 {
    acc = acc * 31 + f.pixel(y * 2 + 1, y);
  }
  draw.release(layer);
  draw.release(f);
  return (acc & 2147483647) % 97;
}
