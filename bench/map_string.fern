import "core/map";
import "std/i32";

function main(): i32 {
  let m: Map[string, i32] = Map { };
  let keys: string[] = [];
  for i in 0..4000 {
    let k = f"checker__symbol_{i}";
    keys = keys.append(k);
    m = m.insert(k, i);
  }
  let total = 0i64;
  for _ in 0..40 {
    let j = 0;
    while (j < keys.len()) {
      total += m.get_or(keys[j], 0) as i64;
      j += 1;
    }
  }
  return (total % 97i64) as i32;
}
