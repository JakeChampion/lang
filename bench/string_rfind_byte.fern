import "std/string";

function haystack(): string {
  let s = "abcdefghijklmnopqrstuvwxyz012345";
  for _ in 0..10 {
    s = s + s;
  }
  return "abc!" + s;
}

function main(): i32 {
  let hay = haystack();
  let acc = 0;
  for _ in 0..6000 {
    if let Some(i) = hay.last_index_of("!") {
      acc += i;
    } else {
      acc -= 1;
    }
  }
  return acc % 97;
}
