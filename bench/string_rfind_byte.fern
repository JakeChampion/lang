import "std/string";

function haystack(): string {
  let s: string = "abcdefghijklmnopqrstuvwxyz012345";
  let k: i32 = 0;
  while (k < 10) {
    s = s + s;
    k = k + 1;
  }
  return "abc!" + s;
}

function main(): i32 {
  let hay: string = haystack();
  let acc: i32 = 0;
  let r: i32 = 0;
  while (r < 6000) {
    match (hay.last_index_of("!")) {
      Some(i) => {
        acc = acc + i;
      },
      None => {
        acc = acc - 1;
      }
    }
    r = r + 1;
  }
  return acc % 97;
}
