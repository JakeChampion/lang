import "std/i32";

function build(n: i32): string[] {
  let out: string[] = [];
  for i in 0..n {
    out = out.append("checker__lookup_symbol_" + i.to_string());
  }
  return out;
}

function find(names: string[], needle: string): i32 {
  let i = 0;
  while (i < names.len()) {
    if (names[i] == needle) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function main(): i32 {
  let names = build(400);
  let hits = 0i64;
  for _ in 0..400 {
    for k in 0..20 {
      hits += find(names, "checker__lookup_symbol_" + (k * 19).to_string()) as i64;
    }
  }
  return (hits % 97i64) as i32;
}
