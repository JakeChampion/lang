import "std/utf8" as utf8;

function body(): string {
  let block: string = "a";
  let k: i32 = 0;
  while (k < 10) {
    block = block + block;
    k = k + 1;
  }
  let s: string = block + "é";
  let d: i32 = 0;
  while (d < 6) {
    s = s + s;
    d = d + 1;
  }
  return s;
}

function main(): i32 {
  let text: string = body();
  let acc: i32 = 0;
  let r: i32 = 0;
  while (r < 1500) {
    if (utf8.is_valid(text)) {
      acc = acc + 1;
    }
    r = r + 1;
  }
  return acc % 97;
}
