import "std/utf8" as utf8;

function body(): string {
  let block = "a";
  for _ in 0..10 {
    block = block + block;
  }
  let s = block + "é";
  for _ in 0..6 {
    s = s + s;
  }
  return s;
}

function main(): i32 {
  let text = body();
  let acc = 0;
  for _ in 0..1500 {
    if (utf8.is_valid(text)) {
      acc += 1;
    }
  }
  return acc % 97;
}
