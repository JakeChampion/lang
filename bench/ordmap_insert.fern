import "std/ordmap";

function main(): i32 {
  let m: ordmap.OrdMap[i32, i32] = ordmap.new();
  for i in 0..4000 {
    m = m.insert(i * 7, i);
  }
  for r in 0..20 {
    for j in 0..4000 {
      m = m.insert(j * 7, j + r);
    }
  }
  let total = 0i64;
  for i in 0..4000 {
    total += m.get_or(i * 7, 0) as i64;
  }
  return (total % 97i64) as i32;
}
