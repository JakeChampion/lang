import "std/string";

function haystack(): string {
  let s = "abcdefghijklmnopqrstuvwxyz012345";
  for _ in 0..10 {
    s = s + s;
  }
  return s;
}

function main(): i32 {
  let hay = haystack();
  let acc = 0;
  for _ in 0..6000 {
    acc = acc + hay.count_byte(b'a') + hay.count_byte(b'b');
  }
  return acc % 97;
}
