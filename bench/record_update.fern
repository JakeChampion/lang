struct Blk { buf: u8[], note: string, n: i32 }

function (b: Blk) put(i: i32, v: u8): Blk {
  return Blk { ...b, buf: b.buf.with(i, v) };
}

function main(): i32 {
  let buf: u8[] = [];
  for _ in 0..4096 {
    buf = buf.append(0u8);
  }
  let b = Blk { buf: buf, note: "a refcounted field the update carries", n: 0 };
  let total = 0i64;
  for r in 0..400 {
    for i in 0..4096 {
      b = b.put(i, ((i + r) % 251) as u8);
    }
    total += b.buf[r % 4096] as i64;
  }
  return (total % 97i64) as i32;
}
