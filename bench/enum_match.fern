enum Node { Leaf(i32), Label(string), Pair(i32), Empty }

function weigh(n: Node): i32 {
  return match (n) { Leaf(v) => v * 2, Label(s) => s.len(), Pair(v) => v + 1, Empty => 0 };
}

function make(k: i32): Node {
  if (k % 4 == 0) {
    return Leaf(k);
  }
  if (k % 4 == 1) {
    return Label("node_label_" + "padding");
  }
  if (k % 4 == 2) {
    return Pair(k);
  }
  return Empty;
}

function main(): i32 {
  let total = 0i64;
  for i in 0..900000 {
    total += weigh(make(i)) as i64;
  }
  return (total % 97i64) as i32;
}
