import "core/map";
import "std/bench";
import "std/i32";
import "std/u64";
import "./shared";

function build(keys: string[]): Map[string, u64] {
  let m: Map[string, u64] = Map { };
  for i in 0..keys.len() {
    m = m.insert(keys[i], i as u64);
  }
  return m;
}

function main(): i32 {
  let p = shared.params(args());
  let keys = shared.string_keys(p.n);
  let m = build(keys);
  let probe = shared.order(p.n);
  let sum: u64 = 0;
  let r = bench.run("map_string", 1, p.rounds, () => {
    let j = 0;
    while (j < probe.len()) {
      sum += m.get_or(keys[probe[j]], 0);
      j += 1;
    }
  });
  shared.report("Map[string,u64]", p.n, r.wall_ns, p.rounds, sum);
  return 0;
}
