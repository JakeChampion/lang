import "core/map";
import "std/bench";
import "std/u64";
import "./shared";

function build(n: i32): Map[i32, i32] {
  let m: Map[i32, i32] = Map { };
  for i in 0..n {
    m = m.insert(i * 7, i);
  }
  return m;
}

function main(): i32 {
  let p = shared.params(args());
  let m = build(p.n);
  let probe = shared.order(p.n);
  let sum: u64 = 0;
  let r = bench.run("map_int", 1, p.rounds, () => {
    let j = 0;
    while (j < probe.len()) {
      sum += m.get_or(probe[j] * 7, 0) as u64;
      j += 1;
    }
  });
  shared.report("Map[i32,i32]", p.n, r.wall_ns, p.rounds, sum);
  return 0;
}
