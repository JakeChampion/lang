import "std/bench";
import "std/constmap";
import "std/i32";
import "std/i64";
import "std/u64";
import "std/result";
import "./shared";

function values_of(n: i32): u64[] {
  let values: u64[] = [];
  for i in 0..n {
    values = values.append(i as u64);
  }
  return values;
}

function main(): i32 {
  let p = shared.params(args());
  let keys = shared.string_keys(p.n);
  let values = values_of(p.n);
  let probe = shared.order(p.n);
  let builds = 0;
  let built = bench.run("constmap_build", 0, 1, () => {
    let b = constmap.new(keys, values);
    if (b.is_ok()) {
      builds += 1;
    }
  });
  let m = match (constmap.new(keys, values)) { Ok(built_map) => built_map, Err(e) => { print("build failed: " + e); return 1; } };
  let sum: u64 = 0;
  let r = bench.run("constmap", 1, p.rounds, () => {
    let j = 0;
    while (j < probe.len()) {
      sum += m.map(keys[probe[j]]);
      j += 1;
    }
  });
  shared.report("constmap.ConstMap", p.n, r.wall_ns, p.rounds, sum);
  print(f"constmap.ConstMap\tn={p.n}\tbuild_ms={built.wall_ns / 1000000i64}.{built.wall_ns / 100000i64 % 10i64}");
  let v = match (constmap.verified_new(keys, values)) { Ok(built_v) => built_v, Err(e) => { print("build failed: " + e); return 1; } };
  sum = 0;
  let rv = bench.run("verified", 1, p.rounds, () => {
    let j = 0;
    while (j < probe.len()) {
      sum += v.get_or(keys[probe[j]], 0);
      j += 1;
    }
  });
  shared.report("constmap.VerifiedConstMap", p.n, rv.wall_ns, p.rounds, sum);
  return 0;
}
