import "./perceus/cfold";

function main(): i32 {
  let sum = 0i64;
  for _ in 0..400 {
    let e = cfold.mk_expr(8, 1i64);
    let before = cfold.eval(e);
    let after = cfold.eval(cfold.cfold(cfold.reassoc(e)));
    if (before != after) {
      return 125;
    }
    sum = sum + before + after;
  }
  return (sum % 97i64) as i32;
}
