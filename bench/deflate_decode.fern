import "std/deflate";

function text(n: i32): u8[] {
  let words: string[] = ["the ", "of ", "and ", "a ", "to ", "in ", "is ", "you ", "that ", "it ", "he ", "was ", "for ", "on ", "are ", "as ", "with ", "his ", "they ", "at ", "be ", "this ", "have ", "from ", "or ", "one ", "had ", "by ", "word ", "but ", "not ", "what ", "all ", "were ", "we ", "when ", "your ", "can ", "said ", "there ", "use ", "an ", "each ", "which ", "she ", "do ", "how ", "their ", "if ", "will. "];
  let out: u8[] = [];
  let seed = 12345;
  while (out.len() < n) {
    seed = seed * 1103515245 + 12345 & 2147483647;
    let w = words[(seed >> 16) % words.len()].as_bytes();
    for i in 0..w.len() {
      out = out.append(w[i]);
    }
  }
  return out;
}

function main(): i32 {
  let input = text(32768);
  let z = deflate.deflate(input);
  let acc = 0;
  for r in 0..32 {
    let Ok(got) = deflate.inflate(z, input.len()) else {
      return 120;
    };
    acc = acc + got.out.len() + got.out[r * 997] as i32;
  }
  return acc % 97;
}
