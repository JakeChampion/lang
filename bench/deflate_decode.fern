import "std/deflate";

// deflate_decode — std/deflate decoding a stream of 32 KiB of generated text.
//
// The same kind of text as deflate_encode, compressed once and decoded 32
// times, so most of the count is the decoder's: Huffman decoding, match
// copies and the output appends. The one encode is about a fifth of it.
// scripts/deflate-bench compares the same decoder with libdeflate by wall
// time; this is its gate.
function text(n: i32): u8[] {
  let words: string[] = ["the ", "of ", "and ", "a ", "to ", "in ", "is ", "you ", "that ", "it ", "he ", "was ", "for ", "on ", "are ", "as ", "with ", "his ", "they ", "at ", "be ", "this ", "have ", "from ", "or ", "one ", "had ", "by ", "word ", "but ", "not ", "what ", "all ", "were ", "we ", "when ", "your ", "can ", "said ", "there ", "use ", "an ", "each ", "which ", "she ", "do ", "how ", "their ", "if ", "will. "];
  let out: u8[] = [];
  let seed: i32 = 12345;
  while (out.len() < n) {
    seed = seed * 1103515245 + 12345 & 2147483647;
    let w: [u8] = words[(seed >> 16) % words.len()].as_bytes();
    let i: i32 = 0;
    while (i < w.len()) {
      out = out.append(w[i]);
      i = i + 1;
    }
  }
  return out;
}

function main(): i32 {
  let input: u8[] = text(32768);
  let z: u8[] = deflate.deflate(input);
  let acc: i32 = 0;
  let r: i32 = 0;
  while (r < 32) {
    match (deflate.inflate(z, input.len())) {
      Ok(got) => {
        acc = acc + got.out.len() + got.out[r * 997] as i32;
      },
      Err(e) => {
        return 120;
      }
    }
    r = r + 1;
  }
  return acc % 97;
}
