import "std/crypto/x25519";
import "std/hex";
import "std/codec";

function main(): i32 {
  let key = __codec_bytes(hex.decode("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"));
  let sum = 0;
  for i in 0..8192 {
    let Ok(out) = x25519.public_key(key) else {
      return 1;
    };
    sum += out[i % 32] as i32;
  }
  print(sum.to_string());
  return 0;
}

function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
