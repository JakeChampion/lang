// Count allocations during RFC 7748 public-key generation, without networking.
import "std/crypto/x25519";
import "std/hex";
import "std/codec";
import "std/i64";
import "core/int";

function main(): i32 {
  let key = __codec_bytes(hex.decode("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"));
  let before = __heap_alloc_count();
  let sum = 0;
  let i = 0;
  while (i < 64) {
    match (x25519.public_key(key)) {
      Ok(out) => {
        sum = sum + out[i % 32] as i32;
      },
      Err(_) => {
        return 1;
      }
    }
    i = i + 1;
  }
  let allocations = __heap_alloc_count() - before;
  print(allocations.to_string());
  print(int.int_to_string(sum));
  return 0;
}

// Decode a valid fixture. Report a malformed fixture before ending the test.
function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
