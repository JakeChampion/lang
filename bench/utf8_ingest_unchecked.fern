import "std/json";
import "std/utf8" as utf8;
import "std/string";

function body_bytes(): u8[] {
  let one = "{\"id\":1042,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.com\",\"tags\":[\"engineer\",\"analyst\",\"pioneer\"],\"active\":true,\"score\":99.5,\"note\":\"café — naïve résumé, 中文, 𝄞\"}";
  let out = "";
  for _ in 0..24 {
    out = out + one;
  }
  return out.bytes();
}

function main(): i32 {
  let b = body_bytes();
  let acc = 0;
  let round = 0;
  while (round < 200) {
    match (Some(unsafe { string_from_bytes_unchecked(b) })) {
      Some(s) => {
        match (json.parse(s)) {
          Ok(_) => {
            acc += 1;
          },
          Err(_) => {
            acc += 2;
          }
        }
      },
      None => {
        acc += 4;
      }
    }
    round += 1;
  }
  if (acc == 0) {
    return 1;
  }
  return 0;
}
