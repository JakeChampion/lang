// Ingest path WITHOUT validation — the pre-invariant baseline:
// bytes -> string_from_bytes_unchecked -> json_parse.
import "std/json";
import "std/utf8" as utf8;
import "std/string";

function body_bytes(): u8[] {
  let one: string = "{\"id\":1042,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.com\",\"tags\":[\"engineer\",\"analyst\",\"pioneer\"],\"active\":true,\"score\":99.5,\"note\":\"café — naïve résumé, 中文, 𝄞\"}";
  let out: string = "";
  let i: i32 = 0;
  while (i < 24) {
    out = out + one;
    i = i + 1;
  }
  return out.bytes();
}

function main(): i32 {
  let b: u8[] = body_bytes();
  let acc: i32 = 0;
  let round: i32 = 0;
  while (round < 200) {
    match (Some(string_from_bytes_unchecked(b))) {
      Some(s) => {
        match (json.json_parse(s)) {
          Some(_) => {
            acc = acc + 1;
          },
          None => {
            acc = acc + 2;
          }
        }
      },
      None => {
        acc = acc + 4;
      }
    }
    round = round + 1;
  }
  if (acc == 0) {
    return 1;
  }
  return 0;
}
