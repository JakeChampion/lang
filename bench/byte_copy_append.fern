@noinline
function data(n: i32): u8[] {
  let a = __alloc_u8(n);
  for i in 0..n {
    a = a.with(i, (i + 1) as u8);
  }
  return a;
}

@noinline
function cat(own a: u8[], src: u8[]): u8[] {
  for i in 0..src.len() {
    a = a.append(src[i]);
  }
  return a;
}

@noinline
function checksum(a: u8[]): i32 {
  let s = 0;
  for i in 0..a.len() {
    s += a[i] as i32;
  }
  return s;
}

function main(): i32 {
  let src = data(16384);
  let a: u8[] = [];
  for _ in 0..3000 {
    let empty: u8[] = [];
    a = cat(empty, src);
  }
  if (checksum(a) != 2088960) {
    return 1;
  }
  return 0;
}
