pub enum Expr { Val(i64), Var(string), Add(Expr, Expr), Mul(Expr, Expr), Pow(Expr, Expr), Ln(Expr) }

function pown(a: i64, b: i64): i64 {
  if (b == 0i64) {
    return 1i64;
  }
  if (a == 0i64 || a == 1i64) {
    return a;
  }
  if (a == -1i64) {
    if (b % 2i64 == 0i64) {
      return 1i64;
    }
    return -1i64;
  }
  if (b < 0i64) {
    return 0i64;
  }
  let result = 1i64;
  while (b > 0i64) {
    if (b % 2i64 != 0i64) {
      result *= a;
      b -= 1i64;
    }
    if (b > 0i64) {
      b /= 2i64;
      a *= a;
    }
  }
  return result;
}

pub function add(left: Expr, right: Expr): Expr {
  if let Val(n) = left {
    if let Val(m) = right {
      return Val(n + m);
    }
    if (n == 0i64) {
      return right;
    }
  }
  match (right) {
    Val(m) => {
      if (m == 0i64) {
        return left;
      }
      return add(Val(m), left);
    },
    Add(Val(m), f) => {
      if let Val(n) = left {
        return add(Val(n + m), f);
      }
      return add(Val(m), add(left, f));
    },
    _ => {}
  }
  if let Add(f, g) = left {
    return add(f, add(g, right));
  }
  return Add(left, right);
}

pub function mul(left: Expr, right: Expr): Expr {
  if let Val(n) = left {
    if let Val(m) = right {
      return Val(n * m);
    }
    if (n == 0i64) {
      return Val(0i64);
    }
  }
  if let Val(m) = right {
    if (m == 0i64) {
      return Val(0i64);
    }
  }
  if let Val(n) = left {
    if (n == 1i64) {
      return right;
    }
  }
  match (right) {
    Val(m) => {
      if (m == 1i64) {
        return left;
      }
      return mul(Val(m), left);
    },
    Mul(Val(m), f) => {
      if let Val(n) = left {
        return mul(Val(n * m), f);
      }
      return mul(Val(m), mul(left, f));
    },
    _ => {}
  }
  if let Mul(f, g) = left {
    return mul(f, mul(g, right));
  }
  return Mul(left, right);
}

pub function powr(left: Expr, right: Expr): Expr {
  if let Val(m) = left {
    if let Val(n) = right {
      return Val(pown(m, n));
    }
  }
  if let Val(n) = right {
    if (n == 0i64) {
      return Val(1i64);
    }
    if (n == 1i64) {
      return left;
    }
  }
  if let Val(m) = left {
    if (m == 0i64) {
      return Val(0i64);
    }
  }
  return Pow(left, right);
}

pub function ln(e: Expr): Expr {
  if let Val(n) = e {
    if (n == 1i64) {
      return Val(0i64);
    }
  }
  return Ln(e);
}

pub function d(x: string, e: Expr): Expr {
  match (e) {
    Val(_) => {
      return Val(0i64);
    },
    Var(y) => {
      if (x == y) {
        return Val(1i64);
      }
      return Val(0i64);
    },
    Add(f, g) => {
      return add(d(x, f), d(x, g));
    },
    Mul(f, g) => {
      return add(mul(f, d(x, g)), mul(g, d(x, f)));
    },
    Pow(f, g) => {
      return mul(powr(f, g), add(mul(mul(g, d(x, f)), powr(f, Val(-1i64))), mul(ln(f), d(x, g))));
    },
    Ln(f) => {
      return mul(d(x, f), powr(f, Val(-1i64)));
    }
  }
}

pub function count(e: Expr): i64 {
  return match (e) { Val(_) | Var(_) => 1i64, Add(f, g) | Mul(f, g) | Pow(f, g) => count(f) + count(g), Ln(f) => count(f) };
}

function nest_aux(s: i32, f: (i32, Expr) => Expr, n: i32, e: Expr): Expr {
  if (n == 0) {
    return e;
  }
  let next = f(s - n, e);
  return nest_aux(s, f, n - 1, next);
}

pub function nest(f: (i32, Expr) => Expr, n: i32, e: Expr): Expr {
  return nest_aux(n, f, n, e);
}
