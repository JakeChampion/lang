import "../deriv";
import "./scale";
import "std/i32";
import "std/i64";

function step(i: i32, e: deriv.Expr): deriv.Expr {
  let next = deriv.d("x", e);
  print(f"{i + 1} count: {deriv.count(next)}");
  return next;
}

function main(): i32 {
  let Some(n) = scale.read(10) else {
    return 2;
  };
  let x = deriv.Var("x");
  deriv.nest(step, n, deriv.powr(x, x));
  print("done");
  return 0;
}
