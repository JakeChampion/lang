import "../cfold";
import "./scale";
import "std/i32";
import "std/i64";

function main(): i32 {
  let Some(n) = scale.read(20) else {
    return 2;
  };
  let e = cfold.mk_expr(n, 1i64);
  let before = cfold.eval(e);
  let after = cfold.eval(cfold.cfold(cfold.reassoc(e)));
  print(before.to_string());
  print(after.to_string());
  return 0;
}
