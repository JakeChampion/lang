import "../cfold";
import "./scale";
import "std/i32";
import "std/i64";

function main(): i32 {
  let n: i32 = scale.read(20);
  if (n < 0) {
    return 2;
  }
  let e: cfold.Expr = cfold.mk_expr(n, 1i64);
  let before: i64 = cfold.eval(e);
  let after: i64 = cfold.eval(cfold.cfold(cfold.reassoc(e)));
  print(before.to_string());
  print(after.to_string());
  return 0;
}
