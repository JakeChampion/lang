import "std/i32";
import "std/string";

pub function read(maximum: i32): i32 {
  let argv: string[] = args();
  if (argv.len() != 2) {
    return -1;
  }
  match (i32.parse_i32(argv[1])) {
    Ok(n) => {
      if (n >= 0 && n <= maximum) {
        return n;
      }
    },
    Err(_) => {}
  }
  return -1;
}
