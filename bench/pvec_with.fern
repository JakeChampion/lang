import "std/pvec";

function main(): i32 {
  let v = pvec.new();
  for i in 0..4000 {
    v = v.append(i);
  }
  for r in 0..40 {
    for j in 0..4000 {
      v = v.with(j, j + r);
    }
  }
  let total = 0i64;
  for i in 0..4000 {
    total += v.get_or(i, 0) as i64;
  }
  return (total % 97i64) as i32;
}
