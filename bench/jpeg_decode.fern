import "std/jpeg";

// A smooth 512 by 512 image with some noise, as RGB.
function picture(w: i32, h: i32): u8[] {
  let px = __alloc_u8(w * h * 3);
  let s = 7;
  for y in 0..h {
    for x in 0..w {
      s = s * 1103515245 + 12345 & 2147483647;
      let k = 3 * (y * w + x);
      px = px.with(k, ((x + y) / 4 + (s >> 27)) as u8).with(k + 1, (x / 2 ^ y / 3) as u8).with(k + 2, (y / 2 + (s >> 28)) as u8);
    }
  }
  return px;
}

function main(): i32 {
  let file = match (jpeg.encode_rgb8(512, 512, picture(512, 512), jpeg.options())) {
    Ok(f) => f,
    Err(_) => {
      return 1;
    },
  };
  let acc = 0;
  for r in 0..4 {
    let Ok(img) = jpeg.decode_image(file) else {
      return 2;
    };
    acc = acc * 31 + img.pixels[r * 1001 + 7] as i32 + img.pixels[img.pixels.len() - 2 - r] as i32;
  }
  return (acc & 2147483647) % 97;
}
