import "std/i32";

// string_build — accumulating concatenation, the shape the rc==1 append cliff
// is about. `__fern_strcat` and the copy it performs when the accumulator is
// shared are the cost; the repo carries whole diagnostics for this
// (__arr_push_shared_bytes, FERN_CLIFF_REPORT) and had no benchmark of it.
function build(n: i32): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < n) {
    out = out + i.to_string() + ",";
    i = i + 1;
  }
  return out;
}

function main(): i32 {
  let total: i64 = 0i64;
  let r: i32 = 0;
  while (r < 900) {
    total = total + build(200).len() as i64;
    r = r + 1;
  }
  return (total % 97i64) as i32;
}
