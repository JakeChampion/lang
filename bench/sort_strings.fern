import "core/cmp";
import "std/i32";
import "std/string";

function main(): i32 {
  let total = 0i64;
  for r in 0..2 {
    let xs: string[] = [];
    let seed = 12345 + r;
    for _ in 0..16000 {
      seed = (seed * 1103515 + 12345) % 100000;
      if (seed < 0) {
        seed = -seed;
      }
      xs = xs.append(f"n{seed}");
    }
    let sorted = cmp.sort(xs);
    let first = sorted[0];
    let last = sorted[sorted.len() - 1];
    total = total + first.len() as i64 + (first[1] as i32) as i64 + (last[last.len() - 1] as i32) as i64;
  }
  return (total % 97i64) as i32;
}
