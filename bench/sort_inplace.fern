import "core/cmp";

function main(): i32 {
  let total = 0i64;
  for r in 0..2500 {
    let xs: i32[] = [];
    let seed = 12345 + r;
    for _ in 0..48 {
      seed = (seed * 1103515 + 12345) % 100000;
      if (seed < 0) {
        seed = -seed;
      }
      xs = xs.append(seed);
    }
    xs = cmp.sort_in_place(xs);
    total = total + xs[0] as i64 + xs[xs.len() - 1] as i64;
  }
  return (total % 97i64) as i32;
}
