import "core/cmp";

function main(): i32 {
  let total = 0i64;
  for r in 0..24 {
    let xs: i32[] = [];
    let seed = 12345 + r;
    for _ in 0..2000 {
      seed = (seed * 1103515 + 12345) % 100000;
      if (seed < 0) {
        seed = -seed;
      }
      xs = xs.append(seed);
    }
    let sorted = cmp.sort(xs);
    total = total + sorted[0] as i64 + sorted[sorted.len() - 1] as i64;
  }
  return (total % 97i64) as i32;
}
