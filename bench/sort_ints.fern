import "core/cmp";

function main(): i32 {
  let total: i64 = 0i64;
  let r: i32 = 0;
  while (r < 24) {
    let xs: i32[] = [];
    let i: i32 = 0;
    let seed: i32 = 12345 + r;
    while (i < 2000) {
      seed = (seed * 1103515 + 12345) % 100000;
      if (seed < 0) {
        seed = 0 - seed;
      }
      xs = xs.append(seed);
      i = i + 1;
    }
    let sorted: i32[] = cmp.sort(xs);
    total = total + sorted[0] as i64 + sorted[sorted.len() - 1] as i64;
    r = r + 1;
  }
  return (total % 97i64) as i32;
}
