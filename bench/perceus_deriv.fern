import "./perceus/deriv";

function main(): i32 {
  let sum = 0i64;
  for _ in 0..2400 {
    let x = deriv.Var("x");
    let e = deriv.powr(x, x);
    let i = 0;
    while (i < 3) {
      e = deriv.d("x", e);
      sum += deriv.count(e);
      i += 1;
    }
    if (deriv.count(e) != 90i64) {
      return 125;
    }
  }
  return (sum % 97i64) as i32;
}
