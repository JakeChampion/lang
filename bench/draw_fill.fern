import "std/android/draw";

function main(): i32 {
  let f = draw.offscreen(512, 256);
  let s = 7;
  for y in 0..256 {
    for x in 0..512 {
      s = s * 1103515245 + 12345 & 2147483647;
      f.store(x, y, 1, 1, s >> 3);
    }
  }
  for r in 0..64 {
    f.fill(0, 0, 512, 256, draw.rgba(r * 3, 255 - r, r * 2 + 1, 3 + r * 3));
  }
  let acc = 0;
  for y in 0..256 {
    acc = acc * 31 + f.pixel(y * 2 + 1, y);
  }
  draw.release(f);
  return (acc & 2147483647) % 97;
}
