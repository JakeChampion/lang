import "std/array" as array;

function vector(): f64[] {
  let xs: f64[] = [];
  let i: i32 = 0;
  while (i < 4096) {
    xs = xs.append((i % 17) as f64 + 0.5);
    i = i + 1;
  }
  return xs;
}

function main(): i32 {
  let xs: f64[] = vector();
  let acc: i64 = 0;
  let r: i32 = 0;
  while (r < 4000) {
    let k: f64 = (r % 5 + 1) as f64;
    let ys: f64[] = array.scale_f64(xs, k);
    acc = acc + ys[r % 4096] as i64;
    r = r + 1;
  }
  return (acc % 97i64) as i32;
}
