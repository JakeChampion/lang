import "std/array" as array;

function vector(): f64[] {
  let xs: f64[] = [];
  for i in 0..4096 {
    xs = xs.append((i % 17) as f64 + 0.5);
  }
  return xs;
}

function main(): i32 {
  let xs = vector();
  let acc: i64 = 0;
  for r in 0..4000 {
    let k = (r % 5 + 1) as f64;
    let ys = array.scale_f64(xs, k);
    acc += ys[r % 4096] as i64;
  }
  return (acc % 97i64) as i32;
}
