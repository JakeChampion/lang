import "std/android/draw";

function main(): i32 {
  let f = draw.offscreen(512, 256);
  let rgba = __alloc_u8(512 * 256 * 4);
  let s = 7;
  for y in 0..256 {
    for x in 0..512 {
      s = s * 1103515245 + 12345 & 2147483647;
      f.store(x, y, 1, 1, s >> 3);
      s = s * 1103515245 + 12345 & 2147483647;
      let a = s >> 9 & 255;
      let k = 4 * (y * 512 + x);
      rgba = rgba.with(k, (a * (s >> 3 & 255) / 255) as u8).with(k + 1, (a * (s >> 11 & 255) / 255) as u8).with(k + 2, (a * (s >> 17 & 255) / 255) as u8).with(k + 3, a as u8);
    }
  }
  for r in 0..64 {
    f.blend(0, 0, 512, 256, rgba);
  }
  let acc = 0;
  for y in 0..256 {
    acc = acc * 31 + f.pixel(y * 2 + 1, y);
  }
  draw.release(f);
  return (acc & 2147483647) % 97;
}
