function is_ident_byte(c: u8): boolean {
  if (c >= b'a' && c <= b'z') {
    return true;
  }
  if (c >= b'A' && c <= b'Z') {
    return true;
  }
  if (c >= b'0' && c <= b'9') {
    return true;
  }
  return c == b'_';
}

function scan(src: string): i32 {
  let kw = 0;
  let i = 0;
  let n = src.len();
  while (i < n) {
    if (!is_ident_byte(src[i])) {
      i += 1;
      continue;
    }
    let start = i;
    while (i < n && is_ident_byte(src[i])) {
      i += 1;
    }
    let word: str = slice_unchecked(src, start, i);
    if (word == "function" || word == "return" || word == "while" || word == "let" || word == "if" || word == "else") {
      kw += 1;
    }
  }
  return kw;
}

function main(): i32 {
  let src = "function scan(src: string): i32 { let i: i32 = 0; while (i < n) { if (x) { return i; } else { i = i + 1; } } return 0; }";
  let total = 0i64;
  for _ in 0..10000 {
    total += scan(src) as i64;
  }
  return (total % 97i64) as i32;
}
