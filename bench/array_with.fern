function main(): i32 {
  let buf: u8[] = [];
  let n: i32 = 0;
  while (n < 4096) {
    buf = buf.append(0u8);
    n = n + 1;
  }
  let total: i64 = 0i64;
  let r: i32 = 0;
  while (r < 400) {
    let i: i32 = 0;
    while (i < 4096) {
      buf = buf.with(i, ((i + r) % 251) as u8);
      i = i + 1;
    }
    total = total + buf[r % 4096] as i64;
    r = r + 1;
  }
  return (total % 97i64) as i32;
}
