---
// LangPlayground — embed a runnable snippet inline in a docs page.
//
// Wraps the playground in iframe-embed mode (`?embed=1`), which
// strips the chrome (title, subtitle, examples dropdown, share
// button, problems panel) and tightens the layout so the snippet
// renders cleanly inside a docs-page-sized iframe.
//
// Usage in MDX:
//
//   import LangPlayground from "@/components/LangPlayground.astro";
//   <LangPlayground code={`function main(): i32 { return 0; }`} />
//
// Props:
//   code     — the lang source to embed.
//   height   — iframe height in CSS units. Defaults to 420px which
//              fits the stacked source + output panes comfortably.
//   autoRun  — boolean (default true). When true the snippet runs
//              once after wasm boots so the output renders on
//              first paint without the reader clicking Run.
//              Opt out with `autoRun={false}` for snippets where
//              the reader is meant to predict the output first.
//   title    — accessibility title for the iframe.

interface Props {
  code: string;
  height?: string;
  autoRun?: boolean;
  title?: string;
}

const {
  code,
  height = "420px",
  autoRun = true,
  title = "lang playground",
} = Astro.props;

// URL-safe base64 (RFC 4648 §5), '=' padding stripped — matches
// the encodeHash() helper in web/index.html so a copy-pasted hash
// is interchangeable between embed and standalone playground.
function encodeHash(s: string): string {
  const bytes = new TextEncoder().encode(s);
  let bin = "";
  for (const b of bytes) bin += String.fromCharCode(b);
  const b64 =
    typeof btoa === "function"
      ? btoa(bin)
      : Buffer.from(bin, "binary").toString("base64");
  return b64.replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fullSrc = `${base}/playground/#src=${encodeHash(code)}`;
const params = new URLSearchParams();
params.set("embed", "1");
if (autoRun) params.set("autorun", "1");
const embedSrc = `${base}/playground/?${params.toString()}#src=${encodeHash(code)}`;
---

<figure class="lang-playground" data-lang-playground>
  <header>
    <span aria-hidden="true">▸ live snippet</span>
    <a href={fullSrc} target="_blank" rel="noopener">
      open in playground &rarr;
    </a>
  </header>
  <iframe
    src={embedSrc}
    title={title}
    style={`height: ${height};`}
    loading="lazy"></iframe>
</figure>

<script is:inline>
  // Sync the embedded playground's theme with Starlight's. We
  // append `?theme=…` to the iframe src on first paint (so the
  // playground boots with the right palette), then postMessage
  // on every Starlight theme-pref change so the iframe re-themes
  // live without a reload.
  (function () {
    function currentTheme() {
      // Starlight stores its setting on <html data-theme="…">. Fall
      // back to prefers-color-scheme when the attribute hasn't been
      // set yet (the initial paint before Starlight's inline script
      // runs).
      const attr = document.documentElement.getAttribute("data-theme");
      if (attr === "dark" || attr === "light") return attr;
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }
    function applyToFrame(iframe, theme) {
      // Patch the iframe src ONCE on first paint so reloads /
      // fresh viewers boot with the right palette.
      if (!iframe.dataset.themeApplied) {
        const u = new URL(iframe.src, location.href);
        u.searchParams.set("theme", theme);
        iframe.src = u.toString();
        iframe.dataset.themeApplied = "1";
        return;
      }
      // Subsequent flips don't need a reload — postMessage tells
      // the running playground to re-theme.
      try {
        iframe.contentWindow.postMessage({ type: "lang:theme", theme }, "*");
      } catch (e) { /* iframe not yet ready; next observer tick will catch it */ }
    }
    function syncAll() {
      const theme = currentTheme();
      document
        .querySelectorAll("[data-lang-playground] iframe")
        .forEach((f) => applyToFrame(f, theme));
    }
    // First paint.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", syncAll);
    } else {
      syncAll();
    }
    // Watch Starlight's data-theme attribute for changes.
    new MutationObserver(syncAll).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>
