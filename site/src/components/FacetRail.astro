---
// FacetRail — the landing page's feature layout: a two-column rail of
// numbered <Facet> entries separated by hairlines, alternating vertical
// offset so it reads hand-set rather than as a row of equal cards.
//
// Usage in MDX:
//
//   <FacetRail>
//     <Facet index="01" title="Starts instantly">prose…</Facet>
//   </FacetRail>
---

<div class="fern-rail not-content">
  <slot />
</div>
