---
// FernPlayground — embed a runnable snippet inline in a docs page.
//
// Wraps the playground in iframe-embed mode (`?embed=1`), which
// strips the chrome (title, subtitle, examples dropdown, share
// button, problems panel) and tightens the layout so the snippet
// renders cleanly inside a docs-page-sized iframe.
//
// Usage in MDX:
//
//   import FernPlayground from "@/components/FernPlayground.astro";
//   <FernPlayground code={`function main(): i32 { return 0; }`} />
//
// Props:
//   code     — the Fern source to embed.
//   height   — iframe height in CSS units. Defaults to 420px which
//              fits the stacked source + output panes comfortably.
//   autoRun  — boolean (default true). When true the snippet runs
//              once after wasm boots so the output renders on
//              first paint without the reader clicking Run.
//              Opt out with `autoRun={false}` for snippets where
//              the reader is meant to predict the output first.
//   minimal  — boolean (default false). Read-only variant for docs
//              that just want to show code + its output: the editor
//              is frozen (highlighted but not editable), the Run
//              buttons and the Assembly tab are dropped, the snippet
//              always autoruns, and the iframe auto-grows to fit its
//              content (the `height` prop becomes just the initial
//              size before the first height report).
//   title    — accessibility title for the iframe.

interface Props {
  code: string;
  height?: string;
  autoRun?: boolean;
  minimal?: boolean;
  title?: string;
}

const {
  code,
  height,
  autoRun = true,
  minimal = false,
  title = "Fern playground",
} = Astro.props;

// Minimal embeds auto-grow, so they only need a small initial height
// before the first `fern:height` message lands; editable embeds keep
// the roomier default that fits the stacked source + output panes.
const resolvedHeight = height ?? (minimal ? "180px" : "420px");

// URL-safe base64 (RFC 4648 §5), '=' padding stripped — matches
// the encodeHash() helper in web/index.html so a copy-pasted hash
// is interchangeable between embed and standalone playground.
function encodeHash(s: string): string {
  const bytes = new TextEncoder().encode(s);
  let bin = "";
  for (const b of bytes) bin += String.fromCharCode(b);
  const b64 =
    typeof btoa === "function"
      ? btoa(bin)
      : Buffer.from(bin, "binary").toString("base64");
  return b64.replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fullSrc = `${base}/playground/#src=${encodeHash(code)}`;
const params = new URLSearchParams();
params.set("embed", "1");
if (minimal) params.set("minimal", "1");
// Minimal snippets must autorun (there's no Run button), so force it
// even if autoRun={false} was passed.
if (autoRun || minimal) params.set("autorun", "1");
const embedSrc = `${base}/playground/?${params.toString()}#src=${encodeHash(code)}`;
---

<figure
  class="fern-playground"
  data-fern-playground
  data-fern-minimal={minimal ? "1" : undefined}>
  <header>
    <span aria-hidden="true">{minimal ? "▸ snippet" : "▸ live snippet"}</span>
    <a href={fullSrc} target="_blank" rel="noopener">
      open in playground &rarr;
    </a>
  </header>
  <iframe
    src={embedSrc}
    title={title}
    style={`height: ${resolvedHeight};`}
    loading="lazy"></iframe>
</figure>

<script is:inline>
  // Sync the embedded playground's theme with Starlight's. We
  // append `?theme=…` to the iframe src on first paint (so the
  // playground boots with the right palette), then postMessage
  // on every Starlight theme-pref change so the iframe re-themes
  // live without a reload.
  (function () {
    function currentTheme() {
      // Starlight stores its setting on <html data-theme="…">. Fall
      // back to prefers-color-scheme when the attribute hasn't been
      // set yet (the initial paint before Starlight's inline script
      // runs).
      const attr = document.documentElement.getAttribute("data-theme");
      if (attr === "dark" || attr === "light") return attr;
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }
    function applyToFrame(iframe, theme) {
      // Patch the iframe src ONCE on first paint so reloads /
      // fresh viewers boot with the right palette.
      if (!iframe.dataset.themeApplied) {
        const u = new URL(iframe.src, location.href);
        u.searchParams.set("theme", theme);
        iframe.src = u.toString();
        iframe.dataset.themeApplied = "1";
        return;
      }
      // Subsequent flips don't need a reload — postMessage tells
      // the running playground to re-theme.
      try {
        iframe.contentWindow.postMessage({ type: "fern:theme", theme }, "*");
      } catch (e) { /* iframe not yet ready; next observer tick will catch it */ }
    }
    function syncAll() {
      const theme = currentTheme();
      document
        .querySelectorAll("[data-fern-playground] iframe")
        .forEach((f) => applyToFrame(f, theme));
    }
    // First paint.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", syncAll);
    } else {
      syncAll();
    }
    // Watch Starlight's data-theme attribute for changes.
    new MutationObserver(syncAll).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>

<script is:inline>
  // Auto-grow minimal playground embeds to their content height. The
  // embedded playground posts `{ type: "fern:height", height }` on
  // first paint and whenever its content reflows; match the message to
  // its iframe via the event source and apply the height so short
  // snippets don't get an inner scrollbar and long ones aren't clipped.
  (function () {
    window.addEventListener("message", function (e) {
      var d = e.data;
      if (!d || d.type !== "fern:height" || typeof d.height !== "number") return;
      var frames = document.querySelectorAll("[data-fern-playground] iframe");
      for (var i = 0; i < frames.length; i++) {
        if (frames[i].contentWindow === e.source) {
          // Clamp to a sane band so a runaway report can't blow up the
          // page layout.
          frames[i].style.height = Math.max(80, Math.min(d.height, 2000)) + "px";
          break;
        }
      }
    });
  })();
</script>
