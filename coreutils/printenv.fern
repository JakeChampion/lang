import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [VARIABLE]...\n";
  out += "Print the values of the specified environment VARIABLE(s).\n";
  out += "If no VARIABLE is specified, print name=value pairs for them all.\n";
  out += "\n";
  out += "  -0, --null     end each output line with NUL, not newline\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  return out;
}

pub function main(): i32 {
  let opts: gnu.Opt[] = [gnu.flag("0", "null", 1)];
  let g = gnu.getopt_new(args(), opts, "printenv", help_text(), 2).in_order();
  let zero = false;
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(_) => {
        zero = true;
      },
      None => {
        break;
      }
    }
  }
  let term = "\n";
  if (zero) {
    term = "\x00";
  }
  let operands = g.operands();
  let qstyle = 0;
  let quoted_out = false;
  if (!zero && (operands.len() == 0 || isatty(1))) {
    qstyle = gnu.quoting_style_from_env_with(3);
    quoted_out = qstyle != 0;
  }
  let o = gnu.out_new();
  let ok = true;
  if (operands.len() == 0) {
    let all = environ();
    let i = 0;
    while (i < all.len()) {
      let shown = all[i];
      if (quoted_out) {
        shown = gnu.env_entry(all[i], qstyle);
      }
      o = gnu.put_with(o, shown + term, 2);
      i += 1;
    }
  } else {
    let k = 0;
    while (k < operands.len()) {
      let found = false;
      if (!operands[k].contains("=")) {
        match (env(operands[k])) {
          Some(v) => {
            let shown = v;
            if (quoted_out) {
              shown = gnu.quote_style(shown, qstyle);
            }
            o = gnu.put_with(o, shown + term, 2);
            found = true;
          },
          None => {}
        }
      }
      if (!found) {
        ok = false;
      }
      k += 1;
    }
  }
  gnu.finish_with(o, 2);
  if (ok) {
    return 0;
  }
  return 1;
}
