import "std/string";
import "std/array";
import "./lib/gnu";
import "./lib/resolv";

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]\n";
  out = out + "Print the numeric identifier (in hexadecimal) for the current host.\n";
  out = out + "\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function stored_id(): Option[i64] {
  match (read_file_bytes("/etc/hostid")) {
    Ok(bs) => {
      if (bs.len() < 4) {
        return None;
      }
      return Some(resolv.ipv4_word(bs[0] as i32, bs[1] as i32, bs[2] as i32, bs[3] as i32) as i64 & 4294967295);
    },
    Err(_) => {
      return None;
    }
  }
}

function darwin_host_id(): i64 {
  match (sysctl([1, 11])) {
    Ok(bs) => {
      if (bs.len() < 4) {
        return 0;
      }
      return (bs[0] as i64 | bs[1] as i64 << 8 | bs[2] as i64 << 16 | bs[3] as i64 << 24) & 4294967295;
    },
    Err(_) => {
      return 0;
    }
  }
}

function address_id(word: i32): i64 {
  let w: i64 = word as i64 & 4294967295;
  return (w << 16 | w >> 16) & 4294967295;
}

function host_id(): i64 {
  if (target_os() == "darwin") {
    return darwin_host_id();
  }
  match (stored_id()) {
    Some(id) => {
      return id;
    },
    None => {}
  }
  let name: string = hostname();
  if (name.len() == 0) {
    return 0;
  }
  match (resolv.resolve(name)) {
    Some(word) => {
      return address_id(word);
    },
    None => {
      return 0;
    }
  }
}

function hex8(v: i64): string {
  let digits: string = "0123456789abcdef";
  let out: string = "";
  let x: i64 = v;
  while (x > 0) {
    let d: i32 = (x & 15) as i32;
    out = slice_unchecked(digits, d, d + 1) + out;
    x = x >> 4;
  }
  while (out.len() < 8) {
    out = "0" + out;
  }
  return out;
}

pub function main(): i32 {
  let operands: string[] = gnu.parse_standard_options_only(args(), "hostid", help_text(), 1);
  if (operands.len() > 0) {
    gnu.die_usage("extra operand " + gnu.quote(operands[0]), 1);
  }
  gnu.write_out(hex8(host_id()) + "\n");
  return 0;
}
