import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/pwdb";

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [USERNAME]...\n";
  out += "Print group memberships for each USERNAME or, if no USERNAME is specified, for\n";
  out += "the current process (which may differ if the groups database has changed).\n";
  out += "\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  return out;
}

struct Out { w: io_buffered.BufWriter, ok: boolean }

function put_text(s: Out, text: string): Out {
  return Out { ...s, w: gnu.put(s.w, text) };
}

function fail(s: Out, msg: string): Out {
  return Out { w: gnu.error_out(s.w, msg), ok: false };
}

// The line of the names of the groups `gids`. A group with no name gives
// its number, and a message.
function names_line(st: Out, gids: i64[]): Out {
  let names = pwdb.group_names(gids);
  let text = "";
  let s = st;
  let i = 0;
  while (i < gids.len()) {
    if (i > 0) {
      text += " ";
    }
    match (names[i]) {
      Some(n) => {
        text += n;
      },
      None => {
        s = put_text(s, text);
        s = fail(s, "cannot find name for group ID " + gids[i].to_string());
        text = gids[i].to_string();
      }
    }
    i += 1;
  }
  return put_text(s, text + "\n");
}

pub function main(): i32 {
  let operands = gnu.parse_standard_options_only(args(), "groups", help_text(), 1);
  let st = Out { w: gnu.out_new(), ok: true };
  if (operands.len() == 0) {
    st = names_line(st, pwdb.process_groups());
  } else {
    let i = 0;
    while (i < operands.len()) {
      match (pwdb.user_by_name(operands[i])) {
        Some(u) => {
          st = put_text(st, operands[i] + " : ");
          st = names_line(st, pwdb.group_list(u.name, u.gid));
        },
        None => {
          st = fail(st, gnu.quote(operands[i]) + ": no such user");
        }
      }
      i += 1;
    }
  }
  gnu.finish(st.w);
  if (st.ok) {
    return 0;
  }
  return 1;
}
