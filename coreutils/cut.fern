// cut.fern — GNU-compatible `cut`.
//
//   cut -b LIST | -c LIST | -f LIST [-d DELIM] [-ns z] [--complement]
//       [--output-delimiter=STRING] [FILE]...
//
// One of -b / -c / -f selects positions from each line: bytes for -b and
// -c (the same thing in the C locale), delimiter-separated fields for
// -f. A LIST is `N`, `N-`, `N-M` or `-M`, comma- or blank-separated;
// overlapping ranges are merged and the selection is written in INPUT
// order, once, whatever order the list was given in.
//
// Four behaviours here are the reference binary's and are not what a
// first reading of the manual suggests:
//
//   - `-d ''` is the NUL byte, not "no delimiter", and so is
//     `--output-delimiter=`.
//   - A line with no delimiter is printed WHOLE under -f, unless -s.
//     A line that has one always ends in the line delimiter, even when
//     the selection picked nothing out of it.
//   - When the field delimiter IS the line delimiter, the whole FILE is
//     one record whose fields are its lines: `cut -d '\n' -f1` on two
//     lines prints the first and stops.
//   - The output delimiter separates RANGES under -b / -c and FIELDS
//     under -f, and ranges are merged only where they overlap — `1-2,3-4`
//     stays two ranges, so `-b1-2,3-4 --output-delimiter=X` is `abXcd`.
import "std/array";
import "std/u64";
import "std/io_buffered";
import "./lib/gnu";

// Option ids in GNU's declaration order — `cut --=x` lists `--bytes`
// `--characters` `--fields` `--delimiter` `--only-delimited`
// `--output-delimiter` `--complement` `--zero-terminated`. `-n` has no
// long name and is accepted and ignored.
function opt_bytes(): i32 {
  return 1;
}

function opt_chars(): i32 {
  return 2;
}

function opt_fields(): i32 {
  return 3;
}

function opt_delim(): i32 {
  return 4;
}

function opt_suppress(): i32 {
  return 5;
}

function opt_outdelim(): i32 {
  return 6;
}

function opt_complement(): i32 {
  return 7;
}

function opt_zero(): i32 {
  return 8;
}

function opt_n(): i32 {
  return 9;
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " OPTION... [FILE]...\n";
  out = out + "Print selected parts of lines from each FILE to standard output.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -b, --bytes=LIST        select only these bytes\n";
  out = out + "  -c, --characters=LIST   select only these characters\n";
  out = out + "  -d, --delimiter=DELIM   use DELIM instead of TAB for field delimiter\n";
  out = out + "  -f, --fields=LIST       select only these fields;  also print any line\n";
  out = out + "                            that contains no delimiter character, unless\n";
  out = out + "                            the -s option is specified\n";
  out = out + "  -n                      (ignored)\n";
  out = out + "      --complement        complement the set of selected bytes, characters\n";
  out = out + "                            or fields\n";
  out = out + "  -s, --only-delimited    do not print lines not containing delimiters\n";
  out = out + "      --output-delimiter=STRING  use STRING as the output delimiter\n";
  out = out + "                            the default is to use the input delimiter\n";
  out = out + "  -z, --zero-terminated   line delimiter is NUL, not newline\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "Use one, and only one of -b, -c or -f.  Each LIST is made up of one\n";
  out = out + "range, or many ranges separated by commas.  Selected input is written\n";
  out = out + "in the same order that it is read, and is written exactly once.\n";
  out = out + "Each range is one of:\n";
  out = out + "\n";
  out = out + "  N     N'th byte, character or field, counted from 1\n";
  out = out + "  N-    from N'th byte, character or field, to end of line\n";
  out = out + "  N-M   from N'th to M'th (included) byte, character or field\n";
  out = out + "  -M    from first to M'th (included) byte, character or field\n";
  return out;
}

// Bytes per read(2), and the writer's threshold: bytes per write(2).
function read_size(): i32 {
  return 65536;
}

function block_size(): i32 {
  return 16384;
}

function is_digit(c: i32): boolean {
  return c >= 48 && c <= 57;
}

// The C locale's isblank; a list separator alongside the comma. A
// newline is NOT one, so `-b '1\n3'` names an invalid position.
function is_blank(c: i32): boolean {
  return c == 32 || c == 9;
}

function u64_max(): u64 {
  return 18446744073709551615 as u64;
}

// One byte as a string; the line and output delimiters are single bytes
// often enough that this is worth having.
function byte_str(b: i32): string {
  var bs: u8[] = [];
  bs = bs.append(b as u8);
  return string_from_bytes_unchecked(bs);
}

// ---- the position list -----------------------------------------------------
//
// `Ranges` — the selection, sorted by start and with overlapping pairs
// merged. `his` holds u64_max() for an open-ended `N-`.
struct Ranges { los: u64[], his: u64[] }

// `parse_list(spec, fields)` — GNU's list grammar. Every fault exits 1
// through the usage path; the wording differs between the field and the
// byte/character modes, which is what `fields` selects.
function parse_list(spec: string, fields: boolean): Ranges {
  var los: u64[] = [];
  var his: u64[] = [];
  var i: i32 = 0;
  var initial: u64 = 1 as u64;
  var value: u64 = 0 as u64;
  var lhs: boolean = false;
  var rhs: boolean = false;
  var dash: boolean = false;
  while (true) {
    var c: i32 = 0 - 1;
    if (i < spec.len()) {
      c = spec[i] as i32;
    }
    if (c == 45) {
      if (dash) {
        gnu.die_usage(range_word(fields), 1);
      }
      dash = true;
      if (lhs && value == 0 as u64) {
        gnu.die_usage(from_one_word(fields), 1);
      }
      initial = 1 as u64;
      if (lhs) {
        initial = value;
      }
      value = 0 as u64;
      i = i + 1;
    } else if (c < 0 || c == 44 || is_blank(c)) {
      if (dash) {
        dash = false;
        if (!lhs && !rhs) {
          gnu.die_usage("invalid range with no endpoint: -", 1);
        }
        // `N-` runs to the end of the line; `N-0` names 0 and is a
        // decreasing range, so the open form is the ABSENCE of a
        // right-hand side rather than a zero one.
        if (!rhs) {
          los = los.append(initial);
          his = his.append(u64_max());
        } else {
          if (value < initial) {
            gnu.die_usage("invalid decreasing range", 1);
          }
          los = los.append(initial);
          his = his.append(value);
        }
        value = 0 as u64;
      } else {
        if (value == 0 as u64) {
          gnu.die_usage(from_one_word(fields), 1);
        }
        los = los.append(value);
        his = his.append(value);
        value = 0 as u64;
      }
      if (c < 0) {
        break;
      }
      i = i + 1;
      lhs = false;
      rhs = false;
    } else if (is_digit(c)) {
      if (dash) {
        rhs = true;
      } else {
        lhs = true;
      }
      // UINTMAX_MAX is out of range even though it fits: GNU reserves
      // it, so a list naming it is refused like one that overflows.
      var over: boolean = false;
      match (value.checked_mul(10 as u64)) {
        Some(m) => {
          match (m.checked_add((c - 48) as u64)) {
            Some(a) => {
              value = a;
            },
            None => {
              over = true;
            }
          }
        },
        None => {
          over = true;
        }
      }
      if (value == u64_max()) {
        over = true;
      }
      if (over) {
        var from: i32 = i;
        while (from > 0 && is_digit(spec[from - 1] as i32)) {
          from = from - 1;
        }
        var end: i32 = i;
        while (end < spec.len() && is_digit(spec[end] as i32)) {
          end = end + 1;
        }
        gnu.die_usage(too_large_word(fields) + " " + gnu.quote(slice_unchecked(spec, from, end) + "") + " is too large", 1);
      }
      i = i + 1;
    } else {
      gnu.die_usage(bad_value_word(fields) + " " + gnu.quote(slice_unchecked(spec, i, spec.len()) + ""), 1);
    }
  }
  return merge(Ranges { los: los, his: his });
}

function from_one_word(fields: boolean): string {
  if (fields) {
    return "fields are numbered from 1";
  }
  return "byte/character positions are numbered from 1";
}

function range_word(fields: boolean): string {
  if (fields) {
    return "invalid field range";
  }
  return "invalid byte or character range";
}

function too_large_word(fields: boolean): string {
  if (fields) {
    return "field number";
  }
  return "byte/character offset";
}

function bad_value_word(fields: boolean): string {
  if (fields) {
    return "invalid field value";
  }
  return "invalid byte/character position";
}

// Sort by start, then fuse pairs that OVERLAP. Adjacency is not enough:
// `1-2,3-4` stays two ranges, which the output delimiter can see.
function merge(r: Ranges): Ranges {
  var los: u64[] = r.los;
  var his: u64[] = r.his;
  var i: i32 = 1;
  while (i < los.len()) {
    var lo: u64 = los[i];
    var hi: u64 = his[i];
    var j: i32 = i - 1;
    while (j >= 0 && los[j] > lo) {
      los = los.with(j + 1, los[j]);
      his = his.with(j + 1, his[j]);
      j = j - 1;
    }
    los = los.with(j + 1, lo);
    his = his.with(j + 1, hi);
    i = i + 1;
  }
  var outl: u64[] = [];
  var outh: u64[] = [];
  i = 0;
  while (i < los.len()) {
    var lo: u64 = los[i];
    var hi: u64 = his[i];
    var k: i32 = i + 1;
    while (k < los.len() && los[k] <= hi) {
      if (his[k] > hi) {
        hi = his[k];
      }
      k = k + 1;
    }
    outl = outl.append(lo);
    outh = outh.append(hi);
    i = k;
  }
  return Ranges { los: outl, his: outh };
}

// The gaps between the selected ranges, which is what `--complement`
// selects. An empty gap between two adjacent ranges is dropped: it can
// never match a position, and keeping it would be a range the output
// delimiter counted.
function complement_of(r: Ranges): Ranges {
  var los: u64[] = [];
  var his: u64[] = [];
  var prev: u64 = 0 as u64;
  var i: i32 = 0;
  while (i < r.los.len()) {
    if (r.los[i] > prev + 1 as u64) {
      los = los.append(prev + 1 as u64);
      his = his.append(r.los[i] - 1 as u64);
    }
    prev = r.his[i];
    i = i + 1;
  }
  if (prev < u64_max()) {
    los = los.append(prev + 1 as u64);
    his = his.append(u64_max());
  }
  return Ranges { los: los, his: his };
}

// ---- settings --------------------------------------------------------------
struct Settings { r: Ranges, fields: boolean, delim: i32, term: i32, suppress: boolean, out_delim: string, out_delim_set: boolean }

function main(): i32 {
  var argv: string[] = args();
  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("b", "bytes", opt_bytes()));
  opts = opts.append(gnu.valued("c", "characters", opt_chars()));
  opts = opts.append(gnu.valued("f", "fields", opt_fields()));
  opts = opts.append(gnu.valued("d", "delimiter", opt_delim()));
  opts = opts.append(gnu.flag("s", "only-delimited", opt_suppress()));
  opts = opts.append(gnu.valued("", "output-delimiter", opt_outdelim()));
  opts = opts.append(gnu.flag("", "complement", opt_complement()));
  opts = opts.append(gnu.flag("z", "zero-terminated", opt_zero()));
  opts = opts.append(gnu.flag("n", "", opt_n()));

  var spec: string = "";
  // 0 none yet, 1 bytes or characters, 2 fields.
  var mode: i32 = 0;
  var delim: i32 = 9;
  var delim_set: boolean = false;
  var term: i32 = 10;
  var suppress: boolean = false;
  var complement: boolean = false;
  var out_delim: string = "";
  var out_delim_set: boolean = false;

  var g: gnu.Getopt = gnu.getopt_new(argv, opts, "cut", help_text(), 1);
  while (true) {
    var res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_bytes() || m.id == opt_chars() || m.id == opt_fields()) {
          var want: i32 = 1;
          if (m.id == opt_fields()) {
            want = 2;
          }
          if (mode != 0) {
            gnu.die_usage("only one list may be specified", 1);
          }
          mode = want;
          spec = m.value;
        } else if (m.id == opt_delim()) {
          if (m.value.len() > 1) {
            gnu.die_usage("the delimiter must be a single character", 1);
          }
          delim = 0;
          if (m.value.len() == 1) {
            delim = m.value[0] as i32;
          }
          delim_set = true;
        } else if (m.id == opt_suppress()) {
          suppress = true;
        } else if (m.id == opt_outdelim()) {
          out_delim_set = true;
          // An empty STRING is one NUL byte, as an empty -d is.
          if (m.value.len() == 0) {
            out_delim = byte_str(0);
          } else {
            out_delim = m.value;
          }
        } else if (m.id == opt_complement()) {
          complement = true;
        } else if (m.id == opt_zero()) {
          term = 0;
        }
      },
      None => {
        break;
      }
    }
  }

  if (mode == 0) {
    gnu.die_usage("you must specify a list of bytes, characters, or fields", 1);
  }
  if (delim_set && mode != 2) {
    gnu.die_usage("an input delimiter may be specified only when operating on fields", 1);
  }
  if (suppress && mode != 2) {
    gnu.die_usage("suppressing non-delimited lines makes sense\n\tonly when operating on fields", 1);
  }
  var r: Ranges = parse_list(spec, mode == 2);
  if (complement) {
    r = complement_of(r);
  }
  if (!out_delim_set) {
    out_delim = byte_str(delim);
  }

  var files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  return run(files, Settings { r: r, fields: mode == 2, delim: delim, term: term, suppress: suppress, out_delim: out_delim, out_delim_set: out_delim_set });
}

// `run(files, s)` — the whole selection. Every selected piece is pushed
// straight into stdout's builder, which is flushed once it holds a
// block, so no byte is copied into an accumulator on the way.
function run(files: string[], s: Settings): i32 {
  var o: io_buffered.BufWriter = gnu.out_with(block_size());
  var h: usize = o.handle();
  var ok: boolean = true;
  // A field delimiter equal to the line delimiter makes the whole FILE
  // one record whose fields are its lines.
  var one_record: boolean = s.fields && s.delim == s.term;

  var fi: i32 = 0;
  var have_reader: boolean = false;
  var is_stdin: boolean = false;
  var name: string = "";
  var r: Reader = stdin();
  var chunk: string = "";
  var pos: i32 = 0;
  var delimat: i32 = 0 - 1;
  var carry: string = "";
  var tail: boolean = false;
  var done: boolean = false;
  // The running record, for the one_record shape.
  var rec_idx: u64 = 1 as u64;
  var rec_k: i32 = 0;
  var rec_printed: boolean = false;
  var rec_open: boolean = false;
  var rec_ri: i32 = 0;
  // Whether field 1 is selected, and gnulib's rule for when it has to
  // be read into a buffer before the line can be judged delimited: when
  // exactly one of "non-delimited lines are suppressed" and "field 1 is
  // wanted" holds, the other cannot be decided without the field.
  // Whether the output delimiter is the input delimiter, which is what
  // lets consecutive selected fields go out as one slice of the input.
  var join_runs: boolean = !s.out_delim_set || s.out_delim.len() == 1 && s.out_delim[0] as i32 == s.delim;
  var first_sel: boolean = s.r.los.len() > 0 && s.r.los[0] <= 1 as u64;
  var buffered: boolean = s.suppress == first_sel;

  while (true) {
    if (pos >= chunk.len()) {
      chunk = "";
      pos = 0;
      tail = false;
      var got: boolean = false;
      while (!got) {
        if (!have_reader) {
          // A record open across the lines of the file just finished is
          // closed before the next one starts: cut does not join files.
          if (rec_open) {
            if (!(s.suppress && rec_k == 1 && !first_sel)) {
              buf_push_byte(h, s.term);
            }
            rec_open = false;
          }
          rec_idx = 1 as u64;
          rec_k = 0;
          rec_printed = false;
          rec_ri = 0;
          if (fi >= files.len()) {
            done = true;
            got = true;
          } else {
            name = files[fi];
            fi = fi + 1;
            is_stdin = name == "-";
            if (is_stdin) {
              r = stdin();
              have_reader = true;
            } else {
              var opened: boolean = false;
              match (open_reader(name)) {
                Ok(f) => {
                  r = f;
                  opened = true;
                },
                Err(e) => {
                  o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
                  ok = false;
                }
              }
              have_reader = opened;
            }
          }
        } else {
          var piece: string = "";
          var read_ok: boolean = true;
          match (r.read_chunk(read_size())) {
            Ok(c) => {
              piece = c;
            },
            Err(e) => {
              o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
              ok = false;
              read_ok = false;
            }
          }
          if (read_ok && piece.len() > 0) {
            chunk = piece;
            pos = 0;
            delimat = __memchr(chunk, s.delim, 0);
            got = true;
          } else {
            if (!is_stdin) {
              r.close();
            }
            have_reader = false;
            if (carry.len() > 0) {
              chunk = carry;
              carry = "";
              pos = 0;
              delimat = __memchr(chunk, s.delim, 0);
              tail = true;
              got = true;
            }
          }
        }
      }
      if (done) {
        break;
      }
      continue;
    }

    var j: i32 = __memchr(chunk, s.term, pos);
    if (j < 0) {
      if (!tail) {
        carry = carry + slice_unchecked(chunk, pos, chunk.len());
        pos = chunk.len();
        continue;
      }
      j = chunk.len() - 1;
    }

    var buf: string = chunk;
    var lo: i32 = pos;
    var hi: i32 = j + 1;
    var carried: boolean = carry.len() > 0;
    if (carried) {
      buf = carry + slice_unchecked(chunk, pos, j + 1);
      carry = "";
      lo = 0;
      hi = buf.len();
    }
    pos = j + 1;
    // The line's content, without the terminator it may carry.
    // Only the tail a file left behind is unterminated: it holds
    // everything after that file's last line delimiter.
    var terminated: boolean = !tail;
    var body: i32 = hi;
    if (terminated) {
      body = hi - 1;
    }

    if (!s.fields) {
      var len: u64 = (body - lo) as u64;
      var printed: boolean = false;
      var k: i32 = 0;
      while (k < s.r.los.len() && s.r.los[k] <= len) {
        var a: u64 = s.r.los[k];
        var b: u64 = s.r.his[k];
        if (b > len) {
          b = len;
        }
        if (a <= b) {
          if (s.out_delim_set && printed) {
            buf_push(h, s.out_delim);
          }
          buf_push_range(h, buf, lo + a as i32 - 1, lo + b as i32);
          printed = true;
        }
        k = k + 1;
      }
      buf_push_byte(h, s.term);
    } else if (one_record) {
      // This line is one FIELD of the file-long record. An unterminated
      // FIRST line is the whole record and holds no delimiter at all.
      if (rec_k == 0 && !terminated) {
        if (!s.suppress) {
          buf_push_range(h, buf, lo, body);
          buf_push_byte(h, s.term);
        }
      } else {
        while (rec_ri < s.r.los.len() && s.r.his[rec_ri] < rec_idx) {
          rec_ri = rec_ri + 1;
        }
        if (rec_ri < s.r.los.len() && s.r.los[rec_ri] <= rec_idx) {
          if (rec_printed) {
            buf_push(h, s.out_delim);
          }
          buf_push_range(h, buf, lo, body);
          rec_printed = true;
        }
        rec_idx = rec_idx + 1 as u64;
        rec_k = rec_k + 1;
        rec_open = true;
      }
    } else {
      // Where the next delimiter is. Kept as a cursor across lines so
      // the scans over one chunk cost it once in total.
      var nd: i32 = delimat;
      if (carried) {
        nd = __memchr(buf, s.delim, 0);
      } else if (nd >= 0 && nd < lo) {
        nd = __memchr(chunk, s.delim, lo);
      }
      var first_nd: i32 = nd;
      if (nd < 0 || nd >= body) {
        // No delimiter on this line: it goes out whole, or not at all.
        if (!s.suppress) {
          buf_push_range(h, buf, lo, body);
          buf_push_byte(h, s.term);
        }
      } else {
        var p: i32 = lo;
        var idx: u64 = 1 as u64;
        var ri: i32 = 0;
        var printed: boolean = false;
        // Consecutive selected fields joined by the input delimiter are
        // the input's own bytes, so when the output delimiter IS that
        // byte they go out as ONE slice — `-f1,3-5` costs two appends
        // per line rather than seven.
        var run: i32 = 0 - 1;
        while (true) {
          var e: i32 = body;
          var last: boolean = true;
          if (nd >= 0 && nd < body) {
            e = nd;
            last = false;
          }
          while (ri < s.r.los.len() && s.r.his[ri] < idx) {
            ri = ri + 1;
          }
          if (ri < s.r.los.len() && s.r.los[ri] <= idx) {
            if (run < 0) {
              if (printed) {
                buf_push(h, s.out_delim);
              }
              run = p;
            }
            if (!join_runs) {
              buf_push_range(h, buf, run, e);
              run = 0 - 1;
            }
            printed = true;
          } else if (run >= 0) {
            buf_push_range(h, buf, run, p - 1);
            run = 0 - 1;
          }
          if (last || ri >= s.r.los.len()) {
            break;
          }
          p = e + 1;
          idx = idx + 1 as u64;
          nd = __memchr(buf, s.delim, p);
        }
        if (run >= 0) {
          buf_push_range(h, buf, run, body);
          run = 0 - 1;
        }
        // The line delimiter always follows a delimited line — except
        // for the one shape GNU's own buffering leaves without it: the
        // FIRST field of the record was read into a buffer, the record
        // ends at EOF with an empty second field, and NUL is the line
        // delimiter, so what gnulib carries into the test reads as one.
        if (terminated || !(buffered && s.term == 0 && first_nd == body - 1)) {
          buf_push_byte(h, s.term);
        }
      }
      if (carried) {
        delimat = __memchr(chunk, s.delim, pos);
      } else {
        delimat = nd;
      }
    }

    if (buf_len(h) >= block_size()) {
      o = o.flush();
    }
  }

  gnu.finish(o);
  if (!ok) {
    return 1;
  }
  return 0;
}
