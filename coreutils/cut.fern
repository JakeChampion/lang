import "std/array";
import "std/string";
import "std/u64";
import "std/io_buffered";
import "./lib/gnu";

function opt_bytes(): i32 {
  return 1;
}

function opt_chars(): i32 {
  return 2;
}

function opt_fields(): i32 {
  return 3;
}

function opt_delim(): i32 {
  return 4;
}

function opt_suppress(): i32 {
  return 5;
}

function opt_outdelim(): i32 {
  return 6;
}

function opt_complement(): i32 {
  return 7;
}

function opt_zero(): i32 {
  return 8;
}

function opt_n(): i32 {
  return 9;
}

function opt_whitespace(): i32 {
  return 10;
}

function opt_blank_fields(): i32 {
  return 11;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " OPTION... [FILE]...\n";
  out += "Print selected parts of lines from each FILE to standard output.\n";
  out += "\n";
  out += "With no FILE, or when FILE is -, read standard input.\n";
  out += "\n";
  out += "  -b, --bytes=LIST        select only these bytes\n";
  out += "  -c, --characters=LIST   select only these characters\n";
  out += "  -d, --delimiter=DELIM   use DELIM instead of TAB for field delimiter\n";
  out += "  -f, --fields=LIST       select only these fields;  also print any line\n";
  out += "                            that contains no delimiter character, unless\n";
  out += "                            the -s option is specified\n";
  out += "  -n, --no-partial        with -b, do not split multibyte characters\n";
  out += "  -w, --whitespace-delimited[=trimmed]  use whitespace as the field delimiter\n";
  out += "  -F LIST                 shorthand for -w -O ' ' -f LIST\n";
  out += "      --complement        complement the set of selected bytes, characters\n";
  out += "                            or fields\n";
  out += "  -s, --only-delimited    do not print lines not containing delimiters\n";
  out += "  -O, --output-delimiter=STRING  use STRING as the output delimiter\n";
  out += "                            the default is to use the input delimiter\n";
  out += "  -z, --zero-terminated   line delimiter is NUL, not newline\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  out += "\n";
  out += "Use one, and only one of -b, -c or -f.  Each LIST is made up of one\n";
  out += "range, or many ranges separated by commas.  Selected input is written\n";
  out += "in the same order that it is read, and is written exactly once.\n";
  out += "Each range is one of:\n";
  out += "\n";
  out += "  N     N'th byte, character or field, counted from 1\n";
  out += "  N-    from N'th byte, character or field, to end of line\n";
  out += "  N-M   from N'th to M'th (included) byte, character or field\n";
  out += "  -M    from first to M'th (included) byte, character or field\n";
  return out;
}

function is_blank_byte(b: i32): boolean {
  return b == 32 || b == 9;
}

function read_size(): i32 {
  return 65536;
}

function block_size(): i32 {
  return 16384;
}

function is_digit(c: i32): boolean {
  return c >= 48 && c <= 57;
}

function is_blank(c: i32): boolean {
  return c == 32 || c == 9;
}

function u64_max(): u64 {
  return 18446744073709551615 as u64;
}

struct Ranges { los: u64[], his: u64[] }

function parse_list(spec: string, fields: boolean): Ranges {
  let los: u64[] = [];
  let his: u64[] = [];
  let i = 0;
  let initial = 1 as u64;
  let value = 0 as u64;
  let lhs = false;
  let rhs = false;
  let dash = false;
  while (true) {
    let c: i32 = -1;
    if (i < spec.len()) {
      c = spec[i] as i32;
    }
    if (c == 45) {
      if (dash) {
        gnu.die_usage(range_word(fields), 1);
      }
      dash = true;
      if (lhs && value == 0 as u64) {
        gnu.die_usage(from_one_word(fields), 1);
      }
      initial = 1 as u64;
      if (lhs) {
        initial = value;
      }
      value = 0 as u64;
      i += 1;
    } else if (c < 0 || c == 44 || is_blank(c)) {
      if (dash) {
        dash = false;
        if (!lhs && !rhs) {
          gnu.die_usage("invalid range with no endpoint: -", 1);
        }
        if (!rhs) {
          los = los.append(initial);
          his = his.append(u64_max());
        } else {
          if (value < initial) {
            gnu.die_usage("invalid decreasing range", 1);
          }
          los = los.append(initial);
          his = his.append(value);
        }
        value = 0 as u64;
      } else {
        if (value == 0 as u64) {
          gnu.die_usage(from_one_word(fields), 1);
        }
        los = los.append(value);
        his = his.append(value);
        value = 0 as u64;
      }
      if (c < 0) {
        break;
      }
      i += 1;
      lhs = false;
      rhs = false;
    } else if (is_digit(c)) {
      if (dash) {
        rhs = true;
      } else {
        lhs = true;
      }
      let over = false;
      match (value.checked_mul(10 as u64)) {
        Some(m) => {
          match (m.checked_add((c - 48) as u64)) {
            Some(a) => {
              value = a;
            },
            None => {
              over = true;
            }
          }
        },
        None => {
          over = true;
        }
      }
      if (value == u64_max()) {
        over = true;
      }
      if (over) {
        let from = i;
        while (from > 0 && is_digit(spec[from - 1] as i32)) {
          from -= 1;
        }
        let end = i;
        while (end < spec.len() && is_digit(spec[end] as i32)) {
          end += 1;
        }
        gnu.die_usage(too_large_word(fields) + " " + gnu.quote(slice_unchecked(spec, from, end) + "") + " is too large", 1);
      }
      i += 1;
    } else {
      gnu.die_usage(bad_value_word(fields) + " " + gnu.quote(slice_unchecked(spec, i, spec.len()) + ""), 1);
    }
  }
  return merge(Ranges { los: los, his: his });
}

function from_one_word(fields: boolean): string {
  if (fields) {
    return "fields are numbered from 1";
  }
  return "byte/character positions are numbered from 1";
}

function range_word(fields: boolean): string {
  if (fields) {
    return "invalid field range";
  }
  return "invalid byte or character range";
}

function too_large_word(fields: boolean): string {
  if (fields) {
    return "field number";
  }
  return "byte/character offset";
}

function bad_value_word(fields: boolean): string {
  if (fields) {
    return "invalid field value";
  }
  return "invalid byte/character position";
}

function merge(r: Ranges): Ranges {
  let los = r.los;
  let his = r.his;
  let i = 1;
  while (i < los.len()) {
    let lo = los[i];
    let hi = his[i];
    let j = i - 1;
    while (j >= 0 && los[j] > lo) {
      los = los.with(j + 1, los[j]);
      his = his.with(j + 1, his[j]);
      j -= 1;
    }
    los = los.with(j + 1, lo);
    his = his.with(j + 1, hi);
    i += 1;
  }
  let outl: u64[] = [];
  let outh: u64[] = [];
  i = 0;
  while (i < los.len()) {
    let lo = los[i];
    let hi = his[i];
    let k = i + 1;
    while (k < los.len() && los[k] <= hi) {
      if (his[k] > hi) {
        hi = his[k];
      }
      k += 1;
    }
    outl = outl.append(lo);
    outh = outh.append(hi);
    i = k;
  }
  return Ranges { los: outl, his: outh };
}

function complement_of(r: Ranges): Ranges {
  let los: u64[] = [];
  let his: u64[] = [];
  let prev = 0 as u64;
  let i = 0;
  while (i < r.los.len()) {
    if (r.los[i] > prev + 1 as u64) {
      los = los.append(prev + 1 as u64);
      his = his.append(r.los[i] - 1 as u64);
    }
    prev = r.his[i];
    i += 1;
  }
  if (prev < u64_max()) {
    los = los.append(prev + 1 as u64);
    his = his.append(u64_max());
  }
  return Ranges { los: los, his: his };
}

struct Settings { r: Ranges, fields: boolean, delim: i32, term: i32, suppress: boolean, out_delim: u8[], out_delim_set: boolean, ws: boolean, trim: boolean }

pub function main(): i32 {
  let argv = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("b", "bytes", opt_bytes()));
  opts = opts.append(gnu.valued("c", "characters", opt_chars()));
  opts = opts.append(gnu.valued("f", "fields", opt_fields()));
  opts = opts.append(gnu.valued("d", "delimiter", opt_delim()));
  opts = opts.append(gnu.flag("n", "no-partial", opt_n()));
  opts = opts.append(gnu.optional("w", "whitespace-delimited", opt_whitespace()));
  opts = opts.append(gnu.flag("s", "only-delimited", opt_suppress()));
  opts = opts.append(gnu.valued("O", "output-delimiter", opt_outdelim()));
  opts = opts.append(gnu.flag("", "complement", opt_complement()));
  opts = opts.append(gnu.flag("z", "zero-terminated", opt_zero()));
  opts = opts.append(gnu.valued("F", "", opt_blank_fields()));

  let spec = "";
  let mode = 0;
  let delim = 9;
  let delim_set = false;
  let term = 10;
  let suppress = false;
  let complement = false;
  let out_delim: u8[] = [];
  let out_delim_set = false;
  let ws = false;
  let ws_set = false;
  let trim = false;
  let space_out = false;

  let g = gnu.getopt_new(argv, opts, "cut", help_text(), 1);
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_bytes() || m.id == opt_chars() || m.id == opt_fields() || m.id == opt_blank_fields()) {
          let want = 1;
          if (m.id == opt_fields() || m.id == opt_blank_fields()) {
            want = 2;
          }
          if (m.id == opt_blank_fields()) {
            ws = true;
            space_out = true;
          }
          if (mode != 0) {
            gnu.die_usage("only one list may be specified", 1);
          }
          mode = want;
          spec = m.value;
        } else if (m.id == opt_whitespace()) {
          ws = true;
          ws_set = true;
          if (m.has_value) {
            trim = gnu.argmatch(m.value, ["trimmed"], "--whitespace-delimited") == 0;
          }
        } else if (m.id == opt_delim()) {
          if (m.value.len() > 1) {
            gnu.die_usage("the delimiter must be a single character", 1);
          }
          delim = 0;
          if (m.value.len() == 1) {
            delim = m.value[0] as i32;
          }
          delim_set = true;
        } else if (m.id == opt_suppress()) {
          suppress = true;
        } else if (m.id == opt_outdelim()) {
          out_delim_set = true;
          if (m.value.len() == 0) {
            out_delim = [0 as u8];
          } else {
            out_delim = m.value.bytes();
          }
        } else if (m.id == opt_complement()) {
          complement = true;
        } else if (m.id == opt_zero()) {
          term = 0;
        }
      },
      None => {
        break;
      }
    }
  }

  if (mode == 0) {
    gnu.die_usage("you must specify a list of bytes, characters, or fields", 1);
  }
  if ((delim_set || ws) && mode != 2) {
    gnu.die_usage("an input delimiter makes sense\n\tonly when operating on fields", 1);
  }
  if (suppress && mode != 2) {
    gnu.die_usage("suppressing non-delimited lines makes sense\n\tonly when operating on fields", 1);
  }
  if (delim_set && ws_set) {
    gnu.die_usage("-d and -w are mutually exclusive", 1);
  }
  if (delim_set && !ws_set) {
    ws = false;
  }
  let r = parse_list(spec, mode == 2);
  if (complement) {
    r = complement_of(r);
  }
  if (!out_delim_set) {
    out_delim = [delim as u8];
    if (space_out) {
      out_delim = [32 as u8];
    }
  }

  let files = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  return run(files, Settings { r: r, fields: mode == 2, delim: delim, term: term, suppress: suppress, out_delim: out_delim, out_delim_set: out_delim_set, ws: ws, trim: trim });
}

function run(files: string[], s: Settings): i32 {
  let o = gnu.out_with(block_size());
  let h = o.handle();
  let ok = true;
  let one_record = s.fields && s.delim == s.term;

  let fi = 0;
  let have_reader = false;
  let is_stdin = false;
  let name = "";
  let r = stdin();
  let chunk: u8[] = [];
  let pos = 0;
  let delimat: i32 = -1;
  let carry = buf_new(0);
  let tail = false;
  let done = false;
  let rec_idx = 1 as u64;
  let rec_k = 0;
  let rec_printed = false;
  let rec_open = false;
  let rec_ri = 0;
  let join_runs = s.out_delim.len() == 1 && s.out_delim[0] as i32 == s.delim;
  let first_sel = s.r.los.len() > 0 && s.r.los[0] <= 1 as u64;

  while (true) {
    if (pos >= chunk.len()) {
      chunk = [];
      pos = 0;
      tail = false;
      let got = false;
      while (!got) {
        if (!have_reader) {
          if (rec_open) {
            if (!(s.suppress && rec_k == 1 && !first_sel)) {
              buf_push_byte(h, s.term);
            }
            rec_open = false;
          }
          rec_idx = 1 as u64;
          rec_k = 0;
          rec_printed = false;
          rec_ri = 0;
          if (fi >= files.len()) {
            done = true;
            got = true;
          } else {
            name = files[fi];
            fi += 1;
            is_stdin = name == "-";
            if (is_stdin) {
              r = stdin();
              have_reader = true;
            } else {
              let opened = false;
              match (open_reader(name)) {
                Ok(f) => {
                  r = f;
                  opened = true;
                },
                Err(e) => {
                  o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
                  ok = false;
                }
              }
              have_reader = opened;
            }
          }
        } else {
          let piece: u8[] = [];
          let read_ok = true;
          match (r.read_chunk_bytes(read_size())) {
            Ok(c) => {
              piece = c;
            },
            Err(e) => {
              o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
              ok = false;
              read_ok = false;
            }
          }
          if (read_ok && piece.len() > 0) {
            chunk = piece;
            pos = 0;
            delimat = __memchr_bytes(chunk, s.delim, 0);
            got = true;
          } else {
            if (!is_stdin) {
              r.close();
              r = stdin();
            }
            have_reader = false;
            if (buf_len(carry) > 0) {
              chunk = buf_take_bytes(carry);
              pos = 0;
              delimat = __memchr_bytes(chunk, s.delim, 0);
              tail = true;
              got = true;
            }
          }
        }
      }
      if (done) {
        break;
      }
      continue;
    }

    let j = __memchr_bytes(chunk, s.term, pos);
    if (j < 0) {
      if (!tail) {
        buf_push_bytes_range(carry, chunk, pos, chunk.len());
        pos = chunk.len();
        continue;
      }
      j = chunk.len() - 1;
    }

    let buf = chunk;
    let lo = pos;
    let hi = j + 1;
    let carried = buf_len(carry) > 0;
    if (carried) {
      buf_push_bytes_range(carry, chunk, pos, j + 1);
      buf = buf_take_bytes(carry);
      lo = 0;
      hi = buf.len();
    }
    pos = j + 1;
    let terminated = !tail;
    let body = hi;
    if (terminated) {
      body = hi - 1;
    }

    if (!s.fields) {
      let len = (body - lo) as u64;
      let printed = false;
      let k = 0;
      while (k < s.r.los.len() && s.r.los[k] <= len) {
        let a = s.r.los[k];
        let b = s.r.his[k];
        if (b > len) {
          b = len;
        }
        if (a <= b) {
          if (s.out_delim_set && printed) {
            buf_push_bytes_range(h, s.out_delim, 0, s.out_delim.len());
          }
          buf_push_bytes_range(h, buf, lo + a as i32 - 1, lo + b as i32);
          printed = true;
        }
        k += 1;
      }
      buf_push_byte(h, s.term);
    } else if (one_record) {
      if (rec_k == 0 && !terminated) {
        if (!s.suppress) {
          buf_push_bytes_range(h, buf, lo, body);
          buf_push_byte(h, s.term);
        }
      } else {
        while (rec_ri < s.r.los.len() && s.r.his[rec_ri] < rec_idx) {
          rec_ri += 1;
        }
        if (rec_ri < s.r.los.len() && s.r.los[rec_ri] <= rec_idx) {
          if (rec_printed) {
            buf_push_bytes_range(h, s.out_delim, 0, s.out_delim.len());
          }
          buf_push_bytes_range(h, buf, lo, body);
          rec_printed = true;
        }
        rec_idx = rec_idx + 1 as u64;
        rec_k += 1;
        rec_open = true;
      }
    } else if (s.ws) {
      let a = lo;
      let z = body;
      if (s.trim) {
        while (a < z && is_blank_byte(buf[a] as i32)) {
          a += 1;
        }
        while (z > a && is_blank_byte(buf[z - 1] as i32)) {
          z -= 1;
        }
      }
      let wb = a;
      while (wb < z && !is_blank_byte(buf[wb] as i32)) {
        wb += 1;
      }
      if (wb >= z) {
        if (s.r.los.len() == 0) {
          buf_push_byte(h, s.term);
        } else if (!s.suppress) {
          buf_push_bytes_range(h, buf, a, z);
          buf_push_byte(h, s.term);
        }
      } else {
        let widx = 1 as u64;
        let wri = 0;
        let wprinted = false;
        let wp = a;
        while (true) {
          let we = wp;
          while (we < z && !is_blank_byte(buf[we] as i32)) {
            we += 1;
          }
          while (wri < s.r.los.len() && s.r.his[wri] < widx) {
            wri += 1;
          }
          if (wri < s.r.los.len() && s.r.los[wri] <= widx) {
            if (wprinted) {
              buf_push_bytes_range(h, s.out_delim, 0, s.out_delim.len());
            }
            buf_push_bytes_range(h, buf, wp, we);
            wprinted = true;
          }
          if (we >= z || wri >= s.r.los.len()) {
            break;
          }
          let wn = we;
          while (wn < z && is_blank_byte(buf[wn] as i32)) {
            wn += 1;
          }
          wp = wn;
          widx = widx + 1 as u64;
        }
        buf_push_byte(h, s.term);
      }
    } else {
      let nd = delimat;
      if (carried) {
        nd = __memchr_bytes(buf, s.delim, 0);
      } else if (nd >= 0 && nd < lo) {
        nd = __memchr_bytes(chunk, s.delim, lo);
      }
      if (nd < 0 || nd >= body) {
        if (s.r.los.len() == 0) {
          buf_push_byte(h, s.term);
        } else if (!s.suppress) {
          buf_push_bytes_range(h, buf, lo, body);
          buf_push_byte(h, s.term);
        }
      } else {
        let p = lo;
        let idx = 1 as u64;
        let ri = 0;
        let printed = false;
        let run: i32 = -1;
        while (true) {
          let e = body;
          let last = true;
          if (nd >= 0 && nd < body) {
            e = nd;
            last = false;
          }
          while (ri < s.r.los.len() && s.r.his[ri] < idx) {
            ri += 1;
          }
          if (ri < s.r.los.len() && s.r.los[ri] <= idx) {
            if (run < 0) {
              if (printed) {
                buf_push_bytes_range(h, s.out_delim, 0, s.out_delim.len());
              }
              run = p;
            }
            if (!join_runs) {
              buf_push_bytes_range(h, buf, run, e);
              run = -1;
            }
            printed = true;
          } else if (run >= 0) {
            buf_push_bytes_range(h, buf, run, p - 1);
            run = -1;
          }
          if (last || ri >= s.r.los.len()) {
            break;
          }
          p = e + 1;
          idx = idx + 1 as u64;
          nd = __memchr_bytes(buf, s.delim, p);
        }
        if (run >= 0) {
          buf_push_bytes_range(h, buf, run, body);
          run = -1;
        }
        buf_push_byte(h, s.term);
      }
      if (carried) {
        delimat = __memchr_bytes(chunk, s.delim, pos);
      } else {
        delimat = nd;
      }
    }

    if (buf_len(h) >= block_size()) {
      o = gnu.flush(o);
    }
  }

  buf_free(carry);
  gnu.finish(o);
  if (!ok) {
    return 1;
  }
  return 0;
}
