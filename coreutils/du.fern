// du.fern — GNU-compatible `du`.
//
//   du [OPTION]... [FILE]...
//   du [OPTION]... --files0-from=F
//
// Disk usage, summed post-order over each operand's tree and printed in
// raw readdir order — du does not sort, and a directory's line follows
// the lines of everything inside it.
//
// Four things about this are not obvious from the synopsis:
//
//   - The quantity is `st_blocks * 512`, so it is what the filesystem
//     ALLOCATED. `--apparent-size` / `-b` switch to `st_size`, and a
//     DIRECTORY then counts as zero rather than as its own st_size.
//   - Every inode is counted and printed at most once per run, files
//     with a single link included and across operands: `du -s a a`
//     prints one line. The same set is what silently stops a symlink
//     loop under `-L`, and `-l` turns the whole mechanism off.
//   - A trailing slash on an operand collapses to exactly ONE in that
//     operand's own line while its children are named with all of them
//     stripped, and on a SYMLINK it forces traversal even under the
//     default `-P`, because the kernel resolves `slink/` for lstat.
//   - Every unit option — `-h` `--si` `-k` `-m` `-B` `-b` — is last
//     wins, except that `-b`'s apparent-size half survives a later
//     unit change.
//
// A failed operand or an unreadable directory costs the exit status and
// not the run: the walk continues, and the directory still gets a line
// of its own.
//
// Timestamps (`--time`) are rendered in UTC. Reading the zone — TZ and
// the TZif files glibc's localtime consults — is a shared piece the
// utilities that print times all need and it is not written yet
// (#9076); the parity gate pins TZ=UTC, so every case there is exact.
import "std/string";
import "std/array";
import "std/u64";
import "std/i64";
import "std/io_buffered";
import "core/map";
import "./lib/gnu";
import "./lib/timefmt";
import "./lib/tz";
import "./lib/blocks";

function opt_null(): i32 {
  return 1;
}

function opt_all(): i32 {
  return 2;
}

function opt_apparent(): i32 {
  return 3;
}

function opt_block_size(): i32 {
  return 4;
}

function opt_bytes(): i32 {
  return 5;
}

function opt_total(): i32 {
  return 6;
}

function opt_dereference(): i32 {
  return 7;
}

function opt_dereference_args(): i32 {
  return 8;
}

function opt_max_depth(): i32 {
  return 9;
}

function opt_files0(): i32 {
  return 10;
}

function opt_human(): i32 {
  return 11;
}

function opt_inodes(): i32 {
  return 12;
}

function opt_count_links(): i32 {
  return 13;
}

function opt_no_dereference(): i32 {
  return 14;
}

function opt_si(): i32 {
  return 15;
}

function opt_separate_dirs(): i32 {
  return 16;
}

function opt_summarize(): i32 {
  return 17;
}

function opt_threshold(): i32 {
  return 18;
}

function opt_time(): i32 {
  return 19;
}

function opt_time_style(): i32 {
  return 20;
}

function opt_exclude(): i32 {
  return 21;
}

function opt_exclude_from(): i32 {
  return 22;
}

function opt_one_file_system(): i32 {
  return 23;
}

function opt_kilo(): i32 {
  return 24;
}

function opt_mega(): i32 {
  return 25;
}

function opt_deref_args_h(): i32 {
  return 26;
}

// The three symlink modes -L / -D / -P choose between; they are one
// setting and the last one typed wins.
function deref_none(): i32 {
  return 0;
}

function deref_args(): i32 {
  return 1;
}

function deref_all(): i32 {
  return 2;
}

// Which stat timestamp `--time` shows.
function time_none(): i32 {
  return 0 - 1;
}

function time_mtime(): i32 {
  return 0;
}

function time_atime(): i32 {
  return 1;
}

function time_ctime(): i32 {
  return 2;
}

// `Conf` — every decision the option scan makes, read by the walk.
//
// The unit is `human` when that is non-zero (the count is scaled by
// powers of it) and `block_size` otherwise (the count is divided by it,
// rounding UP). `suffix` is what a bare `-BK` prints after each number,
// derived from the final divisor rather than echoed from the spec —
// which is why `--inodes -BKiB` prints `B` and not `KiB`.
pub struct Conf { all: boolean, apparent: boolean, block_size: u64, suffix: string, human: u64, total: boolean, deref: i32, max_depth: u64, inodes: boolean, count_links: boolean, separate_dirs: boolean, threshold: i64, has_threshold: boolean, time_kind: i32, time_format: string, zone: tz.Zone, excludes: string[], one_file_system: boolean, terminator: string }

function help_text(): string {
  var out: string = "";
  out = out + "Usage: du [OPTION]... [FILE]...\n";
  out = out + "  or:  du [OPTION]... --files0-from=F\n";
  out = out + "Summarize device usage of the set of FILEs, recursively for directories.\n";
  out = out + "\n";
  out = out + "  -0, --null            end each output line with NUL, not newline\n";
  out = out + "  -a, --all             write counts for all files, not just directories\n";
  out = out + "      --apparent-size   print apparent sizes rather than device usage\n";
  out = out + "  -B, --block-size=SIZE  scale sizes by SIZE before printing them\n";
  out = out + "  -b, --bytes           equivalent to '--apparent-size --block-size=1'\n";
  out = out + "  -c, --total           produce a grand total\n";
  out = out + "  -D, --dereference-args  dereference only symlinks listed on the command line\n";
  out = out + "  -d, --max-depth=N     print the total for a directory only if it is N or\n";
  out = out + "                          fewer levels below the command line argument\n";
  out = out + "      --files0-from=F   summarize device usage of the NUL-terminated file\n";
  out = out + "                          names specified in file F; if F is -, read stdin\n";
  out = out + "  -H                    equivalent to --dereference-args (-D)\n";
  out = out + "  -h, --human-readable  print sizes in human readable format\n";
  out = out + "      --inodes          list inode usage information instead of block usage\n";
  out = out + "  -k                    like --block-size=1K\n";
  out = out + "  -L, --dereference     dereference all symbolic links\n";
  out = out + "  -l, --count-links     count sizes many times if hard linked\n";
  out = out + "  -m                    like --block-size=1M\n";
  out = out + "  -P, --no-dereference  don't follow any symbolic links (this is the default)\n";
  out = out + "  -S, --separate-dirs   for directories do not include size of subdirectories\n";
  out = out + "      --si              like -h, but use powers of 1000 not 1024\n";
  out = out + "  -s, --summarize       display only a total for each argument\n";
  out = out + "  -t, --threshold=SIZE  exclude entries smaller than SIZE if positive,\n";
  out = out + "                          or entries greater than SIZE if negative\n";
  out = out + "      --time            show time of the last modification of any file in\n";
  out = out + "                          the directory, or any of its subdirectories\n";
  out = out + "      --time=WORD       show time as WORD instead of modification time:\n";
  out = out + "                          atime, access, use, ctime or status\n";
  out = out + "      --time-style=STYLE  show times using STYLE, which can be full-iso,\n";
  out = out + "                          long-iso, iso, or +FORMAT\n";
  out = out + "  -X, --exclude-from=FILE  exclude files that match any pattern in FILE\n";
  out = out + "      --exclude=PATTERN    exclude files that match PATTERN\n";
  out = out + "  -x, --one-file-system    skip directories on different file systems\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

// ---- exclusion -------------------------------------------------------------
// `fnmatch(pattern, text)` — POSIX fnmatch with NO flags, which is what
// --exclude matches under: `*` and `?` CROSS `/`, a backslash escapes
// the next character, and a bracket may be negated with `!` or `^`.
function fnmatch(p: string, t: string): boolean {
  return match_at(p, 0, t, 0);
}

function match_at(p: string, pi0: i32, t: string, ti0: i32): boolean {
  var pi: i32 = pi0;
  var ti: i32 = ti0;
  while (pi < p.len()) {
    var pc: i32 = p[pi] as i32;
    if (pc == 42) {
      var k: i32 = ti;
      while (k <= t.len()) {
        if (match_at(p, pi + 1, t, k)) {
          return true;
        }
        k = k + 1;
      }
      return false;
    }
    if (ti >= t.len()) {
      return false;
    }
    if (pc == 63) {
      pi = pi + 1;
      ti = ti + 1;
      continue;
    }
    if (pc == 91) {
      var r: (boolean, i32) = bracket(p, pi, t[ti] as i32);
      if (r.1 >= 0) {
        if (!r.0) {
          return false;
        }
        pi = r.1;
        ti = ti + 1;
        continue;
      }
    }
    // An unterminated `[` is a literal one.
    if (pc == 92 && pi + 1 < p.len()) {
      pi = pi + 1;
      pc = p[pi] as i32;
    }
    if (pc != t[ti] as i32) {
      return false;
    }
    pi = pi + 1;
    ti = ti + 1;
  }
  return ti == t.len();
}

// One bracket expression against `ch`, returning (matched, the index
// past the `]`), or a negative index when the bracket is never closed.
function bracket(p: string, start: i32, ch: i32): (boolean, i32) {
  var i: i32 = start + 1;
  var negate: boolean = false;
  if (i < p.len() && (p[i] as i32 == 33 || p[i] as i32 == 94)) {
    negate = true;
    i = i + 1;
  }
  var matched: boolean = false;
  var first: boolean = true;
  while (i < p.len()) {
    if (p[i] as i32 == 93 && !first) {
      if (negate) {
        return (!matched, i + 1);
      }
      return (matched, i + 1);
    }
    first = false;
    if (p[i] as i32 == 91 && i + 1 < p.len() && p[i + 1] as i32 == 58) {
      var close: i32 = find_class_end(p, i + 2);
      if (close > 0) {
        if (in_class(slice_unchecked(p, i + 2, close) + "", ch)) {
          matched = true;
        }
        i = close + 2;
        continue;
      }
    }
    var lo: i32 = p[i] as i32;
    if (lo == 92 && i + 1 < p.len()) {
      i = i + 1;
      lo = p[i] as i32;
    }
    if (i + 2 < p.len() && p[i + 1] as i32 == 45 && p[i + 2] as i32 != 93) {
      if (ch >= lo && ch <= p[i + 2] as i32) {
        matched = true;
      }
      i = i + 3;
      continue;
    }
    if (ch == lo) {
      matched = true;
    }
    i = i + 1;
  }
  return (false, 0 - 1);
}

function find_class_end(p: string, from: i32): i32 {
  var i: i32 = from;
  while (i + 1 < p.len()) {
    if (p[i] as i32 == 58 && p[i + 1] as i32 == 93) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function in_class(name: string, ch: i32): boolean {
  var alpha: boolean = ch >= 65 && ch <= 90 || ch >= 97 && ch <= 122;
  var digit: boolean = ch >= 48 && ch <= 57;
  if (name == "alpha") {
    return alpha;
  }
  if (name == "digit") {
    return digit;
  }
  if (name == "alnum") {
    return alpha || digit;
  }
  if (name == "upper") {
    return ch >= 65 && ch <= 90;
  }
  if (name == "lower") {
    return ch >= 97 && ch <= 122;
  }
  if (name == "space") {
    return ch == 32 || ch >= 9 && ch <= 13;
  }
  if (name == "blank") {
    return ch == 32 || ch == 9;
  }
  if (name == "print") {
    return ch >= 32 && ch < 127;
  }
  if (name == "graph") {
    return ch > 32 && ch < 127;
  }
  if (name == "cntrl") {
    return ch < 32 || ch == 127;
  }
  if (name == "punct") {
    return ch > 32 && ch < 127 && !alpha && !digit;
  }
  if (name == "xdigit") {
    return blocks.hex_digit(ch) >= 0;
  }
  return false;
}

// `excluded(c, name)` — whether any --exclude pattern matches the name
// as printed, or any suffix of it starting just after a `/`, which is
// what makes `--exclude=sub` drop `a/sub`.
function excluded(c: Conf, name: string): boolean {
  var i: i32 = 0;
  while (i < c.excludes.len()) {
    if (fnmatch(c.excludes[i], name)) {
      return true;
    }
    var j: i32 = 0;
    while (j < name.len()) {
      if (name[j] as i32 == 47) {
        if (fnmatch(c.excludes[i], slice_unchecked(name, j + 1, name.len()) + "")) {
          return true;
        }
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return false;
}

// ---- the walk --------------------------------------------------------------
function join_path(dir: string, name: string): string {
  if (dir.len() > 0 && dir[dir.len() - 1] as i32 == 47) {
    return dir + name;
  }
  return dir + "/" + name;
}

// The operand with every trailing slash removed — the prefix its
// children are named with. A name that is nothing but slashes keeps
// one, and `//` keeps both: the kernel treats it as a root of its own.
function walk_base(arg: string): string {
  var n: i32 = arg.len();
  while (n > 0 && arg[n - 1] as i32 == 47) {
    n = n - 1;
  }
  if (n == 0) {
    if (arg.len() == 2) {
      return "//";
    }
    return "/";
  }
  return slice_unchecked(arg, 0, n) + "";
}

// The operand's own line names it with its trailing slashes collapsed
// to exactly one: `du -s a//` prints `a/` while its children print
// `a/f1`.
function display_name(arg: string): string {
  if (arg.len() == 0) {
    return arg;
  }
  if (arg[arg.len() - 1] as i32 != 47) {
    return arg;
  }
  var b: string = walk_base(arg);
  if (b[b.len() - 1] as i32 == 47) {
    return b;
  }
  return b + "/";
}

// The key an entry takes in the already-seen set. A string, because that
// and an i32-sized scalar are the only key types Map takes and the pair
// is two 64-bit words; the sixteen-raw-byte spelling was measured and is
// SLOWER, since building it is sixteen `.with` calls on a fresh buffer.
function inode_key(dev: i64, ino: i64): string {
  return dev.to_string() + "/" + ino.to_string();
}

function is_symlink(st: FileStat): boolean {
  return (st.mode & 61440 as u32) == 40960 as u32;
}

// The bytes — or, under --inodes, the one inode — an entry contributes.
// A directory has no apparent size: `du -b` reports 0 for it, never its
// own st_size.
function entry_size(c: Conf, st: FileStat, is_dir: boolean): u64 {
  if (c.inodes) {
    return 1 as u64;
  }
  if (c.apparent) {
    if (is_dir || st.size < 0 as i64) {
      return 0 as u64;
    }
    return st.size as u64;
  }
  if (st.blocks <= 0 as i64) {
    return 0 as u64;
  }
  return st.blocks as u64 * (512 as u64);
}

function stamp_of(c: Conf, st: FileStat): (i64, i64) {
  if (c.time_kind == time_atime()) {
    return (st.atime, st.atime_nsec);
  }
  if (c.time_kind == time_ctime()) {
    return (st.ctime, st.ctime_nsec);
  }
  return (st.mtime, st.mtime_nsec);
}

function newer(a: i64, an: i64, b: i64, bn: i64): boolean {
  if (a != b) {
    return a > b;
  }
  return an > bn;
}

// `cannot access` for a path that would not stat. A symlink whose
// target is simply not there loses the errno — that is the one entry
// kind fts reports without one — while every other failure keeps it.
function access_failure(name: string, e: IoError): string {
  match (e) {
    NotFound(_) => {
      return "cannot access " + gnu.quotea(name);
    },
    _ => {}
  }
  return "cannot access " + gnu.quotea(name) + ": " + gnu.io_error_text(e);
}

function passes_threshold(c: Conf, size: u64): boolean {
  if (!c.has_threshold) {
    return true;
  }
  if (c.threshold >= 0 as i64) {
    return size >= c.threshold as u64;
  }
  return size <= 0 as u64 - c.threshold as u64;
}

// Whether this entry earns a line: within --max-depth, and either a
// directory, an operand, or anything at all under -a.
function wants_line(c: Conf, depth: i32, is_dir: boolean): boolean {
  if (depth as u64 > c.max_depth) {
    return false;
  }
  return is_dir || c.all || depth == 0;
}

function emit(c: Conf, o: io_buffered.BufWriter, size: u64, tsec: i64, tnsec: i64, display: string): io_buffered.BufWriter {
  var line: string = blocks.format_size(size, c.block_size, c.suffix, c.human) + "\t";
  if (c.time_kind != time_none()) {
    line = line + timefmt.strftime(c.time_format, c.zone, tsec, tnsec) + "\t";
  }
  return o.write_string(line + display + c.terminator);
}

// `Frame` — a directory whose children are still being walked: where it
// is, what readdir gave back, how far through that list the walk is, and
// the two running sums. `full` is the true subtree total, which the
// parent adds and which -c sums; `shown` is what this directory's own
// line will print, which is the same number unless -S left the
// subdirectories out of it. Each carries the newest stamp counted into
// it, for --time.
struct Frame { path: string, display: string, names: string[], idx: i32, depth: i32, dev: i64, ino: i64, full: u64, shown: u64, ftime: i64, fnsec: i64, stime: i64, snsec: i64 }

// `walk` — every operand, and everything under each of them.
//
// One function rather than a recursion, because the already-seen set has
// to stay a LOCAL: a Map handed to a callee is aliased by the call, so
// its next mutator copies the whole table instead of writing in place,
// and the walk goes quadratic in the number of files. The directory
// stack is explicit for the same reason, and it costs nothing that
// matters — a deep tree is a longer array rather than a deeper frame.
//
// The one thing this cannot do is walk PAST `PATH_MAX`: every primitive
// here takes a path, so a component 8 KiB down is `File name too long`
// where GNU's fts, which opens each directory and reads it fd-relative,
// keeps going (#9078). That tree reports what it could read and exits 1,
// the same shape an unreadable directory has.
//
// Returns the exit status.
function walk(c: Conf, names: string[], have_files0: boolean, list_name: string, from_stdin: boolean): i32 {
  var out: io_buffered.BufWriter = gnu.out_new();
  var seen: Map[string, i32] = map_new(1024);
  var failed: boolean = false;
  var grand: u64 = 0 as u64;
  var gtime: i64 = 0 as i64;
  var gnsec: i64 = 0 as i64;
  var stack: Frame[] = [];

  var oi: i32 = 0;
  while (oi < names.len()) {
    var arg: string = names[oi];
    var ordinal: i32 = oi + 1;
    oi = oi + 1;
    if (arg.len() == 0) {
      var where: string = "";
      if (have_files0) {
        where = gnu.quotef(list_name) + ":" + ordinal.to_string() + ": ";
      }
      out = gnu.error_out(out, where + "invalid zero-length file name");
      failed = true;
      continue;
    }
    if (from_stdin && arg == "-") {
      out = gnu.error_out(out, "when reading file names from stdin, no file name of '-' allowed");
      failed = true;
      continue;
    }
    var display: string = display_name(arg);
    if (excluded(c, display)) {
      continue;
    }
    // The stat names the operand as TYPED, so a trailing slash resolves
    // a symlink through the kernel exactly as it does for GNU.
    var st: FileStat = zero_stat();
    var got: boolean = false;
    match (lstat(arg)) {
      Ok(s) => {
        st = s;
        got = true;
      },
      Err(e) => {
        out = gnu.error_out(out, "cannot access " + gnu.quotea(display) + ": " + gnu.io_error_text(e));
        failed = true;
      }
    }
    if (!got) {
      continue;
    }
    if (c.deref != deref_none() && is_symlink(st)) {
      var resolved: boolean = false;
      match (stat(arg)) {
        Ok(s) => {
          st = s;
          resolved = true;
        },
        Err(e) => {
          out = gnu.error_out(out, access_failure(display, e));
          failed = true;
        }
      }
      if (!resolved) {
        continue;
      }
    }

    var root_dev: i64 = st.dev;
    var sp: i32 = 0;
    // The entry waiting to be counted: the operand first, then each
    // child the stack's top frame hands over.
    var pending: boolean = true;
    var p_path: string = walk_base(arg);
    var p_display: string = display;
    var p_st: FileStat = st;
    var p_depth: i32 = 0;
    // What a finished entry contributes to its parent — or, with the
    // stack empty, to this operand's total.
    var owed: boolean = false;
    var o_size: u64 = 0 as u64;
    var o_time: i64 = 0 as i64;
    var o_nsec: i64 = 0 as i64;
    var o_dir: boolean = false;
    var total: u64 = 0 as u64;
    var ttime: i64 = 0 as i64;
    var tnsec: i64 = 0 as i64;
    var thave: boolean = false;

    while (pending || owed || sp > 0) {
      if (owed) {
        owed = false;
        if (sp > 0) {
          var par: Frame = stack[sp - 1];
          var nfull: u64 = par.full + o_size;
          var nft: i64 = par.ftime;
          var nfn: i64 = par.fnsec;
          if (newer(o_time, o_nsec, nft, nfn)) {
            nft = o_time;
            nfn = o_nsec;
          }
          var nshown: u64 = par.shown;
          var nst: i64 = par.stime;
          var nsn: i64 = par.snsec;
          if (!c.separate_dirs || !o_dir) {
            nshown = nshown + o_size;
            if (newer(o_time, o_nsec, nst, nsn)) {
              nst = o_time;
              nsn = o_nsec;
            }
          }
          stack = stack.with(sp - 1, Frame { ...par, full: nfull, shown: nshown, ftime: nft, fnsec: nfn, stime: nst, snsec: nsn });
        } else {
          total = total + o_size;
          if (!thave || newer(o_time, o_nsec, ttime, tnsec)) {
            ttime = o_time;
            tnsec = o_nsec;
          }
          thave = true;
        }
        continue;
      }

      if (pending) {
        pending = false;
        // Every inode is counted and printed at most once per run —
        // files with a single link included, and across operands. The
        // same set is what silently stops a symlink loop under -L; -l
        // turns the whole mechanism off.
        var known: boolean = false;
        if (!c.count_links) {
          var key: string = inode_key(p_st.dev, p_st.ino);
          match (seen.get(key)) {
            Some(_) => {
              known = true;
            },
            None => {}
          }
          if (!known) {
            seen = seen.insert(key, 1);
          }
        }
        if (known) {
          continue;
        }
        var own: u64 = entry_size(c, p_st, p_st.is_dir);
        var stamp: (i64, i64) = stamp_of(c, p_st);
        if (p_st.is_dir) {
          // A directory already on the path from the operand to here is a
          // CYCLE, which `-L` reaches through a symlink pointing at an
          // ancestor. It is skipped whole — no line, nothing counted, and
          // nothing said. The check is separate from the seen set above
          // because `-l` turns that off, and the descent would then be
          // endless; the stack IS the path, so this is a walk of it.
          var cycle: boolean = false;
          var f: i32 = 0;
          while (f < sp) {
            if (stack[f].dev == p_st.dev && stack[f].ino == p_st.ino) {
              cycle = true;
              break;
            }
            f = f + 1;
          }
          if (cycle) {
            continue;
          }
          var kids: string[] = [];
          match (read_dir(p_path)) {
            Ok(es) => {
              kids = es;
            },
            Err(e) => {
              out = gnu.error_out(out, "cannot read directory " + gnu.quotea(p_display) + ": " + gnu.io_error_text(e));
              failed = true;
            }
          }
          var pushed: Frame = Frame { path: p_path, display: p_display, names: kids, idx: 0, depth: p_depth, dev: p_st.dev, ino: p_st.ino, full: own, shown: own, ftime: stamp.0, fnsec: stamp.1, stime: stamp.0, snsec: stamp.1 };
          if (sp < stack.len()) {
            stack = stack.with(sp, pushed);
          } else {
            stack = stack.append(pushed);
          }
          sp = sp + 1;
          continue;
        }
        if (wants_line(c, p_depth, false) && passes_threshold(c, own)) {
          out = emit(c, out, own, stamp.0, stamp.1, p_display);
        }
        owed = true;
        o_size = own;
        o_time = stamp.0;
        o_nsec = stamp.1;
        o_dir = false;
        continue;
      }

      var top: Frame = stack[sp - 1];
      if (top.idx >= top.names.len()) {
        // Post-order: the directory's own line follows its contents.
        sp = sp - 1;
        if (wants_line(c, top.depth, true) && passes_threshold(c, top.shown)) {
          out = emit(c, out, top.shown, top.stime, top.snsec, top.display);
        }
        owed = true;
        o_size = top.full;
        o_time = top.ftime;
        o_nsec = top.fnsec;
        o_dir = true;
        continue;
      }
      var nm: string = top.names[top.idx];
      stack = stack.with(sp - 1, Frame { ...top, idx: top.idx + 1 });
      var cpath: string = join_path(top.path, nm);
      var cname: string = join_path(top.display, nm);
      if (excluded(c, cname)) {
        continue;
      }
      var cst: FileStat = zero_stat();
      var cgot: boolean = false;
      match (lstat(cpath)) {
        Ok(s) => {
          cst = s;
          cgot = true;
        },
        Err(e) => {
          out = gnu.error_out(out, "cannot access " + gnu.quotea(cname) + ": " + gnu.io_error_text(e));
          failed = true;
        }
      }
      if (!cgot) {
        continue;
      }
      if (c.deref == deref_all() && is_symlink(cst)) {
        var cres: boolean = false;
        match (stat(cpath)) {
          Ok(s) => {
            cst = s;
            cres = true;
          },
          Err(e) => {
            out = gnu.error_out(out, access_failure(cname, e));
            failed = true;
          }
        }
        if (!cres) {
          continue;
        }
      }
      // -x takes its device from the operand being walked, so naming a
      // mount point directly still measures it; a crossing below one
      // vanishes rather than appearing as a zero.
      if (c.one_file_system && cst.dev != root_dev) {
        continue;
      }
      p_path = cpath;
      p_display = cname;
      p_st = cst;
      p_depth = top.depth + 1;
      pending = true;
    }

    grand = grand + total;
    if (thave && newer(ttime, tnsec, gtime, gnsec)) {
      gtime = ttime;
      gnsec = tnsec;
    }
  }

  if (c.total) {
    out = emit(c, out, grand, gtime, gnsec, "total");
  }
  out = out.flush();
  gnu.close_stdout(out, false);
  if (failed) {
    return 1;
  }
  return 0;
}

function zero_stat(): FileStat {
  return FileStat { is_file: false, is_dir: false, size: 0 as i64, mode: 0 as u32, nlink: 0 as u32, uid: 0 as u32, gid: 0 as u32, dev: 0 as i64, rdev: 0 as i64, ino: 0 as i64, blksize: 0 as i64, blocks: 0 as i64, atime: 0 as i64, atime_nsec: 0 as i64, mtime: 0 as i64, mtime_nsec: 0 as i64, ctime: 0 as i64, ctime_nsec: 0 as i64 };
}

// ---- reading a list of names ------------------------------------------------
// `Slurp` — a whole file read in, or the failure that stopped it.
// `at_open` separates a name that could not be OPENED from one that
// could not be READ, which du words differently.
struct Slurp { text: string, ok: boolean, at_open: boolean, err: Option[IoError] }

// The whole of `path`, or stdin for `-`.
function slurp(path: string): Slurp {
  var r: Reader = stdin();
  if (path != "-") {
    match (open_reader(path)) {
      Ok(f) => {
        r = f;
      },
      Err(e) => {
        return Slurp { text: "", ok: false, at_open: true, err: Some(e) };
      }
    }
  }
  var chunks: string[] = [];
  var text: string = "";
  while (true) {
    match (r.read_chunk(65536)) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          break;
        }
        chunks = chunks.append(chunk);
      },
      Err(e) => {
        if (path != "-") {
          r.close();
        }
        return Slurp { text: "", ok: false, at_open: false, err: Some(e) };
      }
    }
  }
  if (path != "-") {
    r.close();
  }
  var i: i32 = 0;
  while (i < chunks.len()) {
    text = text + chunks[i];
    i = i + 1;
  }
  return Slurp { text: text, ok: true, at_open: false, err: None };
}

// The patterns of a -X file: one per line, a trailing carriage return
// stripped, the line cut at an embedded NUL, and an empty line ignored.
// Leading and trailing SPACES are significant.
function exclude_patterns(text: string): string[] {
  var out: string[] = [];
  var start: i32 = 0;
  var i: i32 = 0;
  while (i <= text.len()) {
    if (i == text.len() || text[i] as i32 == 10) {
      var stop: i32 = i;
      while (stop > start && text[stop - 1] as i32 == 13) {
        stop = stop - 1;
      }
      var j: i32 = start;
      while (j < stop && text[j] as i32 != 0) {
        j = j + 1;
      }
      if (j > start) {
        out = out.append(slice_unchecked(text, start, j) + "");
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

// The NUL-separated names of a --files0-from file. A trailing NUL is
// optional; an empty name is reported with its ordinal and skipped.
function files0_names(text: string): string[] {
  var out: string[] = [];
  var start: i32 = 0;
  var i: i32 = 0;
  while (i < text.len()) {
    if (text[i] as i32 == 0) {
      out = out.append(slice_unchecked(text, start, i) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  if (start < text.len()) {
    out = out.append(slice_unchecked(text, start, text.len()) + "");
  }
  return out;
}

// ---- option values ---------------------------------------------------------
// `--time=WORD`, which is argmatch over five words mapping to two
// stamps: a prefix of several names that all mean the same stamp is NOT
// ambiguous, which is why `--time=a` is atime.
function time_word(v: string): i32 {
  var names: string[] = ["atime", "access", "use", "ctime", "status"];
  var kinds: i32[] = [time_atime(), time_atime(), time_atime(), time_ctime(), time_ctime()];
  var found: i32 = 0 - 1;
  var ambiguous: boolean = false;
  var i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == v) {
      return kinds[i];
    }
    if (names[i].starts_with(v)) {
      if (found < 0) {
        found = i;
      } else if (kinds[i] != kinds[found]) {
        ambiguous = true;
      }
    }
    i = i + 1;
  }
  if (found >= 0 && !ambiguous) {
    return kinds[found];
  }
  var what: string = "invalid";
  if (ambiguous) {
    what = "ambiguous";
  }
  gnu.error(what + " argument " + gnu.quote(v) + " for " + gnu.quote("--time"));
  eprint("Valid arguments are:");
  eprint("  - 'atime', 'access', 'use'");
  eprint("  - 'ctime', 'status'");
  gnu.try_help(1);
  return time_mtime();
}

// The strftime format a --time-style names. `+FORMAT` is its own
// format; everything else is argmatch over the three ISO styles.
function style_format(v: string): string {
  if (v.len() > 0 && v[0] as i32 == 43) {
    return slice_unchecked(v, 1, v.len()) + "";
  }
  var names: string[] = ["full-iso", "long-iso", "iso"];
  var formats: string[] = ["%Y-%m-%d %H:%M:%S.%N %z", "%Y-%m-%d %H:%M", "%Y-%m-%d"];
  return formats[gnu.argmatch(v, names, "time style")];
}

// TIME_STYLE, which is not --time-style: the literal `locale` is
// accepted and renders as long-iso in the C locale, and anything else
// has a leading `posix-` stripped before it is matched — so an invalid
// value is reported under the STRIPPED spelling.
function env_style(v: string): string {
  if (v == "locale") {
    return "%Y-%m-%d %H:%M";
  }
  var s: string = v;
  if (s.starts_with("posix-")) {
    s = slice_unchecked(s, 6, s.len()) + "";
  }
  return style_format(s);
}

// The SIZE diagnostics quote differently from every other one here:
// gnulib's xstrtol_fatal wraps the argument in apostrophes and escapes
// NOTHING, so a tab is a tab and an apostrophe closes and reopens the
// quotes. `invalid maximum depth`, `extra operand` and the argmatch
// lists all use the C-escaping `quote` instead.
// `--max-depth=N`, base 0 with blanks and a sign tolerated in FRONT of
// the digits and nothing at all after them. A negative wraps, which is
// how `-d -1` comes out unlimited.
function parse_depth(spec: string): u64 {
  var i: i32 = 0;
  while (i < spec.len() && gnu.is_blank(spec[i] as i32)) {
    i = i + 1;
  }
  var neg: boolean = false;
  if (i < spec.len() && spec[i] as i32 == 43) {
    i = i + 1;
  } else if (i < spec.len() && spec[i] as i32 == 45) {
    neg = true;
    i = i + 1;
  }
  var n: (u64, i32, boolean) = blocks.scan_number(spec, i);
  if (n.1 == i || n.1 != spec.len() || n.2) {
    gnu.die_usage("invalid maximum depth " + gnu.quote(spec), 1);
  }
  if (neg) {
    return 0 as u64 - n.0;
  }
  return n.0;
}

// ---- main ------------------------------------------------------------------
function declare_options(): gnu.Opt[] {
  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("0", "null", opt_null()));
  opts = opts.append(gnu.flag("a", "all", opt_all()));
  opts = opts.append(gnu.flag("", "apparent-size", opt_apparent()));
  opts = opts.append(gnu.valued("B", "block-size", opt_block_size()));
  opts = opts.append(gnu.flag("b", "bytes", opt_bytes()));
  opts = opts.append(gnu.flag("c", "total", opt_total()));
  opts = opts.append(gnu.flag("L", "dereference", opt_dereference()));
  opts = opts.append(gnu.flag("D", "dereference-args", opt_dereference_args()));
  opts = opts.append(gnu.valued("d", "max-depth", opt_max_depth()));
  opts = opts.append(gnu.valued("", "files0-from", opt_files0()));
  opts = opts.append(gnu.flag("h", "human-readable", opt_human()));
  opts = opts.append(gnu.flag("", "inodes", opt_inodes()));
  opts = opts.append(gnu.flag("l", "count-links", opt_count_links()));
  opts = opts.append(gnu.flag("P", "no-dereference", opt_no_dereference()));
  opts = opts.append(gnu.flag("", "si", opt_si()));
  opts = opts.append(gnu.flag("S", "separate-dirs", opt_separate_dirs()));
  opts = opts.append(gnu.flag("s", "summarize", opt_summarize()));
  opts = opts.append(gnu.valued("t", "threshold", opt_threshold()));
  opts = opts.append(gnu.optional_long("", "time", opt_time()));
  opts = opts.append(gnu.valued("", "time-style", opt_time_style()));
  opts = opts.append(gnu.valued("", "exclude", opt_exclude()));
  opts = opts.append(gnu.valued("X", "exclude-from", opt_exclude_from()));
  opts = opts.append(gnu.flag("x", "one-file-system", opt_one_file_system()));
  opts = opts.append(gnu.flag("H", "", opt_deref_args_h()));
  opts = opts.append(gnu.flag("k", "", opt_kilo()));
  opts = opts.append(gnu.flag("m", "", opt_mega()));
  return opts;
}

function main(): i32 {
  var argv: string[] = args();
  var opts: gnu.Opt[] = declare_options();

  var c: Conf = Conf { all: false, apparent: false, block_size: 1024 as u64, suffix: "", human: 0 as u64, total: false, deref: deref_none(), max_depth: 0 as u64 - 1 as u64, inodes: false, count_links: false, separate_dirs: false, threshold: 0 as i64, has_threshold: false, time_kind: time_none(), time_format: "%Y-%m-%d %H:%M", zone: tz.utc_zone(), excludes: [], one_file_system: false, terminator: "\n" };
  var unit: blocks.Unit = blocks.default_unit();
  var summarize: boolean = false;
  var depth_text: string = "";
  var have_depth: boolean = false;
  var depth: u64 = 0 as u64;
  var files0: string = "";
  var have_files0: boolean = false;
  var style: string = "";
  var have_style: boolean = false;

  var g: gnu.Getopt = gnu.getopt_new(argv, opts, "du", help_text(), 1);
  while (true) {
    var r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    var done: boolean = false;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_null()) {
          c = Conf { ...c, terminator: string_from_bytes_unchecked([0 as u8]) };
        } else if (m.id == opt_all()) {
          c = Conf { ...c, all: true };
        } else if (m.id == opt_apparent()) {
          c = Conf { ...c, apparent: true };
        } else if (m.id == opt_block_size()) {
          var n: blocks.Num = blocks.parse_num(m.value, false, true, false);
          if (n.status != blocks.size_ok()) {
            blocks.die_size(n.status, blocks.option_name(m, "--block-size", "-B"), m.value);
          }
          unit = blocks.unit_from(n);
        } else if (m.id == opt_bytes()) {
          c = Conf { ...c, apparent: true };
          unit = blocks.plain_unit(1 as u64);
        } else if (m.id == opt_total()) {
          c = Conf { ...c, total: true };
        } else if (m.id == opt_dereference()) {
          c = Conf { ...c, deref: deref_all() };
        } else if (m.id == opt_dereference_args() || m.id == opt_deref_args_h()) {
          c = Conf { ...c, deref: deref_args() };
        } else if (m.id == opt_no_dereference()) {
          c = Conf { ...c, deref: deref_none() };
        } else if (m.id == opt_max_depth()) {
          depth = parse_depth(m.value);
          depth_text = m.value;
          have_depth = true;
        } else if (m.id == opt_files0()) {
          files0 = m.value;
          have_files0 = true;
        } else if (m.id == opt_human()) {
          unit = blocks.human_unit(1024 as u64);
        } else if (m.id == opt_si()) {
          unit = blocks.human_unit(1000 as u64);
        } else if (m.id == opt_kilo()) {
          unit = blocks.plain_unit(1024 as u64);
        } else if (m.id == opt_mega()) {
          unit = blocks.plain_unit(1048576 as u64);
        } else if (m.id == opt_inodes()) {
          c = Conf { ...c, inodes: true };
        } else if (m.id == opt_count_links()) {
          c = Conf { ...c, count_links: true };
        } else if (m.id == opt_separate_dirs()) {
          c = Conf { ...c, separate_dirs: true };
        } else if (m.id == opt_summarize()) {
          summarize = true;
        } else if (m.id == opt_threshold()) {
          var t: blocks.Num = blocks.parse_num(m.value, true, false, true);
          if (t.status == blocks.size_ok() && t.neg && t.value == 0 as u64) {
            gnu.error("invalid --threshold argument '-0'");
            exit(1);
          }
          if (t.status != blocks.size_ok()) {
            blocks.die_size(t.status, blocks.option_name(m, "--threshold", "-t"), m.value);
          }
          var v: i64 = t.value as i64;
          if (t.neg) {
            v = 0 as i64 - v;
          }
          c = Conf { ...c, threshold: v, has_threshold: true };
        } else if (m.id == opt_time()) {
          var kind: i32 = time_mtime();
          if (m.has_value) {
            kind = time_word(m.value);
          }
          c = Conf { ...c, time_kind: kind };
        } else if (m.id == opt_time_style()) {
          style = m.value;
          have_style = true;
        } else if (m.id == opt_exclude()) {
          c = Conf { ...c, excludes: c.excludes.append(m.value) };
        } else if (m.id == opt_exclude_from()) {
          c = Conf { ...c, excludes: read_exclude_file(c.excludes, m.value) };
        } else if (m.id == opt_one_file_system()) {
          c = Conf { ...c, one_file_system: true };
        }
      },
      None => {
        done = true;
      }
    }
    if (done) {
      break;
    }
  }

  if (summarize && c.all) {
    gnu.die_usage("cannot both summarize and show all entries", 1);
  }
  if (summarize && have_depth) {
    if (depth == 0 as u64) {
      gnu.error("warning: summarizing is the same as using --max-depth=0");
    } else {
      gnu.die_usage("warning: summarizing conflicts with --max-depth=" + depth_text, 1);
    }
  }
  if (summarize) {
    depth = 0 as u64;
    have_depth = true;
  }
  if (have_depth) {
    c = Conf { ...c, max_depth: depth };
  }
  if (c.inodes && c.apparent) {
    gnu.error("warning: options --apparent-size and -b are ineffective with --inodes");
  }
  if (c.time_kind != time_none()) {
    // The zone is resolved only when a timestamp will be printed: tzset(3)
    // reads the environment and then a TZif file, and a du that prints no
    // time should not pay for either.
    c = Conf { ...c, zone: tz.local_zone() };
    if (have_style) {
      c = Conf { ...c, time_format: style_format(style) };
    } else {
      match (env("TIME_STYLE")) {
        Some(v) => {
          c = Conf { ...c, time_format: env_style(v) };
        },
        None => {}
      }
    }
  }

  if (!unit.chosen) {
    unit = blocks.env_unit(["DU_BLOCK_SIZE", "BLOCK_SIZE", "BLOCKSIZE"]);
  }
  if (c.inodes) {
    unit = blocks.Unit { ...unit, block_size: 1 as u64 };
  }
  var suffix: string = "";
  if (unit.show_suffix) {
    suffix = blocks.unit_text(unit.block_size, unit.base, unit.with_b);
  }
  c = Conf { ...c, block_size: unit.block_size, human: unit.human, suffix: suffix };

  var operands: string[] = g.operands();
  var names: string[] = operands;
  var from_stdin: boolean = false;
  var list_name: string = "";
  if (have_files0) {
    if (operands.len() > 0) {
      gnu.error("extra operand " + gnu.quote(operands[0]) + "\nfile operands cannot be combined with --files0-from");
      gnu.try_help(1);
    }
    list_name = files0;
    from_stdin = files0 == "-";
    names = read_name_list(files0);
  } else if (operands.len() == 0) {
    names = [".".to_string()];
  }

  return walk(c, names, have_files0, list_name, from_stdin);
}

// -X is read where it stands in the scan, not afterwards, which is what
// lets `du -X - --files0-from=-` take the whole of stdin for the
// patterns and leave the name list empty.
function read_exclude_file(have: string[], path: string): string[] {
  var r: Slurp = slurp(path);
  if (!r.ok) {
    gnu.die_usage(gnu.quotef(path) + ": " + slurp_error(r), 1);
  }
  var pats: string[] = exclude_patterns(r.text);
  var out: string[] = have;
  var i: i32 = 0;
  while (i < pats.len()) {
    out = out.append(pats[i]);
    i = i + 1;
  }
  return out;
}

function slurp_error(r: Slurp): string {
  match (r.err) {
    Some(e) => {
      return gnu.io_error_text(e);
    },
    None => {}
  }
  return "";
}

function read_name_list(path: string): string[] {
  var r: Slurp = slurp(path);
  if (!r.ok) {
    if (r.at_open) {
      gnu.error("cannot open " + gnu.quotea(path) + " for reading: " + slurp_error(r));
    } else {
      gnu.error(gnu.quotef(path) + ": read error: " + slurp_error(r));
    }
    exit(1);
  }
  return files0_names(r.text);
}
