// od.fern — GNU-compatible `od`.
//
//   od [OPTION]... [FILE]...
//   od [-abcdfilosx]... [FILE] [[+]OFFSET[.][b]]
//   od --traditional [OPTION]... [FILE] [[+]OFFSET[.][b] [+][LABEL][.][b]]
//
// The concatenated FILEs as octal bytes by default, or in whatever the
// `-t` specifications ask for, one block of `-w` bytes per line, with the
// offset of each block in front of it and a run of identical blocks
// folded to a single `*`.
//
// Four things decide the bytes and are not guessable from the synopsis:
//
//   - **The specs line up with each other, not with themselves.** Each
//     spec's block occupies `(field_width + 1) * fields` columns, the
//     widest wins, and every narrower spec has the difference spread
//     across ITS fields — so `-t x1c` prints hexadecimal in four columns
//     rather than three, because `c` needs four. The share a field gets
//     is what is left divided by the fields still to come, which is what
//     makes the distribution even.
//   - **A float prints as the SHORTEST decimal that reads back as the
//     same value**, which is gnulib's ftoastr rather than a fixed
//     precision: `%.*g` from LDBL_DIG (or from 1 when the value is
//     subnormal) upwards until strtold agrees. That is why a
//     denormalised float prints `1e-45` and not `1.4012985e-45`.
//   - **The traditional offset operand is only read when no MODERN
//     option was given** (-A -j -N -S -t -v -w), unless `--traditional`
//     asks for it: `od f 4` dumps from byte 4, `od -t x1 f 4` reports
//     that there is no file named `4`.
//   - **A block is folded only when it is FULL and equal to the one
//     before it**, so the `*` never stands for the last, short block, and
//     the offset line that ends the dump is the total length whether or
//     not anything was folded.
//
// The floating-point formats come from `lib/ld.fern`, which carries the
// target's `float`, `double` and `long double` rather than the host's.
import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/ld";

// ---- options ---------------------------------------------------------------
// Ids in GNU's DECLARATION order, which the ambiguity list prints in:
// `--s` names '--skip-bytes' before '--strings'.
function opt_skip(): i32 {
  return 1;
}

function opt_radix(): i32 {
  return 2;
}

function opt_read(): i32 {
  return 3;
}

function opt_format(): i32 {
  return 4;
}

function opt_dups(): i32 {
  return 5;
}

function opt_strings(): i32 {
  return 6;
}

function opt_traditional(): i32 {
  return 7;
}

function opt_width(): i32 {
  return 8;
}

function opt_endian(): i32 {
  return 9;
}

// The traditional format letters, and the hidden aliases GNU still
// carries for the same shapes. Each gets an id of its own — its byte
// plus this base — because the letter cannot be recovered from argv: a
// `d` inside `-Ad` is another option's value, not a format.
function trad_base(): i32 {
  return 1000;
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "  or:  " + gnu.prog() + " [-abcdfilosx]... [FILE] [[+]OFFSET[.][b]]\n";
  out = out + "  or:  " + gnu.prog() + " --traditional [OPTION]... [FILE] [[+]OFFSET[.][b] [+][LABEL][.][b]]\n";
  out = out + "\n";
  out = out + "Dump the concatenated FILEs, octal bytes by default, one block per line\n";
  out = out + "with the offset of the block in front of it.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -A, --address-radix=RADIX   offset radix: one of [doxn] for decimal,\n";
  out = out + "                                octal, hexadecimal or none\n";
  out = out + "      --endian={big|little}   read each unit in that byte order\n";
  out = out + "  -j, --skip-bytes=BYTES      skip BYTES of input first\n";
  out = out + "  -N, --read-bytes=BYTES      dump at most BYTES of input\n";
  out = out + "  -S BYTES, --strings[=BYTES]  dump only NUL-terminated runs of at least\n";
  out = out + "                                BYTES (3) printable characters\n";
  out = out + "  -t, --format=TYPE           dump in TYPE, once per TYPE given\n";
  out = out + "  -v, --output-duplicates     write every block, never '*'\n";
  out = out + "  -w[BYTES], --width[=BYTES]  BYTES per line (32 when BYTES is omitted)\n";
  out = out + "      --traditional           read the offset and label operands above\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "The traditional format letters accumulate:\n";
  out = out + "  -a   -t a,  named character, high bit ignored\n";
  out = out + "  -b   -t o1, octal bytes\n";
  out = out + "  -c   -t c,  printable character or backslash escape\n";
  out = out + "  -d   -t u2, unsigned decimal 2-byte units\n";
  out = out + "  -f   -t fF, floats\n";
  out = out + "  -i   -t dI, decimal ints\n";
  out = out + "  -l   -t dL, decimal longs\n";
  out = out + "  -o   -t o2, octal 2-byte units\n";
  out = out + "  -s   -t d2, decimal 2-byte units\n";
  out = out + "  -x   -t x2, hexadecimal 2-byte units\n";
  out = out + "\n";
  out = out + "A TYPE is one or more of:\n";
  out = out + "  a          named character, high bit ignored\n";
  out = out + "  c          printable character or backslash escape\n";
  out = out + "  d[SIZE]    signed decimal, SIZE bytes per integer\n";
  out = out + "  f[SIZE]    floating point, SIZE bytes per float\n";
  out = out + "  o[SIZE]    octal, SIZE bytes per integer\n";
  out = out + "  u[SIZE]    unsigned decimal, SIZE bytes per integer\n";
  out = out + "  x[SIZE]    hexadecimal, SIZE bytes per integer\n";
  out = out + "\n";
  out = out + "SIZE is a number; for d, o, u and x it may also be C, S, I or L for the\n";
  out = out + "sizes of char, short, int and long, and for f it may be F, D or L for\n";
  out = out + "float, double and long double. A z suffix adds the printable characters\n";
  out = out + "of each line at its end.\n";
  out = out + "\n";
  out = out + "BYTES is hex with a 0x prefix, and takes a multiplier suffix:\n";
  out = out + "b 512, KB 1000, K 1024, MB 1000*1000, M 1024*1024, and so on for\n";
  out = out + "G, T, P, E, Z, Y, R, Q. Binary prefixes work too: KiB=K, MiB=M.\n";
  return out;
}

// ---- field widths ----------------------------------------------------------
//
// The digits an N-byte unit needs in each base. These are the counts GNU
// tabulates; every one of them is `ceil(N * 8 * log(2) / log(base))`,
// with the signed decimal one carrying its sign.
function oct_digits(n: i32): i32 {
  return (n * 8 + 2) / 3;
}

function hex_digits(n: i32): i32 {
  return n * 2;
}

function bit_digits(bits: i32): i32 {
  return bits * 30103 / 100000 + 1;
}

function unsigned_dec_digits(n: i32): i32 {
  return bit_digits(n * 8);
}

// The sign costs a column only when the negative range is not already
// shorter than the unsigned one, which for eight bytes it is.
function signed_dec_digits(n: i32): i32 {
  var neg: i32 = bit_digits(n * 8 - 1) + 1;
  var pos: i32 = unsigned_dec_digits(n);
  if (neg > pos) {
    return neg;
  }
  return pos;
}

// The columns a float of `f`'s format needs: a sign, a leading digit, a
// point, the digits past the first that a round trip can require, `e`, an
// exponent sign, and the exponent's own digits.
function float_digits(f: ld.Format): i32 {
  return 5 + prec_bound(f) - 1 + exp_digits(f);
}

// C's FLOAT_PREC_BOUND: the most significant digits `%g` can be asked
// for before a round trip is guaranteed — one past ceil(mant log10 2).
function prec_bound(f: ld.Format): i32 {
  return (f.mant * 30103 + 99999) / 100000 + 1;
}

function exp_digits(f: ld.Format): i32 {
  var e: i32 = f.emax * 30103 / 100000;
  var d: i32 = 1;
  while (e >= 10) {
    e = e / 10;
    d = d + 1;
  }
  return d;
}

// ---- specifications --------------------------------------------------------
function k_named(): i32 {
  return 0;
}

function k_char(): i32 {
  return 1;
}

function k_signed(): i32 {
  return 2;
}

function k_octal(): i32 {
  return 3;
}

function k_unsigned(): i32 {
  return 4;
}

function k_hex(): i32 {
  return 5;
}

function k_float(): i32 {
  return 6;
}

// `fB` — bfloat16. It is two bytes like `fH`, and only the kind tells
// them apart: same width, same decimal, a different encoding.
function k_bfloat(): i32 {
  return 7;
}

// `Spec` — one output format: its kind, the bytes per unit, the columns
// one unit occupies before the block padding is spread over it, whether
// the `z` suffix asked for the printable-character trailer, and the pad
// this spec's block gets so every spec's block ends in the same column.
struct Spec { kind: i32, size: i32, fw: i32, z: boolean, pad: i32 }

function spec_width(kind: i32, size: i32): i32 {
  if (kind == k_named() || kind == k_char()) {
    return 3;
  }
  if (kind == k_octal()) {
    return oct_digits(size);
  }
  if (kind == k_hex()) {
    return hex_digits(size);
  }
  if (kind == k_unsigned()) {
    return unsigned_dec_digits(size);
  }
  if (kind == k_signed()) {
    return signed_dec_digits(size);
  }
  return float_digits(print_format(size));
}

// The format a float of `size` bytes has on the target: `lib/ld.fern`
// carries the target's, not the host's.
function float_format(size: i32): ld.Format {
  if (size == 4) {
    return ld.binary32();
  }
  if (size == 8) {
    return ld.binary64();
  }
  return ld.format();
}

// The format the unit's BYTES are in. The two-byte types are the only
// place this differs from the one the value is printed in.
function decode_format(kind: i32, size: i32): ld.Format {
  if (kind == k_bfloat()) {
    return ld.bfloat16();
  }
  if (size == 2) {
    return ld.binary16();
  }
  return float_format(size);
}

// The format the printed decimal has to read back as. GNU widens both
// two-byte types to `float` before calling ftoastr, so what a half
// prints is the shortest text that identifies the float it widened to —
// and its column is a float's column, not a narrower one.
function print_format(size: i32): ld.Format {
  if (size == 2) {
    return ld.binary32();
  }
  return float_format(size);
}

// The bytes `long double` occupies on the target. x87 is ten bytes of
// value in sixteen of storage; the IEEE formats are their own width.
function long_double_size(): i32 {
  var f: ld.Format = ld.format();
  if (f.mant == 53) {
    return 8;
  }
  return 16;
}

function new_spec(kind: i32, size: i32, z: boolean): Spec {
  return Spec { kind: kind, size: size, fw: spec_width(kind, size), z: z, pad: 0 };
}

// ---- the type string -------------------------------------------------------
//
// One `-t` argument holds one or more specifications end to end, so
// `-t x1c` is two of them. Each is a letter, an optional size, and an
// optional `z`.
function type_error_size(arg: string, size: i32, floating: boolean): void {
  var what: string = "integral";
  if (floating) {
    what = "floating point";
  }
  gnu.error("invalid type string " + gnu.quote(arg) + ";\nthis system doesn't provide a " + size.to_string() + "-byte " + what + " type");
  exit(1);
}

// A size too large to parse has no width to name, so GNU reports it
// without the suffix type_error_size carries. Its cutoff is i32 overflow.
function type_error(arg: string): void {
  gnu.error("invalid type string " + gnu.quote(arg));
  exit(1);
}

// The size letters `d`, `o`, `u` and `x` accept, which are C's integer
// widths, and the ones `f` accepts, which are its floating widths.
function int_size_letter(c: i32): i32 {
  if (c == 67) {
    return 1;
  }
  if (c == 83) {
    return 2;
  }
  if (c == 73) {
    return 4;
  }
  if (c == 76) {
    return 8;
  }
  return 0;
}

// `f`'s size letters. `H` and `B` are 9.5's two-byte pair — IEEE
// binary16 and bfloat16 — and they are the only ones that also decide
// the kind, which `parse_type` reads back from the letter.
function float_size_letter(c: i32): i32 {
  if (c == 66 || c == 72) {
    return 2;
  }
  if (c == 70) {
    return 4;
  }
  if (c == 68) {
    return 8;
  }
  if (c == 76) {
    return long_double_size();
  }
  return 0;
}

function valid_int_size(n: i32): boolean {
  return n == 1 || n == 2 || n == 4 || n == 8;
}

function valid_float_size(n: i32): boolean {
  return n == 2 || n == 4 || n == 8 || n == long_double_size();
}

// `parse_type(arg, specs)` — every specification in one `-t` argument,
// appended to `specs`.
function parse_type(arg: string, specs: Spec[]): Spec[] {
  var out: Spec[] = specs;
  var i: i32 = 0;
  while (i < arg.len()) {
    var c: i32 = arg[i] as i32;
    i = i + 1;
    var kind: i32 = 0 - 1;
    var floating: boolean = false;
    if (c == 97) {
      kind = k_named();
    } else if (c == 99) {
      kind = k_char();
    } else if (c == 100) {
      kind = k_signed();
    } else if (c == 111) {
      kind = k_octal();
    } else if (c == 117) {
      kind = k_unsigned();
    } else if (c == 120) {
      kind = k_hex();
    } else if (c == 102) {
      kind = k_float();
      floating = true;
    } else {
      invalid_type_char(c, arg);
    }
    var size: i32 = 4;
    if (floating) {
      size = 8;
    }
    if (kind == k_named() || kind == k_char()) {
      size = 1;
    } else if (i < arg.len() && gnu.is_digit(arg[i] as i32)) {
      var n: i64 = 0 as i64;
      var too_big: boolean = false;
      while (i < arg.len() && gnu.is_digit(arg[i] as i32)) {
        if (!too_big) {
          n = n * (10 as i64) + (arg[i] as i32 - 48) as i64;
          if (n > 2147483647 as i64) {
            too_big = true;
          }
        }
        i = i + 1;
      }
      if (too_big) {
        type_error(arg);
      }
      size = n as i32;
      if (floating) {
        if (!valid_float_size(size)) {
          type_error_size(arg, size, true);
        }
      } else if (!valid_int_size(size)) {
        type_error_size(arg, size, false);
      }
    } else if (i < arg.len()) {
      var letter: i32 = 0;
      if (floating) {
        letter = float_size_letter(arg[i] as i32);
      } else {
        letter = int_size_letter(arg[i] as i32);
      }
      if (letter > 0) {
        size = letter;
        if (arg[i] as i32 == 66) {
          kind = k_bfloat();
        }
        i = i + 1;
      }
    }
    var z: boolean = false;
    if (i < arg.len() && arg[i] as i32 == 122) {
      z = true;
      i = i + 1;
    }
    out = out.append(new_spec(kind, size, z));
  }
  return out;
}

// A size digit or letter that is neither is a character fault, and the
// non-printable ones are named in octal — `a1` and `c1` reach this too,
// because those two carry no size at all.
function invalid_type_char(c: i32, arg: string): void {
  gnu.error("invalid character '" + byte_str(c) + "' in type string " + gnu.quote(arg));
  exit(1);
}

function byte_str(c: i32): string {
  var b: u8[] = [];
  b = b.append(c as u8);
  return string_from_bytes_unchecked(b);
}

// ---- counts ----------------------------------------------------------------
//
// `-j`, `-N`, `-S` and `-w` take gnulib's byte counts, with a `0x`
// prefix for hexadecimal and the usual multiplier suffixes. The two
// faults are worded differently: nothing that could be a number at all
// is `invalid`, digits followed by a suffix that is not one is
// `invalid suffix in`.
function count_arg(value: string, opt: string): u64 {
  var body: string = value;
  var mul: u64 = 1 as u64;
  if (body.starts_with("0x") || body.starts_with("0X")) {
    var h: (u64, boolean, i32) = parse_hex(body);
    if (!h.1) {
      gnu.error("invalid " + opt + " argument " + gnu.quote(value));
      exit(1);
    }
    if (h.2 < body.len()) {
      var s: (u64, boolean) = suffix_multiplier(slice_unchecked(body, h.2, body.len()) + "");
      if (!s.1) {
        gnu.error("invalid suffix in " + opt + " argument " + gnu.quote(value));
        exit(1);
      }
      mul = s.0;
    }
    return checked_scale(h.0, mul, value, opt);
  }
  var r: (u64, i32) = gnu.parse_units(body);
  if (r.1 == 0) {
    return r.0;
  }
  if (r.1 == 1) {
    gnu.error("invalid " + opt + " argument " + gnu.quote(value));
    exit(1);
  }
  if (r.1 == 4) {
    gnu.error("invalid suffix in " + opt + " argument " + gnu.quote(value));
    exit(1);
  }
  gnu.error(opt + " argument " + gnu.quote(value) + " too large");
  exit(1);
  return 0 as u64;
}

function checked_scale(v: u64, mul: u64, value: string, opt: string): u64 {
  match (v.checked_mul(mul)) {
    Some(m) => {
      return m;
    },
    None => {
      gnu.error(opt + " argument " + gnu.quote(value) + " too large");
      exit(1);
    }
  }
  return 0 as u64;
}

// The hexadecimal body of a `0x` count, and where its digits end.
function parse_hex(s: string): (u64, boolean, i32) {
  var i: i32 = 2;
  var v: u64 = 0 as u64;
  var any: boolean = false;
  while (i < s.len()) {
    var d: i32 = hex_value(s[i] as i32);
    if (d < 0) {
      break;
    }
    match (v.checked_mul(16 as u64)) {
      Some(m) => {
        v = m + d as u64;
      },
      None => {
        return (0 as u64, false, i);
      }
    }
    any = true;
    i = i + 1;
  }
  return (v, any, i);
}

function hex_value(c: i32): i32 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return 0 - 1;
}

// gnulib's multiplier suffixes, for the `0x` path that parses its own
// digits.
function suffix_multiplier(s: string): (u64, boolean) {
  var r: (u64, i32) = gnu.parse_units("1" + s);
  if (r.1 != 0) {
    return (0 as u64, false);
  }
  return (r.0, true);
}

// ---- the address -----------------------------------------------------------
function radix_none(): i32 {
  return 0;
}

function address_width(base: i32): i32 {
  if (base == 16) {
    return 6;
  }
  if (base == radix_none()) {
    return 0;
  }
  return 7;
}

// `push_address(h, t, s, off)` — the whole leading text of a line: the
// address, and the pseudo-address in parentheses after it when a LABEL
// operand asked for one. `-A n` prints no address, but a label still
// prints — in octal, which is the radix GNU restores for exactly that
// case.
function push_address(h: usize, t: Tables, s: Settings, off: u64): void {
  if (s.base != radix_none()) {
    push_num(h, t, false, off, s.base, address_width(s.base), 0);
  }
  if (!s.labelled) {
    return;
  }
  if (s.base == radix_none()) {
    buf_push_byte(h, 40);
    push_num(h, t, false, off, 8, address_width(8), 0);
    buf_push_byte(h, 41);
    return;
  }
  buf_push(h, " (");
  push_num(h, t, false, off - s.skip + s.label, s.base, address_width(s.base), 0);
  buf_push_byte(h, 41);
}

// ---- one unit --------------------------------------------------------------
//
// The bytes of one unit as an unsigned integer, in the byte order the
// input is being read in.
function unit_value(block: string, at: i32, size: i32, big: boolean): u64 {
  var v: u64 = 0 as u64;
  if (big) {
    var i: i32 = 0;
    while (i < size) {
      v = (v << 8 as u64) + (block[at + i] as i32) as u64;
      i = i + 1;
    }
    return v;
  }
  var j: i32 = size - 1;
  while (j >= 0) {
    v = (v << 8 as u64) + (block[at + j] as i32) as u64;
    j = j - 1;
  }
  return v;
}

// The same, sign-extended from `size` bytes.
function signed_value(v: u64, size: i32): i64 {
  if (size >= 8) {
    return v as i64;
  }
  var bits: i32 = size * 8;
  var sign: u64 = 1 as u64 << (bits - 1) as u64;
  if ((v & sign) != 0 as u64) {
    return v as i64 - (1 as i64 << bits as i64);
  }
  return v as i64;
}

function is_printable(c: i32): boolean {
  return c >= 32 && c < 127;
}

// ---- floating point --------------------------------------------------------
//
// The unit's bytes as the exact value the format holds.
function decode_float(block: string, at: i32, kind: i32, size: i32, big: boolean): ld.LD {
  var f: ld.Format = decode_format(kind, size);
  var lo: u64 = 0 as u64;
  var hi: u64 = 0 as u64;
  if (size <= 8) {
    lo = unit_value(block, at, size, big);
  } else if (big) {
    hi = unit_value(block, at, 8, true);
    lo = unit_value(block, at + 8, 8, true);
  } else {
    lo = unit_value(block, at, 8, false);
    hi = unit_value(block, at + 8, 8, false);
  }
  if (f.explicit_bit) {
    return decode_x87(f, lo, hi);
  }
  return decode_ieee(f, lo, hi, size);
}

// An IEEE interchange format: a sign, a biased exponent, and a
// significand whose leading bit is implied for a normal value.
function decode_ieee(f: ld.Format, lo: u64, hi: u64, size: i32): ld.LD {
  var frac_bits: i32 = f.mant - 1;
  var mlo: u64 = lo;
  var mhi: u64 = 0 as u64;
  if (frac_bits < 64) {
    mlo = lo & (1 as u64 << frac_bits as u64) - 1 as u64;
  } else if (frac_bits > 64) {
    mhi = hi & (1 as u64 << (frac_bits - 64) as u64) - 1 as u64;
  }
  var shifted: u64 = 0 as u64;
  if (frac_bits >= 64) {
    shifted = hi >> (frac_bits - 64) as u64;
  } else {
    shifted = lo >> frac_bits as u64;
  }
  var exp_bits: i32 = size * 8 - f.mant;
  var exp: i32 = (shifted & (1 as u64 << exp_bits as u64) - 1 as u64) as i32;
  var neg: boolean = (shifted >> exp_bits as u64 & 1 as u64) != 0 as u64;
  var max_exp: i32 = (1 << exp_bits) - 1;
  if (exp == max_exp) {
    if (mhi == 0 as u64 && mlo == 0 as u64) {
      return ld.inf(neg);
    }
    return ld.nan(neg);
  }
  if (exp == 0) {
    return ld.LD { neg: neg, kind: 0, hi: mhi, lo: mlo, e: f.min_exp() };
  }
  // The implied leading one goes in above the fraction.
  if (frac_bits < 64) {
    mlo = mlo | 1 as u64 << frac_bits as u64;
  } else {
    mhi = mhi | 1 as u64 << (frac_bits - 64) as u64;
  }
  return ld.LD { neg: neg, kind: 0, hi: mhi, lo: mlo, e: exp - f.emax - frac_bits };
}

// x87's 80-bit extended: the integer bit is STORED, so the significand
// is the whole low word and a normal value differs from a subnormal only
// in its exponent field.
function decode_x87(f: ld.Format, lo: u64, hi: u64): ld.LD {
  var neg: boolean = (hi >> 15 as u64 & 1 as u64) != 0 as u64;
  var exp: i32 = (hi & 32767 as u64) as i32;
  var integer_bit: boolean = lo >> 63 as u64 != 0 as u64;
  if (exp == 32767) {
    if (!integer_bit) {
      return ld.nan(neg);
    }
    if ((lo & 9223372036854775807 as u64) == 0 as u64) {
      return ld.inf(neg);
    }
    return ld.nan(neg);
  }
  // An UNNORMAL — a stored integer bit of 0 under a non-zero exponent —
  // is not a value x87 produces, and the FPU answers a load of one with
  // an invalid operation. So does GNU, which prints `nan` for it; a
  // pseudo-denormal (the bit set under a zero exponent) is a plain
  // denormal and needs no case of its own, the exponent being the same.
  if (exp != 0 && !integer_bit) {
    return ld.nan(neg);
  }
  if (exp == 0) {
    // glibc reads a zero exponent as a subnormal, which means it takes
    // the 63-bit FRACTION and normalises that: the stored integer bit
    // does not contribute, and an encoding whose only set bit is that
    // one has nothing to normalise and keeps the value it had.
    var frac: u64 = lo & 9223372036854775807 as u64;
    if (frac != 0 as u64) {
      return ld.LD { neg: neg, kind: 0, hi: 0 as u64, lo: frac, e: f.min_exp() };
    }
    return ld.LD { neg: neg, kind: 0, hi: 0 as u64, lo: lo, e: f.min_exp() };
  }
  return ld.LD { neg: neg, kind: 0, hi: 0 as u64, lo: lo, e: exp - f.emax - (f.mant - 1) };
}

// `ftoa(f, v)` — gnulib's ftoastr: `%.*g` at rising precision until the
// text reads back as the same value, so the printed decimal is the
// shortest one that identifies this float. A subnormal starts at one
// digit, because that is where a round trip can already succeed.
function ftoa(f: ld.Format, v: ld.LD): string {
  if (v.is_nan()) {
    if (v.neg) {
      return "-nan";
    }
    return "nan";
  }
  if (v.is_inf()) {
    if (v.neg) {
      return "-inf";
    }
    return "inf";
  }
  var sign: string = "";
  if (v.neg) {
    sign = "-";
  }
  var d: ld.Dec = v.dec();
  var prec: i32 = f.dig();
  if (f.is_subnormal(v)) {
    prec = 1;
  }
  var bound: i32 = prec_bound(f);
  var s: string = "";
  while (prec <= bound) {
    s = sign + ld.general(d, prec as i64, false, false, 0 as i64).text();
    if (f.strtold(s).v.eq(v)) {
      return s;
    }
    prec = prec + 1;
  }
  return s;
}

// ---- one field -------------------------------------------------------------
//
// A field goes straight into stdout's builder as ranges of a few tables
// built once. Every entry carries a blank in front of its digits, so the
// single space that usually separates fields is part of the first push:
// `-t x1` is one push per byte, the default `-t o2` two per unit, `-c` and
// `-a` one per byte. No field costs an allocation or a byte-at-a-time
// append; a dump of 62 MiB writes sixty-two million of them.
//
//   hex     256 entries of " xx"   — one per byte of the value
//   oct     512 entries of " ooo"  — one per nine bits
//   dec     100 entries of "dd"    — one per hundred
//   chars   256 entries of "   c"  — what -t c prints, right-aligned in 4
//   names   256 entries of " nul"  — what -t a prints, right-aligned in 4
struct Tables { hex: string, oct: string, dec: string, blanks: string, chars: string, names: string }

function blank_run(): i32 {
  return 64;
}

function tables_new(): Tables {
  var hex: u8[] = __alloc_u8(768);
  var i: i32 = 0;
  while (i < 256) {
    hex = hex.with(i * 3, 32 as u8);
    hex = hex.with(i * 3 + 1, digit_byte(i >> 4));
    hex = hex.with(i * 3 + 2, digit_byte(i & 15));
    i = i + 1;
  }
  var oct: u8[] = __alloc_u8(2048);
  i = 0;
  while (i < 512) {
    oct = oct.with(i * 4, 32 as u8);
    oct = oct.with(i * 4 + 1, (48 + (i >> 6)) as u8);
    oct = oct.with(i * 4 + 2, (48 + (i >> 3 & 7)) as u8);
    oct = oct.with(i * 4 + 3, (48 + (i & 7)) as u8);
    i = i + 1;
  }
  var dec: u8[] = __alloc_u8(200);
  i = 0;
  while (i < 100) {
    dec = dec.with(i * 2, (48 + i / 10) as u8);
    dec = dec.with(i * 2 + 1, (48 + i % 10) as u8);
    i = i + 1;
  }
  var chars: u8[] = __alloc_u8(1024);
  var names: u8[] = __alloc_u8(1024);
  i = 0;
  while (i < 256) {
    chars = right_aligned(chars, i * 4, char_text(i));
    names = right_aligned(names, i * 4, char_name(i));
    i = i + 1;
  }
  return Tables { hex: string_from_bytes_unchecked(hex), oct: string_from_bytes_unchecked(oct), dec: string_from_bytes_unchecked(dec), blanks: " ".repeat(blank_run()), chars: string_from_bytes_unchecked(chars), names: string_from_bytes_unchecked(names) };
}

// `text` in the four bytes of `table` at `at`, right-aligned in blanks.
function right_aligned(own table: u8[], at: i32, text: string): u8[] {
  var k: i32 = 0;
  while (k < 4 - text.len()) {
    table = table.with(at + k, 32 as u8);
    k = k + 1;
  }
  var j: i32 = 0;
  while (j < text.len()) {
    table = table.with(at + k + j, text[j]);
    j = j + 1;
  }
  return table;
}

function digit_byte(d: i32): u8 {
  if (d < 10) {
    return (48 + d) as u8;
  }
  return (87 + d) as u8;
}

// `-t c`: the seven named C escapes and NUL keep their backslash, a
// printable byte is itself, and anything else is three octal digits with
// NO backslash — which is GNU's rendering, not C's.
function char_text(c: i32): string {
  if (c == 0) {
    return "\\0";
  }
  if (c == 7) {
    return "\\a";
  }
  if (c == 8) {
    return "\\b";
  }
  if (c == 9) {
    return "\\t";
  }
  if (c == 10) {
    return "\\n";
  }
  if (c == 11) {
    return "\\v";
  }
  if (c == 12) {
    return "\\f";
  }
  if (c == 13) {
    return "\\r";
  }
  if (is_printable(c)) {
    return byte_str(c);
  }
  var d: u8[] = [];
  d = d.append((48 + (c >> 6)) as u8);
  d = d.append((48 + (c >> 3 & 7)) as u8);
  d = d.append((48 + (c & 7)) as u8);
  return string_from_bytes_unchecked(d);
}

// `-t a`: ASCII's own names for the first thirty-three codes and `del`,
// with the high bit dropped before the lookup, so 0xff is `del`.
function char_name(c: i32): string {
  var b: i32 = c % 128;
  if (b == 127) {
    return "del";
  }
  if (b > 32) {
    return byte_str(b);
  }
  var names: string[] = ["nul", "soh", "stx", "etx", "eot", "enq", "ack", "bel", "bs", "ht", "nl", "vt", "ff", "cr", "so", "si", "dle", "dc1", "dc2", "dc3", "dc4", "nak", "syn", "etb", "can", "em", "sub", "esc", "fs", "gs", "rs", "us", "sp"];
  return names[b];
}

function push_blanks(h: usize, t: Tables, n: i32): void {
  var k: i32 = n;
  while (k > blank_run()) {
    buf_push_range(h, t.blanks, 0, blank_run());
    k = k - blank_run();
  }
  if (k > 0) {
    buf_push_range(h, t.blanks, 0, k);
  }
}

// `push_num(h, t, neg, v, base, least, width)` — the magnitude `v` with
// its sign, zero-padded to at least `least` digits and right-aligned in
// `width` columns.
function push_num(h: usize, t: Tables, neg: boolean, v: u64, base: i32, least: i32, width: i32): void {
  if (base == 16) {
    push_hex(h, t, v, least, width);
  } else if (base == 8) {
    push_oct(h, t, v, least, width);
  } else {
    push_dec(h, t, neg, v, least, width);
  }
}

// The last of the blanks goes with the first pair when the number starts
// with a whole pair, which is every number but an address of an odd
// number of digits.
function push_hex(h: usize, t: Tables, v: u64, least: i32, width: i32): void {
  var digits: i32 = least;
  if (least < 16 && v >> (least * 4) as u64 != 0 as u64) {
    digits = hex_count(v);
  }
  var blanks: i32 = width - digits;
  var lead: i32 = 0;
  if (digits % 2 == 1) {
    push_blanks(h, t, blanks);
    var d: i32 = (v >> ((digits - 1) * 4) as u64 & 15 as u64) as i32;
    buf_push_range(h, t.hex, d * 3 + 2, d * 3 + 3);
    digits = digits - 1;
  } else if (blanks > 0) {
    push_blanks(h, t, blanks - 1);
    lead = 1;
  }
  var shift: i32 = (digits - 2) * 4;
  while (shift >= 0) {
    var b: i32 = (v >> shift as u64 & 255 as u64) as i32;
    buf_push_range(h, t.hex, b * 3 + 1 - lead, b * 3 + 3);
    lead = 0;
    shift = shift - 8;
  }
}

function hex_count(v: u64): i32 {
  var count: i32 = 1;
  var rest: u64 = v >> 4 as u64;
  while (rest != 0 as u64) {
    count = count + 1;
    rest = rest >> 4 as u64;
  }
  return count;
}

// Octal digits are three bits, so the top group of a number is one or
// two digits and the rest come three at a time. A field's digit count is
// the width its unit can need, which is where the zero padding comes
// from; only an address is counted.
function push_oct(h: usize, t: Tables, v: u64, least: i32, width: i32): void {
  var digits: i32 = least;
  if (least < 22 && v >> (least * 3) as u64 != 0 as u64) {
    digits = oct_count(v);
  }
  push_oct_digits(h, t, v, digits, digits % 3, width - digits);
}

// The head of an N-byte unit's octal digits: 8N bits over groups of three.
function oct_head(size: i32): i32 {
  if (size == 4) {
    return 2;
  }
  if (size == 8) {
    return 1;
  }
  return 0;
}

function push_oct_digits(h: usize, t: Tables, v: u64, digits: i32, head: i32, blanks: i32): void {
  var lead: i32 = 0;
  if (head > 0) {
    push_blanks(h, t, blanks);
    var top: i32 = (v >> ((digits - head) * 3) as u64 & 63 as u64) as i32;
    buf_push_range(h, t.oct, top * 4 + 4 - head, top * 4 + 4);
  } else if (blanks > 0) {
    lead = 1;
    if (blanks > 1) {
      push_blanks(h, t, blanks - 1);
    }
  }
  var shift: i32 = (digits - head - 3) * 3;
  while (shift >= 0) {
    var g: i32 = (v >> shift as u64 & 511 as u64) as i32;
    buf_push_range(h, t.oct, g * 4 + 1 - lead, g * 4 + 4);
    lead = 0;
    shift = shift - 9;
  }
}

function oct_count(v: u64): i32 {
  var count: i32 = 1;
  var rest: u64 = v >> 3 as u64;
  while (rest != 0 as u64) {
    count = count + 1;
    rest = rest >> 3 as u64;
  }
  return count;
}

// The digits come two at a time from the top: `top` is the leading one or
// two, and `p` the power of a hundred under them.
function push_dec(h: usize, t: Tables, neg: boolean, v: u64, least: i32, width: i32): void {
  var top: u64 = v;
  var p: u64 = 1 as u64;
  var count: i32 = 1;
  while (top >= 100 as u64) {
    top = top / (100 as u64);
    p = p * (100 as u64);
    count = count + 2;
  }
  if (top >= 10 as u64) {
    count = count + 1;
  }
  var digits: i32 = count;
  if (least > digits) {
    digits = least;
  }
  var taken: i32 = digits;
  if (neg) {
    taken = taken + 1;
  }
  push_blanks(h, t, width - taken);
  if (neg) {
    buf_push_byte(h, 45);
  }
  var k: i32 = digits - count;
  while (k > 0) {
    buf_push_byte(h, 48);
    k = k - 1;
  }
  var q: i32 = top as i32;
  if (q >= 10) {
    buf_push_range(h, t.dec, q * 2, q * 2 + 2);
  } else {
    buf_push_byte(h, 48 + q);
  }
  var rest: u64 = v - top * p;
  while (p > 1 as u64) {
    p = p / (100 as u64);
    q = (rest / p) as i32;
    rest = rest - q as u64 * p;
    buf_push_range(h, t.dec, q * 2, q * 2 + 2);
  }
}

// One of the four-column tables' entries, right-aligned in `width`.
function push_entry(h: usize, t: Tables, table: string, c: i32, width: i32): void {
  if (width > 4) {
    push_blanks(h, t, width - 4);
  }
  buf_push_range(h, table, c * 4, c * 4 + 4);
}

function push_text(h: usize, t: Tables, text: string, width: i32): void {
  push_blanks(h, t, width - text.len());
  buf_push(h, text);
}

// One unit of `sp` at `at`, right-aligned in `width` columns, for the
// kinds without a line loop of their own.
function push_field(h: usize, t: Tables, sp: Spec, block: string, at: i32, width: i32, big: boolean): void {
  if (sp.kind == k_char()) {
    push_entry(h, t, t.chars, block[at] as i32, width);
  } else if (sp.kind == k_unsigned()) {
    push_dec(h, t, false, unit_value(block, at, sp.size, big), 1, width);
  } else if (sp.kind == k_signed()) {
    var n: i64 = signed_value(unit_value(block, at, sp.size, big), sp.size);
    if (n < 0 as i64) {
      push_dec(h, t, true, negated(n), 1, width);
    } else {
      push_dec(h, t, false, n as u64, 1, width);
    }
  } else if (sp.kind == k_named()) {
    push_entry(h, t, t.names, block[at] as i32, width);
  } else {
    push_text(h, t, ftoa(print_format(sp.size), decode_float(block, at, sp.kind, sp.size, big)), width);
  }
}

// The magnitude of a negative i64, taken in u64 so the least one has a
// magnitude to take.
function negated(n: i64): u64 {
  return 0 as u64 - n as u64;
}

// ---- output ----------------------------------------------------------------
// `Settings` — everything the option scan decides.
struct Settings { specs: Spec[], base: i32, block: i32, wpb: i32, skip: u64, limit: u64, limited: boolean, dups: boolean, big: boolean, strings: boolean, min_string: u64, label: u64, labelled: boolean }

// `write_block(h, t, s, block, base, n, off)` — one input block through
// every spec, the first line carrying the address and the rest the same
// width in spaces.
function write_block(h: usize, t: Tables, s: Settings, block: string, base: i32, n: i32, off: u64): void {
  var i: i32 = 0;
  while (i < s.specs.len()) {
    if (i == 0) {
      push_address(h, t, s, off);
    } else {
      push_blanks(h, t, address_width(s.base));
    }
    spec_line(h, t, s.specs[i], s, block, base, n);
    buf_push_byte(h, 10);
    i = i + 1;
  }
}

// The fields of one spec over one block, `fields` of them less the
// `blank` at the end of a short block. The block's pad is handed out as
// the fields are printed — what is left divided by the fields still to
// come — which spreads it evenly and is what lines the specs up. The
// two integer kinds a dump is usually made of have a loop each, with the
// field written in the loop rather than behind a call.
function spec_line(h: usize, t: Tables, sp: Spec, s: Settings, block: string, base: i32, n: i32): void {
  var fields: i32 = s.block / sp.size;
  var blank: i32 = (s.block - n) / sp.size;
  var used: i32 = 0;
  if (sp.kind == k_hex()) {
    used = hex_line(h, t, sp, block, base, fields, blank, s.big);
  } else if (sp.kind == k_octal()) {
    used = oct_line(h, t, sp, block, base, fields, blank, s.big);
  } else {
    used = other_line(h, t, sp, block, base, fields, blank, s.big);
  }
  if (!sp.z) {
    return;
  }
  push_blanks(h, t, s.wpb - used);
  buf_push(h, "  >");
  var from: i32 = base;
  var i: i32 = 0;
  while (i < n) {
    if (!is_printable(block[base + i] as i32)) {
      buf_push_range(h, block, from, base + i);
      buf_push_byte(h, 46);
      from = base + i + 1;
    }
    i = i + 1;
  }
  buf_push_range(h, block, from, base + n);
  buf_push_byte(h, 60);
}

// A hexadecimal field is the unit's bytes in print order, a table entry
// each, so it is read straight from the block; the last blank before it
// comes with the first byte's entry. Returns the columns written.
function hex_line(h: usize, t: Tables, sp: Spec, block: string, base: i32, fields: i32, blank: i32, big: boolean): i32 {
  var hex: string = t.hex;
  var size: i32 = sp.size;
  var fw: i32 = sp.fw;
  var pad: i32 = sp.pad;
  var w: i32 = fw + 1;
  var used: i32 = 0;
  var i: i32 = fields;
  var at: i32 = base;
  while (i > blank) {
    if (sp.pad > 0) {
      var next_pad: i32 = sp.pad * (i - 1) / fields;
      w = pad - next_pad + fw + 1;
      pad = next_pad;
    }
    var lead: i32 = 0;
    if (w > fw) {
      lead = 1;
      if (w > fw + 1) {
        push_blanks(h, t, w - fw - 1);
      }
    }
    var end: i32 = at + size;
    if (big) {
      var j: i32 = at;
      while (j < end) {
        var b: i32 = block[j] as i32;
        buf_push_range(h, hex, b * 3 + 1 - lead, b * 3 + 3);
        lead = 0;
        j = j + 1;
      }
    } else {
      var k: i32 = end - 1;
      while (k >= at) {
        var c: i32 = block[k] as i32;
        buf_push_range(h, hex, c * 3 + 1 - lead, c * 3 + 3);
        lead = 0;
        k = k - 1;
      }
    }
    used = used + w;
    at = end;
    i = i - 1;
  }
  return used;
}

function oct_line(h: usize, t: Tables, sp: Spec, block: string, base: i32, fields: i32, blank: i32, big: boolean): i32 {
  var size: i32 = sp.size;
  var fw: i32 = sp.fw;
  var pad: i32 = sp.pad;
  var w: i32 = fw + 1;
  var used: i32 = 0;
  var i: i32 = fields;
  var at: i32 = base;
  var head: i32 = oct_head(size);
  while (i > blank) {
    if (sp.pad > 0) {
      var next_pad: i32 = sp.pad * (i - 1) / fields;
      w = pad - next_pad + fw + 1;
      pad = next_pad;
    }
    push_oct_digits(h, t, unit_value(block, at, size, big), fw, head, w - fw);
    used = used + w;
    at = at + size;
    i = i - 1;
  }
  return used;
}

function other_line(h: usize, t: Tables, sp: Spec, block: string, base: i32, fields: i32, blank: i32, big: boolean): i32 {
  var pad: i32 = sp.pad;
  var w: i32 = sp.fw + 1;
  var used: i32 = 0;
  var i: i32 = fields;
  var at: i32 = base;
  while (i > blank) {
    if (sp.pad > 0) {
      var next_pad: i32 = sp.pad * (i - 1) / fields;
      w = pad - next_pad + sp.fw + 1;
      pad = next_pad;
    }
    push_field(h, t, sp, block, at, w, big);
    used = used + w;
    at = at + sp.size;
    i = i - 1;
  }
  return used;
}

// ---- the input -------------------------------------------------------------
//
// `Src` — the operands as one stream. A file that cannot be opened is
// reported and skipped, and the exit status remembers it.
// `buf` / `pos` hold what has been read and not yet handed out. A block
// is 16 bytes by default, so without them a 62 MiB dump would be four
// million read(2) calls.
struct Src { files: string[], at: i32, r: Reader, open: boolean, is_stdin: boolean, buf: string, pos: i32, eof: boolean, fails: i32, opened: boolean }

function src_new(files: string[]): Src {
  return Src { files: files, at: 0, r: stdin(), open: false, is_stdin: false, buf: "", pos: 0, eof: false, fails: 0, opened: false };
}

function read_size(): i32 {
  return 65536;
}

// `src_ensure(s)` — open operands until one opens or the list is spent,
// which is GNU's open_next_file. Each failure is reported and remembered
// in the exit status; a run where none of them opens writes nothing at
// all, not even the offset line.
function src_ensure(s0: Src): Src {
  var s: Src = s0;
  while (!s.open && s.at < s.files.len()) {
    var name: string = s.files[s.at];
    s = Src { ...s, at: s.at + 1 };
    if (name == "-") {
      s = Src { ...s, r: stdin(), open: true, is_stdin: true, opened: true, buf: "", pos: 0 };
    } else {
      match (open_reader(name)) {
        Ok(f) => {
          s = Src { ...s, r: f, open: true, is_stdin: false, opened: true, buf: "", pos: 0 };
        },
        Err(e) => {
          gnu.error(gnu.quotef(name) + ": " + gnu.io_error_text(e));
          s = Src { ...s, fails: s.fails + 1 };
        }
      }
    }
  }
  return s;
}

// Done with the operand in hand. Stdin is left open: it can be named
// twice (`od - -`), and the second mention reads from where the first
// stopped rather than from a closed descriptor.
function src_close(s: Src): Src {
  if (s.open && !s.is_stdin) {
    s.r.close();
  }
  return Src { ...s, open: false };
}

// What is held in the buffer counts as part of the operand still to
// come, so a skip spends it before it reaches for the descriptor.
function skip_buffered(s0: Src, left0: u64): (u64, Src) {
  var s: Src = s0;
  var left: u64 = left0;
  var have: u64 = (s.buf.len() - s.pos) as u64;
  if (have == 0 as u64) {
    return (left, s);
  }
  if (have <= left) {
    return (left - have, Src { ...s, buf: "", pos: 0 });
  }
  return (0 as u64, Src { ...s, pos: s.pos + left as i32 });
}

// The next block of at most `want` bytes, spanning operands.
function src_read(s0: Src, want: i32): (string, Src) {
  var s: Src = s0;
  var got: string = "";
  while (true) {
    if (s.pos < s.buf.len()) {
      var take: i32 = s.buf.len() - s.pos;
      if (take > want - got.len()) {
        take = want - got.len();
      }
      if (take > 0) {
        if (got.len() == 0 && take == want) {
          // The whole answer is already in the buffer, so it is one
          // slice rather than a copy into an accumulator.
          return (slice_unchecked(s.buf, s.pos, s.pos + take) + "", Src { ...s, pos: s.pos + take });
        }
        got = got + slice_unchecked(s.buf, s.pos, s.pos + take);
        s = Src { ...s, pos: s.pos + take };
      }
    }
    if (got.len() >= want) {
      return (got, s);
    }
    s = src_ensure(s);
    if (!s.open) {
      return (got, Src { ...s, eof: true });
    }
    match (s.r.read_chunk(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          s = src_close(s);
        } else {
          s = Src { ...s, buf: chunk, pos: 0 };
        }
      },
      Err(e) => {
        gnu.error(gnu.quotef(s.files[s.at - 1]) + ": " + gnu.io_error_text(e));
        s = Src { ...src_close(s), fails: s.fails + 1 };
      }
    }
  }
  return (got, s);
}

// `skip_input(s, n)` — drop `n` bytes, reporting GNU's refusal when the
// whole input is shorter than that.
//
// How far an operand can be skipped depends on what it is, and GNU asks
// in this order: a REGULAR file answers from its size, so skipping past
// the end of one is refused however seekable it is; anything else is
// seeked when it can be, which is why `od -j 4 /dev/null` succeeds where
// the same skip on a pipe cannot; and a pipe is read and discarded.
function skip_input(s0: Src, n: u64): Src {
  var s: Src = s0;
  var left: u64 = n;
  while (left > 0 as u64) {
    s = src_ensure(s);
    if (!s.open) {
      gnu.error("cannot skip past end of combined input");
      exit(1);
    }
    var r: (u64, Src) = skip_in_file(s, left);
    left = r.0;
    s = r.1;
    if (left > 0 as u64) {
      s = src_close(s);
    }
  }
  return s;
}

function skip_in_file(s0: Src, left0: u64): (u64, Src) {
  var b: (u64, Src) = skip_buffered(s0, left0);
  var s: Src = b.1;
  var left: u64 = b.0;
  if (left == 0 as u64) {
    return (0 as u64, s);
  }
  match (s.r.stat()) {
    Ok(st) => {
      if (st.is_file) {
        var avail: u64 = 0 as u64;
        var at: i64 = 0 as i64;
        match (s.r.seek(0 as i64, 1)) {
          Ok(p) => {
            at = p;
          },
          Err(_) => {}
        }
        if (st.size > at) {
          avail = (st.size - at) as u64;
        }
        if (avail < left) {
          return (left - avail, s);
        }
        match (s.r.seek(left as i64, 1)) {
          Ok(_) => {
            return (0 as u64, s);
          },
          Err(_) => {}
        }
      }
    },
    Err(_) => {}
  }
  match (s.r.seek(left as i64, 1)) {
    Ok(_) => {
      return (0 as u64, s);
    },
    Err(_) => {}
  }
  while (left > 0 as u64) {
    var want: i32 = read_size();
    if (left < want as u64) {
      want = left as i32;
    }
    match (s.r.read_chunk(want)) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return (left, s);
        }
        left = left - chunk.len() as u64;
      },
      Err(e) => {
        gnu.error(gnu.quotef(s.files[s.at - 1]) + ": " + gnu.io_error_text(e));
        return (left, Src { ...s, fails: s.fails + 1 });
      }
    }
  }
  return (0 as u64, s);
}

// ---- the dump --------------------------------------------------------------
//
// Input arrives a page at a time and output goes straight into stdout's
// builder, which is flushed at its threshold once per page rather than
// checked on every piece. The block before this one is almost always the
// one just behind it in the same page, so the elision compares two ranges
// of the page and only carries a copy across the seam between pages.
function dump(w0: io_buffered.BufWriter, t: Tables, s: Settings, src0: Src): (io_buffered.BufWriter, Src) {
  var w: io_buffered.BufWriter = w0;
  var h: usize = w.handle();
  var src: Src = src0;
  var fails0: i32 = src.fails;
  var off: u64 = s.skip;
  var left: u64 = s.limit;
  var carry: string = "";
  var have_prev: boolean = false;
  var folded: boolean = false;
  var per_read: i32 = read_size() / s.block * s.block;
  if (per_read < s.block) {
    per_read = s.block;
  }
  while (true) {
    var want: i32 = per_read;
    if (s.limited && left < want as u64) {
      want = left as i32;
    }
    if (want == 0) {
      break;
    }
    var r: (string, Src) = src_read(src, want);
    src = r.1;
    var chunk: string = r.0;
    if (chunk.len() == 0) {
      break;
    }
    left = left - chunk.len() as u64;
    var at: i32 = 0;
    while (at + s.block <= chunk.len()) {
      var repeat: boolean = false;
      if (!s.dups && have_prev) {
        if (at >= s.block) {
          repeat = __mismatch(chunk, at - s.block, chunk, at, s.block) == s.block;
        } else {
          repeat = __mismatch(chunk, at, carry, 0, s.block) == s.block;
        }
      }
      if (repeat) {
        if (!folded) {
          buf_push(h, "*\n");
          folded = true;
        }
      } else {
        write_block(h, t, s, chunk, at, s.block, off);
        folded = false;
      }
      have_prev = true;
      off = off + s.block as u64;
      at = at + s.block;
    }
    w = gnu.settle(w);
    if (at < chunk.len()) {
      var tail: i32 = chunk.len() - at;
      write_block(h, t, s, pad_block(chunk, at, s.block), 0, tail, off);
      off = off + tail as u64;
      break;
    }
    if (at >= s.block) {
      carry = slice_unchecked(chunk, at - s.block, at) + "";
    }
    if (chunk.len() < want) {
      break;
    }
  }
  // Two conditions, and they are not the same one. GNU never reaches
  // the dump when no operand opened, which is what `src.opened` stands
  // for; and 9.5 stopped printing the closing address when nothing was
  // read and something failed INSIDE the dump, which is the directory
  // operand. An operand that would not open failed before the dump
  // began, so `od nosuch -` still prints the address.
  if ((s.base != radix_none() || s.labelled) && src.opened && (src.fails == fails0 || off != 0 as u64)) {
    push_address(h, t, s, off);
    buf_push_byte(h, 10);
  }
  return (gnu.check(w), src);
}

// The short last block from `at`, completed with zeros so a multi-byte
// unit at its end still has a whole unit to print. `__alloc_u8` hands
// back stale bytes, so the zeros are written.
function pad_block(chunk: string, at: i32, n: i32): string {
  var out: u8[] = __alloc_u8(n);
  var i: i32 = 0;
  while (at + i < chunk.len()) {
    out = out.with(i, chunk[at + i]);
    i = i + 1;
  }
  while (i < n) {
    out = out.with(i, 0 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

// ---- strings mode ----------------------------------------------------------
//
// `-S N` reports the NUL-terminated runs of at least N printable
// characters, each with the offset it starts at. A run broken by a byte
// that is neither printable nor NUL is not a string at all. The run in
// progress is a range of the current read, from `from`; only the part a
// read boundary cuts off is copied, into `held`.
//
// A run that `-N` cuts is not abandoned the way one that EOF cuts is:
// GNU stops reading at the limit and prints what it has, addressed as
// though the terminator were the byte BEFORE the run — one less than
// where it starts — and it only starts a run when more than N bytes are
// left, so a cut run is printed when it is longer than N.
function dump_strings(w0: io_buffered.BufWriter, t: Tables, s: Settings, src0: Src): (io_buffered.BufWriter, Src) {
  var w: io_buffered.BufWriter = w0;
  var h: usize = w.handle();
  var src: Src = src0;
  var off: u64 = s.skip;
  var left: u64 = s.limit;
  var start: u64 = off;
  var held: usize = buf_new(256);
  while (true) {
    var want: i32 = read_size();
    if (s.limited && left < want as u64) {
      want = left as i32;
    }
    if (want == 0) {
      break;
    }
    var r: (string, Src) = src_read(src, want);
    src = r.1;
    var block: string = r.0;
    if (block.len() == 0) {
      break;
    }
    left = left - block.len() as u64;
    if (buf_len(held) == 0) {
      start = off;
    }
    var from: i32 = 0;
    var i: i32 = 0;
    while (i < block.len()) {
      var c: i32 = block[i] as i32;
      if (c == 0) {
        if ((buf_len(held) + (i - from)) as u64 >= s.min_string) {
          buf_push_range(held, block, from, i);
          push_run(h, t, s, start, held);
          w = gnu.settle(w);
        }
        drop_held(held);
        from = i + 1;
        start = off + (i + 1) as u64;
      } else if (!is_printable(c)) {
        drop_held(held);
        from = i + 1;
        start = off + (i + 1) as u64;
      }
      i = i + 1;
    }
    if (from < block.len()) {
      buf_push_range(held, block, from, block.len());
    }
    off = off + block.len() as u64;
  }
  // A run the byte limit cut short is printed as it stands: 9.5 stopped
  // requiring the terminator, and the address it carries is the run's
  // own start rather than one byte before it.
  if (s.limited && left == 0 as u64 && buf_len(held) > 0 && buf_len(held) as u64 >= s.min_string) {
    push_run(h, t, s, start, held);
  }
  buf_free(held);
  return (gnu.check(w), src);
}

// One string: its address, when there is one, then the run `held`
// holds, which this empties.
function push_run(h: usize, t: Tables, s: Settings, at: u64, held: usize): void {
  if (s.base != radix_none() || s.labelled) {
    push_address(h, t, s, at);
    buf_push_byte(h, 32);
  }
  buf_push(h, buf_take(held));
  buf_push_byte(h, 10);
}

function drop_held(held: usize): void {
  if (buf_len(held) > 0) {
    var _: string = buf_take(held);
  }
}

// ---- traditional operands --------------------------------------------------
//
// `[+]OFFSET[.][b]`: hexadecimal with a `0x` prefix, decimal with a
// trailing `.`, octal otherwise, and `b` multiplies by 512. Anything
// else is not an offset, and the operand stays a file name.
function parse_old_offset(s: string): (u64, boolean) {
  var i: i32 = 0;
  if (i < s.len() && s[i] as i32 == 43) {
    i = i + 1;
  }
  if (i >= s.len() || !gnu.is_digit(s[i] as i32)) {
    return (0 as u64, false);
  }
  // The `.` that picks decimal has to be the LAST thing in the operand,
  // or the last but one with the `b`/`B` multiplier after it. Anywhere
  // else it is not a radix marker at all: the radix stays octal and the
  // point then makes the operand a file name. 9.5 added this; before it
  // a point anywhere chose decimal and the operand was refused.
  var dot: i32 = dot_at(s, i);
  var base: i32 = 8;
  if (dot >= 0) {
    base = 10;
  } else if (s.len() > i + 1 && s[i] as i32 == 48 && (s[i + 1] as i32 == 120 || s[i + 1] as i32 == 88)) {
    base = 16;
    i = i + 2;
  }
  var end: i32 = s.len();
  if (dot >= 0) {
    end = dot;
  }
  var v: u64 = 0 as u64;
  var any: boolean = false;
  var over: boolean = false;
  while (i < end) {
    var d: i32 = hex_value(s[i] as i32);
    if (d < 0 || d >= base) {
      break;
    }
    match (v.checked_mul(base as u64)) {
      Some(m) => {
        v = m + d as u64;
      },
      None => {
        over = true;
      }
    }
    if (v > 9223372036854775807 as u64) {
      over = true;
    }
    any = true;
    i = i + 1;
  }
  if (!any) {
    return (0 as u64, false);
  }
  if (dot >= 0) {
    if (i != end) {
      return (0 as u64, false);
    }
    i = i + 1;
  }
  if (i < s.len()) {
    var mul: u64 = 0 as u64;
    if (s[i] as i32 == 98) {
      mul = 512 as u64;
    } else if (s[i] as i32 == 66) {
      mul = 1024 as u64;
    } else {
      return (0 as u64, false);
    }
    match (v.checked_mul(mul)) {
      Some(m) => {
        v = m;
      },
      None => {
        over = true;
      }
    }
    if (v > 9223372036854775807 as u64) {
      over = true;
    }
    i = i + 1;
  }
  if (i != s.len()) {
    return (0 as u64, false);
  }
  // An offset that parses and does not fit ends the program, rather
  // than falling back to the operand being a file name.
  if (over) {
    gnu.error(gnu.quotef(s) + ": " + gnu.erange_text());
    exit(1);
  }
  return (v, true);
}

// The point that makes an old-style offset decimal: the last byte of the
// operand, or the last but one with `b` or `B` after it. -1 when there
// is none in that position, whether or not the operand holds a point.
function dot_at(s: string, from: i32): i32 {
  var i: i32 = from;
  while (i < s.len()) {
    if (s[i] as i32 == 46) {
      var after: i32 = i + 1;
      if (after < s.len() && (s[after] as i32 == 98 || s[after] as i32 == 66)) {
        after = after + 1;
      }
      if (after == s.len()) {
        return i;
      }
      return 0 - 1;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// ---- main ------------------------------------------------------------------
//
// The block is a multiple of every spec's unit size, so no unit ever
// straddles two lines: the least common multiple of the sizes, taken up
// to sixteen when it is smaller.
function lcm_of(specs: Spec[]): i32 {
  var l: i32 = 1;
  var i: i32 = 0;
  while (i < specs.len()) {
    l = lcm2(l, specs[i].size);
    i = i + 1;
  }
  return l;
}

function lcm2(a: i32, b: i32): i32 {
  return a / gcd(a, b) * b;
}

function gcd(a: i32, b: i32): i32 {
  var x: i32 = a;
  var y: i32 = b;
  while (y != 0) {
    var t: i32 = x % y;
    x = y;
    y = t;
  }
  return x;
}

// The traditional letters, in the order GNU declares them, each with the
// spec it stands for. The hidden ones (B D e F H I L O X h) are here
// too, because a user who types one still gets its dump.
function trad_spec(c: i32): Spec {
  if (c == 97) {
    return new_spec(k_named(), 1, false);
  }
  if (c == 98) {
    return new_spec(k_octal(), 1, false);
  }
  if (c == 99) {
    return new_spec(k_char(), 1, false);
  }
  if (c == 100) {
    return new_spec(k_unsigned(), 2, false);
  }
  if (c == 102) {
    return new_spec(k_float(), 4, false);
  }
  if (c == 105) {
    return new_spec(k_signed(), 4, false);
  }
  if (c == 108) {
    return new_spec(k_signed(), 8, false);
  }
  if (c == 111) {
    return new_spec(k_octal(), 2, false);
  }
  if (c == 115) {
    return new_spec(k_signed(), 2, false);
  }
  if (c == 120) {
    return new_spec(k_hex(), 2, false);
  }
  if (c == 66) {
    return new_spec(k_octal(), 2, false);
  }
  if (c == 68) {
    return new_spec(k_unsigned(), 4, false);
  }
  if (c == 101 || c == 70) {
    return new_spec(k_float(), 8, false);
  }
  if (c == 72 || c == 88) {
    return new_spec(k_hex(), 4, false);
  }
  if (c == 73 || c == 76) {
    return new_spec(k_signed(), 8, false);
  }
  if (c == 79) {
    return new_spec(k_octal(), 4, false);
  }
  return new_spec(k_hex(), 2, false);
}

function trad_letters(): string {
  return "abcdfilosxBDeFHILOXh";
}

function declare_options(): gnu.Opt[] {
  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("j", "skip-bytes", opt_skip()));
  opts = opts.append(gnu.valued("A", "address-radix", opt_radix()));
  opts = opts.append(gnu.valued("N", "read-bytes", opt_read()));
  opts = opts.append(gnu.valued("t", "format", opt_format()));
  opts = opts.append(gnu.flag("v", "output-duplicates", opt_dups()));
  opts = opts.append(gnu.valued_optional_long("S", "strings", opt_strings()));
  opts = opts.append(gnu.flag("", "traditional", opt_traditional()));
  opts = opts.append(gnu.optional("w", "width", opt_width()));
  opts = opts.append(gnu.valued("", "endian", opt_endian()));
  var letters: string = trad_letters();
  var i: i32 = 0;
  while (i < letters.len()) {
    opts = opts.append(gnu.flag(slice_unchecked(letters, i, i + 1) + "", "", trad_base() + letters[i] as i32));
    i = i + 1;
  }
  return opts;
}

pub function main(): i32 {
  var argv: string[] = args();
  var specs: Spec[] = [];
  var base: i32 = 8;
  var skip: u64 = 0 as u64;
  var limit: u64 = 0 as u64;
  var limited: boolean = false;
  var dups: boolean = false;
  var big: boolean = false;
  var strings: boolean = false;
  var min_string: u64 = 3 as u64;
  var width: u64 = 16 as u64;
  var width_given: boolean = false;
  var modern: boolean = false;
  var traditional: boolean = false;
  var type_given: boolean = false;

  var g: gnu.Getopt = gnu.getopt_new(argv, declare_options(), "od", help_text(), 1);
  while (true) {
    var r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_skip()) {
          modern = true;
          skip = count_arg(m.value, skip_name(argv));
        } else if (m.id == opt_read()) {
          modern = true;
          limit = count_arg(m.value, read_name(argv));
          limited = true;
        } else if (m.id == opt_radix()) {
          modern = true;
          base = radix_of(m.value);
        } else if (m.id == opt_format()) {
          modern = true;
          type_given = true;
          specs = parse_type(m.value, specs);
        } else if (m.id == opt_dups()) {
          modern = true;
          dups = true;
        } else if (m.id == opt_strings()) {
          modern = true;
          strings = true;
          if (m.has_value) {
            var n: u64 = count_arg(m.value, strings_name(argv));
            // The buffer is the run plus its terminator, so a length whose
            // successor leaves idx_t is the option's own overflow — worded
            // the way xstrtol_fatal words a value the parse could not hold.
            // Below that the answer is the host's, and od.fern accepts what
            // GNU would only refuse for want of memory.
            if (n >= 9223372036854775807 as u64) {
              gnu.error(strings_name(argv) + " argument " + gnu.quote(m.value) + " too large");
              exit(1);
            }
            min_string = n;
          }
        } else if (m.id == opt_width()) {
          modern = true;
          width_given = true;
          width = 32 as u64;
          if (m.has_value) {
            var w: u64 = count_arg(m.value, width_name(argv));
            if (w > 9223372036854775807 as u64) {
              gnu.error(width_name(argv) + " argument " + gnu.quote(m.value) + " too large");
              exit(1);
            }
            width = w;
          }
        } else if (m.id == opt_endian()) {
          big = endian_of(m.value);
        } else if (m.id == opt_traditional()) {
          traditional = true;
        } else if (m.id >= trad_base()) {
          specs = specs.append(trad_spec(m.id - trad_base()));
        }
      },
      None => {
        break;
      }
    }
  }

  var operands: string[] = g.operands();
  var files: string[] = [];
  var label: u64 = 0 as u64;
  var labelled: boolean = false;
  if (!modern || traditional) {
    var t: (string[], u64, boolean, u64) = old_operands(operands, traditional);
    files = t.0;
    skip = t.1;
    labelled = t.2;
    label = t.3;
  } else {
    files = operands;
  }
  if (files.len() == 0) {
    files = files.append("-");
  }

  if (specs.len() == 0) {
    specs = specs.append(new_spec(k_octal(), 2, false));
  }
  if (strings && type_given) {
    gnu.error("no type may be specified when dumping strings");
    exit(1);
  }
  var block: i32 = block_bytes(specs, width, width_given);
  var wpb: i32 = 0;
  var i: i32 = 0;
  while (i < specs.len()) {
    var w: i32 = (specs[i].fw + 1) * (block / specs[i].size);
    if (w > wpb) {
      wpb = w;
    }
    i = i + 1;
  }
  i = 0;
  while (i < specs.len()) {
    specs = specs.with(i, Spec { ...specs[i], pad: wpb - (specs[i].fw + 1) * (block / specs[i].size) });
    i = i + 1;
  }

  var s: Settings = Settings { specs: specs, base: base, block: block, wpb: wpb, skip: skip, limit: limit, limited: limited, dups: dups, big: big, strings: strings, min_string: min_string, label: label, labelled: labelled };

  var src: Src = src_ensure(src_new(files));
  if (skip > 0 as u64) {
    src = skip_input(src, skip);
  }
  var t: Tables = tables_new();
  var w: io_buffered.BufWriter = gnu.out_with(65536);
  if (strings) {
    var ds: (io_buffered.BufWriter, Src) = dump_strings(w, t, s, src);
    w = ds.0;
    src = ds.1;
  } else {
    var dd: (io_buffered.BufWriter, Src) = dump(w, t, s, src);
    w = dd.0;
    src = dd.1;
  }
  gnu.finish(w);
  if (src.fails > 0) {
    return 1;
  }
  return 0;
}

// `-w`'s block, which is a multiple of every spec's unit: the least
// common multiple, or the width asked for when that is a multiple of it.
function block_bytes(specs: Spec[], width: u64, given: boolean): i32 {
  var l: i32 = lcm_of(specs);
  var chosen: u64 = l as u64;
  if (!given) {
    if (l < 16) {
      chosen = (l * (16 / l)) as u64;
    }
  } else if (width % (l as u64) == 0 as u64) {
    chosen = width;
  } else {
    gnu.error("warning: invalid width " + width.to_string() + "; using " + l.to_string() + " instead");
  }
  // gnulib's pad_at_overflow: spreading a block's padding over its
  // fields squares their count, so more than 3037000500 of them for any
  // one spec is refused before a byte is allocated for the block.
  var i: i32 = 0;
  while (i < specs.len()) {
    if (chosen / (specs[i].size as u64) > 3037000500 as u64) {
      gnu.error(width.to_string() + " is too large");
      exit(1);
    }
    i = i + 1;
  }
  if (chosen > 2147483647 as u64) {
    gnu.error("memory exhausted");
    exit(1);
  }
  return chosen as i32;
}

function radix_of(v: string): i32 {
  var c: i32 = 0;
  if (v.len() > 0) {
    c = v[0] as i32;
  }
  if (c == 100) {
    return 10;
  }
  if (c == 111) {
    return 8;
  }
  if (c == 120) {
    return 16;
  }
  if (c == 110) {
    return radix_none();
  }
  // The byte goes in RAW, as GNU's %c does: `od -A ""` puts a NUL in
  // the middle of its own diagnostic.
  gnu.error("invalid output address radix '" + byte_str(c) + "'; it must be one character from [doxn]");
  exit(1);
  return 8;
}

function endian_of(v: string): boolean {
  if (v == "big") {
    return true;
  }
  if (v == "little") {
    return false;
  }
  gnu.error("invalid argument " + gnu.quote(v) + " for '--endian'\nValid arguments are:\n  - 'little'\n  - 'big'");
  gnu.try_help(1);
  return false;
}

// The name a count diagnostic gives the option: the short letter when
// that is how it was typed, the canonical long name when it was not.
function option_name(argv: string[], short: string, long: string): string {
  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a.starts_with("--")) {
      if (a.starts_with("--" + long) || long.starts_with(slice_unchecked(a, 2, arg_name_end(a)) + "")) {
        return "--" + long;
      }
    } else if (gnu.is_option(a)) {
      var k: i32 = 1;
      while (k < a.len()) {
        if (slice_unchecked(a, k, k + 1) + "" == short) {
          return "-" + short;
        }
        k = k + 1;
      }
    }
    i = i + 1;
  }
  return "-" + short;
}

function arg_name_end(a: string): i32 {
  var eq: i32 = a.index_of("=");
  if (eq >= 0) {
    return eq;
  }
  return a.len();
}

function skip_name(argv: string[]): string {
  return option_name(argv, "j", "skip-bytes");
}

function read_name(argv: string[]): string {
  return option_name(argv, "N", "read-bytes");
}

function strings_name(argv: string[]): string {
  return option_name(argv, "S", "strings");
}

function width_name(argv: string[]): string {
  return option_name(argv, "w", "width");
}

// The second and third call formats: a file, then an offset, then (with
// --traditional) a label. An operand that is not an offset stays a file
// name, which is why `od f 4` and `od -t x1 f 4` differ.
function old_operands(operands: string[], traditional: boolean): (string[], u64, boolean, u64) {
  var files: string[] = [];
  var skip: u64 = 0 as u64;
  var label: u64 = 0 as u64;
  var labelled: boolean = false;
  var n: i32 = operands.len();
  if (traditional) {
    if (n == 1) {
      var one: (u64, boolean) = parse_old_offset(operands[0]);
      if (one.1) {
        return (files, one.0, false, 0 as u64);
      }
      files = files.append(operands[0]);
      return (files, 0 as u64, false, 0 as u64);
    }
    if (n == 2) {
      var first: (u64, boolean) = parse_old_offset(operands[0]);
      var second: (u64, boolean) = parse_old_offset(operands[1]);
      if (first.1 && second.1) {
        return (files, first.0, true, second.0);
      }
      if (second.1) {
        files = files.append(operands[0]);
        return (files, second.0, false, 0 as u64);
      }
    } else if (n == 3) {
      var off: (u64, boolean) = parse_old_offset(operands[1]);
      var lab: (u64, boolean) = parse_old_offset(operands[2]);
      if (off.1 && lab.1) {
        files = files.append(operands[0]);
        return (files, off.0, true, lab.0);
      }
    }
    if (n >= 2) {
      gnu.error("extra operand " + gnu.quote(operands[1]));
      gnu.die_usage("compatibility mode supports at most one file", 1);
    }
    return (files, 0 as u64, false, 0 as u64);
  }
  // Without --traditional the offset is taken only where the help says
  // it is: a lone `+N`, or a second operand that starts with `+` or a
  // digit.
  if (n == 1 && operands[0].len() > 0 && operands[0][0] as i32 == 43) {
    var one: (u64, boolean) = parse_old_offset(operands[0]);
    if (one.1) {
      return (files, one.0, false, 0 as u64);
    }
  }
  if (n == 2 && operands[1].len() > 0) {
    var c: i32 = operands[1][0] as i32;
    if (c == 43 || gnu.is_digit(c)) {
      var two: (u64, boolean) = parse_old_offset(operands[1]);
      if (two.1) {
        files = files.append(operands[0]);
        return (files, two.0, false, 0 as u64);
      }
    }
  }
  return (operands, 0 as u64, false, 0 as u64);
}
