import "std/string";
import "std/array";
import "std/io_buffered";
import "std/f64";
import "./lib/gnu";
import "./lib/ld";

function opt_skip(): i32 {
  return 1;
}

function opt_radix(): i32 {
  return 2;
}

function opt_read(): i32 {
  return 3;
}

function opt_format(): i32 {
  return 4;
}

function opt_dups(): i32 {
  return 5;
}

function opt_strings(): i32 {
  return 6;
}

function opt_traditional(): i32 {
  return 7;
}

function opt_width(): i32 {
  return 8;
}

function opt_endian(): i32 {
  return 9;
}

function trad_base(): i32 {
  return 1000;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "  or:  " + gnu.prog() + " [-abcdfilosx]... [FILE] [[+]OFFSET[.][b]]\n";
  out = out + "  or:  " + gnu.prog() + " --traditional [OPTION]... [FILE] [[+]OFFSET[.][b] [+][LABEL][.][b]]\n";
  out = out + "\n";
  out = out + "Dump the concatenated FILEs, octal bytes by default, one block per line\n";
  out = out + "with the offset of the block in front of it.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -A, --address-radix=RADIX   offset radix: one of [doxn] for decimal,\n";
  out = out + "                                octal, hexadecimal or none\n";
  out = out + "      --endian={big|little}   read each unit in that byte order\n";
  out = out + "  -j, --skip-bytes=BYTES      skip BYTES of input first\n";
  out = out + "  -N, --read-bytes=BYTES      dump at most BYTES of input\n";
  out = out + "  -S BYTES, --strings[=BYTES]  dump only NUL-terminated runs of at least\n";
  out = out + "                                BYTES (3) printable characters\n";
  out = out + "  -t, --format=TYPE           dump in TYPE, once per TYPE given\n";
  out = out + "  -v, --output-duplicates     write every block, never '*'\n";
  out = out + "  -w[BYTES], --width[=BYTES]  BYTES per line (32 when BYTES is omitted)\n";
  out = out + "      --traditional           read the offset and label operands above\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "The traditional format letters accumulate:\n";
  out = out + "  -a   -t a,  named character, high bit ignored\n";
  out = out + "  -b   -t o1, octal bytes\n";
  out = out + "  -c   -t c,  printable character or backslash escape\n";
  out = out + "  -d   -t u2, unsigned decimal 2-byte units\n";
  out = out + "  -f   -t fF, floats\n";
  out = out + "  -i   -t dI, decimal ints\n";
  out = out + "  -l   -t dL, decimal longs\n";
  out = out + "  -o   -t o2, octal 2-byte units\n";
  out = out + "  -s   -t d2, decimal 2-byte units\n";
  out = out + "  -x   -t x2, hexadecimal 2-byte units\n";
  out = out + "\n";
  out = out + "A TYPE is one or more of:\n";
  out = out + "  a          named character, high bit ignored\n";
  out = out + "  c          printable character or backslash escape\n";
  out = out + "  d[SIZE]    signed decimal, SIZE bytes per integer\n";
  out = out + "  f[SIZE]    floating point, SIZE bytes per float\n";
  out = out + "  o[SIZE]    octal, SIZE bytes per integer\n";
  out = out + "  u[SIZE]    unsigned decimal, SIZE bytes per integer\n";
  out = out + "  x[SIZE]    hexadecimal, SIZE bytes per integer\n";
  out = out + "\n";
  out = out + "SIZE is a number; for d, o, u and x it may also be C, S, I or L for the\n";
  out = out + "sizes of char, short, int and long, and for f it may be F, D or L for\n";
  out = out + "float, double and long double. A z suffix adds the printable characters\n";
  out = out + "of each line at its end.\n";
  out = out + "\n";
  out = out + "BYTES is hex with a 0x prefix, and takes a multiplier suffix:\n";
  out = out + "b 512, KB 1000, K 1024, MB 1000*1000, M 1024*1024, and so on for\n";
  out = out + "G, T, P, E, Z, Y, R, Q. Binary prefixes work too: KiB=K, MiB=M.\n";
  return out;
}

function oct_digits(n: i32): i32 {
  return (n * 8 + 2) / 3;
}

function hex_digits(n: i32): i32 {
  return n * 2;
}

function bit_digits(bits: i32): i32 {
  return bits * 30103 / 100000 + 1;
}

function unsigned_dec_digits(n: i32): i32 {
  return bit_digits(n * 8);
}

function signed_dec_digits(n: i32): i32 {
  let neg: i32 = bit_digits(n * 8 - 1) + 1;
  let pos: i32 = unsigned_dec_digits(n);
  if (neg > pos) {
    return neg;
  }
  return pos;
}

function float_digits(f: ld.Format): i32 {
  return 5 + prec_bound(f) - 1 + exp_digits(f);
}

function prec_bound(f: ld.Format): i32 {
  return (f.mant * 30103 + 99999) / 100000 + 1;
}

function exp_digits(f: ld.Format): i32 {
  let e: i32 = f.emax * 30103 / 100000;
  let d: i32 = 1;
  while (e >= 10) {
    e = e / 10;
    d = d + 1;
  }
  return d;
}

function k_named(): i32 {
  return 0;
}

function k_char(): i32 {
  return 1;
}

function k_signed(): i32 {
  return 2;
}

function k_octal(): i32 {
  return 3;
}

function k_unsigned(): i32 {
  return 4;
}

function k_hex(): i32 {
  return 5;
}

function k_float(): i32 {
  return 6;
}

function k_bfloat(): i32 {
  return 7;
}

struct Spec { kind: i32, size: i32, fw: i32, z: boolean, pad: i32, decode: ld.Format, print: ld.Format }

function spec_width(kind: i32, size: i32): i32 {
  if (kind == k_named() || kind == k_char()) {
    return 3;
  }
  if (kind == k_octal()) {
    return oct_digits(size);
  }
  if (kind == k_hex()) {
    return hex_digits(size);
  }
  if (kind == k_unsigned()) {
    return unsigned_dec_digits(size);
  }
  if (kind == k_signed()) {
    return signed_dec_digits(size);
  }
  return float_digits(print_format(size));
}

function float_format(size: i32): ld.Format {
  if (size == 4) {
    return ld.binary32();
  }
  if (size == 8) {
    return ld.binary64();
  }
  return ld.format();
}

function decode_format(kind: i32, size: i32): ld.Format {
  if (kind == k_bfloat()) {
    return ld.bfloat16();
  }
  if (size == 2) {
    return ld.binary16();
  }
  return float_format(size);
}

function print_format(size: i32): ld.Format {
  if (size == 2) {
    return ld.binary32();
  }
  return float_format(size);
}

function long_double_size(): i32 {
  let f: ld.Format = ld.format();
  if (f.mant == 53) {
    return 8;
  }
  return 16;
}

function new_spec(kind: i32, size: i32, z: boolean): Spec {
  return Spec { kind: kind, size: size, fw: spec_width(kind, size), z: z, pad: 0, decode: decode_format(kind, size), print: print_format(size) };
}

function type_error_size(arg: string, size: i32, floating: boolean): void {
  let what: string = "integral";
  if (floating) {
    what = "floating point";
  }
  gnu.error("invalid type string " + gnu.quote(arg) + ";\nthis system doesn't provide a " + size.to_string() + "-byte " + what + " type");
  exit(1);
}

function type_error(arg: string): void {
  gnu.error("invalid type string " + gnu.quote(arg));
  exit(1);
}

function int_size_letter(c: i32): i32 {
  if (c == 67) {
    return 1;
  }
  if (c == 83) {
    return 2;
  }
  if (c == 73) {
    return 4;
  }
  if (c == 76) {
    return 8;
  }
  return 0;
}

function float_size_letter(c: i32): i32 {
  if (c == 66 || c == 72) {
    return 2;
  }
  if (c == 70) {
    return 4;
  }
  if (c == 68) {
    return 8;
  }
  if (c == 76) {
    return long_double_size();
  }
  return 0;
}

function valid_int_size(n: i32): boolean {
  return n == 1 || n == 2 || n == 4 || n == 8;
}

function valid_float_size(n: i32): boolean {
  return n == 2 || n == 4 || n == 8 || n == long_double_size();
}

function parse_type(arg: string, specs: Spec[]): Spec[] {
  let out: Spec[] = specs;
  let i: i32 = 0;
  while (i < arg.len()) {
    let c: i32 = arg[i] as i32;
    i = i + 1;
    let kind: i32 = 0 - 1;
    let floating: boolean = false;
    if (c == 97) {
      kind = k_named();
    } else if (c == 99) {
      kind = k_char();
    } else if (c == 100) {
      kind = k_signed();
    } else if (c == 111) {
      kind = k_octal();
    } else if (c == 117) {
      kind = k_unsigned();
    } else if (c == 120) {
      kind = k_hex();
    } else if (c == 102) {
      kind = k_float();
      floating = true;
    } else {
      invalid_type_char(c, arg);
    }
    let size: i32 = 4;
    if (floating) {
      size = 8;
    }
    if (kind == k_named() || kind == k_char()) {
      size = 1;
    } else if (i < arg.len() && gnu.is_digit(arg[i] as i32)) {
      let n: i64 = 0 as i64;
      let too_big: boolean = false;
      while (i < arg.len() && gnu.is_digit(arg[i] as i32)) {
        if (!too_big) {
          n = n * (10 as i64) + (arg[i] as i32 - 48) as i64;
          if (n > 2147483647 as i64) {
            too_big = true;
          }
        }
        i = i + 1;
      }
      if (too_big) {
        type_error(arg);
      }
      size = n as i32;
      if (floating) {
        if (!valid_float_size(size)) {
          type_error_size(arg, size, true);
        }
      } else if (!valid_int_size(size)) {
        type_error_size(arg, size, false);
      }
    } else if (i < arg.len()) {
      let letter: i32 = 0;
      if (floating) {
        letter = float_size_letter(arg[i] as i32);
      } else {
        letter = int_size_letter(arg[i] as i32);
      }
      if (letter > 0) {
        size = letter;
        if (arg[i] as i32 == 66) {
          kind = k_bfloat();
        }
        i = i + 1;
      }
    }
    let z: boolean = false;
    if (i < arg.len() && arg[i] as i32 == 122) {
      z = true;
      i = i + 1;
    }
    out = out.append(new_spec(kind, size, z));
  }
  return out;
}

function invalid_type_char(c: i32, arg: string): void {
  byte_error("invalid character '", c, "' in type string " + gnu.quote(arg));
  exit(1);
}

function byte_error(prefix: string, c: i32, suffix: string): void {
  let h: usize = buf_new(prefix.len() + suffix.len() + 32);
  buf_push(h, gnu.prog());
  buf_push(h, ": ");
  buf_push(h, prefix);
  buf_push_byte(h, c);
  buf_push(h, suffix);
  buf_push_byte(h, 10);
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  stderr().write_bytes(bytes);
}

function byte_str(c: i32): string {
  let b: u8[] = [];
  b = b.append(c as u8);
  return string_from_bytes_unchecked(b);
}

function count_arg(value: string, opt: string): u64 {
  let body: string = value;
  let mul: u64 = 1 as u64;
  if (body.starts_with("0x") || body.starts_with("0X")) {
    let h: (u64, boolean, i32) = parse_hex(body);
    if (!h.1) {
      gnu.error("invalid " + opt + " argument " + gnu.quote(value));
      exit(1);
    }
    if (h.2 < body.len()) {
      let s: (u64, boolean) = suffix_multiplier(slice_unchecked(body, h.2, body.len()) + "");
      if (!s.1) {
        gnu.error("invalid suffix in " + opt + " argument " + gnu.quote(value));
        exit(1);
      }
      mul = s.0;
    }
    return checked_scale(h.0, mul, value, opt);
  }
  let r: (u64, i32) = gnu.parse_units(body);
  if (r.1 == 0) {
    return r.0;
  }
  if (r.1 == 1) {
    gnu.error("invalid " + opt + " argument " + gnu.quote(value));
    exit(1);
  }
  if (r.1 == 4) {
    gnu.error("invalid suffix in " + opt + " argument " + gnu.quote(value));
    exit(1);
  }
  gnu.error(opt + " argument " + gnu.quote(value) + " too large");
  exit(1);
  return 0 as u64;
}

function checked_scale(v: u64, mul: u64, value: string, opt: string): u64 {
  match (v.checked_mul(mul)) {
    Some(m) => {
      return m;
    },
    None => {
      gnu.error(opt + " argument " + gnu.quote(value) + " too large");
      exit(1);
    }
  }
  return 0 as u64;
}

function parse_hex(s: string): (u64, boolean, i32) {
  let i: i32 = 2;
  let v: u64 = 0 as u64;
  let any: boolean = false;
  while (i < s.len()) {
    let d: i32 = hex_value(s[i] as i32);
    if (d < 0) {
      break;
    }
    match (v.checked_mul(16 as u64)) {
      Some(m) => {
        v = m + d as u64;
      },
      None => {
        return (0 as u64, false, i);
      }
    }
    any = true;
    i = i + 1;
  }
  return (v, any, i);
}

function hex_value(c: i32): i32 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return 0 - 1;
}

function suffix_multiplier(s: string): (u64, boolean) {
  let r: (u64, i32) = gnu.parse_units("1" + s);
  if (r.1 != 0) {
    return (0 as u64, false);
  }
  return (r.0, true);
}

function radix_none(): i32 {
  return 0;
}

function address_width(base: i32): i32 {
  if (base == 16) {
    return 6;
  }
  if (base == radix_none()) {
    return 0;
  }
  return 7;
}

function push_address(h: usize, t: Tables, s: Settings, off: u64): void {
  if (s.base != radix_none()) {
    push_num(h, t, false, off, s.base, address_width(s.base), 0);
  }
  if (!s.labelled) {
    return;
  }
  if (s.base == radix_none()) {
    buf_push_byte(h, 40);
    push_num(h, t, false, off, 8, address_width(8), 0);
    buf_push_byte(h, 41);
    return;
  }
  buf_push(h, " (");
  push_num(h, t, false, off - s.skip + s.label, s.base, address_width(s.base), 0);
  buf_push_byte(h, 41);
}

function unit_value(block: u8[], at: i32, size: i32, big: boolean): u64 {
  let v: u64 = 0 as u64;
  if (big) {
    let i: i32 = 0;
    while (i < size) {
      v = (v << 8 as u64) + (block[at + i] as i32) as u64;
      i = i + 1;
    }
    return v;
  }
  let j: i32 = size - 1;
  while (j >= 0) {
    v = (v << 8 as u64) + (block[at + j] as i32) as u64;
    j = j - 1;
  }
  return v;
}

function signed_value(v: u64, size: i32): i64 {
  if (size >= 8) {
    return v as i64;
  }
  let bits: i32 = size * 8;
  let sign: u64 = 1 as u64 << (bits - 1) as u64;
  if ((v & sign) != 0 as u64) {
    return v as i64 - (1 as i64 << bits as i64);
  }
  return v as i64;
}

function is_printable(c: i32): boolean {
  return c >= 32 && c < 127;
}

function decode_float(block: u8[], at: i32, f: ld.Format, size: i32, big: boolean): ld.LD {
  let lo: u64 = 0 as u64;
  let hi: u64 = 0 as u64;
  if (size <= 8) {
    lo = unit_value(block, at, size, big);
  } else if (big) {
    hi = unit_value(block, at, 8, true);
    lo = unit_value(block, at + 8, 8, true);
  } else {
    lo = unit_value(block, at, 8, false);
    hi = unit_value(block, at + 8, 8, false);
  }
  if (f.explicit_bit) {
    return decode_x87(f, lo, hi);
  }
  return decode_ieee(f, lo, hi, size);
}

function decode_ieee(f: ld.Format, lo: u64, hi: u64, size: i32): ld.LD {
  let frac_bits: i32 = f.mant - 1;
  let mlo: u64 = lo;
  let mhi: u64 = 0 as u64;
  if (frac_bits < 64) {
    mlo = lo & (1 as u64 << frac_bits as u64) - 1 as u64;
  } else if (frac_bits > 64) {
    mhi = hi & (1 as u64 << (frac_bits - 64) as u64) - 1 as u64;
  }
  let shifted: u64 = 0 as u64;
  if (frac_bits >= 64) {
    shifted = hi >> (frac_bits - 64) as u64;
  } else {
    shifted = lo >> frac_bits as u64;
  }
  let exp_bits: i32 = size * 8 - f.mant;
  let exp: i32 = (shifted & (1 as u64 << exp_bits as u64) - 1 as u64) as i32;
  let neg: boolean = (shifted >> exp_bits as u64 & 1 as u64) != 0 as u64;
  let max_exp: i32 = (1 << exp_bits) - 1;
  if (exp == max_exp) {
    if (mhi == 0 as u64 && mlo == 0 as u64) {
      return ld.inf(neg);
    }
    return ld.nan(neg);
  }
  if (exp == 0) {
    return ld.LD { neg: neg, kind: 0, hi: mhi, lo: mlo, e: f.min_exp() };
  }
  if (frac_bits < 64) {
    mlo = mlo | 1 as u64 << frac_bits as u64;
  } else {
    mhi = mhi | 1 as u64 << (frac_bits - 64) as u64;
  }
  return ld.LD { neg: neg, kind: 0, hi: mhi, lo: mlo, e: exp - f.emax - frac_bits };
}

function decode_x87(f: ld.Format, lo: u64, hi: u64): ld.LD {
  let neg: boolean = (hi >> 15 as u64 & 1 as u64) != 0 as u64;
  let exp: i32 = (hi & 32767 as u64) as i32;
  let integer_bit: boolean = lo >> 63 as u64 != 0 as u64;
  if (exp == 32767) {
    if (!integer_bit) {
      return ld.nan(neg);
    }
    if ((lo & 9223372036854775807 as u64) == 0 as u64) {
      return ld.inf(neg);
    }
    return ld.nan(neg);
  }
  if (exp != 0 && !integer_bit) {
    return ld.nan(neg);
  }
  if (exp == 0) {
    let frac: u64 = lo & 9223372036854775807 as u64;
    if (frac != 0 as u64) {
      return ld.LD { neg: neg, kind: 0, hi: 0 as u64, lo: frac, e: f.min_exp() };
    }
    return ld.LD { neg: neg, kind: 0, hi: 0 as u64, lo: lo, e: f.min_exp() };
  }
  return ld.LD { neg: neg, kind: 0, hi: 0 as u64, lo: lo, e: exp - f.emax - (f.mant - 1) };
}

function ftoa(f: ld.Format, v: ld.LD): string {
  if (v.is_nan()) {
    if (v.neg && target_os() != "darwin") {
      return "-nan";
    }
    return "nan";
  }
  if (v.is_inf()) {
    if (v.neg) {
      return "-inf";
    }
    return "inf";
  }
  let sign: string = "";
  if (v.neg) {
    sign = "-";
  }
  let prec: i32 = f.dig();
  if (f.is_subnormal(v)) {
    prec = 1;
  }
  let bound: i32 = prec_bound(f);
  if ((f.mant == 53 || f.mant == 24) && !v.is_zero()) {
    return sign + ftoa_ieee(f, f.canonical(v), prec, bound);
  }
  let d: ld.Dec = v.dec();
  let s: string = "";
  while (prec <= bound) {
    s = sign + ld.general(d, prec as i64, false, false, 0 as i64).text();
    if (f.strtold(s).v.eq(v)) {
      return s;
    }
    prec = prec + 1;
  }
  return s;
}

function ftoa_ieee(f: ld.Format, v: ld.LD, prec: i32, bound: i32): string {
  let sd: (i64, i32) = shortest_digits(f, encode_ieee(f, v));
  let k: i32 = 1;
  let p10: i64 = 10 as i64;
  while (sd.0 >= p10) {
    p10 = p10 * (10 as i64);
    k = k + 1;
  }
  let x: i32 = k - 1 + sd.1;
  let p: i32 = prec;
  if (k > p) {
    p = k;
  }
  while (p < bound) {
    let r: (ld.Dec, boolean) = f.round_to(v, x, p);
    if (r.1) {
      return ld.general(r.0, p as i64, false, false, 0 as i64).text();
    }
    p = p + 1;
  }
  return ld.general(f.round_to(v, x, bound).0, bound as i64, false, false, 0 as i64).text();
}

function shortest_digits(f: ld.Format, bits: u64): (i64, i32) {
  if (f.mant == 53) {
    return f64_from_bits(bits as i64).shortest_digits();
  }
  return f32_from_bits(bits as i32).shortest_digits();
}

function encode_ieee(f: ld.Format, v: ld.LD): u64 {
  let frac_bits: i32 = f.mant - 1;
  let top: u64 = 1 as u64 << frac_bits as u64;
  let exp: i32 = 0;
  if ((v.lo & top) != 0 as u64) {
    exp = v.e + f.emax + frac_bits;
  }
  return exp as u64 << frac_bits as u64 | v.lo & top - 1 as u64;
}

struct Tables { hex: string, oct: string, dec: string, blanks: string, chars: string, names: string }

function blank_run(): i32 {
  return 64;
}

function tables_new(): Tables {
  let hex: u8[] = __alloc_u8(768);
  let i: i32 = 0;
  while (i < 256) {
    hex = hex.with(i * 3, 32 as u8);
    hex = hex.with(i * 3 + 1, digit_byte(i >> 4));
    hex = hex.with(i * 3 + 2, digit_byte(i & 15));
    i = i + 1;
  }
  let oct: u8[] = __alloc_u8(2048);
  i = 0;
  while (i < 512) {
    oct = oct.with(i * 4, 32 as u8);
    oct = oct.with(i * 4 + 1, (48 + (i >> 6)) as u8);
    oct = oct.with(i * 4 + 2, (48 + (i >> 3 & 7)) as u8);
    oct = oct.with(i * 4 + 3, (48 + (i & 7)) as u8);
    i = i + 1;
  }
  let dec: u8[] = __alloc_u8(200);
  i = 0;
  while (i < 100) {
    dec = dec.with(i * 2, (48 + i / 10) as u8);
    dec = dec.with(i * 2 + 1, (48 + i % 10) as u8);
    i = i + 1;
  }
  let chars: u8[] = __alloc_u8(1024);
  let names: u8[] = __alloc_u8(1024);
  i = 0;
  while (i < 256) {
    chars = right_aligned(chars, i * 4, char_text(i));
    names = right_aligned(names, i * 4, char_name(i));
    i = i + 1;
  }
  return Tables { hex: string_from_bytes_unchecked(hex), oct: string_from_bytes_unchecked(oct), dec: string_from_bytes_unchecked(dec), blanks: " ".repeat(blank_run()), chars: string_from_bytes_unchecked(chars), names: string_from_bytes_unchecked(names) };
}

function right_aligned(own table: u8[], at: i32, text: string): u8[] {
  let k: i32 = 0;
  while (k < 4 - text.len()) {
    table = table.with(at + k, 32 as u8);
    k = k + 1;
  }
  let j: i32 = 0;
  while (j < text.len()) {
    table = table.with(at + k + j, text[j]);
    j = j + 1;
  }
  return table;
}

function digit_byte(d: i32): u8 {
  if (d < 10) {
    return (48 + d) as u8;
  }
  return (87 + d) as u8;
}

function char_text(c: i32): string {
  if (c == 0) {
    return "\\0";
  }
  if (c == 7) {
    return "\\a";
  }
  if (c == 8) {
    return "\\b";
  }
  if (c == 9) {
    return "\\t";
  }
  if (c == 10) {
    return "\\n";
  }
  if (c == 11) {
    return "\\v";
  }
  if (c == 12) {
    return "\\f";
  }
  if (c == 13) {
    return "\\r";
  }
  if (is_printable(c)) {
    return byte_str(c);
  }
  let d: u8[] = [];
  d = d.append((48 + (c >> 6)) as u8);
  d = d.append((48 + (c >> 3 & 7)) as u8);
  d = d.append((48 + (c & 7)) as u8);
  return string_from_bytes_unchecked(d);
}

function char_name(c: i32): string {
  let b: i32 = c % 128;
  if (b == 127) {
    return "del";
  }
  if (b > 32) {
    return byte_str(b);
  }
  let names: string[] = ["nul", "soh", "stx", "etx", "eot", "enq", "ack", "bel", "bs", "ht", "nl", "vt", "ff", "cr", "so", "si", "dle", "dc1", "dc2", "dc3", "dc4", "nak", "syn", "etb", "can", "em", "sub", "esc", "fs", "gs", "rs", "us", "sp"];
  return names[b];
}

function push_blanks(h: usize, t: Tables, n: i32): void {
  let k: i32 = n;
  while (k > blank_run()) {
    buf_push_range(h, t.blanks, 0, blank_run());
    k = k - blank_run();
  }
  if (k > 0) {
    buf_push_range(h, t.blanks, 0, k);
  }
}

function push_num(h: usize, t: Tables, neg: boolean, v: u64, base: i32, least: i32, width: i32): void {
  if (base == 16) {
    push_hex(h, t, v, least, width);
  } else if (base == 8) {
    push_oct(h, t, v, least, width);
  } else {
    push_dec(h, t, neg, v, least, width);
  }
}

function push_hex(h: usize, t: Tables, v: u64, least: i32, width: i32): void {
  let digits: i32 = least;
  if (least < 16 && v >> (least * 4) as u64 != 0 as u64) {
    digits = hex_count(v);
  }
  let blanks: i32 = width - digits;
  let lead: i32 = 0;
  if (digits % 2 == 1) {
    push_blanks(h, t, blanks);
    let d: i32 = (v >> ((digits - 1) * 4) as u64 & 15 as u64) as i32;
    buf_push_range(h, t.hex, d * 3 + 2, d * 3 + 3);
    digits = digits - 1;
  } else if (blanks > 0) {
    push_blanks(h, t, blanks - 1);
    lead = 1;
  }
  let shift: i32 = (digits - 2) * 4;
  while (shift >= 0) {
    let b: i32 = (v >> shift as u64 & 255 as u64) as i32;
    buf_push_range(h, t.hex, b * 3 + 1 - lead, b * 3 + 3);
    lead = 0;
    shift = shift - 8;
  }
}

function hex_count(v: u64): i32 {
  let count: i32 = 1;
  let rest: u64 = v >> 4 as u64;
  while (rest != 0 as u64) {
    count = count + 1;
    rest = rest >> 4 as u64;
  }
  return count;
}

function push_oct(h: usize, t: Tables, v: u64, least: i32, width: i32): void {
  let digits: i32 = least;
  if (least < 22 && v >> (least * 3) as u64 != 0 as u64) {
    digits = oct_count(v);
  }
  push_oct_digits(h, t, v, digits, digits % 3, width - digits);
}

function oct_head(size: i32): i32 {
  if (size == 4) {
    return 2;
  }
  if (size == 8) {
    return 1;
  }
  return 0;
}

function push_oct_digits(h: usize, t: Tables, v: u64, digits: i32, head: i32, blanks: i32): void {
  let lead: i32 = 0;
  if (head > 0) {
    push_blanks(h, t, blanks);
    let top: i32 = (v >> ((digits - head) * 3) as u64 & 63 as u64) as i32;
    buf_push_range(h, t.oct, top * 4 + 4 - head, top * 4 + 4);
  } else if (blanks > 0) {
    lead = 1;
    if (blanks > 1) {
      push_blanks(h, t, blanks - 1);
    }
  }
  let shift: i32 = (digits - head - 3) * 3;
  while (shift >= 0) {
    let g: i32 = (v >> shift as u64 & 511 as u64) as i32;
    buf_push_range(h, t.oct, g * 4 + 1 - lead, g * 4 + 4);
    lead = 0;
    shift = shift - 9;
  }
}

function oct_count(v: u64): i32 {
  let count: i32 = 1;
  let rest: u64 = v >> 3 as u64;
  while (rest != 0 as u64) {
    count = count + 1;
    rest = rest >> 3 as u64;
  }
  return count;
}

function push_dec(h: usize, t: Tables, neg: boolean, v: u64, least: i32, width: i32): void {
  let top: u64 = v;
  let p: u64 = 1 as u64;
  let count: i32 = 1;
  while (top >= 100 as u64) {
    top = top / (100 as u64);
    p = p * (100 as u64);
    count = count + 2;
  }
  if (top >= 10 as u64) {
    count = count + 1;
  }
  let digits: i32 = count;
  if (least > digits) {
    digits = least;
  }
  let taken: i32 = digits;
  if (neg) {
    taken = taken + 1;
  }
  push_blanks(h, t, width - taken);
  if (neg) {
    buf_push_byte(h, 45);
  }
  let k: i32 = digits - count;
  while (k > 0) {
    buf_push_byte(h, 48);
    k = k - 1;
  }
  let q: i32 = top as i32;
  if (q >= 10) {
    buf_push_range(h, t.dec, q * 2, q * 2 + 2);
  } else {
    buf_push_byte(h, 48 + q);
  }
  let rest: u64 = v - top * p;
  while (p > 1 as u64) {
    p = p / (100 as u64);
    q = (rest / p) as i32;
    rest = rest - q as u64 * p;
    buf_push_range(h, t.dec, q * 2, q * 2 + 2);
  }
}

function push_entry(h: usize, t: Tables, table: string, c: i32, width: i32): void {
  if (width > 4) {
    push_blanks(h, t, width - 4);
  }
  buf_push_range(h, table, c * 4, c * 4 + 4);
}

function push_text(h: usize, t: Tables, text: string, width: i32): void {
  push_blanks(h, t, width - text.len());
  buf_push(h, text);
}

function push_field(h: usize, t: Tables, sp: Spec, block: u8[], at: i32, width: i32, big: boolean): void {
  if (sp.kind == k_char()) {
    push_entry(h, t, t.chars, block[at] as i32, width);
  } else if (sp.kind == k_unsigned()) {
    push_dec(h, t, false, unit_value(block, at, sp.size, big), 1, width);
  } else if (sp.kind == k_signed()) {
    let n: i64 = signed_value(unit_value(block, at, sp.size, big), sp.size);
    if (n < 0 as i64) {
      push_dec(h, t, true, negated(n), 1, width);
    } else {
      push_dec(h, t, false, n as u64, 1, width);
    }
  } else if (sp.kind == k_named()) {
    push_entry(h, t, t.names, block[at] as i32, width);
  } else {
    push_text(h, t, ftoa(sp.print, decode_float(block, at, sp.decode, sp.size, big)), width);
  }
}

function negated(n: i64): u64 {
  return 0 as u64 - n as u64;
}

struct Settings { specs: Spec[], base: i32, block: i32, wpb: i32, skip: u64, limit: u64, limited: boolean, dups: boolean, big: boolean, strings: boolean, min_string: u64, label: u64, labelled: boolean }

function write_block(h: usize, t: Tables, s: Settings, block: u8[], base: i32, n: i32, off: u64): void {
  let i: i32 = 0;
  while (i < s.specs.len()) {
    if (i == 0) {
      push_address(h, t, s, off);
    } else {
      push_blanks(h, t, address_width(s.base));
    }
    spec_line(h, t, s.specs[i], s, block, base, n);
    buf_push_byte(h, 10);
    i = i + 1;
  }
}

function spec_line(h: usize, t: Tables, sp: Spec, s: Settings, block: u8[], base: i32, n: i32): void {
  let fields: i32 = s.block / sp.size;
  let blank: i32 = (s.block - n) / sp.size;
  let used: i32 = 0;
  if (sp.kind == k_hex()) {
    used = hex_line(h, t, sp, block, base, fields, blank, s.big);
  } else if (sp.kind == k_octal()) {
    used = oct_line(h, t, sp, block, base, fields, blank, s.big);
  } else {
    used = other_line(h, t, sp, block, base, fields, blank, s.big);
  }
  if (!sp.z) {
    return;
  }
  push_blanks(h, t, s.wpb - used);
  buf_push(h, "  >");
  let from: i32 = base;
  let i: i32 = 0;
  while (i < n) {
    if (!is_printable(block[base + i] as i32)) {
      buf_push_bytes_range(h, block, from, base + i);
      buf_push_byte(h, 46);
      from = base + i + 1;
    }
    i = i + 1;
  }
  buf_push_bytes_range(h, block, from, base + n);
  buf_push_byte(h, 60);
}

function hex_line(h: usize, t: Tables, sp: Spec, block: u8[], base: i32, fields: i32, blank: i32, big: boolean): i32 {
  let hex: string = t.hex;
  let size: i32 = sp.size;
  let fw: i32 = sp.fw;
  let pad: i32 = sp.pad;
  let w: i32 = fw + 1;
  let used: i32 = 0;
  let i: i32 = fields;
  let at: i32 = base;
  while (i > blank) {
    if (sp.pad > 0) {
      let next_pad: i32 = sp.pad * (i - 1) / fields;
      w = pad - next_pad + fw + 1;
      pad = next_pad;
    }
    let lead: i32 = 0;
    if (w > fw) {
      lead = 1;
      if (w > fw + 1) {
        push_blanks(h, t, w - fw - 1);
      }
    }
    let end: i32 = at + size;
    if (big) {
      let j: i32 = at;
      while (j < end) {
        let b: i32 = block[j] as i32;
        buf_push_range(h, hex, b * 3 + 1 - lead, b * 3 + 3);
        lead = 0;
        j = j + 1;
      }
    } else {
      let k: i32 = end - 1;
      while (k >= at) {
        let c: i32 = block[k] as i32;
        buf_push_range(h, hex, c * 3 + 1 - lead, c * 3 + 3);
        lead = 0;
        k = k - 1;
      }
    }
    used = used + w;
    at = end;
    i = i - 1;
  }
  return used;
}

function oct_line(h: usize, t: Tables, sp: Spec, block: u8[], base: i32, fields: i32, blank: i32, big: boolean): i32 {
  let size: i32 = sp.size;
  let fw: i32 = sp.fw;
  let pad: i32 = sp.pad;
  let w: i32 = fw + 1;
  let used: i32 = 0;
  let i: i32 = fields;
  let at: i32 = base;
  let head: i32 = oct_head(size);
  while (i > blank) {
    if (sp.pad > 0) {
      let next_pad: i32 = sp.pad * (i - 1) / fields;
      w = pad - next_pad + fw + 1;
      pad = next_pad;
    }
    push_oct_digits(h, t, unit_value(block, at, size, big), fw, head, w - fw);
    used = used + w;
    at = at + size;
    i = i - 1;
  }
  return used;
}

function other_line(h: usize, t: Tables, sp: Spec, block: u8[], base: i32, fields: i32, blank: i32, big: boolean): i32 {
  let pad: i32 = sp.pad;
  let w: i32 = sp.fw + 1;
  let used: i32 = 0;
  let i: i32 = fields;
  let at: i32 = base;
  while (i > blank) {
    if (sp.pad > 0) {
      let next_pad: i32 = sp.pad * (i - 1) / fields;
      w = pad - next_pad + sp.fw + 1;
      pad = next_pad;
    }
    push_field(h, t, sp, block, at, w, big);
    used = used + w;
    at = at + sp.size;
    i = i - 1;
  }
  return used;
}

struct Src { files: string[], at: i32, r: Reader, open: boolean, is_stdin: boolean, buf: u8[], pos: i32, eof: boolean, fails: i32, opened: boolean }

function src_new(files: string[]): Src {
  return Src { files: files, at: 0, r: stdin(), open: false, is_stdin: false, buf: [], pos: 0, eof: false, fails: 0, opened: false };
}

function read_size(): i32 {
  return 65536;
}

function src_ensure(s0: Src): Src {
  let s: Src = s0;
  while (!s.open && s.at < s.files.len()) {
    let name: string = s.files[s.at];
    s = Src { ...s, at: s.at + 1 };
    if (name == "-") {
      s = Src { ...s, r: stdin(), open: true, is_stdin: true, opened: true, buf: [], pos: 0 };
    } else {
      match (open_reader(name)) {
        Ok(f) => {
          s = Src { ...s, r: f, open: true, is_stdin: false, opened: true, buf: [], pos: 0 };
        },
        Err(e) => {
          gnu.error(gnu.quotef(name) + ": " + gnu.io_error_text(e));
          s = Src { ...s, fails: s.fails + 1 };
        }
      }
    }
  }
  return s;
}

function src_close(s: Src): Src {
  if (s.open && !s.is_stdin) {
    s.r.close();
  }
  return Src { ...s, open: false };
}

function skip_buffered(s0: Src, left0: u64): (u64, Src) {
  let s: Src = s0;
  let left: u64 = left0;
  let have: u64 = (s.buf.len() - s.pos) as u64;
  if (have == 0 as u64) {
    return (left, s);
  }
  if (have <= left) {
    return (left - have, Src { ...s, buf: [], pos: 0 });
  }
  return (0 as u64, Src { ...s, pos: s.pos + left as i32 });
}

function copy_bytes(bytes: u8[], lo: i32, hi: i32): u8[] {
  let h: usize = buf_new(hi - lo);
  buf_push_bytes_range(h, bytes, lo, hi);
  let out: u8[] = buf_take_bytes(h);
  buf_free(h);
  return out;
}

function src_read(s0: Src, want: i32): (u8[], Src) {
  let s: Src = s0;
  let held: usize = 0 as usize;
  let got: i32 = 0;
  while (true) {
    if (s.pos < s.buf.len()) {
      let take: i32 = s.buf.len() - s.pos;
      if (take > want - got) {
        take = want - got;
      }
      if (take > 0) {
        if (got == 0 && take == want) {
          if (s.pos == 0 && take == s.buf.len()) {
            return (s.buf, Src { ...s, pos: take });
          }
          return (copy_bytes(s.buf, s.pos, s.pos + take), Src { ...s, pos: s.pos + take });
        }
        if (held == 0 as usize) {
          held = buf_new(want);
        }
        buf_push_bytes_range(held, s.buf, s.pos, s.pos + take);
        got = got + take;
        s = Src { ...s, pos: s.pos + take };
      }
    }
    if (got >= want) {
      break;
    }
    s = src_ensure(s);
    if (!s.open) {
      s = Src { ...s, eof: true };
      break;
    }
    match (s.r.read_chunk_bytes(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          s = src_close(s);
        } else {
          s = Src { ...s, buf: chunk, pos: 0 };
        }
      },
      Err(e) => {
        gnu.error(gnu.quotef(s.files[s.at - 1]) + ": " + gnu.io_error_text(e));
        s = Src { ...src_close(s), fails: s.fails + 1 };
      }
    }
  }
  let out: u8[] = [];
  if (held != 0 as usize) {
    out = buf_take_bytes(held);
    buf_free(held);
  }
  return (out, s);
}

function skip_input(s0: Src, n: u64): Src {
  let s: Src = s0;
  let left: u64 = n;
  while (left > 0 as u64) {
    s = src_ensure(s);
    if (!s.open) {
      gnu.error("cannot skip past end of combined input");
      exit(1);
    }
    let r: (u64, Src) = skip_in_file(s, left);
    left = r.0;
    s = r.1;
    if (left > 0 as u64) {
      s = src_close(s);
    }
  }
  return s;
}

function skip_in_file(s0: Src, left0: u64): (u64, Src) {
  let b: (u64, Src) = skip_buffered(s0, left0);
  let s: Src = b.1;
  let left: u64 = b.0;
  if (left == 0 as u64) {
    return (0 as u64, s);
  }
  match (s.r.stat()) {
    Ok(st) => {
      if (st.is_file) {
        let avail: u64 = 0 as u64;
        let at: i64 = 0 as i64;
        match (s.r.seek(0 as i64, 1)) {
          Ok(p) => {
            at = p;
          },
          Err(_) => {}
        }
        if (st.size > at) {
          avail = (st.size - at) as u64;
        }
        if (avail < left) {
          return (left - avail, s);
        }
        match (s.r.seek(left as i64, 1)) {
          Ok(_) => {
            return (0 as u64, s);
          },
          Err(_) => {}
        }
      }
    },
    Err(_) => {}
  }
  match (s.r.seek(left as i64, 1)) {
    Ok(_) => {
      return (0 as u64, s);
    },
    Err(_) => {}
  }
  while (left > 0 as u64) {
    let want: i32 = read_size();
    if (left < want as u64) {
      want = left as i32;
    }
    match (s.r.read_chunk_bytes(want)) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return (left, s);
        }
        left = left - chunk.len() as u64;
      },
      Err(e) => {
        gnu.error(gnu.quotef(s.files[s.at - 1]) + ": " + gnu.io_error_text(e));
        return (left, Src { ...s, fails: s.fails + 1 });
      }
    }
  }
  return (0 as u64, s);
}

function dump(w0: io_buffered.BufWriter, t: Tables, s: Settings, src0: Src): (io_buffered.BufWriter, Src) {
  let w: io_buffered.BufWriter = w0;
  let h: usize = w.handle();
  let src: Src = src0;
  let fails0: i32 = src.fails;
  let off: u64 = s.skip;
  let left: u64 = s.limit;
  let carry: u8[] = [];
  let have_prev: boolean = false;
  let folded: boolean = false;
  let per_read: i32 = read_size() / s.block * s.block;
  if (per_read < s.block) {
    per_read = s.block;
  }
  while (true) {
    let want: i32 = per_read;
    if (s.limited && left < want as u64) {
      want = left as i32;
    }
    if (want == 0) {
      break;
    }
    let r: (u8[], Src) = src_read(src, want);
    src = r.1;
    let chunk: u8[] = r.0;
    if (chunk.len() == 0) {
      break;
    }
    left = left - chunk.len() as u64;
    let at: i32 = 0;
    while (at + s.block <= chunk.len()) {
      let repeat: boolean = false;
      if (!s.dups && have_prev) {
        if (at >= s.block) {
          repeat = __mismatch_bytes(chunk, at - s.block, chunk, at, s.block) == s.block;
        } else {
          repeat = __mismatch_bytes(chunk, at, carry, 0, s.block) == s.block;
        }
      }
      if (repeat) {
        if (!folded) {
          buf_push(h, "*\n");
          folded = true;
        }
      } else {
        write_block(h, t, s, chunk, at, s.block, off);
        folded = false;
      }
      have_prev = true;
      off = off + s.block as u64;
      at = at + s.block;
    }
    w = gnu.settle(w);
    if (at < chunk.len()) {
      let tail: i32 = chunk.len() - at;
      write_block(h, t, s, pad_block(chunk, at, s.block), 0, tail, off);
      off = off + tail as u64;
      break;
    }
    if (at >= s.block) {
      carry = copy_bytes(chunk, at - s.block, at);
    }
    if (chunk.len() < want) {
      break;
    }
  }
  if ((s.base != radix_none() || s.labelled) && src.opened && (src.fails == fails0 || off != 0 as u64)) {
    push_address(h, t, s, off);
    buf_push_byte(h, 10);
  }
  return (gnu.check(w), src);
}

function pad_block(chunk: u8[], at: i32, n: i32): u8[] {
  let out: u8[] = __alloc_u8(n);
  let i: i32 = 0;
  while (at + i < chunk.len()) {
    out = out.with(i, chunk[at + i]);
    i = i + 1;
  }
  while (i < n) {
    out = out.with(i, 0 as u8);
    i = i + 1;
  }
  return out;
}

function dump_strings(w0: io_buffered.BufWriter, t: Tables, s: Settings, src0: Src): (io_buffered.BufWriter, Src) {
  let w: io_buffered.BufWriter = w0;
  let h: usize = w.handle();
  let src: Src = src0;
  let off: u64 = s.skip;
  let left: u64 = s.limit;
  let start: u64 = off;
  let held: usize = buf_new(256);
  while (true) {
    let want: i32 = read_size();
    if (s.limited && left < want as u64) {
      want = left as i32;
    }
    if (want == 0) {
      break;
    }
    let r: (u8[], Src) = src_read(src, want);
    src = r.1;
    let block: u8[] = r.0;
    if (block.len() == 0) {
      break;
    }
    left = left - block.len() as u64;
    if (buf_len(held) == 0) {
      start = off;
    }
    let from: i32 = 0;
    let i: i32 = 0;
    while (i < block.len()) {
      let c: i32 = block[i] as i32;
      if (c == 0) {
        if ((buf_len(held) + (i - from)) as u64 >= s.min_string) {
          buf_push_bytes_range(held, block, from, i);
          push_run(h, t, s, start, held);
          w = gnu.settle(w);
        }
        drop_held(held);
        from = i + 1;
        start = off + (i + 1) as u64;
      } else if (!is_printable(c)) {
        drop_held(held);
        from = i + 1;
        start = off + (i + 1) as u64;
      }
      i = i + 1;
    }
    if (from < block.len()) {
      buf_push_bytes_range(held, block, from, block.len());
    }
    off = off + block.len() as u64;
  }
  if (s.limited && left == 0 as u64 && buf_len(held) > 0 && buf_len(held) as u64 >= s.min_string) {
    push_run(h, t, s, start, held);
  }
  buf_free(held);
  return (gnu.check(w), src);
}

function push_run(h: usize, t: Tables, s: Settings, at: u64, held: usize): void {
  if (s.base != radix_none() || s.labelled) {
    push_address(h, t, s, at);
    buf_push_byte(h, 32);
  }
  let bytes: u8[] = buf_take_bytes(held);
  buf_push_bytes_range(h, bytes, 0, bytes.len());
  buf_push_byte(h, 10);
}

function drop_held(held: usize): void {
  if (buf_len(held) > 0) {
    let _: u8[] = buf_take_bytes(held);
  }
}

function parse_old_offset(s: string): (u64, boolean) {
  let i: i32 = 0;
  if (i < s.len() && s[i] as i32 == 43) {
    i = i + 1;
  }
  if (i >= s.len() || !gnu.is_digit(s[i] as i32)) {
    return (0 as u64, false);
  }
  let dot: i32 = dot_at(s, i);
  let base: i32 = 8;
  if (dot >= 0) {
    base = 10;
  } else if (s.len() > i + 1 && s[i] as i32 == 48 && (s[i + 1] as i32 == 120 || s[i + 1] as i32 == 88)) {
    base = 16;
    i = i + 2;
  }
  let end: i32 = s.len();
  if (dot >= 0) {
    end = dot;
  }
  let v: u64 = 0 as u64;
  let any: boolean = false;
  let over: boolean = false;
  while (i < end) {
    let d: i32 = hex_value(s[i] as i32);
    if (d < 0 || d >= base) {
      break;
    }
    match (v.checked_mul(base as u64)) {
      Some(m) => {
        v = m + d as u64;
      },
      None => {
        over = true;
      }
    }
    if (v > 9223372036854775807 as u64) {
      over = true;
    }
    any = true;
    i = i + 1;
  }
  if (!any) {
    return (0 as u64, false);
  }
  if (dot >= 0) {
    if (i != end) {
      return (0 as u64, false);
    }
    i = i + 1;
  }
  if (i < s.len()) {
    let mul: u64 = 0 as u64;
    if (s[i] as i32 == 98) {
      mul = 512 as u64;
    } else if (s[i] as i32 == 66) {
      mul = 1024 as u64;
    } else {
      return (0 as u64, false);
    }
    match (v.checked_mul(mul)) {
      Some(m) => {
        v = m;
      },
      None => {
        over = true;
      }
    }
    if (v > 9223372036854775807 as u64) {
      over = true;
    }
    i = i + 1;
  }
  if (i != s.len()) {
    return (0 as u64, false);
  }
  if (over) {
    gnu.error(gnu.quotef(s) + ": " + gnu.erange_text());
    exit(1);
  }
  return (v, true);
}

function dot_at(s: string, from: i32): i32 {
  let i: i32 = from;
  while (i < s.len()) {
    if (s[i] as i32 == 46) {
      let after: i32 = i + 1;
      if (after < s.len() && (s[after] as i32 == 98 || s[after] as i32 == 66)) {
        after = after + 1;
      }
      if (after == s.len()) {
        return i;
      }
      return 0 - 1;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function lcm_of(specs: Spec[]): i32 {
  let l: i32 = 1;
  let i: i32 = 0;
  while (i < specs.len()) {
    l = lcm2(l, specs[i].size);
    i = i + 1;
  }
  return l;
}

function lcm2(a: i32, b: i32): i32 {
  return a / gcd(a, b) * b;
}

function gcd(a: i32, b: i32): i32 {
  let x: i32 = a;
  let y: i32 = b;
  while (y != 0) {
    let t: i32 = x % y;
    x = y;
    y = t;
  }
  return x;
}

function trad_spec(c: i32): Spec {
  if (c == 97) {
    return new_spec(k_named(), 1, false);
  }
  if (c == 98) {
    return new_spec(k_octal(), 1, false);
  }
  if (c == 99) {
    return new_spec(k_char(), 1, false);
  }
  if (c == 100) {
    return new_spec(k_unsigned(), 2, false);
  }
  if (c == 102) {
    return new_spec(k_float(), 4, false);
  }
  if (c == 105) {
    return new_spec(k_signed(), 4, false);
  }
  if (c == 108) {
    return new_spec(k_signed(), 8, false);
  }
  if (c == 111) {
    return new_spec(k_octal(), 2, false);
  }
  if (c == 115) {
    return new_spec(k_signed(), 2, false);
  }
  if (c == 120) {
    return new_spec(k_hex(), 2, false);
  }
  if (c == 66) {
    return new_spec(k_octal(), 2, false);
  }
  if (c == 68) {
    return new_spec(k_unsigned(), 4, false);
  }
  if (c == 101 || c == 70) {
    return new_spec(k_float(), 8, false);
  }
  if (c == 72 || c == 88) {
    return new_spec(k_hex(), 4, false);
  }
  if (c == 73 || c == 76) {
    return new_spec(k_signed(), 8, false);
  }
  if (c == 79) {
    return new_spec(k_octal(), 4, false);
  }
  return new_spec(k_hex(), 2, false);
}

function trad_letters(): string {
  return "abcdfilosxBDeFHILOXh";
}

function declare_options(): gnu.Opt[] {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("j", "skip-bytes", opt_skip()));
  opts = opts.append(gnu.valued("A", "address-radix", opt_radix()));
  opts = opts.append(gnu.valued("N", "read-bytes", opt_read()));
  opts = opts.append(gnu.valued("t", "format", opt_format()));
  opts = opts.append(gnu.flag("v", "output-duplicates", opt_dups()));
  opts = opts.append(gnu.valued_optional_long("S", "strings", opt_strings()));
  opts = opts.append(gnu.flag("", "traditional", opt_traditional()));
  opts = opts.append(gnu.optional("w", "width", opt_width()));
  opts = opts.append(gnu.valued("", "endian", opt_endian()));
  let letters: string = trad_letters();
  let i: i32 = 0;
  while (i < letters.len()) {
    opts = opts.append(gnu.flag(slice_unchecked(letters, i, i + 1) + "", "", trad_base() + letters[i] as i32));
    i = i + 1;
  }
  return opts;
}

pub function main(): i32 {
  let argv: string[] = args();
  let specs: Spec[] = [];
  let base: i32 = 8;
  let skip: u64 = 0 as u64;
  let limit: u64 = 0 as u64;
  let limited: boolean = false;
  let dups: boolean = false;
  let big: boolean = false;
  let strings: boolean = false;
  let min_string: u64 = 3 as u64;
  let width: u64 = 16 as u64;
  let width_given: boolean = false;
  let modern: boolean = false;
  let traditional: boolean = false;
  let type_given: boolean = false;

  let g: gnu.Getopt = gnu.getopt_new(argv, declare_options(), "od", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_skip()) {
          modern = true;
          skip = count_arg(m.value, skip_name(argv));
        } else if (m.id == opt_read()) {
          modern = true;
          limit = count_arg(m.value, read_name(argv));
          limited = true;
        } else if (m.id == opt_radix()) {
          modern = true;
          base = radix_of(m.value);
        } else if (m.id == opt_format()) {
          modern = true;
          type_given = true;
          specs = parse_type(m.value, specs);
        } else if (m.id == opt_dups()) {
          modern = true;
          dups = true;
        } else if (m.id == opt_strings()) {
          modern = true;
          strings = true;
          if (m.has_value) {
            let n: u64 = count_arg(m.value, strings_name(argv));
            if (n >= 9223372036854775807 as u64) {
              gnu.error(strings_name(argv) + " argument " + gnu.quote(m.value) + " too large");
              exit(1);
            }
            min_string = n;
          }
        } else if (m.id == opt_width()) {
          modern = true;
          width_given = true;
          width = 32 as u64;
          if (m.has_value) {
            let w: u64 = count_arg(m.value, width_name(argv));
            if (w > 9223372036854775807 as u64) {
              gnu.error(width_name(argv) + " argument " + gnu.quote(m.value) + " too large");
              exit(1);
            }
            width = w;
          }
        } else if (m.id == opt_endian()) {
          big = endian_of(m.value);
        } else if (m.id == opt_traditional()) {
          traditional = true;
        } else if (m.id >= trad_base()) {
          specs = specs.append(trad_spec(m.id - trad_base()));
        }
      },
      None => {
        break;
      }
    }
  }

  let operands: string[] = g.operands();
  let files: string[] = [];
  let label: u64 = 0 as u64;
  let labelled: boolean = false;
  if (!modern || traditional) {
    let t: (string[], u64, boolean, u64) = old_operands(operands, traditional);
    files = t.0;
    skip = t.1;
    labelled = t.2;
    label = t.3;
  } else {
    files = operands;
  }
  if (files.len() == 0) {
    files = files.append("-");
  }

  if (specs.len() == 0) {
    specs = specs.append(new_spec(k_octal(), 2, false));
  }
  if (strings && type_given) {
    gnu.error("no type may be specified when dumping strings");
    exit(1);
  }
  let block: i32 = block_bytes(specs, width, width_given);
  let wpb: i32 = 0;
  let i: i32 = 0;
  while (i < specs.len()) {
    let w: i32 = (specs[i].fw + 1) * (block / specs[i].size);
    if (w > wpb) {
      wpb = w;
    }
    i = i + 1;
  }
  i = 0;
  while (i < specs.len()) {
    specs = specs.with(i, Spec { ...specs[i], pad: wpb - (specs[i].fw + 1) * (block / specs[i].size) });
    i = i + 1;
  }

  let s: Settings = Settings { specs: specs, base: base, block: block, wpb: wpb, skip: skip, limit: limit, limited: limited, dups: dups, big: big, strings: strings, min_string: min_string, label: label, labelled: labelled };

  let src: Src = src_ensure(src_new(files));
  if (skip > 0 as u64) {
    src = skip_input(src, skip);
  }
  let t: Tables = tables_new();
  let w: io_buffered.BufWriter = gnu.out_with(65536);
  if (strings) {
    let ds: (io_buffered.BufWriter, Src) = dump_strings(w, t, s, src);
    w = ds.0;
    src = ds.1;
  } else {
    let dd: (io_buffered.BufWriter, Src) = dump(w, t, s, src);
    w = dd.0;
    src = dd.1;
  }
  gnu.finish(w);
  if (src.fails > 0) {
    return 1;
  }
  return 0;
}

function block_bytes(specs: Spec[], width: u64, given: boolean): i32 {
  let l: i32 = lcm_of(specs);
  let chosen: u64 = l as u64;
  if (!given) {
    if (l < 16) {
      chosen = (l * (16 / l)) as u64;
    }
  } else if (width % (l as u64) == 0 as u64) {
    chosen = width;
  } else {
    gnu.error("warning: invalid width " + width.to_string() + "; using " + l.to_string() + " instead");
  }
  let i: i32 = 0;
  while (i < specs.len()) {
    if (chosen / (specs[i].size as u64) > 3037000500 as u64) {
      gnu.error(width.to_string() + " is too large");
      exit(1);
    }
    i = i + 1;
  }
  if (chosen > 2147483647 as u64) {
    gnu.error("memory exhausted");
    exit(1);
  }
  return chosen as i32;
}

function radix_of(v: string): i32 {
  let c: i32 = 0;
  if (v.len() > 0) {
    c = v[0] as i32;
  }
  if (c == 100) {
    return 10;
  }
  if (c == 111) {
    return 8;
  }
  if (c == 120) {
    return 16;
  }
  if (c == 110) {
    return radix_none();
  }
  byte_error("invalid output address radix '", c, "'; it must be one character from [doxn]");
  exit(1);
  return 8;
}

function endian_of(v: string): boolean {
  if (v == "big") {
    return true;
  }
  if (v == "little") {
    return false;
  }
  gnu.error("invalid argument " + gnu.quote(v) + " for '--endian'\nValid arguments are:\n  - 'little'\n  - 'big'");
  gnu.try_help(1);
  return false;
}

function option_name(argv: string[], short: string, long: string): string {
  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a.starts_with("--")) {
      if (a.starts_with("--" + long) || long.starts_with(slice_unchecked(a, 2, arg_name_end(a)) + "")) {
        return "--" + long;
      }
    } else if (gnu.is_option(a)) {
      let k: i32 = 1;
      while (k < a.len()) {
        if (a[k] == short[0]) {
          return "-" + short;
        }
        k = k + 1;
      }
    }
    i = i + 1;
  }
  return "-" + short;
}

function arg_name_end(a: string): i32 {
  if let Some(eq) = a.index_of("=") {
    return eq;
  }
  return a.len();
}

function skip_name(argv: string[]): string {
  return option_name(argv, "j", "skip-bytes");
}

function read_name(argv: string[]): string {
  return option_name(argv, "N", "read-bytes");
}

function strings_name(argv: string[]): string {
  return option_name(argv, "S", "strings");
}

function width_name(argv: string[]): string {
  return option_name(argv, "w", "width");
}

function old_operands(operands: string[], traditional: boolean): (string[], u64, boolean, u64) {
  let files: string[] = [];
  let skip: u64 = 0 as u64;
  let label: u64 = 0 as u64;
  let labelled: boolean = false;
  let n: i32 = operands.len();
  if (traditional) {
    if (n == 1) {
      let one: (u64, boolean) = parse_old_offset(operands[0]);
      if (one.1) {
        return (files, one.0, false, 0 as u64);
      }
      files = files.append(operands[0]);
      return (files, 0 as u64, false, 0 as u64);
    }
    if (n == 2) {
      let first: (u64, boolean) = parse_old_offset(operands[0]);
      let second: (u64, boolean) = parse_old_offset(operands[1]);
      if (first.1 && second.1) {
        return (files, first.0, true, second.0);
      }
      if (second.1) {
        files = files.append(operands[0]);
        return (files, second.0, false, 0 as u64);
      }
    } else if (n == 3) {
      let off: (u64, boolean) = parse_old_offset(operands[1]);
      let lab: (u64, boolean) = parse_old_offset(operands[2]);
      if (off.1 && lab.1) {
        files = files.append(operands[0]);
        return (files, off.0, true, lab.0);
      }
    }
    if (n >= 2) {
      gnu.error("extra operand " + gnu.quote(operands[1]));
      gnu.die_usage("compatibility mode supports at most one file", 1);
    }
    return (files, 0 as u64, false, 0 as u64);
  }
  if (n == 1 && operands[0].len() > 0 && operands[0][0] as i32 == 43) {
    let one: (u64, boolean) = parse_old_offset(operands[0]);
    if (one.1) {
      return (files, one.0, false, 0 as u64);
    }
  }
  if (n == 2 && operands[1].len() > 0) {
    let c: i32 = operands[1][0] as i32;
    if (c == 43 || gnu.is_digit(c)) {
      let two: (u64, boolean) = parse_old_offset(operands[1]);
      if (two.1) {
        files = files.append(operands[0]);
        return (files, two.0, false, 0 as u64);
      }
    }
  }
  return (operands, 0 as u64, false, 0 as u64);
}
