// sleep.fern — GNU-compatible `sleep`.
//
//   sleep NUMBER[SUFFIX]...    pause for the SUM of the intervals
//
// A NUMBER is anything strtold reads — decimal, hex float, `inf` — and
// SUFFIX is one of `s` `m` `h` `d`, lowercase only, so `0S` is not an
// interval at all. A negative value is not one either, though `-0` is.
//
// Every operand is checked BEFORE anything is slept: `sleep 1 x` reports
// x and exits without pausing, and `sleep x y` reports both, then the
// one `Try …` line.
//
// GRANULARITY. The interval is summed as a long double and converted to a
// nanosecond count only at the end, rounded UP so the pause is never
// shorter than asked — which is all nanosleep(2) itself guarantees.
import "std/string";
import "std/array";
import "./lib/gnu";
import "./lib/ld";

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " NUMBER[SUFFIX]...\n";
  out = out + "  or:  " + gnu.prog() + " OPTION\n";
  out = out + "Pause for NUMBER seconds.  SUFFIX may be 's' for seconds (the default),\n";
  out = out + "'m' for minutes, 'h' for hours or 'd' for days.  NUMBER need not be an\n";
  out = out + "integer.  Given two or more arguments, pause for the amount of time\n";
  out = out + "specified by the sum of their values.\n";
  out = out + "\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

// The seconds one suffix byte stands for; 0 when it is not a suffix.
function suffix_seconds(b: i32): i64 {
  if (b == 115) {
    return 1 as i64;
  }
  if (b == 109) {
    return 60 as i64;
  }
  if (b == 104) {
    return 3600 as i64;
  }
  if (b == 100) {
    return 86400 as i64;
  }
  return 0 as i64;
}

// `interval(f, s)` — the seconds `s` asks for, or None when it is not an
// interval: unparsable, trailing bytes that are not a single suffix, a
// NaN, or a negative value.
function interval(f: ld.Format, s: string): Option[ld.LD] {
  var r: ld.Parse = f.strtold(s);
  if (r.end == 0) {
    return None;
  }
  var scale: i64 = 1 as i64;
  if (r.end == s.len() - 1) {
    scale = suffix_seconds(s[r.end] as i32);
    if (scale == 0 as i64) {
      return None;
    }
  } else if (r.end != s.len()) {
    return None;
  }
  if (r.v.is_nan()) {
    return None;
  }
  if (r.v.neg && !r.v.is_zero()) {
    return None;
  }
  if (scale == 1 as i64) {
    return Some(r.v);
  }
  return Some(f.mul(r.v, f.from_i64(scale)));
}

// Nanoseconds covering `seconds`, rounded up so the sleep is never
// short. Infinity has no count; the caller loops instead.
function nanos_ceil(f: ld.Format, seconds: ld.LD): Option[i64] {
  if (!seconds.is_finite()) {
    return None;
  }
  var ns: ld.LD = f.mul(seconds, f.from_i64(1000000000 as i64));
  match (f.round_to_int(ns, ld.round_up()).as_i64()) {
    Some(v) => {
      return Some(v);
    },
    None => {
      // Past what a count of nanoseconds can hold — about 292 years —
      // so sleep in steps until the program is killed, as GNU's own
      // nanosleep loop would.
      return None;
    }
  }
}

// Sleep until killed: the interval is infinite, or longer than a count of
// nanoseconds can express.
function sleep_forever(): void {
  var hour_ns: i64 = 3600 as i64 * (1000000000 as i64);
  while (true) {
    sleep_ns(hour_ns);
  }
}

function main(): i32 {
  var argv: string[] = args();
  // The missing operand is judged on argv, not on what the option scan
  // left: `sleep --` has nothing to sleep for and still exits 0.
  if (argv.len() <= 1) {
    gnu.die_usage("missing operand", 1);
  }
  var operands: string[] = gnu.parse_standard_options_only(argv, "sleep", help_text(), 1);
  var f: ld.Format = ld.format();
  var total: ld.LD = f.from_i64(0 as i64);
  var bad: boolean = false;
  var i: i32 = 0;
  while (i < operands.len()) {
    match (interval(f, operands[i])) {
      Some(v) => {
        total = f.add(total, v);
      },
      None => {
        gnu.error("invalid time interval " + gnu.quote(operands[i]));
        bad = true;
      }
    }
    i = i + 1;
  }
  if (bad) {
    gnu.try_help(1);
  }
  match (nanos_ceil(f, total)) {
    Some(ns) => {
      if (ns > 0 as i64) {
        sleep_ns(ns);
      }
    },
    None => {
      sleep_forever();
    }
  }
  return 0;
}
