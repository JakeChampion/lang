import "std/array";
import "std/errno";
import "./lib/gnu";
import "./lib/filetype";
import "./lib/fts";
import "./lib/mode";

function opt_changes(): i32 {
  return 1;
}

function opt_silent(): i32 {
  return 2;
}

function opt_verbose(): i32 {
  return 3;
}

function opt_no_preserve_root(): i32 {
  return 4;
}

function opt_preserve_root(): i32 {
  return 5;
}

function opt_reference(): i32 {
  return 6;
}

function opt_recursive(): i32 {
  return 7;
}

function opt_mode(): i32 {
  return 8;
}

function opt_dereference(): i32 {
  return 9;
}

function opt_no_dereference(): i32 {
  return 10;
}

function opt_comfollow(): i32 {
  return 11;
}

function opt_logical(): i32 {
  return 12;
}

function opt_physical(): i32 {
  return 13;
}

function trav_command_line(): i32 {
  return 0;
}

function trav_logical(): i32 {
  return 1;
}

function trav_physical(): i32 {
  return 2;
}

function deref_unset(): i32 {
  return 0 - 1;
}

function v_quiet(): i32 {
  return 0;
}

function v_changes(): i32 {
  return 1;
}

function v_all(): i32 {
  return 2;
}

struct Settings { verbosity: i32, quiet: boolean, recursive: boolean, preserve_root: boolean, deref: i32, traverse: i32 }

struct Target { changes: mode.Changes, fixed: i32, has_fixed: boolean, mask: i32, from_option: boolean }

struct St { out: gnu.Stdio, status: i32 }

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... MODE[,MODE]... FILE...\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... OCTAL-MODE FILE...\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... --reference=RFILE FILE...\n";
  out = out + "Change the mode of each FILE to MODE.\n";
  out = out + "With --reference, change the mode of each FILE to that of RFILE.\n";
  out = out + "\n";
  out = out + "  -c, --changes          like verbose but report only when a change is made\n";
  out = out + "  -f, --silent, --quiet  suppress most error messages\n";
  out = out + "  -v, --verbose          output a diagnostic for every file processed\n";
  out = out + "      --dereference      affect the referent of each symbolic link,\n";
  out = out + "                         rather than the symbolic link itself\n";
  out = out + "  -h, --no-dereference   affect each symbolic link, rather than the referent\n";
  out = out + "      --no-preserve-root  do not treat '/' specially (the default)\n";
  out = out + "      --preserve-root    fail to operate recursively on '/'\n";
  out = out + "      --reference=RFILE  use RFILE's mode instead of specifying MODE values.\n";
  out = out + "                         RFILE is always dereferenced if a symbolic link.\n";
  out = out + "  -R, --recursive        change files and directories recursively\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "The following options modify how a hierarchy is traversed when the -R\n";
  out = out + "option is also specified.  If more than one is specified, only the final\n";
  out = out + "one takes effect. -H is the default.\n";
  out = out + "\n";
  out = out + "  -H                     if a command line argument is a symlink to a directory,\n";
  out = out + "                           traverse it\n";
  out = out + "  -L                     traverse every symbolic link to a directory encountered\n";
  out = out + "  -P                     do not traverse any symbolic links\n";
  out = out + "\n";
  out = out + "Each MODE is of the form '[ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=][0-7]+'.\n";
  return out;
}

function option_table(): gnu.Opt[] {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("c", "changes", opt_changes()));
  opts = opts.append(gnu.flag("", "dereference", opt_dereference()));
  opts = opts.append(gnu.flag("R", "recursive", opt_recursive()));
  opts = opts.append(gnu.flag("h", "no-dereference", opt_no_dereference()));
  opts = opts.append(gnu.flag("", "no-preserve-root", opt_no_preserve_root()));
  opts = opts.append(gnu.flag("", "preserve-root", opt_preserve_root()));
  opts = opts.append(gnu.flag("f", "quiet", opt_silent()));
  opts = opts.append(gnu.valued("", "reference", opt_reference()));
  opts = opts.append(gnu.flag("", "silent", opt_silent()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));
  opts = opts.append(gnu.flag("H", "", opt_comfollow()));
  opts = opts.append(gnu.flag("L", "", opt_logical()));
  opts = opts.append(gnu.flag("P", "", opt_physical()));
  let i: i32 = 0;
  let letters: string = "rwxXstugoa,+=01234567";
  while (i < letters.len()) {
    opts = opts.append(gnu.optional(slice_unchecked(letters, i, i + 1) + "", "", opt_mode()));
    i = i + 1;
  }
  return opts;
}

struct Parsed { s: Settings, mode: string, has_mode: boolean, reference: string, has_reference: boolean, files: string[] }

function parse(argv: string[]): Parsed {
  let s: Settings = Settings { verbosity: v_quiet(), quiet: false, recursive: false, preserve_root: false, deref: deref_unset(), traverse: trav_command_line() };
  let mode: string = "";
  let has_mode: boolean = false;
  let reference: string = "";
  let has_reference: boolean = false;
  let g: gnu.Getopt = gnu.getopt_new(argv, option_table(), "chmod", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_changes()) {
          s = Settings { ...s, verbosity: v_changes() };
        } else if (m.id == opt_silent()) {
          s = Settings { ...s, quiet: true };
        } else if (m.id == opt_verbose()) {
          s = Settings { ...s, verbosity: v_all() };
        } else if (m.id == opt_no_preserve_root()) {
          s = Settings { ...s, preserve_root: false };
        } else if (m.id == opt_preserve_root()) {
          s = Settings { ...s, preserve_root: true };
        } else if (m.id == opt_reference()) {
          reference = m.value;
          has_reference = true;
        } else if (m.id == opt_recursive()) {
          s = Settings { ...s, recursive: true };
        } else if (m.id == opt_dereference()) {
          s = Settings { ...s, deref: 1 };
        } else if (m.id == opt_no_dereference()) {
          s = Settings { ...s, deref: 0 };
        } else if (m.id == opt_comfollow()) {
          s = Settings { ...s, traverse: trav_command_line() };
        } else if (m.id == opt_logical()) {
          s = Settings { ...s, traverse: trav_logical() };
        } else if (m.id == opt_physical()) {
          s = Settings { ...s, traverse: trav_physical() };
        } else if (m.id == opt_mode()) {
          let token: string = argv[g.index() - 1];
          if (has_mode) {
            mode = mode + "," + token;
          } else {
            mode = token;
          }
          has_mode = true;
        }
      },
      None => {
        break;
      }
    }
  }
  return Parsed { s: s, mode: mode, has_mode: has_mode, reference: reference, has_reference: has_reference, files: g.operands() };
}

function fail_quiet(st: St, s: Settings, msg: string): St {
  if (s.quiet) {
    return St { ...st, status: 1 };
  }
  return St { out: st.out.report(msg), status: 1 };
}

function fail_loud(st: St, msg: string): St {
  return St { out: st.out.report(msg), status: 1 };
}

function say(st: St, s: Settings, line: string): St {
  if (s.verbosity != v_all()) {
    return st;
  }
  return St { ...st, out: st.out.fwrite(line) };
}

function unreachable(st0: St, s: Settings, path: string, msg: string): St {
  let st: St = fail_quiet(st0, s, msg);
  return say(st, s, gnu.quotea(path) + " could not be accessed\n");
}

function is_root_dir(info: FileStat): boolean {
  match (stat("/")) {
    Ok(root) => {
      return info.dev == root.dev && info.ino == root.ino;
    },
    Err(_) => {
      return false;
    }
  }
}

function refuse_root(st0: St, path: string): St {
  let same: string = "";
  if (path != "/") {
    same = " (same as '/')";
  }
  let st: St = fail_loud(st0, "it is dangerous to operate recursively on " + gnu.quotea(path) + same);
  return fail_loud(st, "use --no-preserve-root to override this failsafe");
}

function target_mode(t: Target, old: i32, is_dir: boolean): (i32, i32, boolean) {
  if (t.has_fixed) {
    return (t.fixed, t.fixed, false);
  }
  let masked: mode.Adjusted = t.changes.adjust(old, is_dir, t.mask);
  if (!t.from_option) {
    return (masked.mode, masked.mode, false);
  }
  let naive: mode.Adjusted = t.changes.adjust(old, is_dir, 0);
  return (masked.mode, naive.mode, (masked.mode & mode.complement(naive.mode)) != 0);
}

function change_one(st0: St, s: Settings, t: Target, ent: Ent, info: FileStat, link: Option[FileStat], follows: boolean): St {
  let st: St = st0;
  let path: string = ent.path;
  let on_link: boolean = false;
  match (link) {
    Some(_) => {
      if (!follows) {
        on_link = true;
      }
    },
    None => {}
  }
  let old: i32 = info.mode as i32 & mode.all_bits();
  let is_dir: boolean = filetype.is_dir(info.mode);
  let r: (i32, i32, boolean) = target_mode(t, old, is_dir);
  let wanted: i32 = r.0;
  match (ent_chmod(ent, wanted, !on_link)) {
    Ok(_) => {
      if (s.verbosity == v_all() || s.verbosity == v_changes() && wanted != old) {
        st = St { ...st, out: st.out.fwrite(describe(path, old, wanted)) };
      }
    },
    Err(e) => {
      if (on_link && link_has_no_mode(e)) {
        return say(st, s, "neither symbolic link " + gnu.quotea(path) + " nor referent has been changed\n");
      }
      st = fail_quiet(st, s, "changing permissions of " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
      return say(st, s, "failed to change mode of " + gnu.quotea(path) + " from " + mode.octal4(old) + " (" + mode.symbolic(old) + ") to " + mode.octal4(wanted) + " (" + mode.symbolic(wanted) + ")\n");
    }
  }
  if (r.2) {
    st = fail_loud(st, gnu.quotef(path) + ": new permissions are " + mode.symbolic(wanted) + ", not " + mode.symbolic(r.1));
  }
  return st;
}

function link_has_no_mode(e: IoError): boolean {
  let n: i32 = errno.of(e);
  return n == errno.EOPNOTSUPP || n == errno.ENOSYS;
}

function describe(path: string, old: i32, wanted: i32): string {
  if (old == wanted) {
    return "mode of " + gnu.quotea(path) + " retained as " + mode.octal4(old) + " (" + mode.symbolic(old) + ")\n";
  }
  return "mode of " + gnu.quotea(path) + " changed from " + mode.octal4(old) + " (" + mode.symbolic(old) + ") to " + mode.octal4(wanted) + " (" + mode.symbolic(wanted) + ")\n";
}

struct Ent { path: string, dir: Option[Dir], name: string }

function operand(path: string): Ent {
  return Ent { path: path, dir: None, name: path };
}

function ent_lstat(e: Ent): Result[FileStat, IoError] {
  match (e.dir) {
    Some(d) => {
      return d.lstat(e.name);
    },
    None => {
      return lstat(e.path);
    }
  }
}

function ent_stat(e: Ent): Result[FileStat, IoError] {
  match (e.dir) {
    Some(d) => {
      return d.stat(e.name);
    },
    None => {
      return stat(e.path);
    }
  }
}

function ent_chmod(e: Ent, m: i32, follow: boolean): Result[void, IoError] {
  match (e.dir) {
    Some(d) => {
      return d.chmod(e.name, m, follow);
    },
    None => {
      return chmod_at(e.path, m, follow);
    }
  }
}

function ent_open(e: Ent, via_link: boolean): Result[Dir, IoError] {
  match (e.dir) {
    Some(d) => {
      if (!via_link) {
        return d.open_dir(e.name);
      }
    },
    None => {}
  }
  return open_dir(e.path);
}

function process(st0: St, s: Settings, t: Target, ent: Ent, top: boolean): St {
  let st: St = st0;
  let path: string = ent.path;
  let followed: boolean = s.traverse == trav_logical() || top && s.traverse != trav_physical();
  let lands: boolean = s.deref == 1 || s.deref == deref_unset() && top;
  if (followed) {
    match (ent_stat(ent)) {
      Ok(info) => {
        return visit(st, s, t, ent, info, link_stat(ent), lands, top);
      },
      Err(e) => {
        if (errno.of(e) == errno.ENOENT) {
          match (link_stat(ent)) {
            Some(l) => {
              if (s.deref == 0) {
                return visit(st, s, t, ent, l, Some(l), false, top);
              }
              return unreachable(st, s, path, "cannot operate on dangling symlink " + gnu.quotea(path));
            },
            None => {}
          }
        }
        return unreachable(st, s, path, "cannot access " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
      }
    }
  }
  match (ent_lstat(ent)) {
    Ok(info) => {
      if (!filetype.is_link(info.mode)) {
        return visit(st, s, t, ent, info, None, lands, top);
      }
      if (s.deref == 1) {
        match (ent_stat(ent)) {
          Ok(target) => {
            return visit(st, s, t, ent, target, Some(info), true, top);
          },
          Err(e) => {
            return unreachable(st, s, path, "cannot dereference " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
          }
        }
      }
      return visit(st, s, t, ent, info, Some(info), lands, top);
    },
    Err(e) => {
      return unreachable(st, s, path, "cannot access " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
    }
  }
}

function link_stat(ent: Ent): Option[FileStat] {
  match (ent_lstat(ent)) {
    Ok(info) => {
      if (filetype.is_link(info.mode)) {
        return Some(info);
      }
      return None;
    },
    Err(_) => {
      return None;
    }
  }
}

function visit(st0: St, s: Settings, t: Target, ent: Ent, info: FileStat, link: Option[FileStat], follows: boolean, top: boolean): St {
  let st: St = st0;
  let path: string = ent.path;
  if (top && s.recursive && s.preserve_root && filetype.is_dir(info.mode) && is_root_dir(info)) {
    return refuse_root(st, path);
  }
  st = change_one(st, s, t, ent, info, link, follows);
  if (!s.recursive || !filetype.is_dir(info.mode)) {
    return st;
  }
  let via_link: boolean = false;
  match (link) {
    Some(_) => {
      via_link = true;
    },
    None => {}
  }
  match (ent_open(ent, via_link)) {
    Ok(d) => {
      match (d.entries()) {
        Ok(names) => {
          let i: i32 = 0;
          while (i < names.len()) {
            st = process(st, s, t, Ent { path: fts.child_path(path, names[i]), dir: Some(d), name: names[i] }, false);
            i = i + 1;
          }
        },
        Err(e) => {
          st = unreachable(st, s, path, "cannot read directory " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
        }
      }
      d.close();
    },
    Err(e) => {
      st = unreachable(st, s, path, "cannot read directory " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
    }
  }
  return st;
}

function current_umask(): i32 {
  let mask: i32 = umask(0);
  let back: i32 = umask(mask);
  return mask & mode.all_bits();
}

pub function main(): i32 {
  let p: Parsed = parse(args());
  let s: Settings = p.s;
  if (s.recursive && s.traverse == trav_physical()) {
    if (s.deref == 1) {
      gnu.error("-R --dereference requires either -H or -L");
      exit(1);
    }
    s = Settings { ...s, deref: 0 };
  }
  if (s.deref == deref_unset() && s.traverse == trav_logical()) {
    s = Settings { ...s, deref: 1 };
  }
  let files: string[] = p.files;
  let mode_spec: string = p.mode;
  if (p.has_reference && p.has_mode) {
    gnu.die_usage("cannot combine mode and --reference options", 1);
  }
  if (!p.has_reference && !p.has_mode) {
    if (files.len() == 0) {
      gnu.die_usage("missing operand", 1);
    }
    mode_spec = files[0];
    if (files.len() == 1) {
      gnu.die_usage("missing operand after " + gnu.quote(mode_spec), 1);
    }
    files = array.slice(files, 1, files.len());
  } else if (files.len() == 0) {
    gnu.die_usage("missing operand", 1);
  }
  let st: St = St { out: gnu.stdio_new(), status: 0 };
  let t: Target = Target { changes: mode.Changes { list: [] }, fixed: 0, has_fixed: false, mask: current_umask(), from_option: p.has_mode };
  if (p.has_reference) {
    match (stat(p.reference)) {
      Ok(info) => {
        t = Target { ...t, fixed: info.mode as i32 & mode.all_bits(), has_fixed: true };
      },
      Err(e) => {
        gnu.error("failed to get attributes of " + gnu.quotea(p.reference) + ": " + gnu.io_error_text(e));
        exit(1);
      }
    }
  } else {
    match (mode.compile(mode_spec)) {
      Some(c) => {
        t = Target { ...t, changes: c };
      },
      None => {
        gnu.die_usage("invalid mode: " + gnu.quote(mode_spec), 1);
      }
    }
  }
  let i: i32 = 0;
  while (i < files.len()) {
    st = process(st, s, t, operand(fts.trim(files[i])), true);
    i = i + 1;
  }
  st.out.close_stdout();
  return st.status;
}
