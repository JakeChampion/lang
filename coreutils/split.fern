// split.fern — GNU-compatible `split`.
//
//   split [OPTION]... [FILE [PREFIX]]
//
// Pieces of FILE, written to PREFIXaa, PREFIXab, … — 1000 lines each by
// default, PREFIX `x`. `-` and no operand both mean stdin. The size of a
// piece is chosen four mutually exclusive ways (`cannot split in more
// than one way` when two are given): `-l` lines, `-b` bytes, `-C` whole
// records up to a byte budget, `-n` a chunk count.
//
// Three things here are older or stranger than they look:
//
//   - The suffix is a base-N counter that WIDENS rather than wrapping,
//     and the widening reserves a digit: `xaa` … `xyz`, then `xzaaa` …
//     `xzyzz`, then `xzzaaaa`. The leading `z` is what marks a widened
//     suffix, so it is never a counting digit — which is why `xza` is
//     not a name and 650, not 676, two-letter names exist. `-a N` fixes
//     the width instead, and running out is then
//     `output file suffixes exhausted`.
//   - `-n` sizes the suffix up front from the chunk count (`-n 700`
//     writes `xaaa`), because it knows how many names it needs; `-a`
//     too small for that count is refused rather than widened.
//   - `-n` needs the input's SIZE, and a pipe cannot answer. GNU spools
//     a non-seekable input to `$TMPDIR/cutmpXXXXXX`, opened
//     `O_CREAT|O_EXCL` and unlinked at once, then reads it back; this
//     does the same through `open_exclusive` (#8776). `-n r/…` is the
//     exception — round robin needs no size and streams.
//
// `--filter=COMMAND` makes each piece the stdin of `$SHELL -c COMMAND`
// rather than a file, with the name it would have had in `$FILE`.
import "std/string";
import "std/array";
import "std/i32";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/signals";

// ---- options ---------------------------------------------------------------
// Ids in GNU's DECLARATION order, which is visible: the ambiguity list
// prints candidates in it, so `--s` names '--suffix-length' before
// '--separator' and `--n` '--number' before '--numeric-suffixes'.
function opt_bytes(): i32 {
  return 1;
}

function opt_lines(): i32 {
  return 2;
}

function opt_line_bytes(): i32 {
  return 3;
}

function opt_number(): i32 {
  return 4;
}

function opt_elide(): i32 {
  return 5;
}

function opt_unbuffered(): i32 {
  return 6;
}

function opt_suffix_length(): i32 {
  return 7;
}

function opt_additional(): i32 {
  return 8;
}

function opt_numeric(): i32 {
  return 9;
}

function opt_hex(): i32 {
  return 10;
}

function opt_filter(): i32 {
  return 11;
}

function opt_verbose(): i32 {
  return 12;
}

function opt_separator(): i32 {
  return 13;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE [PREFIX]]\n";
  out = out + "Output pieces of FILE to PREFIXaa, PREFIXab, ...;\n";
  out = out + "default size is 1000 lines, and default PREFIX is 'x'.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -a, --suffix-length=N   generate suffixes of length N (default 2)\n";
  out = out + "      --additional-suffix=SUFFIX  append an additional SUFFIX to file names\n";
  out = out + "  -b, --bytes=SIZE        put SIZE bytes per output file\n";
  out = out + "  -C, --line-bytes=SIZE   put at most SIZE bytes of records per output file\n";
  out = out + "  -d                      use numeric suffixes starting at 0, not alphabetic\n";
  out = out + "      --numeric-suffixes[=FROM]  same as -d, but allow setting the start value\n";
  out = out + "  -x                      use hex suffixes starting at 0, not alphabetic\n";
  out = out + "      --hex-suffixes[=FROM]  same as -x, but allow setting the start value\n";
  out = out + "  -e, --elide-empty-files  do not generate empty output files with '-n'\n";
  out = out + "      --filter=COMMAND    write to shell COMMAND; file name is $FILE\n";
  out = out + "  -l, --lines=NUMBER      put NUMBER lines/records per output file\n";
  out = out + "  -n, --number=CHUNKS     generate CHUNKS output files; see explanation below\n";
  out = out + "  -t, --separator=SEP     use SEP instead of newline as the record separator;\n";
  out = out + "                            '\\0' (zero) specifies the NUL character\n";
  out = out + "  -u, --unbuffered        immediately copy input to output with '-n r/...'\n";
  out = out + "      --verbose           print a diagnostic just before each\n";
  out = out + "                            output file is opened\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "The SIZE argument is an integer and optional unit (example: 10K is 10*1024).\n";
  out = out + "Units are K,M,G,T,P,E,Z,Y,R,Q (powers of 1024) or KB,MB,... (powers of 1000).\n";
  out = out + "Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n";
  out = out + "\n";
  out = out + "CHUNKS may be:\n";
  out = out + "  N       split into N files based on size of input\n";
  out = out + "  K/N     output Kth of N to stdout\n";
  out = out + "  l/N     split into N files without splitting lines/records\n";
  out = out + "  l/K/N   output Kth of N to stdout without splitting lines/records\n";
  out = out + "  r/N     like 'l' but use round robin distribution\n";
  out = out + "  r/K/N   likewise but only output Kth of N to stdout\n";
  return out;
}

// ---- settings --------------------------------------------------------------
// mode: which of the four ways the input is cut.
function mode_none(): i32 {
  return 0;
}

function mode_lines(): i32 {
  return 1;
}

function mode_bytes(): i32 {
  return 2;
}

function mode_line_bytes(): i32 {
  return 3;
}

function mode_chunks(): i32 {
  return 4;
}

// chunk style: how `-n` divides the input.
function style_bytes(): i32 {
  return 0;
}

function style_lines(): i32 {
  return 1;
}

function style_round(): i32 {
  return 2;
}

// `Settings` — everything the option scan decides. `units` is lines,
// bytes or chunks by `mode`; `chunk_k` is 0 unless `-n K/N` asked for one
// chunk on stdout.
struct Settings { mode: i32, units: u64, chunk_k: u64, style: i32, alpha: string, suffix_len: i32, start: u64, have_start: boolean, add_suffix: string, sep: i32, elide: boolean, verbose: boolean, filter: boolean, command: string, sigpipe_default: boolean, prefix: string }

function alpha_alpha(): string {
  return "abcdefghijklmnopqrstuvwxyz";
}

function alpha_decimal(): string {
  return "0123456789";
}

function alpha_hex(): string {
  return "0123456789abcdef";
}

function settings_new(): Settings {
  return Settings { mode: mode_none(), units: 1000 as u64, chunk_k: 0 as u64, style: style_bytes(), alpha: alpha_alpha(), suffix_len: 0, start: 0 as u64, have_start: false, add_suffix: "", sep: 10, elide: false, verbose: false, filter: false, command: "", sigpipe_default: false, prefix: "x" };
}

// One split mode may be chosen; a second is GNU's `cannot split in more
// than one way`, which is a USAGE error (it carries the `Try …` line).
function set_mode(s: Settings, m: i32): Settings {
  if (s.mode != mode_none()) {
    gnu.die_usage("cannot split in more than one way", 1);
  }
  return Settings { ...s, mode: m };
}

// ---- number operands -------------------------------------------------------
// `size_of(value, noun)` — a `-b` / `-C` SIZE: gnulib's multiplier
// suffixes, and a value past uintmax_t saturates rather than failing
// (xstrtoumax hands back UINTMAX_MAX on ERANGE and split takes it). Zero
// is refused. `noun` is the word the diagnostic uses — `-C` says "lines"
// for a byte count, which is GNU's wording, not a slip here.
function size_operand(value: string, noun: string): u64 {
  let r: (u64, i32) = gnu.parse_units(value);
  if (gnu.count_malformed(r.1)) {
    gnu.error("invalid number of " + noun + ": " + gnu.quote(value));
    exit(1);
  }
  let n: u64 = r.0;
  if (gnu.count_overflow(r.1)) {
    n = u64_max();
  }
  if (n == 0 as u64) {
    gnu.error("invalid number of " + noun + ": " + gnu.quote(value));
    exit(1);
  }
  return n;
}

// `-l NUMBER` takes no multiplier suffix (`-l 1K` is invalid), which is
// the one place `-l` and `-b` part.
function lines_operand(value: string): u64 {
  let r: (u64, i32) = gnu.parse_number(value);
  if (gnu.count_malformed(r.1)) {
    gnu.error("invalid number of lines: " + gnu.quote(value));
    exit(1);
  }
  let n: u64 = r.0;
  if (gnu.count_overflow(r.1)) {
    n = u64_max();
  }
  if (n == 0 as u64) {
    gnu.error("invalid number of lines: " + gnu.quote(value));
    exit(1);
  }
  return n;
}

function u64_max(): u64 {
  return 18446744073709551615 as u64;
}

// `-a N`. A negative operand is strtoumax's wrap rather than a parse
// failure, and gnulib reserves ERANGE for a bound the CALLER imposed —
// split imposes none, so a wrap and digits past uintmax_t carry the same
// EOVERFLOW text.
function suffix_length_operand(value: string): i32 {
  let r: (u64, i32) = gnu.parse_number(value);
  if (gnu.count_malformed(r.1)) {
    if (negated_number(value)) {
      gnu.error("invalid suffix length: " + gnu.quote(value) + ": " + gnu.eoverflow_text());
      exit(1);
    }
    gnu.error("invalid suffix length: " + gnu.quote(value));
    exit(1);
  }
  if (gnu.count_overflow(r.1)) {
    gnu.error("invalid suffix length: " + gnu.quote(value) + ": " + gnu.eoverflow_text());
    exit(1);
  }
  if (r.0 > 1000000 as u64) {
    gnu.error("invalid suffix length: " + gnu.quote(value) + ": " + gnu.eoverflow_text());
    exit(1);
  }
  return r.0 as i32;
}

// Blanks, then `-`, then a number and nothing else: what strtoumax reads
// as a negation.
function negated_number(value: string): boolean {
  let i: i32 = 0;
  while (i < value.len() && gnu.is_blank(value[i] as i32)) {
    i = i + 1;
  }
  if (i >= value.len() || value[i] as i32 != 45) {
    return false;
  }
  let rest: string = slice_unchecked(value, i + 1, value.len()) + "";
  let r: (u64, i32) = gnu.parse_number(rest);
  return !gnu.count_malformed(r.1);
}

// `--numeric-suffixes=FROM` / `--hex-suffixes=FROM`. `alpha` names the
// wording: "numerical" for decimal, "hexadecimal" for hex.
function start_operand(value: string, hex: boolean): u64 {
  let word: string = "numerical";
  let base: i32 = 10;
  if (hex) {
    word = "hexadecimal";
    base = 16;
  }
  if (value.len() == 0) {
    return 0 as u64;
  }
  let v: u64 = 0 as u64;
  let i: i32 = 0;
  while (i < value.len()) {
    let d: i32 = digit_value(value[i] as i32, base);
    if (d < 0) {
      gnu.die_usage(gnu.quote(value) + ": invalid start value for " + word + " suffix", 1);
    }
    match (v.checked_mul(base as u64)) {
      Some(m) => {
        match (m.checked_add(d as u64)) {
          Some(a) => {
            v = a;
          },
          None => {
            gnu.die_usage(gnu.quote(value) + ": invalid start value for " + word + " suffix", 1);
          }
        }
      },
      None => {
        gnu.die_usage(gnu.quote(value) + ": invalid start value for " + word + " suffix", 1);
      }
    }
    i = i + 1;
  }
  return v;
}

function digit_value(c: i32, base: i32): i32 {
  let v: i32 = 0 - 1;
  if (c >= 48 && c <= 57) {
    v = c - 48;
  } else if (base == 16 && c >= 97 && c <= 102) {
    // Lower case only: GNU refuses `--hex-suffixes=A`.
    v = c - 87;
  }
  if (v >= base) {
    return 0 - 1;
  }
  return v;
}

// `-t SEP`. One byte, or the two characters `\0` for NUL — the only
// escape the option reads, so `-t '\n'` is a two-character separator and
// refused as one.
function separator_operand(value: string): i32 {
  if (value == "\\0") {
    return 0;
  }
  if (value.len() == 0) {
    gnu.error("empty record separator");
    exit(1);
  }
  if (value.len() > 1) {
    gnu.error("multi-character separator " + gnu.quote(value));
    exit(1);
  }
  return value[0] as i32;
}

// `-n CHUNKS`: `N`, `K/N`, and each with an `l/` or `r/` style prefix.
// The diagnostic names what is left to parse at the point it fails, so
// `-n 2/3/4` reports '3/4' while `-n r/l/3` reports the whole 'l/3'.
function chunk_operand(value: string, s: Settings): Settings {
  let body: string = value;
  let style: i32 = style_bytes();
  if (body.len() >= 2 && body[0] as i32 == 108 && body[1] as i32 == 47) {
    style = style_lines();
    body = slice_unchecked(body, 2, body.len()) + "";
  } else if (body.len() >= 2 && body[0] as i32 == 114 && body[1] as i32 == 47) {
    style = style_round();
    body = slice_unchecked(body, 2, body.len()) + "";
  }
  let slash: i32 = __memchr(body, 47, 0);
  let k: u64 = 0 as u64;
  let n: u64 = 0 as u64;
  if (slash < 0) {
    n = chunk_count(body, body);
  } else {
    let kstr: string = slice_unchecked(body, 0, slash) + "";
    let nstr: string = slice_unchecked(body, slash + 1, body.len()) + "";
    k = chunk_count(kstr, body);
    n = chunk_count(nstr, nstr);
    if (k > n) {
      gnu.error("invalid chunk number: " + gnu.quote(kstr));
      exit(1);
    }
  }
  return Settings { ...set_mode(s, mode_chunks()), units: n, chunk_k: k, style: style };
}

// One number inside a `-n` operand. `blame` is what the diagnostic
// quotes, which is not always what failed to parse.
function chunk_count(value: string, blame: string): u64 {
  let r: (u64, i32) = gnu.parse_number(value);
  if (gnu.count_malformed(r.1)) {
    gnu.error("invalid number of chunks: " + gnu.quote(blame));
    exit(1);
  }
  let n: u64 = r.0;
  if (gnu.count_overflow(r.1)) {
    n = u64_max();
  }
  if (n == 0 as u64) {
    if (blame == value) {
      gnu.error("invalid number of chunks: " + gnu.quote(blame));
    } else {
      gnu.error("invalid chunk number: " + gnu.quote(value));
    }
    exit(1);
  }
  return n;
}

// ---- the suffix counter ----------------------------------------------------
// `Suffix` — the output-name counter. `idx` is one alphabet index per
// position; the first `reserved` of them are pinned at the alphabet's
// LAST character, which is what marks a widened suffix. `auto` widens on
// overflow instead of failing, and is off whenever the width was decided
// rather than defaulted (an explicit `-a`, a `-n` count, a start value).
struct Suffix { alpha: string, idx: i32[], reserved: i32, auto: boolean, done: boolean }

function suffix_new(alpha: string, width: i32, auto: boolean, start: u64): Suffix {
  let idx: i32[] = [];
  let i: i32 = 0;
  while (i < width) {
    idx = idx.append(0);
    i = i + 1;
  }
  let base: u64 = alpha.len() as u64;
  let v: u64 = start;
  let p: i32 = width - 1;
  while (v > 0 as u64) {
    if (p < 0) {
      gnu.die_usage("numerical suffix start value is too large for the suffix length", 1);
    }
    idx = idx.with(p, (v % base) as i32);
    v = v / base;
    p = p - 1;
  }
  return Suffix { alpha: alpha, idx: idx, reserved: 0, auto: auto, done: false };
}

function suffix_name(x: Suffix): string {
  let bs: u8[] = [];
  let i: i32 = 0;
  while (i < x.idx.len()) {
    bs = bs.append(x.alpha[x.idx[i]]);
    i = i + 1;
  }
  return string_from_bytes_unchecked(bs);
}

// The next name, or `done` when the width is fixed and every name in it
// has been used. Widening triggers one position EARLY: the leading
// counting digit reaching the alphabet's last character is what says the
// space is nearly spent, and that character then becomes the reserved
// marker of the wider suffix rather than a name of its own.
function suffix_next(x: Suffix): Suffix {
  let idx: i32[] = x.idx;
  let last: i32 = x.alpha.len() - 1;
  let i: i32 = idx.len() - 1;
  while (i >= x.reserved) {
    let v: i32 = idx[i] + 1;
    if (i == x.reserved && x.auto && v == last) {
      return suffix_widen(x);
    }
    if (v <= last) {
      return Suffix { ...x, idx: idx.with(i, v) };
    }
    idx = idx.with(i, 0);
    i = i - 1;
  }
  return Suffix { ...x, idx: idx, done: true };
}

function suffix_widen(x: Suffix): Suffix {
  let reserved: i32 = x.reserved + 1;
  let width: i32 = x.idx.len() + 2;
  let last: i32 = x.alpha.len() - 1;
  let idx: i32[] = [];
  let i: i32 = 0;
  while (i < width) {
    if (i < reserved) {
      idx = idx.append(last);
    } else {
      idx = idx.append(0);
    }
    i = i + 1;
  }
  return Suffix { ...x, idx: idx, reserved: reserved };
}

// The narrowest suffix that can name `n` files in `base` characters.
function suffix_needed(n: u64, base: i32): i32 {
  let w: i32 = 1;
  let cap: u64 = base as u64;
  while (cap < n) {
    match (cap.checked_mul(base as u64)) {
      Some(m) => {
        cap = m;
      },
      None => {
        return w + 1;
      }
    }
    w = w + 1;
  }
  return w;
}

// ---- the output cursor -----------------------------------------------------
// `Out` — where pieces go: a lazily opened output file (so an empty piece
// costs no file unless one is due), or stdout for `-n K/N`. `w` is the
// buffered file and `so` the buffered stdout, which `--verbose` also
// writes to.
struct Out { s: Settings, sfx: Suffix, w: io_buffered.BufWriter, open: boolean, name: string, so: io_buffered.BufWriter, to_stdout: boolean, pid: i32 }

// Until a piece is open, `w` borrows the stdout buffer as its placeholder.
// This avoids allocating a separate buffer that never receives output.
// `open` guards every use and close of the piece writer.
function out_new(s: Settings, sfx: Suffix, to_stdout: boolean): Out {
  let so: io_buffered.BufWriter = gnu.out_with(65536);
  return Out { s: s, sfx: sfx, w: so, open: false, name: "", so: so, to_stdout: to_stdout, pid: 0 };
}

// The name a piece would take, and the counter moved on. Running out of
// names is fatal — GNU has already written the pieces before it.
function out_name(o: Out): (string, Out) {
  if (o.sfx.done) {
    // gnulib's error() flushes stdout first, so a --verbose line already
    // buffered is not overtaken by the diagnostic.
    gnu.flush(o.so);
    gnu.error("output file suffixes exhausted");
    exit(1);
  }
  let name: string = o.s.prefix + suffix_name(o.sfx) + o.s.add_suffix;
  return (name, Out { ...o, sfx: suffix_next(o.sfx) });
}

// Start the next piece. A piece that is never written to is still a file
// when the caller asks for one (`-n` without `-e`), so opening is
// explicit rather than implied by the first write.
function out_begin(o: Out): Out {
  if (o.to_stdout) {
    return o;
  }
  let closed: Out = out_end(o);
  let r: (string, Out) = out_name(closed);
  let name: string = r.0;
  let next: Out = r.1;
  // Flushed per line rather than at the end: GNU prints the line before
  // the open, so a piece whose open FAILS has still announced itself, and
  // the diagnostic exits without a chance to flush.
  next = out_verbose(next, name);
  let pc: Piece = piece_open(next.s, next.so, name);
  return Out { ...next, w: io_buffered.buf_writer_new(pc.w, 65536), open: true, name: name, pid: pc.pid };
}

function out_put(o: Out, data: u8[]): Out {
  return out_put_range(o, data, 0, data.len());
}

function out_put_range(o: Out, data: u8[], lo: i32, hi: i32): Out {
  if (hi <= lo) {
    return o;
  }
  if (o.to_stdout) {
    return Out { ...o, so: gnu.check(o.so.write_bytes_range(data, lo, hi)) };
  }
  let w: io_buffered.BufWriter = o.w.write_bytes_range(data, lo, hi);
  match (w.error()) {
    Some(e) => {
      write_failed(o.s, o.so, o.name, e);
    },
    None => {}
  }
  return Out { ...o, w: w };
}

function out_end(o: Out): Out {
  if (!o.open) {
    return o;
  }
  match (o.w.close()) {
    Some(e) => {
      write_failed(o.s, o.so, o.name, e);
    },
    None => {}
  }
  piece_wait(o.s, o.so, o.name, o.pid);
  return Out { ...o, open: false, pid: 0 };
}

function out_finish(o: Out): void {
  let done: Out = out_end(o);
  gnu.finish(done.so);
}

// ---- the input -------------------------------------------------------------
// `Src` — the input as a stream of blocks. `mem` is what has already been
// read (the size probe's prefix, or a whole small input); the Reader
// supplies the rest once it is drained.
struct Src { r: Reader, name: string, mem: u8[], pos: i32, eof: boolean }

function copy_bytes(bytes: u8[], lo: i32, hi: i32): u8[] {
  if (lo == 0 && hi == bytes.len()) {
    return bytes;
  }
  let h: usize = buf_new(hi - lo);
  buf_push_bytes_range(h, bytes, lo, hi);
  let out: u8[] = buf_take_bytes(h);
  buf_free(h);
  return out;
}

function join_bytes(left: u8[], right: u8[]): u8[] {
  if (left.len() == 0) {
    return right;
  }
  if (right.len() == 0) {
    return left;
  }
  let h: usize = buf_new(left.len() + right.len());
  buf_push_bytes_range(h, left, 0, left.len());
  buf_push_bytes_range(h, right, 0, right.len());
  let out: u8[] = buf_take_bytes(h);
  buf_free(h);
  return out;
}

function src_new(r: Reader, name: string): Src {
  return Src { r: r, name: name, mem: [], pos: 0, eof: false };
}

function src_mem(r: Reader, name: string, mem: u8[]): Src {
  return Src { r: r, name: name, mem: mem, pos: 0, eof: true };
}

function read_size(): i32 {
  return 65536;
}

// Up to `n` more bytes, or an empty array at end of input. A read failure is GNU's
// `split: NAME: <strerror>` and exit 1 — the same shape whether NAME is
// an operand or the `-` that stands for stdin.
function src_read(s: Src, n: i32): (u8[], Src) {
  if (s.pos < s.mem.len()) {
    let end: i32 = s.pos + n;
    if (end > s.mem.len()) {
      end = s.mem.len();
    }
    let got: u8[] = copy_bytes(s.mem, s.pos, end);
    let rest: Src = Src { ...s, pos: end };
    if (end >= s.mem.len()) {
      rest = Src { ...rest, mem: [], pos: 0 };
    }
    return (got, rest);
  }
  if (s.eof) {
    return ([], s);
  }
  match (s.r.read_chunk_bytes(n)) {
    Ok(chunk) => {
      if (chunk.len() == 0) {
        return ([], Src { ...s, eof: true });
      }
      return (chunk, s);
    },
    Err(e) => {
      gnu.error(s.name + ": " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return ([], s);
}

// ---- the temporary spool ---------------------------------------------------
// gnulib's path_search: $TMPDIR when it names a directory, else /tmp.
// `temp_dir()` cannot serve here — it chooses the directory itself.
function tmp_root(): string {
  match (env("TMPDIR")) {
    Some(d) => {
      if (d.len() > 0) {
        match (stat(d)) {
          Ok(st) => {
            if (st.is_dir) {
              return d;
            }
          },
          Err(_) => {}
        }
      }
    },
    None => {}
  }
  return "/tmp";
}

function temp_name(root: string): string {
  let bs: u8[] = [];
  let letters: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  let i: i32 = 0;
  while (i < 6) {
    let v: i32 = random_i32();
    if (v < 0) {
      v = 0 - v;
    }
    bs = bs.append(letters[v % letters.len()]);
    i = i + 1;
  }
  return root + "/cutmp" + string_from_bytes_unchecked(bs);
}

// `spool(s)` — copy a non-seekable input to an unlinked temporary file
// and hand back a Reader over it plus its size. `open_exclusive` is what
// makes the name safe to choose: a name an attacker planted comes back
// as AlreadyExists and the loop tries another, where `open_writer` would
// truncate their file instead (#8776).
//
// The Reader is opened, and the name removed, before anything is written,
// as GNU's create_temp_file unlinks at creation: the input never exists
// under a name, so a signal mid-spool leaves at most an empty file.
function spool(s: Src, first: u8[]): (Src, i64) {
  let root: string = tmp_root();
  let path: string = "";
  let w: Writer = stdout();
  let tries: i32 = 0;
  while (true) {
    path = temp_name(root);
    match (open_exclusive(path)) {
      Ok(f) => {
        w = f;
        break;
      },
      Err(e) => {
        match (e) {
          AlreadyExists(_) => {
            tries = tries + 1;
            if (tries > 100) {
              gnu.error("cannot create temporary file in " + gnu.quote(root) + ": File exists");
              exit(1);
            }
          },
          _ => {
            gnu.error("cannot create temporary file in " + gnu.quote(root) + ": " + gnu.io_error_text(e));
            exit(1);
          }
        }
      }
    }
  }
  let back: Reader = stdin();
  match (open_reader(path)) {
    Ok(r) => {
      back = r;
    },
    Err(e) => {
      drop_spool(path);
      gnu.error(path + ": " + gnu.io_error_text(e));
      exit(1);
    }
  }
  drop_spool(path);
  let total: i64 = 0 as i64;
  let buf: io_buffered.BufWriter = io_buffered.buf_writer_new(w, 65536);
  let block: u8[] = first;
  let src: Src = s;
  while (block.len() > 0) {
    total = total + block.len() as i64;
    buf = buf.write_bytes(block);
    match (buf.error()) {
      Some(e) => {
        gnu.error(path + ": " + gnu.io_error_text(e));
        exit(1);
      },
      None => {}
    }
    let r: (u8[], Src) = src_read(src, read_size());
    block = r.0;
    src = r.1;
  }
  match (buf.close()) {
    Some(e) => {
      gnu.error(path + ": " + gnu.io_error_text(e));
      exit(1);
    },
    None => {}
  }
  return (src_new(back, s.name), total);
}

// `drop_spool(path)` — best-effort unlink of the spool file's name. The
// open descriptors keep the inode alive until they close.
function drop_spool(path: string): void {
  match (remove_file(path)) {
    Ok(_) => {},
    Err(_) => {}
  }
}

// `sized(s, r)` — the input's byte count, with the input still readable
// from its start. A regular file answers from fstat; anything else is
// read once, and spooled only if it does not end inside the first block
// (which is where GNU's `$TMPDIR/cutmpXXXXXX` comes from).
function sized(s: Src, r: Reader): (Src, i64) {
  match (r.stat()) {
    Ok(st) => {
      if (st.is_file) {
        let at: i64 = 0 as i64;
        match (r.seek(0 as i64, 1)) {
          Ok(p) => {
            at = p;
          },
          Err(_) => {}
        }
        let size: i64 = st.size - at;
        if (size < 0 as i64) {
          size = 0 as i64;
        }
        return (s, size);
      }
    },
    Err(_) => {}
  }
  let head: (u8[], Src) = src_read(s, read_size());
  let first: u8[] = head.0;
  let rest: Src = head.1;
  if (rest.eof) {
    return (src_mem(rest.r, rest.name, first), first.len() as i64);
  }
  return spool(rest, first);
}

// ---- the split modes -------------------------------------------------------
// `-l N`: N records per file. One `__count_byte_bytes` decides a whole block —
// fewer separators in it than are still wanted and it goes out unsplit —
// so only the block that reaches the count is walked.
function split_lines(s: Settings, o: Out, src: Src): Out {
  let out: Out = o;
  let input: Src = src;
  let left: u64 = s.units;
  let started: boolean = false;
  while (true) {
    let r: (u8[], Src) = src_read(input, read_size());
    let block: u8[] = r.0;
    input = r.1;
    if (block.len() == 0) {
      return out;
    }
    let at: i32 = 0;
    let here: u64 = __count_byte_bytes(block, s.sep) as u64;
    while (at < block.len()) {
      if (!started) {
        out = out_begin(out);
        started = true;
      }
      if (here < left) {
        out = out_put_range(out, block, at, block.len());
        left = left - here;
        at = block.len();
      } else {
        let cut: i32 = at;
        let want: u64 = left;
        while (want > 0 as u64) {
          cut = __memchr_bytes(block, s.sep, cut) + 1;
          want = want - 1 as u64;
        }
        out = out_put_range(out, block, at, cut);
        at = cut;
        here = here - left;
        left = s.units;
        started = false;
      }
    }
  }
  return out;
}

// `-b N`: N bytes per file, the last piece short.
function split_bytes(s: Settings, o: Out, src: Src): Out {
  let out: Out = o;
  let input: Src = src;
  let left: u64 = s.units;
  let started: boolean = false;
  while (true) {
    let r: (u8[], Src) = src_read(input, read_size());
    let block: u8[] = r.0;
    input = r.1;
    if (block.len() == 0) {
      return out;
    }
    let at: i32 = 0;
    while (at < block.len()) {
      if (!started) {
        out = out_begin(out);
        started = true;
      }
      let have: u64 = (block.len() - at) as u64;
      if (have < left) {
        if (at == 0) {
          out = out_put(out, block);
        } else {
          out = out_put_range(out, block, at, block.len());
        }
        left = left - have;
        at = block.len();
      } else {
        let take: i32 = left as i32;
        out = out_put_range(out, block, at, at + take);
        at = at + take;
        left = s.units;
        started = false;
      }
    }
  }
  return out;
}

// `-C N`: whole records, up to N bytes per file. The last separator
// inside the remaining budget is found with one `__rmemchr_bytes`, so a file is
// filled in one write rather than one per record; a record longer than N
// on its own is cut at exactly N, which is the only way a `-C` piece ends
// mid-record.
function split_line_bytes(s: Settings, o: Out, src: Src): Out {
  let out: Out = o;
  let input: Src = src;
  let buf: u8[] = [];
  let used: u64 = 0 as u64;
  let started: boolean = false;
  let eof: boolean = false;
  while (true) {
    let avail: u64 = s.units - used;
    let hi: i32 = buf.len();
    if (avail < hi as u64) {
      hi = avail as i32;
    }
    // The last record that ends inside what is left of this file's
    // budget: everything up to it goes out in one write. Scanning BEFORE
    // reading more is what keeps the buffer one record long instead of
    // `-C SIZE` long — with `-C 8M` the other order copies a growing
    // 8 MiB buffer once per read.
    let j: i32 = __rmemchr_bytes(buf, s.sep, hi - 1);
    if (j >= 0) {
      if (!started) {
        out = out_begin(out);
        started = true;
      }
      out = out_put_range(out, buf, 0, j + 1);
      buf = copy_bytes(buf, j + 1, buf.len());
      used = used + (j + 1) as u64;
      if (used >= s.units) {
        used = 0 as u64;
        started = false;
      }
      continue;
    }
    if (!eof && buf.len() as u64 < avail) {
      // A partial record can span many reads. Accumulate it in one builder
      // and inspect only newly read bytes, rather than recopying and rescanning
      // the entire prefix on every read.
      if (buf.len() > 0) {
        let more: (u8[], Src, boolean) = extend_record(input, buf, avail, s.sep);
        buf = more.0;
        input = more.1;
        eof = more.2;
        continue;
      }
      let want: i32 = read_size();
      if (avail - buf.len() as u64 < want as u64) {
        want = (avail - buf.len() as u64) as i32;
      }
      let r: (u8[], Src) = src_read(input, want);
      input = r.1;
      if (r.0.len() == 0) {
        eof = true;
      } else {
        buf = r.0;
      }
      continue;
    }
    if (buf.len() == 0) {
      return out;
    }
    if (eof && buf.len() as u64 <= avail) {
      // The tail is a final unterminated record that fits.
      if (!started) {
        out = out_begin(out);
        started = true;
      }
      out = out_put(out, buf);
      return out;
    }
    // No record ends inside the budget: start a new file if this one has
    // anything in it, else cut the over-long record at exactly SIZE.
    if (used > 0 as u64) {
      used = 0 as u64;
      started = false;
      continue;
    }
    if (!started) {
      out = out_begin(out);
      started = true;
    }
    out = out_put_range(out, buf, 0, hi);
    buf = copy_bytes(buf, hi, buf.len());
    used = 0 as u64;
    started = false;
  }
  return out;
}

// Extend a separator-free prefix until a record ends, the byte budget is
// exhausted, or input ends. The builder grows geometrically for long records.
function extend_record(src: Src, prefix: u8[], budget: u64, sep: i32): (u8[], Src, boolean) {
  let input: Src = src;
  let h: usize = buf_new(prefix.len());
  buf_push_bytes_range(h, prefix, 0, prefix.len());
  let eof: boolean = false;
  while (buf_len(h) as u64 < budget) {
    let left: u64 = budget - buf_len(h) as u64;
    let want: i32 = read_size();
    if (left < want as u64) {
      want = left as i32;
    }
    let r: (u8[], Src) = src_read(input, want);
    input = r.1;
    if (r.0.len() == 0) {
      eof = true;
      break;
    }
    buf_push_bytes_range(h, r.0, 0, r.0.len());
    if (__memchr_bytes(r.0, sep, 0) >= 0) {
      break;
    }
  }
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  return (bytes, input, eof);
}

// ---- `-n` ------------------------------------------------------------------
// The end offset of chunk `k` of `n` over `size` bytes: every chunk gets
// `size / n`, and the first `size % n` of them one byte more. Not
// `k * size / n`, which distributes the remainder differently and puts
// the short chunk in the wrong place.
function chunk_end(k: u64, n: u64, size: u64): u64 {
  let each: u64 = size / n;
  let extra: u64 = size % n;
  let bonus: u64 = k;
  if (bonus > extra) {
    bonus = extra;
  }
  return k * each + bonus;
}

// `-n N` and `-n K/N`: chunks by byte count.
function split_chunk_bytes(s: Settings, o: Out, src: Src, size: i64): Out {
  let out: Out = o;
  let input: Src = src;
  let total: u64 = size as u64;
  let pos: u64 = 0 as u64;
  let k: u64 = 1 as u64;
  while (k <= s.units) {
    let end: u64 = chunk_end(k, s.units, total);
    let want: u64 = end - pos;
    let wanted: boolean = s.chunk_k == 0 as u64 || s.chunk_k == k;
    if (wanted && (want > 0 as u64 || !s.elide)) {
      out = out_begin(out);
    }
    while (want > 0 as u64) {
      let n: i32 = read_size();
      if (want < n as u64) {
        n = want as i32;
      }
      let r: (u8[], Src) = src_read(input, n);
      input = r.1;
      if (r.0.len() == 0) {
        want = 0 as u64;
      } else {
        if (wanted) {
          out = out_put(out, r.0);
        }
        want = want - r.0.len() as u64;
      }
    }
    pos = end;
    k = k + 1 as u64;
  }
  return out_end(out);
}

// `-n l/N` and `-n l/K/N`: chunks that never cut a record. A chunk runs
// to the first record boundary at or after its byte end, so the bytes
// before that end need no scanning at all — one `__memchr_bytes` per chunk
// finds the boundary.
//
// GNU asserts `n <= file_size` here and, with the assertion compiled out,
// keeps opening pieces past N when it does not hold AND the input ends on
// a record boundary — until the suffixes run out. An input whose last
// record is unterminated, an empty one, and the `K/N` form (a different
// extraction path) all stop where they should. That is reproduced rather
// than corrected: it is what the reference does with the same argv.
function split_chunk_lines(s: Settings, o: Out, src: Src, size: i64): Out {
  let out: Out = o;
  let input: Src = src;
  let total: u64 = size as u64;
  let pos: u64 = 0 as u64;
  let k: u64 = 1 as u64;
  // Whether the byte before `pos` ended a record. A chunk stops at the
  // first boundary at or after its byte end, so one that lands exactly on
  // a boundary takes nothing more. `ends_sep` is the same question about
  // the last byte CONSUMED, which is what decides whether the piece loop
  // runs away past N.
  let at_boundary: boolean = true;
  let ends_sep: boolean = false;
  while (true) {
    let end: u64 = chunk_end(k, s.units, total);
    if (end < pos) {
      end = pos;
    }
    let wanted: boolean = s.chunk_k == 0 as u64 || s.chunk_k == k;
    let opened: boolean = false;
    if (wanted && !s.elide) {
      out = out_begin(out);
      opened = true;
    }
    // Everything before the chunk's byte end belongs to it whatever is
    // in it; only from there on does a record boundary have to be found.
    while (pos < end) {
      let n: i32 = read_size();
      if (end - pos < n as u64) {
        n = (end - pos) as i32;
      }
      let r: (u8[], Src) = src_read(input, n);
      input = r.1;
      if (r.0.len() == 0) {
        pos = end;
        break;
      }
      if (wanted) {
        if (!opened) {
          out = out_begin(out);
          opened = true;
        }
        out = out_put(out, r.0);
      }
      at_boundary = r.0[r.0.len() - 1] as i32 == s.sep;
      ends_sep = at_boundary;
      pos = pos + r.0.len() as u64;
    }
    // Then the tail of the record the byte end landed inside.
    while (!at_boundary && pos < total) {
      let rr: (u8[], Src) = src_read(input, read_size());
      input = rr.1;
      let block: u8[] = rr.0;
      if (block.len() == 0) {
        pos = total;
        at_boundary = true;
      } else {
        let j: i32 = __memchr_bytes(block, s.sep, 0);
        let take: i32 = block.len();
        if (j >= 0) {
          take = j + 1;
          at_boundary = true;
        }
        if (wanted) {
          if (!opened) {
            out = out_begin(out);
            opened = true;
          }
          out = out_put_range(out, block, 0, take);
        }
        ends_sep = block[take - 1] as i32 == s.sep;
        pos = pos + take as u64;
        if (take < block.len()) {
          input = src_pushback(input, copy_bytes(block, take, block.len()));
        }
      }
    }
    if (k >= s.units) {
      let runaway: boolean = s.chunk_k == 0 as u64 && s.units > total && total > 0 as u64 && ends_sep;
      if (!runaway) {
        break;
      }
    }
    k = k + 1 as u64;
  }
  return out_end(out);
}

// Give back bytes read past a record boundary, so the next chunk sees
// them. The block a `read_chunk_bytes` hands over is the only place they can
// live; `mem` is empty here because the scan drained it first.
function src_pushback(s: Src, rest: u8[]): Src {
  if (s.pos < s.mem.len()) {
    return Src { ...s, mem: join_bytes(rest, copy_bytes(s.mem, s.pos, s.mem.len())), pos: 0 };
  }
  return Src { ...s, mem: rest, pos: 0 };
}

// `-n r/N` and `-n r/K/N`: records dealt round robin. No size is needed
// — record i goes to file i mod N — so this is the one `-n` form that
// streams a pipe without spooling it.
//
// Find complete record ends once per block, then collect each output's
// ranges in a reusable builder for one write. An unfinished record goes to
// its current output immediately, without advancing the slot. One shared
// builder collects each batch instead of keeping a buffer per output file.
function split_round(s: Settings, o: Out, src: Src): Out {
  let out: Out = o;
  let input: Src = src;
  if (s.chunk_k != 0 as u64) {
    return split_round_one(s, out, input);
  }
  // Every file exists up front unless -e says an unused one should not,
  // which is also the order GNU opens them in.
  let ws: Writer[] = [];
  let pids: i32[] = [];
  let names: string[] = [];
  let live: boolean[] = [];
  let i: u64 = 0 as u64;
  while (i < s.units) {
    let r: (string, Out) = out_name(out);
    let name: string = r.0;
    out = r.1;
    names = names.append(name);
    if (s.elide) {
      ws = ws.append(stdout());
      pids = pids.append(0);
      live = live.append(false);
    } else {
      out = out_verbose(out, name);
      let pc: Piece = piece_open(s, out.so, name);
      ws = ws.append(pc.w);
      pids = pids.append(pc.pid);
      live = live.append(true);
    }
    i = i + 1 as u64;
  }
  let n: i32 = names.len();
  let slot: i32 = 0;
  let share_buf: usize = buf_new(round_block());
  while (true) {
    let rd: (u8[], Src) = src_read(input, round_block());
    input = rd.1;
    let buf: u8[] = rd.0;
    if (buf.len() == 0) {
      break;
    }
    // Include the trailing fragment in writes, but advance the slot only
    // for completed records. The next block may continue that fragment.
    let ends: i32[] = [];
    let at: i32 = 0;
    while (at < buf.len()) {
      let j: i32 = __memchr_bytes(buf, s.sep, at);
      if (j < 0) {
        break;
      }
      ends = ends.append(j + 1);
      at = j + 1;
    }
    let completed: i32 = ends.len();
    if (at < buf.len()) {
      ends = ends.append(buf.len());
    }
    let k: i32 = 0;
    while (k < n && k < ends.len()) {
      let e: i32 = k;
      while (e < ends.len()) {
        let from: i32 = 0;
        if (e > 0) {
          from = ends[e - 1];
        }
        buf_push_bytes_range(share_buf, buf, from, ends[e]);
        e = e + n;
      }
      let share: u8[] = buf_take_bytes(share_buf);
      let target: i32 = (slot + k) % n;
      if (!live[target]) {
        out = out_verbose(out, names[target]);
        let pc: Piece = piece_open(s, out.so, names[target]);
        ws = ws.with(target, pc.w);
        pids = pids.with(target, pc.pid);
        live = live.with(target, true);
      }
      write_fd(s, out.so, ws[target], names[target], share);
      k = k + 1;
    }
    slot = (slot + completed) % n;
  }
  buf_free(share_buf);
  let c: i32 = 0;
  while (c < n) {
    if (live[c]) {
      match (ws[c].close()) {
        Some(e) => {
          write_failed(s, out.so, names[c], e);
        },
        None => {}
      }
      piece_wait(s, out.so, names[c], pids[c]);
    }
    c = c + 1;
  }
  return out;
}

// The read block for round robin: bigger than the streaming one, so each
// output file's share of a block is still a write worth making.
function round_block(): i32 {
  return 262144;
}

// `-n r/K/N`: only the Kth share, on stdout.
function split_round_one(s: Settings, o: Out, src: Src): Out {
  let out: Out = o;
  let input: Src = src;
  let slot: u64 = 1 as u64;
  while (true) {
    let rd: (u8[], Src) = src_read(input, read_size());
    input = rd.1;
    let buf: u8[] = rd.0;
    if (buf.len() == 0) {
      break;
    }
    let at: i32 = 0;
    while (at < buf.len()) {
      let j: i32 = __memchr_bytes(buf, s.sep, at);
      if (j < 0) {
        break;
      }
      if (slot == s.chunk_k) {
        out = out_put_range(out, buf, at, j + 1);
      }
      at = j + 1;
      slot = slot + 1 as u64;
      if (slot > s.units) {
        slot = 1 as u64;
      }
    }
    if (at < buf.len() && slot == s.chunk_k) {
      out = out_put_range(out, buf, at, buf.len());
    }
  }
  return out;
}

function out_verbose(o: Out, name: string): Out {
  if (!o.s.verbose) {
    return o;
  }
  let line: string = "creating file " + gnu.quote(name);
  if (o.s.filter) {
    line = "executing with FILE=" + gnu.quotef(name);
  }
  let so: io_buffered.BufWriter = gnu.put(o.so, line + "\n");
  // A filter's output shares stdout, so the line is buffered the way GNU's
  // stdio buffers it: line by line only on a terminal.
  if (o.s.filter && !isatty(1)) {
    return Out { ...o, so: so };
  }
  return Out { ...o, so: gnu.flush(so) };
}

function open_out(name: string): Writer {
  match (open_writer(name)) {
    Ok(f) => {
      return f;
    },
    Err(e) => {
      gnu.error(name + ": " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return stdout();
}

function write_fd(s: Settings, so: io_buffered.BufWriter, w: Writer, name: string, data: u8[]): void {
  if (data.len() == 0) {
    return;
  }
  match (w.write_bytes(data)) {
    Some(e) => {
      write_failed(s, so, name, e);
    },
    None => {}
  }
}

// A failed write or close ends the program, except a filter that stopped
// reading: the rest of its piece is dropped, as GNU's `ignorable` does.
function write_failed(s: Settings, so: io_buffered.BufWriter, name: string, e: IoError): void {
  if (s.filter && gnu.is_broken_pipe(e)) {
    return;
  }
  fail(so, name + ": " + gnu.io_error_text(e), 1);
}

// gnulib's error() flushes stdout first, so a --verbose line still buffered
// is not overtaken by the diagnostic.
function fail(so: io_buffered.BufWriter, msg: string, status: i32): void {
  gnu.flush(so);
  gnu.error(msg);
  exit(status);
}

// ---- filters ---------------------------------------------------------------
// With --filter a piece is the stdin of `$SHELL -c COMMAND` (/bin/sh when
// SHELL is unset), started when the piece is and reaped when it is closed.
// `pid` is 0 for a plain output file.
struct Piece { w: Writer, pid: i32 }

function sig_pipe(): i32 {
  return 13;
}

function piece_open(s: Settings, so: io_buffered.BufWriter, name: string): Piece {
  if (!s.filter) {
    return Piece { w: open_out(name), pid: 0 };
  }
  // No wasi world has a process to start; the arm the target does not take
  // is pruned before the capability gate, so the spawn compiles elsewhere.
  if (target_os() == "wasi") {
    fail(so, "--filter is not supported on this system", 1);
    return Piece { w: stdout(), pid: 0 };
  } else {
    return spawn_filter(s, so, name);
  }
}

function spawn_filter(s: Settings, so: io_buffered.BufWriter, name: string): Piece {
  let envp: string[] = with_file(environ(), name);
  let shell: (string, boolean) = gnu.env_value(envp, "SHELL");
  let prog: string = "/bin/sh";
  if (shell.1) {
    prog = shell.0;
  }
  let p: Pipe = open_pipe(so);
  // GNU spawns with posix_spawn, which reports a failed exec to the parent
  // rather than as the child's status. A close-on-exec pipe carries the errno
  // back the same way: it reads EOF when the exec succeeds.
  let ep: Pipe = open_pipe(so);
  let pid: i32 = proc_fork();
  if (pid == 0) {
    p.r.dup_onto(0);
    if (s.sigpipe_default) {
      signal_default(sig_pipe());
    }
    let rc: i32 = proc_exec_as(prog, [gnu.base_name(prog), "-c", s.command], envp);
    ep.w.write((0 - rc).to_string());
    exit(127);
  }
  if (pid < 0) {
    fail(so, "fork system call failed: " + gnu.exec_errno_text(0 - pid), 1);
  }
  p.r.close();
  ep.w.close();
  let errno: i32 = exec_errno(ep.r);
  ep.r.close();
  if (errno != 0) {
    proc_waitpid_status(pid);
    fail(so, "failed to run command: \"" + prog + " -c " + s.command + "\": " + gnu.exec_errno_text(errno), 1);
  }
  return Piece { w: p.w, pid: pid };
}

function open_pipe(so: io_buffered.BufWriter): Pipe {
  match (pipe()) {
    Ok(p) => {
      return p;
    },
    Err(e) => {
      fail(so, "failed to create pipe: " + gnu.io_error_text(e), 1);
    }
  }
  return open_pipe(so);
}

// The errno a child wrote before its exec failed, or 0 at EOF.
function exec_errno(r: Reader): i32 {
  let text: string = "";
  match (r.read_chunk(16)) {
    Ok(chunk) => {
      text = chunk;
    },
    Err(_) => {}
  }
  let n: i32 = 0;
  let i: i32 = 0;
  while (i < text.len()) {
    n = n * 10 + (text[i] as i32 - 48);
    i = i + 1;
  }
  return n;
}

// `envp` with FILE set to `name`, replacing any FILE already there.
function with_file(envp: string[], name: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < envp.len()) {
    if (!envp[i].starts_with("FILE=")) {
      out = out.append(envp[i]);
    }
    i = i + 1;
  }
  return out.append("FILE=" + name);
}

// Reap a piece's filter. A non-zero exit ends split with that status, and
// a signal other than SIGPIPE with 128 + its number, as GNU's closeout does.
function piece_wait(s: Settings, so: io_buffered.BufWriter, name: string, pid: i32): void {
  if (pid <= 0) {
    return;
  }
  if (target_os() != "wasi") {
    reap(s, so, name, pid);
  }
}

function reap(s: Settings, so: io_buffered.BufWriter, name: string, pid: i32): void {
  let st: i32 = proc_waitpid_status(pid);
  if (st < 0) {
    fail(so, "waiting for child process: " + gnu.exec_errno_text(0 - st), 1);
  }
  let sig: i32 = st & 127;
  if (sig != 0 && sig != sig_pipe()) {
    let signame: string = signals.name(sig);
    if (signame == "") {
      signame = sig.to_string();
    }
    fail(so, "with FILE=" + gnu.quotef(name) + ", signal " + signame + " from command: " + s.command, 128 + sig);
  }
  let code: i32 = st >> 8 & 255;
  if (sig == 0 && code != 0) {
    fail(so, "with FILE=" + gnu.quotef(name) + ", exit " + code.to_string() + " from command: " + s.command, code);
  }
}

// ---- main ------------------------------------------------------------------
function declare_options(): gnu.Opt[] {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("b", "bytes", opt_bytes()));
  opts = opts.append(gnu.valued("l", "lines", opt_lines()));
  opts = opts.append(gnu.valued("C", "line-bytes", opt_line_bytes()));
  opts = opts.append(gnu.valued("n", "number", opt_number()));
  opts = opts.append(gnu.flag("e", "elide-empty-files", opt_elide()));
  // -u says WHEN `-n r/…` copies, not what it copies, so nothing reads
  // its id back: the option is declared for the scan and does nothing.
  opts = opts.append(gnu.flag("u", "unbuffered", opt_unbuffered()));
  opts = opts.append(gnu.valued("a", "suffix-length", opt_suffix_length()));
  opts = opts.append(gnu.valued("", "additional-suffix", opt_additional()));
  opts = opts.append(gnu.optional_long("d", "numeric-suffixes", opt_numeric()));
  opts = opts.append(gnu.optional_long("x", "hex-suffixes", opt_hex()));
  opts = opts.append(gnu.valued("", "filter", opt_filter()));
  opts = opts.append(gnu.flag("", "verbose", opt_verbose()));
  opts = opts.append(gnu.valued("t", "separator", opt_separator()));
  return opts;
}

function scan(argv: string[]): (Settings, string[]) {
  let s: Settings = settings_new();
  let have_sep: boolean = false;
  let g: gnu.Getopt = gnu.getopt_new(argv, declare_options(), "split", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_bytes()) {
          s = Settings { ...set_mode(s, mode_bytes()), units: size_operand(m.value, "bytes") };
        } else if (m.id == opt_lines()) {
          s = Settings { ...set_mode(s, mode_lines()), units: lines_operand(m.value) };
        } else if (m.id == opt_line_bytes()) {
          s = Settings { ...set_mode(s, mode_line_bytes()), units: size_operand(m.value, "lines") };
        } else if (m.id == opt_number()) {
          s = chunk_operand(m.value, s);
        } else if (m.id == opt_elide()) {
          s = Settings { ...s, elide: true };
        } else if (m.id == opt_suffix_length()) {
          s = Settings { ...s, suffix_len: suffix_length_operand(m.value) };
        } else if (m.id == opt_additional()) {
          if (__memchr(m.value, 47, 0) >= 0) {
            gnu.die_usage("invalid suffix " + gnu.quote(m.value) + ", contains directory separator", 1);
          }
          s = Settings { ...s, add_suffix: m.value };
        } else if (m.id == opt_numeric()) {
          s = Settings { ...s, alpha: alpha_decimal(), start: 0 as u64, have_start: false };
          if (m.has_value) {
            s = Settings { ...s, start: start_operand(m.value, false), have_start: true };
          }
        } else if (m.id == opt_hex()) {
          s = Settings { ...s, alpha: alpha_hex(), start: 0 as u64, have_start: false };
          if (m.has_value) {
            s = Settings { ...s, start: start_operand(m.value, true), have_start: true };
          }
        } else if (m.id == opt_filter()) {
          s = Settings { ...s, filter: true, command: m.value };
        } else if (m.id == opt_verbose()) {
          s = Settings { ...s, verbose: true };
        } else if (m.id == opt_separator()) {
          let sep: i32 = separator_operand(m.value);
          if (have_sep && sep != s.sep) {
            gnu.error("multiple separator characters specified");
            exit(1);
          }
          have_sep = true;
          s = Settings { ...s, sep: sep };
        }
      },
      None => {
        break;
      }
    }
  }
  return (s, g.operands());
}

// The suffix width: 2 and widening on overflow unless something fixed
// it — an explicit `-a`, a start value, or a `-n` count that says how
// many names are needed. `-a` too small for that count is refused; GNU
// will not widen a width it was given.
function make_suffix(s: Settings): Suffix {
  let width: i32 = 2;
  let auto: boolean = true;
  if (s.suffix_len > 0) {
    width = s.suffix_len;
    auto = false;
  }
  if (s.mode == mode_chunks()) {
    let needed: i32 = suffix_needed(s.units, s.alpha.len());
    if (s.suffix_len > 0 && s.suffix_len < needed) {
      gnu.error("the suffix length needs to be at least " + needed.to_string());
      exit(1);
    }
    if (width < needed) {
      width = needed;
    }
    auto = false;
  }
  if (s.have_start) {
    auto = false;
  }
  return suffix_new(s.alpha, width, auto, s.start);
}

function open_input(path: string): Reader {
  if (path == "-") {
    return stdin();
  }
  match (open_reader(path)) {
    Ok(r) => {
      return r;
    },
    Err(e) => {
      gnu.error("cannot open " + gnu.quote(path) + " for reading: " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return stdin();
}

pub function main(): i32 {
  let argv: string[] = args();
  let r: (Settings, string[]) = scan(argv);
  let s: Settings = r.0;
  let operands: string[] = r.1;
  if (operands.len() > 2) {
    gnu.die_usage("extra operand " + gnu.quote(operands[2]), 1);
  }
  let path: string = "-";
  if (operands.len() >= 1) {
    path = operands[0];
  }
  if (operands.len() >= 2) {
    s = Settings { ...s, prefix: operands[1] };
  }
  if (s.mode == mode_none()) {
    s = Settings { ...s, mode: mode_lines(), units: 1000 as u64 };
  }
  if (s.filter && s.mode == mode_chunks() && s.chunk_k != 0 as u64) {
    gnu.die_usage("--filter does not process a chunk extracted to standard output", 1);
  }
  if (s.filter) {
    s = Settings { ...s, sigpipe_default: signal_disposition(sig_pipe()) == 0 };
    signal_ignore(sig_pipe());
  }

  let reader: Reader = open_input(path);
  let name: string = path;
  let src: Src = src_new(reader, name);
  let to_stdout: boolean = s.mode == mode_chunks() && s.chunk_k != 0 as u64;
  let out: Out = out_new(s, make_suffix(s), to_stdout);

  if (s.mode == mode_lines()) {
    out = split_lines(s, out, src);
  } else if (s.mode == mode_bytes()) {
    out = split_bytes(s, out, src);
  } else if (s.mode == mode_line_bytes()) {
    out = split_line_bytes(s, out, src);
  } else if (s.style == style_round()) {
    out = split_round(s, out, src);
  } else {
    let sz: (Src, i64) = sized(src, reader);
    if (s.style == style_lines()) {
      out = split_chunk_lines(s, out, sz.0, sz.1);
    } else {
      out = split_chunk_bytes(s, out, sz.0, sz.1);
    }
  }
  out_finish(out);
  if (path != "-") {
    reader.close();
  }
  return 0;
}
