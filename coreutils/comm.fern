import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";

function opt_only1(): i32 {
  return 1;
}

function opt_only2(): i32 {
  return 2;
}

function opt_both(): i32 {
  return 3;
}

function opt_check(): i32 {
  return 4;
}

function opt_nocheck(): i32 {
  return 5;
}

function opt_delim(): i32 {
  return 6;
}

function opt_total(): i32 {
  return 7;
}

function opt_zero(): i32 {
  return 8;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... FILE1 FILE2\n";
  out = out + "Compare sorted files FILE1 and FILE2 line by line.\n";
  out = out + "\n";
  out = out + "When FILE1 or FILE2 (not both) is -, read standard input.\n";
  out = out + "\n";
  out = out + "With no options, produce three-column output.  Column one contains\n";
  out = out + "lines unique to FILE1, column two contains lines unique to FILE2,\n";
  out = out + "and column three contains lines common to both files.\n";
  out = out + "\n";
  out = out + "  -1                      suppress column 1 (lines unique to FILE1)\n";
  out = out + "  -2                      suppress column 2 (lines unique to FILE2)\n";
  out = out + "  -3                      suppress column 3 (lines that appear in both files)\n";
  out = out + "\n";
  out = out + "  --check-order           check that the input is correctly sorted, even\n";
  out = out + "                            if all input lines are pairable\n";
  out = out + "  --nocheck-order         do not check that the input is correctly sorted\n";
  out = out + "  --output-delimiter=STR  separate columns with STR\n";
  out = out + "  --total                 output a summary\n";
  out = out + "  -z, --zero-terminated   line delimiter is NUL, not newline\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function order_default(): i32 {
  return 0;
}

function order_enabled(): i32 {
  return 1;
}

function order_disabled(): i32 {
  return 2;
}

function cmp_lines(a: u8[], alo: i32, ahi: i32, b: u8[], blo: i32, bhi: i32): i32 {
  let la: i32 = ahi - alo;
  let lb: i32 = bhi - blo;
  let n: i32 = la;
  if (lb < n) {
    n = lb;
  }
  n = n - 1;
  let i: i32 = __mismatch_bytes(a, alo, b, blo, n);
  if (i < n) {
    if (a[alo + i] as i32 < b[blo + i] as i32) {
      return 0 - 1;
    }
    return 1;
  }
  if (la > lb) {
    return 1;
  }
  if (la < lb) {
    return 0 - 1;
  }
  return 0;
}

function read_size(): i32 {
  return 65536;
}

function write_block(): i32 {
  return 65536;
}

function status_line(): i32 {
  return 0;
}

function status_eof(): i32 {
  return 1;
}

function status_error(): i32 {
  return 2;
}

function next_line_slow(r: Reader, chunk0: u8[], pos0: i32, eof0: boolean, term: i32): (u8[], u8[], i32, boolean, i32, string) {
  let chunk: u8[] = chunk0;
  let pos: i32 = pos0;
  let eof: boolean = eof0;
  let carry: usize = buf_new(chunk.len() - pos);
  while (true) {
    let j: i32 = __memchr_bytes(chunk, term, pos);
    if (j >= 0) {
      buf_push_bytes_range(carry, chunk, pos, j + 1);
      let line: u8[] = buf_take_bytes(carry);
      buf_free(carry);
      return (line, chunk, j + 1, eof, status_line(), "");
    }
    if (pos < chunk.len()) {
      buf_push_bytes_range(carry, chunk, pos, chunk.len());
      pos = chunk.len();
    }
    if (eof) {
      if (buf_len(carry) > 0) {
        buf_push_byte(carry, term);
        let line: u8[] = buf_take_bytes(carry);
        buf_free(carry);
        return (line, chunk, pos, eof, status_line(), "");
      }
      buf_free(carry);
      return ([], chunk, pos, eof, status_eof(), "");
    }
    match (r.read_chunk_bytes(read_size())) {
      Ok(c) => {
        if (c.len() == 0) {
          eof = true;
        } else {
          chunk = c;
          pos = 0;
        }
      },
      Err(e) => {
        buf_free(carry);
        return ([], chunk, pos, true, status_error(), gnu.io_error_text(e));
      }
    }
  }
  buf_free(carry);
  return ([], chunk, pos, eof, status_eof(), "");
}

struct Cfg { only1: boolean, only2: boolean, both: boolean, sep: string, check: i32, total: boolean, term: i32 }

pub function main(): i32 {
  let argv: string[] = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("1", "", opt_only1()));
  opts = opts.append(gnu.flag("2", "", opt_only2()));
  opts = opts.append(gnu.flag("3", "", opt_both()));
  opts = opts.append(gnu.flag("", "check-order", opt_check()));
  opts = opts.append(gnu.flag("", "nocheck-order", opt_nocheck()));
  opts = opts.append(gnu.valued("", "output-delimiter", opt_delim()));
  opts = opts.append(gnu.flag("", "total", opt_total()));
  opts = opts.append(gnu.flag("z", "zero-terminated", opt_zero()));

  let cfg: Cfg = Cfg { only1: true, only2: true, both: true, sep: "\t", check: order_default(), total: false, term: 10 };
  let delim_specified: boolean = false;
  let delim_given: string = "";

  let g: gnu.Getopt = gnu.getopt_new(argv, opts, "comm", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    let done: boolean = false;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_only1()) {
          cfg = Cfg { ...cfg, only1: false };
        } else if (m.id == opt_only2()) {
          cfg = Cfg { ...cfg, only2: false };
        } else if (m.id == opt_both()) {
          cfg = Cfg { ...cfg, both: false };
        } else if (m.id == opt_check()) {
          cfg = Cfg { ...cfg, check: order_enabled() };
        } else if (m.id == opt_nocheck()) {
          cfg = Cfg { ...cfg, check: order_disabled() };
        } else if (m.id == opt_total()) {
          cfg = Cfg { ...cfg, total: true };
        } else if (m.id == opt_zero()) {
          cfg = Cfg { ...cfg, term: 0 };
        } else {
          if (delim_specified && delim_given != m.value) {
            gnu.error("multiple output delimiters specified");
            exit(1);
          }
          delim_given = m.value;
          delim_specified = true;
          let sep: string = m.value;
          if (sep.len() == 0) {
            sep = string_from_bytes_unchecked([0 as u8]);
          }
          cfg = Cfg { ...cfg, sep: sep };
        }
      },
      None => {
        done = true;
      }
    }
    if (done) {
      break;
    }
  }

  let operands: string[] = g.operands();
  if (operands.len() < 1) {
    gnu.error("missing operand");
    gnu.try_help(1);
  }
  if (operands.len() < 2) {
    gnu.error("missing operand after " + gnu.quote(operands[0]));
    gnu.try_help(1);
  }
  if (operands.len() > 2) {
    gnu.error("extra operand " + gnu.quote(operands[2]));
    gnu.try_help(1);
  }
  let name1: string = operands[0];
  let name2: string = operands[1];

  let r1: Reader = stdin();
  if (name1 != "-") {
    match (open_reader(name1)) {
      Ok(f) => {
        r1 = f;
      },
      Err(e) => {
        gnu.error(gnu.quotef(name1) + ": " + gnu.io_error_text(e));
        exit(1);
      }
    }
  }
  let r2: Reader = stdin();
  if (name2 != "-") {
    match (open_reader(name2)) {
      Ok(f) => {
        r2 = f;
      },
      Err(e) => {
        gnu.error(gnu.quotef(name2) + ": " + gnu.io_error_text(e));
        exit(1);
      }
    }
  }
  return merge(r1, r2, name1, name2, cfg);
}

function merge(r1: Reader, r2: Reader, name1: string, name2: string, cfg: Cfg): i32 {
  let out: io_buffered.BufWriter = gnu.out_with(write_block());
  let h: usize = out.handle();
  let block: i32 = write_block();
  let term: i32 = cfg.term;
  let shared: boolean = name1 == "-" && name2 == "-";

  let chunk1: u8[] = [];
  let pos1: i32 = 0;
  let eof1: boolean = false;
  let chunk2: u8[] = [];
  let pos2: i32 = 0;
  let eof2: boolean = false;

  let cur1: u8[] = [];
  let lo1: i32 = 0;
  let hi1: i32 = 0;
  let cur2: u8[] = [];
  let lo2: i32 = 0;
  let hi2: i32 = 0;
  let have1: boolean = false;
  let have2: boolean = false;
  let back1a: u8[] = [];
  let alo1: i32 = 0;
  let ahi1: i32 = 0;
  let back1b: u8[] = [];
  let blo1: i32 = 0;
  let bhi1: i32 = 0;
  let back2a: u8[] = [];
  let alo2: i32 = 0;
  let ahi2: i32 = 0;
  let back2b: u8[] = [];
  let blo2: i32 = 0;
  let bhi2: i32 = 0;
  let read1: i32 = 0;
  let read2: i32 = 0;

  let show1: boolean = cfg.only1;
  let show2: boolean = cfg.only2;
  let show3: boolean = cfg.both;
  let pre2: string = "";
  if (cfg.only1) {
    pre2 = cfg.sep;
  }
  let pre3: string = "";
  if (cfg.only1) {
    pre3 = pre3 + cfg.sep;
  }
  if (cfg.only2) {
    pre3 = pre3 + cfg.sep;
  }

  let seen_unpairable: boolean = false;
  let issued1: boolean = false;
  let issued2: boolean = false;
  let t0: u64 = 0 as u64;
  let t1: u64 = 0 as u64;
  let t2: u64 = 0 as u64;

  let need1: boolean = true;
  let need2: boolean = true;
  while (true) {
    if (need1) {
      need1 = false;
      let line: u8[] = [];
      let llo: i32 = 0;
      let lhi: i32 = 0;
      let st: i32 = status_line();
      let j: i32 = __memchr_bytes(chunk1, term, pos1);
      if (j >= 0) {
        line = chunk1;
        llo = pos1;
        lhi = j + 1;
        pos1 = j + 1;
      } else {
        let u: (u8[], u8[], i32, boolean, i32, string) = next_line_slow(r1, chunk1, pos1, eof1, term);
        line = u.0;
        lhi = line.len();
        chunk1 = u.1;
        pos1 = u.2;
        eof1 = u.3;
        st = u.4;
        if (st == status_error()) {
          gnu.die(out, gnu.quotef(name1) + ": " + u.5, 1);
        }
      }
      back1a = back1b;
      alo1 = blo1;
      ahi1 = bhi1;
      back1b = cur1;
      blo1 = lo1;
      bhi1 = hi1;
      if (st == status_line()) {
        cur1 = line;
        lo1 = llo;
        hi1 = lhi;
        have1 = true;
        read1 = read1 + 1;
      } else {
        cur1 = [];
        lo1 = 0;
        hi1 = 0;
        have1 = false;
      }
      if (read1 >= 2 && should_check(cfg, seen_unpairable, issued1)) {
        let order: i32 = cmp_lines(back1b, blo1, bhi1, cur1, lo1, hi1);
        if (!have1) {
          order = cmp_lines(back1a, alo1, ahi1, back1b, blo1, bhi1);
        }
        if (order > 0) {
          out = disorder(out, cfg, 1);
          issued1 = true;
        }
      }
      if (shared) {
        chunk2 = chunk1;
        pos2 = pos1;
        eof2 = eof1;
      }
    }
    if (need2) {
      need2 = false;
      let line: u8[] = [];
      let llo: i32 = 0;
      let lhi: i32 = 0;
      let st: i32 = status_line();
      let j: i32 = __memchr_bytes(chunk2, term, pos2);
      if (j >= 0) {
        line = chunk2;
        llo = pos2;
        lhi = j + 1;
        pos2 = j + 1;
      } else {
        let u: (u8[], u8[], i32, boolean, i32, string) = next_line_slow(r2, chunk2, pos2, eof2, term);
        line = u.0;
        lhi = line.len();
        chunk2 = u.1;
        pos2 = u.2;
        eof2 = u.3;
        st = u.4;
        if (st == status_error()) {
          gnu.die(out, gnu.quotef(name2) + ": " + u.5, 1);
        }
      }
      back2a = back2b;
      alo2 = blo2;
      ahi2 = bhi2;
      back2b = cur2;
      blo2 = lo2;
      bhi2 = hi2;
      if (st == status_line()) {
        cur2 = line;
        lo2 = llo;
        hi2 = lhi;
        have2 = true;
        read2 = read2 + 1;
      } else {
        cur2 = [];
        lo2 = 0;
        hi2 = 0;
        have2 = false;
      }
      if (read2 >= 2 && should_check(cfg, seen_unpairable, issued2)) {
        let order: i32 = cmp_lines(back2b, blo2, bhi2, cur2, lo2, hi2);
        if (!have2) {
          order = cmp_lines(back2a, alo2, ahi2, back2b, blo2, bhi2);
        }
        if (order > 0) {
          out = disorder(out, cfg, 2);
          issued2 = true;
        }
      }
      if (shared) {
        chunk1 = chunk2;
        pos1 = pos2;
        eof1 = eof2;
      }
    }
    if (!have1 && !have2) {
      break;
    }

    let order: i32 = 0;
    if (!have1) {
      order = 1;
    } else if (!have2) {
      order = 0 - 1;
    } else {
      order = cmp_lines(cur1, lo1, hi1, cur2, lo2, hi2);
    }
    let class: i32 = 3;
    if (order < 0) {
      class = 1;
    } else if (order > 0) {
      class = 2;
    }
    if (order == 0) {
      t2 = t2 + 1 as u64;
    } else {
      seen_unpairable = true;
      if (order < 0) {
        t0 = t0 + 1 as u64;
      } else {
        t1 = t1 + 1 as u64;
      }
    }
    let wrote: boolean = false;
    if (class == 1) {
      if (show1) {
        buf_push_bytes_range(h, cur1, lo1, hi1);
        wrote = true;
      }
    } else if (class == 2) {
      if (show2) {
        buf_push(h, pre2);
        buf_push_bytes_range(h, cur2, lo2, hi2);
        wrote = true;
      }
    } else if (show3) {
      buf_push(h, pre3);
      buf_push_bytes_range(h, cur2, lo2, hi2);
      wrote = true;
    }
    if (wrote) {
      out = gnu.check(out);
    }
    if (buf_len(h) >= block) {
      out = gnu.settle(out);
    }
    if (order <= 0) {
      need1 = true;
    }
    if (order >= 0) {
      need2 = true;
    }
  }

  if let Err(e) = r1.close() {
    gnu.die(out, gnu.quotef(name1) + ": " + gnu.io_error_text(e), 1);
  }
  if (!shared) {
    if let Err(e) = r2.close() {
      gnu.die(out, gnu.quotef(name2) + ": " + gnu.io_error_text(e), 1);
    }
  }
  if (cfg.total) {
    gnu.push_decimal(h, t0);
    buf_push(h, cfg.sep);
    gnu.push_decimal(h, t1);
    buf_push(h, cfg.sep);
    gnu.push_decimal(h, t2);
    buf_push(h, cfg.sep);
    buf_push(h, "total");
    buf_push_byte(h, term);
  }
  if (issued1 || issued2) {
    out = gnu.error_out(out, "input is not in sorted order");
    gnu.close_stdout(out, false);
    return 1;
  }
  if (out.buffered() > 0) {
    out = gnu.check(out.flush());
  }
  gnu.close_stdout(out, false);
  return 0;
}

function should_check(cfg: Cfg, seen_unpairable: boolean, issued: boolean): boolean {
  if (cfg.check == order_disabled() || issued) {
    return false;
  }
  return cfg.check == order_enabled() || seen_unpairable;
}

function disorder(o: io_buffered.BufWriter, cfg: Cfg, which: i32): io_buffered.BufWriter {
  let msg: string = "file " + which.to_string() + " is not in sorted order";
  if (cfg.check == order_enabled()) {
    gnu.die(o, msg, 1);
  }
  return gnu.error_out(o, msg);
}
