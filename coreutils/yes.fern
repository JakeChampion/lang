import "std/string";
import "std/array";
import "./lib/gnu";

function block_bytes(): i32 {
  if (target_os() == "darwin") {
    return 1024;
  }
  return 4096;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [STRING]...\n";
  out = out + "  or:  " + gnu.prog() + " OPTION\n";
  out = out + "Repeatedly write a line with all the STRINGs on it, or 'y'.\n";
  out = out + "\n";
  out = out + "      --help     display this help and exit\n";
  out = out + "      --version  output version information and exit\n";
  return out;
}

pub function main(): i32 {
  let argv: string[] = args();
  let operands: string[] = gnu.parse_standard_options_only(argv, "yes", help_text(), 1);
  let line: string = "y";
  if (operands.len() > 0) {
    line = operands.join(" ");
  }
  line = line + "\n";

  let copies: i32 = block_bytes() / line.len();
  if (copies < 1) {
    copies = 1;
  }
  let block: string = line.repeat(copies);

  let w: Writer = stdout();
  match (w.splice_forever(block)) {
    Err(Unsupported()) => {},
    Err(e) => {
      gnu.error("standard output: " + gnu.io_error_text(e));
      exit(1);
    },
    Ok(_) => {}
  }
  while (true) {
    if let Err(e) = w.write(block) {
      gnu.error("standard output: " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return 0;
}
