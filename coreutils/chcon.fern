// chcon.fern — GNU-compatible `chcon`.
//
//   chcon [OPTION]... CONTEXT FILE...
//   chcon [OPTION]... [-u USER] [-r ROLE] [-l RANGE] [-t TYPE] FILE...
//   chcon [OPTION]... --reference=RFILE FILE...
//
// The SELinux security context of a file is its `security.selinux`
// extended attribute, read with `getxattr` and written with `setxattr`
// the way libselinux's getfilecon(3) and setfilecon(3) do (see
// lib/selinux.fern). A change that fails reports the kernel's errno in
// GNU's frame — `Operation not permitted` for a caller who may not write
// `security.*` on a kernel with no SELinux, which is what GNU built with
// libselinux prints there too.
//
// ---- the argument shape ------------------------------------------------
//
// How many operands are required depends on how the context was named:
// two (CONTEXT and one FILE) when it is a bare operand, one when
// `--reference` or any of `-u -r -t -l` named it. The count is checked
// BEFORE the reference file is read, so `chcon --reference=RFILE` with no
// FILE is `missing operand` rather than anything about RFILE.
//
// `missing operand after %s` names the LAST OPERAND, not the last argv
// element: glibc permutes the options to the front, so `chcon f
// --verbose` reports `f`.
//
// `conflicting security context specifiers given` — `--reference`
// together with one of the four component options — is checked AFTER the
// reference file has been read, so on a machine with no SELinux the read
// fails first and the message is unreachable. The order is kept as GNU
// has it rather than tidied, because tidying it would change which
// diagnostic a machine that HAS SELinux prints.
//
// ---- the walk ----------------------------------------------------------
//
// Without `-R` a directory operand is changed and not descended into.
// With `-R` a directory is changed AFTER its children, because GNU does
// nothing on fts's pre-order visit and acts on the post-order one; a
// directory whose children cannot be listed is reported and never
// changed, because fts reports it instead of yielding that second visit.
//
// `-H`, `-L` and `-P` are last-one-wins and only `-R` consults them. `-h`
// / `--dereference` are separately tracked, and the two combinations GNU
// rejects outright — `-R --dereference` with neither `-H` nor `-L`, and
// `-R -h` with one of them — exit 1 with no usage line.
//
// The name a diagnostic shows is fts's, and fts holds a descriptor on the
// directory it is inside: `cannot access`, `cannot read directory` and
// the `-v` line name the whole path, while the change itself names the
// path RELATIVE to that directory — a bare `g` for `d/sub/g`. Under `-L`
// fts does not chdir and the two are the same. `shown` below is that
// name.
import "std/string";
import "std/array";
import "std/errno";
import "./lib/fts";
import "./lib/gnu";
import "./lib/selinux";

function opt_recursive(): i32 {
  return 1;
}

function opt_dereference(): i32 {
  return 2;
}

function opt_no_dereference(): i32 {
  return 3;
}

function opt_no_preserve_root(): i32 {
  return 4;
}

function opt_preserve_root(): i32 {
  return 5;
}

function opt_reference(): i32 {
  return 6;
}

function opt_user(): i32 {
  return 7;
}

function opt_role(): i32 {
  return 8;
}

function opt_type(): i32 {
  return 9;
}

function opt_range(): i32 {
  return 10;
}

function opt_verbose(): i32 {
  return 11;
}

function opt_comfollow(): i32 {
  return 12;
}

function opt_logical(): i32 {
  return 13;
}

function opt_physical(): i32 {
  return 14;
}

// The three traversal modes `-H`, `-L` and `-P` select.
function walk_physical(): i32 {
  return 0;
}

function walk_comfollow(): i32 {
  return 1;
}

function walk_logical(): i32 {
  return 2;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... CONTEXT FILE...\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... [-u USER] [-r ROLE] [-l RANGE] [-t TYPE] FILE...\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... --reference=RFILE FILE...\n";
  out = out + "Change the SELinux security context of each FILE to CONTEXT.\n";
  out = out + "With --reference, change the security context of each FILE to that of RFILE.\n";
  out = out + "\n";
  out = out + "Mandatory arguments to long options are mandatory for short options too.\n";
  out = out + "      --dereference\n";
  out = out + "         affect the referent of each symbolic link (this is\n";
  out = out + "         the default), rather than the symbolic link itself\n";
  out = out + "  -h, --no-dereference\n";
  out = out + "         affect symbolic links instead of any referenced file\n";
  out = out + "  -u, --user=USER\n";
  out = out + "         set user USER in the target security context\n";
  out = out + "  -r, --role=ROLE\n";
  out = out + "         set role ROLE in the target security context\n";
  out = out + "  -t, --type=TYPE\n";
  out = out + "         set type TYPE in the target security context\n";
  out = out + "  -l, --range=RANGE\n";
  out = out + "         set range RANGE in the target security context\n";
  out = out + "      --no-preserve-root\n";
  out = out + "         do not treat '/' specially (the default)\n";
  out = out + "      --preserve-root\n";
  out = out + "         fail to operate recursively on '/'\n";
  out = out + "      --reference=RFILE\n";
  out = out + "         use RFILE's security context rather than specifying a CONTEXT value\n";
  out = out + "  -R, --recursive\n";
  out = out + "         operate on files and directories recursively\n";
  out = out + "  -v, --verbose\n";
  out = out + "         output a diagnostic for every file processed\n";
  out = out + "\n";
  out = out + "The following options modify how a hierarchy is traversed when the -R\n";
  out = out + "option is also specified.  If more than one is specified, only the final\n";
  out = out + "one takes effect. -P is the default.\n";
  out = out + "\n";
  out = out + "  -H\n";
  out = out + "         if a command line argument is a symlink to a directory, traverse it\n";
  out = out + "  -L\n";
  out = out + "         traverse every symbolic link to a directory encountered\n";
  out = out + "  -P\n";
  out = out + "         do not traverse any symbolic links\n";
  out = out + "\n";
  out = out + "      --help\n";
  out = out + "         display this help and exit\n";
  out = out + "      --version\n";
  out = out + "         output version information and exit\n";
  return out;
}

// `comps` / `set` are the component options, indexed user 0, role 1, type 2,
// range 3 as `selinux.merge_context` reads them.
struct Settings { recursive: boolean, preserve_root: boolean, verbose: boolean, walk: i32, deref: i32, referent: boolean, context: string, component: boolean, comps: string[], set: boolean[] }

struct St { out: gnu.Stdio, status: i32 }

function fail(st: St, msg: string): St {
  return St { out: st.out.report(msg), status: 1 };
}

function component_index(id: i32): i32 {
  if (id == opt_user()) {
    return 0;
  }
  if (id == opt_role()) {
    return 1;
  }
  if (id == opt_type()) {
    return 2;
  }
  return 3;
}

// The option scan. `-H` / `-L` / `-P` and `-h` / `--dereference` are both
// last-one-wins, and the two are independent: which one a `-R` run needs
// is decided after the scan, not during it.
function scan_options(): (Settings, string[], boolean, string) {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("R", "recursive", opt_recursive()));
  opts = opts.append(gnu.flag("", "dereference", opt_dereference()));
  opts = opts.append(gnu.flag("h", "no-dereference", opt_no_dereference()));
  opts = opts.append(gnu.flag("", "no-preserve-root", opt_no_preserve_root()));
  opts = opts.append(gnu.flag("", "preserve-root", opt_preserve_root()));
  opts = opts.append(gnu.valued("", "reference", opt_reference()));
  opts = opts.append(gnu.valued("u", "user", opt_user()));
  opts = opts.append(gnu.valued("r", "role", opt_role()));
  opts = opts.append(gnu.valued("t", "type", opt_type()));
  opts = opts.append(gnu.valued("l", "range", opt_range()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));
  opts = opts.append(gnu.flag("H", "", opt_comfollow()));
  opts = opts.append(gnu.flag("L", "", opt_logical()));
  opts = opts.append(gnu.flag("P", "", opt_physical()));
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "chcon", help_text(), 1);
  let s: Settings = Settings { recursive: false, preserve_root: false, verbose: false, walk: walk_physical(), deref: 0 - 1, referent: true, context: "", component: false, comps: ["", "", "", ""], set: [false, false, false, false] };
  let has_reference: boolean = false;
  let reference: string = "";
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_recursive()) {
          s = Settings { ...s, recursive: true };
        } else if (m.id == opt_dereference()) {
          s = Settings { ...s, deref: 1 };
        } else if (m.id == opt_no_dereference()) {
          s = Settings { ...s, deref: 0 };
        } else if (m.id == opt_no_preserve_root()) {
          s = Settings { ...s, preserve_root: false };
        } else if (m.id == opt_preserve_root()) {
          s = Settings { ...s, preserve_root: true };
        } else if (m.id == opt_verbose()) {
          s = Settings { ...s, verbose: true };
        } else if (m.id == opt_comfollow()) {
          s = Settings { ...s, walk: walk_comfollow() };
        } else if (m.id == opt_logical()) {
          s = Settings { ...s, walk: walk_logical() };
        } else if (m.id == opt_physical()) {
          s = Settings { ...s, walk: walk_physical() };
        } else if (m.id == opt_reference()) {
          has_reference = true;
          reference = m.value;
        } else if (m.id == opt_user() || m.id == opt_role() || m.id == opt_type() || m.id == opt_range()) {
          let k: i32 = component_index(m.id);
          s = Settings { ...s, component: true, comps: s.comps.with(k, m.value), set: s.set.with(k, true) };
        }
      },
      None => {
        break;
      }
    }
  }
  return (s, g.operands(), has_reference, reference);
}

// Which of `-H` / `-L` / `-P` a `-R` run was given, against which of
// `-h` / `--dereference`, decides whether the symlinks met are followed
// — and two of the combinations are refused rather than resolved.
function resolve_traversal(s0: Settings): Settings {
  let s: Settings = s0;
  if (s.recursive) {
    if (s.walk == walk_physical()) {
      if (s.deref == 1) {
        gnu.error("-R --dereference requires either -H or -L");
        exit(1);
      }
      return Settings { ...s, referent: false };
    }
    if (s.deref == 0) {
      gnu.error("-R -h requires -P");
      exit(1);
    }
    return Settings { ...s, referent: true };
  }
  return Settings { ...s, walk: walk_physical(), referent: s.deref != 0 };
}

// ---- the root failsafe -----------------------------------------------------
// Compared by device and inode, so every spelling of `/` is caught — `//`,
// `/.`, `/tmp/..` — and each one that is not literally `/` says so.
function is_root_dir(info: FileStat): boolean {
  match (stat("/")) {
    Ok(root) => {
      return info.dev == root.dev && info.ino == root.ino;
    },
    Err(_) => {
      return false;
    }
  }
}

function refuse_root(st0: St, path: string): St {
  let same: string = "";
  if (path != "/") {
    same = " (same as '/')";
  }
  let st: St = fail(st0, "it is dangerous to operate recursively on " + gnu.quotea(path) + same);
  return fail(st, "use --no-preserve-root to override this failsafe");
}

function is_dir_mode(m: u32): boolean {
  return (m & 61440 as u32) == 16384 as u32;
}

// ---- one entry -------------------------------------------------------------
// The component forms read the file's context first and rebuild it; an
// unchanged result is success without a write. A context named outright is
// always written. `shown` is the name fts would hand libselinux, which is
// the path relative to the directory fts is sitting in; `path` is the whole
// one, which is what this process needs.
function change_one(st0: St, s: Settings, path: string, shown: string): St {
  let st: St = st0;
  if (s.verbose) {
    st = St { ...st, out: st.out.fwrite("changing security context of " + gnu.quotea(path) + "\n") };
  }
  let target: string = s.context;
  if (s.component) {
    let cur: string = "";
    match (selinux.file_context(path, s.referent)) {
      Ok(c) => {
        cur = c;
      },
      Err(e) => {
        // ENODATA is a file with no label, which GNU will not complete
        // from a partial context.
        if (errno.of(e) == errno.ENODATA) {
          return fail(st, "can't apply partial context to unlabeled file " + gnu.quotea(shown));
        }
        return fail(st, "failed to get security context of " + gnu.quotea(shown) + ": " + gnu.io_error_text(e));
      }
    }
    match (selinux.merge_context(cur, s.comps, s.set)) {
      Ok(c) => {
        target = c;
      },
      Err(msgs) => {
        for m in msgs {
          st = fail(st, m);
        }
        return st;
      }
    }
    if (target == cur) {
      return st;
    }
  }
  match (selinux.set_file_context(path, target, s.referent)) {
    Ok(_) => {
      return st;
    },
    Err(e) => {
      return fail(st, "failed to change context of " + gnu.quotea(shown) + " to " + gnu.quote(target) + ": " + gnu.io_error_text(e));
    }
  }
}

// ---- the walk --------------------------------------------------------------
// `top` marks a command-line operand: only there does `-H` follow a
// symlink. `shown` is what a change names, which is the basename below
// the top except under `-L`, where fts holds no directory descriptor.
function process(st0: St, s: Settings, path: string, shown: string, top: boolean): St {
  let st: St = st0;
  let follow: boolean = s.walk == walk_logical() || top && s.walk == walk_comfollow();
  let looked: Result[FileStat, IoError] = lstat(path);
  if (follow) {
    looked = stat(path);
  }
  match (looked) {
    Ok(info) => {
      if (!is_dir_mode(info.mode)) {
        return change_one(st, s, path, shown);
      }
      if (s.recursive && s.preserve_root && is_root_dir(info)) {
        return refuse_root(st, path);
      }
      if (!s.recursive) {
        return change_one(st, s, path, shown);
      }
      match (read_dir(path)) {
        Ok(names) => {
          let i: i32 = 0;
          while (i < names.len()) {
            let child: string = fts.child_path(path, names[i]);
            let child_shown: string = names[i];
            if (s.walk == walk_logical()) {
              child_shown = child;
            }
            st = process(st, s, child, child_shown, false);
            i = i + 1;
          }
        },
        Err(e) => {
          // A directory fts could not read never yields the second visit
          // the change hangs off, so it is reported and left alone.
          return fail(st, "cannot read directory " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
        }
      }
      return change_one(st, s, path, shown);
    },
    Err(e) => {
      return fail(st, "cannot access " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
    }
  }
}

pub function main(): i32 {
  let scanned: (Settings, string[], boolean, string) = scan_options();
  let s: Settings = resolve_traversal(scanned.0);
  let operands: string[] = scanned.1;
  let has_reference: boolean = scanned.2;
  let reference: string = scanned.3;

  let need: i32 = 2;
  if (has_reference || s.component) {
    need = 1;
  }
  if (operands.len() < need) {
    if (operands.len() == 0) {
      gnu.die_usage("missing operand", 1);
    }
    gnu.die_usage("missing operand after " + gnu.quote(operands[operands.len() - 1]), 1);
  }

  if (has_reference) {
    // getfilecon(3) of RFILE. GNU exits here on failure, so the
    // conflicting-specifiers check below is unreachable on a machine with
    // no SELinux.
    match (selinux.file_context(reference, true)) {
      Ok(c) => {
        s = Settings { ...s, context: c };
      },
      Err(e) => {
        gnu.error("failed to get security context of " + gnu.quotea(reference) + ": " + gnu.io_error_text(e));
        return 1;
      }
    }
  } else if (!s.component) {
    s = Settings { ...s, context: operands[0] };
    operands = array.slice(operands, 1, operands.len());
  }
  if (has_reference && s.component) {
    gnu.die_usage("conflicting security context specifiers given", 1);
  }

  let st: St = St { out: gnu.stdio_new(), status: 0 };
  let i: i32 = 0;
  while (i < operands.len()) {
    let name: string = fts.trim(operands[i]);
    st = process(st, s, name, name, true);
    i = i + 1;
  }
  st.out.close_stdout();
  return st.status;
}
