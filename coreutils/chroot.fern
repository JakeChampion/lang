import "./lib/gnu";
import "./lib/owner";
import "./lib/pwdb";
import "./lib/canon";

function opt_groups(): i32 {
  return 1;
}

function opt_userspec(): i32 {
  return 2;
}

function opt_skip_chdir(): i32 {
  return 3;
}

function status_canceled(): i32 {
  return 125;
}

function id_unset(): i64 {
  return 0i64 - 1i64;
}

function is_set(id: i64): boolean {
  return id >= 0i64;
}

function seeded(named: i64, outer: i64): i64 {
  if (is_set(named)) {
    return named;
  }
  return outer;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION] NEWROOT [COMMAND [ARG]...]\n";
  out = out + "  or:  " + gnu.prog() + " OPTION\n";
  out = out + "Run COMMAND with root directory set to NEWROOT.\n";
  out = out + "\n";
  out = out + "      --groups=G_LIST        specify supplementary groups as g1,g2,..,gN\n";
  out = out + "      --userspec=USER:GROUP  specify user and group (ID or name) to use\n";
  out = out + "      --skip-chdir           do not change working directory to " + gnu.quotea("/") + "\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "If no command is given, run '\"$SHELL\" -i' (default: '/bin/sh -i').\n";
  out = out + "\n";
  out = out + "Exit status:\n";
  out = out + "  125  if the chroot command itself fails\n";
  out = out + "  126  if COMMAND is found but cannot be invoked\n";
  out = out + "  127  if COMMAND cannot be found\n";
  out = out + "  -    the exit status of COMMAND otherwise\n";
  return out;
}

function is_old_root(dir: string): boolean {
  match (canon.canonicalize(dir, canon.existing(), false)) {
    Ok(p) => {
      return p == "/";
    },
    Err(e) => {
      return false;
    }
  }
}

function split_commas(s: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i <= s.len()) {
    let at_end: boolean = i == s.len();
    let is_comma: boolean = false;
    if (!at_end) {
      is_comma = s[i] as i32 == 44;
    }
    if (at_end || is_comma) {
      if (i > start) {
        out = out.append(slice_unchecked(s, start, i) + "");
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

function is_space(c: i32): boolean {
  return c == 32 || c >= 9 && c <= 13;
}

function skip_spaces(s: string): string {
  let i: i32 = 0;
  while (i < s.len()) {
    if (!is_space(s[i] as i32)) {
      break;
    }
    i = i + 1;
  }
  return slice_unchecked(s, i, s.len()) + "";
}

function parse_gid_number(tok: string): Option[i64] {
  let t: string = skip_spaces(tok);
  let i: i32 = 0;
  if (i < t.len()) {
    if (t[i] as i32 == 43) {
      i = i + 1;
    }
  }
  let v: i64 = 0;
  let digits: i32 = 0;
  while (i < t.len()) {
    let c: i32 = t[i] as i32;
    if (c < 48 || c > 57) {
      return None;
    }
    v = v * 10i64 + (c - 48) as i64;
    if (v > 4294967295i64) {
      return None;
    }
    i = i + 1;
    digits = digits + 1;
  }
  if (digits == 0) {
    return None;
  }
  return Some(v);
}

struct Gid { ok: boolean, value: i64 }

function resolve_group_token(db: owner.Db, tok: string): Gid {
  match (parse_gid_number(tok)) {
    Some(v) => {
      let trimmed: string = skip_spaces(tok);
      let plus: boolean = false;
      if (trimmed.len() > 0) {
        plus = trimmed[0] as i32 == 43;
      }
      if (!plus) {
        match (pwdb.group_by_name_in(db.gr, trimmed)) {
          Some(gr) => {
            return Gid { ok: true, value: gr.gid };
          },
          None => {}
        }
      }
      return Gid { ok: true, value: v };
    },
    None => {}
  }
  match (pwdb.group_by_name_in(db.gr, tok)) {
    Some(gr) => {
      return Gid { ok: true, value: gr.gid };
    },
    None => {}
  }
  return Gid { ok: false, value: 0i64 };
}

function parse_groups(db: owner.Db, spec: string, show_errors: boolean): Option[i64[]] {
  let out: i64[] = [];
  let bad: boolean = false;
  for tok in split_commas(spec) {
    let g: Gid = resolve_group_token(db, tok);
    if (!g.ok) {
      bad = true;
      if (show_errors) {
        gnu.error("invalid group " + gnu.quote(tok));
        continue;
      }
      break;
    }
    out = out.append(g.value);
  }
  if (bad) {
    return None;
  }
  if (out.len() == 0) {
    if (show_errors) {
      gnu.error("invalid group list " + gnu.quote(spec));
    }
    return None;
  }
  return Some(out);
}

struct Ids { uid: i64, gid: i64, uname: string }

function fill_from_passwd(db: owner.Db, ids: Ids, has_groups: boolean, fatal: boolean): Ids {
  if (!is_set(ids.uid)) {
    return ids;
  }
  if (has_groups && is_set(ids.gid)) {
    return ids;
  }
  match (pwdb.user_by_uid_in(db.pw, ids.uid)) {
    Some(u) => {
      let gid: i64 = ids.gid;
      if (!is_set(gid)) {
        gid = u.gid;
      }
      return Ids { uid: ids.uid, gid: gid, uname: u.name };
    },
    None => {
      if (fatal && !is_set(ids.gid)) {
        gnu.error("no group specified for unknown uid: " + ids.uid.to_string());
        exit(status_canceled());
      }
      return ids;
    }
  }
}

function fail_exec(cmd: string, errno: i32): void {
  gnu.error("failed to run command " + gnu.quote(cmd) + ": " + gnu.exec_errno_text(errno));
  if (errno == 2) {
    exit(127);
  }
  exit(126);
}

function shell_argv(): string[] {
  match (env("SHELL")) {
    Some(s) => {
      return [s, "-i"];
    },
    None => {
      return ["/bin/sh", "-i"];
    }
  }
}

function strip_trailing_colon(s: string): string {
  if (s.len() == 0) {
    return s;
  }
  if (s[s.len() - 1] as i32 != 58) {
    return s;
  }
  return slice_unchecked(s, 0, s.len() - 1) + "";
}

struct Scan { userspec: string, has_userspec: boolean, groups: string, has_groups: boolean, skip_chdir: boolean }

function scan(g: gnu.Getopt): (Scan, gnu.Getopt) {
  let s: Scan = Scan { userspec: "", has_userspec: false, groups: "", has_groups: false, skip_chdir: false };
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_userspec()) {
          s = Scan { ...s, userspec: strip_trailing_colon(m.value), has_userspec: true };
        }
        if (m.id == opt_groups()) {
          s = Scan { ...s, groups: m.value, has_groups: true };
        }
        if (m.id == opt_skip_chdir()) {
          s = Scan { ...s, skip_chdir: true };
        }
      },
      None => {
        break;
      }
    }
  }
  return (s, g);
}

struct Supp { gids: i64[], found: boolean }

function lookup_groups(db: owner.Db, spec: string, has_groups: boolean, ids: Ids, prior: Supp, report: boolean): Supp {
  if (has_groups && spec.len() > 0) {
    return groups_from_spec(db, spec, prior, report);
  }
  if (!has_groups && is_set(ids.gid) && ids.uname.len() > 0) {
    return groups_from_passwd(db, ids, prior, report);
  }
  return prior;
}

function groups_from_spec(db: owner.Db, spec: string, prior: Supp, report: boolean): Supp {
  let last: boolean = report && !prior.found;
  match (parse_groups(db, spec, last)) {
    Some(gs) => {
      return Supp { gids: gs, found: true };
    },
    None => {
      if (last) {
        exit(status_canceled());
      }
      return prior;
    }
  }
}

function groups_from_passwd(db: owner.Db, ids: Ids, prior: Supp, report: boolean): Supp {
  let gl: i64[] = pwdb.group_list_in(db.gr, ids.uname, ids.gid);
  if (gl.len() > 0) {
    return Supp { gids: gl, found: true };
  }
  if (report && !prior.found) {
    gnu.error("failed to get supplemental groups");
    exit(status_canceled());
  }
  return prior;
}

function apply(ids: Ids, supp: Supp, has_groups: boolean): void {
  if (is_set(ids.uid) || has_groups) {
    must(setgroups(supp.gids), "failed to set supplemental groups");
  }
  if (is_set(ids.gid)) {
    must(setgid(ids.gid), "failed to set group-ID");
  }
  if (is_set(ids.uid)) {
    must(setuid(ids.uid), "failed to set user-ID");
  }
}

function must(r: Result[void, IoError], what: string): void {
  match (r) {
    Ok(v) => {},
    Err(e) => {
      gnu.error(what + ": " + gnu.io_error_text(e));
      exit(status_canceled());
    }
  }
}

struct Creds { ids: Ids, supp: Supp }

function outer_pass(s: Scan, is_oldroot: boolean): Creds {
  let c: Creds = Creds { ids: Ids { uid: id_unset(), gid: id_unset(), uname: "" }, supp: Supp { gids: [], found: false } };
  if (is_oldroot) {
    return c;
  }
  let db: owner.Db = owner.db_load();
  if (s.has_userspec) {
    let p: owner.Parsed = owner.parse(db, s.userspec);
    if (p.ok) {
      c = Creds { ...c, ids: Ids { uid: p.spec.uid, gid: p.spec.gid, uname: "" } };
    }
  }
  let ids: Ids = fill_from_passwd(db, c.ids, s.has_groups, false);
  return Creds { ids: ids, supp: lookup_groups(db, s.groups, s.has_groups, ids, c.supp, false) };
}

function inner_pass(s: Scan, c: Creds): Creds {
  let db: owner.Db = owner.db_load();
  let ids: Ids = c.ids;
  if (s.has_userspec) {
    let p: owner.Parsed = owner.parse(db, s.userspec);
    if (!p.ok) {
      gnu.error(p.reason());
      exit(status_canceled());
    }
    if (p.warn_dot) {
      gnu.error(owner.dot_warning_reason());
    }
    ids = Ids { uid: seeded(p.spec.uid, ids.uid), gid: seeded(p.spec.gid, ids.gid), uname: ids.uname };
  }
  ids = fill_from_passwd(db, ids, s.has_groups, true);
  return Creds { ids: ids, supp: lookup_groups(db, s.groups, s.has_groups, ids, c.supp, true) };
}

function command_argv(rest: string[]): string[] {
  if (rest.len() <= 1) {
    return shell_argv();
  }
  let argv: string[] = [];
  let i: i32 = 1;
  while (i < rest.len()) {
    argv = argv.append(rest[i]);
    i = i + 1;
  }
  return argv;
}

pub function main(): i32 {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("", "groups", opt_groups()));
  opts = opts.append(gnu.valued("", "userspec", opt_userspec()));
  opts = opts.append(gnu.flag("", "skip-chdir", opt_skip_chdir()));
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "chroot", help_text(), status_canceled()).in_order();
  let sr: (Scan, gnu.Getopt) = scan(g);
  let s: Scan = sr.0;
  let rest: string[] = sr.1.operands();
  if (rest.len() == 0) {
    gnu.die_usage("missing operand", status_canceled());
  }

  let newroot: string = rest[0];
  let is_oldroot: boolean = is_old_root(newroot);
  if (!is_oldroot && s.skip_chdir) {
    gnu.die_usage("option --skip-chdir only permitted if NEWROOT is old " + gnu.quotea("/"), status_canceled());
  }

  let c: Creds = outer_pass(s, is_oldroot);

  must(chroot(newroot), "cannot change root directory to " + gnu.quotea(newroot));
  if (!s.skip_chdir) {
    must(chdir("/"), "cannot chdir to root directory");
  }

  let argv: string[] = command_argv(rest);
  c = inner_pass(s, c);
  apply(c.ids, c.supp, s.has_groups);

  fail_exec(argv[0], gnu.exec_command(argv[0], argv, environ()));
  return 126;
}
