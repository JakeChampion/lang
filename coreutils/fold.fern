// fold.fern — GNU-compatible `fold`.
//
//   fold [-bs] [-w WIDTH] [FILE]...
//
// Lines longer than WIDTH (80 by default) are broken. Width is COLUMNS,
// not bytes, so a tab advances to the next multiple of eight, `\b` goes
// back one and `\r` returns to zero — `-b` turns all of that off and
// counts bytes. `-s` breaks at the last blank of the over-long line
// instead of mid-word, and falls back to the hard break when the line
// holds no blank at all.
//
// Two shapes are easy to get wrong and are the reference binary's:
//
//   - The character that overflows is re-measured against the FRESH
//     line, so a tab that does not fit in the remainder of one line
//     starts the next one from column zero — and if it does not fit an
//     empty line either, it goes out alone.
//   - Files are not joined. A FILE with no final newline has its tail
//     written with no newline added, and the next FILE starts a new
//     line at column zero.
import "std/array";
import "std/u64";
import "std/io_buffered";
import "./lib/gnu";

// Option ids in GNU's declaration order — `fold --=x` lists `--bytes`
// `--spaces` `--width`.
function opt_bytes(): i32 {
  return 1;
}

function opt_spaces(): i32 {
  return 2;
}

function opt_width(): i32 {
  return 3;
}

// The obsolete `-NUM` form is `-w NUM`, carried by the ten digits
// declared as options taking an OPTIONAL value: `-5x` is the digit 5
// with "x" glued on, and the width text is the two put back together.
function opt_digit(d: i32): i32 {
  return 10 + d;
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Wrap input lines in each FILE, writing to standard output.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -b, --bytes         count bytes rather than columns\n";
  out = out + "  -s, --spaces        break at spaces\n";
  out = out + "  -w, --width=WIDTH   use WIDTH columns instead of 80\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

// Bytes per read(2), and the size of the block the accumulated output
// is handed to the buffered writer in. The writer's threshold is the
// same number, so a full block goes straight to the fd instead of being
// copied into its buffer first.
function read_size(): i32 {
  return 65536;
}

function block_size(): i32 {
  return 16384;
}

function digit_of(id: i32): string {
  return slice_unchecked("0123456789", id - 10, id - 9) + "";
}

function is_digit(c: i32): boolean {
  return c >= 48 && c <= 57;
}

function is_blank(c: i32): boolean {
  return c == 32 || c == 9;
}

// The ceiling gnulib puts on the width: SIZE_MAX less a tab's width and
// one, so a tab at the last column still has somewhere to land.
function width_max(): u64 {
  return 18446744073709551606 as u64;
}

// `width_of(text)` — a `-w` value, or the diagnostic and exit(1) GNU
// gives it. Leading blanks and a `+` are accepted because this is
// strtoumax underneath; a multiplier suffix is NOT, unlike head's count.
// A usage error here prints one line and NO `Try …` line.
function width_of(text: string): u64 {
  var i: i32 = 0;
  while (i < text.len() && (text[i] as i32 == 32 || text[i] as i32 >= 9 && text[i] as i32 <= 13)) {
    i = i + 1;
  }
  if (i < text.len() && text[i] as i32 == 43) {
    i = i + 1;
  }
  var digits: i32 = i;
  var value: u64 = 0 as u64;
  var over: boolean = false;
  while (i < text.len() && is_digit(text[i] as i32)) {
    match (value.checked_mul(10 as u64)) {
      Some(m) => {
        match (m.checked_add((text[i] as i32 - 48) as u64)) {
          Some(a) => {
            value = a;
          },
          None => {
            over = true;
          }
        }
      },
      None => {
        over = true;
      }
    }
    i = i + 1;
  }
  if (i == digits || i != text.len()) {
    gnu.error("invalid number of columns: " + gnu.quote(text));
    exit(1);
  }
  if (over || value > width_max()) {
    gnu.error("invalid number of columns: " + gnu.quote(text) + ": Value too large for defined data type");
    exit(1);
  }
  if (value == 0 as u64) {
    gnu.error("invalid number of columns: " + gnu.quote(text) + ": Numerical result out of range");
    exit(1);
  }
  return value;
}

// The column `c` leaves the cursor on, from `column`. Under `-b` every
// byte is one column and nothing is special.
function advance(column: u64, c: i32, count_bytes: boolean): u64 {
  if (count_bytes) {
    return column + 1 as u64;
  }
  if (c == 8) {
    if (column == 0 as u64) {
      return column;
    }
    return column - 1 as u64;
  }
  if (c == 13) {
    return 0 as u64;
  }
  if (c == 9) {
    return column + (8 as u64 - column % (8 as u64));
  }
  return column + 1 as u64;
}

function main(): i32 {
  var argv: string[] = args();
  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("b", "bytes", opt_bytes()));
  opts = opts.append(gnu.flag("s", "spaces", opt_spaces()));
  opts = opts.append(gnu.valued("w", "width", opt_width()));
  var d: i32 = 0;
  while (d < 10) {
    opts = opts.append(gnu.optional(slice_unchecked("0123456789", d, d + 1) + "", "", opt_digit(d)));
    d = d + 1;
  }

  var count_bytes: boolean = false;
  var break_spaces: boolean = false;
  var width: u64 = 80 as u64;
  var g: gnu.Getopt = gnu.getopt_new(argv, opts, "fold", help_text(), 1);
  while (true) {
    var r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_bytes()) {
          count_bytes = true;
        } else if (m.id == opt_spaces()) {
          break_spaces = true;
        } else if (m.id == opt_width()) {
          width = width_of(m.value);
        } else {
          width = width_of(digit_of(m.id) + m.value);
        }
      },
      None => {
        break;
      }
    }
  }

  var files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  return run(files, width, count_bytes, break_spaces);
}

// `run(files, width, count_bytes, break_spaces)` — the whole fold. One
// function because `out` is the output accumulator: a bare local
// appended to inline grows in place, and the same appends through a
// helper copy the buffer every time (#8785).
function run(files: string[], width: u64, count_bytes: boolean, break_spaces: boolean): i32 {
  var o: io_buffered.BufWriter = gnu.out_with(block_size());
  var out: string = "";
  var ok: boolean = true;

  var fi: i32 = 0;
  var have_reader: boolean = false;
  var is_stdin: boolean = false;
  var name: string = "";
  var r: Reader = stdin();
  var chunk: string = "";
  var pos: i32 = 0;
  var specat: i32 = 0 - 1;
  var carry: string = "";
  var tail: boolean = false;
  var done: boolean = false;

  while (true) {
    if (pos >= chunk.len()) {
      chunk = "";
      pos = 0;
      tail = false;
      var got: boolean = false;
      while (!got) {
        if (!have_reader) {
          if (fi >= files.len()) {
            done = true;
            got = true;
          } else {
            name = files[fi];
            fi = fi + 1;
            is_stdin = name == "-";
            if (is_stdin) {
              r = stdin();
              have_reader = true;
            } else {
              var opened: boolean = false;
              match (open_reader(name)) {
                Ok(f) => {
                  r = f;
                  opened = true;
                },
                Err(e) => {
                  o = o.write_string(out);
                  out = "";
                  o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
                  ok = false;
                }
              }
              have_reader = opened;
            }
          }
        } else {
          var piece: string = "";
          var read_ok: boolean = true;
          match (r.read_chunk(read_size())) {
            Ok(c) => {
              piece = c;
            },
            Err(e) => {
              o = o.write_string(out);
              out = "";
              o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
              ok = false;
              read_ok = false;
            }
          }
          if (read_ok && piece.len() > 0) {
            chunk = piece;
            pos = 0;
            specat = special_at(chunk, 0);
            got = true;
          } else {
            if (!is_stdin) {
              r.close();
            }
            have_reader = false;
            // A FILE's last line does not run into the next FILE: the
            // tail goes out here, with no newline added.
            if (carry.len() > 0) {
              chunk = carry;
              carry = "";
              pos = 0;
              specat = special_at(chunk, 0);
              tail = true;
              got = true;
            }
          }
        }
      }
      if (done) {
        break;
      }
      continue;
    }

    var j: i32 = __memchr(chunk, 10, pos);
    if (j < 0) {
      if (!tail) {
        carry = carry + slice_unchecked(chunk, pos, chunk.len());
        pos = chunk.len();
        continue;
      }
      j = chunk.len() - 1;
    }

    var buf: string = chunk;
    var lo: i32 = pos;
    var hi: i32 = j + 1;
    var carried: boolean = carry.len() > 0;
    if (carried) {
      buf = carry + slice_unchecked(chunk, pos, j + 1);
      carry = "";
      lo = 0;
      hi = buf.len();
    }
    // Only the tail a file left behind is unterminated: it holds
    // everything after that file's last line delimiter.
    var terminated: boolean = !tail;
    pos = j + 1;

    var body: i32 = hi;
    if (terminated) {
      body = hi - 1;
    }

    // The line is folded in place: `start` is where the output line
    // being assembled begins in `buf` and `column` is what has been
    // measured of it, so a line that does not wrap costs ONE append and
    // a line that wraps costs one per piece. fold copies its input
    // verbatim, so an output line is always a contiguous run of it.
    var start: i32 = lo;
    var p: i32 = lo;
    var column: u64 = 0 as u64;
    // The next byte whose column cost is not one. Under -b there is no
    // such byte; otherwise it is a cursor over the chunk, so finding
    // them all costs one pass over it rather than one scan per line.
    var sp: i32 = 0 - 1;
    if (!count_bytes) {
      if (carried) {
        sp = special_at(buf, lo);
      } else {
        sp = specat;
        if (sp >= 0 && sp < lo) {
          sp = special_at(chunk, lo);
        }
      }
    }

    while (p < body) {
      var run_end: i32 = body;
      if (sp >= p && sp < run_end) {
        run_end = sp;
      }
      // Ordinary bytes are one column each, so how many of them fit is
      // arithmetic rather than a walk.
      while (p < run_end) {
        // A byte that did not fit an empty line leaves the column PAST
        // the width, so there is no room at all until the next break.
        var room: u64 = 0 as u64;
        if (column < width) {
          room = width - column;
        }
        var avail: i32 = run_end - p;
        if (avail as u64 <= room) {
          column = column + avail as u64;
          p = run_end;
        } else {
          var cut: i32 = break_before(buf, start, p + room as i32, break_spaces);
          out = out + slice_unchecked(buf, start, cut);
          out = out + "\n";
          start = cut;
          if (cut > p) {
            p = cut;
            column = 0 as u64;
          } else {
            column = 0 as u64;
            var m: i32 = cut;
            while (m < p) {
              column = advance(column, buf[m] as i32, count_bytes);
              m = m + 1;
            }
          }
          if (out.len() >= block_size()) {
            o = o.write_string(out);
            out = "";
          }
        }
      }
      if (p >= body) {
        break;
      }
      // One byte that moves the column by something other than one.
      var c: i32 = buf[p] as i32;
      var next: u64 = advance(column, c, count_bytes);
      if (next <= width) {
        column = next;
        p = p + 1;
      } else {
        var cut: i32 = break_before(buf, start, p, break_spaces);
        if (cut > start) {
          out = out + slice_unchecked(buf, start, cut);
          out = out + "\n";
          start = cut;
          column = 0 as u64;
          var m: i32 = cut;
          while (m < p) {
            column = advance(column, buf[m] as i32, count_bytes);
            m = m + 1;
          }
          if (out.len() >= block_size()) {
            o = o.write_string(out);
            out = "";
          }
        } else {
          // It does not fit an empty line either, so it goes out alone.
          column = next;
          p = p + 1;
        }
      }
      if (sp >= 0 && sp < p) {
        if (carried) {
          sp = special_at(buf, p);
        } else {
          sp = special_at(chunk, p);
        }
      }
    }
    // Whatever is left of the line, with the terminator it came with —
    // a file's last line keeps its missing newline missing.
    out = out + slice_unchecked(buf, start, hi);

    if (specat >= 0 && specat < pos) {
      specat = special_at(chunk, pos);
    }
    if (out.len() >= block_size()) {
      o = o.write_string(out);
      out = "";
    }
  }

  o = o.write_string(out);
  gnu.finish(o);
  if (!ok) {
    return 1;
  }
  return 0;
}

// Where the output line beginning at `start` should be broken when the
// byte at `limit` will not fit: `limit` itself, or under -s one past the
// LAST blank before it, falling back to `limit` when the piece holds no
// blank at all. The walk back is bounded by the width, which is what
// GNU's own backward scan over its line buffer is bounded by too.
function break_before(s: string, start: i32, limit: i32, break_spaces: boolean): i32 {
  if (!break_spaces) {
    return limit;
  }
  var k: i32 = limit;
  while (k > start) {
    k = k - 1;
    if (is_blank(s[k] as i32)) {
      return k + 1;
    }
  }
  return limit;
}

// The first byte at or after `from` whose column cost is not one: a tab,
// a backspace or a carriage return. -1 when the rest holds none.
function special_at(s: string, from: i32): i32 {
  var best: i32 = __memchr(s, 9, from);
  var b: i32 = __memchr(s, 8, from);
  if (b >= 0 && (best < 0 || b < best)) {
    best = b;
  }
  var c: i32 = __memchr(s, 13, from);
  if (c >= 0 && (best < 0 || c < best)) {
    best = c;
  }
  return best;
}
