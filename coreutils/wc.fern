import "std/string";
import "std/array";
import "std/i64";
import "std/io_buffered";
import "std/io";
import "std/utf8";
import "./lib/gnu";

function opt_bytes(): i32 {
  return 1;
}

function opt_chars(): i32 {
  return 2;
}

function opt_lines(): i32 {
  return 3;
}

function opt_words(): i32 {
  return 4;
}

function opt_debug(): i32 {
  return 5;
}

function opt_files0(): i32 {
  return 6;
}

function opt_maxlen(): i32 {
  return 7;
}

function opt_total(): i32 {
  return 8;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... --files0-from=F\n";
  out += "Print newline, word, and byte counts for each FILE, and a total line if\n";
  out += "more than one FILE is specified.  A word is a non-zero-length sequence of\n";
  out += "printable characters delimited by white space.\n";
  out += "\n";
  out += "With no FILE, or when FILE is -, read standard input.\n";
  out += "\n";
  out += "The options below may be used to select which counts are printed, always in\n";
  out += "the following order: newline, word, character, byte, maximum line length.\n";
  out += "  -c, --bytes            print the byte counts\n";
  out += "  -m, --chars            print the character counts\n";
  out += "  -l, --lines            print the newline counts\n";
  out += "      --files0-from=F    read input from the files specified by\n";
  out += "                           NUL-terminated names in file F;\n";
  out += "                           If F is - then read names from standard input\n";
  out += "  -L, --max-line-length  print the maximum display width\n";
  out += "  -w, --words            print the word counts\n";
  out += "      --total=WHEN       when to print a line with total counts;\n";
  out += "                           WHEN can be: auto, always, only, never\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  return out;
}

struct Counts { lines: i64, words: i64, chars: i64, bytes: i64, maxlen: i64 }

function zero_counts(): Counts {
  return Counts { lines: 0 as i64, words: 0 as i64, chars: 0 as i64, bytes: 0 as i64, maxlen: 0 as i64 };
}

function add_counts(a: Counts, b: Counts): Counts {
  let m = a.maxlen;
  if (b.maxlen > m) {
    m = b.maxlen;
  }
  return Counts { lines: a.lines + b.lines, words: a.words + b.words, chars: a.chars + b.chars, bytes: a.bytes + b.bytes, maxlen: m };
}

struct Show { lines: boolean, words: boolean, chars: boolean, bytes: boolean, maxlen: boolean }

function show_count(s: Show): i32 {
  let n = 0;
  if (s.lines) {
    n += 1;
  }
  if (s.words) {
    n += 1;
  }
  if (s.chars) {
    n += 1;
  }
  if (s.bytes) {
    n += 1;
  }
  if (s.maxlen) {
    n += 1;
  }
  return n;
}

function is_print(b: i32): boolean {
  return b >= 32 && b < 127;
}

struct Scan { in_word: boolean, linepos: i64 }

function scan_width(c: Counts, st: Scan, s: u8[], other: u8[]): (Counts, Scan) {
  let lines = c.lines;
  let maxlen = c.maxlen;
  let pos = st.linepos;
  let n = s.len();
  let i = 0;
  while (i < n) {
    let j = __scan_set_bytes(s, i, other);
    pos = pos + (j - i) as i64;
    if (j >= n) {
      break;
    }
    let b = s[j] as i32;
    if (b == 10 || b == 13 || b == 12) {
      if (b == 10) {
        lines = lines + 1 as i64;
      }
      if (pos > maxlen) {
        maxlen = pos;
      }
      pos = 0 as i64;
    } else if (b == 9) {
      pos = pos + 8 as i64 - pos % (8 as i64);
    }
    i = j + 1;
  }
  return (Counts { ...c, lines: lines, maxlen: maxlen }, Scan { ...st, linepos: pos });
}

function other_table(): u8[] {
  let t = __alloc_u8(256);
  let b = 0;
  while (b < 256) {
    if (b < 32 || b > 126) {
      t = t.with(b, 1 as u8);
    }
    b += 1;
  }
  return t;
}

function space_table(): u8[] {
  let t = __alloc_u8(256);
  t = t.with(32, 1 as u8);
  let b = 9;
  while (b <= 13) {
    t = t.with(b, 1 as u8);
    b += 1;
  }
  match (env("POSIXLY_CORRECT")) {
    None => {
      t = t.with(160, 1 as u8);
    },
    Some(_) => {}
  }
  return t;
}

function count_words(c: Counts, st: Scan, s: u8[], space: u8[]): (Counts, Scan) {
  let inside = 1;
  if (st.in_word) {
    inside = 0;
  }
  let ends = __count_runs_bytes(s, inside, space);
  let in_word = space[s[s.len() - 1] as i32] as i32 == 0;
  return (Counts { ...c, words: c.words + ends as i64 }, Scan { ...st, in_word: in_word });
}

function count_stream(r: Reader, show: Show): (Counts, Option[IoError]) {
  let c = zero_counts();
  let st = Scan { in_word: false, linepos: 0 as i64 };
  let space = space_table();
  let other = other_table();
  while (true) {
    match (r.read_chunk_bytes(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          if (st.linepos > c.maxlen) {
            c = Counts { ...c, maxlen: st.linepos };
          }
          if (st.in_word) {
            c = Counts { ...c, words: c.words + 1 as i64 };
          }
          return (c, None);
        }
        c = Counts { ...c, bytes: c.bytes + chunk.len() as i64 };
        if (show.maxlen) {
          let r2: (Counts, Scan) = scan_width(c, st, chunk, other);
          c = r2.0;
          st = r2.1;
        } else if (show.lines) {
          c = Counts { ...c, lines: c.lines + __count_byte_bytes(chunk, 10) as i64 };
        }
        if (show.words) {
          let r3: (Counts, Scan) = count_words(c, st, chunk, space);
          c = r3.0;
          st = r3.1;
        }
      },
      Err(e) => {
        if (st.linepos > c.maxlen) {
          c = Counts { ...c, maxlen: st.linepos };
        }
        if (st.in_word) {
          c = Counts { ...c, words: c.words + 1 as i64 };
        }
        return (c, Some(e));
      }
    }
  }
  return (c, None);
}

function read_size(): i32 {
  return 65536;
}

function field(n: i64, width: i32): string {
  let s = n.to_string();
  let pad = width - s.len();
  if (pad <= 0) {
    return s;
  }
  return " ".repeat(pad) + s;
}

function line_for(c: Counts, show: Show, width: i32, name: string, named: boolean): string {
  let out = "";
  let first = true;
  if (show.lines) {
    out += field(c.lines, width);
    first = false;
  }
  if (show.words) {
    if (!first) {
      out += " ";
    }
    out += field(c.words, width);
    first = false;
  }
  if (show.chars) {
    if (!first) {
      out += " ";
    }
    out += field(c.chars, width);
    first = false;
  }
  if (show.bytes) {
    if (!first) {
      out += " ";
    }
    out += field(c.bytes, width);
    first = false;
  }
  if (show.maxlen) {
    if (!first) {
      out += " ";
    }
    out += field(c.maxlen, width);
  }
  if (named) {
    out = out + " " + name;
  }
  return out + "\n";
}

function total_auto(): i32 {
  return 0;
}

function total_always(): i32 {
  return 1;
}

function total_only(): i32 {
  return 2;
}

function total_never(): i32 {
  return 3;
}

function total_of(v: string): i32 {
  return gnu.argmatch(v, ["auto", "always", "only", "never"], "--total");
}

struct Job { path: string, name: string, origin: string }

function read_names(file: string): Option[Job[]] {
  let from_stdin = file == "-";
  let r = stdin();
  if (!from_stdin) {
    match (open_reader(file)) {
      Ok(f) => {
        r = f;
      },
      Err(e) => {
        gnu.error("cannot open " + gnu.quotea(file) + " for reading: " + gnu.io_error_text(e));
        return None;
      }
    }
  }
  let data: u8[] = [];
  let result = io.read_all_bytes(r);
  if (!from_stdin) {
    r.close();
  }
  match (result) {
    Ok(bytes) => {
      data = bytes;
    },
    Err(e) => {
      gnu.error(gnu.quotef(file) + ": read error: " + gnu.io_error_text(e));
      return None;
    }
  }
  let jobs: Job[] = [];
  let start = 0;
  let n = 0;
  while (start < data.len()) {
    let end = __memchr_bytes(data, 0, start);
    if (end < 0) {
      end = data.len();
    }
    n += 1;
    let origin = gnu.quotef(file) + ":" + n.to_string();
    let name = "";
    match (utf8.from_bytes(array.slice(data, start, end))) {
      Ok(text) => {
        name = text;
      },
      Err(_) => {
        gnu.error(origin + ": invalid UTF-8 file name");
        return None;
      }
    }
    if (name == "-" && from_stdin) {
      gnu.error("when reading file names from standard input, no file name of '-' allowed");
      return None;
    }
    jobs = jobs.append(Job { path: name, name: name, origin: origin });
    start = end + 1;
  }
  return Some(jobs);
}

function width_for(jobs: Job[], show: Show, total: i32): i32 {
  if (total == total_only()) {
    return 1;
  }
  if (jobs.len() <= 1 && show_count(show) == 1) {
    return 1;
  }
  let min = 1;
  let sum = 0 as i64;
  let i = 0;
  while (i < jobs.len()) {
    match (job_stat(jobs[i].path)) {
      Ok(st) => {
        if (st.is_file) {
          sum += st.size;
        } else {
          min = 7;
        }
      },
      Err(_) => {}
    }
    i += 1;
  }
  let w = 1;
  let v = sum;
  while (v >= 10 as i64) {
    v /= 10 as i64;
    w += 1;
  }
  if (w < min) {
    return min;
  }
  return w;
}

function job_stat(path: string): Result[FileStat, IoError] {
  if (path == "-") {
    return stdin().stat();
  }
  return stat(path);
}

struct Done { counts: Counts, counted: boolean, failed: boolean, w: io_buffered.BufWriter }

function job_label(job: Job): string {
  if (job.name.len() == 0) {
    return gnu.quotef("standard input");
  }
  return gnu.quotef(job.path);
}

function count_job(job: Job, show: Show, o: io_buffered.BufWriter): Done {
  let w = o;
  if (job.path.len() == 0) {
    let where = "";
    if (job.origin.len() > 0) {
      where = job.origin + ": ";
    }
    w = gnu.error_out(w, where + "invalid zero-length file name");
    return Done { counts: zero_counts(), counted: false, failed: true, w: w };
  }
  let r = stdin();
  if (job.path != "-") {
    match (open_reader(job.path)) {
      Ok(f) => {
        r = f;
      },
      Err(e) => {
        w = gnu.error_out(w, job_label(job) + ": " + gnu.io_error_text(e));
        return Done { counts: zero_counts(), counted: false, failed: true, w: w };
      }
    }
    if (show.bytes && !show.lines && !show.words && !show.chars && !show.maxlen) {
      match (stat(job.path)) {
        Ok(st) => {
          if (st.is_file) {
            r.close();
            return Done { counts: Counts { ...zero_counts(), bytes: st.size }, counted: true, failed: false, w: w };
          }
        },
        Err(_) => {}
      }
    }
  }
  let res: (Counts, Option[IoError]) = count_stream(r, show);
  if (job.path != "-") {
    r.close();
  }
  let c = Counts { ...res.0, chars: res.0.bytes };
  match (res.1) {
    Some(e) => {
      w = gnu.error_out(w, job_label(job) + ": " + gnu.io_error_text(e));
      return Done { counts: c, counted: true, failed: true, w: w };
    },
    None => {}
  }
  return Done { counts: c, counted: true, failed: false, w: w };
}

pub function main(): i32 {
  let argv = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("c", "bytes", opt_bytes()));
  opts = opts.append(gnu.flag("m", "chars", opt_chars()));
  opts = opts.append(gnu.flag("l", "lines", opt_lines()));
  opts = opts.append(gnu.flag("w", "words", opt_words()));
  opts = opts.append(gnu.flag("", "debug", opt_debug()));
  opts = opts.append(gnu.valued("", "files0-from", opt_files0()));
  opts = opts.append(gnu.flag("L", "max-line-length", opt_maxlen()));
  opts = opts.append(gnu.valued("", "total", opt_total()));

  let show = Show { lines: false, words: false, chars: false, bytes: false, maxlen: false };
  let any = false;
  let total_when = total_auto();
  let files0 = "";
  let have_files0 = false;

  let g = gnu.getopt_new(argv, opts, "wc", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_bytes()) {
          show = Show { ...show, bytes: true };
          any = true;
        } else if (m.id == opt_chars()) {
          show = Show { ...show, chars: true };
          any = true;
        } else if (m.id == opt_lines()) {
          show = Show { ...show, lines: true };
          any = true;
        } else if (m.id == opt_words()) {
          show = Show { ...show, words: true };
          any = true;
        } else if (m.id == opt_maxlen()) {
          show = Show { ...show, maxlen: true };
          any = true;
        } else if (m.id == opt_files0()) {
          files0 = m.value;
          have_files0 = true;
        } else if (m.id == opt_total()) {
          total_when = total_of(m.value);
        }
      },
      None => {
        break;
      }
    }
  }
  if (!any) {
    show = Show { lines: true, words: true, chars: false, bytes: true, maxlen: false };
  }

  let operands = g.operands();
  let jobs: Job[] = [];
  if (have_files0) {
    if (operands.len() > 0) {
      gnu.error("extra operand " + gnu.quote(operands[0]) + "\nfile operands cannot be combined with --files0-from");
      gnu.try_help(1);
    }
    match (read_names(files0)) {
      Some(names) => {
        jobs = names;
      },
      None => {
        return 1;
      }
    }
  } else if (operands.len() == 0) {
    jobs = jobs.append(Job { path: "-", name: "", origin: "" });
  } else {
    let i = 0;
    while (i < operands.len()) {
      jobs = jobs.append(Job { path: operands[i], name: operands[i], origin: "" });
      i += 1;
    }
  }

  let width = width_for(jobs, show, total_when);
  let out = gnu.out_new();
  let total = zero_counts();
  let ok = true;
  let i = 0;
  while (i < jobs.len()) {
    let res = count_job(jobs[i], show, out);
    out = res.w;
    if (res.failed) {
      ok = false;
    }
    if (res.counted) {
      total = add_counts(total, res.counts);
      if (total_when != total_only()) {
        out = gnu.put(out, line_for(res.counts, show, width, jobs[i].name, jobs[i].name.len() > 0));
      }
    }
    i += 1;
  }
  let show_total = total_when == total_always() || total_when == total_only() || total_when == total_auto() && jobs.len() > 1;
  if (show_total) {
    let named = total_when != total_only();
    out = gnu.put(out, line_for(total, show, width, "total", named));
  }
  gnu.close_stdout(out, false);
  if (!ok) {
    return 1;
  }
  return 0;
}
