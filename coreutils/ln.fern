import "std/string";
import "std/array";
import "std/io_buffered";
import "std/errno";
import "./lib/gnu";
import "./lib/canon";

function opt_backup(): i32 {
  return 1;
}

function opt_directory(): i32 {
  return 2;
}

function opt_no_dereference(): i32 {
  return 3;
}

function opt_no_target_directory(): i32 {
  return 4;
}

function opt_force(): i32 {
  return 5;
}

function opt_interactive(): i32 {
  return 6;
}

function opt_suffix(): i32 {
  return 7;
}

function opt_target_directory(): i32 {
  return 8;
}

function opt_logical(): i32 {
  return 9;
}

function opt_physical(): i32 {
  return 10;
}

function opt_relative(): i32 {
  return 11;
}

function opt_symbolic(): i32 {
  return 12;
}

function opt_verbose(): i32 {
  return 13;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [-T] TARGET LINK_NAME\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... TARGET\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... TARGET... DIRECTORY\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... -t DIRECTORY TARGET...\n";
  out = out + "Create a link to each TARGET, hard by default.\n";
  out = out + "\n";
  out = out + "      --backup[=CONTROL]      back up each existing destination\n";
  out = out + "  -b                          like --backup, taking no argument\n";
  out = out + "  -d, -F, --directory         allow a hard link to a directory\n";
  out = out + "  -f, --force                 remove existing destinations\n";
  out = out + "  -i, --interactive           prompt before removing a destination\n";
  out = out + "  -L, --logical               follow a TARGET that is a symbolic link\n";
  out = out + "  -n, --no-dereference        treat a LINK_NAME that is a symbolic link\n";
  out = out + "                                to a directory as a normal file\n";
  out = out + "  -P, --physical              hard-link the symbolic link itself\n";
  out = out + "  -r, --relative              with -s, store the target relative to the link\n";
  out = out + "  -s, --symbolic              make symbolic links\n";
  out = out + "  -S, --suffix=SUFFIX         the simple backup suffix, instead of '~'\n";
  out = out + "  -t, --target-directory=DIRECTORY  create the links in DIRECTORY\n";
  out = out + "  -T, --no-target-directory   treat LINK_NAME as a normal file always\n";
  out = out + "  -v, --verbose               print each link as it is made\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "The backup suffix is '~' unless -S or SIMPLE_BACKUP_SUFFIX says otherwise,\n";
  out = out + "and the control is --backup's argument or VERSION_CONTROL: none/off,\n";
  out = out + "numbered/t, existing/nil (numbered if a numbered backup is there, else\n";
  out = out + "simple), simple/never.\n";
  return out;
}

struct Cfg { symbolic: boolean, force: boolean, interactive: boolean, no_deref: boolean, deref_src: boolean, hard_dir: boolean, relative: boolean, verbose: boolean, backups: boolean, control: i32, suffix: string }

function resolved(p: string): string {
  match (canon.canonicalize(p, canon.missing(), false)) {
    Ok(r) => {
      return r;
    },
    Err(_) => {
      return p;
    }
  }
}

function relativise(target: string, dest: string): string {
  return canon.relative(resolved(target), resolved(gnu.dir_name(dest)));
}

struct StatInfo { ok: boolean, is_dir: boolean, dev: i64, ino: i64, err: string }

function stat_info(path: string, follow: boolean): StatInfo {
  if (follow) {
    match (stat(path)) {
      Ok(st) => {
        return StatInfo { ok: true, is_dir: st.is_dir, dev: st.dev, ino: st.ino, err: "" };
      },
      Err(e) => {
        return StatInfo { ok: false, is_dir: false, dev: 0, ino: 0, err: gnu.io_error_text(e) };
      }
    }
  }
  match (lstat(path)) {
    Ok(st) => {
      return StatInfo { ok: true, is_dir: st.is_dir, dev: st.dev, ino: st.ino, err: "" };
    },
    Err(e) => {
      return StatInfo { ok: false, is_dir: false, dev: 0, ino: 0, err: gnu.io_error_text(e) };
    }
  }
}

function same_entry(cfg: Cfg, src: string, dest: string): boolean {
  let s: StatInfo = stat_info(src, cfg.symbolic || cfg.deref_src);
  let d: StatInfo = stat_info(dest, false);
  if (!s.ok || !d.ok || s.dev != d.dev || s.ino != d.ino) {
    return false;
  }
  if (gnu.base_name(src) != gnu.base_name(dest)) {
    return false;
  }
  let sd: StatInfo = stat_info(gnu.dir_name(src), true);
  let dd: StatInfo = stat_info(gnu.dir_name(dest), true);
  return sd.ok && dd.ok && sd.dev == dd.dev && sd.ino == dd.ino;
}

function hard_link_no_arrow(n: i32): boolean {
  return n == errno.EEXIST || n == errno.ENOSPC || n == errno.EROFS || n == errno.EDQUOT;
}

function create_failure(cfg: Cfg, dest: string, shown_target: string, e: IoError): string {
  let text: string = gnu.io_error_text(e);
  if (cfg.symbolic) {
    let arrow: string = "";
    if (errno.of(e) == errno.ENAMETOOLONG || shown_target.len() == 0) {
      arrow = " -> " + gnu.quotea(shown_target);
    }
    return "failed to create symbolic link " + gnu.quotea(dest) + arrow + ": " + text;
  }
  let harrow: string = "";
  if (!hard_link_no_arrow(errno.of(e))) {
    harrow = " => " + gnu.quotea(shown_target);
  }
  return "failed to create hard link " + gnu.quotea(dest) + harrow + ": " + text;
}

function make_link(cfg: Cfg, src: string, text: string, path: string): Option[IoError] {
  if (cfg.symbolic) {
    match (create_symlink(text, path)) {
      Ok(_) => {
        return None;
      },
      Err(e) => {
        return Some(e);
      }
    }
  }
  if (target_os() == "darwin") {
    match (darwin_slash_refusal(cfg, src, path)) {
      Some(e) => {
        return Some(e);
      },
      None => {}
    }
  }
  match (create_link(src, path)) {
    Ok(_) => {
      return None;
    },
    Err(e) => {
      return Some(e);
    }
  }
}

function darwin_slash_refusal(cfg: Cfg, src: string, path: string): Option[IoError] {
  if (!ends_in_slash(src) && !ends_in_slash(path)) {
    return None;
  }
  let r: Result[FileStat, IoError] = lstat(src);
  if (cfg.deref_src) {
    r = stat(src);
  }
  match (r) {
    Err(e) => {
      return Some(e);
    },
    Ok(st) => {
      if (st.is_dir) {
        return None;
      }
    }
  }
  return Some(Other(src, gnu.exec_errno_text(20), errno.ENOTDIR));
}

function ends_in_slash(p: string): boolean {
  return p.len() > 0 && p[p.len() - 1] as i32 == 47;
}

function temp_link(cfg: Cfg, src: string, text: string, dest: string): Result[string, IoError] {
  let dir: string = gnu.dir_name(dest);
  let n: i32 = 0;
  while (n < 1000) {
    let path: string = gnu.join_path(dir, ".ln-tmp" + n.to_string());
    match (make_link(cfg, src, text, path)) {
      None => {
        return Ok(path);
      },
      Some(e) => {
        if (errno.of(e) != errno.EEXIST) {
          return Err(e);
        }
      }
    }
    n = n + 1;
  }
  return Err(AlreadyExists(dest));
}

struct Replaced { ok: boolean, backup: string, out: io_buffered.BufWriter }

function replace_existing(cfg: Cfg, target: string, src: string, text: string, shown: string, dest: string, err: IoError, o: io_buffered.BufWriter): Replaced {
  let w: io_buffered.BufWriter = o;
  if (errno.of(err) != errno.EEXIST || !cfg.force && !cfg.interactive && !cfg.backups) {
    w = gnu.error_out(w, create_failure(cfg, dest, shown, err));
    return Replaced { ok: false, backup: "", out: w };
  }
  let dst: StatInfo = stat_info(dest, false);
  if (dst.ok && dst.is_dir) {
    w = gnu.error_out(w, gnu.quotef(dest) + ": cannot overwrite directory");
    return Replaced { ok: false, backup: "", out: w };
  }
  if (cfg.force && same_entry(cfg, target, dest)) {
    w = gnu.error_out(w, gnu.quotea(target) + " and " + gnu.quotea(dest) + " are the same file");
    return Replaced { ok: false, backup: "", out: w };
  }
  if (cfg.interactive) {
    w = gnu.flush(w);
    if (!gnu.prompt("replace " + gnu.quotea(dest) + "? ")) {
      return Replaced { ok: false, backup: "", out: w };
    }
  }
  let tmp_path: string = "";
  match (temp_link(cfg, src, text, dest)) {
    Ok(p) => {
      tmp_path = p;
    },
    Err(e) => {
      w = gnu.error_out(w, create_failure(cfg, dest, shown, e));
      return Replaced { ok: false, backup: "", out: w };
    }
  }
  let backup: string = "";
  if (cfg.backups) {
    backup = gnu.backup_name(dest, cfg.control, cfg.suffix);
    match (rename(dest, backup)) {
      Ok(_) => {},
      Err(e) => {
        drop_temp(tmp_path);
        if (errno.of(e) == errno.ENOENT) {
          w = gnu.error_out(w, create_failure(cfg, dest, shown, err));
          return Replaced { ok: false, backup: "", out: w };
        }
        w = gnu.error_out(w, "cannot backup " + gnu.quotea(dest) + ": " + gnu.io_error_text(e));
        return Replaced { ok: false, backup: "", out: w };
      }
    }
  } else {
    drop_temp(dest);
  }
  match (rename(tmp_path, dest)) {
    Ok(_) => {},
    Err(e) => {
      drop_temp(tmp_path);
      w = gnu.error_out(w, create_failure(cfg, dest, shown, e));
      return Replaced { ok: false, backup: "", out: w };
    }
  }
  return Replaced { ok: true, backup: backup, out: w };
}

function drop_temp(path: string): void {
  match (remove_file(path)) {
    Ok(_) => {},
    Err(_) => {}
  }
}

struct LinkOut { status: i32, out: io_buffered.BufWriter }

function do_link(cfg: Cfg, target: string, dest: string, o: io_buffered.BufWriter): LinkOut {
  let w: io_buffered.BufWriter = o;
  let text: string = target;
  if (cfg.symbolic && cfg.relative) {
    text = relativise(target, dest);
  }
  let shown: string = target;
  if (cfg.symbolic) {
    shown = text;
  }
  let src: string = target;
  if (!cfg.symbolic) {
    let st: StatInfo = stat_info(target, cfg.deref_src);
    if (!st.ok) {
      w = gnu.error_out(w, "failed to access " + gnu.quotea(target) + ": " + st.err);
      return LinkOut { status: 1, out: w };
    }
    if (st.is_dir && !cfg.hard_dir) {
      w = gnu.error_out(w, gnu.quotef(target) + ": hard link not allowed for directory");
      return LinkOut { status: 1, out: w };
    }
    if (cfg.deref_src) {
      src = resolved(target);
    }
  }

  let backup: string = "";
  match (make_link(cfg, src, text, dest)) {
    None => {},
    Some(err) => {
      let r: Replaced = replace_existing(cfg, target, src, text, shown, dest, err, w);
      w = r.out;
      if (!r.ok) {
        return LinkOut { status: 1, out: w };
      }
      backup = r.backup;
    }
  }
  if (cfg.verbose) {
    let line: string = "";
    if (backup.len() > 0) {
      line = gnu.quotea(backup) + " ~ ";
    }
    let arrow: string = " => ";
    if (cfg.symbolic) {
      arrow = " -> ";
    }
    w = gnu.put(w, line + gnu.quotea(dest) + arrow + gnu.quotea(shown) + "\n");
  }
  return LinkOut { status: 0, out: w };
}

function require_directory(dir: string, follow: boolean): void {
  let st: StatInfo = stat_info(dir, follow);
  if (!st.ok) {
    gnu.error("target " + gnu.quotea(dir) + ": " + st.err);
    exit(1);
  }
  if (!st.is_dir) {
    gnu.error("target " + gnu.quotea(dir) + ": Not a directory");
    exit(1);
  }
}

function check_target_directory(dir: string): void {
  let st: StatInfo = stat_info(dir, true);
  if (!st.ok) {
    gnu.error("failed to access " + gnu.quotea(dir) + ": " + st.err);
    exit(1);
  }
  if (!st.is_dir) {
    gnu.error("target " + gnu.quotea(dir) + " is not a directory");
    exit(1);
  }
}

function option_table(): gnu.Opt[] {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.optional_long("b", "backup", opt_backup()));
  opts = opts.append(gnu.flag("d", "directory", opt_directory()));
  opts = opts.append(gnu.flag("F", "", opt_directory()));
  opts = opts.append(gnu.flag("n", "no-dereference", opt_no_dereference()));
  opts = opts.append(gnu.flag("T", "no-target-directory", opt_no_target_directory()));
  opts = opts.append(gnu.flag("f", "force", opt_force()));
  opts = opts.append(gnu.flag("i", "interactive", opt_interactive()));
  opts = opts.append(gnu.valued("S", "suffix", opt_suffix()));
  opts = opts.append(gnu.valued("t", "target-directory", opt_target_directory()));
  opts = opts.append(gnu.flag("L", "logical", opt_logical()));
  opts = opts.append(gnu.flag("P", "physical", opt_physical()));
  opts = opts.append(gnu.flag("r", "relative", opt_relative()));
  opts = opts.append(gnu.flag("s", "symbolic", opt_symbolic()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));
  return opts;
}

struct Scan { cfg: Cfg, control_given: boolean, control_text: string, suffix_given: boolean, target_dir: string, have_target_dir: boolean, no_target_dir: boolean }

function scan_options(argv: string[]): (Scan, string[]) {
  let cfg: Cfg = Cfg { symbolic: false, force: false, interactive: false, no_deref: false, deref_src: target_os() == "darwin", hard_dir: false, relative: false, verbose: false, backups: false, control: gnu.backup_existing(), suffix: "~" };
  let s: Scan = Scan { cfg: cfg, control_given: false, control_text: "", suffix_given: false, target_dir: "", have_target_dir: false, no_target_dir: false };
  let g: gnu.Getopt = gnu.getopt_new(argv, option_table(), "ln", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        s = apply_option(s, m);
      },
      None => {
        break;
      }
    }
  }
  return (s, g.operands());
}

function apply_option(s: Scan, m: gnu.OptMatch): Scan {
  let c: Cfg = s.cfg;
  if (m.id == opt_backup()) {
    if (m.has_value) {
      return Scan { ...s, cfg: Cfg { ...c, backups: true }, control_given: true, control_text: m.value };
    }
    return Scan { ...s, cfg: Cfg { ...c, backups: true } };
  }
  if (m.id == opt_directory()) {
    return Scan { ...s, cfg: Cfg { ...c, hard_dir: true } };
  }
  if (m.id == opt_no_dereference()) {
    return Scan { ...s, cfg: Cfg { ...c, no_deref: true } };
  }
  if (m.id == opt_no_target_directory()) {
    return Scan { ...s, no_target_dir: true };
  }
  if (m.id == opt_force()) {
    return Scan { ...s, cfg: Cfg { ...c, force: true, interactive: false } };
  }
  if (m.id == opt_interactive()) {
    return Scan { ...s, cfg: Cfg { ...c, interactive: true, force: false } };
  }
  if (m.id == opt_suffix()) {
    let suf: string = c.suffix;
    if (gnu.usable_suffix(m.value)) {
      suf = m.value;
    }
    return Scan { ...s, cfg: Cfg { ...c, backups: true, suffix: suf }, suffix_given: true };
  }
  if (m.id == opt_target_directory()) {
    if (s.have_target_dir) {
      gnu.error("multiple target directories specified");
      exit(1);
    }
    check_target_directory(m.value);
    return Scan { ...s, target_dir: m.value, have_target_dir: true };
  }
  if (m.id == opt_logical()) {
    return Scan { ...s, cfg: Cfg { ...c, deref_src: true } };
  }
  if (m.id == opt_physical()) {
    return Scan { ...s, cfg: Cfg { ...c, deref_src: false } };
  }
  if (m.id == opt_relative()) {
    return Scan { ...s, cfg: Cfg { ...c, relative: true } };
  }
  if (m.id == opt_symbolic()) {
    return Scan { ...s, cfg: Cfg { ...c, symbolic: true } };
  }
  return Scan { ...s, cfg: Cfg { ...c, verbose: true } };
}

function from_environment(s: Scan): Cfg {
  let c: Cfg = s.cfg;
  if (!c.backups) {
    return c;
  }
  if (!s.suffix_given) {
    match (env("SIMPLE_BACKUP_SUFFIX")) {
      Some(v) => {
        if (gnu.usable_suffix(v)) {
          c = Cfg { ...c, suffix: v };
        }
      },
      None => {}
    }
  }
  let control: i32 = gnu.backup_existing();
  if (s.control_given) {
    if (s.control_text.len() > 0) {
      control = gnu.argmatch_valued(s.control_text, gnu.backup_names(), gnu.backup_values(), "backup type");
    }
  } else {
    match (env("VERSION_CONTROL")) {
      Some(v) => {
        if (v.len() > 0) {
          control = gnu.argmatch_valued(v, gnu.backup_names(), gnu.backup_values(), "$VERSION_CONTROL");
        }
      },
      None => {}
    }
  }
  if (control == gnu.backup_none()) {
    return Cfg { ...c, backups: false, control: control };
  }
  return Cfg { ...c, control: control };
}

pub function main(): i32 {
  let scanned: (Scan, string[]) = scan_options(args());
  let s: Scan = scanned.0;
  let operands: string[] = scanned.1;
  if (s.have_target_dir && s.no_target_dir) {
    gnu.error("cannot combine --target-directory and --no-target-directory");
    return 1;
  }
  let cfg: Cfg = from_environment(s);
  if (cfg.relative && !cfg.symbolic) {
    gnu.error("cannot do --relative without --symbolic");
    return 1;
  }
  if (operands.len() == 0) {
    gnu.die_usage("missing file operand", 1);
  }

  let o: io_buffered.BufWriter = gnu.out_new();
  if (s.have_target_dir) {
    require_directory(s.target_dir, !cfg.no_deref);
    let r0: LinkOut = link_into(cfg, operands, operands.len(), s.target_dir, o);
    return finish(r0.out, r0.status);
  }
  if (s.no_target_dir) {
    if (operands.len() == 1) {
      gnu.die_usage("missing destination file operand after " + gnu.quotea(operands[0]), 1);
    }
    if (operands.len() > 2) {
      gnu.die_usage("extra operand " + gnu.quotea(operands[2]), 1);
    }
    let r1: LinkOut = do_link(cfg, operands[0], operands[1], o);
    return finish(r1.out, r1.status);
  }
  if (operands.len() == 1) {
    let r2: LinkOut = do_link(cfg, operands[0], "./" + gnu.base_name(operands[0]), o);
    return finish(r2.out, r2.status);
  }
  if (operands.len() == 2) {
    let last: string = operands[1];
    let st: StatInfo = stat_info(last, !cfg.no_deref);
    if (st.ok && st.is_dir) {
      let r3: LinkOut = link_into(cfg, operands, 1, last, o);
      return finish(r3.out, r3.status);
    }
    let r4: LinkOut = do_link(cfg, operands[0], last, o);
    return finish(r4.out, r4.status);
  }
  let dir: string = operands[operands.len() - 1];
  require_directory(dir, !cfg.no_deref);
  let r5: LinkOut = link_into(cfg, operands, operands.len() - 1, dir, o);
  return finish(r5.out, r5.status);
}

function link_into(cfg: Cfg, operands: string[], count: i32, dir: string, o: io_buffered.BufWriter): LinkOut {
  let w: io_buffered.BufWriter = o;
  let status: i32 = 0;
  let i: i32 = 0;
  while (i < count) {
    let r: LinkOut = do_link(cfg, operands[i], gnu.join_path(dir, gnu.base_name(operands[i])), w);
    w = r.out;
    if (r.status != 0) {
      status = 1;
    }
    i = i + 1;
  }
  return LinkOut { status: status, out: w };
}

function finish(o: io_buffered.BufWriter, status: i32): i32 {
  gnu.finish(o);
  return status;
}
