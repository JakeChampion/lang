// date.fern — GNU-compatible `date`.
//
//   date [OPTION]... [+FORMAT]
//   date [-u|--utc|--universal] [MMDDhhmm[[CC]YY][.ss]]
//
// One instant, chosen by the options — the clock, `-d STRING` through
// the date grammar in `lib/datetime`, `-r FILE`'s modification time,
// `--resolution`'s tick, or each line of `-f FILE` in turn — and one
// format, `+FORMAT` or the one `-I`, `-R` and `--rfc-3339` stand for,
// rendered by `lib/timefmt`'s strftime in the local zone `-u` may
// replace with UTC.
//
// The clock is read, never written: `-s STRING` and the operand form
// parse their argument as GNU does and then report `cannot set date`
// as an unprivileged GNU date would, because no Fern builtin sets the
// system clock (docs/COREUTILS.md).
import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/tz";
import "./lib/timefmt";
import "./lib/datetime";

function opt_date(): i32 {
  return 1;
}

function opt_debug(): i32 {
  return 2;
}

function opt_file(): i32 {
  return 3;
}

function opt_iso(): i32 {
  return 4;
}

function opt_reference(): i32 {
  return 5;
}

function opt_resolution(): i32 {
  return 6;
}

function opt_rfc_email(): i32 {
  return 7;
}

function opt_rfc_3339(): i32 {
  return 8;
}

function opt_set(): i32 {
  return 9;
}

function opt_utc(): i32 {
  return 10;
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [+FORMAT]\n";
  out = out + "  or:  " + gnu.prog() + " [-u|--utc|--universal] [MMDDhhmm[[CC]YY][.ss]]\n";
  out = out + "Display date and time in the given FORMAT.\n";
  out = out + "With -s, or with [MMDDhhmm[[CC]YY][.ss]], set the date and time.\n";
  out = out + "\n";
  out = out + "Mandatory arguments to long options are mandatory for short options too.\n";
  out = out + "  -d, --date=STRING          display time described by STRING, not 'now'\n";
  out = out + "      --debug                annotate the parsed date,\n";
  out = out + "                              and warn about questionable usage to stderr\n";
  out = out + "  -f, --file=DATEFILE        like --date; once for each line of DATEFILE\n";
  out = out + "  -I[FMT], --iso-8601[=FMT]  output date/time in ISO 8601 format.\n";
  out = out + "                               FMT='date' for date only (the default),\n";
  out = out + "                               'hours', 'minutes', 'seconds', or 'ns'\n";
  out = out + "                               for date and time to the indicated precision.\n";
  out = out + "                               Example: 2006-08-14T02:34:56-06:00\n";
  out = out + "  --resolution               output the available resolution of timestamps\n";
  out = out + "                               Example: 0.000000001\n";
  out = out + "  -R, --rfc-email            output date and time in RFC 5322 format.\n";
  out = out + "                               Example: Mon, 14 Aug 2006 02:34:56 -0600\n";
  out = out + "      --rfc-3339=FMT         output date/time in RFC 3339 format.\n";
  out = out + "                               FMT='date', 'seconds', or 'ns'\n";
  out = out + "                               for date and time to the indicated precision.\n";
  out = out + "                               Example: 2006-08-14 02:34:56-06:00\n";
  out = out + "  -r, --reference=FILE       display the last modification time of FILE\n";
  out = out + "  -s, --set=STRING           set time described by STRING\n";
  out = out + "  -u, --utc, --universal     print or set Coordinated Universal Time (UTC)\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "All options that specify the date to display are mutually exclusive.\n";
  out = out + "I.e.: --date, --file, --reference, --resolution.\n";
  out = out + "\n";
  out = out + "FORMAT controls the output.  Interpreted sequences are:\n";
  out = out + "\n";
  out = out + "  %%   a literal %\n";
  out = out + "  %a   locale's abbreviated weekday name (e.g., Sun)\n";
  out = out + "  %A   locale's full weekday name (e.g., Sunday)\n";
  out = out + "  %b   locale's abbreviated month name (e.g., Jan)\n";
  out = out + "  %B   locale's full month name (e.g., January)\n";
  out = out + "  %c   locale's date and time (e.g., Thu Mar  3 23:05:25 2005)\n";
  out = out + "  %C   century; like %Y, except omit last two digits (e.g., 20)\n";
  out = out + "  %d   day of month (e.g., 01)\n";
  out = out + "  %D   date; same as %m/%d/%y\n";
  out = out + "  %e   day of month, space padded; same as %_d\n";
  out = out + "  %F   full date; like %+4Y-%m-%d\n";
  out = out + "  %g   last two digits of year of ISO week number (see %G)\n";
  out = out + "  %G   year of ISO week number (see %V); normally useful only with %V\n";
  out = out + "  %h   same as %b\n";
  out = out + "  %H   hour (00..23)\n";
  out = out + "  %I   hour (01..12)\n";
  out = out + "  %j   day of year (001..366)\n";
  out = out + "  %k   hour, space padded ( 0..23); same as %_H\n";
  out = out + "  %l   hour, space padded ( 1..12); same as %_I\n";
  out = out + "  %m   month (01..12)\n";
  out = out + "  %M   minute (00..59)\n";
  out = out + "  %n   a newline\n";
  out = out + "  %N   nanoseconds (000000000..999999999)\n";
  out = out + "  %p   locale's equivalent of either AM or PM; blank if not known\n";
  out = out + "  %P   like %p, but lower case\n";
  out = out + "  %q   quarter of year (1..4)\n";
  out = out + "  %r   locale's 12-hour clock time (e.g., 11:11:04 PM)\n";
  out = out + "  %R   24-hour hour and minute; same as %H:%M\n";
  out = out + "  %s   seconds since the Epoch (1970-01-01 00:00 UTC)\n";
  out = out + "  %S   second (00..60)\n";
  out = out + "  %t   a tab\n";
  out = out + "  %T   time; same as %H:%M:%S\n";
  out = out + "  %u   day of week (1..7); 1 is Monday\n";
  out = out + "  %U   week number of year, with Sunday as first day of week (00..53)\n";
  out = out + "  %V   ISO week number, with Monday as first day of week (01..53)\n";
  out = out + "  %w   day of week (0..6); 0 is Sunday\n";
  out = out + "  %W   week number of year, with Monday as first day of week (00..53)\n";
  out = out + "  %x   locale's date representation (e.g., 12/31/99)\n";
  out = out + "  %X   locale's time representation (e.g., 23:13:48)\n";
  out = out + "  %y   last two digits of year (00..99)\n";
  out = out + "  %Y   year\n";
  out = out + "  %z   +hhmm numeric time zone (e.g., -0400)\n";
  out = out + "  %:z  +hh:mm numeric time zone (e.g., -04:00)\n";
  out = out + "  %::z  +hh:mm:ss numeric time zone (e.g., -04:00:00)\n";
  out = out + "  %:::z  numeric time zone with : to necessary precision (e.g., -04, +05:30)\n";
  out = out + "  %Z   alphabetic time zone abbreviation (e.g., EDT)\n";
  out = out + "\n";
  out = out + "By default, date pads numeric fields with zeroes.\n";
  out = out + "The following optional flags may follow '%':\n";
  out = out + "\n";
  out = out + "  -  (hyphen) do not pad the field\n";
  out = out + "  _  (underscore) pad with spaces\n";
  out = out + "  0  (zero) pad with zeros\n";
  out = out + "  +  pad with zeros, and put '+' before future years with >4 digits\n";
  out = out + "  ^  use upper case if possible\n";
  out = out + "  #  use opposite case if possible\n";
  out = out + "\n";
  out = out + "After any flags comes an optional field width, as a decimal number;\n";
  out = out + "then an optional modifier, which is either\n";
  out = out + "E to use the locale's alternate representations if available, or\n";
  out = out + "O to use the locale's alternate numeric symbols if available.\n";
  out = out + "\n";
  out = out + "Examples:\n";
  out = out + "Convert seconds since the Epoch (1970-01-01 UTC) to a date\n";
  out = out + "  $ date --date='@2147483647'\n";
  out = out + "\n";
  out = out + "Show the time on the west coast of the US (use tzselect(1) to find TZ)\n";
  out = out + "  $ TZ='America/Los_Angeles' date\n";
  out = out + "\n";
  out = out + "Show the local time for 9AM next Friday on the west coast of the US\n";
  out = out + "  $ date --date='TZ=\"America/Los_Angeles\" 09:00 next Fri'\n";
  return out;
}

function rfc_email_format(): string {
  return "%a, %d %b %Y %H:%M:%S %z";
}

// The `-I` spellings, `hours` and `minutes` first because `--rfc-3339`
// takes only the last three.
function time_spec_names(): string[] {
  return ["hours", "minutes", "date", "seconds", "ns"];
}

function iso_formats(): string[] {
  return ["%Y-%m-%dT%H%:z", "%Y-%m-%dT%H:%M%:z", "%Y-%m-%d", "%Y-%m-%dT%H:%M:%S%:z", "%Y-%m-%dT%H:%M:%S,%N%:z"];
}

function rfc_3339_formats(): string[] {
  return ["%Y-%m-%d", "%Y-%m-%d %H:%M:%S%:z", "%Y-%m-%d %H:%M:%S.%N%:z"];
}

// `adjust_resolution(fmt)` — every `%-N` becomes `%9N`, the width the
// clock's nanosecond resolution needs.
function adjust_resolution(fmt: string): string {
  var out: string = "";
  var i: i32 = 0;
  while (i < fmt.len()) {
    if (fmt[i] as i32 == 37) {
      if (i + 2 < fmt.len() && fmt[i + 1] as i32 == 45 && fmt[i + 2] as i32 == 78) {
        out = out + "%9N";
        i = i + 3;
        continue;
      }
      if (i + 1 < fmt.len() && fmt[i + 1] as i32 == 37) {
        out = out + "%%";
        i = i + 2;
        continue;
      }
    }
    out = out + slice_unchecked(fmt, i, i + 1);
    i = i + 1;
  }
  return out;
}

// What the run prints with: the zone, the TZ value the debug trace
// names, the format, and whether the trace is wanted.
struct Show { zone: tz.Zone, tzstring: string, has_tz: boolean, format: string, debug: boolean }

// `show_date(o, s, sec, nsec)` — one formatted line, the format
// announced first under --debug.
//
// The newline is not part of the format and is written whatever the
// format did: an instant localtime refuses still ends a line, and so
// does a format that renders to nothing.
function show_date(o: io_buffered.BufWriter, s: Show, sec: i64, nsec: i64): (boolean, io_buffered.BufWriter) {
  var w: io_buffered.BufWriter = o;
  if (s.debug) {
    w = gnu.error_out(w, "output format: " + gnu.quote(s.format));
  }
  // localtime refuses an instant whose year does not fit an int.
  var year: i64 = s.zone.local_fields(sec).year - 1900 as i64;
  if (year > 2147483647 as i64 || year < 0 as i64 - 2147483648 as i64) {
    w = gnu.error_out(w, "time " + gnu.quote(sec.to_string()) + " is out of range");
    return (false, gnu.put(w, "\n"));
  }
  return (true, gnu.put(w, timefmt.strftime(s.format, s.zone, sec, nsec) + "\n"));
}

// `trace(r)` — the debug commentary a parse produced, on stderr. It
// does not flush stdout first: the original writes it straight to
// stderr, ahead of output still sitting in the stdout buffer.
function trace(r: datetime.Result): void {
  if (r.dbg.len() > 0) {
    eprint(slice_unchecked(r.dbg, 0, r.dbg.len() - 1) + "");
  }
}

function parse(s: Show, text: string, hint: i64): datetime.Result {
  var ns: i64 = now_ns();
  return datetime.parse_full(text, s.zone, s.tzstring, s.has_tz, ns / (1000000000 as i64), ns % (1000000000 as i64), hint, s.debug);
}

// `batch(o, s, name)` — `-f FILE`: each line parsed and printed, a
// line that does not parse costing the status and not the run.
function batch(o: io_buffered.BufWriter, s: Show, name: string): (boolean, io_buffered.BufWriter) {
  var w: io_buffered.BufWriter = o;
  var shown: string = name;
  var r: Reader = stdin();
  if (name == "-") {
    shown = "standard input";
  } else {
    match (open_reader(name)) {
      Ok(f) => {
        r = f;
      },
      Err(e) => {
        gnu.die(w, gnu.quotef(name) + ": " + gnu.io_error_text(e), 1);
      }
    }
  }
  var ok: boolean = true;
  var hint: i64 = 0;
  var lr: io_buffered.LineReader = io_buffered.line_reader_new(r, 10, 65536);
  while (true) {
    var next: (Option[string], io_buffered.LineReader) = lr.next_line();
    lr = next.1;
    match (next.0) {
      Some(full) => {
        // A C string ends at the first NUL, and so does the line.
        var line: string = full;
        var nul: i32 = __memchr(line, 0, 0);
        if (nul >= 0) {
          line = slice_unchecked(line, 0, nul) + "";
        }
        var res: datetime.Result = parse(s, line, hint);
        hint = res.hint;
        trace(res);
        if (!res.ok) {
          var bare: string = line;
          if (bare.len() > 0 && bare[bare.len() - 1] as i32 == 10) {
            bare = slice_unchecked(bare, 0, bare.len() - 1) + "";
          }
          w = gnu.error_out(w, "invalid date " + gnu.quote(bare));
          ok = false;
        } else {
          var shown: (boolean, io_buffered.BufWriter) = show_date(w, s, res.sec, res.nsec);
          w = shown.1;
          if (!shown.0) {
            ok = false;
          }
        }
      },
      None => {
        break;
      }
    }
  }
  match (lr.error()) {
    Some(e) => {
      gnu.die(w, gnu.quotef(shown) + ": read error: " + gnu.io_error_text(e), 1);
    },
    None => {}
  }
  if (name != "-") {
    match (r.close()) {
      Some(e) => {
        gnu.die(w, gnu.quotef(name) + ": " + gnu.io_error_text(e), 1);
      },
      None => {}
    }
  }
  return (ok, w);
}

pub function main(): i32 {
  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("d", "date", opt_date()));
  opts = opts.append(gnu.flag("", "debug", opt_debug()));
  opts = opts.append(gnu.valued("f", "file", opt_file()));
  opts = opts.append(gnu.optional("I", "iso-8601", opt_iso()));
  opts = opts.append(gnu.valued("r", "reference", opt_reference()));
  opts = opts.append(gnu.flag("", "resolution", opt_resolution()));
  opts = opts.append(gnu.flag("R", "rfc-email", opt_rfc_email()));
  opts = opts.append(gnu.flag("", "rfc-822", opt_rfc_email()));
  opts = opts.append(gnu.flag("", "rfc-2822", opt_rfc_email()));
  opts = opts.append(gnu.valued("", "rfc-3339", opt_rfc_3339()));
  opts = opts.append(gnu.valued("s", "set", opt_set()));
  opts = opts.append(gnu.flag("", "uct", opt_utc()));
  opts = opts.append(gnu.flag("u", "utc", opt_utc()));
  opts = opts.append(gnu.flag("", "universal", opt_utc()));
  var g: gnu.Getopt = gnu.getopt_new(args(), opts, "date", help_text(), 1);
  var datestr: string = "";
  var has_date: boolean = false;
  var discarded_date: boolean = false;
  var set_datestr: string = "";
  var set_date: boolean = false;
  var discarded_set: boolean = false;
  var format: string = "";
  var has_format: boolean = false;
  var debug: boolean = false;
  var resolution: boolean = false;
  var batch_file: string = "";
  var has_batch: boolean = false;
  var reference: string = "";
  var has_reference: boolean = false;
  var utc: boolean = false;
  while (true) {
    var res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_date()) {
          if (has_date) {
            discarded_date = true;
          }
          datestr = m.value;
          has_date = true;
        } else if (m.id == opt_debug()) {
          debug = true;
        } else if (m.id == opt_file()) {
          batch_file = m.value;
          has_batch = true;
        } else if (m.id == opt_resolution()) {
          resolution = true;
        } else if (m.id == opt_rfc_3339()) {
          var names: string[] = ["date", "seconds", "ns"];
          format = rfc_3339_formats()[gnu.argmatch(m.value, names, "--rfc-3339")];
          has_format = true;
        } else if (m.id == opt_iso()) {
          var which: i32 = 2;
          if (m.has_value) {
            which = gnu.argmatch(m.value, time_spec_names(), "--iso-8601");
          }
          format = iso_formats()[which];
          has_format = true;
        } else if (m.id == opt_reference()) {
          reference = m.value;
          has_reference = true;
        } else if (m.id == opt_rfc_email()) {
          format = rfc_email_format();
          has_format = true;
        } else if (m.id == opt_set()) {
          if (set_date) {
            discarded_set = true;
          }
          set_datestr = m.value;
          set_date = true;
        } else if (m.id == opt_utc()) {
          utc = true;
        }
      },
      None => {
        break;
      }
    }
  }
  var specified: i32 = 0;
  if (has_date) {
    specified = specified + 1;
  }
  if (has_batch) {
    specified = specified + 1;
  }
  if (has_reference) {
    specified = specified + 1;
  }
  if (resolution) {
    specified = specified + 1;
  }
  if (specified > 1) {
    gnu.die_usage("the options to specify dates for printing are mutually exclusive", 1);
  }
  if (set_date && specified > 0) {
    gnu.die_usage("the options to print and set the time may not be used together", 1);
  }
  if (discarded_date && debug) {
    gnu.error("only using last of multiple -d options");
  }
  if (discarded_set && debug) {
    gnu.error("only using last of multiple -s options");
  }
  var operands: string[] = g.operands();
  var operand: string = "";
  var has_operand: boolean = false;
  if (operands.len() > 0) {
    if (operands.len() > 1) {
      gnu.die_usage("extra operand " + gnu.quote(operands[1]), 1);
    }
    if (operands[0].len() > 0 && operands[0][0] as i32 == 43) {
      if (has_format) {
        gnu.error("multiple output formats specified");
        exit(1);
      }
      format = slice_unchecked(operands[0], 1, operands[0].len()) + "";
      has_format = true;
    } else if (set_date || specified > 0) {
      gnu.die_usage("the argument " + gnu.quote(operands[0]) + " lacks a leading '+';\nwhen using an option to specify date(s), any non-option\nargument must be a format string beginning with '+'", 1);
    } else {
      operand = operands[0];
      has_operand = true;
    }
  }
  if (!has_format) {
    if (resolution) {
      format = "%s.%N";
    } else {
      format = "%a %b %e %H:%M:%S %Z %Y";
    }
  }
  var tzstring: string = "";
  var has_tz: boolean = false;
  match (env("TZ")) {
    Some(v) => {
      tzstring = v;
      has_tz = true;
    },
    None => {}
  }
  if (utc) {
    tzstring = "UTC0";
    has_tz = true;
  }
  var zone: tz.Zone = tz.local_zone();
  if (utc) {
    zone = tz.zone_from_tz(tzstring);
  }
  var s: Show = Show { zone: zone, tzstring: tzstring, has_tz: has_tz, format: adjust_resolution(format), debug: debug };
  var o: io_buffered.BufWriter = gnu.out_new();
  if (has_batch) {
    var b: (boolean, io_buffered.BufWriter) = batch(o, s, batch_file);
    gnu.finish_with(b.1, 1);
    if (b.0) {
      return 0;
    }
    return 1;
  }
  var when_sec: i64 = 0;
  var when_nsec: i64 = 0;
  var valid: boolean = true;
  var shown: string = datestr;
  if (specified == 0 && !set_date) {
    if (has_operand) {
      set_date = true;
      shown = operand;
      var pt: (boolean, i64, i64) = datetime.posixtime(operand, 2 + 4 + 8, zone, now_ns() / (1000000000 as i64), 0);
      valid = pt.0;
      when_sec = pt.1;
    } else {
      var ns: i64 = now_ns();
      when_sec = ns / (1000000000 as i64);
      when_nsec = ns % (1000000000 as i64);
    }
  } else if (has_reference) {
    match (stat(reference)) {
      Ok(st) => {
        when_sec = st.mtime;
        when_nsec = st.mtime_nsec;
      },
      Err(e) => {
        gnu.die(o, gnu.quotef(reference) + ": " + gnu.io_error_text(e), 1);
      }
    }
  } else if (resolution) {
    when_sec = 0;
    when_nsec = 1;
  } else {
    if (set_date) {
      shown = set_datestr;
    }
    var r: datetime.Result = parse(s, shown, 0);
    trace(r);
    valid = r.ok;
    when_sec = r.sec;
    when_nsec = r.nsec;
  }
  if (!valid) {
    gnu.die(o, "invalid date " + gnu.quote(shown), 1);
  }
  var ok: boolean = true;
  if (set_date) {
    o = gnu.error_out(o, "cannot set date: Operation not permitted");
    ok = false;
  }
  var printed: (boolean, io_buffered.BufWriter) = show_date(o, s, when_sec, when_nsec);
  if (!printed.0) {
    ok = false;
  }
  gnu.finish_with(printed.1, 1);
  if (ok) {
    return 0;
  }
  return 1;
}
