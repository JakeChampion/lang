import "std/string";
import "std/array";
import "std/io_buffered";
import "std/bigint";
import "./lib/gnu";
import "./lib/bre";

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " EXPRESSION\n";
  out = out + "  or:  " + gnu.prog() + " OPTION\n";
  out += "\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  out += "\n";
  out += "Print the value of EXPRESSION to standard output.  A blank line below\n";
  out += "separates increasing precedence groups.  EXPRESSION may be:\n";
  out += "\n";
  out += "  ARG1 | ARG2       ARG1 if it is neither null nor 0, otherwise ARG2\n";
  out += "\n";
  out += "  ARG1 & ARG2       ARG1 if neither argument is null or 0, otherwise 0\n";
  out += "\n";
  out += "  ARG1 < ARG2       ARG1 is less than ARG2\n";
  out += "  ARG1 <= ARG2      ARG1 is less than or equal to ARG2\n";
  out += "  ARG1 = ARG2       ARG1 is equal to ARG2\n";
  out += "  ARG1 != ARG2      ARG1 is unequal to ARG2\n";
  out += "  ARG1 >= ARG2      ARG1 is greater than or equal to ARG2\n";
  out += "  ARG1 > ARG2       ARG1 is greater than ARG2\n";
  out += "\n";
  out += "  ARG1 + ARG2       arithmetic sum of ARG1 and ARG2\n";
  out += "  ARG1 - ARG2       arithmetic difference of ARG1 and ARG2\n";
  out += "\n";
  out += "  ARG1 * ARG2       arithmetic product of ARG1 and ARG2\n";
  out += "  ARG1 / ARG2       arithmetic quotient of ARG1 divided by ARG2\n";
  out += "  ARG1 % ARG2       arithmetic remainder of ARG1 divided by ARG2\n";
  out += "\n";
  out += "  STRING : REGEXP   anchored pattern match of REGEXP in STRING\n";
  out += "\n";
  out += "  match STRING REGEXP        same as STRING : REGEXP\n";
  out += "  substr STRING POS LENGTH   substring of STRING, POS counted from 1\n";
  out += "  index STRING CHARS         index in STRING where any CHARS is found, or 0\n";
  out += "  length STRING              length of STRING\n";
  out += "  + TOKEN                    interpret TOKEN as a string, even if it is a\n";
  out += "                               keyword like 'match' or an operator like '/'\n";
  out += "\n";
  out += "  ( EXPRESSION )             value of EXPRESSION\n";
  out += "\n";
  out += "Exit status is 0 if EXPRESSION is neither null nor 0, 1 if EXPRESSION is null\n";
  out += "or 0, 2 if EXPRESSION is syntactically invalid, and 3 if an error occurred.\n";
  return out;
}

function invalid(): i32 {
  return 2;
}

function failure(): i32 {
  return 3;
}

function die(msg: string): void {
  gnu.error(msg);
  exit(invalid());
}

function is_integer(s: string): boolean {
  let i = 0;
  if (s.len() > 0 && s[0] as i32 == 45) {
    i = 1;
  }
  if (i >= s.len()) {
    return false;
  }
  while (i < s.len()) {
    let b = s[i] as i32;
    if (b < 48 || b > 57) {
      return false;
    }
    i += 1;
  }
  return true;
}

function is_null(s: string): boolean {
  if (s.len() == 0) {
    return true;
  }
  let i = 0;
  if (s[0] as i32 == 45) {
    i = 1;
  }
  if (i >= s.len()) {
    return false;
  }
  while (i < s.len()) {
    if (s[i] as i32 != 48) {
      return false;
    }
    i += 1;
  }
  return true;
}

function to_int(s: string): bigint.BigInt {
  match (bigint.parse(s)) {
    Ok(v) => {
      return v;
    },
    Err(_) => {
      return bigint.zero();
    }
  }
}

function bool_value(b: boolean): string {
  if (b) {
    return "1";
  }
  return "0";
}

function str_cmp(a: string, b: string): i32 {
  let n = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  let i = 0;
  while (i < n) {
    let x = a[i] as i32;
    let y = b[i] as i32;
    if (x != y) {
      if (x < y) {
        return 0 - 1;
      }
      return 1;
    }
    i += 1;
  }
  if (a.len() < b.len()) {
    return 0 - 1;
  }
  if (a.len() > b.len()) {
    return 1;
  }
  return 0;
}

function compare(l: string, r: string): i32 {
  if (is_integer(l) && is_integer(r)) {
    return to_int(l).cmp(to_int(r));
  }
  return str_cmp(l, r);
}

struct S { ops: string[], i: i32 }

function has(s: S): boolean {
  return s.i < s.ops.len();
}

function peek(s: S): string {
  return s.ops[s.i];
}

function is_tok(s: S, t: string): boolean {
  return has(s) && peek(s) == t;
}

function advance(s: S): S {
  return S { ...s, i: s.i + 1 };
}

function prev(s: S): string {
  return s.ops[s.i - 1];
}

function require_arg(s: S): void {
  if (!has(s)) {
    die("syntax error: missing argument after " + gnu.quote(prev(s)));
  }
}

function do_length(s: string): string {
  return (s.len() as i64).to_string();
}

function do_index(s: string, chars: string): string {
  let i = 0;
  while (i < s.len()) {
    let k = 0;
    while (k < chars.len()) {
      if (s[i] as i32 == chars[k] as i32) {
        return (i as i64 + 1 as i64).to_string();
      }
      k += 1;
    }
    i += 1;
  }
  return "0";
}

function do_substr(s: string, pos: string, len: string): string {
  if (!is_integer(pos) || !is_integer(len)) {
    return "";
  }
  let p = to_int(pos);
  let n = to_int(len);
  let one = bigint.from_i64(1 as i64);
  let size = bigint.from_i64(s.len() as i64);
  if (p.cmp(one) < 0 || p.cmp(size) > 0 || n.cmp(one) < 0) {
    return "";
  }
  let start = p.low_u64() as i32 - 1;
  let end = s.len();
  let avail = size.sub(p).add(one);
  if (n.cmp(avail) < 0) {
    end = start + n.low_u64() as i32;
  }
  return slice_unchecked(s, start, end) + "";
}

function do_colon(l: string, r: string, ev: boolean): string {
  if (!ev) {
    return "0";
  }
  let re = bre.bre_compile(r);
  if (re.err.len() > 0) {
    gnu.error(re.err);
    exit(invalid());
  }
  let m = re.exec(l);
  if (re.ngroups > 0) {
    if (!m.matched || m.starts[1] < 0) {
      return "";
    }
    return slice_unchecked(l, m.starts[1], m.ends[1]) + "";
  }
  if (!m.matched) {
    return "0";
  }
  return (m.end as i64).to_string();
}

function arith(op: string, l: string, r: string, ev: boolean): string {
  if (!ev) {
    return "0";
  }
  if (!is_integer(l) || !is_integer(r)) {
    gnu.error("non-integer argument");
    exit(invalid());
  }
  let a = to_int(l);
  let b = to_int(r);
  if (op == "+") {
    return a.add(b).to_string();
  }
  if (op == "-") {
    return a.sub(b).to_string();
  }
  if (op == "*") {
    return a.mul(b).to_string();
  }
  if (b.is_zero()) {
    gnu.error("division by zero");
    exit(invalid());
  }
  let qr: (bigint.BigInt, bigint.BigInt) = a.divmod(b);
  if (op == "/") {
    return qr.0.to_string();
  }
  return qr.1.to_string();
}

function eval7(s0: S, ev: boolean): (string, S) {
  let s = s0;
  if (is_tok(s, "(")) {
    s = advance(s);
    let r: (string, S) = eval_or(s, ev);
    s = r.1;
    if (!has(s)) {
      die("syntax error: expecting ')' after " + gnu.quote(prev(s)));
    }
    if (peek(s) != ")") {
      die("syntax error: expecting ')' instead of " + gnu.quote(peek(s)));
    }
    return (r.0, advance(s));
  }
  if (is_tok(s, ")")) {
    die("syntax error: unexpected ')'");
  }
  require_arg(s);
  return (peek(s), advance(s));
}

function eval6(s0: S, ev: boolean): (string, S) {
  let s = s0;
  if (is_tok(s, "length")) {
    let a: (string, S) = eval6(advance(s), ev);
    return (do_length(a.0), a.1);
  }
  if (is_tok(s, "match")) {
    let m1: (string, S) = eval6(advance(s), ev);
    let m2: (string, S) = eval6(m1.1, ev);
    return (do_colon(m1.0, m2.0, ev), m2.1);
  }
  if (is_tok(s, "index")) {
    let i1: (string, S) = eval6(advance(s), ev);
    let i2: (string, S) = eval6(i1.1, ev);
    return (do_index(i1.0, i2.0), i2.1);
  }
  if (is_tok(s, "substr")) {
    let t1: (string, S) = eval6(advance(s), ev);
    let t2: (string, S) = eval6(t1.1, ev);
    let t3: (string, S) = eval6(t2.1, ev);
    return (do_substr(t1.0, t2.0, t3.0), t3.1);
  }
  if (is_tok(s, "+")) {
    s = advance(s);
    require_arg(s);
    return (peek(s), advance(s));
  }
  return eval7(s, ev);
}

function eval5(s0: S, ev: boolean): (string, S) {
  let r: (string, S) = eval6(s0, ev);
  let l = r.0;
  let s = r.1;
  while (is_tok(s, ":")) {
    let r2: (string, S) = eval6(advance(s), ev);
    l = do_colon(l, r2.0, ev);
    s = r2.1;
  }
  return (l, s);
}

function eval4(s0: S, ev: boolean): (string, S) {
  let r: (string, S) = eval5(s0, ev);
  let l = r.0;
  let s = r.1;
  while (is_tok(s, "*") || is_tok(s, "/") || is_tok(s, "%")) {
    let op = peek(s);
    let r2: (string, S) = eval5(advance(s), ev);
    l = arith(op, l, r2.0, ev);
    s = r2.1;
  }
  return (l, s);
}

function eval3(s0: S, ev: boolean): (string, S) {
  let r: (string, S) = eval4(s0, ev);
  let l = r.0;
  let s = r.1;
  while (is_tok(s, "+") || is_tok(s, "-")) {
    let op = peek(s);
    let r2: (string, S) = eval4(advance(s), ev);
    l = arith(op, l, r2.0, ev);
    s = r2.1;
  }
  return (l, s);
}

function is_relop(t: string): boolean {
  return t == "<" || t == "<=" || t == "=" || t == "==" || t == "!=" || t == ">=" || t == ">";
}

function relate(op: string, c: i32): boolean {
  if (op == "<") {
    return c < 0;
  }
  if (op == "<=") {
    return c <= 0;
  }
  if (op == "=" || op == "==") {
    return c == 0;
  }
  if (op == "!=") {
    return c != 0;
  }
  if (op == ">=") {
    return c >= 0;
  }
  return c > 0;
}

function eval2(s0: S, ev: boolean): (string, S) {
  let r: (string, S) = eval3(s0, ev);
  let l = r.0;
  let s = r.1;
  while (has(s) && is_relop(peek(s))) {
    let op = peek(s);
    let r2: (string, S) = eval3(advance(s), ev);
    l = bool_value(relate(op, compare(l, r2.0)));
    s = r2.1;
  }
  return (l, s);
}

function eval_and(s0: S, ev: boolean): (string, S) {
  let r: (string, S) = eval2(s0, ev);
  let l = r.0;
  let s = r.1;
  while (is_tok(s, "&")) {
    let r2: (string, S) = eval2(advance(s), ev && !is_null(l));
    s = r2.1;
    if (is_null(l) || is_null(r2.0)) {
      l = "0";
    }
  }
  return (l, s);
}

function eval_or(s0: S, ev: boolean): (string, S) {
  let r: (string, S) = eval_and(s0, ev);
  let l = r.0;
  let s = r.1;
  while (is_tok(s, "|")) {
    let r2: (string, S) = eval_and(advance(s), ev && is_null(l));
    s = r2.1;
    if (is_null(l)) {
      l = r2.0;
      if (is_null(l)) {
        l = "0";
      }
    }
  }
  return (l, s);
}

function sole_option(argv: string[]): void {
  if (argv.len() != 2) {
    return;
  }
  let a = argv[1];
  if (a.len() < 3 || !a.starts_with("--")) {
    return;
  }
  let name = slice_unchecked(a, 2, a.len()) + "";
  if ("help".starts_with(name)) {
    gnu.write_out_with(help_text(), failure());
    exit(0);
  }
  if ("version".starts_with(name)) {
    gnu.write_out_with("expr (Fern coreutils) " + gnu.version() + "\n", failure());
    exit(0);
  }
}

pub function main(): i32 {
  let argv = args();
  sole_option(argv);
  let start = 1;
  if (argv.len() > 1 && argv[1] == "--") {
    start = 2;
  }
  let ops: string[] = [];
  let k = start;
  while (k < argv.len()) {
    ops = ops.append(argv[k]);
    k += 1;
  }
  if (ops.len() == 0) {
    gnu.die_usage("missing operand", invalid());
  }
  let r: (string, S) = eval_or(S { ops: ops, i: 0 }, true);
  let s = r.1;
  if (has(s)) {
    die("syntax error: unexpected argument " + gnu.quote(peek(s)));
  }
  let o = gnu.out_with(r.0.len() + 1);
  o = gnu.put_with(o, r.0 + "\n", failure());
  gnu.finish_with(o, failure());
  if (is_null(r.0)) {
    return 1;
  }
  return 0;
}
