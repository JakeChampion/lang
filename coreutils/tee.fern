import "std/signal";
import "./lib/gnu";

function opt_append(): i32 {
  return 1;
}

function opt_ignore_interrupts(): i32 {
  return 2;
}

function opt_output_error(): i32 {
  return 3;
}

function mode_sigpipe(): i32 {
  return 0 - 1;
}

function mode_warn(): i32 {
  return 0;
}

function mode_warn_nopipe(): i32 {
  return 1;
}

function mode_exit(): i32 {
  return 2;
}

function mode_exit_nopipe(): i32 {
  return 3;
}

function mode_names(): string[] {
  return ["warn", "warn-nopipe", "exit", "exit-nopipe"];
}

function mode_exits(mode: i32): boolean {
  return mode == mode_exit() || mode == mode_exit_nopipe();
}

function mode_quiet_on_pipe(mode: i32): boolean {
  return mode == mode_warn_nopipe() || mode == mode_exit_nopipe();
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Copy standard input to each FILE, and also to standard output.\n";
  out = out + "\n";
  out = out + "  -a, --append              append to the given FILEs, do not overwrite\n";
  out = out + "  -i, --ignore-interrupts   ignore interrupt signals\n";
  out = out + "  -p                        operate in a more appropriate MODE with pipes.\n";
  out = out + "      --output-error[=MODE]   set behavior on write error.  See MODE below\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "MODE determines behavior with write errors on the outputs:\n";
  out = out + "  warn           diagnose errors writing to any output\n";
  out = out + "  warn-nopipe    diagnose errors writing to any output not a pipe\n";
  out = out + "  exit           exit on error writing to any output\n";
  out = out + "  exit-nopipe    exit on error writing to any output not a pipe\n";
  out = out + "The default MODE for the -p option is 'warn-nopipe'.\n";
  out = out + "With \"nopipe\" MODEs, exit immediately if all outputs become broken pipes.\n";
  out = out + "The default operation when --output-error is not specified, is to\n";
  out = out + "exit immediately on error writing to a pipe, and diagnose errors\n";
  out = out + "writing to non pipe outputs.\n";
  return out;
}

struct Out { w: Writer, name: string, live: boolean, is_file: boolean }

struct Copy { outs: Out[], mode: i32, live: i32, ok: boolean }

function read_size(): i32 {
  return 65536;
}

function fail(c: Copy, i: i32, e: IoError): Copy {
  let out: Out = c.outs[i];
  let quiet: boolean = gnu.is_broken_pipe(e) && mode_quiet_on_pipe(c.mode);
  let s: Copy = Copy { ...c, outs: c.outs.with(i, Out { ...out, live: false }), live: c.live - 1 };
  if (quiet) {
    return s;
  }
  let shown: string = out.name;
  if (!out.is_file) {
    shown = gnu.quote(out.name);
  }
  gnu.error(shown + ": " + gnu.io_error_text(e));
  s = Copy { ...s, ok: false };
  if (mode_exits(s.mode)) {
    exit(1);
  }
  return s;
}

function put(c: Copy, chunk: u8[]): Copy {
  let s: Copy = c;
  let i: i32 = 0;
  while (i < s.outs.len()) {
    if (s.outs[i].live) {
      if let Err(e) = s.outs[i].w.write_bytes(chunk) {
        s = fail(s, i, e);
      }
    }
    i = i + 1;
  }
  return s;
}

function close_files(c: Copy): void {
  let i: i32 = 0;
  while (i < c.outs.len()) {
    if (c.outs[i].is_file) {
      c.outs[i].w.close();
    }
    i = i + 1;
  }
}

function open_out(name: string, append: boolean): Result[Writer, IoError] {
  if (append) {
    return open_appender(name);
  }
  return open_writer(name);
}

function open_outs(files: string[], append: boolean, mode: i32): Copy {
  let outs: Out[] = [];
  outs = outs.append(Out { w: stdout(), name: "standard output", live: true, is_file: false });
  let c: Copy = Copy { outs: outs, mode: mode, live: 1, ok: true };
  let i: i32 = 0;
  while (i < files.len()) {
    let name: string = files[i];
    match (open_out(name, append)) {
      Ok(w) => {
        c = Copy { ...c, outs: c.outs.append(Out { w: w, name: name, live: true, is_file: true }), live: c.live + 1 };
      },
      Err(e) => {
        gnu.error(gnu.quotef(name) + ": " + gnu.io_error_text(e));
        c = Copy { ...c, ok: false };
        if (mode_exits(mode)) {
          close_files(c);
          exit(1);
        }
      }
    }
    i = i + 1;
  }
  return c;
}

pub function main(): i32 {
  let argv: string[] = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("a", "append", opt_append()));
  opts = opts.append(gnu.flag("i", "ignore-interrupts", opt_ignore_interrupts()));
  opts = opts.append(gnu.optional_long("p", "output-error", opt_output_error()));

  let append: boolean = false;
  let ignore_interrupts: boolean = false;
  let mode: i32 = mode_sigpipe();
  let g: gnu.Getopt = gnu.getopt_new(argv, opts, "tee", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_append()) {
          append = true;
        } else if (m.id == opt_ignore_interrupts()) {
          ignore_interrupts = true;
        } else if (m.id == opt_output_error()) {
          if (m.has_value) {
            mode = gnu.argmatch(m.value, mode_names(), "--output-error");
          } else {
            mode = mode_warn_nopipe();
          }
        }
      },
      None => {
        break;
      }
    }
  }

  if (ignore_interrupts) {
    signal.ignore(signal.SIGINT);
  }
  if (mode != mode_sigpipe()) {
    signal.ignore(signal.SIGPIPE);
  }

  let c: Copy = open_outs(g.operands(), append, mode);
  let r: Reader = stdin();
  while (c.live > 0) {
    match (r.read_chunk_bytes(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          break;
        }
        c = put(c, chunk);
      },
      Err(e) => {
        gnu.error("read error: " + gnu.io_error_text(e));
        c = Copy { ...c, ok: false };
        break;
      }
    }
  }
  close_files(c);
  if (!c.ok) {
    return 1;
  }
  return 0;
}
