import "std/string";
import "std/array";
import "./lib/gnu";

function is_octal_digit(b: i32): boolean {
  return b >= 48 && b <= 55;
}

function hex_digit(b: i32): i32 {
  if (b >= 48 && b <= 57) {
    return b - 48;
  }
  if (b >= 97 && b <= 102) {
    return b - 87;
  }
  if (b >= 65 && b <= 70) {
    return b - 55;
  }
  return -1;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [SHORT-OPTION]... [STRING]...\n";
  out = out + "  or:  " + gnu.prog() + " LONG-OPTION\n";
  out += "Write the STRINGs to standard output, separated by spaces.\n";
  out += "\n";
  out += "  -n         do not write the trailing newline\n";
  out += "  -e         interpret backslash escapes\n";
  out += "  -E         do not interpret backslash escapes (default)\n";
  out += "      --help     display this help and exit\n";
  out += "      --version  output version information and exit\n";
  out += "\n";
  out += "A long option is recognised only as the sole argument.\n";
  return out;
}

function expand_into(out: u8[], s: string): (u8[], boolean) {
  let bs = out;
  let n = s.len();
  let i = 0;
  while (i < n) {
    let b = s[i] as i32;
    if (b != 92 || i + 1 >= n) {
      bs = bs.append(b as u8);
      i += 1;
      continue;
    }
    let c = s[i + 1] as i32;
    i += 2;
    if (c == 97) {
      bs = bs.append(7 as u8);
    } else if (c == 98) {
      bs = bs.append(8 as u8);
    } else if (c == 99) {
      return (bs, true);
    } else if (c == 101) {
      bs = bs.append(27 as u8);
    } else if (c == 102) {
      bs = bs.append(12 as u8);
    } else if (c == 110) {
      bs = bs.append(10 as u8);
    } else if (c == 114) {
      bs = bs.append(13 as u8);
    } else if (c == 116) {
      bs = bs.append(9 as u8);
    } else if (c == 118) {
      bs = bs.append(11 as u8);
    } else if (c == 92) {
      bs = bs.append(92 as u8);
    } else if (c >= 48 && c <= 55) {
      let oct = c - 48;
      let more = 2;
      if (c == 48) {
        more = 3;
      }
      let taken = 0;
      while (taken < more && i < n && is_octal_digit(s[i] as i32)) {
        oct = oct * 8 + (s[i] as i32 - 48);
        i += 1;
        taken += 1;
      }
      bs = bs.append((oct % 256) as u8);
    } else if (c == 120) {
      let hex = 0;
      let digits = 0;
      while (digits < 2 && i < n && hex_digit(s[i] as i32) >= 0) {
        hex = hex * 16 + hex_digit(s[i] as i32);
        i += 1;
        digits += 1;
      }
      if (digits == 0) {
        bs = bs.append(92 as u8);
        bs = bs.append(120 as u8);
      } else {
        bs = bs.append(hex as u8);
      }
    } else {
      bs = bs.append(92 as u8);
      bs = bs.append(c as u8);
    }
  }
  return (bs, false);
}

function append_raw(out: u8[], s: string): u8[] {
  let bs = out;
  let i = 0;
  while (i < s.len()) {
    bs = bs.append(s[i]);
    i += 1;
  }
  return bs;
}

function is_flag_token(a: string): boolean {
  if (a.len() < 2 || a[0] as i32 != 45) {
    return false;
  }
  let i = 1;
  while (i < a.len()) {
    let b = a[i] as i32;
    if (b != 101 && b != 69 && b != 110) {
      return false;
    }
    i += 1;
  }
  return true;
}

pub function main(): i32 {
  let argv = args();
  let posix = false;
  match (env("POSIXLY_CORRECT")) {
    Some(_) => {
      posix = true;
    },
    None => {}
  }
  let allow_options = !posix || argv.len() > 1 && argv[1] == "-n";
  if (allow_options) {
    gnu.sole_help_version(argv, "echo", help_text(), 0);
  }

  let i = 1;
  let newline = true;
  let do_v9 = false;
  if (allow_options) {
    while (i < argv.len() && is_flag_token(argv[i])) {
      let a = argv[i];
      let j = 1;
      while (j < a.len()) {
        let b = a[j] as i32;
        if (b == 101) {
          do_v9 = true;
        } else if (b == 69) {
          do_v9 = false;
        } else {
          newline = false;
        }
        j += 1;
      }
      i += 1;
    }
  }

  let escapes = do_v9 || posix;
  let out: u8[] = [];
  let stopped = false;
  while (i < argv.len() && !stopped) {
    if (escapes) {
      let r: (u8[], boolean) = expand_into(out, argv[i]);
      out = r.0;
      stopped = r.1;
    } else {
      out = append_raw(out, argv[i]);
    }
    if (!stopped && i + 1 < argv.len()) {
      out = out.append(32 as u8);
    }
    i += 1;
  }
  if (!stopped && newline) {
    out = out.append(10 as u8);
  }
  gnu.write_out(unsafe { string_from_bytes_unchecked(out) });
  return 0;
}
