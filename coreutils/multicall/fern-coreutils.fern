// The catalogue, in the order `--list` prints it.
function catalogue(): string[] {
  return ["[", "arch", "b2sum", "base32", "base64", "basename", "basenc", "cat", "chcon", "chgrp", "chmod", "chown", "chroot", "cksum", "comm", "cp", "csplit", "cut", "date", "dd", "df", "dir", "dircolors", "dirname", "du", "echo", "env", "expand", "expr", "factor", "false", "fmt", "fold", "groups", "head", "hostid", "id", "install", "join", "kill", "link", "ln", "logname", "ls", "md5sum", "mkdir", "mkfifo", "mknod", "mktemp", "mv", "nice", "nl", "nohup", "nproc", "numfmt", "od", "paste", "pathchk", "pinky", "pr", "printenv", "printf", "ptx", "pwd", "readlink", "realpath", "rm", "rmdir", "runcon", "seq", "sha1sum", "sha224sum", "sha256sum", "sha384sum", "sha512sum", "shred", "shuf", "sleep", "sort", "split", "stat", "stty", "sum", "sync", "tac", "tail", "tee", "test", "timeout", "touch", "tr", "true", "truncate", "tsort", "tty", "uname", "unexpand", "uniq", "unlink", "uptime", "users", "vdir", "wc", "who", "whoami", "yes"];
}

function in_catalogue(n: string): boolean {
  var names: string[] = catalogue();
  var i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == n) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// argv[0] is what the process was invoked as, path and all; the
// utility it names is its last path component. Nothing is stripped
// beyond that: a trailing slash cannot appear in an exec'd argv[0],
// and a name with no slash is already its own basename.
function basename(p: string): string {
  var last: i32 = -1;
  var i: i32 = 0;
  while (i < p.len()) {
    if (p[i] == b'/') {
      last = i;
    }
    i = i + 1;
  }
  return slice_unchecked(p, last + 1, p.len()) + "";
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " OPTION\n";
  out = out + "Every utility in one binary, selected by the name it is invoked as.\n";
  out = out + "\n";
  out = out + "Symlink this binary to a utility's name and run the symlink:\n";
  out = out + "\n";
  out = out + "  ln -s " + gnu.prog() + " yes && ./yes\n";
  out = out + "\n";
  out = out + "      --list     list the utilities this binary provides\n";
  out = out + "      --help     display this help and exit\n";
  out = out + "      --version  output version information and exit\n";
  return out;
}

// Its own options, reached only when argv[0] does not name a utility.
//
// `fern-coreutils yes` is the mistake this is most likely to see, so it
// gets its own line rather than falling through to a generic refusal:
// naming a utility as an argument cannot work here (see the header).
function own_main(argv: string[]): i32 {
  if (argv.len() < 2) {
    gnu.die_usage("missing option", 1);
  }
  var a: string = argv[1];
  if (a == "--list") {
    var names: string[] = catalogue();
    var out: string = "";
    var i: i32 = 0;
    while (i < names.len()) {
      out = out + names[i] + "\n";
      i = i + 1;
    }
    gnu.write_out(out);
    return 0;
  }
  if (a == "--help") {
    gnu.write_out(help_text());
    return 0;
  }
  if (a == "--version") {
    gnu.write_out("fern-coreutils " + gnu.version() + "\n");
    return 0;
  }
  if (in_catalogue(a)) {
    gnu.die_usage("run " + gnu.quote(a) + " through a symlink of this binary, not as an argument", 1);
  }
  if (gnu.is_option(a)) {
    gnu.die_usage("unrecognized option " + gnu.quote(a), 1);
  }
  gnu.die_usage("unrecognized argument " + gnu.quote(a), 1);
  return 1;
}

// fern-lint: allow cyclomatic-complexity
// The catalogue is a flat table; splitting it would only hide the shape.
function main(): i32 {
  var argv: string[] = args();
  if (argv.len() == 0) {
    return 1;
