// uptime.fern — GNU-compatible `uptime`.
//
//   uptime [OPTION]... [FILE]
//
// One line: the local clock, how long the machine has been up, how many
// sessions are open, and the three load averages.
//
//	 19:49:16  up  1:02,  3 users,  load average: 0.56, 0.81, 0.67
//
// The spacing is required and none of it is regular. A leading
// space, two spaces after the clock, one space after `up` and after the
// day count, `%2d` hours so a
// single-digit hour keeps a column, `%02d` minutes, a comma and two
// spaces between every field, and two spaces again before `load
// average:`.
//
// ---- what this is NOT -------------------------------------------------
//
// procps-ng ships a different `uptime` with `-p` and `-s`, and on Debian
// and its derivatives that is the one on PATH: their coreutils package
// does not build this program at all. GNU's has no options but `--help`
// and `--version`, so `uptime -p` here is `invalid option -- 'p'`.
//
// ---- where the numbers come from --------------------------------------
//
// Both counts come from the login-accounting database — the FILE
// operand, or the default database — rather than from the kernel: a
// BOOT_TIME record carries the boot instant and a USER_PROCESS record
// with a non-empty name is one session. The LAST boot record wins,
// which is what GNU's loop leaves behind. A database that cannot be read
// is an empty one with no diagnostic, which is what glibc's utmp reader
// gives GNU for an unopenable FILE.
//
// On Linux the load averages come from the kernel, as /proc/loadavg, which
// is what glibc's getloadavg(3) reads. The kernel writes those three as
// `%lu.%02lu`, so `%.2f` of the double glibc parses out of them is the
// same two digits back again, and this reformats the digits rather than
// going through a float.
//
// ---- Darwin ----------------------------------------------------------
//
// Darwin has no /proc. Its getloadavg(3) is `sysctl({CTL_VM,
// VM_LOADAVG})`, three fixed-point loads and their scale, and `%.2f`
// of each is that ratio rounded to nearest with ties to even, which
// this does in integers. The default database there is utmpx, and when
// it holds no boot record gnulib takes the boot instant from
// `sysctl({CTL_KERN, KERN_BOOTTIME})`, for that file and no other.
//
// Any other target REFUSES rather than printing the line without its
// load averages -- which is a shape GNU also produces, when
// getloadavg(3) fails, and would therefore look like an answer instead
// of a gap.
//
// ---- what cannot go wrong quietly -------------------------------------
//
// A boot time in the future, or none at all, is `up ???? days ??:??,`
// and exit 1 rather than a negative duration. GNU reports `couldn't get
// boot time` for the second before it prints anything.
import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/timefmt";
import "std/tz";
import "./lib/utmp";

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]\n";
  out = out + "Print the current time, the length of time the system has been up,\n";
  out = out + "the number of users on the system, and the average number of jobs\n";
  out = out + "in the run queue over the last 1, 5 and 15 minutes.  Processes in\n";
  out = out + "an uninterruptible sleep state also contribute to the load average.\n";
  out = out + "If FILE is not specified, use " + utmp.default_path() + ".  /var/log/wtmp as FILE is common.\n";
  out = out + "\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function two(v: i32): string {
  if (v < 10) {
    return "0" + v.to_string();
  }
  return v.to_string();
}

// `%2d`: a space-padded field, not a zero-padded one.
function pad2(v: i32): string {
  if (v < 10) {
    return " " + v.to_string();
  }
  return v.to_string();
}

// The three load averages as GNU prints them, or None when there is no
// /proc/loadavg to read — the state getloadavg(3) reports as -1, where
// uptime ends the line after the session count. On Linux that is a
// container without /proc and GNU answers the same way; a target that
// has no /proc at all never reaches here, because main refuses first.
function load_averages(): Option[string] {
  if (target_os() == "darwin") {
    return darwin_load_averages();
  }
  match (read_file("/proc/loadavg")) {
    Ok(text) => {
      let f: string[] = text.fields();
      if (f.len() < 3) {
        return None;
      }
      let out: string = ",  load average: " + two_places(f[0]);
      out = out + ", " + two_places(f[1]);
      out = out + ", " + two_places(f[2]);
      return Some(out);
    },
    Err(_) => {
      return None;
    }
  }
}

function darwin_load_averages(): Option[string] {
  match (sysctl([2, 2])) {
    Ok(bs) => {
      if (bs.len() < 24) {
        return None;
      }
      let scale: i64 = le_bytes(bs, 16, 8);
      if (scale <= 0 as i64) {
        return None;
      }
      let out: string = ",  load average: " + hundredths(le_bytes(bs, 0, 4), scale);
      out = out + ", " + hundredths(le_bytes(bs, 4, 4), scale);
      out = out + ", " + hundredths(le_bytes(bs, 8, 4), scale);
      return Some(out);
    },
    Err(_) => {
      return None;
    }
  }
}

// `%.2f` of `num / den`: rounded to nearest, ties to even, as printf
// rounds a double that holds the ratio exactly.
function hundredths(num: i64, den: i64): string {
  let q: i64 = num * (100 as i64) / den;
  let r: i64 = num * (100 as i64) % den;
  if (r * (2 as i64) > den || r * (2 as i64) == den && q % (2 as i64) == 1 as i64) {
    q = q + 1 as i64;
  }
  return (q / (100 as i64)).to_string() + "." + two((q % (100 as i64)) as i32);
}

// An unsigned little-endian field of `width` bytes.
function le_bytes(bs: u8[], at: i32, width: i32): i64 {
  let v: i64 = 0 as i64;
  let i: i32 = width - 1;
  while (i >= 0) {
    v = v * (256 as i64) + bs[at + i] as i64;
    i = i - 1;
  }
  return v;
}

// Darwin's boot instant: `struct timeval` from KERN_BOOTTIME, or 0.
function darwin_boot_time(): i64 {
  match (sysctl([1, 21])) {
    Ok(bs) => {
      if (bs.len() < 8) {
        return 0 as i64;
      }
      return le_bytes(bs, 0, 8);
    },
    Err(_) => {
      return 0 as i64;
    }
  }
}

// One `%.2f` field. The kernel writes exactly two decimals, so this is
// the identity on every value it produces; a shorter fraction is padded
// and a longer one truncated rather than rounded, which no kernel emits.
function two_places(s: string): string {
  let whole: string = "";
  let frac: string = "";
  let seen_dot: boolean = false;
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c == 46 && !seen_dot) {
      seen_dot = true;
    } else if (seen_dot) {
      frac = frac + slice_unchecked(s, i, i + 1);
    } else {
      whole = whole + slice_unchecked(s, i, i + 1);
    }
    i = i + 1;
  }
  if (whole.len() == 0) {
    whole = "0";
  }
  while (frac.len() < 2) {
    frac = frac + "0";
  }
  return whole + "." + slice_unchecked(frac, 0, 2);
}

// The clock, the elapsed time and the session count, in that order.
// Returns the line and the exit status, which is 1 when a field had to
// be filled in with question marks.
function report(read: Result[utmp.Entry[], IoError], now: i64, fallback_boot: i64): (string, i32) {
  let entries: utmp.Entry[] = [];
  let why: string = "";
  match (read) {
    Ok(v) => {
      entries = v;
    },
    Err(e) => {
      // GNU's `error (0, errno, ...)` picks up the errno the failed
      // open left behind, so the database that could not be read names
      // itself in the boot-time diagnostic.
      why = ": " + gnu.io_error_text(e);
    }
  }
  let status: i32 = 0;
  let boot: i64 = 0 as i64;
  let sessions: i32 = 0;
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].is_login()) {
      sessions = sessions + 1;
    }
    if (entries[i].kind == utmp.boot_time()) {
      boot = entries[i].sec;
    }
    i = i + 1;
  }
  if (boot == 0 as i64) {
    boot = fallback_boot;
  }
  let out: string = "";
  if (boot == 0 as i64) {
    gnu.error("couldn't get boot time" + why);
    status = 1;
  }
  out = out + timefmt.strftime(" %H:%M:%S  ", tz.local_zone(), now, 0 as i64);
  let elapsed: i64 = now - boot;
  if (boot == 0 as i64 || elapsed < 0 as i64) {
    out = out + "up ???? days ??:??,  ";
    status = 1;
  } else {
    let days: i64 = elapsed / (86400 as i64);
    let hours: i32 = (elapsed % (86400 as i64) / (3600 as i64)) as i32;
    let mins: i32 = (elapsed % (3600 as i64) / (60 as i64)) as i32;
    if (days > 0 as i64) {
      let unit: string = " days ";
      if (days == 1 as i64) {
        unit = " day ";
      }
      out = out + "up " + days.to_string() + unit + pad2(hours) + ":" + two(mins) + ",  ";
    } else {
      out = out + "up " + pad2(hours) + ":" + two(mins) + ",  ";
    }
  }
  out = out + sessions.to_string() + " user";
  if (sessions != 1) {
    out = out + "s";
  }
  match (load_averages()) {
    Some(l) => {
      out = out + l;
    },
    None => {}
  }
  return (out + "\n", status);
}

pub function main(): i32 {
  let operands: string[] = gnu.parse_standard_options_only(args(), "uptime", help_text(), 1);
  // After the option scan, so `--help` and `--version` answer on every
  // target and only a run that would have to produce the load averages
  // is refused.
  if (target_os() != "linux" && target_os() != "darwin") {
    gnu.error("the load averages are read from /proc/loadavg, which " + target_os() + " does not have");
    return 1;
  }
  if (operands.len() > 1) {
    gnu.die_usage("extra operand " + gnu.quote(operands[1]), 1);
  }
  let path: string = utmp.default_path();
  if (operands.len() == 1) {
    path = operands[0];
  }
  let fallback_boot: i64 = 0 as i64;
  if (target_os() == "darwin") {
    if (path == utmp.default_path()) {
      fallback_boot = darwin_boot_time();
    }
  }
  let r: (string, i32) = report(utmp.read_all_result(path), now_unix_ms() / (1000 as i64), fallback_boot);
  let o: io_buffered.BufWriter = gnu.put(gnu.out_new(), r.0);
  gnu.finish(o);
  return r.1;
}
