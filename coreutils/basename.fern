import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " NAME [SUFFIX]\n";
  out = out + "  or:  " + gnu.prog() + " OPTION... NAME...\n";
  out += "Print NAME with any leading directory components removed.\n";
  out += "If specified, also remove a trailing SUFFIX.\n";
  out += "\n";
  out += "  -a, --multiple       support multiple arguments and treat each as a NAME\n";
  out += "  -s, --suffix=SUFFIX  remove a trailing SUFFIX; implies -a\n";
  out += "  -z, --zero           end each output line with NUL, not newline\n";
  out += "      --help           display this help and exit\n";
  out += "      --version        output version information and exit\n";
  return out;
}

function base_name(s: string): string {
  let end = s.len();
  while (end > 0 && s[end - 1] as i32 == 47) {
    end -= 1;
  }
  if (end == 0) {
    if (s.len() > 0) {
      return "/";
    }
    return "";
  }
  let start = end;
  while (start > 0 && s[start - 1] as i32 != 47) {
    start -= 1;
  }
  return slice_unchecked(s, start, end) + "";
}

function strip_suffix(name: string, suffix: string): string {
  if (suffix.len() > 0 && name.len() > suffix.len() && name.ends_with(suffix)) {
    return slice_unchecked(name, 0, name.len() - suffix.len()) + "";
  }
  return name;
}

pub function main(): i32 {
  let argv = args();
  let opts: gnu.Opt[] = [gnu.flag("a", "multiple", 1), gnu.valued("s", "suffix", 2), gnu.flag("z", "zero", 3)];
  let g = gnu.getopt_new(argv, opts, "basename", help_text(), 1).in_order();
  let multiple = false;
  let suffix = "";
  let zero = false;
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == 1) {
          multiple = true;
        } else if (m.id == 2) {
          multiple = true;
          suffix = m.value;
        } else {
          zero = true;
        }
      },
      None => {
        break;
      }
    }
  }
  let operands = g.operands();
  if (operands.len() == 0) {
    gnu.die_usage("missing operand", 1);
  }
  let names = operands;
  if (!multiple) {
    if (operands.len() > 2) {
      gnu.die_usage("extra operand " + gnu.quote(operands[2]), 1);
    }
    names = [operands[0]];
    if (operands.len() == 2) {
      suffix = operands[1];
    }
  }
  let term = "\n";
  if (zero) {
    term = "\x00";
  }
  let o = gnu.out_new();
  let i = 0;
  while (i < names.len()) {
    o = gnu.put(o, strip_suffix(base_name(names[i]), suffix) + term);
    i += 1;
  }
  gnu.finish(o);
  return 0;
}
