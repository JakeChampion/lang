// dircolors.fern — GNU-compatible `dircolors`.
//
//   dircolors                  the built-in database, as shell commands
//   dircolors FILE             that file instead (`-` is standard input)
//   -b, --sh, --bourne-shell   Bourne syntax
//   -c, --csh, --c-shell       C shell syntax
//   -p, --print-database       the built-in database, verbatim
//       --print-ls-colors      one escaped line per entry
//
// One TEXT serves both jobs. `-p` prints the database below unchanged,
// and the default LS_COLORS is what the ordinary file parser makes of
// that same text — which is why the commented-out `#NORMAL 00` lines
// never become entries and why `-p` output carries TERM lines.
//
// The parse is filtered by $TERM and $COLORTERM, so the no-operand
// output is environment-dependent while `-p` is not. The filter is a
// four-state machine rather than a flag: a TERM line that does NOT match
// only closes the section when an ordinary line has been consumed since
// the one that opened it, so `TERM linux / TERM vt52 / DIR 3` sets di=3
// and `TERM linux / DIR 2 / TERM vt52 / DIR 3` does not. The same four
// states decide whether an unknown keyword is a fatal diagnostic or is
// passed over in silence: outside any section it is ignored.
//
// The pattern is fnmatch(3) with flags 0, which `std/glob` is not —
// there `*` stops at `/`, `**` means something, and a backslash escapes
// nothing — so the matcher is `lib/fnmatch.fern`, which `ls -I` shares.
import "std/string";
import "./lib/colordb";
import "./lib/fnmatch";
import "./lib/gnu";

// ---- the keyword table -----------------------------------------------------
function eq_fold(a: u8[], lo: i32, hi: i32, b: string): boolean {
  if (hi - lo != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < hi - lo) {
    let x: i32 = a[lo + i] as i32;
    let y: i32 = b[i] as i32;
    if (x >= 65 && x <= 90) {
      x = x + 32;
    }
    if (y >= 65 && y <= 90) {
      y = y + 32;
    }
    if (x != y) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// `lookup(raw, lo, hi)` returns (kind, code): 0 unknown, 1 an entry
// under `code`, 2 recognised and contributing nothing.
//
// 37 names for 24 two-letter codes, plus the three the slackware
// dircolors honoured that GNU accepts and does nothing with. The match
// folds case; the EXTENSION keywords do not reach here, which is why
// `.GZ` keeps its case and `dIr` does not.
function lookup(kw: u8[], lo: i32, hi: i32): (i32, string) {
  if (eq_fold(kw, lo, hi, "NORMAL") || eq_fold(kw, lo, hi, "NORM")) {
    return (1, "no");
  }
  if (eq_fold(kw, lo, hi, "FILE")) {
    return (1, "fi");
  }
  if (eq_fold(kw, lo, hi, "RESET")) {
    return (1, "rs");
  }
  if (eq_fold(kw, lo, hi, "DIR")) {
    return (1, "di");
  }
  if (eq_fold(kw, lo, hi, "LNK") || eq_fold(kw, lo, hi, "LINK") || eq_fold(kw, lo, hi, "SYMLINK")) {
    return (1, "ln");
  }
  if (eq_fold(kw, lo, hi, "ORPHAN")) {
    return (1, "or");
  }
  if (eq_fold(kw, lo, hi, "MISSING")) {
    return (1, "mi");
  }
  if (eq_fold(kw, lo, hi, "FIFO") || eq_fold(kw, lo, hi, "PIPE")) {
    return (1, "pi");
  }
  if (eq_fold(kw, lo, hi, "SOCK")) {
    return (1, "so");
  }
  if (eq_fold(kw, lo, hi, "BLK") || eq_fold(kw, lo, hi, "BLOCK")) {
    return (1, "bd");
  }
  if (eq_fold(kw, lo, hi, "CHR") || eq_fold(kw, lo, hi, "CHAR")) {
    return (1, "cd");
  }
  if (eq_fold(kw, lo, hi, "DOOR")) {
    return (1, "do");
  }
  if (eq_fold(kw, lo, hi, "EXEC")) {
    return (1, "ex");
  }
  if (eq_fold(kw, lo, hi, "LEFT") || eq_fold(kw, lo, hi, "LEFTCODE")) {
    return (1, "lc");
  }
  if (eq_fold(kw, lo, hi, "RIGHT") || eq_fold(kw, lo, hi, "RIGHTCODE")) {
    return (1, "rc");
  }
  if (eq_fold(kw, lo, hi, "END") || eq_fold(kw, lo, hi, "ENDCODE")) {
    return (1, "ec");
  }
  if (eq_fold(kw, lo, hi, "SUID") || eq_fold(kw, lo, hi, "SETUID")) {
    return (1, "su");
  }
  if (eq_fold(kw, lo, hi, "SGID") || eq_fold(kw, lo, hi, "SETGID")) {
    return (1, "sg");
  }
  if (eq_fold(kw, lo, hi, "STICKY")) {
    return (1, "st");
  }
  if (eq_fold(kw, lo, hi, "OTHER_WRITABLE") || eq_fold(kw, lo, hi, "OWR")) {
    return (1, "ow");
  }
  if (eq_fold(kw, lo, hi, "STICKY_OTHER_WRITABLE") || eq_fold(kw, lo, hi, "OWT")) {
    return (1, "tw");
  }
  if (eq_fold(kw, lo, hi, "CAPABILITY")) {
    return (1, "ca");
  }
  if (eq_fold(kw, lo, hi, "MULTIHARDLINK")) {
    return (1, "mh");
  }
  if (eq_fold(kw, lo, hi, "CLRTOEOL")) {
    return (1, "cl");
  }
  if (eq_fold(kw, lo, hi, "OPTIONS") || eq_fold(kw, lo, hi, "COLOR") || eq_fold(kw, lo, hi, "EIGHTBIT")) {
    return (2, "");
  }
  return (0, "");
}

// ---- the line grammar ------------------------------------------------------
//
// Skip leading whitespace; an empty line or one starting `#` is passed
// over. The keyword runs to the next whitespace — `#` is not a
// terminator there, which is how the database's `*# 00;90` line works.
// Whitespace is skipped; end of line or a `#` there is the missing
// second token. The argument is then the REST of the line up to a `#`,
// with trailing whitespace trimmed, so `DIR 01;34 extra` is the one
// value `01;34 extra`.
//
// A NUL byte ends the line for parsing but not for counting: the line
// it sits on is still one line.
function is_space(c: i32): boolean {
  return c == 32 || c == 9 || c == 11 || c == 12 || c == 13;
}

// ---- the parse -------------------------------------------------------------
//
// The body is escaped straight out of the input buffer into one builder
// as the lines are read, so the config is never cut into a string per
// entry; a parse that fails hands back no body at all.
struct Parse { body: u8[], ok: boolean }

// The four states of the TERM / COLORTERM filter.
function st_global(): i32 {
  return 0;
}

function st_termno(): i32 {
  return 1;
}

function st_termsure(): i32 {
  return 2;
}

function st_termyes(): i32 {
  return 3;
}

// `entry_push(h, text, item_lo, item_hi, star, code, arg_lo, arg_hi, ls)`
// — one entry of the body: the item is `text[item_lo, item_hi)` with a
// `*` in front when `star`, or the two-letter `code` when that is not
// empty. `ls` picks the `--print-ls-colors` line over the LS_COLORS
// piece.
function entry_push(h: usize, text: u8[], item_lo: i32, item_hi: i32, star: boolean, code: string, arg_lo: i32, arg_hi: i32, ls: boolean): void {
  if (ls) {
    buf_push(h, "\x1b[");
    buf_push_bytes_range(h, text, arg_lo, arg_hi);
    buf_push_byte(h, 109);
    if (code.len() > 0) {
      buf_push(h, code);
    } else {
      if (star) {
        buf_push_byte(h, 42);
      }
      buf_push_bytes_range(h, text, item_lo, item_hi);
    }
    buf_push_byte(h, 9);
    buf_push_bytes_range(h, text, arg_lo, arg_hi);
    buf_push(h, "\x1b[0m\n");
    return;
  }
  if (code.len() > 0) {
    buf_push(h, code);
  } else {
    // A leading `*` is written through by the escaper and leaves its
    // toggle where it started, so it goes in ahead of the keyword as is.
    if (star) {
      buf_push_byte(h, 42);
    }
    escape_push(h, text, item_lo, item_hi);
  }
  buf_push_byte(h, 61);
  escape_push(h, text, arg_lo, arg_hi);
  buf_push_byte(h, 58);
}

// GNU prints an unknown keyword verbatim, even when it is not UTF-8.
function unknown_keyword(name: string, lineno: i32, text: u8[], lo: i32, hi: i32): void {
  let h: usize = buf_new(0);
  buf_push(h, gnu.prog() + ": " + name + ":" + lineno.to_string() + ": unrecognized keyword ");
  buf_push_bytes_range(h, text, lo, hi);
  buf_push_byte(h, 10);
  let message: u8[] = buf_take_bytes(h);
  buf_free(h);
  stderr().write_bytes(message);
}

function parse(text: u8[], name: string, term: string, colorterm: string, ls: boolean): Parse {
  let h: usize = buf_new(text.len() + 16);
  let ok: boolean = true;
  let state: i32 = st_global();
  let pos: i32 = 0;
  let lineno: i32 = 0;
  // The next NUL at or after the cursor, refreshed only once the cursor
  // has passed it: searching each line separately would rescan the rest
  // of the buffer per line.
  let nul: i32 = __memchr_bytes(text, 0, 0);
  while (pos < text.len()) {
    let nl: i32 = __memchr_bytes(text, 10, pos);
    let end: i32 = nl;
    if (nl < 0) {
      end = text.len();
    }
    lineno = lineno + 1;
    if (nul >= 0 && nul < pos) {
      nul = __memchr_bytes(text, 0, pos);
    }
    let cut: i32 = end;
    if (nul >= 0 && nul < end) {
      cut = nul;
    }
    // Keep line and token bounds as scalars rather than allocating one
    // record and one keyword slice per line. NUL has already cut the line.
    let i: i32 = pos;
    while (i < cut && is_space(text[i] as i32)) {
      i = i + 1;
    }
    let kind: i32 = 0;
    let ks: i32 = i;
    let ke: i32 = i;
    let as0: i32 = i;
    let ae: i32 = i;
    if (i < cut && text[i] as i32 != 35) {
      while (i < cut && !is_space(text[i] as i32)) {
        i = i + 1;
      }
      ke = i;
      while (i < cut && is_space(text[i] as i32)) {
        i = i + 1;
      }
      kind = 2;
      if (i < cut && text[i] as i32 != 35) {
        as0 = i;
        while (i < cut && text[i] as i32 != 35) {
          i = i + 1;
        }
        ae = i;
        while (ae > as0 && is_space(text[ae - 1] as i32)) {
          ae = ae - 1;
        }
        kind = 1;
      }
    }
    if (kind == 2) {
      gnu.error(name + ":" + lineno.to_string() + ": invalid line;  missing second token");
      ok = false;
    } else if (kind == 1) {
      let lead: i32 = text[ks] as i32;
      let extension: boolean = lead == 46 || lead == 42;
      if (extension) {
        if (state == st_termsure()) {
          state = st_termyes();
        }
        if (state != st_termno()) {
          entry_push(h, text, ks, ke, lead == 46, "", as0, ae, ls);
        }
      } else {
        if (eq_fold(text, ks, ke, "TERM") || eq_fold(text, ks, ke, "COLORTERM")) {
          let value: string = colorterm;
          if (eq_fold(text, ks, ke, "TERM")) {
            value = term;
          }
          if (state != st_termsure()) {
            state = st_termno();
          }
          if (fnmatch.fnmatch_bytes_text(text[as0:ae], value)) {
            state = st_termsure();
          }
        } else {
          if (state == st_termsure()) {
            state = st_termyes();
          }
          if (state != st_termno()) {
            let hit: (i32, string) = lookup(text, ks, ke);
            if (hit.0 == 1) {
              entry_push(h, text, ks, ke, false, hit.1, as0, ae, ls);
            } else if (hit.0 == 0 && state == st_termyes()) {
              // Outside a matching section an unknown keyword is passed
              // over in silence; inside one it is fatal.
              unknown_keyword(name, lineno, text, ks, ke);
              ok = false;
            }
          }
        }
      }
    }
    if (nl < 0) {
      break;
    }
    pos = nl + 1;
  }
  let body: u8[] = [];
  if (ok) {
    body = buf_take_bytes(h);
  }
  buf_free(h);
  return Parse { body: body, ok: ok };
}

// ---- the shell escaper -----------------------------------------------------
//
// Not a plain escape but a toggle, and the state starts over at each
// item and each argument. A `\` or a `^` is written through and FLIPS
// the flag; a `:` or an `=` takes a leading backslash only while the
// flag is set; a `'` becomes `'\''`; every other byte sets the flag.
// So `a\:b` comes back unchanged, `a^^:b` gains a backslash and
// `a^:b` does not.
function escape_push(h: usize, s: u8[], lo: i32, hi: i32): void {
  let need: boolean = true;
  let i: i32 = lo;
  let run: i32 = lo;
  while (i < hi) {
    let c: i32 = s[i] as i32;
    if (c == 58 || c == 61 || c == 92 || c == 94 || c == 39) {
      if (i > run) {
        buf_push_bytes_range(h, s, run, i);
        need = true;
      }
      if (c == 39) {
        buf_push(h, "'\\''");
        need = true;
      } else if (c == 92 || c == 94) {
        buf_push_byte(h, c);
        need = !need;
      } else {
        if (need) {
          buf_push_byte(h, 92);
        }
        buf_push_byte(h, c);
        need = true;
      }
      i = i + 1;
      run = i;
    } else {
      i = i + 1;
    }
  }
  if (i > run) {
    buf_push_bytes_range(h, s, run, hi);
  }
}

// ---- input -----------------------------------------------------------------
struct Input { bytes: u8[], ok: boolean }

// `name` is already rendered the way the diagnostics want it. A read
// failure and a close failure are reported separately, which is how
// `dircolors - <&-` says both.
function read_stream(r: Reader, name: string): Input {
  let h: usize = buf_new(0);
  let ok: boolean = true;
  while (true) {
    match (r.read_chunk_bytes(65536)) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          break;
        }
        buf_push_bytes_range(h, chunk, 0, chunk.len());
      },
      Err(e) => {
        gnu.error(name + ": read error: " + gnu.io_error_text(e));
        ok = false;
        break;
      }
    }
  }
  match (r.close()) {
    Some(e) => {
      gnu.error(name + ": " + gnu.io_error_text(e));
      ok = false;
    },
    None => {}
  }
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  return Input { bytes: bytes, ok: ok };
}

function read_input(path: string): Input {
  let name: string = gnu.quotef(path);
  if (path == "-") {
    return read_stream(stdin(), name);
  }
  // An open failure and a read failure are worded differently — a
  // directory opens and then fails to read — so the open is made here
  // rather than inferred from a whole-file read.
  match (open_reader(path)) {
    Ok(r) => {
      return read_stream(r, name);
    },
    Err(e) => {
      gnu.error(name + ": " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return Input { bytes: [], ok: false };
}

// ---- options ---------------------------------------------------------------
function opt_bourne(): i32 {
  return 1;
}

function opt_csh(): i32 {
  return 2;
}

function opt_print_db(): i32 {
  return 3;
}

function opt_print_ls(): i32 {
  return 4;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]\n";
  out = out + "Write the shell commands that set LS_COLORS, which GNU ls reads.\n";
  out = out + "\n";
  out = out + "  -b, --sh, --bourne-shell   write Bourne shell syntax\n";
  out = out + "  -c, --csh, --c-shell       write C shell syntax\n";
  out = out + "  -p, --print-database       write the built-in database instead\n";
  out = out + "      --print-ls-colors      write one escaped line per entry\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "With no FILE the built-in database is read; `-` reads standard input.\n";
  out = out + "Without -b or -c the shell is taken from $SHELL. The entries a FILE\n";
  out = out + "contributes are filtered by its TERM and COLORTERM lines against the\n";
  out = out + "environment.\n";
  return out;
}

// $SHELL names csh when its last path component is exactly `csh` or
// `tcsh`. A trailing slash is not stripped, so `/bin/csh/` is not one.
function shell_is_csh(shell: string): boolean {
  let cut: i32 = shell.last_index_of("/");
  let base: string = shell;
  if (cut >= 0) {
    base = slice_unchecked(shell, cut + 1, shell.len()) + "";
  }
  return base == "csh" || base == "tcsh";
}

// An EMPTY value counts as absent, which is what makes `TERM=` and an
// unset TERM both the literal string `none`.
function env_or(name: string, fallback: string): string {
  match (env(name)) {
    Some(v) => {
      if (v.len() == 0) {
        return fallback;
      }
      return v;
    },
    None => {}
  }
  return fallback;
}

pub function main(): i32 {
  // Declaration order is glibc's ambiguity list: `--=x` names every
  // candidate but `--sh`, which shares `--bourne-shell`'s id.
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("b", "bourne-shell", opt_bourne()));
  opts = opts.append(gnu.flag("", "sh", opt_bourne()));
  opts = opts.append(gnu.flag("c", "csh", opt_csh()));
  opts = opts.append(gnu.flag("", "c-shell", opt_csh()));
  opts = opts.append(gnu.flag("p", "print-database", opt_print_db()));
  opts = opts.append(gnu.flag("", "print-ls-colors", opt_print_ls()));
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "dircolors", help_text(), 1);
  // 0 unknown, 1 Bourne, 2 csh; the last of -b / -c decides.
  let syntax: i32 = 0;
  let print_db: boolean = false;
  let print_ls: boolean = false;
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_bourne()) {
          syntax = 1;
        } else if (m.id == opt_csh()) {
          syntax = 2;
        } else if (m.id == opt_print_db()) {
          print_db = true;
        } else {
          print_ls = true;
        }
      },
      None => {
        break;
      }
    }
  }

  // The order the faults are reached in: the shell-syntax exclusion,
  // then the two print options against each other, then the operand
  // count, then the shell guess, then the file.
  if ((print_db || print_ls) && syntax != 0) {
    gnu.die_usage("the options to output non shell syntax,\nand to select a shell syntax are mutually exclusive", 1);
  }
  if (print_db && print_ls) {
    gnu.die_usage("options --print-database and --print-ls-colors are mutually exclusive", 1);
  }
  let operands: string[] = g.operands();
  // `-p` takes no operand at all, so the FIRST one is the extra one.
  let limit: i32 = 1;
  if (print_db) {
    limit = 0;
  }
  if (operands.len() > limit) {
    gnu.error("extra operand " + gnu.quote(operands[limit]));
    if (print_db) {
      eprint("file operands cannot be combined with --print-database (-p)");
    }
    gnu.try_help(1);
  }

  if (print_db) {
    // puts() per line, which is TWO pieces — the line, then its newline
    // — and where those fall in the stdio buffer is what decides
    // whether a failed write is reported with its errno or bare.
    let od: gnu.Stdio = gnu.stdio_new();
    let db: string = colordb.text();
    let at: i32 = 0;
    while (at < db.len()) {
      let nl: i32 = __memchr(db, 10, at);
      od = od.fwrite(slice_unchecked(db, at, nl) + "");
      od = od.fwrite("\n");
      at = nl + 1;
    }
    od.close_stdout();
    return 0;
  }

  if (!print_ls && syntax == 0) {
    match (env("SHELL")) {
      Some(shell) => {
        if (shell.len() == 0) {
          gnu.error("no SHELL environment variable, and no shell type option given");
          exit(1);
        }
        if (shell_is_csh(shell)) {
          syntax = 2;
        } else {
          syntax = 1;
        }
      },
      None => {
        gnu.error("no SHELL environment variable, and no shell type option given");
        exit(1);
      }
    }
  }

  let text: u8[] = [];
  let name: string = "";
  if (operands.len() == 1) {
    let input: Input = read_input(operands[0]);
    if (!input.ok) {
      return 1;
    }
    text = input.bytes;
    name = gnu.quotef(operands[0]);
  } else {
    text = colordb.text().bytes();
  }

  // An unset or empty TERM is the literal string `none`; an unset
  // COLORTERM is the empty string, which `?*` never matches.
  let p: Parse = parse(text, name, env_or("TERM", "none"), env_or("COLORTERM", ""), print_ls);
  if (!p.ok) {
    return 1;
  }

  // The whole body is assembled and written as ONE piece, with the
  // shell syntax around it as one more on each side, because that is
  // the call sequence at the other end of the buffer: a failure on the
  // body leaves the suffix pending at close and is reported with its
  // errno, where `--print-ls-colors` writes one piece and nothing is
  // pending, so the same failure is a bare `write error`.
  let o: gnu.Stdio = gnu.stdio_new();
  if (print_ls) {
    o = o.fwrite_bytes(p.body);
    o.close_stdout();
    return 0;
  }
  let body: u8[] = p.body;
  if (syntax == 2) {
    o = o.fwrite("setenv LS_COLORS '");
    o = o.fwrite_bytes(body);
    o = o.fwrite("'\n");
  } else {
    o = o.fwrite("LS_COLORS='");
    o = o.fwrite_bytes(body);
    o = o.fwrite("';\nexport LS_COLORS\n");
  }
  o.close_stdout();
  return 0;
}
