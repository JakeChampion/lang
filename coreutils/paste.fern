import "std/array";
import "std/io_buffered";
import "./lib/gnu";

function opt_serial(): i32 {
  return 1;
}

function opt_delims(): i32 {
  return 2;
}

function opt_zero(): i32 {
  return 3;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out += "Write lines consisting of the sequentially corresponding lines from\n";
  out += "each FILE, separated by TABs, to standard output.\n";
  out += "\n";
  out += "With no FILE, or when FILE is -, read standard input.\n";
  out += "\n";
  out += "  -d, --delimiters=LIST   reuse characters from LIST instead of TABs\n";
  out += "  -s, --serial            paste one file at a time instead of in parallel\n";
  out += "  -z, --zero-terminated    line delimiter is NUL, not newline\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  return out;
}

function read_size(): i32 {
  return 65536;
}

function block_size(): i32 {
  return 16384;
}

function collapse(list: string): u8[] {
  let out: u8[] = [];
  let i = 0;
  while (i < list.len()) {
    let c = list[i] as i32;
    if (c != 92) {
      out = out.append(c as u8);
      i += 1;
      continue;
    }
    i += 1;
    if (i >= list.len()) {
      gnu.error("delimiter list ends with an unescaped backslash: " + list);
      exit(1);
    }
    let e = list[i] as i32;
    if (e == 48) {
      out = out.append(0 as u8);
    } else if (e == 98) {
      out = out.append(8 as u8);
    } else if (e == 102) {
      out = out.append(12 as u8);
    } else if (e == 110) {
      out = out.append(10 as u8);
    } else if (e == 114) {
      out = out.append(13 as u8);
    } else if (e == 116) {
      out = out.append(9 as u8);
    } else if (e == 118) {
      out = out.append(11 as u8);
    } else {
      out = out.append(e as u8);
    }
    i += 1;
  }
  return out;
}

pub function main(): i32 {
  let argv = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("s", "serial", opt_serial()));
  opts = opts.append(gnu.valued("d", "delimiters", opt_delims()));
  opts = opts.append(gnu.flag("z", "zero-terminated", opt_zero()));

  let serial = false;
  let list = "\t";
  let term = 10;
  let g = gnu.getopt_new(argv, opts, "paste", help_text(), 1);
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_serial()) {
          serial = true;
        } else if (m.id == opt_delims()) {
          if (m.value.len() == 0) {
            list = "\\0";
          } else {
            list = m.value;
          }
        } else if (m.id == opt_zero()) {
          term = 0;
        }
      },
      None => {
        break;
      }
    }
  }
  let delims = collapse(list);

  let files = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  if (serial) {
    return run_serial(files, delims, term);
  }
  return run_parallel(files, delims, term);
}

function run_serial(files: string[], delims: u8[], term: i32): i32 {
  let o = gnu.out_with(block_size());
  let h = o.handle();
  let ok = true;

  let fi = 0;
  while (fi < files.len()) {
    let name = files[fi];
    fi += 1;
    let is_stdin = name == "-";
    let r = stdin();
    let opened = true;
    if (!is_stdin) {
      opened = false;
      match (open_reader(name)) {
        Ok(f) => {
          r = f;
          opened = true;
        },
        Err(e) => {
          o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
          ok = false;
        }
      }
    }
    if (!opened) {
      continue;
    }
    let chunk: u8[] = [];
    let pos = 0;
    let eof = false;
    let di = 0;
    let first_line = true;
    let in_line = false;
    while (true) {
      if (pos >= chunk.len()) {
        if (eof) {
          break;
        }
        let piece: u8[] = [];
        let read_ok = true;
        match (r.read_chunk_bytes(read_size())) {
          Ok(c) => {
            piece = c;
          },
          Err(e) => {
            o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
            ok = false;
            read_ok = false;
          }
        }
        if (!read_ok || piece.len() == 0) {
          eof = true;
        } else {
          chunk = piece;
          pos = 0;
        }
        continue;
      }
      let j = __memchr_bytes(chunk, term, pos);
      let end = chunk.len();
      let terminated = false;
      if (j >= 0) {
        end = j;
        terminated = true;
      }
      if (terminated || end > pos) {
        if (!in_line) {
          if (!first_line) {
            if (delims[di] != 0 as u8) {
              buf_push_byte(h, delims[di] as i32);
            }
            di += 1;
            if (di >= delims.len()) {
              di = 0;
            }
          }
          first_line = false;
          in_line = true;
        }
        buf_push_bytes_range(h, chunk, pos, end);
      }
      pos = end;
      if (terminated) {
        pos += 1;
        in_line = false;
      }
      if (buf_len(h) >= block_size()) {
        o = gnu.flush(o);
      }
    }
    buf_push_byte(h, term);
    if (!is_stdin) {
      r.close();
    }
    if (buf_len(h) >= block_size()) {
      o = gnu.flush(o);
    }
  }

  gnu.finish(o);
  if (!ok) {
    return 1;
  }
  return 0;
}

function run_parallel(files: string[], delims: u8[], term: i32): i32 {
  let o = gnu.out_with(block_size());
  let h = o.handle();
  let ok = true;

  let rs: Reader[] = [];
  let chunks: u8[][] = [];
  let poss: i32[] = [];
  let eofs: boolean[] = [];
  let live: boolean[] = [];
  let stdins: boolean[] = [];
  let slot: i32[] = [];
  let stdin_slot = -1;
  let i = 0;
  while (i < files.len()) {
    let name = files[i];
    let is_stdin = name == "-";
    live = live.append(true);
    stdins = stdins.append(is_stdin);
    if (is_stdin && stdin_slot >= 0) {
      slot = slot.append(stdin_slot);
      i += 1;
      continue;
    }
    let r = stdin();
    if (!is_stdin) {
      match (open_reader(name)) {
        Ok(f) => {
          r = f;
        },
        Err(e) => {
          gnu.error(gnu.quotef(name) + ": " + gnu.io_error_text(e));
          gnu.finish(o);
          return 1;
        }
      }
    }
    slot = slot.append(rs.len());
    if (is_stdin) {
      stdin_slot = rs.len();
    }
    rs = rs.append(r);
    chunks = chunks.append([]);
    poss = poss.append(0);
    eofs = eofs.append(false);
    i += 1;
  }

  let open_count = files.len();
  while (open_count > 0) {
    let somedone = false;
    let di = 0;
    let held: u8[] = [];
    i = 0;
    while (i < files.len()) {
      let k = slot[i];
      let produced = false;
      let took_term = false;
      let whole = false;
      if (live[i]) {
        let ck = chunks[k];
        let cp = poss[k];
        if (cp < ck.len()) {
          let w = __memchr_bytes(ck, term, cp);
          if (w >= 0) {
            whole = true;
            produced = true;
            somedone = true;
            if (held.len() > 0) {
              buf_push_bytes_range(h, held, 0, held.len());
              held = [];
            }
            let upto = w;
            if (i + 1 == files.len()) {
              upto = w + 1;
              took_term = true;
            }
            buf_push_bytes_range(h, ck, cp, upto);
            poss = poss.with(k, w + 1);
          }
        }
      }
      if (live[i] && !whole) {
        while (poss[k] >= chunks[k].len() && !eofs[k]) {
          let piece: u8[] = [];
          let read_ok = true;
          match (rs[k].read_chunk_bytes(read_size())) {
            Ok(c) => {
              piece = c;
            },
            Err(e) => {
              o = gnu.error_out(o, gnu.quotef(files[i]) + ": " + gnu.io_error_text(e));
              ok = false;
              read_ok = false;
            }
          }
          if (!read_ok || piece.len() == 0) {
            eofs = eofs.with(k, true);
          } else {
            chunks = chunks.with(k, piece);
            poss = poss.with(k, 0);
          }
        }
        if (poss[k] < chunks[k].len()) {
          produced = true;
          somedone = true;
          if (held.len() > 0) {
            buf_push_bytes_range(h, held, 0, held.len());
            held = [];
          }
          let reading = true;
          while (reading) {
            if (poss[k] >= chunks[k].len()) {
              if (eofs[k]) {
                reading = false;
              } else {
                let more: u8[] = [];
                let read2 = true;
                match (rs[k].read_chunk_bytes(read_size())) {
                  Ok(c) => {
                    more = c;
                  },
                  Err(e) => {
                    o = gnu.error_out(o, gnu.quotef(files[i]) + ": " + gnu.io_error_text(e));
                    ok = false;
                    read2 = false;
                  }
                }
                if (!read2 || more.len() == 0) {
                  eofs = eofs.with(k, true);
                } else {
                  chunks = chunks.with(k, more);
                  poss = poss.with(k, 0);
                }
              }
            } else {
              let j = __memchr_bytes(chunks[k], term, poss[k]);
              if (j >= 0) {
                let upto = j;
                if (i + 1 == files.len()) {
                  upto = j + 1;
                  took_term = true;
                }
                buf_push_bytes_range(h, chunks[k], poss[k], upto);
                poss = poss.with(k, j + 1);
                reading = false;
              } else {
                buf_push_bytes_range(h, chunks[k], poss[k], chunks[k].len());
                poss = poss.with(k, chunks[k].len());
              }
            }
          }
          if (poss[k] >= chunks[k].len() && eofs[k]) {
            produced = false;
          }
        }
      }
      if (!produced) {
        if (live[i]) {
          live = live.with(i, false);
          open_count -= 1;
          if (!stdins[i]) {
            let (done, rest) = rs.swap_at(k, stdin());
            rs = rest;
            done.close();
          }
        }
        if (i + 1 == files.len()) {
          if (somedone) {
            buf_push_bytes_range(h, held, 0, held.len());
            held = [];
            buf_push_byte(h, term);
          }
        } else {
          if (delims[di] != 0 as u8) {
            held = held.append(delims[di]);
          }
          di += 1;
          if (di >= delims.len()) {
            di = 0;
          }
        }
      } else {
        if (i + 1 == files.len()) {
          if (!took_term) {
            buf_push_byte(h, term);
          }
        } else if (delims[di] != 0 as u8) {
          buf_push_byte(h, delims[di] as i32);
          di += 1;
          if (di >= delims.len()) {
            di = 0;
          }
        } else {
          di += 1;
          if (di >= delims.len()) {
            di = 0;
          }
        }
      }
      i += 1;
    }
    if (buf_len(h) >= block_size()) {
      o = gnu.flush(o);
    }
  }

  gnu.finish(o);
  if (!ok) {
    return 1;
  }
  return 0;
}
