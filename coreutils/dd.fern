import "std/string";
import "std/i32";
import "std/i64";
import "std/u64";
import "core/mem";
import "std/signal";
import "std/errno";
import "./lib/gnu";
import "./lib/signals";

function op_names(): string[] {
  return ["bs", "cbs", "conv", "count", "ibs", "if", "iflag", "iseek", "obs", "of", "oflag", "oseek", "seek", "skip", "status"];
}

function conv_names(): string[] {
  return ["block", "unblock", "lcase", "ucase", "swab", "sync", "excl", "nocreat", "notrunc", "noerror", "fdatasync", "fsync", "ascii", "ebcdic", "ibm", "sparse"];
}

function conv_bits(): i32[] {
  return [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096 | 2, 8192 | 1, 16384 | 1, 32768];
}

function conv_block(): i32 {
  return 1;
}

function conv_unblock(): i32 {
  return 2;
}

function conv_lcase(): i32 {
  return 4;
}

function conv_ucase(): i32 {
  return 8;
}

function conv_swab(): i32 {
  return 16;
}

function conv_sync(): i32 {
  return 32;
}

function conv_excl(): i32 {
  return 64;
}

function conv_nocreat(): i32 {
  return 128;
}

function conv_notrunc(): i32 {
  return 256;
}

function conv_noerror(): i32 {
  return 512;
}

function conv_fdatasync(): i32 {
  return 1024;
}

function conv_fsync(): i32 {
  return 2048;
}

function conv_ascii(): i32 {
  return 4096;
}

function conv_ebcdic(): i32 {
  return 8192;
}

function conv_ibm(): i32 {
  return 16384;
}

function conv_sparse(): i32 {
  return 32768;
}

function iflag_names(): string[] {
  return ["append", "count_bytes", "fullblock", "nonblock", "seek_bytes", "skip_bytes", "direct", "directory", "dsync", "sync", "noatime", "noctty", "nofollow", "nocache"];
}

function iflag_bits(): i32[] {
  return [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, flag_nocache()];
}

function oflag_names(): string[] {
  return ["append", "count_bytes", "nonblock", "seek_bytes", "skip_bytes", "direct", "directory", "dsync", "sync", "noatime", "noctty", "nofollow", "nocache"];
}

function oflag_bits(): i32[] {
  return [1, 2, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, flag_nocache()];
}

function open_flags(f: i32): i32 {
  let out: i32 = 0;
  if ((f & flag_nonblock()) != 0) {
    out = out | 2;
  }
  out = out | f >> 3 & 1016;
  return out;
}

function flag_append(): i32 {
  return 1;
}

function flag_count_bytes(): i32 {
  return 2;
}

function flag_fullblock(): i32 {
  return 4;
}

function flag_nonblock(): i32 {
  return 8;
}

function flag_seek_bytes(): i32 {
  return 16;
}

function flag_skip_bytes(): i32 {
  return 32;
}

function flag_nocache(): i32 {
  return 8192;
}

function status_default(): i32 {
  return 0;
}

function status_none(): i32 {
  return 1;
}

function status_noxfer(): i32 {
  return 2;
}

function status_progress(): i32 {
  return 3;
}

function status_names(): string[] {
  return ["none", "noxfer", "progress"];
}

struct Settings { in_name: string, out_name: string, have_in: boolean, have_out: boolean, ibs: i64, obs: i64, cbs: i64, count: i64, have_count: boolean, skip: i64, seek: i64, conv: i32, iflag: i32, oflag: i32, status: i32 }

function settings_new(): Settings {
  return Settings { in_name: "", out_name: "", have_in: false, have_out: false, ibs: 512 as i64, obs: 512 as i64, cbs: 0 as i64, count: 0 as i64, have_count: false, skip: 0 as i64, seek: 0 as i64, conv: 0, iflag: 0, oflag: 0, status: status_default() };
}

struct Num { value: i64, status: i32, bytes: boolean }

function num_bad(): i32 {
  return 1;
}

function num_over(): i32 {
  return 2;
}

function piece_units(p: string): (u64, i32) {
  if (p.len() == 0) {
    return (0 as u64, 1);
  }
  let last: u8 = p[p.len() - 1];
  if (last != b'c' && last != b'w') {
    return gnu.parse_units(p);
  }
  let scale: u64 = 1 as u64;
  if (last == b'w') {
    scale = 2 as u64;
  }
  let head: string = slice_unchecked(p, 0, p.len() - 1) + "";
  if (head.len() == 0) {
    return (scale, 0);
  }
  let got: (u64, i32) = gnu.parse_number(head);
  if (got.1 != 0) {
    return got;
  }
  match (got.0.checked_mul(scale)) {
    Some(m) => {
      return (m, 0);
    },
    None => {
      return (0 as u64, 3);
    }
  }
}

function parse_num(v: string, positive: boolean): Num {
  let total: u64 = 1 as u64;
  let bytes: boolean = false;
  let start: i32 = 0;
  let i: i32 = 0;
  let pieces: i32 = 0;
  let zero_multiplier: boolean = false;
  while (i <= v.len()) {
    if (i == v.len() || v[i] == b'x') {
      let piece: string = slice_unchecked(v, start, i) + "";
      if (piece == "0" && i < v.len()) {
        zero_multiplier = true;
      }
      let marked: boolean = piece.len() > 0 && piece[piece.len() - 1] == b'B';
      let got: (u64, i32) = piece_units(piece);
      if (marked && gnu.count_malformed(got.1)) {
        got = piece_units(slice_unchecked(piece, 0, piece.len() - 1) + "");
      }
      if (gnu.count_malformed(got.1)) {
        return Num { value: 0 as i64, status: num_bad(), bytes: false };
      }
      if (gnu.count_overflow(got.1) || got.0 > 9223372036854775807 as u64) {
        return Num { value: 0 as i64, status: num_over(), bytes: false };
      }
      match (total.checked_mul(got.0)) {
        Some(m) => {
          total = m;
        },
        None => {
          return Num { value: 0 as i64, status: num_over(), bytes: false };
        }
      }
      if (total > 9223372036854775807 as u64) {
        return Num { value: 0 as i64, status: num_over(), bytes: false };
      }
      bytes = bytes || marked;
      pieces = pieces + 1;
      start = i + 1;
    }
    i = i + 1;
  }
  if (pieces == 0) {
    return Num { value: 0 as i64, status: num_bad(), bytes: false };
  }
  if (zero_multiplier && total == 0 as u64) {
    gnu.error("warning: '0x' is a zero multiplier; use '00x' if that is intended");
  }
  if (positive && total == 0 as u64) {
    return Num { value: 0 as i64, status: num_bad(), bytes: false };
  }
  return Num { value: total as i64, status: 0, bytes: bytes };
}

function has_sign(v: string): boolean {
  let i: i32 = 0;
  while (i < v.len()) {
    if (v[i] == b'-') {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function bad_number(v: string, status: i32): void {
  let msg: string = "invalid number: " + gnu.quote(v);
  if (status == num_over()) {
    msg = msg + ": " + gnu.eoverflow_text();
  }
  gnu.error(msg);
  exit(1);
}

function number_operand(v: string, positive: boolean): Num {
  if (has_sign(v)) {
    bad_number(v, num_bad());
  }
  let got: Num = parse_num(v, positive);
  if (got.status != 0) {
    bad_number(v, got.status);
  }
  return got;
}

function parse_set(v: string, names: string[], bits: i32[], wording: string): i32 {
  let out: i32 = 0;
  let start: i32 = 0;
  let i: i32 = 0;
  while (i <= v.len()) {
    if (i == v.len() || v[i] == b',') {
      let name: string = slice_unchecked(v, start, i) + "";
      let at: i32 = index_in(names, name);
      if (at < 0) {
        gnu.error("invalid " + wording + ": " + gnu.quote(name));
        gnu.try_help(1);
      }
      out = out | bits[at];
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

function index_in(names: string[], name: string): i32 {
  let i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

struct Scan { s: Settings, bs_given: boolean }

function bytes_bit(n: Num, bit: i32): i32 {
  if (n.bytes) {
    return bit;
  }
  return 0;
}

function scan_operands(argv: string[]): Scan {
  let s: Settings = settings_new();
  let bs_given: boolean = false;
  let bs: i64 = 0 as i64;
  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    let eq: i32 = find_eq(a);
    if (eq < 0) {
      gnu.error("unrecognized operand " + gnu.quote(a));
      gnu.try_help(1);
    }
    let name: string = slice_unchecked(a, 0, eq) + "";
    let value: string = slice_unchecked(a, eq + 1, a.len()) + "";
    if (index_in(op_names(), name) < 0) {
      gnu.error("unrecognized operand " + gnu.quote(a));
      gnu.try_help(1);
    }
    if (name == "if") {
      s = Settings { ...s, in_name: value, have_in: true };
    } else if (name == "of") {
      s = Settings { ...s, out_name: value, have_out: true };
    } else if (name == "bs") {
      let b: Num = number_operand(value, true);
      bs = b.value;
      bs_given = true;
    } else if (name == "ibs") {
      let ib: Num = number_operand(value, true);
      s = Settings { ...s, ibs: ib.value };
    } else if (name == "obs") {
      let ob: Num = number_operand(value, true);
      s = Settings { ...s, obs: ob.value };
    } else if (name == "cbs") {
      let cb: Num = number_operand(value, true);
      s = Settings { ...s, cbs: cb.value };
    } else if (name == "count") {
      let cn: Num = number_operand(value, false);
      s = Settings { ...s, count: cn.value, have_count: true, iflag: s.iflag | bytes_bit(cn, flag_count_bytes()) };
    } else if (name == "skip" || name == "iseek") {
      let sn: Num = number_operand(value, false);
      s = Settings { ...s, skip: sn.value, iflag: s.iflag | bytes_bit(sn, flag_skip_bytes()) };
    } else if (name == "seek" || name == "oseek") {
      let kn: Num = number_operand(value, false);
      s = Settings { ...s, seek: kn.value, oflag: s.oflag | bytes_bit(kn, flag_seek_bytes()) };
    } else if (name == "conv") {
      s = Settings { ...s, conv: s.conv | parse_set(value, conv_names(), conv_bits(), "conversion") };
    } else if (name == "iflag") {
      s = Settings { ...s, iflag: s.iflag | parse_set(value, iflag_names(), iflag_bits(), "input flag") };
    } else if (name == "oflag") {
      s = Settings { ...s, oflag: s.oflag | parse_set(value, oflag_names(), oflag_bits(), "output flag") };
    } else {
      s = Settings { ...s, status: status_operand(value) };
    }
    i = i + 1;
  }
  if (bs_given) {
    s = Settings { ...s, ibs: bs, obs: bs };
  }
  return Scan { s: s, bs_given: bs_given };
}

function find_eq(a: string): i32 {
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] == b'=') {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function status_operand(v: string): i32 {
  let at: i32 = index_in(status_names(), v);
  if (at < 0) {
    gnu.error("invalid status level: " + gnu.quote(v));
    gnu.try_help(1);
  }
  return at + 1;
}

struct Counts { full_in: i64, part_in: i64, full_out: i64, part_out: i64, bytes: i64, truncated: i64 }

function counts_new(): Counts {
  return Counts { full_in: 0 as i64, part_in: 0 as i64, full_out: 0 as i64, part_out: 0 as i64, bytes: 0 as i64, truncated: 0 as i64 };
}

function translation_table(conv: i32): u8[] {
  let t: u8[] = __alloc_u8(256);
  let up: boolean = (conv & conv_ucase()) != 0;
  let down: boolean = (conv & conv_lcase()) != 0;
  let from_ebcdic: u8[] = [];
  if ((conv & conv_ascii()) != 0) {
    from_ebcdic = to_ascii_table();
  }
  let to_ebcdic: u8[] = output_charset(conv);
  let i: i32 = 0;
  while (i < 256) {
    let b: i32 = i;
    if (from_ebcdic.len() == 256) {
      b = from_ebcdic[b] as i32;
    }
    if (up && b >= 97 && b <= 122) {
      b = b - 32;
    } else if (down && b >= 65 && b <= 90) {
      b = b + 32;
    }
    if (to_ebcdic.len() == 256) {
      b = to_ebcdic[b] as i32;
    }
    t = t.with(i, b as u8);
    i = i + 1;
  }
  return t;
}

function translates(conv: i32): boolean {
  return (conv & (conv_ucase() | conv_lcase() | conv_ascii() | conv_ebcdic() | conv_ibm())) != 0;
}

function apply_translation(piece: u8[], tab: u8[], conv: i32): u8[] {
  if (!translates(conv)) {
    return piece;
  }
  let b: usize = buf_new(piece.len());
  buf_push_bytes_mapped(b, piece, tab);
  let out: u8[] = buf_take_bytes(b);
  buf_free(b);
  return out;
}

function ebcdic_hex(): string {
  return "00010203372d2e2f1605250b0c0d0e0f101112133c3d322618193f271c1d1e1f"
    + "405a7f7b5b6c507d4d5d5c4e6b604b61f0f1f2f3f4f5f6f7f8f97a5e4c7e6e6f"
    + "7cc1c2c3c4c5c6c7c8c9d1d2d3d4d5d6d7d8d9e2e3e4e5e6e7e8e9ade0bd9a6d"
    + "79818283848586878889919293949596979899a2a3a4a5a6a7a8a9c04fd05f07"
    + "202122232415061728292a2b2c090a1b30311a333435360838393a3b04143ee1"
    + "4142434445464748495152535455565758596263646566676869707172737475"
    + "767778808a8b8c8d8e8f906a9b9c9d9e9fa0aaabac4aaeafb0b1b2b3b4b5b6b7"
    + "b8b9babbbca1bebfcacbcccdcecfdadbdcdddedfeaebecedeeeffafbfcfdfeff";
}

function ibm_hex(): string {
  return "00010203372d2e2f1605250b0c0d0e0f101112133c3d322618193f271c1d1e1f"
    + "405a7f7b5b6c507d4d5d5c4e6b604b61f0f1f2f3f4f5f6f7f8f97a5e4c7e6e6f"
    + "7cc1c2c3c4c5c6c7c8c9d1d2d3d4d5d6d7d8d9e2e3e4e5e6e7e8e9ade0bd5f6d"
    + "79818283848586878889919293949596979899a2a3a4a5a6a7a8a9c04fd0a107"
    + "202122232415061728292a2b2c090a1b30311a333435360838393a3b04143ee1"
    + "4142434445464748495152535455565758596263646566676869707172737475"
    + "767778808a8b8c8d8e8f909a9b9c9d9e9fa0aaabacadaeafb0b1b2b3b4b5b6b7"
    + "b8b9babbbcbdbebfcacbcccdcecfdadbdcdddedfeaebecedeeeffafbfcfdfeff";
}

function hex_nibble(c: u8): i32 {
  if (c >= b'a') {
    return c as i32 - 87;
  }
  return c as i32 - 48;
}

function decode_table(hex: string): u8[] {
  let t: u8[] = __alloc_u8(256);
  let i: i32 = 0;
  while (i < 256) {
    t = t.with(i, (hex_nibble(hex[2 * i]) * 16 + hex_nibble(hex[2 * i + 1])) as u8);
    i = i + 1;
  }
  return t;
}

function output_charset(conv: i32): u8[] {
  if ((conv & conv_ebcdic()) != 0) {
    return decode_table(ebcdic_hex());
  }
  if ((conv & conv_ibm()) != 0) {
    return decode_table(ibm_hex());
  }
  return [];
}

function to_ascii_table(): u8[] {
  let e: u8[] = decode_table(ebcdic_hex());
  let t: u8[] = __alloc_u8(256);
  let i: i32 = 0;
  while (i < 256) {
    t = t.with(e[i] as i32, i as u8);
    i = i + 1;
  }
  return t;
}

struct Swab { held: boolean, byte: u8 }

function swab_new(): Swab {
  return Swab { held: false, byte: 0 as u8 };
}

function apply_swab(sw: Swab, data: u8[], last: boolean): (Swab, u8[]) {
  let n: i32 = data.len();
  let b: usize = buf_new(n + 1);
  let out: Swab = sw;
  let i: i32 = 0;
  if (out.held && n > 0) {
    buf_push_byte(b, data[0] as i32);
    buf_push_byte(b, out.byte as i32);
    out = Swab { held: false, byte: 0 as u8 };
    i = 1;
  }
  let lanes: u64 = 0x00ff00ff00ff00ff;
  while (i + 8 <= n) {
    let w: u64 = data[i] as u64 | data[i + 1] as u64 << 8 | data[i + 2] as u64 << 16 | data[i + 3] as u64 << 24
      | data[i + 4] as u64 << 32 | data[i + 5] as u64 << 40 | data[i + 6] as u64 << 48 | data[i + 7] as u64 << 56;
    buf_push_u64(b, w >> 8 & lanes | (w & lanes) << 8);
    i = i + 8;
  }
  while (i + 1 < n) {
    buf_push_byte(b, data[i + 1] as i32);
    buf_push_byte(b, data[i] as i32);
    i = i + 2;
  }
  if (i < n) {
    out = Swab { held: true, byte: data[i] };
  }
  if (last && out.held) {
    buf_push_byte(b, out.byte as i32);
    out = Swab { held: false, byte: 0 as u8 };
  }
  let bytes: u8[] = buf_take_bytes(b);
  buf_free(b);
  return (out, bytes);
}

function apply_sync(piece: u8[], s: Settings): u8[] {
  if (piece.len() as i64 >= s.ibs) {
    return piece;
  }
  let pad: i32 = (s.ibs - piece.len() as i64) as i32;
  let fill: u8 = 0 as u8;
  if (records_wanted(s)) {
    fill = 32 as u8;
  }
  let h: usize = buf_new(piece.len() + pad);
  buf_push_bytes_range(h, piece, 0, piece.len());
  let i: i32 = 0;
  while (i < pad) {
    buf_push_byte(h, fill as i32);
    i = i + 1;
  }
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  return bytes;
}

struct BufBlock { h: usize }

impl mem.Drop for BufBlock {
  function drop(self: BufBlock): void {
    buf_free(self.h);
  }
}

struct Sink { w: Writer, buf: BufBlock, held: i32, obs: i32, name: string, c: Counts, ok: boolean, sparse: boolean, seeked: boolean, intr: i32, stopped: boolean }

function sink_new(w: Writer, name: string, obs: i32, c: Counts, sparse: boolean, intr: i32): Sink {
  return Sink { w: w, buf: BufBlock { h: buf_new(obs * 2) }, held: 0, obs: obs, name: name, c: c, ok: true, sparse: sparse, seeked: false, intr: intr, stopped: false };
}

function all_nul(data: u8[]): boolean {
  return __count_byte_bytes(data, 0) == data.len();
}

function count_out(k: Sink, n: i32, partial: boolean): Sink {
  let c: Counts = k.c;
  if (partial) {
    c = Counts { ...c, part_out: c.part_out + 1 as i64, bytes: c.bytes + n as i64 };
  } else {
    c = Counts { ...c, full_out: c.full_out + 1 as i64, bytes: c.bytes + n as i64 };
  }
  return Sink { ...k, c: c };
}

function write_full(k0: Sink, data: u8[], partial: boolean): Sink {
  let k: Sink = Sink { ...k0, seeked: false };
  if (k.sparse && all_nul(data)) {
    match (k.w.seek(data.len() as i64, 1)) {
      Ok(_) => {
        return count_out(Sink { ...k, seeked: true }, data.len(), partial);
      },
      Err(_) => {
        k = Sink { ...k, sparse: false };
      }
    }
  }
  let off: i32 = 0;
  while (off < data.len()) {
    if (interrupt_taken(k.intr)) {
      return Sink { ...k, ok: false, stopped: true };
    }
    let piece: u8[] = data;
    if (off > 0) {
      let h: usize = buf_new(data.len() - off);
      buf_push_bytes_range(h, data, off, data.len());
      piece = buf_take_bytes(h);
      buf_free(h);
    }
    match (k.w.write_some_bytes(piece)) {
      Err(e) => {
        if (errno.of(e) != errno.EINTR) {
          gnu.error("error writing " + gnu.quote(k.name) + ": " + gnu.io_error_text(e));
          return Sink { ...k, ok: false };
        }
      },
      Ok(n) => {
        if (n == 0 as i64) {
          off = data.len();
        } else {
          off = off + n as i32;
        }
      }
    }
  }
  return count_out(k, data.len(), partial);
}

function settle_holes(k: Sink): boolean {
  if (!k.seeked) {
    return true;
  }
  match (k.w.stat()) {
    Err(e) => {
      gnu.error("cannot fstat " + gnu.quote(k.name) + ": " + gnu.io_error_text(e));
      return false;
    },
    Ok(st) => {
      if (!st.is_file) {
        return true;
      }
      match (k.w.seek(0 as i64, 1)) {
        Err(_) => {
          return true;
        },
        Ok(at) => {
          if (st.size < at) {
            if let Err(e) = k.w.truncate(at) {
              gnu.error("failed to truncate to " + at.to_string() + " bytes in output file " + gnu.quote(k.name) + ": " + gnu.io_error_text(e));
              return false;
            }
          }
        }
      }
    }
  }
  return true;
}

function sink_direct(k: Sink, data: u8[]): Sink {
  if (data.len() == 0) {
    return k;
  }
  return write_full(k, data, data.len() < k.obs);
}

function sink_push(k: Sink, data: u8[]): Sink {
  if (k.held == 0 && data.len() == k.obs) {
    return write_full(k, data, false);
  }
  let out: Sink = k;
  let off: i32 = 0;
  while (off < data.len()) {
    let room: i32 = out.obs - out.held;
    let take: i32 = data.len() - off;
    if (take > room) {
      take = room;
    }
    buf_push_bytes_range(out.buf.h, data, off, off + take);
    out = Sink { ...out, held: out.held + take };
    off = off + take;
    if (out.held == out.obs) {
      let block: u8[] = buf_take_bytes(out.buf.h);
      out = write_full(out, block, false);
      out = Sink { ...out, held: 0 };
      if (!out.ok) {
        return out;
      }
    }
  }
  return out;
}

function sink_flush(k: Sink): Sink {
  if (k.held == 0) {
    return k;
  }
  let block: u8[] = buf_take_bytes(k.buf.h);
  let out: Sink = write_full(k, block, true);
  return Sink { ...out, held: 0 };
}

struct Take { data: u8[], ok: boolean, eof: boolean, stopped: boolean }

function read_some(r: Reader, want: i32, intr: i32): (Result[u8[], IoError], boolean) {
  while (true) {
    if (interrupt_taken(intr)) {
      return (Ok([]), true);
    }
    let got: Result[u8[], IoError] = r.read_chunk_bytes(want);
    match (got) {
      Err(e) => {
        if (errno.of(e) != errno.EINTR) {
          return (got, false);
        }
      },
      Ok(_) => {
        return (got, false);
      }
    }
  }
  return (Ok([]), true);
}

function read_record(r: Reader, s: Settings, want: i32, name: string, intr: i32): Take {
  let (got, stopped) = read_some(r, want, intr);
  if (stopped) {
    return Take { data: [], ok: true, eof: false, stopped: true };
  }
  match (got) {
    Err(e) => {
      gnu.error("error reading " + gnu.quote(name) + ": " + gnu.io_error_text(e));
      return Take { data: [], ok: false, eof: true, stopped: false };
    },
    Ok(first) => {
      if (first.len() == 0) {
        return Take { data: [], ok: true, eof: true, stopped: false };
      }
      if ((s.iflag & flag_fullblock()) == 0 || first.len() == want) {
        return Take { data: first, ok: true, eof: false, stopped: false };
      }
      return fill_block(r, s, want, name, first, intr);
    }
  }
}

function fill_block(r: Reader, s: Settings, want: i32, name: string, first: u8[], intr: i32): Take {
  let h: usize = buf_new(want);
  buf_push_bytes_range(h, first, 0, first.len());
  let have: i32 = first.len();
  while (have < want) {
    let (got, stopped) = read_some(r, want - have, intr);
    if (stopped) {
      buf_free(h);
      return Take { data: [], ok: true, eof: false, stopped: true };
    }
    match (got) {
      Err(e) => {
        buf_free(h);
        gnu.error("error reading " + gnu.quote(name) + ": " + gnu.io_error_text(e));
        return Take { data: [], ok: false, eof: true, stopped: false };
      },
      Ok(more) => {
        if (more.len() == 0) {
          have = want;
        } else {
          buf_push_bytes_range(h, more, 0, more.len());
          have = have + more.len();
        }
      }
    }
  }
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  return Take { data: bytes, ok: true, eof: false, stopped: false };
}

struct Run { c: Counts, status: i32, progressed: boolean, stopped: boolean }

function sink_gave_up(k: Sink, truncated: i64, progressed: boolean): Run {
  if (k.stopped) {
    return Run { c: Counts { ...k.c, truncated: truncated }, status: 1, progressed: progressed, stopped: true };
  }
  return Run { c: k.c, status: 1, progressed: progressed, stopped: false };
}

function whole_seconds(ns: i64): i64 {
  return (ns + 500000000 as i64) / (1000000000 as i64);
}

function progress_line(bytes: i64, sec: i64): void {
  let w: Writer = stderr();
  w.write("\r" + transfer_line(bytes, sec as f64));
}

struct Cache { on: boolean, start: i64, pending: i64 }

function cache_batch(): i64 {
  return 131072 as i64;
}

function cache_at(on: boolean, offset: Result[i64, IoError]): Cache {
  match (offset) {
    Ok(o) => {
      return Cache { on: on, start: o, pending: 0 as i64 };
    },
    Err(_) => {
      return Cache { on: false, start: 0 as i64, pending: 0 as i64 };
    }
  }
}

function cache_advance(c: Cache, n: i64): (Cache, boolean) {
  let next: Cache = Cache { ...c, pending: c.pending + n };
  return (next, c.on && next.pending >= cache_batch());
}

function cache_spent(c: Cache): Cache {
  return Cache { ...c, start: c.start + c.pending, pending: 0 as i64 };
}

function info_signal(): i32 {
  let info: i32 = signals.number("INFO");
  if (info > 0) {
    return info;
  }
  match (env("POSIXLY_CORRECT")) {
    Some(_) => {
      return 0;
    },
    None => {
      return signals.number("USR1");
    }
  }
}

function info_poll(info: i32, c: Counts, truncated: i64, s: Settings, started: i64, progressed: boolean): boolean {
  if (info <= 0 || !signal.taken(info)) {
    return progressed;
  }
  if (progressed) {
    eprint("");
  }
  report(Counts { ...c, truncated: truncated }, s, (monotonic_ns() - started) as f64 / 1000000000.0);
  return false;
}

function interrupt_signal(): i32 {
  if (signal.disposition(signal.SIGINT) == signal.IGN) {
    return 0;
  }
  return signal.SIGINT;
}

function interrupt_taken(intr: i32): boolean {
  return intr > 0 && signal.taken(intr);
}

struct Stop { intr: i32, s: Settings, started: i64 }

function stop_now(st: Stop, c: Counts, progressed: boolean): void {
  if (progressed) {
    eprint("");
  }
  report(c, st.s, (monotonic_ns() - st.started) as f64 / 1000000000.0);
  signals.die_of(st.intr);
}

function copy(r: Reader, k0: Sink, s: Settings, bs_given: boolean, in_name: string, started: i64, info: i32): Run {
  let k: Sink = k0;
  let st: Rec = rec_new(s.cbs as i32, s.conv);
  let sw: Swab = swab_new();
  let records: i64 = 0 as i64;
  let bytes_left: i64 = s.count;
  let count_bytes: boolean = (s.iflag & flag_count_bytes()) != 0;
  let status: i32 = 0;
  let last_tick: i64 = started;
  let progressed: boolean = false;
  let tab: u8[] = translation_table(s.conv);
  let ic: Cache = cache_at((s.iflag & flag_nocache()) != 0, r.seek(0 as i64, 1));
  let oc: Cache = cache_at((s.oflag & flag_nocache()) != 0, k0.w.seek(0 as i64, 1));
  while (true) {
    if (s.have_count) {
      if (count_bytes) {
        if (bytes_left <= 0 as i64) {
          break;
        }
      } else if (records >= s.count) {
        break;
      }
    }
    progressed = info_poll(info, k.c, st.trunc, s, started, progressed);
    let want: i32 = s.ibs as i32;
    if (s.have_count && count_bytes && bytes_left < s.ibs) {
      want = bytes_left as i32;
    }
    let got: Take = read_record(r, s, want, in_name, k.intr);
    if (got.stopped) {
      return Run { c: Counts { ...k.c, truncated: st.trunc }, status: 1, progressed: progressed, stopped: true };
    }
    progressed = info_poll(info, k.c, st.trunc, s, started, progressed);
    if (!got.ok) {
      if ((s.conv & conv_noerror()) == 0) {
        return Run { c: k.c, status: 1, progressed: progressed, stopped: false };
      }
      status = 1;
      break;
    }
    if (got.eof) {
      break;
    }
    let c: Counts = k.c;
    if (got.data.len() as i64 == s.ibs) {
      c = Counts { ...c, full_in: c.full_in + 1 as i64 };
    } else {
      c = Counts { ...c, part_in: c.part_in + 1 as i64 };
    }
    k = Sink { ...k, c: c };
    records = records + 1 as i64;
    bytes_left = bytes_left - got.data.len() as i64;
    let (ic2, idue) = cache_advance(ic, got.data.len() as i64);
    ic = ic2;
    if (idue) {
      r.drop_cache(ic.start, ic.pending);
      ic = cache_spent(ic);
    }
    let conv1: (Swab, u8[]) = convert_record(sw, tab, got.data, s, false);
    sw = conv1.0;
    let piece: u8[] = conv1.1;
    if (records_wanted(s)) {
      let conv: (Rec, u8[]) = apply_records(st, piece, s, false);
      st = conv.0;
      piece = conv.1;
      k = sink_push(k, piece);
    } else if (bs_given && !rewrites_bytes(s)) {
      k = sink_direct(k, piece);
    } else {
      k = sink_push(k, piece);
    }
    if (!k.ok) {
      return sink_gave_up(k, st.trunc, progressed);
    }
    let (oc2, odue) = cache_advance(oc, piece.len() as i64);
    oc = oc2;
    if (odue) {
      k.w.drop_cache(oc.start, 0 as i64);
      oc = cache_spent(oc);
    }
    if (s.status == status_progress()) {
      let now: i64 = monotonic_ns();
      if (now - last_tick >= 1000000000 as i64) {
        last_tick = now;
        progress_line(k.c.bytes, whole_seconds(now - started));
        progressed = true;
      }
    }
  }
  let rest: u8[] = [];
  if (sw.held) {
    let tailsw: (Swab, u8[]) = apply_swab(sw, [], true);
    sw = tailsw.0;
    rest = tailsw.1;
  }
  if (records_wanted(s)) {
    let tail: (Rec, u8[]) = apply_records(st, rest, s, true);
    st = tail.0;
    rest = tail.1;
  }
  k = sink_push(k, rest);
  if (!k.ok) {
    return sink_gave_up(k, st.trunc, progressed);
  }
  k = sink_flush(k);
  if (!k.ok) {
    return sink_gave_up(k, st.trunc, progressed);
  }
  if (!settle_holes(k)) {
    return Run { c: k.c, status: 1, progressed: progressed, stopped: false };
  }
  if (ic.on) {
    r.drop_cache(ic.start, 0 as i64);
  }
  if (oc.on) {
    k.w.drop_cache(oc.start, 0 as i64);
  }
  let c: Counts = Counts { ...k.c, truncated: st.trunc };
  return Run { c: c, status: status, progressed: progressed, stopped: false };
}

function convert_record(sw: Swab, tab: u8[], data: u8[], s: Settings, last: boolean): (Swab, u8[]) {
  let out: u8[] = data;
  let state: Swab = sw;
  if ((s.conv & conv_sync()) != 0) {
    out = apply_sync(out, s);
  }
  out = apply_translation(out, tab, s.conv);
  if ((s.conv & conv_swab()) != 0) {
    let swapped: (Swab, u8[]) = apply_swab(state, out, last);
    state = swapped.0;
    out = swapped.1;
  }
  return (state, out);
}

struct Rec { pend: BufBlock, len: i32, drop: boolean, cbs: i32, trunc: i64, nl: u8, sp: u8, pad: u8[] }

function rec_new(cbs: i32, conv: i32): Rec {
  let nl: u8 = b'\n';
  let sp: u8 = b' ';
  let cs: u8[] = output_charset(conv);
  if (cs.len() == 256) {
    nl = cs[10];
    sp = cs[32];
  }
  let pad: u8[] = [];
  if ((conv & conv_block()) != 0) {
    pad = __alloc_u8(cbs);
  }
  let i: i32 = 0;
  while (i < pad.len()) {
    pad = pad.with(i, sp);
    i = i + 1;
  }
  return Rec { pend: BufBlock { h: buf_new(cbs + 1) }, len: 0, drop: false, cbs: cbs, trunc: 0 as i64, nl: nl, sp: sp, pad: pad };
}

function rec_emit_block(st: Rec, out: usize): Rec {
  let line: u8[] = buf_take_bytes(st.pend.h);
  buf_push_bytes_range(out, line, 0, line.len());
  buf_push_bytes_range(out, st.pad, 0, st.cbs - line.len());
  return Rec { ...st, len: 0, drop: false };
}

function conv_block_apply(rc: Rec, data: u8[], last: boolean): (Rec, u8[]) {
  let out: usize = buf_new(data.len() + rc.cbs + 1);
  let st: Rec = rc;
  let n: i32 = data.len();
  let i: i32 = 0;
  while (i < n) {
    let nl: i32 = __memchr_bytes(data, st.nl as i32, i);
    let end: i32 = n;
    if (nl >= 0) {
      end = nl;
    }
    if (st.len == 0 && !st.drop && nl >= 0 && end - i <= st.cbs) {
      buf_push_bytes_range(out, data, i, end);
      buf_push_bytes_range(out, st.pad, 0, st.cbs - (end - i));
    } else {
      if (!st.drop) {
        let take: i32 = end - i;
        if (take > st.cbs - st.len) {
          take = st.cbs - st.len;
          st = Rec { ...st, drop: true, trunc: st.trunc + 1 as i64 };
        }
        buf_push_bytes_range(st.pend.h, data, i, i + take);
        st = Rec { ...st, len: st.len + take };
      }
      if (nl >= 0) {
        st = rec_emit_block(st, out);
      }
    }
    i = end + 1;
  }
  if (last && (st.len > 0 || st.drop)) {
    st = rec_emit_block(st, out);
  }
  let bytes: u8[] = buf_take_bytes(out);
  buf_free(out);
  return (st, bytes);
}

function rec_emit_unblock(st: Rec, out: usize): Rec {
  let record: u8[] = buf_take_bytes(st.pend.h);
  let end: i32 = record.len();
  while (end > 0 && record[end - 1] == st.sp) {
    end = end - 1;
  }
  buf_push_bytes_range(out, record, 0, end);
  buf_push_byte(out, st.nl as i32);
  return Rec { ...st, len: 0 };
}

function conv_unblock_apply(rc: Rec, data: u8[], last: boolean): (Rec, u8[]) {
  let out: usize = buf_new(data.len() + data.len() / rc.cbs + rc.cbs + 1);
  let st: Rec = rc;
  let n: i32 = data.len();
  let i: i32 = 0;
  while (i < n) {
    let take: i32 = st.cbs - st.len;
    if (take > n - i) {
      take = n - i;
    }
    if (st.len == 0 && take == st.cbs) {
      let end: i32 = i + take;
      while (end > i && data[end - 1] == st.sp) {
        end = end - 1;
      }
      buf_push_bytes_range(out, data, i, end);
      buf_push_byte(out, st.nl as i32);
    } else {
      buf_push_bytes_range(st.pend.h, data, i, i + take);
      st = Rec { ...st, len: st.len + take };
      if (st.len == st.cbs) {
        st = rec_emit_unblock(st, out);
      }
    }
    i = i + take;
  }
  if (last && st.len > 0) {
    st = rec_emit_unblock(st, out);
  }
  let bytes: u8[] = buf_take_bytes(out);
  buf_free(out);
  return (st, bytes);
}

function rewrites_bytes(s: Settings): boolean {
  let mask: i32 = conv_swab() | conv_sync() | conv_block() | conv_unblock();
  return (s.conv & mask) != 0;
}

function records_wanted(s: Settings): boolean {
  return (s.conv & (conv_block() | conv_unblock())) != 0;
}

function apply_records(st: Rec, data: u8[], s: Settings, last: boolean): (Rec, u8[]) {
  if ((s.conv & conv_block()) != 0) {
    return conv_block_apply(st, data, last);
  }
  return conv_unblock_apply(st, data, last);
}

function report(c: Counts, s: Settings, secs: f64): void {
  if (s.status == status_none()) {
    return;
  }
  eprint(c.full_in.to_string() + "+" + c.part_in.to_string() + " records in");
  eprint(c.full_out.to_string() + "+" + c.part_out.to_string() + " records out");
  if (c.truncated > 0 as i64) {
    let word: string = " truncated records";
    if (c.truncated == 1 as i64) {
      word = " truncated record";
    }
    eprint(c.truncated.to_string() + word);
  }
  if (s.status == status_noxfer()) {
    return;
  }
  eprint(transfer_line(c.bytes, secs));
}

function transfer_line(bytes: i64, secs: f64): string {
  let out: string = bytes.to_string() + " bytes";
  if (bytes >= 1000 as i64) {
    out = out + " (" + human(bytes, 1000 as i64, "B") + ", " + human(bytes, 1024 as i64, "iB") + ")";
  }
  out = out + " copied, " + fmt_g(secs) + " s, ";
  let rate: f64 = 0.0;
  if (secs > 0.0) {
    rate = bytes as f64 / secs;
  }
  return out + human_rate(rate) + "/s";
}

function human(n: i64, base: i64, tail: string): string {
  let units: string[] = ["k", "M", "G", "T", "P", "E"];
  if (base == 1024 as i64) {
    units = ["K", "M", "G", "T", "P", "E"];
  }
  let v: f64 = n as f64;
  let b: f64 = base as f64;
  let i: i32 = 0;
  while (v >= b && i < units.len()) {
    v = v / b;
    i = i + 1;
  }
  if (i == 0) {
    return n.to_string() + " B";
  }
  return one_decimal(v) + " " + units[i - 1] + tail;
}

function human_rate(rate: f64): string {
  let units: string[] = ["kB", "MB", "GB", "TB", "PB", "EB"];
  let v: f64 = rate / 1000.0;
  let i: i32 = 0;
  while (v >= 1000.0 && i + 1 < units.len()) {
    v = v / 1000.0;
    i = i + 1;
  }
  return one_decimal(v) + " " + units[i];
}

function one_decimal(v: f64): string {
  if (v >= 100.0) {
    return (v.round() as i64).to_string();
  }
  if (v >= 10.0) {
    return (v.round() as i64).to_string();
  }
  let scaled: i64 = (v * 10.0).round() as i64;
  return (scaled / (10 as i64)).to_string() + "." + (scaled % (10 as i64)).to_string();
}

function fmt_g(v: f64): string {
  if (v == 0.0) {
    return "0";
  }
  let exp: i32 = decimal_exponent(v);
  if (exp < 0 - 4 || exp >= 6) {
    let mant: f64 = v / pow10(exp);
    return trim_zeros(mant.to_string_prec(5)) + "e" + exp_text(exp);
  }
  let prec: i32 = 5 - exp;
  if (prec < 0) {
    prec = 0;
  }
  return trim_zeros(v.to_string_prec(prec));
}

function decimal_exponent(v: f64): i32 {
  let e: i32 = 0;
  let x: f64 = v;
  if (x < 0.0) {
    x = 0.0 - x;
  }
  while (x >= 10.0) {
    x = x / 10.0;
    e = e + 1;
  }
  while (x < 1.0) {
    x = x * 10.0;
    e = e - 1;
  }
  return e;
}

function pow10(e: i32): f64 {
  let out: f64 = 1.0;
  let i: i32 = 0;
  while (i < e) {
    out = out * 10.0;
    i = i + 1;
  }
  let j: i32 = 0;
  while (j > e) {
    out = out / 10.0;
    j = j - 1;
  }
  return out;
}

function exp_text(e: i32): string {
  let sign: string = "+";
  let mag: i32 = e;
  if (e < 0) {
    sign = "-";
    mag = 0 - e;
  }
  let digits: string = mag.to_string();
  if (mag < 10) {
    digits = "0" + digits;
  }
  return sign + digits;
}

function trim_zeros(s: string): string {
  if (!s.contains(".")) {
    return s;
  }
  let end: i32 = s.len();
  while (end > 0 && s[end - 1] == b'0') {
    end = end - 1;
  }
  if (end > 0 && s[end - 1] == b'.') {
    end = end - 1;
  }
  return slice_unchecked(s, 0, end) + "";
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPERAND]...\n";
  out = out + "  or:  " + gnu.prog() + " OPTION\n";
  out = out + "Copy a file, converting and formatting according to the operands.\n";
  out = out + "\n";
  out = out + "  bs=BYTES        read and write up to BYTES bytes at a time (default: 512);\n";
  out = out + "                  overrides ibs and obs\n";
  out = out + "  cbs=BYTES       convert BYTES bytes at a time\n";
  out = out + "  conv=CONVS      convert the file as per the comma separated symbol list\n";
  out = out + "  count=N         copy only N input blocks\n";
  out = out + "  ibs=BYTES       read up to BYTES bytes at a time (default: 512)\n";
  out = out + "  if=FILE         read from FILE instead of stdin\n";
  out = out + "  iflag=FLAGS     read as per the comma separated symbol list\n";
  out = out + "  obs=BYTES       write BYTES bytes at a time (default: 512)\n";
  out = out + "  of=FILE         write to FILE instead of stdout\n";
  out = out + "  oflag=FLAGS     write as per the comma separated symbol list\n";
  out = out + "  seek=N          (or oseek=N) skip N obs-sized output blocks\n";
  out = out + "  skip=N          (or iseek=N) skip N ibs-sized input blocks\n";
  out = out + "  status=LEVEL    the LEVEL of information to print to stderr;\n";
  out = out + "                  'none' suppresses everything but error messages,\n";
  out = out + "                  'noxfer' suppresses the final transfer statistics,\n";
  out = out + "                  'progress' shows periodic transfer statistics\n";
  out = out + "\n";
  out = out + "N and BYTES may be followed by the following multiplicative suffixes:\n";
  out = out + "c=1, w=2, b=512, kB=1000, K=1024, MB=1000*1000, M=1024*1024, xM=M,\n";
  out = out + "GB=1000*1000*1000, G=1024*1024*1024, and so on for T, P, E, Z, Y, R, Q.\n";
  out = out + "Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n";
  out = out + "If N ends in 'B', it counts bytes not blocks.\n";
  out = out + "\n";
  out = out + "Each CONV symbol may be:\n";
  out = out + "\n";
  out = out + "  ascii     from EBCDIC to ASCII\n";
  out = out + "  ebcdic    from ASCII to EBCDIC\n";
  out = out + "  ibm       from ASCII to alternate EBCDIC\n";
  out = out + "  block     pad newline-terminated records with spaces to cbs-size\n";
  out = out + "  unblock   replace trailing spaces in cbs-size records with newline\n";
  out = out + "  lcase     change upper case to lower case\n";
  out = out + "  ucase     change lower case to upper case\n";
  out = out + "  sparse    try to seek rather than write all-NUL output blocks\n";
  out = out + "  swab      swap every pair of input bytes\n";
  out = out + "  sync      pad every input block with NULs to ibs-size; when used\n";
  out = out + "            with block or unblock, pad with spaces rather than NULs\n";
  out = out + "  excl      fail if the output file already exists\n";
  out = out + "  nocreat   do not create the output file\n";
  out = out + "  notrunc   do not truncate the output file\n";
  out = out + "  noerror   continue after read errors\n";
  out = out + "  fdatasync  physically write output file data before finishing\n";
  out = out + "  fsync     likewise, but also write metadata\n";
  out = out + "\n";
  out = out + "Each FLAG symbol may be:\n";
  out = out + "\n";
  out = out + "  append    append mode (makes sense only for output; conv=notrunc suggested)\n";
  out = out + "  direct    use direct I/O for data\n";
  out = out + "  directory  fail unless a directory\n";
  out = out + "  dsync     use synchronized I/O for data\n";
  out = out + "  sync      likewise, but also for metadata\n";
  out = out + "  fullblock  accumulate full blocks of input (iflag only)\n";
  out = out + "  nonblock  use non-blocking I/O\n";
  out = out + "  noatime   do not update access time\n";
  out = out + "  nocache   Request to drop cache.  See also oflag=sync\n";
  out = out + "  noctty    do not assign controlling terminal from file\n";
  out = out + "  nofollow  do not follow symlinks\n";
  out = out + "  count_bytes  treat 'count=N' as a byte count (iflag only)\n";
  out = out + "  skip_bytes  treat 'skip=N' as a byte count (iflag only)\n";
  out = out + "  seek_bytes  treat 'seek=N' as a byte count (oflag only)\n";
  out = out + "\n";
  out = out + "Options are:\n";
  out = out + "\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function usage(status: i32): void {
  if (status == 0) {
    gnu.write_out(help_text());
    exit(0);
  }
  gnu.error(help_text());
  exit(status);
}

function scan_options(argv: string[]): void {
  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "--help") {
      usage(0);
    }
    if (a == "--version") {
      gnu.write_out(gnu.prog() + " (Fern coreutils) " + gnu.version() + "\n");
      exit(0);
    }
    if (a.len() > 2 && a[0] == b'-' && a[1] == b'-') {
      gnu.error("unrecognized option " + gnu.quote(a));
      gnu.try_help(1);
    }
    i = i + 1;
  }
}

function open_input(s: Settings): (Reader, boolean) {
  if (!s.have_in) {
    return (stdin(), true);
  }
  match (open_reader_with(s.in_name, open_flags(s.iflag))) {
    Err(e) => {
      gnu.error("failed to open " + gnu.quote(s.in_name) + ": " + gnu.io_error_text(e));
      return (stdin(), false);
    },
    Ok(r) => {
      return (r, true);
    }
  }
}

function open_output(s: Settings): (Writer, boolean) {
  if (!s.have_out) {
    return (stdout(), true);
  }
  if ((s.oflag & flag_append()) != 0 && (s.conv & conv_excl()) == 0) {
    return open_out_appending(s);
  }
  let flags: i32 = 1;
  if ((s.conv & conv_excl()) != 0) {
    flags = flags | 4;
  }
  if ((s.conv & conv_nocreat()) != 0) {
    flags = 0;
  }
  match (open_writer_with(s.out_name, flags | open_flags(s.oflag))) {
    Err(e) => {
      gnu.error("failed to open " + gnu.quote(s.out_name) + ": " + gnu.io_error_text(e));
      return (stdout(), false);
    },
    Ok(w) => {
      return (w, true);
    }
  }
}

function open_out_appending(s: Settings): (Writer, boolean) {
  match (open_appender(s.out_name)) {
    Err(e) => {
      gnu.error("failed to open " + gnu.quote(s.out_name) + ": " + gnu.io_error_text(e));
      return (stdout(), false);
    },
    Ok(w) => {
      return (w, true);
    }
  }
}

function skip_input(r: Reader, s: Settings, stop: Stop): boolean {
  let want: i64 = s.skip;
  if (want <= 0 as i64) {
    return true;
  }
  if ((s.iflag & flag_skip_bytes()) == 0) {
    want = want * s.ibs;
  }
  match (r.seek(want, 0)) {
    Ok(_) => {
      return past_end(r, s, want);
    },
    Err(_) => {}
  }
  return drain(r, s, want, stop);
}

function past_end(r: Reader, s: Settings, want: i64): boolean {
  match (r.stat()) {
    Ok(st) => {
      if (st.is_file && want > st.size) {
        cannot_skip(s);
      }
    },
    Err(_) => {}
  }
  return true;
}

function cannot_skip(s: Settings): void {
  if (!s.have_in) {
    gnu.error(gnu.quote("standard input") + ": cannot skip to specified offset");
    return;
  }
  gnu.error(gnu.quotef(s.in_name) + ": cannot skip to specified offset");
}

function drain(r: Reader, s: Settings, want: i64, stop: Stop): boolean {
  let left: i64 = want;
  while (left > 0 as i64) {
    let take: i32 = s.ibs as i32;
    if (left < s.ibs) {
      take = left as i32;
    }
    let (got, stopped) = read_some(r, take, stop.intr);
    if (stopped) {
      stop_now(stop, counts_new(), false);
    }
    match (got) {
      Err(_) => {
        cannot_skip(s);
        return true;
      },
      Ok(piece) => {
        if (piece.len() == 0) {
          cannot_skip(s);
          return true;
        }
        left = left - piece.len() as i64;
      }
    }
  }
  return true;
}

function seek_output(w: Writer, s: Settings, name: string): boolean {
  let want: i64 = s.seek;
  if ((s.oflag & flag_seek_bytes()) == 0) {
    want = want * s.obs;
  }
  if (want > 0 as i64) {
    match (w.seek(want, 0)) {
      Err(e) => {
        gnu.error("failed to seek in " + gnu.quote(name) + ": " + gnu.io_error_text(e));
        return false;
      },
      Ok(_) => {}
    }
  }
  if ((s.conv & conv_notrunc()) != 0) {
    return true;
  }
  if (!s.have_out) {
    return true;
  }
  w.truncate(want);
  return true;
}

function refuse_combined(conv: i32, group: i32, what: string): void {
  let both: i32 = conv & group;
  if ((both & both - 1) != 0) {
    gnu.error("cannot combine " + what);
    exit(1);
  }
}

function discard_all(res: Result[void, IoError], name: string, unnamed: string): boolean {
  match (res) {
    Err(e) => {
      let shown: string = name;
      if (shown.len() == 0) {
        shown = unnamed;
      }
      gnu.error("failed to discard cache for: " + gnu.quotef(shown) + ": " + gnu.io_error_text(e));
      return false;
    },
    Ok(_) => {
      return true;
    }
  }
}

pub function main(): i32 {
  let argv: string[] = args();
  scan_options(argv);
  let scan: Scan = scan_operands(argv);
  let s: Settings = scan.s;
  if (s.cbs == 0 as i64) {
    let records: i32 = conv_block() | conv_unblock();
    s = Settings { ...s, conv: s.conv - (s.conv & records) };
  }
  refuse_combined(s.conv, conv_ascii() | conv_ebcdic() | conv_ibm(), "any two of {ascii,ebcdic,ibm}");
  refuse_combined(s.conv, conv_block() | conv_unblock(), "block and unblock");
  refuse_combined(s.conv, conv_lcase() | conv_ucase(), "lcase and ucase");
  refuse_combined(s.conv, conv_excl() | conv_nocreat(), "excl and nocreat");
  let ri: (Reader, boolean) = open_input(s);
  if (!ri.1) {
    exit(1);
  }
  let wo: (Writer, boolean) = open_output(s);
  if (!wo.1) {
    exit(1);
  }
  let r: Reader = ri.0;
  let w: Writer = wo.0;
  let info: i32 = info_signal();
  if (info > 0) {
    signal.catch(info);
  }
  let intr: i32 = interrupt_signal();
  if (intr > 0) {
    signal.catch_interrupting(intr);
  }
  let started: i64 = monotonic_ns();
  let stop: Stop = Stop { intr: intr, s: s, started: started };
  if (!skip_input(r, s, stop)) {
    exit(1);
  }
  if (!seek_output(w, s, s.out_name)) {
    exit(1);
  }
  let k: Sink = sink_new(w, s.out_name, s.obs as i32, counts_new(), (s.conv & conv_sparse()) != 0, intr);
  let run: Run = copy(r, k, s, scan.bs_given, s.in_name, started, info);
  if (run.stopped) {
    stop_now(stop, run.c, run.progressed);
  }
  let status: i32 = run.status;
  if (s.have_count && s.count == 0 as i64) {
    if ((s.iflag & flag_nocache()) != 0 && !discard_all(r.drop_cache(0 as i64, 0 as i64), s.in_name, "standard input")) {
      status = 1;
    }
    if ((s.oflag & flag_nocache()) != 0 && !discard_all(w.drop_cache(0 as i64, 0 as i64), s.out_name, "standard output")) {
      status = 1;
    }
  }
  let want_fsync: boolean = (s.conv & conv_fsync()) != 0;
  if ((s.conv & conv_fdatasync()) != 0) {
    if let Err(e) = w.fdatasync() {
      if (errno.of(e) == errno.EINVAL) {
        want_fsync = true;
      } else {
        gnu.error("fdatasync failed for " + gnu.quote(s.out_name) + ": " + gnu.io_error_text(e));
        status = 1;
      }
    }
  }
  if (want_fsync) {
    if let Err(e) = w.fsync() {
      gnu.error("fsync failed for " + gnu.quote(s.out_name) + ": " + gnu.io_error_text(e));
      status = 1;
    }
  }
  if (interrupt_taken(intr)) {
    stop_now(stop, run.c, run.progressed);
  }
  let progressed: boolean = info_poll(info, run.c, run.c.truncated, s, started, run.progressed);
  let secs: f64 = (monotonic_ns() - started) as f64 / 1000000000.0;
  if (progressed) {
    eprint("");
  }
  report(run.c, s, secs);
  if (s.have_out) {
    w.close();
  }
  if (s.have_in) {
    r.close();
  }
  return status;
}
