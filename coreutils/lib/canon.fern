import "std/string";
import "std/array";
import "std/errno";
import "./gnu";

pub function existing(): i32 {
  return 0;
}

pub function all_but_last(): i32 {
  return 1;
}

pub function missing(): i32 {
  return 2;
}

function unchecked_links(): i32 {
  return 20;
}

struct Seen { key: string, dev: i64, ino: i64 }

pub function canonicalize(name: string, mode: i32, logical: boolean): Result[string, IoError] {
  if (name.len() == 0) {
    return Err(NotFound(""));
  }
  let rname = "/";
  if (name[0] as i32 != 47) {
    match (getcwd()) {
      Ok(wd) => {
        rname = wd;
      },
      Err(e) => {
        return Err(e);
      }
    }
  }
  let path = name;
  let pos = 0;
  let links = 0;
  let seen: Seen[] = [];
  while (pos < path.len()) {
    while (pos < path.len() && path[pos] as i32 == 47) {
      pos += 1;
    }
    let start = pos;
    while (pos < path.len() && path[pos] as i32 != 47) {
      pos += 1;
    }
    if (pos == start) {
      break;
    }
    let end = pos;
    let comp = slice_unchecked(path, start, end) + "";
    if (comp == ".") {
      continue;
    }
    if (comp == "..") {
      rname = parent_of(rname);
      continue;
    }
    let parent = rname;
    rname = child_of(rname, comp);

    let target = "";
    let is_link = false;
    let err = Unsupported;
    if (!logical) {
      match (byte_link_target(rname)) {
        Ok(t) => {
          target = t;
          is_link = true;
        },
        Err(e) => {
          err = e;
        }
      }
    }

    if (is_link) {
      if (links < unchecked_links()) {
        links += 1;
      } else {
        let here = FileStat { is_file: false, is_dir: false, size: 0, mode: 0 as u32, nlink: 0 as u32, uid: 0 as u32, gid: 0 as u32, dev: 0, rdev: 0, ino: 0, blksize: 0, blocks: 0, atime: 0, atime_nsec: 0, mtime: 0, mtime_nsec: 0, ctime: 0, ctime_nsec: 0, btime: 0, btime_nsec: 0 };
        match (stat(parent)) {
          Ok(st) => {
            here = st;
          },
          Err(e) => {
            return Err(e);
          }
        }
        let key = slice_unchecked(path, start, path.len()) + "";
        if (stood_here(seen, key, here.dev, here.ino)) {
          if (mode == missing()) {
            continue;
          }
          return Err(Other(rname, eloop_text(), errno.ELOOP));
        }
        seen = seen.append(Seen { key: key, dev: here.dev, ino: here.ino });
      }
      path = target + (slice_unchecked(path, end, path.len()) + "");
      pos = 0;
      if (target.len() > 0 && target[0] as i32 == 47) {
        rname = "/";
      } else {
        rname = parent;
      }
      continue;
    }

    let rest = slice_unchecked(path, end, path.len()) + "";
    let ok = mode == missing();
    if (!ok) {
      if (suffix_needs_dir(rest)) {
        match (access(rname + dir_suffix(), 0)) {
          Ok(_) => {
            ok = true;
          },
          Err(e) => {
            err = e;
          }
        }
      } else if (!logical) {
        ok = errno.of(err) == errno.EINVAL;
      } else if (rest.len() > 0) {
        ok = true;
      } else {
        match (access(rname, 0)) {
          Ok(_) => {
            ok = true;
          },
          Err(e) => {
            err = e;
          }
        }
      }
      if (!ok && mode == all_but_last() && errno.of(err) == errno.ENOENT && all_slashes(rest)) {
        ok = true;
      }
    }
    if (!ok) {
      return Err(err);
    }
  }
  return Ok(rname);
}

function dir_suffix(): string {
  if (target_os() == "darwin") {
    return "/./";
  }
  return "/";
}

function eloop_text(): string {
  return "Too many levels of symbolic links";
}

pub function relative(p: string, from: string): string {
  let a = components(p);
  let b = components(from);
  let same = 0;
  while (same < a.len() && same < b.len() && a[same] == b[same]) {
    same += 1;
  }
  let out = "";
  let i = same;
  while (i < b.len()) {
    if (out.len() > 0) {
      out += "/";
    }
    out += "..";
    i += 1;
  }
  i = same;
  while (i < a.len()) {
    if (out.len() > 0) {
      out += "/";
    }
    out += a[i];
    i += 1;
  }
  if (out.len() == 0) {
    return ".";
  }
  return out;
}

function components(p: string): string[] {
  let out: string[] = [];
  let i = 1;
  while (i < p.len()) {
    let start = i;
    while (i < p.len() && p[i] as i32 != 47) {
      i += 1;
    }
    out = out.append(slice_unchecked(p, start, i) + "");
    i += 1;
  }
  return out;
}

function parent_of(p: string): string {
  let i = p.len();
  while (i > 0 && p[i - 1] as i32 != 47) {
    i -= 1;
  }
  if (i <= 1) {
    return "/";
  }
  return slice_unchecked(p, 0, i - 1) + "";
}

function child_of(p: string, comp: string): string {
  if (p.len() == 1) {
    return "/" + comp;
  }
  return p + "/" + comp;
}

function suffix_needs_dir(rest: string): boolean {
  let i = 0;
  while (i < rest.len() && rest[i] as i32 == 47) {
    while (i < rest.len() && rest[i] as i32 == 47) {
      i += 1;
    }
    if (i >= rest.len()) {
      return true;
    }
    let c = rest[i] as i32;
    i += 1;
    if (c != 46) {
      return false;
    }
    if (i >= rest.len()) {
      return true;
    }
    if (rest[i] as i32 == 46 && (i + 1 >= rest.len() || rest[i + 1] as i32 == 47)) {
      return true;
    }
  }
  return false;
}

function all_slashes(s: string): boolean {
  let i = 0;
  while (i < s.len()) {
    if (s[i] as i32 != 47) {
      return false;
    }
    i += 1;
  }
  return true;
}

function stood_here(seen: Seen[], key: string, dev: i64, ino: i64): boolean {
  let i = 0;
  while (i < seen.len()) {
    if (seen[i].dev == dev && seen[i].ino == ino && seen[i].key == key) {
      return true;
    }
    i += 1;
  }
  return false;
}

// POSIX path bytes can be invalid UTF-8. Keep this unsafe representation local
// to the byte-oriented coreutils path resolver; public text readers validate.
pub function byte_link_target(path: string): Result[string, IoError] {
  match (read_link_bytes(path)) {
    Ok(bytes) => {
      return Ok(unsafe { string_from_bytes_unchecked(bytes) });
    },
    Err(e) => {
      return Err(e);
    }
  }
}

pub function byte_dir_names(names: Result[u8[][], IoError]): Result[string[], IoError] {
  match (names) {
    Ok(entries) => {
      let out: string[] = [];
      for entry in entries {
        out = out.append(unsafe { string_from_bytes_unchecked(entry) });
      }
      return Ok(out);
    },
    Err(e) => {
      return Err(e);
    }
  }
}
