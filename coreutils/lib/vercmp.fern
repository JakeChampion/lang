// coreutils/lib/vercmp.fern — gnulib's filevercmp, the comparison
// `sort -V` and `ls -v` both order by. It is NOT strcmp with the digit
// runs read as numbers: `aB` and `aa` land BEFORE `a b` under it,
// because the non-alphanumeric bytes carry their own order.
//
// Three layers: the leading-dot special cases, a file suffix matching
// `(\.[A-Za-z~][A-Za-z0-9~]*)*$` cut off the end, and dpkg's version
// comparison over what is left — digits compared as numbers, `~`
// sorting before everything including the end of a string.
//
// The range form is the primary one because `sort` holds every line in
// one buffer and never cuts a string out of it to compare.
import "std/string";
import "./gnu";

function is_alnum_b(c: i32): boolean {
  return c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122;
}

// `compare(a, b)` — the two strings whole, for a caller that has them
// as strings already. It does NOT concatenate them: `ls -v` calls this
// once per comparison of a sort, and the join was an allocation and a
// copy of both names per call.
pub function compare(a: string, b: string): i32 {
  return compare_texts(a, 0, a.len(), b, 0, b.len());
}

// The range form over ONE buffer, which is what `sort` holds.
pub function compare_range(text: string, a0: i32, a1: i32, b0: i32, b1: i32): i32 {
  return compare_texts(text, a0, a1, text, b0, b1);
}

function ver_order(c: i32): i32 {
  if (gnu.is_digit(c)) {
    return 0;
  }
  if (c >= 65 && c <= 90 || c >= 97 && c <= 122) {
    return c;
  }
  if (c == 126) {
    return 0 - 1;
  }
  return c + 256;
}

function verrevcmp(ta: string, a0: i32, a1: i32, tb: string, b0: i32, b1: i32): i32 {
  var a: i32 = a0;
  var b: i32 = b0;
  while (a < a1 || b < b1) {
    var first_diff: i32 = 0;
    while (a < a1 && !gnu.is_digit(ta[a] as i32) || b < b1 && !gnu.is_digit(tb[b] as i32)) {
      var ca: i32 = 0;
      if (a < a1) {
        ca = ver_order(ta[a] as i32);
      }
      var cb: i32 = 0;
      if (b < b1) {
        cb = ver_order(tb[b] as i32);
      }
      if (ca != cb) {
        return ca - cb;
      }
      a = a + 1;
      b = b + 1;
    }
    while (a < a1 && ta[a] as i32 == 48) {
      a = a + 1;
    }
    while (b < b1 && tb[b] as i32 == 48) {
      b = b + 1;
    }
    while (a < a1 && b < b1 && gnu.is_digit(ta[a] as i32) && gnu.is_digit(tb[b] as i32)) {
      if (first_diff == 0) {
        first_diff = ta[a] as i32 - tb[b] as i32;
      }
      a = a + 1;
      b = b + 1;
    }
    if (a < a1 && gnu.is_digit(ta[a] as i32)) {
      return 1;
    }
    if (b < b1 && gnu.is_digit(tb[b] as i32)) {
      return 0 - 1;
    }
    if (first_diff != 0) {
      return first_diff;
    }
  }
  return 0;
}

// Where the file suffix starts, or `end` when there is none: the
// longest tail matching `(\.[A-Za-z~][A-Za-z0-9~]*)*` that is not the
// whole of a non-empty string.
//
// Asking forward, per position, whether everything from here to the end
// is a chain of segments re-walks the tail — and `ls -v` asks it twice
// per COMPARISON, which is a third of that sort's cost. A single
// backward pass over the segments was written and MEASURED, and it lost
// by 20% on a listing of names with one dot each: the forward scan
// stops at the first dot where the backward one walks the whole prefix,
// and the names a sort sees look like that. The cost is the per-byte
// call, not the shape.
function file_prefixlen(text: string, from: i32, end: i32): i32 {
  var i: i32 = from;
  while (i < end) {
    if (text[i] as i32 == 46 && i > from) {
      if (suffix_runs_to_end(text, i, end)) {
        return i;
      }
    }
    i = i + 1;
  }
  return end;
}

// Whether [at, end) is one or more `\.[A-Za-z~][A-Za-z0-9~]*` segments
// and nothing else.
function suffix_runs_to_end(text: string, at: i32, end: i32): boolean {
  var i: i32 = at;
  while (i < end) {
    if (text[i] as i32 != 46) {
      return false;
    }
    i = i + 1;
    if (i >= end) {
      return false;
    }
    var c: i32 = text[i] as i32;
    if (!is_alpha_b(c) && c != 126) {
      return false;
    }
    i = i + 1;
    while (i < end) {
      var d: i32 = text[i] as i32;
      if (!is_alnum_b(d) && d != 126) {
        break;
      }
      i = i + 1;
    }
  }
  return true;
}

function is_alpha_b(c: i32): boolean {
  return c >= 65 && c <= 90 || c >= 97 && c <= 122;
}

function compare_texts(ta: string, a0: i32, a1: i32, tb: string, b0: i32, b1: i32): i32 {
  if (a0 == a1) {
    if (b0 == b1) {
      return 0;
    }
    return 0 - 1;
  }
  if (b0 == b1) {
    return 1;
  }
  if (ta[a0] as i32 == 46) {
    if (tb[b0] as i32 != 46) {
      return 0 - 1;
    }
    var adot: boolean = a1 - a0 == 1;
    var bdot: boolean = b1 - b0 == 1;
    if (adot) {
      if (bdot) {
        return 0;
      }
      return 0 - 1;
    }
    if (bdot) {
      return 1;
    }
    var add: boolean = a1 - a0 == 2 && ta[a0 + 1] as i32 == 46;
    var bdd: boolean = b1 - b0 == 2 && tb[b0 + 1] as i32 == 46;
    if (add) {
      if (bdd) {
        return 0;
      }
      return 0 - 1;
    }
    if (bdd) {
      return 1;
    }
  } else if (tb[b0] as i32 == 46) {
    return 1;
  }
  var ap: i32 = file_prefixlen(ta, a0, a1);
  var bp: i32 = file_prefixlen(tb, b0, b1);
  var one_pass: boolean = ap == a1 && bp == b1;
  var r: i32 = verrevcmp(ta, a0, ap, tb, b0, bp);
  if (r != 0 || one_pass) {
    return r;
  }
  return verrevcmp(ta, a0, a1, tb, b0, b1);
}
