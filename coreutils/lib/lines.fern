// coreutils/lib/lines.fern — the two line-boundary scans `head` and
// `tail` share when they hold bytes back.
//
// Both utilities stream a fixed-size read at a time and keep a HOLD of
// the bytes they cannot release yet: `head -n -N` because the last N
// lines are the ones to elide, `tail -n N` because they are the ones
// to keep. Either way the question at each chunk is the same — where
// does the run of the last N terminated lines begin — and it is asked
// from both ends, which is why there are two scans rather than one.
//
// `read_size` is deliberately NOT here: head reads 64 KiB and tail 8
// KiB, matching the reference binaries, and a chunk size is not a
// line-boundary rule.
import "./gnu";

// tail_start returns the offset in `s` at which the last `n` terminated
// lines begin, found by walking `n + 1` terminators back from the end,
// or -1 when `s` does not hold that many.
//
// The -1 is essential and was a bug for a while (#9064). Answering 0
// for "ran out" is indistinguishable from "they begin at s[0]", and the
// callers act on the second reading: a chunk holding exactly `n`
// terminators takes the fast path and releases a hold that was part of
// the very lines being withheld. A negative answer sends the caller to
// the general path, which counts terminators across the hold as well
// and was always right for that case.
pub function tail_start(s: u8[], n: u64, term: i32): i32 {
  let pos: i32 = s.len();
  let left: u64 = n + 1 as u64;
  while (left > 0 as u64) {
    pos = __rmemchr_bytes(s, term, pos - 1);
    if (pos < 0) {
      return 0 - 1;
    }
    left = left - 1 as u64;
  }
  return pos + 1;
}

// Retain input blocks without repeatedly copying a growing long record.
// Consumed slots are cleared, and the pointer array is compacted once at
// least half its entries are dead, bounding metadata as the stream advances.
pub struct Hold { blocks: u8[][], first: i32, offset: i32, n: u64, last: u8 }

pub function hold_empty(): Hold {
  return Hold { blocks: [], first: 0, offset: 0, n: 0 as u64, last: 0 as u8 };
}

pub function hold_from(bytes: u8[], lo: i32): Hold {
  if (lo >= bytes.len()) {
    return hold_empty();
  }
  return Hold { blocks: [bytes], first: 0, offset: lo, n: (bytes.len() - lo) as u64, last: bytes[bytes.len() - 1] };
}

pub function hold_push(own h: Hold, bytes: u8[]): Hold {
  if (bytes.len() == 0) {
    return h;
  }
  if (h.n == 0 as u64) {
    return hold_from(bytes, 0);
  }
  let first = h.first;
  let offset = h.offset;
  let n = h.n + bytes.len() as u64;
  let blocks = h.blocks;
  blocks = blocks.append(bytes);
  return Hold { blocks: blocks, first: first, offset: offset, n: n, last: bytes[bytes.len() - 1] };
}

pub function hold_drop(own h: Hold, n: u64): Hold {
  if (n == 0 as u64) {
    return h;
  }
  if (n >= h.n) {
    return hold_empty();
  }
  let first = h.first;
  let offset = h.offset;
  let remaining = h.n - n;
  let last = h.last;
  let blocks = h.blocks;
  let left = n;
  while (left > 0 as u64) {
    let available = blocks[first].len() - offset;
    if (left < available as u64) {
      offset = offset + left as i32;
      break;
    }
    left = left - available as u64;
    blocks = blocks.with(first, []);
    first = first + 1;
    offset = 0;
  }
  if (first > 0 && first >= blocks.len() / 2) {
    let kept: u8[][] = [];
    let i = first;
    while (i < blocks.len()) {
      kept = kept.append(blocks[i]);
      i = i + 1;
    }
    blocks = kept;
    first = 0;
  }
  return Hold { blocks: blocks, first: first, offset: offset, n: remaining, last: last };
}

pub function hold_cut(h: Hold, n: u64, term: i32): u64 {
  let i = h.first;
  let start = h.offset;
  let walked = 0 as u64;
  let left = n;
  while (i < h.blocks.len()) {
    let chunk = h.blocks[i];
    let pos = start;
    while (left > 0 as u64) {
      let found = __memchr_bytes(chunk, term, pos);
      if (found < 0) {
        break;
      }
      pos = found + 1;
      left = left - 1 as u64;
    }
    if (left == 0 as u64) {
      return walked + (pos - start) as u64;
    }
    walked = walked + (chunk.len() - start) as u64;
    start = 0;
    i = i + 1;
  }
  return h.n;
}

pub function hold_write(h: Hold, o: gnu.Stream, n: u64): gnu.Stream {
  let out = o;
  let i = h.first;
  let start = h.offset;
  let left = n;
  while (left > 0 as u64 && i < h.blocks.len()) {
    let chunk = h.blocks[i];
    let size = chunk.len() - start;
    if (size as u64 > left) {
      size = left as i32;
    }
    out = gnu.stream_put_bytes_range(out, chunk, start, start + size);
    left = left - size as u64;
    start = 0;
    i = i + 1;
  }
  return out;
}
