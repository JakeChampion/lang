import "std/string";
import "std/array";

pub function s_isuid(): i32 {
  return 2048;
}

pub function s_isgid(): i32 {
  return 1024;
}

pub function s_isvtx(): i32 {
  return 512;
}

pub function s_irwxugo(): i32 {
  return 511;
}

pub function s_ixugo(): i32 {
  return 73;
}

pub function setid_bits(): i32 {
  return s_isuid() + s_isgid();
}

pub function all_bits(): i32 {
  return 4095;
}

pub function w_group_other(): i32 {
  return 18;
}

pub function complement(m: i32): i32 {
  return m ^ all_bits();
}

pub struct Change { who: i32, explicit: boolean, op: i32, kind: i32, bits: i32, x_if: boolean }

pub struct Changes { list: Change[] }

pub struct Adjusted { mode: i32, mentioned: i32, touches_setid: boolean }

function kind_perm(): i32 {
  return 0;
}

function kind_copy(): i32 {
  return 1;
}

function kind_num(): i32 {
  return 2;
}

function kind_octal(): i32 {
  return 3;
}

function is_octal_digit(b: i32): boolean {
  return b >= 48 && b <= 55;
}

function is_op(b: i32): boolean {
  return b == 43 || b == 45 || b == 61;
}

function who_mask(b: i32): i32 {
  if (b == 117) {
    return 448 + s_isuid();
  }
  if (b == 103) {
    return 56 + s_isgid();
  }
  if (b == 111) {
    return 7 + s_isvtx();
  }
  return all_bits();
}

function is_who(b: i32): boolean {
  return b == 117 || b == 103 || b == 111 || b == 97;
}

function copy_index(b: i32): i32 {
  if (b == 117) {
    return 0;
  }
  if (b == 103) {
    return 1;
  }
  if (b == 111) {
    return 2;
  }
  return 0 - 1;
}

function perm_bits(b: i32): i32 {
  if (b == 114) {
    return 292;
  }
  if (b == 119) {
    return 146;
  }
  if (b == 120) {
    return s_ixugo();
  }
  if (b == 115) {
    return setid_bits();
  }
  if (b == 116) {
    return s_isvtx();
  }
  return 0;
}

function is_perm(b: i32): boolean {
  return b == 88 || perm_bits(b) > 0;
}

pub function compile(spec: string): Option[Changes] {
  if (spec.len() == 0) {
    return None;
  }
  let whole: (i32, i32) = scan_octal(spec, 0);
  if (whole.0 >= 0 && whole.1 == spec.len()) {
    let kind: i32 = kind_octal();
    if (spec.len() >= 5) {
      kind = kind_num();
    }
    let one: Change[] = [];
    one = one.append(Change { who: all_bits(), explicit: false, op: 61, kind: kind, bits: whole.0, x_if: false });
    return Some(Changes { list: one });
  }
  let list: Change[] = [];
  let i: i32 = 0;
  while (i < spec.len()) {
    let step: (Change[], i32) = parse_clause(spec, i, list);
    if (step.1 < 0) {
      return None;
    }
    list = step.0;
    i = step.1;
    if (i >= spec.len()) {
      return Some(Changes { list: list });
    }
    if (spec[i] as i32 != 44 || i + 1 >= spec.len()) {
      return None;
    }
    i = i + 1;
  }
  return None;
}

function parse_clause(spec: string, at: i32, list0: Change[]): (Change[], i32) {
  let list: Change[] = list0;
  let i: i32 = at;
  let who: i32 = 0;
  let explicit: boolean = false;
  while (i < spec.len() && is_who(spec[i] as i32)) {
    who = who | who_mask(spec[i] as i32);
    explicit = true;
    i = i + 1;
  }
  let acts: i32 = 0;
  while (i < spec.len() && is_op(spec[i] as i32)) {
    let step: (Change, i32) = parse_action(spec, i, who, explicit);
    if (step.1 < 0) {
      return (list, 0 - 1);
    }
    list = list.append(step.0);
    i = step.1;
    acts = acts + 1;
    if (step.0.kind == kind_num()) {
      break;
    }
  }
  if (acts == 0) {
    return (list, 0 - 1);
  }
  return (list, i);
}

function parse_action(spec: string, at: i32, who: i32, explicit: boolean): (Change, i32) {
  let n: i32 = spec.len();
  let op: i32 = spec[at] as i32;
  let i: i32 = at + 1;
  let refused: Change = Change { who: who, explicit: explicit, op: op, kind: kind_perm(), bits: 0, x_if: false };
  let src: i32 = 0 - 1;
  if (i < n) {
    src = copy_index(spec[i] as i32);
  }
  if (src >= 0 && (i + 1 >= n || is_op(spec[i + 1] as i32) || spec[i + 1] as i32 == 44)) {
    return (Change { who: who, explicit: explicit, op: op, kind: kind_copy(), bits: src, x_if: false }, i + 1);
  }
  if (i < n && is_octal_digit(spec[i] as i32)) {
    if (explicit) {
      return (refused, 0 - 1);
    }
    let num: (i32, i32) = scan_octal(spec, i);
    if (num.0 < 0) {
      return (refused, 0 - 1);
    }
    return (Change { who: who, explicit: explicit, op: op, kind: kind_num(), bits: num.0, x_if: false }, num.1);
  }
  let bits: i32 = 0;
  let xif: boolean = false;
  while (i < n && is_perm(spec[i] as i32)) {
    let b: i32 = spec[i] as i32;
    if (b == 88) {
      xif = true;
    } else {
      bits = bits | perm_bits(b);
    }
    i = i + 1;
  }
  return (Change { who: who, explicit: explicit, op: op, kind: kind_perm(), bits: bits, x_if: xif }, i);
}

function scan_octal(spec: string, at: i32): (i32, i32) {
  let v: i32 = 0;
  let i: i32 = at;
  while (i < spec.len() && is_octal_digit(spec[i] as i32)) {
    v = v * 8 + (spec[i] as i32 - 48);
    if (v > all_bits()) {
      return (0 - 1, i);
    }
    i = i + 1;
  }
  return (v, i);
}

pub function (c: Changes) adjust(oldmode: i32, is_dir: boolean, mask: i32): Adjusted {
  let mode: i32 = oldmode & all_bits();
  let mentioned: i32 = 0;
  let touches: boolean = false;
  let i: i32 = 0;
  while (i < c.list.len()) {
    let ch: Change = c.list[i];
    i = i + 1;
    if (ch.kind == kind_octal()) {
      mode = whole_mode(ch.bits, mode, is_dir);
      mentioned = mentioned | ch.bits;
      continue;
    }
    let affected: i32 = all_bits();
    if (ch.explicit) {
      affected = ch.who;
    }
    let value: i32 = change_value(ch, mode, is_dir, affected, mask);
    if (ch.op == 43) {
      mode = mode | value;
      mentioned = mentioned | value;
    } else if (ch.op == 45) {
      mode = mode & complement(value);
      mentioned = mentioned | value;
    } else {
      let keep: i32 = 0;
      if (is_dir && ch.kind != kind_num()) {
        keep = mode & setid_bits();
      }
      mode = mode & complement(affected) | value | keep;
      mentioned = mentioned | affected;
    }
    if (ch.op != 61 && (value & setid_bits()) != 0) {
      touches = true;
    }
  }
  return Adjusted { mode: mode & all_bits(), mentioned: mentioned, touches_setid: touches };
}

function whole_mode(bits: i32, mode: i32, is_dir: boolean): i32 {
  if (!is_dir) {
    return bits;
  }
  return bits | mode & setid_bits() & complement(bits);
}

function change_value(ch: Change, mode: i32, is_dir: boolean, affected: i32, mask: i32): i32 {
  if (ch.kind == kind_num()) {
    return ch.bits & affected;
  }
  let bits: i32 = ch.bits;
  if (ch.kind == kind_copy()) {
    bits = copy_triple(mode, ch.bits);
  } else if (ch.x_if && (is_dir || (mode & s_ixugo()) != 0)) {
    bits = bits | s_ixugo();
  }
  let value: i32 = bits & affected;
  if (ch.explicit) {
    return value;
  }
  return value & complement(mask & all_bits());
}

function copy_triple(mode: i32, src: i32): i32 {
  let trip: i32 = mode & 7;
  if (src == 0) {
    trip = mode >> 6 & 7;
  } else if (src == 1) {
    trip = mode >> 3 & 7;
  }
  return trip << 6 | trip << 3 | trip;
}

function octal_digit(n: i32): string {
  return n.to_string();
}

pub function octal4(m: i32): string {
  let v: i32 = m & all_bits();
  return octal_digit(v / 512) + octal_digit(v / 64 % 8) + octal_digit(v / 8 % 8) + octal_digit(v % 8);
}

function triple(v: i32, shift: i32, sp: i32, lo: string, hi: string): string {
  let out: string = "-";
  if ((v & 4 << shift) != 0) {
    out = "r";
  }
  if ((v & 2 << shift) != 0) {
    out = out + "w";
  } else {
    out = out + "-";
  }
  let has_x: boolean = (v & 1 << shift) != 0;
  let has_sp: boolean = (v & sp) != 0;
  if (has_sp && has_x) {
    return out + lo;
  }
  if (has_sp) {
    return out + hi;
  }
  if (has_x) {
    return out + "x";
  }
  return out + "-";
}

pub function symbolic(m: i32): string {
  let v: i32 = m & all_bits();
  return triple(v, 6, s_isuid(), "s", "S") + triple(v, 3, s_isgid(), "s", "S") + triple(v, 0, s_isvtx(), "t", "T");
}
