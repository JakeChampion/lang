// C-locale `nstrftime` and the broken-down local time it renders.
//
// One engine, because seven utilities ask the same question: `ls -l` and
// `--time-style`, `du --time`, `stat`'s `%x` / `%y` / `%z`, `pr`'s header
// date, `date` itself, `touch -d`, and `who` / `pinky`. It lived privately in
// `pr.fern` and a UTC-only second copy lived in `du.fern`; #9076 is the second
// consumer `coreutils/README.md`'s rule waits for.
//
// The zone comes from `./tz`, which is tzset(3): the TZif file $TZ names, the
// POSIX rule in its footer past the transition table, or a POSIX rule string
// where $TZ is not a file at all. `break_time` is localtime(3) as a conversion
// reads it — the broken-down fields, the offset behind them, and the zone
// designation they are named by — so `%z` and `%Z` read off the same lookup
// the fields came from rather than a second one.
import "std/array";
import "std/string";
import "std/time";
import "./gnu";
import "./tz";

function byte_string(b: i32): string {
  return string_from_bytes_unchecked([b as u8]);
}

pub struct Tm { year: i32, month: i32, day: i32, hour: i32, min: i32, sec: i32, wday: i32, yday: i32, offset: i32, abbrev: string }

// `break_time(z, t)` — localtime(3) as a conversion reads it: the
// broken-down fields, the offset behind them and the zone designation
// they are named by.
pub function break_time(z: tz.Zone, t: i64): Tm {
  var dt: DateTime = z.civil(t);
  return Tm { year: dt.date.year, month: dt.date.month, day: dt.date.day, hour: dt.time.hour, min: dt.time.minute, sec: dt.time.second, wday: dt.date.weekday(), yday: dt.date.day_of_year() - 1, offset: z.offset_at(t), abbrev: z.abbrev_at(t) };
}

function floor_div(a: i64, b: i64): i64 {
  var q: i64 = a / b;
  if (a % b != 0 as i64 && a < 0 as i64 != b < 0 as i64) {
    q = q - 1 as i64;
  }
  return q;
}

function floor_mod(a: i64, b: i64): i64 {
  return a - floor_div(a, b) * b;
}

// ---- strftime ---------------------------------------------------------------
function pad_num(v: i64, width: i32, zero: boolean): string {
  var neg: boolean = v < 0 as i64;
  var mag: string = v.to_string();
  if (neg) {
    mag = slice_unchecked(mag, 1, mag.len()) + "";
  }
  var fill: string = " ";
  if (zero) {
    fill = "0";
  }
  var want: i32 = width;
  if (neg) {
    want = want - 1;
  }
  while (mag.len() < want) {
    mag = fill + mag;
  }
  if (neg) {
    return "-" + mag;
  }
  return mag;
}

function day_name(i: i32): string {
  var n: string[] = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
  return n[i];
}

function month_name(i: i32): string {
  var n: string[] = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  return n[i - 1];
}

function abbrev3(s: string): string {
  return slice_unchecked(s, 0, 3) + "";
}

function iso_weeks_in(y: i64): i32 {
  var p: i64 = floor_mod(y + floor_div(y, 4 as i64) - floor_div(y, 100 as i64) + floor_div(y, 400 as i64), 7 as i64);
  var q: i64 = y - 1 as i64;
  var pp: i64 = floor_mod(q + floor_div(q, 4 as i64) - floor_div(q, 100 as i64) + floor_div(q, 400 as i64), 7 as i64);
  if (p == 4 as i64 || pp == 3 as i64) {
    return 53;
  }
  return 52;
}

// The ISO 8601 week-based year and week number.
function iso_week(tm: Tm): (i64, i32) {
  var wd: i32 = (tm.wday + 6) % 7;
  var week: i32 = (tm.yday - wd + 10) / 7;
  var y: i64 = tm.year as i64;
  if (week < 1) {
    y = y - 1 as i64;
    week = iso_weeks_in(y);
  } else if (week > iso_weeks_in(y)) {
    y = y + 1 as i64;
    week = 1;
  }
  return (y, week);
}

function zone_offset_text(off: i32, colons: i32): string {
  var sign: string = "+";
  var v: i32 = off;
  if (v < 0) {
    sign = "-";
    v = 0 - v;
  }
  var hh: string = pad_num((v / 3600) as i64, 2, true);
  var mm: string = pad_num((v / 60 % 60) as i64, 2, true);
  var ss: string = pad_num((v % 60) as i64, 2, true);
  if (colons == 0) {
    return sign + hh + mm;
  }
  if (colons == 1) {
    return sign + hh + ":" + mm;
  }
  if (colons == 2) {
    return sign + hh + ":" + mm + ":" + ss;
  }
  return sign + hh;
}

function hour12(h: i32): i32 {
  var v: i32 = h % 12;
  if (v == 0) {
    return 12;
  }
  return v;
}

function meridiem(h: i32, upper: boolean): string {
  if (h < 12) {
    if (upper) {
      return "AM";
    }
    return "am";
  }
  if (upper) {
    return "PM";
  }
  return "pm";
}

function lower_ascii(s: string): string {
  var out: string = "";
  var i: i32 = 0;
  while (i < s.len()) {
    var b: i32 = s[i] as i32;
    if (b >= 65 && b <= 90) {
      b = b + 32;
    }
    out = out + byte_string(b);
    i = i + 1;
  }
  return out;
}

function upper_ascii(s: string): string {
  var out: string = "";
  var i: i32 = 0;
  while (i < s.len()) {
    var b: i32 = s[i] as i32;
    if (b >= 97 && b <= 122) {
      b = b - 32;
    }
    out = out + byte_string(b);
    i = i + 1;
  }
  return out;
}

// `conv(c, tm, t, nsec)` — one conversion as (text, known, the width it
// pads to by default, whether that padding is zeros).
function conv(c: i32, tm: Tm, t: i64, nsec: i64): (string, boolean, i32, boolean) {
  var year: i64 = tm.year as i64;
  if (c == 97) {
    return (abbrev3(day_name(tm.wday)), true, 0, false);
  }
  if (c == 65) {
    return (day_name(tm.wday), true, 0, false);
  }
  if (c == 98 || c == 104) {
    return (abbrev3(month_name(tm.month)), true, 0, false);
  }
  if (c == 66) {
    return (month_name(tm.month), true, 0, false);
  }
  if (c == 99) {
    return (abbrev3(day_name(tm.wday)) + " " + abbrev3(month_name(tm.month)) + " " + pad_num(tm.day as i64, 2, false) + " " + pad_num(tm.hour as i64, 2, true) + ":" + pad_num(tm.min as i64, 2, true) + ":" + pad_num(tm.sec as i64, 2, true) + " " + year.to_string(), true, 0, false);
  }
  if (c == 67) {
    return (pad_num(floor_div(year, 100 as i64), 2, true), true, 2, true);
  }
  if (c == 100) {
    return (pad_num(tm.day as i64, 2, true), true, 2, true);
  }
  if (c == 68 || c == 120) {
    return (pad_num(tm.month as i64, 2, true) + "/" + pad_num(tm.day as i64, 2, true) + "/" + pad_num(floor_mod(year, 100 as i64), 2, true), true, 0, false);
  }
  if (c == 101) {
    return (pad_num(tm.day as i64, 2, false), true, 2, false);
  }
  if (c == 70) {
    return (pad_num(year, 4, true) + "-" + pad_num(tm.month as i64, 2, true) + "-" + pad_num(tm.day as i64, 2, true), true, 0, false);
  }
  if (c == 103) {
    return (pad_num(floor_mod(iso_week(tm).0, 100 as i64), 2, true), true, 2, true);
  }
  if (c == 71) {
    return (pad_num(iso_week(tm).0, 4, true), true, 4, true);
  }
  if (c == 72) {
    return (pad_num(tm.hour as i64, 2, true), true, 2, true);
  }
  if (c == 73) {
    return (pad_num(hour12(tm.hour) as i64, 2, true), true, 2, true);
  }
  if (c == 106) {
    return (pad_num((tm.yday + 1) as i64, 3, true), true, 3, true);
  }
  if (c == 107) {
    return (pad_num(tm.hour as i64, 2, false), true, 2, false);
  }
  if (c == 108) {
    return (pad_num(hour12(tm.hour) as i64, 2, false), true, 2, false);
  }
  if (c == 109) {
    return (pad_num(tm.month as i64, 2, true), true, 2, true);
  }
  if (c == 77) {
    return (pad_num(tm.min as i64, 2, true), true, 2, true);
  }
  if (c == 110) {
    return ("\n", true, 0, false);
  }
  if (c == 78) {
    return (pad_num(nsec, 9, true), true, 9, true);
  }
  if (c == 112) {
    return (meridiem(tm.hour, true), true, 0, false);
  }
  if (c == 80) {
    return (meridiem(tm.hour, false), true, 0, false);
  }
  if (c == 113) {
    return (((tm.month - 1) / 3 + 1).to_string(), true, 0, false);
  }
  if (c == 114) {
    return (pad_num(hour12(tm.hour) as i64, 2, true) + ":" + pad_num(tm.min as i64, 2, true) + ":" + pad_num(tm.sec as i64, 2, true) + " " + meridiem(tm.hour, true), true, 0, false);
  }
  if (c == 82) {
    return (pad_num(tm.hour as i64, 2, true) + ":" + pad_num(tm.min as i64, 2, true), true, 0, false);
  }
  if (c == 115) {
    return (t.to_string(), true, 0, false);
  }
  if (c == 83) {
    return (pad_num(tm.sec as i64, 2, true), true, 2, true);
  }
  if (c == 116) {
    return ("\t", true, 0, false);
  }
  if (c == 84 || c == 88) {
    return (pad_num(tm.hour as i64, 2, true) + ":" + pad_num(tm.min as i64, 2, true) + ":" + pad_num(tm.sec as i64, 2, true), true, 0, false);
  }
  if (c == 117) {
    var u: i32 = tm.wday;
    if (u == 0) {
      u = 7;
    }
    return (u.to_string(), true, 0, false);
  }
  if (c == 85) {
    return (pad_num(((tm.yday + 7 - tm.wday) / 7) as i64, 2, true), true, 2, true);
  }
  if (c == 86) {
    return (pad_num(iso_week(tm).1 as i64, 2, true), true, 2, true);
  }
  if (c == 119) {
    return (tm.wday.to_string(), true, 0, false);
  }
  if (c == 87) {
    return (pad_num(((tm.yday + 7 - (tm.wday + 6) % 7) / 7) as i64, 2, true), true, 2, true);
  }
  if (c == 121) {
    return (pad_num(floor_mod(year, 100 as i64), 2, true), true, 2, true);
  }
  if (c == 89) {
    return (pad_num(year, 4, true), true, 4, true);
  }
  if (c == 90) {
    return (tm.abbrev, true, 0, false);
  }
  if (c == 122) {
    return (zone_offset_text(tm.offset, 0), true, 0, false);
  }
  if (c == 37) {
    return ("%", true, 0, false);
  }
  return ("", false, 0, false);
}

// The numeric value behind a padded conversion, so an explicit width
// can repad it.
function unpad(s: string): i64 {
  var i: i32 = 0;
  var neg: boolean = s.len() > 0 && s[0] as i32 == 45;
  while (i < s.len() && (s[i] as i32 == 32 || s[i] as i32 == 48 || s[i] as i32 == 45)) {
    i = i + 1;
  }
  var v: i64 = 0 as i64;
  while (i < s.len() && gnu.is_digit(s[i] as i32)) {
    v = v * (10 as i64) + (s[i] as i32 - 48) as i64;
    i = i + 1;
  }
  if (neg) {
    return 0 as i64 - v;
  }
  return v;
}

// `strftime(fmt, z, t, nsec)` — nstrftime in the C locale: the
// conversions above with gnulib's `-` `_` `0` `^` `#` flags, an
// optional field width, the `E` / `O` modifiers (C has no alternative
// representations, so they are skipped) and the `:` repetitions of
// `%z`. An unknown conversion is copied out with its percent, as glibc
// copies it.
pub function strftime(fmt: string, z: tz.Zone, t: i64, nsec: i64): string {
  var tm: Tm = break_time(z, t);
  var out: string = "";
  var i: i32 = 0;
  while (i < fmt.len()) {
    var b: i32 = fmt[i] as i32;
    if (b != 37) {
      out = out + byte_string(b);
      i = i + 1;
      continue;
    }
    var start: i32 = i;
    var j: i32 = i + 1;
    var pad_dash: boolean = false;
    var pad_under: boolean = false;
    var pad_zero: boolean = false;
    var up: boolean = false;
    var swap: boolean = false;
    var colons: i32 = 0;
    var flagging: boolean = true;
    while (j < fmt.len() && flagging) {
      var f: i32 = fmt[j] as i32;
      if (f == 45) {
        pad_dash = true;
        j = j + 1;
      } else if (f == 95) {
        pad_under = true;
        j = j + 1;
      } else if (f == 48) {
        pad_zero = true;
        j = j + 1;
      } else if (f == 94) {
        up = true;
        j = j + 1;
      } else if (f == 35) {
        swap = true;
        j = j + 1;
      } else {
        flagging = false;
      }
    }
    var width: i32 = 0;
    var has_width: boolean = false;
    while (j < fmt.len() && gnu.is_digit(fmt[j] as i32)) {
      has_width = true;
      if (width < 1000) {
        width = width * 10 + (fmt[j] as i32 - 48);
      }
      j = j + 1;
    }
    while (j < fmt.len() && fmt[j] as i32 == 58) {
      colons = colons + 1;
      j = j + 1;
    }
    if (j < fmt.len() && (fmt[j] as i32 == 69 || fmt[j] as i32 == 79)) {
      j = j + 1;
    }
    if (j >= fmt.len()) {
      out = out + slice_unchecked(fmt, start, fmt.len());
      i = fmt.len();
      continue;
    }
    var c: i32 = fmt[j] as i32;
    if (colons > 0 && c != 122) {
      out = out + slice_unchecked(fmt, start, j + 1);
      i = j + 1;
      continue;
    }
    var r: (string, boolean, i32, boolean) = conv(c, tm, t, nsec);
    if (colons > 0) {
      r = (zone_offset_text(tm.offset, colons), true, 0, false);
    }
    if (!r.1) {
      out = out + slice_unchecked(fmt, start, j + 1);
      i = j + 1;
      continue;
    }
    var text: string = r.0;
    if (c == 78 && has_width) {
      if (width <= 9) {
        text = slice_unchecked(text, 0, width) + "";
      } else {
        text = text + "0".repeat(width - 9);
      }
      has_width = false;
      r = (text, true, 0, false);
    }
    var want: i32 = r.2;
    var zero: boolean = r.3;
    if (pad_dash) {
      want = 0;
    }
    if (pad_under) {
      zero = false;
    }
    if (pad_zero) {
      zero = true;
    }
    if (has_width && width > want) {
      want = width;
    }
    if (r.2 > 0) {
      text = pad_num(unpad(text), want, zero);
    } else if (has_width) {
      while (text.len() < width) {
        if (zero) {
          text = "0" + text;
        } else {
          text = " " + text;
        }
      }
    }
    if (up || swap && c != 90) {
      text = upper_ascii(text);
    } else if (swap) {
      text = lower_ascii(text);
    }
    out = out + text;
    i = j + 1;
  }
  return out;
}
