// coreutils/lib/gnu.fern — the conventions every utility in this
// directory shares with GNU coreutils.
//
// The utilities here are held to byte-for-byte parity with GNU
// coreutils on stdout, stderr and exit status (docs/COREUTILS.md), so
// the shapes below are not house style — each one is a GNU behaviour
// measured against the reference binary and then reproduced:
//
//   - Diagnostics are prefixed with argv[0] EXACTLY as invoked,
//     directories included: `/usr/bin/yes: invalid option -- 'x'`.
//     gnulib's set_program_name keeps the whole string, so a utility
//     that prints a basename diverges the moment it is run by path.
//   - A usage error prints one line naming the fault, then the
//     `Try '<argv[0]> --help' for more information.` line, and exits
//     with the utility's usage status (1 for most, 2 for sort/expr/…).
//     The full help text is NEVER printed on the error path.
//   - The two long options every utility answers are matched by
//     UNIQUE PREFIX, so `--vers` is `--version` and `--h` is `--help`.
//   - `getopt` below is glibc's getopt_long: option clusters, values
//     glued or separate, permutation, POSIXLY_CORRECT, and the exact
//     wording of every refusal.
//
// Error TEXT is glibc's, not ours: the strings in `io_error_text`
// below are what `strerror` returns, because that is what GNU prints.
//
// Nothing here was copied from GNU sources; the behaviours were
// measured from the reference binaries and reimplemented.
import "std/string";
import "std/array";

// `prog()` — the program name diagnostics are prefixed with: argv[0]
// verbatim (see the header). Empty when argv is empty, which only
// happens under an exec that passes no argv at all.
pub function prog(): string {
  var argv: string[] = args();
  if (argv.len() == 0) {
    return "";
  }
  return argv[0];
}

// `version()` — the version this build of the utilities reports.
//
// Deliberately NOT a GNU coreutils version: these are a different
// implementation, and claiming GNU's number would make the one output
// that identifies the program lie about which program it is.
pub function version(): string {
  return "0.1";
}

// `error(msg)` — one diagnostic line on stderr, GNU-prefixed.
pub function error(msg: string): void {
  eprint(prog() + ": " + msg);
}

// `try_help(status)` — the trailing line of every usage error, then
// exit. Split out because a few utilities emit it with no preceding
// message of their own.
pub function try_help(status: i32): void {
  eprint("Try '" + prog() + " --help' for more information.");
  exit(status);
}

// `die_usage(msg, status)` — the whole usage-error path: the fault,
// the `Try …` line, exit.
pub function die_usage(msg: string, status: i32): void {
  error(msg);
  try_help(status);
}

// `is_option(a)` — whether getopt would treat `a` as an option token.
// A lone `-` is an operand (it names stdin); `--` is the terminator
// and is handled by the caller before this is asked.
pub function is_option(a: string): boolean {
  return a.len() >= 2 && a[0] as i32 == 45;
}

// `io_error_text(e)` — the strerror text GNU prints for an IoError.
//
// The kinds the runtime names carry no message of their own, so the
// mapping is by errno text; `Other` carries the runtime's own string.
// That string is EMPTY today for every errno outside the named set
// (#8265), which is the one gap between these utilities and GNU
// on the write-failure paths — docs/COREUTILS.md records it.
pub function io_error_text(e: IoError): string {
  match (e) {
    NotFound(_) => {
      return "No such file or directory";
    },
    PermissionDenied(_) => {
      return "Permission denied";
    },
    AlreadyExists(_) => {
      return "File exists";
    },
    InvalidUtf8(_) => {
      return "Invalid or incomplete multibyte or wide character";
    },
    Interrupted => {
      return "Interrupted system call";
    },
    Unsupported => {
      return "Operation not supported";
    },
    Other(_, msg) => {
      return msg;
    }
  }
}

// `write_out(s)` — write `s` to stdout, reporting a failure the way
// GNU's close_stdout does (`prog: write error: <strerror>`) and
// exiting 1. For the paths where the utility has its own wording —
// yes(1) says `standard output:` — hold a Writer and check it there.
pub function write_out(s: string): void {
  var w: Writer = stdout();
  match (w.write(s)) {
    Some(e) => {
      error("write error: " + io_error_text(e));
      exit(1);
    },
    None => {}
  }
}

// `append_span(out, s, start, end)` — the bytes `s[start:end]` onto
// `out`. Output is accumulated and written once: a utility that
// writes per operand or per line pays a syscall for each, which was
// the entire difference between yes(1) at 2.8 MB/s and at 385.
//
// A span rather than a whole string because the utilities that trim
// a name — basename, dirname — have the answer as a range of the
// operand they were given, and copying it out first buys nothing.
pub function append_span(out: u8[], s: string, start: i32, end: i32): u8[] {
  var bs: u8[] = out;
  var i: i32 = start;
  while (i < end) {
    bs = bs.append(s[i]);
    i = i + 1;
  }
  return bs;
}

// `is_slash(b)` — the path separator, as a byte. Only `/` is one on
// the targets these binaries build for.
pub function is_slash(b: i32): boolean {
  return b == 47;
}

// `last_component(s)` — the index where the last path component of
// `s` begins, which is gnulib's last_component: leading slashes are
// never part of a component, and a run of slashes inside the path
// belongs to the component before it. Returns `s.len()` when `s` is
// empty or all slashes, because then there is no component at all.
//
//   "a/b/c"   -> 4        "//a//b"  -> 5
//   "a/b/"    -> 2        "///"     -> 3 (== len)
pub function last_component(s: string): i32 {
  var i: i32 = 0;
  while (i < s.len() && is_slash(s[i] as i32)) {
    i = i + 1;
  }
  var base: i32 = i;
  var saw_slash: boolean = false;
  while (i < s.len()) {
    if (is_slash(s[i] as i32)) {
      saw_slash = true;
    } else if (saw_slash) {
      base = i;
      saw_slash = false;
    }
    i = i + 1;
  }
  return base;
}

// `print_help_version(name, help_text, status)` — the two outputs
// every utility shares. `status` is the exit code: 0 for most, but
// true(1) and false(1) exit with THEIR status even from `--help`.
function print_help(help_text: string, status: i32): void {
  write_out(help_text);
  exit(status);
}

function print_version(name: string, status: i32): void {
  write_out(name + " (Fern coreutils) " + version() + "\n");
  exit(status);
}

// A declared option. `short` is one byte or "", `long` is the long
// name or "", `takes_value` distinguishes `-s SUFFIX` from `-z`.
pub struct Opt { short: string, long: string, takes_value: boolean }

// `flag_opt(short, long)` — declare an option that takes no value.
pub function flag_opt(short: string, long: string): Opt {
  return Opt { short: short, long: long, takes_value: false };
}

// `value_opt(short, long)` — declare an option that takes one, given
// as `-sV`, `-s V`, `--long=V` or `--long V`.
pub function value_opt(short: string, long: string): Opt {
  return Opt { short: short, long: long, takes_value: true };
}

// One option as getopt returned it: `name` is the long name if the
// option has one and the short letter otherwise, `value` is its
// argument or "". Occurrences are kept in order and repeats are kept
// too, so a utility reads "last one wins" by scanning to the end.
pub struct OptSeen { name: string, value: string }

// A parsed command line: the options in the order they were found,
// and the operands in their original order.
pub struct Cmdline { seen: OptSeen[], operands: string[] }

// `die_invalid_short(a, j, status)` — glibc's refusal of the option
// byte at `a[j]`, which names that byte and not the whole cluster:
// `-ax` with a declared `-a` reports `invalid option -- 'x'`.
function die_invalid_short(a: string, j: i32, status: i32): void {
  die_usage("invalid option -- '" + slice_unchecked(a, j, j + 1) + "'", status);
}

// `die_unrecognized_long(token, status)` — glibc names the WHOLE
// token here, `=value` and all: `unrecognized option '--foo=bar'`.
function die_unrecognized_long(token: string, status: i32): void {
  die_usage("unrecognized option '" + token + "'", status);
}

// The long-option name in `a` (`--name` or `--name=value`), its
// value, and whether a value was glued on at all.
function long_parts(a: string): (string, string, boolean) {
  var body: str = slice_unchecked(a, 2, a.len());
  var eq: i32 = body.index_of("=");
  if (eq >= 0) {
    return (slice_unchecked(body, 0, eq) + "", slice_unchecked(body, eq + 1, body.len()) + "", true);
  }
  return (body + "", "", false);
}

// The declared options `typed` could be, in declaration order. An
// EXACT name is the only match even when it is also a prefix of
// others, which is why `--help` is not ambiguous against a declared
// `--help-all`. The empty name is a prefix of everything, so `--=x`
// matches all of them and is reported as ambiguous rather than as
// unrecognized.
function long_matches(all: Opt[], typed: string): i32[] {
  var hits: i32[] = [];
  var i: i32 = 0;
  while (i < all.len()) {
    var o: Opt = all[i];
    if (o.long.len() > 0) {
      if (o.long == typed) {
        var exact: i32[] = [];
        return exact.append(i);
      }
      if (o.long.starts_with(typed)) {
        hits = hits.append(i);
      }
    }
    i = i + 1;
  }
  return hits;
}

// The index of the declared option with short letter `b`, or -1.
function short_match(all: Opt[], b: i32): i32 {
  var i: i32 = 0;
  while (i < all.len()) {
    if (all[i].short.len() == 1 && all[i].short[0] as i32 == b) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// How an option is named in the parse result.
function key_of(o: Opt): string {
  if (o.long.len() > 0) {
    return o.long;
  }
  return o.short;
}

// `--help` and `--version` go LAST in the declaration order, because
// that is where GNU's GETOPT_HELP_OPTION_DECL sits in every utility's
// long_options table, and the ambiguity list prints in that order:
// `basename --=x` says `'--multiple' '--suffix' '--zero' '--help'
// '--version'`.
function with_standard(opts: Opt[]): Opt[] {
  return opts.append(flag_opt("", "help")).append(flag_opt("", "version"));
}

function posixly_correct(): boolean {
  match (env("POSIXLY_CORRECT")) {
    Some(_) => {
      return true;
    },
    None => {}
  }
  return false;
}

// `getopt(argv, opts, posix_first, name, help_text, status)` —
// glibc's getopt_long over `argv`, answering `--help` and `--version`
// itself and exiting on any refusal with `status`.
//
// `posix_first` is the leading `+` in an optstring: option scanning
// STOPS at the first operand, so `basename x -a y` has three operands
// rather than an option and two. Without it the scan permutes and an
// option is found wherever it stands — `dirname x -z` is `-z` with
// one operand. POSIXLY_CORRECT in the environment forces the first
// behaviour on either, exactly as glibc's ordering rule does.
//
// The refusals, all with the `Try …` line after them:
//
//   -x                  `invalid option -- 'x'`        (the byte)
//   --foo=bar           `unrecognized option '--foo=bar'` (the token)
//   --zero=1            `option '--zero' doesn't allow an argument`
//   --suffix            `option '--suffix' requires an argument`
//   -s                  `option requires an argument -- 's'`
//   --=x                `option '--=x' is ambiguous; possibilities: …`
//
// A long option is reported by its CANONICAL name however it was
// abbreviated (`--z=1` says `'--zero'`); the ambiguous and the
// unrecognized cases name the token as typed instead.
pub function getopt(argv: string[], opts: Opt[], posix_first: boolean, name: string, help_text: string, status: i32): Cmdline {
  var all: Opt[] = with_standard(opts);
  var help_at: i32 = all.len() - 2;
  var version_at: i32 = all.len() - 1;
  var stop_at_operand: boolean = posix_first || posixly_correct();
  var seen: OptSeen[] = [];
  var operands: string[] = [];
  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    i = i + 1;
    if (a == "--") {
      break;
    }
    if (!is_option(a)) {
      operands = operands.append(a);
      if (stop_at_operand) {
        break;
      }
      continue;
    }
    if (a.starts_with("--")) {
      var parts: (string, string, boolean) = long_parts(a);
      var typed: string = parts.0;
      var value: string = parts.1;
      var glued: boolean = parts.2;
      var hits: i32[] = long_matches(all, typed);
      if (hits.len() == 0) {
        die_unrecognized_long(a, status);
      }
      if (hits.len() > 1) {
        var list: string = "";
        var h: i32 = 0;
        while (h < hits.len()) {
          list = list + " '--" + all[hits[h]].long + "'";
          h = h + 1;
        }
        die_usage("option '" + a + "' is ambiguous; possibilities:" + list, status);
      }
      var at: i32 = hits[0];
      var o: Opt = all[at];
      if (o.takes_value) {
        if (!glued) {
          if (i >= argv.len()) {
            die_usage("option '--" + o.long + "' requires an argument", status);
          }
          value = argv[i];
          i = i + 1;
        }
      } else if (glued) {
        die_usage("option '--" + o.long + "' doesn't allow an argument", status);
      }
      // After the argument check, so `--help=x` is refused rather
      // than answered.
      if (at == help_at) {
        print_help(help_text, 0);
      }
      if (at == version_at) {
        print_version(name, 0);
      }
      seen = seen.append(OptSeen { name: key_of(o), value: value });
      continue;
    }
    var j: i32 = 1;
    while (j < a.len()) {
      var at2: i32 = short_match(all, a[j] as i32);
      if (at2 < 0) {
        die_invalid_short(a, j, status);
      }
      var o2: Opt = all[at2];
      j = j + 1;
      var value2: string = "";
      if (o2.takes_value) {
        if (j < a.len()) {
          // The rest of the cluster is the value: `-s.c`.
          value2 = slice_unchecked(a, j, a.len()) + "";
          j = a.len();
        } else if (i < argv.len()) {
          // The next token is, whatever it looks like: `-s --`.
          value2 = argv[i];
          i = i + 1;
        } else {
          die_usage("option requires an argument -- '" + o2.short + "'", status);
        }
      }
      seen = seen.append(OptSeen { name: key_of(o2), value: value2 });
    }
  }
  while (i < argv.len()) {
    operands = operands.append(argv[i]);
    i = i + 1;
  }
  return Cmdline { seen: seen, operands: operands };
}

// `parse_standard_options_only(argv, name, help_text, status)` —
// gnulib's parse_gnu_standard_options_only, for a utility whose ONLY
// options are `--help` and `--version`. A permuting scan, so an
// option is found wherever it stands until `--`; POSIXLY_CORRECT
// makes it stop at the first operand like every other getopt, which
// is why `POSIXLY_CORRECT=1 yes x --help` prints `x --help` forever.
// Returns the operands in their original order.
pub function parse_standard_options_only(argv: string[], name: string, help_text: string, status: i32): string[] {
  var no_opts: Opt[] = [];
  return getopt(argv, no_opts, false, name, help_text, status).operands;
}

// `sole_help_version(argv, name, help_text, status)` — the narrower
// rule true(1), false(1) and echo(1) use: `--help` and `--version`
// are honoured only as the SOLE argument, spelled in full, and are
// ordinary operands otherwise. `true --help x` therefore exits 0 in
// silence, and `echo --help x` prints `--help x`.
pub function sole_help_version(argv: string[], name: string, help_text: string, status: i32): void {
  if (argv.len() != 2) {
    return;
  }
  if (argv[1] == "--help") {
    print_help(help_text, status);
    return;
  }
  if (argv[1] == "--version") {
    print_version(name, status);
  }
}
