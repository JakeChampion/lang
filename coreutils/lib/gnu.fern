import "std/string";
import "std/array";
import "std/io";
import "std/io_buffered";
import "std/errno";

pub function prog(): string {
  let argv: string[] = args();
  if (argv.len() == 0) {
    return "";
  }
  return argv[0];
}

pub function version(): string {
  return "0.1";
}

pub function error(msg: string): void {
  eprint(prog() + ": " + msg);
}

pub function error_out(o: io_buffered.BufWriter, msg: string): io_buffered.BufWriter {
  if (!stdout_open()) {
    error(msg);
    return o;
  }
  let w: io_buffered.BufWriter = o.flush();
  error(msg);
  return w;
}

pub function error_out_bytes(o: io_buffered.BufWriter, msg: u8[]): io_buffered.BufWriter {
  let w: io_buffered.BufWriter = o;
  if (stdout_open()) {
    w = w.flush();
  }
  let h: usize = buf_new(msg.len());
  buf_push(h, prog());
  buf_push(h, ": ");
  buf_push_bytes_range(h, msg, 0, msg.len());
  buf_push_byte(h, 10);
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  let diagnostic: Writer = stderr();
  diagnostic.write_bytes(bytes);
  return w;
}

function stdout_open(): boolean {
  match (stdout().flags()) {
    Ok(_) => {
      return true;
    },
    Err(_) => {
      return false;
    }
  }
}

pub function die(o: io_buffered.BufWriter, msg: string, status: i32): void {
  let w: io_buffered.BufWriter = error_out(o, msg);
  close_stdout_with(w, false, status);
  exit(status);
}

pub function try_help(status: i32): void {
  eprint("Try '" + prog() + " --help' for more information.");
  exit(status);
}

pub function die_usage(msg: string, status: i32): void {
  error(msg);
  try_help(status);
}

pub function argmatch(v: string, names: string[], option: string): i32 {
  return argmatch_valued(v, names, one_value_each(names.len()), option);
}

pub function argmatch_valued(v: string, names: string[], values: i32[], option: string): i32 {
  let found: i32 = argmatch_find(v, names, values);
  if (found >= 0) {
    return found;
  }
  let what: string = "invalid";
  if (found == 0 - 2) {
    what = "ambiguous";
  }
  return argmatch_die(v, names, values, option, what);
}

pub function argmatch_find(v: string, names: string[], values: i32[]): i32 {
  let found: i32 = 0 - 1;
  let ambiguous: boolean = false;
  let i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == v) {
      return values[i];
    }
    if (names[i].starts_with(v)) {
      if (found < 0) {
        found = i;
      } else if (values[i] != values[found]) {
        ambiguous = true;
      }
    }
    i = i + 1;
  }
  if (ambiguous) {
    return 0 - 2;
  }
  if (found >= 0) {
    return values[found];
  }
  return 0 - 1;
}

pub function argmatch_exact(v: string, names: string[], option: string): i32 {
  let i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == v) {
      return i;
    }
    i = i + 1;
  }
  return argmatch_die(v, names, one_value_each(names.len()), option, "invalid");
}

function argmatch_die(v: string, names: string[], values: i32[], option: string, what: string): i32 {
  error(what + " argument " + quote(v) + " for " + quote(option));
  eprint("Valid arguments are:");
  let i: i32 = 0;
  while (i < names.len()) {
    let line: string = "  - " + quote(names[i]);
    let j: i32 = i + 1;
    while (j < names.len() && values[j] == values[i]) {
      line = line + ", " + quote(names[j]);
      j = j + 1;
    }
    eprint(line);
    i = j;
  }
  try_help(1);
  return 0;
}

function one_value_each(n: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(i);
    i = i + 1;
  }
  return out;
}

pub function is_option(a: string): boolean {
  return a.len() >= 2 && a[0] as i32 == 45;
}

pub function erange_text(): string {
  if (target_os() == "darwin") {
    return "Result too large";
  }
  return "Numerical result out of range";
}

pub function eoverflow_text(): string {
  if (target_os() == "darwin") {
    return "Value too large to be stored in data type";
  }
  return "Value too large for defined data type";
}

pub function eilseq_text(): string {
  if (target_os() == "darwin") {
    return "Illegal byte sequence";
  }
  return "Invalid or incomplete multibyte or wide character";
}

pub function io_error_text(e: IoError): string {
  match (e) {
    NotFound(_) => {
      return "No such file or directory";
    },
    PermissionDenied(_) => {
      return "Permission denied";
    },
    AlreadyExists(_) => {
      return "File exists";
    },
    InvalidUtf8(_) => {
      return eilseq_text();
    },
    Interrupted => {
      return "Interrupted system call";
    },
    Unsupported => {
      return "Operation not supported";
    },
    Other(_, msg, _) => {
      return msg;
    }
  }
}

pub function is_broken_pipe(e: IoError): boolean {
  return errno.of(e) == errno.EPIPE;
}

pub function write_out(s: string): void {
  write_out_with(s, 1);
}

pub function write_out_with(s: string, status: i32): void {
  let w: Writer = stdout();
  if let Err(e) = w.write(s) {
    error("write error: " + io_error_text(e));
    exit(status);
  }
}

function suffix_power(c: i32): i32 {
  if (c == 75 || c == 107) {
    return 1;
  }
  if (c == 77) {
    return 2;
  }
  if (c == 71) {
    return 3;
  }
  if (c == 84) {
    return 4;
  }
  if (c == 80) {
    return 5;
  }
  if (c == 69) {
    return 6;
  }
  if (c == 90) {
    return 7;
  }
  if (c == 89) {
    return 8;
  }
  if (c == 82) {
    return 9;
  }
  if (c == 81) {
    return 10;
  }
  return 0;
}

pub function is_digit(c: i32): boolean {
  return c >= 48 && c <= 57;
}

pub function is_blank(c: i32): boolean {
  return c == 32 || c >= 9 && c <= 13;
}

pub function parse_units(s: string): (u64, i32) {
  return parse_count(s, true);
}

pub function parse_number(s: string): (u64, i32) {
  return parse_count(s, false);
}

function is_suffix(c: i32): boolean {
  return c == 98 || suffix_power(c) > 0;
}

pub function count_malformed(status: i32): boolean {
  return status == 1 || status == 4;
}

pub function count_overflow(status: i32): boolean {
  return status == 2 || status == 3;
}

function parse_count(s: string, suffixes: boolean): (u64, i32) {
  let i: i32 = 0;
  while (i < s.len() && is_blank(s[i] as i32)) {
    i = i + 1;
  }
  if (i < s.len() && s[i] as i32 == 43) {
    i = i + 1;
  }
  let starts: boolean = i < s.len() && is_digit(s[i] as i32);
  if (!starts && !(suffixes && i < s.len() && is_suffix(s[i] as i32))) {
    return (0 as u64, 1);
  }
  let v: u64 = 1 as u64;
  if (starts) {
    v = 0 as u64;
  }
  let over: boolean = false;
  let digits_over: boolean = false;
  while (i < s.len() && is_digit(s[i] as i32)) {
    let d: u64 = (s[i] as i32 - 48) as u64;
    match (v.checked_mul(10 as u64)) {
      Some(m) => {
        match (m.checked_add(d)) {
          Some(a) => {
            v = a;
          },
          None => {
            digits_over = true;
          }
        }
      },
      None => {
        digits_over = true;
      }
    }
    i = i + 1;
  }
  let mul: u64 = 1 as u64;
  if (i < s.len() && suffixes) {
    let c: i32 = s[i] as i32;
    if (c == 98) {
      mul = 512 as u64;
      i = i + 1;
    } else {
      let p: i32 = suffix_power(c);
      if (p == 0) {
        return (0 as u64, 4);
      }
      i = i + 1;
      let base: u64 = 1024 as u64;
      if (i < s.len() && s[i] as i32 == 66) {
        base = 1000 as u64;
        i = i + 1;
      } else if (i + 1 < s.len() && s[i] as i32 == 105 && s[i + 1] as i32 == 66) {
        i = i + 2;
      }
      let k: i32 = 0;
      while (k < p) {
        match (mul.checked_mul(base)) {
          Some(m) => {
            mul = m;
          },
          None => {
            over = true;
          }
        }
        k = k + 1;
      }
    }
  }
  if (i != s.len()) {
    return (0 as u64, 4);
  }
  if (!over && !digits_over) {
    match (v.checked_mul(mul)) {
      Some(m) => {
        v = m;
      },
      None => {
        over = true;
      }
    }
  }
  if (digits_over) {
    return (0 as u64, 2);
  }
  if (over) {
    return (0 as u64, 3);
  }
  return (v, 0);
}

pub function posix2_version(): i64 {
  match (env("_POSIX2_VERSION")) {
    Some(v) => {
      if (v.len() > 0) {
        match (strtol_int(v)) {
          Some(n) => {
            return n;
          },
          None => {}
        }
      }
    },
    None => {}
  }
  if (target_os() == "darwin") {
    return 200112 as i64;
  }
  return 200809 as i64;
}

function strtol_int(s: string): Option[i64] {
  let i: i32 = 0;
  while (i < s.len() && is_blank(s[i] as i32)) {
    i = i + 1;
  }
  let neg: boolean = false;
  if (i < s.len() && (s[i] as i32 == 43 || s[i] as i32 == 45)) {
    neg = s[i] as i32 == 45;
    i = i + 1;
  }
  if (i >= s.len() || !is_digit(s[i] as i32)) {
    return None;
  }
  let v: i64 = 0 as i64;
  let over: boolean = false;
  while (i < s.len() && is_digit(s[i] as i32)) {
    if (v > 999999999 as i64) {
      over = true;
    } else {
      v = v * (10 as i64) + (s[i] as i32 - 48) as i64;
    }
    i = i + 1;
  }
  if (i != s.len()) {
    return None;
  }
  if (neg) {
    v = 0 as i64 - v;
  }
  if (over || v > 2147483647 as i64 || v < (0 - 2147483647 - 1) as i64) {
    if (neg) {
      return Some((0 - 2147483647 - 1) as i64);
    }
    return Some(2147483647 as i64);
  }
  return Some(v);
}

pub function digit_option(argv: string[]): string {
  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a.len() >= 2 && a[0] as i32 == 45) {
      let k: i32 = 1;
      while (k < a.len()) {
        if (is_digit(a[k] as i32)) {
          return slice_unchecked(a, k, k + 1) + "";
        }
        k = k + 1;
      }
    }
    i = i + 1;
  }
  return "0";
}

pub struct Stream { w: io_buffered.BufWriter, first: boolean, ok: boolean }

pub function stream_new(): Stream {
  return Stream { w: out_new(), first: true, ok: true };
}

pub function stream_put(o: Stream, s: string): Stream {
  return stream_written(o, o.w.write_string(s));
}

pub function stream_put_bytes(o: Stream, bytes: u8[]): Stream {
  return stream_written(o, o.w.write_bytes(bytes));
}

pub function stream_put_bytes_range(o: Stream, bytes: u8[], lo: i32, hi: i32): Stream {
  return stream_written(o, o.w.write_bytes_range(bytes, lo, hi));
}

function stream_written(o: Stream, w: io_buffered.BufWriter): Stream {
  match (w.error()) {
    Some(e) => {
      error("error writing " + quotea("standard output") + ": " + io_error_text(e));
      exit(1);
    },
    None => {}
  }
  return Stream { ...o, w: w };
}

pub function stream_fail(o: Stream, msg: string): Stream {
  return Stream { ...o, w: error_out(o.w, msg), ok: false };
}

pub function stream_header(o: Stream, name: string): Stream {
  let lead: string = "\n";
  if (o.first) {
    lead = "";
  }
  return Stream { ...stream_put(o, lead + "==> " + quotef(name) + " <==\n"), first: false };
}

pub function stream_flush(o: Stream): Stream {
  return Stream { ...o, w: flush(o.w) };
}

pub function stream_finish(o: Stream): void {
  finish(o.w);
}

pub function stream_finish_with(o: Stream, status: i32): void {
  finish_with(o.w, status);
  exit(status);
}

pub function quote(s: string): string {
  return c_quote(s, 39, false, "");
}

pub function quote_bytes(bytes: u8[]): string {
  let out: usize = buf_new(bytes.len());
  buf_push_byte(out, 39);
  for byte in bytes {
    let b: i32 = byte as i32;
    if (b == 92 || b == 39) {
      buf_push_byte(out, 92);
      buf_push_byte(out, b);
    } else if (b >= 32 && b < 127) {
      buf_push_byte(out, b);
    } else {
      buf_push_byte(out, 92);
      let named: i32 = c_escape_letter(b);
      if (named > 0) {
        buf_push_byte(out, named);
      } else {
        buf_push_byte(out, 48 + b / 64);
        buf_push_byte(out, 48 + b / 8 % 8);
        buf_push_byte(out, 48 + b % 8);
      }
    }
  }
  buf_push_byte(out, 39);
  let text: string = buf_take(out);
  buf_free(out);
  return text;
}

pub function quotea(s: string): string {
  return shell_quote(s, false, true, "");
}

pub function quotef(s: string): string {
  return shell_quote(s, true, true, ":");
}

pub function quoting_style_names(): string[] {
  return ["literal", "shell", "shell-always", "shell-escape", "shell-escape-always", "c", "c-maybe", "escape", "locale", "clocale"];
}

pub function quoting_style_default(): i32 {
  return 4;
}

pub function quoting_style_from_env(): i32 {
  return quoting_style_from_env_with(quoting_style_default());
}

pub function quoting_style_from_env_with(fallback: i32): i32 {
  match (env("QUOTING_STYLE")) {
    Some(v) => {
      let names: string[] = quoting_style_names();
      let found: i32 = argmatch_find(v, names, one_value_each(names.len()));
      if (found >= 0) {
        return found;
      }
      error("ignoring invalid value of environment variable QUOTING_STYLE: " + quote(v));
      return fallback;
    },
    None => {
      return fallback;
    }
  }
}

pub function quote_style(s: string, style: i32): string {
  return quote_style_with(s, style, "");
}

pub function quote_style_with(s: string, style: i32, extra: string): string {
  if (style == 0) {
    return s;
  }
  if (style < 5) {
    return shell_quote(s, style == 1 || style == 3, style >= 3, extra);
  }
  if (style == 5 || style == 9) {
    return c_quote(s, 34, false, extra);
  }
  if (style == 6) {
    return c_quote(s, 34, true, extra);
  }
  if (style == 7) {
    return c_quote(s, 0, false, extra);
  }
  return c_quote(s, 39, false, extra);
}

function in_set(extra: string, b: i32): boolean {
  let i: i32 = 0;
  while (i < extra.len()) {
    if (extra[i] as i32 == b) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function c_quote(s: string, q: i32, elide: boolean, extra: string): string {
  if (elide && !c_needs_quotes(s, q, extra)) {
    return s;
  }
  let bs: u8[] = [];
  if (q != 0) {
    bs = bs.append(q as u8);
  }
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b == 92 || q != 0 && b == q || in_set(extra, b)) {
      bs = bs.append(92 as u8);
      bs = bs.append(b as u8);
    } else if (b >= 32 && b < 127) {
      bs = bs.append(b as u8);
    } else {
      bs = append_c_escape(bs, b);
    }
    i = i + 1;
  }
  if (q != 0) {
    bs = bs.append(q as u8);
  }
  return string_from_bytes_unchecked(bs);
}

function c_needs_quotes(s: string, q: i32, extra: string): boolean {
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b == q || is_control_or_high(b) || in_set(extra, b)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function append_c_escape(out: u8[], b: i32): u8[] {
  let bs: u8[] = out.append(92 as u8);
  let named: i32 = c_escape_letter(b);
  if (named > 0) {
    return bs.append(named as u8);
  }
  bs = bs.append((48 + b / 64) as u8);
  bs = bs.append((48 + b / 8 % 8) as u8);
  return bs.append((48 + b % 8) as u8);
}

function c_escape_letter(b: i32): i32 {
  if (b == 7) {
    return 97;
  }
  if (b == 8) {
    return 98;
  }
  if (b == 12) {
    return 102;
  }
  if (b == 10) {
    return 110;
  }
  if (b == 13) {
    return 114;
  }
  if (b == 9) {
    return 116;
  }
  if (b == 11) {
    return 118;
  }
  return 0;
}

function is_control_or_high(b: i32): boolean {
  return b < 32 || b >= 127;
}

function shell_special(b: i32, leading: boolean): boolean {
  if (b == 126 || b == 35) {
    return leading;
  }
  return b == 32 || b == 39 || b == 34 || b == 92 || b == 36 || b == 42 || b == 59 || b == 61 || b == 33 || b == 63 || b == 91 || b == 40 || b == 41 || b == 38 || b == 124 || b == 60 || b == 62 || b == 96 || b == 94;
}

function shell_needs_quotes(s: string, escapes: boolean, extra: string): boolean {
  if (s.len() == 0) {
    return true;
  }
  if (s.len() == 1 && (s[0] == 123 as u8 || s[0] == 125 as u8)) {
    return true;
  }
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (is_control_or_high(b)) {
      if (escapes || b == 10 || b == 13 || b == 9) {
        return true;
      }
    } else if (shell_special(b, i == 0) || in_set(extra, b)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function double_quote_unsafe(b: i32, leading: boolean): boolean {
  if (is_control_or_high(b)) {
    return true;
  }
  if (b == 126 || b == 35) {
    return !leading;
  }
  return b == 34 || b == 92 || b == 36 || b == 96 || b == 33 || b == 42 || b == 63 || b == 91 || b == 40 || b == 41 || b == 38 || b == 124 || b == 60 || b == 62 || b == 59 || b == 61 || b == 94 || b == 123 || b == 125;
}

function shell_quote(s: string, elide: boolean, escapes: boolean, extra: string): string {
  if (elide && !shell_needs_quotes(s, escapes, extra)) {
    return s;
  }
  let double_ok: boolean = true;
  let has_quote: boolean = false;
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (double_quote_unsafe(b, i == 0)) {
      double_ok = false;
    }
    if (b == 39) {
      has_quote = true;
    }
    i = i + 1;
  }
  if (has_quote && double_ok) {
    return "\"" + s + "\"";
  }
  let bs: u8[] = [];
  bs = bs.append(39 as u8);
  let open: boolean = true;
  let run: boolean = false;
  i = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (escapes && is_control_or_high(b)) {
      if (open) {
        bs = bs.append(39 as u8);
        open = false;
      }
      if (!run) {
        bs = bs.append(36 as u8);
        bs = bs.append(39 as u8);
        run = true;
      }
      bs = append_c_escape(bs, b);
      i = i + 1;
      continue;
    }
    if (run) {
      bs = bs.append(39 as u8);
      run = false;
    }
    if (b == 39) {
      if (open) {
        bs = bs.append(39 as u8);
      }
      bs = bs.append(92 as u8);
      bs = bs.append(39 as u8);
      bs = bs.append(39 as u8);
      open = true;
    } else {
      if (!open) {
        bs = bs.append(39 as u8);
        open = true;
      }
      bs = bs.append(b as u8);
    }
    i = i + 1;
  }
  if (run) {
    bs = bs.append(39 as u8);
  }
  if (open) {
    bs = bs.append(39 as u8);
  }
  return string_from_bytes_unchecked(bs);
}

pub function env_entry(entry: string, style: i32): string {
  let Some(eq) = entry.index_of("=") else {
    return quote_style(entry, style);
  };
  let name: string = quote_style(slice_unchecked(entry, 0, eq) + "", style);
  if (eq + 1 == entry.len()) {
    return name + "=";
  }
  return name + "=" + quote_style(slice_unchecked(entry, eq + 1, entry.len()) + "", style);
}

pub function block_bytes(): i32 {
  return 4096;
}

pub function out_new(): io_buffered.BufWriter {
  return io_buffered.buf_writer_new(stdout(), block_bytes());
}

pub function out_with(cap: i32): io_buffered.BufWriter {
  return io_buffered.buf_writer_new(stdout(), cap);
}

pub function put(o: io_buffered.BufWriter, s: string): io_buffered.BufWriter {
  return put_with(o, s, 1);
}

pub function put_bytes(o: io_buffered.BufWriter, bytes: u8[]): io_buffered.BufWriter {
  return put_bytes_with(o, bytes, 1);
}

pub function put_bytes_with(o: io_buffered.BufWriter, bytes: u8[], status: i32): io_buffered.BufWriter {
  let w: io_buffered.BufWriter = o.write_bytes(bytes);
  die_on_write_error(w, status);
  return w;
}

pub function put_with(o: io_buffered.BufWriter, s: string, status: i32): io_buffered.BufWriter {
  let w: io_buffered.BufWriter = o.write_string(s);
  die_on_write_error(w, status);
  return w;
}

pub function check(o: io_buffered.BufWriter): io_buffered.BufWriter {
  die_on_write_error(o, 1);
  return o;
}

pub function settle(o: io_buffered.BufWriter): io_buffered.BufWriter {
  let w: io_buffered.BufWriter = o.settle();
  die_on_write_error(w, 1);
  return w;
}

pub function flush(o: io_buffered.BufWriter): io_buffered.BufWriter {
  let w: io_buffered.BufWriter = o.flush();
  die_on_write_error(w, 1);
  return w;
}

pub function finish(o: io_buffered.BufWriter): void {
  close_stdout(o, false);
}

pub function finish_with(o: io_buffered.BufWriter, status: i32): void {
  close_stdout_with(o, false, status);
}

pub function close_stdout(o: io_buffered.BufWriter, prev_fail: boolean): void {
  close_stdout_with(o, prev_fail, 1);
}

pub function close_stdout_with(o: io_buffered.BufWriter, prev_fail: boolean, status: i32): void {
  let some_pending: boolean = o.buffered() > 0;
  let prev: boolean = prev_fail;
  match (o.error()) {
    Some(_) => {
      prev = true;
    },
    None => {}
  }
  if let Err(e) = o.close() {
    if (prev || some_pending || errno.of(e) != errno.EBADF) {
      error("write error: " + io_error_text(e));
      exit(status);
    }
  }
  if (prev) {
    error("write error");
    exit(status);
  }
}

function die_on_write_error(w: io_buffered.BufWriter, status: i32): void {
  match (w.error()) {
    Some(e) => {
      error("write error: " + io_error_text(e));
      exit(status);
    },
    None => {}
  }
}

pub struct Stdio { w: Writer, buf: u8[], cap: i32, alloc: boolean, err: Option[IoError] }

pub function stdio_new(): Stdio {
  let w: Writer = stdout();
  let cap: i32 = bufsiz();
  match (w.stat()) {
    Ok(st) => {
      if (st.blksize > 0 as i64 && st.blksize < bufsiz() as i64) {
        cap = st.blksize as i32;
      }
    },
    Err(_) => {}
  }
  return Stdio { w: w, buf: [], cap: cap, alloc: false, err: None };
}

function bufsiz(): i32 {
  return 8192;
}

pub function (s: Stdio) fwrite(data: string): Stdio {
  return xsputn(s, [], data, 0, data.len());
}

pub function (s: Stdio) fwrite_bytes(data: u8[]): Stdio {
  return xsputn(s, data, "", 0, data.len());
}

pub function (s: Stdio) fwrite_bytes_range(data: u8[], lo0: i32, hi0: i32): Stdio {
  let lo: i32 = lo0;
  let hi: i32 = hi0;
  if (lo < 0) {
    lo = 0;
  }
  if (hi > data.len()) {
    hi = data.len();
  }
  if (lo >= hi) {
    return s;
  }
  return xsputn(s, data, "", lo, hi);
}

function stdio_append_range(own pending: u8[], data: u8[], text: string, lo: i32, hi: i32): u8[] {
  if (text.len() == 0 && pending.len() == 0 && lo == 0 && hi == data.len()) {
    return data;
  }
  if (text.len() > 0 && pending.len() == 0 && lo == 0 && hi == text.len()) {
    return text.bytes();
  }
  if (hi - lo <= 128) {
    let i: i32 = lo;
    if (text.len() > 0) {
      while (i < hi) {
        pending = pending.append(text[i]);
        i = i + 1;
      }
    } else {
      while (i < hi) {
        pending = pending.append(data[i]);
        i = i + 1;
      }
    }
    return pending;
  }
  let h: usize = buf_new(pending.len() + hi - lo);
  buf_push_bytes_range(h, pending, 0, pending.len());
  if (text.len() > 0) {
    buf_push_range(h, text, lo, hi);
  } else {
    buf_push_bytes_range(h, data, lo, hi);
  }
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  return bytes;
}

pub function (s: Stdio) fflush(): Stdio {
  if (s.buf.len() == 0) {
    return s;
  }
  let r: Stdio = sys_write(s, s.buf);
  return Stdio { ...r, buf: [] };
}

pub function (s: Stdio) report(msg: string): Stdio {
  let flushed: Stdio = s.fflush();
  error(msg);
  return flushed;
}

pub function (s: Stdio) close_stdout(): void {
  let some_pending: boolean = s.buf.len() > 0;
  let prev_fail: boolean = false;
  match (s.err) {
    Some(_) => {
      prev_fail = true;
    },
    None => {}
  }
  let fclose_fail: boolean = false;
  let text: string = "";
  let errnum: i32 = 0;
  if (some_pending) {
    let r: Stdio = sys_write(s, s.buf);
    if (stdio_failed(r)) {
      fclose_fail = true;
      match (r.err) {
        Some(e) => {
          text = io_error_text(e);
          errnum = errno.of(e);
        },
        None => {}
      }
    }
  }
  if let Err(e) = s.w.close() {
    fclose_fail = true;
    text = io_error_text(e);
    errnum = errno.of(e);
  }
  if (prev_fail || fclose_fail && (some_pending || errnum != errno.EBADF)) {
    if (fclose_fail) {
      error("write error: " + text);
    } else {
      error("write error");
    }
    exit(1);
  }
}

function xsputn(s0: Stdio, data: u8[], text: string, lo: i32, hi: i32): Stdio {
  let s: Stdio = s0;
  let n: i32 = hi - lo;
  if (n == 0) {
    return s;
  }
  let pos: i32 = 0;
  let count: i32 = 0;
  if (s.alloc) {
    count = s.cap - s.buf.len();
  }
  if (count > 0) {
    if (count > n) {
      count = n;
    }
    s = Stdio { ...s, buf: stdio_append_range(s.buf, data, text, lo, lo + count) };
    pos = count;
  }
  if (pos < n) {
    let had_pending: boolean = s.buf.len() > 0;
    s = overflow(s);
    if (had_pending && stdio_failed(s)) {
      return s;
    }
    let to_do: i32 = n - pos;
    let do_write: i32 = to_do - to_do % s.cap;
    if (do_write > 0) {
      if (text.len() > 0) {
        let bytes: [u8] = text.as_bytes();
        s = sys_write(s, bytes[lo + pos:lo + pos + do_write]);
      } else {
        s = sys_write(s, data[lo + pos:lo + pos + do_write]);
      }
      if (stdio_failed(s)) {
        return s;
      }
      pos = pos + do_write;
    }
    if (pos < n) {
      s = Stdio { ...s, buf: stdio_append_range(s.buf, data, text, lo + pos, hi) };
    }
  }
  return s;
}

function overflow(s0: Stdio): Stdio {
  let s: Stdio = Stdio { ...s0, alloc: true };
  if (s.buf.len() == 0) {
    return s;
  }
  let r: Stdio = sys_write(s, s.buf);
  return Stdio { ...r, buf: [] };
}

function stdio_failed(s: Stdio): boolean {
  match (s.err) {
    Some(_) => {
      return true;
    },
    None => {
      return false;
    }
  }
}

function sys_write(s: Stdio, data: [u8]): Stdio {
  match (s.err) {
    Some(_) => {
      return s;
    },
    None => {}
  }
  match (s.w.write_bytes(data)) {
    Err(e) => {
      return Stdio { ...s, err: Some(e) };
    },
    Ok(_) => {
      return s;
    }
  }
}

function long_parts(a: string): (string, boolean) {
  let body: str = slice_unchecked(a, 2, a.len());
  if let Some(eq) = body.index_of("=") {
    return (slice_unchecked(body, 0, eq) + "", true);
  }
  return (body + "", false);
}

function print_help(help_text: string, status: i32, fail_status: i32): void {
  write_out_with(help_text, fail_status);
  exit(status);
}

function print_version(name: string, status: i32, fail_status: i32): void {
  write_out_with(name + " (Fern coreutils) " + version() + "\n", fail_status);
  exit(status);
}

pub struct Opt { short: i32, long: string, short_arg: i32, arg: i32, id: i32 }

pub function flag(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 0, arg: 0, id: id };
}

pub function valued(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 1, arg: 1, id: id };
}

pub function optional(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 2, arg: 2, id: id };
}

pub function optional_long(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 0, arg: 2, id: id };
}

pub function valued_optional_long(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 1, arg: 2, id: id };
}

function short_byte(short: string): i32 {
  if (short.len() == 0) {
    return 0;
  }
  return short[0] as i32;
}

pub struct OptMatch { id: i32, value: string, has_value: boolean, long_form: boolean }

pub struct Getopt { argv: string[], opts: Opt[], name: string, help: string, status: i32, fail: i32, in_order: boolean, report_operands: boolean, i: i32, cluster: string, operands: string[], past_dashdash: boolean, hint: string }

pub function help_id(): i32 {
  return 0 - 1;
}

pub function version_id(): i32 {
  return 0 - 2;
}

pub function getopt_new(argv: string[], opts: Opt[], name: string, help_text: string, status: i32): Getopt {
  let all: Opt[] = opts;
  all = all.append(flag("", "help", help_id()));
  all = all.append(flag("", "version", version_id()));
  let in_order: boolean = false;
  match (env("POSIXLY_CORRECT")) {
    Some(_) => {
      in_order = true;
    },
    None => {}
  }
  let empty: string[] = [];
  return Getopt { argv: argv, opts: all, name: name, help: help_text, status: status, fail: status, in_order: in_order, report_operands: false, i: 1, cluster: "", operands: empty, past_dashdash: false, hint: "" };
}

pub function (g: Getopt) exit_failure(status: i32): Getopt {
  return Getopt { ...g, fail: status };
}

pub function (g: Getopt) fault_hint(line: string): Getopt {
  return Getopt { ...g, hint: line };
}

function die_fault(g: Getopt, msg: string): void {
  error(msg);
  if (g.hint.len() > 0) {
    eprint(g.hint);
  }
  try_help(g.status);
}

pub function (g: Getopt) in_order(): Getopt {
  return Getopt { ...g, in_order: true };
}

pub function operand_id(): i32 {
  return 0 - 3;
}

pub function (g: Getopt) return_in_order(): Getopt {
  return Getopt { ...g, report_operands: true, in_order: false };
}

pub function (g: Getopt) next(): (Option[OptMatch], Getopt) {
  if (g.cluster.len() > 0) {
    return short_option(g);
  }
  while (g.i < g.argv.len()) {
    let a: string = g.argv[g.i];
    if (a == "--") {
      g = Getopt { ...g, i: g.i + 1 };
      return (None, take_rest(g));
    }
    if (!is_option(a)) {
      if (g.report_operands) {
        return (Some(OptMatch { id: operand_id(), value: a, has_value: true, long_form: false }), Getopt { ...g, i: g.i + 1 });
      }
      if (g.in_order) {
        return (None, take_rest(g));
      }
      g = Getopt { ...g, i: g.i + 1, operands: g.operands.append(a) };
      continue;
    }
    g = Getopt { ...g, i: g.i + 1 };
    if (a.starts_with("--")) {
      return long_option(g, a);
    }
    g = Getopt { ...g, cluster: slice_unchecked(a, 1, a.len()) + "" };
    return short_option(g);
  }
  return (None, g);
}

pub function (g: Getopt) operands(): string[] {
  return g.operands;
}

pub function (g: Getopt) next_argv_order(): (i32, OptMatch, Getopt) {
  let nil: OptMatch = OptMatch { id: 0, value: "", has_value: false, long_form: false };
  if (g.cluster.len() > 0) {
    let r: (Option[OptMatch], Getopt) = short_option(g);
    match (r.0) {
      Some(m) => {
        return (1, m, r.1);
      },
      None => {
        return (0, nil, r.1);
      }
    }
  }
  let s: Getopt = g;
  while (s.i < s.argv.len()) {
    let a: string = s.argv[s.i];
    if (!s.past_dashdash && a == "--") {
      s = Getopt { ...s, i: s.i + 1, past_dashdash: true };
      continue;
    }
    if (s.past_dashdash || !is_option(a)) {
      return (2, OptMatch { id: 0, value: a, has_value: true, long_form: false }, Getopt { ...s, i: s.i + 1 });
    }
    s = Getopt { ...s, i: s.i + 1 };
    if (a.starts_with("--")) {
      let rl: (Option[OptMatch], Getopt) = long_option(s, a);
      match (rl.0) {
        Some(m) => {
          return (1, m, rl.1);
        },
        None => {
          return (0, nil, rl.1);
        }
      }
    }
    s = Getopt { ...s, cluster: slice_unchecked(a, 1, a.len()) + "" };
    let rs: (Option[OptMatch], Getopt) = short_option(s);
    match (rs.0) {
      Some(m) => {
        return (1, m, rs.1);
      },
      None => {
        return (0, nil, rs.1);
      }
    }
  }
  return (0, nil, s);
}

pub function (g: Getopt) after_dashdash(): boolean {
  return g.past_dashdash;
}

pub function (g: Getopt) index(): i32 {
  return g.i;
}

pub function (g: Getopt) at_negative_number(): boolean {
  if (g.cluster.len() > 0 || g.i >= g.argv.len()) {
    return false;
  }
  let a: string = g.argv[g.i];
  if (a.len() < 2 || a[0] as i32 != 45) {
    return false;
  }
  let b: i32 = a[1] as i32;
  return b == 46 || b >= 48 && b <= 57;
}

pub function (g: Getopt) peek(): Option[string] {
  if (g.cluster.len() > 0 || g.i >= g.argv.len()) {
    return None;
  }
  return Some(g.argv[g.i]);
}

pub function (g: Getopt) advance(): Getopt {
  return Getopt { ...g, i: g.i + 1 };
}

pub function (g: Getopt) stop(): Getopt {
  return take_rest(g);
}

function take_rest(g: Getopt): Getopt {
  let ops: string[] = g.operands;
  let i: i32 = g.i;
  while (i < g.argv.len()) {
    ops = ops.append(g.argv[i]);
    i = i + 1;
  }
  return Getopt { ...g, i: i, operands: ops };
}

function short_option(g: Getopt): (Option[OptMatch], Getopt) {
  let b: i32 = g.cluster[0] as i32;
  let rest: string = slice_unchecked(g.cluster, 1, g.cluster.len()) + "";
  let k: i32 = 0;
  while (k < g.opts.len()) {
    if (g.opts[k].short == b) {
      break;
    }
    k = k + 1;
  }
  if (k == g.opts.len()) {
    die_fault(g, "invalid option -- '" + slice_unchecked(g.cluster, 0, 1) + "'");
  }
  let o: Opt = g.opts[k];
  if (o.id == help_id()) {
    print_help(g.help, 0, g.fail);
  }
  if (o.id == version_id()) {
    print_version(g.name, 0, g.fail);
  }
  if (o.short_arg == 0) {
    return (Some(OptMatch { id: o.id, value: "", has_value: false, long_form: false }), Getopt { ...g, cluster: rest });
  }
  if (o.short_arg == 2) {
    return (Some(OptMatch { id: o.id, value: rest, has_value: rest.len() > 0, long_form: false }), Getopt { ...g, cluster: "" });
  }
  if (rest.len() > 0) {
    return (Some(OptMatch { id: o.id, value: rest, has_value: true, long_form: false }), Getopt { ...g, cluster: "" });
  }
  if (g.i < g.argv.len()) {
    let v: string = g.argv[g.i];
    return (Some(OptMatch { id: o.id, value: v, has_value: true, long_form: false }), Getopt { ...g, cluster: "", i: g.i + 1 });
  }
  die_fault(g, "option requires an argument -- '" + slice_unchecked(g.cluster, 0, 1) + "'");
  return (None, g);
}

function long_option(g: Getopt, a: string): (Option[OptMatch], Getopt) {
  let parts: (string, boolean) = long_parts(a);
  let name: string = parts.0;
  let glued: boolean = parts.1;
  let value: string = "";
  if let Some(eq) = a.index_of("=") {
    if (glued) {
      value = slice_unchecked(a, eq + 1, a.len()) + "";
    }
  }
  let found: i32 = 0 - 1;
  let k: i32 = 0;
  while (k < g.opts.len()) {
    if (g.opts[k].long.len() > 0 && g.opts[k].long == name) {
      found = k;
      break;
    }
    k = k + 1;
  }
  if (found < 0) {
    let list: string = "";
    let ambiguous: boolean = false;
    k = 0;
    while (k < g.opts.len()) {
      let o: Opt = g.opts[k];
      if (o.long.len() > 0 && o.long.starts_with(name)) {
        if (found < 0) {
          found = k;
          list = " '--" + o.long + "'";
        } else if (o.arg != g.opts[found].arg || o.id != g.opts[found].id) {
          ambiguous = true;
          list = list + " '--" + o.long + "'";
        }
      }
      k = k + 1;
    }
    if (found < 0) {
      die_fault(g, "unrecognized option '" + a + "'");
    }
    if (ambiguous) {
      die_fault(g, "option '" + a + "' is ambiguous; possibilities:" + list);
    }
  }
  let o: Opt = g.opts[found];
  if (o.arg == 0 && glued) {
    die_fault(g, "option '--" + o.long + "' doesn't allow an argument");
  }
  let s: Getopt = g;
  let has: boolean = glued;
  if (o.arg == 1 && !glued) {
    if (s.i < s.argv.len()) {
      value = s.argv[s.i];
      has = true;
      s = Getopt { ...s, i: s.i + 1 };
    } else {
      die_fault(g, "option '--" + o.long + "' requires an argument");
    }
  }
  if (o.id == help_id()) {
    print_help(g.help, 0, g.fail);
  }
  if (o.id == version_id()) {
    print_version(g.name, 0, g.fail);
  }
  return (Some(OptMatch { id: o.id, value: value, has_value: has, long_form: true }), s);
}

pub function parse_standard_options_only(argv: string[], name: string, help_text: string, status: i32): string[] {
  let none: Opt[] = [];
  let g: Getopt = getopt_new(argv, none, name, help_text, status);
  while (true) {
    let r: (Option[OptMatch], Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(_) => {},
      None => {
        break;
      }
    }
  }
  return g.operands();
}

pub function sole_help_version(argv: string[], name: string, help_text: string, status: i32): void {
  sole_help_version_with(argv, name, help_text, status, 1);
}

pub function sole_help_version_with(argv: string[], name: string, help_text: string, status: i32, fail_status: i32): void {
  if (argv.len() != 2) {
    return;
  }
  if (argv[1] == "--help") {
    print_help(help_text, status, fail_status);
  }
  if (argv[1] == "--version") {
    print_version(name, status, fail_status);
  }
}

function is_slash(c: u8): boolean {
  return c as i32 == 47;
}

pub function base_name(s: string): string {
  let end: i32 = s.len();
  while (end > 0 && is_slash(s[end - 1])) {
    end = end - 1;
  }
  if (end == 0) {
    if (s.len() > 0) {
      return "/";
    }
    return "";
  }
  let start: i32 = end;
  while (start > 0 && !is_slash(s[start - 1])) {
    start = start - 1;
  }
  return slice_unchecked(s, start, end) + "";
}

pub function dir_name(s: string): string {
  let end: i32 = s.len();
  while (end > 0 && is_slash(s[end - 1])) {
    end = end - 1;
  }
  if (end == 0) {
    if (s.len() > 0) {
      return "/";
    }
    return ".";
  }
  let i: i32 = end;
  while (i > 0 && !is_slash(s[i - 1])) {
    i = i - 1;
  }
  if (i == 0) {
    return ".";
  }
  while (i > 0 && is_slash(s[i - 1])) {
    i = i - 1;
  }
  if (i == 0) {
    return "/";
  }
  return slice_unchecked(s, 0, i) + "";
}

pub function join_path(dir: string, name: string): string {
  if (dir.len() == 0) {
    return name;
  }
  let end: i32 = dir.len();
  while (end > 1 && is_slash(dir[end - 1])) {
    end = end - 1;
  }
  let head: string = slice_unchecked(dir, 0, end) + "";
  if (head.len() > 0 && is_slash(head[head.len() - 1])) {
    return head + name;
  }
  return head + "/" + name;
}

pub function strip_slashes(s: string): string {
  let end: i32 = s.len();
  while (end > 1 && is_slash(s[end - 1])) {
    end = end - 1;
  }
  return slice_unchecked(s, 0, end) + "";
}

function last_component_start(s: string): i32 {
  let i: i32 = 0;
  while (i < s.len() && is_slash(s[i])) {
    i = i + 1;
  }
  let last: i32 = i;
  let after_slash: boolean = false;
  while (i < s.len()) {
    if (is_slash(s[i])) {
      after_slash = true;
    } else if (after_slash) {
      last = i;
      after_slash = false;
    }
    i = i + 1;
  }
  return last;
}

pub function backup_none(): i32 {
  return 0;
}

pub function backup_simple(): i32 {
  return 1;
}

pub function backup_existing(): i32 {
  return 2;
}

pub function backup_numbered(): i32 {
  return 3;
}

pub function backup_names(): string[] {
  return ["none", "off", "simple", "never", "existing", "nil", "numbered", "t"];
}

pub function backup_values(): i32[] {
  return [backup_none(), backup_none(), backup_simple(), backup_simple(), backup_existing(), backup_existing(), backup_numbered(), backup_numbered()];
}

pub function usable_suffix(s: string): boolean {
  return s.len() > 0 && last_component_start(s) == 0;
}

function numbered_index(entry: string, name: string): i32 {
  let head: string = name + ".~";
  if (!entry.starts_with(head) || !entry.ends_with("~")) {
    return 0 - 1;
  }
  let start: i32 = head.len();
  let end: i32 = entry.len() - 1;
  if (end <= start) {
    return 0 - 1;
  }
  if (entry[start] as i32 == 48 && end - start > 1) {
    return 0 - 1;
  }
  let n: i32 = 0;
  let i: i32 = start;
  while (i < end) {
    if (!is_digit(entry[i] as i32)) {
      return 0 - 1;
    }
    n = n * 10 + (entry[i] as i32 - 48);
    i = i + 1;
  }
  return n;
}

function highest_numbered(dir: string, name: string): i32 {
  let best: i32 = 0 - 1;
  match (read_dir(dir)) {
    Ok(entries) => {
      let i: i32 = 0;
      while (i < entries.len()) {
        let n: i32 = numbered_index(entries[i], name);
        if (n > best) {
          best = n;
        }
        i = i + 1;
      }
    },
    Err(_) => {}
  }
  return best;
}

pub function backup_name(dest: string, control: i32, suffix: string): string {
  let c: i32 = control;
  if (c == backup_existing()) {
    if (highest_numbered(dir_name(dest), base_name(dest)) >= 0) {
      c = backup_numbered();
    } else {
      c = backup_simple();
    }
  }
  if (c == backup_numbered()) {
    let n: i32 = highest_numbered(dir_name(dest), base_name(dest));
    if (n < 0) {
      n = 0;
    }
    return dest + ".~" + (n + 1).to_string() + "~";
  }
  return dest + suffix;
}

pub function prompt(msg: string): boolean {
  let w: Writer = stderr();
  w.write(prog() + ": " + msg);
  return yesno();
}

pub function yesno(): boolean {
  match (io.read_line(stdin())) {
    Ok(Some(l)) => {
      return l.len() > 0 && (l[0] as i32 == 121 || l[0] as i32 == 89);
    },
    _ => {
      return false;
    }
  }
}

pub struct Exec { path: string, errno: i32 }

pub function exec_errno_text(n: i32): string {
  if (n == 2) {
    return "No such file or directory";
  }
  if (n == 8) {
    return "Exec format error";
  }
  if (n == 13) {
    return "Permission denied";
  }
  if (n == 20) {
    return "Not a directory";
  }
  if (n == 21) {
    return "Is a directory";
  }
  if (n == 22) {
    return "Invalid argument";
  }
  if (n == enametoolong_errno()) {
    return "File name too long";
  }
  if (n == eloop_errno()) {
    return "Too many levels of symbolic links";
  }
  return unknown_errno_text(n);
}

pub function enametoolong_errno(): i32 {
  if (target_os() == "darwin") {
    return 63;
  }
  return 36;
}

pub function eloop_errno(): i32 {
  if (target_os() == "darwin") {
    return 62;
  }
  return 40;
}

pub function unknown_errno_text(n: i32): string {
  if (target_os() == "darwin") {
    return "Unknown error: " + n.to_string();
  }
  return "Unknown error " + n.to_string();
}

pub function resolve_command(cmd: string, envp: string[]): Exec {
  if (cmd.len() == 0) {
    return Exec { path: "", errno: 2 };
  }
  if (cmd.contains("/")) {
    return Exec { path: cmd, errno: 0 };
  }
  let (path, found) = env_value(envp, "PATH");
  if (found) {
    if (path.len() == 0) {
      return Exec { path: "", errno: 2 };
    }
  } else if (target_os() == "darwin") {
    path = "/usr/bin:/bin";
  } else {
    path = "/bin:/usr/bin";
  }
  let best: i32 = 2;
  let start: i32 = 0;
  let j: i32 = 0;
  while (j <= path.len()) {
    if (j == path.len() || path[j] == b':') {
      let dir: string = slice_unchecked(path, start, j) + "";
      if (dir.len() == 0) {
        dir = ".";
      }
      let cand: string = dir + "/" + cmd;
      match (access(cand, 1)) {
        Ok(_) => {
          return Exec { path: cand, errno: 0 };
        },
        Err(e) => {
          if (errno.of(e) == errno.EACCES) {
            best = 13;
          }
        }
      }
      start = j + 1;
    }
    j = j + 1;
  }
  return Exec { path: "", errno: best };
}

pub function exec_command(cmd: string, argv: string[], envp: string[]): i32 {
  let f: Exec = resolve_command(cmd, envp);
  if (f.errno != 0) {
    return f.errno;
  }
  let rc: i32 = proc_exec_as(f.path, argv, envp);
  if (0 - rc != 8) {
    return 0 - rc;
  }
  let shell_argv: string[] = ["/bin/sh", f.path];
  let i: i32 = 1;
  while (i < argv.len()) {
    shell_argv = shell_argv.append(argv[i]);
    i = i + 1;
  }
  return 0 - proc_exec_as("/bin/sh", shell_argv, envp);
}

pub function env_value(envp: string[], name: string): (string, boolean) {
  let value: string = "";
  let found: boolean = false;
  let i: i32 = 0;
  while (i < envp.len()) {
    let entry: string = envp[i];
    if (entry.len() > name.len() && entry[name.len()] as i32 == 61 && starts_with_name(entry, name)) {
      value = slice_unchecked(entry, name.len() + 1, entry.len()) + "";
      found = true;
    }
    i = i + 1;
  }
  return (value, found);
}

function starts_with_name(entry: string, name: string): boolean {
  let i: i32 = 0;
  while (i < name.len()) {
    if (entry[i] != name[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}
