// coreutils/lib/gnu.fern — the conventions every utility in this
// directory shares with GNU coreutils.
//
// The utilities here are held to byte-for-byte parity with GNU
// coreutils on stdout, stderr and exit status (docs/COREUTILS.md), so
// the shapes below are not house style — each one is a GNU behaviour
// measured against the reference binary and then reproduced:
//
//   - Diagnostics are prefixed with argv[0] EXACTLY as invoked,
//     directories included: `/usr/bin/yes: invalid option -- 'x'`.
//     gnulib's set_program_name keeps the whole string, so a utility
//     that prints a basename diverges the moment it is run by path.
//   - A usage error prints one line naming the fault, then the
//     `Try '<argv[0]> --help' for more information.` line, and exits
//     with the utility's usage status (1 for most, 2 for sort/expr/…).
//     The full help text is NEVER printed on the error path.
//   - Options are glibc's getopt_long: long options match by unique
//     prefix (`--vers` is `--version`), operands are permuted out
//     unless POSIXLY_CORRECT is set, and every fault is worded as
//     glibc words it. `getopt_new` below is that emulation.
//
// Error TEXT is glibc's, not ours: the strings in `io_error_text`
// below are what `strerror` returns, because that is what GNU prints.
//
// Nothing here was copied from GNU sources; the behaviours were
// measured from the reference binaries and reimplemented.
import "std/string";
import "std/array";
import "std/io_buffered";

// `prog()` — the program name diagnostics are prefixed with: argv[0]
// verbatim (see the header). Empty when argv is empty, which only
// happens under an exec that passes no argv at all.
pub function prog(): string {
  var argv: string[] = args();
  if (argv.len() == 0) {
    return "";
  }
  return argv[0];
}

// `version()` — the version this build of the utilities reports.
//
// Deliberately NOT a GNU coreutils version: these are a different
// implementation, and claiming GNU's number would make the one output
// that identifies the program lie about which program it is.
pub function version(): string {
  return "0.1";
}

// `error(msg)` — one diagnostic line on stderr, GNU-prefixed.
pub function error(msg: string): void {
  eprint(prog() + ": " + msg);
}

// `error_out(o, msg)` — `error` with the buffered stdout flushed
// first, which is what gnulib's error() does. Without it a
// diagnostic overtakes the output written before it whenever both
// streams are the same pipe. Rebind: `o = gnu.error_out(o, msg);`.
pub function error_out(o: io_buffered.BufWriter, msg: string): io_buffered.BufWriter {
  var w: io_buffered.BufWriter = o.flush();
  error(msg);
  return w;
}

// `die(o, msg, status)` — a fatal diagnostic from a utility that
// buffers stdout: the message with the buffer flushed ahead of it, then
// gnulib's close_stdout, which is an atexit handler and so reports a
// failed output stream on the way out of an error path too — `comm
// --check-order` on a full disk says the order fault AND `write error`.
// Never returns.
pub function die(o: io_buffered.BufWriter, msg: string, status: i32): void {
  var w: io_buffered.BufWriter = error_out(o, msg);
  close_stdout_with(w, false, status);
  exit(status);
}

// `try_help(status)` — the trailing line of every usage error, then
// exit. Split out because a few utilities emit it with no preceding
// message of their own.
pub function try_help(status: i32): void {
  eprint("Try '" + prog() + " --help' for more information.");
  exit(status);
}

// `die_usage(msg, status)` — the whole usage-error path: the fault,
// the `Try …` line, exit.
pub function die_usage(msg: string, status: i32): void {
  error(msg);
  try_help(status);
}

// `argmatch(v, names, option)` — gnulib's ARGMATCH over a valued
// option: an exact name, or a unique prefix of one, gives its index.
// Anything else is the end of the program — `invalid` when the value
// is a prefix of nothing, `ambiguous` when it is a prefix of several
// (an empty value is a prefix of all of them) — with every valid name
// listed under it and the usual `Try …` line:
//
//     tee: ambiguous argument 'w' for '--output-error'
//     Valid arguments are:
//       - 'warn'
//       - 'warn-nopipe'
//       …
//
// `option` is the name with its dashes and no quotes; the list is
// printed in declaration order, which is the order it is passed in.
pub function argmatch(v: string, names: string[], option: string): i32 {
  return argmatch_valued(v, names, one_value_each(names.len()), option);
}

// `argmatch_valued(v, names, values, option)` — ARGMATCH over a table
// whose names carry VALUES, so several names can stand for one:
// rm's `--interactive` takes never / no / none for one and always /
// yes for another. A prefix matching only names that SHARE a value is
// then accepted rather than ambiguous (`--interactive=n` is never),
// and the list prints a run of equal-valued names on one line:
//
//     rm: invalid argument 'bogus' for '--interactive'
//     Valid arguments are:
//       - 'never', 'no', 'none'
//       - 'once'
//       - 'always', 'yes'
//
// Returns the VALUE rather than the index; `argmatch` above is this
// over a table where every name stands for itself.
pub function argmatch_valued(v: string, names: string[], values: i32[], option: string): i32 {
  var found: i32 = 0 - 1;
  var ambiguous: boolean = false;
  var i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == v) {
      return values[i];
    }
    if (names[i].starts_with(v)) {
      if (found < 0) {
        found = i;
      } else if (values[i] != values[found]) {
        ambiguous = true;
      }
    }
    i = i + 1;
  }
  if (found >= 0 && !ambiguous) {
    return values[found];
  }
  var what: string = "invalid";
  if (ambiguous) {
    what = "ambiguous";
  }
  return argmatch_die(v, names, values, option, what);
}

// `argmatch_exact(v, names, option)` — the same over an option that
// takes no abbreviations: `cksum -a md` is invalid where `--output-error=w`
// is a unique prefix. The failure is the same text, and there is no
// `ambiguous` half of it because only an exact name matches.
pub function argmatch_exact(v: string, names: string[], option: string): i32 {
  var i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == v) {
      return i;
    }
    i = i + 1;
  }
  return argmatch_die(v, names, one_value_each(names.len()), option, "invalid");
}

function argmatch_die(v: string, names: string[], values: i32[], option: string, what: string): i32 {
  error(what + " argument " + quote(v) + " for " + quote(option));
  eprint("Valid arguments are:");
  var i: i32 = 0;
  while (i < names.len()) {
    var line: string = "  - " + quote(names[i]);
    var j: i32 = i + 1;
    while (j < names.len() && values[j] == values[i]) {
      line = line + ", " + quote(names[j]);
      j = j + 1;
    }
    eprint(line);
    i = j;
  }
  try_help(1);
  return 0;
}

// The values of a table where no two names share one, so every name
// prints on its own line and a prefix of several is ambiguous.
function one_value_each(n: i32): i32[] {
  var out: i32[] = [];
  var i: i32 = 0;
  while (i < n) {
    out = out.append(i);
    i = i + 1;
  }
  return out;
}

// `is_option(a)` — whether getopt would treat `a` as an option token.
// A lone `-` is an operand (it names stdin); `--` is the terminator
// and is handled by the caller before this is asked.
pub function is_option(a: string): boolean {
  return a.len() >= 2 && a[0] as i32 == 45;
}

// `io_error_text(e)` — the strerror text GNU prints for an IoError.
//
// The kinds the runtime names carry no message of their own, so the
// mapping is by errno text; `Other` carries the runtime's own string,
// which is glibc's strerror text for the errno on every backend
// (internal/strerror).
pub function io_error_text(e: IoError): string {
  match (e) {
    NotFound(_) => {
      return "No such file or directory";
    },
    PermissionDenied(_) => {
      return "Permission denied";
    },
    AlreadyExists(_) => {
      return "File exists";
    },
    InvalidUtf8(_) => {
      return "Invalid or incomplete multibyte or wide character";
    },
    Interrupted => {
      return "Interrupted system call";
    },
    Unsupported => {
      return "Operation not supported";
    },
    Other(_, msg) => {
      return msg;
    }
  }
}

// `is_broken_pipe(e)` — whether `e` is EPIPE. An IoError carries the
// strerror text rather than the number, so the text is what there is
// to ask; `close_stdout` below reads `Bad file descriptor` the same
// way. Only reachable at all once SIGPIPE is ignored, since the
// default disposition kills the process instead.
pub function is_broken_pipe(e: IoError): boolean {
  return io_error_text(e) == "Broken pipe";
}

// `write_out(s)` — write `s` to stdout, reporting a failure the way
// GNU's close_stdout does (`prog: write error: <strerror>`) and
// exiting 1. For the paths where the utility has its own wording —
// yes(1) says `standard output:` — hold a Writer and check it there.
pub function write_out(s: string): void {
  write_out_with(s, 1);
}

// `write_out_with(s, status)` — `write_out` for a utility whose
// write-failure exit is not 1: gnulib's `exit_failure`, which test(1)
// sets to 2.
pub function write_out_with(s: string, status: i32): void {
  var w: Writer = stdout();
  match (w.write(s)) {
    Some(e) => {
      error("write error: " + io_error_text(e));
      exit(status);
    },
    None => {}
  }
}

// ---- counts ----------------------------------------------------------------
//
// The multiplier a gnulib suffix stands for, or None. `b` is 512 flat;
// every other letter is a power of 1024 bare or with `iB`, and of 1000
// with a bare `B`.
function suffix_power(c: i32): i32 {
  if (c == 75 || c == 107) {
    return 1;
  }
  if (c == 77) {
    return 2;
  }
  if (c == 71) {
    return 3;
  }
  if (c == 84) {
    return 4;
  }
  if (c == 80) {
    return 5;
  }
  if (c == 69) {
    return 6;
  }
  if (c == 90) {
    return 7;
  }
  if (c == 89) {
    return 8;
  }
  if (c == 82) {
    return 9;
  }
  if (c == 81) {
    return 10;
  }
  return 0;
}

pub function is_digit(c: i32): boolean {
  return c >= 48 && c <= 57;
}

pub function is_blank(c: i32): boolean {
  return c == 32 || c >= 9 && c <= 13;
}

// `parse_units(s)` — glibc's strtoumax over `s` followed by a gnulib
// multiplier suffix (xstrtoumax with "bkKmMGTPEZYRQ0"): leading blanks
// and a `+` are accepted, `1b` is 512, `1kB` is 1000 and `1KiB` is
// 1024. A suffix with NO digits in front of it is the number 1, which
// is gnulib's rule and not an oversight — `head -c b` is 512 bytes.
// Returns (value, status): 0 accepted, 1 nothing numeric at all, 2 the
// digits themselves past uintmax_t, 3 the suffix multiply past it, 4 a
// suffix that is not one (`1x`), which glibc reports separately from 1.
//
// The two overflows are separate because glibc's are: strtoumax sets
// ERANGE for 2 and leaves errno alone for 3, and tail's obsolete form
// prints the raw errno, so `-36028797018963968b` gets no strerror text
// while `-18446744073709551616b` gets `Numerical result out of range`.
// The two malformed codes are separate because od's are: `od -j x` is
// `invalid -j argument` and `od -j 1x` is `invalid suffix in -j
// argument`. A caller with one wording for each pair asks
// `count_malformed` and `count_overflow` rather than the numbers.
//
// `parse_number` is the same without the suffixes (xstrtoumax with ""),
// for tail's `--max-unchanged-stats` and `--pid`; with no suffix to
// multiply by it never returns 3, and a bare suffix is malformed there
// because there are no valid ones.
pub function parse_units(s: string): (u64, i32) {
  return parse_count(s, true);
}

pub function parse_number(s: string): (u64, i32) {
  return parse_count(s, false);
}

// Whether `c` starts a multiplier suffix, which is what lets a suffix
// with no digits in front of it stand for 1.
function is_suffix(c: i32): boolean {
  return c == 98 || suffix_power(c) > 0;
}

// `count_malformed(status)` — the two ways parse_units refuses a string
// as a number; `count_overflow` the two ways it refuses the value.
pub function count_malformed(status: i32): boolean {
  return status == 1 || status == 4;
}

pub function count_overflow(status: i32): boolean {
  return status == 2 || status == 3;
}

function parse_count(s: string, suffixes: boolean): (u64, i32) {
  var i: i32 = 0;
  while (i < s.len() && is_blank(s[i] as i32)) {
    i = i + 1;
  }
  if (i < s.len() && s[i] as i32 == 43) {
    i = i + 1;
  }
  var starts: boolean = i < s.len() && is_digit(s[i] as i32);
  if (!starts && !(suffixes && i < s.len() && is_suffix(s[i] as i32))) {
    return (0 as u64, 1);
  }
  var v: u64 = 1 as u64;
  if (starts) {
    v = 0 as u64;
  }
  var over: boolean = false;
  var digits_over: boolean = false;
  while (i < s.len() && is_digit(s[i] as i32)) {
    var d: u64 = (s[i] as i32 - 48) as u64;
    match (v.checked_mul(10 as u64)) {
      Some(m) => {
        match (m.checked_add(d)) {
          Some(a) => {
            v = a;
          },
          None => {
            digits_over = true;
          }
        }
      },
      None => {
        digits_over = true;
      }
    }
    i = i + 1;
  }
  var mul: u64 = 1 as u64;
  if (i < s.len() && suffixes) {
    var c: i32 = s[i] as i32;
    if (c == 98) {
      mul = 512 as u64;
      i = i + 1;
    } else {
      var p: i32 = suffix_power(c);
      if (p == 0) {
        return (0 as u64, 4);
      }
      i = i + 1;
      var base: u64 = 1024 as u64;
      if (i < s.len() && s[i] as i32 == 66) {
        base = 1000 as u64;
        i = i + 1;
      } else if (i + 1 < s.len() && s[i] as i32 == 105 && s[i + 1] as i32 == 66) {
        i = i + 2;
      }
      var k: i32 = 0;
      while (k < p) {
        match (mul.checked_mul(base)) {
          Some(m) => {
            mul = m;
          },
          None => {
            over = true;
          }
        }
        k = k + 1;
      }
    }
  }
  if (i != s.len()) {
    return (0 as u64, 4);
  }
  if (!over && !digits_over) {
    match (v.checked_mul(mul)) {
      Some(m) => {
        v = m;
      },
      None => {
        over = true;
      }
    }
  }
  if (digits_over) {
    return (0 as u64, 2);
  }
  if (over) {
    return (0 as u64, 3);
  }
  return (v, 0);
}

// `posix2_version()` — gnulib's: `_POSIX2_VERSION` in the environment
// when it is a whole strtol number, else 200809. Which POSIX a utility
// is asked for decides whether its obsolete syntax is still read:
// tail's `+N`, sort's `+POS`.
pub function posix2_version(): i64 {
  match (env("_POSIX2_VERSION")) {
    Some(v) => {
      match (strtol_all(v)) {
        Some(n) => {
          return n;
        },
        None => {}
      }
    },
    None => {}
  }
  return 200809 as i64;
}

// strtol over the whole string: leading blanks, a sign, digits and
// nothing after them; more than eighteen digits is out of range.
function strtol_all(s: string): Option[i64] {
  var i: i32 = 0;
  while (i < s.len() && is_blank(s[i] as i32)) {
    i = i + 1;
  }
  var neg: boolean = false;
  if (i < s.len() && (s[i] as i32 == 43 || s[i] as i32 == 45)) {
    neg = s[i] as i32 == 45;
    i = i + 1;
  }
  var v: i64 = 0 as i64;
  var digits: i32 = 0;
  while (i < s.len() && is_digit(s[i] as i32)) {
    v = v * (10 as i64) + (s[i] as i32 - 48) as i64;
    i = i + 1;
    digits = digits + 1;
  }
  if (digits == 0 || digits > 18 || i != s.len()) {
    return None;
  }
  if (neg) {
    return Some(0 as i64 - v);
  }
  return Some(v);
}

// `digit_option(argv)` — the digit byte a digit declared as an option
// stood for, for `option used in invalid context -- 5` (tail) and
// `invalid trailing option -- 5` (head). The scan reports the id only,
// so the tokens are re-read: a digit reaches this only as an option
// byte, which is always in a short cluster.
pub function digit_option(argv: string[]): string {
  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a.len() >= 2 && a[0] as i32 == 45) {
      var k: i32 = 1;
      while (k < a.len()) {
        if (is_digit(a[k] as i32)) {
          return slice_unchecked(a, k, k + 1) + "";
        }
        k = k + 1;
      }
    }
    i = i + 1;
  }
  return "0";
}

// ---- a streamed stdout ------------------------------------------------------
//
// `Stream` — the buffered stdout of a utility that copies input through
// (head, tail): the writer, whether anything has been written yet (the
// blank line between `==> NAME <==` headers), and whether any input
// failed.
pub struct Stream { w: io_buffered.BufWriter, first: boolean, ok: boolean }

pub function stream_new(): Stream {
  return Stream { w: out_new(), first: true, ok: true };
}

// gnulib's xwrite_stdout: a write that fails while the output is still
// STREAMING is reported as `error writing 'standard output'`, where a
// failure found only at the final flush is close_stdout's `write
// error:`. Which one a run gets is the stdio buffer: output under one
// block never reaches the fd until close.
pub function stream_put(o: Stream, s: string): Stream {
  var w: io_buffered.BufWriter = o.w.write_string(s);
  match (w.error()) {
    Some(e) => {
      error("error writing " + quotea("standard output") + ": " + io_error_text(e));
      exit(1);
    },
    None => {}
  }
  return Stream { ...o, w: w };
}

// One diagnostic, with the pending output flushed ahead of it and the
// exit status turned to 1.
pub function stream_fail(o: Stream, msg: string): Stream {
  return Stream { ...o, w: error_out(o.w, msg), ok: false };
}

// One `==> NAME <==` header, with the blank line every header after the
// first carries. A file that failed to OPEN never reaches this, so it
// does not consume the first-file slot.
pub function stream_header(o: Stream, name: string): Stream {
  var lead: string = "\n";
  if (o.first) {
    lead = "";
  }
  return Stream { ...stream_put(o, lead + "==> " + name + " <==\n"), first: false };
}

// `stream_flush(o)` — what is buffered goes out now; a failure is
// close_stdout's `write error:`.
pub function stream_flush(o: Stream): Stream {
  return Stream { ...o, w: flush(o.w) };
}

pub function stream_finish(o: Stream): void {
  finish(o.w);
}

// ---- quoting ---------------------------------------------------------------
//
// GNU quotes the strings it embeds in diagnostics, and two styles are
// visible in the C locale: `quote` wraps an operand in single quotes
// with C escapes (`extra operand 'c\nd'`), `quotef` renders a file name
// the way a shell would need it typed (`'no such': No such file or
// directory`, bare when nothing in it is special).
// `quote(s)` — `s` in single quotes; backslash and the quote itself
// backslashed, the seven named control characters as C escapes, and
// every other control or non-ASCII byte as three octal digits.
pub function quote(s: string): string {
  var bs: u8[] = [];
  bs = bs.append(39 as u8);
  var i: i32 = 0;
  while (i < s.len()) {
    var b: i32 = s[i] as i32;
    if (b == 92 || b == 39) {
      bs = bs.append(92 as u8);
      bs = bs.append(b as u8);
    } else if (b >= 32 && b < 127) {
      bs = bs.append(b as u8);
    } else {
      bs = append_c_escape(bs, b);
    }
    i = i + 1;
  }
  bs = bs.append(39 as u8);
  return string_from_bytes_unchecked(bs);
}

// One control or non-ASCII byte as a C escape: `\a \b \f \n \r \t \v`
// by name, anything else as `\NNN`.
function append_c_escape(out: u8[], b: i32): u8[] {
  var bs: u8[] = out.append(92 as u8);
  var named: i32 = c_escape_letter(b);
  if (named > 0) {
    return bs.append(named as u8);
  }
  bs = bs.append((48 + b / 64) as u8);
  bs = bs.append((48 + b / 8 % 8) as u8);
  return bs.append((48 + b % 8) as u8);
}

function c_escape_letter(b: i32): i32 {
  if (b == 7) {
    return 97;
  }
  if (b == 8) {
    return 98;
  }
  if (b == 12) {
    return 102;
  }
  if (b == 10) {
    return 110;
  }
  if (b == 13) {
    return 114;
  }
  if (b == 9) {
    return 116;
  }
  if (b == 11) {
    return 118;
  }
  return 0;
}

function is_control_or_high(b: i32): boolean {
  return b < 32 || b >= 127;
}

// Whether byte `b` makes a file name need quoting at all. `~` and `#`
// count only at the start of the name.
function shell_special(b: i32, leading: boolean): boolean {
  if (is_control_or_high(b)) {
    return true;
  }
  if (b == 126 || b == 35) {
    return leading;
  }
  return b == 32 || b == 39 || b == 34 || b == 92 || b == 36 || b == 42 || b == 59 || b == 61 || b == 58 || b == 33 || b == 63 || b == 91 || b == 40 || b == 41 || b == 38 || b == 124 || b == 60 || b == 62 || b == 96 || b == 94;
}

// Whether byte `b` rules out the double-quoted form. Not the same set
// as above: `:` and a space are fine inside double quotes, `{` and `}`
// are not, and `~` / `#` are the other way round from `shell_special`.
function double_quote_unsafe(b: i32, leading: boolean): boolean {
  if (is_control_or_high(b)) {
    return true;
  }
  if (b == 126 || b == 35) {
    return !leading;
  }
  return b == 34 || b == 92 || b == 36 || b == 96 || b == 33 || b == 42 || b == 63 || b == 91 || b == 40 || b == 41 || b == 38 || b == 124 || b == 60 || b == 62 || b == 59 || b == 61 || b == 94 || b == 123 || b == 125;
}

// `quotea(name)` — gnulib's quoteaf: `quotef` with the bare form
// quoted too, for the diagnostics that always show quotes
// (`head: cannot open 'plain' for reading`) rather than only when
// the name needs them (`wc: plain: No such file or directory`).
pub function quotea(s: string): string {
  var q: string = quotef(s);
  if (q == s) {
    return "'" + s + "'";
  }
  return q;
}

// `quotef(name)` — the file name as a shell would need it typed: bare
// when nothing in it is special, else single-quoted with a quote
// inside written `'\''` and every control or non-ASCII byte spliced
// in as an ANSI-C `$'...'` run. A name whose only trouble is the
// apostrophe goes in double quotes. Empty is `''`.
pub function quotef(s: string): string {
  if (s.len() == 0) {
    return "''";
  }
  var needs: boolean = false;
  var double_ok: boolean = true;
  var has_quote: boolean = false;
  var i: i32 = 0;
  while (i < s.len()) {
    var b: i32 = s[i] as i32;
    if (shell_special(b, i == 0)) {
      needs = true;
    }
    if (double_quote_unsafe(b, i == 0)) {
      double_ok = false;
    }
    if (b == 39) {
      has_quote = true;
    }
    i = i + 1;
  }
  if (!needs) {
    return s;
  }
  if (has_quote && double_ok) {
    return "\"" + s + "\"";
  }
  var bs: u8[] = [];
  bs = bs.append(39 as u8);
  var open: boolean = true;
  var run: boolean = false;
  i = 0;
  while (i < s.len()) {
    var b: i32 = s[i] as i32;
    if (is_control_or_high(b)) {
      if (open) {
        bs = bs.append(39 as u8);
        open = false;
      }
      if (!run) {
        bs = bs.append(36 as u8);
        bs = bs.append(39 as u8);
        run = true;
      }
      bs = append_c_escape(bs, b);
      i = i + 1;
      continue;
    }
    if (run) {
      bs = bs.append(39 as u8);
      run = false;
    }
    if (b == 39) {
      if (open) {
        bs = bs.append(39 as u8);
      }
      bs = bs.append(92 as u8);
      bs = bs.append(39 as u8);
      bs = bs.append(39 as u8);
      open = true;
    } else {
      if (!open) {
        bs = bs.append(39 as u8);
        open = true;
      }
      bs = bs.append(b as u8);
    }
    i = i + 1;
  }
  if (run) {
    bs = bs.append(39 as u8);
  }
  if (open) {
    bs = bs.append(39 as u8);
  }
  return string_from_bytes_unchecked(bs);
}

// ---- buffered stdout -------------------------------------------------------
//
// Output goes through a io_buffered.BufWriter, one write(2) per block, and a
// failure is reported the way gnulib's close_stdout reports it:
// `prog: write error: <strerror>`, exit 1. A utility that words it
// differently (yes: `standard output:`) holds its own Writer.
// The block size, measured rather than chosen (yes.fern has the
// sweep): the pipe optimum on Linux.
pub function block_bytes(): i32 {
  return 4096;
}

// `out_new()` — a buffered stdout; `out_with(cap)` picks the block.
pub function out_new(): io_buffered.BufWriter {
  return io_buffered.buf_writer_new(stdout(), block_bytes());
}

pub function out_with(cap: i32): io_buffered.BufWriter {
  return io_buffered.buf_writer_new(stdout(), cap);
}

// `put(o, s)` — buffer `s`; dies on the first failed flush. Rebind:
// `o = gnu.put(o, s);`.
pub function put(o: io_buffered.BufWriter, s: string): io_buffered.BufWriter {
  return put_with(o, s, 1);
}

// `put_with(o, s, status)` — `put` for a utility whose write-failure
// exit is not 1: gnulib's `exit_failure`, which expr(1) sets to 3.
pub function put_with(o: io_buffered.BufWriter, s: string, status: i32): io_buffered.BufWriter {
  var w: io_buffered.BufWriter = o.write_string(s);
  die_on_write_error(w, status);
  return w;
}

// `check(o)` — die if a write has failed, without writing anything. For a
// loop that pushes straight into the writer and asks once at the end rather
// than on every piece.
pub function check(o: io_buffered.BufWriter): io_buffered.BufWriter {
  die_on_write_error(o, 1);
  return o;
}

// `settle(o)` — the flush-if-full and the error check a loop that pushed
// straight into `o.handle()` owes at the end of a line.
pub function settle(o: io_buffered.BufWriter): io_buffered.BufWriter {
  var w: io_buffered.BufWriter = o.settle();
  die_on_write_error(w, 1);
  return w;
}

// `flush(o)` — write what is buffered now; dies like `put` when that
// fails. Rebind: `o = gnu.flush(o);`.
pub function flush(o: io_buffered.BufWriter): io_buffered.BufWriter {
  var w: io_buffered.BufWriter = o.flush();
  die_on_write_error(w, 1);
  return w;
}

// `finish(o)` — the end of the program: gnulib's close_stdout.
pub function finish(o: io_buffered.BufWriter): void {
  close_stdout(o, false);
}

// `finish_with(o, status)` — `finish` with gnulib's `exit_failure` set
// to something other than 1.
pub function finish_with(o: io_buffered.BufWriter, status: i32): void {
  close_stdout_with(o, false, status);
}

// `close_stdout(o, prev_fail)` — gnulib's close_stream on stdout, reported
// the way close_stdout reports it. `prev_fail` is the stream's error flag
// set by something other than a write here (glibc refusing a conversion).
// fclose failing with EBADF and nothing pending is not an error, so a
// utility that printed nothing to a closed stdout exits 0; a failure
// already on the stream is reported without strerror text unless fclose
// itself failed too.
pub function close_stdout(o: io_buffered.BufWriter, prev_fail: boolean): void {
  close_stdout_with(o, prev_fail, 1);
}

// `close_stdout_with(o, prev_fail, status)` — the same, exiting with
// gnulib's `exit_failure` rather than 1.
pub function close_stdout_with(o: io_buffered.BufWriter, prev_fail: boolean, status: i32): void {
  var some_pending: boolean = o.buffered() > 0;
  var prev: boolean = prev_fail;
  match (o.error()) {
    Some(_) => {
      prev = true;
    },
    None => {}
  }
  match (o.close()) {
    Some(e) => {
      var text: string = io_error_text(e);
      if (prev || some_pending || text != "Bad file descriptor") {
        error("write error: " + text);
        exit(status);
      }
    },
    None => {}
  }
  if (prev) {
    error("write error");
    exit(status);
  }
}

function die_on_write_error(w: io_buffered.BufWriter, status: i32): void {
  match (w.error()) {
    Some(e) => {
      error("write error: " + io_error_text(e));
      exit(status);
    },
    None => {}
  }
}

// ---- glibc's stdio, emulated -----------------------------------------------
//
// A utility that prints through stdio inherits one visible behaviour
// from glibc that a plain buffered writer does not reproduce: what
// close_stdout says when the output could not be written. `write error:
// No space left on device` names the errno when the flush fclose runs
// is what failed, and a bare `write error` reports a failure met
// earlier with nothing left pending at the close. Which one a run gets
// is decided by glibc's buffering algorithm — how much of a piece fits
// in the buffer, when the buffer is flushed, and that a failed flush
// drops the rest of the piece — so a utility reproduces the diagnostic
// by issuing the same fwrite / printf / putc calls GNU does against
// this emulation of that algorithm: `_IO_file_xsputn` for fwrite, fputs
// and putc, and `_IO_do_flush` for fflush.
//
// The buffer is BUFSIZ (8192) bytes, or st_blksize when fstat of the
// descriptor reports a smaller one, which every pipe, device and
// ordinary file on Linux does (4096); it is allocated at the first
// overflow, and a closed stdout fails the fstat and gets BUFSIZ. A
// write that fails is sticky: glibc retries every later flush and
// fails it again, and this stops issuing the syscall instead, which no
// diagnostic can tell apart.
//
// The pending bytes are grown inside the struct literal, as
// io_buffered's BufWriter grows its own: read into a local first and
// every append copies the whole buffer.
pub struct Stdio { w: Writer, buf: string, cap: i32, alloc: boolean, err: Option[IoError] }

pub function stdio_new(): Stdio {
  var w: Writer = stdout();
  var cap: i32 = bufsiz();
  match (w.stat()) {
    Ok(st) => {
      if (st.blksize > 0 as i64 && st.blksize < bufsiz() as i64) {
        cap = st.blksize as i32;
      }
    },
    Err(_) => {}
  }
  return Stdio { w: w, buf: "", cap: cap, alloc: false, err: None };
}

function bufsiz(): i32 {
  return 8192;
}

// `(s).fwrite(data)` — fwrite, fputs, putc: `_IO_file_xsputn`.
pub function (s: Stdio) fwrite(data: string): Stdio {
  return xsputn(s, data).0;
}

// `(s).fflush()` — write what is pending; nothing is allocated for an
// empty stream.
pub function (s: Stdio) fflush(): Stdio {
  if (s.buf.len() == 0) {
    return s;
  }
  var r: (Stdio, boolean) = sys_write(s, s.buf);
  return Stdio { ...r.0, buf: "" };
}

// `(s).report(msg)` — gnulib's error(): stdout flushed, then the
// diagnostic. Rebind: `s = s.report(msg);`.
pub function (s: Stdio) report(msg: string): Stdio {
  var flushed: Stdio = s.fflush();
  error(msg);
  return flushed;
}

// `(s).close_stdout()` — gnulib's close_stdout over close_stream:
// fclose, then `write error` with the errno when fclose failed and
// without one when only an earlier write had, and no error at all for
// a closed descriptor that had nothing pending and no earlier failure.
pub function (s: Stdio) close_stdout(): void {
  var some_pending: boolean = s.buf.len() > 0;
  var prev_fail: boolean = false;
  match (s.err) {
    Some(_) => {
      prev_fail = true;
    },
    None => {}
  }
  var fclose_fail: boolean = false;
  var text: string = "";
  if (some_pending) {
    var r: (Stdio, boolean) = sys_write(s, s.buf);
    if (!r.1) {
      fclose_fail = true;
      match (r.0.err) {
        Some(e) => {
          text = io_error_text(e);
        },
        None => {}
      }
    }
  }
  match (s.w.close()) {
    Some(e) => {
      fclose_fail = true;
      text = io_error_text(e);
    },
    None => {}
  }
  if (prev_fail || fclose_fail && (some_pending || text != "Bad file descriptor")) {
    if (fclose_fail) {
      error("write error: " + text);
    } else {
      error("write error");
    }
    exit(1);
  }
}

// `_IO_file_xsputn`: fill the buffer, flush it if that did not take
// everything, write whole blocks of what is left directly, and buffer
// the remainder. Returns the stream and how many bytes it took; a
// failed flush ends the write with the rest dropped.
function xsputn(s0: Stdio, data: string): (Stdio, i32) {
  var s: Stdio = s0;
  var n: i32 = data.len();
  if (n == 0) {
    return (s, 0);
  }
  var pos: i32 = 0;
  var count: i32 = 0;
  if (s.alloc) {
    count = s.cap - s.buf.len();
  }
  if (count > 0) {
    if (count > n) {
      count = n;
    }
    s = Stdio { ...s, buf: s.buf + slice_unchecked(data, 0, count) };
    pos = count;
  }
  if (pos < n) {
    var f: (Stdio, boolean) = overflow(s);
    s = f.0;
    if (!f.1) {
      return (s, pos);
    }
    var to_do: i32 = n - pos;
    var do_write: i32 = to_do - to_do % s.cap;
    if (do_write > 0) {
      var piece: string = data;
      if (do_write != n) {
        piece = slice_unchecked(data, pos, pos + do_write) + "";
      }
      var w: (Stdio, boolean) = sys_write(s, piece);
      s = w.0;
      if (!w.1) {
        return (s, pos);
      }
      pos = pos + do_write;
    }
    if (pos < n) {
      s = Stdio { ...s, buf: s.buf + slice_unchecked(data, pos, n) };
    }
  }
  return (s, n);
}

// `_IO_OVERFLOW(EOF)`: allocate the buffer on first use and write what
// it holds. The buffer is empty afterwards whether or not the write
// succeeded, as `new_do_write` leaves it.
function overflow(s0: Stdio): (Stdio, boolean) {
  var s: Stdio = Stdio { ...s0, alloc: true };
  if (s.buf.len() == 0) {
    return (s, true);
  }
  var r: (Stdio, boolean) = sys_write(s, s.buf);
  return (Stdio { ...r.0, buf: "" }, r.1);
}

// One write(2), never retried once the stream has failed.
function sys_write(s: Stdio, data: string): (Stdio, boolean) {
  match (s.err) {
    Some(_) => {
      return (s, false);
    },
    None => {}
  }
  match (s.w.write(data)) {
    Some(e) => {
      return (Stdio { ...s, err: Some(e) }, false);
    },
    None => {
      return (s, true);
    }
  }
}

// The long-option name in `a` (`--name` or `--name=value`), plus
// whether a value was glued on.
function long_parts(a: string): (string, boolean) {
  var body: str = slice_unchecked(a, 2, a.len());
  var eq: i32 = body.index_of("=");
  if (eq >= 0) {
    return (slice_unchecked(body, 0, eq) + "", true);
  }
  return (body + "", false);
}

// `print_help` / `print_version` — the two outputs every utility
// shares. `status` is the exit code: 0 for most, but true(1) and
// false(1) exit with THEIR status even from `--help`. `fail_status`
// is the exit code when the write fails: 1, or the utility's own
// `exit_failure` (test(1) sets 2).
function print_help(help_text: string, status: i32, fail_status: i32): void {
  write_out_with(help_text, fail_status);
  exit(status);
}

function print_version(name: string, status: i32, fail_status: i32): void {
  write_out_with(name + " (Fern coreutils) " + version() + "\n", fail_status);
  exit(status);
}

// ---- getopt_long ---------------------------------------------------------
//
// glibc's getopt_long, as the utilities observe it. One option is an
// `Opt`; a utility declares its own in the order GNU declares them,
// because that order is visible: the ambiguity list prints candidates
// in declaration order, and `--help` / `--version` come LAST (so
// `sort --v` lists '--version-sort' before '--version'). The two
// standard options are appended by `getopt_new`, never declared.
//
// The scan is a cursor (docs/CURSOR-IDIOM.md): `next()` hands back one
// option at a time, so a utility validates each value in argv order
// exactly as the C loop does, and `head -n5x --foo` complains about
// the count before it ever sees `--foo`. Operands are permuted out
// unless POSIXLY_CORRECT is set (or `in_order()` was asked for), in
// which case the first operand ends the options; `return_in_order()`
// hands them back interleaved instead. Every fault exits through
// `die_usage` with the utility's usage status.
//
// Short options: a cluster `-abc` is consumed byte by byte; an
// unknown byte is `invalid option -- 'x'`. A required value is the
// rest of the cluster if any (`-n5`), else the NEXT argv token
// whatever it looks like (`-n -5`, `-n --`), else `option requires
// an argument -- 'n'`. A short optional value is only ever the rest of
// the cluster. Long options match by unique prefix with an exact match
// winning; a glued `=value` is the value, or a fault for an option
// that takes none.
// `Opt` — one declared option. `short` is the option byte (0 for a
// long-only option), `long` the name without dashes ("" for a
// short-only one), `id` the tag `next()` reports it as. The two
// spellings carry their arity separately — `short_arg` and `arg`,
// each 0 / 1 / 2 for none / required / optional — because glibc keeps
// two tables: the `short_options` string and the `struct option`
// array. `tail` declares plain `f` in the first and
// `{"follow", optional_argument}` in the second, so `-fname` is `-f`
// followed by `-n ame` while `--follow=name` carries a value.
pub struct Opt { short: i32, long: string, short_arg: i32, arg: i32, id: i32 }

// `flag(short, long, id)` — an option taking no value; `valued` takes
// a required one; `optional` takes one only when glued (`-cX`,
// `--color=X`), in both spellings. `optional_long` is the split shape
// above: nothing after the short letter, an optional `=value` after
// the long name. `short` is "" or a single byte.
pub function flag(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 0, arg: 0, id: id };
}

pub function valued(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 1, arg: 1, id: id };
}

pub function optional(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 2, arg: 2, id: id };
}

pub function optional_long(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 0, arg: 2, id: id };
}

// `valued_optional_long(short, long, id)` — the other split shape, od's
// `-S`: the short spelling REQUIRES a value and the long one takes it
// only when glued, so `od -S 3 f` reads the 3 and `od --strings f`
// takes the default.
pub function valued_optional_long(short: string, long: string, id: i32): Opt {
  return Opt { short: short_byte(short), long: long, short_arg: 1, arg: 2, id: id };
}

function short_byte(short: string): i32 {
  if (short.len() == 0) {
    return 0;
  }
  return short[0] as i32;
}

// `OptMatch` — one option occurrence: its `id`, and the value when
// the option took one. `has_value` separates "no value" from an
// empty one for the `optional` shape, and `long_form` says which
// spelling was typed: gnulib's xstrtol_fatal names the option the way
// it was written, so `-S x` and `--buffer-size=x` word the same fault
// differently.
pub struct OptMatch { id: i32, value: string, has_value: boolean, long_form: boolean }

// `Getopt` — the scan state. `cluster` is what is left of a short
// cluster still being consumed (without its dash); `operands` are
// the tokens permuted out so far.
pub struct Getopt { argv: string[], opts: Opt[], name: string, help: string, status: i32, fail: i32, in_order: boolean, report_operands: boolean, i: i32, cluster: string, operands: string[], past_dashdash: boolean, hint: string }

// The ids `next()` reserves for the two standard options; they never
// reach the caller because `next()` answers them itself. They are public
// so a utility can declare a SHORT spelling of one: mktemp's `-V` is a
// live alias for `--version` that its `--help` does not mention.
pub function help_id(): i32 {
  return 0 - 1;
}

pub function version_id(): i32 {
  return 0 - 2;
}

// `getopt_new(argv, opts, name, help_text, status)` — start a scan.
// `status` is the utility's usage-error exit code.
pub function getopt_new(argv: string[], opts: Opt[], name: string, help_text: string, status: i32): Getopt {
  var all: Opt[] = opts;
  all = all.append(flag("", "help", help_id()));
  all = all.append(flag("", "version", version_id()));
  var in_order: boolean = false;
  match (env("POSIXLY_CORRECT")) {
    Some(_) => {
      in_order = true;
    },
    None => {}
  }
  var empty: string[] = [];
  return Getopt { argv: argv, opts: all, name: name, help: help_text, status: status, fail: status, in_order: in_order, report_operands: false, i: 1, cluster: "", operands: empty, past_dashdash: false, hint: "" };
}

// `(g).exit_failure(status)` — gnulib's initialize_exit_failure: the
// code a FAILED WRITE exits with, where `status` above is the code a
// usage error exits with. They are the same number for almost every
// utility, because gnulib calls usage() with exit_failure — but tty(1)
// sets exit_failure to 3 and refuses a bad option with 2, so its
// `--help > /dev/full` exits 3 where `tty -x` exits 2.
pub function (g: Getopt) exit_failure(status: i32): Getopt {
  return Getopt { ...g, fail: status };
}

// `(g).fault_hint(line)` — an extra line printed between a getopt
// fault and the `Try …` line. rm(1) is the only caller: any of its
// getopt faults is followed by `Try 'rm ./-x' to remove the file
// '-x'.` when an argv element that looks like an option names an
// existing file, on the theory that the typo was a file name.
pub function (g: Getopt) fault_hint(line: string): Getopt {
  return Getopt { ...g, hint: line };
}

// A fault raised by the scan itself, as against a utility's own
// usage error: the hint above sits between the message and `Try …`.
function die_fault(g: Getopt, msg: string): void {
  error(msg);
  if (g.hint.len() > 0) {
    eprint(g.hint);
  }
  try_help(g.status);
}

// `(g).in_order()` — stop at the first operand regardless of
// POSIXLY_CORRECT: the `+` optstring prefix of env(1), nice(1),
// timeout(1) and the other command runners.
pub function (g: Getopt) in_order(): Getopt {
  return Getopt { ...g, in_order: true };
}

// `operand_id()` — the id `next()` reports an operand under after
// `return_in_order()`; the token is the match's value.
pub function operand_id(): i32 {
  return 0 - 3;
}

// `(g).return_in_order()` — the `-` optstring prefix of uniq(1) and
// sort(1): every operand is handed back by `next()` as `operand_id()` in
// argv order instead of being permuted out, and POSIXLY_CORRECT no
// longer ends the scan, because glibc lets the prefix outrank it. A
// utility asks for this when an operand's MEANING depends on what came
// before it — uniq's `+N` is a skip-chars count until a file operand has
// been seen and a file name after that, and sort's `-k` spans are
// positional against the files around them — and stops the scan itself
// with `stop()`.
pub function (g: Getopt) return_in_order(): Getopt {
  return Getopt { ...g, report_operands: true, in_order: false };
}

// `(g).next()` — the next option, or None once the options are
// exhausted; rebind the cursor: `var (m, g) = g.next();`.
pub function (g: Getopt) next(): (Option[OptMatch], Getopt) {
  if (g.cluster.len() > 0) {
    return short_option(g);
  }
  while (g.i < g.argv.len()) {
    var a: string = g.argv[g.i];
    if (a == "--") {
      g = Getopt { ...g, i: g.i + 1 };
      return (None, take_rest(g));
    }
    if (!is_option(a)) {
      if (g.report_operands) {
        return (Some(OptMatch { id: operand_id(), value: a, has_value: true, long_form: false }), Getopt { ...g, i: g.i + 1 });
      }
      if (g.in_order) {
        return (None, take_rest(g));
      }
      // Appended through the parameter itself so the operand list grows
      // in place; a copy of the cursor as the root copies the list on
      // every operand, which is quadratic in argv.
      g = Getopt { ...g, i: g.i + 1, operands: g.operands.append(a) };
      continue;
    }
    g = Getopt { ...g, i: g.i + 1 };
    if (a.starts_with("--")) {
      return long_option(g, a);
    }
    g = Getopt { ...g, cluster: slice_unchecked(a, 1, a.len()) + "" };
    return short_option(g);
  }
  return (None, g);
}

// `(g).operands()` — every operand, in argv order, once `next()` has
// returned None.
pub function (g: Getopt) operands(): string[] {
  return g.operands;
}

// `(g).next_argv_order()` — glibc's `-` optstring prefix
// (RETURN_IN_ORDER): an OPERAND is reported where it stands rather
// than collected, so a utility whose operands and option arguments are
// ambiguous can decide between them in place. Returns (kind, m, g):
// kind 0 the scan is over, 1 an option in `m`, 2 an operand in
// `m.value`. join(1) is the caller — `join -o 1.1 2.2 f1 f2` gives -o
// two arguments, and only the count of what follows says so.
pub function (g: Getopt) next_argv_order(): (i32, OptMatch, Getopt) {
  var nil: OptMatch = OptMatch { id: 0, value: "", has_value: false, long_form: false };
  if (g.cluster.len() > 0) {
    var r: (Option[OptMatch], Getopt) = short_option(g);
    match (r.0) {
      Some(m) => {
        return (1, m, r.1);
      },
      None => {
        return (0, nil, r.1);
      }
    }
  }
  var s: Getopt = g;
  while (s.i < s.argv.len()) {
    var a: string = s.argv[s.i];
    if (!s.past_dashdash && a == "--") {
      s = Getopt { ...s, i: s.i + 1, past_dashdash: true };
      continue;
    }
    if (s.past_dashdash || !is_option(a)) {
      return (2, OptMatch { id: 0, value: a, has_value: true, long_form: false }, Getopt { ...s, i: s.i + 1 });
    }
    s = Getopt { ...s, i: s.i + 1 };
    if (a.starts_with("--")) {
      var rl: (Option[OptMatch], Getopt) = long_option(s, a);
      match (rl.0) {
        Some(m) => {
          return (1, m, rl.1);
        },
        None => {
          return (0, nil, rl.1);
        }
      }
    }
    s = Getopt { ...s, cluster: slice_unchecked(a, 1, a.len()) + "" };
    var rs: (Option[OptMatch], Getopt) = short_option(s);
    match (rs.0) {
      Some(m) => {
        return (1, m, rs.1);
      },
      None => {
        return (0, nil, rs.1);
      }
    }
  }
  return (0, nil, s);
}

// `(g).after_dashdash()` — whether the scan has passed `--`, after
// which every token is an operand and nothing can still be an option
// argument.
pub function (g: Getopt) after_dashdash(): boolean {
  return g.past_dashdash;
}

// `(g).index()` — the argv cursor, one past the token just consumed.
// join(1) reads it back to tell `-j1 N` from `-j 1`: only the glued
// spelling is the obsolete option.
pub function (g: Getopt) index(): i32 {
  return g.i;
}

// `(g).at_negative_number()` — whether the next token is `-N` or
// `-.N`. seq(1) ends its option scan there, so a negative first
// operand needs no `--`; the check is made between tokens, as GNU's
// is, so `-w5` is still the option `-w` followed by an invalid `5`.
pub function (g: Getopt) at_negative_number(): boolean {
  if (g.cluster.len() > 0 || g.i >= g.argv.len()) {
    return false;
  }
  var a: string = g.argv[g.i];
  if (a.len() < 2 || a[0] as i32 != 45) {
    return false;
  }
  var b: i32 = a[1] as i32;
  return b == 46 || b >= 48 && b <= 57;
}

// `(g).peek()` — the argv token the cursor is on, or None at the end,
// and `(g).advance()` consumes it. Together they are getopt's
// `argv[optind]` / `optind++`, which sort(1) reads directly: the
// obsolete `+POS -POS` takes its second half off argv rather than
// through the scan, so `-2` there is a key end and not
// `invalid option -- '2'`.
pub function (g: Getopt) peek(): Option[string] {
  if (g.cluster.len() > 0 || g.i >= g.argv.len()) {
    return None;
  }
  return Some(g.argv[g.i]);
}

pub function (g: Getopt) advance(): Getopt {
  return Getopt { ...g, i: g.i + 1 };
}

// `(g).stop()` — end the scan: every remaining token is an operand.
pub function (g: Getopt) stop(): Getopt {
  return take_rest(g);
}

// Everything from the cursor on is an operand.
function take_rest(g: Getopt): Getopt {
  var ops: string[] = g.operands;
  var i: i32 = g.i;
  while (i < g.argv.len()) {
    ops = ops.append(g.argv[i]);
    i = i + 1;
  }
  return Getopt { ...g, i: i, operands: ops };
}

function short_option(g: Getopt): (Option[OptMatch], Getopt) {
  var b: i32 = g.cluster[0] as i32;
  var rest: string = slice_unchecked(g.cluster, 1, g.cluster.len()) + "";
  var k: i32 = 0;
  while (k < g.opts.len()) {
    if (g.opts[k].short == b) {
      break;
    }
    k = k + 1;
  }
  if (k == g.opts.len()) {
    die_fault(g, "invalid option -- '" + slice_unchecked(g.cluster, 0, 1) + "'");
  }
  var o: Opt = g.opts[k];
  // A short spelling of --help / --version is answered here exactly as
  // the long one is, so it short-circuits the rest of the cluster:
  // `mktemp -Vx` prints the version rather than reaching the invalid x.
  if (o.id == help_id()) {
    print_help(g.help, 0, g.fail);
  }
  if (o.id == version_id()) {
    print_version(g.name, 0, g.fail);
  }
  if (o.short_arg == 0) {
    return (Some(OptMatch { id: o.id, value: "", has_value: false, long_form: false }), Getopt { ...g, cluster: rest });
  }
  if (o.short_arg == 2) {
    return (Some(OptMatch { id: o.id, value: rest, has_value: rest.len() > 0, long_form: false }), Getopt { ...g, cluster: "" });
  }
  if (rest.len() > 0) {
    return (Some(OptMatch { id: o.id, value: rest, has_value: true, long_form: false }), Getopt { ...g, cluster: "" });
  }
  if (g.i < g.argv.len()) {
    var v: string = g.argv[g.i];
    return (Some(OptMatch { id: o.id, value: v, has_value: true, long_form: false }), Getopt { ...g, cluster: "", i: g.i + 1 });
  }
  die_fault(g, "option requires an argument -- '" + slice_unchecked(g.cluster, 0, 1) + "'");
  return (None, g);
}

function long_option(g: Getopt, a: string): (Option[OptMatch], Getopt) {
  var parts: (string, boolean) = long_parts(a);
  var name: string = parts.0;
  var glued: boolean = parts.1;
  var value: string = "";
  if (glued) {
    var eq: i32 = a.index_of("=");
    value = slice_unchecked(a, eq + 1, a.len()) + "";
  }
  var found: i32 = 0 - 1;
  var k: i32 = 0;
  while (k < g.opts.len()) {
    if (g.opts[k].long.len() > 0 && g.opts[k].long == name) {
      found = k;
      break;
    }
    k = k + 1;
  }
  if (found < 0) {
    // The list is not every prefix match: glibc compares each later
    // candidate against the FIRST one and names only those that differ,
    // plus that first one. Two spellings of the same option therefore
    // make no ambiguity and only one of them is listed — `tty --=x`
    // names `--silent` and not `--quiet`, and `rmdir --p` is `--parents`
    // even though `--path` matches it too.
    var list: string = "";
    var ambiguous: boolean = false;
    k = 0;
    while (k < g.opts.len()) {
      var o: Opt = g.opts[k];
      if (o.long.len() > 0 && o.long.starts_with(name)) {
        // glibc lists the FIRST prefix match plus every later one that
        // differs from it, so an alias sharing the first one's arity
        // and value is left out: dircolors' `--=x` names seven of its
        // eight long options, and the missing one is `--sh`, which is
        // `--bourne-shell` under another spelling. (glibc also compares
        // the option's flag pointer; nothing here has one.)
        if (found < 0) {
          found = k;
          // The first match starts the list; `list` is still empty here.
          list = " '--" + o.long + "'";
        } else if (o.arg != g.opts[found].arg || o.id != g.opts[found].id) {
          ambiguous = true;
          list = list + " '--" + o.long + "'";
        }
      }
      k = k + 1;
    }
    if (found < 0) {
      die_fault(g, "unrecognized option '" + a + "'");
    }
    if (ambiguous) {
      die_fault(g, "option '" + a + "' is ambiguous; possibilities:" + list);
    }
  }
  var o: Opt = g.opts[found];
  if (o.arg == 0 && glued) {
    die_fault(g, "option '--" + o.long + "' doesn't allow an argument");
  }
  var s: Getopt = g;
  var has: boolean = glued;
  if (o.arg == 1 && !glued) {
    if (s.i < s.argv.len()) {
      value = s.argv[s.i];
      has = true;
      s = Getopt { ...s, i: s.i + 1 };
    } else {
      die_fault(g, "option '--" + o.long + "' requires an argument");
    }
  }
  // The write-failure status is the utility's own `exit_failure`, which
  // is the usage-error status for almost everything here — gnulib calls
  // usage() with exit_failure, so printenv's 2 is both and head's 1 is
  // both — and `exit_failure()` above is how the two that differ say so.
  if (o.id == help_id()) {
    print_help(g.help, 0, g.fail);
  }
  if (o.id == version_id()) {
    print_version(g.name, 0, g.fail);
  }
  return (Some(OptMatch { id: o.id, value: value, has_value: has, long_form: true }), s);
}

// `parse_standard_options_only(argv, name, help_text, status)` —
// gnulib's parse_gnu_standard_options_only, for a utility whose ONLY
// options are `--help` and `--version`: the scan above with nothing
// declared, so an option is found wherever it stands until `--`
// (`yes x --help` prints the help) and every other token is an
// operand. Returns the operands in argv order.
pub function parse_standard_options_only(argv: string[], name: string, help_text: string, status: i32): string[] {
  var none: Opt[] = [];
  var g: Getopt = getopt_new(argv, none, name, help_text, status);
  while (true) {
    var r: (Option[OptMatch], Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(_) => {},
      None => {
        break;
      }
    }
  }
  return g.operands();
}

// `sole_help_version(argv, name, help_text, status)` — the narrower
// rule true(1), false(1) and echo(1) use: `--help` and `--version`
// are honoured only as the SOLE argument, spelled in full, and are
// ordinary operands otherwise. `true --help x` therefore exits 0 in
// silence, and `echo --help x` prints `--help x`.
pub function sole_help_version(argv: string[], name: string, help_text: string, status: i32): void {
  sole_help_version_with(argv, name, help_text, status, 1);
}

// `sole_help_version_with(argv, name, help_text, status, fail_status)`
// — the same, exiting `fail_status` rather than 1 when the write
// fails: `[ --help` reports a closed stdout with test's own 2.
pub function sole_help_version_with(argv: string[], name: string, help_text: string, status: i32, fail_status: i32): void {
  if (argv.len() != 2) {
    return;
  }
  if (argv[1] == "--help") {
    print_help(help_text, status, fail_status);
  }
  if (argv[1] == "--version") {
    print_version(name, status, fail_status);
  }
}

// ---- file names ------------------------------------------------------------
//
// gnulib's name splitting, which is not the shell's: trailing slashes
// belong to the component they follow, so `base_name("x/")` is `x` and
// `dir_name("x/y/")` is `x`.
function is_slash(c: u8): boolean {
  return c as i32 == 47;
}

// `base_name(s)` — the last component of `s`, trailing slashes dropped.
// A name that is nothing but slashes is `/`, and the empty name stays
// empty.
pub function base_name(s: string): string {
  var end: i32 = s.len();
  while (end > 0 && is_slash(s[end - 1])) {
    end = end - 1;
  }
  if (end == 0) {
    if (s.len() > 0) {
      return "/";
    }
    return "";
  }
  var start: i32 = end;
  while (start > 0 && !is_slash(s[start - 1])) {
    start = start - 1;
  }
  return slice_unchecked(s, start, end) + "";
}

// `dir_name(s)` — everything before `base_name`'s component, `.` when
// there is none.
pub function dir_name(s: string): string {
  var end: i32 = s.len();
  while (end > 0 && is_slash(s[end - 1])) {
    end = end - 1;
  }
  if (end == 0) {
    if (s.len() > 0) {
      return "/";
    }
    return ".";
  }
  var i: i32 = end;
  while (i > 0 && !is_slash(s[i - 1])) {
    i = i - 1;
  }
  if (i == 0) {
    return ".";
  }
  while (i > 0 && is_slash(s[i - 1])) {
    i = i - 1;
  }
  if (i == 0) {
    return "/";
  }
  return slice_unchecked(s, 0, i) + "";
}

// `join_path(dir, name)` — the two joined with exactly ONE slash
// however many the directory ends with: `ln -t 'd///' s/f` makes `d/f`,
// not `d///f`.
pub function join_path(dir: string, name: string): string {
  var end: i32 = dir.len();
  while (end > 1 && is_slash(dir[end - 1])) {
    end = end - 1;
  }
  var head: string = slice_unchecked(dir, 0, end) + "";
  if (head.len() > 0 && is_slash(head[head.len() - 1])) {
    return head + name;
  }
  return head + "/" + name;
}

// `strip_slashes(s)` — `s` with its trailing slashes removed, which is
// what `mv --strip-trailing-slashes` does to each source operand. A
// name that is nothing but slashes keeps one, so `//` is `/`.
pub function strip_slashes(s: string): string {
  var end: i32 = s.len();
  while (end > 1 && is_slash(s[end - 1])) {
    end = end - 1;
  }
  return slice_unchecked(s, 0, end) + "";
}

// Where `s`'s last component starts — gnulib's last_component, which is
// NOT `base_name`: trailing slashes belong to the component here, so
// `x/`'s last component is `x/` and `/`'s is empty.
function last_component_start(s: string): i32 {
  var i: i32 = 0;
  while (i < s.len() && is_slash(s[i])) {
    i = i + 1;
  }
  var last: i32 = i;
  var after_slash: boolean = false;
  while (i < s.len()) {
    if (is_slash(s[i])) {
      after_slash = true;
    } else if (after_slash) {
      last = i;
      after_slash = false;
    }
    i = i + 1;
  }
  return last;
}

// ---- backups ---------------------------------------------------------------
//
// The `--backup` family gnulib gives every utility that replaces a
// destination: four controls, eight names for them, and the scan that
// picks the next `NAME.~N~`.
pub function backup_none(): i32 {
  return 0;
}

pub function backup_simple(): i32 {
  return 1;
}

pub function backup_existing(): i32 {
  return 2;
}

pub function backup_numbered(): i32 {
  return 3;
}

// The eight names, in gnulib's declaration order — which is visible,
// because the invalid-argument list prints them in it.
pub function backup_names(): string[] {
  return ["none", "off", "simple", "never", "existing", "nil", "numbered", "t"];
}

pub function backup_values(): i32[] {
  return [backup_none(), backup_none(), backup_simple(), backup_simple(), backup_existing(), backup_existing(), backup_numbered(), backup_numbered()];
}

// `usable_suffix(s)` — whether `-S s` / `$SIMPLE_BACKUP_SUFFIX` is one a
// backup name may be built from. A suffix is taken only when it IS its
// own last component, so `-S 'x/y'`, `-S '/x'` and `-S '/'` are ignored
// and `~` is used. `-S 'x/'` passes the test, and the backup name it
// builds ends in a slash — which is how `ln -b -S x/ a b` reaches
// `cannot backup 'b': Not a directory`.
pub function usable_suffix(s: string): boolean {
  return s.len() > 0 && last_component_start(s) == 0;
}

// The N in `NAME.~N~`, or -1 when `entry` is not one of NAME's numbered
// backups. A leading zero disqualifies it — `b.~09~` is not a backup of
// `b` and does not raise the next number.
function numbered_index(entry: string, name: string): i32 {
  var head: string = name + ".~";
  if (!entry.starts_with(head) || !entry.ends_with("~")) {
    return 0 - 1;
  }
  var start: i32 = head.len();
  var end: i32 = entry.len() - 1;
  if (end <= start) {
    return 0 - 1;
  }
  if (entry[start] as i32 == 48 && end - start > 1) {
    return 0 - 1;
  }
  var n: i32 = 0;
  var i: i32 = start;
  while (i < end) {
    if (!is_digit(entry[i] as i32)) {
      return 0 - 1;
    }
    n = n * 10 + (entry[i] as i32 - 48);
    i = i + 1;
  }
  return n;
}

// The highest N over `dir`'s `NAME.~N~` entries, or -1 when there is
// none. A DIRECTORY named that way counts: the scan reads names.
function highest_numbered(dir: string, name: string): i32 {
  var best: i32 = 0 - 1;
  match (read_dir(dir)) {
    Ok(entries) => {
      var i: i32 = 0;
      while (i < entries.len()) {
        var n: i32 = numbered_index(entries[i], name);
        if (n > best) {
          best = n;
        }
        i = i + 1;
      }
    },
    Err(_) => {}
  }
  return best;
}

// `backup_name(dest, control, suffix)` — the name the existing `dest` is
// moved to. `existing` picks numbered only when a numbered backup of
// this name is already there.
pub function backup_name(dest: string, control: i32, suffix: string): string {
  var c: i32 = control;
  if (c == backup_existing()) {
    if (highest_numbered(dir_name(dest), base_name(dest)) >= 0) {
      c = backup_numbered();
    } else {
      c = backup_simple();
    }
  }
  if (c == backup_numbered()) {
    // The first numbered backup is `.~1~`, so a directory with none in
    // it starts there rather than one past the -1 the scan reports.
    var n: i32 = highest_numbered(dir_name(dest), base_name(dest));
    if (n < 0) {
      n = 0;
    }
    return dest + ".~" + (n + 1).to_string() + "~";
  }
  return dest + suffix;
}

// `yesno()` — glibc's yesno(): one line from stdin, yes when it starts
// with `y` or `Y` in the C locale. End of input is no.
pub function yesno(): boolean {
  match (read_line()) {
    Some(l) => {
      return l.len() > 0 && (l[0] as i32 == 121 || l[0] as i32 == 89);
    },
    None => {
      return false;
    }
  }
}
