function op_file_type(): i32 {
  return 19;
}

function op_si(): i32 {
  return 20;
}

function op_deref_cmd(): i32 {
  return 21;
}

function op_deref_cmd_dir(): i32 {
  return 22;
}

function op_hide(): i32 {
  return 23;
}

function op_ignore(): i32 {
  return 24;
}

function op_indicator(): i32 {
  return 25;
}

function op_deref(): i32 {
  return 26;
}

function op_literal(): i32 {
  return 27;
}

function op_quote_name(): i32 {
  return 28;
}

function op_quoting(): i32 {
  return 29;
}

function op_recursive(): i32 {
  return 30;
}

function op_format(): i32 {
  return 31;
}

function op_show_control(): i32 {
  return 32;
}

function op_sort(): i32 {
  return 33;
}

function op_tabsize(): i32 {
  return 34;
}

function op_time(): i32 {
  return 35;
}

function op_time_style(): i32 {
  return 36;
}

function op_zero(): i32 {
  return 37;
}

function op_color(): i32 {
  return 38;
}

function op_hyperlink(): i32 {
  return 39;
}

function op_block_size(): i32 {
  return 40;
}

function op_context(): i32 {
  return 41;
}

function op_author(): i32 {
  return 42;
}

// The short options with no long form.
function op_long(): i32 {
  return 50;
}

function op_one(): i32 {
  return 51;
}

function op_many(): i32 {
  return 52;
}

function op_across(): i32 {
  return 53;
}

function op_commas(): i32 {
  return 54;
}

function op_no_owner(): i32 {
  return 55;
}

function op_no_group_long(): i32 {
  return 56;
}

function op_ctime(): i32 {
  return 57;
}

function op_atime(): i32 {
  return 58;
}

function op_sort_time(): i32 {
  return 59;
}

function op_sort_size(): i32 {
  return 60;
}

function op_sort_none(): i32 {
  return 61;
}

function op_sort_version(): i32 {
  return 62;
}

function op_sort_ext(): i32 {
  return 63;
