pub struct Palette { on: boolean, link_target: boolean, lc: string, rc: string, rs: string, ec: string, has_ec: boolean, code: string[], set: boolean[], suffix: string[], suffix_code: string[] }

function empty_caps(): string[] {
  let out: string[] = [];
  let i = 0;
  while (i < cap_count()) {
    out = out.append("");
    i += 1;
  }
  return out;
}

function unset_caps(): boolean[] {
  let out: boolean[] = [];
  let i = 0;
  while (i < cap_count()) {
    out = out.append(false);
    i += 1;
  }
  return out;
}

pub function palette_off(): Palette {
  return Palette { on: false, link_target: false, lc: "", rc: "", rs: "", ec: "", has_ec: false, code: empty_caps(), set: unset_caps(), suffix: [], suffix_code: [] };
}

function palette_default(): Palette {
  let code = empty_caps();
  let set = unset_caps();
  let p = Palette { on: true, link_target: false, lc: "\x1b[", rc: "m", rs: "0", ec: "", has_ec: false, code: code, set: set, suffix: [], suffix_code: [] };
  p = cap_put(p, cap_di(), "01;34");
  p = cap_put(p, cap_ln(), "01;36");
  p = cap_put(p, cap_pi(), "33");
  p = cap_put(p, cap_so(), "01;35");
  p = cap_put(p, cap_bd(), "01;33");
  p = cap_put(p, cap_cd(), "01;33");
  p = cap_put(p, cap_ex(), "01;32");
  p = cap_put(p, cap_su(), "37;41");
  p = cap_put(p, cap_sg(), "30;43");
  p = cap_put(p, cap_st(), "37;44");
  p = cap_put(p, cap_ow(), "34;42");
  p = cap_put(p, cap_tw(), "30;42");
  return p;
}

function cap_put(p: Palette, id: i32, value: string): Palette {
  return Palette { ...p, code: p.code.with(id, value), set: p.set.with(id, true) };
}

function cap_set(p: Palette, id: i32): boolean {
  return p.set[id];
}

function cap_on(p: Palette, id: i32): boolean {
  if (!p.set[id]) {
    return false;
  }
  let v = p.code[id];
  return v.len() > 0 && v != "0" && v != "00";
}

function unescape(s: string, start: i32, end: i32): string {
  let bs: u8[] = [];
  let i = start;
  while (i < end) {
    let c = s[i] as i32;
    if (c == 92 && i + 1 < end) {
      let n = s[i + 1] as i32;
      if (n == 97) {
        bs = bs.append(7 as u8);
        i += 2;
      } else if (n == 98) {
        bs = bs.append(8 as u8);
        i += 2;
      } else if (n == 101) {
        bs = bs.append(27 as u8);
        i += 2;
      } else if (n == 102) {
        bs = bs.append(12 as u8);
        i += 2;
      } else if (n == 110) {
        bs = bs.append(10 as u8);
        i += 2;
      } else if (n == 114) {
        bs = bs.append(13 as u8);
        i += 2;
      } else if (n == 116) {
        bs = bs.append(9 as u8);
        i += 2;
      } else if (n == 118) {
        bs = bs.append(11 as u8);
        i += 2;
      } else if (n == 63) {
        bs = bs.append(127 as u8);
        i += 2;
      } else if (n == 95) {
        bs = bs.append(32 as u8);
        i += 2;
      } else if (n >= 48 && n <= 55) {
        let v = 0;
        let k = i + 1;
        while (k < end && k < i + 4 && s[k] as i32 >= 48 && s[k] as i32 <= 55) {
          v = v * 8 + (s[k] as i32 - 48);
          k += 1;
        }
        bs = bs.append((v & 255) as u8);
        i = k;
      } else if (n == 120 || n == 88) {
        let hv = 0;
        let hk = i + 2;
        let any = false;
        while (hk < end) {
          let d = hex_value(s[hk] as i32);
          if (d < 0) {
            break;
          }
          hv = hv * 16 + d;
          any = true;
          hk += 1;
        }
        if (any) {
          bs = bs.append((hv & 255) as u8);
          i = hk;
        } else {
          bs = bs.append(n as u8);
          i += 2;
        }
      } else {
        bs = bs.append(n as u8);
        i += 2;
      }
    } else if (c == 94 && i + 1 < end) {
      let m = s[i + 1] as i32;
      if (m == 63) {
        bs = bs.append(127 as u8);
      } else {
        bs = bs.append((m & 31) as u8);
      }
      i += 2;
    } else {
      bs = bs.append(c as u8);
      i += 1;
    }
  }
  return string_from_bytes_unchecked(bs);
}

function hex_value(c: i32): i32 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return -1;
}

function scan_to(s: string, i0: i32, end: i32, b: i32): i32 {
  let i = i0;
  while (i < end) {
    let c = s[i] as i32;
    if (c == 92 && i + 1 < end) {
      i += 2;
      continue;
    }
    if (c == b) {
      return i;
    }
    i += 1;
  }
  return end;
}

function parse_ls_colors(spec: string): Palette {
  let p = palette_default();
  let names = cap_names();
  let n = spec.len();
  let i = 0;
  while (i < n) {
    if (spec[i] as i32 == 58) {
      i += 1;
      continue;
    }
    let stop = scan_to(spec, i, n, 58);
    let eq = scan_to(spec, i, stop, 61);
    if (eq >= stop) {
      gnu.error("unparsable value for LS_COLORS environment variable");
      return palette_off();
    }
    let key = unescape(spec, i, eq);
    let value = unescape(spec, eq + 1, stop);
    if (key.len() > 1 && key[0] as i32 == 42) {
      p = Palette { ...p, suffix: p.suffix.append(slice_unchecked(key, 1, key.len()) + ""), suffix_code: p.suffix_code.append(value) };
    } else {
      let slot: i32 = -1;
      let k = 0;
      while (k < names.len()) {
        if (names[k] == key) {
          slot = k;
          break;
        }
        k += 1;
      }
      if (slot < 0) {
        gnu.error("unrecognized prefix: " + gnu.quote(key));
        gnu.error("unparsable value for LS_COLORS environment variable");
        return palette_off();
      }
      if (slot == 20) {
        p = Palette { ...p, lc: value };
      } else if (slot == 21) {
        p = Palette { ...p, rc: value };
      } else if (slot == 22) {
        p = Palette { ...p, ec: value, has_ec: true };
      } else if (slot == 23) {
        p = Palette { ...p, rs: value };
      } else if (slot == cap_ln() && value == "target") {
        p = Palette { ...p, link_target: true };
        p = cap_put(p, cap_ln(), "");
      } else {
        p = cap_put(p, slot, value);
      }
    }
    i = stop + 1;
  }
  return p;
}

function reset_seq(p: Palette): string {
  if (p.has_ec) {
    return p.ec;
  }
  return p.lc + p.rs + p.rc;
}

function wrap_seq(p: Palette, code: string): string {
  return p.lc + code + p.rc;
}

struct Ent { name: string, dir: string, st: FileStat, stated: boolean, followed: boolean, target: string, has_target: boolean, link_mode: u32, link_ok: boolean, owner: string, group: string, context: string, dkind: u32 }

function blank_stat(): FileStat {
  return FileStat { is_file: false, is_dir: false, size: 0 as i64, mode: 0 as u32, nlink: 0 as u32, uid: 0 as u32, gid: 0 as u32, dev: 0 as i64, rdev: 0 as i64, ino: 0 as i64, blksize: 0 as i64, blocks: 0 as i64, atime: 0 as i64, atime_nsec: 0 as i64, mtime: 0 as i64, mtime_nsec: 0 as i64, ctime: 0 as i64, ctime_nsec: 0 as i64, btime: 0 as i64, btime_nsec: 0 as i64 };
}

function ent_new(name: string, dir: string): Ent {
  return Ent { name: name, dir: dir, st: blank_stat(), stated: false, followed: false, target: "", has_target: false, link_mode: 0 as u32, link_ok: false, owner: "", group: "", context: "?", dkind: 0 as u32 };
}

function needs_stat(c: Cfg): boolean {
  return needs_record(c) || c.indicator != ind_none() || c.dirs_first || c.recursive;
}

function needs_record(c: Cfg): boolean {
  return c.format == fmt_long() || c.inode || c.show_blocks || c.show_context || c.color || c.sort_key == sort_time() || c.sort_key == sort_size();
}

function stat_needed(c: Cfg, e: Ent): boolean {
  if (needs_record(c) || e.dkind == 0 as u32) {
    return true;
  }
  let link = filetype.is_link(e.dkind);
  if (link && (c.deref == deref_all() || c.dirs_first)) {
    return true;
  }
  return c.indicator == ind_classify() && filetype.is_reg(e.dkind);
}

function needs_link_mode(c: Cfg): boolean {
  if (c.format == fmt_long() && (c.indicator == ind_file_type() || c.indicator == ind_classify())) {
    return true;
  }
  if (c.dirs_first) {
    return true;
  }
  if (!c.color) {
    return false;
  }
  return c.colors.link_target || cap_on(c.colors, cap_or()) || cap_on(c.colors, cap_mi());
}

function stat_entry(c: Cfg, e: Ent, cmdline: boolean): (Ent, boolean, string) {
  let r: (Ent, boolean, string) = stat_record(c, e, cmdline);
  if (!r.1 || !c.show_context) {
    return r;
  }
  return (Ent { ...r.0, context: context_of(r.0) }, true, "");
}

function stat_record(c: Cfg, e: Ent, cmdline: boolean): (Ent, boolean, string) {
  let follow = c.deref == deref_all() || cmdline && c.deref == deref_cmd();
  let out = e;
  let path = ent_path(e);
  if (follow) {
    match (stat(path)) {
      Ok(s) => {
        return (Ent { ...out, st: s, stated: true, followed: true }, true, "");
      },
      Err(err) => {
        return (out, false, gnu.io_error_text(err));
      }
    }
  }
  match (lstat(path)) {
    Ok(s) => {
      out = Ent { ...out, st: s, stated: true };
    },
    Err(err) => {
      return (out, false, gnu.io_error_text(err));
    }
  }
  if (!filetype.is_link(out.st.mode)) {
    return (out, true, "");
  }
  if (cmdline && (c.deref == deref_cmd_dir() || c.deref == deref_cmd())) {
    match (stat(path)) {
      Ok(s) => {
        if (filetype.is_dir(s.mode)) {
          return (Ent { ...out, st: s, followed: true }, true, "");
        }
      },
      Err(_) => {}
    }
  }
  if (c.format == fmt_long()) {
    match (read_link(path)) {
      Ok(t) => {
        out = Ent { ...out, target: t, has_target: true };
      },
      Err(_) => {}
    }
  }
  if (needs_link_mode(c)) {
    match (stat(path)) {
      Ok(s) => {
        out = Ent { ...out, link_mode: s.mode, link_ok: true };
      },
      Err(_) => {}
    }
  }
  return (out, true, "");
}

function ent_time(c: Cfg, e: Ent): i64 {
  if (c.time_type == time_atime()) {
    return e.st.atime;
  }
  if (c.time_type == time_ctime()) {
    return e.st.ctime;
  }
  if (c.time_type == time_birth()) {
    if (no_birth(e)) {
      return 0 - 1 as i64;
    }
    return e.st.btime;
  }
  return e.st.mtime;
}

function ent_nsec(c: Cfg, e: Ent): i64 {
  if (c.time_type == time_atime()) {
    return e.st.atime_nsec;
  }
  if (c.time_type == time_ctime()) {
    return e.st.ctime_nsec;
  }
  if (c.time_type == time_birth()) {
    if (no_birth(e)) {
      return 0 - 1 as i64;
    }
    return e.st.btime_nsec;
  }
  return e.st.mtime_nsec;
}

function no_birth(e: Ent): boolean {
  if (target_os() == "darwin") {
    return e.st.btime == 0 as i64 || e.st.btime_nsec < 0 as i64 || e.st.btime_nsec >= 1000000000 as i64;
  }
  return e.st.btime == 0 as i64 && e.st.btime_nsec == 0 as i64;
}

function kind_mode(e: Ent): u32 {
  if (e.stated) {
    return e.st.mode;
  }
  if (e.link_mode != 0 as u32) {
    return e.link_mode;
  }
  return e.dkind;
}

function effective_mode(c: Cfg, e: Ent): u32 {
  if (c.colors.link_target && e.link_ok) {
    return e.link_mode;
  }
  return e.st.mode;
}

function byte_cmp(a: string, b: string): i32 {
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

function extension(name: string): string {
  let i = name.len() - 1;
  while (i > 0) {
    if (name[i] as i32 == 46) {
      return slice_unchecked(name, i, name.len()) + "";
    }
    i -= 1;
  }
  return "";
}

function cmp_i64(a: i64, b: i64): i32 {
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

function cmp_key(c: Cfg, a: Ent, b: Ent): i32 {
  if (c.sort_key == sort_name()) {
    return byte_cmp(a.name, b.name);
  }
  if (c.sort_key == sort_time()) {
    let r = cmp_i64(ent_time(c, b), ent_time(c, a));
    if (r == 0) {
      r = cmp_i64(ent_nsec(c, b), ent_nsec(c, a));
    }
    if (r != 0) {
      return r;
    }
    return byte_cmp(a.name, b.name);
  }
  if (c.sort_key == sort_size()) {
    let s = cmp_i64(b.st.size, a.st.size);
    if (s != 0) {
      return s;
    }
    return byte_cmp(a.name, b.name);
  }
  if (c.sort_key == sort_ext()) {
    let e = byte_cmp(extension(a.name), extension(b.name));
    if (e != 0) {
      return e;
    }
    return byte_cmp(a.name, b.name);
  }
  if (c.sort_key == sort_version()) {
    return vercmp.compare(a.name, b.name);
  }
  if (c.sort_key == sort_width()) {
    let w = printable_width(quoted_name(c, a.name)) - printable_width(quoted_name(c, b.name));
    if (w != 0) {
      return w;
    }
    return byte_cmp(a.name, b.name);
  }
  return byte_cmp(a.name, b.name);
}

function before(c: Cfg, es: Ent[], a: i32, b: i32): boolean {
  if (c.dirs_first) {
    let ad = is_dir_entry(c, es[a]);
    let bd = is_dir_entry(c, es[b]);
    if (ad != bd) {
      return ad;
    }
  }
  if (c.reverse) {
    return key_before(c, es, b, a);
  }
  return key_before(c, es, a, b);
}

function key_before(c: Cfg, es: Ent[], a: i32, b: i32): boolean {
  if (c.sort_key == sort_name()) {
    return es[a].name < es[b].name;
  }
  return cmp_key(c, es[a], es[b]) < 0;
}

function is_dir_entry(c: Cfg, e: Ent): boolean {
  if (filetype.is_dir(kind_mode(e))) {
    return true;
  }
  return e.link_ok && filetype.is_dir(e.link_mode);
}

function sort_entries(c: Cfg, es: Ent[]): Ent[] {
  let n = es.len();
  if (n < 2 || c.sort_key == sort_none()) {
    return es;
  }
  let src: i32[] = [];
  let dst: i32[] = [];
  let i = 0;
  while (i < n) {
    src = src.append(i);
    dst = dst.append(0);
    i += 1;
  }
  let width = 1;
  while (width < n) {
    let start = 0;
    let at = 0;
    while (start < n) {
      let mid = start + width;
      if (mid > n) {
        mid = n;
      }
      let end = mid + width;
      if (end > n) {
        end = n;
      }
      let p = start;
      let q = mid;
      while (p < mid && q < end) {
        if (before(c, es, src[q], src[p])) {
          dst = dst.with(at, src[q]);
          q += 1;
        } else {
          dst = dst.with(at, src[p]);
          p += 1;
        }
        at += 1;
      }
      while (p < mid) {
        dst = dst.with(at, src[p]);
        p += 1;
        at += 1;
      }
      while (q < end) {
        dst = dst.with(at, src[q]);
        q += 1;
        at += 1;
      }
      start = end;
    }
    let swap = src;
    src = dst;
    dst = swap;
    width *= 2;
  }
  let out: Ent[] = [];
  let k = 0;
  while (k < n) {
    out = out.append(es[src[k]]);
    k += 1;
  }
  return out;
}

function qmark_applies(style: i32): boolean {
  return style == 0 || style == 1 || style == 2;
}

function qmark(s: string): string {
  let bs: u8[] = [];
  let i = 0;
  while (i < s.len()) {
    let b = s[i] as i32;
    if (b < 32 || b >= 127) {
      bs = bs.append(63 as u8);
    } else {
      bs = bs.append(b as u8);
    }
    i += 1;
  }
  return string_from_bytes_unchecked(bs);
}

function quoted_name(c: Cfg, name: string): string {
  let extra = "";
  if (c.qstyle == 7) {
    extra = " ";
  }
  let out = gnu.quote_style_with(name, c.qstyle, extra);
  if (c.qmark && qmark_applies(c.qstyle)) {
    return qmark(out);
  }
  if (qmark_applies(c.qstyle) && c.qmark_newline && !c.dired) {
    return newline_qmark(out);
  }
  return out;
}

function newline_qmark(s: string): string {
  if (!s.contains("\n")) {
    return s;
  }
  let bs: u8[] = [];
  let i = 0;
  while (i < s.len()) {
    if (s[i] as i32 == 10) {
      bs = bs.append(63 as u8);
    } else {
      bs = bs.append(s[i]);
    }
    i += 1;
  }
  return string_from_bytes_unchecked(bs);
}

function quoted_header(c: Cfg, name: string): string {
  let out = gnu.quote_style_with(name, c.qstyle, ":");
  if (c.qmark && qmark_applies(c.qstyle)) {
    return qmark(out);
  }
  return out;
}

function indicator(c: Cfg, e: Ent): string {
  if (c.indicator == ind_none()) {
    return "";
  }
  let m = kind_mode(e);
  if (filetype.is_dir(m)) {
    return "/";
  }
  if (c.indicator == ind_slash()) {
    return "";
  }
  if (filetype.is_link(m)) {
    return "@";
  }
  if (filetype.is_fifo(m)) {
    return "|";
  }
  if (filetype.is_sock(m)) {
    return "=";
  }
  if (c.indicator == ind_classify() && filetype.is_reg(m) && (m & 0x49 as u32) != 0 as u32) {
    return "*";
  }
  return "";
}

function color_slot(c: Cfg, e: Ent): i32 {
  let p = c.colors;
  if (filetype.is_link(e.st.mode)) {
    if (!e.link_ok && (p.link_target || cap_on(p, cap_or()))) {
      return cap_or();
    }
    if (!p.link_target) {
      return cap_ln();
    }
  }
  let m = effective_mode(c, e);
  if (filetype.is_dir(m)) {
    let sticky = (m & 0x200 as u32) != 0 as u32;
    let other_w = (m & 2 as u32) != 0 as u32;
    if (sticky && other_w && cap_on(p, cap_tw())) {
      return cap_tw();
    }
    if (other_w && cap_on(p, cap_ow())) {
      return cap_ow();
    }
    if (sticky && cap_on(p, cap_st())) {
      return cap_st();
    }
    return cap_di();
  }
  if (filetype.is_fifo(m)) {
    return cap_pi();
  }
  if (filetype.is_sock(m)) {
    return cap_so();
  }
  if (filetype.is_blk(m)) {
    return cap_bd();
  }
  if (filetype.is_chr(m)) {
    return cap_cd();
  }
  if (!filetype.is_reg(m)) {
    return cap_or();
  }
  if ((m & 0x800 as u32) != 0 as u32 && cap_on(p, cap_su())) {
    return cap_su();
  }
  if ((m & 0x400 as u32) != 0 as u32 && cap_on(p, cap_sg())) {
    return cap_sg();
  }
  if ((m & 0x49 as u32) != 0 as u32 && cap_on(p, cap_ex())) {
    return cap_ex();
  }
  if (e.st.nlink > 1 as u32 && cap_on(p, cap_mh())) {
    return cap_mh();
  }
  return cap_fi();
}

function color_code(c: Cfg, e: Ent): (string, boolean) {
  if (!c.color) {
    return ("", false);
  }
  let p = c.colors;
  let slot = color_slot(c, e);
  if (slot == cap_fi()) {
    let i = p.suffix.len() - 1;
    while (i >= 0) {
      if (ends_with_fold(e.name, p.suffix[i])) {
        return (p.suffix_code[i], true);
      }
      i -= 1;
    }
  }
  if (slot < 0 || !cap_set(p, slot)) {
    return ("", false);
  }
  return (p.code[slot], true);
}

function ends_with_fold(name: string, suffix: string): boolean {
  if (suffix.len() > name.len()) {
    return false;
  }
  let off = name.len() - suffix.len();
  let i = 0;
  while (i < suffix.len()) {
    let x = name[off + i] as i32;
    let y = suffix[i] as i32;
    if (x >= 65 && x <= 90) {
      x += 32;
    }
    if (y >= 65 && y <= 90) {
      y += 32;
    }
    if (x != y) {
      return false;
    }
    i += 1;
  }
  return true;
}

function osc_end(): string {
  return "\x1b\\";
}

function uri_encode(s: string): string {
  let bs: u8[] = [];
  let i = 0;
  while (i < s.len()) {
    let b = s[i] as i32;
    let plain = b >= 48 && b <= 57 || b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 45 || b == 46 || b == 95 || b == 126 || b == 47;
    if (plain) {
      bs = bs.append(b as u8);
    } else {
      bs = bs.append(37 as u8);
      bs = bs.append(hex_digit_byte(b / 16));
      bs = bs.append(hex_digit_byte(b % 16));
    }
    i += 1;
  }
  return string_from_bytes_unchecked(bs);
}

function hex_digit_byte(v: i32): u8 {
  if (v < 10) {
    return (48 + v) as u8;
  }
  return (87 + v) as u8;
}

function canonical(path: string): string {
  match (canon.canonicalize(path, canon.missing(), false)) {
    Ok(p) => {
      return p;
    },
    Err(_) => {
      if (path.len() > 0 && path[0] as i32 == 47) {
        return path;
      }
      match (getcwd()) {
        Ok(wd) => {
          return gnu.join_path(wd, path);
        },
        Err(_) => {
          return path;
        }
      }
    }
  }
}

struct Widths { inode: i32, blocks: i32, nlink: i32, owner: i32, group: i32, author: i32, context: i32, size: i32, major: i32, minor: i32, time: i32, pad: boolean }

function widths_new(): Widths {
  return Widths { inode: 0, blocks: 0, nlink: 0, owner: 0, group: 0, author: 0, context: 0, size: 0, major: 0, minor: 0, time: 0, pad: false };
}

pub function dev_major(dev: u64): u64 {
  if (target_os() == "darwin") {
    return dev >> 24 as u64 & 0xff as u64;
  }
  return linux_dev_major(dev);
}

function linux_dev_major(dev: u64): u64 {
  return dev >> 8 as u64 & 0xfff as u64 | dev >> 32 as u64 & 0xfffff000 as u64;
}

pub function dev_minor(dev: u64): u64 {
  if (target_os() == "darwin") {
    return dev & 0xffffff as u64;
  }
  return linux_dev_minor(dev);
}

function linux_dev_minor(dev: u64): u64 {
  return dev & 0xff as u64 | dev >> 12 as u64 & 0xffffff00 as u64;
}

function is_device(e: Ent): boolean {
  return filetype.is_blk(e.st.mode) || filetype.is_chr(e.st.mode);
}

function id_names_new(c: Cfg): pwdb.Names {
  if (c.format != fmt_long() || c.numeric_ids) {
    return pwdb.names_new(false, false);
  }
  return pwdb.names_new(c.show_owner || c.show_author, c.show_group);
}

function resolve_ids(c: Cfg, n: pwdb.Names, e: Ent): (Ent, pwdb.Names) {
  if (c.format != fmt_long() || !e.stated) {
    return (e, n);
  }
  if (c.numeric_ids) {
    return (Ent { ...e, owner: e.st.uid.to_string(), group: e.st.gid.to_string() }, n);
  }
  let names = n;
  let owner = "";
  if (c.show_owner || c.show_author) {
    let u: (string, pwdb.Names) = names.user(e.st.uid as i64);
    owner = u.0;
    names = u.1;
  }
  let group = "";
  if (c.show_group) {
    let g: (string, pwdb.Names) = names.group(e.st.gid as i64);
    group = g.0;
    names = g.1;
  }
  return (Ent { ...e, owner: owner, group: group }, names);
}

function context_of(e: Ent): string {
  match (selinux.file_context(ent_path(e), e.followed)) {
    Ok(ctx) => {
      return ctx;
    },
    Err(_) => {
      return "?";
    }
  }
}

function unit_suffix(u: blocks.Unit): string {
  if (!u.show_suffix) {
    return "";
  }
  return blocks.unit_text(u.block_size, u.base, u.with_b);
}

function render(u: blocks.Unit, n: u64): string {
  return blocks.format_size(n, u.block_size, unit_suffix(u), u.human);
}

function size_text(c: Cfg, e: Ent): string {
  return render(c.fsize, e.st.size as u64);
}

function block_text(c: Cfg, e: Ent): string {
  return render(c.bsize, (e.st.blocks * (512 as i64)) as u64);
}

function time_width(c: Cfg): i32 {
  let a = timefmt.format_bytes(c.nonrecent_fmt, c.zone, c.now, 0 as i64).len();
  let b = timefmt.format_bytes(c.recent_fmt, c.zone, c.now, 0 as i64).len();
  if (b > a) {
    return b;
  }
  return a;
}

function time_bytes(c: Cfg, e: Ent): u8[] {
  if (!e.stated || c.time_type == time_birth() && no_birth(e)) {
    return pad_left("?", time_width(c)).bytes();
  }
  let t = ent_time(c, e);
  let recent = c.now - six_months() < t && t <= c.now;
  if (recent) {
    return timefmt.format_bytes(c.recent_fmt, c.zone, t, ent_nsec(c, e));
  }
  return timefmt.format_bytes(c.nonrecent_fmt, c.zone, t, ent_nsec(c, e));
}

function measure(c: Cfg, es: Ent[]): Widths {
  let w = widths_new();
  w = Widths { ...w, time: time_width(c), pad: some_quoted(c, es) };
  let i = 0;
  while (i < es.len()) {
    let e = es[i];
    if (c.inode) {
      let ino = "?";
      if (e.stated) {
        ino = e.st.ino.to_string();
      }
      w = Widths { ...w, inode: max_i32(w.inode, ino.len()) };
    }
    if (c.show_blocks) {
      let blk = "?";
      if (e.stated) {
        blk = block_text(c, e);
      }
      w = Widths { ...w, blocks: max_i32(w.blocks, blk.len()) };
    }
    if (c.show_context) {
      w = Widths { ...w, context: max_i32(w.context, e.context.len()) };
    }
    if (c.format == fmt_long()) {
      let nl = "?";
      if (e.stated) {
        nl = e.st.nlink.to_string();
      }
      w = Widths { ...w, nlink: max_i32(w.nlink, nl.len()) };
      if (c.show_owner) {
        w = Widths { ...w, owner: max_i32(w.owner, field_or_query(e.stated, e.owner).len()) };
      }
      if (c.show_group) {
        w = Widths { ...w, group: max_i32(w.group, field_or_query(e.stated, e.group).len()) };
      }
      if (c.show_author) {
        w = Widths { ...w, author: max_i32(w.author, field_or_query(e.stated, e.owner).len()) };
      }
      if (!e.stated) {
        w = Widths { ...w, size: max_i32(w.size, 1) };
      } else if (is_device(e)) {
        if (target_os() == "darwin") {
          w = Widths { ...w, major: max_i32(w.major, digits_u64(e.st.rdev as u64 >> 24 as u64 & 0xff as u64)), minor: max_i32(w.minor, digits_u64(e.st.rdev as u64 & 0xffffff as u64)) };
        } else {
          w = Widths { ...w, major: max_i32(w.major, digits_u64(linux_dev_major(e.st.rdev as u64))), minor: max_i32(w.minor, digits_u64(linux_dev_minor(e.st.rdev as u64))) };
        }
      } else {
        w = Widths { ...w, size: max_i32(w.size, size_text(c, e).len()) };
      }
    }
    i += 1;
  }
  if (w.major > 0 || w.minor > 0) {
    w = Widths { ...w, size: max_i32(w.size, w.major + 2 + w.minor) };
  }
  return w;
}

function field_or_query(stated: boolean, s: string): string {
  if (stated) {
    return s;
  }
  return "?";
}

function max_i32(a: i32, b: i32): i32 {
  if (a > b) {
    return a;
  }
  return b;
}

function unknown_mode_string(e: Ent): string {
  return filetype.type_letter(kind_mode(e)) + "?????????";
}

function size_field(c: Cfg, w: Widths, e: Ent): string {
  if (!e.stated) {
    return pad_left("?", w.size);
  }
  if (is_device(e)) {
    if (target_os() == "darwin") {
      return pad_left(pad_left((e.st.rdev as u64 >> 24 as u64 & 0xff as u64).to_string(), w.major) + ", " + pad_left((e.st.rdev as u64 & 0xffffff as u64).to_string(), w.minor), w.size);
    }
    return pad_left(pad_left(linux_dev_major(e.st.rdev as u64).to_string(), w.major) + ", " + pad_left(linux_dev_minor(e.st.rdev as u64).to_string(), w.minor), w.size);
  }
  return pad_left(size_text(c, e), w.size);
}

function frills(c: Cfg, w: Widths, e: Ent): string {
  let out = "";
  if (c.inode) {
    let ino = "?";
    if (e.stated) {
      ino = e.st.ino.to_string();
    }
    out = out + pad_left(ino, w.inode) + " ";
  }
  if (c.show_blocks) {
    let blk = "?";
    if (e.stated) {
      blk = block_text(c, e);
    }
    out = out + pad_left(blk, w.blocks) + " ";
  }
  if (c.show_context && c.format != fmt_long()) {
    out = out + pad_right(e.context, w.context) + " ";
  }
  return out;
}

function long_prefix(c: Cfg, w: Widths, e: Ent): u8[] {
  let h = buf_new(96);
  buf_push(h, frills(c, w, e));
  if (e.stated) {
    buf_push(h, filetype.mode_string(e.st.mode));
  } else {
    buf_push(h, unknown_mode_string(e));
  }
  let nl = "?";
  if (e.stated) {
    nl = e.st.nlink.to_string();
  }
  buf_push(h, " ");
  push_left(h, nl, w.nlink);
  if (c.show_owner) {
    buf_push(h, " ");
    push_field(c, h, field_or_query(e.stated, e.owner), w.owner);
  }
  if (c.show_group) {
    buf_push(h, " ");
    push_field(c, h, field_or_query(e.stated, e.group), w.group);
  }
  if (c.show_author) {
    buf_push(h, " ");
    push_field(c, h, field_or_query(e.stated, e.owner), w.author);
  }
  if (c.show_context) {
    buf_push(h, " ");
    push_right(h, e.context, w.context);
  }
  buf_push(h, " ");
  buf_push(h, size_field(c, w, e));
  buf_push(h, " ");
  let stamp = time_bytes(c, e);
  buf_push_bytes_range(h, stamp, 0, stamp.len());
  buf_push(h, " ");
  let bytes = buf_take_bytes(h);
  buf_free(h);
  return bytes;
}

function push_pad(h: usize, n: i32): void {
  let i = 0;
  while (i < n) {
    buf_push_byte(h, 32);
    i += 1;
  }
}

function push_left(h: usize, s: string, w: i32): void {
  push_pad(h, w - s.len());
  buf_push(h, s);
}

function push_right(h: usize, s: string, w: i32): void {
  buf_push(h, s);
  push_pad(h, w - s.len());
}

function push_field(c: Cfg, h: usize, s: string, w: i32): void {
  if (c.numeric_ids) {
    push_left(h, s, w);
  } else {
    push_right(h, s, w);
  }
}

struct Paint { started: boolean, used: boolean }

function paint_new(): Paint {
  return Paint { started: false, used: false };
}

function write_name(c: Cfg, o: Out, p: Paint, e: Ent, colour: (string, boolean), text: string, record: boolean, hoist: boolean): (Out, Paint) {
  let out = o;
  let paint = p;
  let pal = c.colors;
  let has = colour.1;
  let coloured = c.color && (has || cap_on(pal, cap_no()));
  if (coloured) {
    if (!paint.started) {
      out = put(out, reset_seq(pal));
      paint = Paint { started: true, used: true };
    }
    if (cap_on(pal, cap_no()) && has) {
      out = put(out, pal.lc + pal.rc);
    }
    if (has) {
      out = put(out, wrap_seq(pal, colour.0));
    }
  }
  let body = text;
  if (hoist) {
    out = put(out, slice_unchecked(text, 0, 1) + "");
    body = slice_unchecked(text, 1, text.len() - 1) + "";
  }
  if (c.hyperlink) {
    out = put(out, "\x1b]8;;file://" + hostname() + uri_encode(canonical(ent_path(e))) + osc_end());
  }
  if (record) {
    out = put_name(c, out, body);
  } else {
    out = put(out, body);
  }
  if (c.hyperlink) {
    out = put(out, "\x1b]8;;" + osc_end());
  }
  if (hoist) {
    out = put(out, slice_unchecked(text, text.len() - 1, text.len()) + "");
  }
  if (coloured) {
    out = put(out, reset_seq(pal));
  }
  return (out, paint);
}

function start_entry(c: Cfg, o: Out, p: Paint): (Out, Paint) {
  if (!c.color || !cap_on(c.colors, cap_no())) {
    return (o, p);
  }
  let out = o;
  let paint = p;
  if (!paint.started) {
    out = put(out, reset_seq(c.colors));
    paint = Paint { started: true, used: true };
  }
  return (put(out, wrap_seq(c.colors, c.colors.code[cap_no()])), paint);
}

function aligns_quotes(c: Cfg): boolean {
  let laid_out = c.format == fmt_long() || (c.format == fmt_vertical() || c.format == fmt_across()) && c.width != 0 as i64;
  if (!laid_out) {
    return false;
  }
  return c.qmark || c.qstyle == 1 || c.qstyle == 3 || c.qstyle == 6;
}

function wears_quotes(text: string): boolean {
  return text.len() > 0 && (text[0] as i32 == 39 || text[0] as i32 == 34);
}

function some_quoted(c: Cfg, es: Ent[]): boolean {
  if (!aligns_quotes(c)) {
    return false;
  }
  let i = 0;
  while (i < es.len()) {
    if (wears_quotes(quoted_name(c, es[i].name))) {
      return true;
    }
    i += 1;
  }
  return false;
}

function emit_name(c: Cfg, o: Out, p: Paint, e: Ent, long: boolean, pad: boolean): (Out, Paint) {
  let text = quoted_name(c, e.name);
  let lead = o;
  let quoted = wears_quotes(text);
  if (pad && !quoted) {
    lead = put(lead, " ");
  }
  let r: (Out, Paint) = write_name(c, lead, p, e, color_code(c, e), text, true, c.hyperlink && pad && quoted);
  let out = r.0;
  let paint = r.1;
  if (!long || !filetype.is_link(kind_mode(e))) {
    out = put(out, indicator(c, e));
  }
  if (long && e.has_target) {
    out = put(out, " -> ");
    let target = ent_new(e.target, ".");
    if (e.link_ok) {
      target = Ent { ...target, st: FileStat { ...e.st, mode: e.link_mode }, stated: true };
    }
    let code: (string, boolean) = color_code(c, target);
    if (!e.link_ok && cap_set(c.colors, cap_mi())) {
      code = (c.colors.code[cap_mi()], true);
    }
    let t: (Out, Paint) = write_name(c, out, paint, target, code, quoted_name(c, e.target), false, false);
    out = t.0;
    paint = t.1;
    out = put(out, indicator(c, target));
  }
  return (out, paint);
}

function display_len(c: Cfg, w: Widths, e: Ent): i32 {
  let text = quoted_name(c, e.name);
  let pad = 0;
  if (w.pad && !wears_quotes(text)) {
    pad = 1;
  }
  let prefix = 0;
  if (c.inode) {
    prefix = prefix + w.inode + 1;
    if (!e.stated) {
      prefix -= 1;
    }
  }
  if (c.show_blocks) {
    prefix = prefix + w.blocks + 1;
    if (!e.stated) {
      prefix -= 1;
    }
  }
  if (c.show_context && c.format != fmt_long()) {
    prefix = prefix + w.context + 1;
  }
  return prefix + pad + printable_width(text) + indicator(c, e).len();
}

function printable_width(s: string): i32 {
  let n = 0;
  let i = 0;
  while (i < s.len()) {
    let b = s[i] as i32;
    if (b >= 32 && b < 127) {
      n += 1;
    }
    i += 1;
  }
  return n;
}

function column_count(c: Cfg, lens: i32[], by_columns: boolean, width: i32): i32 {
  let n = lens.len();
  let max_cols = width / min_column_width();
  if (width % min_column_width() != 0) {
    max_cols += 1;
  }
  if (max_cols > n) {
    max_cols = n;
  }
  if (max_cols < 1) {
    max_cols = 1;
  }
  let base: i32[] = [];
  let total: i32[] = [];
  let valid: boolean[] = [];
  let flat: i32[] = [];
  let at = 0;
  let i = 0;
  while (i < max_cols) {
    base = base.append(at);
    total = total.append(min_column_width() * (i + 1));
    valid = valid.append(true);
    let j = 0;
    while (j <= i) {
      flat = flat.append(min_column_width());
      j += 1;
    }
    at = at + i + 1;
    i += 1;
  }
  let f = 0;
  while (f < n) {
    let len = lens[f];
    let k = 0;
    while (k < max_cols) {
      if (valid[k]) {
        let cols = k + 1;
        let idx = 0;
        if (by_columns) {
          let rows = (n + k) / cols;
          if (rows > 0) {
            idx = f / rows;
          }
        } else {
          idx = f % cols;
        }
        let want = len;
        if (idx != k) {
          want += 2;
        }
        let slot = base[k] + idx;
        if (flat[slot] < want) {
          total = total.with(k, total[k] + want - flat[slot]);
          flat = flat.with(slot, want);
          valid = valid.with(k, total[k] <= width);
        }
      }
      k += 1;
    }
    f += 1;
  }
  let chosen = 1;
  let c2 = max_cols;
  while (c2 > 1) {
    if (valid[c2 - 1]) {
      chosen = c2;
      break;
    }
    c2 -= 1;
  }
  return chosen;
}

function column_widths(lens: i32[], cols: i32, by_columns: boolean): i32[] {
  let n = lens.len();
  let w: i32[] = [];
  let i = 0;
  while (i < cols) {
    w = w.append(min_column_width());
    i += 1;
  }
  let rows = (n + cols - 1) / cols;
  let f = 0;
  while (f < n) {
    let idx = 0;
    if (by_columns) {
      if (rows > 0) {
        idx = f / rows;
      }
    } else {
      idx = f % cols;
    }
    let want = lens[f];
    if (idx != cols - 1) {
      want += 2;
    }
    if (w[idx] < want) {
      w = w.with(idx, want);
    }
    f += 1;
  }
  return w;
}

function column_start(w: i32[], col: i32): i32 {
  let s = 0;
  let i = 0;
  while (i < col) {
    s += w[i];
    i += 1;
  }
  return s;
}

function eol(c: Cfg): string {
  if (c.zero) {
    return "\x00";
  }
  return "\n";
}

function emit_single(c: Cfg, o: Out, p: Paint, es: Ent[], w: Widths): (Out, Paint) {
  let out = o;
  let paint = p;
  let i = 0;
  while (i < es.len()) {
    let open: (Out, Paint) = start_entry(c, out, paint);
    out = put(open.0, frills(c, w, es[i]));
    paint = open.1;
    let r: (Out, Paint) = emit_name(c, out, paint, es[i], false, w.pad);
    out = r.0;
    paint = r.1;
    out = put(out, eol(c));
    i += 1;
  }
  return (out, paint);
}

function emit_long(c: Cfg, o: Out, p: Paint, es: Ent[], w: Widths): (Out, Paint) {
  let out = o;
  let paint = p;
  let i = 0;
  while (i < es.len()) {
    out = dired_indent(c, out);
    let open: (Out, Paint) = start_entry(c, out, paint);
    out = put_bytes(open.0, long_prefix(c, w, es[i]));
    paint = open.1;
    let r: (Out, Paint) = emit_name(c, out, paint, es[i], true, w.pad);
    out = r.0;
    paint = r.1;
    out = put(out, eol(c));
    i += 1;
  }
  return (out, paint);
}

function emit_separated(c: Cfg, o: Out, p: Paint, es: Ent[], w: Widths, sep: string): (Out, Paint) {
  let out = o;
  let paint = p;
  let width = c.width as i32;
  let pos = 0;
  let i = 0;
  while (i < es.len()) {
    let len = 0;
    if (width != 0) {
      len = display_len(c, w, es[i]);
    }
    if (i > 0) {
      out = put(out, sep);
      let want = pos + len + 2;
      if (sep == "," && i < es.len() - 1) {
        want += 1;
      }
      if (width == 0 || want <= width) {
        pos += 2;
        out = put(out, " ");
      } else {
        pos = 0;
        out = put(out, "\n");
      }
    }
    let open: (Out, Paint) = start_entry(c, out, paint);
    out = put(open.0, frills(c, w, es[i]));
    paint = open.1;
    let r: (Out, Paint) = emit_name(c, out, paint, es[i], false, w.pad);
    out = r.0;
    paint = r.1;
    pos += display_len(c, w, es[i]);
    i += 1;
  }
  if (es.len() > 0) {
    out = put(out, eol(c));
  }
  return (out, paint);
}

function emit_columns(c: Cfg, o: Out, p: Paint, es: Ent[], w: Widths, by_columns: boolean): (Out, Paint) {
  let n = es.len();
  if (c.width == 0 as i64) {
    return emit_separated(c, o, p, es, w, " ");
  }
  let lens: i32[] = [];
  let i = 0;
  while (i < n) {
    lens = lens.append(display_len(c, w, es[i]));
    i += 1;
  }
  let cols = column_count(c, lens, by_columns, c.width as i32);
  let cw = column_widths(lens, cols, by_columns);
  let rows = (n + cols - 1) / cols;
  let out = o;
  let paint = p;
  let r = 0;
  while (r < rows) {
    let pos = 0;
    let col = 0;
    while (col < cols) {
      let idx = 0;
      if (by_columns) {
        idx = col * rows + r;
      } else {
        idx = r * cols + col;
      }
      if (idx >= n) {
        break;
      }
      let start = column_start(cw, col);
      out = put(out, indent(pos, start, c.tabsize as i32));
      let open: (Out, Paint) = start_entry(c, out, paint);
      out = put(open.0, frills(c, w, es[idx]));
      paint = open.1;
      let e: (Out, Paint) = emit_name(c, out, paint, es[idx], false, w.pad);
      out = e.0;
      paint = e.1;
      pos = start + lens[idx];
      col += 1;
    }
    out = put(out, eol(c));
    r += 1;
  }
  return (out, paint);
}

function emit_entries(c: Cfg, o: Out, p: Paint, es: Ent[]): (Out, Paint) {
  return emit_measured(c, o, p, es, measure(c, es));
}

function emit_measured(c: Cfg, o: Out, p: Paint, es: Ent[], w: Widths): (Out, Paint) {
  if (es.len() == 0) {
    return (o, p);
  }
  if (c.format == fmt_long()) {
    return emit_long(c, o, p, es, w);
  }
  if (c.format == fmt_single()) {
    return emit_single(c, o, p, es, w);
  }
  if (c.format == fmt_commas()) {
    return emit_separated(c, o, p, es, w, ",");
  }
  return emit_columns(c, o, p, es, w, c.format == fmt_vertical());
}

function emit_total(c: Cfg, o: Out, es: Ent[]): Out {
  let sum = 0 as i64;
  let i = 0;
  while (i < es.len()) {
    if (es[i].stated) {
      sum += es[i].st.blocks;
    }
    i += 1;
  }
  let text = render(c.bsize, (sum * (512 as i64)) as u64);
  let out = dired_indent(c, o);
  return put(out, "total " + text + eol(c));
}

function hidden(c: Cfg, name: string): boolean {
  if (c.ignore_mode != ignore_default()) {
    return false;
  }
  return name.len() > 0 && name[0] as i32 == 46;
}

function matches_any(pats: string[], name: string): boolean {
  let i = 0;
  while (i < pats.len()) {
    if (fnmatch.fnmatch(pats[i], name)) {
      return true;
    }
    i += 1;
  }
  return false;
}

function ignored(c: Cfg, name: string): boolean {
  if (c.ignore_backups && name.len() > 0 && name[name.len() - 1] as i32 == 126) {
    return true;
  }
  if (matches_any(c.ignores, name)) {
    return true;
  }
  if (c.ignore_mode == ignore_default() && matches_any(c.hides, name)) {
    return true;
  }
  return false;
}

function attach(dir: string, name: string): string {
  if (dir == ".") {
    return name;
  }
  return gnu.join_path(dir, name);
}

function ent_path(e: Ent): string {
  return attach(e.dir, e.name);
}

function dir_entries(c: Cfg, o: Out, path: string, seed: pwdb.Names): (Ent[], Out, pwdb.Names, boolean) {
  let out = o;
  let read: DirEntry[] = [];
  let failed = false;
  let why = "";
  if (c.ignore_mode == ignore_minimal()) {
    match (read_dir_ino_all(path)) {
      Ok(es) => {
        read = es;
      },
      Err(e) => {
        failed = true;
        why = gnu.io_error_text(e);
      }
    }
  } else {
    match (read_dir_ino(path)) {
      Ok(es) => {
        read = es;
      },
      Err(e) => {
        failed = true;
        why = gnu.io_error_text(e);
      }
    }
  }
  if (failed) {
    return ([], fail(out, "cannot open directory " + gnu.quotea(path) + ": " + why, status_minor()), seed, false);
  }
  let list: Ent[] = [];
  for d in read {
    if (hidden(c, d.name) || ignored(c, d.name)) {
      continue;
    }
    list = list.append(Ent { ...ent_new(d.name, path), dkind: d.kind });
  }
  if (!needs_stat(c)) {
    return (list, out, seed, true);
  }
  let ids = seed;
  let filled: Ent[] = [];
  let k = 0;
  while (k < list.len()) {
    if (!stat_needed(c, list[k])) {
      filled = filled.append(list[k]);
      k += 1;
      continue;
    }
    let r: (Ent, boolean, string) = stat_entry(c, list[k], false);
    let e = r.0;
    if (!r.1) {
      let at = ent_path(e);
      out = fail(out, "cannot access " + gnu.quotea(at) + ": " + r.2, status_minor());
      match (lstat(at)) {
        Ok(s) => {
          e = Ent { ...e, link_mode: s.mode };
        },
        Err(_) => {}
      }
    }
    let r2: (Ent, pwdb.Names) = resolve_ids(c, ids, e);
    filled = filled.append(r2.0);
    ids = r2.1;
    k += 1;
  }
  return (filled, out, ids, true);
}

struct Pending { path: string }

struct State { out: Out, paint: Paint, wrote: boolean, queue: Pending[], names: pwdb.Names }

function list_dir(c: Cfg, st: State, p: Pending, header: boolean): State {
  let r: (Ent[], Out, pwdb.Names, boolean) = dir_entries(c, st.out, p.path, st.names);
  let es = r.0;
  let state = State { ...st, out: r.1, names: r.2 };
  if (!r.3) {
    return state;
  }
  if (header) {
    if (state.wrote) {
      state = State { ...state, out: put(state.out, "\n") };
    }
    let h = dired_indent(c, state.out);
    h = put_subdir(c, h, quoted_header(c, p.path));
    state = State { ...state, out: put(h, ":\n") };
  }
  state = State { ...state, wrote: true };
  es = sort_entries(c, es);
  if (c.format == fmt_long() || c.show_blocks) {
    state = State { ...state, out: emit_total(c, state.out, es) };
  }
  let e: (Out, Paint) = emit_entries(c, state.out, state.paint, es);
  state = State { ...state, out: e.0, paint: e.1 };
  if (!c.recursive) {
    return state;
  }
  let subs: Pending[] = [];
  let i = 0;
  while (i < es.len()) {
    let ent = es[i];
    if (filetype.is_dir(kind_mode(ent)) && ent.name != "." && ent.name != "..") {
      subs = subs.append(Pending { path: gnu.join_path(p.path, ent.name) });
    }
    i += 1;
  }
  let q = subs;
  let k = 0;
  while (k < state.queue.len()) {
    q = q.append(state.queue[k]);
    k += 1;
  }
  return State { ...state, queue: q };
}

function run_operands(c: Cfg, o: Out, operands: string[]): Out {
  let files: Ent[] = [];
  let every: Ent[] = [];
  let dirs: Pending[] = [];
  let out = o;
  let ids = id_names_new(c);
  let explicit = operands.len() > 0;
  let args = operands;
  if (!explicit) {
    args = ["."];
  }
  let i = 0;
  while (i < args.len()) {
    let arg = args[i];
    let e = ent_new(arg, ".");
    let r: (Ent, boolean, string) = stat_entry(c, e, true);
    if (!r.1) {
      out = fail(out, "cannot access " + gnu.quotea(arg) + ": " + r.2, status_usage());
      i += 1;
      continue;
    }
    let got0: (Ent, pwdb.Names) = resolve_ids(c, ids, r.0);
    every = every.append(got0.0);
    ids = got0.1;
    i += 1;
  }
  every = sort_entries(c, every);
  let operand_widths = measure(c, every);
  let k2 = 0;
  while (k2 < every.len()) {
    let got = every[k2];
    if (filetype.is_dir(got.st.mode) && !c.immediate_dirs) {
      dirs = dirs.append(Pending { path: got.name });
    } else {
      files = files.append(got);
    }
    k2 += 1;
  }
  let state = State { out: out, paint: paint_new(), wrote: false, queue: dirs, names: ids };
  if (files.len() > 0) {
    let fe: (Out, Paint) = emit_measured(c, state.out, state.paint, files, operand_widths);
    state = State { ...state, out: fe.0, paint: fe.1, wrote: true };
  }
  let header = state.wrote || c.recursive || args.len() > 1 || dirs.len() > 1;
  while (state.queue.len() > 0) {
    let next = state.queue[0];
    let rest: Pending[] = [];
    let k = 1;
    while (k < state.queue.len()) {
      rest = rest.append(state.queue[k]);
      k += 1;
    }
    state = State { ...state, queue: rest };
    state = list_dir(c, state, next, header);
    header = true;
  }
  let done = state.out;
  if (c.color && state.paint.used && (c.colors.lc != "\x1b[" || c.colors.rc != "m")) {
    done = put(done, c.colors.lc + c.colors.rc);
  }
  if (c.dired) {
    if (done.names.len() > 0) {
      done = put(done, dired_line("//DIRED//", done.names));
    }
    if (done.subs.len() > 0) {
      done = put(done, dired_line("//SUBDIRED//", done.subs));
    }
    done = put(done, "//DIRED-OPTIONS// --quoting-style=" + gnu.quoting_style_names()[c.qstyle] + "\n");
  }
  return done;
}

function dired_line(tag: string, offs: i64[]): string {
  let out = tag;
  let i = 0;
  while (i < offs.len()) {
    out = out + " " + offs[i].to_string();
    i += 1;
  }
  return out + "\n";
}

function apply_time_style(c: Cfg, spec: string, from_env: boolean): Cfg {
  if (spec.len() > 0 && spec[0] as i32 == 43) {
    let body = slice_unchecked(spec, 1, spec.len()) + "";
    let parts = body.lines();
    if (parts.len() > 2) {
      gnu.error("invalid time style format " + gnu.quote(body));
      exit(status_usage());
    }
    if (parts.len() == 2) {
      return Cfg { ...c, nonrecent_fmt: timefmt.compile(parts[0]), recent_fmt: timefmt.compile(parts[1]) };
    }
    let f = timefmt.compile(body);
    return Cfg { ...c, nonrecent_fmt: f, recent_fmt: f };
  }
  let name = spec;
  if (name.starts_with("posix-")) {
    name = slice_unchecked(name, 6, name.len()) + "";
    if (name == "full-iso" || name == "long-iso" || name == "iso" || name == "locale") {
      return c;
    }
  }
  if (name == "full-iso") {
    return Cfg { ...c, nonrecent_fmt: timefmt.compile("%Y-%m-%d %H:%M:%S.%N %z"), recent_fmt: timefmt.compile("%Y-%m-%d %H:%M:%S.%N %z") };
  }
  if (name == "long-iso") {
    return Cfg { ...c, nonrecent_fmt: timefmt.compile("%Y-%m-%d %H:%M"), recent_fmt: timefmt.compile("%Y-%m-%d %H:%M") };
  }
  if (name == "iso") {
    return Cfg { ...c, nonrecent_fmt: timefmt.compile("%Y-%m-%d "), recent_fmt: timefmt.compile("%m-%d %H:%M") };
  }
  if (name == "locale") {
    return c;
  }
  gnu.error("invalid argument " + gnu.quote(spec) + " for 'time style'");
  eprint("Valid arguments are:");
  eprint("  - [posix-]full-iso");
  eprint("  - [posix-]long-iso");
  eprint("  - [posix-]iso");
  eprint("  - [posix-]locale");
  eprint("  - +FORMAT (e.g., +%H:%M) for a 'date'-style format");
  gnu.try_help(status_usage());
  return c;
}

function options(): gnu.Opt[] {
  let o: gnu.Opt[] = [];
  o = o.append(gnu.flag("a", "all", op_all()));
  o = o.append(gnu.flag("b", "escape", op_escape()));
  o = o.append(gnu.flag("d", "directory", op_directory()));
  o = o.append(gnu.flag("D", "dired", op_dired()));
  o = o.append(gnu.flag("", "full-time", op_full_time()));
  o = o.append(gnu.flag("", "group-directories-first", op_group_dirs()));
  o = o.append(gnu.flag("h", "human-readable", op_human()));
  o = o.append(gnu.flag("i", "inode", op_inode()));
  o = o.append(gnu.flag("k", "kibibytes", op_kibibytes()));
  o = o.append(gnu.flag("n", "numeric-uid-gid", op_numeric()));
  o = o.append(gnu.flag("G", "no-group", op_no_group()));
  o = o.append(gnu.flag("q", "hide-control-chars", op_hide_control()));
  o = o.append(gnu.flag("r", "reverse", op_reverse()));
  o = o.append(gnu.flag("s", "size", op_size()));
  o = o.append(gnu.valued("w", "width", op_width()));
  o = o.append(gnu.flag("A", "almost-all", op_almost_all()));
  o = o.append(gnu.flag("B", "ignore-backups", op_ignore_backups()));
  o = o.append(gnu.optional_long("F", "classify", op_classify()));
  o = o.append(gnu.flag("", "file-type", op_file_type()));
  o = o.append(gnu.flag("", "si", op_si()));
  o = o.append(gnu.flag("H", "dereference-command-line", op_deref_cmd()));
  o = o.append(gnu.flag("", "dereference-command-line-symlink-to-dir", op_deref_cmd_dir()));
  o = o.append(gnu.valued("", "hide", op_hide()));
  o = o.append(gnu.valued("I", "ignore", op_ignore()));
  o = o.append(gnu.valued("", "indicator-style", op_indicator()));
  o = o.append(gnu.flag("L", "dereference", op_deref()));
  o = o.append(gnu.flag("N", "literal", op_literal()));
  o = o.append(gnu.flag("Q", "quote-name", op_quote_name()));
  o = o.append(gnu.valued("", "quoting-style", op_quoting()));
  o = o.append(gnu.flag("R", "recursive", op_recursive()));
  o = o.append(gnu.valued("", "format", op_format()));
  o = o.append(gnu.flag("", "show-control-chars", op_show_control()));
  o = o.append(gnu.valued("", "sort", op_sort()));
  o = o.append(gnu.valued("T", "tabsize", op_tabsize()));
  o = o.append(gnu.valued("", "time", op_time()));
  o = o.append(gnu.valued("", "time-style", op_time_style()));
  o = o.append(gnu.flag("", "zero", op_zero()));
  o = o.append(gnu.optional_long("", "color", op_color()));
  o = o.append(gnu.optional_long("", "hyperlink", op_hyperlink()));
  o = o.append(gnu.valued("", "block-size", op_block_size()));
  o = o.append(gnu.flag("Z", "context", op_context()));
  o = o.append(gnu.flag("", "author", op_author()));
  o = o.append(gnu.flag("l", "", op_long()));
  o = o.append(gnu.flag("1", "", op_one()));
  o = o.append(gnu.flag("C", "", op_many()));
  o = o.append(gnu.flag("x", "", op_across()));
  o = o.append(gnu.flag("m", "", op_commas()));
  o = o.append(gnu.flag("g", "", op_no_owner()));
  o = o.append(gnu.flag("o", "", op_no_group_long()));
  o = o.append(gnu.flag("c", "", op_ctime()));
  o = o.append(gnu.flag("u", "", op_atime()));
  o = o.append(gnu.flag("t", "", op_sort_time()));
  o = o.append(gnu.flag("S", "", op_sort_size()));
  o = o.append(gnu.flag("U", "", op_sort_none()));
  o = o.append(gnu.flag("v", "", op_sort_version()));
  o = o.append(gnu.flag("X", "", op_sort_ext()));
  o = o.append(gnu.flag("f", "", op_unsorted_all()));
  o = o.append(gnu.flag("p", "", op_slash()));
  return o;
}

function when_names(): string[] {
  return ["always", "yes", "force", "never", "no", "none", "auto", "tty", "if-tty"];
}

function when_values(): i32[] {
  return [when_always(), when_always(), when_always(), when_never(), when_never(), when_never(), when_auto(), when_auto(), when_auto()];
}

function parse_when(m: gnu.OptMatch, option: string): i32 {
  if (!m.has_value) {
    return when_always();
  }
  return gnu.argmatch_valued(m.value, when_names(), when_values(), option);
}

function when_on(w: i32): boolean {
  if (w == when_always()) {
    return true;
  }
  if (w == when_never()) {
    return false;
  }
  return isatty(1);
}

function format_names(): string[] {
  return ["verbose", "long", "commas", "horizontal", "across", "vertical", "single-column"];
}

function format_values(): i32[] {
  return [fmt_long(), fmt_long(), fmt_commas(), fmt_across(), fmt_across(), fmt_vertical(), fmt_single()];
}

function sort_names(): string[] {
  return ["none", "size", "time", "version", "extension", "name", "width"];
}

function sort_values(): i32[] {
  return [sort_none(), sort_size(), sort_time(), sort_version(), sort_ext(), sort_name(), sort_width()];
}

function time_names(): string[] {
  return ["atime", "access", "use", "ctime", "status", "mtime", "modification", "birth", "creation"];
}

function time_values(): i32[] {
  return [time_atime(), time_atime(), time_atime(), time_ctime(), time_ctime(), time_mtime(), time_mtime(), time_birth(), time_birth()];
}

function indicator_names(): string[] {
  return ["none", "slash", "file-type", "classify"];
}

function parse_ulong0(spec: string): (i64, boolean) {
  let n = spec.len();
  let i = 0;
  while (i < n && gnu.is_blank(spec[i] as i32)) {
    i += 1;
  }
  if (i < n && spec[i] as i32 == 43) {
    i += 1;
  }
  if (i >= n) {
    return (0 as i64, false);
  }
  let base = 10 as i64;
  if (spec[i] as i32 == 48) {
    if (i + 1 < n && (spec[i + 1] as i32 == 120 || spec[i + 1] as i32 == 88)) {
      base = 16 as i64;
      i += 2;
      if (i >= n) {
        return (0 as i64, false);
      }
    } else {
      base = 8 as i64;
      i += 1;
      if (i >= n) {
        return (0 as i64, true);
      }
    }
  }
  let v = 0 as i64;
  while (i < n) {
    let d = hex_value(spec[i] as i32);
    if (d < 0 || d as i64 >= base) {
      return (0 as i64, false);
    }
    v = v * base + d as i64;
    if (v > 2147483647 as i64) {
      v = 2147483647 as i64;
    }
    i += 1;
  }
  return (v, true);
}

function parse_count(spec: string, what: string): i64 {
  let r: (i64, boolean) = parse_ulong0(spec);
  if (!r.1) {
    gnu.error("invalid " + what + ": " + gnu.quote(spec));
    exit(status_usage());
  }
  return r.0;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out += "List information about the FILEs (the current directory by default).\n";
  out += "Entries are sorted alphabetically unless an option below says otherwise.\n";
  out += "\n";
  out += "  -a, --all                  do not ignore entries starting with .\n";
  out += "  -A, --almost-all           do not list implied . and ..\n";
  out += "      --author               with -l, print the author of each file\n";
  out += "  -b, --escape               print C-style escapes for nongraphic characters\n";
  out += "      --block-size=SIZE      scale sizes by SIZE before printing them\n";
  out += "  -B, --ignore-backups       do not list entries ending with ~\n";
  out += "  -c                         with -l, show and sort by ctime\n";
  out += "  -C                         list entries by columns\n";
  out += "      --color[=WHEN]         colour the output; WHEN is always, auto or never\n";
  out += "  -d, --directory            list directories themselves, not their contents\n";
  out += "  -D, --dired                generate output designed for Emacs' dired mode\n";
  out += "  -f                         do not sort, enable -aU\n";
  out += "  -F, --classify[=WHEN]      append an indicator (one of */=>@|) to entries\n";
  out += "      --file-type            likewise, except do not append '*'\n";
  out += "      --format=WORD          across, commas, horizontal, long, single-column,\n";
  out += "                               verbose, vertical\n";
  out += "      --full-time            like -l --time-style=full-iso\n";
  out += "  -g                         like -l, but do not list the owner\n";
  out += "      --group-directories-first  list directories before files\n";
  out += "  -G, --no-group             in a long listing, do not print group names\n";
  out += "  -h, --human-readable       with -l and -s, print sizes like 1K 234M 2G\n";
  out += "      --si                   likewise, but use powers of 1000 not 1024\n";
  out += "  -H, --dereference-command-line  follow symbolic links on the command line\n";
  out += "      --dereference-command-line-symlink-to-dir  follow each command line\n";
  out += "                               symbolic link that points to a directory\n";
  out += "      --hide=PATTERN         do not list entries matching PATTERN\n";
  out += "                               (overridden by -a or -A)\n";
  out += "      --hyperlink[=WHEN]     hyperlink file names; WHEN as for --color\n";
  out += "      --indicator-style=WORD  append an indicator to entry names: none,\n";
  out += "                               slash (-p), file-type, classify (-F)\n";
  out += "  -i, --inode                print the index number of each file\n";
  out += "  -I, --ignore=PATTERN       do not list entries matching PATTERN\n";
  out += "  -k, --kibibytes            default to 1024-byte blocks for disk usage\n";
  out += "  -l                         use a long listing format\n";
  out += "  -L, --dereference          show information for the link's referent\n";
  out += "  -m                         fill width with a comma separated list\n";
  out += "  -n, --numeric-uid-gid      like -l, but list numeric user and group ids\n";
  out += "  -N, --literal              print entry names without quoting\n";
  out += "  -o                         like -l, but do not list group information\n";
  out += "  -p                         append / indicator to directories\n";
  out += "  -q, --hide-control-chars   print ? instead of nongraphic characters\n";
  out += "      --show-control-chars   show nongraphic characters as-is\n";
  out += "  -Q, --quote-name           enclose entry names in double quotes\n";
  out += "      --quoting-style=WORD   literal, locale, shell, shell-always,\n";
  out += "                               shell-escape, shell-escape-always, c, escape\n";
  out += "  -r, --reverse              reverse order while sorting\n";
  out += "  -R, --recursive            list subdirectories recursively\n";
  out += "  -s, --size                 print the allocated size of each file, in blocks\n";
  out += "  -S                         sort by file size, largest first\n";
  out += "      --sort=WORD            sort by WORD instead of name: none (-U), size (-S),\n";
  out += "                               time (-t), version (-v), extension (-X), width\n";
  out += "      --time=WORD            select which timestamp is shown and sorted by\n";
  out += "      --time-style=STYLE     time/date format with -l; STYLE is full-iso,\n";
  out += "                               long-iso, iso, locale, or +FORMAT\n";
  out += "  -t                         sort by time, newest first\n";
  out += "  -T, --tabsize=COLS         assume tab stops at each COLS instead of 8\n";
  out += "  -u                         with -lt sort by, and show, access time\n";
  out += "  -U                         do not sort; list entries in directory order\n";
  out += "  -v                         natural sort of (version) numbers within text\n";
  out += "  -w, --width=COLS           set output width to COLS; 0 means no limit\n";
  out += "  -x                         list entries by lines instead of by columns\n";
  out += "  -X                         sort alphabetically by entry extension\n";
  out += "  -Z, --context              print any security context of each file\n";
  out += "      --zero                 end each output line with NUL, not newline\n";
  out += "  -1                         list one file per line\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  out += "\n";
  out += "The SIZE argument is an integer with an optional unit: K, M, G, T, P, E, Z, Y,\n";
  out += "R or Q for powers of 1024, or KB, MB and so on for powers of 1000.\n";
  out += "\n";
  out += "The WHEN argument of --color, --classify and --hyperlink defaults to 'always'.\n";
  out += "With 'auto' the decision is whether standard output is a terminal.\n";
  out += "\n";
  out += "Exit status is 0 if all went well, 1 if a file could not be reached, and 2 if\n";
  out += "there was a serious trouble such as an unusable option.\n";
  return out;
}

struct Scan { c: Cfg, width_seen: boolean, hide_opt: i32, operands: string[] }

function scan(argv: string[], start: Cfg): Scan {
  let c = start;
  let hide_opt: i32 = -1;
  c = Cfg { ...c, qstyle: gnu.quoting_style_from_env_with(c.qstyle) };
  let g = gnu.getopt_new(argv, options(), gnu.prog(), help_text(), status_usage());
  let format_opt: i32 = -1;
  let sort_opt: i32 = -1;
  let explicit_time = false;
  let deref_seen = false;
  let kibibytes = false;
  let width_seen = false;
  let color_when = when_never();
  let link_when = when_never();
  let block_spec_seen = false;
  let time_style = "";
  let time_style_seen = false;
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == op_all()) {
          c = Cfg { ...c, ignore_mode: ignore_minimal() };
        } else if (m.id == op_almost_all()) {
          c = Cfg { ...c, ignore_mode: ignore_dot_and_dotdot() };
        } else if (m.id == op_author()) {
          c = Cfg { ...c, show_author: true };
        } else if (m.id == op_escape()) {
          c = Cfg { ...c, qstyle: 7 };
        } else if (m.id == op_literal()) {
          c = Cfg { ...c, qstyle: 0 };
        } else if (m.id == op_quote_name()) {
          c = Cfg { ...c, qstyle: 5 };
        } else if (m.id == op_quoting()) {
          c = Cfg { ...c, qstyle: gnu.argmatch(m.value, gnu.quoting_style_names(), "--quoting-style") };
        } else if (m.id == op_hide_control()) {
          c = Cfg { ...c, qmark: true };
          hide_opt = 1;
        } else if (m.id == op_show_control()) {
          c = Cfg { ...c, qmark: false };
          hide_opt = 0;
        } else if (m.id == op_directory()) {
          c = Cfg { ...c, immediate_dirs: true };
        } else if (m.id == op_dired()) {
          c = Cfg { ...c, dired: true };
          format_opt = fmt_long();
          link_when = when_never();
        } else if (m.id == op_full_time()) {
          format_opt = fmt_long();
          time_style = "full-iso";
          time_style_seen = true;
        } else if (m.id == op_group_dirs()) {
          c = Cfg { ...c, dirs_first: true };
        } else if (m.id == op_human()) {
          c = Cfg { ...c, fsize: blocks.human_unit(1024 as u64), bsize: blocks.human_unit(1024 as u64) };
          block_spec_seen = true;
        } else if (m.id == op_si()) {
          c = Cfg { ...c, fsize: blocks.human_unit(1000 as u64), bsize: blocks.human_unit(1000 as u64) };
          block_spec_seen = true;
        } else if (m.id == op_block_size()) {
          let n = blocks.parse_num(m.value, false, true, false);
          if (n.status != blocks.size_ok()) {
            blocks.die_size_with(n.status, "--block-size", m.value, status_usage());
          }
          c = Cfg { ...c, fsize: blocks.unit_from(n), bsize: blocks.unit_from(n) };
          block_spec_seen = true;
        } else if (m.id == op_kibibytes()) {
          kibibytes = true;
        } else if (m.id == op_inode()) {
          c = Cfg { ...c, inode: true };
        } else if (m.id == op_size()) {
          c = Cfg { ...c, show_blocks: true };
        } else if (m.id == op_numeric()) {
          c = Cfg { ...c, numeric_ids: true };
          format_opt = fmt_long();
        } else if (m.id == op_no_group()) {
          c = Cfg { ...c, show_group: false };
        } else if (m.id == op_no_owner()) {
          c = Cfg { ...c, show_owner: false };
          format_opt = fmt_long();
        } else if (m.id == op_no_group_long()) {
          c = Cfg { ...c, show_group: false };
          format_opt = fmt_long();
        } else if (m.id == op_reverse()) {
          c = Cfg { ...c, reverse: true };
        } else if (m.id == op_recursive()) {
          c = Cfg { ...c, recursive: true };
        } else if (m.id == op_width()) {
          c = Cfg { ...c, width: parse_count(m.value, "line width") };
          width_seen = true;
        } else if (m.id == op_tabsize()) {
          c = Cfg { ...c, tabsize: parse_count(m.value, "tab size") };
        } else if (m.id == op_ignore_backups()) {
          c = Cfg { ...c, ignore_backups: true };
        } else if (m.id == op_ignore()) {
          c = Cfg { ...c, ignores: c.ignores.append(m.value) };
        } else if (m.id == op_hide()) {
          c = Cfg { ...c, hides: c.hides.append(m.value) };
        } else if (m.id == op_classify()) {
          if (when_on(parse_when(m, "--classify"))) {
            c = Cfg { ...c, indicator: ind_classify() };
          } else {
            c = Cfg { ...c, indicator: ind_none() };
          }
        } else if (m.id == op_file_type()) {
          c = Cfg { ...c, indicator: ind_file_type() };
        } else if (m.id == op_slash()) {
          c = Cfg { ...c, indicator: ind_slash() };
        } else if (m.id == op_indicator()) {
          c = Cfg { ...c, indicator: gnu.argmatch(m.value, indicator_names(), "--indicator-style") };
        } else if (m.id == op_deref()) {
          c = Cfg { ...c, deref: deref_all() };
          deref_seen = true;
        } else if (m.id == op_deref_cmd()) {
          c = Cfg { ...c, deref: deref_cmd() };
          deref_seen = true;
        } else if (m.id == op_deref_cmd_dir()) {
          c = Cfg { ...c, deref: deref_cmd_dir() };
          deref_seen = true;
        } else if (m.id == op_format()) {
          format_opt = gnu.argmatch_valued(m.value, format_names(), format_values(), "--format");
        } else if (m.id == op_long()) {
          format_opt = fmt_long();
        } else if (m.id == op_one()) {
          if (format_opt != fmt_long()) {
            format_opt = fmt_single();
          }
        } else if (m.id == op_many()) {
          format_opt = fmt_vertical();
        } else if (m.id == op_across()) {
          format_opt = fmt_across();
        } else if (m.id == op_commas()) {
          format_opt = fmt_commas();
        } else if (m.id == op_sort()) {
          sort_opt = gnu.argmatch_valued(m.value, sort_names(), sort_values(), "--sort");
        } else if (m.id == op_sort_time()) {
          sort_opt = sort_time();
        } else if (m.id == op_sort_size()) {
          sort_opt = sort_size();
        } else if (m.id == op_sort_none()) {
          sort_opt = sort_none();
        } else if (m.id == op_sort_version()) {
          sort_opt = sort_version();
        } else if (m.id == op_sort_ext()) {
          sort_opt = sort_ext();
        } else if (m.id == op_unsorted_all()) {
          c = Cfg { ...c, ignore_mode: ignore_minimal() };
          sort_opt = sort_none();
        } else if (m.id == op_time()) {
          c = Cfg { ...c, time_type: gnu.argmatch_valued(m.value, time_names(), time_values(), "--time") };
          explicit_time = true;
        } else if (m.id == op_ctime()) {
          c = Cfg { ...c, time_type: time_ctime() };
          explicit_time = true;
        } else if (m.id == op_atime()) {
          c = Cfg { ...c, time_type: time_atime() };
          explicit_time = true;
        } else if (m.id == op_time_style()) {
          time_style = m.value;
          time_style_seen = true;
        } else if (m.id == op_zero()) {
          c = Cfg { ...c, zero: true, qmark: false, qstyle: 0 };
          if (format_opt != fmt_long()) {
            format_opt = fmt_single();
          }
        } else if (m.id == op_color()) {
          color_when = parse_when(m, "--color");
        } else if (m.id == op_hyperlink()) {
          link_when = parse_when(m, "--hyperlink");
        } else if (m.id == op_context()) {
          c = Cfg { ...c, show_context: true };
        }
      },
      None => {
        break;
      }
    }
  }
  if (format_opt >= 0) {
    c = Cfg { ...c, format: format_opt };
  }
  if (sort_opt >= 0) {
    c = Cfg { ...c, sort_key: sort_opt };
  } else if (c.format != fmt_long() && explicit_time) {
    c = Cfg { ...c, sort_key: sort_time() };
  }
  if (c.deref == deref_none() && !deref_seen) {
    if (!c.immediate_dirs && c.indicator != ind_classify() && c.format != fmt_long()) {
      c = Cfg { ...c, deref: deref_cmd_dir() };
    }
  }
  if (c.dired && c.zero) {
    gnu.error("--dired and --zero are incompatible");
    exit(status_usage());
  }
  c = Cfg { ...c, color: when_on(color_when), hyperlink: when_on(link_when) };
  if (c.hyperlink) {
    c = Cfg { ...c, dired: false };
  }
  if (c.color) {
    let spec = "";
    match (env("LS_COLORS")) {
      Some(v) => {
        spec = v;
      },
      None => {}
    }
    if (spec.len() > 0) {
      c = Cfg { ...c, colors: parse_ls_colors(spec) };
    } else if (colorterm_set() || colordb.term_known(env_or_empty("TERM"))) {
      c = Cfg { ...c, colors: palette_default() };
    } else {
      c = Cfg { ...c, colors: palette_off() };
    }
    if (!c.colors.on) {
      c = Cfg { ...c, color: false };
    }
  }
  if (c.color) {
    c = Cfg { ...c, tabsize: 0 as i64 };
  }
  if (c.format != fmt_long()) {
    c = Cfg { ...c, dired: false };
  }
  if (!time_style_seen) {
    match (env("TIME_STYLE")) {
      Some(v) => {
        time_style = v;
        time_style_seen = true;
      },
      None => {}
    }
  }
  if (time_style_seen) {
    c = apply_time_style(c, time_style, false);
  }
  if (!block_spec_seen) {
    let u = blocks.env_unit(["LS_BLOCK_SIZE", "BLOCK_SIZE", "BLOCKSIZE"]);
    c = Cfg { ...c, bsize: u };
    if (env_named_block_size()) {
      c = Cfg { ...c, fsize: u };
    }
  }
  if (kibibytes) {
    c = Cfg { ...c, bsize: blocks.plain_unit(1024 as u64) };
  }
  return Scan { c: c, width_seen: width_seen, hide_opt: hide_opt, operands: g.operands() };
}

function env_or_empty(name: string): string {
  match (env(name)) {
    Some(v) => {
      return v;
    },
    None => {
      return "";
    }
  }
}

function colorterm_set(): boolean {
  return env_or_empty("COLORTERM").len() > 0;
}

function env_named_block_size(): boolean {
  match (env("LS_BLOCK_SIZE")) {
    Some(_) => {
      return true;
    },
    None => {}
  }
  match (env("BLOCK_SIZE")) {
    Some(_) => {
      return true;
    },
    None => {}
  }
  return false;
}

function resolve_width(c: Cfg, seen: boolean): Cfg {
  if (seen) {
    return c;
  }
  match (window_size(1)) {
    Ok(ws) => {
      if (ws.cols > 0 as i64) {
        return Cfg { ...c, width: ws.cols };
      }
    },
    Err(_) => {}
  }
  match (env("COLUMNS")) {
    Some(v) => {
      if (v.len() > 0) {
        let r: (i64, boolean) = parse_ulong0(v);
        if (r.1) {
          return Cfg { ...c, width: r.0 };
        }
        gnu.error("ignoring invalid width in environment variable COLUMNS: " + gnu.quote(v));
      }
    },
    None => {}
  }
  return c;
}

pub function ls(): i32 {
  if (isatty(1)) {
    return run(fmt_vertical(), qstyle_shell_escape(), true);
  }
  return run(fmt_single(), qstyle_literal(), false);
}

pub function dir(): i32 {
  return run(fmt_vertical(), qstyle_escape(), false);
}

pub function vdir(): i32 {
  return run(fmt_long(), qstyle_escape(), false);
}

function qstyle_literal(): i32 {
  return 0;
}

function qstyle_shell_escape(): i32 {
  return 3;
}

function qstyle_escape(): i32 {
  return 7;
}

function run(format: i32, qstyle: i32, qmark: boolean): i32 {
  let argv = args();
  let start = defaults(format, qstyle, qmark);
  let s = scan(argv, start);
  let c = resolve_width(s.c, s.width_seen);
  c = Cfg { ...c, qmark_newline: s.hide_opt != 0 && !c.zero && (c.width != 0 as i64 && (c.format == fmt_commas() || c.format == fmt_vertical() || c.format == fmt_across()) || c.format == fmt_single() || c.format == fmt_long()) };
  c = Cfg { ...c, zone: tz.local_zone(), now: now_unix_ms() / (1000 as i64) };
  let o = run_operands(c, out_new(), s.operands);
  let status = o.status;
  gnu.close_stdout_with(o.w, false, status_usage());
  return status;
}
