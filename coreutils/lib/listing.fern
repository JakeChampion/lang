// coreutils/lib/listing.fern — the whole of `ls`, and with it the two
// programs that ARE ls with different option defaults: `dir` is
// `ls -C -b` and `vdir` is `ls -l -b`. Three files, one implementation;
// `run(defaults)` is the entry point and the caller names nothing else.
//
// Five of its rules are not in any man page and were measured from the
// reference binary.
//
// **The column layout is not a uniform grid.** Each column is sized to
// the longest name IN THAT COLUMN plus a two-space separator, the last
// column getting no separator, and every column has a FLOOR of three
// characters. The column count is the largest whose total is STRICTLY
// less than the width — a listing that exactly fills the line is
// refused, which is the spare cell a terminal needs so that the cursor
// landing past the last column does not wrap.
//
// **The padding is tab-aware and that is byte-visible.** Moving from
// column `f` to column `t` emits a tab exactly while
// `t / tabsize > (f + 1) / tabsize`, and spaces otherwise — so a name
// ending at 7 with the next column at 11 gets four SPACES under the
// default tab size of 8, while one ending at 3 gets a tab and three
// spaces. `-T 0` turns tabs off.
//
// **A width of zero means unlimited**, and it does not mean "one very
// wide grid": the whole listing goes on ONE line with entries joined by
// two spaces, which is the same code path `-m` takes with a comma.
//
// **The six-month window is a fixed number of SECONDS, not a calendar
// offset.** The average Gregorian year is 31556952 seconds and the
// window is half of it, 15778476 — so the boundary lands on the
// 182.62-day mark and not on the same day six months back. Any FUTURE
// timestamp takes the year format with no grace at all.
//
// **`-q` substitutes after quoting, and only for three styles.** It
// replaces every non-printable byte of the ALREADY QUOTED name with
// `?`, which is why `-q -b` is just `-b` (the escape style leaves no
// non-printable byte to replace) and why `-q --quoting-style=shell`
// leaves a control-byte name UNQUOTED: the quoting decision was taken
// before the `?` went in.
//
// The two `-l` time formats are one `--time-style` value with a
// newline in it, line 1 for a non-recent time and line 2 for a recent
// one, so the C-locale default is `%b %e  %Y` and `%b %e %H:%M` — the
// alignment is the format's own (two spaces before the year, `%e`
// space-padded), not a separate pass. `iso` works the same way with a
// TRAILING space on its non-recent line.
//
// What it leans on rather than reinvents: `lib/gnu.fern` for the option
// scan, the ten quoting styles and ARGMATCH; `lib/timefmt.fern` for
// nstrftime and the broken-down local time; `lib/blocks.fern` for
// `--block-size` and the `-h` / `--si` rendering; `lib/pwdb.fern` for
// the owner and group columns; `lib/tabs.fern`'s tab-stop arithmetic is
// NOT used — `indent` above is its own rule and a stop table cannot
// express it; `lib/filetype.fern` for the mode string and the kinds.
//
// `-Z` reports `?` for every file, which is what GNU reports on a
// kernel with no SELinux: it short-circuits on `is_selinux_enabled()`
// before asking for a context. On a kernel that HAS SELinux the answer
// needs `getxattr` (#9098), the same gap `stat %C` has.
import "std/string";
import "std/array";
import "std/i64";
import "std/u64";
import "std/io_buffered";
import "./gnu";
import "./blocks";
import "./canon";
import "./colordb";
import "./filetype";
import "./fnmatch";
import "./pwdb";
import "./timefmt";
import "./tz";
import "./selinux";
import "./vercmp";

// ---- option identifiers -----------------------------------------------------
// The long options are declared in GNU's order, because the ambiguity
// list prints its candidates in it: `ls --=x` names all 44.
function op_all(): i32 {
  return 1;
}

function op_escape(): i32 {
  return 2;
}

function op_directory(): i32 {
  return 3;
}

function op_dired(): i32 {
  return 4;
}

function op_full_time(): i32 {
  return 5;
}

function op_group_dirs(): i32 {
  return 6;
}

function op_human(): i32 {
  return 7;
}

function op_inode(): i32 {
  return 8;
}

function op_kibibytes(): i32 {
  return 9;
}

function op_numeric(): i32 {
  return 10;
}

function op_no_group(): i32 {
  return 11;
}

function op_hide_control(): i32 {
  return 12;
}

function op_reverse(): i32 {
  return 13;
}

function op_size(): i32 {
  return 14;
}

function op_width(): i32 {
  return 15;
}

function op_almost_all(): i32 {
  return 16;
}

function op_ignore_backups(): i32 {
  return 17;
}

function op_classify(): i32 {
  return 18;
