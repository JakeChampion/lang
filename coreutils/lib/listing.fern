pub struct Cfg { format: i32, ignore_mode: i32, sort_key: i32, reverse: boolean, time_type: i32, deref: i32, immediate_dirs: boolean, recursive: boolean, inode: boolean, show_blocks: boolean, indicator: i32, qstyle: i32, qmark: boolean, qmark_newline: boolean, show_owner: boolean, show_group: boolean, show_author: boolean, numeric_ids: boolean, show_context: boolean, width: i64, tabsize: i64, ignores: string[], hides: string[], ignore_backups: boolean, dirs_first: boolean, dired: boolean, hyperlink: boolean, color: boolean, zero: boolean, fsize: blocks.Unit, bsize: blocks.Unit, nonrecent_fmt: timefmt.Format, recent_fmt: timefmt.Format, zone: tz.Zone, now: i64, colors: Palette }

pub function defaults(format: i32, qstyle: i32, qmark: boolean): Cfg {
  return Cfg { format: format, ignore_mode: ignore_default(), sort_key: sort_name(), reverse: false, time_type: time_mtime(), deref: deref_none(), immediate_dirs: false, recursive: false, inode: false, show_blocks: false, indicator: ind_none(), qstyle: qstyle, qmark: qmark, qmark_newline: false, show_owner: true, show_group: true, show_author: false, numeric_ids: false, show_context: false, width: 80 as i64, tabsize: 8 as i64, ignores: [], hides: [], ignore_backups: false, dirs_first: false, dired: false, hyperlink: false, color: false, zero: false, fsize: blocks.plain_unit(1 as u64), bsize: blocks.default_unit(), nonrecent_fmt: timefmt.compile("%b %e  %Y"), recent_fmt: timefmt.compile("%b %e %H:%M"), zone: tz.utc_zone(), now: 0 as i64, colors: palette_off() };
}

struct Out { w: io_buffered.BufWriter, pos: i64, names: i64[], subs: i64[], status: i32 }

function out_new(): Out {
  return Out { w: gnu.out_new(), pos: 0 as i64, names: [], subs: [], status: 0 };
}

function put(o: Out, s: string): Out {
  if (s.len() == 0) {
    return o;
  }
  return Out { ...o, w: gnu.put_with(o.w, s, status_usage()), pos: o.pos + s.len() as i64 };
}

function put_bytes(o: Out, bytes: u8[]): Out {
  if (bytes.len() == 0) {
    return o;
  }
  return Out { ...o, w: gnu.put_bytes_with(o.w, bytes, status_usage()), pos: o.pos + bytes.len() as i64 };
}

function put_name(c: Cfg, o: Out, s: string): Out {
  let start = o.pos;
  let next = put(o, s);
  if (!c.dired) {
    return next;
  }
  return Out { ...next, names: next.names.append(start).append(next.pos) };
}

function put_subdir(c: Cfg, o: Out, s: string): Out {
  let start = o.pos;
  let next = put(o, s);
  if (!c.dired) {
    return next;
  }
  return Out { ...next, subs: next.subs.append(start).append(next.pos) };
}

function dired_indent(c: Cfg, o: Out): Out {
  if (c.dired) {
    return put(o, "  ");
  }
  return o;
}

function fail(o: Out, msg: string, status: i32): Out {
  let worst = o.status;
  if (status > worst) {
    worst = status;
  }
  return Out { ...o, w: gnu.error_out(o.w, msg), status: worst };
}

function spaces(n: i32): string {
  if (n <= 0) {
    return "";
  }
  let pool = "                                                                ";
  if (n <= pool.len()) {
    return slice_unchecked(pool, 0, n) + "";
  }
  let bs: u8[] = [];
  let i = 0;
  while (i < n) {
    bs = bs.append(32 as u8);
    i += 1;
  }
  return string_from_bytes_unchecked(bs);
}

function pad_left(s: string, w: i32): string {
  return spaces(w - s.len()) + s;
}

function pad_right(s: string, w: i32): string {
  return s + spaces(w - s.len());
}

function indent(from: i32, to: i32, size: i32): string {
  let bs: u8[] = [];
  let f = from;
  while (f < to) {
    if (size != 0 && to / size > (f + 1) / size) {
      bs = bs.append(9 as u8);
      f += size - f % size;
    } else {
      bs = bs.append(32 as u8);
      f += 1;
    }
  }
  return string_from_bytes_unchecked(bs);
}

function digits_u64(n: u64): i32 {
  return n.to_string().len();
}

function cap_names(): string[] {
  return ["no", "fi", "di", "ln", "pi", "so", "bd", "cd", "mi", "or", "ex", "do", "su", "sg", "st", "ow", "tw", "ca", "mh", "cl", "lc", "rc", "ec", "rs"];
}

