import "std/string";
import "std/array";
import "std/u64";
import "./gnu";

function valid_suffix(c: i32, wide: boolean): boolean {
  if (wide) {
    return c == 107 || c == 75 || c == 109 || c == 77 || c == 71 || c == 84 || c == 80 || c == 69 || c == 90 || c == 89 || c == 82 || c == 81;
  }
  return c == 101 || c == 69 || c == 103 || c == 71 || c == 107 || c == 75 || c == 109 || c == 77 || c == 112 || c == 80 || c == 116 || c == 84 || c == 121 || c == 89 || c == 122 || c == 90;
}

function suffix_power(c: i32): i32 {
  if (c == 107 || c == 75) {
    return 1;
  }
  if (c == 109 || c == 77) {
    return 2;
  }
  if (c == 103 || c == 71) {
    return 3;
  }
  if (c == 116 || c == 84) {
    return 4;
  }
  if (c == 80) {
    return 5;
  }
  if (c == 69) {
    return 6;
  }
  if (c == 90) {
    return 7;
  }
  if (c == 89) {
    return 8;
  }
  if (c == 82) {
    return 9;
  }
  if (c == 81) {
    return 10;
  }
  return 0;
}

function power_letter(p: i32, base: u64): string {
  if (p <= 0) {
    return "";
  }
  if (p == 1) {
    if (base == 1000 as u64) {
      return "k";
    }
    return "K";
  }
  if (p == 2) {
    return "M";
  }
  if (p == 3) {
    return "G";
  }
  if (p == 4) {
    return "T";
  }
  if (p == 5) {
    return "P";
  }
  if (p == 6) {
    return "E";
  }
  if (p == 7) {
    return "Z";
  }
  return "Y";
}

pub struct Num { value: u64, neg: boolean, base: u64, with_b: boolean, show_suffix: boolean, human: u64, status: i32 }

pub function size_ok(): i32 {
  return 0;
}

function size_invalid(): i32 {
  return 1;
}

function size_bad_suffix(): i32 {
  return 2;
}

function size_overflow(): i32 {
  return 3;
}

function mul_checked(a: u64, b: u64): (u64, boolean) {
  if (a == 0 as u64 || b == 0 as u64) {
    return (0 as u64, false);
  }
  let p: u64 = a * b;
  if (p / b != a) {
    return (0 as u64, true);
  }
  return (p, false);
}

pub function hex_digit(c: i32): i32 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return 0 - 1;
}

pub function scan_number(s: string, start: i32): (u64, i32, boolean) {
  if (start + 1 < s.len() && s[start] as i32 == 48 && (s[start + 1] as i32 == 120 || s[start + 1] as i32 == 88)) {
    let j: i32 = start + 2;
    let hv: u64 = 0 as u64;
    let hany: boolean = false;
    let hover: boolean = false;
    while (j < s.len()) {
      let d: i32 = hex_digit(s[j] as i32);
      if (d < 0) {
        break;
      }
      hany = true;
      let m: (u64, boolean) = mul_checked(hv, 16 as u64);
      if (m.1) {
        hover = true;
      }
      hv = m.0 + d as u64;
      j = j + 1;
    }
    if (!hany) {
      return (0 as u64, start + 1, false);
    }
    return (hv, j, hover);
  }
  let base: u64 = 10 as u64;
  if (start < s.len() && s[start] as i32 == 48) {
    base = 8 as u64;
  }
  let i: i32 = start;
  let v: u64 = 0 as u64;
  let any: boolean = false;
  let over: boolean = false;
  while (i < s.len() && gnu.is_digit(s[i] as i32)) {
    let d: i32 = s[i] as i32 - 48;
    if (base == 8 as u64 && d > 7) {
      break;
    }
    any = true;
    let m: (u64, boolean) = mul_checked(v, base);
    if (m.1) {
      over = true;
    }
    v = m.0 + d as u64;
    i = i + 1;
  }
  if (!any) {
    return (0 as u64, start, false);
  }
  return (v, i, over);
}

function scan_unit(s: string, i: i32, wide: boolean): (u64, u64, i32) {
  if (i >= s.len()) {
    return (1 as u64, 1024 as u64, size_ok());
  }
  if (!valid_suffix(s[i] as i32, wide)) {
    return (0 as u64, 0 as u64, size_bad_suffix());
  }
  let p: i32 = suffix_power(s[i] as i32);
  if (p == 0) {
    return (0 as u64, 0 as u64, size_bad_suffix());
  }
  let base: u64 = 1024 as u64;
  let rest: i32 = i + 1;
  if (rest < s.len() && s[rest] as i32 == 66) {
    base = 1000 as u64;
    rest = rest + 1;
  } else if (rest + 1 < s.len() && s[rest] as i32 == 105 && s[rest + 1] as i32 == 66) {
    rest = rest + 2;
  }
  if (rest != s.len()) {
    return (0 as u64, 0 as u64, size_bad_suffix());
  }
  let m: u64 = 1 as u64;
  let k: i32 = 0;
  while (k < p) {
    let r: (u64, boolean) = mul_checked(m, base);
    if (r.1) {
      return (0 as u64, base, size_overflow());
    }
    m = r.0;
    k = k + 1;
  }
  return (m, base, size_ok());
}

function bad_num(status: i32): Num {
  return Num { value: 0 as u64, neg: false, base: 1024 as u64, with_b: false, show_suffix: false, human: 0 as u64, status: status };
}

pub function parse_num(spec: string, wide: boolean, words: boolean, signed: boolean): Num {
  let s: string = spec;
  if (words) {
    if (s.len() > 0 && s[0] as i32 == 39) {
      s = slice_unchecked(s, 1, s.len()) + "";
    }
    if (s == "human-readable") {
      return Num { value: 1 as u64, neg: false, base: 1024 as u64, with_b: false, show_suffix: false, human: 1024 as u64, status: size_ok() };
    }
    if (s == "si") {
      return Num { value: 1 as u64, neg: false, base: 1000 as u64, with_b: false, show_suffix: false, human: 1000 as u64, status: size_ok() };
    }
  }
  let i: i32 = 0;
  while (i < s.len() && gnu.is_blank(s[i] as i32)) {
    i = i + 1;
  }
  let neg: boolean = false;
  if (i < s.len() && s[i] as i32 == 43) {
    i = i + 1;
  } else if (signed && i < s.len() && s[i] as i32 == 45) {
    neg = true;
    i = i + 1;
  }
  let n: (u64, i32, boolean) = scan_number(s, i);
  let value: u64 = 1 as u64;
  let bare: boolean = false;
  let after: i32 = n.1;
  if (n.1 == i) {
    if (i != 0 || i >= s.len() || !valid_suffix(s[i] as i32, wide)) {
      return bad_num(size_invalid());
    }
    bare = true;
  } else {
    if (n.2) {
      return bad_num(size_overflow());
    }
    value = n.0;
  }
  let u: (u64, u64, i32) = scan_unit(s, after, wide);
  if (u.2 != size_ok()) {
    return bad_num(u.2);
  }
  let m: (u64, boolean) = mul_checked(value, u.0);
  if (m.1) {
    return bad_num(size_overflow());
  }
  if (words && m.0 == 0 as u64) {
    return bad_num(size_invalid());
  }
  let with_b: boolean = false;
  if (after < s.len() && after + 1 < s.len() && s[after + 1] as i32 == 66) {
    with_b = true;
  }
  if (after + 2 < s.len() && s[after + 1] as i32 == 105 && s[after + 2] as i32 == 66) {
    with_b = true;
  }
  return Num { value: m.0, neg: neg, base: u.1, with_b: with_b, show_suffix: bare, human: 0 as u64, status: size_ok() };
}

pub function unit_text(divisor: u64, base: u64, with_b: boolean): string {
  let exp: i32 = 0;
  let d: u64 = divisor;
  while (d > 1 as u64 && d % base == 0 as u64) {
    d = d / base;
    exp = exp + 1;
  }
  if (d != 1 as u64) {
    exp = 0;
  }
  let out: string = power_letter(exp, base);
  if (with_b) {
    if (exp > 0 && base == 1024 as u64) {
      out = out + "i";
    }
    out = out + "B";
  }
  return out;
}

pub function human(n: u64, base: u64, point_zero: boolean): string {
  let div: u64 = 1 as u64;
  let exp: i32 = 0;
  while (n / div >= base) {
    div = div * base;
    exp = exp + 1;
  }
  if (exp == 0) {
    return n.to_string();
  }
  let whole: u64 = n / div;
  let rem: u64 = n % div;
  if (whole < 10 as u64) {
    let tenths: u64 = whole * (10 as u64) + rem * (10 as u64) / div;
    if (rem * (10 as u64) % div != 0 as u64) {
      tenths = tenths + 1 as u64;
    }
    if (tenths < 100 as u64) {
      if (!point_zero && tenths % (10 as u64) == 0 as u64) {
        return (tenths / (10 as u64)).to_string() + power_letter(exp, base);
      }
      return (tenths / (10 as u64)).to_string() + "." + (tenths % (10 as u64)).to_string() + power_letter(exp, base);
    }
  }
  let up: u64 = whole;
  if (rem > 0 as u64) {
    up = up + 1 as u64;
  }
  if (up == base) {
    if (!point_zero) {
      return "1" + power_letter(exp + 1, base);
    }
    return "1.0" + power_letter(exp + 1, base);
  }
  return up.to_string() + power_letter(exp, base);
}

pub struct Unit { block_size: u64, base: u64, with_b: boolean, show_suffix: boolean, human: u64, chosen: boolean }

pub function default_unit(): Unit {
  return Unit { block_size: 1024 as u64, base: 1024 as u64, with_b: false, show_suffix: false, human: 0 as u64, chosen: false };
}

pub function unit_from(n: Num): Unit {
  return Unit { block_size: n.value, base: n.base, with_b: n.with_b, show_suffix: n.show_suffix, human: n.human, chosen: true };
}

pub function plain_unit(size: u64): Unit {
  return Unit { block_size: size, base: 1024 as u64, with_b: false, show_suffix: false, human: 0 as u64, chosen: true };
}

pub function human_unit(base: u64): Unit {
  return Unit { block_size: 1 as u64, base: base, with_b: false, show_suffix: false, human: base, chosen: true };
}

pub function env_unit(names: string[]): Unit {
  let i: i32 = 0;
  while (i < names.len()) {
    match (env(names[i])) {
      Some(v) => {
        let n: Num = parse_num(v, false, true, false);
        if (n.status == size_ok()) {
          return unit_from(n);
        }
        return posix_default();
      },
      None => {}
    }
    i = i + 1;
  }
  return posix_default();
}

pub function posix_default(): Unit {
  match (env("POSIXLY_CORRECT")) {
    Some(_) => {
      return plain_unit(512 as u64);
    },
    None => {}
  }
  return default_unit();
}

pub function format_size(n: u64, block_size: u64, suffix: string, human_base: u64): string {
  if (human_base > 0 as u64) {
    return human(n, human_base, true);
  }
  let q: u64 = n / block_size;
  if (n % block_size != 0 as u64) {
    q = q + 1 as u64;
  }
  return q.to_string() + suffix;
}

function quote_size(spec: string): string {
  return gnu.quote(spec);
}

pub function die_size(status: i32, option: string, spec: string): void {
  die_size_with(status, option, spec, 1);
}

pub function die_size_with(status: i32, option: string, spec: string, exit_status: i32): void {
  if (status == size_bad_suffix()) {
    gnu.error("invalid suffix in " + option + " argument " + quote_size(spec));
  } else if (status == size_overflow()) {
    gnu.error(option + " argument " + quote_size(spec) + " too large");
  } else {
    gnu.error("invalid " + option + " argument " + quote_size(spec));
  }
  exit(exit_status);
}

pub function option_name(m: gnu.OptMatch, long: string, short: string): string {
  if (m.long_form) {
    return long;
  }
  return short;
}
