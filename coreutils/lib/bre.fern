import "std/string";
import "std/array";

enum Input { Text(string, i32), Bytes(u8[], i32) }

function text_input(text: string): Input {
  return Text(text, text.len());
}

function byte_input(bytes: u8[]): Input {
  return Bytes(bytes, bytes.len());
}

function (s: Input) len(): i32 {
  match (s) {
    Text(_, n) => {
      return n;
    },
    Bytes(_, n) => {
      return n;
    }
  }
}

function (s: Input) at(k: i32): i32 {
  match (s) {
    Text(t, _) => {
      return t[k] as i32;
    },
    Bytes(b, _) => {
      return b[k] as i32;
    }
  }
}

function (s: Input) find_byte(byte: i32, from: i32): i32 {
  match (s) {
    Text(t, _) => {
      return __memchr(t, byte, from);
    },
    Bytes(b, _) => {
      return __memchr_bytes(b, byte, from);
    }
  }
}

function (s: Input) scan_set(from: i32, set: u8[]): i32 {
  match (s) {
    Text(t, _) => {
      return __scan_set(t, from, set);
    },
    Bytes(b, _) => {
      return __scan_set_bytes(b, from, set);
    }
  }
}

function (s: Input) same_range(a: i32, b: i32, n: i32): boolean {
  match (s) {
    Text(t, _) => {
      return __mismatch(t, a, t, b, n) == n;
    },
    Bytes(v, _) => {
      return __mismatch_bytes(v, a, v, b, n) == n;
    }
  }
}

pub function (re: Bre) exec(text: string): BreMatch {
  return re.exec_input(text_input(text));
}

pub function (re: Bre) exec_bytes(text: u8[]): BreMatch {
  return re.exec_input(byte_input(text));
}

pub function (re: Bre) search_from(text: string, lo: i32, hi: i32): (i32, i32) {
  return re.search_from_input(text_input(text), lo, hi);
}

pub function (re: Bre) search_from_bytes(text: u8[], lo: i32, hi: i32): (i32, i32) {
  return re.search_from_input(byte_input(text), lo, hi);
}

pub function (re: Bre) search_back(text: string, hi: i32): (i32, i32) {
  return re.search_back_input(text_input(text), hi);
}

pub function (re: Bre) search_back_bytes(text: u8[], hi: i32): (i32, i32) {
  return re.search_back_input(byte_input(text), hi);
}

pub function (re: Bre) search(text: string): boolean {
  return re.search_input(text_input(text));
}

pub function (re: Bre) search_bytes(text: u8[]): boolean {
  return re.search_input(byte_input(text));
}

pub function (re: Bre) search_range(text: string, lo: i32, hi: i32): boolean {
  return re.search_range_input(text_input(text), lo, hi);
}

pub function (re: Bre) search_range_bytes(text: u8[], lo: i32, hi: i32): boolean {
  return re.search_range_input(byte_input(text), lo, hi);
}

struct Inst { op: i32, a: i32, b: i32 }

function op_char(): i32 {
  return 0;
}

function op_class(): i32 {
  return 1;
}

function op_split(): i32 {
  return 2;
}

function op_jmp(): i32 {
  return 3;
}

function op_save(): i32 {
  return 4;
}

function op_match(): i32 {
  return 5;
}

function op_bol(): i32 {
  return 6;
}

function op_eol(): i32 {
  return 7;
}

function op_backref(): i32 {
  return 8;
}

function op_mark(): i32 {
  return 9;
}

function op_progress(): i32 {
  return 10;
}

function op_assert(): i32 {
  return 11;
}

function assert_wordb(): i32 {
  return 0;
}

function assert_not_wordb(): i32 {
  return 1;
}

function assert_word_start(): i32 {
  return 2;
}

function assert_word_end(): i32 {
  return 3;
}

function assert_buf_start(): i32 {
  return 4;
}

function assert_buf_end(): i32 {
  return 5;
}

pub struct Bre { insts: Inst[], classes: u8[], ngroups: i32, nmarks: i32, backref: boolean, err: string, newline_anchor: boolean, first: u8[], empty_ok: boolean, pre: u8[], pre_bol: boolean, pre_eol: boolean, literal: boolean, alts: u8[][], seen0: i32[], dfa: DfaCache, bclass: u8[], reps: i32[], cx_lo: boolean, cx_nl: boolean, cx_word: boolean }

pub struct Syntax { emacs: boolean, newline_anchor: boolean }

pub function posix_basic(): Syntax {
  return Syntax { emacs: false, newline_anchor: false };
}

pub function emacs_syntax(): Syntax {
  return Syntax { emacs: true, newline_anchor: true };
}

pub struct BreMatch { matched: boolean, end: i32, starts: i32[], ends: i32[] }

function err_badpat(): string {
  return "Invalid regular expression";
}

function err_ecollate(): string {
  return "Invalid collation character";
}

function err_ectype(): string {
  return "Invalid character class name";
}

function err_eescape(): string {
  return "Trailing backslash";
}

function err_esubreg(): string {
  return "Invalid back reference";
}

function err_ebrack(): string {
  return "Unmatched [, [^, [:, [., or [=";
}

function err_eparen_open(): string {
  return "Unmatched ( or \\(";
}

function err_eparen_close(): string {
  return "Unmatched ) or \\)";
}

function err_ebrace(): string {
  return "Unmatched \\{";
}

function err_badbr(): string {
  return "Invalid content of \\{\\}";
}

function err_erange(): string {
  return "Invalid range end";
}

function err_esize(): string {
  return "Regular expression too big";
}

function dup_max(): i32 {
  return 32767;
}

function inst_max(): i32 {
  return 200000;
}

struct Node { kind: i32, a: i32, b: i32, c: i32 }

function nd_empty(): i32 {
  return 0;
}

function nd_char(): i32 {
  return 1;
}

function nd_class(): i32 {
  return 2;
}

function nd_cat(): i32 {
  return 3;
}

function nd_alt(): i32 {
  return 4;
}

function nd_group(): i32 {
  return 5;
}

function nd_rep(): i32 {
  return 6;
}

function nd_bol(): i32 {
  return 7;
}

function nd_eol(): i32 {
  return 8;
}

function nd_backref(): i32 {
  return 9;
}

function nd_assert(): i32 {
  return 10;
}

struct P { pat: Input, i: i32, nodes: Node[], classes: u8[], ngroups: i32, done: i32, err: string, emacs: boolean }

function group_bit(n: i32): i32 {
  return 1 << n - 1;
}

function group_done(p: P, n: i32): boolean {
  return (p.done & group_bit(n)) != 0;
}

function mark_group_done(p: P, n: i32): P {
  if (n > 9) {
    return p;
  }
  return P { ...p, done: p.done | group_bit(n) };
}

function add_node(p: P, n: Node): (P, i32) {
  let out: P = P { ...p, nodes: p.nodes.append(n) };
  return (out, out.nodes.len() - 1);
}

function fail(p: P, msg: string): P {
  if (p.err.len() > 0) {
    return p;
  }
  return P { ...p, err: msg };
}

function at_end(p: P): boolean {
  return p.i >= p.pat.len();
}

function byte_at(p: P, k: i32): i32 {
  if (k >= p.pat.len()) {
    return 0 - 1;
  }
  return p.pat.at(k);
}

function esc_at(p: P, k: i32, c: i32): boolean {
  return byte_at(p, k) == 92 && byte_at(p, k + 1) == c;
}

function is_digit(b: i32): boolean {
  return b >= 48 && b <= 57;
}

function class_name_table(name: string): u8[] {
  let t: u8[] = __alloc_u8(256);
  let b: i32 = 0;
  let known: boolean = false;
  while (b < 256) {
    if (class_has(name, b)) {
      t = t.with(b, 1 as u8);
    }
    b = b + 1;
  }
  known = is_class_name(name);
  if (!known) {
    let none: u8[] = [];
    return none;
  }
  return t;
}

function is_class_name(name: string): boolean {
  return name == "alpha" || name == "digit" || name == "alnum" || name == "upper" || name == "lower" || name == "space" || name == "blank" || name == "punct" || name == "print" || name == "graph" || name == "cntrl" || name == "xdigit";
}

function is_upper(b: i32): boolean {
  return b >= 65 && b <= 90;
}

function is_lower(b: i32): boolean {
  return b >= 97 && b <= 122;
}

function is_alpha(b: i32): boolean {
  return is_upper(b) || is_lower(b);
}

function is_space_byte(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

function is_print(b: i32): boolean {
  return b >= 32 && b < 127;
}

function class_has(name: string, b: i32): boolean {
  if (name == "alpha") {
    return is_alpha(b);
  }
  if (name == "digit") {
    return is_digit(b);
  }
  if (name == "alnum") {
    return is_alpha(b) || is_digit(b);
  }
  if (name == "upper") {
    return is_upper(b);
  }
  if (name == "lower") {
    return is_lower(b);
  }
  if (name == "space") {
    return is_space_byte(b);
  }
  if (name == "blank") {
    return b == 32 || b == 9;
  }
  if (name == "punct") {
    return is_print(b) && b != 32 && !is_alpha(b) && !is_digit(b);
  }
  if (name == "print") {
    return is_print(b);
  }
  if (name == "graph") {
    return is_print(b) && b != 32;
  }
  if (name == "cntrl") {
    return b < 32 || b == 127;
  }
  if (name == "xdigit") {
    return is_digit(b) || b >= 65 && b <= 70 || b >= 97 && b <= 102;
  }
  return false;
}

struct BItem { byte: i32, kind: i32, table: u8[], err: string, next: i32 }

function bi_byte(): i32 {
  return 0;
}

function bi_collate(): i32 {
  return 1;
}

function bi_equiv(): i32 {
  return 2;
}

function bi_class(): i32 {
  return 3;
}

function range_ok(b: BItem): boolean {
  return b.kind == bi_byte() || b.kind == bi_collate();
}

function bracket_class(p: P, lo: i32, hi: i32): string {
  let names: string[] = ["alpha", "digit", "alnum", "upper", "lower", "space", "blank", "punct", "print", "graph", "cntrl", "xdigit"];
  for name in names {
    if (name.len() == hi - lo) {
      let i: i32 = 0;
      while (i < name.len() && byte_at(p, lo + i) == name[i] as i32) {
        i = i + 1;
      }
      if (i == name.len()) {
        return name;
      }
    }
  }
  return "";
}

function bracket_item(p: P, k: i32): BItem {
  let none: u8[] = [];
  if (byte_at(p, k) == 91) {
    let kind: i32 = byte_at(p, k + 1);
    if (kind == 58 && p.emacs) {
      kind = 0;
    }
    if (kind == 58 || kind == 46 || kind == 61) {
      let close: i32 = find_close(p, k + 2, kind);
      if (close < 0) {
        return BItem { byte: 0, kind: bi_byte(), table: none, err: err_ebrack(), next: k };
      }
      if (kind == 58) {
        let t: u8[] = class_name_table(bracket_class(p, k + 2, close));
        if (t.len() == 0) {
          return BItem { byte: 0, kind: bi_byte(), table: none, err: err_ectype(), next: k };
        }
        return BItem { byte: 0, kind: bi_class(), table: t, err: "", next: close + 2 };
      }
      if (close - k - 2 != 1) {
        return BItem { byte: 0, kind: bi_byte(), table: none, err: err_ecollate(), next: k };
      }
      let which: i32 = bi_collate();
      if (kind == 61) {
        which = bi_equiv();
      }
      return BItem { byte: byte_at(p, k + 2), kind: which, table: none, err: "", next: close + 2 };
    }
  }
  return BItem { byte: byte_at(p, k), kind: bi_byte(), table: none, err: "", next: k + 1 };
}

function find_close(p: P, from: i32, kind: i32): i32 {
  let k: i32 = from;
  while (k + 1 < p.pat.len()) {
    if (byte_at(p, k) == kind && byte_at(p, k + 1) == 93) {
      return k;
    }
    k = k + 1;
  }
  return 0 - 1;
}

function parse_bracket(p0: P): (P, i32) {
  let p: P = p0;
  let t: u8[] = __alloc_u8(256);
  let negate: boolean = false;
  if (byte_at(p, p.i) == 94) {
    negate = true;
    p = P { ...p, i: p.i + 1 };
  }
  if (at_end(p)) {
    return (fail(p, err_badpat()), 0);
  }
  let first: boolean = true;
  while (true) {
    let b: i32 = byte_at(p, p.i);
    if (b < 0) {
      return (fail(p, err_ebrack()), 0);
    }
    if (b == 93 && !first) {
      p = P { ...p, i: p.i + 1 };
      break;
    }
    first = false;
    let r: (P, u8[]) = bracket_one(p, t);
    p = r.0;
    t = r.1;
    if (p.err.len() > 0) {
      return (p, 0);
    }
  }
  if (negate) {
    let k: i32 = 0;
    while (k < 256) {
      if (t[k] as i32 == 0) {
        t = t.with(k, 1 as u8);
      } else {
        t = t.with(k, 0 as u8);
      }
      k = k + 1;
    }
  }
  let idx: i32 = p.classes.len() / 256;
  let cs: u8[] = p.classes;
  let j: i32 = 0;
  while (j < 256) {
    cs = cs.append(t[j]);
    j = j + 1;
  }
  return (P { ...p, classes: cs }, idx);
}

function bracket_one(p0: P, t0: u8[]): (P, u8[]) {
  let p: P = p0;
  let t: u8[] = t0;
  let lo: BItem = bracket_item(p, p.i);
  if (lo.err.len() > 0) {
    return (fail(p, lo.err), t);
  }
  p = P { ...p, i: lo.next };
  if (byte_at(p, p.i) != 45 || byte_at(p, p.i + 1) == 93 || byte_at(p, p.i + 1) < 0) {
    if (lo.kind == bi_class()) {
      return (p, union_table(t, lo.table));
    }
    return (p, t.with(lo.byte, 1 as u8));
  }
  if (!range_ok(lo)) {
    return (fail(p, err_erange()), t);
  }
  let hi: BItem = bracket_item(p, p.i + 1);
  if (hi.err.len() > 0) {
    return (fail(p, hi.err), t);
  }
  if (!range_ok(hi)) {
    return (fail(p, err_erange()), t);
  }
  p = P { ...p, i: hi.next };
  let b: i32 = lo.byte;
  while (b <= hi.byte) {
    t = t.with(b, 1 as u8);
    b = b + 1;
  }
  if (byte_at(p, p.i) == 45 && byte_at(p, p.i + 1) != 93 && byte_at(p, p.i + 1) >= 0) {
    return (fail(p, err_erange()), t);
  }
  return (p, t);
}

function union_table(t0: u8[], other: u8[]): u8[] {
  let t: u8[] = t0;
  let k: i32 = 0;
  while (k < 256) {
    if (other[k] as i32 != 0) {
      t = t.with(k, 1 as u8);
    }
    k = k + 1;
  }
  return t;
}

function shorthand_table(p0: P, which: i32): (P, i32) {
  let t: u8[] = __alloc_u8(256);
  let b: i32 = 0;
  while (b < 256) {
    if (shorthand_has(which, b)) {
      t = t.with(b, 1 as u8);
    }
    b = b + 1;
  }
  let idx: i32 = p0.classes.len() / 256;
  let cs: u8[] = p0.classes;
  let j: i32 = 0;
  while (j < 256) {
    cs = cs.append(t[j]);
    j = j + 1;
  }
  return (P { ...p0, classes: cs }, idx);
}

function shorthand_has(which: i32, b: i32): boolean {
  let word: boolean = is_alpha(b) || is_digit(b) || b == 95;
  if (which == 0) {
    return word;
  }
  if (which == 1) {
    return !word;
  }
  if (which == 2) {
    return is_space_byte(b);
  }
  return !is_space_byte(b);
}

function any_table(p0: P): (P, i32) {
  let idx: i32 = p0.classes.len() / 256;
  let cs: u8[] = p0.classes;
  let skip: i32 = 0;
  if (p0.emacs) {
    skip = 10;
  }
  let j: i32 = 0;
  while (j < 256) {
    if (j == skip) {
      cs = cs.append(0 as u8);
    } else {
      cs = cs.append(1 as u8);
    }
    j = j + 1;
  }
  return (P { ...p0, classes: cs }, idx);
}

function parse_alt(p0: P): (P, i32) {
  let outer: i32 = p0.done;
  let r: (P, i32) = parse_branch(p0);
  let p: P = r.0;
  let left: i32 = r.1;
  while (p.err.len() == 0 && esc_at(p, p.i, 124)) {
    let sofar: i32 = p.done;
    p = P { ...p, i: p.i + 2, done: outer };
    let r2: (P, i32) = parse_branch(p);
    p = P { ...r2.0, done: r2.0.done | sofar };
    let n: (P, i32) = add_node(p, Node { kind: nd_alt(), a: left, b: r2.1, c: 0 });
    p = n.0;
    left = n.1;
  }
  return (p, left);
}

function parse_branch(p0: P): (P, i32) {
  let p: P = p0;
  let cur: i32 = 0 - 1;
  while (true) {
    if (p.err.len() > 0) {
      return (p, empty_node(p, cur));
    }
    if (at_end(p) || esc_at(p, p.i, 124) || esc_at(p, p.i, 41)) {
      break;
    }
    let r: (P, i32) = parse_piece(p, cur < 0);
    p = r.0;
    if (p.err.len() > 0) {
      return (p, empty_node(p, cur));
    }
    if (cur < 0) {
      cur = r.1;
    } else {
      let n: (P, i32) = add_node(p, Node { kind: nd_cat(), a: cur, b: r.1, c: 0 });
      p = n.0;
      cur = n.1;
    }
  }
  if (cur >= 0) {
    return (p, cur);
  }
  return (p, 0);
}

function empty_node(p: P, cur: i32): i32 {
  if (cur >= 0) {
    return cur;
  }
  return 0;
}

function parse_piece(p0: P, first: boolean): (P, i32) {
  let r: (P, i32) = parse_atom(p0, first);
  let p: P = r.0;
  let node: i32 = r.1;
  if (p.err.len() > 0 || p.nodes[node].kind == nd_bol() || p.nodes[node].kind == nd_assert()) {
    return (p, node);
  }
  while (true) {
    if (byte_at(p, p.i) == 42) {
      p = P { ...p, i: p.i + 1 };
      let s: (P, i32) = add_node(p, Node { kind: nd_rep(), a: node, b: 0, c: 0 - 1 });
      p = s.0;
      node = s.1;
      continue;
    }
    if (plus_at(p, p.i)) {
      p = P { ...p, i: p.i + op_width(p) };
      let pl: (P, i32) = add_node(p, Node { kind: nd_rep(), a: node, b: 1, c: 0 - 1 });
      p = pl.0;
      node = pl.1;
      continue;
    }
    if (query_at(p, p.i)) {
      p = P { ...p, i: p.i + op_width(p) };
      let q: (P, i32) = add_node(p, Node { kind: nd_rep(), a: node, b: 0, c: 1 });
      p = q.0;
      node = q.1;
      continue;
    }
    if (!p.emacs && esc_at(p, p.i, 123)) {
      let iv: (P, i32) = parse_interval(p, node);
      p = iv.0;
      node = iv.1;
      if (p.err.len() > 0) {
        return (p, node);
      }
      continue;
    }
    break;
  }
  return (p, node);
}

function plus_at(p: P, k: i32): boolean {
  if (p.emacs) {
    return byte_at(p, k) == 43;
  }
  return esc_at(p, k, 43);
}

function query_at(p: P, k: i32): boolean {
  if (p.emacs) {
    return byte_at(p, k) == 63;
  }
  return esc_at(p, k, 63);
}

function op_width(p: P): i32 {
  if (p.emacs) {
    return 1;
  }
  return 2;
}

function parse_interval(p0: P, node: i32): (P, i32) {
  let p: P = P { ...p0, i: p0.i + 2 };
  let lo: (i32, i32) = read_count(p, p.i);
  let min: i32 = lo.0;
  let k: i32 = lo.1;
  let max: i32 = min;
  let comma: boolean = false;
  if (byte_at(p, k) == 44) {
    comma = true;
    let hi: (i32, i32) = read_count(p, k + 1);
    max = hi.0;
    k = hi.1;
  }
  if (!esc_at(p, k, 125)) {
    if (has_close_brace(p, k)) {
      return (fail(p, err_badbr()), node);
    }
    return (fail(p, err_ebrace()), node);
  }
  p = P { ...p, i: k + 2 };
  if (!valid_interval(min, max, comma)) {
    return (fail(p, err_badbr()), node);
  }
  if (min > dup_max() || max > dup_max()) {
    return (fail(p, err_esize()), node);
  }
  if (comma && max < 0) {
    return add_node(p, Node { kind: nd_rep(), a: node, b: min, c: 0 - 1 });
  }
  return add_node(p, Node { kind: nd_rep(), a: node, b: min, c: max });
}

function has_close_brace(p: P, from: i32): boolean {
  let k: i32 = from;
  while (k + 1 < p.pat.len()) {
    if (esc_at(p, k, 125)) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function read_count(p: P, from: i32): (i32, i32) {
  let k: i32 = from;
  let v: i32 = 0 - 1;
  while (is_digit(byte_at(p, k))) {
    if (v < 0) {
      v = 0;
    }
    if (v <= dup_max()) {
      v = v * 10 + (byte_at(p, k) - 48);
    }
    k = k + 1;
  }
  return (v, k);
}

function valid_interval(min: i32, max: i32, comma: boolean): boolean {
  if (min < 0 && !comma) {
    return false;
  }
  if (min < 0 && max < 0 && comma) {
    return true;
  }
  if (!comma) {
    return min >= 0;
  }
  if (max < 0) {
    return true;
  }
  let lo: i32 = min;
  if (lo < 0) {
    lo = 0;
  }
  return lo <= max;
}

function parse_atom(p0: P, first: boolean): (P, i32) {
  let p: P = p0;
  let b: i32 = byte_at(p, p.i);
  if (b == 94 && first) {
    p = P { ...p, i: p.i + 1 };
    return add_node(p, Node { kind: nd_bol(), a: 0, b: 0, c: 0 });
  }
  if (b == 36 && dollar_is_anchor(p, p.i + 1)) {
    p = P { ...p, i: p.i + 1 };
    return add_node(p, Node { kind: nd_eol(), a: 0, b: 0, c: 0 });
  }
  if (b == 46) {
    p = P { ...p, i: p.i + 1 };
    let an: (P, i32) = any_table(p);
    return add_node(an.0, Node { kind: nd_class(), a: an.1, b: 0, c: 0 });
  }
  if (b == 91) {
    p = P { ...p, i: p.i + 1 };
    let br: (P, i32) = parse_bracket(p);
    if (br.0.err.len() > 0) {
      return (br.0, 0);
    }
    return add_node(br.0, Node { kind: nd_class(), a: br.1, b: 0, c: 0 });
  }
  if (b == 92) {
    return parse_escape(p);
  }
  p = P { ...p, i: p.i + 1 };
  return add_node(p, Node { kind: nd_char(), a: b, b: 0, c: 0 });
}

function dollar_is_anchor(p: P, next: i32): boolean {
  if (next >= p.pat.len()) {
    return true;
  }
  return esc_at(p, next, 41) || esc_at(p, next, 124);
}

function parse_escape(p0: P): (P, i32) {
  let p: P = p0;
  let c: i32 = byte_at(p, p.i + 1);
  if (c < 0) {
    return (fail(p, err_eescape()), 0);
  }
  if (c == 40) {
    return parse_group(P { ...p, i: p.i + 2 });
  }
  if (c == 41) {
    return (fail(p, err_eparen_close()), 0);
  }
  if (c >= 49 && c <= 57) {
    p = P { ...p, i: p.i + 2 };
    if (!group_done(p, c - 48)) {
      return (fail(p, err_esubreg()), 0);
    }
    return add_node(p, Node { kind: nd_backref(), a: c - 48, b: 0, c: 0 });
  }
  let sh: i32 = shorthand_index(c);
  if (sh >= 0) {
    p = P { ...p, i: p.i + 2 };
    let st: (P, i32) = shorthand_table(p, sh);
    return add_node(st.0, Node { kind: nd_class(), a: st.1, b: 0, c: 0 });
  }
  let az: i32 = assert_index(c);
  if (az >= 0) {
    p = P { ...p, i: p.i + 2 };
    return add_node(p, Node { kind: nd_assert(), a: az, b: 0, c: 0 });
  }
  p = P { ...p, i: p.i + 2 };
  return add_node(p, Node { kind: nd_char(), a: c, b: 0, c: 0 });
}

function shorthand_index(c: i32): i32 {
  if (c == 119) {
    return 0;
  }
  if (c == 87) {
    return 1;
  }
  if (c == 115) {
    return 2;
  }
  if (c == 83) {
    return 3;
  }
  return 0 - 1;
}

function assert_index(c: i32): i32 {
  if (c == 98) {
    return assert_wordb();
  }
  if (c == 66) {
    return assert_not_wordb();
  }
  if (c == 60) {
    return assert_word_start();
  }
  if (c == 62) {
    return assert_word_end();
  }
  if (c == 96) {
    return assert_buf_start();
  }
  if (c == 39) {
    return assert_buf_end();
  }
  return 0 - 1;
}

function parse_group(p0: P): (P, i32) {
  let n: i32 = p0.ngroups + 1;
  let r: (P, i32) = parse_alt(P { ...p0, ngroups: n });
  let p: P = r.0;
  if (p.err.len() > 0) {
    return (p, 0);
  }
  if (!esc_at(p, p.i, 41)) {
    return (fail(p, err_eparen_open()), 0);
  }
  p = mark_group_done(P { ...p, i: p.i + 2 }, n);
  return add_node(p, Node { kind: nd_group(), a: r.1, b: n, c: 0 });
}

struct C { insts: Inst[], nmarks: i32, err: string }

function emit(c: C, in: Inst): C {
  if (c.insts.len() >= inst_max()) {
    return C { ...c, err: err_esize() };
  }
  return C { ...c, insts: c.insts.append(in) };
}

function patch_a(c: C, at: i32, target: i32): C {
  let in: Inst = c.insts[at];
  return C { ...c, insts: c.insts.with(at, Inst { ...in, a: target }) };
}

function patch_b(c: C, at: i32, target: i32): C {
  let in: Inst = c.insts[at];
  return C { ...c, insts: c.insts.with(at, Inst { ...in, b: target }) };
}

function compile_node(c0: C, nodes: Node[], node: i32): C {
  let c: C = c0;
  if (c.err.len() > 0) {
    return c;
  }
  let n: Node = nodes[node];
  if (n.kind == nd_empty()) {
    return c;
  }
  if (n.kind == nd_char()) {
    return emit(c, Inst { op: op_char(), a: n.a, b: 0 });
  }
  if (n.kind == nd_class()) {
    return emit(c, Inst { op: op_class(), a: n.a, b: 0 });
  }
  if (n.kind == nd_bol()) {
    return emit(c, Inst { op: op_bol(), a: 0, b: 0 });
  }
  if (n.kind == nd_eol()) {
    return emit(c, Inst { op: op_eol(), a: 0, b: 0 });
  }
  if (n.kind == nd_assert()) {
    return emit(c, Inst { op: op_assert(), a: n.a, b: 0 });
  }
  if (n.kind == nd_backref()) {
    return emit(c, Inst { op: op_backref(), a: n.a, b: 0 });
  }
  if (n.kind == nd_cat()) {
    return compile_node(compile_node(c, nodes, n.a), nodes, n.b);
  }
  if (n.kind == nd_group()) {
    return compile_group(c, nodes, n, false);
  }
  if (n.kind == nd_alt()) {
    return compile_alt(c, nodes, n);
  }
  return compile_rep(c, nodes, n);
}

function compile_group(c: C, nodes: Node[], n: Node, optional: boolean): C {
  let flag: i32 = 0;
  if (optional) {
    flag = 1;
  }
  return emit(compile_node(emit(c, Inst { op: op_save(), a: (n.b - 1) * 2, b: 0 }), nodes, n.a), Inst { op: op_save(), a: (n.b - 1) * 2 + 1, b: flag });
}

function compile_alt(c0: C, nodes: Node[], n: Node): C {
  let split: i32 = c0.insts.len();
  let c: C = emit(c0, Inst { op: op_split(), a: 0, b: 0 });
  let first: i32 = c.insts.len();
  c = patch_a(c, split, first);
  c = compile_node(c, nodes, n.a);
  if (c.insts.len() == first && c.err.len() == 0) {
    c = compile_node(c, nodes, n.b);
    if (c.err.len() > 0) {
      return c;
    }
    return patch_b(c, split, c.insts.len());
  }
  let jump: i32 = c.insts.len();
  c = emit(c, Inst { op: op_jmp(), a: 0, b: 0 });
  c = patch_b(c, split, c.insts.len());
  c = compile_node(c, nodes, n.b);
  if (c.err.len() > 0) {
    return c;
  }
  return patch_a(c, jump, c.insts.len());
}

function compile_rep(c0: C, nodes: Node[], n: Node): C {
  let c: C = compile_copies(c0, nodes, n.a, rep_min(n));
  if (c.err.len() > 0) {
    return c;
  }
  if (n.c < 0) {
    return compile_star(c, nodes, n.a);
  }
  return compile_optionals(c, nodes, n.a, n.c - rep_min(n));
}

function compile_optional_copy(c: C, nodes: Node[], body: i32): C {
  let n: Node = nodes[body];
  if (n.kind == nd_group()) {
    return compile_group(c, nodes, n, true);
  }
  return compile_node(c, nodes, body);
}

function compile_copies(c0: C, nodes: Node[], body: i32, times: i32): C {
  if (times <= 0) {
    return c0;
  }
  let empty: Inst[] = [];
  let one: C = compile_node(C { insts: empty, nmarks: 0, err: "" }, nodes, body);
  if (one.err.len() > 0) {
    return C { ...c0, err: one.err };
  }
  return splice(C { ...c0, nmarks: c0.nmarks + one.nmarks * times }, one.insts, times, c0.nmarks, one.nmarks);
}

function splice(c: C, body: Inst[], times: i32, slot0: i32, slots: i32): C {
  if (c.insts.len() + body.len() * times > inst_max()) {
    return C { ...c, err: err_esize() };
  }
  let out: Inst[] = c.insts;
  let t: i32 = 0;
  while (t < times) {
    let base: i32 = out.len();
    let slot_base: i32 = slot0 + slots * t;
    let k: i32 = 0;
    while (k < body.len()) {
      out = out.append(relocate(body[k], base, slot_base));
      k = k + 1;
    }
    t = t + 1;
  }
  return C { ...c, insts: out };
}

function relocate(in: Inst, base: i32, slot_base: i32): Inst {
  if (in.op == op_split()) {
    return Inst { op: in.op, a: in.a + base, b: in.b + base };
  }
  if (in.op == op_jmp()) {
    return Inst { ...in, a: in.a + base };
  }
  if (in.op == op_mark()) {
    return Inst { ...in, a: in.a + slot_base };
  }
  if (in.op == op_progress()) {
    return Inst { op: in.op, a: in.a + slot_base, b: in.b + base };
  }
  return in;
}

function rep_min(n: Node): i32 {
  if (n.b < 0) {
    return 0;
  }
  return n.b;
}

function compile_star(c0: C, nodes: Node[], body: i32): C {
  let slot: i32 = c0.nmarks;
  let c: C = C { ...c0, nmarks: slot + 1 };
  let top: i32 = c.insts.len();
  c = emit(c, Inst { op: op_split(), a: 0, b: 0 });
  c = patch_a(c, top, c.insts.len());
  c = emit(c, Inst { op: op_mark(), a: slot, b: 0 });
  c = compile_optional_copy(c, nodes, body);
  if (c.err.len() > 0) {
    return c;
  }
  let progress: i32 = c.insts.len();
  c = emit(c, Inst { op: op_progress(), a: slot, b: 0 });
  c = emit(c, Inst { op: op_jmp(), a: top, b: 0 });
  return patch_b(patch_b(c, top, c.insts.len()), progress, c.insts.len());
}

function compile_optionals(c0: C, nodes: Node[], body: i32, count: i32): C {
  if (count <= 0) {
    return c0;
  }
  let base: i32 = c0.insts.len();
  let c: C = c0;
  let k: i32 = 0;
  while (k < count) {
    c = emit(c, Inst { op: op_split(), a: base + k + 1, b: 0 });
    k = k + 1;
  }
  c = compile_optional_copy(c, nodes, body);
  c = patch_b(c, base + count - 1, c.insts.len());
  let j: i32 = 2;
  while (j <= count && c.err.len() == 0) {
    c = compile_node(c, nodes, body);
    c = patch_b(c, base + count - j, c.insts.len());
    j = j + 1;
  }
  return c;
}

function has_backref(nodes: Node[]): boolean {
  let k: i32 = 0;
  while (k < nodes.len()) {
    if (nodes[k].kind == nd_backref()) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

pub function bre_compile(pat: string): Bre {
  return bre_compile_syntax(pat, posix_basic());
}

pub function bre_compile_bytes(pat: u8[]): Bre {
  return bre_compile_bytes_syntax(pat, posix_basic());
}

pub function bre_compile_syntax(pat: string, syntax: Syntax): Bre {
  return compile_input(text_input(pat), syntax);
}

pub function bre_compile_bytes_syntax(pat: u8[], syntax: Syntax): Bre {
  return compile_input(byte_input(pat), syntax);
}

function compile_input(pat: Input, syntax: Syntax): Bre {
  let nodes: Node[] = [Node { kind: nd_empty(), a: 0, b: 0, c: 0 }];
  let cls: u8[] = [];
  let none_first: u8[] = [];
  let no_alts: u8[][] = [];
  let no_seen: i32[] = [];
  let p: P = P { pat: pat, i: 0, nodes: nodes, classes: cls, ngroups: 0, done: 0, err: "", emacs: syntax.emacs };
  let r: (P, i32) = parse_alt(p);
  p = r.0;
  if (p.err.len() == 0 && !at_end(p)) {
    p = fail(p, err_eparen_close());
  }
  if (p.err.len() > 0) {
    let no_insts: Inst[] = [];
    return Bre { insts: no_insts, classes: p.classes, ngroups: 0, nmarks: 0, backref: false, err: p.err, newline_anchor: syntax.newline_anchor, first: none_first, empty_ok: true, pre: none_first, pre_bol: false, pre_eol: false, literal: false, alts: no_alts, seen0: no_seen, dfa: dfa_cache(), bclass: none_first, reps: no_seen, cx_lo: false, cx_nl: false, cx_word: false };
  }
  let empty: Inst[] = [];
  let c: C = C { insts: empty, nmarks: 0, err: "" };
  c = compile_node(C { ...c, insts: empty }, p.nodes, r.1);
  c = emit(c, Inst { op: op_match(), a: 0, b: 0 });
  if (c.err.len() > 0) {
    let none: Inst[] = [];
    return Bre { insts: none, classes: p.classes, ngroups: 0, nmarks: 0, backref: false, err: c.err, newline_anchor: syntax.newline_anchor, first: none_first, empty_ok: true, pre: none_first, pre_bol: false, pre_eol: false, literal: false, alts: no_alts, seen0: no_seen, dfa: dfa_cache(), bclass: none_first, reps: no_seen, cx_lo: false, cx_nl: false, cx_word: false };
  }
  let fm: (u8[], boolean) = fastmap(c.insts, p.classes);
  let pre: (u8[], boolean, i32) = prefix_scan(c.insts);
  let tail: (boolean, boolean) = literal_tail(c.insts, pre.2);
  let alts: u8[][] = no_alts;
  if (pre.0.len() == 0) {
    alts = branch_literals(c.insts);
  }
  let cx_nl: boolean = syntax.newline_anchor && has_op(c.insts, op_bol());
  let cx_word: boolean = reads_word(c.insts);
  let bclass: u8[] = byte_classes(c.insts, p.classes, cx_nl || syntax.newline_anchor && has_op(c.insts, op_eol()), cx_word);
  return Bre { insts: c.insts, classes: p.classes, ngroups: p.ngroups, nmarks: c.nmarks, backref: has_backref(p.nodes), err: "", newline_anchor: syntax.newline_anchor, first: fm.0, empty_ok: fm.1, pre: pre.0, pre_bol: pre.1, pre_eol: tail.0, literal: tail.1, alts: alts, seen0: fill(c.insts.len(), 0 - 1), dfa: dfa_cache(), bclass: bclass, reps: class_reps(bclass), cx_lo: reads_lo(c.insts), cx_nl: cx_nl, cx_word: cx_word };
}

function fastmap(insts: Inst[], classes: u8[]): (u8[], boolean) {
  let t: u8[] = __alloc_u8(256);
  let seen: i32[] = fill(insts.len(), 0);
  let work: i32[] = [0];
  let empty_ok: boolean = false;
  let top: i32 = 1;
  while (top > 0) {
    top = top - 1;
    let pc: i32 = work[top];
    if (seen[pc] != 0) {
      continue;
    }
    seen = seen.with(pc, 1);
    let in: Inst = insts[pc];
    if (in.op == op_char()) {
      t = t.with(in.a, 1 as u8);
    } else if (in.op == op_class()) {
      t = union_table(t, class_table(classes, in.a));
    } else if (in.op == op_match()) {
      empty_ok = true;
    } else if (in.op == op_backref()) {
      t = union_table(t, all_bytes());
      empty_ok = true;
    } else if (in.op == op_jmp()) {
      work = push_at(work, top, in.a);
      top = top + 1;
    } else if (in.op == op_split()) {
      work = push_at(work, top, in.a);
      work = push_at(work, top + 1, in.b);
      top = top + 2;
    } else {
      work = push_at(work, top, pc + 1);
      top = top + 1;
    }
  }
  return (t, empty_ok);
}

function push_at(own a: i32[], at: i32, v: i32): i32[] {
  if (at < a.len()) {
    return a.with(at, v);
  }
  return a.append(v);
}

function class_table(classes: u8[], idx: i32): u8[] {
  let t: u8[] = __alloc_u8(256);
  let b: i32 = 0;
  while (b < 256) {
    t = t.with(b, classes[idx * 256 + b]);
    b = b + 1;
  }
  return t;
}

function all_bytes(): u8[] {
  let t: u8[] = __alloc_u8(256);
  let b: i32 = 0;
  while (b < 256) {
    t = t.with(b, 1 as u8);
    b = b + 1;
  }
  return t;
}

function prefix_scan(insts: Inst[]): (u8[], boolean, i32) {
  let i: i32 = 0;
  let bol: boolean = false;
  if (i < insts.len() && insts[i].op == op_bol()) {
    bol = true;
    i = i + 1;
  }
  let bs: u8[] = [];
  while (i < insts.len() && insts[i].op == op_char()) {
    bs = bs.append(insts[i].a as u8);
    i = i + 1;
  }
  return (bs, bol, i);
}

function literal_tail(insts: Inst[], at: i32): (boolean, boolean) {
  let i: i32 = at;
  let eol: boolean = false;
  if (i < insts.len() && insts[i].op == op_eol()) {
    eol = true;
    i = i + 1;
  }
  if (i + 1 != insts.len() || insts[i].op != op_match()) {
    return (false, false);
  }
  return (eol, true);
}

function alt_max(): i32 {
  return 8;
}

function branch_literals(insts: Inst[]): u8[][] {
  let none: u8[][] = [];
  let out: u8[][] = [];
  let seen: i32[] = fill(insts.len(), 0);
  let work: i32[] = [0];
  let top: i32 = 1;
  while (top > 0) {
    top = top - 1;
    let pc: i32 = work[top];
    if (seen[pc] != 0) {
      continue;
    }
    seen = seen.with(pc, 1);
    let in: Inst = insts[pc];
    if (in.op == op_char()) {
      let bs: u8[] = [];
      let k: i32 = pc;
      while (k < insts.len() && insts[k].op == op_char()) {
        bs = bs.append(insts[k].a as u8);
        k = k + 1;
      }
      out = out.append(bs);
      if (out.len() > alt_max()) {
        return none;
      }
    } else if (in.op == op_jmp()) {
      work = push_at(work, top, in.a);
      top = top + 1;
    } else if (in.op == op_split()) {
      work = push_at(work, top, in.a);
      work = push_at(work, top + 1, in.b);
      top = top + 2;
    } else if (in.op == op_save() || in.op == op_mark() || in.op == op_progress() || in.op == op_bol() || in.op == op_eol() || in.op == op_assert()) {
      work = push_at(work, top, pc + 1);
      top = top + 1;
    } else {
      return none;
    }
  }
  return out;
}

function find_any_literal(text: Input, lits: u8[][], lo: i32, hi: i32): i32 {
  let best: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < lits.len()) {
    let at: i32 = find_literal(text, lits[i], lo, hi);
    if (at >= 0 && (best < 0 || at < best)) {
      best = at;
      if (best == lo) {
        return best;
      }
    }
    i = i + 1;
  }
  return best;
}

function any_bytes_at(text: Input, at: i32, lits: u8[][], hi: i32): boolean {
  let i: i32 = 0;
  while (i < lits.len()) {
    if (at + lits[i].len() <= hi && bytes_at(text, at, lits[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function bytes_at(text: Input, at: i32, lit: u8[]): boolean {
  match (text) {
    Text(t, _) => {
      let k: i32 = 0;
      while (k < lit.len()) {
        if (t[at + k] as i32 != lit[k] as i32) {
          return false;
        }
        k = k + 1;
      }
      return true;
    },
    Bytes(b, _) => {
      let k: i32 = 0;
      while (k < lit.len()) {
        if (b[at + k] != lit[k]) {
          return false;
        }
        k = k + 1;
      }
      return true;
    }
  }
}

function find_literal(text: Input, lit: u8[], lo: i32, hi: i32): i32 {
  if (lit.len() == 0) {
    return lo;
  }
  let first: i32 = lit[0] as i32;
  let last: i32 = hi - lit.len();
  let i: i32 = lo;
  if (hi == text.len()) {
    while (true) {
      let j: i32 = text.find_byte(first, i);
      if (j < 0 || j > last) {
        return 0 - 1;
      }
      if (bytes_at(text, j, lit)) {
        return j;
      }
      i = j + 1;
    }
  }
  while (i <= last) {
    if (text.at(i) as i32 == first && bytes_at(text, i, lit)) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

struct M { text: Input, lo: i32, hi: i32, re: Bre, target: i32, caps: i32[], marks: i32[], have_zw: boolean, zw_caps: i32[] }

function class_has_byte(re: Bre, idx: i32, b: i32): boolean {
  return re.classes[idx * 256 + b] as i32 != 0;
}

function is_word_at(text: Input, k: i32, lo: i32, hi: i32): boolean {
  if (k < lo || k >= hi) {
    return false;
  }
  let b: i32 = text.at(k) as i32;
  return is_alpha(b) || is_digit(b) || b == 95;
}

function bol_holds(re: Bre, text: Input, pos: i32, lo: i32): boolean {
  if (pos == lo) {
    return true;
  }
  return re.newline_anchor && text.at(pos - 1) as i32 == 10;
}

function eol_holds(re: Bre, text: Input, pos: i32, hi: i32): boolean {
  if (pos >= hi) {
    return true;
  }
  return re.newline_anchor && text.at(pos) as i32 == 10;
}

function assert_holds(text: Input, which: i32, pos: i32, lo: i32, hi: i32): boolean {
  let before: boolean = is_word_at(text, pos - 1, lo, hi);
  let after: boolean = is_word_at(text, pos, lo, hi);
  if (which == assert_wordb()) {
    return before != after;
  }
  if (which == assert_not_wordb()) {
    return before == after;
  }
  if (which == assert_word_start()) {
    return !before && after;
  }
  if (which == assert_word_end()) {
    return before && !after;
  }
  if (which == assert_buf_start()) {
    return pos == lo;
  }
  return pos == hi;
}

function byte_matches(re: Bre, in: Inst, b: i32): boolean {
  if (in.op == op_char()) {
    return in.a == b;
  }
  return class_has_byte(re, in.a, b);
}

function step(m0: M, pc0: i32, pos0: i32, zw0: boolean): (boolean, M) {
  let m: M = m0;
  let pc: i32 = pc0;
  let pos: i32 = pos0;
  let zw: boolean = zw0;
  while (true) {
    let in: Inst = m.re.insts[pc];
    if (in.op == op_char()) {
      if (pos >= m.hi || m.text.at(pos) as i32 != in.a) {
        return (false, m);
      }
      pc = pc + 1;
      pos = pos + 1;
      zw = false;
      continue;
    }
    if (in.op == op_class()) {
      if (pos >= m.hi || !class_has_byte(m.re, in.a, m.text.at(pos) as i32)) {
        return (false, m);
      }
      pc = pc + 1;
      pos = pos + 1;
      zw = false;
      continue;
    }
    if (in.op == op_jmp()) {
      pc = in.a;
      continue;
    }
    if (in.op == op_match()) {
      if (pos != m.target) {
        return (false, m);
      }
      if (!zw) {
        return (true, m);
      }
      if (m.have_zw) {
        return (false, m);
      }
      return (false, M { ...m, have_zw: true, zw_caps: m.caps });
    }
    if (in.op == op_bol()) {
      if (!bol_holds(m.re, m.text, pos, m.lo)) {
        return (false, m);
      }
      pc = pc + 1;
      zw = true;
      continue;
    }
    if (in.op == op_eol()) {
      if (!eol_holds(m.re, m.text, pos, m.hi)) {
        return (false, m);
      }
      pc = pc + 1;
      zw = true;
      continue;
    }
    if (in.op == op_assert()) {
      if (!assert_holds(m.text, in.a, pos, m.lo, m.hi)) {
        return (false, m);
      }
      pc = pc + 1;
      zw = true;
      continue;
    }
    if (in.op == op_progress()) {
      if (m.marks[in.a] == pos) {
        pc = in.b;
      } else {
        pc = pc + 1;
      }
      continue;
    }
    if (in.op == op_backref()) {
      let s: i32 = m.caps[(in.a - 1) * 2];
      let e: i32 = m.caps[(in.a - 1) * 2 + 1];
      if (s < 0 || e < 0) {
        return (false, m);
      }
      let n: i32 = e - s;
      if (pos + n > m.hi || !m.text.same_range(pos, s, n)) {
        return (false, m);
      }
      pc = pc + 1;
      pos = pos + n;
      if (n > 0) {
        zw = false;
      }
      continue;
    }
    return branch(m, pc, pos, in, zw);
  }
  return (false, m);
}

function branch(m0: M, pc: i32, pos: i32, in: Inst, zw: boolean): (boolean, M) {
  if (in.op == op_split()) {
    let r: (boolean, M) = step(m0, in.a, pos, zw);
    if (r.0) {
      return r;
    }
    return step(r.1, in.b, pos, zw);
  }
  if (in.op == op_save()) {
    let old: i32[] = m0.caps;
    let r2: (boolean, M) = step(M { ...m0, caps: regs_at_save(slice_i32(old, 0, old.len()), in, pos, m0.re.ngroups) }, pc + 1, pos, zw);
    if (r2.0) {
      return r2;
    }
    return (false, M { ...r2.1, caps: old });
  }
  if (in.op == op_mark()) {
    let oldm: i32 = m0.marks[in.a];
    let r3: (boolean, M) = step(M { ...m0, marks: m0.marks.with(in.a, pos) }, pc + 1, pos, zw);
    if (r3.0) {
      return r3;
    }
    return (false, M { ...r3.1, marks: r3.1.marks.with(in.a, oldm) });
  }
  return (false, m0);
}

function regs_at_save(own caps: i32[], in: Inst, pos: i32, ngroups: i32): i32[] {
  let slot: i32 = in.a;
  if (slot % 2 == 0) {
    return caps.with(slot, pos).with(slot + 1, 0 - 1);
  }
  let n: i32 = ngroups * 2;
  if (caps[slot - 1] < pos) {
    let ended: i32[] = caps.with(slot, pos);
    let k: i32 = 0;
    while (k < n) {
      ended = ended.with(n + k, ended[k]);
      k = k + 1;
    }
    return ended;
  }
  if (in.b == 1 && caps[n + slot - 1] != 0 - 1) {
    let back: i32[] = caps;
    let j: i32 = 0;
    while (j < n) {
      back = back.with(j, back[n + j]);
      j = j + 1;
    }
    return back;
  }
  return caps.with(slot, pos);
}

function fresh_caps(n: i32): i32[] {
  let c: i32[] = [];
  let k: i32 = 0;
  while (k < n) {
    c = c.append(0 - 1);
    k = k + 1;
  }
  return c;
}

function (re: Bre) exec_input(text: Input): BreMatch {
  return exec_at(re, text, 0, 0, text.len());
}

function (re: Bre) match_at(text: Input, start: i32, hi: i32): i32 {
  if (!re.backref) {
    return dfa_run(re, text, start, 0, hi, false);
  }
  let m: BreMatch = exec_at(re, text, start, 0, hi);
  if (!m.matched) {
    return 0 - 1;
  }
  return m.end;
}

struct DfaCache { trans: Cell[i32[]], sets: Cell[i32[]], offs: Cell[i32[]], slots: Cell[i32[]] }

struct Dfa { trans: i32[], sets: i32[], offs: i32[], slots: i32[], found: i32, epoch: i32, seen: i32[], gen: i32, out: i32[] }

function dfa_cache(): DfaCache {
  let none: i32[] = [];
  return DfaCache { trans: cell_new(none), sets: cell_new(none), offs: cell_new(none), slots: cell_new(none) };
}

function dfa_max_cells(): i32 {
  return 1048576;
}

function dfa_max_words(): i32 {
  return 1048576;
}

function dfa_end(): i32 {
  return 256;
}

function cx_lo(): i32 {
  return 1;
}

function cx_nl(): i32 {
  return 2;
}

function cx_word(): i32 {
  return 4;
}

function cx_search(): i32 {
  return 8;
}

function has_op(insts: Inst[], op: i32): boolean {
  let k: i32 = 0;
  while (k < insts.len()) {
    if (insts[k].op == op) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function reads_lo(insts: Inst[]): boolean {
  let k: i32 = 0;
  while (k < insts.len()) {
    let in: Inst = insts[k];
    if (in.op == op_bol() || in.op == op_assert() && in.a == assert_buf_start()) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function reads_word(insts: Inst[]): boolean {
  let k: i32 = 0;
  while (k < insts.len()) {
    let in: Inst = insts[k];
    if (in.op == op_assert() && in.a != assert_buf_start() && in.a != assert_buf_end()) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function is_word_byte(b: i32): boolean {
  return is_alpha(b) || is_digit(b) || b == 95;
}

function byte_classes(insts: Inst[], classes: u8[], newline: boolean, word: boolean): u8[] {
  let cls: u8[] = __alloc_u8(256);
  let chars: u8[] = __alloc_u8(256);
  let tables: u8[] = __alloc_u8(classes.len() / 256 + 1);
  let k: i32 = 0;
  while (k < insts.len()) {
    let in: Inst = insts[k];
    if (in.op == op_char() && chars[in.a] as i32 == 0) {
      chars = chars.with(in.a, 1 as u8);
      cls = split_classes(cls, classes, 0 - 1, in.a);
    } else if (in.op == op_class() && tables[in.a] as i32 == 0) {
      tables = tables.with(in.a, 1 as u8);
      cls = split_classes(cls, classes, in.a, 0);
    }
    k = k + 1;
  }
  if (newline && chars[10] as i32 == 0) {
    cls = split_classes(cls, classes, 0 - 1, 10);
  }
  if (word) {
    cls = split_classes(cls, classes, 0 - 2, 0);
  }
  return cls;
}

function split_classes(own cls: u8[], classes: u8[], idx: i32, byte: i32): u8[] {
  let remap: i32[] = fill(512, 0 - 1);
  let next: i32 = 0;
  let out: u8[] = cls;
  let b: i32 = 0;
  while (b < 256) {
    let inside: i32 = 0;
    if (idx >= 0 && classes[idx * 256 + b] as i32 != 0 || idx == 0 - 2 && is_word_byte(b) || idx == 0 - 1 && b == byte) {
      inside = 1;
    }
    let key: i32 = out[b] as i32 * 2 + inside;
    if (remap[key] < 0) {
      remap = remap.with(key, next);
      next = next + 1;
    }
    out = out.with(b, remap[key] as u8);
    b = b + 1;
  }
  return out;
}

function class_reps(cls: u8[]): i32[] {
  let reps: i32[] = [];
  let b: i32 = 0;
  while (b < 256) {
    if (cls[b] as i32 == reps.len()) {
      reps = reps.append(b);
    }
    b = b + 1;
  }
  return reps;
}

function ctx_at(re: Bre, text: Input, pos: i32, lo: i32): i32 {
  if (pos == lo) {
    if (re.cx_lo) {
      return cx_lo();
    }
    return 0;
  }
  return ctx_after(re, text.at(pos - 1) as i32);
}

function ctx_after(re: Bre, b: i32): i32 {
  let c: i32 = 0;
  if (re.cx_nl && b == 10) {
    c = c + cx_nl();
  }
  if (re.cx_word && is_word_byte(b)) {
    c = c + cx_word();
  }
  return c;
}

function dfa_zw_holds(re: Bre, in: Inst, ctx: i32, sym: i32): boolean {
  let at_lo: boolean = ctx % 2 == 1;
  if (in.op == op_bol()) {
    return at_lo || ctx / 2 % 2 == 1;
  }
  if (in.op == op_eol()) {
    return sym == dfa_end() || re.newline_anchor && sym == 10;
  }
  let before: boolean = ctx / 4 % 2 == 1;
  let after: boolean = sym != dfa_end() && is_word_byte(sym);
  let which: i32 = in.a;
  if (which == assert_wordb()) {
    return before != after;
  }
  if (which == assert_not_wordb()) {
    return before == after;
  }
  if (which == assert_word_start()) {
    return !before && after;
  }
  if (which == assert_word_end()) {
    return before && !after;
  }
  if (which == assert_buf_start()) {
    return at_lo;
  }
  return sym == dfa_end();
}

function dfa_run(re: Bre, text: Input, start: i32, lo: i32, hi: i32, search: boolean): i32 {
  let row: i32 = re.reps.len() + 1;
  let endc: i32 = row - 1;
  let d: Dfa = dfa_take(re);
  let key: i32 = ctx_at(re, text, start, lo);
  if (search) {
    key = key + cx_search();
  }
  d = dfa_intern(d, key, [0], row);
  let s: i32 = d.found;
  let best: i32 = 0 - 1;
  let pos: i32 = start;
  let is_text: boolean = false;
  let raw_t: string = "";
  let raw_b: u8[] = [];
  match (text) {
    Text(t, _) => {
      is_text = true;
      raw_t = t;
    },
    Bytes(b, _) => {
      raw_b = b;
    }
  }
  while (true) {
    let col: i32 = endc;
    if (pos < hi) {
      if (is_text) {
        col = re.bclass[raw_t[pos] as i32] as i32;
      } else {
        col = re.bclass[raw_b[pos] as i32] as i32;
      }
    }
    let e: i32 = d.trans[s * row + col];
    if (e < 0) {
      d = dfa_step(d, re, s, col);
      e = d.found;
    }
    if ((e & 1) == 1) {
      best = pos;
      if (search) {
        break;
      }
    }
    s = e >> 1;
    if (col == endc || s == 0) {
      break;
    }
    pos = pos + 1;
  }
  dfa_put(re, d);
  return best;
}

function dfa_step(own d0: Dfa, re: Bre, s: i32, col: i32): Dfa {
  let row: i32 = re.reps.len() + 1;
  let sym: i32 = dfa_end();
  if (col < re.reps.len()) {
    sym = re.reps[col];
  }
  let key: i32 = d0.sets[d0.offs[s]];
  let d: Dfa = dfa_closure(d0, re, s, sym);
  let bit: i32 = d.found;
  let pcs: i32[] = d.out;
  let none: i32[] = [];
  d = Dfa { ...d, out: none };
  let next: i32 = 0;
  if (pcs.len() > 0) {
    let nkey: i32 = ctx_after(re, sym);
    if (key >= cx_search()) {
      nkey = nkey + cx_search();
    }
    let epoch: i32 = d.epoch;
    d = dfa_intern(d, nkey, pcs, row);
    next = d.found;
    if (d.epoch != epoch) {
      return Dfa { ...d, found: next * 2 + bit };
    }
  }
  let cell: i32 = next * 2 + bit;
  return Dfa { ...d, trans: d.trans.with(s * row + col, cell), found: cell };
}

function dfa_closure(own d0: Dfa, re: Bre, s: i32, sym: i32): Dfa {
  let d: Dfa = d0;
  let gen: i32 = d.gen + 1;
  if (d.seen.len() == 0 || gen > 100000000) {
    d = Dfa { ...d, seen: fill(re.insts.len() + 1, 0) };
    gen = 1;
  }
  let base: i32 = gen * 4;
  let off: i32 = d.offs[s];
  let key: i32 = d.sets[off];
  let len: i32 = d.sets[off + 1];
  let ctx: i32 = key % cx_search();
  let stack: i32[] = [];
  let sp: i32 = 0;
  while (sp < len) {
    stack = stack.append(d.sets[off + 1 + len - sp]);
    sp = sp + 1;
  }
  let out: i32[] = [];
  let matched: i32 = 0;
  while (sp > 0) {
    sp = sp - 1;
    let pc: i32 = stack[sp];
    let mark: i32 = stamp_bits(d.seen[pc], base);
    if (mark % 2 == 1) {
      continue;
    }
    d = Dfa { ...d, seen: d.seen.with(pc, base + mark + 1) };
    let in: Inst = re.insts[pc];
    let op: i32 = in.op;
    if (op == op_char() || op == op_class()) {
      let nx: i32 = stamp_bits(d.seen[pc + 1], base);
      if (sym != dfa_end() && nx < 2 && byte_matches(re, in, sym)) {
        d = Dfa { ...d, seen: d.seen.with(pc + 1, base + nx + 2) };
        out = out.append(pc + 1);
      }
    } else if (op == op_jmp()) {
      stack = push_at(stack, sp, in.a);
      sp = sp + 1;
    } else if (op == op_split()) {
      stack = push_at(stack, sp, in.b);
      stack = push_at(stack, sp + 1, in.a);
      sp = sp + 2;
    } else if (op == op_match()) {
      matched = 1;
    } else if (op == op_bol() || op == op_eol() || op == op_assert()) {
      if (dfa_zw_holds(re, in, ctx, sym)) {
        stack = push_at(stack, sp, pc + 1);
        sp = sp + 1;
      }
    } else {
      stack = push_at(stack, sp, pc + 1);
      sp = sp + 1;
    }
  }
  if (key >= cx_search() && sym != dfa_end() && stamp_bits(d.seen[0], base) < 2) {
    out = out.append(0);
  }
  return Dfa { ...d, gen: gen, out: out, found: matched };
}

function stamp_bits(v: i32, base: i32): i32 {
  if (v < base) {
    return 0;
  }
  return v - base;
}

function dfa_hash(key: i32, pcs: i32[]): i32 {
  let h: i32 = key + 7;
  let k: i32 = 0;
  while (k < pcs.len()) {
    h = (h * 31 + pcs[k] + 1) % 1000003;
    k = k + 1;
  }
  return h;
}

function dfa_hash_at(sets: i32[], off: i32): i32 {
  let h: i32 = sets[off] + 7;
  let len: i32 = sets[off + 1];
  let k: i32 = 0;
  while (k < len) {
    h = (h * 31 + sets[off + 2 + k] + 1) % 1000003;
    k = k + 1;
  }
  return h;
}

function dfa_same(sets: i32[], off: i32, key: i32, pcs: i32[]): boolean {
  if (sets[off] != key || sets[off + 1] != pcs.len()) {
    return false;
  }
  let k: i32 = 0;
  while (k < pcs.len()) {
    if (sets[off + 2 + k] != pcs[k]) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

function dfa_intern(own d0: Dfa, key: i32, pcs: i32[], row: i32): Dfa {
  let d: Dfa = d0;
  let i: i32 = dfa_hash(key, pcs) % d.slots.len();
  while (d.slots[i] != 0) {
    let id: i32 = d.slots[i] - 1;
    if (dfa_same(d.sets, d.offs[id], key, pcs)) {
      return Dfa { ...d, found: id };
    }
    i = (i + 1) % d.slots.len();
  }
  if (d.trans.len() + row > dfa_max_cells() || d.sets.len() + pcs.len() + 2 > dfa_max_words()) {
    let fresh: Dfa = dfa_reset(d.epoch + 1, row);
    return dfa_intern(Dfa { ...fresh, seen: d.seen, gen: d.gen }, key, pcs, row);
  }
  let id2: i32 = d.offs.len();
  d = Dfa { ...d, offs: d.offs.append(d.sets.len()), slots: d.slots.with(i, id2 + 1) };
  d = Dfa { ...d, sets: d.sets.append(key).append(pcs.len()) };
  let k: i32 = 0;
  while (k < pcs.len()) {
    d = Dfa { ...d, sets: d.sets.append(pcs[k]) };
    k = k + 1;
  }
  let c: i32 = 0;
  while (c < row) {
    d = Dfa { ...d, trans: d.trans.append(0 - 1) };
    c = c + 1;
  }
  if (d.offs.len() * 2 > d.slots.len()) {
    d = Dfa { ...d, slots: dfa_rehash(d.sets, d.offs, d.slots.len() * 2) };
  }
  return Dfa { ...d, found: id2 };
}

function dfa_rehash(sets: i32[], offs: i32[], size: i32): i32[] {
  let slots: i32[] = fill(size, 0);
  let id: i32 = 0;
  while (id < offs.len()) {
    let i: i32 = dfa_hash_at(sets, offs[id]) % size;
    while (slots[i] != 0) {
      i = (i + 1) % size;
    }
    slots = slots.with(i, id + 1);
    id = id + 1;
  }
  return slots;
}

function dfa_reset(epoch: i32, row: i32): Dfa {
  let none: i32[] = [];
  let d: Dfa = Dfa { trans: none, sets: none, offs: none, slots: fill(16, 0), found: 0, epoch: epoch, seen: none, gen: 0, out: none };
  let empty: i32[] = [];
  return dfa_intern(d, 0 - 1, empty, row);
}

function dfa_take(re: Bre): Dfa {
  let trans: i32[] = re.dfa.trans.get();
  let none: i32[] = [];
  if (trans.len() == 0) {
    return dfa_reset(0, re.reps.len() + 1);
  }
  re.dfa.trans.set(none);
  let sets: i32[] = re.dfa.sets.get();
  re.dfa.sets.set(none);
  let offs: i32[] = re.dfa.offs.get();
  re.dfa.offs.set(none);
  let slots: i32[] = re.dfa.slots.get();
  re.dfa.slots.set(none);
  return Dfa { trans: trans, sets: sets, offs: offs, slots: slots, found: 0, epoch: 0, seen: none, gen: 0, out: none };
}

function dfa_put(re: Bre, own d: Dfa): void {
  re.dfa.trans.set(d.trans);
  re.dfa.sets.set(d.sets);
  re.dfa.offs.set(d.offs);
  re.dfa.slots.set(d.slots);
}

function (re: Bre) search_from_input(text: Input, lo: i32, hi: i32): (i32, i32) {
  let start: i32 = lo;
  while (start <= hi) {
    start = next_start(re, text, start, hi);
    if (start < 0) {
      break;
    }
    let end: i32 = re.match_at(text, start, hi);
    if (end >= 0) {
      return (start, end);
    }
    start = start + 1;
  }
  return (0 - 1, 0 - 1);
}

function next_start(re: Bre, text: Input, pos: i32, hi: i32): i32 {
  if (re.pre.len() > 0) {
    return find_literal(text, re.pre, pos, hi);
  }
  if (re.alts.len() > 0) {
    return find_any_literal(text, re.alts, pos, hi);
  }
  if (re.empty_ok) {
    return pos;
  }
  let i: i32 = pos;
  if (hi == text.len()) {
    i = text.scan_set(pos, re.first);
  } else {
    while (i < hi && re.first[text.at(i) as i32] as i32 == 0) {
      i = i + 1;
    }
  }
  if (i >= hi) {
    return 0 - 1;
  }
  return i;
}

function (re: Bre) search_back_input(text: Input, hi: i32): (i32, i32) {
  let start: i32 = hi - 1;
  while (start >= 0) {
    if (can_start_at(re, text, start, hi)) {
      let end: i32 = re.match_at(text, start, hi);
      if (end >= 0) {
        return (start, end);
      }
    }
    start = start - 1;
  }
  return (0 - 1, 0 - 1);
}

function can_start_at(re: Bre, text: Input, pos: i32, hi: i32): boolean {
  let n: i32 = re.pre.len();
  if (n > 0) {
    return pos + n <= hi && bytes_at(text, pos, re.pre);
  }
  if (re.alts.len() > 0) {
    return any_bytes_at(text, pos, re.alts, hi);
  }
  if (re.empty_ok) {
    return true;
  }
  return pos < hi && re.first[text.at(pos) as i32] as i32 != 0;
}

function (re: Bre) search_input(text: Input): boolean {
  return re.search_range_input(text, 0, text.len());
}

function (re: Bre) search_range_input(text: Input, lo: i32, hi: i32): boolean {
  let n: i32 = re.pre.len();
  let pinned: boolean = !re.newline_anchor;
  if (re.literal && (pinned || !re.pre_bol && !re.pre_eol)) {
    if (hi - lo < n) {
      return false;
    }
    if (re.pre_bol && re.pre_eol) {
      return hi - lo == n && bytes_at(text, lo, re.pre);
    }
    if (re.pre_bol) {
      return bytes_at(text, lo, re.pre);
    }
    if (re.pre_eol) {
      return bytes_at(text, hi - n, re.pre);
    }
    return find_literal(text, re.pre, lo, hi) >= 0;
  }
  let from: i32 = lo;
  if (n > 0) {
    if (hi - lo < n) {
      return false;
    }
    if (re.pre_bol && pinned) {
      if (!bytes_at(text, lo, re.pre)) {
        return false;
      }
    } else {
      let at: i32 = find_literal(text, re.pre, lo, hi);
      if (at < 0) {
        return false;
      }
      from = at;
    }
  } else if (re.alts.len() > 0) {
    let first_at: i32 = find_any_literal(text, re.alts, lo, hi);
    if (first_at < 0) {
      return false;
    }
    from = first_at;
  }
  if (re.backref) {
    let i: i32 = from;
    while (i <= hi) {
      if (can_start_at(re, text, i, hi) && exec_backtrack(re, text, i, lo, hi).matched) {
        return true;
      }
      i = i + 1;
    }
    return false;
  }
  return dfa_run(re, text, from, lo, hi, true) >= 0;
}

function exec_at(re: Bre, text: Input, start: i32, lo: i32, hi: i32): BreMatch {
  if (re.backref) {
    return exec_backtrack(re, text, start, lo, hi);
  }
  let no: i32[] = [];
  let end: i32 = dfa_run(re, text, start, lo, hi, false);
  if (end < 0) {
    return BreMatch { matched: false, end: 0, starts: no, ends: no };
  }
  if (re.ngroups == 0) {
    return caps_to_match(no, re, start, end);
  }
  return exec_threads_from(re, text, start, end, lo, hi);
}

function exec_backtrack(re: Bre, text: Input, start: i32, lo: i32, hi: i32): BreMatch {
  let no: i32[] = [];
  let end: i32 = hi;
  while (end >= start) {
    let m: M = M { text: text, lo: lo, hi: hi, re: re, target: end, caps: fresh_caps(re.ngroups * 4), marks: fresh_caps(re.nmarks), have_zw: false, zw_caps: no };
    let r: (boolean, M) = step(m, 0, start, false);
    if (r.0) {
      return caps_to_match(r.1.caps, re, start, end);
    }
    if (r.1.have_zw) {
      return caps_to_match(r.1.zw_caps, re, start, end);
    }
    end = end - 1;
  }
  return BreMatch { matched: false, end: 0, starts: no, ends: no };
}

function zw_stamp(gen: i32): i32 {
  return 0 - gen - 2;
}

function visit(): i32 {
  return 0 - 2;
}

function mark_base(re: Bre): i32 {
  return re.ngroups * 4;
}

function zero_width_holds(re: Bre, text: Input, in: Inst, pos: i32, lo: i32, hi: i32): boolean {
  if (in.op == op_bol()) {
    return bol_holds(re, text, pos, lo);
  }
  if (in.op == op_eol()) {
    return eol_holds(re, text, pos, hi);
  }
  return assert_holds(text, in.a, pos, lo, hi);
}

function exec_threads_from(re: Bre, text: Input, start: i32, end: i32, lo: i32, hi: i32): BreMatch {
  let nregs: i32 = re.ngroups * 4;
  let w: i32 = mark_base(re) + re.nmarks;
  let ni: i32 = re.insts.len();
  let seen: i32[] = re.seen0;
  let cap: i32[] = fresh_caps(w);
  let stack: i32[] = fill(4 * ni * (nregs + 2) + 2, 0);
  let pcs: i32[] = fill(ni, 0);
  let caps: i32[] = fill(ni * w, 0);
  let n: i32 = 0;
  let npcs: i32[] = fill(ni, 0);
  let ncaps: i32[] = fill(ni * w, 0);
  let nn: i32 = 0;
  let match_at: i32 = 0 - 1;
  let best: i32[] = [];
  let pos: i32 = start;
  let seeding: boolean = true;
  while (true) {
    let sources: i32 = 1;
    if (!seeding) {
      let tp: i32[] = pcs;
      pcs = npcs;
      npcs = tp;
      let tc: i32[] = caps;
      caps = ncaps;
      ncaps = tc;
      n = nn;
      nn = 0;
      match_at = 0 - 1;
      sources = n;
    }
    let k: i32 = 0;
    while (k < sources) {
      let pc0: i32 = 0;
      let gen: i32 = start;
      if (!seeding) {
        let in0: Inst = re.insts[pcs[k]];
        if (in0.op == op_match()) {
          if (pos == end && best.len() == 0) {
            best = slice_i32(caps, k * w, w);
          }
          k = k + 1;
          continue;
        }
        if (!steps(re, in0, text, pos, end)) {
          k = k + 1;
          continue;
        }
        let j: i32 = 0;
        while (j < w) {
          cap = cap.with(j, caps[k * w + j]);
          j = j + 1;
        }
        pc0 = pcs[k] + 1;
        gen = pos + 1;
      }
      stack = stack.with(0, pc0 * 2).with(1, visit());
      let sp: i32 = 2;
      while (sp > 0) {
        sp = sp - 2;
        let x: i32 = stack[sp];
        let y: i32 = stack[sp + 1];
        if (y != visit()) {
          cap = cap.with(x, y);
          continue;
        }
        let pc: i32 = x >> 1;
        let zb: i32 = x & 1;
        let entry: i32 = entry_kind(seen[pc], gen, zb);
        if (entry == 0) {
          continue;
        }
        let over: boolean = entry == 2;
        if (zb == 1) {
          seen = seen.with(pc, zw_stamp(gen));
        } else {
          seen = seen.with(pc, gen);
        }
        let in: Inst = re.insts[pc];
        let op: i32 = in.op;
        if (op == op_split()) {
          stack = stack.with(sp, in.b * 2 + zb).with(sp + 1, visit()).with(sp + 2, in.a * 2 + zb).with(sp + 3, visit());
          sp = sp + 4;
        } else if (op == op_save()) {
          let r: i32 = undo_from(in);
          let r_end: i32 = undo_to(in, nregs);
          while (r < r_end) {
            stack = stack.with(sp, r).with(sp + 1, cap[r]);
            sp = sp + 2;
            r = r + 1;
          }
          cap = regs_at_save(cap, in, gen, re.ngroups);
          stack = stack.with(sp, (pc + 1) * 2 + zb).with(sp + 1, visit());
          sp = sp + 2;
        } else if (op == op_mark()) {
          let slot: i32 = mark_base(re) + in.a;
          stack = stack.with(sp, slot).with(sp + 1, cap[slot]).with(sp + 2, (pc + 1) * 2 + zb).with(sp + 3, visit());
          sp = sp + 4;
          cap = cap.with(slot, gen);
        } else if (passes_through(op)) {
          let nv: i32 = successor(re, in, pc, zb, cap, text, gen, lo, hi);
          if (nv >= 0) {
            stack = stack.with(sp, nv).with(sp + 1, visit());
            sp = sp + 2;
          }
        } else if (!over || op == op_match()) {
          let row: i32 = nn;
          if (over) {
            row = match_at;
          } else {
            if (op == op_match()) {
              match_at = nn;
            }
            npcs = npcs.with(nn, pc);
            nn = nn + 1;
          }
          let j2: i32 = 0;
          while (j2 < w) {
            ncaps = ncaps.with(row * w + j2, cap[j2]);
            j2 = j2 + 1;
          }
        }
      }
      k = k + 1;
    }
    if (seeding) {
      seeding = false;
      continue;
    }
    if (pos >= end) {
      break;
    }
    pos = pos + 1;
  }
  return caps_to_match(best, re, start, end);
}

function steps(re: Bre, in: Inst, text: Input, pos: i32, end: i32): boolean {
  return pos < end && byte_matches(re, in, text.at(pos) as i32);
}

function entry_kind(was: i32, gen: i32, zb: i32): i32 {
  if (was == gen) {
    return 0;
  }
  if (zb == 1) {
    if (was == zw_stamp(gen)) {
      return 0;
    }
    return 1;
  }
  if (was < 0 - 1 && was == zw_stamp(gen)) {
    return 2;
  }
  return 1;
}

function undo_from(in: Inst): i32 {
  if (in.a % 2 == 0) {
    return in.a;
  }
  return 0;
}

function undo_to(in: Inst, nregs: i32): i32 {
  if (in.a % 2 == 0) {
    return in.a + 2;
  }
  return nregs;
}

function passes_through(op: i32): boolean {
  return op == op_jmp() || op == op_progress() || op == op_bol() || op == op_eol() || op == op_assert();
}

function successor(re: Bre, in: Inst, pc: i32, zb: i32, cap: i32[], text: Input, pos: i32, lo: i32, hi: i32): i32 {
  if (in.op == op_jmp()) {
    return in.a * 2 + zb;
  }
  if (in.op == op_progress()) {
    if (cap[mark_base(re) + in.a] == pos) {
      return in.b * 2 + zb;
    }
    return (pc + 1) * 2 + zb;
  }
  if (zero_width_holds(re, text, in, pos, lo, hi)) {
    return (pc + 1) * 2 + 1;
  }
  return 0 - 1;
}

function slice_i32(a: i32[], from: i32, n: i32): i32[] {
  let out: i32[] = [];
  let k: i32 = 0;
  while (k < n) {
    out = out.append(a[from + k]);
    k = k + 1;
  }
  return out;
}

function fill(n: i32, v: i32): i32[] {
  let a: i32[] = [];
  let k: i32 = 0;
  while (k < n) {
    a = a.append(v);
    k = k + 1;
  }
  return a;
}

function caps_to_match(caps: i32[], re: Bre, start: i32, end: i32): BreMatch {
  let starts: i32[] = [start];
  let ends: i32[] = [end];
  let g: i32 = 0;
  while (g < re.ngroups) {
    starts = starts.append(caps[g * 2]);
    ends = ends.append(caps[g * 2 + 1]);
    g = g + 1;
  }
  return BreMatch { matched: true, end: end, starts: starts, ends: ends };
}
