// coreutils/lib/bre.fern — POSIX basic regular expressions, as glibc
// compiles them under `RE_SYNTAX_POSIX_BASIC`.
//
// expr(1) compiles with `RE_SYNTAX_POSIX_BASIC`, so that is the main
// dialect here rather than a modern one: the operators are `\(
// `\)` `\|` `\+` `\?` `\{m,n\}`, a bare `*` where no atom precedes it is
// a literal asterisk, `^` is an anchor only where a branch begins and
// `$` only where one ends, and backreferences `\1`…`\9` are part of the
// language. The GNU word operators glibc adds (`\<` `\>` `\b` `\B` `\w`
// `\W` `\s` `\S` `` \` `` `\'`) are here too, because expr users get them
// from glibc whether POSIX blesses them or not. Diagnostics are glibc's
// `regerror` texts verbatim, since that is what the utilities print.
//
// tac(1) never sets a syntax at all, which leaves glibc's default —
// syntax 0, `RE_SYNTAX_EMACS` — and `emacs_syntax()` selects that
// dialect: `+` and `?` are bare operators and `\+` `\?` `\{` `\}` are
// the plain characters, there are no intervals, `[:alpha:]` inside a
// bracket is six ordinary members, `.` matches NUL but not newline, and
// an empty range like `[z-a]` is allowed. Whether `^` holds after a
// newline and `$` before one is a third setting again, decided at match
// time by `newline_anchor`: `re_compile_pattern` sets it, tac leaves it
// set, and expr clears it.
//
// MATCHING is POSIX leftmost-longest at a fixed start, and the pattern
// is run as a program of the usual `Char` / `Split` / `Save` shape. The
// engine that runs it is picked by the pattern: a Thompson simulation
// with every thread in step for the regular ones, and a backtracking
// search for the ones carrying a backreference, which is not a regular
// language. `exec` and the engines below say what each costs and why the
// captures come out where glibc puts them. `search_back` is glibc's
// `re_search` with a negative range, which is the shape tac scans a
// buffer backwards with; `search` and `search_range` are the same call
// reduced to whether a line matches anywhere, which is all nl and csplit
// ask of it, and `search_range` takes the line as bounds into a buffer
// rather than as a string cut out of one.
//
// A search reaches an engine through four filters of decreasing
// strength, laid out at `search_range`: a program that is nothing but a
// literal run never enters one, a program that merely BEGINS with a
// literal run — or with one literal per alternation branch — is
// rejected over the whole range before one is entered, and the fastmap
// skips the positions inside it where no match can start.
import "std/string";
import "std/array";

// ---- instructions ----------------------------------------------------------
//
// `op` selects the form; `a` and `b` are its operands. `Split` tries `a`
// before `b`, which is what makes the search greedy where the compiler
// puts the body first.
struct Inst { op: i32, a: i32, b: i32 }

function op_char(): i32 {
  return 0;
}

function op_class(): i32 {
  return 1;
}

function op_split(): i32 {
  return 2;
}

function op_jmp(): i32 {
  return 3;
}

function op_save(): i32 {
  return 4;
}

function op_match(): i32 {
  return 5;
}

function op_bol(): i32 {
  return 6;
}

function op_eol(): i32 {
  return 7;
}

function op_backref(): i32 {
  return 8;
}

function op_mark(): i32 {
  return 9;
}

function op_progress(): i32 {
  return 10;
}

function op_assert(): i32 {
  return 11;
}

// The zero-width assertions `op_assert` selects between.
function assert_wordb(): i32 {
  return 0;
}

function assert_not_wordb(): i32 {
  return 1;
}

function assert_word_start(): i32 {
  return 2;
}

function assert_word_end(): i32 {
  return 3;
}

function assert_buf_start(): i32 {
  return 4;
}

function assert_buf_end(): i32 {
  return 5;
}

// ---- the compiled pattern --------------------------------------------------
//
// `classes` is one 256-byte membership table per bracket expression, laid
// end to end. `err` is glibc's regerror text when compilation failed and
// empty otherwise; nothing else is valid then. `first` is glibc's
// fastmap — the bytes a match can begin with — and `empty_ok` whether
// the pattern can match nothing at all, which together let a search
// skip the positions where no match can start.
//
// `pre` is the run of bytes every match has to begin with — the leading
// `Char` instructions — with `pre_bol` / `pre_eol` for the anchors
// either side of it. `literal` says the program is NOTHING ELSE, and
// then a search is a byte scan rather than a simulation; the patterns
// real callers hand csplit and nl (`/MARK/`, `^CHAPTER`) are nearly all
// of that shape. Where the program continues past the run, `pre` is a
// stronger fastmap than `first`: a whole run of bytes rather than the
// set the first one falls in.
//
// `alts` is the same condition for a program whose branches diverge
// before the first byte: one literal per branch, of which a match
// begins with one. It is empty where no such set could be proved, and
// then nothing but the fastmap stands in front of the simulation.
//
// `seen0` is the simulation's generation-stamp array in its cleared
// state, held here rather than built per search: the stamps are
// positions, so a cleared one is -1 whatever the search, and the
// engine's first stamp copies this rather than filling a new array on
// every line.
pub struct Bre { insts: Inst[], classes: u8[], ngroups: i32, nmarks: i32, backref: boolean, err: string, newline_anchor: boolean, first: u8[], empty_ok: boolean, pre: string, pre_bol: boolean, pre_eol: boolean, literal: boolean, alts: string[], seen0: i32[] }

// `Syntax` — which glibc dialect a pattern is read in, and whether a
// newline anchors `$` at match time (the header has the three cases).
pub struct Syntax { emacs: boolean, newline_anchor: boolean }

// `posix_basic()` — `RE_SYNTAX_POSIX_BASIC`, with the newline anchor
// `re_compile_pattern` sets and expr then clears back off.
pub function posix_basic(): Syntax {
  return Syntax { emacs: false, newline_anchor: false };
}

// `emacs_syntax()` — glibc's syntax 0, which is what a program gets
// when it never calls `re_set_syntax`.
pub function emacs_syntax(): Syntax {
  return Syntax { emacs: true, newline_anchor: true };
}

// `BreMatch` — `end` is the end of the match, `starts`/`ends` the span of
// each group (-1 where the group did not take part). Group 0 is the whole
// match.
pub struct BreMatch { matched: boolean, end: i32, starts: i32[], ends: i32[] }

// glibc's regerror texts, which expr prints verbatim.
function err_badpat(): string {
  return "Invalid regular expression";
}

function err_ecollate(): string {
  return "Invalid collation character";
}

function err_ectype(): string {
  return "Invalid character class name";
}

function err_eescape(): string {
  return "Trailing backslash";
}

function err_esubreg(): string {
  return "Invalid back reference";
}

function err_ebrack(): string {
  return "Unmatched [, [^, [:, [., or [=";
}

function err_eparen_open(): string {
  return "Unmatched ( or \\(";
}

function err_eparen_close(): string {
  return "Unmatched ) or \\)";
}

function err_ebrace(): string {
  return "Unmatched \\{";
}

function err_badbr(): string {
  return "Invalid content of \\{\\}";
}

function err_erange(): string {
  return "Invalid range end";
}

function err_esize(): string {
  return "Regular expression too big";
}

// RE_DUP_MAX: a repetition count above this is refused, which is why
// `a\{32767\}` compiles and `a\{32768\}` does not.
function dup_max(): i32 {
  return 32767;
}

// The instruction budget. A nest of repetitions can multiply out past
// anything that fits, and glibc answers those with the same text.
function inst_max(): i32 {
  return 200000;
}

// ---- the parse tree --------------------------------------------------------
//
// Parsing builds nodes and compiling walks them, because a counted
// repetition emits its body several times over and a tree is what can be
// emitted twice. `a`/`b`/`c` are child indices or counts by kind.
struct Node { kind: i32, a: i32, b: i32, c: i32 }

function nd_empty(): i32 {
  return 0;
}

function nd_char(): i32 {
  return 1;
}

function nd_class(): i32 {
  return 2;
}

function nd_cat(): i32 {
  return 3;
}

function nd_alt(): i32 {
  return 4;
}

function nd_group(): i32 {
  return 5;
}

function nd_rep(): i32 {
  return 6;
}

function nd_bol(): i32 {
  return 7;
}

function nd_eol(): i32 {
  return 8;
}

function nd_backref(): i32 {
  return 9;
}

function nd_assert(): i32 {
  return 10;
}

// `P` — the parser: the pattern, the cursor, the nodes built so far, the
// group counter, the groups a backreference may name here, the dialect
// the pattern is read in, and the first error met (parsing stops
// reporting after one, the way glibc reports only the first).
struct P { pat: string, i: i32, nodes: Node[], classes: u8[], ngroups: i32, done: i32, err: string, emacs: boolean }

// `done` is a bitmask of the groups COMPLETED at the cursor, over the
// nine a `\N` can spell. glibc scopes a backreference to the alternation
// branch its group closed in: a group closed in a sibling branch is not
// visible, and neither is the group the reference sits inside, which is
// still open. A group closed before an alternation is visible in every
// branch of it, and one closed inside a branch is visible again once the
// whole alternation is behind the cursor.
function group_bit(n: i32): i32 {
  return 1 << n - 1;
}

function group_done(p: P, n: i32): boolean {
  return (p.done & group_bit(n)) != 0;
}

// A number past nine is unnameable, so it takes no bit.
function mark_group_done(p: P, n: i32): P {
  if (n > 9) {
    return p;
  }
  return P { ...p, done: p.done | group_bit(n) };
}

function add_node(p: P, n: Node): (P, i32) {
  var out: P = P { ...p, nodes: p.nodes.append(n) };
  return (out, out.nodes.len() - 1);
}

function fail(p: P, msg: string): P {
  if (p.err.len() > 0) {
    return p;
  }
  return P { ...p, err: msg };
}

function at_end(p: P): boolean {
  return p.i >= p.pat.len();
}

function byte_at(p: P, k: i32): i32 {
  if (k >= p.pat.len()) {
    return 0 - 1;
  }
  return p.pat[k] as i32;
}

// Whether the two bytes at `k` are the escape `\<c>`.
function esc_at(p: P, k: i32, c: i32): boolean {
  return byte_at(p, k) == 92 && byte_at(p, k + 1) == c;
}

function is_digit(b: i32): boolean {
  return b >= 48 && b <= 57;
}

// ---- bracket expressions ---------------------------------------------------
// The 256-byte membership table for one POSIX class name, or an empty
// array when the name is not one.
function class_name_table(name: string): u8[] {
  var t: u8[] = __alloc_u8(256);
  var b: i32 = 0;
  var known: boolean = false;
  while (b < 256) {
    if (class_has(name, b)) {
      t = t.with(b, 1 as u8);
    }
    b = b + 1;
  }
  known = is_class_name(name);
  if (!known) {
    var none: u8[] = [];
    return none;
  }
  return t;
}

function is_class_name(name: string): boolean {
  return name == "alpha" || name == "digit" || name == "alnum" || name == "upper" || name == "lower" || name == "space" || name == "blank" || name == "punct" || name == "print" || name == "graph" || name == "cntrl" || name == "xdigit";
}

function is_upper(b: i32): boolean {
  return b >= 65 && b <= 90;
}

function is_lower(b: i32): boolean {
  return b >= 97 && b <= 122;
}

function is_alpha(b: i32): boolean {
  return is_upper(b) || is_lower(b);
}

function is_space_byte(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

function is_print(b: i32): boolean {
  return b >= 32 && b < 127;
}

// Whether byte `b` is in the POSIX class `name`, in the C locale.
function class_has(name: string, b: i32): boolean {
  if (name == "alpha") {
    return is_alpha(b);
  }
  if (name == "digit") {
    return is_digit(b);
  }
  if (name == "alnum") {
    return is_alpha(b) || is_digit(b);
  }
  if (name == "upper") {
    return is_upper(b);
  }
  if (name == "lower") {
    return is_lower(b);
  }
  if (name == "space") {
    return is_space_byte(b);
  }
  if (name == "blank") {
    return b == 32 || b == 9;
  }
  if (name == "punct") {
    return is_print(b) && b != 32 && !is_alpha(b) && !is_digit(b);
  }
  if (name == "print") {
    return is_print(b);
  }
  if (name == "graph") {
    return is_print(b) && b != 32;
  }
  if (name == "cntrl") {
    return b < 32 || b == 127;
  }
  if (name == "xdigit") {
    return is_digit(b) || b >= 65 && b <= 70 || b >= 97 && b <= 102;
  }
  return false;
}

// `BItem` — one item read from inside a bracket. `kind` is 0 for a plain
// byte, 1 for a `[.x.]` collating element, 2 for a `[=x=]` equivalence
// class and 3 for a `[:name:]` character class; only the first two may
// stand at either end of a range, which is why the kind is kept rather
// than just the byte.
struct BItem { byte: i32, kind: i32, table: u8[], err: string, next: i32 }

function bi_byte(): i32 {
  return 0;
}

function bi_collate(): i32 {
  return 1;
}

function bi_equiv(): i32 {
  return 2;
}

function bi_class(): i32 {
  return 3;
}

// Whether an item can stand at either end of a range.
function range_ok(b: BItem): boolean {
  return b.kind == bi_byte() || b.kind == bi_collate();
}

// One `[: :]`, `[. .]` or `[= =]` item starting at `k` (which points at
// the `[`), or a plain byte. `-` handling is the caller's.
function bracket_item(p: P, k: i32): BItem {
  var none: u8[] = [];
  if (byte_at(p, k) == 91) {
    var kind: i32 = byte_at(p, k + 1);
    // `[:` opens a class only under RE_CHAR_CLASSES, which the Emacs
    // syntax lacks; `[.` and `[=` are recognised in every dialect.
    if (kind == 58 && p.emacs) {
      kind = 0;
    }
    if (kind == 58 || kind == 46 || kind == 61) {
      var close: i32 = find_close(p, k + 2, kind);
      if (close < 0) {
        return BItem { byte: 0, kind: bi_byte(), table: none, err: err_ebrack(), next: k };
      }
      var body: string = slice_unchecked(p.pat, k + 2, close) + "";
      if (kind == 58) {
        var t: u8[] = class_name_table(body);
        if (t.len() == 0) {
          return BItem { byte: 0, kind: bi_byte(), table: none, err: err_ectype(), next: k };
        }
        return BItem { byte: 0, kind: bi_class(), table: t, err: "", next: close + 2 };
      }
      if (body.len() != 1) {
        return BItem { byte: 0, kind: bi_byte(), table: none, err: err_ecollate(), next: k };
      }
      var which: i32 = bi_collate();
      if (kind == 61) {
        which = bi_equiv();
      }
      return BItem { byte: body[0] as i32, kind: which, table: none, err: "", next: close + 2 };
    }
  }
  return BItem { byte: byte_at(p, k), kind: bi_byte(), table: none, err: "", next: k + 1 };
}

// The index of the `<kind>]` closing a `[: :]`-style item, or -1.
function find_close(p: P, from: i32, kind: i32): i32 {
  var k: i32 = from;
  while (k + 1 < p.pat.len()) {
    if (byte_at(p, k) == kind && byte_at(p, k + 1) == 93) {
      return k;
    }
    k = k + 1;
  }
  return 0 - 1;
}

// A bracket expression starting after the `[`. Returns the parser with
// the class appended and the class index, or an error.
function parse_bracket(p0: P): (P, i32) {
  var p: P = p0;
  var t: u8[] = __alloc_u8(256);
  var negate: boolean = false;
  if (byte_at(p, p.i) == 94) {
    negate = true;
    p = P { ...p, i: p.i + 1 };
  }
  if (at_end(p)) {
    return (fail(p, err_badpat()), 0);
  }
  var first: boolean = true;
  while (true) {
    var b: i32 = byte_at(p, p.i);
    if (b < 0) {
      return (fail(p, err_ebrack()), 0);
    }
    if (b == 93 && !first) {
      p = P { ...p, i: p.i + 1 };
      break;
    }
    first = false;
    var r: (P, u8[]) = bracket_one(p, t);
    p = r.0;
    t = r.1;
    if (p.err.len() > 0) {
      return (p, 0);
    }
  }
  if (negate) {
    var k: i32 = 0;
    while (k < 256) {
      if (t[k] as i32 == 0) {
        t = t.with(k, 1 as u8);
      } else {
        t = t.with(k, 0 as u8);
      }
      k = k + 1;
    }
  }
  var idx: i32 = p.classes.len() / 256;
  var cs: u8[] = p.classes;
  var j: i32 = 0;
  while (j < 256) {
    cs = cs.append(t[j]);
    j = j + 1;
  }
  return (P { ...p, classes: cs }, idx);
}

// One member of a bracket expression: a class, a collating element, a
// range, or a byte. `-` is a member itself where no range can start.
function bracket_one(p0: P, t0: u8[]): (P, u8[]) {
  var p: P = p0;
  var t: u8[] = t0;
  var lo: BItem = bracket_item(p, p.i);
  if (lo.err.len() > 0) {
    return (fail(p, lo.err), t);
  }
  p = P { ...p, i: lo.next };
  if (byte_at(p, p.i) != 45 || byte_at(p, p.i + 1) == 93 || byte_at(p, p.i + 1) < 0) {
    if (lo.kind == bi_class()) {
      return (p, union_table(t, lo.table));
    }
    return (p, t.with(lo.byte, 1 as u8));
  }
  if (!range_ok(lo)) {
    return (fail(p, err_erange()), t);
  }
  var hi: BItem = bracket_item(p, p.i + 1);
  if (hi.err.len() > 0) {
    return (fail(p, hi.err), t);
  }
  if (!range_ok(hi)) {
    return (fail(p, err_erange()), t);
  }
  p = P { ...p, i: hi.next };
  var b: i32 = lo.byte;
  while (b <= hi.byte) {
    t = t.with(b, 1 as u8);
    b = b + 1;
  }
  if (byte_at(p, p.i) == 45 && byte_at(p, p.i + 1) != 93 && byte_at(p, p.i + 1) >= 0) {
    return (fail(p, err_erange()), t);
  }
  return (p, t);
}

function union_table(t0: u8[], other: u8[]): u8[] {
  var t: u8[] = t0;
  var k: i32 = 0;
  while (k < 256) {
    if (other[k] as i32 != 0) {
      t = t.with(k, 1 as u8);
    }
    k = k + 1;
  }
  return t;
}

// A class table built from a predicate, for the `\w` family.
function shorthand_table(p0: P, which: i32): (P, i32) {
  var t: u8[] = __alloc_u8(256);
  var b: i32 = 0;
  while (b < 256) {
    if (shorthand_has(which, b)) {
      t = t.with(b, 1 as u8);
    }
    b = b + 1;
  }
  var idx: i32 = p0.classes.len() / 256;
  var cs: u8[] = p0.classes;
  var j: i32 = 0;
  while (j < 256) {
    cs = cs.append(t[j]);
    j = j + 1;
  }
  return (P { ...p0, classes: cs }, idx);
}

// `which`: 0 `\w`, 1 `\W`, 2 `\s`, 3 `\S`.
function shorthand_has(which: i32, b: i32): boolean {
  var word: boolean = is_alpha(b) || is_digit(b) || b == 95;
  if (which == 0) {
    return word;
  }
  if (which == 1) {
    return !word;
  }
  if (which == 2) {
    return is_space_byte(b);
  }
  return !is_space_byte(b);
}

// The class table for `.`: every byte but NUL under POSIX
// (`RE_DOT_NOT_NULL`), every byte but newline under Emacs, where it is
// `RE_DOT_NEWLINE` that is missing instead.
function any_table(p0: P): (P, i32) {
  var idx: i32 = p0.classes.len() / 256;
  var cs: u8[] = p0.classes;
  var skip: i32 = 0;
  if (p0.emacs) {
    skip = 10;
  }
  var j: i32 = 0;
  while (j < 256) {
    if (j == skip) {
      cs = cs.append(0 as u8);
    } else {
      cs = cs.append(1 as u8);
    }
    j = j + 1;
  }
  return (P { ...p0, classes: cs }, idx);
}

// ---- the grammar -----------------------------------------------------------
// A whole alternation, ending at the pattern's end or at the `\)` the
// caller opened. Each branch starts from the groups completed BEFORE the
// alternation, and the alternation leaves behind everything any of its
// branches completed.
function parse_alt(p0: P): (P, i32) {
  var outer: i32 = p0.done;
  var r: (P, i32) = parse_branch(p0);
  var p: P = r.0;
  var left: i32 = r.1;
  while (p.err.len() == 0 && esc_at(p, p.i, 124)) {
    var sofar: i32 = p.done;
    p = P { ...p, i: p.i + 2, done: outer };
    var r2: (P, i32) = parse_branch(p);
    p = P { ...r2.0, done: r2.0.done | sofar };
    var n: (P, i32) = add_node(p, Node { kind: nd_alt(), a: left, b: r2.1, c: 0 });
    p = n.0;
    left = n.1;
  }
  return (p, left);
}

// One branch: pieces concatenated until `\|`, `\)` or the end.
function parse_branch(p0: P): (P, i32) {
  var p: P = p0;
  var cur: i32 = 0 - 1;
  while (true) {
    if (p.err.len() > 0) {
      return (p, empty_node(p, cur));
    }
    if (at_end(p) || esc_at(p, p.i, 124) || esc_at(p, p.i, 41)) {
      break;
    }
    var r: (P, i32) = parse_piece(p, cur < 0);
    p = r.0;
    if (p.err.len() > 0) {
      return (p, empty_node(p, cur));
    }
    if (cur < 0) {
      cur = r.1;
    } else {
      var n: (P, i32) = add_node(p, Node { kind: nd_cat(), a: cur, b: r.1, c: 0 });
      p = n.0;
      cur = n.1;
    }
  }
  if (cur >= 0) {
    return (p, cur);
  }
  return (p, 0);
}

// Node 0 is always the empty match, so a branch with nothing in it and
// an aborted parse both have something to point at.
function empty_node(p: P, cur: i32): i32 {
  if (cur >= 0) {
    return cur;
  }
  return 0;
}

// One atom with its postfix operators. A zero-width atom takes none —
// `^` and the GNU word operators alike: in `^*a` and in `\<\?a` the
// operator has nothing to repeat, so it is the literal asterisk and the
// literal question mark.
function parse_piece(p0: P, first: boolean): (P, i32) {
  var r: (P, i32) = parse_atom(p0, first);
  var p: P = r.0;
  var node: i32 = r.1;
  if (p.err.len() > 0 || p.nodes[node].kind == nd_bol() || p.nodes[node].kind == nd_assert()) {
    return (p, node);
  }
  while (true) {
    if (byte_at(p, p.i) == 42) {
      p = P { ...p, i: p.i + 1 };
      var s: (P, i32) = add_node(p, Node { kind: nd_rep(), a: node, b: 0, c: 0 - 1 });
      p = s.0;
      node = s.1;
      continue;
    }
    // `+` and `?` are spelled bare under Emacs (`RE_BK_PLUS_QM` off) and
    // backslashed under POSIX; the other spelling is a literal in each.
    if (plus_at(p, p.i)) {
      p = P { ...p, i: p.i + op_width(p) };
      var pl: (P, i32) = add_node(p, Node { kind: nd_rep(), a: node, b: 1, c: 0 - 1 });
      p = pl.0;
      node = pl.1;
      continue;
    }
    if (query_at(p, p.i)) {
      p = P { ...p, i: p.i + op_width(p) };
      var q: (P, i32) = add_node(p, Node { kind: nd_rep(), a: node, b: 0, c: 1 });
      p = q.0;
      node = q.1;
      continue;
    }
    if (!p.emacs && esc_at(p, p.i, 123)) {
      var iv: (P, i32) = parse_interval(p, node);
      p = iv.0;
      node = iv.1;
      if (p.err.len() > 0) {
        return (p, node);
      }
      continue;
    }
    break;
  }
  return (p, node);
}

function plus_at(p: P, k: i32): boolean {
  if (p.emacs) {
    return byte_at(p, k) == 43;
  }
  return esc_at(p, k, 43);
}

function query_at(p: P, k: i32): boolean {
  if (p.emacs) {
    return byte_at(p, k) == 63;
  }
  return esc_at(p, k, 63);
}

// How many pattern bytes a `+` or `?` operator occupies.
function op_width(p: P): i32 {
  if (p.emacs) {
    return 1;
  }
  return 2;
}

// `\{m,n\}` after the atom in `node`. Emacs syntax has no intervals
// (`RE_INTERVALS` off), so `\{` never reaches here from that dialect and
// parse_escape reads it as a plain brace.
function parse_interval(p0: P, node: i32): (P, i32) {
  var p: P = P { ...p0, i: p0.i + 2 };
  var lo: (i32, i32) = read_count(p, p.i);
  var min: i32 = lo.0;
  var k: i32 = lo.1;
  var max: i32 = min;
  var comma: boolean = false;
  if (byte_at(p, k) == 44) {
    comma = true;
    var hi: (i32, i32) = read_count(p, k + 1);
    max = hi.0;
    k = hi.1;
  }
  if (!esc_at(p, k, 125)) {
    // A `\}` further on means the braces are closed and what is between
    // them is the fault; none at all means they are not closed at all.
    if (has_close_brace(p, k)) {
      return (fail(p, err_badbr()), node);
    }
    return (fail(p, err_ebrace()), node);
  }
  p = P { ...p, i: k + 2 };
  if (!valid_interval(min, max, comma)) {
    return (fail(p, err_badbr()), node);
  }
  if (min > dup_max() || max > dup_max()) {
    return (fail(p, err_esize()), node);
  }
  if (comma && max < 0) {
    return add_node(p, Node { kind: nd_rep(), a: node, b: min, c: 0 - 1 });
  }
  return add_node(p, Node { kind: nd_rep(), a: node, b: min, c: max });
}

function has_close_brace(p: P, from: i32): boolean {
  var k: i32 = from;
  while (k + 1 < p.pat.len()) {
    if (esc_at(p, k, 125)) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

// A count: -1 when absent, and clamped past `dup_max` so an enormous one
// is still refused rather than wrapping.
function read_count(p: P, from: i32): (i32, i32) {
  var k: i32 = from;
  var v: i32 = 0 - 1;
  while (is_digit(byte_at(p, k))) {
    if (v < 0) {
      v = 0;
    }
    if (v <= dup_max()) {
      v = v * 10 + (byte_at(p, k) - 48);
    }
    k = k + 1;
  }
  return (v, k);
}

// `\{\}` and `\{2,1\}` are content errors; `\{,2\}` is 0 to 2 and
// `\{,\}` is 0 or more, both glibc extensions expr users meet.
function valid_interval(min: i32, max: i32, comma: boolean): boolean {
  if (min < 0 && !comma) {
    return false;
  }
  if (min < 0 && max < 0 && comma) {
    return true;
  }
  if (!comma) {
    return min >= 0;
  }
  if (max < 0) {
    return true;
  }
  var lo: i32 = min;
  if (lo < 0) {
    lo = 0;
  }
  return lo <= max;
}

// One atom. `first` says the branch has nothing in it yet, which is what
// makes `^` an anchor and `*` a literal.
function parse_atom(p0: P, first: boolean): (P, i32) {
  var p: P = p0;
  var b: i32 = byte_at(p, p.i);
  if (b == 94 && first) {
    p = P { ...p, i: p.i + 1 };
    return add_node(p, Node { kind: nd_bol(), a: 0, b: 0, c: 0 });
  }
  if (b == 36 && dollar_is_anchor(p, p.i + 1)) {
    p = P { ...p, i: p.i + 1 };
    return add_node(p, Node { kind: nd_eol(), a: 0, b: 0, c: 0 });
  }
  if (b == 46) {
    p = P { ...p, i: p.i + 1 };
    var an: (P, i32) = any_table(p);
    return add_node(an.0, Node { kind: nd_class(), a: an.1, b: 0, c: 0 });
  }
  if (b == 91) {
    p = P { ...p, i: p.i + 1 };
    var br: (P, i32) = parse_bracket(p);
    if (br.0.err.len() > 0) {
      return (br.0, 0);
    }
    return add_node(br.0, Node { kind: nd_class(), a: br.1, b: 0, c: 0 });
  }
  if (b == 92) {
    return parse_escape(p);
  }
  p = P { ...p, i: p.i + 1 };
  return add_node(p, Node { kind: nd_char(), a: b, b: 0, c: 0 });
}

// A `$` is an anchor only at the end of a branch: the pattern's end, or
// before `\)` or `\|`.
function dollar_is_anchor(p: P, next: i32): boolean {
  if (next >= p.pat.len()) {
    return true;
  }
  return esc_at(p, next, 41) || esc_at(p, next, 124);
}

// Everything spelled `\<c>`.
function parse_escape(p0: P): (P, i32) {
  var p: P = p0;
  var c: i32 = byte_at(p, p.i + 1);
  if (c < 0) {
    return (fail(p, err_eescape()), 0);
  }
  if (c == 40) {
    return parse_group(P { ...p, i: p.i + 2 });
  }
  if (c == 41) {
    return (fail(p, err_eparen_close()), 0);
  }
  if (c >= 49 && c <= 57) {
    p = P { ...p, i: p.i + 2 };
    if (!group_done(p, c - 48)) {
      return (fail(p, err_esubreg()), 0);
    }
    return add_node(p, Node { kind: nd_backref(), a: c - 48, b: 0, c: 0 });
  }
  var sh: i32 = shorthand_index(c);
  if (sh >= 0) {
    p = P { ...p, i: p.i + 2 };
    var st: (P, i32) = shorthand_table(p, sh);
    return add_node(st.0, Node { kind: nd_class(), a: st.1, b: 0, c: 0 });
  }
  var az: i32 = assert_index(c);
  if (az >= 0) {
    p = P { ...p, i: p.i + 2 };
    return add_node(p, Node { kind: nd_assert(), a: az, b: 0, c: 0 });
  }
  p = P { ...p, i: p.i + 2 };
  return add_node(p, Node { kind: nd_char(), a: c, b: 0, c: 0 });
}

function shorthand_index(c: i32): i32 {
  if (c == 119) {
    return 0;
  }
  if (c == 87) {
    return 1;
  }
  if (c == 115) {
    return 2;
  }
  if (c == 83) {
    return 3;
  }
  return 0 - 1;
}

function assert_index(c: i32): i32 {
  if (c == 98) {
    return assert_wordb();
  }
  if (c == 66) {
    return assert_not_wordb();
  }
  if (c == 60) {
    return assert_word_start();
  }
  if (c == 62) {
    return assert_word_end();
  }
  if (c == 96) {
    return assert_buf_start();
  }
  if (c == 39) {
    return assert_buf_end();
  }
  return 0 - 1;
}

// `\( … \)`. The group number is taken before the body is parsed, so
// groups are numbered by their opening parenthesis as glibc numbers them,
// but the group only becomes referenceable at its `\)`.
function parse_group(p0: P): (P, i32) {
  var n: i32 = p0.ngroups + 1;
  var r: (P, i32) = parse_alt(P { ...p0, ngroups: n });
  var p: P = r.0;
  if (p.err.len() > 0) {
    return (p, 0);
  }
  if (!esc_at(p, p.i, 41)) {
    return (fail(p, err_eparen_open()), 0);
  }
  p = mark_group_done(P { ...p, i: p.i + 2 }, n);
  return add_node(p, Node { kind: nd_group(), a: r.1, b: n, c: 0 });
}

// ---- compilation -----------------------------------------------------------
// `C` — the emitter: the instruction list, the mark slots handed to star
// loops, and the first error (only the instruction budget can fail here).
struct C { insts: Inst[], nmarks: i32, err: string }

// `emit` returns the emitter alone rather than the emitter and the index
// it wrote at, and a caller that needs the index reads `c.insts.len()`
// BEFORE the call. Returning the pair would cost a copy of the whole
// instruction array per instruction (#8498), which a pattern like
// `a\{32767\}` feels as a quadratic compile.
function emit(c: C, in: Inst): C {
  if (c.insts.len() >= inst_max()) {
    return C { ...c, err: err_esize() };
  }
  return C { ...c, insts: c.insts.append(in) };
}

function patch_a(c: C, at: i32, target: i32): C {
  var in: Inst = c.insts[at];
  return C { ...c, insts: c.insts.with(at, Inst { ...in, a: target }) };
}

function patch_b(c: C, at: i32, target: i32): C {
  var in: Inst = c.insts[at];
  return C { ...c, insts: c.insts.with(at, Inst { ...in, b: target }) };
}

function compile_node(c0: C, nodes: Node[], node: i32): C {
  var c: C = c0;
  if (c.err.len() > 0) {
    return c;
  }
  var n: Node = nodes[node];
  if (n.kind == nd_empty()) {
    return c;
  }
  if (n.kind == nd_char()) {
    return emit(c, Inst { op: op_char(), a: n.a, b: 0 });
  }
  if (n.kind == nd_class()) {
    return emit(c, Inst { op: op_class(), a: n.a, b: 0 });
  }
  if (n.kind == nd_bol()) {
    return emit(c, Inst { op: op_bol(), a: 0, b: 0 });
  }
  if (n.kind == nd_eol()) {
    return emit(c, Inst { op: op_eol(), a: 0, b: 0 });
  }
  if (n.kind == nd_assert()) {
    return emit(c, Inst { op: op_assert(), a: n.a, b: 0 });
  }
  if (n.kind == nd_backref()) {
    return emit(c, Inst { op: op_backref(), a: n.a, b: 0 });
  }
  if (n.kind == nd_cat()) {
    return compile_node(compile_node(c, nodes, n.a), nodes, n.b);
  }
  if (n.kind == nd_group()) {
    // Written as one nested expression rather than three steps: naming
    // the emitter between the appends costs a copy of the instruction
    // array at each one (#8498).
    return emit(compile_node(emit(c, Inst { op: op_save(), a: (n.b - 1) * 2, b: 0 }), nodes, n.a), Inst { op: op_save(), a: (n.b - 1) * 2 + 1, b: 0 });
  }
  if (n.kind == nd_alt()) {
    return compile_alt(c, nodes, n);
  }
  return compile_rep(c, nodes, n);
}

function compile_alt(c0: C, nodes: Node[], n: Node): C {
  var split: i32 = c0.insts.len();
  var c: C = emit(c0, Inst { op: op_split(), a: 0, b: 0 });
  c = patch_a(c, split, c.insts.len());
  c = compile_node(c, nodes, n.a);
  var jump: i32 = c.insts.len();
  c = emit(c, Inst { op: op_jmp(), a: 0, b: 0 });
  c = patch_b(c, split, c.insts.len());
  c = compile_node(c, nodes, n.b);
  if (c.err.len() > 0) {
    return c;
  }
  return patch_a(c, jump, c.insts.len());
}

// A repetition: `min` mandatory copies, then either a star loop or
// `max - min` optional ones.
//
// The mandatory copies are compiled ONCE and spliced, rather than
// recompiled per copy: recompiling threads the growing program through
// the emitter again for every copy, and each of those appends copies the
// whole instruction array (#8498), which makes `\(ab\)\{32767\}`
// quadratic. Splicing appends into one array in one loop, which grows in
// place.
function compile_rep(c0: C, nodes: Node[], n: Node): C {
  var c: C = compile_copies(c0, nodes, n.a, rep_min(n));
  if (c.err.len() > 0) {
    return c;
  }
  if (n.c < 0) {
    return compile_star(c, nodes, n.a);
  }
  return compile_optionals(c, nodes, n.a, n.c - rep_min(n));
}

function compile_copies(c0: C, nodes: Node[], body: i32, times: i32): C {
  if (times <= 0) {
    return c0;
  }
  var empty: Inst[] = [];
  var one: C = compile_node(C { insts: empty, nmarks: 0, err: "" }, nodes, body);
  if (one.err.len() > 0) {
    return C { ...c0, err: one.err };
  }
  return splice(C { ...c0, nmarks: c0.nmarks + one.nmarks * times }, one.insts, times, c0.nmarks, one.nmarks);
}

// `times` copies of `body`, each with its branch targets moved to where
// the copy landed and its mark slots moved past the earlier copies' —
// a star in the body needs one slot per copy, not one shared between
// them.
function splice(c: C, body: Inst[], times: i32, slot0: i32, slots: i32): C {
  if (c.insts.len() + body.len() * times > inst_max()) {
    return C { ...c, err: err_esize() };
  }
  var out: Inst[] = c.insts;
  var t: i32 = 0;
  while (t < times) {
    var base: i32 = out.len();
    var slot_base: i32 = slot0 + slots * t;
    var k: i32 = 0;
    while (k < body.len()) {
      out = out.append(relocate(body[k], base, slot_base));
      k = k + 1;
    }
    t = t + 1;
  }
  return C { ...c, insts: out };
}

function relocate(in: Inst, base: i32, slot_base: i32): Inst {
  if (in.op == op_split()) {
    return Inst { op: in.op, a: in.a + base, b: in.b + base };
  }
  if (in.op == op_jmp()) {
    return Inst { ...in, a: in.a + base };
  }
  if (in.op == op_mark() || in.op == op_progress()) {
    return Inst { ...in, a: in.a + slot_base };
  }
  return in;
}

function rep_min(n: Node): i32 {
  if (n.b < 0) {
    return 0;
  }
  return n.b;
}

// `x*` as a loop whose body may not match empty: the `Mark` records where
// the iteration began and `Progress` refuses to go round again from the
// same place, which is how `\(a*\)*` reports the last non-empty pass.
function compile_star(c0: C, nodes: Node[], body: i32): C {
  var slot: i32 = c0.nmarks;
  var c: C = C { ...c0, nmarks: slot + 1 };
  var top: i32 = c.insts.len();
  c = emit(c, Inst { op: op_split(), a: 0, b: 0 });
  c = patch_a(c, top, c.insts.len());
  c = emit(c, Inst { op: op_mark(), a: slot, b: 0 });
  c = compile_node(c, nodes, body);
  if (c.err.len() > 0) {
    return c;
  }
  c = emit(c, Inst { op: op_progress(), a: slot, b: 0 });
  c = emit(c, Inst { op: op_jmp(), a: top, b: 0 });
  return patch_b(c, top, c.insts.len());
}

// `count` nested optional copies, longest first.
function compile_optionals(c0: C, nodes: Node[], body: i32, count: i32): C {
  if (count <= 0) {
    return c0;
  }
  var split: i32 = c0.insts.len();
  var c: C = emit(c0, Inst { op: op_split(), a: 0, b: 0 });
  c = patch_a(c, split, c.insts.len());
  c = compile_node(c, nodes, body);
  c = compile_optionals(c, nodes, body, count - 1);
  if (c.err.len() > 0) {
    return c;
  }
  return patch_b(c, split, c.insts.len());
}

// Whether the tree holds a backreference, which is what rules out
// memoising failures during the match.
function has_backref(nodes: Node[]): boolean {
  var k: i32 = 0;
  while (k < nodes.len()) {
    if (nodes[k].kind == nd_backref()) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

// `bre_compile(pat)` — the pattern as a program in expr's dialect
// (POSIX basic, `$` blind to newlines), or a `Bre` whose `err` carries
// glibc's text for what is wrong with it.
pub function bre_compile(pat: string): Bre {
  return bre_compile_syntax(pat, posix_basic());
}

// `bre_compile_syntax(pat, syntax)` — the same in the dialect asked for.
pub function bre_compile_syntax(pat: string, syntax: Syntax): Bre {
  var nodes: Node[] = [Node { kind: nd_empty(), a: 0, b: 0, c: 0 }];
  var cls: u8[] = [];
  var none_first: u8[] = [];
  var no_alts: string[] = [];
  var no_seen: i32[] = [];
  var p: P = P { pat: pat, i: 0, nodes: nodes, classes: cls, ngroups: 0, done: 0, err: "", emacs: syntax.emacs };
  var r: (P, i32) = parse_alt(p);
  p = r.0;
  if (p.err.len() == 0 && !at_end(p)) {
    p = fail(p, err_eparen_close());
  }
  if (p.err.len() > 0) {
    var no_insts: Inst[] = [];
    return Bre { insts: no_insts, classes: p.classes, ngroups: 0, nmarks: 0, backref: false, err: p.err, newline_anchor: syntax.newline_anchor, first: none_first, empty_ok: true, pre: "", pre_bol: false, pre_eol: false, literal: false, alts: no_alts, seen0: no_seen };
  }
  var empty: Inst[] = [];
  var c: C = C { insts: empty, nmarks: 0, err: "" };
  // No `Save` pair around the whole program: the match is anchored, so
  // group 0 always spans 0 to the end, and a pattern with no groups of
  // its own then carries no capture vector at all.
  c = compile_node(C { ...c, insts: empty }, p.nodes, r.1);
  c = emit(c, Inst { op: op_match(), a: 0, b: 0 });
  if (c.err.len() > 0) {
    var none: Inst[] = [];
    return Bre { insts: none, classes: p.classes, ngroups: 0, nmarks: 0, backref: false, err: c.err, newline_anchor: syntax.newline_anchor, first: none_first, empty_ok: true, pre: "", pre_bol: false, pre_eol: false, literal: false, alts: no_alts, seen0: no_seen };
  }
  var fm: (u8[], boolean) = fastmap(c.insts, p.classes);
  var pre: (string, boolean, i32) = prefix_scan(c.insts);
  var tail: (boolean, boolean) = literal_tail(c.insts, pre.2);
  // A program with a prefix run needs no branch literals: `pre` is that
  // one branch, and the stronger filter of the two.
  var alts: string[] = no_alts;
  if (pre.0.len() == 0) {
    alts = branch_literals(c.insts);
  }
  return Bre { insts: c.insts, classes: p.classes, ngroups: p.ngroups, nmarks: c.nmarks, backref: has_backref(p.nodes), err: "", newline_anchor: syntax.newline_anchor, first: fm.0, empty_ok: fm.1, pre: pre.0, pre_bol: pre.1, pre_eol: tail.0, literal: tail.1, alts: alts, seen0: fill(c.insts.len(), 0 - 1) };
}

// ---- the fastmap -----------------------------------------------------------
// The bytes a match can begin with, and whether one can be empty: the
// closure of the entry point over every instruction that consumes
// nothing, with each zero-width test assumed to pass. A backreference
// stands for any byte or none, since what it repeats is not known yet.
function fastmap(insts: Inst[], classes: u8[]): (u8[], boolean) {
  var t: u8[] = __alloc_u8(256);
  var seen: i32[] = fill(insts.len(), 0);
  var work: i32[] = [0];
  var empty_ok: boolean = false;
  // `work` is a stack read by index: an array has no pop, and `take`
  // would copy it on every step.
  var top: i32 = 1;
  while (top > 0) {
    top = top - 1;
    var pc: i32 = work[top];
    if (seen[pc] != 0) {
      continue;
    }
    seen = seen.with(pc, 1);
    var in: Inst = insts[pc];
    if (in.op == op_char()) {
      t = t.with(in.a, 1 as u8);
    } else if (in.op == op_class()) {
      t = union_table(t, class_table(classes, in.a));
    } else if (in.op == op_match()) {
      empty_ok = true;
    } else if (in.op == op_backref()) {
      t = union_table(t, all_bytes());
      empty_ok = true;
    } else if (in.op == op_jmp()) {
      work = push_at(work, top, in.a);
      top = top + 1;
    } else if (in.op == op_split()) {
      work = push_at(work, top, in.a);
      work = push_at(work, top + 1, in.b);
      top = top + 2;
    } else {
      work = push_at(work, top, pc + 1);
      top = top + 1;
    }
  }
  return (t, empty_ok);
}

// Store `v` at `at`, growing the array when `at` is its length.
function push_at(a: i32[], at: i32, v: i32): i32[] {
  if (at < a.len()) {
    return a.with(at, v);
  }
  return a.append(v);
}

function class_table(classes: u8[], idx: i32): u8[] {
  var t: u8[] = __alloc_u8(256);
  var b: i32 = 0;
  while (b < 256) {
    t = t.with(b, classes[idx * 256 + b]);
    b = b + 1;
  }
  return t;
}

function all_bytes(): u8[] {
  var t: u8[] = __alloc_u8(256);
  var b: i32 = 0;
  while (b < 256) {
    t = t.with(b, 1 as u8);
    b = b + 1;
  }
  return t;
}

// ---- the literal prefix ----------------------------------------------------
// The fastmap answers with a SET the first byte has to fall in. Where a
// program opens with a run of `Char` instructions there is a stronger
// answer — the run itself — and where the program is that run and
// nothing else the search is the byte scan and no engine runs at all.
// `prefix_scan(insts)` — the leading `Char` run of a program, whether a
// `^` precedes it, and the instruction the run stops at. Instructions
// run in sequence, so those bytes are what EVERY match begins with,
// whatever the rest of the program does.
function prefix_scan(insts: Inst[]): (string, boolean, i32) {
  var i: i32 = 0;
  var bol: boolean = false;
  if (i < insts.len() && insts[i].op == op_bol()) {
    bol = true;
    i = i + 1;
  }
  var bs: u8[] = [];
  while (i < insts.len() && insts[i].op == op_char()) {
    bs = bs.append(insts[i].a as u8);
    i = i + 1;
  }
  return (string_from_bytes_unchecked(bs), bol, i);
}

// Whether what follows the prefix run is only an optional `$` and the
// match — which makes the whole program that literal — and whether the
// `$` is there. A class, a repetition, an alternation or a group is
// neither.
function literal_tail(insts: Inst[], at: i32): (boolean, boolean) {
  var i: i32 = at;
  var eol: boolean = false;
  if (i < insts.len() && insts[i].op == op_eol()) {
    eol = true;
    i = i + 1;
  }
  if (i + 1 != insts.len() || insts[i].op != op_match()) {
    return (false, false);
  }
  return (eol, true);
}

// How many branch literals are worth carrying. Each one costs the
// search a byte scan of its own, so a pattern that alternates over more
// than this answers faster by simulating than by scanning for every
// branch first.
function alt_max(): i32 {
  return 8;
}

// `branch_literals(insts)` — one literal per branch of the entry point,
// such that EVERY match begins with one of them, or an empty list where
// no such set exists.
//
// `prefix_scan` reads the program in sequence and so stops at the first
// `Split`, which leaves an alternation with no prefix at all. This walks
// the same closure the fastmap does and collects, per branch, the run of
// `Char` instructions it opens with — a whole literal rather than the
// set of first bytes the fastmap unions those branches into.
//
// The conservative direction is an EMPTY list, and every case that is
// not provably a literal takes it: a branch reaching a class, a
// backreference, `Match` (so the pattern can match nothing), or any op
// this does not recognise gives up on the whole analysis rather than on
// that one branch, since a branch with no required literal makes the
// filter unsound for the others too. Zero-width instructions consume
// nothing and so cannot move where a match begins; walking through them
// keeps the literal behind them.
function branch_literals(insts: Inst[]): string[] {
  var none: string[] = [];
  var out: string[] = [];
  var seen: i32[] = fill(insts.len(), 0);
  var work: i32[] = [0];
  var top: i32 = 1;
  while (top > 0) {
    top = top - 1;
    var pc: i32 = work[top];
    if (seen[pc] != 0) {
      continue;
    }
    seen = seen.with(pc, 1);
    var in: Inst = insts[pc];
    if (in.op == op_char()) {
      var bs: u8[] = [];
      var k: i32 = pc;
      while (k < insts.len() && insts[k].op == op_char()) {
        bs = bs.append(insts[k].a as u8);
        k = k + 1;
      }
      out = out.append(string_from_bytes_unchecked(bs));
      if (out.len() > alt_max()) {
        return none;
      }
    } else if (in.op == op_jmp()) {
      work = push_at(work, top, in.a);
      top = top + 1;
    } else if (in.op == op_split()) {
      work = push_at(work, top, in.a);
      work = push_at(work, top + 1, in.b);
      top = top + 2;
    } else if (in.op == op_save() || in.op == op_mark() || in.op == op_progress() || in.op == op_bol() || in.op == op_eol() || in.op == op_assert()) {
      work = push_at(work, top, pc + 1);
      top = top + 1;
    } else {
      return none;
    }
  }
  return out;
}

// The first index in `text[lo..hi)` at which any of `lits` occurs, or
// -1 where none does. A match begins with one of them, so that index is
// the earliest position one can start at.
function find_any_literal(text: string, lits: string[], lo: i32, hi: i32): i32 {
  var best: i32 = 0 - 1;
  var i: i32 = 0;
  while (i < lits.len()) {
    var at: i32 = find_literal(text, lits[i], lo, hi);
    if (at >= 0 && (best < 0 || at < best)) {
      best = at;
      if (best == lo) {
        return best;
      }
    }
    i = i + 1;
  }
  return best;
}

// Whether one of `lits` sits at `at`. The caller has not checked the
// room, since the literals differ in length.
function any_bytes_at(text: string, at: i32, lits: string[], hi: i32): boolean {
  var i: i32 = 0;
  while (i < lits.len()) {
    if (at + lits[i].len() <= hi && bytes_at(text, at, lits[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// Whether `lit` sits at `at` in `text`. The caller has checked the room.
function bytes_at(text: string, at: i32, lit: string): boolean {
  var k: i32 = 0;
  while (k < lit.len()) {
    if (text[at + k] as i32 != lit[k] as i32) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// The first index in `text[lo..hi)` at which `lit` occurs, or -1.
//
// `__memchr` answers over the whole of `text` — it takes a start and no
// end — so it is the scan for a range that runs to the string's end,
// where a candidate outside the range cannot exist, and the wrong one
// for a range inside a larger buffer: csplit asks about one line of a
// 64 KiB read, and a first byte absent from that line sends the vector
// pass on across every line after it. A bounded range gets the plain
// scan, whose cost is the range itself however rare the byte is.
function find_literal(text: string, lit: string, lo: i32, hi: i32): i32 {
  if (lit.len() == 0) {
    return lo;
  }
  var first: i32 = lit[0] as i32;
  // The last position with room for the whole literal.
  var last: i32 = hi - lit.len();
  var i: i32 = lo;
  if (hi == text.len()) {
    while (true) {
      var j: i32 = __memchr(text, first, i);
      if (j < 0 || j > last) {
        return 0 - 1;
      }
      if (bytes_at(text, j, lit)) {
        return j;
      }
      i = j + 1;
    }
  }
  while (i <= last) {
    if (text[i] as i32 == first && bytes_at(text, i, lit)) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// ---- matching --------------------------------------------------------------
// Two engines run these programs.
//
// Without a backreference the pattern is a regular language, and a
// Thompson simulation runs it in ONE left-to-right pass: every thread
// advances together, a program counter is entered at most once per
// position — which is also what stops an empty loop from going round
// for ever — and the last position at which a thread reaches `Match` is
// the longest match. The captures reported are the ones carried by the
// highest-priority thread to reach each program counter, which is the
// greedy order the compiler laid the branches out in.
//
// A backreference is not regular: whether it matches depends on what an
// earlier group captured, so a thread cannot be merged with another at
// the same program counter. Those patterns take the second engine, a
// backtracking search asked for one end position at a time, longest
// first. `M` is its state.
// Every engine sees the string as `text[lo, hi)` and starts its match at
// a position inside that window. `hi` bounds it because glibc's
// `re_search` is handed a length and `$` and `\'` hold at that end
// whatever follows it in the buffer; `lo` bounds it because a caller
// holding one line inside a larger buffer asks about the line in place
// rather than cutting it out, and `^` and `` \` `` have to mean the
// line's start rather than the buffer's. Both are the whole string for
// the callers that hand over a whole string.
// `zw_caps` holds the captures of the first path that reached the end
// through a trailing zero-width assertion, kept only until a path that
// did not is found (see step).
struct M { text: string, lo: i32, hi: i32, re: Bre, target: i32, caps: i32[], marks: i32[], have_zw: boolean, zw_caps: i32[] }

function class_has_byte(re: Bre, idx: i32, b: i32): boolean {
  return re.classes[idx * 256 + b] as i32 != 0;
}

function is_word_at(text: string, k: i32, lo: i32, hi: i32): boolean {
  if (k < lo || k >= hi) {
    return false;
  }
  var b: i32 = text[k] as i32;
  return is_alpha(b) || is_digit(b) || b == 95;
}

// `^`: the start of the window, or just after a newline when the buffer
// anchors there.
function bol_holds(re: Bre, text: string, pos: i32, lo: i32): boolean {
  if (pos == lo) {
    return true;
  }
  return re.newline_anchor && text[pos - 1] as i32 == 10;
}

// `$`: the end, or just before a newline when the buffer anchors there.
function eol_holds(re: Bre, text: string, pos: i32, hi: i32): boolean {
  if (pos >= hi) {
    return true;
  }
  return re.newline_anchor && text[pos] as i32 == 10;
}

function assert_holds(text: string, which: i32, pos: i32, lo: i32, hi: i32): boolean {
  var before: boolean = is_word_at(text, pos - 1, lo, hi);
  var after: boolean = is_word_at(text, pos, lo, hi);
  if (which == assert_wordb()) {
    return before != after;
  }
  if (which == assert_not_wordb()) {
    return before == after;
  }
  if (which == assert_word_start()) {
    return !before && after;
  }
  if (which == assert_word_end()) {
    return before && !after;
  }
  if (which == assert_buf_start()) {
    return pos == lo;
  }
  return pos == hi;
}

// Whether one byte satisfies a consuming instruction.
function byte_matches(re: Bre, in: Inst, b: i32): boolean {
  if (in.op == op_char()) {
    return in.a == b;
  }
  return class_has_byte(re, in.a, b);
}

// Whether some path from (pc, pos) reaches the end at exactly `target`.
// Between equally long matches glibc prefers the one whose last step to
// the end crossed no zero-width assertion: an assertion's successors are
// duplicated nodes carrying its constraint, and the plain end node sorts
// before every duplicate when the halt node is chosen. `zw` is whether
// this path has crossed one since it last consumed a byte; a match
// reached with it set is held as a fallback while the search goes on.
function step(m0: M, pc0: i32, pos0: i32, zw0: boolean): (boolean, M) {
  var m: M = m0;
  var pc: i32 = pc0;
  var pos: i32 = pos0;
  var zw: boolean = zw0;
  while (true) {
    var in: Inst = m.re.insts[pc];
    if (in.op == op_char()) {
      if (pos >= m.hi || m.text[pos] as i32 != in.a) {
        return (false, m);
      }
      pc = pc + 1;
      pos = pos + 1;
      zw = false;
      continue;
    }
    if (in.op == op_class()) {
      if (pos >= m.hi || !class_has_byte(m.re, in.a, m.text[pos] as i32)) {
        return (false, m);
      }
      pc = pc + 1;
      pos = pos + 1;
      zw = false;
      continue;
    }
    if (in.op == op_jmp()) {
      pc = in.a;
      continue;
    }
    if (in.op == op_match()) {
      if (pos != m.target) {
        return (false, m);
      }
      if (!zw) {
        return (true, m);
      }
      if (m.have_zw) {
        return (false, m);
      }
      return (false, M { ...m, have_zw: true, zw_caps: m.caps });
    }
    if (in.op == op_bol()) {
      if (!bol_holds(m.re, m.text, pos, m.lo)) {
        return (false, m);
      }
      pc = pc + 1;
      zw = true;
      continue;
    }
    if (in.op == op_eol()) {
      if (!eol_holds(m.re, m.text, pos, m.hi)) {
        return (false, m);
      }
      pc = pc + 1;
      zw = true;
      continue;
    }
    if (in.op == op_assert()) {
      if (!assert_holds(m.text, in.a, pos, m.lo, m.hi)) {
        return (false, m);
      }
      pc = pc + 1;
      zw = true;
      continue;
    }
    if (in.op == op_progress()) {
      if (m.marks[in.a] == pos) {
        return (false, m);
      }
      pc = pc + 1;
      continue;
    }
    if (in.op == op_backref()) {
      var s: i32 = m.caps[(in.a - 1) * 2];
      var e: i32 = m.caps[(in.a - 1) * 2 + 1];
      if (s < 0 || e < 0) {
        return (false, m);
      }
      var n: i32 = e - s;
      if (pos + n > m.hi || slice_unchecked(m.text, pos, pos + n) != slice_unchecked(m.text, s, e)) {
        return (false, m);
      }
      pc = pc + 1;
      pos = pos + n;
      if (n > 0) {
        zw = false;
      }
      continue;
    }
    return branch(m, pc, pos, in, zw);
  }
  return (false, m);
}

// The instructions that have to try more than one continuation, and so
// have to be able to put back what they changed.
function branch(m0: M, pc: i32, pos: i32, in: Inst, zw: boolean): (boolean, M) {
  if (in.op == op_split()) {
    var r: (boolean, M) = step(m0, in.a, pos, zw);
    if (r.0) {
      return r;
    }
    return step(r.1, in.b, pos, zw);
  }
  if (in.op == op_save()) {
    var old: i32 = m0.caps[in.a];
    var r2: (boolean, M) = step(M { ...m0, caps: m0.caps.with(in.a, pos) }, pc + 1, pos, zw);
    if (r2.0) {
      return r2;
    }
    return (false, M { ...r2.1, caps: r2.1.caps.with(in.a, old) });
  }
  if (in.op == op_mark()) {
    var oldm: i32 = m0.marks[in.a];
    var r3: (boolean, M) = step(M { ...m0, marks: m0.marks.with(in.a, pos) }, pc + 1, pos, zw);
    if (r3.0) {
      return r3;
    }
    return (false, M { ...r3.1, marks: r3.1.marks.with(in.a, oldm) });
  }
  return (false, m0);
}

function fresh_caps(n: i32): i32[] {
  var c: i32[] = [];
  var k: i32 = 0;
  while (k < n) {
    c = c.append(0 - 1);
    k = k + 1;
  }
  return c;
}

// `(re).exec(text)` — the longest match starting at the beginning of
// `text`, with every group's span.
pub function (re: Bre) exec(text: string): BreMatch {
  return exec_at(re, text, 0, 0, text.len());
}

// `(re).match_at(text, start, hi)` — the end of the longest match
// starting at `start` in `text[0, hi)`, or -1.
function (re: Bre) match_at(text: string, start: i32, hi: i32): i32 {
  var m: BreMatch = exec_at(re, text, start, 0, hi);
  if (!m.matched) {
    return 0 - 1;
  }
  return m.end;
}

// `(re).search_back(text, hi)` — glibc's `re_search` over `text[0, hi)`
// with a negative range: the match starting nearest the end, tried from
// `hi - 1` down to 0, as (start, end), or (-1, -1). The position `hi`
// itself is never a start, which is what keeps tac's backward scan
// from finding the same empty match twice.
pub function (re: Bre) search_back(text: string, hi: i32): (i32, i32) {
  var start: i32 = hi - 1;
  while (start >= 0) {
    if (can_start_at(re, text, start, hi)) {
      var end: i32 = re.match_at(text, start, hi);
      if (end >= 0) {
        return (start, end);
      }
    }
    start = start - 1;
  }
  return (0 - 1, 0 - 1);
}

// The cheapest necessary condition for a match BEGINNING at `pos`: the
// whole literal prefix where the program has one, one of the branch
// literals where it has those, and glibc's fastmap otherwise. Either
// literal test subsumes the fastmap — the run's first bytes ARE the
// fastmap for such a program — so they replace it rather than run after
// it.
function can_start_at(re: Bre, text: string, pos: i32, hi: i32): boolean {
  var n: i32 = re.pre.len();
  if (n > 0) {
    return pos + n <= hi && bytes_at(text, pos, re.pre);
  }
  if (re.alts.len() > 0) {
    return any_bytes_at(text, pos, re.alts, hi);
  }
  if (re.empty_ok) {
    return true;
  }
  return pos < hi && re.first[text[pos] as i32] as i32 != 0;
}

// `(re).search(text)` — glibc's `re_search` reduced to the question a
// line-selecting utility asks of it: does the pattern match ANYWHERE in
// `text`? nl(1) and csplit(1) are the callers.
//
// The scan hands the engines the whole of `text` as the range they see,
// moving only the start position inside it rather than handing them a
// suffix, so `^` still means the start of the line and `$` its end
// however far in the scan has reached — `nl -bp'^a'` numbers a line
// beginning with `a`, not every line containing one.
pub function (re: Bre) search(text: string): boolean {
  return re.search_range(text, 0, text.len());
}

// `(re).search_range(text, lo, hi)` — `search` over the bytes
// `text[lo..hi)`, with `^` and `$` meaning those ends. A caller holding
// one line inside a larger buffer asks it that way rather than cutting
// the line out: csplit runs this once per line of its input, and a slice
// materialised per line is the copy that costs more than the search.
//
// Four filters stand between the call and the simulation, strongest
// first, each reached only where the one above it does not apply:
//
//   1. `literal` — the program is the prefix run and nothing else, so
//      the byte scan IS the answer and no engine runs.
//   2. `pre` — the program continues past the run, so the run is only a
//      necessary condition. One scan for it either rejects the whole
//      range or moves the engine's first start to where it was found,
//      since no match can begin before that.
//   3. `alts` — the branches diverge before the first byte, so it takes
//      one scan per branch to reject the range, and the earliest hit of
//      any of them is where the engine starts.
//   4. the fastmap, inside the engine, which skips the positions left
//      that a match cannot start at (`can_start_at`, which is the
//      literals again where there are any).
//
// `^` and `$` pin a match to `lo` and `hi` only while `newline_anchor`
// is off. With it on they hold at every newline too, so an anchored
// prefix no longer fixes the position it has to sit at and the first two
// filters give way to the scan that assumes none.
pub function (re: Bre) search_range(text: string, lo: i32, hi: i32): boolean {
  var n: i32 = re.pre.len();
  var pinned: boolean = !re.newline_anchor;
  if (re.literal && (pinned || !re.pre_bol && !re.pre_eol)) {
    if (hi - lo < n) {
      return false;
    }
    if (re.pre_bol && re.pre_eol) {
      return hi - lo == n && bytes_at(text, lo, re.pre);
    }
    if (re.pre_bol) {
      return bytes_at(text, lo, re.pre);
    }
    if (re.pre_eol) {
      return bytes_at(text, hi - n, re.pre);
    }
    return find_literal(text, re.pre, lo, hi) >= 0;
  }
  var from: i32 = lo;
  if (n > 0) {
    if (hi - lo < n) {
      return false;
    }
    if (re.pre_bol && pinned) {
      if (!bytes_at(text, lo, re.pre)) {
        return false;
      }
    } else {
      var at: i32 = find_literal(text, re.pre, lo, hi);
      if (at < 0) {
        return false;
      }
      from = at;
    }
  } else if (re.alts.len() > 0) {
    // No anchor case to split out: a branch literal is required at the
    // match's own start wherever that falls, so `^` and `$` only narrow
    // further what the simulation is then asked.
    var first_at: i32 = find_any_literal(text, re.alts, lo, hi);
    if (first_at < 0) {
      return false;
    }
    from = first_at;
  }
  if (re.backref) {
    var i: i32 = from;
    while (i <= hi) {
      if (can_start_at(re, text, i, hi) && exec_backtrack(re, text, i, lo, hi).matched) {
        return true;
      }
      i = i + 1;
    }
    return false;
  }
  // One pass: a fresh thread is seeded at every position rather than the
  // whole simulation being re-run from each of them, which is the
  // difference between O(n·m) and O(n²·m) over a line.
  return exec_threads_from(re, text, from, lo, hi, true).matched;
}

function exec_at(re: Bre, text: string, start: i32, lo: i32, hi: i32): BreMatch {
  if (re.backref) {
    return exec_backtrack(re, text, start, lo, hi);
  }
  return exec_threads_from(re, text, start, lo, hi, false);
}

// The backtracking engine: ask for one end position at a time, longest
// first, and take the first that answers yes.
function exec_backtrack(re: Bre, text: string, start: i32, lo: i32, hi: i32): BreMatch {
  var no: i32[] = [];
  var end: i32 = hi;
  while (end >= start) {
    var m: M = M { text: text, lo: lo, hi: hi, re: re, target: end, caps: fresh_caps(re.ngroups * 2), marks: fresh_caps(re.nmarks), have_zw: false, zw_caps: no };
    var r: (boolean, M) = step(m, 0, start, false);
    if (r.0) {
      return caps_to_match(r.1.caps, re, start, end);
    }
    if (r.1.have_zw) {
      return caps_to_match(r.1.zw_caps, re, start, end);
    }
    end = end - 1;
  }
  return BreMatch { matched: false, end: 0, starts: no, ends: no };
}

// `Threads` — one position's thread list: the program counters waiting
// on a byte, each with its captures, plus the generation stamp that
// keeps a program counter from being entered twice at one position.
// `match_at` is the index of this position's match thread, or -1, and
// `match_zw` whether it reached the end through a trailing zero-width
// assertion (see step): such a thread yields to a later one that did not.
struct Threads { pcs: i32[], caps: i32[][], seen: i32[], match_at: i32, match_zw: boolean }

// The epsilon closure from `pc`: every program counter reachable
// without consuming a byte, in priority order, stopping at each one
// that does consume.
// Every branch hands the stamped list straight to the next call rather
// than naming it: a local would be a second reference to the stamp
// array, and each stamp would then copy it (#8498) — one copy per
// instruction of the closure, which a pattern like `\(a*\)\{3200\}`
// walks in full at every position.
function add_thread(re: Bre, t0: Threads, gen: i32, pc: i32, caps: i32[], pos: i32, text: string, lo: i32, hi: i32, zw: boolean): Threads {
  if (t0.seen[pc] == gen) {
    if (!zw && t0.match_zw && re.insts[pc].op == op_match()) {
      return Threads { ...t0, caps: t0.caps.with(t0.match_at, caps), match_zw: false };
    }
    return t0;
  }
  var in: Inst = re.insts[pc];
  if (in.op == op_jmp()) {
    return add_thread(re, stamp(t0, pc, gen), gen, in.a, caps, pos, text, lo, hi, zw);
  }
  if (in.op == op_split()) {
    return add_thread(re, add_thread(re, stamp(t0, pc, gen), gen, in.a, caps, pos, text, lo, hi, zw), gen, in.b, caps, pos, text, lo, hi, zw);
  }
  if (in.op == op_save()) {
    return add_thread(re, stamp(t0, pc, gen), gen, pc + 1, caps.with(in.a, pos), pos, text, lo, hi, zw);
  }
  // `Mark` and `Progress` guard the backtracker's empty star loops; the
  // generation stamp already does that job here.
  if (in.op == op_mark() || in.op == op_progress()) {
    return add_thread(re, stamp(t0, pc, gen), gen, pc + 1, caps, pos, text, lo, hi, zw);
  }
  if (in.op == op_bol() || in.op == op_eol() || in.op == op_assert()) {
    if (!zero_width_holds(re, text, in, pos, lo, hi)) {
      return stamp(t0, pc, gen);
    }
    return add_thread(re, stamp(t0, pc, gen), gen, pc + 1, caps, pos, text, lo, hi, true);
  }
  if (in.op == op_match()) {
    return append_match_thread(stamp(t0, pc, gen), pc, caps, zw);
  }
  return append_thread(stamp(t0, pc, gen), pc, caps);
}

function stamp(t: Threads, pc: i32, gen: i32): Threads {
  return Threads { ...t, seen: t.seen.with(pc, gen) };
}

function append_thread(t: Threads, pc: i32, caps: i32[]): Threads {
  return Threads { ...t, pcs: t.pcs.append(pc), caps: t.caps.append(caps) };
}

function append_match_thread(t: Threads, pc: i32, caps: i32[], zw: boolean): Threads {
  var at: i32 = t.pcs.len();
  return Threads { ...t, pcs: t.pcs.append(pc), caps: t.caps.append(caps), match_at: at, match_zw: zw };
}

function zero_width_holds(re: Bre, text: string, in: Inst, pos: i32, lo: i32, hi: i32): boolean {
  if (in.op == op_bol()) {
    return bol_holds(re, text, pos, lo);
  }
  if (in.op == op_eol()) {
    return eol_holds(re, text, pos, hi);
  }
  return assert_holds(text, in.a, pos, lo, hi);
}

// The Thompson simulation: one pass, every thread in step, over the
// bytes `text[lo, hi)`.
//
// `unanchored` seeds the start state at every position, which is
// glibc's re_search; without it the match must begin at `start`, which
// is re_match. `^` and `$` are unaffected either way: they are asked
// about the position in `text[lo, hi)`, not about where the scan began.
// The generation stamp is the position, so it starts at `start` and
// `re.seen0` is below every one of them.
function exec_threads_from(re: Bre, text: string, start: i32, lo: i32, hi: i32, unanchored: boolean): BreMatch {
  var no_pcs: i32[] = [];
  var no_caps: i32[][] = [];
  var t: Threads = Threads { pcs: no_pcs, caps: no_caps, seen: re.seen0, match_at: 0 - 1, match_zw: false };
  // One seed vector for the whole search: it is never written through,
  // since `.with` copies an array a second reference holds, so the
  // thread seeded at each position can share it rather than allocate
  // one per position — which for a pattern with no groups was an empty
  // array per byte.
  var seed: i32[] = fresh_caps(re.ngroups * 2);
  t = add_thread(re, t, start, 0, seed, start, text, lo, hi, false);
  var best: i32 = 0 - 1;
  var best_caps: i32[] = seed;
  var pos: i32 = start;
  while (true) {
    // The list being stepped is held apart from `t`, so `t` keeps sole
    // ownership of the stamp array — its own copy of `re.seen0` from
    // the first stamp — and updates it in place.
    var pcs: i32[] = t.pcs;
    var caps: i32[][] = t.caps;
    var empty_pcs: i32[] = [];
    var empty_caps: i32[][] = [];
    t = Threads { ...t, pcs: empty_pcs, caps: empty_caps, match_at: 0 - 1, match_zw: false };
    var found: boolean = false;
    var k: i32 = 0;
    while (k < pcs.len()) {
      var in: Inst = re.insts[pcs[k]];
      if (in.op == op_match()) {
        if (!found) {
          best = pos;
          best_caps = caps[k];
          found = true;
        }
      } else if (pos < hi && byte_matches(re, in, text[pos] as i32)) {
        t = add_thread(re, t, pos + 1, pcs[k] + 1, caps[k], pos + 1, text, lo, hi, false);
      }
      k = k + 1;
    }
    if (pos >= hi || unanchored && best >= 0) {
      break;
    }
    pos = pos + 1;
    if (unanchored) {
      // This seed shares generation `pos` with the byte-children added
      // above, so a pc the byte-chain already stamped is skipped here. That
      // costs the seed's captures at that pc, never a thread: the chain
      // expanded the same split itself, so the set of pcs waiting on the
      // next byte is identical. `search_range` reads only `.matched`,
      // which is why it is sound to share the stamps rather than pay a
      // second array.
      //
      // The fastmap gate is the last of `search_range`'s filters: a
      // position no match can begin at is never seeded.
      if (can_start_at(re, text, pos, hi)) {
        t = add_thread(re, t, pos, 0, seed, pos, text, lo, hi, false);
      }
    }
    // Out of threads ends an ANCHORED run, whose only start has died.
    // An unanchored one seeds a new start at every position left, so
    // there is nothing to conclude from the ones before it dying.
    if (!unanchored && t.pcs.len() == 0) {
      break;
    }
  }
  if (best < 0) {
    return BreMatch { matched: false, end: 0, starts: no_pcs, ends: no_pcs };
  }
  return caps_to_match(best_caps, re, start, best);
}

function fill(n: i32, v: i32): i32[] {
  var a: i32[] = [];
  var k: i32 = 0;
  while (k < n) {
    a = a.append(v);
    k = k + 1;
  }
  return a;
}

// Group 0 spans `start` to `end`; `caps` holds only the groups the
// pattern wrote. An unanchored run has no start of its own to report,
// so its group 0 begins where the scan did — `search_range`, the only
// caller that runs one, reads nothing but `.matched`.
function caps_to_match(caps: i32[], re: Bre, start: i32, end: i32): BreMatch {
  var starts: i32[] = [start];
  var ends: i32[] = [end];
  var g: i32 = 0;
  while (g < re.ngroups) {
    starts = starts.append(caps[g * 2]);
    ends = ends.append(caps[g * 2 + 1]);
    g = g + 1;
  }
  return BreMatch { matched: true, end: end, starts: starts, ends: ends };
}
