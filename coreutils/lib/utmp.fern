import "std/string";
import "std/array";
import "./tty";

pub function empty_type(): i32 {
  return 0;
}

pub function run_lvl(): i32 {
  return 1;
}

pub function boot_time(): i32 {
  return 2;
}

pub function new_time(): i32 {
  if (darwin()) {
    return 4;
  }
  return 3;
}

pub function old_time(): i32 {
  if (darwin()) {
    return 3;
  }
  return 4;
}

pub function init_process(): i32 {
  return 5;
}

pub function login_process(): i32 {
  return 6;
}

pub function user_process(): i32 {
  return 7;
}

pub function dead_process(): i32 {
  return 8;
}

function signature_type(): i32 {
  return 10;
}

function darwin(): boolean {
  return target_os() == "darwin";
}

function time64_compat32(): boolean {
  return target_arch() == "x86-64";
}

pub function record_bytes(): i32 {
  if (darwin()) {
    return 628;
  }
  if (time64_compat32()) {
    return 384;
  }
  return 400;
}

function sec_at(bs: u8[], off: i32): i64 {
  if (time64_compat32()) {
    return i32_at(bs, off + 340) as i64;
  }
  return i64_at(bs, off + 344);
}

pub struct Entry { kind: i32, pid: i32, line: string, id: string, user: string, host: string, sec: i64, term: i32, exit: i32 }

pub function default_path(): string {
  if (darwin()) {
    return "/var/run/utmpx";
  }
  return "/var/run/utmp";
}

function opened_path(path: string): string {
  if (!darwin() || path.len() > 0 && path.len() < 1024 && path[path.len() - 1] as i32 == 120) {
    return path;
  }
  return default_path();
}

function u16_at(bs: u8[], off: i32): i32 {
  return bs[off] as i32 + bs[off + 1] as i32 * 256;
}

function i16_at(bs: u8[], off: i32): i32 {
  let v: i32 = u16_at(bs, off);
  if (v > 32767) {
    return v - 65536;
  }
  return v;
}

function i32_at(bs: u8[], off: i32): i32 {
  let v: i64 = bs[off] as i64 + bs[off + 1] as i64 * (256 as i64) + bs[off + 2] as i64 * (65536 as i64) + bs[off + 3] as i64 * (16777216 as i64);
  if (v > 2147483647 as i64) {
    v = v - 4294967296 as i64;
  }
  return v as i32;
}

function i64_at(bs: u8[], off: i32): i64 {
  let v: i64 = 0 as i64;
  let i: i32 = 7;
  while (i >= 0) {
    v = v * (256 as i64) + bs[off + i] as i64;
    i = i - 1;
  }
  return v;
}

function field_at(bs: u8[], off: i32, width: i32): string {
  let n: i32 = 0;
  while (n < width && bs[off + n] as i32 != 0) {
    n = n + 1;
  }
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(bs[off + i]);
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

function entry_at(bs: u8[], off: i32): Entry {
  if (darwin()) {
    return Entry { kind: u16_at(bs, off + 296), pid: i32_at(bs, off + 292), line: field_at(bs, off + 260, 32), id: field_at(bs, off + 256, 4), user: field_at(bs, off + 0, 256), host: field_at(bs, off + 308, 256), sec: i32_at(bs, off + 300) as i64, term: 0, exit: 0 };
  }
  return Entry { kind: u16_at(bs, off + 0), pid: i32_at(bs, off + 4), line: field_at(bs, off + 8, 32), id: field_at(bs, off + 40, 4), user: field_at(bs, off + 44, 32), host: field_at(bs, off + 76, 256), sec: sec_at(bs, off), term: i16_at(bs, off + 332), exit: i16_at(bs, off + 334) };
}

pub function read_all(path: string): Entry[] {
  match (read_all_result(path)) {
    Ok(entries) => {
      return entries;
    },
    Err(_) => {
      let none: Entry[] = [];
      return none;
    }
  }
}

pub function read_all_result(path: string): Result[Entry[], IoError] {
  let out: Entry[] = [];
  match (read_file_bytes(opened_path(path))) {
    Ok(bs) => {
      let off: i32 = 0;
      if (darwin()) {
        if (!signed(bs)) {
          return Ok(out);
        }
        off = record_bytes();
      }
      while (off + record_bytes() <= bs.len()) {
        out = out.append(entry_at(bs, off));
        off = off + record_bytes();
      }
      return Ok(out);
    },
    Err(e) => {
      return Err(e);
    }
  }
}

function signed(bs: u8[]): boolean {
  if (bs.len() < record_bytes() || u16_at(bs, 296) != signature_type()) {
    return false;
  }
  let magic: string = "utmpx-1.00";
  let i: i32 = 0;
  while (i < magic.len()) {
    if (bs[i] as i32 != magic[i] as i32) {
      return false;
    }
    i = i + 1;
  }
  return bs[magic.len()] as i32 == 0;
}

pub function (e: Entry) is_login(): boolean {
  return e.kind == user_process() && e.user.len() > 0;
}

pub function (e: Entry) name(): string {
  let n: i32 = e.user.len();
  while (n > 0 && e.user[n - 1] as i32 == 32) {
    n = n - 1;
  }
  if (n == e.user.len()) {
    return e.user;
  }
  return slice_unchecked(e.user, 0, n) + "";
}

pub function read_logins(path: string): Entry[] {
  let all: Entry[] = read_all(path);
  let out: Entry[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    if (all[i].is_login()) {
      out = out.append(all[i]);
    }
    i = i + 1;
  }
  return out;
}

pub function device_path(line: string): string {
  if (line.len() > 0 && line[0] as i32 == 47) {
    return line;
  }
  return "/dev/" + line;
}

pub struct Line { present: boolean, writable: boolean, atime: i64 }

pub function line_info(l: string): Line {
  match (stat(device_path(l))) {
    Ok(st) => {
      return Line { present: true, writable: (st.mode & 16 as u32) != 0 as u32, atime: st.atime };
    },
    Err(_) => {
      return Line { present: false, writable: false, atime: 0 };
    }
  }
}

pub function terminal_line(): Option[string] {
  match (tty.name_of_stdin()) {
    Some(path) => {
      if (path.starts_with("/dev/")) {
        return Some(slice_unchecked(path, 5, path.len()) + "");
      }
      return Some(path);
    },
    None => {
      return None;
    }
  }
}

pub function user_on_line(path: string, line: string): Option[string] {
  let entries: Entry[] = read_all(path);
  let i: i32 = 0;
  while (i < entries.len()) {
    if (entries[i].kind == user_process() && entries[i].line == line && entries[i].user.len() > 0) {
      return Some(entries[i].user);
    }
    i = i + 1;
  }
  return None;
}
