import "std/string";
import "std/array";

function dirs(): string[] {
  return ["/dev/pts", "/dev"];
}

function is_char_device(st: FileStat): boolean {
  return (st.mode & 61440 as u32) == 8192 as u32;
}

function proc_name(want: i64): Option[string] {
  match (read_link("/proc/self/fd/0")) {
    Ok(target) => {
      if (target.len() == 0 || target[0] as i32 != 47) {
        return None;
      }
      match (stat(target)) {
        Ok(st) => {
          if (is_char_device(st) && st.rdev == want) {
            return Some(target);
          }
        },
        Err(_) => {}
      }
    },
    Err(_) => {}
  }
  return None;
}

function dev_stat(path: string): Result[FileStat, IoError] {
  if (target_os() == "darwin") {
    return lstat(path);
  }
  return stat(path);
}

function walk_dev(want: i64): Option[string] {
  let ds: string[] = dirs();
  let d: i32 = 0;
  while (d < ds.len()) {
    match (read_dir(ds[d])) {
      Ok(names) => {
        let i: i32 = 0;
        while (i < names.len()) {
          let path: string = ds[d] + "/" + names[i];
          match (dev_stat(path)) {
            Ok(st) => {
              if (is_char_device(st) && st.rdev == want) {
                return Some(path);
              }
            },
            Err(_) => {}
          }
          i = i + 1;
        }
      },
      Err(_) => {}
    }
    d = d + 1;
  }
  return None;
}

pub function name_of_stdin(): Option[string] {
  if (!isatty(0)) {
    return None;
  }
  let want: i64 = 0;
  match (stdin().stat()) {
    Ok(st) => {
      if (!is_char_device(st)) {
        return None;
      }
      want = st.rdev;
    },
    Err(_) => {
      return None;
    }
  }
  if (want == 0 as i64) {
    return None;
  }
  match (proc_name(want)) {
    Some(path) => {
      return Some(path);
    },
    None => {}
  }
  return walk_dev(want);
}
