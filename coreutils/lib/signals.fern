import "std/string";
import "std/array";
import "std/i32";
import "std/signal";

pub function names(): string[] {
  if (target_os() == "darwin") {
    return ["HUP", "INT", "QUIT", "ILL", "TRAP", "ABRT", "EMT", "FPE", "KILL", "BUS", "SEGV", "SYS", "PIPE", "ALRM", "TERM", "URG", "STOP", "TSTP", "CONT", "CHLD", "TTIN", "TTOU", "IO", "XCPU", "XFSZ", "VTALRM", "PROF", "WINCH", "INFO", "USR1", "USR2"];
  }
  return ["HUP", "INT", "QUIT", "ILL", "TRAP", "ABRT", "BUS", "FPE", "KILL", "USR1", "SEGV", "USR2", "PIPE", "ALRM", "TERM", "STKFLT", "CHLD", "CONT", "STOP", "TSTP", "TTIN", "TTOU", "URG", "XCPU", "XFSZ", "VTALRM", "PROF", "WINCH", "POLL", "PWR", "SYS"];
}

pub function rt_min(): i32 {
  if (target_os() == "darwin") {
    return 0;
  }
  return 34;
}

pub function rt_max(): i32 {
  if (target_os() == "darwin") {
    return 0;
  }
  return 64;
}

pub function highest(): i32 {
  if (rt_max() != 0) {
    return rt_max();
  }
  return names().len();
}

pub function name(n: i32): string {
  if (n == 0) {
    return "EXIT";
  }
  let ns: string[] = names();
  if (n >= 1 && n <= ns.len()) {
    return ns[n - 1];
  }
  let lo: i32 = rt_min();
  let hi: i32 = rt_max();
  if (lo == 0 || n < lo || n > hi) {
    return "";
  }
  if (n == lo) {
    return "RTMIN";
  }
  if (n == hi) {
    return "RTMAX";
  }
  if (n - lo <= hi - n) {
    return "RTMIN+" + (n - lo).to_string();
  }
  return "RTMAX-" + (hi - n).to_string();
}

function descriptions(): string[] {
  if (target_os() == "darwin") {
    return ["Hangup", "Interrupt", "Quit", "Illegal instruction", "Trace/BPT trap", "Abort trap", "EMT trap", "Floating point exception", "Killed", "Bus error", "Segmentation fault", "Bad system call", "Broken pipe", "Alarm clock", "Terminated", "Urgent I/O condition", "Suspended (signal)", "Suspended", "Continued", "Child exited", "Stopped (tty input)", "Stopped (tty output)", "I/O possible", "Cputime limit exceeded", "Filesize limit exceeded", "Virtual timer expired", "Profiling timer expired", "Window size changes", "Information request", "User defined signal 1", "User defined signal 2"];
  }
  return ["Hangup", "Interrupt", "Quit", "Illegal instruction", "Trace/breakpoint trap", "Aborted", "Bus error", "Floating point exception", "Killed", "User defined signal 1", "Segmentation fault", "User defined signal 2", "Broken pipe", "Alarm clock", "Terminated", "Stack fault", "Child exited", "Continued", "Stopped (signal)", "Stopped", "Stopped (tty input)", "Stopped (tty output)", "Urgent I/O condition", "CPU time limit exceeded", "File size limit exceeded", "Virtual timer expired", "Profiling timer expired", "Window changed", "I/O possible", "Power failure", "Bad system call"];
}

pub function description(n: i32): string {
  let dar: boolean = target_os() == "darwin";
  if (n == 0) {
    if (dar) {
      return "Unknown signal: 0";
    }
    return "Unknown signal 0";
  }
  let ds: string[] = descriptions();
  if (n >= 1 && n <= ds.len()) {
    if (dar) {
      return ds[n - 1] + ": " + n.to_string();
    }
    return ds[n - 1];
  }
  let lo: i32 = rt_min();
  if (lo == 0 || n < lo || n > rt_max()) {
    return "";
  }
  return "Real-time signal " + (n - lo).to_string();
}

function alternates(): string[] {
  if (target_os() == "darwin") {
    return ["IOT"];
  }
  return ["IOT", "IO", "CLD"];
}

function alternate_values(): i32[] {
  if (target_os() == "darwin") {
    return [6];
  }
  return [6, 29, 17];
}

pub function number(s: string): i32 {
  if (s.len() == 0) {
    return 0;
  }
  let bare: string = upper(s);
  if (bare.starts_with("SIG")) {
    bare = slice_unchecked(bare, 3, bare.len()) + "";
  }
  return table_number(bare);
}

function table_number(bare: string): i32 {
  let ns: string[] = names();
  let i: i32 = 0;
  while (i < ns.len()) {
    if (ns[i] == bare) {
      return i + 1;
    }
    i = i + 1;
  }
  let alt: string[] = alternates();
  let av: i32[] = alternate_values();
  let j: i32 = 0;
  while (j < alt.len()) {
    if (alt[j] == bare) {
      return av[j];
    }
    j = j + 1;
  }
  return realtime_number(bare);
}

function parse_u31(s: string): i32 {
  if (s.len() == 0) {
    return 0 - 1;
  }
  let v: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c < 48 || c > 57) {
      return 0 - 1;
    }
    let d: i32 = c - 48;
    if (v > 214748364) {
      return 0 - 1;
    }
    if (v == 214748364 && d > 7) {
      return 0 - 1;
    }
    v = v * 10 + d;
    i = i + 1;
  }
  return v;
}

function str2signum(bare: string): i32 {
  if (bare.len() == 0) {
    return 0 - 1;
  }
  let c0: i32 = bare[0] as i32;
  if (c0 >= 48 && c0 <= 57) {
    let v: i32 = parse_u31(bare);
    if (v < 0 || v > highest()) {
      return 0 - 1;
    }
    return v;
  }
  if (bare == "EXIT") {
    return 0;
  }
  let t: i32 = table_number(bare);
  if (t != 0) {
    return t;
  }
  return 0 - 1;
}

pub function operand2sig(operand: string): i32 {
  if (operand.len() == 0) {
    return 0 - 1;
  }
  let c0: i32 = operand[0] as i32;
  if (c0 >= 48 && c0 <= 57) {
    let v: i32 = parse_u31(operand);
    if (v < 0) {
      return 0 - 1;
    }
    let n: i32 = v % 128;
    if (v >= 255) {
      n = v % 256;
    }
    if (n > highest()) {
      return 0 - 1;
    }
    return n;
  }
  let up: string = upper(operand);
  let found: i32 = str2signum(up);
  if (found < 0 && up.starts_with("SIG")) {
    found = str2signum(slice_unchecked(up, 3, up.len()) + "");
  }
  if (found < 0 || name(found) == "") {
    return 0 - 1;
  }
  return found;
}

function realtime_number(bare: string): i32 {
  let lo: i32 = rt_min();
  let hi: i32 = rt_max();
  if (lo == 0) {
    return 0;
  }
  if (bare == "RTMIN") {
    return lo;
  }
  if (bare == "RTMAX") {
    return hi;
  }
  let base: i32 = 0;
  if (bare.starts_with("RTMIN")) {
    base = lo;
  } else if (bare.starts_with("RTMAX")) {
    base = hi;
  } else {
    return 0;
  }
  let rest: string = slice_unchecked(bare, 5, bare.len()) + "";
  if (rest.len() < 2) {
    return 0;
  }
  let sign: string = slice_unchecked(rest, 0, 1) + "";
  let digits: string = slice_unchecked(rest, 1, rest.len()) + "";
  let off: i32 = parse_u31(digits);
  if (off < 0) {
    return 0;
  }
  let n: i32 = 0;
  if (sign == "+") {
    n = base + off;
  } else if (sign == "-") {
    n = base - off;
  } else {
    return 0;
  }
  if (n < lo || n > hi) {
    return 0;
  }
  return n;
}

pub function die_of(sig: i32): void {
  signal.default(sig);
  signal.unblock(signal.bit(sig));
  signal.raise(sig);
  exit(128 + sig);
}

function upper(s: string): string {
  return s.to_ascii_upper();
}
