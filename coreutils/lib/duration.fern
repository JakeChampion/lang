import "./ld";

function suffix_seconds(b: i32): i64 {
  if (b == 115) {
    return 1 as i64;
  }
  if (b == 109) {
    return 60 as i64;
  }
  if (b == 104) {
    return 3600 as i64;
  }
  if (b == 100) {
    return 86400 as i64;
  }
  return 0 as i64;
}

pub function parse(f: ld.Format, s: string): Option[ld.LD] {
  let r: ld.Parse = f.strtold(s);
  if (r.end == 0) {
    return None;
  }
  let scale: i64 = 1 as i64;
  if (r.end == s.len() - 1) {
    scale = suffix_seconds(s[r.end] as i32);
    if (scale == 0 as i64) {
      return None;
    }
  } else if (r.end != s.len()) {
    return None;
  }
  if (r.v.is_nan()) {
    return None;
  }
  if (r.v.neg && !r.v.is_zero()) {
    return None;
  }
  if (scale == 1 as i64) {
    return Some(r.v);
  }
  return Some(f.mul(r.v, f.from_i64(scale)));
}

pub function nanos_ceil(f: ld.Format, seconds: ld.LD): Option[i64] {
  if (!seconds.is_finite()) {
    return None;
  }
  let ns: ld.LD = f.mul(seconds, f.from_i64(1000000000 as i64));
  return f.round_to_int(ns, ld.round_up()).as_i64();
}

pub function sleep_seconds(f: ld.Format, seconds: ld.LD): void {
  match (nanos_ceil(f, seconds)) {
    Some(ns) => {
      if (ns > 0 as i64) {
        sleep_ns(ns);
      }
    },
    None => {
      let hour_ns: i64 = 3600 as i64 * (1000000000 as i64);
      while (true) {
        sleep_ns(hour_ns);
      }
    }
  }
}
