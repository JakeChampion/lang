// duration.fern — the `NUMBER[SUFFIX]` time interval `sleep` and `timeout`
// both take, and the nanosecond count a pause needs.
//
// One grammar, measured against both utilities and identical in each: a
// NUMBER is anything strtold reads — decimal, hex float (`0x1`), exponent
// notation (`1e2`), a bare point on either side (`.5`, `5.`), `inf` — and
// SUFFIX is one of `s` `m` `h` `d`, LOWERCASE only, so `1M` is not an
// interval at all. Leading blanks are allowed because strtold skips them and
// trailing ones are not because nothing consumes them: ` 1` is one second
// and `1 ` is a refusal. A negative value is not an interval, though `-0`
// is, and neither is a NaN.
//
// The two callers word the refusal the same way — `invalid time interval
// 'X'` — which is why the grammar lives here rather than in either of them:
// a divergence between them would be a bug in whichever moved.
//
// GRANULARITY. The interval is carried as a long double and converted to a
// nanosecond count only at the end, rounded UP so a pause is never shorter
// than asked — which is all nanosleep(2) itself guarantees.
import "./ld";

// The seconds one suffix byte stands for; 0 when it is not a suffix.
function suffix_seconds(b: i32): i64 {
  if (b == 115) {
    return 1 as i64;
  }
  if (b == 109) {
    return 60 as i64;
  }
  if (b == 104) {
    return 3600 as i64;
  }
  if (b == 100) {
    return 86400 as i64;
  }
  return 0 as i64;
}

// `parse(f, s)` — the seconds `s` asks for, or None when it is not an
// interval: unparsable, trailing bytes that are not a single suffix, a NaN,
// or a negative value.
pub function parse(f: ld.Format, s: string): Option[ld.LD] {
  var r: ld.Parse = f.strtold(s);
  if (r.end == 0) {
    return None;
  }
  var scale: i64 = 1 as i64;
  if (r.end == s.len() - 1) {
    scale = suffix_seconds(s[r.end] as i32);
    if (scale == 0 as i64) {
      return None;
    }
  } else if (r.end != s.len()) {
    return None;
  }
  if (r.v.is_nan()) {
    return None;
  }
  if (r.v.neg && !r.v.is_zero()) {
    return None;
  }
  if (scale == 1 as i64) {
    return Some(r.v);
  }
  return Some(f.mul(r.v, f.from_i64(scale)));
}

// `nanos_ceil(f, seconds)` — nanoseconds covering `seconds`, rounded up so a
// pause is never short. None when there is no count to give: an infinity, or
// a span past what a count of nanoseconds holds (about 292 years).
pub function nanos_ceil(f: ld.Format, seconds: ld.LD): Option[i64] {
  if (!seconds.is_finite()) {
    return None;
  }
  var ns: ld.LD = f.mul(seconds, f.from_i64(1000000000 as i64));
  return f.round_to_int(ns, ld.round_up()).as_i64();
}

// `sleep_seconds(f, seconds)` — pause for `seconds`.
//
// An interval with no nanosecond count sleeps in hour-long steps until the
// program is killed, which is what GNU's own nanosleep loop does with one.
pub function sleep_seconds(f: ld.Format, seconds: ld.LD): void {
  match (nanos_ceil(f, seconds)) {
    Some(ns) => {
      if (ns > 0 as i64) {
        sleep_ns(ns);
      }
    },
    None => {
      var hour_ns: i64 = 3600 as i64 * (1000000000 as i64);
      while (true) {
        sleep_ns(hour_ns);
      }
    }
  }
}
