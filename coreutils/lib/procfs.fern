// coreutils/lib/procfs.fern — reading a kernel pseudo-file.
//
// A file under /proc or /sys has its contents generated by the read, so
// `st_size` is not its length: /proc reports 0 and /sys reports a page.
// The only way to get the content is to read until EOF, which is what
// libselinux and gnulib do for these paths — and what `read_file` does
// NOT do, since it sizes its buffer from fstat (#9065).
import "std/string";
import "std/array";

// The block each read asks for. Every file the utilities here read is
// well under it, so this is one read and one EOF read in practice.
function chunk(): i32 {
  return 4096;
}

// `read(path)` — the whole file, however long it turns out to be.
pub function read(path: string): Result[string, IoError] {
  match (open_reader(path)) {
    Ok(r) => {
      return drain(r);
    },
    Err(e) => {
      return Err(e);
    }
  }
}

function drain(r: Reader): Result[string, IoError] {
  var out: string = "";
  while (true) {
    match (r.read_chunk(chunk())) {
      Ok(piece) => {
        if (piece.len() == 0) {
          r.close();
          return Ok(out);
        }
        out = out + piece;
      },
      Err(e) => {
        r.close();
        return Err(e);
      }
    }
  }
  return Ok(out);
}
