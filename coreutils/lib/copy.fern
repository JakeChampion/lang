import "std/string";
import "std/array";
import "std/io_buffered";
import "std/errno";
import "core/cmp";
import "./gnu";
import "./mode";
import "./listing";

pub struct Attrs { mode: boolean, ownership: boolean, timestamps: boolean, links: boolean, context: boolean, xattr: boolean, mode_declined: boolean }

pub function attrs_none(): Attrs {
  return Attrs { mode: false, ownership: false, timestamps: false, links: false, context: false, xattr: false, mode_declined: false };
}

pub function attrs_p(): Attrs {
  return Attrs { mode: true, ownership: true, timestamps: true, links: false, context: false, xattr: false, mode_declined: false };
}

pub function attrs_all(): Attrs {
  return Attrs { mode: true, ownership: true, timestamps: true, links: true, context: true, xattr: true, mode_declined: false };
}

pub function attr_names(): string[] {
  return ["mode", "timestamps", "ownership", "links", "context", "xattr", "all"];
}

pub function attrs_set(a: Attrs, which: i32, on: boolean): Attrs {
  if (which == 0) {
    return Attrs { ...a, mode: on, mode_declined: !on };
  } else if (which == 1) {
    return Attrs { ...a, timestamps: on };
  } else if (which == 2) {
    return Attrs { ...a, ownership: on };
  } else if (which == 3) {
    return Attrs { ...a, links: on };
  } else if (which == 4) {
    return Attrs { ...a, context: on };
  } else if (which == 5) {
    return Attrs { ...a, xattr: on };
  }
  return Attrs { mode: on, timestamps: on, ownership: on, links: on, context: on, xattr: on, mode_declined: !on };
}

pub function deref_never(): i32 {
  return 0;
}

pub function deref_cmdline(): i32 {
  return 1;
}

pub function deref_always(): i32 {
  return 2;
}

pub function ask_yes(): i32 {
  return 0;
}

pub function ask_prompt(): i32 {
  return 1;
}

pub function ask_never(): i32 {
  return 2;
}

pub function update_all(): i32 {
  return 0;
}

pub function update_none(): i32 {
  return 1;
}

pub function update_older(): i32 {
  return 2;
}

pub function update_none_fail(): i32 {
  return 3;
}

pub function update_names(): string[] {
  return ["all", "none", "none-fail", "older"];
}

pub function update_values(): i32[] {
  return [update_all(), update_none(), update_none_fail(), update_older()];
}

pub function update_skips(u: i32): boolean {
  return u == update_none() || u == update_none_fail();
}

pub function sparse_never(): i32 {
  return 0;
}

pub function sparse_auto(): i32 {
  return 1;
}

pub function sparse_always(): i32 {
  return 2;
}

pub function sparse_names(): string[] {
  return ["never", "auto", "always"];
}

pub function sparse_values(): i32[] {
  return [sparse_never(), sparse_auto(), sparse_always()];
}

pub function reflink_never(): i32 {
  return 0;
}

pub function reflink_auto(): i32 {
  return 1;
}

pub function reflink_always(): i32 {
  return 2;
}

pub function reflink_names(): string[] {
  return ["auto", "always", "never"];
}

pub function reflink_values(): i32[] {
  return [reflink_auto(), reflink_always(), reflink_never()];
}

pub struct Cfg { attrs: Attrs, recursive: boolean, deref: i32, hard_link: boolean, sym_link: boolean, force: boolean, ask: i32, update: i32, backups: boolean, control: i32, suffix: string, verbose: boolean, debug: boolean, one_fs: boolean, attributes_only: boolean, copy_contents: boolean, remove_destination: boolean, sparse: i32, reflink: i32, verbose_style: i32, announced_backup: string, forced_mode: i32 }

pub function cfg_new(): Cfg {
  return Cfg { attrs: attrs_none(), recursive: false, deref: deref_cmdline(), hard_link: false, sym_link: false, force: false, ask: ask_yes(), update: update_all(), backups: false, control: gnu.backup_existing(), suffix: "~", verbose: false, debug: false, one_fs: false, attributes_only: false, copy_contents: false, remove_destination: false, sparse: sparse_auto(), reflink: reflink_auto(), verbose_style: vstyle_copy(), announced_backup: "", forced_mode: 0 - 1 };
}

pub struct State { out: io_buffered.BufWriter, status: i32, link_dev: i64[], link_ino: i64[], link_dest: string[], root_dev: i64, made_dev: i64[], made_ino: i64[], top_src: string, top_dest: string, aborted: boolean, unclonable: i64[] }

pub function state_new(o: io_buffered.BufWriter): State {
  return State { out: o, status: 0, link_dev: [], link_ino: [], link_dest: [], root_dev: 0 - 1, made_dev: [], made_ino: [], top_src: "", top_dest: "", aborted: false, unclonable: [] };
}

function fail(s: State, msg: string): State {
  return State { ...s, out: gnu.error_out(s.out, msg), status: 1 };
}

struct Info { ok: boolean, err: string, is_dir: boolean, is_file: boolean, is_link: boolean, size: i64, mode: u32, nlink: u32, uid: u32, gid: u32, dev: i64, rdev: i64, ino: i64, blksize: i64, blocks: i64, atime: i64, atime_nsec: i64, mtime: i64, mtime_nsec: i64 }

function no_info(text: string): Info {
  return Info { ok: false, err: text, is_dir: false, is_file: false, is_link: false, size: 0, mode: 0, nlink: 0, uid: 0, gid: 0, dev: 0, rdev: 0, ino: 0, blksize: 0, blocks: 0, atime: 0, atime_nsec: 0, mtime: 0, mtime_nsec: 0 };
}

function type_nibble(mode: u32): i32 {
  return (mode / 4096 % 16) as i32;
}

function is_link_mode(mode: u32): boolean {
  return type_nibble(mode) == 10;
}

pub function is_fifo_mode(mode: u32): boolean {
  return type_nibble(mode) == 1;
}

pub function is_chr_mode(mode: u32): boolean {
  return type_nibble(mode) == 2;
}

pub function is_blk_mode(mode: u32): boolean {
  return type_nibble(mode) == 6;
}

pub function is_sock_mode(mode: u32): boolean {
  return type_nibble(mode) == 12;
}

function info_of(st: FileStat, linkish: boolean): Info {
  return Info { ok: true, err: "", is_dir: st.is_dir, is_file: st.is_file, is_link: linkish && is_link_mode(st.mode), size: st.size, mode: st.mode, nlink: st.nlink, uid: st.uid, gid: st.gid, dev: st.dev, rdev: st.rdev, ino: st.ino, blksize: st.blksize, blocks: st.blocks, atime: st.atime, atime_nsec: st.atime_nsec, mtime: st.mtime, mtime_nsec: st.mtime_nsec };
}

function stat_of(path: string): Info {
  match (stat(path)) {
    Ok(st) => {
      return info_of(st, false);
    },
    Err(e) => {
      return no_info(gnu.io_error_text(e));
    }
  }
}

function lstat_of(path: string): Info {
  match (lstat(path)) {
    Ok(st) => {
      return info_of(st, true);
    },
    Err(e) => {
      return no_info(gnu.io_error_text(e));
    }
  }
}

function source_info(cfg: Cfg, path: string, top: boolean): Info {
  if (cfg.deref == deref_always()) {
    return stat_of(path);
  }
  if (cfg.deref == deref_cmdline() && top) {
    return stat_of(path);
  }
  return lstat_of(path);
}

function perm_bits(mode: u32): i32 {
  return (mode % 4096) as i32;
}

function create_mode(cfg: Cfg, src: Info): i32 {
  if (cfg.forced_mode >= 0) {
    return cfg.forced_mode;
  }
  if (cfg.attrs.mode) {
    return perm_bits(src.mode);
  }
  if (cfg.attrs.mode_declined) {
    let deflt: i32 = 438;
    if (src.is_dir) {
      deflt = 511;
    }
    return deflt & mode.complement(current_umask());
  }
  return perm_bits(src.mode) & mode.complement(current_umask());
}

function current_umask(): i32 {
  let m: i32 = umask(0);
  umask(m);
  return m;
}

function go(): i32 {
  return 0;
}

function skip(): i32 {
  return 1;
}

function stop(): i32 {
  return 2;
}

function vacated(): i32 {
  return 3;
}

function newer(src: Info, dst: Info): boolean {
  if (src.mtime != dst.mtime) {
    return src.mtime > dst.mtime;
  }
  return src.mtime_nsec > dst.mtime_nsec;
}

pub struct Replace { verdict: i32, backup: string, out: io_buffered.BufWriter, status: i32 }

function decide(cfg: Cfg, s: State, src: Info, dst: Info, dest: string): Replace {
  let w: io_buffered.BufWriter = s.out;
  if (update_skips(cfg.update)) {
    if (cfg.update == update_none_fail()) {
      return Replace { verdict: skip(), backup: "", out: gnu.error_out(w, "not replacing " + gnu.quotea(dest)), status: 1 };
    }
    if (cfg.debug) {
      w = gnu.put(w, "skipped " + gnu.quotea(dest) + "\n");
    }
    return Replace { verdict: skip(), backup: "", out: w, status: 0 };
  }
  if (cfg.update == update_older() && !newer(src, dst)) {
    return Replace { verdict: skip(), backup: "", out: w, status: 0 };
  }
  if (cfg.ask == ask_prompt()) {
    w = gnu.flush(w);
    if (!gnu.prompt("overwrite " + gnu.quotea(dest) + "? ")) {
      return Replace { verdict: stop(), backup: "", out: w, status: 1 };
    }
  }
  if (cfg.backups) {
    let name: string = gnu.backup_name(dest, cfg.control, cfg.suffix);
    match (rename(dest, name)) {
      Ok(_) => {},
      Err(e) => {
        if (errno.of(e) == errno.ENOENT) {
          return Replace { verdict: vacated(), backup: "", out: w, status: 0 };
        }
        w = gnu.error_out(w, "cannot backup " + gnu.quotea(dest) + ": " + gnu.io_error_text(e));
        return Replace { verdict: stop(), backup: "", out: w, status: 1 };
      }
    }
    return Replace { verdict: go(), backup: name, out: w, status: 0 };
  }
  if (cfg.remove_destination) {
    match (remove_file(dest)) {
      Ok(_) => {
        if (cfg.verbose) {
          w = gnu.put(w, "removed " + gnu.quotea(dest) + "\n");
        }
      },
      Err(e) => {
        w = gnu.error_out(w, "cannot remove " + gnu.quotea(dest) + ": " + gnu.io_error_text(e));
        return Replace { verdict: stop(), backup: "", out: w, status: 1 };
      }
    }
  }
  return Replace { verdict: go(), backup: "", out: w, status: 0 };
}

pub function vstyle_copy(): i32 {
  return 0;
}

pub function vstyle_move(): i32 {
  return 1;
}

function verbose_line(cfg: Cfg, s: State, src: string, dest: string, backup: string): State {
  if (!cfg.verbose) {
    return s;
  }
  let line: string = gnu.quotea(src) + " -> " + gnu.quotea(dest);
  if (cfg.verbose_style == vstyle_move()) {
    line = "copied " + line;
  }
  if (backup.len() > 0) {
    line = line + " (backup: " + gnu.quotea(backup) + ")";
  }
  return State { ...s, out: gnu.put(s.out, line + "\n") };
}

function verbose_dir_line(cfg: Cfg, s: State, src: string, dest: string): State {
  if (cfg.verbose_style == vstyle_move()) {
    if (!cfg.verbose) {
      return s;
    }
    return State { ...s, out: gnu.put(s.out, "created directory " + gnu.quotea(dest) + "\n") };
  }
  return verbose_line(cfg, s, src, dest, "");
}

function debug_line(cfg: Cfg, s: State, b: Bytes): State {
  if (!cfg.debug) {
    return s;
  }
  let offload: string = "no";
  if (b.offloaded) {
    offload = "yes";
  }
  return State { ...s, out: gnu.put(s.out, "copy offload: " + offload + ", reflink: unsupported, sparse detection: " + b.how + "\n") };
}

function chunk_size(): i32 {
  return 131072;
}

function offload_size(): i32 {
  return 2146435072;
}

function scans_extents(cfg: Cfg, src: Info): boolean {
  if (cfg.sparse == sparse_always()) {
    return true;
  }
  return src.blocks * 512 < src.size;
}

function hole_block(src: Info): i32 {
  let bs: i32 = src.blksize as i32;
  if (bs < 512 || bs > 1048576) {
    return 4096;
  }
  return bs;
}

struct Run { to: i32, zero: boolean }

function next_run(data: u8[], from: i32, bs: i32, zeros: u8[]): Run {
  let zero: boolean = run_is_zero(data, from, bs, zeros);
  let at: i32 = from + piece_len(data, from, bs);
  while (at < data.len() && run_is_zero(data, at, bs, zeros) == zero) {
    at = at + piece_len(data, at, bs);
  }
  return Run { to: at, zero: zero };
}

function piece_len(data: u8[], from: i32, bs: i32): i32 {
  if (data.len() - from < bs) {
    return data.len() - from;
  }
  return bs;
}

function run_is_zero(data: u8[], from: i32, bs: i32, zeros: u8[]): boolean {
  let n: i32 = piece_len(data, from, bs);
  return __mismatch_bytes(data, from, zeros, 0, n) == n;
}

function write_all(w: Writer, data: u8[], from: i32, to: i32): string {
  let piece: u8[] = data;
  if (from != 0 || to != data.len()) {
    let h: usize = buf_new(to - from);
    buf_push_bytes_range(h, data, from, to);
    piece = buf_take_bytes(h);
    buf_free(h);
  }
  if let Err(e) = w.write_bytes(piece) {
    return gnu.io_error_text(e);
  }
  return "";
}

struct Flow { ok: boolean, err: string, ended_in_hole: boolean, offload: boolean, offloaded: boolean }

function flow_new(offload: boolean): Flow {
  return Flow { ok: true, err: "", ended_in_hole: false, offload: offload, offloaded: false };
}

function flow_fail(f: Flow, err: string): Flow {
  return Flow { ...f, ok: false, err: err };
}

function put_chunk(w: Writer, data: u8[], punch: boolean, bs: i32, zeros: u8[], f0: Flow): Flow {
  let f: Flow = f0;
  if (!punch) {
    let werr: string = write_all(w, data, 0, data.len());
    if (werr.len() > 0) {
      return flow_fail(f, werr);
    }
    return Flow { ...f, ended_in_hole: false };
  }
  let at: i32 = 0;
  while (at < data.len()) {
    let run: Run = next_run(data, at, bs, zeros);
    if (run.zero) {
      match (w.seek((run.to - at) as i64, 1)) {
        Err(e) => {
          return flow_fail(f, gnu.io_error_text(e));
        },
        Ok(_) => {
          f = Flow { ...f, ended_in_hole: true };
        }
      }
    } else {
      let werr2: string = write_all(w, data, at, run.to);
      if (werr2.len() > 0) {
        return flow_fail(f, werr2);
      }
      f = Flow { ...f, ended_in_hole: false };
    }
    at = run.to;
  }
  return f;
}

function put_stream(r: Reader, w: Writer, punch: boolean, bs: i32, zeros: u8[], limit: i64, f0: Flow): Flow {
  let f: Flow = f0;
  let left: i64 = limit;
  while (limit < 0 as i64 || left > 0 as i64) {
    if (!punch && f.offload) {
      let ask: i32 = offload_size();
      if (limit >= 0 as i64 && left < ask as i64) {
        ask = left as i32;
      }
      match (r.copy_range_to(w, ask)) {
        Ok(n) => {
          if (n > 0 as i64) {
            left = left - n;
            f = Flow { ...f, offloaded: true, ended_in_hole: false };
            continue;
          }
          if (left != limit) {
            return f;
          }
          f = Flow { ...f, offload: false };
        },
        Err(e) => {
          match (e) {
            Unsupported => {
              f = Flow { ...f, offload: false };
            },
            _ => {
              return flow_fail(f, gnu.io_error_text(e));
            }
          }
        }
      }
    }
    let want: i32 = chunk_size();
    if (limit >= 0 as i64 && left < want as i64) {
      want = left as i32;
    }
    match (r.read_chunk_bytes(want)) {
      Err(e) => {
        return flow_fail(f, gnu.io_error_text(e));
      },
      Ok(data) => {
        if (data.len() == 0) {
          return f;
        }
        left = left - data.len() as i64;
        f = put_chunk(w, data, punch, bs, zeros, f);
        if (!f.ok) {
          return f;
        }
      }
    }
  }
  return f;
}

function put_zeros(w: Writer, n: i64, zeros: u8[]): string {
  let left: i64 = n;
  while (left > 0 as i64) {
    let k: i32 = zeros.len();
    if (left < k as i64) {
      k = left as i32;
    }
    let err: string = write_all(w, zeros, 0, k);
    if (err.len() > 0) {
      return err;
    }
    left = left - k as i64;
  }
  return "";
}

function put_extents(r: Reader, w: Writer, f0: Flow, fill: boolean, punch: boolean, total: i64, bs: i32, zeros: u8[]): Option[Flow] {
  let seek_data: i32 = 3;
  let seek_hole: i32 = 4;
  let f: Flow = f0;
  let pos: i64 = 0 as i64;
  while (pos < total) {
    let data: i64 = total;
    match (r.seek(pos, seek_data)) {
      Ok(d) => {
        data = d;
      },
      Err(e) => {
        if (errno.of(e) != errno.ENXIO) {
          if (pos == 0 as i64) {
            return None;
          }
          return Some(flow_fail(f, gnu.io_error_text(e)));
        }
      }
    }
    if (data >= total) {
      break;
    }
    let hole: i64 = total;
    match (r.seek(data, seek_hole)) {
      Ok(h) => {
        hole = h;
      },
      Err(e2) => {
        return Some(flow_fail(f, gnu.io_error_text(e2)));
      }
    }
    if (hole > total) {
      hole = total;
    }
    match (r.seek(data, 0)) {
      Err(e3) => {
        return Some(flow_fail(f, gnu.io_error_text(e3)));
      },
      Ok(_) => {}
    }
    if (fill) {
      let zerr: string = put_zeros(w, data - pos, zeros);
      if (zerr.len() > 0) {
        return Some(flow_fail(f, zerr));
      }
    } else {
      match (w.seek(data, 0)) {
        Err(e4) => {
          return Some(flow_fail(f, gnu.io_error_text(e4)));
        },
        Ok(_) => {}
      }
    }
    f = put_stream(r, w, punch, bs, zeros, hole - data, Flow { ...f, ended_in_hole: false });
    if (!f.ok) {
      return Some(f);
    }
    pos = hole;
  }
  if (pos < total) {
    if (fill) {
      let terr: string = put_zeros(w, total - pos, zeros);
      if (terr.len() > 0) {
        return Some(flow_fail(f, terr));
      }
    } else {
      f = Flow { ...f, ended_in_hole: true };
    }
  }
  return Some(f);
}

struct Bytes { ok: boolean, err: string, how: string, offloaded: boolean }

function write_data(r: Reader, w: Writer, scan: boolean, fill: boolean, punch: boolean, total: i64, bs: i32): Bytes {
  let zeros: u8[] = [];
  if (fill) {
    zeros = __alloc_u8(chunk_size());
  } else if (scan) {
    let n: i32 = bs;
    if (n > chunk_size()) {
      n = chunk_size();
    }
    zeros = __alloc_u8(n);
  }
  let f: Flow = flow_new(!fill);
  let how: string = "no";
  let done: boolean = false;
  if (scan) {
    match (put_extents(r, w, f, fill, punch, total, bs, zeros)) {
      Some(g) => {
        f = g;
        how = "SEEK_HOLE";
        done = true;
      },
      None => {}
    }
  }
  if (!done) {
    let zero_runs: boolean = scan && !fill;
    if (zero_runs) {
      how = "zero blocks";
    }
    f = put_stream(r, w, zero_runs, bs, zeros, 0 as i64 - 1 as i64, f);
  }
  if (!f.ok) {
    return Bytes { ok: false, err: f.err, how: how, offloaded: f.offloaded };
  }
  if (f.ended_in_hole) {
    if let Err(e) = w.truncate(total) {
      return Bytes { ok: false, err: gnu.io_error_text(e), how: how, offloaded: f.offloaded };
    }
  }
  return Bytes { ok: true, err: "", how: how, offloaded: f.offloaded };
}

function existing_mode(cfg: Cfg, src: Info): i32 {
  if (cfg.attrs.mode) {
    return perm_bits(src.mode);
  }
  return 0 - 1;
}

function apply_attrs(cfg: Cfg, s: State, src: Info, dest: string, want_mode: i32): State {
  let st: State = s;
  if (cfg.attrs.ownership) {
    match (chown_at(dest, src.uid as i32, src.gid as i32, false)) {
      Ok(_) => {},
      Err(e) => {
        st = fail(st, "failed to preserve ownership for " + gnu.quotea(dest) + ": " + gnu.io_error_text(e));
      }
    }
  }
  if (want_mode >= 0) {
    match (chmod(dest, want_mode)) {
      Ok(_) => {},
      Err(e2) => {
        st = fail(st, "cannot change permissions of " + gnu.quotea(dest) + ": " + gnu.io_error_text(e2));
      }
    }
  }
  if (cfg.attrs.timestamps) {
    match (set_file_times(dest, src.atime, src.atime_nsec, src.mtime, src.mtime_nsec, 0)) {
      Ok(_) => {},
      Err(e3) => {
        st = fail(st, "preserving times for " + gnu.quotea(dest) + ": " + gnu.io_error_text(e3));
      }
    }
  }
  return st;
}

function link_lookup(s: State, src: Info): string {
  let i: i32 = 0;
  while (i < s.link_ino.len()) {
    if (s.link_ino[i] == src.ino && s.link_dev[i] == src.dev) {
      return s.link_dest[i];
    }
    i = i + 1;
  }
  return "";
}

function link_record(s: State, src: Info, dest: string): State {
  return State { ...s, link_dev: s.link_dev.append(src.dev), link_ino: s.link_ino.append(src.ino), link_dest: s.link_dest.append(dest) };
}

function copy_file(cfg: Cfg, s: State, src_path: string, dest: string, src: Info, existed: boolean): State {
  let st: State = s;
  let want_mode: i32 = create_mode(cfg, src);
  if (existed && !cfg.attrs.mode) {
    want_mode = 0 - 1;
  }
  if (cfg.attributes_only) {
    if (!existed) {
      match (create_new(dest)) {
        Err(e) => {
          return fail(st, "cannot create regular file " + gnu.quotea(dest) + ": " + gnu.io_error_text(e));
        },
        Ok(w) => {
          w.close();
        }
      }
      return apply_attrs(cfg, st, src, dest, create_mode(cfg, src));
    }
    if (cfg.attrs.mode || cfg.attrs.ownership || cfg.attrs.timestamps) {
      return apply_attrs(cfg, st, src, dest, existing_mode(cfg, src));
    }
    return st;
  }
  if (existed && dangling_symlink(dest)) {
    return fail(st, "not writing through dangling symlink " + gnu.quotea(dest));
  }
  let cl: Cloned = try_clone(cfg, st, src_path, dest, src, existed, want_mode);
  if (cl.done) {
    return cl.st;
  }
  st = cl.st;
  match (open_reader(src_path)) {
    Err(e2) => {
      return fail(st, "cannot open " + gnu.quotea(src_path) + " for reading: " + gnu.io_error_text(e2));
    },
    Ok(r) => {
      let opened: DestOpen = open_dest(cfg, dest, existed);
      match (opened.err) {
        Some(e3) => {
          r.close();
          return fail(st, e3);
        },
        None => {}
      }
      match (opened.w) {
        None => {
          r.close();
          return fail(st, "cannot create regular file " + gnu.quotea(dest));
        },
        Some(w) => {
          let b: Bytes = write_data(r, w, scans_extents(cfg, src), cfg.sparse == sparse_never(), cfg.sparse == sparse_always(), src.size, hole_block(src));
          r.close();
          if let Err(ce) = w.close() {
            if (b.ok) {
              b = Bytes { ...b, ok: false, err: gnu.io_error_text(ce) };
            }
          }
          st = debug_line(cfg, st, b);
          if (!b.ok) {
            return fail(st, "error writing " + gnu.quotea(dest) + ": " + b.err);
          }
          if (want_mode >= 0) {
            return apply_attrs(cfg, st, src, dest, want_mode);
          }
          if (cfg.attrs.ownership || cfg.attrs.timestamps) {
            return apply_attrs(cfg, st, src, dest, 0 - 1);
          }
          return st;
        }
      }
    }
  }
}

struct Cloned { done: boolean, st: State }

function try_clone(cfg: Cfg, s: State, src_path: string, dest: string, src: Info, existed: boolean, want_mode: i32): Cloned {
  if (cfg.reflink == reflink_never()) {
    return Cloned { done: false, st: s };
  }
  if (cfg.reflink == reflink_auto() && has_dev(s.unclonable, src.dev)) {
    return Cloned { done: false, st: s };
  }
  if (target_os() == "darwin") {
    let cloned: i32 = src.mode as i32 & 1023;
    if (existed || (cloned & mode.complement(create_mode(cfg, src))) != 0) {
      return clone_refused(cfg, s, src_path, dest, "Operation not supported");
    }
  }
  match (clone_file(src_path, dest)) {
    Err(e) => {
      return clone_refused(cfg, State { ...s, unclonable: s.unclonable.append(src.dev) }, src_path, dest, gnu.io_error_text(e));
    },
    Ok(_) => {}
  }
  let st: State = s;
  if (target_os() == "darwin" && !cfg.attrs.timestamps) {
    match (set_file_times(dest, 0 as i64, 0 as i64, 0 as i64, 0 as i64, 25)) {
      Ok(_) => {},
      Err(e2) => {
        return Cloned { done: true, st: fail(st, "updating times for " + gnu.quotea(dest) + ": " + gnu.io_error_text(e2)) };
      }
    }
  }
  if (cfg.debug) {
    st = State { ...st, out: gnu.put(st.out, "copy offload: no, reflink: yes, sparse detection: no\n") };
  }
  if (want_mode >= 0 || cfg.attrs.ownership || cfg.attrs.timestamps) {
    st = apply_attrs(cfg, st, src, dest, want_mode);
  }
  return Cloned { done: true, st: st };
}

function has_dev(devs: i64[], dev: i64): boolean {
  for d in devs {
    if (d == dev) {
      return true;
    }
  }
  return false;
}

function clone_refused(cfg: Cfg, s: State, src_path: string, dest: string, why: string): Cloned {
  if (cfg.reflink != reflink_always()) {
    return Cloned { done: false, st: s };
  }
  return Cloned { done: true, st: fail(s, "failed to clone " + gnu.quotea(dest) + " from " + gnu.quotea(src_path) + ": " + why) };
}

function dangling_symlink(path: string): boolean {
  let l: Info = lstat_of(path);
  if (!l.ok || !l.is_link) {
    return false;
  }
  return !stat_of(path).ok;
}

struct DestOpen { w: Option[Writer], err: Option[string] }

function create_new(dest: string): Result[Writer, IoError] {
  return open_writer_with(dest, 5);
}

function open_existing_or_new(dest: string, existed: boolean): Result[Writer, IoError] {
  if (existed) {
    return open_writer(dest);
  }
  return create_new(dest);
}

function open_dest(cfg: Cfg, dest: string, existed: boolean): DestOpen {
  match (open_existing_or_new(dest, existed)) {
    Ok(w) => {
      return DestOpen { w: Some(w), err: None };
    },
    Err(e) => {
      if (!cfg.force || !existed) {
        return DestOpen { w: None, err: Some("cannot create regular file " + gnu.quotea(dest) + ": " + gnu.io_error_text(e)) };
      }
      match (remove_file(dest)) {
        Err(re) => {
          return DestOpen { w: None, err: Some("cannot remove " + gnu.quotea(dest) + ": " + gnu.io_error_text(re)) };
        },
        Ok(_) => {}
      }
      match (open_writer(dest)) {
        Ok(w2) => {
          return DestOpen { w: Some(w2), err: None };
        },
        Err(e2) => {
          return DestOpen { w: None, err: Some("cannot create regular file " + gnu.quotea(dest) + ": " + gnu.io_error_text(e2)) };
        }
      }
    }
  }
}

function copy_link(cfg: Cfg, s: State, src_path: string, dest: string, src: Info, existed: boolean): State {
  let st: State = s;
  match (read_link(src_path)) {
    Err(e) => {
      return fail(st, "cannot read symbolic link " + gnu.quotea(src_path) + ": " + gnu.io_error_text(e));
    },
    Ok(target) => {
      if (existed) {
        match (remove_file(dest)) {
          Ok(_) => {},
          Err(_) => {}
        }
      }
      match (create_symlink(target, dest)) {
        Ok(_) => {},
        Err(e2) => {
          return fail(st, "cannot create symbolic link " + gnu.quotea(dest) + ": " + gnu.io_error_text(e2));
        }
      }
      if (cfg.attrs.ownership) {
        match (chown_at(dest, src.uid as i32, src.gid as i32, true)) {
          Ok(_) => {},
          Err(_) => {}
        }
      }
      if (cfg.attrs.timestamps) {
        match (set_file_times(dest, src.atime, src.atime_nsec, src.mtime, src.mtime_nsec, 1)) {
          Ok(_) => {},
          Err(_) => {}
        }
      }
      return st;
    }
  }
}

function copy_special(cfg: Cfg, s: State, dest: string, src: Info, existed: boolean): State {
  let st: State = s;
  if (existed) {
    match (remove_file(dest)) {
      Ok(_) => {},
      Err(_) => {}
    }
  }
  let major: i32 = listing.dev_major(src.rdev as u64) as i32;
  let minor: i32 = listing.dev_minor(src.rdev as u64) as i32;
  match (mknod(dest, src.mode as i32, major, minor)) {
    Ok(_) => {},
    Err(e) => {
      return fail(st, "cannot create special file " + gnu.quotea(dest) + ": " + gnu.io_error_text(e));
    }
  }
  return apply_attrs(cfg, st, src, dest, create_mode(cfg, src));
}

function dirent_cmp(a: DirEntry, b: DirEntry): i32 {
  if (a.ino < b.ino) {
    return 0 - 1;
  }
  if (a.ino > b.ino) {
    return 1;
  }
  return 0;
}

function walk_order(dir: string, entries: DirEntry[]): DirEntry[] {
  let es: DirEntry[] = [];
  for e in entries {
    if (e.ino == 0) {
      es = es.append(DirEntry { ...e, ino: lstat_of(gnu.join_path(dir, e.name)).ino });
    } else {
      es = es.append(e);
    }
  }
  return cmp.sort_by(es, dirent_cmp);
}

function made(st: State, dev: i64, ino: i64): boolean {
  let i: i32 = 0;
  while (i < st.made_ino.len()) {
    if (st.made_ino[i] == ino && st.made_dev[i] == dev) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function copy_dir(cfg: Cfg, s: State, src_path: string, dest: string, src: Info, existed: boolean, top: boolean): State {
  let st: State = s;
  if (top) {
    st = State { ...st, made_dev: [], made_ino: [], top_src: src_path, top_dest: dest, aborted: false, unclonable: [] };
  }
  if (!existed) {
    match (create_dir(dest, (perm_bits(src.mode) | 448) & mode.complement(current_umask() & 511))) {
      Ok(_) => {},
      Err(e) => {
        return fail(st, "cannot create directory " + gnu.quotea(dest) + ": " + gnu.io_error_text(e));
      }
    }
    st = verbose_dir_line(cfg, st, src_path, dest);
    let mi: Info = lstat_of(dest);
    st = State { ...st, made_dev: st.made_dev.append(mi.dev), made_ino: st.made_ino.append(mi.ino) };
  }
  let entries: DirEntry[] = [];
  let readable: boolean = true;
  match (read_dir_ino(src_path)) {
    Err(e2) => {
      st = fail(st, "cannot read directory " + gnu.quotea(src_path) + ": " + gnu.io_error_text(e2));
      readable = false;
    },
    Ok(es) => {
      entries = es;
    }
  }
  if (readable) {
    for e in walk_order(src_path, entries) {
      if (st.aborted) {
        break;
      }
      st = copy_one(cfg, st, gnu.join_path(src_path, e.name), gnu.join_path(dest, e.name), false);
    }
  }
  let want: i32 = create_mode(cfg, src);
  if (existed && !cfg.attrs.mode) {
    if (cfg.attrs.ownership || cfg.attrs.timestamps) {
      return apply_attrs(cfg, st, src, dest, 0 - 1);
    }
    return st;
  }
  return apply_attrs(cfg, st, src, dest, want);
}

pub function copy_one(cfg: Cfg, s: State, src_path: string, dest: string, top: boolean): State {
  let st: State = s;
  let src: Info = source_info(cfg, src_path, top);
  if (!src.ok) {
    return fail(st, "cannot stat " + gnu.quotea(src_path) + ": " + src.err);
  }
  if (top && cfg.one_fs) {
    st = State { ...st, root_dev: src.dev };
  } else if (cfg.one_fs && src.dev != st.root_dev) {
    return st;
  }
  let dst: Info = lstat_of(dest);
  let existed: boolean = dst.ok;
  if (existed && dst.dev == src.dev && dst.ino == src.ino) {
    return fail(st, gnu.quotea(src_path) + " and " + gnu.quotea(dest) + " are the same file");
  }
  if (src.is_dir) {
    if (!cfg.recursive) {
      return fail(st, "-r not specified; omitting directory " + gnu.quotea(src_path));
    }
    if (existed && !dst.is_dir) {
      return fail(st, "cannot overwrite non-directory " + gnu.quotea(dest) + " with directory " + gnu.quotea(src_path));
    }
    if (!top && made(st, src.dev, src.ino)) {
      st = fail(st, "cannot copy a directory, " + gnu.quotea(st.top_src) + ", into itself, " + gnu.quotea(st.top_dest));
      return State { ...st, aborted: true };
    }
    return copy_dir(cfg, st, src_path, dest, src, existed, top);
  }
  if (existed && dst.is_dir) {
    return fail(st, "cannot overwrite directory " + gnu.quotea(dest) + " with non-directory " + gnu.quotea(src_path));
  }
  let backup: string = "";
  if (existed) {
    let r: Replace = decide(cfg, st, src, dst, dest);
    st = State { ...st, out: r.out };
    if (r.verdict == skip()) {
      if (r.status != 0) {
        return State { ...st, status: r.status };
      }
      return st;
    }
    if (r.verdict == stop()) {
      return State { ...st, status: r.status };
    }
    backup = r.backup;
    if (backup.len() > 0 || cfg.remove_destination || r.verdict == vacated()) {
      existed = false;
    }
  }
  if (backup.len() == 0 && top) {
    backup = cfg.announced_backup;
  }
  let follower: string = "";
  if (!cfg.sym_link && !(cfg.hard_link && !src.is_link) && cfg.attrs.links && src.nlink > 1) {
    follower = link_lookup(st, src);
  }
  if (follower.len() == 0 || cfg.verbose_style != vstyle_move()) {
    st = verbose_line(cfg, st, src_path, dest, backup);
  }
  if (cfg.sym_link) {
    return make_symlink(st, src_path, dest, existed);
  }
  if (cfg.hard_link && !src.is_link) {
    return make_hardlink(st, src_path, dest, existed);
  }
  if (cfg.attrs.links && src.nlink > 1) {
    if (follower.len() > 0) {
      return make_hardlink(st, follower, dest, existed);
    }
    st = link_record(st, src, dest);
  }
  if (src.is_link) {
    return copy_link(cfg, st, src_path, dest, src, existed);
  }
  if (!src.is_file) {
    if (cfg.copy_contents) {
      return copy_file(cfg, st, src_path, dest, src, existed);
    }
    return copy_special(cfg, st, dest, src, existed);
  }
  return copy_file(cfg, st, src_path, dest, src, existed);
}

function relative_link_ok(target: string, dest: string): boolean {
  if (target.len() > 0 && target[0] as i32 == 47) {
    return true;
  }
  let i: i32 = 0;
  while (i < dest.len()) {
    if (dest[i] as i32 == 47) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function make_symlink(s: State, target: string, dest: string, existed: boolean): State {
  let st: State = s;
  if (!relative_link_ok(target, dest)) {
    return fail(st, dest + ": can make relative symbolic links only in current directory");
  }
  if (existed) {
    match (remove_file(dest)) {
      Ok(_) => {},
      Err(_) => {}
    }
  }
  match (create_symlink(target, dest)) {
    Ok(_) => {
      return st;
    },
    Err(e) => {
      return fail(st, "cannot create symbolic link " + gnu.quotea(dest) + " to " + gnu.quotea(target) + ": " + gnu.io_error_text(e));
    }
  }
}

function make_hardlink(s: State, target: string, dest: string, existed: boolean): State {
  let st: State = s;
  if (existed) {
    match (remove_file(dest)) {
      Ok(_) => {},
      Err(_) => {}
    }
  }
  match (create_link(target, dest)) {
    Ok(_) => {
      return st;
    },
    Err(e) => {
      return fail(st, "cannot create hard link " + gnu.quotea(dest) + " to " + gnu.quotea(target) + ": " + gnu.io_error_text(e));
    }
  }
}
