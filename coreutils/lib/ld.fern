// coreutils/lib/ld.fern — C's `long double`, as the TARGET has it.
//
// GNU's printf, seq and numfmt all convert and compute in `long
// double`, so parity with them is parity with whatever format the C
// compiler gives that type on the machine the binary runs on. That is
// not one format:
//
//   x86-64          x87 80-bit extended  64-bit significand, integer bit STORED
//   arm64 / wasm32  IEEE binary128       113-bit significand, leading 1 implied
//   Darwin          IEEE binary64        53-bit significand, leading 1 implied
//
// and the difference shows in ordinary output, not only in the last
// bit: `printf '%a' 1` is `0x8p-3` on x86-64 and `0x1p+0` on arm64,
// `0.1` has twenty-one exact decimal digits against thirty-four, and
// 1e-4951 is a subnormal on one machine and an underflow to zero on
// another.
//
// `Format` is the three facts that make a machine's format —
// significand bits, exponent range, and whether the leading
// significand bit is stored — and every operation takes one, so a test
// can drive all three on any host. `format()` is the one the target
// has: `target_arch()` and `target_os()` fold to string literals before
// the checker runs, so the other machines' arms are pruned and a build
// carries exactly one model.
//
// A value is `m × 2^e` with `m` a 128-bit significand in two machine
// words, because 113 bits do not fit one and the round-to-nearest-even-
// plus-sticky logic is the same shape at any width. Canonical form: a
// normal has `m` exactly `mant` bits wide; a subnormal, and zero, has
// `e` pinned at the format's least exponent.
import "std/string";
import "std/array";
import "std/u64";
import "core/bigint";

// ---- the format ------------------------------------------------------------
// `mant` is the significand's width in bits (C's LDBL_MANT_DIG),
// `emax` the exponent of the largest finite binade (LDBL_MAX_EXP - 1),
// and `explicit_bit` says the leading bit is stored in the significand
// rather than implied by the exponent field. `mant - 1` and `mant - 4`
// are multiples of four in every format below, which is what lets `%a`
// print whole hex digits.
pub struct Format { mant: i32, emax: i32, explicit_bit: boolean }

// x87 80-bit extended: what glibc gives `long double` on x86-64.
pub function x87(): Format {
  return Format { mant: 64, emax: 16383, explicit_bit: true };
}

// IEEE binary128: `long double` on arm64 (Linux, Android), and on
// wasm32, whose ABI is whatever clang says the type is —
// __LDBL_MANT_DIG__ 113 for wasm32-wasi, the same as aarch64.
pub function binary128(): Format {
  return Format { mant: 113, emax: 16383, explicit_bit: false };
}

// IEEE binary64: on Apple platforms `long double` IS `double`.
pub function binary64(): Format {
  return Format { mant: 53, emax: 1023, explicit_bit: false };
}

// IEEE binary32: C's `float` everywhere Fern targets. Not a `long
// double` anywhere, but a caller that reads floats out of a byte buffer
// (`od -t f4`) wants the same conversions this module gives the wider
// two, and a second copy of them is a second place for the same bug.
pub function binary32(): Format {
  return Format { mant: 24, emax: 127, explicit_bit: false };
}

// `format()` — the target's. Darwin is the only environment that
// narrows the type to `double`, and x86-64 the only ISA that carries
// x87; every other target is the AAPCS64 / clang quad. There is no
// x86-64 Darwin target (docs/BACKEND-PARITY.md), so the two tests do
// not overlap.
pub function format(): Format {
  if (target_os() == "darwin") {
    return binary64();
  }
  if (target_arch() == "x86-64") {
    return x87();
  }
  return binary128();
}

// The exponent of the least NORMAL value's leading bit.
pub function (f: Format) emin(): i32 {
  return 1 - f.emax;
}

// The exponent of a subnormal's lowest bit — the least exponent any
// value in the format has, and the one every subnormal is stored with.
pub function (f: Format) min_exp(): i32 {
  return f.emin() - (f.mant - 1);
}

// C's LDBL_DIG: how many decimal digits survive a round trip through
// the format — 18 in x87, 33 in binary128, 15 in binary64. It is
// floor((mant - 1) * log10 2), with log10 2 as 30103/100000, which is
// exact enough to land on the same integer for every width a format
// here has.
pub function (f: Format) dig(): i32 {
  return (f.mant - 1) * 30103 / 100000;
}

// How far below the significand's top the printed `%a` point sits: the
// stored integer bit takes four bits with it, an implied one takes one.
function hex_shift(f: Format): i32 {
  if (f.explicit_bit) {
    return f.mant - 4;
  }
  return f.mant - 1;
}

// ---- values ----------------------------------------------------------------
// `LD` — a long double as `m × 2^e`, with `m` the 128-bit significand
// `hi:lo` and `e` the exponent of its lowest bit. `kind` is 0 for
// finite, 1 for infinity, 2 for NaN.
pub struct LD { neg: boolean, kind: i32, hi: u64, lo: u64, e: i32 }

pub function (f: Format) zero(neg: boolean): LD {
  return LD { neg: neg, kind: 0, hi: 0 as u64, lo: 0 as u64, e: f.min_exp() };
}

pub function inf(neg: boolean): LD {
  return LD { neg: neg, kind: 1, hi: 0 as u64, lo: 0 as u64, e: 0 };
}

pub function nan(neg: boolean): LD {
  return LD { neg: neg, kind: 2, hi: 0 as u64, lo: 0 as u64, e: 0 };
}

pub function (v: LD) is_finite(): boolean {
  return v.kind == 0;
}

pub function (v: LD) is_inf(): boolean {
  return v.kind == 1;
}

pub function (v: LD) is_nan(): boolean {
  return v.kind == 2;
}

pub function (v: LD) is_zero(): boolean {
  return v.kind == 0 && v.hi == 0 as u64 && v.lo == 0 as u64;
}

pub function (v: LD) negate(): LD {
  return LD { ...v, neg: !v.neg };
}

pub function (v: LD) abs(): LD {
  return LD { ...v, neg: false };
}

// The exponent of the value's leading bit; meaningless for zero.
function top_of(v: LD): i32 {
  return v.e + bit_length128(v.hi, v.lo) - 1;
}

// Whether a finite value is zero or below the format's least normal.
pub function (f: Format) is_subnormal(v: LD): boolean {
  if (v.is_zero()) {
    return true;
  }
  return top_of(v) < f.emin();
}

// ---- 128-bit words -----------------------------------------------------------
// A significand is two u64 words, `hi:lo`. Every helper takes a shift
// count in [0, 128] and answers one word, because a pair would be a
// tuple and a tuple return allocates. A u64 shift count is masked to
// six bits by the machine, so 64 and up are answered here explicitly.
function bit_length128(hi: u64, lo: u64): i32 {
  if (hi != 0 as u64) {
    return 128 - __clz64(hi);
  }
  return 64 - __clz64(lo);
}

function trailing_zeros128(hi: u64, lo: u64): i32 {
  if (lo != 0 as u64) {
    return __ctz64(lo);
  }
  return 64 + __ctz64(hi);
}

function shl_hi(hi: u64, lo: u64, k: i32): u64 {
  if (k == 0) {
    return hi;
  }
  if (k >= 128) {
    return 0 as u64;
  }
  if (k >= 64) {
    return lo << ((k - 64) as u64);
  }
  return (hi << (k as u64)) | (lo >> ((64 - k) as u64));
}

function shl_lo(lo: u64, k: i32): u64 {
  if (k >= 64) {
    return 0 as u64;
  }
  return lo << (k as u64);
}

function shr_hi(hi: u64, k: i32): u64 {
  if (k >= 64) {
    return 0 as u64;
  }
  return hi >> (k as u64);
}

function shr_lo(hi: u64, lo: u64, k: i32): u64 {
  if (k == 0) {
    return lo;
  }
  if (k >= 128) {
    return 0 as u64;
  }
  if (k >= 64) {
    return hi >> ((k - 64) as u64);
  }
  return (lo >> (k as u64)) | (hi << ((64 - k) as u64));
}

// The low `k` bits set, for k in [0, 64).
function low_mask(k: i32): u64 {
  return (1 as u64 << (k as u64)) - 1 as u64;
}

// Whether any of the low `k` bits is set.
function low_bits_set(hi: u64, lo: u64, k: i32): boolean {
  if (k <= 0) {
    return false;
  }
  if (k >= 128) {
    return hi != 0 as u64 || lo != 0 as u64;
  }
  if (k >= 64) {
    return lo != 0 as u64 || (hi & low_mask(k - 64)) != 0 as u64;
  }
  return (lo & low_mask(k)) != 0 as u64;
}

function cmp128(ah: u64, al: u64, bh: u64, bl: u64): i32 {
  if (ah != bh) {
    if (ah < bh) {
      return 0 - 1;
    }
    return 1;
  }
  if (al != bl) {
    if (al < bl) {
      return 0 - 1;
    }
    return 1;
  }
  return 0;
}

// The high word of the 128-bit product x × y; the low word is the
// machine's wrapping product. Four 32×32 partials, each of which fits.
function mul_hi64(x: u64, y: u64): u64 {
  var m: u64 = 4294967295 as u64;
  var sh: u64 = 32 as u64;
  var a: u64 = x >> sh;
  var b: u64 = x & m;
  var c: u64 = y >> sh;
  var d: u64 = y & m;
  var bd: u64 = b * d;
  var ad: u64 = a * d;
  var bc: u64 = b * c;
  var mid: u64 = (bd >> sh) + (ad & m) + (bc & m);
  return a * c + (mid >> sh) + (ad >> sh) + (bc >> sh);
}

// The high word of (ah:al) − (bh:bl), which requires the first to be
// the larger; the low word is the machine's wrapping difference.
function sub_hi(ah: u64, al: u64, bh: u64, bl: u64): u64 {
  var hi: u64 = ah - bh;
  if (al < bl) {
    hi = hi - 1 as u64;
  }
  return hi;
}

// The significand as a bigint, for the operations whose exact
// intermediate does not fit two words.
function to_big(hi: u64, lo: u64): bigint.BigInt {
  if (hi == 0 as u64) {
    return bigint.from_u64(lo);
  }
  return bigint.from_u64(hi).shl(64).add(bigint.from_u64(lo));
}

// ---- rounding --------------------------------------------------------------
// `round128(f, hi, lo, e, sticky, neg)` — the long double nearest
// (hi:lo) × 2^e, plus a little when `sticky`, half to even. Overflow is
// infinity; a value below half the least subnormal is zero. A value
// under the least normal is rounded at the subnormal grid, and when
// that carries it up to the least normal the two representations are
// the same record, so one rounding covers both.
//
// The word shifts are written out rather than taken from the helpers
// above: this is the one function every operation ends in, and on the
// x86-64 backend a helper call costs more than the shift it wraps.
function round128(f: Format, hi: u64, lo: u64, e: i32, sticky: boolean, neg: boolean): LD {
  var bl: i32 = 64 - __clz64(lo);
  if (hi != 0 as u64) {
    bl = 128 - __clz64(hi);
  }
  if (bl == 0) {
    return f.zero(neg);
  }
  var top: i32 = e + bl - 1;
  if (top > f.emax) {
    return inf(neg);
  }
  if (top < f.min_exp() - 1) {
    return f.zero(neg);
  }
  var at: i32 = top - (f.mant - 1);
  if (top < f.emin()) {
    at = f.min_exp();
  }
  var shift: i32 = at - e;
  if (shift <= 0) {
    // Exact: the value has no more bits than the format keeps, so it
    // is only moved up to its canonical width. The shift is under 128.
    var k: i32 = 0 - shift;
    if (k == 0) {
      return LD { neg: neg, kind: 0, hi: hi, lo: lo, e: at };
    }
    if (k >= 64) {
      return LD { neg: neg, kind: 0, hi: lo << ((k - 64) as u64), lo: 0 as u64, e: at };
    }
    return LD { neg: neg, kind: 0, hi: (hi << (k as u64)) | (lo >> ((64 - k) as u64)), lo: lo << (k as u64), e: at };
  }
  // Rounding: `shift` is in [1, bl], so at most 128. `mh:ml` is the
  // kept part, `round` the first bit below it and `below` whether any
  // bit under that one is set.
  var mh: u64 = 0 as u64;
  var ml: u64 = 0 as u64;
  var round: boolean = false;
  var below: boolean = sticky;
  if (shift < 64) {
    mh = hi >> (shift as u64);
    ml = (lo >> (shift as u64)) | (hi << ((64 - shift) as u64));
    round = ((lo >> ((shift - 1) as u64)) & 1 as u64) == 1 as u64;
    below = below || (lo & ((1 as u64 << ((shift - 1) as u64)) - 1 as u64)) != 0 as u64;
  } else if (shift == 64) {
    ml = hi;
    round = (lo >> 63 as u64) == 1 as u64;
    below = below || (lo << 1 as u64) != 0 as u64;
  } else if (shift < 128) {
    var t: i32 = shift - 64;
    ml = hi >> (t as u64);
    round = ((hi >> ((t - 1) as u64)) & 1 as u64) == 1 as u64;
    below = below || lo != 0 as u64 || (hi & ((1 as u64 << ((t - 1) as u64)) - 1 as u64)) != 0 as u64;
  } else {
    round = (hi >> 63 as u64) == 1 as u64;
    below = below || lo != 0 as u64 || (hi << 1 as u64) != 0 as u64;
  }
  if (round && (below || (ml & 1 as u64) == 1 as u64)) {
    ml = ml + 1 as u64;
    if (ml == 0 as u64) {
      mh = mh + 1 as u64;
    }
    // A carry out of the top bit leaves a power of two one bit wider
    // than the format, which drops back exactly.
    var wide: boolean = false;
    if (mh != 0 as u64) {
      wide = 128 - __clz64(mh) > f.mant;
    } else {
      wide = 64 - __clz64(ml) > f.mant;
    }
    if (wide) {
      ml = (ml >> 1 as u64) | (mh << 63 as u64);
      mh = mh >> 1 as u64;
      at = at + 1;
    }
  }
  if (at + (f.mant - 1) > f.emax) {
    return inf(neg);
  }
  return LD { neg: neg, kind: 0, hi: mh, lo: ml, e: at };
}

// `round(f, q, e, sticky, neg)` — `round128` for a bigint `q` of any
// width, and whether strtold would set ERANGE for it: overflow to
// infinity, or a result that is tiny AND inexact, tininess judged after
// rounding. Only the top 128 bits of `q` reach the rounding; everything
// below them is sticky, which decides the same tie the exact tail would.
pub function (f: Format) round(q: bigint.BigInt, e: i32, sticky: boolean, neg: boolean): (LD, boolean) {
  var bl: i32 = q.bit_length();
  if (bl == 0) {
    return (f.zero(neg), false);
  }
  var k: i32 = bl - 128;
  if (k < 0) {
    k = 0;
  }
  var t: bigint.BigInt = q.shr(k);
  var hi: u64 = t.word64(1);
  var lo: u64 = t.word64(0);
  var st: boolean = sticky || q.has_low_bits(k);
  var r: LD = round128(f, hi, lo, e + k, st, neg);
  if (r.kind == 1) {
    return (r, true);
  }
  if (e + bl - 1 >= f.emin()) {
    return (r, false);
  }
  if (r.is_zero() || bit_length128(r.hi, r.lo) < f.mant) {
    return (r, st || low_bits_set(hi, lo, f.min_exp() - (e + k)));
  }
  return (r, false);
}

pub function (f: Format) from_i64(v: i64): LD {
  var neg: boolean = v < 0 as i64;
  var mag: u64 = v as u64;
  if (neg) {
    mag = 0 as u64 - mag;
  }
  return round128(f, 0 as u64, mag, 0, false, neg);
}

pub function (f: Format) from_u64(v: u64): LD {
  return round128(f, 0 as u64, v, 0, false, false);
}

// `(v).as_i64()` — the value when it is a whole number an i64 holds.
pub function (v: LD) as_i64(): Option[i64] {
  if (v.kind != 0) {
    return None;
  }
  if (v.is_zero()) {
    return Some(0 as i64);
  }
  if (top_of(v) >= 64) {
    return None;
  }
  var u: u64 = v.lo;
  if (v.e >= 0) {
    u = shl_lo(v.lo, v.e);
  } else {
    var drop: i32 = 0 - v.e;
    if (low_bits_set(v.hi, v.lo, drop)) {
      return None;
    }
    u = shr_lo(v.hi, v.lo, drop);
  }
  if (v.neg) {
    if (u > 9223372036854775808 as u64) {
      return None;
    }
    return Some((0 as u64 - u) as i64);
  }
  if (u > 9223372036854775807 as u64) {
    return None;
  }
  return Some(u as i64);
}

// The largest whole number the format holds exactly, capped at what a
// u64 carries. A digit fold that stays under this is exact, so it can
// run in plain integer arithmetic and convert once; past it, every step
// has to round the way the C one does.
pub function (f: Format) max_exact_u64(): u64 {
  if (f.mant >= 64) {
    return 18446744073709551615 as u64;
  }
  return (1 as u64 << f.mant as u64) - 1 as u64;
}

// `pow10(f, k)` — 10^k, reached the way a C program reaches it: by
// multiplying, so the result carries the roundings that accumulate once
// the power outgrows the significand. Exact either way while 5^k still
// fits (k up to 27 in x87, 48 in binary128, 22 in binary64).
pub function (f: Format) pow10(k: i32): LD {
  var v: LD = f.from_i64(1 as i64);
  if (k <= 0) {
    return v;
  }
  var ten: LD = f.from_i64(10 as i64);
  var i: i32 = 0;
  while (i < k) {
    v = f.mul(v, ten);
    i = i + 1;
  }
  return v;
}

// A decimal magnitude past which the answer is settled by the digit
// count alone: log10(2) as 30103/100000, rounded outward so the exact
// path below still sees every value that could land in range.
function decimal_hi(f: Format): i32 {
  return (f.emax + 1) * 30103 / 100000 + 3;
}

function decimal_lo(f: Format): i32 {
  return 0 - ((1 - f.min_exp()) * 30103 / 100000 + 3);
}

// `from_decimal(f, digits, k, neg)` — digits × 10^k, correctly rounded.
// `digits` has no leading or trailing zeros. Magnitudes far outside the
// format are decided from the digit count; the rest go through exact
// bignum arithmetic — a division for a negative k, wide enough that the
// quotient carries the round and sticky bits.
pub function (f: Format) from_decimal(digits: string, k: i32, neg: boolean): (LD, boolean) {
  if (digits.len() == 0) {
    return (f.zero(neg), false);
  }
  var mag: i32 = digits.len() + k;
  if (mag > decimal_hi(f)) {
    return (inf(neg), true);
  }
  if (mag < decimal_lo(f)) {
    return (f.zero(neg), true);
  }
  var d: bigint.BigInt = bigint.zero();
  match (bigint.parse(digits)) {
    Some(v) => {
      d = v;
    },
    None => {}
  }
  if (k >= 0) {
    return f.round(d.mul_pow10(k), 0, false, neg);
  }
  var b: bigint.BigInt = bigint.from_i64(1 as i64).mul_pow10(0 - k);
  var s: i32 = f.mant + 2 + b.bit_length() - d.bit_length();
  if (s < 0) {
    s = 0;
  }
  var qr: (bigint.BigInt, bigint.BigInt) = d.shl(s).divmod(b);
  return f.round(qr.0, 0 - s, !qr.1.is_zero(), neg);
}

// ---- parsing ---------------------------------------------------------------
// C-locale byte classes. This module is a leaf — nothing it needs
// belongs to the GNU conventions in lib/gnu.fern — so it carries its
// own rather than importing that whole surface.
function is_digit(b: i32): boolean {
  return b >= 48 && b <= 57;
}

function lower(b: i32): i32 {
  if (b >= 65 && b <= 90) {
    return b + 32;
  }
  return b;
}

function is_alpha(b: i32): boolean {
  var l: i32 = lower(b);
  return l >= 97 && l <= 122;
}

function is_space(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

function hex_digit(b: i32): i32 {
  if (b >= 48 && b <= 57) {
    return b - 48;
  }
  if (b >= 97 && b <= 102) {
    return b - 87;
  }
  if (b >= 65 && b <= 70) {
    return b - 55;
  }
  return 0 - 1;
}

function hex_char(v: i32): i32 {
  if (v < 10) {
    return 48 + v;
  }
  return 87 + v;
}

// `Parse` — what strtold reports: the value, whether it set ERANGE,
// and how far it consumed (0 when the text names no number at all).
pub struct Parse { v: LD, erange: boolean, end: i32 }

function no_float(f: Format): Parse {
  return Parse { v: f.zero(false), erange: false, end: 0 };
}

// Whether `s[i..]` starts with `word` case-insensitively.
function has_word(s: string, i: i32, word: string): boolean {
  if (i + word.len() > s.len()) {
    return false;
  }
  var k: i32 = 0;
  while (k < word.len()) {
    if (lower(s[i + k] as i32) != word[k] as i32) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// A decimal exponent, saturating far beyond any magnitude that matters.
function read_exponent(s: string, i: i32): (i32, i32) {
  var j: i32 = i;
  var neg: boolean = false;
  if (j < s.len() && (s[j] as i32 == 43 || s[j] as i32 == 45)) {
    neg = s[j] as i32 == 45;
    j = j + 1;
  }
  if (j >= s.len() || !is_digit(s[j] as i32)) {
    return (0, i);
  }
  var v: i32 = 0;
  while (j < s.len() && is_digit(s[j] as i32)) {
    if (v < 100000000) {
      v = v * 10 + (s[j] as i32 - 48);
    }
    j = j + 1;
  }
  if (neg) {
    v = 0 - v;
  }
  return (v, j);
}

// `strtold(f, s)` — glibc's c_strtold: white space, sign, then inf /
// infinity / nan / nan(chars), a hex float, or a decimal one.
pub function (f: Format) strtold(s: string): Parse {
  var n: i32 = s.len();
  var i: i32 = 0;
  while (i < n && is_space(s[i] as i32)) {
    i = i + 1;
  }
  var neg: boolean = false;
  if (i < n && (s[i] as i32 == 45 || s[i] as i32 == 43)) {
    neg = s[i] as i32 == 45;
    i = i + 1;
  }
  if (has_word(s, i, "inf")) {
    i = i + 3;
    if (has_word(s, i, "inity")) {
      i = i + 5;
    }
    return Parse { v: inf(neg), erange: false, end: i };
  }
  if (has_word(s, i, "nan")) {
    i = i + 3;
    if (i < n && s[i] as i32 == 40) {
      var k: i32 = i + 1;
      while (k < n && (is_digit(s[k] as i32) || is_alpha(s[k] as i32) || s[k] as i32 == 95)) {
        k = k + 1;
      }
      if (k < n && s[k] as i32 == 41) {
        i = k + 1;
      }
    }
    return Parse { v: nan(neg), erange: false, end: i };
  }
  if (i + 1 < n && s[i] as i32 == 48 && lower(s[i + 1] as i32) == 120) {
    var j: i32 = i + 2;
    var hex_start: boolean = j < n && hex_digit(s[j] as i32) >= 0;
    if (!hex_start && j + 1 < n && s[j] as i32 == 46 && hex_digit(s[j + 1] as i32) >= 0) {
      hex_start = true;
    }
    if (hex_start) {
      return hex_float(f, s, j, neg);
    }
  }
  return decimal_float(f, s, i, neg);
}

function hex_float(f: Format, s: string, start: i32, neg: boolean): Parse {
  var n: i32 = s.len();
  var i: i32 = start;
  var q: bigint.BigInt = bigint.zero();
  var sixteen: bigint.BigInt = bigint.from_i64(16 as i64);
  var frac: i32 = 0;
  var in_frac: boolean = false;
  var any: boolean = false;
  while (i < n) {
    var b: i32 = s[i] as i32;
    if (b == 46 && !in_frac) {
      in_frac = true;
      i = i + 1;
      continue;
    }
    var d: i32 = hex_digit(b);
    if (d < 0) {
      break;
    }
    if (any || d != 0) {
      q = q.mul(sixteen).add(bigint.from_i64(d as i64));
      any = true;
    }
    if (in_frac) {
      frac = frac + 1;
    }
    i = i + 1;
  }
  var exp: i32 = 0;
  if (i < n && lower(s[i] as i32) == 112) {
    var r: (i32, i32) = read_exponent(s, i + 1);
    if (r.1 > i + 1) {
      exp = r.0;
      i = r.1;
    }
  }
  if (q.is_zero()) {
    return Parse { v: f.zero(neg), erange: false, end: i };
  }
  var lr: (LD, boolean) = f.round(q, exp - 4 * frac, false, neg);
  return Parse { v: lr.0, erange: lr.1, end: i };
}

function decimal_float(f: Format, s: string, start: i32, neg: boolean): Parse {
  var n: i32 = s.len();
  var i: i32 = start;
  var digits: u8[] = [];
  var frac: i32 = 0;
  var in_frac: boolean = false;
  var seen: boolean = false;
  var lead_zero: boolean = true;
  while (i < n) {
    var b: i32 = s[i] as i32;
    if (b == 46 && !in_frac) {
      if (i + 1 >= n || !is_digit(s[i + 1] as i32)) {
        if (!seen) {
          return no_float(f);
        }
        i = i + 1;
        break;
      }
      in_frac = true;
      i = i + 1;
      continue;
    }
    if (!is_digit(b)) {
      break;
    }
    seen = true;
    if (lead_zero && b == 48) {
      if (in_frac) {
        frac = frac + 1;
      }
    } else {
      lead_zero = false;
      digits = digits.append(b as u8);
      if (in_frac) {
        frac = frac + 1;
      }
    }
    i = i + 1;
  }
  if (!seen) {
    return no_float(f);
  }
  var exp: i32 = 0;
  if (i < n && lower(s[i] as i32) == 101) {
    var r: (i32, i32) = read_exponent(s, i + 1);
    if (r.1 > i + 1) {
      exp = r.0;
      i = r.1;
    }
  }
  var last: i32 = digits.len();
  while (last > 0 && digits[last - 1] as i32 == 48) {
    last = last - 1;
  }
  var k: i32 = exp - frac + (digits.len() - last);
  var ds: string = "";
  if (last > 0) {
    var kept: u8[] = [];
    var j: i32 = 0;
    while (j < last) {
      kept = kept.append(digits[j]);
      j = j + 1;
    }
    ds = string_from_bytes_unchecked(kept);
  }
  var lr: (LD, boolean) = f.from_decimal(ds, k, neg);
  return Parse { v: lr.0, erange: lr.1, end: i };
}

// ---- arithmetic ------------------------------------------------------------
// Each result is the exact value rounded once to the format, which is
// what an IEEE operation gives. The specials follow 754: a NaN operand
// is returned as it stands, ∞ − ∞ and 0 × ∞ are NaN, and a sum that
// cancels exactly is +0 under round-to-nearest.
//
// Each operation first strips its operands' trailing zero bits, so an
// integer's significand is the integer rather than the integer padded
// to the format's width, and runs on machine words when the exact
// result fits two of them; otherwise it runs the same computation on
// bigints. Both are exact, so they round to the same value, and the ld
// suite holds them to that on every format.
pub function (f: Format) add(a: LD, b: LD): LD {
  if (a.kind == 2) {
    return a;
  }
  if (b.kind == 2) {
    return b;
  }
  if (a.kind == 1) {
    if (b.kind == 1 && b.neg != a.neg) {
      return nan(false);
    }
    return a;
  }
  if (b.kind == 1) {
    return b;
  }
  if (a.is_zero()) {
    if (b.is_zero()) {
      return f.zero(false);
    }
    return b;
  }
  if (b.is_zero()) {
    return a;
  }
  var e: i32 = a.e + trailing_zeros128(a.hi, a.lo);
  var eb: i32 = b.e + trailing_zeros128(b.hi, b.lo);
  if (eb < e) {
    e = eb;
  }
  if (top_of(a) - e < 127 && top_of(b) - e < 127) {
    return add128(f, a, b, e);
  }
  return add_big(f, a, b);
}

// The sum on words: both significands aligned to 2^e fit 127 bits, so
// the sum fits 128 and the difference needs no borrow past the top.
function add128(f: Format, a: LD, b: LD, e: i32): LD {
  var ah: u64 = aligned_hi(a, e);
  var al: u64 = aligned_lo(a, e);
  var bh: u64 = aligned_hi(b, e);
  var bl: u64 = aligned_lo(b, e);
  if (a.neg == b.neg) {
    var lo: u64 = al + bl;
    var hi: u64 = ah + bh;
    if (lo < al) {
      hi = hi + 1 as u64;
    }
    return round128(f, hi, lo, e, false, a.neg);
  }
  var c: i32 = cmp128(ah, al, bh, bl);
  if (c == 0) {
    return f.zero(false);
  }
  if (c < 0) {
    return round128(f, sub_hi(bh, bl, ah, al), bl - al, e, false, b.neg);
  }
  return round128(f, sub_hi(ah, al, bh, bl), al - bl, e, false, a.neg);
}

// The significand of `v` as a multiple of 2^e, for an `e` at or below
// `v.e` plus its trailing zeros.
function aligned_hi(v: LD, e: i32): u64 {
  if (v.e >= e) {
    return shl_hi(v.hi, v.lo, v.e - e);
  }
  return shr_hi(v.hi, e - v.e);
}

function aligned_lo(v: LD, e: i32): u64 {
  if (v.e >= e) {
    return shl_lo(v.lo, v.e - e);
  }
  return shr_lo(v.hi, v.lo, e - v.e);
}

function add_big(f: Format, a: LD, b: LD): LD {
  var e: i32 = a.e;
  if (b.e < e) {
    e = b.e;
  }
  var av: bigint.BigInt = to_big(a.hi, a.lo).shl(a.e - e);
  if (a.neg) {
    av = av.negate();
  }
  var bv: bigint.BigInt = to_big(b.hi, b.lo).shl(b.e - e);
  if (b.neg) {
    bv = bv.negate();
  }
  var s: bigint.BigInt = av.add(bv);
  if (s.is_zero()) {
    return f.zero(false);
  }
  var r: (LD, boolean) = f.round(s.abs(), e, false, s.is_negative());
  return r.0;
}

pub function (f: Format) sub(a: LD, b: LD): LD {
  return f.add(a, b.negate());
}

pub function (f: Format) mul(a: LD, b: LD): LD {
  if (a.kind == 2) {
    return a;
  }
  if (b.kind == 2) {
    return b;
  }
  var neg: boolean = a.neg != b.neg;
  if (a.kind == 1 || b.kind == 1) {
    if (a.is_zero() || b.is_zero()) {
      return nan(false);
    }
    return inf(neg);
  }
  if ((a.hi | a.lo) == 0 as u64 || (b.hi | b.lo) == 0 as u64) {
    return f.zero(neg);
  }
  if (fits_word(a) && fits_word(b)) {
    var x: u64 = reduced(a);
    var y: u64 = reduced(b);
    return round128(f, mul_hi64(x, y), x * y, a.e + trailing_zeros128(a.hi, a.lo) + b.e + trailing_zeros128(b.hi, b.lo), false, neg);
  }
  var r: (LD, boolean) = f.round(to_big(a.hi, a.lo).mul(to_big(b.hi, b.lo)), a.e + b.e, false, neg);
  return r.0;
}

// Whether a non-zero significand fits one word once its trailing zero
// bits are dropped: `hi` is zero, or `lo` is and `hi` alone is the
// significand, or the two together are no wider than 64 bits once
// `lo`'s trailing zeros are counted off.
function fits_word(v: LD): boolean {
  if (v.hi == 0 as u64) {
    return true;
  }
  if (v.lo == 0 as u64) {
    return true;
  }
  return 128 - __clz64(v.hi) - __ctz64(v.lo) <= 64;
}

// The significand of a value `fits_word` accepted, as that word.
function reduced(v: LD): u64 {
  if (v.hi == 0 as u64) {
    return v.lo >> (__ctz64(v.lo) as u64);
  }
  if (v.lo == 0 as u64) {
    return v.hi >> (__ctz64(v.hi) as u64);
  }
  var t: i32 = __ctz64(v.lo);
  return (v.lo >> (t as u64)) | (v.hi << ((64 - t) as u64));
}

// `div(f, a, b)` — a / b rounded once to the format. The quotient is
// almost never exact, so the dividend is shifted first by enough that
// the integer quotient carries the whole significand plus the round
// bit; a non-zero remainder is the sticky bit, which is all `round`
// needs to break the tie correctly however much was cut off below.
pub function (f: Format) div(a: LD, b: LD): LD {
  if (a.kind == 2) {
    return a;
  }
  if (b.kind == 2) {
    return b;
  }
  var neg: boolean = a.neg != b.neg;
  if (a.kind == 1) {
    if (b.kind == 1) {
      return nan(false);
    }
    return inf(neg);
  }
  if (b.kind == 1) {
    return f.zero(neg);
  }
  if ((b.hi | b.lo) == 0 as u64) {
    if ((a.hi | a.lo) == 0 as u64) {
      return nan(false);
    }
    return inf(neg);
  }
  if ((a.hi | a.lo) == 0 as u64) {
    return f.zero(neg);
  }
  if (fits_word(a) && fits_word(b)) {
    var d: u64 = reduced(b);
    if (d <= 4294967295 as u64) {
      return div_small(f, reduced(a), a.e + trailing_zeros128(a.hi, a.lo), d, b.e + trailing_zeros128(b.hi, b.lo), neg);
    }
  }
  var s: i32 = f.mant + 3 + bit_length128(b.hi, b.lo) - bit_length128(a.hi, a.lo);
  if (s < 0) {
    s = 0;
  }
  var qr: (bigint.BigInt, bigint.BigInt) = to_big(a.hi, a.lo).shl(s).divmod(to_big(b.hi, b.lo));
  var r: (LD, boolean) = f.round(qr.0, a.e - b.e - s, !qr.1.is_zero(), neg);
  return r.0;
}

// The quotient on words: `x × 2^s / d` by long division in 32-bit
// chunks, for a divisor under 2^32 so each step's `rem:chunk` fits a
// u64. `s` gives the quotient `mant + 3` bits; the chunks are read
// straight out of `x` at their offset below `s`, so the shifted
// dividend, which can run to 148 bits, is never built. The first
// chunk is whatever is left over above a multiple of 32, so the
// quotient, which is under `mant + 4` bits, never outgrows two words.
function div_small(f: Format, x: u64, ex: i32, d: u64, ed: i32, neg: boolean): LD {
  var s: i32 = f.mant + 3 + (64 - __clz64(d)) - (64 - __clz64(x));
  if (s < 0) {
    s = 0;
  }
  var pos: i32 = 64 - __clz64(x) + s;
  var width: i32 = pos % 32;
  if (width == 0) {
    width = 32;
  }
  var qh: u64 = 0 as u64;
  var ql: u64 = 0 as u64;
  var rem: u64 = 0 as u64;
  while (pos > 0) {
    // Bits [from, from + width) of the dividend are the same bits of
    // `x` when `from` is at or above 0, the low bits of `x` moved up
    // when it is within `width` below, and zero further down.
    var from: i32 = pos - width - s;
    var chunk: u64 = 0 as u64;
    if (from >= 0) {
      chunk = (x >> (from as u64)) & ((1 as u64 << (width as u64)) - 1 as u64);
    } else if (from + width > 0) {
      chunk = (x << ((0 - from) as u64)) & ((1 as u64 << (width as u64)) - 1 as u64);
    }
    var cur: u64 = (rem << 32 as u64) | chunk;
    var q: u64 = cur / d;
    rem = cur % d;
    qh = (qh << (width as u64)) | (ql >> ((64 - width) as u64));
    ql = (ql << (width as u64)) | q;
    pos = pos - width;
    width = 32;
  }
  return round128(f, qh, ql, ex - ed - s, rem != 0 as u64, neg);
}

// `cmp(a, b)` — -1, 0 or 1, and 2 when the two are UNORDERED because
// one is a NaN. 2 makes `a.cmp(b) < 0` and `a.cmp(b) == 0` answer as C
// does; a caller that wants `>=` has to rule the NaN out first, exactly
// as C's `!(a < b)` differs from `a >= b`.
pub function (a: LD) cmp(b: LD): i32 {
  if (a.kind == 2 || b.kind == 2) {
    return 2;
  }
  var an: boolean = a.neg && !a.is_zero();
  var bn: boolean = b.neg && !b.is_zero();
  if (an != bn) {
    if (an) {
      return 0 - 1;
    }
    return 1;
  }
  var c: i32 = mag_cmp(a, b);
  if (an) {
    return 0 - c;
  }
  return c;
}

pub function (a: LD) eq(b: LD): boolean {
  return a.cmp(b) == 0;
}

pub function (a: LD) lt(b: LD): boolean {
  return a.cmp(b) == 0 - 1;
}

// Where a magnitude sits among the three that need no arithmetic to
// order: -1 zero, 0 an ordinary finite one, 1 infinite.
function mag_class(v: LD): i32 {
  if (v.kind == 1) {
    return 1;
  }
  if ((v.hi | v.lo) == 0 as u64) {
    return 0 - 1;
  }
  return 0;
}

// `cmp_abs(a, b)` — |a| against |b|, without building either. The
// leading bits' exponents settle almost every pair, and two canonical
// values that share a binade share an exponent too, so their words
// compare directly; only a non-canonical pair is aligned to the lower
// of its exponents, where the wider significand's width bounds the
// shifted one. A NaN operand is unordered here too.
pub function (a: LD) cmp_abs(b: LD): i32 {
  if (a.kind == 2 || b.kind == 2) {
    return 2;
  }
  return mag_cmp(a, b);
}

function mag_cmp(a: LD, b: LD): i32 {
  var ca: i32 = mag_class(a);
  var cb: i32 = mag_class(b);
  if (ca != cb) {
    if (ca < cb) {
      return 0 - 1;
    }
    return 1;
  }
  if (ca != 0) {
    return 0;
  }
  var ta: i32 = a.e + 63 - __clz64(a.lo);
  if (a.hi != 0 as u64) {
    ta = a.e + 127 - __clz64(a.hi);
  }
  var tb: i32 = b.e + 63 - __clz64(b.lo);
  if (b.hi != 0 as u64) {
    tb = b.e + 127 - __clz64(b.hi);
  }
  if (ta != tb) {
    if (ta < tb) {
      return 0 - 1;
    }
    return 1;
  }
  if (a.e == b.e) {
    return cmp128(a.hi, a.lo, b.hi, b.lo);
  }
  var e: i32 = a.e;
  if (b.e < e) {
    e = b.e;
  }
  return cmp128(aligned_hi(a, e), aligned_lo(a, e), aligned_hi(b, e), aligned_lo(b, e));
}

// ---- rounding a value to a whole number ------------------------------------
// The modes `numfmt --round` selects between. They round the VALUE to a
// whole number, which is a different question from the rounding every
// operation above does to fit the format.
pub function round_up(): i32 {
  return 0;
}

pub function round_down(): i32 {
  return 1;
}

pub function round_from_zero(): i32 {
  return 2;
}

pub function round_toward_zero(): i32 {
  return 3;
}

pub function round_nearest(): i32 {
  return 4;
}

// `round_to_int(f, v, mode)` — v as a whole number.
//
// `nearest` is `floor(|v| + 1/2)` with the sign put back, NOT a
// correctly-rounded round-half-away: the addition rounds to the format
// first, so a value a hair under a half carries up to the half and then
// rounds away with it. That asymmetry is load-bearing — it is why
// `numfmt --round=nearest --format=%.3f 0.0005` is 0.001 — so the
// addition has to happen at the target's precision, not exactly.
pub function (f: Format) round_to_int(v: LD, mode: i32): LD {
  if (v.kind != 0 || (v.hi | v.lo) == 0 as u64 || v.e >= 0) {
    return v;
  }
  if (mode == round_nearest()) {
    return trunc_mag(f, plus_half(f, v), v.neg);
  }
  var drop: i32 = 0 - v.e;
  if (!low_bits_set(v.hi, v.lo, drop)) {
    return v;
  }
  // The whole part, as an integer in two words, plus one when the
  // mode moves away from zero; both fit, since the value did.
  var wh: u64 = shr_hi(v.hi, drop);
  var wl: u64 = shr_lo(v.hi, v.lo, drop);
  if (away_from_zero(mode, v.neg)) {
    wl = wl + 1 as u64;
    if (wl == 0 as u64) {
      wh = wh + 1 as u64;
    }
  }
  return round128(f, wh, wl, 0, false, v.neg);
}

// |v| + 1/2 rounded to the format, for a `v` below one in magnitude
// or with a fraction. The half is added on the value's own grid when
// it lands within two words of it; a value too small for that is
// added the general way.
function plus_half(f: Format, v: LD): LD {
  var k: i32 = 0 - 1 - v.e;
  if (k < 127 && top_of(v) - v.e < 127) {
    var sh: u64 = v.hi;
    var sl: u64 = v.lo;
    if (k >= 64) {
      sh = sh + (1 as u64 << ((k - 64) as u64));
    } else {
      sl = sl + (1 as u64 << (k as u64));
      if (sl < v.lo) {
        sh = sh + 1 as u64;
      }
    }
    return round128(f, sh, sl, v.e, false, false);
  }
  return f.add(v.abs(), f.half());
}

pub function (f: Format) half(): LD {
  return round128(f, 0 as u64, 1 as u64, 0 - 1, false, false);
}

// Whether a value with a fraction moves one step away from zero. The
// caller has already established that there is a fraction.
function away_from_zero(mode: i32, neg: boolean): boolean {
  if (mode == round_toward_zero()) {
    return false;
  }
  if (mode == round_from_zero()) {
    return true;
  }
  if (mode == round_up()) {
    return !neg;
  }
  return neg;
}

// The whole part of a finite value's magnitude with the sign `neg`,
// which is exact in the format: it has no more significant bits than
// the value it came from.
function trunc_mag(f: Format, v: LD, neg: boolean): LD {
  if (v.e >= 0) {
    return LD { ...v, neg: neg };
  }
  return round128(f, shr_hi(v.hi, 0 - v.e), shr_lo(v.hi, v.lo, 0 - v.e), 0, false, neg);
}

// ---- exact decimal digits ---------------------------------------------------
// `Dec` — a finite value as 0.digits × 10^dp with the leading digit
// non-zero, or an empty digit string for zero; the digits are the EXACT
// expansion of the binary value, which is what `%e`, `%f` and `%g`
// round from.
pub struct Dec { digits: string, dp: i32 }

pub function (v: LD) dec(): Dec {
  if (v.is_zero()) {
    return Dec { digits: "", dp: 0 };
  }
  var tz: i32 = trailing_zeros128(v.hi, v.lo);
  var hi: u64 = shr_hi(v.hi, tz);
  var lo: u64 = shr_lo(v.hi, v.lo, tz);
  var e: i32 = v.e + tz;
  if (e >= 0) {
    if (hi == 0 as u64 && 64 - __clz64(lo) + e <= 64) {
      var w: string = (lo << (e as u64)).to_string();
      return Dec { digits: w, dp: w.len() };
    }
    var s: string = to_big(hi, lo).shl(e).to_string();
    return Dec { digits: s, dp: s.len() };
  }
  // m × 5^-e, which a word holds while 5^k has room beside m: 5^27 is
  // the largest power under 2^63.
  if (hi == 0 as u64 && 0 - e <= 27 && 64 - __clz64(lo) + pow5_bits(0 - e) <= 64) {
    var u: string = (lo * pow5_u64(0 - e)).to_string();
    return Dec { digits: u, dp: u.len() + e };
  }
  var t: string = to_big(hi, lo).mul_pow5(0 - e).to_string();
  return Dec { digits: t, dp: t.len() + e };
}

// 5^k for k up to 27, and its width in bits.
function pow5_u64(k: i32): u64 {
  var p: u64 = 1 as u64;
  var i: i32 = 0;
  while (i < k) {
    p = p * 5 as u64;
    i = i + 1;
  }
  return p;
}

function pow5_bits(k: i32): i32 {
  return 64 - __clz64(pow5_u64(k));
}

// `round_digits(d, n)` — the first `n` digits of `d`, rounded half to
// even on the exact tail and zero-padded when `d` is shorter. When the
// rounding carries out of the top digit the result is one digit longer
// (a 1 and n zeros) and the boolean says so.
pub function round_digits(d: string, n: i32): (string, boolean) {
  if (n <= 0) {
    if (n < 0) {
      return ("", false);
    }
    var first: i32 = d[0] as i32;
    if (first > 53 || first == 53 && has_nonzero(d, 1)) {
      return ("1", true);
    }
    return ("", false);
  }
  if (n >= d.len()) {
    return (d + "0".repeat(n - d.len()), false);
  }
  var c: i32 = d[n] as i32;
  var up: boolean = false;
  if (c > 53) {
    up = true;
  } else if (c == 53) {
    if (has_nonzero(d, n + 1)) {
      up = true;
    } else {
      up = (d[n - 1] as i32 - 48) % 2 == 1;
    }
  }
  var kept: u8[] = __alloc_u8(n);
  var i: i32 = 0;
  while (i < n) {
    kept = kept.with(i, d[i]);
    i = i + 1;
  }
  if (!up) {
    return (string_from_bytes_unchecked(kept), false);
  }
  i = n - 1;
  while (i >= 0) {
    if (kept[i] as i32 == 57) {
      kept = kept.with(i, 48 as u8);
      i = i - 1;
    } else {
      kept = kept.with(i, (kept[i] as i32 + 1) as u8);
      return (string_from_bytes_unchecked(kept), false);
    }
  }
  return ("1" + string_from_bytes_unchecked(kept), true);
}

function has_nonzero(d: string, from: i32): boolean {
  var i: i32 = from;
  while (i < d.len()) {
    if (d[i] as i32 != 48) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// ---- %e %f %g ----------------------------------------------------------------
// `Body` — the characters of one conversion, or the refusal glibc
// answers a field that would reach INT_MAX-1 bytes with: the directive
// prints nothing and the stream carries an error. `extra` below is how
// many bytes the caller puts in front (a sign, a radix), which counts
// toward that limit the same way.
pub struct Body { s: string, refused: boolean }

function refused(): Body {
  return Body { s: "", refused: true };
}

// The length at which glibc refuses a conversion outright.
pub function overflow_len(): i64 {
  return 2147483646 as i64;
}

// `fixed(d, prec, alt, extra)` — the `%f` body: `prec` digits after the
// point, `alt` keeping the point when there are none.
pub function fixed(d: Dec, prec: i64, alt: boolean, extra: i64): Body {
  if (d.digits.len() == 0) {
    if (prec + 7 as i64 + extra >= overflow_len()) {
      return refused();
    }
    return fixed_shape("", 0 - prec as i32, prec, alt);
  }
  var n: i64 = d.dp as i64 + prec;
  if (n + 2 as i64 + extra >= overflow_len()) {
    return refused();
  }
  var rf: (string, boolean) = round_digits(d.digits, n as i32);
  var dp: i32 = d.dp;
  if (rf.1) {
    dp = dp + 1;
  }
  if (n < 0 as i64) {
    dp = 0 - prec as i32;
  }
  return fixed_shape(rf.0, dp, prec, alt);
}

// `digits` are the rounded digits with the decimal point `dp` digits in
// (dp ≤ 0 puts leading zeros after the point); exactly `prec` follow it.
function fixed_shape(digits: string, dp: i32, prec: i64, alt: boolean): Body {
  var body: string = "";
  if (dp >= 1) {
    body = slice_unchecked(digits, 0, dp) + "";
    if (prec > 0 as i64 || alt) {
      body = body + ".";
    }
    body = body + slice_unchecked(digits, dp, digits.len());
  } else {
    body = "0";
    if (prec > 0 as i64 || alt) {
      body = body + ".";
    }
    body = body + "0".repeat(0 - dp) + digits;
  }
  return Body { s: body, refused: false };
}

// The `e+NN` tail, at least two exponent digits.
function exp_suffix(x: i32, upper: boolean): string {
  var out: string = "e";
  if (upper) {
    out = "E";
  }
  var ax: i32 = x;
  if (x < 0) {
    out = out + "-";
    ax = 0 - x;
  } else {
    out = out + "+";
  }
  var ds: string = (ax as i64).to_string();
  if (ds.len() < 2) {
    ds = "0" + ds;
  }
  return out + ds;
}

// `sci(d, prec, alt, upper, extra)` — the `%e` body: one digit, the
// point, `prec` more, then the exponent.
pub function sci(d: Dec, prec: i64, alt: boolean, upper: boolean, extra: i64): Body {
  if (d.digits.len() == 0) {
    if (prec + 7 as i64 + extra >= overflow_len()) {
      return refused();
    }
    return sci_shape("0".repeat(prec as i32 + 1), 0, prec, alt, upper);
  }
  if (prec + 2 as i64 + extra + exp_suffix(d.dp - 1, false).len() as i64 >= overflow_len()) {
    return refused();
  }
  var re: (string, boolean) = round_digits(d.digits, prec as i32 + 1);
  var xe: i32 = d.dp - 1;
  var de: string = re.0;
  if (re.1) {
    xe = xe + 1;
    de = slice_unchecked(de, 0, prec as i32 + 1) + "";
  }
  return sci_shape(de, xe, prec, alt, upper);
}

function sci_shape(digits: string, x: i32, prec: i64, alt: boolean, upper: boolean): Body {
  var body: string = slice_unchecked(digits, 0, 1) + "";
  if (prec > 0 as i64 || alt) {
    body = body + ".";
  }
  body = body + slice_unchecked(digits, 1, digits.len()) + exp_suffix(x, upper);
  return Body { s: body, refused: false };
}

// `general(d, prec, alt, upper, extra)` — the `%g` body: `prec`
// significant digits (0 reads as 1), style `%e` when the exponent is
// below -4 or at least `prec` and `%f` otherwise, trailing zeros gone
// unless `alt` asks for them.
pub function general(d: Dec, prec: i64, alt: boolean, upper: boolean, extra: i64): Body {
  var pr: i64 = prec;
  if (pr == 0 as i64) {
    pr = 1 as i64;
  }
  if (d.digits.len() == 0) {
    return general_shape("0".repeat(pr as i32), 0, pr, alt, upper, false, extra);
  }
  var sig: i32 = d.digits.len();
  if (pr < sig as i64) {
    sig = pr as i32;
  }
  var r: (string, boolean) = round_digits(d.digits, sig);
  var x: i32 = d.dp - 1;
  var digits: string = r.0;
  if (r.1) {
    x = x + 1;
    digits = slice_unchecked(digits, 0, sig) + "";
  }
  return general_shape(digits, x, pr, alt, upper, r.1, extra);
}

// `digits` are the value's leading significant digits (at most `prec`,
// fewer only when the exact expansion ends sooner) and `x` the exponent
// of the first. glibc chooses the style BEFORE rounding, so when
// `carried` lifted a fixed-style value to exactly 10^prec the exponent
// style inherits the fixed style's zero fraction digits: `%#.3g` of
// 999.5 is `1.e+03`.
function general_shape(digits: string, x: i32, prec: i64, alt: boolean, upper: boolean, carried: boolean, extra: i64): Body {
  var pr: i32 = prec as i32;
  if (x < 0 - 4 || x as i64 >= prec) {
    var mant: string = slice_unchecked(digits, 0, 1) + "";
    var frac: string = slice_unchecked(digits, 1, digits.len()) + "";
    if (carried && x as i64 == prec) {
      frac = "";
    } else if (alt) {
      if (prec - 1 as i64 + extra >= overflow_len()) {
        return refused();
      }
      frac = frac + "0".repeat(pr - digits.len());
    } else {
      frac = strip_zeros(frac);
    }
    if (frac.len() > 0 || alt) {
      mant = mant + "." + frac;
    }
    return Body { s: mant + exp_suffix(x, upper), refused: false };
  }
  var dp: i32 = x + 1;
  var ip: string = "0";
  var frac: string = "";
  if (dp >= 1) {
    if (dp > digits.len()) {
      ip = digits + "0".repeat(dp - digits.len());
    } else {
      ip = slice_unchecked(digits, 0, dp) + "";
      frac = slice_unchecked(digits, dp, digits.len()) + "";
    }
  } else {
    frac = "0".repeat(0 - dp) + digits;
  }
  if (alt) {
    var want: i32 = pr - 1 - x;
    if (want as i64 + extra >= overflow_len()) {
      return refused();
    }
    if (frac.len() < want) {
      frac = frac + "0".repeat(want - frac.len());
    }
  } else {
    frac = strip_zeros(frac);
  }
  var body: string = ip;
  if (frac.len() > 0 || alt) {
    body = body + "." + frac;
  }
  return Body { s: body, refused: false };
}

function strip_zeros(s: string): string {
  var n: i32 = s.len();
  while (n > 0 && s[n - 1] as i32 == 48) {
    n = n - 1;
  }
  return slice_unchecked(s, 0, n) + "";
}

// ---- whole conversions ------------------------------------------------------
// The bodies above carry no sign, because printf writes its own from
// the flags. A caller that just wants what C would print reaches for
// these.
// `to_fixed(f, v, prec)` — `printf("%.*Lf", prec, v)`.
//
// `%f` rounds the exact decimal expansion half to even at `prec`
// places, which is the integer nearest |v| × 10^prec with ties to even,
// written with the point `prec` digits from its end. When |v|'s
// significand and 10^prec both fit a word that integer is a 128-bit
// product shifted by the exponent — no expansion built and no digit
// string rounded. The rest go through `dec` and `fixed`.
pub function (f: Format) to_fixed(v: LD, prec: i32): string {
  if (v.kind == 0 && prec >= 0 && prec <= 19) {
    if ((v.hi | v.lo) == 0 as u64) {
      return fixed_u64(0 as u64, prec, v.neg);
    }
    if (fits_word(v)) {
      var q: u64 = scaled_u64(reduced(v), v.e + trailing_zeros128(v.hi, v.lo), prec);
      if (q != 18446744073709551615 as u64) {
        return fixed_u64(q, prec, v.neg);
      }
    }
  }
  return sign_of(v) + fixed(v.dec(), prec as i64, false, 0 as i64).s;
}

// `m × 2^e × 10^prec` as the nearest whole number, ties to even, or u64
// MAX when it does not fit a word — a value that large is the 20-digit
// case `fixed` handles, so the sentinel costs nothing.
function scaled_u64(m: u64, e: i32, prec: i32): u64 {
  var p: u64 = pow10_u64(prec);
  var hi: u64 = mul_hi64(m, p);
  var lo: u64 = m * p;
  var none: u64 = 18446744073709551615 as u64;
  if (e >= 0) {
    if (hi != 0 as u64 || e >= 64 || (e > 0 && (lo >> ((64 - e) as u64)) != 0 as u64)) {
      return none;
    }
    return lo << (e as u64);
  }
  var shift: i32 = 0 - e;
  var q: u64 = 0 as u64;
  var round: boolean = false;
  var below: boolean = false;
  if (shift < 64) {
    if ((hi >> (shift as u64)) != 0 as u64) {
      return none;
    }
    q = (lo >> (shift as u64)) | (hi << ((64 - shift) as u64));
    round = ((lo >> ((shift - 1) as u64)) & 1 as u64) == 1 as u64;
    below = (lo & ((1 as u64 << ((shift - 1) as u64)) - 1 as u64)) != 0 as u64;
  } else if (shift == 64) {
    q = hi;
    round = (lo >> 63 as u64) == 1 as u64;
    below = (lo << 1 as u64) != 0 as u64;
  } else if (shift < 128) {
    var t: i32 = shift - 64;
    q = hi >> (t as u64);
    round = ((hi >> ((t - 1) as u64)) & 1 as u64) == 1 as u64;
    below = lo != 0 as u64 || (hi & ((1 as u64 << ((t - 1) as u64)) - 1 as u64)) != 0 as u64;
  } else if (shift == 128) {
    round = (hi >> 63 as u64) == 1 as u64;
    below = lo != 0 as u64 || (hi << 1 as u64) != 0 as u64;
  }
  if (round && (below || (q & 1 as u64) == 1 as u64)) {
    if (q == none) {
      return none;
    }
    q = q + 1 as u64;
  }
  return q;
}

// 10^k for k up to 19.
function pow10_u64(k: i32): u64 {
  var p: u64 = 1 as u64;
  var i: i32 = 0;
  while (i < k) {
    p = p * 10 as u64;
    i = i + 1;
  }
  return p;
}

// `q` written with its last `prec` digits after the point, zero-padded
// to at least one digit before it, and a sign in front.
function fixed_u64(q: u64, prec: i32, neg: boolean): string {
  var digits: i32 = 1;
  var t: u64 = q / 10 as u64;
  while (t > 0 as u64) {
    digits = digits + 1;
    t = t / 10 as u64;
  }
  var whole: i32 = digits - prec;
  if (whole < 1) {
    whole = 1;
  }
  var n: i32 = whole;
  if (prec > 0) {
    n = n + 1 + prec;
  }
  var start: i32 = 0;
  if (neg) {
    start = 1;
  }
  var out: u8[] = __alloc_u8(start + n);
  if (neg) {
    out = out.with(0, 45 as u8);
  }
  var i: i32 = start + n - 1;
  var rest: u64 = q;
  var k: i32 = 0;
  while (k < prec) {
    out = out.with(i, ((rest % 10 as u64) as i32 + 48) as u8);
    rest = rest / 10 as u64;
    i = i - 1;
    k = k + 1;
  }
  if (prec > 0) {
    out = out.with(i, 46 as u8);
    i = i - 1;
  }
  while (i >= start) {
    out = out.with(i, ((rest % 10 as u64) as i32 + 48) as u8);
    rest = rest / 10 as u64;
    i = i - 1;
  }
  return string_from_bytes_unchecked(out);
}

// `to_g(f, v)` — `printf("%Lg", v)`: six significant digits, exponent
// form below -4 or from 6 up, trailing zeros dropped.
pub function (f: Format) to_g(v: LD): string {
  return sign_of(v) + general(v.dec(), 6 as i64, false, false, 0 as i64).s;
}

function sign_of(v: LD): string {
  if (v.neg) {
    return "-";
  }
  return "";
}

// ---- %a ---------------------------------------------------------------------
// `hex(f, v, prec, alt)` — the `%a` body of a finite `v`: the
// significand in hex, then `p` and the binary exponent, all lowercase
// and with no `0x` in front (the caller writes the prefix and
// upper-cases the whole thing for `%A`).
//
// The format decides the shape. With the integer bit stored the point
// sits four bits down, so the leading digit runs 8..f and 1 prints as
// `8p-3`; with it implied the leading digit is that single bit and 1
// prints as `1p+0`. Either way the digits below the point are the rest
// of the significand and the exponent is the one that point implies —
// which for a subnormal, whose `e` is pinned at the format's least,
// comes out as the least normal's exponent, the same way glibc prints
// one. Zero is the exception both formats share: `0p+0`.
//
// `prec` is the requested fraction digit count, or -1 for as many as
// the value needs with trailing zeros dropped. Rounding is half to even
// in hex, and a carry out of the top digit lifts the leading one — past
// f it renormalises four binades up, which only a stored integer bit
// can reach.
pub function (f: Format) hex(v: LD, prec: i64, alt: boolean): string {
  var shift: i32 = hex_shift(f);
  var nd: i32 = shift / 4;
  var lead: i32 = 0;
  var frac: u8[] = __alloc_u8(nd);
  var pe: i32 = 0;
  if (!v.is_zero()) {
    lead = nibble_at(v, shift);
    var i: i32 = 0;
    while (i < nd) {
      frac = frac.with(i, hex_char(nibble_at(v, shift - 4 * (i + 1))) as u8);
      i = i + 1;
    }
    pe = v.e + shift;
  } else {
    var z: i32 = 0;
    while (z < nd) {
      frac = frac.with(z, 48 as u8);
      z = z + 1;
    }
  }
  var keep: i32 = nd;
  if (prec >= 0 as i64 && prec < nd as i64) {
    keep = prec as i32;
    var rd: i32 = hex_digit(frac[keep] as i32);
    var rest: boolean = false;
    var k: i32 = keep + 1;
    while (k < nd) {
      if (frac[k] as i32 != 48) {
        rest = true;
      }
      k = k + 1;
    }
    var last_odd: boolean = lead % 2 == 1;
    if (keep > 0) {
      last_odd = hex_digit(frac[keep - 1] as i32) % 2 == 1;
    }
    if (rd > 8 || rd == 8 && (rest || last_odd)) {
      var j: i32 = keep - 1;
      var carry: boolean = true;
      while (j >= 0 && carry) {
        var dv: i32 = hex_digit(frac[j] as i32) + 1;
        if (dv == 16) {
          frac = frac.with(j, 48 as u8);
        } else {
          frac = frac.with(j, hex_char(dv) as u8);
          carry = false;
        }
        j = j - 1;
      }
      if (carry) {
        lead = lead + 1;
        if (lead == 16) {
          lead = 1;
          pe = pe + 4;
        }
      }
    }
  } else if (prec < 0 as i64) {
    while (keep > 0 && frac[keep - 1] as i32 == 48) {
      keep = keep - 1;
    }
  }
  var digits: string = slice_unchecked(string_from_bytes_unchecked(frac), 0, keep) + "";
  if (prec > nd as i64) {
    digits = digits + "0".repeat(prec as i32 - nd);
  }
  var body: string = string_from_bytes_unchecked([hex_char(lead) as u8]);
  if (digits.len() > 0 || alt) {
    body = body + "." + digits;
  }
  var ps: string = "p";
  if (pe < 0) {
    ps = ps + "-" + ((0 - pe) as i64).to_string();
  } else {
    ps = ps + "+" + (pe as i64).to_string();
  }
  return body + ps;
}

// The four bits of the significand starting at bit `at`.
function nibble_at(v: LD, at: i32): i32 {
  return (shr_lo(v.hi, v.lo, at) & 15 as u64) as i32;
}
