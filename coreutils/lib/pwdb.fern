// coreutils/lib/pwdb.fern — /etc/passwd and /etc/group, as glibc's
// `files` backend reads them.
//
// `whoami`, `id`, `groups` and `logname` all turn ids into names and
// names into ids, and GNU does it through NSS. This module is the
// `files` source of that lookup and nothing else: no nsswitch.conf, no
// dlopened modules, no LDAP. On a machine whose users come from
// somewhere else the answers differ, which is the same boundary
// lib/resolv.fern draws for hosts.
//
// The rules that are not obvious and are all observable:
//
//   - The FIRST matching line wins, and a malformed line is skipped
//     rather than fatal — a line with fewer than four colon-separated
//     fields, or a uid field that is not a plain decimal, is simply not
//     an entry. That is what the files backend does, and it is why a
//     truncated passwd file degrades to "no such user" instead of an
//     error.
//   - A number that names no entry is NOT an entry. GNU prints the
//     number instead of a name in the composite `id` line, and says
//     `cannot find name for user ID N` where a name is what was asked
//     for; both are the caller's decision, so the lookups here answer
//     Option and never invent a name.
//   - `group_list` is getgrouplist(3): the primary gid FIRST, then every
//     /etc/group line naming the user as a member, in FILE order, with
//     duplicates removed keeping the first. The order is visible in
//     `id -G` and in `groups`.
//
// On Darwin the files are not the database: regular accounts and groups
// live in Directory Services, and even root differs there (its shell is
// /bin/bash, where /etc/passwd says /bin/sh). There every lookup below asks
// libSystem first through `__account_entry` and reads the files only when
// it has no answer (#9815); everywhere else the files are the database.
//
// The files are read as BYTES. A GECOS field in some 8-bit encoding is
// legal and common, and `read_file` rejects it as invalid UTF-8, which
// would turn a real user into "no such user".
import "std/string";
import "std/array";

// One /etc/passwd entry. The password field is the only one nothing
// here reads: it is an `x` on every system with a shadow file, and the
// hash on one without, and neither is any of these utilities' business.
//
// `gecos` is the field finger calls the real name, and it is a
// comma-separated list whose first element is the name (`full_name`
// below); `dir` is where `pinky -l` looks for the project and plan
// files. A line with fewer fields than these leaves the tail empty
// rather than failing to be an entry.
pub struct User { name: string, uid: i64, gid: i64, gecos: string, dir: string, shell: string }

// One /etc/group entry: the gid and the name. `members` is not carried —
// the only consumer walks the file itself (see `group_list`).
pub struct Group { gid: i64, name: string }

// Whole-file read that answers "" for a file that is missing or
// unreadable, which is how a lookup with no database behaves: nothing
// matches. Bytes, not text — see the header.
function slurp(path: string): string {
  match (read_file_bytes(path)) {
    Ok(bs) => {
      return string_from_bytes_unchecked(bs);
    },
    Err(_) => {
      return "";
    }
  }
}

pub function passwd_path(): string {
  return "/etc/passwd";
}

pub function group_path(): string {
  return "/etc/group";
}

// A field's value as a non-negative decimal, or None. The files backend
// accepts digits and nothing else here — no sign, no blanks, no empty
// field — and a line whose id field is anything else is not an entry.
pub function parse_id(s: string): Option[i64] {
  if (s.len() == 0) {
    return None;
  }
  let v: i64 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c < 48 || c > 57) {
      return None;
    }
    v = v * (10 as i64) + (c - 48) as i64;
    if (v > 4294967295 as i64) {
      return None;
    }
    i = i + 1;
  }
  return Some(v);
}

// One /etc/passwd line as a User, or None when it is not an entry:
// a comment, a blank line, too few fields, or a non-decimal id.
function passwd_entry(line: string): Option[User] {
  if (line.len() == 0) {
    return None;
  }
  let f: string[] = line.split(":");
  if (f.len() < 4) {
    return None;
  }
  match (parse_id(f[2])) {
    Some(uid) => {
      match (parse_id(f[3])) {
        Some(gid) => {
          return Some(User { name: f[0], uid: uid, gid: gid, gecos: field(f, 4), dir: field(f, 5), shell: field(f, 6) });
        },
        None => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
}

// A field that may not be there: a truncated line is still an entry,
// with nothing where the missing fields would be.
function field(f: string[], i: i32): string {
  if (i < f.len()) {
    return f[i];
  }
  return "";
}

// `(u: User) full_name()` — the gecos field as finger reads it: up to
// the first comma, with `&` standing for the login name with its first
// letter capitalised. The convention is older than /etc/passwd's other
// uses of the field and it is what `pinky` prints as the real name.
pub function (u: User) full_name(): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < u.gecos.len()) {
    let c: i32 = u.gecos[i] as i32;
    if (c == 44) {
      return out;
    }
    if (c == 38) {
      out = out + capitalised(u.name);
    } else {
      out = out + slice_unchecked(u.gecos, i, i + 1);
    }
    i = i + 1;
  }
  return out;
}

function capitalised(name: string): string {
  if (name.len() == 0) {
    return name;
  }
  let first: string = slice_unchecked(name, 0, 1) + "";
  return first.to_ascii_upper() + slice_unchecked(name, 1, name.len());
}

// One /etc/group line as a Group plus its member list, or None.
function group_entry(line: string): Option[(Group, string)] {
  if (line.len() == 0) {
    return None;
  }
  let f: string[] = line.split(":");
  if (f.len() < 3) {
    return None;
  }
  match (parse_id(f[2])) {
    Some(gid) => {
      let members: string = "";
      if (f.len() > 3) {
        members = f[3];
      }
      return Some((Group { gid: gid, name: f[0] }, members));
    },
    None => {
      return None;
    }
  }
}

// The first /etc/passwd entry with this name.
pub function user_by_name(name: string): Option[User] {
  return user_by_name_in(slurp(passwd_path()), name);
}

// The lookups over a passwd / group file's TEXT rather than its path.
// The database is a file the tests cannot write, so the parse is
// reachable on its own: `tests/stdlib/coreutils_pwdb_test.fern` drives
// these with fixtures for the rules the machine happens not to show —
// a malformed line, a duplicate name, a gid no group entry claims.
pub function user_by_name_in(text: string, name: string): Option[User] {
  match (account_user_named(name)) {
    Some(u) => {
      return Some(u);
    },
    None => {}
  }
  let lines: string[] = text.lines();
  let i: i32 = 0;
  while (i < lines.len()) {
    match (passwd_entry(lines[i])) {
      Some(u) => {
        if (u.name == name) {
          return Some(u);
        }
      },
      None => {}
    }
    i = i + 1;
  }
  return None;
}

// The first /etc/group entry with this name. The inverse of group_name,
// and the direction `chgrp GROUP` and `chown :GROUP` need: a name on the
// command line has to become the gid the kernel is handed.
pub function group_by_name(name: string): Option[Group] {
  return group_by_name_in(slurp(group_path()), name);
}

pub function group_by_name_in(text: string, name: string): Option[Group] {
  match (account_group_named(name)) {
    Some(g) => {
      return Some(g);
    },
    None => {}
  }
  let lines: string[] = text.lines();
  let i: i32 = 0;
  while (i < lines.len()) {
    match (group_entry(lines[i])) {
      Some(pair) => {
        if (pair.0.name == name) {
          return Some(pair.0);
        }
      },
      None => {}
    }
    i = i + 1;
  }
  return None;
}

// The first /etc/passwd entry with this uid.
pub function user_by_uid(uid: i64): Option[User] {
  return user_by_uid_in(slurp(passwd_path()), uid);
}

pub function user_by_uid_in(text: string, uid: i64): Option[User] {
  match (account_user_id(uid)) {
    Some(u) => {
      return Some(u);
    },
    None => {}
  }
  let lines: string[] = text.lines();
  let i: i32 = 0;
  while (i < lines.len()) {
    match (passwd_entry(lines[i])) {
      Some(u) => {
        if (u.uid == uid) {
          return Some(u);
        }
      },
      None => {}
    }
    i = i + 1;
  }
  return None;
}

// The user name for `uid`.
pub function user_name(uid: i64): Option[string] {
  return user_name_in(slurp(passwd_path()), uid);
}

pub function user_name_in(text: string, uid: i64): Option[string] {
  match (user_by_uid_in(text, uid)) {
    Some(u) => {
      return Some(u.name);
    },
    None => {
      return None;
    }
  }
}

// The two databases as TEXT, for a caller that looks up more than once. Every
// lookup below that takes a path re-reads the whole file, which is right for a
// utility asking once and quadratic for one asking per entry — `chown -Rv`
// over a tree names an owner and a group on every line.
pub function passwd_text(): string {
  return slurp(passwd_path());
}

pub function group_text(): string {
  return slurp(group_path());
}

// The first /etc/group entry with this gid, as a name, over already-read text.
pub function group_name_in(text: string, gid: i64): Option[string] {
  let names: Option[string][] = group_names_in(text, [gid]);
  return names[0];
}

// The first /etc/group entry with this gid, as a name.
pub function group_name(gid: i64): Option[string] {
  let names: Option[string][] = group_names([gid]);
  return names[0];
}

// Every gid's name, resolved in ONE pass over /etc/group. `id` and
// `groups` name a whole list at once, and a lookup per gid would re-read
// the file per element — quadratic in the group count on the one path
// these utilities spend their time in.
pub function group_names(gids: i64[]): Option[string][] {
  return group_names_in(slurp(group_path()), gids);
}

pub function group_names_in(text: string, gids: i64[]): Option[string][] {
  let out: Option[string][] = [];
  let k: i32 = 0;
  while (k < gids.len()) {
    out = out.append(None);
    k = k + 1;
  }
  if (gids.len() == 0) {
    return out;
  }
  k = 0;
  while (k < gids.len()) {
    match (account_group_id(gids[k])) {
      Some(g) => {
        out = out.with(k, Some(g.name));
      },
      None => {}
    }
    k = k + 1;
  }
  let lines: string[] = text.lines();
  let i: i32 = 0;
  while (i < lines.len()) {
    match (group_entry(lines[i])) {
      Some(e) => {
        let j: i32 = 0;
        while (j < gids.len()) {
          if (gids[j] == e.0.gid) {
            // The FIRST line with a gid wins, so a later duplicate
            // never overwrites what an earlier one named.
            match (out[j]) {
              Some(_) => {},
              None => {
                out = out.with(j, Some(e.0.name));
              }
            }
          }
          j = j + 1;
        }
      },
      None => {}
    }
    i = i + 1;
  }
  return out;
}

// Whether `name` appears in a comma-separated member list.
function has_member(members: string, name: string): boolean {
  if (members.len() == 0) {
    return false;
  }
  let start: i32 = 0;
  let i: i32 = 0;
  while (i <= members.len()) {
    if (i == members.len() || members[i] as i32 == 44) {
      if (i - start == name.len()) {
        let same: boolean = true;
        let k: i32 = 0;
        while (k < name.len()) {
          if (members[start + k] != name[k]) {
            same = false;
            k = name.len();
          }
          k = k + 1;
        }
        if (same) {
          return true;
        }
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return false;
}

// getgrouplist(name, gid): the primary gid first, then every /etc/group
// line naming `name` as a member, in file order, deduped keeping the
// first occurrence. This is what `id -G USER` and `groups USER` print,
// and the order is part of the output.
pub function group_list(name: string, gid: i64): i64[] {
  return group_list_in(slurp(group_path()), name, gid);
}

pub function group_list_in(text: string, name: string, gid: i64): i64[] {
  match (account_group_list(name, gid)) {
    Some(gids) => {
      return gids;
    },
    None => {}
  }
  let out: i64[] = [gid];
  let lines: string[] = text.lines();
  let i: i32 = 0;
  while (i < lines.len()) {
    match (group_entry(lines[i])) {
      Some(e) => {
        if (has_member(e.1, name) && !contains_gid(out, e.0.gid)) {
          out = out.append(e.0.gid);
        }
      },
      None => {}
    }
    i = i + 1;
  }
  return out;
}

pub function contains_gid(gids: i64[], gid: i64): boolean {
  let i: i32 = 0;
  while (i < gids.len()) {
    if (gids[i] == gid) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// The group set of the CURRENT process, as gnulib's mgetgroups builds
// it: the effective gid prepended to getgroups(2)'s answer, then
// duplicates removed keeping the first.
//
// The prepend is not conditional on the gid being absent — it goes to
// the FRONT and the later copy is what the dedupe drops, which is why
// a process whose egid is 27 and whose supplementary set is [4, 27]
// reports `27 4` rather than `4 27`.
pub function process_groups(): i64[] {
  let out: i64[] = [getegid() as i64];
  let gs: i64[] = getgroups();
  let i: i32 = 0;
  while (i < gs.len()) {
    if (!contains_gid(out, gs[i])) {
      out = out.append(gs[i]);
    }
    i = i + 1;
  }
  return out;
}

// ---- names, remembered ------------------------------------------------------
// Every lookup above that takes a path re-reads its file, which is right for
// a utility asking once and quadratic for one asking per entry: `ls -l` and
// `stat` over four thousand files name an owner and a group on every one.
// `Names` reads each database once, on construction and only when a caller
// will print that column, and remembers every id it has answered: a listing
// has one owner and one group in practice, so a lookup is a short scan and
// the parse happens once per DISTINCT id. An id the database has no name for
// answers its digits, which is what both utilities print for an orphaned
// file.
pub struct Names { want_user: boolean, want_group: boolean, passwd: string, group: string, uids: i64[], users: string[], gids: i64[], groups: string[] }

pub function names_new(want_user: boolean, want_group: boolean): Names {
  let passwd: string = "";
  if (want_user) {
    passwd = passwd_text();
  }
  let group: string = "";
  if (want_group) {
    group = group_text();
  }
  return Names { want_user: want_user, want_group: want_group, passwd: passwd, group: group, uids: [], users: [], gids: [], groups: [] };
}

pub function (n: Names) user(uid: i64): (string, Names) {
  if (!n.want_user) {
    return (uid.to_string(), n);
  }
  let i: i32 = 0;
  while (i < n.uids.len()) {
    if (n.uids[i] == uid) {
      return (n.users[i], n);
    }
    i = i + 1;
  }
  let name: string = uid.to_string();
  match (user_name_in(n.passwd, uid)) {
    Some(found) => {
      name = found;
    },
    None => {}
  }
  return (name, Names { ...n, uids: n.uids.append(uid), users: n.users.append(name) });
}

pub function (n: Names) group(gid: i64): (string, Names) {
  if (!n.want_group) {
    return (gid.to_string(), n);
  }
  let i: i32 = 0;
  while (i < n.gids.len()) {
    if (n.gids[i] == gid) {
      return (n.groups[i], n);
    }
    i = i + 1;
  }
  let name: string = gid.to_string();
  match (group_name_in(n.group, gid)) {
    Some(found) => {
      name = found;
    },
    None => {}
  }
  return (name, Names { ...n, gids: n.gids.append(gid), groups: n.groups.append(name) });
}

// ---- libSystem's answer -----------------------------------------------------
// `__account_entry(kind, key)` is what libSystem answers, or 0: kind 0 is
// getpwuid(key), 1 getpwnam(key), 2 getgrgid(key), 3 getgrnam(key), 4
// getlogin(), 5 getgrouplist over an argument block, 6 strerror(key) and 7
// __error(); a name goes in as a C string. The entries are Darwin's
// `struct passwd` and `struct group`, read field by field before the next
// call reuses them. Only Darwin is asked: everywhere else the files are the
// whole database.

function darwin(): boolean {
  return target_os() == "darwin";
}

// The login name the kernel holds for this session: getlogin(2), which is
// where Darwin's logname answers from.
pub function session_login(): Option[string] {
  if (!darwin()) {
    return None;
  }
  let p: usize = __account_entry(4, 0 as usize);
  if (p == 0 as usize) {
    return None;
  }
  return Some(c_string(p));
}

function account_user_id(uid: i64): Option[User] {
  if (!darwin() || uid < 0 as i64 || uid > 4294967295 as i64) {
    return None;
  }
  return account_user(__account_entry(0, uid as usize));
}

function account_user_named(name: string): Option[User] {
  if (!darwin()) {
    return None;
  }
  let key: usize = cstr_key(name);
  let u: Option[User] = account_user(__account_entry(1, key));
  __free(key, name.len() + 1);
  return u;
}

function account_group_id(gid: i64): Option[Group] {
  if (!darwin() || gid < 0 as i64 || gid > 4294967295 as i64) {
    return None;
  }
  return account_group(__account_entry(2, gid as usize));
}

function account_group_named(name: string): Option[Group] {
  if (!darwin()) {
    return None;
  }
  let key: usize = cstr_key(name);
  let g: Option[Group] = account_group(__account_entry(3, key));
  __free(key, name.len() + 1);
  return g;
}

// getgrouplist(3): the base gid and every group Directory Services counts
// the user in, nested ones included. Darwin answers -1 without saying how
// many there are when the buffer is short, so it doubles until they fit.
function account_group_list(name: string, gid: i64): Option[i64[]] {
  if (!darwin() || gid < 0 as i64 || gid > 4294967295 as i64) {
    return None;
  }
  let key: usize = cstr_key(name);
  let block: usize = __alloc(32);
  let count: usize = __alloc(8);
  let cap: i32 = 64;
  let out: Option[i64[]] = None;
  while (cap <= 65536) {
    let buf: usize = __alloc(cap * 4);
    __store_ptr(block, key);
    __store_i64(block + 8 as usize, gid);
    __store_ptr(block + 16 as usize, buf);
    __store_ptr(block + 24 as usize, count);
    __store_i64(count, cap as i64);
    let rc: i64 = __account_entry(5, block) as i64 & 4294967295 as i64;
    if (rc != 4294967295 as i64) {
      let gids: i64[] = [];
      let n: i32 = __load_i32(count);
      let i: i32 = 0;
      while (i < n && i < cap) {
        gids = gids.append(id_at(buf + (i * 4) as usize));
        i = i + 1;
      }
      out = Some(gids);
      __free(buf, cap * 4);
      break;
    }
    __free(buf, cap * 4);
    cap = cap * 2;
  }
  __free(count, 8);
  __free(block, 32);
  __free(key, name.len() + 1);
  return out;
}

// The strerror text for the errno the last failed lookup left, or "" when it
// left none. Only Darwin's lookups set one: there GNU's `no such user` carries
// it, and glibc's files backend reports a missing entry with errno 0.
pub function lookup_failure_text(): string {
  if (!darwin()) {
    return "";
  }
  let at: usize = __account_entry(7, 0 as usize);
  if (at == 0 as usize) {
    return "";
  }
  let e: i32 = __load_i32(at);
  if (e == 0) {
    return "";
  }
  return c_string(__account_entry(6, e as usize));
}

function account_user(p: usize): Option[User] {
  if (p == 0 as usize) {
    return None;
  }
  return Some(User { name: c_string(__load_ptr(p)), uid: id_at(p + 16 as usize), gid: id_at(p + 20 as usize), gecos: c_string(__load_ptr(p + 40 as usize)), dir: c_string(__load_ptr(p + 48 as usize)), shell: c_string(__load_ptr(p + 56 as usize)) });
}

function account_group(p: usize): Option[Group] {
  if (p == 0 as usize) {
    return None;
  }
  return Some(Group { gid: id_at(p + 16 as usize), name: c_string(__load_ptr(p)) });
}

// A uid_t or gid_t: unsigned, so nobody's 4294967294 is not -2.
function id_at(at: usize): i64 {
  let v: i64 = __load_i32(at) as i64;
  if (v < 0 as i64) {
    return v + 4294967296 as i64;
  }
  return v;
}

// `name` as a NUL-terminated copy of `name.len() + 1` bytes.
function cstr_key(name: string): usize {
  let p: usize = __alloc(name.len() + 1);
  let i: i32 = 0;
  while (i < name.len()) {
    __store_u8(p + i as usize, name[i] as i32);
    i = i + 1;
  }
  __store_u8(p + name.len() as usize, 0);
  return p;
}

function c_string(p: usize): string {
  if (p == 0 as usize) {
    return "";
  }
  let bs: u8[] = [];
  let at: usize = p;
  while (__load_u8(at) != 0) {
    bs = bs.append(__load_u8(at) as u8);
    at = at + 1 as usize;
  }
  return string_from_bytes_unchecked(bs);
}
