// coreutils/lib/fnmatch.fern — fnmatch(3) with flags 0, the pattern
// matcher two utilities here need: `dircolors` validates the patterns
// of its database with it, and `ls` matches a name against `-I` and
// `--hide`.
//
// `std/glob` is NOT this. There `*` stops at `/`, `**` means something,
// and a backslash escapes nothing; fnmatch with no flags has no path
// awareness at all and a backslash quotes the byte after it.
//
// It is NOT what `ls --color` does with an LS_COLORS `*pattern` either
// — that is a case-folded literal SUFFIX comparison, so `*a?c` there
// colours the file actually called `a?c`.
// Share the matcher while specializing text and borrowed-byte reads.
// The borrowed wrapper stays within fnmatch_bytes and never escapes it.
trait ByteInput {
  function byte_count(self: Self): i32;
  function byte_at(self: Self, at: i32): u8;
}

impl ByteInput for string {
  function byte_count(self: string): i32 {
    return self.len();
  }
  function byte_at(self: string, at: i32): u8 {
    return self[at];
  }
}

struct BytesInput { data: [u8] }

// Retain one raw input and its bounds for patterns matched many times.
// The range owns its input, so callers may release the original array.
pub struct BytePattern { data: u8[], lo: i32, hi: i32 }

impl ByteInput for BytePattern {
  function byte_count(self: BytePattern): i32 {
    return self.hi - self.lo;
  }
  function byte_at(self: BytePattern, at: i32): u8 {
    return self.data[self.lo + at];
  }
}

pub function (pat: BytePattern) matches(text: string): boolean {
  return fn_match(pat, 0, text, 0) > 0;
}

impl ByteInput for BytesInput {
  function byte_count(self: BytesInput): i32 {
    return self.data.len();
  }
  function byte_at(self: BytesInput, at: i32): u8 {
    return self.data[at];
  }
}

// Byte-wise in the C locale, and none of the FNM_* flags are set: `*`
// and `?` cross `/`, a leading `.` is not special, and a backslash
// escapes the byte after it.
//
// Two malformed shapes are worth naming because they part ways. A
// bracket with no closing `]` is NOT an error — glibc restarts the
// match with the `[` taken as an ordinary byte, so `[[:digit:]` against
// `[d` matches (a literal `[`, then a bracket holding `:digit`). A
// character class or collating symbol that is not one IS an error, and
// the whole match fails however the bracket is negated. A pattern
// ending in a lone backslash matches nothing.
function fn_is_space(c: i32): boolean {
  return c == 32 || c >= 9 && c <= 13;
}

// Class names are ASCII. Compare the raw pattern range without constructing
// text from bytes that may not be valid UTF-8.
function fn_name[P: ByteInput](p: P, lo: i32, hi: i32, expected: string): boolean {
  if (hi - lo != expected.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < expected.len()) {
    if (p.byte_at(lo + i) != expected[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function fn_verdict(hit: boolean): i32 {
  if (hit) {
    return 1;
  }
  return 0;
}

// Status is 1 for a match, 0 for a miss and -1 for an unknown class.
// An unknown class invalidates the whole pattern, even inside a negation.
function fn_class[P: ByteInput](p: P, lo: i32, hi: i32, c: i32): i32 {
  let alpha: boolean = c >= 65 && c <= 90 || c >= 97 && c <= 122;
  let digit: boolean = c >= 48 && c <= 57;
  if (fn_name(p, lo, hi, "alpha")) {
    return fn_verdict(alpha);
  }
  if (fn_name(p, lo, hi, "digit")) {
    return fn_verdict(digit);
  }
  if (fn_name(p, lo, hi, "alnum")) {
    return fn_verdict(alpha || digit);
  }
  if (fn_name(p, lo, hi, "upper")) {
    return fn_verdict(c >= 65 && c <= 90);
  }
  if (fn_name(p, lo, hi, "lower")) {
    return fn_verdict(c >= 97 && c <= 122);
  }
  if (fn_name(p, lo, hi, "space")) {
    return fn_verdict(fn_is_space(c));
  }
  if (fn_name(p, lo, hi, "blank")) {
    return fn_verdict(c == 32 || c == 9);
  }
  if (fn_name(p, lo, hi, "print")) {
    return fn_verdict(c >= 32 && c <= 126);
  }
  if (fn_name(p, lo, hi, "graph")) {
    return fn_verdict(c > 32 && c <= 126);
  }
  if (fn_name(p, lo, hi, "punct")) {
    return fn_verdict(c > 32 && c <= 126 && !alpha && !digit);
  }
  if (fn_name(p, lo, hi, "cntrl")) {
    return fn_verdict(c < 32 || c == 127);
  }
  if (fn_name(p, lo, hi, "xdigit")) {
    return fn_verdict(digit || c >= 65 && c <= 70 || c >= 97 && c <= 102);
  }
  return 0 - 1;
}

// One bracket expression starting at `p.byte_at(i)` (the `[`), matched against
// byte ch. A positive result is the next pattern index after a match;
// zero means no match, -1 invalid, and -2 an unclosed bracket that must
// be treated as a literal opening bracket.
function fn_bracket[P: ByteInput](p: P, start: i32, ch: i32): i32 {
  let n: i32 = p.byte_count();
  let i: i32 = start + 1;
  let negate: boolean = false;
  if (i < n && (p.byte_at(i) as i32 == 33 || p.byte_at(i) as i32 == 94)) {
    negate = true;
    i = i + 1;
  }
  let hit: boolean = false;
  let first: boolean = true;
  while (true) {
    if (i >= n) {
      return 0 - 2;
    }
    let c: i32 = p.byte_at(i) as i32;
    if (c == 93 && !first) {
      i = i + 1;
      break;
    }
    first = false;
    // GNU uses gnulib's non-glibc matcher on Darwin. Only character
    // classes are special there: `[.x.]` and `[=x=]` remain ordinary
    // bracket contents, including the first `]` ending that bracket.
    if (c == 91 && i + 1 < n && (p.byte_at(i + 1) as i32 == 58 || target_os() != "darwin" && (p.byte_at(i + 1) as i32 == 46 || p.byte_at(i + 1) as i32 == 61))) {
      let kind: i32 = p.byte_at(i + 1) as i32;
      let body: i32 = i + 2;
      let j: i32 = body;
      while (j + 1 < n && !(p.byte_at(j) as i32 == kind && p.byte_at(j + 1) as i32 == 93)) {
        j = j + 1;
      }
      if (j + 1 >= n) {
        return 0 - 1;
      }
      i = j + 2;
      if (kind == 58) {
        let cls: i32 = fn_class(p, body, j, ch);
        if (cls < 0) {
          return 0 - 1;
        }
        if (cls > 0) {
          hit = true;
        }
        continue;
      }
      // A collating symbol or an equivalence class is one byte in the
      // C locale; anything longer names nothing.
      if (j - body != 1) {
        return 0 - 1;
      }
      let lo: i32 = p.byte_at(body) as i32;
      // A `[.x.]` may open a range: `[[.a.]-c]`.
      let r: (i32, boolean) = fn_range(p, i, lo, ch, hit);
      i = r.0;
      hit = r.1;
      continue;
    }
    let lo2: i32 = c;
    if (c == 92) {
      if (i + 1 >= n) {
        return 0 - 2;
      }
      lo2 = p.byte_at(i + 1) as i32;
      i = i + 2;
    } else {
      i = i + 1;
    }
    let r2: (i32, boolean) = fn_range(p, i, lo2, ch, hit);
    i = r2.0;
    hit = r2.1;
  }
  if (negate) {
    hit = !hit;
  }
  if (hit) {
    return i;
  }
  return 0;
}

// `lo` has been read; if a `-` follows that is not the bracket's last
// byte, read the range's upper bound. Returns (next index, hit).
function fn_range[P: ByteInput](p: P, at: i32, lo: i32, ch: i32, hit: boolean): (i32, boolean) {
  let n: i32 = p.byte_count();
  let i: i32 = at;
  if (i + 1 < n && p.byte_at(i) as i32 == 45 && p.byte_at(i + 1) as i32 != 93) {
    let hi: i32 = p.byte_at(i + 1) as i32;
    i = i + 2;
    if (hi == 92 && i < n) {
      hi = p.byte_at(i) as i32;
      i = i + 1;
    }
    if (ch >= lo && ch <= hi) {
      return (i, true);
    }
    return (i, hit);
  }
  if (ch == lo) {
    return (i, true);
  }
  return (i, hit);
}

// pi and si are the cursors a star backtracks over. Invalid patterns
// stop retries; an ordinary mismatch advances the retry cursor. The result
// is 1 for a match, 0 for a miss and -1 for an invalid pattern.
function fn_match[P: ByteInput, S: ByteInput](p: P, pi0: i32, s: S, si0: i32): i32 {
  let pi: i32 = pi0;
  let si: i32 = si0;
  let pn: i32 = p.byte_count();
  let sn: i32 = s.byte_count();
  while (pi < pn) {
    let c: i32 = p.byte_at(pi) as i32;
    if (c == 42) {
      while (pi < pn && p.byte_at(pi) as i32 == 42) {
        pi = pi + 1;
      }
      if (pi >= pn) {
        return 1;
      }
      let k: i32 = si;
      while (k <= sn) {
        let r: i32 = fn_match(p, pi, s, k);
        if (r != 0) {
          return r;
        }
        k = k + 1;
      }
      return 0;
    }
    if (c == 63) {
      if (si >= sn) {
        return 0;
      }
      pi = pi + 1;
      si = si + 1;
      continue;
    }
    if (c == 92) {
      // A trailing backslash escapes nothing and matches nothing.
      if (pi + 1 >= pn) {
        return 0;
      }
      if (si >= sn || s.byte_at(si) as i32 != p.byte_at(pi + 1) as i32) {
        return 0;
      }
      pi = pi + 2;
      si = si + 1;
      continue;
    }
    if (c == 91) {
      if (si >= sn) {
        return 0;
      }
      let b: i32 = fn_bracket(p, pi, s.byte_at(si) as i32);
      if (b == 0 - 1) {
        return 0 - 1;
      }
      if (b == 0 - 2) {
        // Unterminated: the `[` is an ordinary byte from here on.
        if (s.byte_at(si) as i32 != 91) {
          return 0;
        }
        pi = pi + 1;
        si = si + 1;
        continue;
      }
      if (b == 0) {
        return 0;
      }
      pi = b;
      si = si + 1;
      continue;
    }
    if (si >= sn || s.byte_at(si) as i32 != c) {
      return 0;
    }
    pi = pi + 1;
    si = si + 1;
  }
  return fn_verdict(si == sn);
}

pub function fnmatch(pat: string, s: string): boolean {
  return fn_match(pat, 0, s, 0) > 0;
}

// Match borrowed bytes without copying or interpreting them as UTF-8.
pub function fnmatch_bytes(pat: [u8], s: [u8]): boolean {
  let r: i32 = fn_match(BytesInput { data: pat }, 0, BytesInput { data: s }, 0);
  return r > 0;
}

// A raw configuration pattern can match an existing text value without
// wrapping that value in a second byte-input record.
pub function fnmatch_bytes_text(pat: [u8], s: string): boolean {
  return fn_match(BytesInput { data: pat }, 0, s, 0) > 0;
}
