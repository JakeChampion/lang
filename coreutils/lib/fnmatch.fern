trait ByteInput {
  function byte_count(self: Self): i32;
  function byte_at(self: Self, at: i32): u8;
}

impl ByteInput for string {
  function byte_count(self: string): i32 {
    return self.len();
  }
  function byte_at(self: string, at: i32): u8 {
    return self[at];
  }
}

struct BytesInput { data: [u8] }

pub struct BytePattern { data: u8[], lo: i32, hi: i32 }

impl ByteInput for BytePattern {
  function byte_count(self: BytePattern): i32 {
    return self.hi - self.lo;
  }
  function byte_at(self: BytePattern, at: i32): u8 {
    return self.data[self.lo + at];
  }
}

pub function (pat: BytePattern) matches(text: string): boolean {
  return fn_match(pat, 0, text, 0, false) > 0;
}

impl ByteInput for BytesInput {
  function byte_count(self: BytesInput): i32 {
    return self.data.len();
  }
  function byte_at(self: BytesInput, at: i32): u8 {
    return self.data[at];
  }
}

function fn_is_space(c: i32): boolean {
  return c == 32 || c >= 9 && c <= 13;
}

function fn_name[P: ByteInput](p: P, lo: i32, hi: i32, expected: string): boolean {
  if (hi - lo != expected.len()) {
    return false;
  }
  let i = 0;
  while (i < expected.len()) {
    if (p.byte_at(lo + i) != expected[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

function fn_verdict(hit: boolean): i32 {
  if (hit) {
    return 1;
  }
  return 0;
}

function fn_class[P: ByteInput](p: P, lo: i32, hi: i32, c: i32): i32 {
  let alpha = c >= 65 && c <= 90 || c >= 97 && c <= 122;
  let digit = c >= 48 && c <= 57;
  if (fn_name(p, lo, hi, "alpha")) {
    return fn_verdict(alpha);
  }
  if (fn_name(p, lo, hi, "digit")) {
    return fn_verdict(digit);
  }
  if (fn_name(p, lo, hi, "alnum")) {
    return fn_verdict(alpha || digit);
  }
  if (fn_name(p, lo, hi, "upper")) {
    return fn_verdict(c >= 65 && c <= 90);
  }
  if (fn_name(p, lo, hi, "lower")) {
    return fn_verdict(c >= 97 && c <= 122);
  }
  if (fn_name(p, lo, hi, "space")) {
    return fn_verdict(fn_is_space(c));
  }
  if (fn_name(p, lo, hi, "blank")) {
    return fn_verdict(c == 32 || c == 9);
  }
  if (fn_name(p, lo, hi, "print")) {
    return fn_verdict(c >= 32 && c <= 126);
  }
  if (fn_name(p, lo, hi, "graph")) {
    return fn_verdict(c > 32 && c <= 126);
  }
  if (fn_name(p, lo, hi, "punct")) {
    return fn_verdict(c > 32 && c <= 126 && !alpha && !digit);
  }
  if (fn_name(p, lo, hi, "cntrl")) {
    return fn_verdict(c < 32 || c == 127);
  }
  if (fn_name(p, lo, hi, "xdigit")) {
    return fn_verdict(digit || c >= 65 && c <= 70 || c >= 97 && c <= 102);
  }
  return -1;
}

function fn_fold(c: i32, fold_case: boolean): i32 {
  return if (fold_case && c >= 65 && c <= 90) { c + 32 } else { c };
}

// Locate the end of [:name:], [.symbol.] or [=element=]. GNU fnmatch
// treats an impossible class name as an ordinary '[' (-2). A class name
// beyond CHARCLASS_NAME_MAX or an unfinished collating element fails (-1).
function fn_member_end[P: ByteInput](p: P, body: i32, kind: i32): i32 {
  let gnu_class = kind == 58 && target_os() != "darwin";
  let j = body;
  while (j < p.byte_count()) {
    if (gnu_class && j - body >= 2048) {
      return -1;
    }
    let c = p.byte_at(j);
    if (c as i32 == kind && j + 1 < p.byte_count() && p.byte_at(j + 1) == b']') {
      return j;
    }
    // The GNU scanner accepts class-name letters from 'a' through 'y'.
    if (gnu_class && (c < b'a' || c >= b'z')) {
      return -2;
    }
    j += 1;
  }
  return if (gnu_class) { -2 } else { -1 };
}

function fn_bracket[P: ByteInput](p: P, start: i32, ch: i32, fold_case: boolean): i32 {
  let n = p.byte_count();
  let i = start + 1;
  let negate = false;
  if (i < n && (p.byte_at(i) as i32 == 33 || p.byte_at(i) as i32 == 94)) {
    negate = true;
    i += 1;
  }
  let hit = false;
  let first = true;
  while (true) {
    if (i >= n) {
      return -2;
    }
    let c = p.byte_at(i) as i32;
    if (c == 93 && !first) {
      i += 1;
      break;
    }
    first = false;
    if (c == 91 && i + 1 < n && (p.byte_at(i + 1) as i32 == 58 || target_os() != "darwin" && (p.byte_at(i + 1) as i32 == 46 || p.byte_at(i + 1) as i32 == 61))) {
      let kind = p.byte_at(i + 1) as i32;
      let body = i + 2;
      let j = fn_member_end(p, body, kind);
      if (j == -2) {
        hit = hit || ch == 91;
        i += 1;
        continue;
      }
      if (j < 0) {
        return -1;
      }
      i = j + 2;
      if (kind == 58) {
        let cls = fn_class(p, body, j, ch);
        if (cls < 0) {
          return -1;
        }
        if (cls > 0) {
          hit = true;
        }
        continue;
      }
      if (j - body != 1) {
        return -1;
      }
      let lo = p.byte_at(body) as i32;
      if (i + 1 >= n || p.byte_at(i) != b'-' || p.byte_at(i + 1) == b']') {
        hit = hit || ch == lo;
        continue;
      }
      let r: (i32, boolean) = fn_range(p, i, lo, fn_fold(ch, fold_case), hit, fold_case);
      i = r.0;
      hit = r.1;
      continue;
    }
    let lo2 = c;
    if (c == 92) {
      if (i + 1 >= n) {
        return -2;
      }
      lo2 = p.byte_at(i + 1) as i32;
      i += 2;
    } else {
      i += 1;
    }
    let r2: (i32, boolean) = fn_range(p, i, fn_fold(lo2, fold_case), fn_fold(ch, fold_case), hit, fold_case);
    i = r2.0;
    hit = r2.1;
  }
  if (negate) {
    hit = !hit;
  }
  if (hit) {
    return i;
  }
  return 0;
}

function fn_range[P: ByteInput](p: P, at: i32, lo: i32, ch: i32, hit: boolean, fold_case: boolean): (i32, boolean) {
  let n = p.byte_count();
  let i = at;
  if (i + 1 < n && p.byte_at(i) as i32 == 45 && p.byte_at(i + 1) as i32 != 93) {
    let hi = p.byte_at(i + 1) as i32;
    i += 2;
    if (hi == 92 && i < n) {
      hi = p.byte_at(i) as i32;
      i += 1;
    }
    if (ch >= lo && ch <= fn_fold(hi, fold_case)) {
      return (i, true);
    }
    return (i, hit);
  }
  if (ch == lo) {
    return (i, true);
  }
  return (i, hit);
}

function fn_match[P: ByteInput, S: ByteInput](p: P, pi0: i32, s: S, si0: i32, fold_case: boolean): i32 {
  let pi = pi0;
  let si = si0;
  let pn = p.byte_count();
  let sn = s.byte_count();
  while (pi < pn) {
    let c = p.byte_at(pi) as i32;
    if (c == 42) {
      while (pi < pn && p.byte_at(pi) as i32 == 42) {
        pi += 1;
      }
      if (pi >= pn) {
        return 1;
      }
      let k = si;
      while (k <= sn) {
        let r = fn_match(p, pi, s, k, fold_case);
        if (r != 0) {
          return r;
        }
        k += 1;
      }
      return 0;
    }
    if (c == 63) {
      if (si >= sn) {
        return 0;
      }
      pi += 1;
      si += 1;
      continue;
    }
    if (c == 92) {
      if (pi + 1 >= pn) {
        return 0;
      }
      if (si >= sn || fn_fold(s.byte_at(si) as i32, fold_case) != fn_fold(p.byte_at(pi + 1) as i32, fold_case)) {
        return 0;
      }
      pi += 2;
      si += 1;
      continue;
    }
    if (c == 91) {
      if (si >= sn) {
        return 0;
      }
      let b = fn_bracket(p, pi, s.byte_at(si) as i32, fold_case);
      if (b == -1) {
        return -1;
      }
      if (b == -2) {
        if (s.byte_at(si) as i32 != 91) {
          return 0;
        }
        pi += 1;
        si += 1;
        continue;
      }
      if (b == 0) {
        return 0;
      }
      pi = b;
      si += 1;
      continue;
    }
    if (si >= sn || fn_fold(s.byte_at(si) as i32, fold_case) != fn_fold(c, fold_case)) {
      return 0;
    }
    pi += 1;
    si += 1;
  }
  return fn_verdict(si == sn);
}

pub function fnmatch(pat: string, s: string, fold_case: boolean = false): boolean {
  return fn_match(pat, 0, s, 0, fold_case) > 0;
}

pub function fnmatch_bytes(pat: [u8], s: [u8]): boolean {
  let r = fn_match(BytesInput { data: pat }, 0, BytesInput { data: s }, 0, false);
  return r > 0;
}

pub function fnmatch_bytes_text(pat: [u8], s: string): boolean {
  return fn_match(BytesInput { data: pat }, 0, s, 0, false) > 0;
}
