// base.fern — the one encoder and decoder `base64`, `base32` and
// `basenc` share.
//
// Every encoding basenc offers is the same machine with different
// numbers: `bits` bits per character, a block of `in_block` bytes
// standing for `out_block` characters, and either `=` padding of a
// short final block or none. z85 is the one that is not a bit codec —
// four bytes are a base-85 numeral of five digits — and it is a branch
// rather than a second implementation.
//
// The GNU behaviours reproduced here, each measured from the reference
// binary rather than read off the manual:
//
//   - Decoding ignores newlines and NOTHING else; `-i` widens that to
//     every byte outside the alphabet, but `=` survives the filter for
//     every encoding, base16 and base2 included, and then fails as an
//     invalid character.
//   - A group is validated left to right and the bytes it has already
//     completed are written before the fault is reported, so `AA=A`
//     writes one byte and then fails.
//   - Unpadded final groups are accepted when their length and unused bits
//     represent whole bytes. Once padding starts it must be complete:
//     incomplete base32 padding withholds the final group's bytes, while
//     base64 writes the bytes decoded before reporting the error.
//   - The character count a padded final block may carry is fixed by
//     the arithmetic: 2, 3 or 4 for base64 and 2, 4, 5, 7 or 8 for
//     base32. Anything else is `invalid input` even when every
//     character is in the alphabet.
//   - Encoding reads in 30 KiB blocks, which is what makes z85's
//     `length must be multiple of 4` observable: the whole blocks
//     before the short one are already on stdout when it fires.
//   - `-w` takes a signed decimal with glibc's leading blanks and sign;
//     a negative is an error, but a value past INTMAX_MAX is not — it
//     turns wrapping OFF, which is a different output from the largest
//     accepted value.
//
// The lookup tables are raw `__alloc` memory read with `__load_u8` /
// `__load_i32`; input and output buffers are byte arrays. A raw pointer
// INTO a counted buffer (`buf as usize`) is what a
// byte-at-a-time codec wants and is not available here: native reads
// that cast as the data pointer and the self-host as the box, so the two
// compilers would disagree about where the bytes are (#8799). A `u8[]`
// written with `.with()` is a third slower and is the same program under
// both.
import "std/string";
import "std/io_buffered";
import "./gnu";

// `Codec` — one encoding.
pub struct Codec { bits: i32, in_block: i32, out_block: i32, pad: boolean, rev: boolean, alpha: usize, alpha_bytes: i32, dec: usize }

// `Chars` — the characters one input block encodes to, packed one per
// byte with the first in the low byte. No block is more than eight
// characters, so they always fit.
struct Chars { v: i64, n: i32 }

// `Grp` — what one group of characters decodes to: the bytes packed
// big-endian, how many there are, and whether the group was valid. A
// fault still carries the bytes the group completed before it, which is
// what GNU writes before it reports.
struct Grp { v: i64, n: i32, ok: boolean }

// `block_bytes()` — the input block. GNU encodes 30 KiB at a time, a
// common multiple of every encoding's block (1, 3, 4 and 5), and z85's
// length error makes the number observable rather than internal: the
// bytes of every whole block before the short one are already written
// when it fires.
pub function block_bytes(): i32 {
  return 30720;
}

// The two lookup tables for an alphabet: value → character byte, and
// character byte → value (-1 for a byte outside the alphabet).
//
// The character table is written a byte at a time with `__store_i32`,
// whose upper three bytes the next entry overwrites; the trailing slack
// absorbs the last one.
function tables(alphabet: string): (usize, usize) {
  let n: i32 = alphabet.len();
  let a: usize = __alloc(n + 8);
  let d: usize = __alloc(256 * 4);
  let i: i32 = 0;
  while (i < 256) {
    __store_i32(d + (i * 4) as usize, 0 - 1);
    i = i + 1;
  }
  i = 0;
  while (i < n) {
    let ch: i32 = alphabet[i] as i32;
    __store_i32(a + i as usize, ch);
    __store_i32(d + (ch * 4) as usize, i);
    i = i + 1;
  }
  return (a, d);
}

function bit_codec(alphabet: string, bits: i32, in_block: i32, out_block: i32, pad: boolean, rev: boolean): Codec {
  let t: (usize, usize) = tables(alphabet);
  return Codec { bits: bits, in_block: in_block, out_block: out_block, pad: pad, rev: rev, alpha: t.0, alpha_bytes: alphabet.len() + 8, dec: t.1 };
}

// `also_decodes(c, extra)` — more characters the DECODER accepts,
// `extra[i]` standing for the alphabet's `i`th entry. base16 writes
// upper-case hex and, since 9.5, reads either.
function also_decodes(c: Codec, extra: string): Codec {
  let i: i32 = 0;
  while (i < extra.len()) {
    __store_i32(c.dec + (extra[i] as i32 * 4) as usize, i);
    i = i + 1;
  }
  return c;
}

pub function base64(): Codec {
  return bit_codec("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", 6, 3, 4, true, false);
}

pub function base64url(): Codec {
  return bit_codec("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", 6, 3, 4, true, false);
}

pub function base32(): Codec {
  return bit_codec("ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", 5, 5, 8, true, false);
}

pub function base32hex(): Codec {
  return bit_codec("0123456789ABCDEFGHIJKLMNOPQRSTUV", 5, 5, 8, true, false);
}

pub function base16(): Codec {
  return also_decodes(bit_codec("0123456789ABCDEF", 4, 1, 2, false, false), "0123456789abcdef");
}

pub function base2msbf(): Codec {
  return bit_codec("01", 1, 1, 8, false, false);
}

// base2lsbf differs from base2msbf only in which end of the byte the
// first character comes from, which for a one-byte block is the byte
// reversed. `rev` is that reversal, applied to the block on the way out
// and to the byte on the way back in.
pub function base2lsbf(): Codec {
  return bit_codec("01", 1, 1, 8, false, true);
}

// base58, the visually unambiguous alphabet (9.8): 0, O, I and l are
// absent so no two characters can be confused. The WHOLE input is one
// number in base 256 rewritten in base 58, so neither direction can be
// done a block at a time and a leading zero byte, which carries no
// value, is written as a `1` of its own. `bits` is -1, which marks the
// codec as neither a bit codec nor z85.
pub function base58(): Codec {
  return bit_codec("123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz", 0 - 1, 1, 1, false, false);
}

// z85 (ZeroMQ RFC 32): four bytes are a big-endian u32 written as five
// base-85 digits. `bits` is 0, which is what marks the codec as not a
// bit codec at all.
pub function z85(): Codec {
  return bit_codec("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#", 0, 4, 5, false, false);
}

// The eight bits of `b`, reversed.
function rev8(b: i64): i64 {
  let v: i64 = b;
  v = (v & 170 as i64) >> 1 | (v & 85 as i64) << 1;
  v = (v & 204 as i64) >> 2 | (v & 51 as i64) << 2;
  return (v & 240 as i64) >> 4 | (v & 15 as i64) << 4;
}

// ---- encoding --------------------------------------------------------------
// `enc_chars(c, n)` — how many characters `n` bytes encode to, padding
// included. The caller sizes its buffer with this before filling it.
function enc_chars(c: Codec, n: i32): i32 {
  let full: i32 = n / c.in_block;
  let out: i32 = full * c.out_block;
  let rem: i32 = n - full * c.in_block;
  if (rem > 0) {
    let k: i32 = (rem * 8 + c.bits - 1) / c.bits;
    if (c.pad) {
      k = (k + c.out_block - 1) / c.out_block * c.out_block;
    }
    out = out + k;
  }
  return out;
}

// `enc_tail(c, acc, nb)` — the SHORT final block, `nb` bytes held
// big-endian in `acc`, as the characters its bits need plus `=` to the
// block where the encoding pads.
//
// Only base64 and the two base32s ever reach this: a one-byte block
// cannot be short, and z85 refuses a length that is not a multiple of
// four before the loop starts.
function enc_tail(c: Codec, acc0: i64, nb: i32): Chars {
  let acc: i64 = acc0;
  let chars: i32 = (nb * 8 + c.bits - 1) / c.bits;
  acc = acc << chars * c.bits - nb * 8;
  let mask: i64 = ((1 << c.bits) - 1) as i64;
  let out: i64 = 0;
  let sh: i32 = chars * c.bits;
  let u: i32 = 0;
  while (u < chars) {
    sh = sh - c.bits;
    out = out | __load_u8(c.alpha + (acc >> sh & mask) as usize) as i64 << u * 8;
    u = u + 1;
  }
  let w: i32 = chars;
  if (c.pad) {
    while (w % c.out_block != 0) {
      out = out | 61 as i64 << w * 8;
      w = w + 1;
    }
  }
  return Chars { v: out, n: w };
}

// Four bytes as five base-85 digits, most significant first.
function z85_digits(alpha: usize, value: i64): i64 {
  let v: i64 = value;
  let out: i64 = 0;
  let u: i32 = 4;
  while (u >= 0) {
    out = out | __load_u8(alpha + (v % (85 as i64)) as usize) as i64 << u * 8;
    v = v / (85 as i64);
    u = u - 1;
  }
  return out;
}

// ---- decoding --------------------------------------------------------------
// `dec_pairs(c)` — the decode table for TWO characters at a time,
// indexed by the pair as one little-endian 16-bit read and holding both
// values packed (`v0 << bits | v1`), or -1 when either character is
// outside the alphabet.
//
// Cheap despite its size: every entry starts -1 from one memset, and
// only `n * n` of the 65536 are then written — 4096 for base64.
function dec_pairs(c: Codec): usize {
  let t: usize = __alloc(65536 * 4);
  __memset(t, 255, 65536 * 4);
  let n: i32 = 1 << c.bits;
  let i: i32 = 0;
  while (i < n) {
    let c0: i32 = __load_u8(c.alpha + i as usize);
    let j: i32 = 0;
    while (j < n) {
      let c1: i32 = __load_u8(c.alpha + j as usize);
      __store_i32(t + ((c0 | c1 << 8) << 2) as usize, i << c.bits | j);
      j = j + 1;
    }
    i = i + 1;
  }
  return t;
}

// `dec_group(c, g, gn)` — one group of `gn` characters at `g` as bytes.
function dec_group(c: Codec, g: usize, gn: i32): Grp {
  if (c.bits == 0) {
    return z85_group(c, g, gn);
  }
  let acc: i32 = 0;
  let held: i32 = 0;
  let out: i64 = 0;
  let w: i32 = 0;
  let d: i32 = 0;
  let bad: boolean = false;
  while (d < gn) {
    let ch: i32 = __load_i32(g + (d * 4) as usize);
    if (c.pad && ch == 61) {
      break;
    }
    let v: i32 = __load_i32(c.dec + (ch * 4) as usize);
    if (v < 0) {
      bad = true;
      break;
    }
    acc = acc << c.bits | v;
    held = held + c.bits;
    if (held >= 8) {
      held = held - 8;
      let byte: i32 = acc >> held & 255;
      if (c.rev) {
        byte = rev8(byte as i64) as i32;
      }
      out = out << 8 | byte as i64;
      acc = acc & (1 << held) - 1;
      w = w + 1;
    }
    d = d + 1;
  }
  if (bad) {
    return Grp { v: out, n: w, ok: false };
  }
  let padded: boolean = d < gn;
  let k: i32 = d;
  while (k < gn) {
    if (__load_i32(g + (k * 4) as usize) != 61) {
      return Grp { v: out, n: w, ok: false };
    }
    k = k + 1;
  }
  // Padding is optional, but a group that HAS it must be a whole one:
  // `Zg=` is short by a character rather than unpadded.
  if (padded && gn != c.out_block) {
    // GNU base32 withholds the whole final group until its padding is
    // complete. Base64 still writes the bytes decoded before the fault.
    if (c.bits == 5) {
      return Grp { v: 0, n: 0, ok: false };
    }
    return Grp { v: out, n: w, ok: false };
  }
  if (d == 0) {
    return Grp { v: out, n: w, ok: false };
  }
  // The data characters must be exactly as many as some whole number of
  // bytes needs: any leftover worth a character of its own is a count no
  // encoder produces. A group that is SHORT rather than padded is fine
  // by that rule — 9.5 stopped requiring the padding.
  if (d * c.bits - d * c.bits / 8 * 8 >= c.bits) {
    return Grp { v: out, n: w, ok: false };
  }
  // And the bits left over past the last whole byte have to be zero,
  // which is what an encoder writes there. GNU <= 9.4 ignored them and
  // decoded `Zh==` as if it were `Zg==`.
  if (acc != 0) {
    return Grp { v: out, n: w, ok: false };
  }
  return Grp { v: out, n: w, ok: true };
}

function z85_group(c: Codec, g: usize, gn: i32): Grp {
  if (gn != 5) {
    return Grp { v: 0, n: 0, ok: false };
  }
  let v: i64 = 0;
  let k: i32 = 0;
  while (k < 5) {
    let d: i32 = __load_i32(c.dec + (__load_i32(g + (k * 4) as usize) * 4) as usize);
    if (d < 0) {
      return Grp { v: 0, n: 0, ok: false };
    }
    v = v * (85 as i64) + d as i64;
    k = k + 1;
  }
  if (v > 4294967295 as i64) {
    return Grp { v: 0, n: 0, ok: false };
  }
  return Grp { v: v, n: 4, ok: true };
}

// ---- the wrap column -------------------------------------------------------
// `parse_wrap(arg)` — `-w`'s value, as glibc's strtoimax reads it plus
// GNU's two rules on top: a negative is refused, and a magnitude past
// INTMAX_MAX turns wrapping off rather than failing, so `-w 2**63` and
// `-w 2**63-1` differ by the trailing newline.
pub function parse_wrap(arg: string): i64 {
  let n: i32 = arg.len();
  let i: i32 = 0;
  while (i < n && is_space(arg[i] as i32)) {
    i = i + 1;
  }
  let neg: boolean = false;
  if (i < n && (arg[i] as i32 == 43 || arg[i] as i32 == 45)) {
    neg = arg[i] as i32 == 45;
    i = i + 1;
  }
  if (i == n) {
    bad_wrap(arg);
  }
  let v: i64 = 0;
  let over: boolean = false;
  while (i < n) {
    let ch: i32 = arg[i] as i32;
    if (ch < 48 || ch > 57) {
      bad_wrap(arg);
    }
    if (!over) {
      if (v > 922337203685477580 as i64) {
        over = true;
      } else {
        v = v * (10 as i64) + (ch - 48) as i64;
        if (v < 0 as i64) {
          over = true;
        }
      }
    }
    i = i + 1;
  }
  if (neg && (over || v != 0 as i64)) {
    bad_wrap(arg);
  }
  if (over) {
    return 0 as i64;
  }
  return v;
}

function is_space(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

// A bad `-w` prints one line and exits, with no `Try …` line: it is not
// a usage error in GNU's sense.
function bad_wrap(arg: string): void {
  gnu.error("invalid wrap size: " + gnu.quote(arg));
  exit(1);
}

// ---- the program -----------------------------------------------------------
// A diagnostic raised after output has started: GNU's error() flushes
// stdout before it writes to stderr, so a write that fails there is on
// the stream when close_stdout looks, and the exit carries its second
// line. Reproducing that order is what makes `invalid input` and
// `write error` come out together.
function fail(o: io_buffered.BufWriter, msg: string): void {
  let w: io_buffered.BufWriter = o.flush();
  gnu.error(msg);
  gnu.close_stdout(w, false);
  exit(1);
}

// `read_block(r, o, cap)` — up to `cap` bytes, reading until the block
// is full or the input ends. Only a SHORT block may be the last one,
// which is what z85's length check reads as end of input.
function read_block(r: Reader, o: io_buffered.BufWriter, cap: i32): u8[] {
  let chunk: u8[] = [];
  match (r.read_chunk_bytes(cap)) {
    Ok(s) => {
      chunk = s;
    },
    Err(e) => {
      fail(o, "read error: " + gnu.io_error_text(e));
    }
  }
  if (chunk.len() == 0 || chunk.len() == cap) {
    return chunk;
  }
  let carry: usize = buf_new(cap);
  buf_push_bytes_range(carry, chunk, 0, chunk.len());
  while (buf_len(carry) < cap) {
    match (r.read_chunk_bytes(cap - buf_len(carry))) {
      Ok(s) => {
        if (s.len() == 0) {
          break;
        }
        buf_push_bytes_range(carry, s, 0, s.len());
      },
      Err(e) => {
        buf_free(carry);
        fail(o, "read error: " + gnu.io_error_text(e));
      }
    }
  }
  let bytes: u8[] = buf_take_bytes(carry);
  buf_free(carry);
  return bytes;
}

// `open_input(has_file, file)` — the operand's reader; stdin for no
// operand and for `-`.
function open_input(has_file: boolean, file: string): Reader {
  if (!has_file || file == "-") {
    return stdin();
  }
  match (open_reader(file)) {
    Ok(f) => {
      return f;
    },
    Err(e) => {
      gnu.error(gnu.quotef(file) + ": " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return stdin();
}

// `encode(r, c, wrap, o)` — the encode side, buffer and all. The output
// is filled here rather than in a helper: `.with()` writes in place only
// while the buffer's count is one, and handing it to a call is what
// takes it past that.
function encode(r: Reader, c: Codec, wrap: i64, o: io_buffered.BufWriter): void {
  let out: io_buffered.BufWriter = o;
  let cap: i32 = block_bytes();
  let bits: i32 = c.bits;
  let inb: i32 = c.in_block;
  let outb: i32 = c.out_block;
  let alpha: usize = c.alpha;
  let rev: boolean = c.rev;
  let mask: i64 = 0;
  if (bits > 0) {
    mask = ((1 << bits) - 1) as i64;
  }
  let wrapping: boolean = wrap > 0 as i64;
  let col: i64 = 0;
  while (true) {
    let chunk: u8[] = read_block(r, out, cap);
    let n: i32 = chunk.len();
    if (n == 0) {
      break;
    }
    if (bits == 0 && n % inb != 0) {
      fail(out, "invalid input (length must be multiple of 4 characters)");
    }
    let bs: u8[] = chunk;
    let chars: i32 = enc_chars(c, n);
    let nl: i32 = 0;
    if (wrapping) {
      nl = ((col + chars as i64) / wrap) as i32;
    }
    let buf: u8[] = __alloc_u8(chars + nl);
    let i: i32 = 0;
    let j: i32 = 0;
    while (i < n) {
      let nb: i32 = inb;
      if (n - i < nb) {
        nb = n - i;
      }
      let acc: i64 = 0;
      let t: i32 = 0;
      while (t < nb) {
        acc = acc << 8 | bs[i + t] as i64;
        t = t + 1;
      }
      let pv: i64 = 0;
      let pn: i32 = 0;
      if (nb < inb) {
        // The one short block a stream can have, at its end.
        let tail: Chars = enc_tail(c, acc, nb);
        pv = tail.v;
        pn = tail.n;
      } else if (bits == 0) {
        pv = z85_digits(alpha, acc);
        pn = 5;
      } else {
        if (rev) {
          acc = rev8(acc);
        }
        let sh: i32 = inb * 8;
        let u: i32 = 0;
        while (u < outb) {
          sh = sh - bits;
          buf = buf.with(j, __load_u8(alpha + (acc >> sh & mask) as usize) as u8);
          j = j + 1;
          u = u + 1;
          if (wrapping) {
            col = col + 1 as i64;
            if (col == wrap) {
              buf = buf.with(j, 10 as u8);
              j = j + 1;
              col = 0 as i64;
            }
          }
        }
      }
      let e: i32 = 0;
      while (e < pn) {
        buf = buf.with(j, (pv >> e * 8 & 255 as i64) as u8);
        j = j + 1;
        e = e + 1;
        if (wrapping) {
          col = col + 1 as i64;
          if (col == wrap) {
            buf = buf.with(j, 10 as u8);
            j = j + 1;
            col = 0 as i64;
          }
        }
      }
      i = i + nb;
    }
    out = gnu.check(out.write_bytes(buf));
    if (n < cap) {
      break;
    }
  }
  if (wrapping && col > 0 as i64) {
    out = gnu.put(out, "\n");
  }
  gnu.finish(out);
}

// `decode(r, c, ignore, o)` — the decode side.
//
// A group whose characters are all in the alphabet — every group of a
// well-formed stream — is taken two characters at a time straight out of
// the input and never touches the group buffer. Anything else (a
// newline, a `=`, a byte `-i` drops, a group split across two blocks)
// falls to the character-at-a-time path below, which is the one that
// decides whether the input is valid.
function decode(r: Reader, c: Codec, ignore: boolean, o: io_buffered.BufWriter): void {
  let out: io_buffered.BufWriter = o;
  let cap: i32 = block_bytes();
  let fast: boolean = c.bits > 0 && !c.rev;
  let pairs: usize = 0 as usize;
  if (fast) {
    pairs = dec_pairs(c);
  }
  let gbuf: usize = __alloc(64);
  let gn: i32 = 0;
  let inb: i32 = c.in_block;
  let outb: i32 = c.out_block;
  let pbits: i32 = c.bits * 2;
  while (true) {
    let chunk: u8[] = read_block(r, out, cap);
    let n: i32 = chunk.len();
    if (n == 0) {
      break;
    }
    let bs: u8[] = chunk;
    let buf: u8[] = __alloc_u8(n + 8);
    let w: i32 = 0;
    let bad: boolean = false;
    let i: i32 = 0;
    while (i < n) {
      if (fast && gn == 0 && i + outb <= n) {
        let acc: i64 = 0;
        let t: i32 = 0;
        while (t < outb) {
          let pv: i32 = __load_i32(pairs + ((bs[i + t] as i32 | bs[i + t + 1] as i32 << 8) << 2) as usize);
          if (pv < 0) {
            break;
          }
          acc = acc << pbits | pv as i64;
          t = t + 2;
        }
        if (t == outb) {
          let u: i32 = inb;
          while (u > 0) {
            u = u - 1;
            buf = buf.with(w + u, (acc & 255 as i64) as u8);
            acc = acc >> 8;
          }
          i = i + outb;
          w = w + inb;
          continue;
        }
      }
      let b: i32 = bs[i] as i32;
      i = i + 1;
      if (ignore) {
        // `=` survives --ignore-garbage only where it is padding; in
        // base16 and base2 it is garbage like any other byte.
        // GNU's z85 filter retains NUL, which the decoder then rejects.
        if (!(c.pad && b == 61) && !(c.bits == 0 && b == 0) && __load_i32(c.dec + (b * 4) as usize) < 0) {
          continue;
        }
      } else if (b == 10) {
        continue;
      }
      __store_i32(gbuf + (gn * 4) as usize, b);
      gn = gn + 1;
      if (gn == outb) {
        let g: Grp = dec_group(c, gbuf, gn);
        gn = 0;
        let v: i64 = g.v;
        let k: i32 = g.n;
        while (k > 0) {
          k = k - 1;
          buf = buf.with(w + k, (v & 255 as i64) as u8);
          v = v >> 8;
        }
        w = w + g.n;
        if (!g.ok) {
          bad = true;
          break;
        }
      }
    }
    if (w > 0) {
      out = gnu.check(out.write_bytes_range(buf, 0, w));
    }
    if (bad) {
      fail(out, "invalid input");
    }
    if (n < cap) {
      break;
    }
  }
  if (gn > 0) {
    let last: Grp = dec_group(c, gbuf, gn);
    if (last.n > 0) {
      let tail: u8[] = __alloc_u8(last.n);
      let v: i64 = last.v;
      let k: i32 = last.n;
      while (k > 0) {
        k = k - 1;
        tail = tail.with(k, (v & 255 as i64) as u8);
        v = v >> 8;
      }
      out = gnu.check(out.write_bytes(tail));
    }
    if (!last.ok) {
      fail(out, "invalid input");
    }
  }
  __free(gbuf, 64);
  if (pairs != 0 as usize) {
    __free(pairs, 65536 * 4);
  }
  gnu.finish(out);
}

// `run(c, decoding, ignore, wrap, has_file, file)` — the whole program
// below the option scan. Exits; never returns normally on a fault.
// Consumes the codec's lookup tables on successful completion.
pub function run(c: Codec, decoding: boolean, ignore: boolean, wrap: i64, has_file: boolean, file: string): void {
  let r: Reader = open_input(has_file, file);
  let o: io_buffered.BufWriter = gnu.out_new();
  if (c.bits < 0) {
    if (decoding) {
      b58_decode(r, c, ignore, o);
    } else {
      b58_encode(r, c, wrap, o);
    }
  } else if (decoding) {
    decode(r, c, ignore, o);
  } else {
    encode(r, c, wrap, o);
  }
  __free(c.alpha, c.alpha_bytes);
  __free(c.dec, 256 * 4);
}

// `read_all(r, o)` — the whole input. base58 has no block: a byte at
// either end changes every character between.
function read_all(r: Reader, o: io_buffered.BufWriter): u8[] {
  let all: usize = buf_new(block_bytes());
  while (true) {
    let chunk: u8[] = read_block(r, o, block_bytes());
    if (chunk.len() == 0) {
      break;
    }
    buf_push_bytes_range(all, chunk, 0, chunk.len());
  }
  let bytes: u8[] = buf_take_bytes(all);
  buf_free(all);
  return bytes;
}

// `rebase(digits, from, to)` — `digits`, most significant first and each
// below `from`, rewritten in base `to`. Schoolbook long division, one
// pass per output digit: quadratic, which is what base-58 costs without
// a bignum library.
function rebase(digits: u8[], from: i32, to: i32): u8[] {
  let cur: u8[] = digits;
  let rev: u8[] = [];
  while (cur.len() > 0) {
    let next: u8[] = [];
    let rem: i32 = 0;
    let i: i32 = 0;
    while (i < cur.len()) {
      let acc: i32 = rem * from + cur[i] as i32;
      let q: i32 = acc / to;
      rem = acc - q * to;
      if (next.len() > 0 || q != 0) {
        next = next.append(q as u8);
      }
      i = i + 1;
    }
    rev = rev.append(rem as u8);
    cur = next;
  }
  let out: u8[] = [];
  let k: i32 = rev.len();
  while (k > 0) {
    k = k - 1;
    out = out.append(rev[k]);
  }
  return out;
}

function b58_encode(r: Reader, c: Codec, wrap: i64, o: io_buffered.BufWriter): void {
  let data: u8[] = read_all(r, o);
  let zeros: i32 = 0;
  while (zeros < data.len() && data[zeros] as i32 == 0) {
    zeros = zeros + 1;
  }
  let rest: u8[] = [];
  let i: i32 = zeros;
  while (i < data.len()) {
    rest = rest.append(data[i]);
    i = i + 1;
  }
  let digits: u8[] = rebase(rest, 256, 58);
  let text: u8[] = [];
  let z: i32 = 0;
  while (z < zeros) {
    text = text.append(49 as u8);
    z = z + 1;
  }
  let d: i32 = 0;
  while (d < digits.len()) {
    text = text.append(__load_i32(c.alpha + digits[d] as usize) as u8);
    d = d + 1;
  }
  let out: io_buffered.BufWriter = o;
  out = gnu.put(out, wrapped(string_from_bytes_unchecked(text), wrap));
  gnu.finish(out);
}

// `wrapped(text, wrap)` — a newline every `wrap` characters, and one at
// the end unless the text is empty. A wrap of zero is one long line
// with NO newline after it, as it is for every other encoding.
function wrapped(text: string, wrap: i64): string {
  if (text.len() == 0) {
    return "";
  }
  if (wrap <= 0 as i64) {
    return text;
  }
  let out: string = "";
  let i: i32 = 0;
  while (i < text.len()) {
    let e: i32 = i + wrap as i32;
    if (e > text.len()) {
      e = text.len();
    }
    out = out + slice_unchecked(text, i, e) + "\n";
    i = e;
  }
  return out;
}

function b58_decode(r: Reader, c: Codec, ignore: boolean, o: io_buffered.BufWriter): void {
  let text: u8[] = read_all(r, o);
  let vals: u8[] = [];
  let i: i32 = 0;
  while (i < text.len()) {
    let b: i32 = text[i] as i32;
    i = i + 1;
    // A newline is always a separator; anything else outside the
    // alphabet is garbage, which only --ignore-garbage forgives.
    if (b == 10) {
      continue;
    }
    let v: i32 = __load_i32(c.dec + (b * 4) as usize);
    if (v < 0) {
      if (ignore) {
        continue;
      }
      fail(o, "invalid input");
    }
    vals = vals.append(v as u8);
  }
  let zeros: i32 = 0;
  while (zeros < vals.len() && vals[zeros] as i32 == 0) {
    zeros = zeros + 1;
  }
  let rest: u8[] = [];
  let k: i32 = zeros;
  while (k < vals.len()) {
    rest = rest.append(vals[k]);
    k = k + 1;
  }
  let bytes: u8[] = rebase(rest, 58, 256);
  let all: u8[] = [];
  let z: i32 = 0;
  while (z < zeros) {
    all = all.append(0 as u8);
    z = z + 1;
  }
  let d: i32 = 0;
  while (d < bytes.len()) {
    all = all.append(bytes[d]);
    d = d + 1;
  }
  let out: io_buffered.BufWriter = o;
  if (all.len() > 0) {
    out = gnu.check(out.write_bytes(all));
  }
  gnu.finish(out);
}
