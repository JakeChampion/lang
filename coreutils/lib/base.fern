import "std/string";
import "std/io_buffered";
import "./gnu";

pub struct Codec { bits: i32, in_block: i32, out_block: i32, pad: boolean, rev: boolean, alpha: usize, alpha_bytes: i32, dec: usize, kernel_alphabet: u8[], dec_ranges: u8[] }

struct Chars { v: i64, n: i32 }

struct Grp { v: i64, n: i32, ok: boolean }

pub function block_bytes(): i32 {
  return 30720;
}

function tables(alphabet: string): (usize, usize) {
  unsafe {
    let n = alphabet.len();
    let a = __alloc(n + 8);
    let d = __alloc(256 * 4);
    let i = 0;
    while (i < 256) {
      __store_i32(d + (i * 4) as usize, -1);
      i += 1;
    }
    i = 0;
    while (i < n) {
      let ch = alphabet[i] as i32;
      __store_i32(a + i as usize, ch);
      __store_i32(d + (ch * 4) as usize, i);
      i += 1;
    }
    return (a, d);
  }
}

function bit_codec(alphabet: string, bits: i32, in_block: i32, out_block: i32, pad: boolean, rev: boolean): Codec {
  let t: (usize, usize) = tables(alphabet);
  let kernel_alphabet: u8[] = [];
  if ((bits == 6 || bits == 5) && alphabet.len() == 1 << bits && !rev) {
    kernel_alphabet = alphabet.bytes();
  }
  let dec_ranges: u8[] = [];
  if (bits == 5 && !rev) {
    dec_ranges = two_runs(alphabet);
  }
  return Codec { bits: bits, in_block: in_block, out_block: out_block, pad: pad, rev: rev, alpha: t.0, alpha_bytes: alphabet.len() + 8, dec: t.1, kernel_alphabet: kernel_alphabet, dec_ranges: dec_ranges };
}

// The start and length of the run of characters for the values from 0, then
// of the run for the rest, as buf_decode_base32 takes them. Empty unless the
// alphabet is two runs of consecutive characters.
function two_runs(alphabet: string): u8[] {
  let split: i32 = 0;
  for k in 1..alphabet.len() {
    if (alphabet[k] as i32 != alphabet[k - 1] as i32 + 1) {
      if (split > 0) {
        return [];
      }
      split = k;
    }
  }
  if (split == 0) {
    return [];
  }
  return [alphabet[0], split as u8, alphabet[split], (alphabet.len() - split) as u8];
}

function also_decodes(c: Codec, extra: string): Codec {
  unsafe {
    let i = 0;
    while (i < extra.len()) {
      __store_i32(c.dec + (extra[i] as i32 * 4) as usize, i);
      i += 1;
    }
    return c;
  }
}

pub function base64(): Codec {
  return bit_codec("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", 6, 3, 4, true, false);
}

pub function base64url(): Codec {
  return bit_codec("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", 6, 3, 4, true, false);
}

pub function base32(): Codec {
  return bit_codec("ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", 5, 5, 8, true, false);
}

pub function base32hex(): Codec {
  return bit_codec("0123456789ABCDEFGHIJKLMNOPQRSTUV", 5, 5, 8, true, false);
}

pub function base16(): Codec {
  return also_decodes(bit_codec("0123456789ABCDEF", 4, 1, 2, false, false), "0123456789abcdef");
}

pub function base2msbf(): Codec {
  return bit_codec("01", 1, 1, 8, false, false);
}

pub function base2lsbf(): Codec {
  return bit_codec("01", 1, 1, 8, false, true);
}

pub function base58(): Codec {
  return bit_codec("123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz", -1, 1, 1, false, false);
}

pub function z85(): Codec {
  return bit_codec("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#", 0, 4, 5, false, false);
}

function rev8(b: i64): i64 {
  let v = b;
  v = (v & 170 as i64) >> 1 | (v & 85 as i64) << 1;
  v = (v & 204 as i64) >> 2 | (v & 51 as i64) << 2;
  return (v & 240 as i64) >> 4 | (v & 15 as i64) << 4;
}

function enc_chars(c: Codec, n: i32): i32 {
  let full = n / c.in_block;
  let out = full * c.out_block;
  let rem = n - full * c.in_block;
  if (rem > 0) {
    let k = (rem * 8 + c.bits - 1) / c.bits;
    if (c.pad) {
      k = (k + c.out_block - 1) / c.out_block * c.out_block;
    }
    out += k;
  }
  return out;
}

function enc_tail(c: Codec, acc0: i64, nb: i32): Chars {
  unsafe {
    let acc = acc0;
    let chars = (nb * 8 + c.bits - 1) / c.bits;
    acc = acc << chars * c.bits - nb * 8;
    let mask = ((1 << c.bits) - 1) as i64;
    let out: i64 = 0;
    let sh = chars * c.bits;
    let u = 0;
    while (u < chars) {
      sh -= c.bits;
      out = out | __load_u8(c.alpha + (acc >> sh & mask) as usize) as i64 << u * 8;
      u += 1;
    }
    let w = chars;
    if (c.pad) {
      while (w % c.out_block != 0) {
        out = out | 61 as i64 << w * 8;
        w += 1;
      }
    }
    return Chars { v: out, n: w };
  }
}

function pack_bytes(c: Codec): i32 {
  if (c.bits == 0) {
    return 0;
  }
  return c.bits;
}

function pack_value(bs: u8[], i: i32, p: i32): i64 {
  if (i + 8 <= bs.len()) {
    let word = bs[i] as u64 << 56 | bs[i + 1] as u64 << 48 | bs[i + 2] as u64 << 40 | bs[i + 3] as u64 << 32 | bs[i + 4] as u64 << 24 | bs[i + 5] as u64 << 16 | bs[i + 6] as u64 << 8 | bs[i + 7] as u64;
    if (p == 6) {
      return (word >> 16 as u64) as i64;
    }
    if (p == 5) {
      return (word >> 24 as u64) as i64;
    }
    if (p == 4) {
      return (word >> 32 as u64) as i64;
    }
  }
  if (p == 6) {
    return bs[i] as i64 << 40 | bs[i + 1] as i64 << 32 | bs[i + 2] as i64 << 24 | bs[i + 3] as i64 << 16 | bs[i + 4] as i64 << 8 | bs[i + 5] as i64;
  }
  if (p == 5) {
    return bs[i] as i64 << 32 | bs[i + 1] as i64 << 24 | bs[i + 2] as i64 << 16 | bs[i + 3] as i64 << 8 | bs[i + 4] as i64;
  }
  if (p == 4) {
    return bs[i] as i64 << 24 | bs[i + 1] as i64 << 16 | bs[i + 2] as i64 << 8 | bs[i + 3] as i64;
  }
  return bs[i] as i64;
}

function pack_chars(alpha: usize, v: i64, bits: i32): i64 {
  unsafe {
    if (bits == 6) {
      return __load_u8(alpha + (v >> 42 & 63 as i64) as usize) as i64
        | __load_u8(alpha + (v >> 36 & 63 as i64) as usize) as i64 << 8
        | __load_u8(alpha + (v >> 30 & 63 as i64) as usize) as i64 << 16
        | __load_u8(alpha + (v >> 24 & 63 as i64) as usize) as i64 << 24
        | __load_u8(alpha + (v >> 18 & 63 as i64) as usize) as i64 << 32
        | __load_u8(alpha + (v >> 12 & 63 as i64) as usize) as i64 << 40
        | __load_u8(alpha + (v >> 6 & 63 as i64) as usize) as i64 << 48
        | __load_u8(alpha + (v & 63 as i64) as usize) as i64 << 56;
    }
    if (bits == 5) {
      return __load_u8(alpha + (v >> 35 & 31 as i64) as usize) as i64
        | __load_u8(alpha + (v >> 30 & 31 as i64) as usize) as i64 << 8
        | __load_u8(alpha + (v >> 25 & 31 as i64) as usize) as i64 << 16
        | __load_u8(alpha + (v >> 20 & 31 as i64) as usize) as i64 << 24
        | __load_u8(alpha + (v >> 15 & 31 as i64) as usize) as i64 << 32
        | __load_u8(alpha + (v >> 10 & 31 as i64) as usize) as i64 << 40
        | __load_u8(alpha + (v >> 5 & 31 as i64) as usize) as i64 << 48
        | __load_u8(alpha + (v & 31 as i64) as usize) as i64 << 56;
    }
    return __load_u8(alpha + (v >> 28 & 15 as i64) as usize) as i64
      | __load_u8(alpha + (v >> 24 & 15 as i64) as usize) as i64 << 8
      | __load_u8(alpha + (v >> 20 & 15 as i64) as usize) as i64 << 16
      | __load_u8(alpha + (v >> 16 & 15 as i64) as usize) as i64 << 24
      | __load_u8(alpha + (v >> 12 & 15 as i64) as usize) as i64 << 32
      | __load_u8(alpha + (v >> 8 & 15 as i64) as usize) as i64 << 40
      | __load_u8(alpha + (v >> 4 & 15 as i64) as usize) as i64 << 48
      | __load_u8(alpha + (v & 15 as i64) as usize) as i64 << 56;
  }
}

function bit_table(c: Codec): usize {
  unsafe {
    let t = __alloc(256 * 8);
    let b = 0;
    while (b < 256) {
      let v = b as i64;
      if (c.rev) {
        v = rev8(v);
      }
      let w: i64 = 0;
      let k: i32 = 0;
      while (k < 8) {
        w = w | __load_u8(c.alpha + (v >> 7 - k & 1 as i64) as usize) as i64 << k * 8;
        k += 1;
      }
      __store_i64(t + (b * 8) as usize, w);
      b += 1;
    }
    return t;
  }
}

function z85_digits(alpha: usize, value: i64): i64 {
  unsafe {
    let v = value;
    let out: i64 = 0;
    let u: i32 = 4;
    while (u >= 0) {
      out = out | __load_u8(alpha + (v % (85 as i64)) as usize) as i64 << u * 8;
      v /= 85 as i64;
      u -= 1;
    }
    return out;
  }
}

function dec_pairs(c: Codec): usize {
  unsafe {
    let t = __alloc(65536 * 4);
    __memset(t, 255, 65536 * 4);
    let n = 1 << c.bits;
    let i = 0;
    while (i < n) {
      let c0 = __load_u8(c.alpha + i as usize);
      let j = 0;
      while (j < n) {
        let c1 = __load_u8(c.alpha + j as usize);
        __store_i32(t + ((c0 | c1 << 8) << 2) as usize, i << c.bits | j);
        j += 1;
      }
      i += 1;
    }
    return t;
  }
}

function dec_group(c: Codec, g: usize, gn: i32): Grp {
  unsafe {
    if (c.bits == 0) {
      return z85_group(c, g, gn);
    }
    let acc = 0;
    let held = 0;
    let out: i64 = 0;
    let w = 0;
    let d = 0;
    let bad = false;
    while (d < gn) {
      let ch = __load_i32(g + (d * 4) as usize);
      if (c.pad && ch == 61) {
        break;
      }
      let v = __load_i32(c.dec + (ch * 4) as usize);
      if (v < 0) {
        bad = true;
        break;
      }
      acc = acc << c.bits | v;
      held += c.bits;
      if (held >= 8) {
        held -= 8;
        let byte = acc >> held & 255;
        if (c.rev) {
          byte = rev8(byte as i64) as i32;
        }
        out = out << 8 | byte as i64;
        acc = acc & (1 << held) - 1;
        w += 1;
      }
      d += 1;
    }
    if (bad) {
      return Grp { v: out, n: w, ok: false };
    }
    let padded = d < gn;
    let k = d;
    while (k < gn) {
      if (__load_i32(g + (k * 4) as usize) != 61) {
        return Grp { v: out, n: w, ok: false };
      }
      k += 1;
    }
    if (padded && gn != c.out_block) {
      if (c.bits == 5) {
        return Grp { v: 0, n: 0, ok: false };
      }
      return Grp { v: out, n: w, ok: false };
    }
    if (d == 0) {
      return Grp { v: out, n: w, ok: false };
    }
    if (d * c.bits - d * c.bits / 8 * 8 >= c.bits) {
      return Grp { v: out, n: w, ok: false };
    }
    if (acc != 0) {
      return Grp { v: out, n: w, ok: false };
    }
    return Grp { v: out, n: w, ok: true };
  }
}

function z85_group(c: Codec, g: usize, gn: i32): Grp {
  unsafe {
    if (gn != 5) {
      return Grp { v: 0, n: 0, ok: false };
    }
    let v: i64 = 0;
    let k = 0;
    while (k < 5) {
      let d = __load_i32(c.dec + (__load_i32(g + (k * 4) as usize) * 4) as usize);
      if (d < 0) {
        return Grp { v: 0, n: 0, ok: false };
      }
      v = v * (85 as i64) + d as i64;
      k += 1;
    }
    if (v > 4294967295 as i64) {
      return Grp { v: 0, n: 0, ok: false };
    }
    return Grp { v: v, n: 4, ok: true };
  }
}

pub function parse_wrap(arg: string): i64 {
  let n = arg.len();
  let i = 0;
  while (i < n && is_space(arg[i] as i32)) {
    i += 1;
  }
  let neg = false;
  if (i < n && (arg[i] as i32 == 43 || arg[i] as i32 == 45)) {
    neg = arg[i] as i32 == 45;
    i += 1;
  }
  if (i == n) {
    bad_wrap(arg);
  }
  let v: i64 = 0;
  let over = false;
  while (i < n) {
    let ch = arg[i] as i32;
    if (ch < 48 || ch > 57) {
      bad_wrap(arg);
    }
    if (!over) {
      if (v > 922337203685477580 as i64) {
        over = true;
      } else {
        v = v * (10 as i64) + (ch - 48) as i64;
        if (v < 0 as i64) {
          over = true;
        }
      }
    }
    i += 1;
  }
  if (neg && (over || v != 0 as i64)) {
    bad_wrap(arg);
  }
  if (over) {
    return 0 as i64;
  }
  return v;
}

function is_space(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

function bad_wrap(arg: string): void {
  gnu.error("invalid wrap size: " + gnu.quote(arg));
  exit(1);
}

function fail(o: io_buffered.BufWriter, msg: string): void {
  gnu.die(o, msg, 1);
}

function read_block(r: Reader, o: io_buffered.BufWriter, cap: i32): u8[] {
  let chunk: u8[] = [];
  match (r.read_chunk_bytes(cap)) {
    Ok(s) => {
      chunk = s;
    },
    Err(e) => {
      fail(o, "read error: " + gnu.io_error_text(e));
    }
  }
  if (chunk.len() == 0 || chunk.len() == cap) {
    return chunk;
  }
  let carry = buf_new(cap);
  buf_push_bytes_range(carry, chunk, 0, chunk.len());
  while (buf_len(carry) < cap) {
    match (r.read_chunk_bytes(cap - buf_len(carry))) {
      Ok(s) => {
        if (s.len() == 0) {
          break;
        }
        buf_push_bytes_range(carry, s, 0, s.len());
      },
      Err(e) => {
        buf_free(carry);
        fail(o, "read error: " + gnu.io_error_text(e));
      }
    }
  }
  let bytes = buf_take_bytes(carry);
  buf_free(carry);
  return bytes;
}

function open_input(has_file: boolean, file: string): Reader {
  if (!has_file || file == "-") {
    return stdin();
  }
  match (open_reader(file)) {
    Ok(f) => {
      return f;
    },
    Err(e) => {
      gnu.error(gnu.quotef(file) + ": " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return stdin();
}

// Whole groups of three bytes go to the base64 kernel, a line at a time. A
// group that crosses the end of a line goes out one character at a time.
// The kernel for `bits`-bit characters: groups of 3 bytes to 4 characters for
// base64, and of 5 bytes to 8 for base32.
function push_groups(h: usize, bs: u8[], lo: i32, hi: i32, bits: i32, alphabet: u8[]): void {
  if (bits == 6) {
    buf_push_base64(h, bs, lo, hi, alphabet);
  } else {
    buf_push_base32(h, bs, lo, hi, alphabet);
  }
}

function encode_kernel(h: usize, bs: u8[], whole: i32, bits: i32, alphabet: u8[], wrap: i64, col0: i64): i64 {
  if (wrap <= 0 as i64) {
    push_groups(h, bs, 0, whole, bits, alphabet);
    return col0;
  }
  let group: i32 = if (bits == 6) { 3 } else { 5 };
  let chars = (group * 8 / bits) as i64;
  let col = col0;
  let i = 0;
  while (i < whole) {
    let g = (whole - i) / group;
    if ((wrap - col) / chars < g as i64) {
      g = ((wrap - col) / chars) as i32;
    }
    push_groups(h, bs, i, i + g * group, bits, alphabet);
    i = i + g * group;
    col = col + g as i64 * chars;
    if (col == wrap) {
      buf_push_byte(h, 10);
      col = 0 as i64;
    } else if (i < whole) {
      col = group_across(h, bs, i, group, bits, alphabet, wrap, col);
      i += group;
    }
  }
  return col;
}

function group_across(h: usize, bs: u8[], i: i32, group: i32, bits: i32, alphabet: u8[], wrap: i64, col0: i64): i64 {
  let v = 0 as i64;
  for k in 0..group {
    v = v << 8 | bs[i + k] as i64;
  }
  let col = col0;
  let shift = group * 8 - bits;
  while (shift >= 0) {
    buf_push_byte(h, alphabet[(v >> shift) as i32 & (1 << bits) - 1] as i32);
    col = col + 1 as i64;
    if (col == wrap) {
      buf_push_byte(h, 10);
      col = 0 as i64;
    }
    shift -= bits;
  }
  return col;
}

function encode(r: Reader, c: Codec, wrap: i64, o: io_buffered.BufWriter): void {
  unsafe {
    let out = o;
    let cap = block_bytes();
    let bits = c.bits;
    let inb = c.in_block;
    let outb = c.out_block;
    let alpha = c.alpha;
    let rev = c.rev;
    let mask: i64 = 0;
    if (bits > 0) {
      mask = ((1 << bits) - 1) as i64;
    }
    let wrapping = wrap > 0 as i64;
    let col: i64 = 0;
    let table = 0 as usize;
    if (bits == 1) {
      table = bit_table(c);
    }
    while (true) {
      let chunk = read_block(r, out, cap);
      let n = chunk.len();
      if (n == 0) {
        break;
      }
      if (bits == 0 && n % inb != 0) {
        fail(out, "invalid input (length must be multiple of 4 characters)");
      }
      let bs = chunk;
      let i = 0;
      let p = pack_bytes(c);
      if (c.kernel_alphabet.len() > 0) {
        let whole = n - n % inb;
        col = encode_kernel(out.handle(), bs, whole, bits, c.kernel_alphabet, wrap, col);
        i = whole;
        out = gnu.settle(out);
      } else if (p > 0) {
        let h = out.handle();
        let whole = n - n % p;
        while (i < whole) {
          let w: i64 = 0;
          if (p == 1) {
            w = __load_i64(table + (bs[i] as i32 * 8) as usize);
          } else {
            w = pack_chars(alpha, pack_value(bs, i, p), bits);
          }
          if (!wrapping) {
            buf_push_u64(h, w as u64);
          } else if (col + 8 as i64 <= wrap) {
            buf_push_u64(h, w as u64);
            col = col + 8 as i64;
            if (col == wrap) {
              buf_push_byte(h, 10);
              col = 0 as i64;
            }
          } else {
            let k: i32 = 0;
            while (k < 8) {
              buf_push_byte(h, (w >> k * 8 & 255 as i64) as i32);
              col = col + 1 as i64;
              if (col == wrap) {
                buf_push_byte(h, 10);
                col = 0 as i64;
              }
              k += 1;
            }
          }
          i += p;
        }
        out = gnu.settle(out);
      }
      let chars = enc_chars(c, n - i);
      let nl = 0;
      if (wrapping) {
        nl = ((col + chars as i64) / wrap) as i32;
      }
      let buf = __alloc_u8(chars + nl);
      let j = 0;
      while (i < n) {
        let nb = inb;
        if (n - i < nb) {
          nb = n - i;
        }
        let acc: i64 = 0;
        let t = 0;
        while (t < nb) {
          acc = acc << 8 | bs[i + t] as i64;
          t += 1;
        }
        let pv: i64 = 0;
        let pn = 0;
        if (nb < inb) {
          let tail = enc_tail(c, acc, nb);
          pv = tail.v;
          pn = tail.n;
        } else if (bits == 0) {
          pv = z85_digits(alpha, acc);
          pn = 5;
        } else {
          if (rev) {
            acc = rev8(acc);
          }
          let sh = inb * 8;
          let u = 0;
          while (u < outb) {
            sh -= bits;
            buf = buf.with(j, __load_u8(alpha + (acc >> sh & mask) as usize) as u8);
            j += 1;
            u += 1;
            if (wrapping) {
              col = col + 1 as i64;
              if (col == wrap) {
                buf = buf.with(j, 10 as u8);
                j += 1;
                col = 0 as i64;
              }
            }
          }
        }
        let e = 0;
        while (e < pn) {
          buf = buf.with(j, (pv >> e * 8 & 255 as i64) as u8);
          j += 1;
          e += 1;
          if (wrapping) {
            col = col + 1 as i64;
            if (col == wrap) {
              buf = buf.with(j, 10 as u8);
              j += 1;
              col = 0 as i64;
            }
          }
        }
        i += nb;
      }
      out = gnu.check(out.write_bytes(buf));
      if (n < cap) {
        break;
      }
    }
    if (wrapping && col > 0 as i64) {
      out = gnu.put(out, "\n");
    }
    if (table != 0 as usize) {
      __free(table, 256 * 8);
    }
    gnu.finish(out);
  }
}

function word_rows(bs: u8[], i: i32, n: i32, pairs: usize, h: usize, c: Codec): i32 {
  let bits: i32 = c.bits;
  if (bits == 4) {
    return hex_rows(bs, i, n, pairs, h);
  }
  if (bits == 6) {
    return b64_rows(bs, i, n, pairs, h);
  }
  if (bits == 5) {
    return buf_decode_base32(h, bs, i, n, c.dec_ranges);
  }
  return i;
}

function hex_rows(bs: u8[], from: i32, n: i32, pairs: usize, h: usize): i32 {
  unsafe {
    let i = from;
    while (i + 16 <= n) {
      let v = 0 as u64;
      let k = 0;
      while (k < 16) {
        let pv = __load_i32(pairs + ((bs[i + k] as i32 | bs[i + k + 1] as i32 << 8) << 2) as usize);
        if (pv < 0) {
          return i;
        }
        v = v >> 8 as u64 | pv as u64 << 56 as u64;
        k += 2;
      }
      buf_push_u64(h, v);
      i += 16;
    }
    return i;
  }
}

function b64_rows(bs: u8[], from: i32, n: i32, pairs: usize, h: usize): i32 {
  unsafe {
    let i = from;
    while (i + 32 <= n) {
      let g0 = __load_i32(pairs + ((bs[i] as i32 | bs[i + 1] as i32 << 8) << 2) as usize) << 12 | __load_i32(pairs + ((bs[i + 2] as i32 | bs[i + 3] as i32 << 8) << 2) as usize);
      if (g0 < 0) {
        return i;
      }
      let r0 = (g0 >> 16 | (g0 >> 8 & 255) << 8 | (g0 & 255) << 16) as u64;
      let g1 = __load_i32(pairs + ((bs[i + 4] as i32 | bs[i + 5] as i32 << 8) << 2) as usize) << 12 | __load_i32(pairs + ((bs[i + 6] as i32 | bs[i + 7] as i32 << 8) << 2) as usize);
      if (g1 < 0) {
        return i;
      }
      let r1 = (g1 >> 16 | (g1 >> 8 & 255) << 8 | (g1 & 255) << 16) as u64;
      let g2 = __load_i32(pairs + ((bs[i + 8] as i32 | bs[i + 9] as i32 << 8) << 2) as usize) << 12 | __load_i32(pairs + ((bs[i + 10] as i32 | bs[i + 11] as i32 << 8) << 2) as usize);
      if (g2 < 0) {
        return i;
      }
      let r2 = (g2 >> 16 | (g2 >> 8 & 255) << 8 | (g2 & 255) << 16) as u64;
      let g3 = __load_i32(pairs + ((bs[i + 12] as i32 | bs[i + 13] as i32 << 8) << 2) as usize) << 12 | __load_i32(pairs + ((bs[i + 14] as i32 | bs[i + 15] as i32 << 8) << 2) as usize);
      if (g3 < 0) {
        return i;
      }
      let r3 = (g3 >> 16 | (g3 >> 8 & 255) << 8 | (g3 & 255) << 16) as u64;
      let g4 = __load_i32(pairs + ((bs[i + 16] as i32 | bs[i + 17] as i32 << 8) << 2) as usize) << 12 | __load_i32(pairs + ((bs[i + 18] as i32 | bs[i + 19] as i32 << 8) << 2) as usize);
      if (g4 < 0) {
        return i;
      }
      let r4 = (g4 >> 16 | (g4 >> 8 & 255) << 8 | (g4 & 255) << 16) as u64;
      let g5 = __load_i32(pairs + ((bs[i + 20] as i32 | bs[i + 21] as i32 << 8) << 2) as usize) << 12 | __load_i32(pairs + ((bs[i + 22] as i32 | bs[i + 23] as i32 << 8) << 2) as usize);
      if (g5 < 0) {
        return i;
      }
      let r5 = (g5 >> 16 | (g5 >> 8 & 255) << 8 | (g5 & 255) << 16) as u64;
      let g6 = __load_i32(pairs + ((bs[i + 24] as i32 | bs[i + 25] as i32 << 8) << 2) as usize) << 12 | __load_i32(pairs + ((bs[i + 26] as i32 | bs[i + 27] as i32 << 8) << 2) as usize);
      if (g6 < 0) {
        return i;
      }
      let r6 = (g6 >> 16 | (g6 >> 8 & 255) << 8 | (g6 & 255) << 16) as u64;
      let g7 = __load_i32(pairs + ((bs[i + 28] as i32 | bs[i + 29] as i32 << 8) << 2) as usize) << 12 | __load_i32(pairs + ((bs[i + 30] as i32 | bs[i + 31] as i32 << 8) << 2) as usize);
      if (g7 < 0) {
        return i;
      }
      let r7 = (g7 >> 16 | (g7 >> 8 & 255) << 8 | (g7 & 255) << 16) as u64;
      buf_push_u64(h, r0 | r1 << 24 as u64 | r2 << 48 as u64);
      buf_push_u64(h, r2 >> 16 as u64 | r3 << 8 as u64 | r4 << 32 as u64 | r5 << 56 as u64);
      buf_push_u64(h, r5 >> 8 as u64 | r6 << 16 as u64 | r7 << 40 as u64);
      i += 32;
    }
    return i;
  }
}

function push_low_bytes(h: usize, word: u64, bits: i32): void {
  let k = 0;
  while (k < bits) {
    buf_push_byte(h, (word >> k as u64 & 255 as u64) as i32);
    k += 8;
  }
}

function decode(r: Reader, c: Codec, ignore: boolean, o: io_buffered.BufWriter): void {
  unsafe {
    let out = o;
    let cap = block_bytes();
    let fast = c.bits > 0 && !c.rev;
    let pairs = 0 as usize;
    if (fast) {
      pairs = dec_pairs(c);
    }
    let gbuf = __alloc(64);
    let gn = 0;
    let inb = c.in_block;
    let outb = c.out_block;
    let pbits = c.bits * 2;
    while (true) {
      let chunk = read_block(r, out, cap);
      let n = chunk.len();
      if (n == 0) {
        break;
      }
      let bs = chunk;
      let h = out.handle();
      let word = 0 as u64;
      let fill = 0;
      let bad = false;
      let i = 0;
      let rows = fast;
      while (i < n) {
        if (rows && gn == 0) {
          push_low_bytes(h, word, fill);
          word = 0 as u64;
          fill = 0;
          i = word_rows(bs, i, n, pairs, h, c);
          rows = false;
          continue;
        }
        if (fast && gn == 0 && i + outb <= n) {
          let acc: i64 = 0;
          let t = 0;
          while (t < outb) {
            let pv = __load_i32(pairs + ((bs[i + t] as i32 | bs[i + t + 1] as i32 << 8) << 2) as usize);
            if (pv < 0) {
              break;
            }
            acc = acc << pbits | pv as i64;
            t += 2;
          }
          if (t == outb) {
            let u = inb;
            while (u > 0) {
              u -= 1;
              word = word | (acc >> u * 8 & 255 as i64) as u64 << fill as u64;
              fill += 8;
              if (fill == 64) {
                buf_push_u64(h, word);
                word = 0 as u64;
                fill = 0;
              }
            }
            i += outb;
            continue;
          }
        }
        let b = bs[i] as i32;
        i += 1;
        rows = fast;
        if (ignore) {
          if (!(c.pad && b == 61) && !(c.bits == 0 && b == 0) && __load_i32(c.dec + (b * 4) as usize) < 0) {
            continue;
          }
        } else if (b == 10) {
          continue;
        }
        __store_i32(gbuf + (gn * 4) as usize, b);
        gn += 1;
        if (gn == outb) {
          let g = dec_group(c, gbuf, gn);
          gn = 0;
          push_low_bytes(h, word, fill);
          word = 0 as u64;
          fill = 0;
          let k = g.n;
          while (k > 0) {
            k -= 1;
            buf_push_byte(h, (g.v >> k * 8 & 255 as i64) as i32);
          }
          if (!g.ok) {
            bad = true;
            break;
          }
        }
      }
      push_low_bytes(h, word, fill);
      out = gnu.settle(out);
      if (bad) {
        fail(out, "invalid input");
      }
      if (n < cap) {
        break;
      }
    }
    if (gn > 0) {
      let last = dec_group(c, gbuf, gn);
      if (last.n > 0) {
        let tail = __alloc_u8(last.n);
        let v = last.v;
        let k = last.n;
        while (k > 0) {
          k -= 1;
          tail = tail.with(k, (v & 255 as i64) as u8);
          v = v >> 8;
        }
        out = gnu.check(out.write_bytes(tail));
      }
      if (!last.ok) {
        fail(out, "invalid input");
      }
    }
    __free(gbuf, 64);
    if (pairs != 0 as usize) {
      __free(pairs, 65536 * 4);
    }
    gnu.finish(out);
  }
}

pub function run(c: Codec, decoding: boolean, ignore: boolean, wrap: i64, has_file: boolean, file: string): void {
  unsafe {
    let r = open_input(has_file, file);
    let o = gnu.out_new();
    if (c.bits < 0) {
      if (decoding) {
        b58_decode(r, c, ignore, o);
      } else {
        b58_encode(r, c, wrap, o);
      }
    } else if (decoding) {
      decode(r, c, ignore, o);
    } else {
      encode(r, c, wrap, o);
    }
    __free(c.alpha, c.alpha_bytes);
    __free(c.dec, 256 * 4);
  }
}

function read_all(r: Reader, o: io_buffered.BufWriter): u8[] {
  let all = buf_new(block_bytes());
  while (true) {
    let chunk = read_block(r, o, block_bytes());
    if (chunk.len() == 0) {
      break;
    }
    buf_push_bytes_range(all, chunk, 0, chunk.len());
  }
  let bytes = buf_take_bytes(all);
  buf_free(all);
  return bytes;
}

function rebase(digits: u8[], from: i32, to: i32): u8[] {
  let cur = digits;
  let rev: u8[] = [];
  while (cur.len() > 0) {
    let next: u8[] = [];
    let rem = 0;
    let i = 0;
    while (i < cur.len()) {
      let acc = rem * from + cur[i] as i32;
      let q = acc / to;
      rem = acc - q * to;
      if (next.len() > 0 || q != 0) {
        next = next.append(q as u8);
      }
      i += 1;
    }
    rev = rev.append(rem as u8);
    cur = next;
  }
  let out: u8[] = [];
  let k = rev.len();
  while (k > 0) {
    k -= 1;
    out = out.append(rev[k]);
  }
  return out;
}

function b58_encode(r: Reader, c: Codec, wrap: i64, own o: io_buffered.BufWriter): void {
  unsafe {
    let data = read_all(r, o);
    let zeros = 0;
    while (zeros < data.len() && data[zeros] as i32 == 0) {
      zeros += 1;
    }
    let rest: u8[] = [];
    let i = zeros;
    while (i < data.len()) {
      rest = rest.append(data[i]);
      i += 1;
    }
    let digits = rebase(rest, 256, 58);
    let text: u8[] = [];
    let z = 0;
    while (z < zeros) {
      text = text.append(49 as u8);
      z += 1;
    }
    let d = 0;
    while (d < digits.len()) {
      text = text.append(__load_i32(c.alpha + digits[d] as usize) as u8);
      d += 1;
    }
    o = gnu.put(o, wrapped(string_from_bytes_unchecked(text), wrap));
    gnu.finish(o);
  }
}

function wrapped(text: string, wrap: i64): string {
  if (text.len() == 0) {
    return "";
  }
  if (wrap <= 0 as i64) {
    return text;
  }
  let out = "";
  let i = 0;
  while (i < text.len()) {
    let e = i + wrap as i32;
    if (e > text.len()) {
      e = text.len();
    }
    out = out + slice_unchecked(text, i, e) + "\n";
    i = e;
  }
  return out;
}

function b58_decode(r: Reader, c: Codec, ignore: boolean, own o: io_buffered.BufWriter): void {
  unsafe {
    let text = read_all(r, o);
    let vals: u8[] = [];
    let i = 0;
    while (i < text.len()) {
      let b = text[i] as i32;
      i += 1;
      if (b == 10) {
        continue;
      }
      let v = __load_i32(c.dec + (b * 4) as usize);
      if (v < 0) {
        if (ignore) {
          continue;
        }
        fail(o, "invalid input");
      }
      vals = vals.append(v as u8);
    }
    let zeros = 0;
    while (zeros < vals.len() && vals[zeros] as i32 == 0) {
      zeros += 1;
    }
    let rest: u8[] = [];
    let k = zeros;
    while (k < vals.len()) {
      rest = rest.append(vals[k]);
      k += 1;
    }
    let bytes = rebase(rest, 58, 256);
    let all: u8[] = [];
    let z = 0;
    while (z < zeros) {
      all = all.append(0 as u8);
      z += 1;
    }
    let d = 0;
    while (d < bytes.len()) {
      all = all.append(bytes[d]);
      d += 1;
    }
    if (all.len() > 0) {
      o = gnu.check(o.write_bytes(all));
    }
    gnu.finish(o);
  }
}
