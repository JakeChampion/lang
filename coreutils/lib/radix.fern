pub function threshold(): i32 {
  return 16384;
}

pub function bytes_word(text: string, lo: i32, hi: i32): i64 {
  if (hi - lo >= 8) {
    return text[lo] as i64 << 56 as i64 | text[lo + 1] as i64 << 48 as i64 | text[lo + 2] as i64 << 40 as i64 | text[lo + 3] as i64 << 32 as i64 | text[lo + 4] as i64 << 24 as i64 | text[lo + 5] as i64 << 16 as i64 | text[lo + 6] as i64 << 8 as i64 | text[lo + 7] as i64;
  }
  let w = 0 as i64;
  let b = 0;
  while (b < 8) {
    let x = 0;
    if (lo + b < hi) {
      x = text[lo + b] as i32;
    }
    w = w << 8 as i64 | x as i64;
    b += 1;
  }
  return w;
}

pub function bytes_word_bytes(text: u8[], lo: i32, hi: i32): i64 {
  if (hi - lo >= 8) {
    return text[lo] as i64 << 56 as i64 | text[lo + 1] as i64 << 48 as i64 | text[lo + 2] as i64 << 40 as i64 | text[lo + 3] as i64 << 32 as i64 | text[lo + 4] as i64 << 24 as i64 | text[lo + 5] as i64 << 16 as i64 | text[lo + 6] as i64 << 8 as i64 | text[lo + 7] as i64;
  }
  let w = 0 as i64;
  let b = 0;
  while (b < 8) {
    let x = 0;
    if (lo + b < hi) {
      x = text[lo + b] as i32;
    }
    w = w << 8 as i64 | x as i64;
    b += 1;
  }
  return w;
}

pub function by_word(own idx: i64[], words: i64[], n: i32, signed: boolean, rev: boolean): i64[] {
  let flip = 0;
  if (rev) {
    flip = 65535;
  }
  let counts: i32[] = [];
  let z = 0;
  while (z < 262144) {
    counts = counts.append(0);
    z += 1;
  }
  let i = 0;
  while (i < n) {
    let w = words[idx[i] as i32];
    let d0 = (w & 65535 as i64) as i32 ^ flip;
    let d1 = 65536 + (w >> 16 as i64 & 65535 as i64) as i32 ^ flip;
    let d2 = 131072 + (w >> 32 as i64 & 65535 as i64) as i32 ^ flip;
    let d3 = 196608 + (w >> 48 as i64 & 65535 as i64) as i32 ^ flip;
    counts = counts.with(d0, counts[d0] + 1);
    counts = counts.with(d1, counts[d1] + 1);
    counts = counts.with(d2, counts[d2] + 1);
    counts = counts.with(d3, counts[d3] + 1);
    i += 1;
  }
  let tmp: i64[] = [];
  let t = 0;
  while (t < n) {
    tmp = tmp.append(0 as i64);
    t += 1;
  }
  let shift = 0;
  while (shift < 64) {
    let sh = shift as i64;
    let base = shift / 16 * 65536;
    let first = base + (words[idx[0] as i32] >> sh & 65535 as i64) as i32 ^ flip;
    if (counts[first] < n) {
      let sflip = 0;
      if (signed && shift == 48) {
        sflip = 32768;
      }
      let sum = 0;
      let b = 0;
      while (b < 65536) {
        let slot = base + (b ^ sflip);
        let cnt = counts[slot];
        counts = counts.with(slot, sum);
        sum += cnt;
        b += 1;
      }
      let j = 0;
      while (j < n) {
        let v = idx[j];
        let dj = base + (words[v as i32] >> sh & 65535 as i64) as i32 ^ flip;
        let at = counts[dj];
        tmp = tmp.with(at, v);
        counts = counts.with(dj, at + 1);
        j += 1;
      }
      let swap = idx;
      idx = tmp;
      tmp = swap;
    }
    shift += 16;
  }
  return idx;
}
