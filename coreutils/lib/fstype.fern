// `name(magic)` is GNU's name for a Linux `f_type`, or None for one GNU does
// not know, which it prints as `UNKNOWN (0x…)`.
pub function name(magic: i64): Option[string] {
  let ms: i64[] = magics();
  let i: i32 = 0;
  while (i < ms.len()) {
    if (ms[i] == magic) {
      return Some(names()[i]);
    }
    i = i + 1;
  }
  return None;
}
