// coreutils/lib/resolv.fern — the IPv4 name lookup glibc's gethostid makes.
//
// gethostid resolves the machine's own hostname through NSS: the `hosts:`
// line of /etc/nsswitch.conf names the sources in order — `files`
// (/etc/hosts) and `dns` (the nameservers of /etc/resolv.conf, walked
// with its search list) — and the first AF_INET answer wins. This module
// is that walk; the two sources are std/dns, which reads the files and
// speaks RFC 1035. hostid(1) is the consumer today; `who --lookup`
// reaches for the canonical-name walk beside it.
//
// An address is carried as the in_addr WORD: the four octets in memory
// order read as a little-endian integer, `a | b<<8 | c<<16 | d<<24`. That
// is the form `tcp_connect` takes and the one gethostid shifts.
//
// Where this differs from glibc, and why (docs/COREUTILS.md):
//   - Only `files` and `dns` are implemented. Any other source on the
//     hosts line (mdns4_minimal, myhostname, resolve, …) reports UNAVAIL,
//     as glibc does for a source with no module installed.
//   - What std/dns does not read, this does not either: RES_OPTIONS,
//     LOCALDOMAIN and HOSTALIASES, and a nameserver with an IPv6 zone.
import "std/string";
import "std/array";
import "std/net";
import "std/dns";

// ---- statuses ---------------------------------------------------------------
//
// What a source says about a name, in glibc's vocabulary. Every lookup
// below returns one of these beside its answer.
pub function success(): i32 {
  return 0;
}

pub function notfound(): i32 {
  return 1;
}

pub function unavail(): i32 {
  return 2;
}

// A DNS failure as NSS reports it: a name the servers do not know, or
// know no address for, is NOTFOUND; everything else is UNAVAIL.
function nss_status(e: dns.DnsError): i32 {
  match (e) {
    NoSuchName => {
      return notfound();
    },
    NoData => {
      return notfound();
    },
    _ => {
      return unavail();
    }
  }
  return unavail();
}

// ---- addresses --------------------------------------------------------------
// `ipv4_word(a, b, c, d)` — the in_addr word of `a.b.c.d`.
pub function ipv4_word(a: i32, b: i32, c: i32, d: i32): i32 {
  return a & 255 | (b & 255) << 8 | (c & 255) << 16 | (d & 255) << 24;
}

// The in_addr word of the first IPv4 address among `xs`, which is the
// first AF_INET answer gethostid takes.
function first_v4_word(xs: net.IpAddr[]): Option[i32] {
  var i: i32 = 0;
  while (i < xs.len()) {
    match (xs[i].packed_v4()) {
      Some(w) => {
        return Some(w);
      },
      None => {}
    }
    i = i + 1;
  }
  return None;
}

// ---- /etc/nsswitch.conf -----------------------------------------------------
// `Source` — one entry of the `hosts:` line: its name and, for each
// status it can report, whether that status ENDS the lookup. glibc's
// defaults are success=return and everything else continue; a bracketed
// action after the source (`[NOTFOUND=return]`, `[!UNAVAIL=return]`)
// overrides them.
pub struct Source { name: string, success_return: boolean, notfound_return: boolean, unavail_return: boolean }

pub function source(name: string): Source {
  return Source { name: name, success_return: true, notfound_return: false, unavail_return: false };
}

// `default_sources()` — glibc's compiled-in `hosts:` line, used when
// /etc/nsswitch.conf is missing: `files dns`.
pub function default_sources(): Source[] {
  return [source("files"), source("dns")];
}

// `nsswitch_hosts(contents)` — the sources of the `hosts:` line, in order,
// with their actions. No `hosts:` line means the compiled-in default; a
// present but empty one means no sources at all.
pub function nsswitch_hosts(contents: string): Source[] {
  var lines: string[] = contents.lines();
  var i: i32 = 0;
  while (i < lines.len()) {
    var line: string = strip_comment(lines[i]).trim() + "";
    i = i + 1;
    if (!line.starts_with("hosts:")) {
      continue;
    }
    return parse_sources(slice_unchecked(line, 6, line.len()) + "");
  }
  return default_sources();
}

// The line up to its `#`, if any.
function strip_comment(line: string): string {
  var h: i32 = line.index_of("#");
  if (h < 0) {
    return line;
  }
  return slice_unchecked(line, 0, h) + "";
}

// The tokens after `hosts:`: a bare word is a source, and a bracketed
// group applies its `STATUS=action` pairs to the source before it.
function parse_sources(rest: string): Source[] {
  var out: Source[] = [];
  var toks: string[] = rest.fields();
  var in_bracket: boolean = false;
  var i: i32 = 0;
  while (i < toks.len()) {
    var t: string = toks[i];
    i = i + 1;
    if (t.starts_with("[")) {
      in_bracket = true;
      t = slice_unchecked(t, 1, t.len()) + "";
    }
    var closes: boolean = t.ends_with("]");
    if (closes) {
      t = slice_unchecked(t, 0, t.len() - 1) + "";
    }
    if (in_bracket) {
      if (t.len() > 0 && out.len() > 0) {
        out = out.with(out.len() - 1, apply_action(out[out.len() - 1], t));
      }
    } else if (t.len() > 0) {
      out = out.append(source(t));
    }
    if (closes) {
      in_bracket = false;
    }
  }
  return out;
}

// One `[!]STATUS=action` pair applied to `s`. Case-insensitive; `!`
// negates the status, so the action lands on every OTHER status. An
// action other than `return` is `continue` (`merge` continues too).
function apply_action(s: Source, pair: string): Source {
  var eq: i32 = pair.index_of("=");
  if (eq < 0) {
    return s;
  }
  var status: string = (slice_unchecked(pair, 0, eq) + "").to_ascii_lower();
  var ret: boolean = (slice_unchecked(pair, eq + 1, pair.len()) + "").eq_ignore_ascii_case("return");
  var negate: boolean = status.starts_with("!");
  if (negate) {
    status = slice_unchecked(status, 1, status.len()) + "";
  }
  var on_success: boolean = status == "success";
  var on_notfound: boolean = status == "notfound";
  var on_unavail: boolean = status == "unavail" || status == "tryagain";
  if (!on_success && !on_notfound && !on_unavail) {
    return s;
  }
  var r: Source = s;
  if (on_success != negate) {
    r = Source { ...r, success_return: ret };
  }
  if (on_notfound != negate) {
    r = Source { ...r, notfound_return: ret };
  }
  if (on_unavail != negate) {
    r = Source { ...r, unavail_return: ret };
  }
  return r;
}

// `(s).stops(status)` — whether a source reporting `status` ends the
// lookup, per its actions.
pub function (s: Source) stops(status: i32): boolean {
  if (status == success()) {
    return s.success_return;
  }
  if (status == notfound()) {
    return s.notfound_return;
  }
  return s.unavail_return;
}

// The `hosts:` line of this machine's nsswitch.conf, or the default.
function system_sources(): Source[] {
  match (read_file("/etc/nsswitch.conf")) {
    Ok(c) => {
      return nsswitch_hosts(c);
    },
    Err(_) => {
      return default_sources();
    }
  }
  return default_sources();
}

// ---- the lookups --------------------------------------------------------------
// `lookup(name, sources)` — the NSS walk for an IPv4 address: each source
// in turn until one answers or one's action ends the walk.
pub function lookup(name: string, sources: Source[]): Option[i32] {
  var i: i32 = 0;
  while (i < sources.len()) {
    var s: Source = sources[i];
    var r: (i32, i32) = lookup_source(s.name, name);
    if (r.0 == success()) {
      return Some(r.1);
    }
    if (s.stops(r.0)) {
      return None;
    }
    i = i + 1;
  }
  return None;
}

// The `files` source is the hosts file's first IPv4 address for the
// name, UNAVAIL when the file cannot be read; the `dns` source the first
// A record res_search finds.
function lookup_source(src: string, name: string): (i32, i32) {
  if (src == "files") {
    return files_lookup(name);
  }
  if (src == "dns") {
    return dns_lookup(name);
  }
  return (unavail(), 0);
}

function files_lookup(name: string): (i32, i32) {
  match (read_file("/etc/hosts")) {
    Ok(c) => {
      return found_word(first_v4_word(dns.hosts_lookup(dns.parse_hosts(c), name)));
    },
    Err(_) => {
      return (unavail(), 0);
    }
  }
  return (unavail(), 0);
}

function dns_lookup(name: string): (i32, i32) {
  match (dns.lookup_a(dns.system_conf(), name)) {
    Ok(xs) => {
      return found_word(first_v4_word(xs));
    },
    Err(e) => {
      return (nss_status(e), 0);
    }
  }
  return (unavail(), 0);
}

// SUCCESS with the word, or NOTFOUND.
function found_word(w: Option[i32]): (i32, i32) {
  match (w) {
    Some(v) => {
      return (success(), v);
    },
    None => {
      return (notfound(), 0);
    }
  }
  return (notfound(), 0);
}

// `resolve(name)` — gethostid's lookup of `name`: the in_addr word of its
// first IPv4 address through this machine's `hosts:` sources.
pub function resolve(name: string): Option[i32] {
  return lookup(name, system_sources());
}

// `canon_host(name)` — getaddrinfo's AI_CANONNAME for `name` over the
// same walk, for `who --lookup`: an address literal is its own canonical
// name; the files backend answers the first name of the first hosts line
// naming it, of either address family; the dns backend the owner of the
// A record at the end of the CNAME chain.
pub function canon_host(name: string): Option[string] {
  match (net.ip_parse(name)) {
    Some(_) => {
      return Some(name);
    },
    None => {}
  }
  var sources: Source[] = system_sources();
  var i: i32 = 0;
  while (i < sources.len()) {
    var s: Source = sources[i];
    var r: (i32, string) = canon_source(s.name, name);
    if (r.0 == success()) {
      return Some(r.1);
    }
    if (s.stops(r.0)) {
      return None;
    }
    i = i + 1;
  }
  return None;
}

function canon_source(src: string, name: string): (i32, string) {
  if (src == "files") {
    match (read_file("/etc/hosts")) {
      Ok(c) => {
        match (dns.hosts_canonical(dns.parse_hosts(c), name)) {
          Some(n) => {
            return (success(), n);
          },
          None => {
            return (notfound(), "");
          }
        }
      },
      Err(_) => {
        return (unavail(), "");
      }
    }
  }
  if (src == "dns") {
    match (dns.canonical_name(dns.system_conf(), name)) {
      Ok(n) => {
        return (success(), n);
      },
      Err(e) => {
        return (nss_status(e), "");
      }
    }
  }
  return (unavail(), "");
}
