import "std/string";
import "./fnmatch";

pub function text(): string {
  let out = "";
  out += "# Configuration file for dircolors, a utility to help you set the\n";
  out += "# LS_COLORS environment variable used by GNU ls with the --color option.\n";
  out += "# Copyright (C) 1996-2026 Free Software Foundation, Inc.\n";
  out += "# Copying and distribution of this file, with or without modification,\n";
  out += "# are permitted provided the copyright notice and this notice are preserved.\n";
  out += "#\n";
  out += "# The keywords COLOR, OPTIONS, and EIGHTBIT (honored by the\n";
  out += "# slackware version of dircolors) are recognized but ignored.\n";
  out += "# Global config options can be specified before TERM or COLORTERM entries\n";
  out += "# ===================================================================\n";
  out += "# Terminal filters\n";
  out += "# ===================================================================\n";
  out += "# Below are TERM or COLORTERM entries, which can be glob patterns, which\n";
  out += "# restrict following config to systems with matching environment variables.\n";
  out += "COLORTERM ?*\n";
  out += "TERM Eterm\n";
  out += "TERM ansi\n";
  out += "TERM *color*\n";
  out += "TERM con[0-9]*x[0-9]*\n";
  out += "TERM cons25\n";
  out += "TERM console\n";
  out += "TERM cygwin\n";
  out += "TERM *direct*\n";
  out += "TERM dtterm\n";
  out += "TERM gnome\n";
  out += "TERM hurd\n";
  out += "TERM jfbterm\n";
  out += "TERM konsole\n";
  out += "TERM kterm\n";
  out += "TERM linux\n";
  out += "TERM linux-c\n";
  out += "TERM mlterm\n";
  out += "TERM putty\n";
  out += "TERM rxvt*\n";
  out += "TERM screen*\n";
  out += "TERM st\n";
  out += "TERM terminator\n";
  out += "TERM tmux*\n";
  out += "TERM vt100\n";
  out += "TERM vt220\n";
  out += "TERM xterm*\n";
  out += "# ===================================================================\n";
  out += "# Basic file attributes\n";
  out += "# ===================================================================\n";
  out += "# Below are the color init strings for the basic file types.\n";
  out += "# One can use codes for 256 or more colors supported by modern terminals.\n";
  out += "# The default color codes use the capabilities of an 8 color terminal\n";
  out += "# with some additional attributes as per the following codes:\n";
  out += "# Attribute codes:\n";
  out += "# 00=none 01=bold 04=underscore 05=blink 07=reverse 08=concealed\n";
  out += "# Text color codes:\n";
  out += "# 30=black 31=red 32=green 33=yellow 34=blue 35=magenta 36=cyan 37=white\n";
  out += "# Background color codes:\n";
  out += "# 40=black 41=red 42=green 43=yellow 44=blue 45=magenta 46=cyan 47=white\n";
  out += "#NORMAL 00 # no color code at all\n";
  out += "#FILE 00 # regular file: use no color at all\n";
  out += "RESET 0 # reset to \"normal\" color\n";
  out += "DIR 01;34 # directory\n";
  out += "LINK 01;36 # symbolic link. (If you set this to 'target' instead of a\n";
  out += " # numerical value, the color is as for the file pointed to.)\n";
  out += "MULTIHARDLINK 00 # regular file with more than one link\n";
  out += "FIFO 40;33 # pipe\n";
  out += "SOCK 01;35 # socket\n";
  out += "DOOR 01;35 # door\n";
  out += "BLK 40;33;01 # block device driver\n";
  out += "CHR 40;33;01 # character device driver\n";
  out += "ORPHAN 40;31;01 # symlink to nonexistent file, or non-stat'able file ...\n";
  out += "MISSING 00 # ... and the files they point to\n";
  out += "SETUID 37;41 # regular file that is setuid (u+s)\n";
  out += "SETGID 30;43 # regular file that is setgid (g+s)\n";
  out += "CAPABILITY 00 # regular file with capability (very expensive to lookup)\n";
  out += "STICKY_OTHER_WRITABLE 30;42 # dir that is sticky and other-writable (+t,o+w)\n";
  out += "OTHER_WRITABLE 34;42 # dir that is other-writable (o+w) and not sticky\n";
  out += "STICKY 37;44 # dir with the sticky bit set (+t) and not other-writable\n";
  out += "# This is for regular files with execute permission:\n";
  out += "EXEC 01;32\n";
  out += "# ===================================================================\n";
  out += "# File extension attributes\n";
  out += "# ===================================================================\n";
  out += "# List any file extensions like '.gz' or '.tar' that you would like ls\n";
  out += "# to color below. Put the suffix, a space, and the color init string.\n";
  out += "# (and any comments you want to add after a '#').\n";
  out += "# Suffixes are matched case insensitively, but if you define different\n";
  out += "# init strings for separate cases, those will be honored.\n";
  out += "#\n";
  out += "# If you use DOS-style suffixes, you may want to uncomment the following:\n";
  out += "#.cmd 01;32 # executables (bright green)\n";
  out += "#.exe 01;32\n";
  out += "#.com 01;32\n";
  out += "#.btm 01;32\n";
  out += "#.bat 01;32\n";
  out += "# Or if you want to color scripts even if they do not have the\n";
  out += "# executable bit actually set.\n";
  out += "#.sh 01;32\n";
  out += "#.csh 01;32\n";
  out += "# archives or compressed (bright red)\n";
  out += ".7z 01;31\n";
  out += ".ace 01;31\n";
  out += ".alz 01;31\n";
  out += ".apk 01;31\n";
  out += ".arc 01;31\n";
  out += ".arj 01;31\n";
  out += ".bz 01;31\n";
  out += ".bz2 01;31\n";
  out += ".cab 01;31\n";
  out += ".cpio 01;31\n";
  out += ".crate 01;31\n";
  out += ".deb 01;31\n";
  out += ".drpm 01;31\n";
  out += ".dwm 01;31\n";
  out += ".dz 01;31\n";
  out += ".ear 01;31\n";
  out += ".egg 01;31\n";
  out += ".esd 01;31\n";
  out += ".gz 01;31\n";
  out += ".jar 01;31\n";
  out += ".lha 01;31\n";
  out += ".lrz 01;31\n";
  out += ".lz 01;31\n";
  out += ".lz4 01;31\n";
  out += ".lzh 01;31\n";
  out += ".lzma 01;31\n";
  out += ".lzo 01;31\n";
  out += ".pyz 01;31\n";
  out += ".rar 01;31\n";
  out += ".rpm 01;31\n";
  out += ".rz 01;31\n";
  out += ".sar 01;31\n";
  out += ".swm 01;31\n";
  out += ".t7z 01;31\n";
  out += ".tar 01;31\n";
  out += ".taz 01;31\n";
  out += ".tbz 01;31\n";
  out += ".tbz2 01;31\n";
  out += ".tgz 01;31\n";
  out += ".tlz 01;31\n";
  out += ".txz 01;31\n";
  out += ".tz 01;31\n";
  out += ".tzo 01;31\n";
  out += ".tzst 01;31\n";
  out += ".udeb 01;31\n";
  out += ".war 01;31\n";
  out += ".whl 01;31\n";
  out += ".wim 01;31\n";
  out += ".xz 01;31\n";
  out += ".z 01;31\n";
  out += ".zip 01;31\n";
  out += ".zoo 01;31\n";
  out += ".zst 01;31\n";
  out += "# image formats\n";
  out += ".avif 01;35\n";
  out += ".jpg 01;35\n";
  out += ".jpeg 01;35\n";
  out += ".jxl 01;35\n";
  out += ".mjpg 01;35\n";
  out += ".mjpeg 01;35\n";
  out += ".gif 01;35\n";
  out += ".bmp 01;35\n";
  out += ".pbm 01;35\n";
  out += ".pgm 01;35\n";
  out += ".ppm 01;35\n";
  out += ".tga 01;35\n";
  out += ".xbm 01;35\n";
  out += ".xpm 01;35\n";
  out += ".tif 01;35\n";
  out += ".tiff 01;35\n";
  out += ".png 01;35\n";
  out += ".svg 01;35\n";
  out += ".svgz 01;35\n";
  out += ".mng 01;35\n";
  out += ".pcx 01;35\n";
  out += ".mov 01;35\n";
  out += ".mpg 01;35\n";
  out += ".mpeg 01;35\n";
  out += ".m2v 01;35\n";
  out += ".mkv 01;35\n";
  out += ".webm 01;35\n";
  out += ".webp 01;35\n";
  out += ".ogm 01;35\n";
  out += ".mp4 01;35\n";
  out += ".m4v 01;35\n";
  out += ".mp4v 01;35\n";
  out += ".vob 01;35\n";
  out += ".qt 01;35\n";
  out += ".nuv 01;35\n";
  out += ".wmv 01;35\n";
  out += ".asf 01;35\n";
  out += ".rm 01;35\n";
  out += ".rmvb 01;35\n";
  out += ".flc 01;35\n";
  out += ".avi 01;35\n";
  out += ".fli 01;35\n";
  out += ".flv 01;35\n";
  out += ".gl 01;35\n";
  out += ".dl 01;35\n";
  out += ".xcf 01;35\n";
  out += ".xwd 01;35\n";
  out += ".yuv 01;35\n";
  out += ".cgm 01;35\n";
  out += ".emf 01;35\n";
  out += "# https://wiki.xiph.org/MIME_Types_and_File_Extensions\n";
  out += ".ogv 01;35\n";
  out += ".ogx 01;35\n";
  out += "# audio formats\n";
  out += ".aac 00;36\n";
  out += ".au 00;36\n";
  out += ".flac 00;36\n";
  out += ".m4a 00;36\n";
  out += ".mid 00;36\n";
  out += ".midi 00;36\n";
  out += ".mka 00;36\n";
  out += ".mp3 00;36\n";
  out += ".mpc 00;36\n";
  out += ".ogg 00;36\n";
  out += ".ra 00;36\n";
  out += ".wav 00;36\n";
  out += "# https://wiki.xiph.org/MIME_Types_and_File_Extensions\n";
  out += ".oga 00;36\n";
  out += ".opus 00;36\n";
  out += ".spx 00;36\n";
  out += ".xspf 00;36\n";
  out += "# backup files\n";
  out += "*~ 00;90\n";
  out += "*# 00;90\n";
  out += ".bak 00;90\n";
  out += ".crdownload 00;90\n";
  out += ".dpkg-dist 00;90\n";
  out += ".dpkg-new 00;90\n";
  out += ".dpkg-old 00;90\n";
  out += ".dpkg-tmp 00;90\n";
  out += ".old 00;90\n";
  out += ".orig 00;90\n";
  out += ".part 00;90\n";
  out += ".rej 00;90\n";
  out += ".rpmnew 00;90\n";
  out += ".rpmorig 00;90\n";
  out += ".rpmsave 00;90\n";
  out += ".swp 00;90\n";
  out += ".tmp 00;90\n";
  out += ".ucf-dist 00;90\n";
  out += ".ucf-new 00;90\n";
  out += ".ucf-old 00;90\n";
  out += "#\n";
  out += "# Subsequent TERM or COLORTERM entries, can be used to add / override\n";
  out += "# config specific to those matching environment variables.\n";
  return out;
}

pub function term_known(term: string): boolean {
  if (term.len() == 0) {
    return false;
  }
  let lines = text().lines();
  let i = 0;
  while (i < lines.len()) {
    let line = lines[i];
    if (line.starts_with("TERM ")) {
      if (fnmatch.fnmatch(slice_unchecked(line, 5, line.len()) + "", term)) {
        return true;
      }
    }
    i += 1;
  }
  return false;
}
