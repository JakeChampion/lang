import "std/string";
import "std/array";
import "std/errno";
import "./gnu";

pub function enabled(): boolean {
  match (read_file("/proc/self/mounts")) {
    Ok(text) => {
      let lines = text.lines();
      let i = 0;
      while (i < lines.len()) {
        let f = lines[i].fields();
        if (f.len() >= 3 && f[2] == "selinuxfs") {
          return true;
        }
        i += 1;
      }
      return false;
    },
    Err(_) => {
      return false;
    }
  }
}

pub function trim_context(text: string): string {
  let n = text.len();
  while (n > 0 && text[n - 1] as i32 == 0) {
    n -= 1;
  }
  return slice_unchecked(text, 0, n) + "";
}

pub function context(): Result[string, IoError] {
  if (target_os() == "darwin") {
    return Err(Unsupported);
  }
  match (read_file("/proc/self/attr/current")) {
    Ok(text) => {
      return Ok(trim_context(text));
    },
    Err(e) => {
      return Err(e);
    }
  }
}

pub function file_context(path: string, follow: boolean): Result[string, IoError] {
  if (target_os() == "darwin") {
    return Err(Unsupported);
  }
  let got: Result[string, IoError] = if (follow) { getxattr(path, "security.selinux") } else { lgetxattr(path, "security.selinux") };
  match (got) {
    Ok(v) => {
      let ctx = trim_context(v);
      if (ctx.len() == 0) {
        return Err(Unsupported);
      }
      return Ok(ctx);
    },
    Err(e) => {
      return Err(e);
    }
  }
}

pub function set_file_context(path: string, ctx: string, follow: boolean): Result[void, IoError] {
  if (target_os() == "darwin") {
    return Err(Unsupported);
  }
  let value = ctx + "\x00";
  let put: Result[void, IoError] = if (follow) { setxattr(path, "security.selinux", value) } else { lsetxattr(path, "security.selinux", value) };
  match (put) {
    Ok(_) => {
      return Ok(());
    },
    Err(e) => {
      if (errno.of(e) == errno.ENOTSUP) {
        match (file_context(path, follow)) {
          Ok(cur) => {
            if (cur == ctx) {
              return Ok(());
            }
          },
          Err(_) => {}
        }
      }
      return Err(e);
    }
  }
}

pub function merge_context(ctx: string, comps: string[], set: boolean[]): Result[string, string[]] {
  let parts: string[] = ["", "", "", ""];
  let has_range = false;
  let colons = 0;
  let start = 0;
  let i = 0;
  while (i < ctx.len()) {
    let b = ctx[i] as i32;
    if (b == 10 || b == 9 || b == 13 || b == 32) {
      return Err(["failed to create security context: " + gnu.quote(ctx) + ": Invalid argument"]);
    }
    if (b == 58) {
      if (colons < 3) {
        parts = parts.with(colons, slice_unchecked(ctx, start, i) + "");
        start = i + 1;
      }
      colons += 1;
    }
    i += 1;
  }
  if (colons < 2 || colons > 5) {
    return Err(["failed to create security context: " + gnu.quote(ctx) + ": Invalid argument"]);
  }
  let last = colons;
  if (last > 3) {
    last = 3;
  }
  parts = parts.with(last, slice_unchecked(ctx, start, ctx.len()) + "");
  has_range = colons > 2;
  let names: string[] = ["user", "role", "type", "range"];
  let errs: string[] = [];
  for k in [0, 3, 1, 2] {
    if (set[k]) {
      if (component_ok(comps[k], k == 3)) {
        parts = parts.with(k, comps[k]);
        if (k == 3) {
          has_range = true;
        }
      } else {
        errs = errs.append("failed to set " + names[k] + " security context component to " + gnu.quote(comps[k]) + ": Invalid argument");
      }
    }
  }
  if (errs.len() > 0) {
    return Err(errs);
  }
  let out = parts[0] + ":" + parts[1] + ":" + parts[2];
  if (has_range) {
    out = out + ":" + parts[3];
  }
  return Ok(out);
}

function component_ok(v: string, is_range: boolean): boolean {
  let i = 0;
  while (i < v.len()) {
    let b = v[i] as i32;
    if (b == 9 || b == 10 || b == 13) {
      return false;
    }
    if (!is_range && (b == 58 || b == 32)) {
      return false;
    }
    i += 1;
  }
  return true;
}
