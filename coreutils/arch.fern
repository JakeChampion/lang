// arch.fern — GNU-compatible `arch`.
//
//   arch    print the machine hardware name
//
// coreutils builds arch from uname's source with the mode switched: the
// option table is the two standard options and nothing else, the output
// is `uname -m` and there are no operands. Every operand is
// `extra operand`; the scan permutes, so `arch x --help` prints the help
// before it ever complains about `x`.
import "./lib/gnu";
import "./lib/sys";

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]...\n";
  out = out + "Print machine architecture.\n";
  out = out + "\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function main(): i32 {
  var operands: string[] = gnu.parse_standard_options_only(args(), "arch", help_text(), 1);
  if (operands.len() > 0) {
    gnu.die_usage("extra operand " + gnu.quote(operands[0]), 1);
  }
  gnu.write_out(sys.machine() + "\n");
  return 0;
}
