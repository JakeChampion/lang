import "std/errno";
import "./lib/filetype";
import "./lib/fts";
import "./lib/gnu";

function opt_force(): i32 {
  return 1;
}

function opt_interactive_always(): i32 {
  return 2;
}

function opt_interactive_once(): i32 {
  return 3;
}

function opt_interactive(): i32 {
  return 4;
}

function opt_one_file_system(): i32 {
  return 5;
}

function opt_no_preserve_root(): i32 {
  return 6;
}

function opt_preserve_root(): i32 {
  return 7;
}

function opt_presume_tty(): i32 {
  return 8;
}

function opt_recursive(): i32 {
  return 9;
}

function opt_dir(): i32 {
  return 10;
}

function opt_verbose(): i32 {
  return 11;
}

function rmi_never(): i32 {
  return 0;
}

function rmi_once(): i32 {
  return 1;
}

function rmi_always(): i32 {
  return 2;
}

function rmi_sometimes(): i32 {
  return 3;
}

function when_names(): string[] {
  let out: string[] = [];
  out = out.append("never");
  out = out.append("no");
  out = out.append("none");
  out = out.append("once");
  out = out.append("always");
  out = out.append("yes");
  return out;
}

function when_values(): i32[] {
  let out: i32[] = [];
  out = out.append(rmi_never());
  out = out.append(rmi_never());
  out = out.append(rmi_never());
  out = out.append(rmi_once());
  out = out.append(rmi_always());
  out = out.append(rmi_always());
  return out;
}

function res_ok(): i32 {
  return 0;
}

function res_keep(): i32 {
  return 1;
}

function res_mark(): i32 {
  return 2;
}

struct Settings { interactive: i32, ignore_missing: boolean, one_file_system: boolean, preserve_root: boolean, preserve_all: boolean, recursive: boolean, dir: boolean, verbose: boolean, tty: boolean }

struct St { out: gnu.Stdio, status: i32 }

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Remove (unlink) the FILE(s).\n";
  out = out + "\n";
  out = out + "  -f, --force           ignore nonexistent files and arguments, never prompt\n";
  out = out + "  -i                    prompt before every removal\n";
  out = out + "  -I                    prompt once before removing more than three files, or\n";
  out = out + "                          when removing recursively\n";
  out = out + "      --interactive[=WHEN]  prompt according to WHEN: never, once (-I), or\n";
  out = out + "                          always (-i); without WHEN, prompt always\n";
  out = out + "      --one-file-system  when removing a hierarchy recursively, skip any\n";
  out = out + "                          directory that is on a file system different from\n";
  out = out + "                          that of the corresponding command line argument\n";
  out = out + "      --no-preserve-root  do not treat '/' specially\n";
  out = out + "      --preserve-root[=all]  do not remove '/' (default); with 'all', reject\n";
  out = out + "                          any command line argument on a separate device\n";
  out = out + "  -r, -R, --recursive   remove directories and their contents recursively\n";
  out = out + "  -d, --dir             remove empty directories\n";
  out = out + "  -v, --verbose         explain what is being done\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "By default, rm does not remove directories.  Use the --recursive (-r)\n";
  out = out + "option to remove each listed directory, too, along with all of its contents.\n";
  out = out + "\n";
  out = out + "To remove a file whose name starts with a '-', for example '-foo',\n";
  out = out + "use one of these commands:\n";
  out = out + "  " + gnu.prog() + " -- -foo\n";
  out = out + "  " + gnu.prog() + " ./-foo\n";
  return out;
}

function base_name(p: string): string {
  let end: i32 = p.len();
  while (end > 0 && p[end - 1] as i32 == 47) {
    end = end - 1;
  }
  let start: i32 = end;
  while (start > 0 && p[start - 1] as i32 != 47) {
    start = start - 1;
  }
  return slice_unchecked(p, start, end) + "";
}

function parent_name(p: string): string {
  let end: i32 = p.len();
  while (end > 0 && p[end - 1] as i32 == 47) {
    end = end - 1;
  }
  while (end > 0 && p[end - 1] as i32 != 47) {
    end = end - 1;
  }
  while (end > 1 && p[end - 1] as i32 == 47) {
    end = end - 1;
  }
  if (end == 0) {
    return ".";
  }
  return slice_unchecked(p, 0, end) + "";
}

function nonexistent_errno(e: IoError): boolean {
  let n: i32 = errno.of(e);
  return n == errno.ENOENT || n == errno.ENOTDIR;
}

function fail(st: St, msg: string): St {
  return St { out: st.out.report(msg), status: 1 };
}

struct Ent { path: string, dir: Option[Dir], name: string }

function operand(path: string): Ent {
  return Ent { path: path, dir: None, name: path };
}

function ent_lstat(e: Ent): Result[FileStat, IoError] {
  match (e.dir) {
    Some(d) => {
      return d.lstat(e.name);
    },
    None => {
      return lstat(e.path);
    }
  }
}

function ent_access(e: Ent, mode: i32): Result[void, IoError] {
  match (e.dir) {
    Some(d) => {
      return d.access(e.name, mode);
    },
    None => {
      return access(e.path, mode);
    }
  }
}

function ent_remove_file(e: Ent): Result[void, IoError] {
  match (e.dir) {
    Some(d) => {
      return d.remove_file(e.name);
    },
    None => {
      return remove_file(e.path);
    }
  }
}

function ent_remove_dir(e: Ent): Result[void, IoError] {
  match (e.dir) {
    Some(d) => {
      return d.remove_dir(e.name);
    },
    None => {
      return remove_dir(e.path);
    }
  }
}

function ent_open(e: Ent): Result[Dir, IoError] {
  match (e.dir) {
    Some(d) => {
      return d.open_dir(e.name);
    },
    None => {
      return open_dir(e.path);
    }
  }
}

function cannot_remove(st: St, path: string, e: IoError): St {
  return fail(st, "cannot remove " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
}

function write_protected(e: Ent, mode: u32): boolean {
  if (filetype.is_link(mode)) {
    return false;
  }
  match (ent_access(e, 2)) {
    Ok(_) => {
      return false;
    },
    Err(why) => {
      return errno.of(why) == errno.EACCES;
    }
  }
}

function prompt_stats(s: Settings, top: boolean): boolean {
  if (s.interactive == rmi_always()) {
    return true;
  }
  return s.interactive == rmi_sometimes() && s.tty && !top;
}

function confirm(s: Settings, e: Ent, mode: u32, verb: string, what: string): boolean {
  if (s.interactive == rmi_never()) {
    return true;
  }
  let wp: boolean = write_protected(e, mode);
  if (s.interactive != rmi_always()) {
    if (!wp || !s.tty) {
      return true;
    }
  }
  let prefix: string = "";
  if (wp) {
    prefix = "write-protected ";
  }
  return gnu.prompt(verb + " " + prefix + what + " " + gnu.quotea(e.path) + "? ");
}

function verbose(st: St, s: Settings, path: string, is_dir: boolean): St {
  if (!s.verbose) {
    return st;
  }
  let what: string = "removed ";
  if (is_dir) {
    what = "removed directory ";
  }
  return St { ...st, out: st.out.fwrite(what + gnu.quotea(path) + "\n") };
}

function rm_entry(st0: St, s: Settings, ent: Ent, top: boolean, cl_dev: i64): (St, i32) {
  let st: St = st0;
  let path: string = ent.path;
  match (ent_lstat(ent)) {
    Err(why) => {
      if (prompt_stats(s, top)) {
        return (cannot_remove(st, path, why), res_keep());
      }
      match (ent_remove_file(ent)) {
        Ok(_) => {
          return (verbose(st, s, path, false), res_ok());
        },
        Err(e) => {
          if (s.ignore_missing && nonexistent_errno(e)) {
            return (st, res_ok());
          }
          return (cannot_remove(st, path, e), res_mark());
        }
      }
    },
    Ok(info) => {
      if (filetype.is_dir(info.mode)) {
        return rm_dir(st, s, ent, top, cl_dev, info);
      }
      if (!confirm(s, ent, info.mode, "remove", filetype.type_name(info.mode, info.size))) {
        return (st, res_keep());
      }
      match (ent_remove_file(ent)) {
        Ok(_) => {
          return (verbose(st, s, path, false), res_ok());
        },
        Err(e) => {
          if (s.ignore_missing && nonexistent_errno(e)) {
            return (st, res_ok());
          }
          return (cannot_remove(st, path, e), res_mark());
        }
      }
    }
  }
  return (st, res_ok());
}

function refuse_dir(st: St, s: Settings, path: string, top: boolean, cl_dev: i64, info: FileStat): Option[St] {
  if (!s.recursive) {
    if (!s.dir) {
      return Some(fail(st, "cannot remove " + gnu.quotea(path) + ": Is a directory"));
    }
    return None;
  }
  if (top) {
    let base: string = base_name(path);
    if (base == "." || base == "..") {
      return Some(fail(st, "refusing to remove '.' or '..' directory: skipping " + gnu.quotea(path)));
    }
    if (s.preserve_root && is_root_dir(info)) {
      let same: string = "";
      if (path != "/") {
        same = " (same as '/')";
      }
      let next: St = fail(st, "it is dangerous to operate recursively on " + gnu.quotea(path) + same);
      return Some(fail(next, "use --no-preserve-root to override this failsafe"));
    }
    if (s.preserve_all && crosses_device(path, info)) {
      let first: St = fail(st, "skipping " + gnu.quotea(path) + ", since it's on a different device");
      return Some(fail(first, "and --preserve-root=all is in effect"));
    }
  } else if (s.one_file_system && info.dev != cl_dev) {
    return Some(fail(st, "skipping " + gnu.quotea(path) + ", since it's on a different device"));
  }
  return None;
}

function is_root_dir(info: FileStat): boolean {
  match (lstat("/")) {
    Ok(root) => {
      return info.dev == root.dev && info.ino == root.ino;
    },
    Err(_) => {
      return false;
    }
  }
}

function crosses_device(path: string, info: FileStat): boolean {
  match (lstat(parent_name(path))) {
    Ok(parent) => {
      return info.dev != parent.dev;
    },
    Err(_) => {
      return false;
    }
  }
}

function rm_dir(st0: St, s: Settings, ent: Ent, top: boolean, cl_dev: i64, info: FileStat): (St, i32) {
  let st: St = st0;
  let path: string = ent.path;
  let unread: Option[IoError] = None;
  let names: string[] = [];
  let held: Option[Dir] = None;
  if (s.recursive || s.dir) {
    match (ent_open(ent)) {
      Ok(d) => {
        held = Some(d);
        match (d.entries()) {
          Ok(es) => {
            names = es;
          },
          Err(e) => {
            unread = Some(e);
          }
        }
      },
      Err(e) => {
        unread = Some(e);
      }
    }
  }
  let empty: boolean = names.len() == 0;
  match (refuse_dir(st, s, path, top, cl_dev, info)) {
    Some(next) => {
      release(held);
      return (next, res_mark());
    },
    None => {}
  }
  match (unread) {
    Some(e) => {
      release(held);
      return rm_unreadable_dir(st, s, ent, info, e);
    },
    None => {}
  }
  let descended: boolean = s.recursive && !empty;
  if (descended) {
    if (!confirm(s, ent, info.mode, "descend into", "directory")) {
      release(held);
      return (st, res_mark());
    }
    let dev: i64 = cl_dev;
    if (top) {
      dev = info.dev;
    }
    let below: (St, boolean) = rm_children(st, s, path, held, names, dev);
    st = below.0;
    if (below.1) {
      release(held);
      return (st, res_mark());
    }
  }
  release(held);
  if (!confirm(s, ent, info.mode, "remove", "directory")) {
    if (descended) {
      return (st, res_keep());
    }
    return (st, res_mark());
  }
  match (ent_remove_dir(ent)) {
    Ok(_) => {
      return (verbose(st, s, path, true), res_ok());
    },
    Err(e) => {
      if (s.ignore_missing && nonexistent_errno(e)) {
        return (st, res_ok());
      }
      return (cannot_remove(st, path, e), res_mark());
    }
  }
  return (st, res_ok());
}

function release(held: Option[Dir]): void {
  match (held) {
    Some(d) => {
      d.close();
    },
    None => {}
  }
}

function rm_children(st0: St, s: Settings, path: string, held: Option[Dir], names: string[], dev: i64): (St, boolean) {
  let st: St = st0;
  let marked: boolean = false;
  let i: i32 = 0;
  while (i < names.len()) {
    let child: Ent = Ent { path: fts.child_path(path, names[i]), dir: held, name: names[i] };
    let r: (St, i32) = rm_entry(st, s, child, false, dev);
    st = r.0;
    if (r.1 == res_mark()) {
      marked = true;
    }
    i = i + 1;
  }
  return (st, marked);
}

function rm_unreadable_dir(st: St, s: Settings, ent: Ent, info: FileStat, why: IoError): (St, i32) {
  let path: string = ent.path;
  let asks: boolean = s.interactive == rmi_always();
  if (s.interactive == rmi_sometimes()) {
    asks = s.tty && write_protected(ent, info.mode);
  }
  if (!asks) {
    match (ent_remove_dir(ent)) {
      Ok(_) => {
        return (verbose(st, s, path, true), res_ok());
      },
      Err(_) => {}
    }
  }
  return (cannot_remove(st, path, why), res_mark());
}

function removable_operand_hint(argv: string[]): string {
  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a.len() > 1 && a[0] as i32 == 45) {
      match (lstat(a)) {
        Ok(_) => {
          return "Try '" + gnu.prog() + " ./" + gnu.quotef(a) + "' to remove the file " + gnu.quotea(a) + ".";
        },
        Err(_) => {}
      }
    }
    i = i + 1;
  }
  return "";
}

function option_table(): gnu.Opt[] {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("f", "force", opt_force()));
  opts = opts.append(gnu.flag("i", "", opt_interactive_always()));
  opts = opts.append(gnu.flag("I", "", opt_interactive_once()));
  opts = opts.append(gnu.optional_long("", "interactive", opt_interactive()));
  opts = opts.append(gnu.flag("", "one-file-system", opt_one_file_system()));
  opts = opts.append(gnu.flag("", "no-preserve-root", opt_no_preserve_root()));
  opts = opts.append(gnu.optional_long("", "preserve-root", opt_preserve_root()));
  opts = opts.append(gnu.flag("", "-presume-input-tty", opt_presume_tty()));
  opts = opts.append(gnu.flag("r", "recursive", opt_recursive()));
  opts = opts.append(gnu.flag("R", "", opt_recursive()));
  opts = opts.append(gnu.flag("d", "dir", opt_dir()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));
  return opts;
}

function parse(argv: string[]): (Settings, gnu.Getopt) {
  let s: Settings = Settings { interactive: rmi_sometimes(), ignore_missing: false, one_file_system: false, preserve_root: true, preserve_all: false, recursive: false, dir: false, verbose: false, tty: false };
  let presume: boolean = false;
  let g: gnu.Getopt = gnu.getopt_new(argv, option_table(), "rm", help_text(), 1);
  g = g.fault_hint(removable_operand_hint(argv));
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_force()) {
          s = Settings { ...s, interactive: rmi_never(), ignore_missing: true };
        } else if (m.id == opt_interactive_always()) {
          s = Settings { ...s, interactive: rmi_always(), ignore_missing: false };
        } else if (m.id == opt_interactive_once()) {
          s = Settings { ...s, interactive: rmi_once(), ignore_missing: false };
        } else if (m.id == opt_interactive()) {
          let mode: i32 = rmi_always();
          if (m.has_value) {
            mode = gnu.argmatch_valued(m.value, when_names(), when_values(), "--interactive");
          }
          s = Settings { ...s, interactive: mode };
        } else if (m.id == opt_one_file_system()) {
          s = Settings { ...s, one_file_system: true };
        } else if (m.id == opt_no_preserve_root()) {
          if (argv[g.index() - 1] != "--no-preserve-root") {
            gnu.error("you may not abbreviate the --no-preserve-root option");
            exit(1);
          }
          s = Settings { ...s, preserve_root: false };
        } else if (m.id == opt_preserve_root()) {
          let all: boolean = s.preserve_all;
          if (m.has_value) {
            if (m.value != "all") {
              gnu.error("unrecognized --preserve-root argument: " + gnu.quote(m.value));
              exit(1);
            }
            all = true;
          }
          s = Settings { ...s, preserve_root: true, preserve_all: all };
        } else if (m.id == opt_presume_tty()) {
          presume = true;
        } else if (m.id == opt_recursive()) {
          s = Settings { ...s, recursive: true };
        } else if (m.id == opt_dir()) {
          s = Settings { ...s, dir: true };
        } else if (m.id == opt_verbose()) {
          s = Settings { ...s, verbose: true };
        }
      },
      None => {
        break;
      }
    }
  }
  return (Settings { ...s, tty: presume || isatty(0) }, g);
}

function prompt_once(s: Settings, n: i32): boolean {
  if (s.interactive != rmi_once() || !(s.recursive || n > 3)) {
    return true;
  }
  let noun: string = " arguments";
  if (n == 1) {
    noun = " argument";
  }
  let how: string = "";
  if (s.recursive) {
    how = " recursively";
  }
  return gnu.prompt("remove " + n.to_string() + noun + how + "? ");
}

pub function main(): i32 {
  let parsed: (Settings, gnu.Getopt) = parse(args());
  let s: Settings = parsed.0;
  let files: string[] = parsed.1.operands();
  if (files.len() == 0) {
    if (s.ignore_missing) {
      return 0;
    }
    gnu.die_usage("missing operand", 1);
  }
  if (!prompt_once(s, files.len())) {
    return 0;
  }
  if (s.interactive == rmi_once()) {
    s = Settings { ...s, interactive: rmi_sometimes() };
  }
  let st: St = St { out: gnu.stdio_new(), status: 0 };
  let i: i32 = 0;
  while (i < files.len()) {
    let path: string = fts.trim(files[i]);
    let r: (St, i32) = rm_entry(st, s, operand(path), true, 0 as i64);
    st = r.0;
    i = i + 1;
  }
  st.out.close_stdout();
  return st.status;
}
