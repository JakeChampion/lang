import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION] NAME...\n";
  out += "Output each NAME with its last non-slash component and trailing slashes\n";
  out += "removed; if NAME contains no /'s, output '.' (meaning the current directory).\n";
  out += "\n";
  out += "  -z, --zero     end each output line with NUL, not newline\n";
  out += "      --help     display this help and exit\n";
  out += "      --version  output version information and exit\n";
  return out;
}

function dir_name(s: string): string {
  let end = s.len();
  while (end > 0 && s[end - 1] as i32 == 47) {
    end -= 1;
  }
  if (end == 0) {
    if (s.len() > 0) {
      return "/";
    }
    return ".";
  }
  let i = end;
  while (i > 0 && s[i - 1] as i32 != 47) {
    i -= 1;
  }
  if (i == 0) {
    return ".";
  }
  while (i > 0 && s[i - 1] as i32 == 47) {
    i -= 1;
  }
  if (i == 0) {
    return "/";
  }
  return slice_unchecked(s, 0, i) + "";
}

pub function main(): i32 {
  let argv = args();
  let opts: gnu.Opt[] = [gnu.flag("z", "zero", 1)];
  let g = gnu.getopt_new(argv, opts, "dirname", help_text(), 1);
  let zero = false;
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(_) => {
        zero = true;
      },
      None => {
        break;
      }
    }
  }
  let operands = g.operands();
  if (operands.len() == 0) {
    gnu.die_usage("missing operand", 1);
  }
  let term = "\n";
  if (zero) {
    term = "\x00";
  }
  let o = gnu.out_new();
  let i = 0;
  while (i < operands.len()) {
    o = gnu.put(o, dir_name(operands[i]) + term);
    i += 1;
  }
  gnu.finish(o);
  return 0;
}
