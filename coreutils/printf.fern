import "std/string";
import "std/array";
import "std/i64";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/ld";

struct Pf { o: io_buffered.BufWriter, status: i32, werr: boolean, posix: boolean, ldbl: ld.Format }

function emit(p: Pf, s: string): Pf {
  return Pf { ...p, o: p.o.write_string(s) };
}

function emit_byte(p: Pf, b: i32): Pf {
  buf_push_byte(p.o.handle(), b);
  return Pf { ...p, o: p.o.settle() };
}

function emit_range(p: Pf, s: string, lo: i32, hi: i32): Pf {
  if (hi <= lo) {
    return p;
  }
  if (lo == 0 && hi == s.len()) {
    return emit(p, s);
  }
  return Pf { ...p, o: p.o.write_range(s, lo, hi) };
}

function diag(p: Pf, msg: string): Pf {
  let o: io_buffered.BufWriter = p.o.flush();
  gnu.error(msg);
  return Pf { ...p, o: o };
}

function diag_range(p: Pf, prefix: string, s: string, lo: i32, hi: i32, suffix: string): Pf {
  let o: io_buffered.BufWriter = p.o.flush();
  let h: usize = buf_new(prefix.len() + hi - lo + suffix.len());
  buf_push(h, gnu.prog());
  buf_push(h, ": ");
  buf_push(h, prefix);
  buf_push_range(h, s, lo, hi);
  buf_push(h, suffix);
  buf_push_byte(h, 10);
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  let w: Writer = stderr();
  w.write_bytes(bytes);
  return Pf { ...p, o: o };
}

function close_stdout(p: Pf, code: i32): void {
  gnu.close_stdout(p.o, p.werr);
  exit(code);
}

function fatal(p: Pf, msg: string): void {
  close_stdout(diag(p, msg), 1);
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " FORMAT [ARGUMENT]...\n";
  out = out + "  or:  " + gnu.prog() + " OPTION\n";
  out = out + "Print ARGUMENT(s) according to FORMAT, or execute according to OPTION:\n";
  out = out + "\n";
  out = out + "      --help     display this help and exit\n";
  out = out + "      --version  output version information and exit\n";
  out = out + "\n";
  out = out + "FORMAT controls the output as in C printf. Interpreted sequences are:\n";
  out = out + "\n";
  out = out + "  \\\"      double quote\n";
  out = out + "  \\\\      backslash\n";
  out = out + "  \\a      alert (BEL)\n";
  out = out + "  \\b      backspace\n";
  out = out + "  \\c      produce no further output\n";
  out = out + "  \\e      escape\n";
  out = out + "  \\f      form feed\n";
  out = out + "  \\n      new line\n";
  out = out + "  \\r      carriage return\n";
  out = out + "  \\t      horizontal tab\n";
  out = out + "  \\v      vertical tab\n";
  out = out + "  \\NNN    byte with octal value NNN (1 to 3 digits)\n";
  out = out + "  \\xHH    byte with hexadecimal value HH (1 to 2 digits)\n";
  out = out + "  \\uHHHH  Unicode character with hex value HHHH (4 digits)\n";
  out = out + "  \\UHHHHHHHH  Unicode character with hex value HHHHHHHH (8 digits)\n";
  out = out + "  %%      a single %\n";
  out = out + "  %b      ARGUMENT as a string with '\\' escapes interpreted,\n";
  out = out + "          except that octal escapes are of the form \\0 or \\0NNN\n";
  out = out + "  %q      ARGUMENT printed in a form that can be reused as shell input,\n";
  out = out + "          escaping non-printable characters with the POSIX $'' syntax\n";
  out = out + "\n";
  out = out + "and all C format specifications ending with one of diouxXfeEgGcs, with\n";
  out = out + "ARGUMENTs converted to proper type first. Variable widths are handled.\n";
  out = out + "\n";
  out = out + "Note that the shell usually has its own printf builtin, which is the one\n";
  out = out + "a command line reaches first.\n";
  return out;
}

function is_digit(b: i32): boolean {
  return b >= 48 && b <= 57;
}

function is_octal_digit(b: i32): boolean {
  return b >= 48 && b <= 55;
}

function hex_digit(b: i32): i32 {
  if (b >= 48 && b <= 57) {
    return b - 48;
  }
  if (b >= 97 && b <= 102) {
    return b - 87;
  }
  if (b >= 65 && b <= 70) {
    return b - 55;
  }
  return 0 - 1;
}

function hex_char(v: i32, upper: boolean): i32 {
  if (v < 10) {
    return 48 + v;
  }
  if (upper) {
    return 55 + v;
  }
  return 87 + v;
}

function is_space(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

function is_print(b: i32): boolean {
  return b >= 32 && b <= 126;
}

function lower(b: i32): i32 {
  if (b >= 65 && b <= 90) {
    return b + 32;
  }
  return b;
}

function octal3(b: i32): string {
  let d: u8[] = [];
  d = d.append((48 + b / 64) as u8);
  d = d.append((48 + b / 8 % 8) as u8);
  d = d.append((48 + b % 8) as u8);
  return string_from_bytes_unchecked(d);
}

function control_letter(b: i32): i32 {
  if (b == 7) {
    return 97;
  }
  if (b == 8) {
    return 98;
  }
  if (b == 12) {
    return 102;
  }
  if (b == 10) {
    return 110;
  }
  if (b == 13) {
    return 114;
  }
  if (b == 9) {
    return 116;
  }
  if (b == 11) {
    return 118;
  }
  return 0 - 1;
}

function append_str(out: u8[], s: string): u8[] {
  let bs: u8[] = out;
  let i: i32 = 0;
  while (i < s.len()) {
    bs = bs.append(s[i]);
    i = i + 1;
  }
  return bs;
}

function shell_special(b: i32): boolean {
  return b == 32 || b == 33 || b == 34 || b == 36 || b == 38 || b == 39 || b == 40 || b == 41 || b == 42 || b == 59 || b == 60 || b == 61 || b == 62 || b == 63 || b == 91 || b == 92 || b == 94 || b == 96 || b == 124 || !is_print(b);
}

function shell_quote(s: string): string {
  if (s.len() == 0) {
    return "''";
  }
  let needs: boolean = false;
  let has_quote: boolean = false;
  let blocks_dq: boolean = false;
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (shell_special(b)) {
      needs = true;
    }
    if (b == 39) {
      has_quote = true;
    } else if (shell_special(b) && b != 32 || b == 123 || b == 125 || (b == 35 || b == 126) && i != 0) {
      blocks_dq = true;
    }
    i = i + 1;
  }
  let first: i32 = s[0] as i32;
  if (first == 35 || first == 126) {
    needs = true;
  }
  if (s.len() == 1 && (first == 123 || first == 125)) {
    needs = true;
  }
  if (!needs) {
    return s;
  }
  if (has_quote && !blocks_dq) {
    return "\"" + s + "\"";
  }
  let out: u8[] = [];
  out = out.append(39 as u8);
  let in_dollar: boolean = false;
  i = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b == 39) {
      out = out.append(39 as u8);
      out = out.append(92 as u8);
      out = out.append(39 as u8);
      out = out.append(39 as u8);
      in_dollar = false;
    } else if (is_print(b)) {
      if (in_dollar) {
        out = out.append(39 as u8);
        out = out.append(39 as u8);
        in_dollar = false;
      }
      out = out.append(b as u8);
    } else {
      if (!in_dollar) {
        out = out.append(39 as u8);
        out = out.append(36 as u8);
        out = out.append(39 as u8);
        in_dollar = true;
      }
      out = out.append(92 as u8);
      let letter: i32 = control_letter(b);
      if (letter >= 0) {
        out = out.append(letter as u8);
      } else {
        out = append_str(out, octal3(b));
      }
    }
    i = i + 1;
  }
  out = out.append(39 as u8);
  return string_from_bytes_unchecked(out);
}

function print_esc(p: Pf, s: string, i: i32, octal_0: boolean): (Pf, i32, boolean) {
  let n: i32 = s.len();
  let j: i32 = i + 1;
  if (j >= n) {
    return (emit(p, "\\"), j, false);
  }
  let c: i32 = s[j] as i32;
  j = j + 1;
  if (c == 120) {
    let hex: i32 = 0;
    let digits: i32 = 0;
    while (digits < 2 && j < n && hex_digit(s[j] as i32) >= 0) {
      hex = hex * 16 + hex_digit(s[j] as i32);
      j = j + 1;
      digits = digits + 1;
    }
    if (digits == 0) {
      fatal(p, "missing hexadecimal number in escape");
    }
    return (emit_byte(p, hex), j, false);
  }
  if (is_octal_digit(c)) {
    let oct: i32 = c - 48;
    let more: i32 = 2;
    if (c == 48 && octal_0) {
      more = 3;
    }
    let taken: i32 = 0;
    while (taken < more && j < n && is_octal_digit(s[j] as i32)) {
      oct = oct * 8 + (s[j] as i32 - 48);
      j = j + 1;
      taken = taken + 1;
    }
    return (emit_byte(p, oct % 256), j, false);
  }
  if (c == 117 || c == 85) {
    let want: i32 = 4;
    if (c == 85) {
      want = 8;
    }
    let code: i64 = 0 as i64;
    let got: i32 = 0;
    while (got < want && j < n && hex_digit(s[j] as i32) >= 0) {
      code = code * (16 as i64) + hex_digit(s[j] as i32) as i64;
      j = j + 1;
      got = got + 1;
    }
    if (got < want) {
      fatal(p, "missing hexadecimal number in escape");
    }
    if (code >= 55296 as i64 && code <= 57343 as i64) {
      let marker: string = "u";
      if (c == 85) {
        marker = "U";
      }
      fatal(p, "invalid universal character name \\" + marker + hex_padded(code, want, false));
    }
    if (code < 128 as i64) {
      return (emit_byte(p, code as i32), j, false);
    }
    if (code <= 65535 as i64) {
      return (emit(p, "\\u" + hex_padded(code, 4, true)), j, false);
    }
    return (emit(p, "\\U" + hex_padded(code, 8, true)), j, false);
  }
  let lit: i32 = 0 - 1;
  if (c == 97) {
    lit = 7;
  } else if (c == 98) {
    lit = 8;
  } else if (c == 101) {
    lit = 27;
  } else if (c == 102) {
    lit = 12;
  } else if (c == 110) {
    lit = 10;
  } else if (c == 114) {
    lit = 13;
  } else if (c == 116) {
    lit = 9;
  } else if (c == 118) {
    lit = 11;
  } else if (c == 92 || c == 34) {
    lit = c;
  } else if (c == 99) {
    return (p, j, true);
  }
  if (lit >= 0) {
    return (emit_byte(p, lit), j, false);
  }
  return (emit_byte(emit_byte(p, 92), c), j, false);
}

function hex_padded(v: i64, width: i32, upper: boolean): string {
  let digits: u8[] = [];
  let x: i64 = v;
  while (x > 0 as i64) {
    digits = digits.append(hex_char((x % (16 as i64)) as i32, upper) as u8);
    x = x / (16 as i64);
  }
  let out: u8[] = [];
  let pad: i32 = width - digits.len();
  while (pad > 0) {
    out = out.append(48 as u8);
    pad = pad - 1;
  }
  let i: i32 = digits.len() - 1;
  while (i >= 0) {
    out = out.append(digits[i]);
    i = i - 1;
  }
  return string_from_bytes_unchecked(out);
}

function print_b(p: Pf, s: string): (Pf, boolean) {
  let q: Pf = p;
  let n: i32 = s.len();
  let i: i32 = 0;
  while (i < n) {
    let j: i32 = __memchr(s, 92, i);
    if (j < 0) {
      j = n;
    }
    if (j > i) {
      q = emit_range(q, s, i, j);
    }
    if (j >= n) {
      break;
    }
    let r: (Pf, i32, boolean) = print_esc(q, s, j, true);
    q = r.0;
    i = r.1;
    if (r.2) {
      return (q, true);
    }
  }
  return (q, false);
}

struct IntParse { bits: u64, erange: boolean, end: i32 }

function u64_max(): u64 {
  return 0 as u64 - 1 as u64;
}

function i64_min_mag(): u64 {
  return 9223372036854775808 as u64;
}

function strtox(s: string, unsigned: boolean): IntParse {
  let n: i32 = s.len();
  let i: i32 = 0;
  while (i < n && is_space(s[i] as i32)) {
    i = i + 1;
  }
  let neg: boolean = false;
  if (i < n && (s[i] as i32 == 45 || s[i] as i32 == 43)) {
    neg = s[i] as i32 == 45;
    i = i + 1;
  }
  let base: u64 = 10 as u64;
  if (i < n && s[i] as i32 == 48) {
    if (i + 2 < n && lower(s[i + 1] as i32) == 120 && hex_digit(s[i + 2] as i32) >= 0) {
      base = 16 as u64;
      i = i + 2;
    } else if (target_os() != "darwin" && i + 2 < n && lower(s[i + 1] as i32) == 98 && (s[i + 2] as i32 == 48 || s[i + 2] as i32 == 49)) {
      base = 2 as u64;
      i = i + 2;
    } else {
      base = 8 as u64;
    }
  }
  let limit: u64 = u64_max();
  if (!unsigned) {
    limit = i64_min_mag();
    if (!neg) {
      limit = limit - 1 as u64;
    }
  }
  let mag: u64 = 0 as u64;
  let erange: boolean = false;
  let digits: i32 = 0;
  while (i < n) {
    let d: i32 = hex_digit(s[i] as i32);
    if (d < 0 || d as u64 >= base) {
      break;
    }
    digits = digits + 1;
    if (!erange) {
      let du: u64 = d as u64;
      if (mag > (limit - du) / base) {
        erange = true;
        mag = limit;
      } else {
        mag = mag * base + du;
      }
    }
    i = i + 1;
  }
  if (digits == 0) {
    return IntParse { bits: 0 as u64, erange: false, end: 0 };
  }
  let bits: u64 = mag;
  if (neg && !(unsigned && erange)) {
    bits = 0 as u64 - mag;
  }
  return IntParse { bits: bits, erange: erange, end: i };
}

function char_constant(s: string): i32 {
  if (s.len() >= 2 && (s[0] as i32 == 39 || s[0] as i32 == 34)) {
    return s[1] as i32;
  }
  return 0 - 1;
}

function warn_char_rest(p: Pf, s: string): Pf {
  if (s.len() > 2 && !p.posix) {
    return diag_range(p, "warning: ", s, 2, s.len(), ": character(s) following character constant have been ignored");
  }
  return p;
}

function verify_numeric(p: Pf, s: string, erange: boolean, end: i32): Pf {
  if (end == 0) {
    return Pf { ...diag(p, gnu.quote(s) + ": expected a numeric value"), status: 1 };
  }
  if (erange) {
    return Pf { ...diag(p, gnu.quote(s) + ": " + gnu.erange_text()), status: 1 };
  }
  if (end < s.len()) {
    return Pf { ...diag(p, gnu.quote(s) + ": value not completely converted"), status: 1 };
  }
  return p;
}

function arg_int(p: Pf, s: string, unsigned: boolean): (Pf, u64) {
  let cc: i32 = char_constant(s);
  if (cc >= 0) {
    return (warn_char_rest(p, s), cc as u64);
  }
  let r: IntParse = strtox(s, unsigned);
  return (verify_numeric(p, s, r.erange, r.end), r.bits);
}

function arg_float(p: Pf, s: string): (Pf, ld.LD) {
  let cc: i32 = char_constant(s);
  if (cc >= 0) {
    return (warn_char_rest(p, s), p.ldbl.from_i64(cc as i64));
  }
  let r: ld.Parse = p.ldbl.strtold(s);
  return (verify_numeric(p, s, r.erange, r.end), r.v);
}

struct Spec { minus: boolean, plus: boolean, space: boolean, hash: boolean, zero: boolean, width: i64, prec: i64, conv: i32 }

function none(): i64 {
  return 0 as i64 - 1 as i64;
}

struct Field { prefix: string, head: string, zeros: i64, tail: string }

function signed(prefix: string, body: string): Field {
  return Field { prefix: prefix, head: "", zeros: 0 as i64, tail: body };
}

function fill_block(): i32 {
  return 65536;
}

function stream_failed(p: Pf): boolean {
  match (p.o.error()) {
    Some(_) => {
      return true;
    },
    None => {
      return false;
    }
  }
}

function put_part(p: Pf, was: boolean, s: string): Pf {
  if (s.len() == 0) {
    return p;
  }
  if (!was && stream_failed(p)) {
    return p;
  }
  return emit(p, s);
}

function fill_part(p: Pf, was: boolean, ch: string, n: i64): Pf {
  let q: Pf = p;
  let left: i64 = n;
  if (left >= fill_block() as i64) {
    let block: string = ch.repeat(fill_block());
    while (left >= fill_block() as i64) {
      if (!was && stream_failed(q)) {
        return q;
      }
      q = emit(q, block);
      left = left - fill_block() as i64;
    }
  }
  if (left > 0 as i64) {
    return put_part(q, was, ch.repeat(left as i32));
  }
  return q;
}

function pad(p: Pf, spec: Spec, f: Field, zero_ok: boolean): Pf {
  let len: i64 = f.prefix.len() as i64 + f.head.len() as i64 + f.zeros + f.tail.len() as i64;
  let total: i64 = len;
  if (spec.width > total) {
    total = spec.width;
  }
  if (total >= ld.overflow_len()) {
    return Pf { ...p, werr: true };
  }
  let fill: i64 = total - len;
  let was: boolean = stream_failed(p);
  let q: Pf = p;
  if (spec.minus) {
    q = put_part(q, was, f.prefix);
    q = put_part(q, was, f.head);
    q = fill_part(q, was, "0", f.zeros);
    q = put_part(q, was, f.tail);
    return fill_part(q, was, " ", fill);
  }
  if (spec.zero && zero_ok) {
    q = put_part(q, was, f.prefix);
    q = fill_part(q, was, "0", fill);
  } else {
    q = fill_part(q, was, " ", fill);
    q = put_part(q, was, f.prefix);
  }
  q = put_part(q, was, f.head);
  q = fill_part(q, was, "0", f.zeros);
  return put_part(q, was, f.tail);
}

function pad_range(p: Pf, spec: Spec, s: string, lo: i32, hi: i32): Pf {
  let len: i64 = (hi - lo) as i64;
  let total: i64 = len;
  if (spec.width > total) {
    total = spec.width;
  }
  if (total >= ld.overflow_len()) {
    return Pf { ...p, werr: true };
  }
  let fill: i64 = total - len;
  let was: boolean = stream_failed(p);
  let q: Pf = p;
  if (!spec.minus) {
    q = fill_part(q, was, " ", fill);
  }
  if (was || !stream_failed(q)) {
    q = emit_range(q, s, lo, hi);
  }
  if (spec.minus) {
    q = fill_part(q, was, " ", fill);
  }
  return q;
}

function sign_prefix(spec: Spec, neg: boolean): string {
  if (neg) {
    return "-";
  }
  if (spec.plus) {
    return "+";
  }
  if (spec.space) {
    return " ";
  }
  return "";
}

function radix_digits(v: u64, base: u64, upper: boolean): string {
  if (v == 0 as u64) {
    return "0";
  }
  let digits: u8[] = [];
  let x: u64 = v;
  while (x > 0 as u64) {
    digits = digits.append(hex_char((x % base) as i32, upper) as u8);
    x = x / base;
  }
  let out: u8[] = __alloc_u8(digits.len());
  let i: i32 = 0;
  while (i < digits.len()) {
    out = out.with(i, digits[digits.len() - 1 - i]);
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

function top_bit(): u64 {
  return 9223372036854775808 as u64;
}

function fmt_int(p: Pf, spec: Spec, bits: u64): Pf {
  let conv: i32 = spec.conv;
  let neg: boolean = false;
  let mag: u64 = bits;
  let prefix: string = "";
  let digits: string = "";
  if (conv == 100 || conv == 105) {
    neg = (bits & top_bit()) != 0 as u64;
    if (neg) {
      mag = 0 as u64 - bits;
    }
    digits = radix_digits(mag, 10 as u64, false);
    prefix = sign_prefix(spec, neg);
  } else if (conv == 117) {
    digits = radix_digits(mag, 10 as u64, false);
  } else if (conv == 111) {
    digits = radix_digits(mag, 8 as u64, false);
  } else {
    digits = radix_digits(mag, 16 as u64, conv == 88);
    if (spec.hash && mag != 0 as u64) {
      prefix = "0x";
      if (conv == 88) {
        prefix = "0X";
      }
    }
  }
  let zeros: i64 = 0 as i64;
  if (spec.prec >= 0 as i64) {
    if (spec.prec == 0 as i64 && mag == 0 as u64) {
      digits = "";
    } else if (spec.prec > digits.len() as i64) {
      if (spec.prec + prefix.len() as i64 >= ld.overflow_len()) {
        return Pf { ...p, werr: true };
      }
      zeros = spec.prec - digits.len() as i64;
    }
  }
  if (conv == 111 && spec.hash && zeros == 0 as i64 && !digits.starts_with("0")) {
    digits = "0" + digits;
  }
  return pad(p, spec, Field { prefix: prefix, head: "", zeros: zeros, tail: digits }, spec.prec < 0 as i64);
}

function fmt_float(p: Pf, spec: Spec, v: ld.LD): Pf {
  let conv: i32 = spec.conv;
  let upper: boolean = conv == 70 || conv == 69 || conv == 71 || conv == 65;
  let prefix: string = sign_prefix(spec, v.neg);
  if (v.kind != 0) {
    let word: string = "inf";
    if (v.kind == 2) {
      word = "nan";
    }
    if (upper) {
      word = word.to_upper();
    }
    return pad(p, spec, signed(prefix, word), false);
  }
  let lc: i32 = lower(conv);
  if (lc == 97) {
    return fmt_hex_float(p, spec, v, prefix, upper);
  }
  let prec: i64 = spec.prec;
  if (prec < 0 as i64) {
    prec = 6 as i64;
  }
  let extra: i64 = prefix.len() as i64;
  let d: ld.Dec = v.dec();
  if (lc == 102) {
    return emit_body(p, spec, prefix, ld.fixed(d, prec, spec.hash, extra));
  }
  if (lc == 101) {
    return emit_body(p, spec, prefix, ld.sci(d, prec, spec.hash, upper, extra));
  }
  return emit_body(p, spec, prefix, ld.general(d, prec, spec.hash, upper, extra));
}

function emit_body(p: Pf, spec: Spec, prefix: string, b: ld.Body): Pf {
  if (b.refused) {
    return Pf { ...p, werr: true };
  }
  return pad(p, spec, Field { prefix: prefix, head: b.head, zeros: b.zeros, tail: b.tail }, true);
}

function fmt_hex_float(p: Pf, spec: Spec, v: ld.LD, prefix: string, upper: boolean): Pf {
  let radix: string = "0x";
  let b: ld.Body = p.ldbl.hex_parts(v, spec.prec, spec.hash);
  if (upper) {
    radix = "0X";
    b = ld.Body { ...b, head: b.head.to_upper(), tail: b.tail.to_upper() };
  }
  return pad(p, spec, Field { prefix: prefix + radix, head: b.head, zeros: b.zeros, tail: b.tail }, true);
}

struct Args { argv: string[], base: i32, curr: i32, seq: i32, used: i32, direc: i32 }

function args_new(argv: string[], base: i32): Args {
  return Args { argv: argv, base: base, curr: 0 - 1, seq: 0 - 1, used: 0 - 1, direc: 0 - 1 };
}

function arg_count(a: Args): i32 {
  return a.argv.len() - a.base;
}

function arg_present(a: Args): boolean {
  return a.curr >= 0 && a.curr < arg_count(a);
}

function arg_text(a: Args): string {
  if (!arg_present(a)) {
    return "";
  }
  return a.argv[a.base + a.curr];
}

function args_consumed(a: Args): i32 {
  let n: i32 = a.used + 1;
  if (n > arg_count(a)) {
    return arg_count(a);
  }
  return n;
}

function index_arg(s: string, j: i32): (i32, i32) {
  let n: i32 = s.len();
  if (j >= n || !is_digit(s[j] as i32)) {
    return (0, j);
  }
  let k: i32 = j;
  let v: i64 = 0 as i64;
  let over: boolean = false;
  while (k < n && is_digit(s[k] as i32)) {
    v = v * (10 as i64) + (s[k] as i32 - 48) as i64;
    if (v > 2147483647 as i64) {
      over = true;
      v = 2147483647 as i64;
    }
    k = k + 1;
  }
  if (k < n && s[k] as i32 == 36) {
    if (over) {
      return (2147483647, k + 1);
    }
    return (v as i32, k + 1);
  }
  return (0, j);
}

function cursor(pos: i32, s: string, j: i32, a: Args): (i32, Args) {
  let ac: Args = a;
  let nj: i32 = j;
  let arg: i32 = 0;
  if (pos < 3) {
    let ix: (i32, i32) = index_arg(s, j);
    arg = ix.0;
    nj = ix.1;
  }
  if (arg > 0) {
    arg = arg - 1;
    if (pos == 0) {
      ac = Args { ...ac, direc: arg };
    }
  } else if (pos == 0) {
    ac = Args { ...ac, direc: 0 - 1 };
    arg = 0 - 1;
  } else if (pos < 3 || ac.direc < 0) {
    ac = Args { ...ac, seq: ac.seq + 1 };
    arg = ac.seq;
  } else {
    arg = ac.direc;
  }
  if (arg >= 0) {
    ac = Args { ...ac, curr: arg };
    if (arg > ac.used) {
      ac = Args { ...ac, used: arg };
    }
  }
  return (nj, ac);
}

function flag_byte(b: i32): boolean {
  return b == 45 || b == 43 || b == 32 || b == 35 || b == 48;
}

function length_modifier(b: i32): boolean {
  return b == 104 || b == 108 || b == 76 || b == 106 || b == 122 || b == 116;
}

function is_conversion(b: i32): boolean {
  return b == 100 || b == 105 || b == 111 || b == 117 || b == 120 || b == 88 || b == 102 || b == 70 || b == 101 || b == 69 || b == 103 || b == 71 || b == 97 || b == 65 || b == 99 || b == 115;
}

function read_number(s: string, i: i32): (i64, i32) {
  let j: i32 = i;
  let v: i64 = 0 as i64;
  while (j < s.len() && is_digit(s[j] as i32)) {
    if (v < 1000000000000 as i64) {
      v = v * (10 as i64) + (s[j] as i32 - 48) as i64;
    }
    j = j + 1;
  }
  return (v, j);
}

function bad_spec(p: Pf, s: string, from: i32, to: i32): void {
  let stop: i32 = to + 1;
  if (stop > s.len()) {
    stop = s.len();
  }
  close_stdout(diag_range(p, "", s, from, stop, ": invalid conversion specification"), 1);
}

function star_width(p: Pf, a: Args): (Pf, i64) {
  if (!arg_present(a)) {
    return (p, 0 as i64);
  }
  let text: string = arg_text(a);
  let r: (Pf, u64) = arg_int(p, text, false);
  let v: i64 = r.1 as i64;
  if (v > 2147483647 as i64 || v < 0 as i64 - 2147483648 as i64) {
    fatal(r.0, "invalid field width: " + gnu.quote(text));
  }
  return (r.0, v);
}

function star_precision(p: Pf, a: Args): (Pf, i64) {
  if (!arg_present(a)) {
    return (p, 0 as i64);
  }
  let text: string = arg_text(a);
  let r: (Pf, u64) = arg_int(p, text, false);
  let v: i64 = r.1 as i64;
  if (v < 0 as i64) {
    return (r.0, none());
  }
  if (v > 2147483647 as i64) {
    fatal(r.0, "invalid precision: " + gnu.quote(text));
  }
  return (r.0, v);
}

function directive(p: Pf, s: string, i: i32, a: Args): (Pf, i32, Args, boolean) {
  let n: i32 = s.len();
  let j: i32 = i + 1;
  let q: Pf = p;
  let args: Args = a;
  if (j < n && s[j] as i32 == 37) {
    return (emit(q, "%"), j + 1, args, false);
  }
  let c0: (i32, Args) = cursor(0, s, j, args);
  j = c0.0;
  args = c0.1;
  if (j < n && (s[j] as i32 == 98 || s[j] as i32 == 113)) {
    let cb: (i32, Args) = cursor(3, s, j, args);
    args = cb.1;
    if (s[j] as i32 == 98) {
      let rb: (Pf, boolean) = print_b(q, arg_text(args));
      return (rb.0, j + 1, args, rb.1);
    }
    if (!arg_present(args)) {
      return (q, j + 1, args, false);
    }
    return (emit(q, shell_quote(arg_text(args))), j + 1, args, false);
  }
  let spec: Spec = Spec { minus: false, plus: false, space: false, hash: false, zero: false, width: none(), prec: none(), conv: 0 };
  while (j < n && flag_byte(s[j] as i32)) {
    let f: i32 = s[j] as i32;
    if (f == 45) {
      spec = Spec { ...spec, minus: true };
    } else if (f == 43) {
      spec = Spec { ...spec, plus: true };
    } else if (f == 32) {
      spec = Spec { ...spec, space: true };
    } else if (f == 35) {
      spec = Spec { ...spec, hash: true };
    } else {
      spec = Spec { ...spec, zero: true };
    }
    j = j + 1;
  }
  let has_prec: boolean = false;
  if (j < n && s[j] as i32 == 42) {
    j = j + 1;
    let c1: (i32, Args) = cursor(1, s, j, args);
    j = c1.0;
    args = c1.1;
    let sw: (Pf, i64) = star_width(q, args);
    q = sw.0;
    if (sw.1 < 0 as i64) {
      spec = Spec { ...spec, minus: true, width: 0 as i64 - sw.1 };
    } else {
      spec = Spec { ...spec, width: sw.1 };
    }
  } else {
    let w: (i64, i32) = read_number(s, j);
    if (w.1 > j) {
      spec = Spec { ...spec, width: w.0 };
      j = w.1;
    }
  }
  if (j < n && s[j] as i32 == 46) {
    has_prec = true;
    j = j + 1;
    if (j < n && s[j] as i32 == 42) {
      j = j + 1;
      let c2: (i32, Args) = cursor(2, s, j, args);
      j = c2.0;
      args = c2.1;
      let sp: (Pf, i64) = star_precision(q, args);
      q = sp.0;
      spec = Spec { ...spec, prec: sp.1 };
    } else {
      let pr: (i64, i32) = read_number(s, j);
      spec = Spec { ...spec, prec: pr.0 };
      j = pr.1;
    }
  }
  while (j < n && length_modifier(s[j] as i32)) {
    j = j + 1;
  }
  if (j >= n || !is_conversion(s[j] as i32)) {
    bad_spec(q, s, i, j);
  }
  let conv: i32 = s[j] as i32;
  spec = Spec { ...spec, conv: conv };
  let is_c: boolean = conv == 99;
  let is_s: boolean = conv == 115;
  let no_hash: boolean = conv == 100 || conv == 105 || conv == 117 || is_c || is_s;
  if (spec.hash && no_hash || spec.zero && (is_c || is_s) || has_prec && is_c) {
    bad_spec(q, s, i, j);
  }
  let c3: (i32, Args) = cursor(3, s, j, args);
  args = c3.1;
  let arg: string = arg_text(args);
  let given: boolean = arg_present(args);
  if (is_c) {
    let source: string = arg;
    if (source.len() == 0) {
      source = "\x00";
    }
    return (pad_range(q, spec, source, 0, 1), j + 1, args, false);
  }
  if (is_s) {
    let hi: i32 = arg.len();
    if (spec.prec >= 0 as i64 && spec.prec < arg.len() as i64) {
      hi = spec.prec as i32;
    }
    return (pad_range(q, spec, arg, 0, hi), j + 1, args, false);
  }
  let lc: i32 = lower(conv);
  if (lc == 102 || lc == 101 || lc == 103 || lc == 97) {
    if (!given) {
      return (fmt_float(q, spec, q.ldbl.from_i64(0 as i64)), j + 1, args, false);
    }
    let fr: (Pf, ld.LD) = arg_float(q, arg);
    return (fmt_float(fr.0, spec, fr.1), j + 1, args, false);
  }
  let unsigned: boolean = conv != 100 && conv != 105;
  if (!given) {
    return (fmt_int(q, spec, 0 as u64), j + 1, args, false);
  }
  let ir: (Pf, u64) = arg_int(q, arg, unsigned);
  return (fmt_int(ir.0, spec, ir.1), j + 1, args, false);
}

function print_formatted(p: Pf, s: string, a: Args): (Pf, Args, boolean) {
  let q: Pf = p;
  let args: Args = a;
  let n: i32 = s.len();
  let i: i32 = 0;
  while (i < n) {
    let j: i32 = i;
    while (j < n && s[j] as i32 != 37 && s[j] as i32 != 92) {
      j = j + 1;
    }
    if (j > i) {
      q = emit_range(q, s, i, j);
    }
    if (j >= n) {
      break;
    }
    if (s[j] as i32 == 92) {
      let r: (Pf, i32, boolean) = print_esc(q, s, j, false);
      q = r.0;
      i = r.1;
      if (r.2) {
        return (q, args, true);
      }
      continue;
    }
    let d: (Pf, i32, Args, boolean) = directive(q, s, j, args);
    q = d.0;
    i = d.1;
    args = d.2;
    if (d.3) {
      return (q, args, true);
    }
  }
  return (q, args, false);
}

pub function main(): i32 {
  let argv: string[] = args();
  gnu.sole_help_version(argv, "printf", help_text(), 0);
  let first: i32 = 1;
  if (argv.len() > 1 && argv[1] == "--") {
    first = 2;
  }
  if (argv.len() <= first) {
    gnu.die_usage("missing operand", 1);
  }
  let format: string = argv[first];
  let posix: boolean = false;
  match (env("POSIXLY_CORRECT")) {
    Some(_) => {
      posix = true;
    },
    None => {}
  }
  let p: Pf = Pf { o: gnu.out_new(), status: 0, werr: false, posix: posix, ldbl: ld.format() };
  let base: i32 = first + 1;
  while (true) {
    let a: Args = args_new(argv, base);
    let r: (Pf, Args, boolean) = print_formatted(p, format, a);
    p = r.0;
    if (r.2) {
      gnu.close_stdout(p.o, p.werr);
      return 0;
    }
    let used: i32 = args_consumed(r.1);
    base = base + used;
    if (used <= 0 || base >= argv.len()) {
      break;
    }
  }
  if (base < argv.len()) {
    p = diag(p, "warning: ignoring excess arguments, starting with " + gnu.quote(argv[base]));
  }
  gnu.close_stdout(p.o, p.werr);
  return p.status;
}
