// join.fern — GNU-compatible `join`.
//
//   join [OPTION]... FILE1 FILE2
//
// The two files are read in step and every pair of lines whose join
// field matches is written as one line. Both files must already be
// sorted on that field; what happens when they are not is the subtlest
// part of the program and is described at `needs_order_check` below.
//
// Two shapes of this are older than the option syntax and decide how
// the command line is read:
//
//   - `-o` takes its field specs as SEPARATE arguments as well as one
//     comma-separated one, and `-j1` / `-j2` take their field number
//     from the next argument. So a bare word after either of them is
//     ambiguous: an option argument, or one of the two files.
//   - The ambiguity is settled by counting backwards. A candidate is
//     taken as the option's argument, and at the end of the scan any
//     shortfall in the two file operands is made up by giving the LAST
//     candidates back — which is why `join -o 1.1 f1 f2` joins two
//     files while `join -o 1.1 f1 f2 f3` reads `f1` as a field spec.
//     Nothing about the token decides it; only how many follow.
//
// Unpairable lines are printed by -a and are the only output under -v.
// -o names the output fields; -e fills a field a line does not have,
// which only -o and `-o auto` can ask for.
import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";

// Option ids. The declaration order below is GNU's, because the
// ambiguity list prints candidates in it (`join --=x`).
function opt_a(): i32 {
  return 1;
}

function opt_e(): i32 {
  return 2;
}

function opt_ignore(): i32 {
  return 3;
}

function opt_j(): i32 {
  return 4;
}

function opt_o(): i32 {
  return 5;
}

function opt_t(): i32 {
  return 6;
}

function opt_v(): i32 {
  return 7;
}

function opt_1(): i32 {
  return 8;
}

function opt_2(): i32 {
  return 9;
}

function opt_check(): i32 {
  return 10;
}

function opt_nocheck(): i32 {
  return 11;
}

function opt_zero(): i32 {
  return 12;
}

function opt_header(): i32 {
  return 13;
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... FILE1 FILE2\n";
  out = out + "For each pair of input lines with identical join fields, write a line to\n";
  out = out + "standard output.  The default join field is the first, delimited by blanks.\n";
  out = out + "\n";
  out = out + "When FILE1 or FILE2 (not both) is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -a FILENUM             also print unpairable lines from file FILENUM, where\n";
  out = out + "                           FILENUM is 1 or 2, corresponding to FILE1 or FILE2\n";
  out = out + "  -e STRING              replace missing (empty) input fields with STRING;\n";
  out = out + "                           I.e., missing fields specified with '-12jo' options\n";
  out = out + "  -i, --ignore-case      ignore differences in case when comparing fields\n";
  out = out + "  -j FIELD               equivalent to '-1 FIELD -2 FIELD'\n";
  out = out + "  -o FORMAT              obey FORMAT while constructing output line\n";
  out = out + "  -t CHAR                use CHAR as input and output field separator\n";
  out = out + "  -v FILENUM             like -a FILENUM, but suppress joined output lines\n";
  out = out + "  -1 FIELD               join on this FIELD of file 1\n";
  out = out + "  -2 FIELD               join on this FIELD of file 2\n";
  out = out + "      --check-order      check that the input is correctly sorted, even\n";
  out = out + "                           if all input lines are pairable\n";
  out = out + "      --nocheck-order    do not check that the input is correctly sorted\n";
  out = out + "      --header           treat the first line in each file as field headers,\n";
  out = out + "                           print them without trying to pair them\n";
  out = out + "  -z, --zero-terminated  line delimiter is NUL, not newline\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "Unless -t CHAR is given, leading blanks separate fields and are ignored,\n";
  out = out + "else fields are separated by CHAR.  Any FIELD is a field number counted\n";
  out = out + "from 1.  FORMAT is one or more comma or blank separated specifications,\n";
  out = out + "each being 'FILENUM.FIELD' or '0'.  Default FORMAT outputs the join field,\n";
  out = out + "the remaining fields from FILE1, the remaining fields from FILE2, all\n";
  out = out + "separated by CHAR.  If FORMAT is the keyword 'auto', then the first\n";
  out = out + "line of each file determines the number of fields output for each line.\n";
  out = out + "\n";
  out = out + "Important: FILE1 and FILE2 must be sorted on the join fields.\n";
  out = out + "If the input is not sorted and some lines cannot be joined, a\n";
  out = out + "warning message will be given.\n";
  return out;
}

function chr(b: i32): string {
  return string_from_bytes_unchecked([b as u8]);
}

// SIZE_MAX: the value an out-of-range field number saturates to, and
// the "not given yet" marker for the two join fields.
function unset(): u64 {
  return 18446744073709551615 as u64;
}

// `field_number(s)` — gnulib's string_to_join_field: xstrtoumax, zero
// refused, out of range saturating to SIZE_MAX, and the whole operand
// consumed. Returns the 0-based field, or dies.
function field_number(s: string): u64 {
  var r: (u64, i32) = gnu.parse_number(s);
  if (gnu.count_overflow(r.1)) {
    // Out of range saturates to SIZE_MAX, one past the "not given"
    // marker, so a field number that overflowed is not read back as
    // an unset one. Trailing junk is a different refusal, and one
    // GNU reports rather than saturates.
    return unset() - 1 as u64;
  }
  if (r.1 != 0 || r.0 == 0 as u64) {
    gnu.error("invalid field number: " + gnu.quote(s));
    exit(1);
  }
  return r.0 - 1 as u64;
}

// `file_number(s)` — the 1-or-2 a -a or -v takes.
function file_number(s: string): i32 {
  var r: (u64, i32) = gnu.parse_number(s);
  if (r.1 != 0 || r.0 == 0 as u64 || r.0 > 2 as u64) {
    gnu.error("invalid file number: " + gnu.quote(s));
    exit(1);
  }
  return r.0 as i32;
}

// ---- output fields ----------------------------------------------------------
// `Spec` — one -o item: `file` 0 for the join field, 1 or 2 for that
// file's `field`.
struct Spec { file: i32, field: u64 }

// ---- settings ---------------------------------------------------------------
struct Opts { jf1: u64, jf2: u64, tab: i32, eol: i32, filler: string, ignore_case: boolean, pairs: boolean, unpair1: boolean, unpair2: boolean, specs: Spec[], autofmt: boolean, check: i32, header: boolean }

// check: 0 the default (report a disorder only once a line has proved
// unpairable), 1 --check-order (report and die), 2 --nocheck-order.
function check_default(): i32 {
  return 0;
}

function check_on(): i32 {
  return 1;
}

function check_off(): i32 {
  return 2;
}

// ---- lines ------------------------------------------------------------------
// `Line` — one input line without its terminator, its field bounds as
// start/end pairs, and the join field's bounds. The key is held as a
// RANGE rather than a string: a line is compared with its neighbour and
// with the other file's, and slicing it out for that would allocate
// once per line for nothing.
// A line is a byte range `[lo, hi)` of the block it was read from,
// never a string of its own: the block stays alive for as long as a
// line refers to it. `k0, k1` bound the join field, `nf` counts the
// fields; the other fields are walked again when the line is printed,
// which costs a byte scan of a short line and no allocation at all.
// The first four fields' bounds are carried too, so a line that has no
// more than that is printed without a second walk.
struct Line { text: string, lo: i32, hi: i32, k0: i32, k1: i32, nf: i32, s0: i32, e0: i32, s1: i32, e1: i32, s2: i32, e2: i32, s3: i32, e3: i32 }

function blank_line(): Line {
  return Line { text: "", lo: 0, hi: 0, k0: 0, k1: 0, nf: 0, s0: 0, e0: 0, s1: 0, e1: 0, s2: 0, e2: 0, s3: 0, e3: 0 };
}

function inline_fields(): i32 {
  return 4;
}

function field_start(l: Line, n: i32): i32 {
  if (n == 0) {
    return l.s0;
  }
  if (n == 1) {
    return l.s1;
  }
  if (n == 2) {
    return l.s2;
  }
  return l.s3;
}

function field_end(l: Line, n: i32): i32 {
  if (n == 0) {
    return l.e0;
  }
  if (n == 1) {
    return l.e1;
  }
  if (n == 2) {
    return l.e2;
  }
  return l.e3;
}

function nfields(l: Line): u64 {
  return l.nf as u64;
}

// A field separator in the default mode. A newline joins the blanks
// because -z lets one appear inside a line, where it separates fields
// exactly as it separates lines everywhere else.
function is_sep(c: i32): boolean {
  return c == 32 || c == 9 || c == 10;
}

// gnulib's xfields, walked once for the field count and the join
// field's bounds. An empty line has no fields at all; a `-t` line
// always has one more field than it has separators, so a leading
// separator makes the first field empty; in the default mode blanks at
// either end are skipped and add no field. `-t ''` sets the separator to
// a newline, which no line can contain, so the whole line is one field.
// A join field the line does not have is the empty range at `lo`.
// `other` is where the first tab or newline at or after `lo` sits, or
// -1: a default-mode line that holds neither ends every field at a
// space, so each is found by one `__memchr` rather than a byte loop.
function make_line(text: string, lo: i32, hi: i32, tab: i32, jf: u64, other: i32): Line {
  var k0: i32 = lo;
  var k1: i32 = lo;
  var s0: i32 = lo;
  var e0: i32 = lo;
  var s1: i32 = lo;
  var e1: i32 = lo;
  var s2: i32 = lo;
  var e2: i32 = lo;
  var s3: i32 = lo;
  var e3: i32 = lo;
  var n: i32 = 0;
  if (hi > lo) {
    var want: i32 = jf as i32;
    if (jf > 1000000000 as u64) {
      want = 0 - 1;
    }
    var i: i32 = lo;
    var f: i32 = lo;
    var more: boolean = true;
    if (tab == 10) {
      more = false;
    } else if (tab < 0) {
      while (i < hi && is_sep(text[i] as i32)) {
        i = i + 1;
      }
      if (i >= hi) {
        more = false;
      }
    }
    if (tab == 10) {
      f = lo;
      i = hi;
      n = 1;
      s0 = lo;
      e0 = hi;
      if (want == 0) {
        k1 = hi;
      }
    }
    // One field per turn: `[f, i)` is the field, and the turn ends with
    // `i` at the next field's start or `more` false.
    while (more) {
      f = i;
      if (tab >= 0 || other < 0 || other >= hi) {
        var byte: i32 = tab;
        if (tab < 0) {
          byte = 32;
        }
        var j: i32 = __memchr(text, byte, f);
        if (j < 0 || j > hi) {
          j = hi;
        }
        i = j;
      } else {
        i = i + 1;
        while (i < hi && !is_sep(text[i] as i32)) {
          i = i + 1;
        }
      }
      if (n == want) {
        k0 = f;
        k1 = i;
      }
      if (n == 0) {
        s0 = f;
        e0 = i;
      } else if (n == 1) {
        s1 = f;
        e1 = i;
      } else if (n == 2) {
        s2 = f;
        e2 = i;
      } else if (n == 3) {
        s3 = f;
        e3 = i;
      }
      n = n + 1;
      if (i >= hi) {
        more = false;
      } else if (tab >= 0) {
        i = i + 1;
      } else {
        i = i + 1;
        while (i < hi && is_sep(text[i] as i32)) {
          i = i + 1;
        }
        // Trailing blanks end the line rather than opening an empty
        // field after them. GNU <= 9.11 extracted one there.
        if (i >= hi) {
          more = false;
        }
      }
    }
  }
  return Line { text: text, lo: lo, hi: hi, k0: k0, k1: k1, nf: n, s0: s0, e0: e0, s1: s1, e1: e1, s2: s2, e2: e2, s3: s3, e3: e3 };
}

function fold(c: i32): i32 {
  if (c >= 65 && c <= 90) {
    return c + 32;
  }
  return c;
}

// gnulib's keycmp: memcmp in the C locale, memcasecmp under -i, with a
// shorter key that is a prefix sorting first. Only the sign is used.
function keycmp(a: Line, b: Line, ic: boolean): i32 {
  return range_cmp(a.text, a.k0, a.k1, b.text, b.k0, b.k1, ic);
}

function range_cmp(at: string, a0: i32, a1: i32, bt: string, b0: i32, b1: i32, ic: boolean): i32 {
  var la: i32 = a1 - a0;
  var lb: i32 = b1 - b0;
  var n: i32 = la;
  if (lb < n) {
    n = lb;
  }
  var i: i32 = 0;
  if (!ic) {
    i = __mismatch(at, a0, bt, b0, n);
    if (i < n) {
      if (at[a0 + i] as i32 < bt[b0 + i] as i32) {
        return 0 - 1;
      }
      return 1;
    }
  }
  while (i < n) {
    var x: i32 = fold(at[a0 + i] as i32);
    var y: i32 = fold(bt[b0 + i] as i32);
    if (x != y) {
      if (x < y) {
        return 0 - 1;
      }
      return 1;
    }
    i = i + 1;
  }
  if (la == lb) {
    return 0;
  }
  if (la < lb) {
    return 0 - 1;
  }
  return 1;
}

// ---- input ------------------------------------------------------------------
// `In` — one file: its reader, the unread tail of the last block, and
// the order-check state (the previous line's key, whether this file has
// already been warned about).
// `have` and `line` are the last `next_line` answer; `msg` is a
// disorder the caller still has to report, so the cursor comes back
// alone rather than in a tuple with the writer and the run state.
// `tab_at` and `nl_at` are where the next tab and newline sit in the
// block, -1 once there are none and `stale()` after a refill; a line
// that lies before both is split on spaces alone, by `__memchr`.
struct In { r: Reader, is_stdin: boolean, buf: string, pos: i32, eof: boolean, name: string, no: u64, hasprev: boolean, warned: boolean, which: i32, have: boolean, line: Line, msg: string, tab_at: i32, nl_at: i32 }

function read_size(): i32 {
  return 65536;
}

function stale(): i32 {
  return 0 - 2;
}

// `cursor(at, text, byte, pos)` — `at` moved to the next `byte` at or
// after `pos`, when it has fallen behind or the block was replaced.
function cursor(at: i32, text: string, byte: i32, pos: i32): i32 {
  if (at == stale() || at >= 0 && at < pos) {
    return __memchr(text, byte, pos);
  }
  return at;
}

// `Run` — the two facts the order check reads and writes across both
// files: whether any line has proved unpairable yet, and whether a
// disorder has been reported.
struct Run { unpairable: boolean, disorder: boolean }

// gnulib's check_order, split in two: `needs_order_check` is the cheap
// half `next_line` asks on every line, and `report` is the diagnostic
// the caller issues when a line came back with `msg` set.
//
// The default is deliberately weak: a file may be out of order as long
// as every line still pairs, which is a GNU extension over POSIX, so
// the disorder is reported only once a line HAS proved unpairable —
// and `seen_unpairable` is set AFTER the next line has been read, so
// the very line that follows the first unpairable one is still exempt.
// --check-order drops all of that and dies on the first disorder.
// Either way a file is warned about once.
function needs_order_check(inp: In, o: Opts, unpairable: boolean): boolean {
  if (o.check == check_off() || inp.warned) {
    return false;
  }
  return o.check == check_on() || unpairable;
}

// `report(inp, o, run, w)` — the disorder `next_line` left in `inp.msg`.
function report(inp: In, o: Opts, run: Run, w: io_buffered.BufWriter): (In, Run, io_buffered.BufWriter) {
  var out: io_buffered.BufWriter = gnu.error_out(w, inp.msg);
  if (o.check == check_on()) {
    exit(1);
  }
  return (In { ...inp, warned: true, msg: "" }, Run { ...run, disorder: true }, out);
}

// `next_line(...)` — gnulib's get_line: one line, split into fields,
// checked against the one before it; `inp.have` says whether one was
// read. The line is a range of the block it sits in; a block that ends
// mid-line is carried in front of the next read.
function next_line(inp: In, o: Opts, unpairable: boolean, w: io_buffered.BufWriter): In {
  var jf: u64 = o.jf1;
  if (inp.which == 2) {
    jf = o.jf2;
  }
  var cur: In = inp;
  var lo: i32 = 0;
  var hi: i32 = 0;
  var npos: i32 = 0;
  while (true) {
    var j: i32 = __memchr(cur.buf, o.eol, cur.pos);
    if (j >= 0) {
      lo = cur.pos;
      hi = j;
      npos = j + 1;
      break;
    }
    if (cur.eof) {
      if (cur.pos >= cur.buf.len()) {
        return In { ...cur, have: false, line: blank_line() };
      }
      lo = cur.pos;
      hi = cur.buf.len();
      npos = hi;
      break;
    }
    var rest: string = slice_unchecked(cur.buf, cur.pos, cur.buf.len()) + "";
    match (cur.r.read_chunk(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          cur = In { ...cur, buf: rest, pos: 0, eof: true, tab_at: stale(), nl_at: stale() };
        } else {
          cur = In { ...cur, buf: rest + chunk, pos: 0, tab_at: stale(), nl_at: stale() };
        }
      },
      Err(e) => {
        var w2: io_buffered.BufWriter = gnu.error_out(w, "read error: " + gnu.io_error_text(e));
        exit(1);
      }
    }
  }
  var tab_at: i32 = cur.tab_at;
  var nl_at: i32 = cur.nl_at;
  var other: i32 = 0 - 1;
  if (o.tab < 0) {
    tab_at = cursor(tab_at, cur.buf, 9, lo);
    nl_at = cursor(nl_at, cur.buf, 10, lo);
    other = tab_at;
    if (nl_at >= 0 && (other < 0 || nl_at < other)) {
      other = nl_at;
    }
  }
  var l: Line = make_line(cur.buf, lo, hi, o.tab, jf, other);
  var msg: string = "";
  if (cur.hasprev && needs_order_check(cur, o, unpairable) && keycmp(cur.line, l, o.ignore_case) > 0) {
    msg = cur.name + ":" + (cur.no + 1 as u64).to_string() + ": is not sorted: " + slice_unchecked(cur.buf, lo, hi) + "";
  }
  return In { ...cur, pos: npos, no: cur.no + 1 as u64, hasprev: true, have: true, line: l, msg: msg, tab_at: tab_at, nl_at: nl_at };
}

// ---- output -----------------------------------------------------------------
// Every piece of an output line is pushed straight into stdout's
// builder: a field is a range of its line's block, a separator one byte.
function sep_byte(o: Opts): i32 {
  if (o.tab >= 0) {
    return o.tab;
  }
  return 32;
}

// gnulib's prfield: the field's bytes, or -e's filler when there are
// none — a field the line is too short to have and one that is present
// but empty are both filled. Only -o and `-o auto` can reach past a
// line's own fields, which is why -e usually needs one of them.
function push_range_or_filler(h: usize, l: Line, f0: i32, f1: i32, o: Opts): void {
  if (f1 > f0) {
    buf_push_range(h, l.text, f0, f1);
    return;
  }
  buf_push(h, o.filler);
}

// `push_field(h, l, n, o)` — field `n` of `l`, walked to from the
// line's start. Only the -o specs reach here, so the walk is short and
// rare; the default output walks every field once in `push_fields`.
function push_field(h: usize, l: Line, n: u64, o: Opts): void {
  if (n >= nfields(l)) {
    buf_push(h, o.filler);
    return;
  }
  var want: i32 = n as i32;
  if (want < inline_fields()) {
    push_range_or_filler(h, l, field_start(l, want), field_end(l, want), o);
    return;
  }
  var i: i32 = l.lo;
  var hi: i32 = l.hi;
  if (o.tab == 10) {
    push_range_or_filler(h, l, l.lo, hi, o);
    return;
  }
  var k: i32 = 0;
  if (o.tab >= 0) {
    while (true) {
      var j: i32 = __memchr(l.text, o.tab, i);
      if (j < 0 || j > hi) {
        j = hi;
      }
      if (k == want) {
        push_range_or_filler(h, l, i, j, o);
        return;
      }
      k = k + 1;
      i = j + 1;
    }
  }
  while (i < hi && is_sep(l.text[i] as i32)) {
    i = i + 1;
  }
  while (true) {
    var f: i32 = i;
    while (i < hi && !is_sep(l.text[i] as i32)) {
      i = i + 1;
    }
    if (k == want) {
      push_range_or_filler(h, l, f, i, o);
      return;
    }
    k = k + 1;
    i = i + 1;
    while (i < hi && is_sep(l.text[i] as i32)) {
      i = i + 1;
    }
    if (i >= hi) {
      buf_push(h, o.filler);
      return;
    }
  }
}

// gnulib's prfields: every field but the join field, each preceded by
// the separator, walked once. `count` is the line's own field count, or
// the autoformat width when `-o auto` fixed one; fields past the line's
// own are the filler.
function push_fields(h: usize, l: Line, jf: u64, count: u64, o: Opts): void {
  var sep: i32 = sep_byte(o);
  var skip: i32 = jf as i32;
  if (jf > 1000000000 as u64) {
    skip = 0 - 1;
  }
  var stop: i32 = count as i32;
  var n: i32 = 0;
  var i: i32 = l.lo;
  var hi: i32 = l.hi;
  if (l.nf <= inline_fields()) {
    while (n < stop && n < l.nf) {
      if (n != skip) {
        buf_push_byte(h, sep);
        push_range_or_filler(h, l, field_start(l, n), field_end(l, n), o);
      }
      n = n + 1;
    }
  } else if (l.nf > 0) {
    if (o.tab == 10) {
      if (skip != 0 && stop > 0) {
        buf_push_byte(h, sep);
        push_range_or_filler(h, l, l.lo, hi, o);
      }
      n = 1;
    } else if (o.tab >= 0) {
      while (n < stop) {
        var j: i32 = __memchr(l.text, o.tab, i);
        if (j < 0 || j > hi) {
          j = hi;
        }
        if (n != skip) {
          buf_push_byte(h, sep);
          push_range_or_filler(h, l, i, j, o);
        }
        n = n + 1;
        if (j >= hi) {
          break;
        }
        i = j + 1;
      }
    } else {
      while (i < hi && is_sep(l.text[i] as i32)) {
        i = i + 1;
      }
      while (n < stop) {
        var f: i32 = i;
        while (i < hi && !is_sep(l.text[i] as i32)) {
          i = i + 1;
        }
        if (n != skip) {
          buf_push_byte(h, sep);
          push_range_or_filler(h, l, f, i, o);
        }
        n = n + 1;
        if (i >= hi) {
          break;
        }
        i = i + 1;
        while (i < hi && is_sep(l.text[i] as i32)) {
          i = i + 1;
        }
        if (i >= hi) {
          // The trailing separator's empty field.
          if (n < stop && n != skip) {
            buf_push_byte(h, sep);
            buf_push(h, o.filler);
          }
          n = n + 1;
          break;
        }
      }
    }
  }
  while (n < stop) {
    if (n != skip) {
      buf_push_byte(h, sep);
      buf_push(h, o.filler);
    }
    n = n + 1;
  }
}

// `push_join(h, l1, l2, b1, ...)` — one output line. `b1` says the
// first line is the placeholder, which is what makes `-o 0` print the
// OTHER file's join field on a line only file 2 has.
function push_join(h: usize, l1: Line, l2: Line, b1: boolean, o: Opts, ac1: u64, ac2: u64): void {
  var sep: i32 = sep_byte(o);
  if (o.specs.len() > 0) {
    var k: i32 = 0;
    while (k < o.specs.len()) {
      if (k > 0) {
        buf_push_byte(h, sep);
      }
      var sp: Spec = o.specs[k];
      if (sp.file == 0) {
        if (b1) {
          push_range_or_filler(h, l2, l2.k0, l2.k1, o);
        } else {
          push_range_or_filler(h, l1, l1.k0, l1.k1, o);
        }
      } else if (sp.file == 1) {
        push_field(h, l1, sp.field, o);
      } else {
        push_field(h, l2, sp.field, o);
      }
      k = k + 1;
    }
    buf_push_byte(h, o.eol);
    return;
  }
  var c1: u64 = nfields(l1);
  var c2: u64 = nfields(l2);
  if (o.autofmt) {
    c1 = ac1;
    c2 = ac2;
  }
  if (b1) {
    push_range_or_filler(h, l2, l2.k0, l2.k1, o);
  } else {
    push_range_or_filler(h, l1, l1.k0, l1.k1, o);
  }
  push_fields(h, l1, o.jf1, c1, o);
  push_fields(h, l2, o.jf2, c2, o);
  buf_push_byte(h, o.eol);
}

// ---- the -o field list ------------------------------------------------------
// gnulib's add_field_list: comma- or blank-separated `FILENUM.FIELD`
// items, plus the bare `0` that names the join field.
function add_field_list(specs: Spec[], str: string): Spec[] {
  var out: Spec[] = specs;
  var i: i32 = 0;
  var n: i32 = str.len();
  while (true) {
    var j: i32 = i;
    while (j < n && str[j] as i32 != 44 && str[j] as i32 != 32 && str[j] as i32 != 9) {
      j = j + 1;
    }
    var item: string = slice_unchecked(str, i, j) + "";
    if (item == "0") {
      out = out.append(Spec { file: 0, field: 0 as u64 });
    } else {
      // The two faults are separate and in this order: a leading zero
      // or a missing dot is the SPECIFIER's shape, anything else in the
      // first byte is the file number.
      if (item.len() > 0 && item[0] as i32 == 48) {
        die_spec("invalid field specifier: ", item);
      }
      var fi: i32 = 0 - 1;
      if (item.len() > 0) {
        fi = item[0] as i32 - 48;
      }
      if (fi != 1 && fi != 2) {
        die_spec("invalid file number in field spec: ", item);
      }
      if (item.len() < 2 || item[1] as i32 != 46) {
        die_spec("invalid field specifier: ", item);
      }
      out = out.append(Spec { file: fi, field: field_number(slice_unchecked(item, 2, item.len()) + "") });
    }
    if (j >= n) {
      return out;
    }
    i = j + 1;
  }
  return out;
}

function die_spec(what: string, item: string): void {
  gnu.error(what + gnu.quote(item));
  exit(1);
}

// ---- the command line -------------------------------------------------------
// `Tok` — one thing the command line said, in the order it said it.
// Kind 0 is a file operand and 1-3 are the bare words that stood where
// an option argument was expected — an -o field spec, a -j1 field, a
// -j2 field — which are only CANDIDATES until the scan ends: a
// shortfall in the two file operands is made up from the END of the
// list. Kinds 4-8 are the values that came glued to their option and
// are never in doubt; they are recorded rather than acted on so that
// the whole line is applied in ONE ordered pass, which is what decides
// which of two conflicting join fields a diagnostic names first.
struct Tok { text: string, kind: i32 }

function tok_file(): i32 {
  return 0;
}

function tok_ospec(): i32 {
  return 4;
}

function tok_field1(): i32 {
  return 5;
}

function tok_field2(): i32 {
  return 6;
}

function tok_field_both(): i32 {
  return 7;
}

function tok_auto(): i32 {
  return 8;
}

// `Scan` — the option scan's running state.
struct Scan { o: Opts, toks: Tok[], nfiles: i32, pending: i32 }

function set_field_1(o: Opts, v: u64): Opts {
  if (o.jf1 != unset() && o.jf1 != v) {
    gnu.error("incompatible join fields " + o.jf1.to_string() + ", " + v.to_string());
    exit(1);
  }
  return Opts { ...o, jf1: v };
}

function set_field_2(o: Opts, v: u64): Opts {
  if (o.jf2 != unset() && o.jf2 != v) {
    gnu.error("incompatible join fields " + o.jf2.to_string() + ", " + v.to_string());
    exit(1);
  }
  return Opts { ...o, jf2: v };
}

function take_operand(s: Scan, name: string): Scan {
  if (s.nfiles == 2) {
    gnu.die_usage("extra operand " + gnu.quote(name), 1);
  }
  return Scan { ...s, toks: s.toks.append(Tok { text: name, kind: 0 }), nfiles: s.nfiles + 1 };
}

pub function main(): i32 {
  var argv: string[] = args();
  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("a", "", opt_a()));
  opts = opts.append(gnu.valued("e", "", opt_e()));
  opts = opts.append(gnu.flag("i", "ignore-case", opt_ignore()));
  opts = opts.append(gnu.valued("j", "", opt_j()));
  opts = opts.append(gnu.valued("o", "", opt_o()));
  opts = opts.append(gnu.valued("t", "", opt_t()));
  opts = opts.append(gnu.valued("v", "", opt_v()));
  opts = opts.append(gnu.valued("1", "", opt_1()));
  opts = opts.append(gnu.valued("2", "", opt_2()));
  opts = opts.append(gnu.flag("", "check-order", opt_check()));
  opts = opts.append(gnu.flag("", "nocheck-order", opt_nocheck()));
  opts = opts.append(gnu.flag("z", "zero-terminated", opt_zero()));
  opts = opts.append(gnu.flag("", "header", opt_header()));

  var none_specs: Spec[] = [];
  var none_toks: Tok[] = [];
  var o: Opts = Opts { jf1: unset(), jf2: unset(), tab: 0 - 1, eol: 10, filler: "", ignore_case: false, pairs: true, unpair1: false, unpair2: false, specs: none_specs, autofmt: false, check: check_default(), header: false };
  var s: Scan = Scan { o: o, toks: none_toks, nfiles: 0, pending: 0 };

  var g: gnu.Getopt = gnu.getopt_new(argv, opts, "join", help_text(), 1);
  while (true) {
    var r: (i32, gnu.OptMatch, gnu.Getopt) = g.next_argv_order();
    g = r.2;
    if (r.0 == 0) {
      break;
    }
    if (r.0 == 2) {
      // A bare word: the argument of the option just seen, or a file.
      if (s.pending != 0 && !g.after_dashdash()) {
        s = Scan { ...s, toks: s.toks.append(Tok { text: r.1.value, kind: s.pending }) };
        if (s.pending != 1) {
          s = Scan { ...s, pending: 0 };
        }
      } else {
        s = take_operand(s, r.1.value);
      }
      continue;
    }
    var m: gnu.OptMatch = r.1;
    var next_pending: i32 = 0;
    if (m.id == opt_a()) {
      if (file_number(m.value) == 1) {
        s = Scan { ...s, o: Opts { ...s.o, unpair1: true } };
      } else {
        s = Scan { ...s, o: Opts { ...s.o, unpair2: true } };
      }
    } else if (m.id == opt_v()) {
      if (file_number(m.value) == 1) {
        s = Scan { ...s, o: Opts { ...s.o, unpair1: true, pairs: false } };
      } else {
        s = Scan { ...s, o: Opts { ...s.o, unpair2: true, pairs: false } };
      }
    } else if (m.id == opt_e()) {
      s = Scan { ...s, o: Opts { ...s.o, filler: m.value } };
    } else if (m.id == opt_ignore()) {
      s = Scan { ...s, o: Opts { ...s.o, ignore_case: true } };
    } else if (m.id == opt_j()) {
      // `-j1` / `-j2` GLUED are the obsolete forms, which take their
      // field from the next argument; `-j 1` is the field itself.
      if (m.value == "1" && glued(argv, g, m.value)) {
        next_pending = 2;
      } else if (m.value == "2" && glued(argv, g, m.value)) {
        next_pending = 3;
      } else {
        s = Scan { ...s, toks: s.toks.append(Tok { text: m.value, kind: tok_field_both() }) };
      }
    } else if (m.id == opt_o()) {
      if (m.value == "auto") {
        s = Scan { ...s, toks: s.toks.append(Tok { text: "", kind: tok_auto() }) };
      } else {
        s = Scan { ...s, toks: s.toks.append(Tok { text: m.value, kind: tok_ospec() }) };
      }
      next_pending = 1;
    } else if (m.id == opt_t()) {
      s = Scan { ...s, o: set_tab(s.o, m.value) };
    } else if (m.id == opt_1()) {
      s = Scan { ...s, toks: s.toks.append(Tok { text: m.value, kind: tok_field1() }) };
    } else if (m.id == opt_2()) {
      s = Scan { ...s, toks: s.toks.append(Tok { text: m.value, kind: tok_field2() }) };
    } else if (m.id == opt_check()) {
      s = Scan { ...s, o: Opts { ...s.o, check: check_on() } };
    } else if (m.id == opt_nocheck()) {
      s = Scan { ...s, o: Opts { ...s.o, check: check_off() } };
    } else if (m.id == opt_zero()) {
      s = Scan { ...s, o: Opts { ...s.o, eol: 0 } };
    } else if (m.id == opt_header()) {
      s = Scan { ...s, o: Opts { ...s.o, header: true } };
    }
    s = Scan { ...s, pending: next_pending };
  }

  // The shortfall in the file operands is made up from the END of the
  // candidate list, so the earliest candidates stay option arguments
  // and the files keep their command-line order.
  var toks: Tok[] = s.toks;
  var want: i32 = 2 - s.nfiles;
  var k: i32 = toks.len() - 1;
  while (want > 0 && k >= 0) {
    if (toks[k].kind >= 1 && toks[k].kind <= 3) {
      toks = toks.with(k, Tok { text: toks[k].text, kind: tok_file() });
      want = want - 1;
    }
    k = k - 1;
  }
  var files: string[] = [];
  k = 0;
  while (k < toks.len()) {
    var t: Tok = toks[k];
    if (t.kind == tok_file()) {
      files = files.append(t.text);
    } else if (t.kind == 1 || t.kind == tok_ospec()) {
      s = Scan { ...s, o: Opts { ...s.o, specs: add_field_list(s.o.specs, t.text), autofmt: false } };
    } else if (t.kind == 2 || t.kind == tok_field1()) {
      s = Scan { ...s, o: set_field_1(s.o, field_number(t.text)) };
    } else if (t.kind == 3 || t.kind == tok_field2()) {
      s = Scan { ...s, o: set_field_2(s.o, field_number(t.text)) };
    } else if (t.kind == tok_field_both()) {
      var v: u64 = field_number(t.text);
      s = Scan { ...s, o: set_field_2(set_field_1(s.o, v), v) };
    } else {
      s = Scan { ...s, o: Opts { ...s.o, autofmt: true } };
    }
    k = k + 1;
  }

  if (files.len() == 0) {
    gnu.die_usage("missing operand", 1);
  }
  if (files.len() == 1) {
    gnu.die_usage("missing operand after " + gnu.quote(files[0]), 1);
  }

  o = s.o;
  if (o.jf1 == unset()) {
    o = Opts { ...o, jf1: 0 as u64 };
  }
  if (o.jf2 == unset()) {
    o = Opts { ...o, jf2: 0 as u64 };
  }

  if (files[0] == "-" && files[1] == "-") {
    gnu.error("both files cannot be standard input");
    exit(1);
  }

  var in1: In = open_input(files[0], 1);
  var in2: In = open_input(files[1], 2);

  var w: io_buffered.BufWriter = gnu.out_new();
  var run: Run = Run { unpairable: false, disorder: false };

  // The first line of a file has nothing before it, so neither read
  // can leave a disorder to report.
  in1 = next_line(in1, o, run.unpairable, w);
  var have1: boolean = in1.have;
  var l1: Line = in1.line;
  in2 = next_line(in2, o, run.unpairable, w);
  var have2: boolean = in2.have;
  var l2: Line = in2.line;

  var ac1: u64 = 0 as u64;
  var ac2: u64 = 0 as u64;
  if (have1) {
    ac1 = nfields(l1);
  }
  if (have2) {
    ac2 = nfields(l2);
  }

  if (o.header && (have1 || have2)) {
    var h1: Line = blank_line();
    var h2: Line = blank_line();
    if (have1) {
      h1 = l1;
    }
    if (have2) {
      h2 = l2;
    }
    push_join(w.handle(), h1, h2, !have1, o, ac1, ac2);
    w = gnu.settle(w);
    // A header is not compared with the line after it.
    in1 = In { ...in1, hasprev: false };
    in2 = In { ...in2, hasprev: false };
    if (have1) {
      in1 = next_line(in1, o, run.unpairable, w);
      if (in1.msg.len() > 0) {
        var d: (In, Run, io_buffered.BufWriter) = report(in1, o, run, w);
        in1 = d.0;
        run = d.1;
        w = d.2;
      }
      have1 = in1.have;
      l1 = in1.line;
    }
    if (have2) {
      in2 = next_line(in2, o, run.unpairable, w);
      if (in2.msg.len() > 0) {
        var d: (In, Run, io_buffered.BufWriter) = report(in2, o, run, w);
        in2 = d.0;
        run = d.1;
        w = d.2;
      }
      have2 = in2.have;
      l2 = in2.line;
    }
  }

  var blank: Line = blank_line();
  while (have1 && have2) {
    var d: i32 = keycmp(l1, l2, o.ignore_case);
    if (d < 0) {
      if (o.unpair1) {
        push_join(w.handle(), l1, blank, false, o, ac1, ac2);
        w = gnu.settle(w);
      }
      in1 = next_line(in1, o, run.unpairable, w);
      if (in1.msg.len() > 0) {
        var d: (In, Run, io_buffered.BufWriter) = report(in1, o, run, w);
        in1 = d.0;
        run = d.1;
        w = d.2;
      }
      have1 = in1.have;
      l1 = in1.line;
      // Set only AFTER the next line has been read: the line that
      // follows the first unpairable one is still exempt.
      run = Run { ...run, unpairable: true };
      continue;
    }
    if (d > 0) {
      if (o.unpair2) {
        push_join(w.handle(), blank, l2, true, o, ac1, ac2);
        w = gnu.settle(w);
      }
      in2 = next_line(in2, o, run.unpairable, w);
      if (in2.msg.len() > 0) {
        var d: (In, Run, io_buffered.BufWriter) = report(in2, o, run, w);
        in2 = d.0;
        run = d.1;
        w = d.2;
      }
      have2 = in2.have;
      l2 = in2.line;
      run = Run { ...run, unpairable: true };
      continue;
    }
    // Equal keys. Both sides are read forward to the first line with a
    // different key and the cross product of the two groups is printed.
    // One line on each side is the overwhelmingly common shape and is
    // kept off the group arrays entirely, because allocating two of
    // them per matched key is most of what this loop costs.
    var head1: Line = l1;
    var head2: Line = l2;
    var g1: Line[] = [];
    var g2: Line[] = [];
    var many1: boolean = false;
    var many2: boolean = false;
    while (true) {
      in1 = next_line(in1, o, run.unpairable, w);
      if (in1.msg.len() > 0) {
        var d: (In, Run, io_buffered.BufWriter) = report(in1, o, run, w);
        in1 = d.0;
        run = d.1;
        w = d.2;
      }
      have1 = in1.have;
      l1 = in1.line;
      if (!have1 || keycmp(l1, head1, o.ignore_case) != 0) {
        break;
      }
      if (!many1) {
        g1 = g1.append(head1);
        many1 = true;
      }
      g1 = g1.append(l1);
    }
    while (true) {
      in2 = next_line(in2, o, run.unpairable, w);
      if (in2.msg.len() > 0) {
        var d: (In, Run, io_buffered.BufWriter) = report(in2, o, run, w);
        in2 = d.0;
        run = d.1;
        w = d.2;
      }
      have2 = in2.have;
      l2 = in2.line;
      if (!have2 || keycmp(l2, head2, o.ignore_case) != 0) {
        break;
      }
      if (!many2) {
        g2 = g2.append(head2);
        many2 = true;
      }
      g2 = g2.append(l2);
    }
    if (o.pairs) {
      if (!many1 && !many2) {
        push_join(w.handle(), head1, head2, false, o, ac1, ac2);
        w = gnu.settle(w);
      } else {
        if (!many1) {
          g1 = g1.append(head1);
        }
        if (!many2) {
          g2 = g2.append(head2);
        }
        var i: i32 = 0;
        while (i < g1.len()) {
          var j: i32 = 0;
          while (j < g2.len()) {
            push_join(w.handle(), g1[i], g2[j], false, o, ac1, ac2);
            w = gnu.settle(w);
            j = j + 1;
          }
          i = i + 1;
        }
      }
    }
  }

  // Both files are read to the end whether or not anything is printed
  // from them: the order check only sees the lines it reads.
  while (have1) {
    if (o.unpair1) {
      push_join(w.handle(), l1, blank, false, o, ac1, ac2);
      w = gnu.settle(w);
    }
    in1 = next_line(in1, o, run.unpairable, w);
    if (in1.msg.len() > 0) {
      var d: (In, Run, io_buffered.BufWriter) = report(in1, o, run, w);
      in1 = d.0;
      run = d.1;
      w = d.2;
    }
    have1 = in1.have;
    l1 = in1.line;
  }
  while (have2) {
    if (o.unpair2) {
      push_join(w.handle(), blank, l2, true, o, ac1, ac2);
      w = gnu.settle(w);
    }
    in2 = next_line(in2, o, run.unpairable, w);
    if (in2.msg.len() > 0) {
      var d: (In, Run, io_buffered.BufWriter) = report(in2, o, run, w);
      in2 = d.0;
      run = d.1;
      w = d.2;
    }
    have2 = in2.have;
    l2 = in2.line;
  }

  if (!in1.is_stdin) {
    in1.r.close();
  }
  if (!in2.is_stdin) {
    in2.r.close();
  }
  if (run.disorder) {
    w = gnu.error_out(w, "input is not in sorted order");
    gnu.finish(w);
    return 1;
  }
  gnu.finish(w);
  return 0;
}

// `set_tab(o, arg)` — -t. An empty argument means the whole line is
// one field, which GNU spells as a newline separator; `\0` names NUL;
// two different -t characters are refused.
function set_tab(o: Opts, arg: string): Opts {
  var t: i32 = 10;
  if (arg.len() > 0) {
    t = arg[0] as i32;
    if (arg.len() > 1) {
      if (arg == "\\0") {
        t = 0;
      } else {
        gnu.error("multi-character tab " + gnu.quote(arg));
        exit(1);
      }
    }
  }
  if (o.tab >= 0 && o.tab != t) {
    gnu.error("incompatible tabs");
    exit(1);
  }
  return Opts { ...o, tab: t };
}

// `glued(argv, g, digit)` — whether the `-j` just matched was written
// `-jN` rather than `-j N`. Only the glued spelling is the obsolete
// form, so `join -j 1 f1 f2` joins on field 1 while `join -j1 2 f1 f2`
// joins file 1 on field 2.
function glued(argv: string[], g: gnu.Getopt, value: string): boolean {
  var i: i32 = g.index() - 1;
  if (i < 0 || i >= argv.len()) {
    return false;
  }
  return argv[i] != value;
}

function open_input(path: string, which: i32): In {
  var name: string = path;
  if (path == "-") {
    return In { r: stdin(), is_stdin: true, buf: "", pos: 0, eof: false, name: name, no: 0 as u64, hasprev: false, warned: false, which: which, have: false, line: blank_line(), msg: "", tab_at: stale(), nl_at: stale() };
  }
  match (open_reader(path)) {
    Ok(f) => {
      return In { r: f, is_stdin: false, buf: "", pos: 0, eof: false, name: name, no: 0 as u64, hasprev: false, warned: false, which: which, have: false, line: blank_line(), msg: "", tab_at: stale(), nl_at: stale() };
    },
    Err(e) => {
      gnu.error(gnu.quotef(path) + ": " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return In { r: stdin(), is_stdin: true, buf: "", pos: 0, eof: false, name: name, no: 0 as u64, hasprev: false, warned: false, which: which, have: false, line: blank_line(), msg: "", tab_at: stale(), nl_at: stale() };
}
