import "std/u64";
import "./lib/gnu";
import "./lib/cpuquota";

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]...\n";
  out = out + "Print the number of processing units available to the current process,\n";
  out = out + "which may be less than the number of online processors\n";
  out = out + "\n";
  out = out + "      --all      print the number of installed processors\n";
  out = out + "      --ignore=N  if possible, exclude N processing units\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function opt_all(): i32 {
  return 1;
}

function opt_ignore(): i32 {
  return 2;
}

function ulong_max(): u64 {
  return 18446744073709551615 as u64;
}

function is_space(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

function parse_omp(name: string): u64 {
  let raw: string = "";
  match (env(name)) {
    Some(v) => {
      raw = v;
    },
    None => {
      return 0 as u64;
    }
  }
  let i: i32 = 0;
  while (i < raw.len() && is_space(raw[i] as i32)) {
    i = i + 1;
  }
  if (i >= raw.len() || !gnu.is_digit(raw[i] as i32)) {
    return 0 as u64;
  }
  let v: u64 = 0 as u64;
  let over: boolean = false;
  while (i < raw.len() && gnu.is_digit(raw[i] as i32)) {
    let d: u64 = (raw[i] as i32 - 48) as u64;
    match (v.checked_mul(10 as u64)) {
      Some(m) => {
        match (m.checked_add(d)) {
          Some(a) => {
            v = a;
          },
          None => {
            over = true;
          }
        }
      },
      None => {
        over = true;
      }
    }
    i = i + 1;
  }
  while (i < raw.len() && is_space(raw[i] as i32)) {
    i = i + 1;
  }
  if (i < raw.len() && raw[i] as i32 != 44) {
    return 0 as u64;
  }
  if (over) {
    return ulong_max();
  }
  return v;
}

function available_count(): u64 {
  let n: i32 = cpu_count();
  if (n <= 0) {
    return 1 as u64;
  }
  return n as u64;
}

function is_cpu_dir(name: string): boolean {
  if (!name.starts_with("cpu") || name.len() < 4) {
    return false;
  }
  let i: i32 = 3;
  while (i < name.len()) {
    if (!gnu.is_digit(name[i] as i32)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function installed_count(): u64 {
  match (read_dir("/sys/devices/system/cpu")) {
    Ok(entries) => {
      let n: i32 = 0;
      let i: i32 = 0;
      while (i < entries.len()) {
        if (is_cpu_dir(entries[i])) {
          n = n + 1;
        }
        i = i + 1;
      }
      if (n > 0) {
        return n as u64;
      }
    },
    Err(_) => {}
  }
  match (read_file("/proc/cpuinfo")) {
    Ok(text) => {
      let n: i32 = count_processor_lines(text);
      if (n > 0) {
        return n as u64;
      }
    },
    Err(_) => {}
  }
  return available_count();
}

function count_processor_lines(text: string): i32 {
  let word: string = "processor";
  let n: i32 = 0;
  let i: i32 = 0;
  let at_line_start: boolean = true;
  while (i < text.len()) {
    if (at_line_start && starts_word(text, i, word)) {
      n = n + 1;
    }
    at_line_start = text[i] as i32 == 10;
    i = i + 1;
  }
  return n;
}

function starts_word(text: string, at: i32, word: string): boolean {
  if (at + word.len() > text.len()) {
    return false;
  }
  let k: i32 = 0;
  while (k < word.len()) {
    if (text[at + k] != word[k]) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

function min_u64(a: u64, b: u64): u64 {
  if (a < b) {
    return a;
  }
  return b;
}

pub function main(): i32 {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("", "all", opt_all()));
  opts = opts.append(gnu.valued("", "ignore", opt_ignore()));

  let all: boolean = false;
  let ignore: u64 = 0 as u64;
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "nproc", help_text(), 1);
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_all()) {
          all = true;
        } else if (m.id == opt_ignore()) {
          ignore = parse_ignore(m.value);
        }
      },
      None => {
        break;
      }
    }
  }
  let operands: string[] = g.operands();
  if (operands.len() > 0) {
    gnu.die_usage("extra operand " + gnu.quote(operands[0]), 1);
  }

  let n: u64 = count_for(all);
  if (ignore < n) {
    n = n - ignore;
  } else {
    n = 1 as u64;
  }
  gnu.write_out(n.to_string() + "\n");
  return 0;
}

function parse_ignore(v: string): u64 {
  let r: (u64, i32) = gnu.parse_number(v);
  if (r.1 == 0) {
    return r.0;
  }
  if (gnu.count_overflow(r.1)) {
    return 18446744073709551615 as u64;
  }
  gnu.error("invalid number: " + gnu.quote(v));
  exit(1);
  return 0 as u64;
}

function count_for(all: boolean): u64 {
  if (all) {
    return installed_count();
  }
  let limit: u64 = parse_omp("OMP_THREAD_LIMIT");
  if (limit == 0 as u64) {
    limit = ulong_max();
  }
  let threads: u64 = parse_omp("OMP_NUM_THREADS");
  if (threads != 0 as u64) {
    return min_u64(threads, limit);
  }
  let n: u64 = available_count();
  let quota: u64 = cpuquota.current();
  if (quota > 0 as u64) {
    n = min_u64(n, quota);
  }
  return min_u64(n, limit);
}
