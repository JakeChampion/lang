import "std/string";
import "std/array";
import "./lib/gnu";
import "./lib/base";

function opt_decode(): i32 {
  return 1;
}

function opt_ignore(): i32 {
  return 2;
}

function opt_wrap(): i32 {
  return 3;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]\n";
  out += "Write FILE, or standard input, to standard output as base64.\n";
  out += "\n";
  out += "With no FILE, or when FILE is -, read standard input.\n";
  out += "\n";
  out += "  -d, --decode          decode data\n";
  out += "  -i, --ignore-garbage  when decoding, ignore non-alphabet characters\n";
  out += "  -w, --wrap=COLS       wrap encoded lines after COLS characters (default 76);\n";
  out += "                          0 disables wrapping\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  out += "\n";
  out += "The alphabet is the one RFC 4648 section 4 names. Decoding accepts\n";
  out += "newlines in the encoded stream; -i accepts any other stray byte too.\n";
  return out;
}

pub function main(): i32 {
  let argv = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("d", "decode", opt_decode()));
  opts = opts.append(gnu.valued("w", "wrap", opt_wrap()));
  opts = opts.append(gnu.flag("i", "ignore-garbage", opt_ignore()));
  let g = gnu.getopt_new(argv, opts, "base64", help_text(), 1);
  let decode = false;
  let ignore = false;
  let wrap = 76 as i64;
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_decode()) {
          decode = true;
        } else if (m.id == opt_ignore()) {
          ignore = true;
        } else {
          wrap = base.parse_wrap(m.value);
        }
      },
      None => {
        break;
      }
    }
  }
  let ops = g.operands();
  if (ops.len() > 1) {
    gnu.die_usage("extra operand " + gnu.quote(ops[1]), 1);
  }
  let file = "";
  if (ops.len() == 1) {
    file = ops[0];
  }
  base.run(base.base64(), decode, ignore, wrap, ops.len() == 1, file);
  return 0;
}
