import "std/array";
import "./lib/gnu";
import "./lib/mode";
import "./lib/selinux";

function opt_context(): i32 {
  return 1;
}

function opt_mode(): i32 {
  return 2;
}

function opt_z(): i32 {
  return 3;
}

function s_ififo(): i32 {
  return 4096;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... NAME...\n";
  out = out + "Create named pipes (FIFOs) with the given NAMEs.\n";
  out = out + "\n";
  out = out + "  -m, --mode=MODE    set file permission bits to MODE, not a=rw - umask\n";
  out = out + "  -Z                 set the SELinux security context to default type\n";
  out = out + "      --context[=CTX]  like -Z, or if CTX is specified then set the\n";
  out = out + "                         SELinux or SMACK security context to CTX\n";
  out = out + "      --help         display this help and exit\n";
  out = out + "      --version      output version information and exit\n";
  return out;
}

function security_context(named: boolean): void {
  if (selinux.enabled()) {
    gnu.error("setting a security context is not supported on this system");
    exit(1);
  }
  if (named) {
    gnu.error("warning: ignoring --context; it requires an SELinux/SMACK-enabled kernel");
  }
}

struct Scan { mode_text: string, mode_given: boolean }

function scan_options(): (Scan, string[]) {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.optional("", "context", opt_context()));
  opts = opts.append(gnu.valued("m", "mode", opt_mode()));
  opts = opts.append(gnu.flag("Z", "", opt_z()));

  let s: Scan = Scan { mode_text: "", mode_given: false };
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "mkfifo", help_text(), 1);
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_mode()) {
          s = Scan { mode_text: m.value, mode_given: true };
        } else {
          security_context(m.has_value);
        }
      },
      None => {
        break;
      }
    }
  }
  return (s, g.operands());
}

function compile_mode(text: string): i32 {
  match (mode.compile(text)) {
    Some(c) => {
      let mask: i32 = umask(0);
      umask(mask);
      let a: mode.Adjusted = c.adjust(438, false, mask);
      if ((a.mode & mode.complement(mode.s_irwxugo())) != 0) {
        gnu.error("mode must specify only file permission bits");
        exit(1);
      }
      return a.mode;
    },
    None => {
      gnu.error("invalid mode");
      exit(1);
    }
  }
  return 0;
}

function make(name: string, perm: i32, mode_given: boolean): boolean {
  match (mknod(name, perm | s_ififo(), 0, 0)) {
    Ok(_) => {},
    Err(e) => {
      gnu.error("cannot create fifo " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      return false;
    }
  }
  if (!mode_given) {
    return true;
  }
  match (chmod(name, perm)) {
    Ok(_) => {
      return true;
    },
    Err(e) => {
      gnu.error("cannot set permissions of " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      return false;
    }
  }
}

pub function main(): i32 {
  let scanned: (Scan, string[]) = scan_options();
  let s: Scan = scanned.0;
  let operands: string[] = scanned.1;
  if (operands.len() == 0) {
    gnu.die_usage("missing operand", 1);
  }

  let perm: i32 = 438;
  if (s.mode_given) {
    perm = compile_mode(s.mode_text);
  }

  let ok: boolean = true;
  let i: i32 = 0;
  while (i < operands.len()) {
    if (!make(operands[i], perm, s.mode_given)) {
      ok = false;
    }
    i = i + 1;
  }
  if (ok) {
    return 0;
  }
  return 1;
}
