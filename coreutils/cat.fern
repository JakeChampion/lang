import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";

function opt_number_nonblank(): i32 {
  return 1;
}

function opt_e(): i32 {
  return 2;
}

function opt_show_ends(): i32 {
  return 3;
}

function opt_number(): i32 {
  return 4;
}

function opt_squeeze(): i32 {
  return 5;
}

function opt_t(): i32 {
  return 6;
}

function opt_show_tabs(): i32 {
  return 7;
}

function opt_u(): i32 {
  return 8;
}

function opt_show_nonprinting(): i32 {
  return 9;
}

function opt_show_all(): i32 {
  return 10;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Concatenate FILE(s) to standard output.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -A, --show-all           equivalent to -vET\n";
  out = out + "  -b, --number-nonblank    number nonempty output lines, overrides -n\n";
  out = out + "  -e                       equivalent to -vE\n";
  out = out + "  -E, --show-ends          display $ at end of each line\n";
  out = out + "  -n, --number             number all output lines\n";
  out = out + "  -s, --squeeze-blank      suppress repeated empty output lines\n";
  out = out + "  -t                       equivalent to -vT\n";
  out = out + "  -T, --show-tabs          display TAB characters as ^I\n";
  out = out + "  -u                       (ignored)\n";
  out = out + "  -v, --show-nonprinting   use ^ and M- notation, except for LFD and TAB\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "Examples:\n";
  out = out + "  " + gnu.prog() + " f - g  Output f's contents, then standard input, then g's contents.\n";
  out = out + "  " + gnu.prog() + "        Copy standard input to standard output.\n";
  return out;
}

struct Fmt { number: boolean, nonblank: boolean, squeeze: boolean, ends: boolean, tabs: boolean, np: boolean, spell: u8[][], stop: u8[], expand: u8[], tails: string }

function is_plain(f: Fmt): boolean {
  return !f.number && !f.nonblank && !f.squeeze && !f.ends && !f.tabs && !f.np;
}

function is_spell_only(f: Fmt): boolean {
  return (f.np || f.tabs || f.ends) && !f.number && !f.nonblank && !f.squeeze;
}

function is_squeeze_only(f: Fmt): boolean {
  return f.squeeze && !f.number && !f.nonblank && !f.ends && !f.tabs && !f.np;
}

function spelling(b: i32, f: Fmt): u8[] {
  if (b == 9) {
    if (f.tabs) {
      return [b'^', b'I'];
    }
    return [];
  }
  if (!f.np || b >= 32 && b < 127 || b == 10) {
    return [];
  }
  if (b >= 128) {
    let c: i32 = b - 128;
    if (c < 32) {
      return [b'M', b'-', b'^', (c + 64) as u8];
    }
    if (c == 127) {
      return [b'M', b'-', b'^', b'?'];
    }
    return [b'M', b'-', c as u8];
  }
  if (b < 32) {
    return [b'^', (b + 64) as u8];
  }
  return [b'^', b'?'];
}

function spell_table(f: Fmt): Fmt {
  let tab: u8[][] = [];
  let stop: u8[] = __alloc_u8(256);
  let expand: u8[] = __alloc_u8(2048);
  let b: i32 = 0;
  while (b < 256) {
    let s: u8[] = spelling(b, f);
    tab = tab.append(s);
    stop = stop.with(b, s.len() as u8);
    let out: u8[] = s;
    if (b == 10) {
      out = [b'\n'];
      if (f.ends) {
        out = [b'$', b'\n'];
      }
    } else if (s.len() == 0) {
      out = [b as u8];
    }
    expand = expand.with(b * 8, out.len() as u8);
    let k: i32 = 0;
    while (k < out.len()) {
      expand = expand.with(b * 8 + 1 + k, out[k]);
      k = k + 1;
    }
    b = b + 1;
  }
  stop = stop.with(10, 1 as u8);
  return Fmt { ...f, spell: tab, stop: stop, expand: expand };
}

struct State { w: io_buffered.BufWriter, num: u64, head: string, base: u64, at_start: boolean, prev_blank: boolean, pending_cr: boolean, ok: boolean }

function read_size(): i32 {
  return 131072;
}

function splice_size(): i32 {
  return 1048576;
}

function splice_floor(): i64 {
  return 32768 as i64;
}

function state_new(): State {
  return State { w: gnu.out_with(read_size()), num: 0 as u64, head: "    ", base: 0 as u64, at_start: true, prev_blank: false, pending_cr: false, ok: true };
}

function number_tails(): string {
  let out: u8[] = __alloc_u8(600);
  let i: i32 = 0;
  while (i < 200) {
    let n: i32 = i % 100;
    let tens: i32 = 48 + n / 10;
    if (i >= 100 && n < 10) {
      tens = 32;
    }
    out = out.with(i * 3, tens as u8);
    out = out.with(i * 3 + 1, (48 + n % 10) as u8);
    out = out.with(i * 3 + 2, 9 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

function head_for(q: u64): string {
  let digits: string = (q as i64).to_string();
  let pad: i32 = 4 - digits.len();
  if (pad <= 0) {
    return digits;
  }
  let out: u8[] = __alloc_u8(4);
  let i: i32 = 0;
  while (i < pad) {
    out = out.with(i, 32 as u8);
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < digits.len()) {
    out = out.with(pad + j, digits[j]);
    j = j + 1;
  }
  return string_from_bytes_unchecked(out);
}

function drain(s: State): State {
  return State { ...s, w: gnu.flush(s.w) };
}

function format_chunk(st: State, chunk: u8[], f: Fmt): State {
  let s: State = st;
  let w: io_buffered.BufWriter = s.w;
  let h: usize = w.handle();
  let num: u64 = s.num;
  let head: string = s.head;
  let base: u64 = s.base;
  let tails: string = f.tails;
  let toff: i32 = 0;
  if (base == 0 as u64) {
    toff = 300;
  }
  let at_start: boolean = s.at_start;
  let prev_blank: boolean = s.prev_blank;
  let pos: i32 = 0;
  let len: i32 = chunk.len();
  let spell: boolean = f.np || f.tabs;
  let stop: u8[] = f.stop;
  let squeeze: boolean = f.squeeze;
  let nonblank: boolean = f.nonblank;
  let number: boolean = f.number;
  let ends: boolean = f.ends;
  let cr_mark: boolean = ends && !f.np;
  if (s.pending_cr) {
    if (chunk[0] as i32 == 10) {
      buf_push(h, "^M");
    } else {
      buf_push_byte(h, 13);
    }
  }
  let pending_cr: boolean = false;
  while (pos < len) {
    let nl: i32 = __memchr_bytes(chunk, 10, pos);
    let end: i32 = nl;
    if (nl < 0) {
      end = len;
    }
    if (at_start) {
      let blank: boolean = nl == pos;
      if (blank && squeeze && prev_blank) {
        pos = nl + 1;
        continue;
      }
      if (nonblank && !blank || !nonblank && number) {
        num = num + 1 as u64;
        if (num - base >= 100 as u64) {
          base = num / (100 as u64) * (100 as u64);
          head = head_for(base / (100 as u64));
          toff = 0;
        }
        let t: i32 = toff + (num - base) as i32 * 3;
        buf_push_range(h, head, 0, head.len());
        buf_push_range(h, tails, t, t + 3);
      }
      at_start = false;
      prev_blank = blank;
    }
    if (spell) {
      let i: i32 = __scan_set_bytes(chunk, pos, stop);
      while (i < end) {
        buf_push_bytes_range(h, chunk, pos, i);
        let spelled: u8[] = f.spell[chunk[i] as i32];
        buf_push_bytes_range(h, spelled, 0, spelled.len());
        pos = i + 1;
        i = __scan_set_bytes(chunk, pos, stop);
      }
    }
    if (nl < 0) {
      if (cr_mark && chunk[len - 1] as i32 == 13) {
        buf_push_bytes_range(h, chunk, pos, len - 1);
        pending_cr = true;
      } else {
        buf_push_bytes_range(h, chunk, pos, len);
      }
      pos = len;
    } else {
      if (cr_mark && nl > pos && chunk[nl - 1] as i32 == 13) {
        buf_push_bytes_range(h, chunk, pos, nl - 1);
        buf_push(h, "^M$\n");
      } else if (ends) {
        buf_push_bytes_range(h, chunk, pos, nl);
        buf_push(h, "$\n");
      } else {
        buf_push_bytes_range(h, chunk, pos, nl + 1);
      }
      at_start = true;
      pos = nl + 1;
    }
  }
  return State { ...s, w: gnu.check(gnu.settle(w)), num: num, head: head, base: base, at_start: at_start, prev_blank: prev_blank, pending_cr: pending_cr };
}

function spell_chunk(st: State, chunk: u8[], f: Fmt): State {
  if (f.ends && !f.np && (st.pending_cr || __memchr_bytes(chunk, 13, 0) >= 0)) {
    return format_chunk(st, chunk, f);
  }
  return State { ...st, w: gnu.check(st.w.write_bytes_expanded(chunk, f.expand)), at_start: chunk[chunk.len() - 1] as i32 == 10 };
}

function squeeze_chunk(st: State, chunk: u8[]): State {
  let s: State = st;
  let w: io_buffered.BufWriter = s.w;
  let h: usize = w.handle();
  let at_start: boolean = s.at_start;
  let prev_blank: boolean = s.prev_blank;
  let pos: i32 = 0;
  let len: i32 = chunk.len();
  while (pos < len) {
    if (at_start && chunk[pos] as i32 == 10) {
      if (!prev_blank) {
        buf_push_byte(h, 10);
        prev_blank = true;
      }
      pos = pos + 1;
      continue;
    }
    let q: i32 = __memchr_bytes(chunk, 10, pos);
    while (q >= 0 && q + 1 < len && chunk[q + 1] as i32 != 10) {
      q = __memchr_bytes(chunk, 10, q + 1);
    }
    let end: i32 = len;
    at_start = false;
    if (q >= 0) {
      end = q + 1;
      at_start = true;
    }
    buf_push_bytes_range(h, chunk, pos, end);
    prev_blank = false;
    pos = end;
    w = gnu.settle(w);
  }
  return State { ...s, w: gnu.check(w), at_start: at_start, prev_blank: prev_blank };
}

function fail(st: State, msg: string): State {
  let s: State = drain(st);
  return State { ...s, w: gnu.error_out(s.w, msg), ok: false };
}

function splice_all(r: Reader): Result[boolean, IoError] {
  let out: Writer = stdout();
  match (copy_all(r, out)) {
    Ok(done) => {
      if (done) {
        return Ok(true);
      }
    },
    Err(e) => {
      return Err(e);
    }
  }
  while (true) {
    match (r.splice_to(out, splice_size())) {
      Ok(n) => {
        if (n == 0 as i64) {
          return Ok(true);
        }
      },
      Err(e) => {
        match (e) {
          Unsupported => {
            return Ok(false);
          },
          _ => {
            gnu.error("write error: " + gnu.io_error_text(e));
            exit(1);
          }
        }
      }
    }
  }
}

function copy_all(r: Reader, out: Writer): Result[boolean, IoError] {
  let copied: boolean = false;
  while (true) {
    match (r.copy_range_to(out, splice_size())) {
      Ok(n) => {
        if (n == 0 as i64) {
          return Ok(copied);
        }
        copied = true;
      },
      Err(e) => {
        match (e) {
          Unsupported => {
            return Ok(false);
          },
          _ => {
            return Err(e);
          }
        }
      }
    }
  }
}

function cat_file(path: string, st: State, f: Fmt, out_stat: FileStat): State {
  let s: State = st;
  let stdin_input: boolean = path == "-";
  let r: Reader = stdin();
  if (!stdin_input) {
    match (open_reader(path)) {
      Ok(fd) => {
        r = fd;
      },
      Err(e) => {
        return fail(s, gnu.quotef(path) + ": " + gnu.io_error_text(e));
      }
    }
  }
  let small: boolean = false;
  match (r.stat()) {
    Ok(in_stat) => {
      small = in_stat.is_file && in_stat.size <= splice_floor();
      if (out_stat.is_file && in_stat.dev == out_stat.dev && in_stat.ino == out_stat.ino) {
        match (r.seek(0 as i64, 1)) {
          Ok(pos) => {
            if (pos < in_stat.size) {
              if (!stdin_input) {
                r.close();
              }
              return fail(s, gnu.quotef(path) + ": input file is output file");
            }
          },
          Err(_) => {}
        }
      }
    },
    Err(e) => {
      if (!stdin_input) {
        r.close();
      }
      return fail(s, gnu.quotef(path) + ": " + gnu.io_error_text(e));
    }
  }
  let plain: boolean = is_plain(f);
  let squeeze_only: boolean = is_squeeze_only(f);
  let spell_only: boolean = is_spell_only(f);
  let done: boolean = false;
  if (plain && !small) {
    s = drain(s);
    match (splice_all(r)) {
      Ok(d) => {
        done = d;
      },
      Err(e) => {
        s = fail(s, gnu.quotef(path) + ": " + gnu.io_error_text(e));
        done = true;
      }
    }
  }
  while (!done) {
    match (r.read_chunk_bytes(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          break;
        }
        if (plain) {
          s = State { ...s, w: gnu.check(s.w.write_bytes(chunk)) };
        } else if (squeeze_only) {
          s = squeeze_chunk(s, chunk);
        } else if (spell_only) {
          s = spell_chunk(s, chunk, f);
        } else {
          s = format_chunk(s, chunk, f);
        }
      },
      Err(e) => {
        s = fail(s, gnu.quotef(path) + ": " + gnu.io_error_text(e));
        break;
      }
    }
  }
  if (!stdin_input) {
    r.close();
  }
  s = drain(s);
  return State { ...s, w: gnu.flush(s.w) };
}

pub function main(): i32 {
  let argv: string[] = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("b", "number-nonblank", opt_number_nonblank()));
  opts = opts.append(gnu.flag("n", "number", opt_number()));
  opts = opts.append(gnu.flag("s", "squeeze-blank", opt_squeeze()));
  opts = opts.append(gnu.flag("v", "show-nonprinting", opt_show_nonprinting()));
  opts = opts.append(gnu.flag("E", "show-ends", opt_show_ends()));
  opts = opts.append(gnu.flag("T", "show-tabs", opt_show_tabs()));
  opts = opts.append(gnu.flag("A", "show-all", opt_show_all()));
  opts = opts.append(gnu.flag("e", "", opt_e()));
  opts = opts.append(gnu.flag("t", "", opt_t()));
  opts = opts.append(gnu.flag("u", "", opt_u()));

  let f: Fmt = Fmt { number: false, nonblank: false, squeeze: false, ends: false, tabs: false, np: false, spell: [], stop: [], expand: [], tails: "" };
  let g: gnu.Getopt = gnu.getopt_new(argv, opts, "cat", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_number_nonblank()) {
          f = Fmt { ...f, nonblank: true };
        } else if (m.id == opt_e()) {
          f = Fmt { ...f, np: true, ends: true };
        } else if (m.id == opt_show_ends()) {
          f = Fmt { ...f, ends: true };
        } else if (m.id == opt_number()) {
          f = Fmt { ...f, number: true };
        } else if (m.id == opt_squeeze()) {
          f = Fmt { ...f, squeeze: true };
        } else if (m.id == opt_t()) {
          f = Fmt { ...f, np: true, tabs: true };
        } else if (m.id == opt_show_tabs()) {
          f = Fmt { ...f, tabs: true };
        } else if (m.id == opt_show_nonprinting()) {
          f = Fmt { ...f, np: true };
        } else if (m.id == opt_show_all()) {
          f = Fmt { ...f, np: true, ends: true, tabs: true };
        }
      },
      None => {
        break;
      }
    }
  }

  f = spell_table(f);
  if (f.number || f.nonblank) {
    f = Fmt { ...f, tails: number_tails() };
  }

  let out_stat: FileStat = FileStat { is_file: false, is_dir: false, size: 0 as i64, mode: 0 as u32, nlink: 0 as u32, uid: 0 as u32, gid: 0 as u32, dev: 0 as i64, rdev: 0 as i64, ino: 0 as i64, blksize: 0 as i64, blocks: 0 as i64, atime: 0 as i64, atime_nsec: 0 as i64, mtime: 0 as i64, mtime_nsec: 0 as i64, ctime: 0 as i64, ctime_nsec: 0 as i64, btime: 0 as i64, btime_nsec: 0 as i64 };
  match (stdout().stat()) {
    Ok(o) => {
      out_stat = o;
    },
    Err(e) => {
      gnu.error("standard output: " + gnu.io_error_text(e));
      exit(1);
    }
  }

  let files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  let st: State = state_new();
  let i: i32 = 0;
  while (i < files.len()) {
    st = cat_file(files[i], st, f, out_stat);
    i = i + 1;
  }
  if (st.pending_cr) {
    st = State { ...st, w: gnu.put(st.w, "\r") };
  }
  gnu.finish(st.w);
  if (!st.ok) {
    return 1;
  }
  return 0;
}
