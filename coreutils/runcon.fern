import "std/string";
import "std/array";
import "./lib/gnu";
import "./lib/selinux";

function opt_role(): i32 {
  return 1;
}

function opt_type(): i32 {
  return 2;
}

function opt_user(): i32 {
  return 3;
}

function opt_range(): i32 {
  return 4;
}

function opt_compute(): i32 {
  return 5;
}

function canceled(): i32 {
  return 125;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " CONTEXT COMMAND [args]\n";
  out = out + "  or:  " + gnu.prog() + " [ -c ] [-u USER] [-r ROLE] [-t TYPE] [-l RANGE] COMMAND [args]\n";
  out = out + "Run a program in a different SELinux security context.\n";
  out = out + "With neither CONTEXT nor COMMAND, print the current security context.\n";
  out = out + "\n";
  out = out + "Mandatory arguments to long options are mandatory for short options too.\n";
  out = out + "  CONTEXT            Complete security context\n";
  out = out + "  -c, --compute      compute process transition context before modifying\n";
  out = out + "  -t, --type=TYPE    type (for same role as parent)\n";
  out = out + "  -u, --user=USER    user identity\n";
  out = out + "  -r, --role=ROLE    role\n";
  out = out + "  -l, --range=RANGE  levelrange\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "Exit status:\n";
  out = out + "  125  if the runcon command itself fails\n";
  out = out + "  126  if COMMAND is found but cannot be invoked\n";
  out = out + "  127  if COMMAND cannot be found\n";
  out = out + "  -    the exit status of COMMAND otherwise\n";
  return out;
}

function die(msg: string): void {
  gnu.error(msg);
  exit(canceled());
}

struct Seen { role: boolean, type_: boolean, user: boolean, range: boolean }

function note(seen: Seen, id: i32): Seen {
  if (id == opt_role()) {
    if (seen.role) {
      die("multiple roles");
    }
    return Seen { ...seen, role: true };
  }
  if (id == opt_type()) {
    if (seen.type_) {
      die("multiple types");
    }
    return Seen { ...seen, type_: true };
  }
  if (id == opt_user()) {
    if (seen.user) {
      die("multiple users");
    }
    return Seen { ...seen, user: true };
  }
  if (seen.range) {
    die("multiple levelranges");
  }
  return Seen { ...seen, range: true };
}

function any(seen: Seen): boolean {
  return seen.role || seen.type_ || seen.user || seen.range;
}

function print_current_context(): i32 {
  match (selinux.context()) {
    Ok(c) => {
      gnu.write_out_with(c + "\n", canceled());
      return 0;
    },
    Err(e) => {
      die("failed to get current context: " + gnu.io_error_text(e));
    }
  }
  return canceled();
}

pub function main(): i32 {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("r", "role", opt_role()));
  opts = opts.append(gnu.valued("t", "type", opt_type()));
  opts = opts.append(gnu.valued("u", "user", opt_user()));
  opts = opts.append(gnu.valued("l", "range", opt_range()));
  opts = opts.append(gnu.flag("c", "compute", opt_compute()));

  let seen: Seen = Seen { role: false, type_: false, user: false, range: false };
  let compute: boolean = false;
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "runcon", help_text(), canceled()).in_order();
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_compute()) {
          compute = true;
        } else {
          seen = note(seen, m.id);
        }
      },
      None => {
        break;
      }
    }
  }

  let operands: string[] = g.operands();
  if (operands.len() == 0) {
    return print_current_context();
  }

  let first_command: i32 = 0;
  if (!any(seen) && !compute) {
    first_command = 1;
  }
  if (first_command >= operands.len()) {
    gnu.die_usage("no command specified", canceled());
  }

  if (!selinux.enabled()) {
    die(gnu.prog() + " may be used only on a SELinux kernel");
  }
  die("running a command in a security context is not supported on this system");
  return canceled();
}
