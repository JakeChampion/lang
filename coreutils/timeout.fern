// timeout.fern — GNU-compatible `timeout`.
//
//   timeout [OPTION] DURATION COMMAND [ARG]...   run COMMAND, kill it after DURATION
//
// -s/--signal picks what to send, -k/--kill-after adds a KILL if the first
// signal was not enough, -v/--verbose names each signal on stderr,
// --preserve-status passes the command's own status through where a timeout
// would otherwise be 124, and --foreground narrows the blast radius to the
// command alone. Usage errors exit 125, a command that cannot be invoked
// 126, one that cannot be found 127; otherwise the command's own status.
//
// THE PROCESS GROUP is the difference between the two modes, and it is why
// this utility waited on a primitive. Without --foreground, timeout puts
// ITSELF in a fresh group before forking — measured: `timeout 5 ps` shows
// the child's pgid equal to timeout's pid, and `--foreground` shows both in
// the invoking shell's group — so the command and everything it starts share
// one group and the timeout signal reaches the whole tree. That also means
// the signal comes back to timeout, which is why it sets its OWN disposition
// to ignore first, and why two signals behave as GNU's do rather than as the
// documentation suggests: `-s KILL` kills timeout too (exit 137, and the
// help text says so), and `-s STOP` stops it, so nothing is left running to
// send the SIGCONT that would resume the command. `--foreground` sends only
// to the command's pid and sends no SIGCONT, so `--foreground -s STOP` hangs
// where the default mode recovers.
//
// THE DEADLINE is a forked child that sleeps and exits. GNU arms a timer
// whose SIGALRM ends its wait; nothing here arms one, so the clock is a
// process instead and ONE blocking `proc_waitpid(-1)` wakes on whichever
// finishes first — the command or the timer. `proc_waitpid_nohang` then says
// which, since a child already reaped answers ECHILD where a live one answers
// -1. The timer ignores the signals timeout forwards, is reaped before
// timeout exits and holds nothing the command can see; the only trace is one
// extra process in the group while the command runs.
//
// FORWARDING is GNU's too: SIGINT, SIGTERM and the rest of term-sig.h's list
// reaching timeout are passed on to the command, and timeout then dies of
// the signal if the command did. Each is caught with
// `signal_catch_interrupting`, so its arrival ends the blocking wait with
// EINTR and is passed on at once (#11698). SIGALRM from outside is the
// deadline passing, as it is for GNU's own timer.
//
// Four measured behaviours worth knowing before reading the code.
//
//   - **A DURATION of 0 disables its timeout**, and `-k 0` disables the
//     kill-after — `timeout 0 sleep 2` waits the two seconds and exits 0.
//   - **Option parsing stops at the first operand.** `timeout 1 -v sleep`
//     tries to exec `-v`; the `+` optstring prefix is what env and nice use
//     too.
//   - **`-s 0` is accepted** and names kill's deliver-nothing check, which
//     `-v` spells `EXIT`. Measured, that is timeout's own rule rather than
//     the family's: `env --block-signal=0` refuses the same spelling,
//     because a signal that is never delivered cannot be blocked.
//   - **The last `-s` and the last `-k` win**, and a bad `-k` is reported
//     where it is parsed rather than after the DURATION operand:
//     `timeout -k x y true` reports `x`.
import "std/string";
import "std/array";
import "std/signal";
import "./lib/gnu";
import "./lib/duration";
import "./lib/ld";
import "./lib/signals";

function opt_preserve(): i32 {
  return 1;
}

function opt_foreground(): i32 {
  return 2;
}

function opt_kill_after(): i32 {
  return 3;
}

function opt_signal(): i32 {
  return 4;
}

function opt_verbose(): i32 {
  return 5;
}

// A usage error, and the status a failed write takes with it.
function status_canceled(): i32 {
  return 125;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION] DURATION COMMAND [ARG]...\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]\n";
  out = out + "Start COMMAND, and kill it if still running after DURATION.\n";
  out = out + "\n";
  out = out + "Mandatory arguments to long options are mandatory for short options too.\n";
  out = out + "      --preserve-status\n";
  out = out + "                 exit with the same status as COMMAND, even when the\n";
  out = out + "                   command times out\n";
  out = out + "      --foreground\n";
  out = out + "                 when not running timeout directly from a shell prompt,\n";
  out = out + "                   allow COMMAND to read from the TTY and get TTY signals;\n";
  out = out + "                   in this mode, children of COMMAND will not be timed out\n";
  out = out + "  -k, --kill-after=DURATION\n";
  out = out + "                 also send a KILL signal if COMMAND is still running\n";
  out = out + "                   this long after the initial signal was sent\n";
  out = out + "  -s, --signal=SIGNAL\n";
  out = out + "                 specify the signal to be sent on timeout;\n";
  out = out + "                   SIGNAL may be a name like 'HUP' or a number;\n";
  out = out + "                   see 'kill -l' for a list of signals\n";
  out = out + "  -v, --verbose  diagnose to stderr any signal sent upon timeout\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "DURATION is a floating point number with an optional suffix:\n";
  out = out + "'s' for seconds (the default), 'm' for minutes, 'h' for hours or 'd' for days.\n";
  out = out + "A duration of 0 disables the associated timeout.\n";
  out = out + "\n";
  out = out + "Upon timeout, send the TERM signal to COMMAND, if no other SIGNAL specified.\n";
  out = out + "The TERM signal kills any process that does not block or catch that signal.\n";
  out = out + "It may be necessary to use the KILL signal, since this signal can't be caught.\n";
  out = out + "\n";
  out = out + "Exit status:\n";
  out = out + "  124  if COMMAND times out, and --preserve-status is not specified\n";
  out = out + "  125  if the timeout command itself fails\n";
  out = out + "  126  if COMMAND is found but cannot be invoked\n";
  out = out + "  127  if COMMAND cannot be found\n";
  out = out + "  137  if COMMAND (or timeout itself) is sent the KILL (9) signal (128+9)\n";
  out = out + "  -    the exit status of COMMAND otherwise\n";
  return out;
}

// SIGKILL, which three rules read: it cannot be ignored, it needs no
// SIGCONT after it, and a command it killed reports 137 rather than 124.
function sig_kill(): i32 {
  return signals.number("KILL");
}

// `interval(s)` — one DURATION operand or option value, or the diagnostic
// and 125 that a bad one takes. The wording is gnulib's and the `Try …` line
// comes with it.
function interval(f: ld.Format, s: string): ld.LD {
  match (duration.parse(f, s)) {
    Some(v) => {
      return v;
    },
    None => {
      gnu.error("invalid time interval " + gnu.quote(s));
      gnu.try_help(status_canceled());
      return f.from_i64(0 as i64);
    }
  }
}

// `fork_timer(f, seconds, fwd)` — a child that sleeps `seconds` and exits 0,
// or a negative errno when the fork failed. GNU's timer with a process
// standing in for the signal; see the header. It ignores the signals timeout
// forwards, so passing one to the group does not end the deadline with it.
function fork_timer(f: ld.Format, seconds: ld.LD, fwd: i32[]): i32 {
  let pid: i32 = proc_fork();
  if (pid != 0) {
    return pid;
  }
  let i: i32 = 0;
  while (i < fwd.len()) {
    signal.ignore(fwd[i]);
    i = i + 1;
  }
  duration.sleep_seconds(f, seconds);
  exit(0);
  return 0;
}

// `cancel_timer(pid)` — stop a timer that is no longer needed and reap it.
// The KILL is unconditional: a timer that has already fired is gone and the
// ESRCH is the answer, not a failure. A forwarded signal can interrupt the
// reap, and is acted on at the supervisor's next look.
function cancel_timer(pid: i32): void {
  match (signal_send(pid, 9)) {
    Ok(_) => {},
    Err(_) => {}
  }
  let reaped: i32 = proc_waitpid(pid);
  while (reaped == eintr()) {
    reaped = proc_waitpid(pid);
  }
}

// What a wait the signal interrupted answers: -EINTR, 4 on both kernels.
function eintr(): i32 {
  return 0 - 4;
}

// `forwarded(term)` — the signals timeout passes on to the command, as GNU's
// install_cleanup catches them: the list in its term-sig.h, the realtime
// range, and `term`, the `-s` signal. One ignored when timeout started stays
// ignored, so a background job that a shell started deaf to SIGINT passes on
// none — except SIGALRM, the deadline's own, and `term`. A name this kernel
// does not have is left out.
function forwarded(term: i32): i32[] {
  let names: string[] = ["ALRM", "INT", "QUIT", "HUP", "TERM", "PIPE", "USR1", "USR2", "ILL", "TRAP", "ABRT", "BUS", "FPE", "SEGV", "XCPU", "XFSZ", "SYS", "VTALRM", "PROF", "POLL", "PWR", "STKFLT", "EMT"];
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < names.len()) {
    out = with_handled(out, signals.number(names[i]), term);
    i = i + 1;
  }
  let rt: i32 = signals.rt_min();
  while (rt > 0 && rt <= signals.rt_max()) {
    out = with_handled(out, rt, term);
    rt = rt + 1;
  }
  return with_handled(out, term, term);
}

function with_handled(sigs: i32[], n: i32, term: i32): i32[] {
  if (n <= 0 || has(sigs, n)) {
    return sigs;
  }
  if (n != sig_alrm() && n != term && signal.disposition(n) == signal.IGN) {
    return sigs;
  }
  return sigs.append(n);
}

function has(sigs: i32[], n: i32): boolean {
  let i: i32 = 0;
  while (i < sigs.len()) {
    if (sigs[i] == n) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// SIGALRM, which reaching timeout from outside is the deadline passing, as
// it is for GNU's own timer.
function sig_alrm(): i32 {
  return signals.number("ALRM");
}

// `fired(pid)` — whether `pid` is the child a blocking `proc_waitpid(-1)`
// just reaped. A reaped child answers ECHILD where a live one answers -1, so
// this is exact rather than a guess: a recycled pid is not this process's
// child, and nothing was forked between the wait and the probe.
function fired(pid: i32): boolean {
  return proc_waitpid_nohang(pid) == 0 - 10;
}

// `deliver(sig, cmd, cpid, foreground, verbose)` — the timeout signal, sent
// the way GNU sends it.
//
// The command's pid first, then the whole group — the group send is what
// reaches a command that spawned children of its own, and the pid send is
// what still reaches the command if it moved itself out of the group. Before
// either, this process sets its own disposition to ignore, because it is in
// that group as well; SIGKILL and SIGSTOP cannot be ignored, which is how
// `-s KILL` takes timeout down with the command and `-s STOP` stops it.
//
// A SIGCONT follows anything but KILL and CONT, so a stop signal does not
// leave the command suspended for ever. Both are group-mode only: measured,
// `--foreground -s TSTP` hangs where the default mode reports 124.
function deliver(sig: i32, cmd: string, cpid: i32, foreground: boolean, verbose: boolean): void {
  if (verbose) {
    // Signal 0 has no name to print — `-v -s 0` and `-v -s EXIT` both
    // say `signal 0`, where GNU <= 9.9 wrote `EXIT`.
    let shown: string = signals.name(sig);
    if (sig == 0) {
      shown = "0";
    }
    gnu.error("sending signal " + shown + " to command " + gnu.quote(cmd));
  }
  if (!foreground && sig != 0) {
    signal_ignore(sig);
  }
  send(cpid, sig);
  if (foreground) {
    return;
  }
  send(0, sig);
  let cont: i32 = signals.number("CONT");
  if (sig != sig_kill() && sig != cont) {
    send(cpid, cont);
    send(0, cont);
  }
}

// One signal, with the failure dropped: every errno kill(2) can answer here
// says the target is already gone, which is the outcome asked for.
function send(pid: i32, sig: i32): void {
  match (signal_send(pid, sig)) {
    Ok(_) => {},
    Err(_) => {}
  }
}

// `run_child(cmd, argv)` — the forked child's whole job: exec, and report the
// failure GNU reports if it could not. ENOENT is 127 and anything else 126,
// the same split env, nice and nohup use.
function run_child(cmd: string, argv: string[]): void {
  let errno: i32 = gnu.exec_command(cmd, argv, environ());
  gnu.error("failed to run command " + gnu.quote(cmd) + ": " + gnu.exec_errno_text(errno));
  if (errno == 2) {
    exit(127);
  }
  exit(126);
}

// `Cfg` — what the options asked for, once they are all read.
struct Cfg { sig: i32, kill_after: ld.LD, preserve: boolean, foreground: boolean, verbose: boolean }

// `parse_options(f)` — the option scan, and the operands it left.
//
// Declared in GNU's own order, because that is the order the ambiguity list
// is printed in: `--v` answers `possibilities: '--verbose' '--version'`, and
// getopt appends the two standard options after these. `.in_order()` is the
// `+` optstring prefix env and nice use — the scan stops at the first
// operand, so `timeout 1 -v CMD` tries to exec `-v`.
function parse_options(f: ld.Format): (Cfg, string[]) {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("", "preserve-status", opt_preserve()));
  opts = opts.append(gnu.flag("", "foreground", opt_foreground()));
  opts = opts.append(gnu.valued("k", "kill-after", opt_kill_after()));
  opts = opts.append(gnu.valued("s", "signal", opt_signal()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));

  let cfg: Cfg = Cfg { sig: signals.number("TERM"), kill_after: f.from_i64(0 as i64), preserve: false, foreground: false, verbose: false };
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "timeout", help_text(), status_canceled()).in_order();
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        cfg = apply_option(f, cfg, m);
      },
      None => {
        return (cfg, g.operands());
      }
    }
  }
  return (cfg, g.operands());
}

// One option occurrence folded into the config. The last `-s` and the last
// `-k` win, and a bad value for either is reported HERE rather than after
// the DURATION operand: `timeout -k x y CMD` reports `x`.
function apply_option(f: ld.Format, cfg: Cfg, m: gnu.OptMatch): Cfg {
  if (m.id == opt_preserve()) {
    return Cfg { ...cfg, preserve: true };
  }
  if (m.id == opt_foreground()) {
    return Cfg { ...cfg, foreground: true };
  }
  if (m.id == opt_verbose()) {
    return Cfg { ...cfg, verbose: true };
  }
  if (m.id == opt_kill_after()) {
    return Cfg { ...cfg, kill_after: interval(f, m.value) };
  }
  let sig: i32 = signals.operand2sig(m.value);
  if (sig < 0) {
    gnu.error(gnu.quote(m.value) + ": invalid signal");
    gnu.try_help(status_canceled());
  }
  return Cfg { ...cfg, sig: sig };
}

pub function main(): i32 {
  let f: ld.Format = ld.format();
  let parsed: (Cfg, string[]) = parse_options(f);
  let cfg: Cfg = parsed.0;
  let rest: string[] = parsed.1;
  // A DURATION with no COMMAND is a usage error, and gnulib's usage() prints
  // only the `Try …` line for a nonzero status — no `missing operand` above
  // it.
  if (rest.len() < 2) {
    gnu.try_help(status_canceled());
  }
  let wait_for: ld.LD = interval(f, rest[0]);
  let cmd: string = rest[1];
  let argv: string[] = [];
  let a: i32 = 1;
  while (a < rest.len()) {
    argv = argv.append(rest[a]);
    a = a + 1;
  }

  // The group comes before the fork so the command inherits it, and it is
  // this process that moves: the group's leader is timeout itself.
  if (!cfg.foreground) {
    match (set_process_group(0, 0)) {
      Ok(_) => {},
      Err(_) => {}
    }
  }

  // The catches come before the fork, as GNU's do, so a signal the command
  // provokes at once is not missed; exec puts them back to the default in
  // the command. Each interrupts the one blocking wait, so it is passed on
  // the moment it arrives.
  let fwd: i32[] = forwarded(cfg.sig);
  let i: i32 = 0;
  while (i < fwd.len()) {
    signal.catch_interrupting(fwd[i]);
    i = i + 1;
  }

  let cpid: i32 = proc_fork();
  if (cpid < 0) {
    gnu.error("fork system call failed: " + gnu.exec_errno_text(0 - cpid));
    return status_canceled();
  }
  if (cpid == 0) {
    run_child(cmd, argv);
    return 126;
  }
  return supervise(f, cfg, wait_for, cmd, cpid, fwd);
}

// `over_setitimer_bound(f, seconds)` — whether Darwin's setitimer would refuse
// this deadline. xnu's `itimerfix` is the bound, and it is not about the width
// of the field:
//
//     if (tv->tv_sec < 0 || tv->tv_sec > 100000000 ||
//         tv->tv_usec < 0 || tv->tv_usec >= 1000000) {
//             return EINVAL;
//     }
//
// so anything past 100000000 seconds — about 3.17 years — is EINVAL there.
function over_setitimer_bound(f: ld.Format, seconds: ld.LD): boolean {
  if (seconds.is_inf()) {
    return true;
  }
  return seconds.cmp(f.from_i64(100000000 as i64)) > 0;
}

// `Watch` — what supervising has done so far: the timer running (0 for none)
// and the signal it sends when it fires, the `-k` grace period not yet
// started, whether a deadline passed, and the signals sent to the command, a
// bit each.
struct Watch { tpid: i32, timer_sig: i32, kill_after: ld.LD, timed_out: boolean, sent: i64 }

// `supervise(...)` — wait for the command, sending the timeout signal if the
// deadline arrives first and passing on each forwarded signal that arrives.
//
// ONE blocking `proc_waitpid(-1)` waits on everything: it returns when the
// command or the timer ends, and fails with EINTR when a forwarded signal
// arrives. The flags are also read before each wait, for a signal that ended
// some other wait (cancel_timer's) instead.
//
// A zero DURATION arms no timer, but a forwarded signal still starts `-k`'s
// grace period, as GNU's does.
function supervise(f: ld.Format, cfg: Cfg, wait_for: ld.LD, cmd: string, cpid: i32, fwd: i32[]): i32 {
  let w: Watch = Watch { tpid: 0, timer_sig: cfg.sig, kill_after: cfg.kill_after, timed_out: false, sent: 0 as i64 };
  // A DEADLINE DARWIN WILL NOT TAKE IS REPORTED, not silently run unbounded.
  // GNU's settimeout prefers timer_create, which glibc has and Darwin has
  // not, so there it falls back to setitimer — "more portable (to Darwin for
  // example)", says the comment beside it — and the bound above makes `inf`
  // or a saturated duration EINVAL. GNU warns and is left with alarm(2)'s
  // whole-second deadline, which for anything past the bound is decades off,
  // so the command runs to completion as under a zero DURATION.
  //
  // We fork a sleeper rather than call setitimer, so there is no call of ours
  // to fail and the bound is modelled instead. Measured on the macos-15
  // runner: `timeout inf true` and `timeout 99999999999999999999 true` both
  // warn there and neither does on Linux, where timer_create takes them.
  if (!wait_for.is_zero()) {
    if (target_os() == "darwin" && over_setitimer_bound(f, wait_for)) {
      gnu.error("warning: setitimer: " + gnu.exec_errno_text(22));
    } else {
      let tpid: i32 = fork_timer(f, wait_for, fwd);
      if (tpid < 0) {
        gnu.error("fork system call failed: " + gnu.exec_errno_text(0 - tpid));
        return status_canceled();
      }
      w = Watch { ...w, tpid: tpid };
    }
  }
  while (true) {
    w = take_signals(f, cfg, cmd, cpid, fwd, w);
    let status: i32 = proc_waitpid(0 - 1);
    if (status == eintr()) {
      continue;
    }
    if (w.tpid > 0 && fired(w.tpid)) {
      w = act(f, cfg, cmd, cpid, fwd, Watch { ...w, tpid: 0, timed_out: true }, w.timer_sig);
      continue;
    }
    if (w.tpid > 0) {
      cancel_timer(w.tpid);
    }
    return finish(cfg, w, status);
  }
  return status_canceled();
}

// `take_signals(...)` — act on each forwarded signal that has arrived.
// SIGALRM is the deadline passing; any other is passed on to the command.
function take_signals(f: ld.Format, cfg: Cfg, cmd: string, cpid: i32, fwd: i32[], w0: Watch): Watch {
  let w: Watch = w0;
  let i: i32 = 0;
  while (i < fwd.len()) {
    let n: i32 = fwd[i];
    if (signal.taken(n)) {
      if (n == sig_alrm()) {
        w = act(f, cfg, cmd, cpid, fwd, Watch { ...w, timed_out: true }, w.timer_sig);
      } else {
        w = act(f, cfg, cmd, cpid, fwd, w, n);
      }
    }
    i = i + 1;
  }
  return w;
}

// `act(...)` — GNU's cleanup handler: send `sig` the way `deliver` does, and
// on the first signal sent, start `-k`'s grace period, whose end sends KILL.
// The grace period replaces the timer rather than running beside it, and
// later signals do not restart it: measured, `timeout -v -k 0.2 0.1 sleep 5`
// prints one line and not two, because the TERM was enough.
function act(f: ld.Format, cfg: Cfg, cmd: string, cpid: i32, fwd: i32[], w0: Watch, sig: i32): Watch {
  deliver(sig, cmd, cpid, cfg.foreground, cfg.verbose);
  let w: Watch = w0;
  if (sig > 0) {
    w = Watch { ...w, sent: w.sent | signal.bit(sig) };
  }
  if (w.kill_after.is_zero()) {
    return w;
  }
  if (w.tpid > 0) {
    cancel_timer(w.tpid);
  }
  let kpid: i32 = fork_timer(f, w.kill_after, fwd);
  if (kpid < 0) {
    // Nothing left to escalate with, so the command is waited out as an
    // unadorned timeout would be.
    kpid = 0;
  }
  return Watch { ...w, tpid: kpid, timer_sig: sig_kill(), kill_after: f.from_i64(0 as i64) };
}

// `finish(cfg, w, status)` — timeout's exit, from the command's.
//
// A command that was not timed out passes its status through — and when it
// died of a signal this process passed on to it, timeout dies of that signal
// too, as GNU's does, so whoever started timeout sees the death rather than
// an exit status. GNU asks WTERMSIG, and dies of whatever signal killed the
// command; `proc_waitpid` collapses a death by a signal into the shell's one
// number, so the SIGNAL THIS PROCESS SENT stands in for the half the status
// cannot carry: a command that exits 143 of its own accord is not mistaken
// for one SIGTERM killed. The residue is a command killed by a signal from
// elsewhere, which exits timeout with 128 + the signal where GNU's dies of it.
//
// A timeout is 124, except where the command was KILLED: `-s KILL`, and a
// `-k` grace period that expired, both report 128+9 instead — the 137 the
// help text names. Measured: `--foreground -s HUP` is 124 where
// `--foreground -s KILL` is 137, and `-s 0 -k G` is 137 because the grace
// period expired even though the first signal delivered nothing. The same
// stand-in applies: a SIGKILL arriving from somewhere else during the
// timeout reads as 124 here and 137 there.
function finish(cfg: Cfg, w: Watch, status: i32): i32 {
  if (!w.timed_out) {
    let sig: i32 = status - 128;
    if (sig > 0 && sig <= 64 && (w.sent & signal.bit(sig)) != 0) {
      signals.die_of(sig);
    }
    return status;
  }
  if (cfg.preserve) {
    return status;
  }
  if ((w.sent & signal.bit(sig_kill())) != 0 && status == 128 + sig_kill()) {
    return status;
  }
  return 124;
}
