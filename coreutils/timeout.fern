import "std/string";
import "std/array";
import "std/signal";
import "./lib/gnu";
import "./lib/duration";
import "./lib/ld";
import "./lib/signals";

function opt_preserve(): i32 {
  return 1;
}

function opt_foreground(): i32 {
  return 2;
}

function opt_kill_after(): i32 {
  return 3;
}

function opt_signal(): i32 {
  return 4;
}

function opt_verbose(): i32 {
  return 5;
}

function status_canceled(): i32 {
  return 125;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION] DURATION COMMAND [ARG]...\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]\n";
  out = out + "Start COMMAND, and kill it if still running after DURATION.\n";
  out = out + "\n";
  out = out + "Mandatory arguments to long options are mandatory for short options too.\n";
  out = out + "      --preserve-status\n";
  out = out + "                 exit with the same status as COMMAND, even when the\n";
  out = out + "                   command times out\n";
  out = out + "      --foreground\n";
  out = out + "                 when not running timeout directly from a shell prompt,\n";
  out = out + "                   allow COMMAND to read from the TTY and get TTY signals;\n";
  out = out + "                   in this mode, children of COMMAND will not be timed out\n";
  out = out + "  -k, --kill-after=DURATION\n";
  out = out + "                 also send a KILL signal if COMMAND is still running\n";
  out = out + "                   this long after the initial signal was sent\n";
  out = out + "  -s, --signal=SIGNAL\n";
  out = out + "                 specify the signal to be sent on timeout;\n";
  out = out + "                   SIGNAL may be a name like 'HUP' or a number;\n";
  out = out + "                   see 'kill -l' for a list of signals\n";
  out = out + "  -v, --verbose  diagnose to stderr any signal sent upon timeout\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "DURATION is a floating point number with an optional suffix:\n";
  out = out + "'s' for seconds (the default), 'm' for minutes, 'h' for hours or 'd' for days.\n";
  out = out + "A duration of 0 disables the associated timeout.\n";
  out = out + "\n";
  out = out + "Upon timeout, send the TERM signal to COMMAND, if no other SIGNAL specified.\n";
  out = out + "The TERM signal kills any process that does not block or catch that signal.\n";
  out = out + "It may be necessary to use the KILL signal, since this signal can't be caught.\n";
  out = out + "\n";
  out = out + "Exit status:\n";
  out = out + "  124  if COMMAND times out, and --preserve-status is not specified\n";
  out = out + "  125  if the timeout command itself fails\n";
  out = out + "  126  if COMMAND is found but cannot be invoked\n";
  out = out + "  127  if COMMAND cannot be found\n";
  out = out + "  137  if COMMAND (or timeout itself) is sent the KILL (9) signal (128+9)\n";
  out = out + "  -    the exit status of COMMAND otherwise\n";
  return out;
}

function sig_kill(): i32 {
  return signals.number("KILL");
}

function interval(f: ld.Format, s: string): ld.LD {
  match (duration.parse(f, s)) {
    Some(v) => {
      return v;
    },
    None => {
      gnu.error("invalid time interval " + gnu.quote(s));
      gnu.try_help(status_canceled());
      return f.from_i64(0 as i64);
    }
  }
}

function fork_timer(f: ld.Format, seconds: ld.LD, fwd: i32[]): i32 {
  let pid: i32 = proc_fork();
  if (pid != 0) {
    return pid;
  }
  let i: i32 = 0;
  while (i < fwd.len()) {
    signal.ignore(fwd[i]);
    i = i + 1;
  }
  duration.sleep_seconds(f, seconds);
  exit(0);
  return 0;
}

function cancel_timer(pid: i32): void {
  match (signal_send(pid, 9)) {
    Ok(_) => {},
    Err(_) => {}
  }
  let reaped: i32 = proc_waitpid(pid);
  while (reaped == eintr()) {
    reaped = proc_waitpid(pid);
  }
}

function eintr(): i32 {
  return 0 - 4;
}

function forwarded(term: i32): i32[] {
  let names: string[] = ["ALRM", "INT", "QUIT", "HUP", "TERM", "PIPE", "USR1", "USR2", "ILL", "TRAP", "ABRT", "BUS", "FPE", "SEGV", "XCPU", "XFSZ", "SYS", "VTALRM", "PROF", "POLL", "PWR", "STKFLT", "EMT"];
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < names.len()) {
    out = with_handled(out, signals.number(names[i]), term);
    i = i + 1;
  }
  let rt: i32 = signals.rt_min();
  while (rt > 0 && rt <= signals.rt_max()) {
    out = with_handled(out, rt, term);
    rt = rt + 1;
  }
  return with_handled(out, term, term);
}

function with_handled(sigs: i32[], n: i32, term: i32): i32[] {
  if (n <= 0 || has(sigs, n)) {
    return sigs;
  }
  if (n != sig_alrm() && n != term && signal.disposition(n) == signal.IGN) {
    return sigs;
  }
  return sigs.append(n);
}

function has(sigs: i32[], n: i32): boolean {
  let i: i32 = 0;
  while (i < sigs.len()) {
    if (sigs[i] == n) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function sig_alrm(): i32 {
  return signals.number("ALRM");
}

function fired(pid: i32): boolean {
  return proc_waitpid_nohang(pid) == 0 - 10;
}

function deliver(sig: i32, cmd: string, cpid: i32, foreground: boolean, verbose: boolean): void {
  if (verbose) {
    let shown: string = signals.name(sig);
    if (sig == 0) {
      shown = "0";
    }
    gnu.error("sending signal " + shown + " to command " + gnu.quote(cmd));
  }
  if (!foreground && sig != 0) {
    signal_ignore(sig);
  }
  send(cpid, sig);
  if (foreground) {
    return;
  }
  send(0, sig);
  let cont: i32 = signals.number("CONT");
  if (sig != sig_kill() && sig != cont) {
    send(cpid, cont);
    send(0, cont);
  }
}

function send(pid: i32, sig: i32): void {
  match (signal_send(pid, sig)) {
    Ok(_) => {},
    Err(_) => {}
  }
}

function run_child(cmd: string, argv: string[]): void {
  let errno: i32 = gnu.exec_command(cmd, argv, environ());
  gnu.error("failed to run command " + gnu.quote(cmd) + ": " + gnu.exec_errno_text(errno));
  if (errno == 2) {
    exit(127);
  }
  exit(126);
}

struct Cfg { sig: i32, kill_after: ld.LD, preserve: boolean, foreground: boolean, verbose: boolean }

function parse_options(f: ld.Format): (Cfg, string[]) {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("", "preserve-status", opt_preserve()));
  opts = opts.append(gnu.flag("", "foreground", opt_foreground()));
  opts = opts.append(gnu.valued("k", "kill-after", opt_kill_after()));
  opts = opts.append(gnu.valued("s", "signal", opt_signal()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));

  let cfg: Cfg = Cfg { sig: signals.number("TERM"), kill_after: f.from_i64(0 as i64), preserve: false, foreground: false, verbose: false };
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "timeout", help_text(), status_canceled()).in_order();
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        cfg = apply_option(f, cfg, m);
      },
      None => {
        return (cfg, g.operands());
      }
    }
  }
  return (cfg, g.operands());
}

function apply_option(f: ld.Format, cfg: Cfg, m: gnu.OptMatch): Cfg {
  if (m.id == opt_preserve()) {
    return Cfg { ...cfg, preserve: true };
  }
  if (m.id == opt_foreground()) {
    return Cfg { ...cfg, foreground: true };
  }
  if (m.id == opt_verbose()) {
    return Cfg { ...cfg, verbose: true };
  }
  if (m.id == opt_kill_after()) {
    return Cfg { ...cfg, kill_after: interval(f, m.value) };
  }
  let sig: i32 = signals.operand2sig(m.value);
  if (sig < 0) {
    gnu.error(gnu.quote(m.value) + ": invalid signal");
    gnu.try_help(status_canceled());
  }
  return Cfg { ...cfg, sig: sig };
}

pub function main(): i32 {
  let f: ld.Format = ld.format();
  let parsed: (Cfg, string[]) = parse_options(f);
  let cfg: Cfg = parsed.0;
  let rest: string[] = parsed.1;
  if (rest.len() < 2) {
    gnu.try_help(status_canceled());
  }
  let wait_for: ld.LD = interval(f, rest[0]);
  let cmd: string = rest[1];
  let argv: string[] = [];
  let a: i32 = 1;
  while (a < rest.len()) {
    argv = argv.append(rest[a]);
    a = a + 1;
  }

  if (!cfg.foreground) {
    match (set_process_group(0, 0)) {
      Ok(_) => {},
      Err(_) => {}
    }
  }

  let fwd: i32[] = forwarded(cfg.sig);
  let i: i32 = 0;
  while (i < fwd.len()) {
    signal.catch_interrupting(fwd[i]);
    i = i + 1;
  }

  let cpid: i32 = proc_fork();
  if (cpid < 0) {
    gnu.error("fork system call failed: " + gnu.exec_errno_text(0 - cpid));
    return status_canceled();
  }
  if (cpid == 0) {
    run_child(cmd, argv);
    return 126;
  }
  return supervise(f, cfg, wait_for, cmd, cpid, fwd);
}

function over_setitimer_bound(f: ld.Format, seconds: ld.LD): boolean {
  if (seconds.is_inf()) {
    return true;
  }
  return seconds.cmp(f.from_i64(100000000 as i64)) > 0;
}

struct Watch { tpid: i32, timer_sig: i32, kill_after: ld.LD, timed_out: boolean }

function supervise(f: ld.Format, cfg: Cfg, wait_for: ld.LD, cmd: string, cpid: i32, fwd: i32[]): i32 {
  let w: Watch = Watch { tpid: 0, timer_sig: cfg.sig, kill_after: cfg.kill_after, timed_out: false };
  if (!wait_for.is_zero()) {
    if (target_os() == "darwin" && over_setitimer_bound(f, wait_for)) {
      gnu.error("warning: setitimer: " + gnu.exec_errno_text(22));
    } else {
      let tpid: i32 = fork_timer(f, wait_for, fwd);
      if (tpid < 0) {
        gnu.error("fork system call failed: " + gnu.exec_errno_text(0 - tpid));
        return status_canceled();
      }
      w = Watch { ...w, tpid: tpid };
    }
  }
  while (true) {
    w = take_signals(f, cfg, cmd, cpid, fwd, w);
    let status: i32 = proc_waitpid_status(0 - 1);
    if (status == eintr()) {
      continue;
    }
    if (w.tpid > 0 && fired(w.tpid)) {
      w = act(f, cfg, cmd, cpid, fwd, Watch { ...w, tpid: 0, timed_out: true }, w.timer_sig);
      continue;
    }
    if (w.tpid > 0) {
      cancel_timer(w.tpid);
    }
    return finish(cfg, w, status);
  }
  return status_canceled();
}

function take_signals(f: ld.Format, cfg: Cfg, cmd: string, cpid: i32, fwd: i32[], w0: Watch): Watch {
  let w: Watch = w0;
  let i: i32 = 0;
  while (i < fwd.len()) {
    let n: i32 = fwd[i];
    if (signal.taken(n)) {
      if (n == sig_alrm()) {
        w = act(f, cfg, cmd, cpid, fwd, Watch { ...w, timed_out: true }, w.timer_sig);
      } else {
        w = act(f, cfg, cmd, cpid, fwd, w, n);
      }
    }
    i = i + 1;
  }
  return w;
}

function act(f: ld.Format, cfg: Cfg, cmd: string, cpid: i32, fwd: i32[], w0: Watch, sig: i32): Watch {
  deliver(sig, cmd, cpid, cfg.foreground, cfg.verbose);
  let w: Watch = w0;
  if (w.kill_after.is_zero()) {
    return w;
  }
  if (w.tpid > 0) {
    cancel_timer(w.tpid);
  }
  let kpid: i32 = fork_timer(f, w.kill_after, fwd);
  if (kpid < 0) {
    kpid = 0;
  }
  return Watch { ...w, tpid: kpid, timer_sig: sig_kill(), kill_after: f.from_i64(0 as i64) };
}

function finish(cfg: Cfg, w: Watch, status: i32): i32 {
  let sig: i32 = status & 127;
  if (status < 0 || sig == 0) {
    let code: i32 = status;
    if (status >= 0) {
      code = status >> 8 & 255;
    }
    if (w.timed_out && !cfg.preserve) {
      return 124;
    }
    return code;
  }
  if ((status & 128) != 0) {
    gnu.error("the monitored command dumped core");
  }
  if (!w.timed_out && disable_core_dumps()) {
    signals.die_of(sig);
  }
  if (w.timed_out && !cfg.preserve && sig != sig_kill()) {
    return 124;
  }
  return 128 + sig;
}
