// tac.fern — GNU-compatible `tac`.
//
//   tac [-br] [-s SEP] [FILE]...
//
// Each FILE written to stdout with its records in reverse order. A
// record ends at the separator — a newline unless `-s` names another
// string — and the separator is ATTACHED to the record it ends, so a
// file whose last record has none is printed with none: `a\nb\nc`
// comes back as `cb\na\n`. `-b` attaches the separator to the record
// that FOLLOWS it instead, and `-r` reads SEP as a regular expression in
// the dialect glibc gives a program that never calls `re_set_syntax`:
// syntax 0, which is Emacs, not POSIX basic (lib/bre.fern).
//
// The input is read from its END in 8 KiB blocks, doubling whenever one
// record outgrows a block. The window is the block just read followed by
// the record still pending in front of it; it is searched backwards and
// each separator found ends a record that is written at once, so only
// that window is ever resident. The window is also all a regular
// expression sees, which is what makes `^x` match an `x` at the start of
// a block whatever precedes it in the file — GNU's behaviour, and the
// reason the block size is reproduced rather than chosen. It is not free
// in the other direction either: a directory answers lseek(SEEK_END)
// with LLONG_MAX, and the read that follows fails EINVAL for the
// offset-plus-count overflow at 8 KiB where a larger block would reach
// the descriptor and say EISDIR.
//
// Output goes through GNU's own 8 KiB buffer and then straight to fd 1:
// since 9.5 tac writes with full_write rather than fwrite, so a failed
// write is reported where it happens, with its errno, instead of being
// left for the close to word out of whatever stdio still had pending.
import "./lib/gnu";
import "./lib/bre";

function opt_before(): i32 {
  return 1;
}

function opt_regex(): i32 {
  return 2;
}

function opt_separator(): i32 {
  return 3;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Write each FILE to standard output, last line first.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -b, --before             attach the separator before instead of after\n";
  out = out + "  -r, --regex              interpret the separator as a regular expression\n";
  out = out + "  -s, --separator=STRING   use STRING as the separator instead of newline\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

// `Settings` — the separator, whether it precedes its record, and its
// compiled form when it is a regular expression.
struct Settings { sep: u8[], before: boolean, regex: boolean, re: bre.Bre }

// ---- output ----------------------------------------------------------------
// `Out` — fd 1, GNU's own 8 KiB buffer in front of it (a builder
// handle), and whether any operand failed. The buffer reaches the
// descriptor as one write per full block.
struct Out { w: Writer, buf: usize, ok: boolean }

// GNU's WRITESIZE: the bytes it accumulates before each write.
function write_size(): i32 {
  return 8192;
}

// GNU's full_write, with write_error() behind it: a failed write ends
// the program naming the errno, and nothing is left for the close.
function write_out(o: Out, data: u8[]): void {
  if (data.len() == 0) {
    return;
  }
  match (o.w.write_bytes(data)) {
    Some(e) => {
      gnu.error("write error: " + gnu.io_error_text(e));
      exit(1);
    },
    None => {}
  }
}

function join_prefix(front: u8[], back: u8[], end: i32): u8[] {
  let h: usize = buf_new(front.len() + end);
  buf_push_bytes_range(h, front, 0, front.len());
  buf_push_bytes_range(h, back, 0, end);
  let result: u8[] = buf_take_bytes(h);
  buf_free(h);
  return result;
}

// One diagnostic and the exit status turned to 1. Nothing is flushed
// ahead of it: gnulib's error() flushes STDIO, which tac's output no
// longer passes through, so the pending block stays pending.
function fail(o: Out, msg: string): Out {
  gnu.error(msg);
  return Out { ...o, ok: false };
}

// ---- the separator search --------------------------------------------------
// `find_plain(s, w, bound)` — the start of the plain separator's
// occurrence nearest the end of `w` that ends at or before `bound`, or
// -1. Its end is `start + s.sep.len()`; a regular expression's match
// has no fixed length, so that path answers (start, end) through
// `search_back` instead.
function find_plain(s: Settings, w: u8[], bound: i32): i32 {
  let n: i32 = s.sep.len();
  let first: i32 = s.sep[0] as i32;
  let k: i32 = bound - n;
  while (k >= 0) {
    let j: i32 = __rmemchr_bytes(w, first, k);
    if (j < 0) {
      break;
    }
    if (n == 1 || __mismatch_bytes(w, j, s.sep, 0, n) == n) {
      return j;
    }
    k = j - 1;
  }
  return 0 - 1;
}

// ---- reading backwards -----------------------------------------------------
// Bytes per read of a seekable file, doubled whenever a record outgrows
// it. The block is not free to choose: it is the length of the read(2)
// the window is filled by, and a directory answers lseek(SEEK_END) with
// LLONG_MAX, so the first read lands at `LLONG_MAX - LLONG_MAX % block`
// and fails EINVAL for the offset-plus-count overflow at 8 KiB where a
// larger block would reach the descriptor and fail EISDIR instead.
function initial_read_size(): i64 {
  return 8192 as i64;
}

// `Src` — where the bytes of one operand come from: a descriptor that
// seeks, or the whole stream held in memory because it did not.
struct Src { r: Reader, held: u8[], seekable: boolean }

// `read_block(src, name, at, n)` — up to `n` bytes at offset `at`,
// short at end of input, or the diagnostic GNU gives the failure.
function read_block(src: Src, name: string, at: i64, n: i64, o: Out): (Out, u8[], boolean) {
  let out: Out = o;
  let empty: u8[] = [];
  if (!src.seekable) {
    let lo: i32 = at as i32;
    let hi: i32 = lo + n as i32;
    if (hi > src.held.len()) {
      hi = src.held.len();
    }
    let h: usize = buf_new(hi - lo);
    buf_push_bytes_range(h, src.held, lo, hi);
    let bytes: u8[] = buf_take_bytes(h);
    buf_free(h);
    return (out, bytes, true);
  }
  match (src.r.seek(at, 0)) {
    Ok(_) => {},
    Err(e) => {
      return (fail(out, gnu.quotef(name) + ": seek failed: " + gnu.io_error_text(e)), empty, false);
    }
  }
  let got: u8[] = [];
  let h: usize = 0 as usize;
  let used: i64 = 0 as i64;
  while (used < n) {
    match (src.r.read_chunk_bytes((n - used) as i32)) {
      Ok(c) => {
        if (c.len() == 0) {
          break;
        }
        if (used == 0 as i64) {
          got = c;
        } else {
          if (h == 0 as usize) {
            h = buf_new(n as i32);
            buf_push_bytes_range(h, got, 0, got.len());
          }
          buf_push_bytes_range(h, c, 0, c.len());
        }
        used = used + c.len() as i64;
      },
      Err(e) => {
        if (h != 0 as usize) {
          buf_free(h);
        }
        return (fail(out, gnu.quotef(name) + ": read error: " + gnu.io_error_text(e)), empty, false);
      }
    }
  }
  if (h != 0 as usize) {
    got = buf_take_bytes(h);
    buf_free(h);
  }
  return (out, got, true);
}

// `tac_backward(src, name, size, o, s)` — one input read from its end.
//
// `w` is the window: the block just read followed by the pending
// partial record. `past_end` is where unwritten data ends in it and
// `bound` where the next separator search may end — the start of the
// separator found last, so a match is never found twice. When the
// window is exhausted the block before it is read and `w` is rebuilt
// with the pending bytes behind it.
//
// Each record is one range push into the 8 KiB builder, which copies
// the bytes straight out of the window; a full block is taken out of
// it and handed to stdio without another copy.
function tac_backward(src: Src, name: string, size: i64, o: Out, s: Settings): Out {
  let out: Out = o;
  let h: usize = o.buf;
  if (size < 1 as i64) {
    return out;
  }
  let block: i64 = initial_read_size();
  let saved: i64 = size % block;
  if (saved == 0 as i64) {
    saved = block;
  }
  let file_pos: i64 = size - saved;
  let rb: (Out, u8[], boolean) = read_block(src, name, file_pos, block, out);
  out = rb.0;
  if (!rb.2) {
    return out;
  }
  let w: u8[] = rb.1;
  let past_end: i32 = w.len();
  let bound: i32 = past_end;
  let first_time: boolean = true;
  while (true) {
    let m0: i32 = 0;
    let m1: i32 = 0;
    if (s.regex) {
      let m: (i32, i32) = s.re.search_back_bytes(w, bound);
      m0 = m.0;
      m1 = m.1;
    } else {
      m0 = find_plain(s, w, bound);
      m1 = m0 + s.sep.len();
    }
    let lo: i32 = 0;
    let last: boolean = true;
    let emit: boolean = true;
    if (m0 >= 0) {
      last = false;
      lo = m1;
      if (s.before) {
        lo = m0;
      } else if (first_time && m1 == past_end) {
        emit = false;
      }
    } else if (file_pos > 0 as i64) {
      if (past_end as i64 > block) {
        block = block * (2 as i64);
      }
      if (file_pos >= block) {
        file_pos = file_pos - block;
      } else {
        block = file_pos;
        file_pos = 0 as i64;
      }
      let next: (Out, u8[], boolean) = read_block(src, name, file_pos, block, out);
      out = next.0;
      if (!next.2) {
        return out;
      }
      let n: i32 = next.1.len();
      w = join_prefix(next.1, w, past_end);
      // A regular expression is re-run over the pending bytes, which is
      // what lets `^` match at the old window's start; a plain
      // separator can only straddle the join.
      let straddle: i32 = n + s.sep.len() - 1;
      if (s.regex) {
        bound = n + past_end;
      } else if (n + bound < straddle) {
        bound = n + bound;
      } else {
        bound = straddle;
      }
      past_end = n + past_end;
      continue;
    }
    if (emit && lo < past_end) {
      let avail: i32 = write_size() - buf_len(h);
      if (past_end - lo < avail) {
        buf_push_bytes_range(h, w, lo, past_end);
      } else {
        buf_push_bytes_range(h, w, lo, lo + avail);
        write_out(out, buf_take_bytes(h));
        let from: i32 = lo + avail;
        while (past_end - from >= write_size()) {
          buf_push_bytes_range(h, w, from, from + write_size());
          write_out(out, buf_take_bytes(h));
          from = from + write_size();
        }
        if (from < past_end) {
          buf_push_bytes_range(h, w, from, past_end);
        }
      }
    }
    if (last) {
      return out;
    }
    past_end = lo;
    bound = m0;
    first_time = false;
  }
  return out;
}

// ---- input that cannot seek ------------------------------------------------
// A pipe or a terminal cannot be read backwards, so the whole stream is
// held before the first record is written. GNU spools it to an unlinked
// `$TMPDIR/cutmpXXXXXX` instead and keeps one block resident, which
// needs a file created EXCLUSIVELY at a chosen path — `open_writer`
// truncates whatever the name reaches, so a temporary in a shared
// directory would be a name an attacker can plant (#8776). What the
// record scan sees is the same either way: the held bytes are handed
// back in the same 8 KiB windows the temporary file would be read in,
// so a regular expression meets the same buffer boundaries.
function hold_stream(r: Reader, name: string, o: Out): (Out, u8[], boolean) {
  let h: usize = buf_new(8192);
  while (true) {
    match (r.read_chunk_bytes(8192)) {
      Ok(c) => {
        if (c.len() == 0) {
          break;
        }
        buf_push_bytes_range(h, c, 0, c.len());
      },
      Err(e) => {
        buf_free(h);
        let empty: u8[] = [];
        return (fail(o, gnu.quotef(name) + ": read error: " + gnu.io_error_text(e)), empty, false);
      }
    }
  }
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  return (o, bytes, true);
}

// `tac_file(path, o, s)` — one operand. `-` is stdin, which the
// diagnostics call `standard input`; whether it seeks decides the path.
function tac_file(path: string, o: Out, s: Settings): Out {
  let out: Out = o;
  let is_stdin: boolean = path == "-";
  let name: string = path;
  let r: Reader = stdin();
  if (is_stdin) {
    name = "standard input";
  } else {
    match (open_reader(path)) {
      Ok(f) => {
        r = f;
      },
      Err(e) => {
        return fail(out, "failed to open " + gnu.quotea(path) + " for reading: " + gnu.io_error_text(e));
      }
    }
  }
  let size: i64 = 0 as i64;
  let seekable: boolean = false;
  match (r.seek(0 as i64, 2)) {
    Ok(n) => {
      size = n;
      seekable = true;
    },
    Err(_) => {}
  }
  let src: Src = Src { r: r, held: [], seekable: true };
  if (!seekable) {
    let h: (Out, u8[], boolean) = hold_stream(r, name, out);
    out = h.0;
    if (!h.2) {
      return out;
    }
    src = Src { r: r, held: h.1, seekable: false };
    size = h.1.len() as i64;
  }
  out = tac_backward(src, name, size, out, s);
  if (!is_stdin) {
    match (r.close()) {
      Some(e) => {
        out = fail(out, gnu.quotef(path) + ": read error: " + gnu.io_error_text(e));
      },
      None => {}
    }
  }
  return out;
}

pub function main(): i32 {
  let argv: string[] = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("b", "before", opt_before()));
  opts = opts.append(gnu.flag("r", "regex", opt_regex()));
  opts = opts.append(gnu.valued("s", "separator", opt_separator()));

  let sep: string = "\n";
  let before: boolean = false;
  let regex: boolean = false;
  let g: gnu.Getopt = gnu.getopt_new(argv, opts, "tac", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_before()) {
          before = true;
        } else if (m.id == opt_regex()) {
          regex = true;
        } else if (m.id == opt_separator()) {
          sep = m.value;
        }
      },
      None => {
        break;
      }
    }
  }

  // An empty separator is refused as a regular expression and is the
  // NUL byte otherwise: GNU takes the length of `""` to be one.
  let re: bre.Bre = bre.bre_compile("");
  if (regex) {
    if (sep.len() == 0) {
      gnu.error("separator cannot be empty");
      exit(1);
    }
    re = bre.bre_compile_syntax(sep, bre.emacs_syntax());
    if (re.err.len() > 0) {
      gnu.error(re.err);
      exit(1);
    }
  } else if (sep.len() == 0) {
    sep = "\x00";
  }
  let s: Settings = Settings { sep: sep.bytes(), before: before, regex: regex, re: re };

  let files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  let out: Out = Out { w: stdout(), buf: buf_new(write_size()), ok: true };
  let read_stdin: boolean = false;
  let i: i32 = 0;
  while (i < files.len()) {
    if (files[i] == "-") {
      read_stdin = true;
    }
    out = tac_file(files[i], out, s);
    i = i + 1;
  }
  if (buf_len(out.buf) > 0) {
    write_out(out, buf_take_bytes(out.buf));
  }
  buf_free(out.buf);
  if (read_stdin) {
    match (stdin().close()) {
      Some(e) => {
        out = fail(out, "-: " + gnu.io_error_text(e));
      },
      None => {}
    }
  }
  // gnulib's close_stdout over a stream tac no longer writes through:
  // with nothing pending and no earlier failure, only a close that fails
  // for something other than a closed descriptor is reported.
  match (out.w.close()) {
    Some(e) => {
      let text: string = gnu.io_error_text(e);
      if (text != "Bad file descriptor") {
        gnu.error("write error: " + text);
        exit(1);
      }
    },
    None => {}
  }
  if (!out.ok) {
    return 1;
  }
  return 0;
}
