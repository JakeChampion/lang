import "std/string";
import "std/array";
import "std/errno";
import "./lib/gnu";
import "std/tz";
import "./lib/datetime";
import "./lib/timefmt";

function opt_time(): i32 {
  return 1;
}

function opt_atime(): i32 {
  return 2;
}

function opt_no_create(): i32 {
  return 3;
}

function opt_date(): i32 {
  return 4;
}

function opt_force(): i32 {
  return 5;
}

function opt_no_deref(): i32 {
  return 6;
}

function opt_mtime(): i32 {
  return 7;
}

function opt_reference(): i32 {
  return 8;
}

function opt_stamp(): i32 {
  return 9;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... FILE...\n";
  out += "Update the access and modification times of each FILE to the current time.\n";
  out += "\n";
  out += "A FILE argument that does not exist is created empty, unless -c or -h\n";
  out += "is supplied.\n";
  out += "\n";
  out += "A FILE argument string of - is handled specially and causes touch to\n";
  out += "change the times of the file associated with standard output.\n";
  out += "\n";
  out += "Mandatory arguments to long options are mandatory for short options too.\n";
  out += "  -a                     change only the access time\n";
  out += "  -c, --no-create        do not create any files\n";
  out += "  -d, --date=STRING      parse STRING and use it instead of current time\n";
  out += "  -f                     (ignored)\n";
  out += "  -h, --no-dereference   affect each symbolic link instead of any referenced\n";
  out += "                         file (useful only on systems that can change the\n";
  out += "                         timestamps of a symlink)\n";
  out += "  -m                     change only the modification time\n";
  out += "  -r, --reference=FILE   use this file's times instead of current time\n";
  out += "  -t STAMP               use [[CC]YY]MMDDhhmm[.ss] instead of current time\n";
  out += "      --time=WORD        change the specified time:\n";
  out += "                           WORD is access, atime, or use: equivalent to -a\n";
  out += "                           WORD is modify or mtime: equivalent to -m\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  out += "\n";
  out += "Note that the -d and -t options accept different time-date formats.\n";
  return out;
}

function ch_atime(): i32 {
  return 1;
}

function ch_mtime(): i32 {
  return 2;
}

struct Times { asec: i64, ansec: i64, msec: i64, mnsec: i64, now: boolean }

function now(): Times {
  let ns = now_ns();
  let sec = ns / (1000000000 as i64);
  let nsec = ns % (1000000000 as i64);
  return Times { asec: sec, ansec: nsec, msec: sec, mnsec: nsec, now: true };
}

function date_relative(text: string, sec: i64, nsec: i64, hint: i64): datetime.Result {
  let r = datetime.parse(text, sec, nsec, hint);
  if (!r.ok) {
    gnu.error("invalid date format " + gnu.quote(text));
    exit(1);
  }
  return r;
}

function touch_one(file: string, t: Times, change: i32, no_create: boolean, no_deref: boolean): boolean {
  let path = file;
  let open_err = "";
  let open_failed = false;
  let eisdir = false;
  if (file == "-") {
    path = "/proc/self/fd/1";
  } else if (!(no_create || no_deref)) {
    match (open_writer_with(file, 3)) {
      Ok(w) => {
        w.close();
      },
      Err(e) => {
        open_failed = true;
        open_err = gnu.io_error_text(e);
        eisdir = errno.of(e) == errno.EISDIR;
      }
    }
  }
  let flags = 0;
  if (no_deref) {
    flags = flags | 1;
  }
  if (t.now) {
    flags = flags | 24;
  }
  if (change == ch_mtime()) {
    flags = flags | 2;
  } else if (change == ch_atime()) {
    flags = flags | 4;
  }
  let utime_err = "";
  let utime_enoent = false;
  match (set_file_times(path, t.asec, t.ansec, t.msec, t.mnsec, flags)) {
    Ok(_) => {
      return true;
    },
    Err(e) => {
      utime_err = gnu.io_error_text(e);
      utime_enoent = errno.of(e) == errno.ENOENT;
    }
  }
  if (file == "-") {
    if (utime_enoent) {
      if (no_create) {
        return true;
      }
      utime_err = "Bad file descriptor";
    }
  }
  if (open_failed && !eisdir) {
    gnu.error("cannot touch " + gnu.quotea(file) + ": " + open_err);
    return false;
  }
  if (no_create && utime_enoent) {
    return true;
  }
  gnu.error("setting times of " + gnu.quotea(file) + ": " + utime_err);
  return false;
}

function pad2(v: i32): string {
  if (v < 10) {
    return "0" + v.to_string();
  }
  return v.to_string();
}

pub function main(): i32 {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("", "time", opt_time()));
  opts = opts.append(gnu.flag("c", "no-create", opt_no_create()));
  opts = opts.append(gnu.valued("d", "date", opt_date()));
  opts = opts.append(gnu.valued("r", "reference", opt_reference()));
  opts = opts.append(gnu.flag("h", "no-dereference", opt_no_deref()));
  opts = opts.append(gnu.flag("a", "", opt_atime()));
  opts = opts.append(gnu.flag("f", "", opt_force()));
  opts = opts.append(gnu.flag("m", "", opt_mtime()));
  opts = opts.append(gnu.valued("t", "", opt_stamp()));
  let g = gnu.getopt_new(args(), opts, "touch", help_text(), 1);
  let change = 0;
  let no_create = false;
  let no_deref = false;
  let use_ref = false;
  let ref_file = "";
  let flex_date = "";
  let has_flex = false;
  let date_set = false;
  let zone = tz.local_zone();
  let t = now();
  let hint: i64 = 0;
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_atime()) {
          change = change | ch_atime();
        } else if (m.id == opt_no_create()) {
          no_create = true;
        } else if (m.id == opt_date()) {
          flex_date = m.value;
          has_flex = true;
        } else if (m.id == opt_no_deref()) {
          no_deref = true;
        } else if (m.id == opt_mtime()) {
          change = change | ch_mtime();
        } else if (m.id == opt_reference()) {
          use_ref = true;
          ref_file = m.value;
        } else if (m.id == opt_stamp()) {
          let pt: (boolean, i64, i64) = datetime.posixtime(m.value, 1 + 4 + 8, zone, t.asec, hint);
          if (!pt.0) {
            gnu.error("invalid date format " + gnu.quote(m.value));
            exit(1);
          }
          hint = pt.2;
          t = Times { asec: pt.1, ansec: 0, msec: pt.1, mnsec: 0, now: false };
          date_set = true;
        } else if (m.id == opt_time()) {
          let names: string[] = ["atime", "access", "use", "mtime", "modify"];
          let values: i32[] = [1, 1, 1, 2, 2];
          change = change | gnu.argmatch_valued(m.value, names, values, "--time");
        }
      },
      None => {
        break;
      }
    }
  }
  if (change == 0) {
    change = ch_atime() | ch_mtime();
  }
  if (date_set && (use_ref || has_flex)) {
    gnu.die_usage("cannot specify times from more than one source", 1);
  }
  if (use_ref) {
    let got = false;
    let st_a: i64 = 0;
    let st_an: i64 = 0;
    let st_m: i64 = 0;
    let st_mn: i64 = 0;
    let err = "";
    if (no_deref) {
      match (lstat(ref_file)) {
        Ok(st) => {
          got = true;
          st_a = st.atime;
          st_an = st.atime_nsec;
          st_m = st.mtime;
          st_mn = st.mtime_nsec;
        },
        Err(e) => {
          err = gnu.io_error_text(e);
        }
      }
    } else {
      match (stat(ref_file)) {
        Ok(st) => {
          got = true;
          st_a = st.atime;
          st_an = st.atime_nsec;
          st_m = st.mtime;
          st_mn = st.mtime_nsec;
        },
        Err(e) => {
          err = gnu.io_error_text(e);
        }
      }
    }
    if (!got) {
      gnu.error("failed to get attributes of " + gnu.quotea(ref_file) + ": " + err);
      exit(1);
    }
    t = Times { asec: st_a, ansec: st_an, msec: st_m, mnsec: st_mn, now: false };
    date_set = true;
    if (has_flex) {
      if ((change & ch_atime()) != 0) {
        let ra = date_relative(flex_date, t.asec, t.ansec, hint);
        hint = ra.hint;
        t = Times { ...t, asec: ra.sec, ansec: ra.nsec };
      }
      if ((change & ch_mtime()) != 0) {
        let rm = date_relative(flex_date, t.msec, t.mnsec, hint);
        hint = rm.hint;
        t = Times { ...t, msec: rm.sec, mnsec: rm.nsec };
      }
    }
  } else if (has_flex) {
    let base = now();
    let r = date_relative(flex_date, base.asec, base.ansec, hint);
    hint = r.hint;
    t = Times { asec: r.sec, ansec: r.nsec, msec: r.sec, mnsec: r.nsec, now: false };
    date_set = true;
    if (change == (ch_atime() | ch_mtime()) && r.sec == base.asec && r.nsec == base.ansec) {
      let other = base.asec ^ 1 as i64;
      let again = date_relative(flex_date, other, base.ansec, hint);
      hint = again.hint;
      if (again.sec == other && again.nsec == base.ansec) {
        date_set = false;
      }
    }
  }
  let operands = g.operands();
  let first = 0;
  if (!date_set && operands.len() >= 2 && gnu.posix2_version() < 200112 as i64) {
    let pt: (boolean, i64, i64) = datetime.posixtime(operands[0], 2 + 16, zone, t.asec, hint);
    if (pt.0) {
      hint = pt.2;
      t = Times { asec: pt.1, ansec: 0, msec: pt.1, mnsec: 0, now: false };
      date_set = true;
      match (env("POSIXLY_CORRECT")) {
        Some(_) => {},
        None => {
          let f = timefmt.break_time(zone, pt.1);
          gnu.error("warning: 'touch " + operands[0] + "' is obsolete; use 'touch -t " + f.year.to_string() + pad2(f.month) + pad2(f.day) + pad2(f.hour) + pad2(f.min) + "." + pad2(f.sec) + "'");
        }
      }
      first = 1;
    }
  }
  if (!date_set) {
    t = now();
  }
  if (first >= operands.len()) {
    gnu.die_usage("missing file operand", 1);
  }
  let ok = true;
  let i = first;
  while (i < operands.len()) {
    if (!touch_one(operands[i], t, change, no_create, no_deref)) {
      ok = false;
    }
    i += 1;
  }
  if (ok) {
    return 0;
  }
  return 1;
}
