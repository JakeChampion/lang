// head.fern — GNU-compatible `head`.
//
//   head [-c NUM | -n NUM] [-qvz] [FILE]...
//
// The first NUM lines (10 by default) or bytes of each FILE, `-` and
// no operand both meaning stdin. A LEADING MINUS on the count inverts
// it: `-n -3` prints all but the last three lines, `-c -3` all but the
// last three bytes. With more than one FILE each is introduced by
// `==> NAME <==`, and every header after the first is preceded by a
// blank line; -v forces the header for one file and -q suppresses it.
//
// Two pieces of this are older than the option syntax and are still
// exactly reproduced:
//
//   - The obsolete `-NUM[bkmclqvz]` form, accepted ONLY as argv[1]:
//     `head -5c f` is five bytes. The suffix letters are read left to
//     right, each one re-deriving the count from the digits, so `-1bc`
//     is one byte and `-1cb` is 512 (`b` multiplies AND selects bytes).
//     A digit reached anywhere else — `head f -5`, `head -q5` — is
//     `invalid trailing option -- 5`, which is why the ten digits are
//     declared as options here.
//   - The count itself is glibc's strtoumax plus gnulib's suffixes, so
//     leading blanks and a `+` are accepted, `1b` is 512, `1kB` is
//     1000 and `1KiB` is 1024, and an out-of-range value reports
//     `Value too large for defined data type`. The ceiling differs by
//     mode: elided BYTES must fit in off_t, everything else in
//     uintmax_t.
//
// A count error prints one line and exits 1 with NO `Try …` line —
// unlike an option error, which prints one.
//
// Either elision over a regular file is answered by seeking rather
// than by streaming the whole input: the byte cut is arithmetic on the
// size, and the line cut is found by reading blocks backwards from the
// end, so the cost is the elision's size and not the file's. Anything
// that cannot seek — a pipe, a terminal, `---presume-input-pipe` —
// streams as before.
import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/lines";

// Option ids. The declaration order below is GNU's, because the
// ambiguity list prints candidates in it — `head --=x` names
// `---presume-input-pipe`, the hidden option whose long name starts
// with a dash of its own.
function opt_bytes(): i32 {
  return 1;
}

function opt_lines(): i32 {
  return 2;
}

function opt_presume(): i32 {
  return 3;
}

function opt_quiet(): i32 {
  return 4;
}

function opt_verbose(): i32 {
  return 5;
}

function opt_zero(): i32 {
  return 6;
}

// The ten digits share one id; `next()` reports only the id, so the
// digit itself is read back off the argv token by gnu.digit_option().
function opt_digit(): i32 {
  return 7;
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Print the first 10 lines of each FILE to standard output.\n";
  out = out + "With more than one FILE, precede each with a header giving the file name.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -c, --bytes=[-]NUM       print the first NUM bytes of each file;\n";
  out = out + "                             with the leading '-', print all but the last\n";
  out = out + "                             NUM bytes of each file\n";
  out = out + "  -n, --lines=[-]NUM       print the first NUM lines instead of the first 10;\n";
  out = out + "                             with the leading '-', print all but the last\n";
  out = out + "                             NUM lines of each file\n";
  out = out + "  -q, --quiet, --silent    never print headers giving file names\n";
  out = out + "  -v, --verbose            always print headers giving file names\n";
  out = out + "  -z, --zero-terminated    line delimiter is NUL, not newline\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "NUM may have a multiplier suffix:\n";
  out = out + "b 512, kB 1000, K 1024, MB 1000*1000, M 1024*1024,\n";
  out = out + "GB 1000*1000*1000, G 1024*1024*1024, and so on for T, P, E, Z, Y, R, Q.\n";
  out = out + "Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n";
  return out;
}

// ---- counts ---------------------------------------------------------------
// `Count` — one parsed `-c` / `-n` value: `n` units, `elide` when the
// operand carried a leading minus.
struct Count { n: u64, elide: boolean }

// OFF_T_MAX: the ceiling gnulib puts on an ELIDED byte count, because
// the elision is computed as a file offset. Every other count is held
// to uintmax_t, which parse_units already enforces.
function off_t_max(): u64 {
  return 9223372036854775807 as u64;
}

// `count_of(value, lines)` — the value of a `-n` / `-c` operand, or the
// diagnostic and exit(1) GNU gives it. Note the leading minus is read
// off the FIRST byte, before blanks: `-n ' -3'` is malformed, not an
// elision.
function count_of(value: string, lines: boolean): Count {
  var body: string = value;
  var elide: boolean = false;
  if (value.len() > 0 && value[0] as i32 == 45) {
    elide = true;
    body = slice_unchecked(value, 1, value.len()) + "";
  }
  var noun: string = "bytes";
  if (lines) {
    noun = "lines";
  }
  var r: (u64, i32) = gnu.parse_units(body);
  var status: i32 = r.1;
  if (status == 0 && elide && !lines && r.0 > off_t_max()) {
    status = 2;
  }
  if (gnu.count_malformed(status)) {
    gnu.error("invalid number of " + noun + ": " + gnu.quote(body));
    exit(1);
  }
  if (status != 0) {
    gnu.error("invalid number of " + noun + ": " + gnu.quote(body) + ": Value too large for defined data type");
    exit(1);
  }
  return Count { n: r.0, elide: elide };
}

// ---- the obsolete -NUM form ------------------------------------------------
// `Settings` — everything the option scan decides.
struct Settings { count: Count, lines: boolean, header: i32, term: i32, presume: boolean }

// header: 0 auto (one file bare, several with headers), 1 never, 2 always.
function header_auto(): i32 {
  return 0;
}

function header_never(): i32 {
  return 1;
}

function header_always(): i32 {
  return 2;
}

// `obsolete(tok, s)` — apply `-NUM[bkmclqvz]`. Each letter re-derives
// the count from the digits, so the LAST unit letter wins outright
// rather than compounding with an earlier multiplier.
function obsolete(tok: string, s: Settings): Settings {
  var i: i32 = 1;
  var digits: i32 = i;
  while (i < tok.len() && gnu.is_digit(tok[i] as i32)) {
    i = i + 1;
  }
  var num: string = slice_unchecked(tok, digits, i) + "";
  var out: Settings = Settings { ...s, count: count_of(num, true), lines: true };
  while (i < tok.len()) {
    var c: i32 = tok[i] as i32;
    if (c == 98 || c == 107 || c == 109) {
      var mult: string = "b";
      if (c == 107) {
        mult = "K";
      }
      if (c == 109) {
        mult = "M";
      }
      out = Settings { ...out, count: count_of(num + mult, false), lines: false };
    } else if (c == 99) {
      out = Settings { ...out, count: count_of(num, false), lines: false };
    } else if (c == 108) {
      out = Settings { ...out, count: count_of(num, true), lines: true };
    } else if (c == 113) {
      out = Settings { ...out, header: header_never() };
    } else if (c == 118) {
      out = Settings { ...out, header: header_always() };
    } else if (c == 122) {
      out = Settings { ...out, term: 0 };
    } else {
      gnu.die_usage("invalid trailing option -- " + slice_unchecked(tok, i, i + 1), 1);
    }
    i = i + 1;
  }
  return out;
}

// `read_size()` — bytes per read(2). GNU's head reads its input in
// BUFSIZ-sized pieces; this is the block that measured fastest through
// a pipe on the same sweep yes.fern records.
function read_size(): i32 {
  return 65536;
}

// `copy_head(r, o, s, name)` — the first `n` lines or bytes.
function copy_head(r: Reader, o: gnu.Stream, s: Settings, name: string): gnu.Stream {
  var out: gnu.Stream = o;
  var left: u64 = s.count.n;
  if (left == 0 as u64) {
    return out;
  }
  while (true) {
    match (r.read_chunk(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return out;
        }
        if (!s.lines) {
          if (chunk.len() as u64 >= left) {
            out = gnu.stream_put(out, slice_unchecked(chunk, 0, left as i32) + "");
            return out;
          }
          out = gnu.stream_put(out, chunk);
          left = left - chunk.len() as u64;
        } else {
          // One SIMD tally decides the whole chunk: fewer terminators
          // in it than are still wanted and it goes out unsplit, so
          // only the chunk that reaches the count is walked line by
          // line.
          var here: u64 = __count_byte(chunk, s.term) as u64;
          if (here < left) {
            out = gnu.stream_put(out, chunk);
            left = left - here;
          } else {
            var i: i32 = 0;
            while (left > 0 as u64) {
              i = __memchr(chunk, s.term, i) + 1;
              left = left - 1 as u64;
            }
            out = gnu.stream_put(out, slice_unchecked(chunk, 0, i) + "");
            return out;
          }
        }
      },
      Err(e) => {
        return gnu.stream_fail(out, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      }
    }
  }
  return out;
}

// ---- the seekable elision --------------------------------------------------
// `Region` — the span of a seekable input an elision works over: the
// descriptor's current offset and the size fstat reports.
struct Region { ok: boolean, start: i64, end: i64 }

function no_region(): Region {
  return Region { ok: false, start: 0 as i64, end: 0 as i64 };
}

// `seekable_region(r, s)` — the span an elision may seek over, or
// ok=false for an input that has to be streamed.
//
// A size is only usable when it is a regular file's AND larger than one
// block (`is_file` is S_ISREG, and the one field of the record every
// backend fills): that second half is what keeps a /proc or /sys file — regular,
// and reporting 0 or a bare block while holding other content — on the
// streaming path, where the bytes it actually yields are the answer.
// `---presume-input-pipe` refuses the seek outright, and a descriptor
// that cannot report its offset (a pipe answers `Illegal seek`) is not
// one either.
function seekable_region(r: Reader, s: Settings): Region {
  if (s.presume) {
    return no_region();
  }
  var size: i64 = 0 as i64;
  var blk: i64 = 0 as i64;
  match (r.stat()) {
    Ok(st) => {
      if (!st.is_file) {
        return no_region();
      }
      size = st.size;
      blk = st.blksize;
    },
    Err(_) => {
      return no_region();
    }
  }
  // gnulib's ST_BLKSIZE: a descriptor reporting nothing usable is read
  // in DEV_BSIZE blocks.
  if (blk <= 0 as i64) {
    blk = 512 as i64;
  }
  if (size <= blk) {
    return no_region();
  }
  var cur: i64 = 0 as i64;
  match (r.seek(0 as i64, 1)) {
    Ok(p) => {
      cur = p;
    },
    Err(_) => {
      return no_region();
    }
  }
  // Already at or past the end: the streaming path reaches EOF at once
  // and writes the same nothing.
  if (cur >= size) {
    return no_region();
  }
  return Region { ok: true, start: cur, end: size };
}

// `copy_span(r, o, name, at, n)` — `n` bytes of the input from offset
// `at`, which is where a seekable elision writes its prefix.
function copy_span(r: Reader, o: gnu.Stream, name: string, at: i64, n: i64): gnu.Stream {
  var out: gnu.Stream = o;
  match (r.seek(at, 0)) {
    Ok(_) => {},
    Err(e) => {
      return gnu.stream_fail(out, gnu.quotef(name) + ": cannot seek to offset " + at.to_string() + ": " + gnu.io_error_text(e));
    }
  }
  var left: i64 = n;
  while (left > 0 as i64) {
    var want: i32 = read_size();
    if (left < want as i64) {
      want = left as i32;
    }
    match (r.read_chunk(want)) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return out;
        }
        out = gnu.stream_put(out, chunk);
        left = left - chunk.len() as i64;
      },
      Err(e) => {
        return gnu.stream_fail(out, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      }
    }
  }
  return out;
}

// `read_at(r, o, name, at, n)` — `n` bytes at offset `at`, short only
// at end of input, as (stream, bytes, ok).
function read_at(r: Reader, o: gnu.Stream, name: string, at: i64, n: i32): (gnu.Stream, string, boolean) {
  match (r.seek(at, 0)) {
    Ok(_) => {},
    Err(e) => {
      return (gnu.stream_fail(o, gnu.quotef(name) + ": cannot seek to offset " + at.to_string() + ": " + gnu.io_error_text(e)), "", false);
    }
  }
  var got: string = "";
  while (got.len() < n) {
    match (r.read_chunk(n - got.len())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return (o, got, true);
        }
        if (got.len() == 0) {
          got = chunk;
        } else {
          got = got + chunk;
        }
      },
      Err(e) => {
        return (gnu.stream_fail(o, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e)), "", false);
      }
    }
  }
  return (o, got, true);
}

// `elide_bytes_seekable(r, o, s, name, reg)` — everything but the last
// `n` bytes of a seekable input: the cut is arithmetic on the size, so
// the bytes that are kept are copied once and the elided ones are never
// read at all.
function elide_bytes_seekable(r: Reader, o: gnu.Stream, s: Settings, name: string, reg: Region): gnu.Stream {
  var span: i64 = reg.end - reg.start;
  if (s.count.n >= span as u64) {
    return o;
  }
  return copy_span(r, o, name, reg.start, span - s.count.n as i64);
}

// `elide_lines_seekable(r, o, s, name, reg)` — everything but the last
// `n` lines of a seekable input: blocks are read BACKWARDS from the end
// and their terminators counted until the one that ends the last kept
// line is found, then the prefix is copied. Only the elided tail is
// scanned, where the streaming path tallies every byte of the input.
//
// `skip` is how many terminators lie between the cut and the end: one
// per elided line, less the one an unterminated final line does not
// carry. Below zero the cut is the end itself (`-n -0` over an input
// that does not end in a terminator); running out of terminators with
// `skip` still positive means the input holds no more lines than were
// to be elided, and nothing is written.
function elide_lines_seekable(r: Reader, o: gnu.Stream, s: Settings, name: string, reg: Region): gnu.Stream {
  var out: gnu.Stream = o;
  var span: i64 = reg.end - reg.start;
  // A line is at least one byte, so an elision of the span's own size
  // takes every line with it — which is also what holds the count, a
  // uintmax, inside an offset below.
  if (s.count.n >= span as u64) {
    return out;
  }
  var skip: i64 = s.count.n as i64;
  var block: i64 = read_size() as i64;
  // The first block read is the short one, so every later read lands on
  // a block boundary measured from the start of the span.
  var want: i64 = span % block;
  if (want == 0 as i64) {
    want = block;
  }
  var pos: i64 = reg.end - want;
  var first: boolean = true;
  while (true) {
    var rb: (gnu.Stream, string, boolean) = read_at(r, out, name, pos, want as i32);
    out = rb.0;
    if (!rb.2) {
      return out;
    }
    var buf: string = rb.1;
    if (first) {
      if (buf.len() > 0 && buf[buf.len() - 1] as i32 != s.term) {
        skip = skip - 1 as i64;
      }
      if (skip < 0 as i64) {
        return copy_span(r, out, name, reg.start, span);
      }
      first = false;
    }
    var j: i32 = buf.len() - 1;
    while (j >= 0) {
      j = __rmemchr(buf, s.term, j);
      if (j < 0) {
        break;
      }
      if (skip == 0 as i64) {
        return copy_span(r, out, name, reg.start, pos + j as i64 + 1 as i64 - reg.start);
      }
      skip = skip - 1 as i64;
      j = j - 1;
    }
    if (pos <= reg.start) {
      return out;
    }
    pos = pos - block;
    want = block;
  }
  return out;
}

// `copy_elide_bytes(r, o, s, name)` — everything but the last `n`
// bytes. The tail is held back in `hold`, which stays `n` bytes long
// once the stream is longer than that.
function copy_elide_bytes(r: Reader, o: gnu.Stream, s: Settings, name: string): gnu.Stream {
  var out: gnu.Stream = o;
  var hold: string = "";
  while (true) {
    match (r.read_chunk(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return out;
        }
        hold = hold + chunk;
        if (hold.len() as u64 > s.count.n) {
          var keep: i32 = hold.len() - s.count.n as i32;
          out = gnu.stream_put(out, slice_unchecked(hold, 0, keep) + "");
          hold = slice_unchecked(hold, keep, hold.len()) + "";
        }
      },
      Err(e) => {
        return gnu.stream_fail(out, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      }
    }
  }
  return out;
}

// `copy_elide_lines(r, o, s, name)` — everything but the last `n`
// lines. `hold` keeps every byte after the last released terminator
// plus the `n` withheld lines, and `pending` counts the terminators in
// it, so the release scan runs once per chunk rather than once per line.
function copy_elide_lines(r: Reader, o: gnu.Stream, s: Settings, name: string): gnu.Stream {
  var out: gnu.Stream = o;
  var hold: string = "";
  var pending: u64 = 0 as u64;
  while (true) {
    match (r.read_chunk(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          // An unterminated tail is a line of its own, so it joins the
          // count only once the input has ended.
          var total: u64 = pending;
          if (hold.len() > 0 && hold[hold.len() - 1] as i32 != s.term) {
            total = total + 1 as u64;
          }
          if (total > s.count.n) {
            out = gnu.stream_put(out, release_lines(hold, total - s.count.n, s.term));
          }
          return out;
        }
        var here: u64 = __count_byte(chunk, s.term) as u64;
        var start: i32 = 0 - 1;
        if (here >= s.count.n) {
          start = lines.tail_start(chunk, s.count.n, s.term);
        }
        if (start >= 0) {
          // The chunk alone carries every line that has to be withheld,
          // so everything before them goes out and none of it is
          // scanned forward: the boundary is n + 1 terminators back
          // from the end.
          out = gnu.stream_put(out, hold);
          out = gnu.stream_put(out, slice_unchecked(chunk, 0, start) + "");
          hold = slice_unchecked(chunk, start, chunk.len()) + "";
          pending = s.count.n;
        } else {
          hold = hold + chunk;
          pending = pending + here;
          if (pending > s.count.n) {
            var cut: i32 = lines.line_cut(hold, pending - s.count.n, s.term);
            out = gnu.stream_put(out, slice_unchecked(hold, 0, cut) + "");
            hold = slice_unchecked(hold, cut, hold.len()) + "";
            pending = s.count.n;
          }
        }
      },
      Err(e) => {
        return gnu.stream_fail(out, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      }
    }
  }
  return out;
}

function release_lines(hold: string, n: u64, term: i32): string {
  return slice_unchecked(hold, 0, lines.line_cut(hold, n, term)) + "";
}

// `head_file(path, o, s, show)` — one operand: its header when `show`,
// then its content. `-` is stdin, whose header names it `standard input`.
function head_file(path: string, o: gnu.Stream, s: Settings, show: boolean): gnu.Stream {
  var out: gnu.Stream = o;
  var stdin_input: boolean = path == "-";
  var name: string = path;
  if (stdin_input) {
    name = "standard input";
  }
  var r: Reader = stdin();
  if (!stdin_input) {
    match (open_reader(path)) {
      Ok(f) => {
        r = f;
      },
      Err(e) => {
        return gnu.stream_fail(out, "cannot open " + gnu.quotea(path) + " for reading: " + gnu.io_error_text(e));
      }
    }
  }
  if (show) {
    out = gnu.stream_header(out, name);
  }
  if (s.count.elide) {
    var reg: Region = seekable_region(r, s);
    if (reg.ok && s.lines) {
      out = elide_lines_seekable(r, out, s, name, reg);
    } else if (reg.ok) {
      out = elide_bytes_seekable(r, out, s, name, reg);
    } else if (s.lines) {
      out = copy_elide_lines(r, out, s, name);
    } else {
      out = copy_elide_bytes(r, out, s, name);
    }
  } else {
    out = copy_head(r, out, s, name);
  }
  if (!stdin_input) {
    r.close();
  }
  return out;
}

function main(): i32 {
  var argv: string[] = args();
  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("c", "bytes", opt_bytes()));
  opts = opts.append(gnu.valued("n", "lines", opt_lines()));
  opts = opts.append(gnu.flag("", "-presume-input-pipe", opt_presume()));
  opts = opts.append(gnu.flag("q", "quiet", opt_quiet()));
  opts = opts.append(gnu.flag("", "silent", opt_quiet()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));
  opts = opts.append(gnu.flag("z", "zero-terminated", opt_zero()));
  var d: i32 = 0;
  while (d < 10) {
    opts = opts.append(gnu.flag(slice_unchecked("0123456789", d, d + 1) + "", "", opt_digit()));
    d = d + 1;
  }

  var s: Settings = Settings { count: Count { n: 10 as u64, elide: false }, lines: true, header: header_auto(), term: 10, presume: false };

  // The obsolete form is argv[1] and nowhere else; the rest of the
  // scan then runs over argv with that token removed.
  var scan: string[] = argv;
  if (argv.len() > 1 && argv[1].len() >= 2 && argv[1][0] as i32 == 45 && gnu.is_digit(argv[1][1] as i32)) {
    s = obsolete(argv[1], s);
    scan = [];
    scan = scan.append(argv[0]);
    var k: i32 = 2;
    while (k < argv.len()) {
      scan = scan.append(argv[k]);
      k = k + 1;
    }
  }

  var g: gnu.Getopt = gnu.getopt_new(scan, opts, "head", help_text(), 1);
  while (true) {
    var r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_bytes()) {
          s = Settings { ...s, count: count_of(m.value, false), lines: false };
        } else if (m.id == opt_lines()) {
          s = Settings { ...s, count: count_of(m.value, true), lines: true };
        } else if (m.id == opt_quiet()) {
          s = Settings { ...s, header: header_never() };
        } else if (m.id == opt_verbose()) {
          s = Settings { ...s, header: header_always() };
        } else if (m.id == opt_zero()) {
          s = Settings { ...s, term: 0 };
        } else if (m.id == opt_presume()) {
          s = Settings { ...s, presume: true };
        } else if (m.id == opt_digit()) {
          gnu.die_usage("invalid trailing option -- " + gnu.digit_option(scan), 1);
        }
      },
      None => {
        break;
      }
    }
  }

  var files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  var show: boolean = s.header == header_always() || s.header == header_auto() && files.len() > 1;

  var out: gnu.Stream = gnu.stream_new();
  var i: i32 = 0;
  while (i < files.len()) {
    out = head_file(files[i], out, s, show);
    i = i + 1;
  }
  gnu.stream_finish(out);
  if (!out.ok) {
    return 1;
  }
  return 0;
}
