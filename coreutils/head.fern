import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/lines";

function opt_bytes(): i32 {
  return 1;
}

function opt_lines(): i32 {
  return 2;
}

function opt_presume(): i32 {
  return 3;
}

function opt_quiet(): i32 {
  return 4;
}

function opt_verbose(): i32 {
  return 5;
}

function opt_zero(): i32 {
  return 6;
}

function opt_digit(): i32 {
  return 7;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Print the first 10 lines of each FILE to standard output.\n";
  out = out + "With more than one FILE, precede each with a header giving the file name.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -c, --bytes=[-]NUM       print the first NUM bytes of each file;\n";
  out = out + "                             with the leading '-', print all but the last\n";
  out = out + "                             NUM bytes of each file\n";
  out = out + "  -n, --lines=[-]NUM       print the first NUM lines instead of the first 10;\n";
  out = out + "                             with the leading '-', print all but the last\n";
  out = out + "                             NUM lines of each file\n";
  out = out + "  -q, --quiet, --silent    never print headers giving file names\n";
  out = out + "  -v, --verbose            always print headers giving file names\n";
  out = out + "  -z, --zero-terminated    line delimiter is NUL, not newline\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "NUM may have a multiplier suffix:\n";
  out = out + "b 512, kB 1000, K 1024, MB 1000*1000, M 1024*1024,\n";
  out = out + "GB 1000*1000*1000, G 1024*1024*1024, and so on for T, P, E, Z, Y, R, Q.\n";
  out = out + "Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n";
  return out;
}

struct Count { n: u64, elide: boolean }

function off_t_max(): u64 {
  return 9223372036854775807 as u64;
}

function count_of(value: string, lines: boolean): Count {
  let body: string = value;
  let elide: boolean = false;
  if (value.len() > 0 && value[0] as i32 == 45) {
    elide = true;
    body = slice_unchecked(value, 1, value.len()) + "";
  }
  let noun: string = "bytes";
  if (lines) {
    noun = "lines";
  }
  let r: (u64, i32) = gnu.parse_units(body);
  let status: i32 = r.1;
  if (status == 0 && elide && !lines && r.0 > off_t_max()) {
    status = 2;
  }
  if (gnu.count_malformed(status)) {
    gnu.error("invalid number of " + noun + ": " + gnu.quote(body));
    exit(1);
  }
  if (status != 0) {
    return Count { n: off_t_max_or_all(elide, lines), elide: elide };
  }
  return Count { n: r.0, elide: elide };
}

function off_t_max_or_all(elide: boolean, lines: boolean): u64 {
  if (elide && !lines) {
    return off_t_max();
  }
  return 18446744073709551615 as u64;
}

struct Settings { count: Count, lines: boolean, header: i32, term: i32, presume: boolean }

function header_auto(): i32 {
  return 0;
}

function header_never(): i32 {
  return 1;
}

function header_always(): i32 {
  return 2;
}

function obsolete(tok: string, s: Settings): Settings {
  let i: i32 = 1;
  let digits: i32 = i;
  while (i < tok.len() && gnu.is_digit(tok[i] as i32)) {
    i = i + 1;
  }
  let num: string = slice_unchecked(tok, digits, i) + "";
  let out: Settings = Settings { ...s, count: count_of(num, true), lines: true };
  while (i < tok.len()) {
    let c: i32 = tok[i] as i32;
    if (c == 98 || c == 107 || c == 109) {
      let mult: string = "b";
      if (c == 107) {
        mult = "K";
      }
      if (c == 109) {
        mult = "M";
      }
      out = Settings { ...out, count: count_of(num + mult, false), lines: false };
    } else if (c == 99) {
      out = Settings { ...out, count: count_of(num, false), lines: false };
    } else if (c == 108) {
      out = Settings { ...out, count: count_of(num, true), lines: true };
    } else if (c == 113) {
      out = Settings { ...out, header: header_never() };
    } else if (c == 118) {
      out = Settings { ...out, header: header_always() };
    } else if (c == 122) {
      out = Settings { ...out, term: 0 };
    } else {
      gnu.die_usage("invalid trailing option -- " + slice_unchecked(tok, i, i + 1), 1);
    }
    i = i + 1;
  }
  return out;
}

function read_size(): i32 {
  return 65536;
}

function copy_head(r: Reader, o: gnu.Stream, s: Settings, name: string): gnu.Stream {
  let out: gnu.Stream = o;
  let left: u64 = s.count.n;
  if (left == 0 as u64) {
    return out;
  }
  while (true) {
    match (r.read_chunk_bytes(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return out;
        }
        if (!s.lines) {
          if (chunk.len() as u64 >= left) {
            out = gnu.stream_put_bytes_range(out, chunk, 0, left as i32);
            return out;
          }
          out = gnu.stream_put_bytes(out, chunk);
          left = left - chunk.len() as u64;
        } else {
          let here: u64 = __count_byte_bytes(chunk, s.term) as u64;
          if (here < left) {
            out = gnu.stream_put_bytes(out, chunk);
            left = left - here;
          } else {
            let i: i32 = 0;
            while (left > 0 as u64) {
              i = __memchr_bytes(chunk, s.term, i) + 1;
              left = left - 1 as u64;
            }
            out = gnu.stream_put_bytes_range(out, chunk, 0, i);
            return out;
          }
        }
      },
      Err(e) => {
        return gnu.stream_fail(out, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      }
    }
  }
  return out;
}

struct Region { ok: boolean, start: i64, end: i64 }

function no_region(): Region {
  return Region { ok: false, start: 0 as i64, end: 0 as i64 };
}

function seekable_region(r: Reader, s: Settings): Region {
  if (s.presume) {
    return no_region();
  }
  let size: i64 = 0 as i64;
  let blk: i64 = 0 as i64;
  match (r.stat()) {
    Ok(st) => {
      if (!st.is_file) {
        return no_region();
      }
      size = st.size;
      blk = st.blksize;
    },
    Err(_) => {
      return no_region();
    }
  }
  if (blk <= 0 as i64) {
    blk = 512 as i64;
  }
  if (size <= blk) {
    return no_region();
  }
  let cur: i64 = 0 as i64;
  match (r.seek(0 as i64, 1)) {
    Ok(p) => {
      cur = p;
    },
    Err(_) => {
      return no_region();
    }
  }
  if (cur >= size) {
    return no_region();
  }
  return Region { ok: true, start: cur, end: size };
}

function copy_span(r: Reader, o: gnu.Stream, name: string, at: i64, n: i64): gnu.Stream {
  let out: gnu.Stream = o;
  match (r.seek(at, 0)) {
    Ok(_) => {},
    Err(e) => {
      return gnu.stream_fail(out, gnu.quotef(name) + ": cannot seek to offset " + at.to_string() + ": " + gnu.io_error_text(e));
    }
  }
  let left: i64 = n;
  while (left > 0 as i64) {
    let want: i32 = read_size();
    if (left < want as i64) {
      want = left as i32;
    }
    match (r.read_chunk_bytes(want)) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return out;
        }
        out = gnu.stream_put_bytes(out, chunk);
        left = left - chunk.len() as i64;
      },
      Err(e) => {
        return gnu.stream_fail(out, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      }
    }
  }
  return out;
}

function read_at(r: Reader, o: gnu.Stream, name: string, at: i64, n: i32): (gnu.Stream, u8[], boolean) {
  match (r.seek(at, 0)) {
    Ok(_) => {},
    Err(e) => {
      return (gnu.stream_fail(o, gnu.quotef(name) + ": cannot seek to offset " + at.to_string() + ": " + gnu.io_error_text(e)), [], false);
    }
  }
  let first: u8[] = [];
  match (r.read_chunk_bytes(n)) {
    Ok(chunk) => {
      first = chunk;
    },
    Err(e) => {
      return (gnu.stream_fail(o, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e)), [], false);
    }
  }
  if (first.len() == n || first.len() == 0) {
    return (o, first, true);
  }
  let b = buf_new(n);
  buf_push_bytes_range(b, first, 0, first.len());
  let size = first.len();
  while (size < n) {
    match (r.read_chunk_bytes(n - size)) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          break;
        }
        buf_push_bytes_range(b, chunk, 0, chunk.len());
        size = size + chunk.len();
      },
      Err(e) => {
        buf_free(b);
        return (gnu.stream_fail(o, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e)), [], false);
      }
    }
  }
  let got = buf_take_bytes(b);
  buf_free(b);
  return (o, got, true);
}

function elide_bytes_seekable(r: Reader, o: gnu.Stream, s: Settings, name: string, reg: Region): gnu.Stream {
  let span: i64 = reg.end - reg.start;
  if (s.count.n >= span as u64) {
    return o;
  }
  return copy_span(r, o, name, reg.start, span - s.count.n as i64);
}

function elide_lines_seekable(r: Reader, o: gnu.Stream, s: Settings, name: string, reg: Region): gnu.Stream {
  let out: gnu.Stream = o;
  let span: i64 = reg.end - reg.start;
  if (s.count.n >= span as u64) {
    return out;
  }
  let skip: i64 = s.count.n as i64;
  let block: i64 = read_size() as i64;
  let want: i64 = span % block;
  if (want == 0 as i64) {
    want = block;
  }
  let pos: i64 = reg.end - want;
  let first: boolean = true;
  while (true) {
    let rb: (gnu.Stream, u8[], boolean) = read_at(r, out, name, pos, want as i32);
    out = rb.0;
    if (!rb.2) {
      return out;
    }
    let buf: u8[] = rb.1;
    if (first) {
      if (buf.len() > 0 && buf[buf.len() - 1] as i32 != s.term) {
        skip = skip - 1 as i64;
      }
      if (skip < 0 as i64) {
        return copy_span(r, out, name, reg.start, span);
      }
      first = false;
    }
    let j: i32 = buf.len() - 1;
    while (j >= 0) {
      j = __rmemchr_bytes(buf, s.term, j);
      if (j < 0) {
        break;
      }
      if (skip == 0 as i64) {
        return copy_span(r, out, name, reg.start, pos + j as i64 + 1 as i64 - reg.start);
      }
      skip = skip - 1 as i64;
      j = j - 1;
    }
    if (pos <= reg.start) {
      return out;
    }
    pos = pos - block;
    want = block;
  }
  return out;
}

function copy_elide_bytes(r: Reader, o: gnu.Stream, s: Settings, name: string): gnu.Stream {
  let out: gnu.Stream = o;
  let hold = lines.hold_empty();
  while (true) {
    match (r.read_chunk_bytes(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return out;
        }
        hold = lines.hold_push(hold, chunk);
        if (hold.n > s.count.n) {
          let keep = hold.n - s.count.n;
          out = lines.hold_write(hold, out, keep);
          hold = lines.hold_drop(hold, keep);
        }
      },
      Err(e) => {
        return gnu.stream_fail(out, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      }
    }
  }
  return out;
}

function copy_elide_lines(r: Reader, o: gnu.Stream, s: Settings, name: string): gnu.Stream {
  let out: gnu.Stream = o;
  let hold = lines.hold_empty();
  let pending: u64 = 0 as u64;
  while (true) {
    match (r.read_chunk_bytes(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          let total: u64 = pending;
          if (hold.n > 0 as u64 && hold.last as i32 != s.term) {
            total = total + 1 as u64;
          }
          if (total > s.count.n) {
            out = lines.hold_write(hold, out, lines.hold_cut(hold, total - s.count.n, s.term));
          }
          return out;
        }
        let here: u64 = __count_byte_bytes(chunk, s.term) as u64;
        let start: i32 = 0 - 1;
        if (here >= s.count.n) {
          start = lines.tail_start(chunk, s.count.n, s.term);
        }
        if (start >= 0) {
          out = lines.hold_write(hold, out, hold.n);
          out = gnu.stream_put_bytes_range(out, chunk, 0, start);
          hold = lines.hold_from(chunk, start);
          pending = s.count.n;
        } else {
          hold = lines.hold_push(hold, chunk);
          pending = pending + here;
          if (pending > s.count.n) {
            let cut = lines.hold_cut(hold, pending - s.count.n, s.term);
            out = lines.hold_write(hold, out, cut);
            hold = lines.hold_drop(hold, cut);
            pending = s.count.n;
          }
        }
      },
      Err(e) => {
        return gnu.stream_fail(out, "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e));
      }
    }
  }
  return out;
}

function head_file(path: string, o: gnu.Stream, s: Settings, show: boolean): gnu.Stream {
  let out: gnu.Stream = o;
  let stdin_input: boolean = path == "-";
  let name: string = path;
  if (stdin_input) {
    name = "standard input";
  }
  let r: Reader = stdin();
  if (!stdin_input) {
    match (open_reader(path)) {
      Ok(f) => {
        r = f;
      },
      Err(e) => {
        return gnu.stream_fail(out, "cannot open " + gnu.quotea(path) + " for reading: " + gnu.io_error_text(e));
      }
    }
  }
  if (show) {
    out = gnu.stream_header(out, name);
  }
  if (s.count.elide) {
    let reg: Region = seekable_region(r, s);
    if (reg.ok && s.lines) {
      out = elide_lines_seekable(r, out, s, name, reg);
    } else if (reg.ok) {
      out = elide_bytes_seekable(r, out, s, name, reg);
    } else if (s.lines) {
      out = copy_elide_lines(r, out, s, name);
    } else {
      out = copy_elide_bytes(r, out, s, name);
    }
  } else {
    out = copy_head(r, out, s, name);
  }
  if (!stdin_input) {
    r.close();
  }
  return out;
}

pub function main(): i32 {
  let argv: string[] = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("c", "bytes", opt_bytes()));
  opts = opts.append(gnu.valued("n", "lines", opt_lines()));
  opts = opts.append(gnu.flag("", "-presume-input-pipe", opt_presume()));
  opts = opts.append(gnu.flag("q", "quiet", opt_quiet()));
  opts = opts.append(gnu.flag("", "silent", opt_quiet()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));
  opts = opts.append(gnu.flag("z", "zero-terminated", opt_zero()));
  let d: i32 = 0;
  while (d < 10) {
    opts = opts.append(gnu.flag(slice_unchecked("0123456789", d, d + 1) + "", "", opt_digit()));
    d = d + 1;
  }

  let s: Settings = Settings { count: Count { n: 10 as u64, elide: false }, lines: true, header: header_auto(), term: 10, presume: false };

  let scan: string[] = argv;
  if (argv.len() > 1 && argv[1].len() >= 2 && argv[1][0] as i32 == 45 && gnu.is_digit(argv[1][1] as i32)) {
    s = obsolete(argv[1], s);
    scan = [];
    scan = scan.append(argv[0]);
    let k: i32 = 2;
    while (k < argv.len()) {
      scan = scan.append(argv[k]);
      k = k + 1;
    }
  }

  let g: gnu.Getopt = gnu.getopt_new(scan, opts, "head", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_bytes()) {
          s = Settings { ...s, count: count_of(m.value, false), lines: false };
        } else if (m.id == opt_lines()) {
          s = Settings { ...s, count: count_of(m.value, true), lines: true };
        } else if (m.id == opt_quiet()) {
          s = Settings { ...s, header: header_never() };
        } else if (m.id == opt_verbose()) {
          s = Settings { ...s, header: header_always() };
        } else if (m.id == opt_zero()) {
          s = Settings { ...s, term: 0 };
        } else if (m.id == opt_presume()) {
          s = Settings { ...s, presume: true };
        } else if (m.id == opt_digit()) {
          gnu.die_usage("invalid trailing option -- " + gnu.digit_option(scan), 1);
        }
      },
      None => {
        break;
      }
    }
  }

  let files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  let show: boolean = s.header == header_always() || s.header == header_auto() && files.len() > 1;

  let out: gnu.Stream = gnu.stream_new();
  let i: i32 = 0;
  while (i < files.len()) {
    out = head_file(files[i], out, s, show);
    i = i + 1;
  }
  gnu.stream_finish(out);
  if (!out.ok) {
    return 1;
  }
  return 0;
}
