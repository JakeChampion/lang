import "../lib/bre";

// The lazy DFA answers where a match ends and whether a line matches;
// the simulation answers a pattern's groups and the backtracker its
// backreferences. These pin each engine's answers to GNU expr 9.12's and
// the DFA's to the simulation's over the same program.

// GNU's `expr SUBJ : PAT` as a number: the match length for a pattern
// without groups, -1 where it does not match.
function end_of(pat: string, subj: string): i32 {
  let m = bre.bre_compile(pat).exec(subj);
  if (!m.matched) {
    return 0 - 1;
  }
  return m.end;
}

// Group 1's text, or "<none>".
function group1(pat: string, subj: string): string {
  let m = bre.bre_compile(pat).exec(subj);
  if (!m.matched || m.starts[1] < 0) {
    return "<none>";
  }
  return slice_unchecked(subj, m.starts[1], m.ends[1]) + "";
}

// A deterministic subject over `alphabet`.
function subject(seed: i32, n: i32, alphabet: string): u8[] {
  let out: u8[] = [];
  let x: i32 = seed;
  let k: i32 = 0;
  while (k < n) {
    x = (x * 1103 + 12345) % 65536;
    out = out.append(alphabet[x / 7 % alphabet.len()] as u8);
    k = k + 1;
  }
  return out;
}

// Anchors, brackets, intervals and empty matches, against GNU expr.
function check_exec(): i32 {
  if (end_of("[[:digit:]]\\{3\\}", "1234") != 3 || end_of("[^a-c]*", "xyzabc") != 3) {
    return 1;
  }
  if (end_of("a\\{2,3\\}", "aaaa") != 3 || end_of("a\\{0,1\\}ab", "aab") != 3 || end_of("[a-z.]*", "ab.cd") != 5) {
    return 2;
  }
  // An empty match is a match, of length 0.
  if (end_of("a*", "bbb") != 0 || end_of("", "abc") != 0) {
    return 3;
  }
  // `$` holds only at the end; mid-pattern it is a literal, as is a
  // leading `*`.
  if (end_of("x$", "xy") != 0 - 1 || end_of("x$y", "x$y") != 3 || end_of("*b", "a*b") != 0 - 1) {
    return 4;
  }
  // The word tests read the byte behind and the byte ahead.
  if (end_of(".*\\<bar", "foo bar") != 7 || end_of(".*\\>", "foo bar") != 7 || end_of("foo\\b", "foo bar") != 3) {
    return 5;
  }
  if (end_of("foo\\B", "foobar") != 3 || end_of("foo\\b", "foobar") != 0 - 1) {
    return 6;
  }
  if (end_of("a\\'", "ab") != 0 - 1 || end_of("ab\\'", "ab") != 2 || end_of("\\`ab", "ab") != 2) {
    return 7;
  }
  if (group1("\\(ab\\)\\{2\\}", "ababab") != "ab" || group1("\\(ab\\)\\{1,\\}", "ababab") != "ab") {
    return 8;
  }
  if (group1("\\(a\\|ab\\)\\(c\\|bcd\\)*", "abcabc") != "ab" || group1("\\(a\\)\\(b\\)\\(c\\)\\(d\\)", "abcd") != "a") {
    return 9;
  }
  return 0;
}

// Shapes that run one engine into its limits. A walk nested 32767
// instructions deep ran the simulation's recursive closure out of
// stack, and a DFA state per byte must stay one closure per byte.
function check_pathological(): i32 {
  if (end_of("a*\\{3200\\}", "ab") != 1 || end_of("a\\{1,32767\\}", "aaa") != 3) {
    return 20;
  }
  if (group1("\\(a\\)\\{1,32767\\}", "aaa") != "a") {
    return 21;
  }
  let many: u8[] = subject(1, 20000, "a");
  if (bre.bre_compile("a\\{20000\\}").exec_bytes(many).end != 20000 || bre.bre_compile("a\\{20001\\}").exec_bytes(many).matched) {
    return 22;
  }
  return 0;
}

// The DFA (no groups) and the simulation (the same program inside one
// group) report the same end, over subjects long enough to fill and
// empty the DFA's cache: `[ab]*a[ab]\{12\}` has a state for every
// 13-byte window. One compiled pattern serves every subject, so the
// cache carried from call to call is exercised too.
function check_agreement(): i32 {
  let pats: string[] = ["[ab]*a[ab]\\{12\\}", "[ab]*b", "a*b*a*", "\\(a\\|b\\)*a", "[ab]*a[ab]\\{3\\}c", "a\\{2,5\\}b\\{0,3\\}"];
  let p: i32 = 0;
  while (p < pats.len()) {
    let plain = bre.bre_compile(pats[p]);
    let grouped = bre.bre_compile("\\(" + pats[p] + "\\)");
    let seed: i32 = 1;
    while (seed < 40) {
      let s: u8[] = subject(seed * 31 + p, seed * 97, "ab");
      let a = plain.exec_bytes(s);
      let b = grouped.exec_bytes(s);
      if (a.matched != b.matched || a.matched && a.end != b.end) {
        return 30 + p;
      }
      seed = seed + 1;
    }
    p = p + 1;
  }
  return 0;
}

// `search_range` reads `^` and `$` at the window's ends, and at newlines
// only where the syntax anchors there; one Bre answers every window, so
// a state built for one is reused for the next.
function check_search(): i32 {
  let mid = bre.bre_compile("^ab");
  if (!mid.search_range("xab", 1, 3) || mid.search_range("xab", 0, 3)) {
    return 40;
  }
  let tail = bre.bre_compile("ab$");
  if (!tail.search_range("abx", 0, 2) || tail.search_range("abx", 0, 3)) {
    return 41;
  }
  let nl = bre.bre_compile_syntax("^b", bre.emacs_syntax());
  if (!nl.search("a\nb") || bre.bre_compile("^b").search("a\nb")) {
    return 42;
  }
  let word = bre.bre_compile("\\<foo\\>");
  if (!word.search("a foo b") || word.search("afoob") || !word.search_range("afoo", 1, 4)) {
    return 43;
  }
  let digits = bre.bre_compile("[0-9]*5$");
  let line: i32 = 0;
  while (line < 2000) {
    let text: string = line.to_string();
    let want: boolean = text[text.len() - 1] as i32 == 53;
    if (digits.search(text) != want) {
      return 44;
    }
    line = line + 1;
  }
  return 0;
}

// The searches that report positions, which run the DFA from each start.
function check_positions(): i32 {
  let re = bre.bre_compile("[a-z][a-z0-9]*");
  let f = re.search_from("12 ab3 cd", 0, 9);
  if (f.0 != 3 || f.1 != 6) {
    return 50;
  }
  let b = re.search_back("12 ab3 cd", 9);
  if (b.0 != 8 || b.1 != 9) {
    return 51;
  }
  return 0;
}

function main(): i32 {
  let r: i32 = check_exec();
  if (r != 0) {
    return r;
  }
  r = check_pathological();
  if (r != 0) {
    return r;
  }
  r = check_agreement();
  if (r != 0) {
    return r;
  }
  r = check_search();
  if (r != 0) {
    return r;
  }
  return check_positions();
}
