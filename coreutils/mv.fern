import "std/string";
import "std/array";
import "std/io_buffered";
import "std/errno";
import "./lib/gnu";
import "./lib/canon";
import "./lib/copy";

function opt_backup(): i32 {
  return 1;
}

function opt_context(): i32 {
  return 2;
}

function opt_debug(): i32 {
  return 3;
}

function opt_force(): i32 {
  return 4;
}

function opt_interactive(): i32 {
  return 5;
}

function opt_no_clobber(): i32 {
  return 6;
}

function opt_no_copy(): i32 {
  return 7;
}

function opt_no_target_directory(): i32 {
  return 8;
}

function opt_strip_trailing_slashes(): i32 {
  return 9;
}

function opt_suffix(): i32 {
  return 10;
}

function opt_target_directory(): i32 {
  return 11;
}

function opt_update(): i32 {
  return 12;
}

function opt_verbose(): i32 {
  return 13;
}

function opt_update_short(): i32 {
  return 14;
}

function opt_exchange(): i32 {
  return 15;
}

function ask_yes(): i32 {
  return 0;
}

function ask_prompt(): i32 {
  return 1;
}

function ask_never(): i32 {
  return 2;
}

function update_all(): i32 {
  return 0;
}

function update_none(): i32 {
  return 1;
}

function update_older(): i32 {
  return 2;
}

function update_none_fail(): i32 {
  return 3;
}

function update_names(): string[] {
  return ["all", "none", "none-fail", "older"];
}

function update_values(): i32[] {
  return [update_all(), update_none(), update_none_fail(), update_older()];
}

function update_skips(u: i32): boolean {
  return u == update_none() || u == update_none_fail();
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [-T] SOURCE DEST\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... SOURCE... DIRECTORY\n";
  out = out + "  or:  " + gnu.prog() + " [OPTION]... -t DIRECTORY SOURCE...\n";
  out = out + "Rename SOURCE to DEST, or move every SOURCE into DIRECTORY.\n";
  out = out + "\n";
  out = out + "      --backup[=CONTROL]      back up each existing destination\n";
  out = out + "  -b                          like --backup, taking no argument\n";
  out = out + "      --debug                 explain how each file is moved; implies -v\n";
  out = out + "      --exchange              exchange source and destination\n";
  out = out + "  -f, --force                 do not prompt before overwriting\n";
  out = out + "  -i, --interactive           prompt before overwriting\n";
  out = out + "  -n, --no-clobber            do not overwrite an existing file\n";
  out = out + "      --no-copy               fail rather than copy across filesystems\n";
  out = out + "      --strip-trailing-slashes  drop any trailing slashes from each SOURCE\n";
  out = out + "  -S, --suffix=SUFFIX         the simple backup suffix, instead of '~'\n";
  out = out + "  -t, --target-directory=DIRECTORY  move every SOURCE into DIRECTORY\n";
  out = out + "  -T, --no-target-directory   treat DEST as a normal file always\n";
  out = out + "      --update[=UPDATE]       which existing destinations are replaced:\n";
  out = out + "                                all, none, none-fail, or older (the default)\n";
  out = out + "  -u                          like --update=older\n";
  out = out + "  -v, --verbose               print each move as it is made\n";
  out = out + "  -Z, --context               give the destination the default SELinux type\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "Only the LAST of -i, -f and -n on the command line takes effect.\n";
  out = out + "\n";
  out = out + "The backup suffix is '~' unless -S or SIMPLE_BACKUP_SUFFIX says otherwise,\n";
  out = out + "and the control is --backup's argument or VERSION_CONTROL: none/off,\n";
  out = out + "numbered/t, existing/nil (numbered if a numbered backup is there, else\n";
  out = out + "simple), simple/never.\n";
  return out;
}

struct Cfg { ask: i32, update: i32, strip: boolean, verbose: boolean, debug: boolean, exchange: boolean, backups: boolean, control: i32, suffix: string, no_copy: boolean }

struct StatInfo { ok: boolean, is_dir: boolean, dev: i64, ino: i64, mtime: i64, mtime_nsec: i64, errnum: i32, err: string }

function no_stat(e: IoError): StatInfo {
  return StatInfo { ok: false, is_dir: false, dev: 0, ino: 0, mtime: 0, mtime_nsec: 0, errnum: errno.of(e), err: gnu.io_error_text(e) };
}

function lstat_info(path: string): StatInfo {
  match (lstat(path)) {
    Ok(st) => {
      return StatInfo { ok: true, is_dir: st.is_dir, dev: st.dev, ino: st.ino, mtime: st.mtime, mtime_nsec: st.mtime_nsec, errnum: 0, err: "" };
    },
    Err(e) => {
      return no_stat(e);
    }
  }
}

function stat_info(path: string): StatInfo {
  match (stat(path)) {
    Ok(st) => {
      return StatInfo { ok: true, is_dir: st.is_dir, dev: st.dev, ino: st.ino, mtime: st.mtime, mtime_nsec: st.mtime_nsec, errnum: 0, err: "" };
    },
    Err(e) => {
      return no_stat(e);
    }
  }
}

function dest_path(dest: string): string {
  if (dest.len() == 0) {
    return ".";
  }
  return dest;
}

function dest_present(dest: string): boolean {
  let st: StatInfo = lstat_info(dest);
  if (st.ok) {
    return true;
  }
  if (st.errnum != errno.ENOTDIR || target_os() == "darwin") {
    return false;
  }
  let bare: string = gnu.strip_slashes(dest);
  if (bare == dest) {
    return false;
  }
  return lstat_info(bare).ok;
}

function resolved(p: string): string {
  match (canon.canonicalize(p, canon.missing(), false)) {
    Ok(r) => {
      return r;
    },
    Err(_) => {
      return p;
    }
  }
}

function same_entry(a: string, b: string): boolean {
  if (gnu.base_name(a) != gnu.base_name(b)) {
    return false;
  }
  let ad: StatInfo = stat_info(gnu.dir_name(a));
  let bd: StatInfo = stat_info(gnu.dir_name(b));
  return ad.ok && bd.ok && ad.dev == bd.dev && ad.ino == bd.ino;
}

function same_file(cfg: Cfg, src: string, dest: string, s: StatInfo, d: StatInfo): boolean {
  if (same_entry(src, dest)) {
    return true;
  }
  if (cfg.backups) {
    return false;
  }
  if (s.ok && d.ok && s.dev == d.dev && s.ino == d.ino) {
    return true;
  }
  return same_entry(resolved(src), dest);
}

struct MoveOut { status: i32, out: io_buffered.BufWriter }

function move_failure(src: string, dest: string, n: i32, text: string): string {
  if (n == errno.EINVAL) {
    return "cannot move " + gnu.quotea(src) + " to a subdirectory of itself, " + gnu.quotea(dest);
  }
  if (n == errno.ENOTEMPTY || n == errno.EEXIST || n == errno.EISDIR || n == errno.EDQUOT || n == errno.EMLINK || n == errno.ENOSPC || n == errno.ETXTBSY) {
    return "cannot overwrite " + gnu.quotea(dest) + ": " + text;
  }
  return "cannot move " + gnu.quotea(src) + " to " + gnu.quotea(dest) + ": " + text;
}

struct Move { raw_src: string, raw_dest: string, src: string, dest: string }

function do_move(cfg: Cfg, m0: Move, allow_into: boolean, o: io_buffered.BufWriter): MoveOut {
  let w: io_buffered.BufWriter = o;
  let m: Move = m0;
  let present: boolean = dest_present(m.raw_dest);
  if (present && allow_into && stat_info(m.raw_dest).is_dir) {
    let into: string = gnu.join_path(m.dest, gnu.base_name(m.src));
    return do_move(cfg, Move { raw_src: m.src, raw_dest: into, src: m.src, dest: into }, false, w);
  }
  if (cfg.exchange) {
    return exchange_pair(cfg, m, w);
  }

  let rename_errnum: i32 = errno.EEXIST;
  let rename_err: string = "File exists";
  if (!present) {
    match (rename_noreplace(m.raw_src, m.raw_dest)) {
      Ok(_) => {
        return verbose(cfg, m, "", w);
      },
      Err(e) => {
        rename_errnum = errno.of(e);
        rename_err = gnu.io_error_text(e);
      }
    }
    if (lacks_noreplace(rename_errnum)) {
      match (rename(m.raw_src, m.raw_dest)) {
        Ok(_) => {
          return verbose(cfg, m, "", w);
        },
        Err(e) => {
          rename_errnum = errno.of(e);
          rename_err = gnu.io_error_text(e);
        }
      }
    }
    if (rename_err.len() == 0) {
      rename_errnum = errno.EEXIST;
      rename_err = "File exists";
    }
  } else {
    let skipped: MoveOut = refuse_existing(cfg, m.dest, w);
    if (skipped.status >= 0) {
      return skipped;
    }
    w = skipped.out;
  }

  let s: StatInfo = lstat_info(m.src);
  if (!s.ok) {
    w = gnu.error_out(w, "cannot stat " + gnu.quotea(m.src) + ": " + s.err);
    return MoveOut { status: 1, out: w };
  }
  let d: StatInfo = lstat_info(dest_path(m.dest));
  if (!d.ok) {
    if (d.errnum != errno.ENOENT) {
      w = gnu.error_out(w, "cannot stat " + gnu.quotea(m.dest) + ": " + d.err);
      return MoveOut { status: 1, out: w };
    }
    if (rename_errnum == errno.EXDEV && !cfg.no_copy) {
      return move_across(cfg, m, "", w);
    }
    w = gnu.error_out(w, move_failure(m.src, m.dest, rename_errnum, rename_err));
    return MoveOut { status: 1, out: w };
  }

  let skipped2: MoveOut = refuse_existing(cfg, m.dest, w);
  if (skipped2.status >= 0) {
    return skipped2;
  }
  return replace_dest(cfg, m, s, d, skipped2.out);
}

function lacks_noreplace(n: i32): boolean {
  return n == errno.EINVAL || n == errno.ENOTSUP || n == errno.ENOSYS;
}

function replace_dest(cfg: Cfg, m: Move, s: StatInfo, d: StatInfo, o: io_buffered.BufWriter): MoveOut {
  let w: io_buffered.BufWriter = o;
  if (same_file(cfg, m.src, m.dest, s, d)) {
    w = gnu.error_out(w, gnu.quotea(m.src) + " and " + gnu.quotea(m.dest) + " are the same file");
    return MoveOut { status: 1, out: w };
  }
  if (cfg.update == update_older() && !newer(s, d)) {
    return MoveOut { status: 0, out: w };
  }
  if (cfg.ask == ask_prompt()) {
    w = gnu.flush(w);
    if (!gnu.prompt("overwrite " + gnu.quotea(m.dest) + "? ")) {
      return MoveOut { status: 1, out: w };
    }
  }
  if (s.is_dir && !d.is_dir) {
    w = gnu.error_out(w, "cannot overwrite non-directory " + gnu.quotea(m.dest) + " with directory " + gnu.quotea(m.src));
    return MoveOut { status: 1, out: w };
  }
  if (!s.is_dir && d.is_dir) {
    w = gnu.error_out(w, "cannot overwrite directory " + gnu.quotea(m.dest) + " with non-directory " + gnu.quotea(m.src));
    return MoveOut { status: 1, out: w };
  }
  let backup: string = "";
  if (cfg.backups) {
    backup = gnu.backup_name(m.dest, cfg.control, cfg.suffix);
    match (rename(dest_path(m.dest), backup)) {
      Ok(_) => {},
      Err(e) => {
        if (errno.of(e) != errno.ENOENT) {
          w = gnu.error_out(w, "cannot backup " + gnu.quotea(m.dest) + ": " + gnu.io_error_text(e));
          return MoveOut { status: 1, out: w };
        }
        backup = "";
      }
    }
  }
  match (rename(m.src, dest_path(m.dest))) {
    Ok(_) => {},
    Err(e2) => {
      if (errno.of(e2) == errno.EXDEV && !cfg.no_copy) {
        return move_across(cfg, m, backup, w);
      }
      w = gnu.error_out(w, move_failure(m.src, m.dest, errno.of(e2), gnu.io_error_text(e2)));
      return MoveOut { status: 1, out: w };
    }
  }
  return verbose(cfg, m, backup, w);
}

function inter_device_failure(src: string, dest: string, text: string): string {
  return "inter-device move failed: " + gnu.quotea(src) + " to " + gnu.quotea(dest) + "; unable to remove target: " + text;
}

function clear_target(dest: string): Option[string] {
  let info: StatInfo = lstat_info(dest);
  if (!info.ok) {
    return None;
  }
  if (info.is_dir) {
    match (remove_dir(dest)) {
      Ok(_) => {
        return None;
      },
      Err(e) => {
        return Some(gnu.io_error_text(e));
      }
    }
  }
  match (remove_file(dest)) {
    Ok(_) => {
      return None;
    },
    Err(e2) => {
      return Some(gnu.io_error_text(e2));
    }
  }
}

function drop_source(cfg: Cfg, path: string, o: io_buffered.BufWriter): MoveOut {
  let w: io_buffered.BufWriter = o;
  let info: StatInfo = lstat_info(path);
  if (!info.ok) {
    w = gnu.error_out(w, "cannot remove " + gnu.quotea(path) + ": " + info.err);
    return MoveOut { status: 1, out: w };
  }
  if (info.is_dir) {
    let names: string[] = [];
    match (read_dir(path)) {
      Ok(es) => {
        names = es;
      },
      Err(e) => {
        w = gnu.error_out(w, "cannot read directory " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
        return MoveOut { status: 1, out: w };
      }
    }
    let i: i32 = 0;
    let status: i32 = 0;
    while (i < names.len()) {
      let below: MoveOut = drop_source(cfg, gnu.join_path(path, names[i]), w);
      w = below.out;
      if (below.status != 0) {
        status = 1;
      }
      i = i + 1;
    }
    if (status != 0) {
      return MoveOut { status: status, out: w };
    }
    match (remove_dir(path)) {
      Ok(_) => {
        return removed_line(cfg, path, true, w);
      },
      Err(e3) => {
        w = gnu.error_out(w, "cannot remove " + gnu.quotea(path) + ": " + gnu.io_error_text(e3));
        return MoveOut { status: 1, out: w };
      }
    }
  }
  match (remove_file(path)) {
    Ok(_) => {
      return removed_line(cfg, path, false, w);
    },
    Err(e4) => {
      w = gnu.error_out(w, "cannot remove " + gnu.quotea(path) + ": " + gnu.io_error_text(e4));
      return MoveOut { status: 1, out: w };
    }
  }
}

function removed_line(cfg: Cfg, path: string, is_dir: boolean, o: io_buffered.BufWriter): MoveOut {
  let w: io_buffered.BufWriter = o;
  if (cfg.verbose) {
    let what: string = "removed ";
    if (is_dir) {
      what = "removed directory ";
    }
    w = gnu.put(w, what + gnu.quotea(path) + "\n");
  }
  return MoveOut { status: 0, out: w };
}

function move_across(cfg: Cfg, m: Move, backup: string, o: io_buffered.BufWriter): MoveOut {
  let w: io_buffered.BufWriter = o;
  match (clear_target(dest_path(m.dest))) {
    Some(text) => {
      w = gnu.error_out(w, inter_device_failure(m.src, m.dest, text));
      return MoveOut { status: 1, out: w };
    },
    None => {}
  }
  let ccfg: copy.Cfg = copy.Cfg { ...copy.cfg_new(), attrs: copy.attrs_all(), recursive: true, deref: copy.deref_never(), verbose: cfg.verbose, verbose_style: copy.vstyle_move(), announced_backup: backup };
  let cst: copy.State = copy.copy_one(ccfg, copy.state_new(w), m.src, dest_path(m.dest), true);
  w = cst.out;
  if (cst.status != 0) {
    return MoveOut { status: cst.status, out: w };
  }
  return drop_source(cfg, m.src, w);
}

function verbose(cfg: Cfg, m: Move, backup: string, o: io_buffered.BufWriter): MoveOut {
  let w: io_buffered.BufWriter = o;
  if (cfg.verbose) {
    let line: string = "renamed " + gnu.quotea(m.src) + " -> " + gnu.quotea(m.dest);
    if (backup.len() > 0) {
      line = line + " (backup: " + gnu.quotea(backup) + ")";
    }
    w = gnu.put(w, line + "\n");
  }
  return MoveOut { status: 0, out: w };
}

function exchange_pair(cfg: Cfg, m: Move, o: io_buffered.BufWriter): MoveOut {
  let w: io_buffered.BufWriter = o;
  let s: StatInfo = lstat_info(m.src);
  if (!s.ok) {
    return MoveOut { status: 1, out: gnu.error_out(w, "cannot stat " + gnu.quotea(m.src) + ": " + s.err) };
  }
  let dest: string = dest_path(m.dest);
  let d: StatInfo = lstat_info(dest);
  if (same_file(cfg, m.src, m.dest, s, d)) {
    return MoveOut { status: 1, out: gnu.error_out(w, gnu.quotea(m.src) + " and " + gnu.quotea(m.dest) + " are the same file") };
  }
  match (rename_exchange(m.src, dest)) {
    Ok(_) => {},
    Err(e) => {
      return MoveOut { status: 1, out: gnu.error_out(w, exchange_failure(m, gnu.io_error_text(e))) };
    }
  }
  if (cfg.verbose) {
    w = gnu.put(w, "exchanged " + gnu.quotea(m.src) + " <-> " + gnu.quotea(m.dest) + "\n");
  }
  return MoveOut { status: 0, out: w };
}

function exchange_failure(m: Move, why: string): string {
  return "cannot exchange " + gnu.quotea(m.src) + " and " + gnu.quotea(m.dest) + ": " + why;
}

function refuse_existing(cfg: Cfg, dest: string, o: io_buffered.BufWriter): MoveOut {
  if (cfg.update == update_none_fail()) {
    return MoveOut { status: 1, out: gnu.error_out(o, "not replacing " + gnu.quotea(dest)) };
  }
  if (cfg.update == update_none()) {
    let w: io_buffered.BufWriter = o;
    if (cfg.debug) {
      w = gnu.put(w, "skipped " + gnu.quotea(dest) + "\n");
    }
    return MoveOut { status: 0, out: w };
  }
  return MoveOut { status: 0 - 1, out: o };
}

function newer(s: StatInfo, d: StatInfo): boolean {
  if (s.mtime != d.mtime) {
    return s.mtime > d.mtime;
  }
  return s.mtime_nsec > d.mtime_nsec;
}

function require_directory(what: string, dir: string): void {
  let st: StatInfo = stat_info(dir);
  if (!st.ok) {
    gnu.error(what + " " + gnu.quotea(dir) + ": " + st.err);
    exit(1);
  }
  if (!st.is_dir) {
    gnu.error(what + " " + gnu.quotea(dir) + ": Not a directory");
    exit(1);
  }
}

function option_table(): gnu.Opt[] {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.optional_long("b", "backup", opt_backup()));
  opts = opts.append(gnu.flag("Z", "context", opt_context()));
  opts = opts.append(gnu.flag("", "debug", opt_debug()));
  opts = opts.append(gnu.flag("", "exchange", opt_exchange()));
  opts = opts.append(gnu.flag("f", "force", opt_force()));
  opts = opts.append(gnu.flag("i", "interactive", opt_interactive()));
  opts = opts.append(gnu.flag("n", "no-clobber", opt_no_clobber()));
  opts = opts.append(gnu.flag("", "no-copy", opt_no_copy()));
  opts = opts.append(gnu.flag("T", "no-target-directory", opt_no_target_directory()));
  opts = opts.append(gnu.flag("", "strip-trailing-slashes", opt_strip_trailing_slashes()));
  opts = opts.append(gnu.valued("S", "suffix", opt_suffix()));
  opts = opts.append(gnu.valued("t", "target-directory", opt_target_directory()));
  opts = opts.append(gnu.optional_long("", "update", opt_update()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));
  opts = opts.append(gnu.flag("u", "", opt_update_short()));
  return opts;
}

struct Scan { cfg: Cfg, backup_given: boolean, control_given: boolean, control_text: string, suffix_given: boolean, target_dir: string, have_target_dir: boolean, no_target_dir: boolean }

function scan_options(argv: string[]): (Scan, string[]) {
  let cfg: Cfg = Cfg { ask: ask_yes(), update: update_all(), strip: false, verbose: false, debug: false, exchange: false, backups: false, control: gnu.backup_existing(), suffix: "~", no_copy: false };
  let s: Scan = Scan { cfg: cfg, backup_given: false, control_given: false, control_text: "", suffix_given: false, target_dir: "", have_target_dir: false, no_target_dir: false };
  let g: gnu.Getopt = gnu.getopt_new(argv, option_table(), "mv", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        s = apply_option(s, m);
      },
      None => {
        break;
      }
    }
  }
  return (s, g.operands());
}

function apply_option(s: Scan, m: gnu.OptMatch): Scan {
  let c: Cfg = s.cfg;
  if (m.id == opt_backup()) {
    if (m.has_value) {
      return Scan { ...s, cfg: Cfg { ...c, backups: true }, backup_given: true, control_given: true, control_text: m.value };
    }
    return Scan { ...s, cfg: Cfg { ...c, backups: true }, backup_given: true };
  }
  if (m.id == opt_context()) {
    return s;
  }
  if (m.id == opt_debug()) {
    return Scan { ...s, cfg: Cfg { ...c, verbose: true, debug: true } };
  }
  if (m.id == opt_exchange()) {
    return Scan { ...s, cfg: Cfg { ...c, exchange: true } };
  }
  if (m.id == opt_force()) {
    return Scan { ...s, cfg: Cfg { ...c, ask: ask_yes() } };
  }
  if (m.id == opt_interactive()) {
    return Scan { ...s, cfg: Cfg { ...c, ask: ask_prompt() } };
  }
  if (m.id == opt_no_clobber()) {
    return Scan { ...s, cfg: Cfg { ...c, ask: ask_never() } };
  }
  if (m.id == opt_no_copy()) {
    return Scan { ...s, cfg: Cfg { ...c, no_copy: true } };
  }
  if (m.id == opt_no_target_directory()) {
    return Scan { ...s, no_target_dir: true };
  }
  if (m.id == opt_strip_trailing_slashes()) {
    return Scan { ...s, cfg: Cfg { ...c, strip: true } };
  }
  if (m.id == opt_suffix()) {
    let suf: string = c.suffix;
    if (gnu.usable_suffix(m.value)) {
      suf = m.value;
    }
    return Scan { ...s, cfg: Cfg { ...c, backups: true, suffix: suf }, backup_given: true, suffix_given: true };
  }
  if (m.id == opt_target_directory()) {
    if (s.have_target_dir) {
      gnu.error("multiple target directories specified");
      exit(1);
    }
    return Scan { ...s, target_dir: m.value, have_target_dir: true };
  }
  if (m.id == opt_update()) {
    if (m.has_value) {
      return Scan { ...s, cfg: Cfg { ...c, update: gnu.argmatch_valued(m.value, update_names(), update_values(), "--update") } };
    }
    return Scan { ...s, cfg: Cfg { ...c, update: update_older() } };
  }
  if (m.id == opt_update_short()) {
    return Scan { ...s, cfg: Cfg { ...c, update: update_older() } };
  }
  return Scan { ...s, cfg: Cfg { ...c, verbose: true } };
}

function from_environment(s: Scan): Cfg {
  let c: Cfg = s.cfg;
  if (!c.backups) {
    return c;
  }
  if (!s.suffix_given) {
    match (env("SIMPLE_BACKUP_SUFFIX")) {
      Some(v) => {
        if (gnu.usable_suffix(v)) {
          c = Cfg { ...c, suffix: v };
        }
      },
      None => {}
    }
  }
  let control: i32 = gnu.backup_existing();
  if (s.control_given) {
    if (s.control_text.len() > 0) {
      control = gnu.argmatch_valued(s.control_text, gnu.backup_names(), gnu.backup_values(), "backup type");
    }
  } else {
    match (env("VERSION_CONTROL")) {
      Some(v) => {
        if (v.len() > 0) {
          control = gnu.argmatch_valued(v, gnu.backup_names(), gnu.backup_values(), "$VERSION_CONTROL");
        }
      },
      None => {}
    }
  }
  if (control == gnu.backup_none()) {
    return Cfg { ...c, backups: false, control: control };
  }
  return Cfg { ...c, control: control };
}

pub function main(): i32 {
  let scanned: (Scan, string[]) = scan_options(args());
  let s: Scan = scanned.0;
  let operands: string[] = scanned.1;

  let least: i32 = 2;
  if (s.have_target_dir) {
    least = 1;
  }
  if (operands.len() < least) {
    if (operands.len() == 0) {
      gnu.die_usage("missing file operand", 1);
    }
    gnu.die_usage("missing destination file operand after " + gnu.quotea(operands[0]), 1);
  }
  if (s.have_target_dir && s.no_target_dir) {
    gnu.error("cannot combine --target-directory (-t) and --no-target-directory (-T)");
    return 1;
  }
  let settled: Scan = s;
  if (settled.cfg.ask == ask_never()) {
    settled = Scan { ...settled, cfg: Cfg { ...settled.cfg, update: update_none() } };
  }
  if (settled.backup_given && (settled.cfg.exchange || update_skips(settled.cfg.update))) {
    gnu.die_usage("cannot combine --backup with --exchange, -n, or --update=none-fail", 1);
  }
  let cfg: Cfg = from_environment(settled);

  let o: io_buffered.BufWriter = gnu.out_new();
  if (s.have_target_dir) {
    require_directory("target directory", s.target_dir);
    return finish(move_into(cfg, operands, operands.len(), s.target_dir, o));
  }
  if (s.no_target_dir) {
    if (operands.len() > 2) {
      gnu.die_usage("extra operand " + gnu.quotea(operands[2]), 1);
    }
    return finish(do_move(cfg, pair(cfg, operands[0], operands[1]), false, o));
  }
  if (operands.len() == 2) {
    return finish(do_move(cfg, pair(cfg, operands[0], operands[1]), true, o));
  }
  let dir: string = operands[operands.len() - 1];
  require_directory("target", dir);
  return finish(move_into(cfg, operands, operands.len() - 1, dir, o));
}

function stripped(cfg: Cfg, operand: string): string {
  if (cfg.strip) {
    return gnu.strip_slashes(operand);
  }
  return operand;
}

function pair(cfg: Cfg, src: string, dest: string): Move {
  return Move { raw_src: src, raw_dest: dest, src: stripped(cfg, src), dest: stripped(cfg, dest) };
}

function move_into(cfg: Cfg, operands: string[], count: i32, dir: string, o: io_buffered.BufWriter): MoveOut {
  let w: io_buffered.BufWriter = o;
  let status: i32 = 0;
  let i: i32 = 0;
  while (i < count) {
    let src: string = stripped(cfg, operands[i]);
    let dest: string = gnu.join_path(dir, gnu.base_name(src));
    let r: MoveOut = do_move(cfg, Move { raw_src: src, raw_dest: dest, src: src, dest: dest }, false, w);
    w = r.out;
    if (r.status != 0) {
      status = 1;
    }
    i = i + 1;
  }
  return MoveOut { status: status, out: w };
}

function finish(r: MoveOut): i32 {
  gnu.finish(r.out);
  return r.status;
}
