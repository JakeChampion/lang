import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/bre";

function opt_digits(): i32 {
  return 1;
}

function opt_quiet(): i32 {
  return 2;
}

function opt_keep(): i32 {
  return 3;
}

function opt_elide(): i32 {
  return 4;
}

function opt_prefix(): i32 {
  return 5;
}

function opt_suffix(): i32 {
  return 6;
}

function opt_suppress(): i32 {
  return 7;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... FILE PATTERN...\n";
  out = out + "Split FILE at the points PATTERN names, writing the pieces to 'xx00', 'xx01',\n";
  out = out + "... and the byte count of each piece to standard output.\n";
  out = out + "\n";
  out = out + "With FILE -, read standard input.\n";
  out = out + "\n";
  out = out + "  -b, --suffix-format=FORMAT  name the pieces with FORMAT instead of %02d\n";
  out = out + "  -f, --prefix=PREFIX        begin every piece name with PREFIX instead of 'xx'\n";
  out = out + "  -k, --keep-files           keep the pieces written before an error\n";
  out = out + "      --suppress-matched     drop the line each PATTERN broke at\n";
  out = out + "  -n, --digits=DIGITS        pad the piece number to DIGITS digits\n";
  out = out + "  -s, --quiet, --silent      do not print the byte count of each piece\n";
  out = out + "  -z, --elide-empty-files    remove a piece that came out empty\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "Each PATTERN may be:\n";
  out = out + "  INTEGER            end the piece before that line\n";
  out = out + "  /REGEXP/[OFFSET]   end the piece before the matching line\n";
  out = out + "  %REGEXP%[OFFSET]   the same, but throw the piece away\n";
  out = out + "  {INTEGER}          repeat the pattern before it that many more times\n";
  out = out + "  {*}                repeat the pattern before it while the input lasts\n";
  out = out + "\n";
  out = out + "An OFFSET is a line count, optionally preceded by '+' or '-'.\n";
  return out;
}

struct Fmt { pre: string, post: string, minus: boolean, zero: boolean, alt: boolean, width: i32, prec: i32, conv: i32 }

function default_fmt(digits: i32): Fmt {
  return Fmt { pre: "", post: "", minus: false, zero: true, alt: false, width: digits, prec: 0 - 1, conv: 100 };
}

function fmt_limit(): i64 {
  return 2147483647 as i64;
}

function byte_str(c: i32): string {
  let b: u8[] = [];
  b = b.append(c as u8);
  return string_from_bytes_unchecked(b);
}

function is_conv(c: i32): boolean {
  return c == 100 || c == 105 || c == 117 || c == 111 || c == 120 || c == 88;
}

function conv_base(c: i32): i32 {
  if (c == 111) {
    return 8;
  }
  if (c == 120 || c == 88) {
    return 16;
  }
  return 10;
}

function alt_ok(c: i32): boolean {
  return c == 111 || c == 120 || c == 88;
}

function group_ok(c: i32): boolean {
  return c == 100 || c == 105 || c == 117;
}

function bad_conv(c: i32): void {
  if (c >= 32 && c < 127) {
    gnu.error("invalid conversion specifier in suffix: " + byte_str(c));
    exit(1);
  }
  let d: u8[] = [];
  d = d.append((48 + c / 64) as u8);
  d = d.append((48 + c / 8 % 8) as u8);
  d = d.append((48 + c % 8) as u8);
  gnu.error("invalid conversion specifier in suffix: \\" + string_from_bytes_unchecked(d));
  exit(1);
}

function bad_flags(flag: i32, conv: i32): void {
  gnu.error("invalid flags in conversion specification: %" + byte_str(flag) + byte_str(conv));
  exit(1);
}

function digits_at(s: string, from: i32): (i64, i32) {
  let v: i64 = 0 as i64;
  let i: i32 = from;
  while (i < s.len() && gnu.is_digit(s[i] as i32)) {
    if (v <= fmt_limit()) {
      v = v * (10 as i64) + (s[i] as i32 - 48) as i64;
    }
    i = i + 1;
  }
  return (v, i);
}

function parse_fmt(s: string): Fmt {
  let pre: string = "";
  let i: i32 = 0;
  let found: boolean = false;
  let f: Fmt = default_fmt(0);
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c != 37) {
      let end: i32 = __memchr(s, 37, i);
      if (end < 0) {
        end = s.len();
      }
      let text: string = slice_unchecked(s, i, end) + "";
      if (found) {
        f = Fmt { ...f, post: f.post + text };
      } else {
        pre = pre + text;
      }
      i = end;
      continue;
    }
    if (i + 1 < s.len() && s[i + 1] as i32 == 37) {
      if (found) {
        f = Fmt { ...f, post: f.post + "%" };
      } else {
        pre = pre + "%";
      }
      i = i + 2;
      continue;
    }
    if (found) {
      gnu.error("too many % conversion specifications in suffix");
      exit(1);
    }
    found = true;
    let r: (Fmt, i32) = parse_conv(s, i + 1);
    f = Fmt { ...r.0, pre: pre, post: "" };
    i = r.1;
  }
  if (!found) {
    gnu.error("missing % conversion specification in suffix");
    exit(1);
  }
  return Fmt { ...f, pre: pre };
}

function parse_conv(s: string, from: i32): (Fmt, i32) {
  let minus: boolean = false;
  let zero: boolean = false;
  let alt: boolean = false;
  let group: boolean = false;
  let i: i32 = from;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c == 45) {
      minus = true;
    } else if (c == 48) {
      zero = true;
    } else if (c == 35) {
      alt = true;
    } else if (c == 39) {
      group = true;
    } else {
      break;
    }
    i = i + 1;
  }
  let w: (i64, i32) = digits_at(s, i);
  let width: i64 = w.0;
  i = w.1;
  let prec: i64 = 0 - 1 as i64;
  if (i < s.len() && s[i] as i32 == 46) {
    let p: (i64, i32) = digits_at(s, i + 1);
    prec = p.0;
    i = p.1;
  }
  if (i >= s.len()) {
    gnu.error("missing conversion specifier in suffix");
    exit(1);
  }
  let conv: i32 = s[i] as i32;
  if (!is_conv(conv)) {
    bad_conv(conv);
  }
  if (alt && !alt_ok(conv)) {
    bad_flags(35, conv);
  }
  if (group && !group_ok(conv)) {
    bad_flags(39, conv);
  }
  if (width > fmt_limit() || prec > fmt_limit()) {
    gnu.error("memory exhausted");
    exit(1);
  }
  return (Fmt { pre: "", post: "", minus: minus, zero: zero, alt: alt, width: width as i32, prec: prec as i32, conv: conv }, i + 1);
}

function pad(b: i32, n: i32): string {
  let out: u8[] = [];
  let k: i32 = 0;
  while (k < n) {
    out = out.append(b as u8);
    k = k + 1;
  }
  return string_from_bytes_unchecked(out);
}

function fmt_apply(f: Fmt, n: i32): string {
  let base: i32 = conv_base(f.conv);
  let upper: boolean = f.conv == 88;
  let body: string = "";
  let v: i32 = n;
  while (v > 0) {
    let d: i32 = v % base;
    let c: i32 = 48 + d;
    if (d >= 10) {
      c = 87 + d;
      if (upper) {
        c = 55 + d;
      }
    }
    body = byte_str(c) + body;
    v = v / base;
  }
  if (n == 0 && f.prec != 0) {
    body = "0";
  }
  if (f.prec > body.len()) {
    body = pad(48, f.prec - body.len()) + body;
  }
  let prefix: string = "";
  if (f.alt && base == 8 && (body.len() == 0 || body[0] as i32 != 48)) {
    prefix = "0";
  }
  if (f.alt && base == 16 && n != 0) {
    prefix = "0x";
    if (upper) {
      prefix = "0X";
    }
  }
  let used: i32 = prefix.len() + body.len();
  if (used >= f.width) {
    return f.pre + prefix + body + f.post;
  }
  if (f.minus) {
    return f.pre + prefix + body + pad(32, f.width - used) + f.post;
  }
  if (f.zero && f.prec < 0) {
    return f.pre + prefix + pad(48, f.width - used) + body + f.post;
  }
  return f.pre + pad(32, f.width - used) + prefix + body + f.post;
}

struct Pat { line: boolean, re: bre.Bre, arg: string, num: i64, offset: i64, repeat: i64, forever: boolean, ignore: boolean }

function parse_offset(s: string): (i64, boolean) {
  let i: i32 = 0;
  while (i < s.len() && gnu.is_blank(s[i] as i32)) {
    i = i + 1;
  }
  let neg: boolean = false;
  if (i < s.len() && (s[i] as i32 == 43 || s[i] as i32 == 45)) {
    neg = s[i] as i32 == 45;
    i = i + 1;
  }
  if (i >= s.len() || !gnu.is_digit(s[i] as i32)) {
    return (0 as i64, false);
  }
  let v: i64 = 0 as i64;
  while (i < s.len() && gnu.is_digit(s[i] as i32)) {
    if (v > 922337203685477580 as i64) {
      return (0 as i64, false);
    }
    v = v * (10 as i64) + (s[i] as i32 - 48) as i64;
    if (v < 0 as i64) {
      return (0 as i64, false);
    }
    i = i + 1;
  }
  if (i != s.len()) {
    return (0 as i64, false);
  }
  if (neg) {
    return (0 as i64 - v, true);
  }
  return (v, true);
}

function extract_regexp(a: string): Pat {
  let delim: i32 = a[0] as i32;
  let close: i32 = 0 - 1;
  let i: i32 = a.len() - 1;
  while (i >= 1) {
    if (a[i] as i32 == delim) {
      close = i;
      break;
    }
    i = i - 1;
  }
  if (close < 0) {
    gnu.error(a + ": closing delimiter '" + byte_str(delim) + "' missing");
    exit(1);
  }
  let re: bre.Bre = bre.bre_compile(slice_unchecked(a, 1, close) + "");
  if (re.err.len() > 0) {
    gnu.error(gnu.quote(a) + ": invalid regular expression: " + re.err);
    exit(1);
  }
  let offset: i64 = 0 as i64;
  if (close + 1 < a.len()) {
    let r: (i64, boolean) = parse_offset(slice_unchecked(a, close + 1, a.len()) + "");
    if (!r.1) {
      gnu.error(gnu.quote(a) + ": integer expected after delimiter");
      exit(1);
    }
    offset = r.0;
  }
  return Pat { line: false, re: re, arg: a, num: 0 as i64, offset: offset, repeat: 0 as i64, forever: false, ignore: delim == 37 };
}

function parse_repeat(tok: string, p: Pat): Pat {
  if (tok.len() == 0 || tok[tok.len() - 1] as i32 != 125) {
    gnu.error(gnu.quote(tok) + ": '}' is required in repeat count");
    exit(1);
  }
  let head: string = slice_unchecked(tok, 0, tok.len() - 1) + "";
  let body: string = slice_unchecked(tok, 1, tok.len() - 1) + "";
  if (body == "*") {
    return Pat { ...p, forever: true };
  }
  let r: (u64, i32) = gnu.parse_number(body);
  if (r.1 != 0 || r.0 > 9223372036854775807 as u64) {
    gnu.error(gnu.quote(head) + "}: integer required between '{' and '}'");
    exit(1);
  }
  return Pat { ...p, repeat: r.0 as i64 };
}

function parse_patterns(ops: string[]): Pat[] {
  let pats: Pat[] = [];
  let last: i64 = 0 as i64;
  let i: i32 = 1;
  while (i < ops.len()) {
    let a: string = ops[i];
    let p: Pat = Pat { line: true, re: bre.bre_compile(""), arg: a, num: 0 as i64, offset: 0 as i64, repeat: 0 as i64, forever: false, ignore: false };
    if (a.len() > 0 && (a[0] as i32 == 47 || a[0] as i32 == 37)) {
      p = extract_regexp(a);
    } else {
      let r: (u64, i32) = gnu.parse_number(a);
      if (r.1 != 0 || r.0 > 9223372036854775807 as u64) {
        gnu.error(gnu.quote(a) + ": invalid pattern");
        exit(1);
      }
      let n: i64 = r.0 as i64;
      if (n == 0 as i64) {
        gnu.error(a + ": line number must be greater than zero");
        exit(1);
      }
      if (n < last) {
        gnu.error("line number " + gnu.quote(a) + " is smaller than preceding line number, " + last.to_string());
        exit(1);
      }
      if (n == last) {
        gnu.error("warning: line number " + gnu.quote(a) + " is the same as preceding line number");
      }
      last = n;
      p = Pat { ...p, num: n };
    }
    if (i + 1 < ops.len() && ops[i + 1].len() > 0 && ops[i + 1][0] as i32 == 123) {
      i = i + 1;
      p = parse_repeat(ops[i], p);
    }
    pats = pats.append(p);
    i = i + 1;
  }
  return pats;
}

struct Settings { prefix: string, fmt: Fmt, keep: boolean, elide: boolean, suppress: boolean, quiet: boolean }

function digits_value(s: string): i32 {
  let i: i32 = 0;
  while (i < s.len() && gnu.is_blank(s[i] as i32)) {
    i = i + 1;
  }
  let neg: boolean = false;
  if (i < s.len() && (s[i] as i32 == 43 || s[i] as i32 == 45)) {
    neg = s[i] as i32 == 45;
    i = i + 1;
  }
  let bad: string = "invalid number: " + gnu.quote(s);
  if (i >= s.len() || !gnu.is_digit(s[i] as i32)) {
    gnu.error(bad);
    exit(1);
  }
  let v: i64 = 0 as i64;
  let over: boolean = false;
  while (i < s.len() && gnu.is_digit(s[i] as i32)) {
    if (v > 922337203685477580 as i64) {
      over = true;
    } else {
      v = v * (10 as i64) + (s[i] as i32 - 48) as i64;
      if (v < 0 as i64) {
        over = true;
      }
    }
    i = i + 1;
  }
  if (i != s.len()) {
    gnu.error(bad);
    exit(1);
  }
  if (over) {
    gnu.error(bad + ": " + gnu.eoverflow_text());
    exit(1);
  }
  if (neg && v > 0 as i64) {
    gnu.error(bad + ": " + gnu.eoverflow_text());
    exit(1);
  }
  if (v > 2147483647 as i64) {
    gnu.error(bad + ": " + gnu.eoverflow_text());
    exit(1);
  }
  return v as i32;
}

struct St { r: Reader, buf: u8[], wpos: i32, soff: i32, wline: i64, sline: i64, eof: boolean, back: i64, out: io_buffered.BufWriter, open: boolean, name: string, written: i64, created: i32, so: io_buffered.BufWriter, s: Settings }

function empty_bytes(): u8[] {
  let empty: u8[] = [];
  return empty;
}

function read_size(): i32 {
  return 65536;
}

function drain_bytes(): i32 {
  return 65536;
}

function copy_range(bytes: u8[], lo: i32, hi: i32): u8[] {
  let buf: usize = buf_new(hi - lo);
  buf_push_bytes_range(buf, bytes, lo, hi);
  let result: u8[] = buf_take_bytes(buf);
  buf_free(buf);
  return result;
}

function append_input(bytes: u8[], chunk: u8[]): u8[] {
  if (bytes.len() == 0) {
    return chunk;
  }
  let buf: usize = buf_new(bytes.len() + chunk.len());
  buf_push_bytes_range(buf, bytes, 0, bytes.len());
  buf_push_bytes_range(buf, chunk, 0, chunk.len());
  let result: u8[] = buf_take_bytes(buf);
  buf_free(buf);
  return result;
}

function fill(st: St, complete_line: boolean): St {
  match (st.r.read_chunk_bytes(read_size())) {
    Ok(chunk) => {
      if (chunk.len() == 0) {
        return St { ...st, eof: true };
      }
      if (!complete_line || __memchr_bytes(chunk, 10, 0) >= 0) {
        return St { ...st, buf: append_input(st.buf, chunk) };
      }
      let carry: usize = buf_new(st.buf.len() + chunk.len());
      buf_push_bytes_range(carry, st.buf, 0, st.buf.len());
      buf_push_bytes_range(carry, chunk, 0, chunk.len());
      while (true) {
        match (st.r.read_chunk_bytes(read_size())) {
          Ok(next) => {
            buf_push_bytes_range(carry, next, 0, next.len());
            if (next.len() == 0 || __memchr_bytes(next, 10, 0) >= 0) {
              let result: u8[] = buf_take_bytes(carry);
              buf_free(carry);
              return St { ...st, buf: result, eof: next.len() == 0 };
            }
          },
          Err(e) => {
            buf_free(carry);
            fatal(st, "read error: " + gnu.io_error_text(e));
          }
        }
      }
    },
    Err(e) => {
      fatal(st, "read error: " + gnu.io_error_text(e));
    }
  }
  return st;
}

function line_end(st: St): (i32, St) {
  let s: St = st;
  let from: i32 = s.soff;
  while (true) {
    if (from < s.buf.len()) {
      let j: i32 = __memchr_bytes(s.buf, 10, from);
      if (j >= 0) {
        return (j + 1, s);
      }
      from = s.buf.len();
    }
    if (s.eof) {
      if (s.soff < s.buf.len()) {
        return (s.buf.len(), s);
      }
      return (0 - 1, s);
    }
    s = fill(s, true);
  }
  return (0 - 1, s);
}

function drain(st: St): St {
  if (st.soff - st.wpos < drain_bytes()) {
    return st;
  }
  let keep: i64 = st.sline - st.back;
  if (keep <= st.wline) {
    return st;
  }
  let s: St = release(st, keep, line_start(st, keep));
  return compact(s);
}

function line_start(st: St, n: i64): i32 {
  if (n >= st.sline) {
    return st.soff;
  }
  if (n <= st.wline) {
    return st.wpos;
  }
  let pos: i32 = st.soff - 1;
  let d: i64 = st.sline - n;
  while (d > 0 as i64) {
    pos = __rmemchr_bytes(st.buf, 10, pos - 1);
    d = d - 1 as i64;
  }
  return pos + 1;
}

function release(st: St, n: i64, cut: i32): St {
  if (cut <= st.wpos) {
    return St { ...st, wline: n };
  }
  let s: St = st;
  if (s.open) {
    s = out_put(s, s.wpos, cut);
  }
  return St { ...s, wpos: cut, wline: n };
}

function compact(st: St): St {
  if (st.wpos < drain_bytes() || st.wpos * 2 < st.buf.len()) {
    return st;
  }
  return St { ...st, buf: copy_range(st.buf, st.wpos, st.buf.len()), soff: st.soff - st.wpos, wpos: 0 };
}

function scan_to(st: St, n: i64): (boolean, St) {
  let s: St = st;
  while (s.sline < n) {
    let off: i32 = s.soff;
    let ln: i64 = s.sline;
    while (ln < n) {
      let j: i32 = __memchr_bytes(s.buf, 10, off);
      if (j < 0) {
        break;
      }
      off = j + 1;
      ln = ln + 1;
    }
    s = St { ...s, soff: off, sline: ln };
    if (s.sline >= n) {
      return (true, s);
    }
    if (s.eof) {
      if (s.soff < s.buf.len()) {
        s = St { ...s, soff: s.buf.len(), sline: s.sline + 1 as i64 };
        if (s.sline >= n) {
          return (true, s);
        }
      }
      return (false, s);
    }
    s = fill(drain(s), true);
  }
  return (true, s);
}

function skip_line(st: St): St {
  let r: (boolean, St) = scan_to(st, st.sline + 1 as i64);
  return r.1;
}

function piece_name(st: St): string {
  return st.s.prefix + fmt_apply(st.s.fmt, st.created);
}

function out_open(st: St): St {
  let name: string = piece_name(st);
  match (open_writer(name)) {
    Ok(f) => {
      return St { ...st, out: io_buffered.buf_writer_new(f, read_size()), open: true, name: name, written: 0 as i64, created: st.created + 1 };
    },
    Err(e) => {
      gnu.error(gnu.quotef(name) + ": " + gnu.io_error_text(e));
      cleanup_exit(st);
    }
  }
  return st;
}

function out_put(st: St, lo: i32, hi: i32): St {
  let w: io_buffered.BufWriter = st.out.write_bytes_range(st.buf, lo, hi);
  match (w.error()) {
    Some(e) => {
      gnu.error("write error for " + gnu.quotea(st.name) + ": " + gnu.io_error_text(e));
      cleanup_exit(St { ...st, out: w, open: false });
    },
    None => {}
  }
  return St { ...st, out: w, written: st.written + (hi - lo) as i64 };
}

function out_close(st: St): St {
  if (!st.open) {
    return st;
  }
  let s: St = St { ...st, open: false };
  if let Err(e) = s.out.close() {
    gnu.error(gnu.quotef(s.name) + ": " + gnu.io_error_text(e));
    cleanup_exit(s);
  }
  if (s.written == 0 as i64 && s.s.elide) {
    match (remove_file(s.name)) {
      Ok(_) => {},
      Err(_) => {}
    }
    return St { ...s, created: s.created - 1 };
  }
  if (!s.s.quiet) {
    return St { ...s, so: s.so.write_string(s.written.to_string() + "\n") };
  }
  return s;
}

function delete_all(st: St): void {
  if (st.s.keep) {
    return;
  }
  let i: i32 = 0;
  while (i < st.created) {
    match (remove_file(st.s.prefix + fmt_apply(st.s.fmt, i))) {
      Ok(_) => {},
      Err(_) => {}
    }
    i = i + 1;
  }
}

function dump_rest(st: St): St {
  let s: St = st;
  while (true) {
    if (s.wpos < s.buf.len()) {
      if (s.open) {
        s = out_put(s, s.wpos, s.buf.len());
      }
      s = St { ...s, buf: empty_bytes(), wpos: 0, soff: 0 };
    }
    if (s.eof) {
      return s;
    }
    s = fill(s, false);
  }
  return s;
}

function cleanup_exit(st: St): void {
  let s: St = out_close(st);
  delete_all(s);
  gnu.finish(s.so);
  exit(1);
}

function fatal(st: St, msg: string): void {
  gnu.error(msg);
  cleanup_exit(st);
}

function fatal_dump(st: St, msg: string): void {
  gnu.error(msg);
  cleanup_exit(dump_rest(st));
}

function repetition_suffix(rep: i64): string {
  if (rep == 0 as i64) {
    return "";
  }
  return " on repetition " + rep.to_string();
}

function run_line(st: St, p: Pat, rep: i64): St {
  let s: St = out_open(st);
  let out_of_range: string = gnu.quote(p.num.to_string()) + ": line number out of range" + repetition_suffix(rep);
  let target: i64 = p.num * (rep + 1 as i64);
  if (target / (rep + 1 as i64) != p.num) {
    fatal_dump(s, out_of_range);
  }
  let h: (boolean, St) = head_empty(s);
  s = h.1;
  if (h.0) {
    fatal(s, out_of_range);
  }
  if (target > s.sline) {
    let r: (boolean, St) = scan_to(s, target);
    s = r.1;
    if (!r.0) {
      fatal_dump(s, out_of_range);
    }
  }
  if (target > s.wline) {
    s = release(s, target, line_start(s, target));
  }
  let e: (boolean, St) = head_empty(s);
  s = e.1;
  if (e.0) {
    fatal_dump(s, out_of_range);
  }
  s = out_close(s);
  return suppress_line(compact(s));
}

function head_empty(st: St): (boolean, St) {
  let s: St = st;
  while (s.wpos >= s.buf.len()) {
    if (s.eof) {
      return (true, s);
    }
    s = fill(s, false);
  }
  return (false, s);
}

function suppress_line(st: St): St {
  if (!st.s.suppress) {
    return st;
  }
  if (st.wline < st.sline) {
    let j: i32 = __memchr_bytes(st.buf, 10, st.wpos);
    let end: i32 = st.buf.len();
    if (j >= 0) {
      end = j + 1;
    }
    return compact(St { ...st, wpos: end, wline: st.wline + 1 as i64 });
  }
  let r: (i32, St) = line_end(st);
  let s: St = r.1;
  if (r.0 < 0) {
    return s;
  }
  return compact(St { ...s, soff: r.0, sline: s.sline + 1 as i64, wpos: r.0, wline: s.wline + 1 as i64 });
}

function run_regexp(st: St, p: Pat, rep: i64): St {
  let s: St = st;
  if (!p.ignore) {
    s = out_open(s);
  }
  let r: (boolean, St) = find_match(s, p);
  s = r.1;
  if (!r.0) {
    if (p.forever) {
      if (!p.ignore) {
        s = out_close(dump_rest(s));
      }
      gnu.finish(s.so);
      exit(0);
    }
    if (p.ignore) {
      fatal(s, gnu.quote(p.arg) + ": match not found" + repetition_suffix(rep));
    }
    fatal_dump(s, gnu.quote(p.arg) + ": match not found" + repetition_suffix(rep));
  }
  let matched: i64 = s.sline;
  let target: i64 = matched + p.offset;
  if (target < s.wline) {
    fatal(s, gnu.quote(p.arg) + ": line number out of range");
  }
  if (target > matched) {
    let f: (boolean, St) = scan_to(s, target);
    s = f.1;
    if (!f.0) {
      fatal_dump(s, gnu.quote(p.arg) + ": line number out of range");
    }
  }
  s = release(s, target, line_start(s, target));
  s = out_close(s);
  return suppress_line(skip_line(compact(s)));
}

function find_match(st: St, p: Pat): (boolean, St) {
  let s: St = st;
  while (true) {
    let off: i32 = s.soff;
    let ln: i64 = s.sline;
    while (true) {
      let j: i32 = __memchr_bytes(s.buf, 10, off);
      if (j < 0) {
        break;
      }
      if (p.re.search_range_bytes(s.buf, off, j)) {
        return (true, St { ...s, soff: off, sline: ln });
      }
      off = j + 1;
      ln = ln + 1;
    }
    s = St { ...s, soff: off, sline: ln };
    if (s.eof) {
      if (s.soff < s.buf.len()) {
        if (p.re.search_range_bytes(s.buf, s.soff, s.buf.len())) {
          return (true, s);
        }
        s = St { ...s, soff: s.buf.len(), sline: s.sline + 1 as i64 };
      }
      return (false, s);
    }
    s = fill(drain(s), true);
  }
  return (false, s);
}

function run_pattern(st: St, p: Pat, rep: i64): St {
  if (p.line) {
    return run_line(st, p, rep);
  }
  return run_regexp(st, p, rep);
}

function open_input(path: string): Reader {
  if (path == "-") {
    return stdin();
  }
  match (open_reader(path)) {
    Ok(f) => {
      return f;
    },
    Err(e) => {
      gnu.error("cannot open " + gnu.quotea(path) + " for reading: " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return stdin();
}

function max_back(pats: Pat[]): i64 {
  let back: i64 = 0 as i64;
  let i: i32 = 0;
  while (i < pats.len()) {
    let p: Pat = pats[i];
    if (!p.line && p.offset < 0 as i64 && 0 as i64 - p.offset > back) {
      back = 0 as i64 - p.offset;
    }
    i = i + 1;
  }
  return back;
}

pub function main(): i32 {
  let argv: string[] = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("n", "digits", opt_digits()));
  opts = opts.append(gnu.flag("q", "quiet", opt_quiet()));
  opts = opts.append(gnu.flag("s", "silent", opt_quiet()));
  opts = opts.append(gnu.flag("k", "keep-files", opt_keep()));
  opts = opts.append(gnu.flag("z", "elide-empty-files", opt_elide()));
  opts = opts.append(gnu.valued("f", "prefix", opt_prefix()));
  opts = opts.append(gnu.valued("b", "suffix-format", opt_suffix()));
  opts = opts.append(gnu.flag("", "suppress-matched", opt_suppress()));

  let prefix: string = "xx";
  let digits: i32 = 2;
  let format: string = "";
  let has_format: boolean = false;
  let keep: boolean = false;
  let elide: boolean = false;
  let suppress: boolean = false;
  let quiet: boolean = false;

  let g: gnu.Getopt = gnu.getopt_new(argv, opts, "csplit", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_digits()) {
          digits = digits_value(m.value);
        } else if (m.id == opt_quiet()) {
          quiet = true;
        } else if (m.id == opt_keep()) {
          keep = true;
        } else if (m.id == opt_elide()) {
          elide = true;
        } else if (m.id == opt_prefix()) {
          prefix = m.value;
        } else if (m.id == opt_suffix()) {
          format = m.value;
          has_format = true;
        } else if (m.id == opt_suppress()) {
          suppress = true;
        }
      },
      None => {
        break;
      }
    }
  }

  let ops: string[] = g.operands();
  if (ops.len() == 0) {
    gnu.die_usage("missing operand", 1);
  }
  if (ops.len() == 1) {
    gnu.die_usage("missing operand after " + gnu.quote(ops[0]), 1);
  }
  let fmt: Fmt = default_fmt(digits);
  if (has_format) {
    fmt = parse_fmt(format);
  }
  let r0: Reader = open_input(ops[0]);
  let pats: Pat[] = parse_patterns(ops);
  let settings: Settings = Settings { prefix: prefix, fmt: fmt, keep: keep, elide: elide, suppress: suppress, quiet: quiet };

  let so: io_buffered.BufWriter = gnu.out_new();
  let st: St = St { r: r0, buf: empty_bytes(), wpos: 0, soff: 0, wline: 1 as i64, sline: 1 as i64, eof: false, back: max_back(pats), out: so, open: false, name: "", written: 0 as i64, created: 0, so: so, s: settings };

  let i: i32 = 0;
  while (i < pats.len()) {
    let p: Pat = pats[i];
    let rep: i64 = 0 as i64;
    while (p.forever || rep <= p.repeat) {
      st = run_pattern(st, p, rep);
      rep = rep + 1 as i64;
    }
    i = i + 1;
  }
  st = out_close(dump_rest(out_open(st)));
  gnu.finish(st.so);
  return 0;
}
