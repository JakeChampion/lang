// tsort.fern — GNU-compatible `tsort`.
//
//   [FILE]   whitespace-separated pairs of names; `-` or nothing is stdin
//
// Each pair `a b` says a comes before b; a pair naming one thing twice
// only declares it. The order written is GNU's exactly, which is a
// particular algorithm rather than "a topological order":
//
//   - the names nothing precedes come out in byte order, and each name
//     written frees the names it precedes, most recently declared
//     first, onto the back of that queue (Knuth's algorithm T);
//   - when the queue drains with names left, the input has a loop. It
//     is found by walking PREDECESSORS in byte order: the smallest
//     unresolved name seeds a chain, each pass over the names pushes
//     every one that precedes the chain's head, and a name pushed a
//     second time closes the loop, which is reported from the head
//     down to it. The edge closing it is dropped and the queue resumes.
//     The seed is not marked when it seeds, so it too can be pushed a
//     second time — that is why `a b b c c a` reports `a b c` and not
//     `b c a`.
//
// Tokens are separated by space, tab and newline only, and are cut at
// a NUL the way a C string is. An odd token count is an error before
// anything is written; a loop is reported on stderr while the order is
// still written, and the exit status is then 1.
import "std/string";
import "std/array";
import "std/io";
import "std/io_buffered";
import "core/cmp";
import "core/map";
import "./lib/gnu";

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION] [FILE]\n";
  out = out + "Write totally ordered list consistent with the partial ordering in FILE.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "      --help     display this help and exit\n";
  out = out + "      --version  output version information and exit\n";
  return out;
}

function is_separator(b: i32): boolean {
  return b == 32 || b == 9 || b == 10;
}

// A name retains a span of the raw input. Equality, hashing and ordering
// inspect bytes; neither invalid UTF-8 nor NUL suffixes become text.
struct Name { data: u8[], lo: i32, hi: i32, id: i32 }

impl cmp.Eq for Name {
  function eq(self: Name, other: Name): boolean {
    if (self.hi - self.lo != other.hi - other.lo) {
      return false;
    }
    var i: i32 = 0;
    while (i < self.hi - self.lo) {
      if (self.data[self.lo + i] != other.data[other.lo + i]) {
        return false;
      }
      i = i + 1;
    }
    return true;
  }
}

impl cmp.Ord for Name {
  function cmp(self: Name, other: Name): i32 {
    var i: i32 = 0;
    var n: i32 = self.hi - self.lo;
    var m: i32 = other.hi - other.lo;
    while (i < n && i < m) {
      var a: u8 = self.data[self.lo + i];
      var b: u8 = other.data[other.lo + i];
      if (a < b) {
        return -1;
      }
      if (a > b) {
        return 1;
      }
      i = i + 1;
    }
    if (n < m) {
      return -1;
    }
    if (n > m) {
      return 1;
    }
    return 0;
  }
}

// Intern names in first-appearance order. The integer map indexes hash
// buckets; a collision chain compares complete spans before reusing an ID.
// This uses the native hash-table path as well as the WASM hash table.
function intern(text: u8[]): (Name[], i32[]) {
  var names: Name[] = [];
  var ids: i32[] = [];
  var index: Map[i32, i32] = map_new(1024);
  var next: i32[] = [];
  var i: i32 = 0;
  while (i < text.len()) {
    if (is_separator(text[i] as i32)) {
      i = i + 1;
      continue;
    }
    var j: i32 = i;
    var end: i32 = -1;
    var hash: u32 = 2166136261 as u32;
    while (j < text.len() && !is_separator(text[j] as i32)) {
      if (end < 0) {
        if (text[j] == 0 as u8) {
          end = j;
        } else {
          hash = (hash ^ text[j] as u32) * (16777619 as u32);
        }
      }
      j = j + 1;
    }
    if (end < 0) {
      end = j;
    }
    var name: Name = Name { data: text, lo: i, hi: end, id: names.len() };
    var first: i32 = index.get_or(hash as i32, -1);
    var found: i32 = first;
    while (found >= 0 && !names[found].eq(name)) {
      found = next[found];
    }
    if (found >= 0) {
      ids = ids.append(found);
    } else {
      index = index.insert(hash as i32, names.len());
      next = next.append(first);
      ids = ids.append(names.len());
      names = names.append(name);
    }
    i = j;
  }
  return (names, ids);
}

// The indices of names in unsigned byte order.
function byte_order(names: Name[]): i32[] {
  var order: i32[] = [];
  var sorted: Name[] = cmp.sort(names);
  for name in sorted {
    order = order.append(name.id);
  }
  return order;
}

function put_name(out: io_buffered.BufWriter, name: Name): io_buffered.BufWriter {
  buf_push_bytes_range(out.handle(), name.data, name.lo, name.hi);
  buf_push_byte(out.handle(), 10);
  return out.settle();
}

function error_name(name: Name): void {
  var b: usize = buf_new(name.hi - name.lo + 32);
  buf_push(b, gnu.prog() + ": ");
  buf_push_bytes_range(b, name.data, name.lo, name.hi);
  buf_push_byte(b, 10);
  stderr().write_bytes(buf_take_bytes(b));
  buf_free(b);
}

// The graph and both phases live in one function so every array is a
// local the `.with` updates can take in place.
function run(text: u8[], fname: string): i32 {
  var interned: (Name[], i32[]) = intern(text);
  var names: Name[] = interned.0;
  var ids: i32[] = interned.1;
  if (ids.len() % 2 == 1) {
    gnu.error(fname + ": input contains an odd number of tokens");
    return 1;
  }
  var n: i32 = names.len();

  // Successor lists: `head[v]` is v's most recent edge, `edge_next`
  // threads back through the earlier ones.
  var count: i32[] = [];
  var head: i32[] = [];
  var chain_next: i32[] = [];
  var inchain: i32[] = [];
  var v: i32 = 0;
  while (v < n) {
    count = count.append(0);
    head = head.append(0 - 1);
    chain_next = chain_next.append(0 - 1);
    inchain = inchain.append(0);
    v = v + 1;
  }
  var edge_to: i32[] = [];
  var edge_next: i32[] = [];
  var t: i32 = 0;
  while (t < ids.len()) {
    var a: i32 = ids[t];
    var b: i32 = ids[t + 1];
    if (a != b) {
      edge_to = edge_to.append(b);
      edge_next = edge_next.append(head[a]);
      head = head.with(a, edge_to.len() - 1);
      count = count.with(b, count[b] + 1);
    }
    t = t + 2;
  }

  // Only the seeds need sorting for the queue; the byte order of every
  // name is built the first time a loop has to be found.
  var seeds: Name[] = [];
  v = 0;
  while (v < n) {
    if (count[v] == 0) {
      seeds = seeds.append(names[v]);
    }
    v = v + 1;
  }
  var sorted_seeds: Name[] = cmp.sort(seeds);
  var queue: i32[] = [];
  var qh: i32 = 0;
  var s: i32 = 0;
  while (s < sorted_seeds.len()) {
    queue = queue.append(sorted_seeds[s].id);
    s = s + 1;
  }
  var order: i32[] = [];

  var remaining: i32 = n;
  var status: i32 = 0;
  var o: io_buffered.BufWriter = gnu.out_new();
  while (remaining > 0) {
    while (qh < queue.len()) {
      var w: i32 = queue[qh];
      qh = qh + 1;
      o = put_name(o, names[w]);
      remaining = remaining - 1;
      var e: i32 = head[w];
      while (e >= 0) {
        var to: i32 = edge_to[e];
        count = count.with(to, count[to] - 1);
        if (count[to] == 0) {
          queue = queue.append(to);
        }
        e = edge_next[e];
      }
    }
    if (remaining == 0) {
      break;
    }

    status = 1;
    gnu.error(fname + ": input contains a loop:");
    if (order.len() == 0) {
      order = byte_order(names);
    }
    var chain_head: i32 = 0 - 1;
    var found: boolean = false;
    while (!found) {
      var k: i32 = 0;
      while (k < n && !found) {
        var node: i32 = order[k];
        k = k + 1;
        if (count[node] == 0) {
          continue;
        }
        if (chain_head < 0) {
          chain_head = node;
          continue;
        }
        var e2: i32 = head[node];
        var prev: i32 = 0 - 1;
        while (e2 >= 0 && edge_to[e2] != chain_head) {
          prev = e2;
          e2 = edge_next[e2];
        }
        if (e2 < 0) {
          continue;
        }
        if (inchain[node] == 0) {
          chain_next = chain_next.with(node, chain_head);
          inchain = inchain.with(node, 1);
          chain_head = node;
          continue;
        }
        var c: i32 = chain_head;
        while (true) {
          error_name(names[c]);
          if (c == node) {
            break;
          }
          c = chain_next[c];
        }
        if (prev < 0) {
          head = head.with(node, edge_next[e2]);
        } else {
          edge_next = edge_next.with(prev, edge_next[e2]);
        }
        count = count.with(chain_head, count[chain_head] - 1);
        if (count[chain_head] == 0) {
          queue = queue.append(chain_head);
        }
        found = true;
      }
    }
    // The chain's links may form a cycle once the seed is pushed
    // twice; clearing each link as it is followed ends the walk.
    var c2: i32 = chain_head;
    while (c2 >= 0) {
      var nx: i32 = chain_next[c2];
      chain_next = chain_next.with(c2, 0 - 1);
      inchain = inchain.with(c2, 0);
      c2 = nx;
    }
  }
  gnu.finish(o);
  return status;
}

pub function main(): i32 {
  var argv: string[] = args();
  var operands: string[] = gnu.parse_standard_options_only(argv, "tsort", help_text(), 1);
  if (operands.len() > 1) {
    gnu.die_usage("extra operand " + gnu.quote(operands[1]), 1);
  }
  var path: string = "-";
  if (operands.len() == 1) {
    path = operands[0];
  }
  var text: u8[] = [];
  if (path == "-") {
    match (io.read_all_stdin_bytes()) {
      Ok(t) => {
        text = t;
      },
      Err(e) => {
        gnu.error(gnu.quotef(path) + ": read error: " + gnu.io_error_text(e));
        exit(1);
      }
    }
  } else {
    // GNU words an open failure and a read failure differently
    // (`tsort: d: read error: Is a directory` for a directory, whose
    // read-only open succeeds), so open first to tell them apart.
    match (open_reader(path)) {
      Ok(r) => {
        r.close();
      },
      Err(e) => {
        gnu.error(gnu.quotef(path) + ": " + gnu.io_error_text(e));
        exit(1);
      }
    }
    match (read_file_bytes(path)) {
      Ok(t) => {
        text = t;
      },
      Err(e) => {
        gnu.error(gnu.quotef(path) + ": read error: " + gnu.io_error_text(e));
        exit(1);
      }
    }
  }
  return run(text, gnu.quotef(path));
}
