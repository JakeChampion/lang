import "std/string";
import "std/array";
import "std/i64";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/bre";

function opt_header(): i32 {
  return 1;
}

function opt_body(): i32 {
  return 2;
}

function opt_footer(): i32 {
  return 3;
}

function opt_start(): i32 {
  return 4;
}

function opt_incr(): i32 {
  return 5;
}

function opt_norenumber(): i32 {
  return 6;
}

function opt_join(): i32 {
  return 7;
}

function opt_sep(): i32 {
  return 8;
}

function opt_width(): i32 {
  return 9;
}

function opt_format(): i32 {
  return 10;
}

function opt_delim(): i32 {
  return 11;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Write each FILE to standard output, with line numbers added.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "Mandatory arguments to long options are mandatory for short options too.\n";
  out = out + "  -b, --body-numbering=STYLE      use STYLE for numbering body lines\n";
  out = out + "  -d, --section-delimiter=CC      use CC for logical page delimiters\n";
  out = out + "  -f, --footer-numbering=STYLE    use STYLE for numbering footer lines\n";
  out = out + "  -h, --header-numbering=STYLE    use STYLE for numbering header lines\n";
  out = out + "  -i, --line-increment=NUMBER     line number increment at each line\n";
  out = out + "  -l, --join-blank-lines=NUMBER   group of NUMBER empty lines counted as one\n";
  out = out + "  -n, --number-format=FORMAT      insert line numbers according to FORMAT\n";
  out = out + "  -p, --no-renumber               do not reset line numbers for each section\n";
  out = out + "  -s, --number-separator=STRING   add STRING after (possible) line number\n";
  out = out + "  -v, --starting-line-number=NUMBER  first line number for each section\n";
  out = out + "  -w, --number-width=NUMBER       use NUMBER columns for line numbers\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "Default options are: -bt -d'\\:' -fn -hn -i1 -l1 -n'rn' -s<TAB> -v1 -w6\n";
  out = out + "\n";
  out = out + "CC are two delimiter characters used to construct logical page delimiters;\n";
  out = out + "a missing second character implies ':'.  As a GNU extension one can specify\n";
  out = out + "more than two characters, and also specifying the empty string (-d '')\n";
  out = out + "disables section matching.\n";
  out = out + "\n";
  out = out + "STYLE is one of:\n";
  out = out + "\n";
  out = out + "  a      number all lines\n";
  out = out + "  t      number only nonempty lines\n";
  out = out + "  n      number no lines\n";
  out = out + "  pBRE   number only lines that contain a match for the basic regular\n";
  out = out + "         expression, BRE\n";
  out = out + "\n";
  out = out + "FORMAT is one of:\n";
  out = out + "\n";
  out = out + "  ln     left justified, no leading zeros\n";
  out = out + "  rn     right justified, no leading zeros\n";
  out = out + "  rz     right justified, leading zeros\n";
  return out;
}

function style_all(): i32 {
  return 0;
}

function style_nonempty(): i32 {
  return 1;
}

function style_none(): i32 {
  return 2;
}

function style_regex(): i32 {
  return 3;
}

struct Style { kind: i32, re: bre.Bre }

function empty_style(kind: i32): Style {
  return Style { kind: kind, re: bre.bre_compile("") };
}

function parse_style(arg: string, what: string): Style {
  let c: i32 = 0;
  if (arg.len() > 0) {
    c = arg[0] as i32;
  }
  if (c == 97) {
    return empty_style(style_all());
  }
  if (c == 116) {
    return empty_style(style_nonempty());
  }
  if (c == 110) {
    return empty_style(style_none());
  }
  if (c == 112) {
    let re: bre.Bre = bre.bre_compile(slice_unchecked(arg, 1, arg.len()) + "");
    if (re.err.len() > 0) {
      gnu.error(re.err);
      exit(1);
    }
    return Style { kind: style_regex(), re: re };
  }
  gnu.die_usage("invalid " + what + " numbering style: " + gnu.quote(arg), 1);
  return empty_style(style_none());
}

function fmt_ln(): i32 {
  return 0;
}

function fmt_rn(): i32 {
  return 1;
}

function fmt_rz(): i32 {
  return 2;
}

function parse_imax(s: string): (i64, i32) {
  let i: i32 = 0;
  while (i < s.len() && gnu.is_blank(s[i] as i32)) {
    i = i + 1;
  }
  let neg: boolean = false;
  if (i < s.len() && (s[i] as i32 == 43 || s[i] as i32 == 45)) {
    neg = s[i] as i32 == 45;
    i = i + 1;
  }
  if (i >= s.len() || !gnu.is_digit(s[i] as i32)) {
    return (0 as i64, 1);
  }
  let mag: u64 = 0 as u64;
  let over: boolean = false;
  let limit: u64 = 9223372036854775807 as u64;
  if (neg) {
    limit = 9223372036854775808 as u64;
  }
  while (i < s.len() && gnu.is_digit(s[i] as i32)) {
    let d: u64 = (s[i] as i32 - 48) as u64;
    match (mag.checked_mul(10 as u64)) {
      Some(m) => {
        match (m.checked_add(d)) {
          Some(a) => {
            mag = a;
          },
          None => {
            over = true;
          }
        }
      },
      None => {
        over = true;
      }
    }
    if (mag > limit) {
      over = true;
    }
    i = i + 1;
  }
  if (i != s.len()) {
    return (0 as i64, 1);
  }
  if (over) {
    if (neg) {
      return (0 as i64 - 9223372036854775807 as i64 - 1 as i64, 2);
    }
    return (9223372036854775807 as i64, 2);
  }
  if (neg) {
    if (mag == 9223372036854775808 as u64) {
      return (0 as i64 - 9223372036854775807 as i64 - 1 as i64, 0);
    }
    return (0 as i64 - mag as i64, 0);
  }
  return (mag as i64, 0);
}

function number_option(value: string, what: string, min: i64, max: i64, min_range: boolean, max_quiet: boolean): i64 {
  let r: (i64, i32) = parse_imax(value);
  if (r.1 == 1) {
    gnu.error("invalid " + what + ": " + gnu.quote(value));
    exit(1);
  }
  let out: i64 = r.0;
  let range: boolean = false;
  let bad: boolean = r.1 == 2;
  if (r.0 < min) {
    out = min;
    range = min_range;
    bad = true;
  } else if (r.0 > max) {
    out = max;
    bad = true;
  }
  if (!bad || r.0 >= 0 as i64 && max_quiet) {
    return out;
  }
  if (range) {
    gnu.error("invalid " + what + ": " + gnu.quote(value) + ": " + gnu.erange_text());
    exit(1);
  }
  gnu.error("invalid " + what + ": " + gnu.quote(value) + ": " + gnu.eoverflow_text());
  exit(1);
  return out;
}

struct Opts {
  header: Style,
  body: Style,
  footer: Style,
  sep: string,
  fmt: i32,
  width: i32,
  start: i64,
  incr: i64,
  join_blank: i64,
  renumber: boolean,
  del1: u8[],
  del2: u8[],
  del3: u8[],
  pad: string,
  zeros: string,
  blank: string,
}

function spaces(n: i32): string {
  return " ".repeat(n);
}

function with_pads(o: Opts): Opts {
  return Opts { ...o, pad: spaces(o.width), zeros: "0".repeat(o.width), blank: spaces(o.width + o.sep.len()) };
}

function push_lineno(h: usize, n: i64, o: Opts): void {
  let mag: u64 = n as u64;
  if (n < 0 as i64) {
    mag = 0 as u64 - mag;
  }
  let len: i32 = io_buffered.buf_u64_len(mag);
  if (n < 0 as i64) {
    len = len + 1;
  }
  if (len >= o.width) {
    io_buffered.buf_push_i64(h, n);
    return;
  }
  let need: i32 = o.width - len;
  if (o.fmt == fmt_ln()) {
    io_buffered.buf_push_i64(h, n);
    buf_push_range(h, o.pad, 0, need);
    return;
  }
  if (o.fmt == fmt_rn()) {
    buf_push_range(h, o.pad, 0, need);
    io_buffered.buf_push_i64(h, n);
    return;
  }
  if (n < 0 as i64) {
    buf_push_byte(h, 45);
    buf_push_range(h, o.zeros, 0, need);
    io_buffered.buf_push_u64(h, mag);
    return;
  }
  buf_push_range(h, o.zeros, 0, need);
  io_buffered.buf_push_u64(h, mag);
}

struct State { section: i32, line_no: i64, blanks: i64, over: boolean, status: i32 }

function section_header(): i32 {
  return 0;
}

function section_body(): i32 {
  return 1;
}

function section_footer(): i32 {
  return 2;
}

function kind_of(s: State, o: Opts): i32 {
  if (s.section == section_header()) {
    return o.header.kind;
  }
  if (s.section == section_footer()) {
    return o.footer.kind;
  }
  return o.body.kind;
}

function check_section(buf: u8[], lo: i32, hi: i32, o: Opts): i32 {
  if (o.del1.len() == 0 || hi == lo || buf[lo] as i32 != o.del1[0] as i32) {
    return 0 - 1;
  }
  if (span_is(buf, lo, hi, o.del3)) {
    return section_header();
  }
  if (span_is(buf, lo, hi, o.del2)) {
    return section_body();
  }
  if (span_is(buf, lo, hi, o.del1)) {
    return section_footer();
  }
  return 0 - 1;
}

function span_is(buf: u8[], lo: i32, hi: i32, s: u8[]): boolean {
  let n: i32 = hi - lo;
  return n == s.len() && __mismatch_bytes(buf, lo, s, 0, n) == n;
}

function numbered(buf: u8[], lo: i32, hi: i32, st: State, sty: Style, o: Opts): (boolean, i64) {
  if (sty.kind == style_none()) {
    return (false, st.blanks);
  }
  if (sty.kind == style_nonempty()) {
    return (hi > lo, st.blanks);
  }
  if (sty.kind == style_regex()) {
    return (sty.re.search_range_bytes(buf, lo, hi), st.blanks);
  }
  if (o.join_blank <= 1 as i64) {
    return (true, st.blanks);
  }
  if (hi > lo) {
    return (true, 0 as i64);
  }
  let run: i64 = st.blanks + 1 as i64;
  if (run == o.join_blank) {
    return (true, 0 as i64);
  }
  return (false, run);
}

function numbered_here(buf: u8[], lo: i32, hi: i32, st: State, o: Opts): (boolean, i64) {
  if (st.section == section_header()) {
    return numbered(buf, lo, hi, st, o.header, o);
  }
  if (st.section == section_footer()) {
    return numbered(buf, lo, hi, st, o.footer, o);
  }
  return numbered(buf, lo, hi, st, o.body, o);
}

struct Emit { st: State, w: io_buffered.BufWriter }

function proc_line(buf: u8[], lo: i32, hi: i32, st0: State, o: Opts, w0: io_buffered.BufWriter): Emit {
  let st: State = st0;
  let w: io_buffered.BufWriter = w0;
  let sec: i32 = check_section(buf, lo, hi, o);
  if (sec >= 0) {
    let next: State = State { ...st, section: sec, blanks: 0 as i64 };
    if (o.renumber) {
      next = State { ...next, line_no: o.start, over: false };
    }
    return Emit { st: next, w: gnu.put(w, "\n") };
  }
  let r: (boolean, i64) = numbered_here(buf, lo, hi, st, o);
  st = State { ...st, blanks: r.1 };
  if (!r.0) {
    let hb: usize = w.handle();
    buf_push(hb, o.blank);
    buf_push_bytes_range(hb, buf, lo, hi);
    buf_push_byte(hb, 10);
    return Emit { st: st, w: gnu.settle(w) };
  }
  if (st.over) {
    w = gnu.flush(w);
    gnu.error("line number overflow");
    exit(1);
  }
  let h: usize = w.handle();
  push_lineno(h, st.line_no, o);
  buf_push(h, o.sep);
  buf_push_bytes_range(h, buf, lo, hi);
  buf_push_byte(h, 10);
  w = gnu.settle(w);
  match (st.line_no.checked_add(o.incr)) {
    Some(v) => {
      st = State { ...st, line_no: v };
    },
    None => {
      st = State { ...st, over: true };
    }
  }
  return Emit { st: st, w: w };
}

function fast_style(kind: i32, o: Opts): boolean {
  if (kind == style_all()) {
    return o.join_blank <= 1 as i64;
  }
  return true;
}

function matches_here(buf: u8[], lo: i32, hi: i32, st: State, o: Opts): boolean {
  if (st.section == section_header()) {
    return o.header.re.search_range_bytes(buf, lo, hi);
  }
  if (st.section == section_footer()) {
    return o.footer.re.search_range_bytes(buf, lo, hi);
  }
  return o.body.re.search_range_bytes(buf, lo, hi);
}

struct Field { q: i64, head: string, tail: string }

function field_for(q: i64, o: Opts): Field {
  let digits: string = q.to_string();
  let need: i32 = o.width - digits.len() - 2;
  if (need < 0) {
    need = 0;
  }
  if (o.fmt == fmt_ln()) {
    return Field { q: q, head: digits, tail: slice_unchecked(o.pad, 0, need) + o.sep };
  }
  if (o.fmt == fmt_rz()) {
    return Field { q: q, head: slice_unchecked(o.zeros, 0, need) + digits, tail: o.sep };
  }
  return Field { q: q, head: slice_unchecked(o.pad, 0, need) + digits, tail: o.sep };
}

function next_line_no(n: i64, incr: i64): (boolean, i64) {
  if (incr >= 0 as i64) {
    if (n > 9223372036854775807 as i64 - incr) {
      return (false, n);
    }
  } else if (n < 0 as i64 - 9223372036854775807 as i64 - 1 as i64 - incr) {
    return (false, n);
  }
  return (true, n + incr);
}

function fast_lines(buf: u8[], pos0: i32, st: State, o: Opts, w0: io_buffered.BufWriter): (i32, State, io_buffered.BufWriter) {
  let w: io_buffered.BufWriter = w0;
  let h: usize = w.handle();
  let kind: i32 = kind_of(st, o);
  if (!fast_style(kind, o) || st.over) {
    return (pos0, st, w);
  }
  let d0: i32 = 0 - 1;
  if (o.del1.len() > 0) {
    d0 = o.del1[0] as i32;
  }
  let line_no: i64 = st.line_no;
  let incr: i64 = o.incr;
  let field: Field = Field { q: 0 as i64, head: "", tail: "" };
  let base: i64 = 0 as i64;
  let pos: i32 = pos0;
  while (true) {
    let j: i32 = __memchr_bytes(buf, 10, pos);
    if (j < 0 || j > pos && buf[pos] as i32 == d0) {
      break;
    }
    if (kind == style_none() || kind == style_nonempty() && j == pos || kind == style_regex() && !matches_here(buf, pos, j, st, o)) {
      buf_push(h, o.blank);
    } else {
      let nx: (boolean, i64) = next_line_no(line_no, incr);
      if (!nx.0) {
        break;
      }
      if (line_no < 100 as i64) {
        push_lineno(h, line_no, o);
        buf_push(h, o.sep);
      } else {
        if (field.q == 0 as i64 || line_no < base || line_no >= base + 100 as i64) {
          field = field_for(line_no / (100 as i64), o);
          base = field.q * (100 as i64);
        }
        buf_push(h, field.head);
        let r: i32 = (line_no - base) as i32 * 2;
        buf_push_range(h, io_buffered.digit_pairs(), r, r + 2);
        buf_push(h, field.tail);
      }
      line_no = nx.1;
    }
    buf_push_bytes_range(h, buf, pos, j + 1);
    pos = j + 1;
  }
  return (pos, State { ...st, line_no: line_no, blanks: 0 as i64 }, gnu.settle(w));
}

function read_size(): i32 {
  return 65536;
}

function proc_reader(r: Reader, name: string, st0: State, o: Opts, w0: io_buffered.BufWriter): Emit {
  let st: State = st0;
  let w: io_buffered.BufWriter = w0;
  let buf: u8[] = [];
  let pos: i32 = 0;
  while (true) {
    let f: (i32, State, io_buffered.BufWriter) = fast_lines(buf, pos, st, o, w);
    pos = f.0;
    st = f.1;
    w = f.2;
    let j: i32 = __memchr_bytes(buf, 10, pos);
    if (j >= 0) {
      let e: Emit = proc_line(buf, pos, j, st, o, w);
      st = e.st;
      w = e.w;
      pos = j + 1;
      continue;
    }
    let carry: usize = 0 as usize;
    if (pos < buf.len()) {
      carry = buf_new(read_size());
      buf_push_bytes_range(carry, buf, pos, buf.len());
    }
    let ready: boolean = false;
    while (!ready) {
      match (r.read_chunk_bytes(read_size())) {
        Ok(chunk) => {
          if (chunk.len() == 0) {
            if (carry != 0 as usize) {
              let last: u8[] = buf_take_bytes(carry);
              buf_free(carry);
              let e: Emit = proc_line(last, 0, last.len(), st, o, w);
              st = e.st;
              w = e.w;
            }
            return Emit { st: st, w: w };
          }
          if (carry == 0 as usize) {
            buf = chunk;
            pos = 0;
            ready = true;
          } else {
            let end: i32 = __memchr_bytes(chunk, 10, 0);
            if (end < 0) {
              buf_push_bytes_range(carry, chunk, 0, chunk.len());
            } else {
              buf_push_bytes_range(carry, chunk, 0, end);
              let line: u8[] = buf_take_bytes(carry);
              buf_free(carry);
              let e: Emit = proc_line(line, 0, line.len(), st, o, w);
              st = e.st;
              w = e.w;
              buf = chunk;
              pos = end + 1;
              ready = true;
            }
          }
        },
        Err(err) => {
          if (carry != 0 as usize) {
            buf_free(carry);
          }
          w = gnu.error_out(w, gnu.quotef(name) + ": " + gnu.io_error_text(err));
          return Emit { st: State { ...st, status: 1 }, w: w };
        }
      }
    }
  }
  return Emit { st: st, w: w };
}

function proc_file(path: string, st: State, o: Opts, w: io_buffered.BufWriter): Emit {
  if (path == "-") {
    return proc_reader(stdin(), path, st, o, w);
  }
  match (open_reader(path)) {
    Ok(f) => {
      let e: Emit = proc_reader(f, path, st, o, w);
      f.close();
      return e;
    },
    Err(err) => {
      let w2: io_buffered.BufWriter = gnu.error_out(w, gnu.quotef(path) + ": " + gnu.io_error_text(err));
      return Emit { st: State { ...st, status: 1 }, w: w2 };
    }
  }
  return Emit { st: st, w: w };
}

function delimiters(cc: string): (u8[], u8[], u8[]) {
  let d: string = cc;
  if (d.len() == 1) {
    d = d + ":";
  }
  return (d.bytes(), (d + d).bytes(), (d + d + d).bytes());
}

pub function main(): i32 {
  let argv: string[] = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("h", "header-numbering", opt_header()));
  opts = opts.append(gnu.valued("b", "body-numbering", opt_body()));
  opts = opts.append(gnu.valued("f", "footer-numbering", opt_footer()));
  opts = opts.append(gnu.valued("v", "starting-line-number", opt_start()));
  opts = opts.append(gnu.valued("i", "line-increment", opt_incr()));
  opts = opts.append(gnu.flag("p", "no-renumber", opt_norenumber()));
  opts = opts.append(gnu.valued("l", "join-blank-lines", opt_join()));
  opts = opts.append(gnu.valued("s", "number-separator", opt_sep()));
  opts = opts.append(gnu.valued("w", "number-width", opt_width()));
  opts = opts.append(gnu.valued("n", "number-format", opt_format()));
  opts = opts.append(gnu.valued("d", "section-delimiter", opt_delim()));

  let dels: (u8[], u8[], u8[]) = delimiters("\\:");
  let o: Opts = Opts { header: empty_style(style_none()), body: empty_style(style_nonempty()), footer: empty_style(style_none()), sep: "\t", fmt: fmt_rn(), width: 6, start: 1 as i64, incr: 1 as i64, join_blank: 1 as i64, renumber: true, del1: dels.0, del2: dels.1, del3: dels.2, pad: "", zeros: "", blank: "" };

  let g: gnu.Getopt = gnu.getopt_new(argv, opts, "nl", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_header()) {
          o = Opts { ...o, header: parse_style(m.value, "header") };
        } else if (m.id == opt_body()) {
          o = Opts { ...o, body: parse_style(m.value, "body") };
        } else if (m.id == opt_footer()) {
          o = Opts { ...o, footer: parse_style(m.value, "footer") };
        } else if (m.id == opt_start()) {
          o = Opts { ...o, start: number_option(m.value, "starting line number", 0 as i64 - 9223372036854775807 as i64 - 1 as i64, 9223372036854775807 as i64, false, false) };
        } else if (m.id == opt_incr()) {
          o = Opts { ...o, incr: number_option(m.value, "line number increment", 0 as i64 - 9223372036854775807 as i64 - 1 as i64, 9223372036854775807 as i64, false, false) };
        } else if (m.id == opt_norenumber()) {
          o = Opts { ...o, renumber: false };
        } else if (m.id == opt_join()) {
          o = Opts { ...o, join_blank: number_option(m.value, "line number of blank lines", 1 as i64, 9223372036854775807 as i64, true, true) };
        } else if (m.id == opt_sep()) {
          o = Opts { ...o, sep: m.value };
        } else if (m.id == opt_width()) {
          o = Opts { ...o, width: number_option(m.value, "line number field width", 1 as i64, 2147483647 as i64, true, false) as i32 };
        } else if (m.id == opt_format()) {
          if (m.value == "ln") {
            o = Opts { ...o, fmt: fmt_ln() };
          } else if (m.value == "rn") {
            o = Opts { ...o, fmt: fmt_rn() };
          } else if (m.value == "rz") {
            o = Opts { ...o, fmt: fmt_rz() };
          } else {
            gnu.die_usage("invalid line numbering format: " + gnu.quote(m.value), 1);
          }
        } else if (m.id == opt_delim()) {
          let d: (u8[], u8[], u8[]) = delimiters(m.value);
          o = Opts { ...o, del1: d.0, del2: d.1, del3: d.2 };
        }
      },
      None => {
        break;
      }
    }
  }

  o = with_pads(o);

  let files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  let st: State = State { section: section_body(), line_no: o.start, blanks: 0 as i64, over: false, status: 0 };
  let w: io_buffered.BufWriter = gnu.out_new();
  let i: i32 = 0;
  while (i < files.len()) {
    let e: Emit = proc_file(files[i], st, o, w);
    st = e.st;
    w = e.w;
    i = i + 1;
  }
  gnu.finish(w);
  return st.status;
}
