// env.fern — GNU-compatible `env`: run a program in a modified environment.
//
//   env [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]
//
// With no COMMAND it prints the environment it built, one entry per line (or
// NUL-separated under `-0`), in VECTOR order rather than sorted.
//
// The order the actions happen in is observable through `-v` and is not the
// order they are written on the command line: clear (`-i`), unset (`-u`), set
// (`NAME=VALUE`), the signal options, then `-C`, then exec. `-C` lands BEFORE
// the PATH search, so `PATH=bin env -C /somewhere cmd` finds `/somewhere/bin/cmd`
// — measured, and the reason the chdir is not simply done last.
//
// `-S` is expanded before any of that: its tokens are spliced into argv where
// the option stood and then parsed as ordinary options and operands, so
// `-S'A=1 echo hi'` really does set A.
//
// Usage errors exit 125, a command that cannot be invoked 126, one that cannot
// be found 127; otherwise the command's own status passes through.
//
// There is deliberately no `-a` / `--argv0`. It arrived in coreutils 9.5 and
// docs/COREUTILS.md holds this corpus to 9.4, whose `env` answers
// `invalid option -- 'a'`; accepting it here would be a divergence from the
// reference, not a feature. `proc_exec_as` already takes argv verbatim, so the
// option is a few lines whenever the pinned reference moves.
import "std/string";
import "std/array";
import "std/i32";
import "./lib/gnu";
import "./lib/signals";

function opt_ignore(): i32 {
  return 1;
}

function opt_null(): i32 {
  return 2;
}

function opt_unset(): i32 {
  return 3;
}

function opt_chdir(): i32 {
  return 4;
}

function opt_split(): i32 {
  return 5;
}

function opt_debug(): i32 {
  return 6;
}

function opt_block(): i32 {
  return 7;
}

function opt_default(): i32 {
  return 8;
}

function opt_ignore_signal(): i32 {
  return 9;
}

function opt_list(): i32 {
  return 10;
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]\n";
  out = out + "Set each NAME to VALUE in the environment and run COMMAND.\n";
  out = out + "\n";
  out = out + "  -i, --ignore-environment  start with an empty environment\n";
  out = out + "  -0, --null           end each output line with NUL, not newline\n";
  out = out + "  -u, --unset=NAME     remove variable from the environment\n";
  out = out + "  -C, --chdir=DIR      change working directory to DIR\n";
  out = out + "  -S, --split-string=S  process and split S into separate arguments;\n";
  out = out + "                       used to pass multiple arguments on shebang lines\n";
  out = out + "      --block-signal[=SIG]    block delivery of SIG signal(s) to COMMAND\n";
  out = out + "      --default-signal[=SIG]  reset handling of SIG signal(s) to the default\n";
  out = out + "      --ignore-signal[=SIG]   set handling of SIG signal(s) to do nothing\n";
  out = out + "      --list-signal-handling  list non default signal handling to stderr\n";
  out = out + "  -v, --debug          print verbose information for each processing step\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "A mere - implies -i.  If no COMMAND, print the resulting environment.\n";
  out = out + "\n";
  out = out + "SIG may be a signal name like 'PIPE', or a signal number like '13'.\n";
  out = out + "Without SIG, all known signals are included.  Multiple signals can be\n";
  out = out + "comma-separated.  An empty SIG argument is a no-op.\n";
  return out;
}

// ---------------------------------------------------------------------------
// The environment vector
// ---------------------------------------------------------------------------
// `name_of(entry)` — the NAME half of a `NAME=VALUE` entry, or the whole thing
// when there is no `=` (which the kernel permits and `environ` can hold).
function name_of(entry: string): string {
  var i: i32 = 0;
  while (i < entry.len()) {
    if (entry[i] == b'=') {
      return slice_unchecked(entry, 0, i) + "";
    }
    i = i + 1;
  }
  return entry;
}

// `unset(vec, name)` — every entry for `name` removed. Every, not the first:
// an inherited vector may legally hold a name twice.
function unset(vec: string[], name: string): string[] {
  var out: string[] = [];
  var i: i32 = 0;
  while (i < vec.len()) {
    if (name_of(vec[i]) != name) {
      out = out.append(vec[i]);
    }
    i = i + 1;
  }
  return out;
}

// `setvar(vec, entry)` — putenv semantics: the first entry with this name is
// REPLACED in place, keeping its position, and a new name is appended. Measured:
// `env -i A=1 A=2 printenv` prints one `A=2`, so the second assignment does not
// add a second entry.
function setvar(vec: string[], entry: string): string[] {
  var name: string = name_of(entry);
  var out: string[] = [];
  var replaced: boolean = false;
  var i: i32 = 0;
  while (i < vec.len()) {
    if (name_of(vec[i]) == name) {
      if (!replaced) {
        out = out.append(entry);
        replaced = true;
      }
    } else {
      out = out.append(vec[i]);
    }
    i = i + 1;
  }
  if (!replaced) {
    out = out.append(entry);
  }
  return out;
}

// `has(vec, name)` — whether `name` is in `vec` at all. A variable set to the
// empty string and one that is absent both `lookup` as "", and `-S` treats them
// differently: `${SET_EMPTY}` leaves an empty token behind, `${UNSET}` leaves
// nothing at all.
function has(vec: string[], name: string): boolean {
  var i: i32 = 0;
  while (i < vec.len()) {
    var e: string = vec[i];
    var n: string = name_of(e);
    if (n == name && n.len() < e.len()) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// `lookup(vec, name)` — the value `name` holds in `vec`, or "" when absent.
// `-S`'s `${NAME}` reads the environment env INHERITED, before `-i` clears it,
// which is why this takes the vector rather than calling `env()`.
function lookup(vec: string[], name: string): string {
  var i: i32 = 0;
  while (i < vec.len()) {
    var e: string = vec[i];
    var n: string = name_of(e);
    if (n == name && n.len() < e.len()) {
      return slice_unchecked(e, n.len() + 1, e.len()) + "";
    }
    i = i + 1;
  }
  return "";
}

// ---------------------------------------------------------------------------
// -S: the split-string grammar
// ---------------------------------------------------------------------------
// The recognised backslash escapes, and what each stands for. `\_` and `\c` are
// not in this table because neither produces a character: outside quotes `\_`
// SEPARATES words (inside them it is a space), and `\c` ends the whole string.
//
// `\a`, `\b`, `\e` and `\0` are deliberately absent — GNU rejects them with
// `invalid sequence '\a' in -S`, which is measured, not inferred from the
// shorter list echo(1) accepts.
function escape_char(c: u8): string {
  if (c == b'\\') {
    return "\\";
  }
  if (c == b'#') {
    return "#";
  }
  if (c == b'$') {
    return "$";
  }
  if (c == b'"') {
    return "\"";
  }
  if (c == b'\'') {
    return "'";
  }
  if (c == b'f') {
    return "\x0c";
  }
  if (c == b'n') {
    return "\n";
  }
  if (c == b'r') {
    return "\r";
  }
  if (c == b't') {
    return "\t";
  }
  if (c == b'v') {
    return "\x0b";
  }
  return "";
}

// `dbg(msg)` — one line of the `-v` transcript. Unprefixed, unlike every
// diagnostic: GNU writes `setenv:   A=1`, not `env: setenv:   A=1`. Both go to
// stderr, so only the prefix separates them.
function dbg(msg: string): void {
  eprint(msg);
}

// A VARNAME is what the shell calls one: a letter or underscore, then letters,
// digits and underscores.
function is_varname(nm: string): boolean {
  if (nm.len() == 0) {
    return false;
  }
  var i: i32 = 0;
  while (i < nm.len()) {
    var c: i32 = nm[i] as i32;
    var alpha: boolean = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95;
    var digit: boolean = c >= 48 && c <= 57;
    if (!alpha && !(digit && i > 0)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function is_space(c: u8): boolean {
  return c == b' ' || c == b'\t' || c == b'\n' || c == b'\r';
}

struct Split { toks: string[], ok: boolean }

// `split_string(s, vec, debug)` — the `-S` tokeniser.
//
// Quoting is the shell's in shape but not in detail: single quotes are literal
// through to the closing quote; double quotes keep `${NAME}` expansion and the
// backslash escapes but make `#` ordinary; outside quotes `#` opens a comment
// only at the START of a token, so `a#b` is one token and `a #b` is one token
// and a comment.
//
// An expansion that produces nothing makes the token DISAPPEAR, while `""`
// leaves an empty token behind — which is why `started` is tracked separately
// from the accumulated text.
function split_string(s: string, vec: string[], debug: boolean): Split {
  var toks: string[] = [];
  var cur: string = "";
  var started: boolean = false;
  var i: i32 = 0;
  while (i < s.len()) {
    var c: u8 = s[i];
    if (is_space(c)) {
      if (started) {
        toks = toks.append(cur);
      }
      cur = "";
      started = false;
      i = i + 1;
      continue;
    }
    if (c == b'#' && !started) {
      // A comment runs to the end of the string.
      i = s.len();
      continue;
    }
    if (c == b'\'') {
      started = true;
      var q: (string, i32, boolean) = scan_single(s, i + 1);
      if (!q.2) {
        gnu.error("no terminating quote in -S string");
        exit(125);
      }
      cur = cur + q.0;
      i = q.1;
      continue;
    }
    if (c == b'"') {
      started = true;
      var d: (string, i32, boolean, boolean) = scan_double(s, i + 1, vec, debug);
      if (!d.2) {
        gnu.error("no terminating quote in -S string");
        exit(125);
      }
      cur = cur + d.0;
      i = d.1;
      continue;
    }
    if (c == b'\\') {
      if (i + 1 >= s.len()) {
        gnu.error("invalid backslash at end of string in -S");
        exit(125);
      }
      var e: u8 = s[i + 1];
      if (e == b'c') {
        // Truncates the string: this token ends and nothing after it is read.
        if (started) {
          toks = toks.append(cur);
        }
        return Split { toks: toks, ok: true };
      }
      if (e == b'_') {
        // A word separator outside quotes.
        if (started) {
          toks = toks.append(cur);
        }
        cur = "";
        started = false;
        i = i + 2;
        continue;
      }
      var rep: string = escape_char(e);
      if (rep.len() == 0) {
        gnu.error("invalid sequence '\\" + (slice_unchecked(s, i + 1, i + 2) + "") + "' in -S");
        exit(125);
      }
      cur = cur + rep;
      started = true;
      i = i + 2;
      continue;
    }
    if (c == b'$') {
      var x: (string, i32, boolean, boolean) = expand(s, i, vec, debug);
      if (!x.2) {
        exit(125);
      }
      cur = cur + x.0;
      // An UNSET name contributes nothing, not even the fact that a token was
      // begun: `echo ${NOPE} tail` runs echo with one argument, not two.
      if (x.3) {
        started = true;
      }
      i = x.1;
      continue;
    }
    cur = cur + (slice_unchecked(s, i, i + 1) + "");
    started = true;
    i = i + 1;
  }
  if (started) {
    toks = toks.append(cur);
  }
  return Split { toks: toks, ok: true };
}

// Everything up to the closing quote, verbatim. Returns the text, the index
// past the closing quote, and whether one was found.
function scan_single(s: string, from: i32): (string, i32, boolean) {
  var out: string = "";
  var i: i32 = from;
  while (i < s.len()) {
    if (s[i] == b'\'') {
      return (out, i + 1, true);
    }
    out = out + (slice_unchecked(s, i, i + 1) + "");
    i = i + 1;
  }
  return (out, i, false);
}

// Inside double quotes `${NAME}` still expands and the backslash escapes still
// apply — `\_` among them, as a literal SPACE rather than a separator — while
// `#` and `'` are ordinary characters.
function scan_double(s: string, from: i32, vec: string[], debug: boolean): (string, i32, boolean, boolean) {
  var out: string = "";
  var i: i32 = from;
  while (i < s.len()) {
    var c: u8 = s[i];
    if (c == b'"') {
      return (out, i + 1, true, true);
    }
    if (c == b'\\') {
      if (i + 1 >= s.len()) {
        gnu.error("invalid backslash at end of string in -S");
        exit(125);
      }
      var e: u8 = s[i + 1];
      if (e == b'_') {
        out = out + " ";
        i = i + 2;
        continue;
      }
      if (e == b'c') {
        gnu.error("'\\c' must not appear in double-quoted -S string");
        exit(125);
      }
      var rep: string = escape_char(e);
      if (rep.len() == 0) {
        gnu.error("invalid sequence '\\" + (slice_unchecked(s, i + 1, i + 2) + "") + "' in -S");
        exit(125);
      }
      out = out + rep;
      i = i + 2;
      continue;
    }
    if (c == b'$') {
      var x: (string, i32, boolean, boolean) = expand(s, i, vec, debug);
      if (!x.2) {
        exit(125);
      }
      out = out + x.0;
      i = x.1;
      continue;
    }
    out = out + (slice_unchecked(s, i, i + 1) + "");
    i = i + 1;
  }
  return (out, i, false, true);
}

// `${NAME}` and nothing else. A bare `$A` is an error rather than an expansion,
// and the diagnostic echoes the rest of the string from the dollar onwards.
function expand(s: string, at: i32, vec: string[], debug: boolean): (string, i32, boolean, boolean) {
  if (at + 1 >= s.len() || s[at + 1] != b'{') {
    gnu.error("only ${VARNAME} expansion is supported, error at: " + (slice_unchecked(s, at, s.len()) + ""));
    return ("", at, false, false);
  }
  var j: i32 = at + 2;
  while (j < s.len() && s[j] != b'}') {
    j = j + 1;
  }
  if (j >= s.len()) {
    gnu.error("only ${VARNAME} expansion is supported, error at: " + (slice_unchecked(s, at, s.len()) + ""));
    return ("", at, false, false);
  }
  var nm: string = slice_unchecked(s, at + 2, j) + "";
  // Only a real VARNAME expands: `${}` and `${1}` are refused with the same
  // message a bare `$` gets, which echoes the remainder of the string.
  if (!is_varname(nm)) {
    gnu.error("only ${VARNAME} expansion is supported, error at: " + (slice_unchecked(s, at, s.len()) + ""));
    return ("", at, false, false);
  }
  var set: boolean = has(vec, nm);
  var val: string = lookup(vec, nm);
  if (!set) {
    if (debug) {
      dbg("replacing ${" + nm + "} with null string");
    }
  } else {
    if (debug) {
      dbg("expanding ${" + nm + "} into '" + val + "'");
    }
  }
  return (val, j + 1, true, set);
}

// ---------------------------------------------------------------------------
// -S splicing
// ---------------------------------------------------------------------------
// The options that take a value the scanner must step over when it is looking
// for `-S`, so a `-S` standing as another option's ARGUMENT is not mistaken for
// an option of its own (`env -u -S cmd` unsets a variable literally named -S).
// The LONG options that take a separate value. The short spellings are read
// out of the cluster instead, since `-vS` puts one after another option.
function takes_value(a: string): boolean {
  return a == "--unset" || a == "--chdir" || a == "--split-string";
}

// `expand_split(argv, debug)` — argv with the first `-S` / `--split-string`
// replaced by the tokens it splits into.
//
// A pre-pass rather than something the getopt loop does, because the tokens are
// themselves options and operands: they have to be in argv before the scan that
// reads them. Only the FIRST is expanded, which is what GNU does — a second `-S`
// among the spliced tokens is an ordinary operand by then.
function expand_split(argv: string[], debug: boolean): string[] {
  // From 1: args() hands back argv[0] as well, and getopt_new starts at 1 for
  // the same reason. Starting at 0 makes the program name the first token this
  // sees, which is not an option, which ends the scan before it begins.
  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a == "--") {
      return argv;
    }
    if (!gnu.is_option(a)) {
      return argv;
    }
    var payload: string = "";
    var have: boolean = false;
    var skip: i32 = 1;
    // Options that stood BEFORE the -S inside the same cluster. `-vS...` is
    // `-v` and then `-S`, so replacing the whole token with the split tokens
    // would drop the -v.
    var prefix: string = "";
    if (a == "--split-string") {
      if (i + 1 >= argv.len()) {
        // A missing value is getopt's fault to report, not this pass's.
        return argv;
      }
      payload = argv[i + 1];
      have = true;
      skip = 2;
    } else if (a.starts_with("--split-string=")) {
      payload = slice_unchecked(a, 15, a.len()) + "";
      have = true;
    } else if (!a.starts_with("--")) {
      // A short CLUSTER, read the way getopt reads one: each byte is an
      // option until one that takes a value, which swallows the rest of the
      // token or else the next argv element. `-vS...` is `-v` then `-S`.
      var k: i32 = 1;
      while (k < a.len()) {
        var c: u8 = a[k];
        if (c == b'S') {
          if (k > 1) {
            prefix = "-" + (slice_unchecked(a, 1, k) + "");
          }
          if (k + 1 < a.len()) {
            payload = slice_unchecked(a, k + 1, a.len()) + "";
            have = true;
          } else if (i + 1 < argv.len()) {
            payload = argv[i + 1];
            have = true;
            skip = 2;
          } else {
            return argv;
          }
          k = a.len();
        } else if (c == b'u' || c == b'C') {
          // Takes a value too, so whatever follows is not an option.
          if (k + 1 >= a.len()) {
            skip = 2;
          }
          k = a.len();
        } else {
          k = k + 1;
        }
      }
    }
    if (have) {
      var vec: string[] = environ();
      var sp: Split = split_string(payload, vec, debug);
      if (debug) {
        dbg("split -S:  '" + payload + "'");
        var k: i32 = 0;
        while (k < sp.toks.len()) {
          if (k == 0) {
            dbg(" into:    '" + sp.toks[k] + "'");
          } else {
            dbg("     &    '" + sp.toks[k] + "'");
          }
          k = k + 1;
        }
      }
      var out: string[] = [];
      var j: i32 = 0;
      while (j < i) {
        out = out.append(argv[j]);
        j = j + 1;
      }
      if (prefix.len() > 0) {
        out = out.append(prefix);
      }
      var t: i32 = 0;
      while (t < sp.toks.len()) {
        out = out.append(sp.toks[t]);
        t = t + 1;
      }
      var r: i32 = i + skip;
      while (r < argv.len()) {
        out = out.append(argv[r]);
        r = r + 1;
      }
      return out;
    }
    if (takes_value(a)) {
      i = i + 2;
    } else {
      i = i + skip;
    }
  }
  return argv;
}

// `debug_wanted(argv)` — whether `-v` / `--debug` stands among the options.
// The `-S` pre-pass runs before the real scan and has to know, because its
// expansion traces come first in the transcript.
function debug_wanted(argv: string[]): boolean {
  var i: i32 = 1;
  while (i < argv.len()) {
    var a: string = argv[i];
    if (a == "--") {
      return false;
    }
    if (!gnu.is_option(a)) {
      return false;
    }
    if (a == "-v" || a == "--debug") {
      return true;
    }
    var step: i32 = 1;
    if (!a.starts_with("--") && a.len() > 1) {
      // A short cluster: -iv, -vu NAME, -vS'...'.
      var k: i32 = 1;
      while (k < a.len()) {
        var c: u8 = a[k];
        if (c == b'v') {
          return true;
        }
        if (c == b'u' || c == b'C' || c == b'S') {
          if (k + 1 >= a.len()) {
            step = 2;
          }
          k = a.len();
        } else {
          k = k + 1;
        }
      }
    } else if (takes_value(a)) {
      step = 2;
    }
    i = i + step;
  }
  return false;
}

// ---------------------------------------------------------------------------
// Signals
// ---------------------------------------------------------------------------
// What a signal option asks for. `kind` is 0 block / 1 default / 2 ignore, in
// the order `Act` records them so the transcript stays in command-line order.
struct Act { kind: i32, list: string, given: boolean }

// `signal_set(list)` — the signal numbers a `SIG,SIG,...` argument names, or
// every signal when the argument was absent. An EMPTY argument is a no-op,
// which is different from an absent one.
function signal_set(list: string, given: boolean): i32[] {
  var out: i32[] = [];
  if (!given) {
    var n: i32 = 1;
    while (n <= signals.highest()) {
      if (signals.name(n) != "") {
        out = out.append(n);
      }
      n = n + 1;
    }
    return out;
  }
  if (list.len() == 0) {
    return out;
  }
  var start: i32 = 0;
  var i: i32 = 0;
  while (i <= list.len()) {
    if (i == list.len() || list[i] == b',') {
      var piece: string = slice_unchecked(list, start, i) + "";
      // An empty element is skipped rather than rejected: `INT,,TERM` names
      // two signals, and a wholly empty argument names none at all.
      if (piece.len() != 0) {
        var num: i32 = signals.number(piece);
        if (num == 0) {
          gnu.die_usage(gnu.quote(piece) + ": invalid signal", 125);
        }
        out = out.append(num);
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

// `apply_signals(acts, debug)` — the signal options, in command-line order.
//
// `--default-signal` both resets the disposition and UNBLOCKS, which is why it
// traces two lines; `--block-signal` only moves the mask and `--ignore-signal`
// only the disposition. Blocking SIGKILL is silently nothing — sigprocmask
// ignores it — while IGNORING it is EINVAL and fatal, which is the asymmetry
// the two measured differently.
function apply_signals(acts: Act[], debug: boolean): void {
  var i: i32 = 0;
  while (i < acts.len()) {
    var a: Act = acts[i];
    var nums: i32[] = signal_set(a.list, a.given);
    var j: i32 = 0;
    while (j < nums.len()) {
      var n: i32 = nums[j];
      var nm: string = signals.name(n);
      if (a.kind == 0) {
        signal_mask(0, signals_bit(n));
        if (debug) {
          dbg("signal " + nm + " (" + n.to_string() + ") mask set to BLOCK");
        }
      } else if (a.kind == 1) {
        var rc: i32 = signal_default(n);
        if (rc < 0) {
          gnu.error("failed to set signal action for signal " + n.to_string() + ": " + errno_text(0 - rc));
          exit(125);
        }
        if (debug) {
          dbg("Reset signal " + nm + " (" + n.to_string() + ") to DEFAULT");
        }
        signal_mask(1, signals_bit(n));
        if (debug) {
          dbg("signal " + nm + " (" + n.to_string() + ") mask set to UNBLOCK");
        }
      } else {
        var ri: i32 = signal_ignore(n);
        if (ri < 0) {
          gnu.error("failed to set signal action for signal " + n.to_string() + ": " + errno_text(0 - ri));
          exit(125);
        }
        if (debug) {
          dbg("Reset signal " + nm + " (" + n.to_string() + ") to IGNORE");
        }
      }
      j = j + 1;
    }
    i = i + 1;
  }
}

function signals_bit(n: i32): i64 {
  return 1 as i64 << (n - 1) as i64;
}

// The number column `--list-signal-handling` prints is two wide and
// right-justified — `( 2)`, `(15)`, `(37)`. The `-v` transcript does NOT pad:
// it writes `signal INT (2)`.
function pad2(n: i32): string {
  var s: string = n.to_string();
  if (s.len() < 2) {
    return " " + s;
  }
  return s;
}

// `list_signal_handling()` — every signal whose disposition is not the default,
// or which is blocked, one per line ON STDERR. Nothing is printed when nothing
// has moved, and nothing at all when there is no COMMAND.
function list_signal_handling(): void {
  var n: i32 = 1;
  var blocked: i64 = signal_mask(0, 0 as i64);
  while (n <= signals.highest()) {
    var nm: string = signals.name(n);
    if (nm.len() != 0) {
      var what: string = "";
      if ((blocked & signals_bit(n)) != 0 as i64) {
        what = "BLOCK";
      }
      var d: i32 = signal_disposition(n);
      if (d == 1) {
        what = "IGNORE";
      }
      if (what.len() != 0) {
        // Unprefixed: GNU writes the listing itself, not a diagnostic.
        eprint(pad_right(nm, 10) + " (" + pad2(n) + "): " + what);
      }
    }
    n = n + 1;
  }
}

function pad_right(s: string, w: i32): string {
  var out: string = s;
  while (out.len() < w) {
    out = out + " ";
  }
  return out;
}

// ---------------------------------------------------------------------------
// Running the command
// ---------------------------------------------------------------------------
// `resolve(cmd, vec)` — the path to run for `cmd`, searched along PATH the way
// execvp does: a name containing a slash is used as given, and otherwise each
// PATH element is tried in order. The errno that ends the search picks the exit
// status, so this reports which one it was.
struct Found { path: string, errno: i32 }

function resolve(cmd: string, vec: string[]): Found {
  if (cmd.len() == 0) {
    return Found { path: "", errno: 2 };
  }
  if (cmd.index_of("/") >= 0) {
    return Found { path: cmd, errno: 0 };
  }
  // An ABSENT PATH is not an empty one. execvp falls back to a built-in list
  // when the variable is missing — measured as `/bin:/usr/bin` on glibc and
  // `/usr/bin:/bin` on Darwin, which is `confstr(_CS_PATH)` on each — while an
  // explicitly EMPTY PATH searches nothing and the command is not found.
  var path: string = "";
  if (has(vec, "PATH")) {
    path = lookup(vec, "PATH");
    if (path.len() == 0) {
      return Found { path: "", errno: 2 };
    }
  } else if (target_os() == "darwin") {
    path = "/usr/bin:/bin";
  } else {
    path = "/bin:/usr/bin";
  }
  var best: i32 = 2;
  var start: i32 = 0;
  var i: i32 = 0;
  while (i <= path.len()) {
    if (i == path.len() || path[i] == b':') {
      var dir: string = slice_unchecked(path, start, i) + "";
      if (dir.len() == 0) {
        dir = ".";
      }
      var cand: string = dir + "/" + cmd;
      match (access(cand, 1)) {
        Ok(_) => {
          return Found { path: cand, errno: 0 };
        },
        Err(e) => {
          // EACCES anywhere on the search outranks a later ENOENT: execvp
          // reports "permission denied" when it found the name but could not
          // run it, and that is the difference between 126 and 127.
          if (gnu.io_error_text(e) == "Permission denied") {
            best = 13;
          }
        }
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return Found { path: "", errno: best };
}

// ---------------------------------------------------------------------------
struct Scan { ignore_env: boolean, null_out: boolean, unsets: string[], chdir_dir: string, chdir_given: boolean, debug: boolean, acts: Act[], list: boolean }

function scan_options(argv: string[]): (Scan, string[]) {
  var opts: gnu.Opt[] = [];
  // Declaration order decides the ambiguity report: `--i` lists
  // `--ignore-environment` before `--ignore-signal`, and `--de` lists
  // `--default-signal` before `--debug`.
  opts = opts.append(gnu.flag("i", "ignore-environment", opt_ignore()));
  opts = opts.append(gnu.flag("0", "null", opt_null()));
  opts = opts.append(gnu.valued("u", "unset", opt_unset()));
  opts = opts.append(gnu.valued("C", "chdir", opt_chdir()));
  opts = opts.append(gnu.valued("S", "split-string", opt_split()));
  opts = opts.append(gnu.optional_long("", "block-signal", opt_block()));
  opts = opts.append(gnu.optional_long("", "default-signal", opt_default()));
  opts = opts.append(gnu.optional_long("", "ignore-signal", opt_ignore_signal()));
  opts = opts.append(gnu.flag("", "list-signal-handling", opt_list()));
  opts = opts.append(gnu.flag("v", "debug", opt_debug()));

  var s: Scan = Scan { ignore_env: false, null_out: false, unsets: [], chdir_dir: "", chdir_given: false, debug: false, acts: [], list: false };
  var g: gnu.Getopt = gnu.getopt_new(argv, opts, "env", help_text(), 125).in_order();
  while (true) {
    var res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_ignore()) {
          s = Scan { ...s, ignore_env: true };
        } else if (m.id == opt_null()) {
          s = Scan { ...s, null_out: true };
        } else if (m.id == opt_unset()) {
          s = Scan { ...s, unsets: s.unsets.append(m.value) };
        } else if (m.id == opt_chdir()) {
          s = Scan { ...s, chdir_dir: m.value, chdir_given: true };
        } else if (m.id == opt_debug()) {
          s = Scan { ...s, debug: true };
        } else if (m.id == opt_list()) {
          s = Scan { ...s, list: true };
        } else if (m.id == opt_block()) {
          s = Scan { ...s, acts: s.acts.append(Act { kind: 0, list: m.value, given: m.has_value }) };
        } else if (m.id == opt_default()) {
          s = Scan { ...s, acts: s.acts.append(Act { kind: 1, list: m.value, given: m.has_value }) };
        } else if (m.id == opt_ignore_signal()) {
          s = Scan { ...s, acts: s.acts.append(Act { kind: 2, list: m.value, given: m.has_value }) };
        }
      },
      None => {
        // opt_split() is consumed by the pre-pass; by here it is already gone.
        break;
      }
    }
  }
  return (s, g.operands());
}

function main(): i32 {
  var argv: string[] = args();
  var want_dbg: boolean = debug_wanted(argv);
  argv = expand_split(argv, want_dbg);

  var parsed: (Scan, string[]) = scan_options(argv);
  var s: Scan = parsed.0;
  var operands: string[] = parsed.1;

  // A bare `-` is a synonym for `-i`, and is an OPERAND to the scanner.
  if (operands.len() > 0 && operands[0] == "-") {
    s = Scan { ...s, ignore_env: true };
    operands = slice_rest(operands, 1);
  }

  var vec: string[] = environ();
  if (s.ignore_env) {
    if (s.debug) {
      dbg("cleaning environ");
    }
    vec = [];
  }
  // `-i` replaces the environment rather than editing it, so the unset pass is
  // skipped entirely — measured: `env -v -i -u FOO` traces `cleaning environ`
  // and no `unset:` line, in either option order.
  var u: i32 = 0;
  while (!s.ignore_env && u < s.unsets.len()) {
    var nm: string = s.unsets[u];
    if (nm.len() == 0 || nm.index_of("=") >= 0) {
      gnu.error("cannot unset " + gnu.quote(nm) + ": Invalid argument");
      exit(125);
    }
    if (s.debug) {
      dbg("unset:    " + nm);
    }
    vec = unset(vec, nm);
    u = u + 1;
  }

  // Leading `NAME=VALUE` operands are assignments; the first operand without an
  // `=` is the COMMAND.
  var k: i32 = 0;
  while (k < operands.len() && is_assignment(operands[k])) {
    if (s.debug) {
      dbg("setenv:   " + operands[k]);
    }
    vec = setvar(vec, operands[k]);
    k = k + 1;
  }
  var rest: string[] = slice_rest(operands, k);

  // The whole signal stage — the actions, the mask and the listing — is
  // skipped when there is no COMMAND: measured, `env -v --block-signal=INT`
  // alone emits nothing at all.
  if (rest.len() != 0) {
    apply_signals(s.acts, s.debug);
    if (s.list) {
      list_signal_handling();
    }
  }

  if (rest.len() != 0 && s.chdir_given) {
    if (s.debug) {
      dbg("chdir:    " + gnu.quotea(s.chdir_dir));
    }
    match (chdir(s.chdir_dir)) {
      Ok(_) => {},
      Err(e) => {
        gnu.error("cannot change directory to " + gnu.quotea(s.chdir_dir) + ": " + gnu.io_error_text(e));
        exit(125);
      }
    }
  }

  if (rest.len() == 0) {
    // Both options act on the command, so without one they are a usage error
    // rather than a no-op. The chdir is not attempted first: `env -C /nosuch`
    // with no COMMAND reports the missing command, not the missing directory.
    if (s.chdir_given) {
      gnu.die_usage("must specify command with --chdir (-C)", 125);
    }
    var sep: string = "\n";
    if (s.null_out) {
      sep = "\x00";
    }
    var o: gnu.Stdio = gnu.stdio_new();
    var i: i32 = 0;
    while (i < vec.len()) {
      o = o.fwrite(vec[i] + sep);
      i = i + 1;
    }
    o.close_stdout();
    return 0;
  }

  if (s.null_out) {
    gnu.die_usage("cannot specify --null (-0) with command", 125);
  }

  var cmd: string = rest[0];
  if (s.debug) {
    dbg("executing: " + cmd);
    var a: i32 = 0;
    while (a < rest.len()) {
      dbg("   arg[" + a.to_string() + "]= " + gnu.quote(rest[a]));
      a = a + 1;
    }
  }

  var f: Found = resolve(cmd, vec);
  if (f.errno != 0) {
    fail_exec(cmd, f.errno);
  }
  var rc: i32 = proc_exec_as(f.path, rest, vec);
  // Only reached when execve failed.
  fail_exec(cmd, 0 - rc);
  return 126;
}

// `errno_text(n)` — strerror for the handful of numbers that reach here as
// raw errnos rather than inside an IoError: sigaction's refusal, and execve's.
// Anything else is reported by number, which is better than a wrong name.
function errno_text(n: i32): string {
  if (n == 2) {
    return "No such file or directory";
  }
  if (n == 13) {
    return "Permission denied";
  }
  if (n == 20) {
    return "Not a directory";
  }
  if (n == 21) {
    return "Is a directory";
  }
  if (n == 22) {
    return "Invalid argument";
  }
  if (n == 8) {
    return "Exec format error";
  }
  if (n == 40) {
    return "Too many levels of symbolic links";
  }
  if (n == 36) {
    return "File name too long";
  }
  return "Unknown error " + n.to_string();
}

// `fail_exec(cmd, errno)` — the diagnostic and status for a command that could
// not be run: 127 when nothing of that name was found, 126 when something was
// and could not be invoked.
//
// The second line is GNU's hint for the commonest way to get here, and it is
// emitted on exactly one condition: the command name contains whitespace, which
// is what a shebang line looks like when the kernel handed the whole tail over
// as a single argument.
function fail_exec(cmd: string, errno: i32): void {
  gnu.error(gnu.quote(cmd) + ": " + errno_text(errno));
  if (has_space(cmd)) {
    gnu.error("use -[v]S to pass options in shebang lines");
  }
  if (errno == 2) {
    exit(127);
  }
  exit(126);
}

function has_space(s: string): boolean {
  var i: i32 = 0;
  while (i < s.len()) {
    if (is_space(s[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// Any operand holding an `=` is an assignment, wherever the `=` stands: `=bar`
// sets a variable whose name is empty, and `=` one whose name and value both
// are. GNU validates nothing here — digits, dashes, spaces and an empty name
// are all accepted and all reach the child.
function is_assignment(a: string): boolean {
  return a.index_of("=") >= 0;
}

function slice_rest(xs: string[], from: i32): string[] {
  var out: string[] = [];
  var i: i32 = from;
  while (i < xs.len()) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}
