import "std/string";
import "std/array";
import "std/i32";
import "std/io";
import "./lib/gnu";
import "./lib/signals";

function opt_ignore(): i32 {
  return 1;
}

function opt_null(): i32 {
  return 2;
}

function opt_unset(): i32 {
  return 3;
}

function opt_chdir(): i32 {
  return 4;
}

function opt_split(): i32 {
  return 5;
}

function opt_debug(): i32 {
  return 6;
}

function opt_block(): i32 {
  return 7;
}

function opt_default(): i32 {
  return 8;
}

function opt_ignore_signal(): i32 {
  return 9;
}

function opt_list(): i32 {
  return 10;
}

function opt_argv0(): i32 {
  return 11;
}

function opt_env0_from(): i32 {
  return 12;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]\n";
  out = out + "Set each NAME to VALUE in the environment and run COMMAND.\n";
  out = out + "\n";
  out = out + "  -a, --argv0=ARG      pass ARG as the zeroth argument of COMMAND\n";
  out = out + "  -i, --ignore-environment  start with an empty environment\n";
  out = out + "      --env0-from=FILE read NUL-delimited environment entries from FILE\n";
  out = out + "  -0, --null           end each output line with NUL, not newline\n";
  out = out + "  -u, --unset=NAME     remove variable from the environment\n";
  out = out + "  -C, --chdir=DIR      change working directory to DIR\n";
  out = out + "  -S, --split-string=S  process and split S into separate arguments;\n";
  out = out + "                       used to pass multiple arguments on shebang lines\n";
  out = out + "      --block-signal[=SIG]    block delivery of SIG signal(s) to COMMAND\n";
  out = out + "      --default-signal[=SIG]  reset handling of SIG signal(s) to the default\n";
  out = out + "      --ignore-signal[=SIG]   set handling of SIG signal(s) to do nothing\n";
  out = out + "      --list-signal-handling  list non default signal handling to standard error\n";
  out = out + "  -v, --debug          print verbose information for each processing step\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "A mere - implies -i.  If no COMMAND, print the resulting environment.\n";
  out = out + "\n";
  out = out + "SIG may be a signal name like 'PIPE', or a signal number like '13'.\n";
  out = out + "Without SIG, all known signals are included.  Multiple signals can be\n";
  out = out + "comma-separated.  An empty SIG argument is a no-op.\n";
  return out;
}

function name_of(entry: string): string {
  let i: i32 = 0;
  while (i < entry.len()) {
    if (entry[i] == b'=') {
      return slice_unchecked(entry, 0, i) + "";
    }
    i = i + 1;
  }
  return entry;
}

function unset(vec: string[], name: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < vec.len()) {
    if (name_of(vec[i]) != name) {
      out = out.append(vec[i]);
    }
    i = i + 1;
  }
  return out;
}

function setvar(vec: string[], entry: string): string[] {
  let name: string = name_of(entry);
  let out: string[] = [];
  let replaced: boolean = false;
  let i: i32 = 0;
  while (i < vec.len()) {
    if (name_of(vec[i]) == name) {
      if (!replaced) {
        out = out.append(entry);
        replaced = true;
      }
    } else {
      out = out.append(vec[i]);
    }
    i = i + 1;
  }
  if (!replaced) {
    out = out.append(entry);
  }
  return out;
}

function place_operand(vec: string[], entry: string, fronted: boolean): (string[], boolean) {
  if (fronted || target_os() != "darwin" || has(vec, name_of(entry))) {
    return (setvar(vec, entry), fronted);
  }
  let out: string[] = [entry];
  let k: i32 = 0;
  while (k < vec.len()) {
    out = out.append(vec[k]);
    k = k + 1;
  }
  return (out, true);
}

function has(vec: string[], name: string): boolean {
  let i: i32 = 0;
  while (i < vec.len()) {
    let e: string = vec[i];
    let n: string = name_of(e);
    if (n == name && n.len() < e.len()) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function lookup(vec: string[], name: string): string {
  let i: i32 = 0;
  while (i < vec.len()) {
    let e: string = vec[i];
    let n: string = name_of(e);
    if (n == name && n.len() < e.len()) {
      return slice_unchecked(e, n.len() + 1, e.len()) + "";
    }
    i = i + 1;
  }
  return "";
}

function escape_char(c: u8): string {
  if (c == b'\\') {
    return "\\";
  }
  if (c == b'#') {
    return "#";
  }
  if (c == b'$') {
    return "$";
  }
  if (c == b'"') {
    return "\"";
  }
  if (c == b'\'') {
    return "'";
  }
  if (c == b'f') {
    return "\x0c";
  }
  if (c == b'n') {
    return "\n";
  }
  if (c == b'r') {
    return "\r";
  }
  if (c == b't') {
    return "\t";
  }
  if (c == b'v') {
    return "\x0b";
  }
  return "";
}

function dbg(msg: string): void {
  eprint(msg);
}

function is_varname(nm: string): boolean {
  if (nm.len() == 0) {
    return false;
  }
  let i: i32 = 0;
  while (i < nm.len()) {
    let c: i32 = nm[i] as i32;
    let alpha: boolean = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95;
    let digit: boolean = c >= 48 && c <= 57;
    if (!alpha && !(digit && i > 0)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function is_space(c: u8): boolean {
  return c == b' ' || c == b'\t' || c == b'\n' || c == b'\r';
}

struct Split { toks: string[], ok: boolean }

function split_string(s: string, vec: string[], debug: boolean): Split {
  let toks: string[] = [];
  let cur: string = "";
  let started: boolean = false;
  let i: i32 = 0;
  while (i < s.len()) {
    let c: u8 = s[i];
    if (is_space(c)) {
      if (started) {
        toks = toks.append(cur);
      }
      cur = "";
      started = false;
      i = i + 1;
      continue;
    }
    if (c == b'#' && !started) {
      i = s.len();
      continue;
    }
    if (c == b'\'') {
      started = true;
      let q: (string, i32, boolean) = scan_single(s, i + 1);
      if (!q.2) {
        gnu.error("no terminating quote in -S string");
        exit(125);
      }
      cur = cur + q.0;
      i = q.1;
      continue;
    }
    if (c == b'"') {
      started = true;
      let d: (string, i32, boolean, boolean) = scan_double(s, i + 1, vec, debug);
      if (!d.2) {
        gnu.error("no terminating quote in -S string");
        exit(125);
      }
      cur = cur + d.0;
      i = d.1;
      continue;
    }
    if (c == b'\\') {
      if (i + 1 >= s.len()) {
        gnu.error("invalid backslash at end of string in -S");
        exit(125);
      }
      let e: u8 = s[i + 1];
      if (e == b'c') {
        if (started) {
          toks = toks.append(cur);
        }
        return Split { toks: toks, ok: true };
      }
      if (e == b'_') {
        if (started) {
          toks = toks.append(cur);
        }
        cur = "";
        started = false;
        i = i + 2;
        continue;
      }
      let rep: string = escape_char(e);
      if (rep.len() == 0) {
        gnu.error("invalid sequence '\\" + (slice_unchecked(s, i + 1, i + 2) + "") + "' in -S");
        exit(125);
      }
      cur = cur + rep;
      started = true;
      i = i + 2;
      continue;
    }
    if (c == b'$') {
      let x: (string, i32, boolean, boolean) = expand(s, i, vec, debug);
      if (!x.2) {
        exit(125);
      }
      cur = cur + x.0;
      if (x.3) {
        started = true;
      }
      i = x.1;
      continue;
    }
    cur = cur + (slice_unchecked(s, i, i + 1) + "");
    started = true;
    i = i + 1;
  }
  if (started) {
    toks = toks.append(cur);
  }
  return Split { toks: toks, ok: true };
}

function scan_single(s: string, from: i32): (string, i32, boolean) {
  let out: string = "";
  let i: i32 = from;
  while (i < s.len()) {
    if (s[i] == b'\'') {
      return (out, i + 1, true);
    }
    out = out + (slice_unchecked(s, i, i + 1) + "");
    i = i + 1;
  }
  return (out, i, false);
}

function scan_double(s: string, from: i32, vec: string[], debug: boolean): (string, i32, boolean, boolean) {
  let out: string = "";
  let i: i32 = from;
  while (i < s.len()) {
    let c: u8 = s[i];
    if (c == b'"') {
      return (out, i + 1, true, true);
    }
    if (c == b'\\') {
      if (i + 1 >= s.len()) {
        gnu.error("invalid backslash at end of string in -S");
        exit(125);
      }
      let e: u8 = s[i + 1];
      if (e == b'_') {
        out = out + " ";
        i = i + 2;
        continue;
      }
      if (e == b'c') {
        gnu.error("'\\c' must not appear in double-quoted -S string");
        exit(125);
      }
      let rep: string = escape_char(e);
      if (rep.len() == 0) {
        gnu.error("invalid sequence '\\" + (slice_unchecked(s, i + 1, i + 2) + "") + "' in -S");
        exit(125);
      }
      out = out + rep;
      i = i + 2;
      continue;
    }
    if (c == b'$') {
      let x: (string, i32, boolean, boolean) = expand(s, i, vec, debug);
      if (!x.2) {
        exit(125);
      }
      out = out + x.0;
      i = x.1;
      continue;
    }
    out = out + (slice_unchecked(s, i, i + 1) + "");
    i = i + 1;
  }
  return (out, i, false, true);
}

function expand(s: string, at: i32, vec: string[], debug: boolean): (string, i32, boolean, boolean) {
  if (at + 1 >= s.len() || s[at + 1] != b'{') {
    gnu.error("only ${VARNAME} expansion is supported, error at: " + (slice_unchecked(s, at, s.len()) + ""));
    return ("", at, false, false);
  }
  let j: i32 = at + 2;
  while (j < s.len() && s[j] != b'}') {
    j = j + 1;
  }
  if (j >= s.len()) {
    gnu.error("only ${VARNAME} expansion is supported, error at: " + (slice_unchecked(s, at, s.len()) + ""));
    return ("", at, false, false);
  }
  let nm: string = slice_unchecked(s, at + 2, j) + "";
  if (!is_varname(nm)) {
    gnu.error("only ${VARNAME} expansion is supported, error at: " + (slice_unchecked(s, at, s.len()) + ""));
    return ("", at, false, false);
  }
  let set: boolean = has(vec, nm);
  let val: string = lookup(vec, nm);
  if (!set) {
    if (debug) {
      dbg("replacing ${" + nm + "} with empty string");
    }
  } else {
    if (debug) {
      dbg("expanding ${" + nm + "} into '" + val + "'");
    }
  }
  return (val, j + 1, true, set);
}

function takes_value(a: string): boolean {
  return a == "--unset" || a == "--chdir" || a == "--split-string";
}

function expand_split(argv: string[], debug: boolean): string[] {
  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "--") {
      return argv;
    }
    if (!gnu.is_option(a)) {
      return argv;
    }
    let payload: string = "";
    let have: boolean = false;
    let skip: i32 = 1;
    let prefix: string = "";
    if (a == "--split-string") {
      if (i + 1 >= argv.len()) {
        return argv;
      }
      payload = argv[i + 1];
      have = true;
      skip = 2;
    } else if (a.starts_with("--split-string=")) {
      payload = slice_unchecked(a, 15, a.len()) + "";
      have = true;
    } else if (!a.starts_with("--")) {
      let k: i32 = 1;
      while (k < a.len()) {
        let c: u8 = a[k];
        if (c == b'S') {
          if (k > 1) {
            prefix = "-" + (slice_unchecked(a, 1, k) + "");
          }
          if (k + 1 < a.len()) {
            payload = slice_unchecked(a, k + 1, a.len()) + "";
            have = true;
          } else if (i + 1 < argv.len()) {
            payload = argv[i + 1];
            have = true;
            skip = 2;
          } else {
            return argv;
          }
          k = a.len();
        } else if (c == b'u' || c == b'C') {
          if (k + 1 >= a.len()) {
            skip = 2;
          }
          k = a.len();
        } else {
          k = k + 1;
        }
      }
    }
    if (have) {
      let vec: string[] = environ();
      let sp: Split = split_string(payload, vec, debug);
      if (debug) {
        dbg("split -S:  '" + payload + "'");
        let k: i32 = 0;
        while (k < sp.toks.len()) {
          if (k == 0) {
            dbg(" into:     '" + sp.toks[k] + "'");
          } else {
            dbg("     &     '" + sp.toks[k] + "'");
          }
          k = k + 1;
        }
      }
      let out: string[] = [];
      let j: i32 = 0;
      while (j < i) {
        out = out.append(argv[j]);
        j = j + 1;
      }
      if (prefix.len() > 0) {
        out = out.append(prefix);
      }
      let t: i32 = 0;
      while (t < sp.toks.len()) {
        out = out.append(sp.toks[t]);
        t = t + 1;
      }
      let r: i32 = i + skip;
      while (r < argv.len()) {
        out = out.append(argv[r]);
        r = r + 1;
      }
      return out;
    }
    if (takes_value(a)) {
      i = i + 2;
    } else {
      i = i + skip;
    }
  }
  return argv;
}

function debug_wanted(argv: string[]): boolean {
  let i: i32 = 1;
  while (i < argv.len()) {
    let a: string = argv[i];
    if (a == "--") {
      return false;
    }
    if (!gnu.is_option(a)) {
      return false;
    }
    if (a == "-v" || a == "--debug") {
      return true;
    }
    let step: i32 = 1;
    if (!a.starts_with("--") && a.len() > 1) {
      let k: i32 = 1;
      while (k < a.len()) {
        let c: u8 = a[k];
        if (c == b'v') {
          return true;
        }
        if (c == b'u' || c == b'C' || c == b'S') {
          if (k + 1 >= a.len()) {
            step = 2;
          }
          k = a.len();
        } else {
          k = k + 1;
        }
      }
    } else if (takes_value(a)) {
      step = 2;
    }
    i = i + step;
  }
  return false;
}

struct Act { kind: i32, list: string, given: boolean }

function signal_set(list: string, given: boolean): i32[] {
  let out: i32[] = [];
  if (!given) {
    let n: i32 = 1;
    while (n <= signals.highest()) {
      if (signals.name(n) != "") {
        out = out.append(n);
      }
      n = n + 1;
    }
    return out;
  }
  if (list.len() == 0) {
    return out;
  }
  let start: i32 = 0;
  let i: i32 = 0;
  while (i <= list.len()) {
    if (i == list.len() || list[i] == b',') {
      let piece: string = slice_unchecked(list, start, i) + "";
      if (piece.len() != 0) {
        let num: i32 = signals.operand2sig(piece);
        if (num <= 0) {
          gnu.die_usage(gnu.quote(piece) + ": invalid signal", 125);
        }
        out = out.append(num);
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

function set_disposition(n: i32, to_default: boolean): void {
  let rd: i32 = signal_disposition(n);
  if (rd < 0) {
    gnu.error("failed to get signal action for signal " + n.to_string() + ": " + gnu.exec_errno_text(0 - rd));
    exit(125);
  }
  let rc: i32 = 0;
  if (to_default) {
    rc = signal_default(n);
  } else {
    rc = signal_ignore(n);
  }
  if (rc < 0) {
    gnu.error("failed to set signal action for signal " + n.to_string() + ": " + gnu.exec_errno_text(0 - rc));
    exit(125);
  }
}

function apply_signals(acts: Act[], debug: boolean): void {
  let i: i32 = 0;
  while (i < acts.len()) {
    let a: Act = acts[i];
    let nums: i32[] = signal_set(a.list, a.given);
    let j: i32 = 0;
    while (j < nums.len()) {
      let n: i32 = nums[j];
      let nm: string = signals.name(n);
      if (a.kind == 0) {
        signal_mask(0, signals_bit(n));
        if (debug) {
          dbg("signal " + nm + " (" + n.to_string() + ") mask set to BLOCK");
        }
      } else if (a.kind == 1) {
        set_disposition(n, true);
        if (debug) {
          dbg("Reset signal " + nm + " (" + n.to_string() + ") to DEFAULT");
        }
        signal_mask(1, signals_bit(n));
        if (debug) {
          dbg("signal " + nm + " (" + n.to_string() + ") mask set to UNBLOCK");
        }
      } else {
        set_disposition(n, false);
        if (debug) {
          dbg("Reset signal " + nm + " (" + n.to_string() + ") to IGNORE");
        }
      }
      j = j + 1;
    }
    i = i + 1;
  }
}

function signals_bit(n: i32): i64 {
  return 1 as i64 << (n - 1) as i64;
}

function pad2(n: i32): string {
  let s: string = n.to_string();
  if (s.len() < 2) {
    return " " + s;
  }
  return s;
}

function list_signal_handling(): void {
  let n: i32 = 1;
  let blocked: i64 = signal_mask(0, 0 as i64);
  while (n <= signals.highest()) {
    let nm: string = signals.name(n);
    if (nm.len() != 0) {
      let what: string = "";
      if ((blocked & signals_bit(n)) != 0 as i64) {
        what = "BLOCK";
      }
      let d: i32 = signal_disposition(n);
      if (d == 1) {
        what = "IGNORE";
      }
      if (what.len() != 0) {
        eprint(pad_right(nm, 10) + " (" + pad2(n) + "): " + what);
      }
    }
    n = n + 1;
  }
}

function pad_right(s: string, w: i32): string {
  let out: string = s;
  while (out.len() < w) {
    out = out + " ";
  }
  return out;
}

struct Scan { ignore_env: boolean, null_out: boolean, unsets: string[], chdir_dir: string, chdir_given: boolean, debug: boolean, acts: Act[], list: boolean, argv0: string, argv0_given: boolean, env0_from: string, env0_given: boolean }

function scan_options(argv: string[]): (Scan, string[]) {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("a", "argv0", opt_argv0()));
  opts = opts.append(gnu.flag("i", "ignore-environment", opt_ignore()));
  opts = opts.append(gnu.valued("", "env0-from", opt_env0_from()));
  opts = opts.append(gnu.flag("0", "null", opt_null()));
  opts = opts.append(gnu.valued("u", "unset", opt_unset()));
  opts = opts.append(gnu.valued("C", "chdir", opt_chdir()));
  opts = opts.append(gnu.optional_long("", "default-signal", opt_default()));
  opts = opts.append(gnu.optional_long("", "ignore-signal", opt_ignore_signal()));
  opts = opts.append(gnu.optional_long("", "block-signal", opt_block()));
  opts = opts.append(gnu.flag("", "list-signal-handling", opt_list()));
  opts = opts.append(gnu.flag("v", "debug", opt_debug()));
  opts = opts.append(gnu.valued("S", "split-string", opt_split()));

  let s: Scan = Scan { ignore_env: false, null_out: false, unsets: [], chdir_dir: "", chdir_given: false, debug: false, acts: [], list: false, argv0: "", argv0_given: false, env0_from: "", env0_given: false };
  let g: gnu.Getopt = gnu.getopt_new(argv, opts, "env", help_text(), 125).in_order();
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_ignore()) {
          s = Scan { ...s, ignore_env: true };
        } else if (m.id == opt_argv0()) {
          s = Scan { ...s, argv0: m.value, argv0_given: true };
        } else if (m.id == opt_env0_from()) {
          s = Scan { ...s, env0_from: m.value, env0_given: true };
        } else if (m.id == opt_null()) {
          s = Scan { ...s, null_out: true };
        } else if (m.id == opt_unset()) {
          s = Scan { ...s, unsets: s.unsets.append(m.value) };
        } else if (m.id == opt_chdir()) {
          s = Scan { ...s, chdir_dir: m.value, chdir_given: true };
        } else if (m.id == opt_debug()) {
          s = Scan { ...s, debug: true };
        } else if (m.id == opt_list()) {
          s = Scan { ...s, list: true };
        } else if (m.id == opt_block()) {
          s = Scan { ...s, acts: s.acts.append(Act { kind: 0, list: m.value, given: m.has_value }) };
        } else if (m.id == opt_default()) {
          s = Scan { ...s, acts: s.acts.append(Act { kind: 1, list: m.value, given: m.has_value }) };
        } else if (m.id == opt_ignore_signal()) {
          s = Scan { ...s, acts: s.acts.append(Act { kind: 2, list: m.value, given: m.has_value }) };
        }
      },
      None => {
        break;
      }
    }
  }
  return (s, g.operands());
}

pub function main(): i32 {
  let argv: string[] = args();
  let want_dbg: boolean = debug_wanted(argv);
  argv = expand_split(argv, want_dbg);

  let parsed: (Scan, string[]) = scan_options(argv);
  let s: Scan = parsed.0;
  let operands: string[] = parsed.1;

  if (operands.len() > 0 && operands[0] == "-") {
    s = Scan { ...s, ignore_env: true };
    operands = slice_rest(operands, 1);
  }

  let qstyle: i32 = 0;
  let quoted_out: boolean = false;
  if (!s.null_out) {
    qstyle = gnu.quoting_style_from_env_with(3);
    quoted_out = qstyle != 0;
  }

  let vec: string[] = environ();
  if (s.ignore_env) {
    dbg_when(s.debug, "clearing environment");
    vec = [];
    if (s.env0_given) {
      vec = env0_entries([], s, true);
    }
  } else if (s.env0_given) {
    vec = env0_entries(vec, s, false);
  }
  let u: i32 = 0;
  while ((!s.ignore_env || s.env0_given) && u < s.unsets.len()) {
    let nm: string = s.unsets[u];
    if (nm.len() == 0 || nm.contains("=")) {
      gnu.error("cannot unset " + gnu.quote(nm) + ": Invalid argument");
      exit(125);
    }
    if (s.debug) {
      dbg("unsetting: " + gnu.quote(nm));
    }
    vec = unset(vec, nm);
    u = u + 1;
  }

  let k: i32 = 0;
  let fronted: boolean = false;
  while (k < operands.len() && is_assignment(operands[k])) {
    if (s.debug) {
      dbg("setting:   " + gnu.quote(operands[k]));
    }
    let placed: (string[], boolean) = place_operand(vec, operands[k], fronted);
    vec = placed.0;
    fronted = placed.1;
    k = k + 1;
  }
  let rest: string[] = slice_rest(operands, k);

  if (rest.len() != 0) {
    apply_signals(s.acts, s.debug);
    if (s.list) {
      list_signal_handling();
    }
  }

  if (rest.len() != 0 && s.chdir_given) {
    if (s.debug) {
      dbg("change dir: " + gnu.quote(s.chdir_dir));
    }
    match (chdir(s.chdir_dir)) {
      Ok(_) => {},
      Err(e) => {
        gnu.error("cannot change directory to " + gnu.quotea(s.chdir_dir) + ": " + gnu.io_error_text(e));
        exit(125);
      }
    }
  }

  if (rest.len() == 0) {
    if (s.chdir_given) {
      gnu.die_usage("must specify command with --chdir (-C)", 125);
    }
    if (s.argv0_given) {
      gnu.die_usage("must specify command with --argv0 (-a)", 125);
    }
    let sep: string = "\n";
    if (s.null_out) {
      sep = "\x00";
    }
    let o: gnu.Stdio = gnu.stdio_new();
    let i: i32 = 0;
    while (i < vec.len()) {
      let shown: string = vec[i];
      if (quoted_out) {
        shown = gnu.env_entry(vec[i], qstyle);
      }
      o = o.fwrite(shown + sep);
      i = i + 1;
    }
    o.close_stdout();
    return 0;
  }

  if (s.null_out) {
    gnu.die_usage("cannot specify --null (-0) with command", 125);
  }

  let cmd: string = rest[0];
  if (s.argv0_given) {
    dbg_when(s.debug, "argv0:     " + gnu.quote(s.argv0));
    rest = rest.with(0, s.argv0);
  }
  if (s.debug) {
    dbg("executing: " + gnu.quote(cmd));
    let a: i32 = 0;
    while (a < rest.len()) {
      dbg("   arg[" + a.to_string() + "]= " + gnu.quote(rest[a]));
      a = a + 1;
    }
  }

  fail_exec(cmd, gnu.exec_command(cmd, rest, vec));
  return 126;
}

function dbg_when(on: boolean, msg: string): void {
  if (on) {
    dbg(msg);
  }
}

function env0_entries(vec: string[], s: Scan, raw: boolean): string[] {
  let text: string = read_env_file(s.env0_from);
  let out: string[] = vec;
  let i: i32 = 0;
  while (i < text.len()) {
    let j: i32 = __memchr(text, 0, i);
    if (j < 0) {
      j = text.len();
    }
    let entry: string = slice_unchecked(text, i, j) + "";
    if (raw) {
      out = out.append(entry);
    } else if (!entry.contains("=")) {
      dbg_when(s.debug, "adding:    " + gnu.quote(entry));
      out = out.append(entry);
    } else {
      dbg_when(s.debug, "setting:   " + gnu.quote(entry));
      out = setvar(out, entry);
    }
    i = j + 1;
  }
  return out;
}

function read_env_file(path: string): string {
  let text: string = "";
  if (path == "-") {
    match (io.read_all_stdin()) {
      Ok(t) => {
        text = t;
      },
      Err(e) => {
        gnu.error("cannot read " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
        exit(125);
      }
    }
  } else {
    match (read_file(path)) {
      Ok(t) => {
        text = t;
      },
      Err(e) => {
        gnu.error("cannot read " + gnu.quotea(path) + ": " + gnu.io_error_text(e));
        exit(125);
      }
    }
  }
  if (text.len() == 0) {
    return text;
  }
  if (text[text.len() - 1] != 0 as u8) {
    gnu.error(gnu.quotef(path) + ": file must end with a NUL byte");
    exit(125);
  }
  return slice_unchecked(text, 0, text.len() - 1) + "";
}

function fail_exec(cmd: string, errno: i32): void {
  gnu.error(gnu.quote(cmd) + ": " + gnu.exec_errno_text(errno));
  if (has_space(cmd)) {
    gnu.error("use -[v]S to pass options in shebang lines");
  }
  if (errno == 2) {
    exit(127);
  }
  exit(126);
}

function has_space(s: string): boolean {
  let i: i32 = 0;
  while (i < s.len()) {
    if (is_space(s[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function is_assignment(a: string): boolean {
  return a.contains("=");
}

function slice_rest(xs: string[], from: i32): string[] {
  let out: string[] = [];
  let i: i32 = from;
  while (i < xs.len()) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}
