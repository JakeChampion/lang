// dir.fern — GNU-compatible `dir`: `ls -C -b`.
//
//   dir [OPTION]... [FILE]...
//
// The same program as `ls` (`lib/listing.fern`) with two different
// defaults: columns even when standard output is not a terminal, and
// `-b`'s escaping of a name that needs it.
import "./lib/listing";

pub function main(): i32 {
  return listing.dir();
}
