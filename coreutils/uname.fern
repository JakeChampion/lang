import "./lib/gnu";
import "./lib/sys";

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]...\n";
  out = out + "Print certain system information.  With no OPTION, same as -s.\n";
  out = out + "\n";
  out = out + "  -a, --all                print all information, in the following order,\n";
  out = out + "                             except omit -p and -i if unknown\n";
  out = out + "  -A, --all-labeled        print all information, one labeled field per line,\n";
  out = out + "                             except omit -p and -i if unknown\n";
  out = out + "  -s, --kernel-name        print the kernel name\n";
  out = out + "  -n, --nodename           print the network node hostname\n";
  out = out + "  -r, --kernel-release     print the kernel release\n";
  out = out + "  -v, --kernel-version     print the kernel version\n";
  out = out + "  -m, --machine            print the machine hardware name\n";
  out = out + "  -p, --processor          print the processor type (non-portable)\n";
  out = out + "  -i, --hardware-platform  print the hardware platform (non-portable)\n";
  out = out + "  -o, --operating-system   print the operating system\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function opt_all(): i32 {
  return 1;
}

function opt_kernel_name(): i32 {
  return 2;
}

function opt_nodename(): i32 {
  return 3;
}

function opt_kernel_release(): i32 {
  return 4;
}

function opt_kernel_version(): i32 {
  return 5;
}

function opt_machine(): i32 {
  return 6;
}

function opt_processor(): i32 {
  return 7;
}

function opt_hardware_platform(): i32 {
  return 8;
}

function opt_operating_system(): i32 {
  return 9;
}

function opt_all_labeled(): i32 {
  return 10;
}

struct Selection { all: boolean, labeled: boolean, kernel_name: boolean, nodename: boolean, kernel_release: boolean, kernel_version: boolean, machine: boolean, processor: boolean, hardware_platform: boolean, operating_system: boolean }

function empty_selection(): Selection {
  return Selection { all: false, labeled: false, kernel_name: false, nodename: false, kernel_release: false, kernel_version: false, machine: false, processor: false, hardware_platform: false, operating_system: false };
}

function nothing_selected(s: Selection): boolean {
  return !s.all && !s.kernel_name && !s.nodename && !s.kernel_release && !s.kernel_version && !s.machine && !s.processor && !s.hardware_platform && !s.operating_system;
}

struct Element { text: string, known: boolean }

function known(text: string): Element {
  return Element { text: text, known: true };
}

function unknown(): Element {
  return Element { text: "unknown", known: false };
}

function processor(): Element {
  if (target_os() == "darwin") {
    return known("arm");
  }
  return unknown();
}

function operating_system(): Element {
  if (target_os() == "darwin") {
    return known("Darwin");
  }
  return known("GNU/Linux");
}

function append_element(out: string, first: boolean, e: Element, s: Selection, label: string): (string, boolean) {
  if (s.all && !e.known) {
    return (out, first);
  }
  if (s.labeled) {
    return (out + label + ": " + e.text + "\n", false);
  }
  if (first) {
    return (out + e.text, false);
  }
  return (out + " " + e.text, false);
}

function scan(argv: string[]): Selection {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("a", "all", opt_all()));
  opts = opts.append(gnu.flag("A", "all-labeled", opt_all_labeled()));
  opts = opts.append(gnu.flag("s", "kernel-name", opt_kernel_name()));
  opts = opts.append(gnu.flag("s", "sysname", opt_kernel_name()));
  opts = opts.append(gnu.flag("n", "nodename", opt_nodename()));
  opts = opts.append(gnu.flag("r", "kernel-release", opt_kernel_release()));
  opts = opts.append(gnu.flag("r", "release", opt_kernel_release()));
  opts = opts.append(gnu.flag("v", "kernel-version", opt_kernel_version()));
  opts = opts.append(gnu.flag("m", "machine", opt_machine()));
  opts = opts.append(gnu.flag("p", "processor", opt_processor()));
  opts = opts.append(gnu.flag("i", "hardware-platform", opt_hardware_platform()));
  opts = opts.append(gnu.flag("o", "operating-system", opt_operating_system()));

  let s: Selection = empty_selection();
  let g: gnu.Getopt = gnu.getopt_new(argv, opts, "uname", help_text(), 1);
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        if (m.id == opt_all()) {
          s = Selection { ...s, all: true, labeled: false };
        } else if (m.id == opt_all_labeled()) {
          s = Selection { ...s, all: true, labeled: true };
        } else if (m.id == opt_kernel_name()) {
          s = Selection { ...s, kernel_name: true };
        } else if (m.id == opt_nodename()) {
          s = Selection { ...s, nodename: true };
        } else if (m.id == opt_kernel_release()) {
          s = Selection { ...s, kernel_release: true };
        } else if (m.id == opt_kernel_version()) {
          s = Selection { ...s, kernel_version: true };
        } else if (m.id == opt_machine()) {
          s = Selection { ...s, machine: true };
        } else if (m.id == opt_processor()) {
          s = Selection { ...s, processor: true };
        } else if (m.id == opt_hardware_platform()) {
          s = Selection { ...s, hardware_platform: true };
        } else if (m.id == opt_operating_system()) {
          s = Selection { ...s, operating_system: true };
        }
      },
      None => {
        break;
      }
    }
  }
  let operands: string[] = g.operands();
  if (operands.len() > 0) {
    gnu.die_usage("extra operand " + gnu.quote(operands[0]), 1);
  }
  return s;
}

function from_env(value: string, name: string): string {
  if (target_os() != "darwin") {
    return value;
  }
  match (env(name)) {
    Some(v) => {
      return v;
    },
    None => {
      return value;
    }
  }
}

function line_for(s: Selection): string {
  let line: string = "";
  let first: boolean = true;
  let step: (string, boolean) = (line, first);
  if (s.all || s.kernel_name) {
    step = append_element(step.0, step.1, known(from_env(sys.sysname(), "UNAME_SYSNAME")), s, "Kernel name");
  }
  if (s.all || s.nodename) {
    step = append_element(step.0, step.1, known(from_env(sys.nodename(), "UNAME_NODENAME")), s, "Node name");
  }
  if (s.all || s.kernel_release) {
    step = append_element(step.0, step.1, known(from_env(sys.release(), "UNAME_RELEASE")), s, "Kernel release");
  }
  if (s.all || s.kernel_version) {
    step = append_element(step.0, step.1, known(from_env(sys.version(), "UNAME_VERSION")), s, "Kernel version");
  }
  if (s.all || s.machine) {
    step = append_element(step.0, step.1, known(from_env(sys.machine(), "UNAME_MACHINE")), s, "Machine");
  }
  if (s.all || s.processor) {
    step = append_element(step.0, step.1, processor(), s, "Processor");
  }
  if (s.all || s.hardware_platform) {
    step = append_element(step.0, step.1, unknown(), s, "Hardware platform");
  }
  if (s.all || s.operating_system) {
    step = append_element(step.0, step.1, operating_system(), s, "Operating system");
  }
  if (s.labeled) {
    return step.0;
  }
  return step.0 + "\n";
}

pub function main(): i32 {
  let s: Selection = scan(args());
  if (nothing_selected(s)) {
    s = Selection { ...s, kernel_name: true };
  }
  gnu.write_out(line_for(s));
  return 0;
}
