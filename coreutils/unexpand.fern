import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/tabs";

function opt_tabs(): i32 {
  return 1;
}

function opt_all(): i32 {
  return 2;
}

function opt_first(): i32 {
  return 3;
}

function opt_digit(d: i32): i32 {
  return 10 + d;
}

function opt_comma(): i32 {
  return 20;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Convert blanks in each FILE to tabs, writing to standard output.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -a, --all        convert all blanks, instead of just initial blanks\n";
  out = out + "      --first-only  convert only leading sequences of blanks (overrides -a)\n";
  out = out + "  -t, --tabs=N     have tabs N characters apart instead of 8 (enables -a)\n";
  out = out + "  -t, --tabs=LIST  use comma separated list of tab positions\n";
  out = out + "                     The last specified position can be prefixed with '/'\n";
  out = out + "                     to specify a tab size to use after the last\n";
  out = out + "                     explicitly specified tab stop.  Also a prefix of '+'\n";
  out = out + "                     can be used to align remaining tab stops relative to\n";
  out = out + "                     the last specified tab stop instead of the first column\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function read_size(): i32 {
  return 65536;
}

function block_size(): i32 {
  return 16384;
}

function digit_of(id: i32): string {
  return slice_unchecked("0123456789", id - 10, id - 9) + "";
}

pub function main(): i32 {
  let argv: string[] = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("t", "tabs", opt_tabs()));
  opts = opts.append(gnu.flag("a", "all", opt_all()));
  opts = opts.append(gnu.flag("", "first-only", opt_first()));
  opts = opts.append(gnu.flag(",", "", opt_comma()));
  let d: i32 = 0;
  while (d < 10) {
    opts = opts.append(gnu.flag(slice_unchecked("0123456789", d, d + 1) + "", "", opt_digit(d)));
    d = d + 1;
  }

  let stops: tabs.Tabs = tabs.tabs_new();
  let all: boolean = false;
  let first_only: boolean = false;
  let obsolete: string = "";
  let g: gnu.Getopt = gnu.getopt_new(argv, opts, "unexpand", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_tabs()) {
          stops = stops.parse(m.value);
          all = true;
        } else if (m.id == opt_all()) {
          all = true;
        } else if (m.id == opt_first()) {
          first_only = true;
        } else if (m.id == opt_comma()) {
          obsolete = obsolete + ",";
        } else {
          obsolete = obsolete + digit_of(m.id);
        }
      },
      None => {
        break;
      }
    }
  }
  if (obsolete.len() > 0) {
    stops = stops.parse(obsolete);
  }
  stops = stops.finish();

  let files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  return run(files, stops, all && !first_only);
}

function run(files: string[], stops: tabs.Tabs, convert_all: boolean): i32 {
  let o: io_buffered.BufWriter = gnu.out_with(block_size());
  let h: usize = o.handle();
  let pad: string = "        ";
  let ok: boolean = true;
  let step: u64 = stops.size;

  let fi: i32 = 0;
  let have_reader: boolean = false;
  let is_stdin: boolean = false;
  let name: string = "";
  let r: Reader = stdin();
  let chunk: u8[] = [];
  let pos: i32 = 0;
  let carry: usize = 0 as usize;
  let final: boolean = false;

  while (true) {
    if (pos >= chunk.len()) {
      if (final) {
        break;
      }
      chunk = [];
      pos = 0;
      let got: boolean = false;
      while (!got) {
        if (!have_reader) {
          if (fi >= files.len()) {
            if (carry != 0 as usize) {
              chunk = buf_take_bytes(carry);
              buf_free(carry);
              carry = 0 as usize;
            }
            final = true;
            got = true;
          } else {
            name = files[fi];
            fi = fi + 1;
            is_stdin = name == "-";
            if (is_stdin) {
              r = stdin();
              have_reader = true;
            } else {
              let opened: boolean = false;
              match (open_reader(name)) {
                Ok(f) => {
                  r = f;
                  opened = true;
                },
                Err(e) => {
                  o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
                  ok = false;
                }
              }
              have_reader = opened;
            }
          }
        } else {
          let piece: u8[] = [];
          let read_ok: boolean = true;
          match (r.read_chunk_bytes(read_size())) {
            Ok(c) => {
              piece = c;
            },
            Err(e) => {
              let message: string = gnu.io_error_text(e);
              match (r.stat()) {
                Ok(st) => {
                  if (st.is_dir) {
                    message = "Is a directory";
                  }
                },
                Err(_) => {}
              }
              o = gnu.error_out(o, gnu.quotef(name) + ": " + message);
              ok = false;
              read_ok = false;
            }
          }
          if (read_ok && piece.len() > 0) {
            chunk = piece;
            pos = 0;
            got = true;
          } else {
            if (!is_stdin) {
              r.close();
            }
            have_reader = false;
          }
        }
      }
      if (final && chunk.len() == 0) {
        break;
      }
      continue;
    }

    let j: i32 = __memchr_bytes(chunk, 10, pos);
    if (j < 0) {
      if (!final) {
        if (carry == 0 as usize) {
          carry = buf_new(chunk.len() - pos);
        }
        buf_push_bytes_range(carry, chunk, pos, chunk.len());
        pos = chunk.len();
        continue;
      }
      j = chunk.len() - 1;
    }

    let buf: u8[] = chunk;
    let lo: i32 = pos;
    let hi: i32 = j + 1;
    if (carry != 0 as usize) {
      buf_push_bytes_range(carry, chunk, pos, j + 1);
      buf = buf_take_bytes(carry);
      buf_free(carry);
      carry = 0 as usize;
      lo = 0;
      hi = buf.len();
    }
    pos = j + 1;

    let lead: i32 = buf[lo] as i32;
    if (!convert_all && lead != 32 && lead != 9) {
      buf_push_bytes_range(h, buf, lo, hi);
    } else {
      let end: i32 = hi;
      let p: i32 = lo;
      let column: u64 = 0 as u64;
      let idx: i32 = 0;
      let convert: boolean = true;
      let pending: i32 = 0;
      let held: boolean = false;
      let after_nb: boolean = false;
      while (p < end) {
        let c: i32 = buf[p] as i32;
        if (convert && (c == 32 || c == 9)) {
          let target: u64 = 0 as u64;
          if (step != 0 as u64) {
            target = column + (step - column % step);
          } else {
            let nx: (u64, i32) = stops.next_column(column, idx);
            target = nx.0;
            idx = nx.1;
          }
          if (target == 0 as u64) {
            convert = false;
            while (pad.len() < pending) {
              pad = pad + "                                ";
            }
            buf_push_range(h, pad, 0, pending);
            pending = 0;
            held = false;
            buf_push_bytes_range(h, buf, p, end);
            p = end;
          } else {
            if (held) {
              buf_push_byte(h, 9);
              pending = 0;
              held = false;
              after_nb = false;
            }
            if (c == 9) {
              column = target;
              pending = 0;
              buf_push_byte(h, 9);
              after_nb = false;
            } else {
              column = column + 1 as u64;
              pending = pending + 1;
              if (column == target) {
                if (pending > 1 || !after_nb) {
                  buf_push_byte(h, 9);
                  pending = 0;
                  after_nb = false;
                } else {
                  held = true;
                }
              }
            }
            p = p + 1;
          }
        } else {
          while (pad.len() < pending) {
            pad = pad + "                                ";
          }
          buf_push_range(h, pad, 0, pending);
          pending = 0;
          held = false;
          if (!convert) {
            buf_push_bytes_range(h, buf, p, end);
            p = end;
          } else if (!convert_all) {
            buf_push_bytes_range(h, buf, p, end);
            p = end;
            convert = false;
          } else {
            let q: i32 = p;
            while (q < end) {
              let b: i32 = buf[q] as i32;
              if (b == 32 || b == 9) {
                break;
              }
              if (b == 8) {
                if (column > 0 as u64) {
                  column = column - 1 as u64;
                }
                if (idx > 0) {
                  idx = idx - 1;
                }
              } else if (b != 0) {
                column = column + 1 as u64;
              }
              q = q + 1;
            }
            buf_push_bytes_range(h, buf, p, q);
            p = q;
            after_nb = true;
          }
        }
      }
      while (pad.len() < pending) {
        pad = pad + "                                ";
      }
      buf_push_range(h, pad, 0, pending);
    }
    if (buf_len(h) >= block_size()) {
      o = o.flush();
    }
  }

  gnu.finish(o);
  if (!ok) {
    return 1;
  }
  return 0;
}
