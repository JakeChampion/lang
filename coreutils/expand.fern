import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/tabs";

function opt_tabs(): i32 {
  return 1;
}

function opt_initial(): i32 {
  return 2;
}

function opt_digit(d: i32): i32 {
  return 10 + d;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out += "Convert tabs in each FILE to spaces, writing to standard output.\n";
  out += "\n";
  out += "With no FILE, or when FILE is -, read standard input.\n";
  out += "\n";
  out += "  -i, --initial    do not convert tabs after non blanks\n";
  out += "  -t, --tabs=N     have tabs N characters apart, not 8\n";
  out += "  -t, --tabs=LIST  use comma separated list of tab positions\n";
  out += "                     The last specified position can be prefixed with '/'\n";
  out += "                     to specify a tab size to use after the last\n";
  out += "                     explicitly specified tab stop.  Also a prefix of '+'\n";
  out += "                     can be used to align remaining tab stops relative to\n";
  out += "                     the last specified tab stop instead of the first column\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  return out;
}

function read_size(): i32 {
  return 65536;
}

function block_size(): i32 {
  return 16384;
}

function digit_of(id: i32): string {
  return slice_unchecked("0123456789", id - 10, id - 9) + "";
}

pub function main(): i32 {
  let argv = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("t", "tabs", opt_tabs()));
  opts = opts.append(gnu.flag("i", "initial", opt_initial()));
  let d = 0;
  while (d < 10) {
    opts = opts.append(gnu.optional(slice_unchecked("0123456789", d, d + 1) + "", "", opt_digit(d)));
    d += 1;
  }

  let stops = tabs.tabs_new();
  let initial = false;
  let g = gnu.getopt_new(argv, opts, "expand", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_tabs()) {
          stops = stops.parse(m.value);
        } else if (m.id == opt_initial()) {
          initial = true;
        } else {
          stops = stops.parse(digit_of(m.id) + m.value);
        }
      },
      None => {
        break;
      }
    }
  }
  stops = stops.finish();

  let files = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  return run(files, stops, initial);
}

function run(files: string[], stops: tabs.Tabs, initial: boolean): i32 {
  let o = gnu.out_with(block_size());
  let h = o.handle();
  let pad = "        ";
  let ok = true;
  let step = stops.size;

  let fi = 0;
  let have_reader = false;
  let is_stdin = false;
  let name = "";
  let r = stdin();
  let chunk: u8[] = [];
  let pos = 0;
  let tabat: i32 = -1;
  let bsat: i32 = -1;
  let nulat: i32 = -1;
  let carry = 0 as usize;
  let final = false;

  while (true) {
    if (pos >= chunk.len()) {
      if (final) {
        break;
      }
      chunk = [];
      pos = 0;
      let got = false;
      while (!got) {
        if (!have_reader) {
          if (fi >= files.len()) {
            if (carry != 0 as usize) {
              chunk = buf_take_bytes(carry);
              buf_free(carry);
              carry = 0 as usize;
            }
            final = true;
            got = true;
          } else {
            name = files[fi];
            fi += 1;
            is_stdin = name == "-";
            if (is_stdin) {
              r = stdin();
              have_reader = true;
            } else {
              let opened = false;
              match (open_reader(name)) {
                Ok(f) => {
                  r = f;
                  opened = true;
                },
                Err(e) => {
                  o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
                  ok = false;
                }
              }
              have_reader = opened;
            }
          }
        } else {
          let piece: u8[] = [];
          let read_ok = true;
          match (r.read_chunk_bytes(read_size())) {
            Ok(c) => {
              piece = c;
            },
            Err(e) => {
              let message = gnu.io_error_text(e);
              match (r.stat()) {
                Ok(st) => {
                  if (st.is_dir) {
                    message = "Is a directory";
                  }
                },
                Err(_) => {}
              }
              o = gnu.error_out(o, gnu.quotef(name) + ": " + message);
              ok = false;
              read_ok = false;
            }
          }
          if (read_ok && piece.len() > 0) {
            chunk = piece;
            pos = 0;
            tabat = __memchr_bytes(chunk, 9, 0);
            bsat = __memchr_bytes(chunk, 8, 0);
            nulat = __memchr_bytes(chunk, 0, 0);
            got = true;
          } else {
            if (!is_stdin) {
              r.close();
              r = stdin();
            }
            have_reader = false;
          }
        }
      }
      if (final) {
        tabat = __memchr_bytes(chunk, 9, 0);
        bsat = __memchr_bytes(chunk, 8, 0);
        nulat = __memchr_bytes(chunk, 0, 0);
        if (chunk.len() == 0) {
          break;
        }
      }
      continue;
    }

    let j = __memchr_bytes(chunk, 10, pos);
    if (j < 0) {
      if (!final) {
        if (carry == 0 as usize) {
          carry = buf_new(chunk.len() - pos);
        }
        buf_push_bytes_range(carry, chunk, pos, chunk.len());
        pos = chunk.len();
        continue;
      }
      j = chunk.len() - 1;
    }

    let buf = chunk;
    let lo = pos;
    let hi = j + 1;
    let carried = carry != 0 as usize;
    if (carried) {
      buf_push_bytes_range(carry, chunk, pos, j + 1);
      buf = buf_take_bytes(carry);
      buf_free(carry);
      carry = 0 as usize;
      lo = 0;
      hi = buf.len();
    }
    pos = j + 1;

    let ta = tabat;
    let ba = bsat;
    let na = nulat;
    if (carried) {
      ta = __memchr_bytes(buf, 9, 0);
      ba = __memchr_bytes(buf, 8, 0);
      na = __memchr_bytes(buf, 0, 0);
    }
    if (ta < 0 || ta >= hi) {
      buf_push_bytes_range(h, buf, lo, hi);
    } else {
      let end = hi;
      if (initial) {
        end = lo;
        while (end < hi && (buf[end] as i32 == 32 || buf[end] as i32 == 9)) {
          end += 1;
        }
      }
      let p = lo;
      let column = 0 as u64;
      let idx = 0;
      while (p < end) {
        let k = end;
        if (ta >= p && ta < k) {
          k = ta;
        }
        if (ba >= p && ba < k) {
          k = ba;
        }
        if (na >= p && na < k) {
          k = na;
        }
        if (k > p) {
          buf_push_bytes_range(h, buf, p, k);
          column = column + (k - p) as u64;
          p = k;
        }
        if (p >= end) {
          break;
        }
        let c = buf[p] as i32;
        p += 1;
        if (c == 0) {
          buf_push_byte(h, c);
          na = __memchr_bytes(buf, 0, p);
        } else if (c == 8) {
          if (column > 0 as u64) {
            column = column - 1 as u64;
          }
          if (idx > 0) {
            idx -= 1;
          }
          buf_push_byte(h, c);
          ba = __memchr_bytes(buf, 8, p);
        } else {
          let target = 0 as u64;
          if (step != 0 as u64) {
            target = column + (step - column % step);
          } else {
            let nx: (u64, i32) = stops.next_column(column, idx);
            target = nx.0;
            idx = nx.1;
          }
          if (target == 0 as u64) {
            target = column + 1 as u64;
          }
          let need = target - column;
          column = target;
          if (need <= 8 as u64) {
            buf_push_range(h, pad, 0, need as i32);
          } else {
            while (need > 0 as u64) {
              let take = 4096;
              if (need < 4096 as u64) {
                take = need as i32;
              }
              while (pad.len() < take) {
                pad += "                                ";
              }
              buf_push_range(h, pad, 0, take);
              need = need - take as u64;
              if (buf_len(h) >= block_size()) {
                o = gnu.flush(o);
              }
            }
          }
          ta = __memchr_bytes(buf, 9, p);
        }
      }
      if (p < hi) {
        buf_push_bytes_range(h, buf, p, hi);
      }
    }
    tabat = ta;
    bsat = ba;
    nulat = na;
    if (carried || tabat >= 0 && tabat < pos) {
      tabat = __memchr_bytes(chunk, 9, pos);
    }
    if (carried || bsat >= 0 && bsat < pos) {
      bsat = __memchr_bytes(chunk, 8, pos);
    }
    if (carried || nulat >= 0 && nulat < pos) {
      nulat = __memchr_bytes(chunk, 0, pos);
    }
    if (buf_len(h) >= block_size()) {
      o = gnu.flush(o);
    }
  }

  gnu.finish(o);
  if (!ok) {
    return 1;
  }
  return 0;
}
