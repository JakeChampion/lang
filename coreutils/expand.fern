// expand.fern — GNU-compatible `expand`.
//
//   expand [-i] [-t LIST] [FILE]...
//
// Every tab becomes the spaces that reach the next tab stop. The stops
// are eight columns apart by default and `-t` gives them explicitly
// (`coreutils/lib/tabs.fern` holds that grammar, which unexpand shares);
// `-i` converts only the tabs in a line's leading blanks.
//
// Three behaviours are the reference binary's rather than the obvious
// reading:
//
//   - Column counting is not byte counting: `\b` moves BACK a column and
//     rewinds the stop cursor with it, so `ab\b\t` reaches the stop from
//     column 1.
//   - Past the last explicit stop a tab is ONE space, not a stop's worth:
//     `-t 1,4,8` leaves the fourth tab on a line as a single space.
//   - Files are one stream, not a file each. A FILE with no final newline
//     runs into the next one, and the column count runs with it.
import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/tabs";

// Option ids. The declaration order below is GNU's — `expand --=x` lists
// `--tabs` before `--initial`, which is the reverse of the help text.
function opt_tabs(): i32 {
  return 1;
}

function opt_initial(): i32 {
  return 2;
}

// The obsolete `-NUM` form is the ten digits declared as options taking
// an OPTIONAL value, so `-4,8` is the digit 4 with ",8" glued on and the
// tab list is the two put back together. Each digit gets its own id so
// the digit itself needs no second look at argv.
function opt_digit(d: i32): i32 {
  return 10 + d;
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out = out + "Convert tabs in each FILE to spaces, writing to standard output.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -i, --initial    do not convert tabs after non blanks\n";
  out = out + "  -t, --tabs=N     have tabs N characters apart, not 8\n";
  out = out + "  -t, --tabs=LIST  use comma separated list of tab positions\n";
  out = out + "                     The last specified position can be prefixed with '/'\n";
  out = out + "                     to specify a tab size to use after the last\n";
  out = out + "                     explicitly specified tab stop.  Also a prefix of '+'\n";
  out = out + "                     can be used to align remaining tab stops relative to\n";
  out = out + "                     the last specified tab stop instead of the first column\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

// Bytes per read(2), and the writer's threshold: bytes per write(2).
function read_size(): i32 {
  return 65536;
}

function block_size(): i32 {
  return 16384;
}

// `digit_of(m)` — the digit an `opt_digit` match stood for.
function digit_of(id: i32): string {
  return slice_unchecked("0123456789", id - 10, id - 9) + "";
}

function main(): i32 {
  var argv: string[] = args();
  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("t", "tabs", opt_tabs()));
  opts = opts.append(gnu.flag("i", "initial", opt_initial()));
  var d: i32 = 0;
  while (d < 10) {
    opts = opts.append(gnu.optional(slice_unchecked("0123456789", d, d + 1) + "", "", opt_digit(d)));
    d = d + 1;
  }

  var stops: tabs.Tabs = tabs.tabs_new();
  var initial: boolean = false;
  var g: gnu.Getopt = gnu.getopt_new(argv, opts, "expand", help_text(), 1);
  while (true) {
    var r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_tabs()) {
          stops = stops.parse(m.value);
        } else if (m.id == opt_initial()) {
          initial = true;
        } else {
          stops = stops.parse(digit_of(m.id) + m.value);
        }
      },
      None => {
        break;
      }
    }
  }
  // The stops are checked only once the scan is over: `expand -t 0 -x`
  // reports the option, and `expand --tabs=0 --help` prints the help.
  stops = stops.finish();

  var files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  return run(files, stops, initial);
}

// `run(files, stops, initial)` — the whole conversion. Every piece of a
// line is pushed straight into stdout's builder, which is flushed once it
// holds a block, so no byte is copied into an accumulator on the way.
function run(files: string[], stops: tabs.Tabs, initial: boolean): i32 {
  var o: io_buffered.BufWriter = gnu.out_with(block_size());
  var h: usize = o.handle();
  var pad: string = "        ";
  var ok: boolean = true;
  // Non-zero when every stop is the same distance apart, which is the
  // case for a default run and for `-t N`.
  var step: u64 = stops.size;

  var fi: i32 = 0;
  var have_reader: boolean = false;
  var is_stdin: boolean = false;
  var name: string = "";
  var r: Reader = stdin();
  var chunk: string = "";
  var pos: i32 = 0;
  var tabat: i32 = 0 - 1;
  var bsat: i32 = 0 - 1;
  var carry: string = "";
  var final: boolean = false;

  while (true) {
    if (pos >= chunk.len()) {
      if (final) {
        break;
      }
      chunk = "";
      pos = 0;
      var got: boolean = false;
      while (!got) {
        if (!have_reader) {
          if (fi >= files.len()) {
            chunk = carry;
            carry = "";
            final = true;
            got = true;
          } else {
            name = files[fi];
            fi = fi + 1;
            is_stdin = name == "-";
            if (is_stdin) {
              r = stdin();
              have_reader = true;
            } else {
              var opened: boolean = false;
              match (open_reader(name)) {
                Ok(f) => {
                  r = f;
                  opened = true;
                },
                Err(e) => {
                  o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
                  ok = false;
                }
              }
              have_reader = opened;
            }
          }
        } else {
          var piece: string = "";
          var read_ok: boolean = true;
          match (r.read_chunk(read_size())) {
            Ok(c) => {
              piece = c;
            },
            Err(e) => {
              o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
              ok = false;
              read_ok = false;
            }
          }
          if (read_ok && piece.len() > 0) {
            chunk = piece;
            pos = 0;
            tabat = __memchr(chunk, 9, 0);
            bsat = __memchr(chunk, 8, 0);
            got = true;
          } else {
            if (!is_stdin) {
              r.close();
            }
            have_reader = false;
          }
        }
      }
      if (final) {
        tabat = __memchr(chunk, 9, 0);
        bsat = __memchr(chunk, 8, 0);
        if (chunk.len() == 0) {
          break;
        }
      }
      continue;
    }

    var j: i32 = __memchr(chunk, 10, pos);
    if (j < 0) {
      if (!final) {
        carry = carry + slice_unchecked(chunk, pos, chunk.len());
        pos = chunk.len();
        continue;
      }
      j = chunk.len() - 1;
    }

    // One line, terminator included. It stays a view into the chunk
    // unless a partial line from an earlier chunk has to be glued on.
    var buf: string = chunk;
    var lo: i32 = pos;
    var hi: i32 = j + 1;
    var carried: boolean = carry.len() > 0;
    if (carried) {
      buf = carry + slice_unchecked(chunk, pos, j + 1);
      carry = "";
      lo = 0;
      hi = buf.len();
    }
    pos = j + 1;

    // Where the next tab and the next backspace are. Both are cursors
    // over the chunk, so finding every one of them costs a single pass
    // over it rather than a scan per line.
    var ta: i32 = tabat;
    var ba: i32 = bsat;
    if (carried) {
      ta = __memchr(buf, 9, 0);
      ba = __memchr(buf, 8, 0);
    }
    if (ta < 0 || ta >= hi) {
      // No tab on this line, so nothing on it converts and a backspace
      // has nothing to move the column of.
      buf_push_range(h, buf, lo, hi);
    } else {
      var end: i32 = hi;
      if (initial) {
        // -i converts only the leading blanks; everything from the
        // first other byte is copied as it stands.
        end = lo;
        while (end < hi && (buf[end] as i32 == 32 || buf[end] as i32 == 9)) {
          end = end + 1;
        }
      }
      var p: i32 = lo;
      var column: u64 = 0 as u64;
      var idx: i32 = 0;
      while (p < end) {
        var k: i32 = end;
        if (ta >= p && ta < k) {
          k = ta;
        }
        if (ba >= p && ba < k) {
          k = ba;
        }
        if (k > p) {
          buf_push_range(h, buf, p, k);
          column = column + (k - p) as u64;
          p = k;
        }
        if (p >= end) {
          break;
        }
        var c: i32 = buf[p] as i32;
        p = p + 1;
        if (c == 8) {
          if (column > 0 as u64) {
            column = column - 1 as u64;
          }
          if (idx > 0) {
            idx = idx - 1;
          }
          buf_push_byte(h, c);
          ba = __memchr(buf, 8, p);
        } else {
          // The uniform case is most of them, and it is arithmetic:
          // taking it here keeps the call and its tuple out of the
          // inner loop.
          var target: u64 = 0 as u64;
          if (step != 0 as u64) {
            target = column + (step - column % step);
          } else {
            var nx: (u64, i32) = stops.next_column(column, idx);
            target = nx.0;
            idx = nx.1;
          }
          if (target == 0 as u64) {
            target = column + 1 as u64;
          }
          var need: u64 = target - column;
          column = target;
          if (need <= 8 as u64) {
            // The pad always holds a tab's usual width, so the common
            // tab is one range push out of it.
            buf_push_range(h, pad, 0, need as i32);
          } else {
            while (need > 0 as u64) {
              var take: i32 = 4096;
              if (need < 4096 as u64) {
                take = need as i32;
              }
              while (pad.len() < take) {
                pad = pad + "                                ";
              }
              buf_push_range(h, pad, 0, take);
              need = need - take as u64;
              if (buf_len(h) >= block_size()) {
                o = o.flush();
              }
            }
          }
          ta = __memchr(buf, 9, p);
        }
      }
      if (p < hi) {
        buf_push_range(h, buf, p, hi);
      }
    }
    // Back to chunk indices, and past anything this line left behind:
    // -i can stop before the end of a line, so a tab it never reached
    // is still ahead of the cursor.
    tabat = ta;
    bsat = ba;
    if (carried || tabat >= 0 && tabat < pos) {
      tabat = __memchr(chunk, 9, pos);
    }
    if (carried || bsat >= 0 && bsat < pos) {
      bsat = __memchr(chunk, 8, pos);
    }
    if (buf_len(h) >= block_size()) {
      o = o.flush();
    }
  }

  gnu.finish(o);
  if (!ok) {
    return 1;
  }
  return 0;
}
