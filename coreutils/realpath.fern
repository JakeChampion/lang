// realpath.fern — GNU-compatible `realpath`.
//
//   realpath [OPTION]... FILE...
//
// The resolved absolute name of each operand. The walk itself is
// `lib/canon.fern`, which `readlink -f/-e/-m` runs too; what realpath
// adds is a second axis and the relative output.
//
// The axis `-e` / `-m` chooses is how much has to exist — every
// component, or none, with "all but the last" in between as the
// default. The axis `-P` / `-L` / `-s` chooses is what happens to
// symbolic links, and the three are one setting with the last one
// winning:
//
//   -P  physical (default)   links are followed as they are met, so a
//                            `..` pops what the link RESOLVED to
//   -s  no symlinks          links are not read at all, so a `..`
//                            pops the name as it was written
//   -L  logical              both, in that order: the name is first
//                            resolved without reading any link, and
//                            that answer is then resolved physically
//
// `--relative-to` and `--relative-base` are pure string work over the
// answers. Both DIRs are resolved the same way the operands are, and
// a DIR that will not resolve ends the program before any operand is
// printed — `-q` does not cover it, because it is not one operand's
// failure.
import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";
import "./lib/canon";

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... FILE...\n";
  out = out + "Print the resolved absolute file name;\n";
  out = out + "all but the last component must exist\n";
  out = out + "\n";
  out = out + "  -e, --canonicalize-existing  all components of the path must exist\n";
  out = out + "  -m, --canonicalize-missing   no path components need exist or be a directory\n";
  out = out + "  -L, --logical                resolve '..' components before symlinks\n";
  out = out + "  -P, --physical               resolve symlinks as encountered (default)\n";
  out = out + "  -q, --quiet                  suppress most error messages\n";
  out = out + "      --relative-to=DIR        print the resolved path relative to DIR\n";
  out = out + "      --relative-base=DIR      print absolute paths unless paths below DIR\n";
  out = out + "  -s, --strip, --no-symlinks   don't expand symlinks\n";
  out = out + "  -z, --zero                   end each output line with NUL, not newline\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function opt_existing(): i32 {
  return 1;
}

function opt_missing(): i32 {
  return 2;
}

function opt_logical(): i32 {
  return 3;
}

function opt_physical(): i32 {
  return 4;
}

function opt_quiet(): i32 {
  return 5;
}

function opt_relative_to(): i32 {
  return 6;
}

function opt_relative_base(): i32 {
  return 7;
}

function opt_strip(): i32 {
  return 8;
}

function opt_zero(): i32 {
  return 9;
}

// The three link settings, one number since only the last one given
// counts.
function link_physical(): i32 {
  return 0;
}

function link_logical(): i32 {
  return 1;
}

function link_strip(): i32 {
  return 2;
}

// `resolve(name, mode, links)` — one operand's answer. `-L` is the
// only one that is not a single walk: the lexical pass settles every
// `..` against the name as written, and the physical pass then
// resolves the links of what is left.
function resolve(name: string, mode: i32, links: i32): Result[string, IoError] {
  if (links == link_strip()) {
    return canon.canonicalize(name, mode, true);
  }
  if (links == link_physical()) {
    return canon.canonicalize(name, mode, false);
  }
  match (canon.canonicalize(name, mode, true)) {
    Ok(lexical) => {
      return canon.canonicalize(lexical, mode, false);
    },
    Err(e) => {
      return Err(e);
    }
  }
}

// Whether `p` is `base` or lies under it. The comparison is by
// component, so `/a/bc` is not under `/a/b`.
function under(base: string, p: string): boolean {
  if (base.len() == 1) {
    return true;
  }
  if (p == base) {
    return true;
  }
  return p.starts_with(base + "/");
}

// One DIR the relative output is measured against, or the end of the
// program. It is not one operand's failure, so `-q` does not cover it
// and nothing that follows runs.
function resolve_dir(dir: string, mode: i32, links: i32): string {
  match (resolve(dir, mode, links)) {
    Ok(p) => {
      return p;
    },
    Err(e) => {
      gnu.error(gnu.quotef(dir) + ": " + gnu.io_error_text(e));
      exit(1);
    }
  }
  return "";
}

function main(): i32 {
  // Declaration order, which the ambiguity list prints and which is
  // NOT the order `--help` lists them in: `--logical` and `--physical`
  // come last of the utility's own options, after `--zero`.
  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("e", "canonicalize-existing", opt_existing()));
  opts = opts.append(gnu.flag("m", "canonicalize-missing", opt_missing()));
  opts = opts.append(gnu.valued("", "relative-to", opt_relative_to()));
  opts = opts.append(gnu.valued("", "relative-base", opt_relative_base()));
  opts = opts.append(gnu.flag("q", "quiet", opt_quiet()));
  opts = opts.append(gnu.flag("s", "strip", opt_strip()));
  opts = opts.append(gnu.flag("", "no-symlinks", opt_strip()));
  opts = opts.append(gnu.flag("z", "zero", opt_zero()));
  opts = opts.append(gnu.flag("L", "logical", opt_logical()));
  opts = opts.append(gnu.flag("P", "physical", opt_physical()));

  var mode: i32 = canon.all_but_last();
  var links: i32 = link_physical();
  var quiet: boolean = false;
  var zero: boolean = false;
  var rel_to: string = "";
  var have_rel_to: boolean = false;
  var rel_base: string = "";
  var have_rel_base: boolean = false;

  var g: gnu.Getopt = gnu.getopt_new(args(), opts, "realpath", help_text(), 1);
  while (true) {
    var r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_existing()) {
          mode = canon.existing();
        } else if (m.id == opt_missing()) {
          mode = canon.missing();
        } else if (m.id == opt_logical()) {
          links = link_logical();
        } else if (m.id == opt_physical()) {
          links = link_physical();
        } else if (m.id == opt_strip()) {
          links = link_strip();
        } else if (m.id == opt_quiet()) {
          quiet = true;
        } else if (m.id == opt_zero()) {
          zero = true;
        } else if (m.id == opt_relative_to()) {
          rel_to = m.value;
          have_rel_to = true;
        } else if (m.id == opt_relative_base()) {
          rel_base = m.value;
          have_rel_base = true;
        }
      },
      None => {
        break;
      }
    }
  }

  var operands: string[] = g.operands();
  if (operands.len() == 0) {
    gnu.die_usage("missing operand", 1);
  }

  // A base with no `--relative-to` beside it is the DIR to measure
  // from as well as the one to stay under.
  if (have_rel_base && !have_rel_to) {
    rel_to = rel_base;
    have_rel_to = true;
  }
  var from: string = "";
  if (have_rel_to) {
    from = resolve_dir(rel_to, mode, links);
  }
  var base: string = "";
  if (have_rel_base) {
    base = resolve_dir(rel_base, mode, links);
    // A DIR to measure from that is not itself under the base leaves
    // nothing that could be printed relative to it.
    if (!under(base, from)) {
      have_rel_to = false;
    }
  }

  var term: string = "\n";
  if (zero) {
    term = "\x00";
  }
  var status: i32 = 0;
  var o: io_buffered.BufWriter = gnu.out_new();
  var i: i32 = 0;
  while (i < operands.len()) {
    var name: string = operands[i];
    match (resolve(name, mode, links)) {
      Ok(p) => {
        var out: string = p;
        if (have_rel_to && (!have_rel_base || under(base, p))) {
          out = canon.relative(p, from);
        }
        o = gnu.put(o, out + term);
      },
      Err(e) => {
        if (!quiet) {
          o = gnu.error_out(o, gnu.quotef(name) + ": " + gnu.io_error_text(e));
        }
        status = 1;
      }
    }
    i = i + 1;
  }
  gnu.finish(o);
  return status;
}
