import "std/string";
import "./lib/gnu";

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]...\n";
  out = out + "Print the full filename of the current working directory.\n";
  out = out + "\n";
  out = out + "  -L, --logical   use PWD from environment, even if it contains symlinks\n";
  out = out + "  -P, --physical  avoid all symlinks\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  out = out + "\n";
  out = out + "If no option is specified, -P is assumed.\n";
  return out;
}

function opt_logical(): i32 {
  return 1;
}

function opt_physical(): i32 {
  return 2;
}

function has_dot_component(wd: string): boolean {
  let i: i32 = 0;
  while (i + 1 < wd.len()) {
    if (wd[i] as i32 == 47 && wd[i + 1] as i32 == 46) {
      let after: i32 = i + 2;
      if (after >= wd.len() || wd[after] as i32 == 47) {
        return true;
      }
      if (wd[after] as i32 == 46) {
        let after2: i32 = after + 1;
        if (after2 >= wd.len() || wd[after2] as i32 == 47) {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

function logical_cwd(): Option[string] {
  let wd: string = "";
  match (env("PWD")) {
    Some(v) => {
      wd = v;
    },
    None => {
      return None;
    }
  }
  if (wd.len() == 0 || wd[0] as i32 != 47) {
    return None;
  }
  if (has_dot_component(wd)) {
    return None;
  }
  match (stat(wd)) {
    Ok(named) => {
      match (stat(".")) {
        Ok(here) => {
          if (named.dev == here.dev && named.ino == here.ino) {
            return Some(wd);
          }
        },
        Err(_) => {}
      }
    },
    Err(_) => {}
  }
  return None;
}

function die(msg: string): void {
  gnu.error(msg);
  exit(1);
}

function die_errno(msg: string, e: IoError): void {
  die(msg + ": " + gnu.io_error_text(e));
}

function walked_cwd(): string {
  let root: FileStat = stat_or_die(stat("/"), "failed to get attributes of " + gnu.quotea("/"));
  let here: FileStat = stat_or_die(stat("."), "failed to stat " + gnu.quotea("."));
  let name: string = "";
  let prefix: string = "..";
  while (!(here.dev == root.dev && here.ino == root.ino)) {
    let entries: string[] = [];
    match (read_dir(prefix)) {
      Ok(es) => {
        entries = es;
      },
      Err(e) => {
        die_errno("cannot open directory " + gnu.quote(prefix), e);
      }
    }
    let parent: FileStat = stat_or_die(stat(prefix), "failed to stat " + gnu.quote(prefix));
    let found: string = "";
    let matched: boolean = false;
    let i: i32 = 0;
    while (i < entries.len()) {
      match (lstat(prefix + "/" + entries[i])) {
        Ok(st) => {
          if (st.ino == here.ino && st.dev == here.dev) {
            found = entries[i];
            matched = true;
            break;
          }
        },
        Err(_) => {}
      }
      i = i + 1;
    }
    if (!matched) {
      die("couldn't find directory entry in " + gnu.quote(prefix) + " with matching i-node");
    }
    name = "/" + found + name;
    here = parent;
    prefix = prefix + "/..";
  }
  if (name.len() == 0) {
    return "/";
  }
  return name;
}

function stat_or_die(r: Result[FileStat, IoError], msg: string): FileStat {
  match (r) {
    Ok(st) => {
      return st;
    },
    Err(e) => {
      die_errno(msg, e);
    }
  }
  return FileStat { is_file: false, is_dir: false, size: 0, mode: 0 as u32, nlink: 0 as u32, uid: 0 as u32, gid: 0 as u32, dev: 0, rdev: 0, ino: 0, blksize: 0, blocks: 0, atime: 0, atime_nsec: 0, mtime: 0, mtime_nsec: 0, ctime: 0, ctime_nsec: 0, btime: 0, btime_nsec: 0 };
}

pub function main(): i32 {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("L", "logical", opt_logical()));
  opts = opts.append(gnu.flag("P", "physical", opt_physical()));

  let logical: boolean = false;
  match (env("POSIXLY_CORRECT")) {
    Some(_) => {
      logical = true;
    },
    None => {}
  }

  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "pwd", help_text(), 1);
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(m) => {
        logical = m.id == opt_logical();
      },
      None => {
        break;
      }
    }
  }
  if (g.operands().len() > 0) {
    gnu.error("ignoring non-option arguments");
  }

  if (logical) {
    match (logical_cwd()) {
      Some(wd) => {
        gnu.write_out(wd + "\n");
        return 0;
      },
      None => {}
    }
  }
  match (getcwd()) {
    Ok(wd) => {
      gnu.write_out(wd + "\n");
    },
    Err(_) => {
      gnu.write_out(walked_cwd() + "\n");
    }
  }
  return 0;
}
