import "std/i64";
import "std/hash/bsd_sum";
import "std/hash/sysv_sum";
import "std/io_buffered";
import "./lib/gnu";

function opt_bsd(): i32 {
  return 1;
}

function opt_sysv(): i32 {
  return 2;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out += "Print a 16-bit checksum and a block count for each FILE.\n";
  out += "\n";
  out += "With no FILE, or when FILE is -, read standard input.\n";
  out += "\n";
  out += "  -r              use BSD sum algorithm (the default), use 1K blocks\n";
  out += "  -s, --sysv      use System V sum algorithm, use 512 bytes blocks\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  return out;
}

struct Ctx { sysv: boolean, bsd: bsd_sum.BsdSum, sv: sysv_sum.SysvSum }

function ctx_new(sysv: boolean): Ctx {
  return Ctx { sysv: sysv, bsd: bsd_sum.new(), sv: sysv_sum.new() };
}

function ctx_update(c: Ctx, chunk: u8[]): Ctx {
  if (c.sysv) {
    return Ctx { ...c, sv: c.sv.update(chunk) };
  }
  return Ctx { ...c, bsd: c.bsd.update(chunk) };
}

function ctx_checksum(c: Ctx): i64 {
  if (c.sysv) {
    return c.sv.finish() as i64;
  }
  return c.bsd.finish() as i64;
}

function ctx_blocks(c: Ctx): i64 {
  if (c.sysv) {
    return c.sv.blocks() as i64;
  }
  return c.bsd.blocks() as i64;
}

struct Tally { checksum: i64, blocks: i64, err: Option[IoError], failed: boolean }

function read_size(): i32 {
  return 65536;
}

function sum_reader(own r: Reader, sysv: boolean, owned: boolean): Tally {
  let c = ctx_new(sysv);
  while (true) {
    match (r.read_chunk_bytes(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          break;
        }
        c = ctx_update(c, chunk);
      },
      Err(e) => {
        if (owned) {
          r.close();
        }
        return Tally { checksum: 0 as i64, blocks: 0 as i64, err: Some(e), failed: true };
      }
    }
  }
  if (owned) {
    r.close();
  }
  return Tally { checksum: ctx_checksum(c), blocks: ctx_blocks(c), err: None, failed: false };
}

function sum_path(path: string, sysv: boolean): Tally {
  if (path == "-") {
    return sum_reader(stdin(), sysv, false);
  }
  match (open_reader(path)) {
    Ok(r) => {
      return sum_reader(r, sysv, true);
    },
    Err(e) => {
      return Tally { checksum: 0 as i64, blocks: 0 as i64, err: Some(e), failed: true };
    }
  }
}

function pad(s: string, width: i32, zero: boolean): string {
  let n = width - s.len();
  if (n <= 0) {
    return s;
  }
  if (zero) {
    return "0".repeat(n) + s;
  }
  return " ".repeat(n) + s;
}

function line_for(t: Tally, sysv: boolean, name: string, named: boolean): string {
  let out = "";
  if (sysv) {
    out = t.checksum.to_string() + " " + t.blocks.to_string();
  } else {
    out = pad(t.checksum.to_string(), 5, true) + " " + pad(t.blocks.to_string(), 5, false);
  }
  if (named) {
    out = out + " " + name;
  }
  return out + "\n";
}

pub function main(): i32 {
  let argv = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("r", "", opt_bsd()));
  opts = opts.append(gnu.flag("s", "sysv", opt_sysv()));

  let sysv = false;
  let g = gnu.getopt_new(argv, opts, "sum", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        sysv = m.id == opt_sysv();
      },
      None => {
        break;
      }
    }
  }

  let operands = g.operands();
  let named = operands.len() > 0;
  if (!named) {
    operands = ["-"];
  }

  let out = gnu.out_new();
  let ok = true;
  let i = 0;
  while (i < operands.len()) {
    let t = sum_path(operands[i], sysv);
    if (t.failed) {
      ok = false;
      match (t.err) {
        Some(e) => {
          out = gnu.error_out(out, gnu.quotef(operands[i]) + ": " + gnu.io_error_text(e));
        },
        None => {}
      }
    } else {
      out = gnu.flush(gnu.put(out, line_for(t, sysv, operands[i], named)));
    }
    i += 1;
  }
  gnu.close_stdout(out, false);
  if (!ok) {
    return 1;
  }
  return 0;
}
