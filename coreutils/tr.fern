import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";

function opt_complement(): i32 {
  return 1;
}

function opt_delete(): i32 {
  return 2;
}

function opt_squeeze(): i32 {
  return 3;
}

function opt_truncate(): i32 {
  return 4;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... STRING1 [STRING2]\n";
  out += "Translate, squeeze, and/or delete characters from standard input,\n";
  out += "writing to standard output.  STRING1 and STRING2 specify arrays of\n";
  out += "characters ARRAY1 and ARRAY2 that control the action.\n";
  out += "\n";
  out += "  -c, -C, --complement    use the complement of ARRAY1\n";
  out += "  -d, --delete            delete characters in ARRAY1, do not translate\n";
  out += "  -s, --squeeze-repeats   replace each sequence of a repeated character\n";
  out += "                            that is listed in the last specified ARRAY,\n";
  out += "                            with a single occurrence of that character\n";
  out += "  -t, --truncate-set1     first truncate ARRAY1 to length of ARRAY2\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  out += "\n";
  out += "ARRAYs are specified as strings of characters.  Most represent themselves.\n";
  out += "Interpreted sequences are:\n";
  out += "\n";
  out += "  \\NNN            character with octal value NNN (1 to 3 octal digits)\n";
  out += "  \\\\              backslash\n";
  out += "  \\a              audible BEL\n";
  out += "  \\b              backspace\n";
  out += "  \\f              form feed\n";
  out += "  \\n              new line\n";
  out += "  \\r              return\n";
  out += "  \\t              horizontal tab\n";
  out += "  \\v              vertical tab\n";
  out += "  CHAR1-CHAR2     all characters from CHAR1 to CHAR2 in ascending order\n";
  out += "  [CHAR*]         in ARRAY2, copies of CHAR until length of ARRAY1\n";
  out += "  [CHAR*REPEAT]   REPEAT copies of CHAR, REPEAT octal if starting with 0\n";
  out += "  [:alnum:]       all letters and digits\n";
  out += "  [:alpha:]       all letters\n";
  out += "  [:blank:]       all horizontal whitespace\n";
  out += "  [:cntrl:]       all control characters\n";
  out += "  [:digit:]       all digits\n";
  out += "  [:graph:]       all printable characters, not including space\n";
  out += "  [:lower:]       all lower case letters\n";
  out += "  [:print:]       all printable characters, including space\n";
  out += "  [:punct:]       all punctuation characters\n";
  out += "  [:space:]       all horizontal or vertical whitespace\n";
  out += "  [:upper:]       all upper case letters\n";
  out += "  [:xdigit:]      all hexadecimal digits\n";
  out += "  [=CHAR=]        all characters which are equivalent to CHAR\n";
  out += "\n";
  out += "Translation occurs if -d is not given and both STRING1 and STRING2 appear.\n";
  out += "-t is only significant when translating.  ARRAY2 is extended to length of\n";
  out += "ARRAY1 by repeating its last character as necessary.  Excess characters\n";
  out += "of ARRAY2 are ignored.  Character classes expand in unspecified order;\n";
  out += "while translating, [:lower:] and [:upper:] may be used in pairs to\n";
  out += "specify case conversion.  Squeezing occurs after translation or deletion.\n";
  return out;
}

function chr(b: i32): string {
  return unsafe { string_from_bytes_unchecked([b as u8]) };
}

function is_octal(c: i32): boolean {
  return c >= 48 && c <= 55;
}

function printable_char(c: i32): string {
  if (c >= 32 && c < 127) {
    return chr(c);
  }
  return "\\" + octal3(c);
}

function octal3(c: i32): string {
  return chr(48 + c / 64 % 8) + chr(48 + c / 8 % 8) + chr(48 + c % 8);
}

function printable_str(s: u8[]): string {
  let out = "";
  let i = 0;
  while (i < s.len()) {
    let c = s[i] as i32;
    if (c == 7) {
      out += "\\a";
    } else if (c == 8) {
      out += "\\b";
    } else if (c == 12) {
      out += "\\f";
    } else if (c == 10) {
      out += "\\n";
    } else if (c == 13) {
      out += "\\r";
    } else if (c == 9) {
      out += "\\t";
    } else if (c == 11) {
      out += "\\v";
    } else if (c >= 32 && c < 127) {
      out += chr(c);
    } else {
      out = out + "\\" + octal3(c);
    }
    i += 1;
  }
  return out;
}

function class_name_is(bytes: u8[], text: string): boolean {
  if (bytes.len() != text.len()) {
    return false;
  }
  let i = 0;
  while (i < bytes.len()) {
    if (bytes[i] != text[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

function class_id(name: u8[]): i32 {
  if (class_name_is(name, "alnum")) {
    return 0;
  }
  if (class_name_is(name, "alpha")) {
    return 1;
  }
  if (class_name_is(name, "blank")) {
    return 2;
  }
  if (class_name_is(name, "cntrl")) {
    return 3;
  }
  if (class_name_is(name, "digit")) {
    return 4;
  }
  if (class_name_is(name, "graph")) {
    return 5;
  }
  if (class_name_is(name, "lower")) {
    return 6;
  }
  if (class_name_is(name, "print")) {
    return 7;
  }
  if (class_name_is(name, "punct")) {
    return 8;
  }
  if (class_name_is(name, "space")) {
    return 9;
  }
  if (class_name_is(name, "upper")) {
    return 10;
  }
  if (class_name_is(name, "xdigit")) {
    return 11;
  }
  return -1;
}

function in_class(cls: i32, c: i32): boolean {
  let lower = c >= 97 && c <= 122;
  let upper = c >= 65 && c <= 90;
  let digit = c >= 48 && c <= 57;
  let alpha = lower || upper;
  let alnum = alpha || digit;
  let graph = c >= 33 && c <= 126;
  if (cls == 0) {
    return alnum;
  }
  if (cls == 1) {
    return alpha;
  }
  if (cls == 2) {
    return c == 32 || c == 9;
  }
  if (cls == 3) {
    return c < 32 || c == 127;
  }
  if (cls == 4) {
    return digit;
  }
  if (cls == 5) {
    return graph;
  }
  if (cls == 6) {
    return lower;
  }
  if (cls == 7) {
    return c >= 32 && c <= 126;
  }
  if (cls == 8) {
    return graph && !alnum;
  }
  if (cls == 9) {
    return c == 32 || c >= 9 && c <= 13;
  }
  if (cls == 10) {
    return upper;
  }
  return digit || c >= 65 && c <= 70 || c >= 97 && c <= 102;
}

function class_first(cls: i32): i32 {
  return class_next(cls, -1);
}

function class_next(cls: i32, after: i32): i32 {
  let i = after + 1;
  while (i < 256) {
    if (in_class(cls, i)) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function class_size(cls: i32): u64 {
  let n = 0 as u64;
  let i = 0;
  while (i < 256) {
    if (in_class(cls, i)) {
      n = n + 1 as u64;
    }
    i += 1;
  }
  return n;
}

struct ES { s: u8[], esc: u8[] }

function es_is(e: ES, i: i32, b: i32): boolean {
  return i < e.s.len() && e.s[i] as i32 == b && e.esc[i] as i32 == 0;
}

function unquote(raw: string): ES {
  let bs: u8[] = [];
  let fl: u8[] = [];
  let n = raw.len();
  let i = 0;
  while (i < n) {
    let c = raw[i] as i32;
    if (c != 92) {
      bs = bs.append(c as u8);
      fl = fl.append(0 as u8);
      i += 1;
      continue;
    }
    if (i + 1 >= n) {
      gnu.error("warning: an unescaped backslash at end of string is not portable");
      bs = bs.append(92 as u8);
      fl = fl.append(0 as u8);
      i += 1;
      continue;
    }
    let d = raw[i + 1] as i32;
    let val = d;
    let adv = 2;
    if (d == 92) {
      val = 92;
    } else if (d == 97) {
      val = 7;
    } else if (d == 98) {
      val = 8;
    } else if (d == 102) {
      val = 12;
    } else if (d == 110) {
      val = 10;
    } else if (d == 114) {
      val = 13;
    } else if (d == 116) {
      val = 9;
    } else if (d == 118) {
      val = 11;
    } else if (is_octal(d)) {
      val = d - 48;
      if (i + 2 < n && is_octal(raw[i + 2] as i32)) {
        val = 8 * val + (raw[i + 2] as i32 - 48);
        adv = 3;
        if (i + 3 < n && is_octal(raw[i + 3] as i32)) {
          let wide = 8 * val + (raw[i + 3] as i32 - 48);
          if (wide < 256) {
            val = wide;
            adv = 4;
          } else {
            let d1 = chr(raw[i + 1] as i32);
            let d2 = chr(raw[i + 2] as i32);
            let d3 = chr(raw[i + 3] as i32);
            gnu.error("warning: the ambiguous octal escape \\" + d1 + d2 + d3 + " is being\n\tinterpreted as the 2-byte sequence \\0" + d1 + d2 + ", " + d3);
          }
        }
      }
    }
    bs = bs.append(val as u8);
    fl = fl.append(1 as u8);
    i += adv;
  }
  return ES { s: bs, esc: fl };
}

struct Item { kind: i32, a: i32, b: i32, n: u64 }

function die(msg: string): void {
  gnu.error(msg);
  exit(1);
}

function build_spec(e: ES): Item[] {
  let items: Item[] = [];
  let n = e.s.len();
  let i = 0;
  while (i < n) {
    if (es_is(e, i, 91)) {
      let handled = false;
      if (es_is(e, i + 1, 58) || es_is(e, i + 1, 61)) {
        let delim = e.s[i + 1] as i32;
        let j = i + 2;
        let close = -1;
        while (j + 1 < n) {
          if (e.s[j] as i32 == delim && e.s[j + 1] as i32 == 93 && e.esc[j] as i32 == 0 && e.esc[j + 1] as i32 == 0) {
            close = j;
            break;
          }
          j += 1;
        }
        if (close >= 0) {
          let body = array.slice(e.s, i + 2, close);
          if (delim == 58) {
            if (body.len() == 0) {
              die("missing character class name " + gnu.quote("[::]"));
            }
            let cls = class_id(body);
            if (cls < 0) {
              die("invalid character class " + gnu.quote(printable_str(body)));
            }
            items = items.append(Item { kind: 2, a: cls, b: 0, n: 0 as u64 });
          } else {
            if (body.len() == 0) {
              die("missing equivalence class character " + gnu.quote("[==]"));
            }
            if (body.len() != 1) {
              die(printable_str(body) + ": equivalence class operand must be a single character");
            }
            items = items.append(Item { kind: 3, a: body[0] as i32, b: 0, n: 0 as u64 });
          }
          i = close + 2;
          handled = true;
        }
      }
      if (!handled && i + 2 < n && es_is(e, i + 2, 42)) {
        let k = i + 3;
        let end = -1;
        while (k < n && e.esc[k] as i32 == 0) {
          if (e.s[k] as i32 == 93) {
            end = k;
            break;
          }
          k += 1;
        }
        if (end >= 0) {
          let digits = array.slice(e.s, i + 3, end);
          items = items.append(Item { kind: 4, a: e.s[i + 1] as i32, b: 0, n: repeat_count(digits) });
          i = end + 1;
          handled = true;
        }
      }
      if (handled) {
        continue;
      }
    }
    if (es_is(e, i + 1, 45) && i + 2 < n) {
      let lo = e.s[i] as i32;
      let hi = e.s[i + 2] as i32;
      if (hi < lo) {
        die("range-endpoints of '" + printable_char(lo) + "-" + printable_char(hi) + "' are in reverse collating sequence order");
      }
      items = items.append(Item { kind: 1, a: lo, b: hi, n: 0 as u64 });
      i += 3;
      continue;
    }
    items = items.append(Item { kind: 0, a: e.s[i] as i32, b: 0, n: 0 as u64 });
    i += 1;
  }
  return items;
}

function repeat_count(digits: u8[]): u64 {
  if (digits.len() == 0) {
    return 0 as u64;
  }
  let i = 0;
  while (i < digits.len() && (digits[i] as i32 == 32 || digits[i] as i32 >= 9 && digits[i] as i32 <= 13)) {
    i += 1;
  }
  let neg = false;
  if (i < digits.len() && (digits[i] as i32 == 43 || digits[i] as i32 == 45)) {
    neg = digits[i] as i32 == 45;
    i += 1;
  }
  let base = 10 as u64;
  if (i < digits.len() && digits[i] as i32 == 48) {
    base = 8 as u64;
  }
  let start = i;
  let v = 0 as u64;
  let over = false;
  let limit = 18446744073709551615 as u64;
  while (i < digits.len()) {
    let c = digits[i] as i32;
    if (c < 48 || c > 57) {
      break;
    }
    let d = (c - 48) as u64;
    if (d >= base) {
      break;
    }
    if (v > (limit - d) / base) {
      over = true;
      v = 0 as u64;
    } else {
      v = v * base + d;
    }
    i += 1;
  }
  if (i == start || i != digits.len() || over) {
    die("invalid repeat count " + gnu.quote(printable_str(digits)) + " in [c*n] construct");
  }
  if (neg) {
    v = 0 as u64 - v;
  }
  if (v >= limit) {
    die("invalid repeat count " + gnu.quote(printable_str(digits)) + " in [c*n] construct");
  }
  return v;
}

struct Cur { i: i32, st: i32, fresh: boolean, k: u64 }

function cur_new(): Cur {
  return Cur { i: 0, st: 0, fresh: true, k: 0 as u64 };
}

function cur_step(i: i32): Cur {
  return Cur { i: i + 1, st: 0, fresh: true, k: 0 as u64 };
}

function spec_next(items: Item[], c: Cur): (i32, i32, Cur) {
  let cur = c;
  while (cur.i < items.len()) {
    let it = items[cur.i];
    if (it.kind == 0 || it.kind == 3) {
      return (it.a, 0, cur_step(cur.i));
    }
    if (it.kind == 1) {
      let v = it.a;
      if (!cur.fresh) {
        v = cur.st + 1;
      }
      if (v >= it.b) {
        return (v, 0, cur_step(cur.i));
      }
      return (v, 0, Cur { i: cur.i, st: v, fresh: false, k: 0 as u64 });
    }
    if (it.kind == 2) {
      let m = class_first(it.a);
      if (!cur.fresh) {
        m = class_next(it.a, cur.st);
      }
      let ul = 0;
      if (it.a == 6) {
        ul = 1;
      }
      if (it.a == 10) {
        ul = 2;
      }
      if (class_next(it.a, m) < 0) {
        return (m, ul, cur_step(cur.i));
      }
      return (m, ul, Cur { i: cur.i, st: m, fresh: false, k: 0 as u64 });
    }
    let done = cur.k;
    if (cur.fresh) {
      done = 0 as u64;
    }
    if (done >= it.n) {
      cur = cur_step(cur.i);
      continue;
    }
    return (it.a, 0, Cur { i: cur.i, st: 0, fresh: false, k: done + 1 as u64 });
  }
  return (-1, 0, cur);
}

function spec_len(items: Item[]): u64 {
  let total = 0 as u64;
  let i = 0;
  while (i < items.len()) {
    let it = items[i];
    if (it.kind == 0 || it.kind == 3) {
      total = total + 1 as u64;
    } else if (it.kind == 1) {
      total = total + (it.b - it.a + 1) as u64;
    } else if (it.kind == 2) {
      total += class_size(it.a);
    } else {
      total += it.n;
    }
    i += 1;
  }
  return total;
}

function count_indefinite(items: Item[]): i32 {
  let n = 0;
  let i = 0;
  while (i < items.len()) {
    if (items[i].kind == 4 && items[i].n == 0 as u64) {
      n += 1;
    }
    i += 1;
  }
  return n;
}

function has_equiv(items: Item[]): boolean {
  let i = 0;
  while (i < items.len()) {
    if (items[i].kind == 3) {
      return true;
    }
    i += 1;
  }
  return false;
}

function has_restricted_class(items: Item[]): boolean {
  let i = 0;
  while (i < items.len()) {
    if (items[i].kind == 2 && items[i].a != 6 && items[i].a != 10) {
      return true;
    }
    i += 1;
  }
  return false;
}

function members(items: Item[], flip: boolean): u8[] {
  let set = __alloc_u8(256);
  let i = 0;
  while (i < 256) {
    set = set.with(i, 0 as u8);
    i += 1;
  }
  let cur = cur_new();
  while (true) {
    let r: (i32, i32, Cur) = spec_next(items, cur);
    cur = r.2;
    if (r.0 < 0) {
      break;
    }
    set = set.with(r.0, 1 as u8);
  }
  if (flip) {
    i = 0;
    while (i < 256) {
      let v = 1;
      if (set[i] as i32 == 1) {
        v = 0;
      }
      set = set.with(i, v as u8);
      i += 1;
    }
  }
  return set;
}

function member_count(set: u8[]): u64 {
  let n = 0 as u64;
  let i = 0;
  while (i < 256) {
    if (set[i] as i32 != 0) {
      n = n + 1 as u64;
    }
    i += 1;
  }
  return n;
}

function identity_table(): u8[] {
  let t = __alloc_u8(256);
  let i = 0;
  while (i < 256) {
    t = t.with(i, i as u8);
    i += 1;
  }
  return t;
}

function to_upper(c: i32): i32 {
  if (c >= 97 && c <= 122) {
    return c - 32;
  }
  return c;
}

function to_lower(c: i32): i32 {
  if (c >= 65 && c <= 90) {
    return c + 32;
  }
  return c;
}

function build_xlate(s1: Item[], s2: Item[], truncate: boolean): u8[] {
  let t = identity_table();
  let c1 = cur_new();
  let c2 = cur_new();
  while (true) {
    let r1: (i32, i32, Cur) = spec_next(s1, c1);
    c1 = r1.2;
    let r2: (i32, i32, Cur) = spec_next(s2, c2);
    c2 = r2.2;
    if (r1.1 == 0 && r2.1 != 0) {
      die("misaligned [:upper:] and/or [:lower:] construct");
    }
    let to = r2.0;
    if (to < 0 && r1.0 >= 0 && !truncate) {
      to = extend_byte(s2);
    }
    if (r1.0 < 0 || to < 0) {
      break;
    }
    if (r2.1 == 1) {
      t = t.with(r1.0, to_lower(r1.0) as u8);
    } else if (r2.1 == 2) {
      t = t.with(r1.0, to_upper(r1.0) as u8);
    } else {
      t = t.with(r1.0, to as u8);
    }
  }
  return t;
}

function build_xlate_complement(s1: Item[], s2: Item[], truncate: boolean): u8[] {
  let t = identity_table();
  let in1 = members(s1, false);
  let cur = cur_new();
  let last = -1;
  let i = 0;
  while (i < 256) {
    if (in1[i] as i32 == 0) {
      let r: (i32, i32, Cur) = spec_next(s2, cur);
      cur = r.2;
      if (r.0 >= 0) {
        last = r.0;
      } else {
        if (truncate) {
          return t;
        }
        last = extend_byte(s2);
      }
      t = t.with(i, last as u8);
    }
    i += 1;
  }
  return t;
}

function read_size(): i32 {
  return 65536;
}

function xf_squeeze(chunk: u8[], sq: u8[], last: i32): (u8[], i32, i32) {
  let n = chunk.len();
  let buf = __alloc_u8(n);
  let j = 0;
  let prev = last;
  let i = 0;
  while (i < n) {
    let c = chunk[i] as i32;
    if (c != prev || sq[c] as i32 == 0) {
      buf = buf.with(j, c as u8);
      j += 1;
    }
    prev = c;
    i += 1;
  }
  return (buf, j, prev);
}

function xf_translate_squeeze(chunk: u8[], t: u8[], sq: u8[], last: i32): (u8[], i32, i32) {
  let n = chunk.len();
  let buf = __alloc_u8(n);
  let j = 0;
  let prev = last;
  let i = 0;
  while (i < n) {
    let c = t[chunk[i] as i32] as i32;
    if (c != prev || sq[c] as i32 == 0) {
      buf = buf.with(j, c as u8);
      j += 1;
    }
    prev = c;
    i += 1;
  }
  return (buf, j, prev);
}

function xf_delete_squeeze(chunk: u8[], del: u8[], sq: u8[], last: i32): (u8[], i32, i32) {
  let n = chunk.len();
  let buf = __alloc_u8(n);
  let j = 0;
  let prev = last;
  let i = 0;
  while (i < n) {
    let c = chunk[i] as i32;
    if (del[c] as i32 == 0) {
      if (c != prev || sq[c] as i32 == 0) {
        buf = buf.with(j, c as u8);
        j += 1;
      }
      prev = c;
    }
    i += 1;
  }
  return (buf, j, prev);
}

function check_operands(ops: string[], deleting: boolean, squeezing: boolean): void {
  let n = ops.len();
  if (n == 0) {
    gnu.die_usage("missing operand", 1);
  }
  if (deleting && !squeezing) {
    if (n > 1) {
      gnu.error("extra operand " + gnu.quote(ops[1]));
      if (n == 2) {
        eprint("Only one string may be given when deleting without squeezing repeats.");
      }
      gnu.try_help(1);
    }
    return;
  }
  if (n == 1 && !squeezing) {
    gnu.error("missing operand after " + gnu.quote(ops[0]));
    eprint("Two strings must be given when translating.");
    gnu.try_help(1);
  }
  if (n == 1 && deleting) {
    gnu.error("missing operand after " + gnu.quote(ops[0]));
    eprint("Two strings must be given when both deleting and squeezing repeats.");
    gnu.try_help(1);
  }
  if (n > 2) {
    gnu.die_usage("extra operand " + gnu.quote(ops[2]), 1);
  }
}

function resolve_indefinite(s2: Item[], len1: u64, len2: u64): Item[] {
  let out = s2;
  let fill = 0 as u64;
  if (len1 > len2) {
    fill = len1 - len2;
  }
  let i = 0;
  while (i < out.len()) {
    let it = out[i];
    if (it.kind == 4 && it.n == 0 as u64) {
      out = out.with(i, Item { kind: 4, a: it.a, b: it.b, n: fill });
    }
    i += 1;
  }
  return out;
}

function fill_byte(items: Item[]): i32 {
  if (items.len() == 0) {
    return -2;
  }
  let last = items[items.len() - 1];
  if (last.kind == 2) {
    return -1;
  }
  if (last.kind == 1) {
    return last.b;
  }
  return last.a;
}

function extend_byte(s2: Item[]): i32 {
  let fb = fill_byte(s2);
  if (fb == -2) {
    die("when not truncating set1, string2 must be non-empty");
  }
  if (fb == -1) {
    die("when translating with string1 longer than string2,\nthe latter string must not end with a character class");
  }
  return fb;
}

pub function main(): i32 {
  let argv = args();
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("c", "complement", opt_complement()));
  opts = opts.append(gnu.flag("C", "", opt_complement()));
  opts = opts.append(gnu.flag("d", "delete", opt_delete()));
  opts = opts.append(gnu.flag("s", "squeeze-repeats", opt_squeeze()));
  opts = opts.append(gnu.flag("t", "truncate-set1", opt_truncate()));

  let g = gnu.getopt_new(argv, opts, "tr", help_text(), 1).in_order();
  let complement = false;
  let deleting = false;
  let squeezing = false;
  let truncate = false;
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_complement()) {
          complement = true;
        } else if (m.id == opt_delete()) {
          deleting = true;
        } else if (m.id == opt_squeeze()) {
          squeezing = true;
        } else if (m.id == opt_truncate()) {
          truncate = true;
        }
      },
      None => {
        break;
      }
    }
  }

  let ops = g.operands();
  check_operands(ops, deleting, squeezing);
  let translating = ops.len() == 2 && !deleting;

  let s1 = build_spec(unquote(ops[0]));
  let s2: Item[] = [];
  if (ops.len() == 2) {
    s2 = build_spec(unquote(ops[1]));
  }

  if (count_indefinite(s1) > 0) {
    die("the [c*] repeat construct may not appear in string1");
  }
  if (ops.len() == 2 && count_indefinite(s2) > 1) {
    die("only one [c*] repeat construct may appear in string2");
  }

  let xlate: u8[] = [];
  let del: u8[] = [];
  let sq: u8[] = [];
  if (translating) {
    if (has_equiv(s2)) {
      die("[=c=] expressions may not appear in string2 when translating");
    }
    if (has_restricted_class(s2)) {
      die("when translating, the only character classes that may appear in\nstring2 are 'upper' and 'lower'");
    }
    let len1 = spec_len(s1);
    if (complement) {
      len1 = 256 as u64 - member_count(members(s1, false));
    }
    s2 = resolve_indefinite(s2, len1, spec_len(s2));
    if (complement) {
      xlate = build_xlate_complement(s1, s2, truncate);
    } else {
      xlate = build_xlate(s1, s2, truncate);
    }
  }
  if (deleting) {
    del = members(s1, complement);
  }
  if (squeezing) {
    if (ops.len() == 2) {
      sq = members(s2, false);
    } else {
      sq = members(s1, complement);
    }
  }

  let o = gnu.out_new();
  let r = stdin();
  let last = -1;
  while (true) {
    match (r.read_chunk_bytes(read_size())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          break;
        }
        if (translating && squeezing) {
          let t2: (u8[], i32, i32) = xf_translate_squeeze(chunk, xlate, sq, last);
          last = t2.2;
          o = gnu.check(o.write_bytes_range(t2.0, 0, t2.1));
        } else if (translating) {
          o = gnu.check(o.write_bytes_mapped(chunk, xlate));
        } else if (deleting && squeezing) {
          let d2: (u8[], i32, i32) = xf_delete_squeeze(chunk, del, sq, last);
          last = d2.2;
          o = gnu.check(o.write_bytes_range(d2.0, 0, d2.1));
        } else if (deleting) {
          o = gnu.check(o.write_bytes_filtered(chunk, del));
        } else {
          let q2: (u8[], i32, i32) = xf_squeeze(chunk, sq, last);
          last = q2.2;
          o = gnu.check(o.write_bytes_range(q2.0, 0, q2.1));
        }
      },
      Err(e) => {
        o = gnu.flush(o);
        gnu.error("read error: " + gnu.io_error_text(e));
        exit(1);
      }
    }
  }
  gnu.finish(o);
  return 0;
}
