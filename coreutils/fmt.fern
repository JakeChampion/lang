// fmt.fern — GNU-compatible `fmt`.
//
//   fmt [-WIDTH] [OPTION]... [FILE]...
//
// Reformats each paragraph to a GOAL width, breaking lines where a
// dynamic program says it costs least. The cost function is the whole
// utility, and every constant below was measured against the reference
// binary rather than read anywhere:
//
//   - costs are in HUNDREDTHS of a squared column, because two of the
//     terms are integer divisions and the scale decides where they
//     truncate: a line `n` columns off the goal costs `(10n)^2`, a line
//     itself costs 4900, a break at a sentence end is worth 2500 back, a
//     break after a period that does NOT end one costs 360000, and the
//     two "leave a word stranded" terms are 22500/(len+2) for the word
//     that ENDS a sentence and 40000/(len+2) for the one after a
//     sentence's first word;
//   - a line may reach WIDTH columns exactly (9.12; through 9.4 the bound
//     was WIDTH-1, and the corpus pins the difference at every shape that
//     can fill a line);
//   - the LAST line of a paragraph is free, which is why the slack in a
//     paragraph collects at its front;
//   - the goal defaults to `width * 187 / 200`, not to the 93% `--help`
//     claims, and `-g` without `-w` sets the width to GOAL + 10;
//   - ties keep the EARLIER break, so the shorter first line wins.
//
// The reader is a state machine over lines rather than a paragraph
// buffer, and two orderings in it are observable. A tab sets the sticky
// `tabs` flag that makes every later space run in the OUTPUT reach for
// tab stops, and the flag is set as the line is SCANNED — so the tab in
// a line's indent reaches the paragraph before it, and one among that
// line's words does not. And a paragraph is emitted only once the line
// that ends it has had its indent read, which is where that ordering
// comes from.
//
// Known divergence: GNU formats at most 997 words of a paragraph at a
// time — a fixed-size buffer — and then reformats what is left, so its
// answer for a longer paragraph is not the optimum its own cost function
// describes. This one formats the whole paragraph. `docs/COREUTILS.md`
// records it.
import "std/array";
import "std/io_buffered";
import "./lib/gnu";

// Option ids in GNU's declaration order — `fmt --=x` lists
// `--crown-margin` `--prefix` `--split-only` `--tagged-paragraph`
// `--uniform-spacing` `--width` `--goal`.
function opt_crown(): i32 {
  return 1;
}

function opt_prefix(): i32 {
  return 2;
}

function opt_split(): i32 {
  return 3;
}

function opt_tagged(): i32 {
  return 4;
}

function opt_uniform(): i32 {
  return 5;
}

function opt_width(): i32 {
  return 6;
}

function opt_goal(): i32 {
  return 7;
}

// The ten digits are declared so glibc hands `-5` to fmt instead of
// printing `invalid option -- '5'` itself; the obsolete `-WIDTH` form is
// taken off argv[1] before the scan, so a digit that reaches the loop is
// one written too late.
function opt_digit(d: i32): i32 {
  return 10 + d;
}

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [-WIDTH] [OPTION]... [FILE]...\n";
  out = out + "Reformat each paragraph in the FILE(s), writing to standard output.\n";
  out = out + "The option -WIDTH is an abbreviated form of --width=DIGITS.\n";
  out = out + "\n";
  out = out + "With no FILE, or when FILE is -, read standard input.\n";
  out = out + "\n";
  out = out + "  -c, --crown-margin        preserve indentation of first two lines\n";
  out = out + "  -p, --prefix=STRING       reformat only lines beginning with STRING,\n";
  out = out + "                              reattaching the prefix to reformatted lines\n";
  out = out + "  -s, --split-only          split long lines, but do not refill\n";
  out = out + "  -t, --tagged-paragraph    indentation of first line different from second\n";
  out = out + "  -u, --uniform-spacing     one space between words, two after sentences\n";
  out = out + "  -w, --width=WIDTH         maximum line width (default of 75 columns)\n";
  out = out + "  -g, --goal=WIDTH          goal width (default of 93% of width)\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function read_size(): i32 {
  return 65536;
}

function block_size(): i32 {
  return 16384;
}

function tab_width(): i32 {
  return 8;
}

// GNU's word buffer: the words of a paragraph are laid out 998 at a
// time, or as many as fit 5000 bytes of word text, and the widest line
// it will aim for is half that buffer. `chunk` is the flush.
function buffer_words(): i32 {
  return 998;
}

function buffer_bytes(): i32 {
  return 5000;
}

function max_width_limit(): i32 {
  return 2500;
}

// ---- the cost function ------------------------------------------------------
//
// Hundredths of a squared column: a line `n` columns short of the goal
// costs `SHORT * n * n`, `(10n)^2`, and two adjacent lines differing by
// `n` columns `RAGGED * n * n`, half that.
const SHORT: i64 = 100;
const RAGGED: i64 = 50;
const LINE_COST_BASE: i64 = 4900;
const WIDOW_COST: i64 = 40000;
const ORPHAN_COST: i64 = 22500;
const SENTENCE_BONUS: i64 = 2500;
const NOBREAK_COST: i64 = 360000;
const PUNCT_BONUS: i64 = 1600;
const PAREN_BONUS: i64 = 1600;
const COST_INFINITY: i64 = 4611686018427387904;

// The credit a line further along the buffer gets when the flush picks
// where to re-enter, and the cost the search for it starts from.
const LINE_CREDIT: i64 = 9;
const COST_MAX: i64 = 9223372036854775807;

// ---- words ------------------------------------------------------------------
//
// The paragraph's words, GNU's word buffer: parallel arrays kept for the
// whole run and overwritten in place, so a word costs three stores rather
// than a record. Word k is the bytes `lo .. lo + len` of `lines[line]`:
//
//   pos[k]   lo << 32 | len
//   meta[k]  line << 8 | flags
//   sp[k]    space << 32 | gap
//
// `space` is the columns before the word on its own line and `gap` the
// columns after it on the line it was read from. The flags are `period`, a
// word ending in `.?!` under any run of `)]'"`; `sentence`, a `period` word
// that was followed by a newline or two blanks, which is what "ends a
// sentence" means here; `punct`, any other trailing punctuation; and
// `paren`, an opening bracket or quote at the front. Entries past `n`, and
// lines past `nl`, are left over from an earlier paragraph.
//
// `at`, `best`, `link` and `dq` are `choose`'s tables, and `breaks` and
// `costs` the layout it chose, `nb` lines of it: for each line, the word
// that starts the next one, and what the line cost. They are kept here so
// that a paragraph reuses them rather than growing its own.
struct Words { lines: string[], nl: i32, pos: i64[], meta: i64[], sp: i64[], n: i32, at: i32[], best: i64[], link: i64[], dq: i32[], breaks: i32[], costs: i64[], nb: i32 }

function words_new(): Words {
  return Words { lines: [], nl: 0, pos: [], meta: [], sp: [], n: 0, at: [], best: [], link: [], dq: [], breaks: [], costs: [], nb: 0 };
}

function f_period(): i32 {
  return 1;
}

function f_sentence(): i32 {
  return 2;
}

function f_punct(): i32 {
  return 4;
}

function f_paren(): i32 {
  return 8;
}

function lo32(v: i64): i32 {
  return (v & 4294967295 as i64) as i32;
}

function hi32(v: i64): i32 {
  return (v >> 32 as i64) as i32;
}

// `lo` is masked because it can be negative: a line under a prefix is
// measured from the prefix's end.
function pair(hi: i32, lo: i32): i64 {
  return ((hi as i64) << (32 as i64)) | ((lo as i64) & 4294967295 as i64);
}

function is_blank_byte(c: i32): boolean {
  return c == 32 || c == 9;
}

function is_closer(c: i32): boolean {
  return c == 41 || c == 93 || c == 39 || c == 34;
}

function is_paren(c: i32): boolean {
  return c == 40 || c == 91 || c == 96 || c == 39 || c == 34;
}

function is_end_punct(c: i32): boolean {
  return c == 46 || c == 63 || c == 33;
}

// C's ispunct in the C locale: a printable byte that is neither a blank
// nor alphanumeric.
function is_punct(c: i32): boolean {
  if (c < 33 || c > 126) {
    return false;
  }
  if (c >= 48 && c <= 57) {
    return false;
  }
  if (c >= 65 && c <= 90) {
    return false;
  }
  if (c >= 97 && c <= 122) {
    return false;
  }
  return true;
}

// `byte_classes()` — for each byte, which of the tests above it passes:
// 1 closer, 2 end punctuation, 4 other punctuation, 8 opening bracket.
function byte_classes(): u8[] {
  var cls: u8[] = __alloc_u8(256);
  var c: i32 = 0;
  while (c < 256) {
    var k: i32 = 0;
    if (is_closer(c)) {
      k = k | 1;
    }
    if (is_end_punct(c)) {
      k = k | 2;
    } else if (is_punct(c)) {
      k = k | 4;
    }
    if (is_paren(c)) {
      k = k | 8;
    }
    cls = cls.with(c, k as u8);
    c = c + 1;
  }
  return cls;
}

function word_flags(cls: u8[], line: string, lo: i32, hi: i32, gap: i32, at_eol: boolean): i32 {
  var e: i32 = hi;
  while (e > lo && (cls[line[e - 1] as i32] as i32 & 1) != 0) {
    e = e - 1;
  }
  var f: i32 = 0;
  if (e > lo && (cls[line[e - 1] as i32] as i32 & 2) != 0) {
    f = f_period();
    if (at_eol || gap >= 2) {
      f = f | f_sentence();
    }
  }
  if ((cls[line[hi - 1] as i32] as i32 & 4) != 0) {
    f = f | f_punct();
  }
  if ((cls[line[lo] as i32] as i32 & 8) != 0) {
    f = f | f_paren();
  }
  return f;
}

// ---- settings ---------------------------------------------------------------
// `blank` and `ink` are byte sets for `__scan_set`: the two blanks, and
// every byte but them. `cls` is `byte_classes()`.
struct Settings { max_width: i32, goal: i32, crown: boolean, tagged: boolean, split: boolean, uniform: boolean, prefix: string, prefix_out: string, prefix_lead: i32, blank: u8[], ink: u8[], cls: u8[] }

function byte_set(members: boolean): u8[] {
  var set: u8[] = __alloc_u8(256);
  var c: i32 = 0;
  while (c < 256) {
    if (is_blank_byte(c) == members) {
      set = set.with(c, 1 as u8);
    }
    c = c + 1;
  }
  return set;
}

// ---- output -----------------------------------------------------------------
//
// The emitted text is built up in `buf` and handed to the writer a block
// at a time; `col` is the column the next byte lands on, which the tab
// rendering needs, and `tabs` is the sticky flag a tab anywhere in the
// input sets.
// Every piece of output is pushed into `w`'s builder as it is decided;
// `settle` at each line end flushes a full block and checks for a failure.
struct Out { w: io_buffered.BufWriter, col: i32, tabs: boolean }

// `push_spacing(h, col, n, tabs)` — `n` columns of white space written from
// column `col`. With the tabs flag set the run reaches for tab stops the
// way unexpand does: tabs are used only when the LAST stop the run
// covers is at least two columns past where it starts, so a single blank
// landing on a stop stays a blank. A run of nothing — which a tagged
// paragraph's continuation column can ask for, since it may sit left of
// the prefix — writes nothing.
function push_spacing(h: usize, col: i32, n: i32, tabs: boolean): void {
  if (n <= 0) {
    return;
  }
  var target: i32 = col + n;
  var c: i32 = col;
  if (tabs) {
    var last: i32 = target / tab_width() * tab_width();
    if (last - c >= 2) {
      while (c / tab_width() * tab_width() + tab_width() <= last) {
        buf_push_byte(h, 9);
        c = c / tab_width() * tab_width() + tab_width();
      }
    }
  }
  while (c < target) {
    buf_push_byte(h, 32);
    c = c + 1;
  }
}

// ---- the paragraph ----------------------------------------------------------
//
// The words are on the driver's `State` rather than here, so that `feed`
// can append to them inside its rebuild of that record (see `feed`).
// `last_len` is the column the paragraph's last written line ended at,
// which the first line laid out after a `chunk` is costed against; it is
// 0 until a flush has written something.
struct Para { open: boolean, pending: boolean, first_indent: i32, other_indent: i32, p_indent: i32, sticky: i32, last_len: i32 }

function para_new(): Para {
  return Para { open: false, pending: false, first_indent: 0, other_indent: 0, p_indent: 0, sticky: 0, last_len: 0 };
}

function para_reset(p: Para): Para {
  return Para { ...p, open: false, pending: false, first_indent: 0, other_indent: 0, p_indent: 0, last_len: 0 };
}

// `base_cost(pos, meta, s, sentence_at)` — what starting a line at word `s`
// costs, with word `sentence_at` taken to end a sentence whatever its flags
// say,
// over and above the line's distance from the goal. The four terms that
// read the word BEFORE the break are one chain: a sentence that ended
// there is a bonus, a period that did not end one is the large refusal,
// other trailing punctuation is a small bonus, and only when none of
// those holds does a break after a sentence's FIRST word count as a
// widow. The two that read the word itself are a second chain, where an
// opening bracket outranks the word's own sentence end. Never below 800,
// which the search in `choose` relies on.
function base_cost(pos: i64[], meta: i64[], s: i32, sentence_at: i32): i64 {
  var c: i64 = LINE_COST_BASE;
  if (s > 0) {
    var pf: i32 = (meta[s - 1] & 255 as i64) as i32;
    if (s - 1 == sentence_at) {
      pf = pf | f_sentence();
    }
    if ((pf & f_sentence()) != 0) {
      c = c - SENTENCE_BONUS;
    } else if ((pf & f_period()) != 0) {
      c = c + NOBREAK_COST;
    } else if ((pf & f_punct()) != 0) {
      c = c - PUNCT_BONUS;
    } else if (s > 1 && (meta[s - 2] & 2 as i64) != 0 as i64) {
      c = c + WIDOW_COST / ((lo32(pos[s - 1]) + 2) as i64);
    }
  }
  var f: i32 = (meta[s] & 255 as i64) as i32;
  if (s == sentence_at) {
    f = f | f_sentence();
  }
  if ((f & f_paren()) != 0) {
    c = c - PAREN_BONUS;
  } else if ((f & f_sentence()) != 0) {
    c = c + ORPHAN_COST / ((lo32(pos[s]) + 2) as i64);
  }
  return c;
}

// `choose(ws, n, last, p, st, lead)` — the layout of the first `n` words,
// the last of them taken to end a sentence when `last` says so, into
// `ws.breaks` and `ws.costs`. A
// backward dynamic program: a line costs its squared distance from the
// goal plus, when the line after it is not the last, half the squared
// difference between the two; the last line is free, which is what lets
// it run to the width. The first line is also costed against the line
// a flush last wrote.
//
// For each start the candidate ends are tried from the longest line that
// fits down, ties going to the shortest line as GNU's forward scan has
// them. Every line's cost is at least 800, so a line that falls short of
// the goal costs at least its shortfall's square plus the cheapest rest
// among the candidates; once that exceeds the best found, no shorter line
// can win and the rest are skipped. `dq` keeps that cheapest rest for the
// candidates in reach as a queue whose bottom is the minimum.
function choose(own ws: Words, n: i32, last: boolean, p: Para, st: Settings, lead: i32): Words {
  var maxw: i32 = st.max_width - lead;
  var goal: i32 = st.goal - lead;
  var lines: string[] = ws.lines;
  var nl: i32 = ws.nl;
  var pos: i64[] = ws.pos;
  var meta: i64[] = ws.meta;
  var sp: i64[] = ws.sp;
  var count: i32 = ws.n;
  var at: i32[] = ws.at;
  var best: i64[] = ws.best;
  var link: i64[] = ws.link;
  var dq: i32[] = ws.dq;
  var breaks: i32[] = ws.breaks;
  var costs: i64[] = ws.costs;
  var sentence_at: i32 = 0 - 1;
  if (last) {
    sentence_at = n - 1;
  }
  while (at.len() <= n) {
    at = at.append(0);
  }
  while (best.len() < n) {
    best = best.append(0 as i64);
    link = link.append(0 as i64);
  }
  // at[k]: the columns words 0..k-1 take with the space before each.
  var sum: i32 = 0;
  var k: i32 = 0;
  while (k < n) {
    sum = sum + (sp[k] >> 32 as i64) as i32 + (pos[k] & 4294967295 as i64) as i32;
    at = at.with(k + 1, sum);
    k = k + 1;
  }
  // best[w] is the cheapest layout of words w..n-1, and link[w] the word
  // its first line ends before, shifted up 32, over that line's length.
  var bot: i32 = 0;
  var top: i32 = 0;
  var r: i32 = n;
  var s: i32 = n - 1;
  while (s >= 0) {
    // ln(w), the line [s, w), is `from + at[w]`.
    var wl: i32 = (pos[s] & 4294967295 as i64) as i32;
    var from: i32 = p.other_indent + wl - at[s + 1];
    var rag: i32 = 0;
    if (s == 0) {
      from = p.first_indent + wl - at[s + 1];
      rag = p.last_len;
    }
    while (r > s + 1 && from + at[r] > maxw) {
      r = r - 1;
    }
    while (r < n && from + at[r + 1] <= maxw) {
      r = r + 1;
    }
    // Word s + 1 enters the queue; words past r leave it.
    if (s + 1 < n) {
      var v: i64 = best[s + 1];
      while (top > bot && best[dq[top - 1]] >= v) {
        top = top - 1;
      }
      if (top < dq.len()) {
        dq = dq.with(top, s + 1);
      } else {
        dq = dq.append(s + 1);
      }
      top = top + 1;
    }
    while (top > bot && dq[bot] > r) {
      bot = bot + 1;
    }
    var bcost: i64 = COST_INFINITY;
    var bnext: i32 = n;
    var blen: i32 = 0;
    var w: i32 = r;
    while (w > s) {
      var ln: i32 = from + at[w];
      var c: i64 = 0 as i64;
      var rest: i64 = 0 as i64;
      if (w != n) {
        var d: i64 = (goal - ln) as i64;
        var short: i64 = SHORT * d * d;
        if (ln <= goal && top > bot && short + best[dq[bot]] > bcost) {
          break;
        }
        c = short;
        var lk: i64 = link[w];
        if ((lk >> 32 as i64) as i32 != n) {
          var dr: i64 = (ln - (lk & 4294967295 as i64) as i32) as i64;
          c = c + RAGGED * dr * dr;
        }
        rest = best[w];
      }
      if (rag > 0) {
        var df: i64 = (ln + lead - rag) as i64;
        c = c + RAGGED * df * df;
      }
      if (c + rest <= bcost) {
        bcost = c + rest;
        bnext = w;
        blen = ln;
      }
      w = w - 1;
    }
    best = best.with(s, bcost + base_cost(pos, meta, s, sentence_at));
    link = link.with(s, pair(bnext, blen));
    s = s - 1;
  }
  var nb: i32 = 0;
  var i: i32 = 0;
  while (i < n) {
    var j: i32 = hi32(link[i]);
    var after: i64 = 0 as i64;
    if (j != n) {
      after = best[j];
    }
    if (nb < breaks.len()) {
      breaks = breaks.with(nb, j);
      costs = costs.with(nb, best[i] - after);
    } else {
      breaks = breaks.append(j);
      costs = costs.append(best[i] - after);
    }
    nb = nb + 1;
    i = j;
  }
  return Words { lines: lines, nl: nl, pos: pos, meta: meta, sp: sp, n: count, at: at, best: best, link: link, dq: dq, breaks: breaks, costs: costs, nb: nb };
}

// `emit(o, ws, p, st, upto)` — the lines of the layout in `ws` that start
// before word `upto`, and the column the last of them ended at.
function emit(o0: Out, ws: Words, p: Para, st: Settings, upto: i32): (Out, i32) {
  var col: i32 = o0.col;
  var tabs: boolean = o0.tabs;
  var w: io_buffered.BufWriter = o0.w;
  var h: usize = w.handle();
  var i: i32 = 0;
  var b: i32 = 0;
  var first: boolean = true;
  var last: i32 = 0;
  while (i < upto) {
    var j: i32 = ws.breaks[b];
    b = b + 1;
    if (st.prefix.len() > 0 || st.prefix_lead > 0) {
      push_spacing(h, col, p.p_indent, tabs);
      col = col + p.p_indent;
      buf_push(h, st.prefix_out);
      col = col + st.prefix_out.len();
    }
    var ind: i32 = p.other_indent;
    if (first) {
      ind = p.first_indent;
    }
    if (ind > 0) {
      push_spacing(h, col, ind, tabs);
      col = col + ind;
    }
    var k: i32 = i;
    while (k < j) {
      if (k > i) {
        var space: i32 = hi32(ws.sp[k]);
        if (space == 1) {
          buf_push_byte(h, 32);
        } else {
          push_spacing(h, col, space, tabs);
        }
        col = col + space;
      }
      var at: i64 = ws.pos[k];
      var lo: i32 = hi32(at);
      var wl: i32 = lo32(at);
      buf_push_range(h, ws.lines[(ws.meta[k] >> 8 as i64) as i32], lo, lo + wl);
      col = col + wl;
      k = k + 1;
    }
    last = col;
    buf_push_byte(h, 10);
    col = 0;
    w = gnu.settle(w);
    first = false;
    i = j;
  }
  return (Out { w: w, col: col, tabs: tabs }, last);
}

// `chunk(o, p, ws, n, st, col)` — GNU's flush of a full word buffer. The
// first `n` words are laid out as if the paragraph ended there, the
// lines before the cheapest line start after the first are written —
// each line further along gets a small credit — and the words from that
// line on stay as the paragraph's start, `ws[n..]` behind them. `col` is
// the input column the reader stands at, which under -c or -t becomes
// the continuation indent, as the reader's column would at a line end.
function chunk(o0: Out, p0: Para, own ws: Words, n: i32, st: Settings, col: i32): (Out, Para, Words) {
  var lead: i32 = p0.p_indent + st.prefix_out.len();
  var first: i32 = p0.first_indent + lead;
  var other: i32 = first;
  if (st.split) {
    other = first;
  } else if (st.crown) {
    other = col;
  } else if (st.tagged) {
    other = p0.other_indent + lead;
    if (p0.pending) {
      other = p0.sticky;
    }
    if (col != first) {
      other = col;
    } else if (other == first) {
      other = 0;
      if (first == 0) {
        other = 3;
      }
    }
  }
  var p: Para = Para { ...p0, other_indent: other - lead, sticky: other };
  ws = choose(ws, n, false, p, st, lead);
  var split: i32 = n;
  var best: i64 = COST_MAX;
  var b: i32 = 1;
  var w: i32 = ws.breaks[0];
  while (w != n) {
    if (ws.costs[b] < best) {
      split = w;
      best = ws.costs[b];
    }
    if (best <= COST_MAX - LINE_CREDIT) {
      best = best + LINE_CREDIT;
    }
    w = ws.breaks[b];
    b = b + 1;
  }
  var e: (Out, i32) = emit(o0, ws, p, st, split);
  return (e.0, Para { ...p, last_len: e.1 }, drop_front(ws, split));
}

// `drop_front(ws, k)` — the words from `k` on moved to the front, and the
// lines they are read from with them.
function drop_front(own ws: Words, k: i32): Words {
  var lines: string[] = ws.lines;
  var nl: i32 = ws.nl;
  var pos: i64[] = ws.pos;
  var meta: i64[] = ws.meta;
  var sp: i64[] = ws.sp;
  var n: i32 = ws.n;
  var at: i32[] = ws.at;
  var best: i64[] = ws.best;
  var link: i64[] = ws.link;
  var dq: i32[] = ws.dq;
  var breaks: i32[] = ws.breaks;
  var costs: i64[] = ws.costs;
  if (k >= n) {
    return Words { lines: lines, nl: 0, pos: pos, meta: meta, sp: sp, n: 0, at: at, best: best, link: link, dq: dq, breaks: breaks, costs: costs, nb: 0 };
  }
  var l0: i32 = (meta[k] >> 8 as i64) as i32;
  var shift: i64 = (l0 as i64) << 8 as i64;
  var i: i32 = k;
  while (i < n) {
    pos = pos.with(i - k, pos[i]);
    meta = meta.with(i - k, meta[i] - shift);
    sp = sp.with(i - k, sp[i]);
    i = i + 1;
  }
  var j: i32 = l0;
  while (j < nl) {
    lines = lines.with(j - l0, lines[j]);
    j = j + 1;
  }
  return Words { lines: lines, nl: nl - l0, pos: pos, meta: meta, sp: sp, n: n - k, at: at, best: best, link: link, dq: dq, breaks: breaks, costs: costs, nb: 0 };
}

function held_bytes(pos: i64[], n: i32): i32 {
  var total: i32 = 0;
  var k: i32 = 0;
  while (k < n) {
    total = total + lo32(pos[k]);
    k = k + 1;
  }
  return total;
}

// `flush_para(s)` — the paragraph laid out and written, and its words
// emptied for the next one to fill. The words are swapped out of the state
// for `spare` while they are laid out, so no one else holds them.
function flush_para(own s: State): State {
  var p: Para = s.p;
  var st: Settings = s.st;
  if (!p.open) {
    return s;
  }
  if (p.pending && !st.tagged) {
    p = Para { ...p, other_indent: p.first_indent };
  }
  if (p.pending && st.tagged) {
    // The continuation indent of a one-line tagged paragraph is the last
    // one any paragraph used, carried as a column of the LINE rather than
    // of the text after the prefix; when it would repeat the first line's
    // own indent it falls back to column 3 at the margin and to column 0
    // anywhere else. Under -p column 0 sits left of the prefix, which is
    // why such a paragraph's later lines get the whole width to spend.
    var lead: i32 = p.p_indent + st.prefix_out.len();
    var first: i32 = p.first_indent + lead;
    var other: i32 = p.sticky;
    if (other == first) {
      other = 0;
      if (first == 0) {
        other = 3;
      }
    }
    p = Para { ...p, other_indent: other - lead };
  }
  p = Para { ...p, sticky: p.other_indent + p.p_indent + st.prefix_out.len() };
  if (s.words.n == 0) {
    return State { ...s, p: para_reset(p) };
  }
  var ws: Words = s.words;
  s = State { ...s, words: s.spare };
  var lead: i32 = p.p_indent + st.prefix_out.len();
  var n: i32 = ws.n;
  ws = choose(ws, n, true, p, st, lead);
  var e: (Out, i32) = emit(s.o, ws, p, st, n);
  return State { ...s, o: e.0, p: para_reset(p), words: Words { ...ws, nl: 0, n: 0 } };
}

// ---- reading ----------------------------------------------------------------
//
// `Head` — what the start of a line says before its words are read: kind
// 0 a line the prefix does not match, 1 a line with nothing but blanks,
// 2 a line with words. `at` and `col` are where the words begin.
struct Head { kind: i32, p_indent: i32, indent: i32, at: i32, col: i32, pfx: boolean }

function starts_with_at(s: string, at: i32, pre: string): boolean {
  if (at + pre.len() > s.len()) {
    return false;
  }
  var k: i32 = 0;
  while (k < pre.len()) {
    if (s[at + k] as i32 != pre[k] as i32) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

function eat_blanks(line: string, i0: i32, col0: i32, tabs0: boolean): (i32, i32, boolean) {
  var i: i32 = i0;
  var col: i32 = col0;
  var tabs: boolean = tabs0;
  while (i < line.len() && is_blank_byte(line[i] as i32)) {
    if (line[i] as i32 == 9) {
      tabs = true;
      col = col / tab_width() * tab_width() + tab_width();
    } else {
      col = col + 1;
    }
    i = i + 1;
  }
  return (i, col, tabs);
}

// `scan_head(line, st, tabs)` — what the start of a line says before its
// words are read. Under -p the prefix is stripped of its TRAILING blanks
// for output and the indent is measured from the end of what is left, so
// `-p '# '` writes `#` and counts the blank after it as indent. A line
// whose prefix matches but whose own indent is shallower than the
// prefix's leading blanks is copied rather than formatted — with the
// prefix still stripped and rewritten.
// A prefix of nothing but blanks has no text to look for, so it matches
// the blanks themselves: the line has to open with at least as many, they
// become the prefix, and whatever blanks follow are the paragraph's
// indent. A line with fewer is copied, and one with exactly as many and
// nothing after them is a plain blank line rather than a prefixed one.
function scan_head_blank_prefix(line: string, st: Settings, tabs0: boolean): (Head, boolean) {
  var i: i32 = 0;
  var col: i32 = 0;
  var tabs: boolean = tabs0;
  while (col < st.prefix_lead && i < line.len() && is_blank_byte(line[i] as i32)) {
    if (line[i] as i32 == 9) {
      tabs = true;
      col = col / tab_width() * tab_width() + tab_width();
    } else {
      col = col + 1;
    }
    i = i + 1;
  }
  if (col < st.prefix_lead || i >= line.len() && col == st.prefix_lead) {
    var e: (i32, i32, boolean) = eat_blanks(line, i, col, tabs);
    if (e.0 >= line.len()) {
      return (Head { kind: 1, p_indent: 0, indent: 0, at: 0, col: 0, pfx: false }, e.2);
    }
    return (Head { kind: 0, p_indent: e.1, indent: 0, at: e.0, col: e.1, pfx: false }, e.2);
  }
  // The prefix is that many COLUMNS whatever it took to reach them, so a
  // tab straddling the boundary leaves the rest of its width as indent.
  var lead: i32 = st.prefix_lead;
  var e2: (i32, i32, boolean) = eat_blanks(line, i, col, tabs);
  i = e2.0;
  col = e2.1;
  tabs = e2.2;
  if (i >= line.len()) {
    return (Head { kind: 1, p_indent: lead, indent: 0, at: 0, col: 0, pfx: true }, tabs);
  }
  return (Head { kind: 2, p_indent: lead, indent: col - lead, at: i, col: col, pfx: true }, tabs);
}

function scan_head(line: string, st: Settings, tabs0: boolean): (Head, boolean) {
  if (st.prefix.len() == 0 && st.prefix_lead > 0) {
    return scan_head_blank_prefix(line, st, tabs0);
  }
  var e: (i32, i32, boolean) = eat_blanks(line, 0, 0, tabs0);
  var i: i32 = e.0;
  var col: i32 = e.1;
  var tabs: boolean = e.2;
  if (st.prefix.len() == 0) {
    if (i >= line.len()) {
      return (Head { kind: 1, p_indent: 0, indent: 0, at: 0, col: 0, pfx: false }, tabs);
    }
    return (Head { kind: 2, p_indent: 0, indent: col, at: i, col: col, pfx: false }, tabs);
  }
  if (i >= line.len()) {
    return (Head { kind: 1, p_indent: 0, indent: 0, at: 0, col: 0, pfx: false }, tabs);
  }
  if (!starts_with_at(line, i, st.prefix)) {
    return (Head { kind: 0, p_indent: col, indent: 0, at: i, col: col, pfx: false }, tabs);
  }
  var lead: i32 = col;
  i = i + st.prefix.len();
  col = col + st.prefix.len();
  var start: i32 = lead + st.prefix_out.len();
  var e2: (i32, i32, boolean) = eat_blanks(line, i, col, tabs);
  i = e2.0;
  col = e2.1;
  tabs = e2.2;
  if (i >= line.len()) {
    return (Head { kind: 1, p_indent: lead, indent: 0, at: 0, col: 0, pfx: true }, tabs);
  }
  if (lead < st.prefix_lead) {
    return (Head { kind: 0, p_indent: lead, indent: col - start, at: i, col: col, pfx: true }, tabs);
  }
  return (Head { kind: 2, p_indent: lead, indent: col - start, at: i, col: col, pfx: true }, tabs);
}

// `scan_body(line, at, col, tabs)` — the words of a line and the columns
// between them, which is where a tab's width is decided: it reaches the
// next stop from the column it stands in, in the INPUT.
// `scan_body(s, line, at, col0)` — the line's words appended to the
// paragraph's. The state comes in owned and its words are read out and
// then dropped from it, which leaves the array with one holder so that
// it grows in place; a flush between two words rewrites the writer and
// the paragraph, which is why the whole state comes through here.
// The blanks between two words are the input's, unless -u replaces them
// with one — two after a sentence; a line boundary is always one blank,
// or two after a sentence. Whether the line carried a tab is the
// caller's one `__memchr`.
// GNU's word buffer is filled along the way: the 999th word flushes the
// 998 before it, and the byte that would not fit flushes the words that
// did — with nothing held, the bytes go out as they are and the word
// goes on from there.
function scan_body(own s: State, line: string, at: i32, col0: i32): State {
  var st: Settings = s.st;
  var o: Out = s.o;
  var p: Para = s.p;
  var bytes: i32 = s.bytes;
  var uniform: boolean = st.uniform;
  var ws: Words = s.words;
  s = State { ...s, words: s.spare };
  var lines: string[] = ws.lines;
  var nl: i32 = ws.nl;
  var pos: i64[] = ws.pos;
  var meta: i64[] = ws.meta;
  var gaps: i64[] = ws.sp;
  var nw: i32 = ws.n;
  var tat: i32[] = ws.at;
  var tbest: i64[] = ws.best;
  var tlink: i64[] = ws.link;
  var tdq: i32[] = ws.dq;
  var tbr: i32[] = ws.breaks;
  var tco: i64[] = ws.costs;
  // The index this line is stored at among `lines`, once it has a word.
  var li: i32 = 0 - 1;
  var i: i32 = at;
  var col: i32 = col0;
  var n: i32 = line.len();
  var prev_sentence: boolean = false;
  var first: boolean = true;
  if (nw > 0) {
    prev_sentence = (meta[nw - 1] & 2 as i64) != 0 as i64;
  }
  while (i < n) {
    var j: i32 = __scan_set(line, i, st.blank);
    var wcol: i32 = col;
    col = col + (j - i);
    var lo: i32 = i;
    i = __scan_set(line, j, st.ink);
    var sp: i32 = i - j;
    if (sp > 1 || sp == 1 && line[j] as i32 == 9) {
      sp = 0;
      var b: i32 = j;
      while (b < i) {
        if (line[b] as i32 == 9) {
          sp = sp + ((col + sp) / tab_width() * tab_width() + tab_width() - (col + sp));
        } else {
          sp = sp + 1;
        }
        b = b + 1;
      }
    }
    col = col + sp;
    var space: i32 = 1;
    if (first) {
      if (nw == 0) {
        space = 0;
      } else if (prev_sentence) {
        space = 2;
      }
    } else if (uniform) {
      if (prev_sentence) {
        space = 2;
      }
    } else {
      space = lo32(gaps[nw - 1]);
    }
    while (bytes + (j - lo) > buffer_bytes()) {
      if (nw == 0) {
        buf_push_range(o.w.handle(), line, lo, lo + buffer_bytes());
        lo = lo + buffer_bytes();
      } else {
        var c: (Out, Para, Words) = chunk(o, p, Words { lines: lines, nl: nl, pos: pos, meta: meta, sp: gaps, n: nw, at: tat, best: tbest, link: tlink, dq: tdq, breaks: tbr, costs: tco, nb: 0 }, nw, st, wcol);
        o = c.0;
        p = c.1;
        var hw: Words = c.2;
        tat = hw.at;
        tbest = hw.best;
        tlink = hw.link;
        tdq = hw.dq;
        tbr = hw.breaks;
        tco = hw.costs;
        lines = hw.lines;
        nl = hw.nl;
        pos = hw.pos;
        meta = hw.meta;
        gaps = hw.sp;
        nw = hw.n;
        if (li >= 0) {
          li = nl - 1;
        }
        bytes = held_bytes(pos, nw);
      }
    }
    if (li < 0) {
      li = nl;
      if (nl < lines.len()) {
        lines = lines.with(nl, line);
      } else {
        lines = lines.append(line);
      }
      nl = nl + 1;
    }
    var f: i32 = word_flags(st.cls, line, lo, j, sp, i >= n);
    prev_sentence = (f & f_sentence()) != 0;
    first = false;
    var wp: i64 = ((lo as i64) << 32 as i64) | (j - lo) as i64;
    var wm: i64 = ((li as i64) << 8 as i64) | f as i64;
    var wg: i64 = ((space as i64) << 32 as i64) | sp as i64;
    if (nw < pos.len()) {
      pos = pos.with(nw, wp);
      meta = meta.with(nw, wm);
      gaps = gaps.with(nw, wg);
    } else {
      pos = pos.append(wp);
      meta = meta.append(wm);
      gaps = gaps.append(wg);
    }
    nw = nw + 1;
    bytes = bytes + (j - lo);
    if (nw > buffer_words()) {
      var c1: (Out, Para, Words) = chunk(o, p, Words { lines: lines, nl: nl, pos: pos, meta: meta, sp: gaps, n: nw, at: tat, best: tbest, link: tlink, dq: tdq, breaks: tbr, costs: tco, nb: 0 }, buffer_words(), st, col);
      o = c1.0;
      p = c1.1;
      var hw1: Words = c1.2;
      tat = hw1.at;
      tbest = hw1.best;
      tlink = hw1.link;
      tdq = hw1.dq;
      tbr = hw1.breaks;
      tco = hw1.costs;
      lines = hw1.lines;
      nl = hw1.nl;
      pos = hw1.pos;
      meta = hw1.meta;
      gaps = hw1.sp;
      nw = hw1.n;
      li = 0 - 1;
      if (nw > 0) {
        li = nl - 1;
      }
      bytes = held_bytes(pos, nw);
    }
  }
  return State { ...s, o: o, p: p, bytes: bytes, words: Words { lines: lines, nl: nl, pos: pos, meta: meta, sp: gaps, n: nw, at: tat, best: tbest, link: tlink, dq: tdq, breaks: tbr, costs: tco, nb: 0 } };
}

// ---- the driver -------------------------------------------------------------
// `bytes` is how much word text the paragraph holds, GNU's buffer fill.
// `words` is the paragraph's; `spare` an empty store that stands in for it
// while a function holds the paragraph's alone.
struct State { o: Out, p: Para, words: Words, spare: Words, bytes: i32, st: Settings, ok: boolean }

// `feed(s, line, term)` — one input line. The state comes in by ownership
// and is passed on to `scan_body` the same way, rebuilt IN PLACE first:
// a fresh record built from `s` while `s` still stands shares the words
// with it, and the append then copies them, once per line — quadratic
// in the paragraph.
function feed(own s: State, line: string, term: boolean): State {
  var st: Settings = s.st;
  var r: (Head, boolean) = scan_head(line, st, s.o.tabs);
  var h: Head = r.0;
  var o: Out = Out { ...s.o, tabs: r.1 };
  if (h.kind == 0) {
    s = flush_para(State { ...s, o: o });
    var o0: Out = s.o;
    var h0: usize = o0.w.handle();
    var col: i32 = o0.col;
    push_spacing(h0, col, h.p_indent, o0.tabs);
    col = col + h.p_indent;
    if (h.pfx) {
      buf_push(h0, st.prefix_out);
      col = col + st.prefix_out.len();
      push_spacing(h0, col, h.indent, o0.tabs);
      col = col + h.indent;
    }
    buf_push_range(h0, line, h.at, line.len());
    if (term) {
      buf_push_byte(h0, 10);
    }
    return State { ...s, o: Out { ...o0, w: gnu.settle(o0.w), col: 0 }, bytes: 0 };
  }
  if (h.kind == 1) {
    s = flush_para(State { ...s, o: o });
    var o1: Out = s.o;
    // A blank line the prefix does not carry is copied like any other
    // unmatched line, so an unterminated one ends the output without a
    // newline of its own.
    if (!term && (st.prefix.len() > 0 || st.prefix_lead > 0) && !h.pfx) {
      return State { ...s, o: Out { ...o1, w: gnu.settle(o1.w), col: 0 }, bytes: 0 };
    }
    var h1: usize = o1.w.handle();
    if (h.pfx) {
      push_spacing(h1, o1.col, h.p_indent, o1.tabs);
      buf_push(h1, st.prefix_out);
    }
    buf_push_byte(h1, 10);
    return State { ...s, o: Out { ...o1, w: gnu.settle(o1.w), col: 0 }, bytes: 0 };
  }
  var p: Para = s.p;
  var flush: boolean = st.split && p.open;
  if (!flush && p.open) {
    if (h.p_indent != p.p_indent) {
      flush = true;
    } else if (p.pending) {
      if (st.tagged && h.indent == p.first_indent) {
        flush = true;
      } else {
        p = Para { ...p, other_indent: h.indent, pending: false };
      }
    } else if (h.indent != p.other_indent) {
      flush = true;
    }
  }
  if (flush) {
    s = flush_para(State { ...s, o: o, p: p });
    o = s.o;
    p = s.p;
    s = State { ...s, bytes: 0 };
  }
  if (!p.open) {
    p = Para { ...p, first_indent: h.indent, other_indent: h.indent, p_indent: h.p_indent, pending: st.crown || st.tagged, open: true };
  }
  if (!o.tabs && __memchr(line, 9, h.at) >= 0) {
    o = Out { ...o, tabs: true };
  }
  s = State { ...s, o: o, p: p };
  return scan_body(s, line, h.at, h.col);
}

// ---- options ----------------------------------------------------------------
// `width_of(text, max, range)` — a `-w` or `-g` value as gnulib's
// xnumtoumax parses it: leading white space and a leading `+` are
// accepted, a `-` is not, and the whole string has to be digits.
// Anything above `max` is out of range, and which errno that reads as
// is the caller's: `-w` asks for ERANGE because its bound is the
// caller's own, `-g` gets xdectoumax's default EOVERFLOW. A usage error
// here prints one line and NO `Try …` line.
function width_of(text: string, max: i32, range: boolean): i32 {
  var i: i32 = 0;
  while (i < text.len() && (text[i] as i32 == 32 || text[i] as i32 >= 9 && text[i] as i32 <= 13)) {
    i = i + 1;
  }
  if (i < text.len() && text[i] as i32 == 43) {
    i = i + 1;
  }
  var digits: i32 = i;
  var value: i64 = 0 as i64;
  var over: boolean = false;
  while (i < text.len() && gnu.is_digit(text[i] as i32)) {
    if (value > 200000000 as i64) {
      over = true;
    } else {
      value = value * (10 as i64) + (text[i] as i32 - 48) as i64;
    }
    i = i + 1;
  }
  if (i == digits || i != text.len()) {
    gnu.error("invalid width: " + gnu.quote(text));
    exit(1);
  }
  if (over || value > max as i64) {
    var why: string = ": " + gnu.eoverflow_text();
    if (range) {
      why = ": " + gnu.erange_text();
    }
    gnu.error("invalid width: " + gnu.quote(text) + why);
    exit(1);
  }
  return value as i32;
}

function digit_of(id: i32): string {
  return slice_unchecked("0123456789", id - 10, id - 9) + "";
}

pub function main(): i32 {
  var argv: string[] = args();

  // The obsolete `-WIDTH`: only argv[1], and everything after the `-` is
  // the width text, so `-5x` is an invalid width and not a cluster.
  var obsolete: string = "";
  var have_obsolete: boolean = false;
  if (argv.len() > 1 && argv[1].len() >= 2 && argv[1][0] as i32 == 45 && gnu.is_digit(argv[1][1] as i32)) {
    obsolete = slice_unchecked(argv[1], 1, argv[1].len()) + "";
    have_obsolete = true;
    var rest: string[] = [argv[0]];
    var k: i32 = 2;
    while (k < argv.len()) {
      rest = rest.append(argv[k]);
      k = k + 1;
    }
    argv = rest;
  }

  var opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("c", "crown-margin", opt_crown()));
  opts = opts.append(gnu.valued("p", "prefix", opt_prefix()));
  opts = opts.append(gnu.flag("s", "split-only", opt_split()));
  opts = opts.append(gnu.flag("t", "tagged-paragraph", opt_tagged()));
  opts = opts.append(gnu.flag("u", "uniform-spacing", opt_uniform()));
  opts = opts.append(gnu.valued("w", "width", opt_width()));
  opts = opts.append(gnu.valued("g", "goal", opt_goal()));
  var d: i32 = 0;
  while (d < 10) {
    opts = opts.append(gnu.flag(slice_unchecked("0123456789", d, d + 1) + "", "", opt_digit(d)));
    d = d + 1;
  }

  var crown: boolean = false;
  var tagged: boolean = false;
  var split: boolean = false;
  var uniform: boolean = false;
  var prefix: string = "";
  var width: i32 = 75;
  var width_text: string = "";
  var have_width: boolean = false;
  var goal: i32 = 0;
  var goal_text: string = "";
  var have_goal: boolean = false;
  if (have_obsolete) {
    width_text = obsolete;
    have_width = true;
  }

  var g: gnu.Getopt = gnu.getopt_new(argv, opts, "fmt", help_text(), 1);
  while (true) {
    var r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_crown()) {
          crown = true;
        } else if (m.id == opt_prefix()) {
          prefix = m.value;
        } else if (m.id == opt_split()) {
          split = true;
        } else if (m.id == opt_tagged()) {
          tagged = true;
        } else if (m.id == opt_uniform()) {
          uniform = true;
        } else if (m.id == opt_width()) {
          width_text = m.value;
          have_width = true;
        } else if (m.id == opt_goal()) {
          goal_text = m.value;
          have_goal = true;
        } else {
          gnu.die_usage("invalid option -- " + digit_of(m.id) + "; -WIDTH is recognized only when it is the first\noption; use -w N instead", 1);
        }
      },
      None => {
        break;
      }
    }
  }

  // Both values are read here rather than in the loop, because the
  // goal's bound is the width, whichever order the two were given in.
  if (have_width) {
    width = width_of(width_text, max_width_limit(), true);
  }
  if (have_goal) {
    goal = width_of(goal_text, width, false);
    if (!have_width) {
      width = goal + 10;
    }
  } else {
    goal = width * 187 / 200;
  }

  var lead: i32 = 0;
  while (lead < prefix.len() && prefix[lead] as i32 == 32) {
    lead = lead + 1;
  }
  var text: string = slice_unchecked(prefix, lead, prefix.len()) + "";
  var last: i32 = text.len();
  while (last > 0 && text[last - 1] as i32 == 32) {
    last = last - 1;
  }
  var st: Settings = Settings { max_width: width, goal: goal, crown: crown && !split, tagged: tagged && !crown && !split, split: split, uniform: uniform, prefix: text, prefix_out: slice_unchecked(text, 0, last) + "", prefix_lead: lead, blank: byte_set(true), ink: byte_set(false), cls: byte_classes() };

  var files: string[] = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  return run(files, st);
}

// `run(files, st)` — every FILE in turn. A paragraph never spans a file
// boundary, so one is flushed at the end of each; a line may span two
// read blocks, so `carry` holds the part that has no terminator yet.
function run(files: string[], st: Settings): i32 {
  var s: State = State { o: Out { w: gnu.out_with(block_size()), col: 0, tabs: false }, p: para_new(), words: words_new(), spare: words_new(), bytes: 0, st: st, ok: true };

  var used_stdin: boolean = false;
  var fi: i32 = 0;
  while (fi < files.len()) {
    var name: string = files[fi];
    fi = fi + 1;
    var is_stdin: boolean = name == "-";
    var r: Reader = stdin();
    var opened: boolean = true;
    if (is_stdin) {
      used_stdin = true;
    }
    if (!is_stdin) {
      match (open_reader(name)) {
        Ok(f) => {
          r = f;
        },
        Err(e) => {
          s = State { ...s, o: report(s.o, "cannot open " + gnu.quote(name) + " for reading: " + gnu.io_error_text(e)), ok: false };
          opened = false;
        }
      }
    }
    if (opened) {
      var carry: string = "";
      while (true) {
        var piece: string = "";
        var more: boolean = true;
        match (r.read_chunk(read_size())) {
          Ok(c) => {
            piece = c;
          },
          Err(e) => {
            // GNU words the two differently: stdin has no name to
            // print, a FILE is named with shell-escape quoting.
            var why: string = "read error: " + gnu.io_error_text(e);
            if (!is_stdin) {
              why = "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e);
            }
            s = State { ...s, o: report(s.o, why), ok: false };
            more = false;
          }
        }
        if (!more || piece.len() == 0) {
          break;
        }
        var data: string = piece;
        if (carry.len() > 0) {
          data = carry + piece;
          carry = "";
        }
        var i: i32 = 0;
        while (i < data.len()) {
          var j: i32 = __memchr(data, 10, i);
          if (j < 0) {
            carry = slice_unchecked(data, i, data.len()) + "";
            break;
          }
          s = feed(s, slice_unchecked(data, i, j) + "", true);
          i = j + 1;
        }
      }
      if (carry.len() > 0) {
        s = feed(s, carry, false);
      }
      if (!is_stdin) {
        r.close();
      }
      s = flush_para(s);
      s = State { ...s, bytes: 0 };
    }
  }

  // gnulib's close_stdin, which only runs when stdin was read at all: a
  // descriptor that was closed before the program started reports the
  // read error first and then this, and `fmt FILE <&-` reports neither.
  if (used_stdin) {
    match (stdin().close()) {
      Some(e) => {
        s = State { ...s, o: report(s.o, "closing standard input: " + gnu.io_error_text(e)), ok: false };
      },
      None => {}
    }
  }

  gnu.finish(s.o.w);
  if (!s.ok) {
    return 1;
  }
  return 0;
}

// A diagnostic with the buffered output flushed ahead of it, so the two
// streams stay in the order gnulib's error() puts them in.
function report(o: Out, msg: string): Out {
  return Out { ...o, w: gnu.error_out(o.w, msg) };
}
