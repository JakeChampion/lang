import "std/array";
import "std/io_buffered";
import "./lib/gnu";

function opt_crown(): i32 {
  return 1;
}

function opt_prefix(): i32 {
  return 2;
}

function opt_split(): i32 {
  return 3;
}

function opt_tagged(): i32 {
  return 4;
}

function opt_uniform(): i32 {
  return 5;
}

function opt_width(): i32 {
  return 6;
}

function opt_goal(): i32 {
  return 7;
}

function opt_digit(d: i32): i32 {
  return 10 + d;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [-WIDTH] [OPTION]... [FILE]...\n";
  out += "Reformat each paragraph in the FILE(s), writing to standard output.\n";
  out += "The option -WIDTH is an abbreviated form of --width=DIGITS.\n";
  out += "\n";
  out += "With no FILE, or when FILE is -, read standard input.\n";
  out += "\n";
  out += "  -c, --crown-margin        preserve indentation of first two lines\n";
  out += "  -p, --prefix=STRING       reformat only lines beginning with STRING,\n";
  out += "                              reattaching the prefix to reformatted lines\n";
  out += "  -s, --split-only          split long lines, but do not refill\n";
  out += "  -t, --tagged-paragraph    indentation of first line different from second\n";
  out += "  -u, --uniform-spacing     one space between words, two after sentences\n";
  out += "  -w, --width=WIDTH         maximum line width (default of 75 columns)\n";
  out += "  -g, --goal=WIDTH          goal width (default of 93% of width)\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  return out;
}

function read_size(): i32 {
  return 65536;
}

function block_size(): i32 {
  return 16384;
}

function tab_width(): i32 {
  return 8;
}

function buffer_words(): i32 {
  return 998;
}

function buffer_bytes(): i32 {
  return 5000;
}

function max_width_limit(): i32 {
  return 2500;
}

const SHORT: i64 = 100;

const RAGGED: i64 = 50;

const LINE_COST_BASE: i64 = 4900;

const WIDOW_COST: i64 = 40000;

const ORPHAN_COST: i64 = 22500;

const SENTENCE_BONUS: i64 = 2500;

const NOBREAK_COST: i64 = 360000;

const PUNCT_BONUS: i64 = 1600;

const PAREN_BONUS: i64 = 1600;

const COST_INFINITY: i64 = 4611686018427387904;

const LINE_CREDIT: i64 = 9;

const COST_MAX: i64 = 9223372036854775807;

struct Words { lines: u8[][], nl: i32, pos: i64[], meta: i64[], sp: i64[], n: i32, at: i32[], best: i64[], link: i64[], dq: i32[], breaks: i32[], costs: i64[], nb: i32 }

function words_new(): Words {
  return Words { lines: [], nl: 0, pos: [], meta: [], sp: [], n: 0, at: [], best: [], link: [], dq: [], breaks: [], costs: [], nb: 0 };
}

function f_period(): i32 {
  return 1;
}

function f_sentence(): i32 {
  return 2;
}

function f_punct(): i32 {
  return 4;
}

function f_paren(): i32 {
  return 8;
}

function lo32(v: i64): i32 {
  return (v & 4294967295 as i64) as i32;
}

function hi32(v: i64): i32 {
  return (v >> 32 as i64) as i32;
}

function pair(hi: i32, lo: i32): i64 {
  return hi as i64 << 32 as i64 | lo as i64 & 4294967295 as i64;
}

function is_blank_byte(c: i32): boolean {
  return c == 32 || c == 9;
}

function is_closer(c: i32): boolean {
  return c == 41 || c == 93 || c == 39 || c == 34;
}

function is_paren(c: i32): boolean {
  return c == 40 || c == 91 || c == 96 || c == 39 || c == 34;
}

function is_end_punct(c: i32): boolean {
  return c == 46 || c == 63 || c == 33;
}

function is_punct(c: i32): boolean {
  if (c < 33 || c > 126) {
    return false;
  }
  if (c >= 48 && c <= 57) {
    return false;
  }
  if (c >= 65 && c <= 90) {
    return false;
  }
  if (c >= 97 && c <= 122) {
    return false;
  }
  return true;
}

function byte_classes(): u8[] {
  let cls = __alloc_u8(256);
  let c = 0;
  while (c < 256) {
    let k = 0;
    if (is_closer(c)) {
      k = k | 1;
    }
    if (is_end_punct(c)) {
      k = k | 2;
    } else if (is_punct(c)) {
      k = k | 4;
    }
    if (is_paren(c)) {
      k = k | 8;
    }
    cls = cls.with(c, k as u8);
    c += 1;
  }
  return cls;
}

function word_flags(cls: u8[], line: u8[], lo: i32, hi: i32, gap: i32, at_eol: boolean): i32 {
  let e = hi;
  while (e > lo && (cls[line[e - 1] as i32] as i32 & 1) != 0) {
    e -= 1;
  }
  let f = 0;
  if (e > lo && (cls[line[e - 1] as i32] as i32 & 2) != 0) {
    f = f_period();
    if (at_eol || gap >= 2) {
      f = f | f_sentence();
    }
  }
  if ((cls[line[hi - 1] as i32] as i32 & 4) != 0) {
    f = f | f_punct();
  }
  if ((cls[line[lo] as i32] as i32 & 8) != 0) {
    f = f | f_paren();
  }
  return f;
}

struct Settings { max_width: i32, goal: i32, crown: boolean, tagged: boolean, split: boolean, uniform: boolean, prefix: string, prefix_out: string, prefix_lead: i32, blank: u8[], ink: u8[], cls: u8[] }

function byte_set(members: boolean): u8[] {
  let set = __alloc_u8(256);
  let c = 0;
  while (c < 256) {
    if (is_blank_byte(c) == members) {
      set = set.with(c, 1 as u8);
    }
    c += 1;
  }
  return set;
}

struct Out { w: io_buffered.BufWriter, col: i32, tabs: boolean }

function finish_out(own o: Out): void {
  gnu.finish(o.w);
}

function push_spacing(h: usize, col: i32, n: i32, tabs: boolean): void {
  if (n <= 0) {
    return;
  }
  let target = col + n;
  let c = col;
  if (tabs) {
    let last = target / tab_width() * tab_width();
    if (last - c >= 2) {
      while (c / tab_width() * tab_width() + tab_width() <= last) {
        buf_push_byte(h, 9);
        c = c / tab_width() * tab_width() + tab_width();
      }
    }
  }
  while (c < target) {
    buf_push_byte(h, 32);
    c += 1;
  }
}

struct Para { open: boolean, pending: boolean, first_indent: i32, other_indent: i32, p_indent: i32, sticky: i32, last_len: i32 }

function para_new(): Para {
  return Para { open: false, pending: false, first_indent: 0, other_indent: 0, p_indent: 0, sticky: 0, last_len: 0 };
}

function para_reset(p: Para): Para {
  return Para { ...p, open: false, pending: false, first_indent: 0, other_indent: 0, p_indent: 0, last_len: 0 };
}

function base_cost(pos: i64[], meta: i64[], s: i32, sentence_at: i32): i64 {
  let c = LINE_COST_BASE;
  if (s > 0) {
    let pf = (meta[s - 1] & 255 as i64) as i32;
    if (s - 1 == sentence_at) {
      pf = pf | f_sentence();
    }
    if ((pf & f_sentence()) != 0) {
      c -= SENTENCE_BONUS;
    } else if ((pf & f_period()) != 0) {
      c += NOBREAK_COST;
    } else if ((pf & f_punct()) != 0) {
      c -= PUNCT_BONUS;
    } else if (s > 1 && (meta[s - 2] & 2 as i64) != 0 as i64) {
      c = c + WIDOW_COST / ((lo32(pos[s - 1]) + 2) as i64);
    }
  }
  let f = (meta[s] & 255 as i64) as i32;
  if (s == sentence_at) {
    f = f | f_sentence();
  }
  if ((f & f_paren()) != 0) {
    c -= PAREN_BONUS;
  } else if ((f & f_sentence()) != 0) {
    c = c + ORPHAN_COST / ((lo32(pos[s]) + 2) as i64);
  }
  return c;
}

function choose(own ws: Words, n: i32, last: boolean, p: Para, st: Settings, lead: i32): Words {
  let maxw = st.max_width - lead;
  let goal = st.goal - lead;
  let lines = ws.lines;
  let nl = ws.nl;
  let pos = ws.pos;
  let meta = ws.meta;
  let sp = ws.sp;
  let count = ws.n;
  let at = ws.at;
  let best = ws.best;
  let link = ws.link;
  let dq = ws.dq;
  let breaks = ws.breaks;
  let costs = ws.costs;
  let sentence_at: i32 = -1;
  if (last) {
    sentence_at = n - 1;
  }
  while (at.len() <= n) {
    at = at.append(0);
  }
  while (best.len() < n) {
    best = best.append(0 as i64);
    link = link.append(0 as i64);
  }
  let sum = 0;
  let k = 0;
  while (k < n) {
    sum = sum + (sp[k] >> 32 as i64) as i32 + (pos[k] & 4294967295 as i64) as i32;
    at = at.with(k + 1, sum);
    k += 1;
  }
  let bot = 0;
  let top = 0;
  let r = n;
  let s = n - 1;
  while (s >= 0) {
    let wl = (pos[s] & 4294967295 as i64) as i32;
    let from = p.other_indent + wl - at[s + 1];
    let rag = 0;
    if (s == 0) {
      from = p.first_indent + wl - at[s + 1];
      rag = p.last_len;
    }
    while (r > s + 1 && from + at[r] > maxw) {
      r -= 1;
    }
    let window = r;
    while (r < n && from + at[r + 1] <= maxw) {
      r += 1;
    }
    if (s + 1 < n) {
      let v = best[s + 1];
      while (top > bot && best[dq[top - 1]] >= v) {
        top -= 1;
      }
      if (top < dq.len()) {
        dq = dq.with(top, s + 1);
      } else {
        dq = dq.append(s + 1);
      }
      top += 1;
    }
    while (top > bot && dq[bot] > r) {
      bot += 1;
    }
    // The least rest cost a break in reach can carry. The deque holds
    // nothing past the window, and only a first line indented less than
    // the other lines reaches past it.
    let floor: i64 = 0 - COST_INFINITY;
    if (r == window && top > bot) {
      floor = best[dq[bot]];
    }
    let bcost = COST_INFINITY;
    let bnext = n;
    let blen = 0;
    let w = r;
    while (w > s) {
      let ln = from + at[w];
      let c = 0 as i64;
      let rest = 0 as i64;
      if (w != n) {
        let d = (goal - ln) as i64;
        let short = SHORT * d * d;
        if (ln <= goal && short + floor > bcost) {
          break;
        }
        c = short;
        let lk = link[w];
        if ((lk >> 32 as i64) as i32 != n) {
          let dr = (ln - (lk & 4294967295 as i64) as i32) as i64;
          c = c + RAGGED * dr * dr;
        }
        rest = best[w];
      }
      if (rag > 0) {
        let df = (ln + lead - rag) as i64;
        c = c + RAGGED * df * df;
      }
      if (c + rest <= bcost) {
        bcost = c + rest;
        bnext = w;
        blen = ln;
      }
      w -= 1;
    }
    best = best.with(s, bcost + base_cost(pos, meta, s, sentence_at));
    link = link.with(s, pair(bnext, blen));
    s -= 1;
  }
  let nb = 0;
  let i = 0;
  while (i < n) {
    let j = hi32(link[i]);
    let after = 0 as i64;
    if (j != n) {
      after = best[j];
    }
    if (nb < breaks.len()) {
      breaks = breaks.with(nb, j);
      costs = costs.with(nb, best[i] - after);
    } else {
      breaks = breaks.append(j);
      costs = costs.append(best[i] - after);
    }
    nb += 1;
    i = j;
  }
  return Words { lines: lines, nl: nl, pos: pos, meta: meta, sp: sp, n: count, at: at, best: best, link: link, dq: dq, breaks: breaks, costs: costs, nb: nb };
}

function emit(o0: Out, ws: Words, p: Para, st: Settings, upto: i32): (Out, i32) {
  let col = o0.col;
  let tabs = o0.tabs;
  let w = o0.w;
  let h = w.handle();
  let i = 0;
  let b = 0;
  let first = true;
  let last = 0;
  while (i < upto) {
    let j = ws.breaks[b];
    b += 1;
    if (st.prefix.len() > 0 || st.prefix_lead > 0) {
      push_spacing(h, col, p.p_indent, tabs);
      col += p.p_indent;
      buf_push(h, st.prefix_out);
      col += st.prefix_out.len();
    }
    let ind = p.other_indent;
    if (first) {
      ind = p.first_indent;
    }
    if (ind > 0) {
      push_spacing(h, col, ind, tabs);
      col += ind;
    }
    let k = i;
    while (k < j) {
      if (k > i) {
        let space = hi32(ws.sp[k]);
        if (space == 1) {
          buf_push_byte(h, 32);
        } else {
          push_spacing(h, col, space, tabs);
        }
        col += space;
      }
      let at = ws.pos[k];
      let lo = hi32(at);
      let wl = lo32(at);
      buf_push_bytes_range(h, ws.lines[(ws.meta[k] >> 8 as i64) as i32], lo, lo + wl);
      col += wl;
      k += 1;
    }
    last = col;
    buf_push_byte(h, 10);
    col = 0;
    w = gnu.settle(w);
    first = false;
    i = j;
  }
  return (Out { w: w, col: col, tabs: tabs }, last);
}

function chunk(o0: Out, p0: Para, own ws: Words, n: i32, st: Settings, col: i32): (Out, Para, Words) {
  let lead = p0.p_indent + st.prefix_out.len();
  let first = p0.first_indent + lead;
  let other = first;
  if (st.split) {
    other = first;
  } else if (st.crown) {
    other = col;
  } else if (st.tagged) {
    other = p0.other_indent + lead;
    if (p0.pending) {
      other = p0.sticky;
    }
    if (col != first) {
      other = col;
    } else if (other == first) {
      other = 0;
      if (first == 0) {
        other = 3;
      }
    }
  }
  let p = Para { ...p0, other_indent: other - lead, sticky: other };
  ws = choose(ws, n, false, p, st, lead);
  let split = n;
  let best = COST_MAX;
  let b = 1;
  let w = ws.breaks[0];
  while (w != n) {
    if (ws.costs[b] < best) {
      split = w;
      best = ws.costs[b];
    }
    if (best <= COST_MAX - LINE_CREDIT) {
      best += LINE_CREDIT;
    }
    w = ws.breaks[b];
    b += 1;
  }
  let e: (Out, i32) = emit(o0, ws, p, st, split);
  return (e.0, Para { ...p, last_len: e.1 }, drop_front(ws, split));
}

function drop_front(own ws: Words, k: i32): Words {
  let lines = ws.lines;
  let nl = ws.nl;
  let pos = ws.pos;
  let meta = ws.meta;
  let sp = ws.sp;
  let n = ws.n;
  let at = ws.at;
  let best = ws.best;
  let link = ws.link;
  let dq = ws.dq;
  let breaks = ws.breaks;
  let costs = ws.costs;
  if (k >= n) {
    return Words { lines: lines, nl: 0, pos: pos, meta: meta, sp: sp, n: 0, at: at, best: best, link: link, dq: dq, breaks: breaks, costs: costs, nb: 0 };
  }
  let l0 = (meta[k] >> 8 as i64) as i32;
  let shift = l0 as i64 << 8 as i64;
  let i = k;
  while (i < n) {
    pos = pos.with(i - k, pos[i]);
    meta = meta.with(i - k, meta[i] - shift);
    sp = sp.with(i - k, sp[i]);
    i += 1;
  }
  let j = l0;
  while (j < nl) {
    lines = lines.with(j - l0, lines[j]);
    j += 1;
  }
  return Words { lines: lines, nl: nl - l0, pos: pos, meta: meta, sp: sp, n: n - k, at: at, best: best, link: link, dq: dq, breaks: breaks, costs: costs, nb: 0 };
}

function held_bytes(pos: i64[], n: i32): i32 {
  let total = 0;
  let k = 0;
  while (k < n) {
    total += lo32(pos[k]);
    k += 1;
  }
  return total;
}

function flush_para(own s: State): State {
  let p = s.p;
  let st = s.st;
  if (!p.open) {
    return s;
  }
  if (p.pending && !st.tagged) {
    p = Para { ...p, other_indent: p.first_indent };
  }
  if (p.pending && st.tagged) {
    let lead = p.p_indent + st.prefix_out.len();
    let first = p.first_indent + lead;
    let other = p.sticky;
    if (other == first) {
      other = 0;
      if (first == 0) {
        other = 3;
      }
    }
    p = Para { ...p, other_indent: other - lead };
  }
  p = Para { ...p, sticky: p.other_indent + p.p_indent + st.prefix_out.len() };
  if (s.words.n == 0) {
    return State { ...s, p: para_reset(p) };
  }
  let ws = s.words;
  s = State { ...s, words: s.spare };
  let lead = p.p_indent + st.prefix_out.len();
  let n = ws.n;
  ws = choose(ws, n, true, p, st, lead);
  let e: (Out, i32) = emit(s.o, ws, p, st, n);
  return State { ...s, o: e.0, p: para_reset(p), words: Words { ...ws, nl: 0, n: 0 } };
}

struct Head { kind: i32, p_indent: i32, indent: i32, at: i32, col: i32, pfx: boolean }

function starts_with_at(s: u8[], at: i32, pre: string): boolean {
  if (at + pre.len() > s.len()) {
    return false;
  }
  let k = 0;
  while (k < pre.len()) {
    if (s[at + k] as i32 != pre[k] as i32) {
      return false;
    }
    k += 1;
  }
  return true;
}

function eat_blanks(line: u8[], i0: i32, col0: i32, tabs0: boolean): (i32, i32, boolean) {
  let i = i0;
  let col = col0;
  let tabs = tabs0;
  while (i < line.len() && is_blank_byte(line[i] as i32)) {
    if (line[i] as i32 == 9) {
      tabs = true;
      col = col / tab_width() * tab_width() + tab_width();
    } else {
      col += 1;
    }
    i += 1;
  }
  return (i, col, tabs);
}

function scan_head_blank_prefix(line: u8[], st: Settings, tabs0: boolean): (Head, boolean) {
  let i = 0;
  let col = 0;
  let tabs = tabs0;
  while (col < st.prefix_lead && i < line.len() && is_blank_byte(line[i] as i32)) {
    if (line[i] as i32 == 9) {
      tabs = true;
      col = col / tab_width() * tab_width() + tab_width();
    } else {
      col += 1;
    }
    i += 1;
  }
  if (col < st.prefix_lead || i >= line.len() && col == st.prefix_lead) {
    let e: (i32, i32, boolean) = eat_blanks(line, i, col, tabs);
    if (e.0 >= line.len()) {
      return (Head { kind: 1, p_indent: 0, indent: 0, at: 0, col: 0, pfx: false }, e.2);
    }
    return (Head { kind: 0, p_indent: e.1, indent: 0, at: e.0, col: e.1, pfx: false }, e.2);
  }
  let lead = st.prefix_lead;
  let e2: (i32, i32, boolean) = eat_blanks(line, i, col, tabs);
  i = e2.0;
  col = e2.1;
  tabs = e2.2;
  if (i >= line.len()) {
    return (Head { kind: 1, p_indent: lead, indent: 0, at: 0, col: 0, pfx: true }, tabs);
  }
  return (Head { kind: 2, p_indent: lead, indent: col - lead, at: i, col: col, pfx: true }, tabs);
}

function scan_head(line: u8[], st: Settings, tabs0: boolean): (Head, boolean) {
  if (st.prefix.len() == 0 && st.prefix_lead > 0) {
    return scan_head_blank_prefix(line, st, tabs0);
  }
  let e: (i32, i32, boolean) = eat_blanks(line, 0, 0, tabs0);
  let i = e.0;
  let col = e.1;
  let tabs = e.2;
  if (st.prefix.len() == 0) {
    if (i >= line.len()) {
      return (Head { kind: 1, p_indent: 0, indent: 0, at: 0, col: 0, pfx: false }, tabs);
    }
    return (Head { kind: 2, p_indent: 0, indent: col, at: i, col: col, pfx: false }, tabs);
  }
  if (i >= line.len()) {
    return (Head { kind: 1, p_indent: 0, indent: 0, at: 0, col: 0, pfx: false }, tabs);
  }
  if (!starts_with_at(line, i, st.prefix)) {
    return (Head { kind: 0, p_indent: col, indent: 0, at: i, col: col, pfx: false }, tabs);
  }
  let lead = col;
  i += st.prefix.len();
  col += st.prefix.len();
  let start = lead + st.prefix_out.len();
  let e2: (i32, i32, boolean) = eat_blanks(line, i, col, tabs);
  i = e2.0;
  col = e2.1;
  tabs = e2.2;
  if (i >= line.len()) {
    return (Head { kind: 1, p_indent: lead, indent: 0, at: 0, col: 0, pfx: true }, tabs);
  }
  if (lead < st.prefix_lead) {
    return (Head { kind: 0, p_indent: lead, indent: col - start, at: i, col: col, pfx: true }, tabs);
  }
  return (Head { kind: 2, p_indent: lead, indent: col - start, at: i, col: col, pfx: true }, tabs);
}

function scan_body(own s: State, line: u8[], at: i32, col0: i32): State {
  let st = s.st;
  let o = s.o;
  let p = s.p;
  let bytes = s.bytes;
  let uniform = st.uniform;
  let ws = s.words;
  s = State { ...s, words: s.spare };
  let lines = ws.lines;
  let nl = ws.nl;
  let pos = ws.pos;
  let meta = ws.meta;
  let gaps = ws.sp;
  let nw = ws.n;
  let tat = ws.at;
  let tbest = ws.best;
  let tlink = ws.link;
  let tdq = ws.dq;
  let tbr = ws.breaks;
  let tco = ws.costs;
  let li = -1;
  let i = at;
  let col = col0;
  let n = line.len();
  let prev_sentence = false;
  let first = true;
  if (nw > 0) {
    prev_sentence = (meta[nw - 1] & 2 as i64) != 0 as i64;
  }
  while (i < n) {
    let j = __scan_set_bytes(line, i, st.blank);
    let wcol = col;
    col += j - i;
    let lo = i;
    i = __scan_set_bytes(line, j, st.ink);
    let sp = i - j;
    if (sp > 1 || sp == 1 && line[j] as i32 == 9) {
      sp = 0;
      let b = j;
      while (b < i) {
        if (line[b] as i32 == 9) {
          sp += (col + sp) / tab_width() * tab_width() + tab_width() - (col + sp);
        } else {
          sp += 1;
        }
        b += 1;
      }
    }
    col += sp;
    let space = 1;
    if (first) {
      if (nw == 0) {
        space = 0;
      } else if (prev_sentence) {
        space = 2;
      }
    } else if (uniform) {
      if (prev_sentence) {
        space = 2;
      }
    } else {
      space = lo32(gaps[nw - 1]);
    }
    while (bytes + (j - lo) > buffer_bytes()) {
      if (nw == 0) {
        buf_push_bytes_range(o.w.handle(), line, lo, lo + buffer_bytes());
        lo += buffer_bytes();
      } else {
        let c: (Out, Para, Words) = chunk(o, p, Words { lines: lines, nl: nl, pos: pos, meta: meta, sp: gaps, n: nw, at: tat, best: tbest, link: tlink, dq: tdq, breaks: tbr, costs: tco, nb: 0 }, nw, st, wcol);
        o = c.0;
        p = c.1;
        let hw = c.2;
        tat = hw.at;
        tbest = hw.best;
        tlink = hw.link;
        tdq = hw.dq;
        tbr = hw.breaks;
        tco = hw.costs;
        lines = hw.lines;
        nl = hw.nl;
        pos = hw.pos;
        meta = hw.meta;
        gaps = hw.sp;
        nw = hw.n;
        if (li >= 0) {
          li = nl - 1;
        }
        bytes = held_bytes(pos, nw);
      }
    }
    if (li < 0) {
      li = nl;
      if (nl < lines.len()) {
        lines = lines.with(nl, line);
      } else {
        lines = lines.append(line);
      }
      nl += 1;
    }
    let f = word_flags(st.cls, line, lo, j, sp, i >= n);
    prev_sentence = (f & f_sentence()) != 0;
    first = false;
    let wp = lo as i64 << 32 as i64 | (j - lo) as i64;
    let wm = li as i64 << 8 as i64 | f as i64;
    let wg = space as i64 << 32 as i64 | sp as i64;
    if (nw < pos.len()) {
      pos = pos.with(nw, wp);
      meta = meta.with(nw, wm);
      gaps = gaps.with(nw, wg);
    } else {
      pos = pos.append(wp);
      meta = meta.append(wm);
      gaps = gaps.append(wg);
    }
    nw += 1;
    bytes += j - lo;
    if (nw > buffer_words()) {
      let c1: (Out, Para, Words) = chunk(o, p, Words { lines: lines, nl: nl, pos: pos, meta: meta, sp: gaps, n: nw, at: tat, best: tbest, link: tlink, dq: tdq, breaks: tbr, costs: tco, nb: 0 }, buffer_words(), st, col);
      o = c1.0;
      p = c1.1;
      let hw1 = c1.2;
      tat = hw1.at;
      tbest = hw1.best;
      tlink = hw1.link;
      tdq = hw1.dq;
      tbr = hw1.breaks;
      tco = hw1.costs;
      lines = hw1.lines;
      nl = hw1.nl;
      pos = hw1.pos;
      meta = hw1.meta;
      gaps = hw1.sp;
      nw = hw1.n;
      li = -1;
      if (nw > 0) {
        li = nl - 1;
      }
      bytes = held_bytes(pos, nw);
    }
  }
  return State { ...s, o: o, p: p, bytes: bytes, words: Words { lines: lines, nl: nl, pos: pos, meta: meta, sp: gaps, n: nw, at: tat, best: tbest, link: tlink, dq: tdq, breaks: tbr, costs: tco, nb: 0 } };
}

struct State { o: Out, p: Para, words: Words, spare: Words, bytes: i32, st: Settings, ok: boolean }

function feed(own s: State, line: u8[], term: boolean): State {
  let st = s.st;
  let r: (Head, boolean) = scan_head(line, st, s.o.tabs);
  let h = r.0;
  let o = Out { ...s.o, tabs: r.1 };
  if (h.kind == 0) {
    s = flush_para(State { ...s, o: o });
    let o0 = s.o;
    let h0 = o0.w.handle();
    let col = o0.col;
    push_spacing(h0, col, h.p_indent, o0.tabs);
    col += h.p_indent;
    if (h.pfx) {
      buf_push(h0, st.prefix_out);
      col += st.prefix_out.len();
      push_spacing(h0, col, h.indent, o0.tabs);
      col += h.indent;
    }
    buf_push_bytes_range(h0, line, h.at, line.len());
    if (term) {
      buf_push_byte(h0, 10);
    }
    return State { ...s, o: Out { ...o0, w: gnu.settle(o0.w), col: 0 }, bytes: 0 };
  }
  if (h.kind == 1) {
    s = flush_para(State { ...s, o: o });
    let o1 = s.o;
    if (!term && (st.prefix.len() > 0 || st.prefix_lead > 0) && !h.pfx) {
      return State { ...s, o: Out { ...o1, w: gnu.settle(o1.w), col: 0 }, bytes: 0 };
    }
    let h1 = o1.w.handle();
    if (h.pfx) {
      push_spacing(h1, o1.col, h.p_indent, o1.tabs);
      buf_push(h1, st.prefix_out);
    }
    buf_push_byte(h1, 10);
    return State { ...s, o: Out { ...o1, w: gnu.settle(o1.w), col: 0 }, bytes: 0 };
  }
  let p = s.p;
  let flush = st.split && p.open;
  if (!flush && p.open) {
    if (h.p_indent != p.p_indent) {
      flush = true;
    } else if (p.pending) {
      if (st.tagged && h.indent == p.first_indent) {
        flush = true;
      } else {
        p = Para { ...p, other_indent: h.indent, pending: false };
      }
    } else if (h.indent != p.other_indent) {
      flush = true;
    }
  }
  if (flush) {
    s = flush_para(State { ...s, o: o, p: p });
    o = s.o;
    p = s.p;
    s = State { ...s, bytes: 0 };
  }
  if (!p.open) {
    p = Para { ...p, first_indent: h.indent, other_indent: h.indent, p_indent: h.p_indent, pending: st.crown || st.tagged, open: true };
  }
  if (!o.tabs && __memchr_bytes(line, 9, h.at) >= 0) {
    o = Out { ...o, tabs: true };
  }
  s = State { ...s, o: o, p: p };
  return scan_body(s, line, h.at, h.col);
}

function width_of(text: string, max: i32, range: boolean): i32 {
  let i = 0;
  while (i < text.len() && (text[i] as i32 == 32 || text[i] as i32 >= 9 && text[i] as i32 <= 13)) {
    i += 1;
  }
  if (i < text.len() && text[i] as i32 == 43) {
    i += 1;
  }
  let digits = i;
  let value = 0 as i64;
  let over = false;
  while (i < text.len() && gnu.is_digit(text[i] as i32)) {
    if (value > 200000000 as i64) {
      over = true;
    } else {
      value = value * (10 as i64) + (text[i] as i32 - 48) as i64;
    }
    i += 1;
  }
  if (i == digits || i != text.len()) {
    gnu.error("invalid width: " + gnu.quote(text));
    exit(1);
  }
  if (over || value > max as i64) {
    let why = ": " + gnu.eoverflow_text();
    if (range) {
      why = ": " + gnu.erange_text();
    }
    gnu.error("invalid width: " + gnu.quote(text) + why);
    exit(1);
  }
  return value as i32;
}

function digit_of(id: i32): string {
  return slice_unchecked("0123456789", id - 10, id - 9) + "";
}

pub function main(): i32 {
  let argv = args();

  let obsolete = "";
  let have_obsolete = false;
  if (argv.len() > 1 && argv[1].len() >= 2 && argv[1][0] as i32 == 45 && gnu.is_digit(argv[1][1] as i32)) {
    obsolete = slice_unchecked(argv[1], 1, argv[1].len()) + "";
    have_obsolete = true;
    let rest: string[] = [argv[0]];
    let k = 2;
    while (k < argv.len()) {
      rest = rest.append(argv[k]);
      k += 1;
    }
    argv = rest;
  }

  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("c", "crown-margin", opt_crown()));
  opts = opts.append(gnu.valued("p", "prefix", opt_prefix()));
  opts = opts.append(gnu.flag("s", "split-only", opt_split()));
  opts = opts.append(gnu.flag("t", "tagged-paragraph", opt_tagged()));
  opts = opts.append(gnu.flag("u", "uniform-spacing", opt_uniform()));
  opts = opts.append(gnu.valued("w", "width", opt_width()));
  opts = opts.append(gnu.valued("g", "goal", opt_goal()));
  let d = 0;
  while (d < 10) {
    opts = opts.append(gnu.flag(slice_unchecked("0123456789", d, d + 1) + "", "", opt_digit(d)));
    d += 1;
  }

  let crown = false;
  let tagged = false;
  let split = false;
  let uniform = false;
  let prefix = "";
  let width = 75;
  let width_text = "";
  let have_width = false;
  let goal = 0;
  let goal_text = "";
  let have_goal = false;
  if (have_obsolete) {
    width_text = obsolete;
    have_width = true;
  }

  let g = gnu.getopt_new(argv, opts, "fmt", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == opt_crown()) {
          crown = true;
        } else if (m.id == opt_prefix()) {
          prefix = m.value;
        } else if (m.id == opt_split()) {
          split = true;
        } else if (m.id == opt_tagged()) {
          tagged = true;
        } else if (m.id == opt_uniform()) {
          uniform = true;
        } else if (m.id == opt_width()) {
          width_text = m.value;
          have_width = true;
        } else if (m.id == opt_goal()) {
          goal_text = m.value;
          have_goal = true;
        } else {
          gnu.die_usage("invalid option -- " + digit_of(m.id) + "; -WIDTH is recognized only when it is the first\noption; use -w N instead", 1);
        }
      },
      None => {
        break;
      }
    }
  }

  if (have_width) {
    width = width_of(width_text, max_width_limit(), true);
  }
  if (have_goal) {
    goal = width_of(goal_text, width, false);
    if (!have_width) {
      width = goal + 10;
    }
  } else {
    goal = width * 187 / 200;
  }

  let lead = 0;
  while (lead < prefix.len() && prefix[lead] as i32 == 32) {
    lead += 1;
  }
  let text = slice_unchecked(prefix, lead, prefix.len()) + "";
  let last = text.len();
  while (last > 0 && text[last - 1] as i32 == 32) {
    last -= 1;
  }
  let st = Settings { max_width: width, goal: goal, crown: crown && !split, tagged: tagged && !crown && !split, split: split, uniform: uniform, prefix: text, prefix_out: slice_unchecked(text, 0, last) + "", prefix_lead: lead, blank: byte_set(true), ink: byte_set(false), cls: byte_classes() };

  let files = g.operands();
  if (files.len() == 0) {
    files = files.append("-");
  }
  return run(files, st);
}

function copy_line(bytes: u8[], lo: i32, hi: i32): u8[] {
  let h = buf_new(hi - lo);
  buf_push_bytes_range(h, bytes, lo, hi);
  let line = buf_take_bytes(h);
  buf_free(h);
  return line;
}

function run(files: string[], st: Settings): i32 {
  let s = State { o: Out { w: gnu.out_with(block_size()), col: 0, tabs: false }, p: para_new(), words: words_new(), spare: words_new(), bytes: 0, st: st, ok: true };

  let used_stdin = false;
  let fi = 0;
  while (fi < files.len()) {
    let name = files[fi];
    fi += 1;
    let is_stdin = name == "-";
    let r = stdin();
    let opened = true;
    if (is_stdin) {
      used_stdin = true;
    }
    if (!is_stdin) {
      match (open_reader(name)) {
        Ok(f) => {
          r = f;
        },
        Err(e) => {
          s = State { ...s, o: report(s.o, "cannot open " + gnu.quote(name) + " for reading: " + gnu.io_error_text(e)), ok: false };
          opened = false;
        }
      }
    }
    if (opened) {
      let carry = buf_new(read_size());
      let carry_len = 0;
      while (true) {
        let piece: u8[] = [];
        let more = true;
        match (r.read_chunk_bytes(read_size())) {
          Ok(c) => {
            piece = c;
          },
          Err(e) => {
            let why = "read error: " + gnu.io_error_text(e);
            if (!is_stdin) {
              why = "error reading " + gnu.quotea(name) + ": " + gnu.io_error_text(e);
            }
            s = State { ...s, o: report(s.o, why), ok: false };
            more = false;
          }
        }
        if (!more || piece.len() == 0) {
          break;
        }
        let i = 0;
        while (i < piece.len()) {
          let j = __memchr_bytes(piece, 10, i);
          if (j < 0) {
            buf_push_bytes_range(carry, piece, i, piece.len());
            carry_len = carry_len + piece.len() - i;
            break;
          }
          if (carry_len > 0) {
            buf_push_bytes_range(carry, piece, i, j);
            s = feed(s, buf_take_bytes(carry), true);
            carry_len = 0;
          } else {
            s = feed(s, copy_line(piece, i, j), true);
          }
          i = j + 1;
        }
      }
      if (carry_len > 0) {
        s = feed(s, buf_take_bytes(carry), false);
      }
      buf_free(carry);
      if (!is_stdin) {
        r.close();
      }
      s = flush_para(s);
      s = State { ...s, bytes: 0 };
    }
  }

  if (used_stdin) {
    if let Err(e) = stdin().close() {
      s = State { ...s, o: report(s.o, "closing standard input: " + gnu.io_error_text(e)), ok: false };
    }
  }

  finish_out(s.o);
  if (!s.ok) {
    return 1;
  }
  return 0;
}

function report(o: Out, msg: string): Out {
  return Out { ...o, w: gnu.error_out(o.w, msg) };
}
