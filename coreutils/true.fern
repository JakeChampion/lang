import "std/string";
import "./lib/gnu";

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [ARGUMENT]...\n";
  out = out + "  or:  " + gnu.prog() + " OPTION\n";
  out += "Do nothing, successfully. Arguments are ignored.\n";
  out += "\n";
  out += "      --help     display this help and exit\n";
  out += "      --version  output version information and exit\n";
  return out;
}

pub function main(): i32 {
  gnu.sole_help_version(args(), "true", help_text(), 0);
  return 0;
}
