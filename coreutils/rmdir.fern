// rmdir.fern — GNU-compatible `rmdir`.
//
//   DIRECTORY...                 remove each empty DIRECTORY
//   --ignore-fail-on-non-empty   a directory that is not empty is not a failure
//   -p, --parents                remove each ancestor of DIRECTORY too
//   -v, --verbose                one line per attempted removal
//
// rmdir(2) and nothing else: a directory with anything in it is
// `Directory not empty` and a regular file is `Not a directory`, both of
// which `rm -r` would hide. The options are declared in GNU's order because
// the ambiguity list prints candidates in it — `--v` lists '--verbose'
// before '--version'.
//
// `-v` goes to STDOUT (gnulib's prog_fprintf, not error), one line before
// each attempt, whether or not the attempt then succeeds. So a failure
// reported on stderr has to flush the pending output first, which is what
// `error_out` is.
//
// `-p` walks the operand's ancestors by TRUNCATING its text: trailing
// slashes come off once, then each round cuts at the last slash and steps
// back over a run of them, so `dd//ss` reaches `dd` and `./d1/d2` reaches
// `.` (and reports EINVAL there). The walk stops at the first failure —
// there is no point asking about a parent whose child is still in place —
// and an ancestor's diagnostic says `failed to remove directory` where the
// operand's says `failed to remove`.
import "std/string";
import "std/array";
import "std/io_buffered";
import "./lib/gnu";

function help_text(): string {
  var out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... DIRECTORY...\n";
  out = out + "Remove the DIRECTORY(ies), if they are empty.\n";
  out = out + "\n";
  out = out + "      --ignore-fail-on-non-empty\n";
  out = out + "                  ignore each failure to remove a non-empty directory\n";
  out = out + "  -p, --parents   remove DIRECTORY and its ancestors\n";
  out = out + "  -v, --verbose   output a diagnostic for every directory processed\n";
  out = out + "      --help      display this help and exit\n";
  out = out + "      --version   output version information and exit\n";
  return out;
}

// `State` — what the whole run carries: the buffered stdout `-v` writes to,
// the three flags, and the exit status.
struct State { o: io_buffered.BufWriter, parents: boolean, verbose: boolean, ignore: boolean, status: i32 }

// One `-v` line, on stdout, before the attempt it describes.
function announce(s: State, dir: string): State {
  if (!s.verbose) {
    return s;
  }
  return State { ...s, o: gnu.put(s.o, gnu.prog() + ": removing directory, " + gnu.quotea(dir) + "\n") };
}

// One failure line, with the pending `-v` output flushed ahead of it so the
// two do not overtake each other down a shared pipe.
function fail(s: State, msg: string): State {
  return State { ...s, o: gnu.error_out(s.o, msg), status: 1 };
}

// Whether `--ignore-fail-on-non-empty` swallows this failure.
//
// ENOTEMPTY and EEXIST say "not empty" outright. The rest of GNU's list —
// EACCES, EPERM, EROFS, EBUSY, EXDEV — say only that the removal was
// refused for a reason that COULD be the directory's contents, so the
// directory is read and the failure is ignored only when it turns out not
// to be empty after all.
function ignorable(e: IoError, dir: string): boolean {
  var text: string = gnu.io_error_text(e);
  if (text == "Directory not empty" || text == "File exists") {
    return true;
  }
  if (text != "Permission denied" && text != "Operation not permitted"
      && text != "Read-only file system" && text != "Device or resource busy"
      && text != "Invalid cross-device link") {
    return false;
  }
  match (read_dir(dir)) {
    Ok(entries) => {
      return entries.len() > 0;
    },
    Err(_) => {
      return false;
    }
  }
}

// The ancestor walk. `dir` is the operand with its trailing slashes gone;
// each round cuts at the last slash, stepping back over a run of them, and
// the walk ends at a component with no slash left in it.
function remove_parents(s: State, operand: string): State {
  var dir: string = strip_trailing_slashes(operand);
  var st: State = s;
  while (true) {
    var cut: i32 = last_slash(dir);
    if (cut < 0) {
      return st;
    }
    dir = slice_unchecked(dir, 0, cut + 1) + "";
    st = announce(st, dir);
    match (remove_dir(dir)) {
      Ok(_) => {},
      Err(e) => {
        if (!(st.ignore && ignorable(e, dir))) {
          st = fail(st, "failed to remove directory " + gnu.quotea(dir) + ": " + gnu.io_error_text(e));
        }
        return st;
      }
    }
  }
  return st;
}

// The index one PAST the prefix to keep: the last slash, walked back over a
// run of them, so `dd//ss` keeps `dd` and `/a` keeps `/`. Negative when
// there is no slash left to cut at.
function last_slash(dir: string): i32 {
  var i: i32 = dir.len() - 1;
  while (i >= 0 && dir[i] as i32 != 47) {
    i = i - 1;
  }
  if (i < 0) {
    return 0 - 1;
  }
  while (i > 0 && dir[i] as i32 == 47) {
    i = i - 1;
  }
  return i;
}

function strip_trailing_slashes(s: string): string {
  var end: i32 = s.len();
  while (end > 1 && s[end - 1] as i32 == 47) {
    end = end - 1;
  }
  return slice_unchecked(s, 0, end) + "";
}

function main(): i32 {
  var opts: gnu.Opt[] = [
    gnu.flag("", "ignore-fail-on-non-empty", 1),
    // `--path` is GNU's undocumented synonym for `--parents`, declared
    // ahead of it and absent from its help. It is visible anyway: the
    // ambiguity list prints it, and `--pa` resolves rather than faulting
    // because glibc calls two candidates that carry the SAME value
    // unambiguous — which is why this shares `--parents`' id.
    gnu.flag("", "path", 2),
    gnu.flag("p", "parents", 2),
    gnu.flag("v", "verbose", 3)
  ];
  var g: gnu.Getopt = gnu.getopt_new(args(), opts, "rmdir", help_text(), 1);
  var s: State = State { o: gnu.out_new(), parents: false, verbose: false, ignore: false, status: 0 };
  while (true) {
    var r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        if (m.id == 1) {
          s = State { ...s, ignore: true };
        } else if (m.id == 2) {
          s = State { ...s, parents: true };
        } else {
          s = State { ...s, verbose: true };
        }
      },
      None => {
        break;
      }
    }
  }
  var operands: string[] = g.operands();
  if (operands.len() == 0) {
    gnu.die_usage("missing operand", 1);
  }
  var i: i32 = 0;
  while (i < operands.len()) {
    var dir: string = operands[i];
    s = announce(s, dir);
    match (remove_dir(dir)) {
      Ok(_) => {
        if (s.parents) {
          s = remove_parents(s, dir);
        }
      },
      Err(e) => {
        if (!(s.ignore && ignorable(e, dir))) {
          s = fail(s, "failed to remove " + gnu.quotea(dir) + ": " + gnu.io_error_text(e));
        }
      }
    }
    i = i + 1;
  }
  gnu.finish(s.o);
  return s.status;
}
