import "std/array";
import "std/string";
import "std/io_buffered";
import "std/time";
import "./lib/gnu";
import "./lib/timefmt";
import "std/tz";

function opt_pages(): i32 {
  return 1;
}

function opt_columns(): i32 {
  return 2;
}

function opt_across(): i32 {
  return 3;
}

function opt_ctrl(): i32 {
  return 4;
}

function opt_double(): i32 {
  return 5;
}

function opt_date(): i32 {
  return 6;
}

function opt_expand(): i32 {
  return 7;
}

function opt_formfeed(): i32 {
  return 8;
}

function opt_header(): i32 {
  return 9;
}

function opt_outtabs(): i32 {
  return 10;
}

function opt_join(): i32 {
  return 11;
}

function opt_length(): i32 {
  return 12;
}

function opt_merge(): i32 {
  return 13;
}

function opt_number(): i32 {
  return 14;
}

function opt_firstline(): i32 {
  return 15;
}

function opt_indent(): i32 {
  return 16;
}

function opt_nowarn(): i32 {
  return 17;
}

function opt_sep(): i32 {
  return 18;
}

function opt_sepstring(): i32 {
  return 19;
}

function opt_omithdr(): i32 {
  return 20;
}

function opt_omitpage(): i32 {
  return 21;
}

function opt_nonprint(): i32 {
  return 22;
}

function opt_width(): i32 {
  return 23;
}

function opt_pagewidth(): i32 {
  return 24;
}

function opt_balance(): i32 {
  return 25;
}

function opt_digit(d: i32): i32 {
  return 30 + d;
}

function help_text(): string {
  let out = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... [FILE]...\n";
  out += "Paginate or columnate FILE(s) for printing.\n";
  out += "\n";
  out += "With no FILE, or when FILE is -, read standard input.\n";
  out += "\n";
  out += "  +FIRST_PAGE[:LAST_PAGE], --pages=FIRST_PAGE[:LAST_PAGE]\n";
  out += "                    begin [stop] printing with page FIRST_[LAST_]PAGE\n";
  out += "  -COLUMN, --columns=COLUMN\n";
  out += "                    output COLUMN columns and print columns down,\n";
  out += "                    unless -a is used\n";
  out += "  -a, --across      print columns across rather than down\n";
  out += "  -c, --show-control-chars\n";
  out += "                    use hat notation (^G) and octal backslash notation\n";
  out += "  -d, --double-space\n";
  out += "                    double space the output\n";
  out += "  -D, --date-format=FORMAT\n";
  out += "                    use FORMAT for the header date\n";
  out += "  -e[CHAR[WIDTH]], --expand-tabs[=CHAR[WIDTH]]\n";
  out += "                    expand input CHARs (TABs) to tab WIDTH (8)\n";
  out += "  -F, -f, --form-feed\n";
  out += "                    use form feeds instead of newlines to separate pages\n";
  out += "  -h, --header=HEADER\n";
  out += "                    use a centered HEADER instead of filename\n";
  out += "  -i[CHAR[WIDTH]], --output-tabs[=CHAR[WIDTH]]\n";
  out += "                    replace spaces with CHARs (TABs) to tab WIDTH (8)\n";
  out += "  -J, --join-lines  merge full lines, turns off -W line truncation\n";
  out += "  -l, --length=PAGE_LENGTH\n";
  out += "                    set the page length to PAGE_LENGTH (66) lines\n";
  out += "  -m, --merge       print all files in parallel, one in each column\n";
  out += "  -n[SEP[DIGITS]], --number-lines[=SEP[DIGITS]]\n";
  out += "                    number lines, use DIGITS (5) digits, then SEP (TAB)\n";
  out += "  -N, --first-line-number=NUMBER\n";
  out += "                    start counting with NUMBER at 1st line printed\n";
  out += "  -o, --indent=MARGIN\n";
  out += "                    offset each line with MARGIN (zero) spaces\n";
  out += "  -r, --no-file-warnings\n";
  out += "                    omit warning when a file cannot be opened\n";
  out += "  -s[CHAR], --separator[=CHAR]\n";
  out += "                    separate columns by a single character\n";
  out += "  -S[STRING], --sep-string[=STRING]\n";
  out += "                    separate columns by STRING\n";
  out += "  -t, --omit-header  omit page headers and trailers\n";
  out += "  -T, --omit-pagination\n";
  out += "                    omit page headers and trailers, eliminate any\n";
  out += "                    pagination by form feeds set in input files\n";
  out += "  -v, --show-nonprinting\n";
  out += "                    use octal backslash notation\n";
  out += "  -w, --width=PAGE_WIDTH\n";
  out += "                    set page width to PAGE_WIDTH (72) characters for\n";
  out += "                    multiple text-column output only\n";
  out += "  -W, --page-width=PAGE_WIDTH\n";
  out += "                    set page width to PAGE_WIDTH (72) characters always,\n";
  out += "                    truncate lines\n";
  out += "      --help        display this help and exit\n";
  out += "      --version     output version information and exit\n";
  return out;
}

struct Cfg { columns: i32, across: boolean, merge: boolean, ctrl: boolean, nonprint: boolean, double_space: boolean, date_fmt: timefmt.Format, untabify: boolean, in_tab: i32, in_tab_width: i32, tabify: boolean, out_tab: i32, out_tab_width: i32, form_feed: boolean, header: string, has_header: boolean, page_length: i32, numbering: boolean, num_sep: i32, num_digits: i32, num_width: i32, first_line: i32, has_first_line: boolean, offset: i32, nowarn: boolean, sep: string, omit_header: boolean, omit_pagination: boolean, page_width: i32, zone: tz.Zone, truncate: boolean, tab_literal: boolean, num_prefix: i32, first_page: u64, last_page: u64, chars_per_column: i32 }

function tab_stop(): i32 {
  return 8;
}

function is_print(b: i32): boolean {
  return b >= 32 && b < 127;
}

function clump_width(b: i32, c: Cfg): i32 {
  if (is_print(b)) {
    return 1;
  }
  if (c.nonprint) {
    return 4;
  }
  if (c.ctrl) {
    if (b < 32 || b == 127) {
      return 2;
    }
    return 4;
  }
  if (b == 8) {
    return -1;
  }
  return 0;
}

struct Line { buf: usize, pos: i32, pend: i32 }

function line_on(h: usize): Line {
  return Line { buf: h, pos: 0, pend: 0 };
}

function append_bytes(h: usize, bytes: u8[]): void {
  buf_push_bytes_range(h, bytes, 0, bytes.len());
}

function take_bytes(h: usize): u8[] {
  let bytes = buf_take_bytes(h);
  buf_free(h);
  return bytes;
}

function (l: Line) ws(n: i32, c: Cfg): Line {
  if (n <= 0) {
    return l;
  }
  if (c.tabify) {
    return Line { ...l, pos: l.pos + n, pend: l.pend + n };
  }
  push_spaces(l.buf, n);
  return Line { ...l, pos: l.pos + n };
}

function push_spaces(h: usize, n: i32): void {
  let left = n;
  while (left > 0) {
    let k = left;
    if (k > 64) {
      k = 64;
    }
    buf_push_range(h, "                                                                ", 0, k);
    left -= k;
  }
}

function (l: Line) to(target: i32, c: Cfg): Line {
  return l.ws(target - l.pos, c);
}

function (l: Line) flush(c: Cfg): Line {
  if (l.pend <= 0) {
    return l;
  }
  let p = l.pos - l.pend;
  let rem = l.pend;
  let tw = c.out_tab_width;
  let stop = false;
  while (rem > 1 && p >= 0 && !stop) {
    let h = tw - p % tw;
    if (rem < h) {
      stop = true;
    } else {
      buf_push_byte(l.buf, c.out_tab);
      p += h;
      rem -= h;
    }
  }
  push_spaces(l.buf, rem);
  return Line { ...l, pend: 0 };
}

function (l: Line) put(s: string, width: i32, c: Cfg): Line {
  let f = l.flush(c);
  buf_push(f.buf, s);
  return Line { ...f, pos: f.pos + width };
}

function (l: Line) put_byte(b: i32, width: i32, c: Cfg): Line {
  let f = l.flush(c);
  buf_push_byte(f.buf, b);
  return Line { ...f, pos: f.pos + width };
}

function (l: Line) put_range(bytes: u8[], from: i32, to: i32, width: i32, c: Cfg): Line {
  let f = l.flush(c);
  buf_push_bytes_range(f.buf, bytes, from, to);
  return Line { ...f, pos: f.pos + width };
}

function (l: Line) put_clump(b: i32, c: Cfg): Line {
  let f = l.flush(c);
  if (is_print(b) || !c.nonprint && !c.ctrl) {
    buf_push_byte(f.buf, b);
  } else if (!c.nonprint && c.ctrl && (b < 32 || b == 127)) {
    buf_push_byte(f.buf, 94);
    buf_push_byte(f.buf, b ^ 64);
  } else {
    buf_push_byte(f.buf, 92);
    buf_push_byte(f.buf, 48 + b / 64 % 8);
    buf_push_byte(f.buf, 48 + b / 8 % 8);
    buf_push_byte(f.buf, 48 + b % 8);
  }
  return Line { ...f, pos: f.pos + clump_width(b, c) };
}

function (l: Line) space(c: Cfg): Line {
  if (c.tabify) {
    return Line { ...l, pos: l.pos + 1, pend: l.pend + 1 };
  }
  buf_push_byte(l.buf, 32);
  return Line { ...l, pos: l.pos + 1 };
}

struct Src { r: Reader, name: string, is_stdin: boolean, open: boolean, buf: u8[], pos: i32, eof: boolean, fatal: boolean, nlat: i32, ffat: i32, mtime: i64, mnsec: i64 }

function read_size(): i32 {
  return 65536;
}

function src_closed(): Src {
  return Src { r: stdin(), name: "", is_stdin: false, open: false, buf: [], pos: 0, eof: true, fatal: false, nlat: 0 - 1, ffat: 0 - 1, mtime: 0 as i64, mnsec: 0 as i64 };
}

function src_release(own s: Src): void {
  if (!s.is_stdin && s.open) {
    s.r.close();
  }
}

function src_fill(s: Src): Src {
  match (s.r.read_chunk_bytes(read_size())) {
    Ok(chunk) => {
      return Src { ...s, buf: chunk, pos: 0, eof: chunk.len() == 0, nlat: __memchr_bytes(chunk, 10, 0), ffat: __memchr_bytes(chunk, 12, 0) };
    },
    Err(e) => {
      let message = gnu.io_error_text(e);
      match (s.r.stat()) {
        Ok(st) => {
          if (st.is_dir) {
            message = "Is a directory";
          }
        },
        Err(_) => {}
      }
      gnu.error(gnu.quotef(s.name) + ": " + message);
      return Src { ...s, buf: [], pos: 0, eof: true, fatal: true, nlat: 0 - 1, ffat: 0 - 1 };
    }
  }
}

function finish_record(carry: usize, chunk: u8[], from: i32, to: i32): u8[] {
  if (carry == 0 as usize && from == to) {
    return [];
  }
  let h = carry;
  if (h == 0 as usize) {
    h = buf_new(to - from);
  }
  buf_push_bytes_range(h, chunk, from, to);
  return take_bytes(h);
}

struct Record { src: Src, line: boolean, ff: boolean, text: u8[] }

function src_line(s0: Src): Record {
  let s = s0;
  let carry = 0 as usize;
  while (true) {
    if (s.pos >= s.buf.len()) {
      if (s.eof) {
        if (carry != 0 as usize) {
          return Record { src: s, line: true, ff: false, text: take_bytes(carry) };
        }
        return Record { src: s, line: false, ff: false, text: [] };
      }
      s = src_fill(s);
      continue;
    }
    if (s.nlat >= 0 && s.nlat < s.pos) {
      s = Src { ...s, nlat: __memchr_bytes(s.buf, 10, s.pos) };
    }
    if (s.ffat >= 0 && s.ffat < s.pos) {
      s = Src { ...s, ffat: __memchr_bytes(s.buf, 12, s.pos) };
    }
    let end = s.nlat;
    let is_ff = false;
    if (s.ffat >= 0 && (end < 0 || s.ffat < end)) {
      end = s.ffat;
      is_ff = true;
    }
    if (end < 0) {
      if (carry == 0 as usize) {
        carry = buf_new(s.buf.len() - s.pos);
      }
      buf_push_bytes_range(carry, s.buf, s.pos, s.buf.len());
      s = Src { ...s, pos: s.buf.len() };
      continue;
    }
    let text = finish_record(carry, s.buf, s.pos, end);
    s = Src { ...s, pos: end + 1 };
    if (is_ff) {
      if (s.pos >= s.buf.len() && !s.eof) {
        s = src_fill(s);
      }
      if (s.pos < s.buf.len() && s.buf[s.pos] as i32 == 10) {
        s = Src { ...s, pos: s.pos + 1 };
      }
    }
    return Record { src: s, line: !is_ff || text.len() > 0, ff: is_ff, text: text };
  }
  return Record { src: s, line: false, ff: false, text: [] };
}

function parse_int(s: string): (i64, boolean) {
  let i = 0;
  while (i < s.len() && gnu.is_blank(s[i] as i32)) {
    i += 1;
  }
  let neg = false;
  if (i < s.len() && (s[i] as i32 == 43 || s[i] as i32 == 45)) {
    neg = s[i] as i32 == 45;
    i += 1;
  }
  let start = i;
  let v = 0 as i64;
  let sat = false;
  while (i < s.len() && gnu.is_digit(s[i] as i32)) {
    if (v > 900000000000000000 as i64) {
      sat = true;
    } else {
      v = v * (10 as i64) + (s[i] as i32 - 48) as i64;
    }
    i += 1;
  }
  if (i == start || i < s.len()) {
    return (0 as i64, false);
  }
  if (sat) {
    v = 4000000000 as i64;
  }
  if (neg) {
    v = 0 as i64 - v;
  }
  return (v, true);
}

function num_fault(v: i64, ok: boolean, min: i64): i32 {
  if (!ok) {
    return 1;
  }
  if (v >= min && v <= 2147483647 as i64) {
    return 0;
  }
  if (v < min && min > 0 as i64) {
    return 2;
  }
  return 3;
}

function num_text(status: i32): string {
  if (status == 2) {
    return ": " + gnu.erange_text();
  }
  if (status == 3) {
    return ": " + gnu.eoverflow_text();
  }
  return "";
}

function getnum(value: string, stem: string, min: i64): i32 {
  let r: (i64, boolean) = parse_int(value);
  let st = num_fault(r.0, r.1, min);
  if (st != 0) {
    gnu.error(stem + ": " + gnu.quote(value) + num_text(st));
    exit(1);
  }
  return r.0 as i32;
}

function char_width(value: string, letter: string, defchar: i32, defwidth: i32): (i32, i32) {
  let ch = defchar;
  let rest = value;
  if (value.len() > 0 && !gnu.is_digit(value[0] as i32)) {
    ch = value[0] as i32;
    rest = slice_unchecked(value, 1, value.len()) + "";
  }
  if (rest.len() == 0) {
    return (ch, defwidth);
  }
  let r: (i64, boolean) = parse_int(rest);
  let bad = !r.1 || r.0 < 1 as i64 || r.0 > 2147483647 as i64;
  let i = 0;
  while (i < rest.len()) {
    if (!gnu.is_digit(rest[i] as i32)) {
      bad = true;
    }
    i += 1;
  }
  if (bad) {
    gnu.die_usage("'-" + letter + "' extra characters or invalid number in the argument: " + gnu.quote(rest), 1);
  }
  return (ch, r.0 as i32);
}

function parse_range(arg: string, what: string): (u64, u64, i32) {
  let head = arg;
  let tail = "";
  let ranged = false;
  if let Some(colon) = arg.index_of(":") {
    head = slice_unchecked(arg, 0, colon) + "";
    tail = slice_unchecked(arg, colon + 1, arg.len()) + "";
    ranged = true;
  }
  let f: (u64, i32) = gnu.parse_number(head);
  if (gnu.count_overflow(f.1)) {
    gnu.error(what + " argument " + gnu.quote(arg) + " too large");
    exit(1);
  }
  if (f.1 == 1 || head.len() > 0 && head[0] as i32 == 45) {
    gnu.error("invalid " + what + " argument " + gnu.quote(arg));
    exit(1);
  }
  let last = 18446744073709551615 as u64;
  if (!ranged) {
    if (f.1 != 0) {
      return (0 as u64, 0 as u64, 1);
    }
  } else {
    if (f.1 != 0) {
      return (0 as u64, 0 as u64, 1);
    }
    let l: (u64, i32) = gnu.parse_number(tail);
    if (gnu.count_overflow(l.1)) {
      gnu.error(what + " argument " + gnu.quote(arg) + " too large");
      exit(1);
    }
    if (l.1 == 1 || tail.len() > 0 && tail[0] as i32 == 45) {
      gnu.error("invalid " + what + " argument " + gnu.quote(arg));
      exit(1);
    }
    if (l.1 != 0) {
      gnu.error("invalid suffix in " + what + " argument " + gnu.quote(arg));
      exit(1);
    }
    last = l.0;
  }
  if (f.0 == 0 as u64 || last < f.0) {
    return (0 as u64, 0 as u64, 1);
  }
  return (f.0, last, 0);
}

function header_width(s: [u8]): i32 {
  let w = 0;
  let i = 0;
  while (i < s.len()) {
    let b = s[i] as i32;
    if (b >= 32 && b != 127) {
      w += 1;
    }
    i += 1;
  }
  return w;
}

function header_date_format(has_date: boolean, fmt: string): timefmt.Format {
  if (has_date) {
    return timefmt.compile(fmt);
  }
  return timefmt.compile("%Y-%m-%d %H:%M");
}

function header_text(c: Cfg, name: string, t: i64, nsec: i64, page: u64): u8[] {
  let date = timefmt.format_bytes(c.date_fmt, c.zone, t, nsec);
  let nm = name;
  if (c.has_header) {
    nm = c.header;
  }
  let tail = "Page " + page.to_string();
  let avail = c.page_width - header_width(date) - header_width(nm.as_bytes()) - tail.len();
  let lhs = avail / 2;
  let rhs = avail - avail / 2;
  if (lhs < 1) {
    lhs = 1;
  }
  if (rhs < 1) {
    rhs = 1;
  }
  let h = buf_new(date.len() + nm.len() + tail.len() + lhs + rhs);
  append_bytes(h, date);
  push_spaces(h, lhs);
  buf_push(h, nm);
  push_spaces(h, rhs);
  buf_push(h, tail);
  return take_bytes(h);
}

function col_start(c: Cfg, i: i32): i32 {
  return c.offset + c.num_prefix + i * (c.chars_per_column + c.sep.len());
}

function put_sep(l0: Line, c: Cfg): Line {
  let l = l0;
  let k = 0;
  while (k < c.sep.len()) {
    let b = c.sep[k] as i32;
    if (b == 32 || b == 9 && c.truncate && c.sep.len() == 1) {
      l = l.space(c);
    } else {
      l = l.put_byte(b, 1, c);
    }
    k += 1;
  }
  return l;
}

function tab_span(b: i32, c: Cfg): i32 {
  if (b == c.in_tab) {
    return c.in_tab_width;
  }
  if (b == 9) {
    return tab_stop();
  }
  return 0;
}

function put_tab(l0: Line, c: Cfg, cs: i32, span: i32, b: i32): (Line, i32) {
  let local = l0.pos - cs;
  if (local < 0) {
    local = 0;
  }
  let target = l0.pos + (span - local % span);
  let l = l0;
  if (c.untabify) {
    let n = target - l.pos;
    while (n > 0) {
      l = l.space(c);
      n -= 1;
    }
    return (l, target);
  }
  if (c.columns > 1 && !c.tab_literal) {
    return (l.to(target, c), target);
  }
  let f = l.flush(c);
  buf_push_byte(f.buf, b);
  return (Line { ...f, pos: target }, target);
}

function put_number(l0: Line, c: Cfg, cs: i32, n: i64, separator: boolean): Line {
  let l = l0;
  let d = c.num_digits;
  if (n >= 0 as i64 && d >= 1 && d <= 18) {
    let v = n as u64;
    let len = gnu.decimal_len(v);
    let zeros = 0;
    if (len > d) {
      let p = 1 as u64;
      let k = 0;
      while (k < d) {
        p *= 10 as u64;
        k += 1;
      }
      v %= p;
      zeros = d - gnu.decimal_len(v);
      len = d;
    }
    let f = l.to(cs + d - len, c).flush(c);
    while (zeros > 0) {
      buf_push_byte(f.buf, 48);
      zeros -= 1;
    }
    buf_push_decimal(f.buf, v);
    l = Line { ...f, pos: f.pos + len };
  } else {
    let s = n.to_string();
    if (s.len() > c.num_digits) {
      s = slice_unchecked(s, s.len() - c.num_digits, s.len()) + "";
    }
    l = l.to(cs + c.num_digits - s.len(), c);
    l = l.put(s, s.len(), c);
  }
  if (!separator) {
    return l;
  }
  if (c.num_sep == 9) {
    let target = cs + c.num_width;
    if (c.columns > 1 && !c.tab_literal) {
      return l.to(target, c);
    }
    let f = l.flush(c);
    buf_push_byte(f.buf, 9);
    return Line { ...f, pos: target };
  }
  l = l.put_clump(c.num_sep, c);
  return l;
}

function put_column(l0: Line, c: Cfg, i: i32, txt: u8[], n: i64, numbered: boolean): Line {
  let cs = col_start(c, i);
  let l = l0;
  if (i == 0) {
    l = l.to(cs, c);
  } else if (c.truncate) {
    if (l.pos <= cs - c.sep.len()) {
      l = l.to(cs - c.sep.len(), c);
      l = put_sep(l, c);
    }
  } else {
    l = put_sep(l, c);
  }
  l = l.flush(c);
  let origin = l.pos;
  if (c.truncate) {
    origin = cs;
  }
  let text_start = origin;
  if (numbered) {
    l = put_number(l, c, origin, n, true);
    text_start = l.pos;
  }
  let limit = 0;
  if (c.truncate) {
    let avail = c.chars_per_column;
    if (numbered) {
      avail -= c.num_width;
      if (avail < 1) {
        avail = 1;
      }
    }
    limit = text_start + avail;
  }
  let k = 0;
  while (k < txt.len()) {
    let j = k;
    while (j < txt.len()) {
      let pb = txt[j] as i32;
      if (pb < 33 || pb > 126 || pb == c.in_tab) {
        break;
      }
      j += 1;
    }
    if (j > k) {
      let width = j - k;
      if (c.truncate && l.pos + width > limit) {
        width = limit - l.pos;
        if (width <= 0) {
          return l;
        }
        j = k + width;
      }
      l = l.put_range(txt, k, j, width, c);
      k = j;
      continue;
    }
    let b = txt[k] as i32;
    let span = tab_span(b, c);
    if (span > 0) {
      let local = l.pos - origin;
      if (local < 0) {
        local = 0;
      }
      let target = l.pos + (span - local % span);
      if (c.truncate && target > limit) {
        return l;
      }
      let r: (Line, i32) = put_tab(l, c, origin, span, b);
      l = r.0;
      k += 1;
      continue;
    }
    let width = clump_width(b, c);
    let start = text_start;
    if (numbered && c.truncate && !c.merge) {
      start = origin;
    }
    if (width < 0 && (l.pos <= start || k == 0)) {
      k += 1;
      continue;
    }
    if (c.truncate && l.pos + width > limit) {
      return l;
    }
    if (b == 32) {
      l = l.space(c);
    } else {
      l = l.put_clump(b, c);
    }
    k += 1;
  }
  return l;
}

function row_into(out: usize, c: Cfg, texts: u8[][], nums: i64[], numbered: boolean): void {
  let l = line_on(out);
  if (c.num_prefix > 0 && nums.len() > 0) {
    l = l.to(c.offset, c);
    l = put_number(l, c, c.offset, nums[0], true);
  }
  let i = 0;
  while (i < texts.len()) {
    let num = 0 as i64;
    if (i < nums.len()) {
      num = nums[i];
    }
    let want = numbered && c.num_prefix == 0;
    l = put_column(l, c, i, texts[i], num, want);
    i += 1;
  }
  buf_push_byte(out, 10);
}

function wrap32(n: i64): i64 {
  let v = n;
  while (v > 2147483647 as i64) {
    v = v - 4294967296 as i64;
  }
  while (v < 0 as i64 - 2147483648 as i64) {
    v = v + 4294967296 as i64;
  }
  return v;
}

function column_lengths(n: i32, c: Cfg): i32[] {
  let out: i32[] = [];
  let k = c.columns;
  let rows = (n + k - 1) / k;
  let full = n % k;
  let i = 0;
  while (i < k) {
    let len = rows;
    if (full > 0 && i >= full) {
      len = rows - 1;
    }
    if (len < 0) {
      len = 0;
    }
    out = out.append(len);
    i += 1;
  }
  return out;
}

function printable_ascii(bytes: u8[]): boolean {
  let i = 0;
  while (i < bytes.len()) {
    if (bytes[i] < 32 as u8 || bytes[i] > 126 as u8) {
      return false;
    }
    i += 1;
  }
  return true;
}

function body_into(out: usize, c: Cfg, lines: u8[][], first_no: i64, last_terminated: boolean): i32 {
  let count = 0;
  let n = lines.len();
  if (c.columns == 1 && !c.merge) {
    let direct = !c.numbering && c.offset == 0 && !c.truncate && !c.untabify && !c.tabify;
    let verbatim = direct && !c.ctrl && !c.nonprint;
    let displayed = direct && (c.ctrl || c.nonprint);
    let i = 0;
    while (i < n) {
      if (verbatim && __memchr_bytes(lines[i], 8, 0) < 0 || displayed && printable_ascii(lines[i])) {
        append_bytes(out, lines[i]);
        buf_push_byte(out, 10);
      } else {
        put_column(line_on(out), c, 0, lines[i], wrap32(first_no + i as i64), c.numbering);
        buf_push_byte(out, 10);
      }
      count += 1;
      if (c.double_space && (i + 1 < n || last_terminated || !c.omit_header)) {
        buf_push_byte(out, 10);
        count += 1;
      }
      i += 1;
    }
    return count;
  }
  let rows = (n + c.columns - 1) / c.columns;
  let lens = column_lengths(n, c);
  let starts: i32[] = [];
  let acc = 0;
  let j = 0;
  while (j < c.columns) {
    starts = starts.append(acc);
    acc += lens[j];
    j += 1;
  }
  let r = 0;
  while (r < rows) {
    let texts: u8[][] = [];
    let nums: i64[] = [];
    let col = 0;
    while (col < c.columns) {
      let idx: i32 = -1;
      if (c.across) {
        idx = r * c.columns + col;
        if (idx >= n) {
          idx = -1;
        }
      } else if (r < lens[col]) {
        idx = starts[col] + r;
      }
      if (idx < 0) {
        col = c.columns;
      } else {
        texts = texts.append(lines[idx]);
        nums = nums.append(wrap32(first_no + idx as i64));
        col += 1;
      }
    }
    row_into(out, c, texts, nums, c.numbering);
    count += 1;
    if (c.double_space && (r + 1 < rows || !c.omit_header || c.across)) {
      buf_push_byte(out, 10);
      count += 1;
    }
    r += 1;
  }
  return count;
}

function merge_cell(l: Line, c: Cfg, col: i32, txt: u8[], number: i64, number_tab: boolean): Line {
  if (col == 0 && !number_tab && c.num_sep == 9) {
    return l;
  }
  return put_column(l, c, col, txt, number, c.numbering && c.num_prefix == 0);
}

function merge_eof_number(l: Line, c: Cfg, number: i64, count: i32): Line {
  if (c.num_sep == 9 && c.offset > 0) {
    return put_number(l, c, l.pos - c.num_digits, number, false);
  }
  return put_number(l, c, l.pos - c.offset, number, c.num_sep != 9 || count > 1);
}

function merge_row_into(out: usize, c: Cfg, rows: u8[][], from: i32, count: i32, number: i64, extra_number: boolean, number_tab: boolean): void {
  let l = line_on(out);
  if (c.num_prefix > 0 && count > 0) {
    l = l.to(c.offset, c);
    l = put_number(l, c, c.offset, number, c.num_sep != 9 || number_tab);
  }
  for col in 0..count {
    l = merge_cell(l, c, col, rows[from + col], number, number_tab);
    if (col == 0 && extra_number) {
      l = merge_eof_number(l, c, wrap32(number + 1 as i64), count);
    }
  }
  buf_push_byte(out, 10);
}

function merge_body_into(out: usize, c: Cfg, rows: u8[][], width: i32, row_widths: i32[], terminated: boolean[], extra_numbers: boolean[], number_tabs: boolean[], first_no: i64): i32 {
  let count = 0;
  let nrows = 0;
  if (width > 0) {
    nrows = rows.len() / width;
  }
  let r = 0;
  let number = first_no;
  while (r < nrows) {
    let extra = c.numbering && extra_numbers[r];
    let number_tab = !c.numbering || number_tabs[r];
    merge_row_into(out, c, rows, r * width, row_widths[r], number, extra, number_tab);
    number = wrap32(number + 1 as i64);
    if (extra) {
      number = wrap32(number + 1 as i64);
    }
    count += 1;
    if (c.double_space && (terminated[r] || !c.omit_header)) {
      buf_push_byte(out, 10);
      count += 1;
    }
    r += 1;
  }
  return count;
}

function page_head(out: usize, c: Cfg, page: u64, name: string, t: i64, nsec: i64): void {
  if (c.omit_header) {
    return;
  }
  let lead = line_on(out).to(c.offset, c);
  lead = lead.flush(c);
  buf_push(out, "\n\n");
  let head = line_on(out).to(c.offset, c);
  let header = header_text(c, name, t, nsec, page);
  head = head.put_range(header, 0, header.len(), 0, c);
  buf_push(out, "\n\n\n");
}

function page_tail(out: usize, c: Cfg, lines: i32): void {
  if (c.omit_header) {
    return;
  }
  if (c.form_feed) {
    buf_push_byte(out, 12);
    return;
  }
  let body_lines = c.page_length - 10;
  if (c.double_space) {
    body_lines = rows_per_page(c) * 2;
  }
  let pad = body_lines - lines;
  if (pad > 0) {
    buf_push(out, "\n".repeat(pad));
  }
  buf_push(out, "\n\n\n\n\n");
}

struct Job { o: io_buffered.BufWriter, ok: boolean, fatal: boolean }

function now_seconds(): i64 {
  return now_unix_ms() / (1000 as i64);
}

function open_src(c: Cfg, name: string): (Src, boolean) {
  if (name == "-") {
    return (Src { r: stdin(), name: "-", is_stdin: true, open: true, buf: [], pos: 0, eof: false, fatal: false, nlat: 0 - 1, ffat: 0 - 1, mtime: now_seconds(), mnsec: 0 as i64 }, true);
  }
  let mt = 0 as i64;
  let ns = 0 as i64;
  match (stat(name)) {
    Ok(st) => {
      mt = st.mtime;
      ns = st.mtime_nsec;
    },
    Err(_) => {}
  }
  match (open_reader(name)) {
    Ok(r) => {
      return (Src { r: r, name: name, is_stdin: false, open: true, buf: [], pos: 0, eof: false, fatal: false, nlat: 0 - 1, ffat: 0 - 1, mtime: mt, mnsec: ns }, true);
    },
    Err(e) => {
      if (!c.nowarn) {
        gnu.error(gnu.quotef(name) + ": " + gnu.io_error_text(e));
      }
      return (src_closed(), false);
    }
  }
}

function rows_per_page(c: Cfg): i32 {
  let body = c.page_length;
  if (!c.omit_header) {
    body = c.page_length - 10;
  }
  if (c.double_space) {
    body /= 2;
  }
  if (body < 1) {
    body = 1;
  }
  return body;
}

function page_warning(c: Cfg, pages: u64, o0: io_buffered.BufWriter): io_buffered.BufWriter {
  let total = pages;
  if (total == 0 as u64) {
    total = 1 as u64;
  }
  if (c.first_page <= total) {
    return o0;
  }
  return gnu.error_out(o0, "starting page number " + c.first_page.to_string() + " exceeds page count " + total.to_string());
}

function run_serial(c: Cfg, name: string, o0: io_buffered.BufWriter, ok0: boolean): Job {
  let opened: (Src, boolean) = open_src(c, name);
  if (!opened.1) {
    return Job { o: o0, ok: false, fatal: false };
  }
  let s = opened.0;
  let o = o0;
  let ok = ok0;
  let paginate = !c.omit_header;
  let cap = rows_per_page(c) * c.columns;
  let page = 1 as u64;
  let pages = 0 as u64;
  let line_no = 1 as i64;
  let rebased = false;
  let stale = false;
  let boundary_end = false;
  let eof = false;
  let fatal = false;
  let hdr_name = name;
  if (s.is_stdin) {
    hdr_name = "";
  }
  while (page <= c.last_page) {
    let lines: u8[][] = [];
    let last_terminated = true;
    let broke = false;
    let first = true;
    while (lines.len() < cap && !broke && !eof) {
      let record = src_line(s);
      s = record.src;
      if (s.fatal) {
        fatal = true;
        break;
      }
      if (first && stale && record.ff && !record.line) {
        first = false;
        continue;
      }
      first = false;
      if (record.line) {
        lines = lines.append(record.text);
        last_terminated = !record.ff && !record.src.eof;
      }
      broke = record.ff;
      eof = !record.line && !record.ff;
    }
    if (fatal || lines.len() == 0 && !broke && eof) {
      break;
    }
    stale = lines.len() == cap && !broke;
    boundary_end = broke || lines.len() == cap;
    pages = pages + 1 as u64;
    let printing = page >= c.first_page;
    if (printing && !rebased) {
      rebased = true;
      if (c.has_first_line) {
        line_no = c.first_line as i64;
      }
    }
    if (printing) {
      let h = o.handle();
      page_head(h, c, page, hdr_name, s.mtime, s.mnsec);
      page_tail(h, c, body_into(h, c, lines, line_no, last_terminated));
      o = gnu.settle(o);
      if (!paginate && broke && !c.omit_pagination) {
        o = gnu.put(o, "\x0c");
      }
    }
    line_no = wrap32(line_no + lines.len() as i64);
    page = page + 1 as u64;
    if (eof) {
      break;
    }
  }
  src_release(s);
  if (!fatal) {
    if (eof && boundary_end && c.first_page > pages) {
      pages = pages + 1 as u64;
    }
    o = page_warning(c, pages, o);
  }
  return Job { o: o, ok: ok && !fatal, fatal: fatal };
}

function run_merge(c: Cfg, names: string[], o0: io_buffered.BufWriter, ok0: boolean): Job {
  let o = o0;
  let ok = ok0;
  let srcs: Src[] = [];
  let slot: i32[] = [];
  let stdin_slot = -1;
  let i = 0;
  while (i < names.len()) {
    let opened: (Src, boolean) = open_src(c, names[i]);
    if (opened.1) {
      if (opened.0.is_stdin && stdin_slot >= 0) {
        slot = slot.append(stdin_slot);
      } else {
        if (opened.0.is_stdin) {
          stdin_slot = srcs.len();
        }
        slot = slot.append(srcs.len());
        srcs = srcs.append(opened.0);
      }
    } else {
      ok = false;
    }
    i += 1;
  }
  let width = slot.len();
  if (width == 0) {
    return Job { o: o, ok: ok, fatal: false };
  }
  let eofs: boolean[] = [];
  let full: boolean[] = [];
  i = 0;
  while (i < width) {
    eofs = eofs.append(false);
    full = full.append(false);
    i += 1;
  }
  let rows = rows_per_page(c);
  let page = 1 as u64;
  let pages = 0 as u64;
  let line_no = 1 as i64;
  let rebased = false;
  let fatal = false;
  let now = now_seconds();
  let alive = true;
  while (page <= c.last_page && alive) {
    let held: boolean[] = [];
    let active = 0;
    i = 0;
    while (i < width) {
      held = held.append(false);
      if (!eofs[i]) {
        active += 1;
      }
      i += 1;
    }
    let cells: u8[][] = [];
    let row_widths: i32[] = [];
    let terminated: boolean[] = [];
    let extra_numbers: boolean[] = [];
    let number_tabs: boolean[] = [];
    let number_count = 0;
    let filled = 0;
    let page_ff = false;
    let r = 0;
    while (r < rows) {
      let row_width = 0;
      let row_terminated = false;
      let extra_number = false;
      let first_column = false;
      let second_column = false;
      let any = false;
      let col = 0;
      while (col < width) {
        let cell: u8[] = [];
        let present = false;
        if (!held[col] && !eofs[col]) {
          let k = slot[col];
          let got = src_line(srcs[k]);
          if (full[col] && got.ff && !got.line && !got.src.fatal) {
            got = src_line(got.src);
          }
          full = full.with(col, false);
          srcs = srcs.with(k, got.src);
          if (got.src.fatal) {
            fatal = true;
          } else {
            if (got.line) {
              cell = got.text;
              row_terminated = row_terminated || !got.ff && !got.src.eof;
              extra_number = extra_number || c.numbering && active > 1 && col == 0 && !got.ff && got.src.eof;
              first_column = first_column || col == 0;
              second_column = second_column || col == 1;
              any = true;
              present = true;
            }
            if (got.ff) {
              held = held.with(col, true);
              page_ff = true;
              active -= 1;
            } else if (!got.line || got.src.eof && got.src.pos >= got.src.buf.len()) {
              eofs = eofs.with(col, true);
              active -= 1;
            }
          }
        }
        if (any && active == 0 && !present) {
          break;
        }
        if (any) {
          while (row_width < col) {
            cells = cells.append([]);
            row_width += 1;
          }
          cells = cells.append(cell);
          row_width += 1;
        }
        col += 1;
        if (any && active == 0) {
          break;
        }
      }
      if (fatal || !any) {
        if (!page_ff) {
          alive = false;
        }
        break;
      }
      row_widths = row_widths.append(row_width);
      if (c.double_space) {
        terminated = terminated.append(row_terminated);
      }
      if (c.numbering) {
        extra_numbers = extra_numbers.append(extra_number);
        number_tabs = number_tabs.append(first_column || !second_column);
        if (extra_number) {
          number_count += 1;
        }
      }
      while (row_width < width) {
        cells = cells.append([]);
        row_width += 1;
      }
      filled += 1;
      r += 1;
    }
    if (fatal || filled == 0 && !page_ff) {
      break;
    }
    if (filled == rows) {
      i = 0;
      while (i < width) {
        full = full.with(i, !held[i] && !eofs[i]);
        i += 1;
      }
    }
    pages = pages + 1 as u64;
    let printing = page >= c.first_page;
    if (printing && !rebased) {
      rebased = true;
      if (c.has_first_line) {
        line_no = c.first_line as i64;
      }
    }
    if (printing) {
      let h = o.handle();
      page_head(h, c, page, "", now, 0 as i64);
      page_tail(h, c, merge_body_into(h, c, cells, width, row_widths, terminated, extra_numbers, number_tabs, line_no));
      o = gnu.settle(o);
      if (c.omit_header && page_ff && !c.omit_pagination) {
        o = gnu.put(o, "\x0c");
      }
    }
    if (printing) {
      line_no = wrap32(line_no + number_count as i64);
    }
    line_no = wrap32(line_no + filled as i64);
    page = page + 1 as u64;
  }
  for s in srcs {
    src_release(s);
  }
  if (!fatal) {
    o = page_warning(c, pages, o);
  }
  return Job { o: o, ok: ok && !fatal, fatal: fatal };
}

function build_opts(): gnu.Opt[] {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.valued("", "pages", opt_pages()));
  opts = opts.append(gnu.valued("", "columns", opt_columns()));
  opts = opts.append(gnu.flag("a", "across", opt_across()));
  opts = opts.append(gnu.flag("c", "show-control-chars", opt_ctrl()));
  opts = opts.append(gnu.flag("d", "double-space", opt_double()));
  opts = opts.append(gnu.valued("D", "date-format", opt_date()));
  opts = opts.append(gnu.optional("e", "expand-tabs", opt_expand()));
  opts = opts.append(gnu.flag("F", "form-feed", opt_formfeed()));
  opts = opts.append(gnu.valued("h", "header", opt_header()));
  opts = opts.append(gnu.optional("i", "output-tabs", opt_outtabs()));
  opts = opts.append(gnu.flag("J", "join-lines", opt_join()));
  opts = opts.append(gnu.valued("l", "length", opt_length()));
  opts = opts.append(gnu.flag("m", "merge", opt_merge()));
  opts = opts.append(gnu.optional("n", "number-lines", opt_number()));
  opts = opts.append(gnu.valued("N", "first-line-number", opt_firstline()));
  opts = opts.append(gnu.valued("o", "indent", opt_indent()));
  opts = opts.append(gnu.flag("r", "no-file-warnings", opt_nowarn()));
  opts = opts.append(gnu.optional("s", "separator", opt_sep()));
  opts = opts.append(gnu.optional("S", "sep-string", opt_sepstring()));
  opts = opts.append(gnu.flag("t", "omit-header", opt_omithdr()));
  opts = opts.append(gnu.flag("T", "omit-pagination", opt_omitpage()));
  opts = opts.append(gnu.flag("v", "show-nonprinting", opt_nonprint()));
  opts = opts.append(gnu.valued("w", "width", opt_width()));
  opts = opts.append(gnu.valued("W", "page-width", opt_pagewidth()));
  opts = opts.append(gnu.flag("f", "", opt_formfeed()));
  opts = opts.append(gnu.flag("b", "", opt_balance()));
  let d = 0;
  while (d < 10) {
    opts = opts.append(gnu.flag(slice_unchecked("0123456789", d, d + 1) + "", "", opt_digit(d)));
    d += 1;
  }
  return opts;
}

function getnum_first_line(value: string): i32 {
  let r: (i64, boolean) = parse_int(value);
  let bad = 0;
  if (!r.1) {
    bad = 1;
  } else if (r.0 > 2147483647 as i64 || r.0 < 0 as i64 - 2147483648 as i64) {
    bad = 3;
  }
  if (bad != 0) {
    gnu.error("'-N NUMBER' invalid starting line number: " + gnu.quote(value) + num_text(bad));
    exit(1);
  }
  return r.0 as i32;
}

pub function main(): i32 {
  let argv = args();
  let g = gnu.getopt_new(argv, build_opts(), "pr", help_text(), 1).return_in_order();

  let columns = 1;
  let col_str = "";
  let have_columns = false;
  let across = false;
  let merge = false;
  let ctrl = false;
  let nonprint = false;
  let double_space = false;
  let date_fmt = "";
  let has_date = false;
  let untabify = false;
  let in_tab = 9;
  let in_tab_width = 8;
  let want_tabify = false;
  let out_tab = 9;
  let out_tab_width = 8;
  let form_feed = false;
  let header = "";
  let has_header = false;
  let join = false;
  let page_length = 66;
  let numbering = false;
  let num_sep = 9;
  let num_digits = 5;
  let first_line = 1;
  let has_first_line = false;
  let offset = 0;
  let nowarn = false;
  let sep = "";
  let s_given = false;
  let s_value = "";
  let big_s_given = false;
  let big_s_value = "";
  let omit_header = false;
  let omit_pagination = false;
  let w_given = false;
  let w_value = 72;
  let big_w_given = false;
  let big_w_value = 72;
  let first_page = 1 as u64;
  let last_page = 18446744073709551615 as u64;
  let have_range = false;
  let files: string[] = [];

  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    let stop = false;
    match (res.0) {
      Some(m) => {
        if (m.id == gnu.operand_id()) {
          let tok = m.value;
          let taken = false;
          if (!have_range && tok.len() > 0 && tok[0] as i32 == 43) {
            let rr: (u64, u64, i32) = parse_range(slice_unchecked(tok, 1, tok.len()) + "", "+");
            if (rr.2 == 0) {
              first_page = rr.0;
              last_page = rr.1;
              have_range = true;
              taken = true;
            }
          }
          if (!taken) {
            files = files.append(tok);
          }
        } else if (m.id == opt_pages()) {
          let rr: (u64, u64, i32) = parse_range(m.value, "--pages");
          if (rr.2 != 0) {
            gnu.error("invalid page range " + gnu.quote(m.value));
            exit(1);
          }
          first_page = rr.0;
          last_page = rr.1;
          have_range = true;
        } else if (m.id == opt_columns()) {
          col_str = m.value;
          have_columns = true;
        } else if (m.id >= opt_digit(0) && m.id <= opt_digit(9)) {
          col_str += slice_unchecked("0123456789", m.id - opt_digit(0), m.id - opt_digit(0) + 1);
          have_columns = true;
        } else if (m.id == opt_across()) {
          across = true;
        } else if (m.id == opt_ctrl()) {
          ctrl = true;
        } else if (m.id == opt_double()) {
          double_space = true;
        } else if (m.id == opt_date()) {
          date_fmt = m.value;
          has_date = true;
        } else if (m.id == opt_expand()) {
          untabify = true;
          let e: (i32, i32) = char_width(m.value, "e", 9, 8);
          in_tab = e.0;
          in_tab_width = e.1;
        } else if (m.id == opt_formfeed()) {
          form_feed = true;
        } else if (m.id == opt_header()) {
          header = m.value;
          has_header = true;
        } else if (m.id == opt_outtabs()) {
          want_tabify = true;
          let it: (i32, i32) = char_width(m.value, "i", 9, 8);
          out_tab = it.0;
          out_tab_width = it.1;
        } else if (m.id == opt_join()) {
          join = true;
        } else if (m.id == opt_length()) {
          page_length = getnum(m.value, "'-l PAGE_LENGTH' invalid number of lines", 1 as i64);
        } else if (m.id == opt_merge()) {
          merge = true;
        } else if (m.id == opt_number()) {
          numbering = true;
          let nn: (i32, i32) = char_width(m.value, "n", 9, 5);
          num_sep = nn.0;
          num_digits = nn.1;
        } else if (m.id == opt_firstline()) {
          first_line = getnum_first_line(m.value);
          has_first_line = true;
        } else if (m.id == opt_indent()) {
          offset = getnum(m.value, "'-o MARGIN' invalid line offset", 0 as i64);
        } else if (m.id == opt_nowarn()) {
          nowarn = true;
        } else if (m.id == opt_sep()) {
          s_given = true;
          s_value = m.value;
        } else if (m.id == opt_sepstring()) {
          big_s_given = true;
          big_s_value = m.value;
        } else if (m.id == opt_omithdr()) {
          omit_header = true;
        } else if (m.id == opt_omitpage()) {
          omit_pagination = true;
          omit_header = true;
        } else if (m.id == opt_nonprint()) {
          nonprint = true;
        } else if (m.id == opt_width()) {
          w_given = true;
          w_value = getnum(m.value, "'-w PAGE_WIDTH' invalid number of characters", 1 as i64);
        } else if (m.id == opt_pagewidth()) {
          big_w_given = true;
          big_w_value = getnum(m.value, "'-W PAGE_WIDTH' invalid number of characters", 1 as i64);
        }
      },
      None => {
        stop = true;
      }
    }
    if (stop) {
      break;
    }
  }
  let rest = g.operands();
  let ri = 0;
  while (ri < rest.len()) {
    files = files.append(rest[ri]);
    ri += 1;
  }

  if (have_columns) {
    let cn: (i64, boolean) = parse_int(col_str);
    let st = num_fault(cn.0, cn.1, 1 as i64);
    if (st != 0) {
      gnu.error("invalid number of columns: " + gnu.quote(col_str) + num_text(st));
      exit(1);
    }
    columns = cn.0 as i32;
  }
  if (merge && have_columns) {
    gnu.error("cannot specify number of columns when printing in parallel");
    exit(1);
  }
  if (merge && across) {
    gnu.error("cannot specify both printing across and printing in parallel");
    exit(1);
  }
  if (files.len() == 0) {
    files = files.append("-");
  }
  if (merge) {
    columns = files.len();
  }

  if (page_length <= 10) {
    omit_header = true;
  }
  let page_width = 72;
  if (big_w_given) {
    page_width = big_w_value;
  } else if (w_given) {
    page_width = w_value;
  }
  if (big_s_given) {
    sep = big_s_value;
  } else if (s_given) {
    if (s_value.len() > 0) {
      sep = s_value;
    } else if (w_given || big_w_given) {
      sep = "";
    } else {
      sep = "\t";
    }
  } else if (join) {
    sep = "\t";
  } else {
    sep = " ";
  }
  let truncate = columns > 1;
  if (s_given && !big_s_given) {
    truncate = w_given || big_w_given;
  }
  if (big_w_given) {
    truncate = true;
  }
  if (join) {
    truncate = false;
  }
  let num_width = num_digits + 1;
  if (num_sep == 9) {
    num_width = num_digits + tab_stop() - num_digits % tab_stop();
  }
  let num_prefix = 0;
  if (merge && numbering) {
    num_prefix = num_width;
  }
  let chars_per_column = (page_width - num_prefix - (columns - 1) * sep.len()) / columns;
  if (chars_per_column < 1) {
    gnu.error("page width too narrow");
    exit(1);
  }
  let tab_literal = !truncate && sep == "\t";

  let c = Cfg { columns: columns, across: across, merge: merge, ctrl: ctrl, nonprint: nonprint, double_space: double_space, date_fmt: header_date_format(has_date, date_fmt), untabify: untabify, in_tab: in_tab, in_tab_width: in_tab_width, tabify: want_tabify || columns > 1, out_tab: out_tab, out_tab_width: out_tab_width, form_feed: form_feed, header: header, has_header: has_header, page_length: page_length, numbering: numbering, num_sep: num_sep, num_digits: num_digits, num_width: num_width, first_line: first_line, has_first_line: has_first_line, offset: offset, nowarn: nowarn, sep: sep, omit_header: omit_header, omit_pagination: omit_pagination, page_width: page_width, zone: tz.local_zone(), truncate: truncate, tab_literal: tab_literal, num_prefix: num_prefix, first_page: first_page, last_page: last_page, chars_per_column: chars_per_column };

  let o = gnu.out_new();
  let ok = true;
  if (merge) {
    let merged = run_merge(c, files, o, ok);
    o = merged.o;
    ok = merged.ok;
  } else {
    let i = 0;
    while (i < files.len()) {
      let serial = run_serial(c, files[i], o, ok);
      o = serial.o;
      ok = serial.ok;
      if (serial.fatal) {
        i = files.len();
      }
      i += 1;
    }
  }
  gnu.finish(o);
  if (!ok) {
    return 1;
  }
  return 0;
}
