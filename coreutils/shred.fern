import "std/string";
import "std/i32";
import "std/i64";
import "std/rand" as rand;
import "std/errno";
import "./lib/gnu";

function opt_force(): i32 {
  return 1;
}

function opt_iterations(): i32 {
  return 2;
}

function opt_random_source(): i32 {
  return 3;
}

function opt_size(): i32 {
  return 4;
}

function opt_u(): i32 {
  return 5;
}

function opt_remove(): i32 {
  return 6;
}

function opt_verbose(): i32 {
  return 7;
}

function opt_exact(): i32 {
  return 8;
}

function opt_zero(): i32 {
  return 9;
}

function how_unlink(): i32 {
  return 0;
}

function how_wipe(): i32 {
  return 1;
}

function how_wipesync(): i32 {
  return 2;
}

struct Settings { force: boolean, passes: i32, size: i64, size_given: boolean, remove: boolean, how: i32, verbose: boolean, exact: boolean, zero: boolean, source: string, source_given: boolean }

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]... FILE...\n";
  out = out + "Overwrite the specified FILE(s) repeatedly, in order to make it harder\n";
  out = out + "for even very expensive hardware probing to recover the data.\n";
  out = out + "\n";
  out = out + "If FILE is -, shred standard output.\n";
  out = out + "\n";
  out = out + "Mandatory arguments to long options are mandatory for short options too.\n";
  out = out + "  -f, --force    change permissions to allow writing if necessary\n";
  out = out + "  -n, --iterations=N  overwrite N times instead of the default (3)\n";
  out = out + "      --random-source=FILE  get random bytes from FILE\n";
  out = out + "  -s, --size=N   shred this many bytes (suffixes like K, M, G accepted)\n";
  out = out + "  -u             deallocate and remove file after overwriting\n";
  out = out + "      --remove[=HOW]  like -u but give control on HOW to delete;  See below\n";
  out = out + "  -v, --verbose  show progress\n";
  out = out + "  -x, --exact    do not round file sizes up to the next full block;\n";
  out = out + "                   this is the default for non-regular files\n";
  out = out + "  -z, --zero     add a final overwrite with zeros to hide shredding\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function base_patterns(): i32[] {
  let out: i32[] = [];
  let n: i32 = 0;
  while (n < 16) {
    let nib: i32 = n * 16 + n;
    out = out.append(nib * 65536 + nib * 256 + nib);
    n = n + 1;
  }
  out = out.append(0x249249);
  out = out.append(0x492492);
  out = out.append(0x6db6db);
  out = out.append(0x924924);
  out = out.append(0xb6db6d);
  out = out.append(0xdb6db6);
  return out;
}

function flip_first(p: i32): i32 {
  return p ^ 0x800000;
}

function random_pass(): i32 {
  return 0 - 1;
}

function hex_digit(v: i32): u8 {
  if (v < 10) {
    return (48 + v) as u8;
  }
  return (87 + v) as u8;
}

function pattern_name(p: i32): string {
  if (p == random_pass()) {
    return "random";
  }
  let bs: u8[] = [];
  let shift: i32 = 20;
  while (shift >= 0) {
    bs = bs.append(hex_digit(p / pow16(shift) % 16));
    shift = shift - 4;
  }
  return string_from_bytes_unchecked(bs);
}

function pow16(shift: i32): i32 {
  let v: i32 = 1;
  let i: i32 = 0;
  while (i < shift) {
    v = v * 2;
    i = i + 1;
  }
  return v;
}

function schedule(passes: i32, zero: boolean): i32[] {
  let out: i32[] = [];
  if (passes <= 3) {
    return all_random(passes, zero);
  }
  if (passes > 0) {
    out = out.append(random_pass());
  }
  let vocab: i32[] = shuffled_vocab();
  let middle: i32 = passes - 2;
  let extra: i32 = 0 - 1;
  if (passes >= 5) {
    extra = middle / 2;
  }
  let i: i32 = 0;
  let taken: i32 = 0;
  while (i < middle) {
    if (i == extra) {
      out = out.append(random_pass());
    } else {
      out = out.append(vocab[taken % vocab.len()]);
      taken = taken + 1;
    }
    i = i + 1;
  }
  if (passes > 1) {
    out = out.append(random_pass());
  }
  if (zero) {
    out = out.append(0);
  }
  return out;
}

function all_random(passes: i32, zero: boolean): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < passes) {
    out = out.append(random_pass());
    i = i + 1;
  }
  if (zero) {
    out = out.append(0);
  }
  return out;
}

function shuffled_vocab(): i32[] {
  let all: i32[] = [];
  let bases: i32[] = base_patterns();
  let i: i32 = 0;
  while (i < bases.len()) {
    all = all.append(bases[i]);
    all = all.append(flip_first(bases[i]));
    i = i + 1;
  }
  let rnd: u8[] = random_bytes(all.len() * 2);
  let k: i32 = all.len() - 1;
  while (k > 0) {
    let j: i32 = (rnd[k * 2] as i32 * 256 + rnd[k * 2 + 1] as i32) % (k + 1);
    let tmp: i32 = all[k];
    all = all.with(k, all[j]);
    all = all.with(j, tmp);
    k = k - 1;
  }
  return all;
}

struct Rand { from_file: boolean, r: Reader, name: string, st: Cell[i64], block: usize }

function rand_none(): Rand {
  return Rand { from_file: false, r: stdin(), name: "", st: cell_new(rand.rng_seed_from_os()), block: buf_new(block_bytes(random_pass())) };
}

function rand_open(s: Settings): Option[Rand] {
  if (!s.source_given) {
    return Some(rand_none());
  }
  match (open_reader(s.source)) {
    Ok(r) => {
      return Some(Rand { from_file: true, r: r, name: s.source, st: cell_new(0 as i64), block: 0 as usize });
    },
    Err(e) => {
      gnu.error(s.source + ": " + gnu.io_error_text(e));
      return None;
    }
  }
}

function rand_block(rnd: Rand, n: i32): (u8[], boolean) {
  if (!rnd.from_file) {
    rnd.st.set(rand.rng_fill(rnd.st.get(), rnd.block, n));
    return (buf_take_bytes(rnd.block), true);
  }
  let h: usize = 0 as usize;
  let got: i32 = 0;
  let full: boolean = true;
  while (got < n) {
    match (rnd.r.read_chunk_bytes(n - got)) {
      Ok(bytes) => {
        if (bytes.len() == 0) {
          full = false;
          break;
        }
        if (got == 0 && bytes.len() == n) {
          return (bytes, true);
        }
        if (h == 0 as usize) {
          h = buf_new(n);
        }
        buf_push_bytes_range(h, bytes, 0, bytes.len());
        got = got + bytes.len();
      },
      Err(_) => {
        full = false;
        break;
      }
    }
  }
  let out: u8[] = [];
  if (h != 0 as usize) {
    out = buf_take_bytes(h);
    buf_free(h);
  }
  return (out, full);
}

function copy_bytes(bytes: u8[], lo: i32, hi: i32): u8[] {
  let h: usize = buf_new(hi - lo);
  buf_push_bytes_range(h, bytes, lo, hi);
  let out: u8[] = buf_take_bytes(h);
  buf_free(h);
  return out;
}

function pattern_block(p: i32, n: i32): u8[] {
  let out: u8[] = [(p / 65536 % 256) as u8, (p / 256 % 256) as u8, (p % 256) as u8];
  if (n <= 3) {
    return copy_bytes(out, 0, n);
  }
  let h: usize = buf_new(6);
  while (out.len() < n) {
    let take: i32 = out.len();
    if (take > n - out.len()) {
      take = n - out.len();
    }
    buf_push_bytes_range(h, out, 0, out.len());
    buf_push_bytes_range(h, out, 0, take);
    out = buf_take_bytes(h);
  }
  buf_free(h);
  return out;
}

function block_bytes(code: i32): i32 {
  if (code == random_pass()) {
    return 65536;
  }
  let first: i32 = code / 65536 % 256;
  if (first == code / 256 % 256 && first == code % 256) {
    return 65536;
  }
  return 61440;
}

struct PassFail { msg: string, fatal: boolean }

function pass_chunk(code: i32, n: i32, full: u8[], rnd: Rand): (u8[], boolean) {
  if (code == random_pass()) {
    return rand_block(rnd, n);
  }
  if (n == full.len()) {
    return (full, true);
  }
  return (copy_bytes(full, 0, n), true);
}

function write_pass(w: Writer, path: string, len: i64, code: i32, rnd: Rand): Option[PassFail] {
  match (w.seek(0 as i64, 0)) {
    Err(e) => {
      return Some(PassFail { msg: path + ": " + gnu.io_error_text(e), fatal: false });
    },
    Ok(_) => {}
  }
  match (write_blocks(w, path, len, code, rnd)) {
    Some(f) => {
      return Some(f);
    },
    None => {}
  }
  return sync_pass(w, path);
}

function sync_pass(w: Writer, path: string): Option[PassFail] {
  match (w.fdatasync()) {
    Ok(_) => {
      return None;
    },
    Err(_) => {}
  }
  if let Err(e) = w.fsync() {
    if (errno.of(e) == errno.EINVAL) {
      return None;
    }
    return Some(PassFail { msg: path + ": " + gnu.io_error_text(e), fatal: false });
  }
  return None;
}

function write_block(w: Writer, path: string, block: u8[], at: i64): (i64, Option[PassFail]) {
  let n: i32 = block.len();
  let off: i32 = 0;
  while (off < n) {
    let piece: u8[] = block;
    if (off > 0) {
      piece = copy_bytes(block, off, n);
    }
    match (w.write_some_bytes(piece)) {
      Err(e) => {
        let at_byte: string = ": error writing at offset " + (at + off as i64).to_string() + ": ";
        return (at + off as i64, Some(PassFail { msg: path + at_byte + gnu.io_error_text(e), fatal: false }));
      },
      Ok(k) => {
        if (k == 0 as i64) {
          return (at + off as i64, None);
        }
        off = off + k as i32;
      }
    }
  }
  return (at + n as i64, None);
}

function write_blocks(w: Writer, path: string, len: i64, code: i32, rnd: Rand): Option[PassFail] {
  let full: u8[] = [];
  let block_size: i32 = block_bytes(code);
  if (code != random_pass()) {
    full = pattern_block(code, block_size);
  }
  let at: i64 = 0 as i64;
  while (at < len) {
    let n: i32 = block_size;
    if (len - at < block_size as i64) {
      n = (len - at) as i32;
    }
    let got: (u8[], boolean) = pass_chunk(code, n, full, rnd);
    if (!got.1) {
      return Some(PassFail { msg: gnu.quote(rnd.name) + ": end of file", fatal: true });
    }
    let moved: (i64, Option[PassFail]) = write_block(w, path, got.0, at);
    match (moved.1) {
      Some(f) => {
        return Some(f);
      },
      None => {}
    }
    if (moved.0 == at) {
      return None;
    }
    at = moved.0;
  }
  return None;
}

function name_chars(): string {
  return "0123456789abcdefghijklmnopqrstuvwxyz";
}

function dir_prefix(path: string): string {
  let Some(cut) = path.last_index_of("/") else {
    return "";
  };
  return slice_unchecked(path, 0, cut + 1) + "";
}

function next_free(prefix: string, len: i32): string {
  let chars: string = name_chars();
  let idx: i32[] = [];
  let i: i32 = 0;
  while (i < len) {
    idx = idx.append(0);
    i = i + 1;
  }
  let tries: i32 = 0;
  while (tries < 4096) {
    let name: string = index_name(idx, chars);
    match (lstat(prefix + name)) {
      Err(_) => {
        return name;
      },
      Ok(_) => {}
    }
    idx = step_index(idx, chars.len());
    tries = tries + 1;
  }
  return "";
}

function index_name(idx: i32[], chars: string): string {
  let cand: u8[] = [];
  let k: i32 = 0;
  while (k < idx.len()) {
    cand = cand.append(chars[idx[k]]);
    k = k + 1;
  }
  return string_from_bytes_unchecked(cand);
}

function step_index(idx: i32[], base: i32): i32[] {
  let out: i32[] = idx;
  let k: i32 = out.len() - 1;
  while (k >= 0) {
    if (out[k] + 1 < base) {
      return out.with(k, out[k] + 1);
    }
    out = out.with(k, 0);
    k = k - 1;
  }
  return out;
}

function wipe_names(path: string, s: Settings): string {
  let prefix: string = dir_prefix(path);
  let current: string = path;
  let len: i32 = gnu.base_name(path).len();
  while (len >= 1) {
    let cand: string = next_free(prefix, len);
    if (cand.len() == 0) {
      return current;
    }
    match (rename(current, prefix + cand)) {
      Err(_) => {
        return current;
      },
      Ok(_) => {}
    }
    if (s.verbose) {
      gnu.error(current + ": renamed to " + prefix + cand);
    }
    current = prefix + cand;
    len = len - 1;
  }
  return current;
}

function remove_entry(path: string, s: Settings): boolean {
  if (s.verbose) {
    gnu.error(path + ": removing");
  }
  let target: string = path;
  if (s.how != how_unlink()) {
    target = wipe_names(path, s);
  }
  match (remove_file(target)) {
    Err(e) => {
      gnu.error(path + ": " + gnu.io_error_text(e));
      return false;
    },
    Ok(_) => {}
  }
  if (s.verbose) {
    gnu.error(path + ": removed");
  }
  return true;
}

function shred_one(path: string, s: Settings, rnd: Rand): (boolean, boolean) {
  if (path == "-") {
    let d: (Writer, boolean) = dash_handle();
    if (!d.1) {
      return (false, false);
    }
    return shred_handle(d.0, "-", s, rnd, true);
  }
  match (open_for_shred(path, s)) {
    Err(e) => {
      gnu.error(path + ": failed to open for writing: " + gnu.io_error_text(e));
      return (false, false);
    },
    Ok(w) => {
      return shred_handle(w, path, s, rnd, false);
    }
  }
}

function dash_handle(): (Writer, boolean) {
  let w: Writer = stdout();
  match (w.flags()) {
    Err(e) => {
      gnu.error("-: fcntl failed: " + gnu.io_error_text(e));
      return (w, false);
    },
    Ok(f) => {
      if ((f & 4 as i64) != 0 as i64) {
        gnu.error("-: cannot shred append-only file descriptor");
        return (w, false);
      }
    }
  }
  return (w, true);
}

function unshreddable(mode: u32, tty: boolean): boolean {
  if (tty) {
    return true;
  }
  let kind: u32 = mode & 61440 as u32;
  return kind == 4096 as u32 || kind == 49152 as u32;
}

function shred_type_ok(w: Writer, path: string): boolean {
  match (w.stat()) {
    Err(_) => {
      return true;
    },
    Ok(st) => {
      if (unshreddable(st.mode, w.isatty())) {
        gnu.error(path + ": invalid file type");
        return false;
      }
    }
  }
  return true;
}

function shred_handle(w: Writer, path: string, s: Settings, rnd: Rand, is_dash: boolean): (boolean, boolean) {
  if (!shred_type_ok(w, path)) {
    if (!is_dash) {
      w.close();
    }
    return (false, false);
  }
  let sized: (Lengths, boolean) = shred_length(w, s);
  if (!sized.1) {
    gnu.error(path + ": failed to stat");
    if (!is_dash) {
      w.close();
    }
    return (false, false);
  }
  let wrote: (boolean, boolean) = write_passes(w, path, sized.0, s, rnd);
  if (!wrote.0) {
    if (!is_dash) {
      w.close();
    }
    return (false, wrote.1);
  }
  if (is_dash) {
    return (dash_remove(w, s), false);
  }
  w.close();
  if (s.remove) {
    return (remove_entry(path, s), false);
  }
  return (true, false);
}

function dash_remove(w: Writer, s: Settings): boolean {
  if (!s.remove) {
    return true;
  }
  if let Err(e) = w.truncate(0 as i64) {
    gnu.error("-: " + gnu.io_error_text(e));
    return false;
  }
  return true;
}

function open_for_shred(path: string, s: Settings): Result[Writer, IoError] {
  let first: Result[Writer, IoError] = open_writer_with(path, 0);
  match (first) {
    Ok(_) => {
      return first;
    },
    Err(e) => {
      if (!s.force) {
        return first;
      }
      match (e) {
        PermissionDenied(_) => {},
        _ => {
          return first;
        }
      }
      match (chmod(path, 128)) {
        Err(ce) => {
          return Err(ce);
        },
        Ok(_) => {}
      }
      return open_writer_with(path, 0);
    }
  }
}

struct Lengths { first: i64, total: i64 }

function shred_length(w: Writer, s: Settings): (Lengths, boolean) {
  match (w.stat()) {
    Err(_) => {
      if (s.size_given) {
        return (Lengths { first: 0 as i64, total: s.size }, true);
      }
      return (Lengths { first: 0 as i64, total: 0 as i64 }, false);
    },
    Ok(st) => {
      let total: i64 = st.size;
      if (s.size_given) {
        total = s.size;
      } else if (!st.is_file) {
        total = device_length(w);
      } else if (!s.exact) {
        total = round_up(st.size, st.blksize);
      }
      let first: i64 = 0 as i64;
      if (st.is_file && total > st.size && st.size < st.blksize) {
        first = st.size;
      }
      return (Lengths { first: first, total: total }, true);
    }
  }
}

function device_length(w: Writer): i64 {
  match (w.seek(0 as i64, 2)) {
    Ok(end) => {
      if (end > 0 as i64) {
        return end;
      }
    },
    Err(_) => {}
  }
  return 9223372036854775807 as i64;
}

function round_up(size: i64, block: i64): i64 {
  if (block <= 0 as i64) {
    return size;
  }
  let rem: i64 = size % block;
  if (rem == 0 as i64) {
    return size;
  }
  return size + block - rem;
}

function write_sweep(w: Writer, path: string, len: i64, codes: i32[], announce: boolean, rnd: Rand): Option[PassFail] {
  let i: i32 = 0;
  while (i < codes.len()) {
    if (announce) {
      gnu.error(path + ": pass " + (i + 1).to_string() + "/" + codes.len().to_string() + " (" + pattern_name(codes[i]) + ")...");
    }
    match (write_pass(w, path, len, codes[i], rnd)) {
      Some(f) => {
        return Some(f);
      },
      None => {}
    }
    i = i + 1;
  }
  return None;
}

function write_passes(w: Writer, path: string, span: Lengths, s: Settings, rnd: Rand): (boolean, boolean) {
  if (span.total <= 0 as i64) {
    return (true, false);
  }
  let codes: i32[] = schedule(s.passes, s.zero);
  if (span.first > 0 as i64) {
    match (write_sweep(w, path, span.first, codes, false, rnd)) {
      Some(f) => {
        gnu.error(f.msg);
        return (false, f.fatal);
      },
      None => {}
    }
  }
  match (write_sweep(w, path, span.total, codes, s.verbose, rnd)) {
    Some(f) => {
      gnu.error(f.msg);
      return (false, f.fatal);
    },
    None => {}
  }
  return (true, false);
}

function settings_new(): Settings {
  return Settings { force: false, passes: 3, size: 0 as i64, size_given: false, remove: false, how: how_wipesync(), verbose: false, exact: false, zero: false, source: "", source_given: false };
}

function scan_options(): (Settings, string[]) {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("f", "force", opt_force()));
  opts = opts.append(gnu.valued("n", "iterations", opt_iterations()));
  opts = opts.append(gnu.valued("", "random-source", opt_random_source()));
  opts = opts.append(gnu.valued("s", "size", opt_size()));
  opts = opts.append(gnu.flag("u", "", opt_u()));
  opts = opts.append(gnu.optional_long("", "remove", opt_remove()));
  opts = opts.append(gnu.flag("v", "verbose", opt_verbose()));
  opts = opts.append(gnu.flag("x", "exact", opt_exact()));
  opts = opts.append(gnu.flag("z", "zero", opt_zero()));

  let s: Settings = settings_new();
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "shred", help_text(), 1);
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    match (r.0) {
      Some(m) => {
        s = apply_option(s, m);
      },
      None => {
        break;
      }
    }
  }
  return (s, g.operands());
}

function apply_option(s: Settings, m: gnu.OptMatch): Settings {
  if (m.id == opt_force()) {
    return Settings { ...s, force: true };
  }
  if (m.id == opt_iterations()) {
    return Settings { ...s, passes: passes_of(m.value) };
  }
  if (m.id == opt_random_source()) {
    return Settings { ...s, source: m.value, source_given: true };
  }
  if (m.id == opt_size()) {
    return Settings { ...s, size: size_of(m.value), size_given: true };
  }
  if (m.id == opt_u()) {
    return Settings { ...s, remove: true, how: how_wipesync() };
  }
  if (m.id == opt_remove()) {
    return Settings { ...s, remove: true, how: how_of(m.value) };
  }
  if (m.id == opt_verbose()) {
    return Settings { ...s, verbose: true };
  }
  if (m.id == opt_exact()) {
    return Settings { ...s, exact: true };
  }
  return Settings { ...s, zero: true };
}

function passes_of(v: string): i32 {
  let r: (u64, i32) = gnu.parse_units(v);
  if (r.1 != 0) {
    gnu.error("invalid number of passes: " + gnu.quote(v));
    exit(1);
  }
  return r.0 as i32;
}

function size_of(v: string): i64 {
  let r: (u64, i32) = gnu.parse_units(v);
  if (r.1 != 0) {
    gnu.error("invalid file size: " + gnu.quote(v));
    exit(1);
  }
  return r.0 as i64;
}

function how_of(v: string): i32 {
  if (v.len() == 0) {
    return how_wipesync();
  }
  let names: string[] = ["unlink", "wipe", "wipesync"];
  return gnu.argmatch(v, names, "--remove");
}

pub function main(): i32 {
  let scanned: (Settings, string[]) = scan_options();
  let s: Settings = scanned.0;
  let operands: string[] = scanned.1;
  if (operands.len() == 0) {
    gnu.die_usage("missing file operand", 1);
  }
  match (rand_open(s)) {
    Some(rnd) => {
      return shred_all(operands, s, rnd);
    },
    None => {
      return 1;
    }
  }
  return 1;
}

function shred_all(operands: string[], s: Settings, rnd: Rand): i32 {
  let ok: boolean = true;
  let i: i32 = 0;
  while (i < operands.len()) {
    let done: (boolean, boolean) = shred_one(operands[i], s, rnd);
    if (!done.0) {
      ok = false;
    }
    if (done.1) {
      rand_close(rnd);
      return 1;
    }
    i = i + 1;
  }
  rand_close(rnd);
  if (ok) {
    return 0;
  }
  return 1;
}

function rand_close(rnd: Rand): void {
  if (!rnd.from_file) {
    buf_free(rnd.block);
  }
}
