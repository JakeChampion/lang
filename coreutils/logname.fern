import "std/string";
import "std/array";
import "./lib/gnu";
import "./lib/pwdb";
import "./lib/utmp";

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]\n";
  out = out + "Print the user's login name.\n";
  out = out + "\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

function login_uid(): Option[i64] {
  match (read_file("/proc/self/loginuid")) {
    Ok(text) => {
      match (pwdb.parse_id(text.trim() + "")) {
        Some(uid) => {
          if (uid == 4294967295 as i64) {
            return None;
          }
          return Some(uid);
        },
        None => {
          return None;
        }
      }
    },
    Err(_) => {
      return None;
    }
  }
}

function login_name(): Option[string] {
  if (target_os() == "darwin") {
    return pwdb.session_login();
  }
  match (login_uid()) {
    Some(uid) => {
      return pwdb.user_name(uid);
    },
    None => {}
  }
  match (utmp.terminal_line()) {
    Some(line) => {
      return utmp.user_on_line(utmp.default_path(), line);
    },
    None => {
      return None;
    }
  }
}

pub function main(): i32 {
  let operands: string[] = gnu.parse_standard_options_only(args(), "logname", help_text(), 1);
  if (operands.len() > 0) {
    gnu.die_usage("extra operand " + gnu.quote(operands[0]), 1);
  }
  match (login_name()) {
    Some(name) => {
      gnu.write_out(name + "\n");
      return 0;
    },
    None => {
      gnu.error("no login name");
      return 1;
    }
  }
}
