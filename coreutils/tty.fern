import "std/string";
import "./lib/gnu";
import "./lib/tty";

function opt_silent(): i32 {
  return 1;
}

function usage_status(): i32 {
  return 2;
}

function write_status(): i32 {
  return 3;
}

function help_text(): string {
  let out: string = "";
  out = out + "Usage: " + gnu.prog() + " [OPTION]...\n";
  out = out + "Print the file name of the terminal connected to standard input.\n";
  out = out + "\n";
  out = out + "  -s, --silent, --quiet   print nothing, only return an exit status\n";
  out = out + "      --help        display this help and exit\n";
  out = out + "      --version     output version information and exit\n";
  return out;
}

pub function main(): i32 {
  let opts: gnu.Opt[] = [];
  opts = opts.append(gnu.flag("s", "silent", opt_silent()));
  opts = opts.append(gnu.flag("", "quiet", opt_silent()));

  let silent: boolean = false;
  let g: gnu.Getopt = gnu.getopt_new(args(), opts, "tty", help_text(), usage_status()).exit_failure(write_status());
  while (true) {
    let res: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = res.1;
    match (res.0) {
      Some(_) => {
        silent = true;
      },
      None => {
        break;
      }
    }
  }

  let operands: string[] = g.operands();
  if (operands.len() > 0) {
    gnu.die_usage("extra operand " + gnu.quote(operands[0]), usage_status());
  }

  if (silent) {
    if (isatty(0)) {
      return 0;
    }
    return 1;
  }
  match (tty.name_of_stdin()) {
    Some(name) => {
      gnu.write_out_with(name + "\n", write_status());
      return 0;
    },
    None => {
      if (isatty(0)) {
        gnu.error("ttyname error");
        return 4;
      }
      gnu.write_out_with("not a tty\n", write_status());
      return 1;
    }
  }
  return 1;
}
