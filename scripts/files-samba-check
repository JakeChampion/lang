#!/usr/bin/env bash
# Runs examples/android/files/smb_live.fern against Samba with each set of
# dialects and signature rules that the SMB client of the app has code for.
# scripts/files-samba-serve starts each server, and needs smbd, pdbedit and
# root. CI runs this script with sudo (.github/workflows/android.yml).
#
# usage: scripts/files-samba-check [FERN]
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
fern=${1:-$root/bin/fern}
port=${FILES_SMB_PORT:-44450}
user=fernfiles
password=live-check-1

serve="$root/scripts/files-samba-serve"
export FILES_SMB_USER=$user FILES_SMB_PASSWORD=$password
work=$(mktemp -d)
trap '"$serve" stop "$work"; rm -rf "$work"' EXIT
mkdir -p "$work/share"

"$fern" -stdlib "$root/internal/stdlib" -o "$work/live" "$root/examples/android/files/smb_live.fern"
"$fern" -stdlib "$root/internal/stdlib" -o "$work/stream" "$root/examples/android/files/stream_live.fern"

failed=0
check() {
  local name=$1 options=$2
  "$serve" start "$work" "$port" "$options"
  echo "== $name"
  if FILES_SMB_SERVER="127.0.0.1 $port share $user $password" "$work/live" > "$work/out.txt" 2>&1 && grep -q '^# fail 0' "$work/out.txt"; then
    grep '^# pass' "$work/out.txt"
  else
    cat "$work/out.txt"
    failed=1
  fi
}

check "default: 3.1.1 with AES-128-GCM" ""

# The HTTP server of the app gives a player the parts of a file of the
# share: the whole file, a range in the middle that is more than one read,
# and the last bytes.
echo "== a stream of a file of the share"
head -c 9000000 /dev/urandom > "$work/share/film.mkv"
stream_port=$((port + 1))
FILES_SMB_SERVER="127.0.0.1 $port share $user $password" FILES_STREAM="film.mkv 9000000 tok $stream_port" "$work/stream" > "$work/stream.txt" 2>&1 &
for _ in $(seq 1 50); do
  (exec 3<> "/dev/tcp/127.0.0.1/$stream_port") 2> /dev/null && break
  sleep 0.2
done
url="http://127.0.0.1:$stream_port/tok/film.mkv"
ranged() {
  curl -sS -r "$1" -o "$work/part" -w '%{http_code}' "$url"
}
streamed=1
[ "$(curl -sS -o "$work/whole" -w '%{http_code}' "$url")" = 200 ] && cmp -s "$work/whole" "$work/share/film.mkv" || streamed=0
[ "$(ranged 1000000-6999999)" = 206 ] && cmp -s "$work/part" <(tail -c +1000001 "$work/share/film.mkv" | head -c 6000000) || streamed=0
[ "$(ranged -4096)" = 206 ] && cmp -s "$work/part" <(tail -c 4096 "$work/share/film.mkv") || streamed=0
[ "$(curl -sS -o /dev/null -w '%{http_code}' "http://127.0.0.1:$stream_port/other/film.mkv")" = 404 ] || streamed=0
curl -sS -m 3 -o /dev/null "http://127.0.0.1:$stream_port/tok/stop" 2> /dev/null || true
rm -f "$work/share/film.mkv"
if [ "$streamed" = 1 ]; then
  echo "# pass 4"
else
  cat "$work/stream.txt"
  echo "the stream gave other bytes than the file"
  failed=1
fi
check "3.1.1, encryption required" "  server min protocol = SMB3_11
  smb encrypt = required"
check "3.1.1, signatures required, no encryption" "  server min protocol = SMB3_11
  smb encrypt = off
  server signing = mandatory"
check "3.0.2, signatures required: AES-CMAC" "  server max protocol = SMB3_02
  server signing = mandatory"
check "3.0, signatures required: AES-CMAC" "  server max protocol = SMB3_00
  server signing = mandatory"
check "2.1, signatures required: HMAC-SHA256" "  server max protocol = SMB2_10
  server signing = mandatory"
check "2.0.2 only, signatures required" "  server max protocol = SMB2_02
  server signing = mandatory"
exit "$failed"
