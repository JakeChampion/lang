#!/usr/bin/env bash
# net-quic-interop — std/quic's connection against aioquic, an independent
# QUIC implementation (docs/NET-P8-HTTP3-PLAN.md): the Fern client of
# scripts/net-quic-interop.d/client.fern, built by bin/fern for the host,
# handshakes with an aioquic server, plainly, through a Retry, and on
# ChaCha20-Poly1305 alone; then aioquic's client handshakes with the Fern
# server of scripts/net-quic-interop.d/server.fern, plainly and on
# ChaCha20-Poly1305 alone, and has a PING acknowledged. In each case the
# client sends $SIZE bytes on a stream, the server sends them back as they
# arrive, and the client checks them; each side closes with an application
# close the other must report.
#
# Then HTTP/3 (std/http/h3q) each way against aioquic's own HTTP/3
# (aioquic.h3): a GET and a POST of $SIZE bytes on one connection, each
# answered with a body naming the request and a trailer, which the client
# checks; aioquic's client moves to a connection ID the Fern server issued
# between the two. Then std/fetch against aioquic's HTTP/3 server
# (scripts/net-quic-interop.d/fetch_h3.fern): the pool told the origin
# offers HTTP/3, two GETs ride one QUIC connection the pool keeps, and the
# POST dials a connection of its own, as a POST does over TCP. A last GET
# dials a new connection after the pool closes its kept ones.
#
# Then std/fetch against h2o's HTTP/3 server, which runs quicly, a second
# QUIC implementation, built by scripts/net-bench.d/h3tools at its pins. The
# last GET resumes the session with a ticket h2o issued and goes in 0-RTT,
# and h2o's access log records both.
#
# Usage: net-quic-interop
#
# aioquic and its dependencies are pinned in
# scripts/net-quic-interop.d/requirements.txt and installed in a venv under
# $FERN_QUIC_TOOLS (default ~/.cache/fern-quic-interop), keyed by the pins'
# hash so a changed pin builds a fresh one.
set -euo pipefail
cd "$(dirname "$0")/.."
for tool in openssl python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "net-quic-interop: $tool not found" >&2
    exit 2
  fi
done
. scripts/net-lib

d=scripts/net-quic-interop.d
tools="${FERN_QUIC_TOOLS:-$HOME/.cache/fern-quic-interop}"
venv="$tools/venv-$(sha256sum "$d/requirements.txt" | cut -c1-16)"
if [ ! -x "$venv/bin/python" ]; then
  echo "net-quic-interop: installing aioquic and its dependencies" >&2
  mkdir -p "$tools"
  python3 -m venv "$venv"
  "$venv/bin/pip" install --quiet --require-virtualenv -r "$d/requirements.txt"
fi

# Larger than every window either side starts with, so flow control has to
# open them again.
SIZE=300000

certs="$work/certs"
mkdir -p "$certs"
tls_certificate ca prime256v1 "/CN=fern quic interop CA" "" "basicConstraints=critical,CA:TRUE" "keyUsage=critical,keyCertSign"
tls_certificate leaf prime256v1 "/CN=localhost" ca "subjectAltName=DNS:localhost" "basicConstraints=critical,CA:FALSE"

bin/fern -target "$TARGET" -o "$work/client" "$d/client.fern"
bin/fern -target "$TARGET" -o "$work/server" "$d/server.fern"
bin/fern -target "$TARGET" -o "$work/h3_client" "$d/h3_client.fern"
bin/fern -target "$TARGET" -o "$work/h3_server" "$d/h3_server.fern"
bin/fern -target "$TARGET" -o "$work/fetch_h3" "$d/fetch_h3.fern"
h3tools="$(scripts/net-bench.d/h3tools)"

# await_line LOG TEXT — once LOG holds TEXT, or the run fails with LOG.
await_line() {
  local tries=0
  until grep -qF "$2" "$1" 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -ge 100 ]; then
      echo "net-quic-interop: no \"$2\" in $1" >&2
      cat "$1" >&2
      exit 1
    fi
    sleep 0.1
  done
}

failed=0
# expect NAME LOG TEXT... — the case passes when LOG holds every TEXT.
expect() {
  local name="$1" log="$2"
  shift 2
  local text
  for text in "$@"; do
    if ! grep -qF "$text" "$log"; then
      echo "FAIL $name: no \"$text\""
      sed 's/^/     /' "$log"
      failed=1
      return
    fi
  done
  echo "ok   $name"
  sed 's/^/     /' "$log"
}

# fern_client MODE — the Fern client against an aioquic server in MODE.
fern_client() {
  local mode="$1" port log="$work/fern-client-$1.log"
  port="$(free_port)"
  start_server "$work/aioquic-server-$mode.log" "$venv/bin/python" "$d/aioquic_server.py" "$port" "$certs/leaf.pem" "$certs/leaf.key" "$mode"
  await_line "$work/aioquic-server-$mode.log" "aioquic server: listening"
  "$work/client" "$port" localhost "$certs/ca.pem" "$SIZE" > "$log" 2>&1 || echo "fern client: exit $?" >> "$log"
  sleep 0.5
  stop_server
  cat "$work/aioquic-server-$mode.log" >> "$log"
  expect "fern client, aioquic server ($mode)" "$log" "fern client: connected alpn=fern-echo" "aioquic server: handshake completed alpn=fern-echo" "fern client: echo of $SIZE bytes matches" "aioquic server: terminated code=0 reason='fern done'"
}

# aioquic_client MODE — aioquic's client against the Fern server, the
# client offering MODE's cipher suites.
aioquic_client() {
  local mode="$1" port log="$work/aioquic-client-$1.log"
  port="$(free_port)"
  start_server "$work/fern-server-$mode.log" "$work/server" "$port" "$certs/leaf.pem" "$certs/leaf.key"
  await_line "$work/fern-server-$mode.log" "fern server: listening"
  "$venv/bin/python" "$d/aioquic_client.py" "$port" "$certs/ca.pem" "$mode" "$SIZE" > "$log" 2>&1 || echo "aioquic client: exit $?" >> "$log"
  await_line "$work/fern-server-$mode.log" "fern server: closed"
  stop_server
  cat "$work/fern-server-$mode.log" >> "$log"
  expect "aioquic client, fern server ($mode)" "$log" "aioquic client: connected alpn=fern-echo" "aioquic client: echo of $SIZE bytes matches" "aioquic client: ping answered" "fern server: connected alpn=fern-echo" "fern server: echoed stream 0 to its end" "fern server: closed code=0 remote=true reason=aioquic done"
}

# fern_h3_client — the Fern HTTP/3 client against aioquic's HTTP/3 server.
fern_h3_client() {
  local port log="$work/fern-h3-client.log"
  port="$(free_port)"
  start_server "$work/aioquic-h3-server.log" "$venv/bin/python" "$d/aioquic_h3_server.py" "$port" "$certs/leaf.pem" "$certs/leaf.key"
  await_line "$work/aioquic-h3-server.log" "aioquic h3 server: listening"
  "$work/h3_client" "$port" localhost "$certs/ca.pem" "$SIZE" > "$log" 2>&1 || echo "fern h3 client: exit $?" >> "$log"
  sleep 0.5
  stop_server
  cat "$work/aioquic-h3-server.log" >> "$log"
  expect "fern h3 client, aioquic h3 server" "$log" "fern h3 client: stream 0 -> 200 GET /hello 0 | x-served-by=aioquic" "fern h3 client: stream 4 -> 200 POST /upload $SIZE | x-served-by=aioquic"
}

# aioquic_h3_client MODE — aioquic's HTTP/3 client against the Fern HTTP/3
# server: plainly, or through the Retry the server sends every new client in
# retry mode, whose token aioquic echoes in its next Initial.
aioquic_h3_client() {
  local mode="$1" port log="$work/aioquic-h3-client-$1.log"
  port="$(free_port)"
  start_server "$work/fern-h3-server-$mode.log" "$work/h3_server" "$port" "$certs/leaf.pem" "$certs/leaf.key" "$mode"
  await_line "$work/fern-h3-server-$mode.log" "fern h3 server: listening"
  "$venv/bin/python" "$d/aioquic_h3_client.py" "$port" "$certs/ca.pem" "$SIZE" > "$log" 2>&1 || echo "aioquic h3 client: exit $?" >> "$log"
  await_line "$work/fern-h3-server-$mode.log" "fern h3 server: ended"
  stop_server
  cat "$work/fern-h3-server-$mode.log" >> "$log"
  local -a through=()
  if [ "$mode" = retry ]; then
    through=("fern h3 server: retry sent" "fern h3 server: token accepted")
  fi
  expect "aioquic h3 client, fern h3 server ($mode)" "$log" "aioquic h3 client: GET /hello -> 200 GET /hello 0 | x-served-by=fern" "aioquic h3 client: changed connection id: True" "aioquic h3 client: POST /upload -> 200 POST /upload $SIZE | x-served-by=fern" "fern h3 server: ended code=256 remote=true" "${through[@]}"
}

# fern_fetch — std/fetch over HTTP/3 against aioquic's HTTP/3 server.
fern_fetch() {
  local port log="$work/fern-fetch.log"
  port="$(free_port)"
  start_server "$work/aioquic-h3-server-fetch.log" "$venv/bin/python" "$d/aioquic_h3_server.py" "$port" "$certs/leaf.pem" "$certs/leaf.key"
  await_line "$work/aioquic-h3-server-fetch.log" "aioquic h3 server: listening"
  "$work/fetch_h3" "$port" localhost "$certs/ca.pem" "$SIZE" > "$log" 2>&1 || echo "fern fetch: exit $?" >> "$log"
  sleep 0.5
  stop_server
  cat "$work/aioquic-h3-server-fetch.log" >> "$log"
  expect "fern fetch, aioquic h3 server" "$log" "fern fetch: GET /hello -> 200 GET /hello 0 | x-served-by=aioquic" "fern fetch: GET /hello again -> 200 GET /hello 0 | x-served-by=aioquic" "fern fetch: POST /upload -> 200 POST /upload $SIZE | x-served-by=aioquic" "fern fetch: h3 connections kept 2" "fern fetch: GET /hello resumed -> 200 GET /hello 0 | x-served-by=aioquic"
}

# fern_fetch_h2o — std/fetch over HTTP/3 against h2o's HTTP/3 server.
fern_fetch_h2o() {
  local port log="$work/fern-fetch-h2o.log" access="$work/h2o-access.log"
  port="$(free_port)"
  printf 'h2o hello' > "$work/h2o-hello.txt"
  rm -f "$access"
  cat > "$work/h2o.conf" <<CONF
listen: &tls
  host: 127.0.0.1
  port: $port
  ssl:
    certificate-file: $certs/leaf.pem
    key-file: $certs/leaf.key
    min-version: TLSv1.3
listen:
  <<: *tls
  type: quic
num-threads: 1
access-log:
  path: $access
  format: "h2o: %m %U %s session-reused=%{ssl.session-reused}x %{http3.quic-stats}x"
hosts:
  default:
    paths:
      /:
        file.file: $work/h2o-hello.txt
CONF
  start_server "$work/h2o-server.log" "$h3tools/bin/h2o" -c "$work/h2o.conf"
  await_port h2o "$port" "$work/h2o-server.log"
  "$work/fetch_h3" "$port" localhost "$certs/ca.pem" "$SIZE" > "$log" 2>&1 || echo "fern fetch: exit $?" >> "$log"
  sleep 0.5
  stop_server
  # Each access-log line, cut to whether the session resumed and whether
  # any 0-RTT packet arrived on its connection.
  sed -E -e 's/ num-packets\.received=.*num-packets\.zero-rtt-received=0,.*/ early-data=no/' \
    -e 's/ num-packets\.received=.*num-packets\.zero-rtt-received=[1-9][0-9]*,.*/ early-data=yes/' "$access" >> "$log" 2>/dev/null || true
  # The POST gets 405, as h2o's file handler takes no POST, after its body
  # of $SIZE bytes went over QUIC.
  expect "fern fetch, h2o h3 server" "$log" "fern fetch: GET /hello -> 200 h2o hello |" "fern fetch: GET /hello again -> 200 h2o hello |" "fern fetch: POST /upload -> 405 method not allowed |" "fern fetch: h3 connections kept 2" "fern fetch: GET /hello resumed -> 200 h2o hello |" "h2o: GET /hello 200 session-reused=0 early-data=no" "h2o: GET /hello 200 session-reused=1 early-data=yes"
}

echo "== aioquic $("$venv/bin/python" -c 'import aioquic; print(aioquic.__version__)'), $ARCH"
fern_client plain
fern_client retry
fern_client chacha20
aioquic_client plain
aioquic_client chacha20
fern_h3_client
aioquic_h3_client plain
aioquic_h3_client retry
fern_fetch
fern_fetch_h2o
if [ "$failed" -ne 0 ]; then
  echo "net-quic-interop: a case failed" >&2
  exit 1
fi
