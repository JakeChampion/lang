// The Fern server scripts/net-interop drives with curl and h2load: it
// answers every request with the length and text of the body it read, so
// an upload sent chunked or behind `Expect: 100-continue` shows whether
// it arrived whole.
import "std/http";
import "std/tcp";
import "core/int";

function handle(req: HttpRequest, plat: Platform): HttpResponse {
  match (req.body_string()) {
    Ok(text) => {
      return http.ok("len=" + int.int_to_string(text.len()) + " " + text);
    },
    Err(e) => {
      return http.ok("len=" + int.int_to_string(req.body_len()) + " <not text>");
    }
  }
  return http.ok("");
}

function port(): i32 {
  match (env("PORT")) {
    Some(p) => {
      match (int.parse_int_radix(p, 10)) {
        Some(n) => {
          return n;
        },
        None => {
          return 8080;
        }
      }
    },
    None => {
      return 8080;
    }
  }
  return 8080;
}

function main(): i32 {
  return tcp.tcp_serve_supervised_opts(port(), tcp.serve_options(), handle);
}
