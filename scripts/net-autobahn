#!/usr/bin/env bash
# net-autobahn — the Autobahn WebSocket test suite against the Fern server
# (docs/NET-P5-FRAMEWORK-PLAN.md §4, #9859): every case of the suite's
# fuzzing client, RFC 6455 framing and permessage-deflate, against
# scripts/net-autobahn.d/server.fern built by bin/fern for the host.
#
# Usage: net-autobahn [REPORT] [CASE...]
#
#   REPORT  where the summary goes ("-" or nothing for stdout).
#   CASE    a case spec as the suite spells it ("1.*", "9.1.1"); the
#           default is every section, run in groups (see below).
#
# The suite runs from its Docker image, pinned by digest below, on the
# host's network so it reaches the server on loopback; docker is
# required, and a missing one fails the run rather than skipping it. A
# case whose behavior the report calls anything but OK, INFORMATIONAL or
# NON-STRICT fails the script, and so does one whose close handling it
# calls anything but OK or INFORMATIONAL; NON-STRICT is the suite's name
# for a fail-fast UTF-8 check, which the server makes. The suite's own
# reports are left under $FERN_AUTOBAHN_OUT when it is set.
set -euo pipefail
cd "$(dirname "$0")/.."
for tool in docker python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "net-autobahn: $tool not found" >&2
    exit 2
  fi
done
. scripts/net-lib

IMAGE=crossbario/autobahn-testsuite@sha256:519915fb568b04c9383f70a1c405ae3ff44ab9e35835b085239c258b6fac3074
report="${1:--}"
shift || true
out="${FERN_AUTOBAHN_OUT:-$work/autobahn}"
mkdir -p "$out/config" "$out/reports"
chmod 777 "$out/reports"
# Every section by default, in groups, each run by a wstest process of its
# own: the conformance sections (1-8, 10) together, then the performance
# section (9), then each subsection of the compression sections (12, 13).
# The Autobahn client is PyPy, whose zlib objects hold native memory its
# collector does not count, so every compressor or decompressor the client
# makes stays resident until the process exits: about 60 KB for each
# message the server asks it not to carry context across, and section 13
# asks that of every server it offers to. One process running the whole
# suite grows past 10 GB through the compression sections and slows to a
# crawl that reads as a stall (#12136); a process per group starts each
# with an empty heap. Every group runs against the one server. Pass case
# specs to run those alone, as one group, e.g. `net-autobahn - "13.*"`.
groups=('["1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "10.*"]' '["9.*"]')
for sub in 12.1 12.2 12.3 12.4 12.5 13.1 13.2 13.3 13.4 13.5 13.6 13.7; do
  groups+=("[\"$sub.*\"]")
done
if [ $# -gt 0 ]; then
  groups=("$(printf '%s\n' "$@" | python3 -c 'import json, sys; print(json.dumps(sys.stdin.read().split()))')")
fi
port="$(free_port)"
bin/fern -target "$TARGET" -o "$work/server" scripts/net-autobahn.d/server.fern
PORT="$port" start_server "$work/server.log" "$work/server"
await_server fern "$port" "$work/server.log"
n=0
for cases in "${groups[@]}"; do
  n=$((n + 1))
  mkdir -p "$out/reports/$n"
  chmod 777 "$out/reports/$n"
  cat > "$out/config/fuzzingclient.json" <<JSON
{
  "outdir": "/reports/$n",
  "servers": [{"agent": "fern", "url": "ws://127.0.0.1:$port/ws"}],
  "cases": $cases,
  "exclude-cases": [],
  "exclude-agent-cases": {}
}
JSON
  echo "== autobahn fuzzingclient, cases $cases, server on port $port"
  # Bounded so a hang fails the job rather than burning it; unbuffered so
  # the log names the case that is running, not one the buffer held back.
  timeout 900 docker run --rm --network host -e PYTHONUNBUFFERED=1 -v "$out/config:/config:ro" -v "$out/reports:/reports" "$IMAGE" wstest -m fuzzingclient -s /config/fuzzingclient.json > "$out/wstest-$n.log" 2>&1 || {
    tail -20 "$out/wstest-$n.log" >&2
    echo "net-autobahn: wstest failed on $cases" >&2
    exit 1
  }
done
python3 - "$out/reports" "$report" "$ARCH" "$TARGET" <<'PY'
import glob, json, sys
reports, report, arch, target = sys.argv[1:5]
results = {}
for index in glob.glob(reports + "/*/index.json"):
    results.update(json.load(open(index))["fern"])
bad = []
counts = {}
for case in sorted(results, key=lambda c: [int(p) for p in c.split(".")]):
    r = results[case]
    counts[r["behavior"]] = counts.get(r["behavior"], 0) + 1
    if r["behavior"] not in ("OK", "INFORMATIONAL", "NON-STRICT") or r["behaviorClose"] not in ("OK", "INFORMATIONAL"):
        bad.append("%s: %s / close %s" % (case, r["behavior"], r["behaviorClose"]))
lines = ["# scripts/net-autobahn report — arch %s, target %s" % (arch, target),
         "cases %d: %s" % (len(results), ", ".join("%s %d" % kv for kv in sorted(counts.items()))),
         "not passing %d" % len(bad)] + ["  " + b for b in bad]
text = "\n".join(lines) + "\n"
if report == "-":
    sys.stdout.write(text)
else:
    open(report, "w").write(text)
    sys.stdout.write(text)
sys.exit(1 if bad else 0)
PY
