#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [ -n "${FERN:-}" ]; then
  fern_audio_compiler=$FERN
else
  make bin/fern-selfhost
  fern_audio_compiler="$PWD/bin/fern-selfhost"
fi
case "$(uname -sm)" in
  'Linux x86_64') target=x86-64-linux ;;
  'Linux aarch64') target=arm64-linux ;;
  'Darwin arm64') target=arm64-darwin ;;
  *) echo 'unsupported host' >&2; exit 1 ;;
esac
mkdir -p build/audio
for suite in alac alac_boundary alac_smoke vorbis_file vorbis_file_boundary vorbis_file_smoke vorbis_input vorbis_input_smoke vorbis vorbis_boundary vorbis_codebook vorbis_kernel vorbis_smoke mp4 mp4_boundary mp4_smoke aac aac_boundary aac_kernel aac_smoke audio audio_source audio_ogg opus mp3 mp3_file mp3_file_smoke mp3_input mp3_input_smoke mp3_seek mp3_seek_smoke flac_seek flac_file flac_file_smoke flac_input flac_input_smoke opus_silk_math opus_silk_predict opus_silk_entropy opus_silk opus_silk_resample opus_silk_output opus_silk_loss opus_silk_recovery opus_silk_fec opus_playback opus_celt opus_mdct opus_vq opus_bands opus_celt_encoder opus_celt_frame opus_band_analysis opus_delimited opus_headers opus_multistream opus_multistream_smoke opus_file opus_file_smoke opus_seek opus_seek_smoke opus_timing opus_input opus_input_smoke; do
  source="tests/stdlib/${suite}_test.fern"
  "$fern_audio_compiler" -stdlib internal/stdlib -check "$source"
  "$fern_audio_compiler" -stdlib internal/stdlib -target "$target" -sanitize -o "build/audio/$suite" "$source"
  "build/audio/$suite"
  "$fern_audio_compiler" -stdlib internal/stdlib -target wasm32-wasi -o "build/audio/$suite.wasm" "$source"
  wasmtime run "build/audio/$suite.wasm"
  "$fern_audio_compiler" -stdlib internal/stdlib -target arm64-android -shared -export main -o "build/audio/$suite.so" "$source"
 done
