#!/usr/bin/env python3
"""Compare native AV1 MP4 ranges with FFprobe, CBS, libaom, and dav1d."""
import importlib.util
import os
import struct
from fractions import Fraction
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
spec = importlib.util.spec_from_file_location('mp4_av1', ROOT / 'scripts/gen-video-mp4-av1-fixtures.py')
fixtures = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fixtures)
compiler = os.environ.get('FERN') or subprocess.check_output(['./bootstrap/bootstrap.sh', 'stage0'], text=True).strip()
target = {'x86_64': 'x86-64-linux', 'aarch64': 'arm64-linux', 'arm64': 'arm64-darwin'}[os.uname().machine]
outputs = {}
for name in ('av1-configuration', 'mp4-av1'):
    binary = ROOT / ('build/video/' + name + '-reference')
    wasm = binary.with_suffix('.wasm')
    native_flags = ['-sanitize', '-heap-limit', '16M'] if name == 'mp4-av1' else ['-sanitize']
    for output, architecture, flags in ((binary, target, native_flags), (wasm, 'wasm32-wasi', [])):
        subprocess.run([compiler, '-stdlib', str(ROOT / 'internal/stdlib'), '-target', architecture, *flags,
                        '-o', str(output), 'scripts/video-reference/' + name + '.fern'], check=True)
    outputs[name] = (binary, wasm)


def run(name, path, *arguments, error=None):
    binary, wasm = outputs[name]
    native = subprocess.run([str(binary), *arguments, str(path)], text=True, capture_output=True)
    wasi = subprocess.run(['wasmtime', 'run', '--dir', '.', str(wasm), *arguments, path.name],
                          cwd=path.parent, text=True, capture_output=True)
    assert native.returncode == (3 if error else 0), (path.name, native)
    assert wasi.returncode == (1 if error else 0), (path.name, wasi)
    assert 'live_bytes=0' in native.stderr and 'fern-sanitizer:' not in native.stderr, native.stderr
    assert native.stdout == wasi.stdout, path.name
    if error:
        assert native.stderr.splitlines()[0] == wasi.stderr.splitlines()[0] == error
    return native.stdout.splitlines()


def decode(path, decoder, pixel_format):
    return subprocess.check_output(['ffmpeg', '-v', 'error', '-xerror', '-c:v', decoder, '-i', str(path),
                                    '-pix_fmt', pixel_format, '-fps_mode', 'passthrough', '-f', 'rawvideo', '-'])


with tempfile.TemporaryDirectory() as temporary:
    directory = Path(temporary)
    configurations, files = fixtures.generate(directory)
    for name, data, expected in configurations:
        path = directory / (name + '.av1c')
        path.write_bytes(data)
        assert list(map(int, run('av1-configuration', path))) == expected, name
        print('CBS configuration native/WASI:', name)
    for name, path, config, metadata in files:
        lines = run('mp4-av1', path, 'complete')
        assert lines == run('mp4-av1', path, 'file'), name
        sparse = directory / (name + '-sparse.mp4')
        sparse_metadata = fixtures.mp4.sparse_media(path, sparse)
        sparse_lines = run('mp4-av1', sparse, 'file')
        assert sparse_lines[:2] == lines[:2]
        for wide, small, packet in zip(sparse_lines[2:], lines[2:], sparse_metadata['packets'], strict=True):
            assert wide.split()[2:] == small.split()[2:]
            assert int(wide.split()[1]) == int(packet['pos']) > 4294967295
            assert list(map(int, wide.split()[1:6])) == [int(packet[k]) for k in ('pos', 'size', 'dts', 'pts', 'duration')]
            assert wide.split()[6] == str('K' in packet['flags']).lower()
        stream = metadata['streams'][0]
        assert lines[0] == f'T {stream["time_base"].split("/")[1]} 64 36'
        assert lines[1] == 'C ' + config.hex()
        extracted = []
        original = path.read_bytes()
        assert len(lines[2:]) == len(metadata['packets']) == 3
        for line, packet in zip(lines[2:], metadata['packets']):
            _, offset, size, dts, pts, duration, sync, payload = line.split()
            assert [int(offset), int(size), int(dts), int(pts), int(duration)] == [int(packet[k]) for k in ('pos', 'size', 'dts', 'pts', 'duration')]
            assert sync == str('K' in packet['flags']).lower()
            data = bytes.fromhex(payload)
            assert data == original[int(offset):int(offset) + int(size)]
            rate, scale = struct.unpack_from('<II', (directory / (name + '.ivf')).read_bytes(), 16)
            timestamp = Fraction(int(pts), int(stream['time_base'].split('/')[1])) * rate / scale
            assert timestamp.denominator == 1
            extracted.append((int(timestamp), data))
        carrier = directory / (name + '.ivf')
        restored = directory / (name + '-extracted.ivf')
        restored.write_bytes(fixtures.sequences.packets.ivf(carrier.read_bytes(), extracted))
        bytes_per_sample = 2 if '10' in name or '12' in name else 1
        pixels = 64 * 36
        samples = pixels * (3 if '444' in name else 2 if '422' in name else 3 / 2)
        decoded = []
        for decoder in ('libaom-av1', 'libdav1d'):
            reference = decode(path, decoder, name)
            assert len(reference) == int(3 * samples * bytes_per_sample), name
            assert decode(restored, decoder, name) == reference
            assert decode(sparse, decoder, name) == reference
            decoded.append(reference)
        assert decoded[0] == decoded[1], name
        print('MP4 complete/file native/WASI packet bytes and all decoded planes:', name)
        print('Sparse co64 file: native/WASI packets above 4 GiB and both independent decoders:', name)
    good = configurations[0][1]
    for i, data in enumerate((bytes([1]) + good[1:], good[:3] + bytes([32]) + good[4:],
                              good[:1] + bytes([good[1] ^ 1]) + good[2:], good + good[4:])):
        path = directory / f'invalid-{i}.av1c'
        path.write_bytes(data)
        run('av1-configuration', path, error='invalid video header or packet')
    print('Four explicit native/WASI configuration refusals passed; no external rejection claim.')
