#!/usr/bin/env python3
"""Compare native HEVC access units with FFprobe packets and FFmpeg planes."""
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
compiler = os.environ.get("FERN") or subprocess.check_output(["./bootstrap/bootstrap.sh", "stage0"], text=True).strip()
binary = ROOT / "build/video/hevc-input-reference"
binary.parent.mkdir(parents=True, exist_ok=True)
target = {"x86_64": "x86-64-linux", "aarch64": "arm64-linux", "arm64": "arm64-darwin"}[os.uname().machine]
subprocess.run([compiler, "-stdlib", str(ROOT / "internal/stdlib"), "-target", target, "-sanitize", "-heap-limit", "16M",
                "-o", str(binary), "scripts/video-reference/hevc-input.fern"], check=True)
wasm = binary.with_suffix(".wasm")
subprocess.run([compiler, "-stdlib", str(ROOT / "internal/stdlib"), "-target", "wasm32-wasi", "-o", str(wasm),
                "scripts/video-reference/hevc-input.fern"], check=True)


def units(data):
    markers = list(re.finditer(b"\x00{2,}\x01", data))
    return [data[m.end():markers[i + 1].start() if i + 1 < len(markers) else len(data)].rstrip(b"\0")
            for i, m in enumerate(markers)]


def encode(directory, name, profile, pixel_format, options, size="64x48"):
    path = directory / f"{name}.hevc"
    params = "log-level=error:pools=none:frame-threads=1:keyint=6:min-keyint=6:scenecut=0:repeat-headers=1:" + options
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", f"testsrc2=size={size}:rate=25",
                    "-frames:v", "18", "-c:v", "libx265", "-preset", "ultrafast", "-threads", "1",
                    "-profile:v", profile, "-pix_fmt", pixel_format, "-x265-params", params, "-f", "hevc", str(path)], check=True)
    return path


def decoded(path):
    return subprocess.check_output(["ffmpeg", "-v", "error", "-i", str(path), "-vsync", "0",
                                    "-pix_fmt", "yuv444p16le", "-f", "rawvideo", "-"])


def picture_packets(packets, data):
    last = packets[-1]
    at, size = int(last["pos"]), int(last["size"])
    trailing = units(data[at:at + size])
    if all(unit[0] >> 1 & 63 >= 32 for unit in trailing):
        assert trailing == [b"\x48\x01", b"\x4a\x01"]
        assert len(packets) > 1 and at + size == len(data)
        previous = packets[-2]
        assert int(previous["pos"]) + int(previous["size"]) == at
        packets = packets[:-2] + [dict(previous, size=str(int(previous["size"]) + size))]
        print("EOS/EOB: FFprobe terminal control packet joins the prior picture; every byte remains", flush=True)
    return packets


def prefix_offset(data, at):
    for marker in re.finditer(b"\x00{2,}\x01", data):
        if marker.start() <= at < marker.end():
            assert data[marker.start():at] == b"\0" * (at - marker.start())
            assert data[at:marker.end()] in (b"\0\0\1", b"\0\0\0\1")
            return marker.start()
    raise AssertionError(f"FFprobe packet offset {at} does not identify a start prefix")


def compare(path, frames):
    data = path.read_bytes()
    metadata = json.loads(subprocess.check_output(["ffprobe", "-v", "error", "-show_packets", "-show_streams",
                                                  "-show_entries", "packet=pos,size,flags:stream=width,height", "-of", "json", str(path)]))
    native = subprocess.run([str(binary), str(path)], capture_output=True, text=True, check=True)
    wasi = subprocess.check_output(["wasmtime", "run", "--dir", ".", str(wasm), path.name],
                                   cwd=path.parent, text=True).splitlines()
    lines = native.stdout.splitlines()
    assert re.search(r"leakcheck: allocs=(\d+) frees=\1 live_bytes=0", native.stderr), native.stderr
    assert "fern-sanitizer:" not in native.stderr
    packets = picture_packets(metadata["packets"], data)
    assert lines == wasi and len(lines) == len(packets) == frames
    rebuilt = bytearray()
    for line, packet in zip(lines, packets, strict=True):
        tag, offset, irap, idr, payload = line.split()
        at, size = int(packet["pos"]), int(packet["size"])
        original = units(data[at:at + size])
        canonical = b"".join(b"\x00\x00\x00\x01" + unit for unit in original)
        kind = next(unit[0] >> 1 & 63 for unit in original if unit[0] >> 1 & 63 < 32)
        assert tag == "H" and int(offset) == prefix_offset(data, at) and bytes.fromhex(payload) == canonical
        assert int(irap) == int(16 <= kind <= 21) and int(idr) == int(kind in (19, 20))
        rebuilt += canonical
    restored = path.with_name("fern-" + path.name)
    restored.write_bytes(rebuilt)
    info = metadata["streams"][0]
    pixels = decoded(path)
    assert pixels == decoded(restored) and len(pixels) == frames * int(info["width"]) * int(info["height"]) * 6
    print(f"{path.name}: {frames} native/WASI access units match FFprobe; all FFmpeg planes match", flush=True)


def temporal_headers(path):
    trace = subprocess.run(["ffmpeg", "-v", "verbose", "-i", str(path), "-map", "0:v:0",
                            "-c", "copy", "-bsf:v", "trace_headers", "-f", "null", "-"],
                           capture_output=True, text=True)
    headers = re.findall(r"nal_unit_type\s+[01]+\s+=\s+(\d+).*?"
                         r"nuh_temporal_id_plus1\s+[01]+\s+=\s+(\d+)", trace.stderr, re.S)
    assert headers, trace.stderr[-3000:]
    return [(int(kind), int(temporal) - 1) for kind, temporal in headers]


def filtered_units(path, kinds):
    data = subprocess.check_output(["ffmpeg", "-v", "error", "-i", str(path), "-map", "0:v:0", "-c", "copy",
                                    "-bsf:v", f"filter_units=pass_types={kinds}", "-f", "hevc", "-"])
    return units(data)


def encoded_groups(groups):
    return b"".join(b"\0\0\0\1" + unit for group in groups for unit in group)


def check_temporal_headers(path, groups):
    expected = [(unit[0] >> 1 & 63, (unit[1] & 7) - 1) for group in groups for unit in group
                if unit[0] >> 1 & 63 < 32 or unit[0] >> 1 & 63 == 35]
    actual = [(kind, temporal) for kind, temporal in temporal_headers(path) if kind < 32 or kind == 35]
    assert actual == expected, (actual, expected)
    kinds = (32, 33, 34, 35, 38, 39, 40)
    expected_units = [unit for group in groups for unit in group if unit[0] >> 1 & 63 in kinds]
    assert filtered_units(path, "|".join(map(str, kinds))) == expected_units


def refuse(path, message="invalid video header or packet"):
    native = subprocess.run([str(binary), str(path)], capture_output=True, text=True)
    wasi = subprocess.run(["wasmtime", "run", "--dir", ".", str(wasm), path.name],
                          cwd=path.parent, capture_output=True, text=True)
    assert native.returncode == wasi.returncode == 1 and native.stdout == wasi.stdout
    assert message in native.stderr and message in wasi.stderr
    assert re.search(r"leakcheck: allocs=([1-9]\d*) frees=\1 live_bytes=0", native.stderr), native.stderr


def remaining_temporal(directory, groups, original):
    kind = lambda unit: unit[0] >> 1 & 63
    vcl = lambda group: next(unit for unit in group if kind(unit) < 32)
    picture_zero = next(i for i, group in enumerate(groups) if kind(vcl(group)) == 1 and vcl(group)[1] & 7 == 1)
    picture_one = next(i for i, group in enumerate(groups) if vcl(group)[1] & 7 == 2)
    sei = next(unit for group in groups for unit in group if kind(unit) == 39)
    sei_at = lambda nal_kind, temporal: bytes([nal_kind << 1, temporal + 1]) + sei[2:]
    higher = [list(group) for group in groups]
    higher[picture_zero].insert(1, sei_at(39, 1))
    higher[picture_zero].append(sei_at(40, 1))
    path = directory / "higher-sei-temporal.hevc"
    path.write_bytes(encoded_groups(higher))
    check_temporal_headers(path, higher)
    compare(path, 18)
    assert decoded(path) == decoded(original)
    controls = []
    for nal_kind in range(2, 6):
        changed = [list(group) for group in groups]
        changed[picture_zero] = [bytes([nal_kind << 1]) + unit[1:] if kind(unit) < 32 else unit
                                for unit in changed[picture_zero]]
        controls.append((f"tsa-stsa-{nal_kind}-zero", changed))
    for nal_kind in (32, 33, 34, 39):
        unit = next(unit for group in groups for unit in group if kind(unit) == nal_kind)
        changed = [list(group) for group in groups]
        changed[picture_one].insert(1, unit[:1] + b"\x01" + unit[2:])
        controls.append((f"prefix-{nal_kind}-below-picture", changed))
    changed = [list(group) for group in groups]
    changed[picture_one].append(sei_at(40, 0))
    controls.append(("suffix-sei-below-picture", changed))
    for name, changed in controls:
        path = directory / (name + ".hevc")
        path.write_bytes(encoded_groups(changed))
        check_temporal_headers(path, changed)
        refuse(path)
        print(f"{name}: independent headers match; native/WASI refusal follows H.265", flush=True)


def temporal_association(directory, original):
    data = original.read_bytes()
    metadata = json.loads(subprocess.check_output(["ffprobe", "-v", "error", "-show_packets", "-of", "json", str(original)]))
    groups, temporals = [], []
    for packet in metadata["packets"]:
        at, size = int(packet["pos"]), int(packet["size"])
        payload = [unit for unit in units(data[at:at + size]) if unit[0] >> 1 & 63 != 35]
        temporal = next((unit[1] & 7) - 1 for unit in payload if unit[0] >> 1 & 63 < 32)
        temporals.append(temporal)
        groups.append([bytes([70, temporal + 1, 0x50]), *payload, bytes([76, temporal + 1, 0xff, 0x80])])
    assert set(temporals) == {0, 1} and len(groups) == 18
    path = directory / "temporal-aud-filler.hevc"
    path.write_bytes(encoded_groups(groups))
    check_temporal_headers(path, groups)
    compare(path, 18)
    assert decoded(path) == decoded(original)
    for temporal in (0, 1):
        index = temporals.index(temporal)
        for position, kind in ((0, 35), (-1, 38)):
            for other in range(7):
                if other == temporal:
                    continue
                changed = [list(group) for group in groups]
                unit = changed[index][position]
                changed[index][position] = unit[:1] + bytes([other + 1]) + unit[2:]
                path = directory / f"invalid-temporal-{temporal}-{kind}-{other}.hevc"
                path.write_bytes(encoded_groups(changed))
                check_temporal_headers(path, changed)
                refuse(path)
                print(f"picture {temporal}, NAL {kind}, temporal {other}: independent headers match; native/WASI refusal follows H.265", flush=True)
    remaining_temporal(directory, groups, original)
    filler_payloads(directory, groups, original)


def filler_payloads(directory, groups, original):
    spec = importlib.util.spec_from_file_location("hevc_filler_vectors", ROOT / "scripts/gen-video-hevc-input-fixtures.py")
    fixtures = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(fixtures)
    lengths = (0, 31, 4095)
    valid = [group[:-1] + [group[-1][:2] + b"\xff" * lengths[i % len(lengths)] + b"\x80"]
             for i, group in enumerate(groups)]
    path = directory / "filler-payload-lengths.hevc"
    path.write_bytes(encoded_groups(valid))
    check_temporal_headers(path, valid)
    compare(path, 18)
    assert decoded(path) == decoded(original)
    for i, (name, payload, error) in enumerate(fixtures.filler_refusals()):
        changed = [list(group) for group in groups]
        changed[1][-1] = changed[1][-1][:2] + payload
        path = directory / f"invalid-filler-payload-{i}.hevc"
        path.write_bytes(encoded_groups(changed))
        check_temporal_headers(path, changed)
        message = "incomplete video packet" if error == "Truncated" else "invalid video header or packet"
        refuse(path, message)
        print(f"{name}: FFmpeg extraction matches. Native/WASI refusal follows H.265", flush=True)


def temporal_parameters(directory):
    original = encode(directory, "temporal-layers", "main", "yuv420p",
                      "bframes=3:b-pyramid=1:temporal-layers=2:aud=1")
    if not any(unit[0] >> 1 & 63 < 32 and unit[1] & 7 > 1 for unit in units(original.read_bytes())):
        # Older x265 versions use a boolean instead of a sublayer count.
        original = encode(directory, "temporal-layers", "main", "yuv420p",
                          "bframes=3:b-pyramid=1:temporal-layers=1:aud=1")
    rebuilt, picture_temporals = [], set()
    pending_aud, aud_changes = None, 0
    picture = None
    for unit in units(original.read_bytes()):
        kind = unit[0] >> 1 & 63
        if kind == 35:
            pending_aud = len(rebuilt)
        if kind == 34:
            picture = unit
        if kind < 32 and unit[2] & 0x80:
            assert picture is not None
            temporal = unit[1] & 7
            picture_temporals.add(temporal - 1)
            if pending_aud is not None:
                aud = rebuilt[pending_aud]
                aud_changes += int((aud[1] & 7) != temporal)
                rebuilt[pending_aud] = aud[:1] + bytes([(aud[1] & 0xf8) | temporal]) + aud[2:]
                pending_aud = None
            rebuilt.append(picture[:1] + bytes([(picture[1] & 0xf8) | temporal]) + picture[2:])
        rebuilt.append(unit)
    assert picture_temporals == {0, 1}, picture_temporals
    path = directory / "temporal-pps-replacement.hevc"
    path.write_bytes(b"".join(b"\0\0\0\1" + unit for unit in rebuilt))
    compare(path, 18)
    assert decoded(path) == decoded(original)
    trace = subprocess.run(["ffmpeg", "-v", "verbose", "-i", str(path), "-map", "0:v:0",
                            "-c", "copy", "-bsf:v", "trace_headers", "-f", "null", "-"],
                           capture_output=True, text=True, check=True)
    assert "Failed to read unit" not in trace.stderr and "out of range" not in trace.stderr
    headers = re.findall(r"nal_unit_type\s+[01]+\s+=\s+(\d+).*?"
                         r"nuh_temporal_id_plus1\s+[01]+\s+=\s+(\d+)", trace.stderr, re.S)
    pps_temporals = {int(temporal) - 1 for kind, temporal in headers if int(kind) == 34}
    assert pps_temporals == picture_temporals, pps_temporals
    aud = None
    for kind, temporal in headers:
        if int(kind) == 35:
            aud = int(temporal)
        elif int(kind) < 32 and aud is not None:
            assert aud == int(temporal)
            aud = None
    print(f"AUD header corrections to match coded pictures: {aud_changes}; original decoded planes remain exact", flush=True)
    print("PPS temporal layers 0/1: independent CBS headers and unchanged source planes agree", flush=True)
    temporal_association(directory, path)


def parameter_context(fixtures, oracle, mode):
    if mode == "syntax":
        return oracle.returncode == 0
    assert mode == "tile_grid" and oracle.returncode == 0, oracle.stderr.decode()
    fields = fixtures.hevc.syntax.references.trace_fields(oracle.stderr.decode())
    ctb = 1 << (3 + fields["log2_min_luma_coding_block_size_minus3"]
                + fields["log2_diff_max_min_luma_coding_block_size"])
    columns = (fields["pic_width_in_luma_samples"] + ctb - 1) // ctb
    return fields["num_tile_columns_minus1"] < columns


def parameter_reuse(directory):
    spec = importlib.util.spec_from_file_location("hevc_input_vectors", ROOT / "scripts/gen-video-hevc-input-fixtures.py")
    fixtures = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(fixtures)
    trace = fixtures.hevc.syntax.build_trace("HEVC", "hevc-input-parameter-trace")
    for index, (name, before, after, picture, mode) in enumerate(fixtures.incompatible_pairs()):
        for sequence, valid in ((before, True), (after, False)):
            pair = directory / "parameter-pair.bin"
            pair.write_bytes(fixtures.hevc.vps() + b"\0\0\1" + sequence + b"\0\0\1" + picture)
            oracle = subprocess.run([str(trace), str(pair)], capture_output=True)
            assert parameter_context(fixtures, oracle, mode) == valid, oracle.stderr.decode()
        path = directory / f"stale-pps-{index}.hevc"
        path.write_bytes(b"".join(b"\0\0\0\1" + unit for unit in
                                 (before, picture, fixtures.slice_nal(), after, fixtures.slice_nal())))
        native = subprocess.run([str(binary), str(path)], capture_output=True, text=True)
        wasi = subprocess.run(["wasmtime", "run", "--dir", ".", str(wasm), path.name],
                              cwd=directory, capture_output=True, text=True)
        assert native.returncode == wasi.returncode == 1
        assert native.stdout == wasi.stdout and len(native.stdout.splitlines()) == 1
        assert "invalid video header or packet" in native.stderr and "invalid video header or packet" in wasi.stderr
        assert re.search(r"leakcheck: allocs=(\d+) frees=\1 live_bytes=0", native.stderr), native.stderr
        detail = "FFmpeg syntax refusal" if mode == "syntax" else "tile-grid constraint from independent CBS fields"
        print(f"{name}: native/WASI refusal matches {detail}", flush=True)


with tempfile.TemporaryDirectory() as temporary:
    directory = Path(temporary)
    cases = [
        ("main", "main", "yuv420p", "bframes=0:aud=0"),
        ("cropped", "main", "yuv420p", "bframes=0:aud=0", "62x46"),
        ("main-slices", "main", "yuv420p", "bframes=0:aud=0:pools=1:wpp=1:slices=3:ctu=32", "128x128"),
        ("main-bframes", "main", "yuv420p", "bframes=2:aud=0"),
        ("main-aud", "main", "yuv420p", "bframes=0:aud=1"),
        ("main10", "main10", "yuv420p10le", "bframes=2:aud=0"),
        ("main12", "main12", "yuv420p12le", "bframes=0:aud=0"),
        ("main42210", "main422-10", "yuv422p10le", "bframes=0:aud=0"),
        ("main4448", "main444-8", "yuv444p", "bframes=0:aud=0"),
        ("open-gop", "main", "yuv420p", "bframes=2:open-gop=1:aud=0"),
    ]
    paths = [encode(directory, *case) for case in cases]
    for path in paths:
        compare(path, 18)
    ended = directory / "end-markers.hevc"
    ended.write_bytes(paths[0].read_bytes() + b"\0\0\0\1\x48\x01\0\0\0\1\x4a\x01")
    compare(ended, 18)
    joined = directory / "parameter-replacement.hevc"
    joined.write_bytes(paths[3].read_bytes() + paths[5].read_bytes())
    compare(joined, 36)
    parameter_reuse(directory)
    temporal_parameters(directory)
