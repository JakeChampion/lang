#!/usr/bin/env python3
"""Compare MP3 libraries with one compiler and matched C decode workloads."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import platform
import resource
import statistics
import struct
import subprocess

ROOT = Path(__file__).resolve().parent.parent


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def tree_hash(root):
    value = hashlib.sha256()
    for path in sorted(root.rglob('*')):
        if path.is_file():
            value.update(path.relative_to(root).as_posix().encode() + b'\0')
            value.update(path.read_bytes())
    return value.hexdigest()


def run(command, log):
    with log.open('w') as output:
        subprocess.run([str(part) for part in command], stdout=output,
                       stderr=subprocess.STDOUT, check=True, timeout=300)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--compiler', type=Path, required=True)
    parser.add_argument('--baseline-stdlib', type=Path, required=True)
    parser.add_argument('--candidate-stdlib', type=Path, default=ROOT / 'internal/stdlib')
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--rounds', type=int, default=20)
    parser.add_argument('--trials', type=int, default=7)
    args = parser.parse_args()
    assert args.rounds > 0 and args.trials >= 3
    assert platform.system() == 'Linux', 'peak RSS uses Linux /proc'
    target = {'x86_64': 'x86-64-linux', 'aarch64': 'arm64-linux'}[platform.machine()]
    work = args.output.resolve()
    work.mkdir(parents=True, exist_ok=True)
    spec = importlib.util.spec_from_file_location('vectors', ROOT / 'scripts/gen-mp3-vectors.py')
    vectors = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(vectors)
    vectors.reference(work)
    data = vectors.encoded(work, 48000, 2, values=vectors.signal(48000, 2, 48000))
    free = bytearray(data)
    for at, *_ in vectors.frame_offsets(data):
        assert free[at + 1] & 1, 'the matched input must have no CRC'
        free[at + 2] &= 15
    inputs = {'indexed': work / 'indexed.mp3', 'free': work / 'free.mp3'}
    inputs['indexed'].write_bytes(data)
    inputs['free'].write_bytes(free)
    binaries = {}
    libraries = {'baseline': args.baseline_stdlib.resolve(), 'candidate': args.candidate_stdlib.resolve()}
    for name, library in libraries.items():
        binary = work / name
        run([args.compiler.resolve(), '-stdlib', library, '-target', target,
             '-o', binary, ROOT / 'bench/audio/mp3_freeformat.fern'], work / (name + '-build.log'))
        binaries[name] = binary
    source = ROOT / 'scripts/audio-reference/mp3_freeformat_bench.c'
    for name, flags in [('scalar', []), ('simd', ['-DFERN_MP3_BENCH_SIMD'])]:
        binary = work / name
        run(['cc', '-O3', '-ffp-contract=off', *flags, '-I', work,
             source, '-o', binary], work / (name + '-build.log'))
        binaries[name] = binary
    rows = []
    pcm_hashes = {}
    for mode in ['whole', 'frames']:
        variants = [(name, kind) for kind in inputs for name in binaries
                    if name != 'baseline' or kind == 'indexed']
        for trial in range(args.trials):
            order = variants if trial % 2 == 0 else variants[::-1]
            for name, kind in order:
                pcm = work / f'{name}-{kind}-{mode}.f32'
                command = [str(binaries[name]), str(inputs[kind]), mode, str(args.rounds), str(pcm)]
                before = resource.getrusage(resource.RUSAGE_CHILDREN)
                result = subprocess.run(command, capture_output=True, text=True, check=True, timeout=300)
                after = resource.getrusage(resource.RUSAGE_CHILDREN)
                metrics = {key: int(value) for key, value in
                           (line.split('=', 1) for line in result.stdout.splitlines())}
                metrics.update(name=name, input=kind, mode=mode, trial=trial,
                               process_cpu_seconds=after.ru_utime + after.ru_stime - before.ru_utime - before.ru_stime)
                digest = sha(pcm)
                key = f'{name}-{kind}-{mode}'
                assert pcm_hashes.setdefault(key, digest) == digest
                rows.append(metrics)
                print(json.dumps(metrics), flush=True)
    comparisons = []
    for simd in [False, True]:
        assert len({(row['checksum'], row['samples']) for row in rows
                    if (row['name'] == 'simd') == simd}) == 1
    reference = (work / 'scalar-indexed-whole.f32').read_bytes()
    expected = struct.unpack('<' + 'f' * (len(reference) // 4), reference)
    for key, digest in pcm_hashes.items():
        raw = (work / (key + '.f32')).read_bytes()
        assert len(raw) == len(reference), key
        values = struct.unpack('<' + 'f' * (len(raw) // 4), raw)
        error = max(abs(a - b) for a, b in zip(values, expected))
        assert error < 0.00002, (key, error)
        if not key.startswith('simd-'):
            assert raw == reference, key
        group = [row for row in rows if key == f"{row['name']}-{row['input']}-{row['mode']}"]
        assert len({(row['checksum'], row['samples']) for row in group}) == 1
        comparisons.append({'variant': key, 'pcm_sha256': digest, 'max_absolute_error': error,
                            'medians': {metric: statistics.median(row[metric] for row in group)
                                        for metric in group[0] if metric not in ['name', 'input', 'mode', 'trial']}})
    report = {'machine': platform.platform(), 'cpu': Path('/proc/cpuinfo').read_text().splitlines()[4],
              'compiler_sha256': sha(args.compiler), 'target': target,
              'compiler_core_sha256': sha(args.compiler.with_name('fern-selfhost')),
              'library_sha256': {name: tree_hash(path) for name, path in libraries.items()},
              'reference_revision': vectors.tables.REV,
              'reference_headers': vectors.tables.SHA,
              'cc': subprocess.check_output(['cc', '--version'], text=True).splitlines()[0],
              'ffmpeg': subprocess.check_output(['ffmpeg', '-version'], text=True).splitlines()[0],
              'inputs': {name: sha(path) for name, path in inputs.items()},
              'binaries': {name: sha(path) for name, path in binaries.items()},
              'driver_sha256': sha(ROOT / 'bench/audio/mp3_freeformat.fern'),
              'script_sha256': sha(Path(__file__)),
              'c_driver_sha256': sha(source), 'rounds': args.rounds, 'trials': args.trials,
              'sample_rate': 48000, 'channels': 2,
              'cpu_scope': 'Process CPU includes two warmups, timed decode, and the final PCM dump.',
              'wall_scope': 'Timed decode includes a byte checksum of every float sample.',
              'rss_scope': 'Process VmHWM after timed decode and before the PCM dump.',
              'rows': rows, 'comparisons': comparisons}
    (work / 'results.json').write_text(json.dumps(report, indent=2) + '\n')


if __name__ == '__main__':
    main()
