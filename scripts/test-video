#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [ -n "${FERN:-}" ]; then
  fern_video_compiler=$FERN
else
  make bin/fern-selfhost
  fern_video_compiler="$PWD/bin/fern-selfhost"
fi
case "$(uname -sm)" in
  'Linux x86_64') target=x86-64-linux; android_target=x86-64-android ;;
  'Linux aarch64') target=arm64-linux; android_target=arm64-android ;;
  'Darwin arm64') target=arm64-darwin; android_target= ;;
  *) echo 'unsupported host' >&2; exit 1 ;;
esac
mkdir -p build/video
source=tests/stdlib/video_test.fern
"$fern_video_compiler" -check "$source" internal/stdlib
"$fern_video_compiler" -target "$target" -sanitize -o build/video/tests "$source" internal/stdlib
build/video/tests
"$fern_video_compiler" -target wasm32-wasi -o build/video/tests.wasm "$source" internal/stdlib
wasmtime run build/video/tests.wasm
"$fern_video_compiler" -target arm64-android -shared -export main -o build/video/tests.so "$source" internal/stdlib
"$fern_video_compiler" -target arm64-android -shared -export main -o build/video/android-api.so tests/stdlib/android_video_mock_test.fern internal/stdlib
if [ -n "$android_target" ]; then
  cc -shared -fPIC -Wall -Wextra -Werror -o build/video/libmediandk.so scripts/video-reference/mediandk-mock.c
  "$fern_video_compiler" -target "$android_target" -shared -export main -o build/video/android-mock.so tests/stdlib/android_video_mock_test.fern internal/stdlib
  LD_LIBRARY_PATH="$PWD/build/video${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" python3 - <<'PY'
import ctypes
library = ctypes.CDLL('./build/video/android-mock.so')
result = library.main()
if result != 0:
    raise SystemExit(f'Android MediaCodec ABI test failed at check {result}')
print('Android MediaCodec lifecycle and ABI checks passed')
PY
fi
