#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [ -n "${FERN:-}" ]; then
  fern_video_compiler=$FERN
else
  make bin/fern-selfhost
  fern_video_compiler="$PWD/bin/fern-selfhost"
fi
case "$(uname -sm)" in
  'Linux x86_64') target=x86-64-linux; android_target=x86-64-android ;;
  'Linux aarch64') target=arm64-linux; android_target=arm64-android ;;
  'Darwin arm64') target=arm64-darwin; android_target= ;;
  *) echo 'unsupported host' >&2; exit 1 ;;
esac
mkdir -p build/video
for suite in video video_avc video_avc_pps video_audio_clock video_hevc video_vp9 video_vp9_packet video_av1 video_av1_sequence video_annex_b video_annex_b_input video_annex_b_input_boundary video_ivf_input video_ivf_input_boundary video_mp4 video_mp4_boundary video_mp4_file video_mp4_file_boundary video_qtrle_mov android_video_policy android_video_source; do
  source="tests/stdlib/${suite}_test.fern"
  "$fern_video_compiler" -check "$source" internal/stdlib
  "$fern_video_compiler" -target "$target" -sanitize -o "build/video/${suite}-tests" "$source" internal/stdlib
  "build/video/${suite}-tests"
  "$fern_video_compiler" -target wasm32-wasi -o "build/video/${suite}-tests.wasm" "$source" internal/stdlib
  wasmtime run "build/video/${suite}-tests.wasm"
  "$fern_video_compiler" -target arm64-android -shared -export main -o "build/video/${suite}-tests.so" "$source" internal/stdlib
done
"$fern_video_compiler" -target arm64-android -shared -export main -o build/video/hardware-api.so tests/stdlib/android_video_hardware_mock_test.fern internal/stdlib
"$fern_video_compiler" -target arm64-android -shared -export main -o build/video/android-api.so tests/stdlib/android_video_mock_test.fern internal/stdlib
if [ -n "$android_target" ]; then
  mkdir -p build/video/audio
  cc -shared -fPIC -Wall -Wextra -Werror -o build/video/audio/libaaudio.so scripts/audio-reference/aaudio-mock.c
  scripts/libandroid-stubs scripts/video-reference/mediandk-mock.c scripts/video-reference/codec-jni-mock.c > build/video/stubs.c
  cc -shared -fPIC -Wall -Wextra -Werror -o build/video/libmediandk.so scripts/video-reference/mediandk-mock.c scripts/video-reference/codec-jni-mock.c build/video/stubs.c
  ln -sf libmediandk.so build/video/libandroid.so
  "$fern_video_compiler" -target "$android_target" -shared -export main -o build/video/android-mock.so tests/stdlib/android_video_mock_test.fern internal/stdlib
  "$fern_video_compiler" -target "$android_target" -shared -export main -o build/video/hardware-mock.so tests/stdlib/android_video_hardware_mock_test.fern internal/stdlib
  LD_LIBRARY_PATH="$PWD/build/video:$PWD/build/video/audio${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" python3 - <<'PY'
import ctypes
for name in ('android', 'hardware'):
    library = ctypes.CDLL(f'./build/video/{name}-mock.so')
    result = library.main()
    if result != 0:
        raise SystemExit(f'Android {name} ABI test failed at check {result}')
    print(f'Android {name} lifecycle and ABI checks passed')
PY
fi

# The AAudio anchor is a read-only prerequisite for later A/V synchronization.
"$fern_video_compiler" -target arm64-android -shared -export main -o build/video/audio-timestamp-api.so tests/stdlib/android_audio_timestamp_mock_test.fern internal/stdlib
if [ -n "$android_target" ]; then
  mkdir -p build/video/audio
  "$fern_video_compiler" -target "$android_target" -shared -export main -o build/video/audio/mock.so tests/stdlib/android_audio_timestamp_mock_test.fern internal/stdlib
  "$fern_video_compiler" -target "$android_target" -shared -sanitize -export main -o build/video/audio/mock-sanitize.so tests/stdlib/android_audio_timestamp_mock_test.fern internal/stdlib
  LD_LIBRARY_PATH="$PWD/build/video/audio${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" python3 - <<'PYTHON'
import ctypes
for name in ('mock', 'mock-sanitize'):
    result = ctypes.CDLL(f'./build/video/audio/{name}.so').main()
    if result != 0:
        raise SystemExit(f'Android audio timestamp test failed at check {result}')
print('Android audio timestamp clock, ABI, and unavailable-result checks passed')
PYTHON
fi
python3 -m unittest discover -s tests/android/audio -p test_emulator_check.py

# Audio anchors update the existing video scheduler without audio transport control.
"$fern_video_compiler" -target arm64-android -shared -export main -o build/video/video-audio-sync-api.so tests/stdlib/android_video_audio_mock_test.fern internal/stdlib
if [ -n "$android_target" ]; then
  for variant in normal sanitize; do
    flags=()
    if [ "$variant" = sanitize ]; then flags=(-sanitize); fi
    "$fern_video_compiler" -target "$android_target" -shared "${flags[@]}" -export main -o "build/video/audio/sync-$variant.so" tests/stdlib/android_video_audio_mock_test.fern internal/stdlib
  done
  LD_LIBRARY_PATH="$PWD/build/video/audio:$PWD/build/video${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" python3 - <<'PYTHON'
import ctypes
for variant in ('normal', 'sanitize'):
    result = ctypes.CDLL(f'./build/video/audio/sync-{variant}.so').main()
    if result != 0:
        raise SystemExit(f'Android audio/video anchor test failed at check {result}')
print('Android audio anchors, pending video deadlines, unavailable results, and seek checks passed')
PYTHON
fi


# Content assets use libc descriptors and a separate JNI test double.
"$fern_video_compiler" -target arm64-android -shared -export main -o build/video/source-api.so tests/stdlib/android_video_source_mock_test.fern internal/stdlib
if [ -n "$android_target" ]; then
  mkdir -p build/video/source
  scripts/libandroid-stubs scripts/video-reference/source-jni-mock.c > build/video/source/stubs.c
  cc -shared -fPIC -Wall -Wextra -Werror -o build/video/source/libandroid.so scripts/video-reference/source-jni-mock.c build/video/source/stubs.c
  ln -sf "$(cc -print-file-name=libc.so.6)" build/video/source/libc.so
  "$fern_video_compiler" -target "$android_target" -shared -export main -o build/video/source/mock.so tests/stdlib/android_video_source_mock_test.fern internal/stdlib
  LD_LIBRARY_PATH="$PWD/build/video/source${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" python3 - <<'PYTHON'
import ctypes
result = ctypes.CDLL('./build/video/source/mock.so').main()
if result != 0:
    raise SystemExit(f'Android content source test failed at check {result}')
print('Android content source ranges, descriptors, and JNI cleanup passed')
PYTHON
fi
