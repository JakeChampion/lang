// Decode an Opus conformance bitstream to 48 kHz stereo signed 16-bit PCM.
import "std/audio/wire";
import "std/f32";
import "std/i32";
import "std/opus";

function main(): i32 {
  let argv = args();
  if (argv.len() != 3) {
    eprint("usage: opus-rfc-decode INPUT.bit OUTPUT.s16le");
    return 1;
  }
  let Ok(data) = read_file_bytes(argv[1]) else {
    return 2;
  };
  let Ok(output) = open_writer(argv[2]) else {
    return 2;
  };
  defer output.close();
  let Ok(decoder) = opus.decoder(48000, 2) else {
    return 3;
  };
  let at = 0;
  let packet = 0;
  while (at < data.len()) {
    if (data.len() - at < 8) {
      eprint("incomplete header at packet " + packet.to_string());
      return 4;
    }
    let size = wire.be(data, at, 4);
    let expected_range = wire.be(data, at + 4, 4) as u32;
    at += 8;
    if (size > (data.len() - at) as u64) {
      eprint("incomplete payload at packet " + packet.to_string());
      return 4;
    }
    let end = at + size as i32;
    let (next, decoded) = decoder.decode(data[at:end]);
    decoder = next;
    let Ok(samples) = decoded else {
      eprint("decode failed at packet " + packet.to_string());
      return 5;
    };
    if (decoder.final_range() != expected_range) {
      eprint("entropy range mismatch at packet " + packet.to_string());
      return 6;
    }
    let pcm: u8[] = [];
    for sample in samples {
      let q = (sample * 32768.0f32 + 0.5f32).floor() as i32;
      q = q.clamp(-32768, 32767);
      pcm = wire.put_le(pcm, q as u64, 2);
    }
    if let Err(_) = output.write_bytes(pcm) {
      return 7;
    }
    at = end;
    packet += 1;
  }
  return 0;
}
