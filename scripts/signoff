#!/usr/bin/env bash
#
# scripts/signoff — local-CI sign-off for Fern, built on Basecamp's gh-signoff
# (https://github.com/basecamp/gh-signoff).
#
# Each CI lane that supports it reads a `signoff/<step>` commit status on the PR
# head commit (see .github/actions/signoff-gate + docs/CI-SIGNOFF.md). Posting
# that status with `gh signoff <step>` tells CI "I ran this suite locally on
# this exact commit — skip it." This wrapper just knows the canonical step
# names and the recommended local-verifiable subset.
#
# Usage:
#   scripts/signoff --list            # show every step and the lane it skips
#   scripts/signoff --local           # sign off the locally-verifiable lanes
#   scripts/signoff units e2e-x86_64  # sign off specific lanes
#
# Sign-offs pin to the current HEAD commit. Push a new commit (or amend) and
# they no longer apply — CI runs that lane again until you re-sign. That commit
# bump is also how you "undo" a sign-off: commit statuses can't be deleted, so
# there is no revoke; a fresh commit clears every sign-off on the old SHA. Only
# sign off what you actually ran and saw pass.

set -euo pipefail

# step -> the CI lane (workflow) it skips. Keep in sync with the `step:` inputs
# in .github/workflows/*.yml and the table in docs/CI-SIGNOFF.md.
declare -A LANES=(
  [units]="Test units"
  [lint]="Lint (vet / build / fmt-check / deadcode / actionlint)"
  [examples]="Examples"
  [fernsmith]="Test fernsmith"
  [e2e-x86_64]="Test e2e x86_64"
  [e2e-wasm]="Test e2e wasm"
  [e2e-other]="Test e2e other"
  [e2e-differential]="Test e2e differential"
  [e2e-selfhost]="Test e2e self-host"
  [fuzz-parse]="Fuzz parse round-trip"
  [fuzz-diff]="Fuzz differential execution"
  [e2e-arm64]="Test e2e arm64  (DISCOURAGED — needs real/qemu arm64; let CI run it)"
)

# The lanes you can faithfully validate on an x86-64 dev box (incl. wasm under
# wasmtime). Deliberately excludes e2e-arm64 — project guidance is to let CI run
# the arm64 matrix rather than gate on it locally.
LOCAL_STEPS=(units lint examples fernsmith e2e-x86_64 e2e-wasm e2e-other e2e-differential e2e-selfhost fuzz-parse fuzz-diff)

die() { echo "signoff: $*" >&2; exit 1; }

print_list() {
  echo "Sign-off steps (step -> CI lane it skips):"
  # Stable order: local-verifiable set first, then the discouraged arm64 lane.
  for s in "${LOCAL_STEPS[@]}" e2e-arm64; do
    printf '  %-18s %s\n' "$s" "${LANES[$s]}"
  done
  echo
  echo "  --local  signs off: ${LOCAL_STEPS[*]}"
}

[ $# -eq 0 ] && { print_list; exit 0; }

case "$1" in
  --list|-l) print_list; exit 0 ;;
esac

command -v gh >/dev/null 2>&1 || die "GitHub CLI (gh) not found — https://cli.github.com"
gh extension list 2>/dev/null | grep -q 'basecamp/gh-signoff' \
  || die "gh-signoff not installed — run: gh extension install basecamp/gh-signoff"

# Refuse to sign off a dirty tree: the status pins to HEAD, so uncommitted work
# would be skipped in CI but never reflected in the signed-off commit.
if ! git diff --quiet || ! git diff --cached --quiet; then
  die "working tree has uncommitted changes — commit first (sign-offs pin to HEAD)"
fi

STEPS=()
for arg in "$@"; do
  case "$arg" in
    --local) STEPS+=("${LOCAL_STEPS[@]}") ;;
    --all)   STEPS+=("${LOCAL_STEPS[@]}" e2e-arm64) ;;
    *)
      [ -n "${LANES[$arg]+x}" ] || die "unknown step '$arg' (try: scripts/signoff --list)"
      STEPS+=("$arg")
      ;;
  esac
done
[ ${#STEPS[@]} -gt 0 ] || die "nothing to sign off"

for s in "${STEPS[@]}"; do
  echo "==> signing off: $s (${LANES[$s]})"
  gh signoff "$s"
done
