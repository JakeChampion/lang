// A QUIC client over UDP: handshake with a server on ALPN fern-echo, send
// SIZE bytes on a bidirectional stream, check they come back with the
// stream's end, close, and exit 0 when they did.
//   client PORT NAME CA.pem SIZE
import "std/i32";
import "std/net";
import "std/quic/conn";
import "std/tls/verify";
import "std/async";
import "std/clock";
import "std/time";
import "std/option";
import "std/i64";
import "std/string";
import "std/rand";

function now(): Instant {
  return clock.instant();
}

// Whether a connection's next deadline has come.
function passed(deadline: Option[Instant]): boolean {
  let Some(at) = deadline else {
    return false;
  };
  return now().cmp(at) >= 0;
}

// When to stop waiting for a datagram: at the deadline, but 1 to 100 ms from now.
function wait_until(deadline: Option[Instant]): Option[Instant] {
  let most: Duration = time.duration_millis(100);
  let Some(at) = deadline else {
    return Some(now().add(most));
  };
  let left: Duration = at.since(now()).add(time.duration_millis(1));
  if (left.cmp(time.duration_millis(1)) < 0) {
    return Some(now().add(time.duration_millis(1)));
  }
  if (left.cmp(most) > 0) {
    return Some(now().add(most));
  }
  return Some(now().add(left));
}

function pump(c: conn.Conn, sock: i32, peer: net.SocketAddr): conn.Conn {
  let c2: conn.Conn = c.transmit(now());
  let out: u8[][] = c2.datagrams();
  c2 = c2.sent();
  for d in out {
    let r: Result[i32, net.NetError] = net.send_to(sock, d, peer);
  }
  return c2;
}

function drain(c: conn.Conn, sock: i32, buf: u8[]): conn.Conn {
  let cur: conn.Conn = c;
  let going: boolean = true;
  while (going) {
    match (net.recv_from(sock, buf)) {
      Ok(got) => {
        let step: conn.Conn = cur.receive(buf[0:got.0], now());
        cur = step.events_taken();
        for e in step.events {
          match (e) {
            conn.Connected => {
              print("fern client: connected alpn=" + cur.alpn());
            },
            conn.Closed(why) => {
              print("fern client: closed code=" + why.code.to_string() + " reason=" + why.reason);
            },
            _ => {}
          }
        }
      },
      Err(_) => {
        going = false;
      }
    }
  }
  return cur;
}

function wait_for(c: conn.Conn): Option[Instant] {
  return wait_until(c.deadline());
}

function payload(n: i32): u8[] {
  let out: u8[] = __alloc_u8(n);
  let i: i32 = 0;
  while (i < n) {
    out = out.with(i, (i * 7 + 3 & 255) as u8);
    i = i + 1;
  }
  return out;
}

function same(a: u8[], b: u8[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

struct Echo { id: i64, sent: u8[], got: u8[], matched: boolean, closing: boolean }

function echoed(c: conn.Conn, e: Echo): (conn.Conn, Echo) {
  if (!c.confirmed() || e.closing) {
    return (c, e);
  }
  if (e.id < 0) {
    let Ok(opened) = c.open_stream(false) else {
      return (c, e);
    };
    let Ok(w) = opened.0.write(opened.1, e.sent, true) else {
      return (c, e);
    };
    return (w, Echo { ...e, id: opened.1 });
  }
  let Ok(r) = c.read(e.id) else {
    return (c, e);
  };
  let got: u8[] = e.got.concat(r.1);
  if (!r.2) {
    return (r.0, Echo { ...e, got: got });
  }
  let matched: boolean = same(got, e.sent);
  let verdict: string = "DIFFERS";
  if (matched) {
    verdict = "matches";
  }
  print("fern client: echo of " + got.len().to_string() + " bytes " + verdict);
  return (r.0.close(0 as i64, "fern done", true, now()), Echo { ...e, got: got, matched: matched, closing: true });
}

function ran(c0: conn.Conn, sock: i32, peer: net.SocketAddr, size: i32): boolean {
  let buf: u8[] = __alloc_u8(65536);
  let c: conn.Conn = c0;
  let e: Echo = Echo { id: 0 - 1 as i64, sent: payload(size), got: [], matched: false, closing: false };
  let started: Instant = now();
  while (!c.done() && now().since(started).cmp(time.duration_seconds(20)) < 0) {
    c = pump(c, sock, peer);
    let woke: async.Wake = async.wait_any([sock, 1], wait_for(c));
    c = drain(c, sock, buf);
    if (passed(c.deadline())) {
      c = c.tick(now());
    }
    let (c2, e2) = echoed(c, e);
    c = c2;
    e = e2;
  }
  return e.matched;
}

function main(): i32 {
  let argv: string[] = args();
  let Ok(peer) = net.socket_addr_parse("127.0.0.1:" + argv[1]) else {
    return 2;
  };
  let Ok(roots) = verify.roots_from_file(argv[3]) else {
    eprint("no roots");
    return 2;
  };
  let cfg: conn.Config = conn.config(["fern-echo"]).with_streams(16 as i64, 16 as i64, 262144 as i64, 1048576 as i64).client_side(argv[2], roots);
  let Ok(c0) = conn.client(cfg, rand.bytes(conn.client_entropy(cfg)), now(), clock.now()) else {
    return 2;
  };
  let Ok(any) = net.socket_addr_parse("127.0.0.1:0") else {
    return 2;
  };
  let Ok(sock) = net.udp_socket(any) else {
    return 2;
  };
  let nb: Result[void, net.NetError] = net.set_nonblocking(sock, true);
  let Ok(size) = i32.parse_i32(argv[4]) else {
    return 2;
  };
  if (ran(c0, sock, peer, size)) {
    return 0;
  }
  return 1;
}
