import "std/net";
import "std/quic/conn";
import "std/quic/streams";
import "std/quic/packet";
import "std/tls/identity";
import "std/async";
import "std/clock";
import "std/time";
import "std/option";
import "std/i64";
import "std/rand";

struct Server {
  cfg: conn.Config,
  sock: i32,
  current: Option[conn.Conn],
  peer: Option[net.SocketAddr],
  connected: boolean,
}

function now(): Instant {
  return clock.instant();
}

// Whether a connection's next deadline has come.
function passed(deadline: Option[Instant]): boolean {
  let Some(at) = deadline else {
    return false;
  };
  return now().cmp(at) >= 0;
}

// When to stop waiting for a datagram: at the deadline, but 1 to 100 ms from now.
function wait_until(deadline: Option[Instant]): Option[Instant] {
  let most = time.duration_millis(100);
  let Some(at) = deadline else {
    return Some(now().add(most));
  };
  let left = at.since(now()).add(time.duration_millis(1));
  if (left.cmp(time.duration_millis(1)) < 0) {
    return Some(now().add(time.duration_millis(1)));
  }
  if (left.cmp(most) > 0) {
    return Some(now().add(most));
  }
  return Some(now().add(left));
}

function shown(step: conn.Conn): conn.Conn {
  for e in step.events {
    match (e) {
      conn.Connected => {
        print(f"fern server: connected alpn={step.alpn()}");
      },
      conn.Closed(why) => {
        print(f"fern server: closed code={why.code} remote={why.remote} reason={why.reason}");
      }
    }
  }
  let cur = step.events_taken();
  for n in step.stream_events() {
    if let streams.Readable(id) = n {
      cur = echo(cur, id);
    }
  }
  return cur;
}

function echo(c: conn.Conn, id: i64): conn.Conn {
  let Ok(r) = c.read(id) else {
    return c;
  };
  let Ok(w) = r.0.write(id, r.1, r.2) else {
    return r.0;
  };
  if (r.2) {
    print(f"fern server: echoed stream {id} to its end");
  }
  return w;
}

function copied(buf: u8[], n: i32): u8[] {
  let out = __alloc_u8(n);
  for i in 0..n {
    out = out.with(i, buf[i]);
  }
  return out;
}

function wait_for(s: Server): Option[Instant] {
  let Some(c) = s.current else {
    return Some(now().add(time.duration_millis(100)));
  };
  return wait_until(c.deadline());
}

function accepted(s: Server, d: u8[], from: net.SocketAddr): Server {
  if (d.len() < packet.MIN_INITIAL_DATAGRAM) {
    return s;
  }
  let Ok(h) = packet.parse(d, 0, 8) else {
    return s;
  };
  let Ok(c) = conn.accept(s.cfg, rand.bytes(conn.server_entropy(s.cfg)), h, now()) else {
    return s;
  };
  let step = c.receive(d, now());
  return Server { ...s, current: Some(shown(step)), peer: Some(from) };
}

function received(s: Server, d: u8[], from: net.SocketAddr): Server {
  let Some(c) = s.current else {
    return accepted(s, d, from);
  };
  let step = c.receive(d, now());
  return Server { ...s, current: Some(shown(step)) };
}

function drained(s: Server, buf: u8[]): Server {
  let cur = s;
  loop {
    let Ok(got) = net.recv_from(cur.sock, buf) else {
      return cur;
    };
    cur = received(cur, copied(buf, got.0), got.1);
  }
}

function sent(s: Server, c: conn.Conn): Server {
  let cur = c;
  if (passed(cur.deadline())) {
    let step = cur.tick(now());
    cur = shown(step);
  }
  let next = cur.transmit(now());
  let out = next.datagrams();
  next = next.sent();
  if let Some(to) = s.peer {
    for d in out {
      let _ = net.send_to(s.sock, d, to);
    }
  }
  return Server { ...s, current: Some(next), connected: s.connected || next.connected() };
}

function bound(port: string, cert: string, key: string): Option[Server] {
  let Ok(chain) = read_file(cert) else {
    return None;
  };
  let Ok(pem) = read_file(key) else {
    return None;
  };
  let Ok(id) = identity.from_pem(chain, pem) else {
    eprint("bad identity");
    return None;
  };
  let cfg = conn.config(["fern-echo"]).with_streams(16, 16, 262144, 1048576).server_side(id);
  let Ok(addr) = net.socket_addr_parse("127.0.0.1:" + port) else {
    return None;
  };
  let Ok(sock) = net.udp_socket(addr) else {
    return None;
  };
  let _ = net.set_nonblocking(sock, true);
  return Some(Server { cfg: cfg, sock: sock, current: None, peer: None, connected: false });
}

function main(): i32 {
  let argv = args();
  let Some(s0) = bound(argv[1], argv[2], argv[3]) else {
    return 2;
  };
  print("fern server: listening");
  let buf = __alloc_u8(65536);
  let s = s0;
  let started = now();
  while (now().since(started).cmp(time.duration_seconds(20)) < 0) {
    let _ = async.wait_any([s.sock, 1], wait_for(s));
    s = drained(s, buf);
    if let Some(c) = s.current {
      s = sent(s, c);
      if let Some(after) = s.current {
        if (after.done() && s.connected) {
          return 0;
        }
        if (after.done()) {
          return 1;
        }
      }
    }
  }
  return 1;
}
