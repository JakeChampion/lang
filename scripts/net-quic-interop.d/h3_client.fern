// An HTTP/3 client over UDP: a GET of /hello and a POST of SIZE bytes to
// /upload on one connection, each response printed with its trailers,
// then a close; exits 0 when both were answered.
//   h3_client PORT NAME CA.pem SIZE
import "std/i32";
import "std/array";
import "std/net";
import "std/quic/conn";
import "std/http/h3";
import "std/http/h3q";
import "std/tls/verify";
import "std/headers";
import "std/stream";
import "std/async";
import "std/clock";
import "std/time";
import "std/option";
import "std/i64";
import "std/string";
import "std/rand";

function now(): Instant {
  return clock.instant();
}

// Whether a connection's next deadline has come.
function passed(deadline: Option[Instant]): boolean {
  let Some(at) = deadline else {
    return false;
  };
  return now().cmp(at) >= 0;
}

// When to stop waiting for a datagram: at the deadline, but 1 to 100 ms from now.
function wait_until(deadline: Option[Instant]): Option[Instant] {
  let most = time.duration_millis(100);
  let Some(at) = deadline else {
    return Some(now().add(most));
  };
  let left = at.since(now()).add(time.duration_millis(1));
  if (left.cmp(time.duration_millis(1)) < 0) {
    return Some(now().add(time.duration_millis(1)));
  }
  if (left.cmp(most) > 0) {
    return Some(now().add(most));
  }
  return Some(now().add(left));
}

function pump(c: h3q.Conn, sock: i32, peer: net.SocketAddr): h3q.Conn {
  let c2 = c.transmit(now());
  let out = c2.datagrams();
  c2 = c2.sent();
  for d in out {
    let _ = net.send_to(sock, d, peer);
  }
  return c2;
}

function drain(c: h3q.Conn, sock: i32, buf: u8[]): h3q.Conn {
  let cur = c;
  loop {
    let Ok(got) = net.recv_from(sock, buf) else {
      return cur;
    };
    cur = cur.receive(buf[0:got.0], now());
  }
}

function wait_for(c: h3q.Conn): Option[Instant] {
  return wait_until(c.deadline());
}

function request(method: string, path: string, body: u8[]): HttpRequest {
  return HttpRequest { method: method, path: path, body: stream.from_bytes(body), headers: headers.new().append("host", "localhost"), trailers: headers.new() };
}

struct Fetches { todo: HttpRequest[], owed: i32, answered: i32, closing: boolean }

function shown(resp: HttpResponse): string {
  let out = f"{resp.status} {string_from_bytes_unchecked(resp.body_bytes())} |";
  for i in 0..resp.trailers.names.len() {
    out += f" {resp.trailers.names[i]}={resp.trailers.values[i]}";
  }
  return out;
}

function stepped(c: h3q.Conn, f: Fetches): (h3q.Conn, Fetches) {
  let evs = c.events;
  let cur = c.events_taken();
  let next = noted(evs, f);
  if (!cur.ready() || next.owed > 0 || next.closing) {
    return (cur, next);
  }
  if (next.todo.len() == 0) {
    return (cur.close(now()), Fetches { ...next, closing: true });
  }
  let Ok(sent) = cur.request(next.todo[0].outgoing("https")) else {
    return (cur, next);
  };
  return (sent.0, Fetches { ...next, todo: array.drop(next.todo, 1), owed: 1 });
}

function noted(evs: h3q.Event[], f: Fetches): Fetches {
  let next = f;
  for e in evs {
    match (e) {
      h3q.Responded(id, resp) => {
        print(f"fern h3 client: stream {id} -> {shown(resp)}");
        next = Fetches { ...next, owed: next.owed - 1, answered: next.answered + 1 };
      },
      h3q.StreamDropped(id, code) => {
        print(f"fern h3 client: stream {id} failed {code}");
        next = Fetches { ...next, owed: next.owed - 1 };
      },
      h3q.Ended(why) => {
        print(f"fern h3 client: ended code={why.code} reason={why.reason}");
      },
      _ => {}
    }
  }
  return next;
}

function opened(argv: string[]): Option[(h3q.Conn, i32)] {
  let Ok(roots) = verify.roots_from_file(argv[3]) else {
    eprint("no roots");
    return None;
  };
  let cfg = h3q.transport(conn.config([]).client_side(argv[2], roots));
  let Ok(q) = conn.client(cfg, rand.bytes(conn.client_entropy(cfg)), now(), clock.now()) else {
    return None;
  };
  let Ok(any) = net.socket_addr_parse("127.0.0.1:0") else {
    return None;
  };
  let Ok(sock) = net.udp_socket(any) else {
    return None;
  };
  let _ = net.set_nonblocking(sock, true);
  return Some((h3q.client(q, h3.config()), sock));
}

function main(): i32 {
  let argv = args();
  let Ok(peer) = net.socket_addr_parse("127.0.0.1:" + argv[1]) else {
    return 2;
  };
  let Ok(size) = i32.parse_i32(argv[4]) else {
    return 2;
  };
  let Some(o) = opened(argv) else {
    return 2;
  };
  let sock = o.1;
  let upload = __alloc_u8(size);
  let f = Fetches { todo: [request("GET", "/hello", []), request("POST", "/upload", upload)], owed: 0, answered: 0, closing: false };
  let c = o.0;
  let buf = __alloc_u8(65536);
  let started = now();
  while (!c.done() && now().since(started).cmp(time.duration_seconds(20)) < 0) {
    c = pump(c, sock, peer);
    let _ = async.wait_any([sock.fd, 1], wait_for(c));
    c = drain(c, sock, buf);
    if (passed(c.deadline())) {
      c = c.tick(now());
    }
    let (c2, f2) = stepped(c, f);
    c = c2;
    f = f2;
  }
  if (f.answered == 2) {
    return 0;
  }
  return 1;
}
