import "std/net";
import "std/quic/conn";
import "std/quic/packet";
import "std/http/h3";
import "std/http/h3q";
import "std/tls/identity";
import "std/headers";
import "std/async";
import "std/clock";
import "std/time";
import "std/option";
import "std/i64";
import "std/rand";

// retry_key is empty unless the server was started in retry mode, where
// every new client first answers a Retry carrying a token sealed with it.
struct Server { cfg: conn.Config, sock: Socket, current: Option[h3q.Conn], peer: Option[net.SocketAddr], answered: i32, retry_key: u8[] }

function now(): Instant {
  return clock.instant();
}

// Whether a connection's next deadline has come.
function passed(deadline: Option[Instant]): boolean {
  let Some(at) = deadline else {
    return false;
  };
  return now().cmp(at) >= 0;
}

// When to stop waiting for a datagram: at the deadline, but 1 to 100 ms from now.
function wait_until(deadline: Option[Instant]): Option[Instant] {
  let most = time.duration_millis(100);
  let Some(at) = deadline else {
    return Some(now().add(most));
  };
  let left = at.since(now()).add(time.duration_millis(1));
  if (left.cmp(time.duration_millis(1)) < 0) {
    return Some(now().add(time.duration_millis(1)));
  }
  if (left.cmp(most) > 0) {
    return Some(now().add(most));
  }
  return Some(now().add(left));
}

function answer(req: HttpRequest): HttpResponse {
  let body = f"{req.method} {req.path} {req.body.data.len()}";
  print("fern h3 server: answered " + body);
  return HttpResponse { status: 200, body: BodyText(body), headers: headers.new().append("content-type", "text/plain"), trailers: headers.new().append("x-served-by", "fern"), background: None };
}

function served(s: Server, c: h3q.Conn): Server {
  let evs = c.events;
  let cur = c.events_taken();
  let answered = s.answered;
  for e in evs {
    match (e) {
      h3q.Requested(id, req) => {
        cur = cur.respond(id, answer(req));
        answered += 1;
      },
      h3q.Ended(why) => {
        print(f"fern h3 server: ended code={why.code} remote={why.remote} reason={why.reason}");
      },
      _ => {}
    }
  }
  return Server { ...s, current: Some(cur), answered: answered };
}

function copied(buf: u8[], n: i32): u8[] {
  let out = __alloc_u8(n);
  for i in 0..n {
    out = out.with(i, buf[i]);
  }
  return out;
}

function wait_for(s: Server): Option[Instant] {
  let Some(c) = s.current else {
    return Some(now().add(time.duration_millis(100)));
  };
  return wait_until(c.deadline());
}

function accepted(s: Server, d: u8[], from: net.SocketAddr): Server {
  if (d.len() < packet.MIN_INITIAL_DATAGRAM) {
    return s;
  }
  let Ok(h) = packet.parse(d, 0, 8) else {
    return s;
  };
  let path = from.to_string().bytes();
  if (s.retry_key.len() > 0 && h.token.len() == 0) {
    let _ = net.send_to(s.sock, conn.retry(s.cfg, s.retry_key, rand.bytes(conn.retry_entropy(s.cfg)), h, path, clock.now()), from);
    print("fern h3 server: retry sent");
    return s;
  }
  let Ok(q) = admitted(s, h, path, from) else {
    return s;
  };
  return served(Server { ...s, peer: Some(from) }, h3q.server(q, h3.config()).receive(d, now()));
}

function admitted(s: Server, h: packet.Header, path: u8[], from: net.SocketAddr): Result[conn.Conn, string] {
  if (h.token.len() == 0) {
    return conn.accept(s.cfg, rand.bytes(conn.server_entropy(s.cfg)), h, now(), clock.now());
  }
  let Some(odcid) = conn.validated(s.retry_key, h, path, clock.now()) else {
    let _ = net.send_to(s.sock, conn.invalid_token(h), from);
    return Err("token refused");
  };
  print("fern h3 server: token accepted");
  return conn.accept_validated(s.cfg, rand.bytes(conn.server_entropy(s.cfg)), h, odcid, now(), clock.now());
}

function received(s: Server, d: u8[], from: net.SocketAddr): Server {
  let Some(c) = s.current else {
    return accepted(s, d, from);
  };
  return served(s, c.receive(d, now()));
}

function drained(s: Server, buf: u8[]): Server {
  let cur = s;
  loop {
    let Ok(got) = net.recv_from(cur.sock, buf) else {
      return cur;
    };
    cur = received(cur, copied(buf, got.0), got.1);
  }
}

function sent(s: Server, c: h3q.Conn): Server {
  let cur = s;
  if (passed(c.deadline())) {
    cur = served(cur, c.tick(now()));
  }
  let Some(ticked) = cur.current else {
    return cur;
  };
  let next = ticked.transmit(now());
  let out = next.datagrams();
  next = next.sent();
  if let Some(to) = cur.peer {
    for d in out {
      let _ = net.send_to(cur.sock, d, to);
    }
  }
  return Server { ...cur, current: Some(next) };
}

function bound(port: string, cert: string, key: string, retry: boolean): Option[Server] {
  let Ok(chain) = read_file(cert) else {
    return None;
  };
  let Ok(pem) = read_file(key) else {
    return None;
  };
  let Ok(id) = identity.from_pem(chain, pem) else {
    eprint("bad identity");
    return None;
  };
  let cfg = h3q.transport(conn.config([]).server_side(id));
  let Ok(addr) = net.socket_addr_parse("127.0.0.1:" + port) else {
    return None;
  };
  let Ok(sock) = net.udp_socket(addr) else {
    return None;
  };
  let _ = net.set_nonblocking(sock, true);
  let retry_key: u8[] = [];
  if (retry) {
    retry_key = rand.bytes(32);
  }
  return Some(Server { cfg: cfg, sock: sock, current: None, peer: None, answered: 0, retry_key: retry_key });
}

function main(): i32 {
  let argv = args();
  let Some(s0) = bound(argv[1], argv[2], argv[3], argv.len() > 4 && argv[4] == "retry") else {
    return 2;
  };
  print("fern h3 server: listening");
  let buf = __alloc_u8(65536);
  let s = s0;
  let started = now();
  while (now().since(started).cmp(time.duration_seconds(20)) < 0) {
    let _ = async.wait_any([s.sock.fd, 1], wait_for(s));
    s = drained(s, buf);
    if let Some(c) = s.current {
      s = sent(s, c);
      if let Some(after) = s.current {
        if (after.done()) {
          return if_answered(s);
        }
      }
    }
  }
  return 1;
}

function if_answered(s: Server): i32 {
  if (s.answered > 0) {
    return 0;
  }
  return 1;
}
