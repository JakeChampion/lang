#!/usr/bin/env python3
"""Check native NAL ranges, configurations, and conversions against independent streams."""
import importlib.util
import os
from pathlib import Path
import re
import struct
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
compiler = os.environ.get("FERN") or subprocess.check_output(["./bootstrap/bootstrap.sh", "stage0"], text=True).strip()
binary = ROOT / "build/video/annex-b-reference"
binary.parent.mkdir(parents=True, exist_ok=True)
target = {"x86_64": "x86-64-linux", "aarch64": "arm64-linux", "arm64": "arm64-darwin"}[os.uname().machine]
subprocess.run([compiler, "-target", target, "-sanitize", "-o", str(binary),
                "scripts/video-reference/annex-b.fern", "internal/stdlib"], check=True)
wasm = binary.with_suffix(".wasm")
subprocess.run([compiler, "-target", "wasm32-wasi", "-o", str(wasm),
                "scripts/video-reference/annex-b.fern", "internal/stdlib"], check=True)
stream_binary = ROOT / "build/video/annex-b-input-reference"
subprocess.run([compiler, "-stdlib", str(ROOT / "internal/stdlib"), "-target", target, "-sanitize", "-o", str(stream_binary),
                "scripts/video-reference/annex-b-input.fern"], check=True)
stream_wasm = stream_binary.with_suffix(".wasm")
subprocess.run([compiler, "-stdlib", str(ROOT / "internal/stdlib"), "-target", "wasm32-wasi", "-o", str(stream_wasm),
                "scripts/video-reference/annex-b-input.fern"], check=True)


def decode(path, pixel_format):
    return subprocess.check_output(["ffmpeg", "-v", "error", "-i", str(path), "-vsync", "0",
                                    "-pix_fmt", pixel_format, "-f", "rawvideo", "-"])


def check(path, directory, pixel_format, frames):
    data = path.read_bytes()
    markers = list(re.finditer(b"\x00{2,}\x01", data))
    assert markers and markers[0].start() == 0
    units = []
    for index, marker in enumerate(markers):
        end = markers[index + 1].start() if index + 1 < len(markers) else len(data)
        payload = data[marker.end():end].rstrip(b"\x00")
        assert payload
        units.append((marker.end(), payload))
    lines = subprocess.check_output([str(binary), str(path)], text=True).splitlines()
    wasi = subprocess.check_output(["wasmtime", "run", "--dir", ".", str(wasm), path.name],
                                   cwd=directory, text=True).splitlines()
    assert lines == wasi and len(lines) == len(units) + 2
    streamed = subprocess.check_output([str(stream_binary), str(path)], text=True).splitlines()
    streamed_wasi = subprocess.check_output(["wasmtime", "run", "--dir", ".", str(stream_wasm), path.name],
                                          cwd=directory, text=True).splitlines()
    assert streamed == streamed_wasi == lines[:-2]
    for line, (offset, payload) in zip(lines[:-2], units, strict=True):
        assert line.split() == ["U", str(offset), str(len(payload)), payload.hex()]
    packet = b"".join(struct.pack(">I", len(payload)) + payload for _, payload in units)
    canonical = b"".join(b"\x00\x00\x00\x01" + payload for _, payload in units)
    assert lines[-2] == "P " + packet.hex()
    assert lines[-1] == "B " + canonical.hex()
    restored = directory / ("fern-" + path.name)
    restored.write_bytes(canonical)
    pixels = decode(path, pixel_format)
    sample_bytes = 2 if pixel_format == "yuv420p10le" else 1
    assert len(pixels) == frames * 64 * 48 * 3 // 2 * sample_bytes
    assert decode(restored, pixel_format) == pixels
    print(f"{path.name}: {len(units)} complete/streamed native/WASI ranges match; FFmpeg planes match", flush=True)


def configuration_units(record):
    at, values = 23, []
    for _ in range(record[22]):
        kind, count = record[at] & 63, int.from_bytes(record[at + 1:at + 3], "big")
        at += 3
        for _ in range(count):
            size = int.from_bytes(record[at:at + 2], "big")
            at += 2
            assert size >= 2 and at + size <= len(record)
            values.append((kind, at, record[at:at + size]))
            at += size
    assert at == len(record)
    return values


def avc_configuration_units(record):
    at, values = 6, []
    for kind in (7, 8, 13):
        if kind == 7:
            count = record[5] & 31
        elif kind == 8:
            count = record[at]
            at += 1
        elif at == len(record):
            break
        else:
            assert len(record) - at >= 4
            count = record[at + 3]
            at += 4
        for _ in range(count):
            size = int.from_bytes(record[at:at + 2], "big")
            at += 2
            assert size >= 1 and at + size <= len(record)
            values.append((kind, at, record[at:at + size]))
            at += size
    assert at == len(record)
    return values


def configuration_run(record, directory, valid, hevc=True):
    path = directory / "temporal-config.bin"
    path.write_bytes(record)
    flag = "--hevc-config" if hevc else "--avc-config"
    native = subprocess.run([str(binary), flag, str(path)], capture_output=True, text=True)
    wasi = subprocess.run(["wasmtime", "run", "--dir", ".", str(wasm), flag, path.name],
                          cwd=directory, capture_output=True, text=True)
    assert native.returncode == (0 if valid else 6), native
    assert wasi.returncode == (0 if valid else 1), wasi
    assert native.stdout == wasi.stdout
    assert re.search(r"leakcheck: allocs=(\d+) frees=\1 live_bytes=0", native.stderr), native.stderr
    assert "fern-sanitizer:" not in native.stderr
    if valid:
        if hevc:
            values = configuration_units(record)
            order = [unit for kind in (32, 33, 34) for actual, _, unit in values if actual == kind]
            order += [unit for kind, _, unit in values if kind in (39, 40)]
            expected = b"".join(b"\0\0\0\1" + unit for unit in order)
            assert native.stdout.strip() == "C 4 " + expected.hex()
            return bytes.fromhex(native.stdout.split()[2])
        values = avc_configuration_units(record)
        sequence = b"".join(b"\0\0\0\1" + unit for kind in (7, 13) for actual, _, unit in values if actual == kind)
        picture = b"".join(b"\0\0\0\1" + unit for kind, _, unit in values if kind == 8)
        assert native.stdout.strip() == "A 4 " + sequence.hex() + " " + picture.hex()
        return b"".join(bytes.fromhex(part) for part in native.stdout.split()[2:])
    else:
        assert "invalid video header or packet" in native.stderr and "invalid video header or packet" in wasi.stderr


def configuration_temporals(path, directory, pixel_format):
    mp4 = directory / "temporal-config.mp4"
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(path), "-c", "copy", "-tag:v", "hvc1", str(mp4)], check=True)
    data = mp4.read_bytes()
    tag = data.index(b"hvcC")
    size = int.from_bytes(data[tag - 4:tag], "big")
    record = data[tag + 4:tag - 4 + size]
    values = configuration_units(record)
    assert {32, 33, 34}.issubset({kind for kind, _, _ in values})
    csd = configuration_run(record, directory, True)
    restored = directory / "configuration-prefix.hevc"
    restored.write_bytes(csd + path.read_bytes())
    assert decode(restored, pixel_format) == decode(path, pixel_format)
    spec = importlib.util.spec_from_file_location("configuration_hevc", ROOT / "scripts/gen-video-hevc-fixtures.py")
    fixtures = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(fixtures)
    trace = fixtures.syntax.build_trace("HEVC", "hevc-config-temporal-trace")
    syntax_accepted = syntax_refused = 0
    for kind in (32, 33, 34):
        offset = next(at for actual, at, _ in values if actual == kind)
        for plus_one in range(8):
            modified = bytearray(record)
            modified[offset + 1] = (modified[offset + 1] & 0xf8) | plus_one
            configuration_run(modified, directory, plus_one != 0 and (kind == 34 or plus_one == 1))
            context = directory / "temporal-parameters.bin"
            context.write_bytes(b"".join(b"\0\0\0\1" + unit for _, _, unit in configuration_units(modified)))
            oracle = subprocess.run([str(trace), str(context)], capture_output=True, text=True)
            if plus_one:
                headers = re.findall(r"nal_unit_type\s+[01]+\s+=\s+(\d+).*?"
                                     r"nuh_temporal_id_plus1\s+[01]+\s+=\s+(\d+)", oracle.stderr, re.S)
                identifiers = [int(value) for actual, value in headers if int(actual) == kind]
                assert identifiers and identifiers[0] == plus_one, oracle.stderr
            if oracle.returncode == 0 and "Failed to read unit" not in oracle.stderr and "out of range" not in oracle.stderr:
                syntax_accepted += 1
            else:
                syntax_refused += 1
    print(f"{path.name}: 24 native/WASI configuration header controls match H.265 7.4.2.2; "
          f"CBS syntax accepted {syntax_accepted}, refused {syntax_refused}; decoded configuration-prefix planes match", flush=True)


def configuration_references(path, directory, pixel_format):
    mp4 = directory / "reference-config.mp4"
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(path), "-c", "copy", "-tag:v", "avc1", str(mp4)], check=True)
    data = mp4.read_bytes()
    tag = data.index(b"avcC")
    size = int.from_bytes(data[tag - 4:tag], "big")
    record = data[tag + 4:tag - 4 + size]
    values = avc_configuration_units(record)
    assert {7, 8}.issubset({kind for kind, _, _ in values})
    csd = configuration_run(record, directory, True, False)
    restored = directory / "configuration-prefix.h264"
    restored.write_bytes(csd + path.read_bytes())
    assert decode(restored, pixel_format) == decode(path, pixel_format)
    spec = importlib.util.spec_from_file_location("configuration_avc", ROOT / "scripts/gen-video-avc-syntax-fixtures.py")
    fixtures = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(fixtures)
    trace = fixtures.build_trace("H264", "avc-config-reference-trace")
    syntax_accepted = syntax_refused = 0
    for kind in (7, 8):
        offset = next(at for actual, at, _ in values if actual == kind)
        for reference in range(4):
            modified = bytearray(record)
            modified[offset] = (modified[offset] & 0x9f) | reference << 5
            configuration_run(modified, directory, reference != 0, False)
            context = directory / "reference-parameters.bin"
            context.write_bytes(b"".join(b"\0\0\0\1" + unit for _, _, unit in avc_configuration_units(modified)))
            oracle = subprocess.run([str(trace), str(context)], capture_output=True, text=True)
            headers = re.findall(r"nal_ref_idc\s+[01]+\s+=\s+(\d+).*?"
                                 r"nal_unit_type\s+[01]+\s+=\s+(\d+)", oracle.stderr, re.S)
            identifiers = [int(value) for value, actual in headers if int(actual) == kind]
            assert identifiers and identifiers[0] == reference, oracle.stderr
            if oracle.returncode == 0 and "Failed to read unit" not in oracle.stderr and "out of range" not in oracle.stderr:
                syntax_accepted += 1
            else:
                syntax_refused += 1
    print(f"{path.name}: 8 native/WASI AVC reference-header controls match H.264 7.4.1; "
          f"CBS syntax accepted {syntax_accepted}, refused {syntax_refused}; configuration-prefix planes match", flush=True)


with tempfile.TemporaryDirectory() as temporary:
    directory = Path(temporary)
    cases = [
        ("avc-baseline", "h264", "libx264", "baseline", "yuv420p"),
        ("avc-high", "h264", "libx264", "high", "yuv420p"),
        ("avc-high10", "h264", "libx264", "high10", "yuv420p10le"),
        ("hevc-main", "hevc", "libx265", "main", "yuv420p"),
        ("hevc-main10", "hevc", "libx265", "main10", "yuv420p10le"),
        ("avc-long", "h264", "libx264", "baseline", "yuv420p"),
    ]
    for name, codec, encoder, profile, pixels in cases:
        path = directory / f"{name}.{codec}"
        frames = 120 if name == "avc-long" else 6
        options = ["-x264-params", "repeat-headers=1:aud=1:scenecut=0"] if codec == "h264" else [
            "-x265-params", "repeat-headers=1:aud=1:scenecut=0:pools=none:frame-threads=1:log-level=error"]
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", "testsrc2=size=64x48:rate=6",
                        "-frames:v", str(frames), "-c:v", encoder, "-profile:v", profile, "-threads", "1",
                        "-g", "4", "-bf", "0" if profile == "baseline" else "2", "-pix_fmt", pixels,
                        *options, "-f", codec, str(path)], check=True)
        if name == "avc-long":
            assert path.stat().st_size > 4104 * 4
        check(path, directory, pixels, frames)
        if codec == "hevc":
            configuration_temporals(path, directory, pixels)
        else:
            configuration_references(path, directory, pixels)
