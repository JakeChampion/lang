#!/usr/bin/env bash
# Runs examples/android/files/dav_live.fern against wsgidav, a WebDAV
# server, which scripts/files-dav-serve starts. CI installs wsgidav with
# pipx (.github/workflows/android.yml).
#
# usage: scripts/files-dav-check [FERN]
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
fern=${1:-$root/bin/fern}
# Below the Linux ephemeral range, so a client socket cannot hold the port.
port=${FILES_DAV_PORT:-24480}
user=fernfiles
password=live-check-1

serve="$root/scripts/files-dav-serve"
export FILES_DAV_USER=$user FILES_DAV_PASSWORD=$password
work=$(mktemp -d)
secure=$(mktemp -d)
trap '"$serve" stop "$work"; "$serve" stop "$secure"; rm -rf "$work" "$secure"' EXIT

"$fern" -stdlib "$root/internal/stdlib" -o "$work/live" "$root/examples/android/files/dav_live.fern"
"$serve" start "$work" "$port"
# A second server speaks HTTPS with a self-signed certificate, for the pin.
"$serve" start "$secure" $((port + 1)) tls
# A file that is larger than the memory the client may hold for it.
truncate -s 256M "$work/large.bin"
export FILES_DAV_LARGE="$work/large.bin"
export FILES_DAV_TLS="https://127.0.0.1:$((port + 1))/files $user $password $(cat "$secure/fingerprint")"
if FILES_DAV_SERVER="http://127.0.0.1:$port/files $user $password" "$work/live" > "$work/out.txt" 2>&1 && grep -q '^# fail 0' "$work/out.txt"; then
  grep '^# pass' "$work/out.txt"
else
  cat "$work/out.txt"
  tail -40 "$work/server.log"
  exit 1
fi
