// The server scripts/net-httplint reads: one response of each shape
// std/http and its middleware produce, so httplint's notes cover a routed
// text and JSON API, a redirect, a problem, a 405 with its Allow, an
// upload echoed back, a compressed body, a static file with its
// validators and a response that says how long it may be cached.
import "std/http";
import "std/http/router";
import "std/http/static";
import "std/http/compress";
import "std/serve";
import "std/platform";
import "core/int";

function hello(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  return Ok(http.ok("hello"));
}

function user(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  return Ok(http.json("{\"id\":" + params.values[0] + "}"));
}

function moved(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  return Ok(http.redirect("/hello"));
}

function missing(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  return Ok(http.problem(404, "Not Found", "there is no " + req.path));
}

function echo(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  let body: string = req.body_string()?;
  return Ok(http.text(200, body));
}

// A body past the compressor's minimum, so `Accept-Encoding: gzip` gets a
// coded one.
function essay(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  use req2 <- compress.compressed(req);
  let text: string = "";
  let i: i32 = 0;
  while (i < 40) {
    text = text + "Line " + int.int_to_string(i) + ": the quick brown fox jumps over the lazy dog.\n";
    i = i + 1;
  }
  return Ok(http.text(200, text).with_header("Content-Type", "text/plain; charset=utf-8"));
}

function files(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  return Ok(static.serve(req, static.dir(www(plat)), plat));
}

function fresh(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  return Ok(http.ok("fresh for a minute").with_header("Cache-Control", "max-age=60"));
}

function www(plat: platform.Host): string {
  match (plat.env("WWW")) {
    Some(dir) => {
      return dir;
    },
    None => {
      return "www";
    }
  }
  return "www";
}

function port(): i32 {
  match (env("PORT")) {
    Some(p) => {
      match (int.parse_int_radix(p, 10)) {
        Some(n) => {
          return n;
        },
        None => {
          return 8080;
        }
      }
    },
    None => {
      return 8080;
    }
  }
  return 8080;
}

function routes(): router.Router[platform.Host] {
  return router.new[platform.Host]().get("/hello", hello).get("/users/{id}", user).get("/moved", moved).get("/missing", missing).post("/echo", echo).get("/essay", essay).get("/files/{path...}", files).get("/fresh", fresh);
}

function main(): i32 {
  return serve.run(port(), serve.config(), routes().handler());
}
