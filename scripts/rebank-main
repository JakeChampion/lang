#!/usr/bin/env bash
# rebank-main MEASURED_SHA CORRECTED_DIR — on main, set the baseline rows that
# the Perf lane measured off their pins, and push the result as one commit.
#
# Main moves the perf rows a little with each merge. The moves add up, the
# strict gate goes red, and each open pull request then re-banked the same
# rows of main. That made the pull requests conflict. This script does the
# re-bank one time, on main, so that a pull request sets only the rows that it
# moves.
#
#   MEASURED_SHA   the commit of main that the Perf lane measured
#   CORRECTED_DIR  the files that scripts/ci-check-perf wrote with
#                  FERN_PERF_CORRECTED_OUT, at any depth. The name of a file is
#                  the name of its baseline in .github/.
#
# A ROW MOVES AT MOST FERN_REBANK_MAX_DRIFT PERCENT (5). A larger move stays
# off its pin, the lane stays red on main, and a person examines it.
#
# A BASELINE THAT CHANGED AFTER MEASURED_SHA IS LEFT. Someone set its rows
# from a newer measurement, and the rows here are older.
#
# NO RE-BANK OF A RE-BANK. When MEASURED_SHA is itself a commit of this
# script, a row that is off its pin again does not repeat to the digit. The
# script stops, so that it cannot push in a loop.
#
# A REFUSED PUSH IS A WARNING. Branch protection can refuse the token. The
# lane is then as red as it was, and a person re-banks with scripts/rebank.
set -euo pipefail

measured=${1:?usage: rebank-main MEASURED_SHA CORRECTED_DIR}
dir=${2:?usage: rebank-main MEASURED_SHA CORRECTED_DIR}
remote=${FERN_REBANK_REMOTE:-origin}
max=${FERN_REBANK_MAX_DRIFT:-5}
subject="perf baselines: the rows of main at"
cd "$(git rev-parse --show-toplevel)"
root=$PWD
case "$dir" in /*) ;; *) dir=$root/$dir ;; esac

warn() {
  if [ -n "${GITHUB_ACTIONS:-}" ]; then printf '::warning title=rebank-main::%s\n' "$1"; else printf 'rebank-main: %s\n' "$1" >&2; fi
}

if git log -1 --format=%s "$measured" | grep -qF "$subject"; then
  warn "$measured is a re-bank, and rows are off their pins again. A person must examine them."
  exit 0
fi

if ! git config user.email >/dev/null 2>&1; then
  export GIT_AUTHOR_NAME=rebank-main GIT_AUTHOR_EMAIL=rebank-main@fern.invalid
  export GIT_COMMITTER_NAME=rebank-main GIT_COMMITTER_EMAIL=rebank-main@fern.invalid
fi

attempt() {
  git fetch -q "$remote" main
  git checkout -q --detach FETCH_HEAD
  local body="" changed=0 f name out
  while IFS= read -r f; do
    name=$(basename "$f")
    [ -s "$f" ] || continue
    if [ ! -f ".github/$name" ]; then
      warn "$name is not a baseline in .github/"
      continue
    fi
    if ! git diff --quiet "$measured" HEAD -- ".github/$name"; then
      body+="$name: left, because it changed after the measurement"$'\n'
      continue
    fi
    if ! out=$("$root/scripts/rebank" --max-drift "$max" ".github/$name" <"$f"); then
      warn "scripts/rebank refused the rows of $name"
      continue
    fi
    body+="$out"$'\n'
  done < <(find "$dir" -type f | LC_ALL=C sort)
  printf '%s' "$body"
  if git diff --quiet; then
    echo "rebank-main: no row to set"
    return 0
  fi
  git commit -q -a -m "$subject ${measured:0:8}" -m "The Perf lane of main measured these rows off their pins at $measured.
A row that would move more than $max% stays, and so does a baseline that
changed after the measurement.

$body"
  git push -q "$remote" HEAD:main
}

if attempt; then exit 0; fi
# Main moved between the fetch and the push.
if attempt; then exit 0; fi
warn "the push to main was refused. Re-bank with scripts/rebank, or let the token of this job push to main."
