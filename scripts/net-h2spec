#!/usr/bin/env bash
# net-h2spec — h2spec's conformance cases against the Fern HTTP/2 server
# (docs/NET-P6-HTTP2-PLAN.md §5, #9860): every case of h2spec's strict mode
# over prior-knowledge h2c against scripts/net-h2spec.d/server.fern, built
# by bin/fern for the host.
#
# Usage: net-h2spec [REPORT]
#
#   REPORT  where the `metric<TAB>value` rows go ("-" or nothing for
#           stdout), the format scripts/perf-history records:
#           h2spec/passed, h2spec/failed, h2spec/skipped.
#
# h2spec is the pinned release below, fetched into $FERN_H2SPEC_TOOLS
# (default ~/.cache/fern-h2spec) and checked against its SHA-256. The run
# covers h2spec's generic cases, HPACK, the valid connection preface and
# RFC 9113 §4 to §8; the one case left out, §3.5's invalid connection
# preface, expects GOAWAY where this server, which listens for HTTP/1.1 on
# the same port, answers bytes that are not the preface as HTTP/1.1 and
# closes. h2spec's TLS client offers no TLS 1.3, which is the only version
# std/tls speaks, so the run is h2c. Any failed case fails the script.
set -euo pipefail
cd "$(dirname "$0")/.."
for tool in curl tar sha256sum; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "net-h2spec: $tool not found" >&2
    exit 2
  fi
done
. scripts/net-lib

H2SPEC_VERSION=2.6.0
case "$ARCH" in
  x86_64) H2SPEC_ASSET=h2spec_linux_amd64.tar.gz; H2SPEC_SHA256=157ee0de702e01ad40e752dbf074b366027e550c8e7504f9450da2809e279318 ;;
  aarch64) H2SPEC_ASSET=h2spec_linux_arm64.tar.gz; H2SPEC_SHA256= ;;
esac
if [ -z "$H2SPEC_SHA256" ]; then
  echo "net-h2spec: no pinned h2spec for $ARCH" >&2
  exit 2
fi

report="${1:--}"
tools="${FERN_H2SPEC_TOOLS:-$HOME/.cache/fern-h2spec}"
h2spec="$tools/h2spec-$H2SPEC_VERSION-$ARCH/h2spec"
if [ ! -x "$h2spec" ]; then
  echo "net-h2spec: fetching h2spec $H2SPEC_VERSION" >&2
  mkdir -p "$(dirname "$h2spec")"
  curl -sSL -o "$work/h2spec.tar.gz" "https://github.com/summerwind/h2spec/releases/download/v$H2SPEC_VERSION/$H2SPEC_ASSET"
  echo "$H2SPEC_SHA256  $work/h2spec.tar.gz" | sha256sum -c - >/dev/null
  tar -xzf "$work/h2spec.tar.gz" -C "$(dirname "$h2spec")" h2spec
fi

port="$(free_port)"
bin/fern -target "$TARGET" -o "$work/server" scripts/net-h2spec.d/server.fern
PORT="$port" start_server "$work/server.log" "$work/server"
await_server fern "$port" "$work/server.log"

echo "== h2spec $H2SPEC_VERSION, $ARCH, strict, h2c on port $port"
status=0
"$h2spec" -h 127.0.0.1 -p "$port" --strict --timeout 5 generic hpack http2/3.5/1 http2/4 http2/5 http2/6 http2/7 http2/8 > "$work/h2spec.log" 2>&1 || status=$?
cat "$work/h2spec.log"
summary="$(tail -1 "$work/h2spec.log")"
passed="$(echo "$summary" | sed -n 's/.* \([0-9]*\) passed.*/\1/p')"
failed="$(echo "$summary" | sed -n 's/.* \([0-9]*\) failed.*/\1/p')"
skipped="$(echo "$summary" | sed -n 's/.* \([0-9]*\) skipped.*/\1/p')"
if [ -z "$passed" ]; then
  echo "net-h2spec: no summary from h2spec" >&2
  exit 1
fi
rows="h2spec/passed	$passed
h2spec/failed	$failed
h2spec/skipped	$skipped"
if [ "$report" = "-" ]; then
  echo "$rows"
else
  echo "$rows" > "$report"
fi
if [ "$status" -ne 0 ] || [ "$failed" != "0" ]; then
  echo "net-h2spec: $failed case(s) failed" >&2
  exit 1
fi
