#!/usr/bin/env python3
"""Measure CAF index time, allocations, and peak RSS for matched file sources."""
import argparse
import base64
import hashlib
import json
from pathlib import Path
import platform
import re
import struct
import subprocess
import zlib

ROOT = Path(__file__).resolve().parent.parent


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def variable(value):
    groups = [value & 127]
    value >>= 7
    while value:
        groups.insert(0, (value & 127) | 128)
        value >>= 7
    return bytes(groups)


def chunk(tag, data):
    return tag + struct.pack('>q', len(data)) + data


def fixture(count):
    text = (ROOT / 'tests/stdlib/caf_smoke_vectors.fern').read_text()
    encoded = re.search(r'encoded: "([A-Za-z0-9+/=]+)"', text)[1]
    original = zlib.decompress(base64.b64decode(encoded))
    pieces, at = {}, 8
    while at < len(original):
        tag, size = original[at:at + 4], struct.unpack_from('>q', original, at + 4)[0]
        pieces[tag] = original[at + 12:at + 12 + size]
        at += 12 + size
    assert struct.unpack_from('>q', pieces[b'pakt'])[0] == 1
    packet = pieces[b'data'][4:]
    bits = ''.join(f'{byte:08b}' for byte in packet)
    flags = int(bits[19:23], 2)
    frames = int(bits[23:55], 2) if flags & 8 else struct.unpack_from('>I', pieces[b'kuki'])[0]
    desc = bytearray(pieces[b'desc'])
    struct.pack_into('>II', desc, 16, 0, 0)
    rows = (variable(len(packet)) + variable(frames)) * count
    table = struct.pack('>qqii', count, frames * count, 0, 0) + rows
    data = b'caff\0\1\0\0' + chunk(b'desc', desc) + chunk(b'kuki', pieces[b'kuki'])
    return data + chunk(b'pakt', table) + chunk(b'data', bytes(4) + packet * count), frames


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--compiler', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--counts', type=int, nargs='+', default=[1000, 10000, 100000])
    parser.add_argument('--trials', type=int, default=5)
    args = parser.parse_args()
    assert platform.system() == 'Linux'
    assert args.trials >= 3 and all(0 < count <= 100000 for count in args.counts)
    target = {'x86_64': 'x86-64-linux', 'aarch64': 'arm64-linux'}[platform.machine()]
    work = args.output.resolve()
    work.mkdir(parents=True, exist_ok=True)
    compiler = args.compiler.resolve()
    binary = work / 'caf-source'
    driver = ROOT / 'bench/audio/caf_source.fern'
    command = [str(compiler), '-target', target, '-o', str(binary), str(driver), str(ROOT / 'internal/stdlib')]
    with (work / 'build.log').open('w') as log:
        subprocess.run(command, check=True, stdout=log, stderr=subprocess.STDOUT, timeout=300)
    rows, inputs = [], {}
    for count in args.counts:
        data, frames = fixture(count)
        path = work / f'{count}.caf'
        path.write_bytes(data)
        inputs[str(count)] = {'sha256': sha(path), 'bytes': len(data), 'frames': count * frames}
        checksums = set()
        for trial in range(args.trials):
            for mode in (['view', 'source', 'source-with'] if trial % 2 == 0 else ['source-with', 'source', 'view']):
                run = subprocess.run([str(binary), mode, str(path)], capture_output=True, text=True, check=True, timeout=300)
                row = {key: int(value) for key, value in (line.split('=', 1) for line in run.stdout.splitlines())}
                assert row['packets'] == count and row['frames'] == count * frames
                checksums.add(row['checksum'])
                row.update(mode=mode, trial=trial, input_packets=count)
                rows.append(row)
                print(json.dumps(row), flush=True)
        assert len(checksums) == 1
    digest = hashlib.sha256()
    for path in sorted((ROOT / 'internal/stdlib').rglob('*')):
        if path.is_file():
            digest.update(path.relative_to(ROOT).as_posix().encode() + b'\0')
            digest.update(path.read_bytes())
    report = {'target': target, 'platform': platform.platform(), 'compiler_sha256': sha(compiler),
              'driver_sha256': sha(driver), 'binary_sha256': sha(binary), 'stdlib_sha256': digest.hexdigest(),
              'source_revision': subprocess.check_output(['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], text=True).strip(),
              'build_command': command, 'inputs': inputs, 'trials': args.trials, 'rows': rows,
              'scope': 'CAF indexing and first-packet checksum, no complete-track decode timing'}
    (work / 'results.json').write_text(json.dumps(report, indent=2) + '\n')


if __name__ == '__main__':
    main()
