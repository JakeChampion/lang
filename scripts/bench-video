#!/usr/bin/env python3
"""Measure the bounded QTRLE frame API on a fixed mixed-packet workload."""
import hashlib
import json
import os
from pathlib import Path
import platform
import statistics
import subprocess
import time

root = Path(__file__).resolve().parent.parent
os.chdir(root)
compiler = os.environ.get('FERN') or subprocess.check_output(['./bootstrap/bootstrap.sh', 'stage0'], text=True).strip()
target = {'x86_64': 'x86-64-linux', 'aarch64': 'arm64-linux', 'arm64': 'arm64-darwin'}[os.uname().machine]
binary = root / 'build/video/qtrle-bench'
binary.parent.mkdir(parents=True, exist_ok=True)
subprocess.run([compiler, '-target', target, '-o', str(binary), 'bench/video_qtrle.fern', 'internal/stdlib'], check=True)
trials = []
for _ in range(5):
    start = time.perf_counter()
    output = subprocess.check_output([str(binary)], text=True).strip()
    elapsed = time.perf_counter() - start
    checksum, allocations = map(int, output.split())
    assert checksum == 138168680515628
    trials.append({'elapsed_seconds': elapsed, 'allocations': allocations})
print(json.dumps({
    'target': target, 'platform': platform.platform(),
    'compiler_sha256': hashlib.sha256(Path(compiler).read_bytes()).hexdigest(),
    'workload': '100000 calls, 521x3 ARGB32, keyframe and three delta packets',
    'includes': 'process startup, packet setup, decode, one sampled pixel per call',
    'median_elapsed_seconds': statistics.median(t['elapsed_seconds'] for t in trials),
    'trials': trials,
}, indent=2))
