#!/usr/bin/env python3
"""Compare two native compilers and the programs they build on one host.

Usage: native-pair-bench BASE_COMPILER CANDIDATE_COMPILER FIXED_SOURCE_ROOT REPORT
                       [--compiler-pairs N]
Build the compilers with bootstrap/bootstrap.sh distcheck first. The report
records cold and warm proof-cache timings. Timing differences are informational.
"""
import argparse
import hashlib
import json
import os
import platform
import statistics
import subprocess
import sys
import tempfile
import time
from pathlib import Path


def run(command, environment=None):
    result = subprocess.run(command, capture_output=True, timeout=180, env=environment)
    if result.returncode:
        sys.stderr.buffer.write(result.stdout + result.stderr)
        raise RuntimeError(f"command exited {result.returncode}: {command}")
    return result.stdout


def measure(commands, pairs, environments=None):
    environments = environments or {}
    reference = None
    for name, command in commands.items():
        answer = run(command, environments.get(name))
        if reference is None:
            reference = answer
        if answer != reference:
            raise RuntimeError("the two programs produced different output")
    rows = []
    for pair in range(pairs):
        order = ["baseline", "candidate"] if pair % 2 == 0 else ["candidate", "baseline"]
        for name in order:
            start = time.perf_counter()
            answer = run(commands[name], environments.get(name))
            elapsed = time.perf_counter() - start
            if answer != reference:
                raise RuntimeError("a repeated run changed its output")
            rows.append({"pair": pair, "compiler": name, "seconds": elapsed})
            print(f"pair {pair + 1}: {name} {elapsed:.6f} s", flush=True)
    ratios = [
        next(row["seconds"] for row in rows if row["pair"] == pair and row["compiler"] == "candidate")
        / next(row["seconds"] for row in rows if row["pair"] == pair and row["compiler"] == "baseline")
        for pair in range(pairs)
    ]
    return {"rows": rows, "paired_ratios": ratios,
            "median_paired_ratio": statistics.median(ratios),
            "stdout": reference.decode()}


def compiler_environments(names, work, cold):
    environments = {}
    for name in names:
        environment = os.environ.copy()
        environment["FERN_RC_CERTIFY"] = "1"
        environment["FERN_RC_CERTIFY_MEMO"] = "0" if cold else str(work / "proof-cache" / name)
        environments[name] = environment
    return environments


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("baseline")
    parser.add_argument("candidate")
    parser.add_argument("source_root", type=Path)
    parser.add_argument("report", type=Path)
    parser.add_argument("--compiler-pairs", type=int, default=7)
    args = parser.parse_args()
    if args.compiler_pairs < 1:
        parser.error("--compiler-pairs must be positive")
    compilers = {name: str(Path(value).resolve()) for name, value in
                 [("baseline", args.baseline), ("candidate", args.candidate)]}
    root = args.source_root.resolve()
    report = args.report.resolve()
    arch = {"aarch64": "arm64", "arm64": "arm64", "x86_64": "x86-64"}.get(platform.machine())
    system = {"Linux": "linux", "Darwin": "darwin"}.get(platform.system())
    if not arch or not system or (system == "darwin" and arch != "arm64"):
        raise SystemExit("this host has no supported native target")
    target = f"{arch}-{system}"
    stdlib = root / "internal/stdlib"
    bench = Path(__file__).resolve().parent.parent / "bench"
    programs = {"x25519": bench / "crypto/x25519.fern", "calendar": bench / "division/calendar.fern"}
    results = {"target": target, "platform": platform.platform(),
               "fixed_source_root": str(root),
               "compiler_sha256": {name: hashlib.sha256(Path(path).read_bytes()).hexdigest()
                                   for name, path in compilers.items()}}
    with tempfile.TemporaryDirectory(prefix="fern-native-pair-") as temporary:
        work = Path(temporary)
        for program, source in programs.items():
            executables = {}
            for name, compiler in compilers.items():
                binary = work / f"{program}-{name}"
                run([compiler, "-target", target, "-o", str(binary), str(source), str(stdlib)])
                executables[name] = [str(binary)]
            print(f"{program} native execution", flush=True)
            results[program] = measure(executables, 15)
        commands = {name: [compiler, "-target", target, "-o", str(work / f"checker-{name}"),
                           str(root / "compiler/checker.fern"), str(stdlib)]
                    for name, compiler in compilers.items()}
        for key, cold in [("compiler_cold", True), ("compiler", False)]:
            print(f"Native compiler, fixed checker input, {'cold' if cold else 'warm'} proof cache", flush=True)
            environments = compiler_environments(compilers, work, cold)
            results[key] = measure(commands, args.compiler_pairs, environments)
            results[key]["proof_cache"] = "disabled" if cold else "isolated-warm"
            results[key]["certification"] = "enabled"
    report.parent.mkdir(parents=True, exist_ok=True)
    report.write_text(json.dumps(results, indent=2) + "\n")
    for name in [*programs, "compiler_cold", "compiler"]:
        print(f"{name}: median candidate/baseline ratio {results[name]['median_paired_ratio']:.6f}", flush=True)


if __name__ == "__main__":
    main()
