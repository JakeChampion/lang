#!/usr/bin/env python3
"""Compare native AVC access units with FFprobe packets and FFmpeg planes."""
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
compiler = os.environ.get("FERN") or subprocess.check_output(["./bootstrap/bootstrap.sh", "stage0"], text=True).strip()
binary = ROOT / "build/video/avc-input-reference"
binary.parent.mkdir(parents=True, exist_ok=True)
target = {"x86_64": "x86-64-linux", "aarch64": "arm64-linux", "arm64": "arm64-darwin"}[os.uname().machine]
subprocess.run([compiler, "-stdlib", str(ROOT / "internal/stdlib"), "-target", target, "-sanitize", "-o", str(binary),
                "scripts/video-reference/avc-input.fern"], check=True)
wasm = binary.with_suffix(".wasm")
subprocess.run([compiler, "-stdlib", str(ROOT / "internal/stdlib"), "-target", "wasm32-wasi", "-o", str(wasm),
                "scripts/video-reference/avc-input.fern"], check=True)


def units(data):
    markers = list(re.finditer(b"\x00{2,}\x01", data))
    return [data[m.end():markers[i + 1].start() if i + 1 < len(markers) else len(data)].rstrip(b"\0")
            for i, m in enumerate(markers)]


def encode(directory, name, profile, pixel_format, options, size="64x48"):
    path = directory / f"{name}.h264"
    params = "keyint=6:min-keyint=6:scenecut=0:repeat-headers=1:" + options
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "lavfi", "-i", f"testsrc2=size={size}:rate=25",
                    "-frames:v", "18", "-c:v", "libx264", "-threads", "1", "-profile:v", profile,
                    "-pix_fmt", pixel_format, "-x264-params", params, "-f", "h264", str(path)], check=True)
    return path


def decoded(path):
    return subprocess.check_output(["ffmpeg", "-v", "error", "-i", str(path), "-vsync", "0",
                                    "-pix_fmt", "yuv444p16le", "-f", "rawvideo", "-"])


def reject(path, data, message="invalid video header or packet"):
    path.write_bytes(data)
    native = subprocess.run([str(binary), str(path)], capture_output=True, text=True)
    wasi = subprocess.run(["wasmtime", "run", "--dir", ".", str(wasm), path.name],
                          cwd=path.parent, capture_output=True, text=True)
    assert native.returncode == wasi.returncode == 1, (path.name, native, wasi)
    assert native.stdout == wasi.stdout, path.name
    assert message in native.stderr and message in wasi.stderr
    assert re.search(r"leakcheck: allocs=(\d+) frees=\1 live_bytes=0", native.stderr), native.stderr


def header_fields(path, name):
    run = subprocess.run(["ffmpeg", "-v", "trace", "-i", str(path), "-c:v", "copy", "-bsf:v", "trace_headers",
                          "-f", "null", "-"], capture_output=True, text=True)
    fields = re.findall(r"\[trace_headers[^\]]*\]\s+(\d+)\s+" + re.escape(name) + r"\s+([01]+)\s+=\s+(\d+)", run.stderr)
    assert fields, (path.name, run.stderr[-3000:])
    return [(int(at), bits, int(number)) for at, bits, number in fields]


def frame_number(path):
    at, bits, number = header_fields(path, "frame_num")[0]
    assert int(bits, 2) == int(number)
    return int(at), bits, int(number)


def escaped(raw):
    output = bytearray()
    zeros = 0
    for byte in raw:
        if zeros == 2 and byte <= 3:
            output.append(3)
            zeros = 0
        output.append(byte)
        zeros = zeros + 1 if byte == 0 else 0
    return bytes(output)


def idr_frame_numbers(directory, source):
    source_units = units(source.read_bytes())
    index = next(i for i, unit in enumerate(source_units) if unit[0] & 31 == 5)
    prefix = b"".join(b"\0\0\0\1" + unit for unit in source_units[:index])
    original = source_units[index]
    raw = re.sub(b"\0\0\x03", b"\0\0", original)
    assert escaped(raw) == original
    path = directory / ("idr-frame-" + source.name)
    path.write_bytes(prefix + b"\0\0\0\1" + original)
    at, field, number = frame_number(path)
    bits = "".join(f"{byte:08b}" for byte in raw)
    assert number == 0 and bits[at:at + len(field)] == field
    for value in sorted({1, 1 << (len(field) - 1), (1 << len(field)) - 1}):
        changed = bits[:at] + f"{value:0{len(field)}b}" + bits[at + len(field):]
        nal = escaped(bytes(int(changed[i:i + 8], 2) for i in range(0, len(changed), 8)))
        data = prefix + b"\0\0\0\1" + nal
        path.write_bytes(data)
        traced_at, traced_bits, traced_number = frame_number(path)
        assert (traced_at, len(traced_bits), traced_number) == (at, len(field), value)
        reject(path, data)
        print(f"{source.name}: CBS traces IDR frame_num={value}; native/WASI refusal follows H.264 7.4.3", flush=True)


def compare(path, frames, expected_planes=None):
    data = path.read_bytes()
    metadata = json.loads(subprocess.check_output(["ffprobe", "-v", "error", "-show_packets",
                                                  "-show_streams", "-show_entries", "packet=pos,size,flags:stream=width,height", "-of", "json", str(path)]))
    native = subprocess.check_output([str(binary), str(path)], text=True).splitlines()
    wasi = subprocess.check_output(["wasmtime", "run", "--dir", ".", str(wasm), path.name],
                                   cwd=path.parent, text=True).splitlines()
    assert native == wasi and len(native) == len(metadata["packets"]) == frames
    rebuilt = bytearray()
    for line, packet in zip(native, metadata["packets"], strict=True):
        tag, offset, idr, payload = line.split()
        at, size = int(packet["pos"]), int(packet["size"])
        original = units(data[at:at + size])
        canonical = b"".join(b"\x00\x00\x00\x01" + unit for unit in original)
        assert tag == "A" and int(offset) == at and bytes.fromhex(payload) == canonical
        assert int(idr) == int(any(unit[0] & 31 == 5 for unit in original))
        rebuilt += canonical
    restored = path.with_name("fern-" + path.name)
    restored.write_bytes(rebuilt)
    pixels = decoded(path)
    if expected_planes is not None:
        assert pixels == expected_planes, path.name
    info = metadata["streams"][0]
    assert pixels == decoded(restored) and len(pixels) == frames * int(info["width"]) * int(info["height"]) * 6
    print(f"{path.name}: {frames} native/WASI access units match FFprobe; all FFmpeg planes match", flush=True)


def end_markers(directory, baseline, reordered):
    prefix = b"\0\0\0\1"
    original = baseline.read_bytes()
    planes = decoded(baseline)
    for name, markers in (("sequence-end", (10,)), ("stream-end", (11,)), ("both-end-markers", (10, 11))):
        path = directory / (name + ".h264")
        path.write_bytes(original + b"".join(prefix + bytes([kind]) for kind in markers))
        compare(path, 18, planes)
    path = directory / "reordered-end-markers.h264"
    path.write_bytes(reordered.read_bytes() + prefix + b"\x0a" + prefix + b"\x0b")
    compare(path, 18, decoded(reordered))
    path = directory / "sequence-end-restart.h264"
    path.write_bytes(original + prefix + b"\x0a" + original)
    compare(path, 36, planes * 2)
    following = next(unit for unit in units(original) if unit[0] & 31 == 1)
    bad = {
        "sequence-end-payload": original + prefix + b"\x0a\x80",
        "stream-end-payload": original + prefix + b"\x0b\x80",
        "sequence-end-non-IDR": original + prefix + b"\x0a" + prefix + following,
        "stream-end-next-picture": original + prefix + b"\x0b" + original,
        "sequence-end-before-picture": prefix + b"\x0a" + original,
    }
    for name, data in bad.items():
        path = directory / (name + ".h264")
        reject(path, data)
        print(f"{name}: native/WASI refusal follows the H.264 end-marker rules", flush=True)


def parameter_reuse(directory):
    spec = importlib.util.spec_from_file_location("avc_input_vectors", ROOT / "scripts/gen-video-avc-input-fixtures.py")
    fixtures = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(fixtures)
    trace = fixtures.syntax.build_trace(name="avc-input-parameter-trace")
    messages = {"Header": "invalid video header or packet", "Truncated": "incomplete video packet"}
    for index, (name, before, after, picture, category) in enumerate(fixtures.incompatible_pairs()):
        for sequence, valid in ((before, True), (after, False)):
            pair = directory / "parameter-pair.bin"
            pair.write_bytes(sequence + b"\0\0\1" + picture)
            oracle = subprocess.run([str(trace), str(pair)], capture_output=True)
            assert (oracle.returncode == 0) == valid, oracle.stderr.decode()
        path = directory / f"stale-pps-{index}.h264"
        path.write_bytes(b"".join(b"\0\0\0\1" + unit for unit in
                                 (before, picture, fixtures.slice_nal(frame=1), after, fixtures.slice_nal(frame=2))))
        native = subprocess.run([str(binary), str(path)], capture_output=True, text=True)
        wasi = subprocess.run(["wasmtime", "run", "--dir", ".", str(wasm), path.name],
                              cwd=directory, capture_output=True, text=True)
        assert native.returncode == wasi.returncode == 1
        assert native.stdout == wasi.stdout and len(native.stdout.splitlines()) == 1
        assert messages[category] in native.stderr and messages[category] in wasi.stderr
        assert re.search(r"leakcheck: allocs=(\d+) frees=\1 live_bytes=0", native.stderr), native.stderr
        print(f"{name}: native/WASI refusal matches independent FFmpeg parameter checks", flush=True)


def zero_references(unit, at, field):
    raw = re.sub(b"\0\0\x03", b"\0\0", unit)
    assert escaped(raw) == unit
    bits = "".join(f"{byte:08b}" for byte in raw)
    assert bits[at:at + len(field)] == field
    changed = (bits[:at] + "1" + bits[at + len(field):]).rstrip("0")
    changed += "0" * (-len(changed) % 8)
    return escaped(bytes(int(changed[i:i + 8], 2) for i in range(0, len(changed), 8)))


def reference_counts(directory, baseline, reordered):
    intra = encode(directory, "zero-reference-intra", "high", "yuv420p", "keyint=1:min-keyint=1:bframes=0:slices=3:aud=1")
    assert all(value == 0 for _, _, value in header_fields(intra, "max_num_ref_frames"))
    assert all(value % 5 == 2 for _, _, value in header_fields(intra, "slice_type"))
    compare(intra, 18)
    for source in (baseline, reordered):
        data = source.read_bytes()
        packets = json.loads(subprocess.check_output(["ffprobe", "-v", "error", "-show_packets", "-of", "json", str(source)]))["packets"]
        original = [units(data[int(packet["pos"]):int(packet["pos"]) + int(packet["size"])]) for packet in packets]
        at, field, number = header_fields(source, "max_num_ref_frames")[0]
        assert number > 0
        positions = [i for i, group in enumerate(original) if any(unit[0] & 31 == 7 for unit in group)]
        assert len(positions) >= 2 and positions[0] == 0
        for index in positions[:2]:
            changed = [list(group) for group in original]
            changed[index] = [zero_references(unit, at, field) if unit[0] & 31 == 7 else unit for unit in changed[index]]
            path = directory / f"zero-reference-{source.stem}-{index}.h264"
            path.write_bytes(encoded_groups(changed))
            delimiter_extraction(path, changed)
            assert any(value == 0 for _, _, value in header_fields(path, "max_num_ref_frames"))
            kinds = [value % 5 for _, _, value in header_fields(path, "slice_type")]
            assert 0 in kinds and (source == baseline or 1 in kinds)
            reject(path, path.read_bytes())
    print("Four coded zero-reference refusals preserve exact FFmpeg extraction. Numeric CBS fields support specification-based decisions.", flush=True)


def encoded_groups(groups):
    return b"".join(b"\0\0\0\1" + unit for group in groups for unit in group)


def delimiter_extraction(path, groups):
    data = subprocess.check_output(["ffmpeg", "-v", "error", "-i", str(path), "-map", "0:v:0", "-c", "copy",
                                    "-bsf:v", "filter_units=pass_types=1|5|6|7|8|9|12", "-f", "h264", "-"])
    expected = [unit for group in groups for unit in group if unit[0] & 31 in (1, 5, 6, 7, 8, 9, 12)]
    assert units(data) == expected, path.name


def delimiter_controls(directory, original):
    spec = importlib.util.spec_from_file_location("avc_delimiter_vectors", ROOT / "scripts/gen-video-avc-input-fixtures.py")
    fixtures = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(fixtures)
    trace = fixtures.syntax.build_trace(name="avc-input-aud-trace")
    for value in range(256):
        path = directory / "aud-syntax.bin"
        path.write_bytes(b"\0\0\0\1\x09" + bytes([value]))
        oracle = subprocess.run([str(trace), str(path)], capture_output=True, text=True)
        assert (oracle.returncode == 0) == (value & 31 == 16), (value, oracle.stderr)
        if oracle.returncode == 0:
            fields = fixtures.syntax.references.trace_fields(oracle.stderr)
            assert fields["primary_pic_type"] == value >> 5 and fields["rbsp_stop_one_bit"] == 1
    path.write_bytes(b"\0\0\0\1\x09")
    assert subprocess.run([str(trace), str(path)], capture_output=True).returncode != 0
    print("CBS checks all 256 delimiter bytes and rejects the empty payload", flush=True)
    data = original.read_bytes()
    packets = json.loads(subprocess.check_output(["ffprobe", "-v", "error", "-show_packets", "-of", "json", str(original)]))["packets"]
    groups = [[b"\x09\xf0", *units(data[int(packet["pos"]):int(packet["pos"]) + int(packet["size"])])]
              for packet in packets]
    assert len(groups) == 18 and all(sum(unit[0] & 31 == 9 for unit in group) == 1 for group in groups)
    path = directory / "universal-picture-delimiters.h264"
    path.write_bytes(encoded_groups(groups))
    delimiter_extraction(path, groups)
    compare(path, 18, decoded(original))
    traced = subprocess.run(["ffmpeg", "-v", "trace", "-i", str(path), "-c:v", "copy", "-bsf:v", "trace_headers",
                             "-f", "null", "-"], capture_output=True, text=True, check=True)
    fields = re.findall(r"primary_pic_type\s+[01]+\s+=\s+(\d+)", traced.stderr)
    assert fields == ["7"] * 18, fields
    sei = next(unit for group in groups for unit in group if unit[0] & 31 == 6)
    payloads = [("empty", b"\x09", "incomplete video packet"),
                ("alignment", b"\x09\xf1", "invalid video header or packet"),
                ("stop", b"\x09\xe0", "invalid video header or packet"),
                ("extra80", b"\x09\xf0\x80", "invalid video header or packet"),
                ("extraFF", b"\x09\xf0\xff", "invalid video header or packet"),
                ("extra01", b"\x09\xf0\x01", "invalid video header or packet")]
    for index in (0, 6):
        for name, unit, message in payloads:
            changed = [list(group) for group in groups]
            changed[index][0] = unit
            path = directory / f"invalid-aud-{index}-{name}.h264"
            path.write_bytes(encoded_groups(changed))
            delimiter_extraction(path, changed)
            reject(path, path.read_bytes(), message)
        for kind in (6, 7, 8, 9):
            changed = [list(group) for group in groups]
            if kind == 6:
                changed[index].insert(0, sei)
            elif kind == 9:
                changed[index].insert(0, b"\x09\xf0")
            else:
                aud = changed[index].pop(0)
                at = next(i for i, unit in enumerate(changed[index]) if unit[0] & 31 == kind)
                changed[index].insert(at + 1, aud)
            path = directory / f"invalid-aud-{index}-after-{kind}.h264"
            path.write_bytes(encoded_groups(changed))
            delimiter_extraction(path, changed)
            reject(path, path.read_bytes())
    print("20 coded delimiter payload or position refusals preserve exact FFmpeg extraction", flush=True)


def filler_positions(directory, source):
    data = source.read_bytes()
    packets = json.loads(subprocess.check_output(["ffprobe", "-v", "error", "-show_packets", "-of", "json", str(source)]))["packets"]
    original = [units(data[int(packet["pos"]):int(packet["pos"]) + int(packet["size"])]) for packet in packets]
    filler = b"\x0c\xff\x80"
    groups = [list(group) for group in original]
    for group in groups:
        slices = [i for i, unit in enumerate(group) if unit[0] & 31 in (1, 5)]
        assert len(slices) >= 2
        group[slices[0] + 1:slices[0] + 1] = [filler, b"\x0c\x80"]
    path = directory / "filler-between-coded-slices.h264"
    path.write_bytes(encoded_groups(groups))
    delimiter_extraction(path, groups)
    compare(path, 18, decoded(source))
    for index in (0, 6):
        for prefix in (None, 9, 7, 8):
            changed = [list(group) for group in original]
            group = changed[index]
            at = 0 if prefix is None else next(i for i, unit in enumerate(group) if unit[0] & 31 == prefix) + 1
            group.insert(at, filler)
            suffix = index > 0 and prefix is None
            name = "filler-before-next-aud.h264" if suffix else f"invalid-filler-position-{index}-{prefix}.h264"
            path = directory / name
            path.write_bytes(encoded_groups(changed))
            delimiter_extraction(path, changed)
            if suffix:
                compare(path, 18, decoded(source))
            else:
                reject(path, path.read_bytes())
    print("Seven coded filler-position refusals preserve exact FFmpeg extraction and follow H.264 7.4.1.2.3", flush=True)


def filler_controls(directory, baseline, reordered):
    spec = importlib.util.spec_from_file_location("avc_filler_vectors", ROOT / "scripts/gen-video-avc-input-fixtures.py")
    fixtures = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(fixtures)
    trace = fixtures.syntax.build_trace(name="avc-input-filler-trace")
    lengths = (0, 1, 31, 255, 4095)
    for count in lengths:
        path = directory / "filler-syntax.bin"
        path.write_bytes(b"\0\0\0\1\x0c" + b"\xff" * count + b"\x80")
        oracle = subprocess.run([str(trace), str(path)], capture_output=True, text=True, check=True)
        fields = fixtures.syntax.references.trace_fields(oracle.stderr)
        assert fields["rbsp_stop_one_bit"] == 1
    for payload in (b"", b"\xff\x01"):
        path.write_bytes(b"\0\0\0\1\x0c" + payload)
        assert subprocess.run([str(trace), str(path)], capture_output=True).returncode != 0
    print("CBS reads five filler lengths and refuses empty or zero-stop payloads", flush=True)
    for original in (baseline, reordered):
        data = original.read_bytes()
        packets = json.loads(subprocess.check_output(["ffprobe", "-v", "error", "-show_packets", "-of", "json", str(original)]))["packets"]
        groups = [units(data[int(packet["pos"]):int(packet["pos"]) + int(packet["size"])])
                  + [b"\x0c" + b"\xff" * lengths[index % len(lengths)] + b"\x80"]
                  for index, packet in enumerate(packets)]
        path = directory / ("filler-lengths-" + original.name)
        path.write_bytes(encoded_groups(groups))
        delimiter_extraction(path, groups)
        compare(path, 18, decoded(original))
        if original != baseline:
            continue
        bad = [("empty", b"", "incomplete video packet"),
               ("missing-stop", b"\xff", "invalid video header or packet"),
               ("first", b"\x01\xff\x80", "invalid video header or packet"),
               ("later", b"\xff\x01\xff\x80", "invalid video header or packet"),
               ("early-stop", b"\x80\xff\x80", "invalid video header or packet"),
               ("alignment", b"\xff\xff\x81", "invalid video header or packet"),
               ("extra80", b"\xff\x80\x80", "invalid video header or packet"),
               ("extraFF", b"\xff\x80\xff", "invalid video header or packet"),
               ("extra01", b"\xff\x80\x01", "invalid video header or packet")]
        for index in (0, 6):
            for name, payload, message in bad:
                changed = [list(group) for group in groups]
                changed[index][-1] = b"\x0c" + payload
                path = directory / f"invalid-filler-{index}-{name}.h264"
                path.write_bytes(encoded_groups(changed))
                delimiter_extraction(path, changed)
                reject(path, path.read_bytes(), message)
    print("18 coded filler refusals preserve exact FFmpeg extraction and follow the H.264 syntax", flush=True)


with tempfile.TemporaryDirectory() as temporary:
    directory = Path(temporary)
    cases = [
        ("baseline", "baseline", "yuv420p", "bframes=0:slices=1:aud=0"),
        ("cropped", "baseline", "yuv420p", "bframes=0:slices=3:aud=0", "62x46"),
        ("baseline-slices", "baseline", "yuv420p", "bframes=0:slices=3:aud=1"),
        ("main-bframes", "main", "yuv420p", "bframes=2:slices=3:aud=0"),
        ("high-aud", "high", "yuv420p", "bframes=3:slices=3:aud=1"),
        ("high10", "high10", "yuv420p10le", "bframes=2:slices=3:aud=0"),
        ("high422", "high422", "yuv422p", "bframes=2:slices=2:aud=0"),
        ("high444", "high444", "yuv444p", "bframes=2:slices=3:aud=0"),
        ("nonzero-ids", "high", "yuv420p", "bframes=2:slices=3:aud=0:sps-id=17"),
        ("open-gop", "high", "yuv420p", "bframes=3:slices=3:aud=0:open-gop=1"),
        ("cbr-filler", "high", "yuv420p", "bframes=2:slices=3:aud=1:nal-hrd=cbr:vbv-bufsize=128:vbv-maxrate=128:bitrate=128:force-cfr=1"),
    ]
    paths = []
    for case in cases:
        path = encode(directory, *case)
        compare(path, 18)
        paths.append(path)
    joined = directory / "parameter-replacement.h264"
    joined.write_bytes(paths[3].read_bytes() + paths[5].read_bytes())
    compare(joined, 36)
    end_markers(directory, paths[0], paths[3])
    for source in (paths[0], paths[3], paths[5]):
        idr_frame_numbers(directory, source)
    parameter_reuse(directory)
    delimiter_controls(directory, paths[0])
    filler_controls(directory, paths[0], paths[3])
    filler_positions(directory, paths[2])
    reference_counts(directory, paths[0], paths[3])
