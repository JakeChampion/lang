// The TLS server scripts/net-tls-fuzz runs tlsfuzzer against: everything a
// connection sends is answered with one HTTP response, or echoed under
// MODE=echo, until it ends. TLS_CERT and TLS_KEY are its identity,
// TLS_CLIENT_CA the roots a client certificate must reach, when it is to
// require one, and PORT where it listens on the loopback.
import "std/i32";
import "std/net";
import "std/time";
import "std/tls/identity";
import "std/tls/server";
import "std/tls/verify";
import "core/int";
import "std/rand";

function identity_of(cert_path: string, key_path: string): Result[identity.Identity, string] {
  let Ok(cert) = read_file(cert_path) else {
    return Err("cannot read " + cert_path);
  };
  let Ok(key) = read_file(key_path) else {
    return Err("cannot read " + key_path);
  };
  return match (identity.from_pem(cert, key)) { Ok(id) => Ok(id), Err(e) => Err(e.message()) };
}

function serve_one(fd: i32, cfg: server.Config, echo: boolean): string {
  return match (server.accept(fd, cfg, time.duration_seconds(5))) { Ok(c) => answer(c, echo, 0), Err(e) => "accept: " + e.message() };
}

function answer(c: server.Connection, echo: boolean, answered: i32): string {
  match (c.read(time.duration_seconds(5))) {
    Ok(got) => {
      if (got.ended && got.data.len() == 0) {
        got.conn.close();
        return f"answered {answered} then closed";
      }
      let reply = if (echo) { got.data } else { "HTTP/1.0 200 OK\r\nContent-Length: 5\r\n\r\nhello".bytes() };
      match (got.conn.write(reply)) {
        Ok(sent) => {
          if (got.ended) {
            sent.close();
            return f"answered {answered + 1} then closed";
          }
          return answer(sent, echo, answered + 1);
        },
        Err(e) => {
          return "send: " + e.message();
        }
      }
    },
    Err(e) => {
      c.close();
      return "recv: " + e.message();
    }
  }
}

function setting(name: string, fallback: string): string {
  return match (env(name)) { Some(v) => v, None => fallback };
}

function configured(): Result[server.Config, string] {
  let id = identity_of(setting("TLS_CERT", "leaf.pem"), setting("TLS_KEY", "leaf.key"))?;
  let cfg = server.config(id, rand.bytes(32)).with_alpn(["http/1.1"]);
  let Some(path) = env("TLS_CLIENT_CA") else {
    return Ok(cfg);
  };
  return match (verify.roots_from_file(path)) { Ok(roots) => Ok(cfg.with_client_roots(roots)), Err(e) => Err("roots: " + e.message()) };
}

function listening(): Result[i32, string] {
  let Ok(port) = i32.parse_i32_radix(setting("PORT", "8443"), 10) else {
    return Err("PORT is not a number");
  };
  return match (net.listen_at(net.socket_addr(net.ipv4_loopback(), port), net.listen_options())) { Ok(fd) => Ok(fd), Err(e) => Err("listen: " + e.message()) };
}

function main(): i32 {
  let cfg = match (configured()) { Ok(c) => c, Err(e) => { print(e); return 2; } };
  let l = match (listening()) { Ok(fd) => fd, Err(e) => { print(e); return 3; } };
  let echo = setting("MODE", "http") == "echo";
  loop {
    match (net.accept(l)) {
      Ok(fd) => {
        print(serve_one(fd, cfg, echo));
      },
      Err(e) => {
        print("accept " + e.message());
      }
    }
  }
}
