#!/usr/bin/env bash
#
# selfhost-emit-hashes — byte-identity gate for pure refactors of the self-host
# compiler.
#
# Builds every fixture in conformance/cases with a self-host compiler binary,
# on all three backends, and writes one sha256 per (fixture, target). Run it
# before and after a refactor and diff the two files: if the refactor was pure,
# they are identical.
#
# It hashes the ASSEMBLED ARTIFACT — the x86-64 and arm64 ELF, the wasm module —
# not emitted `.s` text: the default path runs a plain `-o` build, so the
# in-process assembler is inside what is being compared. That matters for a
# change to the assembler itself, where an asm-text hash would be invariant by
# construction and prove nothing. (`--ssa` builds every case with
# `-backend ssa`, the register-allocating emitter, and hashes the same
# artifact. Since the arm64 flip that is also what the DEFAULT sweep emits
# for arm64, so `--ssa` now differs from it only on x86-64, where the stack
# machine is still the default.)
#
# This exists because the compiler's own type system cannot catch the mistakes
# a mechanical refactor makes. Whole families of values here share one type —
# the FnSigs registries are all `string[]`, the IR ops are all `ir.Op` — so a
# crossed wire or a dropped argument type-checks cleanly and shows up only as
# a miscompile. And per docs/TEST-GATES.md the self-compile fixpoint is
# SELF-REFERENTIAL: it proves the compiler reproduces itself, and is
# structurally blind to a stable miscompile. Comparing emitted bytes over a
# broad corpus is the check that actually bites.
#
#   usage: scripts/selfhost-emit-hashes [--ssa] <compiler-binary> <output-file>
#
#   make selfhost-cli
#   cp bin/fern-selfhost /tmp/before          # on the base commit
#   scripts/selfhost-emit-hashes /tmp/before /tmp/hashes-before.txt
#   ...apply the refactor, make selfhost-cli again...
#   scripts/selfhost-emit-hashes bin/fern-selfhost /tmp/hashes-after.txt
#   diff /tmp/hashes-before.txt /tmp/hashes-after.txt && echo PURE
#
# Runs ~4 minutes for the corpus's (fixture, target) pairs — three per fixture,
# so 1644 at the 548 fixtures of 2026-09-05, measured that day on a 4-core dev
# container with a second sweep running alongside it. The count moves with the
# corpus and the runtime moves with the compiler; take both from a completed
# run, not from this comment. Fixtures the
# compiler refuses are recorded as FAILED rather than skipped, so a refactor
# that changes WHICH programs compile shows up as a diff too.
#
# --ssa builds every native case with `-backend ssa` (docs/SELFHOST-SSA-BACKEND.md)
# instead of the stack machine. That backend declines a function it cannot
# lift and emits it flat, so every case builds; a purity sweep of it is this
# script's default sweep with the flag. wasm has no SSA backend and is skipped.

set -u

SSA=0
if [ "${1:-}" = "--ssa" ]; then
    SSA=1
    shift
fi
BIN="${1:-}"
OUT="${2:-}"
if [ -z "$BIN" ] || [ -z "$OUT" ]; then
    echo "usage: $0 [--ssa] <compiler-binary> <output-file>" >&2
    exit 2
fi
if [ ! -x "$BIN" ]; then
    echo "$0: $BIN is not an executable" >&2
    exit 2
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STD="$ROOT/internal/stdlib"
CASES="$ROOT/conformance/cases"

# The self-host compiler needs ABSOLUTE paths: a relative one is unopenable
# from an arm64-darwin binary (AT_FDCWD is -2 on XNU, not -100).
BIN="$(cd "$(dirname "$BIN")" && pwd)/$(basename "$BIN")"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
: > "$OUT"

for f in $(find "$CASES" -name '*.fern' | sort); do
    for tgt in x86-64-linux arm64-linux wasm32-wasi; do
        o="$TMP/out"
        if [ "$SSA" -eq 1 ] && [ "$tgt" = wasm32-wasi ]; then
            continue
        fi
        backend=""
        if [ "$SSA" -eq 1 ]; then backend="-backend ssa"; fi
        # shellcheck disable=SC2086
        if "$BIN" $backend -target "$tgt" "$f" "$STD" -o "$o" >/dev/null 2>&1 && [ -s "$o" ]; then
            printf '%s  %s  %s\n' "$(sha256sum < "$o" | cut -d' ' -f1)" "$tgt" "${f#"$CASES"/}" >> "$OUT"
        else
            printf 'FAILED%058d  %s  %s\n' 0 "$tgt" "${f#"$CASES"/}" >> "$OUT"
        fi
        rm -f "$o"
    done
done

ok=$(grep -vc '^FAILED' "$OUT" || true)
bad=$(grep -c '^FAILED' "$OUT" || true)
echo "$(wc -l < "$OUT") rows written to $OUT ($ok emitted, $bad refused)"

# A run where nothing emitted is indistinguishable from a pure refactor: both
# sides of the diff carry the same placeholders, so the comparison reports PURE
# for any change at all. That is how a wrong -target spelling once made this
# gate vacuous rather than red. Every row is now a real artifact hash in both
# modes, so one real row is enough to tell the two apart.
if [ "$ok" -lt 1 ]; then
    echo "$0: no row emitted — the comparison would be between placeholders" >&2
    echo "  and would call any refactor pure." >&2
    echo "  Check that $BIN runs, that the -target spellings above are ones it" >&2
    echo "  accepts, and under --ssa that it accepts -backend ssa." >&2
    exit 1
fi
