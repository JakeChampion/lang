import "core/cmp";
import "std/deflate";
import "std/i64";
import "std/i32";
import "std/option";
import "std/result";

function median(xs: i64[]): i64 {
  let s = cmp.sort(xs);
  return s[s.len() / 2];
}

function load(path: string): u8[] {
  let Ok(b) = read_file_bytes(path) else {
    eprint("fbench: cannot read " + path);
    exit(2);
    return [];
  };
  return b;
}

function same(a: u8[], b: u8[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

function decode_runs(stream: u8[], orig: u8[], runs: i32): i64 {
  let times: i64[] = [];
  for _ in 0..runs {
    let t0 = now_ns();
    let out: u8[] = [];
    match (deflate.inflate(stream, orig.len())) {
      Ok(inf) => {
        out = inf.out;
      },
      Err(e) => {
        eprint("fbench: inflate failed: " + e.message());
        exit(3);
      }
    }
    times = times.append(now_ns() - t0);
    if (!same(out, orig)) {
      eprint("fbench: round trip differs");
      exit(4);
    }
  }
  return median(times);
}

function main(): i32 {
  let argv = args();
  if (argv.len() >= 5 && argv[1] == "c") {
    let input = load(argv[2]);
    let runs = i32.parse_i32(argv[3]).unwrap_or(1);
    let times: i64[] = [];
    let stream: u8[] = [];
    for _ in 0..runs {
      let t0 = now_ns();
      stream = deflate.deflate(input);
      times = times.append(now_ns() - t0);
    }
    if let Err(_) = write_file_bytes(argv[4], stream) {
      eprint("fbench: cannot write " + argv[4]);
      return 2;
    }
    let d = decode_runs(stream, input, runs);
    print(f"in={input.len()} out={stream.len()} comp_ns={median(times)} decomp_ns={d}");
    return 0;
  }
  if (argv.len() >= 5 && argv[1] == "d") {
    let d = decode_runs(load(argv[2]), load(argv[3]), i32.parse_i32(argv[4]).unwrap_or(1));
    print(f"decomp_ns={d}");
    return 0;
  }
  eprint("usage: fbench c FILE RUNS OUT | fbench d STREAM ORIG RUNS");
  return 2;
}
