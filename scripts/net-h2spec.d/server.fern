// The server h2spec drives: std/serve with HTTP/2 on, answering every
// request with a small body, so each conformance case sees a server that
// takes the request it sends and answers the frames it checks.
import "std/i32";
import "std/result";
import "std/http";
import "std/platform";
import "std/serve";
import "std/tls/identity";
import "std/tls/server";
import "std/rand";

function handle(req: HttpRequest, plat: platform.Host): HttpResponse {
  if (req.method == "POST") {
    return http.text(200, f"took {req.body_bytes().len()} bytes");
  }
  return http.ok("hello");
}

function port(): i32 {
  let Some(p) = env("PORT") else {
    return 8080;
  };
  return i32.parse_i32_radix(p, 10).unwrap_or(8080);
}

function tls_config(cfg: serve.Config): Result[serve.Config, string] {
  let Some(cert_path) = env("TLS_CERT") else {
    return Ok(cfg);
  };
  let Some(key_path) = env("TLS_KEY") else {
    return Err("TLS_CERT without TLS_KEY");
  };
  let Ok(cert) = read_file(cert_path) else {
    return Err("TLS_CERT could not be read");
  };
  let Ok(key) = read_file(key_path) else {
    return Err("TLS_KEY could not be read");
  };
  return match (identity.from_pem(cert, key)) { Ok(id) => Ok(cfg.with_tls(server.config(id, rand.bytes(32)))), Err(e) => Err(e.message()) };
}

function main(): i32 {
  match (tls_config(serve.config().with_h2())) {
    Ok(cfg) => {
      return serve.exit_code(serve.run(port(), cfg, handle));
    },
    Err(message) => {
      eprint(message);
      return 2;
    }
  }
}
