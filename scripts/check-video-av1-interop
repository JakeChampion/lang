#!/usr/bin/env python3
"""Compare bounded AV1 OBU ranges with FFmpeg CBS and independent decoders."""
import importlib.util
import os
from pathlib import Path
import re
import struct
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
spec = importlib.util.spec_from_file_location('av1_fixtures', ROOT / 'scripts/gen-video-av1-fixtures.py')
fixtures = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fixtures)
compiler = os.environ.get('FERN') or subprocess.check_output(['./bootstrap/bootstrap.sh', 'stage0'], text=True).strip()
target = {'x86_64': 'x86-64-linux', 'aarch64': 'arm64-linux', 'arm64': 'arm64-darwin'}[os.uname().machine]
binary = ROOT / 'build/video/av1-obu-reference'
binary.parent.mkdir(parents=True, exist_ok=True)
wasm = binary.with_suffix('.wasm')
for output, architecture, flags in ((binary, target, ['-sanitize']), (wasm, 'wasm32-wasi', [])):
    subprocess.run([compiler, '-stdlib', str(ROOT / 'internal/stdlib'), '-target', architecture, *flags,
                    '-o', str(output), 'scripts/video-reference/av1.fern'], check=True)

metadata_binary = ROOT / 'build/video/av1-metadata-reference'
metadata_wasm = metadata_binary.with_suffix('.wasm')
for output, architecture, flags in ((metadata_binary, target, ['-sanitize']), (metadata_wasm, 'wasm32-wasi', [])):
    subprocess.run([compiler, '-stdlib', str(ROOT / 'internal/stdlib'), '-target', architecture, *flags,
                    '-o', str(output), 'scripts/video-reference/av1-metadata.fern'], check=True)

annex_binary = ROOT / 'build/video/av1-annex-b-reference'
annex_wasm = annex_binary.with_suffix('.wasm')
for output, architecture, flags in ((annex_binary, target, ['-sanitize']), (annex_wasm, 'wasm32-wasi', [])):
    subprocess.run([compiler, '-stdlib', str(ROOT / 'internal/stdlib'), '-target', architecture, *flags,
                    '-o', str(output), 'scripts/video-reference/av1-annex-b.fern'], check=True)


def run(directory, name, packet, error=None):
    path = directory / (name + '.obu')
    path.write_bytes(packet)
    native = subprocess.run([str(binary), str(path)], text=True, capture_output=True)
    wasi = subprocess.run(['wasmtime', 'run', '--dir', '.', str(wasm), path.name],
                          cwd=directory, text=True, capture_output=True)
    assert native.returncode == (3 if error else 0), (name, native)
    assert wasi.returncode == (1 if error else 0), (name, wasi)
    assert 'live_bytes=0' in native.stderr, native.stderr
    assert native.stdout == wasi.stdout, name
    if error:
        assert native.stderr.splitlines()[0] == wasi.stderr.splitlines()[0] == error
    return native.stdout.splitlines()


def compare(directory, name, packet, units):
    expected = []
    for kind, offset, size, temporal, spatial, extension in units:
        expected += [f'{kind} {offset} {size} {temporal} {spatial} {extension}', packet[offset:offset + size].hex()]
    actual = run(directory, name, packet)
    assert actual == expected, name
    print(name + ': native/real-WASI OBU fields and every payload byte match FFmpeg CBS', flush=True)
    return [tuple(map(int, actual[i].split())) for i in range(0, len(actual), 2)]


def decode(path, decoder, pixel_format):
    return subprocess.check_output(['ffmpeg', '-v', 'error', '-xerror', '-c:v', decoder, '-i', str(path),
                                    '-pix_fmt', pixel_format, '-f', 'rawvideo', '-'])


def leb(value, width=1):
    result = bytearray()
    for i in range(width):
        result.append((value & 127) | (128 if i + 1 < width else 0))
        value >>= 7
    assert value == 0
    return bytes(result)


def metadata_obu(kind, values, type_width=1, size_width=1, padding=0, extension=False):
    payload = leb(kind, type_width) + struct.pack('>2H' if kind == 1 else '>8H2I', *values) + b'\x80' + bytes(padding)
    return bytes([0x2e, 0]) + leb(len(payload), size_width) + payload if extension else bytes([0x2a]) + leb(len(payload), size_width) + payload


def metadata_fields(path):
    result = subprocess.run(['ffmpeg', '-v', 'verbose', '-i', str(path), '-c:v', 'copy',
                             '-bsf:v', 'trace_headers', '-f', 'null', '-'], capture_output=True, text=True)
    assert result.returncode == 0 and 'Failed to read unit' not in result.stderr, result.stderr
    fields = {}
    for line in result.stderr.splitlines():
        if '[trace_headers ' not in line:
            continue
        match = re.search(r'\]\s+\d+\s+(\S+)\s+.*?=\s*(\d+)\s*$', line)
        if match:
            fields[match[1]] = int(match[2])
    kind = fields['metadata_type']
    names = ['max_cll', 'max_fall'] if kind == 1 else [
        name for i in range(3) for name in (f'primary_chromaticity_x[{i}]', f'primary_chromaticity_y[{i}]')]
    if kind == 2:
        names += ['white_point_chromaticity_x', 'white_point_chromaticity_y', 'luminance_max', 'luminance_min']
    return [kind] + [fields[name] for name in names]


def read_metadata(directory, name, packet, error=False):
    path = directory / (name + '.metadata')
    path.write_bytes(packet)
    native = subprocess.run([str(metadata_binary), str(path)], text=True, capture_output=True)
    wasi = subprocess.run(['wasmtime', 'run', '--dir', '.', str(metadata_wasm), path.name],
                          cwd=directory, text=True, capture_output=True)
    assert native.returncode == (3 if error else 0), (name, native)
    assert wasi.returncode == (1 if error else 0), (name, wasi)
    assert 'live_bytes=0' in native.stderr and native.stdout == wasi.stdout, (name, native, wasi)
    if error:
        assert native.stderr.splitlines()[0] == wasi.stderr.splitlines()[0] == 'invalid video header or packet'
    return [int(value) for value in native.stdout.split()]


def check_metadata(directory, stream):
    original, pixel_format, packets, layouts = stream
    base = packets[0][1]
    sequence_end = next(offset + size for kind, offset, size, *_ in layouts[0] if kind == 1)
    mixed = [1, 65535, 258, 772, 1286, 1800, 2314, 2828, 4294967295, 2147483648]
    representative = [41943, 21627, 19661, 39322, 9830, 3932, 20495, 21561, 256000, 164]
    cases = [(f'cll-{i}', 1, values, {}) for i, values in enumerate(([0, 0], [1000, 400], [65535, 65535]))]
    cases += [(f'mdcv-{i}', 2, values, {}) for i, values in enumerate(([0] * 10, mixed, representative))]
    cases += [('cll-widths', 1, [1000, 400], dict(type_width=8, size_width=8)),
              ('mdcv-widths', 2, mixed, dict(type_width=8, size_width=8)),
              ('cll-padding', 1, [1000, 400], dict(padding=3)),
              ('mdcv-padding', 2, representative, dict(padding=3))]
    reference = decode(original, 'libaom-av1', pixel_format)
    assert decode(original, 'libdav1d', pixel_format) == reference
    for name, kind, values, options in cases:
        unit = metadata_obu(kind, values, **options)
        modified = [(packets[0][0], base[:sequence_end] + unit + base[sequence_end:])] + packets[1:]
        path = directory / (name + '.ivf')
        path.write_bytes(fixtures.ivf(original.read_bytes(), modified))
        expected = metadata_fields(path)
        assert expected == [kind] + values, (name, expected)
        assert read_metadata(directory, name, unit) == expected, name
        assert decode(path, 'libaom-av1', pixel_format) == decode(path, 'libdav1d', pixel_format) == reference, name
        print(name + ': all HDR fields match CBS and native/WASI; both decoders preserve all planes', flush=True)
    for kind, values in ((1, [1000, 400]), (2, representative)):
        read_metadata(directory, f'hdr-extension-{kind}', metadata_obu(kind, values, extension=True), error=True)


def length(value, width):
    return leb(value, max(width, max(1, (value.bit_length() + 6) // 7)))


def annex_packet(packet, layout, sized, width, position):
    body = bytearray()
    expected = []
    start = 0
    for kind, offset, size, temporal, spatial, extension in layout:
        header = bytes([(packet[start] | 2) if sized else (packet[start] & ~2)])
        header += packet[start + 1:start + 1 + extension]
        encoded_size = length(size, width) if sized else b''
        obu = header + encoded_size + packet[offset:offset + size]
        prefix = length(len(obu), width)
        expected.append((kind, len(body) + len(prefix) + len(header) + len(encoded_size),
                         size, temporal, spatial, extension, packet[offset:offset + size].hex()))
        body += prefix + obu
        start = offset + size
    assert start == len(packet)
    frame_prefix = length(len(body), width)
    temporal_prefix = length(len(frame_prefix) + len(body), width)
    frame_start = position + len(temporal_prefix) + len(frame_prefix)
    lines = [f'T {position + len(temporal_prefix)} {len(frame_prefix) + len(body)} {frame_start + len(body)}',
             f'F {frame_start} {len(body)}']
    for kind, offset, size, temporal, spatial, extension, payload in expected:
        lines += [f'U {kind} {frame_start + offset} {size} {temporal} {spatial} {extension}', payload]
    return temporal_prefix + frame_prefix + body, lines


def check_annex(directory, stream):
    original, pixel_format, packets, layouts = stream
    reference = decode(original, 'libaom-av1', pixel_format)
    for sized, width in ((False, 1), (True, 1), (True, 8)):
        data = bytearray()
        expected = []
        streamed_expected = []
        for (_, packet), layout in zip(packets, layouts, strict=True):
            encoded, lines = annex_packet(packet, layout, sized, width, len(data))
            streamed_expected += [f'P {len(data)} {encoded.hex()}'] + lines
            data += encoded
            expected += lines
        path = directory / f'{pixel_format}-{sized}-{width}.annexb'
        path.write_bytes(data)
        native = subprocess.run([str(annex_binary), str(path)], capture_output=True, text=True)
        wasi = subprocess.run(['wasmtime', 'run', '--dir', '.', str(annex_wasm), path.name],
                              cwd=directory, capture_output=True, text=True)
        assert native.returncode == wasi.returncode == 0, (native, wasi)
        assert re.search(r'leakcheck: allocs=(\d+) frees=\1 live_bytes=0', native.stderr), native.stderr
        assert native.stdout.splitlines() == wasi.stdout.splitlines() == expected
        for chunk in (1, 3, 31):
            sequential = subprocess.run([str(annex_binary), '--stream', str(path), str(chunk)], capture_output=True, text=True)
            sequential_wasi = subprocess.run(['wasmtime', 'run', '--dir', '.', str(annex_wasm), '--stream', path.name, str(chunk)],
                                             cwd=directory, capture_output=True, text=True)
            assert sequential.returncode == sequential_wasi.returncode == 0, (sequential, sequential_wasi)
            assert re.search(r'leakcheck: allocs=([1-9]\d*) frees=\1 live_bytes=0', sequential.stderr), sequential.stderr
            assert sequential.stdout.splitlines() == sequential_wasi.stdout.splitlines() == streamed_expected
        for decoder in ('libaom-av1', 'libdav1d'):
            planes = subprocess.check_output(['ffmpeg', '-v', 'error', '-xerror', '-f', 'av1', '-c:v', decoder,
                                              '-i', str(path), '-pix_fmt', pixel_format, '-f', 'rawvideo', '-'])
            assert planes == reference, (path.name, decoder)
        print(f'{path.name}: complete-view and streamed native/WASI ranges match CBS source at chunks 1/3/31; both decoders preserve all planes', flush=True)


with tempfile.TemporaryDirectory() as temporary:
    directory = Path(temporary)
    vectors, streams = fixtures.generate(directory)
    actual = {}
    for name, packet, units in vectors:
        actual[name] = compare(directory, name, packet, units)
    for original, pixel_format, values, layouts in streams:
        check_annex(directory, (original, pixel_format, values, layouts))
        stripped = []
        for index, (timestamp, packet) in enumerate(values):
            units = actual[pixel_format + '-' + str(index)]
            output = bytearray()
            at = 0
            for kind, offset, size, *_ in units:
                if kind != 15:
                    output += packet[at:offset + size]
                at = offset + size
            stripped.append((timestamp, output))
        clean = directory / ('clean-' + original.name)
        clean.write_bytes(fixtures.ivf(original.read_bytes(), stripped))
        reference = decode(original, 'libaom-av1', pixel_format)
        samples = 64 * 36 * (3 if '444' in pixel_format else 2 if '422' in pixel_format else 1.5)
        expected_bytes = int(samples) * (1 if pixel_format.endswith('p') else 2) * 3
        assert len(reference) == expected_bytes
        assert decode(original, 'libdav1d', pixel_format) == reference
        assert decode(clean, 'libaom-av1', pixel_format) == decode(clean, 'libdav1d', pixel_format) == reference
        print(pixel_format + ': every 8/10/12-bit plane matches libaom and dav1d after padding removal', flush=True)
    check_metadata(directory, streams[1])
    base = vectors[0][1]
    for name, suffix, diagnostic, error in [
            ('forbidden', bytes([0xfa, 0]), 'obu_forbidden_bit out of range', 'invalid video header or packet'),
            ('reserved', bytes([0x7b, 0]), 'obu_reserved_1bit out of range', 'invalid video header or packet'),
            ('extension-reserved', bytes([0x7e, 1, 0]), 'extension_header_reserved_3bits out of range', 'invalid video header or packet'),
            ('truncated', bytes([0x7a, 0x7f]), 'Invalid OBU length', 'incomplete video packet')]:
        packet = base + suffix
        run(directory, name, packet, error)
        path = directory / (name + '.ivf')
        path.write_bytes(fixtures.ivf(streams[0][0].read_bytes(), [(0, packet)]))
        result = subprocess.run(['ffmpeg', '-v', 'verbose', '-i', str(path), '-c:v', 'copy',
                                 '-bsf:v', 'trace_headers', '-f', 'null', '-'], capture_output=True, text=True)
        assert diagnostic in result.stderr and 'Failed to parse temporal unit' in result.stderr, result.stderr
    # The AV1 leb128 conformance rule requires byte-eight termination. FFmpeg 7 accepts this violation.
    run(directory, 'unterminated', base + bytes([0x7a]) + bytes([0x80] * 8), 'invalid video header or packet')
    # AV1 section 6.2.2 forbids extensions on OBUs that are not layer-specific.
    for kind in (1, 2, 8):
        for extra in (0, 0xf8):
            packet = base + bytes([kind * 8 + 6, extra, 0])
            run(directory, f'non-layer-extension-{kind}-{extra}', packet, 'invalid video header or packet')
    print('Four malformed controls fail the independent reader; specification controls check termination and layer extensions', flush=True)
