// The Fern TLS client scripts/net-tls-interop runs against OpenSSL's
// s_server and Go's crypto/tls server: one line per case, the same lines
// whichever server answers, so the script compares them with one
// expected text. Every server answers GET /hello with "hello".
//
//   get      std/fetch over HTTPS, the roots from SSL_CERT_FILE
//   socket   a std/tls/client session on a socket of its own, with ALPN
//   resume   another, resumed from the ticket the first was issued
//   mtls     the server requiring a client certificate, shown one
//   nocert   the same server, shown none, which it refuses
//   bulk     the 16 MiB body of /bulk over std/fetch, with its time, when
//            BULK is set: not every server has one to give
//   handshakes  twenty connections, with their time
//
// A body is shown by its first line: the whole of a hello, the heading of
// a page of connection details. The protocol ALPN agreed on follows the
// socket cases' answers when there is one.
import "std/i32";
import "std/result";
import "std/fetch";
import "std/http";
import "std/string";
import "std/utf8";
import "std/time";
import "std/clock";
import "std/tls";
import "std/tls/client";
import "std/tls/identity";
import "std/tls/verify";
import "core/int";

struct Outcome { answer: string, tickets: client.Ticket[], resumed: boolean }

// Raw is what a read loop got: the bytes, and whether the peer ended the
// stream with no close_notify after them.
struct Raw { conn: client.Connection, data: u8[], truncated: boolean }

function setting(name: string, fallback: string): string {
  return match (env(name)) { Some(v) => v, None => fallback };
}

function port_of(name: string): i32 {
  return i32.parse_i32_radix(setting(name, "0"), 10).unwrap_or(0);
}

function first_line(body: string): string {
  let lines = body.lines_non_empty();
  if (lines.len() == 0) {
    return "<empty>";
  }
  return lines[0].trim();
}

function line(answer: Result[HttpResponse, fetch.FetchError]): string {
  match (answer) {
    Ok(resp) => {
      if let Ok(text) = resp.body_text() {
        return f"{resp.status} {first_line(text)}";
      }
      return f"{resp.status} <not utf-8>";
    },
    Err(e) => {
      return "error " + e.message();
    }
  }
}

function identity_from(cert_path: string, key_path: string): Result[identity.Identity, string] {
  let Ok(cert) = read_file(cert_path) else {
    return Err("cannot read " + cert_path);
  };
  let Ok(key) = read_file(key_path) else {
    return Err("cannot read " + key_path);
  };
  return match (identity.from_pem(cert, key)) { Ok(id) => Ok(id), Err(e) => Err(e.message()) };
}

function answered(raw: u8[]): string {
  let text = utf8.from_bytes_lossy(raw);
  if (!text.starts_with("HTTP/1.")) {
    return "no response";
  }
  let (head, rest) = text.split_at(9);
  let (code, tail) = rest.split_at(3);
  let Some(at) = tail.index_of("\r\n\r\n") else {
    return code + " <no body>";
  };
  let (headers, body) = tail.split_at(at + 4);
  return code + " " + first_line(body);
}

// A server that closes with no close_notify gives Truncated at the end.
// The bytes before it are kept, and the end is reported beside them.
function exchange(conn: client.Connection): Result[Raw, tls.TlsError] {
  let c = conn.write("GET /hello HTTP/1.0\r\nHost: localhost\r\nConnection: close\r\n\r\n".bytes())?;
  let out: u8[] = [];
  loop {
    match (c.read(time.duration_seconds(10))) {
      Ok(got) => {
        out = out.concat(got.data);
        c = got.conn;
        if (got.ended) {
          return Ok(Raw { conn: c, data: out, truncated: false });
        }
      },
      Err(tls.Truncated) => {
        return Ok(Raw { conn: c, data: out, truncated: true });
      },
      Err(e) => {
        return Err(e);
      }
    }
  }
}

function over(cfg: client.Config, port: i32): Result[Outcome, tls.TlsError] {
  let conn = client.connect("localhost", port, cfg, time.duration_seconds(10))?;
  let raw = exchange(conn)?;
  let c = raw.conn;
  c.close();
  let alpn = if (c.session.alpn().len() > 0) { " " + c.session.alpn() } else { "" };
  let cut = if (raw.truncated) { " (no close_notify)" } else { "" };
  return Ok(Outcome { answer: answered(raw.data) + alpn + cut, tickets: c.tickets, resumed: c.session.resumed() });
}

function describe(r: Result[Outcome, tls.TlsError], resumption: boolean): string {
  match (r) {
    Ok(o) => {
      if (!resumption) {
        return o.answer;
      }
      let state = if (o.resumed) { "resumed" } else { "fresh" };
      return f"{state} {o.answer}";
    },
    Err(e) => {
      return "error " + e.message();
    }
  }
}

function millis_since(started: Instant): string {
  return clock.elapsed(started).as_millis().to_string();
}

function bulk(base: string): string {
  let started = clock.instant();
  let roomy = http.HttpLimits { ...http.limits(), body: 17 * 1048576 };
  return match (fetch.send(fetch.get(base + "/bulk").with_limits(roomy))) { Ok(resp) => f"{resp.body_bytes().len()} bytes {millis_since(started)} ms", Err(e) => "error " + e.message() };
}

function handshakes(cfg: client.Config, port: i32): string {
  let started = clock.instant();
  for _ in 0..20 {
    match (client.connect("localhost", port, cfg, time.duration_seconds(10))) {
      Ok(c) => {
        c.close();
      },
      Err(e) => {
        return "error " + e.message();
      }
    }
  }
  return f"20 in {millis_since(started)} ms";
}

function main(): i32 {
  let base = setting("BASE", "https://localhost:8443");
  print("get: " + line(fetch.send(fetch.get(base + "/hello"))));
  let roots = match (verify.roots_from_file(setting("CA", "ca.pem"))) { Ok(r) => r, Err(e) => { print("roots: " + e.message()); return 2; } };
  let cfg = client.config("localhost", roots).with_alpn(["http/1.1"]);
  let port = port_of("PORT");
  let first = over(cfg, port);
  print("socket: " + describe(first, false));
  if let Ok(o) = first {
    if (o.tickets.len() == 0) {
      print("resume: no ticket");
    } else {
      print("resume: " + describe(over(cfg.with_ticket(o.tickets[0]), port), true));
    }
  } else {
    print("resume: not tried");
  }
  let mtls = port_of("MTLS_PORT");
  match (identity_from(setting("CLIENT_CERT", "client.pem"), setting("CLIENT_KEY", "client.key"))) {
    Ok(id) => {
      print("mtls: " + describe(over(cfg.with_identity(id), mtls), false));
    },
    Err(e) => {
      print("mtls: " + e);
    }
  }
  if let Ok(o) = over(cfg, mtls) {
    print("nocert: accepted " + o.answer);
  } else {
    print("nocert: refused");
  }
  if (env("BULK").is_some()) {
    print("bulk: " + bulk(base));
  }
  print("handshakes: " + handshakes(cfg, port));
  return 0;
}
