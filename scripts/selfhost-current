#!/usr/bin/env bash
# selfhost-current — build bin/fern, and bin/fern-selfhost when it is missing
# or its key (bin/fern-selfhost.key) is not the sources key bin/fern embeds.
#
# A fresh checkout has neither binary, so CI never meets a stale one. Locally a
# bin/fern-selfhost left by an older tree would otherwise be measured as if it
# were this one.
set -euo pipefail

cd "$(dirname "$0")/.."

go build -o bin/fern ./cmd/fern
if [ ! -x bin/fern-selfhost ] ||
   [ "$(cat bin/fern-selfhost.key 2>/dev/null)" != "$(./bin/fern -selfhost-key)" ]; then
  echo "selfhost-current: building bin/fern-selfhost (missing or stale)" >&2
  make selfhost-cli >&2
fi
