// The Fern server the net-nightly lane runs. scripts/net-bench loads it
// with bodiless GETs, answered with one static body and no allocation of
// note, so the loop's own cost is what the load generator sees.
// scripts/net-interop also uploads to it: a request with a body is
// answered with the body's length and text, so an upload sent chunked or
// behind `Expect: 100-continue` shows whether it arrived whole. With
// TLS_CERT and TLS_KEY set it speaks TLS, requiring a client certificate
// under the roots TLS_CLIENT_CA names when that is set too, and /bulk is
// a 16 MiB body: scripts/net-tls-interop's server cases and its
// throughput record. With H3 set as well it serves HTTP/3 beside TCP:
// scripts/net-bench's HTTP/3 rows. With H2 set it serves HTTP/2 beside
// HTTP/1.1, by prior knowledge in the clear and by ALPN under TLS:
// scripts/net-bench.d/h2tls-bench's rows. WORKERS pins the worker count,
// for a measurement of one worker, and /count answers
// `__heap_alloc_count()`, so a run can be bracketed for the allocations
// it cost. The caps are lifted for the load generator, which is one
// client holding thousands of connections, and the requests a connection
// may carry are unbounded as the servers it is compared with leave them:
// under the default of 1,000 a TLS connection re-handshakes every
// thousand requests, which the others never do.
import "std/i32";
import "std/result";
import "std/http";
import "std/serve";
import "std/platform";
import "std/string";
import "std/tls/identity";
import "std/tls/server";
import "std/tls/verify";
import "std/rand";

function handle(req: HttpRequest, plat: platform.Platform): HttpResponse {
  match (req.path) {
    "/bulk" => {
      return http.bytes(200, "x".repeat(16777216).bytes());
    },
    "/count" => {
      return http.ok(__heap_alloc_count().to_string());
    },
    _ => {}
  }
  if (req.body_len() == 0) {
    return http.ok("hello");
  }
  return match (req.body_text()) { Ok(text) => http.ok(f"len={text.len()} {text}"), Err(_) => http.ok(f"len={req.body_len()} <not text>") };
}

function env_int(name: string, dflt: i32): i32 {
  let Some(p) = env(name) else {
    return dflt;
  };
  return i32.parse_i32_radix(p, 10).unwrap_or(dflt);
}

function identity_from(cert_path: string, key_path: string): Result[identity.Identity, string] {
  let Ok(cert) = read_file(cert_path) else {
    return Err("cannot read " + cert_path);
  };
  let Ok(key) = read_file(key_path) else {
    return Err("cannot read " + key_path);
  };
  return match (identity.from_pem(cert, key)) { Ok(id) => Ok(id), Err(e) => Err(e.message()) };
}

function secured(opts: serve.Config): Result[serve.Config, string] {
  let Some(cert_path) = env("TLS_CERT") else {
    return Ok(opts);
  };
  let Some(key_path) = env("TLS_KEY") else {
    return Err("TLS_CERT is set without TLS_KEY");
  };
  let id = identity_from(cert_path, key_path)?;
  let tls = opts.with_tls(client_roots(server.config(id, rand.bytes(32)))?);
  if (env("H3").is_some()) {
    return Ok(tls.with_h3());
  }
  return Ok(tls);
}

function client_roots(cfg: server.Config): Result[server.Config, string] {
  let Some(path) = env("TLS_CLIENT_CA") else {
    return Ok(cfg);
  };
  return match (verify.roots_from_file(path)) { Ok(roots) => Ok(cfg.with_client_roots(roots)), Err(e) => Err(e.message()) };
}

function main(): i32 {
  let opts = serve.Config { ...serve.config(), max_connections: 16384, max_connections_per_ip: 0, keep_alive_requests: 1000000000, workers: env_int("WORKERS", 0) };
  if (env("H2").is_some()) {
    opts = opts.with_h2();
  }
  match (secured(opts)) {
    Ok(o) => {
      return serve.exit_code(serve.supervise(env_int("PORT", 8080), o, handle));
    },
    Err(e) => {
      eprint("hello: " + e);
      return 2;
    }
  }
}
