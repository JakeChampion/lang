#!/usr/bin/env python3
"""Compare two compilers with one frozen MP3 library and matched C references."""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import platform
import resource
import statistics
import struct
import subprocess

ROOT = Path(__file__).resolve().parent.parent


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def tree_hash(root):
    digest = hashlib.sha256()
    for path in sorted(root.rglob('*')):
        if path.is_file():
            digest.update(path.relative_to(root).as_posix().encode() + b'\0')
            digest.update(path.read_bytes())
    return digest.hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--baseline', type=Path, required=True)
    parser.add_argument('--candidate', type=Path, required=True)
    parser.add_argument('--codec-root', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--rounds', type=int, default=50)
    parser.add_argument('--trials', type=int, default=7)
    args = parser.parse_args()
    assert args.rounds > 0 and args.trials >= 3
    assert platform.system() == 'Linux'
    target = {'x86_64': 'x86-64-linux', 'aarch64': 'arm64-linux'}[platform.machine()]
    codec = args.codec_root.resolve()
    work = args.output.resolve()
    work.mkdir(parents=True, exist_ok=True)
    spec = importlib.util.spec_from_file_location('vectors', codec / 'scripts/gen-mp3-vectors.py')
    vectors = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(vectors)
    vectors.reference(work)
    indexed = vectors.encoded(work, 48000, 2, values=vectors.signal(48000, 2, 48000))
    free = bytearray(indexed)
    for at, *_ in vectors.frame_offsets(indexed):
        assert free[at + 1] & 1
        free[at + 2] &= 15
    inputs = {'indexed': work / 'indexed.mp3', 'free': work / 'free.mp3'}
    inputs['indexed'].write_bytes(indexed)
    inputs['free'].write_bytes(free)
    compilers = {'baseline': args.baseline.resolve(), 'candidate': args.candidate.resolve()}
    driver = codec / 'bench/audio/mp3_freeformat.fern'
    reference = codec / 'scripts/audio-reference/mp3_freeformat_bench.c'
    commands = {}
    for name, compiler in compilers.items():
        commands[name] = [str(compiler), '-stdlib', str(codec / 'internal/stdlib'),
                          '-target', target, '-o', str(work / name), str(driver)]
    for name, flags in [('scalar', []), ('simd', ['-DFERN_MP3_BENCH_SIMD'])]:
        commands[name] = ['cc', '-O3', '-ffp-contract=off', *flags, '-I', str(work),
                          str(reference), '-o', str(work / name)]
    for name, command in commands.items():
        with (work / (name + '-build.log')).open('w') as log:
            subprocess.run(command, stdout=log, stderr=subprocess.STDOUT, check=True, timeout=300)
    rows, hashes = [], {}
    for mode in ['whole', 'frames']:
        variants = [(name, kind) for kind in inputs for name in commands]
        for trial in range(args.trials):
            for name, kind in (variants if trial % 2 == 0 else variants[::-1]):
                key = f'{name}-{kind}-{mode}'
                pcm = work / (key + '.f32')
                before = resource.getrusage(resource.RUSAGE_CHILDREN)
                result = subprocess.run([str(work / name), str(inputs[kind]), mode, str(args.rounds), str(pcm)],
                                        capture_output=True, text=True, check=True, timeout=300)
                after = resource.getrusage(resource.RUSAGE_CHILDREN)
                row = {key: int(value) for key, value in (line.split('=', 1) for line in result.stdout.splitlines())}
                row.update(name=name, input=kind, mode=mode, trial=trial,
                           process_cpu_seconds=after.ru_utime + after.ru_stime - before.ru_utime - before.ru_stime)
                digest = sha(pcm)
                assert hashes.setdefault(key, digest) == digest
                rows.append(row)
                print(json.dumps(row), flush=True)
    for simd in [False, True]:
        assert len({(row['checksum'], row['samples']) for row in rows if (row['name'] == 'simd') == simd}) == 1
    raw_reference = (work / 'scalar-indexed-whole.f32').read_bytes()
    expected = struct.unpack('<' + 'f' * (len(raw_reference) // 4), raw_reference)
    summaries = []
    for key, digest in hashes.items():
        raw = (work / (key + '.f32')).read_bytes()
        assert len(raw) == len(raw_reference)
        values = struct.unpack('<' + 'f' * (len(raw) // 4), raw)
        error = max(abs(a - b) for a, b in zip(values, expected))
        assert error < 0.00002
        if not key.startswith('simd-'):
            assert raw == raw_reference
        group = [row for row in rows if key == f"{row['name']}-{row['input']}-{row['mode']}"]
        summaries.append({'variant': key, 'pcm_sha256': digest, 'max_absolute_error': error,
                          'medians': {metric: statistics.median(row[metric] for row in group)
                                      for metric in group[0] if metric not in ['name', 'input', 'mode', 'trial']}})
    ratios = {}
    for mode in ['whole', 'frames']:
        for kind in inputs:
            group = {(row['name'], row['trial']): row for row in rows if row['mode'] == mode and row['input'] == kind}
            ratios[kind + '-' + mode] = [group['candidate', trial]['wall_ns'] / group['baseline', trial]['wall_ns']
                                         for trial in range(args.trials)]
    report = {'machine': platform.platform(), 'target': target, 'rounds': args.rounds, 'trials': args.trials,
              'codec_revision': subprocess.check_output(['git', '-C', str(codec), 'rev-parse', 'HEAD'], text=True).strip(),
              'library_sha256': tree_hash(codec / 'internal/stdlib'),
              'compiler_sha256': {name: sha(path) for name, path in compilers.items()},
              'compiler_core_sha256': {name: sha(path.with_name('fern-selfhost')) for name, path in compilers.items()},
              'candidate_sources_sha256': tree_hash(ROOT / 'compiler'),
              'driver_sha256': sha(driver), 'c_driver_sha256': sha(reference), 'script_sha256': sha(Path(__file__)),
              'reference_revision': vectors.tables.REV, 'reference_headers': vectors.tables.SHA,
              'inputs': {name: sha(path) for name, path in inputs.items()},
              'binaries': {name: sha(work / name) for name in commands}, 'build_commands': commands,
              'cc': subprocess.check_output(['cc', '--version'], text=True).splitlines()[0],
              'ffmpeg': subprocess.check_output(['ffmpeg', '-version'], text=True).splitlines()[0],
              'wall_scope': 'Timed decode includes a byte checksum of every float sample.',
              'cpu_scope': 'Process CPU includes two warmups, timed decode, and the final PCM dump.',
              'rss_scope': 'Process VmHWM after timed decode and before the PCM dump.',
              'paired_time_ratios': ratios, 'summaries': summaries, 'rows': rows}
    (work / 'results.json').write_text(json.dumps(report, indent=2) + '\n')


if __name__ == '__main__':
    main()
