#!/usr/bin/env bash
# coreutils-bench — time the Fern coreutils against GNU coreutils and uutils.
#
# Usage: coreutils-bench [-o REPORT.md] [UTIL...]
#
#   -o REPORT.md  also write the table there (default: stdout only).
#   UTIL...       which utilities to run (default: every coreutils/*.fern).
#
# Environment:
#
#   FERN_GNU_COREUTILS  directory holding the GNU binaries. Default: the
#                       directory `yes` resolves to on PATH, if it is GNU.
#   FERN_UUTILS         directory holding uutils binaries, named either
#                       `<util>` or `uutils-<util>`. Default: search PATH
#                       for `uutils-yes`, then for a `coreutils` multi-call
#                       binary that is uutils (Debian's rust-coreutils), then
#                       the nix store. Optional — the column is dropped when
#                       there is none, and the header names what was found.
#   FERN_TARGET         the -target to build for. Default: the host.
#
# WALL TIME, deliberately. `scripts/perf-bench` counts retired instructions
# because a count is reproducible to the digit, and that is right for a
# regression gate. This is not a gate: it is a comparison against binaries we
# did not build, whose instruction counts say nothing about what a user
# waiting on `yes | head` experiences. So it uses hyperfine, many runs, and
# reports mean ± σ, and the numbers are only comparable within one run on one
# machine. Never paste one machine's Fern column beside another machine's GNU
# column.
#
# Each workload runs the SAME command shape for every implementation, with
# any pipeline partner (the `head` that bounds `yes`) taken from the GNU
# directory for all three, so the partner's cost is a constant term and not
# a variable. Startup-bound utilities (`true`, `echo`) run without a shell
# (hyperfine -N) so a shell fork is not the thing being measured.
#
# The target these numbers serve: faster than GNU on every utility, and
# faster than uutils where the language allows (docs/COREUTILS.md).

set -euo pipefail

cd "$(dirname "$0")/.."

report=""
while getopts "o:" opt; do
  case "$opt" in
    o) report="$OPTARG" ;;
    *) echo "usage: $0 [-o REPORT.md] [UTIL...]" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

command -v hyperfine >/dev/null || { echo "coreutils-bench: hyperfine not found" >&2; exit 1; }
command -v python3 >/dev/null || { echo "coreutils-bench: python3 not found (renders the table)" >&2; exit 1; }

# --- reference binaries ------------------------------------------------------

is_gnu() { [ -x "$1/yes" ] && "$1/yes" --version 2>/dev/null | head -1 | grep -q '(GNU coreutils)'; }

gnu="${FERN_GNU_COREUTILS:-}"
if [ -z "$gnu" ]; then
  if p=$(command -v yes) && is_gnu "$(dirname "$p")"; then
    gnu=$(dirname "$p")
  else
    for d in /nix/store/*-coreutils-*/bin; do
      if is_gnu "$d"; then gnu="$d"; break; fi
    done
  fi
fi
[ -n "$gnu" ] && is_gnu "$gnu" || {
  echo "coreutils-bench: no GNU coreutils; set FERN_GNU_COREUTILS=/path/to/bin" >&2; exit 1; }

# is_uutils_multicall BIN — Debian's rust-coreutils: one binary dispatching
# on argv[0]. Invoked bare it names itself "(multi-call binary)" and exits
# non-zero; `--version` is refused as an unknown utility; GNU's own
# multi-call prints a usage line. Output is captured rather than piped
# because under pipefail the non-zero exit would mask the match.
is_uutils_multicall() {
  case "$("$1" 2>&1 || true)" in *"multi-call binary"*) return 0 ;; esac
  return 1
}

uu="${FERN_UUTILS:-}"
uu_multicall=""
if [ -z "$uu" ]; then
  if p=$(command -v uutils-yes 2>/dev/null); then
    uu=$(dirname "$p")
  elif p=$(command -v coreutils 2>/dev/null) && is_uutils_multicall "$p"; then
    # Per-utility names go under $out (made below, removed on exit) on
    # demand by uutils_bin.
    uu_multicall="$p"
  else
    for d in /nix/store/*-uutils-coreutils-*/bin; do
      [ -x "$d/uutils-yes" ] && { uu="$d"; break; }
    done
  fi
fi
echo "coreutils-bench: uutils: ${uu_multicall:-${uu:-none — the column is dropped}}" >&2

# uutils_bin UTIL — the uutils binary for UTIL, or nothing.
uutils_bin() {
  [ -n "$uu" ] || return 0
  if [ -n "$uu_multicall" ] && [ ! -e "$uu/$1" ]; then
    # `<name>: function/utility not found` is the multi-call's own refusal;
    # anything else (a version line, or test/[ treating --version as an
    # expression) means the name is carried.
    case "$("$uu_multicall" "$1" --version 2>&1 || true)" in
      *"function/utility not found"*) ;;
      *) ln -s "$uu_multicall" "$uu/$1" ;;
    esac
  fi
  if [ -x "$uu/uutils-$1" ]; then echo "$uu/uutils-$1"; elif [ -x "$uu/$1" ]; then echo "$uu/$1"; fi
}

# --- build ------------------------------------------------------------------

target="${FERN_TARGET:-}"
if [ -z "$target" ]; then
  case "$(uname -s)/$(uname -m)" in
    Linux/x86_64)  target=x86-64-linux ;;
    Linux/aarch64) target=arm64-linux ;;
    Darwin/arm64)  target=arm64-darwin ;;
    *) echo "coreutils-bench: no default target for $(uname -s)/$(uname -m); set FERN_TARGET" >&2; exit 1 ;;
  esac
fi

go build -o bin/fern ./cmd/fern
out=$(mktemp -d)
if [ -n "$uu_multicall" ]; then
  uu="$out/uutils"
  mkdir -p "$uu"
fi
trap 'rm -rf "$out"' EXIT
mkdir -p "$out/fern"

if [ $# -eq 0 ]; then
  utils=()
  for f in coreutils/*.fern; do utils+=("$(basename "$f" .fern)"); done
  set -- "${utils[@]}"
fi
for u in "$@"; do
  [ -f "coreutils/$u.fern" ] || { echo "coreutils-bench: no coreutils/$u.fern" >&2; exit 1; }
  ./bin/fern -O -target "$target" -o "$out/fern/$u" "coreutils/$u.fern"
done

# --- workloads --------------------------------------------------------------
#
# workloads UTIL — one line per workload: `label<TAB>shell?<TAB>template`,
# where {} stands for the binary under test and {gnu} for the GNU directory.
# `shell` is y when the template is a pipeline and needs one.
workloads() {
  case "$1" in
    yes)
      printf 'yes | head -c 1G\ty\t{} | {gnu}/head -c 1000000000 > /dev/null\n'
      printf 'yes 70000-byte line | head -c 1G\ty\t{} %s | {gnu}/head -c 1000000000 > /dev/null\n' "$(printf 'z%.0s' $(seq 70000))"
      ;;
    echo)
      printf 'echo hello world\tn\t{} hello world\n'
      printf 'echo -e with escapes\tn\t{} -e a\\tb\\nc\\x41\\0101\n'
      printf 'echo 200 operands\tn\t{} %s\n' "$(seq 200 | tr '\n' ' ')"
      ;;
    true|false)
      printf '%s\tn\t{}\n' "$1"
      ;;
    printf)
      printf "printf '%%s\\\\n' x\tn\t{} '%%s\\\\n' x\n"
      printf "printf '%%d %%s %%5.2f\\\\n' 1 a 2.5\tn\t{} '%%d %%s %%5.2f\\\\n' 1 a 2.5\n"
      printf "printf '%%s\\\\n' cycling over 2000 operands\tn\t{} '%%s\\\\n' %s\n" "$(seq 2000 | tr '\n' ' ')"
      printf "printf '%%.20f %%e %%g' cycling over 300 floats\tn\t{} '%%.20f %%e %%g\\\\n' %s\n" "$(seq 1 0.37 111 | tr '\n' ' ')"
      ;;
    basename)
      printf 'basename one path\tn\t{} /usr/local/lib/libfoo.so.1.2.3 .3\n'
      printf 'basename -a 200 operands\tn\t{} -a -s .o %s\n' "$(seq 200 | sed 's|.*|/usr/lib/x86_64-linux-gnu/lib&.o|' | tr '\n' ' ')"
      ;;
    dirname)
      printf 'dirname one path\tn\t{} /usr/local/lib/libfoo.so.1.2.3\n'
      ;;
    numfmt)
      # A field at a time over a large table is what numfmt is for; the
      # single-number rows are startup plus one long-double conversion.
      printf 'numfmt --to=si 1000\tn\t{} --to=si 1000\n'
      printf 'numfmt --from=si 1.5G\tn\t{} --from=si 1.5G\n'
      printf 'numfmt --to=iec --format %%.3f\tn\t{} --to=iec --format %%.3f 1234567890\n'
      printf 'numfmt 5000 operands\tn\t{} --to=si %s\n' "$(seq 1000 1000 5000000 | tr '\n' ' ')"
      printf 'numfmt 200k lines from stdin\ty\t{gnu}/seq 1000 1000 200000000 | {} --to=si > /dev/null\n'
      printf 'numfmt 200k lines in a field\ty\t{gnu}/seq 1000 1000 200000000 | {gnu}/sed "s/^/x /" | {} --field=2 --padding=12 --to=iec > /dev/null\n'
      ;;
    expr)
      # Startup, then the two things expr does that cost anything: wide
      # integer arithmetic (GNU links GMP for it) and a regexp match
      # (GNU calls glibc's).
      printf 'expr 1 + 1\tn\t{} 1 + 1\n'
      printf 'expr 40-digit product\tn\t{} 9999999999999999999999999999999999999999 %s 9999999999999999999999999999999999999999\n' '\*'
      printf 'expr 400-digit product\tn\t{} %s %s %s\n' "$(printf '9%.0s' $(seq 400))" '\*' "$(printf '7%.0s' $(seq 400))"
      printf "expr : extracts a suffix\tn\t{} /usr/local/lib/libfoo.so.1.2.3 : '.*\\\\.\\\\(.*\\\\)'\n"
      printf 'expr : counts a 4000-byte match\tn\t{} %s : %s\n' "$(printf 'ab%.0s' $(seq 2000))" "'\\(ab\\)*'"
      printf 'expr : anchored class over 4000 bytes\tn\t{} %s : %s\n' "$(printf 'ab%.0s' $(seq 2000))" "'[a-z]*x*[a-z]*'"
      printf 'expr length of 100000 bytes\tn\t{} length %s\n' "$(printf 'x%.0s' $(seq 100000))"
      ;;
    tsort)
      # A 100k-edge DAG over 50k names, generated once per run. Acyclic so
      # the workload is the queue phase, not the loop report.
      graph="$out/tsort-100k.txt"
      [ -f "$graph" ] || python3 - "$graph" <<'PY'
import random, sys
rnd = random.Random(8288)
with open(sys.argv[1], "w") as f:
    for _ in range(100000):
        i = rnd.randrange(0, 49999)
        j = rnd.randrange(i + 1, 50000)
        f.write("n%d n%d\n" % (i, j))
PY
      printf 'tsort 100k-edge DAG from a file\tn\t{} %s\n' "$graph"
      ;;
    seq)
      # The integer engine, the equal-width one and the float one, each
      # over enough numbers that startup is not what is measured.
      printf 'seq 1 1000000\tn\t{} 1000000\n'
      printf 'seq -s, 1 1000000\tn\t{} -s, 1000000\n'
      printf 'seq -w 1 1000000\tn\t{} -w 1000000\n'
      printf 'seq 0 0.001 1000\tn\t{} 0 0.001 1000\n'
      printf 'seq -f %%.3f 0 0.001 1000\tn\t{} -f %%.3f 0 0.001 1000\n'
      ;;
    factor)
      # Small numbers in bulk (trial division), then the 64-bit path
      # where Miller-Rabin and Pollard rho do the work.
      nums="$out/factor-nums.txt"
      [ -f "$nums" ] || "$gnu/seq" 1 200000 > "$nums"
      semi="$out/factor-semiprimes.txt"
      [ -f "$semi" ] || python3 - "$semi" <<'PY'
import sys
# Products of two primes just under 2^32, so each needs rho over the
# full 64-bit range rather than trial division.
primes = [4294967291, 4294967279, 4294967231, 4294967197, 4294967189,
          4294967161, 4294967143, 4294967111, 4294967087, 4294967029]
with open(sys.argv[1], "w") as f:
    for i, p in enumerate(primes):
        for q in primes[i:]:
            f.write("%d\n" % (p * q))
PY
      printf 'factor 1..200000 from stdin\ty\t{} < %s > /dev/null\n' "$nums"
      printf 'factor 55 64-bit semiprimes\ty\t{} < %s > /dev/null\n' "$semi"
      printf 'factor one 64-bit semiprime\tn\t{} 18446744065119617029\n'
      ;;
    sleep)
      # Startup-bound: what a script pays for `sleep 0` in a loop.
      printf 'sleep 0\tn\t{} 0\n'
      printf 'sleep 0 four operands\tn\t{} 0 0s 0m 0h\n'
      ;;
    hostid)
      # Startup plus the NSS walk: /etc/hostid, /etc/nsswitch.conf and
      # /etc/hosts, read on every call.
      printf 'hostid\tn\t{}\n'
      ;;
    head)
      # head's shapes are: stop early on a big file (the count is small,
      # so the cost is startup plus one read), copy a lot of it, and the
      # two elisions, which have to buffer the tail rather than seek.
      big="$out/text-64m.txt"
      [ -f "$big" ] || "$gnu/seq" 1 8000000 > "$big"
      printf 'head -n 10 of a 62 MiB file\tn\t{} -n 10 %s\n' "$big"
      printf 'head -n 4000000 of a 62 MiB file\ty\t{} -n 4000000 %s > /dev/null\n' "$big"
      printf 'head -c 32M of a 62 MiB file\ty\t{} -c 33554432 %s > /dev/null\n' "$big"
      printf 'head -n 10 from a pipe\ty\t{gnu}/cat %s | {} -n 10 > /dev/null\n' "$big"
      printf 'head -n -10 of a 62 MiB file\ty\t{} -n -10 %s > /dev/null\n' "$big"
      printf 'head -c -10 of a 62 MiB file\ty\t{} -c -10 %s > /dev/null\n' "$big"
      ;;
    wc)
      # wc -l is the SIMD count, wc -c is fstat and no read at all, and
      # -w / -L are the byte-at-a-time scan the C locale asks for.
      big="$out/text-64m.txt"
      [ -f "$big" ] || "$gnu/seq" 1 8000000 > "$big"
      printf 'wc -l of a 62 MiB file\tn\t{} -l %s\n' "$big"
      printf 'wc -c of a 62 MiB file\tn\t{} -c %s\n' "$big"
      printf 'wc of a 62 MiB file\tn\t{} %s\n' "$big"
      printf 'wc -w of a 62 MiB file\tn\t{} -w %s\n' "$big"
      printf 'wc -L of a 62 MiB file\tn\t{} -L %s\n' "$big"
      printf 'wc -l from a pipe\ty\t{gnu}/cat %s | {} -l\n' "$big"
      ;;
    uniq)
      # uniq's cost is per LINE, so the three shapes are: a run of
      # duplicates to collapse, lines that are all distinct (every line
      # becomes the one held for the next comparison), and long lines,
      # where the comparison itself starts to dominate the fixed cost.
      dup="$out/uniq-dup.txt"
      [ -f "$dup" ] || python3 - "$dup" <<'PY2'
import sys
with open(sys.argv[1], "w") as f:
    for i in range(4000000):
        f.write("line %d\n" % (i // 4))
PY2
      distinct="$out/uniq-distinct.txt"
      [ -f "$distinct" ] || "$gnu/seq" 1 4000000 > "$distinct"
      paths="$out/uniq-paths.txt"
      [ -f "$paths" ] || python3 - "$paths" <<'PY2'
import sys
with open(sys.argv[1], "w") as f:
    for i in range(2000000):
        f.write("/usr/lib/x86_64-linux-gnu/libfoo-%07d.so\n" % i)
PY2
      printf 'uniq over 4M lines in groups of 4\ty\t{} %s > /dev/null\n' "$dup"
      printf 'uniq -c over 4M lines in groups of 4\ty\t{} -c %s > /dev/null\n' "$dup"
      printf 'uniq -d over 4M lines in groups of 4\ty\t{} -d %s > /dev/null\n' "$dup"
      printf 'uniq over 4M distinct lines\ty\t{} %s > /dev/null\n' "$distinct"
      printf 'uniq -u over 4M distinct lines\ty\t{} -u %s > /dev/null\n' "$distinct"
      printf 'uniq over 2M 44-byte distinct lines\ty\t{} %s > /dev/null\n' "$paths"
      printf 'uniq -f1 -c over 4M lines\ty\t{} -f1 -c %s > /dev/null\n' "$dup"
      printf 'uniq from a pipe\ty\t{gnu}/cat %s | {} > /dev/null\n' "$dup"
      ;;
    comm)
      # Two sorted files where every other line is missing from the
      # second, so all three columns are exercised; and the same file
      # twice, where everything pairs and the order check therefore
      # never turns on — the two halves of comm's cost.
      ca="$out/comm-a.txt"
      cb="$out/comm-b.txt"
      if [ ! -f "$ca" ]; then
        python3 - "$ca" "$cb" <<'PY2'
import sys
a = open(sys.argv[1], "w")
b = open(sys.argv[2], "w")
for i in range(2000000):
    a.write("key-%09d\n" % i)
    if i % 2 == 0:
        b.write("key-%09d\n" % i)
PY2
      fi
      printf 'comm over 2M + 1M sorted lines\ty\t{} %s %s > /dev/null\n' "$ca" "$cb"
      printf 'comm -12 over 2M + 1M sorted lines\ty\t{} -12 %s %s > /dev/null\n' "$ca" "$cb"
      printf 'comm --total over 2M + 1M sorted lines\ty\t{} --total %s %s > /dev/null\n' "$ca" "$cb"
      printf 'comm of a 2M-line file with itself\ty\t{} %s %s > /dev/null\n' "$ca" "$ca"
      printf 'comm -123 of a 2M-line file with itself\ty\t{} -123 %s %s > /dev/null\n' "$ca" "$ca"
      ;;
    test|\[)
      # Startup-bound like sleep: what a script pays per condition. The
      # bracket form carries its `]`; a string compare, an integer compare
      # (digit strings, any length), a stat, and a long and/or chain.
      close=""; [ "$1" = '[' ] && close=" ]"
      printf '%s string equality\tn\t{} abc = abc%s\n' "$1" "$close"
      printf '%s integer compare\tn\t{} 12345678901234567890 -gt 1234567890123456789%s\n' "$1" "$close"
      printf '%s -f on a file\tn\t{} -f /etc/passwd%s\n' "$1" "$close"
      printf '%s -nt on two files\tn\t{} /etc/passwd -nt /etc/group%s\n' "$1" "$close"
      printf '%s 40-term and/or chain\tn\t{} %s%s\n' "$1" "$(for i in $(seq 20); do printf 'a = a -a %d -eq %d -o ' "$i" "$i"; done)x = x" "$close"
      ;;
    *)
      echo "coreutils-bench: no workloads defined for $1 — add a case to workloads()" >&2
      exit 1
      ;;
  esac
}

# --- measure ----------------------------------------------------------------

jsons=()
for u in "$@"; do
  uub=$(uutils_bin "$u")
  while IFS=$'\t' read -r label shell template; do
    cmds=()
    for impl in fern gnu uutils; do
      case "$impl" in
        fern)   bin="$out/fern/$u" ;;
        gnu)    bin="$gnu/$u" ;;
        uutils) bin="$uub"; [ -n "$bin" ] || continue ;;
      esac
      cmd=${template//\{gnu\}/$gnu}
      cmd=${cmd//\{\}/$bin}
      cmds+=(-n "$impl" "$cmd")
    done
    json="$out/$u-$(echo "$label" | tr -c 'a-zA-Z0-9' '_').json"
    shellopt=(-N)
    [ "$shell" = y ] && shellopt=(--shell=sh)
    # -i: false(1) exits 1 by design, and hyperfine would otherwise abort.
    hyperfine --warmup 3 --min-runs 20 -i "${shellopt[@]}" --export-json "$json" \
      "${cmds[@]}" >/dev/null 2>&1 || {
      echo "coreutils-bench: hyperfine failed for $u: $label" >&2; exit 1; }
    python3 - "$json" "$u" "$label" <<'PY'
import json, sys
path, util, label = sys.argv[1:]
d = json.load(open(path))
d["util"], d["label"] = util, label
json.dump(d, open(path, "w"))
PY
    jsons+=("$json")
  done < <(workloads "$u")
done

# --- report -----------------------------------------------------------------

table=$(python3 - "${jsons[@]}" <<'PY'
import json, sys
rows = []
have_uu = False
for path in sys.argv[1:]:
    d = json.load(open(path))
    by = {r["command"]: r for r in d["results"]}
    have_uu = have_uu or "uutils" in by
    rows.append((d["util"], d["label"], by))

def ms(r):
    return f'{r["mean"]*1000:.2f} ± {r["stddev"]*1000:.2f}' if r else "—"

def ratio(a, b):
    return f'{b["mean"]/a["mean"]:.2f}×' if a and b else "—"

hdr = ["utility", "workload", "fern (ms)", "gnu (ms)"]
if have_uu:
    hdr.append("uutils (ms)")
hdr.append("gnu / fern")
if have_uu:
    hdr.append("uutils / fern")
print("| " + " | ".join(hdr) + " |")
print("|" + "|".join("---" for _ in hdr) + "|")
for util, label, by in rows:
    f, g, u = by.get("fern"), by.get("gnu"), by.get("uutils")
    cells = [f"`{util}`", label, ms(f), ms(g)]
    if have_uu:
        cells.append(ms(u))
    cells.append(ratio(f, g))
    if have_uu:
        cells.append(ratio(f, u))
    print("| " + " | ".join(cells) + " |")
PY
)

header="coreutils-bench: $(date -u +%Y-%m-%d) $(uname -s)/$(uname -m), fern $(git rev-parse --short HEAD) (-O, $target), $("$gnu/yes" --version | head -1)"
# uutils prints argv[0] before its version, which for a symlink dir is a
# scratch path; name the implementation instead.
[ -n "$uu" ] && header="$header, uutils $("$(uutils_bin yes)" --version | head -1 | awk '{print $NF}')"
header="$header. mean ± σ over ≥20 runs; a ratio above 1 means Fern is faster."

printf '%s\n\n%s\n' "$header" "$table"
if [ -n "$report" ]; then
  printf '%s\n\n%s\n' "$header" "$table" > "$report"
fi
