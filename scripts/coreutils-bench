#!/usr/bin/env bash
# coreutils-bench — time the Fern coreutils against GNU coreutils and uutils.
#
# Usage: coreutils-bench [-o REPORT.md] [UTIL...]
#
#   -o REPORT.md  also write the table there (default: stdout only).
#   UTIL...       which utilities to run (default: every coreutils/*.fern).
#
# Environment:
#
#   FERN_GNU_COREUTILS  directory holding the GNU binaries. Default: the
#                       directory `yes` resolves to on PATH, if it is GNU.
#   FERN_UUTILS         directory holding uutils binaries, named either
#                       `<util>` or `uutils-<util>`. Default: search PATH
#                       for `uutils-yes`, then for a `coreutils` multi-call
#                       binary that is uutils (Debian's rust-coreutils), then
#                       the nix store. Optional — the column is dropped when
#                       there is none, and the header names what was found.
#   FERN_TARGET         the -target to build for. Default: the host.
#   FERN_BENCH_COMPILERS  which Fern compiler builds the utilities: `both`
#                       (default), `native` (bin/fern alone) or `selfhost`
#                       (bin/fern-selfhost alone).
#   FERN_BENCH_PROBE_TIMEOUT  seconds one trial of a workload may take before
#                       the row records that the build did not finish.
#                       Default: 60.
#
# TWO FERN COLUMNS, because there are two Fern compilers and the project is
# moving to the self-hosted one by default (CLAUDE.md). `fern` is the native
# compiler's build and `fern-sh` the self-hosted compiler's build of the SAME
# source, so the pair answers the two questions separately: whether Fern beats
# GNU and uutils, and whether it still does once the default compiler changes.
# Measuring only the native build would have let the self-host leg regress
# against GNU unobserved, which is what #9077 (accumulation is quadratic under
# the self-host) and #8688 (a field-place `.with` clones the buffer) cost
# today.
#
# A BOUND ON ONE TRIAL, because a self-host build can be slower by a factor
# that turns a benchmark into a hang: #8688 has `seq` ~400x slower and growing
# to 11 GB. Each Fern build therefore runs the workload once under `timeout`
# before hyperfine sees it, and a build that does not finish is REPORTED in
# its cell rather than dropped. The bound is time and not memory on purpose:
# the arena is a 16 GiB MAP_NORESERVE reservation (docs/LOCAL-DEV-LOOP.md), so
# `ulimit -v` and `ulimit -d` would refuse every Fern binary at startup.
#
# WALL TIME, deliberately. `scripts/perf-bench` counts retired instructions
# because a count is reproducible to the digit, and that is right for a
# regression gate. This is not a gate: it is a comparison against binaries we
# did not build, whose instruction counts say nothing about what a user
# waiting on `yes | head` experiences. So it uses hyperfine, many runs, and
# reports mean ± σ, and the numbers are only comparable within one run on one
# machine. Never paste one machine's Fern column beside another machine's GNU
# column.
#
# Each workload runs the SAME command shape for every implementation, with
# any pipeline partner (the `head` that bounds `yes`) taken from the GNU
# directory for all three, so the partner's cost is a constant term and not
# a variable. Startup-bound utilities (`true`, `echo`) run without a shell
# (hyperfine -N) so a shell fork is not the thing being measured.
#
# The target these numbers serve: faster than GNU on every utility, and
# faster than uutils where the language allows (docs/COREUTILS.md).

set -euo pipefail

# The self-hosted compiler's builds take the typed path, whole: strict turns a
# refusal into a failed run rather than a mixed module, and the other three are
# pinned so an ambient setting cannot switch the typed path off.
export FERN_SEM_IR=1 FERN_SEM_IR_ONLY= FERN_SEM_IR_SKIP= FERN_SEM_IR_STRICT=1

cd "$(dirname "$0")/.."

report=""
while getopts "o:" opt; do
  case "$opt" in
    o) report="$OPTARG" ;;
    *) echo "usage: $0 [-o REPORT.md] [UTIL...]" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

command -v hyperfine >/dev/null || { echo "coreutils-bench: hyperfine not found" >&2; exit 1; }
command -v python3 >/dev/null || { echo "coreutils-bench: python3 not found (renders the table)" >&2; exit 1; }

# --- reference binaries ------------------------------------------------------

is_gnu() { [ -x "$1/yes" ] && "$1/yes" --version 2>/dev/null | head -1 | grep -q '(GNU coreutils)'; }

# FERN_GNU_COREUTILS is a PATH-style LIST, because no one directory need hold
# every utility: Debian and its derivatives do not build `uptime` or `kill`
# into their coreutils package, and the /usr/bin/uptime that exists on most
# Linux distributions belongs to procps. $gnu is the directory holding the
# bulk; gnu_bin looks the rest up across the whole list.
gnu_dirs="${FERN_GNU_COREUTILS:-}"
gnu=""
if [ -n "$gnu_dirs" ]; then
  IFS=: read -r -a _gnu_list <<< "$gnu_dirs"
  for d in "${_gnu_list[@]}"; do
    if is_gnu "$d"; then gnu="$d"; break; fi
  done
fi
# The tree on PATH is appended ALWAYS, not only when the list named nothing.
# Both trees above are built from source `--without-selinux`, so neither has
# `chcon` or `runcon`, and the distribution's own coreutils is the only place
# those two rows can be measured at all. gnu_bin still prefers the earlier
# entries, so this costs nothing for the other 104.
path_gnu=""
if p=$(command -v yes) && is_gnu "$(dirname "$p")"; then
  path_gnu=$(dirname "$p")
else
  for d in /nix/store/*-coreutils-*/bin; do
    if is_gnu "$d"; then path_gnu="$d"; break; fi
  done
fi
if [ -n "$path_gnu" ]; then
  case ":$gnu_dirs:" in
    *":$path_gnu:"*) ;;
    *) gnu_dirs="${gnu_dirs:+$gnu_dirs:}$path_gnu" ;;
  esac
  [ -n "$gnu" ] || gnu="$path_gnu"
fi
[ -n "$gnu" ] && is_gnu "$gnu" || {
  echo "coreutils-bench: no GNU coreutils; set FERN_GNU_COREUTILS=/path/to/bin (a PATH-style list)" >&2; exit 1; }

# The claim this script exists to support is "faster than GNU", and it is only
# as current as the tree it found: beating a release nobody runs any more is
# not the claim. bench_gnu_floor is the newest release at the time of writing,
# so falling short is SAID rather than assumed away. It warns and does not
# exit, because the bench is a comparison and not a gate (see WALL TIME above)
# and a developer without a current tree still wants the other two columns.
#
# The same release GNU_COREUTILS_VERSION pins in scripts/devbox.Dockerfile and
# the CI lanes, which is the tree the corpus is held to: bump them together or
# this warning stops naming the version the oracle is.
bench_gnu_floor=9.12
gnu_ver=$({ "$gnu/yes" --version || true; } | head -1 | awk '{print $NF}')
if [ "$(printf '%s\n%s\n' "$bench_gnu_floor" "$gnu_ver" | sort -V | head -1)" != "$bench_gnu_floor" ]; then
  echo "coreutils-bench: comparing against GNU coreutils ${gnu_ver:-?}, older than $bench_gnu_floor — point FERN_GNU_COREUTILS at a newer tree (scripts/devbox.Dockerfile builds one at /opt/gnu-coreutils)" >&2
fi

# gnu_bin UTIL — the GNU coreutils binary for UTIL. The name is VERIFIED
# rather than assumed present in $gnu: /usr/bin/uptime is procps on Debian
# and Ubuntu, and benchmarking against it would compare two different
# programs.
gnu_bin() {
  local u=$1 d probe=$1
  # `test --version` is an expression to test(1), so the bracket form, the
  # same program, answers for it.
  [ "$u" = test ] && probe='['
  IFS=: read -r -a _dirs <<< "$gnu_dirs"
  for d in "${_dirs[@]}" "$gnu"; do
    # `false --version` prints its version and exits 1, which under pipefail
    # would fail the whole pipeline; the exit status is not the question.
    # `dd` is the one utility whose version line omits the word GNU — it
    # says `dd (coreutils) 9.12` where every sibling says `(GNU coreutils)`
    # — so both spellings name the package.
    if [ -x "$d/$u" ] && [ -x "$d/$probe" ] && { "$d/$probe" --version 2>/dev/null || true; } | head -1 | grep -qE '\((GNU )?coreutils\)'; then
      # The header names the version of the directory holding the bulk, so
      # a utility answered from elsewhere says which version it really was.
      [ "$d" = "$gnu" ] || echo "coreutils-bench: $u oracle: $({ "$d/$probe" --version || true; } | head -1) ($d)" >&2
      printf '%s' "$d/$u"; return 0
    fi
  done
  echo "coreutils-bench: no GNU coreutils $u in $gnu_dirs" >&2
  return 1
}

# is_uutils_multicall BIN — uutils' rust-coreutils: one binary dispatching on
# argv[0]. BOTH spellings are probed because the marker MOVED: Debian's 0.0.24
# names itself "(multi-call binary)" when invoked bare and refuses `--version`
# as an unknown utility, while 0.11.0 answers a bare call with `coreutils:
# missing argument` and carries the marker on `--version` instead. Probing the
# bare form alone silently dropped the uutils column on any host with a
# current uutils. GNU's own multi-call matches neither: it prints a usage line
# bare and `coreutils (GNU coreutils) <ver>` for --version. Output is captured
# rather than piped because under pipefail the non-zero exit would mask the
# match.
is_uutils_multicall() {
  case "$("$1" 2>&1 || true)" in *"multi-call binary"*) return 0 ;; esac
  case "$("$1" --version 2>&1 || true)" in *"multi-call binary"*) return 0 ;; esac
  return 1
}

uu="${FERN_UUTILS:-}"
uu_multicall=""
if [ -z "$uu" ]; then
  if p=$(command -v uutils-yes 2>/dev/null); then
    uu=$(dirname "$p")
  elif p=$(command -v coreutils 2>/dev/null) && is_uutils_multicall "$p"; then
    # Per-utility names go under $out (made below, removed on exit) on
    # demand by uutils_bin.
    uu_multicall="$p"
  else
    for d in /nix/store/*-uutils-coreutils-*/bin; do
      [ -x "$d/uutils-yes" ] && { uu="$d"; break; }
    done
  fi
fi
echo "coreutils-bench: uutils: ${uu_multicall:-${uu:-none — the column is dropped}}" >&2

# The multi-call binary's own list of the names it carries, which is what
# decides whether a utility gets a uutils cell. Authoritative, and the reason
# this is not a message probe: 0.11.0 refuses an absent name with `unknown
# program 'kill'`, which the old probe did not recognise, so it linked the
# name anyway and TIMED THE ERROR PATH — reporting `kill` as 7.6x faster than
# a uutils that has no `kill` at all. An older uutils without `--list` falls
# back to the probe below: Debian's 0.0.24 answers `--list` with its refusal
# ON STDOUT and exits 1, so the answer counts only when the exit status says
# it is one — taken as a list, the refusal named no utility and dropped the
# whole column.
uu_list=""
if [ -n "$uu_multicall" ]; then
  uu_list=$("$uu_multicall" --list 2>/dev/null) || uu_list=""
fi

# uutils_bin UTIL — the uutils binary for UTIL, or nothing.
uutils_bin() {
  [ -n "$uu" ] || return 0
  if [ -n "$uu_multicall" ] && [ ! -e "$uu/$1" ]; then
    if [ -n "$uu_list" ]; then
      printf '%s\n' "$uu_list" | grep -qxF -- "$1" && ln -s "$uu_multicall" "$uu/$1"
    else
      # No `--list`, so fall back to asking. Both refusal wordings are here:
      # `<name>: function/utility not found` and `unknown program '<name>'`.
      # Anything else (a version line, or test/[ treating --version as an
      # expression) means the name is carried.
      case "$("$uu_multicall" "$1" --version 2>&1 || true)" in
        *"function/utility not found"*) ;;
        *"unknown program"*) ;;
        *) ln -s "$uu_multicall" "$uu/$1" ;;
      esac
    fi
  fi
  if [ -x "$uu/uutils-$1" ]; then echo "$uu/uutils-$1"; elif [ -x "$uu/$1" ]; then echo "$uu/$1"; fi
}

# --- build ------------------------------------------------------------------

target="${FERN_TARGET:-}"
if [ -z "$target" ]; then
  case "$(uname -s)/$(uname -m)" in
    Linux/x86_64)  target=x86-64-linux ;;
    Linux/aarch64) target=arm64-linux ;;
    Darwin/arm64)  target=arm64-darwin ;;
    *) echo "coreutils-bench: no default target for $(uname -s)/$(uname -m); set FERN_TARGET" >&2; exit 1 ;;
  esac
fi

# WHICH FERN COMPILER BUILDS THE UTILITIES. `both` is the default: the
# self-hosted compiler is becoming the default one, so a row measured under
# the native build alone stops describing what a user gets.
compilers="${FERN_BENCH_COMPILERS:-both}"
case "$compilers" in
  both)     want_native=y;  want_selfhost=y  ;;
  native)   want_native=y;  want_selfhost="" ;;
  selfhost) want_native=""; want_selfhost=y  ;;
  *) echo "coreutils-bench: FERN_BENCH_COMPILERS must be both, native or selfhost (got '$compilers')" >&2; exit 2 ;;
esac
probe_timeout="${FERN_BENCH_PROBE_TIMEOUT:-60}"

# `timeout` is itself a GNU coreutils program, and on macOS the system ships
# none — so it is taken from the reference directories the bench already
# found rather than assumed on PATH.
if command -v timeout >/dev/null; then
  timeout_bin=timeout
else
  timeout_bin=$(gnu_bin timeout) || {
    echo "coreutils-bench: no timeout(1) on PATH or in $gnu_dirs" >&2; exit 1; }
fi

go build -o bin/fern ./cmd/fern

# bin/fern-selfhost is rebuilt when MISSING OR STALE. A binary left over from
# an earlier commit compiles the same sources into different code, and the
# column would then name a compiler nobody can identify. It is built for the
# HOST, because it has to run here; the utilities it emits are built for
# $target like the native leg's.
#
# Staleness is judged against the SOURCES of both compilers, never against
# bin/fern: `go build -o` rewrites its output whether or not anything changed,
# so `bin/fern -nt bin/fern-selfhost` is true on every run after the build
# above and would rebuild the self-host CLI every time.
if [ -n "$want_selfhost" ]; then
  if [ ! -x bin/fern-selfhost ] || [ -n "$(find examples/self_host cmd internal \
       \( -name '*.fern' -o -name '*.go' \) -newer bin/fern-selfhost -print -quit 2>/dev/null)" ]; then
    echo "coreutils-bench: building bin/fern-selfhost (missing or stale)" >&2
    make selfhost-cli >&2
  fi
fi

out=$(mktemp -d)
if [ -n "$uu_multicall" ]; then
  uu="$out/uutils"
  mkdir -p "$uu"
fi
trap 'rm -rf "$out"' EXIT
mkdir -p "$out/fern" "$out/selfhost"

if [ $# -eq 0 ]; then
  utils=()
  for f in coreutils/*.fern; do utils+=("$(basename "$f" .fern)"); done
  set -- "${utils[@]}"
fi
for u in "$@"; do
  [ -f "coreutils/$u.fern" ] || { echo "coreutils-bench: no coreutils/$u.fern" >&2; exit 1; }
  if [ -n "$want_native" ]; then
    ./bin/fern -O -target "$target" -o "$out/fern/$u" "coreutils/$u.fern"
  fi
  # The self-host CLI takes the stdlib root as a second operand and needs
  # ABSOLUTE paths: a relative one is unopenable from an arm64-darwin binary
  # (AT_FDCWD is -2 on XNU), and every other harness passes absolute for it.
  if [ -n "$want_selfhost" ]; then
    ./bin/fern-selfhost -O -target "$target" -o "$out/selfhost/$u" \
      "$PWD/coreutils/$u.fern" "$PWD/internal/stdlib"
  fi
done

# probe_completes CMD — run one trial of CMD under a time bound, so a build
# that cannot carry the workload is a reported cell instead of a hung bench.
# A NON-ZERO EXIT IS FINE and must stay fine: `false` exits 1 by design and
# `yes | head` dies of SIGPIPE, so only a timeout (124, or 137 after the kill
# signal) means the binary did not finish. Always through `sh -c`, including
# for the rows hyperfine times with -N: the probe is not timed, so a shell
# costs nothing here, and it is the only way a template carrying quoted
# operands (`fmt -p "" -w 40`) is split the way hyperfine will split it.
probe_completes() {
  local rc=0 t0 t1
  t0=$(date +%s%N)
  "$timeout_bin" -k 2 "$probe_timeout" sh -c "$1" >/dev/null 2>&1 || rc=$?
  t1=$(date +%s%N)
  probe_ms=$(( (t1 - t0) / 1000000 ))
  case "$rc" in 124|137) return 1 ;; esac
  return 0
}

# --- workloads --------------------------------------------------------------
#
# workloads UTIL — one line per workload: `label<TAB>shell?<TAB>template`,
# where {} stands for the binary under test and {gnu} for the GNU directory.
# `shell` is y when the template is a pipeline and needs one.
#
# One file per utility in coreutils-bench.d/, so adding a utility touches only
# its own file rather than a case statement every coreutils PR appends to
# (#8840). Utilities sharing one body — the digests, the base encodings — get
# a `_`-prefixed file the members source; no utility name starts with `_`.
workloads() {
  local f="scripts/coreutils-bench.d/$1.sh"
  if [ ! -f "$f" ]; then
    echo "coreutils-bench: no workloads defined for $1 — add $f" >&2
    exit 1
  fi
  # Sourced rather than run, so the arm still sees $1, $out, $gnu and $target.
  . "$f"
}

# --- measure ----------------------------------------------------------------

jsons=()
for u in "$@"; do
  uub=$(uutils_bin "$u")
  while IFS=$'\t' read -r label shell template; do
    cmds=()
    incomplete=()
    slowest_ms=0
    for impl in fern selfhost gnu uutils; do
      case "$impl" in
        fern)     [ -n "$want_native" ] || continue; bin="$out/fern/$u" ;;
        selfhost) [ -n "$want_selfhost" ] || continue; bin="$out/selfhost/$u" ;;
        gnu)      bin=$(gnu_bin "$u") || exit 1 ;;
        uutils)   bin="$uub"; [ -n "$bin" ] || continue ;;
      esac
      cmd=${template//\{gnu\}/$gnu}
      cmd=${cmd//\{\}/$bin}
      # Only the Fern builds are probed. The references are the binaries the
      # workload was sized against, so a GNU that did not finish would be the
      # finding rather than something to route around.
      case "$impl" in
        fern|selfhost)
          if ! probe_completes "$cmd"; then
            echo "coreutils-bench: $u: $label: $impl did not finish in ${probe_timeout}s" >&2
            incomplete+=("$impl")
            continue
          fi
          [ "$probe_ms" -gt "$slowest_ms" ] && slowest_ms=$probe_ms ;;
      esac
      cmds+=(-n "$impl" "$cmd")
    done
    json="$out/$u-$(echo "$label" | tr -c 'a-zA-Z0-9' '_').json"
    shellopt=(-N)
    [ "$shell" = y ] && shellopt=(--shell=sh)
    # A SLOW ROW IS CAPPED at roughly a minute per implementation. 20 runs plus
    # 3 warmups of a workload one trial of which takes 50 s is 20 minutes for
    # one row, and the self-host leg produces exactly that: a build slow enough
    # to matter but not slow enough to trip the probe. The cap keeps the run
    # bounded, the count never drops below 3 so a sigma still means something,
    # and the report prints the count wherever it is under 20 rather than
    # letting the header's "at least 20" cover a row that had five.
    runopt=(--warmup 3 --min-runs 20)
    if [ "$slowest_ms" -gt 3000 ]; then
      n=$(( 60000 / slowest_ms ))
      [ "$n" -lt 3 ] && n=3
      [ "$n" -gt 20 ] && n=20
      runopt=(--warmup 1 --runs "$n")
    fi
    # -i: false(1) exits 1 by design, and hyperfine would otherwise abort.
    hyperfine "${runopt[@]}" -i "${shellopt[@]}" --export-json "$json" \
      "${cmds[@]}" >/dev/null 2>&1 || {
      echo "coreutils-bench: hyperfine failed for $u: $label" >&2; exit 1; }
    # An implementation that exits differently from GNU on the same workload
    # did not do the work — uutils 0.0.24's ptx answers `GNU extensions not
    # implemented yet` and exits 1 in two milliseconds — so its cell names
    # the exit status rather than timing the refusal. GNU is the reference
    # because a non-zero exit can be the workload's own answer: `false`
    # exits 1 everywhere, and that agreement is what the comparison keeps.
    python3 - "$json" "$u" "$label" ${incomplete[@]+"${incomplete[@]}"} <<'PY'
import json, sys
path, util, label = sys.argv[1:4]
d = json.load(open(path))
d["util"], d["label"], d["incomplete"] = util, label, sys.argv[4:]
codes = {r["command"]: sorted(set(r.get("exit_codes") or [])) for r in d["results"]}
refused = {}
if "gnu" in codes:
    for impl, c in codes.items():
        if impl != "gnu" and c != codes["gnu"]:
            refused[impl] = c[0] if len(c) == 1 else c
d["refused"] = refused
json.dump(d, open(path, "w"))
PY
    jsons+=("$json")
  done < <(workloads "$u")
done

# --- report -----------------------------------------------------------------

table=$(python3 - "${jsons[@]}" <<'PY'
import json, sys

# `fern` is the native compiler's build, `fern-sh` the self-hosted compiler's
# build of the same source. Columns appear only for the implementations this
# run actually measured.
DISPLAY = {"fern": "fern", "selfhost": "fern-sh", "gnu": "gnu", "uutils": "uutils"}
ORDER = ["fern", "selfhost", "gnu", "uutils"]

rows = []
present = set()
for path in sys.argv[1:]:
    d = json.load(open(path))
    by = {r["command"]: r for r in d["results"]}
    inc = set(d.get("incomplete", []))
    ref = d.get("refused", {})
    present |= set(by) | inc
    rows.append((d["util"], d["label"], by, inc, ref))

impls = [i for i in ORDER if i in present]

# A ratio cell is mean(first) / mean(second), so above 1 the SECOND is faster.
# Each Fern build is ranked against each reference, then the two Fern builds
# against each other — which is the column that says what changing the default
# compiler costs.
ratios = []
for fern in ("fern", "selfhost"):
    if fern in impls:
        ratios += [(ref, fern) for ref in ("gnu", "uutils") if ref in impls]
if "fern" in impls and "selfhost" in impls:
    ratios.append(("fern", "selfhost"))

def ms(by, inc, ref, impl):
    if impl in inc:
        return "did not finish"
    if impl in ref:
        return f"exit {ref[impl]}"
    r = by.get(impl)
    if not r:
        return "—"
    cell = f'{r["mean"]*1000:.2f} ± {r["stddev"]*1000:.2f}'
    n = len(r.get("times") or [])
    return cell if n >= 20 or n == 0 else f"{cell} ({n} runs)"

def ratio(by, ref, a, b):
    ra, rb = by.get(a), by.get(b)
    return f'{ra["mean"]/rb["mean"]:.2f}×' if ra and rb and a not in ref and b not in ref else "—"

hdr = (["utility", "workload"]
       + [f"{DISPLAY[i]} (ms)" for i in impls]
       + [f"{DISPLAY[a]} / {DISPLAY[b]}" for a, b in ratios])
print("| " + " | ".join(hdr) + " |")
print("|" + "|".join("---" for _ in hdr) + "|")
for util, label, by, inc, ref in rows:
    cells = ([f"`{util}`", label]
             + [ms(by, inc, ref, i) for i in impls]
             + [ratio(by, ref, a, b) for a, b in ratios])
    print("| " + " | ".join(cells) + " |")
PY
)

header="coreutils-bench: $(date -u +%Y-%m-%d) $(uname -s)/$(uname -m), fern $(git rev-parse --short HEAD) (-O, $target), $("$gnu/yes" --version | head -1)"
# uutils prints argv[0] before its version, which for a symlink dir is a
# scratch path; name the implementation instead.
[ -n "$uu" ] && header="$header, uutils $("$(uutils_bin yes)" --version | head -1 | awk '{print $NF}')"
header="$header. mean ± σ over ≥20 runs, except where a cell names a smaller count because one trial of that row took over 3 s."
# Name the compiler behind each Fern column: two builds of one source are two
# different programs, and a table that does not say which is which cannot be
# read a month later.
if [ -n "$want_native" ] && [ -n "$want_selfhost" ]; then
  header="$header \`fern\` is the native compiler's build, \`fern-sh\` the self-hosted compiler's build of the same source."
elif [ -n "$want_selfhost" ]; then
  header="$header \`fern-sh\` is the self-hosted compiler's build."
fi
header="$header A ratio is mean(first) / mean(second), so above 1 the second-named build is faster — in a \`gnu / …\` or \`uutils / …\` column, above 1 means Fern is faster."

printf '%s\n\n%s\n' "$header" "$table"
if [ -n "$report" ]; then
  printf '%s\n\n%s\n' "$header" "$table" > "$report"
fi
