#!/usr/bin/env bash
# depth-repro — generate an N-arm `else if` chain and compile it with both
# compilers, reporting each one's peak RSS.
#
# The self-host compiler's IR lowering is SUPER-QUADRATIC in the nesting depth
# of an else-if chain, where the native compiler is linear (#6911). Its own emit
# dispatchers are exactly this shape, which is why three functions account for
# 2.28 GB of a self-compile's 6.55 GB of lowering allocation.
#
# Usage: depth-repro [N...]      (default: 100 200 400 800)
set -uo pipefail
cd "$(dirname "$0")/.."
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

peak() { # peak() CMD... -> peak RSS in KB, or "OOM"
  "$@" >/dev/null 2>&1 &
  local p=$! max=0 r
  while kill -0 $p 2>/dev/null; do
    r=$(awk '/VmHWM/{print $2}' /proc/$p/status 2>/dev/null)
    [ -n "${r:-}" ] && [ "$r" -gt "$max" ] && max=$r
  done
  wait $p; local rc=$?
  [ $rc -eq 0 ] && echo "$max" || echo "$max(rc=$rc)"
}

[ -x bin/fern ] || go build -o bin/fern ./cmd/fern
[ -x bin/fern-selfhost ] || { ./bin/fern -target x86-64-linux -o bin/fern-selfhost examples/self_host/fern.fern; chmod +x bin/fern-selfhost; }

printf '%-8s %14s %14s\n' arms native self-host
for n in "${@:-100 200 400 800}"; do
  awk -v n="$n" 'BEGIN{
    print "function pick(k: i32): i32 {"; print "    var r: i32 = 0;"
    for (i = 0; i < n; i++) printf "    %sif (k == %d) { r = %d; }\n", (i ? "else " : ""), i, i
    print "    else { r = 0 - 1; }"; print "    return r;"; print "}"
    print "function main(): i32 { return pick(3); }"
  }' > "$work/d.fern"
  printf '%-8s %14s %14s\n' "$n" \
    "$(peak ./bin/fern -target x86-64-linux -o /dev/null "$work/d.fern")" \
    "$(peak ./bin/fern-selfhost -target x86-64-linux -o /dev/null "$work/d.fern")"
done
