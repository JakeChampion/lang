#!/usr/bin/env bash
# net-bench — load the hello servers with oha and write a metrics report.
#
# Usage: net-bench [REPORT]
#
#   REPORT  where to write the `metric<TAB>value` report (default: stdout),
#           the format scripts/ci-check-perf reads and scripts/perf-history
#           records.
#
# Environment:
#
#   FERN_NET_BENCH_SECONDS      how long each load runs. Default: 10.
#   FERN_NET_BENCH_CONNECTIONS  the connection counts, space-separated.
#                               Default: "64 4096", the two points #9854's
#                               exit criterion names.
#   FERN_OHA                    the oha binary. Default: `oha` on PATH.
#   FERN_NET_BENCH_H3_SHAPES    the HTTP/3 loads, each CONNECTIONSxSTREAMS
#                               (streams in flight per connection).
#                               Default: "1x1 1x32 1x256 64x1 64x32".
#   FERN_H3_TOOLS               where scripts/net-bench.d/h3tools keeps the
#                               h2load and h2o it builds. Default:
#                               ~/.cache/fern-h3-tools.
#
# WHAT IS MEASURED. Four hello servers answering the same five-byte body
# on a loopback port: scripts/net-bench.d/hello.fern, built by bin/fern
# for the host; scripts/net-bench.d/gohello, Go's net/http with its
# defaults; scripts/net-bench.d/hyperhello, hyper 1's http1 server on a
# multi-threaded tokio runtime, built --locked against its Cargo.lock by
# the Rust toolchain mise.net-nightly.toml pins; and h2o, the host's
# package (Ubuntu's 2.2.5 on the runner), answering through an mruby
# handler with a worker thread per core. Then two servers whose handler
# fetches an upstream twice per request, P3's exit case
# (docs/NET-P3-SUSPENSION-PLAN.md §1): scripts/net-bench.d/twofetch.fern,
# a worker per core built by the self-host compiler (bin/fern-selfhost, whose
# suspension pass parks the handler on the upstream) reaching it through
# the forward proxy `http_proxy` names, since a handler's fetch refuses a
# loopback address; and the hyper crate's `twofetch` binary, hyper-util's
# pooled client on the multi-threaded runtime. The upstream is the Go
# hello. The report's header names the versions. oha holds N connections
# closed-loop for the duration and the report keeps its throughput and
# its p50 / p99 latency per server and N, and the server's own CPU per
# request, user and system (`server_user_us_per_req` / `server_sys_us_per_req`,
# the process group's utime / stime over the load divided by the requests
# answered) — the deterministic figure a throughput gap on a shared runner
# is attributed to, kernel or user time rather than guessed at. Plus, on
# x86-64, the bump-allocator growth one held idle connection, one suspended
# handler and one stream parked on an HTTP/2 connection cost the Fern loop
# (the numbers TestSelfHostHeldConnectionsHeapBoundX86_64 bounds). Closed-loop,
# without `-q`, because these are throughput ceilings: oha's latency
# correction only applies under a fixed rate, and the p99 here says how
# the server queues at saturation, not what a client at a given rate
# would see.
#
# HTTP/3. The Fern hello with H3 set serves HTTP/3 beside TCP; h2o
# serves it through quicly with a thread per core, answering from a
# five-byte file since its HTTP/3 build has no mruby. Both use one P-256
# certificate. h2load, nghttp2's load client built with HTTP/3, holds
# CONNECTIONS connections each keeping STREAMS requests in flight. The
# rows give its throughput, the p50 and p99 of its per-request log, and
# its failures. h2load sends a connection's next request only once the
# server has acknowledged the previous one, and h2o delays that
# acknowledgement up to 25 ms when a connection sends one packet at a
# time. So h2o's rows with one stream per connection, and any of its rows
# whose p50 is near 25 ms, measure that delay, not its speed. scripts/net-bench.d/h3tools builds both from source.
#
# RECORDED, NOT GATED. Wall-clock throughput on a shared runner moves by
# tens of percent between runs, which is why perf.yml counts instructions
# instead; nothing compares this report to a baseline. net-nightly.yml
# runs it once a night on main and appends the report to the commit's
# note under refs/notes/perf, so `scripts/perf-history show
# net/fern/c64.rps` is the trend.
#
#   net/<server>/c<N>.rps       requests per second, whole; <server> is
#                               fern, fern-ring (the same server waiting
#                               on an io_uring, FERN_IO_URING=1), go,
#                               hyper, h2o, fern-twofetch or
#                               hyper-twofetch
#   net/<server>/c<N>.p50_us    median latency, microseconds
#   net/<server>/c<N>.p99_us    99th-percentile latency, microseconds
#   net/<server>/c<N>.failed    responses that were not 200, plus errors
#                               other than the requests cut off by the end
#                               of the run
#   net/<server>/p<N>.rps       the pipelined profile: N connections each
#                               sending 16 requests in one write and
#                               reading the answers before the next batch
#                               (scripts/net-bench.d/pipeload), responses
#                               per second
#   net/<server>/p<N>.failed    connections that failed under it, other
#                               than closed by the server between answers
#   net/<server>/c<N>m<M>.rps   HTTP/3: N connections with M requests in
#                               flight on each, responses per second;
#                               <server> is fern-h3 or h2o-h3
#   net/<server>/c<N>m<M>.p50_us, .p99_us, .failed   as above
#   net/fern/held.bytes_per_connection          (x86-64 only)
#   net/fern/held.bytes_per_suspended_handler   (x86-64 only)
#   net/fern/held.bytes_per_stream              (x86-64 only)

set -euo pipefail

cd "$(dirname "$0")/.."

REPORT="${1:-/dev/stdout}"
SECONDS_PER="${FERN_NET_BENCH_SECONDS:-10}"
CONNECTIONS="${FERN_NET_BENCH_CONNECTIONS:-64 4096}"
H3_SHAPES="${FERN_NET_BENCH_H3_SHAPES:-1x1 1x32 1x256 64x1 64x32}"
OHA="${FERN_OHA:-oha}"

. scripts/net-lib

if ! command -v "$OHA" >/dev/null 2>&1; then
  echo "net-bench: $OHA not found; mise.toml pins it (mise install oha)" >&2
  exit 2
fi
if ! command -v cargo >/dev/null 2>&1; then
  echo "net-bench: cargo not found; mise.net-nightly.toml pins the toolchain (MISE_ENV=net-nightly mise install rust)" >&2
  exit 2
fi
if ! command -v h2o >/dev/null 2>&1; then
  echo "net-bench: h2o not found; the host's package supplies it (apt-get install h2o)" >&2
  exit 2
fi

# Thousands of connections need that many descriptors on both sides; the
# soft limit is raised to the hard one where the hard one allows it.
ulimit -n "$(ulimit -Hn)" 2>/dev/null || true

bin/fern -target "$TARGET" -o "$work/fern-hello" scripts/net-bench.d/hello.fern
go build -o "$work/go-hello" ./scripts/net-bench.d/gohello
go build -o "$work/pipeload" ./scripts/net-bench.d/pipeload
cargo build --release --locked --quiet --manifest-path scripts/net-bench.d/hyperhello/Cargo.toml --target-dir "$work/hyper-target"
cp "$work/hyper-target/release/hyperhello" "$work/hyper-hello"
cp "$work/hyper-target/release/twofetch" "$work/hyper-twofetch"
make selfhost-cli >&2
bin/fern-selfhost -target "$TARGET" -o "$work/fern-twofetch" "$PWD/scripts/net-bench.d/twofetch.fern" "$PWD/internal/stdlib"
hyper_version="$(sed -n '/^name = "hyper"$/{n;s/^version = "\(.*\)"/\1/p}' scripts/net-bench.d/hyperhello/Cargo.lock)"
h2o_version="$(h2o --version | sed -n 's/^h2o version \(.*\)/\1/p')"
h3tools="$(scripts/net-bench.d/h3tools)"
h2load_version="$("$h3tools/bin/h2load" --version | sed -n 's/^h2load nghttp2\/\(.*\)/\1/p')"
certs="$work/certs"
mkdir -p "$certs"
tls_certificate h3 P-256 '/CN=localhost' '' 'subjectAltName=DNS:localhost,IP:127.0.0.1'
printf 'hello' > "$work/hello.txt"

# start NAME PORT — the hello server NAME answering on PORT.
start() {
  if [ "$1" = h2o ]; then
    h2o_config "$2"
    start_server "$work/server.log" h2o -c "$work/h2o.conf"
  elif [ "$1" = fern-ring ]; then
    FERN_IO_URING=1 PORT="$2" start_server "$work/server.log" "$work/fern-hello"
  else
    PORT="$2" start_server "$work/server.log" "$work/$1-hello"
  fi
  await_server "$1" "$2" "$work/server.log"
}

# start_twofetch NAME PORT UPSTREAM_PORT — the two-fetch server NAME on
# PORT, reaching the hello on UPSTREAM_PORT: the Fern one through it as a
# forward proxy, the hyper one directly.
start_twofetch() {
  if [ "$1" = fern-twofetch ]; then
    http_proxy="http://u@127.0.0.1:$3" PORT="$2" start_server "$work/server.log" "$work/fern-twofetch"
  else
    UPSTREAM="http://127.0.0.1:$3/" PORT="$2" start_server "$work/server.log" "$work/hyper-twofetch"
  fi
  await_server "$1" "$2" "$work/server.log"
}

# start_h3 NAME PORT — the HTTP/3 server NAME on PORT, TCP and UDP.
start_h3() {
  if [ "$1" = h2o-h3 ]; then
    cat > "$work/h2o-h3.conf" <<EOF
listen: &tls
  host: 127.0.0.1
  port: $2
  ssl:
    certificate-file: $certs/h3.pem
    key-file: $certs/h3.key
    min-version: TLSv1.3
listen:
  <<: *tls
  type: quic
num-threads: $(nproc)
hosts:
  default:
    paths:
      /:
        file.file: $work/hello.txt
EOF
    start_server "$work/server.log" "$h3tools/bin/h2o" -c "$work/h2o-h3.conf"
  else
    TLS_CERT="$certs/h3.pem" TLS_KEY="$certs/h3.key" H3=1 PORT="$2" start_server "$work/server.log" "$work/fern-hello"
  fi
  await_port "$1" "$2" "$work/server.log"
}

# h3_rows NAME N M OUT LOG U0 S0 U1 S1 — the report rows for one HTTP/3
# load, from h2load's output and its per-request log, with the server
# group's user/system jiffies before (U0 S0) and after (U1 S1) for the
# server CPU per request.
h3_rows() {
  python3 - "$@" <<'PY'
import os, re, sys
name, n, m, out, log = sys.argv[1:6]
u0, s0, u1, s1 = (int(x) for x in sys.argv[6:10])
text = open(out).read()
rps = re.search(r"finished in [^,]*, ([0-9.]+) req/s", text)
req = re.search(r"requests: (\d+) total, \d+ started, \d+ done, (\d+) succeeded, (\d+) failed, (\d+) errored, (\d+) timeout", text)
if not rps or not req:
    sys.exit("net-bench: no h2load summary for %s c%sm%s:\n%s" % (name, n, m, text))
times = sorted(int(line.split()[2]) for line in open(log) if len(line.split()) == 3)
def pct(p):
    return times[min(len(times) - 1, int(len(times) * p))] if times else 0
failed = int(req.group(3)) + int(req.group(4)) + int(req.group(5))
done = int(req.group(2))
row = f"net/{name}/c{n}m{m}"
print(f"{row}.rps\t{int(float(rps.group(1)))}")
print(f"{row}.p50_us\t{pct(0.50)}")
print(f"{row}.p99_us\t{pct(0.99)}")
print(f"{row}.failed\t{failed}")
jiffy_us = 1e6 / os.sysconf("SC_CLK_TCK")
if done > 0:
    print(f"{row}.server_user_us_per_req\t{(u1 - u0) * jiffy_us / done:.2f}")
    print(f"{row}.server_sys_us_per_req\t{(s1 - s0) * jiffy_us / done:.2f}")
PY
}

# group_cpu PGID — the user and system jiffies the process group has spent,
# summed over every live member (the supervisor and its workers), as two
# space-separated numbers. Fields 14 (utime) and 15 (stime) of
# /proc/PID/stat, read after the last ')' so a comm with spaces or parens
# does not shift the split; field 5 is the process group.
group_cpu() {
  python3 - "$1" <<'PY'
import os, sys
pgid = int(sys.argv[1])
u = v = 0
for d in os.listdir("/proc"):
    if not d.isdigit():
        continue
    try:
        data = open("/proc/" + d + "/stat").read()
    except OSError:
        continue
    r = data.rfind(")")
    if r < 0:
        continue
    f = data[r + 2:].split()
    if len(f) < 13 or int(f[2]) != pgid:
        continue
    u += int(f[11])
    v += int(f[12])
print(u, v)
PY
}

# rows NAME N JSON U0 S0 U1 S1 — the report rows for one load, from oha's
# JSON and the server group's user/system jiffies before (U0 S0) and after
# (U1 S1) it, which give the server CPU per request each row carries.
rows() {
  python3 - "$1" "$2" "$3" "$4" "$5" "$6" "$7" <<'PY'
import json, os, sys
name, n, path = sys.argv[1], sys.argv[2], sys.argv[3]
u0, s0, u1, s1 = (int(x) for x in sys.argv[4:8])
j = json.load(open(path))
s = j["summary"]
p = j["latencyPercentiles"]
codes = j.get("statusCodeDistribution", {})
errs = j.get("errorDistribution", {})
failed = sum(v for k, v in codes.items() if k != "200")
failed += sum(v for k, v in errs.items() if "deadline" not in k)
done = sum(codes.values()) + sum(errs.values())
print(f"net/{name}/c{n}.rps\t{int(s['requestsPerSec'])}")
print(f"net/{name}/c{n}.p50_us\t{int(p['p50'] * 1e6)}")
print(f"net/{name}/c{n}.p99_us\t{int(p['p99'] * 1e6)}")
print(f"net/{name}/c{n}.failed\t{failed}")
jiffy_us = 1e6 / os.sysconf("SC_CLK_TCK")
if done > 0:
    print(f"net/{name}/c{n}.server_user_us_per_req\t{(u1 - u0) * jiffy_us / done:.2f}")
    print(f"net/{name}/c{n}.server_sys_us_per_req\t{(s1 - s0) * jiffy_us / done:.2f}")
PY
}

{
  echo "# scripts/net-bench report — arch $ARCH, target $TARGET, $(nproc) cpus"
  echo "# ${SECONDS_PER}s per load, connections: $CONNECTIONS, $("$OHA" --version), $(go version | cut -d' ' -f3), hyper $hyper_version ($(rustc --version | cut -d' ' -f2)), h2o $h2o_version"
  echo "# HTTP/3 loads (connections x streams): $H3_SHAPES, h2load $h2load_version, h2o $("$h3tools/bin/h2o" --version | sed -n 's/^h2o version //p') from scripts/net-bench.d/h3tools"
  for server in fern fern-ring go hyper h2o; do
    port="$(free_port)"
    start "$server" "$port"
    for n in $CONNECTIONS; do
      read -r u0 s0 <<< "$(group_cpu "$server_pgid")"
      "$OHA" -z "${SECONDS_PER}s" -c "$n" --no-tui --output-format json "http://127.0.0.1:$port/" > "$work/$server-c$n.json"
      read -r u1 s1 <<< "$(group_cpu "$server_pgid")"
      rows "$server" "$n" "$work/$server-c$n.json" "$u0" "$s0" "$u1" "$s1"
      "$work/pipeload" -addr "127.0.0.1:$port" -c "$n" -depth 16 -d "${SECONDS_PER}s" |
        awk -v s="$server" -v n="$n" '{ printf "net/%s/p%s.rps\t%s\nnet/%s/p%s.failed\t%s\n", s, n, $2, s, n, $4 }'
    done
    stop_server
  done
  upstream_port="$(free_port)"
  start go "$upstream_port"
  keep_as_upstream
  for server in fern-twofetch hyper-twofetch; do
    port="$(free_port)"
    start_twofetch "$server" "$port" "$upstream_port"
    for n in $CONNECTIONS; do
      read -r u0 s0 <<< "$(group_cpu "$server_pgid")"
      "$OHA" -z "${SECONDS_PER}s" -c "$n" --no-tui --output-format json "http://127.0.0.1:$port/" > "$work/$server-c$n.json"
      read -r u1 s1 <<< "$(group_cpu "$server_pgid")"
      rows "$server" "$n" "$work/$server-c$n.json" "$u0" "$s0" "$u1" "$s1"
    done
    stop_server
  done
  stop_upstream
  for server in fern-h3 h2o-h3; do
    port="$(free_port)"
    start_h3 "$server" "$port"
    for shape in $H3_SHAPES; do
      n="${shape%x*}"
      m="${shape#*x}"
      threads="$(nproc)"
      [ "$n" -lt "$threads" ] && threads="$n"
      # h2load appends to its log rather than starting it afresh.
      rm -f "$work/h3.log"
      read -r u0 s0 <<< "$(group_cpu "$server_pgid")"
      "$h3tools/bin/h2load" --alpn-list=h3 -c "$n" -m "$m" -t "$threads" -D "$SECONDS_PER" --warm-up-time=1 \
        --log-file="$work/h3.log" "https://127.0.0.1:$port/" > "$work/h3.out" 2>&1 || {
        echo "net-bench: h2load failed against $server:" >&2
        cat "$work/h3.out" >&2
        exit 1
      }
      read -r u1 s1 <<< "$(group_cpu "$server_pgid")"
      h3_rows "$server" "$n" "$m" "$work/h3.out" "$work/h3.log" "$u0" "$s0" "$u1" "$s1"
    done
    stop_server
  done
  if [ "$ARCH" = x86_64 ]; then
    # The per-connection heap cost, read off the test that bounds it.
    go test ./internal/testing/e2ecompiler -run 'TestSelfHostHeldConnectionsHeapBoundX86_64$' -count=1 -v > "$work/held.log" 2>&1 || {
      echo "net-bench: the held-connections measurement failed:" >&2
      cat "$work/held.log" >&2
      exit 1
    }
    per="$(sed -n 's/.*(\([0-9]*\) per connection).*/\1/p' "$work/held.log" | head -1)"
    suspended="$(sed -n 's/.*(\([0-9]*\) per handler).*/\1/p' "$work/held.log" | head -1)"
    stream="$(sed -n 's/.*(\([0-9]*\) per stream).*/\1/p' "$work/held.log" | head -1)"
    if [ -z "$per" ] || [ -z "$suspended" ] || [ -z "$stream" ]; then
      echo "net-bench: no per-connection, per-handler or per-stream figure in the held-connections log" >&2
      exit 1
    fi
    printf 'net/fern/held.bytes_per_connection\t%s\n' "$per"
    printf 'net/fern/held.bytes_per_suspended_handler\t%s\n' "$suspended"
    printf 'net/fern/held.bytes_per_stream\t%s\n' "$stream"
  fi
} > "$work/report"

cp "$work/report" "$REPORT"
