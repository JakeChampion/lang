#!/usr/bin/env bash
# profile-costs — measure what each build profile costs, and write a metrics
# report in scripts/ci-check-perf's format.
#
# Usage: profile-costs [REPORT]
#
#   REPORT  where to write the `metric<TAB>value` report (default: stdout).
#
# The security profiles (docs/security/PROFILES.md) add code to every
# program: a canary store and check per framed function, a landing-pad
# compare per indirect call, the shadow stack request, the relocation loop
# of a -pie image, and the sanitizer's shadow bookkeeping. Nothing measured
# that cost, so it could grow unobserved. This lane measures a subset of the
# bench corpus under the four profiles, for both native targets from one
# build of the self-host compiler.
#
# Per target and profile, three static metrics, deterministic for a commit:
#
#   profile/<target>/<bench>.<profile>.emit   indented lines of emitted
#                                             assembly, one per instruction
#   profile/<target>/<bench>.<profile>.bytes  size of the linked image
#   profile/<target>/startup.<profile>.bytes  size of the empty program, which
#                                             is the runtime's own cost
#
# And on an x86-64 host with valgrind, one dynamic metric:
#
#   profile/x86-64-linux/<bench>.<profile>.ir  retired instructions under
#                                              callgrind, which is where a
#                                              check on a hot path shows
#
# A compile that fails is a hard error, not a skipped row.
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT="$PWD"
REPORT="${1:-/dev/stdout}"
BENCH_DIR="$(cd "${FERN_BENCH_DIR:-bench}" && pwd)"
STDLIB="$ROOT/internal/stdlib"
make bin/fern >&2
SELFHOST="$ROOT/bin/fern"

BENCHES="int_loop call_overhead closure_call array_append map_string enum_match http_hello deflate_decode"
PROFILES="safe hardened diagnostic minimal"
TARGETS="x86-64-linux arm64-linux"

host_arch="$(uname -m)"
have_callgrind=0
if [ "$host_arch" = "x86_64" ] && command -v valgrind >/dev/null 2>&1; then
  have_callgrind=1
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
{
  echo "# scripts/profile-costs report — the cost of each build profile"
  echo "# metric keys: profile/<target>/<bench>.<profile>.emit, .bytes and, on x86-64 with valgrind, .ir"
  if [ "$have_callgrind" = 0 ]; then
    echo "# no-valgrind: the dynamic (.ir) rows were not measured on this host"
  fi
} > "$work/report"

printf 'function main(): i32 {\n  return 0;\n}\n' > "$work/startup.fern"

measure() {
  local target="$1" profile="$2" name="$3" src="$4"
  local asm="$work/$target-$profile-$name.s" bin="$work/$target-$profile-$name"
  if ! "$SELFHOST" -target "$target" -profile "$profile" -emit asm -o "$asm" "$src" "$STDLIB" > "$work/err" 2>&1; then
    echo "profile-costs: $name failed to emit for $target under $profile" >&2
    cat "$work/err" >&2
    exit 1
  fi
  local n
  n="$(grep -c '^[[:space:]]' "$asm" || true)"
  if [ "${n:-0}" = 0 ]; then
    echo "profile-costs: $name emitted no body lines for $target under $profile" >&2
    exit 1
  fi
  printf 'profile/%s/%s.%s.emit\t%s\n' "$target" "$name" "$profile" "$n" >> "$work/report"
  if ! "$SELFHOST" -target "$target" -profile "$profile" -o "$bin" "$src" "$STDLIB" > "$work/err" 2>&1; then
    echo "profile-costs: $name failed to link for $target under $profile" >&2
    cat "$work/err" >&2
    exit 1
  fi
  printf 'profile/%s/%s.%s.bytes\t%s\n' "$target" "$name" "$profile" "$(stat -c %s "$bin")" >> "$work/report"
  if [ "$have_callgrind" = 1 ] && [ "$target" = "x86-64-linux" ]; then
    local ir
    valgrind --tool=callgrind --callgrind-out-file=/dev/null \
      "$bin" > /dev/null 2> "$bin.cg" < /dev/null || true
    ir="$(sed -n 's/.*I *refs: *//p' "$bin.cg" | tr -d ', ' | head -1)"
    if [ -z "$ir" ]; then
      echo "profile-costs: callgrind produced no instruction count for $name under $profile" >&2
      exit 1
    fi
    printf 'profile/%s/%s.%s.ir\t%s\n' "$target" "$name" "$profile" "$ir" >> "$work/report"
  fi
}

for target in $TARGETS; do
  for profile in $PROFILES; do
    measure "$target" "$profile" startup "$work/startup.fern"
    for name in $BENCHES; do
      measure "$target" "$profile" "$name" "$BENCH_DIR/$name.fern"
    done
  done
done

sort "$work/report" | awk '/^#/ { print; next } { rows[++n] = $0 } END { for (i = 1; i <= n; i++) print rows[i] }' > "$REPORT"
