#!/usr/bin/env bash
#
# scripts/netlify-build — build the docs site + playground for a Netlify deploy.
#
# The steps:
#
#   1. Compile the playground's wasm bundle: the self-host compiler
#      (compiler/playground_run.fern, built by bin/fern-selfhost).
#   2. Stage web/ under site/public/playground/ so Astro serves it at
#      /playground/ alongside the docs.
#   3. Run `fern -doc` to emit the generated stdlib reference pages.
#   4. npm install && astro build under site/ → site/dist/.
#
# The wasm is compiled straight into the staging directory, not to
# web/playground.wasm, so a deploy leaves the source tree as it was.
#
# Netlify runs this from the repository root; `publish` is site/dist (see
# netlify.toml).

set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

stage=site/public/playground

# Go and Node are provisioned by the Netlify build image itself (GO_VERSION /
# NODE_VERSION in netlify.toml), before this command runs — mise is not
# bootstrapped in the deploy sandbox. Echoed so a toolchain mismatch is one
# glance into the deploy log rather than a puzzling compile error further down.
echo "==> $(go version)"
echo "==> node $(node --version)"

echo "==> building playground editor"
npm --prefix web/editor ci --no-audit --no-fund
npm --prefix web/editor run build

echo "==> compiling playground wasm"
rm -rf "$stage"
mkdir -p "$stage"
# The self-host compiler builds the compiler the page runs. `make selfhost-cli`
# is the native toolchain building it; the pinned `make bootstrap` needs no Go
# at all, but the deploy image has Go and no network policy for the pin.
make selfhost-cli
bin/fern-selfhost -target wasm32-wasi -emit core-module -embed internal/stdlib \
  -o "$stage/playground.wasm" "$PWD/compiler/playground_run.fern" "$PWD/internal/stdlib"

echo "==> staging playground assets"
web/stage.sh "$stage"

echo "==> generating stdlib reference"
site/scripts/stdlib-docs.sh

echo "==> building site"
cd site

# astro.config.mjs defaults `site` to the production origin, which a branch
# deploy or a preview must not name in its canonical and Open Graph URLs.
# Netlify exposes the deploy's own origin, so hand it over through the
# config's SITE_URL hook. URL is the production origin. DEPLOY_PRIME_URL is
# the branch or preview URL, and a production deploy sets it to the main--
# branch URL, so it applies only outside CONTEXT=production. Only set it when
# non-empty: the config falls back on a nullish value, and an empty string is
# not nullish — it would fail the build.
if [ -z "${SITE_URL:-}" ]; then
  if [ "${CONTEXT:-}" = production ]; then
    deploy_url="${URL:-}"
  else
    deploy_url="${DEPLOY_PRIME_URL:-${URL:-}}"
  fi
  if [ -n "$deploy_url" ]; then
    export SITE_URL="$deploy_url"
    echo "==> SITE_URL=$SITE_URL"
  fi
fi

npm install
npm run build
