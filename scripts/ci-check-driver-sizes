#!/usr/bin/env bash
# ci-check-driver-sizes — record the linked size of the self-host drivers and
# compare it against the checked-in baseline.
#
# Usage: ci-check-driver-sizes BASELINE REPORT
#
#   BASELINE  .github/selfhost-driver-sizes.txt — `driver bytes` per line, plus
#             a `# tracked-artifact: <name>` directive naming the headline
#             binary.
#   REPORT    `driver<TAB>bytes` per line, written by TestSelfHostWarmStockDriver
#             into FERN_DRIVER_SIZE_REPORT while the `warm` / `cli` jobs link the
#             drivers they were going to link anyway.
#
# WHY THIS EXISTS (#6826). The self-host binary shrank hard and then grew 16%
# back in eight days, and nothing in the repo would have told anyone: every
# driver is linked in CI on every run, so the number was produced dozens of
# times a day and never recorded, compared or asserted on.
#
# WARN BY DEFAULT, FAIL WHERE IT COUNTS. Findings are a job-summary line plus a
# warning annotation and exit 0; FERN_CI_SIZE_GATE_STRICT=1 makes them fatal.
# CI sets it on the one job that compares the union of every report and gates
# nothing else, so a finding blocks the merge without holding the test shards
# (#7519). The per-job callers stay advisory — their jobs the shards wait on.
#
# BOTH DIRECTIONS. A shrink is reported as well as a growth. Leaving the
# baseline high after a win means the next regression is measured against a
# ceiling nobody holds, which is exactly how the 16% went unnoticed.
#
# THE REPORT IS A SLICE UNLESS YOU SAY OTHERWISE. Each caller measures only the
# drivers it linked, so a lone `warm` job compares 5 of the 15 baselined names.
# Every run therefore states its own coverage, and a driver the baseline names
# but the report omits is a finding under FERN_SIZE_REPORT_COMPLETE=1 — set by
# the one caller whose report is the union of all of them. Without that check a
# vanished job is indistinguishable from a passing one: #7519 read a five-row
# table ending in "every driver is within tolerance" as the whole compiler.

set -euo pipefail

# Percentage drift, in either direction, that is worth a warning. Sizes are
# deterministic per commit (in-process pure-Go emit and link), so this is a
# significance threshold, not a noise floor.
TOLERANCE="${FERN_SIZE_TOLERANCE_PERCENT:-5}"

BASELINE="${1:-}"
REPORT="${2:-}"
if [ -z "$BASELINE" ] || [ -z "$REPORT" ]; then
  echo "usage: ci-check-driver-sizes BASELINE REPORT" >&2
  exit 2
fi
if [ ! -f "$BASELINE" ]; then
  echo "ci-check-driver-sizes: baseline '$BASELINE' not found" >&2
  exit 2
fi

# A missing or empty report means the drivers were never stat'd — the job did
# not export FERN_DRIVER_SIZE_REPORT, or the warm step died before linking
# anything. Say so loudly: a size check that measures nothing is worse than no
# size check, because it reports green.
if [ ! -s "$REPORT" ]; then
  echo "### self-host driver sizes"
  echo "NO SIZE REPORT at $REPORT — nothing was measured, so nothing was compared."
  if [ -n "${GITHUB_ACTIONS:-}" ]; then
    echo "::warning title=driver size check ran blind::no driver sizes were recorded at $REPORT: the warm step exported no FERN_DRIVER_SIZE_REPORT, or it linked no driver"
  else
    echo "WARNING: driver size check ran blind: no driver sizes were recorded at $REPORT"
  fi
  # Blind is a finding like any other, so strict mode has to fail on it. An
  # empty union is the loudest form of the thing this check exists to catch.
  if [ "${FERN_CI_SIZE_GATE_STRICT:-0}" = "1" ]; then
    echo "ci-check-driver-sizes: nothing was measured and FERN_CI_SIZE_GATE_STRICT=1" >&2
    exit 1
  fi
  exit 0
fi

# Whether this report is meant to name every baselined driver. Off for the
# per-job callers, whose reports are partial by construction.
COMPLETE="${FERN_SIZE_REPORT_COMPLETE:-0}"

routed="$(awk -v B="$BASELINE" -v tol="$TOLERANCE" -v complete="$COMPLETE" '
  function mb(bytes) { return sprintf("%.1f MB", bytes / 1000000) }
  BEGIN {
    tracked = ""
    while ((getline line < B) > 0) {
      if (line ~ /^[ \t]*#[ \t]*tracked-artifact:/) {
        sub(/^[ \t]*#[ \t]*tracked-artifact:[ \t]*/, "", line)
        sub(/[ \t]+$/, "", line)
        tracked = line
        continue
      }
      if (line ~ /^[ \t]*(#|$)/) continue
      if (split(line, fld, /[ \t]+/) < 2) continue
      if (!(fld[1] in base)) border[++bn] = fld[1]
      base[fld[1]] = fld[2] + 0
    }
    close(B)
  }
  NF >= 2 {
    if (!($1 in measured)) order[++n] = $1
    measured[$1] = $2 + 0
  }
  END {
    printf "SUMMARY\t### self-host driver sizes\n"
    printf "SUMMARY\t| driver | linked | baseline | delta |\n"
    printf "SUMMARY\t| --- | --- | --- | --- |\n"
    for (i = 1; i <= n; i++) {
      d = order[i]
      mark = (d == tracked) ? " (tracked artifact)" : ""
      if (d in base) {
        delta = 100 * (measured[d] - base[d]) / base[d]
        printf "SUMMARY\t| %s%s | %s | %s | %+.1f%% |\n", d, mark, mb(measured[d]), mb(base[d]), delta
      } else {
        printf "SUMMARY\t| %s%s | %s | none | unbaselined |\n", d, mark, mb(measured[d])
      }
    }

    nfind = 0
    nunbased = 0
    for (i = 1; i <= n; i++) {
      d = order[i]
      if (!(d in base)) {
        nunbased++
        paste[d] = measured[d]
        continue
      }
      delta = 100 * (measured[d] - base[d]) / base[d]
      if (delta > tol) {
        nfind++
        printf "SUMMARY\tGREW: %s %s -> %s (%+.1f%%, baseline %d -> %d bytes).\n", d, mb(base[d]), mb(measured[d]), delta, base[d], measured[d]
        printf "ANNOTATE\t%s grew %+.1f%%\t%s linked at %s against a baseline of %s — over the %s%% tolerance (#6826)\n", d, delta, d, mb(measured[d]), mb(base[d]), tol
        paste[d] = measured[d]
      } else if (delta < -tol) {
        nfind++
        printf "SUMMARY\tSHRANK: %s %s -> %s (%+.1f%%, baseline %d -> %d bytes).\n", d, mb(base[d]), mb(measured[d]), delta, base[d], measured[d]
        printf "ANNOTATE\t%s shrank %+.1f%%\t%s linked at %s against a baseline of %s — update the baseline so the win becomes the new ceiling (#6826)\n", d, delta, d, mb(measured[d]), mb(base[d])
        paste[d] = measured[d]
      }
    }

    if (nunbased > 0) {
      printf "SUMMARY\tUNBASELINED: %d driver(s) have no entry in the baseline, so their size is recorded but not compared.\n", nunbased
      printf "ANNOTATE\t%d driver(s) have no size baseline\tthey are linked and measured but nothing compares them; add the lines from the job summary to .github/selfhost-driver-sizes.txt (#6826)\n", nunbased
    }

    # A baselined driver absent from the report was not weighed at all. Only
    # the caller holding the union of every job'"'"'s report can tell that apart
    # from a slice, so this is off unless that caller says so.
    nmissing = 0
    missing = ""
    if (complete == "1") {
      for (i = 1; i <= bn; i++) {
        d = border[i]
        if (d in measured) continue
        nmissing++
        missing = missing (missing == "" ? "" : ", ") d
      }
    }
    if (nmissing > 0) {
      printf "SUMMARY\tMISSING: %d of %d baselined driver(s) are in the baseline but were not measured — %s.\n", nmissing, bn, missing
      printf "SUMMARY\tNothing compared them, so their size is unknown on this commit. A warm job that died, a driver dropped from FERN_WARM_DRIVER, and a name that drifted from the baseline all land here.\n"
      printf "ANNOTATE\t%d baselined driver(s) were not measured\t%s produced no size on this commit, so the comparison is incomplete; check every warm job published its size report (#7519)\n", nmissing, missing
    }

    nsug = 0
    for (i = 1; i <= n; i++) {
      d = order[i]
      if (!(d in paste)) continue
      if (nsug++ == 0) printf "SUMMARY\tCorrected baseline — paste into .github/selfhost-driver-sizes.txt:\n"
      printf "SUMMARY\t    %s %d\n", d, paste[d]
    }

    # Always state the denominator. "Every driver is within tolerance" over a
    # five-row slice of fifteen is how this gate read as whole-compiler cover
    # while two thirds of it went unweighed (#7519).
    ncompared = n - nunbased
    if (complete == "1") {
      printf "SUMMARY\tCoverage: %d of %d baselined drivers measured — this report is the union of every job'"'"'s, so it is meant to name them all.\n", ncompared, bn
    } else if (ncompared < bn) {
      printf "SUMMARY\tCoverage: %d of %d baselined drivers measured HERE — this report is one job'"'"'s slice, not the whole compiler. The union is compared in the driver-sizes job.\n", ncompared, bn
    } else {
      printf "SUMMARY\tCoverage: %d of %d baselined drivers measured.\n", ncompared, bn
    }

    if (nfind == 0 && nunbased == 0 && nmissing == 0) printf "SUMMARY\tEvery driver measured here is within %s%% of its baseline.\n", tol
    printf "FINDINGS\t%d\n", nfind + nunbased + nmissing
  }
' "$REPORT")"

findings=0
while IFS=$'\t' read -r tag rest; do
  if [ "$tag" = SUMMARY ]; then
    printf '%s\n' "$rest"
    if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then printf '%s\n' "$rest" >>"$GITHUB_STEP_SUMMARY"; fi
  elif [ "$tag" = FINDINGS ]; then
    findings="$rest"
  fi
done < <(printf '%s\n' "$routed")

while IFS=$'\t' read -r tag title msg; do
  [ "$tag" = ANNOTATE ] || continue
  if [ -n "${GITHUB_ACTIONS:-}" ]; then
    printf '::warning title=%s::%s\n' "$title" "$msg"
  else
    printf 'WARNING: %s: %s\n' "$title" "$msg"
  fi
done < <(printf '%s\n' "$routed")

if [ "${FERN_CI_SIZE_GATE_STRICT:-0}" = "1" ] && [ "$findings" -gt 0 ]; then
  echo "ci-check-driver-sizes: $findings finding(s) and FERN_CI_SIZE_GATE_STRICT=1" >&2
  exit 1
fi
