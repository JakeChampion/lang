#!/usr/bin/env python3
"""Compare native lossless WavPack decode with the pinned C reference."""

import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import platform
import random
import shutil
import statistics
import struct
import subprocess
import sys
import tempfile
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts/audio-reference"))
from wavpack_reference import encode, lib, verify

PIN = "4827b9889665b937b6ed71b9c6c0123152cd7a02"
HEADER_SHA = "3c61d65511e258c5dc120a6daaee626d6a1051f3254ca9b67ac654a8f6212a97"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def cases(frames):
    rng = random.Random(14779)
    for name, channels, bits, floating, flags in [
        ("music2", 2, 24, False, 0),
        ("music8", 8, 24, False, 0),
        ("noise2", 2, 24, False, 0),
        ("silence2", 2, 24, False, 0),
        ("integer32", 2, 32, False, 0x40000000),
        ("float2", 2, 32, True, 0x40000000),
    ]:
        samples = []
        for frame in range(frames):
            for channel in range(channels):
                if name == "noise2" or name == "integer32":
                    value = rng.randrange(-(1 << (bits - 1)), 1 << (bits - 1))
                elif name == "silence2":
                    value = 0
                else:
                    signal = (
                        math.sin(frame * 0.031 + channel * 0.23)
                        + math.sin(frame * 0.113 + channel * 0.07)
                    ) * 0.44
                    value = (
                        struct.unpack("<i", struct.pack("<f", signal))[0]
                        if floating
                        else int(signal * 8388607)
                    )
                samples.append(value)
        yield name, channels, bits, floating, flags, samples


def fields(output):
    return {
        key: int(value)
        for key, value in (
            line.split("=", 1) for line in output.splitlines() if "=" in line
        )
    }


def run(command, env):
    result = subprocess.run(
        command, check=True, capture_output=True, text=True, timeout=300, env=env
    )
    return fields(result.stdout)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--compiler",
        default=os.environ.get("FERN"),
        required=not bool(os.environ.get("FERN")),
    )
    parser.add_argument("--rounds", type=int, default=512)
    parser.add_argument("--trials", type=int, default=7)
    parser.add_argument("--frames", type=int, default=8192)
    parser.add_argument("--case", action="append", dest="cases")
    parser.add_argument("--cpu", type=int)
    parser.add_argument("--reference-include", type=Path)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    if (
        not 1 <= args.rounds <= 100000
        or args.trials < 3
        or not 4096 <= args.frames <= 262144
    ):
        parser.error(
            "use 1 through 100000 rounds, at least three trials, and 4096 through 262144 frames"
        )
    target = {
        ("Linux", "x86_64"): "x86-64-linux",
        ("Linux", "aarch64"): "arm64-linux",
    }.get((platform.system(), platform.machine()))
    if target is None:
        parser.error("use a native Linux x86-64 or ARM64 host")
    affinity = sorted(os.sched_getaffinity(0))
    cpu = args.cpu if args.cpu is not None else affinity[0]
    if cpu not in affinity:
        parser.error("CPU is outside the allowed affinity")
    os.sched_setaffinity(0, {cpu})
    compiler = Path(shutil.which(args.compiler) or args.compiler).resolve()
    core = compiler.with_name("fern-selfhost")
    env = dict(os.environ)
    env.pop("FERN_PROFILE", None)
    env.pop("FERN_PROFILE_FILE", None)
    selected = list(cases(args.frames))
    if args.cases:
        unknown = set(args.cases) - {case[0] for case in selected}
        if unknown:
            parser.error("unknown cases: " + ", ".join(sorted(unknown)))
        selected = [case for case in selected if case[0] in args.cases]
    sources = [
        ROOT / path
        for path in [
            "scripts/bench-wavpack",
            "bench/audio/wavpack_decode.fern",
            "scripts/audio-reference/wavpack_bench.c",
            "scripts/audio-reference/wavpack_reference.py",
            "scripts/audio-reference/wavpack-decode.fern",
        ]
    ]
    sources += sorted((ROOT / "internal/stdlib/std/audio/wavpack").glob("*.fern*"))
    sources.append(ROOT / "internal/stdlib/std/audio/wavpack.fern.md")
    library_paths = {
        line.split()[-1]
        for line in Path("/proc/self/maps").read_text().splitlines()
        if "/libwavpack.so" in line
    }
    result = {
        "schema": 1,
        "target": target,
        "platform": platform.platform(),
        "cpu": cpu,
        "allowed_affinity": affinity,
        "rounds": args.rounds,
        "trials": args.trials,
        "frames_per_file": args.frames,
        "group_frames": 4096,
        "compiler_sha256": sha(compiler),
        "compiler_core_sha256": sha(core) if core.exists() else None,
        "compiler_version": subprocess.check_output(
            [str(compiler), "-version"], text=True
        ).strip(),
        "git_head": subprocess.check_output(
            ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True
        ).strip(),
        "reference_commit": PIN,
        "reference_header_sha256": HEADER_SHA,
        "reference_version": lib.WavpackGetLibraryVersionString().decode(),
        "reference_library_sha256": {
            path: sha(Path(path)) for path in sorted(library_paths)
        },
        "source_sha256": {str(path.relative_to(ROOT)): sha(path) for path in sources},
        "measurement": "warm seek to zero, complete decode, CRC validation, and full PCM checksum; four warmup rounds; input, index, and context setup excluded",
        "output_storage": "reusable signed 32-bit PCM in both implementations; raw IEEE float bits",
        "native_peak_rss": "Linux process VmHWM after decode, including code, input, index, context, and output storage",
        "fresh_bytes": "Fern new runtime heap storage, not total allocation traffic; C allocation counts remain unmeasured",
        "limitations": "in-memory input on this host; no source I/O, startup latency, physical Android latency, power, or thermal measurements",
        "cases": {},
    }
    result["cpu_model"] = next(
        (
            line.split(":", 1)[1].strip()
            for line in Path("/proc/cpuinfo").read_text().splitlines()
            if line.startswith("model name")
        ),
        "",
    )
    quota = Path("/sys/fs/cgroup/cpu.max")
    result["cpu_quota"] = quota.read_text().strip() if quota.exists() else None
    with tempfile.TemporaryDirectory(prefix="fern-wavpack-bench-") as directory:
        temp = Path(directory)
        header = (
            (args.reference_include / "wavpack.h").read_bytes()
            if args.reference_include
            else urllib.request.urlopen(
                f"https://raw.githubusercontent.com/dbry/WavPack/{PIN}/include/wavpack.h",
                timeout=30,
            ).read()
        )
        assert hashlib.sha256(header).hexdigest() == HEADER_SHA
        (temp / "wavpack.h").write_bytes(header)
        binaries = {"fern": temp / "fern", "libwavpack": temp / "libwavpack"}
        subprocess.run(
            [
                str(compiler),
                "-stdlib",
                str(ROOT / "internal/stdlib"),
                "-O",
                "-target",
                target,
                "-o",
                str(binaries["fern"]),
                str(ROOT / "bench/audio/wavpack_decode.fern"),
            ],
            check=True,
            env=env,
        )
        subprocess.run(
            [
                "cc",
                "-O3",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-I",
                str(temp),
                "-o",
                str(binaries["libwavpack"]),
                str(ROOT / "scripts/audio-reference/wavpack_bench.c"),
                "-l:libwavpack.so.1",
            ],
            check=True,
        )
        decoder = temp / "verify"
        subprocess.run(
            [
                str(compiler),
                "-stdlib",
                str(ROOT / "internal/stdlib"),
                "-target",
                target,
                "-o",
                str(decoder),
                str(ROOT / "scripts/audio-reference/wavpack-decode.fern"),
            ],
            check=True,
            env=env,
        )
        result["binary_sha256"] = {name: sha(path) for name, path in binaries.items()}
        result["c_compiler"] = subprocess.check_output(
            ["cc", "--version"], text=True
        ).splitlines()[0]
        for name, channels, bits, floating, flags, samples in selected:
            path = temp / (name + ".wv")
            path.write_bytes(
                encode(samples, channels, bits, 48000, flags, 4096, floating)
            )
            reference = verify(path, samples, channels)
            pcm = temp / (name + ".s32le")
            subprocess.run(
                [str(decoder), str(path), str(pcm)],
                check=True,
                capture_output=True,
                env=env,
            )
            expected = b"".join(struct.pack("<i", sample) for sample in samples)
            assert pcm.read_bytes() == expected, (name, "independent PCM differs")
            trials = {mode: [] for mode in binaries}
            checks = set()
            for trial in range(args.trials):
                order = list(binaries) if trial % 2 == 0 else list(reversed(binaries))
                for mode in order:
                    row = run([str(binaries[mode]), str(path), str(args.rounds)], env)
                    assert row["samples"] == len(samples) * args.rounds
                    assert row["wall_ns"] > 0 and row["native_peak_rss_kb"] > 0
                    checks.add((row["samples"], row["checksum"]))
                    trials[mode].append(row)
            assert len(checks) == 1, (name, "benchmark PCM differs")
            medians = {
                mode: {
                    key: statistics.median(row[key] for row in rows) for key in rows[0]
                }
                for mode, rows in trials.items()
            }
            ratios = [
                trials["fern"][i]["wall_ns"] / trials["libwavpack"][i]["wall_ns"]
                for i in range(args.trials)
            ]
            result["cases"][name] = {
                "channels": channels,
                "bits": bits,
                "floating": floating,
                "flags": flags,
                "input_bytes": path.stat().st_size,
                "input_sha256": sha(path),
                "pcm_sha256": hashlib.sha256(expected).hexdigest(),
                "reference_info": reference,
                "raw_trials": trials,
                "median": medians,
                "paired_ratios": ratios,
                "median_paired_fern_over_c": statistics.median(ratios),
            }
            print(
                name + " " + json.dumps(medians, sort_keys=True),
                file=sys.stderr,
                flush=True,
            )
    output = json.dumps(result, indent=2) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(output)
    else:
        print(output, end="")


if __name__ == "__main__":
    main()
