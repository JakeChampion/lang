#!/usr/bin/env python3
"""Compare native Fern MP3 output with independent scalar and PCM references."""
import argparse
import hashlib
import importlib.util
import json
import math
import os
from pathlib import Path
import struct
import subprocess
import tempfile
import urllib.request

root = Path(__file__).resolve().parent.parent
os.chdir(root)
spec = importlib.util.spec_from_file_location('vectors', root / 'scripts/gen-mp3-vectors.py')
vectors = importlib.util.module_from_spec(spec)
spec.loader.exec_module(vectors)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--iso', action='store_true', help='also verify 14 pinned conformance bitstreams against ISO PCM')
parser.add_argument('--iso-only', action='store_true', help='run only the pinned ISO conformance checks')
args = parser.parse_args()
if args.iso_only:
    args.iso = True
compiler = os.environ.get('FERN') or subprocess.check_output(['./bootstrap/bootstrap.sh', 'stage0'], text=True).strip()
target = {'x86_64': 'x86-64-linux', 'aarch64': 'arm64-linux', 'arm64': 'arm64-darwin'}[os.uname().machine]


def floats(data):
    return struct.unpack('<' + 'f' * (len(data) // 4), data)


with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    ref = vectors.reference(tmp)
    ours = tmp / 'fern'
    subprocess.run([compiler, '-target', target, '-o', str(ours), 'scripts/audio-reference/mp3.fern', 'internal/stdlib'], check=True)
    worst = 0.0
    count = 0
    for rate in ([] if args.iso_only else [8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000]):
        for cc in [1, 2]:
            values = vectors.signal(rate, cc, int(rate * 0.22))
            for mode in ['low', 'high', 'vbr', 'gapless']:
                bitrate = ('16k' if rate < 16000 else '32k') if mode == 'low' else ('64k' if rate < 32000 else '320k')
                gapless = mode == 'gapless'
                data = vectors.encoded(tmp, rate, cc, values=values, bitrate=bitrate, vbr=mode in ['vbr', 'gapless'], gapless=gapless)
                path = tmp / 'case.mp3'
                path.write_bytes(data)
                reference = vectors.pcm_of(tmp, ref, data, gapless)
                command = [str(ours), str(path), str(tmp / 'ours.f32')]
                if gapless:
                    command.append('gapless')
                subprocess.run(command, stdout=subprocess.DEVNULL, check=True)
                actual = (tmp / 'ours.f32').read_bytes()
                assert actual == reference, (rate, cc, mode, 'scalar reference mismatch')
                ffmpeg = subprocess.run(['ffmpeg', '-v', 'error', '-i', str(path), '-f', 'f32le', 'pipe:1'], capture_output=True, check=True).stdout
                assert len(ffmpeg) == len(actual), (rate, cc, mode, 'sample count')
                error = max(abs(a - b) for a, b in zip(floats(actual), floats(ffmpeg)))
                assert math.isfinite(error) and error < 0.0001, (rate, cc, mode, error)
                worst = max(worst, error)
                count += 1
    if count:
        print(f'{count} MP3 files match scalar minimp3 bit for bit, including gapless output')
        print(f'FFmpeg maximum absolute sample difference: {worst:.8f}')
    if args.iso:
        manifest = json.loads((root / 'scripts/audio-reference/mp3-iso.json').read_text())
        assert manifest['revision'] == vectors.tables.REV
        for vector in manifest['vectors']:
            blobs = []
            for extension in ['bit', 'pcm']:
                data = urllib.request.urlopen(f'https://raw.githubusercontent.com/lieff/minimp3/{manifest["revision"]}/vectors/{vector["name"]}.{extension}', timeout=30).read()
                identity = hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest()
                assert identity == vector[extension + '_sha1']
                blobs.append(data)
            bitstream, pcm = blobs
            path = tmp / 'iso.mp3'
            path.write_bytes(bitstream)
            reference = vectors.pcm_of(tmp, ref, bitstream)
            subprocess.run([str(ours), str(path), str(tmp / 'ours.f32')], stdout=subprocess.DEVNULL, check=True)
            actual = (tmp / 'ours.f32').read_bytes()
            assert actual == reference, (vector['name'], 'scalar reference mismatch')
            decoded = [min(32767, max(-32768, int(v * 32768 + (0.5 if v >= 0 else -0.5)))) for v in floats(actual)]
            expected = struct.unpack('<' + 'h' * (len(pcm) // 2), pcm)
            # Some ISO PCM files omit the final encoded frame. Compare every supplied sample.
            assert len(expected) <= len(decoded) <= len(expected) + 2304, vector['name']
            difference = max(abs(a - b) for a, b in zip(decoded, expected))
            assert difference <= 1, (vector['name'], difference)
            mse = sum((a - b) ** 2 for a, b in zip(decoded, expected)) / len(expected)
            psnr = 10 * math.log10(32767 ** 2 / mse) if mse else math.inf
            assert psnr >= 96, (vector['name'], psnr)
            print(f'{vector["name"]}: scalar PCM exact, ISO difference <= {difference} integer step, PSNR {psnr:.2f} dB')
