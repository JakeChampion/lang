# net-lib — the harness scripts/net-bench, scripts/net-interop and
# scripts/net-tls-interop share, sourced (`. scripts/net-lib`) from the
# repository root: the target the host builds for, bin/fern built, a work
# directory removed on exit, servers run in a session of their own and
# stopped with their whole process group, a free loopback port, a TLS
# certificate made by openssl, and the lane's h2o configuration.
# shellcheck shell=bash

case "$(uname -m)" in
  x86_64)          ARCH=x86_64;  TARGET=x86-64-linux ;;
  aarch64 | arm64) ARCH=aarch64; TARGET=arm64-linux ;;
  *) echo "$(basename "$0"): unsupported host $(uname -m)" >&2; exit 2 ;;
esac

make bin/fern >&2

work="$(mktemp -d)"
# nginx's workers drop to an unprivileged user and read the files here.
chmod 755 "$work"
server_pgid=""
upstream_pgid=""

# start_server LOG CMD... — CMD in a session of its own, so a supervisor
# and every worker it forks form one process group, logging to LOG. The
# group is the one the new session's first process reports from inside
# it: `$!` names it only when the calling shell has job control off,
# since with job control on `setsid` forks and `$!` is a parent that has
# already exited.
start_server() {
  local log="$1"
  shift
  rm -f "$work/pgid"
  # shellcheck disable=SC2016
  setsid sh -c 'echo $$ > "$0"; exec "$@"' "$work/pgid" "$@" > "$log" 2>&1 &
  local tries=0
  until [ -s "$work/pgid" ]; do
    tries=$((tries + 1))
    if [ "$tries" -ge 50 ]; then
      echo "$(basename "$0"): $1 did not start" >&2
      exit 1
    fi
    sleep 0.1
  done
  server_pgid="$(cat "$work/pgid")"
}

# stop_group PGID — the process group, sent SIGTERM and then, if it is
# still there, SIGKILL. The Fern server drains for its shutdown grace
# after SIGTERM, so the group gets a few seconds before SIGKILL.
stop_group() {
  kill -TERM -- "-$1" 2>/dev/null || true
  local waited=0
  while kill -0 -- "-$1" 2>/dev/null && [ "$waited" -lt 25 ]; do
    sleep 0.2
    waited=$((waited + 1))
  done
  kill -KILL -- "-$1" 2>/dev/null || true
}
# stop_server — the group start_server began last.
stop_server() {
  if [ -n "$server_pgid" ]; then
    stop_group "$server_pgid"
    server_pgid=""
  fi
}
# keep_as_upstream — the server start_server began last stays up as the
# upstream the next servers reach, stopped by stop_upstream or at exit.
keep_as_upstream() {
  upstream_pgid="$server_pgid"
  server_pgid=""
}
stop_upstream() {
  if [ -n "$upstream_pgid" ]; then
    stop_group "$upstream_pgid"
    upstream_pgid=""
  fi
}
trap 'stop_server; stop_upstream; rm -rf "$work"' EXIT

# await_server NAME PORT LOG — once the server answers on PORT, or the
# run fails with its log.
await_server() {
  local tries=0
  until curl -s -m 1 -o /dev/null "http://127.0.0.1:$2/"; do
    tries=$((tries + 1))
    if [ "$tries" -ge 50 ]; then
      echo "$(basename "$0"): $1 did not answer on port $2" >&2
      cat "$3" >&2
      exit 1
    fi
    sleep 0.2
  done
}

# await_port NAME PORT LOG — once PORT accepts a connection, or the run
# fails with LOG: the readiness of a server that is not HTTP in the clear.
await_port() {
  local tries=0
  until python3 -c 'import socket, sys
s = socket.socket()
s.settimeout(1)
s.connect(("127.0.0.1", int(sys.argv[1])))' "$2" 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -ge 50 ]; then
      echo "$(basename "$0"): $1 did not listen on port $2" >&2
      cat "$3" >&2
      exit 1
    fi
    sleep 0.2
  done
}

# tls_certificate NAME KEY SUBJECT ISSUER EXT... — a certificate and its
# key under $certs (the caller's directory), self-signed when ISSUER is
# empty and otherwise signed by $certs/ISSUER; KEY is a curve name or
# ed25519. Two days of validity, for a run.
tls_certificate() {
  local name="$1" key="$2" subject="$3" issuer="$4"
  shift 4
  local args=()
  if [ "$key" = ed25519 ]; then
    args+=(-newkey ed25519)
  else
    args+=(-newkey ec -pkeyopt "ec_paramgen_curve:$key")
  fi
  if [ -n "$issuer" ]; then
    args+=(-CA "$certs/$issuer.pem" -CAkey "$certs/$issuer.key")
  fi
  local ext
  for ext in "$@"; do
    args+=(-addext "$ext")
  done
  openssl req -x509 -nodes -days 2 -subj "$subject" -keyout "$certs/$name.key" -out "$certs/$name.pem" "${args[@]}" 2> "$work/openssl-req.log" || {
    cat "$work/openssl-req.log" >&2
    exit 1
  }
}

free_port() {
  python3 -c 'import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])'
}

# The body the interop origins code on /gzip.
GZIP_TEXT="$(python3 -c 'print("hello gzip " * 30, end="")')"

# h2o_config PORT — the lane's h2o origin on PORT, written to
# $work/h2o.conf: "hello" on every path net-bench loads, and the targets
# scripts/net-interop reads on paths of their own, so the hello path
# stays the one net-bench measures. /gzip alone is coded on the fly.
h2o_config() {
  cat > "$work/h2o.conf" <<EOF
listen:
  host: 127.0.0.1
  port: $1
num-threads: $(nproc)
hosts:
  default:
    paths:
      /redirect:
        mruby.handler: |
          Proc.new do |env|
            [302, {"location" => "/hello"}, []]
          end
      /port:
        mruby.handler: |
          Proc.new do |env|
            [200, {"content-type" => "text/plain"}, [env["REMOTE_PORT"].to_s]]
          end
      /gzip:
        compress: ON
        mruby.handler: |
          Proc.new do |env|
            [200, {"content-type" => "text/plain"}, ["$GZIP_TEXT"]]
          end
      /:
        mruby.handler: |
          Proc.new do |env|
            [200, {"content-type" => "text/plain; charset=utf-8"}, ["hello"]]
          end
EOF
}
