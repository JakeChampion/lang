// Emit native QTRLE MOV metadata and complete decoded ARGB samples.
import "std/video/mp4";
import "std/video/mp4/file" as mp4file;
import "std/video/qtrle";
import "std/video/frame";
import "std/audio/file";
import "std/audio/source";
import "std/hex";

function pixels_hex(pixels: [u32]): string {
  let bytes: u8[] = [];
  for pixel in pixels {
    bytes = bytes.append((pixel >> 24u32) as u8).append((pixel >> 16u32) as u8).append((pixel >> 8u32) as u8).append(pixel as u8);
  }
  return hex.encode(bytes);
}

function emit_track(reader: Reader, track: mp4.Track): Result[void, string] {
  let description = track.descriptions[0];
  if (description.codec != mp4.QTRLE) {
    return Err("not QTRLE");
  }
  print("T " + track.clock.scale.to_string() + " " + description.depth.to_string() + " " + description.format.width.to_string() + " " + description.format.height.to_string());
  let Ok(initial) = frame.create(description.format, frame.default_limits()) else {
    return Err("frame storage");
  };
  let pixels = initial.pixels;
  for p in track.packets {
    let window = match (file.create(p.offset, p.bytes, source.Limits { chunk_size: 19, max_buffer_bytes: 1048576 })) {
      Ok(value) => value,
      Err(error) => { return Err(error.message()); },
    };
    while (!window.ready) {
      window = match (window.step(reader)) { Ok(value) => value, Err(error) => { return Err(error.message()); } };
    }
    let decoded = match (qtrle.decode_into(window.view(), description.format, description.depth, pixels, frame.default_limits())) {
      Ok(value) => value,
      Err(error) => { return Err(error.message()); },
    };
    pixels = decoded.pixels;
    print("P " + p.offset.to_string() + " " + p.bytes.to_string() + " " + p.decode_time.to_string() + " " + p.presentation_time.to_string() + " " + p.duration.to_string() + " " + p.sync.to_string() + " " + pixels_hex(pixels));
  }
  return Ok(());
}

function emit(reader: Reader): Result[void, string] {
  let index = match (mp4file.inspect(reader, mp4file.default_limits())) { Ok(value) => value, Err(error) => { return Err(error.message()); } };
  for track in index.tracks {
    emit_track(reader, track)?;
  }
  return Ok(());
}

function main(): i32 {
  let argv = args();
  if (argv.len() != 2) {
    return 2;
  }
  let Ok(reader) = open_reader(argv[1]) else {
    return 3;
  };
  let result = emit(reader);
  let closed = reader.close();
  if let Err(message) = result {
    eprint(message);
    return 1;
  }
  if let Err(error) = closed {
    eprint(error.message());
    return 1;
  }
  return 0;
}
