// Emit an audio-derived video anchor for an independent rational comparison.
import "std/video/playback_clock";
import "std/video/frame";
import "std/i64";
import "std/i32";

function main(): i32 {
  let argv = args();
  if (argv.len() != 6) {
    return 1;
  }
  let Ok(first_frame) = i64.parse_i64(argv[1]) else {
    return 2;
  };
  let Ok(first_us) = i64.parse_i64(argv[2]) else {
    return 2;
  };
  let Ok(position) = i64.parse_i64(argv[3]) else {
    return 2;
  };
  let Ok(rate) = i32.parse_i32(argv[4]) else {
    return 2;
  };
  let Ok(ns) = i64.parse_i64(argv[5]) else {
    return 2;
  };
  let clock = match (playback_clock.from_audio(playback_clock.AudioOrigin { frame_position: first_frame, media_us: first_us }, position, rate, ns)) {
    Ok(value) => value,
    Err(error) => { eprint(error.message()); return 3; },
  };
  print(clock.media_us.to_string());
  print(clock.monotonic_ns.to_string());
  return 0;
}
