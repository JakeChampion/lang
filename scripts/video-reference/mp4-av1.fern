// Emit AV1 packet metadata and original OBU bytes for an independent decoder.
import "std/video/mp4";
import "std/io";
import "./mp4-packet-input" as packets;

function main(): i32 {
  let a = args();
  if (a.len() != 3) {
    return 1;
  }
  if (a[1] == "file") {
    return packets.status(packets.seekable(a[2], mp4.AV1));
  }
  let Ok(input) = io.read_input_bytes(a[2]) else {
    return 2;
  };
  return packets.status(packets.complete(input, mp4.AV1));
}
