// Emit native Annex B ranges and packet conversions for independent checks.
import "std/video/nal";
import "std/video/frame";
import "std/hex";

function emit(bytes: [u8]): i32 {
  let limits = frame.default_limits();
  let at = 0;
  while (at < bytes.len()) {
    let Ok(Some(unit)) = nal.next_annex_b(bytes, at, limits) else {
      return 2;
    };
    print("U " + unit.offset.to_string() + " " + unit.size.to_string() + " " + hex.encode(bytes[unit.offset:unit.offset + unit.size]));
    at = unit.next_offset;
  }
  let Ok(packet) = nal.to_length_prefixed(bytes, 4, limits) else {
    return 3;
  };
  let Ok(restored) = nal.to_annex_b(packet, 4, limits) else {
    return 4;
  };
  print("P " + hex.encode(packet));
  print("B " + hex.encode(restored));
  return 0;
}

function configuration(bytes: [u8], hevc: boolean): i32 {
  let result = if (hevc) { nal.hevc_config(bytes, frame.default_limits()) } else { nal.avc_config(bytes, frame.default_limits()) };
  let config = match (result) {
    Ok(value) => value,
    Err(error) => { eprint(error.message()); return 6; },
  };
  if (hevc && config.csd1.len() != 0) {
    return 7;
  }
  let output = (if (hevc) { "C " } else { "A " }) + config.length_size.to_string() + " " + hex.encode(config.csd0);
  if (!hevc) {
    output += " " + hex.encode(config.csd1);
  }
  print(output);
  return 0;
}

function main(): i32 {
  let argv = args();
  let config = argv.len() == 3 && (argv[1] == "--hevc-config" || argv[1] == "--avc-config");
  if (argv.len() != 2 && !config) {
    return 1;
  }
  let Ok(bytes) = read_file_bytes(argv[if (config) { 2 } else { 1 }]) else {
    return 5;
  };
  return if (config) { configuration(bytes, argv[1] == "--hevc-config") } else { emit(bytes) };
}
