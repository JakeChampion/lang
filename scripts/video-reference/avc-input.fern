// Emit native AVC access units for independent parser and pixel comparisons.
import "std/video/avc/input";
import "std/video/nal/input" as nals;
import "std/audio/source";
import "std/video/frame";
import "std/hex";

function emit(reader: Reader): Result[void, string] {
  let defaults = input.default_limits();
  let limits = input.Limits { ...defaults, video: frame.Limits { ...defaults.video, max_packet_bytes: 1048576 }, input: nals.Limits { ...defaults.input, input: source.Limits { chunk_size: 3, max_buffer_bytes: 1048576 }, max_unit_bytes: 1048568 } };
  let stream = match (input.create(limits)) { Ok(value) => value, Err(error) => { return Err(error.message()); } };
  loop {
    let step = match (stream.step(reader)) { Ok(value) => value, Err(error) => { return Err(error.message()); } };
    stream = step.stream;
    match (step.event) {
      input.Waiting => {},
      input.End => {
        return Ok(());
      },
      input.PacketReady(packet) => {
        print("A " + packet.offset.to_string() + " " + (if (packet.idr) { "1" } else { "0" }) + " " + hex.encode(packet.bytes));
      }
    }
  }
}

function main(): i32 {
  let argv = args();
  if (argv.len() != 2) {
    return 2;
  }
  let Ok(reader) = open_reader(argv[1]) else {
    return 3;
  };
  let result = emit(reader);
  let closed = reader.close();
  return match (result) {
    Ok(_) => match (closed) { Ok(_) => 0, Err(error) => { eprint(error.message()); return 1; } },
    Err(message) => { eprint(message); return 1; },
  };
}
