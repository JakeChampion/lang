// Emit native HEVC sequence metadata for an independent syntax comparison.
import "std/video/hevc";
import "std/video/frame";
import "../../tests/stdlib/video_hevc_check" as check;

function main(): i32 {
  let argv = args();
  if (argv.len() != 2) {
    return 1;
  }
  let Ok(bytes) = read_file_bytes(argv[1]) else {
    return 2;
  };
  let sequence = match (hevc.inspect_sps(bytes, frame.default_limits())) {
    Ok(value) => value,
    Err(error) => { eprint(error.message()); return 3; },
  };
  for value in check.values(sequence) {
    print(value.to_string());
  }
  return 0;
}
