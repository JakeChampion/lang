#!/usr/bin/env bash
# check-fern-test-cache — prove the Go test cache can see a Fern-only change.
#
# `go test` reuses a cached result until something it can see changes, and what
# it can see is the package's Go files, the environment, the command line, and
# the files the TEST PROCESS opened. It cannot see what a compiler the test
# exec'd opened. A coreutils suite hands `coreutils/<util>.fern` to the `fern`
# binary, so without e2eharness.TrackFernSources reading that closure first, a
# `.fern` edit leaves the cached result standing: `ok … (cached)`, every subtest
# reported PASS, nothing executed (#9087).
#
# That failure is silent and reads exactly like a pass, so it gets its own gate.
# The probe: warm the cache, confirm a second run IS served from it, perturb a
# `.fern`, and require the third run not to be. The middle step is what keeps
# this from passing vacuously — if caching is off entirely (GOFLAGS=-count=1, a
# cold GOCACHE), step three would "pass" while proving nothing.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

probe="coreutils/true.fern"
suite='^TestTrueParity$'
pkg="./internal/coreutils/"
log="$(mktemp)"
backup="$(mktemp)"
cp "$probe" "$backup"
trap 'cp "$backup" "$probe"; rm -f "$log" "$backup"' EXIT

run() {
  # Never pipe a test run: the pipeline's status is the pipe's, not the test's.
  go test "$@" -run "$suite" "$pkg" >"$log" 2>&1 || {
    echo "check-fern-test-cache: $suite is failing before the probe even starts:" >&2
    cat "$log" >&2
    exit 1
  }
}

# Identical argument lists, twice: the cache key covers the command line, so a
# warm-up spelled differently (`-count=1`) would miss on a key of its own.
run
run
if ! grep -q '(cached)' "$log"; then
  echo "check-fern-test-cache: the second identical run was NOT served from the cache," >&2
  echo "so this gate cannot tell a working cache key from a disabled cache. Check" >&2
  echo "GOFLAGS and GOCACHE; do not read the result below as a pass." >&2
  exit 1
fi

printf '\n// check-fern-test-cache probe\n' >>"$probe"
run
if grep -q '(cached)' "$log"; then
  echo "check-fern-test-cache: $probe changed and $suite still came back (cached)." >&2
  echo "A Fern-only edit is invisible to the test cache again (#9087): whichever" >&2
  echo "harness compiles that source must call e2eharness.TrackFernSources first," >&2
  echo "so the closure is read by the test process and lands in its testlog." >&2
  exit 1
fi

echo "check-fern-test-cache: ok — a .fern change invalidates the cached result"
