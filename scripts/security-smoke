#!/usr/bin/env python3
"""Run the Linux security smoke matrix without skipped prerequisites."""

import argparse
import hashlib
import json
from pathlib import Path
import platform
import shutil
import struct
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
CASES = (
    "int_wrap", "int_checked_ops", "slice_at_length",
    "diag_e050", "diag_e051", "diag_e063",
    "oob_index_read", "oob_index_negative", "oob_index_write", "oob_slice_range",
)
MACHINES = {"x86-64-linux": 62, "arm64-linux": 183}


def executable(name):
    path = shutil.which(str(name))
    if path is None:
        raise RuntimeError(f"required executable is missing: {name}")
    return str(Path(path).resolve())


def elf_properties(data, machine):
    if len(data) < 64 or data[:7] != b"\x7fELF\x02\x01\x01":
        raise RuntimeError("expected a complete little-endian ELF64 header")
    kind, actual_machine, version = struct.unpack_from("<HHI", data, 16)
    if kind not in (2, 3) or version != 1 or struct.unpack_from("<H", data, 52)[0] != 64:
        raise RuntimeError("invalid ELF executable header")
    if actual_machine != machine:
        raise RuntimeError("wrong ELF machine")
    entry = struct.unpack_from("<Q", data, 24)[0]
    offset = struct.unpack_from("<Q", data, 32)[0]
    size, count = struct.unpack_from("<HH", data, 54)
    if size != 56 or count == 0 or offset < 64 or offset + size * count > len(data):
        raise RuntimeError("invalid ELF program header table")
    loads = []
    nx_stack = False
    executable_entry = False
    for index in range(count):
        kind, flags, start, vaddr, _, filesz, memsz, align = struct.unpack_from(
            "<IIQQQQQQ", data, offset + index * size
        )
        if start + filesz > len(data) or filesz > memsz:
            raise RuntimeError("ELF segment exceeds file or memory range")
        if kind == 1:
            if memsz > (1 << 64) - 1 - vaddr:
                raise RuntimeError("ELF load virtual range overflows")
            if align > 1 and (align & (align - 1) or start % align != vaddr % align):
                raise RuntimeError("invalid ELF load alignment")
            if flags & 3 == 3:
                raise RuntimeError("writable executable ELF load segment")
            if flags & 1 and vaddr <= entry < vaddr + filesz:
                executable_entry = True
            loads.append((flags, vaddr, memsz))
        if kind == 0x6474E551:
            if flags & 1:
                raise RuntimeError("executable ELF stack")
            nx_stack = True
    if not nx_stack or not any(f & 1 for f, _, _ in loads):
        raise RuntimeError("missing NX stack or executable load segment")
    if not executable_entry:
        raise RuntimeError("ELF entry is outside file-backed executable memory")
    for index, (flags, start, size) in enumerate(loads):
        for other_flags, other_start, other_size in loads[index + 1:]:
            if size == 0 or other_size == 0:
                continue
            if (flags | other_flags) & 3 == 3:
                if max(start // 4096, other_start // 4096) < min(
                    (start + size + 4095) // 4096,
                    (other_start + other_size + 4095) // 4096,
                ):
                    raise RuntimeError("writable and executable load pages overlap")
    return {"machine": machine, "wx": True, "nx_stack": True, "load_segments": len(loads)}


def command(args, timeout, records, **kwargs):
    result = subprocess.run(args, capture_output=True, timeout=timeout, **kwargs)
    records.append({
        "command": [str(a) for a in args], "exit": result.returncode,
        "stdout": result.stdout.decode(errors="replace"),
        "stderr": result.stderr.decode(errors="replace"),
    })
    return result


def run_case(compiler, qemu, readelf, target, name, work, timeout, records):
    case = ROOT / "conformance" / "cases" / name
    source, output = case / "main.fern", work / f"{target}-{name}"
    error = case / "expected.error"
    args = [compiler, "-target", target]
    args += ["-check", source] if error.exists() else ["-o", output, source]
    built = command(args, timeout, records)
    if error.exists():
        diagnostics = (built.stdout + built.stderr).decode(errors="replace")
        expected = error.read_text().splitlines()
        if built.returncode <= 0 or not expected or any(line not in diagnostics for line in expected):
            raise RuntimeError(f"{target}/{name}: wrong compile-fail diagnostic")
        if output.exists():
            raise RuntimeError(f"{target}/{name}: rejected source produced an executable")
        return {"target": target, "case": name, "result": "rejected"}
    if built.returncode != 0:
        raise RuntimeError(f"{target}/{name}: compiler failed: {built.stderr.decode(errors='replace')}")
    properties = elf_properties(output.read_bytes(), MACHINES[target])
    inspected = command([readelf, "-W", "-h", "-l", output], timeout, records)
    if inspected.returncode != 0:
        raise RuntimeError(f"{target}/{name}: readelf refused compiler output")
    output.chmod(0o755)
    runner = [qemu, "-cpu", "max"] if target == "arm64-linux" else []
    result = command(runner + [output], timeout, records, input=b"")
    exit_file, stdout_file = case / "expected.exit", case / "expected.stdout"
    wanted_exit = int(exit_file.read_text()) if exit_file.exists() else 0
    wanted_stdout = stdout_file.read_bytes() if stdout_file.exists() else b""
    if result.returncode != wanted_exit or result.stdout != wanted_stdout:
        raise RuntimeError(f"{target}/{name}: expected exit {wanted_exit} and corpus stdout, got {result.returncode}")
    if wanted_exit == 134:
        cause = b"fern: slice range out of bounds" if name == "oob_slice_range" else b"fern: array index out of range"
        if cause not in result.stderr:
            raise RuntimeError(f"{target}/{name}: missing bounds failure cause")
    elif result.stderr:
        raise RuntimeError(f"{target}/{name}: unexpected stderr")
    return {"target": target, "case": name, "result": "passed", "elf": properties}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--compiler", default=ROOT / "bin" / "fern")
    parser.add_argument("--qemu", default="qemu-aarch64")
    parser.add_argument("--report", type=Path, default=ROOT / "build" / "security-smoke.json")
    parser.add_argument("--timeout", type=int, default=120)
    args = parser.parse_args()
    report = {
        "host": platform.platform(), "cpu": platform.machine(),
        "hardware_enforcement": {name: "unverified" for name in ("CET", "PAC", "BTI", "MTE")},
        "cases": [], "commands": [], "result": "failed",
    }
    try:
        if platform.system() != "Linux" or platform.machine() != "x86_64":
            raise RuntimeError("this matrix requires native Linux x86-64 and emulated AArch64")
        if args.timeout <= 0:
            raise RuntimeError("timeout must be positive")
        compiler, qemu, readelf = executable(args.compiler), executable(args.qemu), executable("readelf")
        report["compiler_sha256"] = hashlib.sha256(Path(compiler).read_bytes()).hexdigest()
        report["source_commit"] = subprocess.check_output(["git", "-C", ROOT, "rev-parse", "HEAD"], text=True).strip()
        for tool in (qemu, readelf):
            command([tool, "--version"], args.timeout, report["commands"])
        with tempfile.TemporaryDirectory(prefix="fern-security-") as temp:
            for target in MACHINES:
                for name in CASES:
                    result = run_case(compiler, qemu, readelf, target, name, Path(temp), args.timeout, report["commands"])
                    report["cases"].append(result)
                    print(f"PASS {target}/{name}", flush=True)
        report["result"] = "passed"
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        report["error"] = str(error)
        print(f"FAIL {error}", file=sys.stderr)
    finally:
        args.report.parent.mkdir(parents=True, exist_ok=True)
        args.report.write_text(json.dumps(report, indent=2) + "\n")
    return 0 if report["result"] == "passed" else 1


if __name__ == "__main__":
    sys.exit(main())
