// The stateful server the soak lane holds under load: a bounded map of the
// paths seen most recently, the oldest evicted past the bound, so the
// state churns without growing.
import "std/i32";
import "std/array";
import "std/result";
import "std/http";
import "std/serve";
import "std/platform";
import "core/map";

struct Recent { hits: Map[string, i32], order: string[] }

function bound(): i32 {
  return 256;
}

function evict_oldest(r: Recent): Recent {
  return Recent { hits: r.hits.remove(r.order[0]), order: array.drop(r.order, 1) };
}

function handle(r: Recent, req: HttpRequest, plat: platform.Platform): (Recent, HttpResponse) {
  let key = req.path + "";
  let seen = r.hits.get_or(key, 0);
  let next = r;
  if (seen == 0) {
    next = Recent { hits: next.hits.insert(key, 1), order: next.order.append(key) };
    if (next.order.len() > bound()) {
      next = evict_oldest(next);
    }
  } else {
    next = Recent { ...next, hits: next.hits.insert(key, seen + 1) };
  }
  return (next, http.ok(f"{seen + 1} of {next.order.len()}"));
}

function port(): i32 {
  let Some(p) = env("PORT") else {
    return 8080;
  };
  return i32.parse_i32_radix(p, 10).unwrap_or(8080);
}

function main(): i32 {
  let opts = serve.Config { ...serve.config(), max_connections: 16384, max_connections_per_ip: 0 };
  return serve.exit_code(serve.run_with(port(), opts, Recent { hits: map_new(512), order: [] }, handle));
}
