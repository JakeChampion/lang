import "std/http";
import "std/serve";
import "std/platform";
import "std/json";
import "core/int";

function handle(req: HttpRequest, plat: platform.Platform): HttpResponse {
  match (req.body_string()) {
    Ok(text) => {
      match (json.json_parse_result(text)) {
        Ok(v) => {
          return http.json(json.json_encode(v));
        },
        Err(e) => {
          return http.text(400, e.to_string());
        }
      }
    },
    Err(_) => {
      return http.text(400, "body is not text");
    }
  }
  return http.text(400, "");
}

function port(): i32 {
  match (env("PORT")) {
    Some(p) => {
      match (int.parse_int_radix(p, 10)) {
        Some(n) => {
          return n;
        },
        None => {
          return 8080;
        }
      }
    },
    None => {
      return 8080;
    }
  }
  return 8080;
}

function main(): i32 {
  let opts: serve.Config = serve.Config { ...serve.config(), max_connections: 16384, max_connections_per_ip: 0 };
  return serve.run(port(), opts, handle);
}
