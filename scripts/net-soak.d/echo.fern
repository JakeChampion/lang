// The JSON echo server the soak lane holds under load: every request body
// is parsed and encoded again, so a request allocates and frees a tree.
import "std/i32";
import "std/result";
import "std/http";
import "std/serve";
import "std/platform";
import "std/json";
import "core/int";

function handle(req: HttpRequest, plat: platform.Platform): HttpResponse {
  let Ok(text) = req.body_text() else {
    return http.text(400, "body is not text");
  };
  return match (json.parse(text)) { Ok(v) => http.json(json.encode(v)), Err(e) => http.text(400, e.to_string()) };
}

function port(): i32 {
  let Some(p) = env("PORT") else {
    return 8080;
  };
  return i32.parse_i32_radix(p, 10).unwrap_or(8080);
}

function main(): i32 {
  let opts = serve.Config { ...serve.config(), max_connections: 16384, max_connections_per_ip: 0 };
  return serve.exit_code(serve.run(port(), opts, handle));
}
