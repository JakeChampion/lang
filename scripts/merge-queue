#!/usr/bin/env python3
"""merge-queue — a merge queue for a repository that GitHub gives none.

GitHub has merge queues only for a repository of an organization. This script
and two workflows do the same work with a label, a branch and Actions.

    merge-queue form          make the next batch and start its suite
    merge-queue land RESULT   end the batch whose suite concluded RESULT

HOW A PULL REQUEST MERGES. `form` gives the `merge-queue` label to each open
pull request whose own `CI verdict` is green. A draft does not get it, and
neither does a pull request with the `merge-queue-hold` label. A person can
also add the label before CI is green. `form` takes the labelled pull requests
that are green, oldest number first, and merges up to MERGE_QUEUE_BATCH (10)
of them, in that order, on the tip of main. It pushes the result to the branch `merge-queue/batch` and dispatches
merge-queue-batch.yml there, which runs the full suite. `land success` moves
main to that same commit, so main only gets a tree that the suite passed.
GitHub then shows each pull request of the batch as merged.

One batch is in flight at a time: the branch is the lock. A lock with no
run of merge-queue-batch.yml that is still going is stale: its dispatch
failed, or `land` did not end. `form` deletes a stale lock, and its pull
requests join the next batch. A lock that is younger than STALE_SECONDS and
has no run yet is live, because GitHub can show a dispatched run late.

A RED BATCH IS SPLIT. `land failure` on a batch of more than one pull request
puts its two halves in the retry list, and `form` tests a group of that list
before it takes new pull requests. A batch of one that fails is that pull
request's failure: it loses the label and gets a comment with the run.

A PULL REQUEST WITH THE `ci-priority` LABEL GOES FIRST. It is for a pull
request that repairs main: while main is red, every other suite fails. `form`
takes it before the retry list and before the other pull requests, in a batch
with only priority pull requests, and it does not wait for its own `CI
verdict`: the suite of the batch tests main with the pull request merged on it.
`form` cancels a batch in flight that has no priority pull request, and `land`
then puts that batch back at the front of the retry list. When the priority
batch starts, `form` cancels each pull request suite that is under way and runs
it again. The first job of each pull request suite (`ci-suite.yml`) waits while
a priority batch is in flight, so the suites run after it. A draft and a pull
request with `merge-queue-hold` do not go first. A priority pull request that
the queue removed goes first again with a new commit, or when a person adds
the `merge-queue` label.

A PULL REQUEST THAT DOES NOT MERGE CLEANLY loses the label and gets a comment.

A PULL REQUEST THAT LOST THE LABEL does not get it again at the same head. A
new commit, or a person who adds the label, puts it back in the queue.
One that gets new commits while its batch is in flight stays open after the
batch lands, with the new commits as its diff.

MAIN CAN MOVE UNDER A BATCH. When main got only pin-file commits (the
rebank-main job), `land` merges them in and pushes. For any other commit it
puts the batch back at the front of the retry list.

STATE is one JSON blob at refs/merge-queue/state:
{"retry": [[numbers], ...], "removed": {"number": "head sha"}}.

The script talks to GitHub through the `gh` command (MERGE_QUEUE_GH names a
replacement, which the tests use) and to the repository through git. The
calls to the Actions API use MERGE_QUEUE_ACTIONS_TOKEN when it is set: a
personal access token that can push workflow files may have no Actions
permission, and the token of the workflow has it.
"""
import json
import os
import subprocess
import sys
import time

LABEL = "merge-queue"
HOLD = "merge-queue-hold"
PRIORITY = "ci-priority"
BATCH = "merge-queue/batch"
STATE_REF = "refs/merge-queue/state"
WORKFLOW_BATCH = "merge-queue-batch.yml"
WORKFLOW_FORM = "merge-queue.yml"
WORKFLOW_CI = "ci.yml"
# The jobs of the suite that ci.yml calls, and the first of them, which waits
# for a priority batch (ci-suite.yml).
SUITE_JOBS = "Full suite / "
GATE_JOB = SUITE_JOBS + "Wait for a priority batch"
PIN_PREFIXES = (".github/alloc-baseline.txt", ".github/certify-baseline.txt", ".github/cliff-baseline.txt",
                ".github/perf-baseline", ".github/profile-costs-baseline.txt")
REMOTE = os.environ.get("MERGE_QUEUE_REMOTE", "origin")
GH = os.environ.get("MERGE_QUEUE_GH", "gh")
MAX = int(os.environ.get("MERGE_QUEUE_BATCH", "10"))
STALE_SECONDS = int(os.environ.get("MERGE_QUEUE_STALE_SECONDS", "900"))
# How long `form` waits for a cancelled suite to end before it runs it again.
KICK_SECONDS = int(os.environ.get("MERGE_QUEUE_KICK_SECONDS", "180"))
SIGNATURE = "\n\n---\n_Posted by the merge queue (`scripts/merge-queue`)._"


def run(*args, check=True, stdin=None, env=None):
    r = subprocess.run(args, input=stdin, capture_output=True, text=True, env=env)
    if check and r.returncode != 0:
        sys.stderr.write(f"merge-queue: {' '.join(args)}\n{r.stdout}{r.stderr}")
        raise SystemExit(1)
    return r


def git(*args, check=True, stdin=None):
    return run("git", *args, check=check, stdin=stdin)


def gh(*args, check=True):
    return run(GH, *args, check=check)


def gh_actions(*args, check=True):
    """A call to the Actions API, with the token that has that permission."""
    token = os.environ.get("MERGE_QUEUE_ACTIONS_TOKEN")
    env = {**os.environ, "GH_TOKEN": token} if token else None
    return run(GH, *args, check=check, env=env)


def note(text):
    print(f"merge-queue: {text}", flush=True)


def load_state():
    state = {}
    if git("fetch", "-q", REMOTE, STATE_REF, check=False).returncode == 0:
        state = json.loads(git("cat-file", "-p", "FETCH_HEAD").stdout)
    state.setdefault("retry", [])
    state.setdefault("removed", {})
    return state


def save_state(state):
    blob = git("hash-object", "-w", "--stdin", stdin=json.dumps(state) + "\n").stdout.strip()
    git("push", "-q", "-f", REMOTE, f"{blob}:{STATE_REF}")


def batch_head():
    """The commit of the lock branch, or "" when there is no batch."""
    r = git("ls-remote", "--exit-code", "--heads", REMOTE, BATCH, check=False)
    return r.stdout.split()[0] if r.returncode == 0 else ""


def batch_runs(head):
    """The runs of the batch `head`, or None when they cannot be read."""
    r = gh_actions("run", "list", "--workflow", WORKFLOW_BATCH, "--branch", BATCH, "--limit", "20",
                   "--json", "databaseId,headSha,status", check=False)
    if r.returncode != 0:
        return None
    return [x for x in json.loads(r.stdout or "[]") if x.get("headSha") == head]


def batch_is_live(head):
    """True while a run of the batch `head` is going, or can still start."""
    runs = batch_runs(head)
    if runs is None:
        note("cannot read the runs of the batch: the lock stays")
        return True
    if runs:
        return any(x.get("status") != "completed" for x in runs)
    git("fetch", "-q", REMOTE, BATCH)
    made = int(git("log", "-1", "--format=%ct", "FETCH_HEAD").stdout.strip())
    return time.time() - made < STALE_SECONDS


def release(why):
    note(f"the lock is stale ({why}): it goes")
    git("push", "-q", REMOTE, f":refs/heads/{BATCH}", check=False)


def open_prs():
    out = gh("pr", "list", "--state", "open", "--limit", "200",
             "--json", "number,headRefOid,headRefName,isDraft,labels").stdout
    prs = sorted(json.loads(out), key=lambda p: p["number"])
    for pr in prs:
        pr["labels"] = [label["name"] for label in pr["labels"]]
    return prs


def verdict_is_green(sha):
    out = gh("api", f"repos/{{owner}}/{{repo}}/commits/{sha}/check-runs?check_name=CI%20verdict&filter=latest",
             check=False)
    if out.returncode != 0:
        return False
    runs = json.loads(out.stdout).get("check_runs", [])
    return any(r.get("conclusion") == "success" for r in runs)


def priority_prs(state, prs):
    """The pull requests with the priority label that the queue can take now.

    A pull request of the retry list is not one of them: its group is tested
    first, in the order of the list."""
    retried = {n for group in state["retry"] for n in group}
    return [pr for pr in prs
            if PRIORITY in pr["labels"] and not pr["isDraft"] and HOLD not in pr["labels"]
            and pr["number"] not in retried
            and (LABEL in pr["labels"] or state["removed"].get(str(pr["number"])) != pr["headRefOid"])]


def batch_has_priority(head, prs):
    git("fetch", "-q", REMOTE, BATCH)
    git("fetch", "-q", REMOTE, "main")
    first = {pr["number"] for pr in prs if PRIORITY in pr["labels"]}
    return any(n in first for n in batch_heads("FETCH_HEAD", head))


def cancel_batch(head):
    runs = [x for x in batch_runs(head) or [] if x.get("status") != "completed"]
    if not runs:
        note(f"a pull request with {PRIORITY} waits for batch {head[:8]}, which has no run to cancel yet")
        return
    for x in runs:
        gh_actions("run", "cancel", str(x["databaseId"]), check=False)
    note(f"a pull request with {PRIORITY} waits: batch {head[:8]} is cancelled, and it goes back to the retry list")


def ci_runs():
    """The pull request runs of ci.yml that are not complete: {id: head sha}."""
    runs = {}
    for status in ("queued", "in_progress"):
        r = gh_actions("run", "list", "--workflow", WORKFLOW_CI, "--event", "pull_request", "--status", status,
                       "--limit", "100", "--json", "databaseId,headSha", check=False)
        if r.returncode != 0:
            note(f"cannot read the {status} runs of {WORKFLOW_CI}")
            continue
        runs.update({str(x["databaseId"]): x["headSha"] for x in json.loads(r.stdout or "[]")})
    return runs


def suite_is_under_way(run_id):
    r = gh_actions("api", f"repos/{{owner}}/{{repo}}/actions/runs/{run_id}/jobs?filter=latest&per_page=100",
                   "--paginate", "--jq", ".jobs[].name", check=False)
    return any(name.startswith(SUITE_JOBS) and name != GATE_JOB for name in r.stdout.splitlines())


def kick_suites(batch):
    """Cancel each pull request suite that is under way, and run it again.

    The new run waits behind the batch in the first job of its suite. A run of
    a pull request of the batch is cancelled and not run again, because the
    batch tests that pull request."""
    heads = {pr["headRefOid"] for pr in batch}
    again = []
    for run_id, sha in ci_runs().items():
        if sha in heads:
            gh_actions("run", "cancel", run_id, check=False)
            note(f"run {run_id} of a pull request of the batch is cancelled")
        elif suite_is_under_way(run_id) and gh_actions("run", "cancel", run_id, check=False).returncode == 0:
            again.append(run_id)
    deadline = time.time() + KICK_SECONDS
    for run_id in again:
        status = ""
        while True:
            status = gh_actions("run", "view", run_id, "--json", "status", "--jq", ".status",
                                check=False).stdout.strip()
            if status == "completed" or time.time() >= deadline:
                break
            time.sleep(5)
        if status == "completed" and gh_actions("run", "rerun", run_id, check=False).returncode == 0:
            note(f"run {run_id} is cancelled and runs again behind the batch")
        else:
            note(f"run {run_id} is cancelled, but it does not run again: it is {status or 'unknown'}")


def failure_report():
    """The report of scripts/ci-failure-report.mjs for the run of the batch."""
    path = os.environ.get("MERGE_QUEUE_FAILURE_REPORT", "")
    if not path or not os.path.isfile(path):
        return ""
    with open(path) as f:
        return f.read().strip()


def eject(state, number, sha, reason, details=""):
    note(f"#{number} leaves the queue: {reason}")
    state["removed"][str(number)] = sha
    gh("pr", "edit", str(number), "--remove-label", LABEL, check=False)
    gh("pr", "comment", str(number), "--body",
       f"The merge queue removed this pull request: {reason}\n\n"
       f"Fix it, then add the `{LABEL}` label again." + (f"\n\n{details}" if details else "") + SIGNATURE,
       check=False)


def identity():
    if git("config", "user.email", check=False).returncode != 0:
        for who in ("AUTHOR", "COMMITTER"):
            os.environ[f"GIT_{who}_NAME"] = "merge-queue"
            os.environ[f"GIT_{who}_EMAIL"] = "merge-queue@fern.invalid"


def form():
    identity()
    gh("label", "create", LABEL, "--description", "Merge this pull request through the merge queue",
       "--color", "0E8A16", check=False)
    gh("label", "create", HOLD, "--description", "Keep this pull request out of the merge queue",
       "--color", "FBCA04", check=False)
    gh("label", "create", PRIORITY, "--description", "Test and merge this pull request before all others",
       "--color", "B60205", check=False)
    head = batch_head()
    if head:
        if batch_is_live(head):
            prs = open_prs()
            if priority_prs(load_state(), prs) and not batch_has_priority(head, prs):
                cancel_batch(head)
            else:
                note("a batch is in flight")
            return 0
        release(f"no run of {WORKFLOW_BATCH} is going for {head[:8]}")
    state = load_state()
    prs = open_prs()
    numbers = {str(p["number"]) for p in prs}
    state["removed"] = {n: sha for n, sha in state["removed"].items() if n in numbers}

    # The pull requests that are ready, and the label for each one that is
    # ready without it.
    ready = []
    for pr in prs:
        number, sha, labelled = pr["number"], pr["headRefOid"], LABEL in pr["labels"]
        if pr["isDraft"]:
            continue
        if not labelled and (HOLD in pr["labels"] or state["removed"].get(str(number)) == sha):
            continue
        if not verdict_is_green(sha):
            if labelled:
                note(f"#{number} waits for a green CI verdict on {sha[:8]}")
            continue
        if not labelled:
            note(f"#{number} is green: it gets the label")
            gh("pr", "edit", str(number), "--add-label", LABEL, check=False)
        state["removed"].pop(str(number), None)
        ready.append(pr)

    first = priority_prs(state, prs)[:MAX]
    for pr in first:
        note(f"#{pr['number']} has {PRIORITY}: it goes first")
        if LABEL not in pr["labels"]:
            gh("pr", "edit", str(pr["number"]), "--add-label", LABEL, check=False)
        state["removed"].pop(str(pr["number"]), None)
    if first:
        chosen = first
    elif state["retry"]:
        group = state["retry"].pop(0)
        labelled = {p["number"]: p for p in prs if LABEL in p["labels"]}
        chosen = [labelled[n] for n in group if n in labelled]
        note(f"retry group {group}: {len(chosen)} still in the queue")
    else:
        chosen = ready[:MAX]

    git("fetch", "-q", REMOTE, "main")
    git("checkout", "-q", "--detach", "FETCH_HEAD")
    merged = []
    for pr in chosen:
        number, sha = pr["number"], pr["headRefOid"]
        if git("fetch", "-q", REMOTE, f"pull/{number}/head", check=False).returncode != 0 or \
                git("cat-file", "-e", f"{sha}^{{commit}}", check=False).returncode != 0:
            note(f"#{number}: cannot fetch {sha[:8]}, it stays in the queue")
            continue
        r = git("merge", "-q", "--no-ff", "-m", f"Merge pull request #{number} from {pr['headRefName']}", sha, check=False)
        if r.returncode != 0:
            git("merge", "--abort", check=False)
            eject(state, number, sha, "it does not merge cleanly on main and the pull requests before it in the batch.")
            continue
        merged.append(number)

    if not merged:
        save_state(state)
        note("no pull request is ready")
        if state["retry"]:
            return form()
        return 0
    if git("push", "-q", REMOTE, f"HEAD:refs/heads/{BATCH}", check=False).returncode != 0:
        note("the push of the batch was refused. A change to a workflow file needs a token with the workflow scope.")
        return 1
    r = gh_actions("workflow", "run", WORKFLOW_BATCH, "--ref", BATCH, check=False)
    if r.returncode != 0:
        # With no run, the branch would hold the lock until a person
        # deletes it, and nothing would test a batch.
        git("push", "-q", REMOTE, f":refs/heads/{BATCH}", check=False)
        sys.stderr.write(f"merge-queue: the dispatch of {WORKFLOW_BATCH} failed, so the batch goes\n{r.stdout}{r.stderr}")
        return 1
    save_state(state)
    note(f"batch {merged} is in flight")
    if first:
        kick_suites(first)
    return 0


def batch_heads(base="FETCH_HEAD", tip="HEAD"):
    """The pull requests of the batch, in order: {number: head sha}."""
    out = git("log", "--first-parent", "--merges", "--reverse", "--format=%P %s", f"{base}..{tip}").stdout
    heads = {}
    for line in out.splitlines():
        _, head, subject = line.split(" ", 2)
        if subject.startswith("Merge pull request #"):
            heads[int(subject.split("#", 1)[1].split()[0])] = head
    return heads


def only_pins_moved():
    names = git("diff", "--name-only", "HEAD...FETCH_HEAD").stdout.split()
    return bool(names) and all(n.startswith(PIN_PREFIXES) for n in names)


def push_to_main():
    if git("push", "-q", REMOTE, "HEAD:refs/heads/main", check=False).returncode == 0:
        return True
    git("fetch", "-q", REMOTE, "main")
    if not only_pins_moved():
        return False
    note("main got only pin-file commits: merge them in")
    if git("merge", "-q", "--no-ff", "-m", "Merge main into the batch of the merge queue", "FETCH_HEAD",
           check=False).returncode != 0:
        git("merge", "--abort", check=False)
        return False
    return git("push", "-q", REMOTE, "HEAD:refs/heads/main", check=False).returncode == 0


def land(result):
    identity()
    git("fetch", "-q", REMOTE, "main")
    heads = batch_heads()
    numbers = list(heads)
    state = load_state()
    run_url = os.environ.get("MERGE_QUEUE_RUN_URL", "the run of its batch")
    if not numbers:
        note("the batch has no pull request")
    elif result == "success":
        if push_to_main():
            note(f"main has batch {numbers}")
        else:
            note(f"main moved under batch {numbers}: test it again")
            state["retry"].insert(0, numbers)
    elif result == "failure" and len(numbers) == 1:
        eject(state, numbers[0], heads[numbers[0]], f"the suite failed with only this pull request in the batch ({run_url}).", failure_report())
    elif result == "failure":
        half = (len(numbers) + 1) // 2
        note(f"batch {numbers} failed: split it")
        state["retry"][:0] = [numbers[:half], numbers[half:]]
    else:
        note(f"the suite of batch {numbers} concluded {result}: test it again")
        state["retry"].insert(0, numbers)
    save_state(state)
    git("push", "-q", REMOTE, f":refs/heads/{BATCH}", check=False)
    gh_actions("workflow", "run", WORKFLOW_FORM, "--ref", "main", check=False)
    return 0


def main(argv):
    if argv[1:] == ["form"]:
        return form()
    if len(argv) == 3 and argv[1] == "land":
        return land(argv[2])
    sys.stderr.write("usage: merge-queue form | merge-queue land RESULT\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
