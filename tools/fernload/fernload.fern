// fernload — an open-loop HTTP/1.1 load generator
// (docs/NET-P5-FRAMEWORK-PLAN.md §8, #9859).
//
// Requests go out at a fixed rate over a set of kept connections, and each
// request's latency is measured from the moment the rate said it was due,
// not from when a connection came free: a server that stalls shows the
// queueing a real client would have seen, where a closed-loop tool waits
// for it and records nothing (wrk2's correction for coordinated omission).
// The same latency from the send is reported beside it.
//
// Usage: fernload [--rate N] [--connections C] [--duration S] URL
//
//   --rate N         requests per second over all connections (default 100)
//   --connections C  connections kept open (default 16)
//   --duration S     how long to send, in seconds (default 10)
//   URL              http://HOST:PORT/PATH; HOST an IP literal or localhost
//
// Output: `metric<TAB>value` rows, the format scripts/perf-history
// records. load/sent is what the rate scheduled and the tool sent,
// load/behind what it scheduled and could not send by the end (every
// connection busy), load/requests the responses read, load/errors the
// requests a reset, a close or a malformed response lost, load/rps the
// responses per second of sending, load/p50_us through load/max_us the
// corrected latency, load/raw_p99_us the latency from the send. Exits 1
// when a request erred or the server could not be reached.
import "std/cli";
import "std/http";
import "std/net";
import "std/async";
import "std/url";
import "std/string";
import "core/int";

const CONNECTING: i32 = 0;

const IDLE: i32 = 1;

const BUSY: i32 = 2;

// The histogram: values under 64 µs in their own bucket, then 32 buckets
// per power of two, so a percentile is read to within 3%.
const DIRECT: i32 = 64;

const PER_EXPONENT: i32 = 32;

const BUCKETS: i32 = 1888;

// Responses still owed after the sending ends are waited for this long.
const DRAIN_NS: i64 = 2000000000;

// One connection: its socket, whether it is connecting, idle or carrying a
// request, when the request in flight was due and sent, and the response
// bytes read so far.
struct Conn { fd: i32, state: i32, due_ns: i64, sent_ns: i64, buf: u8[] }

// The run: where to connect, the request bytes, and the rate's terms.
struct Plan { addr: net.SocketAddr, request: u8[], rate: i64, connections: i32, duration_ns: i64 }

// What the run counted: requests sent, responses read, requests lost, the
// corrected and the raw latency histograms, and the longest corrected
// latency.
struct Tally { sent: i64, done: i64, errors: i64, corrected: i64[], raw: i64[], max_us: i64 }

function main(): i32 {
  let spec: cli.CliSpec = cli.new("fernload", "an open-loop HTTP/1.1 load generator: a fixed request rate over kept connections, latency measured from each request's scheduled time").option("rate", "r", "requests per second over all connections (default 100)").option("connections", "c", "connections kept open (default 16)").option("duration", "d", "seconds to send for (default 10)");
  let parsed: cli.CliArgs = spec.parse(args());
  if (parsed.is_error()) {
    eprint("fernload: " + parsed.error_text());
    eprint(spec.usage());
    return 2;
  }
  let Some(raw) = parsed.operand(0) else {
    eprint(spec.usage());
    return 2;
  };
  match (plan(raw, parsed)) {
    Ok(p) => {
      return run(p);
    },
    Err(message) => {
      eprint("fernload: " + message);
      return 2;
    }
  }
  return 2;
}

// plan reads the URL and the options into the run's terms.
function plan(raw: string, parsed: cli.CliArgs): Result[Plan, string] {
  let Some(u) = url.url_parse(raw) else {
    return Err("not a URL: " + raw);
  };
  if (u.scheme != "http") {
    return Err("the URL must be http://, not " + u.scheme + "://");
  }
  let host: string = u.host;
  if (host == "localhost") {
    host = "127.0.0.1";
  }
  let Some(ip) = net.ip_parse(host) else {
    return Err("the host must be an IP literal or localhost: " + u.host);
  };
  let port: i32 = u.port;
  if (port == 0) {
    port = 80;
  }
  let target: string = u.path;
  if (target.len() == 0) {
    target = "/";
  }
  if (u.query.len() > 0) {
    target = target + "?" + u.query;
  }
  let rate: i64 = option_i64(parsed, "rate", 100)?;
  let connections: i64 = option_i64(parsed, "connections", 16)?;
  let duration: i64 = option_i64(parsed, "duration", 10)?;
  let request: string = "GET " + target + " HTTP/1.1\r\nHost: " + u.host + ":" + int.int_to_string(port) + "\r\nUser-Agent: fernload\r\n\r\n";
  return Ok(Plan { addr: net.socket_addr(ip, port), request: request.bytes(), rate: rate, connections: connections as i32, duration_ns: duration * 1000000000 });
}

// option_i64 is the option as a positive count, or `fallback` when absent.
function option_i64(parsed: cli.CliArgs, name: string, fallback: i64): Result[i64, string] {
  match (parsed.value(name)) {
    Some(text) => {
      match (int.parse_int_radix(text, 10)) {
        Some(n) => {
          if (n <= 0) {
            return Err("--" + name + " must be positive: " + text);
          }
          return Ok(n as i64);
        },
        None => {
          return Err("--" + name + " is not a number: " + text);
        }
      }
    },
    None => {
      return Ok(fallback);
    }
  }
  return Ok(fallback);
}

// run sends for the planned duration, drains the responses still owed,
// prints the report and says whether every request was answered.
function run(p: Plan): i32 {
  let drv: async.RealDriver = async.real_driver();
  let conns: Conn[] = [];
  let i: i32 = 0;
  while (i < p.connections) {
    conns = conns.append(open(drv, p));
    i = i + 1;
  }
  let t: Tally = Tally { sent: 0, done: 0, errors: 0, corrected: zeros(), raw: zeros(), max_us: 0 };
  let interval_ns: i64 = 1000000000 / p.rate;
  let start: i64 = monotonic_ns();
  let end: i64 = start + p.duration_ns;
  let now: i64 = start;
  while (true) {
    now = monotonic_ns();
    let due: i64 = start + t.sent * interval_ns;
    while (now < end && due <= now) {
      let at: i32 = idle(conns);
      if (at < 0) {
        break;
      }
      conns = conns.with(at, send(conns[at], p, due, now));
      t = Tally { ...t, sent: t.sent + 1 };
      due = start + t.sent * interval_ns;
    }
    let owed: i32 = in_flight(conns);
    if (now >= end && owed == 0) {
      break;
    }
    if (now >= end + DRAIN_NS) {
      t = Tally { ...t, errors: t.errors + owed as i64 };
      break;
    }
    let until: i64 = due;
    if (now >= end || idle(conns) < 0) {
      until = end + DRAIN_NS;
    }
    let events: i32[] = drv.wait(2 * conns.len(), millis_until(now, until));
    let k: i32 = 0;
    while (k + 1 < events.len()) {
      let at: i32 = conn_of(conns, events[k]);
      if (at >= 0) {
        let stepped: (Conn, Tally) = step(drv, p, conns[at], events[k + 1], t);
        conns = conns.with(at, stepped.0);
        t = stepped.1;
      }
      k = k + 2;
    }
  }
  for c in conns {
    drv.unwatch(c.fd);
    net.close(c.fd);
  }
  let behind: i64 = p.duration_ns / interval_ns - t.sent;
  if (behind < 0) {
    behind = 0;
  }
  report(t, behind, now - start);
  if (t.errors > 0 || t.done == 0) {
    return 1;
  }
  return 0;
}

// millis_until is the wait that ends at `until`, rounded down: the last
// part of a millisecond is spent polling, so a request goes out at its
// time rather than up to a millisecond late and that lateness counted
// against the server.
function millis_until(now: i64, until: i64): i32 {
  if (until <= now) {
    return 0;
  }
  let ms: i64 = (until - now) / 1000000;
  if (ms > 1000) {
    return 1000;
  }
  return ms as i32;
}

// open starts a connection and watches its socket for the connect to end;
// a connect that cannot start leaves a closed connection the loop reopens.
function open(drv: async.RealDriver, p: Plan): Conn {
  let none: u8[] = [];
  match (net.connect_start(p.addr)) {
    Ok(fd) => {
      drv.watch(fd, 2);
      return Conn { fd: fd, state: CONNECTING, due_ns: 0, sent_ns: 0, buf: none };
    },
    Err(e) => {
      return Conn { fd: 0 - 1, state: CONNECTING, due_ns: 0, sent_ns: 0, buf: none };
    }
  }
  return Conn { fd: 0 - 1, state: CONNECTING, due_ns: 0, sent_ns: 0, buf: none };
}

// reopen closes a connection and opens another in its place.
function reopen(drv: async.RealDriver, p: Plan, c: Conn): Conn {
  if (c.fd >= 0) {
    drv.unwatch(c.fd);
    net.close(c.fd);
  }
  return open(drv, p);
}

function idle(conns: Conn[]): i32 {
  let i: i32 = 0;
  while (i < conns.len()) {
    if (conns[i].state == IDLE) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function in_flight(conns: Conn[]): i32 {
  let n: i32 = 0;
  for c in conns {
    if (c.state == BUSY) {
      n = n + 1;
    }
  }
  return n;
}

function conn_of(conns: Conn[], fd: i32): i32 {
  let i: i32 = 0;
  while (i < conns.len()) {
    if (conns[i].fd == fd) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// send writes the request on an idle connection, due at `due` and sent
// at `now`.
function send(c: Conn, p: Plan, due: i64, now: i64): Conn {
  // A write the socket does not take whole leaves the connection dead,
  // and the read side reports the request as the lost one it is.
  let sent: Result[i32, net.NetError] = net.write(c.fd, p.request);
  let none: u8[] = [];
  return Conn { ...c, state: BUSY, due_ns: due, sent_ns: now, buf: none };
}

// step handles one readiness report on a connection: the end of its
// connect, or bytes of the response it is owed.
function step(drv: async.RealDriver, p: Plan, c: Conn, readiness: i32, t: Tally): (Conn, Tally) {
  if (c.state == CONNECTING) {
    return (connected(drv, p, c, t), t);
  }
  return read(drv, p, c, t);
}

// connected moves a connection whose connect ended to idle, or reopens one
// whose connect failed.
function connected(drv: async.RealDriver, p: Plan, c: Conn, t: Tally): Conn {
  match (net.connect_result(c.fd)) {
    Ok(_) => {
      drv.watch(c.fd, 1);
      return Conn { ...c, state: IDLE };
    },
    Err(e) => {
      match (e) {
        net.InProgress => {
          return c;
        },
        _ => {
          return reopen(drv, p, c);
        }
      }
    }
  }
  return c;
}

// read takes what the socket has, and when a whole response has arrived
// records its latency and frees the connection; a close or a malformed
// response loses the request in flight.
function read(drv: async.RealDriver, p: Plan, c: Conn, t: Tally): (Conn, Tally) {
  let conn: Conn = c;
  let tally: Tally = t;
  while (true) {
    let scratch: u8[] = __alloc_u8(16384);
    let n: i32 = tcp_recv_into(conn.fd, scratch);
    if (n == 0 - eagain()) {
      return (conn, tally);
    }
    if (n <= 0) {
      if (conn.state == BUSY) {
        tally = Tally { ...tally, errors: tally.errors + 1 };
      }
      return (reopen(drv, p, conn), tally);
    }
    __arr_set_len(scratch, n);
    conn = Conn { ...conn, buf: conn.buf.concat(scratch) };
    if (conn.state != BUSY) {
      // Bytes with no request out: not a response, so not a connection
      // to keep.
      return (reopen(drv, p, conn), tally);
    }
    match (http.http_parse_response_framed(conn.buf, "GET", false, http.http_limits())) {
      http.Complete(f) => {
        let now: i64 = monotonic_ns();
        tally = recorded(tally, (now - conn.due_ns) / 1000, (now - conn.sent_ns) / 1000);
        if (!f.keep_alive) {
          return (reopen(drv, p, conn), tally);
        }
        if (f.len < conn.buf.len()) {
          // Bytes past the one response owed: not a connection to trust.
          return (reopen(drv, p, conn), tally);
        }
        let none: u8[] = [];
        conn = Conn { ...conn, state: IDLE, buf: none };
      },
      http.Unfinished => {},
      http.Rejected(status) => {
        tally = Tally { ...tally, errors: tally.errors + 1 };
        return (reopen(drv, p, conn), tally);
      }
    }
  }
  return (conn, tally);
}

// eagain is EAGAIN as this host numbers it: what a non-blocking read
// answers when nothing is queued.
function eagain(): i32 {
  if (target_os() == "darwin") {
    return 35;
  }
  return 11;
}

function zeros(): i64[] {
  let out: i64[] = [];
  let i: i32 = 0;
  while (i < BUCKETS) {
    out = out.append(0);
    i = i + 1;
  }
  return out;
}

// recorded counts one response: its corrected and raw latency, in µs.
function recorded(t: Tally, corrected_us: i64, raw_us: i64): Tally {
  let max_us: i64 = t.max_us;
  if (corrected_us > max_us) {
    max_us = corrected_us;
  }
  let ci: i32 = bucket(corrected_us);
  let ri: i32 = bucket(raw_us);
  return Tally { ...t, done: t.done + 1, corrected: t.corrected.with(ci, t.corrected[ci] + 1), raw: t.raw.with(ri, t.raw[ri] + 1), max_us: max_us };
}

// bucket is the histogram index of a latency in µs.
function bucket(us: i64): i32 {
  if (us < DIRECT as i64) {
    if (us < 0) {
      return 0;
    }
    return us as i32;
  }
  let e: i32 = 0;
  let x: i64 = us;
  while (x > 0) {
    x = x / 2;
    e = e + 1;
  }
  let sub: i32 = (us / (1 as i64 << e - 6) % (PER_EXPONENT as i64)) as i32;
  let index: i32 = DIRECT + (e - 7) * PER_EXPONENT + sub;
  if (index >= BUCKETS) {
    return BUCKETS - 1;
  }
  return index;
}

// floor_of is the smallest latency a bucket holds, in µs.
function floor_of(index: i32): i64 {
  if (index < DIRECT) {
    return index as i64;
  }
  let e: i32 = 7 + (index - DIRECT) / PER_EXPONENT;
  let sub: i32 = (index - DIRECT) % PER_EXPONENT;
  return (PER_EXPONENT + sub) as i64 * (1 as i64 << e - 6);
}

// percentile is the latency `per_mille` thousandths of the responses came
// under, read off the histogram.
function percentile(h: i64[], total: i64, per_mille: i64): i64 {
  if (total == 0) {
    return 0;
  }
  let want: i64 = (total * per_mille + 999) / 1000;
  if (want < 1) {
    want = 1;
  }
  let seen: i64 = 0;
  let i: i32 = 0;
  while (i < h.len()) {
    seen = seen + h[i];
    if (seen >= want) {
      return floor_of(i);
    }
    i = i + 1;
  }
  return floor_of(h.len() - 1);
}

function row(name: string, value: i64): void {
  print("load/" + name + "\t" + value.to_string());
}

function report(t: Tally, behind: i64, elapsed_ns: i64): void {
  row("sent", t.sent);
  row("behind", behind);
  row("requests", t.done);
  row("errors", t.errors);
  let rps: i64 = 0;
  if (elapsed_ns > 0) {
    rps = t.done * 1000000000 / elapsed_ns;
  }
  row("rps", rps);
  row("p50_us", percentile(t.corrected, t.done, 500));
  row("p90_us", percentile(t.corrected, t.done, 900));
  row("p99_us", percentile(t.corrected, t.done, 990));
  row("p999_us", percentile(t.corrected, t.done, 999));
  row("max_us", t.max_us);
  row("raw_p99_us", percentile(t.raw, t.done, 990));
}
