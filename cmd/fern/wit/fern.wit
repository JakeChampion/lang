// WIT worlds for the Fern components. Two flavours:
//
//   - `fern` is the CLI world: imports the preview-2 interfaces
//     the WASM backend emits natively (stdio, args / env via
//     wasi:cli/environment, exit, monotonic clock, filesystem,
//     TCP + UDP sockets, random), runs `_start` once via
//     wasi:cli/run.run (wired through the preview-1 adapter).
//   - `http` is the HTTP-handler world: same imports as `fern`
//     plus wasi:http/types, and EXPORTS
//     wasi:http/incoming-handler so the host (e.g.
//     `wasmtime serve`) can dispatch inbound requests into the
//     user's `handle(req: HttpRequest): HttpResponse`.
package local:fern@0.0.0;

world fern {
    import wasi:cli/stdin@0.2.0;
    import wasi:cli/stdout@0.2.0;
    import wasi:cli/stderr@0.2.0;
    import wasi:cli/environment@0.2.0;
    import wasi:cli/exit@0.2.0;
    import wasi:io/streams@0.2.0;
    import wasi:io/poll@0.2.0;
    import wasi:clocks/monotonic-clock@0.2.0;
    import wasi:filesystem/types@0.2.0;
    import wasi:filesystem/preopens@0.2.0;
    import wasi:sockets/network@0.2.0;
    import wasi:sockets/instance-network@0.2.0;
    import wasi:sockets/tcp-create-socket@0.2.0;
    import wasi:sockets/tcp@0.2.0;
    import wasi:sockets/udp-create-socket@0.2.0;
    import wasi:sockets/udp@0.2.0;
    import wasi:random/random@0.2.0;
}

world http {
    import wasi:cli/stdin@0.2.0;
    import wasi:cli/stdout@0.2.0;
    import wasi:cli/stderr@0.2.0;
    import wasi:io/streams@0.2.0;
    import wasi:io/poll@0.2.0;
    import wasi:io/error@0.2.0;
    import wasi:filesystem/types@0.2.0;
    import wasi:filesystem/preopens@0.2.0;
    import wasi:clocks/wall-clock@0.2.0;
    import wasi:clocks/monotonic-clock@0.2.0;
    import wasi:random/random@0.2.0;
    import wasi:http/types@0.2.0;
    export wasi:http/incoming-handler@0.2.0;
}

// `proxy` is the world `fern -target wasm32-wasi-http` composes against:
// the imports a wasi:http proxy host such as `wasmtime serve` grants a
// handler (stdio for logging, clocks, entropy, wasi:http/types for the
// request and response resources, and wasi:http/outgoing-handler, the
// host's HTTP client std/fetch sends through there), wasi:config/store for
// deploy-time configuration (`wasmtime serve -S config -S
// config-var=NAME=VALUE`), and the incoming-handler export the host
// dispatches each request into. No filesystem, sockets, environment or
// exit: a proxy host does not provide them, and a component that declared
// them would fail to instantiate there.
world proxy {
    import wasi:cli/stdout@0.2.0;
    import wasi:cli/stderr@0.2.0;
    import wasi:io/error@0.2.0;
    import wasi:io/poll@0.2.0;
    import wasi:io/streams@0.2.0;
    import wasi:clocks/wall-clock@0.2.0;
    import wasi:clocks/monotonic-clock@0.2.0;
    import wasi:random/random@0.2.0;
    import wasi:http/types@0.2.0;
    import wasi:http/outgoing-handler@0.2.0;
    import wasi:config/store@0.2.0-rc.1;
    export wasi:http/incoming-handler@0.2.0;
}
