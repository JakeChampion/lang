package wasi:sockets@0.2.0;

// Vendored subset of wasi:sockets/udp@0.2.0 — only the methods the
// wasm backend emits for its send-only datagram client
// (internal/codegen/wasmbin/wasi_udp.go): bind the socket, open a
// stream connected to the remote, wait for a send permit
// (check-send / subscribe), and send one outgoing-datagram. The
// `incoming-datagram-stream` half of `stream`'s result is created
// and immediately dropped (we never receive), so it is declared as
// a bare resource. The full API adds receive, address/hop-limit
// accessors, etc.; we lower Fern's narrower fire-and-forget pattern.
interface udp {
    use wasi:io/poll@0.2.0.{pollable};
    use network.{network, error-code, ip-socket-address};

    record outgoing-datagram {
        data: list<u8>,
        remote-address: option<ip-socket-address>,
    }

    resource incoming-datagram-stream;

    resource outgoing-datagram-stream {
        check-send: func() -> result<u64, error-code>;
        send: func(datagrams: list<outgoing-datagram>) -> result<u64, error-code>;
        subscribe: func() -> pollable;
    }

    resource udp-socket {
        start-bind: func(network: borrow<network>, local-address: ip-socket-address) -> result<_, error-code>;
        finish-bind: func() -> result<_, error-code>;
        %stream: func(remote-address: option<ip-socket-address>)
            -> result<tuple<incoming-datagram-stream, outgoing-datagram-stream>, error-code>;
    }
}
