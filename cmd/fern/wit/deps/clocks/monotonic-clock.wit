package wasi:clocks@0.2.0;

// Vendored subset of wasi:clocks/monotonic-clock@0.2.0. The backend
// imports `now` (a `u64` of ns since some monotonic epoch) for
// monotonic timing, and `subscribe-duration` for the timer pollable
// `poll` adds to its set to express a timeout; `wasi:http/types` also
// references `duration` (an alias for `u64`), so the WIT toolchain has
// to be able to resolve the package either way.
// Source: https://github.com/WebAssembly/wasi-clocks
interface monotonic-clock {
    use wasi:io/poll@0.2.0.{pollable};

    type instant = u64;
    type duration = u64;

    now: func() -> instant;
    subscribe-duration: func(when: duration) -> pollable;
}
