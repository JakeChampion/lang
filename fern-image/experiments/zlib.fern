import "std/deflate";
import "std/test";

function stored(): u8[] {
  return [120, 1, 1, 33, 0, 222, 255, 70, 101, 114, 110, 32, 80, 78, 71, 32, 99, 111, 109, 112, 114, 101, 115, 115, 105, 111, 110, 32, 102, 111, 117, 110, 100, 97, 116, 105, 111, 110, 46, 32, 202, 24, 12, 8];
}

function fixed(): u8[] {
  return [120, 1, 115, 75, 45, 202, 83, 8, 240, 115, 87, 72, 206, 207, 45, 40, 74, 45, 46, 206, 204, 207, 83, 72, 203, 47, 205, 75, 73, 44, 1, 50, 245, 20, 220, 70, 21, 140, 42, 24, 85, 48, 170, 96, 84, 193, 168, 130, 81, 5, 163, 10, 70, 21, 140, 42, 24, 85, 48, 170, 96, 84, 193, 168, 130, 81, 5, 163, 10, 40, 83, 0, 0, 154, 175, 3, 219];
}

function dynamic(): u8[] {
  return [120, 156, 237, 202, 177, 13, 192, 32, 12, 0, 193, 85, 60, 1, 99, 56, 29, 202, 10, 17, 113, 36, 10, 108, 4, 201, 254, 97, 7, 218, 239, 174, 56, 181, 225, 114, 230, 67, 74, 180, 62, 108, 206, 26, 46, 79, 124, 126, 95, 239, 98, 18, 37, 16, 8, 4, 2, 129, 64, 32, 16, 8, 4, 2, 129, 64, 216, 11, 63, 154, 175, 3, 219];
}

function known(stream: u8[], expected: i32): boolean {
  let Ok(out) = deflate.zlib_decode(stream, 4224) else {
    return false;
  };
  if (out.len() != expected) {
    return false;
  }
  let phrase = "Fern PNG compression foundation. ";
  for i in 0..out.len() {
    if (out[i] != phrase[i % phrase.len()]) {
      return false;
    }
  }
  return true;
}

function golden(): test.TestOutcome {
  return test.assert_true(known(stored(), 33) && known(fixed(), 4224) && known(dynamic(), 4224));
}

function limited(): test.TestOutcome {
  let limited = match (deflate.zlib_decode(dynamic(), 4223)) { Ok(_) => false, Err(deflate.OutputLimit) => true, Err(_) => false };
  let zero = match (deflate.zlib_decode(dynamic(), 0)) { Ok(_) => false, Err(deflate.OutputLimit) => true, Err(_) => false };
  return test.assert_true(limited && zero);
}

function corrupt(): test.TestOutcome {
  let stream = dynamic();
  let checksum = match (deflate.zlib_decode(stream.with(stream.len() - 1, 0), 4224)) { Ok(_) => false, Err(deflate.BadChecksum) => true, Err(_) => false };
  let truncated = match (deflate.zlib_decode(stream[:stream.len() - 1], 4224)) { Ok(_) => false, Err(_) => true };
  let header = match (deflate.zlib_decode(stream.with(0, 0), 4224)) { Ok(_) => false, Err(_) => true };
  return test.assert_true(checksum && truncated && header);
}

function main(): i32 {
  let r = test.new("native PNG compression audit");
  r = r.it("stored, fixed and dynamic zlib goldens", golden);
  r = r.it("exact decompression limit", limited);
  r = r.it("checksum, truncation and header rejection", corrupt);
  return r.finish();
}
