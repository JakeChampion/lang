function main(): i32 {
  if let Err(_) = write_file("build/io-probe.txt", "fern bytes") {
    return 1;
  }
  let Ok(text) = read_file("build/io-probe.txt") else {
    return 2;
  };
  if (text != "fern bytes") {
    return 3;
  }
  if let Ok(_) = read_file("build/does-not-exist") {
    return 4;
  }
  return 0;
}
