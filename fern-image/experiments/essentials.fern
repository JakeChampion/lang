import "std/test";

function essentials(): test.TestOutcome {
  let n = 2147483647;
  let overflow = match (n *? 4) { Some(_) => false, None => true };
  let bytes = __alloc_u8(8);
  let alias = bytes;
  bytes = bytes.with(3, 255);
  let view = bytes[2:5];
  return test.assert_true(overflow && n + 1 == -2147483647 - 1 && alias[3] == 0 && bytes[3] == 255 && view[1] == 255);
}

function main(): i32 {
  let r = test.new("image essentials");
  r = r.it("checked arithmetic, zero bytes, copy-on-write and slices", essentials);
  return r.finish();
}
