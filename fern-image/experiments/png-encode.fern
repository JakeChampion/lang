import "../packages/codecs/png/png";
import "../packages/pixels/pixels";
import "../tests/fixtures/png" as fixtures;

function main(): i32 {
  let Ok(image) = png.decode(fixtures.rgba4(), pixels.default_limits()) else {
    return 1;
  };
  let Ok(bytes) = png.encode(image, 10000) else {
    return 2;
  };
  if let Err(_) = write_file_bytes("build/encoded.png", bytes) {
    return 3;
  }
  return 0;
}
