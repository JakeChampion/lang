enum ProbeFault { Bounds, Order, Cancelled }

struct Cursor { next: i32, bytes: u8[] }

struct ProbeReader { read: (i32, () => boolean) => Result[u8[], ProbeFault] }

struct Factory { open: () => Result[ProbeReader, ProbeFault] }

struct ProbeSession { node: i32, reader: ProbeReader }

struct Ledger { sessions: ProbeSession[], hits: i32 }

function factory(bytes: u8[]): Factory {
  let open = (): Result[ProbeReader, ProbeFault] => {
    let state = cell_new(Cursor { next: 0, bytes: bytes });
    let read = (y: i32, cancelled: () => boolean): Result[u8[], ProbeFault] => {
      if (cancelled()) {
        return Err(ProbeFault.Cancelled);
      }
      let current = state.get();
      if (y < 0 || y >= current.bytes.len()) {
        return Err(ProbeFault.Bounds);
      }
      if (y != current.next) {
        return Err(ProbeFault.Order);
      }
      let row = [current.bytes[y]];
      state.set(Cursor { ...current, next: y + 1 });
      return Ok(row);
    };
    return Ok(ProbeReader { read: read });
  };
  return Factory { open: open };
}

function capability(): i32 {
  let input: u8[] = [17, 23];
  input = input.append(args()[0].len() as u8);
  let source = factory(input);
  let alias = source;
  let Ok(first) = source.open() else {
    return 1;
  };
  let Ok(second) = alias.open() else {
    return 2;
  };
  let never = (): boolean => false;
  let Ok(row) = first.read(0, never) else {
    return 3;
  };
  let Ok(next) = first.read(1, never) else {
    return 4;
  };
  let Ok(independent) = second.read(0, never) else {
    return 5;
  };
  let order = match (first.read(0, never)) { Err(ProbeFault.Order()) => true, _ => false };
  let cancel = match (second.read(1, (): boolean => true)) { Err(ProbeFault.Cancelled()) => true, _ => false };
  let Ok(after) = second.read(1, never) else {
    return 6;
  };
  let changed = row.with(0, 200);
  input = input.with(0, 240);
  let Ok(third) = source.open() else {
    return 7;
  };
  let Ok(original) = third.read(0, never) else {
    return 8;
  };
  let ledger = Ledger { sessions: [], hits: 0 };
  for i in 0..3 {
    let Ok(reader) = source.open() else {
      return 10;
    };
    ledger = Ledger { ...ledger, sessions: ledger.sessions.append(ProbeSession { node: i, reader: reader }) };
  }
  let entry = ledger.sessions[1];
  let Ok(stored) = entry.reader.read(0, never) else {
    return 11;
  };
  ledger = Ledger { ...ledger, hits: ledger.hits + 1 };
  if (!order || !cancel || row[0] != 17 || changed[0] != 200 || original[0] != 17
    || independent[0] != 17 || next[0] != 23 || after[0] != 23 || input[0] != 240
    || stored[0] != 17 || ledger.hits != 1) {
    return 9;
  }
  return 42;
}

function main(): i32 {
  if (capability() != 42) {
    return 1;
  }

  return 0;
}
