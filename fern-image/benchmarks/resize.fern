import "../packages/pixels/pixels";
import "../packages/resize/resize";

function main(): i32 {
  let Ok(source) = pixels.create(32, 32, 128, pixels.RGBA8, pixels.default_limits()) else {
    return 1;
  };
  for y in 0..32 {
    for x in 0..32 {
      let p = pixels.Pixel { r: (x * 8) as u8, g: (y * 8) as u8, b: 64, a: 128 };
      source = match (pixels.write_pixel(source, x, y, p)) { Ok(v) => v, Err(_) => { return 2; } };
    }
  }
  let total = 0;
  for _ in 0..10 {
    let Ok(output) = resize.resize(source, 16, 16, resize.Bilinear, pixels.default_limits()) else {
      return 3;
    };
    let Ok(p) = pixels.read_pixel(output, 8, 8) else {
      return 4;
    };
    total += p.r as i32;
  }
  if (total != 1320) {
    return 5;
  }
  return 0;
}
