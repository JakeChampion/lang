import "../packages/pipeline/pipeline";
import "../packages/pixels/pixels";
import "std/i32";
import "std/i64";

function never_cancel(): boolean {
  return false;
}

function main(): i32 {
  let av = args();
  if (av.len() != 2 || av[1] != "8" && av[1] != "32") {
    return 1;
  }
  let count = if (av[1] == "32") { 32 } else { 8 };
  let limits = pipeline.Limits { max_pixels: 10000000, max_row_bytes: 4096, max_scratch_bytes: 21504, max_nodes: 5, max_samples: 2688 };
  let pixel = pixels.Pixel { r: 17, g: 23, b: 99, a: 128 };
  let Ok(graph) = pipeline.solid(1024, 8192, pixels.RGBA8, pixel, limits) else {
    return 2;
  };
  graph = match (pipeline.nearest(graph, 768, 12000, limits)) { Ok(v) => v, Err(_) => { return 3; } };
  graph = match (pipeline.nearest(graph, 512, 16000, limits)) { Ok(v) => v, Err(_) => { return 4; } };
  graph = match (pipeline.nearest(graph, 256, 20000, limits)) { Ok(v) => v, Err(_) => { return 5; } };
  graph = match (pipeline.nearest(graph, 128, 24000, limits)) { Ok(v) => v, Err(_) => { return 6; } };
  let allocated = __heap_alloc_count();
  let before = __heap_bump_bytes();
  let checksum = 0;
  let i = 0;
  while (i < count) {
    let Ok(row) = pipeline.render_row(graph, 12000 + i, limits, never_cancel) else {
      return 7;
    };
    let Ok(a) = pixels.read_pixel(row, 0, 0) else {
      return 8;
    };
    let Ok(b) = pixels.read_pixel(row, 127, 0) else {
      return 9;
    };
    if (row.data.len() != 512 || a.r != 17 || a.g != 23 || a.b != 99 || a.a != 128
      || b.r != a.r || b.g != a.g || b.b != a.b || b.a != a.a) {
      return 10;
    }
    checksum += b.r as i32;
    i += 1;
  }
  let allocations = __heap_alloc_count() - allocated;
  let fresh = __heap_bump_bytes() - before;
  if (checksum != count * 17 || allocations <= 0 || fresh <= 0) {
    return 11;
  }
  print(f"count={count} checksum={checksum} allocations={allocations} fresh_bytes={fresh}");
  return 0;
}
