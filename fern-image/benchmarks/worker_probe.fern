import "../packages/pixels/pixels";
import "../packages/codecs/png/png";
import "../packages/pipeline/pipeline";
import "../packages/pipeline/regions";
import "std/i32";

function never_cancel(): boolean {
  return false;
}

function configuration(): i32 {
  for name in ["memory.max", "memory.swap.max", "cpu.max", "pids.max", "memory.peak", "memory.events"] {
    let Ok(value) = read_file("/sys/fs/cgroup/" + name) else {
      return 2;
    };
    print(f"cgroup {name}\n{value}");
  }
  return 0;
}

function retained(count: i32): Result[pixels.Image[], i32] {
  if (count == 0) {
    return Ok([]);
  }
  let Ok(image) = pixels.create(512, 512, 2048, pixels.RGBA8, pixels.default_limits()) else {
    return Err(3);
  };
  let kept: pixels.Image[] = [];
  for i in 0..count {
    image = match (pixels.write_pixel(image, i, i, pixels.Pixel { r: 17, g: 23, b: 99, a: 128 })) { Ok(v) => v, Err(_) => { return Err(4); } };
    kept = kept.append(image);
  }
  return Ok(kept);
}

function valid_image(): i32 {
  let Ok(image) = pixels.create(16, 16, 64, pixels.RGBA8, pixels.default_limits()) else {
    return 5;
  };
  image = match (pixels.write_pixel(image, 15, 15, pixels.Pixel { r: 17, g: 23, b: 99, a: 128 })) { Ok(v) => v, Err(_) => { return 6; } };
  let Ok(encoded) = png.encode(image, 4096) else {
    return 7;
  };
  let Ok(decoded) = png.decode(encoded, pixels.default_limits()) else {
    return 8;
  };
  let Ok(pixel) = pixels.read_pixel(decoded, 15, 15) else {
    return 9;
  };
  if (decoded.data.len() != image.data.len() || pixel.r != 17 || pixel.g != 23 || pixel.b != 99 || pixel.a != 128) {
    return 10;
  }
  for i in 0..image.data.len() {
    if (decoded.data[i] != image.data[i]) {
      return 10;
    }
  }
  return 0;
}

function work(mode: string): i32 {
  let count = match (mode) { "oom" => 128, "pressure-busy" | "pressure-cancel" => 48, _ => 0 };
  let kept = match (retained(count)) { Ok(v) => v, Err(code) => { return code; } };
  if (mode == "oom") {
    return 11;
  }
  let limits = pipeline.default_limits();
  let Ok(graph) = pipeline.solid(1024, 10000, pixels.RGBA8, pixels.Pixel { r: 17, g: 23, b: 99, a: 128 }, limits) else {
    return 12;
  };
  graph = match (pipeline.bilinear(graph, 512, 20000, limits)) { Ok(v) => v, Err(_) => { return 13; } };
  if (configuration() != 0) {
    return 14;
  }
  print(f"ready mode={mode}");
  let i = 0;
  loop {
    if (kept.len() != count) {
      return 15;
    }
    for image in kept {
      let Ok(pixel) = pixels.read_pixel(image, 0, 0) else {
        return 16;
      };
      if (pixel.r != 17 || image.data.len() != 1048576) {
        return 17;
      }
    }
    let region = regions.Region { x: 400, y: 10000 + i, width: 64, height: 16 };
    if (mode == "pressure-cancel") {
      for stop in [1, 8, 24, 64] {
        let polls = cell_new(0);
        let cancelled = (): boolean => {
          polls.set(polls.get() + 1);
          return polls.get() >= stop;
        };
        match (regions.render_cached_tile(graph, region, limits, 12288, cancelled)) {
          Err(pipeline.PipelineError.Cancelled) => {},
          _ => {
            return 18;
          }
        }
        if (polls.get() != stop) {
          return 18;
        }
      }
      if (kept.len() != 48 || kept[47].data.len() != 1048576 || kept[47].data[0] != 17) {
        return 18;
      }
      return 0;
    }
    let Ok(tile) = regions.render_cached_tile(graph, region, limits, 12288, never_cancel) else {
      return 19;
    };
    let Ok(pixel) = pixels.read_pixel(tile.image, 63, 15) else {
      return 20;
    };
    if (pixel.r != 17 || pixel.g != 23 || pixel.b != 99 || pixel.a != 128 || tile.stats.rows != 16) {
      return 21;
    }
    if (mode == "valid") {
      return valid_image();
    }
    i = (i + 1) % 1000;
  }
}

function main(): i32 {
  let av = args();
  if (av.len() != 2 || av[1] != "valid" && av[1] != "oom" && av[1] != "busy" && av[1] != "pressure-busy" && av[1] != "pressure-cancel") {
    return 1;
  }
  let Ok(maximum) = read_file("/sys/fs/cgroup/memory.max") else {
    return 24;
  };
  let Ok(swap) = read_file("/sys/fs/cgroup/memory.swap.max") else {
    return 24;
  };
  if (maximum != "67108864\n" || swap != "0\n") {
    return 24;
  }
  let result = work(av[1]);
  if (result != 0) {
    return result;
  }
  if (configuration() != 0) {
    return 23;
  }
  print(f"ok mode={av[1]}");
  return 0;
}
