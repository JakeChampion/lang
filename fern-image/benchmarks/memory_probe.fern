import "../packages/pipeline/pipeline";
import "../packages/pixels/pixels";
import "../packages/resize/resize";
import "std/i32";
import "std/i64";

@noinline
function source_image(): Result[pixels.Image, pixels.ImageError] {
  return pixels.create(64, 64, 256, pixels.RGBA8, pixels.default_limits());
}

@noinline
function update(image: pixels.Image, count: i32): Result[pixels.Image, pixels.ImageError] {
  let output = image;
  let i = 0;
  while (i < count) {
    output = pixels.write_pixel(output, i % 64, i / 64 % 64, pixels.Pixel { r: 17, g: 23, b: 99, a: 128 })?;
    i += 1;
  }
  return Ok(output);
}

function update_checksum(output: pixels.Image, count: i32): i32 {
  let Ok(p) = pixels.read_pixel(output, (count - 1) % 64, (count - 1) / 64 % 64) else {
    return -3;
  };
  if (p.r != 17 || p.a != 128) {
    return -4;
  }
  return count * 17;
}

@noinline
function unique_updates(count: i32): i32 {
  let Ok(image) = source_image() else {
    return -1;
  };
  let Ok(output) = update(image, count) else {
    return -2;
  };
  return update_checksum(output, count);
}

@noinline
function shared_updates(count: i32): i32 {
  let Ok(image) = source_image() else {
    return -1;
  };
  let Ok(output) = update(image, count) else {
    return -2;
  };
  let Ok(original) = pixels.read_pixel(image, 0, 0) else {
    return -5;
  };
  if (original.r != 0 || original.a != 0) {
    return -6;
  }
  return update_checksum(output, count);
}

@noinline
function retained_updates(count: i32): i32 {
  let Ok(image) = source_image() else {
    return -1;
  };
  let retained: pixels.Image[] = [];
  let i = 0;
  while (i < count) {
    image = match (pixels.write_pixel(image, i % 64, i / 64 % 64, pixels.Pixel { r: 17, g: 23, b: 99, a: 128 })) { Ok(v) => v, Err(_) => { return -2; } };
    retained = retained.append(image);
    i += 1;
  }
  let checksum = 0;
  i = 0;
  while (i < retained.len()) {
    let Ok(p) = pixels.read_pixel(retained[i], i % 64, i / 64 % 64) else {
      return -3;
    };
    if (p.a != 128) {
      return -4;
    }
    if (i + 1 < count) {
      let Ok(untouched) = pixels.read_pixel(retained[i], (i + 1) % 64, (i + 1) / 64 % 64) else {
        return -5;
      };
      if (untouched.a != 0) {
        return -6;
      }
    }
    checksum += p.r as i32;
    i += 1;
  }
  return checksum;
}

@noinline
function source_graph(): Result[pipeline.Graph, pipeline.PipelineError] {
  let limits = pipeline.default_limits();
  let graph = pipeline.solid(64, 10000, pixels.RGBA8, pixels.Pixel { r: 17, g: 23, b: 99, a: 128 }, limits)?;
  return pipeline.bilinear(graph, 32, 20000, limits);
}

@noinline
function rows(count: i32, keep: boolean, cancel: boolean): i32 {
  let Ok(graph) = source_graph() else {
    return -1;
  };
  let retained: pixels.Image[] = [];
  let total = 0;
  let i = 0;
  while (i < count) {
    let calls = cell_new(0);
    let cancelled = (): boolean => {
      calls.set(calls.get() + 1);
      return cancel && calls.get() >= 7;
    };
    let result = pipeline.render_row(graph, 10000 + i, pipeline.default_limits(), cancelled);
    if (cancel) {
      match (result) {
        Err(pipeline.Cancelled()) => {
          total += 17;
        },
        _ => {
          return -2;
        }
      }
    } else {
      let Ok(row) = result else {
        return -3;
      };
      let Ok(p) = pixels.read_pixel(row, 31, 0) else {
        return -4;
      };
      if (p.a != 128) {
        return -5;
      }
      total += p.r as i32;
      if (keep) {
        retained = retained.append(row);
      }
    }
    i += 1;
  }
  for row in retained {
    let Ok(p) = pixels.read_pixel(row, 31, 0) else {
      return -6;
    };
    if (p.r != 17 || p.a != 128) {
      return -7;
    }
  }
  return total;
}

@noinline
function eager(count: i32, keep: boolean): i32 {
  let Ok(source) = source_image() else {
    return -1;
  };
  let retained: pixels.Image[] = [];
  let total = 0;
  let i = 0;
  while (i < count) {
    let Ok(output) = resize.resize(source, 32, 32, resize.Bilinear, pixels.default_limits()) else {
      return -2;
    };
    let Ok(p) = pixels.read_pixel(output, 31, 31) else {
      return -3;
    };
    if (output.data.len() != 4096 || p.r != 0 || p.g != 0 || p.b != 0 || p.a != 0) {
      return -4;
    }
    total += 17;
    if (keep) {
      retained = retained.append(output);
    }
    i += 1;
  }
  for output in retained {
    let Ok(p) = pixels.read_pixel(output, 31, 31) else {
      return -5;
    };
    if (p.a != 0 || output.data.len() != 4096) {
      return -6;
    }
  }
  return total;
}

function main(): i32 {
  let av = args();
  if (av.len() != 3 || av[2] != "16" && av[2] != "128") {
    eprint("usage: memory_probe MODE 16|128");
    return 1;
  }
  let count = if (av[2] == "128") { 128 } else { 16 };
  let before = __heap_bump_bytes();
  let allocations = __heap_alloc_count();
  let checksum = match (av[1]) { "unique" => unique_updates(count), "shared" => shared_updates(count), "retained" => retained_updates(count), "rows" => rows(count, false, false), "rows-retained" => rows(count, true, false), "rows-cancelled" => rows(count, false, true), "eager" => eager(count, false), "eager-retained" => eager(count, true), _ => { return 2; } };
  let used = __heap_alloc_count() - allocations;
  let after = __heap_bump_bytes();
  if (checksum != count * 17 || used <= 0 || after < before) {
    return 3;
  }
  print(f"mode={av[1]} count={count} allocations={used} bump_before={before} bump_after={after} bump_delta={after - before} checksum={checksum}");
  return 0;
}
