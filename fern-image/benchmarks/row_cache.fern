import "../packages/pipeline/pipeline";
import "../packages/pixels/pixels";
import "std/i32";
import "std/i64";

function never_cancel(): boolean {
  return false;
}

function main(): i32 {
  let av = args();
  if (av.len() != 3 || av[1] != "0" && av[1] != "12000" || av[2] != "16" && av[2] != "128") {
    eprint("usage: row_cache 0|12000 16|128");
    return 1;
  }
  let cache_bytes = if (av[1] == "12000") { 12000 } else { 0 };
  let count = if (av[2] == "128") { 128 } else { 16 };
  let before = __heap_bump_bytes();
  let allocated = __heap_alloc_count();
  let limits = pipeline.Limits { max_pixels: 10000000, max_row_bytes: 4000, max_scratch_bytes: 28000, max_nodes: 2, max_samples: 320000 };
  let Ok(input) = pipeline.solid(1000, 10000, pixels.RGBA8, pixels.Pixel { r: 17, g: 23, b: 99, a: 128 }, limits) else {
    return 2;
  };
  input = match (pipeline.bilinear(input, 500, 20000, limits)) { Ok(v) => v, Err(_) => { return 3; } };
  let checksum = cell_new(0);
  let consume = (row: pixels.Image): Result[void, i32] => {
    if (row.layout.width != 500 || row.layout.height != 1 || row.data.len() != 2000) {
      return Err(4);
    }
    let Ok(first) = pixels.read_pixel(row, 0, 0) else {
      return Err(5);
    };
    let Ok(last) = pixels.read_pixel(row, 499, 0) else {
      return Err(6);
    };
    if (first.r != 17 || last.r != 17 || first.a != 128 || last.a != 128) {
      return Err(7);
    }
    checksum.set(checksum.get() + last.r as i32);
    return Ok(());
  };
  let Ok(stats) = pipeline.render_rows(input, 10000, count, limits, cache_bytes, never_cancel, consume) else {
    return 8;
  };
  let allocations = __heap_alloc_count() - allocated;
  let after = __heap_bump_bytes();
  if (stats.rows != count || checksum.get() != count * 17 || allocations <= 0 || after < before) {
    return 9;
  }
  if (cache_bytes == 0 && (stats.hits != 0 || stats.misses != count * 3 || stats.peak_cache_bytes != 0)) {
    return 10;
  }
  if (cache_bytes > 0 && (stats.hits <= 0 || stats.misses >= count * 3 || stats.peak_cache_bytes > cache_bytes || stats.peak_cache_entries > 4)) {
    return 11;
  }
  print(f"cache_bytes={cache_bytes} count={count} allocations={allocations} bump_before={before} bump_after={after} bump_delta={after - before} hits={stats.hits} misses={stats.misses} peak_cache_bytes={stats.peak_cache_bytes} peak_cache_entries={stats.peak_cache_entries} checksum={checksum.get()}");
  return 0;
}
