import "../packages/pipeline/pipeline";
import "../packages/pixels/pixels";
import "std/i32";
import "std/i64";

function never_cancel(): boolean {
  return false;
}

function main(): i32 {
  let av = args();
  if (av.len() != 4 || av[1] != "legacy" && av[1] != "fused" || av[2] != "0" && av[2] != "12000" || av[3] != "8" && av[3] != "32") {
    eprint("usage: cached_fusion legacy|fused 0|12000 8|32");
    return 1;
  }
  let cache_bytes = if (av[2] == "12000") { 12000 } else { 0 };
  let count = if (av[3] == "32") { 32 } else { 8 };
  let before = __heap_bump_bytes();
  let allocated = __heap_alloc_count();
  let limits = pipeline.Limits { max_pixels: 10000000, max_row_bytes: 4096, max_scratch_bytes: 40000, max_nodes: 5, max_samples: 100000 };
  let Ok(graph) = pipeline.solid(1024, 8192, pixels.RGBA8, pixels.Pixel { r: 17, g: 23, b: 99, a: 128 }, limits) else {
    return 2;
  };
  let widths = [768, 512, 256, 128];
  let heights = [10000, 16000, 20000, 24000];
  for i in 0..widths.len() {
    graph = match (pipeline.nearest(graph, widths[i], heights[i], limits)) { Ok(v) => v, Err(_) => { return 3; } };
  }
  let consume = (checksum: i32, row: pixels.Image): Result[i32, i32] => {
    if (row.layout.width != 128 || row.layout.height != 1 || row.data.len() != 512) {
      return Err(4);
    }
    let Ok(first) = pixels.read_pixel(row, 0, 0) else {
      return Err(5);
    };
    let Ok(last) = pixels.read_pixel(row, 127, 0) else {
      return Err(6);
    };
    if (first.r != 17 || last.r != 17 || first.a != 128 || last.a != 128) {
      return Err(7);
    }
    return Ok(checksum + last.r as i32);
  };
  let folded = if (av[1] == "fused") { pipeline.fold_rows_fused(graph, 12000, count, limits, cache_bytes, never_cancel, 0, consume) } else { pipeline.fold_rows(graph, 12000, count, limits, cache_bytes, never_cancel, 0, consume) };
  let Ok(result) = folded else {
    return 8;
  };
  let allocations = __heap_alloc_count() - allocated;
  let after = __heap_bump_bytes();
  if (result.stats.rows != count || result.value != count * 17 || allocations <= 0 || after < before
    || result.stats.peak_cache_bytes > cache_bytes || result.stats.peak_cache_entries > 10) {
    return 9;
  }
  if (cache_bytes == 0 && result.stats.hits != 0) {
    return 10;
  }
  print(f"mode={av[1]} cache_bytes={cache_bytes} count={count} allocations={allocations} bump_before={before} bump_after={after} bump_delta={after - before} hits={result.stats.hits} misses={result.stats.misses} peak_cache_bytes={result.stats.peak_cache_bytes} peak_cache_entries={result.stats.peak_cache_entries} checksum={result.value}");
  return 0;
}
