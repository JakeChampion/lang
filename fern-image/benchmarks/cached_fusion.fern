import "../packages/pipeline/pipeline";
import "../packages/pixels/pixels";
import "std/i32";
import "std/i64";

function never_cancel(): boolean {
  return false;
}

function main(): i32 {
  let av = args();
  if (av.len() != 4 || av[1] != "legacy" && av[1] != "fused" || av[2] != "0" && av[2] != "12000" || av[3] != "8" && av[3] != "32") {
    eprint("usage: cached_fusion legacy|fused 0|12000 8|32");
    return 1;
  }
  let cache_bytes = 0;
  if (av[2] == "12000") {
    cache_bytes = 12000;
  }
  let count = 8;
  if (av[3] == "32") {
    count = 32;
  }
  let before: i64 = __heap_bump_bytes();
  let allocated: i64 = __heap_alloc_count();
  let limits = pipeline.Limits { max_pixels: 10000000, max_row_bytes: 4096, max_scratch_bytes: 40000, max_nodes: 5, max_samples: 100000 };
  let graph = match (pipeline.solid(1024, 8192, pixels.RGBA8, pixels.Pixel { r: 17, g: 23, b: 99, a: 128 }, limits)) { Ok(v) => v, Err(_) => { return 2; } };
  let widths: i32[] = [768, 512, 256, 128];
  let heights: i32[] = [10000, 16000, 20000, 24000];
  let i = 0;
  while (i < widths.len()) {
    graph = match (pipeline.nearest(graph, widths[i], heights[i], limits)) { Ok(v) => v, Err(_) => { return 3; } };
    i = i + 1;
  }
  let consume = (checksum: i32, row: pixels.Image): Result[i32, i32] => {
    if (row.layout.width != 128 || row.layout.height != 1 || row.data.len() != 512) {
      return Err(4);
    }
    let first = match (pixels.read_pixel(row, 0, 0)) { Ok(v) => v, Err(_) => { return Err(5); } };
    let last = match (pixels.read_pixel(row, 127, 0)) { Ok(v) => v, Err(_) => { return Err(6); } };
    if (first.r != 17 as u8 || last.r != 17 as u8 || first.a != 128 as u8 || last.a != 128 as u8) {
      return Err(7);
    }
    return Ok(checksum + last.r as i32);
  };
  let folded = if (av[1] == "fused") { pipeline.fold_rows_fused(graph, 12000, count, limits, cache_bytes, never_cancel, 0, consume) } else { pipeline.fold_rows(graph, 12000, count, limits, cache_bytes, never_cancel, 0, consume) };
  let result = match (folded) { Ok(v) => v, Err(_) => { return 8; } };
  let allocations: i64 = __heap_alloc_count() - allocated;
  let after: i64 = __heap_bump_bytes();
  if (result.stats.rows != count || result.value != count * 17 || allocations <= 0i64 || after < before
    || result.stats.peak_cache_bytes > cache_bytes || result.stats.peak_cache_entries > 10) {
    return 9;
  }
  if (cache_bytes == 0 && result.stats.hits != 0) {
    return 10;
  }
  print("mode=" + av[1] + " cache_bytes=" + cache_bytes.to_string() + " count=" + count.to_string()
    + " allocations=" + allocations.to_string() + " bump_before=" + before.to_string() + " bump_after=" + after.to_string()
    + " bump_delta=" + (after - before).to_string() + " hits=" + result.stats.hits.to_string() + " misses=" + result.stats.misses.to_string()
    + " peak_cache_bytes=" + result.stats.peak_cache_bytes.to_string() + " peak_cache_entries=" + result.stats.peak_cache_entries.to_string()
    + " checksum=" + result.value.to_string());
  return 0;
}
