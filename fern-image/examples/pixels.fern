import "../packages/pixels/pixels";

function main(): i32 {
  let Ok(image) = pixels.create(2, 1, 8, pixels.RGBA8, pixels.default_limits()) else {
    return 1;
  };
  let red = pixels.Pixel { r: 255, g: 0, b: 0, a: 128 };
  image = match (pixels.write_pixel(image, 1, 0, red)) { Ok(v) => v, Err(_) => { return 2; } };
  let Ok(got) = pixels.read_pixel(image, 1, 0) else {
    return 3;
  };
  if (got.r != 255 || got.g != 0 || got.b != 0 || got.a != 128) {
    return 4;
  }
  print("RGBA8 pixel round trip passed");
  return 0;
}
