import "../pixels/pixels";
import "../color/color";

pub enum Filter { Nearest, Bilinear }

pub struct Dimensions { width: i32, height: i32 }

pub struct BilinearAxis { first: i32, second: i32, weight: f64 }

pub function nearest_index(index: i32, source_size: i32, output_size: i32): Result[i32, pixels.ImageError] {
  if (source_size <= 0 || output_size <= 0) {
    return Err(pixels.Dimensions);
  }
  if (index < 0 || index >= output_size) {
    return Err(pixels.Bounds);
  }
  let numerator: i64 = (index as i64 * 2 + 1) * (source_size as i64);
  return Ok((numerator / (output_size as i64 * 2)) as i32);
}

pub function fit_dimensions(width: i32, height: i32, max_width: i32, max_height: i32): Result[Dimensions, pixels.ImageError] {
  if (width <= 0 || height <= 0 || max_width <= 0 || max_height <= 0) {
    return Err(pixels.Dimensions);
  }
  let w: i64 = width as i64;
  let h: i64 = height as i64;
  let mw: i64 = max_width as i64;
  let mh: i64 = max_height as i64;
  if (mw * h <= mh * w) {
    let fitted: i32 = ((h * mw + w / 2) / w) as i32;
    if (fitted < 1) {
      fitted = 1;
    }
    return Ok(Dimensions { width: max_width, height: fitted });
  }
  let fitted: i32 = ((w * mh + h / 2) / h) as i32;
  if (fitted < 1) {
    fitted = 1;
  }
  return Ok(Dimensions { width: fitted, height: max_height });
}

function clamp(value: i32, maximum: i32): i32 {
  if (value < 0) {
    return 0;
  }
  if (value > maximum) {
    return maximum;
  }
  return value;
}

pub function bilinear_axis(index: i32, source_size: i32, output_size: i32): Result[BilinearAxis, pixels.ImageError] {
  if (source_size <= 0 || output_size <= 0) {
    return Err(pixels.Dimensions);
  }
  if (index < 0 || index >= output_size) {
    return Err(pixels.Bounds);
  }
  let position: f64 = (index as f64 + 0.5) * (source_size as f64) / (output_size as f64) - 0.5;
  if (position < 0.0) {
    position = 0.0;
  }
  let first = clamp(position as i32, source_size - 1);
  return Ok(BilinearAxis { first: first, second: clamp(first + 1, source_size - 1), weight: position - first as f64 });
}

function byte(value: f64): u8 {
  if (value <= 0.0) {
    return 0 as u8;
  }
  if (value >= 1.0) {
    return 255 as u8;
  }
  return (value * 255.0 + 0.5) as u8;
}

function mix(a: f64, b: f64, c: f64, d: f64, fx: f64, fy: f64): f64 {
  return (a * (1.0 - fx) + b * fx) * (1.0 - fy) + (c * (1.0 - fx) + d * fx) * fy;
}

function channel(a: u8, b: u8, c: u8, d: u8, aa: f64, ba: f64, ca: f64, da: f64, alpha: f64, fx: f64, fy: f64): u8 {
  if (alpha == 0.0) {
    return 0 as u8;
  }
  let linear: f64 = mix(
    color.srgb_to_linear(a as f64 / 255.0) * aa,
    color.srgb_to_linear(b as f64 / 255.0) * ba,
    color.srgb_to_linear(c as f64 / 255.0) * ca,
    color.srgb_to_linear(d as f64 / 255.0) * da, fx, fy,
  ) / alpha;
  return byte(color.linear_to_srgb(linear));
}

pub function interpolate(a: pixels.Pixel, b: pixels.Pixel, c: pixels.Pixel, d: pixels.Pixel, fx: f64, fy: f64): Result[pixels.Pixel, pixels.ImageError] {
  if (fx != fx || fy != fy || fx < 0.0 || fx > 1.0 || fy < 0.0 || fy > 1.0) {
    return Err(pixels.Bounds);
  }
  let aa: f64 = a.a as f64 / 255.0;
  let ba: f64 = b.a as f64 / 255.0;
  let ca: f64 = c.a as f64 / 255.0;
  let da: f64 = d.a as f64 / 255.0;
  let alpha: f64 = mix(aa, ba, ca, da, fx, fy);
  return Ok(pixels.Pixel {
    r: channel(a.r, b.r, c.r, d.r, aa, ba, ca, da, alpha, fx, fy),
    g: channel(a.g, b.g, c.g, d.g, aa, ba, ca, da, alpha, fx, fy),
    b: channel(a.b, b.b, c.b, d.b, aa, ba, ca, da, alpha, fx, fy), a: byte(alpha),
  });
}

function bilinear(source: pixels.Image, x: BilinearAxis, y: BilinearAxis): Result[pixels.Pixel, pixels.ImageError] {
  let a = pixels.read_pixel(source, x.first, y.first)?;
  let b = pixels.read_pixel(source, x.second, y.first)?;
  let c = pixels.read_pixel(source, x.first, y.second)?;
  let d = pixels.read_pixel(source, x.second, y.second)?;
  return interpolate(a, b, c, d, x.weight, y.weight);
}

pub function resize(source: pixels.Image, width: i32, height: i32, filter: Filter, limits: pixels.Limits): Result[pixels.Image, pixels.ImageError] {
  if (width <= 0 || height <= 0) {
    return Err(pixels.Dimensions);
  }
  let first = pixels.read_pixel(source, 0, 0)?;
  let stride: i32 = match (width *? pixels.channels(source.layout.format)) { Some(n) => n, None => { return Err(pixels.Overflow); } };
  let output = pixels.create(width, height, stride, source.layout.format, limits)?;
  let y: i32 = 0;
  while (y < height) {
    let x: i32 = 0;
    while (x < width) {
      let value: pixels.Pixel = first;
      match (filter) {
        Nearest => {
          value = pixels.read_pixel(source, nearest_index(x, source.layout.width, width)?, nearest_index(y, source.layout.height, height)?)?;
        },
        Bilinear => {
          value = bilinear(source, bilinear_axis(x, source.layout.width, width)?, bilinear_axis(y, source.layout.height, height)?)?;
        }
      }
      output = pixels.write_pixel(output, x, y, value)?;
      x = x + 1;
    }
    y = y + 1;
  }
  return Ok(output);
}
