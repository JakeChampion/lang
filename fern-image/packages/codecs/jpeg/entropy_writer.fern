import "./header";
import "./coefficient_order";
import "core/cmp";

@derive(cmp.Debug, cmp.Eq)
pub enum EncodeError { Shape, Table, MissingSymbol, Coefficient, Limit, Cancelled }

pub enum ProducerError[E] { ProducerEncode(EncodeError), ProducerSource(E) }

struct Codes { bits: i32[], sizes: i32[] }

struct BitOutput { bytes: u8[], pending: i32, used: i32, limit: i32 }

struct ProducedState { output: BitOutput, previous: i32, count: i32, marker: i32 }

struct ProducerSlot { state: Option[ProducedState], failure: Option[EncodeError], open: boolean }

pub struct ScanComponent { horizontal: i32, vertical: i32, dc: i32, ac: i32 }

pub struct ScanTables { dc: header.HuffmanTable[], ac: header.HuffmanTable[] }

pub struct ScanOptions { mcus: i32, restart_interval: i32, max_output_bytes: i32 }

struct ScanPrepared { dc: Codes[], ac: Codes[], components: ScanComponent[], members: i32[], blocks: i32 }

struct ScanState { output: BitOutput, previous: i32[], count: i32, marker: i32 }

struct ScanSlot { state: Option[ScanState], failure: Option[EncodeError], open: boolean }

function insert_codes(result: Codes, table: header.HuffmanTable, offset: i32, code: i32, count: i32, size: i32, ac: boolean): Result[Codes, EncodeError] {
  let output = result;
  for j in 0..count {
    let value = table.symbols[offset + j] as i32;
    if (!legal_symbol(value, ac) || output.sizes[value] != 0) {
      return Err(EncodeError.Table);
    }
    output = Codes { bits: output.bits.with(value, code + j), sizes: output.sizes.with(value, size) };
  }
  return Ok(output);
}

function legal_symbol(value: i32, ac: boolean): boolean {
  if (!ac) {
    return value <= 11;
  }
  let size = value & 15;
  return size >= 1 && size <= 10 || value == 0 || value == 240;
}

function codes(table: header.HuffmanTable, ac: boolean, cancelled: () => boolean): Result[Codes, EncodeError] {
  let bits: i32[] = [];
  let sizes: i32[] = [];
  for i in 0..256 {
    bits = bits.append(0);
    sizes = sizes.append(0);
  }
  let offset = 0;
  let code = 0;
  let result = Codes { bits: bits, sizes: sizes };
  for i in 0..16 {
    if (cancelled()) {
      return Err(EncodeError.Cancelled);
    }
    let count = table.counts[i] as i32;
    // The last available code is all ones and remains reserved.
    if (code + count >= 1 << i + 1 || count > table.symbols.len() - offset) {
      return Err(EncodeError.Table);
    }
    result = insert_codes(result, table, offset, code, count, i + 1, ac)?;
    offset += count;
    code = (code + count) * 2;
  }
  if (offset == 0 || offset != table.symbols.len()) {
    return Err(EncodeError.Table);
  }
  return Ok(result);
}

function raw_byte(writer: BitOutput, value: u8): Result[BitOutput, EncodeError] {
  if (writer.bytes.len() >= writer.limit) {
    return Err(EncodeError.Limit);
  }
  return Ok(BitOutput { ...writer, bytes: writer.bytes.append(value) });
}

function put(writer: BitOutput, value: i32, size: i32, cancelled: () => boolean): Result[BitOutput, EncodeError] {
  let w = writer;
  for i in 0..size {
    let used = w.used + 1;
    let pending = w.pending * 2 + (value >> size - i - 1 & 1);
    w = BitOutput { ...w, pending: pending, used: used };
    if (used == 8) {
      if (cancelled()) {
        return Err(EncodeError.Cancelled);
      }
      w = raw_byte(w, pending as u8)?;
      if (pending == 255) {
        w = raw_byte(w, 0)?;
      }
      w = BitOutput { ...w, pending: 0, used: 0 };
    }
  }
  return Ok(w);
}

function symbol(writer: BitOutput, table: Codes, value: i32, cancelled: () => boolean): Result[BitOutput, EncodeError] {
  let size = table.sizes[value];
  if (size == 0) {
    return Err(EncodeError.MissingSymbol);
  }
  return put(writer, table.bits[value], size, cancelled);
}

function category(value: i32): i32 {
  let magnitude = if (value < 0) { -value } else { value };
  let size = 0;
  while (magnitude > 0) {
    size += 1;
    magnitude >>= 1;
  }
  return size;
}

function amplitude(writer: BitOutput, value: i32, size: i32, cancelled: () => boolean): Result[BitOutput, EncodeError] {
  let bits = if (value < 0) { value + (1 << size) - 1 } else { value };
  return put(writer, bits, size, cancelled);
}

function check_block(values: [i32], cancelled: () => boolean): Result[void, EncodeError] {
  if (values[0] < -1024 || values[0] > 1023) {
    return Err(EncodeError.Coefficient);
  }
  for k in 1..64 {
    if (k % 8 == 0 && cancelled()) {
      return Err(EncodeError.Cancelled);
    }
    let value = values[coefficient_order.ZIGZAG[k]];
    if (value < -1023 || value > 1023) {
      return Err(EncodeError.Coefficient);
    }
  }
  return Ok(());
}

function nonzero_ac(writer: BitOutput, table: Codes, run: i32, value: i32, cancelled: () => boolean): Result[BitOutput, EncodeError] {
  let w = writer;
  let remaining = run;
  while (remaining >= 16) {
    w = symbol(w, table, 240, cancelled)?;
    remaining -= 16;
  }
  let size = category(value);
  w = symbol(w, table, remaining * 16 + size, cancelled)?;
  return amplitude(w, value, size, cancelled);
}

function block(writer: BitOutput, values: [i32], previous: i32, dc: Codes, ac: Codes, cancelled: () => boolean): Result[BitOutput, EncodeError] {
  check_block(values, cancelled)?;
  let delta = values[0] - previous;
  let size = category(delta);
  let w = symbol(writer, dc, size, cancelled)?;
  w = amplitude(w, delta, size, cancelled)?;
  let run = 0;
  for k in 1..64 {
    let value = values[coefficient_order.ZIGZAG[k]];
    if (value == 0) {
      run += 1;
    } else {
      w = nonzero_ac(w, ac, run, value, cancelled)?;
      run = 0;
    }
  }
  if (run > 0) {
    w = symbol(w, ac, 0, cancelled)?;
  }
  return Ok(w);
}

function align(writer: BitOutput, cancelled: () => boolean): Result[BitOutput, EncodeError] {
  let size = (8 - writer.used) % 8;
  return put(writer, (1 << size) - 1, size, cancelled);
}

function check_table_shape(table: header.HuffmanTable): Result[void, EncodeError] {
  if (table.counts.len() != 16 || table.symbols.len() > 256) {
    return Err(EncodeError.Shape);
  }
  return Ok(());
}

function restart(writer: BitOutput, marker: i32, cancelled: () => boolean): Result[BitOutput, EncodeError] {
  let output = align(writer, cancelled)?;
  output = raw_byte(output, 255)?;
  return raw_byte(output, (208 + marker) as u8);
}

function write_blocks(coefficients: [i32], dc: Codes, ac: Codes, interval: i32, initial: BitOutput, cancelled: () => boolean): Result[BitOutput, EncodeError] {
  let writer = initial;
  let previous = 0;
  let marker = 0;
  let blocks = coefficients.len() / 64;
  for i in 0..blocks {
    if (cancelled()) {
      return Err(EncodeError.Cancelled);
    }
    let start = i * 64;
    writer = block(writer, coefficients[start:start + 64], previous, dc, ac, cancelled)?;
    previous = coefficients[start];
    if (interval > 0 && (i + 1) % interval == 0 && i + 1 < blocks) {
      writer = restart(writer, marker, cancelled)?;
      marker = (marker + 1) % 8;
      previous = 0;
    }
  }
  return align(writer, cancelled);
}

function admit(length: i32, dc: header.HuffmanTable, ac: header.HuffmanTable, interval: i32, limit: i32): Result[void, EncodeError] {
  if (length == 0 || length % 64 != 0) {
    return Err(EncodeError.Shape);
  }
  check_table_shape(dc)?;
  check_table_shape(ac)?;
  if (interval < 0 || interval > 65535 || limit < 0) {
    return Err(EncodeError.Limit);
  }
  return Ok(());
}

// Encode one component's complete natural-order blocks, without frame or EOI.
pub function encode_blocks(coefficients: [i32], dc: header.HuffmanTable, ac: header.HuffmanTable, restart_interval: i32, max_output_bytes: i32, cancelled: () => boolean): Result[u8[], EncodeError] {
  admit(coefficients.len(), dc, ac, restart_interval, max_output_bytes)?;
  if (cancelled()) {
    return Err(EncodeError.Cancelled);
  }
  let dc_codes = codes(dc, false, cancelled)?;
  let ac_codes = codes(ac, true, cancelled)?;
  let initial = BitOutput { bytes: [], pending: 0, used: 0, limit: max_output_bytes };
  let writer = write_blocks(coefficients, dc_codes, ac_codes, restart_interval, initial, cancelled)?;
  if (cancelled()) {
    return Err(EncodeError.Cancelled);
  }
  return Ok(writer.bytes);
}

function poison(slot: Cell[ProducerSlot], error: EncodeError): EncodeError {
  let current = slot.get();
  if let Some(first) = current.failure {
    return first;
  }
  slot.set(ProducerSlot { ...current, failure: Some(error) });
  return error;
}

function take(slot: Cell[ProducerSlot], length: i32, count: i32): Result[ProducedState, EncodeError] {
  let current = slot.get();
  if (!current.open) {
    return Err(EncodeError.Shape);
  }
  if let Some(error) = current.failure {
    return Err(error);
  }
  let Some(state) = current.state else {
    return Err(poison(slot, EncodeError.Shape));
  };
  if (length != 64 || state.count >= count) {
    return Err(poison(slot, EncodeError.Shape));
  }
  // Remove the output from the cell before append operations or callbacks.
  slot.set(ProducerSlot { state: None, failure: None, open: true });
  return Ok(state);
}

function produced_block(state: ProducedState, values: [i32], dc: Codes, ac: Codes, interval: i32, cancelled: () => boolean): Result[ProducedState, EncodeError] {
  if (cancelled()) {
    return Err(EncodeError.Cancelled);
  }
  let output = state.output;
  let previous = state.previous;
  let marker = state.marker;
  if (interval > 0 && state.count > 0 && state.count % interval == 0) {
    output = restart(output, marker, cancelled)?;
    previous = 0;
    marker = (marker + 1) % 8;
  }
  output = block(output, values, previous, dc, ac, cancelled)?;
  return Ok(ProducedState { output: output, previous: values[0], count: state.count + 1, marker: marker });
}

function restore(slot: Cell[ProducerSlot], result: Result[ProducedState, EncodeError]): Result[void, EncodeError] {
  if let Some(error) = slot.get().failure {
    return Err(error);
  }
  match (result) {
    Ok(state) => {
      slot.set(ProducerSlot { state: Some(state), failure: None, open: true });
    },
    Err(error) => {
      return Err(poison(slot, error));
    }
  }
  return Ok(());
}

function accept(slot: Cell[ProducerSlot], values: [i32], count: i32, dc: Codes, ac: Codes, interval: i32, cancelled: () => boolean): Result[void, EncodeError] {
  let state = take(slot, values.len(), count)?;
  return restore(slot, produced_block(state, values, dc, ac, interval, cancelled));
}

function close(slot: Cell[ProducerSlot]): Result[ProducedState, EncodeError] {
  let current = slot.get();
  slot.set(ProducerSlot { state: None, failure: current.failure, open: false });
  if let Some(error) = current.failure {
    return Err(error);
  }
  return match (current.state) { Some(state) => Ok(state), None => Err(EncodeError.Shape) };
}

function admit_producer(count: i32, dc: header.HuffmanTable, ac: header.HuffmanTable, interval: i32, limit: i32): Result[void, EncodeError] {
  if (count <= 0) {
    return Err(EncodeError.Shape);
  }
  check_table_shape(dc)?;
  check_table_shape(ac)?;
  if (interval < 0 || interval > 65535 || limit < 0) {
    return Err(EncodeError.Limit);
  }
  return Ok(());
}

function produced_state(count: i32, dc: header.HuffmanTable, ac: header.HuffmanTable, interval: i32, limit: i32, cancelled: () => boolean): Result[(Codes, Codes, ProducedState), EncodeError] {
  admit_producer(count, dc, ac, interval, limit)?;
  if (cancelled()) {
    return Err(EncodeError.Cancelled);
  }
  let dc_codes = codes(dc, false, cancelled)?;
  let ac_codes = codes(ac, true, cancelled)?;
  let output = BitOutput { bytes: [], pending: 0, used: 0, limit: limit };
  return Ok((dc_codes, ac_codes, ProducedState { output: output, previous: 0, count: 0, marker: 0 }));
}

// The producer supplies exactly count complete blocks through a synchronous consumer.
pub function encode_produced[S, E](source: S, count: i32, dc: header.HuffmanTable, ac: header.HuffmanTable, interval: i32, limit: i32, cancelled: () => boolean, produce: (S, ([i32]) => Result[void, EncodeError]) => Result[void, E]): Result[u8[], ProducerError[E]] {
  let (dc_codes, ac_codes, initial) = match (produced_state(count, dc, ac, interval, limit, cancelled)) { Ok(v) => v, Err(e) => { return Err(ProducerEncode(e)); } };
  let slot = cell_new(ProducerSlot { state: Some(initial), failure: None, open: true });
  let result = produce(source, (values: [i32]): Result[void, EncodeError] => accept(slot, values, count, dc_codes, ac_codes, interval, cancelled));
  let state = match (close(slot)) { Ok(v) => v, Err(e) => { return Err(ProducerEncode(e)); } };
  if let Err(error) = result {
    return Err(ProducerSource(error));
  }
  if (state.count != count) {
    return Err(ProducerEncode(EncodeError.Shape));
  }
  let output = match (align(state.output, cancelled)) { Ok(v) => v, Err(e) => { return Err(ProducerEncode(e)); } };
  if (cancelled()) {
    return Err(ProducerEncode(EncodeError.Cancelled));
  }
  return Ok(output.bytes);
}

function scan_component(item: ScanComponent, tables: ScanTables): Result[void, EncodeError] {
  if (item.horizontal < 1 || item.horizontal > 4 || item.vertical < 1 || item.vertical > 4) {
    return Err(EncodeError.Shape);
  }
  if (item.dc < 0 || item.dc >= tables.dc.len() || item.ac < 0 || item.ac >= tables.ac.len()) {
    return Err(EncodeError.Table);
  }
  return Ok(());
}

function scan_table_shapes(tables: ScanTables): Result[void, EncodeError] {
  if (tables.dc.len() < 1 || tables.dc.len() > 2 || tables.ac.len() < 1 || tables.ac.len() > 2) {
    return Err(EncodeError.Shape);
  }
  for table in tables.dc {
    check_table_shape(table)?;
  }
  for table in tables.ac {
    check_table_shape(table)?;
  }
  return Ok(());
}

function scan_shape(components: [ScanComponent], tables: ScanTables): Result[i32, EncodeError] {
  if (components.len() < 1 || components.len() > 4) {
    return Err(EncodeError.Shape);
  }
  scan_table_shapes(tables)?;
  let units = 0;
  for item in components {
    scan_component(item, tables)?;
    units += item.horizontal * item.vertical;
  }
  if (components.len() > 1 && units > 10) {
    return Err(EncodeError.Shape);
  }
  return Ok(if (components.len() == 1) { 1 } else { units });
}

function scan_admit(components: [ScanComponent], tables: ScanTables, options: ScanOptions): Result[(i32, i32), EncodeError] {
  if (options.mcus <= 0) {
    return Err(EncodeError.Shape);
  }
  let units = scan_shape(components, tables)?;
  let count = options.mcus as i64 * (units as i64);
  if (options.restart_interval < 0 || options.restart_interval > 65535 || options.max_output_bytes < 0 || count > 2147483647i64) {
    return Err(EncodeError.Limit);
  }
  return Ok((units, count as i32));
}

function scan_codes(tables: header.HuffmanTable[], ac: boolean, cancelled: () => boolean): Result[Codes[], EncodeError] {
  let result: Codes[] = [];
  for table in tables {
    result = result.append(codes(table, ac, cancelled)?);
  }
  return Ok(result);
}

function scan_prepare(components: [ScanComponent], tables: ScanTables, options: ScanOptions, cancelled: () => boolean): Result[(ScanPrepared, ScanState), EncodeError] {
  let (units, count) = scan_admit(components, tables, options)?;
  if (cancelled()) {
    return Err(EncodeError.Cancelled);
  }
  let dc = scan_codes(tables.dc, false, cancelled)?;
  let ac = scan_codes(tables.ac, true, cancelled)?;
  let members: i32[] = [];
  let copied: ScanComponent[] = [];
  let previous: i32[] = [];
  for i in 0..components.len() {
    if (cancelled()) {
      return Err(EncodeError.Cancelled);
    }
    let item = components[i];
    copied = copied.append(item);
    previous = previous.append(0);
    let blocks = if (components.len() == 1) { units } else { item.horizontal * item.vertical };
    for j in 0..blocks {
      members = members.append(i);
    }
  }
  let prepared = ScanPrepared { dc: dc, ac: ac, components: copied, members: members, blocks: count };
  let output = BitOutput { bytes: [], pending: 0, used: 0, limit: options.max_output_bytes };
  return Ok((prepared, ScanState { output: output, previous: previous, count: 0, marker: 0 }));
}

function scan_poison(slot: Cell[ScanSlot], error: EncodeError): EncodeError {
  let current = slot.get();
  if let Some(first) = current.failure {
    return first;
  }
  slot.set(ScanSlot { ...current, failure: Some(error) });
  return error;
}

function scan_take(slot: Cell[ScanSlot], length: i32, count: i32): Result[ScanState, EncodeError] {
  let current = slot.get();
  if (!current.open) {
    return Err(EncodeError.Shape);
  }
  if let Some(error) = current.failure {
    return Err(error);
  }
  let Some(state) = current.state else {
    return Err(scan_poison(slot, EncodeError.Shape));
  };
  if (length != 64 || state.count >= count) {
    return Err(scan_poison(slot, EncodeError.Shape));
  }
  slot.set(ScanSlot { state: None, failure: None, open: true });
  return Ok(state);
}

function scan_block(state: ScanState, values: [i32], prepared: ScanPrepared, interval: i32, cancelled: () => boolean): Result[ScanState, EncodeError] {
  if (cancelled()) {
    return Err(EncodeError.Cancelled);
  }
  let output = state.output;
  let previous = state.previous;
  let marker = state.marker;
  let units = prepared.members.len();
  let mcu_start = state.count % units == 0;
  if (interval > 0 && state.count > 0 && mcu_start && state.count / units % interval == 0) {
    output = restart(output, marker, cancelled)?;
    for i in 0..previous.len() {
      previous = previous.with(i, 0);
    }
    marker = (marker + 1) % 8;
  }
  let index = prepared.members[state.count % units];
  let component = prepared.components[index];
  output = block(output, values, previous[index], prepared.dc[component.dc], prepared.ac[component.ac], cancelled)?;
  previous = previous.with(index, values[0]);
  return Ok(ScanState { output: output, previous: previous, count: state.count + 1, marker: marker });
}

function scan_accept(slot: Cell[ScanSlot], values: [i32], prepared: ScanPrepared, interval: i32, cancelled: () => boolean): Result[void, EncodeError] {
  let state = scan_take(slot, values.len(), prepared.blocks)?;
  let result = scan_block(state, values, prepared, interval, cancelled);
  if let Some(first) = slot.get().failure {
    return Err(first);
  }
  match (result) {
    Ok(next) => {
      slot.set(ScanSlot { state: Some(next), failure: None, open: true });
    },
    Err(error) => {
      return Err(scan_poison(slot, error));
    }
  }
  return Ok(());
}

function scan_close(slot: Cell[ScanSlot]): Result[ScanState, EncodeError] {
  let current = slot.get();
  slot.set(ScanSlot { state: None, failure: current.failure, open: false });
  if let Some(first) = current.failure {
    return Err(first);
  }
  return match (current.state) { Some(state) => Ok(state), None => Err(EncodeError.Shape) };
}

// Produce complete natural-order blocks in component order within each MCU.
pub function encode_mcus_produced[S, E](source: S, components: [ScanComponent], tables: ScanTables, options: ScanOptions, cancelled: () => boolean, produce: (S, ([i32]) => Result[void, EncodeError]) => Result[void, E]): Result[u8[], ProducerError[E]] {
  let (prepared, initial) = match (scan_prepare(components, tables, options, cancelled)) { Ok(v) => v, Err(e) => { return Err(ProducerEncode(e)); } };
  let slot = cell_new(ScanSlot { state: Some(initial), failure: None, open: true });
  let result = produce(source, (values: [i32]): Result[void, EncodeError] => scan_accept(slot, values, prepared, options.restart_interval, cancelled));
  let state = match (scan_close(slot)) { Ok(v) => v, Err(e) => { return Err(ProducerEncode(e)); } };
  if let Err(error) = result {
    return Err(ProducerSource(error));
  }
  if (state.count != prepared.blocks) {
    return Err(ProducerEncode(EncodeError.Shape));
  }
  let output = match (align(state.output, cancelled)) { Ok(v) => v, Err(e) => { return Err(ProducerEncode(e)); } };
  if (cancelled()) {
    return Err(ProducerEncode(EncodeError.Cancelled));
  }
  return Ok(output.bytes);
}
