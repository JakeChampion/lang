// Decode a single VP8L chunk payload using one group of simple literal codes.
import "../../pixels/pixels";
import "../jxl/bits";
import "core/cmp";

@derive(cmp.Eq)
pub enum DecodeError { Header, Truncated, Unsupported, InvalidCode, Trailing, Limit, Cancelled }

struct Code { low: u8, high: u8, width: i32 }

function field(input: [u8], at: i64, width: i32): Result[bits.Read, DecodeError] {
  return match (bits.read(input, at, width, input.len() as i64 * 8i64)) {
    Ok(r) => Ok(r), Err(_) => Err(Truncated),
  };
}

function code(input: [u8], at: i64, alphabet: i32): Result[(Code, i64), DecodeError] {
  let simple = field(input, at, 1)?;
  if (simple.value == 0u64) {
    return Err(Unsupported);
  }
  let pair = field(input, simple.next, 1)?;
  let wide = field(input, pair.next, 1)?;
  let a = field(input, wide.next, if (wide.value == 0u64) { 1 } else { 8 })?;
  if (a.value >= alphabet as u64) {
    return Err(InvalidCode);
  }
  let first = a.value as u8;
  if (pair.value == 0u64) {
    return Ok((Code { low: first, high: first, width: 0 }, a.next));
  }
  let b = field(input, a.next, 8)?;
  if (b.value >= alphabet as u64 || b.value == a.value) {
    return Err(InvalidCode);
  }
  let second = b.value as u8;
  return Ok((if (first < second) { Code { low: first, high: second, width: 1 } } else { Code { low: second, high: first, width: 1 } }, b.next));
}

// The caller has checked the extent of all literal bits before allocating.
function symbol(input: [u8], c: Code, at: i64): u8 {
  if (c.width == 0) {
    return c.low;
  }
  return if ((input[(at / 8i64) as i32] as i32 >> (at % 8i64) as i32 & 1) == 0) { c.low } else { c.high };
}

struct Group { green: Code, red: Code, blue: Code, alpha: Code, stride: i32, start: i64 }

function group(input: [u8], next: i64, flags_width: i32): Result[Group, DecodeError] {
  let flags = field(input, next, flags_width)?;
  if (flags.value != 0u64) {
    return Err(Unsupported);
  }
  let (green, g) = code(input, flags.next, 280)?;
  let (red, r) = code(input, g, 256)?;
  let (blue, b) = code(input, r, 256)?;
  let (alpha, a) = code(input, b, 256)?;
  let (_, start) = code(input, a, 40)?;
  return Ok(Group { green: green, red: red, blue: blue, alpha: alpha, stride: green.width + red.width + blue.width + alpha.width, start: start });
}

function literal(input: [u8], codes: Group, at: i64): pixels.Pixel {
  let r = at + codes.green.width as i64;
  let b = r + codes.red.width as i64;
  let a = b + codes.blue.width as i64;
  return pixels.Pixel { r: symbol(input, codes.red, r), g: symbol(input, codes.green, at), b: symbol(input, codes.blue, b), a: symbol(input, codes.alpha, a) };
}

function add_channel(a: u8, b: u8): u8 {
  return (a as i32 + b as i32 & 255) as u8;
}

function read_palette(input: [u8], next: i64, restore_green: boolean): Result[(pixels.Pixel[], i64), DecodeError] {
  let size = field(input, next, 8)?;
  let count = size.value as i32 + 1;
  // An auxiliary image has a color-cache flag and no meta-prefix flag.
  let codes = group(input, size.next, 1)?;
  let end = codes.start + count as i64 * (codes.stride as i64);
  if (end > input.len() as i64 * 8i64) {
    return Err(Truncated);
  }
  let entries: pixels.Pixel[] = [];
  let color = pixels.Pixel { r: 0, g: 0, b: 0, a: 0 };
  for i in 0..count {
    let d = literal(input, codes, codes.start + i as i64 * (codes.stride as i64));
    color = pixels.Pixel { r: add_channel(color.r, d.r), g: add_channel(color.g, d.g), b: add_channel(color.b, d.b), a: add_channel(color.a, d.a) };
    // Apply an earlier subtract-green transform after palette lookup by
    // restoring each entry once. The next delta still uses the coded color.
    let entry = if (restore_green) { pixels.Pixel { ...color, r: add_channel(color.r, color.g), b: add_channel(color.b, color.g) } } else { color };
    entries = entries.append(entry);
  }
  return Ok((entries, end));
}

pub function decode_simple(input: [u8], limits: pixels.Limits, cancelled: () => boolean): Result[pixels.Image, DecodeError] {
  if (cancelled()) {
    return Err(Cancelled);
  }
  let signature = field(input, 0i64, 8)?;
  if (signature.value != 47u64) {
    return Err(Header);
  }
  let w = field(input, 8i64, 14)?;
  let h = field(input, w.next, 14)?;
  // The alpha hint is informational. The alpha tree supplies each value.
  let version = field(input, h.next + 1i64, 3)?;
  if (version.value != 0u64) {
    return Err(Header);
  }
  let width = w.value as i32 + 1;
  let height = h.value as i32 + 1;
  let Ok(layout) = pixels.checked_layout(width, height, width * 4, pixels.RGBA8, limits) else {
    return Err(Limit);
  };
  let next = version.next;
  let subtract_green = false;
  let palette: pixels.Pixel[] = [];
  while (true) {
    let transform = field(input, next, 1)?;
    next = transform.next;
    if (transform.value == 0u64) {
      break;
    }
    let kind = field(input, next, 2)?;
    next = kind.next;
    if (kind.value == 2u64) {
      if (subtract_green) {
        return Err(InvalidCode);
      }
      subtract_green = true;
    } else if (kind.value == 3u64) {
      if (palette.len() != 0) {
        return Err(InvalidCode);
      }
      let (entries, after) = read_palette(input, next, subtract_green)?;
      palette = entries;
      next = after;
    } else {
      return Err(Unsupported);
    }
  }
  let codes = group(input, next, 2)?;
  let packed = if (palette.len() == 0 || palette.len() > 16) { 1 } else if (palette.len() <= 2) { 8 } else if (palette.len() <= 4) { 4 } else { 2 };
  let index_bits = 8 / packed;
  let columns = (width + packed - 1) / packed;
  let end = codes.start + columns as i64 * (height as i64) * (codes.stride as i64);
  let used = (end + 7i64) / 8i64;
  if (used > input.len() as i64) {
    return Err(Truncated);
  }
  if (used < input.len() as i64) {
    return Err(Trailing);
  }
  let data = __alloc_u8(layout.bytes);
  let at = codes.start;
  for y in 0..height {
    if (cancelled()) {
      return Err(Cancelled);
    }
    for col in 0..columns {
      let green = symbol(input, codes.green, at);
      let row = y * layout.stride;
      if (palette.len() == 0) {
        let r = at + codes.green.width as i64;
        let b = r + codes.red.width as i64;
        let a = b + codes.blue.width as i64;
        let delta: u8 = if (subtract_green) { green } else { 0 };
        let i = row + col * 4;
        data = data.with(i, add_channel(symbol(input, codes.red, r), delta)).with(i + 1, green);
        data = data.with(i + 2, add_channel(symbol(input, codes.blue, b), delta)).with(i + 3, symbol(input, codes.alpha, a));
      } else {
        for sub in 0..packed {
          let x = col * packed + sub;
          if (x >= width) {
            break;
          }
          let idx = green as i32 >> sub * index_bits & (1 << index_bits) - 1;
          // Out-of-range indices retain the zero-initialized transparent black.
          if (idx < palette.len()) {
            let color = palette[idx];
            let i = row + x * 4;
            data = data.with(i, color.r).with(i + 1, color.g).with(i + 2, color.b).with(i + 3, color.a);
          }
        }
      }
      at += codes.stride as i64;
    }
  }
  return Ok(pixels.Image { layout: layout, data: data });
}
