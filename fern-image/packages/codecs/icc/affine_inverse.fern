import "tag_data";
import "std/f64";
import "core/cmp";

@derive(cmp.Debug, cmp.Eq)
pub enum InvertError { Input, Function, Shape, Domain, Unsupported, NonInvertible, Numeric, Cancelled }

struct Parameters { gamma: f64, a: f64, b: f64, offset: f64, white: f64, identity: boolean }

struct Difference { high: f64, low: f64 }

function admit(data: tag_data.ParametricData): Result[Parameters, InvertError] {
  if (data.function_type < 0 || data.function_type > 4) {
    return Err(InvertError.Function);
  }
  if (data.function_type != 1 && data.function_type != 2) {
    return Err(InvertError.Unsupported);
  }
  let count = if (data.function_type == 1) { 3 } else { 4 };
  let values = data.coefficients;
  if (values.len() != count) {
    return Err(InvertError.Shape);
  }
  if (values[0] <= 0 || values[1] <= 0) {
    return Err(InvertError.Domain);
  }
  let offset = if (data.function_type == 2) { values[3] } else { 0 };
  if (values[0] < 65536 || values[0] > 262144 || values[1] < 16384 || values[1] > 262144 || values[2] > 0 || offset < 0 || offset > 32768) {
    return Err(InvertError.Unsupported);
  }
  let white = values[1] as i64 + values[2] as i64;
  if (white <= 0i64) {
    return Err(InvertError.NonInvertible);
  }
  if (white > 65536i64) {
    return Err(InvertError.Unsupported);
  }
  return Ok(Parameters {
    gamma: values[0] as f64 / 65536.0,
    a: values[1] as f64 / 65536.0,
    b: values[2] as f64 / 65536.0,
    offset: offset as f64 / 65536.0,
    white: white as f64 / 65536.0,
    identity: values[0] == 65536 && values[1] == 65536 && values[2] as i64 + offset as i64 == 0i64,
  });
}

function difference(input: f64, offset: f64): Difference {
  let high = input - offset;
  let virtual = high - input;
  return Difference { high: high, low: input - (high - virtual) + (-offset - virtual) };
}

function coordinate(data: Parameters, input: f64): f64 {
  if (input <= data.offset) {
    // The initial flat interval selects its greatest coordinate.
    return -data.b / data.a;
  }
  let target = difference(input, data.offset);
  let maximum = data.white.pow(data.gamma);
  // Retain the small power range before an offset can erase it through rounding.
  if (target.high > maximum || target.high == maximum && target.low >= 0.0) {
    return 1.0;
  }
  let exponent = 1.0 / data.gamma;
  let root = target.high.pow(exponent);
  root = root + root * (exponent * (target.low / target.high));
  return (root - data.b) / data.a;
}

// This bounded kernel implements the continuous monotonic subset declared in #13702.
pub function invert(data: tag_data.ParametricData, input: f64, cancelled: () => boolean): Result[f64, InvertError] {
  if (!input.is_finite() || input < 0.0 || input > 1.0) {
    return Err(InvertError.Input);
  }
  let parameters = admit(data)?;
  if (cancelled()) {
    return Err(InvertError.Cancelled);
  }
  let identity = parameters.identity && input >= parameters.offset;
  let value = if (identity) { input } else { coordinate(parameters, input) };
  if (!value.is_finite()) {
    return Err(InvertError.Numeric);
  }
  if (!identity) {
    value = if (value <= 0.0) { 0.0 } else if (value > 1.0) { 1.0 } else { value };
  }
  if (cancelled()) {
    return Err(InvertError.Cancelled);
  }
  return Ok(value);
}
