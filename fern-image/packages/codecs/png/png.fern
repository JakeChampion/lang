import "../../pixels/pixels";
import "./compression";
import "./palette";
import "./filters";
import "./indexed_validation";
import "./transparency";
import "./adam7";
import "std/hash/crc32";
import "std/deflate";
import "core/cmp";

@derive(cmp.Debug, cmp.Eq)
pub enum PngError { Signature, Truncated, Length, Crc, Order, Unsupported, Dimensions, Limit, Compressed, Scanline }

struct EncodedRow { channels: i32, stride: i32, depth: i32, palette: Option[palette.IndexedPalette], key: transparency.Key }

struct PaletteChunks { colors: u8[], alpha: u8[], has_alpha: boolean, color_type: i32, key: transparency.Key }

struct Prepared { layout: pixels.Layout, scanline: EncodedRow, compressed: u8[], filtered_bytes: i32, passes: Option[adam7.Plan] }

pub struct RowLimits { max_payload_bytes: i64, max_row_work: i64 }

pub struct RowPlan {
  layout: pixels.Layout,
  first: i32,
  count: i32,
  filtered_bytes: i32,
  row_scratch_bytes: i64,
  payload_bytes: i64,
  row_work: i64,
}

pub enum RowError[E] { RowCodec(PngError), RowBounds, RowBudget, RowCancelled, RowConsumer(E) }

pub struct RowFold[S] { value: S, plan: RowPlan }

@derive(cmp.Eq)
pub enum DecoderError { DecoderCodec(PngError), DecoderBounds, DecoderBudget, DecoderCancelled, DecoderAccess }

pub struct RowDecoder { plan: RowPlan, read: (i32, () => boolean) => Result[pixels.Image, DecoderError] }

struct RowCursor { next: i32, previous: u8[] }

struct StreamCursor { next: i32, previous: u8[], failure: Option[DecoderError] }

struct StreamRead { cursor: StreamCursor, result: Result[pixels.Image, DecoderError] }

// Logical allowance for bounded DEFLATE tables and their temporary arrays.
const STREAM_TABLE_BYTES: i64 = 16384i64;

const CHUNK_IHDR: u32 = 1229472850;

const CHUNK_IDAT: u32 = 1229209940;

const CHUNK_IEND: u32 = 1229278788;

const CHUNK_TRNS: u32 = 1951551059;

const CHUNK_PLTE: u32 = 1347179589;

const CHUNK_ACTL: u32 = 1633899596;

const CHUNK_ICCP: u32 = 1766015824;

const CHUNK_GAMA: u32 = 1732332865;

const CHUNK_CHRM: u32 = 1665684045;

enum UnfilterError { InvalidFilter, Interrupted }

pub function default_row_limits(): RowLimits {
  return RowLimits { max_payload_bytes: 134217728i64, max_row_work: 134217728i64 };
}

function be32(input: [u8], at: i32): u32 {
  return input[at] as u32 << 24 | input[at + 1] as u32 << 16 | input[at + 2] as u32 << 8 | input[at + 3] as u32;
}

function predict(filter: i32, left: i32, above: i32, upper_left: i32): i32 {
  return filters.predict(filter, left, above, upper_left);
}

function reconstruct(filtered: [u8], layout: pixels.Layout): Result[pixels.Image, PngError] {
  let bytes = __alloc_u8(layout.bytes);
  let channels = pixels.channels(layout.format);
  for y in 0..layout.height {
    let start = y * (layout.stride + 1);
    let filter = filtered[start] as i32;
    if (filter > 4) {
      return Err(PngError.Scanline);
    }
    for x in 0..layout.stride {
      let at = y * layout.stride + x;
      let left = if (x >= channels) { bytes[at - channels] as i32 } else { 0 };
      let above = if (y > 0) { bytes[at - layout.stride] as i32 } else { 0 };
      let upper_left = if (y > 0 && x >= channels) { bytes[at - layout.stride - channels] as i32 } else { 0 };
      let prediction = predict(filter, left, above, upper_left);
      bytes = bytes.with(at, (filtered[start + 1 + x] as i32 + prediction) as u8);
    }
  }
  return Ok(pixels.Image { layout: layout, data: bytes });
}

function expanded_row(bytes: u8[], layout: pixels.Layout, scanline: EncodedRow, cancelled: () => boolean): Result[u8[], UnfilterError] {
  if let Some(table) = scanline.palette {
    return match (palette.expand_row(bytes, layout.width, table, layout.stride, cancelled)) {
      Ok(v) => Ok(v), Err(palette.Cancelled) => Err(UnfilterError.Interrupted), Err(_) => Err(UnfilterError.InvalidFilter),
    };
  }
  if (scanline.stride == layout.stride) {
    return Ok(bytes);
  }
  let output = __alloc_u8(layout.stride);
  let channels = pixels.channels(layout.format);
  for x in 0..layout.width {
    if (x % 64 == 0 && cancelled()) {
      return Err(UnfilterError.Interrupted);
    }
    let at = x * channels;
    if (scanline.channels == 3) {
      let red = bytes[x * 3];
      let green = bytes[x * 3 + 1];
      let blue = bytes[x * 3 + 2];
      output = output.with(at, red).with(at + 1, green).with(at + 2, blue).with(at + 3, transparency.rgb_alpha(scanline.key, red, green, blue));
    } else {
      let sample = gray_sample(bytes, x, scanline);
      let gray = (sample * 255 / ((1 << scanline.depth) - 1)) as u8;
      output = output.with(at, gray).with(at + 1, gray).with(at + 2, gray);
      if (channels == 4) {
        let explicit = if (scanline.channels == 2) { bytes[x * 2 + 1] } else { 255u8 };
        output = output.with(at + 3, transparency.gray_alpha(scanline.key, sample, explicit));
      }
    }
  }
  return Ok(output);
}

function gray_sample(bytes: [u8], x: i32, scanline: EncodedRow): i32 {
  if (scanline.depth == 8) {
    return bytes[x * scanline.channels] as i32;
  }
  let per_byte = 8 / scanline.depth;
  let shift = 8 - scanline.depth - x % per_byte * scanline.depth;
  let maximum = (1 << scanline.depth) - 1;
  return bytes[x / per_byte] as i32 >> shift & maximum;
}

function reconstruct_expanded(filtered: [u8], prepared: Prepared): Result[pixels.Image, PngError] {
  let layout = prepared.layout;
  let bytes = __alloc_u8(layout.bytes);
  let previous: u8[] = [];
  let never_cancel = (): boolean => false;
  for y in 0..layout.height {
    previous = match (unfilter_row(filtered, prepared.scanline, y, previous, never_cancel)) { Ok(v) => v, Err(_) => { return Err(PngError.Scanline); } };
    let row = match (expanded_row(previous, layout, prepared.scanline, never_cancel)) { Ok(v) => v, Err(_) => { return Err(PngError.Scanline); } };
    for x in 0..layout.stride {
      bytes = bytes.with(y * layout.stride + x, row[x]);
    }
  }
  return Ok(pixels.Image { layout: layout, data: bytes });
}

function copy_bytes(input: [u8]): u8[] {
  let output: u8[] = [];
  for byte in input {
    output = output.append(byte);
  }
  return output;
}

function plte_chunk(state: PaletteChunks, bytes: [u8], depth: i32): Result[PaletteChunks, PngError] {
  if (state.colors.len() != 0) {
    return Err(PngError.Order);
  }
  if (state.color_type == 0 || state.color_type == 4) {
    return Err(PngError.Unsupported);
  }
  if (bytes.len() == 0 || bytes.len() % 3 != 0 || bytes.len() > 768) {
    return Err(PngError.Length);
  }
  if (state.color_type == 3 && bytes.len() / 3 > 1 << depth) {
    return Err(PngError.Length);
  }
  return Ok(PaletteChunks { ...state, colors: copy_bytes(bytes) });
}

function alpha_chunk(state: PaletteChunks, bytes: [u8], depth: i32): Result[PaletteChunks, PngError] {
  if (state.color_type == 0 || state.color_type == 2) {
    let Some(key) = transparency.parse(bytes, state.color_type, depth) else {
      return Err(PngError.Length);
    };
    return Ok(PaletteChunks { ...state, key: key, has_alpha: true });
  }
  if (state.color_type != 3) {
    return Err(PngError.Unsupported);
  }
  if (state.colors.len() == 0) {
    return Err(PngError.Order);
  }
  if (bytes.len() > state.colors.len() / 3) {
    return Err(PngError.Length);
  }
  return Ok(PaletteChunks { ...state, alpha: copy_bytes(bytes), has_alpha: true });
}

function palette_chunk(state: PaletteChunks, kind: u32, bytes: [u8], data_seen: boolean, depth: i32): Result[PaletteChunks, PngError] {
  if (data_seen || state.has_alpha) {
    return Err(PngError.Order);
  }
  return if (kind == CHUNK_PLTE) { plte_chunk(state, bytes, depth) } else { alpha_chunk(state, bytes, depth) };
}

function alpha_layout(layout: pixels.Layout, limits: pixels.Limits): Result[pixels.Layout, PngError] {
  let Some(stride) = layout.width *? 4 else {
    return Err(PngError.Limit);
  };
  return match (pixels.checked_layout(layout.width, layout.height, stride, pixels.RGBA8, limits)) { Ok(v) => Ok(v), Err(_) => Err(PngError.Limit) };
}

function prepare(input: [u8], limits: pixels.Limits): Result[Prepared, PngError] {
  if (input.len() > 16777216) {
    return Err(PngError.Limit);
  }
  let signature: u8[] = [137, 80, 78, 71, 13, 10, 26, 10];
  if (input.len() < 8) {
    return Err(PngError.Signature);
  }
  for i in 0..8 {
    if (input[i] != signature[i]) {
      return Err(PngError.Signature);
    }
  }
  let layout = pixels.Layout { width: 0, height: 0, stride: 0, format: pixels.RGB8, bytes: 0 };
  let scanline = EncodedRow { channels: 0, stride: 0, depth: 8, palette: None, key: transparency.Opaque };
  let chunks = PaletteChunks { colors: [], alpha: [], has_alpha: false, color_type: 0, key: transparency.Opaque };
  let header = false;
  let interlaced = false;
  let data_seen = false;
  let data_closed = false;
  let compressed: u8[] = [];
  let pos = 8;
  let ended = false;
  let chunk_count = 0;
  while (pos < input.len()) {
    chunk_count += 1;
    if (chunk_count > 1024) {
      return Err(PngError.Limit);
    }
    if (input.len() - pos < 12) {
      return Err(PngError.Truncated);
    }
    let length_u = be32(input, pos);
    if (length_u > (input.len() - pos - 12) as u32) {
      return Err(PngError.Length);
    }
    let length = length_u as i32;
    let kind = be32(input, pos + 4);
    let body = pos + 8;
    let end = body + length;
    let actual = crc32.new().update(input[pos + 4:end]).finish();
    if (actual != be32(input, end)) {
      return Err(PngError.Crc);
    }
    for k in 0..4 {
      let letter = input[pos + 4 + k];
      if (!(letter >= b'A' && letter <= b'Z' || letter >= b'a' && letter <= b'z')) {
        return Err(PngError.Unsupported);
      }
    }
    if ((input[pos + 6] as i32 & 32) != 0) {
      return Err(PngError.Unsupported);
    }
    if (!header && kind != CHUNK_IHDR) {
      return Err(PngError.Order);
    }
    if (kind == CHUNK_IHDR) {
      if (header || pos != 8 || length != 13) {
        return Err(PngError.Order);
      }
      let w = be32(input, body);
      let h = be32(input, body + 4);
      if (w == 0 || h == 0 || w > 2147483647 || h > 2147483647) {
        return Err(PngError.Dimensions);
      }
      let color_type = input[body + 9] as i32;
      let channels = match (color_type) { 0 => 1, 2 => 3, 3 => 1, 4 => 2, 6 => 4, _ => { return Err(PngError.Unsupported); } };
      chunks = PaletteChunks { ...chunks, color_type: color_type };
      let format = if (channels == 2 || channels == 4) { pixels.RGBA8 } else { pixels.RGB8 };
      let depth = input[body + 8] as i32;
      let packed_gray = channels == 1 && (depth == 1 || depth == 2 || depth == 4);
      if (!packed_gray && depth != 8 || input[body + 10] != 0 || input[body + 11] != 0 || input[body + 12] > 1) {
        return Err(PngError.Unsupported);
      }
      let Some(stride) = w as i32 *? pixels.channels(format) else {
        return Err(PngError.Limit);
      };
      layout = match (pixels.checked_layout(w as i32, h as i32, stride, format, limits)) { Ok(v) => v, Err(_) => { return Err(PngError.Limit); } };
      let wire_stride = (w as i64 * (channels as i64) * (depth as i64) + 7i64) / 8i64;
      scanline = EncodedRow { channels: channels, stride: wire_stride as i32, depth: depth, palette: None, key: transparency.Opaque };
      interlaced = input[body + 12] == 1;
      header = true;
    } else if (kind == CHUNK_PLTE || kind == CHUNK_TRNS) {
      chunks = palette_chunk(chunks, kind, input[body:end], data_seen, scanline.depth)?;
      if (kind == CHUNK_TRNS) {
        layout = alpha_layout(layout, limits)?;
      }
    } else if (kind == CHUNK_IDAT) {
      if (data_closed) {
        return Err(PngError.Order);
      }
      if (chunks.color_type == 3 && chunks.colors.len() == 0) {
        return Err(PngError.Order);
      }
      for j in body..end {
        compressed = compressed.append(input[j]);
      }
      data_seen = true;
    } else if (kind == CHUNK_IEND) {
      if (!data_seen || length != 0 || end + 4 != input.len()) {
        return Err(PngError.Order);
      }
      ended = true;
      pos = end + 4;
      break;
    } else {
      if (data_seen) {
        data_closed = true;
      }
      // Reject unsupported color and animation semantics.
      if ((input[pos + 4] as i32 & 32) == 0 || kind == CHUNK_TRNS || kind == CHUNK_ACTL || kind == CHUNK_ICCP || kind == CHUNK_GAMA || kind == CHUNK_CHRM) {
        return Err(PngError.Unsupported);
      }
    }
    pos = end + 4;
  }
  if (!header || !ended) {
    return Err(PngError.Order);
  }
  if (chunks.color_type == 3) {
    let table = match (palette.prepare(chunks.colors, chunks.alpha, chunks.has_alpha, scanline.depth, (): boolean => false)) { Ok(v) => v, Err(_) => { return Err(PngError.Length); } };
    scanline = EncodedRow { ...scanline, palette: Some(table) };
  }
  scanline = EncodedRow { ...scanline, key: chunks.key };
  return finish_prepare(layout, scanline, compressed, interlaced, limits);
}

function finish_prepare(layout: pixels.Layout, scanline: EncodedRow, compressed: u8[], interlaced: boolean, limits: pixels.Limits): Result[Prepared, PngError] {
  if (interlaced) {
    let maximum = if (limits.max_bytes < 67108864) { limits.max_bytes } else { 67108864 };
    let passes = match (adam7.plan(layout.width, layout.height, scanline.channels * scanline.depth, maximum)) { Ok(v) => v, Err(_) => { return Err(PngError.Limit); } };
    return Ok(Prepared { layout: layout, scanline: scanline, compressed: compressed, filtered_bytes: passes.bytes, passes: Some(passes) });
  }
  let Some(filtered_size) = scanline.stride +? 1 else {
    return Err(PngError.Limit);
  };
  let Some(total) = filtered_size *? layout.height else {
    return Err(PngError.Limit);
  };
  if (total > limits.max_bytes || total > 67108864) {
    return Err(PngError.Limit);
  }
  return Ok(Prepared { layout: layout, scanline: scanline, compressed: compressed, filtered_bytes: total, passes: None });
}

function inflate_prepared(prepared: Prepared): Result[u8[], PngError] {
  let filtered = match (compression.decode(prepared.compressed, prepared.filtered_bytes)) { Ok(v) => v, Err(_) => { return Err(PngError.Compressed); } };
  if (filtered.len() != prepared.filtered_bytes) {
    return Err(PngError.Scanline);
  }
  return Ok(filtered);
}

pub function decode(input: [u8], limits: pixels.Limits): Result[pixels.Image, PngError] {
  let prepared = prepare(input, limits)?;
  let layout = prepared.layout;
  let filtered = inflate_prepared(prepared)?;
  if let Some(plan) = prepared.passes {
    return reconstruct_adam7(filtered, prepared, plan);
  }
  if (prepared.scanline.stride != layout.stride) {
    return reconstruct_expanded(filtered, prepared);
  }
  return reconstruct(filtered, layout);
}

function unfilter_row(filtered: [u8], scanline: EncodedRow, y: i32, previous: [u8], cancelled: () => boolean): Result[u8[], UnfilterError] {
  let start = y * (scanline.stride + 1);
  let filter = filtered[start] as i32;
  if (filter > 4) {
    return Err(UnfilterError.InvalidFilter);
  }
  let bytes = __alloc_u8(scanline.stride);
  let channels = scanline.channels;
  for x in 0..scanline.stride {
    if (x % 256 == 0 && cancelled()) {
      return Err(UnfilterError.Interrupted);
    }
    let left = if (x >= channels) { bytes[x - channels] as i32 } else { 0 };
    let above = if (y > 0) { previous[x] as i32 } else { 0 };
    let upper_left = if (y > 0 && x >= channels) { previous[x - channels] as i32 } else { 0 };
    let prediction = predict(filter, left, above, upper_left);
    bytes = bytes.with(x, (filtered[start + 1 + x] as i32 + prediction) as u8);
  }
  return Ok(bytes);
}

function expansion_stride(prepared: Prepared): i64 {
  return if (prepared.scanline.stride == prepared.layout.stride) { 0i64 } else { prepared.layout.stride as i64 };
}

function row_scratch(prepared: Prepared): i64 {
  let encoded_and_output = 2i64 * (prepared.scanline.stride as i64) + expansion_stride(prepared);
  let graph_rows = 2i64 * (prepared.layout.stride as i64);
  return if (encoded_and_output > graph_rows) { encoded_and_output } else { graph_rows };
}

function palette_payload(prepared: Prepared): i64 {
  return match (prepared.scanline.palette) { Some(table) => table.rgba.len() as i64, None => 0i64 };
}

function palette_work(prepared: Prepared): i64 {
  return match (prepared.scanline.palette) { Some(_) => prepared.layout.height as i64 * (prepared.scanline.stride as i64 + prepared.layout.width as i64), None => 0i64 };
}

function palette_error(error: palette.PaletteError): DecoderError {
  return match (error) { palette.Cancelled => DecoderCancelled, _ => DecoderCodec(PngError.Scanline) };
}

function validate_indexed(filtered: [u8], prepared: Prepared, cancelled: () => boolean): Result[void, DecoderError] {
  if let Some(table) = prepared.scanline.palette {
    match (indexed_validation.chunk(indexed_validation.initial(), filtered, prepared.layout.width, prepared.scanline.stride, table, cancelled)) {
      Ok(_) => {},
      Err(e) => {
        return Err(palette_error(e));
      }
    }
  }
  return Ok(());
}

function prepare_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits): Result[Prepared, DecoderError] {
  if (row_limits.max_payload_bytes <= 0i64 || row_limits.max_row_work <= 0i64
    || 2i64 * (input.len() as i64) > row_limits.max_payload_bytes) {
    return Err(DecoderBudget);
  }
  let prepared = match (prepare(input, limits)) { Ok(v) => v, Err(e) => { return Err(DecoderCodec(e)); } };
  if let Some(_) = prepared.passes {
    return Err(DecoderCodec(PngError.Unsupported));
  }
  return Ok(prepared);
}

function scatter_pass(own bytes: u8[], row: [u8], layout: pixels.Layout, pass: adam7.Pass, y: i32): u8[] {
  let channels = pixels.channels(layout.format);
  for x in 0..pass.width {
    let at = (pass.y + y * pass.dy) * layout.stride + (pass.x + x * pass.dx) * channels;
    for c in 0..channels {
      bytes = bytes.with(at + c, row[x * channels + c]);
    }
  }
  return bytes;
}

function reconstruct_adam7(filtered: [u8], prepared: Prepared, plan: adam7.Plan): Result[pixels.Image, PngError] {
  let layout = prepared.layout;
  let bytes = __alloc_u8(layout.bytes);
  let never = (): boolean => false;
  for pass in plan.passes {
    if (pass.bytes != 0) {
      let stride = pass.width * pixels.channels(layout.format);
      let reduced = pixels.Layout { ...layout, width: pass.width, height: 1, stride: stride, bytes: stride };
      let scanline = EncodedRow { ...prepared.scanline, stride: pass.stride };
      let previous: u8[] = [];
      let input = filtered[pass.offset:pass.offset + pass.bytes];
      for y in 0..pass.height {
        previous = match (unfilter_row(input, scanline, y, previous, never)) { Ok(v) => v, Err(_) => { return Err(PngError.Scanline); } };
        let row = match (expanded_row(previous, reduced, scanline, never)) { Ok(v) => v, Err(_) => { return Err(PngError.Scanline); } };
        bytes = scatter_pass(bytes, row, layout, pass, y);
      }
    }
  }
  return Ok(pixels.Image { layout: layout, data: bytes });
}

function plan_prepared(prepared: Prepared, input_bytes: i32, first: i32, count: i32, row_limits: RowLimits): Result[RowPlan, DecoderError] {
  let layout = prepared.layout;
  if (first < 0 || count <= 0 || first >= layout.height || count > layout.height - first) {
    return Err(DecoderBounds);
  }
  let scratch = row_scratch(prepared);
  let payload = 2i64 * (input_bytes as i64) + prepared.filtered_bytes as i64 + scratch + palette_payload(prepared);
  let work = layout.height as i64 + (first as i64 + count as i64) * (prepared.scanline.stride as i64) + count as i64 * expansion_stride(prepared) + palette_work(prepared);
  if (payload > row_limits.max_payload_bytes || work > row_limits.max_row_work) {
    return Err(DecoderBudget);
  }
  return Ok(RowPlan {
    layout: layout, first: first, count: count, filtered_bytes: prepared.filtered_bytes,
    row_scratch_bytes: scratch, payload_bytes: payload, row_work: work,
  });
}

pub function inspect_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits): Result[RowPlan, DecoderError] {
  let prepared = prepare_rows(input, limits, row_limits)?;
  return plan_prepared(prepared, input.len(), 0, prepared.layout.height, row_limits);
}

function open_prepared(prepared: Prepared, plan: RowPlan, cancelled: () => boolean): Result[RowDecoder, DecoderError] {
  if (cancelled()) {
    return Err(DecoderCancelled);
  }
  let layout = plan.layout;
  let scanline = prepared.scanline;
  let filtered = match (inflate_prepared(prepared)) { Ok(v) => v, Err(e) => { return Err(DecoderCodec(e)); } };
  for y in 0..layout.height {
    if (y % 64 == 0 && cancelled()) {
      return Err(DecoderCancelled);
    }
    if (filtered[y * (scanline.stride + 1)] > 4) {
      return Err(DecoderCodec(PngError.Scanline));
    }
  }
  validate_indexed(filtered, prepared, cancelled)?;
  let state = cell_new(RowCursor { next: 0, previous: [] });
  let read = (y: i32, cancelled: () => boolean): Result[pixels.Image, DecoderError] => {
    if (cancelled()) {
      return Err(DecoderCancelled);
    }
    if (y < plan.first || y >= plan.first + plan.count) {
      return Err(DecoderBounds);
    }
    let cursor = state.get();
    if (y < cursor.next - 1) {
      return Err(DecoderAccess);
    }
    while (cursor.next <= y) {
      let bytes = match (unfilter_row(filtered, scanline, cursor.next, cursor.previous, cancelled)) { Ok(v) => v, Err(UnfilterError.InvalidFilter) => { return Err(DecoderCodec(PngError.Scanline)); }, Err(UnfilterError.Interrupted) => { return Err(DecoderCancelled); } };
      cursor = RowCursor { next: cursor.next + 1, previous: bytes };
      state.set(cursor);
    }
    if (cancelled()) {
      return Err(DecoderCancelled);
    }
    let row = match (expanded_row(cursor.previous, layout, scanline, cancelled)) { Ok(v) => v, Err(UnfilterError.Interrupted) => { return Err(DecoderCancelled); }, Err(_) => { return Err(DecoderCodec(PngError.Scanline)); } };
    return Ok(pixels.Image { layout: pixels.Layout { ...layout, height: 1, bytes: layout.stride }, data: row });
  };
  return Ok(RowDecoder { plan: plan, read: read });
}

pub function open_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits, cancelled: () => boolean): Result[RowDecoder, DecoderError] {
  if (cancelled()) {
    return Err(DecoderCancelled);
  }
  let prepared = prepare_rows(input, limits, row_limits)?;
  let plan = plan_prepared(prepared, input.len(), 0, prepared.layout.height, row_limits)?;
  return open_prepared(prepared, plan, cancelled);
}

function incremental_plan(prepared: Prepared, input_bytes: i32, first: i32, count: i32, limits: RowLimits): Result[RowPlan, DecoderError] {
  let layout = prepared.layout;
  if (first < 0 || count <= 0 || first >= layout.height || count > layout.height - first) {
    return Err(DecoderBounds);
  }
  let window = if (prepared.filtered_bytes > 32768) { 32768 } else { prepared.filtered_bytes };
  let scratch = row_scratch(prepared) + window as i64 + 1i64;
  let payload = 3i64 * (input_bytes as i64) + window as i64 + STREAM_TABLE_BYTES + scratch + palette_payload(prepared);
  let work = input_bytes as i64 + prepared.filtered_bytes as i64 + (first as i64 + count as i64) * (2i64 * (prepared.scanline.stride as i64) + 1i64) + count as i64 * expansion_stride(prepared) + palette_work(prepared);
  if (payload > limits.max_payload_bytes || work > limits.max_row_work) {
    return Err(DecoderBudget);
  }
  return Ok(RowPlan {
    layout: layout, first: first, count: count, filtered_bytes: prepared.filtered_bytes,
    row_scratch_bytes: scratch, payload_bytes: payload, row_work: work,
  });
}

pub function inspect_incremental_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits): Result[RowPlan, DecoderError] {
  let prepared = prepare_rows(input, limits, row_limits)?;
  return incremental_plan(prepared, input.len(), 0, prepared.layout.height, row_limits);
}

function stream_error(error: deflate.InflateReadError): DecoderError {
  return match (error) { deflate.ReadCancelled => DecoderCancelled, _ => DecoderCodec(PngError.Compressed) };
}

function adler_append(checksum: u32, bytes: [u8]): u32 {
  let part = deflate.adler32(bytes);
  let a = (checksum & 65535) as i64;
  let b = (checksum >> 16) as i64;
  let next_a = (a + (part & 65535) as i64 + 65520i64) % 65521i64;
  let next_b = (b + (part >> 16) as i64 + bytes.len() as i64 * ((a + 65520i64) % 65521i64)) % 65521i64;
  return next_b as u32 << 16 | next_a as u32;
}

function validate_stream(raw: u8[], prepared: Prepared, cancelled: () => boolean): Result[boolean, DecoderError] {
  let reader = match (deflate.inflate_reader(raw, prepared.filtered_bytes)) { Ok(v) => v, Err(e) => { return Err(stream_error(e)); } };
  let checksum: u32 = 1;
  let at = 0;
  let invalid_filter = false;
  let indexed = indexed_validation.initial();
  let indexed_error: Option[DecoderError] = None;
  loop {
    let chunk = match (reader.read(32768, cancelled)) { Ok(v) => v, Err(e) => { return Err(stream_error(e)); } };
    checksum = adler_append(checksum, chunk.bytes);
    if let Some(table) = prepared.scanline.palette {
      if (indexed_error == None) {
        match (indexed_validation.chunk(indexed, chunk.bytes, prepared.layout.width, prepared.scanline.stride, table, cancelled)) {
          Ok(v) => {
            indexed = v;
          },
          Err(palette.Cancelled) => {
            return Err(DecoderCancelled);
          },
          Err(e) => {
            indexed_error = Some(palette_error(e));
          }
        }
      }
      at += chunk.bytes.len();
    } else {
      for byte in chunk.bytes {
        if (at % (prepared.scanline.stride + 1) == 0 && byte > 4) {
          invalid_filter = true;
        }
        at += 1;
        if (at % 256 == 0 && cancelled()) {
          return Err(DecoderCancelled);
        }
      }
    }
    if (chunk.done && chunk.consumed != raw.len()) {
      return Err(DecoderCodec(PngError.Compressed));
    }
    if (chunk.done) {
      break;
    }
  }
  if (checksum != be32(prepared.compressed, prepared.compressed.len() - 4)) {
    return Err(DecoderCodec(PngError.Compressed));
  }
  if (at != prepared.filtered_bytes || invalid_filter) {
    return Err(DecoderCodec(PngError.Scanline));
  }
  if let Some(error) = indexed_error {
    return Err(error);
  }
  return Ok(true);
}

function stream_bytes(reader: deflate.InflateReader, count: i32, cancelled: () => boolean): Result[u8[], DecoderError] {
  let chunk = match (reader.read(count, cancelled)) { Ok(v) => v, Err(e) => { return Err(stream_error(e)); } };
  if (chunk.bytes.len() != count) {
    return Err(DecoderCodec(PngError.Scanline));
  }
  return Ok(chunk.bytes);
}

function unfilter_stream_row(reader: deflate.InflateReader, scanline: EncodedRow, y: i32, previous: [u8], cancelled: () => boolean): Result[u8[], DecoderError] {
  let tag = stream_bytes(reader, 1, cancelled)?;
  let filter = tag[0] as i32;
  if (filter > 4) {
    return Err(DecoderCodec(PngError.Scanline));
  }
  let bytes = __alloc_u8(scanline.stride);
  let channels = scanline.channels;
  let x = 0;
  while (x < scanline.stride) {
    let count = if (scanline.stride - x > 32768) { 32768 } else { scanline.stride - x };
    let chunk = stream_bytes(reader, count, cancelled)?;
    for byte in chunk {
      if (x % 256 == 0 && cancelled()) {
        return Err(DecoderCancelled);
      }
      let left = if (x >= channels) { bytes[x - channels] as i32 } else { 0 };
      let above = if (y > 0) { previous[x] as i32 } else { 0 };
      let upper_left = if (y > 0 && x >= channels) { previous[x - channels] as i32 } else { 0 };
      bytes = bytes.with(x, (byte as i32 + predict(filter, left, above, upper_left)) as u8);
      x += 1;
    }
  }
  return Ok(bytes);
}

function stream_failure(cursor: StreamCursor, error: DecoderError, terminal: boolean): StreamRead {
  let next = if (terminal) { StreamCursor { ...cursor, failure: Some(error) } } else { cursor };
  return StreamRead { cursor: next, result: Err(error) };
}

function stream_read(cursor: StreamCursor, reader: deflate.InflateReader, plan: RowPlan, scanline: EncodedRow, y: i32, cancelled: () => boolean): StreamRead {
  if let Some(error) = cursor.failure {
    return stream_failure(cursor, error, false);
  }
  if (cancelled()) {
    return stream_failure(cursor, DecoderCancelled, true);
  }
  if (y < plan.first || y >= plan.first + plan.count) {
    return stream_failure(cursor, DecoderBounds, false);
  }
  if (y < cursor.next - 1) {
    return stream_failure(cursor, DecoderAccess, false);
  }
  let cursor = cursor;
  while (cursor.next <= y) {
    let row = match (unfilter_stream_row(reader, scanline, cursor.next, cursor.previous, cancelled)) { Ok(v) => v, Err(e) => { return stream_failure(cursor, e, true); } };
    cursor = StreamCursor { ...cursor, next: cursor.next + 1, previous: row };
  }
  if (cancelled()) {
    return stream_failure(cursor, DecoderCancelled, true);
  }
  let row = match (expanded_row(cursor.previous, plan.layout, scanline, cancelled)) { Ok(v) => v, Err(UnfilterError.Interrupted) => { return stream_failure(cursor, DecoderCancelled, true); }, Err(_) => { return stream_failure(cursor, DecoderCodec(PngError.Scanline), true); } };
  let image = pixels.Image { layout: pixels.Layout { ...plan.layout, height: 1, bytes: plan.layout.stride }, data: row };
  return StreamRead { cursor: cursor, result: Ok(image) };
}

function open_incremental_prepared(prepared: Prepared, plan: RowPlan, cancelled: () => boolean): Result[RowDecoder, DecoderError] {
  if (cancelled()) {
    return Err(DecoderCancelled);
  }
  if let Some(_) = compression.header_error(prepared.compressed, prepared.filtered_bytes) {
    return Err(DecoderCodec(PngError.Compressed));
  }
  let raw: u8[] = [];
  for i in 2..prepared.compressed.len() - 4 {
    if (i % 256 == 0 && cancelled()) {
      return Err(DecoderCancelled);
    }
    raw = raw.append(prepared.compressed[i]);
  }
  validate_stream(raw, prepared, cancelled)?;
  let reader = match (deflate.inflate_reader(raw, prepared.filtered_bytes)) { Ok(v) => v, Err(e) => { return Err(stream_error(e)); } };
  let scanline = prepared.scanline;
  let state: Cell[Option[StreamCursor]] = cell_new(Some(StreamCursor { next: 0, previous: [], failure: None }));
  let read = (y: i32, cancelled: () => boolean): Result[pixels.Image, DecoderError] => {
    let Some(cursor) = state.get() else {
      return Err(DecoderAccess);
    };
    state.set(None);
    let result = stream_read(cursor, reader, plan, scanline, y, cancelled);
    state.set(Some(result.cursor));
    return result.result;
  };
  return Ok(RowDecoder { plan: plan, read: read });
}

pub function open_incremental_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits, cancelled: () => boolean): Result[RowDecoder, DecoderError] {
  if (cancelled()) {
    return Err(DecoderCancelled);
  }
  let prepared = prepare_rows(input, limits, row_limits)?;
  let plan = incremental_plan(prepared, input.len(), 0, prepared.layout.height, row_limits)?;
  return open_incremental_prepared(prepared, plan, cancelled);
}

function fold_error[E](error: DecoderError): RowError[E] {
  return match (error) { DecoderCodec(e) => RowCodec(e), DecoderBounds => RowBounds, DecoderBudget => RowBudget, DecoderCancelled => RowCancelled, DecoderAccess => RowBounds };
}

pub function fold_rows[S, E](input: [u8], first: i32, count: i32, limits: pixels.Limits, row_limits: RowLimits, cancelled: () => boolean, value: S, consume: (S, pixels.Image) => Result[S, E]): Result[RowFold[S], RowError[E]] {
  if (cancelled()) {
    return Err(RowCancelled);
  }
  let prepared = match (prepare_rows(input, limits, row_limits)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  let plan = match (plan_prepared(prepared, input.len(), first, count, row_limits)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  let decoder = match (open_prepared(prepared, plan, cancelled)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  return fold_decoder[S, E](decoder, cancelled, value, consume);
}

pub function fold_incremental_rows[S, E](input: [u8], first: i32, count: i32, limits: pixels.Limits, row_limits: RowLimits, cancelled: () => boolean, value: S, consume: (S, pixels.Image) => Result[S, E]): Result[RowFold[S], RowError[E]] {
  if (cancelled()) {
    return Err(RowCancelled);
  }
  let prepared = match (prepare_rows(input, limits, row_limits)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  let plan = match (incremental_plan(prepared, input.len(), first, count, row_limits)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  let decoder = match (open_incremental_prepared(prepared, plan, cancelled)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  return fold_decoder[S, E](decoder, cancelled, value, consume);
}

function fold_decoder[S, E](decoder: RowDecoder, cancelled: () => boolean, value: S, consume: (S, pixels.Image) => Result[S, E]): Result[RowFold[S], RowError[E]] {
  let plan = decoder.plan;
  let value = value;
  for y in plan.first..plan.first + plan.count {
    let row = match (decoder.read(y, cancelled)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
    value = match (consume(value, row)) { Ok(v) => v, Err(e) => { return Err(RowConsumer(e)); } };
    if (cancelled()) {
      return Err(RowCancelled);
    }
  }
  return Ok(RowFold[S] { value: value, plan: plan });
}

function append32(bytes: u8[], n: u32): u8[] {
  return bytes.append((n >> 24) as u8).append((n >> 16) as u8).append((n >> 8) as u8).append(n as u8);
}

function chunk(output: u8[], kind: u32, body: [u8]): u8[] {
  let type_bytes = append32([], kind);
  let crc = crc32.new().update(type_bytes).update(body).finish();
  let bytes = append32(output, body.len() as u32);
  bytes = append32(bytes, kind);
  for b in body {
    bytes = bytes.append(b);
  }
  return append32(bytes, crc);
}

pub function encode(image: pixels.Image, max_bytes: i32): Result[u8[], PngError] {
  if (max_bytes <= 0 || max_bytes > 16777216) {
    return Err(PngError.Limit);
  }
  if let Err(_) = pixels.read_pixel(image, 0, 0) {
    return Err(PngError.Dimensions);
  }
  let channels = pixels.channels(image.layout.format);
  let row = image.layout.width * channels;
  let Some(filtered_size) = (row + 1) *? image.layout.height else {
    return Err(PngError.Limit);
  };
  if (filtered_size > 16777216) {
    return Err(PngError.Limit);
  }
  let raw: u8[] = [];
  for y in 0..image.layout.height {
    raw = raw.append(0);
    for x in 0..row {
      raw = raw.append(image.data[y * image.layout.stride + x]);
    }
  }
  let compressed = deflate.deflate(raw);
  let checksum = deflate.adler32(raw);
  let zlib = [120, 156];
  for b in compressed {
    zlib = zlib.append(b);
  }
  zlib = append32(zlib, checksum);
  // The signature and the three chunk envelopes require 57 bytes.
  if (zlib.len() > max_bytes - 57) {
    return Err(PngError.Limit);
  }
  let header = append32(append32([], image.layout.width as u32), image.layout.height as u32);
  header = header.append(8);
  let color_type = if (channels == 4) { 6 } else { 2 };
  header = header.append(color_type).append(0).append(0).append(0);
  let output = [137, 80, 78, 71, 13, 10, 26, 10];
  output = chunk(output, CHUNK_IHDR, header);
  output = chunk(output, CHUNK_IDAT, zlib);
  return Ok(chunk(output, CHUNK_IEND, []));
}
