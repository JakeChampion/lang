import "../../pixels/pixels";
import "./compression";
import "std/hash/crc32";
import "std/deflate";
import "core/cmp";

@derive(cmp.Debug, cmp.Eq)
pub enum PngError { Signature, Truncated, Length, Crc, Order, Unsupported, Dimensions, Limit, Compressed, Scanline }

struct Prepared { layout: pixels.Layout, compressed: u8[], filtered_bytes: i32 }

pub struct RowLimits { max_payload_bytes: i64, max_row_work: i64 }

pub struct RowPlan {
  layout: pixels.Layout,
  first: i32,
  count: i32,
  filtered_bytes: i32,
  row_scratch_bytes: i64,
  payload_bytes: i64,
  row_work: i64,
}

pub enum RowError[E] { RowCodec(PngError), RowBounds, RowBudget, RowCancelled, RowConsumer(E) }

pub struct RowFold[S] { value: S, plan: RowPlan }

@derive(cmp.Eq)
pub enum DecoderError { DecoderCodec(PngError), DecoderBounds, DecoderBudget, DecoderCancelled, DecoderAccess }

pub struct RowDecoder { plan: RowPlan, read: (i32, () => boolean) => Result[pixels.Image, DecoderError] }

struct RowCursor { next: i32, previous: u8[] }

struct StreamCursor { next: i32, previous: u8[], failure: Option[DecoderError] }

struct StreamRead { cursor: StreamCursor, result: Result[pixels.Image, DecoderError] }

// Logical allowance for bounded DEFLATE tables and their temporary arrays.
const STREAM_TABLE_BYTES: i64 = 16384i64;

enum UnfilterError { InvalidFilter, Interrupted }

pub function default_row_limits(): RowLimits {
  return RowLimits { max_payload_bytes: 134217728i64, max_row_work: 134217728i64 };
}

function be32(input: [u8], at: i32): u32 {
  return input[at] as u32 << 24 | input[at + 1] as u32 << 16 | input[at + 2] as u32 << 8 | input[at + 3] as u32;
}

function absolute(n: i32): i32 {
  if (n < 0) {
    return 0 - n;
  }
  return n;
}

function paeth(a: i32, b: i32, c: i32): i32 {
  let p = a + b - c;
  let da = absolute(p - a);
  let db = absolute(p - b);
  let dc = absolute(p - c);
  if (da <= db && da <= dc) {
    return a;
  }
  if (db <= dc) {
    return b;
  }
  return c;
}

function predict(filter: i32, left: i32, above: i32, upper_left: i32): i32 {
  return match (filter) { 1 => left, 2 => above, 3 => (left + above) / 2, 4 => paeth(left, above, upper_left), _ => 0 };
}

function reconstruct(filtered: [u8], layout: pixels.Layout): Result[pixels.Image, PngError] {
  let bytes: u8[] = __alloc_u8(layout.bytes);
  let channels = pixels.channels(layout.format);
  let y = 0;
  while (y < layout.height) {
    let start = y * (layout.stride + 1);
    let filter = filtered[start] as i32;
    if (filter > 4) {
      return Err(PngError.Scanline);
    }
    let x = 0;
    while (x < layout.stride) {
      let at = y * layout.stride + x;
      let left = 0;
      let above = 0;
      let upper_left = 0;
      if (x >= channels) {
        left = bytes[at - channels] as i32;
      }
      if (y > 0) {
        above = bytes[at - layout.stride] as i32;
      }
      if (y > 0 && x >= channels) {
        upper_left = bytes[at - layout.stride - channels] as i32;
      }
      let prediction = predict(filter, left, above, upper_left);
      bytes = bytes.with(at, (filtered[start + 1 + x] as i32 + prediction) as u8);
      x = x + 1;
    }
    y = y + 1;
  }
  return Ok(pixels.Image { layout: layout, data: bytes });
}

function prepare(input: [u8], limits: pixels.Limits): Result[Prepared, PngError] {
  if (input.len() > 16777216) {
    return Err(PngError.Limit);
  }
  let signature: u8[] = [137 as u8, 80 as u8, 78 as u8, 71 as u8, 13 as u8, 10 as u8, 26 as u8, 10 as u8];
  if (input.len() < 8) {
    return Err(PngError.Signature);
  }
  let i = 0;
  while (i < 8) {
    if (input[i] != signature[i]) {
      return Err(PngError.Signature);
    }
    i = i + 1;
  }
  let layout = pixels.Layout { width: 0, height: 0, stride: 0, format: pixels.RGB8, bytes: 0 };
  let header = false;
  let data_seen = false;
  let data_closed = false;
  let compressed: u8[] = [];
  let pos = 8;
  let ended = false;
  let chunk_count = 0;
  while (pos < input.len()) {
    chunk_count = chunk_count + 1;
    if (chunk_count > 1024) {
      return Err(PngError.Limit);
    }
    if (input.len() - pos < 12) {
      return Err(PngError.Truncated);
    }
    let length_u = be32(input, pos);
    if (length_u > (input.len() - pos - 12) as u32) {
      return Err(PngError.Length);
    }
    let length = length_u as i32;
    let kind = be32(input, pos + 4);
    let body = pos + 8;
    let end = body + length;
    let actual = crc32.new().update(input[pos + 4:end]).finish();
    if (actual != be32(input, end)) {
      return Err(PngError.Crc);
    }
    let k = 0;
    while (k < 4) {
      let letter = input[pos + 4 + k] as i32;
      if (!(letter >= 65 && letter <= 90 || letter >= 97 && letter <= 122)) {
        return Err(PngError.Unsupported);
      }
      k = k + 1;
    }
    if ((input[pos + 6] as i32 & 32) != 0) {
      return Err(PngError.Unsupported);
    }
    if (!header && kind != 1229472850 as u32) {
      return Err(PngError.Order);
    }
    if (kind == 1229472850 as u32) {
      if (header || pos != 8 || length != 13) {
        return Err(PngError.Order);
      }
      let w = be32(input, body);
      let h = be32(input, body + 4);
      if (w == 0 as u32 || h == 0 as u32 || w > 2147483647 as u32 || h > 2147483647 as u32) {
        return Err(PngError.Dimensions);
      }
      let format = pixels.RGB8;
      if (input[body + 9] == 6 as u8) {
        format = pixels.RGBA8;
      } else if (input[body + 9] != 2 as u8) {
        return Err(PngError.Unsupported);
      }
      if (input[body + 8] != 8 as u8 || input[body + 10] != 0 as u8 || input[body + 11] != 0 as u8 || input[body + 12] != 0 as u8) {
        return Err(PngError.Unsupported);
      }
      let stride = match (w as i32 *? pixels.channels(format)) { Some(v) => v, None => { return Err(PngError.Limit); } };
      layout = match (pixels.checked_layout(w as i32, h as i32, stride, format, limits)) { Ok(v) => v, Err(_) => { return Err(PngError.Limit); } };
      header = true;
    } else if (kind == 1229209940 as u32) {
      if (data_closed) {
        return Err(PngError.Order);
      }
      let j = body;
      while (j < end) {
        compressed = compressed.append(input[j]);
        j = j + 1;
      }
      data_seen = true;
    } else if (kind == 1229278788 as u32) {
      if (!data_seen || length != 0 || end + 4 != input.len()) {
        return Err(PngError.Order);
      }
      ended = true;
      pos = end + 4;
      break;
    } else {
      if (data_seen) {
        data_closed = true;
      }
      // Reject transparency and animation rather than silently discard their semantics.
      if ((input[pos + 4] as i32 & 32) == 0 || kind == 1951551059 as u32 || kind == 1633899596 as u32 || kind == 1766015824 as u32 || kind == 1732332865 as u32 || kind == 1665684045 as u32) {
        return Err(PngError.Unsupported);
      }
    }
    pos = end + 4;
  }
  if (!header || !ended) {
    return Err(PngError.Order);
  }
  let filtered_size = match (layout.stride +? 1) { Some(v) => v, None => { return Err(PngError.Limit); } };
  let total = match (filtered_size *? layout.height) { Some(v) => v, None => { return Err(PngError.Limit); } };
  if (total > limits.max_bytes || total > 67108864) {
    return Err(PngError.Limit);
  }
  return Ok(Prepared { layout: layout, compressed: compressed, filtered_bytes: total });
}

function inflate_prepared(prepared: Prepared): Result[u8[], PngError] {
  let filtered = match (compression.decode(prepared.compressed, prepared.filtered_bytes)) { Ok(v) => v, Err(_) => { return Err(PngError.Compressed); } };
  if (filtered.len() != prepared.filtered_bytes) {
    return Err(PngError.Scanline);
  }
  return Ok(filtered);
}

pub function decode(input: [u8], limits: pixels.Limits): Result[pixels.Image, PngError] {
  let prepared = prepare(input, limits)?;
  let layout = prepared.layout;
  let filtered = inflate_prepared(prepared)?;
  return reconstruct(filtered, layout);
}

function unfilter_row(filtered: [u8], layout: pixels.Layout, y: i32, previous: [u8], cancelled: () => boolean): Result[u8[], UnfilterError] {
  let start = y * (layout.stride + 1);
  let filter = filtered[start] as i32;
  if (filter > 4) {
    return Err(UnfilterError.InvalidFilter);
  }
  let bytes = __alloc_u8(layout.stride);
  let channels = pixels.channels(layout.format);
  let x = 0;
  while (x < layout.stride) {
    if (x % 256 == 0 && cancelled()) {
      return Err(UnfilterError.Interrupted);
    }
    let left = 0;
    let above = 0;
    let upper_left = 0;
    if (x >= channels) {
      left = bytes[x - channels] as i32;
    }
    if (y > 0) {
      above = previous[x] as i32;
    }
    if (y > 0 && x >= channels) {
      upper_left = previous[x - channels] as i32;
    }
    let prediction = predict(filter, left, above, upper_left);
    bytes = bytes.with(x, (filtered[start + 1 + x] as i32 + prediction) as u8);
    x = x + 1;
  }
  return Ok(bytes);
}

function prepare_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits): Result[Prepared, DecoderError] {
  if (row_limits.max_payload_bytes <= 0i64 || row_limits.max_row_work <= 0i64
    || 2i64 * (input.len() as i64) > row_limits.max_payload_bytes) {
    return Err(DecoderBudget);
  }
  return match (prepare(input, limits)) { Ok(v) => Ok(v), Err(e) => Err(DecoderCodec(e)) };
}

function plan_prepared(prepared: Prepared, input_bytes: i32, first: i32, count: i32, row_limits: RowLimits): Result[RowPlan, DecoderError] {
  let layout = prepared.layout;
  if (first < 0 || count <= 0 || first >= layout.height || count > layout.height - first) {
    return Err(DecoderBounds);
  }
  let scratch = 2i64 * (layout.stride as i64);
  let payload = 2i64 * (input_bytes as i64) + prepared.filtered_bytes as i64 + scratch;
  let work = layout.height as i64 + (first as i64 + count as i64) * (layout.stride as i64);
  if (payload > row_limits.max_payload_bytes || work > row_limits.max_row_work) {
    return Err(DecoderBudget);
  }
  return Ok(RowPlan {
    layout: layout, first: first, count: count, filtered_bytes: prepared.filtered_bytes,
    row_scratch_bytes: scratch, payload_bytes: payload, row_work: work,
  });
}

pub function inspect_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits): Result[RowPlan, DecoderError] {
  let prepared = prepare_rows(input, limits, row_limits)?;
  return plan_prepared(prepared, input.len(), 0, prepared.layout.height, row_limits);
}

function open_prepared(prepared: Prepared, plan: RowPlan, cancelled: () => boolean): Result[RowDecoder, DecoderError] {
  if (cancelled()) {
    return Err(DecoderCancelled);
  }
  let layout = plan.layout;
  let filtered = match (inflate_prepared(prepared)) { Ok(v) => v, Err(e) => { return Err(DecoderCodec(e)); } };
  let y = 0;
  while (y < layout.height) {
    if (y % 64 == 0 && cancelled()) {
      return Err(DecoderCancelled);
    }
    if (filtered[y * (layout.stride + 1)] > 4 as u8) {
      return Err(DecoderCodec(PngError.Scanline));
    }
    y = y + 1;
  }
  let state = cell_new(RowCursor { next: 0, previous: [] });
  let read = (y: i32, cancelled: () => boolean): Result[pixels.Image, DecoderError] => {
    if (cancelled()) {
      return Err(DecoderCancelled);
    }
    if (y < plan.first || y >= plan.first + plan.count) {
      return Err(DecoderBounds);
    }
    let cursor = state.get();
    if (y < cursor.next - 1) {
      return Err(DecoderAccess);
    }
    while (cursor.next <= y) {
      let bytes = match (unfilter_row(filtered, layout, cursor.next, cursor.previous, cancelled)) { Ok(v) => v, Err(UnfilterError.InvalidFilter()) => { return Err(DecoderCodec(PngError.Scanline)); }, Err(UnfilterError.Interrupted()) => { return Err(DecoderCancelled); } };
      cursor = RowCursor { next: cursor.next + 1, previous: bytes };
      state.set(cursor);
    }
    if (cancelled()) {
      return Err(DecoderCancelled);
    }
    return Ok(pixels.Image { layout: pixels.Layout { ...layout, height: 1, bytes: layout.stride }, data: cursor.previous });
  };
  return Ok(RowDecoder { plan: plan, read: read });
}

pub function open_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits, cancelled: () => boolean): Result[RowDecoder, DecoderError] {
  if (cancelled()) {
    return Err(DecoderCancelled);
  }
  let prepared = prepare_rows(input, limits, row_limits)?;
  let plan = plan_prepared(prepared, input.len(), 0, prepared.layout.height, row_limits)?;
  return open_prepared(prepared, plan, cancelled);
}

function incremental_plan(prepared: Prepared, input_bytes: i32, first: i32, count: i32, limits: RowLimits): Result[RowPlan, DecoderError] {
  let layout = prepared.layout;
  if (first < 0 || count <= 0 || first >= layout.height || count > layout.height - first) {
    return Err(DecoderBounds);
  }
  let window = prepared.filtered_bytes;
  if (window > 32768) {
    window = 32768;
  }
  let scratch = 2i64 * (layout.stride as i64) + window as i64 + 1i64;
  let payload = 3i64 * (input_bytes as i64) + window as i64 + STREAM_TABLE_BYTES + scratch;
  let work = input_bytes as i64 + prepared.filtered_bytes as i64 + (first as i64 + count as i64) * (2i64 * (layout.stride as i64) + 1i64);
  if (payload > limits.max_payload_bytes || work > limits.max_row_work) {
    return Err(DecoderBudget);
  }
  return Ok(RowPlan {
    layout: layout, first: first, count: count, filtered_bytes: prepared.filtered_bytes,
    row_scratch_bytes: scratch, payload_bytes: payload, row_work: work,
  });
}

pub function inspect_incremental_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits): Result[RowPlan, DecoderError] {
  let prepared = prepare_rows(input, limits, row_limits)?;
  return incremental_plan(prepared, input.len(), 0, prepared.layout.height, row_limits);
}

function stream_error(error: deflate.InflateReadError): DecoderError {
  return match (error) { deflate.ReadCancelled => DecoderCancelled, _ => DecoderCodec(PngError.Compressed) };
}

function adler_append(checksum: u32, bytes: [u8]): u32 {
  let part = deflate.adler32(bytes);
  let a = (checksum & 65535 as u32) as i64;
  let b = (checksum >> 16) as i64;
  let next_a = (a + (part & 65535 as u32) as i64 + 65520i64) % 65521i64;
  let next_b = (b + (part >> 16) as i64 + bytes.len() as i64 * ((a + 65520i64) % 65521i64)) % 65521i64;
  return next_b as u32 << 16 | next_a as u32;
}

function validate_stream(raw: u8[], prepared: Prepared, cancelled: () => boolean): Result[boolean, DecoderError] {
  let reader = match (deflate.inflate_reader(raw, prepared.filtered_bytes)) { Ok(v) => v, Err(e) => { return Err(stream_error(e)); } };
  let checksum: u32 = 1;
  let at = 0;
  let invalid_filter = false;
  let done = false;
  while (!done) {
    let chunk = match (reader.read(32768, cancelled)) { Ok(v) => v, Err(e) => { return Err(stream_error(e)); } };
    checksum = adler_append(checksum, chunk.bytes);
    for byte in chunk.bytes {
      if (at % (prepared.layout.stride + 1) == 0 && byte > 4 as u8) {
        invalid_filter = true;
      }
      at = at + 1;
      if (at % 256 == 0 && cancelled()) {
        return Err(DecoderCancelled);
      }
    }
    if (chunk.done && chunk.consumed != raw.len()) {
      return Err(DecoderCodec(PngError.Compressed));
    }
    done = chunk.done;
  }
  if (checksum != be32(prepared.compressed, prepared.compressed.len() - 4)) {
    return Err(DecoderCodec(PngError.Compressed));
  }
  if (at != prepared.filtered_bytes || invalid_filter) {
    return Err(DecoderCodec(PngError.Scanline));
  }
  return Ok(true);
}

function stream_bytes(reader: deflate.InflateReader, count: i32, cancelled: () => boolean): Result[u8[], DecoderError] {
  let chunk = match (reader.read(count, cancelled)) { Ok(v) => v, Err(e) => { return Err(stream_error(e)); } };
  if (chunk.bytes.len() != count) {
    return Err(DecoderCodec(PngError.Scanline));
  }
  return Ok(chunk.bytes);
}

function unfilter_stream_row(reader: deflate.InflateReader, layout: pixels.Layout, y: i32, previous: [u8], cancelled: () => boolean): Result[u8[], DecoderError] {
  let tag = stream_bytes(reader, 1, cancelled)?;
  let filter = tag[0] as i32;
  if (filter > 4) {
    return Err(DecoderCodec(PngError.Scanline));
  }
  let bytes = __alloc_u8(layout.stride);
  let channels = pixels.channels(layout.format);
  let x = 0;
  while (x < layout.stride) {
    let count = layout.stride - x;
    if (count > 32768) {
      count = 32768;
    }
    let chunk = stream_bytes(reader, count, cancelled)?;
    for byte in chunk {
      if (x % 256 == 0 && cancelled()) {
        return Err(DecoderCancelled);
      }
      let left = 0;
      let above = 0;
      let upper_left = 0;
      if (x >= channels) {
        left = bytes[x - channels] as i32;
      }
      if (y > 0) {
        above = previous[x] as i32;
      }
      if (y > 0 && x >= channels) {
        upper_left = previous[x - channels] as i32;
      }
      bytes = bytes.with(x, (byte as i32 + predict(filter, left, above, upper_left)) as u8);
      x = x + 1;
    }
  }
  return Ok(bytes);
}

function stream_failure(cursor: StreamCursor, error: DecoderError, terminal: boolean): StreamRead {
  let next = cursor;
  if (terminal) {
    next = StreamCursor { ...cursor, failure: Some(error) };
  }
  return StreamRead { cursor: next, result: Err(error) };
}

function stream_read(cursor: StreamCursor, reader: deflate.InflateReader, plan: RowPlan, y: i32, cancelled: () => boolean): StreamRead {
  if let Some(error) = cursor.failure {
    return stream_failure(cursor, error, false);
  }
  if (cancelled()) {
    return stream_failure(cursor, DecoderCancelled, true);
  }
  if (y < plan.first || y >= plan.first + plan.count) {
    return stream_failure(cursor, DecoderBounds, false);
  }
  if (y < cursor.next - 1) {
    return stream_failure(cursor, DecoderAccess, false);
  }
  let cursor = cursor;
  while (cursor.next <= y) {
    let row = match (unfilter_stream_row(reader, plan.layout, cursor.next, cursor.previous, cancelled)) { Ok(v) => v, Err(e) => { return stream_failure(cursor, e, true); } };
    cursor = StreamCursor { ...cursor, next: cursor.next + 1, previous: row };
  }
  if (cancelled()) {
    return stream_failure(cursor, DecoderCancelled, true);
  }
  let image = pixels.Image { layout: pixels.Layout { ...plan.layout, height: 1, bytes: plan.layout.stride }, data: cursor.previous };
  return StreamRead { cursor: cursor, result: Ok(image) };
}

function open_incremental_prepared(prepared: Prepared, plan: RowPlan, cancelled: () => boolean): Result[RowDecoder, DecoderError] {
  if (cancelled()) {
    return Err(DecoderCancelled);
  }
  if let Some(_) = compression.header_error(prepared.compressed, prepared.filtered_bytes) {
    return Err(DecoderCodec(PngError.Compressed));
  }
  let raw: u8[] = [];
  let i = 2;
  while (i < prepared.compressed.len() - 4) {
    if (i % 256 == 0 && cancelled()) {
      return Err(DecoderCancelled);
    }
    raw = raw.append(prepared.compressed[i]);
    i = i + 1;
  }
  validate_stream(raw, prepared, cancelled)?;
  let reader = match (deflate.inflate_reader(raw, prepared.filtered_bytes)) { Ok(v) => v, Err(e) => { return Err(stream_error(e)); } };
  let state: Cell[Option[StreamCursor]] = cell_new(Some(StreamCursor { next: 0, previous: [], failure: None }));
  let read = (y: i32, cancelled: () => boolean): Result[pixels.Image, DecoderError] => {
    let cursor = match (state.get()) { Some(v) => v, None => { return Err(DecoderAccess); } };
    state.set(None);
    let result = stream_read(cursor, reader, plan, y, cancelled);
    state.set(Some(result.cursor));
    return result.result;
  };
  return Ok(RowDecoder { plan: plan, read: read });
}

pub function open_incremental_rows(input: [u8], limits: pixels.Limits, row_limits: RowLimits, cancelled: () => boolean): Result[RowDecoder, DecoderError] {
  if (cancelled()) {
    return Err(DecoderCancelled);
  }
  let prepared = prepare_rows(input, limits, row_limits)?;
  let plan = incremental_plan(prepared, input.len(), 0, prepared.layout.height, row_limits)?;
  return open_incremental_prepared(prepared, plan, cancelled);
}

function fold_error[E](error: DecoderError): RowError[E] {
  return match (error) { DecoderCodec(e) => RowCodec(e), DecoderBounds => RowBounds, DecoderBudget => RowBudget, DecoderCancelled => RowCancelled, DecoderAccess => RowBounds };
}

pub function fold_rows[S, E](input: [u8], first: i32, count: i32, limits: pixels.Limits, row_limits: RowLimits, cancelled: () => boolean, value: S, consume: (S, pixels.Image) => Result[S, E]): Result[RowFold[S], RowError[E]] {
  if (cancelled()) {
    return Err(RowCancelled);
  }
  let prepared = match (prepare_rows(input, limits, row_limits)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  let plan = match (plan_prepared(prepared, input.len(), first, count, row_limits)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  let decoder = match (open_prepared(prepared, plan, cancelled)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  return fold_decoder[S, E](decoder, cancelled, value, consume);
}

pub function fold_incremental_rows[S, E](input: [u8], first: i32, count: i32, limits: pixels.Limits, row_limits: RowLimits, cancelled: () => boolean, value: S, consume: (S, pixels.Image) => Result[S, E]): Result[RowFold[S], RowError[E]] {
  if (cancelled()) {
    return Err(RowCancelled);
  }
  let prepared = match (prepare_rows(input, limits, row_limits)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  let plan = match (incremental_plan(prepared, input.len(), first, count, row_limits)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  let decoder = match (open_incremental_prepared(prepared, plan, cancelled)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
  return fold_decoder[S, E](decoder, cancelled, value, consume);
}

function fold_decoder[S, E](decoder: RowDecoder, cancelled: () => boolean, value: S, consume: (S, pixels.Image) => Result[S, E]): Result[RowFold[S], RowError[E]] {
  let plan = decoder.plan;
  let value = value;
  let y = plan.first;
  while (y < plan.first + plan.count) {
    let row = match (decoder.read(y, cancelled)) { Ok(v) => v, Err(e) => { return Err(fold_error[E](e)); } };
    value = match (consume(value, row)) { Ok(v) => v, Err(e) => { return Err(RowConsumer(e)); } };
    if (cancelled()) {
      return Err(RowCancelled);
    }
    y = y + 1;
  }
  return Ok(RowFold[S] { value: value, plan: plan });
}

function append32(bytes: u8[], n: u32): u8[] {
  return bytes.append((n >> 24) as u8).append((n >> 16) as u8).append((n >> 8) as u8).append(n as u8);
}

function chunk(output: u8[], kind: u32, body: [u8]): u8[] {
  let type_bytes = append32([], kind);
  let crc = crc32.new().update(type_bytes).update(body).finish();
  let bytes = append32(output, body.len() as u32);
  bytes = append32(bytes, kind);
  for b in body {
    bytes = bytes.append(b);
  }
  return append32(bytes, crc);
}

pub function encode(image: pixels.Image, max_bytes: i32): Result[u8[], PngError] {
  if (max_bytes <= 0 || max_bytes > 16777216) {
    return Err(PngError.Limit);
  }
  let first = match (pixels.read_pixel(image, 0, 0)) { Ok(v) => v, Err(_) => { return Err(PngError.Dimensions); } };
  let channels = pixels.channels(image.layout.format);
  let row = image.layout.width * channels;
  let filtered_size = match ((row + 1) *? image.layout.height) { Some(v) => v, None => { return Err(PngError.Limit); } };
  if (filtered_size > 16777216) {
    return Err(PngError.Limit);
  }
  let raw: u8[] = [];
  let y = 0;
  while (y < image.layout.height) {
    raw = raw.append(0 as u8);
    let x = 0;
    while (x < row) {
      raw = raw.append(image.data[y * image.layout.stride + x]);
      x = x + 1;
    }
    y = y + 1;
  }
  let compressed = deflate.deflate(raw);
  let checksum = deflate.adler32(raw);
  let zlib: u8[] = [120 as u8, 156 as u8];
  for b in compressed {
    zlib = zlib.append(b);
  }
  zlib = append32(zlib, checksum);
  // The signature and the three chunk envelopes require 57 bytes.
  if (zlib.len() > max_bytes - 57) {
    return Err(PngError.Limit);
  }
  let header = append32(append32([], image.layout.width as u32), image.layout.height as u32);
  header = header.append(8 as u8);
  let color_type: u8 = 2;
  if (channels == 4) {
    color_type = 6;
  }
  header = header.append(color_type).append(0 as u8).append(0 as u8).append(0 as u8);
  let output: u8[] = [137 as u8, 80 as u8, 78 as u8, 71 as u8, 13 as u8, 10 as u8, 26 as u8, 10 as u8];
  output = chunk(output, 1229472850 as u32, header);
  output = chunk(output, 1229209940 as u32, zlib);
  return Ok(chunk(output, 1229278788 as u32, []));
}
