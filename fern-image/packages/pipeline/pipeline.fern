import "../pixels/pixels";
import "../resize/resize";
import "core/cmp";

pub enum Operation { ImageSource(pixels.Image), SolidSource(pixels.Pixel), NearestSource(i32), BilinearSource(i32) }

pub struct Node { width: i32, height: i32, format: pixels.Format, operation: Operation }

pub struct Graph { nodes: Node[] }

pub struct Metadata { width: i32, height: i32, format: pixels.Format }

pub struct Limits { max_pixels: i32, max_row_bytes: i32, max_scratch_bytes: i32, max_nodes: i32, max_samples: i32 }

@derive(cmp.Eq)
pub enum PipelineError { InvalidGraph, Dimensions, Bounds, Budget, Pixel(pixels.ImageError), Cancelled }

struct Cost { scratch: i64, samples: i64 }

pub struct RowStats { rows: i32, hits: i32, misses: i32, peak_cache_bytes: i32, peak_cache_entries: i32 }

pub struct RowFold[S] { value: S, stats: RowStats }

pub enum RowFailure[E] { GraphFailure(PipelineError), ConsumerFailure(E) }

struct CacheEntry { node: i32, y: i32, row: pixels.Image }

struct RowCache { entries: CacheEntry[], bytes: i32, limit: i32, max_entries: i32, stats: RowStats }

pub function default_limits(): Limits {
  return Limits { max_pixels: 16777216, max_row_bytes: 65536, max_scratch_bytes: 1048576, max_nodes: 16, max_samples: 1048576 };
}

function analyze(graph: Graph, limits: Limits): Result[Cost, PipelineError] {
  if (limits.max_pixels <= 0 || limits.max_row_bytes <= 0 || limits.max_scratch_bytes <= 0
    || limits.max_nodes <= 0 || limits.max_nodes > 64 || limits.max_samples <= 0
    || limits.max_row_bytes > 67108864 || limits.max_scratch_bytes > 67108864) {
    return Err(Budget);
  }
  if (graph.nodes.len() == 0 || graph.nodes.len() > limits.max_nodes) {
    return Err(InvalidGraph);
  }
  let costs: Cost[] = [];
  let i = 0;
  while (i < graph.nodes.len()) {
    let node = graph.nodes[i];
    if (node.width <= 0 || node.height <= 0) {
      return Err(PipelineError.Dimensions);
    }
    let pixels_count: i64 = node.width as i64 * (node.height as i64);
    let row_bytes: i64 = node.width as i64 * (pixels.channels(node.format) as i64);
    if (pixels_count > limits.max_pixels as i64 || row_bytes > limits.max_row_bytes as i64) {
      return Err(Budget);
    }
    let cost = Cost { scratch: row_bytes * 2, samples: node.width as i64 };
    match (node.operation) {
      ImageSource(image) => {
        if (image.layout.width != node.width || image.layout.height != node.height
          || pixels.channels(image.layout.format) != pixels.channels(node.format)) {
          return Err(InvalidGraph);
        }
        match (pixels.read_pixel(image, 0, 0)) {
          Ok(_) => {},
          Err(e) => {
            return Err(Pixel(e));
          }
        }
      },
      SolidSource(pixel) => {
        if (pixels.channels(node.format) == 3 && pixel.a != 255 as u8) {
          return Err(Pixel(pixels.Alpha));
        }
      },
      NearestSource(parent) => {
        if (parent < 0 || parent >= i) {
          return Err(InvalidGraph);
        }
        if (pixels.channels(node.format) != pixels.channels(graph.nodes[parent].format)) {
          return Err(InvalidGraph);
        }
        cost = Cost { scratch: cost.scratch + costs[parent].scratch, samples: cost.samples + costs[parent].samples };
      },
      BilinearSource(parent) => {
        if (parent < 0 || parent >= i) {
          return Err(InvalidGraph);
        }
        let input = graph.nodes[parent];
        if (pixels.channels(node.format) != pixels.channels(input.format)) {
          return Err(InvalidGraph);
        }
        let input_bytes: i64 = input.width as i64 * (pixels.channels(input.format) as i64);
        cost = Cost { scratch: cost.scratch + input_bytes + costs[parent].scratch,
          samples: cost.samples + costs[parent].samples * 2 };
      }
    }
    if (cost.scratch > limits.max_scratch_bytes as i64 || cost.samples > limits.max_samples as i64) {
      return Err(Budget);
    }
    costs = costs.append(cost);
    i = i + 1;
  }
  return Ok(costs[costs.len() - 1]);
}

pub function solid(width: i32, height: i32, format: pixels.Format, pixel: pixels.Pixel, limits: Limits): Result[Graph, PipelineError] {
  let graph = Graph { nodes: [Node { width: width, height: height, format: format, operation: SolidSource(pixel) }] };
  analyze(graph, limits)?;
  return Ok(graph);
}

pub function from_image(image: pixels.Image, limits: Limits): Result[Graph, PipelineError] {
  let graph = Graph { nodes: [Node { width: image.layout.width, height: image.layout.height, format: image.layout.format, operation: ImageSource(image) }] };
  analyze(graph, limits)?;
  return Ok(graph);
}

pub function nearest(graph: Graph, width: i32, height: i32, limits: Limits): Result[Graph, PipelineError] {
  analyze(graph, limits)?;
  let parent = graph.nodes.len() - 1;
  let node = Node { width: width, height: height, format: graph.nodes[parent].format, operation: NearestSource(parent) };
  let output = Graph { nodes: graph.nodes.append(node) };
  analyze(output, limits)?;
  return Ok(output);
}

pub function bilinear(graph: Graph, width: i32, height: i32, limits: Limits): Result[Graph, PipelineError] {
  analyze(graph, limits)?;
  let parent = graph.nodes.len() - 1;
  let node = Node { width: width, height: height, format: graph.nodes[parent].format, operation: BilinearSource(parent) };
  let output = Graph { nodes: graph.nodes.append(node) };
  analyze(output, limits)?;
  return Ok(output);
}

pub function metadata(graph: Graph, limits: Limits): Result[Metadata, PipelineError] {
  analyze(graph, limits)?;
  let node = graph.nodes[graph.nodes.len() - 1];
  return Ok(Metadata { width: node.width, height: node.height, format: node.format });
}

pub function required_scratch(graph: Graph, limits: Limits): Result[i32, PipelineError] {
  let cost = analyze(graph, limits)?;
  return Ok(cost.scratch as i32);
}

pub function required_samples(graph: Graph, limits: Limits): Result[i32, PipelineError] {
  let cost = analyze(graph, limits)?;
  return Ok(cost.samples as i32);
}

function fill_row(node: Node, limits: Limits, cancelled: () => boolean, sample: (i32) => Result[pixels.Pixel, PipelineError]): Result[pixels.Image, PipelineError] {
  let row_limits = pixels.Limits { max_pixels: limits.max_pixels, max_bytes: limits.max_row_bytes };
  let row = match (pixels.create(node.width, 1, node.width * pixels.channels(node.format), node.format, row_limits)) { Ok(v) => v, Err(e) => { return Err(Pixel(e)); } };
  let x = 0;
  while (x < node.width) {
    if (x % 64 == 0 && cancelled()) {
      return Err(Cancelled);
    }
    let pixel = sample(x)?;
    row = match (pixels.write_pixel(row, x, 0, pixel)) { Ok(v) => v, Err(e) => { return Err(Pixel(e)); } };
    x = x + 1;
  }
  return Ok(row);
}

function read(image: pixels.Image, x: i32, y: i32): Result[pixels.Pixel, PipelineError] {
  return match (pixels.read_pixel(image, x, y)) { Ok(v) => Ok(v), Err(e) => Err(Pixel(e)) };
}

function render_bilinear(graph: Graph, node: Node, parent: i32, y: i32, limits: Limits, cache: Option[Cell[RowCache]], cancelled: () => boolean): Result[pixels.Image, PipelineError] {
  let input = graph.nodes[parent];
  let axis = match (resize.bilinear_axis(y, input.height, node.height)) { Ok(v) => v, Err(e) => { return Err(Pixel(e)); } };
  let first = render_node(graph, parent, axis.first, limits, cache, cancelled)?;
  let second = first;
  if (axis.second != axis.first) {
    second = render_node(graph, parent, axis.second, limits, cache, cancelled)?;
  }
  let sample = (x: i32): Result[pixels.Pixel, PipelineError] => {
    let horizontal = match (resize.bilinear_axis(x, input.width, node.width)) { Ok(v) => v, Err(e) => { return Err(Pixel(e)); } };
    let a = read(first, horizontal.first, 0)?;
    let b = read(first, horizontal.second, 0)?;
    let c = read(second, horizontal.first, 0)?;
    let d = read(second, horizontal.second, 0)?;
    return match (resize.interpolate(a, b, c, d, horizontal.weight, axis.weight)) { Ok(v) => Ok(v), Err(e) => Err(Pixel(e)) };
  };
  return fill_row(node, limits, cancelled, sample);
}

function render_uncached(graph: Graph, at: i32, y: i32, limits: Limits, cache: Option[Cell[RowCache]], cancelled: () => boolean): Result[pixels.Image, PipelineError] {
  let node = graph.nodes[at];
  match (node.operation) {
    ImageSource(image) => {
      return fill_row(node, limits, cancelled, (x: i32): Result[pixels.Pixel, PipelineError] => read(image, x, y));
    },
    SolidSource(value) => {
      return fill_row(node, limits, cancelled, (_x: i32): Result[pixels.Pixel, PipelineError] => Ok(value));
    },
    NearestSource(parent) => {
      let input = graph.nodes[parent];
      let source_y = match (resize.nearest_index(y, input.height, node.height)) { Ok(v) => v, Err(e) => { return Err(Pixel(e)); } };
      let row = render_node(graph, parent, source_y, limits, cache, cancelled)?;
      let sample = (x: i32): Result[pixels.Pixel, PipelineError] => {
        let source_x = match (resize.nearest_index(x, input.width, node.width)) { Ok(v) => v, Err(e) => { return Err(Pixel(e)); } };
        return read(row, source_x, 0);
      };
      return fill_row(node, limits, cancelled, sample);
    },
    BilinearSource(parent) => {
      return render_bilinear(graph, node, parent, y, limits, cache, cancelled);
    }
  }
}

function cache_get(cache: Option[Cell[RowCache]], at: i32, y: i32): Option[pixels.Image] {
  if let Some(cell) = cache {
    let state = cell.get();
    for entry in state.entries {
      if (entry.node == at && entry.y == y) {
        cell.set(RowCache { ...state, stats: RowStats { ...state.stats, hits: state.stats.hits + 1 } });
        return Some(entry.row);
      }
    }
    cell.set(RowCache { ...state, stats: RowStats { ...state.stats, misses: state.stats.misses + 1 } });
  }
  return None;
}

function cache_remove(state: RowCache, at: i32): RowCache {
  let entries: CacheEntry[] = [];
  let i = 0;
  while (i < state.entries.len()) {
    if (i != at) {
      entries = entries.append(state.entries[i]);
    }
    i = i + 1;
  }
  return RowCache { ...state, entries: entries, bytes: state.bytes - state.entries[at].row.layout.bytes };
}

function cache_put(cache: Option[Cell[RowCache]], at: i32, y: i32, row: pixels.Image): void {
  if let Some(cell) = cache {
    let state = cell.get();
    if (row.layout.bytes > state.limit) {
      return;
    }
    let count = 0;
    let first = 0;
    let i = 0;
    while (i < state.entries.len()) {
      if (state.entries[i].node == at) {
        if (count == 0) { first = i; }
        count = count + 1;
      }
      i = i + 1;
    }
    if (count == 2) {
      state = cache_remove(state, first);
    }
    while (state.entries.len() > 0 && (state.bytes + row.layout.bytes > state.limit || state.entries.len() >= state.max_entries)) {
      state = cache_remove(state, 0);
    }
    let entries = state.entries.append(CacheEntry { node: at, y: y, row: row });
    let bytes = state.bytes + row.layout.bytes;
    let peak_bytes = state.stats.peak_cache_bytes;
    let peak_entries = state.stats.peak_cache_entries;
    if (bytes > peak_bytes) { peak_bytes = bytes; }
    if (entries.len() > peak_entries) { peak_entries = entries.len(); }
    cell.set(RowCache { ...state, entries: entries, bytes: bytes,
      stats: RowStats { ...state.stats, peak_cache_bytes: peak_bytes, peak_cache_entries: peak_entries } });
  }
}

function render_node(graph: Graph, at: i32, y: i32, limits: Limits, cache: Option[Cell[RowCache]], cancelled: () => boolean): Result[pixels.Image, PipelineError] {
  if (cancelled()) {
    return Err(Cancelled);
  }
  if let Some(row) = cache_get(cache, at, y) {
    return Ok(row);
  }
  let row = render_uncached(graph, at, y, limits, cache, cancelled)?;
  cache_put(cache, at, y, row);
  return Ok(row);
}

pub function render_row(graph: Graph, y: i32, limits: Limits, cancelled: () => boolean): Result[pixels.Image, PipelineError] {
  if (cancelled()) {
    return Err(Cancelled);
  }
  analyze(graph, limits)?;
  let output = graph.nodes.len() - 1;
  if (y < 0 || y >= graph.nodes[output].height) {
    return Err(PipelineError.Bounds);
  }
  return render_node(graph, output, y, limits, None, cancelled);
}

pub function render_rows[E](graph: Graph, first: i32, count: i32, limits: Limits, cache_bytes: i32, cancelled: () => boolean,
  consume: (pixels.Image) => Result[void, E]): Result[RowStats, RowFailure[E]] {
  let result = fold_rows(graph, first, count, limits, cache_bytes, cancelled, 0,
    (_state: i32, row: pixels.Image): Result[i32, E] => {
      consume(row)?;
      return Ok(0);
    })?;
  return Ok(result.stats);
}

pub function fold_rows[S, E](graph: Graph, first: i32, count: i32, limits: Limits, cache_bytes: i32, cancelled: () => boolean,
  value: S, consume: (S, pixels.Image) => Result[S, E]): Result[RowFold[S], RowFailure[E]] {
  if (cancelled()) {
    return Err(GraphFailure(Cancelled));
  }
  let cost = match (analyze(graph, limits)) { Ok(v) => v, Err(e) => { return Err(GraphFailure(e)); } };
  if (count <= 0) {
    return Err(GraphFailure(PipelineError.Dimensions));
  }
  let output = graph.nodes.len() - 1;
  if (first < 0 || first as i64 + count as i64 > graph.nodes[output].height as i64) {
    return Err(GraphFailure(PipelineError.Bounds));
  }
  if (cache_bytes < 0 || cost.scratch + cache_bytes as i64 > limits.max_scratch_bytes as i64
    || cost.samples * (count as i64) > limits.max_samples as i64) {
    return Err(GraphFailure(Budget));
  }
  let stats = RowStats { rows: 0, hits: 0, misses: 0, peak_cache_bytes: 0, peak_cache_entries: 0 };
  let cache = cell_new(RowCache { entries: [], bytes: 0, limit: cache_bytes, max_entries: graph.nodes.len() * 2, stats: stats });
  let value = value;
  let i = 0;
  while (i < count) {
    let row = match (render_node(graph, output, first + i, limits, Some(cache), cancelled)) { Ok(v) => v, Err(e) => { return Err(GraphFailure(e)); } };
    value = match (consume(value, row)) {
      Ok(next) => next,
      Err(e) => { return Err(ConsumerFailure(e)); }
    };
    let state = cache.get();
    cache.set(RowCache { ...state, stats: RowStats { ...state.stats, rows: state.stats.rows + 1 } });
    i = i + 1;
  }
  return Ok(RowFold[S] { value: value, stats: cache.get().stats });
}
