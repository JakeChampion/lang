import "../packages/codecs/jpeg/ycbcr";
import "../packages/pixels/pixels";
import "std/test";

function never(): boolean {
  return false;
}

function filled(count: i32, value: u8): u8[] {
  let out: u8[] = [];
  for i in 0..count {
    out = out.append(value);
  }
  return out;
}

function same(pixel: pixels.Pixel, r: u8, g: u8, b: u8): boolean {
  return pixel.r == r && pixel.g == g && pixel.b == b && pixel.a == 255;
}

function scalar(): test.TestOutcome {
  for value in 0..256 {
    if (!same(ycbcr.convert(value as u8, 128, 128), value as u8, value as u8, value as u8)) {
      return test.fail("neutral full range");
    }
  }
  if (!same(ycbcr.convert(76, 85, 255), 254, 0, 0)
    || !same(ycbcr.convert(149, 43, 21), 0, 255, 0)
    || !same(ycbcr.convert(29, 255, 107), 0, 0, 254)
    || !same(ycbcr.convert(128, 0, 0), 0, 255, 0)
    || !same(ycbcr.convert(128, 255, 255), 255, 0, 255)) {
    return test.fail("explicit endpoints and clipping");
  }
  if (ycbcr.convert(1, 253, 128).b != 223
    || ycbcr.convert(254, 3, 128).b != 33
    || ycbcr.convert(128, 78, 178).g != 110
    || ycbcr.convert(128, 178, 78).g != 147) {
    return test.fail("exact positive and negative half ties");
  }
  return test.pass();
}

function rows(): test.TestOutcome {
  let y: u8[] = [0, 255, 76, 149, 29];
  let cb: u8[] = [128, 128, 85, 43, 255];
  let cr: u8[] = [128, 128, 255, 21, 107];
  let expected: u8[] = [0, 0, 0, 255, 255, 255, 254, 0, 0, 0, 255, 0, 0, 0, 254];
  let Ok(out) = ycbcr.convert_row(y, cb, cr, 15, never) else {
    return test.fail("row conversion");
  };
  if (out.len() != 15) {
    return test.fail("packed output length");
  }
  for i in 0..15 {
    if (out[i] != expected[i]) {
      return test.fail("packed channel order");
    }
  }
  return test.pass();
}

function admission(): test.TestOutcome {
  let polls = cell_new(0);
  let cancel = (): boolean => {
    polls.set(polls.get() + 1);
    return true;
  };
  let one: u8[] = [128];
  let empty: u8[] = [];
  match (ycbcr.convert_row(empty, empty, empty, 3, cancel)) {
    Err(ycbcr.Shape()) => {},
    _ => {
      return test.fail("empty row");
    }
  }
  match (ycbcr.convert_row(one, empty, one, 3, cancel)) {
    Err(ycbcr.Shape()) => {},
    _ => {
      return test.fail("Cb width");
    }
  }
  match (ycbcr.convert_row(one, one, empty, 3, cancel)) {
    Err(ycbcr.Shape()) => {},
    _ => {
      return test.fail("Cr width");
    }
  }
  for limit in [-1, 0, 1, 2] {
    match (ycbcr.convert_row(one, one, one, limit, cancel)) {
      Err(ycbcr.Limit()) => {},
      _ => {
        return test.fail("one-less output admission");
      }
    }
  }
  if (polls.get() != 0) {
    return test.fail("invalid admission invoked callback");
  }
  return test.assert_true(match (ycbcr.convert_row(one, one, one, 3, never)) { Ok(v) => v.len() == 3, Err(_) => false });
}

function ownership(): test.TestOutcome {
  let backing: u8[] = [9, 10, 20, 30, 8];
  let window = backing[1:4];
  let chroma = filled(3, 128);
  let first = match (ycbcr.convert_row(window, chroma, chroma, 9, never)) { Ok(v) => v, Err(_) => { return test.fail("borrowed window"); } };
  backing = backing.with(1, 99);
  chroma = chroma.with(0, 0);
  if (window[0] != 10 || first[0] != 10 || backing[1] != 99) {
    return test.fail("input or output alias");
  }
  let retained = first;
  first = first.with(0, 77);
  let Ok(again) = ycbcr.convert_row(window, filled(3, 128), filled(3, 128), 9, never) else {
    return test.fail("fresh output");
  };
  return test.assert_true(retained[0] == 10 && first[0] == 77 && again[0] == 10);
}

function cancellation(): test.TestOutcome {
  let y = filled(257, 120);
  let cb = filled(257, 33);
  let cr = filled(257, 222);
  let polls = cell_new(0);
  let count = (): boolean => {
    polls.set(polls.get() + 1);
    return false;
  };
  match (ycbcr.convert_row(y, cb, cr, 771, count)) {
    Ok(v) => {
      if (v.len() != 771) {
        return test.fail("long row");
      }
    },
    Err(_) => {
      return test.fail("cancel census");
    }
  }
  let total = polls.get();
  if (total != 8) {
    return test.fail("bounded groups and final cancellation poll");
  }
  for stop in 1..=total {
    let observed = cell_new(0);
    let cancel = (): boolean => {
      observed.set(observed.get() + 1);
      return observed.get() == stop;
    };
    match (ycbcr.convert_row(y, cb, cr, 771, cancel)) {
      Err(ycbcr.Cancelled()) => {},
      _ => {
        return test.fail("every cancellation offset");
      }
    }
    if (observed.get() != stop) {
      return test.fail("continued after cancellation");
    }
  }
  return test.pass();
}

function main(): i32 {
  let runner = test.new("explicit full-range YCbCr conversion");
  runner = runner.it("neutral endpoints, clipping, and exact half ties", scalar);
  runner = runner.it("equal-resolution packed RGB rows", rows);
  runner = runner.it("shape and exact output-byte admission", admission);
  runner = runner.it("borrowed windows and owned copy-on-write outputs", ownership);
  runner = runner.it("every cooperative cancellation poll", cancellation);
  return runner.finish();
}
