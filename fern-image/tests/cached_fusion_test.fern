import "../packages/pipeline/pipeline";
import "../packages/pixels/pixels";
import "../packages/resize/resize";
import "../packages/color/color";
import "std/test";

function never_cancel(): boolean {
  return false;
}

function source(format: pixels.Format): Result[pixels.Image, pixels.ImageError] {
  let image = pixels.create(4, 4, 4 * pixels.channels(format) + 3, format, pixels.default_limits())?;
  for y in 0..4 {
    for x in 0..4 {
      let alpha = if (pixels.channels(format) == 4) { ((x + y) * 30) as u8 } else { 255 };
      image = pixels.write_pixel(image, x, y, color.rgba((10 + x * 30 + y * 4) as u8, (40 + x * 4 + y * 30) as u8, (100 + x + y) as u8, alpha))?;
    }
  }
  return Ok(image);
}

function chain(input: pixels.Image, limits: pipeline.Limits): Result[pipeline.Graph, pipeline.PipelineError] {
  let graph = pipeline.from_image(input, limits)?;
  graph = pipeline.nearest(graph, 3, 3, limits)?;
  return pipeline.nearest(graph, 2, 2, limits);
}

function collect(graph: pipeline.Graph, count: i32, limits: pipeline.Limits, cache: i32): Result[pipeline.RowFold[pixels.Image[]], pipeline.RowFailure[string]] {
  let seed: pixels.Image[] = [];
  return pipeline.fold_rows_fused(
    graph, 0, count, limits, cache, never_cancel, seed,
    (rows: pixels.Image[], row: pixels.Image): Result[pixels.Image[], string] => Ok(rows.append(row)),
  );
}

function golden(format: pixels.Format, cache: i32): boolean {
  let limits = pipeline.default_limits();
  let Ok(input) = source(format) else {
    return false;
  };
  let Ok(graph) = chain(input, limits) else {
    return false;
  };
  let Ok(result) = collect(graph, 2, limits, cache) else {
    return false;
  };
  let reds: u8[] = [10, 100, 22, 112];
  let greens: u8[] = [40, 52, 130, 142];
  let blues: u8[] = [100, 103, 103, 106];
  let alphas: u8[] = [0, 90, 90, 180];
  for y in 0..2 {
    for x in 0..2 {
      let Ok(p) = pixels.read_pixel(result.value[y], x, 0) else {
        return false;
      };
      let i = y * 2 + x;
      let alpha = if (pixels.channels(format) == 4) { alphas[i] } else { 255 };
      if (p.r != reds[i] || p.g != greens[i] || p.b != blues[i] || p.a != alpha) {
        return false;
      }
    }
  }
  return result.stats.rows == 2 && result.stats.misses == 4 && result.stats.hits == 0
    && result.stats.peak_cache_bytes <= cache;
}

function coordinates(): test.TestOutcome {
  return test.assert_true(golden(pixels.RGB8, 0) && golden(pixels.RGBA8, 0) && golden(pixels.RGB8, 72) && golden(pixels.RGBA8, 72));
}

function repeated(limits: pipeline.Limits): Result[pipeline.Graph, pipeline.PipelineError] {
  let graph = pipeline.solid(4, 1, pixels.RGBA8, color.rgba(17, 23, 99, 128), limits)?;
  graph = pipeline.nearest(graph, 3, 2, limits)?;
  return pipeline.nearest(graph, 2, 4, limits);
}

function cache_hits(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let Ok(graph) = repeated(limits) else {
    return test.fail("graph");
  };
  let consume = (n: i32, row: pixels.Image): Result[i32, string] => {
    if (row.data.len() != 8 || row.data[0] != 17 || row.data[3] != 128) {
      return Err("bytes");
    }
    return Ok(n + 1);
  };
  let Ok(legacy) = pipeline.fold_rows(graph, 0, 4, limits, 72, never_cancel, 0, consume) else {
    return test.fail("legacy");
  };
  let Ok(fused) = pipeline.fold_rows_fused(graph, 0, 4, limits, 72, never_cancel, 0, consume) else {
    return test.fail("fused");
  };
  let Ok(again) = pipeline.fold_rows_fused(graph, 0, 4, limits, 72, never_cancel, 0, consume) else {
    return test.fail("fresh batch");
  };
  return test.assert_true(legacy.value == 4 && fused.value == 4 && again.value == 4
    && legacy.stats.misses == 7 && legacy.stats.hits == 3 && legacy.stats.peak_cache_bytes == 56
    && fused.stats.misses == 5 && fused.stats.hits == 3 && fused.stats.peak_cache_bytes == 32
    && again.stats.misses == fused.stats.misses && again.stats.hits == fused.stats.hits);
}

function mixed_format(format: pixels.Format): boolean {
  let Ok(input) = source(format) else {
    return false;
  };
  let limits = pipeline.default_limits();
  let Ok(graph) = pipeline.from_image(input, limits) else {
    return false;
  };
  let eager = input;
  let widths = [5, 4, 3, 2, 3, 2];
  let heights = [7, 5, 3, 4, 5, 3];
  for i in 0..widths.len() {
    let filter = resize.Nearest;
    if (i == 0 || i == 3) {
      filter = resize.Bilinear;
      graph = match (pipeline.bilinear(graph, widths[i], heights[i], limits)) { Ok(v) => v, Err(_) => { return false; } };
    } else {
      graph = match (pipeline.nearest(graph, widths[i], heights[i], limits)) { Ok(v) => v, Err(_) => { return false; } };
    }
    eager = match (resize.resize(eager, widths[i], heights[i], filter, pixels.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  }
  let Ok(output) = collect(graph, 3, limits, 256) else {
    return false;
  };
  for y in 0..3 {
    for x in 0..2 {
      let Ok(a) = pixels.read_pixel(output.value[y], x, 0) else {
        return false;
      };
      let Ok(b) = pixels.read_pixel(eager, x, y) else {
        return false;
      };
      if (a.r != b.r || a.g != b.g || a.b != b.b || a.a != b.a) {
        return false;
      }
    }
  }
  return true;
}

function mixed(): test.TestOutcome {
  return test.assert_true(mixed_format(pixels.RGB8) && mixed_format(pixels.RGBA8));
}

function admission(): test.TestOutcome {
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_scratch_bytes: 144, max_samples: 18 };
  let Ok(input) = source(pixels.RGBA8) else {
    return test.fail("source");
  };
  let Ok(graph) = chain(input, limits) else {
    return test.fail("graph");
  };
  let exact = match (collect(graph, 2, limits, 72)) { Ok(v) => v.value.len() == 2, _ => false };
  let scratch = match (collect(graph, 2, pipeline.Limits { ...limits, max_scratch_bytes: 143 }, 72)) { Err(pipeline.GraphFailure(pipeline.Budget)) => true, _ => false };
  let work = match (collect(graph, 2, pipeline.Limits { ...limits, max_samples: 17 }, 72)) { Err(pipeline.GraphFailure(pipeline.Budget)) => true, _ => false };
  let fallback_limits = pipeline.Limits { ...pipeline.default_limits(), max_scratch_bytes: 1064, max_samples: 133 };
  let Ok(fallback) = pipeline.solid(4, 1, pixels.RGBA8, color.rgb(17, 23, 99), fallback_limits) else {
    return test.fail("fallback source");
  };
  fallback = match (pipeline.nearest(fallback, 1, 1, fallback_limits)) { Ok(v) => v, Err(_) => { return test.fail("small"); } };
  fallback = match (pipeline.nearest(fallback, 128, 1, fallback_limits)) { Ok(v) => v, Err(_) => { return test.fail("large"); } };
  let Ok(output) = collect(fallback, 1, fallback_limits, 0) else {
    return test.fail("fallback");
  };
  return test.assert_true(exact && scratch && work && output.stats.misses == 3 && output.value[0].data.len() == 512 && output.value[0].data[508] == 17);
}

function consumer_error(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let Ok(graph) = repeated(limits) else {
    return test.fail("graph");
  };
  let seed: pixels.Image[] = [];
  let calls = cell_new(0);
  let consume = (rows: pixels.Image[], row: pixels.Image): Result[pixels.Image[], string] => {
    calls.set(calls.get() + 1);
    if (rows.len() == 1) {
      return Err("retained first row");
    }
    return Ok(rows.append(row));
  };
  let rejected = match (pipeline.fold_rows_fused(graph, 0, 4, limits, 72, never_cancel, seed, consume)) { Err(pipeline.ConsumerFailure(error)) => error == "retained first row", _ => false };
  let after = match (collect(graph, 4, limits, 72)) { Ok(v) => v.stats.rows == 4, _ => false };
  return test.assert_true(rejected && calls.get() == 2 && seed.len() == 0 && after);
}

function ownership(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let Ok(graph) = repeated(limits) else {
    return test.fail("graph");
  };
  let seed: pixels.Image[] = [];
  let consume = (rows: pixels.Image[], row: pixels.Image): Result[pixels.Image[], string] => {
    let row = row;
    if (rows.len() == 0) {
      row = match (pixels.write_pixel(row, 0, 0, color.rgb(255, 0, 0))) { Ok(v) => v, Err(_) => { return Err("write"); } };
    }
    return Ok(rows.append(row));
  };
  let output = match (pipeline.fold_rows_fused(graph, 0, 4, limits, 72, never_cancel, seed, consume)) { Ok(v) => v.value, Err(_) => { return test.fail("output"); } };
  let after = match (collect(graph, 4, limits, 72)) { Ok(v) => v.value, Err(_) => { return test.fail("after"); } };
  return test.assert_true(output[0].data[0] == 255 && output[1].data[0] == 17 && output[3].data[3] == 128
    && after[0].data[0] == 17 && seed.len() == 0);
}

function cancellation(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let Ok(graph) = pipeline.solid(384, 1, pixels.RGBA8, color.rgb(17, 23, 99), limits) else {
    return test.fail("source");
  };
  graph = match (pipeline.nearest(graph, 256, 1, limits)) { Ok(v) => v, Err(_) => { return test.fail("middle"); } };
  graph = match (pipeline.nearest(graph, 128, 2, limits)) { Ok(v) => v, Err(_) => { return test.fail("output"); } };
  let polls = cell_new(0);
  let control_cancel = (): boolean => {
    polls.set(polls.get() + 1);
    return false;
  };
  let consume = (n: i32, _row: pixels.Image): Result[i32, string] => Ok(n + 1);
  let control = match (pipeline.fold_rows_fused(graph, 0, 2, limits, 4096, control_cancel, 0, consume)) { Ok(v) => v.value == 2, _ => false };
  let total = polls.get();
  for stop in 1..=total {
    polls.set(0);
    let cancel = (): boolean => {
      polls.set(polls.get() + 1);
      return polls.get() >= stop;
    };
    let rejected = match (pipeline.fold_rows_fused(graph, 0, 2, limits, 4096, cancel, 0, consume)) { Err(pipeline.GraphFailure(pipeline.Cancelled)) => true, _ => false };
    if (!rejected || polls.get() != stop) {
      return test.fail("cancellation phase");
    }
  }
  return test.assert_true(control && total > 10);
}

function depth(): test.TestOutcome {
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_nodes: 64 };
  let Ok(input) = source(pixels.RGBA8) else {
    return test.fail("source");
  };
  let Ok(graph) = pipeline.from_image(input, limits) else {
    return test.fail("graph");
  };
  for _ in 1..64 {
    graph = match (pipeline.nearest(graph, 4, 4, limits)) { Ok(v) => v, Err(_) => { return test.fail("depth"); } };
  }
  let Ok(output) = collect(graph, 1, limits, 256) else {
    return test.fail("fold");
  };
  let rejected = match (pipeline.nearest(graph, 4, 4, limits)) { Err(pipeline.InvalidGraph) => true, _ => false };
  let invalid = pipeline.Graph { nodes: graph.nodes.with(1, pipeline.Node { ...graph.nodes[1], operation: pipeline.NearestSource(1) }) };
  let hidden = match (collect(invalid, 1, limits, 256)) { Err(pipeline.GraphFailure(pipeline.InvalidGraph)) => true, _ => false };
  return test.assert_true(rejected && hidden && output.stats.misses == 2 && output.stats.peak_cache_entries == 2
    && output.value[0].data[0] == 10 && output.value[0].data[3] == 0 && input.data[0] == 10);
}

function main(): i32 {
  let r = test.new("cached nearest fusion");
  r = r.it("independent RGB/RGBA sequential coordinates with and without cache", coordinates);
  r = r.it("root reuse and actual lookup statistics preserve legacy batches", cache_hits);
  r = r.it("mixed filters preserve eager output across bilinear barriers", mixed);
  r = r.it("exact conservative budgets and upsample fallback", admission);
  r = r.it("consumer failure releases retained state and private cache", consumer_error);
  r = r.it("consumer mutation preserves cached rows and later batches", ownership);
  r = r.it("every cancellation poll releases partial fused work", cancellation);
  r = r.it("64-node fused batches preserve validation and source ownership", depth);
  return r.finish();
}
