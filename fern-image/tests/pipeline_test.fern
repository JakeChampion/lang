import "../packages/pipeline/pipeline";
import "../packages/pixels/pixels";
import "../packages/color/color";
import "../packages/resize/resize";
import "std/test";

function never_cancel(): boolean {
  return false;
}

function always_cancel(): boolean {
  return true;
}

function virtual_image(): Result[boolean, pipeline.PipelineError] {
  let limits = pipeline.default_limits();
  let pixel = color.rgba(11 as u8, 22 as u8, 33 as u8, 17 as u8);
  let graph = pipeline.solid(1000, 10000, pixels.RGBA8, pixel, limits)?;
  graph = pipeline.nearest(graph, 500, 20000, limits)?;
  let meta = pipeline.metadata(graph, limits)?;
  let scratch = pipeline.required_scratch(graph, limits)?;
  let row = pipeline.render_row(graph, 19999, limits, never_cancel)?;
  let p = match (pixels.read_pixel(row, 499, 0)) { Ok(v) => v, Err(e) => { return Err(pipeline.Pixel(e)); } };
  return Ok(meta.width == 500 && meta.height == 20000 && scratch == 12000
    && row.layout.height == 1 && row.data.len() == 2000
    && p.r == 11 as u8 && p.g == 22 as u8 && p.b == 33 as u8 && p.a == 17 as u8);
}

function virtual_rows(): test.TestOutcome {
  return test.assert_true(match (virtual_image()) { Ok(v) => v, Err(_) => false });
}

function source_image(format: pixels.Format): Result[pixels.Image, pixels.ImageError] {
  let image = pixels.create(3, 3, pixels.channels(format) * 3 + 2, format, pixels.default_limits())?;
  let y = 0;
  while (y < 3) {
    let x = 0;
    while (x < 3) {
      let alpha: u8 = 255;
      if (pixels.channels(format) == 4) {
        alpha = (x * 80 + y * 10) as u8;
      }
      image = pixels.write_pixel(image, x, y, color.rgba((x * 70) as u8, (y * 60) as u8, ((x + y) * 30) as u8, alpha))?;
      x = x + 1;
    }
    y = y + 1;
  }
  return Ok(image);
}

function agrees(format: pixels.Format): boolean {
  let source = match (source_image(format)) { Ok(v) => v, Err(_) => { return false; } };
  let graph = match (pipeline.from_image(source, pipeline.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  graph = match (pipeline.nearest(graph, 5, 7, pipeline.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  graph = match (pipeline.nearest(graph, 2, 3, pipeline.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  let eager = match (resize.resize(source, 5, 7, resize.Nearest, pixels.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  eager = match (resize.resize(eager, 2, 3, resize.Nearest, pixels.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  let y = 0;
  while (y < 3) {
    let row = match (pipeline.render_row(graph, y, pipeline.default_limits(), never_cancel)) { Ok(v) => v, Err(_) => { return false; } };
    let x = 0;
    while (x < 2) {
      let a = match (pixels.read_pixel(row, x, 0)) { Ok(v) => v, Err(_) => { return false; } };
      let b = match (pixels.read_pixel(eager, x, y)) { Ok(v) => v, Err(_) => { return false; } };
      if (a.r != b.r || a.g != b.g || a.b != b.b || a.a != b.a) {
        return false;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  return true;
}

function eager_agreement(): test.TestOutcome {
  return test.assert_true(agrees(pixels.RGB8) && agrees(pixels.RGBA8));
}

function rejected(graph: pipeline.Graph, limits: pipeline.Limits, error: pipeline.PipelineError): boolean {
  return match (pipeline.render_row(graph, 0, limits, never_cancel)) { Ok(_) => false, Err(e) => e == error };
}

function malformed_graphs(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let forward = pipeline.Node { width: 1, height: 1, format: pixels.RGBA8, operation: pipeline.NearestSource(0) };
  let huge = pipeline.Node { ...forward, width: 2147483647, height: 2147483647, operation: pipeline.SolidSource(color.rgb(0 as u8, 0 as u8, 0 as u8)) };
  let empty = pipeline.Graph { nodes: [] };
  let cycle = pipeline.Graph { nodes: [forward] };
  let bad_dimensions = pipeline.Graph { nodes: [pipeline.Node { ...huge, width: 0 }] };
  return test.assert_true(rejected(empty, limits, pipeline.InvalidGraph) && rejected(cycle, limits, pipeline.InvalidGraph)
    && rejected(pipeline.Graph { nodes: [huge] }, limits, pipeline.Budget)
    && rejected(bad_dimensions, limits, pipeline.PipelineError.Dimensions));
}

function budgets(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let graph = match (pipeline.solid(1000, 10000, pixels.RGBA8, color.rgb(1 as u8, 2 as u8, 3 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("solid graph"); } };
  graph = match (pipeline.nearest(graph, 500, 20000, limits)) { Ok(v) => v, Err(_) => { return test.fail("nearest graph"); } };
  return test.assert_true(rejected(graph, pipeline.Limits { ...limits, max_scratch_bytes: 11999 }, pipeline.Budget)
    && rejected(graph, pipeline.Limits { ...limits, max_row_bytes: 3999 }, pipeline.Budget)
    && rejected(graph, pipeline.Limits { ...limits, max_samples: 1499 }, pipeline.Budget)
    && rejected(graph, pipeline.Limits { ...limits, max_pixels: 9999999 }, pipeline.Budget)
    && rejected(graph, pipeline.Limits { ...limits, max_nodes: 1 }, pipeline.InvalidGraph));
}

function cancellation(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let graph = match (pipeline.solid(256, 1, pixels.RGBA8, color.rgb(1 as u8, 2 as u8, 3 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("solid graph"); } };
  graph = match (pipeline.nearest(graph, 128, 1, limits)) { Ok(v) => v, Err(_) => { return test.fail("nearest graph"); } };
  let before = match (pipeline.render_row(graph, 0, limits, always_cancel)) { Err(pipeline.Cancelled()) => true, _ => false };
  let calls = cell_new(0);
  let cancelled = (): boolean => {
    calls.set(calls.get() + 1);
    return calls.get() >= 9;
  };
  let during = match (pipeline.render_row(graph, 0, limits, cancelled)) { Err(pipeline.Cancelled()) => true, _ => false };
  let after = match (pipeline.render_row(graph, 0, limits, never_cancel)) { Ok(v) => v.data.len() == 512, Err(_) => false };
  return test.assert_true(before && during && calls.get() > 1 && after);
}

function invalid_sources(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let image = match (pixels.create(1, 1, 4, pixels.RGBA8, pixels.default_limits())) { Ok(v) => v, Err(_) => { return test.fail("source image"); } };
  let forged = pixels.Image { layout: image.layout, data: [] };
  let graph = pipeline.Graph { nodes: [pipeline.Node { width: 1, height: 1, format: pixels.RGBA8, operation: pipeline.ImageSource(forged) }] };
  let storage = rejected(graph, limits, pipeline.Pixel(pixels.Storage));
  let source = pipeline.Node { width: 1, height: 1, format: pixels.RGBA8, operation: pipeline.ImageSource(image) };
  let mismatch = pipeline.Node { width: 1, height: 1, format: pixels.RGB8, operation: pipeline.NearestSource(0) };
  let alpha = match (pipeline.solid(1, 1, pixels.RGB8, color.rgba(1 as u8, 2 as u8, 3 as u8, 0 as u8), limits)) { Err(e) => e == pipeline.Pixel(pixels.Alpha), Ok(_) => false };
  return test.assert_true(storage && rejected(pipeline.Graph { nodes: [source, mismatch] }, limits, pipeline.InvalidGraph) && alpha);
}

function maps(): test.TestOutcome {
  let same = match (resize.nearest_index(2147483646, 2147483647, 2147483647)) { Ok(n) => n == 2147483646, Err(_) => false };
  let middle = match (resize.nearest_index(0, 2147483647, 1)) { Ok(n) => n == 1073741823, Err(_) => false };
  let bad = match (resize.nearest_index(1, 1, 1)) { Err(e) => e == pixels.Bounds, Ok(_) => false };
  let zero = match (resize.nearest_index(0, 0, 1)) { Err(e) => e == pixels.Dimensions, Ok(_) => false };
  return test.assert_true(same && middle && bad && zero);
}

function depth_and_bounds(): test.TestOutcome {
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_nodes: 64 };
  let graph = match (pipeline.solid(2, 2, pixels.RGBA8, color.rgba(1 as u8, 2 as u8, 3 as u8, 4 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("solid graph"); } };
  let i = 1;
  while (i < 64) {
    graph = match (pipeline.nearest(graph, 2, 2, limits)) { Ok(v) => v, Err(_) => { return test.fail("graph depth"); } };
    i = i + 1;
  }
  let over = match (pipeline.nearest(graph, 2, 2, limits)) { Err(e) => e == pipeline.InvalidGraph, Ok(_) => false };
  let low = match (pipeline.render_row(graph, 0 - 1, limits, never_cancel)) { Err(e) => e == pipeline.PipelineError.Bounds, Ok(_) => false };
  let high = match (pipeline.render_row(graph, 2, limits, never_cancel)) { Err(e) => e == pipeline.PipelineError.Bounds, Ok(_) => false };
  let row = match (pipeline.render_row(graph, 1, limits, never_cancel)) { Ok(v) => v, Err(_) => { return test.fail("deep row"); } };
  let other = match (pipeline.render_row(graph, 0, limits, never_cancel)) { Ok(v) => v, Err(_) => { return test.fail("retained row"); } };
  let changed = match (pixels.write_pixel(other, 0, 0, color.rgb(255 as u8, 0 as u8, 0 as u8))) { Ok(v) => v, Err(_) => { return test.fail("row update"); } };
  let kept = match (pixels.read_pixel(row, 0, 0)) { Ok(v) => v, Err(_) => { return test.fail("retained pixel"); } };
  let updated = match (pixels.read_pixel(changed, 0, 0)) { Ok(v) => v, Err(_) => { return test.fail("updated pixel"); } };
  return test.assert_true(over && low && high && kept.r == 1 as u8 && kept.a == 4 as u8 && updated.r == 255 as u8);
}

function main(): i32 {
  let r = test.test_new("on-demand row pipeline");
  r = r.it("virtual ten-million-pixel graph renders one row", virtual_rows);
  r = r.it("RGB/RGBA row chains agree with eager nearest", eager_agreement);
  r = r.it("empty graphs, cycles, and dimensions fail safely", malformed_graphs);
  r = r.it("scratch, row, sample, pixel, and node limits", budgets);
  r = r.it("cooperative cancellation releases partial rows", cancellation);
  r = r.it("untrusted storage, formats, and alpha", invalid_sources);
  r = r.it("exact nearest mapping at i32 limits", maps);
  r = r.it("maximum depth, row bounds, and retained row isolation", depth_and_bounds);
  return r.finish();
}
