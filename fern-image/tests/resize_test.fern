import "../packages/pixels/pixels";
import "../packages/color/color";
import "../packages/resize/resize";
import "std/test";

function solid(width: i32, height: i32): Result[pixels.Image, pixels.ImageError] {
  let image = pixels.create(width, height, width * 4, pixels.RGBA8, pixels.default_limits())?;
  for y in 0..height {
    for x in 0..width {
      image = pixels.write_pixel(image, x, y, color.rgba(17, 33, 99, 128))?;
    }
  }
  return Ok(image);
}

function same_color(width: i32, height: i32, out_width: i32, out_height: i32, filter: resize.Filter): boolean {
  let Ok(source) = solid(width, height) else {
    return false;
  };
  let Ok(output) = resize.resize(source, out_width, out_height, filter, pixels.default_limits()) else {
    return false;
  };
  let good = true;
  for y in 0..out_height {
    for x in 0..out_width {
      let Ok(p) = pixels.read_pixel(output, x, y) else {
        return false;
      };
      good = good && p.r == 17 && p.g == 33 && p.b == 99 && p.a == 128;
    }
  }
  return good && output.layout.width == out_width && output.layout.height == out_height;
}

function edges(): test.TestOutcome {
  return test.assert_true(same_color(1, 1, 3, 5, resize.Nearest) && same_color(1, 1, 3, 5, resize.Bilinear)
    && same_color(7, 1, 1, 9, resize.Bilinear) && same_color(1, 9, 7, 1, resize.Bilinear)
    && same_color(5, 3, 5, 3, resize.Bilinear) && same_color(33, 17, 1, 1, resize.Bilinear));
}

function golden(alpha: u8, filter: resize.Filter): Result[pixels.Image, pixels.ImageError] {
  let source = pixels.create(2, 1, 8, pixels.RGBA8, pixels.default_limits())?;
  source = pixels.write_pixel(source, 0, 0, color.rgba(255, 0, 0, alpha))?;
  source = pixels.write_pixel(source, 1, 0, color.rgba(0, 0, 255, 255))?;
  return resize.resize(source, 3, 1, filter, pixels.default_limits());
}

function interpolation(): test.TestOutcome {
  let Ok(output) = golden(255, resize.Bilinear) else {
    return test.fail("resize");
  };
  let Ok(mid) = pixels.read_pixel(output, 1, 0) else {
    return test.fail("read");
  };
  let Ok(last) = pixels.read_pixel(output, 2, 0) else {
    return test.fail("read");
  };
  return test.assert_true(mid.r == 188 && mid.b == 188 && mid.g == 0
    && mid.a == 255 && last.b == 255 && last.r == 0);
}

function transparency(): test.TestOutcome {
  let Ok(output) = golden(0, resize.Bilinear) else {
    return test.fail("resize");
  };
  let Ok(mid) = pixels.read_pixel(output, 1, 0) else {
    return test.fail("read");
  };
  return test.assert_true(mid.r == 0 && mid.b == 255 && mid.a == 128);
}

function mixed_alpha_grid(): test.TestOutcome {
  let Ok(source) = pixels.create(2, 2, 8, pixels.RGBA8, pixels.default_limits()) else {
    return test.fail("source");
  };
  source = match (pixels.write_pixel(source, 0, 0, color.rgba(255, 0, 0, 255))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
  source = match (pixels.write_pixel(source, 1, 0, color.rgba(0, 255, 0, 0))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
  source = match (pixels.write_pixel(source, 0, 1, color.rgba(0, 0, 255, 255))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
  source = match (pixels.write_pixel(source, 1, 1, color.rgba(255, 255, 255, 128))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
  let Ok(output) = resize.resize(source, 1, 1, resize.Bilinear, pixels.default_limits()) else {
    return test.fail("resize");
  };
  let Ok(p) = pixels.read_pixel(output, 0, 0) else {
    return test.fail("read");
  };
  return test.assert_true(p.r == 203 && p.g == 124 && p.b == 203 && p.a == 160);
}

function nearest(): test.TestOutcome {
  let Ok(output) = golden(255, resize.Nearest) else {
    return test.fail("resize");
  };
  let Ok(first) = pixels.read_pixel(output, 0, 0) else {
    return test.fail("read");
  };
  let Ok(mid) = pixels.read_pixel(output, 1, 0) else {
    return test.fail("read");
  };
  return test.assert_true(first.r == 255 && first.b == 0 && mid.r == 0 && mid.b == 255);
}

function aspect(): test.TestOutcome {
  let Ok(a) = resize.fit_dimensions(7, 3, 5, 5) else {
    return test.fail("fit");
  };
  let Ok(b) = resize.fit_dimensions(1, 2147483647, 1, 1) else {
    return test.fail("fit");
  };
  let Ok(c) = resize.fit_dimensions(2147483647, 1, 1, 1) else {
    return test.fail("fit");
  };
  let bad = match (resize.fit_dimensions(0, 3, 5, 5)) { Ok(_) => false, Err(e) => e == pixels.Dimensions };
  return test.assert_true(a.width == 5 && a.height == 2 && b.width == 1 && b.height == 1 && c.width == 1 && c.height == 1 && bad);
}

function rejection(): test.TestOutcome {
  let Ok(source) = solid(1, 1) else {
    return test.fail("source");
  };
  let zero = match (resize.resize(source, 0, 1, resize.Nearest, pixels.default_limits())) { Ok(_) => false, Err(e) => e == pixels.Dimensions };
  let overflow = match (resize.resize(source, 2147483647, 1, resize.Bilinear, pixels.default_limits())) { Ok(_) => false, Err(e) => e == pixels.Overflow };
  let limited = match (resize.resize(source, 2, 2, resize.Bilinear, pixels.Limits { max_pixels: 3, max_bytes: 16 })) { Ok(_) => false, Err(e) => e == pixels.Limit };
  let forged = pixels.Image { layout: source.layout, data: [] };
  let storage = match (resize.resize(forged, 1, 1, resize.Nearest, pixels.default_limits())) { Ok(_) => false, Err(e) => e == pixels.Storage };
  return test.assert_true(zero && overflow && limited && storage);
}

function rgb_grid(): test.TestOutcome {
  let Ok(source) = pixels.create(2, 2, 6, pixels.RGB8, pixels.default_limits()) else {
    return test.fail("source");
  };
  source = match (pixels.write_pixel(source, 1, 0, color.rgb(255, 255, 255))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
  source = match (pixels.write_pixel(source, 0, 1, color.rgb(255, 0, 0))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
  source = match (pixels.write_pixel(source, 1, 1, color.rgb(0, 255, 0))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
  let Ok(output) = resize.resize(source, 3, 3, resize.Bilinear, pixels.default_limits()) else {
    return test.fail("resize");
  };
  let Ok(mid) = pixels.read_pixel(output, 1, 1) else {
    return test.fail("read");
  };
  return test.assert_true(mid.r == 188 && mid.g == 188 && mid.b == 137 && mid.a == 255);
}

function gradient(): test.TestOutcome {
  let Ok(source) = pixels.create(4, 1, 12, pixels.RGB8, pixels.default_limits()) else {
    return test.fail("source");
  };
  for x in 0..4 {
    let value = (x * 85) as u8;
    source = match (pixels.write_pixel(source, x, 0, color.rgb(value, value, value))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
  }
  let Ok(output) = resize.resize(source, 1, 1, resize.Bilinear, pixels.default_limits()) else {
    return test.fail("resize");
  };
  let Ok(p) = pixels.read_pixel(output, 0, 0) else {
    return test.fail("read");
  };
  return test.assert_true(p.r == 136 && p.g == 136 && p.b == 136 && p.a == 255);
}

function checkerboard(): test.TestOutcome {
  let Ok(source) = pixels.create(16, 16, 48, pixels.RGB8, pixels.default_limits()) else {
    return test.fail("source");
  };
  for y in 0..16 {
    for x in 0..16 {
      let value = ((x + y) % 2 * 255) as u8;
      source = match (pixels.write_pixel(source, x, y, color.rgb(value, value, value))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
    }
  }
  let Ok(output) = resize.resize(source, 1, 1, resize.Bilinear, pixels.default_limits()) else {
    return test.fail("bilinear");
  };
  let Ok(nearest) = resize.resize(source, 1, 1, resize.Nearest, pixels.default_limits()) else {
    return test.fail("nearest");
  };
  let Ok(p) = pixels.read_pixel(output, 0, 0) else {
    return test.fail("read");
  };
  let Ok(n) = pixels.read_pixel(nearest, 0, 0) else {
    return test.fail("read");
  };
  return test.assert_true(p.r == 188 && p.g == 188 && p.b == 188 && n.r == 0);
}

function main(): i32 {
  let r = test.new("resize M2");
  r = r.it("solid images, odd dimensions, single rows and columns", edges);
  r = r.it("linear-light golden interpolation", interpolation);
  r = r.it("transparent color does not bleed", transparency);
  r = r.it("two-dimensional mixed-alpha golden", mixed_alpha_grid);
  r = r.it("nearest center map", nearest);
  r = r.it("aspect ratio and extreme dimensions", aspect);
  r = r.it("unsafe output and source rejection", rejection);
  r = r.it("RGB8 two-dimensional bilinear grid", rgb_grid);
  r = r.it("independent linear-light gradient golden", gradient);
  r = r.it("checkerboard downscale follows the scalar sampling contract", checkerboard);
  return r.finish();
}
