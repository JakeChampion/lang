import "../packages/pipeline/pipeline";
import "../packages/pipeline/regions";
import "../packages/pixels/pixels";
import "../packages/color/color";
import "../packages/resize/resize";
import "std/test";

function never_cancel(): boolean {
  return false;
}

function virtual_tile(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let graph = match (pipeline.solid(1000, 10000, pixels.RGBA8, color.rgba(11 as u8, 22 as u8, 33 as u8, 17 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("source"); } };
  graph = match (pipeline.bilinear(graph, 500, 20000, limits)) { Ok(v) => v, Err(_) => { return test.fail("bilinear"); } };
  let region = regions.Region { x: 488, y: 19995, width: 12, height: 5 };
  let plan = match (regions.plan(graph, region, limits)) { Ok(v) => v, Err(_) => { return test.fail("plan"); } };
  let tile = match (regions.render_tile(graph, region, limits, never_cancel)) { Ok(v) => v, Err(_) => { return test.fail("tile"); } };
  let p = match (pixels.read_pixel(tile, 11, 4)) { Ok(v) => v, Err(_) => { return test.fail("pixel"); } };
  return test.assert_true(plan.scratch_bytes == 16480 && plan.samples == 12560
    && tile.layout.width == 12 && tile.layout.height == 5 && tile.layout.stride == 48 && tile.data.len() == 240
    && p.r == 11 as u8 && p.g == 22 as u8 && p.b == 33 as u8 && p.a == 17 as u8);
}

function source_image(format: pixels.Format): Result[pixels.Image, pixels.ImageError] {
  let image = pixels.create(3, 3, pixels.channels(format) * 3 + 2, format, pixels.default_limits())?;
  let y = 0;
  while (y < 3) {
    let x = 0;
    while (x < 3) {
      let alpha: u8 = 255;
      if (pixels.channels(format) == 4) {
        alpha = (x * 80 + y * 10) as u8;
      }
      image = pixels.write_pixel(image, x, y, color.rgba((x * 70) as u8, (y * 60) as u8, ((x + y) * 30) as u8, alpha))?;
      x = x + 1;
    }
    y = y + 1;
  }
  return Ok(image);
}

function agrees(format: pixels.Format): boolean {
  let source = match (source_image(format)) { Ok(v) => v, Err(_) => { return false; } };
  let limits = pipeline.default_limits();
  let graph = match (pipeline.from_image(source, limits)) { Ok(v) => v, Err(_) => { return false; } };
  graph = match (pipeline.bilinear(graph, 5, 7, limits)) { Ok(v) => v, Err(_) => { return false; } };
  graph = match (pipeline.nearest(graph, 7, 5, limits)) { Ok(v) => v, Err(_) => { return false; } };
  graph = match (pipeline.bilinear(graph, 6, 9, limits)) { Ok(v) => v, Err(_) => { return false; } };
  let eager = match (resize.resize(source, 5, 7, resize.Bilinear, pixels.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  eager = match (resize.resize(eager, 7, 5, resize.Nearest, pixels.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  eager = match (resize.resize(eager, 6, 9, resize.Bilinear, pixels.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  let tile = match (regions.render_tile(graph, regions.Region { x: 1, y: 2, width: 4, height: 5 }, limits, never_cancel)) { Ok(v) => v, Err(_) => { return false; } };
  let y = 0;
  while (y < 5) {
    let x = 0;
    while (x < 4) {
      let a = match (pixels.read_pixel(tile, x, y)) { Ok(v) => v, Err(_) => { return false; } };
      let b = match (pixels.read_pixel(eager, x + 1, y + 2)) { Ok(v) => v, Err(_) => { return false; } };
      if (a.r != b.r || a.g != b.g || a.b != b.b || a.a != b.a) {
        return false;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  return true;
}

function eager_agreement(): test.TestOutcome {
  return test.assert_true(agrees(pixels.RGB8) && agrees(pixels.RGBA8));
}

function small_graph(): Result[pipeline.Graph, pipeline.PipelineError] {
  let limits = pipeline.default_limits();
  let graph = pipeline.solid(4, 4, pixels.RGBA8, color.rgb(1 as u8, 2 as u8, 3 as u8), limits)?;
  graph = pipeline.bilinear(graph, 2, 2, limits)?;
  return pipeline.bilinear(graph, 3, 3, limits);
}

function dependencies(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let graph = match (pipeline.solid(4, 4, pixels.RGBA8, color.rgb(1 as u8, 2 as u8, 3 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("source"); } };
  graph = match (pipeline.nearest(graph, 2, 2, limits)) { Ok(v) => v, Err(_) => { return test.fail("nearest"); } };
  graph = match (pipeline.bilinear(graph, 3, 3, limits)) { Ok(v) => v, Err(_) => { return test.fail("bilinear"); } };
  let source = match (regions.dependency_rows(graph, 0, 0, limits)) { Ok(None()) => true, _ => false };
  let nearest = match (regions.dependency_rows(graph, 1, 1, limits)) { Ok(Some(v)) => v.node == 0 && v.first == 3 && v.last == 3, _ => false };
  let middle = match (regions.dependency_rows(graph, 2, 1, limits)) { Ok(Some(v)) => v.node == 1 && v.first == 0 && v.last == 1, _ => false };
  let edge = match (regions.dependency_rows(graph, 2, 2, limits)) { Ok(Some(v)) => v.first == 1 && v.last == 1, _ => false };
  let at = match (regions.dependency_rows(graph, 3, 0, limits)) { Err(e) => e == pipeline.PipelineError.Bounds, Ok(_) => false };
  let row = match (regions.dependency_rows(graph, 2, 3, limits)) { Err(e) => e == pipeline.PipelineError.Bounds, Ok(_) => false };
  return test.assert_true(source && nearest && middle && edge && at && row);
}

function rejected(graph: pipeline.Graph, region: regions.Region, limits: pipeline.Limits, error: pipeline.PipelineError): boolean {
  return match (regions.render_tile(graph, region, limits, never_cancel)) { Err(e) => e == error, Ok(_) => false };
}

function budgets(): test.TestOutcome {
  let graph = match (small_graph()) { Ok(v) => v, Err(_) => { return test.fail("graph"); } };
  let region = regions.Region { x: 0, y: 0, width: 2, height: 2 };
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_scratch_bytes: 128, max_samples: 50 };
  let plan = match (regions.plan(graph, region, limits)) { Ok(v) => v.scratch_bytes == 128 && v.samples == 50, Err(_) => false };
  let tile = match (regions.render_tile(graph, region, limits, never_cancel)) { Ok(v) => v.data.len() == 16, Err(_) => false };
  return test.assert_true(plan && tile
    && rejected(graph, region, pipeline.Limits { ...limits, max_scratch_bytes: 127 }, pipeline.Budget)
    && rejected(graph, region, pipeline.Limits { ...limits, max_samples: 49 }, pipeline.Budget)
    && rejected(graph, region, pipeline.Limits { ...limits, max_row_bytes: 15 }, pipeline.Budget)
    && rejected(graph, region, pipeline.Limits { ...limits, max_pixels: 15 }, pipeline.Budget)
    && rejected(graph, region, pipeline.Limits { ...limits, max_nodes: 2 }, pipeline.InvalidGraph));
}

function invalid_regions(): test.TestOutcome {
  let graph = match (small_graph()) { Ok(v) => v, Err(_) => { return test.fail("graph"); } };
  let region = regions.Region { x: 0, y: 0, width: 1, height: 1 };
  let limits = pipeline.default_limits();
  let image = pixels.Image { layout: pixels.Layout { width: 1, height: 1, stride: 4, format: pixels.RGBA8, bytes: 4 }, data: [] };
  let forged = pipeline.Graph { nodes: [pipeline.Node { width: 1, height: 1, format: pixels.RGBA8, operation: pipeline.ImageSource(image) }] };
  return test.assert_true(rejected(graph, regions.Region { ...region, x: 0 - 1 }, limits, pipeline.PipelineError.Bounds)
    && rejected(graph, regions.Region { ...region, y: 3 }, limits, pipeline.PipelineError.Bounds)
    && rejected(graph, regions.Region { ...region, width: 0 }, limits, pipeline.PipelineError.Dimensions)
    && rejected(graph, regions.Region { ...region, height: 0 }, limits, pipeline.PipelineError.Dimensions)
    && rejected(graph, regions.Region { ...region, x: 2147483647, width: 2147483647 }, limits, pipeline.PipelineError.Bounds)
    && rejected(graph, region, pipeline.Limits { ...limits, max_scratch_bytes: 0 }, pipeline.Budget)
    && rejected(forged, region, limits, pipeline.Pixel(pixels.Storage)));
}

function cancellation(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let graph = match (pipeline.solid(256, 2, pixels.RGBA8, color.rgb(1 as u8, 2 as u8, 3 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("source"); } };
  graph = match (pipeline.bilinear(graph, 128, 1, limits)) { Ok(v) => v, Err(_) => { return test.fail("bilinear"); } };
  let region = regions.Region { x: 0, y: 0, width: 128, height: 1 };
  let good = true;
  for stop in [3, 10, 16, 18] {
    let calls = cell_new(0);
    let cancelled = (): boolean => {
      calls.set(calls.get() + 1);
      return calls.get() >= stop;
    };
    let during = match (regions.render_tile(graph, region, limits, cancelled)) { Err(pipeline.Cancelled()) => true, _ => false };
    good = good && during && calls.get() == stop;
  }
  let after = match (regions.render_tile(graph, region, limits, never_cancel)) { Ok(v) => v.data.len() == 512, Err(_) => false };
  return test.assert_true(good && after);
}

function isolation(): test.TestOutcome {
  let source = match (source_image(pixels.RGBA8)) { Ok(v) => v, Err(_) => { return test.fail("source"); } };
  let limits = pipeline.default_limits();
  let graph = match (pipeline.from_image(source, limits)) { Ok(v) => v, Err(_) => { return test.fail("graph"); } };
  graph = match (pipeline.nearest(graph, 6, 6, limits)) { Ok(v) => v, Err(_) => { return test.fail("nearest"); } };
  let region = regions.Region { x: 0, y: 0, width: 2, height: 2 };
  let tile = match (regions.render_tile(graph, region, limits, never_cancel)) { Ok(v) => v, Err(_) => { return test.fail("tile"); } };
  let kept = tile;
  let changed = match (pixels.write_pixel(tile, 0, 0, color.rgb(255 as u8, 0 as u8, 0 as u8))) { Ok(v) => v, Err(_) => { return test.fail("write"); } };
  let other = match (regions.render_tile(graph, region, limits, never_cancel)) { Ok(v) => v, Err(_) => { return test.fail("other"); } };
  let a = match (pixels.read_pixel(kept, 0, 0)) { Ok(v) => v, Err(_) => { return test.fail("kept"); } };
  let b = match (pixels.read_pixel(changed, 0, 0)) { Ok(v) => v, Err(_) => { return test.fail("changed"); } };
  let c = match (pixels.read_pixel(other, 0, 0)) { Ok(v) => v, Err(_) => { return test.fail("other pixel"); } };
  let d = match (pixels.read_pixel(source, 0, 0)) { Ok(v) => v, Err(_) => { return test.fail("source pixel"); } };
  return test.assert_true(a.a == 0 as u8 && b.r == 255 as u8 && b.a == 255 as u8 && c.a == 0 as u8 && d.a == 0 as u8);
}

function large_plans(): test.TestOutcome {
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_pixels: 2147483647, max_samples: 2147483647, max_nodes: 64, max_scratch_bytes: 67108864 };
  let graph = match (pipeline.solid(1, 2147483647, pixels.RGBA8, color.rgb(1 as u8, 2 as u8, 3 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("large source"); } };
  let overflow = match (regions.plan(graph, regions.Region { x: 0, y: 0, width: 1, height: 2147483647 }, limits)) { Err(e) => e == pipeline.Pixel(pixels.Overflow), Ok(_) => false };
  graph = match (pipeline.solid(1, 1000000, pixels.RGBA8, color.rgb(1 as u8, 2 as u8, 3 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("work source"); } };
  let i = 1;
  while (i < 31) {
    graph = match (pipeline.bilinear(graph, 1, 1000000, limits)) { Ok(v) => v, Err(_) => { return test.fail("deep graph"); } };
    i = i + 1;
  }
  let work = match (regions.plan(graph, regions.Region { x: 0, y: 0, width: 1, height: 1000000 }, limits)) { Err(e) => e == pipeline.Budget, Ok(_) => false };
  return test.assert_true(overflow && work);
}

function main(): i32 {
  let r = test.test_new("checked region requests");
  r = r.it("virtual ten-million-pixel graph returns a cropped tile", virtual_tile);
  r = r.it("padded RGB/RGBA mixed-filter crops agree with eager output", eager_agreement);
  r = r.it("direct nearest and bilinear dependency rows", dependencies);
  r = r.it("exact tile storage and aggregate sample budgets", budgets);
  r = r.it("invalid regions, storage, and limits fail before execution", invalid_regions);
  r = r.it("cancellation releases input rows and partial tiles", cancellation);
  r = r.it("retained tile and source values remain isolated", isolation);
  r = r.it("large output arithmetic and recursive work fail before allocation", large_plans);
  return r.finish();
}
