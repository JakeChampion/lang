import "../packages/codecs/jpeg/frame_writer" as frame;
import "../packages/codecs/jpeg/entropy_writer" as writer;
import "../packages/codecs/jpeg/header";
import "../packages/codecs/jpeg/mcu_order";
import "std/test";

function never(): boolean {
  return false;
}

function table(ac: boolean): header.HuffmanTable {
  let symbols: u8[] = [];
  for value in 0..256 {
    if (!ac && value <= 11 || ac && ((value & 15) >= 1 && (value & 15) <= 10 || value == 0 || value == 240)) {
      symbols = symbols.append(value as u8);
    }
  }
  let counts: u8[] = [];
  for i in 0..16 {
    counts = counts.append(if (i == 7) { symbols.len() as u8 } else { 0 });
  }
  return header.HuffmanTable { counts: counts, symbols: symbols };
}

function quantizer(value: u8): header.QuantTable {
  let values: u8[] = [];
  for i in 0..64 {
    values = values.append(value);
  }
  return header.QuantTable { values: values };
}

function tables(): frame.ComponentTables {
  return frame.ComponentTables { quantization: [quantizer(1), quantizer(2), quantizer(3), quantizer(4)], huffman: writer.ScanTables { dc: [table(false), table(false)], ac: [table(true), table(true)] } };
}

function component(id: i32, h: i32, v: i32): frame.Component {
  return frame.Component { id: id, horizontal: h, vertical: v, quantization: 0, dc: 0, ac: 0 };
}

function options(width: i32, height: i32, restart: i32): frame.Options {
  return frame.Options { width: width, height: height, restart_interval: restart, max_output_bytes: 65536 };
}

function values(count: i32): i32[] {
  let result: i32[] = [];
  for i in 0..count * 64 {
    result = result.append(if (i % 64 == 0) { i / 64 * 3 - 20 } else if (i % 13 == 0) { i % 31 - 15 } else { 0 });
  }
  return result;
}

function produced(input: [i32], components: [frame.Component], tables: frame.ComponentTables, options: frame.Options, cancelled: () => boolean): Result[u8[], frame.ProducedError[writer.EncodeError]] {
  return frame.encode_components_produced(
    input, components, tables, options, cancelled,
    (source: [i32], consume: ([i32]) => Result[void, writer.EncodeError]): Result[void, writer.EncodeError] => {
      let at = 0;
      while (at < source.len()) {
        let end = if (source.len() - at < 64) { source.len() } else { at + 64 };
        consume(source[at:end])?;
        at = end;
      }
      return Ok(());
    },
  );
}

function same(a: [u8], b: [u8]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

function grayscale(): test.TestOutcome {
  let original = values(6);
  let t = frame.ComponentTables { quantization: [quantizer(1)], huffman: writer.ScanTables { dc: [table(false)], ac: [table(true)] } };
  let old_tables = frame.Tables { quantization: quantizer(1).values, dc: table(false), ac: table(true) };
  for restart in [0, 1, 2, 7, 65535] {
    let config = options(17, 9, restart);
    let Ok(old) = frame.encode_blocks(original, old_tables, config, never) else {
      return test.fail("original grayscale frame");
    };
    for factor in [1, 4] {
      let Ok(raw) = produced(original, [component(1, factor, factor)], t, config, never) else {
        return test.fail("raw grayscale frame");
      };
      if (raw.len() != old.len() - 18 || raw[0] != 255 || raw[1] != 216 || raw[3] != 219) {
        return test.fail("raw frame excludes the JFIF segment");
      }
      if (factor == 1 && !same(raw[2:raw.len()], old[20:old.len()])) {
        return test.fail("grayscale bytes retain the original marker and entropy bytes");
      }
    }
  }
  return test.pass();
}

function metadata(): test.TestOutcome {
  let components = [frame.Component { ...component(0, 2, 2), quantization: 3, dc: 1 }, frame.Component { ...component(255, 1, 1), ac: 1 }, frame.Component { ...component(42, 1, 1), quantization: 2, dc: 1, ac: 1 }];
  let Ok(encoded) = produced(values(12), components, tables(), options(9, 17, 1), never) else {
    return test.fail("explicit component frame");
  };
  let Ok(h) = header.parse(encoded, header.default_limits(), never) else {
    return test.fail("component frame header");
  };
  if (h.output_layout.width != 9 || h.output_layout.height != 17 || h.restart_interval != 1 || h.components.len() != 3 || h.scan.len() != 3) {
    return test.fail("frame geometry and restart metadata");
  }
  for i in 0..3 {
    let item = components[i];
    let actual = h.components[i];
    if (actual.id != item.id || actual.horizontal != item.horizontal || actual.vertical != item.vertical || actual.quant_table != item.quantization
      || h.scan[i].id != item.id || h.scan[i].dc_table != item.dc || h.scan[i].ac_table != item.ac) {
      return test.fail("frame and scan preserve explicit selectors");
    }
  }
  for i in 0..4 {
    let Some(q) = h.quantization[i] else {
      return test.fail("every quantization table is present");
    };
    for value in q.values {
      if (value != i + 1) {
        return test.fail("quantization destinations remain distinct");
      }
    }
  }
  return test.pass();
}

function admission(): test.TestOutcome {
  let t = tables();
  let input = values(1);
  let calls = cell_new(0);
  let cancelled = (): boolean => {
    calls.set(calls.get() + 1);
    return true;
  };
  for components in [[], [component(-1, 1, 1)], [component(256, 1, 1)], [component(0, 0, 1)], [component(0, 1, 5)], [component(1, 1, 1), component(1, 1, 1)], [component(0, 4, 2), component(1, 3, 1)]] {
    if (!match (produced(input, components, t, options(1, 1, 0), cancelled)) { Err(frame.FrameEncode(frame.Shape)) => true, _ => false }) {
      return test.fail("component admission precedes cancellation");
    }
  }
  for item in [frame.Component { ...component(0, 1, 1), quantization: -1 }, frame.Component { ...component(0, 1, 1), quantization: 4 }, frame.Component { ...component(0, 1, 1), dc: 2 }, frame.Component { ...component(0, 1, 1), ac: -1 }] {
    if (!match (produced(input, [item], t, options(1, 1, 0), cancelled)) { Err(frame.FrameEncode(frame.Table)) => true, _ => false }) {
      return test.fail("table selectors precede cancellation");
    }
  }
  let bad = frame.ComponentTables { ...t, quantization: [quantizer(0)] };
  if (!match (produced(input, [component(0, 1, 1)], bad, options(1, 1, 0), cancelled)) { Err(frame.FrameEncode(frame.Table)) => true, _ => false } || calls.get() != 0) {
    return test.fail("quantization admission precedes cancellation");
  }
  return test.pass();
}

function table_admission(): test.TestOutcome {
  let t = tables();
  let calls = cell_new(0);
  let cancel = (): boolean => {
    calls.set(calls.get() + 1);
    return true;
  };
  let symbols: u8[] = [];
  for i in 0..257 {
    symbols = symbols.append(0);
  }
  let h = t.huffman;
  let bad = [
    frame.ComponentTables { ...t, quantization: [] },
    frame.ComponentTables { ...t, quantization: [quantizer(1), quantizer(1), quantizer(1), quantizer(1), quantizer(1)] },
    frame.ComponentTables { ...t, quantization: [header.QuantTable { values: [1u8] }] },
    frame.ComponentTables { ...t, huffman: writer.ScanTables { ...h, dc: [] } },
    frame.ComponentTables { ...t, huffman: writer.ScanTables { ...h, ac: [table(true), table(true), table(true)] } },
    frame.ComponentTables { ...t, huffman: writer.ScanTables { ...h, dc: [header.HuffmanTable { counts: [], symbols: [0u8] }] } },
    frame.ComponentTables { ...t, huffman: writer.ScanTables { ...h, ac: [header.HuffmanTable { ...table(true), symbols: symbols }] } },
  ];
  for item in bad {
    if (!match (produced(values(1), [component(0, 1, 1)], item, options(1, 1, 0), cancel)) { Err(frame.FrameEncode(frame.Shape)) => true, _ => false }) {
      return test.fail("all structural table shapes precede callbacks");
    }
  }
  return test.assert_true(calls.get() == 0);
}

function exact_limits(): test.TestOutcome {
  let input = values(12);
  let components = [component(0, 2, 2), component(255, 1, 1), component(42, 1, 1)];
  let config = options(9, 17, 1);
  let Ok(encoded) = produced(input, components, tables(), config, never) else {
    return test.fail("frame byte limit baseline");
  };
  for limit in 0..encoded.len() + 2 {
    let result = produced(input, components, tables(), frame.Options { ...config, max_output_bytes: limit }, never);
    if (!match (result) { Ok(v) => limit >= encoded.len() && same(v, encoded), Err(frame.FrameEncode(frame.Limit)) => limit < encoded.len(), _ => false }) {
      return test.fail("every frame byte boundary retains the exact allowance");
    }
  }
  return test.pass();
}

function cancellation(): test.TestOutcome {
  let input = values(12);
  let components = [component(0, 2, 2), component(255, 1, 1), component(42, 1, 1)];
  let calls = cell_new(0);
  let count = (): boolean => {
    calls.set(calls.get() + 1);
    return false;
  };
  if (!match (produced(input, components, tables(), options(9, 17, 1), count)) { Ok(_) => true, _ => false }) {
    return test.fail("frame cancellation baseline");
  }
  let total = calls.get();
  for stop in 1..total + 1 {
    calls.set(0);
    let cancel = (): boolean => {
      calls.set(calls.get() + 1);
      return calls.get() == stop;
    };
    if (!match (produced(input, components, tables(), options(9, 17, 1), cancel)) { Err(frame.FrameEncode(frame.Cancelled)) => true, _ => false }) {
      return test.fail("every component frame cancellation checkpoint");
    }
  }
  return test.pass();
}

function producer_failures(): test.TestOutcome {
  let input = values(1);
  for length in [0, 1, 63] {
    if (!match (produced(input[0:length], [component(0, 1, 1)], tables(), options(1, 1, 0), never)) { Err(frame.FrameEncode(frame.Entropy(writer.Shape))) => true, _ => false }) {
      return test.fail("producer count and block shape");
    }
  }
  let result = frame.encode_components_produced(
    (), [component(0, 1, 1)], tables(), options(1, 1, 0), never,
    (context: void, emit: ([i32]) => Result[void, writer.EncodeError]): Result[void, string] => {
      let ignored = emit(input[0:63]);
      let ignored_again = emit(input);
      return Err("source stopped");
    },
  );
  if (!match (result) { Err(frame.FrameEncode(frame.Entropy(writer.Shape))) => true, _ => false }) {
    return test.fail("first codec failure precedes later source errors");
  }
  let escaped = frame.encode_components_produced(
    (), [component(0, 1, 1)], tables(), options(1, 1, 0), never,
    (context: void, emit: ([i32]) => Result[void, writer.EncodeError]): Result[void, ([i32]) => Result[void, writer.EncodeError]] => Err(emit),
  );
  let Err(frame.FrameSource(late)) = escaped else {
    return test.fail("source errors retain their supplied type");
  };
  if (!match (late(input)) { Err(writer.Shape) => true, _ => false }) {
    return test.fail("component frame closes the escaped entropy consumer");
  }
  return test.pass();
}

function geometry_and_aliases(): test.TestOutcome {
  let factors = [mcu_order.Sampling { horizontal: 2, vertical: 2 }, mcu_order.Sampling { horizontal: 1, vertical: 1 }, mcu_order.Sampling { horizontal: 1, vertical: 1 }];
  let components = [component(1, 2, 2), component(2, 1, 1), component(3, 1, 1)];
  let t = tables();
  let count = cell_new(0);
  let dummy = cell_new(0);
  let result = frame.encode_components_produced(
    (), components, t, options(17, 17, 1), never,
    (source: void, emit: ([i32]) => Result[void, writer.EncodeError]): Result[void, writer.EncodeError] => {
      let folded = mcu_order.fold_blocks[i32, writer.EncodeError](17, 17, factors, 24, never, 0, (state: i32, at: mcu_order.Address): Result[i32, writer.EncodeError] => {
        count.set(count.get() + 1);
        if (at.dummy) {
          dummy.set(dummy.get() + 1);
        }
        let block = values(1).with(0, at.component * 7 + at.mcu);
        emit(block)?;
        return Ok(state + 1);
      });
      return match (folded) { Ok(_) => Ok(()), Err(mcu_order.Consumer(e)) => Err(e), Err(_) => Err(writer.Shape) };
    },
  );
  let Ok(encoded) = result else {
    return test.fail("direct complete MCU geometry produces a frame");
  };
  let alias = cell_new(encoded);
  let changed = encoded.with(0, 0);
  if (count.get() != 24 || dummy.get() == 0 || encoded[0] != 255 || alias.get()[0] != 255 || changed[0] != 0 || components[0].horizontal != 2 || t.quantization[3].values[0] != 4) {
    return test.fail("dummy blocks and caller aliases remain independent");
  }
  return test.pass();
}

function main(): i32 {
  let suite = test.new("JPEG component frames");
  suite = suite.it("raw grayscale preserves earlier marker and entropy bytes", grayscale);
  suite = suite.it("explicit component identifiers and all table destinations", metadata);
  suite = suite.it("invalid metadata precedes cancellation callbacks", admission);
  suite = suite.it("all table shapes precede cancellation callbacks", table_admission);
  suite = suite.it("every frame output limit includes complete markers and EOI", exact_limits);
  suite = suite.it("every component frame cancellation checkpoint", cancellation);
  suite = suite.it("producer errors, counts and closed escaped consumers", producer_failures);
  suite = suite.it("direct MCU geometry, dummy blocks and caller aliases", geometry_and_aliases);
  return suite.finish();
}
