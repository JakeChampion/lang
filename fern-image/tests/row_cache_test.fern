import "../packages/pipeline/pipeline";
import "../packages/pixels/pixels";
import "../packages/color/color";
import "std/test";

function never_cancel(): boolean {
  return false;
}

function reuse(): test.TestOutcome {
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_scratch_bytes: 208, max_samples: 128 };
  let graph = match (pipeline.solid(4, 2, pixels.RGBA8, color.rgb(17 as u8, 23 as u8, 99 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("source"); } };
  graph = match (pipeline.bilinear(graph, 8, 8, limits)) { Ok(v) => v, Err(_) => { return test.fail("bilinear"); } };
  let calls = cell_new(0);
  let consume = (row: pixels.Image): Result[void, string] => {
    let p = match (pixels.read_pixel(row, 7, 0)) { Ok(v) => v, Err(_) => { return Err("pixel"); } };
    if (p.r != 17 as u8 || p.g != 23 as u8 || p.b != 99 as u8 || p.a != 255 as u8) {
      return Err("bytes");
    }
    calls.set(calls.get() + 1);
    return Ok(());
  };
  let uncached = match (pipeline.render_rows(graph, 0, 8, limits, 0, never_cancel, consume)) { Ok(v) => v, Err(_) => { return test.fail("uncached"); } };
  let cached = match (pipeline.render_rows(graph, 0, 8, limits, 96, never_cancel, consume)) { Ok(v) => v, Err(_) => { return test.fail("cached"); } };
  return test.assert_true(calls.get() == 16 && uncached.rows == 8 && uncached.hits == 0 && uncached.misses == 22
    && cached.rows == 8 && cached.hits == 12 && cached.misses == 10
    && cached.peak_cache_bytes == 96 && cached.peak_cache_entries == 4);
}

function graph(): Result[pipeline.Graph, pipeline.PipelineError] {
  let limits = pipeline.default_limits();
  let source = pipeline.solid(4, 2, pixels.RGBA8, color.rgb(17 as u8, 23 as u8, 99 as u8), limits)?;
  return pipeline.bilinear(source, 8, 8, limits);
}

function rejected(first: i32, count: i32, cache_bytes: i32, limits: pipeline.Limits, error: pipeline.PipelineError): boolean {
  let input = match (graph()) { Ok(v) => v, Err(_) => { return false; } };
  let calls = cell_new(0);
  let consume = (_row: pixels.Image): Result[void, string] => {
    calls.set(calls.get() + 1);
    return Ok(());
  };
  let result = match (pipeline.render_rows(input, first, count, limits, cache_bytes, never_cancel, consume)) {
    Err(pipeline.GraphFailure(e)) => e == error, _ => false
  };
  return result && calls.get() == 0;
}

function limits(): test.TestOutcome {
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_scratch_bytes: 208, max_samples: 128 };
  return test.assert_true(rejected(0, 0, 96, limits, pipeline.PipelineError.Dimensions)
    && rejected(0 - 1, 8, 96, limits, pipeline.PipelineError.Bounds)
    && rejected(7, 2, 96, limits, pipeline.PipelineError.Bounds)
    && rejected(2147483647, 2147483647, 96, limits, pipeline.PipelineError.Bounds)
    && rejected(0, 8, 0 - 1, limits, pipeline.Budget)
    && rejected(0, 8, 96, pipeline.Limits { ...limits, max_scratch_bytes: 207 }, pipeline.Budget)
    && rejected(0, 8, 96, pipeline.Limits { ...limits, max_samples: 127 }, pipeline.Budget)
    && rejected(0, 8, 96, pipeline.Limits { ...limits, max_nodes: 1 }, pipeline.InvalidGraph));
}

function discard(row: pixels.Image): Result[void, string] {
  let p = match (pixels.read_pixel(row, 7, 0)) { Ok(v) => v, Err(_) => { return Err("pixel"); } };
  if (p.r != 17 as u8 || p.a != 255 as u8) {
    return Err("bytes");
  }
  return Ok(());
}

function eviction(): test.TestOutcome {
  let input = match (graph()) { Ok(v) => v, Err(_) => { return test.fail("graph"); } };
  let good = true;
  for bytes in [1, 16, 48, 95, 96] {
    let a = match (pipeline.render_rows(input, 0, 8, pipeline.default_limits(), bytes, never_cancel, discard)) { Ok(v) => v, Err(_) => { return test.fail("first batch"); } };
    let b = match (pipeline.render_rows(input, 0, 8, pipeline.default_limits(), bytes, never_cancel, discard)) { Ok(v) => v, Err(_) => { return test.fail("second batch"); } };
    good = good && a.rows == 8 && a.peak_cache_bytes <= bytes && a.peak_cache_entries <= 4
      && a.hits == b.hits && a.misses == b.misses && a.peak_cache_bytes == b.peak_cache_bytes;
    if (bytes == 1) {
      good = good && a.hits == 0 && a.misses == 22 && a.peak_cache_entries == 0;
    }
    if (bytes == 16) {
      good = good && a.misses > 10;
    }
  }
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_nodes: 64, max_row_bytes: 4, max_scratch_bytes: 1024, max_samples: 128 };
  let deep = match (pipeline.solid(1, 2, pixels.RGBA8, color.rgb(17 as u8, 23 as u8, 99 as u8), limits)) { Ok(v) => v, Err(_) => { return test.fail("deep source"); } };
  let depth = 1;
  while (depth < 64) {
    deep = match (pipeline.nearest(deep, 1, 2, limits)) { Ok(v) => v, Err(_) => { return test.fail("deep graph"); } };
    depth = depth + 1;
  }
  let accept = (row: pixels.Image): Result[void, string] => {
    let p = match (pixels.read_pixel(row, 0, 0)) { Ok(v) => v, Err(_) => { return Err("pixel"); } };
    if (p.r != 17 as u8 || p.a != 255 as u8) { return Err("bytes"); }
    return Ok(());
  };
  let maximum = match (pipeline.render_rows(deep, 0, 2, limits, 512, never_cancel, accept)) {
    Ok(v) => v.peak_cache_entries == 128 && v.peak_cache_bytes == 512 && v.rows == 2, Err(_) => false
  };
  return test.assert_true(good && maximum);
}

function consumer_errors(): test.TestOutcome {
  let input = match (graph()) { Ok(v) => v, Err(_) => { return test.fail("graph"); } };
  let av = args();
  let reason = av[0] + ": consumer stopped after retained rows";
  let expected = reason;
  let empty: pixels.Image[] = [];
  let saved = cell_new(empty);
  let consume = (row: pixels.Image): Result[void, string] => {
    saved.set(saved.get().append(row));
    if (saved.get().len() == 3) {
      return Err(reason);
    }
    return Ok(());
  };
  let stopped = match (pipeline.render_rows(input, 0, 8, pipeline.default_limits(), 96, never_cancel, consume)) {
    Err(pipeline.ConsumerFailure(e)) => e == expected, _ => false
  };
  let retained = saved.get();
  if (retained.len() != 3) {
    return test.fail("retained rows");
  }
  let p = match (pixels.read_pixel(retained[2], 7, 0)) { Ok(v) => v, Err(_) => { return test.fail("retained pixel"); } };
  let reject = (_row: pixels.Image): Result[void, i32] => Err(77);
  let numeric = match (pipeline.render_rows(input, 0, 8, pipeline.default_limits(), 96, never_cancel, reject)) {
    Err(pipeline.ConsumerFailure(e)) => e == 77, _ => false
  };
  let after = match (pipeline.render_rows(input, 0, 8, pipeline.default_limits(), 96, never_cancel, discard)) { Ok(v) => v.rows == 8, Err(_) => false };
  return test.assert_true(stopped && numeric && after && p.r == 17 as u8 && p.a == 255 as u8);
}

function cancellation(): test.TestOutcome {
  let input = match (graph()) { Ok(v) => v, Err(_) => { return test.fail("graph"); } };
  let completed = cell_new(0);
  let consume = (_row: pixels.Image): Result[void, string] => {
    completed.set(completed.get() + 1);
    return Ok(());
  };
  let cancelled = (): boolean => completed.get() >= 2;
  let stopped = match (pipeline.render_rows(input, 0, 8, pipeline.default_limits(), 96, cancelled, consume)) {
    Err(pipeline.GraphFailure(e)) => e == pipeline.Cancelled, _ => false
  };
  let after = match (pipeline.render_rows(input, 0, 8, pipeline.default_limits(), 96, never_cancel, discard)) { Ok(v) => v.rows == 8, Err(_) => false };
  let wide = match (pipeline.solid(4, 2, pixels.RGBA8, color.rgb(17 as u8, 23 as u8, 99 as u8), pipeline.default_limits())) { Ok(v) => v, Err(_) => { return test.fail("wide source"); } };
  wide = match (pipeline.bilinear(wide, 128, 8, pipeline.default_limits())) { Ok(v) => v, Err(_) => { return test.fail("wide graph"); } };
  let finished = cell_new(0);
  let polls = cell_new(0);
  let partial_cancel = (): boolean => {
    if (finished.get() == 1) {
      polls.set(polls.get() + 1);
      return polls.get() >= 5;
    }
    return false;
  };
  let accept = (_row: pixels.Image): Result[void, string] => {
    finished.set(finished.get() + 1);
    return Ok(());
  };
  let partial = match (pipeline.render_rows(wide, 0, 8, pipeline.default_limits(), 1056, partial_cancel, accept)) {
    Err(pipeline.GraphFailure(e)) => e == pipeline.Cancelled, _ => false
  };
  return test.assert_true(stopped && completed.get() == 2 && after && partial && finished.get() == 1 && polls.get() == 5);
}

function agrees(format: pixels.Format): boolean {
  let source = match (pixels.create(3, 3, pixels.channels(format) * 3 + 2, format, pixels.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  let y = 0;
  while (y < 3) {
    let x = 0;
    while (x < 3) {
      let alpha: u8 = 255;
      if (pixels.channels(format) == 4) { alpha = (x * 80 + y * 10) as u8; }
      source = match (pixels.write_pixel(source, x, y, color.rgba((x * 70) as u8, (y * 60) as u8, ((x + y) * 30) as u8, alpha))) { Ok(v) => v, Err(_) => { return false; } };
      x = x + 1;
    }
    y = y + 1;
  }
  let limits = pipeline.default_limits();
  let input = match (pipeline.from_image(source, limits)) { Ok(v) => v, Err(_) => { return false; } };
  input = match (pipeline.bilinear(input, 5, 7, limits)) { Ok(v) => v, Err(_) => { return false; } };
  input = match (pipeline.nearest(input, 2, 3, limits)) { Ok(v) => v, Err(_) => { return false; } };
  input = match (pipeline.bilinear(input, 4, 5, limits)) { Ok(v) => v, Err(_) => { return false; } };
  let empty: pixels.Image[] = [];
  let saved = cell_new(empty);
  let consume = (row: pixels.Image): Result[void, string] => {
    saved.set(saved.get().append(row));
    return Ok(());
  };
  let stats = match (pipeline.render_rows(input, 0, 5, limits, 512, never_cancel, consume)) { Ok(v) => v, Err(_) => { return false; } };
  let rows = saved.get();
  if (rows.len() != 5 || stats.hits == 0 || stats.peak_cache_bytes > 512 || stats.peak_cache_entries > 8) {
    return false;
  }
  y = 0;
  while (y < 5) {
    let reference = match (pipeline.render_row(input, y, limits, never_cancel)) { Ok(v) => v, Err(_) => { return false; } };
    let x = 0;
    while (x < 4) {
      let a = match (pixels.read_pixel(rows[y], x, 0)) { Ok(v) => v, Err(_) => { return false; } };
      let b = match (pixels.read_pixel(reference, x, 0)) { Ok(v) => v, Err(_) => { return false; } };
      if (a.r != b.r || a.g != b.g || a.b != b.b || a.a != b.a) { return false; }
      x = x + 1;
    }
    y = y + 1;
  }
  let before = match (pixels.read_pixel(rows[0], 0, 0)) { Ok(v) => v, Err(_) => { return false; } };
  let changed = match (pixels.write_pixel(rows[0], 0, 0, color.rgb(255 as u8, 0 as u8, 0 as u8))) { Ok(v) => v, Err(_) => { return false; } };
  let kept = match (pixels.read_pixel(rows[0], 0, 0)) { Ok(v) => v, Err(_) => { return false; } };
  let updated = match (pixels.read_pixel(changed, 0, 0)) { Ok(v) => v, Err(_) => { return false; } };
  return kept.r == before.r && kept.a == before.a && updated.r == 255 as u8;
}

function padded_sources(): test.TestOutcome {
  return test.assert_true(agrees(pixels.RGB8) && agrees(pixels.RGBA8));
}

function main(): i32 {
  let r = test.test_new("bounded row cache");
  r = r.it("cache reuses parent rows without changes to output", reuse);
  r = r.it("row ranges, total work, and logical scratch reject before callbacks", limits);
  r = r.it("FIFO eviction obeys byte and entry limits", eviction);
  r = r.it("generic consumer errors preserve retained rows and release the cache", consumer_errors);
  r = r.it("cancellation releases a populated cache", cancellation);
  r = r.it("padded RGB/RGBA chains preserve retained rows", padded_sources);
  return r.finish();
}
