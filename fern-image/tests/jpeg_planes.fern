import "../packages/codecs/jpeg/planes";
import "std/i32";

function never(): boolean {
  return false;
}

function emit(path: string): i32 {
  let Ok(input) = read_file_bytes(path) else {
    return 2;
  };
  let Ok(image) = planes.decode(input, planes.default_limits(), never) else {
    return 3;
  };
  print(f"begin {path} {image.plan.width} {image.plan.height} {image.plan.max_horizontal} {image.plan.max_vertical} {image.planes.len()} {image.plan.bytes}");
  let total = 0;
  for i in 0..image.planes.len() {
    let plane = image.planes[i];
    let layout = plane.layout;
    if (layout.width <= 0 || layout.height <= 0 || layout.stride != layout.width || layout.bytes != layout.width * layout.height || plane.data.len() != layout.bytes) {
      return 4;
    }
    let output = f"{path}.plane-{i}.raw";
    if let Err(_) = write_file_bytes(output, plane.data) {
      return 5;
    }
    print(f"plane {i} {layout.component} {layout.horizontal} {layout.vertical} {layout.width} {layout.height} {layout.stride} {layout.bytes}");
    total += layout.bytes;
  }
  if (total != image.plan.bytes) {
    return 6;
  }
  print("end " + path);
  return 0;
}

function main(): i32 {
  let paths = args();
  if (paths.len() < 2) {
    return 1;
  }
  for i in 1..paths.len() {
    let result = emit(paths[i]);
    if (result != 0) {
      return result;
    }
  }
  return 0;
}
