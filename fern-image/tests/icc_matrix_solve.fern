import "../packages/codecs/icc/matrix_eval";
import "../packages/codecs/icc/matrix_solve";
import "std/i32";
import "std/i64";

function signed(input: [u8], at: i32): i32 {
  let value = input[at] as i64 | input[at + 1] as i64 << 8i64 | input[at + 2] as i64 << 16i64 | input[at + 3] as i64 << 24i64;
  return (if (value >= 2147483648i64) { value - 4294967296i64 } else { value }) as i32;
}

function bits(input: [u8], at: i32): i64 {
  let result = 0i64;
  for index in 0..8 {
    result = result | input[at + index] as i64 << (index * 8) as i64;
  }
  return result;
}

function emit(path: string): i32 {
  let input = match (read_file_bytes(path)) { Ok(v) => v, Err(_) => { return 2; } };
  if (input.len() < 36 || input[0] != 70 as u8 || input[1] != 77 as u8 || input[2] != 83 as u8 || input[3] != 49 as u8) {
    return 3;
  }
  let stop = signed(input, 4);
  let count = signed(input, 8);
  if (stop < 0 || count < 0 || count > 10 || input.len() as i64 != 36i64 + count as i64 * 4i64) {
    return 4;
  }
  let coefficients: i32[] = [];
  for index in 0..count {
    coefficients = coefficients.append(signed(input, 36 + index * 4));
  }
  let polls = cell_new(0);
  let result = matrix_solve.solve(coefficients[:], matrix_eval.XYZ { x: f64_from_bits(bits(input, 12)), y: f64_from_bits(bits(input, 20)), z: f64_from_bits(bits(input, 28)) }, (): boolean => {
    polls.set(polls.get() + 1);
    return stop != 0 && polls.get() == stop;
  });
  match (result) {
    Ok(v) => {
      print("solve " + path + " ok " + polls.get().to_string() + " " + f64_bits(v.r).to_string() + " " + f64_bits(v.g).to_string() + " " + f64_bits(v.b).to_string());
    },
    Err(error) => {
      let name = match (error) { matrix_solve.SolveError.Shape => "Shape", matrix_solve.SolveError.Input => "Input", matrix_solve.SolveError.Numeric => "Numeric", matrix_solve.SolveError.Unsupported => "Unsupported", matrix_solve.SolveError.Singular => "Singular", matrix_solve.SolveError.Cancelled => "Cancelled" };
      print("solve " + path + " error " + name + " " + polls.get().to_string());
    }
  }
  return 0;
}

function main(): i32 {
  let paths = args();
  if (paths.len() < 2) {
    return 1;
  }
  for index in 1..paths.len() {
    let code = emit(paths[index]);
    if (code != 0) {
      return code;
    }
  }
  return 0;
}
