import "../packages/codecs/png/png";
import "../packages/codecs/png/provider";
import "../packages/pipeline/pipeline";
import "../packages/pipeline/regions";
import "../packages/pixels/pixels";
import "std/i32";

function error_name(error: png.PngError): string {
  return match (error) { png.Signature => "signature", png.Truncated => "truncated", png.Length => "length", png.Crc => "crc", png.Order => "order", png.Unsupported => "unsupported", png.Dimensions => "dimensions", png.Limit => "limit", png.Compressed => "compressed", png.Scanline => "scanline" };
}

function never_cancel(): boolean {
  return false;
}

function row_bytes(data: [u8], first: i32, count: i32, limits: pixels.Limits, incremental: boolean): Result[u8[], png.RowError[string]] {
  let seed: u8[] = [];
  let consume = (bytes: u8[], row: pixels.Image): Result[u8[], string] => {
    if (row.layout.height != 1 || row.layout.bytes != row.layout.stride || row.data.len() != row.layout.stride) {
      return Err("row layout");
    }
    let bytes = bytes;
    for byte in row.data {
      bytes = bytes.append(byte);
    }
    return Ok(bytes);
  };
  let result = if (incremental) { png.fold_incremental_rows(data, first, count, limits, png.default_row_limits(), never_cancel, seed, consume) } else { png.fold_rows(data, first, count, limits, png.default_row_limits(), never_cancel, seed, consume) };
  let value = result?;
  return Ok(value.value);
}

function rejected_rows(data: [u8], limits: pixels.Limits, incremental: boolean): string {
  let consume = (value: i32, _row: pixels.Image): Result[i32, string] => Ok(value);
  let result = if (incremental) { png.fold_incremental_rows(data, 0, 1, limits, png.default_row_limits(), never_cancel, 0, consume) } else { png.fold_rows(data, 0, 1, limits, png.default_row_limits(), never_cancel, 0, consume) };
  return match (result) { Err(png.RowCodec(error)) => error_name(error), _ => "unexpected" };
}

function provider_error_name(message: string): string {
  for error in [png.Signature, png.Truncated, png.Length, png.Crc, png.Order, png.Unsupported, png.Dimensions, png.Limit, png.Compressed, png.Scanline] {
    if (message == "PNG " + error.to_debug()) {
      return error_name(error);
    }
  }
  return "unexpected";
}

function rejected_provider(data: u8[], limits: pixels.Limits, incremental: boolean): string {
  let source = if (incremental) { provider.incremental_source(data, limits, png.default_row_limits(), pipeline.default_limits()) } else { provider.source(data, limits, png.default_row_limits(), pipeline.default_limits()) };
  let graph = match (source) { Ok(v) => v, Err(pipeline.ProviderFailure(e)) => { return provider_error_name(e); }, Err(_) => { return "unexpected"; } };
  let Ok(cache) = pipeline.required_cache(graph, pipeline.default_limits()) else {
    return "unexpected";
  };
  let consume = (value: i32, _row: pixels.Image): Result[i32, string] => Ok(value);
  return match (pipeline.fold_rows_fused(graph, 0, 1, pipeline.default_limits(), cache, never_cancel, 0, consume)) { Err(pipeline.GraphFailure(pipeline.ProviderFailure(e))) => provider_error_name(e), _ => "unexpected" };
}

function graph_bytes(graph: pipeline.Graph, height: i32, cache: i32, fused: boolean): Result[u8[], string] {
  let seed: u8[] = [];
  let consume = (bytes: u8[], row: pixels.Image): Result[u8[], string] => {
    if (row.layout.height != 1 || row.layout.bytes != row.layout.stride || row.data.len() != row.layout.stride) {
      return Err("graph row layout");
    }
    let bytes = bytes;
    for byte in row.data {
      bytes = bytes.append(byte);
    }
    return Ok(bytes);
  };
  let result = if (fused) { pipeline.fold_rows_fused(graph, 0, height, pipeline.default_limits(), cache, never_cancel, seed, consume) } else { pipeline.fold_rows(graph, 0, height, pipeline.default_limits(), cache, never_cancel, seed, consume) };
  return match (result) { Ok(v) => Ok(v.value), Err(_) => Err("graph execution") };
}

function inspect(path: string, index: i32): i32 {
  let Ok(data) = read_file_bytes(path) else {
    return 2;
  };
  let prefix = f"index={index}";
  let limits = pixels.Limits { max_pixels: 65536, max_bytes: 262144 };
  let image = match (png.decode(data, limits)) { Ok(v) => v, Err(e) => { print(f"{prefix} status=error error={error_name(e)} row_error={rejected_rows(data, limits, false)} provider_error={rejected_provider(data, limits, false)} incremental_error={rejected_rows(data, limits, true)} incremental_provider_error={rejected_provider(data, limits, true)}"); return 0; } };
  let Ok(rows) = row_bytes(data, 0, image.layout.height, limits, false) else {
    return 6;
  };
  let Ok(incremental_rows) = row_bytes(data, 0, image.layout.height, limits, true) else {
    return 17;
  };
  let first = image.layout.height / 2;
  let count = image.layout.height - first;
  if (count > 2) {
    count = 2;
  }
  let Ok(selected) = row_bytes(data, first, count, limits, false) else {
    return 7;
  };
  let Ok(incremental_selected) = row_bytes(data, first, count, limits, true) else {
    return 18;
  };
  for incremental in [false, true] {
    let source = if (incremental) { provider.incremental_source(data, limits, png.default_row_limits(), pipeline.default_limits()) } else { provider.source(data, limits, png.default_row_limits(), pipeline.default_limits()) };
    let Ok(graph) = source else {
      return 10;
    };
    for _ in 0..2 {
      graph = match (pipeline.nearest(graph, image.layout.width, image.layout.height, pipeline.default_limits())) { Ok(v) => v, Err(_) => { return 11; } };
    }
    let Ok(cache) = pipeline.required_cache(graph, pipeline.default_limits()) else {
      return 12;
    };
    let crop_x = image.layout.width / 2;
    let crop_width = image.layout.width - crop_x;
    if (crop_width > 2) {
      crop_width = 2;
    }
    let region = regions.Region { x: crop_x, y: first, width: crop_width, height: count };
    for fused in [false, true] {
      let suffix = if (incremental) { ".incremental" } else { "" };
      suffix += if (fused) { ".fused" } else { ".legacy" };
      let Ok(bytes) = graph_bytes(graph, image.layout.height, cache, fused) else {
        return 13;
      };
      let tile_result = if (fused) { regions.render_cached_tile_fused(graph, region, pipeline.default_limits(), cache, never_cancel) } else { regions.render_cached_tile(graph, region, pipeline.default_limits(), cache, never_cancel) };
      let tile = match (tile_result) { Ok(v) => v.image, Err(_) => { return 14; } };
      if let Err(_) = write_file_bytes(f"{path}{suffix}.graph.raw", bytes) {
        return 15;
      }
      if let Err(_) = write_file_bytes(f"{path}{suffix}.tile.raw", tile.data) {
        return 16;
      }
    }
  }
  let Ok(encoded) = png.encode(image, 1048576) else {
    return 3;
  };
  if let Err(_) = write_file_bytes(path + ".raw", image.data) {
    return 4;
  }
  if let Err(_) = write_file_bytes(path + ".encoded.png", encoded) {
    return 5;
  }
  if let Err(_) = write_file_bytes(path + ".rows.raw", rows) {
    return 8;
  }
  if let Err(_) = write_file_bytes(path + ".selected.raw", selected) {
    return 9;
  }
  if let Err(_) = write_file_bytes(path + ".incremental.rows.raw", incremental_rows) {
    return 19;
  }
  if let Err(_) = write_file_bytes(path + ".incremental.selected.raw", incremental_selected) {
    return 20;
  }
  print(f"{prefix} status=ok width={image.layout.width} height={image.layout.height} channels={pixels.channels(image.layout.format)} first={first} count={count}");
  return 0;
}

function main(): i32 {
  let av = args();
  if (av.len() < 2 || av.len() > 17) {
    return 1;
  }
  for i in 1..av.len() {
    let result = inspect(av[i], i - 1);
    if (result != 0) {
      return result;
    }
  }
  return 0;
}
