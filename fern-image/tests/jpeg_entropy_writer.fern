import "../packages/codecs/jpeg/entropy_writer";
import "../packages/codecs/jpeg/header";
import "std/binary";
import "std/hex";

function never(): boolean {
  return false;
}

function name(error: entropy_writer.EncodeError): string {
  return match (error) {
    entropy_writer.Shape => "Shape", entropy_writer.Table => "Table",
    entropy_writer.MissingSymbol => "MissingSymbol", entropy_writer.Coefficient => "Coefficient",
    entropy_writer.Limit => "Limit", entropy_writer.Cancelled => "Cancelled",
  };
}

function produced(values: [i32], dc: header.HuffmanTable, ac: header.HuffmanTable, restart: i32, limit: i32): Result[u8[], entropy_writer.EncodeError] {
  let count = if (values.len() % 64 == 0) { values.len() / 64 } else { 0 };
  let result = entropy_writer.encode_produced(
    values, count, dc, ac, restart, limit, never,
    (source: [i32], consume: ([i32]) => Result[void, entropy_writer.EncodeError]): Result[void, entropy_writer.EncodeError] => {
      for i in 0..source.len() / 64 {
        consume(source[i * 64:i * 64 + 64])?;
      }
      return Ok(());
    },
  );
  return match (result) { Ok(v) => Ok(v), Err(entropy_writer.ProducerEncode(e)) => Err(e), Err(entropy_writer.ProducerSource(e)) => Err(e) };
}

function equal(left: Result[u8[], entropy_writer.EncodeError], right: Result[u8[], entropy_writer.EncodeError]): boolean {
  match (left) {
    Err(a) => {
      return match (right) { Err(b) => a == b, _ => false };
    },
    Ok(a) => {
      let Ok(b) = right else {
        return false;
      };
      if (a.len() != b.len()) {
        return false;
      }
      for i in 0..a.len() {
        if (a[i] != b[i]) {
          return false;
        }
      }
      return true;
    }
  }
}

function emit_case(path: string): i32 {
  let Ok(data) = read_file_bytes(path) else {
    return 2;
  };
  if (data.len() < 44) {
    return 3;
  }
  let Ok(restart) = binary.read_u32_be(data, 0) else {
    return 3;
  };
  let Ok(limit) = binary.read_u32_be(data, 4) else {
    return 3;
  };
  let tables: header.HuffmanTable[] = [];
  let at = 8;
  for table_index in 0..2 {
    if (data.len() - at < 18) {
      return 3;
    }
    let counts: u8[] = [];
    for i in 0..16 {
      counts = counts.append(data[at + i]);
    }
    let count = data[at + 16] as i32 * 256 + data[at + 17] as i32;
    at += 18;
    if (count > data.len() - at) {
      return 3;
    }
    let symbols: u8[] = [];
    for i in 0..count {
      symbols = symbols.append(data[at + i]);
    }
    at += count;
    tables = tables.append(header.HuffmanTable { counts: counts, symbols: symbols });
  }
  if ((data.len() - at) % 4 != 0) {
    return 3;
  }
  let values: i32[] = [];
  while (at < data.len()) {
    let Ok(value) = binary.read_u32_be(data, at) else {
      return 3;
    };
    values = values.append(value as i32);
    at += 4;
  }
  let legacy = entropy_writer.encode_blocks(values, tables[0], tables[1], restart as i32, limit as i32, never);
  let result = produced(values, tables[0], tables[1], restart as i32, limit as i32);
  if (!equal(legacy, result)) {
    return 6;
  }
  match (result) {
    Ok(output) => {
      print(path + " ok " + hex.encode(output));
    },
    Err(error) => {
      print(path + " error " + name(error));
    }
  }
  return 0;
}

function main(): i32 {
  let paths = args();
  if (paths.len() < 2) {
    return 1;
  }
  for i in 1..paths.len() {
    let code = emit_case(paths[i]);
    if (code != 0) {
      return code;
    }
  }
  return 0;
}
