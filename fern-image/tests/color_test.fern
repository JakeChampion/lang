import "../packages/color/color";
import "../packages/pixels/pixels";
import "std/test";

function near(a: f64, b: f64): boolean {
  let difference: f64 = a - b;
  return difference < 0.000001 && difference > 0.0 - 0.000001;
}

function transfer(): test.TestOutcome {
  let good: boolean = near(color.srgb_to_linear(0.0), 0.0)
    && near(color.srgb_to_linear(1.0), 1.0)
    && near(color.srgb_to_linear(0.5), 0.21404114048223255)
    && near(color.linear_to_srgb(0.0031308), 0.040449936)
    && near(color.srgb_to_linear(0.04045), 0.00313080495356)
    && near(color.srgb_to_linear(0.0 - 1.0), 0.0)
    && near(color.linear_to_srgb(2.0), 1.0);
  let i: i32 = 0;
  while (i < 256) {
    let x: f64 = i as f64 / 255.0;
    good = good && near(color.linear_to_srgb(color.srgb_to_linear(x)), x);
    i = i + 1;
  }
  return test.assert_true(good);
}

function alpha(): test.TestOutcome {
  let p = color.rgba(200 as u8, 100 as u8, 50 as u8, 128 as u8);
  let premul = color.premultiply(p);
  let straight = color.unpremultiply(premul);
  let zero = color.unpremultiply(color.premultiply(color.with_alpha(p, 0 as u8)));
  let clamped = color.unpremultiply(color.Premultiplied { r: 255, g: 0, b: 0, a: 1 });
  return test.assert_true(premul.r == 100 as u8 && premul.g == 50 as u8 && premul.b == 25 as u8
    && straight.r == 199 as u8 && straight.g == 100 as u8 && straight.b == 50 as u8 && straight.a == 128 as u8
    && zero.r == 0 as u8 && zero.a == 0 as u8 && clamped.r == 255 as u8);
}

function composite(): test.TestOutcome {
  let black = color.rgb(0 as u8, 0 as u8, 0 as u8);
  let white = color.rgb(255 as u8, 255 as u8, 255 as u8);
  let mixed = color.source_over(color.with_alpha(white, 128 as u8), black);
  let transparent = color.with_alpha(white, 0 as u8);
  let both = color.source_over(transparent, transparent);
  let over = color.source_over(transparent, black);
  let opaque = color.source_over(white, black);
  let half = color.source_over(color.with_alpha(white, 128 as u8), color.with_alpha(black, 128 as u8));
  return test.assert_true(mixed.r == 188 as u8 && mixed.g == 188 as u8 && mixed.a == 255 as u8
    && both.r == 0 as u8 && both.a == 0 as u8 && over.r == 0 as u8 && over.a == 255 as u8
    && opaque.r == 255 as u8 && half.a == 192 as u8 && half.r == 213 as u8);
}

function gray(): test.TestOutcome {
  let black = color.grayscale(color.rgb(0 as u8, 0 as u8, 0 as u8));
  let white = color.grayscale(color.rgb(255 as u8, 255 as u8, 255 as u8));
  let red = color.grayscale(color.rgba(255 as u8, 0 as u8, 0 as u8, 17 as u8));
  let swapped = color.swap_rb(color.rgba(1 as u8, 2 as u8, 3 as u8, 4 as u8));
  return test.assert_true(black.r == 0 as u8 && white.r == 255 as u8 && red.r == 127 as u8
    && red.g == red.r && red.b == red.r && red.a == 17 as u8
    && swapped.r == 3 as u8 && swapped.g == 2 as u8 && swapped.b == 1 as u8 && swapped.a == 4 as u8);
}

function image_conversion(): Result[boolean, pixels.ImageError] {
  let image = pixels.create(2, 1, 8, pixels.RGB8, pixels.default_limits())?;
  image = pixels.write_pixel(image, 0, 0, color.rgb(11 as u8, 22 as u8, 33 as u8))?;
  image = pixels.write_pixel(image, 1, 0, color.rgb(99 as u8, 88 as u8, 77 as u8))?;
  let converted = color.to_rgba(image, pixels.default_limits())?;
  let a = pixels.read_pixel(converted, 0, 0)?;
  let b = pixels.read_pixel(converted, 1, 0)?;
  let back = color.flatten_rgb(converted, color.rgb(0 as u8, 0 as u8, 0 as u8), pixels.default_limits())?;
  let before = pixels.read_pixel(image, 1, 0)?;
  return Ok(converted.layout.stride == 8 && back.layout.stride == 6
    && a.r == 11 as u8 && a.g == 22 as u8 && a.b == 33 as u8 && a.a == 255 as u8
    && b.r == 99 as u8 && b.g == 88 as u8 && b.b == 77 as u8 && b.a == 255 as u8
    && before.r == 99 as u8 && image.data[6] == 0 as u8 && image.data[7] == 0 as u8);
}

function image_alpha(): Result[boolean, pixels.ImageError] {
  let image = pixels.create(3, 1, 16, pixels.RGBA8, pixels.default_limits())?;
  image = pixels.write_pixel(image, 0, 0, color.rgba(255 as u8, 0 as u8, 0 as u8, 0 as u8))?;
  image = pixels.write_pixel(image, 1, 0, color.rgba(255 as u8, 255 as u8, 255 as u8, 128 as u8))?;
  image = pixels.write_pixel(image, 2, 0, color.rgb(255 as u8, 0 as u8, 0 as u8))?;
  let kept = color.to_rgba(image, pixels.default_limits())?;
  let transparent = pixels.read_pixel(kept, 0, 0)?;
  let flattened = color.flatten_rgb(image, color.rgb(0 as u8, 0 as u8, 255 as u8), pixels.default_limits())?;
  let a = pixels.read_pixel(flattened, 0, 0)?;
  let b = pixels.read_pixel(flattened, 1, 0)?;
  let c = pixels.read_pixel(flattened, 2, 0)?;
  return Ok(kept.layout.stride == 12 && flattened.layout.stride == 9
    && transparent.r == 255 as u8 && transparent.a == 0 as u8
    && a.r == 0 as u8 && a.g == 0 as u8 && a.b == 255 as u8 && a.a == 255 as u8
    && b.r == 188 as u8 && b.g == 188 as u8 && b.b == 255 as u8
    && c.r == 255 as u8 && c.g == 0 as u8 && c.b == 0 as u8);
}

function converted_images(): test.TestOutcome {
  let layout = match (image_conversion()) { Ok(v) => v, Err(_) => false };
  let alpha = match (image_alpha()) { Ok(v) => v, Err(_) => false };
  return test.assert_true(layout && alpha);
}

function image_errors(): test.TestOutcome {
  let image = match (pixels.create(1, 1, 3, pixels.RGB8, pixels.default_limits())) { Ok(v) => v, Err(_) => { return test.fail("create image"); } };
  let malformed = pixels.Image { layout: image.layout, data: [] };
  let storage = match (color.to_rgba(malformed, pixels.default_limits())) { Ok(_) => false, Err(e) => e == pixels.Storage };
  let budget = match (color.to_rgba(image, pixels.Limits { max_pixels: 1, max_bytes: 3 })) { Ok(_) => false, Err(e) => e == pixels.Limit };
  let alpha = match (color.flatten_rgb(image, color.rgba(0 as u8, 0 as u8, 0 as u8, 128 as u8), pixels.default_limits())) { Ok(_) => false, Err(e) => e == pixels.Alpha };
  return test.assert_true(storage && budget && alpha);
}

function main(): i32 {
  let r = test.test_new("color M1");
  r = r.it("sRGB thresholds and exhaustive byte round trips", transfer);
  r = r.it("premultiply, unpremultiply, zero alpha and saturation", alpha);
  r = r.it("linear source over and transparent pixels", composite);
  r = r.it("linear luminance and channel operations", gray);
  r = r.it("whole-image conversion, padding, and alpha preservation", converted_images);
  r = r.it("image conversion rejects unsafe storage, budgets, and background", image_errors);
  return r.finish();
}
