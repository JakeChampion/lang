import "../packages/pipeline/pipeline";
import "../packages/pipeline/regions";
import "../packages/pixels/pixels";
import "../packages/color/color";
import "../packages/resize/resize";
import "std/test";

function never_cancel(): boolean {
  return false;
}

function graph(): Result[pipeline.Graph, pipeline.PipelineError] {
  let limits = pipeline.default_limits();
  let source = pipeline.solid(4, 2, pixels.RGBA8, color.rgba(17, 23, 99, 128), limits)?;
  return pipeline.bilinear(source, 8, 8, limits);
}

function reuse(): test.TestOutcome {
  let Ok(source) = graph() else {
    return test.fail("graph");
  };
  let region = regions.Region { x: 2, y: 0, width: 4, height: 8 };
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_scratch_bytes: 464, max_samples: 160 };
  let Ok(result) = regions.render_cached_tile(source, region, limits, 96, never_cancel) else {
    return test.fail("tile");
  };
  let Ok(plan) = regions.cached_plan(source, region, limits, 96) else {
    return test.fail("plan");
  };
  let good = result.image.layout.width == 4 && result.image.layout.height == 8 && result.image.data.len() == 128;
  for y in 0..8 {
    for x in 0..4 {
      let Ok(p) = pixels.read_pixel(result.image, x, y) else {
        return test.fail("pixel");
      };
      good = good && p.r == 17 && p.g == 23 && p.b == 99 && p.a == 128;
    }
  }
  return test.assert_true(good && plan.scratch_bytes == 464 && plan.samples == 160
    && result.stats.rows == 8 && result.stats.hits == 12 && result.stats.misses == 10
    && result.stats.peak_cache_bytes == 96 && result.stats.peak_cache_entries == 4);
}

function rejected(source: pipeline.Graph, region: regions.Region, limits: pipeline.Limits, bytes: i32, error: pipeline.PipelineError): boolean {
  let polls = cell_new(0);
  let cancelled = (): boolean => {
    polls.set(polls.get() + 1);
    return false;
  };
  let result = match (regions.render_cached_tile(source, region, limits, bytes, cancelled)) { Err(e) => e == error, _ => false };
  return result && polls.get() == 1;
}

function admission(): test.TestOutcome {
  let Ok(source) = graph() else {
    return test.fail("graph");
  };
  let region = regions.Region { x: 2, y: 0, width: 4, height: 8 };
  let limits = pipeline.Limits { ...pipeline.default_limits(), max_scratch_bytes: 464, max_samples: 160 };
  let bad = pixels.Image { layout: pixels.Layout { width: 1, height: 1, stride: 4, format: pixels.RGBA8, bytes: 4 }, data: [] };
  let forged = pipeline.Graph { nodes: [pipeline.Node { width: 1, height: 1, format: pixels.RGBA8, operation: pipeline.ImageSource(bad) }] };
  return test.assert_true(rejected(source, region, pipeline.Limits { ...limits, max_scratch_bytes: 463 }, 96, pipeline.Budget)
    && rejected(source, region, pipeline.Limits { ...limits, max_samples: 159 }, 96, pipeline.Budget)
    && rejected(source, region, limits, -1, pipeline.Budget)
    && rejected(source, region, limits, 2147483647, pipeline.Budget)
    && rejected(source, regions.Region { ...region, height: 0 }, limits, 96, pipeline.PipelineError.Dimensions)
    && rejected(source, regions.Region { ...region, x: 2147483647 }, limits, 96, pipeline.PipelineError.Bounds)
    && rejected(forged, regions.Region { x: 0, y: 0, width: 1, height: 1 }, limits, 0, pipeline.Pixel(pixels.Storage)));
}

function agrees(format: pixels.Format, bytes: i32): boolean {
  let limits = pipeline.default_limits();
  let Ok(source) = pixels.create(3, 3, pixels.channels(format) * 3 + 2, format, pixels.default_limits()) else {
    return false;
  };
  for y in 0..3 {
    for x in 0..3 {
      let alpha = if (pixels.channels(format) == 4) { (x * 70 + y * 20) as u8 } else { 255 };
      source = match (pixels.write_pixel(source, x, y, color.rgba((x * 80) as u8, (y * 60) as u8, ((x + y) * 30) as u8, alpha))) { Ok(v) => v, Err(_) => { return false; } };
    }
  }
  let Ok(input) = pipeline.from_image(source, limits) else {
    return false;
  };
  input = match (pipeline.bilinear(input, 5, 7, limits)) { Ok(v) => v, Err(_) => { return false; } };
  input = match (pipeline.nearest(input, 2, 3, limits)) { Ok(v) => v, Err(_) => { return false; } };
  input = match (pipeline.bilinear(input, 4, 5, limits)) { Ok(v) => v, Err(_) => { return false; } };
  let Ok(eager) = resize.resize(source, 5, 7, resize.Bilinear, pixels.default_limits()) else {
    return false;
  };
  eager = match (resize.resize(eager, 2, 3, resize.Nearest, pixels.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  eager = match (resize.resize(eager, 4, 5, resize.Bilinear, pixels.default_limits())) { Ok(v) => v, Err(_) => { return false; } };
  let Ok(tile) = regions.render_cached_tile(input, regions.Region { x: 1, y: 1, width: 2, height: 3 }, limits, bytes, never_cancel) else {
    return false;
  };
  if (tile.stats.rows != 3 || tile.stats.peak_cache_bytes > bytes || tile.stats.peak_cache_entries > 8) {
    return false;
  }
  for y in 0..3 {
    for x in 0..2 {
      let Ok(a) = pixels.read_pixel(tile.image, x, y) else {
        return false;
      };
      let Ok(b) = pixels.read_pixel(eager, x + 1, y + 1) else {
        return false;
      };
      if (a.r != b.r || a.g != b.g || a.b != b.b || a.a != b.a) {
        return false;
      }
    }
  }
  return true;
}

function exact_crops(): test.TestOutcome {
  let good = true;
  for bytes in [0, 1, 31, 256] {
    good = good && agrees(pixels.RGB8, bytes) && agrees(pixels.RGBA8, bytes);
  }
  return test.assert_true(good);
}

function cancellation(): test.TestOutcome {
  let limits = pipeline.default_limits();
  let Ok(source) = pipeline.solid(256, 2, pixels.RGBA8, color.rgb(1, 2, 3), limits) else {
    return test.fail("source");
  };
  source = match (pipeline.bilinear(source, 128, 8, limits)) { Ok(v) => v, Err(_) => { return test.fail("bilinear"); } };
  let region = regions.Region { x: 0, y: 0, width: 128, height: 8 };
  let good = true;
  for stop in [1, 2, 3, 8, 14, 18, 19, 20, 24, 32] {
    let polls = cell_new(0);
    let cancelled = (): boolean => {
      polls.set(polls.get() + 1);
      return polls.get() >= stop;
    };
    let result = match (regions.render_cached_tile(source, region, limits, 3072, cancelled)) { Err(pipeline.Cancelled) => true, _ => false };
    good = good && result && polls.get() == stop;
  }
  let after = match (regions.render_cached_tile(source, region, limits, 3072, never_cancel)) { Ok(v) => v.stats.rows == 8 && v.stats.hits > 0, _ => false };
  return test.assert_true(good && after);
}

function isolation(): test.TestOutcome {
  let Ok(source) = graph() else {
    return test.fail("graph");
  };
  let region = regions.Region { x: 0, y: 0, width: 8, height: 8 };
  let Ok(result) = regions.render_cached_tile(source, region, pipeline.default_limits(), 96, never_cancel) else {
    return test.fail("first");
  };
  let kept = result.image;
  let Ok(changed) = pixels.write_pixel(result.image, 0, 0, color.rgb(255, 0, 0)) else {
    return test.fail("write");
  };
  let Ok(other) = regions.render_cached_tile(source, region, pipeline.default_limits(), 96, never_cancel) else {
    return test.fail("second");
  };
  let Ok(a) = pixels.read_pixel(kept, 0, 0) else {
    return test.fail("kept");
  };
  let Ok(b) = pixels.read_pixel(changed, 0, 0) else {
    return test.fail("changed");
  };
  let Ok(c) = pixels.read_pixel(other.image, 0, 0) else {
    return test.fail("other");
  };
  return test.assert_true(a.r == 17 && a.a == 128 && b.r == 255 && c.r == 17 && c.a == 128);
}

function fold_state(): test.TestOutcome {
  let Ok(source) = graph() else {
    return test.fail("graph");
  };
  let seed: pixels.Image[] = [];
  let consume = (rows: pixels.Image[], row: pixels.Image): Result[pixels.Image[], string] => Ok(rows.append(row));
  let Ok(result) = pipeline.fold_rows(source, 0, 8, pipeline.default_limits(), 96, never_cancel, seed, consume) else {
    return test.fail("fold");
  };
  let expected = args()[0] + ": fold error after heap state";
  let fail = (state: string, _row: pixels.Image): Result[string, string] => Err(state);
  let error = match (pipeline.fold_rows(source, 0, 8, pipeline.default_limits(), 96, never_cancel, expected, fail)) { Err(pipeline.ConsumerFailure(e)) => e == expected, _ => false };
  return test.assert_true(seed.len() == 0 && result.value.len() == 8 && result.stats.hits == 12 && error);
}

function main(): i32 {
  let r = test.new("cached tile requests");
  r = r.it("cropped tiles reuse parent rows and report exact budgets", reuse);
  r = r.it("invalid requests and aggregate budgets reject before execution", admission);
  r = r.it("padded RGB/RGBA crops agree with eager output across cache sizes", exact_crops);
  r = r.it("cancellation releases cache rows and partial tile storage", cancellation);
  r = r.it("retained and modified tiles remain isolated across calls", isolation);
  r = r.it("generic folds transfer accumulator state and preserve heap errors", fold_state);
  return r.finish();
}
