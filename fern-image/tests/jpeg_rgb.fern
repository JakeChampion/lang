import "../packages/codecs/jpeg/rgb";
import "../packages/codecs/jpeg/chroma";
import "../packages/codecs/jpeg/planes";
import "std/i32";

function never(): boolean {
  return false;
}

function emit(path: string): i32 {
  let Ok(input) = read_file_bytes(path) else {
    return 2;
  };
  let accepted = false;
  for index in 0..2 {
    let filter = if (index == 0) { chroma.Filter.Nearest } else { chroma.Filter.Bilinear };
    match (rgb.decode(input, filter, rgb.default_limits(), never)) {
      Err(error) => {
        let kind = match (error) { rgb.RgbError.Unsupported => "unsupported", rgb.RgbError.Profile(_) => "profile", _ => "unexpected" };
        if (kind == "unexpected") {
          return 3;
        }
        print(f"reject {path} {index} {kind}");
      },
      Ok(image) => {
        let Ok(plan) = rgb.inspect(input, rgb.default_limits(), never) else {
          return 4;
        };
        let layout = image.layout;
        if (layout.width <= 0 || layout.height <= 0 || layout.stride != layout.width * 3 || image.data.len() != layout.bytes
          || layout.bytes != layout.stride * layout.height || plan.layout.bytes != layout.bytes || plan.input_bytes != input.len()
          || plan.row_bytes != layout.width * 6 || plan.planned_bytes != input.len() + plan.planes.bytes + layout.bytes + plan.row_bytes) {
          return 5;
        }
        if let Err(_) = write_file_bytes(f"{path}.rgb-{index}.raw", image.data) {
          return 6;
        }
        print(f"rgb {path} {index} {layout.width} {layout.height} {layout.stride} {layout.bytes} {plan.input_bytes} {plan.planes.bytes} {plan.row_bytes} {plan.planned_bytes}");
        accepted = true;
      }
    }
  }
  if (accepted) {
    let Ok(raw) = planes.decode(input, planes.default_limits(), never) else {
      return 7;
    };
    print(f"planes {path} {raw.planes.len()}");
    for index in 0..raw.planes.len() {
      let plane = raw.planes[index];
      let l = plane.layout;
      print(f"plane {index} {l.component} {l.horizontal} {l.vertical} {l.width} {l.height} {l.stride} {l.bytes}");
      if let Err(_) = write_file_bytes(f"{path}.plane-{index}.raw", plane.data) {
        return 8;
      }
    }
  }
  print("end " + path);
  return 0;
}

function main(): i32 {
  let paths = args();
  if (paths.len() < 2) {
    return 1;
  }
  for index in 1..paths.len() {
    let result = emit(paths[index]);
    if (result != 0) {
      return result;
    }
  }
  return 0;
}
