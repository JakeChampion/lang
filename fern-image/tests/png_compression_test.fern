import "../packages/codecs/png/compression";
import "std/test";

// A stored DEFLATE block contains ASCII A. Python zlib independently
// decodes this complete frame to one byte.
function frame(): u8[] {
  return [120, 1, 1, 1, 0, 254, 255, 65, 0, 66, 0, 66];
}

function rejects(input: [u8], limit: i32, expected: compression.CompressionError): boolean {
  return match (compression.decode(input, limit)) { Ok(_) => false, Err(error) => same_error(error, expected) };
}

function same_error(a: compression.CompressionError, b: compression.CompressionError): boolean {
  return match (a) { compression.CompressionError.Limit => match (b) { compression.CompressionError.Limit => true, _ => false }, compression.CompressionError.Header => match (b) { compression.CompressionError.Header => true, _ => false }, compression.CompressionError.Trailing => match (b) { compression.CompressionError.Trailing => true, _ => false }, compression.CompressionError.Checksum => match (b) { compression.CompressionError.Checksum => true, _ => false }, _ => false };
}

function exact_limit(): test.TestOutcome {
  let Ok(data) = compression.decode(frame(), 1) else {
    return test.fail("valid frame failed");
  };
  return test.assert_true(data.len() == 1 && data[0] == 65
    && rejects(frame(), 0, compression.CompressionError.Limit)
    && rejects(frame(), -1, compression.CompressionError.Limit)
    && rejects(frame(), 67108865, compression.CompressionError.Limit));
}

function headers(): test.TestOutcome {
  let input = frame();
  // Each alternate header has a valid modulo-31 check. The adapter must
  // reject its window, method, or dictionary policy independently.
  let window = input.with(0, 104).with(1, 5);
  let method = input.with(0, 119).with(1, 9);
  let dictionary = input.with(1, 32);
  return test.assert_true(rejects(window, 1, compression.CompressionError.Header)
    && rejects(method, 1, compression.CompressionError.Header)
    && rejects(dictionary, 1, compression.CompressionError.Header)
    && rejects(input.with(1, 0), 1, compression.CompressionError.Header));
}

function framing(): test.TestOutcome {
  let input = frame();
  return test.assert_true(rejects(input.append(0), 1, compression.CompressionError.Trailing)
    && rejects(input.concat(input), 1, compression.CompressionError.Trailing)
    && rejects(input.with(input.len() - 1, 0), 1, compression.CompressionError.Checksum));
}

function truncations(): test.TestOutcome {
  let input = frame();
  for end in 0..input.len() {
    match (compression.decode(input[:end], 1)) {
      Ok(_) => {
        return test.fail("accepted truncated frame");
      },
      Err(_) => {}
    }
  }
  return test.assert_true(true);
}

function main(): i32 {
  let r = test.new("strict PNG compression framing");
  r = r.it("exact output limit and invalid budgets", exact_limit);
  r = r.it("window, method, dictionary and header check", headers);
  r = r.it("trailing bytes, second stream and checksum", framing);
  r = r.it("every truncated prefix fails", truncations);
  return r.finish();
}
