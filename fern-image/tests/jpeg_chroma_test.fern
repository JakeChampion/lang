import "../packages/codecs/jpeg/chroma";
import "../packages/codecs/jpeg/planes";
import "std/test";

function never(): boolean {
  return false;
}

function plane(width: i32, height: i32, stride: i32, horizontal: i32, vertical: i32, data: u8[]): planes.SamplePlane {
  return planes.SamplePlane { layout: planes.PlaneLayout { component: 201, width: width, height: height, stride: stride, bytes: stride * height, horizontal: horizontal, vertical: vertical }, data: data };
}

function equals(actual: [u8], expected: [u8]): boolean {
  if (actual.len() != expected.len()) {
    return false;
  }
  for i in 0..actual.len() {
    if (actual[i] != expected[i]) {
      return false;
    }
  }
  return true;
}

function row_equals(source: planes.SamplePlane, grid: chroma.FrameGrid, y: i32, filter: chroma.Filter, expected: [u8]): boolean {
  return match (chroma.reconstruct_row(source, grid, y, filter, grid.width, never)) { Ok(v) => equals(v, expected), Err(_) => false };
}

function centered(): test.TestOutcome {
  let source = plane(2, 2, 2, 1, 1, [0 as u8, 100 as u8, 200 as u8, 255 as u8]);
  let grid = chroma.FrameGrid { width: 4, height: 4, max_horizontal: 2, max_vertical: 2 };
  let expected: u8[][] = [[0, 25, 75, 100], [50, 72, 117, 139], [150, 167, 200, 216], [200, 214, 241, 255]];
  for y in 0..4 {
    if (!row_equals(source, grid, y, chroma.Filter.Bilinear, expected[y])) {
      return test.fail("independent centered two-dimensional weights");
    }
    let near: u8[] = if (y < 2) { [0, 0, 100, 100] } else { [200, 200, 255, 255] };
    if (!row_equals(source, grid, y, chroma.Filter.Nearest, near)) {
      return test.fail("nearest centered component replication");
    }
  }
  let ties = plane(2, 2, 2, 1, 1, [0 as u8, 1 as u8, 1 as u8, 2 as u8]);
  return test.assert_true(row_equals(ties, grid, 1, chroma.Filter.Bilinear, [0 as u8, 1 as u8, 1 as u8, 1 as u8]));
}

function padded_identity(): test.TestOutcome {
  let source = plane(3, 2, 5, 2, 3, [10 as u8, 20 as u8, 30 as u8, 250 as u8, 251 as u8, 40 as u8, 50 as u8, 60 as u8, 252 as u8, 253 as u8]);
  let grid = chroma.FrameGrid { width: 3, height: 2, max_horizontal: 2, max_vertical: 3 };
  for filter in [chroma.Filter.Nearest, chroma.Filter.Bilinear] {
    if (!row_equals(source, grid, 0, filter, [10 as u8, 20 as u8, 30 as u8])
      || !row_equals(source, grid, 1, filter, [40 as u8, 50 as u8, 60 as u8])) {
      return test.fail("identity ignores source row padding");
    }
  }
  return test.pass();
}

function fractional_and_crop(): test.TestOutcome {
  let source = plane(2, 1, 2, 2, 1, [10 as u8, 50 as u8]);
  let grid = chroma.FrameGrid { width: 3, height: 1, max_horizontal: 3, max_vertical: 1 };
  if (!row_equals(source, grid, 0, chroma.Filter.Nearest, [10 as u8, 50 as u8, 50 as u8])
    || !row_equals(source, grid, 0, chroma.Filter.Bilinear, [10 as u8, 30 as u8, 50 as u8])) {
    return test.fail("fractional ratio and nearest half tie");
  }
  let cropped = plane(3, 1, 3, 1, 1, [0 as u8, 100 as u8, 200 as u8]);
  let odd = chroma.FrameGrid { width: 5, height: 1, max_horizontal: 2, max_vertical: 1 };
  return test.assert_true(row_equals(cropped, odd, 0, chroma.Filter.Bilinear, [0 as u8, 25 as u8, 75 as u8, 125 as u8, 175 as u8]));
}

function rejects(source: planes.SamplePlane, grid: chroma.FrameGrid, y: i32, limit: i32, error: chroma.ChromaError): boolean {
  let polls = cell_new(0);
  let result = chroma.reconstruct_row(source, grid, y, chroma.Filter.Bilinear, limit, (): boolean => {
    polls.set(polls.get() + 1);
    return true;
  });
  return polls.get() == 0 && match (result) { Err(e) => e == error, Ok(_) => false };
}

function admission(): test.TestOutcome {
  let source = plane(2, 1, 2, 1, 1, [0 as u8, 255 as u8]);
  let grid = chroma.FrameGrid { width: 4, height: 1, max_horizontal: 2, max_vertical: 1 };
  if (!rejects(source, chroma.FrameGrid { ...grid, width: 0 }, 0, 4, chroma.ChromaError.Grid)
    || !rejects(source, chroma.FrameGrid { ...grid, height: 65536 }, 0, 4, chroma.ChromaError.Grid)
    || !rejects(source, chroma.FrameGrid { ...grid, max_horizontal: 5 }, 0, 4, chroma.ChromaError.Sampling)
    || !rejects(planes.SamplePlane { layout: planes.PlaneLayout { ...source.layout, horizontal: 0 }, data: source.data }, grid, 0, 4, chroma.ChromaError.Sampling)) {
    return test.fail("grid and factor validation");
  }
  if (!rejects(plane(1, 1, 1, 1, 1, [0 as u8]), grid, 0, 4, chroma.ChromaError.Storage)
    || !rejects(plane(2, 1, 1, 1, 1, [0 as u8]), grid, 0, 4, chroma.ChromaError.Storage)
    || !rejects(planes.SamplePlane { layout: source.layout, data: [0 as u8] }, grid, 0, 4, chroma.ChromaError.Storage)
    || !rejects(planes.SamplePlane { layout: planes.PlaneLayout { ...source.layout, bytes: 3 }, data: source.data }, grid, 0, 4, chroma.ChromaError.Storage)
    || !rejects(plane(2, 1, 2147483647, 1, 1, [0 as u8]), grid, 0, 4, chroma.ChromaError.Limit)) {
    return test.fail("caller-constructed storage validation");
  }
  if (!rejects(source, grid, 0 - 1, 4, chroma.ChromaError.Bounds) || !rejects(source, grid, 1, 4, chroma.ChromaError.Bounds)
    || !rejects(source, grid, 0, 0, chroma.ChromaError.Limit) || !rejects(source, grid, 0, 3, chroma.ChromaError.Limit)) {
    return test.fail("row and exact output-byte admission");
  }
  return test.assert_true(row_equals(source, grid, 0, chroma.Filter.Nearest, [0 as u8, 0 as u8, 255 as u8, 255 as u8]));
}

function ownership(): test.TestOutcome {
  let source = plane(2, 1, 2, 1, 1, [0 as u8, 200 as u8]);
  let grid = chroma.FrameGrid { width: 4, height: 1, max_horizontal: 2, max_vertical: 1 };
  let shared = cell_new(source);
  let first = match (chroma.reconstruct_row(source, grid, 0, chroma.Filter.Bilinear, 4, (): boolean => {
    let old = shared.get();
    shared.set(planes.SamplePlane { layout: old.layout, data: old.data.with(0, 255 as u8) });
    return false;
  })) { Ok(v) => v, Err(_) => { return test.fail("callback input update"); } };
  let retained = first;
  first = first.with(0, 99 as u8);
  let again = match (chroma.reconstruct_row(source, grid, 0, chroma.Filter.Bilinear, 4, never)) { Ok(v) => v, Err(_) => { return test.fail("fresh row"); } };
  return test.assert_true(equals(retained, [0 as u8, 50 as u8, 150 as u8, 200 as u8]) && equals(again, retained) && first[0] == 99 as u8 && source.data[0] == 0 as u8 && shared.get().data[0] == 255 as u8);
}

function cancellation(): test.TestOutcome {
  let bytes: u8[] = [];
  for i in 0..262 {
    bytes = bytes.append((i % 256) as u8);
  }
  let source = plane(129, 2, 131, 1, 1, bytes);
  let grid = chroma.FrameGrid { width: 257, height: 3, max_horizontal: 2, max_vertical: 2 };
  for filter in [chroma.Filter.Nearest, chroma.Filter.Bilinear] {
    let count = cell_new(0);
    match (chroma.reconstruct_row(source, grid, 1, filter, 257, (): boolean => {
      count.set(count.get() + 1);
      return false;
    })) {
      Ok(_) => {},
      Err(_) => {
        return test.fail("cancel census");
      }
    }
    if (count.get() != 8) {
      return test.fail("group and final cancellation polls");
    }
    for stop in 1..count.get() + 1 {
      let seen = cell_new(0);
      match (chroma.reconstruct_row(source, grid, 1, filter, 257, (): boolean => {
        seen.set(seen.get() + 1);
        return seen.get() == stop;
      })) {
        Err(chroma.ChromaError.Cancelled()) => {},
        _ => {
          return test.fail("every cancellation offset");
        }
      }
      if (seen.get() != stop) {
        return test.fail("work after cancellation");
      }
    }
  }
  return test.pass();
}

function main(): i32 {
  let runner = test.new("centered JPEG component rows");
  runner = runner.it("independent centered filters and one final half-tie rounding", centered);
  runner = runner.it("identity phase and padded source rows", padded_identity);
  runner = runner.it("fractional factors and odd-frame cropping", fractional_and_crop);
  runner = runner.it("forged layouts, grids, bounds, and exact byte admission", admission);
  runner = runner.it("callback input updates and independent owned output rows", ownership);
  runner = runner.it("every cancellation poll for both filters", cancellation);
  return runner.finish();
}
