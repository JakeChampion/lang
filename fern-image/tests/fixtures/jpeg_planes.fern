import "std/hex";

function bytes(text: string): u8[] {
  return match (hex.decode(text)) { Ok(v) => v, Err(_) => [] };
}

pub function restart_gray(component: i32): u8[] {
  return match (component) { 0 => bytes(""), _ => [] };
}

pub function restart_rgb444(component: i32): u8[] {
  return match (component) { 0 => bytes(""), 1 => bytes(""), 2 => bytes(""), _ => [] };
}

pub function restart_rgb420(component: i32): u8[] {
  return match (component) { 0 => bytes(""), 1 => bytes(""), 2 => bytes(""), _ => [] };
}

pub function arbitrary_identifiers(component: i32): u8[] {
  return match (component) { 0 => bytes("80808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080"), 1 => bytes("80808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080"), 2 => bytes("80808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080"), _ => [] };
}

pub function fractional_sampling(component: i32): u8[] {
  return match (component) { 0 => bytes(""), 1 => bytes("808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080"), 2 => bytes("808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080808080"), _ => [] };
}

pub function single_sampling(component: i32): u8[] {
  return match (component) { 0 => bytes(""), _ => [] };
}
