import "std/hex";

function bytes(text: string): u8[] {
  return match (hex.decode(text)) { Ok(v) => v, Err(_) => [] };
}

pub function input(index: i32): u8[] {
  return match (index) { 0 => bytes(""), 1 => bytes(""), 2 => bytes(""), 3 => bytes(""), 4 => bytes(""), 5 => bytes(""), _ => [] };
}

pub function nearest(index: i32): u8[] {
  return match (index) { 0 => bytes(""), 1 => bytes(""), 2 => bytes(""), 3 => bytes(""), 4 => bytes("000000"), 5 => bytes(""), _ => [] };
}

pub function bilinear(index: i32): u8[] {
  return match (index) { 0 => bytes(""), 1 => bytes(""), 2 => bytes(""), 3 => bytes(""), 4 => bytes("000000"), 5 => bytes(""), _ => [] };
}
