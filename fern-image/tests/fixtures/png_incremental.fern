import "std/hex";

// Offline zlib fixtures use all five filters and a zero Adler A at the first chunk boundary.

pub function wide_rgb(): u8[] {
  let Ok(bytes) = hex.decode("") else {
    return [];
  };
  return bytes;
}

pub function wide_rgba(): u8[] {
  let Ok(bytes) = hex.decode("") else {
    return [];
  };
  return bytes;
}

pub function bad_filter_and_checksum(): u8[] {
  let Ok(bytes) = hex.decode("89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000001649444154789c636064626661656365e7e0e4e2e6010001b200554d0655140000000049454e44ae426082") else {
    return [];
  };
  return bytes;
}

pub function expected(y: i32, at: i32): u8 {
  if (y == 0) {
    if (at < 256) {
      return 255 as u8;
    }
    if (at == 256) {
      return 240 as u8;
    }
    return 0 as u8;
  }
  return ((at * 37 + y * 11 + at / 251) % 256) as u8;
}
