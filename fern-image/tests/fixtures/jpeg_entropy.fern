import "std/hex";

function bytes(text: string): u8[] {
  return match (hex.decode(text)) { Ok(v) => v, Err(_) => [] };
}

pub function category_boundaries(): u8[] {
  return bytes("");
}

pub function signed(): u8[] {
  return bytes("ffd8ffdb00430001010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101ffc4002a000003000000000000000000000000000000010210000003000000000000000000000000000001f0ffc0000b080008000801011100ffda0008010100003f0093443fffd9");
}

pub function predictor(): u8[] {
  return bytes("ffd8ffdb00430001010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101ffc4002a000003000000000000000000000000000000010210000003000000000000000000000000000001f0ffc0000b080008001001011100ffda0008010100003f009344287fffd9");
}

