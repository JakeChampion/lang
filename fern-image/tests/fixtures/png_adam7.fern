    6 => ("", png.Scanline),
    7 => ("", png.Scanline),
    8 => ("", png.Compressed),
    9 => ("", png.Compressed),
    10 => ("", png.Unsupported),
    11 => ("", png.Scanline),
    _ => ("", png.Signature),
  };
  let Ok(encoded) = hex.decode(text) else {
    return ([], png.Signature);
  };
  return (encoded, error);
}
