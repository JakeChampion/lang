pub function bad(index: i32): (u8[], png.PngError) {
  let (text, error) = match (index) {
    0 => ("", png.Scanline),
    1 => ("", png.Scanline),
    2 => ("", png.Scanline),
    3 => ("", png.Scanline),
    4 => ("", png.Scanline),
