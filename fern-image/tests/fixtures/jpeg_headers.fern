import "std/hex";

function bytes(text: string): u8[] {
  return match (hex.decode(text)) { Ok(value) => value, Err(_) => [] };
}

pub function gray(): u8[] {
  return bytes("");
}

pub function rgb444(): u8[] {
  return bytes("");
}

pub function rgb422(): u8[] {
  return bytes("");
}

pub function rgb420(): u8[] {
  return bytes("");
}

pub function gray_optimized(): u8[] {
  return bytes("");
}

pub function rgb420_optimized(): u8[] {
  return bytes("");
}

pub function progressive(): u8[] {
  return bytes("");
}

pub function cmyk(): u8[] {
  return bytes("");
}

pub function synthetic_header(): u8[] {
  return bytes("ffd8ffdb0043000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40ffc40026000100000000000000000000000000000000100100000000000000000000000000000000ffc0000b080009001101011100ffda0008010100003f00");
}
