import "std/test";
import "std/i32";
import "std/i64";
import "std/string";

function log2_milli(n: i32): i32 {
  if (n <= 1) {
    return 0;
  }
  let e: i32 = 0;
  let v: i32 = n;
  while (v > 1) {
    v = v / 2;
    e = e + 1;
  }
  let x: i64 = n as i64 * 1048576 / (1 as i64 << e);
  let frac: i64 = 0;
  let bit: i64 = 524288;
  for i in 0..20 {
    x = x * x / 1048576;
    if (x >= 2097152) {
      x = x / 2;
      frac = frac + bit;
    }
    bit = bit / 2;
  }
  return (e as i64 * 1000 + frac * 1000 / 1048576) as i32;
}

function is_lower(b: i32): boolean {
  return b >= 97 && b <= 122;
}

function is_upper(b: i32): boolean {
  return b >= 65 && b <= 90;
}

function is_digit(b: i32): boolean {
  return b >= 48 && b <= 57;
}

function pool_of(pw: string): i32 {
  let lower: boolean = false;
  let upper: boolean = false;
  let digit: boolean = false;
  let other: boolean = false;
  for i in 0..pw.len() {
    let b: i32 = pw[i] as i32;
    if (is_lower(b)) {
      lower = true;
    } else if (is_upper(b)) {
      upper = true;
    } else if (is_digit(b)) {
      digit = true;
    } else {
      other = true;
    }
  }
  let pool: i32 = 0;
  if (lower) {
    pool = pool + 26;
  }
  if (upper) {
    pool = pool + 26;
  }
  if (digit) {
    pool = pool + 10;
  }
  if (other) {
    pool = pool + 33;
  }
  return pool;
}

function predictable_positions(pw: string): i32 {
  let n: i32 = 0;
  for i in 1..pw.len() {
    let prev: i32 = pw[i - 1] as i32;
    let cur: i32 = pw[i] as i32;
    if (cur == prev || cur == prev + 1 || cur == prev - 1) {
      n = n + 1;
    }
  }
  return n;
}

function effective_len(pw: string): i32 {
  if (pw.len() == 0) {
    return 0;
  }
  let e: i32 = pw.len() - predictable_positions(pw);
  if (e < 1) {
    return 1;
  }
  return e;
}

function entropy_milli(pw: string): i32 {
  let pool: i32 = pool_of(pw);
  if (pool <= 1) {
    return 0;
  }
  return effective_len(pw) * log2_milli(pool);
}

function verdict(pw: string): string {
  let bits: i32 = entropy_milli(pw) / 1000;
  if (bits < 28) {
    return "very weak";
  }
  if (bits < 36) {
    return "weak";
  }
  if (bits < 60) {
    return "reasonable";
  }
  if (bits < 128) {
    return "strong";
  }
  return "very strong";
}

function fixed3(m: i32): string {
  let whole: i32 = m / 1000;
  let frac: i32 = m % 1000;
  if (frac < 0) {
    frac = 0 - frac;
  }
  let pad: string = "";
  if (frac < 100) {
    pad = "0";
  }
  if (frac < 10) {
    pad = "00";
  }
  return whole.to_string() + "." + pad + frac.to_string();
}

function ref_inputs(): i32[] {
  return [1, 2, 3, 4, 5, 6, 7, 10, 26, 36, 52, 62, 95, 100, 1000, 65536];
}

function ref_log2_milli(): i32[] {
  return [
    0, 1000, 1585, 2000, 2322, 2585, 2807, 3322, 4700, 5170, 5700,
    5954, 6570, 6644, 9966, 16000,
  ];
}

function test_log2_is_exact_on_powers_and_close_elsewhere(): test.TestOutcome {
  let p: i32 = 1;
  for k in 0..31 {
    let got: i32 = log2_milli(p);
    if (got != k * 1000) {
      return test.fail("log2(2^" + k.to_string() + ") = "
        + fixed3(got) + ", must be exactly " + k.to_string() + ".000");
    }
    if (k < 30) {
      p = p * 2;
    }
  }
  let xs: i32[] = ref_inputs();
  let want: i32[] = ref_log2_milli();
  for i in 0..xs.len() {
    let got: i32 = log2_milli(xs[i]);
    let d: i32 = got - want[i];
    if (d < 0) {
      d = 0 - d;
    }
    if (d > 1) {
      return test.fail("log2(" + xs[i].to_string() + ") = " + fixed3(got)
        + ", reference says " + fixed3(want[i]) + " (off by "
        + d.to_string() + " thousandths)");
    }
  }
  return test.pass();
}

function test_log2_is_monotone_and_never_flat_across_a_doubling(): test.TestOutcome {
  let prev: i32 = -1;
  for n in 1..2000 {
    let got: i32 = log2_milli(n);
    if (got < prev) {
      return test.fail("log2 fell from " + fixed3(prev) + " to "
        + fixed3(got) + " at n=" + n.to_string());
    }
    prev = got;
  }
  for n in 1..1000 {
    if (log2_milli(n * 2) - log2_milli(n) != 1000) {
      return test.fail("log2(" + (n * 2).to_string() + ") - log2("
        + n.to_string() + ") = "
        + fixed3(log2_milli(n * 2) - log2_milli(n))
        + ", doubling must add exactly 1.000 bit");
    }
  }
  return test.pass();
}

function test_the_pool_is_the_union_of_the_classes_present(): test.TestOutcome {
  let cases: string[] = [
    "abc", "ABC", "123", "!@#", "abcABC", "abc123",
    "abcABC123", "abcABC123!@#", "aab", "ab",
  ];
  let want: i32[] = [26, 26, 10, 33, 52, 36, 62, 95, 26, 26];
  for i in 0..cases.len() {
    let got: i32 = pool_of(cases[i]);
    if (got != want[i]) {
      return test.fail("\"" + cases[i] + "\": pool " + got.to_string()
        + ", wanted " + want[i].to_string());
    }
  }
  let base: string = "abc";
  let grown: string[] = ["abcA", "abc1", "abc!", "abcA1!"];
  for i in 0..grown.len() {
    if (pool_of(grown[i]) <= pool_of(base)) {
      return test.fail("\"" + grown[i] + "\" has pool "
        + pool_of(grown[i]).to_string() + ", not more than \""
        + base + "\"'s " + pool_of(base).to_string());
    }
  }
  return test.pass();
}

function test_entropy_is_effective_length_times_pool_bits(): test.TestOutcome {
  let pws: string[] = ["password", "Tr0ub4dor", "correcthorse", "x", "aA1!"];
  for i in 0..pws.len() {
    let want: i32 = effective_len(pws[i]) * log2_milli(pool_of(pws[i]));
    if (entropy_milli(pws[i]) != want) {
      return test.fail("\"" + pws[i] + "\": entropy "
        + fixed3(entropy_milli(pws[i])) + " != effective length "
        + effective_len(pws[i]).to_string() + " x pool bits "
        + fixed3(log2_milli(pool_of(pws[i]))));
    }
  }
  if (entropy_milli("qwfpgjlu") != 8 * 4700) {
    return test.fail("8 unstructured lowercase characters scored "
      + fixed3(entropy_milli("qwfpgjlu")) + ", wanted "
      + fixed3(8 * 4700));
  }
  return test.pass();
}

function test_structure_scores_below_the_same_characters_unstructured(): test.TestOutcome {
  let structured: string[] = ["aaaaaaaa", "abcdefgh", "12345678", "hgfedcba"];
  let free: string[] = ["qwfpgjlu", "qwfpgjlu", "48159372", "qwfpgjlu"];
  for i in 0..structured.len() {
    if (structured[i].len() != free[i].len()) {
      return test.fail("the comparison is not like for like: \""
        + structured[i] + "\" and \"" + free[i] + "\" differ in length");
    }
    if (entropy_milli(structured[i]) >= entropy_milli(free[i])) {
      return test.fail("\"" + structured[i] + "\" scored "
        + fixed3(entropy_milli(structured[i])) + " against \""
        + free[i] + "\"'s " + fixed3(entropy_milli(free[i]))
        + " — structure cost nothing");
    }
  }
  if (effective_len("aaaaaaaaaa") != 1) {
    return test.fail("ten identical characters have effective length "
      + effective_len("aaaaaaaaaa").to_string() + ", not 1");
  }
  if (entropy_milli("aaaaaaaaaa") != 4700) {
    return test.fail("ten identical lowercase characters scored "
      + fixed3(entropy_milli("aaaaaaaaaa")) + ", wanted one character's"
      + " worth (4.700)");
  }
  return test.pass();
}

function test_entropy_grows_with_length(): test.TestOutcome {
  let pw: string = "q";
  let prev: i32 = entropy_milli(pw);
  let pad: string = "acegikmortvxz";
  for i in 0..pad.len() {
    pw = pw + ("" + slice_unchecked(pad, i, i + 1));
    let now: i32 = entropy_milli(pw);
    if (now <= prev) {
      return test.fail("\"" + pw + "\" (" + fixed3(now)
        + ") did not score above its " + i.to_string()
        + "-character prefix (" + fixed3(prev) + ")");
    }
    prev = now;
  }
  return test.pass();
}

function test_a_predictable_character_adds_nothing(): test.TestOutcome {
  let base: string = "qacegik";
  let b: i32 = entropy_milli(base);
  let predictable: string[] = [base + "k", base + "l", base + "j"];
  let why: string[] = ["a repeat", "the next letter", "the previous letter"];
  for i in 0..predictable.len() {
    let got: i32 = entropy_milli(predictable[i]);
    if (got != b) {
      return test.fail("appending " + why[i] + " to \"" + base
        + "\" moved the score from " + fixed3(b) + " to "
        + fixed3(got) + "; a predictable character is not a choice");
    }
  }
  if (entropy_milli(base + "z") <= b) {
    return test.fail("appending an unrelated character did not raise the"
      + " score, so this test proves nothing");
  }
  return test.pass();
}

function test_the_empty_password_is_zero_not_a_crash(): test.TestOutcome {
  if (pool_of("") != 0) {
    return test.fail("the empty password has pool "
      + pool_of("").to_string());
  }
  if (entropy_milli("") != 0) {
    return test.fail("the empty password scored " + fixed3(entropy_milli("")));
  }
  if (effective_len("") != 0) {
    return test.fail("the empty password has effective length "
      + effective_len("").to_string());
  }
  if (verdict("") != "very weak") {
    return test.fail("the empty password is \"" + verdict("") + "\"");
  }
  return test.pass();
}

function test_the_verdict_never_goes_backwards(): test.TestOutcome {
  let names: string[] = [
    "very weak", "weak", "reasonable", "strong",
    "very strong",
  ];
  let last: i32 = 0;
  for bits in 0..200 {
    let pw: string = "";
    let chars: string = "qwfpgjluyzxkvmnbrstdheaio";
    let need: i32 = bits * 1000 / 4700 + 1;
    for i in 0..need {
      pw = pw + ("" + slice_unchecked(chars, i * 7 % chars.len(), i * 7 % chars.len() + 1));
    }
    let v: string = verdict(pw);
    let idx: i32 = -1;
    for k in 0..names.len() {
      if (names[k] == v) {
        idx = k;
      }
    }
    if (idx < 0) {
      return test.fail("unknown verdict \"" + v + "\"");
    }
    if (idx < last) {
      return test.fail("a longer password went backwards: \"" + v
        + "\" after \"" + names[last] + "\" at " + bits.to_string()
        + " bits");
    }
    last = idx;
  }
  return test.pass();
}

function main(): i32 {
  eprint("passcheck — entropy in integers, because log2 does not build for wasm");
  let pws: string[] = [
    "password", "aaaaaaaa", "abcdefgh", "qwfpgjlu",
    "Tr0ub4dor&3", "correcthorsebatterystaple",
    "x", "", "P@ssw0rd!2024",
  ];
  for i in 0..pws.len() {
    let pw: string = pws[i];
    let shown: string = pw;
    if (pw.len() == 0) {
      shown = "(empty)";
    }
    eprint("  " + shown);
    eprint("    pool " + pool_of(pw).to_string() + " -> "
      + fixed3(log2_milli(pool_of(pw))) + " bits/char"
      + ", length " + pw.len().to_string()
      + " -> effective " + effective_len(pw).to_string());
    eprint("    entropy " + fixed3(entropy_milli(pw)) + " bits — "
      + verdict(pw));
  }

  let t: test.TestRunner = test.test_new("passcheck");
  t = t.it("log2 is exact on powers and close elsewhere", test_log2_is_exact_on_powers_and_close_elsewhere);
  t = t.it("log2 is monotone and never flat across a doubling", test_log2_is_monotone_and_never_flat_across_a_doubling);
  t = t.it("the pool is the union of the classes present", test_the_pool_is_the_union_of_the_classes_present);
  t = t.it("entropy is effective length times pool bits", test_entropy_is_effective_length_times_pool_bits);
  t = t.it("structure scores below the same characters unstructured", test_structure_scores_below_the_same_characters_unstructured);
  t = t.it("entropy grows with length", test_entropy_grows_with_length);
  t = t.it("a predictable character adds nothing", test_a_predictable_character_adds_nothing);
  t = t.it("the empty password is zero not a crash", test_the_empty_password_is_zero_not_a_crash);
  t = t.it("the verdict never goes backwards", test_the_verdict_never_goes_backwards);
  return t.finish();
}
