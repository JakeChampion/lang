import "std/test";
import "std/strdist";
import "std/string";
import "std/i32";

struct Ranked { name: string, distance: i32 }

function edit_distance(a: string, b: string): i32 {
  let n = a.len();
  let m = b.len();
  if (n == 0) {
    return m;
  }
  if (m == 0) {
    return n;
  }

  let prev: i32[] = [];
  let j = 0;
  while (j <= m) {
    prev = prev.append(j);
    j += 1;
  }

  let i = 1;
  while (i <= n) {
    let cur: i32[] = [i];
    let k = 1;
    while (k <= m) {
      let cost = 1;
      if (a[i - 1] as i32 == b[k - 1] as i32) {
        cost = 0;
      }
      let del = prev[k] + 1;
      let ins = cur[k - 1] + 1;
      let sub = prev[k - 1] + cost;
      let best = del;
      if (ins < best) {
        best = ins;
      }
      if (sub < best) {
        best = sub;
      }
      cur = cur.append(best);
      k += 1;
    }
    prev = cur;
    i += 1;
  }
  return prev[m];
}

function max_distance(typed: string): i32 {
  return typed.len() / 3 + 1;
}

function rank(typed: string, candidates: string[]): Ranked[] {
  let out: Ranked[] = [];
  let limit = max_distance(typed);
  let i = 0;
  while (i < candidates.len()) {
    let d = edit_distance(typed, candidates[i]);
    if (d <= limit) {
      out = out.append(Ranked { name: candidates[i], distance: d });
    }
    i += 1;
  }
  let a = 1;
  while (a < out.len()) {
    let b = a;
    while (b > 0) {
      let lo = out[b - 1];
      let hi = out[b];
      let swap = false;
      if (hi.distance < lo.distance) {
        swap = true;
      }
      if (hi.distance == lo.distance && name_lt(hi.name, lo.name)) {
        swap = true;
      }
      if (!swap) {
        break;
      }
      out = out.with(b - 1, hi);
      out = out.with(b, lo);
      b -= 1;
    }
    a += 1;
  }
  return out;
}

function name_lt(a: string, b: string): boolean {
  let n = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  let i = 0;
  while (i < n) {
    let x = a[i] as i32;
    let y = b[i] as i32;
    if (x != y) {
      return x < y;
    }
    i += 1;
  }
  return a.len() < b.len();
}

function suggest(typed: string, candidates: string[]): Option[string] {
  let r = rank(typed, candidates);
  if (r.len() == 0) {
    return None;
  }
  return Some(r[0].name);
}

function hint(typed: string, candidates: string[]): string {
  match (suggest(typed, candidates)) {
    None => {
      return "unknown name \"" + typed + "\"";
    },
    Some(s) => {
      return "unknown name \"" + typed + "\" (did you mean \"" + s + "\"?)";
    }
  }
}

function api(): string[] {
  return [
    "rng_seed", "rng_next", "rng_below", "rng_between",
    "shuffle", "choice", "sample",
  ];
}

function test_distance_agrees_with_stdlib(): test.TestOutcome {
  let words: string[] = [
    "", "a", "ab", "abc", "kitten", "sitting",
    "rng_seed", "rng_sed", "flaw", "lawn",
  ];
  for i in 0..words.len() {
    for j in 0..words.len() {
      let mine = edit_distance(words[i], words[j]);
      let theirs = strdist.levenshtein(words[i], words[j]);
      if (mine != theirs) {
        return test.fail("distance(\"" + words[i] + "\", \"" + words[j]
          + "\"): mine=" + mine.to_string()
          + " strdist=" + theirs.to_string());
      }
    }
  }
  return test.pass();
}

function test_known_distances(): test.TestOutcome {
  if (edit_distance("kitten", "sitting") != 3) {
    return test.fail("kitten/sitting should be 3");
  }
  if (edit_distance("flaw", "lawn") != 2) {
    return test.fail("flaw/lawn should be 2");
  }
  if (edit_distance("abc", "abc") != 0) {
    return test.fail("identical strings should be 0");
  }
  if (edit_distance("", "abc") != 3) {
    return test.fail("empty to abc should be 3");
  }
  return test.pass();
}

function test_distance_is_a_metric(): test.TestOutcome {
  let w: string[] = ["", "a", "abc", "kitten", "sitting", "rng_below"];
  for i in 0..w.len() {
    if (edit_distance(w[i], w[i]) != 0) {
      return test.fail("d(x,x) != 0 for \"" + w[i] + "\"");
    }
    for j in 0..w.len() {
      if (edit_distance(w[i], w[j]) != edit_distance(w[j], w[i])) {
        return test.fail("asymmetric on \"" + w[i] + "\"/\"" + w[j] + "\"");
      }
      if (i != j && edit_distance(w[i], w[j]) == 0) {
        return test.fail("d == 0 for different strings");
      }
      for k in 0..w.len() {
        let direct = edit_distance(w[i], w[k]);
        let via = edit_distance(w[i], w[j]) + edit_distance(w[j], w[k]);
        if (direct > via) {
          return test.fail("triangle inequality violated");
        }
      }
    }
  }
  return test.pass();
}

function test_a_typo_finds_its_neighbour(): test.TestOutcome {
  let cases: string[] = ["rng_sed", "rng_nex", "rng_belw", "shufle"];
  let wants: string[] = ["rng_seed", "rng_next", "rng_below", "shuffle"];
  for i in 0..cases.len() {
    match (suggest(cases[i], api())) {
      None => {
        return test.fail("no suggestion for \"" + cases[i] + "\"");
      },
      Some(got) => {
        if (got != wants[i]) {
          return test.fail("\"" + cases[i] + "\" suggested \"" + got
            + "\", wanted \"" + wants[i] + "\"");
        }
      }
    }
  }
  return test.pass();
}

function test_an_unrelated_name_gets_no_suggestion(): test.TestOutcome {
  let junk: string[] = ["zzzzzzqqqqq", "http_get", "parse_json", "xyzzy"];
  for i in 0..junk.len() {
    match (suggest(junk[i], api())) {
      Some(s) => {
        return test.fail("\"" + junk[i] + "\" was offered \"" + s + "\"");
      },
      None => {}
    }
  }
  return test.pass();
}

function test_short_names_are_stricter(): test.TestOutcome {
  let candidates: string[] = ["cat", "dog", "cow"];
  match (suggest("bat", candidates)) {
    None => {
      return test.fail("bat should reach cat at distance 1");
    },
    Some(s) => {
      if (s != "cat") {
        return test.fail("bat suggested " + s);
      }
    }
  }
  match (suggest("elephant", candidates)) {
    Some(s2) => {
      return test.fail("elephant was offered " + s2);
    },
    None => {}
  }
  return test.pass();
}

function test_ranking_is_ordered_and_deterministic(): test.TestOutcome {
  let cands: string[] = ["rng_next", "rng_seed", "rng_below"];
  let r1 = rank("rng_", cands);
  let r2 = rank("rng_", cands);
  if (r1.len() != r2.len()) {
    return test.fail("ranking length varied");
  }
  for i in 0..r1.len() {
    if (r1[i].name != r2[i].name) {
      return test.fail("ranking order varied at " + i.to_string());
    }
    if (i > 0 && r1[i - 1].distance > r1[i].distance) {
      return test.fail("ranking is not nearest-first");
    }
    if (i > 0 && r1[i - 1].distance == r1[i].distance
      && name_lt(r1[i].name, r1[i - 1].name)) {
      return test.fail("ties are not alphabetical");
    }
  }
  return test.pass();
}

function test_an_exact_name_ranks_first_at_zero(): test.TestOutcome {
  let r = rank("shuffle", api());
  if (r.len() == 0) {
    return test.fail("exact name produced no ranking");
  }
  if (r[0].name != "shuffle" || r[0].distance != 0) {
    return test.fail("exact name did not rank first at distance 0");
  }
  return test.pass();
}

function main(): i32 {
  eprint("didyoumean — ranking candidates, and knowing when to stay quiet");
  let typed: string[] = ["rng_sed", "shufle", "sampl", "zzzzzzqqqqq", "http_get"];
  for i in 0..typed.len() {
    eprint("  " + hint(typed[i], api()));
  }

  let r = test.new("didyoumean");
  r = r.it("distance agrees with stdlib", test_distance_agrees_with_stdlib);
  r = r.it("known distances", test_known_distances);
  r = r.it("distance is a metric", test_distance_is_a_metric);
  r = r.it("a typo finds its neighbour", test_a_typo_finds_its_neighbour);
  r = r.it("an unrelated name gets no suggestion", test_an_unrelated_name_gets_no_suggestion);
  r = r.it("short names are stricter", test_short_names_are_stricter);
  r = r.it("ranking is ordered and deterministic", test_ranking_is_ordered_and_deterministic);
  r = r.it("an exact name ranks first at zero", test_an_exact_name_ranks_first_at_zero);
  return r.finish();
}
