import "std/test";
import "std/i32";

struct Clock { t: i32[] }

enum Ord {
  Before,
  After,
  Equal,
  Concurrent,
}

function clock_new(nodes: i32): Clock {
  let v: i32[] = [];
  let i: i32 = 0;
  while (i < nodes) {
    v = v.append(0);
    i = i + 1;
  }
  return Clock { t: v };
}

function tick(c: Clock, node: i32): Clock {
  return Clock { t: c.t.with(node, c.t[node] + 1) };
}

function merge(recv: Clock, sent: Clock, node: i32): Clock {
  let v: i32[] = recv.t;
  let i: i32 = 0;
  while (i < v.len()) {
    if (sent.t[i] > v[i]) {
      v = v.with(i, sent.t[i]);
    }
    i = i + 1;
  }
  return tick(Clock { t: v }, node);
}

function dominates(a: Clock, b: Clock): boolean {
  let i: i32 = 0;
  while (i < a.t.len()) {
    if (a.t[i] > b.t[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function equal(a: Clock, b: Clock): boolean {
  let i: i32 = 0;
  while (i < a.t.len()) {
    if (a.t[i] != b.t[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function compare(a: Clock, b: Clock): Ord {
  if (equal(a, b)) {
    return Equal;
  }
  let ab: boolean = dominates(a, b);
  let ba: boolean = dominates(b, a);
  if (ab) {
    return Before;
  }
  if (ba) {
    return After;
  }
  return Concurrent;
}

function ord_name(o: Ord): string {
  match (o) {
    Before => {
      return "before";
    },
    After => {
      return "after";
    },
    Equal => {
      return "equal";
    },
    Concurrent => {
      return "concurrent";
    }
  }
}

function render(c: Clock): string {
  let s: string = "[";
  for i in 0..c.t.len() {
    if (i > 0) {
      s = s + " ";
    }
    s = s + c.t[i].to_string();
  }
  return s + "]";
}

function test_a_local_event_advances_one_entry(): test.TestOutcome {
  let a: Clock = clock_new(3);
  let b: Clock = tick(a, 1);
  if (b.t[0] != 0 || b.t[2] != 0) {
    return test.fail("tick disturbed another node's entry");
  }
  if (b.t[1] != 1) {
    return test.fail("tick did not advance its own entry");
  }
  match (compare(a, b)) {
    Before => {},
    _ => {
      return test.fail("a tick should put the new clock after the old");
    }
  }
  return test.pass();
}

function test_independent_events_are_concurrent(): test.TestOutcome {
  let base: Clock = clock_new(3);
  let p: Clock = tick(base, 0);
  let q: Clock = tick(base, 1);
  let fwd: Ord = compare(p, q);
  match (fwd) {
    Concurrent => {},
    _ => {
      return test.fail("independent events compared " + ord_name(fwd));
    }
  }
  let rev: Ord = compare(q, p);
  match (rev) {
    Concurrent => {},
    _ => {
      return test.fail("the reverse compared " + ord_name(rev));
    }
  }
  return test.pass();
}

function test_a_message_orders_the_two_nodes(): test.TestOutcome {
  let n0: Clock = tick(clock_new(2), 0);
  let n1: Clock = tick(clock_new(2), 1);
  match (compare(n0, n1)) {
    Concurrent => {},
    _ => {
      return test.fail("precondition: those should be concurrent");
    }
  }
  let after: Clock = merge(n1, n0, 1);
  let o: Ord = compare(n0, after);
  match (o) {
    Before => {},
    _ => {
      return test.fail("after receiving, the send should be before the "
        + "receive; got " + ord_name(o));
    }
  }
  return test.pass();
}

function test_the_order_is_consistent(): test.TestOutcome {
  let base: Clock = clock_new(3);
  let a: Clock = tick(base, 0);
  let b: Clock = tick(a, 1);
  match (compare(a, a)) {
    Equal => {},
    _ => {
      return test.fail("a clock is not equal to itself");
    }
  }
  match (compare(a, b)) {
    Before => {},
    _ => {
      return test.fail("a should be before b");
    }
  }
  match (compare(b, a)) {
    After => {},
    _ => {
      return test.fail("b should be after a");
    }
  }
  return test.pass();
}

function test_happens_before_is_transitive(): test.TestOutcome {
  let a: Clock = tick(clock_new(3), 0);
  let b: Clock = merge(tick(clock_new(3), 1), a, 1);
  let c: Clock = merge(tick(clock_new(3), 2), b, 2);
  let ac: Ord = compare(a, c);
  match (ac) {
    Before => {},
    _ => {
      return test.fail("a should be before c through b; got "
        + ord_name(ac));
    }
  }
  return test.pass();
}

function test_merge_keeps_the_pointwise_max(): test.TestOutcome {
  let sender: Clock = tick(tick(clock_new(2), 0), 0);
  let recv: Clock = merge(clock_new(2), sender, 1);
  if (recv.t[0] != 2) {
    return test.fail("merge lost the sender's history: " + render(recv));
  }
  let again: Clock = merge(recv, sender, 1);
  if (again.t[0] != 2) {
    return test.fail("re-merging changed the sender's entry");
  }
  if (again.t[1] != 2) {
    return test.fail("re-merging did not tick the receiver");
  }
  return test.pass();
}

function main(): i32 {
  eprint("vector_clock — a partial order over distributed events");
  let a: Clock = tick(clock_new(3), 0);
  let b: Clock = tick(clock_new(3), 1);
  eprint("  A " + render(a) + "  B " + render(b)
    + "  -> " + ord_name(compare(a, b)));
  let b2: Clock = merge(b, a, 1);
  eprint("  A " + render(a) + "  B' " + render(b2)
    + "  -> " + ord_name(compare(a, b2)));
  let c: Clock = merge(tick(clock_new(3), 2), b2, 2);
  eprint("  A " + render(a) + "  C " + render(c)
    + "  -> " + ord_name(compare(a, c)));

  let r: test.TestRunner = test.test_new("vector_clock");
  r = r.it("a local event advances one entry", test_a_local_event_advances_one_entry);
  r = r.it("independent events are concurrent", test_independent_events_are_concurrent);
  r = r.it("a message orders the two nodes", test_a_message_orders_the_two_nodes);
  r = r.it("the order is consistent", test_the_order_is_consistent);
  r = r.it("happens-before is transitive", test_happens_before_is_transitive);
  r = r.it("merge keeps the pointwise max", test_merge_keeps_the_pointwise_max);
  return r.finish();
}
