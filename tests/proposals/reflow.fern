import "std/test";
import "std/i32";
import "std/string";

struct Block { kind: string, indent: string, words: string[], count: i32 }

function no_words(): string[] {
  let e: string[] = [];

  return e;
}

function is_space_byte(b: u8): boolean {
  return b == 32 || b == 9;
}

function is_blank(line: string): boolean {
  let i = 0;
  while (i < line.len()) {
    if (!is_space_byte(line[i])) {
      return false;
    }
    i += 1;
  }
  return true;
}

function indent_of(line: string): string {
  let i = 0;
  while (i < line.len() && is_space_byte(line[i])) {
    i += 1;
  }
  return line.take(i).to_owned();
}

function words_of(line: string): string[] {
  let out = no_words();
  let i = 0;
  while (i < line.len()) {
    while (i < line.len() && is_space_byte(line[i])) {
      i += 1;
    }
    let start = i;
    while (i < line.len() && !is_space_byte(line[i])) {
      i += 1;
    }
    if (i > start) {
      out = out.append(line.drop(start).take(i - start).to_owned());
    }
  }
  return out;
}

function concat(a: string[], b: string[]): string[] {
  let out = a;
  let i = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i += 1;
  }
  return out;
}

function join_lines(lines: string[]): string {
  let out = "";
  let i = 0;
  while (i < lines.len()) {
    if (i > 0) {
      out += "\n";
    }
    out += lines[i];
    i += 1;
  }
  return out;
}

function parse(text: string): Block[] {
  let lines = text.split("\n");
  let blocks: Block[] = [];
  let i = 0;
  while (i < lines.len()) {
    if (is_blank(lines[i])) {
      let n = 0;
      while (i < lines.len() && is_blank(lines[i])) {
        n += 1;
        i += 1;
      }
      blocks = blocks.append(Block { kind: "blank", indent: "", words: no_words(), count: n });
    } else {
      let ind = indent_of(lines[i]);
      let ws = no_words();
      while (i < lines.len() && !is_blank(lines[i]) && indent_of(lines[i]) == ind) {
        ws = concat(ws, words_of(lines[i]));
        i += 1;
      }
      blocks = blocks.append(Block { kind: "para", indent: ind, words: ws, count: 0 });
    }
  }
  return blocks;
}

function avail_for(indent: string, width: i32): i32 {
  let a = width - indent.len();
  if (a < 1) {
    a = 1;
  }
  return a;
}

function wrap(indent: string, words: string[], width: i32): string[] {
  let avail = avail_for(indent, width);
  let lines: string[] = [];
  let cur = "";
  let i = 0;
  while (i < words.len()) {
    if (cur.len() == 0) {
      cur = words[i];
    } else if (cur.len() + 1 + words[i].len() <= avail) {
      cur = cur + " " + words[i];
    } else {
      lines = lines.append(indent + cur);
      cur = words[i];
    }
    i += 1;
  }
  if (cur.len() > 0) {
    lines = lines.append(indent + cur);
  }
  return lines;
}

function reflow(text: string, width: i32): string {
  let blocks = parse(text);
  let lines: string[] = [];
  let i = 0;
  while (i < blocks.len()) {
    if (blocks[i].kind == "blank") {
      let n = 0;
      while (n < blocks[i].count) {
        lines = lines.append("");
        n += 1;
      }
    } else {
      lines = concat(lines, wrap(blocks[i].indent, blocks[i].words, width));
    }
    i += 1;
  }
  return join_lines(lines);
}

function join_range(words: string[], from: i32, to: i32): string {
  let out = "";
  let i = from;
  while (i < to) {
    if (i > from) {
      out += " ";
    }
    out += words[i];
    i += 1;
  }
  return out;
}

function bf_wrap(indent: string, words: string[], width: i32): string[] {
  let avail = avail_for(indent, width);
  let lines: string[] = [];
  let i = 0;
  while (i < words.len()) {
    let best = 1;
    let k = 1;
    while (i + k <= words.len()) {
      if (join_range(words, i, i + k).len() <= avail) {
        best = k;
      }
      k += 1;
    }
    lines = lines.append(indent + join_range(words, i, i + best));
    i += best;
  }
  return lines;
}

function docs(): string[] {
  let d: string[] = [];
  d = d.append("the quick brown fox jumps over the lazy dog and keeps going for a while");
  d = d.append("one two three\nfour five six\nseven eight");
  d = d.append("first paragraph here with several words\n\nsecond paragraph also with words");
  d = d.append("above\n\n\n\nbelow after three blanks");
  d = d.append("    an indented paragraph that will need more than one line to hold it");
  d = d.append("flush left line here\n    indented continuation that is its own paragraph");
  d = d.append("\n\nleading blanks then text\n\n");
  d = d.append("a\nb\nc\nd\ne\nf\ng\nh");
  d = d.append("short then supercalifragilisticexpialidocious then short again");
  d = d.append("spaced    out     words\twith\ttabs   between   them");
  d = d.append("a naïve word and a café to measure in bytes not characters");
  d = d.append("");
  d = d.append("      six space indent\n      second line same indent\n   three space indent");
  return d;
}

function widths(): i32[] {
  return [8, 12, 20, 40];
}

function all_words(text: string): string[] {
  let out = no_words();
  let lines = text.split("\n");
  let i = 0;
  while (i < lines.len()) {
    out = concat(out, words_of(lines[i]));
    i += 1;
  }
  return out;
}

function words_equal(a: string[], b: string[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

function show_words(ws: string[]): string {
  let out = "";
  let i = 0;
  while (i < ws.len()) {
    if (i > 0) {
      out += " ";
    }
    out += ws[i];
    i += 1;
  }
  return out;
}

function count_lines(text: string): i32 {
  return text.split("\n").len();
}

function test_the_word_sequence_is_unchanged(): test.TestOutcome {
  let ds = docs();
  let ws = widths();
  let i = 0;
  while (i < ds.len()) {
    let j = 0;
    while (j < ws.len()) {
      let before = all_words(ds[i]);
      let after = all_words(reflow(ds[i], ws[j]));
      if (!words_equal(before, after)) {
        return test.fail("doc " + i.to_string() + " at width " + ws[j].to_string()
          + ": words were [" + show_words(before) + "] and became ["
          + show_words(after) + "]");
      }
      j += 1;
    }
    i += 1;
  }
  return test.pass();
}

function test_no_line_is_wider_than_asked_unless_it_is_one_word(): test.TestOutcome {
  let ds = docs();
  let ws = widths();
  let i = 0;
  while (i < ds.len()) {
    let j = 0;
    while (j < ws.len()) {
      let lines = reflow(ds[i], ws[j]).split("\n");
      let k = 0;
      while (k < lines.len()) {
        if (lines[k].len() > ws[j] && words_of(lines[k]).len() != 1) {
          return test.fail("doc " + i.to_string() + " at width " + ws[j].to_string()
            + ": line \"" + lines[k] + "\" is " + lines[k].len().to_string()
            + " wide and holds " + words_of(lines[k]).len().to_string() + " words");
        }
        k += 1;
      }
      j += 1;
    }
    i += 1;
  }
  return test.pass();
}

function test_every_line_is_full(): test.TestOutcome {
  let ds = docs();
  let ws = widths();
  let i = 0;
  while (i < ds.len()) {
    let j = 0;
    while (j < ws.len()) {
      let blocks = parse(ds[i]);
      let b = 0;
      while (b < blocks.len()) {
        if (blocks[b].kind == "para") {
          let limit = blocks[b].indent.len() + avail_for(blocks[b].indent, ws[j]);
          let lines = wrap(blocks[b].indent, blocks[b].words, ws[j]);
          let k = 0;
          while (k + 1 < lines.len()) {
            let next_word = words_of(lines[k + 1])[0];
            if (lines[k].len() + 1 + next_word.len() <= limit) {
              return test.fail("doc " + i.to_string() + " at width "
                + ws[j].to_string() + ": \"" + next_word
                + "\" would have fitted on \"" + lines[k] + "\"");
            }
            k += 1;
          }
        }
        b += 1;
      }
      j += 1;
    }
    i += 1;
  }
  return test.pass();
}

function test_blank_runs_and_indents_survive(): test.TestOutcome {
  let ds = docs();
  let ws = widths();
  let i = 0;
  while (i < ds.len()) {
    let j = 0;
    while (j < ws.len()) {
      let before = parse(ds[i]);
      let after = parse(reflow(ds[i], ws[j]));
      if (before.len() != after.len()) {
        return test.fail("doc " + i.to_string() + " at width " + ws[j].to_string()
          + ": " + before.len().to_string() + " blocks became "
          + after.len().to_string());
      }
      let b = 0;
      while (b < before.len()) {
        if (before[b].kind != after[b].kind) {
          return test.fail("doc " + i.to_string() + " block " + b.to_string()
            + ": " + before[b].kind + " became " + after[b].kind);
        }
        if (before[b].count != after[b].count) {
          return test.fail("doc " + i.to_string() + " block " + b.to_string()
            + ": blank run of " + before[b].count.to_string() + " became "
            + after[b].count.to_string());
        }
        if (before[b].indent != after[b].indent) {
          return test.fail("doc " + i.to_string() + " block " + b.to_string()
            + ": indent of " + before[b].indent.len().to_string()
            + " became " + after[b].indent.len().to_string());
        }
        b += 1;
      }
      j += 1;
    }
    i += 1;
  }
  return test.pass();
}

function test_reflowing_twice_changes_nothing(): test.TestOutcome {
  let ds = docs();
  let ws = widths();
  let i = 0;
  while (i < ds.len()) {
    let j = 0;
    while (j < ws.len()) {
      let once = reflow(ds[i], ws[j]);
      let twice = reflow(once, ws[j]);
      if (once != twice) {
        return test.fail("doc " + i.to_string() + " at width " + ws[j].to_string()
          + " is not a fixed point:\n--- once ---\n" + once
          + "\n--- twice ---\n" + twice);
      }
      j += 1;
    }
    i += 1;
  }
  return test.pass();
}

function test_a_wider_target_never_needs_more_lines(): test.TestOutcome {
  let ds = docs();
  let ws = widths();
  let i = 0;
  while (i < ds.len()) {
    let j = 1;
    while (j < ws.len()) {
      let narrow = count_lines(reflow(ds[i], ws[j - 1]));
      let wide = count_lines(reflow(ds[i], ws[j]));
      if (wide > narrow) {
        return test.fail("doc " + i.to_string() + ": width " + ws[j - 1].to_string()
          + " gives " + narrow.to_string() + " lines but width "
          + ws[j].to_string() + " gives " + wide.to_string());
      }
      j += 1;
    }
    i += 1;
  }
  return test.pass();
}

function test_the_greedy_fill_matches_the_brute_force_one(): test.TestOutcome {
  let ds = docs();
  let ws = widths();
  let i = 0;
  while (i < ds.len()) {
    let j = 0;
    while (j < ws.len()) {
      let blocks = parse(ds[i]);
      let b = 0;
      while (b < blocks.len()) {
        if (blocks[b].kind == "para") {
          let fast = wrap(blocks[b].indent, blocks[b].words, ws[j]);
          let slow = bf_wrap(blocks[b].indent, blocks[b].words, ws[j]);
          if (!words_equal(fast, slow)) {
            return test.fail("doc " + i.to_string() + " block " + b.to_string()
              + " at width " + ws[j].to_string() + ": greedy gave\n"
              + join_lines(fast) + "\nbrute force gave\n" + join_lines(slow));
          }
        }
        b += 1;
      }
      j += 1;
    }
    i += 1;
  }
  return test.pass();
}

function test_an_indent_change_starts_a_new_paragraph(): test.TestOutcome {
  let src = "alpha beta\n    gamma delta\nepsilon";
  let out = reflow(src, 40);
  if (out != "alpha beta\n    gamma delta\nepsilon") {
    return test.fail("expected three separately indented lines, got:\n" + out);
  }
  let blocks = parse(src);
  if (blocks.len() != 3) {
    return test.fail("expected 3 blocks, got " + blocks.len().to_string());
  }
  if (blocks[1].indent.len() != 4) {
    return test.fail("middle paragraph lost its indent");
  }
  return test.pass();
}

function test_an_indent_wider_than_the_target(): test.TestOutcome {
  let src = "        deeply indented words here";
  let out = reflow(src, 4);
  let lines = out.split("\n");
  if (lines.len() != 4) {
    return test.fail("expected one word per line, got " + lines.len().to_string()
      + " lines:\n" + out);
  }
  let i = 0;
  while (i < lines.len()) {
    if (words_of(lines[i]).len() != 1) {
      return test.fail("line \"" + lines[i] + "\" holds "
        + words_of(lines[i]).len().to_string() + " words");
    }
    if (indent_of(lines[i]).len() != 8) {
      return test.fail("line \"" + lines[i] + "\" lost the 8-column indent");
    }
    i += 1;
  }
  if (!words_equal(all_words(src), all_words(out))) {
    return test.fail("words were lost: [" + show_words(all_words(out)) + "]");
  }
  return test.pass();
}

function main(): i32 {
  eprint("reflow — paragraphs to a column width, indentation and blanks kept");

  let demo: string = "The quick brown fox jumps over the lazy dog.\n"
    + "It did so repeatedly, and with some enthusiasm.\n"
    + "\n"
    + "    An indented aside, which is its own paragraph because its\n"
    + "    indentation differs from the text around it.\n"
    + "\n"
    + "Back to the left margin for a closing remark.";

  let ws: i32[] = [28, 44];
  let i = 0;
  while (i < ws.len()) {
    eprint("");
    eprint("  --- width " + ws[i].to_string() + " ---");
    let lines = reflow(demo, ws[i]).split("\n");
    let k = 0;
    while (k < lines.len()) {
      eprint("  |" + lines[k]);
      k += 1;
    }
    i += 1;
  }

  let r = test.new("reflow");
  r = r.it("the word sequence is unchanged", test_the_word_sequence_is_unchanged);
  r = r.it("no line is wider than asked unless it is one word", test_no_line_is_wider_than_asked_unless_it_is_one_word);
  r = r.it("every line is full", test_every_line_is_full);
  r = r.it("blank runs and indents survive", test_blank_runs_and_indents_survive);
  r = r.it("reflowing twice changes nothing", test_reflowing_twice_changes_nothing);
  r = r.it("a wider target never needs more lines", test_a_wider_target_never_needs_more_lines);
  r = r.it("the greedy fill matches the brute force one", test_the_greedy_fill_matches_the_brute_force_one);
  r = r.it("an indent change starts a new paragraph", test_an_indent_change_starts_a_new_paragraph);
  r = r.it("an indent wider than the target", test_an_indent_wider_than_the_target);
  return r.finish();
}
