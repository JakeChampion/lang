import "std/test";
import "std/i32";
import "std/string";

struct Cookie { name: string, value: string }

function parse_pair(seg: string): Option[Cookie] {
  let Some(at) = seg.index_of("=") else {
    return None;
  };
  let name = seg.take(at).trim().to_owned();
  let value = seg.drop(at + 1).trim().to_owned();
  if (name.len() == 0) {
    return None;
  }
  return Some(Cookie { name: name, value: value });
}

function parse(header: string): Cookie[] {
  let out: Cookie[] = [];
  let segs = header.split(";");
  let i = 0;
  while (i < segs.len()) {
    match (parse_pair(segs[i])) {
      Some(c) => {
        out = out.append(c);
      },
      None => {}
    }
    i += 1;
  }
  return out;
}

function first(cs: Cookie[], name: string): Option[string] {
  let i = 0;
  while (i < cs.len()) {
    if (cs[i].name == name) {
      return Some(cs[i].value);
    }
    i += 1;
  }
  return None;
}

function all(cs: Cookie[], name: string): string[] {
  let out: string[] = [];
  let i = 0;
  while (i < cs.len()) {
    if (cs[i].name == name) {
      out = out.append(cs[i].value);
    }
    i += 1;
  }
  return out;
}

function serialize(cs: Cookie[]): string {
  let out = "";
  let i = 0;
  while (i < cs.len()) {
    if (i > 0) {
      out += "; ";
    }
    out = out + cs[i].name + "=" + cs[i].value;
    i += 1;
  }
  return out;
}

function render(cs: Cookie[]): string {
  let out = "";
  let i = 0;
  while (i < cs.len()) {
    out = out + cs[i].name + "\x1f" + cs[i].value + "\x1e";
    i += 1;
  }
  return out;
}

function pads(): string[] {
  return ["", " ", "\t", "  ", " \t ", "\t\t"];
}

function test_whitespace_is_tolerated_everywhere(): test.TestOutcome {
  let inputs: string[] = ["a=1;b=2", "sid=abc;theme=dark", "x=1;y=2;z=3"];
  let p = pads();
  let n = 0;
  let ii = 0;
  while (ii < inputs.len()) {
    let want = render(parse(inputs[ii]));
    let segs = inputs[ii].split(";");

    let a = 0;
    while (a < p.len()) {
      let b = 0;
      while (b < p.len()) {
        let c = 0;
        while (c < p.len()) {
          let d = 0;
          while (d < p.len()) {
            let built = "";
            let s = 0;
            while (s < segs.len()) {
              if (s > 0) {
                built += ";";
              }
              let nm = "";
              let vl = segs[s].to_owned();
              if let Some(at) = segs[s].index_of("=") {
                nm = segs[s].take(at).to_owned();
                vl = segs[s].drop(at + 1).to_owned();
              }
              built = built + p[a] + nm + p[b] + "=" + p[c] + vl + p[d];
              s += 1;
            }
            let got = render(parse(built));
            if (got != want) {
              return test.fail("padding changed the parse of \""
                + inputs[ii] + "\": \"" + built + "\" gave a different result");
            }
            n += 1;
            d += 1;
          }
          c += 1;
        }
        b += 1;
      }
      a += 1;
    }
    ii += 1;
  }
  if (n < 1000) {
    return test.fail("sweep only covered " + n.to_string() + " spellings");
  }
  return test.pass();
}

function test_whitespace_inside_a_value_is_preserved(): test.TestOutcome {
  let cs = parse("greeting=hello world; pad=a  b");
  match (first(cs, "greeting")) {
    Some(v) => {
      if (v != "hello world") {
        return test.fail("inner space lost: \"" + v + "\"");
      }
    },
    None => {
      return test.fail("greeting missing");
    }
  }
  match (first(cs, "pad")) {
    Some(v) => {
      if (v != "a  b") {
        return test.fail("inner run collapsed: \"" + v + "\"");
      }
    },
    None => {
      return test.fail("pad missing");
    }
  }
  let padded = parse("  greeting  =  hello world  ;  pad = a  b  ");
  if (render(padded) != render(cs)) {
    return test.fail("padding disturbed an inner-space value: \""
      + render(padded) + "\" vs \"" + render(cs) + "\"");
  }
  return test.pass();
}

function test_only_the_first_equals_separates(): test.TestOutcome {
  let cases: string[] = ["t=a=b", "t=YWJjZA==", "t====", "t=a=b=c=d"];
  let i = 0;
  while (i < cases.len()) {
    let want = cases[i].drop(2).to_owned();
    match (first(parse(cases[i]), "t")) {
      Some(v) => {
        if (v != want) {
          return test.fail("\"" + cases[i] + "\" gave value \"" + v
            + "\", want \"" + want + "\"");
        }
      },
      None => {
        return test.fail("\"" + cases[i] + "\" parsed to nothing");
      }
    }
    i += 1;
  }
  return test.pass();
}

function test_empty_value_differs_from_no_equals(): test.TestOutcome {
  let withEq = parse("a=");
  if (withEq.len() != 1) {
    return test.fail("\"a=\" produced " + withEq.len().to_string() + " cookies, want 1");
  }
  match (first(withEq, "a")) {
    Some(v) => {
      if (v != "") {
        return test.fail("\"a=\" value not empty: \"" + v + "\"");
      }
    },
    None => {
      return test.fail("\"a=\" lost its name");
    }
  }
  let noEq = parse("a");
  if (noEq.len() != 0) {
    return test.fail("\"a\" should be ignored, produced " + noEq.len().to_string());
  }
  if (parse("=v").len() != 0) {
    return test.fail("\"=v\" should be ignored");
  }
  if (parse("  =  ").len() != 0) {
    return test.fail("\"  =  \" should be ignored");
  }
  return test.pass();
}

function test_empty_segments_are_skipped(): test.TestOutcome {
  let want = render(parse("a=1;b=2"));
  let variants: string[] = [
    "a=1;;b=2", "a=1;b=2;", ";a=1;b=2", "a=1; ;b=2",
    "a=1;;;b=2;;", "a=1;junk;b=2", "  ;a=1;  ;b=2;  ",
  ];
  let i = 0;
  while (i < variants.len()) {
    let got = render(parse(variants[i]));
    if (got != want) {
      return test.fail("\"" + variants[i] + "\" did not parse as \"a=1;b=2\"");
    }
    i += 1;
  }
  return test.pass();
}

function test_duplicates_are_kept_in_order(): test.TestOutcome {
  let cs = parse("id=first; other=x; id=second; id=third");
  if (cs.len() != 4) {
    return test.fail("wanted 4 cookies, got " + cs.len().to_string());
  }
  match (first(cs, "id")) {
    Some(v) => {
      if (v != "first") {
        return test.fail("first(id) = \"" + v + "\"");
      }
    },
    None => {
      return test.fail("id missing");
    }
  }
  let every = all(cs, "id");
  if (every.len() != 3) {
    return test.fail("all(id) returned " + every.len().to_string() + ", want 3");
  }
  if (every[0] != "first" || every[1] != "second" || every[2] != "third") {
    return test.fail("all(id) out of order: " + every[0] + "," + every[1] + "," + every[2]);
  }
  return test.pass();
}

function test_quotes_are_part_of_the_value(): test.TestOutcome {
  match (first(parse("a=\"hello world\""), "a")) {
    Some(v) => {
      if (v != "\"hello world\"") {
        return test.fail("quotes not preserved: \"" + v + "\"");
      }
    },
    None => {
      return test.fail("quoted cookie lost");
    }
  }
  match (first(parse("a=\"oops"), "a")) {
    Some(v) => {
      if (v != "\"oops") {
        return test.fail("unbalanced quote mangled: \"" + v + "\"");
      }
    },
    None => {
      return test.fail("unbalanced-quote cookie lost");
    }
  }
  return test.pass();
}

function test_round_trip_through_the_canonical_form(): test.TestOutcome {
  let inputs: string[] = [
    "a=1;b=2", "  a = 1 ;; b = 2  ", "t=YWJjZA==",
    "greeting=hello world", "id=x;id=y", "a=", "solo=1",
  ];
  let i = 0;
  while (i < inputs.len()) {
    let once = parse(inputs[i]);
    let twice = parse(serialize(once));
    if (render(once) != render(twice)) {
      return test.fail("round trip changed \"" + inputs[i] + "\": \""
        + render(once) + "\" -> \"" + render(twice) + "\"");
    }
    if (serialize(once) != serialize(twice)) {
      return test.fail("serialize is not idempotent for \"" + inputs[i] + "\"");
    }
    i += 1;
  }
  return test.pass();
}

function test_values_are_byte_transparent(): test.TestOutcome {
  let vals: string[] = ["a,b", "a b", "{\"j\":1}", "%20", "café", "a/b+c", "\t"];
  let i = 0;
  while (i < vals.len()) {
    let want = vals[i].trim().to_owned();
    match (first(parse("k=" + vals[i]), "k")) {
      Some(v) => {
        if (v != want) {
          return test.fail("value \"" + vals[i] + "\" came back as \"" + v + "\"");
        }
      },
      None => {
        return test.fail("value \"" + vals[i] + "\" lost the cookie");
      }
    }
    i += 1;
  }
  return test.pass();
}

function test_order_is_preserved(): test.TestOutcome {
  let cs = parse("z=1; m=2; a=3");
  if (cs.len() != 3) {
    return test.fail("wanted 3, got " + cs.len().to_string());
  }
  if (cs[0].name != "z" || cs[1].name != "m" || cs[2].name != "a") {
    return test.fail("order changed: " + cs[0].name + "," + cs[1].name + "," + cs[2].name);
  }
  return test.pass();
}

function test_empty_and_degenerate_headers(): test.TestOutcome {
  if (parse("").len() != 0) {
    return test.fail("empty header produced cookies");
  }
  if (parse("   ").len() != 0) {
    return test.fail("blank header produced cookies");
  }
  if (parse(";;;").len() != 0) {
    return test.fail("separators-only produced cookies");
  }
  if (serialize(parse("")) != "") {
    return test.fail("empty did not serialize to empty");
  }
  return test.pass();
}

function main(): i32 {
  eprint("cookies — RFC 6265 Cookie-header parsing with whitespace tolerance");

  let raw = "  sid = abc123 ;; theme=dark ; token=YWJjZA== ; note=hello world ;";
  let cs = parse(raw);
  eprint("input:      " + raw);
  eprint("parsed:     " + cs.len().to_string() + " cookies");
  let i = 0;
  while (i < cs.len()) {
    eprint("  " + cs[i].name + " => \"" + cs[i].value + "\"");
    i += 1;
  }
  eprint("canonical:  " + serialize(cs));
  eprint("token:      " + match (first(cs, "token")) { Some(v) => v, None => "(none)" });
  eprint("missing:    " + match (first(cs, "nope")) { Some(v) => v, None => "(none)" });

  let r = test.new("cookies");
  r = r.it("whitespace is tolerated everywhere", test_whitespace_is_tolerated_everywhere);
  r = r.it("whitespace inside a value is preserved", test_whitespace_inside_a_value_is_preserved);
  r = r.it("only the first equals separates", test_only_the_first_equals_separates);
  r = r.it("an empty value differs from no equals", test_empty_value_differs_from_no_equals);
  r = r.it("empty segments are skipped", test_empty_segments_are_skipped);
  r = r.it("duplicates are kept in order", test_duplicates_are_kept_in_order);
  r = r.it("quotes are part of the value", test_quotes_are_part_of_the_value);
  r = r.it("round trip through the canonical form", test_round_trip_through_the_canonical_form);
  r = r.it("values are byte transparent", test_values_are_byte_transparent);
  r = r.it("order is preserved", test_order_is_preserved);
  r = r.it("empty and degenerate headers", test_empty_and_degenerate_headers);
  return r.finish();
}
