import "std/test";
import "std/i32";
import "std/string";

struct Seg { text: string, keep: string }

struct Doc { src: string, want: string }

struct Fault { at: i32, code: i32, msg: string }

struct StripR { ok: boolean, out: string, err: Fault }

function no_fault(): Fault {
  return Fault { at: 0, code: 0, msg: "" };
}

function strip(src: string): StripR {
  let out = "";
  let n = src.len();
  let i = 0;
  while (i < n) {
    let c = src[i];

    if (c == 47 && i + 1 < n && src[i + 1] == 47) {
      i += 2;
      while (i < n && src[i] != 10) {
        i += 1;
      }
      continue;
    }

    if (c == 47 && i + 1 < n && src[i + 1] == 42) {
      let start = i;
      i += 2;
      let closed = false;
      while (i < n) {
        if (src[i] == 42 && i + 1 < n && src[i + 1] == 47) {
          i += 2;
          closed = true;
          break;
        }
        i += 1;
      }
      if (!closed) {
        return StripR {
          ok: false, out: out,
          err: Fault { at: start, code: 1, msg: "unterminated block comment" },
        };
      }
      continue;
    }

    if (c == 34 || c == 39) {
      let quote = c;
      let lit_start = i;
      out += slice_unchecked(src, i, i + 1).to_owned();
      i += 1;
      let done = false;
      while (i < n) {
        let d = src[i];
        if (d == 92 && i + 1 < n) {
          out += slice_unchecked(src, i, i + 2).to_owned();
          i += 2;
          continue;
        }
        out += slice_unchecked(src, i, i + 1).to_owned();
        i += 1;
        if (d == quote) {
          done = true;
          break;
        }
      }
      if (!done) {
        let code = 2;
        let what = "unterminated string literal";
        if (quote == 39) {
          code = 3;
          what = "unterminated char literal";
        }
        return StripR { ok: false, out: out, err: Fault { at: lit_start, code: code, msg: what } };
      }
      continue;
    }

    out += slice_unchecked(src, i, i + 1).to_owned();
    i += 1;
  }
  return StripR { ok: true, out: out, err: no_fault() };
}

function pool(): Seg[] {
  return [
    Seg { text: "int x = 1;", keep: "int x = 1;" },
    Seg { text: "a /= 2;", keep: "a /= 2;" },
    Seg { text: "b = c / d;", keep: "b = c / d;" },
    Seg { text: "e = f * g;", keep: "e = f * g;" },
    Seg { text: "*/", keep: "*/" },
    Seg { text: "\n", keep: "\n" },
    Seg { text: "\"// not a comment\"", keep: "\"// not a comment\"" },
    Seg { text: "\"/* nor this */\"", keep: "\"/* nor this */\"" },
    Seg { text: "\"quote \\\" inside\"", keep: "\"quote \\\" inside\"" },
    Seg { text: "\"trailing backslash \\\\\"", keep: "\"trailing backslash \\\\\"" },
    Seg { text: "'\"'", keep: "'\"'" },
    Seg { text: "'\\''", keep: "'\\''" },
    Seg { text: "'/'", keep: "'/'" },
    Seg { text: "// gone\n", keep: "\n" },
    Seg { text: "// has a \" quote\n", keep: "\n" },
    Seg { text: "/* gone */", keep: "" },
    Seg { text: "/* has a \" quote */", keep: "" },
    Seg { text: "/* has // inside */", keep: "" },
    Seg { text: "/* has /* inside */", keep: "" },
  ];
}

function assemble(idxs: i32[]): Doc {
  let segs = pool();
  let src = "";
  let want = "";
  let i = 0;
  while (i < idxs.len()) {
    let s = segs[idxs[i]];
    src = src + s.text + " ";
    want = want + s.keep + " ";
    i += 1;
  }
  return Doc { src: src, want: want };
}

function combos(): i32[][] {
  let segs = pool();
  let n = segs.len();
  let out: i32[][] = [];
  let a = 0;
  while (a < n) {
    let b = 0;
    while (b < n) {
      out = out.append([a, b]);
      out = out.append([b, a, (a + b) % n]);
      b += 1;
    }
    a += 1;
  }
  return out;
}

function is_subsequence(sub: string, sup: string): boolean {
  let i = 0;
  let j = 0;
  while (i < sub.len() && j < sup.len()) {
    if (sub[i] == sup[j]) {
      i += 1;
    }
    j += 1;
  }
  return i == sub.len();
}

function test_exactly_the_comments_are_removed(): test.TestOutcome {
  let cs = combos();
  let i = 0;
  while (i < cs.len()) {
    let d = assemble(cs[i]);
    let r = strip(d.src);
    if (!r.ok) {
      return test.fail("combo " + i.to_string() + " `" + d.src + "` was rejected: " + r.err.msg);
    }
    if (r.out != d.want) {
      return test.fail("combo " + i.to_string() + " on `" + d.src + "`\n  got  `"
        + r.out + "`\n  want `" + d.want + "`");
    }
    i += 1;
  }
  return test.pass();
}

function test_stripping_is_idempotent(): test.TestOutcome {
  let cs = combos();
  let i = 0;
  while (i < cs.len()) {
    let d = assemble(cs[i]);
    let once = strip(d.src);
    if (!once.ok) {
      return test.fail("combo " + i.to_string() + " rejected: " + once.err.msg);
    }
    let twice = strip(once.out);
    if (!twice.ok) {
      return test.fail("combo " + i.to_string() + ": stripped output was rejected: " + twice.err.msg);
    }
    if (twice.out != once.out) {
      return test.fail("combo " + i.to_string() + " is not idempotent on `" + d.src
        + "`\n  once  `" + once.out + "`\n  twice `" + twice.out + "`");
    }
    i += 1;
  }
  return test.pass();
}

function test_the_output_is_a_subsequence_of_the_input(): test.TestOutcome {
  let cs = combos();
  let i = 0;
  while (i < cs.len()) {
    let d = assemble(cs[i]);
    let r = strip(d.src);
    if (!r.ok) {
      return test.fail("combo " + i.to_string() + " rejected: " + r.err.msg);
    }
    if (!is_subsequence(r.out, d.src)) {
      return test.fail("combo " + i.to_string() + ": output is not a subsequence of the input\n  in  `"
        + d.src + "`\n  out `" + r.out + "`");
    }
    i += 1;
  }
  return test.pass();
}

function test_a_comment_marker_inside_a_literal_survives(): test.TestOutcome {
  let cases: string[][] = [
    ["let s = \"// not a comment\";", "let s = \"// not a comment\";"],
    ["let s = \"/* nor this */\";", "let s = \"/* nor this */\";"],
    ["let c = '/';", "let c = '/';"],
    ["f(\"a//b\", \"c/*d\");", "f(\"a//b\", \"c/*d\");"],
    ["let s = \"keep\"; // drop\n", "let s = \"keep\"; \n"],
  ];
  let i = 0;
  while (i < cases.len()) {
    let r = strip(cases[i][0]);
    if (!r.ok) {
      return test.fail("`" + cases[i][0] + "` rejected: " + r.err.msg);
    }
    if (r.out != cases[i][1]) {
      return test.fail("`" + cases[i][0] + "`\n  got  `" + r.out + "`\n  want `" + cases[i][1] + "`");
    }
    i += 1;
  }
  return test.pass();
}

function test_a_quote_inside_a_comment_opens_nothing(): test.TestOutcome {
  let cases: string[][] = [
    ["a; // it's fine\nb;", "a; \nb;"],
    ["a; /* \" */ b;", "a;  b;"],
    ["a; /* ' */ b;", "a;  b;"],
    ["a; // \"\nlet s = \"kept\";", "a; \nlet s = \"kept\";"],
  ];
  let i = 0;
  while (i < cases.len()) {
    let r = strip(cases[i][0]);
    if (!r.ok) {
      return test.fail("`" + cases[i][0] + "` rejected: " + r.err.msg);
    }
    if (r.out != cases[i][1]) {
      return test.fail("`" + cases[i][0] + "`\n  got  `" + r.out + "`\n  want `" + cases[i][1] + "`");
    }
    i += 1;
  }
  return test.pass();
}

function test_a_slash_that_starts_nothing_is_kept(): test.TestOutcome {
  let cases: string[] = ["a / b", "a /= 2;", "*/", "a/b/c", "x = y / z; // gone\n"];
  let wants: string[] = ["a / b", "a /= 2;", "*/", "a/b/c", "x = y / z; \n"];
  let i = 0;
  while (i < cases.len()) {
    let r = strip(cases[i]);
    if (!r.ok) {
      return test.fail("`" + cases[i] + "` rejected: " + r.err.msg);
    }
    if (r.out != wants[i]) {
      return test.fail("`" + cases[i] + "`\n  got  `" + r.out + "`\n  want `" + wants[i] + "`");
    }
    i += 1;
  }
  return test.pass();
}

function test_escapes_decide_where_a_literal_ends(): test.TestOutcome {
  let closed = "let s = \"a\\\\\"; // gone\n";
  let want_closed = "let s = \"a\\\\\"; \n";
  let r = strip(closed);
  if (!r.ok) {
    return test.fail("escaped-backslash string rejected: " + r.err.msg);
  }
  if (r.out != want_closed) {
    return test.fail("`" + closed + "`\n  got  `" + r.out + "`\n  want `" + want_closed + "`");
  }

  let quoted = "let s = \"a\\\"b\"; // gone\n";
  let want_quoted = "let s = \"a\\\"b\"; \n";
  let q = strip(quoted);
  if (!q.ok) {
    return test.fail("escaped-quote string rejected: " + q.err.msg);
  }
  if (q.out != want_quoted) {
    return test.fail("`" + quoted + "`\n  got  `" + q.out + "`\n  want `" + want_quoted + "`");
  }
  return test.pass();
}

function test_unterminated_input_is_reported(): test.TestOutcome {
  let block = strip("a;\n/* never closed\nb;\n");
  if (block.ok) {
    return test.fail("an unterminated block comment was accepted");
  }
  if (block.err.code != 1) {
    return test.fail("block comment reported code " + block.err.code.to_string());
  }
  if (block.err.at != 3) {
    return test.fail("block comment opener is at 3, reported at " + block.err.at.to_string());
  }

  let str = strip("let s = \"never closed;\n");
  if (str.ok) {
    return test.fail("an unterminated string was accepted");
  }
  if (str.err.code != 2) {
    return test.fail("string reported code " + str.err.code.to_string());
  }
  if (str.err.at != 8) {
    return test.fail("string opener is at 8, reported at " + str.err.at.to_string());
  }

  let ch = strip("let c = 'x;\n");
  if (ch.ok) {
    return test.fail("an unterminated char literal was accepted");
  }
  if (ch.err.code != 3) {
    return test.fail("char reported code " + ch.err.code.to_string());
  }

  let eof = strip("a; // to the end");
  if (!eof.ok) {
    return test.fail("a line comment at EOF was rejected: " + eof.err.msg);
  }
  if (eof.out != "a; ") {
    return test.fail("line comment at EOF left `" + eof.out + "`");
  }
  return test.pass();
}

function main(): i32 {
  eprint("decomment — strip comments, respect literals");

  let sample: string = "int main() { // entry\n"
    + "    printf(\"// not a comment\\n\");\n"
    + "    /* block\n       spanning lines */\n"
    + "    return 0 /* trailing */ ;\n}\n";
  let r = strip(sample);
  let lines = r.out.split("\n");
  let i = 0;
  while (i < lines.len()) {
    eprint("  |" + lines[i]);
    i += 1;
  }

  let bad = strip("a;\n/* never closed\n");
  eprint("  offset " + bad.err.at.to_string() + ": " + bad.err.msg);
  eprint("  generated documents: " + combos().len().to_string());

  let t = test.new("decomment");
  t = t.it("exactly the comments are removed", test_exactly_the_comments_are_removed);
  t = t.it("stripping is idempotent", test_stripping_is_idempotent);
  t = t.it("the output is a subsequence of the input", test_the_output_is_a_subsequence_of_the_input);
  t = t.it("a comment marker inside a literal survives", test_a_comment_marker_inside_a_literal_survives);
  t = t.it("a quote inside a comment opens nothing", test_a_quote_inside_a_comment_opens_nothing);
  t = t.it("a slash that starts nothing is kept", test_a_slash_that_starts_nothing_is_kept);
  t = t.it("escapes decide where a literal ends", test_escapes_decide_where_a_literal_ends);
  t = t.it("unterminated input is reported", test_unterminated_input_is_reported);
  return t.finish();
}
