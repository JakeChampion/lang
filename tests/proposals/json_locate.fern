import "std/test";
import "std/json";
import "std/i32";

struct Loc { offset: i32, line: i32, col: i32 }

struct Scan { pos: i32, err: i32 }

function line_col(s: string, off: i32): Loc {
  let line: i32 = 1;
  let col: i32 = 1;
  let i: i32 = 0;
  let stop: i32 = off;
  if (stop > s.len()) {
    stop = s.len();
  }
  while (i < stop) {
    if (s[i] as i32 == 10) {
      line = line + 1;
      col = 1;
    } else {
      col = col + 1;
    }
    i = i + 1;
  }
  return Loc { offset: off, line: line, col: col };
}

function is_ws(b: i32): boolean {
  return b == 32 || b == 9 || b == 10 || b == 13;
}

function skip_ws(s: string, p: Scan): Scan {
  let i: i32 = p.pos;
  while (i < s.len() && is_ws(s[i] as i32)) {
    i = i + 1;
  }
  return Scan { pos: i, err: p.err };
}

function fail(p: Scan): Scan {
  if (p.err >= 0) {
    return p;
  }
  return Scan { pos: p.pos, err: p.pos };
}

function lit(s: string, p: Scan, word: string): Scan {
  if (p.pos + word.len() > s.len()) {
    return fail(p);
  }
  if (slice_unchecked(s, p.pos, p.pos + word.len()) != word) {
    return fail(p);
  }
  return Scan { pos: p.pos + word.len(), err: p.err };
}

function scan_string(s: string, p: Scan): Scan {
  if (p.pos >= s.len() || s[p.pos] as i32 != 34) {
    return fail(p);
  }
  let i: i32 = p.pos + 1;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b == 92) {
      i = i + 2;
      continue;
    }
    if (b == 34) {
      return Scan { pos: i + 1, err: p.err };
    }
    i = i + 1;
  }
  return fail(Scan { pos: s.len(), err: p.err });
}

function scan_number(s: string, p: Scan): Scan {
  let i: i32 = p.pos;
  if (i < s.len() && s[i] as i32 == 45) {
    i = i + 1;
  }
  let digits: i32 = 0;
  while (i < s.len() && s[i] as i32 >= 48 && s[i] as i32 <= 57) {
    i = i + 1;
    digits = digits + 1;
  }
  if (digits == 0) {
    return fail(p);
  }
  if (i < s.len() && s[i] as i32 == 46) {
    i = i + 1;
    let frac: i32 = 0;
    while (i < s.len() && s[i] as i32 >= 48 && s[i] as i32 <= 57) {
      i = i + 1;
      frac = frac + 1;
    }
    if (frac == 0) {
      return fail(Scan { pos: i, err: p.err });
    }
  }
  return Scan { pos: i, err: p.err };
}

function scan_value(s: string, p0: Scan, depth: i32): Scan {
  if (depth > 64) {
    return fail(p0);
  }
  let p: Scan = skip_ws(s, p0);
  if (p.pos >= s.len()) {
    return fail(p);
  }
  let b: i32 = s[p.pos] as i32;

  if (b == 34) {
    return scan_string(s, p);
  }
  if (b == 116) {
    return lit(s, p, "true");
  }
  if (b == 102) {
    return lit(s, p, "false");
  }
  if (b == 110) {
    return lit(s, p, "null");
  }
  if (b == 45 || b >= 48 && b <= 57) {
    return scan_number(s, p);
  }

  if (b == 91) {
    p = skip_ws(s, Scan { pos: p.pos + 1, err: p.err });
    if (p.pos < s.len() && s[p.pos] as i32 == 93) {
      return Scan { pos: p.pos + 1, err: p.err };
    }
    loop {
      p = scan_value(s, p, depth + 1);
      if (p.err >= 0) {
        return p;
      }
      p = skip_ws(s, p);
      if (p.pos >= s.len()) {
        return fail(p);
      }
      let c: i32 = s[p.pos] as i32;
      if (c == 44) {
        p = Scan { pos: p.pos + 1, err: p.err };
        continue;
      }
      if (c == 93) {
        return Scan { pos: p.pos + 1, err: p.err };
      }
      return fail(p);
    }
  }

  if (b == 123) {
    p = skip_ws(s, Scan { pos: p.pos + 1, err: p.err });
    if (p.pos < s.len() && s[p.pos] as i32 == 125) {
      return Scan { pos: p.pos + 1, err: p.err };
    }
    loop {
      p = skip_ws(s, p);
      p = scan_string(s, p);
      if (p.err >= 0) {
        return p;
      }
      p = skip_ws(s, p);
      if (p.pos >= s.len() || s[p.pos] as i32 != 58) {
        return fail(p);
      }
      p = scan_value(s, Scan { pos: p.pos + 1, err: p.err }, depth + 1);
      if (p.err >= 0) {
        return p;
      }
      p = skip_ws(s, p);
      if (p.pos >= s.len()) {
        return fail(p);
      }
      let c2: i32 = s[p.pos] as i32;
      if (c2 == 44) {
        p = Scan { pos: p.pos + 1, err: p.err };
        continue;
      }
      if (c2 == 125) {
        return Scan { pos: p.pos + 1, err: p.err };
      }
      return fail(p);
    }
  }

  return fail(p);
}

function locate(s: string): Loc {
  let p: Scan = scan_value(s, Scan { pos: 0, err: -1 }, 0);
  if (p.err >= 0) {
    return line_col(s, p.err);
  }
  p = skip_ws(s, p);
  if (p.pos < s.len()) {
    return line_col(s, p.pos);
  }
  return Loc { offset: -1, line: 0, col: 0 };
}

function good_docs(): string[] {
  return [
    "null",
    "true",
    "-12.5",
    "\"hi\"",
    "[]",
    "{}",
    "[1, 2, [3, {\"a\": null}]]",
    "{\n  \"a\": 1,\n  \"b\": [true, false]\n}",
  ];
}

function bad_docs(): string[] {
  return [
    "{\n  \"a\": 1,\n  \"b\": ,\n}",
    "[1, 2,]",
    "{\"a\" 1}",
    "tru",
    "{\"a\": 1} trailing",
    "[1, 2",
    "\"unterminated",
    "1.",
  ];
}

function test_good_documents_agree(): test.TestOutcome {
  let xs: string[] = good_docs();
  for i in 0..xs.len() {
    let loc: Loc = locate(xs[i]);
    if (loc.offset >= 0) {
      return test.fail("scanner rejected good doc " + i.to_string()
        + " at offset " + loc.offset.to_string());
    }
    match (json.parse(xs[i])) {
      Ok(_) => {},
      Err(e) => {
        return test.fail("std/json rejected good doc " + i.to_string()
          + ": " + e.to_string());
      }
    }
  }
  return test.pass();
}

function test_bad_documents_agree_on_the_offset(): test.TestOutcome {
  let xs: string[] = bad_docs();
  for i in 0..xs.len() {
    let loc: Loc = locate(xs[i]);
    if (loc.offset < 0) {
      return test.fail("scanner accepted bad doc " + i.to_string());
    }
    match (json.parse(xs[i])) {
      Ok(_) => {
        return test.fail("std/json accepted bad doc " + i.to_string());
      },
      Err(e) => {
        if (e.offset != loc.offset) {
          return test.fail("doc " + i.to_string()
            + ": scanner says offset " + loc.offset.to_string()
            + ", std/json says " + e.offset.to_string());
        }
      }
    }
  }
  return test.pass();
}

function test_line_and_column_are_derived_from_the_offset(): test.TestOutcome {
  let xs: string[] = bad_docs();
  for i in 0..xs.len() {
    match (json.parse(xs[i])) {
      Ok(_) => {
        return test.fail("bad doc " + i.to_string() + " parsed");
      },
      Err(e) => {
        if (e.line < 1 || e.col < 1) {
          return test.fail("doc " + i.to_string() + " has line "
            + e.line.to_string() + " col " + e.col.to_string()
            + "; both are 1-based");
        }
        let mine: Loc = line_col(xs[i], e.offset);
        if (mine.line != e.line || mine.col != e.col) {
          return test.fail("doc " + i.to_string() + ": std/json says "
            + e.line.to_string() + ":" + e.col.to_string()
            + ", offset " + e.offset.to_string() + " is "
            + mine.line.to_string() + ":" + mine.col.to_string());
        }
      }
    }
  }
  return test.pass();
}

function test_the_reported_line_is_the_offending_one(): test.TestOutcome {
  let doc: string = "{\n  \"a\": 1,\n  \"b\": ,\n}";
  match (json.parse(doc)) {
    Ok(_) => {
      return test.fail("malformed document parsed");
    },
    Err(e) => {
      if (e.line != 3) {
        return test.fail("wanted line 3, got " + e.line.to_string());
      }
      if (e.col != 8) {
        return test.fail("wanted col 8, got " + e.col.to_string());
      }
    }
  }
  return test.pass();
}

// The independent scanner and the library parser agree on acceptance.
function test_parse_still_agrees(): test.TestOutcome {
  let good: string[] = good_docs();
  for i in 0..good.len() {
    match (json.parse(good[i])) {
      Ok(_) => {},
      Err(_) => {
        return test.fail("parse rejected good doc " + i.to_string());
      }
    }
  }
  let bad: string[] = bad_docs();
  for j in 0..bad.len() {
    match (json.parse(bad[j])) {
      Ok(_) => {
        return test.fail("parse accepted bad doc " + j.to_string());
      },
      Err(_) => {}
    }
  }
  return test.pass();
}

function main(): i32 {
  eprint("json_locate — locating the first syntax error in a document");
  let xs: string[] = bad_docs();
  for i in 0..xs.len() {
    match (json.parse(xs[i])) {
      Ok(_) => {
        eprint("  doc " + i.to_string() + ": parsed");
      },
      Err(e) => {
        eprint("  doc " + i.to_string() + ": " + e.to_string()
          + "  (offset " + e.offset.to_string() + ")");
      }
    }
  }

  let r: test.TestRunner = test.test_new("json_locate");
  r = r.it("good documents agree", test_good_documents_agree);
  r = r.it("bad documents agree on the offset", test_bad_documents_agree_on_the_offset);
  r = r.it("line and column are derived from the offset", test_line_and_column_are_derived_from_the_offset);
  r = r.it("the reported line is the offending one", test_the_reported_line_is_the_offending_one);
  r = r.it("parse still agrees", test_parse_still_agrees);
  return r.finish();
}
