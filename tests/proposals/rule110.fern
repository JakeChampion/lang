import "std/test";
import "std/i32";

struct World { cells: boolean[], rule: i32 }

function world_new(width: i32, rule: i32): World {
  let c: boolean[] = [];
  let i = 0;
  while (i < width) {
    c = c.append(false);
    i += 1;
  }
  return World { cells: c, rule: rule };
}

function seeded_right(width: i32, rule: i32): World {
  let w = world_new(width, rule);
  return World { ...w, cells: w.cells.with(width - 1, true) };
}

function seeded_middle(width: i32, rule: i32): World {
  let w = world_new(width, rule);
  return World { ...w, cells: w.cells.with(width / 2, true) };
}

function neighbourhood(w: World, i: i32): i32 {
  let n = w.cells.len();
  let left = 0;
  let self_ = 0;
  let right = 0;
  if (w.cells[(i + n - 1) % n]) {
    left = 1;
  }
  if (w.cells[i]) {
    self_ = 1;
  }
  if (w.cells[(i + 1) % n]) {
    right = 1;
  }
  return left * 4 + self_ * 2 + right;
}

function rule_bit(rule: i32, k: i32): boolean {
  return (rule >> k & 1) == 1;
}

function step(w: World): World {
  let next: boolean[] = [];
  let i = 0;
  while (i < w.cells.len()) {
    next = next.append(rule_bit(w.rule, neighbourhood(w, i)));
    i += 1;
  }
  return World { ...w, cells: next };
}

function render(w: World): string {
  let out = "";
  let i = 0;
  while (i < w.cells.len()) {
    if (w.cells[i]) {
      out += "#";
    } else {
      out += ".";
    }
    i += 1;
  }
  return out;
}

function live_count(w: World): i32 {
  let n = 0;
  let i = 0;
  while (i < w.cells.len()) {
    if (w.cells[i]) {
      n += 1;
    }
    i += 1;
  }
  return n;
}

function test_rule_table_matches_the_number(): test.TestOutcome {
  let rules: i32[] = [0, 30, 90, 110, 184, 255];
  for r in 0..rules.len() {
    let rule = rules[r];
    for k in 0..8 {
      let w = world_new(3, rule);
      let cells = w.cells;
      if (k >= 4) {
        cells = cells.with(0, true);
      }
      if (k % 4 >= 2) {
        cells = cells.with(1, true);
      }
      if (k % 2 == 1) {
        cells = cells.with(2, true);
      }
      w = World { ...w, cells: cells };

      if (neighbourhood(w, 1) != k) {
        return test.fail("neighbourhood built wrong for k="
          + k.to_string() + ": got "
          + neighbourhood(w, 1).to_string());
      }
      let want = rule / pow2(k) % 2 == 1;
      let got = step(w).cells[1];
      if (got != want) {
        return test.fail("rule " + rule.to_string() + " neighbourhood "
          + k.to_string() + ": got " + bool_str(got)
          + ", table says " + bool_str(want));
      }
    }
  }
  return test.pass();
}

function pow2(k: i32): i32 {
  let v = 1;
  let i = 0;
  while (i < k) {
    v *= 2;
    i += 1;
  }
  return v;
}

function bool_str(b: boolean): string {
  if (b) {
    return "alive";
  }
  return "dead";
}

function test_degenerate_rules(): test.TestOutcome {
  let dead = seeded_middle(16, 0);
  if (live_count(step(dead)) != 0) {
    return test.fail("rule 0 should leave nothing alive");
  }
  let full = world_new(16, 255);
  if (live_count(step(full)) != 16) {
    return test.fail("rule 255 should fill every cell");
  }
  if (live_count(step(step(dead))) != 0) {
    return test.fail("rule 0 not stable");
  }
  if (live_count(step(step(full))) != 16) {
    return test.fail("rule 255 not stable");
  }
  return test.pass();
}

function test_rule_90_is_left_xor_right(): test.TestOutcome {
  let w = seeded_middle(32, 90);
  for t in 0..12 {
    let before = w;
    let after = step(w);
    let n = before.cells.len();
    for i in 0..n {
      let l = before.cells[(i + n - 1) % n];
      let r = before.cells[(i + 1) % n];
      let want = l != r;
      if (after.cells[i] != want) {
        return test.fail("rule 90 at step " + t.to_string()
          + " cell " + i.to_string() + " is not left XOR right");
      }
    }
    w = after;
  }
  return test.pass();
}

function test_rule_110_stays_alive_and_grows_left(): test.TestOutcome {
  let w = seeded_right(48, 110);
  let start = live_count(w);
  if (start != 1) {
    return test.fail("seed should have exactly one cell");
  }
  let min_seen = 999;
  for t in 0..40 {
    w = step(w);
    let live = live_count(w);
    if (live == 0) {
      return test.fail("rule 110 died out at step " + t.to_string());
    }
    if (live < min_seen) {
      min_seen = live;
    }
  }
  if (live_count(w) <= start) {
    return test.fail("rule 110 did not grow from its seed: "
      + start.to_string() + " -> " + live_count(w).to_string());
  }
  return test.pass();
}

function test_render_is_total_and_width_preserving(): test.TestOutcome {
  let w = seeded_middle(24, 110);
  for t in 0..10 {
    let s = render(w);
    if (s.len() != 24) {
      return test.fail("render width " + s.len().to_string()
        + " at step " + t.to_string());
    }
    let live = 0;
    for i in 0..s.len() {
      let b = s[i] as i32;
      if (b != 35 && b != 46) {
        return test.fail("render emitted an unexpected byte");
      }
      if (b == 35) {
        live += 1;
      }
    }
    if (live != live_count(w)) {
      return test.fail("render shows " + live.to_string()
        + " live cells, world has " + live_count(w).to_string());
    }
    w = step(w);
  }
  return test.pass();
}

function test_step_is_pure(): test.TestOutcome {
  let w = seeded_middle(20, 110);
  let before = render(w);
  let a = step(w);
  let b = step(w);
  if (render(a) != render(b)) {
    return test.fail("stepping the same world twice differed");
  }
  if (render(w) != before) {
    return test.fail("step mutated its input");
  }
  return test.pass();
}

function main(): i32 {
  eprint("rule110 — an elementary cellular automaton");
  let w = seeded_right(64, 110);
  for t in 0..12 {
    eprint("  " + render(w));
    w = step(w);
  }
  eprint("  (rule 110, 64 cells, single seed at the right edge)");

  let r = test.new("rule110");
  r = r.it("rule table matches the number", test_rule_table_matches_the_number);
  r = r.it("degenerate rules", test_degenerate_rules);
  r = r.it("rule 90 is left XOR right", test_rule_90_is_left_xor_right);
  r = r.it("rule 110 stays alive and grows left", test_rule_110_stays_alive_and_grows_left);
  r = r.it("render is total and width preserving", test_render_is_total_and_width_preserving);
  r = r.it("step is pure", test_step_is_pure);
  return r.finish();
}
