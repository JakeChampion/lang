import "std/test";
import "std/i32";
import "std/i64";

struct Flow {
  cells: i32,
  cars: i32,
  steps: i32,
  moves: i32,
}

trait Describe {
  function describe(self: Self): string;
}

impl Describe for Flow {
  function describe(self: Flow): string {
    return "density=" + density_permille(self).to_string()
      + " flow=" + flow_permille(self).to_string();
  }
}

function density_permille(f: Flow): i32 {
  return f.cars * 1000 / f.cells;
}

function flow_permille(f: Flow): i32 {
  if (f.steps == 0 || f.cells == 0) {
    return 0;
  }
  return f.moves * 1000 / (f.cells * f.steps);
}

function xs_next(s: i64): i64 {
  let x: i64 = s;
  x = x ^ x << 13;
  x = x ^ x >> 7;
  x = x ^ x << 17;
  return x;
}

function xs_below(s: i64, m: i32): i32 {
  let v: i64 = s;
  if (v < 0) {
    v = 0 - v;
  }
  return (v % (m as i64)) as i32;
}

function initial_positions(cells: i32, cars: i32): i32[] {
  let pos: i32[] = [];
  let i: i32 = 0;
  while (i < cars) {
    pos = pos.append(i * cells / cars);
    i = i + 1;
  }
  return pos;
}

function gap_ahead(pos: i32[], i: i32, cells: i32): i32 {
  let n: i32 = pos.len();
  if (n == 1) {
    return cells - 1;
  }
  let ahead: i32 = pos[(i + 1) % n];
  let g: i32 = ahead - pos[i] - 1;
  if (g < 0) {
    g = g + cells;
  }
  return g;
}

function step(cells: i32, pos0: i32[], spd0: i32[], vmax: i32, brake_pct: i32, seed: i64): (i32[], i32[], i32, i64) {
  let pos: i32[] = pos0;
  let spd: i32[] = spd0;
  let s: i64 = seed;
  let moved: i32 = 0;
  let n: i32 = pos.len();

  let i: i32 = 0;
  while (i < n) {
    let v: i32 = spd[i];
    if (v < vmax) {
      v = v + 1;
    }
    let g: i32 = gap_ahead(pos, i, cells);
    if (v > g) {
      v = g;
    }
    s = xs_next(s);
    if (v > 0 && xs_below(s, 100) < brake_pct) {
      v = v - 1;
    }
    spd = spd.with(i, v);
    i = i + 1;
  }

  let j: i32 = 0;
  while (j < n) {
    pos = pos.with(j, (pos[j] + spd[j]) % cells);
    moved = moved + spd[j];
    j = j + 1;
  }
  return (pos, spd, moved, s);
}

function simulate(cells: i32, cars: i32, steps: i32, warmup: i32, vmax: i32, brake_pct: i32, seed: i64): Flow {
  if (cars <= 0) {
    return Flow { cells: cells, cars: 0, steps: steps, moves: 0 };
  }
  let pos: i32[] = initial_positions(cells, cars);
  let spd: i32[] = [];
  let i: i32 = 0;
  while (i < cars) {
    spd = spd.append(0);
    i = i + 1;
  }

  let s: i64 = seed;
  let total: i32 = 0;
  let t: i32 = 0;
  sweep: while (t < warmup + steps) {
    let (p2, v2, moved, s2) = step(cells, pos, spd, vmax, brake_pct, s);
    pos = p2;
    spd = v2;
    s = s2;
    t = t + 1;
    if (t <= warmup) {
      continue sweep;
    }
    total = total + moved;
  }
  return Flow { cells: cells, cars: cars, steps: steps, moves: total };
}

function gridlock(cells: i32): Flow {
  return simulate(cells, cells, 20, 5, 5, 0, 99);
}

function densities(): i32[] {
  return [2, 5, 10, 20, 30, 40, 60, 80];
}

function run_at(cars: i32): Flow {
  return simulate(100, cars, 200, 50, 5, 20, 20260806);
}

function test_a_full_ring_has_no_flow(): test.TestOutcome {
  let f: Flow = gridlock(40);
  if (f.moves != 0) {
    return test.fail("a full ring moved " + f.moves.to_string() + " cells");
  }
  if (flow_permille(f) != 0) {
    return test.fail("full ring reported flow " + flow_permille(f).to_string());
  }
  return test.pass();
}

function test_an_empty_ring_has_no_flow(): test.TestOutcome {
  let f: Flow = run_at(0);
  if (flow_permille(f) != 0) {
    return test.fail("empty ring reported flow " + flow_permille(f).to_string());
  }
  if (density_permille(f) != 0) {
    return test.fail("empty ring reported a density");
  }
  return test.pass();
}

function test_cars_are_conserved_and_stay_on_the_ring(): test.TestOutcome {
  let cells: i32 = 50;
  let pos: i32[] = initial_positions(cells, 12);
  let spd: i32[] = [];
  for i in 0..12 {
    spd = spd.append(0);
  }
  let s: i64 = 7;
  for t in 0..100 {
    let (p2, v2, _, s2) = step(cells, pos, spd, 5, 20, s);
    pos = p2;
    spd = v2;
    s = s2;
    if (pos.len() != 12) {
      return test.fail("car count changed to " + pos.len().to_string()
        + " at step " + t.to_string());
    }
    for k in 0..pos.len() {
      if (pos[k] < 0 || pos[k] >= cells) {
        return test.fail("car " + k.to_string() + " left the ring at "
          + pos[k].to_string());
      }
    }
  }
  return test.pass();
}

function test_speeds_respect_vmax_and_the_gap(): test.TestOutcome {
  let cells: i32 = 60;
  let vmax: i32 = 5;
  let pos: i32[] = initial_positions(cells, 15);
  let spd: i32[] = [];
  for i in 0..15 {
    spd = spd.append(0);
  }
  let s: i64 = 31337;
  for t in 0..80 {
    let gaps: i32[] = [];
    for k in 0..pos.len() {
      gaps = gaps.append(gap_ahead(pos, k, cells));
    }
    let (p2, v2, _, s2) = step(cells, pos, spd, vmax, 20, s);
    for k2 in 0..v2.len() {
      if (v2[k2] > vmax) {
        return test.fail("speed " + v2[k2].to_string() + " exceeds vmax");
      }
      if (v2[k2] > gaps[k2]) {
        return test.fail("car " + k2.to_string() + " moved "
          + v2[k2].to_string() + " into a gap of "
          + gaps[k2].to_string() + " at step " + t.to_string());
      }
    }
    pos = p2;
    spd = v2;
    s = s2;
  }
  return test.pass();
}

function test_flow_peaks_then_falls(): test.TestOutcome {
  let ds: i32[] = densities();
  let flows: i32[] = [];
  for i in 0..ds.len() {
    flows = flows.append(flow_permille(run_at(ds[i])));
  }

  let peak: i32 = 0;
  let peak_at: i32 = 0;
  for i in 0..flows.len() {
    if (flows[i] > peak) {
      peak = flows[i];
      peak_at = i;
    }
  }
  if (peak_at == 0) {
    return test.fail("flow peaked at the lowest density; it should rise first");
  }
  if (peak_at == flows.len() - 1) {
    return test.fail("flow peaked at the highest density; it should fall away");
  }
  if (flows[flows.len() - 1] >= peak) {
    return test.fail("flow at the densest point ("
      + flows[flows.len() - 1].to_string()
      + ") is not below the peak (" + peak.to_string() + ")");
  }
  return test.pass();
}

function test_flow_rises_in_free_flow(): test.TestOutcome {
  let Some(low) = some_flow(2) else {
    return test.fail("no flow measured at density 2");
  };
  let Some(mid) = some_flow(10) else {
    return test.fail("no flow measured at density 10");
  };
  if (mid <= low) {
    return test.fail("flow did not rise from " + low.to_string()
      + " to " + mid.to_string() + " between densities 2 and 10");
  }
  return test.pass();
}

function some_flow(cars: i32): Option[i32] {
  if (cars <= 0) {
    return None;
  }
  return Some(flow_permille(run_at(cars)));
}

function test_runs_are_deterministic(): test.TestOutcome {
  let a: Flow = run_at(25);
  let b: Flow = run_at(25);
  if (a.moves != b.moves) {
    return test.fail("same seed gave " + a.moves.to_string()
      + " then " + b.moves.to_string());
  }
  return test.pass();
}

function main(): i32 {
  defer eprint("(simulation complete)");
  eprint("traffic — Nagel-Schreckenberg on a one-lane ring");

  let ds: i32[] = densities();
  for i in 0..ds.len() {
    let f: Flow = run_at(ds[i]);
    eprint(f.describe() |> indent_by("  "));
  }

  let r: test.TestRunner = test.test_new("traffic");
  r = r.it("a full ring has no flow", test_a_full_ring_has_no_flow);
  r = r.it("an empty ring has no flow", test_an_empty_ring_has_no_flow);
  r = r.it("cars are conserved and stay on the ring", test_cars_are_conserved_and_stay_on_the_ring);
  r = r.it("speeds respect vmax and the gap", test_speeds_respect_vmax_and_the_gap);
  r = r.it("flow peaks then falls", test_flow_peaks_then_falls);
  r = r.it("flow rises in free flow", test_flow_rises_in_free_flow);
  r = r.it("runs are deterministic", test_runs_are_deterministic);
  return r.finish();
}

function indent_by(body: string, pad: string): string {
  return pad + body;
}
