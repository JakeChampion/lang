import "std/test";
import "std/i32";
import "std/string";

struct Node { key: i32, next: i32[] }

struct SkipList { nodes: Node[], max_level: i32 }

function max_level(): i32 {
  return 8;
}

function mix(key: i32): i32 {
  let h: i32 = key * 1103515245 + 12345;
  if (h < 0) {
    h = 0 - h;
  }
  h = h ^ h / 65536;
  h = h * 40503;
  if (h < 0) {
    h = 0 - h;
  }
  return h;
}

function level_of(key: i32): i32 {
  let h: i32 = mix(key);
  if (h == 0) {
    return max_level();
  }
  let l: i32 = 0;
  while (l < max_level() && h % 2 == 0) {
    h = h / 2;
    l = l + 1;
  }
  return l;
}

function new_list(): SkipList {
  let next: i32[] = [];
  let i: i32 = 0;
  while (i <= max_level()) {
    next = next.append(-1);
    i = i + 1;
  }
  return SkipList {
    nodes: [Node { key: -2147483647, next: next }],
    max_level: max_level(),
  };
}

function predecessors(sl: SkipList, key: i32): i32[] {
  let preds: i32[] = [];
  let i: i32 = 0;
  while (i <= sl.max_level) {
    preds = preds.append(0);
    i = i + 1;
  }

  let cur: i32 = 0;
  let l: i32 = sl.max_level;
  while (l >= 0) {
    while (true) {
      let nxt: i32 = sl.nodes[cur].next[l];
      if (nxt < 0) {
        break;
      }
      if (sl.nodes[nxt].key >= key) {
        break;
      }
      cur = nxt;
    }
    preds = preds.with(l, cur);
    l = l - 1;
  }
  return preds;
}

function contains(sl: SkipList, key: i32): boolean {
  let preds: i32[] = predecessors(sl, key);
  let nxt: i32 = sl.nodes[preds[0]].next[0];
  if (nxt < 0) {
    return false;
  }
  return sl.nodes[nxt].key == key;
}

function insert(sl_in: SkipList, key: i32): SkipList {
  if (contains(sl_in, key)) {
    return sl_in;
  }
  let sl: SkipList = sl_in;
  let preds: i32[] = predecessors(sl, key);
  let lvl: i32 = level_of(key);

  let next: i32[] = [];
  let l: i32 = 0;
  while (l <= lvl) {
    next = next.append(sl.nodes[preds[l]].next[l]);
    l = l + 1;
  }
  let at: i32 = sl.nodes.len();
  let nodes: Node[] = sl.nodes.append(Node { key: key, next: next });

  l = 0;
  while (l <= lvl) {
    let p: i32 = preds[l];
    nodes = nodes.with(p, Node { key: nodes[p].key, next: nodes[p].next.with(l, at) });
    l = l + 1;
  }
  return SkipList { nodes: nodes, max_level: sl.max_level };
}

function remove(sl_in: SkipList, key: i32): (SkipList, boolean) {
  if (!contains(sl_in, key)) {
    return (sl_in, false);
  }
  let sl: SkipList = sl_in;
  let preds: i32[] = predecessors(sl, key);
  let target: i32 = sl.nodes[preds[0]].next[0];
  let nodes: Node[] = sl.nodes;

  let l: i32 = 0;
  while (l <= sl.max_level) {
    let p: i32 = preds[l];
    if (nodes[p].next[l] == target) {
      let beyond: i32 = -1;
      if (l < nodes[target].next.len()) {
        beyond = nodes[target].next[l];
      }
      nodes = nodes.with(p, Node { key: nodes[p].key, next: nodes[p].next.with(l, beyond) });
    }
    l = l + 1;
  }
  return (SkipList { nodes: nodes, max_level: sl.max_level }, true);
}

function level_keys(sl: SkipList, l: i32): i32[] {
  let out: i32[] = [];
  let cur: i32 = sl.nodes[0].next[l];
  while (cur >= 0) {
    out = out.append(sl.nodes[cur].key);
    if (l >= sl.nodes[cur].next.len()) {
      return out;
    }
    cur = sl.nodes[cur].next[l];
  }
  return out;
}

function join(xs: i32[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i > 0) {
      out = out + ",";
    }
    out = out + xs[i].to_string();
    i = i + 1;
  }
  return out;
}

function render(sl: SkipList): string {
  let out: string = "";
  let l: i32 = 0;
  while (l <= sl.max_level) {
    out = out + "L" + l.to_string() + "[" + join(level_keys(sl, l)) + "]";
    l = l + 1;
  }
  return out;
}

function bf_contains(keys: i32[], k: i32): boolean {
  let i: i32 = 0;
  while (i < keys.len()) {
    if (keys[i] == k) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function bf_sorted(keys: i32[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < keys.len()) {
    let k: i32 = keys[i];
    if (!bf_contains(out, k)) {
      let next: i32[] = [];
      let placed: boolean = false;
      let j: i32 = 0;
      while (j < out.len()) {
        if (!placed && out[j] > k) {
          next = next.append(k);
          placed = true;
        }
        next = next.append(out[j]);
        j = j + 1;
      }
      if (!placed) {
        next = next.append(k);
      }
      out = next;
    }
    i = i + 1;
  }
  return out;
}

function corpus(): i32[] {
  return [42, 7, 99, 1, 13, 256, 5, 77, 300, 2, 64, 128, 31, 8, 1000];
}

function build(keys: i32[]): SkipList {
  let sl: SkipList = new_list();
  let i: i32 = 0;
  while (i < keys.len()) {
    sl = insert(sl, keys[i]);
    i = i + 1;
  }
  return sl;
}

function test_level_zero_is_the_sorted_key_set(): test.TestOutcome {
  let keys: i32[] = corpus();
  let sl: SkipList = build(keys);
  let got: string = join(level_keys(sl, 0));
  let want: string = join(bf_sorted(keys));
  if (got != want) {
    return test.fail("level 0 is [" + got + "], want [" + want + "]");
  }
  return test.pass();
}

function test_membership_agrees_with_a_scan(): test.TestOutcome {
  let keys: i32[] = corpus();
  let sl: SkipList = build(keys);
  let probes: i32[] = [
    42, 41, 43, 7, 0, 1, 2, 3, 99, 100, 1000, 1001, 999,
    256, 255, 257, -5, 2147483647,
  ];
  let i: i32 = 0;
  while (i < probes.len()) {
    if (contains(sl, probes[i]) != bf_contains(keys, probes[i])) {
      return test.fail("membership disagrees on " + probes[i].to_string()
        + ": list says " + contains(sl, probes[i]).to_string());
    }
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < keys.len()) {
    if (!contains(sl, keys[j])) {
      return test.fail("inserted key " + keys[j].to_string() + " not found");
    }
    j = j + 1;
  }
  return test.pass();
}

function test_every_level_is_a_subsequence_of_the_one_below(): test.TestOutcome {
  let sl: SkipList = build(corpus());
  let l: i32 = 1;
  while (l <= sl.max_level) {
    let upper: i32[] = level_keys(sl, l);
    let lower: i32[] = level_keys(sl, l - 1);
    let s: i32 = 1;
    while (s < upper.len()) {
      if (upper[s - 1] >= upper[s]) {
        return test.fail("level " + l.to_string() + " out of order at "
          + s.to_string() + ": [" + join(upper) + "]");
      }
      s = s + 1;
    }
    let u: i32 = 0;
    let d: i32 = 0;
    while (u < upper.len()) {
      while (d < lower.len() && lower[d] != upper[u]) {
        d = d + 1;
      }
      if (d >= lower.len()) {
        return test.fail("level " + l.to_string() + " key "
          + upper[u].to_string() + " is missing from level "
          + (l - 1).to_string() + " (tower broken)");
      }
      d = d + 1;
      u = u + 1;
    }
    l = l + 1;
  }
  return test.pass();
}

function test_insertion_order_does_not_change_the_structure(): test.TestOutcome {
  let keys: i32[] = corpus();
  let forward: string = render(build(keys));

  let rev: i32[] = [];
  let i: i32 = keys.len() - 1;
  while (i >= 0) {
    rev = rev.append(keys[i]);
    i = i - 1;
  }
  if (render(build(rev)) != forward) {
    return test.fail("reversed insertion produced a different structure");
  }

  let strided: i32[] = [];
  let step: i32 = 0;
  while (step < 7) {
    let j: i32 = step;
    while (j < keys.len()) {
      strided = strided.append(keys[j]);
      j = j + 7;
    }
    step = step + 1;
  }
  if (strided.len() != keys.len()) {
    return test.fail("the stride permutation dropped keys");
  }
  if (render(build(strided)) != forward) {
    return test.fail("a permuted insertion produced a different structure");
  }

  let dupes: i32[] = keys;
  let d: i32 = 0;
  while (d < keys.len()) {
    dupes = dupes.append(keys[d]);
    d = d + 1;
  }
  if (render(build(dupes)) != forward) {
    return test.fail("re-inserting every key changed the structure");
  }
  return test.pass();
}

function test_a_keys_level_is_a_function_of_the_key(): test.TestOutcome {
  let k: i32 = 0;
  while (k < 500) {
    if (level_of(k) != level_of(k)) {
      return test.fail("level_of is not pure");
    }
    if (level_of(k) < 0 || level_of(k) > max_level()) {
      return test.fail("level_of(" + k.to_string() + ") = "
        + level_of(k).to_string() + " is out of range");
    }
    k = k + 1;
  }
  let sl: SkipList = build(corpus());
  let n: i32 = 1;
  while (n < sl.nodes.len()) {
    let want: i32 = level_of(sl.nodes[n].key) + 1;
    if (sl.nodes[n].next.len() != want) {
      return test.fail("node " + sl.nodes[n].key.to_string() + " has height "
        + sl.nodes[n].next.len().to_string() + ", level_of wants " + want.to_string());
    }
    n = n + 1;
  }
  let tall: i32 = 0;
  let m: i32 = 0;
  while (m < 500) {
    if (level_of(m) >= 2) {
      tall = tall + 1;
    }
    m = m + 1;
  }
  if (tall < 50) {
    return test.fail("only " + tall.to_string() + "/500 keys reach level 2 — "
      + "the express lanes are too sparse to be a skip list");
  }
  return test.pass();
}

function test_delete_unlinks_from_every_level(): test.TestOutcome {
  let keys: i32[] = corpus();
  let sl: SkipList = build(keys);

  let i: i32 = 0;
  while (i < keys.len()) {
    let (after, removed) = remove(sl, keys[i]);
    if (!removed) {
      return test.fail("remove reported no-op on " + keys[i].to_string());
    }
    if (contains(after, keys[i])) {
      return test.fail(keys[i].to_string() + " still found after removal");
    }
    let l: i32 = 0;
    while (l <= after.max_level) {
      if (bf_contains(level_keys(after, l), keys[i])) {
        return test.fail(keys[i].to_string() + " still linked at level "
          + l.to_string());
      }
      l = l + 1;
    }
    let j: i32 = 0;
    while (j < keys.len()) {
      if (j != i && !contains(after, keys[j])) {
        return test.fail("removing " + keys[i].to_string() + " lost "
          + keys[j].to_string());
      }
      j = j + 1;
    }
    i = i + 1;
  }
  let (_, again) = remove(sl, 424242);
  if (again) {
    return test.fail("removing an absent key reported success");
  }
  return test.pass();
}

function test_remove_all_then_reinsert_round_trips(): test.TestOutcome {
  let keys: i32[] = corpus();
  let original: string = render(build(keys));

  let sl: SkipList = build(keys);
  let i: i32 = 0;
  while (i < keys.len()) {
    let (after, _) = remove(sl, keys[i]);
    sl = after;
    i = i + 1;
  }
  let l: i32 = 0;
  while (l <= sl.max_level) {
    if (level_keys(sl, l).len() != 0) {
      return test.fail("level " + l.to_string() + " is not empty after removing everything: ["
        + join(level_keys(sl, l)) + "]");
    }
    l = l + 1;
  }

  let j: i32 = 0;
  while (j < keys.len()) {
    sl = insert(sl, keys[j]);
    j = j + 1;
  }
  if (join(level_keys(sl, 0)) != join(bf_sorted(keys))) {
    return test.fail("level 0 after re-insert is [" + join(level_keys(sl, 0)) + "]");
  }
  let lv: i32 = 0;
  while (lv <= sl.max_level) {
    let want: i32[] = level_keys(build(keys), lv);
    if (join(level_keys(sl, lv)) != join(want)) {
      return test.fail("level " + lv.to_string() + " differs after a full round trip");
    }
    lv = lv + 1;
  }
  return test.pass();
}

function test_degenerate_lists(): test.TestOutcome {
  let empty: SkipList = new_list();
  if (contains(empty, 1)) {
    return test.fail("the empty list contains something");
  }
  let l: i32 = 0;
  while (l <= empty.max_level) {
    if (level_keys(empty, l).len() != 0) {
      return test.fail("empty list has links");
    }
    l = l + 1;
  }
  let (_, r) = remove(empty, 1);
  if (r) {
    return test.fail("removing from the empty list reported success");
  }

  let one: SkipList = build([5]);
  if (!contains(one, 5)) {
    return test.fail("single key lost");
  }
  if (join(level_keys(one, 0)) != "5") {
    return test.fail("single-key level 0 wrong");
  }

  let neg: SkipList = build([0, -1, -100, 5]);
  if (join(level_keys(neg, 0)) != "-100,-1,0,5") {
    return test.fail("negative keys mis-sorted: [" + join(level_keys(neg, 0)) + "]");
  }
  if (!contains(neg, 0) || !contains(neg, -100)) {
    return test.fail("a negative or zero key was lost");
  }
  return test.pass();
}

function main(): i32 {
  eprint("skiplist — key-derived levels, so the structure is order-independent");

  let sl: SkipList = build(corpus());
  let l: i32 = sl.max_level;
  while (l >= 0) {
    let ks: i32[] = level_keys(sl, l);
    if (ks.len() > 0 || l == 0) {
      eprint("  L" + l.to_string() + ": " + join(ks));
    }
    l = l - 1;
  }
  eprint("nodes: " + (sl.nodes.len() - 1).to_string() + " for "
    + corpus().len().to_string() + " keys");

  let line: string = "level_of:";
  let k: i32 = 0;
  while (k < 12) {
    line = line + " " + k.to_string() + "->" + level_of(k).to_string();
    k = k + 1;
  }
  eprint(line);

  let r: test.TestRunner = test.test_new("skiplist");
  r = r.it("level zero is the sorted key set", test_level_zero_is_the_sorted_key_set);
  r = r.it("membership agrees with a scan", test_membership_agrees_with_a_scan);
  r = r.it("every level is a subsequence of the one below", test_every_level_is_a_subsequence_of_the_one_below);
  r = r.it("insertion order does not change the structure", test_insertion_order_does_not_change_the_structure);
  r = r.it("a key's level is a function of the key", test_a_keys_level_is_a_function_of_the_key);
  r = r.it("delete unlinks from every level", test_delete_unlinks_from_every_level);
  r = r.it("remove all then reinsert round trips", test_remove_all_then_reinsert_round_trips);
  r = r.it("degenerate lists", test_degenerate_lists);
  return r.finish();
}
