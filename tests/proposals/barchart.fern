import "std/test";
import "std/i32";
import "std/i64";
import "std/string";

function nice_max(v: i32): i32 {
  if (v <= 0) {
    return 1;
  }
  let step: i32 = 1;
  while (true) {
    if (v <= step) {
      return step;
    }
    if (v <= step * 2) {
      return step * 2;
    }
    if (v <= step * 5) {
      return step * 5;
    }
    if (step > 214748364) {
      return 2147483647;
    }
    step = step * 10;
  }
  return 1;
}

function bar_len(v: i32, axis_max: i32, width: i32): i32 {
  if (v <= 0 || axis_max <= 0 || width <= 0) {
    return 0;
  }
  if (v >= axis_max) {
    return width;
  }
  let num: i64 = v as i64 * (width as i64) * 2 + axis_max as i64;
  return (num / (axis_max as i64 * 2)) as i32;
}

function repeat(c: string, n: i32): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < n) {
    out = out + c;
    i = i + 1;
  }
  return out;
}

function pad_left(s: string, w: i32): string {
  if (s.len() >= w) {
    return s;
  }
  return repeat(" ", w - s.len()) + s;
}

function pad_right(s: string, w: i32): string {
  if (s.len() >= w) {
    return s;
  }
  return s + repeat(" ", w - s.len());
}

function max_len(xs: string[]): i32 {
  let m: i32 = 0;
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i].len() > m) {
      m = xs[i].len();
    }
    i = i + 1;
  }
  return m;
}

function max_val(vs: i32[]): i32 {
  let m: i32 = 0;
  let i: i32 = 0;
  while (i < vs.len()) {
    if (vs[i] > m) {
      m = vs[i];
    }
    i = i + 1;
  }
  return m;
}

function chart(labels: string[], values: i32[], width: i32): string[] {
  let out: string[] = [];
  if (labels.len() == 0 || labels.len() != values.len() || width <= 0) {
    return out;
  }
  let lw: i32 = max_len(labels);
  let axis: i32 = nice_max(max_val(values));
  let vw: i32 = axis.to_string().len();

  let i: i32 = 0;
  while (i < labels.len()) {
    let n: i32 = bar_len(values[i], axis, width);
    out = out.append(pad_left(labels[i], lw) + " |" + pad_right(repeat("#", n), width)
      + "| " + pad_left(values[i].to_string(), vw));
    i = i + 1;
  }

  out = out.append(repeat(" ", lw) + " +" + repeat("-", width) + "+ " + repeat(" ", vw));

  let zero: string = "0";
  let top: string = axis.to_string();
  let gap: i32 = width - zero.len() - top.len();
  let ticks: string = zero + repeat(" ", gap) + top;
  if (gap < 0) {
    ticks = pad_right(zero, width);
  }
  out = out.append(repeat(" ", lw) + " " + pad_right(ticks, width + 2) + " " + repeat(" ", vw));
  return out;
}

function bf_nice_max(v: i32): i32 {
  if (v <= 0) {
    return 1;
  }
  let best: i32 = 0;
  let step: i32 = 1;
  let k: i32 = 0;
  while (k < 9) {
    let cands: i32[] = [step, step * 2, step * 5];
    let c: i32 = 0;
    while (c < 3) {
      if (cands[c] >= v && (best == 0 || cands[c] < best)) {
        best = cands[c];
      }
      c = c + 1;
    }
    step = step * 10;
    k = k + 1;
  }
  if (best == 0) {
    return 2147483647;
  }
  return best;
}

function test_nice_max_agrees_with_brute_force(): test.TestOutcome {
  let v: i32 = 1;
  while (v <= 2000) {
    if (nice_max(v) != bf_nice_max(v)) {
      return test.fail("nice_max(" + v.to_string() + ") = "
        + nice_max(v).to_string() + ", want " + bf_nice_max(v).to_string());
    }
    v = v + 1;
  }
  let pow: i32 = 1;
  let k: i32 = 0;
  while (k < 8) {
    let probes: i32[] = [
      pow - 1, pow, pow + 1, pow * 2 - 1, pow * 2, pow * 2 + 1,
      pow * 5 - 1, pow * 5, pow * 5 + 1,
    ];
    let i: i32 = 0;
    while (i < probes.len()) {
      if (probes[i] > 0 && nice_max(probes[i]) != bf_nice_max(probes[i])) {
        return test.fail("nice_max(" + probes[i].to_string() + ") = "
          + nice_max(probes[i]).to_string() + ", want "
          + bf_nice_max(probes[i]).to_string());
      }
      i = i + 1;
    }
    pow = pow * 10;
    k = k + 1;
  }
  return test.pass();
}

function test_nice_max_is_idempotent(): test.TestOutcome {
  let v: i32 = 1;
  while (v <= 3000) {
    let once: i32 = nice_max(v);
    if (nice_max(once) != once) {
      return test.fail("nice_max not idempotent at " + v.to_string() + ": "
        + once.to_string() + " -> " + nice_max(once).to_string());
    }
    if (once < v) {
      return test.fail("nice_max(" + v.to_string() + ") = " + once.to_string()
        + " does not contain its input");
    }
    v = v + 1;
  }
  return test.pass();
}

function test_bar_lengths_are_monotone(): test.TestOutcome {
  let widths: i32[] = [1, 7, 20, 64, 100];
  let w: i32 = 0;
  while (w < widths.len()) {
    let axis: i32 = 500;
    let prev: i32 = 0;
    let v: i32 = 0;
    while (v <= axis) {
      let cur: i32 = bar_len(v, axis, widths[w]);
      if (cur < prev) {
        return test.fail("bar_len fell at v=" + v.to_string() + " width="
          + widths[w].to_string() + ": " + prev.to_string() + " -> " + cur.to_string());
      }
      if (cur < 0 || cur > widths[w]) {
        return test.fail("bar_len out of range at v=" + v.to_string() + ": "
          + cur.to_string() + " for width " + widths[w].to_string());
      }
      prev = cur;
      v = v + 1;
    }
    w = w + 1;
  }
  return test.pass();
}

function test_bar_length_endpoints_are_exact(): test.TestOutcome {
  if (bar_len(0, 100, 40) != 0) {
    return test.fail("zero did not render an empty bar");
  }
  if (bar_len(100, 100, 40) != 40) {
    return test.fail("the axis maximum did not fill the field");
  }
  if (bar_len(50, 100, 40) != 20) {
    return test.fail("half the axis gave " + bar_len(50, 100, 40).to_string() + ", want 20");
  }
  if (bar_len(1, 8, 4) != 1) {
    return test.fail("half a cell rounded down: " + bar_len(1, 8, 4).to_string());
  }
  if (bar_len(999, 100, 40) != 40) {
    return test.fail("an over-axis value did not clamp");
  }
  if (bar_len(5, 0, 40) != 0) {
    return test.fail("zero axis did not yield 0");
  }
  if (bar_len(5, 100, 0) != 0) {
    return test.fail("zero width did not yield 0");
  }
  if (bar_len(-5, 100, 40) != 0) {
    return test.fail("a negative value did not yield 0");
  }
  return test.pass();
}

function test_every_line_is_the_same_width(): test.TestOutcome {
  let cases: string[] = ["a|bb|ccc", "one", "alpha|beta|gamma|delta|epsilon"];
  let vals: i32[][] = [[1, 50, 300], [7], [0, 1, 99, 100, 1000]];
  let c: i32 = 0;
  while (c < cases.len()) {
    let labels: string[] = cases[c].split("|");
    let lines: string[] = chart(labels, vals[c], 30);
    if (lines.len() != labels.len() + 2) {
      return test.fail("wanted " + (labels.len() + 2).to_string()
        + " lines, got " + lines.len().to_string());
    }
    let w: i32 = lines[0].len();
    let i: i32 = 1;
    while (i < lines.len()) {
      if (lines[i].len() != w) {
        return test.fail("line " + i.to_string() + " is " + lines[i].len().to_string()
          + " wide, line 0 is " + w.to_string());
      }
      i = i + 1;
    }
    c = c + 1;
  }
  return test.pass();
}

function test_label_column_fits_the_widest_label(): test.TestOutcome {
  let labels: string[] = ["a", "medium", "the longest one"];
  let lines: string[] = chart(labels, [1, 2, 3], 10);
  let lw: i32 = max_len(labels);
  let i: i32 = 0;
  while (i < labels.len()) {
    let head: string = lines[i].take(lw).to_owned();
    if (head.trim().to_owned() != labels[i]) {
      return test.fail("row " + i.to_string() + " label column is \"" + head
        + "\", want \"" + labels[i] + "\" right-aligned in " + lw.to_string());
    }
    i = i + 1;
  }
  return test.pass();
}

function test_bars_stay_inside_the_field(): test.TestOutcome {
  let labels: string[] = ["a", "b", "c", "d"];
  let width: i32 = 24;
  let lines: string[] = chart(labels, [0, 1, 999, 500], width);
  let lw: i32 = 1;
  let i: i32 = 0;
  while (i < labels.len()) {
    let line: string = lines[i];
    if (line[lw + 1] as i32 != 124) {
      return test.fail("row " + i.to_string() + " has no opening bar at column "
        + (lw + 1).to_string());
    }
    if (line[lw + 2 + width] as i32 != 124) {
      return test.fail("row " + i.to_string() + " has no closing bar at column "
        + (lw + 2 + width).to_string());
    }
    let seen_space: boolean = false;
    let k: i32 = 0;
    while (k < width) {
      let ch: i32 = line[lw + 2 + k] as i32;
      if (ch == 35) {
        if (seen_space) {
          return test.fail("row " + i.to_string() + " has a gap inside its bar");
        }
      } else if (ch == 32) {
        seen_space = true;
      } else {
        return test.fail("row " + i.to_string() + " has byte " + ch.to_string()
          + " inside the bar field");
      }
      k = k + 1;
    }
    i = i + 1;
  }
  return test.pass();
}

function test_adding_a_smaller_row_does_not_rescale(): test.TestOutcome {
  let before: string[] = chart(["a", "b"], [10, 100], 20);
  let after: string[] = chart(["a", "b", "c"], [10, 100, 3], 20);
  let i: i32 = 0;
  while (i < 2) {
    if (before[i] != after[i]) {
      return test.fail("row " + i.to_string() + " moved when a smaller row was added:\n"
        + "  " + before[i] + "\n  " + after[i]);
    }
    i = i + 1;
  }
  let bigger: string[] = chart(["a", "b", "c"], [10, 100, 5000], 20);
  if (bigger[0] == after[0]) {
    return test.fail("a larger row did not rescale the chart");
  }
  return test.pass();
}

function test_degenerate_inputs(): test.TestOutcome {
  if (chart([], [], 20).len() != 0) {
    return test.fail("empty input produced lines");
  }
  if (chart(["a"], [], 20).len() != 0) {
    return test.fail("mismatched lengths produced lines");
  }
  if (chart(["a"], [1], 0).len() != 0) {
    return test.fail("zero width produced lines");
  }
  let z: string[] = chart(["a", "b"], [0, 0], 10);
  if (z.len() != 4) {
    return test.fail("all-zero chart had " + z.len().to_string() + " lines");
  }
  if (z[0].contains("#")) {
    return test.fail("a zero value drew a bar");
  }
  return test.pass();
}

function main(): i32 {
  eprint("barchart — ASCII bars, nice-number axis, automatic scaling");

  let labels: string[] = ["apples", "bananas", "cherries", "dates", "elderberries"];
  let values: i32[] = [420, 137, 890, 12, 655];
  let lines: string[] = chart(labels, values, 40);
  let i: i32 = 0;
  while (i < lines.len()) {
    eprint(lines[i]);
    i = i + 1;
  }

  eprint("");
  eprint("axis for max=" + max_val(values).to_string() + " is " + nice_max(max_val(values)).to_string());
  let probes: i32[] = [1, 3, 7, 12, 45, 99, 100, 101, 4999, 5000, 5001];
  let p: i32 = 0;
  let line: string = "nice_max:";
  while (p < probes.len()) {
    line = line + " " + probes[p].to_string() + "->" + nice_max(probes[p]).to_string();
    p = p + 1;
  }
  eprint(line);

  let r: test.TestRunner = test.test_new("barchart");
  r = r.it("nice_max agrees with brute force", test_nice_max_agrees_with_brute_force);
  r = r.it("nice_max is idempotent", test_nice_max_is_idempotent);
  r = r.it("bar lengths are monotone", test_bar_lengths_are_monotone);
  r = r.it("bar length endpoints are exact", test_bar_length_endpoints_are_exact);
  r = r.it("every line is the same width", test_every_line_is_the_same_width);
  r = r.it("label column fits the widest label", test_label_column_fits_the_widest_label);
  r = r.it("bars stay inside the field", test_bars_stay_inside_the_field);
  r = r.it("adding a smaller row does not rescale", test_adding_a_smaller_row_does_not_rescale);
  r = r.it("degenerate inputs", test_degenerate_inputs);
  return r.finish();
}
