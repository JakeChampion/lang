import "std/test";
import "std/i32";
import "std/i64";

struct Slot { key: string, val: string, live: boolean }

struct Store { slots: Slot[], live: i32, dead: i32 }

function store_new(): Store {
  return Store { slots: [], live: 0, dead: 0 };
}

function find_live(s: Store, k: string): i32 {
  let i: i32 = 0;
  while (i < s.slots.len()) {
    if (s.slots[i].live && s.slots[i].key == k) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

function get(s: Store, k: string): Option[string] {
  let at: i32 = find_live(s, k);
  if (at < 0) {
    return None;
  }
  return Some(s.slots[at].val);
}

function has(s: Store, k: string): boolean {
  return find_live(s, k) >= 0;
}

function put(s: Store, k: string, v: string): Store {
  let at: i32 = find_live(s, k);
  if (at >= 0) {
    let updated: Slot[] = [];
    let i: i32 = 0;
    while (i < s.slots.len()) {
      if (i == at) {
        updated = updated.append(Slot { key: k, val: v, live: true });
      } else {
        updated = updated.append(s.slots[i]);
      }
      i = i + 1;
    }
    return Store { slots: updated, live: s.live, dead: s.dead };
  }
  return Store {
    slots: s.slots.append(Slot { key: k, val: v, live: true }),
    live: s.live + 1,
    dead: s.dead,
  };
}

function del(s: Store, k: string): (Store, boolean) {
  let at: i32 = find_live(s, k);
  if (at < 0) {
    return (s, false);
  }
  let updated: Slot[] = [];
  let i: i32 = 0;
  while (i < s.slots.len()) {
    if (i == at) {
      updated = updated.append(Slot {
        key: s.slots[i].key,
        val: s.slots[i].val,
        live: false,
      });
    } else {
      updated = updated.append(s.slots[i]);
    }
    i = i + 1;
  }
  return (Store { slots: updated, live: s.live - 1, dead: s.dead + 1 }, true);
}

function compact(s: Store): (Store, i32) {
  let kept: Slot[] = [];
  let i: i32 = 0;
  while (i < s.slots.len()) {
    if (s.slots[i].live) {
      kept = kept.append(s.slots[i]);
    }
    i = i + 1;
  }
  let reclaimed: i32 = s.slots.len() - kept.len();
  return (Store { slots: kept, live: kept.len(), dead: 0 }, reclaimed);
}

function live_keys(s: Store): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < s.slots.len()) {
    if (s.slots[i].live) {
      out = out.append(s.slots[i].key);
    }
    i = i + 1;
  }
  return out;
}

function seeded(): Store {
  let s: Store = store_new();
  s = put(s, "alpha", "1");
  s = put(s, "beta", "2");
  s = put(s, "gamma", "3");
  s = put(s, "delta", "4");
  return s;
}

function test_delete_tombstones_rather_than_removes(): test.TestOutcome {
  let s: Store = seeded();
  let slots_before: i32 = s.slots.len();
  let (s2, removed) = del(s, "beta");
  if (!removed) {
    return test.fail("del reported no-op on a present key");
  }
  if (has(s2, "beta")) {
    return test.fail("deleted key still reads live");
  }
  if (s2.slots.len() != slots_before) {
    return test.fail("del shrank the slot array: " + slots_before.to_string()
      + " -> " + s2.slots.len().to_string());
  }
  if (s2.dead != 1) {
    return test.fail("wanted 1 tombstone, got " + s2.dead.to_string());
  }
  if (s2.live != 3) {
    return test.fail("wanted 3 live, got " + s2.live.to_string());
  }
  return test.pass();
}

function test_delete_missing_is_a_noop(): test.TestOutcome {
  let s: Store = seeded();
  let (s2, removed) = del(s, "nope");
  if (removed) {
    return test.fail("del reported a delete on a missing key");
  }
  if (s2.dead != 0 || s2.live != 4 || s2.slots.len() != 4) {
    return test.fail("no-op del changed the store");
  }
  return test.pass();
}

function test_compaction_preserves_the_live_mapping(): test.TestOutcome {
  let s: Store = seeded();
  let (s1, _) = del(s, "alpha");
  let (s2, _) = del(s1, "gamma");
  let before: string[] = live_keys(s2);

  let (c, reclaimed) = compact(s2);
  if (reclaimed != 2) {
    return test.fail("wanted 2 reclaimed, got " + reclaimed.to_string());
  }
  let after: string[] = live_keys(c);
  if (after.len() != before.len()) {
    return test.fail("live key count changed across compaction: "
      + before.len().to_string() + " -> " + after.len().to_string());
  }
  let i: i32 = 0;
  while (i < before.len()) {
    if (before[i] != after[i]) {
      return test.fail("compaction reordered live keys at " + i.to_string()
        + ": " + before[i] + " != " + after[i]);
    }
    match (get(s2, before[i])) {
      None => {
        return test.fail("live key vanished before compaction");
      },
      Some(v0) => {
        match (get(c, after[i])) {
          None => {
            return test.fail("live key vanished after compaction");
          },
          Some(v1) => {
            if (v0 != v1) {
              return test.fail("value changed across compaction for "
                + before[i] + ": " + v0 + " != " + v1);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  if (c.dead != 0) {
    return test.fail("compaction left " + c.dead.to_string() + " tombstones");
  }
  return test.pass();
}

function test_compaction_is_idempotent(): test.TestOutcome {
  let s: Store = seeded();
  let (s1, _) = del(s, "beta");
  let (c1, first) = compact(s1);
  let (c2, second) = compact(c1);
  if (first != 1) {
    return test.fail("first compaction wanted 1, got " + first.to_string());
  }
  if (second != 0) {
    return test.fail("second compaction reclaimed " + second.to_string()
      + ", so compaction is not idempotent");
  }
  if (c2.slots.len() != c1.slots.len() || c2.live != c1.live) {
    return test.fail("second compaction changed the store");
  }
  return test.pass();
}

function test_reinsert_after_delete_does_not_resurrect(): test.TestOutcome {
  let s: Store = seeded();
  let (s1, _) = del(s, "beta");
  let s2: Store = put(s1, "beta", "22");
  match (get(s2, "beta")) {
    None => {
      return test.fail("re-inserted key reads absent");
    },
    Some(v) => {
      if (v != "22") {
        return test.fail("wanted 22, got " + v);
      }
    }
  }
  let (c, _) = compact(s2);
  match (get(c, "beta")) {
    None => {
      return test.fail("re-inserted key lost by compaction");
    },
    Some(v) => {
      if (v != "22") {
        return test.fail("compaction resurrected the old value: " + v);
      }
    }
  }
  let ks: string[] = live_keys(c);
  let seen: i32 = 0;
  let i: i32 = 0;
  while (i < ks.len()) {
    if (ks[i] == "beta") {
      seen = seen + 1;
    }
    i = i + 1;
  }
  if (seen != 1) {
    return test.fail("wanted exactly one live beta, saw " + seen.to_string());
  }
  return test.pass();
}

function test_counters_track_the_slots_under_churn(): test.TestOutcome {
  let s: Store = store_new();
  let round: i32 = 0;
  while (round < 40) {
    s = put(s, "k" + round.to_string(), "v" + round.to_string());
    if (round % 3 == 0) {
      let (s2, _) = del(s, "k" + (round / 2).to_string());
      s = s2;
    }
    round = round + 1;
  }
  let counted_live: i32 = live_keys(s).len();
  if (s.live != counted_live) {
    return test.fail("live counter " + s.live.to_string()
      + " disagrees with " + counted_live.to_string() + " live slots");
  }
  if (s.live + s.dead != s.slots.len()) {
    return test.fail("live " + s.live.to_string() + " + dead "
      + s.dead.to_string() + " != " + s.slots.len().to_string() + " slots");
  }
  let (c, reclaimed) = compact(s);
  if (reclaimed != s.dead) {
    return test.fail("reclaimed " + reclaimed.to_string()
      + " but held " + s.dead.to_string() + " tombstones");
  }
  if (c.slots.len() != counted_live) {
    return test.fail("compacted to " + c.slots.len().to_string()
      + " slots, wanted " + counted_live.to_string());
  }
  return test.pass();
}

function churn(n: i32): i32 {
  let s: Store = store_new();
  let i: i32 = 0;
  while (i < n) {
    s = put(s, "k" + i.to_string(), "v" + i.to_string());
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < n) {
    let (s2, _) = del(s, "k" + j.to_string());
    s = s2;
    j = j + 2;
  }
  let (c, reclaimed) = compact(s);
  return c.slots.len() + reclaimed;
}

function main(): i32 {
  eprint("tombstone_store — tombstoned delete + a compaction pass");

  let s: Store = seeded();
  let (s1, _) = del(s, "beta");
  eprint("after one delete: " + s1.live.to_string() + " live, "
    + s1.dead.to_string() + " dead, " + s1.slots.len().to_string() + " slots");
  let (c, reclaimed) = compact(s1);
  eprint("after compaction: " + c.live.to_string() + " live, "
    + c.dead.to_string() + " dead, " + reclaimed.to_string() + " reclaimed");

  let base: i64 = __heap_bump_bytes();
  let a: i32 = churn(64);
  let after_n: i64 = __heap_bump_bytes();
  let b: i32 = churn(128);
  let after_2n: i64 = __heap_bump_bytes();
  eprint("churn(64)  total=" + a.to_string()
    + " bump=" + (after_n - base).to_string());
  eprint("churn(128) total=" + b.to_string()
    + " bump=" + (after_2n - after_n).to_string());

  let r: test.TestRunner = test.test_new("tombstone_store");
  r = r.it("delete tombstones rather than removes", test_delete_tombstones_rather_than_removes);
  r = r.it("delete of a missing key is a no-op", test_delete_missing_is_a_noop);
  r = r.it("compaction preserves the live mapping", test_compaction_preserves_the_live_mapping);
  r = r.it("compaction is idempotent", test_compaction_is_idempotent);
  r = r.it("reinsert after delete does not resurrect", test_reinsert_after_delete_does_not_resurrect);
  r = r.it("counters track the slots under churn", test_counters_track_the_slots_under_churn);
  return r.finish();
}
