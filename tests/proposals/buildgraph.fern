import "std/test";
import "std/i32";
import "std/string";

struct Node { name: string, deps: string[], mtime: i32, exists: boolean }

struct Plan { order: string[], rebuilt: string[], cyclic: boolean }

function index_of(ns: Node[], name: string): i32 {
  let i = 0;
  while (i < ns.len()) {
    if (ns[i].name == name) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function contains(xs: string[], v: string): boolean {
  let i = 0;
  while (i < xs.len()) {
    if (xs[i] == v) {
      return true;
    }
    i += 1;
  }
  return false;
}

function strings_equal(a: string[], b: string[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

function same_set(a: string[], b: string[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i = 0;
  while (i < a.len()) {
    if (!contains(b, a[i])) {
      return false;
    }
    i += 1;
  }
  let j = 0;
  while (j < b.len()) {
    if (!contains(a, b[j])) {
      return false;
    }
    j += 1;
  }
  return true;
}

function show(xs: string[]): string {
  let out = "[";
  let i = 0;
  while (i < xs.len()) {
    if (i > 0) {
      out += ",";
    }
    out += xs[i];
    i += 1;
  }
  return out + "]";
}

function topo_order(ns: Node[]): Plan {
  let order: string[] = [];
  let placed: string[] = [];
  let none: string[] = [];
  let progress = true;
  while (progress && order.len() < ns.len()) {
    progress = false;
    let i = 0;
    while (i < ns.len()) {
      if (!contains(placed, ns[i].name)) {
        let ready = true;
        let d = 0;
        while (d < ns[i].deps.len()) {
          if (index_of(ns, ns[i].deps[d]) >= 0 && !contains(placed, ns[i].deps[d])) {
            ready = false;
          }
          d += 1;
        }
        if (ready) {
          order = order.append(ns[i].name);
          placed = placed.append(ns[i].name);
          progress = true;
        }
      }
      i += 1;
    }
  }
  if (order.len() < ns.len()) {
    return Plan { order: none, rebuilt: none, cyclic: true };
  }
  return Plan { order: order, rebuilt: none, cyclic: false };
}

function dfs_cyclic_from(ns: Node[], at: i32, colour: i32[]): boolean {
  if (colour[at] == 1) {
    return true;
  }
  if (colour[at] == 2) {
    return false;
  }
  let c = colour.with(at, 1);
  let d = 0;
  while (d < ns[at].deps.len()) {
    let to = index_of(ns, ns[at].deps[d]);
    if (to >= 0) {
      if (dfs_cyclic_from(ns, to, c)) {
        return true;
      }
      c = c.with(to, 2);
    }
    d += 1;
  }
  return false;
}

function dfs_cyclic(ns: Node[]): boolean {
  let colour: i32[] = [];
  let i = 0;
  while (i < ns.len()) {
    colour = colour.append(0);
    i += 1;
  }
  let s = 0;
  while (s < ns.len()) {
    if (dfs_cyclic_from(ns, s, colour)) {
      return true;
    }
    s += 1;
  }
  return false;
}

function initially_stale(ns: Node[], at: i32): boolean {
  if (!ns[at].exists) {
    return true;
  }
  let d = 0;
  while (d < ns[at].deps.len()) {
    let to = index_of(ns, ns[at].deps[d]);
    if (to >= 0) {
      if (!ns[to].exists) {
        return true;
      }
      if (ns[at].mtime < ns[to].mtime) {
        return true;
      }
    }
    d += 1;
  }
  return false;
}

function rebuild_closure(ns: Node[]): string[] {
  let set: string[] = [];
  let i = 0;
  while (i < ns.len()) {
    if (initially_stale(ns, i)) {
      set = set.append(ns[i].name);
    }
    i += 1;
  }
  let grew = true;
  while (grew) {
    grew = false;
    let j = 0;
    while (j < ns.len()) {
      if (!contains(set, ns[j].name)) {
        let d = 0;
        while (d < ns[j].deps.len()) {
          if (contains(set, ns[j].deps[d])) {
            set = set.append(ns[j].name);
            grew = true;
            d = ns[j].deps.len();
          } else {
            d += 1;
          }
        }
      }
      j += 1;
    }
  }
  return set;
}

struct Built { nodes: Node[], plan: Plan }

function build(ns: Node[]): Built {
  let plan = topo_order(ns);
  if (plan.cyclic) {
    return Built { nodes: ns, plan: plan };
  }

  let clock = 0;
  let i = 0;
  while (i < ns.len()) {
    if (ns[i].mtime > clock) {
      clock = ns[i].mtime;
    }
    i += 1;
  }

  let cur = ns;
  let rebuilt: string[] = [];
  let k = 0;
  while (k < plan.order.len()) {
    let at = index_of(cur, plan.order[k]);
    let need = initially_stale(cur, at);
    let d = 0;
    while (d < cur[at].deps.len()) {
      if (contains(rebuilt, cur[at].deps[d])) {
        need = true;
      }
      d += 1;
    }
    if (need) {
      clock += 1;
      cur = cur.with(at, Node {
        name: cur[at].name, deps: cur[at].deps,
        mtime: clock, exists: true,
      });
      rebuilt = rebuilt.append(cur[at].name);
    }
    k += 1;
  }
  return Built { nodes: cur, plan: Plan {
    order: plan.order, rebuilt: rebuilt,
    cyclic: false,
  } };
}

function node(name: string, deps: string[], mtime: i32, exists: boolean): Node {
  return Node { name: name, deps: deps, mtime: mtime, exists: exists };
}

function no_deps(): string[] {
  let e: string[] = [];

  return e;
}

function graphs(): Node[][] {
  let out: Node[][] = [];

  out = out.append([
    node("a", no_deps(), 5, true),
    node("b", ["a"], 3, true), node("c", ["b"], 4, true),
  ]);

  out = out.append([
    node("a", no_deps(), 1, true),
    node("b", ["a"], 2, true), node("c", ["b"], 3, true),
  ]);

  out = out.append([
    node("a", no_deps(), 9, true), node("b", ["a"], 2, true),
    node("c", ["a"], 2, true), node("d", ["b", "c"], 2, true),
  ]);

  out = out.append([
    node("lib", no_deps(), 7, true), node("x", ["lib"], 1, true),
    node("y", ["lib"], 1, true), node("z", ["lib"], 1, true),
  ]);

  out = out.append([
    node("src", no_deps(), 1, true),
    node("bin", ["src"], 99, false),
  ]);

  out = out.append([
    node("a", no_deps(), 4, true), node("b", ["a"], 4, true),
    node("c", ["b"], 4, true),
  ]);

  out = out.append([
    node("p", no_deps(), 8, true), node("q", ["p"], 1, true),
    node("r", no_deps(), 1, true), node("s", ["r"], 2, true),
  ]);

  out = out.append([node("obj", ["header.h"], 1, true)]);

  out = out.append([node("only", no_deps(), 1, true)]);
  let empty: Node[] = [];
  out = out.append(empty);

  out = out.append([
    node("n0", no_deps(), 20, true), node("n1", ["n0"], 3, true),
    node("n2", ["n1"], 4, true), node("n3", ["n2"], 5, true),
    node("n4", ["n3"], 6, true),
  ]);

  return out;
}

function cyclic_graphs(): Node[][] {
  let out: Node[][] = [];
  out = out.append([node("a", ["a"], 1, true)]);
  out = out.append([node("a", ["b"], 1, true), node("b", ["a"], 1, true)]);
  out = out.append([
    node("a", ["b"], 1, true), node("b", ["c"], 1, true),
    node("c", ["a"], 1, true),
  ]);
  out = out.append([
    node("ok", no_deps(), 1, true), node("a", ["b", "ok"], 1, true),
    node("b", ["a"], 1, true),
  ]);
  return out;
}

function test_after_building_everything_is_up_to_date(): test.TestOutcome {
  let gs = graphs();
  let g = 0;
  while (g < gs.len()) {
    let b = build(gs[g]);
    let i = 0;
    while (i < b.nodes.len()) {
      if (!b.nodes[i].exists) {
        return test.fail("graph " + g.to_string() + ": \"" + b.nodes[i].name
          + "\" is still missing after the build");
      }
      let d = 0;
      while (d < b.nodes[i].deps.len()) {
        let to = index_of(b.nodes, b.nodes[i].deps[d]);
        if (to >= 0 && b.nodes[i].mtime < b.nodes[to].mtime) {
          return test.fail("graph " + g.to_string() + ": \"" + b.nodes[i].name
            + "\" is older than its dependency \"" + b.nodes[to].name + "\"");
        }
        d += 1;
      }
      i += 1;
    }
    g += 1;
  }
  return test.pass();
}

function test_exactly_the_necessary_targets_are_rebuilt(): test.TestOutcome {
  let gs = graphs();
  let g = 0;
  while (g < gs.len()) {
    let want = rebuild_closure(gs[g]);
    let got = build(gs[g]).plan.rebuilt;
    if (!same_set(got, want)) {
      return test.fail("graph " + g.to_string() + " rebuilt " + show(got)
        + ", the fixpoint says " + show(want));
    }
    g += 1;
  }
  return test.pass();
}

function test_a_change_propagates_to_every_transitive_dependent(): test.TestOutcome {
  let chain: Node[] = [
    node("n0", no_deps(), 1, true), node("n1", ["n0"], 2, true),
    node("n2", ["n1"], 3, true), node("n3", ["n2"], 4, true),
    node("n4", ["n3"], 5, true),
  ];
  if (build(chain).plan.rebuilt.len() != 0) {
    return test.fail("the chain rebuilt something before anything was touched");
  }
  let touched = chain.with(0, node("n0", no_deps(), 100, true));
  let got = build(touched).plan.rebuilt;
  let want: string[] = ["n1", "n2", "n3", "n4"];
  if (!same_set(got, want)) {
    return test.fail("touching the root rebuilt " + show(got) + ", want " + show(want));
  }
  let mid = chain.with(2, node("n2", ["n1"], 100, true));
  let got2 = build(mid).plan.rebuilt;
  if (!same_set(got2, ["n3", "n4"])) {
    return test.fail("touching n2 rebuilt " + show(got2) + ", want [n3,n4]");
  }
  return test.pass();
}

function test_the_order_is_topological(): test.TestOutcome {
  let gs = graphs();
  let g = 0;
  while (g < gs.len()) {
    let p = topo_order(gs[g]);
    if (p.cyclic) {
      return test.fail("graph " + g.to_string() + " reported a cycle");
    }
    if (p.order.len() != gs[g].len()) {
      return test.fail("graph " + g.to_string() + ": order has "
        + p.order.len().to_string() + " of " + gs[g].len().to_string() + " nodes");
    }
    let i = 0;
    while (i < p.order.len()) {
      let j = i + 1;
      while (j < p.order.len()) {
        if (p.order[i] == p.order[j]) {
          return test.fail("graph " + g.to_string() + ": \"" + p.order[i]
            + "\" appears twice");
        }
        j += 1;
      }
      let at = index_of(gs[g], p.order[i]);
      let d = 0;
      while (d < gs[g][at].deps.len()) {
        let dep = gs[g][at].deps[d];
        if (index_of(gs[g], dep) >= 0) {
          let seen = false;
          let k = 0;
          while (k < i) {
            if (p.order[k] == dep) {
              seen = true;
            }
            k += 1;
          }
          if (!seen) {
            return test.fail("graph " + g.to_string() + ": \"" + p.order[i]
              + "\" is placed before its dependency \"" + dep + "\"");
          }
        }
        d += 1;
      }
      i += 1;
    }
    g += 1;
  }
  return test.pass();
}

function test_a_second_build_is_a_no_op(): test.TestOutcome {
  let gs = graphs();
  let g = 0;
  while (g < gs.len()) {
    let once = build(gs[g]);
    let twice = build(once.nodes);
    if (twice.plan.rebuilt.len() != 0) {
      return test.fail("graph " + g.to_string() + " rebuilt "
        + show(twice.plan.rebuilt) + " on the second pass");
    }
    g += 1;
  }
  return test.pass();
}

function test_the_two_cycle_detectors_agree(): test.TestOutcome {
  let acyclic = graphs();
  let i = 0;
  while (i < acyclic.len()) {
    if (topo_order(acyclic[i]).cyclic) {
      return test.fail("kahn reported a cycle in acyclic graph " + i.to_string());
    }
    if (dfs_cyclic(acyclic[i])) {
      return test.fail("dfs reported a cycle in acyclic graph " + i.to_string());
    }
    i += 1;
  }
  let cyc = cyclic_graphs();
  let j = 0;
  while (j < cyc.len()) {
    if (!topo_order(cyc[j]).cyclic) {
      return test.fail("kahn missed the cycle in graph " + j.to_string());
    }
    if (!dfs_cyclic(cyc[j])) {
      return test.fail("dfs missed the cycle in graph " + j.to_string());
    }
    let b = build(cyc[j]);
    if (!b.plan.cyclic || b.plan.rebuilt.len() != 0) {
      return test.fail("a cyclic graph produced a build plan");
    }
    j += 1;
  }
  return test.pass();
}

function test_a_missing_target_is_rebuilt(): test.TestOutcome {
  let g: Node[] = [node("src", no_deps(), 1, true), node("bin", ["src"], 99, false)];
  let b = build(g);
  if (!contains(b.plan.rebuilt, "bin")) {
    return test.fail("the missing target was not rebuilt: " + show(b.plan.rebuilt));
  }
  if (contains(b.plan.rebuilt, "src")) {
    return test.fail("an up-to-date source was rebuilt");
  }
  let at = index_of(b.nodes, "bin");
  if (!b.nodes[at].exists) {
    return test.fail("bin still does not exist");
  }
  return test.pass();
}

function test_equal_timestamps_are_up_to_date(): test.TestOutcome {
  let g: Node[] = [
    node("a", no_deps(), 4, true), node("b", ["a"], 4, true),
    node("c", ["b"], 4, true),
  ];
  let b = build(g);
  if (b.plan.rebuilt.len() != 0) {
    return test.fail("equal timestamps caused a rebuild of " + show(b.plan.rebuilt));
  }
  let older = g.with(1, node("b", ["a"], 3, true));
  let b2 = build(older);
  if (!same_set(b2.plan.rebuilt, ["b", "c"])) {
    return test.fail("a one-tick-older target rebuilt " + show(b2.plan.rebuilt)
      + ", want [b,c]");
  }
  return test.pass();
}

function main(): i32 {
  eprint("buildgraph — what to rebuild, from a dependency graph and timestamps");

  let gs = graphs();
  let i = 0;
  while (i < gs.len()) {
    let b = build(gs[i]);
    eprint("  graph " + i.to_string() + " order=" + show(b.plan.order)
      + " rebuilt=" + show(b.plan.rebuilt));
    i += 1;
  }
  let cyc = cyclic_graphs();
  let j = 0;
  while (j < cyc.len()) {
    eprint("  cyclic " + j.to_string() + ": kahn="
      + topo_order(cyc[j]).cyclic.to_string() + " dfs=" + dfs_cyclic(cyc[j]).to_string());
    j += 1;
  }

  let r = test.new("buildgraph");
  r = r.it("after building everything is up to date", test_after_building_everything_is_up_to_date);
  r = r.it("exactly the necessary targets are rebuilt", test_exactly_the_necessary_targets_are_rebuilt);
  r = r.it("a change propagates to every transitive dependent", test_a_change_propagates_to_every_transitive_dependent);
  r = r.it("the order is topological", test_the_order_is_topological);
  r = r.it("a second build is a no op", test_a_second_build_is_a_no_op);
  r = r.it("the two cycle detectors agree", test_the_two_cycle_detectors_agree);
  r = r.it("a missing target is rebuilt", test_a_missing_target_is_rebuilt);
  r = r.it("equal timestamps are up to date", test_equal_timestamps_are_up_to_date);
  return r.finish();
}
