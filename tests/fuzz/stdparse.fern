import "std/brotli";
import "std/deflate";
import "std/dns";
import "std/hash/crc32";
import "std/hex";
import "std/http";
import "std/jpeg";
import "std/http/h2";
import "std/http/h2/frame";
import "std/http/hpack";
import "std/http/qpack";
import "std/json";
import "std/protobuf";
import "std/quic/frames";
import "std/quic/packet";
import "std/result";
import "std/time";
import "std/tls/handshake";
import "std/tls/message";
import "std/tls/pem";
import "std/tls/record";
import "std/tls/verify";
import "std/tls/x509";
import "std/url";
import "std/utf8";
import "std/zstd";

// Feeds a file to one network-facing parser of the standard library: the
// HTTP/1 request framer and its chunked-body decoder, the HTTP/2 frame reader
// and server connection, the HPACK or QPACK decoder, the QUIC packet or frame
// reader, the TLS record and handshake readers, the X.509 reader, the
// DEFLATE, gzip, zlib, zstd and Brotli decoders, the DNS message reader, the
// protobuf reader, the JPEG decoder, the JSON parser, or the URL and query
// parsers. Each refuses malformed bytes with an
// error value, so the accepted outcome is exit 0 with a summary on stdout.
// Exit 2 is a usage or read error.

function text_of(b: u8[]): string {
  let src = "";
  unsafe {
    src = string_from_bytes_unchecked(b);
  }
  return src;
}

// Feeds the bytes in pieces of seven, so a decoder carries state across calls.
function chunked(raw: u8[]): string {
  let d = http.chunk_decoder(http.limits());
  let at = 0;
  let body = 0;
  while (at < raw.len()) {
    let end = at + 7;
    if (end > raw.len()) {
      end = raw.len();
    }
    match (d.feed(__bytes_range(raw, at, end))) {
      http.ChunkData(next, bytes) => {
        d = next;
        body += bytes.len();
      },
      http.ChunkEnd(bytes, _, rest) => {
        return "end " + (body + bytes.len()).to_string() + " rest " + (rest.len() + raw.len() - end).to_string();
      },
      http.ChunkRefused(code) => {
        return "refused " + code.to_string();
      }
    }
    at = end;
  }
  return "open " + body.to_string();
}

function http_summary(raw: u8[]): string {
  let framing = "";
  match (http.parse_request_framed(raw)) {
    http.Complete(f) => {
      framing = "complete " + f.len.to_string();
    },
    http.Incomplete => {
      framing = "incomplete";
    },
    http.Continue => {
      framing = "continue";
    },
    http.Malformed(code) => {
      framing = "malformed " + code.to_string();
    }
  }
  return "http " + framing + " chunked " + chunked(raw);
}

// Decodes the bytes as two header blocks on one decoder, so the second block
// reads the dynamic table the first one filled.
function hpack_summary(raw: u8[]): string {
  let d = hpack.decoder(4096, 16384);
  let fields = 0;
  let round = 0;
  while (round < 2) {
    match (d.decode(raw)) {
      Ok(r) => {
        d = r.decoder;
        fields += r.fields.len();
      },
      Err(e) => {
        return "hpack refused " + e.message().len().to_string() + " fields " + fields.to_string();
      }
    }
    round += 1;
  }
  return "hpack fields " + fields.to_string() + " table " + d.table_size().to_string();
}

// Reads frames until the bytes run out or a frame is refused, then feeds the
// client preface and the same bytes in pieces of nine to a server connection.
function h2_summary(raw: u8[]): string {
  let frames = 0;
  let at = 0;
  let refused = 0;
  while (refused == 0) {
    match (frame.read(raw, at, frame.MIN_FRAME_SIZE)) {
      Ok(frame.Got(_, used)) => {
        frames += 1;
        at += used;
      },
      Ok(frame.More) => {
        break;
      },
      Err(e) => {
        refused = e.code + 1;
      }
    }
  }
  let step = h2.server(h2.config());
  let output = step.output.len();
  let events = step.events.len();
  step = step.conn.read(frame.preface());
  output += step.output.len();
  events += step.events.len();
  let from = 0;
  while (from < raw.len()) {
    let end = from + 9;
    if (end > raw.len()) {
      end = raw.len();
    }
    step = step.conn.read(__bytes_range(raw, from, end));
    output += step.output.len();
    events += step.events.len();
    from = end;
  }
  return "h2 frames " + frames.to_string() + " refused " + refused.to_string() + " events " + events.to_string() + " output " + output.to_string();
}

// The first byte gives the length of the encoder-stream bytes that follow it,
// and the rest is one header section on stream 0.
function qpack_summary(raw: u8[]): string {
  let d = qpack.decoder(4096i64, 16i64, 65536i64);
  if (raw.len() == 0) {
    return "qpack empty";
  }
  let split = 1 + raw[0] as i32;
  if (split > raw.len()) {
    split = raw.len();
  }
  match (d.on_encoder_stream(__bytes_range(raw, 1, split))) {
    Ok(next) => {
      d = next;
    },
    Err(e) => {
      return "qpack encoder refused " + e.message().len().to_string();
    }
  }
  d = d.decode(0i64, __bytes_range(raw, split, raw.len()));
  if let Some(e) = d.failed {
    return "qpack refused " + e.message().len().to_string();
  }
  return "qpack fields " + d.fields.len().to_string() + " waiting " + d.waiting.to_string() + " inserts " + d.insert_count().to_string();
}

// Walks the coalesced packets of one datagram, and tries to open each Initial
// packet with the client Initial keys of its destination connection ID.
function quic_summary(raw: u8[]): string {
  let packets = 0;
  let opened = 0;
  let refused = 0;
  let at = 0;
  while (at < raw.len() && refused == 0) {
    match (packet.parse(raw, at, 8)) {
      Ok(h) => {
        packets += 1;
        let initial = match (h.kind) { packet.Initial => true, _ => false };
        if (initial) {
          match (packet.open(raw, h, packet.initial_keys(h.dcid, true), -1i64)) {
            Ok(_) => {
              opened += 1;
            },
            Err(_) => {}
          }
        }
        if (h.end <= at) {
          return "quic stalled at " + at.to_string();
        }
        at = h.end;
      },
      Err(e) => {
        refused = e.message().len() + 1;
      }
    }
  }
  return "quic packets " + packets.to_string() + " opened " + opened.to_string() + " refused " + refused.to_string();
}

function quic_frames_summary(raw: u8[]): string {
  match (frames.read_all(raw)) {
    Ok(fs) => {
      return "frames " + fs.len().to_string();
    },
    Err(e) => {
      return "frames refused " + e.code.to_string();
    }
  }
}

// Runs the reader of one ClientHello or ServerHello extension, and gives true
// when the reader accepts the data or when no reader takes the kind.
function extension_ok(e: message.Extension): boolean {
  let k = e.kind;
  if (k == message.EXT_SERVER_NAME) {
    return message.server_name(e.data).is_ok();
  }
  if (k == message.EXT_SUPPORTED_VERSIONS) {
    return message.supported_versions(e.data).is_ok() || message.selected_version(e.data).is_ok();
  }
  if (k == message.EXT_SUPPORTED_GROUPS) {
    return message.supported_groups(e.data).is_ok();
  }
  if (k == message.EXT_SIGNATURE_ALGORITHMS) {
    return message.signature_algorithms(e.data).is_ok();
  }
  if (k == message.EXT_KEY_SHARE) {
    return message.key_shares(e.data).is_ok() || message.key_share(e.data).is_ok() || message.retry_group(e.data).is_ok();
  }
  if (k == message.EXT_ALPN) {
    return message.alpn(e.data).is_ok();
  }
  if (k == message.EXT_PRE_SHARED_KEY) {
    return message.pre_shared_key(e.data).is_ok() || message.selected_psk(e.data).is_ok();
  }
  if (k == message.EXT_PSK_KEY_EXCHANGE_MODES) {
    return message.psk_modes(e.data).is_ok();
  }
  return true;
}

function extensions_of(m: message.Message): message.Extension[] {
  match (m) {
    message.ClientHelloMsg(h) => {
      return h.extensions;
    },
    message.ServerHelloMsg(h) => {
      return h.extensions;
    },
    message.EncryptedExtensions(es) => {
      return es;
    },
    _ => {
      return [];
    }
  }
}

// Splits the bytes into handshake messages, decodes each one, and runs the
// extension readers over each hello.
function messages_summary(raw: [u8]): string {
  match (message.split(raw)) {
    Ok(sp) => {
      let decoded = 0;
      let extensions = 0;
      let refused = 0;
      for r in sp.messages {
        match (message.decode(r)) {
          Ok(m) => {
            decoded += 1;
            for e in extensions_of(m) {
              extensions += 1;
              if (!extension_ok(e)) {
                refused += 1;
              }
            }
          },
          Err(_) => {}
        }
      }
      return "messages " + sp.messages.len().to_string() + " decoded " + decoded.to_string() + " extensions " + extensions.to_string() + " refused " + refused.to_string() + " rest " + sp.rest.len().to_string();
    },
    Err(e) => {
      return "messages refused " + e.message().len().to_string();
    }
  }
}

// Deframes the bytes as TLS records and reads the handshake records as
// handshake messages. A record that does not deframe falls back to reading
// the bytes as a handshake stream, as a QUIC CRYPTO frame carries them.
function tls_summary(raw: u8[]): string {
  match (record.deframe(raw)) {
    Ok(d) => {
      let hs: u8[] = [];
      for r in d.records {
        match (r.content_type) {
          record.Handshake => {
            hs = hs.concat(r.fragment);
          },
          _ => {}
        }
      }
      return "tls records " + d.records.len().to_string() + " rest " + d.rest.len().to_string() + " " + messages_summary(hs);
    },
    Err(e) => {
      return "tls deframe refused " + e.message().len().to_string() + " " + messages_summary(raw);
    }
  }
}

function filled(start: i32, n: i32): u8[] {
  let out = __alloc_u8(n);
  let i = 0;
  while (i < n) {
    out = out.with(i, (start + i * 7 & 255) as u8);
    i += 1;
  }
  return out;
}

struct Tally { events: i32, output: i32, signs: i32, verifies: i32 }

function tally(t: Tally, output: [u8], events: handshake.Event[]): Tally {
  let signs = t.signs;
  let verifies = t.verifies;
  for e in events {
    match (e) {
      handshake.SignNeeded(_) => {
        signs += 1;
      },
      handshake.VerifyServer(_) => {
        verifies += 1;
      },
      handshake.VerifyClient(_) => {
        verifies += 1;
      },
      _ => {}
    }
  }
  return Tally { events: t.events + events.len(), output: t.output + output.len(), signs: signs, verifies: verifies };
}

function tally_text(t: Tally): string {
  return " events " + t.events.to_string() + " output " + t.output.to_string() + " signs " + t.signs.to_string() + " verifies " + t.verifies.to_string();
}

// Starts a server and feeds it the bytes in pieces of eleven. A request for a
// signature gets a signature of zeros, so a hostile ClientHello can reach the
// next state.
function tls_server_summary(raw: u8[]): string {
  let config = handshake.server_config([filled(3, 32)], [0x0807]);
  let s: handshake.Server = match (handshake.server_new(config, filled(2, handshake.server_entropy(config)))) {
    Ok(v) => v,
    Err(e) => {
      return "tls-server config refused " + e.message();
    },
  };
  let t = Tally { events: 0, output: 0, signs: 0, verifies: 0 };
  let at = 0;
  while (at < raw.len()) {
    let end = at + 11;
    if (end > raw.len()) {
      end = raw.len();
    }
    match (s.read_alerting(__bytes_range(raw, at, end))) {
      Ok(step) => {
        t = tally(t, step.output, step.events);
        s = step.server;
        if (t.signs == 1 && step.events.len() > 0) {
          match (s.signature(__alloc_u8(64))) {
            Ok(signed) => {
              t = tally(t, signed.output, signed.events);
              s = signed.server;
            },
            Err(e) => {
              return "tls-server signature refused " + e.message().len().to_string() + tally_text(t);
            }
          }
        }
      },
      Err(r) => {
        return "tls-server refused " + r.error.message().len().to_string() + " alert " + r.alert.len().to_string() + tally_text(t);
      }
    }
    at = end;
  }
  return "tls-server open" + tally_text(t);
}

function fuzz_client(): Result[handshake.ClientStep, handshake.HandshakeError] {
  let config = handshake.client_config("example.com");
  return handshake.client_start(config, filled(1, handshake.client_entropy(config)));
}

// Prints the ClientHello of the client that the tls-client reader starts, so
// a test can ask another implementation's server for a reply to it.
function tls_hello_summary(): string {
  match (fuzz_client()) {
    Ok(step) => {
      return "tls-hello " + hex.encode(step.output);
    },
    Err(e) => {
      return "tls-hello refused " + e.message();
    }
  }
}

// Starts a client and reads the bytes as the server's flight in pieces of
// eleven. A chain to verify gets a verdict that accepts it, so a hostile
// flight can reach the server's Finished message.
function tls_client_summary(raw: u8[]): string {
  let c: handshake.Client = match (fuzz_client()) {
    Ok(v) => v.client,
    Err(e) => {
      return "tls-client config refused " + e.message();
    },
  };
  let t = Tally { events: 0, output: 0, signs: 0, verifies: 0 };
  let answered = false;
  let at = 0;
  while (at < raw.len()) {
    let end = at + 11;
    if (end > raw.len()) {
      end = raw.len();
    }
    match (c.read(__bytes_range(raw, at, end))) {
      Ok(step) => {
        t = tally(t, step.output, step.events);
        c = step.client;
      },
      Err(e) => {
        return "tls-client refused " + e.message().len().to_string() + tally_text(t);
      }
    }
    if (t.verifies > 0 && !answered) {
      answered = true;
      match (c.verdict(true)) {
        Ok(step) => {
          t = tally(t, step.output, step.events);
          c = step.client;
        },
        Err(e) => {
          return "tls-client verdict refused " + e.message().len().to_string() + tally_text(t);
        }
      }
    }
    at = end;
  }
  if (c.connected()) {
    return "tls-client connected" + tally_text(t);
  }
  return "tls-client open" + tally_text(t);
}

// Reads PEM text when the bytes start with a PEM line, and one DER
// certificate otherwise. Each certificate is then verified as its own root
// for example.com at a fixed time.
function x509_summary(raw: u8[]): string {
  let ders: u8[][] = [raw];
  if (raw.len() >= 10 && text_of(raw.take(10)) == "-----BEGIN") {
    match (pem.certificates(text_of(raw))) {
      Ok(cs) => {
        ders = cs;
      },
      Err(e) => {
        return "x509 pem refused " + e.message().len().to_string();
      }
    }
  }
  let parsed = 0;
  let verified = 0;
  let names = 0;
  for der in ders {
    match (x509.parse(der)) {
      Ok(c) => {
        parsed += 1;
        names += c.dns_names.len();
        let now = time.timestamp_from_unix(1800000000i64);
        if (verify.server([der], verify.roots([der]), "example.com", now).is_ok()) {
          verified += 1;
        }
      },
      Err(_) => {}
    }
  }
  return "x509 certificates " + ders.len().to_string() + " parsed " + parsed.to_string() + " verified " + verified.to_string() + " names " + names.to_string();
}

// The output limit of each decoder, 1 MiB.
const DECODE_LIMIT: i32 = 1048576;

// The length and CRC-32 of decoded bytes, which a test compares with the
// output of another decoder.
function digest(out: [u8]): string {
  return out.len().to_string() + " crc " + crc32.of(out).to_string();
}

function inflate_refusal(e: deflate.InflateError): string {
  match (e) {
    deflate.Truncated => {
      return "truncated";
    },
    deflate.OutputLimit => {
      return "limit";
    },
    deflate.BadChecksum => {
      return "checksum";
    },
    deflate.BadLength => {
      return "length";
    },
    deflate.BadHeader(_) => {
      return "header";
    },
    deflate.Malformed(_) => {
      return "malformed";
    }
  }
}

function inflate_summary(raw: u8[]): string {
  match (deflate.inflate(raw, DECODE_LIMIT)) {
    Ok(got) => {
      return "inflate ok " + digest(got.out) + " consumed " + got.consumed.to_string();
    },
    Err(e) => {
      return "inflate refused " + inflate_refusal(e);
    }
  }
}

function gunzip_summary(raw: u8[]): string {
  match (deflate.gunzip(raw, DECODE_LIMIT)) {
    Ok(out) => {
      return "gunzip ok " + digest(out);
    },
    Err(e) => {
      return "gunzip refused " + inflate_refusal(e);
    }
  }
}

function zlib_summary(raw: u8[]): string {
  match (deflate.zlib_decode(raw, DECODE_LIMIT)) {
    Ok(out) => {
      return "zlib ok " + digest(out);
    },
    Err(e) => {
      return "zlib refused " + inflate_refusal(e);
    }
  }
}

function same(a: [u8], b: [u8]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Decodes the bytes as a zstd frame, then compresses the bytes and decodes
// them back. A round trip that does not give the bytes back is a finding.
function zstd_summary(raw: u8[]): string {
  let decoded = "";
  match (zstd.decompress(raw, DECODE_LIMIT)) {
    Ok(out) => {
      decoded = "ok " + digest(out);
    },
    Err(e) => {
      decoded = "refused " + e.message().len().to_string();
    }
  }
  let trip = "broken";
  match (zstd.decompress(zstd.compress(raw), raw.len())) {
    Ok(back) => {
      if (same(back, raw)) {
        trip = "ok";
      }
    },
    Err(_) => {}
  }
  return "zstd " + decoded + " roundtrip " + trip;
}

function brotli_summary(raw: u8[]): string {
  let decoded = "";
  match (brotli.decompress(raw, DECODE_LIMIT)) {
    Ok(out) => {
      decoded = "ok " + digest(out);
    },
    Err(e) => {
      decoded = "refused " + e.message().len().to_string();
    }
  }
  let trip = "broken";
  match (brotli.decompress(brotli.compress(raw), raw.len())) {
    Ok(back) => {
      if (same(back, raw)) {
        trip = "ok";
      }
    },
    Err(_) => {}
  }
  return "brotli " + decoded + " roundtrip " + trip;
}

function rdata_text(d: dns.RData): string {
  match (d) {
    dns.A(ip) => {
      return "A " + ip.to_string();
    },
    dns.AAAA(ip) => {
      return "AAAA " + ip.to_string();
    },
    dns.CNAME(name) => {
      return "CNAME " + name;
    },
    dns.PTR(name) => {
      return "PTR " + name;
    },
    dns.Raw(b) => {
      return "raw " + digest(b);
    }
  }
}

function records_text(rs: dns.Record[]): string {
  let out = "";
  for r in rs {
    out = out + " [" + r.name + " " + r.rtype.to_string() + " " + r.rclass.to_string() + " " + r.ttl.to_string() + " " + rdata_text(r.data) + "]";
  }
  return out;
}

// Every field of a message, so two decodes of the same message compare equal.
function message_text(m: dns.Message): string {
  let out = m.id.to_string() + " " + m.opcode.to_string() + " " + m.rcode.to_string();
  if (m.response) {
    out = out + " qr";
  }
  if (m.authoritative) {
    out = out + " aa";
  }
  if (m.truncated) {
    out = out + " tc";
  }
  if (m.recursion_desired) {
    out = out + " rd";
  }
  if (m.recursion_available) {
    out = out + " ra";
  }
  for q in m.questions {
    out = out + " (" + q.name + " " + q.qtype.to_string() + " " + q.qclass.to_string() + ")";
  }
  return out + records_text(m.answers) + records_text(m.authority) + records_text(m.additional);
}

// Decodes the bytes as a DNS message, then encodes the message and decodes it
// again. A second decode that differs from the first is a finding.
function dns_summary(raw: u8[]): string {
  match (dns.decode(raw)) {
    Ok(m) => {
      let counts = m.questions.len().to_string() + " " + m.answers.len().to_string() + " " + m.authority.len().to_string() + " " + m.additional.len().to_string();
      match (dns.encode(m)) {
        Ok(b) => {
          match (dns.decode(b)) {
            Ok(again) => {
              if (message_text(again) == message_text(m)) {
                return "dns ok " + counts + " roundtrip ok";
              }
              return "dns ok " + counts + " roundtrip broken";
            },
            Err(e) => {
              return "dns ok " + counts + " roundtrip broken " + e.message();
            }
          }
        },
        Err(e) => {
          return "dns ok " + counts + " encode refused " + e.message().len().to_string();
        }
      }
    },
    Err(e) => {
      return "dns refused " + e.message().len().to_string();
    }
  }
}

// Decodes the bytes as protobuf fields, and each length-delimited field once
// more as a nested message.
function protobuf_summary(raw: u8[]): string {
  match (protobuf.decode(raw)) {
    Ok(fields) => {
      let nested = 0;
      for f in fields {
        if (f.wire == 2) {
          match (protobuf.decode(f.bytes)) {
            Ok(inner) => {
              nested += inner.len();
            },
            Err(_) => {}
          }
        }
      }
      return "protobuf ok " + fields.len().to_string() + " nested " + nested.to_string();
    },
    Err(e) => {
      return "protobuf refused " + e.message().len().to_string();
    }
  }
}

// The pixel limit of the JPEG reader. The buffers of an image this large
// stay inside the memory budget of a fuzz input.
const JPEG_LIMIT: i64 = 1048576i64;

function jpeg_summary(raw: u8[]): string {
  match (jpeg.decode_image_limit(raw, JPEG_LIMIT)) {
    Ok(img) => {
      return "jpeg ok " + img.width.to_string() + " " + img.height.to_string() + " " + digest(img.pixels);
    },
    Err(e) => {
      return "jpeg refused " + e.message();
    }
  }
}

function json_summary(src: string): string {
  match (json.parse(src)) {
    Ok(_) => {
      return "json ok";
    },
    Err(e) => {
      return "json refused " + e.message().len().to_string();
    }
  }
}

function url_summary(src: string): string {
  let query = url.query_parse(src).len();
  match (url.parse(src)) {
    Ok(_) => {
      return "url ok query " + query.to_string();
    },
    Err(e) => {
      return "url refused " + e.message().len().to_string() + " query " + query.to_string();
    }
  }
}

// The validator and the lossy decoder of std/utf8, on the same bytes.
function utf8_summary(raw: u8[]): string {
  let lossy = utf8.from_bytes_lossy(raw);
  let agree = utf8.is_valid(text_of(raw));
  match (utf8.from_bytes(raw)) {
    Ok(s) => {
      let same = "differs";
      if (lossy == s) {
        same = "same";
      }
      return "utf8 ok " + s.len().to_string() + " " + s.chars().len().to_string() + " lossy " + same + " valid " + agree.to_string();
    },
    Err(e) => {
      return "utf8 refused " + e.offset.to_string() + " lossy " + utf8.is_valid(lossy).to_string() + " valid " + agree.to_string();
    }
  }
}

function main(): i32 {
  let av = args();
  if (av.len() < 3) {
    eprint("usage: stdparse http|h2|hpack|qpack|quic|frames|tls|tls-server|tls-client|tls-hello|x509|inflate|gunzip|zlib|zstd|brotli|dns|protobuf|jpeg|json|url|utf8 FILE");
    return 2;
  }
  let raw: u8[] = [];
  match (read_file_bytes(av[2])) {
    Ok(b) => {
      raw = b;
    },
    Err(_) => {
      eprint("stdparse: cannot read " + av[2]);
      return 2;
    }
  }
  if (av[1] == "http") {
    print(http_summary(raw));
    return 0;
  }
  if (av[1] == "hpack") {
    print(hpack_summary(raw));
    return 0;
  }
  if (av[1] == "h2") {
    print(h2_summary(raw));
    return 0;
  }
  if (av[1] == "qpack") {
    print(qpack_summary(raw));
    return 0;
  }
  if (av[1] == "quic") {
    print(quic_summary(raw));
    return 0;
  }
  if (av[1] == "frames") {
    print(quic_frames_summary(raw));
    return 0;
  }
  if (av[1] == "tls") {
    print(tls_summary(raw));
    return 0;
  }
  if (av[1] == "tls-server") {
    print(tls_server_summary(raw));
    return 0;
  }
  if (av[1] == "tls-hello") {
    print(tls_hello_summary());
    return 0;
  }
  if (av[1] == "tls-client") {
    print(tls_client_summary(raw));
    return 0;
  }
  if (av[1] == "x509") {
    print(x509_summary(raw));
    return 0;
  }
  if (av[1] == "inflate") {
    print(inflate_summary(raw));
    return 0;
  }
  if (av[1] == "gunzip") {
    print(gunzip_summary(raw));
    return 0;
  }
  if (av[1] == "zlib") {
    print(zlib_summary(raw));
    return 0;
  }
  if (av[1] == "zstd") {
    print(zstd_summary(raw));
    return 0;
  }
  if (av[1] == "brotli") {
    print(brotli_summary(raw));
    return 0;
  }
  if (av[1] == "dns") {
    print(dns_summary(raw));
    return 0;
  }
  if (av[1] == "protobuf") {
    print(protobuf_summary(raw));
    return 0;
  }
  if (av[1] == "jpeg") {
    print(jpeg_summary(raw));
    return 0;
  }
  if (av[1] == "json") {
    print(json_summary(text_of(raw)));
    return 0;
  }
  if (av[1] == "url") {
    print(url_summary(text_of(raw)));
    return 0;
  }
  if (av[1] == "utf8") {
    print(utf8_summary(raw));
    return 0;
  }
  eprint("stdparse: unknown reader " + av[1]);
  return 2;
}
