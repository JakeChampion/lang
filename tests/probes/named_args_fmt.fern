function diff(a: i32 = 0, b: i32 = 0): i32 {
  return a - b;
}

function plain(): i32 {
  return diff(b = 1, a = 9);
}

function piped(): i32 {
  return 9 |> diff(b = 1);
}

function hole(): i32 {
  return 9 |> diff(b = _);
}

function defaulted(): i32 {
  return diff(a = 4);
}

function main(): i32 {
  return plain() + piped() + hole() + defaulted();
}
