enum Tok { Ident(string), Eof }

function build(n: i32): i32 {
  let xs: Tok[] = [];
  let i: i32 = 0;
  while (i < n) {
    let t: string = "tok" + slice_unchecked("abcdefghij", 0, i % 10 + 1);
    xs = xs.append(Ident(t));
    i = i + 1;
  }
  return xs.len() % 7;
}

function main(): i32 {
  let acc: i32 = 0;
  let r: i32 = 0;
  while (r < 2) {
    acc = acc + build(5000);
    r = r + 1;
  }
  return acc % 5;
}
