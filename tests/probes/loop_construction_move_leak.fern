function in_loop(): i32 {
  let s: i32 = 0;
  let k: i32 = 0;
  while (k < 3) {
    let xs: i32[] = [1, 2, 3];
    let t = (xs, 99);
    s = s + t.0[2];
    k = k + 1;
  }
  return s;
}

function fresh(): i32 {
  let s: i32 = 0;
  let k: i32 = 0;
  while (k < 3) {
    let t = ([1, 2, 3], 99);
    s = s + t.0[2];
    k = k + 1;
  }
  return s;
}

function toplevel(): i32 {
  let xs: i32[] = [1, 2, 3];
  let t = (xs, 99);
  return t.0[2];
}

function main(): i32 {
  return (in_loop() + fresh() + toplevel()) % 7;
}
