import "std/i32";
import "std/string";

function temp(): i32 {
  let acc = 0;
  let k = 1;
  while (k < 40) {
    let s = (k * 66049).to_binary().pad_start(40, '0');
    let i = 0;
    while (i < s.len()) {
      acc = (acc * 31 + s[i] as i32) % 100003;
      i += 1;
    }
    k += 1;
  }
  return acc % 251;
}

function bound(): i32 {
  let acc = 0;
  let k = 1;
  while (k < 40) {
    let h = (k * 66049).to_binary();
    let s = h.pad_start(40, '0');
    let i = 0;
    while (i < s.len()) {
      acc = (acc * 31 + s[i] as i32) % 100003;
      i += 1;
    }
    k += 1;
  }
  return acc % 251;
}

function main(): i32 {
  if (temp() != bound()) {
    return 1;
  }
  return 0;
}
