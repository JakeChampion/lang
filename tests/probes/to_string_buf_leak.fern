import "std/i32";
import "std/i64";
import "std/u64";

function main(): i32 {
  let t = 0;
  let k = 0;
  while (k < 50) {
    let s = k.to_string();
    let u = (k as i64 * 1000000007).to_string();
    let v = (k as u64 * (1234567891 as u64)).to_string();
    let w = (k * 1234567).to_binary();
    t = t + s.len() + u.len() + v.len() + w.len();
    k += 1;
  }
  if (t == 2378) {
    return 0;
  }
  return 1;
}
