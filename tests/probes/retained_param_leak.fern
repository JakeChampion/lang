import "std/i32";

struct Tk { name: string, line: i32 }

function mkT(name: string, line: i32): Tk {
  return Tk { name: name, line: line };
}

function main(): i32 {
  let acc: i32 = 0;
  let r: i32 = 0;
  while (r < 1000) {
    let s: string = "id" + r.to_string();
    let t: Tk = mkT(s, r);
    acc = acc + t.name.len();
    r = r + 1;
  }
  return acc % 5;
}
