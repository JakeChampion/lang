import "std/i32";

struct Tk { name: string, line: i32 }

function mkT(name: string, line: i32): Tk {
  return Tk { name: name, line: line };
}

function main(): i32 {
  let acc = 0;
  let r = 0;
  while (r < 1000) {
    let s = "id" + r.to_string();
    let t = mkT(s, r);
    acc += t.name.len();
    r += 1;
  }
  return acc % 5;
}
