function build(n: i32): i32 {
  let xs: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    xs = xs.append(i);
    i = i + 1;
  }
  return xs.len() % 7;
}

function main(): i32 {
  let acc: i32 = 0;
  let r: i32 = 0;
  while (r < 4) {
    acc = acc + build(1000);
    r = r + 1;
  }
  return acc % 5;
}
