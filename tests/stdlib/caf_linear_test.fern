import "std/test";
import "linear_audio_check";
import "linear_audio_vectors";

function references(): test.TestOutcome {
  let count = 0;
  for vector in linear_audio_vectors.all() {
    if (vector.container != 2) {
      continue;
    }
    if let Err(e) = linear_audio_check.run(vector) {
      return test.fail(vector.name + ": " + e);
    }
    count += 1;
  }
  if (count != 36) {
    return test.fail("CAF reference corpus is incomplete");
  }
  return test.pass();
}

function main(): i32 {
  let runner = test.new("CAF linear PCM, float, and G.711 reference samples");
  runner = runner.it("byte order, depths, channels, float bits, code words, and presentation trim", references);
  return runner.finish();
}
