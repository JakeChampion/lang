import "std/test";
import "std/time" as time;

function test_is_leap_year(): test.TestOutcome {
  let yes: boolean = time.is_leap_year(2000) && time.is_leap_year(2024);
  let no: boolean = !time.is_leap_year(1900) && !time.is_leap_year(2100) && !time.is_leap_year(2023);
  return test.assert_true(yes && no);
}

function test_days_in_month_feb(): test.TestOutcome {
  return test.assert_true(time.days_in_month(2024, 2) == 29 && time.days_in_month(2023, 2) == 28);
}

function test_days_in_month_others(): test.TestOutcome {
  let ok: boolean = time.days_in_month(2024, 1) == 31
    && time.days_in_month(2024, 4) == 30
    && time.days_in_month(2024, 12) == 31;
  return test.assert_true(ok);
}

function test_is_valid_true(): test.TestOutcome {
  return test.assert_true(time.date_make(2024, 2, 29).is_valid());
}

function test_is_valid_false(): test.TestOutcome {
  let f1: boolean = !time.date_make(2023, 2, 29).is_valid();
  let f2: boolean = !time.date_make(2024, 13, 1).is_valid();
  let f3: boolean = !time.date_make(2024, 4, 31).is_valid();
  return test.assert_true(f1 && f2 && f3);
}

function test_add_days_within(): test.TestOutcome {
  let d = time.date_make(2024, 1, 1).add_days(10);
  return test.assert_true(d.year == 2024 && d.month == 1 && d.day == 11);
}

function test_add_days_leap_boundary(): test.TestOutcome {
  let d = time.date_make(2024, 2, 28).add_days(1);
  return test.assert_true(d.year == 2024 && d.month == 2 && d.day == 29);
}

function test_add_days_year_boundary(): test.TestOutcome {
  let d = time.date_make(2023, 12, 31).add_days(1);
  return test.assert_true(d.year == 2024 && d.month == 1 && d.day == 1);
}

function test_add_days_backward(): test.TestOutcome {
  let d = time.date_make(2024, 1, 1).add_days(0 - 1);
  return test.assert_true(d.year == 2023 && d.month == 12 && d.day == 31);
}

function test_days_since_year(): test.TestOutcome {
  return test.assert_eq(time.date_make(2024, 1, 1).days_since(time.date_make(2023, 1, 1)), 365);
}

function test_days_since_leap_feb(): test.TestOutcome {
  return test.assert_eq(time.date_make(2024, 3, 1).days_since(time.date_make(2024, 2, 28)), 2);
}

function test_day_of_year(): test.TestOutcome {
  let jan1: boolean = time.date_make(2024, 1, 1).day_of_year() == 1;
  let dec31_leap: boolean = time.date_make(2024, 12, 31).day_of_year() == 366;
  let dec31_plain: boolean = time.date_make(2023, 12, 31).day_of_year() == 365;
  return test.assert_true(jan1 && dec31_leap && dec31_plain);
}

function test_weekday(): test.TestOutcome {
  let mon: boolean = time.date_make(2024, 1, 1).weekday() == 1;
  let thu: boolean = time.date_make(1970, 1, 1).weekday() == 4;
  return test.assert_true(mon && thu);
}

function test_format_iso_basic(): test.TestOutcome {
  return test.assert_eq(time.date_make(2024, 2, 29).format_iso(), "2024-02-29");
}

function test_format_iso_zero_pad(): test.TestOutcome {
  return test.assert_eq(time.date_make(2024, 3, 7).format_iso(), "2024-03-07");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/time calendar");
  r = r.it("is_leap_year", test_is_leap_year);
  r = r.it("days_in_month feb", test_days_in_month_feb);
  r = r.it("days_in_month others", test_days_in_month_others);
  r = r.it("is_valid true", test_is_valid_true);
  r = r.it("is_valid false", test_is_valid_false);
  r = r.it("add_days within", test_add_days_within);
  r = r.it("add_days leap", test_add_days_leap_boundary);
  r = r.it("add_days year", test_add_days_year_boundary);
  r = r.it("add_days backward", test_add_days_backward);
  r = r.it("days_since year", test_days_since_year);
  r = r.it("days_since leap feb", test_days_since_leap_feb);
  r = r.it("day_of_year", test_day_of_year);
  r = r.it("weekday", test_weekday);
  r = r.it("format_iso basic", test_format_iso_basic);
  r = r.it("format_iso zero-pad", test_format_iso_zero_pad);
  return r.finish();
}
