import "std/test";

function test_f64_addition(): test.TestOutcome {
  return test.assert_eq_f64_near(1.5 + 2.5, 4.0, 0.001);
}

function test_f64_multiplication(): test.TestOutcome {
  return test.assert_eq_f64_near(3.7 * 3.7, 13.69, 0.001);
}

function test_f64_division_by_negative(): test.TestOutcome {
  return test.assert_eq_f64_near(10.0 / (0.0 - 4.0), 0.0 - 2.5, 0.001);
}

function test_f32_precision_loss(): test.TestOutcome {
  let f: f32 = 0.1 as f32;
  let sum: f32 = f + f + f;
  return test.assert_eq_f32_near(sum, 0.3 as f32, 0.0001 as f32);
}

function test_f64_exact_equality_on_integral(): test.TestOutcome {
  return test.assert_eq_f64_exact(2.0 * 21.0, 42.0);
}

function test_nan_detection(): test.TestOutcome {
  let z: f64 = 0.0;
  let nan: f64 = z / z;
  return test.assert_is_nan_f64(nan);
}

function test_nan_compares_unequal_to_itself(): test.TestOutcome {
  let z: f64 = 0.0;
  let nan: f64 = z / z;
  if (nan == nan) {
    return test.fail("NaN compared equal to itself");
  }
  return test.pass();
}

function test_f32_bits_round_trip(): test.TestOutcome {
  let x: f32 = 1.0 as f32;
  let bits: i32 = f32_bits(x);
  return test.assert_eq(bits, 1065353216);
}

function test_f32_from_bits_round_trips(): test.TestOutcome {
  let x: f32 = 3.14 as f32;
  let bits: i32 = f32_bits(x);
  let back: f32 = f32_from_bits(bits);
  return test.assert_eq_f32_near(back, x, 0.000001 as f32);
}

function test_negative_zero(): test.TestOutcome {
  let neg: f64 = 0.0 - 0.0;
  return test.assert_eq_f64_near(neg, 0.0, 0.0);
}

function test_inf_handling(): test.TestOutcome {
  let inf: f64 = 1.0 / 0.0;
  let also_inf: f64 = 2.0 / 0.0;
  return test.assert_eq_f64_near(inf, also_inf, 0.0);
}

function test_to_string_paths(): test.TestOutcome {
  if (42.0.to_string() != "42") {
    return test.fail("42.0");
  }
  if (1000000.0.to_string() != "1000000") {
    return test.fail("1e6");
  }
  if (3.25.to_string() != "3.25") {
    return test.fail("3.25");
  }
  if ((0.0 - 42.5).to_string() != "-42.5") {
    return test.fail("-42.5");
  }
  if (9223372036854775808.0.to_string() != "9223372036854776000") {
    return test.fail("2^63");
  }
  if (1e20.to_string() != "100000000000000000000") {
    return test.fail("1e20");
  }
  return test.assert_eq(1.5e30.to_string(), "1.5e+30");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("floats");
  r = r.it("f64 addition", test_f64_addition);
  r = r.it("f64 multiplication", test_f64_multiplication);
  r = r.it("f64 division by negative", test_f64_division_by_negative);
  r = r.it("f32 precision loss tolerance", test_f32_precision_loss);
  r = r.it("f64 exact on integral", test_f64_exact_equality_on_integral);
  r = r.it("NaN detection", test_nan_detection);
  r = r.it("NaN compares unequal to itself", test_nan_compares_unequal_to_itself);
  r = r.it("f32_bits gives expected pattern", test_f32_bits_round_trip);
  r = r.it("f32_from_bits round trips", test_f32_from_bits_round_trips);
  r = r.it("negative zero", test_negative_zero);
  r = r.it("Inf vs Inf", test_inf_handling);
  r = r.it("to_string digit paths", test_to_string_paths);
  return r.finish();
}
