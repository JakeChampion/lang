import "std/test";
import "std/ndarray" as ndarray;
import "std/option";

function build(n: i32): i32[] {
  let xs: i32[] = [];
  let i = 0;
  while (i < n) {
    xs = xs.append(i);
    i += 1;
  }
  return xs;
}

function grid(): ndarray.NdArray[i32] {
  return ndarray.from_flat(build(12), [3, 4]);
}

function test_from_flat_indexes_row_major(): test.TestOutcome {
  let a = grid();
  if (a.rank() != 2 || a.len() != 12) {
    return test.fail("rank or len");
  }
  if (a.shape()[0] != 3 || a.shape()[1] != 4) {
    return test.fail("shape");
  }
  if (a.strides()[0] != 4 || a.strides()[1] != 1) {
    return test.fail("strides");
  }
  if (a.get_unchecked([2, 1]) != 9) {
    return test.fail("get");
  }
  return test.assert_true(a.is_row_major() && a.is_packed());
}

function test_get_is_none_out_of_range(): test.TestOutcome {
  let a = grid();
  if (a.get([2, 1]).unwrap_or(-1) != 9) {
    return test.fail("in range");
  }
  if (a.get([3, 0]).is_some() || a.get([0, -1]).is_some()) {
    return test.fail("out of bounds");
  }
  return test.assert_true(a.get([1]).is_none() && a.get([0, 0, 0]).is_none());
}

function test_checked_shapes(): test.TestOutcome {
  let a = grid();
  let empty: i32[] = [];
  if (ndarray.try_from_flat(empty, [-1]).is_some() || ndarray.try_from_flat(empty, [65536, 65536]).is_some()) {
    return test.fail("invalid extent or overflowing count");
  }
  if (ndarray.try_from_flat([1], [2]).is_some() || ndarray.try_from_flat(empty, [3, 0]).is_none()) {
    return test.fail("flat input count");
  }
  if (a.try_reshape([3]).is_some() || a.try_reshape([-1]).is_some() || a.try_reshape([65536, 65536]).is_some()) {
    return test.fail("invalid reshape");
  }
  if (a.try_broadcast_to([12]).is_some() || a.try_broadcast_to([4, 3]).is_some() || a.try_broadcast_to([-1, 3, 4]).is_some()) {
    return test.fail("invalid broadcast");
  }
  let wide = a.try_broadcast_to([2, 3, 4]).unwrap_or(a);
  if (wide.rank() != 3 || wide.get_unchecked([1, 2, 3]) != 11) {
    return test.fail("broadcast across leading axis");
  }
  let flat = a.transpose().try_reshape([12]).unwrap_or(a);
  return test.assert_true(flat.rank() == 1 && flat.get_unchecked([1]) == 4);
}

function unexpected_element(x: i32, y: i32): i32 {
  exit(1);
  return 0;
}

function test_checked_broadcast_shape_and_zip(): test.TestOutcome {
  if (ndarray.try_broadcast_shape([50000, 1], [1, 50000]).is_some() || ndarray.try_broadcast_shape([-1], [1]).is_some()) {
    return test.fail("invalid or overflowing broadcast shape");
  }
  let a = grid();
  let row = ndarray.from_flat([10, 11, 12, 13], [4]);
  let result = a.try_zip_with(row, (x: i32, y: i32): i32 => x + y).unwrap_or(row);
  if (result.rank() != 2 || result.get_unchecked([2, 3]) != 24) {
    return test.fail("broadcast zip");
  }
  let empty = ndarray.from_flat([] as i32[], [0, 4]);
  if (empty.try_zip_with(row, unexpected_element).is_none()) {
    return test.fail("empty broadcast");
  }
  return test.assert_true(a.transpose().try_zip_with(row, unexpected_element).is_none());
}

function test_checked_axis_views(): test.TestOutcome {
  let a = grid();
  if (a.try_permute([1]).is_some() || a.try_permute([1, 1]).is_some() || a.try_permute([-1, 0]).is_some() || a.try_permute([0, 2]).is_some()) {
    return test.fail("invalid permutation");
  }
  if (a.try_reverse(-1).is_some() || a.try_select(2, 0).is_some() || a.try_select(1, 4).is_some() || a.try_slice(2, 0, 0).is_some()) {
    return test.fail("invalid axis or index");
  }
  if (a.try_slice(1, -1, 0).is_some() || a.try_slice(1, 3, 2).is_some() || a.try_slice(1, 4, 5).is_some() || a.try_slice(1, 4, 4).is_none()) {
    return test.fail("slice boundaries");
  }
  let empty = ndarray.from_flat([] as i32[], [0, 65536, 65536]);
  if (empty.try_permute([1, 2, 0]).is_some()) {
    return test.fail("permuted shape overflows before its zero axis");
  }
  let Some(moved) = empty.try_permute([1, 0, 2]) else {
    return test.fail("representable empty permutation");
  };
  if (moved.len() != 0 || moved.shape() != [65536, 0, 65536]) {
    return test.fail("permuted empty view");
  }
  let view = a.try_permute([1, 0]).unwrap_or(a).try_reverse(0).unwrap_or(a).try_slice(0, 1, 3).unwrap_or(a).try_select(1, 2).unwrap_or(a);
  return test.assert_true(view.rank() == 1 && view.len() == 2 && view.get_unchecked([0]) == 10 && view.get_unchecked([1]) == 9);
}

function test_transpose_swaps_indices(): test.TestOutcome {
  let t = grid().transpose();
  if (t.shape()[0] != 4 || t.shape()[1] != 3) {
    return test.fail("shape");
  }
  if (t.get_unchecked([1, 2]) != 9) {
    return test.fail("get");
  }
  if (t.is_row_major()) {
    return test.fail("a transpose is not row-major");
  }
  return test.assert_eq(t.transpose().get_unchecked([2, 1]), 9);
}

function test_permute_is_the_general_transpose(): test.TestOutcome {
  let a = ndarray.from_flat(build(24), [2, 3, 4]);
  let p = a.permute([2, 0, 1]);
  if (p.shape()[0] != 4 || p.shape()[1] != 2 || p.shape()[2] != 3) {
    return test.fail("shape");
  }
  return test.assert_eq(p.get_unchecked([3, 1, 2]), a.get_unchecked([1, 2, 3]));
}

function test_reverse_flips_one_axis(): test.TestOutcome {
  let r = grid().reverse(1);
  if (r.get_unchecked([0, 0]) != 3 || r.get_unchecked([2, 3]) != 8) {
    return test.fail("reversed reads");
  }
  if (r.reverse(1).get_unchecked([0, 0]) != 0) {
    return test.fail("reversed twice");
  }
  let f = r.to_flat();
  if (f.len() != 12 || f[0] != 3 || f[3] != 0 || f[4] != 7 || f[11] != 8) {
    return test.fail("to_flat of a reverse");
  }
  let both = grid().reverse(0).reverse(1).packed();
  if (!both.is_packed() || both.get_unchecked([0, 0]) != 11) {
    return test.fail("packed of a double reverse");
  }
  return test.assert_eq(both.get_unchecked([2, 3]), 0);
}

function test_slice_and_select_are_partial_views(): test.TestOutcome {
  let a = grid();
  let s = a.slice(1, 1, 3);
  if (s.shape()[1] != 2 || s.get_unchecked([2, 1]) != 10) {
    return test.fail("slice");
  }
  let row = a.select(0, 2);
  if (row.rank() != 1 || row.get_unchecked([3]) != 11) {
    return test.fail("select a row");
  }
  let col = a.select(1, 1);
  if (col.rank() != 1 || col.get_unchecked([2]) != 9) {
    return test.fail("select a column");
  }
  return test.assert_eq(a.transpose().select(0, 1).get_unchecked([2]), 9);
}

function test_reshape_keeps_reading_order(): test.TestOutcome {
  let a = grid();
  let flat = a.reshape([12]);
  if (flat.get_unchecked([5]) != 5) {
    return test.fail("row-major reshape");
  }
  let t = a.transpose().reshape([12]);
  return test.assert_eq(t.get_unchecked([1]), 4);
}

function test_to_flat_and_packed(): test.TestOutcome {
  let a = grid();
  let t = a.transpose();
  let f = t.to_flat();
  if (f.len() != 12 || f[0] != 0 || f[1] != 4 || f[11] != 11) {
    return test.fail("to_flat of a transpose");
  }
  if (t.is_packed()) {
    return test.fail("a transpose is not packed");
  }
  let p = t.packed();
  if (!p.is_packed() || p.get_unchecked([1, 2]) != 9) {
    return test.fail("packed");
  }
  return test.assert_eq(a.to_flat()[7], 7);
}

function test_rank_zero_and_empty(): test.TestOutcome {
  let z = ndarray.from_flat([7], []);
  if (z.rank() != 0 || z.len() != 1 || z.get_unchecked([]) != 7) {
    return test.fail("rank 0");
  }
  let e = grid().slice(0, 1, 1);
  if (e.len() != 0 || e.to_flat().len() != 0) {
    return test.fail("empty axis");
  }
  return test.assert_eq(e.shape()[0], 0);
}

function add(acc: i32, x: i32): i32 {
  return acc + x;
}

function test_map_and_zip_with_are_elementwise(): test.TestOutcome {
  let a = grid();
  let m: ndarray.NdArray[i32] = a.transpose().map((x: i32): i32 => x * 2);
  if (m.shape()[0] != 4 || !m.is_packed() || m.get_unchecked([1, 2]) != 18) {
    return test.fail("map of a transpose");
  }
  let z: ndarray.NdArray[i32] = a.zip_with(a.map((x: i32): i32 => x * 3), (x: i32, y: i32): i32 => y - x);
  if (z.get_unchecked([2, 3]) != 22) {
    return test.fail("zip_with");
  }
  return test.assert_eq(a.zip_with(a.reverse(1), add).get_unchecked([0, 0]), 3);
}

function test_fold_all_reads_in_order(): test.TestOutcome {
  let a = grid();
  if (a.fold_all(0, add) != 66) {
    return test.fail("sum");
  }
  let digits = a.slice(0, 0, 1).slice(1, 1, 4);
  if (digits.transpose().fold_all(0, (acc: i32, x: i32): i32 => acc * 10 + x) != 123) {
    return test.fail("strided fold order");
  }
  let packed = ndarray.from_flat([1, 2, 3, 4], [2, 2]);
  return test.assert_eq(packed.fold_all(0, (acc: i32, x: i32): i32 => acc * 10 + x), 1234);
}

function test_checked_products(): test.TestOutcome {
  let a = grid();
  let mul = (x: i32, y: i32): i32 => x * y;
  let add = (x: i32, y: i32): i32 => x + y;
  let wide = ndarray.from_flat([1], [1]).broadcast_to([50000]);
  let empty = ndarray.from_flat([] as i32[], [50000, 0]);
  if (wide.try_outer(wide, unexpected_element).is_some() || empty.try_inner(empty.transpose(), 0, mul, add).is_some()) {
    return test.fail("overflowing product shapes");
  }
  if (a.try_inner(a, 0, mul, add).is_some() || a.try_inner(ndarray.from_flat([1], []), 0, mul, add).is_some()) {
    return test.fail("incompatible contraction");
  }
  let inner = a.try_inner(a.transpose(), 1, mul, add).unwrap_or(a);
  let outer = a.try_outer(ndarray.from_flat([2], []), mul).unwrap_or(a);
  return test.assert_true(inner.get_unchecked([0, 1]) == 39 && outer.get_unchecked([2, 3]) == 22);
}

function test_checked_cell_map(): test.TestOutcome {
  let a = grid();
  let id = (cell: ndarray.NdArray[i32]): ndarray.NdArray[i32] => cell;
  if (a.try_map_rank(3, id).is_some() || a.try_map_rank(-1, id).is_some()) {
    return test.fail("invalid cell rank");
  }
  let ragged = a.try_map_rank(1, (row: ndarray.NdArray[i32]): ndarray.NdArray[i32] => row.slice(0, 0, row.get_unchecked([0]) % 3));
  if (ragged.is_some()) {
    return test.fail("inconsistent mapped cell shapes");
  }
  let large = ndarray.from_flat([1], [1]).broadcast_to([2147483647]);
  if (a.try_map_rank(1, (row: ndarray.NdArray[i32]): ndarray.NdArray[i32] => large).is_some()) {
    return test.fail("overflowing result shape");
  }
  let empty = ndarray.from_flat([] as i32[], [0, 50000, 50000]).try_map_rank(2, id).unwrap_or(a);
  return test.assert_true(empty.rank() == 1 && empty.len() == 0);
}

function test_checked_axis_folds(): test.TestOutcome {
  let a = grid().transpose();
  let add = (x: i32, y: i32): i32 => x + y;
  if (a.try_scan_axis(-1, 0, add).is_some() || a.try_reduce_axis(2, 0, add).is_some()) {
    return test.fail("axis outside the rank");
  }
  let reduced = a.try_reduce_axis(1, 2, add).unwrap_or(a);
  let scanned = a.try_scan_axis(1, 2, add).unwrap_or(a);
  if (reduced.rank() != 1 || reduced.get_unchecked([2]) != 20 || scanned.get_unchecked([2, 1]) != 10) {
    return test.fail("strided reduction or scan");
  }
  let empty = ndarray.from_flat([] as i32[], [50000, 0, 50000]);
  if (empty.try_reduce_axis(1, 0, unexpected_element).is_some() || empty.try_scan_axis(1, 0, unexpected_element).is_none()) {
    return test.fail("empty scan or overflowing reduction");
  }
  let rows = ndarray.from_flat([] as i32[], [3, 0]).try_reduce_axis(1, 7, unexpected_element).unwrap_or(a);
  return test.assert_true(rows.len() == 3 && rows.get_unchecked([2]) == 7);
}

function test_reduce_axis_drops_the_axis(): test.TestOutcome {
  let a = grid();
  let rows = a.reduce_axis(1, 0, add);
  if (rows.rank() != 1 || rows.shape()[0] != 3 || rows.get_unchecked([2]) != 38) {
    return test.fail("along axis 1");
  }
  let cols = a.reduce_axis(0, 0, add);
  if (cols.shape()[0] != 4 || cols.get_unchecked([1]) != 15) {
    return test.fail("along axis 0");
  }
  let ordered: ndarray.NdArray[i32] = a.transpose().reduce_axis(0, 0, (acc: i32, x: i32): i32 => acc * 100 + x);
  if (ordered.get_unchecked([1]) != 4050607) {
    return test.fail("order along the axis");
  }
  let backwards: ndarray.NdArray[i32] = a.reverse(1).reduce_axis(1, 0, (acc: i32, x: i32): i32 => acc * 10 + x);
  if (backwards.get_unchecked([0]) != 3210) {
    return test.fail("order along a reversed axis");
  }
  let one = rows.reduce_axis(0, 0, add);
  return test.assert_true(one.rank() == 0 && one.get_unchecked([]) == 66);
}

function test_scan_axis_keeps_the_axis(): test.TestOutcome {
  let a = grid();
  let s = a.scan_axis(1, 0, add);
  if (s.shape()[0] != 3 || s.shape()[1] != 4 || !s.is_packed()) {
    return test.fail("shape");
  }
  if (s.get_unchecked([1, 0]) != 4 || s.get_unchecked([1, 3]) != 22) {
    return test.fail("prefix along axis 1");
  }
  let s0 = a.transpose().scan_axis(0, 0, add);
  if (s0.get_unchecked([3, 2]) != 38) {
    return test.fail("prefix along axis 0 of a transpose");
  }
  let sr: ndarray.NdArray[i32] = a.reverse(1).scan_axis(1, 0, (acc: i32, x: i32): i32 => acc * 10 + x);
  return test.assert_eq(sr.get_unchecked([0, 2]), 321);
}

function test_broadcast_to_is_a_view(): test.TestOutcome {
  let row = ndarray.from_flat(build(4), [4]);
  let wide = row.broadcast_to([3, 4]);
  if (wide.rank() != 2 || wide.strides()[0] != 0 || wide.strides()[1] != 1) {
    return test.fail("stretched axis");
  }
  if (wide.get_unchecked([0, 3]) != 3 || wide.get_unchecked([2, 3]) != 3 || wide.get_unchecked([2, 0]) != 0) {
    return test.fail("reads");
  }
  if (wide.is_row_major() || wide.is_packed()) {
    return test.fail("a stretched handle is not row-major");
  }
  let lifted = row.broadcast_to([1, 4]);
  if (!lifted.is_packed()) {
    return test.fail("a prepended axis keeps a handle packed");
  }
  if (lifted.fold_all(0, (acc: i32, x: i32): i32 => acc * 10 + x) != 123) {
    return test.fail("prepended-axis fold order");
  }
  let lm: i32[] = lifted.map((x: i32): i32 => x + 1).to_flat();
  if (lm.len() != 4 || lm[0] != 1 || lm[3] != 4) {
    return test.fail("prepended-axis map order");
  }
  let f = wide.to_flat();
  if (f.len() != 12 || f[4] != 0 || f[11] != 3) {
    return test.fail("to_flat");
  }
  if (wide.transpose().get_unchecked([3, 1]) != 3) {
    return test.fail("transpose of a broadcast");
  }
  let bs = ndarray.broadcast_shape([3, 1], [1, 4]);
  if (bs.len() != 2 || bs[0] != 3 || bs[1] != 4) {
    return test.fail("broadcast_shape");
  }
  return test.assert_eq(wide.reduce_axis(0, 0, add).get_unchecked([3]), 9);
}

function test_zip_with_broadcasts(): test.TestOutcome {
  let a = grid();
  let row = ndarray.from_flat(build(4), [4]);
  let col = ndarray.from_flat(build(3), [3, 1]);
  let scalar = ndarray.from_flat([10], []);
  let minus_row: ndarray.NdArray[i32] = a.zip_with(row, (x: i32, y: i32): i32 => x - y);
  if (minus_row.shape()[0] != 3 || minus_row.get_unchecked([2, 3]) != 8 || minus_row.get_unchecked([1, 0]) != 4) {
    return test.fail("row");
  }
  let minus_col: ndarray.NdArray[i32] = a.zip_with(col, (x: i32, y: i32): i32 => x - 4 * y);
  if (minus_col.get_unchecked([2, 3]) != 3 || minus_col.get_unchecked([1, 1]) != 1) {
    return test.fail("column");
  }
  let scaled: ndarray.NdArray[i32] = scalar.zip_with(a, (x: i32, y: i32): i32 => x * y);
  if (scaled.rank() != 2 || scaled.get_unchecked([2, 3]) != 110) {
    return test.fail("scalar");
  }
  let outer: ndarray.NdArray[i32] = col.zip_with(row, (x: i32, y: i32): i32 => x * y);
  if (outer.shape()[0] != 3 || outer.shape()[1] != 4) {
    return test.fail("outer shape");
  }
  return test.assert_eq(outer.get_unchecked([2, 3]), 6);
}

function mul(x: i32, y: i32): i32 {
  return x * y;
}

function test_outer_pairs_every_element(): test.TestOutcome {
  let v = ndarray.from_flat(build(3), [3]);
  let w = ndarray.from_flat(build(4), [4]);
  let o = v.outer(w, mul);
  if (o.rank() != 2 || o.shape()[0] != 3 || o.shape()[1] != 4 || !o.is_packed()) {
    return test.fail("shape");
  }
  if (o.get_unchecked([2, 3]) != 6 || o.get_unchecked([1, 2]) != 2 || o.get_unchecked([0, 3]) != 0) {
    return test.fail("pairs");
  }
  let o3 = grid().outer(v, add);
  if (o3.rank() != 3 || o3.shape()[2] != 3 || o3.get_unchecked([1, 2, 1]) != 7) {
    return test.fail("rank 2 by rank 1");
  }
  return test.assert_eq(v.outer(v, (x: i32, y: i32): i32 => x - y).get_unchecked([0, 2]), -2);
}

function test_inner_contracts_last_against_first(): test.TestOutcome {
  let a = grid();
  let v = ndarray.from_flat(build(4), [4]);
  let dot = v.inner(v, 0, mul, add);
  if (dot.rank() != 0 || dot.get_unchecked([]) != 14) {
    return test.fail("dot product");
  }
  let rows = a.inner(ndarray.from_flat([1, 1, 1, 1], [4]), 0, mul, add);
  if (rows.rank() != 1 || rows.shape()[0] != 3 || rows.get_unchecked([2]) != 38) {
    return test.fail("matrix times vector");
  }
  let mm = a.inner(a.transpose(), 0, mul, add);
  if (mm.rank() != 2 || mm.shape()[0] != 3 || mm.shape()[1] != 3 || mm.get_unchecked([1, 2]) != 214 || mm.get_unchecked([2, 1]) != 214) {
    return test.fail("matrix product");
  }
  let ordered: ndarray.NdArray[i32] = v.inner(v.reverse(0), 0, add, (acc: i32, p: i32): i32 => acc * 10 + p);
  return test.assert_eq(ordered.get_unchecked([]), 3333);
}

function test_map_rank_maps_every_cell(): test.TestOutcome {
  let a = ndarray.from_flat([1, 2, 3, 4, 5, 6], [2, 3]);
  let sums = a.map_rank(1, sum_cell);
  let reduced = a.reduce_axis(1, 0, add);
  if (sums.rank() != 1 || sums.shape()[0] != 2) {
    return test.fail("map_rank frame shape");
  }
  if (sums.get_unchecked([0]) != reduced.get_unchecked([0]) || sums.get_unchecked([1]) != reduced.get_unchecked([1])) {
    return test.fail("map_rank agrees with reduce_axis");
  }
  let pairs = a.map_rank(1, first_two);
  if (pairs.rank() != 2 || pairs.shape()[1] != 2 || pairs.get_unchecked([1, 0]) != 4) {
    return test.fail("map_rank cell result shape");
  }
  let whole = a.map_rank(2, sum_cell);
  if (whole.rank() != 0 || whole.get_unchecked([]) != 21) {
    return test.fail("map_rank at k == rank");
  }
  let each = a.map_rank(0, triple);
  if (each.rank() != 2 || each.get_unchecked([1, 2]) != 18) {
    return test.fail("map_rank at k == 0");
  }
  let rfr = a.reverse(0);
  let rvr = rfr.map_rank(1, first_one);
  if (rvr.get_unchecked([0]) != 4 || rvr.get_unchecked([1]) != 1) {
    return test.fail("map_rank walks cells in index order");
  }
  let none = ndarray.from_flat([] as i32[], [0, 3]).map_rank(1, first_one);
  return test.assert_eq(none.rank() * 100 + none.shape()[0] * 10 + none.len(), 100);
}

function sum_cell(c: ndarray.NdArray[i32]): ndarray.NdArray[i32] {
  return ndarray.from_flat([c.fold_all(0, add)], []);
}

function first_two(c: ndarray.NdArray[i32]): ndarray.NdArray[i32] {
  return ndarray.from_flat([c.get_unchecked([0]), c.get_unchecked([1])], [2]);
}

function first_one(c: ndarray.NdArray[i32]): ndarray.NdArray[i32] {
  return ndarray.from_flat([c.get_unchecked([0])], []);
}

function triple(c: ndarray.NdArray[i32]): ndarray.NdArray[i32] {
  return ndarray.from_flat([c.get_unchecked([]) * 3], []);
}

function main(): i32 {
  let r = test.new("std/ndarray");
  r = r.it("from_flat indexes row-major", test_from_flat_indexes_row_major);
  r = r.it("get is None out of range", test_get_is_none_out_of_range);
  r = r.it("checked construction and reshape", test_checked_shapes);
  r = r.it("checked broadcast shape and zip", test_checked_broadcast_shape_and_zip);
  r = r.it("checked axis views", test_checked_axis_views);
  r = r.it("transpose swaps indices", test_transpose_swaps_indices);
  r = r.it("permute is the general transpose", test_permute_is_the_general_transpose);
  r = r.it("reverse flips one axis", test_reverse_flips_one_axis);
  r = r.it("slice and select are partial views", test_slice_and_select_are_partial_views);
  r = r.it("reshape keeps reading order", test_reshape_keeps_reading_order);
  r = r.it("to_flat and packed", test_to_flat_and_packed);
  r = r.it("rank zero and empty", test_rank_zero_and_empty);
  r = r.it("map and zip_with are elementwise", test_map_and_zip_with_are_elementwise);
  r = r.it("fold_all reads in order", test_fold_all_reads_in_order);
  r = r.it("checked products", test_checked_products);
  r = r.it("checked cell mapping", test_checked_cell_map);
  r = r.it("checked axis folds", test_checked_axis_folds);
  r = r.it("reduce_axis drops the axis", test_reduce_axis_drops_the_axis);
  r = r.it("scan_axis keeps the axis", test_scan_axis_keeps_the_axis);
  r = r.it("broadcast_to is a view", test_broadcast_to_is_a_view);
  r = r.it("zip_with broadcasts", test_zip_with_broadcasts);
  r = r.it("outer pairs every element", test_outer_pairs_every_element);
  r = r.it("inner contracts last against first", test_inner_contracts_last_against_first);
  r = r.it("map_rank maps every rank-k cell", test_map_rank_maps_every_cell);
  r.finish();
  return 0;
}
