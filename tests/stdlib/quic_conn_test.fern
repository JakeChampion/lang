import "std/test";
import "std/quic/conn";
import "std/quic/streams";
import "std/quic/packet";
import "std/quic/frames";
import "std/quic/recovery";
import "std/tls/keyschedule";
import "std/array";
import "std/result";
import "std/tls/identity";
import "std/tls/verify";
import "std/hex";
import "std/codec";
import "std/i64";
import "std/option";
import "std/time";

const ROOT: string = "";

const ED_LEAF: string = "";

const ED_PKCS8: string = "-----BEGIN PRIVATE KEY-----\n"
  + "MC4CAQAwBQYDK2VwBCIEICIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIi\n"
  + "-----END PRIVATE KEY-----\n";

const MS: i64 = 1000000;

const START: Instant = Instant { sec: 0, nsec: 0 };

function at_ns(ns: i64): Instant {
  return START.add(time.duration_nanos(ns));
}

function due_ns(at: Option[Instant]): i64 {
  match (at) {
    Some(i) => {
      return i.since(START).as_nanos();
    },
    None => {
      return 0;
    }
  }
}

const WALL_MS: i64 = 1700000000000;

const NOT_BEFORE_MS: i64 = 1577836800000;

const NOT_AFTER_MS: i64 = 4102444800000;

function server_config(alpn: string[]): conn.Config {
  match (identity.private_key_from_pem(ED_PKCS8)) {
    Ok(k) => {
      match (identity.pair([__codec_bytes(hex.decode(ED_LEAF))], k)) {
        Ok(id) => {
          return conn.config(alpn).server_side(id);
        },
        Err(_) => {}
      }
    },
    Err(_) => {}
  }
  return conn.config(alpn);
}

function client_config(name: string, alpn: string[]): conn.Config {
  return conn.config(alpn).client_side(name, verify.roots([__codec_bytes(hex.decode(ROOT))]));
}

function entropy(seed: i32, n: i32): u8[] {
  let out: u8[] = [];
  let i = 0;
  while (i < n) {
    out = out.append((seed + i * 7 & 255) as u8);
    i += 1;
  }
  return out;
}

struct Pair { client: conn.Conn, server: Option[conn.Conn], now: i64, log: string, drop_server: i32, server_cfg: conn.Config, client_sent: i32, server_sent: i32, lose_every: i32, carried: i32, reorder: boolean, client_path: u8[], drop_client: i32, retry_key: u8[], path_ecn: i32, mark_in: i32 }

function start(cc: conn.Config, sc: conn.Config): Result[Pair, string] {
  return start_at(cc, sc, WALL_MS);
}

function start_at(cc: conn.Config, sc: conn.Config, unix_ms: i64): Result[Pair, string] {
  let c = conn.client(cc, entropy(1, conn.client_entropy(cc)), START, time.timestamp_from_unix_millis(unix_ms))?;
  return Ok(Pair { client: c, server: None, now: 0 as i64, log: "", drop_server: 0, server_cfg: sc, client_sent: 0, server_sent: 0, lose_every: 0, carried: 0, reorder: false, client_path: [1u8], drop_client: 0, retry_key: [], path_ecn: 0, mark_in: 0 });
}

function noted(who: string, c: conn.Conn): string {
  let out = "";
  for e in c.events {
    match (e) {
      conn.Connected => {
        out = out + who + " connected; ";
      },
      conn.Closed(why) => {
        let side = "local";
        if (why.remote) {
          side = "remote";
        }
        out = out + who + " closed " + side + " " + why.code.to_string() + " " + why.reason + "; ";
      }
    }
  }
  for n in c.stream_events() {
    match (n) {
      streams.Opened(id) => {
        out = out + who + " opened " + id.to_string() + "; ";
      },
      streams.Readable(_) => {},
      streams.ResetByPeer(id, code) => {
        out = out + who + " reset " + id.to_string() + " " + code.to_string() + "; ";
      },
      streams.StopRequested(id, code) => {
        out = out + who + " stopped " + id.to_string() + " " + code.to_string() + "; ";
      }
    }
  }
  return out;
}

function to_server(p: Pair, d: u8[]): Pair {
  match (p.server) {
    Some(s) => {
      let step = s.receive_from(d, p.client_path, p.mark_in, at_ns(p.now));
      return Pair { ...p, server: Some(step.events_taken()), log: p.log + noted("server", step) };
    },
    None => {
      match (packet.parse(d, 0, 8)) {
        Ok(h) => {
          return first_initial(p, h, d);
        },
        Err(e) => {
          return Pair { ...p, log: p.log + "parse: " + e.message() + "; " };
        }
      }
    }
  }
}

// first_initial opens the server for the client's first Initial. With a
// retry_key the server answers an Initial without a token with a Retry,
// and refuses a token it did not issue.
function first_initial(p: Pair, h: packet.Header, d: u8[]): Pair {
  let odcid = h.dcid;
  if (p.retry_key.len() > 0 && h.token.len() == 0) {
    let r = conn.retry(p.server_cfg, p.retry_key, entropy(3, conn.retry_entropy(p.server_cfg)), h, p.client_path, wall_at(p));
    return to_client(Pair { ...p, log: p.log + "server retried; " }, r);
  }
  if (h.token.len() > 0) {
    let Some(o) = conn.validated(p.retry_key, h, p.client_path, wall_at(p)) else {
      return to_client(Pair { ...p, log: p.log + "server refused the token; " }, conn.invalid_token(h));
    };
    odcid = o;
  }
  match (accepted(p, h, odcid)) {
    Ok(s) => {
      return to_server(Pair { ...p, server: Some(s) }, d);
    },
    Err(e) => {
      return Pair { ...p, log: p.log + "accept: " + e + "; " };
    }
  }
}

function accepted(p: Pair, h: packet.Header, odcid: u8[]): Result[conn.Conn, string] {
  let e = entropy(2, conn.server_entropy(p.server_cfg));
  if (h.token.len() > 0) {
    return conn.accept_validated(p.server_cfg, e, h, odcid, at_ns(p.now), wall_at(p));
  }
  return conn.accept(p.server_cfg, e, h, at_ns(p.now), wall_at(p));
}

function wall_at(p: Pair): time.Timestamp {
  return time.timestamp_from_unix_millis(WALL_MS + p.now / MS);
}

// SERVER_PATH is the server's address as the client sees it.
const SERVER_PATH: u8 = 1u8;

function to_client(p: Pair, d: u8[]): Pair {
  let step = p.client.receive_from(d, [SERVER_PATH], p.mark_in, at_ns(p.now));
  return Pair { ...p, client: step.events_taken(), log: p.log + noted("client", step) };
}

function exchange(p: Pair): (Pair, boolean) {
  let c = p.client.transmit(at_ns(p.now));
  let out = c.datagrams();
  let cur = Pair { ...p, client: c.sent(), client_sent: p.client_sent + out.len(), mark_in: on_path(p, c.ecn_codepoint()) };
  for d in in_order(cur, out) {
    let (next, lost) = carried(cur);
    cur = next;
    if (cur.drop_client > 0) {
      cur = Pair { ...cur, drop_client: cur.drop_client - 1 };
    } else if (!lost) {
      cur = to_server(cur, d);
    }
  }
  let moved = out.len() > 0;
  match (cur.server) {
    Some(s) => {
      let s2 = s.transmit(at_ns(cur.now));
      let sout = s2.datagrams();
      cur = Pair { ...cur, server: Some(s2.sent()), server_sent: cur.server_sent + sout.len(), mark_in: on_path(cur, s2.ecn_codepoint()) };
      for d in in_order(cur, sout) {
        let (next, lost) = carried(cur);
        cur = next;
        if (cur.drop_server > 0) {
          cur = Pair { ...cur, drop_server: cur.drop_server - 1 };
        } else if (!lost) {
          cur = to_client(cur, d);
        }
      }
      moved = moved || sout.len() > 0;
    },
    None => {}
  }
  return (cur, moved);
}

// on_path is the mark a datagram sent with `mark` arrives with: path_ecn 0
// carries it, 1 clears it, as a bleaching middlebox does, and 2 turns
// ECT(0) into ECN-CE, as a congested router does.
function on_path(p: Pair, mark: i32): i32 {
  if (p.path_ecn == 1) {
    return 0;
  }
  if (p.path_ecn == 2 && mark == 2) {
    return 3;
  }
  return mark;
}

function carried(p: Pair): (Pair, boolean) {
  let n = p.carried + 1;
  return (Pair { ...p, carried: n }, p.lose_every > 0 && n % p.lose_every == 0);
}

function in_order(p: Pair, out: u8[][]): u8[][] {
  if (!p.reorder) {
    return out;
  }
  let back: u8[][] = [];
  let i = out.len() - 1;
  while (i >= 0) {
    back = back.append(out[i]);
    i -= 1;
  }
  return back;
}

function settle(p: Pair, rounds: i32, until: i64): Pair {
  let cur = p;
  let i = 0;
  while (i < rounds) {
    let (next, moved) = exchange(cur);
    cur = next;
    if (!moved) {
      cur = tick(cur, until);
    }
    i += 1;
  }
  return cur;
}

function tick(p: Pair, until: i64): Pair {
  let due = due_ns(p.client.deadline());
  match (p.server) {
    Some(s) => {
      let d = due_ns(s.deadline());
      if (d != 0 && (due == 0 || d < due)) {
        due = d;
      }
    },
    None => {}
  }
  if (due == 0 || due > until) {
    return p;
  }
  let now = due;
  if (now < p.now) {
    now = p.now;
  }
  let cs = p.client.tick(at_ns(now));
  let cur = Pair { ...p, now: now, client: cs.events_taken(), log: p.log + noted("client", cs) };
  match (cur.server) {
    Some(s) => {
      let ss = s.tick(at_ns(now));
      return Pair { ...cur, server: Some(ss.events_taken()), log: cur.log + noted("server", ss) };
    },
    None => {
      return cur;
    }
  }
}

function server_of(p: Pair): conn.Conn {
  match (p.server) {
    Some(s) => {
      return s;
    },
    None => {
      return p.client;
    }
  }
}

function test_handshake(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      let s = server_of(p);
      let idle = "-";
      if let Some(pp) = p.client.peer_params() {
        idle = pp.max_idle_timeout.to_string();
      }
      return test.assert_eq(p.log + "| " + p.client.connected().to_string() + " " + s.connected().to_string() + " " + p.client.alpn() + " " + s.alpn() + " idle " + idle, "client connected; server connected; | true true h3 h3 idle 30000");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

// A server with a ticket key issues a session ticket once the handshake is
// done. A client that offers it a minute later resumes, and both ends
// report it. A server with another secret, and a ticket past its lifetime,
// each give a full handshake instead.
function test_resumption(): test.TestOutcome {
  let sc = server_config(["h3"]).with_tickets([7u8, 7u8, 7u8]);
  let Ok(p0) = start(client_config("tls.example", ["h3"]), sc) else {
    return test.fail("the first handshake did not start");
  };
  let first = settle(p0, 12, 10000 * MS);
  let tickets = first.client.tickets();
  if (tickets.len() == 0) {
    return test.fail("no ticket: " + first.log);
  }
  let cc = client_config("tls.example", ["h3"]).with_ticket(tickets[0]);
  let line = "first " + first.client.connected().to_string() + " " + first.client.resumed().to_string() + " " + tickets.len().to_string();
  let cases: (conn.Config, i64, string)[] = [(sc, 60000 as i64, "same"), (server_config(["h3"]).with_tickets([8u8]), 60000 as i64, "other"), (sc, 7300000 as i64, "expired")];
  for (scfg, later, name) in cases {
    let Ok(q0) = start_at(cc, scfg, WALL_MS + later) else {
      return test.fail(name + ": did not start");
    };
    let q = settle(q0, 12, 10000 * MS);
    line = line + "; " + name + " " + q.client.connected().to_string() + " " + q.client.resumed().to_string() + " " + server_of(q).resumed().to_string();
  }
  return test.assert_eq(line, "first true false 1; same true true true; other true false false; expired true false false");
}

// Over a path that carries the marks, both ends keep marking ECT(0) through
// the handshake. Over a path that clears them, the peer's ACKs bring no
// counts for marked packets, and both ends stop marking. Over a congested
// path the counts arrive as ECN-CE: validation holds, and the window
// shrinks as it does for a loss.
function test_ecn(): test.TestOutcome {
  let lines = "";
  for mode in 0..3 {
    let Ok(p0) = start(client_config("tls.example", ["h3"]).with_ecn(), server_config(["h3"]).with_ecn()) else {
      return test.fail("start failed");
    };
    let p = settle(Pair { ...p0, path_ecn: mode }, 12, 10000 * MS);
    let s = server_of(p);
    lines = lines + p.client.connected().to_string() + " " + p.client.ecn_codepoint().to_string() + " " + s.ecn_codepoint().to_string() + " " + (p.client.recovery.window() < 12000i64).to_string() + "; ";
  }
  let Ok(q0) = start(client_config("tls.example", ["h3"]), server_config(["h3"])) else {
    return test.fail("start failed");
  };
  let q = settle(q0, 12, 10000 * MS);
  lines = lines + q.client.ecn_codepoint().to_string() + " " + server_of(q).ecn_codepoint().to_string();
  return test.assert_eq(lines, "true 2 2 false; true 0 0 false; true 2 2 true; 0 0");
}

function test_amplification(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let c = p0.client.transmit(at_ns(0 as i64));
      let out = c.datagrams();
      c = c.sent();
      let p = to_server(Pair { ...p0, client: c }, out[0]);
      let s = server_of(p);
      let s2 = s.transmit(at_ns(0 as i64));
      let sout = s2.datagrams();
      s2 = s2.sent();
      let total = 0;
      for d in sout {
        total += d.len();
      }
      return test.assert_eq(out[0].len().to_string() + " in, at most " + (total <= 3 * out[0].len()).to_string(), "1200 in, at most true");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_lost_datagram(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let p = settle(Pair { ...p0, drop_server: 1 }, 20, 10000 * MS);
      return test.assert_eq(p.log + "| resent at " + (p.now / MS).to_string() + "ms", "client connected; server connected; | resent at 1ms");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_lost_flight(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let p = settle(Pair { ...p0, drop_server: 2 }, 30, 10000 * MS);
      return test.assert_eq(p.log + "| after a probe " + (p.now >= 999 * MS).to_string(), "client connected; server connected; | after a probe true");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_untrusted(): test.TestOutcome {
  match (start(client_config("other.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      return test.assert_eq(p.log, "client closed local 298 tls handshake: the peer's certificate was refused; server closed remote 298 tls handshake: the peer's certificate was refused; ");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function verdict_at(unix_ms: i64): string {
  match (start_at(client_config("tls.example", ["h3"]), server_config(["h3"]), unix_ms)) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      return p.client.connected().to_string();
    },
    Err(e) => {
      return e;
    }
  }
}

function test_validity_window(): test.TestOutcome {
  let got = verdict_at(NOT_BEFORE_MS - 1000) + " " + verdict_at(NOT_BEFORE_MS + 1000) + " " + verdict_at(NOT_AFTER_MS - 1000) + " " + verdict_at(NOT_AFTER_MS + 1000);
  return test.assert_eq(got, "false true true false");
}

function test_expired(): test.TestOutcome {
  match (start_at(client_config("tls.example", ["h3"]), server_config(["h3"]), NOT_AFTER_MS + 1000)) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      return test.assert_eq(p.log, "client closed local 298 tls handshake: the peer's certificate was refused; server closed remote 298 tls handshake: the peer's certificate was refused; ");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_no_protocol(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["hq-interop"]))) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      return test.assert_eq(p.log, "server closed local 376 tls handshake: no application protocol in common; client closed remote 376 tls handshake: no application protocol in common; ");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_close(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      p = Pair { ...p, client: p.client.close(256 as i64, "bye", true, at_ns(p.now)), log: "" };
      p = settle(p, 12, 20000 * MS);
      return test.assert_eq(p.log + "| " + p.client.done().to_string() + " " + server_of(p).done().to_string(), "server closed remote 256 bye; client closed local 256 bye; | true true");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_retry(): test.TestOutcome {
  let cc = client_config("tls.example", ["h3"]);
  match (start(cc, server_config(["h3"]))) {
    Ok(p0) => {
      let c = p0.client.transmit(at_ns(0 as i64));
      let out = c.datagrams();
      c = c.sent();
      let first = header_of(out[0]);
      let r = packet.retry(first.scid, __codec_bytes(hex.decode("0102030405060708")), first.dcid, "fern-token".bytes());
      let bad = packet.retry(first.scid, __codec_bytes(hex.decode("0a0b0c0d0e0f0001")), __codec_bytes(hex.decode("00")), "nope".bytes());
      let c2 = c.receive(bad, at_ns(0 as i64)).receive(r, at_ns(0 as i64));
      let c3 = c2.tick(at_ns(1000 * MS)).transmit(at_ns(1000 * MS));
      let out2 = c3.datagrams();
      c3 = c3.sent();
      let again = header_of(out2[0]);
      let opened = "no";
      match (packet.open(out2[0], again, packet.initial_keys(again.dcid, true), -1i64)) {
        Ok(o) => {
          opened = "pn " + o.pn.to_string();
        },
        Err(e) => {
          opened = e.message();
        }
      }
      return test.assert_eq(hex.encode(again.dcid) + " " + unsafe { string_from_bytes_unchecked(again.token) } + " " + opened, "0102030405060708 fern-token pn 2");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

// The client's first flight is two Initial datagrams (its key shares do not
// fit one), and a server that keeps no state answers each with a Retry; the
// client follows the first and ignores the second.
function test_server_retry(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let p = settle(Pair { ...p0, retry_key: entropy(9, 32) }, 12, 10000 * MS);
      let s = server_of(p);
      let odcid = "-";
      if let Some(pp) = p.client.peer_params() {
        if let Some(o) = pp.original_destination_connection_id {
          odcid = hex.encode(o);
        }
      }
      return test.assert_eq(p.log + "| " + p.client.connected().to_string() + " " + s.connected().to_string() + " retried " + p.client.retried().to_string() + " " + s.retried().to_string() + " odcid " + (odcid == hex.encode(p.client.odcid)).to_string() + " dcid " + hex.encode(p.client.dcid) + " " + hex.encode(s.scid), "server retried; server retried; client connected; server connected; | true true retried true true odcid true dcid " + hex.encode(s.scid) + " " + hex.encode(s.scid));
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_retry_token_checks(): test.TestOutcome {
  let cc = client_config("tls.example", ["h3"]);
  let sc = server_config(["h3"]);
  match (start(cc, sc)) {
    Ok(p0) => {
      let c = p0.client.transmit(at_ns(0 as i64));
      let first = header_of(c.datagrams()[0]);
      let key = entropy(9, 32);
      let at = time.timestamp_from_unix_millis(WALL_MS);
      let r = header_of(conn.retry(sc, key, entropy(3, conn.retry_entropy(sc)), first, [1u8], at));
      let kind = "other";
      match (r.kind) {
        packet.Retry => {
          kind = "retry";
        },
        _ => {}
      }
      let next = packet.Header { ...first, dcid: r.scid, token: r.token };
      let out = kind + " scid differs " + (hex.encode(r.scid) != hex.encode(first.dcid)).to_string() + " dcid kept " + (hex.encode(r.dcid) == hex.encode(first.scid)).to_string();
      out = out + " | same " + odcid_of(conn.validated(key, next, [1u8], at), first.dcid);
      out = out + " path " + odcid_of(conn.validated(key, next, [2u8], at), first.dcid);
      out = out + " key " + odcid_of(conn.validated(entropy(10, 32), next, [1u8], at), first.dcid);
      out = out + " dcid " + odcid_of(conn.validated(key, packet.Header { ...next, dcid: first.dcid }, [1u8], at), first.dcid);
      out = out + " tampered " + odcid_of(conn.validated(key, packet.Header { ...next, token: r.token.with(12, (r.token[12] as i32 ^ 1) as u8) }, [1u8], at), first.dcid);
      out = out + " short " + odcid_of(conn.validated(key, packet.Header { ...next, token: __bytes_owned(r.token[0:r.token.len() - 1]) }, [1u8], at), first.dcid);
      out = out + " empty " + odcid_of(conn.validated(key, first, [1u8], at), first.dcid);
      out = out + " 10s " + odcid_of(conn.validated(key, next, [1u8], time.timestamp_from_unix_millis(WALL_MS + 10000 as i64)), first.dcid);
      out = out + " 10.001s " + odcid_of(conn.validated(key, next, [1u8], time.timestamp_from_unix_millis(WALL_MS + 10001 as i64)), first.dcid);
      out = out + " early " + odcid_of(conn.validated(key, next, [1u8], time.timestamp_from_unix_millis(WALL_MS - 1 as i64)), first.dcid);
      return test.assert_eq(out, "retry scid differs true dcid kept true | same odcid path none key none dcid none tampered none short none empty none 10s odcid 10.001s none early none");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function odcid_of(v: Option[u8[]], want: u8[]): string {
  match (v) {
    Some(o) => {
      if (hex.encode(o) == hex.encode(want)) {
        return "odcid";
      }
      return "other";
    },
    None => {
      return "none";
    }
  }
}

function test_invalid_token_closes(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let c = p0.client.transmit(at_ns(0 as i64));
      let first = header_of(c.datagrams()[0]);
      c = c.sent();
      let forged = packet.retry(first.scid, __codec_bytes(hex.decode("0102030405060708")), first.dcid, "nope".bytes());
      let p = Pair { ...p0, client: c.receive(forged, at_ns(0 as i64)), retry_key: entropy(9, 32) };
      p = settle(p, 3, 1000 * MS);
      return test.assert_eq(p.log + "| " + p.server.is_some().to_string(), "server refused the token; client closed remote 11 the token is not one this server issued; server refused the token; | false");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_retry_naming_own_dcid_ignored(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let c = p0.client.transmit(at_ns(0 as i64));
      let first = header_of(c.datagrams()[0]);
      c = c.sent();
      let same = packet.retry(first.scid, first.dcid, first.dcid, "fern-token".bytes());
      let c2 = c.receive(same, at_ns(0 as i64));
      return test.assert_eq(c2.retried().to_string() + " " + hex.encode(c2.dcid), "false " + hex.encode(first.dcid));
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function header_of(d: u8[]): packet.Header {
  match (packet.parse(d, 0, 8)) {
    Ok(h) => {
      return h;
    },
    Err(_) => {
      return packet.Header { kind: packet.UnknownVersion, version: 0 as i64, dcid: [], scid: [], token: [], tag: [], versions: [], at: 0, pn_at: 0, end: 0 };
    }
  }
}

function test_idle(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      p = Pair { ...p, log: "" };
      p = settle(p, 20, 100000 * MS);
      return test.assert_eq(p.log + "| " + (p.now >= 30000 * MS).to_string(), "client closed local 0 idle timeout; server closed local 0 idle timeout; | true");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

struct Echo { p: Pair, size: i32, got: u8[], fin: boolean, server_done: boolean }

function echo_round(e: Echo, until: i64): Echo {
  let cur = e;
  if let Ok(c) = cur.p.client.read(0 as i64) {
    cur = Echo { ...cur, p: Pair { ...cur.p, client: c.0 }, got: cur.got.concat(c.1), fin: cur.fin || c.2 };
  }
  if let Some(s) = cur.p.server {
    cur = echoed(cur, s);
  }
  let (next, moved) = exchange(cur.p);
  if (!moved) {
    next = tick(next, until);
  }
  return Echo { ...cur, p: next };
}

function echoed(e: Echo, s: conn.Conn): Echo {
  if (e.server_done) {
    return e;
  }
  let r = s.read_into(0 as i64);
  if (r.refused() != "") {
    return e;
  }
  let data = r.read_data();
  let fin = r.read_fin();
  let w = r.read_taken().written(0 as i64, data, fin);
  if (w.refused() != "") {
    return e;
  }
  return Echo { ...e, p: Pair { ...e.p, server: Some(w) }, server_done: fin };
}

function streamed(p0: Pair, size: i32, rounds: i32): Result[Echo, string] {
  let p = settle(p0, 12, 10000 * MS);
  let (c, id) = p.client.open_stream(false)?;
  let w = c.write(id, entropy(5, size), true)?;
  let e = Echo { p: Pair { ...p, client: w }, size: size, got: [], fin: false, server_done: false };
  let i = 0;
  while (i < rounds && !e.fin) {
    e = echo_round(e, e.p.now + 60000 * MS);
    i += 1;
  }
  return Ok(e);
}

function echo_report(r: Result[Echo, string]): string {
  match (r) {
    Ok(e) => {
      let same = e.got.len() == e.size;
      let want = entropy(5, e.size);
      let i = 0;
      while (same && i < e.size) {
        same = e.got[i] == want[i];
        i += 1;
      }
      return e.got.len().to_string() + " back, same " + same.to_string() + ", fin " + e.fin.to_string() + ", streams left " + e.p.client.buffered(0 as i64).to_string();
    },
    Err(why) => {
      return why;
    }
  }
}

function stream_configs(): (conn.Config, conn.Config) {
  let cc = client_config("tls.example", ["h3"]).with_streams(4 as i64, 4 as i64, 4000 as i64, 6000 as i64);
  let sc = server_config(["h3"]).with_streams(4 as i64, 4 as i64, 4000 as i64, 6000 as i64);
  return (cc, sc);
}

function test_stream_echo(): test.TestOutcome {
  let (cc, sc) = stream_configs();
  match (start(cc, sc)) {
    Ok(p0) => {
      return test.assert_eq(echo_report(streamed(p0, 20000, 400)), "20000 back, same true, fin true, streams left 0");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_stream_echo_lossy(): test.TestOutcome {
  let (cc, sc) = stream_configs();
  match (start(cc, sc)) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      return test.assert_eq(echo_report(streamed(Pair { ...p, lose_every: 7, reorder: true }, 20000, 2000)), "20000 back, same true, fin true, streams left 0");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_bare_refusals(): test.TestOutcome {
  let (cc, sc) = stream_configs();
  match (start(cc, sc)) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      let Ok(o) = p.client.open_stream(false) else {
        return test.fail("no stream");
      };
      let id = o.1;
      let none = 1000 as i64;
      let seen: string[] = [];
      let c = o.0.written(none, [1u8], false);
      seen = seen.append(c.refused());
      c = c.read_into(none);
      seen = seen.append(c.refused());
      c = c.stream_reset(none, 1 as i64);
      seen = seen.append(c.refused());
      c = c.sending_stopped(none, 1 as i64);
      seen = seen.append(c.refused());
      c = c.written(id, [1u8, 2u8], true);
      seen = seen.append("[" + c.refused() + "] " + c.buffered(id).to_string());
      c = c.written(id, [3u8], false);
      seen = seen.append(c.refused());
      match (c.write(id, [3u8], false)) {
        Ok(_) => {
          seen = seen.append("written after the end");
        },
        Err(why) => {
          seen = seen.append(why);
        }
      }
      return test.assert_eq(seen.join("; "), "no stream to write to; no stream to read from; no stream to reset; no stream to stop; [] 2; the stream's sending half is closed; quic: the stream's sending half is closed");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_no_streams(): test.TestOutcome {
  match (start(client_config("tls.example", ["h3"]), server_config(["h3"]))) {
    Ok(p0) => {
      let p = settle(p0, 12, 10000 * MS);
      match (p.client.open_stream(false)) {
        Ok(_) => {
          return test.fail("opened a stream the server does not allow");
        },
        Err(e) => {
          return test.assert_eq(e + " " + p.client.can_open(true).to_string(), "quic: the peer's limit on streams is reached false");
        }
      }
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function peer_update(p: Pair, payload: u8[]): u8[] {
  let Some(k) = p.client.spaces[2].send else {
    return [];
  };
  return packet.seal_short(server_of(p).scid, p.client.spaces[2].next_pn, 2, true, false, payload, k.updated());
}

function updated_ack(p: Pair, datagrams: u8[][]): boolean {
  let Some(k) = p.client.spaces[2].recv else {
    return false;
  };
  let want = p.client.spaces[2].next_pn;
  for d in datagrams {
    let Ok(h) = packet.parse(d, 0, 8) else {
      continue;
    };
    let Ok(o) = packet.open(d, h, k.updated(), p.client.spaces[2].largest_recv) else {
      continue;
    };
    let Ok(fs) = frames.read_all(o.payload) else {
      continue;
    };
    for f in fs {
      if let frames.AckFrame(a) = f {
        for r in a.ranges {
          if (o.key_phase && r.low <= want && want <= r.high) {
            return true;
          }
        }
      }
    }
  }
  return false;
}

function peer_frame(p: Pair, payload: u8[]): u8[] {
  let Some(k) = p.client.spaces[2].send else {
    return [];
  };
  return packet.seal_short(server_of(p).scid, p.client.spaces[2].next_pn, 2, false, false, payload, k);
}

function refused_by_server(payload: u8[]): string {
  let (cc, sc) = stream_configs();
  let Ok(p0) = start(cc, sc) else {
    return "start failed; ";
  };
  let p = settle(p0, 12, 10000 * MS);
  let step = server_of(p).receive(peer_frame(p, payload), at_ns(p.now));
  return noted("server", step);
}

function test_refused_frames(): test.TestOutcome {
  let out = refused_by_server(frames.encode(frames.RetireConnectionId(100000 as i64)));
  out += refused_by_server(frames.encode(frames.RetireConnectionId(0 as i64)));
  out += refused_by_server(new_cid_frame(2 as i64, 0 as i64, 40));
  out += refused_by_server(new_cid_frame(1 as i64, 0 as i64, 41));
  out += refused_by_server(frames.encode(frames.Crypto(100000000 as i64, [120u8])));
  out += refused_by_server(frames.encode(frames.Crypto(0 as i64, [24u8, 0u8, 0u8, 1u8, 1u8])));
  return test.assert_eq(out, "server closed local 10 RETIRE_CONNECTION_ID for a sequence number never issued; server closed local 10 RETIRE_CONNECTION_ID names the connection ID it arrived on; server closed local 9 more connection IDs than active_connection_id_limit allows; server closed local 10 NEW_CONNECTION_ID repeats a sequence number with another connection ID; server closed local 13 CRYPTO data past what this side holds out of order; server closed local 266 tls handshake: unexpected handshake message 24; ");
}

function new_cid_frame(seq: i64, prior: i64, fill: i32): u8[] {
  return frames.encode(frames.NewConnectionIdFrame(frames.NewConnectionId { sequence: seq, retire_prior_to: prior, id: entropy(fill, 8), reset_token: entropy(fill + 1, 16) }));
}

function seqs(ids: conn.Cid[]): string {
  let out = "";
  for k in ids {
    out = out + k.seq.to_string() + ",";
  }
  return out;
}

function settled_pair(): Result[Pair, string] {
  let (cc, sc) = stream_configs();
  let p0 = start(cc, sc)?;
  return Ok(settle(p0, 12, 10000 * MS));
}

function test_connection_ids_issued(): test.TestOutcome {
  let Ok(p) = settled_pair() else {
    return test.fail("start failed");
  };
  let s = server_of(p);
  let line = "client holds " + seqs(p.client.remote_cids) + " answers to " + seqs(p.client.local_cids) + "; server holds " + seqs(s.remote_cids) + " answers to " + seqs(s.local_cids);
  return test.assert_eq(line, "client holds 0,1, answers to 0,1,; server holds 0,1, answers to 0,1,");
}

function test_rotated_connection_id(): test.TestOutcome {
  let Ok(p) = settled_pair() else {
    return test.fail("start failed");
  };
  let before = hex.encode(p.client.dcid);
  p = Pair { ...p, client: p.client.rotate_dcid() };
  let changed = hex.encode(p.client.dcid) != before;
  let r = streamed(p, 3000, 200);
  let Ok(e) = r else {
    return test.fail(echo_report(r));
  };
  let s = server_of(e.p);
  return test.assert_eq(echo_report(r) + " | dcid changed " + changed.to_string() + ", client dcid seq " + e.p.client.dcid_seq.to_string() + ", server answers to " + seqs(s.local_cids) + " client holds " + seqs(e.p.client.remote_cids), "3000 back, same true, fin true, streams left 0 | dcid changed true, client dcid seq 1, server answers to 1,2, client holds 1,2,");
}

function test_rebinding(): test.TestOutcome {
  let Ok(p) = settled_pair() else {
    return test.fail("start failed");
  };
  p = Pair { ...p, client_path: [2u8] };
  let r = streamed(p, 3000, 200);
  let Ok(e) = r else {
    return test.fail(echo_report(r));
  };
  let s = server_of(e.p);
  return test.assert_eq(echo_report(r) + " | server path " + hex.encode(s.path()) + ", probing " + s.probe.is_some().to_string() + ", server dcid seq " + s.dcid_seq.to_string() + ", client answers to " + seqs(e.p.client.local_cids), "3000 back, same true, fin true, streams left 0 | server path 02, probing false, server dcid seq 1, client answers to 1,2,");
}

function test_path_validation_fails(): test.TestOutcome {
  let Ok(p) = settled_pair() else {
    return test.fail("start failed");
  };
  let Ok(opened) = p.client.open_stream(false) else {
    return test.fail("no stream");
  };
  let Ok(w) = opened.0.write(opened.1, entropy(5, 100), true) else {
    return test.fail("no write");
  };
  let (p1, moved) = exchange(Pair { ...p, client: w, client_path: [2u8] });
  let migrated = hex.encode(server_of(p1).path());
  let p2 = settle(Pair { ...p1, drop_client: 1000 }, 60, p1.now + 20000 * MS);
  let s = server_of(p2);
  return test.assert_eq(migrated + " then " + hex.encode(s.path()) + ", probing " + s.probe.is_some().to_string(), "02 then 01, probing false");
}

function server_frame(p: Pair, payload: u8[]): u8[] {
  let s = server_of(p);
  let Some(k) = s.spaces[2].send else {
    return [];
  };
  return packet.seal_short(p.client.scid, s.spaces[2].next_pn, 2, false, false, payload, k);
}

function test_client_ignores_unknown_server_path(): test.TestOutcome {
  let Ok(p) = settled_pair() else {
    return test.fail("start failed");
  };
  let d = server_frame(p, frames.encode(frames.Ping));
  let ignored = p.client.receive_from(d, [9u8], 0, at_ns(p.now));
  let taken = p.client.receive_from(d, [SERVER_PATH], 0, at_ns(p.now));
  return test.assert_eq((ignored.accepted - p.client.accepted).to_string() + "," + (taken.accepted - p.client.accepted).to_string(), "0,1");
}

function retired_in(p: Pair, datagrams: u8[][]): string {
  let Some(k) = p.client.spaces[2].recv else {
    return "no keys";
  };
  let out = "";
  for d in datagrams {
    let Ok(h) = packet.parse(d, 0, 8) else {
      continue;
    };
    let Ok(o) = packet.open(d, h, k, p.client.spaces[2].largest_recv) else {
      continue;
    };
    let Ok(fs) = frames.read_all(o.payload) else {
      continue;
    };
    for f in fs {
      if let frames.RetireConnectionId(seq) = f {
        out = out + seq.to_string() + ",";
      }
    }
  }
  return out;
}

function test_retire_prior_to(): test.TestOutcome {
  let Ok(p) = settled_pair() else {
    return test.fail("start failed");
  };
  let step = server_of(p).receive(peer_frame(p, new_cid_frame(2 as i64, 2 as i64, 42)), at_ns(p.now));
  let sent = step.transmit(at_ns(p.now));
  return test.assert_eq("dcid seq " + sent.dcid_seq.to_string() + ", holds " + seqs(sent.remote_cids) + ", retired " + retired_in(p, sent.datagrams()), "dcid seq 2, holds 2,, retired 0,1,");
}

function test_peer_key_update_ack(): test.TestOutcome {
  let (cc, sc) = stream_configs();
  let Ok(p0) = start(cc, sc) else {
    return test.fail("start");
  };
  let p = settle(p0, 12, 10000 * MS);
  let step = server_of(p).receive(peer_update(p, frames.encode(frames.Ping)), at_ns(p.now));
  let after = step.transmit(at_ns(p.now));
  let out = after.datagrams();
  after = after.sent();
  return test.assert_eq(updated_ack(p, out).to_string(), "true");
}

function test_peer_key_update_stream(): test.TestOutcome {
  let (cc, sc) = stream_configs();
  let Ok(p0) = start(cc, sc) else {
    return test.fail("start");
  };
  let p = settle(p0, 12, 10000 * MS);
  let f = frames.StreamFrame(frames.StreamData { stream: 0 as i64, offset: 0 as i64, data: entropy(5, 3), fin: true });
  let step = server_of(p).receive(peer_update(p, frames.encode(f)), at_ns(p.now));
  let Ok(r) = step.read(0 as i64) else {
    return test.fail("updated-key STREAM was not delivered");
  };
  return test.assert_eq(hex.encode(r.1) + " " + r.2.to_string(), "050c13 true");
}

function phase_packet(p: Pair, pn: i64, generations: i32): u8[] {
  let Some(k) = p.client.spaces[2].send else {
    return [];
  };
  let i = 0;
  while (i < generations) {
    k = k.updated();
    i += 1;
  }
  return packet.seal_short(server_of(p).scid, pn, 2, generations % 2 == 1, false, frames.encode(frames.Ping), k);
}

function key_pair(): Result[Pair, string] {
  let (cc, sc) = stream_configs();
  return Ok(settle(start(cc, sc)?, 12, 10000 * MS));
}

function close_code(c: conn.Conn): i64 {
  if let Some(why) = c.close {
    return why.code;
  }
  return -1i64;
}

function received_pn(c: conn.Conn, pn: i64): boolean {
  for r in c.spaces[2].ranges {
    if (r.low <= pn && pn <= r.high) {
      return true;
    }
  }
  return false;
}

function test_local_key_update(): test.TestOutcome {
  let (cc, sc) = stream_configs();
  let Ok(initial) = start(cc, sc) else {
    return test.fail("start");
  };
  if (initial.client.update_keys(at_ns(initial.now)).is_ok()) {
    return test.fail("updated before confirmation");
  }
  let p = settle(initial, 12, 10000 * MS);
  let old = server_of(p);
  let Ok(updated) = old.update_keys(at_ns(p.now)) else {
    return test.fail("confirmed, acknowledged update refused");
  };
  if (updated.update_keys(at_ns(p.now)).is_ok()) {
    return test.fail("second update before acknowledgement");
  }
  let queued = conn.Conn { ...updated, pending: updated.pending.append(frames.Ping) };
  let cur = Pair { ...p, server: Some(queued) };
  let i = 0;
  while (i < 4) {
    let (next, _) = exchange(cur);
    cur = next;
    i += 1;
  }
  let s = server_of(cur);
  return test.assert_eq(s.key_phase.to_string() + " " + cur.client.key_phase.to_string() + " " + s.key_awaiting_peer.to_string() + " " + old.key_phase.to_string(), "true true false false");
}

function test_key_update_reordering(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let pn = p.client.spaces[2].next_pn;
  let old = server_of(p);
  let promoted = old.receive(phase_packet(p, pn + 3, 1), at_ns(p.now));
  let reordered = promoted.receive(phase_packet(p, pn + 1, 0), at_ns(p.now));
  if (reordered.failed_auth != 0 || !received_pn(reordered, pn + 1) || close_code(reordered) != -1i64) {
    return test.fail("old reordered packet refused");
  }
  let expired = reordered.tick(at_ns(reordered.key_discard_at));
  let without_tick = reordered.receive(phase_packet(p, pn + 2, 0), at_ns(reordered.key_discard_at));
  if (without_tick.failed_auth != 1 || received_pn(without_tick, pn + 2)) {
    return test.fail("expired old keys used before tick");
  }
  let dropped = expired.receive(phase_packet(p, pn + 2, 0), at_ns(reordered.key_discard_at));
  let boundary = expired.receive(phase_packet(p, pn, 1), at_ns(reordered.key_discard_at));
  return test.assert_eq(reordered.key_phase.to_string() + " " + reordered.key_previous_max.to_string() + " " + expired.key_previous_recv.is_none().to_string() + " " + dropped.failed_auth.to_string() + " " + old.key_phase.to_string() + " " + close_code(boundary).to_string(), "true " + (pn + 1).to_string() + " true 1 false 14");
}

function test_forged_key_phase(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let s = server_of(p);
  let wire = phase_packet(p, p.client.spaces[2].next_pn, 1);
  let corrupt = wire.with(wire.len() - 1, (wire[wire.len() - 1] as i32 ^ 1) as u8);
  let rejected = s.receive(corrupt, at_ns(p.now));
  let Some(before) = s.key_next_recv else {
    return test.fail("uncached next key");
  };
  let Some(after) = rejected.key_next_recv else {
    return test.fail("forgery removed next key");
  };
  return test.assert_eq(rejected.key_phase.to_string() + " " + rejected.key_previous_recv.is_none().to_string() + " " + rejected.key_generate_at.to_string() + " " + rejected.failed_auth.to_string() + " " + (hex.encode(before.secret) == hex.encode(after.secret)).to_string() + " " + close_code(rejected).to_string(), "false true 0 1 true -1");
}

function test_unconfirmed_key_update(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let s = server_of(p);
  let unconfirmed = conn.Conn { ...s, recovery: recovery.Recovery { ...s.recovery, handshake_confirmed: false } };
  let rejected = unconfirmed.receive(peer_update(p, frames.encode(frames.Ping)), at_ns(p.now));
  return test.assert_eq(close_code(rejected).to_string(), "14");
}

function test_double_key_update(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let first = server_of(p).receive(peer_update(p, frames.encode(frames.Ping)), at_ns(p.now));
  let ready = first.tick(at_ns(first.key_generate_at));
  let rejected = ready.receive(phase_packet(p, p.client.spaces[2].next_pn + 1, 2), at_ns(first.key_generate_at));
  return test.assert_eq(first.key_unacked.to_string() + " " + close_code(rejected).to_string(), "true 14");
}

function test_second_key_update(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let first = server_of(p).receive(peer_update(p, frames.encode(frames.Ping)), at_ns(p.now));
  let acked = first.transmit(at_ns(p.now));
  let _ = acked.datagrams();
  acked = acked.sent();
  let ready = acked.tick(at_ns(first.key_generate_at));
  let second = ready.receive(phase_packet(p, p.client.spaces[2].next_pn + 1, 2), at_ns(first.key_generate_at));
  return test.assert_eq(acked.key_unacked.to_string() + " " + ready.key_next_recv.is_some().to_string() + " " + second.key_phase.to_string() + " " + second.spaces[2].largest_recv.to_string() + " " + close_code(second).to_string(), "false true false " + (p.client.spaces[2].next_pn + 1).to_string() + " -1");
}

function test_key_generation_timer(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let first = server_of(p).receive(peer_update(p, frames.encode(frames.Ping)), at_ns(p.now));
  let invalid = first.receive(phase_packet(p, p.client.spaces[2].next_pn + 1, 2), at_ns(p.now));
  let ready = invalid.tick(at_ns(first.key_generate_at));
  return test.assert_eq(first.key_next_recv.is_none().to_string() + " " + invalid.key_next_recv.is_none().to_string() + " " + (invalid.key_generate_at == first.key_generate_at).to_string() + " " + invalid.failed_auth.to_string() + " " + ready.key_next_recv.is_some().to_string() + " " + ready.key_generate_at.to_string(), "true true true 1 true 0");
}

function test_nonmonotonic_key_update(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let s = server_of(p);
  let rejected = s.receive(phase_packet(p, s.spaces[2].largest_recv, 1), at_ns(p.now));
  return test.assert_eq(close_code(rejected).to_string(), "14");
}

function test_key_authentication_limit(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let s = conn.Conn { ...server_of(p), failed_auth: 4503599627370495 as i64 };
  let bytes = phase_packet(p, p.client.spaces[2].next_pn, 1);
  let bad = bytes.with(bytes.len() - 1, (bytes[bytes.len() - 1] as i32 ^ 1) as u8);
  let closed = s.receive(bad, at_ns(p.now));
  let again = closed.receive(bytes, at_ns(p.now));
  return test.assert_eq(closed.failed_auth.to_string() + " " + close_code(closed).to_string() + " " + again.key_phase.to_string() + " " + s.failed_auth.to_string(), "4503599627370496 15 false 4503599627370495");
}

function test_key_encryption_limit(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let s = server_of(p);
  let near = conn.Conn { ...s, key_sent: 8388607 as i64, pending: s.pending.append(frames.Ping) };
  let rotated = near.transmit(at_ns(p.now));
  let out = rotated.datagrams();
  rotated = rotated.sent();
  if (out.len() == 0 || !rotated.key_phase || rotated.key_sent != 1) {
    return test.fail("did not rotate before confidentiality limit");
  }
  let blocked = conn.Conn { ...near, recovery: recovery.Recovery { ...near.recovery, handshake_confirmed: false } };
  let closed = blocked.transmit(at_ns(p.now));
  let last = closed.datagrams();
  closed = closed.sent();
  let exhausted = closed.receive([], at_ns(p.now)).transmit(at_ns(p.now));
  let extra = exhausted.datagrams();
  return test.assert_eq(close_code(closed).to_string() + " " + closed.key_sent.to_string() + " " + (last.len() > 0).to_string() + " " + extra.len().to_string() + " " + exhausted.key_sent.to_string() + " " + near.key_sent.to_string(), "15 8388608 true 0 8388608 8388607");
}

function test_chacha_authentication_limit(): test.TestOutcome {
  let Ok(p) = key_pair() else {
    return test.fail("pair");
  };
  let chacha = packet.keys(keyschedule.ChaCha20Poly1305Sha256, entropy(9, 32));
  let s = conn.Conn { ...server_of(p), key_next_recv: Some(chacha), failed_auth: 68719476735 as i64 };
  let closed = s.receive(peer_update(p, frames.encode(frames.Ping)), at_ns(p.now));
  return test.assert_eq(closed.failed_auth.to_string() + " " + close_code(closed).to_string() + " " + closed.key_phase.to_string() + " " + s.failed_auth.to_string(), "68719476736 15 false 68719476735");
}

function main(): i32 {
  let r = test.new("std/quic/conn");
  r = r.it("a handshake in memory", test_handshake);
  r = r.it("resuming a session with a ticket", test_resumption);
  r = r.it("the anti-amplification limit", test_amplification);
  r = r.it("a lost datagram, by time threshold", test_lost_datagram);
  r = r.it("a lost flight, by probe timeout", test_lost_flight);
  r = r.it("an untrusted certificate", test_untrusted);
  r = r.it("the certificate validity window, at the given wall clock", test_validity_window);
  r = r.it("an expired certificate", test_expired);
  r = r.it("no protocol in common", test_no_protocol);
  r = r.it("closing", test_close);
  r = r.it("following a Retry", test_retry);
  r = r.it("a server issuing a Retry", test_server_retry);
  r = r.it("the Retry token's checks", test_retry_token_checks);
  r = r.it("a token the server did not issue", test_invalid_token_closes);
  r = r.it("a Retry naming the client's own connection ID", test_retry_naming_own_dcid_ignored);
  r = r.it("the idle timeout", test_idle);
  r = r.it("a stream echoed through small windows", test_stream_echo);
  r = r.it("a stream echoed through loss and reordering", test_stream_echo_lossy);
  r = r.it("the bare stream steps report refusals", test_bare_refusals);
  r = r.it("no streams allowed", test_no_streams);
  r = r.it("a peer key update is acknowledged under updated keys", test_peer_key_update_ack);
  r = r.it("a peer key update carries stream bytes", test_peer_key_update_stream);
  r = r.it("local updates require confirmation and acknowledgement", test_local_key_update);
  r = r.it("old read keys allow reordering then expire", test_key_update_reordering);
  r = r.it("forged phases do not advance keys", test_forged_key_phase);
  r = r.it("a peer cannot update before confirmation", test_unconfirmed_key_update);
  r = r.it("a peer cannot update twice before an acknowledgement", test_double_key_update);
  r = r.it("an acknowledged second key update succeeds", test_second_key_update);
  r = r.it("only the timer prepares another generation", test_key_generation_timer);
  r = r.it("authenticated updates require increasing packet numbers", test_nonmonotonic_key_update);
  r = r.it("the cumulative authentication limit closes the connection", test_key_authentication_limit);
  r = r.it("the encryption limit rotates or closes before overuse", test_key_encryption_limit);
  r = r.it("the ChaCha authentication limit is cumulative", test_chacha_authentication_limit);
  r = r.it("frames a server refuses in 1-RTT", test_refused_frames);
  r = r.it("each side issues connection IDs up to the peer's limit", test_connection_ids_issued);
  r = r.it("a client moves to the next connection ID mid-stream", test_rotated_connection_id);
  r = r.it("a server follows a client to a new address and validates the path", test_rebinding);
  r = r.it("a path that does not answer is abandoned", test_path_validation_fails);
  r = r.it("a client drops datagrams from an unknown server address", test_client_ignores_unknown_server_path);
  r = r.it("retire_prior_to retires the connection IDs below it", test_retire_prior_to);
  r = r.it("ECN marks are counted, validated, and read as congestion", test_ecn);
  return r.finish();
}

function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
