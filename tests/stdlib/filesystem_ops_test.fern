import "core/cmp";
import "std/test";
import "std/io";

function test_temp_dir_returns_abs_path(): test.TestOutcome {
  match (temp_dir("fs-ops")) {
    Ok(dir) => {
      let ok = dir.starts_with("/") || dir.starts_with("\\");
      match (remove_dir_all(dir)) {
        Ok(_) => {},
        Err(_) => {}
      }
      if (ok) {
        return test.pass();
      }
      return test.fail("temp_dir returned non-absolute path \"" + dir + "\"");
    },
    Err(_) => {
      return test.fail("temp_dir returned Err");
    }
  }
  return test.pass();
}

function test_temp_file_round_trip(): test.TestOutcome {
  let made = io.temp_file("fs-ops");
  match (made) {
    Ok(t) => {
      let path = t.path;
      match (t.file.write("abc")) {
        Ok(_) => {},
        Err(_) => {
          return test.fail("write to the temp file failed");
        }
      }
      match (t.file.close()) {
        Ok(_) => {},
        Err(_) => {
          return test.fail("close of the temp file failed");
        }
      }
      let got = "";
      match (read_file(path)) {
        Ok(text) => {
          got = text;
        },
        Err(_) => {
          return test.fail("read back of the temp file failed");
        }
      }
      match (remove_file(path)) {
        Ok(_) => {},
        Err(_) => {
          return test.fail("remove of the temp file failed");
        }
      }
      return test.assert_eq(got, "abc");
    },
    Err(_) => {
      return test.fail("temp_file returned Err");
    }
  }
  return test.pass();
}

// The body of the directory-relative case. Each step that fails gives its name.
function temp_file_in_steps(dir: Dir): Result[string, string] {
  let Ok(t) = io.temp_file_in(dir, "in") else {
    return Err("temp_file_in");
  };
  let name = t.path;
  let Ok(_) = t.file.write("abc") else {
    return Err("write");
  };
  let Ok(_) = t.file.close() else {
    return Err("close");
  };
  let Ok(st) = dir.lstat(name) else {
    return Err("lstat");
  };
  if (!st.is_file || (st.mode & 511u32) != 384u32) {
    return Err("mode " + (st.mode & 511u32).to_string());
  }
  let Ok(r) = dir.open_reader(name) else {
    return Err("open_reader");
  };
  let Ok(bytes) = io.read_all_bytes(r) else {
    return Err("read");
  };
  let Ok(_) = r.close() else {
    return Err("close of the reader");
  };
  if (io.temp_file_in(dir, "a/b").is_ok()) {
    return Err("a prefix with a separator was accepted");
  }
  let Ok(_) = dir.remove_file(name) else {
    return Err("remove_file");
  };
  return Ok(name + " " + bytes.len().to_string());
}

// temp_file_in makes its file relative to a directory handle, with mode 0600.
function test_temp_file_in_a_directory(): test.TestOutcome {
  let Ok(root) = temp_dir("fs-in") else {
    return test.fail("temp_dir returned Err");
  };
  let Ok(dir) = open_dir(root) else {
    return test.fail("open_dir returned Err");
  };
  let done = temp_file_in_steps(dir);
  let closed = dir.close();
  let removed = remove_dir(root);
  match (done) {
    Ok(text) => {
      if (!text.starts_with("in-") || !text.ends_with(" 3")) {
        return test.fail("unexpected name and size: " + text);
      }
    },
    Err(step) => {
      return test.fail(step);
    }
  }
  if (closed.is_err() || removed.is_err()) {
    return test.fail("the directory did not close and go");
  }
  return test.pass();
}

// Bit 1024 of the flag word gives a file that the open creates mode 0600.
function test_open_writer_with_private_bit(): test.TestOutcome {
  let Ok(root) = temp_dir("fs-private") else {
    return test.fail("temp_dir returned Err");
  };
  let path = root + "/private";
  let Ok(w) = open_writer_with(path, 1029) else {
    return test.fail("open_writer_with returned Err");
  };
  let closed = w.close();
  let mode = 0u32;
  match (stat(path)) {
    Ok(st) => {
      mode = st.mode & 511u32;
    },
    Err(_) => {}
  }
  let removed = remove_dir_all(root);
  if (closed.is_err() || removed.is_err()) {
    return test.fail("the file did not close and go");
  }
  return test.assert_eq(mode, 384u32);
}

function test_temp_file_refuses_a_separator(): test.TestOutcome {
  match (io.temp_file("a/b")) {
    Ok(t) => {
      match (remove_file(t.path)) {
        Ok(_) => {},
        Err(_) => {}
      }
      return test.fail("a prefix with a separator was accepted");
    },
    Err(_) => {
      return test.pass();
    }
  }
  return test.pass();
}

function test_read_dir_lists_what_we_wrote(): test.TestOutcome {
  match (temp_dir("readdir-fixture")) {
    Ok(dir) => {
      match (write_file(dir + "/a.txt", "a")) {
        Ok(_) => {},
        Err(_) => {
          return test.fail("write a failed");
        }
      }
      match (write_file(dir + "/b.txt", "b")) {
        Ok(_) => {},
        Err(_) => {
          return test.fail("write b failed");
        }
      }
      match (write_file(dir + "/c.txt", "c")) {
        Ok(_) => {},
        Err(_) => {
          return test.fail("write c failed");
        }
      }
      match (read_dir(dir)) {
        Ok(names) => {
          let sorted = cmp.sort(names);
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.assert_eq_array(sorted, ["a.txt", "b.txt", "c.txt"]);
        },
        Err(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.fail("read_dir returned Err");
        }
      }
    },
    Err(_) => {
      return test.fail("temp_dir setup failed");
    }
  }
  return test.pass();
}

function test_remove_file_removes_a_single_file(): test.TestOutcome {
  match (temp_dir("rmfile-fixture")) {
    Ok(dir) => {
      let keep = dir + "/keep.txt";
      let doomed = dir + "/doomed.txt";
      match (write_file(keep, "keep")) {
        Ok(_) => {},
        Err(_) => {
          return test.fail("write keep failed");
        }
      }
      match (write_file(doomed, "doomed")) {
        Ok(_) => {},
        Err(_) => {
          return test.fail("write doomed failed");
        }
      }
      match (remove_file(doomed)) {
        Ok(_) => {},
        Err(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.fail("remove_file returned Err");
        }
      }
      match (read_dir(dir)) {
        Ok(names) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.assert_eq_array(names, ["keep.txt"]);
        },
        Err(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.fail("post-rm read_dir failed");
        }
      }
    },
    Err(_) => {
      return test.fail("temp_dir setup failed");
    }
  }
  return test.pass();
}

function test_remove_file_on_missing_target_is_an_error(): test.TestOutcome {
  match (remove_file("/tmp/lang-this-file-definitely-does-not-exist-83274")) {
    Ok(_) => {
      return test.fail("expected error on missing target, got None");
    },
    Err(_) => {
      return test.pass();
    }
  }
  return test.pass();
}

function test_create_dir_all_builds_a_missing_chain(): test.TestOutcome {
  match (temp_dir("mkdirp-fixture")) {
    Ok(dir) => {
      let leaf = dir + "/one/two/three";
      match (create_dir_all(leaf)) {
        Ok(_) => {},
        Err(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.fail("create_dir_all returned Err");
        }
      }
      match (write_file(leaf + "/deep.txt", "deep")) {
        Ok(_) => {},
        Err(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.fail("write into the created chain failed");
        }
      }
      match (read_dir(dir + "/one/two")) {
        Ok(names) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.assert_eq_array(names, ["three"]);
        },
        Err(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.fail("read_dir of the created parent failed");
        }
      }
    },
    Err(_) => {
      return test.fail("temp_dir setup failed");
    }
  }
  return test.pass();
}

function test_create_dir_all_on_existing_path_is_ok(): test.TestOutcome {
  match (temp_dir("mkdirp-exists")) {
    Ok(dir) => {
      match (create_dir_all(dir)) {
        Ok(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.pass();
        },
        Err(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.fail("create_dir_all over an existing directory returned Err");
        }
      }
    },
    Err(_) => {
      return test.fail("temp_dir setup failed");
    }
  }
  return test.pass();
}

// The parent exists, so only the leaf is new.
function test_create_dir_all_makes_a_leaf_under_an_existing_parent(): test.TestOutcome {
  match (temp_dir("mkdirp-leaf")) {
    Ok(dir) => {
      let made = create_dir_all(dir + "/leaf").is_ok() && write_file(dir + "/leaf/f", "x").is_ok();
      match (remove_dir_all(dir)) {
        Ok(_) => {},
        Err(_) => {}
      }
      return test.assert_eq(made, true);
    },
    Err(_) => {
      return test.fail("temp_dir setup failed");
    }
  }
}

function test_create_dir_all_under_a_file_is_an_error(): test.TestOutcome {
  match (temp_dir("mkdirp-notdir")) {
    Ok(dir) => {
      let blocker = dir + "/blocker";
      match (write_file(blocker, "x")) {
        Ok(_) => {},
        Err(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.fail("write blocker failed");
        }
      }
      match (create_dir_all(blocker + "/inner")) {
        Ok(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.fail("expected Err under a regular file, got Ok");
        },
        Err(_) => {
          match (remove_dir_all(dir)) {
            Ok(_) => {},
            Err(_) => {}
          }
          return test.pass();
        }
      }
    },
    Err(_) => {
      return test.fail("temp_dir setup failed");
    }
  }
  return test.pass();
}

function test_remove_dir_all_silently_ok_on_missing_target(): test.TestOutcome {
  match (remove_dir_all("/tmp/lang-this-dir-definitely-does-not-exist-83274")) {
    Ok(_) => {
      return test.pass();
    },
    Err(_) => {
      return test.fail("expected None on missing target, got Err");
    }
  }
  return test.pass();
}

function main(): i32 {
  let r = test.new("filesystem ops");
  r = r.it("temp_dir returns absolute path", test_temp_dir_returns_abs_path);
  r = r.it("temp_file round trip", test_temp_file_round_trip);
  r = r.it("temp_file refuses a separator", test_temp_file_refuses_a_separator);
  r = r.it("temp_file_in a directory", test_temp_file_in_a_directory);
  r = r.it("open_writer_with private bit", test_open_writer_with_private_bit);
  r = r.it("read_dir lists what we wrote", test_read_dir_lists_what_we_wrote);
  r = r.it("remove_file removes a single file", test_remove_file_removes_a_single_file);
  r = r.it("remove_file on missing target errors", test_remove_file_on_missing_target_is_an_error);
  r = r.it("remove_dir_all on missing target is ok", test_remove_dir_all_silently_ok_on_missing_target);
  r = r.it("create_dir_all builds a missing chain", test_create_dir_all_builds_a_missing_chain);
  r = r.it("create_dir_all on an existing path is ok", test_create_dir_all_on_existing_path_is_ok);
  r = r.it("create_dir_all makes a leaf under an existing parent", test_create_dir_all_makes_a_leaf_under_an_existing_parent);
  r = r.it("create_dir_all under a file errors", test_create_dir_all_under_a_file_is_an_error);
  return r.finish();
}
