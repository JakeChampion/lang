import "std/test";
import "std/format" as format;
import "core/cmp";

@derive(cmp.Display)
struct Point { x: i32, y: i32 }

function test_format_positional(): test.TestOutcome {
  return test.assert_eq(format.format("{} + {} = {}", ["1", "2", "3"]), "1 + 2 = 3");
}

function test_format_no_placeholders(): test.TestOutcome {
  return test.assert_eq(format.format("plain text", []), "plain text");
}

function test_format_escaped_braces(): test.TestOutcome {
  return test.assert_eq(format.format("{{}} literal", []), "{} literal");
}

function test_format_values_ints(): test.TestOutcome {
  return test.assert_eq(format.format_values("{} + {} = {}", [40, 2, 42]), "40 + 2 = 42");
}

function test_format_values_floats(): test.TestOutcome {
  return test.assert_eq(format.format_values("{} and {}", [0.5, 1.25]), "0.5 and 1.25");
}

function test_format1(): test.TestOutcome {
  return test.assert_eq(format.format1("n={}", 7), "n=7");
}

function test_format2_mixed(): test.TestOutcome {
  return test.assert_eq(format.format2("{} {}", 3, "cats"), "3 cats");
}

function test_format3_mixed(): test.TestOutcome {
  return test.assert_eq(format.format3("{} {} {}", 3, "cats", true), "3 cats true");
}

function test_format4_mixed(): test.TestOutcome {
  return test.assert_eq(format.format4("{}/{}/{}/{}", 1, "a", true, 0.5), "1/a/true/0.5");
}

function test_format_derived_struct(): test.TestOutcome {
  return test.assert_eq(
    format.format1("at {}", Point { x: 1, y: 2 }),
    "at Point { x: 1, y: 2 }",
  );
}

function test_format_raw_with_spec(): test.TestOutcome {
  return test.assert_eq(format.format1("[{:>5}]", 42), "[   42]");
}

function test_format_right_align(): test.TestOutcome {
  return test.assert_eq(format.format("{:>5}", ["42"]), "   42");
}

function test_format_left_align(): test.TestOutcome {
  return test.assert_eq(format.format("{:<5}", ["42"]), "42   ");
}

function test_format_center_align(): test.TestOutcome {
  return test.assert_eq(format.format("{:^8}", ["hi"]), "   hi   ");
}

function test_format_custom_fill_center(): test.TestOutcome {
  return test.assert_eq(format.format("{:*^9}", ["ab"]), "***ab****");
}

function test_format_custom_fill_right(): test.TestOutcome {
  return test.assert_eq(format.format("{:.>5}", ["x"]), "....x");
}

function test_format_multibyte_fill(): test.TestOutcome {
  return test.assert_eq(format.format("{:é>4}", ["ab"]), "ééab");
}

function test_format_sign_plus(): test.TestOutcome {
  return test.assert_eq(format.format("{:+}", ["42"]), "+42");
}

function test_format_sign_negative_untouched(): test.TestOutcome {
  return test.assert_eq(format.format("{:+}", ["-42"]), "-42");
}

function test_format_sign_nonnumeric_untouched(): test.TestOutcome {
  return test.assert_eq(format.format("{:+}", ["ok"]), "ok");
}

function test_format_zero_pad(): test.TestOutcome {
  return test.assert_eq(format.format("{:05}", ["42"]), "00042");
}

function test_format_zero_pad_negative(): test.TestOutcome {
  return test.assert_eq(format.format("{:05}", ["-42"]), "-0042");
}

function test_format_sign_zero_pad(): test.TestOutcome {
  return test.assert_eq(format.format("{:+06}", ["42"]), "+00042");
}

function test_format_zero_pad_overrides_align(): test.TestOutcome {
  return test.assert_eq(format.format("{:<05}", ["42"]), "00042");
}

function test_precision_float_truncating(): test.TestOutcome {
  return test.assert_eq(format.format1("{:.2}", 3.14159), "3.14");
}

function test_precision_float_rounds_up(): test.TestOutcome {
  return test.assert_eq(format.format1("{:.2}", 3.999), "4.00");
}

function test_precision_carry_widens(): test.TestOutcome {
  return test.assert_eq(format.format1("{:.0}", 9.9), "10");
}

function test_precision_zero_places(): test.TestOutcome {
  return test.assert_eq(format.format1("{:.0}", 3.7), "4");
}

function test_precision_pads_integer(): test.TestOutcome {
  return test.assert_eq(format.format1("{:.2}", 3), "3.00");
}

function test_precision_negative(): test.TestOutcome {
  return test.assert_eq(format.format1("{:>8.2}", 0.0 - 2.5), "   -2.50");
}

function test_precision_string_truncates(): test.TestOutcome {
  return test.assert_eq(format.format("{:>8.3}", ["hello"]), "     hel");
}

function test_precision_string_snaps_multibyte(): test.TestOutcome {
  return test.assert_eq(format.format("{:.2}", ["héllo"]), "h");
}

function test_bytes_below_kib(): test.TestOutcome {
  return test.assert_eq(format.format_bytes(0), "0 B");
}

function test_bytes_just_below_kib(): test.TestOutcome {
  return test.assert_eq(format.format_bytes(1023), "1023 B");
}

function test_bytes_one_kib(): test.TestOutcome {
  return test.assert_eq(format.format_bytes(1024), "1 KiB");
}

function test_bytes_one_mib(): test.TestOutcome {
  return test.assert_eq(format.format_bytes(1048576), "1 MiB");
}

function test_bytes_negative(): test.TestOutcome {
  return test.assert_eq(format.format_bytes(0 - 2048), "-2 KiB");
}

function test_bytes_past_two_gib(): test.TestOutcome {
  let n: i64 = 5368709120;
  return test.assert_eq(format.format_bytes(n), "5 GiB");
}

function test_bytes_i64_min(): test.TestOutcome {
  let n: i64 = -9223372036854775807 - 1;
  return test.assert_eq(format.format_bytes(n), "-8388608 TiB");
}

function test_bytes_tib(): test.TestOutcome {
  let n: i64 = 3298534883328;
  return test.assert_eq(format.format_bytes(n), "3 TiB");
}

function test_duration_zero(): test.TestOutcome {
  return test.assert_eq(format.format_duration_ms(0), "0ms");
}

function test_duration_sub_second(): test.TestOutcome {
  return test.assert_eq(format.format_duration_ms(500), "500ms");
}

function test_duration_seconds_and_ms(): test.TestOutcome {
  return test.assert_eq(format.format_duration_ms(1500), "1s 500ms");
}

function test_duration_minutes(): test.TestOutcome {
  return test.assert_eq(format.format_duration_ms(65000), "1m 5s");
}

function test_duration_full(): test.TestOutcome {
  return test.assert_eq(format.format_duration_ms(3661001), "1h 1m 1s 1ms");
}

function test_duration_past_i32(): test.TestOutcome {
  return test.assert_eq(format.format_duration_ms(2592000001 as i64), "720h 1ms");
}

function test_duration_negative(): test.TestOutcome {
  return test.assert_eq(format.format_duration_ms(0 - 1500), "-1s 500ms");
}

function test_duration_round_trips_parse(): test.TestOutcome {
  match (format.parse_duration_ms("30d 1s")) {
    Some(ms) => {
      return test.assert_eq(format.format_duration_ms(ms), "720h 1s");
    },
    None => {
      return test.fail("parse_duration_ms(\"30d 1s\") answered None");
    }
  }
}

function test_format_mixed_long(): test.TestOutcome {
  let got: string = format.format(
    "user={} role={} {{n}}={} cfg={\"k\":1} tail={} name={} done",
    ["alice", "admin", "7", "Þórin"],
  );
  return test.assert_eq(
    got,
    "user=alice role=admin {n}=7 cfg={\"k\":1} tail=Þórin name={} done",
  );
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/format");
  r = r.it("format positional", test_format_positional);
  r = r.it("format no placeholders", test_format_no_placeholders);
  r = r.it("format escaped braces", test_format_escaped_braces);
  r = r.it("format_values ints", test_format_values_ints);
  r = r.it("format_values floats", test_format_values_floats);
  r = r.it("format1", test_format1);
  r = r.it("format2 mixed", test_format2_mixed);
  r = r.it("format3 mixed", test_format3_mixed);
  r = r.it("format4 mixed", test_format4_mixed);
  r = r.it("format derived struct arg", test_format_derived_struct);
  r = r.it("format raw arg with spec", test_format_raw_with_spec);
  r = r.it("format right-align", test_format_right_align);
  r = r.it("format left-align", test_format_left_align);
  r = r.it("format center-align", test_format_center_align);
  r = r.it("format custom fill center", test_format_custom_fill_center);
  r = r.it("format custom fill right", test_format_custom_fill_right);
  r = r.it("format multibyte fill", test_format_multibyte_fill);
  r = r.it("format sign +", test_format_sign_plus);
  r = r.it("format sign negative untouched", test_format_sign_negative_untouched);
  r = r.it("format sign non-numeric untouched", test_format_sign_nonnumeric_untouched);
  r = r.it("format zero-pad", test_format_zero_pad);
  r = r.it("format zero-pad negative", test_format_zero_pad_negative);
  r = r.it("format sign + zero-pad", test_format_sign_zero_pad);
  r = r.it("format zero-pad overrides align", test_format_zero_pad_overrides_align);
  r = r.it("precision truncates fraction", test_precision_float_truncating);
  r = r.it("precision rounds up", test_precision_float_rounds_up);
  r = r.it("precision carry widens integer", test_precision_carry_widens);
  r = r.it("precision zero places", test_precision_zero_places);
  r = r.it("precision pads integer", test_precision_pads_integer);
  r = r.it("precision negative with width", test_precision_negative);
  r = r.it("precision truncates string bytes", test_precision_string_truncates);
  r = r.it("precision snaps multibyte string", test_precision_string_snaps_multibyte);
  r = r.it("bytes below KiB", test_bytes_below_kib);
  r = r.it("bytes just below KiB", test_bytes_just_below_kib);
  r = r.it("bytes one KiB", test_bytes_one_kib);
  r = r.it("bytes one MiB", test_bytes_one_mib);
  r = r.it("bytes negative", test_bytes_negative);
  r = r.it("bytes past 2 GiB", test_bytes_past_two_gib);
  r = r.it("bytes TiB", test_bytes_tib);
  r = r.it("bytes i64 minimum", test_bytes_i64_min);
  r = r.it("duration zero", test_duration_zero);
  r = r.it("duration sub-second", test_duration_sub_second);
  r = r.it("duration seconds and ms", test_duration_seconds_and_ms);
  r = r.it("duration minutes", test_duration_minutes);
  r = r.it("duration full", test_duration_full);
  r = r.it("duration past i32", test_duration_past_i32);
  r = r.it("duration negative", test_duration_negative);
  r = r.it("duration round-trips parse", test_duration_round_trips_parse);
  r = r.it("format mixed long", test_format_mixed_long);
  return r.finish();
}
