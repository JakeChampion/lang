import "std/test";
import "std/url" as url;
import "core/map";
import "std/utf8" as utf8;

function resolved(base: string, reference: string): string {
  match (url.resolve(base, reference)) {
    Ok(s) => {
      return s;
    },
    Err(e) => {
      return e.message();
    }
  }
}

function test_resolve_normal(): test.TestOutcome {
  let base: string = "http://a/b/c/d;p?q";
  let checks: (string, string)[] = [
    ("g", "http://a/b/c/g"),
    ("./g", "http://a/b/c/g"),
    ("g/", "http://a/b/c/g/"),
    ("/g", "http://a/g"),
    ("//g", "http://g"),
    ("?y", "http://a/b/c/d;p?y"),
    ("g?y", "http://a/b/c/g?y"),
    ("#s", "http://a/b/c/d;p?q#s"),
    ("g#s", "http://a/b/c/g#s"),
    ("", "http://a/b/c/d;p?q"),
    ("http://x/y", "http://x/y"),
  ];
  for check in checks {
    let got: string = resolved(base, check.0);
    if (got != check.1) {
      return test.fail(check.0 + " resolved to " + got + ", want " + check.1);
    }
  }
  return test.pass();
}

function test_resolve_dots(): test.TestOutcome {
  let base: string = "http://a/b/c/d;p?q";
  let checks: (string, string)[] = [
    (".", "http://a/b/c/"),
    ("./", "http://a/b/c/"),
    ("..", "http://a/b/"),
    ("../", "http://a/b/"),
    ("../g", "http://a/b/g"),
    ("../..", "http://a/"),
    ("../../g", "http://a/g"),
    ("../../../g", "http://a/g"),
    ("/./g", "http://a/g"),
    ("/../g", "http://a/g"),
    ("g/../h", "http://a/b/c/h"),
    ("g;x=1/./y", "http://a/b/c/g;x=1/y"),
  ];
  for check in checks {
    let got: string = resolved(base, check.0);
    if (got != check.1) {
      return test.fail(check.0 + " resolved to " + got + ", want " + check.1);
    }
  }
  return test.pass();
}

function test_resolve_base_parts(): test.TestOutcome {
  if (resolved("http://[::1]:8080/a/b?x=1", "../c") != "http://[::1]:8080/c") {
    return test.fail("an IPv6 base with a port: " + resolved("http://[::1]:8080/a/b?x=1", "../c"));
  }
  if (resolved("http://h", "p") != "http://h/p") {
    return test.fail("an empty base path: " + resolved("http://h", "p"));
  }
  return test.assert_eq(resolved("http://h/a?x=1#f", ""), "http://h/a?x=1");
}

function test_resolve_no_scheme(): test.TestOutcome {
  return test.assert_eq(resolved("/a/b", "c"), "\"/a/b\" has no scheme, so it cannot be a base URL");
}

function test_remove_dot_segments(): test.TestOutcome {
  if (url.remove_dot_segments("/a/b/c/./../../g") != "/a/g") {
    return test.fail("RFC 3986 §5.2.4 example 1: " + url.remove_dot_segments("/a/b/c/./../../g"));
  }
  if (url.remove_dot_segments("mid/content=5/../6") != "mid/6") {
    return test.fail("RFC 3986 §5.2.4 example 2: " + url.remove_dot_segments("mid/content=5/../6"));
  }
  if (url.remove_dot_segments("/a//b/") != "/a//b/") {
    return test.fail("empty segments are kept: " + url.remove_dot_segments("/a//b/"));
  }
  return test.assert_eq(url.remove_dot_segments("/.."), "/");
}

function test_encode_space(): test.TestOutcome {
  return test.assert_eq(url.encode("a b"), "a%20b");
}

function test_encode_unreserved(): test.TestOutcome {
  return test.assert_eq(url.encode("aZ9-._~"), "aZ9-._~");
}

function test_encode_reserved(): test.TestOutcome {
  return test.assert_eq(url.encode("/?&="), "%2F%3F%26%3D");
}

function test_decode_space(): test.TestOutcome {
  return test.assert_eq(url.decode("a%20b"), "a b");
}

function test_decode_lowercase_hex(): test.TestOutcome {
  return test.assert_eq(url.decode("%2f"), "/");
}

function test_decode_truncated(): test.TestOutcome {
  return test.assert_eq(url.decode("%2"), "%2");
}

function test_roundtrip(): test.TestOutcome {
  return test.assert_eq(url.decode(url.encode("a b/c?d=e&f")), "a b/c?d=e&f");
}

function test_parse_full(): test.TestOutcome {
  match (url.parse("http://example.com:8080/path?q=1#frag")) {
    Ok(u) => {
      return test.assert_true(u.scheme == "http" && u.host == "example.com"
        && u.port == 8080 && u.path == "/path" && u.query == "q=1"
        && u.fragment == "frag");
    },
    Err(_) => {
      return test.fail("url.parse(full) expected Ok");
    }
  }
}

function test_parse_minimal(): test.TestOutcome {
  match (url.parse("https://host.com/")) {
    Ok(u) => {
      return test.assert_true(u.scheme == "https" && u.host == "host.com"
        && u.port == 0 && u.path == "/" && u.query == "" && u.fragment == "");
    },
    Err(_) => {
      return test.fail("url.parse(minimal) expected Ok");
    }
  }
}

function test_parse_delimiter_order(): test.TestOutcome {
  match (url.parse("http://h?q/x#f?g/h")) {
    Ok(u) => {
      return test.assert_true(u.host == "h" && u.path == "" && u.query == "q/x" && u.fragment == "f?g/h");
    },
    Err(_) => {
      return test.fail("url.parse(delimiter order) expected Ok");
    }
  }
}

function test_parse_empty(): test.TestOutcome {
  match (url.parse("")) {
    Ok(u) => {
      return test.fail("url.parse(\"\") expected an error");
    },
    Err(e) => {
      return test.assert_eq(e.message(), "a URL cannot be empty");
    }
  }
}

function test_form_decode_plus(): test.TestOutcome {
  return test.assert_eq(url.form_decode("a+b%20c"), "a b c");
}

function test_url_decode_keeps_plus(): test.TestOutcome {
  return test.assert_eq(url.decode("a+b"), "a+b");
}

function test_form_encode_space(): test.TestOutcome {
  return test.assert_eq(url.form_encode("a b/c"), "a+b%2Fc");
}

function test_form_roundtrip(): test.TestOutcome {
  return test.assert_eq(
    url.form_decode(url.form_encode("hello world & q=1")),
    "hello world & q=1",
  );
}

function test_query_encode(): test.TestOutcome {
  let pairs: (string, string)[] = [("q", "a b"), ("n", "1")];
  return test.assert_eq(url.query_encode(pairs), "q=a+b&n=1");
}

function test_query_encode_edges(): test.TestOutcome {
  let many: (string, string)[] = [("k1", "v1"), ("k2", "v&2"), ("k3", "café")];
  let empties: (string, string)[] = [("", ""), ("x", "")];
  return test.assert_true(
    url.query_encode(many) == "k1=v1&k2=v%262&k3=caf%C3%A9"
      && url.query_encode(empties) == "=&x="
      && url.query_encode([("only", "one value")]) == "only=one+value",
  );
}

function test_query_parse_plus(): test.TestOutcome {
  let m: Map[string, string[]] = url.query_parse("q=a+b");
  match (m.get("q")) {
    Some(arr) => {
      return test.assert_eq(arr[0], "a b");
    },
    None => {
      return test.fail("expected key q");
    }
  }
}

function test_query_get(): test.TestOutcome {
  match (url.query_get("a=1&b=2", "b")) {
    Some(v) => {
      if (v != "2") {
        return test.fail("b=2");
      }
    },
    None => {
      return test.fail("expected b");
    }
  }
  match (url.query_get("a=1&a=2", "a")) {
    Some(v) => {
      if (v != "1") {
        return test.fail("first a");
      }
    },
    None => {
      return test.fail("expected a");
    }
  }
  match (url.query_get("a%20b=c+d", "a b")) {
    Some(v) => {
      return test.assert_eq(v, "c d");
    },
    None => {
      return test.fail("expected decoded key");
    }
  }
}

function test_query_get_missing(): test.TestOutcome {
  match (url.query_get("a=1", "z")) {
    Some(v) => {
      return test.fail("unexpected value");
    },
    None => {}
  }
  match (url.query_get("", "a")) {
    Some(v) => {
      return test.fail("empty query has no keys");
    },
    None => {
      return test.pass();
    }
  }
}

function test_query_has_and_all(): test.TestOutcome {
  if (!url.query_has("a=1&b=2", "b") || url.query_has("a=1", "z")) {
    return test.fail("has");
  }
  let all: string[] = url.query_get_all("a=1&b=2&a=3", "a");
  if (all.len() != 2 || all[0] != "1" || all[1] != "3") {
    return test.fail("get_all order");
  }
  return test.assert_eq(url.query_get_all("a=1", "z").len(), 0);
}

function __parse_host_port(s: string): string {
  match (url.parse(s)) {
    Ok(u) => {
      return u.host + "|" + u.port.to_string();
    },
    Err(e) => {
      return e.message();
    }
  }
}

function bad_host(s: string): string {
  return "\"" + s + "\" has an invalid host";
}

function test_parse_userinfo(): test.TestOutcome {
  if (__parse_host_port("http://user:pw@host:8080/p") != "host|8080") {
    return test.fail("userinfo not stripped");
  }
  return test.assert_eq(__parse_host_port("http://a@b@host/p"), "host|0");
}

function test_parse_ipv6(): test.TestOutcome {
  if (__parse_host_port("http://[::1]:8080/x") != "::1|8080") {
    return test.fail("[::1]:8080");
  }
  if (__parse_host_port("http://[::1]/x") != "::1|0") {
    return test.fail("[::1]");
  }
  return test.assert_eq(
    __parse_host_port("http://user@[2001:db8::1]:443/x"),
    "2001:db8::1|443",
  );
}

function test_parse_ipv6_malformed(): test.TestOutcome {
  if (__parse_host_port("http://[::1/x") != bad_host("http://[::1/x")) {
    return test.fail("unterminated");
  }
  if (__parse_host_port("http://[]/x") != bad_host("http://[]/x")) {
    return test.fail("empty brackets");
  }
  if (__parse_host_port("http://[g::1]/x") != bad_host("http://[g::1]/x")) {
    return test.fail("non-hex byte");
  }
  return test.assert_eq(__parse_host_port("http://[::1]junk:80/x"), bad_host("http://[::1]junk:80/x"));
}

function test_parse_port(): test.TestOutcome {
  if (__parse_host_port("http://host:65535/") != "host|65535") {
    return test.fail("max port");
  }
  if (__parse_host_port("http://host:99999/") != "\"http://host:99999/\" has an invalid port") {
    return test.fail("port overflow");
  }
  if (__parse_host_port("http://host:abc/") != "\"http://host:abc/\" has an invalid port") {
    return test.fail("non-digit port");
  }
  return test.assert_eq(__parse_host_port("http://host:/p"), "host|0");
}

function test_parse_host_shape(): test.TestOutcome {
  if (__parse_host_port("http://ho[st/x") != bad_host("http://ho[st/x")) {
    return test.fail("bracket in reg-name");
  }
  if (__parse_host_port("http://a%20b.example/x") != "a%20b.example|0") {
    return test.fail("pct-encoded reg-name");
  }
  return test.assert_eq(__parse_host_port("file:///etc/hosts"), "|0");
}

function test_parse_scheme_anchored(): test.TestOutcome {
  match (url.parse("/redirect?to=http://evil.example")) {
    Ok(u) => {
      if (u.scheme != "" || u.path != "/redirect"
        || u.query != "to=http://evil.example") {
        return test.fail("nested URL leaked into the scheme");
      }
    },
    Err(_) => {
      return test.fail("relative path expected Ok");
    }
  }
  match (url.parse("ws+x-1.y://h/p")) {
    Ok(u) => {
      return test.assert_eq(u.scheme, "ws+x-1.y");
    },
    Err(_) => {
      return test.fail("valid scheme punctuation expected Ok");
    }
  }
}

function test_decode_ill_formed_is_replacement(): test.TestOutcome {
  let fffd: string = utf8.encode(65533 as char);
  if (url.decode("a%FFb") != "a" + fffd + "b") {
    return test.fail("url.decode %FF");
  }
  if (url.form_decode("a%C3+b") != "a" + fffd + " b") {
    return test.fail("form_decode %C3");
  }
  return test.assert_eq(url.decode("%C3%A9"), "é");
}

function test_decode_bytes_keeps_the_bytes(): test.TestOutcome {
  let bs: u8[] = url.decode_bytes("a%FFb");
  if (bs.len() != 3 || bs[1] as i32 != 255) {
    return test.fail("url.decode_bytes");
  }
  let fs: u8[] = url.form_decode_bytes("%00+");
  return test.assert_true(fs.len() == 2 && fs[0] as i32 == 0 && fs[1] as i32 == 32);
}

function main(): i32 {
  let r: test.TestRunner = test.new("std/url");
  r = r.it("encode space", test_encode_space);
  r = r.it("encode unreserved", test_encode_unreserved);
  r = r.it("encode reserved", test_encode_reserved);
  r = r.it("decode space", test_decode_space);
  r = r.it("decode lowercase hex", test_decode_lowercase_hex);
  r = r.it("decode truncated escape", test_decode_truncated);
  r = r.it("round-trip", test_roundtrip);
  r = r.it("parse full URL", test_parse_full);
  r = r.it("parse minimal URL", test_parse_minimal);
  r = r.it("parse delimiter order", test_parse_delimiter_order);
  r = r.it("parse empty is None", test_parse_empty);
  r = r.it("form_decode plus", test_form_decode_plus);
  r = r.it("url.decode keeps plus", test_url_decode_keeps_plus);
  r = r.it("form_encode space", test_form_encode_space);
  r = r.it("form round-trip", test_form_roundtrip);
  r = r.it("query_encode", test_query_encode);
  r = r.it("query_encode edges", test_query_encode_edges);
  r = r.it("query_parse plus", test_query_parse_plus);
  r = r.it("query_get", test_query_get);
  r = r.it("query_get missing", test_query_get_missing);
  r = r.it("query_has + get_all", test_query_has_and_all);
  r = r.it("parse userinfo", test_parse_userinfo);
  r = r.it("parse IPv6 literal", test_parse_ipv6);
  r = r.it("parse IPv6 malformed", test_parse_ipv6_malformed);
  r = r.it("parse port validation", test_parse_port);
  r = r.it("parse host shape", test_parse_host_shape);
  r = r.it("parse scheme anchored", test_parse_scheme_anchored);
  r = r.it("decode ill-formed is U+FFFD", test_decode_ill_formed_is_replacement);
  r = r.it("decode_bytes keeps the bytes", test_decode_bytes_keeps_the_bytes);
  r = r.it("resolve normal references", test_resolve_normal);
  r = r.it("resolve dot segments", test_resolve_dots);
  r = r.it("resolve keeps the base query and port", test_resolve_base_parts);
  r = r.it("resolve refuses a base without a scheme", test_resolve_no_scheme);
  r = r.it("remove dot segments", test_remove_dot_segments);
  return r.finish();
}
