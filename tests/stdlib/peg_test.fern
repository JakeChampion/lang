import "std/test";
import "std/peg";

function test_lit_match(): test.TestOutcome {
  let Ok(r) = peg.peg_match_pattern(PLit("hello"), "hello world") else {
    return test.fail("expected match");
  };
  return test.assert_eq(r.pos, 5);
}

function test_furthest_failure_pos(): test.TestOutcome {
  match (peg.peg_match_pattern(PSeq([PLit("hel"), PLit("lo")]), "help")) {
    Ok(_) => {
      return test.fail("should not match");
    },
    Err(e) => {
      return test.assert_eq(e.furthest, 3);
    }
  }
}

function test_ordered_choice_first_wins(): test.TestOutcome {
  let p: peg.Pattern = PChoice([PLit("a"), PLit("ab")]);
  let Ok(r) = peg.peg_match_pattern(p, "ab") else {
    return test.fail("expected match");
  };
  return test.assert_eq(r.pos, 1);
}

function test_star_greedy(): test.TestOutcome {
  let Ok(r) = peg.peg_match_pattern(PStar(peg.peg_digit()), "1234x") else {
    return test.fail("star should always succeed");
  };
  return test.assert_eq(r.pos, 4);
}

function test_star_nullable_terminates(): test.TestOutcome {
  let Ok(r) = peg.peg_match_pattern(PStar(POpt(PLit("x"))), "yyy") else {
    return test.fail("nullable star should succeed");
  };
  return test.assert_eq(r.pos, 0);
}

function test_plus_requires_one(): test.TestOutcome {
  return test.assert_false(ok(peg.peg_match_pattern(PPlus(peg.peg_digit()), "x1")));
}

function test_not_lookahead(): test.TestOutcome {
  let kw: peg.Pattern = PSeq([PLit("if"), PNot(peg.peg_alnum())]);
  if (ok(peg.peg_match_pattern(kw, "iffy"))) {
    return test.fail("`iffy` should not match");
  }
  let Ok(hit) = peg.peg_match_pattern(kw, "if (x)") else {
    return test.fail("`if (` should match");
  };
  return test.assert_eq(hit.pos, 2);
}

function test_and_lookahead_zero_width(): test.TestOutcome {
  let p: peg.Pattern = PSeq([PAnd(PLit("ab")), PCap("all", PPlus(peg.peg_alpha()))]);
  let Ok(r) = peg.peg_match_pattern(p, "abc") else {
    return test.fail("expected match");
  };
  match (r.caps.get("all")) {
    Some(v) => {
      return test.assert_eq(v, "abc");
    },
    None => {
      return test.fail("missing capture");
    }
  }
}

function test_capture_last_wins(): test.TestOutcome {
  let word: peg.Pattern = PSeq([PCap("w", PPlus(peg.peg_alpha())), PStar(PSet(" "))]);
  let Ok(r) = peg.peg_match_pattern(PStar(word), "one two three") else {
    return test.fail("expected match");
  };
  match (r.caps.get("w")) {
    Some(v) => {
      return test.assert_eq(v, "three");
    },
    None => {
      return test.fail("missing capture");
    }
  }
}

function test_capture_backtrack_discarded(): test.TestOutcome {
  let p: peg.Pattern = PChoice([
    PSeq([PCap("bad", PLit("ab")), PLit("X")]),
    PCap("good", PLit("abc")),
  ]);
  let Ok(r) = peg.peg_match_pattern(p, "abc") else {
    return test.fail("expected match");
  };
  if (r.caps.contains("bad")) {
    return test.fail("backtracked capture leaked");
  }
  return test.assert_true(r.caps.contains("good"));
}

function test_recursive_grammar_balanced(): test.TestOutcome {
  let rules: Map[string, peg.Pattern] = map_new(4);
  rules = rules.insert("b", PChoice([
    PSeq([PLit("("), PRef("b"), PLit(")"), PRef("b")]),
    PLit(""),
  ]));
  rules = rules.insert("all", PSeq([PRef("b"), PEof]));
  let Ok(g) = peg.peg_grammar(rules, "all") else {
    return test.fail("grammar should build");
  };
  if (!ok(peg.peg_match(g, "(()(()))"))) {
    return test.fail("balanced should match");
  }
  if (ok(peg.peg_match(g, "(()"))) {
    return test.fail("unbalanced should fail");
  }
  return test.pass();
}

function test_grammar_validation(): test.TestOutcome {
  let rules: Map[string, peg.Pattern] = map_new(4);
  rules = rules.insert("a", PRef("missing"));
  match (peg.peg_grammar(rules, "nope")) {
    Ok(g1) => {
      return test.fail("unknown start should Err");
    },
    Err(e1) => {
      if (e1.rule != "nope") {
        return test.fail("wrong start error: " + e1.message());
      }
    }
  }
  match (peg.peg_grammar(rules, "a")) {
    Ok(g2) => {
      return test.fail("dangling PRef should Err");
    },
    Err(e2) => {
      return test.assert_eq(e2.message(), "peg: unknown rule \"missing\"");
    }
  }
}

function test_empty_rule_name(): test.TestOutcome {
  let rules: Map[string, peg.Pattern] = map_new(2);
  rules = rules.insert("start", PRef(""));
  match (peg.peg_grammar(rules, "start")) {
    Ok(_) => {
      return test.fail("a missing empty-name rule should Err");
    },
    Err(e) => {
      if (e.message() != "peg: unknown rule \"\"") {
        return test.fail("wrong error: " + e.message());
      }
    }
  }
  rules = rules.insert("", PLit("x"));
  let Ok(g) = peg.peg_grammar(rules, "start") else {
    return test.fail("a present empty-name rule should be valid");
  };
  let Ok(m) = peg.peg_match(g, "x") else {
    return test.fail("expected the empty-name rule to match");
  };
  return test.assert_eq(m.pos, 1);
}

function test_left_recursion_fails_fast(): test.TestOutcome {
  let rules: Map[string, peg.Pattern] = map_new(2);
  rules = rules.insert("l", PSeq([PRef("l"), PLit("a")]));
  let Ok(g) = peg.peg_grammar(rules, "l") else {
    return test.fail("grammar should build");
  };
  return test.assert_false(ok(peg.peg_match(g, "aaa")));
}

function test_eof_rejects_trailing(): test.TestOutcome {
  let p: peg.Pattern = PSeq([PLit("ok"), PEof]);
  if (!ok(peg.peg_match_pattern(p, "ok"))) {
    return test.fail("exact input should match");
  }
  return test.assert_false(ok(peg.peg_match_pattern(p, "okay")));
}

function test_http_request_line(): test.TestOutcome {
  let sp: peg.Pattern = PLit(" ");
  let p: peg.Pattern = PSeq([
    PCap("method", PPlus(peg.peg_upper())),
    sp,
    PCap("path", PPlus(PNotSet(" "))),
    sp,
    PLit("HTTP/"),
    PCap("version", PSeq([peg.peg_digit(), PLit("."), peg.peg_digit()])),
    PEof,
  ]);
  let Ok(r) = peg.peg_match_pattern(p, "GET /users/42?tab=all HTTP/1.1") else {
    return test.fail("request line should match");
  };
  if (r.caps.get_or("method", "") != "GET") {
    return test.fail("bad method");
  }
  if (r.caps.get_or("path", "") != "/users/42?tab=all") {
    return test.fail("bad path");
  }
  return test.assert_eq(r.caps.get_or("version", ""), "1.1");
}

function test_config_line(): test.TestOutcome {
  let ws: peg.Pattern = PStar(PSet(" \t"));
  let p: peg.Pattern = PSeq([
    ws,
    PCap("key", PPlus(PChoice([peg.peg_alnum(), PSet("_.")]))),
    ws, PLit("="), ws,
    PCap("value", PStar(PNotSet("\n"))),
    PEof,
  ]);
  let Ok(r) = peg.peg_match_pattern(p, "  http.port =  8080") else {
    return test.fail("config line should match");
  };
  if (r.caps.get_or("key", "") != "http.port") {
    return test.fail("bad key");
  }
  return test.assert_eq(r.caps.get_or("value", ""), "8080");
}

function test_class_helpers(): test.TestOutcome {
  if (!ok(peg.peg_match_pattern(peg.peg_digit(), "7"))) {
    return test.fail("digit");
  }
  if (ok(peg.peg_match_pattern(peg.peg_digit(), "x"))) {
    return test.fail("digit x");
  }
  if (!ok(peg.peg_match_pattern(peg.peg_alpha(), "G"))) {
    return test.fail("alpha");
  }
  if (!ok(peg.peg_match_pattern(peg.peg_alnum(), "9"))) {
    return test.fail("alnum");
  }
  if (!ok(peg.peg_match_pattern(peg.peg_space(), "\t"))) {
    return test.fail("space");
  }
  if (!ok(peg.peg_match_pattern(peg.peg_lower(), "q"))) {
    return test.fail("lower");
  }
  if (!ok(peg.peg_match_pattern(peg.peg_upper(), "Q"))) {
    return test.fail("upper");
  }
  return test.pass();
}

function test_pattern_ref_without_grammar(): test.TestOutcome {
  return test.assert_false(ok(peg.peg_match_pattern(PRef("nowhere"), "x")));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("peg");
  r = r.it("literal match", test_lit_match);
  r = r.it("furthest failure position", test_furthest_failure_pos);
  r = r.it("ordered choice first wins", test_ordered_choice_first_wins);
  r = r.it("star greedy", test_star_greedy);
  r = r.it("nullable star terminates", test_star_nullable_terminates);
  r = r.it("plus requires one", test_plus_requires_one);
  r = r.it("negative lookahead", test_not_lookahead);
  r = r.it("positive lookahead zero-width", test_and_lookahead_zero_width);
  r = r.it("capture last wins", test_capture_last_wins);
  r = r.it("backtracked capture discarded", test_capture_backtrack_discarded);
  r = r.it("recursive balanced parens", test_recursive_grammar_balanced);
  r = r.it("grammar validation", test_grammar_validation);
  r = r.it("empty rule name", test_empty_rule_name);
  r = r.it("left recursion fails fast", test_left_recursion_fails_fast);
  r = r.it("eof rejects trailing", test_eof_rejects_trailing);
  r = r.it("http request line", test_http_request_line);
  r = r.it("config line", test_config_line);
  r = r.it("class helpers", test_class_helpers);
  r = r.it("ref without grammar", test_pattern_ref_without_grammar);
  return r.finish();
}

function ok(r: Result[peg.PegMatch, peg.PegError]): boolean {
  if let Ok(_) = r {
    return true;
  }
  return false;
}
