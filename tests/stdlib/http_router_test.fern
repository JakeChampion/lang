import "std/test";
import "std/http";
import "std/http/router";
import "std/platform";
import "std/json";
import "std/option";

// tests/stdlib/http_router_test.fern — std/http/router: the patterns it
// refuses and keeps, which route answers a request and with what status,
// the parameters a pattern binds, a handler failing with `?` on errors of
// more than one type, and a `use` chain of middleware over a route.

function answer(label: string): (HttpRequest, router.Params, platform.Host) => Result[HttpResponse, dyn http.ToResponse] {
  return (req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] => Ok(http.ok(label));
}

function echo_params(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  let out: string = "";
  let i: i32 = 0;
  while (i < params.names.len()) {
    out = out + params.names[i] + "=" + params.values[i] + ";";
    i = i + 1;
  }
  return Ok(http.ok(out));
}

function user_by_id(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  let id: i32 = params.int("id")?;
  let missing: string = params.param("nope")?;
  return Ok(http.ok("user " + id.to_string() + missing));
}

@derive(json.Json, json.FromJson)
struct Note { id: i32, text: string }

// A handler whose failures are of two types: the body's (`BodyError`) and
// the route's (`HttpError`), each boxed by `?` into the one error the
// handler answers.
function note_create(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  let n: Note = http.body_json[Note](req)?;
  if (n.id < 0) {
    return Err(http.fail(422, "a note's id is not negative"));
  }
  return Ok(http.json_of_status(201, n));
}

function fixture(): router.Router[platform.Host] {
  return router.new[platform.Host]().get("/users/{id}", answer("get user")).get("/users/me", answer("me")).post("/users", answer("create")).route("/users", answer("users any")).route("/files/{path...}", answer("file")).route("/static/", answer("static below")).route("/static/{$}", answer("static index")).delete("/users/{id}", answer("delete user"));
}

function status_of(r: router.Router[platform.Host], method: string, path: string): string {
  let resp: HttpResponse = r.handle(http.request(method, path), platform.host());
  if (resp.status == 200) {
    return resp.body_string();
  }
  match (resp.headers.get("allow")) {
    Some(allow) => {
      return resp.status.to_string() + " allow " + allow;
    },
    None => {
      return resp.status.to_string();
    }
  }
  return "";
}

function checked(r: router.Router[platform.Host]): string {
  match (r.check()) {
    Ok(_) => {
      return "accepted";
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function refused(pattern: string): string {
  return checked(router.new[platform.Host]().route(pattern, answer("x")));
}

function test_patterns_refused(): test.TestOutcome {
  let cases: string[] = ["users", "get /users", "GET users", "/a//b", "/a/{x...}/b", "/a/{$}/b", "/a/{}", "/a/{1x}", "/a/{x}/{x}", "/a/b{c}", "/a?x=1", "/a/b#top"];
  let got: string = "";
  for c in cases {
    got = got + refused(c) + "\n";
  }
  return test.assert_eq(got, "http router: pattern users: expected [METHOD ]/path\nhttp router: pattern get /users: expected [METHOD ]/path\nhttp router: pattern GET users: expected [METHOD ]/path\nhttp router: pattern /a//b: empty segment\nhttp router: pattern /a/{x...}/b: {name...} must be the last segment\nhttp router: pattern /a/{$}/b: {$} must be the last segment\nhttp router: pattern /a/{}: bad parameter name \nhttp router: pattern /a/{1x}: bad parameter name 1x\nhttp router: pattern /a/{x}/{x}: parameter x is bound twice\nhttp router: pattern /a/b{c}: a brace inside the segment b{c}\nhttp router: pattern /a?x=1: a query or fragment in the segment a?x=1\nhttp router: pattern /a/b#top: a query or fragment in the segment b#top\n");
}

function conflict(first: string, second: string): string {
  return checked(router.new[platform.Host]().route(first, answer("a")).route(second, answer("b")));
}

function test_conflicts(): test.TestOutcome {
  let got: string = conflict("GET /a", "GET /a") + "\n" + conflict("/a/{x}", "/{y}/b") + "\n" + conflict("GET /a/{x}", "HEAD /a/{x}") + "\n" + conflict("/a/{x}", "/a/b") + "\n" + conflict("/a/", "/a/b/{c}") + "\n" + conflict("/a/", "/a") + "\n" + conflict("GET /a", "POST /a") + "\n" + conflict("/a/{x}", "/a/{$}") + "\n" + conflict("/a/{x...}", "/a/{$}");
  return test.assert_eq(got, "http router: pattern GET /a conflicts with GET /a\nhttp router: pattern /{y}/b conflicts with /a/{x}\naccepted\naccepted\naccepted\naccepted\naccepted\naccepted\naccepted");
}

// A refusal is the first one, kept through every registration after it,
// and the router answers 500 naming it until it is fixed.
function test_a_refusal_is_kept(): test.TestOutcome {
  let r: router.Router[platform.Host] = router.new[platform.Host]().get("/ok", answer("ok")).route("/a//b", answer("x")).route("/a//b", answer("y")).get("/ok", answer("again"));
  let resp: HttpResponse = r.handle(http.request("GET", "/ok"), platform.host());
  let got: string = checked(r) + "|" + resp.status.to_string() + " " + resp.body_string() + "|" + checked(fixture());
  return test.assert_eq(got, "http router: pattern /a//b: empty segment|500 {\"type\":\"about:blank\",\"title\":\"Internal Server Error\",\"status\":500,\"detail\":\"http router: pattern /a//b: empty segment\"}|accepted");
}

function test_dispatch(): test.TestOutcome {
  let r: router.Router[platform.Host] = fixture();
  let got: string = status_of(r, "GET", "/users/42") + "|" + status_of(r, "GET", "/users/me") + "|" + status_of(r, "HEAD", "/users/me") + "|" + status_of(r, "POST", "/users") + "|" + status_of(r, "PUT", "/users") + "|" + status_of(r, "PUT", "/users/42") + "|" + status_of(r, "GET", "/users/") + "|" + status_of(r, "GET", "/nope") + "|" + status_of(r, "GET", "/users/42?x=1");
  return test.assert_eq(got, "get user|me|me|create|users any|405 allow GET, HEAD, DELETE|404|404|get user");
}

function test_rest_and_end(): test.TestOutcome {
  let r: router.Router[platform.Host] = fixture();
  let got: string = status_of(r, "GET", "/files/a/b.txt") + "|" + status_of(r, "GET", "/files/") + "|" + status_of(r, "GET", "/files") + "|" + status_of(r, "GET", "/static/") + "|" + status_of(r, "GET", "/static/css/x.css") + "|" + status_of(r, "GET", "/static");
  return test.assert_eq(got, "file|file|404|static index|static below|404");
}

function test_params(): test.TestOutcome {
  let r: router.Router[platform.Host] = router.new[platform.Host]().route("/{kind}/{id}/{rest...}", echo_params);
  let a: string = status_of(r, "GET", "/user s/100%41/a b/c");
  let b: string = status_of(r, "GET", "/x/y/");
  return test.assert_eq(a + "|" + b, "kind=user s;id=100%41;rest=a b/c;|kind=x;id=y;rest=;");
}

function test_typed_params(): test.TestOutcome {
  let r: router.Router[platform.Host] = router.new[platform.Host]().get("/users/{id}", user_by_id);
  let bad: HttpResponse = r.handle(http.request("GET", "/users/x1"), platform.host());
  let wide: HttpResponse = r.handle(http.request("GET", "/users/99999999999999999999"), platform.host());
  let unbound: HttpResponse = r.handle(http.request("GET", "/users/7"), platform.host());
  let got: string = bad.status.to_string() + " " + bad.body_string() + "|" + wide.status.to_string() + "|" + unbound.status.to_string() + " " + unbound.body_string();
  return test.assert_eq(got, "400 {\"type\":\"about:blank\",\"title\":\"Bad Request\",\"status\":400,\"detail\":\"path parameter id is not an integer: x1\"}|400|500 {\"type\":\"about:blank\",\"title\":\"Internal Server Error\",\"status\":500,\"detail\":\"the route binds no path parameter nope\"}");
}

function test_errors_of_two_types(): test.TestOutcome {
  let r: router.Router[platform.Host] = router.new[platform.Host]().post("/notes", note_create);
  let untyped: HttpResponse = r.handle(http.request("POST", "/notes").with_body("{}"), platform.host());
  let negative: HttpResponse = r.handle(http.request("POST", "/notes").with_json("{\"id\":-1,\"text\":\"x\"}"), platform.host());
  let made: HttpResponse = r.handle(http.request("POST", "/notes").with_json("{\"id\":7,\"text\":\"hi\"}"), platform.host());
  let ct: string = "";
  match (made.headers.get("content-type")) {
    Some(v) => {
      ct = v;
    },
    None => {}
  }
  let got: string = untyped.status.to_string() + "|" + negative.status.to_string() + " " + negative.body_string() + "|" + made.status.to_string() + " " + ct + " " + made.body_string();
  return test.assert_eq(got, "415|422 {\"type\":\"about:blank\",\"title\":\"Unprocessable Entity\",\"status\":422,\"detail\":\"a note's id is not negative\"}|201 application/json {\"id\":7,\"text\":\"hi\"}");
}

// stamped is a middleware: it tags the request for the handler and the
// response for the client, a failure's answer included.
function stamped(req: HttpRequest, plat: platform.Host, next: (HttpRequest) => Result[HttpResponse, dyn http.ToResponse]): Result[HttpResponse, dyn http.ToResponse] {
  let resp: HttpResponse = http.respond(next(req.with_header("x-request-id", "r-1")));
  return Ok(resp.with_header("x-request-id", "r-1"));
}

// gated is a middleware that stops the chain without a token.
function gated(req: HttpRequest, plat: platform.Host, next: (HttpRequest) => Result[HttpResponse, dyn http.ToResponse]): Result[HttpResponse, dyn http.ToResponse] {
  match (req.headers.get("x-token")) {
    Some(t) => {
      return next(req);
    },
    None => {
      return Err(http.fail(401, "no token"));
    }
  }
  return Err(http.fail(401, "no token"));
}

function whoami(req: HttpRequest, params: router.Params, plat: platform.Host): Result[HttpResponse, dyn http.ToResponse] {
  use req1 <- stamped(req, plat);
  use req2 <- gated(req1, plat);
  let who: string = req2.headers.get("x-request-id").ok_or(http.fail(500, "unstamped"))?;
  return Ok(http.ok("request " + who));
}

function test_middleware_chain(): test.TestOutcome {
  let r: router.Router[platform.Host] = router.new[platform.Host]().get("/whoami", whoami);
  let denied: HttpResponse = r.handle(http.request("GET", "/whoami"), platform.host());
  let allowed: HttpResponse = r.handle(http.request("GET", "/whoami").with_header("x-token", "t"), platform.host());
  let stamp: string = "";
  match (allowed.headers.get("x-request-id")) {
    Some(s) => {
      stamp = s;
    },
    None => {}
  }
  let denied_stamp: string = "";
  match (denied.headers.get("x-request-id")) {
    Some(s) => {
      denied_stamp = s;
    },
    None => {}
  }
  let got: string = denied.status.to_string() + " " + denied.body_string() + " " + denied_stamp + "|" + allowed.status.to_string() + " " + allowed.body_string() + " " + stamp;
  return test.assert_eq(got, "401 {\"type\":\"about:blank\",\"title\":\"Unauthorized\",\"status\":401,\"detail\":\"no token\"} r-1|200 request r-1 r-1");
}

function test_handler_closure(): test.TestOutcome {
  let h: (HttpRequest, platform.Host) => HttpResponse = fixture().handler();
  return test.assert_eq(h(http.request("GET", "/users/me"), platform.host()).body_string(), "me");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/http/router");
  r = r.it("patterns refused", test_patterns_refused);
  r = r.it("conflicts", test_conflicts);
  r = r.it("a refusal is kept", test_a_refusal_is_kept);
  r = r.it("dispatch", test_dispatch);
  r = r.it("the rest and the end", test_rest_and_end);
  r = r.it("parameters", test_params);
  r = r.it("typed parameters", test_typed_params);
  r = r.it("errors of two types", test_errors_of_two_types);
  r = r.it("a middleware chain", test_middleware_chain);
  r = r.it("the handler closure", test_handler_closure);
  return r.finish();
}
