import "std/test";
import "std/u32" as u32m;
import "std/u64" as u64m;

function test_u32_basic(): test.TestOutcome {
  if ((4 as u32).midpoint(6 as u32) != 5 as u32) {
    return test.fail("4,6");
  }
  if ((2 as u32).midpoint(4 as u32) != 3 as u32) {
    return test.fail("2,4");
  }
  return test.assert_true((7 as u32).midpoint(7 as u32) == 7 as u32);
}

function test_u32_no_overflow(): test.TestOutcome {
  if ((4294967295 as u32).midpoint(4294967293 as u32) != 4294967294 as u32) {
    return test.fail("near MAX");
  }
  return test.assert_true((3000000000 as u32).midpoint(3000000002 as u32) == 3000000001 as u32);
}

function test_u64_basic(): test.TestOutcome {
  return test.assert_true((4 as u64).midpoint(6 as u64) == 5 as u64);
}

function test_u64_no_overflow(): test.TestOutcome {
  if ((10000000000 as u64).midpoint(10000000000 as u64) != 10000000000 as u64) {
    return test.fail("large equal");
  }
  return test.assert_true((10000000000 as u64).midpoint(10000000004 as u64) == 10000000002 as u64);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/uint midpoint");
  r = r.it("u32 basic", test_u32_basic);
  r = r.it("u32 no overflow", test_u32_no_overflow);
  r = r.it("u64 basic", test_u64_basic);
  r = r.it("u64 no overflow", test_u64_no_overflow);
  return r.finish();
}
