import "std/test";
import "std/quic/packet";
import "std/tls/keyschedule";
import "std/hex";
import "std/codec";
import "std/i64";
import "core/int";

// tests/stdlib/quic_packet_test.fern — std/quic/packet against RFC 9001
// Appendix A: the Initial keys of A.1, the client and server Initial packets
// of A.2 and A.3 sealed byte for byte and opened back, the Retry of A.4,
// the ChaCha20-Poly1305 short header of A.5, and RFC 9000 Appendix A's
// packet number examples; then the headers a datagram can hold.

function dcid(): u8[] {
  return __codec_bytes(hex.decode("8394c8f03e515708"));
}

function shown_keys(k: packet.Keys): string {
  return hex.encode(k.key) + " " + hex.encode(k.iv) + " " + hex.encode(k.hp);
}

function test_initial_keys(): test.TestOutcome {
  let got: string = hex.encode(packet.initial_secret(dcid(), true)) + "\n" + shown_keys(packet.initial_keys(dcid(), true)) + "\n" + hex.encode(packet.initial_secret(dcid(), false)) + "\n" + shown_keys(packet.initial_keys(dcid(), false));
  return test.assert_eq(got, "c00cf151ca5be075ed0ebfb5c80323c42d6b7db67881289af4008f1f6c357aea\n1f369613dd76d5467730efcbe3b1a22d fa044b2f42a3fd3b46fb255c 9f50449e04a0e810283a1e9933adedd2\n3c199828fd139efd216c155ad844cc81fb82fa8d7446fa7d78be803acdda951b\ncf3a5331653c364c88f0f379b6067e37 0ac1493ca1905853b0bba03e c206b8d9b9f0f37644430b490eeaa314");
}

function zeros(n: i32): u8[] {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(0 as u8);
    i = i + 1;
  }
  return out;
}

function client_payload(): u8[] {
  return __codec_bytes(hex.decode("")).concat(zeros(917));
}

function client_packet(): string {
  return "";
}

// opened parses the packet at the start of `wire` and opens it under `k`,
// as text: what the header said and the packet number and payload length.
function opened(wire: u8[], k: packet.Keys, largest: i64): string {
  match (packet.parse(wire, 0, 8)) {
    Ok(h) => {
      match (packet.open(wire, h, k, largest)) {
        Ok(o) => {
          return "dcid " + hex.encode(h.dcid) + " scid " + hex.encode(h.scid) + " end " + int.int_to_string(h.end) + " pn " + o.pn.to_string() + " payload " + int.int_to_string(o.payload.len()) + " reserved " + o.reserved_ok.to_string();
        },
        Err(e) => {
          return "open: " + e;
        }
      }
    },
    Err(e) => {
      return "parse: " + e;
    }
  }
  return "";
}

function test_client_initial(): test.TestOutcome {
  let k: packet.Keys = packet.initial_keys(dcid(), true);
  let sealed: u8[] = packet.seal_long(packet.Long { kind: packet.Initial, dcid: dcid(), scid: [], token: [], pn: 2 as i64, pn_len: 4 }, client_payload(), k);
  let same: boolean = hex.encode(sealed) == client_packet();
  let back: string = opened(__codec_bytes(hex.decode(client_packet())), k, 0 - 1 as i64);
  return test.assert_eq(same.to_string() + " " + int.int_to_string(sealed.len()) + " | " + back, "true 1200 | dcid 8394c8f03e515708 scid  end 1200 pn 2 payload 1162 reserved true");
}

function test_server_initial(): test.TestOutcome {
  let k: packet.Keys = packet.initial_keys(dcid(), false);
  let payload: u8[] = __codec_bytes(hex.decode("02000000000600405a020000560303eefce7f7b37ba1d1632e96677825ddf73988cfc79825df566dc5430b9a045a1200130100002e00330024001d00209d3c940d89690b84d08a60993c144eca684d1081287c834d5311bcf32bb9da1a002b00020304"));
  let want: string = "cf000000010008f067a5502a4262b5004075c0d95a482cd0991cd25b0aac406a5816b6394100f37a1c69797554780bb38cc5a99f5ede4cf73c3ec2493a1839b3dbcba3f6ea46c5b7684df3548e7ddeb9c3bf9c73cc3f3bded74b562bfb19fb84022f8ef4cdd93795d77d06edbb7aaf2f58891850abbdca3d20398c276456cbc42158407dd074ee";
  let sealed: u8[] = packet.seal_long(packet.Long { kind: packet.Initial, dcid: [], scid: __codec_bytes(hex.decode("f067a5502a4262b5")), token: [], pn: 1 as i64, pn_len: 2 }, payload, k);
  return test.assert_eq(hex.encode(sealed) + "\n" + opened(sealed, k, 0 as i64), want + "\ndcid  scid f067a5502a4262b5 end 135 pn 1 payload 99 reserved true");
}

// A.5: a short header under ChaCha20-Poly1305, whose packet number is
// recovered from three bytes.
function test_chacha20_short(): test.TestOutcome {
  let k: packet.Keys = packet.keys(keyschedule.ChaCha20Poly1305Sha256, __codec_bytes(hex.decode("9ac312a7f877468ebe69422748ad00a15443f18203a07d6060f688f30f21632b")));
  let sealed: u8[] = packet.seal_short([], 654360564 as i64, 3, false, false, [1 as u8], k);
  let back: string = "";
  match (packet.parse(sealed, 0, 0)) {
    Ok(h) => {
      match (packet.open(sealed, h, k, 654360563 as i64)) {
        Ok(o) => {
          back = o.pn.to_string() + " " + hex.encode(o.payload);
        },
        Err(e) => {
          back = e;
        }
      }
    },
    Err(e) => {
      back = e;
    }
  }
  return test.assert_eq(shown_keys(k) + "\n" + hex.encode(sealed) + "\n" + back, "c6d98ff3441c3fe1b2182094f69caa2ed4b716b65488960a7a984979fb23e1c8 e0459b3474bdd0e44a41c144 25a282b9e82f06f21f488917a4fc8f1b73573685608597d0efcb076b0ab7a7a4\n4cfe4189655e5cd55c41f69080575d7999c25a5bfb\n654360564 01");
}

function test_retry(): test.TestOutcome {
  let r: u8[] = packet.retry([], __codec_bytes(hex.decode("f067a5502a4262b5")), dcid(), "token".bytes());
  let got: string = hex.encode(r) + " " + packet.retry_valid(r, dcid()).to_string() + " " + packet.retry_valid(r, __codec_bytes(hex.decode("8394c8f03e515709"))).to_string();
  match (packet.parse(r, 0, 8)) {
    Ok(h) => {
      got = got + " | " + string_from_bytes_unchecked(h.token) + " " + hex.encode(h.tag) + " " + hex.encode(h.scid);
    },
    Err(e) => {
      got = got + " | " + e;
    }
  }
  return test.assert_eq(got, "ff000000010008f067a5502a4262b5746f6b656e04a265ba2eff4d829058fb3f0f2496ba true false | token 04a265ba2eff4d829058fb3f0f2496ba f067a5502a4262b5");
}

// RFC 9000 A.2 and A.3.
function test_packet_numbers(): test.TestOutcome {
  let got: string = int.int_to_string(packet.pn_len(11291906 as i64, 11266227 as i64)) + " " + int.int_to_string(packet.pn_len(11331838 as i64, 11266227 as i64)) + " " + int.int_to_string(packet.pn_len(0 as i64, 0 - 1 as i64)) + " " + packet.decode_pn(2821665002 as i64, 39730 as i64, 16).to_string() + " " + packet.decode_pn(0 - 1 as i64, 0 as i64, 8).to_string() + " " + packet.decode_pn(255 as i64, 1 as i64, 8).to_string();
  return test.assert_eq(got, "2 3 1 2821692210 0 257");
}

function test_version_negotiation(): test.TestOutcome {
  let probe: u8[] = __codec_bytes(hex.decode("c0" + "1a2a3a4a" + "04" + "01020304" + "02" + "0506" + "0000000000000000000000000000000000000000"));
  let got: string = "";
  match (packet.parse(probe, 0, 8)) {
    Ok(h) => {
      let vn: u8[] = packet.version_negotiation(h);
      got = hex.encode(vn);
      match (packet.parse(vn, 0, 8)) {
        Ok(back) => {
          match (back.kind) {
            packet.VersionNegotiation => {
              got = got + " offers " + back.versions[0].to_string() + " to " + hex.encode(back.dcid);
            },
            _ => {
              got = got + " not version negotiation";
            }
          }
        },
        Err(e) => {
          got = got + " " + e;
        }
      }
    },
    Err(e) => {
      got = e;
    }
  }
  return test.assert_eq(got, "c000000000020506040102030400000001 offers 1 to 0506");
}

// Two packets in one datagram: each header's `end` is where the next starts.
function test_coalesced(): test.TestOutcome {
  let ki: packet.Keys = packet.initial_keys(dcid(), false);
  let kh: packet.Keys = packet.keys(keyschedule.Aes128GcmSha256, zeros(32));
  let a: u8[] = packet.seal_long(packet.Long { kind: packet.Initial, dcid: dcid(), scid: __codec_bytes(hex.decode("0102")), token: [], pn: 0 as i64, pn_len: 1 }, [1 as u8], ki);
  let b: u8[] = packet.seal_long(packet.Long { kind: packet.Handshake, dcid: dcid(), scid: __codec_bytes(hex.decode("0102")), token: [], pn: 7 as i64, pn_len: 1 }, [1 as u8, 1 as u8], kh);
  let datagram: u8[] = a.concat(b);
  let got: string = "";
  match (packet.parse(datagram, 0, 8)) {
    Ok(h1) => {
      got = int.int_to_string(h1.end);
      match (packet.parse(datagram, h1.end, 8)) {
        Ok(h2) => {
          match (packet.open(datagram, h2, kh, 6 as i64)) {
            Ok(o) => {
              got = got + " handshake pn " + o.pn.to_string() + " " + hex.encode(o.payload) + " end " + int.int_to_string(h2.end);
            },
            Err(e) => {
              got = got + " " + e;
            }
          }
        },
        Err(e) => {
          got = got + " " + e;
        }
      }
    },
    Err(e) => {
      got = e;
    }
  }
  return test.assert_eq(got + " of " + int.int_to_string(datagram.len()), int.int_to_string(a.len()) + " handshake pn 7 010100 end " + int.int_to_string(datagram.len()) + " of " + int.int_to_string(datagram.len()));
}

// A key update derives new AEAD keys; the old ones no longer open the new
// packets, and header protection is unchanged.
function test_key_update(): test.TestOutcome {
  let k0: packet.Keys = packet.keys(keyschedule.Aes128GcmSha256, zeros(32));
  let k1: packet.Keys = k0.updated();
  let sealed: u8[] = packet.seal_short(__codec_bytes(hex.decode("aabb")), 9 as i64, 1, true, false, [1 as u8, 1 as u8, 1 as u8], k1);
  let with_new: string = "";
  let with_old: string = "";
  match (packet.parse(sealed, 0, 2)) {
    Ok(h) => {
      match (packet.open(sealed, h, k1, 8 as i64)) {
        Ok(o) => {
          with_new = o.pn.to_string() + " phase " + o.key_phase.to_string();
        },
        Err(e) => {
          with_new = e;
        }
      }
      match (packet.open(sealed, h, k0, 8 as i64)) {
        Ok(_) => {
          with_old = "opened";
        },
        Err(e) => {
          with_old = e;
        }
      }
    },
    Err(e) => {
      with_new = e;
    }
  }
  let same_hp: boolean = hex.encode(k0.hp) == hex.encode(k1.hp);
  let new_key: boolean = hex.encode(k0.key) != hex.encode(k1.key);
  return test.assert_eq(with_new + " | " + with_old + " | " + same_hp.to_string() + " " + new_key.to_string(), "9 phase true | packet does not decrypt | true true");
}

function test_malformed(): test.TestOutcome {
  let got: string = "";
  let cases: string[] = ["", "00", "80", "c000000001", "c0000000011500", "c000000001080102030405060708", "c0000000010000004005", "c0000000010000000100", "f00000000100000102"];
  for c in cases {
    match (packet.parse(__codec_bytes(hex.decode(c)), 0, 8)) {
      Ok(h) => {
        got = got + "ok end " + int.int_to_string(h.end) + ";";
      },
      Err(e) => {
        got = got + e + ";";
      }
    }
  }
  return test.assert_eq(got, "first byte cut short;fixed bit not set;version cut short;destination connection id length cut short;destination connection id of 21 bytes;source connection id length cut short;packet of 5 bytes past the end of the datagram;ok end 10;retry without a token;");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/quic/packet");
  r = r.it("Initial keys (RFC 9001 A.1)", test_initial_keys);
  r = r.it("the client Initial (A.2)", test_client_initial);
  r = r.it("the server Initial (A.3)", test_server_initial);
  r = r.it("a ChaCha20-Poly1305 short header (A.5)", test_chacha20_short);
  r = r.it("Retry (A.4)", test_retry);
  r = r.it("packet numbers (RFC 9000 A.2, A.3)", test_packet_numbers);
  r = r.it("version negotiation", test_version_negotiation);
  r = r.it("coalesced packets", test_coalesced);
  r = r.it("key update", test_key_update);
  r = r.it("malformed headers", test_malformed);
  return r.finish();
}

// Decode a valid fixture. Report a malformed fixture before the test exits.
function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
