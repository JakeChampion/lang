import "std/test";
import "std/base32" as base32;
import "std/codec";
import "std/string";

function text(b: u8[]): string {
  return string_from_bytes_unchecked(b);
}

function test_encode_vectors(): test.TestOutcome {
  if (base32.encode("".bytes()) != "") {
    return test.fail("empty");
  }
  if (base32.encode("f".bytes()) != "MY======") {
    return test.fail("f");
  }
  if (base32.encode("fo".bytes()) != "MZXQ====") {
    return test.fail("fo");
  }
  if (base32.encode("foo".bytes()) != "MZXW6===") {
    return test.fail("foo");
  }
  if (base32.encode("foob".bytes()) != "MZXW6YQ=") {
    return test.fail("foob");
  }
  if (base32.encode("fooba".bytes()) != "MZXW6YTB") {
    return test.fail("fooba");
  }
  return test.assert_eq(base32.encode("foobar".bytes()), "MZXW6YTBOI======");
}

function test_decode_vectors(): test.TestOutcome {
  if (text(__codec_bytes(base32.decode("MY======"))) != "f") {
    return test.fail("f");
  }
  if (text(__codec_bytes(base32.decode("MZXW6==="))) != "foo") {
    return test.fail("foo");
  }
  return test.assert_eq(text(__codec_bytes(base32.decode("MZXW6YTBOI======"))), "foobar");
}

function test_roundtrip(): test.TestOutcome {
  let payload: string = "Hello, base32 World! 12345";
  return test.assert_eq(text(__codec_bytes(base32.decode(base32.encode(payload.bytes())))), payload);
}

function test_empty_decode(): test.TestOutcome {
  return test.assert_true(text(__codec_bytes(base32.decode(""))) == ""
    && base32.encode("".bytes()) == "");
}

function b32_opt(o: Result[u8[], codec.DecodeError], fb: string): string {
  match (o) {
    Ok(v) => {
      return text(v);
    },
    Err(_) => {
      return fb;
    }
  }
}

function b32_is_err(o: Result[u8[], codec.DecodeError]): boolean {
  match (o) {
    Ok(v) => {
      return false;
    },
    Err(_) => {
      return true;
    }
  }
}

function test_decode_checked_valid(): test.TestOutcome {
  if (b32_opt(base32.decode("MY======"), "X") != "f") {
    return test.fail("f");
  }
  if (b32_opt(base32.decode("MZXW6YTBOI======"), "X") != "foobar") {
    return test.fail("foobar");
  }
  return test.assert_eq(b32_opt(base32.decode(""), "X"), "");
}

function test_decode_checked_rejects(): test.TestOutcome {
  if (!b32_is_err(base32.decode("MY0====="))) {
    return test.fail("bad char");
  }
  if (!b32_is_err(base32.decode("MY====="))) {
    return test.fail("short pad");
  }
  return test.assert_true(b32_is_err(base32.decode("MY======X")));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/base32");
  r = r.it("encode vectors", test_encode_vectors);
  r = r.it("decode vectors", test_decode_vectors);
  r = r.it("roundtrip", test_roundtrip);
  r = r.it("empty", test_empty_decode);
  r = r.it("decode_checked valid", test_decode_checked_valid);
  r = r.it("decode_checked rejects", test_decode_checked_rejects);
  return r.finish();
}

function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
