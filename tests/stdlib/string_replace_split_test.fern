import "std/test";
import "std/string";

function test_replace(): test.TestOutcome {
  return test.assert_eq("a.b.c".replace(".", "-"), "a-b-c");
}

function test_replace_overlap(): test.TestOutcome {
  return test.assert_eq("aaa".replace("aa", "b"), "ba");
}

function test_replace_first(): test.TestOutcome {
  return test.assert_eq("a.b.c".replace_first(".", "-"), "a-b.c");
}

function test_replace_n(): test.TestOutcome {
  return test.assert_eq("a.b.c.d".replace_n(".", "-", 2), "a-b-c.d");
}

function test_replace_byte(): test.TestOutcome {
  return test.assert_eq_array("a-b-c".replace_byte(45, 95), "a_b_c".bytes());
}

function test_remove_all(): test.TestOutcome {
  return test.assert_eq("a,b,c".remove_all(","), "abc");
}

function test_without_byte(): test.TestOutcome {
  return test.assert_eq_array("hello".without_byte(108), "heo".bytes());
}

function test_without_chars(): test.TestOutcome {
  return test.assert_eq("hello world".without_chars("lo"), "he wrd");
}

function test_splitn(): test.TestOutcome {
  return test.assert_eq_array("a,b,c,d".splitn(",", 2), ["a", "b,c,d"]);
}

function test_splitn_under_cap(): test.TestOutcome {
  return test.assert_eq_array("a,b,c".splitn(",", 99), ["a", "b", "c"]);
}

function test_split_at(): test.TestOutcome {
  let p = "hello".split_at(2);
  return test.assert_true(p.0 == "he" && p.1 == "llo");
}

function test_split_at_clamp(): test.TestOutcome {
  let p = "hi".split_at(99);
  return test.assert_true(p.0 == "hi" && p.1 == "");
}

function test_to_acronym(): test.TestOutcome {
  return test.assert_eq("hello world foo".to_acronym(), "HWF");
}

function test_to_acronym_empty(): test.TestOutcome {
  return test.assert_eq("   ".to_acronym(), "");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/string replace + split");
  r = r.it("replace", test_replace);
  r = r.it("replace overlap", test_replace_overlap);
  r = r.it("replace_first", test_replace_first);
  r = r.it("replace_n", test_replace_n);
  r = r.it("replace_byte", test_replace_byte);
  r = r.it("remove_all", test_remove_all);
  r = r.it("without_byte", test_without_byte);
  r = r.it("without_chars", test_without_chars);
  r = r.it("splitn", test_splitn);
  r = r.it("splitn under cap", test_splitn_under_cap);
  r = r.it("split_at", test_split_at);
  r = r.it("split_at clamp", test_split_at_clamp);
  r = r.it("to_acronym", test_to_acronym);
  r = r.it("to_acronym empty", test_to_acronym_empty);
  return r.finish();
}
