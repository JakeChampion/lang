import "std/i32";
import "std/result";
import "std/test";
import "std/string";

function val(o: Option[i32], d: i32): i32 {
  match (o) {
    Some(v) => {
      return v;
    },
    None => {
      return d;
    }
  }
}

function test_hex(): test.TestOutcome {
  return test.assert_true(val(i32.parse_i32_radix("ff", 16).ok(), 0 - 1) == 255);
}

function test_binary(): test.TestOutcome {
  return test.assert_true(val(i32.parse_i32_radix("101", 2).ok(), 0 - 1) == 5);
}

function test_octal(): test.TestOutcome {
  return test.assert_true(val(i32.parse_i32_radix("777", 8).ok(), 0 - 1) == 511);
}

function test_base36(): test.TestOutcome {
  return test.assert_true(val(i32.parse_i32_radix("z", 36).ok(), 0 - 1) == 35);
}

function test_negative(): test.TestOutcome {
  return test.assert_true(val(i32.parse_i32_radix("-1a", 16).ok(), 0) == 0 - 26);
}

function test_plus_sign(): test.TestOutcome {
  return test.assert_true(val(i32.parse_i32_radix("+10", 10).ok(), 0 - 1) == 10);
}

function test_uppercase(): test.TestOutcome {
  // Digits are case-insensitive.
  return test.assert_true(val(i32.parse_i32_radix("FF", 16).ok(), 0 - 1) == 255);
}

function test_digit_ge_base(): test.TestOutcome {
  // '2' is not a valid base-2 digit.
  match (i32.parse_i32_radix("2", 2)) {
    Ok(v) => {
      return test.fail("expected None for digit >= base");
    },
    Err(_) => {
      return test.pass();
    }
  }
}

function test_bad_base(): test.TestOutcome {
  // Bases outside 2..36 → None.
  if (val(i32.parse_i32_radix("5", 1).ok(), 0 - 99) != 0 - 99) {
    return test.fail("base 1");
  }
  return test.assert_true(val(i32.parse_i32_radix("5", 37).ok(), 0 - 99) == 0 - 99);
}

function test_empty_and_lone_sign(): test.TestOutcome {
  if (val(i32.parse_i32_radix("", 10).ok(), 0 - 99) != 0 - 99) {
    return test.fail("empty");
  }
  return test.assert_true(val(i32.parse_i32_radix("-", 10).ok(), 0 - 99) == 0 - 99);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/string parse_int_radix");
  r = r.it("hex", test_hex);
  r = r.it("binary", test_binary);
  r = r.it("octal", test_octal);
  r = r.it("base36", test_base36);
  r = r.it("negative", test_negative);
  r = r.it("plus sign", test_plus_sign);
  r = r.it("uppercase", test_uppercase);
  r = r.it("digit >= base", test_digit_ge_base);
  r = r.it("bad base", test_bad_base);
  r = r.it("empty/lone sign", test_empty_and_lone_sign);
  return r.finish();
}
