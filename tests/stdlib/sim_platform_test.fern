import "std/unicode";
import "std/test";
import "std/platform";
import "std/sim";
import "std/sim_fetch";
import "std/sim_platform";
import "std/mock_platform";
import "std/fetch";
import "std/http";
import "std/time";
import "std/http/trace";
import "std/utf8";
import "std/string";
import "std/http/router";
import "std/http/accesslog";

const ORIGIN: string = "93.184.216.34";

const MS: i64 = 1000000;

function __net(d: sim.Sim): sim_fetch.Net {
  return sim_fetch.net(d).host("example.test", [ORIGIN]).listen(ORIGIN, 80, 5).route(ORIGIN, 80, "/", [sim_fetch.reply(200, "hi").after(20).kept()]);
}

function __plat(seed: i64): sim_platform.SimPlatform {
  let d: sim.Sim = sim.new(seed);
  return sim_platform.new(d, __net(d));
}

function __message(got: Result[HttpResponse, fetch.FetchError]): string {
  match (got) {
    Ok(resp) => {
      return "status " + resp.status.to_string();
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function handle(req: HttpRequest, plat: platform.Platform): HttpResponse {
  let region: string = "nowhere";
  match (plat.config("REGION")) {
    Some(r) => {
      region = r;
    },
    None => {}
  }
  let upstream: string = __message(plat.http(fetch.get("http://example.test/")));
  return http.ok(region + " " + plat.now_ms().to_string() + " " + upstream);
}

function test_config_and_secret_answer_what_was_set(): test.TestOutcome {
  let p: sim_platform.SimPlatform = __plat(1);
  match (p.config("REGION")) {
    Some(v) => {
      return test.fail("config before setting: " + v);
    },
    None => {}
  }
  match (p.secret("TOKEN")) {
    Some(v) => {
      return test.fail("secret before setting: " + v);
    },
    None => {}
  }
  p.config_set("REGION", "eu-west");
  p.secret_set("TOKEN", "s3cr3t");
  match (p.config("REGION")) {
    Some(v) => {
      if (v != "eu-west") {
        return test.fail("config: " + v);
      }
    },
    None => {
      return test.fail("config: None");
    }
  }
  match (p.secret("TOKEN")) {
    Some(v) => {
      if (v != "s3cr3t") {
        return test.fail("secret: " + v);
      }
    },
    None => {
      return test.fail("secret: None");
    }
  }
  return test.pass();
}

function test_env_answers_what_was_set(): test.TestOutcome {
  let p: sim_platform.SimPlatform = __plat(1);
  match (p.env("HOME")) {
    Some(v) => {
      return test.fail("env before setting: " + v);
    },
    None => {}
  }
  p.env_set("HOME", "/sim");
  match (p.env("HOME")) {
    Some(v) => {
      return test.assert_eq(v, "/sim");
    },
    None => {
      return test.fail("env: None");
    }
  }
  return test.pass();
}

function test_the_clock_is_the_simulations(): test.TestOutcome {
  let p: sim_platform.SimPlatform = __plat(1);
  if (p.now_ms() != 0 as i64) {
    return test.fail("now before anything: " + p.now_ms().to_string());
  }
  p.http(fetch.get("http://example.test/"));
  if (p.now_ms() != 25 as i64) {
    return test.fail("now after a 5 ms connect and a 20 ms answer: " + p.now_ms().to_string());
  }
  return test.assert_eq(p.elapsed_ns(), 25 as i64 * MS);
}

function test_randomness_is_the_seeds(): test.TestOutcome {
  let a: sim_platform.SimPlatform = __plat(7);
  let b: sim_platform.SimPlatform = __plat(7);
  let first: i32 = a.random_i32();
  if (first != b.random_i32()) {
    return test.fail("two sims from one seed drew differently");
  }
  let c: sim_platform.SimPlatform = __plat(7);
  c.random_i32();
  if (c.drv.rng_state() == __plat(7).drv.rng_state()) {
    return test.fail("a draw left the PRNG state where it was");
  }
  return test.pass();
}

function test_http_reaches_global_addresses_only(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim_fetch.Net = __net(d).host("internal.test", ["10.0.0.1"]).listen("10.0.0.1", 80, 1).route("10.0.0.1", 80, "/", [sim_fetch.reply(200, "secret")]);
  let p: sim_platform.SimPlatform = sim_platform.new(d, n);
  let open: string = __message(p.http(fetch.get("http://example.test/")));
  if (open != "status 200") {
    return test.fail("a global origin: " + open);
  }
  return test.assert_eq(__message(p.http(fetch.get("http://internal.test/"))), "blocked: 10.0.0.1 is not a global address");
}

function test_http_reaches_only_the_allow_list(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim_fetch.Net = __net(d).host("other.test", ["93.184.216.35"]).listen("93.184.216.35", 80, 1).route("93.184.216.35", 80, "/", [sim_fetch.reply(200, "other")]);
  match (fetch.allow(["example.test"])) {
    Ok(a) => {
      let p: sim_platform.SimPlatform = sim_platform.new(d, n).with_allow(a);
      let listed: string = __message(p.http(fetch.get("http://example.test/")));
      return test.assert_eq(listed + "|" + __message(p.http(fetch.get("http://other.test/"))), "status 200|blocked: other.test:80 is not on the allow-list");
    },
    Err(why) => {
      return test.fail(why);
    }
  }
  return test.fail("unreachable");
}

const PROXY: string = "10.0.0.9";

function test_http_goes_through_the_proxy_the_env_names(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim_fetch.Net = __net(d).listen(PROXY, 3128, 5).route(PROXY, 3128, "http://example.test/", [sim_fetch.reply(203, "via proxy")]);
  let p: sim_platform.SimPlatform = sim_platform.new(d, n);
  p.env_set("http_proxy", "http://" + PROXY + ":3128");
  let proxied: string = __message(p.http(fetch.get("http://example.test/")));
  p.env_set("no_proxy", "example.test");
  let direct: string = __message(p.http(fetch.get("http://example.test/")));
  if (proxied + "|" + direct != "status 203|status 200") {
    return test.fail(proxied + "|" + direct);
  }
  for c in p.calls() {
    if (c.name != "http") {
      return test.fail("call: " + c.name + " " + c.args);
    }
  }
  return test.assert_eq(n.connects(), 2);
}

function test_http_keeps_the_connection_for_the_next_request(): test.TestOutcome {
  let p: sim_platform.SimPlatform = __plat(1);
  p.http(fetch.get("http://example.test/"));
  p.http(fetch.get("http://example.test/"));
  return test.assert_eq(p.net.connects(), 1);
}

function test_a_secret_is_logged_by_name_only(): test.TestOutcome {
  let p: sim_platform.SimPlatform = __plat(1);
  p.secret_set("TOKEN", "s3cr3t");
  p.secret("TOKEN");
  let calls: mock_platform.MockCall[] = p.calls();
  if (calls.len() != 1) {
    return test.fail("calls: " + calls.len().to_string());
  }
  if (calls[0].name != "secret" || calls[0].args != "TOKEN") {
    return test.fail("call: " + calls[0].name + " " + calls[0].args);
  }
  for c in calls {
    if (c.args.contains("s3cr3t")) {
      return test.fail("the secret's value is in the call log");
    }
  }
  return test.pass();
}

function __until_cancelled(plat: platform.Platform): string {
  let steps: i32 = 0;
  while (!plat.cancelled() && steps < 100) {
    plat.sleep(time.duration_millis(10 as i64));
    steps = steps + 1;
  }
  match (plat.deadline()) {
    Some(at) => {
      return steps.to_string() + " steps, due at " + (at / MS).to_string() + " ms";
    },
    None => {
      return steps.to_string() + " steps, no deadline";
    }
  }
  return "";
}

function test_the_deadline_cancels_on_the_sims_clock(): test.TestOutcome {
  let bounded: string = __until_cancelled(__plat(1).with_deadline(35 as i64 * MS));
  if (bounded != "4 steps, due at 35 ms") {
    return test.fail("bounded: " + bounded);
  }
  return test.assert_eq(__until_cancelled(__plat(1)), "100 steps, no deadline");
}

function __sent_traceparent(n: sim_fetch.Net): string {
  let text: string = "";
  match (utf8.from_bytes(n.sent(n.sent_count() - 1))) {
    Some(t) => {
      text = t;
    },
    None => {
      return "<not utf-8>";
    }
  }
  for line in text.split("\r\n") {
    if (line.to_lower().starts_with("traceparent:")) {
      return line.drop(12).trim();
    }
  }
  return "";
}

function test_http_carries_the_span_upstream(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim_fetch.Net = __net(d);
  let span: trace.Context = trace.Context { trace_id: "4bf92f3577b34da6a3ce929d0e0e4736", span_id: "00f067aa0ba902b7", flags: 1, state: "" };
  let p: sim_platform.SimPlatform = sim_platform.new(d, n).with_trace(span);
  p.http(fetch.get("http://example.test/"));
  let sent: string = __sent_traceparent(n);
  if (!sent.starts_with("00-4bf92f3577b34da6a3ce929d0e0e4736-") || sent.ends_with("-00f067aa0ba902b7-01") || !sent.ends_with("-01")) {
    return test.fail("sent " + sent);
  }
  let own: string = "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01";
  p.http(fetch.get("http://example.test/").with_header("traceparent", own));
  return test.assert_eq(__sent_traceparent(n), own);
}

function test_a_handler_runs_over_the_simulation(): test.TestOutcome {
  let p: sim_platform.SimPlatform = __plat(1);
  p.config_set("REGION", "eu-west");
  let resp: HttpResponse = handle(http.request("GET", "/"), p);
  return test.assert_body(resp, "eu-west 25 status 200");
}

function __user(req: HttpRequest, params: router.Params, plat: sim_platform.SimPlatform): Result[HttpResponse, dyn http.ToResponse] {
  use logged <- accesslog.logged(req, plat);
  return Ok(http.ok("user " + params.values[0]));
}

function test_router_served_in_memory(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let server_plat: sim_platform.SimPlatform = sim_platform.new(d, sim_fetch.net(d));
  let h: (HttpRequest, sim_platform.SimPlatform) => HttpResponse = router.new[sim_platform.SimPlatform]().get("/users/{id}", __user).handler();
  let n: sim_fetch.Net = sim_fetch.net(d).host("api.test", [ORIGIN]).serve(ORIGIN, 80, (req: HttpRequest): HttpResponse => h(req, server_plat));
  let plat: sim_platform.SimPlatform = sim_platform.new(d, n);
  match (plat.http(fetch.get("http://api.test/users/7"))) {
    Ok(resp) => {
      if (resp.status != 200 || resp.body_string() != "user 7") {
        return test.fail(resp.status.to_string() + " " + resp.body_string());
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  match (plat.http(fetch.get("http://api.test/nope"))) {
    Ok(resp) => {
      if (resp.status != 404) {
        return test.fail("status " + resp.status.to_string());
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  let lines: string = "";
  for c in server_plat.calls() {
    if (c.name == "log") {
      lines = lines + c.args + "\n";
    }
  }
  if (!lines.contains("\"body\":\"GET /users/7 200\"") || lines.contains("/nope")) {
    return test.fail("access log: " + lines);
  }
  return test.assert_eq(n.connects(), 1);
}

function main(): i32 {
  let t: test.TestRunner = test.test_new("std/sim_platform");
  t = t.it("serves a router in memory", test_router_served_in_memory);
  t = t.it("config and secret answer what was set", test_config_and_secret_answer_what_was_set);
  t = t.it("env answers what was set", test_env_answers_what_was_set);
  t = t.it("the clock is the simulation's", test_the_clock_is_the_simulations);
  t = t.it("randomness is the seed's", test_randomness_is_the_seeds);
  t = t.it("http reaches global addresses only", test_http_reaches_global_addresses_only);
  t = t.it("http reaches only the allow-list", test_http_reaches_only_the_allow_list);
  t = t.it("http goes through the proxy the env names", test_http_goes_through_the_proxy_the_env_names);
  t = t.it("http keeps the connection for the next request", test_http_keeps_the_connection_for_the_next_request);
  t = t.it("a secret is logged by name only", test_a_secret_is_logged_by_name_only);
  t = t.it("a handler runs over the simulation", test_a_handler_runs_over_the_simulation);
  t = t.it("the deadline cancels on the sim's clock", test_the_deadline_cancels_on_the_sims_clock);
  t = t.it("http carries the span upstream", test_http_carries_the_span_upstream);
  return t.finish();
}
