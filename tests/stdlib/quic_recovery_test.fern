import "std/test";
import "std/quic/recovery";
import "std/quic/frames";
import "std/i64";
import "std/time";

const MS: i64 = 1000000;

const START: Instant = Instant { sec: 0, nsec: 0 };

function at_ns(ns: i64): Instant {
  return START.add(time.duration_nanos(ns));
}

function due_ns(r: recovery.Recovery): i64 {
  match (r.timer()) {
    Some(at) => {
      return at.since(START).as_nanos();
    },
    None => {
      return -1;
    }
  }
}

function sent(pn: i64, at: i64): recovery.Sent {
  return recovery.Sent { pn: pn, at: at_ns(at), size: 1200, ack_eliciting: true, in_flight: true, ect: true, resend: [] };
}

function ack(low: i64, high: i64): frames.Ack {
  return frames.Ack { delay: 0 as i64, ranges: [frames.AckRange { low: low, high: high }], ecn: None };
}

function pns(ps: recovery.Sent[]): string {
  let out = "";
  for p in ps {
    out = out + p.pn.to_string() + ",";
  }
  return out;
}

function sending(r: recovery.Recovery, from: i64, to: i64, at: i64): recovery.Recovery {
  let cur = r;
  let pn = from;
  while (pn <= to) {
    cur = cur.on_sent(recovery.APPLICATION, sent(pn, at));
    pn += 1;
  }
  return cur;
}

function acked(r: recovery.Recovery, a: frames.Ack, now: i64, largest: i64): recovery.Recovery {
  return r.on_ack(recovery.APPLICATION, a, time.DURATION_ZERO, at_ns(now), largest);
}

function test_rtt(): test.TestOutcome {
  let r = recovery.new(1200, true).confirmed();
  let before = r.pto(recovery.INITIAL).as_millis().to_string();
  r = sending(r, 0 as i64, 0 as i64, 0 as i64);
  r = acked(r, ack(0 as i64, 0 as i64), 100 * MS, 0 as i64);
  let first = r.smoothed().as_millis().to_string() + "/" + r.pto(recovery.INITIAL).as_millis().to_string();
  r = sending(r, 1 as i64, 1 as i64, 100 * MS);
  r = acked(r, ack(0 as i64, 1 as i64), 300 * MS, 1 as i64);
  return test.assert_eq(before + " | " + first + " | " + r.smoothed().as_millis().to_string(), "999 | 100/300 | 112");
}

function test_thresholds(): test.TestOutcome {
  let r = sending(recovery.new(1200, true).confirmed(), 0 as i64, 4 as i64, 0 as i64);
  let o = acked(r, ack(4 as i64, 4 as i64), 10 * MS, 4 as i64);
  let timer = due_ns(o);
  let later = o.on_timeout(at_ns(timer));
  let taken = later.outcome_taken();
  return test.assert_eq("acked " + pns(o.acked) + " lost " + pns(o.lost) + " timer " + (timer / 1000).to_string() + "us then acked " + pns(later.acked) + " lost " + pns(later.lost) + "; taken " + pns(taken.acked) + pns(taken.lost), "acked 4, lost 0,1, timer 11250us then acked  lost 2,3,; taken ");
}

function test_probe_timeout(): test.TestOutcome {
  let r = recovery.new(1200, true).on_sent(recovery.INITIAL, sent(0 as i64, 0 as i64));
  let t1 = due_ns(r);
  let o = r.on_timeout(at_ns(t1));
  let t2 = due_ns(o);
  let early = r.on_timeout(at_ns(t1 - 1));
  return test.assert_eq((t1 / MS).to_string() + "ms probe " + o.probe.to_string() + ", then " + (t2 / MS).to_string() + "ms; early " + early.probe.to_string(), "999ms probe 0, then 1998ms; early -1");
}

function test_window(): test.TestOutcome {
  let r = recovery.new(1200, true).confirmed();
  let start = r.window().to_string();
  r = sending(r, 0 as i64, 0 as i64, 0 as i64);
  r = acked(r, ack(0 as i64, 0 as i64), 20 * MS, 0 as i64);
  let grown = r.window().to_string();
  r = sending(r, 1 as i64, 4 as i64, 20 * MS);
  r = acked(r, ack(4 as i64, 4 as i64), 40 * MS, 4 as i64);
  let halved = r.window().to_string();
  let p = sending(recovery.new(1200, true).confirmed(), 0 as i64, 0 as i64, 0 as i64);
  p = acked(p, ack(0 as i64, 0 as i64), 10 * MS, 0 as i64);
  p = p.on_sent(recovery.APPLICATION, sent(1 as i64, 10 * MS)).on_sent(recovery.APPLICATION, sent(2 as i64, 900 * MS));
  p = sending(p, 3 as i64, 5 as i64, 900 * MS);
  p = acked(p, ack(5 as i64, 5 as i64), 910 * MS, 5 as i64);
  return test.assert_eq(start + " " + grown + " " + halved + " " + p.window().to_string(), "12000 13200 4800 0");
}

function marked(low: i64, high: i64, ce: i64): frames.Ack {
  return frames.Ack { delay: 0 as i64, ranges: [frames.AckRange { low: low, high: high }], ecn: Some(frames.Ecn { ect0: high + 1 - ce, ect1: 0 as i64, ce: ce }) };
}

// A rise in the ECN-CE count halves the window, as a loss does, once per
// recovery period; an ACK without counts, or with the same count, does not.
function test_ecn_ce(): test.TestOutcome {
  let r = sending(recovery.new(1200, true).confirmed(), 0 as i64, 0 as i64, 0 as i64);
  r = acked(r, marked(0 as i64, 0 as i64, 0 as i64), 20 * MS, 0 as i64);
  let clean = r.window().to_string();
  r = sending(r, 1 as i64, 2 as i64, 20 * MS);
  r = acked(r, marked(1 as i64, 2 as i64, 1 as i64), 40 * MS, 2 as i64);
  let halved = r.window().to_string();
  r = sending(r, 3 as i64, 3 as i64, 30 * MS);
  r = acked(r, marked(3 as i64, 3 as i64, 2 as i64), 50 * MS, 3 as i64);
  let in_recovery = r.window().to_string();
  r = sending(r, 4 as i64, 4 as i64, 60 * MS);
  r = acked(r, marked(4 as i64, 4 as i64, 2 as i64), 70 * MS, 4 as i64);
  let same = r.window().to_string();
  r = sending(r, 5 as i64, 5 as i64, 80 * MS);
  r = acked(r, marked(5 as i64, 5 as i64, 3 as i64), 90 * MS, 5 as i64);
  return test.assert_eq(clean + " " + halved + " " + in_recovery + " " + same + " " + r.window().to_string(), "13200 6600 6600 6818 3409");
}

function test_refusal_and_discard(): test.TestOutcome {
  let r = sending(recovery.new(1200, false), 0 as i64, 1 as i64, 0 as i64);
  let refused = r.on_ack(recovery.APPLICATION, ack(0 as i64, 5 as i64), time.DURATION_ZERO, at_ns(MS), 1 as i64);
  let bad = refused.refused.to_string() + " " + pns(refused.acked) + "/" + refused.outcome_taken().refused.to_string();
  let in_flight = r.in_flight().to_string() + " " + r.window().to_string();
  let d = r.discard(recovery.APPLICATION);
  return test.assert_eq(bad + " | " + in_flight + " | " + d.in_flight().to_string() + " " + d.window().to_string(), "10 /0 | true 9600 | false 12000");
}

function main(): i32 {
  let r = test.new("std/quic/recovery");
  r = r.it("the RTT estimate", test_rtt);
  r = r.it("packet and time thresholds", test_thresholds);
  r = r.it("the probe timeout", test_probe_timeout);
  r = r.it("the congestion window", test_window);
  r = r.it("a bad ACK, and discarding a space", test_refusal_and_discard);
  r = r.it("an ECN-CE count that rises", test_ecn_ce);
  return r.finish();
}
