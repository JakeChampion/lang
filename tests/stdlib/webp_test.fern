  return [82u8, 73u8, 70u8, 70u8, 228u8, 1u8, 0u8, 0u8, 87u8, 69u8, 66u8, 80u8, 86u8, 80u8, 56u8, 88u8, 10u8, 0u8, 0u8, 0u8, 18u8, 0u8, 0u8, 0u8, 18u8, 0u8, 0u8, 9u8, 0u8, 0u8, 65u8, 78u8, 73u8, 77u8, 6u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 65u8, 78u8, 77u8, 70u8, 206u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 18u8, 0u8, 0u8, 9u8, 0u8, 0u8, 211u8, 0u8, 0u8, 3u8, 65u8, 76u8, 80u8, 72u8, 37u8, 0u8, 0u8, 0u8, 1u8, 23u8, 32u8, 16u8, 72u8, 97u8, 230u8, 31u8, 17u8, 225u8, 96u8, 166u8, 141u8, 20u8, 102u8, 118u8, 16u8, 241u8, 126u8, 206u8, 15u8, 122u8, 222u8, 39u8, 121u8, 11u8, 17u8, 253u8, 15u8, 128u8, 9u8, 222u8, 88u8, 103u8, 171u8, 191u8, 0u8, 0u8, 86u8, 80u8, 56u8, 32u8, 136u8, 0u8, 0u8, 0u8, 240u8, 3u8, 0u8, 157u8, 1u8, 42u8, 19u8, 0u8, 10u8, 0u8, 62u8, 201u8, 82u8, 162u8, 75u8, 39u8, 164u8, 163u8, 33u8, 176u8, 8u8, 0u8, 240u8, 25u8, 9u8, 108u8, 44u8, 192u8, 190u8, 64u8, 3u8, 177u8, 18u8, 173u8, 149u8, 182u8, 7u8, 154u8, 184u8, 0u8, 0u8, 254u8, 230u8, 179u8, 213u8, 236u8, 133u8, 191u8, 35u8, 202u8, 120u8, 52u8, 218u8, 75u8, 143u8, 25u8, 238u8, 59u8, 211u8, 170u8, 184u8, 131u8, 150u8, 162u8, 247u8, 12u8, 125u8, 255u8, 230u8, 9u8, 248u8, 78u8, 208u8, 60u8, 94u8, 112u8, 188u8, 29u8, 238u8, 127u8, 252u8, 185u8, 63u8, 246u8, 123u8, 255u8, 191u8, 255u8, 216u8, 207u8, 45u8, 240u8, 151u8, 177u8, 183u8, 39u8, 231u8, 244u8, 246u8, 82u8, 245u8, 70u8, 239u8, 47u8, 84u8, 110u8, 243u8, 143u8, 188u8, 242u8, 167u8, 38u8, 24u8, 175u8, 109u8, 163u8, 65u8, 75u8, 234u8, 154u8, 206u8, 31u8, 107u8, 226u8, 81u8, 228u8, 40u8, 201u8, 122u8, 63u8, 251u8, 199u8, 213u8, 0u8, 0u8, 0u8, 65u8, 78u8, 77u8, 70u8, 74u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 248u8, 0u8, 0u8, 0u8, 65u8, 76u8, 80u8, 72u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 86u8, 80u8, 56u8, 32u8, 40u8, 0u8, 0u8, 0u8, 52u8, 1u8, 0u8, 157u8, 1u8, 42u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 74u8, 37u8, 160u8, 0u8, 3u8, 112u8, 0u8, 254u8, 239u8, 21u8, 7u8, 254u8, 29u8, 220u8, 221u8, 122u8, 214u8, 255u8, 255u8, 139u8, 67u8, 251u8, 121u8, 255u8, 6u8, 182u8, 148u8, 0u8, 65u8, 78u8, 77u8, 70u8, 144u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 18u8, 0u8, 0u8, 9u8, 0u8, 0u8, 160u8, 1u8, 0u8, 0u8, 86u8, 80u8, 56u8, 32u8, 120u8, 0u8, 0u8, 0u8, 148u8, 3u8, 0u8, 157u8, 1u8, 42u8, 19u8, 0u8, 10u8, 0u8, 62u8, 201u8, 86u8, 163u8, 75u8, 131u8, 0u8, 128u8, 0u8, 1u8, 144u8, 150u8, 198u8, 88u8, 34u8, 5u8, 64u8, 81u8, 142u8, 6u8, 240u8, 212u8, 0u8, 3u8, 174u8, 221u8, 0u8, 0u8, 254u8, 230u8, 180u8, 221u8, 142u8, 68u8, 55u8, 255u8, 78u8, 223u8, 255u8, 162u8, 103u8, 25u8, 40u8, 86u8, 47u8, 132u8, 0u8, 8u8, 247u8, 66u8, 0u8, 152u8, 131u8, 119u8, 237u8, 125u8, 253u8, 38u8, 82u8, 235u8, 103u8, 251u8, 222u8, 190u8, 216u8, 42u8, 178u8, 221u8, 7u8, 203u8, 56u8, 145u8, 1u8, 252u8, 83u8, 179u8, 121u8, 47u8, 47u8, 34u8, 237u8, 128u8, 186u8, 4u8, 73u8, 58u8, 145u8, 0u8, 76u8, 177u8, 225u8, 207u8, 116u8, 27u8, 7u8, 22u8, 69u8, 255u8, 19u8, 111u8, 202u8, 15u8, 254u8, 38u8, 227u8, 100u8, 227u8, 39u8, 224u8, 0u8];
}

function riff(chunks: [u8[]]): u8[] {
  let body: u8[] = [87u8, 69u8, 66u8, 80u8];
  for c in chunks {
    body = body.concat(c);
  }
  return [82u8, 73u8, 70u8, 70u8].concat(le32(body.len())).concat(body);
}

function le32(v: i32): u8[] {
  return [v as u8, (v >> 8) as u8, (v >> 16) as u8, (v >> 24) as u8];
}

function chunk(tag: string, data: [u8]): u8[] {
  let out = tag.bytes().concat(le32(data.len())).concat(data);
  return if (data.len() % 2 == 1) { out.append(0u8) } else { out };
}

// The alpha values of `alpha_plane` with the prediction of the filter `f`
// taken away, as an encoder writes them.
function alpha_filtered(f: i32): u8[] {
  let a = alpha_plane();
  let w = 11;
  let out: u8[] = [];
  for i in 0..a.len() {
    let x = i % w;
    let y = i / w;
    let left = if (x > 0) { a[i - 1] as i32 } else { 0 };
    let up = if (y > 0) { a[i - w] as i32 } else { 0 };
    let pred = if (f == 0) {
      0
    } else if (y == 0) {
      left
    } else if (x == 0) {
      up
    } else if (f == 1) {
      left
    } else if (f == 2) {
      up
    } else {
      (left + up - a[i - w - 1] as i32).clamp(0, 255)
    };
    out = out.append((a[i] as i32 - pred & 255) as u8);
  }
  return out;
}

// A file of 11 by 7 with a VP8X chunk, an ALPH chunk of raw values with the
// filter `f`, and a VP8 chunk.
function with_alpha(f: i32): u8[] {
  let vp8x: u8[] = [16u8, 0u8, 0u8, 0u8, 10u8, 0u8, 0u8, 6u8, 0u8, 0u8];
  return riff([chunk("VP8X", vp8x), chunk("ALPH", [(f << 2) as u8].concat(alpha_filtered(f))), chunk("VP8 ", alpha_image())]);
}

// An animation whose first frame has an ALPH chunk before a VP8L chunk,
// which the demuxer of libwebp refuses.
function alpha_before_lossless(): u8[] {
  let a = animation_4x4();
  let size = word_at(a, 48);
  let frame = slice(a, 52, 68).concat(chunk("ALPH", [0u8, 0u8])).concat(slice(a, 68, 52 + size));
  return riff([slice(a, 12, 44), chunk("ANMF", frame), slice(a, 52 + size + size % 2, a.len())]);
}

function test_decode_lossy(): test.TestOutcome {
  let got = [decoded(lossy()), decoded(lossy_normal()), decoded(lossy_simple()), decoded(lossy_parts()), decoded(lossy_smooth()), decoded(lossy_skip()), decoded(lossy_flat())];
  return test.assert_eq(got.join(" | "), "3x2 2084022314 | 37x29 2893206058 | 23x17 3435794309 | 18x72 2258119739 | 48x40 1520973617 | 220x3 620729378 | 20x9 24066254");
}

function test_decode_lossy_pixels(): test.TestOutcome {
  let img = match (webp.decode(lossy())) {
    Ok(i) => i,
    Err(e) => {
      return test.fail(e.message());
    },
  };
  let want: u8[] = [192u8, 19u8, 0u8, 255u8, 197u8, 27u8, 0u8, 255u8, 196u8, 34u8, 0u8, 255u8, 207u8, 34u8, 8u8, 255u8, 213u8, 42u8, 13u8, 255u8, 212u8, 50u8, 12u8, 255u8];
  return test.assert_eq((img.pixels == want).to_string(), "true");
}

function test_decode_lossy_alpha(): test.TestOutcome {
  let got = [decoded(lossy_alpha()), decoded(with_alpha(0)), decoded(with_alpha(1)), decoded(with_alpha(2)), decoded(with_alpha(3)), decoded(alpha_lossless())];
  return test.assert_eq(got.join(" | "), "3x2 2463566941 | 11x7 11913073 | 11x7 11913073 | 11x7 11913073 | 11x7 11913073 | 19x13 3126748487");
}

function test_decode_lossy_errors(): test.TestOutcome {
  let n = lossy_normal();
  // The VP8 chunk keeps 700 of its 1084 bytes, so the tokens end early.
  let short = prefix(n, 720).with(4, 200u8).with(5, 2u8).with(16, 188u8).with(17, 2u8);
  let inter = n.with(20, n[20] | 1u8);
  let hidden = n.with(20, n[20] & 239u8);
  let start = n.with(23, 156u8);
  let a = with_alpha(0);
  let reserved = a.with(38, 64u8);
  let method = a.with(38, 2u8);
  let canvas = a.with(24, 11u8);
  let raw_short = riff([chunk("VP8X", slice(a, 20, 30)), chunk("ALPH", [0u8].concat(slice(alpha_plane(), 0, 75))), chunk("VP8 ", alpha_image())]);
  let got = [decoded(prefix(n, 600)), decoded(short), decoded(inter), decoded(hidden), decoded(start), decoded(reserved), decoded(method), decoded(canvas), decoded(raw_short)];
  return test.assert_eq(got.join(" | "), "webp: the data ends early | webp: the data ends early | webp: the header of the image is not valid | webp: the header of the image is not valid | webp: the header of the image is not valid | webp: the header of the image is not valid | webp: the header of the image is not valid | webp: the header of the image is not valid | webp: the data ends early");
}

// The 3 by 2 file of Pillow with a frame of 4096 by 4096 pixels in its
// header. Its partitions end in the first row of macroblocks, so the decode
// must stop there and not decode the rest of the frame.
function test_decode_lossy_short_large_frame(): test.TestOutcome {
  let large = lossy().with(26, 0u8).with(27, 16u8).with(28, 0u8).with(29, 16u8);
  return test.assert_eq(decoded(large), "webp: the data ends early");
}

function test_decode_lossy_animation(): test.TestOutcome {
  let made = webp.animate(3, 2, [lossy(), lossy_alpha(), lossless()], [100, 250, 70000]).unwrap_or([]);
  let got = [animated(lossy_animation()), animated(made)];
  return test.assert_eq(got.join(" | "), "19x10 loops 1, 211ms 3270000978, 248ms 2722273656, 416ms 3914658160 | 3x2 loops 0, 100ms 2084022314, 250ms 2463566941, 70000ms 3643371239");
}

function main(): i32 {
  let r = test.new("std/webp");
  r = r.it("animation of lossy, alpha and lossless frames", test_animation);
  r = r.it("errors", test_errors);
  r = r.it("decode a lossless file of Pillow", test_decode_pillow);
  r = r.it("decode each transform", test_decode_transforms);
  r = r.it("decode entropy images, narrow images and VP8X files", test_decode_shapes);
  r = r.it("decode errors", test_decode_errors);
  r = r.it("decode animations", test_decode_animation);
  r = r.it("blend a frame as libwebp does", test_decode_animation_blend);
  r = r.it("decode the animations that animate writes", test_decode_animation_round_trip);
  r = r.it("animation decode errors", test_decode_animation_errors);
  r = r.it("decode lossy files", test_decode_lossy);
  r = r.it("decode the pixels of a lossy file of Pillow", test_decode_lossy_pixels);
  r = r.it("decode lossy files with alpha", test_decode_lossy_alpha);
  r = r.it("lossy decode errors", test_decode_lossy_errors);
  r = r.it("a short lossy file with a large frame", test_decode_lossy_short_large_frame);
  r = r.it("decode animations with lossy frames", test_decode_lossy_animation);
  return r.finish();
}
