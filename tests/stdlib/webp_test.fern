// The width, the height and the CRC-32 of the pixels of a decoded file.
function decoded(file: [u8]): string {
  return match (webp.decode(file)) {
    Ok(img) => img.width.to_string() + "x" + img.height.to_string() + " " + crc32.of(img.pixels).to_string(),
    Err(e) => e.message(),
  };
}

function test_decode_pillow(): test.TestOutcome {
  let img = match (webp.decode(lossless())) {
    Ok(i) => i,
    Err(e) => {
      return test.fail(e.message());
    },
  };
  let want: u8[] = [200u8, 10u8, 0u8, 255u8, 200u8, 20u8, 0u8, 255u8, 200u8, 30u8, 0u8, 255u8, 200u8, 40u8, 0u8, 255u8, 200u8, 50u8, 0u8, 255u8, 200u8, 60u8, 0u8, 255u8];
  return test.assert_eq(img.width.to_string() + "x" + img.height.to_string() + " " + (img.pixels == want).to_string(), "3x2 true");
}

function test_decode_transforms(): test.TestOutcome {
  let got = [decoded(palette_2()), decoded(palette_4()), decoded(palette_10()), decoded(palette_200()), decoded(predict_color_cache()), decoded(subtract_green_predict())];
  return test.assert_eq(got.join(" | "), "33x17 1041821461 | 50x20 803387393 | 23x13 1377855247 | 73x45 1384635341 | 97x61 3808768878 | 97x61 3808768878");
}

function test_decode_shapes(): test.TestOutcome {
  let got = [decoded(meta_codes()), decoded(narrow()), decoded(single()), decoded(extended())];
  return test.assert_eq(got.join(" | "), "300x40 1905554902 | 3x257 10626696 | 1x1 3057449933 | 50x20 803387393");
}

function prefix(b: [u8], n: i32): u8[] {
  return slice(b, 0, n);
}

function test_decode_errors(): test.TestOutcome {
  let animated = webp.animate(3, 2, [lossless()], [100]).unwrap_or([]);
  let bad_signature = lossless().with(20, 0u8);
  let bad_version = lossless().with(24, 32u8);
  let got = [decoded(animated), decoded([1u8, 2u8, 3u8]), decoded(prefix(lossless(), 30)), decoded(prefix(palette_200(), 600)), decoded(bad_signature), decoded(bad_version)];
  return test.assert_eq(got.join(" | "), "webp: the file is animated, so decode_animation must read it | webp: not a WebP file | webp: the data ends early | webp: the data ends early | webp: the header of the image is not valid | webp: the header of the image is not valid");
}

// Animations that the generator of the test wrote, with each frame a lossless
// still of libwebp. The first has frames with and without blending and
// disposal, on a canvas of 6 by 4. In the second, the first frame does not
// cover the canvas. The CRC-32 values are of the canvases that the animation
// decoder of libwebp 1.6.0 gives.
