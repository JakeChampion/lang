import "core/map";
import "std/test";

function test_entries_sum(): test.TestOutcome {
  let m: Map[i32, i32] = map_new(8);
  m = m.insert(1, 10);
  m = m.insert(2, 20);
  m = m.insert(3, 30);
  let s = 0;
  for e in m.entries() {
    s = s + e.0 + e.1;
  }
  return test.assert_eq(s, 66);
}

function test_entries_len(): test.TestOutcome {
  let m: Map[string, i32] = map_new(4);
  m = m.insert("a", 1);
  m = m.insert("b", 2);
  return test.assert_eq(m.entries().len(), 2);
}

function test_entries_empty(): test.TestOutcome {
  let m: Map[i32, i32] = map_new(4);
  return test.assert_eq(m.entries().len(), 0);
}

function test_from(): test.TestOutcome {
  let m = map.from([(5, 50), (6, 60), (7, 70)]);
  if (m.len() != 3) {
    return test.fail("from() wrong length");
  }
  return test.assert_eq(m.get_or(6, 0), 60);
}

function test_from_dup_last_wins(): test.TestOutcome {
  let m = map.from([(1, 10), (1, 99)]);
  if (m.len() != 1) {
    return test.fail("duplicate key should collapse");
  }
  return test.assert_eq(m.get_or(1, 0), 99);
}

function test_from_string_keys(): test.TestOutcome {
  let m = map.from([("x", 1), ("y", 2)]);
  return test.assert_eq(m.get_or("y", 0), 2);
}

function test_merge_other_wins(): test.TestOutcome {
  let a = map.from([(1, 100), (2, 200)]);
  let b = map.from([(2, 999), (5, 500)]);
  let m = a.merge(b);
  if (m.len() != 3) {
    return test.fail("merge length wrong");
  }
  if (m.get_or(1, 0) != 100) {
    return test.fail("merge dropped a's unique key");
  }
  return test.assert_eq(m.get_or(2, 0), 999);
}

function test_merge_empty(): test.TestOutcome {
  let a = map.from([(1, 1)]);
  let e: Map[i32, i32] = map_new(2);
  if (a.merge(e).len() != 1) {
    return test.fail("merge with empty wrong");
  }
  return test.assert_eq(e.merge(a).get_or(1, 0), 1);
}

function test_get_or_insert_present(): test.TestOutcome {
  let m: Map[i32, i32] = map_new(4);
  m = m.insert(1, 10);
  let r: (Map[i32, i32], i32) = m.get_or_insert(1, 99);
  if (r.0.len() != 1) {
    return test.fail("present key should not grow the map");
  }
  return test.assert_eq(r.1, 10);
}

function test_get_or_insert_absent(): test.TestOutcome {
  let m: Map[i32, i32] = map_new(4);
  let r: (Map[i32, i32], i32) = m.get_or_insert(7, 70);
  if (r.0.len() != 1) {
    return test.fail("absent key should insert");
  }
  if (r.0.get_or(7, 0) != 70) {
    return test.fail("absent key inserted wrong value");
  }
  return test.assert_eq(r.1, 70);
}

function test_get_or_insert_word_count(): test.TestOutcome {
  let counts: Map[string, i32] = map_new(8);
  let words: string[] = ["a", "b", "a", "c", "a", "b"];
  for w in words {
    let r: (Map[string, i32], i32) = counts.get_or_insert(w, 0);
    counts = r.0.insert(w, r.1 + 1);
  }
  if (counts.get_or("a", 0) != 3) {
    return test.fail("count(a) should be 3");
  }
  if (counts.get_or("b", 0) != 2) {
    return test.fail("count(b) should be 2");
  }
  return test.assert_eq(counts.get_or("c", 0), 1);
}

function test_update_word_count(): test.TestOutcome {
  let counts: Map[string, i32] = map_new(8);
  let words: string[] = ["a", "b", "a", "c", "a", "b"];
  for w in words {
    counts = counts.update(w, 0, (c: i32): i32 => c + 1);
  }
  if (counts.get_or("a", 0) != 3) {
    return test.fail("count(a) should be 3");
  }
  if (counts.get_or("b", 0) != 2) {
    return test.fail("count(b) should be 2");
  }
  return test.assert_eq(counts.get_or("c", 0), 1);
}

function test_update_present_and_absent(): test.TestOutcome {
  let m: Map[i32, i32] = map_new(4);
  m = m.update(1, 100, (v: i32): i32 => v + 1);
  if (m.get_or(1, 0) != 101) {
    return test.fail("absent update should seed from init");
  }
  m = m.update(1, 100, (v: i32): i32 => v + 1);
  return test.assert_eq(m.get_or(1, 0), 102);
}

function test_contains_value(): test.TestOutcome {
  let m = map.from([("a", 10), ("b", 20)]);
  if (!m.contains_value(20)) {
    return test.fail("20 should be present as a value");
  }
  if (m.contains_value(99)) {
    return test.fail("99 should not be a value");
  }
  return test.assert_eq(m.contains_value(10), true);
}

function test_contains_value_empty(): test.TestOutcome {
  let m: Map[i32, i32] = map_new(4);
  return test.assert_eq(m.contains_value(0), false);
}

// A key of 15 words of 4 bytes. Each of the low 14 bits of `i` changes one
// word, and the last word keeps the count of changed words even. When the
// change is bit 31 of the word, a hash that multiplies 32-bit words gives
// one value for all of the keys, for each seed. When the change is bit 0,
// the keys are ordinary.
function word_key(i: i32, bit: u8, at: i32): string {
  let out = __alloc_u8(60);
  let k = 0;
  while (k < 60) {
    out = out.with(k, (97 + k % 26) as u8);
    k += 1;
  }
  let odd = false;
  let w = 0;
  while (w < 14) {
    if ((i >> w & 1) != 0) {
      out = out.with(4 * w + at, out[4 * w + at] ^ bit);
      odd = !odd;
    }
    w += 1;
  }
  if (odd) {
    out = out.with(56 + at, out[56 + at] ^ bit);
  }
  return unsafe { string_from_bytes_unchecked(out) };
}

function fill_time(n: i32, bit: u8, at: i32): i64 {
  let t0 = monotonic_ns();
  let m: Map[string, i32] = map_new(8);
  for i in 0..n {
    m = m.insert(word_key(i, bit, at), i);
  }
  if (m.len() != n) {
    return 0 - 1 as i64;
  }
  return monotonic_ns() - t0;
}

// With keys that have one hash, 8000 inserts took 70 times the ordinary
// time. The limit of 12 times leaves room for a busy machine.
function test_no_hash_for_all_seeds(): test.TestOutcome {
  let ordinary = fill_time(8000, 1 as u8, 0);
  let hostile = fill_time(8000, 128 as u8, 3);
  if (ordinary < 0 as i64 || hostile < 0 as i64) {
    return test.fail("a key was lost");
  }
  let floor: i64 = 2000000;
  if (ordinary < floor) {
    ordinary = floor;
  }
  return test.assert_true(hostile <= 12 as i64 * ordinary);
}

function main(): i32 {
  let r = test.new("map verbs");
  r = r.it("entries sum k+v", test_entries_sum);
  r = r.it("entries len (string keys)", test_entries_len);
  r = r.it("entries empty", test_entries_empty);
  r = r.it("from pairs", test_from);
  r = r.it("from duplicate last wins", test_from_dup_last_wins);
  r = r.it("from string keys", test_from_string_keys);
  r = r.it("merge other wins", test_merge_other_wins);
  r = r.it("merge with empty", test_merge_empty);
  r = r.it("get_or_insert present", test_get_or_insert_present);
  r = r.it("get_or_insert absent", test_get_or_insert_absent);
  r = r.it("get_or_insert word count", test_get_or_insert_word_count);
  r = r.it("update word count", test_update_word_count);
  r = r.it("update present and absent", test_update_present_and_absent);
  r = r.it("contains_value", test_contains_value);
  r = r.it("contains_value empty", test_contains_value_empty);
  r = r.it("string keys that differ in bit 31 of their words do not share a hash", test_no_hash_for_all_seeds);
  return r.finish();
}
