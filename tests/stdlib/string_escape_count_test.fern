import "std/test";
import "std/string";

function test_escape_html(): test.TestOutcome {
  return test.assert_eq("a<b>&\"'".escape_html(), "a&lt;b&gt;&amp;&#34;&#39;");
}

function test_escape_c(): test.TestOutcome {
  return test.assert_eq("a\tb\\c".escape_c(), "a\\tb\\\\c");
}

function test_escape_html_all(): test.TestOutcome {
  return test.assert_eq("&<>\"'".escape_html(), "&amp;&lt;&gt;&#34;&#39;");
}

function test_escape_html_empty(): test.TestOutcome {
  return test.assert_eq("".escape_html(), "");
}

function test_escape_html_plain(): test.TestOutcome {
  return test.assert_eq("plain text 123".escape_html(), "plain text 123");
}

function test_escape_c_all(): test.TestOutcome {
  return test.assert_eq("\\\"\n\t\r".escape_c(), "\\\\\\\"\\n\\t\\r");
}

function test_escape_shell_plain(): test.TestOutcome {
  return test.assert_eq("abc".escape_shell(), "'abc'");
}

function test_escape_shell_quote(): test.TestOutcome {
  return test.assert_eq("a'b".escape_shell(), "'a'\\''b'");
}

function test_count_byte(): test.TestOutcome {
  return test.assert_eq("banana".count_byte(97), 3);
}

function test_count_chars_in(): test.TestOutcome {
  return test.assert_eq("hello world".count_chars_in("lo"), 5);
}

function test_count_chars_in_empty_set(): test.TestOutcome {
  return test.assert_eq("abc".count_chars_in(""), 0);
}

function test_fields(): test.TestOutcome {
  return test.assert_eq_array("  a b  c ".fields(), ["a", "b", "c"]);
}

function test_fields_empty(): test.TestOutcome {
  return test.assert_eq("   ".fields().len(), 0);
}

function test_center(): test.TestOutcome {
  return test.assert_eq("hi".center(6, '*'), "**hi**");
}

function test_center_odd(): test.TestOutcome {
  return test.assert_eq("hi".center(5, '-'), "-hi--");
}

function test_center_noop(): test.TestOutcome {
  return test.assert_eq("hello".center(3, '*'), "hello");
}

function test_starts_with_any(): test.TestOutcome {
  let xs: string[] = ["xy", "he", "zz"];
  let no: string[] = ["xy", "zz"];
  return test.assert_true("hello".starts_with_any(xs) && !"hello".starts_with_any(no));
}

function test_ends_with_any(): test.TestOutcome {
  let xs: string[] = [".md", ".txt"];
  let no: string[] = [".md", ".rs"];
  return test.assert_true("file.txt".ends_with_any(xs) && !"file.txt".ends_with_any(no));
}

function test_starts_with_any_empty(): test.TestOutcome {
  let empty: string[] = [];
  return test.assert_false("hello".starts_with_any(empty));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/string escape + count");
  r = r.it("escape_html", test_escape_html);
  r = r.it("escape_html all", test_escape_html_all);
  r = r.it("escape_html empty", test_escape_html_empty);
  r = r.it("escape_html plain", test_escape_html_plain);
  r = r.it("escape_c", test_escape_c);
  r = r.it("escape_c all", test_escape_c_all);
  r = r.it("escape_shell plain", test_escape_shell_plain);
  r = r.it("escape_shell quote", test_escape_shell_quote);
  r = r.it("count_byte", test_count_byte);
  r = r.it("count_chars_in", test_count_chars_in);
  r = r.it("count_chars_in empty", test_count_chars_in_empty_set);
  r = r.it("fields", test_fields);
  r = r.it("fields empty", test_fields_empty);
  r = r.it("center", test_center);
  r = r.it("center odd", test_center_odd);
  r = r.it("center noop", test_center_noop);
  r = r.it("starts_with_any", test_starts_with_any);
  r = r.it("ends_with_any", test_ends_with_any);
  r = r.it("starts_with_any empty", test_starts_with_any_empty);
  return r.finish();
}
