import "std/test";
import "std/i64";

function test_abs_diff_wide(): test.TestOutcome {
  let a: i64 = 5000000000 as i64;
  let b: i64 = 3000000000 as i64;
  return test.assert_eq(a.abs_diff(b), 2000000000 as i64);
}

function test_abs_diff_reversed(): test.TestOutcome {
  let a: i64 = 5000000000 as i64;
  let b: i64 = 3000000000 as i64;
  return test.assert_eq(b.abs_diff(a), 2000000000 as i64);
}

function test_abs_diff_mixed_sign(): test.TestOutcome {
  return test.assert_eq((0 as i64).abs_diff(0 - 7 as i64), 7 as i64);
}

function test_abs_diff_both_negative(): test.TestOutcome {
  return test.assert_eq((0 - 100 as i64).abs_diff(0 - 40 as i64), 60 as i64);
}

function test_abs_diff_equal(): test.TestOutcome {
  return test.assert_eq((10 as i64).abs_diff(10 as i64), 0 as i64);
}

function test_in_range_inside(): test.TestOutcome {
  return test.assert_true((5 as i64).is_in_range(1 as i64, 10 as i64));
}

function test_in_range_excludes_hi(): test.TestOutcome {
  return test.assert_true(!(10 as i64).is_in_range(1 as i64, 10 as i64));
}

function test_in_range_wide(): test.TestOutcome {
  return test.assert_true((4000000000 as i64).is_in_range(0 as i64, 5000000000 as i64));
}

function test_between_includes_bounds(): test.TestOutcome {
  if (!(10 as i64).is_between(1 as i64, 10 as i64)) {
    return test.fail("hi should be included");
  }
  return test.assert_true((1 as i64).is_between(1 as i64, 10 as i64));
}

function test_between_outside(): test.TestOutcome {
  return test.assert_true(!(11 as i64).is_between(1 as i64, 10 as i64));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/i64 range");
  r = r.it("abs_diff wide", test_abs_diff_wide);
  r = r.it("abs_diff reversed", test_abs_diff_reversed);
  r = r.it("abs_diff mixed sign", test_abs_diff_mixed_sign);
  r = r.it("abs_diff both negative", test_abs_diff_both_negative);
  r = r.it("abs_diff equal", test_abs_diff_equal);
  r = r.it("is_in_range inside", test_in_range_inside);
  r = r.it("is_in_range excludes hi", test_in_range_excludes_hi);
  r = r.it("is_in_range wide", test_in_range_wide);
  r = r.it("is_between includes bounds", test_between_includes_bounds);
  r = r.it("is_between outside", test_between_outside);
  return r.finish();
}
