import "std/test";

function test_uppercase(): test.TestOutcome {
  return test.assert_eq("hello".to_upper(), "HELLO");
}

function test_lowercase(): test.TestOutcome {
  return test.assert_eq("HELLO".to_lower(), "hello");
}

function test_contains_substring(): test.TestOutcome {
  return test.assert_contains("hello world", "world");
}

function test_not_contains(): test.TestOutcome {
  return test.assert_not_contains("hello world", "xyz");
}

function test_starts_with(): test.TestOutcome {
  return test.assert_starts_with("foobar", "foo");
}

function test_ends_with(): test.TestOutcome {
  return test.assert_ends_with("foobar", "bar");
}

function test_concat(): test.TestOutcome {
  return test.assert_eq("foo" + "bar", "foobar");
}

function test_split_join_roundtrip(): test.TestOutcome {
  let parts: string[] = "a,b,c,d".split(",");
  return test.assert_eq(parts.join("|"), "a|b|c|d");
}

function test_split_yields_four_parts(): test.TestOutcome {
  let parts: string[] = "a,b,c,d".split(",");
  return test.assert_len_string(parts, 4);
}

function test_index_of_hit(): test.TestOutcome {
  match ("hello world".index_of("world")) {
    Some(i) => {
      return test.assert_eq(i, 6);
    },
    None => {
      return test.fail("index_of: expected Some, got None");
    }
  }
}

function test_index_of_miss(): test.TestOutcome {
  match ("hello".index_of("xyz")) {
    Some(_) => {
      return test.fail("index_of: expected None, got Some");
    },
    None => {
      return test.pass();
    }
  }
}

function test_last_index_of_hit(): test.TestOutcome {
  match ("a/b/c".last_index_of("/")) {
    Some(i) => {
      return test.assert_eq(i, 3);
    },
    None => {
      return test.fail("last_index_of: expected Some, got None");
    }
  }
}

function test_index_of_ci_hit(): test.TestOutcome {
  match ("Hello World".index_of_ci("WORLD")) {
    Some(i) => {
      return test.assert_eq(i, 6);
    },
    None => {
      return test.fail("index_of_ci: expected Some, got None");
    }
  }
}

function test_empty_string(): test.TestOutcome {
  return test.assert_empty_string("");
}

function test_non_empty_string(): test.TestOutcome {
  return test.assert_non_empty_string("x");
}

function test_truncate(): test.TestOutcome {
  return test.assert_true(
    "hello world".truncate(8, "...") == "hello..."
      && "hi".truncate(10, "...") == "hi"
      && "hello world".truncate(0 - 1, "...") == ""
      && "hello world".truncate(0, "...") == "",
  );
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("strings");
  r = r.it("to_upper", test_uppercase);
  r = r.it("to_lower", test_lowercase);
  r = r.it("contains substring", test_contains_substring);
  r = r.it("not contains", test_not_contains);
  r = r.it("starts_with", test_starts_with);
  r = r.it("ends_with", test_ends_with);
  r = r.it("concatenation", test_concat);
  r = r.it("split/join roundtrip", test_split_join_roundtrip);
  r = r.it("split yields 4 parts", test_split_yields_four_parts);
  r = r.it("index_of hit", test_index_of_hit);
  r = r.it("index_of miss", test_index_of_miss);
  r = r.it("last_index_of hit", test_last_index_of_hit);
  r = r.it("index_of_ci hit", test_index_of_ci_hit);
  r = r.it("empty string", test_empty_string);
  r = r.it("non-empty string", test_non_empty_string);
  r = r.it("truncate", test_truncate);
  return r.finish();
}
