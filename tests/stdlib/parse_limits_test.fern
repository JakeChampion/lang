import "std/test";
import "std/json";
import "std/fuzz";
import "std/format" as format;
import "std/i32";
import "std/utf8" as utf8;
import "std/option";
import "std/result";
import "std/string";
import "std/peg";
import "core/map";

function nested(depth: i32): string {
  let s = "";
  let i = 0;
  while (i < depth) {
    s += "[";
    i += 1;
  }
  i = 0;
  while (i < depth) {
    s += "]";
    i += 1;
  }
  return s;
}

function parens(depth: i32): string {
  let s = "";
  for i in 0..depth {
    s += "(";
  }
  s += "x";
  for i in 0..depth {
    s += ")";
  }
  return s;
}

// A hosted native program has a stack of 1 GiB. On the other targets the
// stack is smaller, and the peg frame limit stops a match first.
function hosted(): boolean {
  let os = target_os();
  return os == "linux" || os == "android" || os == "darwin";
}

function parens_grammar(start: string, rules: Map[string, peg.Pattern]): peg.Grammar {
  let all = rules.insert("e", PChoice([PSeq([PLit("("), PRef("e"), PLit(")")]), PLit("x")]));
  let Ok(g) = peg.grammar(all, start) else {
    return peg.Grammar { rules: all, start: start };
  };
  return g;
}

function too_deep(r: Result[peg.PegMatch, peg.PegError]): boolean {
  match (r) {
    Ok(_) => {
      return false;
    },
    Err(e) => {
      return e.too_deep;
    }
  }
}

// A rule reference nested deeper than 2048 stops the match instead of
// growing the stack without bound.
function test_peg_depth_limit(): test.TestOutcome {
  let none: Map[string, peg.Pattern] = map_new(2);
  let g = parens_grammar("e", none);
  if (!peg.parse(g, parens(400)).is_ok()) {
    return test.fail("400 levels refused");
  }
  if (hosted() && !peg.parse(g, parens(2000)).is_ok()) {
    return test.fail("2000 levels refused");
  }
  let deep = peg.parse(g, parens(2100));
  if (!too_deep(deep)) {
    return test.fail("2100 levels did not stop as too deep");
  }
  let Err(e) = deep else {
    return test.fail("2100 levels accepted");
  };
  return test.assert_true(e.message().starts_with("peg: nesting too deep"));
}

// The depth limit stops the parse. No choice, option, repetition or
// predicate can match after it.
function test_peg_depth_limit_stops_the_parse(): test.TestOutcome {
  let rows: peg.Pattern[] = [
    PSeq([PNot(PRef("e")), PStar(PAny)]),
    PChoice([PRef("e"), PStar(PAny)]),
    PSeq([POpt(PRef("e")), PStar(PAny)]),
    PSeq([PStar(PRef("e")), PStar(PAny)]),
    PSeq([PAnd(PRef("e")), PStar(PAny)]),
  ];
  for i in 0..rows.len() {
    let rules: Map[string, peg.Pattern] = map_new(2);
    let g = parens_grammar("s", rules.insert("s", rows[i]));
    if (!too_deep(peg.parse(g, parens(2100)))) {
      return test.fail("row " + i.to_string() + " did not stop as too deep");
    }
  }
  return test.pass();
}

// Patterns that nest without a rule reference also stop before the stack
// runs out. On a hosted target the limit is above a million frames.
function test_peg_frame_limit(): test.TestOutcome {
  let p = PLit("x");
  for i in 0..2000 {
    p = PSeq([p]);
  }
  if (!hosted() && !too_deep(peg.parse_pattern(p, "x"))) {
    return test.fail("2000 nested patterns did not stop as too deep");
  }
  let q = PLit("x");
  for i in 0..500 {
    q = PSeq([q]);
  }
  return test.assert_true(peg.parse_pattern(q, "x").is_ok());
}

function test_json_depth_limit(): test.TestOutcome {
  match (json.parse(nested(128))) {
    Ok(_) => {},
    Err(e) => {
      return test.fail("128 levels refused: " + e.message());
    }
  }
  match (json.parse(nested(129))) {
    Ok(_) => {
      return test.fail("129 levels accepted");
    },
    Err(_) => {}
  }
  match (json.parse(nested(100000))) {
    Ok(_) => {
      return test.fail("100000 levels accepted");
    },
    Err(_) => {
      return test.pass();
    }
  }
  return test.pass();
}

// One row of a lower limit: the text, the limit, and whether it must parse.
struct Depth { text: string, limit: i32, parses: boolean }

function depth_rows(): Depth[] {
  return [
    Depth { text: nested(4), limit: 4, parses: true },
    Depth { text: nested(5), limit: 4, parses: false },
    Depth { text: "7", limit: 0, parses: true },
    Depth { text: "[]", limit: 0, parses: false },
    Depth { text: "{\"a\": [1]}", limit: 2, parses: true },
    Depth { text: "{\"a\": [[1]]}", limit: 2, parses: false },
    Depth { text: "7", limit: -1, parses: true },
    Depth { text: "[]", limit: -1, parses: false },
    Depth { text: nested(128), limit: 100000, parses: true },
    Depth { text: nested(129), limit: 100000, parses: false },
  ];
}

// A caller lowers the depth limit of the two JSON parsers, and cannot raise it.
function test_json_lower_depth_limit(): test.TestOutcome {
  for row in depth_rows() {
    let label = row.text.len().to_string() + " bytes at limit " + row.limit.to_string();
    if (json.parse_with_depth(row.text, row.limit).is_ok() != row.parses) {
      return test.fail("parse_with_depth: " + label);
    }
    if (json.parse_document_with_depth(row.text, row.limit).is_ok() != row.parses) {
      return test.fail("parse_document_with_depth: " + label);
    }
  }
  return test.pass();
}

@derive(json.FromJson)
struct Row { xs: i32[] }

@derive(json.FromJson)
struct Batch { rows: Row[] }

// The typed readers take the same lower limit as the parsers.
function test_json_typed_readers_take_a_depth_limit(): test.TestOutcome {
  let text = "{\"rows\": [{\"xs\": [1, 2]}, {\"xs\": [3]}]}";
  match (json.decode_with_depth[Batch](text, 4)) {
    Ok(b) => {
      if (b.rows.len() != 2 || b.rows[0].xs.len() != 2) {
        return test.fail("the record at limit 4 has the wrong rows");
      }
    },
    Err(e) => {
      return test.fail("the record refused at limit 4: " + e.message());
    }
  }
  if (json.decode_with_depth[Batch](text, 3).is_ok()) {
    return test.fail("the record accepted at limit 3");
  }
  if (!json.decode[Batch](text).is_ok()) {
    return test.fail("decode refused the record");
  }
  if (!json.decode_array_with_depth[i32]("[1, 2, 3]", 1).is_ok()) {
    return test.fail("an array refused at limit 1");
  }
  if (json.decode_array_with_depth[i32]("[1, 2, 3]", 0).is_ok()) {
    return test.fail("an array accepted at limit 0");
  }
  return test.pass();
}

// A caller lowers the depth limit of a PEG match, and cannot raise it.
function test_peg_lower_depth_limit(): test.TestOutcome {
  let rules: Map[string, peg.Pattern] = map_new(2);
  rules = rules.insert("e", PChoice([PSeq([PLit("("), PRef("e"), PLit(")")]), PLit("x")]));
  let Ok(g) = peg.grammar(rules, "e") else {
    return test.fail("grammar should build");
  };
  if (!peg.parse_with_depth(g, parens(4), 5).is_ok()) {
    return test.fail("4 levels refused at limit 5");
  }
  if (peg.parse_with_depth(g, parens(4), 4).is_ok()) {
    return test.fail("4 levels accepted at limit 4");
  }
  if (peg.parse_with_depth(g, "x", 0).is_ok()) {
    return test.fail("a rule matched at limit 0");
  }
  if (hosted() && !peg.parse_with_depth(g, parens(2000), 100000).is_ok()) {
    return test.fail("2000 levels refused at limit 100000");
  }
  if (peg.parse_with_depth(g, parens(2100), 100000).is_ok()) {
    return test.fail("2100 levels accepted at limit 100000");
  }
  return test.pass();
}

function test_invalid_utf8_is_refused(): test.TestOutcome {
  let bad: u8[] = [0xc3 as u8, 0x28 as u8];
  if (utf8.from_bytes(bad).is_ok()) {
    return test.fail("a truncated sequence was accepted");
  }
  let overlong: u8[] = [0xc0 as u8, 0xaf as u8];
  if (utf8.from_bytes(overlong).is_ok()) {
    return test.fail("an overlong encoding was accepted");
  }
  let surrogate: u8[] = [0xed as u8, 0xa0 as u8, 0x80 as u8];
  if (utf8.from_bytes(surrogate).is_ok()) {
    return test.fail("a surrogate was accepted");
  }
  let good: u8[] = [0xe2 as u8, 0x82 as u8, 0xac as u8];
  match (utf8.from_bytes(good)) {
    Ok(s) => {
      return test.assert_eq(s.len(), 3);
    },
    Err(_) => {
      return test.fail("a valid three-byte sequence was refused");
    }
  }
  return test.pass();
}

function test_number_parse_is_bounded(): test.TestOutcome {
  match (i32.parse_i32("99999999999")) {
    Ok(v) => {
      return test.fail("an out-of-range number parsed as " + v.to_string());
    },
    Err(_) => {}
  }
  match (i32.parse_i32("2147483647")) {
    Ok(v) => {
      if (v != 2147483647) {
        return test.fail("the maximum parsed as " + v.to_string());
      }
    },
    Err(_) => {
      return test.fail("the maximum was refused");
    }
  }
  match (i32.parse_i32("-2147483649")) {
    Ok(v) => {
      return test.fail("below the minimum parsed as " + v.to_string());
    },
    Err(_) => {
      return test.pass();
    }
  }
  return test.pass();
}

function test_format_width_is_bounded(): test.TestOutcome {
  let wide = format.format("{:2000000000}", ["x"]);
  if (wide.len() != 1000000) {
    return test.fail("a two-billion width padded to " + wide.len().to_string());
  }
  let wrapped = format.format("{:99999999999999}", ["x"]);
  if (wrapped.len() != 1000000) {
    return test.fail("a fourteen-digit width padded to " + wrapped.len().to_string());
  }
  let precise = format.format("{:.99999999999}", ["1.5"]);
  if (precise.len() > 1000010) {
    return test.fail("an eleven-digit precision produced " + precise.len().to_string() + " bytes");
  }
  if (format.format("{:5}", ["x"]).len() != 5) {
    return test.fail("a small width changed");
  }
  return test.pass();
}

function json_never_crashes(input: u8[]): test.TestOutcome {
  let Ok(text) = utf8.from_bytes(input) else {
    return test.pass();
  };
  match (json.parse(text)) {
    Ok(_) => {
      return test.pass();
    },
    Err(_) => {
      return test.pass();
    }
  }
  return test.pass();
}

function utf8_never_crashes(input: u8[]): test.TestOutcome {
  match (utf8.from_bytes(input)) {
    Ok(s) => {
      return test.assert_eq(s.len(), input.len());
    },
    Err(_) => {
      return test.pass();
    }
  }
  return test.pass();
}

function main(): i32 {
  let r = test.new("std parse limits");
  r = r.it("json depth limit", test_json_depth_limit);
  r = r.it("peg depth limit", test_peg_depth_limit);
  r = r.it("peg depth limit stops the parse", test_peg_depth_limit_stops_the_parse);
  r = r.it("peg frame limit", test_peg_frame_limit);
  r = r.it("json lower depth limit", test_json_lower_depth_limit);
  r = r.it("peg lower depth limit", test_peg_lower_depth_limit);
  r = r.it("json typed readers take a depth limit", test_json_typed_readers_take_a_depth_limit);
  r = r.it("invalid utf8 is refused", test_invalid_utf8_is_refused);
  r = r.it("number parse is bounded", test_number_parse_is_bounded);
  r = r.it("format width is bounded", test_format_width_is_bounded);
  let seeds: u8[][] = ["{\"a\": [1, 2.5e3, \"x\\u00e9\", null, true], \"b\": {\"c\": []}}".bytes(), "[[[[1]]]]".bytes(), "\"\\ud83d\\ude00\"".bytes(), "-0.0e-0".bytes()];
  r = r.fuzz("json never crashes", seeds, 2000, json_never_crashes);
  let text_seeds: u8[][] = ["héllo wörld".bytes(), "😀".bytes(), "plain".bytes()];
  r = r.fuzz("utf8 never crashes", text_seeds, 2000, utf8_never_crashes);
  return r.finish();
}
