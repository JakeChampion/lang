import "std/test";
import "std/http";
import "std/http/websocket";
import "std/headers";
import "std/stream";
import "std/string";
import "std/array";
import "std/option";
import "std/deflate";
import "std/utf8";

function no_fault(): Cell[Option[StreamFault]] {
  let none: Option[StreamFault] = None;
  return cell_new(none);
}

function handshake(path: string): HttpRequest {
  let r = http.request("GET", path);
  r = r.with_header("Upgrade", "websocket").with_header("Connection", "keep-alive, Upgrade");
  r = r.with_header("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ==").with_header("Sec-WebSocket-Version", "13");
  return r;
}

function wired(req: HttpRequest, bytes: u8[], k: i32): (HttpRequest, Cell[u8[]]) {
  let at = cell_new(0);
  let none: u8[] = [];
  let out = cell_new(none);
  let src: BodySource = BodySource {
    next: (): Option[u8[]] => {
      let from = at.get();
      if (from >= bytes.len()) {
        return None;
      }
      let to = from + k;
      if (to > bytes.len()) {
        to = bytes.len();
      }
      at.set(to);
      return Some(array.slice(bytes, from, to));
    },
    fault: no_fault(),
    send: (b: u8[]): i32 => {
      out.set(out.get().concat(b));
      return b.len();
    },
  };
  return (HttpRequest { ...req, body: stream.from_source(src) }, out);
}

function mask(): u8[] {
  return [55 as u8, 250 as u8, 33 as u8, 61 as u8];
}

function masked(fin: boolean, opcode: i32, payload: u8[]): u8[] {
  return websocket.frame(fin, opcode, payload, mask());
}

function close_frame(code: i32, reason: string): u8[] {
  return masked(true, 8, [(code >> 8) as u8, (code & 255) as u8].concat(reason.bytes()));
}

function hex(bs: u8[]): string {
  let digits = "0123456789abcdef";
  let out = "";
  for b in bs {
    out = out + digits.slice_snap(b as i32 >> 4, (b as i32 >> 4) + 1) + digits.slice_snap(b as i32 & 15, (b as i32 & 15) + 1);
  }
  return out;
}

function echo(c: websocket.Conn, m: websocket.Message): void {
  match (m) {
    Text(s) => {
      let r = c.send_text(s);
    },
    Binary(b) => {
      let r = c.send_binary(b);
    }
  }
}

function session(bytes: u8[], k: i32, opts: websocket.Options, h: websocket.Handlers): u8[] {
  return session_on(handshake("/ws"), bytes, k, opts, h);
}

function session_on(req: HttpRequest, bytes: u8[], k: i32, opts: websocket.Options, h: websocket.Handlers): u8[] {
  let w: (HttpRequest, Cell[u8[]]) = wired(req, bytes, k);
  match (websocket.accept(w.0, opts, h)) {
    Ok(resp) => {
      let body = resp.body_bytes();
      return w.1.get();
    },
    Err(e) => {
      return e.message().bytes();
    }
  }
  let none: u8[] = [];
  return none;
}

function echoed(bytes: u8[], k: i32): string {
  return hex(session(bytes, k, websocket.options(), websocket.handlers(echo)));
}

function test_accept_key(): test.TestOutcome {
  return test.assert_eq(websocket.accept_key("dGhlIHNhbXBsZSBub25jZQ=="), "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=");
}

function refusal(req: HttpRequest): string {
  match (websocket.accept(req, websocket.options(), websocket.handlers(echo))) {
    Ok(resp) => {
      return "ok";
    },
    Err(e) => {
      let resp = e.to_response();
      return resp.status.to_string() + " " + resp.headers.get("upgrade").unwrap_or("-") + " " + resp.headers.get("sec-websocket-version").unwrap_or("-");
    }
  }
  return "";
}

function test_refusals(): test.TestOutcome {
  let plain = refusal(http.request("GET", "/ws"));
  let posted = refusal(HttpRequest { ...handshake("/ws"), method: "POST" });
  let version = refusal(handshake("/ws").with_header("Sec-WebSocket-Version", "8"));
  let key = refusal(handshake("/ws").with_header("Sec-WebSocket-Key", "notbase64"));
  return test.assert_eq(plain + "|" + posted + "|" + version + "|" + key, "426 websocket 13|426 websocket 13|426 websocket 13|400 - -");
}

function test_handshake_response(): test.TestOutcome {
  let req = handshake("/chat").with_header("Sec-WebSocket-Protocol", "soap, chat");
  let opts = websocket.Options { ...websocket.options(), protocols: ["chat", "superchat"] };
  let none: u8[] = [];
  let w: (HttpRequest, Cell[u8[]]) = wired(req, none, 8);
  match (websocket.accept(w.0, opts, websocket.handlers(echo))) {
    Ok(resp) => {
      let got = resp.status.to_string() + " " + resp.headers.get("upgrade").unwrap_or("-") + " " + resp.headers.get("sec-websocket-accept").unwrap_or("-") + " " + resp.headers.get("sec-websocket-protocol").unwrap_or("-");
      return test.assert_eq(got, "101 websocket s3pPLMBiTxaQ9kYGzzhZRbK+xOo= chat");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function test_echo_text_and_close(): test.TestOutcome {
  let bytes = masked(true, 1, "Hello".bytes()).concat(close_frame(1000, "bye"));
  return test.assert_eq(echoed(bytes, 3), "810548656c6c6f" + "880203e8");
}

function test_echo_binary(): test.TestOutcome {
  let bytes = masked(true, 2, [1 as u8, 2 as u8, 255 as u8]).concat(close_frame(1001, ""));
  return test.assert_eq(echoed(bytes, 1), "82030102ff" + "880203e9");
}

function test_fragments_and_ping(): test.TestOutcome {
  let bytes = masked(false, 1, "Hel".bytes()).concat(masked(true, 9, "p".bytes())).concat(masked(false, 0, "lo ".bytes())).concat(masked(true, 0, "world".bytes())).concat(close_frame(1000, ""));
  return test.assert_eq(echoed(bytes, 5), "8a0170" + "810b48656c6c6f20776f726c64" + "880203e8");
}

function test_large_message(): test.TestOutcome {
  let big = "x".repeat(70000).bytes();
  let bytes = masked(true, 2, big).concat(close_frame(1000, ""));
  let out = session(bytes, 4096, websocket.Options { ...websocket.options(), max_message: 100000 }, websocket.handlers(echo));
  let head = hex(array.take(out, 10));
  return test.assert_eq(head + " " + out.len().to_string(), "827f0000000000011170 70014");
}

function test_too_big(): test.TestOutcome {
  let bytes = masked(true, 2, "x".repeat(200).bytes());
  let out = session(bytes, 50, websocket.Options { ...websocket.options(), max_message: 100 }, websocket.handlers(echo));
  return test.assert_eq(hex(out), "880203f1");
}

function violation(bytes: u8[]): string {
  return hex(session(bytes, 7, websocket.options(), websocket.handlers(echo)));
}

function test_violations(): test.TestOutcome {
  let rsv = masked(true, 1, "a".bytes());
  rsv = rsv.with(0, (rsv[0] as i32 | 64) as u8);
  let none: u8[] = [];
  let unmasked = websocket.frame(true, 1, "a".bytes(), none);
  let opcode = masked(true, 3, "a".bytes());
  let long_ping = masked(true, 9, "p".repeat(126).bytes());
  let fragmented_ping = masked(false, 9, "p".bytes());
  let lone_continuation = masked(true, 0, "a".bytes());
  let nested = masked(false, 1, "a".bytes()).concat(masked(true, 1, "b".bytes()));
  let got = violation(rsv) + "|" + violation(unmasked) + "|" + violation(opcode) + "|" + violation(long_ping) + "|" + violation(fragmented_ping) + "|" + violation(lone_continuation) + "|" + violation(nested);
  return test.assert_eq(got, "880203ea|880203ea|880203ea|880203ea|880203ea|880203ea|880203ea");
}

function test_utf8(): test.TestOutcome {
  let bad = masked(true, 1, [206 as u8, 186 as u8, 225 as u8, 189 as u8, 185 as u8, 207 as u8, 131 as u8, 206 as u8, 188 as u8, 206 as u8, 181 as u8, 237 as u8, 160 as u8, 128 as u8, 101 as u8, 100 as u8, 105 as u8, 116 as u8, 101 as u8, 100 as u8]);
  let split = masked(false, 1, [206 as u8]).concat(masked(true, 0, [186 as u8]));
  let cut = masked(false, 1, [206 as u8]).concat(masked(true, 0, "a".bytes()));
  let early = masked(false, 1, [255 as u8]).concat(masked(true, 0, "a".bytes()));
  let good = violation(split.concat(close_frame(1000, "")));
  return test.assert_eq(violation(bad) + "|" + good + "|" + violation(cut) + "|" + violation(early), "880203ef|8102ceba880203e8|880203ef|880203ef");
}

function test_close_frames(): test.TestOutcome {
  let empty = violation(masked(true, 8, "".bytes()));
  let one = violation(masked(true, 8, [3 as u8]));
  let reserved = violation(close_frame(1005, ""));
  let low = violation(close_frame(999, ""));
  let private = violation(close_frame(4000, "k"));
  let bad_reason = violation(close_frame(1000, "").concat([255 as u8]).with(1, (128 | 3) as u8));
  return test.assert_eq(empty + "|" + one + "|" + reserved + "|" + low + "|" + private + "|" + bad_reason, "880203e8|880203ea|880203ea|880203ea|88020fa0|880203ef");
}

function test_handler_close_and_results(): test.TestOutcome {
  let seen = cell_new("");
  let h: websocket.Handlers = websocket.Handlers {
    open: (c: websocket.Conn): void => { seen.set(seen.get() + "open " + c.path + ";"); },
    message: (c: websocket.Conn, m: websocket.Message): void => {
      let first = c.send_text("one");
      c.close(1001, "going");
      let after = c.send_text("two");
      match (after) {
        Dropped => {
          seen.set(seen.get() + "dropped;");
        },
        _ => {
          seen.set(seen.get() + "kept;");
        }
      }
      return;
    },
    drain: (c: websocket.Conn): void => {},
    close: (c: websocket.Conn, code: i32, reason: string): void => { seen.set(seen.get() + "close " + code.to_string() + " " + reason + ";"); },
  };
  let bytes = masked(true, 1, "x".bytes()).concat(masked(true, 1, "ignored".bytes())).concat(close_frame(1000, "ok"));
  let out = hex(session(bytes, 9, websocket.options(), h));
  return test.assert_eq(seen.get() + " " + out, "open /ws;dropped;close 1000 ok; " + "81036f6e65" + "880703e9676f696e67");
}

function test_backpressure(): test.TestOutcome {
  let seen = cell_new("");
  let h: websocket.Handlers = websocket.Handlers {
    open: (c: websocket.Conn): void => {},
    message: (c: websocket.Conn, m: websocket.Message): void => {
      let a = c.send_binary("a".repeat(60).bytes());
      let b = c.send_binary("b".repeat(60).bytes());
      let d = c.send_binary("c".repeat(60).bytes());
      let shown = "";
      for r in [a, b, d] {
        match (r) {
          Sent => {
            shown += "sent,";
          },
          Backpressure => {
            shown += "pressure,";
          },
          Dropped => {
            shown += "dropped,";
          }
        }
      }
      seen.set(seen.get() + shown);
    },
    drain: (c: websocket.Conn): void => { seen.set(seen.get() + "drained;"); },
    close: (c: websocket.Conn, code: i32, reason: string): void => {},
  };
  let opts = websocket.Options { ...websocket.options(), backpressure: 100, max_backpressure: 150 };
  let bytes = masked(true, 1, "go".bytes()).concat(close_frame(1000, ""));
  let out = session(bytes, 9, opts, h);
  return test.assert_eq(seen.get() + " " + out.len().to_string(), "sent,pressure,dropped,drained; 128");
}

function test_ended_without_close(): test.TestOutcome {
  let seen = cell_new("");
  let h: websocket.Handlers = websocket.Handlers {
    open: (c: websocket.Conn): void => {},
    message: echo,
    drain: (c: websocket.Conn): void => {},
    close: (c: websocket.Conn, code: i32, reason: string): void => { seen.set(code.to_string()); },
  };
  let out = hex(session(masked(true, 1, "hi".bytes()), 2, websocket.options(), h));
  return test.assert_eq(seen.get() + " " + out, "1006 81026869");
}

function compressed(fin: boolean, opcode: i32, payload: u8[]): u8[] {
  let packed = deflate.deflate_flushed(payload, 15);
  let f = masked(fin, opcode, array.take(packed, packed.len() - 4));
  return f.with(0, (f[0] as i32 | 64) as u8);
}

function compressing(): websocket.Options {
  return websocket.Options { ...websocket.options(), compression: true };
}

function deflated(bytes: u8[], k: i32): u8[] {
  let req = handshake("/ws").with_header("Sec-WebSocket-Extensions", "permessage-deflate; client_max_window_bits");
  return session_on(req, bytes, k, compressing(), websocket.handlers(echo));
}

function negotiated(offer: string, opts: websocket.Options): string {
  let req = handshake("/ws");
  if (offer.len() > 0) {
    req = req.with_header("Sec-WebSocket-Extensions", offer);
  }
  let none: u8[] = [];
  let w: (HttpRequest, Cell[u8[]]) = wired(req, none, 8);
  match (websocket.accept(w.0, opts, websocket.handlers(echo))) {
    Ok(resp) => {
      return resp.headers.get("sec-websocket-extensions").unwrap_or("-");
    },
    Err(e) => {
      return e.message();
    }
  }
  return "unreachable";
}

function test_deflate_negotiation(): test.TestOutcome {
  let taken = "permessage-deflate; server_no_context_takeover; server_max_window_bits=";
  let got = negotiated("permessage-deflate; client_max_window_bits", compressing());
  got = got + "|" + negotiated("permessage-deflate; client_max_window_bits", websocket.options());
  got = got + "|" + negotiated("", compressing());
  got = got + "|" + negotiated("x-webkit-deflate-frame, permessage-deflate; server_max_window_bits=10", compressing());
  got = got + "|" + negotiated("permessage-deflate; server_max_window_bits=\"7\"", compressing());
  got = got + "|" + negotiated("permessage-deflate; sticky", compressing());
  got = got + "|" + negotiated("permessage-deflate; client_max_window_bits=99", compressing());
  got = got + "|" + negotiated("permessage-deflate; server_no_context_takeover=1", compressing());
  got = got + "|" + negotiated("permessage-deflate; server_max_window_bits=10; server_max_window_bits=12", compressing());
  got = got + "|" + negotiated("permessage-deflate; client_max_window_bits=12", compressing());
  return test.assert_eq(got, taken + "15|-|-|" + taken + "10|-|-|-|-|-|" + taken + "15");
}

function test_deflate_session(): test.TestOutcome {
  let text = "Hello, Hello, Hello, Hello!";
  let packed = deflate.deflate_flushed([1 as u8, 2 as u8, 3 as u8], 15);
  packed = array.take(packed, packed.len() - 4);
  let first = masked(false, 2, array.take(packed, 2));
  first = first.with(0, (first[0] as i32 | 64) as u8);
  let rest = masked(true, 0, array.slice(packed, 2, packed.len()));
  let bytes = compressed(true, 1, text.bytes()).concat(first).concat(rest).concat(close_frame(1000, ""));
  return test.assert_eq(frames_of(deflated(bytes, 5)), "193:" + hex(text.bytes()) + "|194:010203|136:03e8|");
}

function test_deflate_context_takeover(): test.TestOutcome {
  let first = masked(true, 1, [74 as u8, 206 as u8, 207 as u8, 43 as u8, 73 as u8, 173 as u8, 40 as u8, 81 as u8, 40 as u8, 73 as u8, 204 as u8, 78 as u8, 205 as u8, 47 as u8, 75 as u8, 45 as u8, 210 as u8, 81 as u8, 72 as u8, 70 as u8, 19 as u8, 1 as u8, 0 as u8]);
  first = first.with(0, (first[0] as i32 | 64) as u8);
  let second = masked(true, 1, [66 as u8, 231 as u8, 43 as u8, 2 as u8, 0 as u8]);
  second = second.with(0, (second[0] as i32 | 64) as u8);
  let got = frames_of(deflated(first.concat(second).concat(close_frame(1000, "")), 5));
  return test.assert_eq(got, "193:" + hex("context takeover, context takeover".bytes()) + "|193:" + hex("context takeover!".bytes()) + "|136:03e8|");
}

function frames_of(got: u8[]): string {
  let out = "";
  let at = 0;
  while (at + 2 <= got.len()) {
    let n = got[at + 1] as i32;
    let payload = array.slice(got, at + 2, at + 2 + n);
    let head = (got[at] as i32).to_string();
    if ((got[at] as i32 & 64) != 0) {
      match (deflate.inflate(payload.concat([0 as u8, 0 as u8, 255 as u8, 255 as u8, 1 as u8, 0 as u8, 0 as u8, 255 as u8, 255 as u8]), 1024)) {
        Ok(r) => {
          out = out + head + ":" + hex(r.out) + "|";
        },
        Err(e) => {
          out = out + head + ":bad|";
        }
      }
    } else {
      out = out + head + ":" + hex(payload) + "|";
    }
    at = at + 2 + n;
  }
  return out;
}

function test_deflate_refusals(): test.TestOutcome {
  let plain = compressed(true, 1, "a".bytes());
  let garbage = masked(true, 1, [7 as u8, 7 as u8, 7 as u8]);
  garbage = garbage.with(0, (garbage[0] as i32 | 64) as u8);
  let not_text = compressed(true, 1, [255 as u8, 254 as u8]);
  let continued = masked(false, 1, "a".bytes()).concat(compressed(true, 0, "b".bytes()));
  let got = hex(session(plain, 7, websocket.options(), websocket.handlers(echo)));
  got = got + "|" + hex(deflated(garbage, 7));
  got = got + "|" + hex(deflated(not_text, 7));
  got = got + "|" + hex(deflated(continued, 7));
  return test.assert_eq(got, "880203ea|880203ef|880203ef|880203ea");
}

function test_close_reason_boundary(): test.TestOutcome {
  let rb: u8[] = [];
  let k = 0;
  while (k < 62) {
    rb = rb.append(195 as u8).append(169 as u8);
    k += 1;
  }
  let reason = utf8.from_bytes_lossy(rb);
  let h: websocket.Handlers = websocket.handlers((c: websocket.Conn, m: websocket.Message): void => { c.close(1000, reason); });
  let bytes = masked(true, 1, "go".bytes());
  let out = hex(session(bytes, 9, websocket.options(), h));
  let body: u8[] = [(1000 >> 8) as u8, (1000 & 255) as u8].concat(array.take(rb, 122));
  return test.assert_eq(out, "88" + __len_byte(body.len()) + hex(body));
}

function __len_byte(n: i32): string {
  let digits = "0123456789abcdef";
  return digits.slice_snap(n >> 4, (n >> 4) + 1) + digits.slice_snap(n & 15, (n & 15) + 1);
}

function test_length_framing(): test.TestOutcome {
  let m = mask();
  let nonmin16: u8[] = [(1 as i32 | 128) as u8, (126 | 128) as u8, 0 as u8, 1 as u8].concat(m).concat(xormask("a".bytes(), m));
  let nonmin64: u8[] = [(1 as i32 | 128) as u8, (127 | 128) as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 1 as u8].concat(m).concat(xormask("a".bytes(), m));
  let small64: u8[] = [(1 as i32 | 128) as u8, (127 | 128) as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 200 as u8].concat(m);
  let msb64: u8[] = [(1 as i32 | 128) as u8, (127 | 128) as u8, 128 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 1 as u8].concat(m);
  let got = framing(nonmin16) + "|" + framing(nonmin64) + "|" + framing(small64) + "|" + framing(msb64);
  return test.assert_eq(got, "880203ea|880203ea|880203ea|880203ea");
}

function xormask(payload: u8[], m: u8[]): u8[] {
  let out: u8[] = [];
  let i = 0;
  while (i < payload.len()) {
    out = out.append((payload[i] as i32 ^ m[i & 3] as i32) as u8);
    i += 1;
  }
  return out;
}

function framing(bytes: u8[]): string {
  return hex(session(bytes, 7, websocket.options(), websocket.handlers(echo)));
}

function main(): i32 {
  let r = test.new("std/http/websocket");
  r = r.it("computes the accept key", test_accept_key);
  r = r.it("refuses what is not a handshake", test_refusals);
  r = r.it("answers the 101 with the chosen protocol", test_handshake_response);
  r = r.it("echoes text and the close", test_echo_text_and_close);
  r = r.it("echoes bytes", test_echo_binary);
  r = r.it("joins fragments and answers a ping between them", test_fragments_and_ping);
  r = r.it("carries a large message under the 8-byte length", test_large_message);
  r = r.it("refuses a message past the cap", test_too_big);
  r = r.it("closes 1002 on a protocol violation", test_violations);
  r = r.it("checks text as its fragments arrive", test_utf8);
  r = r.it("reads a close frame", test_close_frames);
  r = r.it("lets the handler close and drops what follows", test_handler_close_and_results);
  r = r.it("reports backpressure and drains", test_backpressure);
  r = r.it("ends 1006 when the bytes end", test_ended_without_close);
  r = r.it("takes a permessage-deflate offer it can serve", test_deflate_negotiation);
  r = r.it("decodes compressed messages and compresses the echo", test_deflate_session);
  r = r.it("decodes a message that refers back into the one before", test_deflate_context_takeover);
  r = r.it("refuses what a compressed connection cannot take", test_deflate_refusals);
  r = r.it("cuts a close reason to a whole code point", test_close_reason_boundary);
  r = r.it("closes 1002 on a non-minimal or MSB-set length", test_length_framing);
  return r.finish();
}
