import "std/test";
import "std/http";
import "std/http/multipart";
import "std/headers";
import "std/stream";
import "std/string";
import "core/int";

function sample(): multipart.Builder {
  return sample_after(multipart.builder_with("xYzBoundary"));
}

function sample_after(b: multipart.Builder): multipart.Builder {
  return b.field("name", "ann").field("note", "a\r\n--not a boundary\r\nb").file("photo", "me \"1\".png", "image/png", [0 as u8, 1 as u8, 2 as u8, 13 as u8, 10 as u8, 45 as u8, 45 as u8]).field("name", "bob");
}

function scripted(bytes: u8[], k: i32): BodySource {
  let at: Cell[i32] = cell_new(0);
  return BodySource {
    next: (): Option[u8[]] => {
      let from: i32 = at.get();
      if (from >= bytes.len()) {
        return None;
      }
      let to: i32 = from + k;
      if (to > bytes.len()) {
        to = bytes.len();
      }
      at.set(to);
      let out: u8[] = [];
      let i: i32 = from;
      while (i < to) {
        out = out.append(bytes[i]);
        i = i + 1;
      }
      return Some(out);
    },
    fault: cell_new(0),
    send: (b: u8[]): i32 => 0 - 95,
  };
}

function streamed(ct: string, bytes: u8[], k: i32): HttpRequest {
  let h: HeaderMap = headers.header_map_new().set("content-type", ct);
  return HttpRequest { method: "POST", path: "/upload", body: stream.stream_from_source(scripted(bytes, k)), headers: h, trailers: headers.header_map_new() };
}

function buffered(ct: string, body: string): HttpRequest {
  let h: HeaderMap = headers.header_map_new();
  if (ct.len() > 0) {
    h = h.set("content-type", ct);
  }
  return HttpRequest { method: "POST", path: "/upload", body: stream.stream_from_string(body), headers: h, trailers: headers.header_map_new() };
}

function show(bytes: u8[]): string {
  let out: string = "";
  for b in bytes {
    out = out + int.int_to_string(b as i32) + ".";
  }
  return out;
}

function dump(req: HttpRequest, limits: multipart.Limits): string {
  match (dump_result(req, limits)) {
    Ok(s) => {
      return s;
    },
    Err(e) => {
      let resp: HttpResponse = e.to_response();
      return resp.status.to_string() + " " + e.message();
    }
  }
  return "";
}

function dump_result(req: HttpRequest, limits: multipart.Limits): Result[string, multipart.MultipartError] {
  let out: string = "";
  let r: multipart.Reader = multipart.open(req, limits)?;
  while (true) {
    match (r.next()?) {
      NextPart(part, r1) => {
        let got: (u8[], multipart.Reader) = r1.content()?;
        r = got.1;
        out = out + part.name + "|" + part.filename + "|" + part.content_type + "|" + show(got.0) + "\n";
      },
      NoMoreParts => {
        return Ok(out);
      }
    }
  }
  return Ok(out);
}

const EXPECTED: string = "name|||97.110.110.\nnote|||97.13.10.45.45.110.111.116.32.97.32.98.111.117.110.100.97.114.121.13.10.98.\nphoto|me %221%22.png|image/png|0.1.2.13.10.45.45.\nname|||98.111.98.\n";

function test_whole_parts(): test.TestOutcome {
  return test.assert_eq(dump(sample().request("POST", "/upload"), multipart.limits()), EXPECTED);
}

function test_split_delimiter(): test.TestOutcome {
  let got: string = "";
  let j: i32 = 1;
  while (j < 15) {
    let n: i32 = 4096 - j - head_len();
    let pad: u8[] = array_fill(n, 120 as u8);
    let b: multipart.Builder = sample_after(multipart.builder_with("xYzBoundary").file("pad", "pad.bin", "application/octet-stream", pad));
    if (b.body.len() < 4096 - j + 2 + 2) {
      return test.fail("the padded body is too short to split the delimiter");
    }
    let want: string = "pad|pad.bin|application/octet-stream|" + show(pad) + "\n" + EXPECTED;
    if (dump(streamed(b.content_type(), b.bytes(), j), multipart.limits()) != want) {
      got = got + "read " + int.int_to_string(j) + " ";
    }
    if (field_names(streamed(b.content_type(), b.bytes(), j)) != "ann,bob absent") {
      got = got + "skip " + int.int_to_string(j) + " ";
    }
    j = j + 1;
  }
  return test.assert_eq(got, "");
}

function head_len(): i32 {
  let empty: u8[] = [];
  return multipart.builder_with("xYzBoundary").file("pad", "pad.bin", "application/octet-stream", empty).body.len() - 2;
}

function array_fill(n: i32, b: u8): u8[] {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(b);
    i = i + 1;
  }
  return out;
}

function test_pieces(): test.TestOutcome {
  match (pieces_result(sample().request("POST", "/upload"))) {
    Ok(s) => {
      return test.assert_eq(s, "ann|read 2 done|a\r\n--not a boundary\r\nb|0.1.2.13.10.45.45.|bob");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function pieces_result(req: HttpRequest): Result[string, multipart.MultipartError] {
  let r: multipart.Reader = multipart.open(req, multipart.limits())?;
  let first: string = "";
  let reads: i32 = 0;
  match (r.next()?) {
    NextPart(part, r1) => {
      r = r1;
      let done: boolean = false;
      while (!done) {
        let piece: (u8[], boolean, multipart.Reader) = r.read(2)?;
        first = first + string_from_bytes_unchecked(piece.0);
        done = piece.1;
        r = piece.2;
        reads = reads + 1;
      }
    },
    NoMoreParts => {
      return Ok("no first part");
    }
  }
  let second: string = "";
  match (r.next()?) {
    NextPart(part, r1) => {
      let piece: (u8[], boolean, multipart.Reader) = r1.read(4)?;
      second = string_from_bytes_unchecked(piece.0);
      r = piece.2;
      let rest: (u8[], multipart.Reader) = r.content()?;
      second = second + string_from_bytes_unchecked(rest.0);
      r = rest.1;
    },
    NoMoreParts => {
      return Ok("no second part");
    }
  }
  let third: string = "";
  match (r.next()?) {
    NextPart(part, r1) => {
      let got: (u8[], multipart.Reader) = r1.content()?;
      third = show(got.0);
      r = got.1;
    },
    NoMoreParts => {
      return Ok("no third part");
    }
  }
  let fourth: string = "";
  match (r.next()?) {
    NextPart(part, r1) => {
      let got: (u8[], multipart.Reader) = r1.content()?;
      fourth = string_from_bytes_unchecked(got.0);
      r = got.1;
    },
    NoMoreParts => {
      return Ok("no fourth part");
    }
  }
  match (r.next()?) {
    NextPart(part, r1) => {
      return Ok("a fifth part");
    },
    NoMoreParts => {}
  }
  return Ok(first + "|read " + int.int_to_string(reads) + " done|" + second + "|" + third + "|" + fourth);
}

function test_preamble_and_padding(): test.TestOutcome {
  let body: string = "this is the preamble\r\n--B  \r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n1\r\n--B\t\r\ncontent-disposition: form-data; name=b\r\nX-Extra: yes\r\n\r\n\r\n--B--\r\nepilogue";
  return test.assert_eq(dump(buffered("multipart/form-data; boundary=B", body), multipart.limits()), "a|||49.\nb|||\n");
}

function test_refused(): test.TestOutcome {
  let l: multipart.Limits = multipart.limits();
  let got: string = dump(buffered("", ""), l) + "|" + dump(buffered("application/json", "{}"), l) + "|" + dump(buffered("multipart/form-data", "--B\r\n"), l) + "|" + dump(buffered("multipart/form-data; boundary=B", "nothing here"), l) + "|" + dump(buffered("multipart/form-data; boundary=B", "--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n1\r\n"), l) + "|" + dump(buffered("multipart/form-data; boundary=B", "--Bx\r\n"), l) + "|" + dump(buffered("multipart/form-data; boundary=B", "--B\r\nnot a header\r\n\r\n1\r\n--B--\r\n"), l);
  return test.assert_eq(got, "415 expected a Content-Type of multipart/form-data|415 expected multipart/form-data, got application/json|400 the Content-Type names no boundary|400 malformed multipart body: no boundary found|400 malformed multipart body: a part is not terminated|400 malformed multipart body: a boundary line does not end in CRLF|400 malformed multipart body: a part header has no name");
}

function test_caps(): test.TestOutcome {
  let b: multipart.Builder = sample();
  let req: HttpRequest = b.request("POST", "/upload");
  let base: multipart.Limits = multipart.limits();
  let parts: string = dump(b.request("POST", "/upload"), multipart.Limits { ...base, parts: 3 });
  let part: string = dump(b.request("POST", "/upload"), multipart.Limits { ...base, part_bytes: 6 });
  let total: string = dump(b.request("POST", "/upload"), multipart.Limits { ...base, total_bytes: 100 });
  let head: string = dump(b.request("POST", "/upload"), multipart.Limits { ...base, header_bytes: 40 });
  let fits: string = dump(b.request("POST", "/upload"), multipart.Limits { parts: 4, part_bytes: 24, total_bytes: 1000, header_bytes: 120 });
  return test.assert_eq(parts + "|" + part + "|" + total + "|" + head + "|" + (fits == EXPECTED).to_string(), "413 more than 3 parts|413 a part is past 6 bytes|413 the body is past 100 bytes|431 a part's headers are past 40 bytes|true");
}

function test_fields(): test.TestOutcome {
  return test.assert_eq(field_names(sample().request("POST", "/upload")), "ann,bob absent");
}

function field_names(req: HttpRequest): string {
  match (multipart.fields(req, multipart.limits())) {
    Ok(m) => {
      let names: string = "";
      match (m.get("name")) {
        Some(vs) => {
          names = vs.join(",");
        },
        None => {}
      }
      let photo: string = "absent";
      match (m.get("photo")) {
        Some(vs) => {
          photo = "present";
        },
        None => {}
      }
      return names + " " + photo;
    },
    Err(e) => {
      return e.message();
    }
  }
  return "unreachable";
}

function test_quoted_params(): test.TestOutcome {
  let body: string = "--B;1\r\nContent-Disposition: form-data; filename=\"c;\\\"d\\\\e.txt\"; name=\"a;b\"\r\n\r\n1\r\n--B;1--\r\n";
  let raw: string = dump(buffered("multipart/form-data; charset=utf-8; boundary=\"B;1\"", body), multipart.limits());
  let b: multipart.Builder = multipart.builder_with("B").file("x;y", "a;b\\c.txt", "text/plain", "1".bytes());
  let built: string = dump(b.request("POST", "/upload"), multipart.limits());
  return test.assert_eq(raw + "|" + built, "a;b|c;\"d\\e.txt||49.\n|x;y|a;b\\c.txt|text/plain|49.\n");
}

function test_builder_output(): test.TestOutcome {
  let b: multipart.Builder = multipart.builder_with("B").field("q\"x", "1").file("f", "a.txt", "text/plain", "hi".bytes());
  let want: string = "--B\r\nContent-Disposition: form-data; name=\"q%22x\"\r\n\r\n1\r\n--B\r\nContent-Disposition: form-data; name=\"f\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nhi\r\n--B--\r\n";
  let random: multipart.Builder = multipart.builder();
  let distinct: boolean = random.boundary != multipart.builder().boundary && random.boundary.len() == 32;
  return test.assert_eq(string_from_bytes_unchecked(b.bytes()) + "|" + b.content_type() + "|" + distinct.to_string(), want + "|multipart/form-data; boundary=B|true");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/http/multipart");
  r = r.it("whole parts", test_whole_parts);
  r = r.it("a delimiter split between two pulls", test_split_delimiter);
  r = r.it("pieces of a part", test_pieces);
  r = r.it("a preamble and padding", test_preamble_and_padding);
  r = r.it("refused bodies", test_refused);
  r = r.it("the caps", test_caps);
  r = r.it("fields", test_fields);
  r = r.it("quoted parameters", test_quoted_params);
  r = r.it("the builder's output", test_builder_output);
  return r.finish();
}
