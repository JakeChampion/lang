import "std/test";
import "std/async";
import "std/sim";
import "std/time";

function __three_upstreams(d: sim.Sim): sim.Net {
  let n: sim.Net = sim.net(d);
  n = n.serve(1, 80, "/k", "primary", time.duration_nanos(30000000 as i64));
  n = n.serve(2, 80, "/k", "cache", time.duration_nanos(10000000 as i64));
  n = n.serve(3, 80, "/k", "mirror", time.duration_nanos(20000000 as i64));
  return n;
}

function test_gather_input_order(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim.Net = __three_upstreams(d);
  let fs: async.Future[string][] = [
    n.fetch_future(1, 80, "/k"),
    n.fetch_future(2, 80, "/k"),
    n.fetch_future(3, 80, "/k"),
  ];
  let got: string[] = async.gather_on(d, fs, "!");
  if (got[0] != "primary" || got[1] != "cache" || got[2] != "mirror") {
    return test.fail("bodies not in input order");
  }
  return test.assert_eq(d.now_ns(), 30000000 as i64);
}

function test_race_picks_fast(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim.Net = sim.net(d);
  n = n.serve(1, 80, "/k", "slow", time.duration_nanos(40000000 as i64));
  n = n.serve(2, 80, "/k", "fast", time.duration_nanos(10000000 as i64));
  let fs: async.Future[string][] = [
    n.fetch_future(1, 80, "/k"),
    n.fetch_future(2, 80, "/k"),
  ];
  let (w, v) = async.race_on(d, fs, "!");
  if (w != 1) {
    return test.fail("winner index " + w.to_string() + ", want 1");
  }
  if (v != "fast") {
    return test.fail("winner body " + v + ", want fast");
  }
  if (d.now_ns() != 10000000 as i64) {
    return test.fail("race did not end at the fast endpoint's time");
  }
  let rest: async.Future[string][] = [n.fetch_future(1, 80, "/k")];
  let again: string[] = async.gather_on(d, rest, "!");
  if (again[0] != "slow") {
    return test.fail("abandoned loser broke its endpoint");
  }
  return test.pass();
}

function test_deadline_drops_only_slow(): test.TestOutcome {
  let d: sim.Sim = sim.new(7);
  let n: sim.Net = sim.net(d);
  n = n.serve(1, 80, "/k", "late", time.duration_nanos(40000000 as i64));
  n = n.serve(2, 80, "/k", "early", time.duration_nanos(10000000 as i64));
  let fs: async.Future[string][] = [
    n.fetch_future(1, 80, "/k"),
    n.fetch_future(2, 80, "/k"),
  ];
  let got: Option[string][] = async.with_deadline_on(d, time.duration_millis(25), fs);
  match (got[0]) {
    Some(v) => {
      return test.fail("late endpoint resolved under a 25ms deadline");
    },
    None => {}
  }
  match (got[1]) {
    Some(v) => {
      if (v != "early") {
        return test.fail("wrong early body: " + v);
      }
    },
    None => {
      return test.fail("early endpoint timed out under a 25ms deadline");
    }
  }
  return test.assert_eq(d.now_ns(), 25000000 as i64);
}

function test_chunked_accumulates(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim.Net = sim.net(d);
  n = n.serve_chunked(1, 80, "/big", "abcdefghij", time.duration_nanos(5000000 as i64), time.duration_nanos(5000000 as i64), sim.chunks_of(10, 4));
  let fs: async.Future[string][] = [n.fetch_future(1, 80, "/big")];
  let got: string[] = async.gather_on(d, fs, "!");
  if (got[0] != "abcdefghij") {
    return test.fail("chunked body did not accumulate: " + got[0]);
  }
  return test.assert_eq(d.now_ns(), 15000000 as i64);
}

function test_chunked_resuspends_per_chunk(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim.Net = sim.net(d);
  n = n.serve_chunked(1, 80, "/big", "abcdefghij", time.duration_nanos(5000000 as i64), time.duration_nanos(5000000 as i64), sim.chunks_of(10, 4));
  let f: async.Future[string] = n.fetch_future(1, 80, "/big");
  let toks: i32[] = [];
  let guard: i32 = 0;
  while (guard < 10) {
    match (f) {
      Ready(v) => {
        if (v != "abcdefghij") {
          return test.fail("wrong resolved body: " + v);
        }
        if (toks.len() != 3) {
          return test.fail("expected 3 suspensions, got " + toks.len().to_string());
        }
        if (toks[0] != 5 || toks[1] != 10 || toks[2] != 15) {
          return test.fail("wrong chunk ready-at schedule");
        }
        return test.pass();
      },
      Pending(tok, resume) => {
        toks = toks.append(tok);
        f = resume(tok);
      }
    }
    guard = guard + 1;
  }
  return test.fail("chunked future never resolved");
}

function test_unregistered_is_ready_empty(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim.Net = sim.net(d);
  n = n.serve(1, 80, "/k", "body", time.duration_nanos(10000000 as i64));
  let f: async.Future[string] = n.fetch_future(9, 80, "/k");
  match (f) {
    Ready(v) => {
      if (v != "") {
        return test.fail("dead upstream resolved to " + v);
      }
    },
    Pending(tok, c) => {
      return test.fail("dead upstream suspended");
    }
  }
  return test.assert_eq(d.now_ns(), 0 as i64);
}

function test_hits_and_wildcard(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let n: sim.Net = sim.net(d);
  n = n.serve(1, 80, "/k", "body", time.duration_nanos(10000000 as i64));
  n = n.serve(2, 80, "", "any", time.duration_nanos(10000000 as i64));
  let f1: async.Future[string] = n.fetch_future(1, 80, "/k");
  let f2: async.Future[string] = n.fetch_future(1, 80, "/k");
  let f3: async.Future[string] = n.fetch_future(9, 80, "/k");
  if (n.hits(1, 80, "/k") != 2 as i64) {
    return test.fail("expected 2 hits");
  }
  if (n.hits(9, 80, "/k") != 0 as i64) {
    return test.fail("miss was counted");
  }
  let wf: async.Future[string][] = [n.fetch_future(2, 80, "/whatever")];
  let got: string[] = async.gather_on(d, wf, "!");
  if (got[0] != "any") {
    return test.fail("wildcard path did not match");
  }
  if (n.hits(2, 80, "") != 1 as i64) {
    return test.fail("wildcard hit not counted");
  }
  return test.pass();
}

function test_unicode_chunk_boundaries(): test.TestOutcome {
  let body: string = "a¢€🙂\x00z";
  let split: i32 = 0;
  while (split <= body.len()) {
    let d: sim.Sim = sim.new(1);
    let n: sim.Net = sim.net(d).serve_chunked(1, 80, "/", body, time.duration_millis(5), time.duration_millis(7), [split]);
    let f: async.Future[string] = n.fetch_future(1, 80, "/");
    let wakes: i32 = 0;
    let done: boolean = false;
    while (!done && wakes < 3) {
      match (f) {
        Ready(text) => {
          if (text != body) {
            return test.fail("Unicode body changed");
          }
          done = true;
        },
        Pending(token, resume) => {
          if (token != 5 + wakes * 7) {
            return test.fail("chunk time changed");
          }
          wakes = wakes + 1;
          f = resume(token);
        }
      }
    }
    let expected: i32 = 2;
    if (split == 0 || split == body.len()) {
      expected = 1;
    }
    if (!done || wakes != expected) {
      return test.fail("chunk count changed");
    }
    split = split + 1;
  }
  return test.pass();
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/sim net");
  r = r.it("preserves Unicode across every chunk boundary", test_unicode_chunk_boundaries);
  r = r.it("gather returns bodies in input order", test_gather_input_order);
  r = r.it("race picks the fast endpoint", test_race_picks_fast);
  r = r.it("with_deadline drops only the slow endpoint", test_deadline_drops_only_slow);
  r = r.it("chunked body accumulates completely", test_chunked_accumulates);
  r = r.it("chunked future re-suspends per chunk", test_chunked_resuspends_per_chunk);
  r = r.it("unregistered endpoint is Ready empty", test_unregistered_is_ready_empty);
  r = r.it("hits counter and wildcard path", test_hits_and_wildcard);
  return r.finish();
}
