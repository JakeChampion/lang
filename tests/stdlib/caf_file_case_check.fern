import "std/test";
import "aac_kernel_check" as ref;
import "alac_vectors";
import "caf_vectors";
import "caf_check";
import "caf_file_check";

pub function run(shard: i32): test.TestOutcome {
  let sources = alac_vectors.vectors();
  let vectors = caf_vectors.vectors();
  let visited = 0;
  for i in 0..vectors.len() {
    if (i % 4 != shard) {
      continue;
    }
    let vector = vectors[i];
    let Ok(encoded) = ref.unpack(vector.encoded) else {
      return test.fail("CAF fixture");
    };
    let source = sources[vector.source];
    let Ok(expected) = ref.unpack(source.pcm) else {
      return test.fail("independent PCM fixture");
    };
    let reference = caf_check.Reference { rate: source.rate, channels: source.channels, depth: source.depth, trim: vector.trim, frames: vector.frames, mask: vector.mask, order: vector.order };
    if let Err(e) = caf_file_check.run(encoded, expected, reference) {
      return test.fail(vector.name + ": " + e);
    }
    visited += 1;
  }
  if (visited == 0) {
    return test.fail("empty conformance shard");
  }
  return test.pass();
}
