import "std/test";
import "std/http";
import "std/fetch";
import "std/mock_platform";
import "std/i64";
import "std/platform";

function handle(req: HttpRequest, plat: platform.Platform): HttpResponse {
  let region: string = "nowhere";
  match (plat.env("REGION")) {
    Some(r) => {
      region = r;
    },
    None => {}
  }
  let upstream: string = "unreachable";
  match (plat.http(fetch.get("http://10.0.0.1:8080/health"))) {
    Ok(resp) => {
      upstream = resp.status.to_string() + " " + resp.body_string();
    },
    Err(e) => {
      upstream = e.message();
    }
  }
  return http.ok(region + " " + plat.now_ms().to_string() + " " + plat.random_i32().to_string() + " " + upstream);
}

function test_defaults_without_canned_answers(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  let resp: HttpResponse = handle(http.request("GET", "/"), m);
  return test.assert_body(resp, "nowhere 0 0 connect: Connection refused");
}

function test_canned_answers_reach_the_handler(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  m.env_set("REGION", "eu-west");
  m.now_set(1700000000123 as i64);
  m.random_set(42);
  m.http_set("GET", "http://10.0.0.1:8080/health", 204, "fine");
  let resp: HttpResponse = handle(http.request("GET", "/"), m);
  return test.assert_body(resp, "eu-west 1700000000123 42 204 fine");
}

function test_a_request_of_another_url_still_fails(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  m.http_set("GET", "http://10.0.0.1:8080/other", 200, "");
  let resp: HttpResponse = handle(http.request("GET", "/"), m);
  return test.assert_body(resp, "nowhere 0 0 connect: Connection refused");
}

function test_the_last_answer_wins(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  m.env_set("REGION", "one");
  m.env_set("REGION", "two");
  match (m.env("REGION")) {
    Some(r) => {
      if (r != "two") {
        return test.fail("env: " + r);
      }
    },
    None => {
      return test.fail("env: None");
    }
  }
  return test.pass();
}

function test_canned_rows_are_not_calls_and_survive_reset(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  m.env_set("REGION", "eu-west");
  m.elapsed_set(5 as i64);
  let plat: mock_platform.MockPlatform = m;
  plat.env("REGION");
  if (m.call_count() != 1) {
    return test.fail("calls: " + m.call_count().to_string());
  }
  if (!m.has_call("env")) {
    return test.fail("the env call was not recorded");
  }
  m.reset();
  if (m.call_count() != 0) {
    return test.fail("calls after reset: " + m.call_count().to_string());
  }
  if (plat.elapsed_ns() != 5 as i64) {
    return test.fail("the canned clock did not survive reset");
  }
  return test.pass();
}

function test_a_value_with_tabs_and_newlines_round_trips(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  m.env_set("MOTD", "a\tb\nc\\d");
  match (m.env("MOTD")) {
    Some(v) => {
      if (v != "a\tb\nc\\d") {
        return test.fail("env: " + v);
      }
    },
    None => {
      return test.fail("env: None");
    }
  }
  if (m.call_count() != 1) {
    return test.fail("calls: " + m.call_count().to_string());
  }
  return test.pass();
}

function test_an_empty_value_round_trips(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  m.env_set("EMPTY", "");
  match (m.env("EMPTY")) {
    Some(v) => {
      if (v != "") {
        return test.fail("env: " + v);
      }
    },
    None => {
      return test.fail("env: None");
    }
  }
  return test.pass();
}

function test_config_and_secret_answer_what_was_canned(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  let plat: mock_platform.MockPlatform = m;
  match (plat.config("REGION")) {
    Some(v) => {
      return test.fail("config before canning: " + v);
    },
    None => {}
  }
  match (plat.secret("TOKEN")) {
    Some(v) => {
      return test.fail("secret before canning: " + v);
    },
    None => {}
  }
  m.config_set("REGION", "eu-west");
  m.secret_set("TOKEN", "s3cr3t");
  match (plat.config("REGION")) {
    Some(v) => {
      if (v != "eu-west") {
        return test.fail("config: " + v);
      }
    },
    None => {
      return test.fail("config: None");
    }
  }
  match (plat.secret("TOKEN")) {
    Some(v) => {
      if (v != "s3cr3t") {
        return test.fail("secret: " + v);
      }
    },
    None => {
      return test.fail("secret: None");
    }
  }
  return test.pass();
}

function test_a_secret_is_logged_by_name_only(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  m.secret_set("TOKEN", "s3cr3t");
  m.secret("TOKEN");
  let calls: mock_platform.MockCall[] = m.calls();
  if (calls.len() != 1) {
    return test.fail("calls: " + calls.len().to_string());
  }
  if (calls[0].name != "secret" || calls[0].args != "TOKEN") {
    return test.fail("call: " + calls[0].name + " " + calls[0].args);
  }
  for c in calls {
    if (c.args.contains("s3cr3t")) {
      return test.fail("the secret's value is in the call log");
    }
  }
  return test.pass();
}

function __bound(plat: platform.Platform): string {
  let cancelled: string = "live";
  if (plat.cancelled()) {
    cancelled = "cancelled";
  }
  match (plat.deadline()) {
    Some(at) => {
      return cancelled + " due " + at.to_string();
    },
    None => {
      return cancelled + " unbounded";
    }
  }
  return "";
}

function test_the_trace_answers_what_was_canned(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  let before: boolean = __traced(m);
  m.trace_set("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
  if (before || !__traced(m)) {
    return test.fail("trace before and after trace_set");
  }
  return test.pass();
}

function __traced(plat: platform.Platform): boolean {
  match (plat.trace()) {
    Some(c) => {
      return c.span_id == "00f067aa0ba902b7";
    },
    None => {
      return false;
    }
  }
  return false;
}

function test_the_deadline_and_cancellation_answer_what_was_canned(): test.TestOutcome {
  let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
  let before: string = __bound(m);
  m.deadline_set(5000 as i64);
  m.cancel();
  let after: string = __bound(m);
  if (m.call_count() != 4) {
    return test.fail("calls: " + m.call_count().to_string());
  }
  return test.assert_eq(before + "|" + after, "live unbounded|cancelled due 5000");
}

function main(): i32 {
  let t: test.TestRunner = test.test_new("mock_platform.MockPlatform canned answers");
  t = t.it("without canned answers the fixed values apply", test_defaults_without_canned_answers);
  t = t.it("canned answers reach the handler", test_canned_answers_reach_the_handler);
  t = t.it("a request of another URL still fails", test_a_request_of_another_url_still_fails);
  t = t.it("the last answer canned wins", test_the_last_answer_wins);
  t = t.it("canned rows are not calls and survive reset", test_canned_rows_are_not_calls_and_survive_reset);
  t = t.it("a value with tabs and newlines round-trips", test_a_value_with_tabs_and_newlines_round_trips);
  t = t.it("an empty value round-trips", test_an_empty_value_round_trips);
  t = t.it("config and secret answer what was canned", test_config_and_secret_answer_what_was_canned);
  t = t.it("a secret is logged by name only", test_a_secret_is_logged_by_name_only);
  t = t.it("the deadline and cancellation answer what was canned", test_the_deadline_and_cancellation_answer_what_was_canned);
  t = t.it("the trace answers what was canned", test_the_trace_answers_what_was_canned);
  return t.finish();
}
