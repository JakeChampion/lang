import "std/test";
import "std/crypto" as crypto;
import "std/hex";
import "std/string";

function __pseudo(): u8[] {
  let b: u8[] = __alloc_u8(10003);
  let i: i32 = 0;
  while (i < 10003) {
    b = b.with(i, (i * 7 + 3 & 255) as u8);
    i = i + 1;
  }
  return b;
}

function __thousand_a(): string {
  let b: u8[] = __alloc_u8(1000);
  let i: i32 = 0;
  while (i < 1000) {
    b = b.with(i, 97 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

function test_empty(): test.TestOutcome {
  return test.assert_eq(hex.encode(crypto.sha384_new().finish()), "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b");
}

function test_abc(): test.TestOutcome {
  return test.assert_eq(hex.encode(crypto.sha384_new().update("abc".as_bytes()).finish()), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7");
}

function test_multiblock(): test.TestOutcome {
  return test.assert_eq(
    hex.encode(crypto.sha384_new().update("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".as_bytes()).finish()),
    "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039",
  );
}

function test_bytes_len(): test.TestOutcome {
  return test.assert_eq(crypto.sha384_new().update("abc".as_bytes()).finish().len(), 48);
}

function test_million_a_chunked(): test.TestOutcome {
  let h: crypto.Sha512 = crypto.sha384_new();
  let chunk: string = __thousand_a();
  let i: i32 = 0;
  while (i < 1000) {
    h = h.update(chunk.as_bytes());
    i = i + 1;
  }
  return test.assert_eq(hex.encode(h.finish()), "9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985");
}

function test_seven_byte_updates(): test.TestOutcome {
  let msg: u8[] = __pseudo();
  let h: crypto.Sha512 = crypto.sha384_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    h = h.update(msg[i:i + 7]);
    i = i + 7;
  }
  h = h.update(msg[i:10003]);
  let chunked: string = hex.encode(h.finish());
  let whole: string = hex.encode(crypto.sha384_new().update(msg).finish());
  if (chunked != "99f4ec4dd05d8d83aa70975a71c0485c3c5f2b213ef32aa599a7446e7a12c3ee7f7e9e4f33764515b7d9fb68eec19d87") {
    return test.fail("chunked: " + chunked);
  }
  return test.assert_eq(chunked, whole);
}

function test_update_bytes_and_oneshot(): test.TestOutcome {
  let via_bytes: string = hex.encode(crypto.sha384_new().update("abc".bytes()).finish());
  if (via_bytes != hex.encode(crypto.sha384("abc".as_bytes()))) {
    return test.fail("one-shot differs: " + via_bytes);
  }
  return test.assert_eq(via_bytes, "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/crypto SHA-384");
  r = r.it("empty", test_empty);
  r = r.it("abc", test_abc);
  r = r.it("multi-block", test_multiblock);
  r = r.it("finish len", test_bytes_len);
  r = r.it("million a, 1000x1000", test_million_a_chunked);
  r = r.it("7-byte updates", test_seven_byte_updates);
  r = r.it("update_bytes + one-shot", test_update_bytes_and_oneshot);
  return r.finish();
}
