import "std/unicode";
import "std/fuzz";
import "std/test";
import "std/string";
import "std/array";

function check_len_nonneg(input: u8[]): test.TestOutcome {
  if (input.len() >= 0) {
    return test.pass();
  }
  return test.fail("len returned negative");
}

function check_reverse_idempotent(input: u8[]): test.TestOutcome {
  return test.assert_eq_array(input.reverse().reverse(), input);
}

function check_to_lower_no_upper(input: u8[]): test.TestOutcome {
  let s: string = string_from_bytes_unchecked(input);
  let lowered: string = s.to_lower();
  let i: i32 = 0;
  while (i < lowered.len()) {
    let b: i32 = lowered[i] as i32;
    if (b >= 65 && b <= 90) {
      return test.fail("uppercase byte " + b.to_string()
        + " at " + i.to_string() + " after to_lower");
    }
    i = i + 1;
  }
  return test.pass();
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("fuzz shrink");

  r = r.fuzz_shrink(
    "len non-negative",
    ["".bytes(), "x".bytes(), "abc".bytes()], 50,
    check_len_nonneg,
  );

  r = r.fuzz_shrink(
    "reverse_bytes idempotent",
    ["".bytes(), "a".bytes(), "abc".bytes(), "hello world".bytes()],
    fuzz.DEFAULT_ITERATIONS,
    check_reverse_idempotent,
  );

  r = r.fuzz_shrink(
    "to_lower has no uppercase",
    ["".bytes(), "Hello".bytes(), "MIXED".bytes(), "ALLCAPS".bytes()],
    100,
    check_to_lower_no_upper,
  );

  return r.finish();
}
