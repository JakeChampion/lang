// Tests of std/audio/eq: the response of each shape, and what an
// equalizer does to a stream of samples.
import "std/array";
import "std/audio/eq";
import "std/test";

function sine(hz: f64, amp: f64, frames: i32, channels: i32, rate: i32): i32[] {
  let out: i32[] = [];
  for k in 0..frames {
    let v = (amp * (6.283185307179586 * hz * (k as f64) / (rate as f64)).sin()).round() as i32;
    for _ in 0..channels {
      out = out.append(v);
    }
  }
  return out;
}

// The root of the mean square of the channel `ch` from the frame `from`.
function rms(xs: i32[], channels: i32, ch: i32, from: i32): f64 {
  let sum = 0.0;
  let n = 0;
  for k in from..xs.len() / channels {
    let v = xs[k * channels + ch] as f64;
    sum += v * v;
    n += 1;
  }
  return (sum / (n.max(1) as f64)).sqrt();
}

function tenths(x: f64): string {
  return ((x * 10.0).round() as i32).to_string();
}

function test_shapes(): test.TestOutcome {
  let peak = eq.new(48000, 1, [eq.Band { shape: eq.Peak, hz: 1000.0, db: -9.0, q: 1.4 }]);
  let low = eq.new(48000, 1, [eq.Band { shape: eq.LowShelf, hz: 200.0, db: 6.0, q: 0.707 }]);
  let high = eq.new(48000, 1, [eq.Band { shape: eq.HighShelf, hz: 5000.0, db: 4.0, q: 0.707 }]);
  let got = [tenths(peak.response(1000.0)), tenths(peak.response(40.0)), tenths(peak.response(15000.0)), tenths(low.response(20.0)), tenths(low.response(10000.0)), tenths(high.response(20000.0)), tenths(high.response(50.0))];
  return test.assert_eq(got.join(" "), "-90 0 0 60 0 40 0");
}

// Bands that cannot work at the rate do not change the sound.
function test_bands_that_do_nothing(): test.TestOutcome {
  let bands = [eq.Band { shape: eq.Peak, hz: 30000.0, db: 6.0, q: 1.0 }, eq.Band { shape: eq.Peak, hz: 1000.0, db: 6.0, q: 0.0 }, eq.Band { shape: eq.LowShelf, hz: 100.0, db: 0.0, q: 1.0 }];
  let e = eq.new(48000, 1, bands);
  let flat = tenths(e.response(1000.0));
  let (_, out) = e.run(sine(1000.0, 8000.0, 64, 1, 48000));
  return test.assert_eq(flat + " " + (out == sine(1000.0, 8000.0, 64, 1, 48000)).to_string(), "0 true");
}

// A peak of 6 dB at the frequency of a sine doubles it, near enough. The
// samples of two calls continue each other.
function test_a_peak_on_a_sine(): test.TestOutcome {
  let bands = [eq.Band { shape: eq.Peak, hz: 1000.0, db: 6.0, q: 1.0 }];
  let input = sine(1000.0, 4000.0, 4800, 1, 48000);
  let (_, whole) = eq.new(48000, 1, bands).run(array.slice(input, 0, input.len()));
  let first: i32[] = [];
  let second: i32[] = [];
  for k in 0..input.len() {
    if (k < 1777) {
      first = first.append(input[k]);
    } else {
      second = second.append(input[k]);
    }
  }
  let (e, a) = eq.new(48000, 1, bands).run(first);
  let (_, b) = e.retuned(bands).run(second);
  let ratio = rms(whole, 1, 0, 2400) / rms(input, 1, 0, 2400);
  return test.assert_eq(tenths(ratio * 10.0) + " " + (a.concat(b) == whole).to_string(), "200 true");
}

// Each channel has its own filters: a quiet channel stays quiet.
function test_channels(): test.TestOutcome {
  let left = sine(300.0, 9000.0, 960, 1, 48000);
  let both: i32[] = [];
  for v in left {
    both = both.append(v).append(0);
  }
  let (_, out) = eq.new(48000, 2, [eq.Band { shape: eq.LowShelf, hz: 500.0, db: 8.0, q: 0.707 }]).run(both);
  return test.assert_eq(rms(out, 2, 1, 0).to_string() + " " + (rms(out, 2, 0, 480) > rms(left, 1, 0, 480) * 2.0).to_string(), "0 true");
}

// A flat equalizer gives the same samples. A gain past full scale stops at
// the limits of 16 bits.
function test_flat_and_limits(): test.TestOutcome {
  let input = sine(1000.0, 30000.0, 480, 1, 48000);
  let (_, same) = eq.new(48000, 1, [eq.Band { shape: eq.Peak, hz: 1000.0, db: 0.0, q: 1.0 }]).run(array.slice(input, 0, input.len()));
  let (_, loud) = eq.new(48000, 1, [eq.Band { shape: eq.Peak, hz: 1000.0, db: 12.0, q: 1.0 }]).run(array.slice(input, 0, input.len()));
  let most = 0;
  let least = 0;
  for v in loud {
    most = most.max(v);
    least = least.min(v);
  }
  return test.assert_eq((same == input).to_string() + " " + most.to_string() + " " + least.to_string(), "true 32767 -32768");
}

function main(): i32 {
  let r = test.new("std/audio/eq");
  r = r.it("each shape changes its frequencies", test_shapes);
  r = r.it("a band that cannot work does not change the sound", test_bands_that_do_nothing);
  r = r.it("a peak doubles a sine, and two calls continue each other", test_a_peak_on_a_sine);
  r = r.it("each channel has its own filters", test_channels);
  r = r.it("a flat equalizer changes nothing, and a loud one stops at the limits", test_flat_and_limits);
  return r.finish();
}
