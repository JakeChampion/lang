import "std/test";
import "std/i32" as i32m;

function test_next_power_of_2(): test.TestOutcome {
  if (0.next_power_of_2() != 1) {
    return test.fail("0 -> 1");
  }
  if (5.next_power_of_2() != 8) {
    return test.fail("5 -> 8");
  }
  return test.assert_true(16.next_power_of_2() == 16);
}

function test_next_power_of_2_cap(): test.TestOutcome {
  if (1073741823.next_power_of_2() != 1073741824) {
    return test.fail("2^30 - 1 -> 2^30");
  }
  if (1073741824.next_power_of_2() != 1073741824) {
    return test.fail("2^30 unchanged");
  }
  if (1073741825.next_power_of_2() != 0) {
    return test.fail("2^30 + 1 -> 0");
  }
  return test.assert_true(2147483647.next_power_of_2() == 0);
}

function test_is_prime_small(): test.TestOutcome {
  if (!2.is_prime()) {
    return test.fail("2");
  }
  if (!3.is_prime()) {
    return test.fail("3");
  }
  if (1.is_prime()) {
    return test.fail("1");
  }
  if ((0 - 7).is_prime()) {
    return test.fail("-7");
  }
  if (!7919.is_prime()) {
    return test.fail("7919");
  }
  return test.assert_true(!7917.is_prime());
}

function test_is_prime_at_root(): test.TestOutcome {
  if (!46337.is_prime()) {
    return test.fail("46337");
  }
  if (2146654199.is_prime()) {
    return test.fail("46337 * 46327");
  }
  return test.assert_true(!2146190929.is_prime());
}

function test_is_prime_top_of_range(): test.TestOutcome {
  if (!2147483647.is_prime()) {
    return test.fail("M31");
  }
  if (!2147483629.is_prime()) {
    return test.fail("2147483629");
  }
  if (!2147483587.is_prime()) {
    return test.fail("2147483587");
  }
  if (2147483645.is_prime()) {
    return test.fail("2147483645");
  }
  return test.assert_true(!2147483646.is_prime());
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/i32 roots + prime");
  r = r.it("next_power_of_2", test_next_power_of_2);
  r = r.it("next_power_of_2 cap", test_next_power_of_2_cap);
  r = r.it("is_prime small", test_is_prime_small);
  r = r.it("is_prime at root", test_is_prime_at_root);
  r = r.it("is_prime top of range", test_is_prime_top_of_range);
  return r.finish();
}
