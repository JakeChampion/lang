import "std/test";
import "caf_file_case_check";

function references(): test.TestOutcome {
  return caf_file_case_check.run(2);
}

function main(): i32 {
  let runner = test.new("CAF ALAC source independent PCM and seek shard 3 of 4");
  runner = runner.it("all layouts, packet tables, partial frames, trim, and source seeks", references);
  return runner.finish();
}
