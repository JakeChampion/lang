}

function check_u16x8(xs: u8[], ys: u8[]): string[] {
  let bad: string[] = [];
  for verb in ["add", "sub", "mul", "min", "max", "eq", "ne", "lt", "and", "or", "xor", "add_sat", "sub_sat", "avg"] {
    for at in [0, 16, 32, 48] {
      bad = all_of(bad, wrong_lanes("u16x8", verb, bytes_u16x8(lanes_u16x8(verb, simd.load_u16x8(xs, at), simd.load_u16x8(ys, at))), xs, ys, at, 16, false));
    }
  }
  let a = simd.load_u16x8(xs, 16);
  for count in [0, 1, 3, 15, 16, 18] {
    bad = all_of(bad, wrong_shift("u16x8", "shl", bytes_u16x8(simd.shl_u16x8(a, count)), xs, count, 16, false));
    bad = all_of(bad, wrong_shift("u16x8", "shr", bytes_u16x8(simd.shr_u16x8(a, count)), xs, count, 16, false));
  }
  return bad;
}

