import "std/test";
import "std/simd" as simd;
import "std/f64";
import "std/num" as num;

function cubic[T: simd.Lanes](x: T): T {
  return simd.horner(x, [0.0, -2.0, 0.0, 1.0]);
}

function clamp_sum[T: simd.Lanes](x: T): T {
  let y = x * x + T.splat(2.0) * x;
  let m = y.lt(T.splat(5.0));
  return T.select(m, y, T.splat(5.0));
}

function sigmoid[T: simd.Math](x: T): T {
  return T.splat(1.0) / (T.splat(1.0) + (-x).exp());
}

function lanes_of[T: simd.Lanes](x: T): i32 {
  return T.LANES;
}

function test_kernel_on_f64(): test.TestOutcome {
  if (cubic(2.0) != 4.0) {
    return test.fail("cubic(2) = " + cubic(2.0).to_string());
  }
  if (clamp_sum(1.0) != 3.0 || clamp_sum(3.0) != 5.0) {
    return test.fail("clamp_sum");
  }
  return test.assert_eq_f64_rel(sigmoid(0.5), 0.6224593312018546, 1.0e-15);
}

function test_kernel_on_f32(): test.TestOutcome {
  let y = cubic(2.0 as f32);
  return test.assert_eq_f32_near(y, 4.0 as f32, 1.0e-6 as f32);
}

function test_lanes_const(): test.TestOutcome {
  let d: simd.Dual[f64] = simd.seed(1.0);
  let q: simd.DoubleDouble[f64] = simd.dd_splat(1.0);
  if (lanes_of(2.0) != 1 || lanes_of(d) != 1 || lanes_of(q) != 1) {
    return test.fail("LANES through the bound");
  }
  return test.pass();
}

function test_dual_polynomial(): test.TestOutcome {
  let x: simd.Dual[f64] = simd.seed(2.0);
  let y = cubic(x);
  if (y.v != 4.0) {
    return test.fail("value " + y.v.to_string());
  }
  return test.assert_eq_f64_near(y.d, 10.0, 1.0e-12);
}

function test_dual_select(): test.TestOutcome {
  let x1: simd.Dual[f64] = simd.seed(1.0);
  let x3: simd.Dual[f64] = simd.seed(3.0);
  let a = clamp_sum(x1);
  let b = clamp_sum(x3);
  if (a.v != 3.0 || a.d != 4.0) {
    return test.fail("unclamped " + a.v.to_string() + " " + a.d.to_string());
  }
  if (b.v != 5.0 || b.d != 0.0) {
    return test.fail("clamped " + b.v.to_string() + " " + b.d.to_string());
  }
  return test.pass();
}

function test_dual_sigmoid(): test.TestOutcome {
  let x: simd.Dual[f64] = simd.seed(0.5);
  let y = sigmoid(x);
  let s = sigmoid(0.5);
  let h: f64 = 1.0e-6;
  let fd: f64 = (sigmoid(0.5 + h) - sigmoid(0.5 - h)) / (2.0 * h);
  if ((y.d - s * (1.0 - s)).abs() > 1.0e-14) {
    return test.fail("analytic " + y.d.to_string());
  }
  return test.assert_eq_f64_rel(y.d, fd, 1.0e-8);
}

function test_dual_chain_rules(): test.TestOutcome {
  let x: simd.Dual[f64] = simd.seed(0.7);
  let checks: f64[] = [
    x.sin().d - 0.7.cos(),
    x.cos().d + 0.7.sin(),
    x.log().d - 1.0 / 0.7,
    x.tan().d - 1.0 / (0.7.cos() * 0.7.cos()),
    x.tanh().d - (1.0 - 0.7.tanh() * 0.7.tanh()),
    x.atan().d - 1.0 / (1.0 + 0.49),
    x.expm1().d - 0.7.exp(),
    x.log1p().d - 1.0 / 1.7,
    x.sqrt().d - 0.5 / 0.7.sqrt(),
    x.abs().d - 1.0,
    (-x).abs().d - 1.0,
  ];
  let i = 0;
  while (i < checks.len()) {
    if (checks[i].abs() > 1.0e-13) {
      return test.fail("chain rule " + i.to_string() + ": " + checks[i].to_string());
    }
    i += 1;
  }
  return test.pass();
}

function test_dual_pow(): test.TestOutcome {
  let x: simd.Dual[f64] = simd.seed(2.0);
  let y = simd.dual(3.0, 0.0);
  let p = x.pow(y);
  let q = simd.dual(2.0, 0.0).pow(simd.seed(3.0));
  if ((p.v - 8.0).abs() > 1.0e-12 || (p.d - 12.0).abs() > 1.0e-12) {
    return test.fail("d/dx " + p.d.to_string());
  }
  return test.assert_eq_f64_near(q.d, 8.0 * 2.0.log(), 1.0e-12);
}

function test_dd_keeps_low_bits(): test.TestOutcome {
  let one: simd.DoubleDouble[f64] = simd.dd_splat(1.0);
  let tiny: simd.DoubleDouble[f64] = simd.dd_splat(8.673617379884035e-19);
  let back = one + tiny - one;
  if (back.hi != 8.673617379884035e-19 || back.lo != 0.0) {
    return test.fail("got " + back.hi.to_string() + " + " + back.lo.to_string());
  }
  return test.pass();
}

function test_dd_sqrt(): test.TestOutcome {
  let two: simd.DoubleDouble[f64] = simd.dd_splat(2.0);
  let r = two.sqrt();
  let err = r * r - two;
  if (r.hi != 1.4142135623730951 || err.hi.abs() > 1.0e-31) {
    return test.fail("hi " + r.hi.to_string() + " residual " + err.hi.to_string());
  }
  return test.pass();
}

function test_dd_exp_log(): test.TestOutcome {
  let one: simd.DoubleDouble[f64] = simd.dd_splat(1.0);
  let e = one.exp();
  if (e.hi != 2.718281828459045 || (e.lo - 1.4456468917292502e-16).abs() > 1.0e-30) {
    return test.fail("e = " + e.hi.to_string() + " + " + e.lo.to_string());
  }
  let two: simd.DoubleDouble[f64] = simd.dd_splat(2.0);
  let l2 = two.log();
  if (l2.hi != 0.6931471805599453 || (l2.lo - 2.3190468138462996e-17).abs() > 1.0e-30) {
    return test.fail("ln 2 = " + l2.hi.to_string() + " + " + l2.lo.to_string());
  }
  let x: simd.DoubleDouble[f64] = simd.dd_splat(7.25);
  let rt = x.log().exp() - x;
  return test.assert_true(rt.hi.abs() < 1.0e-30);
}

function test_dd_trig(): test.TestOutcome {
  let x: simd.DoubleDouble[f64] = simd.dd_splat(1.0);
  let s = x.sin();
  let c = x.cos();
  if (s.hi != 0.8414709848078965 || (s.lo - 1.776845092935536e-18).abs() > 1.0e-30) {
    return test.fail("sin 1 = " + s.hi.to_string() + " + " + s.lo.to_string());
  }
  let unit: simd.DoubleDouble[f64] = simd.dd_splat(1.0);
  let one = s * s + c * c - unit;
  if (one.hi.abs() > 1.0e-31) {
    return test.fail("sin^2 + cos^2 - 1 = " + one.hi.to_string());
  }
  let xs: f64[] = [2.0, 4.0, -5.0, 100.0];
  let i = 0;
  while (i < xs.len()) {
    let d: simd.DoubleDouble[f64] = simd.dd_splat(xs[i]);
    if ((d.sin().hi - xs[i].sin()).abs() > 4.0e-16 || (d.cos().hi - xs[i].cos()).abs() > 4.0e-16) {
      return test.fail("quadrant at " + xs[i].to_string());
    }
    i += 1;
  }
  let p7: simd.DoubleDouble[f64] = simd.dd_splat(0.7);
  let t = p7.tan().atan() - p7;
  return test.assert_true(t.hi.abs() < 1.0e-30);
}

function test_dd_small_arguments(): test.TestOutcome {
  let x: simd.DoubleDouble[f64] = simd.dd_splat(1.0e-10);
  let em = x.expm1();
  if (em.hi != 1.00000000005e-10 || (em.lo - 3.3900133221217734e-27).abs() > 1.0e-33) {
    return test.fail("expm1 = " + em.hi.to_string() + " + " + em.lo.to_string());
  }
  let l1 = x.log1p();
  if (l1.hi != 9.999999999500001e-11 || (l1.lo + 3.389513322121794e-27).abs() > 1.0e-33) {
    return test.fail("log1p = " + l1.hi.to_string() + " + " + l1.lo.to_string());
  }
  return test.pass();
}

function test_dd_generic_kernel(): test.TestOutcome {
  let x: simd.DoubleDouble[f64] = simd.dd_splat(0.5);
  let s = sigmoid(x);
  if (s.hi != 0.6224593312018546 || (s.lo + 2.855738705812305e-17).abs() > 1.0e-30) {
    return test.fail("sigmoid = " + s.hi.to_string() + " + " + s.lo.to_string());
  }
  let three: simd.DoubleDouble[f64] = simd.dd_splat(3.0);
  let c = clamp_sum(three);
  return test.assert_true(c.hi == 5.0 && c.lo == 0.0);
}

function test_dual_of_dd(): test.TestOutcome {
  let x: simd.Dual[simd.DoubleDouble[f64]] = simd.seed(3.0);
  let y = cubic(x);
  if (y.v.hi != 21.0 || y.d.hi != 25.0) {
    return test.fail("value " + y.v.hi.to_string() + " slope " + y.d.hi.to_string());
  }
  let s = sigmoid(x);
  let expect = sigmoid(3.0) * (1.0 - sigmoid(3.0));
  return test.assert_eq_f64_rel(s.d.hi, expect, 1.0e-14);
}

function test_dd_f32(): test.TestOutcome {
  let x: simd.DoubleDouble[f32] = simd.dd_splat(2.0);
  let r = x.sqrt();
  let err = r * r - x;
  return test.assert_true((err.hi as f64).abs() < 1.0e-13);
}

function test_eq_nan(): test.TestOutcome {
  let z: f64 = 0.0;
  let nan = z / z;
  if (nan.ne(5.0) != 1.0 || simd.eq(nan, 5.0) != 0.0 || simd.eq(nan, nan) != 0.0 || simd.eq(5.0, nan) != 0.0 || simd.eq(5.0, 5.0) != 1.0) {
    return test.fail("f64 eq with NaN");
  }
  let d: simd.Dual[f64] = simd.seed(nan);
  if (simd.eq(d, d).v != 0.0) {
    return test.fail("dual eq with NaN");
  }
  let a = simd.dd(5.0, 0.0);
  let b = simd.dd(nan, 1.0);
  if (simd.eq(a, b).hi != 0.0 || simd.eq(b, b).hi != 0.0 || a.ne(b).hi != 1.0 || a.lt(b).hi != 0.0 || b.lt(a).hi != 0.0) {
    return test.fail("double-double eq and lt with NaN");
  }
  if (simd.eq(a, a).hi != 1.0 || simd.eq(a, simd.dd(5.0, 1.0)).hi != 0.0) {
    return test.fail("double-double eq reads both halves");
  }
  return test.pass();
}

function close_rel(a: f64, b: f64, tol: f64): boolean {
  let m = b.abs();
  if (m < 1.0e-300) {
    m = 1.0e-300;
  }
  return (a - b).abs() <= tol * m;
}

function test_sweep_against_float(): test.TestOutcome {
  let names: string[] = ["exp", "log", "sin", "cos", "tan", "tanh", "atan", "expm1", "log1p", "pow"];
  let i = 0;
  while (i < 30) {
    let x: f64 = -2.9 + 0.2 * (i as f64);
    let p: f64 = 0.1 + 0.2 * (i as f64);
    let q: simd.DoubleDouble[f64] = simd.dd_splat(x);
    let qp: simd.DoubleDouble[f64] = simd.dd_splat(p);
    let d: simd.Dual[f64] = simd.seed(x);
    let dp: simd.Dual[f64] = simd.seed(p);
    let got: f64[] = [
      simd.dd_value(q.exp()), simd.dd_value(qp.log()), simd.dd_value(q.sin()), simd.dd_value(q.cos()),
      simd.dd_value(q.tan()), simd.dd_value(q.tanh()), simd.dd_value(q.atan()), simd.dd_value(q.expm1()),
      simd.dd_value(qp.log1p()), simd.dd_value(qp.pow(simd.dd_splat(1.7))),
    ];
    let want: f64[] = [x.exp(), p.log(), x.sin(), x.cos(), x.tan(), x.tanh(), x.atan(), x.expm1(), p.log1p(), p.pow(1.7)];
    let slope: f64[] = [
      d.exp().d, dp.log().d, d.sin().d, d.cos().d, d.tan().d, d.tanh().d, d.atan().d, d.expm1().d,
      dp.log1p().d, dp.pow(simd.dual(1.7, 0.0)).d,
    ];
    let t = x.tan();
    let th = x.tanh();
    let want_slope: f64[] = [
      x.exp(), 1.0 / p, x.cos(), -x.sin(), 1.0 + t * t, 1.0 - th * th, 1.0 / (1.0 + x * x), x.exp(),
      1.0 / (1.0 + p), 1.7 * p.pow(0.7),
    ];
    let k = 0;
    while (k < 10) {
      if (!close_rel(got[k], want[k], 1.0e-15)) {
        return test.fail(names[k] + " at " + x.to_string() + ": " + got[k].to_string() + " vs " + want[k].to_string());
      }
      if (!close_rel(slope[k], want_slope[k], 1.0e-15)) {
        return test.fail("d/dx " + names[k] + " at " + x.to_string() + ": " + slope[k].to_string() + " vs " + want_slope[k].to_string());
      }
      k += 1;
    }
    i += 1;
  }
  return test.pass();
}

function test_kernel_on_f64x2(): test.TestOutcome {
  let x = __f64x2_of(2.0, 1.0);
  if (cubic(x).lane(0) != cubic(2.0) || cubic(x).lane(1) != cubic(1.0)) {
    return test.fail("cubic on f64x2");
  }
  let c = clamp_sum(__f64x2_of(1.0, 3.0));
  if (c.lane(0) != 3.0 || c.lane(1) != 5.0) {
    return test.fail("clamp_sum on f64x2");
  }
  let s = sigmoid(__f64x2_of(0.5, -2.0));
  if (s.lane(0) != sigmoid(0.5) || s.lane(1) != sigmoid(-2.0)) {
    return test.fail("sigmoid on f64x2");
  }
  return test.pass();
}

function test_kernel_on_f32x4(): test.TestOutcome {
  let x = __f32x4_of(2.0, 1.0, -0.5, 1.5);
  let y = cubic(x);
  let c = clamp_sum(x);
  let k = 0;
  while (k < 4) {
    let e = x.lane(k) as f32;
    if (y.lane(k) != cubic(e) as f64 || c.lane(k) != clamp_sum(e) as f64) {
      return test.fail("lane " + k.to_string() + " of f32x4");
    }
    k += 1;
  }
  if (lanes_of(x) != 4 || lanes_of(__f64x2_splat(0.0)) != 2) {
    return test.fail("LANES of the lane types");
  }
  return test.pass();
}

function test_lane_masks(): test.TestOutcome {
  let z: f64 = 0.0;
  let nan = z / z;
  let a = __f64x2_of(1.0, nan);
  let b = __f64x2_of(2.0, nan);
  let lt = a.lt(b);
  let ne = a.ne(a);
  let eq = simd.eq(a, a);
  if (lt.lane(0) != 1.0 || lt.lane(1) != 0.0 || ne.lane(0) != 0.0 || ne.lane(1) != 1.0 || eq.lane(0) != 1.0 || eq.lane(1) != 0.0) {
    return test.fail("f64x2 lt, ne and eq");
  }
  let pick = f64x2.select(lt, a, __f64x2_splat(7.0));
  if (pick.lane(0) != 1.0 || pick.lane(1) != 7.0) {
    return test.fail("f64x2 select");
  }
  let m = f32x4.select(__f32x4_of(1.0, 0.0, -0.0, 2.0), __f32x4_splat(1.0), __f32x4_splat(2.0));
  if (m.lane(0) != 1.0 || m.lane(1) != 2.0 || m.lane(2) != 2.0 || m.lane(3) != 1.0) {
    return test.fail("f32x4 select reads a non-zero lane as true");
  }
  return test.pass();
}

function test_lane_helpers(): test.TestOutcome {
  let v = __f32x4_of(1.0, 2.0, 3.0, 4.0);
  if (v.lane(3) != 4.0 || v.lane(9) != 4.0 || __f64x2_of(5.0, 6.0).lane(4) != 6.0) {
    return test.fail("lane past the last lane");
  }
  let l = __f64x2_of(3.0, -1.5).ldexp(__f64x2_of(4.0, -1.0));
  if (l.lane(0) != 48.0 || l.lane(1) != -0.75) {
    return test.fail("f64x2 ldexp");
  }
  let lf = v.ldexp(__f32x4_of(1.0, -1.0, 0.0, 2.0));
  if (lf.lane(0) != 2.0 || lf.lane(1) != 1.0 || lf.lane(2) != 3.0 || lf.lane(3) != 16.0) {
    return test.fail("f32x4 ldexp");
  }
  let one = f64x2.one();
  let zero = f32x4.zero();
  if (one.lane(1) != 1.0 || zero.lane(2) != 0.0) {
    return test.fail("lane-wise zero and one");
  }
  let nz = __f64x2_splat(0.0).neg();
  if (1.0 / nz.lane(0) > 0.0) {
    return test.fail("neg of 0.0 is -0.0");
  }
  return test.pass();
}

function test_lane_math_sweep(): test.TestOutcome {
  let names: string[] = ["exp", "log", "sin", "cos", "tan", "tanh", "atan", "expm1", "log1p", "pow"];
  let i = 0;
  while (i < 30) {
    let x: f64 = -2.9 + 0.2 * (i as f64);
    let p: f64 = 0.1 + 0.2 * (i as f64);
    let xv = __f64x2_of(x, -x);
    let pv = __f64x2_of(p, p + 0.05);
    let y = __f64x2_splat(1.7);
    let k = 0;
    while (k < 10) {
      let g = lane_math(k, xv, pv, y);
      let j = 0;
      while (j < 2) {
        let w = scalar_math(k, xv.lane(j), pv.lane(j), 1.7);
        if (!same_f64(g.lane(j), w)) {
          return test.fail("f64x2 " + names[k] + " lane " + j.to_string() + ": " + g.lane(j).to_string() + " vs " + w.to_string());
        }
        j += 1;
      }
      let xf = __f32x4_of(x as f32, -(x as f32), (x * 0.5) as f32, (x * 0.25) as f32);
      let pf = __f32x4_of(p as f32, (p + 0.05) as f32, (p * 2.0) as f32, (p * 0.5) as f32);
      let gf = lane_math_f32(k, xf, pf, __f32x4_splat(1.7));
      j = 0;
      while (j < 4) {
        let w = scalar_math_f32(k, xf.lane(j) as f32, pf.lane(j) as f32, 1.7);
        if (!same_f64(gf.lane(j), w as f64)) {
          return test.fail("f32x4 " + names[k] + " lane " + j.to_string() + ": " + gf.lane(j).to_string() + " vs " + w.to_string());
        }
        j += 1;
      }
      k += 1;
    }
    i += 1;
  }
  return test.pass();
}

function same_f64(a: f64, b: f64): boolean {
  if (a != a) {
    return b != b;
  }
  return f64_bits(a) == f64_bits(b);
}

function lane_math(k: i32, x: f64x2, p: f64x2, y: f64x2): f64x2 {
  if (k == 0) {
    return x.exp();
  }
  if (k == 1) {
    return p.log();
  }
  if (k == 2) {
    return x.sin();
  }
  if (k == 3) {
    return x.cos();
  }
  if (k == 4) {
    return x.tan();
  }
  if (k == 5) {
    return x.tanh();
  }
  if (k == 6) {
    return x.atan();
  }
  if (k == 7) {
    return x.expm1();
  }
  if (k == 8) {
    return p.log1p();
  }
  return p.pow(y);
}

function scalar_math(k: i32, x: f64, p: f64, y: f64): f64 {
  if (k == 0) {
    return x.exp();
  }
  if (k == 1) {
    return p.log();
  }
  if (k == 2) {
    return x.sin();
  }
  if (k == 3) {
    return x.cos();
  }
  if (k == 4) {
    return x.tan();
  }
  if (k == 5) {
    return x.tanh();
  }
  if (k == 6) {
    return x.atan();
  }
  if (k == 7) {
    return x.expm1();
  }
  if (k == 8) {
    return p.log1p();
  }
  return p.pow(y);
}

function lane_math_f32(k: i32, x: f32x4, p: f32x4, y: f32x4): f32x4 {
  if (k == 0) {
    return x.exp();
  }
  if (k == 1) {
    return p.log();
  }
  if (k == 2) {
    return x.sin();
  }
  if (k == 3) {
    return x.cos();
  }
  if (k == 4) {
    return x.tan();
  }
  if (k == 5) {
    return x.tanh();
  }
  if (k == 6) {
    return x.atan();
  }
  if (k == 7) {
    return x.expm1();
  }
  if (k == 8) {
    return p.log1p();
  }
  return p.pow(y);
}

function scalar_math_f32(k: i32, x: f32, p: f32, y: f32): f32 {
  if (k == 0) {
    return x.exp();
  }
  if (k == 1) {
    return p.log();
  }
  if (k == 2) {
    return x.sin();
  }
  if (k == 3) {
    return x.cos();
  }
  if (k == 4) {
    return x.tan();
  }
  if (k == 5) {
    return x.tanh();
  }
  if (k == 6) {
    return x.atan();
  }
  if (k == 7) {
    return x.expm1();
  }
  if (k == 8) {
    return p.log1p();
  }
  return p.pow(y);
}

function ramp(n: i32): u8[] {
  let out: u8[] = [];
  for i in 0..n {
    out = out.append((i * 37 + 11) as u8);
  }
  return out;
}

function total(xs: u8[]): i32 {
  let n = 0;
  for x in xs {
    n += x as i32;
  }
  return n;
}

// The lanes of `v` as an array.
function byte_lanes(v: u8x16): u8[] {
  let zeros: u8[] = [];
  while (zeros.len() < 16) {
    zeros = zeros.append(0 as u8);
  }
  return simd.with_u8x16(zeros, 0, v);
}

// One scalar form of a function of two bytes, for the lanes to agree with.
function scalar_u8(verb: string, x: i32, y: i32): i32 {
  return match (verb) {
    "add" => x + y & 255,
    "sub" => x - y & 255,
    "add_sat" => if (x + y > 255) { 255 } else { x + y },
    "sub_sat" => if (x < y) { 0 } else { x - y },
    "min" => if (x < y) { x } else { y },
    "max" => if (x < y) { y } else { x },
    "avg" => (x + y + 1) / 2,
    "eq" => if (x == y) { 255 } else { 0 },
    "ne" => if (x != y) { 255 } else { 0 },
    "lt" => if (x < y) { 255 } else { 0 },
    "and" => x & y,
    "or" => x | y,
    _ => x ^ y,
  };
}

function lanes_u8(verb: string, a: u8x16, b: u8x16): u8x16 {
  return match (verb) {
    "add" => a + b,
    "sub" => a - b,
    "add_sat" => simd.add_sat_u8x16(a, b),
    "sub_sat" => simd.sub_sat_u8x16(a, b),
    "min" => simd.min_u8x16(a, b),
    "max" => simd.max_u8x16(a, b),
    "avg" => simd.avg_u8x16(a, b),
    "eq" => simd.eq_u8x16(a, b),
    "ne" => simd.ne_u8x16(a, b),
    "lt" => simd.lt_u8x16(a, b),
    "and" => simd.and_u8x16(a, b),
    "or" => simd.or_u8x16(a, b),
    _ => simd.xor_u8x16(a, b),
  };
}

// Each operation on byte lanes agrees with its scalar form on each lane, for
// bytes that include 0, 255 and equal pairs.
function test_byte_lanes_against_the_scalar(): test.TestOutcome {
  let xs = ramp(64);
  let ys: u8[] = [];
  for i in 0..64 {
    ys = ys.append(if (i % 5 == 0) { xs[i] } else { (i * 101 + 250) as u8 });
  }
  xs = xs.with(3, 0 as u8).with(4, 255 as u8).with(20, 255 as u8);
  ys = ys.with(4, 255 as u8).with(7, 0 as u8).with(20, 1 as u8);
  let bad: string[] = [];
  for verb in ["add", "sub", "add_sat", "sub_sat", "min", "max", "avg", "eq", "ne", "lt", "and", "or", "xor"] {
    for at in [0, 16, 32, 48] {
      let got = byte_lanes(lanes_u8(verb, simd.load_u8x16(xs, at), simd.load_u8x16(ys, at)));
      for k in 0..16 {
        if (got[k] as i32 != scalar_u8(verb, xs[at + k] as i32, ys[at + k] as i32)) {
          bad = bad.append(verb + " at " + (at + k).to_string());
        }
      }
    }
  }
  return test.assert_eq(bad.join(", "), "");
}

// A mask picks the lanes of a select, and gives one bit for each lane.
function test_byte_lane_masks(): test.TestOutcome {
  let xs = ramp(16);
  let v = simd.load_u8x16(xs, 0);
  let limit = simd.splat_u8x16(128 as u8);
  let low = simd.lt_u8x16(v, limit);
  let want_mask = 0;
  let want_sum = 0;
  for k in 0..16 {
    if (xs[k] as i32 < 128) {
      want_mask = want_mask | 1 << k;
      want_sum += xs[k] as i32;
    } else {
      want_sum += 128;
    }
  }
  let picked = byte_lanes(simd.select_u8x16(v, limit, low));
  let got = simd.bitmask_u8x16(low).to_string() + " " + total(picked).to_string() + " " + (__u8x16_lane(v, 15) as i32).to_string() + " " + simd.bitmask_u8x16(simd.splat_u8x16(127 as u8)).to_string();
  return test.assert_eq(got, want_mask.to_string() + " " + want_sum.to_string() + " " + (xs[15] as i32).to_string() + " 0");
}

// A store writes 16 bytes and leaves the other bytes.
function test_byte_lane_memory(): test.TestOutcome {
  let xs = ramp(40);
  let ys = simd.with_u8x16(ramp(40), 9, simd.splat_u8x16(7 as u8));
  let got = ys[8].to_string() + " " + ys[9].to_string() + " " + ys[24].to_string() + " " + ys[25].to_string() + " " + xs[9].to_string() + " " + ys.len().to_string();
  return test.assert_eq(got, xs[8].to_string() + " 7 7 " + xs[25].to_string() + " " + xs[9].to_string() + " 40");
}

function zeros16(): u8[] {
  let zeros: u8[] = [];
  while (zeros.len() < 16) {
    zeros = zeros.append(0 as u8);
  }
  return zeros;
}

// The number of lane `k` of the 16 bytes of `bytes` from `at`. The low byte
// of a lane is first.
function lane_number(bytes: u8[], at: i32, k: i32, width: i32, signed: boolean): i64 {
  let size = width / 8;
  let x = 0i64;
  for b in 0..size {
    x = x | bytes[at + k * size + b] as i64 << (8 * b) as i64;
  }
  return cut(x, width, signed);
}

// The low `width` bits of `x`, as the number of a lane.
function cut(x: i64, width: i32, signed: boolean): i64 {
  let ones = (1i64 << width as i64) - 1i64;
  let low = x & ones;
  if (signed && low >> (width - 1) as i64 != 0i64) {
    return low - ones - 1i64;
  }
  return low;
}

// `x` held to the limits of a lane.
function limited(x: i64, width: i32, signed: boolean): i64 {
  let high = (1i64 << (if (signed) { width - 1 } else { width }) as i64) - 1i64;
  let low = if (signed) { 0i64 - high - 1i64 } else { 0i64 };
  if (x > high) {
    return high;
  }
  return if (x < low) { low } else { x };
}

function ones_if(hold: boolean): i64 {
  return if (hold) { -1i64 } else { 0i64 };
}

// One scalar form of a function of two lanes, for the lanes to agree with.
// A shift has its count in `y`.
function scalar_lane(verb: string, x: i64, y: i64, width: i32, signed: boolean): i64 {
  let by = y & (width - 1) as i64;
  let r = match (verb) {
    "add" => x + y,
    "sub" => x - y,
    "mul" => x * y,
    "min" => if (x < y) { x } else { y },
    "max" => if (x < y) { y } else { x },
    "eq" => ones_if(x == y),
    "ne" => ones_if(x != y),
    "lt" => ones_if(x < y),
    "and" => x & y,
    "or" => x | y,
    "xor" => x ^ y,
    "add_sat" => limited(x + y, width, signed),
    "sub_sat" => limited(x - y, width, signed),
    "avg" => (x + y + 1i64) / 2i64,
    "shl" => x << by,
    "shr" => x >> by,
    "neg" => 0i64 - x,
    _ => if (x < 0i64) { 0i64 - x } else { x },
  };
  return cut(r, width, signed);
}

// The lanes of `got` that are not `verb` of the lanes of `xs` and `ys`.
function wrong_lanes(name: string, verb: string, got: u8[], xs: u8[], ys: u8[], at: i32, width: i32, signed: boolean): string[] {
  let bad: string[] = [];
  for k in 0..128 / width {
    let want = scalar_lane(verb, lane_number(xs, at, k, width, signed), lane_number(ys, at, k, width, signed), width, signed);
    if (lane_number(got, 0, k, width, signed) != want) {
      bad = bad.append(name + " " + verb + " at " + (at + k).to_string());
    }
  }
  return bad;
}

// The lanes of `got` that are not the shift of the lanes of `xs` by `count`.
function wrong_shift(name: string, verb: string, got: u8[], xs: u8[], count: i32, width: i32, signed: boolean): string[] {
  let bad: string[] = [];
  for k in 0..128 / width {
    if (lane_number(got, 0, k, width, signed) != scalar_lane(verb, lane_number(xs, 16, k, width, signed), count as i64, width, signed)) {
      bad = bad.append(name + " " + verb + " by " + count.to_string() + " at " + k.to_string());
    }
  }
  return bad;
}

function all_of(own out: string[], more: string[]): string[] {
  for m in more {
    out = out.append(m);
  }
  return out;
}

function shifts_u8x16(xs: u8[]): string[] {
  let bad: string[] = [];
  let a = simd.load_u8x16(xs, 16);
  for count in [0, 1, 3, 7, 8, 10] {
    bad = all_of(bad, wrong_shift("u8x16", "shl", byte_lanes(simd.shl_u8x16(a, count)), xs, count, 8, false));
    bad = all_of(bad, wrong_shift("u8x16", "shr", byte_lanes(simd.shr_u8x16(a, count)), xs, count, 8, false));
  }
  return bad;
}

function lanes_i8x16(verb: string, a: i8x16, b: i8x16): i8x16 {
  return match (verb) {
    "add" => a + b,
    "sub" => a - b,
    "min" => simd.min_i8x16(a, b),
    "max" => simd.max_i8x16(a, b),
    "eq" => simd.eq_i8x16(a, b),
    "ne" => simd.ne_i8x16(a, b),
    "lt" => simd.lt_i8x16(a, b),
    "and" => simd.and_i8x16(a, b),
    "or" => simd.or_i8x16(a, b),
    "add_sat" => simd.add_sat_i8x16(a, b),
    "sub_sat" => simd.sub_sat_i8x16(a, b),
    _ => simd.xor_i8x16(a, b),
  };
}

function bytes_i8x16(v: i8x16): u8[] {
  return simd.with_i8x16(zeros16(), 0, v);
}

function check_i8x16(xs: u8[], ys: u8[]): string[] {
  let bad: string[] = [];
  for verb in ["add", "sub", "min", "max", "eq", "ne", "lt", "and", "or", "xor", "add_sat", "sub_sat"] {
    for at in [0, 16, 32, 48] {
      bad = all_of(bad, wrong_lanes("i8x16", verb, bytes_i8x16(lanes_i8x16(verb, simd.load_i8x16(xs, at), simd.load_i8x16(ys, at))), xs, ys, at, 8, true));
    }
  }
  let a = simd.load_i8x16(xs, 16);
  for count in [0, 1, 3, 7, 8, 10] {
    bad = all_of(bad, wrong_shift("i8x16", "shl", bytes_i8x16(simd.shl_i8x16(a, count)), xs, count, 8, true));
    bad = all_of(bad, wrong_shift("i8x16", "shr", bytes_i8x16(simd.shr_i8x16(a, count)), xs, count, 8, true));
  }
  for at in [0, 16, 32, 48] {
    bad = all_of(bad, wrong_lanes("i8x16", "neg", bytes_i8x16(-simd.load_i8x16(xs, at)), xs, xs, at, 8, true));
    bad = all_of(bad, wrong_lanes("i8x16", "abs", bytes_i8x16(simd.abs_i8x16(simd.load_i8x16(xs, at))), xs, xs, at, 8, true));
  }
  return bad;
}

// The mask of `1 < 3` in each lane, the mask of a select that takes each
// lane of its first value, and one lane of that select.
function values_i8x16(): string {
  let a = simd.splat_i8x16(3);
  let m = simd.lt_i8x16(simd.splat_i8x16(1), a);
  let s = simd.select_i8x16(a, simd.splat_i8x16(9), m);
  return simd.bitmask_i8x16(m).to_string() + " " + simd.bitmask_i8x16(simd.eq_i8x16(a, s)).to_string() + " " + (__i8x16_lane(s, 15) as i32).to_string();
}

function lanes_u16x8(verb: string, a: u16x8, b: u16x8): u16x8 {
  return match (verb) {
    "add" => a + b,
    "sub" => a - b,
    "mul" => a * b,
    "min" => simd.min_u16x8(a, b),
    "max" => simd.max_u16x8(a, b),
    "eq" => simd.eq_u16x8(a, b),
    "ne" => simd.ne_u16x8(a, b),
    "lt" => simd.lt_u16x8(a, b),
    "and" => simd.and_u16x8(a, b),
    "or" => simd.or_u16x8(a, b),
    "add_sat" => simd.add_sat_u16x8(a, b),
    "sub_sat" => simd.sub_sat_u16x8(a, b),
    "avg" => simd.avg_u16x8(a, b),
    _ => simd.xor_u16x8(a, b),
  };
}

function bytes_u16x8(v: u16x8): u8[] {
