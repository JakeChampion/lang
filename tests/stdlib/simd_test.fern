}

// The mask of `1 < 3` in each lane, the mask of a select that takes each
// lane of its first value, and one lane of that select.
function values_i32x4(): string {
  let a = simd.splat_i32x4(3);
  let m = simd.lt_i32x4(simd.splat_i32x4(1), a);
  let s = simd.select_i32x4(a, simd.splat_i32x4(9), m);
  return simd.bitmask_i32x4(m).to_string() + " " + simd.bitmask_i32x4(simd.eq_i32x4(a, s)).to_string() + " " + (__i32x4_lane(s, 3) as i32).to_string();
}

// Bytes that give each lane width equal pairs, the largest number and the
// smallest number.
function lane_inputs(): u8[][] {
  let xs = ramp(64);
  let ys: u8[] = [];
  for i in 0..64 {
    ys = ys.append(if (i < 8) { xs[i] } else { (i * 101 + 250) as u8 });
  }
  for i in 8..12 {
    xs = xs.with(i, 255 as u8).with(i + 16, 255 as u8);
  }
  xs = xs.with(12, 0 as u8).with(13, 128 as u8).with(14, 0 as u8).with(15, 128 as u8);
  xs = xs.with(28, 0 as u8).with(29, 0 as u8).with(30, 0 as u8).with(31, 128 as u8);
  ys = ys.with(12, 255 as u8).with(13, 255 as u8).with(14, 1 as u8).with(15, 0 as u8);
  return [xs, ys];
}

// Each operation on integer lanes agrees with its scalar form on each lane.
function test_integer_lanes_against_the_scalar(): test.TestOutcome {
  let inputs = lane_inputs();
  let bad = shifts_u8x16(inputs[0]);
  bad = all_of(bad, check_i8x16(inputs[0], inputs[1]));
  bad = all_of(bad, check_u16x8(inputs[0], inputs[1]));
  bad = all_of(bad, check_i16x8(inputs[0], inputs[1]));
  bad = all_of(bad, check_u32x4(inputs[0], inputs[1]));
  bad = all_of(bad, check_i32x4(inputs[0], inputs[1]));
  return test.assert_eq(bad.join(", "), "");
}

// A mask picks the lanes of a select, and gives one bit for each lane.
function test_integer_lane_masks(): test.TestOutcome {
  let got = values_i8x16() + " | " + values_u16x8() + " | " + values_i16x8() + " | " + values_u32x4() + " | " + values_i32x4();
  return test.assert_eq(got, "65535 65535 3 | 255 255 3 | 255 255 3 | 15 15 3 | 15 15 3");
}

function main(): i32 {
  let r = test.new("simd");
  r = r.it("kernel on f64", test_kernel_on_f64);
  r = r.it("kernel on f32", test_kernel_on_f32);
  r = r.it("LANES through a bound", test_lanes_const);
  r = r.it("dual polynomial", test_dual_polynomial);
  r = r.it("dual select", test_dual_select);
  r = r.it("dual sigmoid", test_dual_sigmoid);
  r = r.it("dual chain rules", test_dual_chain_rules);
  r = r.it("dual pow", test_dual_pow);
  r = r.it("double-double keeps low bits", test_dd_keeps_low_bits);
  r = r.it("double-double sqrt", test_dd_sqrt);
  r = r.it("double-double exp and log", test_dd_exp_log);
  r = r.it("double-double trig", test_dd_trig);
  r = r.it("double-double small arguments", test_dd_small_arguments);
  r = r.it("double-double generic kernel", test_dd_generic_kernel);
  r = r.it("dual of double-double", test_dual_of_dd);
  r = r.it("double-double over f32", test_dd_f32);
  r = r.it("eq is IEEE for NaN", test_eq_nan);
  r = r.it("sweep against std/f64", test_sweep_against_float);
  r = r.it("kernels on f64x2", test_kernel_on_f64x2);
  r = r.it("kernels on f32x4", test_kernel_on_f32x4);
  r = r.it("lane masks", test_lane_masks);
  r = r.it("lane helpers", test_lane_helpers);
  r = r.it("lane Math against the scalar", test_lane_math_sweep);
  r = r.it("byte lanes against the scalar", test_byte_lanes_against_the_scalar);
  r = r.it("byte lane masks", test_byte_lane_masks);
  r = r.it("byte lane memory", test_byte_lane_memory);
  r = r.it("integer lanes against the scalar", test_integer_lanes_against_the_scalar);
  r = r.it("integer lane masks", test_integer_lane_masks);
  return r.finish();
}
