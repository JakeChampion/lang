import "std/test";
import "std/string";

function test_is_int(): test.TestOutcome {
  let ok: boolean = "42".is_int() && "-42".is_int() && "+5".is_int();
  let no: boolean = !"4.5".is_int() && !"abc".is_int() && !"".is_int() && !"-".is_int();
  return test.assert_true(ok && no);
}

function test_is_float(): test.TestOutcome {
  let ok: boolean = "3.14".is_float() && "-0.5".is_float() && "5".is_float();
  let no: boolean = !"abc".is_float() && !"".is_float() && !"1.2.3".is_float();
  return test.assert_true(ok && no);
}

function test_is_numeric(): test.TestOutcome {
  return test.assert_true("12345".is_numeric() && !"12a".is_numeric() && !"".is_numeric());
}

function test_is_alpha_only(): test.TestOutcome {
  return test.assert_true("abcDEF".is_alpha_only() && !"ab1".is_alpha_only() && !"".is_alpha_only());
}

function test_is_blank(): test.TestOutcome {
  return test.assert_true("".is_blank() && "   ".is_blank() && !"  x ".is_blank());
}

function test_is_email_like(): test.TestOutcome {
  let ok: boolean = "a@b.com".is_email_like();
  let no: boolean = !"noat".is_email_like() && !"a@b".is_email_like() && !"@b.com".is_email_like();
  return test.assert_true(ok && no);
}

function test_is_url_like(): test.TestOutcome {
  let ok: boolean = "http://example.com".is_url_like() && "https://a.b/c".is_url_like();
  let no: boolean = !"ftp://x.y".is_url_like() && !"http://nodot".is_url_like();
  return test.assert_true(ok && no);
}

function test_capitalize(): test.TestOutcome {
  return test.assert_eq("hello".capitalize(), "Hello");
}

function test_capitalize_empty(): test.TestOutcome {
  return test.assert_eq("".capitalize(), "");
}

function test_title_case(): test.TestOutcome {
  return test.assert_eq("hello world".title_case(), "Hello World");
}

function test_snake_case(): test.TestOutcome {
  return test.assert_eq("camelCase".snake_case(), "camel_case");
}

function test_kebab_case(): test.TestOutcome {
  return test.assert_eq("camelCase".kebab_case(), "camel-case");
}

function test_snake_case_caps(): test.TestOutcome {
  return test.assert_eq("ABC".snake_case(), "a_b_c");
}

function test_snake_case_space_cap(): test.TestOutcome {
  return test.assert_eq("a B".snake_case(), "a__b");
}

function test_kebab_case_caps(): test.TestOutcome {
  return test.assert_eq("ABC".kebab_case(), "a-b-c");
}

function test_word_count(): test.TestOutcome {
  let n: i32 = "  hello   world  ".word_count();
  return test.assert_eq(n, 2);
}

function test_slugify(): test.TestOutcome {
  if ("Hello, World! 2024".slugify() != "hello-world-2024") {
    return test.fail("title");
  }
  if ("  --Foo__Bar--  ".slugify() != "foo-bar") {
    return test.fail("trim + collapse");
  }
  return test.assert_eq("already-a-slug".slugify(), "already-a-slug");
}

function test_slugify_edges(): test.TestOutcome {
  if ("!!!".slugify() != "") {
    return test.fail("all separators");
  }
  if ("".slugify() != "") {
    return test.fail("empty");
  }
  return test.assert_eq("café society".slugify(), "caf-society");
}

function test_pad_start(): test.TestOutcome {
  return test.assert_eq("7".pad_start(3, "0"), "007");
}

function test_pad_end(): test.TestOutcome {
  return test.assert_eq("7".pad_end(3, "."), "7..");
}

function test_truncate(): test.TestOutcome {
  return test.assert_eq("hello world".truncate(8, "..."), "hello...");
}

function test_ellipsis(): test.TestOutcome {
  return test.assert_eq("hello world".ellipsis(8), "hello...");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/string classify + transform");
  r = r.it("is_int", test_is_int);
  r = r.it("is_float", test_is_float);
  r = r.it("is_numeric", test_is_numeric);
  r = r.it("is_alpha_only", test_is_alpha_only);
  r = r.it("is_blank", test_is_blank);
  r = r.it("is_email_like", test_is_email_like);
  r = r.it("is_url_like", test_is_url_like);
  r = r.it("capitalize", test_capitalize);
  r = r.it("capitalize empty", test_capitalize_empty);
  r = r.it("title_case", test_title_case);
  r = r.it("snake_case", test_snake_case);
  r = r.it("snake_case caps", test_snake_case_caps);
  r = r.it("snake_case space+cap", test_snake_case_space_cap);
  r = r.it("kebab_case", test_kebab_case);
  r = r.it("kebab_case caps", test_kebab_case_caps);
  r = r.it("slugify", test_slugify);
  r = r.it("slugify edges", test_slugify_edges);
  r = r.it("word_count", test_word_count);
  r = r.it("pad_start", test_pad_start);
  r = r.it("pad_end", test_pad_end);
  r = r.it("truncate", test_truncate);
  r = r.it("ellipsis", test_ellipsis);
  return r.finish();
}
