import "std/test";
import "std/array" as array;

function unwrap(o: Option[f64]): f64 {
  match (o) {
    Some(v) => {
      return v;
    },
    None => {
      return 0.0 - 999.0;
    }
  }
}

function is_none(o: Option[f64]): boolean {
  match (o) {
    Some(v) => {
      return false;
    },
    None => {
      return true;
    }
  }
}

function test_variance(): test.TestOutcome {
  let xs: f64[] = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0];
  return test.assert_eq_f64_near(unwrap(array.variance_f64(xs)), 4.0, 0.0001);
}

function test_stddev(): test.TestOutcome {
  let xs: f64[] = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0];
  return test.assert_eq_f64_near(unwrap(array.stddev_f64(xs)), 2.0, 0.0001);
}

function test_single(): test.TestOutcome {
  let single: f64[] = [42.0];
  if (!is_zero(unwrap(array.variance_f64(single)))) {
    return test.fail("variance of one");
  }
  return test.assert_eq_f64_near(unwrap(array.stddev_f64(single)), 0.0, 0.0001);
}

function test_constant(): test.TestOutcome {
  let flat: f64[] = [3.0, 3.0, 3.0];
  return test.assert_eq_f64_near(unwrap(array.variance_f64(flat)), 0.0, 0.0001);
}

function test_empty_none(): test.TestOutcome {
  let empty: f64[] = [];
  if (!is_none(array.variance_f64(empty))) {
    return test.fail("variance of empty");
  }
  return test.assert_true(is_none(array.stddev_f64(empty)));
}

function is_zero(x: f64): boolean {
  let d: f64 = x;
  if (d < 0.0) {
    d = 0.0 - d;
  }
  return d < 0.0001;
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/array f64 stats");
  r = r.it("variance", test_variance);
  r = r.it("stddev", test_stddev);
  r = r.it("single value", test_single);
  r = r.it("constant", test_constant);
  r = r.it("empty -> none", test_empty_none);
  return r.finish();
}
