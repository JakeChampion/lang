import "std/test";
import "std/u32" as u32m;

function test_sqrt_floor(): test.TestOutcome {
  if ((100 as u32).sqrt_floor() != 10 as u32) {
    return test.fail("sqrt 100");
  }
  if ((99 as u32).sqrt_floor() != 9 as u32) {
    return test.fail("sqrt 99");
  }
  return test.assert_true((0 as u32).sqrt_floor() == 0 as u32);
}

function test_sqrt_floor_large(): test.TestOutcome {
  return test.assert_true((4294836225 as u32).sqrt_floor() == 65535 as u32);
}

function test_is_power_of_2(): test.TestOutcome {
  if (!(2147483648 as u32).is_power_of_2()) {
    return test.fail("2^31");
  }
  if ((6 as u32).is_power_of_2()) {
    return test.fail("6");
  }
  if ((0 as u32).is_power_of_2()) {
    return test.fail("0");
  }
  return test.assert_true((1 as u32).is_power_of_2());
}

function test_next_power_of_2(): test.TestOutcome {
  if ((5 as u32).next_power_of_2() != 8 as u32) {
    return test.fail("5 -> 8");
  }
  if ((16 as u32).next_power_of_2() != 16 as u32) {
    return test.fail("16 -> 16");
  }
  return test.assert_true((1 as u32).next_power_of_2() == 1 as u32);
}

function test_next_power_of_2_cap(): test.TestOutcome {
  if ((2147483648 as u32).next_power_of_2() != 2147483648 as u32) {
    return test.fail("2^31 unchanged");
  }
  if ((2147483648 as u32 + 1 as u32).next_power_of_2() != 0 as u32) {
    return test.fail("2^31 + 1 -> 0");
  }
  return test.assert_true((4294967295 as u32).next_power_of_2() == 0 as u32);
}

function test_log2_floor(): test.TestOutcome {
  if ((2147483648 as u32).log2_floor() != 31) {
    return test.fail("2^31 -> 31");
  }
  if ((1 as u32).log2_floor() != 0) {
    return test.fail("1 -> 0");
  }
  return test.assert_true((0 as u32).log2_floor() == 0 - 1);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/u32 roots");
  r = r.it("sqrt_floor", test_sqrt_floor);
  r = r.it("sqrt_floor large", test_sqrt_floor_large);
  r = r.it("is_power_of_2", test_is_power_of_2);
  r = r.it("next_power_of_2", test_next_power_of_2);
  r = r.it("next_power_of_2 cap", test_next_power_of_2_cap);
  r = r.it("log2_floor", test_log2_floor);
  return r.finish();
}
