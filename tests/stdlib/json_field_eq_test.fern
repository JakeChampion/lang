import "std/test";

function test_field_string_pass(): test.TestOutcome {
  return test.assert_json_eq_field(
    "{\"name\":\"alice\",\"city\":\"NYC\"}",
    "name", "alice",
  );
}

function test_field_string_wrong_value(): test.TestOutcome {
  match (test.assert_json_eq_field(
    "{\"name\":\"alice\"}", "name", "bob",
  )) {
    Pass => {
      return test.fail("wrong value should fail");
    },
    Fail(msg) => {
      if (!msg.contains("at \"name\"")
        || !msg.contains("\"alice\"")
        || !msg.contains("\"bob\"")) {
        return test.fail("expected key + both values: " + msg);
      }
      return test.pass();
    }
  }
}

function test_field_string_wrong_type(): test.TestOutcome {
  match (test.assert_json_eq_field(
    "{\"count\":42}", "count", "42",
  )) {
    Pass => {
      return test.fail("wrong type should fail");
    },
    Fail(msg) => {
      if (!msg.contains("expected a string, got a number")) {
        return test.fail("expected 'expected a string, got a number': " + msg);
      }
      return test.pass();
    }
  }
}

function test_field_string_missing_key(): test.TestOutcome {
  match (test.assert_json_eq_field(
    "{\"a\":\"x\"}", "missing", "y",
  )) {
    Pass => {
      return test.fail("missing key should fail");
    },
    Fail(msg) => {
      if (!msg.contains("\"missing\" not present")) {
        return test.fail("expected 'not present': " + msg);
      }
      return test.pass();
    }
  }
}

function test_field_string_invalid_json(): test.TestOutcome {
  match (test.assert_json_eq_field("not-json", "k", "v")) {
    Pass => {
      return test.fail("invalid JSON should fail");
    },
    Fail(msg) => {
      if (!msg.contains("not valid JSON")) {
        return test.fail("expected 'not valid JSON': " + msg);
      }
      return test.pass();
    }
  }
}

function test_field_i32_pass(): test.TestOutcome {
  return test.assert_json_eq_field(
    "{\"count\":42,\"name\":\"x\"}",
    "count", 42,
  );
}

function test_field_i32_wrong_value(): test.TestOutcome {
  match (test.assert_json_eq_field(
    "{\"count\":42}", "count", 99,
  )) {
    Pass => {
      return test.fail("wrong value should fail");
    },
    Fail(msg) => {
      if (!msg.contains("expected \"99\"") || !msg.contains("got \"42\"")) {
        return test.fail("expected both values: " + msg);
      }
      return test.pass();
    }
  }
}

function test_field_i32_wrong_type(): test.TestOutcome {
  match (test.assert_json_eq_field(
    "{\"count\":\"42\"}", "count", 42,
  )) {
    Pass => {
      return test.fail("string-value should fail");
    },
    Fail(msg) => {
      if (!msg.contains("expected an integer, got a string")) {
        return test.fail("expected 'expected an integer, got a string': " + msg);
      }
      return test.pass();
    }
  }
}

function test_field_i32_non_integer_number(): test.TestOutcome {
  match (test.assert_json_eq_field(
    "{\"count\":3.14}", "count", 3,
  )) {
    Pass => {
      return test.fail("decimal should not parse as i32");
    },
    Fail(msg) => {
      if (!msg.contains("expected an integer in the i32 range, got 3.14")) {
        return test.fail("expected parse-failure diag: " + msg);
      }
      return test.pass();
    }
  }
}

function test_field_i32_negative(): test.TestOutcome {
  return test.assert_json_eq_field(
    "{\"delta\":-7}", "delta", -7,
  );
}

function test_field_bool_true_pass(): test.TestOutcome {
  return test.assert_json_eq_field(
    "{\"ok\":true}", "ok", true,
  );
}

function test_field_bool_false_pass(): test.TestOutcome {
  return test.assert_json_eq_field(
    "{\"flag\":false}", "flag", false,
  );
}

function test_field_bool_wrong_value(): test.TestOutcome {
  match (test.assert_json_eq_field(
    "{\"ok\":true}", "ok", false,
  )) {
    Pass => {
      return test.fail("wrong bool should fail");
    },
    Fail(msg) => {
      if (!msg.contains("expected \"false\"") || !msg.contains("got \"true\"")) {
        return test.fail("expected both true/false: " + msg);
      }
      return test.pass();
    }
  }
}

function test_field_bool_wrong_type(): test.TestOutcome {
  match (test.assert_json_eq_field(
    "{\"ok\":\"true\"}", "ok", true,
  )) {
    Pass => {
      return test.fail("string-true should fail");
    },
    Fail(msg) => {
      if (!msg.contains("expected a boolean, got a string")) {
        return test.fail("expected 'expected a boolean, got a string': " + msg);
      }
      return test.pass();
    }
  }
}

function main(): i32 {
  let r = test.new("JSON field extraction");
  r = r.it("field_string pass", test_field_string_pass);
  r = r.it("field_string wrong value diag", test_field_string_wrong_value);
  r = r.it("field_string wrong type rejected", test_field_string_wrong_type);
  r = r.it("field_string missing key", test_field_string_missing_key);
  r = r.it("field_string invalid JSON", test_field_string_invalid_json);
  r = r.it("field_i32 pass", test_field_i32_pass);
  r = r.it("field_i32 wrong value shows both", test_field_i32_wrong_value);
  r = r.it("field_i32 wrong type rejected", test_field_i32_wrong_type);
  r = r.it("field_i32 decimal rejected", test_field_i32_non_integer_number);
  r = r.it("field_i32 negative", test_field_i32_negative);
  r = r.it("field_bool true pass", test_field_bool_true_pass);
  r = r.it("field_bool false pass", test_field_bool_false_pass);
  r = r.it("field_bool wrong value diag", test_field_bool_wrong_value);
  r = r.it("field_bool wrong type rejected", test_field_bool_wrong_type);
  return r.finish();
}
