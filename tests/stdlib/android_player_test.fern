import "std/android";
import "std/android/player";
import "std/test";

function simple_events(): test.TestOutcome {
  match (player.event(android.Posted(19, 0 as usize))) {
    Some(player.Prepared) => {},
    _ => {
      return test.fail("prepared event");
    }
  }
  match (player.event(android.Posted(20, 0 as usize))) {
    Some(player.Completed) => {},
    _ => {
      return test.fail("completion event");
    }
  }
  match (player.event(android.Posted(23, 0 as usize))) {
    Some(player.Seeked) => {},
    _ => {
      return test.fail("seek completion event");
    }
  }
  return test.assert_true(true);
}

// A target holds a frame once its transform is not the identity.
function target_frames(): test.TestOutcome {
  let one: f32 = 1.0;
  let zero: f32 = 0.0;
  let none = player.TargetFrame { matrix: [one, zero, zero, zero, zero, one, zero, zero, zero, zero, one, zero, zero, zero, zero, one], time_ns: 0i64 };
  let flip = player.TargetFrame { matrix: [one, zero, zero, zero, zero, 0.0 - one, zero, zero, zero, zero, one, zero, zero, one, zero, one], time_ns: 0i64 };
  let empty = player.TargetFrame { matrix: [], time_ns: 5i64 };
  return test.assert_eq(none.held().to_string() + " " + flip.held().to_string() + " " + empty.held().to_string(), "false true false");
}

function info_events(): test.TestOutcome {
  match (player.event(android.Posted(22, 3 as usize))) {
    Some(player.Rendering) => {},
    _ => {
      return test.fail("first rendered frame");
    }
  }
  match (player.event(android.Posted(22, 701 as usize))) {
    Some(player.Buffering(true)) => {},
    _ => {
      return test.fail("buffering start");
    }
  }
  match (player.event(android.Posted(22, 804 as usize))) {
    Some(player.AudioNotPlaying) => {},
    _ => {
      return test.fail("audio not playing");
    }
  }
  match (player.event(android.Posted(22, 805 as usize))) {
    Some(player.VideoNotPlaying) => {},
    _ => {
      return test.fail("video not playing");
    }
  }
  match (player.event(android.Posted(22, 702 as usize))) {
    Some(player.Buffering(false)) => {},
    _ => {
      return test.fail("buffering end");
    }
  }
  match (player.event(android.Posted(22, 900 as usize))) {
    None => {},
    _ => {
      return test.fail("unknown platform info");
    }
  }
  match (player.event(android.Posted(900, 0 as usize))) {
    None => {},
    _ => {
      return test.fail("other posted event");
    }
  }
  match (player.event(android.Tick)) {
    None => {},
    _ => {
      return test.fail("other activity event");
    }
  }
  return test.assert_true(true);
}

function error_events(): test.TestOutcome {
  for (what, extra) in [(1, -1004), (-38, -2147483648), (2147483647, -1)] {
    let packed = ((what as u64 & 4294967295u64) << 32u64 | extra as u64 & 4294967295u64) as usize;
    // Posted carries a pointer-width argument. Android targets use 64 bits.
    let expected_what = if (4294967296u64 as usize == 0 as usize) { 0 } else { what };
    match (player.event(android.Posted(21, packed))) {
      Some(player.Failed(a, b)) => {
        if (a != expected_what || b != extra) {
          return test.fail("signed platform error fields");
        }
      },
      _ => {
        return test.fail("platform failure event");
      }
    }
  }
  return test.assert_true(true);
}

// The bits above the low 8 of the kind hold the slot of the player that
// sent the event. Each kind decodes the same, and `sent` names the player.
function slot_events(): test.TestOutcome {
  let first = player.Player { obj: 0 as usize, listener: 0 as usize, slot: 0 };
  let second = player.Player { ...first, slot: 1 };
  let prepared = android.Posted(19 | 1 << 8, 0 as usize);
  match (player.event(prepared)) {
    Some(player.Prepared) => {},
    _ => {
      return test.fail("a prepared event of the second player");
    }
  }
  // Posted carries a pointer-width argument. Android targets use 64 bits.
  let what = if (4294967296u64 as usize == 0 as usize) { 0 } else { 1 };
  match (player.event(android.Posted(21 | 1 << 8, (1u64 << 32u64 | 4294966292u64) as usize))) {
    Some(player.Failed(a, b)) => {
      if (a != what || b != -1004) {
        return test.fail("a failure of the second player");
      }
    },
    _ => {
      return test.fail("a failure event of the second player");
    }
  }
  let other = android.Posted(27 | 1 << 8, 0 as usize);
  return test.assert_eq([second.sent(prepared), first.sent(prepared), first.sent(android.Posted(20, 0 as usize)), second.sent(other), second.sent(android.Tick)].map((b: boolean): string => b.to_string()).join(" "), "true false true false false");
}

function main(): i32 {
  let suite = test.new("Android media player events");
  suite = suite.it("prepared, completion, and seek", simple_events);
  suite = suite.it("rendering, buffering, and unrelated events", info_events);
  suite = suite.it("signed platform error codes", error_events);
  suite = suite.it("a target holds a frame once its transform turns", target_frames);
  suite = suite.it("the slot of the player that sent an event", slot_events);
  return suite.finish();
}
