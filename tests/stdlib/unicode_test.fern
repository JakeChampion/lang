import "std/test";
import "std/unicode" as unicode;

function test_ascii(): test.TestOutcome {
  return test.assert_true(unicode.to_upper("hello") == "HELLO"
    && unicode.to_lower("HeLLo") == "hello");
}

function test_latin1(): test.TestOutcome {
  return test.assert_true(unicode.to_upper("café") == "CAFÉ"
    && unicode.to_lower("ÜBER") == "über");
}

function test_greek(): test.TestOutcome {
  return test.assert_eq(unicode.to_upper("αβγδ"), "ΑΒΓΔ");
}

function test_cyrillic(): test.TestOutcome {
  return test.assert_eq(unicode.to_upper("привет"), "ПРИВЕТ");
}

function test_mixed_unchanged(): test.TestOutcome {
  return test.assert_eq(unicode.to_upper("a1-b2 c3!"), "A1-B2 C3!");
}

function test_already_folded(): test.TestOutcome {
  return test.assert_true(unicode.to_lower("content-length") == "content-length"
    && unicode.to_upper("ABC-1 !") == "ABC-1 !"
    && unicode.to_lower("") == ""
    && unicode.to_lower("x-Y") == "x-y");
}

function test_char_level(): test.TestOutcome {
  return test.assert_true((97 as char).to_upper() as i32 == 65
    && (913 as char).to_lower() as i32 == 945
    && (48 as char).to_upper() as i32 == 48);
}

function test_sharp_s_expands(): test.TestOutcome {
  if (unicode.to_upper("straße") != "STRASSE") {
    return test.fail("straße -> STRASSE");
  }
  if ((223 as char).to_upper() as i32 != 223) {
    return test.fail("to_upper_char leaves ß alone");
  }
  return test.pass();
}

function test_eq_ignore_case(): test.TestOutcome {
  if (!unicode.eq_ignore_case("Café", "cafÉ")) {
    return test.fail("Café ~ cafÉ");
  }
  if (!unicode.eq_ignore_case("ПРИВЕТ", "привет")) {
    return test.fail("cyrillic fold");
  }
  if (unicode.eq_ignore_case("abc", "abd")) {
    return test.fail("abc != abd");
  }
  if (unicode.eq_ignore_case("ab", "abc")) {
    return test.fail("length differs");
  }
  if (unicode.eq_ignore_case("abc", "ab")) {
    return test.fail("length differs, reversed");
  }
  if (!unicode.eq_ignore_case("K", "k")) {
    return test.fail("kelvin sign ~ k");
  }
  if (unicode.eq_ignore_case("K", "kk")) {
    return test.fail("kelvin sign != kk");
  }
  if (!unicode.eq_ignore_case("ß", "ss")) {
    return test.fail("ß ~ ss");
  }
  if (!unicode.eq_ignore_case("STRASSE", "straße")) {
    return test.fail("STRASSE ~ straße");
  }
  if (!unicode.eq_ignore_case("ſ", "s")) {
    return test.fail("long s ~ s");
  }
  if (unicode.eq_ignore_case("ß", "s")) {
    return test.fail("ß != s");
  }
  if (unicode.case_fold("ß") != "ss") {
    return test.fail("case_fold ß");
  }
  if (unicode.case_fold("HELLO") != "hello") {
    return test.fail("case_fold ascii");
  }
  return test.pass();
}

function test_roundtrip(): test.TestOutcome {
  let s: string = "Gross-Ελλάδα";
  if (unicode.to_lower(unicode.to_upper(s)) != unicode.to_lower(s)) {
    return test.fail("simple-mapping roundtrip");
  }
  let e: string = "Groß";
  if (unicode.to_lower(unicode.to_upper(e)) == unicode.to_lower(e)) {
    return test.fail("expansion should break the roundtrip");
  }
  return test.pass();
}

function test_is_letter(): test.TestOutcome {
  return test.assert_true((97 as char).is_letter() && (945 as char).is_letter()
    && (0x4E2D as char).is_letter() && !(48 as char).is_letter());
}

function test_is_digit(): test.TestOutcome {
  return test.assert_true((48 as char).is_digit() && (0x0669 as char).is_digit()
    && !(97 as char).is_digit());
}

function test_is_alnum_whitespace(): test.TestOutcome {
  if (!(97 as char).is_alnum() || !(48 as char).is_alnum()) {
    return test.fail("alnum");
  }
  if ((32 as char).is_alnum()) {
    return test.fail("space is not alnum");
  }
  if (!(32 as char).is_whitespace() || !(9 as char).is_whitespace()
    || !(0xA0 as char).is_whitespace()) {
    return test.fail("whitespace");
  }
  return test.assert_false((97 as char).is_whitespace());
}

function test_is_upper_lower(): test.TestOutcome {
  return test.assert_true((65 as char).is_upper() && !(97 as char).is_upper()
    && (97 as char).is_lower() && !(65 as char).is_lower()
    && (0x391 as char).is_upper() && (0x3B1 as char).is_lower());
}

function test_ascii_fast_path_agrees(): test.TestOutcome {
  if (unicode.to_upper("abcXYZ 123!") != "ABCXYZ 123!") {
    return test.fail("ascii fast path");
  }
  if (unicode.to_upper("abcXYZ 123!é") != "ABCXYZ 123!É") {
    return test.fail("decode path prefix");
  }
  if (unicode.to_lower("ABCxyz 123!") != "abcxyz 123!") {
    return test.fail("ascii fast path lower");
  }
  if (unicode.to_lower("ABCxyz 123!É") != "abcxyz 123!é") {
    return test.fail("decode path prefix lower");
  }
  if ((127 as char).to_upper() as i32 != 127) {
    return test.fail("U+007F unchanged");
  }
  if ((0xB5 as char).to_upper() as i32 != 0x39C) {
    return test.fail("µ -> Μ across the boundary");
  }
  return test.pass();
}

function test_alternating_run(): test.TestOutcome {
  if ((0x100 as char).to_lower() as i32 != 0x101) {
    return test.fail("Ā -> ā");
  }
  if ((0x101 as char).to_upper() as i32 != 0x100) {
    return test.fail("ā -> Ā");
  }
  if ((0x100 as char).to_upper() as i32 != 0x100) {
    return test.fail("Ā is already upper");
  }
  if ((0x101 as char).to_lower() as i32 != 0x101) {
    return test.fail("ā is already lower");
  }
  if ((0x12F as char).to_upper() as i32 != 0x12E) {
    return test.fail("į -> Į");
  }
  return test.assert_eq(unicode.to_upper("ăćĕ"), "ĂĆĔ");
}

function test_large_delta_and_non_bmp(): test.TestOutcome {
  if ((0x250 as char).to_upper() as i32 != 0x2C6F) {
    return test.fail("ɐ -> Ɐ (delta 10783)");
  }
  if ((0x10400 as char).to_lower() as i32 != 0x10428) {
    return test.fail("Deseret upper -> lower");
  }
  if ((0x10428 as char).to_upper() as i32 != 0x10400) {
    return test.fail("Deseret lower -> upper");
  }
  return test.assert_eq(unicode.to_upper("𐐨𐐩"), "𐐀𐐁");
}

function test_invalid_utf8_replaced(): test.TestOutcome {
  let bad: u8[] = [65 as u8, 200 as u8, 66 as u8];
  return test.assert_eq(unicode.to_lower(string_from_bytes_unchecked(bad)), "a�b");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/unicode");
  r = r.it("ascii", test_ascii);
  r = r.it("latin-1", test_latin1);
  r = r.it("greek", test_greek);
  r = r.it("cyrillic", test_cyrillic);
  r = r.it("mixed unchanged", test_mixed_unchanged);
  r = r.it("already folded", test_already_folded);
  r = r.it("char level", test_char_level);
  r = r.it("sharp-s expands", test_sharp_s_expands);
  r = r.it("eq_ignore_case", test_eq_ignore_case);
  r = r.it("roundtrip", test_roundtrip);
  r = r.it("is_letter", test_is_letter);
  r = r.it("is_digit", test_is_digit);
  r = r.it("is_alnum/space", test_is_alnum_whitespace);
  r = r.it("is_upper/lower", test_is_upper_lower);
  r = r.it("ascii fast path", test_ascii_fast_path_agrees);
  r = r.it("alternating run", test_alternating_run);
  r = r.it("big delta/non-BMP", test_large_delta_and_non_bmp);
  r = r.it("invalid utf-8", test_invalid_utf8_replaced);
  return r.finish();
}
