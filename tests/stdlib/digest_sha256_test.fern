import "std/test";
import "std/crypto" as crypto;
import "std/hex";
import "std/string";

function __pseudo(): u8[] {
  let b: u8[] = __alloc_u8(10003);
  let i: i32 = 0;
  while (i < 10003) {
    b = b.with(i, (i * 7 + 3 & 255) as u8);
    i = i + 1;
  }
  return b;
}

function __thousand_a(): string {
  let b: u8[] = __alloc_u8(1000);
  let i: i32 = 0;
  while (i < 1000) {
    b = b.with(i, 97 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

function test_empty(): test.TestOutcome {
  return test.assert_eq(hex.encode(crypto.sha256_new().finish()), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
}

function test_abc(): test.TestOutcome {
  return test.assert_eq(hex.encode(crypto.sha256_new().update("abc".as_bytes()).finish()), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

function test_multiblock(): test.TestOutcome {
  return test.assert_eq(
    hex.encode(crypto.sha256_new().update("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".as_bytes()).finish()),
    "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
  );
}

function test_bytes_len(): test.TestOutcome {
  return test.assert_eq(crypto.sha256_new().update("abc".as_bytes()).finish().len(), 32);
}

function test_million_a_chunked(): test.TestOutcome {
  let h: crypto.Sha256 = crypto.sha256_new();
  let chunk: string = __thousand_a();
  let i: i32 = 0;
  while (i < 1000) {
    h = h.update(chunk.as_bytes());
    i = i + 1;
  }
  return test.assert_eq(hex.encode(h.finish()), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");
}

function test_seven_byte_updates(): test.TestOutcome {
  let msg: u8[] = __pseudo();
  let h: crypto.Sha256 = crypto.sha256_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    h = h.update(msg[i:i + 7]);
    i = i + 7;
  }
  h = h.update(msg[i:10003]);
  let chunked: string = hex.encode(h.finish());
  let whole: string = hex.encode(crypto.sha256_new().update(msg).finish());
  if (chunked != "4b51b23bd24a332c4c0a2ac16cb3d573600091322e4b6f4ff6e64159ab69bc28") {
    return test.fail("chunked: " + chunked);
  }
  return test.assert_eq(chunked, whole);
}

function test_update_bytes_and_oneshot(): test.TestOutcome {
  let via_bytes: string = hex.encode(crypto.sha256_new().update("abc".bytes()).finish());
  if (via_bytes != hex.encode(crypto.sha256("abc".as_bytes()))) {
    return test.fail("one-shot differs: " + via_bytes);
  }
  return test.assert_eq(via_bytes, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/crypto SHA-256");
  r = r.it("empty", test_empty);
  r = r.it("abc", test_abc);
  r = r.it("multi-block", test_multiblock);
  r = r.it("final_bytes len", test_bytes_len);
  r = r.it("million a, 1000x1000", test_million_a_chunked);
  r = r.it("7-byte updates", test_seven_byte_updates);
  r = r.it("update_bytes + one-shot", test_update_bytes_and_oneshot);
  return r.finish();
}
