import "core/map";
import "std/test";
import "std/headers";

function test_case_insensitive_get(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.set("Content-Type", "application/json");
  return test.assert_is_some_eq_string(
    h.get("CONTENT-TYPE"),
    "application/json",
  );
}

function test_get_all_preserves_insertion_order(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.append("Set-Cookie", "a=1");
  h = h.append("Set-Cookie", "b=2");
  h = h.append("Set-Cookie", "c=3");
  return test.assert_eq_array(
    h.get_all("set-cookie"),
    ["a=1", "b=2", "c=3"],
  );
}

function test_set_replaces_then_size_2(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.append("X", "first");
  h = h.append("Y", "y1");
  h = h.append("X", "second");
  h = h.set("x", "replaced");
  return test.assert_eq(h.len(), 2);
}

function test_set_replaces_get_returns_new(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.append("X", "first");
  h = h.append("Y", "y1");
  h = h.append("X", "second");
  h = h.set("x", "replaced");
  return test.assert_is_some_eq_string(h.get("x"), "replaced");
}

function test_remove_drops_every_line(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new().append("X", "1").append("Y", "y").append("x", "2").remove("X");
  return test.assert_eq(h.len().to_string() + " " + h.names[0] + " " + h.has("x").to_string(), "1 Y false");
}

function test_set_on_absent_appends(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.set("X-First", "1");
  return test.assert_eq(h.len(), 1);
}

function test_get_all_on_missing_is_empty(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.append("X", "1");
  return test.assert_eq(h.get_all("Y").len(), 0);
}

function test_append_keeps_spelling(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.append("X-Request-ID", "1");
  return test.assert_eq(h.names[0], "X-Request-ID");
}

function test_set_takes_callers_spelling(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.append("content-type", "text/plain");
  h = h.append("Accept", "*/*");
  h = h.set("Content-Type", "application/json");
  if (h.len() != 2) {
    return test.fail("set added an entry instead of replacing one");
  }
  return test.assert_eq_array(h.names, ["Content-Type", "Accept"]);
}

function test_get_all_ignores_case(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.append("Via", "a");
  h = h.append("VIA", "b");
  h = h.append("via", "c");
  return test.assert_eq_array(h.get_all("vIa"), ["a", "b", "c"]);
}

function test_fold_is_ascii_only(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new();
  h = h.append("x-K", "kelvin");
  return test.assert_is_none_string(h.get("x-k"));
}

function joined(xs: string[]): string {
  let out: string = "";
  for x in xs {
    out = out + "[" + x + "]";
  }
  return out;
}

function test_split_list(): test.TestOutcome {
  return test.assert_eq(joined(headers.split_list(" a , \"b,c\",,  \"d\\\",e\" ,")), "[a][\"b,c\"][\"d\\\",e\"]");
}

function test_get_list(): test.TestOutcome {
  let h: HeaderMap = headers.header_map_new().append("Vary", "Accept, Origin").append("vary", "Cookie");
  return test.assert_eq(joined(h.get_list("VARY")), "[Accept][Origin][Cookie]");
}

function test_unquote(): test.TestOutcome {
  return test.assert_eq(headers.unquote("\"a\\\"b\\\\c\"") + "|" + headers.unquote("token") + "|" + headers.unquote("\""), "a\"b\\c|token|\"");
}

function coding(accept: string): string {
  let h: HeaderMap = headers.header_map_new();
  if (accept.len() > 0) {
    h = h.append("Accept-Encoding", accept);
  }
  match (h.preferred_coding(["br", "zstd", "gzip"])) {
    Some(c) => {
      return c;
    },
    None => {
      return "identity";
    }
  }
}

function test_preferred_coding(): test.TestOutcome {
  let got: string[] = [
    coding(""),
    coding("gzip, br"),
    coding("gzip;q=1.0, br;q=0.5"),
    coding("x-gzip"),
    coding("*;q=0.3, br;q=0"),
    coding("gzip;q=0.5, identity"),
    coding("deflate"),
    coding("br;q=bad, gzip;q=0.001"),
  ];
  return test.assert_eq(joined(got), "[identity][br][gzip][gzip][zstd][identity][identity][gzip]");
}

function test_weight(): test.TestOutcome {
  let got: string = headers.weight("a").to_string() + " " + headers.weight("a; Q=0.25").to_string() + " " + headers.weight("a;level=1;q=0.008").to_string() + " " + headers.weight("a;q=1.5").to_string() + " " + headers.weight("a;q=0.1234").to_string();
  return test.assert_eq(got, "1000 250 8 0 0");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("HeaderMap (migrated)");
  r = r.it(
    "case-insensitive get",
    test_case_insensitive_get,
  );
  r = r.it(
    "get_all preserves insertion order",
    test_get_all_preserves_insertion_order,
  );
  r = r.it(
    "set replaces drops dupes (size=2)",
    test_set_replaces_then_size_2,
  );
  r = r.it(
    "set replaces; get returns new value",
    test_set_replaces_get_returns_new,
  );
  r = r.it(
    "set on absent name appends",
    test_set_on_absent_appends,
  );
  r = r.it(
    "get_all on missing name is empty",
    test_get_all_on_missing_is_empty,
  );
  r = r.it(
    "append keeps the name's spelling",
    test_append_keeps_spelling,
  );
  r = r.it(
    "set takes the caller's spelling in place",
    test_set_takes_callers_spelling,
  );
  r = r.it(
    "get_all ignores case",
    test_get_all_ignores_case,
  );
  r = r.it(
    "names fold ASCII only",
    test_fold_is_ascii_only,
  );
  r = r.it("split_list respects quoted strings", test_split_list);
  r = r.it("get_list reads every line", test_get_list);
  r = r.it("unquote undoes a quoted string", test_unquote);
  r = r.it("preferred_coding ranks Accept-Encoding", test_preferred_coding);
  r = r.it("weight reads a qvalue", test_weight);
  r = r.it("remove drops every line of a name", test_remove_drops_every_line);
  return r.finish();
}
