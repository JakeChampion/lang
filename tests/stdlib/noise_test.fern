function bytes(h: string): u8[] {
  match (hex.decode(h)) {
    Ok(b) => {
      return b;
    },
    Err(e) => {
      return [];
    }
  }
  return [];
}

function key(h: string): Option[noise.KeyPair] {
  if (h == "") {
    return None;
  }
  match (noise.key_pair(bytes(h))) {
    Ok(k) => {
      return Some(k);
    },
    Err(e) => {
      return None;
    }
  }
  return None;
}

function public_key(h: string): Option[u8[]] {
  if (h == "") {
    return None;
  }
  return Some(bytes(h));
}

function psks(hs: string[]): u8[][] {
  let out: u8[][] = [];
  for h in hs {
    out = out.append(bytes(h));
  }
  return out;
}

function config(p: noise.Protocol, is_initiator: boolean, prologue: string, s: string, e: string, rs: string, ps: string[]): noise.Config {
  return noise.Config { protocol: p, is_initiator: is_initiator, prologue: bytes(prologue), s: key(s), rs: public_key(rs), psks: psks(ps), fixed_ephemeral: key(e) };
