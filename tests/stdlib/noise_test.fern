// One handshake message from the writer to the reader. The result is the
// failure, or "" and the two next states.
function step(own w: noise.Handshake, own r: noise.Handshake, payload: string, want: string): (string, noise.Handshake, noise.Handshake) {
  let pr = r;
  let (m, w2) = match (w.write_message(bytes(payload))) {
    Ok(x) => x,
    Err(e) => {
      return ("write: " + e.message(), pr, pr);
    },
  };
  if (hex.encode(m) != want) {
    return ("ciphertext " + hex.encode(m), w2, pr);
  }
  let (got, r2) = match (pr.read_message(m)) {
    Ok(x) => x,
    Err(e) => {
      return ("read: " + e.message(), w2, w2);
    },
  };
  if (hex.encode(got) != payload) {
    return ("payload " + hex.encode(got), w2, r2);
  }
  return ("", w2, r2);
}

function transport_step(own w: noise.Transport, own r: noise.Transport, payload: string, want: string): (string, noise.Transport, noise.Transport) {
  let pr = r;
  let (m, w2) = match (w.write(bytes(payload))) {
    Ok(x) => x,
    Err(e) => {
      return ("write: " + e.message(), pr, pr);
    },
  };
  if (hex.encode(m) != want) {
    return ("ciphertext " + hex.encode(m), w2, pr);
  }
  let (got, r2) = match (pr.read(m)) {
    Ok(x) => x,
    Err(e) => {
      return ("read: " + e.message(), w2, w2);
    },
  };
  if (hex.encode(got) != payload) {
    return ("payload " + hex.encode(got), w2, r2);
  }
  return ("", w2, r2);
}

function pair(v: Vector, p: noise.Protocol): Result[(noise.Handshake, noise.Handshake), string] {
  let ic = config(p, true, v.init_prologue, v.init_static, v.init_ephemeral, v.init_remote_static, v.init_psks);
  let rc = config(p, false, v.resp_prologue, v.resp_static, v.resp_ephemeral, v.resp_remote_static, v.resp_psks);
  let i = match (noise.handshake(ic)) {
    Ok(h) => h,
    Err(e) => {
      return Err("initiator: " + e.message());
    },
  };
  let r = match (noise.handshake(rc)) {
    Ok(h) => h,
    Err(e) => {
      return Err("responder: " + e.message());
    },
  };
  return Ok((i, r));
}

// The handshake messages, then the number of messages and the transport states.
function handshake_messages(v: Vector, own i: noise.Handshake, own r: noise.Handshake): Result[(i32, noise.Transport, noise.Transport), string] {
  let k = 0;
  while (!i.is_finished()) {
    let (err, w, rd) = if (k % 2 == 0) { step(i, r, v.payloads[k], v.ciphertexts[k]) } else { step(r, i, v.payloads[k], v.ciphertexts[k]) };
    if (err != "") {
      return Err("message " + k.to_string() + ": " + err);
    }
    i = if (k % 2 == 0) { w } else { rd };
    r = if (k % 2 == 0) { rd } else { w };
    k += 1;
  }
  if (hex.encode(i.handshake_hash()) != v.handshake_hash || hex.encode(r.handshake_hash()) != v.handshake_hash) {
    return Err("handshake hash " + hex.encode(i.handshake_hash()));
  }
  let Ok(it) = i.split() else {
    return Err("initiator split");
  };
  let Ok(rt) = r.split() else {
    return Err("responder split");
  };
  return Ok((k, it, rt));
}

function transport_messages(v: Vector, first: i32, own it: noise.Transport, own rt: noise.Transport): string {
  for k in first..v.payloads.len() {
    let (err, w, rd) = if (k % 2 == 0) { transport_step(it, rt, v.payloads[k], v.ciphertexts[k]) } else { transport_step(rt, it, v.payloads[k], v.ciphertexts[k]) };
    if (err != "") {
      return "message " + k.to_string() + ": " + err;
    }
    it = if (k % 2 == 0) { w } else { rd };
    rt = if (k % 2 == 0) { rd } else { w };
  }
  return "";
}

function run(v: Vector): string {
  let Ok(p) = noise.parse(v.name) else {
    return v.name + ": the name does not parse";
  };
  if (p.name() != v.name) {
    return v.name + ": the name is " + p.name();
  }
  let (i, r) = match (pair(v, p)) {
    Ok(x) => x,
    Err(e) => {
      return v.name + ": " + e;
    },
  };
  let (k, it, rt) = match (handshake_messages(v, i, r)) {
    Ok(x) => x,
    Err(e) => {
      return v.name + ": " + e;
    },
  };
  let err = transport_messages(v, k, it, rt);
  if (err != "") {
    return v.name + ": " + err;
  }
  return "";
}

