function test_vectors(): test.TestOutcome {
  for v in vectors() {
    let r = run(v);
    if (r != "") {
      return test.fail(r);
    }
  }
  return test.pass();
}

// "" when the result is the error that the test wants.
function refused[T](r: Result[T, noise.NoiseError], want: noise.NoiseError): string {
  return match (r) {
    Ok(_) => "accepted, want " + want.message(),
    Err(e) => if (e.message() == want.message()) { "" } else { e.message() + ", want " + want.message() },
  };
}

function outcome(r: string): test.TestOutcome {
  if (r != "") {
    return test.fail(r);
  }
  return test.pass();
}

function protocol(name: string): noise.Protocol {
  match (noise.parse(name)) {
    Ok(p) => {
      return p;
    },
    Err(e) => {
      eprint(e.message());
      exit(97);
    }
  }
  return noise.Protocol { pattern: noise.NN, psks: [], cipher: noise.ChaChaPoly };
}

function local(seed: i32): noise.KeyPair {
  match (noise.key_pair(__alloc_u8(32).with(0, seed as u8))) {
    Ok(k) => {
      return k;
    },
    Err(e) => {
      eprint(e.message());
      exit(97);
    }
  }
  return noise.generate_key_pair();
}

function start(c: noise.Config): noise.Handshake {
  match (noise.handshake(c)) {
    Ok(h) => {
      return h;
    },
    Err(e) => {
      eprint(e.message());
      exit(97);
    }
  }
  return start(c);
}

function test_names(): test.TestOutcome {
  for name in ["Noise_XX_448_ChaChaPoly_SHA256", "Noise_XK_25519_ChaChaPoly_SHA256", "Noise_XX_25519_ChaChaPoly_BLAKE2s", "Noise_XXpsk4_25519_AESGCM_SHA256", "Noise_NNpsk2+psk1_25519_AESGCM_SHA256", "Noise_NNpsk_25519_AESGCM_SHA256", "Noise_XX_25519_ChaChaPoly", "Noise_XX_25519_ChaChaPoly_SHA256_x"] {
    let r = refused(noise.parse(name), noise.Name(name));
    if (r != "") {
      return test.fail(name + ": " + r);
    }
  }
  return test.assert_eq(protocol("Noise_NNpsk0+psk2_25519_AESGCM_SHA256").name(), "Noise_NNpsk0+psk2_25519_AESGCM_SHA256");
}

function test_keys(): test.TestOutcome {
  let xx = protocol("Noise_XX_25519_ChaChaPoly_SHA256");
  let ik = protocol("Noise_IK_25519_ChaChaPoly_SHA256");
  let nn_psk = protocol("Noise_NNpsk0_25519_ChaChaPoly_SHA256");
  let anonymous = noise.Config { ...noise.initiator(xx, local(1)), s: None };
  let checks = [
    refused(noise.key_pair(__alloc_u8(31)), noise.KeyLength("private key", 31)),
    refused(noise.handshake(anonymous), noise.MissingKey("local static key")),
    refused(noise.handshake(noise.initiator(ik, local(1))), noise.MissingKey("remote static key")),
    refused(noise.handshake(noise.Config { ...noise.initiator(ik, local(1)), rs: Some(__alloc_u8(31)) }), noise.KeyLength("remote static key", 31)),
    refused(noise.handshake(noise.Config { ...noise.initiator(xx, local(1)), rs: Some(local(2).public_key) }), noise.UnusedKey("remote static key")),
    refused(noise.handshake(noise.initiator(nn_psk, local(1))), noise.MissingKey("PSK")),
    refused(noise.handshake(noise.Config { ...noise.initiator(nn_psk, local(1)), psks: [__alloc_u8(31)] }), noise.KeyLength("PSK", 31)),
    refused(noise.handshake(noise.Config { ...noise.initiator(xx, local(1)), psks: [__alloc_u8(32)] }), noise.UnusedKey("PSK")),
  ];
  for r in checks {
    if (r != "") {
      return test.fail(r);
    }
  }
  return test.pass();
}

// The first two messages of XX, with fresh ephemeral keys.
function xx_pair(): (noise.Handshake, noise.Handshake) {
  let xx = protocol("Noise_XX_25519_AESGCM_SHA256");
  let i = start(noise.initiator(xx, local(1)));
  let r = start(noise.responder(xx, local(2)));
  let (err, i2, r2) = step_any(i, r);
  let (err2, r3, i3) = step_any(r2, i2);
  if (err != "" || err2 != "") {
    eprint(err + err2);
    exit(97);
  }
  return (i3, r3);
}

function step_any(own w: noise.Handshake, own r: noise.Handshake): (string, noise.Handshake, noise.Handshake) {
  let pr = r;
  let (m, w2) = match (w.write_message([])) {
    Ok(x) => x,
    Err(e) => {
      return ("write: " + e.message(), pr, pr);
    },
  };
  let (_, r2) = match (pr.read_message(m)) {
    Ok(x) => x,
    Err(e) => {
      return ("read: " + e.message(), w2, w2);
    },
  };
  return ("", w2, r2);
}

function test_order(): test.TestOutcome {
  let xx = protocol("Noise_XX_25519_ChaChaPoly_SHA256");
  let checks = [
    refused(start(noise.responder(xx, local(2))).write_message([]), noise.Order),
    refused(start(noise.initiator(xx, local(1))).read_message(__alloc_u8(32)), noise.Order),
    refused(start(noise.initiator(xx, local(1))).split(), noise.Order),
  ];
  for r in checks {
    if (r != "") {
      return test.fail(r);
    }
  }
  let (i, r) = xx_pair();
  let (err, i2, r2) = step_any(i, r);
  if (err != "") {
    return test.fail(err);
  }
  if (!i2.is_finished() || !r2.is_finished()) {
    return test.fail("the handshake is not finished after three messages");
  }
  return outcome(refused(i2.write_message([]), noise.Finished));
}

// The third message of XX, and the responder that reads it.
function third(): (u8[], noise.Handshake) {
  let (i, r) = xx_pair();
  match (i.write_message("payload".as_bytes())) {
    Ok((m, _)) => {
      return (m, r);
    },
    Err(e) => {
      eprint(e.message());
      exit(97);
    }
  }
  return third();
}

// A consumed state cannot read again, so each check starts a handshake.
function test_tampered(): test.TestOutcome {
  let (m1, r1) = third();
  let (m2, r2) = third();
  let (_, r3) = third();
  let checks = [
    refused(r1.read_message(m1.with(40, m1[40] ^ 1u8)), noise.Decrypt),
    refused(r2.read_message(m2[0:20]), noise.Truncated),
    refused(r3.read_message(__alloc_u8(65536)), noise.MessageLength(65536)),
  ];
  for c in checks {
    if (c != "") {
      return test.fail(c);
    }
  }
  return test.pass();
}

// The transport states of the initiator and the responder after XX.
function session(): (noise.Transport, noise.Transport) {
  let (i, r) = xx_pair();
  let (err, i2, r2) = step_any(i, r);
  if (err != "") {
    eprint(err);
    exit(97);
  }
  let Ok(a) = i2.split() else {
    exit(97);
  };
  let Ok(b) = r2.split() else {
    exit(97);
  };
  return (a, b);
}

function test_handshake_result(): test.TestOutcome {
  let (i, r) = xx_pair();
  let (err, i2, r2) = step_any(i, r);
  if (err != "") {
    return test.fail(err);
  }
  let Some(seen) = r2.remote_static() else {
    return test.fail("the responder has no remote static key");
  };
  if (seen != local(1).public_key) {
    return test.fail("the responder holds the wrong remote static key");
  }
  if (i2.handshake_hash() != r2.handshake_hash()) {
    return test.fail("the handshake hashes differ");
  }
  let Ok(a) = i2.split() else {
    return test.fail("initiator split");
  };
  let Some(peer) = a.remote_static() else {
    return test.fail("the initiator transport has no remote static key");
  };
  return test.assert_eq(hex.encode(peer), hex.encode(local(2).public_key));
}

function test_session(): test.TestOutcome {
  let (a, b) = session();
  let Ok((m1, a2)) = a.write("one".as_bytes()) else {
    return test.fail("write one");
  };
  let Ok((m2, _)) = a2.write("one".as_bytes()) else {
    return test.fail("write two");
  };
  if (m1 == m2) {
    return test.fail("two messages have one nonce");
  }
  let Ok((opened, b2)) = b.read(m1) else {
    return test.fail("read one");
  };
  if (hex.encode(opened) != "6f6e65") {
    return test.fail("the payload changed");
  }
  return outcome(refused(b2.read(m1), noise.Decrypt));
}

// A consumed state cannot read again, so each check starts a session.
function test_transport_limits(): test.TestOutcome {
  let (_, b3) = session();
  let (_, b4) = session();
  let (a5, _) = session();
  let checks = [
    refused(b3.read(__alloc_u8(65536)), noise.MessageLength(65536)),
    refused(b4.read(__alloc_u8(15)), noise.Truncated),
    refused(a5.write(__alloc_u8(65520)), noise.MessageLength(65536)),
  ];
  for c in checks {
    if (c != "") {
      return test.fail(c);
    }
  }
  return test.pass();
}

function test_fresh_ephemeral(): test.TestOutcome {
  let xx = protocol("Noise_XX_25519_ChaChaPoly_SHA256");
  let Ok((m1, _)) = start(noise.initiator(xx, local(1))).write_message([]) else {
    return test.fail("first write");
  };
  let Ok((m2, _)) = start(noise.initiator(xx, local(1))).write_message([]) else {
    return test.fail("second write");
  };
  if (m1 == m2) {
    return test.fail("two handshakes have one ephemeral key");
  }
  return test.pass();
}

function test_low_order(): test.TestOutcome {
  let nk = protocol("Noise_NK_25519_ChaChaPoly_SHA256");
  let c = noise.Config { ...noise.initiator(nk, local(1)), s: None, rs: Some(__alloc_u8(32)) };
  return outcome(refused(start(c).write_message([]), noise.LowOrder));
}

function main(): i32 {
  let r = test.new("noise");
  r = r.it("cacophony vectors", test_vectors);
  r = r.it("protocol names", test_names);
  r = r.it("keys that the pattern needs", test_keys);
  r = r.it("message order", test_order);
  r = r.it("a damaged handshake message", test_tampered);
  r = r.it("the result of a handshake", test_handshake_result);
  r = r.it("a transport session", test_session);
  r = r.it("transport message limits", test_transport_limits);
  r = r.it("a fresh ephemeral key", test_fresh_ephemeral);
  r = r.it("a low-order public key", test_low_order);
  return r.finish();
}
