import "std/test";
import "std/crypto" as crypto;
import "std/hex";
import "std/string";

function __pseudo(): u8[] {
  let b: u8[] = __alloc_u8(10003);
  let i: i32 = 0;
  while (i < 10003) {
    b = b.with(i, (i * 7 + 3 & 255) as u8);
    i = i + 1;
  }
  return b;
}

function __thousand_a(): string {
  let b: u8[] = __alloc_u8(1000);
  let i: i32 = 0;
  while (i < 1000) {
    b = b.with(i, 97 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

function test_empty(): test.TestOutcome {
  return test.assert_eq(hex.encode(crypto.sha512_new().finish()), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e");
}

function test_abc(): test.TestOutcome {
  return test.assert_eq(hex.encode(crypto.sha512_new().update("abc".as_bytes()).finish()), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
}

function test_multiblock(): test.TestOutcome {
  return test.assert_eq(
    hex.encode(crypto.sha512_new().update("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".as_bytes()).finish()),
    "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",
  );
}

function test_bytes_len(): test.TestOutcome {
  return test.assert_eq(crypto.sha512_new().update("abc".as_bytes()).finish().len(), 64);
}

function test_million_a_chunked(): test.TestOutcome {
  let h: crypto.Sha512 = crypto.sha512_new();
  let chunk: string = __thousand_a();
  let i: i32 = 0;
  while (i < 1000) {
    h = h.update(chunk.as_bytes());
    i = i + 1;
  }
  return test.assert_eq(hex.encode(h.finish()), "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b");
}

function test_seven_byte_updates(): test.TestOutcome {
  let msg: u8[] = __pseudo();
  let h: crypto.Sha512 = crypto.sha512_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    h = h.update(msg[i:i + 7]);
    i = i + 7;
  }
  h = h.update(msg[i:10003]);
  let chunked: string = hex.encode(h.finish());
  let whole: string = hex.encode(crypto.sha512_new().update(msg).finish());
  if (chunked != "436cf1f167ed2199d3b6b342af4b1a8c727741672ba32805c492d67fa5eb6a13f9c06cf79b29c167ea5df115f296a84d824c5db2fcb4a8e815893b12566e6d36") {
    return test.fail("chunked: " + chunked);
  }
  return test.assert_eq(chunked, whole);
}

function test_update_bytes_and_oneshot(): test.TestOutcome {
  let via_bytes: string = hex.encode(crypto.sha512_new().update("abc".bytes()).finish());
  if (via_bytes != hex.encode(crypto.sha512("abc".as_bytes()))) {
    return test.fail("one-shot differs: " + via_bytes);
  }
  return test.assert_eq(via_bytes, "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/crypto SHA-512");
  r = r.it("empty", test_empty);
  r = r.it("abc", test_abc);
  r = r.it("multi-block", test_multiblock);
  r = r.it("finish len", test_bytes_len);
  r = r.it("million a, 1000x1000", test_million_a_chunked);
  r = r.it("7-byte updates", test_seven_byte_updates);
  r = r.it("update_bytes + one-shot", test_update_bytes_and_oneshot);
  return r.finish();
}
