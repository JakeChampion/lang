import "std/audio/caf";
import "std/audio/caf/file";
import "std/audio/pcm";
import "aac_kernel_check" as ref;
import "alac_smoke_vectors";
import "caf_smoke_vectors";
import "caf_check";

function inspect(reader: Reader): Result[file.Index, string] {
  let bytes = match (reader.seek(0i64, 2)) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
  let builder = match (file.create(bytes, file.default_limits())) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
  while (true) {
    let (next, event) = match (builder.step(reader)) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
    builder = next;
    match (event) {
      file.BuildReady(index) => {
        return Ok(index);
      },
      file.BuildFinished => {
        return Err("missing source index");
      },
      file.BuildPending => {}
    }
  }
}

function tail(own cursor: file.Cursor, reader: Reader, expected: [u8], vector: caf_check.Reference, position: i64, capacity: i32): Result[file.Cursor, string] {
  let storage = pcm.zeros(capacity + 1).with(capacity, 123456789);
  let at = position;
  while (true) {
    let (next, event) = match (cursor.step_into(storage, reader)) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
    cursor = next;
    match (event) {
      caf.BufferPending(value) => {
        storage = value;
      },
      caf.BufferSamples(value) => {
        if (value.position != at || value.channel_mask != vector.mask) {
          return Err("Reader PCM range");
        }
        caf_check.samples(value.samples, value.start, value.frames, value.position, expected, vector.channels, vector)?;
        at += value.frames as i64;
        storage = value.samples;
      },
      caf.BufferFinished(value) => {
        if (at != vector.frames as i64 || value.len() != capacity + 1 || value[capacity] != 123456789) {
          return Err("Reader completion or suffix");
        }
        return Ok(cursor);
      }
    }
    if (storage.len() != capacity + 1 || storage[capacity] != 123456789) {
      return Err("Reader buffer suffix");
    }
  }
}

function decode(reader: Reader): Result[void, string] {
  let index = inspect(reader)?;
  let source = alac_smoke_vectors.vector();
  let vector = caf_smoke_vectors.vector();
  let expected = ref.unpack(source.pcm)?;
  let reference = caf_check.Reference { rate: source.rate, channels: source.channels, depth: source.depth, trim: vector.trim, frames: vector.frames, mask: vector.mask, order: vector.order };
  let info = index.information();
  if (info.frames != vector.frames as i64 || info.priming != vector.trim as i64) {
    return Err("Reader index information");
  }
  let cursor = match (file.cursor(index)) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
  for position in [info.frames, 0i64, 1i64, info.frames - 1i64, info.frames / 2i64, 0i64] {
    cursor = match (cursor.seek(position)) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
    cursor = tail(cursor, reader, expected, reference, position, index.max_packet_frames() * source.channels)?;
  }
  return Ok(());
}

function read_file(path: string): Result[void, string] {
  let reader = match (open_reader(path)) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
  let result = decode(reader);
  let closed = reader.close();
  result?;
  return match (closed) { Ok(_) => Ok(()), Err(e) => Err(e.message()) };
}

function main(): i32 {
  let argv = args();
  if (argv.len() != 2) {
    return 2;
  }
  return match (read_file(argv[1])) { Ok(_) => 0, Err(message) => { eprint(message); return 1; } };
}
