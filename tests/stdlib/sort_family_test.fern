import "std/test";
import "core/cmp";
import "std/string";

// tests/stdlib/sort_family_test.fern — core/cmp's sort family past what
// sort_by_and_ci_test covers: the four `_in_place` heapsorts over empty,
// single, reversed and duplicate-heavy input, stability of `sort_by` and
// `sort_by_key` on tagged records, and std/string's `cmp_ignore_ascii_case`.

struct Tagged { key: string, tag: i32 }

function reversed(n: i32): i32[] {
  let xs: i32[] = [];
  let i: i32 = n;
  while (i > 0) {
    xs = xs.append(i);
    i = i - 1;
  }
  return xs;
}

function ascending_from(xs: i32[], first: i32): boolean {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] != first + i) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function by_key(t: Tagged): string {
  return t.key;
}

function tags(ts: Tagged[]): i32[] {
  let out: i32[] = [];
  for t in ts {
    out = out.append(t.tag);
  }
  return out;
}

function test_sort_in_place_reversed(): test.TestOutcome {
  let xs: i32[] = cmp.sort_in_place(reversed(100));
  return test.assert_true(xs.len() == 100 && ascending_from(xs, 1));
}

function test_sort_in_place_duplicates(): test.TestOutcome {
  return test.assert_eq_array(cmp.sort_in_place([3, 1, 3, 2, 1, 2]), [1, 1, 2, 2, 3, 3]);
}

function test_sort_in_place_empty_and_single(): test.TestOutcome {
  let empty: i32[] = cmp.sort_in_place([]);
  let one: i32[] = cmp.sort_in_place([7]);
  return test.assert_true(empty.len() == 0 && one.len() == 1 && one[0] == 7);
}

function test_sort_in_place_strings(): test.TestOutcome {
  return test.assert_eq_array(cmp.sort_in_place(["pear", "apple", "fig"]), ["apple", "fig", "pear"]);
}

function test_sort_desc_in_place(): test.TestOutcome {
  let xs: i32[] = cmp.sort_desc_in_place([2, 9, 4, 7]);
  let ys: i32[] = cmp.sort_desc_in_place([]);
  if (ys.len() != 0) {
    return test.fail("empty");
  }
  return test.assert_eq_array(xs, [9, 7, 4, 2]);
}

function test_sort_by_in_place(): test.TestOutcome {
  let xs: i32[] = cmp.sort_by_in_place(reversed(100), (a: i32, b: i32): i32 => a - b);
  let one: i32[] = cmp.sort_by_in_place([5], (a: i32, b: i32): i32 => b - a);
  if (one[0] != 5) {
    return test.fail("single");
  }
  return test.assert_true(ascending_from(xs, 1));
}

function test_sort_by_key_in_place(): test.TestOutcome {
  let ws: string[] = cmp.sort_by_key_in_place(["ccc", "a", "bb", ""], (w: string): i32 => w.len());
  let none: string[] = cmp.sort_by_key_in_place([], (w: string): i32 => w.len());
  if (none.len() != 0) {
    return test.fail("empty");
  }
  return test.assert_eq_array(ws, ["", "a", "bb", "ccc"]);
}

// Equal keys keep their input order through the merge.
function test_sort_by_stable_records(): test.TestOutcome {
  let ts: Tagged[] = [Tagged { key: "b", tag: 1 }, Tagged { key: "a", tag: 2 }, Tagged { key: "b", tag: 3 }, Tagged { key: "a", tag: 4 }];
  let out: Tagged[] = cmp.sort_by(ts, (x: Tagged, y: Tagged): i32 => x.key.cmp(y.key));
  return test.assert_eq_array(tags(out), [2, 4, 1, 3]);
}

function test_sort_by_key_stable_string_key(): test.TestOutcome {
  let ts: Tagged[] = [Tagged { key: "b", tag: 1 }, Tagged { key: "a", tag: 2 }, Tagged { key: "b", tag: 3 }, Tagged { key: "a", tag: 4 }];
  return test.assert_eq_array(tags(cmp.sort_by_key(ts, by_key)), [2, 4, 1, 3]);
}

function test_is_sorted_by(): test.TestOutcome {
  let up: boolean = cmp.is_sorted_by([1, 2, 2, 3], (a: i32, b: i32): i32 => a - b);
  let down: boolean = cmp.is_sorted_by([1, 3, 2], (a: i32, b: i32): i32 => a - b);
  return test.assert_true(up && !down);
}

function test_cmp_ignore_ascii_case(): test.TestOutcome {
  let lt: boolean = "Apple".cmp_ignore_ascii_case("banana") == -1;
  let eq: boolean = "HeLLo".cmp_ignore_ascii_case("hello") == 0;
  let gt: boolean = "zeta".cmp_ignore_ascii_case("ALPHA") == 1;
  return test.assert_true(lt && eq && gt);
}

// A prefix orders first, whatever the case of the shared part.
function test_cmp_ignore_ascii_case_prefix(): test.TestOutcome {
  let shorter: boolean = "AB".cmp_ignore_ascii_case("abc") == -1;
  let longer: boolean = "abc".cmp_ignore_ascii_case("AB") == 1;
  let empty: boolean = "".cmp_ignore_ascii_case("") == 0;
  return test.assert_true(shorter && longer && empty);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("cmp sort family");
  r = r.it("sort_in_place reversed 100", test_sort_in_place_reversed);
  r = r.it("sort_in_place duplicates", test_sort_in_place_duplicates);
  r = r.it("sort_in_place empty and single", test_sort_in_place_empty_and_single);
  r = r.it("sort_in_place strings", test_sort_in_place_strings);
  r = r.it("sort_desc_in_place", test_sort_desc_in_place);
  r = r.it("sort_by_in_place", test_sort_by_in_place);
  r = r.it("sort_by_key_in_place", test_sort_by_key_in_place);
  r = r.it("sort_by stable records", test_sort_by_stable_records);
  r = r.it("sort_by_key stable string key", test_sort_by_key_stable_string_key);
  r = r.it("is_sorted_by", test_is_sorted_by);
  r = r.it("cmp_ignore_ascii_case", test_cmp_ignore_ascii_case);
  r = r.it("cmp_ignore_ascii_case prefix", test_cmp_ignore_ascii_case_prefix);
  return r.finish();
}
