import "std/test";

function test_one_of_i32_pass(): test.TestOutcome {
  return test.assert_one_of_i32(1, [0, 1, 2]);
}

function test_one_of_i32_single_element(): test.TestOutcome {
  return test.assert_one_of_i32(42, [42]);
}

function test_one_of_i32_first_element(): test.TestOutcome {
  return test.assert_one_of_i32(0, [0, 1, 2]);
}

function test_one_of_i32_last_element(): test.TestOutcome {
  return test.assert_one_of_i32(2, [0, 1, 2]);
}

function test_one_of_i32_missing_reports_set(): test.TestOutcome {
  match (test.assert_one_of_i32(99, [0, 1, 2])) {
    Pass => {
      return test.fail("expected fail for value not in set");
    },
    Fail(msg) => {
      if (!msg.contains("99") || !msg.contains("[0, 1, 2]")) {
        return test.fail("expected '99' + '[0, 1, 2]' in failure: " + msg);
      }
      return test.pass();
    }
  }
}

function test_one_of_i32_empty_set_always_fails(): test.TestOutcome {
  let empty: i32[] = [];
  match (test.assert_one_of_i32(0, empty)) {
    Pass => {
      return test.fail("empty allowed set should always fail");
    },
    Fail(_) => {
      return test.pass();
    }
  }
}

function test_one_of_string_pass(): test.TestOutcome {
  return test.assert_one_of_string(
    "GET",
    ["GET", "HEAD", "OPTIONS"],
  );
}

function test_one_of_string_missing_reports(): test.TestOutcome {
  match (test.assert_one_of_string(
    "POST",
    ["GET", "HEAD", "OPTIONS"],
  )) {
    Pass => {
      return test.fail("expected POST to fail");
    },
    Fail(msg) => {
      if (!msg.contains("\"POST\"") || !msg.contains("\"GET\"")) {
        return test.fail("expected quoted POST + GET in failure: " + msg);
      }
      return test.pass();
    }
  }
}

function test_none_of_i32_pass(): test.TestOutcome {
  return test.assert_none_of_i32(0, [127, 128, 130]);
}

function test_none_of_i32_match_reports(): test.TestOutcome {
  match (test.assert_none_of_i32(127, [127, 128, 130])) {
    Pass => {
      return test.fail("expected forbidden-match to fail");
    },
    Fail(msg) => {
      if (!msg.contains("127")) {
        return test.fail("expected '127' in failure: " + msg);
      }
      return test.pass();
    }
  }
}

function test_none_of_i32_empty_forbidden_always_passes(): test.TestOutcome {
  let empty: i32[] = [];
  return test.assert_none_of_i32(42, empty);
}

function test_none_of_string_pass(): test.TestOutcome {
  return test.assert_none_of_string(
    "hello",
    ["error", "fatal", "panic"],
  );
}

function test_none_of_string_match_reports(): test.TestOutcome {
  match (test.assert_none_of_string(
    "fatal",
    ["error", "fatal", "panic"],
  )) {
    Pass => {
      return test.fail("expected forbidden-match to fail");
    },
    Fail(msg) => {
      if (!msg.contains("\"fatal\"")) {
        return test.fail("expected '\"fatal\"' in failure: " + msg);
      }
      return test.pass();
    }
  }
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("one_of / none_of");
  r = r.it("one_of_i32 middle element", test_one_of_i32_pass);
  r = r.it("one_of_i32 single-element set", test_one_of_i32_single_element);
  r = r.it("one_of_i32 first element", test_one_of_i32_first_element);
  r = r.it("one_of_i32 last element", test_one_of_i32_last_element);
  r = r.it("one_of_i32 missing renders set", test_one_of_i32_missing_reports_set);
  r = r.it("one_of_i32 empty set always fails", test_one_of_i32_empty_set_always_fails);
  r = r.it("one_of_string pass", test_one_of_string_pass);
  r = r.it("one_of_string missing quotes both", test_one_of_string_missing_reports);
  r = r.it("none_of_i32 pass", test_none_of_i32_pass);
  r = r.it("none_of_i32 match reports value", test_none_of_i32_match_reports);
  r = r.it("none_of_i32 empty list vacuous", test_none_of_i32_empty_forbidden_always_passes);
  r = r.it("none_of_string pass", test_none_of_string_pass);
  r = r.it("none_of_string match quoted", test_none_of_string_match_reports);
  return r.finish();
}
