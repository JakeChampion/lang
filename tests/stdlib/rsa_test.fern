import "std/test";
import "std/hex";
import "std/string";
import "std/crypto/rsa";

// tests/stdlib/rsa_test.fern — std/crypto/rsa against signatures Python's
// cryptography package made: PKCS#1 v1.5 and PSS over SHA-256, SHA-384 and
// SHA-512 under a 2048-bit key, and under a 2049-bit key, where PSS's
// encoded message is one byte shorter than the modulus. Tampering, a
// signature checked under the other scheme or digest, and a malformed key
// are refused.

function k2048_n(): string {
  return "";
}

function k2048_pkcs1_sha256(): string {
  return "";
}

function k2048_pkcs1_sha384(): string {
  return "";
}

function k2048_pkcs1_sha512(): string {
  return "";
}

function k2048_pss_sha256(): string {
  return "";
}

function k2048_pss_sha384(): string {
  return "";
}

function k2048_pss_sha512(): string {
  return "";
}

function k2049_n(): string {
  return "";
}

function k2049_pkcs1_sha256(): string {
  return "";
}

function k2049_pkcs1_sha512(): string {
  return "";
}

function k2049_pss_sha256(): string {
  return "";
}

function k2049_pss_sha512(): string {
  return "";
}

function message(): u8[] {
  return "fern rsa verification".bytes();
}

function pkcs1(n: string, h: rsa.Hash, msg: u8[], sig: string): boolean {
  match (rsa.public_key(hex.hex_decode(n), hex.hex_decode("010001"))) {
    Ok(k) => {
      return rsa.verify_pkcs1v15(k, h, msg, hex.hex_decode(sig));
    },
    Err(e) => {
      return false;
    }
  }
  return false;
}

function pss(n: string, h: rsa.Hash, msg: u8[], sig: string): boolean {
  match (rsa.public_key(hex.hex_decode(n), hex.hex_decode("010001"))) {
    Ok(k) => {
      return rsa.verify_pss(k, h, msg, hex.hex_decode(sig));
    },
    Err(e) => {
      return false;
    }
  }
  return false;
}

function test_pkcs1_2048_sha256(): test.TestOutcome {
  return test.assert_true(pkcs1(k2048_n(), rsa.Sha256, message(), k2048_pkcs1_sha256()));
}

function test_pkcs1_2048_sha384(): test.TestOutcome {
  return test.assert_true(pkcs1(k2048_n(), rsa.Sha384, message(), k2048_pkcs1_sha384()));
}

function test_pkcs1_2048_sha512(): test.TestOutcome {
  return test.assert_true(pkcs1(k2048_n(), rsa.Sha512, message(), k2048_pkcs1_sha512()));
}

function test_pss_2048_sha256(): test.TestOutcome {
  return test.assert_true(pss(k2048_n(), rsa.Sha256, message(), k2048_pss_sha256()));
}

function test_pss_2048_sha384(): test.TestOutcome {
  return test.assert_true(pss(k2048_n(), rsa.Sha384, message(), k2048_pss_sha384()));
}

function test_pss_2048_sha512(): test.TestOutcome {
  return test.assert_true(pss(k2048_n(), rsa.Sha512, message(), k2048_pss_sha512()));
}

function test_pkcs1_2049_sha256(): test.TestOutcome {
  return test.assert_true(pkcs1(k2049_n(), rsa.Sha256, message(), k2049_pkcs1_sha256()));
}

function test_pkcs1_2049_sha512(): test.TestOutcome {
  return test.assert_true(pkcs1(k2049_n(), rsa.Sha512, message(), k2049_pkcs1_sha512()));
}

function test_pss_2049_sha256(): test.TestOutcome {
  return test.assert_true(pss(k2049_n(), rsa.Sha256, message(), k2049_pss_sha256()));
}

function test_pss_2049_sha512(): test.TestOutcome {
  return test.assert_true(pss(k2049_n(), rsa.Sha512, message(), k2049_pss_sha512()));
}

// A signature over another message, a flipped bit, the other scheme, the
// other digest, or the wrong length does not verify.
function test_refusals(): test.TestOutcome {
  let other: u8[] = "fern rsa verification!".bytes();
  if (pkcs1(k2048_n(), rsa.Sha256, other, k2048_pkcs1_sha256()) || pss(k2048_n(), rsa.Sha256, other, k2048_pss_sha256())) {
    return test.fail("a signature over another message verified");
  }
  let flipped: u8[] = hex.hex_decode(k2048_pss_sha256());
  flipped = flipped.with(100, flipped[100] ^ 1 as u8);
  if (pss(k2048_n(), rsa.Sha256, message(), hex.hex_encode(flipped))) {
    return test.fail("a flipped bit verified");
  }
  if (pss(k2048_n(), rsa.Sha256, message(), k2048_pkcs1_sha256()) || pkcs1(k2048_n(), rsa.Sha256, message(), k2048_pss_sha256())) {
    return test.fail("a signature verified under the other scheme");
  }
  if (pkcs1(k2048_n(), rsa.Sha384, message(), k2048_pkcs1_sha256()) || pss(k2048_n(), rsa.Sha512, message(), k2048_pss_sha256())) {
    return test.fail("a signature verified under the other digest");
  }
  if (pkcs1(k2048_n(), rsa.Sha256, message(), "00" + k2048_pkcs1_sha256()) || pkcs1(k2049_n(), rsa.Sha256, message(), k2048_pkcs1_sha256())) {
    return test.fail("a signature of the wrong length verified");
  }
  return test.pass();
}

function test_bad_keys(): test.TestOutcome {
  match (rsa.public_key(hex.hex_decode("c3"), hex.hex_decode("010001"))) {
    Ok(k) => {
      return test.fail("an 8-bit modulus was accepted");
    },
    Err(e) => {
      if (e.message() != "rsa: the modulus is 8 bits, want at least 1024") {
        return test.fail(e.message());
      }
    }
  }
  match (rsa.public_key(hex.hex_decode(k2048_n()), hex.hex_decode("010000"))) {
    Ok(k) => {
      return test.fail("an even exponent was accepted");
    },
    Err(e) => {
      return test.assert_eq(e.message(), "rsa: the exponent must be odd and at least 3");
    }
  }
  return test.pass();
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/crypto/rsa");
  r = r.it("pkcs1 2048-bit sha256", test_pkcs1_2048_sha256);
  r = r.it("pkcs1 2048-bit sha384", test_pkcs1_2048_sha384);
  r = r.it("pkcs1 2048-bit sha512", test_pkcs1_2048_sha512);
  r = r.it("pss 2048-bit sha256", test_pss_2048_sha256);
  r = r.it("pss 2048-bit sha384", test_pss_2048_sha384);
  r = r.it("pss 2048-bit sha512", test_pss_2048_sha512);
  r = r.it("pkcs1 2049-bit sha256", test_pkcs1_2049_sha256);
  r = r.it("pkcs1 2049-bit sha512", test_pkcs1_2049_sha512);
  r = r.it("pss 2049-bit sha256", test_pss_2049_sha256);
  r = r.it("pss 2049-bit sha512", test_pss_2049_sha512);
  r = r.it("refusals", test_refusals);
  r = r.it("malformed keys", test_bad_keys);
  return r.finish();
}
