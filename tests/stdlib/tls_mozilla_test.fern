import "std/test";
import "std/hex";
import "std/codec";
import "std/tls/mozilla";
import "std/tls/verify";
import "std/tls/x509";

// tests/stdlib/tls_mozilla_test.fern — std/tls/mozilla: every bundled root
// parses; the list is Mozilla's, with ISRG Root X1 in it and a root Mozilla
// distrusts for server certificates not; and raw.githubusercontent.com's
// chain as served on 2026-10-11 (a Let's Encrypt leaf under YR1 under ISRG
// Root YR, cross-signed by ISRG Root X1) verifies against it at a time
// within its validity, and against no roots does not.

function leaf(): u8[] {
  return __codec_bytes(hex.decode(""));
}

function intermediate(): u8[] {
  return __codec_bytes(hex.decode(""));
}

function cross(): u8[] {
  return __codec_bytes(hex.decode(""));
}

function outcome(r: Result[x509.Certificate, verify.VerifyError]): string {
  match (r) {
    Ok(c) => {
      return "ok " + c.subject.common_name;
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function has(r: verify.Roots, common_name: string): boolean {
  for c in r.certs {
    if (c.subject.common_name == common_name) {
      return true;
    }
  }
  return false;
}

function test_every_root_parses(): test.TestOutcome {
  if (mozilla.COUNT < 100) {
    return test.fail("fewer than 100 roots bundled");
  }
  return test.assert_eq(mozilla.roots().certs.len(), mozilla.COUNT);
}

function index_of(r: verify.Roots, common_name: string): i32 {
  let i: i32 = 0;
  while (i < r.certs.len()) {
    if (r.certs[i].subject.common_name == common_name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// Mozilla's list: ISRG Root X1 in it, a root whose distrust date is spent
// not, and one whose date is live with the date (Izenpe.com, distrusted
// for server certificates issued after the last second of 2026-04-15).
function test_mozillas_list(): test.TestOutcome {
  let r: verify.Roots = mozilla.roots();
  if (has(r, "Entrust Root Certification Authority - G2")) {
    return test.fail("a root whose distrust date is spent is bundled");
  }
  if (r.distrust_after.len() != r.certs.len()) {
    return test.fail("the dates do not pair with the roots");
  }
  let izenpe: i32 = index_of(r, "Izenpe.com");
  if (izenpe < 0 || r.distrust_after[izenpe] != 1776297599 as i64) {
    return test.fail("Izenpe.com is not bundled with its distrust date");
  }
  return test.assert_eq(has(r, "ISRG Root X1"), true);
}

function test_public_chain(): test.TestOutcome {
  let now: i64 = 1788220800 as i64;
  let chain: u8[][] = [leaf(), intermediate(), cross()];
  let r: verify.Roots = mozilla.roots();
  if (outcome(verify.verify_server(chain, verify.roots([]), "raw.githubusercontent.com", now)) == "ok *.github.io") {
    return test.fail("verified against no roots");
  }
  if (outcome(verify.verify_server(chain, r, "example.com", now)) == "ok *.github.io") {
    return test.fail("verified for a name the leaf does not cover");
  }
  let x1: i32 = index_of(r, "ISRG Root X1");
  if (outcome(verify.verify_server(chain, r.distrusting(x1, 1 as i64), "raw.githubusercontent.com", now)) != "tls verify: the leaf was issued after the date root 3 is distrusted from") {
    return test.fail("verified under a root distrusted before the leaf was issued");
  }
  if (outcome(verify.verify_server(chain, r.distrusting(x1, now), "raw.githubusercontent.com", now)) != "ok *.github.io") {
    return test.fail("refused under a root distrusted after the leaf was issued");
  }
  return test.assert_eq(outcome(verify.verify_server(chain, r, "raw.githubusercontent.com", now)), "ok *.github.io");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/tls/mozilla");
  r = r.it("every root parses", test_every_root_parses);
  r = r.it("Mozilla's list", test_mozillas_list);
  r = r.it("a public chain", test_public_chain);
  return r.finish();
}

// Decode a valid fixture. Report a malformed fixture before the test exits.
function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
