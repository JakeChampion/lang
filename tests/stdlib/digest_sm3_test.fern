import "std/test";
import "std/crypto" as crypto;
import "std/string";

function __pseudo(): u8[] {
  let b: u8[] = __alloc_u8(10003);
  let i: i32 = 0;
  while (i < 10003) {
    b = b.with(i, (i * 7 + 3 & 255) as u8);
    i = i + 1;
  }
  return b;
}

function __thousand_a(): string {
  let b: u8[] = __alloc_u8(1000);
  let i: i32 = 0;
  while (i < 1000) {
    b = b.with(i, 97 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

function test_empty(): test.TestOutcome {
  return test.assert_eq(crypto.sm3_new().final_hex(), "1ab21d8355cfa17f8e61194831e81a8f22bec8c728fefb747ed035eb5082aa2b");
}

function test_abc(): test.TestOutcome {
  return test.assert_eq(crypto.sm3_new().update("abc".as_bytes()).final_hex(), "66c7f0f462eeedd9d1f2d46bdc10e4e24167c4875cf2f7a2297da02b8f4ba8e0");
}

function test_multiblock(): test.TestOutcome {
  return test.assert_eq(
    crypto.sm3_new().update("abcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcdabcd".as_bytes()).final_hex(),
    "debe9ff92275b8a138604889c18e5a4d6fdb70e5387e5765293dcba39c0c5732",
  );
}

function test_fiftysix(): test.TestOutcome {
  return test.assert_eq(
    crypto.sm3_new().update("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".as_bytes()).final_hex(),
    "639b6cc5e64d9e37a390b192df4fa1ea0720ab747ff692b9f38c4e66ad7b8c05",
  );
}

function test_bytes_len(): test.TestOutcome {
  return test.assert_eq(crypto.sm3_new().update("abc".as_bytes()).final_bytes().len(), 32);
}

function test_million_a_chunked(): test.TestOutcome {
  let h: crypto.Sm3 = crypto.sm3_new();
  let chunk: string = __thousand_a();
  let i: i32 = 0;
  while (i < 1000) {
    h = h.update(chunk.as_bytes());
    i = i + 1;
  }
  return test.assert_eq(h.final_hex(), "c8aaf89429554029e231941a2acc0ad61ff2a5acd8fadd25847a3a732b3b02c3");
}

function test_seven_byte_updates(): test.TestOutcome {
  let msg: u8[] = __pseudo();
  let h: crypto.Sm3 = crypto.sm3_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    h = h.update(msg[i:i + 7]);
    i = i + 7;
  }
  h = h.update(msg[i:10003]);
  let chunked: string = h.final_hex();
  let whole: string = crypto.sm3_new().update(msg).final_hex();
  if (chunked != "c7badae448ca76f384615885c394c4691998ee17da0e0ee68bf404dde5895544") {
    return test.fail("chunked: " + chunked);
  }
  return test.assert_eq(chunked, whole);
}

function test_update_bytes_and_oneshot(): test.TestOutcome {
  let via_bytes: string = crypto.sm3_new().update("abc".bytes()).final_hex();
  if (via_bytes != crypto.sm3_hex("abc".as_bytes())) {
    return test.fail("one-shot differs: " + via_bytes);
  }
  return test.assert_eq(via_bytes, "66c7f0f462eeedd9d1f2d46bdc10e4e24167c4875cf2f7a2297da02b8f4ba8e0");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/crypto SM3");
  r = r.it("empty", test_empty);
  r = r.it("abc", test_abc);
  r = r.it("multi-block", test_multiblock);
  r = r.it("56 bytes", test_fiftysix);
  r = r.it("final_bytes len", test_bytes_len);
  r = r.it("million a, 1000x1000", test_million_a_chunked);
  r = r.it("7-byte updates", test_seven_byte_updates);
  r = r.it("update_bytes + one-shot", test_update_bytes_and_oneshot);
  return r.finish();
}
