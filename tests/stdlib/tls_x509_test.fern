import "std/test";
import "core/int";
import "std/hex";
import "std/i64";
import "std/tls/pem";
import "std/tls/x509";

// tests/stdlib/tls_x509_test.fern — std/tls/x509 and std/tls/pem: the
// fields of certificates made with Python's `cryptography` (a P-256 chain,
// RSA and Ed25519 roots and leaves, and leaves with a SHA-384 signature and
// an unknown critical extension) and of RFC 8448 §3's server certificate,
// refusals of malformed DER, and PEM both ways.

function ec_root(): u8[] {
  return hex.hex_decode("");
}

function ec_int(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_expired(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_no_eku(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_critical(): u8[] {
  return hex.hex_decode("");
}

function ec_int_not_ca(): u8[] {
  return hex.hex_decode("");
}

function ec_int2(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_under_int2(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_client(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_sha384(): u8[] {
  return hex.hex_decode("");
}

function rsa_root(): u8[] {
  return hex.hex_decode("");
}

function rsa_leaf(): u8[] {
  return hex.hex_decode("");
}

function ed_root(): u8[] {
  return hex.hex_decode("");
}

function ed_leaf(): u8[] {
  return hex.hex_decode("");
}

function nc_int(): u8[] {
  return hex.hex_decode("");
}

function dn_int(): u8[] {
  return hex.hex_decode("");
}

function nc_leaf_ok(): u8[] {
  return hex.hex_decode("");
}

function nc_leaf_out(): u8[] {
  return hex.hex_decode("");
}

function nc_leaf_excluded(): u8[] {
  return hex.hex_decode("");
}

function nc_leaf_ip(): u8[] {
  return hex.hex_decode("");
}

function dn_leaf(): u8[] {
  return hex.hex_decode("");
}

// RFC 8448 §3's server certificate.
function rfc8448_certificate(): u8[] {
  return hex.hex_decode("");
}

// A certificate standing for a parse that failed, its algorithm the error.
function failed(why: string): x509.Certificate {
  let none: x509.Name = x509.Name { raw: [], common_name: "" };
  return x509.Certificate { raw: [], tbs: [], version: 0, serial: [], algorithm: x509.OtherAlgorithm(why), issuer: none, subject: none, not_before: 0 as i64, not_after: 0 as i64, key: x509.OtherKey(""), ca: false, path_len: -1, key_usage: -1, ext_key_usage: [], has_ext_key_usage: false, dns_names: [], ip_addresses: [], permitted_dns: [], excluded_dns: [], permitted_ip: [], excluded_ip: [], unknown_critical: [], signature: [] };
}

function parsed(b: u8[]): x509.Certificate {
  match (x509.parse(b)) {
    Ok(c) => {
      return c;
    },
    Err(e) => {
      return failed(e.message());
    }
  }
  return failed("unreachable");
}

function refusal(b: u8[]): string {
  match (x509.parse(b)) {
    Ok(c) => {
      return "accepted";
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function key_shape(k: x509.PublicKey): string {
  match (k) {
    x509.RsaKey(n, e) => {
      return "rsa " + int.int_to_string(n.len()) + " " + hex.hex_encode(e);
    },
    x509.P256Key(p) => {
      return "p256 " + int.int_to_string(p.len()) + " " + hex.hex_encode(p.take(1));
    },
    x509.Ed25519Key(k) => {
      return "ed25519 " + int.int_to_string(k.len());
    },
    x509.OtherKey(oid) => {
      return "other " + oid;
    }
  }
  return "";
}

function joined(v: string[]): string {
  let out: string = "";
  for s in v {
    out = out + " " + s;
  }
  return out;
}

// summary is the fields a test compares, one line.
function summary(c: x509.Certificate): string {
  return "v" + int.int_to_string(c.version) + " #" + hex.hex_encode(c.serial) + " " + x509.algorithm_name(c.algorithm) + " " + c.issuer.common_name + " > " + c.subject.common_name + " " + c.not_before.to_string() + ".." + c.not_after.to_string() + " " + key_shape(c.key);
}

function test_leaf(): test.TestOutcome {
  let c: x509.Certificate = parsed(ec_leaf());
  if (summary(c) != "v3 #03 ecdsa_sha256 Fern Test Intermediate > example.com 1767225600..1798761600 p256 65 04") {
    return test.fail(summary(c));
  }
  if (c.ca || c.path_len != -1 || c.key_usage != x509.KU_DIGITAL_SIGNATURE || joined(c.ext_key_usage) != " 1.3.6.1.5.5.7.3.1" || !c.has_ext_key_usage) {
    return test.fail("constraints and usages");
  }
  if (joined(c.dns_names) != " example.com *.example.org" || c.ip_addresses.len() != 1 || hex.hex_encode(c.ip_addresses[0]) != "c0000201") {
    return test.fail("subject alternative names");
  }
  return test.assert_eq(c.unknown_critical.len(), 0);
}

function test_authorities(): test.TestOutcome {
  let i: x509.Certificate = parsed(ec_int());
  if (!i.ca || i.path_len != 0 || i.key_usage != 96 || i.has_ext_key_usage) {
    return test.fail("intermediate");
  }
  let r: x509.Certificate = parsed(ec_root());
  if (!r.ca || r.path_len != -1 || hex.hex_encode(r.subject.raw) != hex.hex_encode(r.issuer.raw)) {
    return test.fail("root");
  }
  // The intermediate's issuer is the root's subject, byte for byte.
  return test.assert_eq(hex.hex_encode(i.issuer.raw), hex.hex_encode(r.subject.raw));
}

function test_other_keys(): test.TestOutcome {
  if (summary(parsed(rsa_leaf())) != "v3 #0c rsa_pkcs1_sha256 Fern RSA Root > rsa.example 1767225600..1798761600 rsa 256 010001") {
    return test.fail(summary(parsed(rsa_leaf())));
  }
  if (summary(parsed(ed_leaf())) != "v3 #0e ed25519 Fern Ed25519 Root > ed.example 1767225600..1798761600 ed25519 32") {
    return test.fail(summary(parsed(ed_leaf())));
  }
  if (x509.algorithm_name(parsed(ec_leaf_sha384()).algorithm) != "ecdsa_sha384") {
    return test.fail("SHA-384");
  }
  return test.assert_eq(joined(parsed(ec_leaf_critical()).unknown_critical), " 1.3.6.1.4.1.99999.1");
}

function test_name_constraints(): test.TestOutcome {
  let c: x509.Certificate = parsed(nc_int());
  if (joined(c.permitted_dns) != " example.com" || joined(c.excluded_dns) != " bad.example.com" || c.permitted_ip.len() != 1 || hex.hex_encode(c.permitted_ip[0]) != "c0000200ffffff00" || c.unknown_critical.len() != 0) {
    return test.fail("DNS and IP subtrees");
  }
  // A directoryName subtree is not evaluated, so the critical extension is
  // left unread.
  return test.assert_eq(joined(parsed(dn_int()).unknown_critical), " 2.5.29.30");
}

function test_rfc8448(): test.TestOutcome {
  let c: x509.Certificate = parsed(rfc8448_certificate());
  if (summary(c) != "v3 #02 rsa_pkcs1_sha256 rsa > rsa 1469841839..1785374639 rsa 128 010001") {
    return test.fail(summary(c));
  }
  match (c.key) {
    x509.RsaKey(n, e) => {
      return test.assert_eq(hex.hex_encode(n.take(8)), "b4bb498f8279303d");
    },
    _ => {
      return test.fail("not RSA");
    }
  }
  return test.fail("unreachable");
}

// last is where the last occurrence of pat in b starts.
function last(b: u8[], pat: string): i32 {
  let p: u8[] = hex.hex_decode(pat);
  let at: i32 = b.len() - p.len();
  while (at >= 0) {
    let i: i32 = 0;
    while (i < p.len() && b[at + i] == p[i]) {
      i = i + 1;
    }
    if (i == p.len()) {
      return at;
    }
    at = at - 1;
  }
  return -1;
}

function test_refusals(): test.TestOutcome {
  let b: u8[] = ec_leaf();
  if (refusal(b.take(b.len() - 1)) != "x509: der: truncated") {
    return test.fail("truncated");
  }
  if (refusal(b.append(0 as u8)) != "x509: der: malformed trailing bytes") {
    return test.fail("trailing byte");
  }
  // The outer AlgorithmIdentifier says ecdsa-with-SHA384.
  let outer: i32 = last(b, "06082a8648ce3d040302");
  if (refusal(b.with(outer + 9, 3 as u8)) != "x509: malformed signature algorithm: the two identifiers differ") {
    return test.fail("disagreeing algorithms");
  }
  // The subject alternative name renamed extended key usage, which then
  // appears twice.
  let san: i32 = last(b, "0603551d11");
  return test.assert_eq(refusal(b.with(san + 4, 0x25 as u8)), "x509: malformed repeated extension 2.5.29.37");
}

function test_pem(): test.TestOutcome {
  let text: string = pem.encode("CERTIFICATE", ec_leaf());
  let lines: string[] = text.lines();
  if (lines.len() != 11 || lines[1].len() != 64 || lines[0] != "-----BEGIN CERTIFICATE-----") {
    return test.fail("encode");
  }
  let bundle: string = "# a comment\n" + text + "\nstray text\n" + pem.encode("PRIVATE KEY", [1 as u8]) + pem.encode("CERTIFICATE", ec_root());
  match (pem.certificates(bundle)) {
    Ok(certs) => {
      if (certs.len() != 2 || hex.hex_encode(certs[0]) != hex.hex_encode(ec_leaf()) || hex.hex_encode(certs[1]) != hex.hex_encode(ec_root())) {
        return test.fail("bundle");
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return pem_refusals();
}

function pem_refusal(text: string): string {
  match (pem.decode(text)) {
    Ok(b) => {
      return "accepted";
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function pem_refusals(): test.TestOutcome {
  if (pem_refusal("-----BEGIN CERTIFICATE-----\nAAAA\n") != "pem: the CERTIFICATE block has no END line") {
    return test.fail("unterminated");
  }
  if (pem_refusal("-----BEGIN CERTIFICATE-----\nAAAA\n-----END X509 CRL-----\n") != "pem: the CERTIFICATE block ends with another label") {
    return test.fail("mismatched END");
  }
  return test.assert_eq(pem_refusal("-----BEGIN CERTIFICATE-----\nA*AA\n-----END CERTIFICATE-----\n"), "pem: the CERTIFICATE block is not base64");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/tls/x509");
  r = r.it("a leaf's fields", test_leaf);
  r = r.it("an intermediate and a root", test_authorities);
  r = r.it("RSA, Ed25519, SHA-384 and a critical extension", test_other_keys);
  r = r.it("name constraints", test_name_constraints);
  r = r.it("RFC 8448's certificate", test_rfc8448);
  r = r.it("refusals", test_refusals);
  r = r.it("PEM", test_pem);
  return r.finish();
}
