import "std/test";
import "std/hex";
import "std/crypto";
import "std/crypto/ecdsa";
import "std/crypto/ed25519";
import "std/crypto/sha2";
import "std/tls/identity";

const P256_LEAF: string = "";

const ED_LEAF: string = "";

function release_identity(own value: identity.Identity): void {
  match (value.key) {
    identity.EcdsaKey(key) => {
      key.erase();
    },
    identity.Ed25519Seed(seed) => {
      crypto.erase(seed);
    }
  }
}

function test_ecdsa(): test.TestOutcome {
  let scalar = "33333333333333333333333333333333".as_bytes();
  let Ok(key) = ecdsa.private_key(ecdsa.P256, scalar) else {
    return test.fail("private key");
  };
  let Ok(public) = ecdsa.public_key(ecdsa.P256, key.public_point()) else {
    return test.fail("public key");
  };
  let Ok(certificate) = hex.decode(P256_LEAF) else {
    return test.fail("certificate");
  };
  let Ok(id) = identity.pair([certificate], identity.EcdsaKey(key)) else {
    return test.fail("identity");
  };
  key.erase();
  let content = "paired identity".as_bytes();
  let Ok(signature) = id.key.sign(0x0403, content) else {
    return test.fail("signature");
  };
  let valid = public.verify(sha2.Sha256, content, signature);
  release_identity(id);
  return test.assert_true(valid);
}

function test_ed25519(): test.TestOutcome {
  let seed: u8[] = __alloc_u8(32);
  for i in 0..32 {
    seed = seed.with(i, 0x22 as u8);
  }
  let Ok(key) = ed25519.private_key(seed) else {
    return test.fail("private key");
  };
  let Ok(public) = ed25519.public_key(key.public_point()) else {
    return test.fail("public key");
  };
  let Ok(certificate) = hex.decode(ED_LEAF) else {
    return test.fail("certificate");
  };
  let Ok(id) = identity.pair([certificate], identity.Ed25519Seed(seed)) else {
    return test.fail("identity");
  };
  crypto.erase(seed);
  key.erase();
  let content = "paired identity".as_bytes();
  let Ok(signature) = id.key.sign(0x0807, content) else {
    return test.fail("signature");
  };
  let valid = public.verify(content, signature);
  release_identity(id);
  return test.assert_true(valid);
}

function main(): i32 {
  let runner = test.new("TLS identity shared key");
  runner = runner.it("ECDSA survives source erase", test_ecdsa);
  runner = runner.it("Ed25519 survives source erase", test_ed25519);
  return runner.finish();
}
