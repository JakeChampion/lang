import "std/test";
import "std/protobuf";
import "std/hex";

function test_varints(): test.TestOutcome {
  let got: string = hex.hex_encode(protobuf.encode_varint(1 as i64)) + " " + hex.hex_encode(protobuf.encode_varint(150 as i64)) + " " + hex.hex_encode(protobuf.encode_varint(0 as i64 - 1 as i64));
  return test.assert_eq(got, "01 9601 ffffffffffffffffff01");
}

function test_guide_message(): test.TestOutcome {
  match (protobuf.decode(hex.hex_decode("089601"))) {
    Ok(fields) => {
      let v: string = "none";
      match (protobuf.varint(fields, 1)) {
        Some(n) => {
          v = n.to_string();
        },
        None => {}
      }
      return test.assert_eq(fields.len().to_string() + " " + v + " " + hex.hex_encode(protobuf.varint_field(1, 150 as i64)), "1 150 089601");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
  return test.fail("unreachable");
}

function test_fields(): test.TestOutcome {
  let inner: u8[] = protobuf.varint_field(1, 27182 as i64);
  let msg: u8[] = protobuf.string_field(2, "testing").concat(protobuf.bytes_field(3, inner)).concat(protobuf.bytes_field(4, "a".bytes())).concat(protobuf.bytes_field(4, "bc".bytes())).concat(hex.hex_decode("2d04000000"));
  match (protobuf.decode(msg)) {
    Ok(fields) => {
      let text: string = "";
      match (protobuf.bytes(fields, 2)) {
        Some(bs) => {
          text = string_from_bytes_unchecked(bs);
        },
        None => {}
      }
      let size: string = "none";
      match (protobuf.bytes(fields, 3)) {
        Some(bs) => {
          match (protobuf.decode(bs)) {
            Ok(inner_fields) => {
              match (protobuf.varint(inner_fields, 1)) {
                Some(n) => {
                  size = n.to_string();
                },
                None => {}
              }
            },
            Err(e) => {
              return test.fail(e);
            }
          }
        },
        None => {}
      }
      let reps: u8[][] = protobuf.repeated(fields, 4);
      let fixed: string = "";
      for f in fields {
        if (f.number == 5) {
          fixed = f.wire.to_string() + ":" + f.word.to_string();
        }
      }
      return test.assert_eq(hex.hex_encode(protobuf.string_field(2, "testing")) + " " + text + " " + size + " " + reps.len().to_string() + string_from_bytes_unchecked(reps[1]) + " " + fixed, "120774657374696e67 testing 27182 2bc 5:4");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
  return test.fail("unreachable");
}

function test_zigzag(): test.TestOutcome {
  let got: string = protobuf.zigzag(0 as i64).to_string() + " " + protobuf.zigzag(0 as i64 - 1 as i64).to_string() + " " + protobuf.zigzag(1 as i64).to_string() + " " + protobuf.zigzag(0 as i64 - 2 as i64).to_string() + " " + protobuf.unzigzag(4294967294 as i64).to_string() + " " + protobuf.unzigzag(4294967295 as i64).to_string();
  return test.assert_eq(got, "0 1 2 3 2147483647 -2147483648");
}

function fault(bytes_hex: string): string {
  match (protobuf.decode(hex.hex_decode(bytes_hex))) {
    Ok(fields) => {
      return "ok " + fields.len().to_string();
    },
    Err(e) => {
      return e;
    }
  }
  return "unreachable";
}

function test_faults(): test.TestOutcome {
  let got: string = fault("08") + "|" + fault("1205616263") + "|" + fault("0b") + "|" + fault("00") + "|" + fault("ffffffffffffffffffff01") + "|" + fault("0f01");
  return test.assert_eq(got, "varint cut short at byte 1|field 2 length past the end|field 1 is a group|field number 0 at byte 1|varint over ten bytes at byte 0|field 1 has wire type 7");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/protobuf");
  r = r.it("varints", test_varints);
  r = r.it("the guide's message", test_guide_message);
  r = r.it("strings, embedded, repeated and fixed fields", test_fields);
  r = r.it("zigzag", test_zigzag);
  r = r.it("faults", test_faults);
  return r.finish();
}
