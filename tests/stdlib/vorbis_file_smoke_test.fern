import "std/test";
import "aac_kernel_check" as ref;
import "vorbis_file_check";
import "vorbis_file_smoke_vectors";

function complete(): test.TestOutcome {
  let value = vorbis_file_smoke_vectors.vector();
  let encoded = match (ref.unpack(value.encoded)) { Ok(v) => v, Err(e) => { return test.fail(e); } };
  let formats = match (ref.unpack(value.formats)) { Ok(v) => v, Err(e) => { return test.fail(e); } };
  let expected = match (ref.unpack(value.pcm)) { Ok(v) => v, Err(e) => { return test.fail(e); } };
  if let Err(e) = vorbis_file_check.run(encoded, formats, expected, 17) {
    return test.fail(e);
  }
  return test.pass();
}

function main(): i32 {
  let runner = test.new("Ogg Vorbis complete-file interpreter smoke");
  runner = runner.it("independent nonzero PCM and final trim", complete);
  return runner.finish();
}
