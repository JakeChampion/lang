import "std/test";
import "std/hex";
import "std/codec";
import "std/crypto/ed25519";
import "std/tls";
import "std/tls/client";
import "std/tls/handshake";
import "std/tls/identity";
import "std/tls/keyschedule";
import "std/tls/message";
import "std/tls/pem";
import "std/tls/record";
import "std/tls/verify";
import "std/time";
import "std/rand";

const ROOT: string = "";

const LEAF: string = "";

const OTHER_ROOT: string = "";

const IDENTITY_ROOT: string = "";

const CLIENT_LEAF: string = "";

const CLIENT_PKCS8: string = "-----BEGIN PRIVATE KEY-----\n"
  + "MC4CAQAwBQYDK2VwBCIEIFVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV\n"
  + "-----END PRIVATE KEY-----\n";

// An Ed25519 root and a leaf for tls.example with the key of leaf_seed, and
// OCSP responses about the leaf that `openssl ocsp` signed with the root
// (tests/stdlib/tls_ocsp_test.fern has the same set).
const OCSP_ROOT: string = "";

const OCSP_LEAF: string = "";

const OCSP_GOOD: string = "";

const OCSP_REVOKED: string = "";

const OCSP_UNKNOWN: string = "";

// 2026-11-26T00:00:00Z, inside the validity window of the OCSP responses.
const OCSP_NOW_MS: i64 = 1795651200000;

const WALL_MS: i64 = 1700000000000;

const NOT_BEFORE_MS: i64 = 1577836800000;

const NOT_AFTER_MS: i64 = 4102444800000;

function roots(der: string): verify.Roots {
  return verify.roots([__codec_bytes(hex.decode(der))]);
}

function leaf_seed(): u8[] {
  let out: u8[] = [];
  while (out.len() < 32) {
    out = out.append(22 as u8);
  }
  return out;
}

struct Pair { session: client.Session, server: handshake.Server }

function begin(cfg: client.Config, now: i64): Result[client.Step, tls.TlsError] {
  return client.start(cfg, rand.bytes(client.entropy(cfg)), time.timestamp_from_unix_millis(now));
}

function connect(cfg: client.Config, alpn: string[], forge: boolean): Result[Pair, tls.TlsError] {
  return connect_at(cfg, alpn, forge, WALL_MS);
}

function connect_at(cfg: client.Config, alpn: string[], forge: boolean, now: i64): Result[Pair, tls.TlsError] {
  let sc = handshake.ServerConfig { ...handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807]), alpn: alpn };
  return connect_to(cfg, sc, forge, now);
}

function connect_to(cfg: client.Config, sc: handshake.ServerConfig, forge: boolean, now: i64): Result[Pair, tls.TlsError] {
  let start = begin(cfg, now)?;
  let server = srv(handshake.server_new(sc, rand.bytes(handshake.server_entropy(sc))))?;
  let s1 = srv(server.read(start.output))?;
  if (s1.events.len() == 0) {
    start = rd_at(start.session, s1.output, now)?;
    s1 = srv(s1.server.read(start.output))?;
  }
  let signed = signing(s1.events);
  if (forge) {
    signed = signed.append(0 as u8);
  }
  let sig: u8[] = [];
  match (signed_with(leaf_seed(), signed)) {
    Ok(b) => {
      sig = b;
    },
    Err(e) => {
      return Err(tls.SignatureInvalid);
    }
  }
  let s2 = srv(s1.server.signature(sig))?;
  let c1 = rd_at(start.session, cat(s1.output, s2.output), now)?;
  let s3 = srv(s2.server.read(c1.output))?;
  if (!c1.session.connected() || !s3.server.connected()) {
    return Err(tls.ClosedEarly);
  }
  return Ok(Pair { session: c1.session, server: s3.server });
}

function rd(s: client.Session, input: u8[]): Result[client.Step, tls.TlsError] {
  return rd_at(s, input, WALL_MS);
}

function rd_at(s: client.Session, input: u8[], now: i64): Result[client.Step, tls.TlsError] {
  match (s.read(input, time.timestamp_from_unix_millis(now))) {
    Ok(step) => {
      return Ok(step);
    },
    Err(f) => {
      return Err(f.error);
    }
  }
  return Err(tls.ClosedEarly);
}

function srv[T](r: Result[T, handshake.HandshakeError]): Result[T, tls.TlsError] {
  match (r) {
    Ok(v) => {
      return Ok(v);
    },
    Err(e) => {
      return Err(tls.HandshakeFailed(e));
    }
  }
  return Err(tls.ClosedEarly);
}

function signing(events: handshake.Event[]): u8[] {
  for e in events {
    match (e) {
      handshake.SignNeeded(s) => {
        return s.signed;
      },
      _ => {}
    }
  }
  return [];
}

function cat(a: u8[], b: u8[]): u8[] {
  let out = a;
  for x in b {
    out = out.append(x);
  }
  return out;
}

function outcome(r: Result[Pair, tls.TlsError]): string {
  match (r) {
    Ok(p) => {
      return "connected " + p.session.alpn();
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function exchange(s: client.Session, server: handshake.Server): Result[string, tls.TlsError] {
  let cw = s.write("ping".bytes())?;
  let sr = srv(server.read(cw.output))?;
  let sw = srv(sr.server.write("pong".bytes()))?;
  let cr = rd(cw.session, sw.output)?;
  return Ok(unsafe { string_from_bytes_unchecked(sr.data) } + " " + unsafe { string_from_bytes_unchecked(cr.data) });
}

function exchanged(s: client.Session, server: handshake.Server): string {
  match (exchange(s, server)) {
    Ok(t) => {
      return t;
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_tickets_have_a_limit(): test.TestOutcome {
  let Ok(pair) = connect(client.config("tls.example", roots(ROOT)), [], false) else {
    return test.fail("ticket handshake");
  };
  let held: client.Ticket[] = [];
  let n = 0;
  while (n < client.MAX_TICKETS + 5) {
    let Ok(item) = issued_at(pair, 60u32, [n as u8], WALL_MS) else {
      return test.fail("issuing ticket " + n.to_string());
    };
    held = client.more_tickets(held, [item.0]);
    n += 1;
  }
  return test.assert_eq(held.len().to_string() + " " + held[0].wire_identity()[0].to_string() + " " + held[held.len() - 1].wire_identity()[0].to_string(), "8 5 12");
}

function test_trusted(): test.TestOutcome {
  let cfg = client.config("tls.example", roots(ROOT)).with_alpn(["h2", "http/1.1"]);
  match (connect(cfg, ["http/1.1"], false)) {
    Ok(p) => {
      if (p.session.alpn() != "http/1.1") {
        return test.fail("alpn " + p.session.alpn());
      }
      return test.assert_eq(exchanged(p.session, p.server), "ping pong");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function server_name(first: client.Step): string {
  match (record.deframe(first.output)) {
    Ok(d) => {
      match (message.decode(message.Raw { kind: message.CLIENT_HELLO, bytes: d.records[0].fragment })) {
        Ok(message.ClientHelloMsg(h)) => {
          match (message.find(h.extensions, message.EXT_SERVER_NAME)) {
            Some(data) => {
              match (message.server_name(data)) {
                Ok(n) => {
                  return n;
                },
                Err(e) => {
                  return e.message();
                }
              }
            },
            None => {
              return "-";
            }
          }
        },
        _ => {
          return "not a ClientHello";
        }
      }
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function first_flight(name: string): string {
  match (begin(client.config(name, roots(ROOT)), WALL_MS)) {
    Ok(step) => {
      return server_name(step);
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_names(): test.TestOutcome {
  if (first_flight("tls.example") != "tls.example" || first_flight("192.0.2.7") != "-") {
    return test.fail("SNI: " + first_flight("tls.example") + " " + first_flight("192.0.2.7"));
  }
  if (outcome(connect(client.config("192.0.2.7", roots(ROOT)), [], false)) != "connected ") {
    return test.fail("an address: " + outcome(connect(client.config("192.0.2.7", roots(ROOT)), [], false)));
  }
  return test.assert_eq(outcome(connect(client.config("other.example", roots(ROOT)), [], false)), "the peer's certificate is not trusted: tls verify: the certificate is not valid for other.example");
}

function test_untrusted(): test.TestOutcome {
  if (outcome(connect(client.config("tls.example", roots(OTHER_ROOT)), [], false)) != "the peer's certificate is not trusted: tls verify: no path from the certificate reaches a trusted root") {
    return test.fail(outcome(connect(client.config("tls.example", roots(OTHER_ROOT)), [], false)));
  }
  match (refusal_alert()) {
    Ok(t) => {
      return test.assert_eq(t, "tls handshake: the peer sent alert 42");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function refusal_alert(): Result[string, tls.TlsError] {
  return alert_of(client.config("tls.example", roots(OTHER_ROOT)), handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807]), WALL_MS);
}

// What the server reads from the alert of a client that refuses it.
function alert_of(cfg: client.Config, sc: handshake.ServerConfig, now: i64): Result[string, tls.TlsError] {
  let start = begin(cfg, now)?;
  let s1 = srv(srv(handshake.server_new(sc, rand.bytes(handshake.server_entropy(sc))))?.read(start.output))?;
  let sig: u8[] = [];
  match (signed_with(leaf_seed(), signing(s1.events))) {
    Ok(b) => {
      sig = b;
    },
    Err(e) => {
      return Err(tls.SignatureInvalid);
    }
  }
  let s2 = srv(s1.server.signature(sig))?;
  match (start.session.read(cat(s1.output, s2.output), time.timestamp_from_unix_millis(now))) {
    Ok(step) => {
      return Ok("accepted");
    },
    Err(f) => {
      match (s2.server.read(f.alert)) {
        Ok(_) => {
          return Ok("the server read on");
        },
        Err(e) => {
          return Ok(e.message());
        }
      }
    }
  }
  return Ok("");
}

function test_validity_window(): test.TestOutcome {
  let cfg = client.config("tls.example", roots(ROOT));
  if (outcome(connect_at(cfg, [], false, NOT_BEFORE_MS - 1000)) != "the peer's certificate is not trusted: tls verify: certificate 0 is not yet valid") {
    return test.fail("before notBefore: " + outcome(connect_at(cfg, [], false, NOT_BEFORE_MS - 1000)));
  }
  if (outcome(connect_at(cfg, [], false, NOT_AFTER_MS + 1000)) != "the peer's certificate is not trusted: tls verify: certificate 0 has expired") {
    return test.fail("after notAfter: " + outcome(connect_at(cfg, [], false, NOT_AFTER_MS + 1000)));
  }
  return test.assert_eq(outcome(connect_at(cfg, [], false, NOT_BEFORE_MS + 1000)) + "; " + outcome(connect_at(cfg, [], false, NOT_AFTER_MS - 1000)), "connected ; connected ");
}

// The result of a handshake with a server that staples `staple`, under the
// revocation check `r`, at the time `now`.
function revocation_outcome(r: client.Revocation, staple: string, now: i64): string {
  let cfg = client.config("tls.example", roots(OCSP_ROOT)).with_revocation(r);
  let sc = handshake.ServerConfig { ...handshake.server_config([__codec_bytes(hex.decode(OCSP_LEAF))], [0x0807]), ocsp: __codec_bytes(hex.decode(staple)) };
  return outcome(connect_to(cfg, sc, false, now));
}

function test_revocation(): test.TestOutcome {
  let connected = "connected ";
  let checks: (client.Revocation, string, i64, string)[] = [
    (client.CheckStapled, OCSP_GOOD, OCSP_NOW_MS, connected),
    (client.RequireStapled, OCSP_GOOD, OCSP_NOW_MS, connected),
    (client.CheckStapled, "", OCSP_NOW_MS, connected),
    (client.RequireStapled, "", OCSP_NOW_MS, "the server stapled no OCSP response"),
    (client.CheckStapled, OCSP_REVOKED, OCSP_NOW_MS, "the issuer revoked the server certificate at 1793491200"),
    (client.CheckStapled, OCSP_UNKNOWN, OCSP_NOW_MS, "the OCSP response does not know the server certificate"),
    // 2026-12-03T00:00:00Z, after the nextUpdate of the response.
    (client.CheckStapled, OCSP_GOOD, 1796256000000, "the stapled OCSP response was refused: ocsp: the response expired at 1796203698"),
    // A client with no revocation check does not ask, so the server staples nothing.
    (client.NoRevocationCheck, OCSP_REVOKED, OCSP_NOW_MS, connected),
  ];
  let i = 0;
  while (i < checks.len()) {
    let c = checks[i];
    let got = revocation_outcome(c.0, c.1, c.2);
    if (got != c.3) {
      return test.fail("case " + i.to_string() + ": " + got);
    }
    i += 1;
  }
  return test.pass();
}

// A revoked leaf gets the alert certificate_revoked, and a refused response
// the alert bad_certificate_status_response.
function test_revocation_alerts(): test.TestOutcome {
  let sent = "tls handshake: the peer sent alert ";
  let got = [revocation_alert(OCSP_REVOKED, OCSP_NOW_MS), revocation_alert(OCSP_GOOD, 1796256000000), revocation_alert("", OCSP_NOW_MS)];
  if (got[0] != sent + "44" || got[1] != sent + "113" || got[2] != sent + "113") {
    return test.fail(got[0] + "; " + got[1] + "; " + got[2]);
  }
  return test.pass();
}

function revocation_alert(staple: string, now: i64): string {
  let cfg = client.config("tls.example", roots(OCSP_ROOT)).with_revocation(client.RequireStapled);
  let sc = handshake.ServerConfig { ...handshake.server_config([__codec_bytes(hex.decode(OCSP_LEAF))], [0x0807]), ocsp: __codec_bytes(hex.decode(staple)) };
  match (alert_of(cfg, sc, now)) {
    Ok(a) => {
      return a;
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_forged(): test.TestOutcome {
  return test.assert_eq(outcome(connect(client.config("tls.example", roots(ROOT)), [], true)), "the peer's CertificateVerify does not verify");
}

// Without verification, a chain from an unknown root and another name
// connect. A forged CertificateVerify still fails.
function test_without_verification(): test.TestOutcome {
  let got = [
    outcome(connect(client.config("other.example", roots(OTHER_ROOT)).without_verification(), [], false)),
    outcome(connect(client.config("tls.example", verify.no_roots()).without_verification(), [], false)),
    outcome(connect(client.config("tls.example", roots(OTHER_ROOT)).without_verification(), [], true)),
    outcome(connect(client.config("other.example", roots(OTHER_ROOT)), [], false)),
  ];
  return test.assert_eq_array(got, ["connected ", "connected ", "the peer's CertificateVerify does not verify", "the peer's certificate is not trusted: tls verify: the certificate is not valid for other.example"]);
}

function test_save_restore(): test.TestOutcome {
  match (begin(client.config("tls.example", roots(ROOT)), WALL_MS)) {
    Ok(step) => {
      match (step.session.save()) {
        Ok(b) => {
          return test.fail("saved before the handshake");
        },
        Err(e) => {}
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  match (client.restore([1 as u8, 0 as u8, 0 as u8, 19 as u8, 1 as u8, 0 as u8])) {
    Ok(s) => {
      return test.fail("restored from garbage");
    },
    Err(e) => {}
  }
  match (connect(client.config("tls.example", roots(ROOT)), [], false)) {
    Ok(p) => {
      if (exchanged(p.session, p.server) != "ping pong") {
        return test.fail("before");
      }
      match (p.session.save()) {
        Ok(saved) => {
          match (client.restore(saved)) {
            Ok(s) => {
              return test.assert_eq(exchanged(s, p.server), "ping pong");
            },
            Err(e) => {
              return test.fail(e.message());
            }
          }
        },
        Err(e) => {
          return test.fail(e.message());
        }
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function closes(p: Pair): Result[string, tls.TlsError] {
  let sc = srv(p.server.close())?;
  let seen = rd(p.session, sc.output)?;
  let cc = p.session.close()?;
  let sr = srv(p.server.read(cc.output))?;
  if (seen.closed && sr.events.len() == 1) {
    return Ok("both");
  }
  return Ok("missed");
}

function test_a_close_before_the_handshake_ends(): test.TestOutcome {
  match (begin(client.config("tls.example", roots(ROOT)), WALL_MS)) {
    Ok(start) => {
      match (rd(start.session, __codec_bytes(hex.decode("15030300020100")))) {
        Ok(_) => {
          return test.fail("the close_notify was taken");
        },
        Err(e) => {
          return test.assert_eq(e.message(), "tls handshake: the peer sent alert 0");
        }
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function test_close(): test.TestOutcome {
  match (connect(client.config("tls.example", roots(ROOT)), [], false)) {
    Ok(p) => {
      match (closes(p)) {
        Ok(t) => {
          return test.assert_eq(t, "both");
        },
        Err(e) => {
          return test.fail(e.message());
        }
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function has_resume(events: handshake.Event[]): boolean {
  for e in events {
    match (e) {
      handshake.ResumeOffered(o) => {
        return true;
      },
      _ => {}
    }
  }
  return false;
}

function issued(p: Pair, lifetime: u32): Result[(client.Ticket, u8[]), tls.TlsError] {
  return issued_at(p, lifetime, "ticket-1".bytes(), WALL_MS);
}

function issued_at(p: Pair, lifetime: u32, wire_identity: u8[], now: i64): Result[(client.Ticket, u8[]), tls.TlsError] {
  let t = message.NewSessionTicket { lifetime: lifetime, age_add: 99 as u32, nonce: [0 as u8], ticket: wire_identity, extensions: [] };
  let st = srv(p.server.ticket(t))?;
  let cr = rd_at(p.session, st.output, now)?;
  if (cr.tickets.len() != 1) {
    return Err(tls.HandshakeFailed(handshake.Misuse("tickets")));
  }
  return Ok((cr.tickets[0], srv(st.server.resumption_psk([0 as u8]))?));
}

function connect_resumed(cfg: client.Config, psk: u8[]): Result[Pair, tls.TlsError] {
  let start = begin(cfg, WALL_MS)?;
  let server = srv(handshake.server_new(handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807]), rand.bytes(handshake.server_entropy(handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807])))))?;
  let s1 = srv(server.read(start.output))?;
  if (!has_resume(s1.events)) {
    return Err(tls.HandshakeFailed(handshake.Misuse("no ticket offered")));
  }
  let s2 = srv(s1.server.resume(Some(handshake.Resumed { index: 0, psk: psk, early: false, alpn: "", client_chain: [] })))?;
  let c1 = rd(start.session, s2.output)?;
  let s3 = srv(s2.server.read(c1.output))?;
  if (!c1.session.connected() || !s3.server.connected() || !c1.session.resumed()) {
    return Err(tls.ClosedEarly);
  }
  return Ok(Pair { session: c1.session, server: s3.server });
}

function test_ticket_authentication(): test.TestOutcome {
  let cfg = client.config("tls.example", roots(ROOT));
  let Ok(unchecked) = connect(cfg.without_verification(), [], false) else {
    return test.fail("unchecked handshake");
  };
  let Ok(saved) = issued(unchecked, 7200u32) else {
    return test.fail("unchecked ticket");
  };
  if (outcome(connect_resumed(cfg.with_ticket(saved.0), saved.1)) != "tls handshake: no ticket offered called out of turn") {
    return test.fail("offered an unverified ticket");
  }
  if (connect_resumed(cfg.without_verification().with_ticket(saved.0), saved.1).is_err()) {
    return test.fail("unchecked resumption");
  }
  let Ok(checked) = connect(cfg, [], false) else {
    return test.fail("verified handshake");
  };
  let Ok(got) = issued_at(checked, 7200u32, "ticket-1".bytes(), NOT_AFTER_MS) else {
    return test.fail("verified ticket");
  };
  let last = time.timestamp_from_unix_millis(NOT_AFTER_MS);
  let ticket = got.0;
  if (client.offered_for(ticket, cfg.server_name, last, cfg.roots, true).is_none()) {
    return test.fail("certificate still valid");
  }
  if (client.offered_for(ticket, cfg.server_name, time.timestamp_from_unix_millis(NOT_AFTER_MS + 1000), cfg.roots, true).is_some()) {
    return test.fail("offered a ticket after certificate expiry");
  }
  return test.pass();
}

function test_resumption(): test.TestOutcome {
  match (connect(client.config("tls.example", roots(ROOT)), [], false)) {
    Ok(p) => {
      match (issued(p, 2592000 as u32)) {
        Ok(long) => {
          if (!long.0.valid_for().eq(time.duration_seconds(604800))) {
            return test.fail("a lifetime above seven days");
          }
        },
        Err(e) => {
          return test.fail(e.message());
        }
      }
      match (issued(p, 7200 as u32)) {
        Ok(got) => {
          let t = got.0;
          let Some(offer) = client.offered(t, "tls.example", time.timestamp_from_unix_millis(WALL_MS)) else {
            return test.fail("ticket metadata");
          };
          if (t.suite_code() != keyschedule.Aes128GcmSha256.code() || !t.valid_for().eq(time.duration_seconds(7200)) || hex.encode(offer.psk) != hex.encode(got.1)) {
            return test.fail("the ticket kept");
          }
          let refused = client.config("tls.example", roots(OTHER_ROOT)).with_ticket(t);
          if (outcome(connect_resumed(refused, got.1)) != "tls handshake: no ticket offered called out of turn") {
            return test.fail("the client offered a ticket under another root");
          }
          match (connect_resumed(client.config("tls.example", roots(ROOT)).with_ticket(t), got.1)) {
            Ok(r) => {
              let Ok(renewed) = issued(r, 7200 as u32) else {
                return test.fail("renewed ticket");
              };
              if (connect_resumed(client.config("tls.example", roots(ROOT)).with_ticket(renewed.0), renewed.1).is_err()) {
                return test.fail("the renewed ticket lost the verified chain");
              }
              if (exchanged(r.session, r.server) != "ping pong") {
                return test.fail("after resuming");
              }
            },
            Err(e) => {
              return test.fail("resuming: " + e.message());
            }
          }
          if (outcome(connect_resumed(client.config("192.0.2.7", roots(ROOT)).with_ticket(t), got.1)) != "tls handshake: no ticket offered called out of turn") {
            return test.fail("another name: " + outcome(connect_resumed(client.config("192.0.2.7", roots(ROOT)).with_ticket(t), got.1)));
          }
          let expired = time.timestamp_from_unix_millis(WALL_MS).add(time.duration_seconds(7200));
          return test.assert_true(client.offered_for(t, "tls.example", expired, roots(ROOT), true).is_none());
        },
        Err(e) => {
          return test.fail(e.message());
        }
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function client_shown(events: handshake.Event[]): Option[handshake.Verification] {
  for e in events {
    match (e) {
      handshake.VerifyClient(v) => {
        return Some(v);
      },
      _ => {}
    }
  }
  return None;
}

function connect_asked(cfg: client.Config): Result[string, tls.TlsError] {
  let start = begin(cfg, WALL_MS)?;
  let sc = handshake.ServerConfig { ...handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807]), request_client_certificate: true };
  let s1 = srv(srv(handshake.server_new(sc, rand.bytes(handshake.server_entropy(sc))))?.read(start.output))?;
  let sig: u8[] = [];
  match (signed_with(leaf_seed(), signing(s1.events))) {
    Ok(b) => {
      sig = b;
    },
    Err(e) => {
      return Err(tls.SignatureInvalid);
    }
  }
  let s2 = srv(s1.server.signature(sig))?;
  let c1 = rd(start.session, cat(s1.output, s2.output))?;
  let s3 = srv(s2.server.read(c1.output))?;
  let shown = "not shown";
  match (client_shown(s3.events)) {
    Some(v) => {
      shown = "chain " + v.chain.len().to_string();
      if (v.chain.len() > 0) {
        match (verify.client(v.chain, roots(IDENTITY_ROOT), time.timestamp_from_unix(1700000000))) {
          Ok(leaf) => {
            if (verify.signed(leaf, v.scheme, v.signed, v.signature)) {
              shown += " verified";
            }
          },
          Err(e) => {
            shown = shown + " " + e.message();
          }
        }
      }
    },
    None => {}
  }
  let s4 = srv(s3.server.verdict(true))?;
  if (!c1.session.connected() || !s4.server.connected()) {
    return Err(tls.ClosedEarly);
  }
  return Ok(shown);
}

function asked_outcome(cfg: client.Config): string {
  match (connect_asked(cfg)) {
    Ok(t) => {
      return t;
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_identity(): test.TestOutcome {
  let id = identity.Identity { chain: [], key: identity.Ed25519Seed([]) };
  match (identity.from_pem(pem_of(CLIENT_LEAF), CLIENT_PKCS8)) {
    Ok(i) => {
      id = i;
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  if (asked_outcome(client.config("tls.example", roots(ROOT)).with_identity(id)) != "chain 1 verified") {
    return test.fail("with an identity: " + asked_outcome(client.config("tls.example", roots(ROOT)).with_identity(id)));
  }
  return test.assert_eq(asked_outcome(client.config("tls.example", roots(ROOT))), "chain 0");
}

function pem_of(der_hex: string): string {
  return pem.encode("CERTIFICATE", __codec_bytes(hex.decode(der_hex)));
}

// The alert of a read that the client refuses, or what the read did.
function header_alert(header: u8[]): string {
  match (begin(client.config("tls.example", roots(ROOT)), WALL_MS)) {
    Ok(started) => {
      match (started.session.read(header, time.timestamp_from_unix_millis(WALL_MS))) {
        Ok(step) => {
          return "held";
        },
        Err(f) => {
          return hex.encode(f.alert);
        }
      }
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_header_refused_before_its_record(): test.TestOutcome {
  let plain_http: u8[] = [72, 84, 84, 80, 47];
  let too_long: u8[] = [22, 3, 3, 255, 255];
  let part_of_a_hello: u8[] = [22, 3, 3, 0, 200, 2, 0, 0];
  let four_bytes: u8[] = [72, 84, 84, 80];
  let got = header_alert(plain_http) + " | " + header_alert(too_long) + " | " + header_alert(part_of_a_hello) + " | " + header_alert(four_bytes);
  return test.assert_eq(got, "1503030002020a | 15030300020216 | held | held");
}

function main(): i32 {
  let r = test.new("std/tls/client");
  r = r.it("a header that no record has is refused before the record", test_header_refused_before_its_record);
  r = r.it("a trusted server", test_trusted);
  r = r.it("a connection keeps a limited count of tickets", test_tickets_have_a_limit);
  r = r.it("names", test_names);
  r = r.it("an untrusted root", test_untrusted);
  r = r.it("the certificate validity window, at the given time", test_validity_window);
  r = r.it("a forged CertificateVerify", test_forged);
  r = r.it("the revocation check of a stapled OCSP response", test_revocation);
  r = r.it("the alerts of a refused revocation check", test_revocation_alerts);
  r = r.it("a session without verification still checks the signature", test_without_verification);
  r = r.it("save and restore", test_save_restore);
  r = r.it("close_notify", test_close);
  r = r.it("a close_notify before the handshake ends is an error", test_a_close_before_the_handshake_ends);
  r = r.it("ticket authentication and certificate expiry", test_ticket_authentication);
  r = r.it("resumption", test_resumption);
  r = r.it("an identity", test_identity);
  return r.finish();
}

function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}

function signed_with(key_seed: [u8], msg: [u8]): Result[u8[], ed25519.Ed25519Error] {
  let k = ed25519.private_key(key_seed)?;
  return Ok(k.sign(msg));
}
