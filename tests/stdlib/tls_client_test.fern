import "std/test";
import "std/hex";
import "std/codec";
import "std/crypto/ed25519";
import "std/tls";
import "std/tls/client";
import "std/tls/handshake";
import "std/tls/identity";
import "std/tls/keyschedule";
import "std/tls/message";
import "std/tls/pem";
import "std/tls/record";
import "std/tls/verify";

// tests/stdlib/tls_client_test.fern — std/tls/client's session against
// std/tls/handshake's server: the chain judged against the roots for the
// name asked for, the CertificateVerify checked, ALPN, close_notify, and a
// session saved and restored. The certificates are Ed25519, valid from 2020
// to 2100, made with Python's `cryptography`.

const ROOT: string = "";

const LEAF: string = "";

const OTHER_ROOT: string = "";

// The identity fixtures are std/tls/server's, under its test root.
const IDENTITY_ROOT: string = "";

const CLIENT_LEAF: string = "";

const CLIENT_PKCS8: string = "-----BEGIN PRIVATE KEY-----\n"
  + "MC4CAQAwBQYDK2VwBCIEIFVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV\n"
  + "-----END PRIVATE KEY-----\n";

// The wall clock the sessions run at, in Unix milliseconds: inside the test
// chain's validity (2020-01-01 to 2100-01-01), and the bounds of it.
const WALL_MS: i64 = 1700000000000;

const NOT_BEFORE_MS: i64 = 1577836800000;

const NOT_AFTER_MS: i64 = 4102444800000;

function roots(der: string): verify.Roots {
  return verify.roots([__codec_bytes(hex.decode(der))]);
}

function leaf_seed(): u8[] {
  let out: u8[] = [];
  while (out.len() < 32) {
    out = out.append(22 as u8);
  }
  return out;
}

struct Pair { session: client.Session, server: handshake.Server }

// connect runs a handshake between a session and a server whose chain is
// the test leaf; `forge` makes the server sign something else.
function connect(cfg: client.Config, alpn: string[], forge: boolean): Result[Pair, tls.TlsError] {
  return connect_at(cfg, alpn, forge, WALL_MS);
}

// connect_at is `connect` with the session's wall clock at `now`.
function connect_at(cfg: client.Config, alpn: string[], forge: boolean, now: i64): Result[Pair, tls.TlsError] {
  let start: client.Step = client.start(cfg, now)?;
  let sc: handshake.ServerConfig = handshake.ServerConfig { ...handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807]), alpn: alpn };
  let server: handshake.Server = srv(handshake.server_new(sc, random_bytes(handshake.server_entropy(sc))))?;
  let s1: handshake.ServerStep = srv(server.read(start.output))?;
  if (s1.events.len() == 0) {
    start = rd_at(start.session, s1.output, now)?;
    s1 = srv(s1.server.read(start.output))?;
  }
  let signed: u8[] = signing(s1.events);
  if (forge) {
    signed = signed.append(0 as u8);
  }
  let sig: u8[] = [];
  match (ed25519.sign(leaf_seed(), signed)) {
    Ok(b) => {
      sig = b;
    },
    Err(e) => {
      return Err(tls.SignatureInvalid);
    }
  }
  let s2: handshake.ServerStep = srv(s1.server.signature(sig))?;
  let c1: client.Step = rd_at(start.session, cat(s1.output, s2.output), now)?;
  let s3: handshake.ServerStep = srv(s2.server.read(c1.output))?;
  if (!c1.session.connected() || !s3.server.connected()) {
    return Err(tls.ClosedEarly);
  }
  return Ok(Pair { session: c1.session, server: s3.server });
}

function rd(s: client.Session, input: u8[]): Result[client.Step, tls.TlsError] {
  return rd_at(s, input, WALL_MS);
}

function rd_at(s: client.Session, input: u8[], now: i64): Result[client.Step, tls.TlsError] {
  match (s.read(input, now)) {
    Ok(step) => {
      return Ok(step);
    },
    Err(f) => {
      return Err(f.error);
    }
  }
  return Err(tls.ClosedEarly);
}

function srv[T](r: Result[T, handshake.HandshakeError]): Result[T, tls.TlsError] {
  match (r) {
    Ok(v) => {
      return Ok(v);
    },
    Err(e) => {
      return Err(tls.HandshakeFailed(e));
    }
  }
  return Err(tls.ClosedEarly);
}

function signing(events: handshake.Event[]): u8[] {
  for e in events {
    match (e) {
      handshake.SignNeeded(s) => {
        return s.signed;
      },
      _ => {}
    }
  }
  return [];
}

function cat(a: u8[], b: u8[]): u8[] {
  let out: u8[] = a;
  for x in b {
    out = out.append(x);
  }
  return out;
}

function outcome(r: Result[Pair, tls.TlsError]): string {
  match (r) {
    Ok(p) => {
      return "connected " + p.session.alpn();
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

// exchange sends "ping" from the session and "pong" back from the server.
function exchange(s: client.Session, server: handshake.Server): Result[string, tls.TlsError] {
  let cw: client.Step = s.write("ping".bytes())?;
  let sr: handshake.ServerStep = srv(server.read(cw.output))?;
  let sw: handshake.ServerStep = srv(sr.server.write("pong".bytes()))?;
  let cr: client.Step = rd(cw.session, sw.output)?;
  return Ok(string_from_bytes_unchecked(sr.data) + " " + string_from_bytes_unchecked(cr.data));
}

function exchanged(s: client.Session, server: handshake.Server): string {
  match (exchange(s, server)) {
    Ok(t) => {
      return t;
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_trusted(): test.TestOutcome {
  let cfg: client.Config = client.config("tls.example", roots(ROOT)).with_alpn(["h2", "http/1.1"]);
  match (connect(cfg, ["http/1.1"], false)) {
    Ok(p) => {
      if (p.session.alpn() != "http/1.1") {
        return test.fail("alpn " + p.session.alpn());
      }
      return test.assert_eq(exchanged(p.session, p.server), "ping pong");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// server_name is what the ClientHello in a first flight names, "-" for
// none.
function server_name(first: client.Step): string {
  match (record.deframe(first.output)) {
    Ok(d) => {
      match (message.decode(message.Raw { kind: message.CLIENT_HELLO, bytes: d.records[0].fragment })) {
        Ok(message.ClientHelloMsg(h)) => {
          match (message.find(h.extensions, message.EXT_SERVER_NAME)) {
            Some(data) => {
              match (message.server_name(data)) {
                Ok(n) => {
                  return n;
                },
                Err(e) => {
                  return e.message();
                }
              }
            },
            None => {
              return "-";
            }
          }
        },
        _ => {
          return "not a ClientHello";
        }
      }
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function first_flight(name: string): string {
  match (client.start(client.config(name, roots(ROOT)), WALL_MS)) {
    Ok(step) => {
      return server_name(step);
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_names(): test.TestOutcome {
  if (first_flight("tls.example") != "tls.example" || first_flight("192.0.2.7") != "-") {
    return test.fail("SNI: " + first_flight("tls.example") + " " + first_flight("192.0.2.7"));
  }
  if (outcome(connect(client.config("192.0.2.7", roots(ROOT)), [], false)) != "connected ") {
    return test.fail("an address: " + outcome(connect(client.config("192.0.2.7", roots(ROOT)), [], false)));
  }
  return test.assert_eq(outcome(connect(client.config("other.example", roots(ROOT)), [], false)), "the peer's certificate is not trusted: tls verify: the certificate is not valid for other.example");
}

function test_untrusted(): test.TestOutcome {
  if (outcome(connect(client.config("tls.example", roots(OTHER_ROOT)), [], false)) != "the peer's certificate is not trusted: tls verify: no path from the certificate reaches a trusted root") {
    return test.fail(outcome(connect(client.config("tls.example", roots(OTHER_ROOT)), [], false)));
  }
  match (refusal_alert()) {
    Ok(t) => {
      return test.assert_eq(t, "tls handshake: the peer sent alert 42");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// refusal_alert is what the server makes of the alert a refused chain
// sends: sealed under the handshake keys, it reads as bad_certificate.
function refusal_alert(): Result[string, tls.TlsError] {
  let start: client.Step = client.start(client.config("tls.example", roots(OTHER_ROOT)), WALL_MS)?;
  let sc: handshake.ServerConfig = handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807]);
  let s1: handshake.ServerStep = srv(srv(handshake.server_new(sc, random_bytes(handshake.server_entropy(sc))))?.read(start.output))?;
  let sig: u8[] = [];
  match (ed25519.sign(leaf_seed(), signing(s1.events))) {
    Ok(b) => {
      sig = b;
    },
    Err(e) => {
      return Err(tls.SignatureInvalid);
    }
  }
  let s2: handshake.ServerStep = srv(s1.server.signature(sig))?;
  match (start.session.read(cat(s1.output, s2.output), WALL_MS)) {
    Ok(step) => {
      return Ok("accepted");
    },
    Err(f) => {
      match (s2.server.read(f.alert)) {
        Ok(_) => {
          return Ok("the server read on");
        },
        Err(e) => {
          return Ok(e.message());
        }
      }
    }
  }
  return Ok("");
}

// The server's chain is judged at the time the session is given, not the
// machine's: a second outside either bound of its validity it is refused,
// and a second inside either bound it is accepted.
function test_validity_window(): test.TestOutcome {
  let cfg: client.Config = client.config("tls.example", roots(ROOT));
  if (outcome(connect_at(cfg, [], false, NOT_BEFORE_MS - 1000)) != "the peer's certificate is not trusted: tls verify: certificate 0 is not yet valid") {
    return test.fail("before notBefore: " + outcome(connect_at(cfg, [], false, NOT_BEFORE_MS - 1000)));
  }
  if (outcome(connect_at(cfg, [], false, NOT_AFTER_MS + 1000)) != "the peer's certificate is not trusted: tls verify: certificate 0 has expired") {
    return test.fail("after notAfter: " + outcome(connect_at(cfg, [], false, NOT_AFTER_MS + 1000)));
  }
  return test.assert_eq(outcome(connect_at(cfg, [], false, NOT_BEFORE_MS + 1000)) + "; " + outcome(connect_at(cfg, [], false, NOT_AFTER_MS - 1000)), "connected ; connected ");
}

function test_forged(): test.TestOutcome {
  return test.assert_eq(outcome(connect(client.config("tls.example", roots(ROOT)), [], true)), "the peer's CertificateVerify does not verify");
}

function test_save_restore(): test.TestOutcome {
  match (client.start(client.config("tls.example", roots(ROOT)), WALL_MS)) {
    Ok(step) => {
      match (step.session.save()) {
        Ok(b) => {
          return test.fail("saved before the handshake");
        },
        Err(e) => {}
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  match (client.restore([1 as u8, 0 as u8, 0 as u8, 19 as u8, 1 as u8, 0 as u8])) {
    Ok(s) => {
      return test.fail("restored from garbage");
    },
    Err(e) => {}
  }
  match (connect(client.config("tls.example", roots(ROOT)), [], false)) {
    Ok(p) => {
      if (exchanged(p.session, p.server) != "ping pong") {
        return test.fail("before");
      }
      match (p.session.save()) {
        Ok(saved) => {
          match (client.restore(saved)) {
            Ok(s) => {
              return test.assert_eq(exchanged(s, p.server), "ping pong");
            },
            Err(e) => {
              return test.fail(e.message());
            }
          }
        },
        Err(e) => {
          return test.fail(e.message());
        }
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// closes is what each side sees of the other's close_notify.
function closes(p: Pair): Result[string, tls.TlsError] {
  let sc: handshake.ServerStep = srv(p.server.close())?;
  let seen: client.Step = rd(p.session, sc.output)?;
  let cc: client.Step = p.session.close()?;
  let sr: handshake.ServerStep = srv(p.server.read(cc.output))?;
  if (seen.closed && sr.events.len() == 1) {
    return Ok("both");
  }
  return Ok("missed");
}

function test_close(): test.TestOutcome {
  match (connect(client.config("tls.example", roots(ROOT)), [], false)) {
    Ok(p) => {
      match (closes(p)) {
        Ok(t) => {
          return test.assert_eq(t, "both");
        },
        Err(e) => {
          return test.fail(e.message());
        }
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// has_resume is whether a server step asks about a ticket.
function has_resume(events: handshake.Event[]): boolean {
  for e in events {
    match (e) {
      handshake.ResumeOffered(o) => {
        return true;
      },
      _ => {}
    }
  }
  return false;
}

// issued has the server issue a ticket on a connected pair; the ticket as
// the session keeps it, and the PSK the server derives for it.
function issued(p: Pair): Result[(client.Ticket, u8[]), tls.TlsError] {
  let t: message.NewSessionTicket = message.NewSessionTicket { lifetime: 7200 as u32, age_add: 99 as u32, nonce: [0 as u8], ticket: "ticket-1".bytes(), extensions: [] };
  let st: handshake.ServerStep = srv(p.server.ticket(t))?;
  let cr: client.Step = rd(p.session, st.output)?;
  if (cr.tickets.len() != 1) {
    return Err(tls.HandshakeFailed(handshake.Misuse("tickets")));
  }
  return Ok((cr.tickets[0], srv(st.server.resumption_psk([0 as u8]))?));
}

// connect_resumed drives a session offering its ticket against a server
// that takes it up with `psk`; a server never asked is a refusal.
function connect_resumed(cfg: client.Config, psk: u8[]): Result[Pair, tls.TlsError] {
  let start: client.Step = client.start(cfg, WALL_MS)?;
  let server: handshake.Server = srv(handshake.server_new(handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807]), random_bytes(handshake.server_entropy(handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807])))))?;
  let s1: handshake.ServerStep = srv(server.read(start.output))?;
  if (!has_resume(s1.events)) {
    return Err(tls.HandshakeFailed(handshake.Misuse("no ticket offered")));
  }
  let s2: handshake.ServerStep = srv(s1.server.resume(Some(handshake.Resumed { index: 0, psk: psk })))?;
  let c1: client.Step = rd(start.session, s2.output)?;
  let s3: handshake.ServerStep = srv(s2.server.read(c1.output))?;
  if (!c1.session.connected() || !s3.server.connected() || !c1.session.resumed()) {
    return Err(tls.ClosedEarly);
  }
  return Ok(Pair { session: c1.session, server: s3.server });
}

// A ticket the server issued resumes the next session, whose chain is not
// judged; one issued to another name, or past its lifetime, is not offered.
function test_resumption(): test.TestOutcome {
  match (connect(client.config("tls.example", roots(ROOT)), [], false)) {
    Ok(p) => {
      match (issued(p)) {
        Ok(got) => {
          let t: client.Ticket = got.0;
          if (t.server_name != "tls.example" || t.suite != keyschedule.Aes128GcmSha256.code() || t.lifetime != 7200 as u32 || hex.encode(t.psk) != hex.encode(got.1)) {
            return test.fail("the ticket kept");
          }
          match (connect_resumed(client.config("tls.example", roots(OTHER_ROOT)).with_ticket(t), got.1)) {
            Ok(r) => {
              if (exchanged(r.session, r.server) != "ping pong") {
                return test.fail("after resuming");
              }
            },
            Err(e) => {
              return test.fail("resuming: " + e.message());
            }
          }
          if (outcome(connect_resumed(client.config("192.0.2.7", roots(ROOT)).with_ticket(t), got.1)) != "tls handshake: no ticket offered called out of turn") {
            return test.fail("another name: " + outcome(connect_resumed(client.config("192.0.2.7", roots(ROOT)).with_ticket(t), got.1)));
          }
          let stale: client.Ticket = client.Ticket { ...t, received_ms: t.received_ms - 7200 as i64 * (1000 as i64) };
          return test.assert_eq(outcome(connect_resumed(client.config("tls.example", roots(ROOT)).with_ticket(stale), got.1)), "tls handshake: no ticket offered called out of turn");
        },
        Err(e) => {
          return test.fail(e.message());
        }
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function client_shown(events: handshake.Event[]): Option[handshake.Verification] {
  for e in events {
    match (e) {
      handshake.VerifyClient(v) => {
        return Some(v);
      },
      _ => {}
    }
  }
  return None;
}

// connect_asked drives a session against a server asking for a client
// certificate and reports what it was shown: the chain's length and
// whether the signature verifies under the leaf's key.
function connect_asked(cfg: client.Config): Result[string, tls.TlsError] {
  let start: client.Step = client.start(cfg, WALL_MS)?;
  let sc: handshake.ServerConfig = handshake.ServerConfig { ...handshake.server_config([__codec_bytes(hex.decode(LEAF))], [0x0807]), request_client_certificate: true };
  let s1: handshake.ServerStep = srv(srv(handshake.server_new(sc, random_bytes(handshake.server_entropy(sc))))?.read(start.output))?;
  let sig: u8[] = [];
  match (ed25519.sign(leaf_seed(), signing(s1.events))) {
    Ok(b) => {
      sig = b;
    },
    Err(e) => {
      return Err(tls.SignatureInvalid);
    }
  }
  let s2: handshake.ServerStep = srv(s1.server.signature(sig))?;
  let c1: client.Step = rd(start.session, cat(s1.output, s2.output))?;
  let s3: handshake.ServerStep = srv(s2.server.read(c1.output))?;
  let shown: string = "not shown";
  match (client_shown(s3.events)) {
    Some(v) => {
      shown = "chain " + v.chain.len().to_string();
      if (v.chain.len() > 0) {
        match (verify.verify_client(v.chain, roots(IDENTITY_ROOT), 1700000000 as i64)) {
          Ok(leaf) => {
            if (verify.verify_signed(leaf, v.scheme, v.signed, v.signature)) {
              shown = shown + " verified";
            }
          },
          Err(e) => {
            shown = shown + " " + e.message();
          }
        }
      }
    },
    None => {}
  }
  let s4: handshake.ServerStep = srv(s3.server.verdict(true))?;
  if (!c1.session.connected() || !s4.server.connected()) {
    return Err(tls.ClosedEarly);
  }
  return Ok(shown);
}

function asked_outcome(cfg: client.Config): string {
  match (connect_asked(cfg)) {
    Ok(t) => {
      return t;
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

// A session with an identity presents it when asked, signed with its key;
// one without sends an empty Certificate.
function test_identity(): test.TestOutcome {
  let id: identity.Identity = identity.Identity { chain: [], key: identity.Ed25519Seed([]) };
  match (identity.from_pem(pem_of(CLIENT_LEAF), CLIENT_PKCS8)) {
    Ok(i) => {
      id = i;
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  if (asked_outcome(client.config("tls.example", roots(ROOT)).with_identity(id)) != "chain 1 verified") {
    return test.fail("with an identity: " + asked_outcome(client.config("tls.example", roots(ROOT)).with_identity(id)));
  }
  return test.assert_eq(asked_outcome(client.config("tls.example", roots(ROOT))), "chain 0");
}

function pem_of(der_hex: string): string {
  return pem.encode("CERTIFICATE", __codec_bytes(hex.decode(der_hex)));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/tls/client");
  r = r.it("a trusted server", test_trusted);
  r = r.it("names", test_names);
  r = r.it("an untrusted root", test_untrusted);
  r = r.it("the certificate validity window, at the given time", test_validity_window);
  r = r.it("a forged CertificateVerify", test_forged);
  r = r.it("save and restore", test_save_restore);
  r = r.it("close_notify", test_close);
  r = r.it("resumption", test_resumption);
  r = r.it("an identity", test_identity);
  return r.finish();
}

// Decode a valid fixture. Report a malformed fixture before the test exits.
function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
