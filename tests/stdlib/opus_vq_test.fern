import "std/hash/crc32";
import "std/opus/pvq";
import "std/opus/range";
import "std/opus/vq";
import "std/test";

// Each script codes random band shapes in one packet, with and without the
// shape the decoder gets, and then decodes them. The trace holds the bits of
// each value, each collapse mask, and the results of renormalise_vector and
// stereo_itheta. libopus 1.4, in its float build, gave the CRC-32 of each
// trace, from a C program that makes the same calls.

const LAST: i32[] = [176, 176, 176, 176, 176, 176, 96, 54, 37, 28, 24, 19, 18, 16, 14];

struct Gen { x: u32 }

function rnd(own g: Gen): (Gen, i32) {
  let x = g.x * 1664525u32 + 1013904223u32;
  return (Gen { x: x }, (x >> 8u32) as i32);
}

function frand(own g: Gen, lo: f32, hi: f32): (Gen, f32) {
  let (g1, r) = rnd(g);
  return (g1, lo + (hi - lo) * ((r % 65536) as f32) / 65536.0f32);
}

function reach(a: i32, b: i32): boolean {
  let mn = a;
  let mx = b;
  if (b < a) {
    mn = b;
    mx = a;
  }
  return mn <= 14 && mx <= LAST[mn];
}

function fits(n: i32, k: i32): boolean {
  if (!reach(n, k) || !reach(n, k + 1)) {
    return false;
  }
  return pvq.u(n, k) as i64 + pvq.u(n, k + 1) as i64 < 4294967296i64;
}

function all_bits(xs: [f32], n: i32): string {
  let s = "";
  for i in 0..n {
    s = s + " " + f32_bits(xs[i]).to_string();
  }
  return s;
}

function line(own c: crc32.Crc32, s: string): crc32.Crc32 {
  return c.update((s + "\n").as_bytes());
}

function trace(seed: u32, cases: i32): u32 {
  let t = crc32.new();
  let g = Gen { x: seed };
  let ns: i32[] = [];
  let ks: i32[] = [];
  let sps: i32[] = [];
  let bs: i32[] = [];
  let gs: f32[] = [];
  let e = range.encoder(60000);
  for c in 0..cases {
    let (g1, r1) = rnd(g);
    g = g1;
    let n = 0;
    if (r1 % 2 == 1) {
      let (g2, r2) = rnd(g);
      g = g2;
      n = 2 + r2 % 15;
    } else {
      let (g2, r2) = rnd(g);
      g = g2;
      n = 2 + r2 % 175;
    }
    let (g3, r3) = rnd(g);
    g = g3;
    let k = 1 + r3 % 128;
    while (!fits(n, k)) {
      let (g4, r4) = rnd(g);
      g = g4;
      k = 1 + r4 % 128;
    }
    let (g5, r5) = rnd(g);
    g = g5;
    let b = 1 << r5 % 4;
    while (n % b != 0) {
      b = b >> 1;
    }
    let (g6, r6) = rnd(g);
    let spread = r6 % 4;
    let (g7, r7) = rnd(g6);
    let resynth = r7 % 2 == 1;
    let (g8, gain) = frand(g7, 0.25f32, 2.0f32);
    g = g8;
    let v: f32[] = [];
    let w: f32[] = [];
    for i in 0..n {
      let (ga, a) = frand(g, -1.0f32, 1.0f32);
      let (gb, rb) = rnd(ga);
      g = gb;
      if (rb % 4 == 0) {
        a = 0.0f32;
      }
      let (gc, cw) = frand(g, -1.0f32, 1.0f32);
      g = gc;
      v = v.append(a);
      w = w.append(cw);
    }
    let q = vq.alg_quant(e, v, n, k, spread, b, gain, resynth);
    e = q.e;
    let rs = 0;
    if (resynth) {
      rs = 1;
    }
    t = line(t, "q " + n.to_string() + " " + k.to_string() + " " + spread.to_string() + " " + b.to_string() + " " + rs.to_string() + " " + q.mask.to_string() + " tell " + e.tell_frac().to_string() + " |" + all_bits(q.x, n));
    let w2 = vq.renormalise_vector(w, n, gain);
    t = line(t, "r" + all_bits(w2, n) + " t " + vq.stereo_itheta(q.x, w2, true, n).to_string() + " " + vq.stereo_itheta(q.x, w2, false, n).to_string());
    ns = ns.append(n);
    ks = ks.append(k);
    sps = sps.append(spread);
    bs = bs.append(b);
    gs = gs.append(gain);
  }
  let d = range.decoder(e.done().bytes());
  for c in 0..cases {
    let u = vq.alg_unquant(d, ns[c], ks[c], sps[c], bs[c], gs[c]);
    d = u.d;
    t = line(t, "u " + u.mask.to_string() + " |" + all_bits(u.x, ns[c]));
  }
  return t.finish();
}

function test_short_script(): test.TestOutcome {
  return test.assert_eq(trace(2u32, 300), 1287182931u32);
}

function test_long_script(): test.TestOutcome {
  return test.assert_eq(trace(3u32, 2000), 2256532715u32);
}

function ramp(): f32[] {
  let x: f32[] = [];
  for i in 0..48 {
    x = x.append((i % 7) as f32 - 3.0f32);
  }
  return x;
}

// The rotation after the decode undoes the rotation before the search.
function test_rotation_round_trip(): test.TestOutcome {
  let x = ramp();
  let y = vq.exp_rotation(vq.exp_rotation(ramp(), 48, 1, 2, 5, vq.SPREAD_NORMAL), 48, -1, 2, 5, vq.SPREAD_NORMAL);
  for i in 0..48 {
    let d = y[i] - x[i];
    if (d > 0.0001f32 || d < -0.0001f32) {
      return test.fail("value " + i.to_string() + " moved by " + d.to_string());
    }
  }
  return test.pass();
}

function main(): i32 {
  let r = test.new("std/opus/vq");
  r = r.it("a short script gives the libopus trace", test_short_script);
  r = r.it("a long script gives the libopus trace", test_long_script);
  r = r.it("the inverse rotation undoes the rotation", test_rotation_round_trip);
  return r.finish();
}
