import "std/opus/range";
import "std/audio/pcm";
import "std/opus/silk";
import "std/test";
import "opus_silk_packet_vectors";
import "opus_silk_frame_vectors";

function libopus_packet(): test.TestOutcome {
  let (_, last, output) = match (silk.decode_range(silk.decoder(), range.decoder(opus_silk_frame_vectors.LIBOPUS_PACKET), 16, 20, 1, 1)) {
    Ok(values) => values,
    Err(_) => { return test.fail("libopus packet rejected"); },
  };
  if (last.rng != opus_silk_frame_vectors.LIBOPUS_RANGE) {
    return test.fail("libopus packet final range");
  }
  let expected = opus_silk_frame_vectors.LIBOPUS_PRE_RESAMPLE;
  if (output.len() != expected.len()) {
    return test.fail("libopus packet output length");
  }
  for i in 0..output.len() {
    if (output[i] != expected[i]) {
      return test.fail("libopus packet PCM");
    }
  }
  return test.assert_true(true);
}

function packets(): test.TestOutcome {
  let rows = opus_silk_packet_vectors.PACKETS;
  let at = 0;
  let state = silk.decoder();
  while (at < rows.len()) {
    let rate = rows[at];
    let duration = rows[at + 1];
    let stream = rows[at + 2];
    let channels = rows[at + 3];
    let expected_range = rows[at + 4] as u32;
    let size = rows[at + 5];
    let packet: u8[] = [];
    for i in 0..size {
      packet = packet.append(rows[at + 6 + i] as u8);
    }
    let (next, last, output) = match (silk.decode_range(state, range.decoder(packet), rate, duration, stream, channels)) {
      Ok(values) => values,
      Err(_) => { return test.fail("reference packet rejected at " + at.to_string()); },
    };
    state = next;
    if (last.rng != expected_range) {
      return test.fail("packet final range at " + at.to_string());
    }
    at += size + 6;
    let count = rows[at];
    if (output.len() != count) {
      return test.fail("packet output length");
    }
    for i in 0..count {
      if (output[i] != rows[at + 1 + i]) {
        return test.fail("packet PCM at " + at.to_string() + " sample " + i.to_string() + " got " + output[i].to_string() + " expected " + rows[at + 1 + i].to_string());
      }
    }
    at += count + 1;
  }
  return test.assert_true(true);
}

function invalid(): test.TestOutcome {
  for args in [[48, 20, 1, 1], [16, 30, 1, 1], [16, 20, 3, 1], [16, 20, 1, 0]] {
    match (silk.decode_range(silk.decoder(), range.decoder(opus_silk_frame_vectors.LIBOPUS_PACKET), args[0], args[1], args[2], args[3])) {
      Err(pcm.Header) => {},
      _ => {
        return test.fail("invalid SILK packet parameters accepted");
      }
    }
  }
  for size in 0..4 {
    match (silk.decode_range(silk.decoder(), range.decoder(opus_silk_frame_vectors.LIBOPUS_PACKET[0:size]), 16, 20, 1, 1)) {
      Err(_) => {},
      Ok(_) => {
        return test.fail("truncated SILK packet accepted");
      }
    }
  }
  return test.assert_true(true);
}

function main(): i32 {
  let runner = test.new("SILK internal-rate packets");
  runner = runner.it("pinned libopus packet and delay", libopus_packet);
  runner = runner.it("stereo, redundancy, frame durations, and rate changes", packets);
  runner = runner.it("invalid packet parameters and truncation", invalid);
  return runner.finish();
}
