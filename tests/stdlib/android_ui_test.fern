// Tests of std/android/ui on the host: the layout, the gestures, and whole
// programs on the simulator. The test font has 1000 units to the em, and
// "A" is 600 units wide. So at 10 sp on a screen of 1 pixel to the dp,
// "AAA" is 18 pixels wide and a line is 10 pixels high.
import "core/map";
import "std/android";
import "std/android/draw";
import "std/android/text";
import "std/android/ui";
import "std/android/ui/scene";
import "std/android/ui/sim";
import "std/test";
import "std/truetype";
import "./image_vectors";

function fonts(): text.Fonts {
  if let Some(f) = truetype.parse(image_vectors.font()) {
    return text.Fonts { faces: [f], weights: [400] };
  }
  return text.Fonts { faces: [], weights: [] };
}

function screen(): ui.Screen {
  return ui.Screen { w: 200, h: 400, d: 1.0, dark: false, theme: ui.theme(false), left: 0, top: 0, right: 0, bottom: 0, font: 1.0 };
}

// The messages of the elements and of the programs of these tests.
enum Msg { Go, Row(i32), Cell(i32), Pick(i32), Open, Menu(i32), Under, Agree, Add, Switch, Clear, Left, Beat, Frame, Name(string), Sent, Next, Note(string), Slid(i32) }

// The name of the message and its number, as one word.
function name_of(m: Msg): string {
  match (m) {
    Go => {
      return "go0";
    },
    Row(i) => {
      return "row" + i.to_string();
    },
    Cell(i) => {
      return "cell" + i.to_string();
    },
    Pick(i) => {
      return "pick" + i.to_string();
    },
    Menu(i) => {
      return "menu" + i.to_string();
    },
    Under => {
      return "under0";
    },
    Agree => {
      return "ok0";
    },
    _ => {
      return "other";
    }
  }
}

// The number of the message of a tap on the node `n` of `b`, or -1.
function number_of(b: ui.Built[Msg], n: scene.Node): i32 {
  match (ui.tap_message(b.messages(), b.layout(), n)) {
    Some(Row(i)) => {
      return i;
    },
    Some(Cell(i)) => {
      return i;
    },
    Some(Pick(i)) => {
      return i;
    },
    _ => {
      return -1;
    }
  }
}

function laid_on(root: ui.El[Msg], s: ui.Screen, focus: ui.Focus): ui.Built[Msg] {
  return ui.layout(root, fonts(), s, map_new(4), focus);
}

function laid(root: ui.El[Msg]): ui.Built[Msg] {
  return laid_on(root, screen(), ui.no_focus());
}

// The nodes and the lists of the tree, for a test of the gestures.
function plain(root: ui.El[Msg]): ui.Layout {
  return laid(root).layout();
}

function scrolled(root: ui.El[Msg], name: string, to: i32): ui.Built[Msg] {
  let offsets: Map[string, i32] = map_new(4);
  return ui.layout(root, fonts(), screen(), offsets.insert(name, to), ui.no_focus());
}

function label(s: string): ui.El[Msg] {
  return ui.text(s).sized(10.0);
}

// The box of each node, as x,y,w,h.
function boxes(ns: scene.Node[]): string {
  let out: string[] = [];
  for n in ns {
    out = out.append(n.x.to_string() + "," + n.y.to_string() + "," + n.w.to_string() + "," + n.h.to_string());
  }
  return out.join(" ");
}

function test_column(): test.TestOutcome {
  let lay = laid(ui.column([label("AAA"), label("A"), label("AA")]).spaced(5.0).padding(10.0));
  return test.assert_eq(boxes(lay.nodes), "10,10,18,10 10,25,6,10 10,40,12,10");
}

function test_column_alignment(): test.TestOutcome {
  let mid = laid(ui.column([label("AAA"), label("A")]).centered());
  let end = laid(ui.column([label("AAA"), label("A")]).aligned(ui.END).justified(ui.END));
  let apart = laid(ui.column([label("A"), label("A"), label("A")]).justified(ui.BETWEEN));
  return test.assert_eq(boxes(mid.nodes) + " | " + boxes(end.nodes) + " | " + boxes(apart.nodes), "91,190,18,10 97,200,6,10 | 182,380,18,10 194,390,6,10 | 0,0,6,10 0,195,6,10 0,390,6,10");
}

function test_row_shares_the_room(): test.TestOutcome {
  let lay = laid(ui.row([ui.box().width(20.0).background(ui.PRIMARY), ui.box().grow(1.0).background(ui.SURFACE), ui.box().grow(2.0).background(ui.OUTLINE)]).spaced(10.0).height(30.0));
  // 200 less 20 and two gaps of 10 is 160: 53 and 106.
  return test.assert_eq(boxes(lay.nodes), "0,0,20,0 30,0,53,30 93,0,106,30");
}

function test_stretch(): test.TestOutcome {
  let lay = laid(ui.column([ui.box().height(10.0).background(ui.PRIMARY)]).aligned(ui.STRETCH).padding_xy(20.0, 0.0));
  return test.assert_eq(boxes(lay.nodes), "20,0,160,10");
}

function test_a_space_in_a_row_adds_no_height(): test.TestOutcome {
  // The space grows across the row too. The row is as high as its texts,
  // so the box below it is 10 pixels down, and the space is not a node.
  let lay = laid(ui.column([ui.row([label("A"), ui.space(), label("A")]), ui.box().width(20.0).height(20.0).background(ui.PRIMARY)]));
  return test.assert_eq(boxes(lay.nodes), "0,0,6,10 194,0,6,10 0,10,20,20");
}

function test_stack(): test.TestOutcome {
  let lay = laid(ui.stack([ui.box().grow(1.0).background(ui.SURFACE), label("AA")]).centered());
  return test.assert_eq(boxes(lay.nodes), "0,0,200,400 94,195,12,10");
}

function test_text_wraps(): test.TestOutcome {
  let f = fonts();
  let space = text.width(f, 0, 10, "A A") - 12;
  // Three words of 18 pixels: two fit in a row of 50 pixels when a space
  // is at most 14 pixels wide.
  let lay = laid(ui.column([label("AAA AAA AAA")]).width(50.0));
  let one = laid(ui.column([label("AAA AAA AAA").clamped(1)]).width(50.0));
  let got = (space <= 14).to_string() + " " + lay.nodes.len().to_string() + " " + lay.nodes[1].y.to_string() + " " + one.nodes.len().to_string();
  let cut = "";
  match (one.nodes[0].paint) {
    scene.Label(s, _, _, _, _) => {
      cut = s;
    },
    _ => {}
  }
  return test.assert_eq(got + " " + cut.ends_with("…").to_string(), "true 2 10 1 true");
}

function test_roles_take_the_theme(): test.TestOutcome {
  let dark = ui.Screen { ...screen(), theme: ui.theme(true) };
  let lay = laid_on(ui.box().grow(1.0).background(ui.SURFACE), dark, ui.no_focus());
  let own_color = laid(ui.box().grow(1.0).background(draw.rgb(1, 2, 3)));
  let got = "";
  match (lay.nodes[0].paint) {
    scene.Fill(c, _) => {
      got = (c == ui.theme(true).surface).to_string();
    },
    _ => {}
  }
  match (own_color.nodes[0].paint) {
    scene.Fill(c, _) => {
      got = got + " " + (c == draw.rgb(1, 2, 3)).to_string();
    },
    _ => {}
  }
  return test.assert_eq(got, "true true");
}

function test_safe_area(): test.TestOutcome {
  let s = ui.Screen { ...screen(), top: 24, bottom: 48 };
  let lay = laid_on(ui.box().grow(1.0).background(ui.SURFACE), s, ui.no_focus());
  return test.assert_eq(boxes(lay.nodes) + " " + s.height().to_string(), "0,24,200,328 328");
}

function test_button(): test.TestOutcome {
  let lay = laid(ui.column([ui.button("AA", Go)]).padding(10.0));
  // 14 sp: "AA" is 17 pixels wide and 15 high, with 24 dp at each side.
  let n = lay.nodes[0];
  let r = 0;
  match (n.paint) {
    scene.Fill(_, fr) => {
      r = fr;
    },
    _ => {}
  }
  let said = ui.tap_message(lay.messages(), lay.layout(), n).map((m: Msg): string => name_of(m)).unwrap_or("none");
  return test.assert_eq(boxes(lay.nodes) + " " + said + " " + r.to_string(), "10,10,65,40 34,22,17,15 go0 20");
}

function rows(n: i32): ui.El[Msg][] {
  let out: ui.El[Msg][] = [];
  for i in 0..n {
    out = out.append(ui.row([label("A")]).height(50.0).wide().on_tap(Row(i)));
  }
  return out;
}

function test_scroll_column(): test.TestOutcome {
  let root: ui.El[Msg] = ui.column([ui.box().height(100.0), ui.column(rows(20)).scroll("items").grow(1.0)]);
  let top = laid(root);
  let moved = scrolled(root, "items", 120);
  let past = scrolled(root, "items", 5000);
  let s = top.scrollers[0];
  // The list is 300 pixels high and its rows are 1000: it scrolls 700. Six
  // rows show at the top, and seven after 120 pixels. A list goes at most
  // its own height past its end.
  let first = moved.nodes[1];
  let got = s.name + " " + s.y.to_string() + " " + s.h.to_string() + " " + s.limit.to_string() + " " + top.nodes.len().to_string() + " " + moved.nodes.len().to_string() + " " + number_of(moved, first).to_string() + " " + first.y.to_string() + " " + first.clip0.to_string() + " " + first.clip1.to_string() + " " + first.group + " " + past.nodes[past.nodes.len() - 1].y.to_string();
  return test.assert_eq(got, "items 100 300 700 13 15 2 80 100 400 items 100");
}

function test_list_builds_the_rows_that_show(): test.TestOutcome {
  let root: ui.El[Msg] = ui.list("big", 100000, 40.0, (i: i32): ui.El[Msg] => ui.row([label("A")]).on_tap(Pick(i)));
  let top = laid(root);
  let far = scrolled(root, "big", 2000010);
  // The first node is the list itself, and each row has two nodes.
  let n = far.nodes[1];
  let got = top.scrollers[0].limit.to_string() + " " + top.nodes.len().to_string() + " " + far.nodes.len().to_string() + " " + number_of(far, n).to_string() + " " + n.y.to_string() + " " + n.h.to_string();
  return test.assert_eq(got, "3999600 21 23 50000 -10 40");
}

function cells(n: i32): ui.El[Msg][] {
  let out: ui.El[Msg][] = [];
  for i in 0..n {
    let cell: ui.El[Msg] = ui.box().width(80.0).height(60.0).background(ui.SURFACE).on_tap(Cell(i));
    out = out.append(cell);
  }
  return out;
}

function test_row_scrolls_across(): test.TestOutcome {
  // Ten cells of 80 pixels in a row of 200: the row scrolls 600. After 100
  // pixels, the cells 1 to 3 show, between the columns 0 and 200.
  let root = ui.column([ui.row(cells(10)).scroll("strip").wide()]).padding_xy(0.0, 20.0);
  let top = laid(root);
  let moved = scrolled(root, "strip", 100);
  let s = top.scrollers[0];
  let first = moved.nodes[1];
  let got = s.across.to_string() + " " + s.limit.to_string() + " " + top.nodes.len().to_string() + " " + moved.nodes.len().to_string() + " " + number_of(moved, first).to_string() + " " + first.x.to_string() + " " + first.left.to_string() + " " + first.right.to_string() + " " + down_up(moved, 10, 30) + " " + down_up(moved, 70, 30);
  return test.assert_eq(got, "true 600 4 4 1 -20 0 200 cell1 cell2");
}

// A list that scrolls down, with a row that scrolls across as its second
// element.
function nested(): ui.El[Msg] {
  let kids = rows(20);
  return ui.column([kids[0], ui.row(cells(10)).scroll("strip").wide(), ui.column(kids).wide()]).scroll("page");
}

function drag(lay: ui.Layout, x0: i32, y0: i32, x1: i32, y1: i32): ui.Input {
  let (inp, _) = ui.touch(ui.no_input(), lay, 0, x0, y0, 0i64, 1.0);
  for i in 1..11 {
    let (next, _) = ui.touch(inp, lay, 2, x0 + (x1 - x0) * i / 10, y0 + (y1 - y0) * i / 10, i as i64 * 16000000i64, 1.0);
    inp = next;
  }
  return inp;
}

function test_a_drag_takes_the_list_of_its_direction(): test.TestOutcome {
  let lay = plain(nested());
  let across = drag(lay, 150, 80, 50, 85);
  let down = drag(lay, 150, 80, 155, 30);
  let got = across.offset("strip").to_string() + " " + across.offset("page").to_string() + " " + down.offset("strip").to_string() + " " + down.offset("page").to_string() + " " + lay.scrollers[1].parent;
  return test.assert_eq(got, "90 0 0 40 page");
}

function test_a_list_springs_back_from_its_end(): test.TestOutcome {
  let lay = plain(ui.column(rows(20)).scroll("items"));
  // The finger pulls the top of the list 99 pixels down after the slop: the
  // list goes half as far past its end.
  let pull = drag(lay, 100, 100, 100, 210);
  let pulled = pull.offset("items");
  let (lifted, _) = ui.touch(pull, lay, 1, 100, 210, 200000000i64, 1.0);
  let mid = ui.advance(lifted, lay, 250000000i64);
  let end = ui.advance(mid, lay, 2000000000i64);
  let got = pulled.to_string() + " " + lifted.flinging().to_string() + " " + (mid.offset("items") > pulled && mid.offset("items") < 0).to_string() + " " + end.offset("items").to_string() + " " + end.flinging().to_string();
  return test.assert_eq(got, "-49 true true 0 false");
}

function test_a_fling_passes_its_end_and_springs_back(): test.TestOutcome {
  let lay = plain(ui.column(rows(20)).scroll("items"));
  let (inp, _) = ui.touch(ui.no_input(), lay, 0, 100, 100, 0i64, 1.0);
  for i in 1..6 {
    let (next, _) = ui.touch(inp, lay, 2, 100, 100 + i * 4, i as i64 * 10000000i64, 1.0);
    inp = next;
  }
  // The list is 6 pixels past its top. A list past its end springs back
  // and does not fling.
  let (lifted, _) = ui.touch(inp, lay, 1, 100, 120, 50000000i64, 1.0);
  let low = scrolled_input(lay);
  let flings = low.flung + " " + (low.offset("items") < 600).to_string();
  let hit = ui.advance(low, lay, 80000000i64);
  let far = hit.offset("items");
  let over = ui.advance(hit, lay, 110000000i64).offset("items");
  let rest = ui.advance(ui.advance(hit, lay, 110000000i64), lay, 3000000000i64);
  let got = lifted.sprung + " " + flings + " " + far.to_string() + " " + (over > 600).to_string() + " " + hit.sprung + " " + rest.offset("items").to_string() + " " + rest.flinging().to_string();
  return test.assert_eq(got, "items items true 600 true items 600 false");
}

// A fast fling up from 500 pixels down the list, which has 100 pixels
// left: the finger moves 81 pixels in 20 ms.
function scrolled_input(lay: ui.Layout): ui.Input {
  let start = ui.Input { ...ui.no_input(), offsets: ui.no_input().offsets.insert("items", 500) };
  let (inp, _) = ui.touch(start, lay, 0, 100, 380, 0i64, 1.0);
  for i in 1..11 {
    let (next, _) = ui.touch(inp, lay, 2, 100, 380 - i * 9, i as i64 * 2000000i64, 1.0);
    inp = next;
  }
  let (lifted, _) = ui.touch(inp, lay, 1, 100, 290, 20000000i64, 1.0);
  return lifted;
}

function test_a_shorter_list_goes_back_to_its_end(): test.TestOutcome {
  let long = plain(ui.column(rows(20)).scroll("items"));
  let short = plain(ui.column(rows(8)).scroll("items"));
  let at_end = ui.Input { ...ui.no_input(), offsets: ui.no_input().offsets.insert("items", 600) };
  return test.assert_eq(ui.advance(at_end, long, 0i64).offset("items").to_string() + " " + ui.advance(at_end, short, 0i64).offset("items").to_string(), "600 0");
}

// The message of a tap at x and y, as `name_of` gives it, or "none".
function down_up(b: ui.Built[Msg], x: i32, y: i32): string {
  let lay = b.layout();
  let (a, _) = ui.touch(ui.no_input(), lay, 0, x, y, 0i64, 1.0);
  let (_, on) = ui.touch(a, lay, 1, x, y, 50000000i64, 1.0);
  if let Some(n) = on {
    if let Some(m) = ui.tap_message(b.messages(), lay, n) {
      return name_of(m);
    }
  }
  return "none";
}

function test_tap(): test.TestOutcome {
  let lay = laid(ui.column([ui.button("A", Go), ui.column(rows(3))]));
  return test.assert_eq(down_up(lay, 10, 10) + " " + down_up(lay, 10, 110) + " " + down_up(lay, 150, 10), "go0 row1 none");
}

function test_drag_scrolls_and_does_not_tap(): test.TestOutcome {
  let root = ui.column(rows(20)).scroll("items");
  let lay = plain(root);
  let (a, _) = ui.touch(ui.no_input(), lay, 0, 100, 300, 0i64, 1.0);
  let (b, _) = ui.touch(a, lay, 2, 100, 295, 16000000i64, 1.0);
  let small = b.offset("items");
  // The drag starts where the finger passes 8 pixels.
  let (c, _) = ui.touch(b, lay, 2, 100, 280, 32000000i64, 1.0);
  let (d, _) = ui.touch(c, lay, 2, 100, 200, 48000000i64, 1.0);
  let (e, m) = ui.touch(d, lay, 1, 100, 200, 400000000i64, 1.0);
  return test.assert_eq(small.to_string() + " " + c.offset("items").to_string() + " " + d.offset("items").to_string() + " " + m.is_none().to_string() + " " + e.flinging().to_string(), "0 0 80 true false");
}

function test_fling_goes_on_and_stops_at_the_end(): test.TestOutcome {
  let root = ui.column(rows(20)).scroll("items");
  let lay = plain(root);
  let (inp, _) = ui.touch(ui.no_input(), lay, 0, 100, 380, 0i64, 1.0);
  for i in 1..11 {
    let (next, _) = ui.touch(inp, lay, 2, 100, 380 - i * 30, i as i64 * 10000000i64, 1.0);
    inp = next;
  }
  let (lifted, _) = ui.touch(inp, lay, 1, 100, 80, 100000000i64, 1.0);
  let at_lift = lifted.offset("items");
  let mid = ui.advance(lifted, lay, 200000000i64);
  let end = ui.advance(mid, lay, 5000000000i64);
  let got = lifted.flinging().to_string() + " " + (mid.offset("items") > at_lift).to_string() + " " + end.offset("items").to_string() + " " + end.flinging().to_string();
  return test.assert_eq(got, "true true 600 false");
}

function test_long_press(): test.TestOutcome {
  let b0 = laid(ui.box().width(100.0).height(100.0).on_tap(Open).on_long(Menu(7)));
  let lay = b0.layout();
  let (a, _) = ui.touch(ui.no_input(), lay, 0, 10, 10, 0i64, 1.0);
  let early = ui.long_wait(a, 100000000i64);
  let (b, none) = ui.long_press(a, 399000000i64);
  let (c, on) = ui.long_press(b, 400000000i64);
  let (d, tap) = ui.touch(c, lay, 1, 10, 10, 500000000i64, 1.0);
  let got = early.to_string() + " " + none.is_none().to_string() + " " + ui.long_wait(c, 400000000i64).to_string() + " " + tap.is_none().to_string();
  if let Some(n) = on {
    got = got + " " + ui.long_message(b0.messages(), lay, n).map((m: Msg): string => name_of(m)).unwrap_or("none");
  }
  return test.assert_eq(got, "300 true -1 true menu7");
}

function test_pressed_node_shows(): test.TestOutcome {
  let lay = plain(ui.column([ui.button("A", Go)]));
  let (a, _) = ui.touch(ui.no_input(), lay, 0, 10, 10, 0i64, 1.0);
  let pressed = ui.shown(a, lay, draw.rgba(0, 0, 0, 31));
  let (b, _) = ui.touch(a, lay, 1, 10, 10, 50000000i64, 1.0);
  let over = pressed[1];
  let r = 0;
  match (over.paint) {
    scene.Fill(_, fr) => {
      r = fr;
    },
    _ => {}
  }
  return test.assert_eq(lay.nodes.len().to_string() + " " + pressed.len().to_string() + " " + ui.shown(b, lay, 0).len().to_string() + " " + r.to_string() + " " + over.w.to_string(), "2 3 2 20 " + lay.nodes[0].w.to_string());
}

function test_modal_takes_the_touches(): test.TestOutcome {
  let page: ui.El[Msg] = ui.column([ui.button("A", Under)]);
  let dialog: ui.El[Msg] = ui.stack([ui.column([ui.button("A", Agree)]).padding(20.0).background(ui.SURFACE)]).centered().grow(1.0).background(draw.rgba(0, 0, 0, 128)).modal();
  let lay = laid(ui.stack([page, dialog]));
  return test.assert_eq(down_up(lay, 10, 10) + " " + down_up(lay, 100, 200), "none ok0");
}

// --- a program

struct Counter { count: i32, backs: i32, ticks: i32, on: boolean }

function counter_view(m: Counter, s: ui.Screen): ui.El[Msg] {
  return ui.column([label("A".repeat(m.count)), ui.button("V", Add), ui.toggle(m.on, "switch", Switch), ui.box().width(50.0).height(50.0).on_long(Clear).described("reset")]).spaced(10.0);
}

function counter_update(own m: Counter, msg: Msg): Counter {
  match (msg) {
    Add => {
      return Counter { ...m, count: m.count + 1 };
    },
    Switch => {
      return Counter { ...m, on: !m.on };
    },
    Clear => {
      return Counter { ...m, count: 0 };
    },
    Left => {
      return Counter { ...m, backs: m.backs + 1 };
    },
    Beat => {
      return Counter { ...m, ticks: m.ticks + 1 };
    },
    _ => {
      return m;
    }
  }
}

function counter(): ui.Program[Counter, Msg] {
  return ui.program(counter_view, counter_update);
}

function new_counter(): Counter {
  return Counter { count: 0, backs: 0, ticks: 0, on: false };
}

function test_program_taps(): test.TestOutcome {
  let s = sim.start(new_counter(), counter(), fonts(), 200, 400, 1.0);
  let first = s.shell.host.frames;
  s = sim.tap(sim.tap(sim.tap(s, "V"), "V"), "missing");
  let got = (first > 0).to_string() + " " + s.shell.app.count.to_string() + " " + sim.shows(s, "AA").to_string() + " " + sim.texts(s).len().to_string();
  return test.assert_eq(got, "true 2 true 2");
}

function test_program_long_press_and_toggle(): test.TestOutcome {
  let s = sim.start(new_counter(), counter(), fonts(), 200, 400, 1.0);
  s = sim.tap(sim.tap(s, "V"), "switch, off");
  let on = s.shell.app.on;
  s = sim.hold(s, "reset");
  return test.assert_eq(on.to_string() + " " + s.shell.app.count.to_string() + " " + sim.spoken(s).join("|"), "true 0 V|switch, on|reset");
}

function test_back_closes_or_tells(): test.TestOutcome {
  let closed = sim.back(sim.start(new_counter(), counter(), fonts(), 200, 400, 1.0));
  let told = sim.back(sim.start(new_counter(), counter().with_back((m: Counter): Option[Msg] => Some(Left)), fonts(), 200, 400, 1.0));
  let got = sim.finished(closed).to_string() + " " + closed.shell.app.backs.to_string() + " " + sim.finished(told).to_string() + " " + told.shell.app.backs.to_string();
  return test.assert_eq(got, "true 0 false 1");
}

function test_wait_gives_ticks(): test.TestOutcome {
  let p = counter().with_tick((m: Counter): i32 => 100, Beat);
  let s = sim.after(sim.start(new_counter(), p, fonts(), 200, 400, 1.0), 350i64);
  return test.assert_eq(s.shell.app.ticks.to_string() + " " + s.now.to_string(), "3 350");
}

// A finger moves for 250 ms and no tick comes in that time. The tick of
// 100 ms is then due at once, and the next one is 100 ms after it.
function test_events_do_not_move_a_tick(): test.TestOutcome {
  let p = counter().with_tick((m: Counter): i32 => 100, Beat);
  let s = sim.drag(sim.start(new_counter(), p, fonts(), 200, 400, 1.0), 20, 300, 20, 310, 250i64);
  let due = ui.wait(s.shell, p);
  let t = sim.event(s, android.Tick);
  return test.assert_eq(due.to_string() + " " + t.shell.app.ticks.to_string() + " " + ui.wait(t.shell, p).to_string(), "0 1 100");
}

struct Feed { picked: i32, frames: i32 }

function feed_view(m: Feed, s: ui.Screen): ui.El[Msg] {
  return ui.list("feed", 1000, 50.0, (i: i32) => ui.row([label("A")]).on_tap(Pick(i)));
}

function feed_update(own m: Feed, msg: Msg): Feed {
  match (msg) {
    Pick(i) => {
      return Feed { ...m, picked: i };
    },
    Frame => {
      return Feed { ...m, frames: m.frames + 1 };
    },
    _ => {
      return m;
    }
  }
}

function feed(): ui.Program[Feed, Msg] {
  return ui.program(feed_view, feed_update);
}

function test_program_scrolls_and_flings(): test.TestOutcome {
  let s = sim.start(Feed { picked: -1, frames: 0 }, feed(), fonts(), 200, 400, 1.0);
  // The drag starts at the first move, 50 pixels up, so the list goes 250.
  s = sim.drag(s, 100, 350, 100, 50, 96i64);
  let dragged = s.shell.host.input.offset("feed");
  let flinging = s.shell.host.input.flinging();
  s = sim.settle(s);
  let rest = s.shell.host.input.offset("feed");
  s = sim.tap_at(s, 100, 200);
  let got = dragged.to_string() + " " + flinging.to_string() + " " + (rest > dragged + 300).to_string() + " " + (s.shell.app.picked == (rest + 200) / 50).to_string() + " " + s.shell.app.frames.to_string();
  return test.assert_eq(got, "250 true true true 0");
}

function test_animating_gives_frames(): test.TestOutcome {
  let p = feed().with_frames((m: Feed): boolean => m.frames < 3, (ns: i64): Msg => Frame);
  let s = sim.start(Feed { picked: -1, frames: 0 }, p, fonts(), 200, 400, 1.0);
  for i in 0..5 {
    s = sim.frame(s);
  }
  return test.assert_eq(s.shell.app.frames, 3);
}

function test_theme_follows_the_system(): test.TestOutcome {
  let s = sim.start(new_counter(), counter(), fonts(), 200, 400, 1.0);
  let light = s.shell.host.screen.theme.background;
  s = sim.event(sim.themed(s, true), android.WindowResized(android.Window { ptr: 1 as usize }));
  let fr = sim.picture(s);
  defer draw.release(fr);
  let got = (light == ui.theme(false).background).to_string() + " " + (s.shell.host.screen.theme.background == ui.theme(true).background).to_string() + " " + (fr.pixel(199, 399) == ui.theme(true).background).to_string();
  return test.assert_eq(got, "true true true");
}

function test_a_theme_follows_the_state(): test.TestOutcome {
  // The switch of the counter chooses the dark colors.
  let s = sim.start(new_counter(), counter().with_theme_of((m: Counter, dark: boolean): ui.Theme => ui.theme(m.on || dark)), fonts(), 200, 400, 1.0);
  let first = sim.picture(s);
  defer draw.release(first);
  s = sim.send(s, Switch);
  let second = sim.picture(s);
  defer draw.release(second);
  s = sim.send(s, Switch);
  let third = sim.picture(s);
  defer draw.release(third);
  let got = [first.pixel(199, 399) == ui.theme(false).background, second.pixel(199, 399) == ui.theme(true).background, third.pixel(199, 399) == ui.theme(false).background];
  return test.assert_eq(got.map((b: boolean): string => b.to_string()).join(" "), "true true true");
}

function test_text_follows_the_font_scale(): test.TestOutcome {
  // At twice the font size, "AAA" at 10 sp is 36 pixels wide and 20 high.
  // A size in dp does not change.
  let big = ui.Screen { ...screen(), font: 2.0 };
  let lay = laid_on(ui.column([label("AAA"), ui.box().width(10.0).height(10.0).background(ui.PRIMARY)]), big, ui.no_focus());
  let s = sim.scaled(sim.start(new_counter(), counter(), fonts(), 200, 400, 1.0), 1.5);
  return test.assert_eq(boxes(lay.nodes) + " " + s.shell.host.screen.font.to_string(), "0,0,36,20 0,20,10,10 1.5");
}

// --- sliders and effects

struct Dial { part: f64, asked: string[], done: i32 }

function dial_view(m: Dial, s: ui.Screen): ui.El[Msg] {
  return ui.column([ui.slider(m.part, (part: f64): Msg => Slid((part * 100.0 + 0.5) as i32)).described("level"), ui.column(rows(20)).scroll("items").grow(1.0)]);
}

function dial_update(own m: Dial, msg: Msg): Dial {
  match (msg) {
    Slid(percent) => {
      return Dial { ...m, part: percent as f64 / 100.0, asked: m.asked.append("set " + percent.to_string()) };
    },
    _ => {
      return m;
    }
  }
}

function new_dial(): Dial {
  return Dial { part: 0.5, asked: [], done: 0 };
}

function test_slider_layout(): test.TestOutcome {
  // The slider is 48 pixels high. Its track of 4 pixels is 10 pixels in
  // from each side, and its thumb of 20 pixels is at the middle.
  let lay = laid(ui.column([ui.slider(0.5, (part: f64): Msg => Slid(0))]));
  let thumb = lay.nodes[lay.nodes.len() - 1];
  return test.assert_eq(boxes([lay.nodes[0], lay.nodes[1]]) + " " + thumb.x.to_string() + "," + thumb.y.to_string() + "," + thumb.w.to_string() + " " + lay.nodes[0].tap.name + " " + lay.slides.len().to_string(), "0,0,200,48 10,22,180,4 90,14,20 slider 1");
}

function test_a_finger_moves_a_slider(): test.TestOutcome {
  let s = sim.start(new_dial(), ui.program(dial_view, dial_update), fonts(), 200, 400, 1.0);
  s = sim.slide(s, "level", 0.25);
  let tapped = s.shell.app.asked.join("|");
  // A drag from the slider down into the list moves the thumb, and does
  // not scroll the list.
  s = sim.drag(s, 100, 24, 190, 300, 64i64);
  let got = tapped + " / " + s.shell.app.part.to_string() + " " + s.shell.host.input.offset("items").to_string() + " " + s.shell.app.asked.len().to_string();
  return test.assert_eq(got, "set 25|set 25 / 1 0 8");
}

function test_effects_run_after_each_message(): test.TestOutcome {
  // The effects take what the state asks, as a device does.
  let p = ui.program(dial_view, dial_update).with_effects((m: Dial): Dial => Dial { ...m, asked: [], done: m.done + m.asked.len() });
  let s = sim.slide(sim.start(new_dial(), p, fonts(), 200, 400, 1.0), "level", 0.75);
  return test.assert_eq(s.shell.app.done.to_string() + " " + s.shell.app.asked.len().to_string() + " " + s.shell.app.part.to_string(), "2 0 0.75");
}

// --- text fields

struct Form { name: string, sent: string, backs: i32, upper: boolean, gone: boolean }

function name_field(value: string): ui.El[Msg] {
  return ui.field("name", value, "AV").on_edit((t: string): Msg => Name(t)).on_submit(Sent);
}

function form_view(m: Form, s: ui.Screen): ui.El[Msg] {
  if (m.gone) {
    return ui.column([ui.button("A", Next)]);
  }
  return ui.column([name_field(m.name), ui.button("A", Next)]).spaced(10.0);
}

function form_update(own m: Form, msg: Msg): Form {
  match (msg) {
    Name(t) => {
      if (m.upper) {
        return Form { ...m, name: t.to_upper() };
      }
      return Form { ...m, name: t };
    },
    Sent => {
      return Form { ...m, sent: m.name, name: "" };
    },
    Next => {
      return Form { ...m, gone: m.upper };
    },
    Left => {
      return Form { ...m, backs: m.backs + 1 };
    },
    _ => {
      return m;
    }
  }
}

function form(upper: boolean): sim.Sim[Form, Msg] {
  return sim.start(Form { name: "", sent: "", backs: 0, upper: upper, gone: false }, ui.program(form_view, form_update), fonts(), 200, 400, 1.0);
}

function test_field_layout(): test.TestOutcome {
  // The field is 56 dp high: its background, its hint at 16 sp, which is
  // 19 pixels wide and 17 high, and its line of 1 dp. In focus it has a
  // caret before the hint, and its line is 2 dp.
  let root: ui.El[Msg] = ui.column([name_field("")]);
  let unfocused = laid(root);
  let focused = laid_on(root, screen(), ui.Focus { field: "name", caret: 0 });
  let tap = unfocused.nodes[0].tap.name;
  return test.assert_eq(boxes(unfocused.nodes) + " | " + boxes(focused.nodes) + " | " + (tap == ui.FIELD_ACTION + "name").to_string(), "0,0,200,56 16,19,19,17 0,55,200,1 | 0,0,200,56 16,19,19,17 17,19,2,17 0,54,200,2 | true");
}

function test_field_takes_text(): test.TestOutcome {
  let s = form(false);
  let before = sim.keyboard(s).is_none();
  s = sim.type_in(s, "name", "AVA");
  let got = before.to_string() + " " + s.shell.app.name + " " + s.shell.host.focus + " " + sim.keyboard(s).unwrap_or("none") + " " + sim.shows(s, "AVA").to_string();
  return test.assert_eq(got, "true AVA name  true");
}

function test_field_submits_and_clears(): test.TestOutcome {
  let s = sim.enter(sim.type_in(form(false), "name", "AVA"));
  let got = s.shell.app.sent + " [" + s.shell.app.name + "] [" + s.shell.host.focus + "] " + sim.keyboard(s).is_none().to_string() + " " + sim.shows(s, "AV").to_string();
  return test.assert_eq(got, "AVA [] [] true true");
}

function test_program_changes_the_text(): test.TestOutcome {
  // The program makes the text upper case, so the keyboard gets that text.
  let s = sim.type_in(form(true), "name", "ava");
  return test.assert_eq(s.shell.app.name + " " + sim.keyboard(s).unwrap_or("none") + " " + s.shell.host.typed, "AVA AVA AVA");
}

function test_focus_goes_away(): test.TestOutcome {
  let tapped = sim.tap_nth(sim.type_in(form(false), "name", "A"), "A", 1);
  let backed = sim.back(sim.type_in(form(false), "name", "A"));
  let once = "[" + backed.shell.host.focus + "] " + sim.finished(backed).to_string();
  let again = sim.back(backed);
  let removed = sim.tap_nth(sim.type_in(form(true), "name", "A"), "A", 1);
  let got = "[" + tapped.shell.host.focus + "] " + sim.keyboard(tapped).is_none().to_string() + " " + once + " " + sim.finished(again).to_string() + " [" + removed.shell.host.focus + "] " + sim.keyboard(removed).is_none().to_string();
  return test.assert_eq(got, "[] true [] false true [] true");
}

function test_hardware_keys_type(): test.TestOutcome {
  let s = sim.type_in(form(false), "name", "A");
  s = sim.event(sim.event(s, android.Char(86)), android.Char(65));
  let typed = s.shell.app.name;
  s = sim.event(sim.event(s, android.Key(67, 0)), android.Key(67, 1));
  let deleted = s.shell.app.name + " " + sim.keyboard(s).unwrap_or("none");
  s = sim.event(sim.event(s, android.Key(66, 0)), android.Key(66, 1));
  return test.assert_eq(typed + " " + deleted + " " + s.shell.app.sent + " [" + s.shell.host.focus + "]", "AVA AV AV AV []");
}

function test_field_is_spoken(): test.TestOutcome {
  let empty = sim.spoken(form(false)).join("|");
  let filled = sim.spoken(sim.type_in(form(false), "name", "A")).join("|");
  return test.assert_eq(empty + " / " + filled, "AV|A / AV, A|A");
}

// The x of the caret of the layout: the fill of 2 pixels in the primary
// color, or -1.
function caret_x(nodes: scene.Node[]): i32 {
  for n in nodes {
    match (n.paint) {
      scene.Fill(c, _) => {
        if (n.w == 2 && c == ui.theme(false).primary) {
          return n.x;
        }
      },
      _ => {}
    }
  }
  return -1;
}

function test_a_tap_puts_the_caret(): test.TestOutcome {
  // At 16 sp an "A" is 9.6 pixels wide, and the text starts at 16. A tap
  // at 36 is nearest to the edge after the second "A".
  let s = sim.type_in(form(false), "name", "AAAA");
  let end = s.shell.host.caret;
  s = sim.tap_at(s, 36, 28);
  let tapped = s.shell.host.caret;
  let at = caret_x(s.shell.host.lay.nodes);
  // The keyboard puts a "V" at its cursor: the two characters after the
  // caret stay after it.
  s = sim.event(s, android.Text("AAVAA"));
  let got = end.to_string() + " " + tapped.to_string() + " " + at.to_string() + " " + s.shell.host.caret.to_string() + " " + s.shell.host.focus;
  return test.assert_eq(got, "4 2 37 3 name");
}

function test_hardware_keys_edit_at_the_caret(): test.TestOutcome {
  let s = sim.tap_at(sim.type_in(form(false), "name", "AAAA"), 36, 28);
  s = sim.event(s, android.Char(86));
  let typed = s.shell.app.name + s.shell.host.caret.to_string();
  s = sim.key(sim.key(s, 22), 67);
  let deleted = s.shell.app.name + s.shell.host.caret.to_string();
  s = sim.key(sim.key(sim.key(sim.key(s, 21), 21), 21), 67);
  return test.assert_eq(typed + " " + deleted + " " + s.shell.app.name + s.shell.host.caret.to_string() + " " + sim.keyboard(s).unwrap_or("none"), "AAVAA3 AAVA3 AAVA0 AAVA");
}

// The text is at most as wide as the room of the field of the tests.
function n_fits(t: string): boolean {
  return text.width(fonts(), 0, 16, t) <= 168;
}

function test_a_long_text_shows_the_part_at_the_caret(): test.TestOutcome {
  // The field has 168 pixels for its text, which is less than the text.
  let root: ui.El[Msg] = ui.column([name_field("V".repeat(10) + "A".repeat(20))]);
  let at_end = laid_on(root, screen(), ui.Focus { field: "name", caret: 30 });
  let at_start = laid_on(root, screen(), ui.Focus { field: "name", caret: 0 });
  let got = "";
  for lay in [at_end, at_start] {
    match (lay.nodes[1].paint) {
      scene.Label(t, _, _, _, _) => {
        got = got + t.take(1) + (t.len() >= 12 && n_fits(t)).to_string() + " " + (caret_x(lay.nodes) <= 184).to_string() + " ";
      },
      _ => {}
    }
  }
  return test.assert_eq(got.trim(), "Atrue true Vtrue true");
}

struct Note { text: string, sent: i32 }

function note_view(m: Note, s: ui.Screen): ui.El[Msg] {
  return ui.column([ui.area("note", m.text, "AV", 3).on_edit((t: string): Msg => Note(t)).on_submit(Sent)]);
}

function note_update(own m: Note, msg: Msg): Note {
  match (msg) {
    Note(t) => {
      return Note { ...m, text: t };
    },
    Sent => {
      return Note { ...m, sent: m.sent + 1 };
    },
    _ => {
      return m;
    }
  }
}

function note_program(): ui.Program[Note, Msg] {
  return ui.program(note_view, note_update);
}

function test_an_area_wraps_and_takes_new_lines(): test.TestOutcome {
  let s = sim.start(Note { text: "", sent: 0 }, note_program(), fonts(), 200, 400, 1.0);
  // Three lines of 17 pixels and 16 dp above and below them.
  let box = s.shell.host.lay.nodes[0].h;
  s = sim.type_in(s, "note", "AAAA AAAA AAAA AAAA AAAA AAAA");
  let wrapped = sim.texts(s).join("|");
  s = sim.key(s, 66);
  s = sim.event(s, android.Char(86));
  let got = box.to_string() + " " + wrapped + " " + s.shell.app.sent.to_string() + " " + s.shell.app.text.ends_with("AAAA\nV").to_string() + " " + sim.texts(s).join("|");
  return test.assert_eq(got, "83 AAAA AAAA AAAA|AAAA AAAA AAAA 0 true AAAA AAAA AAAA|AAAA AAAA AAAA|V");
}

function test_an_area_shows_the_lines_at_the_caret(): test.TestOutcome {
  let root: ui.El[Msg] = ui.column([ui.area("note", "A\nAA\nAAA\nAAAA\nAAAAA", "AV", 3)]);
  let out = laid(root);
  let at_end = laid_on(root, screen(), ui.Focus { field: "note", caret: 19 });
  let texts = (lay: ui.Built[Msg]): string => {
    let parts: string[] = [];
    for n in lay.nodes {
      match (n.paint) {
        scene.Label(t, _, _, _, _) => {
          parts = parts.append(t);
        },
        _ => {}
      }
    }
    return parts.join("|");
  };
  return test.assert_eq(texts(out) + " " + texts(at_end), "A|AA|AAA AAA|AAAA|AAAAA");
}

// The meter is one line of text on a rectangle, below the top inset.
function test_the_meter_shows_the_cost_of_a_frame(): test.TestOutcome {
  let sc = ui.Screen { ...screen(), top: 24 };
  let ns = ui.meter(fonts(), sc, ui.Cost { view: 3, layout: 12, paint: 40, access: 7, frame: 62, step: 1234, since: 0 });
  let got = ns.len().to_string() + " " + ns[0].y.to_string() + " " + ns[0].w.to_string();
  match (ns[1].paint) {
    scene.Label(line, px, face, track, color) => {
      got = got + " " + line;
    },
    _ => {}
  }
  return test.assert_eq(got, "2 24 200 view 3  layout 12  paint 40  access 7  frame 62  step 1234 ms");
}

function main(): i32 {
  let r = test.new("std/android/ui");
  r = r.it("a column puts its elements one below the other", test_column);
  r = r.it("a column aligns and justifies its elements", test_column_alignment);
  r = r.it("a row shares its room by the weights", test_row_shares_the_room);
  r = r.it("STRETCH gives each element the whole width", test_stretch);
  r = r.it("a space in a row adds no height to the row", test_a_space_in_a_row_adds_no_height);
  r = r.it("a stack puts its elements one over the other", test_stack);
  r = r.it("a text wraps and clamps", test_text_wraps);
  r = r.it("a role takes its color from the theme", test_roles_take_the_theme);
  r = r.it("a theme follows the state of the program", test_a_theme_follows_the_state);
  r = r.it("the tree stays out of the bars of the system", test_safe_area);
  r = r.it("a button has the size of Material", test_button);
  r = r.it("a column that scrolls clips and moves its rows", test_scroll_column);
  r = r.it("a list builds only the rows that show", test_list_builds_the_rows_that_show);
  r = r.it("a row that is a list scrolls across", test_row_scrolls_across);
  r = r.it("a drag takes the list of its direction", test_a_drag_takes_the_list_of_its_direction);
  r = r.it("a list springs back from its end", test_a_list_springs_back_from_its_end);
  r = r.it("a fling passes its end and springs back", test_a_fling_passes_its_end_and_springs_back);
  r = r.it("a shorter list goes back to its end", test_a_shorter_list_goes_back_to_its_end);
  r = r.it("a touch that stays is a tap", test_tap);
  r = r.it("a drag scrolls and does not tap", test_drag_scrolls_and_does_not_tap);
  r = r.it("a fling goes on and stops at the end", test_fling_goes_on_and_stops_at_the_end);
  r = r.it("a finger that stays presses long", test_long_press);
  r = r.it("the node under the finger shows pressed", test_pressed_node_shows);
  r = r.it("a modal element takes the touches", test_modal_takes_the_touches);
  r = r.it("a program takes taps", test_program_taps);
  r = r.it("a program takes a long press and a switch", test_program_long_press_and_toggle);
  r = r.it("the back key closes the app or tells it", test_back_closes_or_tells);
  r = r.it("a program that waits gets ticks", test_wait_gives_ticks);
  r = r.it("a program scrolls and flings its list", test_program_scrolls_and_flings);
  r = r.it("a program that animates gets frames", test_animating_gives_frames);
  r = r.it("the theme follows the system", test_theme_follows_the_system);
  r = r.it("a text follows the font size of the system", test_text_follows_the_font_scale);
  r = r.it("a field has its text, its line and its caret", test_field_layout);
  r = r.it("a field takes the text of the keyboard", test_field_takes_text);
  r = r.it("the action key submits and the program clears the field", test_field_submits_and_clears);
  r = r.it("the keyboard gets the text that the program keeps", test_program_changes_the_text);
  r = r.it("the focus goes away", test_focus_goes_away);
  r = r.it("the keys of a hardware keyboard type", test_hardware_keys_type);
  r = r.it("an accessibility service reads a field", test_field_is_spoken);
  r = r.it("a tap on the text puts the caret there", test_a_tap_puts_the_caret);
  r = r.it("the keys of a hardware keyboard edit at the caret", test_hardware_keys_edit_at_the_caret);
  r = r.it("a long text shows the part at the caret", test_a_long_text_shows_the_part_at_the_caret);
  r = r.it("an area wraps its text and takes new lines", test_an_area_wraps_and_takes_new_lines);
  r = r.it("an area shows the lines at the caret", test_an_area_shows_the_lines_at_the_caret);
  r = r.it("a slider has a track and a thumb", test_slider_layout);
  r = r.it("a finger moves a slider and scrolls no list", test_a_finger_moves_a_slider);
  r = r.it("the effects run after each message", test_effects_run_after_each_message);
  r = r.it("the meter shows the cost of a frame", test_the_meter_shows_the_cost_of_a_frame);
  r = r.it("events between two ticks do not move the next tick", test_events_do_not_move_a_tick);
  return r.finish();
}
