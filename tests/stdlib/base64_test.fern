import "std/test";
import "std/base64" as base64;
import "std/codec";
import "std/string";

function text(b: u8[]): string {
  return string_from_bytes_unchecked(b);
}

function test_encode_no_pad(): test.TestOutcome {
  return test.assert_eq(base64.encode("Man".bytes()), "TWFu");
}

function test_encode_one_pad(): test.TestOutcome {
  return test.assert_eq(base64.encode("Ma".bytes()), "TWE=");
}

function test_encode_two_pad(): test.TestOutcome {
  return test.assert_eq(base64.encode("M".bytes()), "TQ==");
}

function test_encode_longer(): test.TestOutcome {
  return test.assert_eq(base64.encode("hello".bytes()), "aGVsbG8=");
}

function test_encode_empty(): test.TestOutcome {
  return test.assert_eq(base64.encode("".bytes()), "");
}

function test_decode_no_pad(): test.TestOutcome {
  return test.assert_eq(text(__codec_bytes(base64.decode("TWFu"))), "Man");
}

function test_decode_one_pad(): test.TestOutcome {
  return test.assert_eq(text(__codec_bytes(base64.decode("TWE="))), "Ma");
}

function test_decode_two_pad(): test.TestOutcome {
  return test.assert_eq(text(__codec_bytes(base64.decode("TQ=="))), "M");
}

function test_decode_empty(): test.TestOutcome {
  return test.assert_eq(text(__codec_bytes(base64.decode(""))), "");
}

function test_roundtrip(): test.TestOutcome {
  let s = "The quick brown fox jumps over the lazy dog.";
  return test.assert_eq(text(__codec_bytes(base64.decode(base64.encode(s.bytes())))), s);
}

function test_decode_checked_valid(): test.TestOutcome {
  match (base64.decode("Zm9vYmFy")) {
    Ok(v) => {
      return test.assert_eq(text(v), "foobar");
    },
    Err(_) => {
      return test.assert_true(false);
    }
  }
}

function b64_is_err(s: string): boolean {
  match (base64.decode(s)) {
    Ok(v) => {
      return false;
    },
    Err(_) => {
      return true;
    }
  }
}

function test_decode_checked_rejects(): test.TestOutcome {
  return test.assert_true(
    b64_is_err("!!!invalid!!!")
      && b64_is_err("Zm9v!")
      && b64_is_err("=="),
  );
}

function test_url_alphabet(): test.TestOutcome {
  return test.assert_eq(base64.encode_url([255 as u8, 255 as u8, 255 as u8]), "____");
}

function test_url_no_padding(): test.TestOutcome {
  return test.assert_eq(base64.encode_url("Hi".bytes()), "SGk");
}

function test_url_roundtrip(): test.TestOutcome {
  let payload: string = "Hello, World! ~ tokens+need/url-safety";
  let enc: string = base64.encode_url(payload.bytes());
  return test.assert_true(text(__codec_bytes(base64.decode_url(enc))) == payload
    && text(__codec_bytes(base64.decode_url("SGk="))) == "Hi");
}

function b64url_opt(o: Result[u8[], codec.DecodeError], fb: string): string {
  match (o) {
    Ok(v) => {
      return text(v);
    },
    Err(_) => {
      return fb;
    }
  }
}

function b64url_is_err(s: string): boolean {
  match (base64.decode_url(s)) {
    Ok(v) => {
      return false;
    },
    Err(_) => {
      return true;
    }
  }
}

function test_url_decode_checked_valid(): test.TestOutcome {
  if (b64url_opt(base64.decode_url("SGk"), "X") != "Hi") {
    return test.fail("SGk");
  }
  if (b64url_opt(base64.decode_url(base64.encode_url("Hello".bytes())), "X") != "Hello") {
    return test.fail("roundtrip");
  }
  return test.assert_eq(b64url_opt(base64.decode_url(""), "X"), "");
}

function test_url_decode_checked_rejects(): test.TestOutcome {
  if (!b64url_is_err("SGVsbG8+")) {
    return test.fail("plus");
  }
  if (!b64url_is_err("SGVs/bG8")) {
    return test.fail("slash");
  }
  return test.assert_true(b64url_is_err("SG!k") && b64url_is_err("A"));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/base64");
  r = r.it("encode (no pad)", test_encode_no_pad);
  r = r.it("encode (one pad)", test_encode_one_pad);
  r = r.it("encode (two pad)", test_encode_two_pad);
  r = r.it("encode (longer)", test_encode_longer);
  r = r.it("encode (empty)", test_encode_empty);
  r = r.it("decode (no pad)", test_decode_no_pad);
  r = r.it("decode (one pad)", test_decode_one_pad);
  r = r.it("decode (two pad)", test_decode_two_pad);
  r = r.it("decode (empty)", test_decode_empty);
  r = r.it("roundtrip", test_roundtrip);
  r = r.it("decode_checked valid", test_decode_checked_valid);
  r = r.it("decode_checked rejects", test_decode_checked_rejects);
  r = r.it("url alphabet", test_url_alphabet);
  r = r.it("url no padding", test_url_no_padding);
  r = r.it("url roundtrip", test_url_roundtrip);
  r = r.it("url decode_checked valid", test_url_decode_checked_valid);
  r = r.it("url decode_checked rejects", test_url_decode_checked_rejects);
  return r.finish();
}

function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
