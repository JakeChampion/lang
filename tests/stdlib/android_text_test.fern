// Tests of std/android/text. The test font has 1000 units to the em: "A" is
// 600 units wide and "V" is 850 with its side bearings, so at 10 pixels to
// the em "AAAA" is 24 pixels wide.
import "std/android/fonts";
import "std/android/text";
import "std/array";
import "std/base64";
import "std/test";
import "std/truetype";
import "./color_vectors";
import "./image_vectors";
import "./shape_indic_vectors";
import "./shape_script_vectors";
import "./shape_vectors";

function fonts(): text.Fonts {
  if let Some(f) = truetype.parse(image_vectors.font()) {
    return text.from_faces([f, f, f], [400, 500, 700]);
  }
  return text.from_faces([], []);
}

function test_width_and_line(): test.TestOutcome {
  let f = fonts();
  let none = text.from_faces([], []);
  let got = text.width(f, 0, 10, "AAAA").to_string() + " " + text.line(f, 0, 10).to_string() + " " + text.width(f, 0, 10, "").to_string() + " " + text.width(none, 0, 10, "AAAA").to_string();
  return test.assert_eq(got, "24 10 0 0");
}

function test_face_for_takes_the_nearest_weight(): test.TestOutcome {
  let f = fonts();
  let got = text.face_for(f, 400).to_string() + text.face_for(f, 430).to_string() + text.face_for(f, 460).to_string() + text.face_for(f, 600).to_string() + text.face_for(f, 900).to_string() + text.face_for(f, 100).to_string();
  return test.assert_eq(got, "001120");
}

function test_fit_cuts_with_an_ellipsis(): test.TestOutcome {
  let f = fonts();
  let whole = text.fit(f, 0, 10, "AAAA", 24);
  let cut = text.fit(f, 0, 10, "AAAAAAAA", 30);
  let end = text.fit_end(f, 0, 10, "VAAAAAAA", 30);
  let got = whole + " " + cut.ends_with("…").to_string() + " " + (text.width(f, 0, 10, cut) <= 30).to_string() + " " + end.starts_with("…").to_string() + " " + end.ends_with("A").to_string();
  return test.assert_eq(got, "AAAA true true true true");
}

function test_wrap_breaks_at_spaces(): test.TestOutcome {
  let f = fonts();
  let space = text.width(f, 0, 10, "A A") - 12;
  // Two words of 24 pixels and a space fit in 48 pixels plus the space.
  let lines = text.wrap(f, 0, 10, "AAAA AAAA AAAA", 48 + space);
  let fed = text.wrap(f, 0, 10, "A\nAA", 1000);
  let long = text.wrap(f, 0, 10, "AAAAAAAAAA", 30);
  return test.assert_eq(lines.join("|") + " " + fed.join("|") + " " + long.join("|"), "AAAA AAAA|AAAA A|AA AAAAA|AAAAA");
}

function ranges(rs: (i32, i32)[]): string {
  let out: string[] = [];
  for r in rs {
    let (a, b) = r;
    out = out.append(a.to_string() + "-" + b.to_string());
  }
  return out.join(" ");
}

function test_wrap_ranges_keeps_the_place_of_each_character(): test.TestOutcome {
  let f = fonts();
  let space = text.width(f, 0, 10, "A A") - 12;
  // The space and the line feed at a break are in no line.
  let words = text.wrap_ranges(f, 0, 10, "AAAA AAAA AAAA", 48 + space);
  let fed = text.wrap_ranges(f, 0, 10, "A\n\nAA", 1000);
  let long = text.wrap_ranges(f, 0, 10, "AAAAAAAAAA", 30);
  let empty = text.wrap_ranges(f, 0, 10, "", 30);
  return test.assert_eq(ranges(words) + " | " + ranges(fed) + " | " + ranges(long) + " | " + ranges(empty), "0-9 10-14 | 0-1 2-2 3-5 | 0-5 5-10 | 0-0");
}

// The test font with U+05D0, the Hebrew letter alef, in place of U+00C1:
// the start, the end and the delta of the fourth segment of its cmap.
function alef_font(): u8[] {
  return image_vectors.font().with(468, 5u8).with(469, 208u8).with(480, 5u8).with(481, 208u8).with(490, 250u8).with(491, 52u8);
}

// The id of the font of a glyph of a layout, from its key.
function font_id(p: text.Placed): i64 {
  return (p.key >> 32) / 4i64 / 4096i64;
}

function test_fallback_takes_a_font_that_has_the_character(): test.TestOutcome {
  let f = fonts();
  let given: truetype.Font[] = [];
  if let Some(alef) = truetype.parse(alef_font()) {
    given = [alef];
  }
  let fs = f.with_fallback(text.fallback(given));
  let none = (weight: i32, cp: i32): fonts.Found[] => [];
  // Before `covering`, alef takes the face. After it, alef takes the glyph
  // of "Á" from the fallback font. Bet is in no font, so it stays in the
  // face. The fallback looks for each one only once.
  let before = text.width(fs, 0, 10, "א") == text.width(f, 0, 10, "א");
  fs = fs.covering(0, "אב", none);
  let looked = fs.looked();
  let same = text.width(fs, 0, 10, "א") == text.width(f, 0, 10, "Á") && text.width(fs, 0, 10, "ב") == text.width(f, 0, 10, "ב");
  fs = fs.covering(0, "אבAא", none);
  let (_, placed) = text.layout(text.new_cache(), fs, 0, 10, 0, "Aא");
  let ids = placed.map((p: text.Placed): string => font_id(p).to_string()).join(" ");
  return test.assert_eq(before.to_string() + " " + same.to_string() + " " + looked.to_string() + " " + fs.looked().to_string() + " " + ids, "true true 2 2 0 64");
}

function test_letters_and_span(): test.TestOutcome {
  let cs = text.letters("aé…z");
  return test.assert_eq(cs.len().to_string() + " " + text.span(cs, 1, 3) + " " + text.span(cs, 3, 1) + "|" + text.span(cs, 0, 4), "4 é… |aé…z");
}

// The glyph of each placed glyph of `s`, from the left.
function laid_glyphs(fs: text.Fonts, s: string): string {
  let (_, placed) = text.layout(text.new_cache(), fs, 0, 20, 0, s);
  return placed.map((p: text.Placed): string => (p.key & 4294967295i64).to_string()).join(",");
}

// A run of Arabic letters takes the joining forms of the font. Its glyphs
// come from the left, the reverse of the logical order. In visual order,
// "باب" is the same text. A Latin letter next to the run does not join.
function test_arabic_is_shaped(): test.TestOutcome {
  let Ok(b) = base64.decode(shape_vectors.font()) else {
    return test.fail("the font did not decode");
  };
  let Some(naskh) = truetype.parse(b) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([naskh], [400]);
  return test.assert_eq(laid_glyphs(fs, "باب") + " " + laid_glyphs(fs, "ب ب"), "87,7,4,87,11 87,7,1,87,7");
}

// A run of Devanagari letters goes through the Indic shaper: the matra i
// comes before its consonant, and the Ra and the virama become a reph
// after it. The glyphs come from the left in the order of the text.
function test_devanagari_is_shaped(): test.TestOutcome {
  let Some(deva) = font_of(shape_vectors.deva_font()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([deva], [400]);
  return test.assert_eq(laid_glyphs(fs, "कि") + " " + laid_glyphs(fs, "र्कि"), "478,54 523,54,666");
}

// A run of Tamil letters goes through the Indic shaper too: the two parts
// of the split matra o go on the two sides of the consonant.
function test_tamil_is_shaped(): test.TestOutcome {
  let Some(tamil) = font_of(shape_indic_vectors.taml_font()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([tamil], [400]);
  return test.assert_eq(laid_glyphs(fs, "கொ") + " " + laid_glyphs(fs, "கோ"), "26,6,21 27,6,21");
}

// A run of Hebrew letters goes from right to left, so its glyphs come from
// the left in the reverse of the logical order. The text is in visual
// order. The shaper puts the sheva after the meteg.
function test_hebrew_is_shaped(): test.TestOutcome {
  let Some(hebrew) = font_of(shape_script_vectors.hebr_font()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([hebrew], [400]);
  return test.assert_eq(laid_glyphs(fs, "ְָֽב"), "38,43,31,3");
}

// A run of Thai letters splits the sara am: the nikhahit goes before the
// tone mark, and the sara aa after it.
function test_thai_is_shaped(): test.TestOutcome {
  let Some(thai) = font_of(shape_script_vectors.thai_font()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([thai], [400]);
  return test.assert_eq(laid_glyphs(fs, "น้ำ"), "35,32,24,44");
}

// A run of Khmer letters splits the vowel oe: its first part goes before
// the consonant.
function test_khmer_is_shaped(): test.TestOutcome {
  let Some(khmer) = font_of(shape_script_vectors.khmr_font()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([khmer], [400]);
  return test.assert_eq(laid_glyphs(fs, "កើ"), "43,2,31");
}

// A run of Myanmar letters puts the pre-base vowel e before the consonant.
function test_myanmar_is_shaped(): test.TestOutcome {
  let Some(myanmar) = font_of(shape_script_vectors.mymr_font()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([myanmar], [400]);
  return test.assert_eq(laid_glyphs(fs, "ကေ"), "129,2");
}

// A run of Sinhala letters goes through the Universal Shaping Engine: the
// vowel sign kombuva goes before the consonant.
function test_sinhala_is_shaped(): test.TestOutcome {
  let Some(sinhala) = font_of(shape_script_vectors.sinh_font()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([sinhala], [400]);
  return test.assert_eq(laid_glyphs(fs, "කෙ"), "65,4");
}

// A run of N'Ko letters goes from right to left, and its letters join.
function test_nko_is_shaped(): test.TestOutcome {
  let Some(nko) = font_of(shape_script_vectors.nko_font()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([nko], [400]);
  return test.assert_eq(laid_glyphs(fs, "ߊߓ"), "36,62");
}

// A run of Korean jamo composes into the syllable that the font has: the
// jamo of HAN give the glyph of U+D55C.
function test_korean_jamo_compose(): test.TestOutcome {
  let Some(korean) = font_of(shape_script_vectors.hang_font()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([korean], [400]);
  return test.assert_eq(laid_glyphs(fs, "한") + " " + laid_glyphs(fs, "한"), "70 70");
}

// The font of a base64 string, or None.
function font_of(data: string): Option[truetype.Font] {
  if let Ok(b) = base64.decode(data) {
    return truetype.parse(b);
  }
  return None;
}

// The fatha attaches to the beh with the GPOS anchors of the font: its ink
// is above the ink of the beh under it, and its middle is near the middle
// of the beh.
function test_a_mark_sits_on_its_base(): test.TestOutcome {
  let Some(naskh) = font_of(shape_vectors.font()) else {
    return test.fail("the font did not parse");
  };
  return mark_on_beh(text.from_faces([naskh], [400]));
}

// The face has the fatha and not the beh, so the beh comes from a fallback
// font. The fatha takes the font of the beh, and attaches to it.
function test_a_mark_takes_the_font_of_its_base(): test.TestOutcome {
  let (Some(marks), Some(naskh)) = (font_of(shape_vectors.marks_font()), font_of(shape_vectors.font())) else {
    return test.fail("a font did not parse");
  };
  return mark_on_beh(text.from_faces([marks], [400]).with_fallback(text.fallback([naskh])).covering(0, "بَ", (w: i32, cp: i32): fonts.Found[] => []));
}

// The lowest row of the ink of `mark`, and the highest row of the ink of
// `base` in the columns of the ink of `mark`, in rows below the baseline.
// A pixel is ink when its coverage is above half.
function ink_rows(mark: text.Placed, base: text.Placed): (i32, i32) {
  let (bottom, x0, x1) = (-(1 << 20), 1 << 20, -(1 << 20));
  for row in 0..mark.bm.height {
    for col in 0..mark.bm.width {
      if (mark.bm.coverage[row * mark.bm.width + col] as i32 > 128) {
        bottom = bottom.max(mark.y + row);
        x0 = x0.min(mark.x + col);
        x1 = x1.max(mark.x + col);
      }
    }
  }
  let top = 1 << 20;
  for row in 0..base.bm.height {
    for col in 0..base.bm.width {
      let x = base.x + col;
      if (x >= x0 && x <= x1 && base.bm.coverage[row * base.bm.width + col] as i32 > 128) {
        top = top.min(base.y + row);
      }
    }
  }
  return (bottom, top);
}

function mark_on_beh(fs: text.Fonts): test.TestOutcome {
  let (_, placed) = text.layout(text.new_cache(), fs, 0, 100, 0, "َب");
  let glyphs = placed.map((p: text.Placed): i64 => p.key & 4294967295i64);
  if (glyphs.len() != 3 || glyphs[0] != 97i64 || glyphs[2] != 7i64) {
    return test.fail("the glyphs are " + glyphs.map((g: i64): string => g.to_string()).join(","));
  }
  let (mark, base) = (placed[0], placed[2]);
  let middle = mark.x + mark.bm.width / 2 - (base.x + base.bm.width / 2);
  let (bottom, top) = ink_rows(mark, base);
  let above = bottom < top;
  return test.assert_eq(above.to_string() + " " + (middle.abs() < base.bm.width / 4).to_string(), "true true");
}

// "B" of the color font is a red square, from COLR. Its glyph has its
// colors and no coverage. The sprite of a text keeps the colors apart from
// the coverage, and `put` draws them on a frame.
function test_a_color_glyph(): test.TestOutcome {
  let Some(f) = font_of(color_vectors.v1()) else {
    return test.fail("the font did not parse");
  };
  let fs = text.from_faces([f], [400]);
  let (c, placed) = text.layout(text.new_cache(), fs, 0, 20, 0, "B");
  let (_, sp) = text.sprite(c, fs, 0, 20, 0, "B");
  if (placed.len() != 1 || sp.rgba.len() != 4 * sp.w * sp.h) {
    return test.fail("the color glyph has no colors");
  }
  let pl = placed[0];
  let k = 4 * (pl.bm.height / 2 * pl.bm.width + pl.bm.width / 2);
  let s = 4 * (sp.h / 2 * sp.w + sp.w / 2);
  let got = pl.rgba[k].to_string() + "," + pl.rgba[k + 1].to_string() + "," + pl.rgba[k + 3].to_string() + " " + pl.bm.coverage.len().to_string() + " " + sp.rgba[s].to_string() + "," + sp.rgba[s + 3].to_string() + " " + sp.cov[s / 4].to_string();
  return test.assert_eq(got, "255,0,255 0 255,255 0");
}

function main(): i32 {
  let r = test.new("std/android/text");
  r = r.it("width and line measure a text", test_width_and_line);
  r = r.it("face_for takes the nearest weight", test_face_for_takes_the_nearest_weight);
  r = r.it("fit cuts with an ellipsis", test_fit_cuts_with_an_ellipsis);
  r = r.it("wrap breaks at spaces and line feeds", test_wrap_breaks_at_spaces);
  r = r.it("wrap_ranges keeps the place of each character", test_wrap_ranges_keeps_the_place_of_each_character);
  r = r.it("letters and span take characters", test_letters_and_span);
  r = r.it("a fallback font draws a character that the face does not have", test_fallback_takes_a_font_that_has_the_character);
  r = r.it("a run of Arabic letters is shaped", test_arabic_is_shaped);
  r = r.it("a run of Devanagari letters is shaped", test_devanagari_is_shaped);
  r = r.it("a run of Tamil letters is shaped", test_tamil_is_shaped);
  r = r.it("a run of Hebrew letters is shaped", test_hebrew_is_shaped);
  r = r.it("a run of Thai letters is shaped", test_thai_is_shaped);
  r = r.it("a run of Khmer letters is shaped", test_khmer_is_shaped);
  r = r.it("a run of Myanmar letters is shaped", test_myanmar_is_shaped);
  r = r.it("a run of Sinhala letters is shaped", test_sinhala_is_shaped);
  r = r.it("a run of N'Ko letters is shaped", test_nko_is_shaped);
  r = r.it("Korean jamo compose into a syllable", test_korean_jamo_compose);
  r = r.it("a mark sits on its base", test_a_mark_sits_on_its_base);
  r = r.it("a mark takes the font of its base", test_a_mark_takes_the_font_of_its_base);
  r = r.it("a color glyph keeps its colors", test_a_color_glyph);
  return r.finish();
}
