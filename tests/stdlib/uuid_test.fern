import "std/test";
import "std/uuid" as uuid;

function test_v4_len(): test.TestOutcome {
  return test.assert_eq(uuid.uuid_v4().len(), 36);
}

function test_v4_is_valid(): test.TestOutcome {
  return test.assert_true(uuid.is_valid(uuid.uuid_v4()));
}

function test_v4_hyphens(): test.TestOutcome {
  let u: string = uuid.uuid_v4();
  return test.assert_true(u[8] == 45 && u[13] == 45 && u[18] == 45 && u[23] == 45);
}

function test_v4_version(): test.TestOutcome {
  return test.assert_eq(uuid.uuid_v4()[14] as i32, 52);
}

function test_v4_variant(): test.TestOutcome {
  let c: i32 = uuid.uuid_v4()[19] as i32;
  return test.assert_true(c == 56 || c == 57 || c == 97 || c == 98);
}

function test_v4_distinct(): test.TestOutcome {
  return test.assert_true(uuid.uuid_v4() != uuid.uuid_v4());
}

function test_v7_len(): test.TestOutcome {
  return test.assert_eq(uuid.uuid_v7().len(), 36);
}

function test_v7_is_valid(): test.TestOutcome {
  return test.assert_true(uuid.is_valid(uuid.uuid_v7()));
}

function test_v7_version(): test.TestOutcome {
  return test.assert_eq(uuid.uuid_v7()[14] as i32, 55);
}

function test_nil(): test.TestOutcome {
  if (uuid.uuid_nil() != "00000000-0000-0000-0000-000000000000") {
    return test.fail("nil value");
  }
  if (!uuid.uuid_is_nil(uuid.uuid_nil())) {
    return test.fail("is_nil on nil");
  }
  return test.assert_false(uuid.uuid_is_nil(uuid.uuid_v4()));
}

function test_version_extract(): test.TestOutcome {
  if (!has_version(uuid.uuid_v4(), 4)) {
    return test.fail("v4");
  }
  if (!has_version(uuid.uuid_v7(), 7)) {
    return test.fail("v7");
  }
  return test.assert_is_some_eq_i32(uuid.uuid_version(uuid.uuid_nil()), 0);
}

function test_version_malformed(): test.TestOutcome {
  if let Some(_) = uuid.uuid_version("not-a-uuid") {
    return test.fail("short");
  }
  if let Some(_) = uuid.uuid_version("f47ac10b58cc4372a5670e02b2c3d479") {
    return test.fail("no hyphens");
  }
  return test.assert_is_none_i32(uuid.uuid_version(""));
}

function has_version(s: string, want: i32): boolean {
  if let Some(v) = uuid.uuid_version(s) {
    return v == want;
  }
  return false;
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/uuid");
  r = r.it("v4 length 36", test_v4_len);
  r = r.it("v4 is_valid shape", test_v4_is_valid);
  r = r.it("v4 hyphen positions", test_v4_hyphens);
  r = r.it("v4 version nibble", test_v4_version);
  r = r.it("v4 variant nibble", test_v4_variant);
  r = r.it("v4 distinct draws", test_v4_distinct);
  r = r.it("v7 length 36", test_v7_len);
  r = r.it("v7 is_valid shape", test_v7_is_valid);
  r = r.it("v7 version nibble", test_v7_version);
  r = r.it("nil + is_nil", test_nil);
  r = r.it("version extract", test_version_extract);
  r = r.it("version malformed", test_version_malformed);
  return r.finish();
}
