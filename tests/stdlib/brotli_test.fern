import "std/test";
import "std/brotli";
import "std/hex";
import "std/codec";
import "std/hash";
import "std/utf8";
import "core/int";

// tests/stdlib/brotli_test.fern — std/brotli against streams the reference
// brotli (1.2, through its Python binding) wrote: qualities 0 to 11 and
// windows from 2^10 to 2^18, so prefix codes simple and complex, several
// block types, literal context modes and maps, distance postfixes, stored
// meta-blocks, and dictionary words under the transforms that keep a word,
// trim its end and upper-case it; a stream built by hand for the transforms
// that trim a word's start, which the encoder does not choose, checked
// against the reference decoder; a metadata block; and the refusals.

function lines(n: i32): u8[] {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    for b in ("line " + int.int_to_string(i) + " of the corpus\n").bytes() {
      out = out.append(b);
    }
    i = i + 1;
  }
  return out;
}

// `read(hex)` — the stream decoded, as its length and CRC-32.
function read(stream: string): string {
  match (brotli.decompress(__codec_bytes(hex.decode(stream)), 1048576)) {
    Ok(out) => {
      return out.len().to_string() + " " + hash.crc32_new().update(out).finish().to_string();
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function sum(bs: u8[]): string {
  return bs.len().to_string() + " " + hash.crc32_new().update(bs).finish().to_string();
}

function english(): string {
  return "";
}

function test_text(): test.TestOutcome {
  match (brotli.decompress(__codec_bytes(hex.decode("8b0c8068656c6c6f2c2068656c6c6f2c2068656c6c6f20776f726c640a03")), 1024)) {
    Ok(out) => {
      return test.assert_eq(utf8.from_bytes_lossy(out), "hello, hello, hello world\n");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// Dictionary words, as they are, trimmed at the end and upper-cased, at
// qualities 11 and 5.
function test_dictionary(): test.TestOutcome {
  return test.assert_eq(read(english()) + " | " + read(""), "1185 2771660985 | 1185 2771660985");
}

// Numbered lines at qualities 0, 1 and 9.
function test_qualities(): test.TestOutcome {
  return test.assert_eq(read("") + " | " + read("") + " | " + sum(lines(300)) + " | " + read("") + " | " + sum(lines(1000)), "6790 3345721595 | 6790 3345721595 | 6790 3345721595 | 22890 4099893582 | 22890 4099893582");
}

// UTF-8 markup at quality 11; text, noise and markup through a window of
// 2^10; noise stored.
function test_contexts_and_windows(): test.TestOutcome {
  return test.assert_eq(read("") + " | " + read("") + " | " + read(""), "10800 1532940697 | 16975 4050451784 | 300 1678020323");
}

// One meta-block per transform that trims a word's start, each a single
// dictionary reference.
function test_trimmed_starts(): test.TestOutcome {
  match (brotli.decompress(__codec_bytes(hex.decode("500000004458141225094000000044581412e80ac600000010615148ac311004000080088b4282b5812000000088b02824581d1c08000080080b6042dd036200000088b00026d6435c04000080080b60629d8401")), 1024)) {
    Ok(out) => {
      return test.assert_eq(utf8.from_bytes_lossy(out), "espectsplayuestrveteally tionns");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// An empty stream, and a metadata block skipped.
function test_empty_and_metadata(): test.TestOutcome {
  return test.assert_eq(read("3b") + " | " + read("2c0161626303"), "0 0 | 0 0");
}

// A stream cut short, a window size RFC 7932 does not have, and output
// past the limit.
function test_refusals(): test.TestOutcome {
  let cut: string = read(english().slice_snap(0, 120));
  let window: string = read("11");
  let limit: string = "";
  match (brotli.decompress(__codec_bytes(hex.decode(english())), 100)) {
    Ok(_) => {
      limit = "decoded";
    },
    Err(e) => {
      limit = e.message();
    }
  }
  return test.assert_eq(cut + " | " + window + " | " + limit, "brotli: truncated | brotli: malformed: window size | brotli: output past the limit");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/brotli");
  r = r.it("a small stream", test_text);
  r = r.it("dictionary words and their transforms", test_dictionary);
  r = r.it("qualities 0 to 9", test_qualities);
  r = r.it("contexts and windows", test_contexts_and_windows);
  r = r.it("transforms that trim a word's start", test_trimmed_starts);
  r = r.it("an empty stream and a metadata block", test_empty_and_metadata);
  r = r.it("refusals", test_refusals);
  return r.finish();
}

// Decode a valid fixture. Report a malformed fixture before the test exits.
function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
