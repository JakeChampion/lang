import "std/test";
import "std/i32";

function test_zero(): test.TestOutcome {
  return test.assert_true(0.bit_length() == 0);
}

function test_one(): test.TestOutcome {
  return test.assert_true(1.bit_length() == 1);
}

function test_five(): test.TestOutcome {
  return test.assert_true(5.bit_length() == 3);
}

function test_powers(): test.TestOutcome {
  if (255.bit_length() != 8) {
    return test.fail("255");
  }
  return test.assert_true(256.bit_length() == 9);
}

function test_negative(): test.TestOutcome {
  return test.assert_true((0 - 5).bit_length() == 3);
}

function test_max(): test.TestOutcome {
  return test.assert_true(2147483647.bit_length() == 31);
}

function test_min(): test.TestOutcome {
  let min: i32 = 0 - 2147483647 - 1;
  return test.assert_true(min.bit_length() == 32);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/i32 bit_length");
  r = r.it("zero", test_zero);
  r = r.it("one", test_one);
  r = r.it("five", test_five);
  r = r.it("powers of two", test_powers);
  r = r.it("negative", test_negative);
  r = r.it("i32 max", test_max);
  r = r.it("i32 min", test_min);
  return r.finish();
}
