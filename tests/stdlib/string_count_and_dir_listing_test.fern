import "std/test";

function test_string_count_pass(): test.TestOutcome {
  return test.assert_string_count(
    "[ERROR] one\n[ERROR] two\n[INFO] three\n",
    "[ERROR]", 2,
  );
}

function test_string_count_zero(): test.TestOutcome {
  return test.assert_string_count("hello world", "xyz", 0);
}

function test_string_count_single_char(): test.TestOutcome {
  return test.assert_string_count("a-b-c-d", "-", 3);
}

function test_string_count_overlap_non_overlap(): test.TestOutcome {
  return test.assert_string_count("aaa", "aa", 1);
}

function test_string_count_wrong_reports(): test.TestOutcome {
  match (test.assert_string_count("hello world hello", "hello", 5)) {
    Pass => {
      return test.fail("wrong count should fail");
    },
    Fail(msg) => {
      if (!msg.contains("appears 2 times")
        || !msg.contains("expected 5")) {
        return test.fail("expected both counts in msg: " + msg);
      }
      return test.pass();
    }
  }
}

function test_string_count_empty_haystack(): test.TestOutcome {
  return test.assert_string_count("", "x", 0);
}

function test_dir_listing_pass(r: test.TestRunner): test.TestRunner {
  let (dir, rr) = test.must_temp_dir(r, "listing-pass");
  if (dir == "") {
    return rr;
  }
  match (write_file(dir + "/zebra.txt", "z")) {
    Err(_) => {
      return rr.it("write fixture", () => test.fail("io"));
    },
    Ok(_) => {}
  }
  match (write_file(dir + "/alpha.txt", "a")) {
    Err(_) => {
      return rr.it("write fixture", () => test.fail("io"));
    },
    Ok(_) => {}
  }
  match (write_file(dir + "/mid.txt", "m")) {
    Err(_) => {
      return rr.it("write fixture", () => test.fail("io"));
    },
    Ok(_) => {}
  }
  return rr.it(
    "listing matches multiset (sorted)",
    () => test.assert_eq_dir_listing(
      dir,
      ["mid.txt", "zebra.txt", "alpha.txt"],
    ),
  );
}

function test_dir_listing_empty_dir(r: test.TestRunner): test.TestRunner {
  let (dir, rr) = test.must_temp_dir(r, "listing-empty");
  if (dir == "") {
    return rr;
  }
  let empty: string[] = [];
  return rr.it(
    "empty dir matches empty list",
    () => test.assert_eq_dir_listing(dir, empty),
  );
}

function test_dir_listing_extra_file_fails(r: test.TestRunner): test.TestRunner {
  let (dir, rr) = test.must_temp_dir(r, "listing-extra");
  if (dir == "") {
    return rr;
  }
  match (write_file(dir + "/a.txt", "")) {
    Err(_) => {
      return rr.it("write fixture", () => test.fail("io"));
    },
    Ok(_) => {}
  }
  match (write_file(dir + "/b.txt", "")) {
    Err(_) => {
      return rr.it("write fixture", () => test.fail("io"));
    },
    Ok(_) => {}
  }
  match (test.assert_eq_dir_listing(dir, ["a.txt"])) {
    Pass => {
      return rr.it("missing-from-expected", () => test.fail("missed"));
    },
    Fail(msg) => {
      if (!msg.contains("length differs")) {
        return rr.it("listing diff length msg", () => test.fail("got: " + msg));
      }
      return rr.it("extra file flagged via length diff", test.pass);
    }
  }
}

function test_dir_listing_missing_dir(): test.TestOutcome {
  match (test.assert_eq_dir_listing(
    "/tmp/lang-no-such-dir-batch35-zztop",
    ["x"],
  )) {
    Pass => {
      return test.fail("missing dir should fail");
    },
    Fail(msg) => {
      if (!msg.contains("failed to read")) {
        return test.fail("expected 'failed to read': " + msg);
      }
      return test.pass();
    }
  }
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("string count + dir listing");
  r = r.it("string_count multiple matches", test_string_count_pass);
  r = r.it("string_count zero matches", test_string_count_zero);
  r = r.it("string_count single char", test_string_count_single_char);
  r = r.it("string_count non-overlapping", test_string_count_overlap_non_overlap);
  r = r.it("string_count wrong reports both", test_string_count_wrong_reports);
  r = r.it("string_count empty haystack", test_string_count_empty_haystack);
  r = test_dir_listing_pass(r);
  r = test_dir_listing_empty_dir(r);
  r = test_dir_listing_extra_file_fails(r);
  r = r.it("dir_listing missing dir", test_dir_listing_missing_dir);
  return r.finish();
}
