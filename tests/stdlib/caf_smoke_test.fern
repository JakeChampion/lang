import "std/test";
import "aac_kernel_check" as ref;
import "alac_smoke_vectors";
import "caf_smoke_vectors";
import "caf_check";

function reference(): test.TestOutcome {
  let vector = caf_smoke_vectors.vector();
  let Ok(encoded) = ref.unpack(vector.encoded) else {
    return test.fail("CAF fixture");
  };
  let source = alac_smoke_vectors.vector();
  let Ok(expected) = ref.unpack(source.pcm) else {
    return test.fail("independent PCM fixture");
  };
  let reference = caf_check.Reference { rate: source.rate, channels: source.channels, depth: source.depth, trim: vector.trim, frames: vector.frames, mask: vector.mask, order: vector.order };
  if let Err(e) = caf_check.run(encoded, expected, reference) {
    return test.fail(e);
  }
  return test.pass();
}

function main(): i32 {
  let runner = test.new("CAF ALAC interpreter smoke");
  runner = runner.it("exact trimmed samples through cold and repeated seeks", reference);
  return runner.finish();
}
