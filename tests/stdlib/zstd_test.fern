import "std/test";
import "std/zstd";
import "std/hex";
import "std/hash";
import "std/utf8";
import "core/int";

// tests/stdlib/zstd_test.fern — std/zstd against frames the reference
// zstd (1.5, through python-zstandard 0.25) wrote: raw and Huffman
// literals in one stream and four, Huffman weights written directly and
// FSE-compressed, treeless literals, sequences under predefined,
// run-length, described and repeated tables, raw and run-length blocks, a
// window descriptor without a content size, a checksum, and two frames
// around a skippable one; the refusals; and the encoder's frames read
// back, their sizes pinned at what the reference decoder and Go's
// (TestZstdEncodeAgainstGo) were checked to read.

function lines(n: i32): u8[] {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    for b in ("line " + int.int_to_string(i) + " of the corpus\n").bytes() {
      out = out.append(b);
    }
    i = i + 1;
  }
  return out;
}

function lcg_bytes(n: i32): u8[] {
  let out: u8[] = [];
  let x: i32 = 7;
  let i: i32 = 0;
  while (i < n) {
    x = x * 1103515245 + 12345 & 2147483647;
    out = out.append((x >> 16 & 255) as u8);
    i = i + 1;
  }
  return out;
}

// `read(hex)` — the frame decoded, as its length and CRC-32.
function read(frame: string): string {
  match (zstd.decompress(hex.hex_decode(frame), 1048576)) {
    Ok(out) => {
      return out.len().to_string() + " " + hash.crc32_new().update(out).finish().to_string();
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function sum(bs: u8[]): string {
  return bs.len().to_string() + " " + hash.crc32_new().update(bs).finish().to_string();
}

function small(): string {
  return "28b52ffd201aa500007068656c6c6f2c2020776f726c640a0100e28a11";
}

function two(): string {
  return "";
}

function run(): string {
  return "28b52ffda4400d03005400001061610100fbff39c002036a08618356bc98";
}

function test_small(): test.TestOutcome {
  match (zstd.decompress(hex.hex_decode(small()), 1024)) {
    Ok(out) => {
      return test.assert_eq(utf8.from_bytes_lossy(out), "hello, hello, hello world\n");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// Huffman literals in four streams, their weights FSE-compressed, and
// sequences under tables the frame describes.
function test_described(): test.TestOutcome {
  return test.assert_eq(read("") + " | " + sum(lines(800)) + " | " + read(""), "18290 3307172447 | 18290 3307172447 | 2500 2016542315");
}

// Huffman weights four bits each, one stream.
function test_direct_weights(): test.TestOutcome {
  return test.assert_eq(read(""), "1000 4006620481");
}

// Fourteen blocks of 142890 bytes: treeless literals in one and four
// streams, run-length literals, repeated and run-length sequence tables.
function test_reused_tables(): test.TestOutcome {
  return test.assert_eq(read(two()) + " | " + sum(lines(6000)), "142890 1536080029 | 142890 1536080029");
}

// A run-length block after a raw one, a four-byte content size and a
// checksum; a raw block; a window descriptor and no content size.
function test_block_kinds(): test.TestOutcome {
  return test.assert_eq(read(run()) + " | " + read("") + " | " + sum(lcg_bytes(300)) + " | " + read("") + " | " + sum(lines(300)), "200000 3764999067 | 300 1678020323 | 300 1678020323 | 6790 3345721595 | 6790 3345721595");
}

function test_frames(): test.TestOutcome {
  match (zstd.decompress(hex.hex_decode("28b52ffd200c6100006669727374206672616d653b532a4d1805000000787878787828b52ffd200c6100007365636f6e64206672616d65"), 1024)) {
    Ok(out) => {
      return test.assert_eq(utf8.from_bytes_lossy(out), "first frame;second frame");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// A frame cut short, a checksum or magic number altered, output past the
// limit, a reserved block type, and a dictionary.
function test_refusals(): test.TestOutcome {
  let r: u8[] = hex.hex_decode(run());
  let cut: string = read(two().slice_snap(0, 1000));
  let sum_bad: string = read(hex.hex_encode(r.with(r.len() - 1, r[r.len() - 1] ^ 1 as u8)));
  let magic: string = read("29b52ffd" + run().slice_snap(8, run().len()));
  let limit: string = "";
  match (zstd.decompress(r, 100000)) {
    Ok(_) => {
      limit = "decoded";
    },
    Err(e) => {
      limit = e.message();
    }
  }
  let reserved: string = read("28b52ffd2000070000");
  let dict: string = read("28b52ffd21070100");
  return test.assert_eq(cut + " | " + sum_bad + " | " + magic + " | " + limit + " | " + reserved + " | " + dict, "zstd: truncated | zstd: checksum mismatch | zstd: malformed: magic number | zstd: output past the limit | zstd: malformed: reserved block type | zstd: unsupported: dictionary");
}

// `compress` read back: what it writes, by length and CRC-32 of the frame.
function packed(input: u8[]): string {
  let frame: u8[] = zstd.compress(input);
  match (zstd.decompress(frame, input.len() + 1)) {
    Ok(out) => {
      if (out.len() != input.len() || hex.hex_encode(out) != hex.hex_encode(input)) {
        return "differs";
      }
      return sum(frame);
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_encoder(): test.TestOutcome {
  let none: u8[] = [];
  return test.assert_eq(packed(none) + " | " + packed("a".bytes()) + " | " + packed("hello, hello, hello world\n".bytes()) + " | " + packed(lines(600)) + " | " + packed(lcg_bytes(1000)), "13 2953723833 | 14 836852317 | 34 1623480377 | 544 997500325 | 1014 195867209");
}

// Non-ASCII literals (FSE-compressed weights); a run of one byte, as
// run-length blocks; and two blocks, the second's lines matched in the
// first.
function test_encoder_blocks(): test.TestOutcome {
  let skew: u8[] = [];
  match (zstd.decompress(hex.hex_decode(""), 4096)) {
    Ok(out) => {
      skew = out;
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  let a: u8[] = [];
  while (a.len() < 140000) {
    a = a.append(97 as u8);
  }
  let mixed: u8[] = lines(300);
  while (mixed.len() < 131072 + 6790) {
    mixed = mixed.append(97 as u8);
  }
  for b in lines(300) {
    mixed = mixed.append(b);
  }
  return test.assert_eq(packed(skew) + " | " + packed(a) + " | " + packed(mixed), "1415 2784539219 | 21 1572034591 | 372 693956121");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/zstd");
  r = r.it("a small frame", test_small);
  r = r.it("described tables and FSE-compressed weights", test_described);
  r = r.it("direct Huffman weights", test_direct_weights);
  r = r.it("tables reused across blocks", test_reused_tables);
  r = r.it("raw and run-length blocks, no content size", test_block_kinds);
  r = r.it("two frames around a skippable one", test_frames);
  r = r.it("refusals", test_refusals);
  r = r.it("the encoder's frames read back", test_encoder);
  r = r.it("the encoder across blocks", test_encoder_blocks);
  return r.finish();
}
