import "std/i32";
import "std/result";
import "std/test";
import "std/http/qpack";
import "std/hex";
import "std/codec";
import "std/option";
import "core/int";
import "std/i64";

struct Got { decoder: qpack.Decoder, fields: qpack.Field[], blocked: boolean }

function decode_on(d: qpack.Decoder, stream: i64, section: u8[]): Result[Got, qpack.QpackError] {
  let next: qpack.Decoder = d.decode(stream, section);
  if let Some(e) = next.failed {
    return Err(e);
  }
  let fields: qpack.Field[] = next.fields;
  let waiting: boolean = next.waiting;
  return Ok(Got { decoder: next, fields: fields, blocked: waiting });
}

function instructions(d: qpack.Decoder): (qpack.Decoder, u8[]) {
  let out: u8[] = d.out;
  return (d.instructions_taken(), out);
}

function fields_text(fs: qpack.Field[]): string {
  let out: string = "";
  for f in fs {
    out = out + f.name + "=" + f.value;
    if (f.sensitive) {
      out = out + " (never)";
    }
    out = out + "; ";
  }
  return out;
}

function error_text(e: qpack.QpackError): string {
  return e.code().to_string() + " " + e.message();
}

function fed(d: qpack.Decoder, encoder_stream: string): Result[qpack.Decoder, string] {
  match (d.on_encoder_stream(__codec_bytes(hex.decode(encoder_stream)))) {
    Ok(next) => {
      return Ok(next);
    },
    Err(e) => {
      return Err(error_text(e));
    }
  }
}

function section(d: qpack.Decoder, stream: i64, bytes: string): Result[(qpack.Decoder, string), string] {
  match (decode_on(d, stream, __codec_bytes(hex.decode(bytes)))) {
    Ok(got) => {
      let (next, owed) = instructions(got.decoder);
      let text: string = fields_text(got.fields);
      if (got.blocked) {
        text = "blocked";
      }
      return Ok((next, text + "| " + hex.encode(owed)));
    },
    Err(e) => {
      return Err(error_text(e));
    }
  }
}

function owed(d: qpack.Decoder): (qpack.Decoder, string) {
  let (next, out) = instructions(d);
  return (next, hex.encode(out));
}

function test_b1(): test.TestOutcome {
  match (section(qpack.decoder(220 as i64, 2, 16384 as i64), 0 as i64, "0000510b2f696e6465782e68746d6c")) {
    Ok(r) => {
      return test.assert_eq(r.1, ":path=/index.html; | ");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_b2_to_b5(): test.TestOutcome {
  let log: string = "";
  let d: qpack.Decoder = qpack.decoder(220 as i64, 2, 16384 as i64);
  let steps: string[] = [
    "e 3fbd01c00f7777772e6578616d706c652e636f6dc10c2f73616d706c652f70617468",
    "s 4 03811011",
    "e 4a637573746f6d2d6b65790c637573746f6d2d76616c7565",
    "e 02",
    "s 8 050080c181",
    "e 810d637573746f6d2d76616c756532",
  ];
  for step in steps {
    match (b_step(d, step)) {
      Ok(r) => {
        d = r.0;
        log = log + r.1 + "\n";
      },
      Err(e) => {
        return test.fail(log + e);
      }
    }
  }
  let want: string = "inserted 2 size 106 owes 02\n"
    + "4: :authority=www.example.com; :path=/sample/path; | 84\n"
    + "inserted 3 size 160 owes 01\n"
    + "inserted 4 size 217 owes 01\n"
    + "8: :authority=www.example.com; :path=/; custom-key=custom-value; | 88\n"
    + "inserted 5 size 215 owes 01\n";
  return test.assert_eq(log, want);
}

function b_step(d: qpack.Decoder, step: string): Result[(qpack.Decoder, string), string] {
  if (step.starts_with("e ")) {
    let fed_d: qpack.Decoder = fed(d, step.drop(2))?;
    let (next, out) = owed(fed_d);
    return Ok((next, "inserted " + next.insert_count().to_string() + " size " + next.table_size().to_string() + " owes " + out));
  }
  let Some(space) = step.drop(2).index_of(" ") else {
    return Err("a step with no space: " + step);
  };
  let id: string = step.drop(2).take(space);
  let (next, text) = section(d, i32.parse_i32(id).unwrap_or(0) as i64, step.drop(3 + space))?;
  return Ok((next, id + ": " + text));
}

function test_blocked(): test.TestOutcome {
  let d: qpack.Decoder = qpack.decoder(220 as i64, 1, 16384 as i64);
  let first: string = "";
  let second: string = "";
  match (section(d, 4 as i64, "0381" + "1011")) {
    Ok(r) => {
      d = r.0;
      first = r.1;
    },
    Err(e) => {
      return test.fail(e);
    }
  }
  match (section(d, 8 as i64, "0381" + "1011")) {
    Ok(r) => {
      second = r.1;
    },
    Err(e) => {
      second = e;
    }
  }
  match (fed(d, "3fbd01c00f7777772e6578616d706c652e636f6dc10c2f73616d706c652f70617468")) {
    Ok(d2) => {
      let (d3, _) = owed(d2);
      match (section(d3, 4 as i64, "03811011")) {
        Ok(r) => {
          return test.assert_eq(first + " / " + second + " / " + r.1, "blocked| " + " / 512 qpack: more streams blocked than allowed / :authority=www.example.com; :path=/sample/path; | 84");
        },
        Err(e) => {
          return test.fail(e);
        }
      }
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_split_instruction(): test.TestOutcome {
  let d: qpack.Decoder = qpack.decoder(220 as i64, 2, 16384 as i64);
  let parts: string[] = ["3f", "bd01c0", "0f7777772e6578", "616d706c652e636f6d"];
  let counts: string = "";
  for p in parts {
    match (fed(d, p)) {
      Ok(next) => {
        d = next;
        counts = counts + d.insert_count().to_string();
      },
      Err(e) => {
        return test.fail(e);
      }
    }
  }
  return test.assert_eq(counts, "0001");
}

function test_encoder(): test.TestOutcome {
  let fs: qpack.Field[] = [qpack.field(":method", "GET"), qpack.field(":path", "/index.html"), qpack.field("x-fern", "yes"), qpack.sensitive("authorization", "secret"), qpack.field("content-type", "text/plain")];
  let plain: u8[] = qpack.encoder().without_huffman().encode(fs);
  let coded: u8[] = qpack.encoder().encode(fs);
  let d: qpack.Decoder = qpack.decoder(0 as i64, 0, 16384 as i64);
  let back: string = "";
  for bytes in [plain, coded] {
    match (decode_on(d, 0 as i64, bytes)) {
      Ok(got) => {
        back = back + fields_text(got.fields) + "| ";
      },
      Err(e) => {
        return test.fail(error_text(e));
      }
    }
  }
  return test.assert_eq(hex.encode(plain) + " " + int.int_to_string(coded.len()) + " " + back, "0000d1510b2f696e6465782e68746d6c26782d6665726e03796573"
    + "7f4506736563726574f5 " + int.int_to_string(coded.len()) + " :method=GET; :path=/index.html; x-fern=yes; authorization=secret (never); content-type=text/plain; | :method=GET; :path=/index.html; x-fern=yes; authorization=secret (never); content-type=text/plain; | ");
}

function test_status_and_length(): test.TestOutcome {
  let enc: qpack.Encoder = qpack.encoder();
  let mismatched: string = "";
  for code in [200, 404, 425, 418, 999] {
    let direct: u8[] = enc.put_status(enc.section(0), code);
    if (hex.encode(direct) != hex.encode(enc.encode([qpack.field(":status", int.int_to_string(code))]))) {
      mismatched = mismatched + " status " + int.int_to_string(code);
    }
  }
  for n in [0 as i64, 5 as i64, 12 as i64, 100 as i64, 12345 as i64, 9999999999 as i64] {
    for e in [enc, enc.without_huffman()] {
      let direct: u8[] = e.put_length(e.section(0), n);
      if (hex.encode(direct) != hex.encode(e.encode([qpack.field("content-length", n.to_string())]))) {
        mismatched = mismatched + " length " + n.to_string();
      }
    }
  }
  let plain: qpack.Encoder = enc.without_huffman();
  let block: u8[] = plain.section(0);
  block = plain.put_status(block, 200);
  block = plain.put_status(block, 418);
  block = plain.put_length(block, 42 as i64);
  return test.assert_eq(hex.encode(block) + mismatched, "0000d95f09033431385402" + "3432");
}

function test_errors(): test.TestOutcome {
  let d: qpack.Decoder = qpack.decoder(220 as i64, 2, 40 as i64);
  let too_big: string = result_text(section(d, 0 as i64, "0000510b2f696e6465782e68746d6c"));
  let capacity: string = result_text_d(fed(d, "3fde01"));
  let past_ric: string = "-";
  match (fed(qpack.decoder(220 as i64, 2, 16384 as i64), "3fbd01c00f7777772e6578616d706c652e636f6d")) {
    Ok(d1) => {
      past_ric = result_text(section(d1, 0 as i64, "020011"));
    },
    Err(e) => {
      past_ric = e;
    }
  }
  let no_static: string = result_text(section(d, 0 as i64, "0000ff24"));
  let negative_base: string = result_text(section(d, 0 as i64, "0281"));
  let enc_ack: string = "-";
  match (qpack.encoder().on_decoder_stream(__codec_bytes(hex.decode("84")))) {
    Ok(_) => {
      enc_ack = "accepted";
    },
    Err(e) => {
      enc_ack = error_text(e);
    }
  }
  return test.assert_eq(too_big + "\n" + capacity + "\n" + past_ric + "\n" + no_static + "\n" + negative_base + "\n" + enc_ack, "512 qpack: a field section larger than allowed\n"
    + "513 qpack: encoder stream: a capacity over the maximum advertised\n"
    + "512 qpack: a reference past the Required Insert Count\n"
    + "512 qpack: no static table entry 99\n"
    + "512 qpack: a Base below zero\n"
    + "514 qpack: decoder stream: a Section Acknowledgment for a section with no dynamic references");
}

function result_text(r: Result[(qpack.Decoder, string), string]): string {
  match (r) {
    Ok(v) => {
      return "ok " + v.1;
    },
    Err(e) => {
      return e;
    }
  }
}

function result_text_d(r: Result[qpack.Decoder, string]): string {
  match (r) {
    Ok(_) => {
      return "ok";
    },
    Err(e) => {
      return e;
    }
  }
}

