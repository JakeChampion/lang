function test_lsqpack_trace(): test.TestOutcome {
  let d: qpack.Decoder = qpack.decoder(512 as i64, 16, 65536 as i64);
  let got: string = "";
  for line in LSQPACK_TRACE {
    if (line.starts_with("E ")) {
      match (fed(d, line.drop(2))) {
        Ok(next) => {
          d = next;
        },
        Err(e) => {
          return test.fail(e);
        }
      }
    } else {
      match (b_step(d, line)) {
        Ok(r) => {
          d = r.0;
          let text: string = r.1;
          let Some(bar) = text.index_of("| ") else {
            return test.fail("a section with no `| `: " + text);
          };
          got = got + text.take(bar) + "\n";
        },
        Err(e) => {
          return test.fail(e);
        }
      }
    }
  }
  let want: string = "";
  for f in LSQPACK_FIELDS {
    want = want + f + "\n";
  }
  return test.assert_eq(got, want);
}

function overflowing_integer(first: u8): u8[] {
  let out: u8[] = [first];
  let i: i32 = 0;
  while (i < 8) {
    out = out.append(255u8);
    i = i + 1;
  }
  return out.append(127u8);
}

function largest_integer(first: u8, prefix: i64): u8[] {
  let out: u8[] = [first];
  let rest: i64 = 4611686018427387903 as i64 - prefix;
  while (rest >= 128 as i64) {
    out = out.append((rest & 127 as i64 | 128 as i64) as u8);
    rest = rest >> 7;
  }
  return out.append(rest as u8);
}

function test_integer_overflow(): test.TestOutcome {
  let d: qpack.Decoder = qpack.decoder(220 as i64, 2, 16384 as i64);
  let capacity: string = result_text_d(fed(d, hex.encode(overflowing_integer(63u8))));
  let want: string = "513 qpack: encoder stream: an integer over 2^62";
  if (capacity != want) {
    return test.assert_eq(capacity, want);
  }
  let section_err: string = "accepted";
  match (decode_on(d, 0 as i64, overflowing_integer(255u8).append(0u8))) {
    Ok(_) => {},
    Err(e) => {
      section_err = error_text(e);
    }
  }
  let string_err: string = "accepted";
  match (decode_on(d, 0 as i64, [0u8, 0u8, 81u8].concat(overflowing_integer(127u8)))) {
    Ok(_) => {},
    Err(e) => {
      string_err = error_text(e);
    }
  }
  let decoder_err: string = "accepted";
  match (qpack.encoder().on_decoder_stream(overflowing_integer(127u8))) {
    Ok(_) => {},
    Err(e) => {
      decoder_err = error_text(e);
    }
  }
  return test.assert_eq(section_err + "\n" + string_err + "\n" + decoder_err, "512 qpack: an integer over 2^62\n512 qpack: an integer over 2^62\n514 qpack: decoder stream: an integer over 2^62");
}

function test_largest_integer(): test.TestOutcome {
  let d: qpack.Decoder = qpack.decoder(4611686018427387903 as i64, 0, 16384 as i64);
  let capacity: string = result_text_d(fed(d, hex.encode(largest_integer(63u8, 31 as i64))));
  let short: string = "accepted";
  match (decode_on(d, 0 as i64, [0u8, 0u8, 81u8].concat(largest_integer(127u8, 127 as i64)))) {
    Ok(_) => {},
    Err(e) => {
      short = error_text(e);
    }
  }
  let cancelled: string = "ok";
  match (qpack.encoder().on_decoder_stream(largest_integer(127u8, 63 as i64))) {
    Ok(_) => {},
    Err(e) => {
      cancelled = error_text(e);
    }
  }
  return test.assert_eq(capacity + " " + short + " " + cancelled, "ok 512 qpack: a field section larger than allowed ok");
}

function test_cancellation(): test.TestOutcome {
  match (section(qpack.decoder(220 as i64, 1, 16384 as i64), 4 as i64, "03811011")) {
    Ok(r) => {
      let (d1, first) = instructions(r.0.cancel(4 as i64));
      let (d2, second) = instructions(d1.cancel(132 as i64));
      let again: string = result_text(section(d2, 8 as i64, "03811011"));
      let (_, empty) = instructions(qpack.decoder(0 as i64, 0, 16384 as i64).cancel(4 as i64));
      return test.assert_eq(hex.encode(first) + " " + hex.encode(second) + " " + again + "[" + hex.encode(empty) + "]", "44 7f45 ok blocked| []");
    },
    Err(e) => {
      return test.fail(e);
    }
  }
}

function test_oversized_literal(): test.TestOutcome {
  let cases: string[] = ["5f808080808010", "3fbd015f9e01", "3fbd015f9d01", "3fbd017fa305", "3fbd017fa205", "3fbd01c07f34", "3fbd01c07f33"];
  let out: string = "";
  for c in cases {
    out = out + result_text_d(fed(qpack.decoder(220 as i64, 2, 16384 as i64), c)) + "; ";
  }
  let e: string = "513 qpack: encoder stream: an entry larger than the table's capacity";
  return test.assert_eq(out, e + "; " + e + "; ok; " + e + "; ok; " + e + "; ok; ");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/http/qpack");
  r = r.it("B.1: a literal with a static name reference", test_b1);
  r = r.it("B.2 to B.5: the dynamic table", test_b2_to_b5);
  r = r.it("a blocked section, and the blocked-streams limit", test_blocked);
  r = r.it("an instruction split across reads", test_split_instruction);
  r = r.it("the encoder", test_encoder);
  r = r.it("a :status line from the static table where it has one, and a content-length line spelled from its integer", test_status_and_length);
  r = r.it("errors", test_errors);
  r = r.it("a trace from ls-qpack", test_lsqpack_trace);
  r = r.it("oversized integers are typed errors rather than wrapped values", test_integer_overflow);
  r = r.it("the largest 62-bit integer is still supported", test_largest_integer);
  r = r.it("stream cancellation encoding and blocked-slot release", test_cancellation);
  r = r.it("an encoder-stream literal too long for the table is refused at its length", test_oversized_literal);
  return r.finish();
}

function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
