  "48: :method=PUT; :scheme=https; :authority=example.com; :path=/index.html; user-agent=fern-test/1.0; x-request-5=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv; cookie=session=2; theme=dark; ",
  "52: :method=PUT; :scheme=https; :authority=example.com; :path=/index.html; user-agent=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36; x-request-6=vvvvvvv; cookie=session=3; theme=dark; ",
  "56: :method=PUT; :scheme=https; :authority=example.com; :path=/; user-agent=curl/8.9.1; x-request-0=vvvv; cookie=session=4; theme=dark; ",
