  "20: :method=GET; :scheme=https; :authority=example.com; :path=/a/very/long/path/that/repeats/5; user-agent=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36; x-request-5=vvvv; cookie=session=0; theme=dark; ",
  "24: :method=PUT; :scheme=https; :authority=example.com; :path=/; user-agent=fern-test/1.0; x-request-6=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv; cookie=session=1; theme=dark; ",
  "28: :method=PUT; :scheme=https; :authority=example.com; :path=/a/very/long/path/that/repeats/7; user-agent=fern-test/1.0; x-request-0=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv; cookie=session=2; theme=dark; ",
