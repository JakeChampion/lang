import "std/test";
import "std/math" as math;

function test_range(): test.TestOutcome {
  return test.assert_eq_array(math.range(2, 5), [2, 3, 4]);
}

function test_range_empty(): test.TestOutcome {
  return test.assert_eq(math.range(5, 2).len(), 0);
}

function test_range_single(): test.TestOutcome {
  return test.assert_eq_array(math.range(7, 8), [7]);
}

function test_range_step(): test.TestOutcome {
  return test.assert_eq_array(math.range_step(0, 10, 3), [0, 3, 6, 9]);
}

function test_range_step_exact(): test.TestOutcome {
  return test.assert_eq_array(math.range_step(0, 9, 3), [0, 3, 6]);
}

function test_range_step_nonpositive(): test.TestOutcome {
  return test.assert_eq(math.range_step(0, 10, 0).len(), 0);
}

function test_i32_bounds(): test.TestOutcome {
  return test.assert_true(math.i32_max() == 2147483647
    && math.i32_min() == 0 - 2147483647 - 1);
}

function test_i64_bounds(): test.TestOutcome {
  return test.assert_eq(math.i64_max(), 9223372036854775807);
}

function test_pack_rgb(): test.TestOutcome {
  return test.assert_eq(math.pack_rgb(255, 128, 64), 16744512);
}

function test_pack_rgb_wraps(): test.TestOutcome {
  return test.assert_eq(math.pack_rgb(256, 256, 256), 0);
}

function pr(s: string): i32 {
  match (math.parse_rgb_hex(s)) {
    Some(v) => {
      return v;
    },
    None => {
      return -1;
    }
  }
}

function test_parse_rgb_hex(): test.TestOutcome {
  if (pr("#ff8800") != math.pack_rgb(255, 136, 0)) {
    return test.fail("#ff8800");
  }
  if (pr("ff8800") != math.pack_rgb(255, 136, 0)) {
    return test.fail("no hash");
  }
  if (pr("#FF8800") != math.pack_rgb(255, 136, 0)) {
    return test.fail("uppercase");
  }
  return test.assert_eq(pr("#f80"), math.pack_rgb(255, 136, 0));
}

function test_parse_rgb_hex_invalid(): test.TestOutcome {
  if (pr("#12345") != -1) {
    return test.fail("short");
  }
  if (pr("#gg0000") != -1) {
    return test.fail("bad digit");
  }
  if (pr("") != -1) {
    return test.fail("empty");
  }
  return test.assert_eq(pr("#"), -1);
}

function test_rgb_luminance(): test.TestOutcome {
  if (math.rgb_luminance(math.pack_rgb(255, 255, 255)) != 255) {
    return test.fail("white");
  }
  if (math.rgb_luminance(math.pack_rgb(0, 0, 0)) != 0) {
    return test.fail("black");
  }
  let green: i32 = math.rgb_luminance(math.pack_rgb(0, 255, 0));
  let red: i32 = math.rgb_luminance(math.pack_rgb(255, 0, 0));
  let blue: i32 = math.rgb_luminance(math.pack_rgb(0, 0, 255));
  return test.assert_true(green > red && red > blue);
}

function test_rgb_is_dark(): test.TestOutcome {
  if (!math.rgb_is_dark(math.pack_rgb(0, 0, 0))) {
    return test.fail("black is dark");
  }
  if (!math.rgb_is_dark(math.pack_rgb(0, 0, 255))) {
    return test.fail("blue is dark");
  }
  if (math.rgb_is_dark(math.pack_rgb(255, 255, 255))) {
    return test.fail("white is light");
  }
  return test.assert_false(math.rgb_is_dark(math.pack_rgb(255, 136, 0)));
}

function test_random_int_range(): test.TestOutcome {
  let i: i32 = 0;
  let over: i32 = 0;
  while (i < 4000) {
    let v: i32 = math.random_int(0, 2000000000);
    if (v < 0 || v >= 2000000000) {
      return test.fail("random_int(0, 2e9) out of range: " + v.to_string());
    }
    if (v > 16777215) {
      over = over + 1;
    }
    i = i + 1;
  }
  if (over == 0) {
    return test.fail("random_int never exceeded 2^24 over 4000 draws (24-bit truncation)");
  }
  i = 0;
  while (i < 500) {
    let w: i32 = math.random_int(5, 8);
    if (w < 5 || w >= 8) {
      return test.fail("random_int(5, 8) out of range: " + w.to_string());
    }
    i = i + 1;
  }
  return test.pass();
}

function test_random_int_empty(): test.TestOutcome {
  return test.assert_true(math.random_int(4, 4) == 4
    && math.random_int(9, 2) == 9);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/math");
  r = r.it("range", test_range);
  r = r.it("range empty", test_range_empty);
  r = r.it("range single", test_range_single);
  r = r.it("range_step", test_range_step);
  r = r.it("range_step exact end", test_range_step_exact);
  r = r.it("range_step nonpositive", test_range_step_nonpositive);
  r = r.it("i32 bounds", test_i32_bounds);
  r = r.it("i64 bounds", test_i64_bounds);
  r = r.it("pack_rgb", test_pack_rgb);
  r = r.it("pack_rgb wraps", test_pack_rgb_wraps);
  r = r.it("parse_rgb_hex", test_parse_rgb_hex);
  r = r.it("parse_rgb_hex invalid", test_parse_rgb_hex_invalid);
  r = r.it("rgb_luminance", test_rgb_luminance);
  r = r.it("rgb_is_dark", test_rgb_is_dark);
  r = r.it("random_int range", test_random_int_range);
  r = r.it("random_int empty", test_random_int_empty);
  return r.finish();
}
