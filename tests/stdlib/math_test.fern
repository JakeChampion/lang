import "std/test";
import "std/math" as math;
import "std/i32";
import "std/i64";

function test_i32_bounds(): test.TestOutcome {
  return test.assert_true(i32.MAX == 2147483647
    && i32.MIN == 0 - 2147483647 - 1);
}

function test_i64_bounds(): test.TestOutcome {
  return test.assert_eq(i64.MAX, 9223372036854775807);
}

function test_pack_rgb(): test.TestOutcome {
  return test.assert_eq(math.pack_rgb(255, 128, 64), 16744512);
}

function test_pack_rgb_wraps(): test.TestOutcome {
  return test.assert_eq(math.pack_rgb(256, 256, 256), 0);
}

function pr(s: string): i32 {
  match (math.parse_rgb_hex(s)) {
    Ok(v) => {
      return v;
    },
    Err(_) => {
      return -1;
    }
  }
}

function test_parse_rgb_hex(): test.TestOutcome {
  if (pr("#ff8800") != math.pack_rgb(255, 136, 0)) {
    return test.fail("#ff8800");
  }
  if (pr("ff8800") != math.pack_rgb(255, 136, 0)) {
    return test.fail("no hash");
  }
  if (pr("#FF8800") != math.pack_rgb(255, 136, 0)) {
    return test.fail("uppercase");
  }
  return test.assert_eq(pr("#f80"), math.pack_rgb(255, 136, 0));
}

function test_parse_rgb_hex_invalid(): test.TestOutcome {
  if (pr("#12345") != -1) {
    return test.fail("short");
  }
  if (pr("#gg0000") != -1) {
    return test.fail("bad digit");
  }
  if (pr("") != -1) {
    return test.fail("empty");
  }
  if (pr("#") != -1) {
    return test.fail("hash only");
  }
  let Err(e) = math.parse_rgb_hex("#gg0000") else {
    return test.fail("bad digit accepted");
  };
  return test.assert_eq(e.message(), "\"#gg0000\" is not a hex color such as #f80 or #ff8800");
}

function test_rgb_luminance(): test.TestOutcome {
  if (math.rgb_luminance(math.pack_rgb(255, 255, 255)) != 255) {
    return test.fail("white");
  }
  if (math.rgb_luminance(math.pack_rgb(0, 0, 0)) != 0) {
    return test.fail("black");
  }
  let green: i32 = math.rgb_luminance(math.pack_rgb(0, 255, 0));
  let red: i32 = math.rgb_luminance(math.pack_rgb(255, 0, 0));
  let blue: i32 = math.rgb_luminance(math.pack_rgb(0, 0, 255));
  return test.assert_true(green > red && red > blue);
}

function test_rgb_is_dark(): test.TestOutcome {
  if (!math.rgb_is_dark(math.pack_rgb(0, 0, 0))) {
    return test.fail("black is dark");
  }
  if (!math.rgb_is_dark(math.pack_rgb(0, 0, 255))) {
    return test.fail("blue is dark");
  }
  if (math.rgb_is_dark(math.pack_rgb(255, 255, 255))) {
    return test.fail("white is light");
  }
  return test.assert_false(math.rgb_is_dark(math.pack_rgb(255, 136, 0)));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/math");
  r = r.it("i32 bounds", test_i32_bounds);
  r = r.it("i64 bounds", test_i64_bounds);
  r = r.it("pack_rgb", test_pack_rgb);
  r = r.it("pack_rgb wraps", test_pack_rgb_wraps);
  r = r.it("parse_rgb_hex", test_parse_rgb_hex);
  r = r.it("parse_rgb_hex invalid", test_parse_rgb_hex_invalid);
  r = r.it("rgb_luminance", test_rgb_luminance);
  r = r.it("rgb_is_dark", test_rgb_is_dark);
  return r.finish();
}
