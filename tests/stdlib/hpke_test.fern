import "std/test";
import "std/hex";
import "std/codec";
import "std/crypto" as crypto;
import "std/crypto/hpke";

// The MLKEM768-X25519, HKDF-SHA256, ChaCha20Poly1305 vector of the
// draft-ietf-hpke-pq test vectors, as filippo.io/hpke v0.4.0 holds them.
// The long values are given by their SHA3-256 hash.
const SEED: string = "b3f98b03126a431ccecc62ae0f68e102c2d8e1cc7b21ba85d821d8e31761e0f8";

const IKM_E: string = "a3a869097e0241158eca5dc6c9e695f9e0d2ee5db51c09c435aab69d56509a43d94ff76d7d47cf79ecf75394261236cec024bd849cc782e14f7f0738af83daed";

const INFO: string = "34663634363532303666366532303631323034373732363536333639363136653230353537323665";

const PUBLIC_KEY_HASH: string = "9341ea5055dd2d881a61b7057f9ea202115cf01665472c4b122337cb2b707990";

const ENC_HASH: string = "98372be612bddfe5ae19a4ded0d53bdb7d1040f626f4fb3d971d775d2e702bf7";

const SHARED_SECRET: string = "b90cf181d95351d1091569487caaf6c3434eeb181a2c4c04631980ce139afa67";

const PT: string = "34323635363137353734373932303639373332303734373237353734363832633230373437323735373436383230363236353631373537343739";

const CT0: string = "ac355d192158cd54250e1702be51e9d2eafe5f9292a9f153e02a2323e1ff071a30947836c38c63c986c28ccf05e00d4e5fe066a48ab8d5b39c69d32da80c93dc868daa0f853a6cbdd640";

const CT1: string = "712e40f2971afcfbf899f766c47d815265c1a0f52dba3bd68dfe6d14918f114b1d85f5ed0409a9b6caa370f1ed94b9d564080dd7468f629881db3aee6db91b5479a634ff18b819694d43";

function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
  return [];
}

function b(s: string): u8[] {
  return __codec_bytes(hex.decode(s));
}

function __h(x: [u8]): string {
  return hex.encode(crypto.sha3_256(x));
}

function key(): hpke.HybridKey {
  match (hpke.mlkem768x25519_key(b(SEED))) {
    Ok(k) => {
      return k;
    },
    Err(e) => {
      eprint(e.message());
      exit(97);
    }
  }
  return hpke.HybridKey { public_key: [], decapsulation_key: [], scalar: [] };
}

function sender(): hpke.Sender {
  match (hpke.setup_sender_derand(key().public_key, b(INFO), b(IKM_E))) {
    Ok(s) => {
      return s;
    },
    Err(e) => {
      eprint(e.message());
      exit(96);
    }
  }
  return hpke.Sender { enc: [], context: hpke.key_schedule(0, [], []) };
}

function refusal[T](r: Result[T, hpke.HpkeError]): string {
  return match (r) {
    Ok(_) => "accepted",
    Err(e) => e.message(),
  };
}

function test_key(): test.TestOutcome {
  let k = key();
  return test.assert_eq(__h(k.public_key), PUBLIC_KEY_HASH);
}

function test_encap(): test.TestOutcome {
  let e = hpke.mlkem768x25519_encap_derand(key().public_key, b(IKM_E));
  let Ok(e) = e else {
    return test.fail("refused");
  };
  if (__h(e.enc) != ENC_HASH) {
    return test.fail("enc");
  }
  return test.assert_eq(hex.encode(e.shared_secret), SHARED_SECRET);
}

function test_decap(): test.TestOutcome {
  let enc = sender().enc;
  return test.assert_eq(
    match (hpke.mlkem768x25519_decap(key(), enc)) {
      Ok(ss) => hex.encode(ss),
      Err(e) => e.message(),
    },
    SHARED_SECRET,
  );
}

function test_key_schedule(): test.TestOutcome {
  let c = hpke.key_schedule(hpke.KEM_MLKEM768_X25519, b(SHARED_SECRET), b(INFO));
  if (hex.encode(c.key) != "4a4c042267e8ec360c83b2baf0d5e3dcca73a86531cdf67ec41d95bccfe12387") {
    return test.fail("key");
  }
  if (hex.encode(c.base_nonce) != "5ddfaaee10a4dfd0d8e1b49f") {
    return test.fail("base nonce");
  }
  if (hex.encode(c.export(b("70736575646f72616e646f6d30"), 32)) != "74e80a263b1c880d6d71a7525e6ba39ddf1024e53e32765d91db4924d44baff1") {
    return test.fail("export");
  }
  return test.assert_eq(hex.encode(c.exporter_secret), "145e4b99cabeaa6f5a380367d140d308746ea25d96f937288f85403b5c4384ae");
}

function test_seal_sequence(): test.TestOutcome {
  let (ct0, c) = sender().context.seal(b("436f756e742d30"), b(PT));
  if (hex.encode(ct0) != CT0) {
    return test.fail("sequence number 0");
  }
  let (ct1, _) = c.seal(b("436f756e742d31"), b(PT));
  return test.assert_eq(hex.encode(ct1), CT1);
}

function test_open_sequence(): test.TestOutcome {
  let Ok(c) = hpke.setup_recipient(key(), sender().enc, b(INFO)) else {
    return test.fail("setup");
  };
  let Ok(first) = c.open(b("436f756e742d30"), b(CT0)) else {
    return test.fail("sequence number 0");
  };
  if (hex.encode(first.0) != PT) {
    return test.fail("plaintext 0");
  }
  if (refusal(first.1.open(b("436f756e742d30"), b(CT0))) != "hpke: the message does not authenticate") {
    return test.fail("a replay at sequence number 1");
  }
  return test.assert_eq(
    match (first.1.open(b("436f756e742d31"), b(CT1))) {
      Ok(r) => hex.encode(r.0),
      Err(e) => e.message(),
    },
    PT,
  );
}

function test_refusals(): test.TestOutcome {
  let k = key();
  let enc = sender().enc;
  let bad = "hpke: the message does not authenticate";
  let Ok(c) = hpke.setup_recipient(k, enc, b(INFO)) else {
    return test.fail("setup");
  };
  if (refusal(c.open(b("436f756e742d31"), b(CT0))) != bad) {
    return test.fail("wrong aad");
  }
  if (refusal(c.open([], b(CT0)[0:15])) != bad) {
    return test.fail("short message");
  }
  let flipped = enc.with(0, enc[0] ^ 1 as u8);
  let Ok(implicit) = hpke.setup_recipient(k, flipped, b(INFO)) else {
    return test.fail("implicit rejection");
  };
  if (refusal(implicit.open(b("436f756e742d30"), b(CT0))) != bad) {
    return test.fail("ML-KEM ciphertext with one bit changed");
  }
  let low = __bytes_into(__alloc_u8(1120), 0, enc, 0, 1088);
  if (refusal(hpke.setup_recipient(k, low, b(INFO))) != "hpke: the X25519 shared secret is all zeros") {
    return test.fail("zero share");
  }
  return test.assert_eq(refusal(hpke.setup_recipient(k, enc[0:1119], b(INFO))), "hpke: the encapsulated key is 1119 bytes, want 1120");
}

function test_lengths(): test.TestOutcome {
  let pk = key().public_key;
  if (refusal(hpke.mlkem768x25519_key(b(SEED)[0:31])) != "hpke: the seed is 31 bytes, want 32") {
    return test.fail("seed");
  }
  if (refusal(hpke.mlkem768x25519_encap_derand(pk[0:1215], b(IKM_E))) != "hpke: the public key is 1215 bytes, want 1216") {
    return test.fail("public key");
  }
  if (refusal(hpke.mlkem768x25519_encap_derand(pk, b(IKM_E)[0:63])) != "hpke: the randomness is 63 bytes, want 64") {
    return test.fail("randomness");
  }
  let high = pk.with(0, 0xff as u8).with(1, pk[1] | 0x0f as u8);
  if (refusal(hpke.mlkem768x25519_encap_derand(high, b(IKM_E))) != "hpke: the ML-KEM-768 encapsulation key has a coefficient not below q") {
    return test.fail("modulus");
  }
  if (refusal(hpke.mlkem768x25519_check_public_key(high)) != "hpke: the ML-KEM-768 encapsulation key has a coefficient not below q") {
    return test.fail("check of the modulus");
  }
  if (refusal(hpke.mlkem768x25519_check_public_key(pk[0:1215])) != "hpke: the public key is 1215 bytes, want 1216") {
    return test.fail("check of the length");
  }
  let zero = __bytes_into(__alloc_u8(1216), 0, pk, 0, 1184);
  if (refusal(hpke.mlkem768x25519_check_public_key(zero)) != "accepted") {
    return test.fail("check of a low-order X25519 part");
  }
  return test.assert_eq(refusal(hpke.mlkem768x25519_encap_derand(zero, b(IKM_E))), "hpke: the X25519 shared secret is all zeros");
}

// RFC 9180 appendix A.5.1: DHKEM(P-256, HKDF-SHA256), HKDF-SHA256 and
// ChaCha20Poly1305 in the base mode.
const A51_INFO: string = "4f6465206f6e2061204772656369616e2055726e";

const A51_IKM_E: string = "f1f1a3bc95416871539ecb51c3a8f0cf608afb40fbbe305c0a72819d35c33f1f";

const A51_IKM_R: string = "61092f3f56994dd424405899154a9918353e3e008171517ad576b900ddb275e7";

const A51_SK_E: string = "7550253e1147aae48839c1f8af80d2770fb7a4c763afe7d0afa7e0f42a5b3689";

const A51_SK_R: string = "a4d1c55836aa30f9b3fbb6ac98d338c877c2867dd3a77396d13f68d3ab150d3b";

const A51_PK_R: string = "04a697bffde9405c992883c5c439d6cc358170b51af72812333b015621dc0f40bad9bb726f68a5c013806a790ec716ab8669f84f6b694596c2987cf35baba2a006";

const A51_ENC: string = "04c07836a0206e04e31d8ae99bfd549380b072a1b1b82e563c935c095827824fc1559eac6fb9e3c70cd3193968994e7fe9781aa103f5b50e934b5b2f387e381291";

const A51_SHARED_SECRET: string = "806520f82ef0b03c823b7fc524b6b55a088f566b9751b89551c170f4113bd850";

const A51_PT: string = "4265617574792069732074727574682c20747275746820626561757479";

const A51_CT: string[] = [
  "6469c41c5c81d3aa85432531ecf6460ec945bde1eb428cb2fedf7a29f5a685b4ccb0d057f03ea2952a27bb458b",
  "f1564199f7e0e110ec9c1bcdde332177fc35c1adf6e57f8d1df24022227ffa8716862dbda2b1dc546c9d114374",
  "39de89728bcb774269f882af8dc5369e4f3d6322d986e872b3a8d074c7c18e8549ff3f85b6d6592ff87c3f310c",
];

// The MLKEM768-P256 vector of draft-ietf-hpke-pq (HKDF-SHA256, AES-128-GCM),
// as filippo.io/hpke v0.4.0 holds it. The KEM does not depend on the AEAD, so
// the test checks the public key and the shared secret.
const PQ256_SEED: string = "dfa3a04d54a0ec2f7edec57185e3df94063855fc7af64f25b815417a2c6eb0e4";

const PQ256_PUBLIC_KEY_HASH: string = "feb2745b77c8b625cb0b1e4e84a427728783830eeadf0948a8f35862a9b7a073";

const PQ256_SHARED_SECRET: string = "3688931682c215e9e06ad620eba7faa70dd0d38081b4ea3d5b636ee062578991";

const PQ256_ENC: string = "";

function p256_key(ikm: string): hpke.P256Key {
  match (hpke.p256_derive_key_pair(b(ikm))) {
    Ok(k) => {
      return k;
    },
    Err(e) => {
      eprint(e.message());
      exit(95);
    }
  }
  return hpke.P256Key { scalar: [], public_key: [] };
}

function test_p256_derive(): test.TestOutcome {
  let r = p256_key(A51_IKM_R);
  if (hex.encode(r.scalar) != A51_SK_R || hex.encode(r.public_key) != A51_PK_R) {
    return test.fail("the key of ikmR");
  }
  let e = p256_key(A51_IKM_E);
  if (hex.encode(e.scalar) != A51_SK_E) {
    return test.fail("the scalar of ikmE");
  }
  return test.assert_eq(hex.encode(e.public_key), A51_ENC);
}

function test_p256_encap_decap(): test.TestOutcome {
  let Ok(e) = hpke.p256_encap_derand(b(A51_PK_R), b(A51_SK_E)) else {
    return test.fail("encap refused");
  };
  if (hex.encode(e.enc) != A51_ENC || hex.encode(e.shared_secret) != A51_SHARED_SECRET) {
    return test.fail("encap");
  }
  return test.assert_eq(
    match (hpke.p256_decap(p256_key(A51_IKM_R), b(A51_ENC))) {
      Ok(ss) => hex.encode(ss),
      Err(e) => e.message(),
    },
    A51_SHARED_SECRET,
  );
}

function test_p256_context(): test.TestOutcome {
  let Ok(e) = hpke.p256_encap_derand(b(A51_PK_R), b(A51_SK_E)) else {
    return test.fail("encap refused");
  };
  let s = hpke.sender_of(hpke.KEM_P256, e, b(A51_INFO));
  let c = s.context;
  let r = hpke.key_schedule(hpke.KEM_P256, b(A51_SHARED_SECRET), b(A51_INFO));
  for i in 0..3 {
    let aad = ("Count-" + i.to_string()).as_bytes();
    let (ct, next) = c.seal(aad, b(A51_PT));
    if (hex.encode(ct) != A51_CT[i]) {
      return test.fail("ciphertext " + i.to_string());
    }
    let Ok(opened) = r.open(aad, ct) else {
      return test.fail("open " + i.to_string());
    };
    if (hex.encode(opened.0) != A51_PT) {
      return test.fail("plaintext " + i.to_string());
    }
    c = next;
    r = opened.1;
  }
  let exports = [hex.encode(c.export([], 32)), hex.encode(c.export([0u8], 32)), hex.encode(c.export("TestContext".as_bytes(), 32))];
  return test.assert_eq_array(exports, [
    "9b13c510416ac977b553bf1741018809c246a695f45eff6d3b0356dbefe1e660",
    "6c8b7be3a20a5684edecb4253619d9051ce8583baf850e0cb53c402bdcaf8ebb",
    "477a50d804c7c51941f69b8e32fe8288386ee1a84905fe4938d58972f24ac938",
  ]);
}

function test_p256_refusals(): test.TestOutcome {
  let pk = b(A51_PK_R);
  let off_curve = pk.with(64, pk[64] ^ 1u8);
  let n = "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551";
  let got = [
    refusal(hpke.p256_encap_derand(off_curve, b(A51_SK_E))),
    refusal(hpke.p256_encap_derand(pk[0:64], b(A51_SK_E))),
    refusal(hpke.p256_encap_derand(pk, b(n))),
    refusal(hpke.p256_encap_derand(pk, __alloc_u8(32))),
    refusal(hpke.p256_decap(p256_key(A51_IKM_R), off_curve)),
    refusal(hpke.p256_decap(p256_key(A51_IKM_R), pk[0:64])),
    refusal(hpke.p256_key(b(n))),
    refusal(hpke.p256_check_public_key(pk)),
  ];
  return test.assert_eq_array(got, [
    "hpke: the P-256 point is not on the curve",
    "hpke: the public key is 64 bytes, want 65",
    "hpke: the P-256 scalar is zero or not below n",
    "hpke: the P-256 scalar is zero or not below n",
    "hpke: the P-256 point is not on the curve",
    "hpke: the encapsulated key is 64 bytes, want 65",
    "hpke: the P-256 scalar is zero or not below n",
    "accepted",
  ]);
}

function pq256_key(): hpke.HybridP256Key {
  match (hpke.mlkem768p256_key(b(PQ256_SEED))) {
    Ok(k) => {
      return k;
    },
    Err(e) => {
      eprint(e.message());
      exit(94);
    }
  }
  return hpke.HybridP256Key { public_key: [], decapsulation_key: [], scalar: [] };
}

function test_pq256_vector(): test.TestOutcome {
  let k = pq256_key();
  if (__h(k.public_key) != PQ256_PUBLIC_KEY_HASH) {
    return test.fail("public key");
  }
  return test.assert_eq(
    match (hpke.mlkem768p256_decap(k, b(PQ256_ENC))) {
      Ok(ss) => hex.encode(ss),
      Err(e) => e.message(),
    },
    PQ256_SHARED_SECRET,
  );
}

// The keys of age-plugin-tagtest: DeriveKeyPair of "age-plugin-tagtest" for
// each KEM, as filippo.io/hpke v0.4.0 derives them.
function test_derive_tagtest(): test.TestOutcome {
  let ikm = "age-plugin-tagtest".as_bytes();
  let Ok(c) = hpke.p256_derive_key_pair(ikm) else {
    return test.fail("P-256 refused");
  };
  if (hex.encode(c.public_key) != "04b2fb753090fa3aacdbd5f209dc29e21021bd0c14c5e4b08830fe02bf94d81412e179bcd60f215f3d8274dee3fe406a17c06b09c273433fbff7312a19810e6981") {
    return test.fail("P-256 public key");
  }
  let Ok(h) = hpke.mlkem768p256_derive_key_pair(ikm) else {
    return test.fail("MLKEM768-P256 refused");
  };
  return test.assert_eq(__h(h.public_key), "8d67f829ef6168560fdbebebba1762b998682c872ac87e47f5424f61aa34c4d3");
}

function test_pq256_round_trip(): test.TestOutcome {
  let k = pq256_key();
  let Ok(e) = hpke.mlkem768p256_encap_derand(k.public_key, b(IKM_E)) else {
    return test.fail("encap refused");
  };
  let s = hpke.sender_of(hpke.KEM_MLKEM768_P256, e, b(INFO));
  let (sealed, _) = s.context.seal([], b(PT));
  let Ok(ss) = hpke.mlkem768p256_decap(k, s.enc) else {
    return test.fail("decap refused");
  };
  let r = hpke.key_schedule(hpke.KEM_MLKEM768_P256, ss, b(INFO));
  return test.assert_eq(
    match (r.open([], sealed)) {
      Ok(o) => hex.encode(o.0),
      Err(e) => e.message(),
    },
    PT,
  );
}

function test_pq256_refusals(): test.TestOutcome {
  let k = pq256_key();
  let pk = k.public_key;
  let enc = b(PQ256_ENC);
  let off_curve = pk.with(1248, pk[1248] ^ 1u8);
  let high = pk.with(0, 0xff as u8).with(1, pk[1] | 0x0f as u8);
  let got = [
    refusal(hpke.mlkem768p256_check_public_key(pk)),
    refusal(hpke.mlkem768p256_check_public_key(pk[0:1248])),
    refusal(hpke.mlkem768p256_check_public_key(off_curve)),
    refusal(hpke.mlkem768p256_check_public_key(high)),
    refusal(hpke.mlkem768p256_encap_derand(off_curve, b(IKM_E))),
    refusal(hpke.mlkem768p256_encap_derand(pk, b(IKM_E)[0:63])),
    refusal(hpke.mlkem768p256_decap(k, enc[0:1152])),
    refusal(hpke.mlkem768p256_decap(k, enc.with(1152, enc[1152] ^ 1u8))),
    refusal(hpke.mlkem768p256_key(b(PQ256_SEED)[0:31])),
  ];
  return test.assert_eq_array(got, [
    "accepted",
    "hpke: the public key is 1248 bytes, want 1249",
    "hpke: the P-256 point is not on the curve",
    "hpke: the ML-KEM-768 encapsulation key has a coefficient not below q",
    "hpke: the P-256 point is not on the curve",
    "hpke: the randomness is 63 bytes, want 64",
    "hpke: the encapsulated key is 1152 bytes, want 1153",
    "hpke: the P-256 point is not on the curve",
    "hpke: the seed is 31 bytes, want 32",
  ]);
}

function main(): i32 {
  let r = test.new("std/crypto/hpke");
  r = r.it("MLKEM768-X25519 public key of a seed", test_key);
  r = r.it("encapsulation with fixed randomness", test_encap);
  r = r.it("decapsulation", test_decap);
  r = r.it("key schedule, base nonce and export", test_key_schedule);
  r = r.it("seal with sequence numbers 0 and 1", test_seal_sequence);
  r = r.it("open in sequence", test_open_sequence);
  r = r.it("refusals on the recipient side", test_refusals);
  r = r.it("lengths and bad public keys", test_lengths);
  r = r.it("P-256 DeriveKeyPair of RFC 9180 A.5.1", test_p256_derive);
  r = r.it("P-256 encapsulation and decapsulation of RFC 9180 A.5.1", test_p256_encap_decap);
  r = r.it("P-256 seal, open and export of RFC 9180 A.5.1", test_p256_context);
  r = r.it("P-256 refusals", test_p256_refusals);
  r = r.it("MLKEM768-P256 public key and decapsulation", test_pq256_vector);
  r = r.it("MLKEM768-P256 seal and open", test_pq256_round_trip);
  r = r.it("DeriveKeyPair of the keys of age-plugin-tagtest", test_derive_tagtest);
  r = r.it("MLKEM768-P256 refusals", test_pq256_refusals);
  return r.finish();
}
