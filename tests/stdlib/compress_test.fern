import "std/test";
import "std/bzip2";
import "std/lz4";
import "std/lzw";
import "std/string";
import "std/xz";

const HELLO: string = "hello hello hello hello\n";

const BZ2: u8[] = [
  66u8, 90u8, 104u8, 57u8, 49u8, 65u8, 89u8, 38u8, 83u8, 89u8, 111u8, 79u8, 16u8, 243u8, 0u8, 0u8, 5u8, 209u8, 0u8, 0u8,
  16u8, 64u8, 0u8, 2u8, 68u8, 160u8, 0u8, 48u8, 192u8, 2u8, 168u8, 52u8, 113u8, 13u8, 173u8, 135u8, 15u8, 23u8, 114u8, 69u8,
  56u8, 80u8, 144u8, 111u8, 79u8, 16u8, 243u8,
];

const XZ: u8[] = [
  253u8, 55u8, 122u8, 88u8, 90u8, 0u8, 0u8, 4u8, 230u8, 214u8, 180u8, 70u8, 2u8, 0u8, 33u8, 1u8, 22u8, 0u8, 0u8, 0u8,
  116u8, 47u8, 229u8, 163u8, 224u8, 0u8, 23u8, 0u8, 12u8, 93u8, 0u8, 52u8, 25u8, 73u8, 238u8, 141u8, 233u8, 86u8, 10u8, 193u8,
  33u8, 176u8, 0u8, 0u8, 108u8, 20u8, 237u8, 27u8, 59u8, 104u8, 187u8, 145u8, 0u8, 1u8, 40u8, 24u8, 215u8, 131u8, 183u8, 110u8,
  31u8, 182u8, 243u8, 125u8, 1u8, 0u8, 0u8, 0u8, 0u8, 4u8, 89u8, 90u8,
];

const LZMA: u8[] = [
  93u8, 0u8, 0u8, 128u8, 0u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 0u8, 52u8, 25u8, 73u8, 238u8, 141u8,
  233u8, 86u8, 10u8, 193u8, 182u8, 32u8, 183u8, 255u8, 255u8, 186u8, 52u8, 0u8, 0u8,
];

const Z: u8[] = [31u8, 157u8, 144u8, 104u8, 202u8, 176u8, 97u8, 243u8, 6u8, 68u8, 192u8, 129u8, 5u8, 15u8, 18u8, 52u8, 40u8, 144u8, 160u8, 2u8];

const LZ4: u8[] = [
  4u8, 34u8, 77u8, 24u8, 124u8, 64u8, 24u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 12u8, 15u8, 0u8, 0u8, 0u8, 105u8, 104u8,
  101u8, 108u8, 108u8, 111u8, 32u8, 6u8, 0u8, 80u8, 101u8, 108u8, 108u8, 111u8, 10u8, 177u8, 121u8, 121u8, 109u8, 0u8,
  0u8, 0u8, 0u8, 226u8, 255u8, 3u8, 66u8,
];

function text(bytes: u8[]): string {
  return unsafe { string_from_bytes_unchecked(bytes) };
}

// The first `n` bytes of `b`.
function cut(b: u8[], n: i32): u8[] {
  let out: u8[] = [];
  for k in 0..n {
    out = out.append(b[k]);
  }
  return out;
}

// `b` with the byte at `at` changed.
function flipped(b: u8[], at: i32): u8[] {
  return b.with(at, b[at] ^ 85u8);
}

function test_round_trips(): test.TestOutcome {
  let got = [
    text(bzip2.decompress(BZ2).unwrap_or([])), text(xz.decompress_xz(XZ).unwrap_or([])), text(xz.decompress_lzma(LZMA).unwrap_or([])),
    text(lzw.decompress(Z).unwrap_or([])), text(lz4.decompress(LZ4).unwrap_or([])), text(bzip2.decompress(BZ2.concat(BZ2)).unwrap_or([])),
    text(xz.decompress_xz(XZ.concat([0u8, 0u8, 0u8, 0u8]).concat(XZ)).unwrap_or([])),
  ];
  return test.assert_eq_array(got, [HELLO, HELLO, HELLO, HELLO, HELLO, HELLO + HELLO, HELLO + HELLO]);
}

function bz_error(input: u8[]): string {
  let d = bzip2.decode(input);
  return text(d.out) + "|" + match (d.error) { Some(e) => e.message(), None => "ok" };
}

function xz_error(d: xz.Decoded): string {
  return text(d.out) + "|" + match (d.error) { Some(e) => e.message(), None => "ok" };
}

function test_errors(): test.TestOutcome {
  let got = [
    bz_error([66u8, 90u8, 105u8]), bz_error(cut(BZ2, 30)), bz_error(flipped(BZ2, 40)), bz_error(BZ2.concat([1u8, 2u8])),
    xz_error(xz.decode_xz([1u8, 2u8, 3u8, 4u8, 5u8, 6u8])), xz_error(xz.decode_xz(cut(XZ, 40))), xz_error(xz.decode_xz(flipped(XZ, 56))),
    xz_error(xz.decode_lzma(cut(LZMA, 20))), match (lzw.decompress([31u8, 157u8, 144u8, 200u8, 3u8])) { Ok(_) => "ok", Err(e) => e.message() },
    match (lzw.decompress([31u8, 139u8, 8u8])) { Ok(_) => "ok", Err(e) => e.message() },
    match (lz4.decompress(cut(LZ4, 30))) { Ok(_) => "ok", Err(e) => e.message() },
  ];
  return test.assert_eq_array(got, [
    "|not a bzip2 file", "|compressed file ends unexpectedly", HELLO + "|data integrity error when decompressing", HELLO + "|ok",
    "|File format not recognized", "|Unexpected end of input", HELLO + "|Compressed data is corrupt", "hel|Unexpected end of input",
    "corrupt input", "not in compressed format", "unexpected end of input",
  ]);
}

function report(out: u8[], error: string): string {
  return text(out) + "|" + error;
}

// Each decoder gives the bytes up to its limit, and refuses the byte after.
function test_limits(): test.TestOutcome {
  let over = "the output is larger than the limit";
  let got: string[] = [];
  for limit in [5, 23, 24] {
    let b = bzip2.decode_with_limit(BZ2, limit);
    let x = xz.decode_xz_with_limit(XZ, limit);
    let a = xz.decode_lzma_with_limit(LZMA, limit);
    let z = lzw.decode_with_limit(Z, limit);
    let f = lz4.decode_with_limit(LZ4, limit);
    got = got.append(report(b.out, match (b.error) { Some(e) => e.message(), None => "ok" }));
    got = got.append(xz_error(x));
    got = got.append(xz_error(a));
    got = got.append(report(z.out, match (z.error) { Some(e) => e.message(), None => "ok" }));
    got = got.append(report(f.out, match (f.error) { Some(e) => e.message(), None => "ok" }));
  }
  let most = "hello hello hello hello";
  let memory = "Memory usage limit reached";
  let want = [
    "hello|" + over, "hello|" + memory, "hello|" + memory, "hello|" + over, "hello|" + over,
    most + "|" + over, most + "|" + memory, most + "|" + memory, most + "|" + over, most + "|" + over,
    HELLO + "|ok", HELLO + "|ok", HELLO + "|ok", HELLO + "|ok", HELLO + "|ok",
  ];
  if (bzip2.decompress_with_limit(BZ2, 23).is_ok() || lz4.decompress_with_limit(LZ4, 23).is_ok() || lzw.decompress_with_limit(Z, 23).is_ok()) {
    return test.fail("decompress_with_limit gives bytes above the limit");
  }
  if (xz.decompress_xz_with_limit(XZ, 23).is_ok() || xz.decompress_lzma_with_limit(LZMA, 23).is_ok()) {
    return test.fail("the xz decompress_with_limit gives bytes above the limit");
  }
  return test.assert_eq_array(got, want);
}

// Streams whose counts are not valid. Each one stopped the program, or gave
// a part of the bytes as the whole.
function test_hostile_counts(): test.TestOutcome {
  // The block names six tables, and its first selector names a seventh.
  let selector = BZ2.with(25, 224u8).with(27, 63u8).with(28, 224u8);
  // The block of the frame gives its size as 2 GiB less one.
  let sized = [4u8, 34u8, 77u8, 24u8, 96u8, 64u8, 130u8, 255u8, 255u8, 255u8, 127u8, 36u8, 97u8, 98u8, 2u8, 0u8];
  let stored = sized.with(10, 255u8);
  // The header gives the size as 4 GiB and three bytes.
  let wide = LZMA.with(5, 3u8).with(6, 0u8).with(7, 0u8).with(8, 0u8).with(9, 1u8).with(10, 0u8).with(11, 0u8).with(12, 0u8);
  let got = [
    bz_error(selector),
    match (lz4.decompress(sized)) { Ok(_) => "ok", Err(e) => e.message() },
    match (lz4.decompress(stored)) { Ok(_) => "ok", Err(e) => e.message() },
    xz_error(xz.decode_lzma(wide)),
  ];
  return test.assert_eq_array(got, ["|data integrity error when decompressing", "unexpected end of input", "unexpected end of input", HELLO + "|ok"]);
}

// The CRC after the end mark of a stream combines the CRC of its blocks.
// With a changed stream CRC, the bytes of the block come, and then the error.
function test_stream_crc(): test.TestOutcome {
  let changed = BZ2.with(BZ2.len() - 1, 242u8);
  return test.assert_eq_array([bz_error(changed), bz_error(BZ2.concat(changed))], [HELLO + "|data integrity error when decompressing", HELLO + HELLO + "|data integrity error when decompressing"]);
}

function main(): i32 {
  let r = test.new("compress");
  r = r.it("round trips", test_round_trips);
  r = r.it("errors", test_errors);
  r = r.it("each decoder refuses output above a limit", test_limits);
  r = r.it("counts that are not valid are refused", test_hostile_counts);
  r = r.it("the CRC of a stream is checked", test_stream_crc);
  return r.finish();
}
