import "std/test";
import "std/f64";

function test_signum_positive(): test.TestOutcome {
  let x: f64 = 5.0;
  return test.assert_eq_f64_near(x.signum(), 1.0, 0.0);
}

function test_signum_negative(): test.TestOutcome {
  let x: f64 = 0.0 - 8.0;
  return test.assert_eq_f64_near(x.signum(), 0.0 - 1.0, 0.0);
}

function test_signum_zero(): test.TestOutcome {
  let x: f64 = 0.0;
  return test.assert_eq_f64_near(x.signum(), 0.0, 0.0);
}

function test_lerp_mid(): test.TestOutcome {
  let a: f64 = 10.0;
  return test.assert_eq_f64_near(a.lerp(20.0, 0.5), 15.0, 0.0);
}

function test_lerp_quarter(): test.TestOutcome {
  let a: f64 = 0.0;
  return test.assert_eq_f64_near(a.lerp(100.0, 0.25), 25.0, 0.0);
}

function test_lerp_endpoints(): test.TestOutcome {
  let a: f64 = 4.0;
  if (a.lerp(8.0, 0.0) != 4.0) {
    return test.fail("t=0 should give a");
  }
  return test.assert_eq_f64_near(a.lerp(8.0, 1.0), 8.0, 0.0);
}

function test_lerp_extrapolate(): test.TestOutcome {
  let a: f64 = 0.0;
  return test.assert_eq_f64_near(a.lerp(10.0, 2.0), 20.0, 0.0);
}

function test_to_radians(): test.TestOutcome {
  let d: f64 = 180.0;
  return test.assert_eq_f64_near(d.to_radians(), 3.141592653589793, 0.0001);
}

function test_to_degrees(): test.TestOutcome {
  let r: f64 = 3.141592653589793;
  return test.assert_eq_f64_near(r.to_degrees(), 180.0, 0.0001);
}

function test_deg_rad_round_trip(): test.TestOutcome {
  let d: f64 = 90.0;
  return test.assert_eq_f64_near(d.to_radians().to_degrees(), 90.0, 0.0001);
}

function test_signum_lerp_f32(): test.TestOutcome {
  if ((5.0 as f32).signum() != 1.0 as f32) {
    return test.fail("f32 signum");
  }
  if ((10.0 as f32).lerp(20.0 as f32, 0.5 as f32) != 15.0 as f32) {
    return test.fail("f32 lerp");
  }
  return test.pass();
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/f64 convert");
  r = r.it("signum positive", test_signum_positive);
  r = r.it("signum negative", test_signum_negative);
  r = r.it("signum zero", test_signum_zero);
  r = r.it("lerp mid", test_lerp_mid);
  r = r.it("lerp quarter", test_lerp_quarter);
  r = r.it("lerp endpoints", test_lerp_endpoints);
  r = r.it("lerp extrapolate", test_lerp_extrapolate);
  r = r.it("to_radians", test_to_radians);
  r = r.it("to_degrees", test_to_degrees);
  r = r.it("deg-rad round trip", test_deg_rad_round_trip);
  r = r.it("signum/lerp f32", test_signum_lerp_f32);
  return r.finish();
}
