function test_recursion_conditions(): test.TestOutcome {
  let got = [
    all("(?(foo)a|b)", "x", utf_only()),
    all("(?(<foo>)a|b)", "x", utf_only()),
    all("(?(9)a|b)", "x", utf_only()),
    all("x(?(R2)a|b)", "x", utf_only()),
    all("(?(Rfoo)a)", "x", utf_only()),
    all("(a)(?(R1)a|b(?1))", "ba", utf_only()),
    all("(?<n>a)(?(R&n)a|b)", "ba", utf_only()),
    all("(?(R&n)a)", "x", utf_only()),
  ];
  return test.assert_eq_array(got, [
    "error 3: reference to non-existent subpattern",
    "error 4: reference to non-existent subpattern",
    "error 2: reference to non-existent subpattern",
    "error 4: reference to non-existent subpattern",
    "error 3: reference to non-existent subpattern",
    "",
    "",
    "error 5: reference to non-existent subpattern",
  ]);
}

function compile_error(): pcre.CompileError {
  let Err(e) = pcre.compile("(", pcre.options()) else {
    exit(91);
  };
  return e;
}

function match_error(): pcre.MatchError {
  let Ok(re) = pcre.compile("(a+)+$", pcre.Options { ...pcre.options(), match_limit: 1 }) else {
    exit(92);
  };
  let Err(e) = re.find_at("aaaaac", 0) else {
    exit(93);
  };
  return e;
}

function compile_interfaces(): (dyn error.Error, dyn cmp.Display) {
  let e = compile_error();
  let a: dyn error.Error = e;
  let b: dyn cmp.Display = e;
  return (a, b);
}

function match_interfaces(): (dyn error.Error, dyn cmp.Display) {
  let e = match_error();
  let a: dyn error.Error = e;
  let b: dyn cmp.Display = e;
  return (a, b);
}

function error_heap_churn(): i32 {
  let total = 0;
  for i in 0..128 {
    total += i.to_string().repeat(40).len();
  }
  return total;
}

function test_compile_error_contracts(): test.TestOutcome {
  let e = compile_error();
  if (e.code != 114 || e.offset != 1 || e.message != "missing closing parenthesis") {
    return test.fail("compile error fields");
  }
  let (a, b) = compile_interfaces();
  if (error_heap_churn() != 10960) {
    return test.fail("heap churn");
  }
  let want = "PCRE2: error compiling pattern at offset 1: missing closing parenthesis";
  return test.assert_eq_array([e.message(), display_error(e), explain_error(e), a.message(), b.to_string()], [want, want, want, want, want]);
}

function test_match_error_contracts(): test.TestOutcome {
  let e = match_error();
  let (a, b) = match_interfaces();
  if (error_heap_churn() != 10960) {
    return test.fail("heap churn");
  }
  let want = "PCRE2: error matching: match limit exceeded";
  return test.assert_eq_array([e.message(), display_error(e), explain_error(e), a.message(), b.to_string()], [want, want, want, want, want]);
}

function main(): i32 {
  let r = test.new("std/pcre");
  r = r.it("literals and classes", test_literals_and_classes);
  r = r.it("repetitions", test_repetitions);
  r = r.it("groups and references", test_groups_and_references);
  r = r.it("assertions", test_assertions);
  r = r.it("options", test_options);
  r = r.it("errors", test_errors);
  r = r.it("commit, prune and skip", test_commit_prune_skip);
  r = r.it("then", test_then);
  r = r.it("accept and fail", test_accept_and_fail);
  r = r.it("verb syntax", test_verb_syntax);
  r = r.it("start options", test_start_options);
  r = r.it("calls", test_calls);
  r = r.it("callouts", test_callouts);
  r = r.it("first character", test_first_character);
  r = r.it("recursion conditions", test_recursion_conditions);
  r = r.it("match limit", test_match_limit);
  r = r.it("api", test_api);
  r = r.it("compile error contracts", test_compile_error_contracts);
  r = r.it("match error contracts", test_match_error_contracts);
  return r.finish();
}
