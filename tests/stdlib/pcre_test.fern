    "0-1 2-3",
    "error 7: assertion expected after (?( or (?(?C)",
    "0-0 1-1 2-2",
    "1-4",
    "error 3: missing closing parenthesis",
    "error 6: number after (?C is greater than 255",
    "error 3: unrecognized string delimiter follows (?C",
    "error 4: closing parenthesis for (?C expected",
    "0-1",
  ]);
}

