function test_calls(): test.TestOutcome {
  let got = [
    all("^(a|ab)(?1)c", "aabc", utf_only()),
    all("^(?1)(a|ab)c", "aabc", utf_only()),
    all("^(a+)(?1)b", "aaab", utf_only()),
    all("^(?1)(a+)b", "aaab", utf_only()),
    all("^(?R)?a", "aa", utf_only()),
    all("(a|b)(?1)", "ba", utf_only()),
    all("^((.)(?1)\\2|.?)$", "abcba abba abcd", utf_only()),
    all("^(.|(.)(?1)\\2)$", "aba abcba", utf_only()),
    all("(?1)(?:(b)|c)", "bb cb", utf_only()),
    all("^((a|b)(?1)?)c", "abac", utf_only()),
    all("^(?:(a)|b)(?1)", "ba", utf_only()),
    all("(a)(?1)+b", "aaab", utf_only()),
    all("^(?(DEFINE)(a+))(?1)ab", "aaab", utf_only()),
    all("(?<n>a|ab)(?&n)c", "aabc", utf_only()),
    all("(?P<n>a|ab)(?P>n)c", "aabc", utf_only()),
    all("^(?+1)(a|ab)c", "aabc", utf_only()),
    all("^(a|ab)(?-1)c", "aabc", utf_only()),
    all("((?1))", "a", utf_only()),
    all("(?R)", "a", utf_only()),
    all("a|(?R)", "b", utf_only()),
    all("(?R)a|b", "ba", utf_only()),
    all("(a|(?1)b)", "ab", utf_only()),
    all("(?1)(a\\1?)", "aa", utf_only()),
    all("((a)|b(?1))c", "bac", utf_only()),
    all("(a(?2)|b)(c(?1)|d)", "acbd", utf_only()),
    all("^(?:((.)(?1)|)|((?3)))", "aa", utf_only()),
    all("(?=(?R))", "a", utf_only()),
    all("(?!(?R))a", "a", utf_only()),
    all("^(\\((?:[^()]|(?1))*\\))$", "(a(b)c) (a(b)c", utf_only()),
    all("\\((?:[^()]|(?R))*\\)", "x(a(b)c)y", utf_only()),
    all("^((?:a|b)(?1)*)c", "ababc", utf_only()),
    all("(?(R)a|b(?R))", "bba", utf_only()),
    all("(?(R1)a|b(?1))", "ba", utf_only()),
    all("^(a(?1)|b)$", "aab", utf_only()),
  ];
  return test.assert_eq_array(got, [
    "0-4:0-1",
    "0-4:1-3",
    "0-4:0-2",
    "0-4:2-3",
    " PCRE2: error matching: nested recursion at the same subject position",
    "0-2:0-1",
    "",
    "",
    "0-2:1-2",
    "0-4:0-3:0-1",
    "0-2:-1--1",
    "0-4:0-1",
    "0-4:-1--1",
    "0-4:0-1",
    "0-4:0-1",
    "0-4:1-3",
    "0-4:0-1",
    " PCRE2: error matching: nested recursion at the same subject position",
    " PCRE2: error matching: nested recursion at the same subject position",
    " PCRE2: error matching: nested recursion at the same subject position",
    " PCRE2: error matching: nested recursion at the same subject position",
    "0-1:0-1 PCRE2: error matching: nested recursion at the same subject position",
    "0-2:1-2",
    "0-3:0-2:-1--1",
    "0-4:0-3:3-4",
    "0-2:0-2:0-1:-1--1",
    " PCRE2: error matching: nested recursion at the same subject position",
    " PCRE2: error matching: nested recursion at the same subject position",
