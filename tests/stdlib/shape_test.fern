// Tests of std/shape and of the GSUB lookups of std/truetype. The font and
// the glyphs that HarfBuzz gives for each case come from
// scripts/gen-shape-vectors.py.
import "std/array";
import "std/base64";
import "std/shape";
import "std/string";
import "std/test";
import "std/truetype";
import "./shape_vectors";
import "./shape_reference";

function font_of(data: string): Option[truetype.Font] {
  if let Ok(b) = base64.decode(data) {
    return truetype.parse(b);
  }
  return None;
}

function naskh(): Option[truetype.Font] {
  return font_of(shape_vectors.font());
}

function devanagari(): Option[truetype.Font] {
  return font_of(shape_vectors.deva_font());
}

// The Devanagari font with its script tag dev2 renamed dev0, so that only
// the old tag deva is left.
function old_devanagari(): Option[truetype.Font] {
  let Ok(b) = base64.decode(shape_vectors.deva_font()) else {
    return None;
  };
  let out = b;
  for i in 0..b.len() - 3 {
    if (b[i] == 100 as u8 && b[i + 1] == 101 as u8 && b[i + 2] == 118 as u8 && b[i + 3] == 50 as u8) {
      out = out.with(i + 3, 48 as u8);
    }
  }
  return truetype.parse(out);
}

function joined(xs: i32[]): string {
  return xs.map((x: i32): string => x.to_string()).join(",");
}

// The cases of the script `script` that do not give the glyphs and the
// clusters of HarfBuzz, one on each line. With `placed`, the positions of
// the glyphs must be those of HarfBuzz too.
function differences(font: Option[truetype.Font], cases: string, script: string, placed: boolean): string {
  let Some(f) = font else {
    return "the font did not parse";
  };
  let plan = shape.prepare_indic(f, script);
  if (script == "deva" && plan.is_none()) {
    return "missing Devanagari shaping plan";
  }
  let out = "";
  let count = 0;
  for line in cases.split("\n") {
    let parts = line.split("\t");
    if (parts.len() != 5 || parts[0] != script) {
      continue;
    }
    count += 1;
    let r = match (plan) { Some(p) => p.shape(parts[1]), None => shape.shape(f, parts[1], script) };
    let got = shape_reference.describe(r, placed);
    let want = parts[2] + " " + parts[3] + (if (placed) { " " + parts[4] } else { "" });
    if (got != want) {
      out = out + parts[1] + ": " + got + ", want " + want + "\n";
    }
  }
  return if (count == 0) { "no cases" } else { out };
}

function test_arabic_matches_harfbuzz(): test.TestOutcome {
  return test.assert_eq(differences(naskh(), shape_vectors.cases(), "arab", true), "");
}

function test_default_shaper_matches_harfbuzz(): test.TestOutcome {
  return test.assert_eq(differences(naskh(), shape_vectors.cases(), "latn", true), "");
}

// The Indic shaper with the script tag dev2: syllables, reph, half forms,
// below-base forms, pre-base matras, nuktas, joiners and dotted circles.
function test_devanagari_matches_harfbuzz(): test.TestOutcome {
  return test.assert_eq(differences(devanagari(), shape_vectors.deva_cases(), "deva", true), "");
}

// The same words with the rules of the old Indic specification.
function test_old_devanagari_matches_harfbuzz(): test.TestOutcome {
  return test.assert_eq(differences(old_devanagari(), shape_vectors.deva_old_cases(), "deva", true), "");
}

// The script and feature lists, and the lookups that would join a Ra and a
// virama into a reph.
function test_would_substitute(): test.TestOutcome {
  let Some(f) = devanagari() else {
    return test.fail("the font did not parse");
  };
  let (ra, ka, virama) = (f.glyph(0x930), f.glyph(0x915), f.glyph(0x94D));
  let got = [f.has_script("dev2", false), f.has_script("dev2", true), f.has_script("mlm2", false), f.has_feature("dev2", "rphf"), f.has_feature("dev2", "pref"), f.would_substitute("dev2", "rphf", [ra, virama], true), f.would_substitute("dev2", "rphf", [ka, virama], true), f.would_substitute("dev2", "rphf", [ra], true), f.would_substitute("dev2", "blwf", [virama, ra], true)];
  return test.assert_eq(got.map((b: boolean): string => if (b) { "1" } else { "0" }).join(""), "110101001");
}

// Each type and format of GSUB lookup, the flags that skip marks and
// bases, and the lookups of a context that change the count of glyphs. The
// font has no GPOS table, so HarfBuzz moves its marks by its own rules, and
// the positions do not count.
function test_each_lookup_matches_harfbuzz(): test.TestOutcome {
  return test.assert_eq(differences(font_of(shape_vectors.lookup_font()), shape_vectors.lookup_cases(), "latn", false), "");
}

// In Arabic a lookup of rclt shares the stage of calt, so it applies
// first when its index is lower. In other scripts the two share a stage
// too.
function test_rclt_shares_the_stage_of_calt(): test.TestOutcome {
  let f = font_of(shape_vectors.stage_font());
  let cases = shape_vectors.stage_cases();
  return test.assert_eq(differences(f, cases, "arab", true) + differences(f, cases, "latn", true), "");
}

// A ZWJ does not stop a ligature of liga in Latin, and stops it in
// Arabic. The font has no space, so the joiners go.
function test_joiners_in_lookups(): test.TestOutcome {
  return test.assert_eq(differences(font_of(shape_vectors.lookup_font()), shape_vectors.lookup_cases(), "arab", true), "");
}

// Each type of GPOS lookup, left to right and right to left.
function test_each_position_matches_harfbuzz(): test.TestOutcome {
  let f = font_of(shape_vectors.position_font());
  let cases = shape_vectors.position_cases();
  return test.assert_eq(differences(f, cases, "latn", true) + differences(f, cases, "arab", true), "");
}

// A font with no GDEF and no GPOS table: a character that decomposes into
// one character, a CGJ that a context skips when it keeps no marks apart,
// a mark filtering set that GDEF does not have, a ligature of the parts of
// a multiple substitution, and the marks that the fallback positioning
// places.
function test_bare_font_matches_harfbuzz(): test.TestOutcome {
  return test.assert_eq(differences(font_of(shape_vectors.bare_font()), shape_vectors.bare_cases(), "latn", true), "");
}

// An Arabic font with presentation forms and no GSUB table: the lookups of
// the Arabic fallback give the joining forms and the ligatures.
function test_arabic_fallback_matches_harfbuzz(): test.TestOutcome {
  return test.assert_eq(differences(font_of(shape_vectors.forms_font()), shape_vectors.forms_cases(), "arab", true), "");
}

// The init feature of the font holds two lookups, and the medi feature
// holds one of them too.
function test_feature_lookups(): test.TestOutcome {
  let Some(f) = naskh() else {
    return test.fail("the font did not parse");
  };
  let got = joined(f.feature_lookups("arab", "init")) + " " + joined(f.feature_lookups("arab", "medi")) + " " + joined(f.feature_lookups("cyrl", "fina")) + " " + f.feature_lookups("arab", "smcp").len().to_string();
  return test.assert_eq(got, "2,9 2,10 11 0");
}

// A font with no GSUB table gives the glyph of each character, with the
// cluster of each character.
function test_no_gsub(): test.TestOutcome {
  let Some(f) = naskh() else {
    return test.fail("the font did not parse");
  };
  let plain = truetype.Font { ...f, gsub: -1 };
  let r = shape.shape(plain, "بب", "arab");
  return test.assert_eq(joined(r.glyphs) + " " + joined(r.clusters), plain.glyph(0x628).to_string() + "," + plain.glyph(0x628).to_string() + " 0,1");
}

// The coverage range crosses bit 63 of the first word of the digest. Glyph
// 126 has the bit of 62 in that word only, and glyph 12 misses; both must
// retain their original glyph ID.
function test_prepared_coverage_range(): test.TestOutcome {
  let Some(base) = devanagari() else {
    return test.fail("the font did not parse");
  };
  let data: u8[] = [
    0, 1, 0, 0, 0, 0, 0, 0, 0, 10,  // GSUB header
    0, 1, 0, 4, 0, 1, 0, 0, 0, 1, 0, 8,  // one substitution lookup
    0, 1, 0, 6, 0, 1,  // single substitution, delta +1
    0, 2, 0, 1, 0, 62, 0, 65, 0, 0,  // coverage range 62..=65
  ];
  let font = truetype.Font { ...base, data: data, gsub: 0, gdef: -1 };
  let input = truetype.run_of([62, 63, 64, 65, 126, 12], [0, 1, 2, 3, 4, 5], [1, 1, 1, 1, 1, 1]);
  let run = font.prepare_lookup(0, false).apply(input, 1, 0);
  let ordinary = font.substitute(input, 0, 1, 0);
  // A range of 301 glyphs fills the first word of the digest. Glyph 4196
  // is in the first two words and not in the third.
  let wide_data = data.with(data.len() - 5, 100 as u8).with(data.len() - 4, 1 as u8).with(data.len() - 3, 144 as u8);
  let wide_font = truetype.Font { ...base, data: wide_data, gsub: 0, gdef: -1 };
  let wide_input = truetype.run_of([100, 400, 401, 99, 4196], [0, 1, 2, 3, 4], [1, 1, 1, 1, 1]);
  let wide = wide_font.prepare_lookup(0, false).apply(wide_input, 1, 0);
  let wide_ordinary = wide_font.substitute(wide_input, 0, 1, 0);
  let got = joined(run.glyphs) + " " + (ordinary.ops - run.ops).to_string() + " " + joined(wide.glyphs) + " " + (wide_ordinary.ops - wide.ops).to_string();
  // No glyph of this run is in the digest. The lookup tries the two glyphs
  // that the mask selects, and each one takes an attempt.
  let idle_input = truetype.run_of([12, 13, 200], [0, 1, 2], [1, 0, 1]);
  let idle = font.prepare_lookup(0, false).apply(idle_input, 1, 0);
  let idle_ordinary = font.substitute(idle_input, 0, 1, 0);
  let idle_got = joined(idle.glyphs) + " " + (idle_input.ops - idle.ops).to_string() + " " + (idle_ordinary.ops - idle.ops).to_string();
  return test.assert_eq(got + " " + joined(wide_ordinary.glyphs) + " " + idle_got, "63,64,65,66,126,12 0 101,401,401,99,4196 0 101,401,401,99,4196 12,13,200 2 0");
}

// `apply_each` gives the glyphs of one `apply` for each lookup, and takes
// the same attempts. The first run has no glyph of the coverage 62..=65, so
// the digest of the run tells that: the masks 1, 1 and 2 try 2, 2 and 1
// glyphs. In the second run the lookup applies two times. In the third run
// glyph 126 has the bit of 62 in the first word of the digest and glyph 48
// has the bit of 62 in the second word, so the digest of the run holds the
// coverage and each glyph does not. The last two runs put the first lookup
// between two of a second lookup, with the coverage 66..=67. Glyph 32830 has
// each bit of 62, so the first lookup tries it and does not apply. The
// second lookup holds no glyph each time. Glyph 65 becomes 66, which the
// second lookup holds only after that.
function sequence_result(input: truetype.Run, each: truetype.Run, one: truetype.Run): string {
  return joined(each.glyphs) + " " + (input.ops - each.ops).to_string() + " " + (one.ops - each.ops).to_string() + " " + (joined(one.glyphs) == joined(each.glyphs)).to_string() + ";";
}

function test_prepared_lookups_in_sequence(): test.TestOutcome {
  let Some(base) = devanagari() else {
    return test.fail("the font did not parse");
  };
  let data: u8[] = [
    0, 1, 0, 0, 0, 0, 0, 0, 0, 10,  // GSUB header
    0, 2, 0, 6, 0, 14,  // two lookups
    0, 1, 0, 0, 0, 1, 0, 16,  // a substitution lookup
    0, 1, 0, 0, 0, 1, 0, 24,  // a substitution lookup
    0, 1, 0, 6, 0, 1,  // single substitution, delta +1
    0, 2, 0, 1, 0, 62, 0, 65, 0, 0,  // coverage range 62..=65
    0, 1, 0, 6, 0, 1,  // single substitution, delta +1
    0, 2, 0, 1, 0, 66, 0, 67, 0, 0,  // coverage range 66..=67
  ];
  let font = truetype.Font { ...base, data: data, gsub: 0, gdef: -1 };
  let p = font.prepare_lookup(0, false);
  let q = font.prepare_lookup(1, false);
  let inputs = [
    truetype.run_of([12, 13, 200], [0, 1, 2], [1, 0, 3]),
    truetype.run_of([62, 12, 200], [0, 1, 2], [1, 1, 1]),
    truetype.run_of([126, 48], [0, 1], [1, 1]),
  ];
  let got = "";
  for input in inputs {
    let each = truetype.apply_each([p, p, p], input, [1, 1, 2], [0, 0, 0]);
    let one = p.apply(p.apply(p.apply(input, 1, 0), 1, 0), 2, 0);
    got = got + sequence_result(input, each, one);
  }
  for input in [truetype.run_of([32830, 12], [0, 1], [1, 1]), truetype.run_of([65, 12], [0, 1], [1, 1])] {
    let each = truetype.apply_each([q, p, q], input, [1, 1, 1], [0, 0, 0]);
    got = got + sequence_result(input, each, q.apply(p.apply(q.apply(input, 1, 0), 1, 0), 1, 0));
  }
  return test.assert_eq(got, "12,13,200 5 0 true;64,12,200 6 0 true;126,48 4 0 true;32830,12 6 0 true;67,12 6 0 true;");
}

// A reverse chaining substitution inside an extension lookup replaces 7
// with 8 only before another 7. Scanning from the right skips the first 7.
function test_prepared_reverse_extension(): test.TestOutcome {
  let Some(base) = devanagari() else {
    return test.fail("the font did not parse");
  };
  let data: u8[] = [
    0, 1, 0, 0, 0, 0, 0, 0, 0, 10,  // GSUB header
    0, 1, 0, 4, 0, 7, 0, 0, 0, 1, 0, 8,  // extension lookup
    0, 1, 0, 8, 0, 0, 0, 8,  // extension to a reverse chaining substitution
    0, 1, 0, 14, 0, 0, 0, 1, 0, 14, 0, 1, 0, 8,
    0, 1, 0, 1, 0, 7,  // input and lookahead coverage
  ];
  let font = truetype.Font { ...base, data: data, gsub: 0, gdef: -1 };
  let input = truetype.run_of([7, 7, 7], [0, 1, 2], [1, 1, 1]);
  let run = font.prepare_lookup(0, false).apply(input, 1, 0);
  return test.assert_eq(joined(run.glyphs), "7,8,7");
}

// A GSUB table with one lookup of the type `kind` that has `n` subtables.
// Each offset gives the same subtable, `sub`, which is after the offsets.
function gsub_of_subtables(kind: i32, n: i32, sub: u8[]): u8[] {
  let data: u8[] = [
    0, 1, 0, 0, 0, 0, 0, 0, 0, 10,  // GSUB header
    0, 1, 0, 4,  // one lookup
    0, kind as u8, 0, 0, (n >> 8) as u8, (n & 255) as u8,
  ];
  let at = 6 + 2 * n;
  for k in 0..n {
    data = data.append((at >> 8) as u8).append((at & 255) as u8);
  }
  return data.concat(sub);
}

// A GSUB table with two lookups. Lookup 0 has the type `kind` and the one
// subtable `sub`. Lookup 1 adds 100 to each glyph from 1 to 50.
function gsub_of_context(kind: i32, sub: u8[]): u8[] {
  let data: u8[] = [
    0, 1, 0, 0, 0, 0, 0, 0, 0, 10,  // GSUB header
    0, 2, 0, 6, 0, 14,  // two lookups
    0, kind as u8, 0, 0, 0, 1, 0, 32,  // lookup 0, with its subtable last
    0, 1, 0, 0, 0, 1, 0, 8,  // lookup 1
    0, 1, 0, 6, 0, 100,  // single substitution, delta +100
    0, 2, 0, 1, 0, 1, 0, 50, 0, 0,  // coverage range 1..=50
  ];
  return data.concat(sub);
}

// The glyphs of `input` after lookup 0 of a table of `gsub_of_context`,
// when `substitute` and a prepared lookup give the same glyphs.
function context_glyphs(base: truetype.Font, kind: i32, sub: u8[], input: i32[]): string {
  let font = truetype.Font { ...base, data: gsub_of_context(kind, sub), gsub: 0, gdef: -1 };
  let clusters: i32[] = [];
  let masks: i32[] = [];
  for k in 0..input.len() {
    clusters = clusters.append(k);
    masks = masks.append(1);
  }
  let run = truetype.run_of(input, clusters, masks);
  let plain = joined(font.substitute(run, 0, 1, 0).glyphs);
  let prepared = joined(font.prepare_lookup(0, false).apply(run, 1, 0).glyphs);
  return if (plain == prepared) { plain } else { plain + " != " + prepared };
}

// A context and a chaining context find the parts of a rule in each format.
// Each rule applies lookup 1 at one glyph of its input. A rule does not
// apply when its input, the glyph before it or the glyph after it is not
// there.
function test_context_formats(): test.TestOutcome {
  let Some(base) = devanagari() else {
    return test.fail("the font did not parse");
  };
  // Format 1: glyph 5 then glyph 6, and lookup 1 at the second glyph.
  let glyphs: u8[] = [
    0, 1, 0, 8, 0, 1, 0, 14,
    0, 1, 0, 1, 0, 5,  // coverage: 5
    0, 1, 0, 4,  // one rule
    0, 2, 0, 1, 0, 6, 0, 1, 0, 1,
  ];
  // Format 3: a coverage of 5 then a coverage of 6, and lookup 1 at the
  // first glyph.
  let coverages: u8[] = [
    0, 3, 0, 2, 0, 1, 0, 14, 0, 20, 0, 0, 0, 1,
    0, 1, 0, 1, 0, 5,
    0, 1, 0, 1, 0, 6,
  ];
  // Chaining format 3: glyph 5 after glyph 8 and before glyph 6.
  let chained_coverages: u8[] = [
    0, 3, 0, 1, 0, 20, 0, 1, 0, 26, 0, 1, 0, 32, 0, 1, 0, 0, 0, 1,
    0, 1, 0, 1, 0, 8,
    0, 1, 0, 1, 0, 5,
    0, 1, 0, 1, 0, 6,
  ];
  // Chaining format 1: glyphs 5 and 6 after glyph 8 and before glyph 7, and
  // lookup 1 at the second glyph.
  let chained_glyphs: u8[] = [
    0, 1, 0, 8, 0, 1, 0, 14,
    0, 1, 0, 1, 0, 5,  // coverage: 5
    0, 1, 0, 4,  // one rule
    0, 1, 0, 8, 0, 2, 0, 6, 0, 1, 0, 7, 0, 1, 0, 1, 0, 1,
  ];
  // Chaining format 2: the same rule with the classes 1 to 4 for the glyphs
  // 5 to 8.
  let chained_classes: u8[] = [
    0, 2, 0, 16, 0, 22, 0, 22, 0, 22, 0, 2, 0, 0, 0, 36,
    0, 1, 0, 1, 0, 5,  // coverage: 5
    0, 1, 0, 5, 0, 4, 0, 1, 0, 2, 0, 3, 0, 4,  // classes
    0, 1, 0, 4,  // one rule for class 1
    0, 1, 0, 4, 0, 2, 0, 2, 0, 1, 0, 3, 0, 1, 0, 1, 0, 1,
  ];
  let got = context_glyphs(base, 5, glyphs, [5, 6, 5, 7, 5]) + " " + context_glyphs(base, 5, coverages, [5, 6, 5, 7, 5]);
  got = got + " " + context_glyphs(base, 6, chained_coverages, [5, 6, 8, 5, 6, 8, 5, 7, 8, 5]);
  got = got + " " + context_glyphs(base, 6, chained_glyphs, [5, 6, 7, 8, 5, 6, 7, 8, 5, 6, 6, 8, 5, 6]);
  got = got + " " + context_glyphs(base, 6, chained_classes, [5, 6, 7, 8, 5, 6, 7, 8, 5, 6, 6, 8, 5, 6]);
  return test.assert_eq(got, "5,106,5,7,5 105,6,5,7,5 5,6,8,105,6,8,5,7,8,5 5,6,7,8,5,106,7,8,5,6,6,8,5,6 5,6,7,8,5,106,7,8,5,6,6,8,5,6");
}

// A lookup can declare 65535 subtables. Each 64 subtables that a glyph
// examines take one from the attempts of the run, as the glyph does, so a
// font cannot make each attempt examine them for nothing.
function test_subtables_take_from_the_attempts(): test.TestOutcome {
  let Some(base) = devanagari() else {
    return test.fail("the font did not parse");
  };
  let input = truetype.run_of([7, 7, 7], [0, 1, 2], [1, 1, 1]);
  // A single substitution with the delta 1, for glyph 9 only.
  let single: u8[] = [0, 1, 0, 6, 0, 1, 0, 1, 0, 1, 0, 9];
  let forward = truetype.Font { ...base, data: gsub_of_subtables(1, 640, single), gsub: 0, gdef: -1 };
  let f = forward.substitute(input, 0, 1, 0);
  // A reverse chaining substitution with no context, for glyph 9 only.
  let chained: u8[] = [0, 1, 0, 10, 0, 0, 0, 0, 0, 0, 0, 1, 0, 1, 0, 9];
  let reverse = truetype.Font { ...base, data: gsub_of_subtables(8, 640, chained), gsub: 0, gdef: -1 };
  let r = reverse.substitute(input, 0, 1, 0);
  return test.assert_eq(joined(f.glyphs) + " " + (input.ops - f.ops).to_string() + " " + joined(r.glyphs) + " " + (input.ops - r.ops).to_string(), "7,7,7 33 7,7,7 33");
}

// Each start of the bytes of the font parses, or gives None, and each
// font that parses shapes a word with no crash.
function test_a_cut_font_does_not_crash(): test.TestOutcome {
  let Ok(data) = base64.decode(shape_vectors.font()) else {
    return test.fail("the font did not decode");
  };
  let shaped = 0;
  let n = 0;
  while (n <= data.len()) {
    if let Some(f) = truetype.parse(data.take(n)) {
      shaped += shape.shape(f, "السَّلَامُ", "arab").glyphs.len();
    }
    n += 997;
  }
  return test.assert_eq(shaped > 0, true);
}

// The class table of `with_glyph_classes` holds the class that GDEF gives
// each glyph, and a font with no GDEF table has no class table.
function test_glyph_classes_match_gdef(): test.TestOutcome {
  let Some(f) = devanagari() else {
    return test.fail("the font did not parse");
  };
  let classes = f.with_glyph_classes().classes;
  let seen = [0, 0, 0, 0];
  let wrong = 0;
  for g in 0..classes.len() {
    let c = f.glyph_class(g);
    if (classes[g] as i32 != c) {
      wrong += 1;
    }
    if (c < 4) {
      seen = seen.with(c, seen[c] + 1);
    }
  }
  let bare = truetype.Font { ...f, gdef: -1 };
  let got = [classes.len() == f.glyphs, wrong == 0, seen[1] > 0, seen[3] > 0, bare.with_glyph_classes().classes.len() == 0];
  return test.assert_eq(got.map((b: boolean): string => if (b) { "1" } else { "0" }).join(""), "11111");
}

function main(): i32 {
  let r = test.new("std/shape");
  r = r.it("Arabic words give the glyphs of HarfBuzz", test_arabic_matches_harfbuzz);
  r = r.it("the default shaper gives the glyphs of HarfBuzz", test_default_shaper_matches_harfbuzz);
  r = r.it("Devanagari words give the glyphs of HarfBuzz", test_devanagari_matches_harfbuzz);
  r = r.it("the old Indic specification gives the glyphs of HarfBuzz", test_old_devanagari_matches_harfbuzz);
  r = r.it("would_substitute finds the reph and the below-base forms", test_would_substitute);
  r = r.it("each type of lookup gives the glyphs of HarfBuzz", test_each_lookup_matches_harfbuzz);
  r = r.it("each type of GPOS lookup gives the positions of HarfBuzz", test_each_position_matches_harfbuzz);
  r = r.it("rclt shares the stage of calt", test_rclt_shares_the_stage_of_calt);
  r = r.it("a font with no GDEF and no GPOS table gives the glyphs of HarfBuzz", test_bare_font_matches_harfbuzz);
  r = r.it("an Arabic font with no GSUB table takes the forms of HarfBuzz", test_arabic_fallback_matches_harfbuzz);
  r = r.it("the joiners stop a ligature as in HarfBuzz", test_joiners_in_lookups);
  r = r.it("feature_lookups reads the script and the feature lists", test_feature_lookups);
  r = r.it("a font with no GSUB table gives one glyph for each character", test_no_gsub);
  r = r.it("a cut font does not crash", test_a_cut_font_does_not_crash);
  r = r.it("prepared extension lookups preserve reverse chaining order", test_prepared_reverse_extension);
  r = r.it("a context finds the parts of a rule in each format", test_context_formats);
  r = r.it("the subtables of a lookup take from the attempts of the run", test_subtables_take_from_the_attempts);
  r = r.it("prepared lookups in sequence take the attempts of each one alone", test_prepared_lookups_in_sequence);
  r = r.it("prepared coverage preserves matches, collisions and the operation budget", test_prepared_coverage_range);
  r = r.it("with_glyph_classes gives the class of each glyph in GDEF", test_glyph_classes_match_gdef);
  return r.finish();
}
