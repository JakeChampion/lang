import "std/test";
import "core/int";
import "std/hex";
import "std/tls/message";

// tests/stdlib/tls_message_test.fern — std/tls/message against the
// handshake messages of RFC 8448 §3: each decodes and re-encodes to the
// same bytes, its fields read back, the ClientHello is rebuilt from the
// extension encoders, and every refusal has a case.

function client_hello(): u8[] {
  return hex.hex_decode("");
}

function server_hello(): u8[] {
  return hex.hex_decode("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304");
}

function encrypted_extensions(): u8[] {
  return hex.hex_decode("080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000");
}

function certificate(): u8[] {
  return hex.hex_decode("");
}

function certificate_verify(): u8[] {
  return hex.hex_decode("0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3");
}

function server_finished(): u8[] {
  return hex.hex_decode("140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718");
}

function client_finished(): u8[] {
  return hex.hex_decode("14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61");
}

function new_session_ticket(): u8[] {
  return hex.hex_decode("");
}

function one(b: u8[]): message.Raw {
  return message.Raw { kind: b[0] as i32, bytes: b };
}

// raw frames a body with its header.
function raw(kind: i32, body: string): message.Raw {
  let b: u8[] = hex.hex_decode(body);
  let out: u8[] = [kind as u8, (b.len() >> 16 & 255) as u8, (b.len() >> 8 & 255) as u8, (b.len() & 255) as u8];
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return message.Raw { kind: kind, bytes: out };
}

function cat(a: u8[], b: u8[]): u8[] {
  let out: u8[] = a;
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

function refusal(r: Result[message.Message, message.MsgError]): string {
  match (r) {
    Ok(m) => {
      return "accepted";
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function decoded(b: u8[]): message.Message {
  match (message.decode(one(b))) {
    Ok(m) => {
      return m;
    },
    Err(e) => {
      return message.Finished([]);
    }
  }
  return message.Finished([]);
}

function hexes(v: i32[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < v.len()) {
    out = out + " " + int.int_to_string(v[i]);
    i = i + 1;
  }
  return out;
}

function test_round_trip(): test.TestOutcome {
  let all: u8[][] = [client_hello(), server_hello(), encrypted_extensions(), certificate(), certificate_verify(), server_finished(), client_finished(), new_session_ticket()];
  let i: i32 = 0;
  while (i < all.len()) {
    match (message.decode(one(all[i]))) {
      Ok(m) => {
        if (hex.hex_encode(message.encode(m)) != hex.hex_encode(all[i])) {
          return test.fail("message " + int.int_to_string(i) + " re-encodes differently");
        }
        if (m.kind() != all[i][0] as i32) {
          return test.fail("message " + int.int_to_string(i) + " kind");
        }
      },
      Err(e) => {
        return test.fail("message " + int.int_to_string(i) + ": " + e.message());
      }
    }
    i = i + 1;
  }
  return test.pass();
}

function test_client_hello_fields(): test.TestOutcome {
  match (decoded(client_hello())) {
    message.ClientHelloMsg(h) => {
      if (hex.hex_encode(h.random) != "cb34ecb1e78163ba1c38c6dacb196a6dffa21a8d9912ec18a2ef6283024dece7" || h.session_id.len() != 0) {
        return test.fail("random and session id");
      }
      if (hexes(h.cipher_suites) != " 4865 4867 4866") {
        return test.fail("cipher suites");
      }
      let kinds: i32[] = [];
      let i: i32 = 0;
      while (i < h.extensions.len()) {
        kinds = kinds.append(h.extensions[i].kind);
        i = i + 1;
      }
      if (hexes(kinds) != " 0 65281 10 35 51 43 13 45 28") {
        return test.fail("extension kinds" + hexes(kinds));
      }
      match (message.find(h.extensions, message.EXT_SERVER_NAME)) {
        Some(d) => {
          match (message.server_name(d)) {
            Ok(name) => {
              if (name != "server") {
                return test.fail(name);
              }
            },
            Err(e) => {
              return test.fail(e.message());
            }
          }
        },
        None => {
          return test.fail("no server_name");
        }
      }
      match (message.find(h.extensions, message.EXT_KEY_SHARE)) {
        Some(d) => {
          match (message.key_shares(d)) {
            Ok(shares) => {
              if (shares.len() != 1 || shares[0].group != 0x001d || hex.hex_encode(shares[0].key) != "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c") {
                return test.fail("key share");
              }
            },
            Err(e) => {
              return test.fail(e.message());
            }
          }
        },
        None => {
          return test.fail("no key_share");
        }
      }
      match (message.find(h.extensions, message.EXT_SUPPORTED_VERSIONS)) {
        Some(d) => {
          match (message.supported_versions(d)) {
            Ok(v) => {
              return test.assert_eq(hexes(v), " 772");
            },
            Err(e) => {
              return test.fail(e.message());
            }
          }
        },
        None => {
          return test.fail("no supported_versions");
        }
      }
    },
    _ => {
      return test.fail("not a ClientHello");
    }
  }
  return test.fail("unreachable");
}

function test_server_hello_fields(): test.TestOutcome {
  match (decoded(server_hello())) {
    message.ServerHelloMsg(h) => {
      if (h.cipher_suite != 0x1301 || h.is_retry()) {
        return test.fail("cipher suite");
      }
      match (message.find(h.extensions, message.EXT_KEY_SHARE)) {
        Some(d) => {
          match (message.key_share(d)) {
            Ok(e) => {
              if (e.group != 0x001d || hex.hex_encode(e.key) != "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f") {
                return test.fail("key share");
              }
            },
            Err(e) => {
              return test.fail(e.message());
            }
          }
        },
        None => {
          return test.fail("no key_share");
        }
      }
      match (message.find(h.extensions, message.EXT_SUPPORTED_VERSIONS)) {
        Some(d) => {
          match (message.selected_version(d)) {
            Ok(v) => {
              return test.assert_eq(v, message.TLS13);
            },
            Err(e) => {
              return test.fail(e.message());
            }
          }
        },
        None => {
          return test.fail("no supported_versions");
        }
      }
    },
    _ => {
      return test.fail("not a ServerHello");
    }
  }
  return test.fail("unreachable");
}

function test_server_flight_fields(): test.TestOutcome {
  match (decoded(encrypted_extensions())) {
    message.EncryptedExtensions(e) => {
      match (message.find(e, message.EXT_SUPPORTED_GROUPS)) {
        Some(d) => {
          match (message.supported_groups(d)) {
            Ok(g) => {
              if (hexes(g) != " 29 23 24 25 256 257 258 259 260") {
                return test.fail("supported_groups" + hexes(g));
              }
            },
            Err(err) => {
              return test.fail(err.message());
            }
          }
        },
        None => {
          return test.fail("no supported_groups");
        }
      }
    },
    _ => {
      return test.fail("not EncryptedExtensions");
    }
  }
  match (decoded(certificate())) {
    message.CertificateMsg(c) => {
      if (c.context.len() != 0 || c.entries.len() != 1 || c.entries[0].data.len() != 432 || c.entries[0].extensions.len() != 0) {
        return test.fail("certificate");
      }
    },
    _ => {
      return test.fail("not a Certificate");
    }
  }
  match (decoded(certificate_verify())) {
    message.CertificateVerifyMsg(v) => {
      if (v.scheme != 0x0804 || v.signature.len() != 128) {
        return test.fail("certificate verify");
      }
    },
    _ => {
      return test.fail("not a CertificateVerify");
    }
  }
  match (decoded(new_session_ticket())) {
    message.NewSessionTicketMsg(t) => {
      if (t.nonce.len() != 2 || t.ticket.len() != 178 || t.extensions.len() != 1) {
        return test.fail("ticket");
      }
    },
    _ => {
      return test.fail("not a NewSessionTicket");
    }
  }
  match (decoded(server_finished())) {
    message.Finished(v) => {
      return test.assert_eq(hex.hex_encode(v), "9b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718");
    },
    _ => {
      return test.fail("not Finished");
    }
  }
  return test.fail("unreachable");
}

// The trace's ClientHello rebuilt from the encoders, with the three
// extensions TLS 1.3 does not read written raw.
function test_build_client_hello(): test.TestOutcome {
  let share: message.KeyShareEntry = message.KeyShareEntry { group: 0x001d, key: hex.hex_decode("99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c") };
  let exts: message.Extension[] = [
    message.ext_server_name("server"),
    message.Extension { kind: 0xff01, data: [0 as u8] },
    message.ext_supported_groups([0x001d, 0x0017, 0x0018, 0x0019, 0x0100, 0x0101, 0x0102, 0x0103, 0x0104]),
    message.Extension { kind: 0x0023, data: [] },
    message.ext_key_shares([share]),
    message.ext_supported_versions([message.TLS13]),
    message.ext_signature_algorithms([0x0403, 0x0503, 0x0603, 0x0203, 0x0804, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601, 0x0201, 0x0402, 0x0502, 0x0602, 0x0202]),
    message.ext_psk_modes([1]),
    message.Extension { kind: 0x001c, data: [0x40 as u8, 0x01 as u8] },
  ];
  let h: message.ClientHello = message.ClientHello { random: hex.hex_decode("cb34ecb1e78163ba1c38c6dacb196a6dffa21a8d9912ec18a2ef6283024dece7"), session_id: [], cipher_suites: [0x1301, 0x1303, 0x1302], extensions: exts };
  return test.assert_eq(hex.hex_encode(message.encode(message.ClientHelloMsg(h))), hex.hex_encode(client_hello()));
}

function test_build_server_extensions(): test.TestOutcome {
  if (hex.hex_encode(message.ext_selected_version(message.TLS13).data) != "0304") {
    return test.fail("selected version");
  }
  if (hex.hex_encode(message.ext_retry_group(0x11ec).data) != "11ec") {
    return test.fail("retry group");
  }
  if (hex.hex_encode(message.ext_alpn(["h2", "http/1.1"]).data) != "000c02683208687474702f312e31") {
    return test.fail("alpn");
  }
  match (message.alpn(hex.hex_decode("000c02683208687474702f312e31"))) {
    Ok(p) => {
      if (p.len() != 2 || p[0] != "h2" || p[1] != "http/1.1") {
        return test.fail("alpn read");
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.assert_eq(hex.hex_encode(message.encode(message.KeyUpdate(true))), "1800000101");
}

function test_split(): test.TestOutcome {
  let flight: u8[] = cat(cat(cat(encrypted_extensions(), certificate()), certificate_verify()), server_finished());
  match (message.split(flight)) {
    Ok(s) => {
      if (s.messages.len() != 4 || s.rest.len() != 0 || s.messages[3].kind != message.FINISHED) {
        return test.fail("whole flight");
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  match (message.split(flight.take(100))) {
    Ok(s) => {
      return test.assert_eq(int.int_to_string(s.messages.len()) + " " + int.int_to_string(s.rest.len()), "1 60");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function split_refusal(b: string): string {
  match (message.split(hex.hex_decode(b))) {
    Ok(s) => {
      return "accepted";
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

// A bad header is refused before its body arrives.
function test_split_refusals(): test.TestOutcome {
  if (split_refusal("03000004") != "tls message: unknown handshake message type 3") {
    return test.fail("unknown type");
  }
  if (split_refusal("14010001") != "tls message: a type 20 message of 65537 bytes is over the limit") {
    return test.fail("too large");
  }
  if (split_refusal("0b040001") != "tls message: a type 11 message of 262145 bytes is over the limit") {
    return test.fail("too large a Certificate");
  }
  // A Certificate of exactly 2^18 bytes is waited for.
  return test.assert_eq(split_refusal("0b040000"), "accepted");
}

function test_refusals(): test.TestOutcome {
  let ch: u8[] = client_hello();
  let n: i32 = ch.len();
  // One byte short of what the header claims.
  if (refusal(message.decode(message.Raw { kind: 1, bytes: ch.take(n - 1) })) != "tls message: malformed ClientHello extensions") {
    return test.fail("truncated");
  }
  // One byte past the extensions, the header grown to cover it.
  let long: u8[] = cat(ch.with(3, ch[3] + 1 as u8), [0 as u8]);
  if (refusal(message.decode(one(long))) != "tls message: malformed ClientHello") {
    return test.fail("trailing byte");
  }
  if (refusal(message.decode(one(ch.with(4, 3 as u8).with(5, 1 as u8)))) != "tls message: legacy_version 769 is not TLS 1.2's") {
    return test.fail("legacy_version");
  }
  // The single compression method, after the header, version, random,
  // empty session id, three suites and its own count, made 1.
  if (refusal(message.decode(one(ch.with(48, 1 as u8)))) != "tls message: illegal legacy_compression_methods") {
    return test.fail("compression");
  }
  if (refusal(message.decode(raw(8, "00080000000000000000"))) != "tls message: illegal repeated extension 0") {
    return test.fail("repeated extension");
  }
  if (refusal(message.decode(raw(24, "02"))) != "tls message: illegal request_update") {
    return test.fail("request_update");
  }
  if (refusal(message.decode(raw(3, ""))) != "tls message: unknown handshake message type 3") {
    return test.fail("unknown type");
  }
  match (message.key_shares(hex.hex_decode("000a001d000101001d000102"))) {
    Ok(s) => {
      return test.fail("repeated key share accepted");
    },
    Err(e) => {
      return test.assert_eq(e.message(), "tls message: illegal repeated key share 29");
    }
  }
  return test.fail("unreachable");
}

function test_retry(): test.TestOutcome {
  let h: message.ServerHello = message.ServerHello { random: hex.hex_decode("cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c"), session_id: [], cipher_suite: 0x1301, extensions: [message.ext_selected_version(message.TLS13), message.ext_retry_group(0x11ec)] };
  match (decoded(message.encode(message.ServerHelloMsg(h)))) {
    message.ServerHelloMsg(back) => {
      return test.assert_eq(back.is_retry(), true);
    },
    _ => {
      return test.fail("not a ServerHello");
    }
  }
  return test.fail("unreachable");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/tls/message");
  r = r.it("RFC 8448 messages round trip", test_round_trip);
  r = r.it("ClientHello fields", test_client_hello_fields);
  r = r.it("ServerHello fields", test_server_hello_fields);
  r = r.it("the server's flight", test_server_flight_fields);
  r = r.it("build the ClientHello", test_build_client_hello);
  r = r.it("server extensions and KeyUpdate", test_build_server_extensions);
  r = r.it("split", test_split);
  r = r.it("split refusals", test_split_refusals);
  r = r.it("refusals", test_refusals);
  r = r.it("HelloRetryRequest", test_retry);
  return r.finish();
}
