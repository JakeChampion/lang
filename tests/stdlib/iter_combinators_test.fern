import "std/test";
import "core/iter" as iter;

// tests/stdlib/iter_combinators_test.fern — pure-Fern coverage of the
// core/iter combinators NOT already in iter_test (which does sum / count / of /
// product / nth / last / min / max / contains / count / fold / any / all /
// map / filter): collect, take, skip, flat_map, find, index_of, position,
// count_where. The Go-side suite unit-tests these; this is the migration-shaped
// (pure-Fern, std/test-driven, self-host-gated) companion.

function test_collect(): test.TestOutcome {
  return test.assert_eq_array(iter.range(0, 4).collect(), [0, 1, 2, 3]);
}

function test_take(): test.TestOutcome {
  let xs: i32[] = [1, 2, 3, 4, 5];
  return test.assert_eq_array(iter.of(xs).take(3).collect(), [1, 2, 3]);
}

function test_skip(): test.TestOutcome {
  let xs: i32[] = [1, 2, 3, 4, 5];
  return test.assert_eq_array(iter.of(xs).skip(2).collect(), [3, 4, 5]);
}

function test_skip_past_end(): test.TestOutcome {
  return test.assert_eq(iter.range(0, 3).skip(10).len(), 0);
}

function test_flat_map(): test.TestOutcome {
  let words: string[] = ["ab", "", "c"];
  let out: string[] = iter.of(words).flat_map((w: string): string[] => {
    if (w.len() == 0) {
      let none: string[] = [];
      return none;
    }
    return [w, w + "!"];
  }).collect();
  return test.assert_eq_array(out, ["ab", "ab!", "c", "c!"]);
}

function test_flat_map_after_skip(): test.TestOutcome {
  let fanned: i32[] = iter.range(0, 4).skip(1).flat_map((x: i32): i32[] => [x, x * 10]).take(5).collect();
  return test.assert_eq_array(fanned, [1, 10, 2, 20, 3]);
}

function test_find(): test.TestOutcome {
  match (iter.range(0, 10).find((x: i32): boolean => x > 5)) {
    Some(v) => {
      return test.assert_eq(v, 6);
    },
    None => {
      return test.fail("find expected Some(6)");
    }
  }
}

function test_find_miss(): test.TestOutcome {
  match (iter.range(0, 5).find((x: i32): boolean => x > 99)) {
    Some(v) => {
      return test.fail("expected None");
    },
    None => {
      return test.pass();
    }
  }
}

function test_index_of(): test.TestOutcome {
  match (iter.index_of(iter.range(0, 10), 7)) {
    Some(v) => {
      return test.assert_eq(v, 7);
    },
    None => {
      return test.fail("index_of expected Some(7)");
    }
  }
}

function test_position(): test.TestOutcome {
  let xs: i32[] = [10, 20, 30];
  match (iter.position(iter.of(xs), (x: i32): boolean => x == 20)) {
    Some(v) => {
      return test.assert_eq(v, 1);
    },
    None => {
      return test.fail("position expected Some(1)");
    }
  }
}

function test_position_miss(): test.TestOutcome {
  let xs: i32[] = [10, 20, 30];
  match (iter.position(iter.of(xs), (x: i32): boolean => x > 99)) {
    Some(v) => {
      return test.fail("position expected None");
    },
    None => {
      return test.pass();
    }
  }
}

function test_count_where(): test.TestOutcome {
  let xs: i32[] = [1, 2, 3, 4, 5, 6];
  return test.assert_eq(iter.count_where(iter.of(xs), (x: i32): boolean => x % 2 == 0), 3);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("core/iter combinators");
  r = r.it("collect", test_collect);
  r = r.it("take", test_take);
  r = r.it("skip", test_skip);
  r = r.it("skip past the end", test_skip_past_end);
  r = r.it("flat_map", test_flat_map);
  r = r.it("flat_map after skip", test_flat_map_after_skip);
  r = r.it("find", test_find);
  r = r.it("find miss", test_find_miss);
  r = r.it("index_of", test_index_of);
  r = r.it("position", test_position);
  r = r.it("position miss", test_position_miss);
  r = r.it("count_where", test_count_where);
  return r.finish();
}
