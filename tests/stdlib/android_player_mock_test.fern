import "std/android";
import "std/android/player";

@import("libandroid.so", "mock_player_context")
function context(): usize;

@import("libandroid.so", "mock_player_mode")
function mode(value: i32): void;

@import("libandroid.so", "mock_player_live")
function live(): i32;

@import("libandroid.so", "mock_player_pending")
function pending(): i32;

@import("libandroid.so", "mock_player_releases")
function releases(): i32;

@import("libandroid.so", "mock_player_opens")
function opens(): i32;

@import("libandroid.so", "mock_player_prepares")
function prepares(): i32;

@import("libandroid.so", "mock_player_seek")
function seek_time(): i64;

@import("libandroid.so", "mock_player_window")
function window(): usize;

const CLASS: string = "dev.fern.playertest.Listener";

function creation(ctx: usize): i32 {
  for error in [1, 2, 3, 4, 5, 6, 7, 8, 9, 17] {
    mode(error);
    let before = releases();
    match (player.new(ctx, CLASS)) {
      None => {},
      _ => {
        return 101;
      }
    }
    if (live() != 0) {
      return 102;
    }
    if (pending() != (if (error == 9) { 1 } else { 0 })) {
      return 103;
    }
    if (error >= 3 && error <= 7 && releases() != before + 1) {
      return 104;
    }
  }
  return 0;
}

function operations(ctx: usize): i32 {
  mode(0);
  let Some(p) = player.new(ctx, CLASS) else {
    return 201;
  };
  if (live() != 2) {
    return 202;
  }
  if (!player.open(ctx, p, "/mock.mp4") || !player.show(ctx, p, android.Window { ptr: window() })) {
    return 203;
  }
  if (!player.start(ctx, p) || !player.playing(ctx, p) || !player.pause(ctx, p)) {
    return 204;
  }
  for _ in 0..5000 {
    if (player.position_ms(ctx, p) != 1234i64 || player.duration_ms(ctx, p) != 4000i64 || player.video_size(ctx, p) != (320, 240)) {
      return 205;
    }
    let Some(t) = player.timestamp(ctx, p) else {
      return 206;
    };
    if (t.media_us != 1234000i64 || t.monotonic_ns != 9876543210i64 || live() != 2) {
      return 207;
    }
  }
  if (player.seek(ctx, p, -1i64) || player.seek(ctx, p, 2147483648i64) || !player.seek(ctx, p, 2147483647i64) || seek_time() != 2147483647i64) {
    return 208;
  }
  let before = opens();
  let prepared = prepares();
  for uri in ["", "bad\x00uri"] {
    if (player.open(ctx, p, uri)) {
      return 209;
    }
  }
  if (opens() != before || prepares() != prepared) {
    return 210;
  }
  for error in [10, 12] {
    mode(error);
    if (player.open(ctx, p, "/mock.mp4") || pending() != 0 || opens() != before || prepares() != prepared || live() != 2) {
      return 211;
    }
  }
  mode(11);
  if (player.start(ctx, p) || pending() != 0 || live() != 2) {
    return 212;
  }
  mode(17);
  if (player.start(ctx, p) || pending() != 0 || live() != 2) {
    return 213;
  }
  for error in [13, 14, 15] {
    mode(error);
    match (player.timestamp(ctx, p)) {
      None => {},
      _ => {
        return 214;
      }
    }
    if (pending() != 0 || live() != 2) {
      return 215;
    }
  }
  mode(18);
  if (player.duration_ms(ctx, p) != 0i64 || pending() != 0 || live() != 2) {
    return 216;
  }
  mode(21);
  if (player.show(ctx, p, android.Window { ptr: window() }) || pending() != 0 || live() != 2) {
    return 217;
  }
  mode(0);
  player.hide(ctx, p);
  player.stop(ctx, p);
  mode(16);
  player.close(ctx, p);
  if (pending() != 0 || live() != 0) {
    return 218;
  }
  return 0;
}

function content_sources(ctx: usize): i32 {
  mode(0);
  let Some(p) = player.new(ctx, CLASS) else {
    return 301;
  };
  for uri in ["/mock.mp4", "file:///mock.mp4", "https://example.test/movie.mp4", "content://media/external/video/media/7"] {
    if (!player.open(ctx, p, uri) || pending() != 0 || live() != 2) {
      return 302;
    }
  }
  for _ in 0..256 {
    if (!player.open(ctx, p, "content://media/external/video/media/7") || live() != 2) {
      return 303;
    }
  }
  let before = opens();
  let prepared = prepares();
  for error in [22, 23, 24, 25] {
    mode(error);
    if (player.open(ctx, p, "content://media/external/video/media/7") || opens() != before || prepares() != prepared || pending() != 0 || live() != 2) {
      return 304;
    }
  }
  mode(26);
  if (player.open(ctx, p, "content://media/external/video/media/7") || opens() != before + 1 || prepares() != prepared || pending() != 0 || live() != 2) {
    return 305;
  }
  mode(0);
  if (!player.open(ctx, p, "content://media/external/video/media/7")) {
    return 306;
  }
  player.close(ctx, p);
  if (pending() != 0 || live() != 0) {
    return 307;
  }
  return 0;
}

function main(): i32 {
  let ctx = context();
  let result = creation(ctx);
  if (result != 0) {
    return result;
  }
  result = operations(ctx);
  if (result != 0) {
    return result;
  }
  return content_sources(ctx);
}
