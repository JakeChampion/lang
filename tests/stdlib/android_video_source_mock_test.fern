import "std/android/video/source";
import "std/video/frame";
import "android_content_file_check";

@import("libandroid.so", "mock_source_env")
function env(): usize;

@import("libandroid.so", "mock_source_context")
function context(): usize;

@import("libandroid.so", "mock_source_mode")
function mode(value: i32): void;

@import("libandroid.so", "mock_source_clean")
function clean(): i32;

@import("libandroid.so", "mock_source_closed")
function closed(): i32;

@import("libandroid.so", "mock_source_descriptors")
function descriptors(): i32;

@import("libandroid.so", "mock_source_verify")
function verify(fd: i32, offset: i64, length: i64): i32;

function errors(e: usize, ctx: usize): i32 {
  for value in 1..21 {
    mode(value);
    let before = descriptors();
    let expected_error = match (value) { 15 => frame.Header, 16 => frame.Header, 17 => frame.Truncated, 18 => frame.Unsupported, _ => frame.Platform };
    match (source.open(e, ctx, "content://mock/video", 40i64)) {
      Err(error) => {
        if (error != expected_error) {
          return 600 + value;
        }
      },
      Ok(src) => {
        let _ = src.close();
        return 100 + value;
      }
    }
    if (clean() != 1 || descriptors() != before) {
      return 200 + value;
    }
    let expected = if (value >= 11) { 1 } else { 0 };
    if (closed() != expected) {
      return 300 + value;
    }
  }
  mode(0);
  let before = descriptors();
  match (source.open(e, ctx, "content://mock/video", 15i64)) {
    Err(frame.Limit) => {},
    _ => {
      return 401;
    }
  }
  if (clean() != 1 || closed() != 1 || descriptors() != before) {
    return 402;
  }
  return 0;
}

function read_failure(src: source.Source, offset: i64, count: i32, expected: frame.VideoError): boolean {
  return match (src.read_at(offset, count)) { Err(error) => error == expected, _ => false };
}

function read_bounds(src: source.Source): boolean {
  for (offset, count, error) in [(-1i64, 1, frame.Header), (0i64, -1, frame.Header), (src.length + 1i64, 1, frame.Truncated), (0i64, 1048577, frame.Limit)] {
    if (!read_failure(src, offset, count, error)) {
      return false;
    }
  }
  for value in [source.Source { ...src, fd: -1 }, source.Source { ...src, offset: -1i64 }, source.Source { ...src, length: -1i64 }] {
    if (!read_failure(value, 0i64, 1, frame.Header)) {
      return false;
    }
  }
  return read_failure(source.Source { ...src, offset: 9223372036854775800i64, length: 16i64 }, 0i64, 1, frame.Limit);
}

function read_bytes(src: source.Source): boolean {
  let Ok(bytes) = src.read_at(0i64, 1048576) else {
    return false;
  };
  if (bytes.len() as i64 != src.length) {
    return false;
  }
  for i in 0..bytes.len() {
    if (bytes[i] as i64 != src.offset + i as i64) {
      return false;
    }
  }
  let Ok(partial) = src.read_at(src.length - 3i64, 12) else {
    return false;
  };
  if (partial.len() != 3 || partial[0] as i64 != src.offset + src.length - 3i64 || partial[2] as i64 != src.offset + src.length - 1i64) {
    return false;
  }
  return true;
}

function read_empty(src: source.Source): boolean {
  let Ok(end) = src.read_at(src.length, 1) else {
    return false;
  };
  let Ok(empty) = src.read_at(0i64, 0) else {
    return false;
  };
  return end.len() == 0 && empty.len() == 0;
}

function read_checks(src: source.Source): boolean {
  return read_bytes(src) && read_bounds(src) && read_empty(src) && verify(src.fd, src.offset, src.length) == 1;
}

function opened(src: source.Source, before: i32): boolean {
  return clean() == 1 && closed() == 1 && descriptors() == before + 1 && verify(src.fd, src.offset, src.length) == 1;
}

function success_case(e: usize, ctx: usize, value: i32): i32 {
  mode(value);
  let before = descriptors();
  let src = match (source.open(e, ctx, "content://mock/video", 40i64)) { Ok(result) => result, Err(_) => { return 501; } };
  if (!opened(src, before) || !read_checks(src)) {
    let _ = src.close();
    return 502;
  }
  if let Err(_) = src.close() {
    return 503;
  }
  if (!read_failure(src, 0i64, 1, frame.Platform)) {
    return 506;
  }
  if (descriptors() != before) {
    return 504;
  }
  return 0;
}

function success(e: usize, ctx: usize): i32 {
  for _ in 0..1000 {
    for value in [0, 21] {
      let result = success_case(e, ctx, value);
      if (result != 0) {
        return result;
      }
    }
  }
  return 0;
}

function preflight(e: usize, ctx: usize): i32 {
  mode(0);
  for uri in ["", "content://", "file:///mock.mp4", "https://mock/video", "content://mock/\x00bad"] {
    match (source.open(e, ctx, uri, 40i64)) {
      Err(frame.Header) => {},
      _ => {
        return 701;
      }
    }
  }
  match (source.open(e, ctx, "content://mock/video", 0i64)) {
    Err(frame.Limit) => {},
    _ => {
      return 702;
    }
  }
  if (clean() != 1 || closed() != 0) {
    return 703;
  }
  return 0;
}

function main(): i32 {
  let e = env();
  let ctx = context();
  let first = preflight(e, ctx);
  if (first != 0) {
    return first;
  }
  let result = errors(e, ctx);
  if (result != 0) {
    return result;
  }
  let good = success(e, ctx);
  if (good != 0) {
    return good;
  }
  return android_content_file_check.run(e, ctx);
}
