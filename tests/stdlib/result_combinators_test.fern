import "std/test";
import "std/result";
import "std/option";

function test_is_ok_is_err(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let er: Result[i32, string] = Err("bad");
  return test.assert_true(ok.is_ok() && !ok.is_err() && er.is_err() && !er.is_ok());
}

function test_unwrap_or(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let er: Result[i32, string] = Err("bad");
  return test.assert_true(ok.unwrap_or(0) == 5 && er.unwrap_or(42) == 42);
}

function test_unwrap_or_else(): test.TestOutcome {
  let er: Result[i32, string] = Err("bad");
  return test.assert_eq(er.unwrap_or_else((e: string): i32 => e.len()), 3);
}

function test_map(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let m = ok.map((x: i32): i32 => x * 2);
  return test.assert_eq(m.unwrap_or(0), 10);
}

function test_and_then(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let r = ok.and_then((x: i32): Result[i32, string] => Ok(x + 1));
  return test.assert_eq(r.unwrap_or(0), 6);
}

function test_map_err(): test.TestOutcome {
  let er: Result[i32, string] = Err("bad");
  let r = er.map_err((e: string): i32 => e.len());
  return test.assert_eq(r.err().unwrap_or(0), 3);
}

function test_ok(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let er: Result[i32, string] = Err("bad");
  return test.assert_true(ok.ok().unwrap_or(0) == 5 && er.ok().is_none());
}

function test_err(): test.TestOutcome {
  let er: Result[i32, string] = Err("bad");
  let ok: Result[i32, string] = Ok(5);
  return test.assert_true(er.err().unwrap_or("") == "bad" && ok.err().is_none());
}

function test_map_or(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let er: Result[i32, string] = Err("bad");
  let a = ok.map_or(0, (x: i32): i32 => x * 10);
  let b = er.map_or(0, (x: i32): i32 => x * 10);
  return test.assert_true(a == 50 && b == 0);
}

function test_is_ok_and(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  return test.assert_true(ok.is_ok_and((x: i32): boolean => x > 3));
}

function test_is_err_and(): test.TestOutcome {
  let er: Result[i32, string] = Err("bad");
  return test.assert_true(er.is_err_and((e: string): boolean => e.len() > 2));
}

function test_or(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let er: Result[i32, string] = Err("bad");
  let fallback: Result[i32, string] = Ok(9);
  return test.assert_true(ok.or(fallback).unwrap_or(0) == 5 && er.or(fallback).unwrap_or(0) == 9);
}

function test_and(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let er: Result[i32, string] = Err("bad");
  let other: Result[i32, string] = Ok(9);
  if (ok.and(other).unwrap_or(0) != 9) {
    return test.fail("Ok.and should yield other");
  }
  return test.assert_true(er.and(other).is_err());
}

function test_or_else(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let er: Result[i32, string] = Err("bad");
  let recovered: Result[i32, string] = er.or_else((e: string): Result[i32, string] => Ok(e.len()));
  if (recovered.unwrap_or(0) != 3) {
    return test.fail("or_else recovery wrong");
  }
  return test.assert_true(ok.or_else((e: string): Result[i32, string] => Ok(0)).unwrap_or(0) == 5);
}

function test_map_or_else(): test.TestOutcome {
  let ok: Result[i32, string] = Ok(5);
  let er: Result[i32, string] = Err("bad");
  let a: i32 = ok.map_or_else((e: string): i32 => 0, (x: i32): i32 => x * 2);
  let b: i32 = er.map_or_else((e: string): i32 => e.len(), (x: i32): i32 => x * 2);
  return test.assert_true(a == 10 && b == 3);
}

function test_flatten(): test.TestOutcome {
  let ok_ok: Result[Result[i32, string], string] = Ok(Ok(30));
  let ok_err: Result[Result[i32, string], string] = Ok(Err("inner"));
  let outer_err: Result[Result[i32, string], string] = Err("outer");
  return test.assert_true(
    ok_ok.flatten().unwrap_or(0) == 30
      && ok_err.flatten().is_err()
      && outer_err.flatten().is_err(),
  );
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/result combinators");
  r = r.it("is_ok / is_err", test_is_ok_is_err);
  r = r.it("unwrap_or", test_unwrap_or);
  r = r.it("unwrap_or_else", test_unwrap_or_else);
  r = r.it("map", test_map);
  r = r.it("and_then", test_and_then);
  r = r.it("map_err", test_map_err);
  r = r.it("ok", test_ok);
  r = r.it("err", test_err);
  r = r.it("map_or", test_map_or);
  r = r.it("is_ok_and", test_is_ok_and);
  r = r.it("is_err_and", test_is_err_and);
  r = r.it("or", test_or);
  r = r.it("and", test_and);
  r = r.it("or_else", test_or_else);
  r = r.it("map_or_else", test_map_or_else);
  r = r.it("flatten", test_flatten);
  return r.finish();
}
