import "std/test";
import "std/i32";

function bump_then_pass(seen: Cell[i32]): test.TestOutcome {
  seen.set(seen.get() + 1);
  return Pass;
}

function main(): i32 {
  let seen: Cell[i32] = cell_new(0);

  let r: test.TestRunner = test.test_new_filtered("runner laziness", "checks");
  r = r.it("dropped by the filter", () => bump_then_pass(seen));
  r = r.it("checks the dropped body never ran", () => test.assert_eq(seen.get(), 0));

  r = r.it("checks a kept body does run", () => bump_then_pass(seen));
  r = r.it("checks the kept body ran once", () => test.assert_eq(seen.get(), 1));

  return r.finish();
}
