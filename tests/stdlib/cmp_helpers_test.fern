import "std/test";
import "core/cmp" as cmp;

function test_min(): test.TestOutcome {
  return test.assert_eq(cmp.min(8, 3), 3);
}

function test_max(): test.TestOutcome {
  return test.assert_eq(cmp.max(8, 3), 8);
}

function test_clamp_hi(): test.TestOutcome {
  return test.assert_eq(cmp.clamp(15, 0, 10), 10);
}

function test_clamp_lo(): test.TestOutcome {
  return test.assert_eq(cmp.clamp(0 - 4, 0, 10), 0);
}

function test_clamp_in(): test.TestOutcome {
  return test.assert_eq(cmp.clamp(5, 0, 10), 5);
}

function test_lt(): test.TestOutcome {
  return test.assert_true(cmp.lt(2, 9));
}

function test_gte(): test.TestOutcome {
  return test.assert_true(cmp.gte(9, 9));
}

function test_lt_false(): test.TestOutcome {
  return test.assert_false(cmp.lt(9, 2));
}

function test_sort(): test.TestOutcome {
  let s = cmp.sort([3, 1, 2]);
  return test.assert_true(s[0] == 1 && s[1] == 2 && s[2] == 3);
}

function test_is_sorted(): test.TestOutcome {
  return test.assert_true(cmp.is_sorted([1, 2, 3]));
}

function test_is_sorted_false(): test.TestOutcome {
  return test.assert_false(cmp.is_sorted([3, 1]));
}

function test_contains(): test.TestOutcome {
  return test.assert_true(cmp.contains([10, 20, 30], 20));
}

function test_index_of(): test.TestOutcome {
  match (cmp.index_of([10, 20, 30], 20)) {
    Some(i) => {
      return test.assert_eq(i, 1);
    },
    None => {
      return test.fail("index_of expected Some(1), got None");
    }
  }
}

function test_index_of_absent(): test.TestOutcome {
  match (cmp.index_of([10, 20, 30], 99)) {
    Some(i) => {
      return test.fail("index_of expected None for absent value");
    },
    None => {
      return test.assert_true(true);
    }
  }
}

function test_distinct(): test.TestOutcome {
  let d = cmp.distinct([1, 1, 2, 3, 3, 3]);
  return test.assert_true(d.len() == 3 && d[0] == 1 && d[1] == 2 && d[2] == 3);
}

function test_eq_arrays(): test.TestOutcome {
  return test.assert_true(cmp.eq_arrays([1, 2], [1, 2]));
}

function test_eq_arrays_false(): test.TestOutcome {
  return test.assert_false(cmp.eq_arrays([1, 2], [1]));
}

function test_string_sort(): test.TestOutcome {
  let s = cmp.sort(["b", "a", "c"]);
  return test.assert_true(s[0] == "a" && s[2] == "c");
}

function test_string_debug_multibyte(): test.TestOutcome {
  let s: string = "a\"é\nb";
  return test.assert_eq(s.to_debug(), "\"a\\\"é\\nb\"");
}

// The contract of cmp_prefix: a below b gives a word no higher, and equal values give equal words.
function prefix_ordered[T: cmp.Ord](xs: T[], offset: i32): boolean {
  for a in xs {
    for b in xs {
      let c: i32 = a.cmp(b);
      let wa: u64 = a.cmp_prefix(offset);
      let wb: u64 = b.cmp_prefix(offset);
      if (c < 0 && wa > wb || c == 0 && wa != wb) {
        return false;
      }
    }
  }
  return true;
}

function test_integer_prefixes(): test.TestOutcome {
  let i32s: i32[] = [-2147483647 - 1, -65536, -1, 0, 1, 255, 256, 2147483647];
  let i64s: i64[] = [-9223372036854775807i64 - 1i64, -4294967296i64, -1i64, 0i64, 1i64, 9223372036854775807i64];
  let u64s: u64[] = [0u64, 1u64, 9223372036854775807u64, 9223372036854775808u64, 18446744073709551615u64];
  let ok: boolean = prefix_ordered(i32s, 0) && prefix_ordered(i64s, 0) && prefix_ordered(u64s, 0) && prefix_ordered([false, true], 0);
  return test.assert_true(ok && 5.cmp_shared(6) == 0);
}

function test_string_prefixes(): test.TestOutcome {
  let xs: string[] = ["", "a", "a\x00", "ab", "abcdefgh", "abcdefghi", "abcdefgz", "b", "é", "https://a/1", "https://a/10", "https://a/2"];
  if (!prefix_ordered(xs, 0)) {
    return test.fail("offset 0");
  }
  let shared: string[] = ["https://a/1", "https://a/10", "https://a/2", "https://a/"];
  if (!prefix_ordered(shared, 10)) {
    return test.fail("offset 10");
  }
  return test.assert_true("https://a/1".cmp_shared("https://a/2") == 10 && "ab".cmp_shared("abc") == 2 && "x".cmp_shared("y") == 0);
}

function main(): i32 {
  let r: test.TestRunner = test.new("core/cmp helpers");
  r = r.it("min", test_min);
  r = r.it("max", test_max);
  r = r.it("clamp above hi", test_clamp_hi);
  r = r.it("clamp below lo", test_clamp_lo);
  r = r.it("clamp in range", test_clamp_in);
  r = r.it("lt", test_lt);
  r = r.it("gte", test_gte);
  r = r.it("lt false", test_lt_false);
  r = r.it("sort", test_sort);
  r = r.it("is_sorted", test_is_sorted);
  r = r.it("is_sorted false", test_is_sorted_false);
  r = r.it("contains", test_contains);
  r = r.it("index_of", test_index_of);
  r = r.it("index_of absent", test_index_of_absent);
  r = r.it("distinct", test_distinct);
  r = r.it("eq_arrays", test_eq_arrays);
  r = r.it("eq_arrays false", test_eq_arrays_false);
  r = r.it("string sort", test_string_sort);
  r = r.it("string debug multibyte", test_string_debug_multibyte);
  r = r.it("integer prefixes", test_integer_prefixes);
  r = r.it("string prefixes", test_string_prefixes);
  return r.finish();
}
