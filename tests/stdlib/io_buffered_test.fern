import "std/test";
import "std/io_buffered" as io;
import "std/result";

function test_empty(): test.TestOutcome {
  let w = io.bytes_writer_new();
  if (!w.is_empty() || w.len() != 0) {
    return test.fail("empty buffer state");
  }
  return test.assert_is_some_eq_string(w.into_string().ok(), "");
}

function test_write_string(): test.TestOutcome {
  let w = io.bytes_writer_new();
  w = w.write_string("abc");
  if (w.len() != 3 || w.is_empty()) {
    return test.fail("written buffer state");
  }
  return test.assert_is_some_eq_string(w.into_string().ok(), "abc");
}

function test_write_byte(): test.TestOutcome {
  let w = io.bytes_writer_new();
  w = w.write_byte(72);
  w = w.write_byte(105);
  return test.assert_is_some_eq_string(w.into_string().ok(), "Hi");
}

function test_write_bytes(): test.TestOutcome {
  let w = io.bytes_writer_new();
  w = w.write_bytes("BC".bytes());
  return test.assert_is_some_eq_string(w.into_string().ok(), "BC");
}

function test_chained_build(): test.TestOutcome {
  let w = io.bytes_writer_new().write_string("HTTP/1.1 ").write_string("200").write_byte(32).write_string("OK");
  return test.assert_is_some_eq_string(w.into_string().ok(), "HTTP/1.1 200 OK");
}

function test_mixed_writes(): test.TestOutcome {
  let w = io.bytes_writer_new();
  w = w.write_string("a");
  w = w.write_byte(98);
  w = w.write_bytes("cd".bytes());
  if (w.len() != 4) {
    return test.fail("mixed write length");
  }
  return test.assert_is_some_eq_string(w.into_string().ok(), "abcd");
}

function test_into_bytes(): test.TestOutcome {
  let w = io.bytes_writer_new().write_string("xyz");
  let bs: u8[] = w.into_bytes();
  return test.assert_true(bs.len() == 3 && bs[0] as i32 == 120);
}

function test_into_string_refuses_ill_formed(): test.TestOutcome {
  let w = io.bytes_writer_new().write_string("a").write_byte(255).write_string("b");
  match (w.into_string()) {
    Ok(s) => {
      return test.fail("into_string accepted: " + s);
    },
    Err(_) => {}
  }
  let bs: u8[] = w.into_bytes();
  return test.assert_true(bs.len() == 3 && bs[1] as i32 == 255);
}

function test_reset(): test.TestOutcome {
  let w = io.bytes_writer_new().write_string("discard me");
  w = w.reset();
  if (!w.is_empty()) {
    return test.fail("reset buffer state");
  }
  return test.assert_is_some_eq_string(w.into_string().ok(), "");
}

function test_reset_then_reuse(): test.TestOutcome {
  let w = io.bytes_writer_new().write_string("old");
  w = w.reset();
  w = w.write_string("new");
  return test.assert_is_some_eq_string(w.into_string().ok(), "new");
}

function test_buf_writer_holds_below_cap(): test.TestOutcome {
  let b: io.BufWriter = io.buf_writer_new(stderr(), 16);
  let held: Result[i32, IoError] = writes_below_cap(b);
  return test.assert_true(held.is_ok() && held.unwrap_or(0) == 4);
}

function writes_below_cap(b0: io.BufWriter): Result[i32, IoError] {
  let b: io.BufWriter = b0.write_string("abc")?;
  b = b.write_byte(100)?;
  return Ok(b.buffered());
}

function u64_widths(b0: io.BufWriter): Result[boolean, IoError] {
  let b: io.BufWriter = b0.write_u64(0 as u64)?;
  let one: i32 = b.buffered();
  b = b.write_u64(9 as u64)?;
  let two: i32 = b.buffered();
  b = b.write_u64(10 as u64)?;
  let four: i32 = b.buffered();
  b = b.write_u64(18446744073709551615 as u64)?;
  return Ok(one == 1 && two == 2 && four == 4 && b.buffered() == 24);
}

function test_buf_writer_write_u64(): test.TestOutcome {
  let got: Result[boolean, IoError] = u64_widths(io.buf_writer_new(stderr(), 1024));
  return test.assert_true(got.unwrap_or(false));
}

function i64_widths(b0: io.BufWriter): Result[boolean, IoError] {
  let b: io.BufWriter = b0.write_i64(0 - 5 as i64)?;
  let two: i32 = b.buffered();
  b = b.write_i64(42 as i64)?;
  let four: i32 = b.buffered();
  b = b.write_i64(0 - 9223372036854775807 as i64 - 1 as i64)?;
  return Ok(two == 2 && four == 4 && b.buffered() == 24);
}

function test_buf_writer_write_i64(): test.TestOutcome {
  let got: Result[boolean, IoError] = i64_widths(io.buf_writer_new(stderr(), 1024));
  return test.assert_true(got.unwrap_or(false));
}

function flushes_at_cap(b0: io.BufWriter): Result[boolean, IoError] {
  let b: io.BufWriter = b0.write_string("abcd")?;
  b = b.write_string("efgh")?;
  let after_cap: i32 = b.buffered();
  b = b.write_string("ijklmnopqrstuvwxyz")?;
  let after_big: i32 = b.buffered();
  b = b.write_string("z")?;
  b = b.flush()?;
  return Ok(after_cap == 0 && after_big == 0 && b.buffered() == 0);
}

function test_buf_writer_flushes_at_cap(): test.TestOutcome {
  match (flushes_at_cap(io.buf_writer_new(stderr(), 8))) {
    Ok(ok) => {
      return test.assert_true(ok);
    },
    Err(_) => {
      return test.fail("write error on stderr");
    }
  }
}

function is_no_space(r: Result[io.BufWriter, IoError]): boolean {
  match (r) {
    Err(Other(_, msg, _)) => {
      return msg == "No space left on device";
    },
    _ => {
      return false;
    }
  }
  return false;
}

function test_buf_writer_write_reports_failed_flush(): test.TestOutcome {
  match (open_writer("/dev/full")) {
    Ok(w) => {
      let b: io.BufWriter = io.buf_writer_new(w, 4);
      if (!is_no_space(b.write_string("past the capacity"))) {
        return test.fail("write_string past the capacity did not answer the refused write");
      }
      let c: io.BufWriter = io.buf_writer_new(w, 4);
      if (!is_no_space(c.write_bytes("abcd".bytes()))) {
        return test.fail("write_bytes reaching the capacity did not answer the refused flush");
      }
      return test.assert_true(c.buffered() == 0);
    },
    Err(_) => {
      return test.fail("open_writer failed");
    }
  }
}

function test_buf_writer_failure_is_sticky(): test.TestOutcome {
  match (open_writer("/dev/full")) {
    Ok(w) => {
      let b: io.BufWriter = io.buf_writer_new(w, 64);
      match (b.write_string("held")) {
        Ok(held) => {
          b = held;
        },
        Err(_) => {
          return test.fail("a write that only buffers answered an error");
        }
      }
      if (!is_no_space(b.flush())) {
        return test.fail("flush did not answer the refused write");
      }
      if (!is_no_space(b.flush())) {
        return test.fail("a later flush did not answer the earlier failure");
      }
      if (!is_no_space(b.write_string("past the sixty-four byte capacity of this writer, so it reaches the Writer"))) {
        return test.fail("a later write reaching the Writer did not answer the earlier failure");
      }
      match (b.error()) {
        Some(Other(_, msg, _)) => {
          return test.assert_true(msg == "No space left on device");
        },
        _ => {
          return test.fail("error() lost the failure");
        }
      }
    },
    Err(_) => {
      return test.fail("open_writer failed");
    }
  }
}

function lines_of(path: string, term: i32, chunk: i32): string[] {
  let out: string[] = [];
  match (open_reader(path)) {
    Ok(r) => {
      let lr: io.LineReader = io.line_reader_new(r, term, chunk);
      while (true) {
        match (lr.next_line()) {
          Ok((line, next)) => {
            lr = next;
            match (line) {
              Some(l) => {
                out = out.append(l);
              },
              None => {
                return out;
              }
            }
          },
          Err(_) => {
            return ["read failed"];
          }
        }
      }
    },
    Err(_) => {
      return out;
    }
  }
  return out;
}

function with_file(content: string, term: i32, chunk: i32): string[] {
  match (temp_dir("io_buffered_test")) {
    Ok(dir) => {
      let path: string = dir + "/input";
      match (write_file(path, content)) {
        Ok(_) => {},
        Err(_) => {
          return [];
        }
      }
      let got: string[] = lines_of(path, term, chunk);
      remove_file(path);
      return got;
    },
    Err(_) => {
      return [];
    }
  }
}

function test_buf_writer_close_writes(): test.TestOutcome {
  let path: string = "/tmp/fern_io_buffered_close_test.txt";
  match (open_writer(path)) {
    Ok(w) => {
      let b: io.BufWriter = io.buf_writer_new(w, 64);
      b = b.write_string("held").unwrap_or(b);
      let held: i32 = b.buffered();
      if let Err(_) = b.close() {
        return test.fail("close failed");
      }
      let got: string = "";
      match (read_file(path)) {
        Ok(s) => {
          got = s;
        },
        Err(_) => {
          return test.fail("read back failed");
        }
      }
      remove_file(path);
      return test.assert_eq(held == 4 && got == "held", true);
    },
    Err(_) => {
      return test.fail("open_writer failed");
    }
  }
}

function test_buf_writer_close_refused(): test.TestOutcome {
  match (open_writer("/dev/full")) {
    Ok(w) => {
      let b: io.BufWriter = io.buf_writer_new(w, 4);
      let failed: boolean = is_no_space(b.write_string("first flush fails"));
      let sticky: boolean = false;
      match (b.error()) {
        Some(_) => {
          sticky = failed;
        },
        None => {}
      }
      b.write_string("x");
      match (b.close()) {
        Err(Other(_, msg, _)) => {
          return test.assert_eq(sticky && msg == "No space left on device", true);
        },
        Err(_) => {
          return test.fail("close error is not Other");
        },
        Ok(_) => {
          return test.fail("close did not report the refused write");
        }
      }
    },
    Err(_) => {
      return test.fail("open_writer failed");
    }
  }
}

function test_buf_writer_close_empty(): test.TestOutcome {
  match (open_writer("/dev/full")) {
    Ok(w) => {
      let b: io.BufWriter = io.buf_writer_new(w, 4);
      match (b.close()) {
        Err(_) => {
          return test.fail("close with nothing held failed");
        },
        Ok(_) => {
          return test.assert_eq(true, true);
        }
      }
    },
    Err(_) => {
      return test.fail("open_writer failed");
    }
  }
}

function is_read_failure[T](r: Result[T, IoError]): boolean {
  match (r) {
    Err(Other(_, _, _)) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function test_readers_answer_read_failure(): test.TestOutcome {
  match (temp_dir("io_buffered_test")) {
    Ok(dir) => {
      let ok: boolean = true;
      for step in [0, 1, 2, 3, 4] {
        match (open_reader(dir)) {
          Ok(r) => {
            let raw: io.ByteLineReader = io.byte_line_reader_new(r, 10, 4096);
            let text: io.LineReader = io.line_reader_new(r, 10, 4096);
            if (step == 0) {
              ok = ok && is_read_failure(raw.next_line_bytes());
            } else if (step == 1) {
              ok = ok && is_read_failure(raw.next_chunk_bytes());
            } else if (step == 2) {
              ok = ok && is_read_failure(raw.skip_line());
            } else if (step == 3) {
              ok = ok && is_read_failure(text.next_line());
            } else {
              ok = ok && is_read_failure(text.next_chunk());
            }
            r.close();
          },
          Err(_) => {
            return test.fail("open_reader on a directory failed");
          }
        }
      }
      return test.assert_true(ok);
    },
    Err(_) => {
      return test.fail("temp_dir failed");
    }
  }
}

function is_invalid_text(r: Result[(Option[string], io.LineReader), IoError]): boolean {
  match (r) {
    Err(InvalidUtf8(path)) => {
      return path == "";
    },
    _ => {
      return false;
    }
  }
  return false;
}

function test_line_reader_answers_invalid_text(): test.TestOutcome {
  match (temp_dir("io_buffered_test")) {
    Ok(dir) => {
      let path: string = dir + "/invalid";
      let bad: u8[] = [111, 107, 10, 255, 10];
      match (write_file_bytes(path, bad)) {
        Ok(_) => {},
        Err(_) => {
          return test.fail("write_file_bytes failed");
        }
      }
      let ok: boolean = false;
      match (open_reader(path)) {
        Ok(r) => {
          let lr: io.LineReader = io.line_reader_new(r, 10, 4096);
          match (lr.next_line()) {
            Ok((Some(first), next)) => {
              ok = first == "ok\n" && is_invalid_text(next.next_line());
            },
            _ => {}
          }
          r.close();
        },
        Err(_) => {}
      }
      remove_file(path);
      return test.assert_true(ok);
    },
    Err(_) => {
      return test.fail("temp_dir failed");
    }
  }
}

function test_line_reader_keeps_terminators(): test.TestOutcome {
  let got: string[] = with_file("a\nbb\n\nccc", 10, 4096);
  return test.assert_true(got.len() == 4 && got[0] == "a\n" && got[1] == "bb\n" && got[2] == "\n" && got[3] == "ccc");
}

function test_line_reader_spans_chunks(): test.TestOutcome {
  let got: string[] = with_file("alpha\nbeta\ngamma\n", 10, 3);
  return test.assert_true(got.len() == 3 && got[0] == "alpha\n" && got[1] == "beta\n" && got[2] == "gamma\n");
}

function test_line_reader_empty_and_nul(): test.TestOutcome {
  let empty: string[] = with_file("", 10, 4096);
  let nul: string[] = with_file("x\x00yy\x00", 0, 4096);
  return test.assert_true(empty.len() == 0 && nul.len() == 2 && nul[0] == "x\x00" && nul[1] == "yy\x00");
}

function main(): i32 {
  let r: test.TestRunner = test.new("std/io_buffered BytesWriter");
  r = r.it("empty", test_empty);
  r = r.it("write_string", test_write_string);
  r = r.it("write_byte", test_write_byte);
  r = r.it("write_bytes", test_write_bytes);
  r = r.it("chained build", test_chained_build);
  r = r.it("mixed writes", test_mixed_writes);
  r = r.it("into_bytes", test_into_bytes);
  r = r.it("reset", test_reset);
  r = r.it("reset then reuse", test_reset_then_reuse);
  r = r.it("BufWriter holds below cap", test_buf_writer_holds_below_cap);
  r = r.it("BufWriter flushes at cap", test_buf_writer_flushes_at_cap);
  r = r.it("BufWriter write_u64 digit widths", test_buf_writer_write_u64);
  r = r.it("BufWriter write_i64 sign and minimum", test_buf_writer_write_i64);
  r = r.it("BufWriter close writes what is held", test_buf_writer_close_writes);
  r = r.it("BufWriter close reports the refused write", test_buf_writer_close_refused);
  r = r.it("BufWriter close with nothing held", test_buf_writer_close_empty);
  r = r.it("BufWriter write answers a refused flush", test_buf_writer_write_reports_failed_flush);
  r = r.it("BufWriter failure is answered again and kept", test_buf_writer_failure_is_sticky);
  r = r.it("line readers answer a read failure as Err", test_readers_answer_read_failure);
  r = r.it("LineReader answers invalid UTF-8 as Err", test_line_reader_answers_invalid_text);
  r = r.it("LineReader keeps terminators", test_line_reader_keeps_terminators);
  r = r.it("LineReader spans chunks", test_line_reader_spans_chunks);
  r = r.it("LineReader empty and NUL", test_line_reader_empty_and_nul);
  r = r.it("into_string refuses ill-formed bytes", test_into_string_refuses_ill_formed);
  return r.finish();
}
