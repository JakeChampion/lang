import "std/android/draw";
import "std/test";

// A frame of `w` by `h` pixels in plain memory, with a stride of w + 3.
function frame(w: i32, h: i32): draw.Frame {
  unsafe {
    let bits = __alloc((w + 3) * h * 4);
    let f = draw.Frame { window: 0 as usize, buffer: 0 as usize, bits: bits, width: w, height: h, stride: w + 3 };
    f.fill(0, 0, w, h, draw.rgb(0, 0, 0));
    return f;
  }
}

function free_frame(own f: draw.Frame): void {
  unsafe {
    __free(f.bits, f.stride * f.height * 4);
  }
}

function count(f: draw.Frame, color: i32): i32 {
  let n = 0;
  for y in 0..f.height {
    for x in 0..f.width {
      if (f.pixel(x, y) == color) {
        n += 1;
      }
    }
  }
  return n;
}

// The disc covers about pi (r - 0.5)^2 pixels fully, has a smooth edge, and
// leaves the pixels outside it alone.
function test_disc(): test.TestOutcome {
  let f: draw.Frame = frame(40, 40);
  defer free_frame(f);
  let white: i32 = draw.rgb(255, 255, 255);
  f.disc(20, 20, 10, white);
  let full: i32 = count(f, white);
  let black: i32 = count(f, draw.rgb(0, 0, 0));
  let edge: i32 = 40 * 40 - full - black;
  let corners: boolean = f.pixel(10, 10) == draw.rgb(0, 0, 0) && f.pixel(20, 20) == white;
  return test.assert_eq((full > 260 && full < 300).to_string() + " " + (edge > 20).to_string() + " " + corners.to_string(), "true true true");
}

// A ring leaves its middle alone.
function test_ring(): test.TestOutcome {
  let f: draw.Frame = frame(40, 40);
  defer free_frame(f);
  let white: i32 = draw.rgb(255, 255, 255);
  f.ring(20, 20, 15, 3, white);
  let middle: boolean = f.pixel(20, 20) == draw.rgb(0, 0, 0);
  let band: boolean = f.pixel(20, 6) == white && f.pixel(6, 20) == white;
  return test.assert_eq(middle.to_string() + " " + band.to_string(), "true true");
}

// A rounded rectangle fills its middle and its sides, and not the tips of
// its corners.
function test_round_rect(): test.TestOutcome {
  let f: draw.Frame = frame(60, 30);
  defer free_frame(f);
  let white: i32 = draw.rgb(255, 255, 255);
  f.round_rect(5, 5, 50, 20, 8, white);
  let inside: boolean = f.pixel(30, 15) == white && f.pixel(30, 5) == white && f.pixel(5, 15) == white;
  let tips: boolean = f.pixel(5, 5) == draw.rgb(0, 0, 0) && f.pixel(54, 24) == draw.rgb(0, 0, 0);
  let outside: boolean = f.pixel(4, 15) == draw.rgb(0, 0, 0) && f.pixel(55, 15) == draw.rgb(0, 0, 0);
  return test.assert_eq(inside.to_string() + " " + tips.to_string() + " " + outside.to_string(), "true true true");
}

function test_rgb(): test.TestOutcome {
  return test.assert_eq(draw.rgb(1, 2, 3), -16777216 | 3 << 16 | 2 << 8 | 1);
}

function test_rgba(): test.TestOutcome {
  let half = draw.rgba(200, 100, 50, 128);
  let got = (draw.rgba(1, 2, 3, 255) == draw.rgb(1, 2, 3)).to_string() + " " + (half >> 24 & 255).to_string() + " " + draw.over(half, draw.rgb(0, 0, 0)).to_string() + " " + draw.over(draw.rgba(9, 9, 9, 0), draw.rgb(1, 2, 3)).to_string();
  // 200 * 128 / 255 = 100, 100 * 128 / 255 = 50 and 50 * 128 / 255 = 25.
  return test.assert_eq(got, "true 128 " + draw.rgb(100, 50, 25).to_string() + " " + draw.rgb(1, 2, 3).to_string());
}

// A shape with an alpha blends over the pixels under it: a fill, and the
// middle of a disc.
function test_alpha_shapes(): test.TestOutcome {
  let f = frame(40, 40);
  defer free_frame(f);
  f.fill(0, 0, 40, 20, draw.rgb(0, 0, 200));
  let half = draw.rgba(255, 255, 255, 128);
  f.fill(0, 0, 10, 40, half);
  f.disc(30, 30, 6, half);
  let got = (f.pixel(5, 5) == draw.over(half, draw.rgb(0, 0, 200))).to_string() + " " + (f.pixel(5, 35) == draw.over(half, draw.rgb(0, 0, 0))).to_string() + " " + (f.pixel(30, 30) == draw.over(half, draw.rgb(0, 0, 0))).to_string() + " " + (f.pixel(15, 5) == draw.rgb(0, 0, 200)).to_string();
  return test.assert_eq(got, "true true true true");
}

// `store` writes the pixel word with no blend, and clips to the frame.
function test_store(): test.TestOutcome {
  let f = frame(10, 8);
  defer free_frame(f);
  f.fill(0, 0, 10, 8, draw.rgb(0, 0, 200));
  let clear = draw.rgba(255, 255, 255, 0);
  f.store(-3, -3, 5, 5, clear);
  let got = (f.pixel(1, 1) == clear).to_string() + " " + (f.pixel(2, 2) == draw.rgb(0, 0, 200)).to_string() + " " + count(f, clear).to_string();
  return test.assert_eq(got, "true true 4");
}

function test_fill_clips(): test.TestOutcome {
  let f = frame(10, 8);
  defer free_frame(f);
  let red = draw.rgb(255, 0, 0);
  f.fill(7, 5, 10, 10, red);
  f.fill(-5, -5, 6, 7, red);
  return test.assert_eq(count(f, red), 3 * 3 + 1 * 2);
}

function test_text_draws_inside_its_cells(): test.TestOutcome {
  let f = frame(100, 40);
  defer free_frame(f);
  let white = draw.rgb(255, 255, 255);
  f.text(2, 3, "Hi", 1, white);
  let inside = 0;
  let outside = 0;
  for y in 0..f.height {
    for x in 0..f.width {
      if (f.pixel(x, y) != draw.rgb(0, 0, 0)) {
        if (x >= 2 && x < 2 + draw.text_width("Hi", 1) && y >= 3 && y < 3 + draw.text_height(1)) {
          inside += 1;
        } else {
          outside += 1;
        }
      }
    }
  }
  return test.assert_eq((inside > 40).to_string() + " " + outside.to_string() + " " + (count(f, white) > 10).to_string(), "true 0 true");
}

function test_space_draws_nothing(): test.TestOutcome {
  let f = frame(40, 40);
  defer free_frame(f);
  f.text(0, 0, "  ", 1, draw.rgb(255, 255, 255));
  return test.assert_eq(count(f, draw.rgb(0, 0, 0)), 40 * 40);
}

function test_scale_grows_the_text(): test.TestOutcome {
  let small = frame(60, 70);
  let big = frame(60, 70);
  defer free_frame(small);
  defer free_frame(big);
  let white = draw.rgb(255, 255, 255);
  small.text(0, 0, "8", 1, white);
  big.text(0, 0, "8", 2, white);
  return test.assert_eq(count(big, white) >= 3 * count(small, white), true);
}

function test_width_counts_characters(): test.TestOutcome {
  return test.assert_eq(draw.text_width("abc", 2).to_string() + " " + draw.text_width("é", 1).to_string(), (3 * 2 * draw.text_width("a", 1)).to_string() + " " + draw.text_width("a", 1).to_string());
}

function test_text_outside_is_clipped(): test.TestOutcome {
  let f = frame(20, 20);
  defer free_frame(f);
  f.text(-200, -200, "W", 3, draw.rgb(255, 255, 255));
  f.text(15, 15, "W", 3, draw.rgb(255, 255, 255));
  return test.assert_eq(f.pixel(19, 19) != 0, true);
}

// The pixels of `s` drawn alone in white, row by row.
function drawn(s: string): i32[] {
  let f = frame(60, 30);
  defer free_frame(f);
  f.text(0, 0, s, 1, draw.rgb(255, 255, 255));
  let out: i32[] = [];
  for y in 0..f.height {
    for x in 0..f.width {
      out = out.append(f.pixel(x, y));
    }
  }
  return out;
}

function same(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

// A Latin letter with an accent has a glyph of its own, and so do the dashes
// and the curly quotes of a summary.
function test_latin_letters_have_glyphs(): test.TestOutcome {
  let unknown = drawn("?");
  for s in ["é", "Ü", "ñ", "ø", "Œ", "ł", "–", "—", "’", "…", "·"] {
    if (same(drawn(s), unknown)) {
      return test.fail(s + " draws as ?");
    }
  }
  if (same(drawn("é"), drawn("e"))) {
    return test.fail("é draws as e");
  }
  return test.assert_eq(draw.text_width("Amélie – 2001", 1).to_string(), (13 * draw.text_width("a", 1)).to_string());
}

// A code point outside the font, and a byte that does not start a UTF-8
// sequence, each take one cell and draw as "?".
function test_unknown_code_points_draw_as_question_marks(): test.TestOutcome {
  if (!same(drawn("漢"), drawn("?"))) {
    return test.fail("a CJK character");
  }
  let stray = "";
  unsafe {
    stray = string_from_bytes_unchecked([97u8, 128u8, 98u8]);
  }
  if (!same(drawn(stray), drawn("a?b"))) {
    return test.fail("a stray continuation byte");
  }
  return test.assert_eq(draw.text_cells(stray).to_string() + " " + draw.text_cells("漢字").to_string(), "3 2");
}

// An image of w by h whose pixel at x, y is rgb(x, y, 7).
function ramp(w: i32, h: i32): draw.Image {
  let px: u8[] = [];
  for y in 0..h {
    for x in 0..w {
      px = px.append(x as u8).append(y as u8).append(7u8).append(255u8);
    }
  }
  return draw.Image { width: w, height: h, pixels: px };
}

function test_cover_size_keeps_the_shape(): test.TestOutcome {
  let tall = draw.cover_size(200, 300, 100, 100);
  let wide = draw.cover_size(1920, 1080, 300, 450);
  let exact = draw.cover_size(240, 360, 240, 360);
  return test.assert_eq(tall.0.to_string() + "x" + tall.1.to_string() + " " + wide.0.to_string() + "x" + wide.1.to_string() + " " + exact.0.to_string() + "x" + exact.1.to_string(), "100x150 800x450 240x360");
}

// The box shows the middle of a larger image, and the frame keeps its pixels
// where a smaller image does not reach.
function test_image_copies_the_middle(): test.TestOutcome {
  let f = frame(40, 30);
  defer free_frame(f);
  f.image(5, 4, 10, 6, ramp(20, 10));
  if (f.pixel(5, 4) != draw.rgb(5, 2, 7) || f.pixel(14, 9) != draw.rgb(14, 7, 7) || f.pixel(15, 4) != draw.rgb(0, 0, 0) || f.pixel(4, 4) != draw.rgb(0, 0, 0)) {
    return test.fail("the middle of a larger image");
  }
  f.image(20, 10, 10, 10, ramp(4, 2));
  if (f.pixel(23, 14) != draw.rgb(0, 0, 7) || f.pixel(26, 15) != draw.rgb(3, 1, 7) || f.pixel(22, 14) != draw.rgb(0, 0, 0)) {
    return test.fail("a smaller image in the middle of its box");
  }
  f.image(-3, 28, 6, 4, ramp(6, 4));
  if (ramp(6, 4).pixel(3, 1) != draw.rgb(3, 1, 7) || ramp(6, 4).pixel(6, 0) != 0) {
    return test.fail("Image.pixel");
  }
  return test.assert_eq(f.pixel(0, 29).to_string(), draw.rgb(3, 1, 7).to_string());
}

function test_clip_corners(): test.TestOutcome {
  let f = frame(30, 30);
  defer free_frame(f);
  let white = draw.rgb(255, 255, 255);
  f.fill(0, 0, 30, 30, white);
  f.clip_corners(0, 0, 30, 30, 8, draw.rgb(0, 0, 0));
  if (f.pixel(0, 0) != draw.rgb(0, 0, 0) || f.pixel(29, 29) != draw.rgb(0, 0, 0) || f.pixel(15, 15) != white || f.pixel(15, 0) != white || f.pixel(8, 8) != white) {
    return test.fail("corners");
  }
  // Four corners of 8 - pi * 64 / 4 pixels go, and the edges blend.
  let n = count(f, white);
  return test.assert_eq((n < 850 && n > 790).to_string() + " " + n.to_string(), "true " + n.to_string());
}

function test_cover(): test.TestOutcome {
  let f = frame(3, 1);
  f.cover(0, 0, draw.rgb(255, 255, 255), 255);
  f.cover(1, 0, draw.rgb(255, 255, 255), 128);
  f.cover(2, 0, draw.rgba(255, 255, 255, 128), 255);
  f.cover(5, 0, draw.rgb(255, 255, 255), 255);
  let got = [f.pixel(0, 0) & 255, f.pixel(1, 0) & 255, f.pixel(2, 0) & 255];
  free_frame(f);
  return test.assert_eq(got[0].to_string() + " " + got[1].to_string() + " " + got[2].to_string(), "255 128 128");
}

function test_scaled(): test.TestOutcome {
  // Two pixels, black and white, scaled to four: the ends keep their
  // colour and the middle two blend.
  let img = draw.Image { width: 2, height: 1, pixels: [0 as u8, 0 as u8, 0 as u8, 255 as u8, 255 as u8, 255 as u8, 255 as u8, 255 as u8] };
  let big = img.scaled(4, 2);
  let reds: string[] = [];
  for x in 0..4 {
    reds = reds.append((big.pixel(x, 1) & 255).to_string());
  }
  return test.assert_eq(big.width.to_string() + "x" + big.height.to_string() + " " + reds.join(" "), "4x2 0 64 191 255");
}

function test_offscreen_blit(): test.TestOutcome {
  let layer = draw.offscreen(2, 2);
  layer.store(0, 0, 2, 2, draw.rgb(10, 20, 30));
  layer.store(1, 1, 1, 1, draw.rgb(200, 100, 50));
  let f = frame(4, 3);
  f.blit(layer, 2, 1);
  f.blit(layer, -1, -1);
  let got = [f.pixel(2, 1) & 255, f.pixel(3, 2) & 255, f.pixel(0, 0) & 255, f.pixel(1, 1) & 255, f.pixel(0, 2) & 255];
  draw.release(layer);
  free_frame(f);
  let out: string[] = [];
  for g in got {
    out = out.append(g.to_string());
  }
  return test.assert_eq(out.join(" "), "10 200 200 0 0");
}

function test_blend_frame(): test.TestOutcome {
  let layer = draw.offscreen(1, 1);
  layer.store(0, 0, 1, 1, draw.rgb(255, 255, 255));
  let f = frame(2, 1);
  f.blend_frame(layer, 0, 0, 128);
  f.blend_frame(layer, 1, 0, 255);
  let got = (f.pixel(0, 0) & 255).to_string() + " " + (f.pixel(1, 0) & 255).to_string() + " " + (f.pixel(0, 0) >> 24 & 255).to_string();
  draw.release(layer);
  free_frame(f);
  return test.assert_eq(got, "128 255 255");
}

function test_mask(): test.TestOutcome {
  let f = frame(3, 2);
  let cov: u8[] = [255 as u8, 128 as u8, 0 as u8, 0 as u8, 255 as u8, 64 as u8];
  f.mask(0, 0, 3, 2, cov, draw.rgb(255, 0, 0));
  f.mask(2, 1, 3, 2, cov, draw.rgba(0, 255, 0, 128));
  let got: string[] = [];
  for p in [f.pixel(0, 0), f.pixel(1, 0), f.pixel(2, 0), f.pixel(1, 1), f.pixel(2, 1)] {
    got = got.append((p & 255).to_string() + "," + (p >> 8 & 255).to_string());
  }
  free_frame(f);
  return test.assert_eq(got.join(" "), "255,0 128,0 0,0 255,0 31,128");
}

function main(): i32 {
  let r = test.new("std/android/draw");
  r = r.it("rgb packs red, green and blue", test_rgb);
  r = r.it("a disc has a smooth edge", test_disc);
  r = r.it("a ring leaves its middle alone", test_ring);
  r = r.it("a rounded rectangle rounds its corners", test_round_rect);
  r = r.it("fill clips to the frame", test_fill_clips);
  r = r.it("text draws inside its cells", test_text_draws_inside_its_cells);
  r = r.it("a space draws nothing", test_space_draws_nothing);
  r = r.it("scale grows the text", test_scale_grows_the_text);
  r = r.it("the width counts characters, not bytes", test_width_counts_characters);
  r = r.it("text outside the frame is clipped", test_text_outside_is_clipped);
  r = r.it("rgba carries an alpha", test_rgba);
  r = r.it("store writes the pixel word with no blend", test_store);
  r = r.it("a shape with an alpha blends", test_alpha_shapes);
  r = r.it("the Latin letters and the punctuation have glyphs", test_latin_letters_have_glyphs);
  r = r.it("an unknown code point draws as a question mark", test_unknown_code_points_draw_as_question_marks);
  r = r.it("cover_size keeps the shape of an image", test_cover_size_keeps_the_shape);
  r = r.it("an image shows its middle in its box", test_image_copies_the_middle);
  r = r.it("clip_corners rounds the corners of a box", test_clip_corners);
  r = r.it("cover blends a colour by the part of a pixel it covers", test_cover);
  r = r.it("scaled blends the four nearest pixels", test_scaled);
  r = r.it("blit copies an offscreen frame", test_offscreen_blit);
  r = r.it("blend_frame blends a frame by an alpha", test_blend_frame);
  r = r.it("mask blends a colour by a coverage map", test_mask);
  return r.finish();
}
