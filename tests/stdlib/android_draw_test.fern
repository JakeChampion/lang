import "std/android/draw";
import "std/test";

// A frame of `w` by `h` pixels in plain memory, with a stride of w + 3.
function frame(w: i32, h: i32): draw.Frame {
  unsafe {
    let bits = __alloc((w + 3) * h * 4);
    let f = draw.Frame { window: 0 as usize, buffer: 0 as usize, bits: bits, width: w, height: h, stride: w + 3 };
    f.fill(0, 0, w, h, draw.rgb(0, 0, 0));
    return f;
  }
}

function free_frame(own f: draw.Frame): void {
  unsafe {
    __free(f.bits, f.stride * f.height * 4);
  }
}

function count(f: draw.Frame, color: i32): i32 {
  let n = 0;
  for y in 0..f.height {
    for x in 0..f.width {
      if (f.pixel(x, y) == color) {
        n += 1;
      }
    }
  }
  return n;
}

// The disc covers about pi (r - 0.5)^2 pixels fully, has a smooth edge, and
// leaves the pixels outside it alone.
function test_disc(): test.TestOutcome {
  let f: draw.Frame = frame(40, 40);
  defer free_frame(f);
  let white: i32 = draw.rgb(255, 255, 255);
  f.disc(20, 20, 10, white);
  let full: i32 = count(f, white);
  let black: i32 = count(f, draw.rgb(0, 0, 0));
  let edge: i32 = 40 * 40 - full - black;
  let corners: boolean = f.pixel(10, 10) == draw.rgb(0, 0, 0) && f.pixel(20, 20) == white;
  return test.assert_eq((full > 260 && full < 300).to_string() + " " + (edge > 20).to_string() + " " + corners.to_string(), "true true true");
}

// A ring leaves its middle alone.
function test_ring(): test.TestOutcome {
  let f: draw.Frame = frame(40, 40);
  defer free_frame(f);
  let white: i32 = draw.rgb(255, 255, 255);
  f.ring(20, 20, 15, 3, white);
  let middle: boolean = f.pixel(20, 20) == draw.rgb(0, 0, 0);
  let band: boolean = f.pixel(20, 6) == white && f.pixel(6, 20) == white;
  return test.assert_eq(middle.to_string() + " " + band.to_string(), "true true");
}

// A rounded rectangle fills its middle and its sides, and not the tips of
// its corners.
function test_round_rect(): test.TestOutcome {
  let f: draw.Frame = frame(60, 30);
  defer free_frame(f);
  let white: i32 = draw.rgb(255, 255, 255);
  f.round_rect(5, 5, 50, 20, 8, white);
  let inside: boolean = f.pixel(30, 15) == white && f.pixel(30, 5) == white && f.pixel(5, 15) == white;
  let tips: boolean = f.pixel(5, 5) == draw.rgb(0, 0, 0) && f.pixel(54, 24) == draw.rgb(0, 0, 0);
  let outside: boolean = f.pixel(4, 15) == draw.rgb(0, 0, 0) && f.pixel(55, 15) == draw.rgb(0, 0, 0);
  return test.assert_eq(inside.to_string() + " " + tips.to_string() + " " + outside.to_string(), "true true true");
}

function test_rgb(): test.TestOutcome {
  return test.assert_eq(draw.rgb(1, 2, 3), -16777216 | 3 << 16 | 2 << 8 | 1);
}

function test_fill_clips(): test.TestOutcome {
  let f = frame(10, 8);
  defer free_frame(f);
  let red = draw.rgb(255, 0, 0);
  f.fill(7, 5, 10, 10, red);
  f.fill(-5, -5, 6, 7, red);
  return test.assert_eq(count(f, red), 3 * 3 + 1 * 2);
}

function test_text_draws_inside_its_cells(): test.TestOutcome {
  let f = frame(100, 40);
  defer free_frame(f);
  let white = draw.rgb(255, 255, 255);
  f.text(2, 3, "Hi", 1, white);
  let inside = 0;
  let outside = 0;
  for y in 0..f.height {
    for x in 0..f.width {
      if (f.pixel(x, y) != draw.rgb(0, 0, 0)) {
        if (x >= 2 && x < 2 + draw.text_width("Hi", 1) && y >= 3 && y < 3 + draw.text_height(1)) {
          inside += 1;
        } else {
          outside += 1;
        }
      }
    }
  }
  return test.assert_eq((inside > 40).to_string() + " " + outside.to_string() + " " + (count(f, white) > 10).to_string(), "true 0 true");
}

function test_space_draws_nothing(): test.TestOutcome {
  let f = frame(40, 40);
  defer free_frame(f);
  f.text(0, 0, "  ", 1, draw.rgb(255, 255, 255));
  return test.assert_eq(count(f, draw.rgb(0, 0, 0)), 40 * 40);
}

function test_scale_grows_the_text(): test.TestOutcome {
  let small = frame(60, 70);
  let big = frame(60, 70);
  defer free_frame(small);
  defer free_frame(big);
  let white = draw.rgb(255, 255, 255);
  small.text(0, 0, "8", 1, white);
  big.text(0, 0, "8", 2, white);
  return test.assert_eq(count(big, white) >= 3 * count(small, white), true);
}

function test_width_counts_characters(): test.TestOutcome {
  return test.assert_eq(draw.text_width("abc", 2).to_string() + " " + draw.text_width("é", 1).to_string(), (3 * 2 * draw.text_width("a", 1)).to_string() + " " + draw.text_width("a", 1).to_string());
}

function test_text_outside_is_clipped(): test.TestOutcome {
  let f = frame(20, 20);
  defer free_frame(f);
  f.text(-200, -200, "W", 3, draw.rgb(255, 255, 255));
  f.text(15, 15, "W", 3, draw.rgb(255, 255, 255));
  return test.assert_eq(f.pixel(19, 19) != 0, true);
}

function main(): i32 {
  let r = test.new("std/android/draw");
  r = r.it("rgb packs red, green and blue", test_rgb);
  r = r.it("a disc has a smooth edge", test_disc);
  r = r.it("a ring leaves its middle alone", test_ring);
  r = r.it("a rounded rectangle rounds its corners", test_round_rect);
  r = r.it("fill clips to the frame", test_fill_clips);
  r = r.it("text draws inside its cells", test_text_draws_inside_its_cells);
  r = r.it("a space draws nothing", test_space_draws_nothing);
  r = r.it("scale grows the text", test_scale_grows_the_text);
  r = r.it("the width counts characters, not bytes", test_width_counts_characters);
  r = r.it("text outside the frame is clipped", test_text_outside_is_clipped);
  return r.finish();
}
