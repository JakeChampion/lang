import "std/unicode";
import "std/test";
import "std/string";

function test_mixed(): test.TestOutcome {
  return test.assert_true("Hello World".swap_case() == "hELLO wORLD");
}

function test_all_lower(): test.TestOutcome {
  return test.assert_true("abc".swap_case() == "ABC");
}

function test_all_upper(): test.TestOutcome {
  return test.assert_true("ABC".swap_case() == "abc");
}

function test_non_letters(): test.TestOutcome {
  return test.assert_true("123!@#".swap_case() == "123!@#");
}

function test_empty(): test.TestOutcome {
  return test.assert_true("".swap_case() == "");
}

function test_mixed_with_digits(): test.TestOutcome {
  return test.assert_true("MixedCase123".swap_case() == "mIXEDcASE123");
}

function test_involution(): test.TestOutcome {
  return test.assert_true("Hello, World!".swap_case().swap_case() == "Hello, World!");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/string swap_case");
  r = r.it("mixed", test_mixed);
  r = r.it("all lower", test_all_lower);
  r = r.it("all upper", test_all_upper);
  r = r.it("non letters", test_non_letters);
  r = r.it("empty", test_empty);
  r = r.it("mixed with digits", test_mixed_with_digits);
  r = r.it("involution", test_involution);
  return r.finish();
}
