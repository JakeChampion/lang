import "std/test";
import "std/json" as json;
import "std/i64";

function doc(): string {
  return "{\"name\":\"fern\",\"age\":3,\"active\":true,\"tags\":[\"a\",\"b\"],\"meta\":null}";
}

function test_get_string(): test.TestOutcome {
  match (json.parse(doc())) {
    Ok(obj) => {
      match (json.json_get_string(obj, "name")) {
        Some(v) => {
          return test.assert_eq(v, "fern");
        },
        None => {
          return test.fail("expected Some(name)");
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_get_i32(): test.TestOutcome {
  match (json.parse(doc())) {
    Ok(obj) => {
      match (json.json_get_i32(obj, "age")) {
        Some(v) => {
          return test.assert_eq(v, 3);
        },
        None => {
          return test.fail("expected Some(age)");
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_get_bool(): test.TestOutcome {
  match (json.parse(doc())) {
    Ok(obj) => {
      match (json.json_get_bool(obj, "active")) {
        Some(v) => {
          return test.assert_true(v);
        },
        None => {
          return test.fail("expected Some(active)");
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_get_missing(): test.TestOutcome {
  match (json.parse(doc())) {
    Ok(obj) => {
      match (json.json_get_string(obj, "nope")) {
        Some(v) => {
          return test.fail("expected None for missing key");
        },
        None => {
          return test.pass();
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_get_wrong_type(): test.TestOutcome {
  // "name" is a string → json_get_i32 must return None, not coerce.
  match (json.parse(doc())) {
    Ok(obj) => {
      match (json.json_get_i32(obj, "name")) {
        Some(v) => {
          return test.fail("expected None for non-number");
        },
        None => {
          return test.pass();
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_is_null(): test.TestOutcome {
  match (json.parse(doc())) {
    Ok(obj) => {
      match (json.json_get(obj, "meta")) {
        Some(v) => {
          return test.assert_true(json.json_is_null(v));
        },
        None => {
          return test.fail("expected meta key");
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_get_array(): test.TestOutcome {
  match (json.parse(doc())) {
    Ok(obj) => {
      match (json.json_get_array(obj, "tags")) {
        Some(arr) => {
          return test.assert_true(arr.len() == 2 && json.json_encode(arr[0]) == "\"a\"");
        },
        None => {
          return test.fail("expected tags array");
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_encode_array_round_trip(): test.TestOutcome {
  // Array order is deterministic, so the round-trip is exact.
  match (json.parse("[1,2,3]")) {
    Ok(v) => {
      return test.assert_eq(json.json_encode(v), "[1,2,3]");
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_encode_scalars(): test.TestOutcome {
  let ok: boolean = true;
  match (json.parse("true")) {
    Ok(v) => {
      ok = ok && json.json_encode(v) == "true";
    },
    Err(_) => {
      return test.fail("parse true failed");
    }
  }
  match (json.parse("null")) {
    Ok(v) => {
      ok = ok && json.json_encode(v) == "null";
    },
    Err(_) => {
      return test.fail("parse null failed");
    }
  }
  match (json.parse("42")) {
    Ok(v) => {
      ok = ok && json.json_encode(v) == "42";
    },
    Err(_) => {
      return test.fail("parse 42 failed");
    }
  }
  return test.assert_true(ok);
}

function test_encode_string_escape(): test.TestOutcome {
  // A quote inside the string must re-escape on encode.
  match (json.parse("\"a\\\"b\"")) {
    Ok(v) => {
      return test.assert_eq(json.json_encode(v), "\"a\\\"b\"");
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_encode_string_escape_all(): test.TestOutcome {
  let j: string = "\"a\\\"b\\\\c\\nd\\re\\tf\\u0001g\"";
  match (json.parse(j)) {
    Ok(v) => {
      return test.assert_eq(json.json_encode(v), j);
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function __reencode(input: string): string {
  match (json.parse(input)) {
    Ok(v) => {
      return json.json_encode(v);
    },
    Err(_) => {
      return "PARSE_FAIL";
    }
  }
}

function test_parse_string_decode_paths(): test.TestOutcome {
  if (__reencode("\"x\\u00e9y\\ud83d\\ude00z\"") != "\"xéy😀z\"") {
    return test.fail("astral/bmp decode: " + __reencode("\"x\\u00e9y\\ud83d\\ude00z\""));
  }
  let fffd: string = string_from_bytes_unchecked([239 as u8, 191 as u8, 189 as u8]);
  let lone: string = __reencode("\"a\\ud83db\"");
  if (lone != "\"a" + fffd + "b\"") {
    return test.fail("lone surrogate decode: " + lone);
  }
  let long_in: string = "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"";
  return test.assert_eq(__reencode(long_in), long_in);
}

function test_encode_nested_round_trip(): test.TestOutcome {
  let j: string = "{\"items\":[{\"id\":1,\"tag\":\"a\\\"b\"},{\"id\":2,\"kids\":[3,4]}],\"ok\":true}";
  match (json.parse(j)) {
    Ok(v) => {
      return test.assert_eq(json.json_encode(v), j);
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_parse_invalid(): test.TestOutcome {
  // Trailing garbage → None.
  match (json.parse("{\"a\":1} trailing")) {
    Ok(v) => {
      return test.fail("expected None for trailing garbage");
    },
    Err(_) => {
      return test.pass();
    }
  }
}

function test_parse_error_byte_render(): test.TestOutcome {
  match (json.parse("é")) {
    Ok(v) => {
      return test.fail("expected a parse error");
    },
    Err(e) => {
      if (e.message != "unexpected byte '\\xc3'") {
        return test.fail("got: " + e.message);
      }
    }
  }
  match (json.parse("x")) {
    Ok(v) => {
      return test.fail("expected a parse error");
    },
    Err(e) => {
      return test.assert_eq(e.message, "unexpected byte 'x'");
    }
  }
}

function test_parse_unescaped_control(): test.TestOutcome {
  let raw: string[] = ["\"a\tb\"", "[\"x\", \"c\nd\"]", "{\"k\r\": 1}", "\"a\\n\tb\""];
  let want: i32[] = [2, 8, 3, 4];
  let i: i32 = 0;
  while (i < raw.len()) {
    match (json.parse(raw[i])) {
      Ok(_) => {
        return test.fail("accepted a raw control byte: case " + i.to_string());
      },
      Err(e) => {
        if (e.offset != want[i] || e.message != "unexpected control byte in input") {
          return test.fail("case " + i.to_string() + ": " + e.offset.to_string() + " " + e.message);
        }
      }
    }
    i = i + 1;
  }
  match (json.parse("\"a\\tb\"")) {
    Ok(v) => {
      return test.assert_eq(json.json_encode(v), "\"a\\tb\"");
    },
    Err(_) => {
      return test.fail("rejected an escaped tab");
    }
  }
}

function nest(n: i32): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < n) {
    out = out + "[";
    i = i + 1;
  }
  i = 0;
  while (i < n) {
    out = out + "]";
    i = i + 1;
  }
  return out;
}

function test_depth_ok(): test.TestOutcome {
  match (json.parse(nest(50))) {
    Ok(v) => {
      return test.pass();
    },
    Err(_) => {
      return test.fail("50-deep array should parse");
    }
  }
}

function test_depth_limit(): test.TestOutcome {
  match (json.parse(nest(500))) {
    Ok(v) => {
      return test.fail("500-deep array should be rejected");
    },
    Err(_) => {
      return test.pass();
    }
  }
}

function test_get_f64(): test.TestOutcome {
  match (json.parse("{\"x\":3.5}")) {
    Ok(v) => {
      match (json.json_get_f64(v, "x")) {
        Some(f) => {
          let d: f64 = f - 3.5;
          if (d < 0.0) {
            d = 0.0 - d;
          }
          return test.assert_true(d < 0.0001);
        },
        None => {
          return test.fail("expected Some(f64)");
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_get_f64_exp(): test.TestOutcome {
  match (json.parse("{\"x\":1.5e3}")) {
    Ok(v) => {
      match (json.json_get_f64(v, "x")) {
        Some(f) => {
          let d: f64 = f - 1500.0;
          if (d < 0.0) {
            d = 0.0 - d;
          }
          return test.assert_true(d < 0.001);
        },
        None => {
          return test.fail("expected Some(f64)");
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_get_i32_overflow(): test.TestOutcome {
  match (json.parse("{\"x\":2147483648}")) {
    Ok(v) => {
      match (json.json_get_i32(v, "x")) {
        Some(x) => {
          return test.fail("expected None on i32 overflow");
        },
        None => {
          return test.pass();
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_get_i64_overflow(): test.TestOutcome {
  match (json.parse("{\"x\":99999999999999999999}")) {
    Ok(v) => {
      match (json.json_get_i64(v, "x")) {
        Some(x) => {
          return test.fail("expected None on i64 overflow");
        },
        None => {
          return test.pass();
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function __i64_get(lit: string): string {
  match (json.parse("{\"x\":" + lit + "}")) {
    Ok(v) => {
      match (json.json_get_i64(v, "x")) {
        Some(n) => {
          return n.to_string();
        },
        None => {
          return "<none>";
        }
      }
    },
    Err(_) => {
      return "<parse>";
    }
  }
}

function __i64_decode(lit: string): string {
  match (json.decode[i64](lit)) {
    Ok(n) => {
      return n.to_string();
    },
    Err(_) => {
      return "<err>";
    }
  }
}

function test_i64_bounds(): test.TestOutcome {
  let lits: string[] = ["0", "-0", "-42", "9223372036854775807", "-9223372036854775808", "9223372036854775808", "-9223372036854775809", "1.5"];
  let got: string = "";
  let dec: string = "";
  for lit in lits {
    got = got + __i64_get(lit) + " ";
    dec = dec + __i64_decode(lit) + " ";
  }
  let want: string = "0 0 -42 9223372036854775807 -9223372036854775808 <none> <none> <none> ";
  if (got != want) {
    return test.assert_eq(got, want);
  }
  return test.assert_eq(dec, "0 0 -42 9223372036854775807 -9223372036854775808 <err> <err> <err> ");
}

function test_pretty_scalars_and_empties(): test.TestOutcome {
  if (json.json_encode_pretty(JNumber("42"), 2) != "42") {
    return test.fail("number");
  }
  if (json.json_encode_pretty(JString("hi"), 2) != "\"hi\"") {
    return test.fail("string");
  }
  if (json.json_encode_pretty(JBool(true), 2) != "true") {
    return test.fail("bool");
  }
  if (json.json_encode_pretty(JNull, 2) != "null") {
    return test.fail("null");
  }
  let empty: json.JsonValue[] = [];
  if (json.json_encode_pretty(JArray(empty), 2) != "[]") {
    return test.fail("empty array");
  }
  return test.pass();
}

function test_pretty_structure(): test.TestOutcome {
  match (json.parse("{\"a\":1,\"b\":[10,20]}")) {
    Ok(v) => {
      let p: string = json.json_encode_pretty(v, 2);
      if (!p.contains("\n")) {
        return test.fail("no newline");
      }
      if (!p.contains("  \"a\": 1")) {
        return test.fail("no member indent");
      }
      if (!p.contains("    10")) {
        return test.fail("no nested array indent");
      }
      return test.pass();
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_pretty_roundtrip(): test.TestOutcome {
  let src: string = "{\"name\":\"fern\",\"nums\":[1,2,3],\"nested\":{\"ok\":true},\"e\":{}}";
  match (json.parse(src)) {
    Ok(v) => {
      match (json.parse(json.json_encode_pretty(v, 4))) {
        Ok(v2) => {
          return test.assert_eq(json.json_encode(v2), json.json_encode(v));
        },
        Err(_) => {
          return test.fail("pretty did not re-parse");
        }
      }
    },
    Err(_) => {
      return test.fail("parse failed");
    }
  }
}

function test_escape_named(): test.TestOutcome {
  return test.assert_eq(json.json_escape("a\"b\\c\nd\re\tf"), "a\\\"b\\\\c\\nd\\re\\tf");
}

function test_escape_control_bytes(): test.TestOutcome {
  let s: string = string_from_bytes_unchecked([1 as u8, 31 as u8]);
  return test.assert_eq(json.json_escape(s), "\\u0001\\u001f");
}

function test_escape_passthrough(): test.TestOutcome {
  if (json.json_escape("") != "") {
    return test.fail("empty string should escape to empty");
  }
  return test.assert_eq(json.json_escape("héllo wörld"), "héllo wörld");
}

function test_escape_matches_encoder(): test.TestOutcome {
  let raw: string = "x\x02\"y\\z\n";
  return test.assert_eq("\"" + json.json_escape(raw) + "\"", json.json_encode(JString(raw)));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/json roundtrip");
  r = r.it("escape named", test_escape_named);
  r = r.it("escape control bytes", test_escape_control_bytes);
  r = r.it("escape passthrough", test_escape_passthrough);
  r = r.it("escape matches encoder", test_escape_matches_encoder);
  r = r.it("get_string", test_get_string);
  r = r.it("get_i32", test_get_i32);
  r = r.it("get_bool", test_get_bool);
  r = r.it("get missing", test_get_missing);
  r = r.it("get wrong type", test_get_wrong_type);
  r = r.it("is_null", test_is_null);
  r = r.it("get_array", test_get_array);
  r = r.it("encode array round trip", test_encode_array_round_trip);
  r = r.it("encode scalars", test_encode_scalars);
  r = r.it("encode string escape", test_encode_string_escape);
  r = r.it("encode string escape all", test_encode_string_escape_all);
  r = r.it("parse string decode paths", test_parse_string_decode_paths);
  r = r.it("encode nested round trip", test_encode_nested_round_trip);
  r = r.it("parse invalid", test_parse_invalid);
  r = r.it("parse error byte render", test_parse_error_byte_render);
  r = r.it("parse unescaped control", test_parse_unescaped_control);
  r = r.it("depth ok", test_depth_ok);
  r = r.it("depth limit", test_depth_limit);
  r = r.it("get_f64", test_get_f64);
  r = r.it("get_f64 exp", test_get_f64_exp);
  r = r.it("get_i32 overflow", test_get_i32_overflow);
  r = r.it("get_i64 overflow", test_get_i64_overflow);
  r = r.it("i64 bounds", test_i64_bounds);
  r = r.it("pretty scalars/empties", test_pretty_scalars_and_empties);
  r = r.it("pretty structure", test_pretty_structure);
  r = r.it("pretty roundtrip", test_pretty_roundtrip);
  return r.finish();
}
