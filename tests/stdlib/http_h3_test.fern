import "std/test";
import "std/http/h3";
import "std/http/qpack";
import "std/hex";
import "std/codec";
import "std/string";
import "std/option";

struct Link { c: h3.Session, s: h3.Session, log: string, trickle: boolean }

function linked(): Link {
  let c = h3.client(h3.config()).start(2 as i64, 6 as i64, 10 as i64);
  let s = h3.server(h3.config()).start(3 as i64, 7 as i64, 11 as i64);
  return flow(Link { c: c, s: s, log: "", trickle: false });
}

function flow(p: Link): Link {
  let cur = p;
  let rounds = 0;
  while (rounds < 20) {
    let step1 = cur.c;
    let cacts = step1.actions;
    let cevs = step1.events;
    let c = step1.taken();
    let step2 = cur.s;
    let sacts = step2.actions;
    let sevs = step2.events;
    let s = step2.taken();
    cur = Link { ...cur, c: c, s: s, log: cur.log + noted("client", cevs) + noted("server", sevs) };
    if (cacts.len() == 0 && sacts.len() == 0) {
      return cur;
    }
    for a in cacts {
      cur = Link { ...cur, s: deliver(cur.s, a, cur.trickle), log: cur.log + acted("client", a) };
    }
    for a in sacts {
      cur = Link { ...cur, c: deliver(cur.c, a, cur.trickle), log: cur.log + acted("server", a) };
    }
    rounds += 1;
  }
  return cur;
}

function deliver(to: h3.Session, a: h3.Action, trickle: boolean): h3.Session {
  match (a) {
    h3.Write(id, bytes, fin) => {
      if (!trickle || bytes.len() <= 1) {
        return to.on_stream(id, bytes, fin);
      }
      let cur = to;
      let i = 0;
      while (i < bytes.len()) {
        cur = cur.on_stream(id, bytes[i:i + 1], fin && i == bytes.len() - 1);
        i += 1;
      }
      return cur;
    },
    h3.Abort(id, code) => {
      return to.on_reset(id, code);
    },
    _ => {
      return to;
    }
  }
}

function acted(who: string, a: h3.Action): string {
  match (a) {
    h3.Abort(id, code) => {
      return who + " aborts " + id.to_string() + " " + code.to_string() + "; ";
    },
    h3.Stop(id, code) => {
      return who + " stops " + id.to_string() + " " + code.to_string() + "; ";
    },
    h3.CloseConnection(code, why) => {
      return who + " closes " + code.to_string() + " " + why + "; ";
    },
    _ => {
      return "";
    }
  }
}

function noted(who: string, evs: h3.Event[]): string {
  let out = "";
  for e in evs {
    out = out + who + " " + event_text(e) + "; ";
  }
  return out;
}

function event_text(e: h3.Event): string {
  match (e) {
    h3.HeadersReceived(id, fs) => {
      return "headers " + id.to_string() + " " + fields_text(fs);
    },
    h3.DataReceived(id, data) => {
      return "data " + id.to_string() + " " + unsafe { string_from_bytes_unchecked(data) };
    },
    h3.TrailersReceived(id, fs) => {
      return "trailers " + id.to_string() + " " + fields_text(fs);
    },
    h3.StreamEnded(id) => {
      return "end " + id.to_string();
    },
    h3.StreamAborted(id, code) => {
      return "aborted " + id.to_string() + " " + code.to_string();
    },
    h3.GoawayReceived(id) => {
      return "goaway " + id.to_string();
    }
  }
}

function fields_text(fs: qpack.Field[]): string {
  let out = "[";
  for f in fs {
    out = out + f.name + "=" + f.value + " ";
  }
  return out + "]";
}

function get(path: string): qpack.Field[] {
  return [qpack.field(":method", "GET"), qpack.field(":scheme", "https"), qpack.field(":authority", "example.com"), qpack.field(":path", path)];
}

function post(length: string): qpack.Field[] {
  return [qpack.field(":method", "POST"), qpack.field(":scheme", "https"), qpack.field(":authority", "example.com"), qpack.field(":path", "/upload"), qpack.field("content-length", length)];
}

function test_reordered_low_stream(): test.TestOutcome {
  let p = linked();
  let k = 1;
  while (k <= 32) {
    let id = k as i64 * 4;
    p = flow(Link { ...p, log: "", c: p.c.send_headers(id, get("/h"), true) });
    p = flow(Link { ...p, log: "", s: p.s.send_headers(id, [qpack.field(":status", "200")], true) });
    k += 1;
  }
  p = flow(Link { ...p, log: "", c: p.c.send_headers(0 as i64, get("/late"), true) });
  if (count(p.log, "server headers 0 ") != "1") {
    return test.fail("the late low request stream was dropped: " + p.log);
  }
  p = flow(Link { ...p, log: "", s: p.s.send_headers(0 as i64, [qpack.field(":status", "200")], true) });
  return test.assert_eq(count(p.log, "client headers 0 [:status=200 "), "1");
}

function test_request_response(): test.TestOutcome {
  let p = linked();
  let settings = "-";
  if let Some(ps) = p.c.peer_settings() {
    settings = ps.max_table_capacity.to_string() + "/" + ps.blocked_streams.to_string() + "/" + ps.max_field_section_size.to_string();
  }
  p = flow(Link { ...p, c: p.c.send_headers(0 as i64, get("/"), true), log: "" });
  p = flow(Link { ...p, s: p.s.send_headers(0 as i64, [qpack.field(":status", "200"), qpack.field("content-type", "text/plain")], false).send_data(0 as i64, "hello".bytes(), true) });
  return test.assert_eq(settings + " | " + p.log, "4096/16/65536 | server headers 0 [:method=GET :scheme=https :authority=example.com :path=/ ]; server end 0; client headers 0 [:status=200 content-type=text/plain ]; client data 0 hello; client end 0; ");
}

function writes_on(s: h3.Session, id: i64): i32 {
  let n = 0;
  for a in s.actions {
    match (a) {
      h3.Write(on, _, _) => {
        if (on == id) {
          n += 1;
        }
      },
      _ => {}
    }
  }
  return n;
}

function test_send_section(): test.TestOutcome {
  let p = linked();
  p = flow(Link { ...p, c: p.c.send_headers(0 as i64, get("/"), true).send_headers(4 as i64, get("/t"), true).send_headers(8 as i64, get("/e"), true), log: "" });
  let enc = p.s.enc;
  let head = enc.put_status(enc.section(16), 200);
  head = enc.put(head, "content-type", "text/plain");
  let s = p.s.send_section(0 as i64, head, "hello".as_bytes(), true);
  s = s.send_section(4 as i64, enc.encode([qpack.field(":status", "200")]), "ab".as_bytes(), false).send_trailers(4 as i64, [qpack.field("x-done", "1")]);
  s = s.send_section(8 as i64, enc.put_status(enc.section(0), 200), [], true);
  let writes = writes_on(s, 0 as i64).to_string() + "/" + writes_on(s, 4 as i64).to_string() + "/" + writes_on(s, 8 as i64).to_string();
  p = flow(Link { ...p, s: s, log: "" });
  return test.assert_eq(writes + " | " + p.log, "1/2/1 | client headers 0 [:status=200 content-type=text/plain ]; client data 0 hello; client end 0; client headers 4 [:status=200 ]; client data 4 ab; client trailers 4 [x-done=1 ]; client end 4; client headers 8 [:status=200 ]; client end 8; ");
}

function test_body_trailers_interim(): test.TestOutcome {
  let p = linked();
  p = Link { ...p, trickle: true, log: "" };
  let c = p.c.send_headers(0 as i64, post("6"), false).send_data(0 as i64, "abc".bytes(), false).send_data(0 as i64, "def".bytes(), false).send_trailers(0 as i64, [qpack.field("x-sum", "ok")]);
  p = flow(Link { ...p, c: c });
  let body = count(p.log, "server data 0 ");
  p = flow(Link { ...p, log: "", s: p.s.send_headers(0 as i64, [qpack.field(":status", "103"), qpack.field("link", "</a>")], false).send_headers(0 as i64, [qpack.field(":status", "204")], true) });
  return test.assert_eq(body + " | " + p.log, "6 | client headers 0 [:status=103 link=</a> ]; client headers 0 [:status=204 ]; client end 0; ");
}

function count(s: string, needle: string): string {
  let n = 0;
  let rest = s;
  while (true) {
    let Some(at) = rest.index_of(needle) else {
      break;
    };
    n += 1;
    rest = rest.drop(at + needle.len());
  }
  return n.to_string();
}

function test_bodiless(): test.TestOutcome {
  let p = linked();
  let head: qpack.Field[] = [qpack.field(":method", "HEAD"), qpack.field(":scheme", "https"), qpack.field(":authority", "example.com"), qpack.field(":path", "/")];
  p = flow(Link { ...p, c: p.c.send_headers(0 as i64, head, true).send_headers(4 as i64, get("/cached"), true) });
  p = flow(Link { ...p, log: "", s: p.s.send_headers(0 as i64, [qpack.field(":status", "200"), qpack.field("content-length", "12")], true).send_headers(4 as i64, [qpack.field(":status", "304"), qpack.field("content-length", "40")], true) });
  return test.assert_eq(p.log, "client headers 0 [:status=200 content-length=12 ]; client end 0; client headers 4 [:status=304 content-length=40 ]; client end 4; ");
}

function test_malformed(): test.TestOutcome {
  let cases: qpack.Field[][] = [
    [qpack.field(":method", "GET"), qpack.field(":scheme", "https"), qpack.field(":path", "/"), qpack.field("X-Upper", "1")],
    [qpack.field(":method", "GET"), qpack.field(":scheme", "https")],
    [qpack.field(":method", "GET"), qpack.field(":scheme", "https"), qpack.field(":path", "/"), qpack.field("connection", "close")],
    [qpack.field(":method", "GET"), qpack.field(":scheme", "https"), qpack.field(":path", "/"), qpack.field("te", "gzip")],
    [qpack.field(":method", "GET"), qpack.field("accept", "*/*"), qpack.field(":scheme", "https"), qpack.field(":path", "/")],
    [qpack.field(":method", "CONNECT"), qpack.field(":scheme", "https"), qpack.field(":authority", "example.com")],
    [qpack.field(":method", "GET"), qpack.field(":scheme", "https"), qpack.field(":path", "/")],
    [qpack.field(":method", "GET"), qpack.field(":scheme", "https"), qpack.field(":authority", "a"), qpack.field(":path", "/"), qpack.field("host", "b")],
    [qpack.field(":method", "GET"), qpack.field(":scheme", "https"), qpack.field(":authority", ""), qpack.field(":path", "/")],
  ];
  let out = "";
  let id: i64 = 0;
  for fs in cases {
    let p = linked();
    p = flow(Link { ...p, log: "", c: p.c.send_headers(id, fs, true) });
    out = out + p.log + "\n";
  }
  let len = linked();
  len = flow(Link { ...len, log: "", c: len.c.send_headers(0 as i64, post("5"), false).send_data(0 as i64, "abc".bytes(), true) });
  out += len.log;
  let hosted = linked();
  hosted = flow(Link { ...hosted, log: "", c: hosted.c.send_headers(0 as i64, [qpack.field(":method", "GET"), qpack.field(":scheme", "https"), qpack.field(":path", "/h"), qpack.field("host", "example.com")], true) });
  out += "\n" + hosted.log;
  let want = "";
  let i = 0;
  while (i < 9) {
    want += "server aborted 0 270; server aborts 0 270; server stops 0 270; client aborted 0 270; \n";
    i += 1;
  }
  return test.assert_eq(out, want + "server headers 0 [:method=POST :scheme=https :authority=example.com :path=/upload content-length=5 ]; server data 0 abc; server aborted 0 270; server aborts 0 270; server stops 0 270; client aborted 0 270; \nserver headers 0 [:method=GET :scheme=https :path=/h host=example.com ]; server end 0; ");
}

function req_with(method: string, authority: string, path: string, more: qpack.Field[]): qpack.Field[] {
  let out: qpack.Field[] = [qpack.field(":method", method), qpack.field(":scheme", "https"), qpack.field(":authority", authority), qpack.field(":path", path)];
  for f in more {
    out = out.append(f);
  }
  return out;
}

function test_field_and_target_values(): test.TestOutcome {
  let none: qpack.Field[] = [];
  let cases: qpack.Field[][] = [
    req_with("GET", "a.test", "/static/../../etc/passwd", none),
    req_with("GET", "a.test", "/a%2Fb%00c", none),
    req_with("GET", "a.test", "admin", none),
    req_with("GET", "a.test", "/a HTTP/1.1\r\nx-inj: 1\r\n\r\nGET /b", none),
    req_with("GET /x HTTP/1.1\r\nHost: evil\r\n\r\nGET", "a.test", "/", none),
    req_with("GET", "a.test\r\nx-forwarded-for: 127.0.0.1", "/", none),
    req_with("GET", "user@a.test", "/", none),
    req_with("GET", "a.test", "/", [qpack.field("x-a", "1\r\nx-admin: true")]),
    req_with("GET", "a.test", "/", [qpack.field("x-n", "a\x00b")]),
    req_with("GET", "a.test", "/", [qpack.field("bad name", "v")]),
    req_with("GET", "a.test", "/", [qpack.field("host", "a.test"), qpack.field("host", "evil.test")]),
  ];
  let i = 0;
  let id: i64 = 0;
  for fs in cases {
    let p = linked();
    p = flow(Link { ...p, log: "", c: p.c.send_headers(id, fs, true) });
    if (p.log != "server aborted 0 270; server aborts 0 270; server stops 0 270; client aborted 0 270; ") {
      return test.fail("case " + i.to_string() + ": " + p.log);
    }
    i += 1;
  }
  let trailed = linked();
  trailed = flow(Link { ...trailed, log: "", c: trailed.c.send_headers(id, post("3"), false).send_data(id, "abc".bytes(), false).send_headers(id, [qpack.field("Bad Name", "a\r\nb")], true) });
  return test.assert_true(trailed.log.ends_with("server aborted 0 270; server aborts 0 270; server stops 0 270; client aborted 0 270; "));
}

function test_connection_errors(): test.TestOutcome {
  let p = linked();
  let out = closes(p.s.on_stream(0 as i64, __codec_bytes(hex.decode("000161")), false));
  out += closes(h3.server(h3.config()).on_stream(2 as i64, __codec_bytes(hex.decode("00070100")), false));
  out += closes(p.s.on_stream(14 as i64, __codec_bytes(hex.decode("000400")), false));
  out += closes(h3.server(h3.config()).on_stream(2 as i64, __codec_bytes(hex.decode("0004020300")), false));
  out += closes(p.s.on_stream(6 as i64, [], true));
  out += closes(p.s.on_stream(18 as i64, __codec_bytes(hex.decode("01")), false));
  out += closes(p.s.on_stream(22 as i64, __codec_bytes(hex.decode("21")), false));
  out += closes(linked().s.on_stream(2 as i64, __codec_bytes(hex.decode("030100")), false));
  out += closes(linked().s.on_stream(2 as i64, __codec_bytes(hex.decode("0d01050d0103")), false));
  out += closes(linked().s.on_stream(2 as i64, __codec_bytes(hex.decode("070100070104")), false));
  out += closes(linked().s.on_stream(2 as i64, __codec_bytes(hex.decode("0d020500")), false));
  out += closes(linked().s.on_stream(2 as i64, __codec_bytes(hex.decode("07c000000040000000")), false));
  out += closes(linked().s.on_stream(2 as i64, __codec_bytes(hex.decode("0d0105030103070104070100")), false));
  let step3 = p.c.send_headers(4 as i64, get("/g"), true);
  let cacts = step3.actions;
  let request: u8[] = [];
  for a in cacts {
    if let h3.Write(id, bytes, _) = a {
      if (id == 4) {
        request = bytes;
      }
    }
  }
  let step4 = p.s.on_stream(4 as i64, __codec_bytes(hex.decode("2103abcdef")).concat(request), true);
  let evs = step4.events;
  return test.assert_eq(out + "| " + noted("server", evs), "261 DATA outside a message's body; 266 the control stream did not open with SETTINGS; 259 a second critical stream of one type; 265 a repeated setting, or one of HTTP/2's; 260 a critical stream ended; 259 a push stream from a client; stop 22 259; 264 a CANCEL_PUSH for a push ID past MAX_PUSH_ID; 264 a MAX_PUSH_ID that went down; 264 a GOAWAY push ID that rose; 262 MAX_PUSH_ID with octets after its identifier; 263 a frame larger than this side reads; open; | server headers 4 [:method=GET :scheme=https :authority=example.com :path=/g ]; server end 4; ");
}

function closes(s: h3.Session): string {
  let step5 = s;
  let acts = step5.actions;
  for a in acts {
    match (a) {
      h3.CloseConnection(code, why) => {
        return code.to_string() + " " + why + "; ";
      },
      h3.Stop(id, code) => {
        return "stop " + id.to_string() + " " + code.to_string() + "; ";
      },
      _ => {}
    }
  }
  return "open; ";
}

function test_goaway(): test.TestOutcome {
  let p = linked();
  p = flow(Link { ...p, log: "", c: p.c.send_headers(0 as i64, get("/a"), true).send_headers(4 as i64, get("/b"), true) });
  p = flow(Link { ...p, log: "", s: p.s.send_goaway(4 as i64) });
  return test.assert_eq(p.log + p.c.goaway_received().to_string(), "client goaway 4; client aborted 4 267; 4");
}

function test_qpack_blocked(): test.TestOutcome {
  let s = h3.server(h3.config()).start(3 as i64, 7 as i64, 11 as i64);
  let step6 = s;
  let s0 = step6.taken();
  let section = "03811011d1d7";
  let headers = "0106" + section;
  let step7 = s0.on_stream(0 as i64, __codec_bytes(hex.decode(headers)), true);
  let acts1 = step7.actions;
  let evs1 = step7.events;
  let s1 = step7.taken();
  let encoder: string = "02" + "3fbd01c00f7777772e6578616d706c652e636f6dc10c2f73616d706c652f70617468";
  let step8 = s1.on_stream(6 as i64, __codec_bytes(hex.decode(encoder)), false);
  let acts2 = step8.actions;
  let evs2 = step8.events;
  let written = "";
  for a in acts2 {
    if let h3.Write(id, bytes, _) = a {
      written = written + id.to_string() + ":" + hex.encode(bytes) + " ";
    }
  }
  let waits = s0.waiting(0 as i64).to_string() + " " + s1.waiting(0 as i64).to_string() + " " + step8.waiting(0 as i64).to_string();
  return test.assert_eq(waits + " | " + int_text(acts1.len()) + " " + int_text(evs1.len()) + " | " + noted("server", evs2) + "| " + written, "false true false | 0 0 | server headers 0 [:authority=www.example.com :path=/sample/path :method=GET :scheme=https ]; server end 0; | 11:02 11:80 ");
}

// A control stream that starts with a SETTINGS frame of `count` settings
// with identifiers that this side does not know.
function settings_stream(count: i32): u8[] {
  let n = count * 3;
  let out: u8[] = [0u8, 4u8, (64 + (n >> 8)) as u8, (n & 255) as u8];
  let i = 0;
  while (i < count) {
    out = out.append(64u8).append((100 + i) as u8).append(0u8);
    i += 1;
  }
  return out;
}

function test_settings_limit(): test.TestOutcome {
  let server = h3.server(h3.config()).start(3 as i64, 7 as i64, 11 as i64).taken();
  let most = server.on_stream(2 as i64, settings_stream(h3.MAX_SETTINGS), false);
  let over = server.on_stream(2 as i64, settings_stream(h3.MAX_SETTINGS + 1), false);
  return test.assert_eq(closes(most) + closes(over), "open; 263 more settings than this side reads; ");
}

// A unidirectional stream of a type that this side does not know is
// stopped. The session holds no record of it after it ends.
function test_finished_uni_streams_are_forgotten(): test.TestOutcome {
  let server = h3.server(h3.config()).start(3 as i64, 7 as i64, 11 as i64).taken();
  let before = server.unis.len();
  let cur = server;
  let stops = 0;
  let k = 0;
  while (k < 50) {
    cur = cur.on_stream(k as i64 * 4 + 2, [33u8, 1u8, 2u8], true);
    for a in cur.actions {
      match (a) {
        h3.Stop(id, code) => {
          stops += 1;
        },
        _ => {}
      }
    }
    cur = cur.taken();
    k += 1;
  }
  let ended = cur.unis.len() - before;
  // A stream that stays open has a record until it ends or is reset.
  let open = cur.on_stream(402 as i64, [33u8], false).on_stream(406 as i64, [33u8], false).on_stream(410 as i64, [], false);
  let held = open.unis.len() - before;
  let closed = open.on_stream(402 as i64, [9u8], true).on_reset(406 as i64, 0 as i64).on_stream(410 as i64, [], true);
  return test.assert_eq(stops.to_string() + " " + ended.to_string() + " " + held.to_string() + " " + (closed.unis.len() - before).to_string() + " " + closes(closed.taken()), "50 0 3 0 open; ");
}

// The bytes of a complete request on stream `id`, from a new client.
function request_bytes(id: i64): u8[] {
  let out: u8[] = [];
  for a in h3.client(h3.config()).start(2 as i64, 6 as i64, 10 as i64).send_headers(id, get("/again"), true).actions {
    match (a) {
      h3.Write(at, bytes, fin) => {
        if (at == id) {
          out = out.concat(bytes);
        }
      },
      _ => {}
    }
  }
  return out;
}

function test_finished_stream_stays_finished(): test.TestOutcome {
  let bad: qpack.Field[] = [qpack.field(":method", "GET"), qpack.field(":scheme", "https")];
  let p = linked();
  p = flow(Link { ...p, log: "", c: p.c.send_headers(0 as i64, bad, true) });
  let late = p.s.on_stream(0 as i64, request_bytes(0 as i64), true);
  let out = noted("server", late.events) + "|";
  // After the sweep of the request table, the streams that it removed are
  // finished also, and a stream that has not started is not.
  let k = 1;
  while (k <= 40) {
    p = flow(Link { ...p, log: "", c: p.c.send_headers(k as i64 * 4, bad, true) });
    k += 1;
  }
  let swept = p.s.on_stream(0 as i64, request_bytes(0 as i64), true).on_stream(80 as i64, request_bytes(80 as i64), true);
  out += noted("server", swept.events) + "|";
  let next = p.s.on_stream(164 as i64, request_bytes(164 as i64), true);
  return test.assert_eq(out + noted("server", next.events), "||server headers 164 [:method=GET :scheme=https :authority=example.com :path=/again ]; server end 164; ");
}

function test_slot_sharing(): test.TestOutcome {
  let headers = __codec_bytes(hex.decode("0106" + "03811011d1d7"));
  let s = h3.server(h3.config()).start(3 as i64, 7 as i64, 11 as i64).taken();
  s = s.on_stream(0 as i64, headers, true).on_stream(4 as i64, headers, true).taken();
  let waits = "";
  for id in [0 as i64, 1 as i64, 2 as i64, 4 as i64, 5 as i64, 6 as i64, 10 as i64] {
    waits = waits + id.to_string() + "=" + s.waiting(id).to_string() + " ";
  }
  let encoder: string = "02" + "3fbd01c00f7777772e6578616d706c652e636f6dc10c2f73616d706c652f70617468";
  let step = s.on_stream(6 as i64, __codec_bytes(hex.decode(encoder)), false);
  let evs = noted("server", step.events);
  let unblocked = (evs.contains("headers 0 ") && evs.contains("headers 4 ")).to_string() + " " + step.waiting(0 as i64).to_string() + " " + step.waiting(4 as i64).to_string();
  let c = h3.client(h3.config()).start(2 as i64, 6 as i64, 10 as i64).send_headers(0 as i64, get("/a"), true).taken();
  let c2 = c.on_stream(1 as i64, __codec_bytes(hex.decode("01030000d9")), false);
  return test.assert_eq(waits + "| " + unblocked + " | client [" + noted("client", c2.events) + "]", "0=true 1=false 2=false 4=true 5=false 6=false 10=false | true false false | client []");
}

function int_text(n: i32): string {
  return n.to_string();
}

function main(): i32 {
  let r = test.new("std/http/h3");
  r = r.it("a request and its response", test_request_response);
  r = r.it("a response's header section and body go out as one write", test_send_section);
  r = r.it("a body and trailers a byte at a time, and an interim response", test_body_trailers_interim);
  r = r.it("HEAD and 304 responses carry no body", test_bodiless);
  r = r.it("malformed messages are stream errors", test_malformed);
  r = r.it("field values, names and request targets are checked", test_field_and_target_values);
  r = r.it("frames out of place are connection errors", test_connection_errors);
  r = r.it("GOAWAY", test_goaway);
  r = r.it("a field section blocked on QPACK", test_qpack_blocked);
  r = r.it("a request stream below the swept window is still answered", test_reordered_low_stream);
  r = r.it("later bytes on a finished request stream do not start a request", test_finished_stream_stays_finished);
  r = r.it("a SETTINGS frame has a limit on its settings", test_settings_limit);
  r = r.it("a unidirectional stream that ended is forgotten", test_finished_uni_streams_are_forgotten);
  r = r.it("a stream is not taken for the request sharing its slot", test_slot_sharing);
  return r.finish();
}

function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
