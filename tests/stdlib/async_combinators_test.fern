import "std/test";
import "std/async";
import "std/time";

// tests/stdlib/async_combinators_test.fern — the supported
// structured-concurrency surface (docs/ASYNC-REDESIGN.md): the
// `gather` / `race` / `with_deadline` combinators over `Future[T]`.
//
// These exercise the PORTABLE contract — fan-outs of already-`Ready`
// futures, which resolve on every backend (interp / wasm / native).
// `Pending` (real-fd) futures are proven separately in the Go e2e
// suite (async_combinators_test.go, async_fetch_future_test.go) since
// they need real sockets.
//
// Run:  fern -interp tests/stdlib/async_combinators_test.fern

// gather collects every future's value in input order.
function test_gather_all(): test.TestOutcome {
  let fs: async.Future[i32][] = [Ready(5), Ready(7), Ready(30)];
  let got: i32[] = async.gather(fs, -1);
  if (got.len() != 3) {
    return test.fail("expected 3 results");
  }
  return test.assert_eq(got[0] + got[1] + got[2], 42);
}

// gather over string futures — generic over T (the i32-throughout
// restriction is gone).
function test_gather_strings(): test.TestOutcome {
  let fs: async.Future[string][] = [Ready("hello"), Ready("world")];
  let got: string[] = async.gather(fs, "");
  return test.assert_eq(got[0] + "-" + got[1], "hello-world");
}

// race returns (winnerIndex, value); an already-Ready future at the
// lowest index wins immediately.
function test_race_first_ready(): test.TestOutcome {
  let fs: async.Future[i32][] = [Ready(9), Ready(8), Ready(7)];
  let (w, v) = async.race(fs, -1);
  if (w != 0) {
    return test.fail("winner=" + w.to_string());
  }
  return test.assert_eq(v, 9);
}

// with_deadline returns Option[T] per future: Some for ready, None for
// timed out. All ready here (none miss the budget) → all Some.
function test_deadline_all_ready(): test.TestOutcome {
  let fs: async.Future[i32][] = [Ready(40), Ready(2)];
  let got: Option[i32][] = async.with_deadline(time.duration_millis(50), fs);
  let sum: i32 = 0;
  match (got[0]) {
    Some(v) => {
      sum = sum + v;
    },
    None => {}
  }
  match (got[1]) {
    Some(v) => {
      sum = sum + v;
    },
    None => {}
  }
  return test.assert_eq(sum, 42);
}

// An empty fan-out gathers to an empty result.
function test_gather_empty(): test.TestOutcome {
  let fs: async.Future[i32][] = [];
  let got: i32[] = async.gather(fs, -1);
  return test.assert_eq(got.len(), 0);
}

// `parks()` says what a task that waits on a descriptor nothing writes to
// does: parks (Suspended) under a scheduler, returns at its bound (Done)
// under the blocking fallback.
function test_parks_agrees(): test.TestOutcome {
  match (pipe()) {
    Ok(q) => {
      let fd: i32 = q.r.fd;
      let t: async.Task[i32] = async.task_new((): i32 => async.wait_any([fd, 1], 0));
      let parked: boolean = false;
      match (async.task_start(t)) {
        Suspended(w) => {
          parked = true;
          let st: async.TaskStatus[i32] = async.task_cancel(t);
        },
        _ => {}
      }
      async.task_free(t);
      q.r.close();
      q.w.close();
      return test.assert_eq(async.parks(), parked);
    },
    Err(e) => {
      return test.fail("pipe failed");
    }
  }
  return test.fail("unreachable");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("async combinators");
  r = r.it("gather all", test_gather_all);
  r = r.it("gather strings", test_gather_strings);
  r = r.it("race first ready", test_race_first_ready);
  r = r.it("with_deadline all ready", test_deadline_all_ready);
  r = r.it("gather empty", test_gather_empty);
  r = r.it("parks agrees with a parked task", test_parks_agrees);
  return r.finish();
}
