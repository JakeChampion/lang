import "core/cmp";
import "std/json";
import "std/test";

@derive(cmp.Eq, cmp.Display, cmp.Ord, cmp.Hash, json.Json)
struct Point { x: i32, y: i32 }

@derive(cmp.Eq, cmp.Display)
struct Inner { n: i32 }

@derive(cmp.Eq, cmp.Display)
struct Outer { a: Inner, tag: string }

@derive(cmp.Eq, cmp.Display, cmp.Ord, cmp.Hash, json.Json)
enum Shape { Circle(i32), Square(i32), Empty }

function test_eq_reflexive(): test.TestOutcome {
  let a: Point = Point { x: 3, y: 7 };
  let b: Point = Point { x: 3, y: 7 };
  if (a.eq(b)) {
    return test.pass();
  }
  return test.fail("equal points should be eq");
}

function test_eq_distinguishes(): test.TestOutcome {
  let a: Point = Point { x: 3, y: 7 };
  let c: Point = Point { x: 3, y: 9 };
  if (!a.eq(c)) {
    return test.pass();
  }
  return test.fail("differing points should not be eq");
}

function test_display(): test.TestOutcome {
  let a: Point = Point { x: 3, y: 7 };
  return test.assert_eq(a.to_string(), "Point { x: 3, y: 7 }");
}

function test_display_nested(): test.TestOutcome {
  let p: Outer = Outer { a: Inner { n: 5 }, tag: "hi" };
  return test.assert_eq(p.to_string(), "Outer { a: Inner { n: 5 }, tag: hi }");
}

function test_eq_nested(): test.TestOutcome {
  let p: Outer = Outer { a: Inner { n: 5 }, tag: "hi" };
  let q: Outer = Outer { a: Inner { n: 5 }, tag: "hi" };
  if (p.eq(q)) {
    return test.pass();
  }
  return test.fail("nested equal structs should be eq");
}

function sign(n: i32): string {
  if (n < 0) {
    return "lt";
  }
  if (n > 0) {
    return "gt";
  }
  return "eq";
}

function test_ord_first_field(): test.TestOutcome {
  let a: Point = Point { x: 1, y: 9 };
  let b: Point = Point { x: 2, y: 0 };
  return test.assert_eq(sign(a.cmp(b)), "lt");
}

function test_ord_second_field(): test.TestOutcome {
  let a: Point = Point { x: 3, y: 7 };
  let c: Point = Point { x: 3, y: 9 };
  return test.assert_eq(sign(a.cmp(c)), "lt");
}

function test_ord_equal(): test.TestOutcome {
  let a: Point = Point { x: 3, y: 7 };
  let b: Point = Point { x: 3, y: 7 };
  return test.assert_eq(sign(a.cmp(b)), "eq");
}

function test_enum_display_payload(): test.TestOutcome {
  let c: Shape = Circle(5);
  return test.assert_eq(c.to_string(), "Circle(5)");
}

function test_enum_display_unit(): test.TestOutcome {
  let e: Shape = Empty;
  return test.assert_eq(e.to_string(), "Empty");
}

function test_enum_eq_same_variant(): test.TestOutcome {
  let a: Shape = Circle(5);
  if (a.eq(Circle(5))) {
    return test.pass();
  }
  return test.fail("same variant + payload should be eq");
}

function test_enum_eq_diff_variant(): test.TestOutcome {
  let a: Shape = Circle(5);
  let b: Shape = Square(5);
  if (!a.eq(b)) {
    return test.pass();
  }
  return test.fail("different variants should not be eq");
}

function test_enum_eq_diff_payload(): test.TestOutcome {
  let a: Shape = Circle(5);
  let c: Shape = Circle(6);
  if (!a.eq(c)) {
    return test.pass();
  }
  return test.fail("same variant, differing payload should not be eq");
}

function test_enum_ord_within_variant(): test.TestOutcome {
  return test.assert_eq(sign(Circle(1).cmp(Circle(2))), "lt");
}

function test_enum_ord_across_variants(): test.TestOutcome {
  let lt: test.TestOutcome = test.assert_eq(sign(Circle(9).cmp(Square(0))), "lt");
  match (lt) {
    Fail(_) => {
      return lt;
    },
    Pass => {}
  }
  return test.assert_eq(sign(Empty.cmp(Circle(0))), "gt");
}

function test_hash_law(): test.TestOutcome {
  let a: Point = Point { x: 3, y: 7 };
  let b: Point = Point { x: 3, y: 7 };
  if (a.hash() == b.hash()) {
    return test.pass();
  }
  return test.fail("equal points should hash equal");
}

function test_enum_hash_law(): test.TestOutcome {
  if (Circle(5).hash() == Circle(5).hash()) {
    return test.pass();
  }
  return test.fail("same variant + payload should hash equal");
}

function test_json_struct(): test.TestOutcome {
  let p: Point = Point { x: 3, y: 7 };
  return test.assert_eq(p.to_json(), "{\"x\":3,\"y\":7}");
}

function test_json_enum_payload(): test.TestOutcome {
  return test.assert_eq(Circle(5).to_json(), "{\"Circle\":5}");
}

function test_json_enum_unit(): test.TestOutcome {
  return test.assert_eq(Empty.to_json(), "\"Empty\"");
}

function test_json_array_struct(): test.TestOutcome {
  let pts: Point[] = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
  return test.assert_eq(pts.to_json(), "[{\"x\":1,\"y\":2},{\"x\":3,\"y\":4}]");
}

function test_json_array_scalar(): test.TestOutcome {
  let ns: i32[] = [10, 20, 30];
  if (ns.to_json() != "[10,20,30]") {
    return test.fail("i32 array: " + ns.to_json());
  }
  let empty: i32[] = [];
  return test.assert_eq(empty.to_json(), "[]");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("derive");
  r = r.it("eq reflexive", test_eq_reflexive);
  r = r.it("eq distinguishes", test_eq_distinguishes);
  r = r.it("display", test_display);
  r = r.it("display nested", test_display_nested);
  r = r.it("eq nested", test_eq_nested);
  r = r.it("ord first field", test_ord_first_field);
  r = r.it("ord second field", test_ord_second_field);
  r = r.it("ord equal", test_ord_equal);
  r = r.it("enum display payload", test_enum_display_payload);
  r = r.it("enum display unit", test_enum_display_unit);
  r = r.it("enum eq same variant", test_enum_eq_same_variant);
  r = r.it("enum eq diff variant", test_enum_eq_diff_variant);
  r = r.it("enum eq diff payload", test_enum_eq_diff_payload);
  r = r.it("enum ord within variant", test_enum_ord_within_variant);
  r = r.it("enum ord across variants", test_enum_ord_across_variants);
  r = r.it("hash law", test_hash_law);
  r = r.it("enum hash law", test_enum_hash_law);
  r = r.it("json struct", test_json_struct);
  r = r.it("json enum payload", test_json_enum_payload);
  r = r.it("json enum unit", test_json_enum_unit);
  r = r.it("json array struct", test_json_array_struct);
  r = r.it("json array scalar", test_json_array_scalar);
  return r.finish();
}
