import "std/test";
import "std/http/hpack";
import "std/hex";
import "core/int";

// tests/stdlib/http_hpack_test.fern — std/http/hpack against RFC 7541's
// Appendix C: the literal representations, the three requests without and
// with Huffman coding, the three responses under a 256-byte table whose
// evictions the sizes show, and the bounds a decoder holds a block to.
// The expected bytes are the RFC's; where the RFC leaves the encoder a
// choice (a size update, Huffman or not) they are python-hpack's, which
// made the same ones.

function fields_text(fs: hpack.Field[]): string {
  let out: string = "";
  for f in fs {
    out = out + f.name + ": " + f.value;
    if (f.sensitive) {
      out = out + " (sensitive)";
    }
    out = out + "\n";
  }
  return out;
}

// decoded is the fields of `block`, decoded by `d`, or the error.
function decoded(d: hpack.Decoder, block: string): string {
  match (d.decode(hex.hex_decode(block))) {
    Ok(got) => {
      return fields_text(got.fields) + "table " + int.int_to_string(got.decoder.table_size());
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function encoded(e: hpack.Encoder, fs: hpack.Field[]): string {
  return hex.hex_encode(e.encode(fs).bytes);
}

function test_literals(): test.TestOutcome {
  let d: hpack.Decoder = hpack.decoder(4096, 65536);
  let got: string = decoded(d, "400a637573746f6d2d6b65790d637573746f6d2d686561646572") + "|" + decoded(d, "040c2f73616d706c652f70617468") + "|" + decoded(d, "100870617373776f726406736563726574") + "|" + decoded(d, "82");
  if (got != "custom-key: custom-header\ntable 55|:path: /sample/path\ntable 0|password: secret (sensitive)\ntable 0|:method: GET\ntable 0") {
    return test.fail(got);
  }
  let e: hpack.Encoder = hpack.encoder(4096).without_huffman();
  let out: string = encoded(e, [hpack.field("custom-key", "custom-header")]) + "|" + encoded(e, [hpack.sensitive("password", "secret")]) + "|" + encoded(e, [hpack.field(":method", "GET")]);
  return test.assert_eq(out, "400a637573746f6d2d6b65790d637573746f6d2d686561646572|100870617373776f726406736563726574|82");
}

function request_fields(n: i32): hpack.Field[] {
  if (n == 1) {
    return [hpack.field(":method", "GET"), hpack.field(":scheme", "http"), hpack.field(":path", "/"), hpack.field(":authority", "www.example.com")];
  }
  if (n == 2) {
    return [hpack.field(":method", "GET"), hpack.field(":scheme", "http"), hpack.field(":path", "/"), hpack.field(":authority", "www.example.com"), hpack.field("cache-control", "no-cache")];
  }
  return [hpack.field(":method", "GET"), hpack.field(":scheme", "https"), hpack.field(":path", "/index.html"), hpack.field(":authority", "www.example.com"), hpack.field("custom-key", "custom-value")];
}

// three_requests runs C.3 (plain) or C.4 (Huffman) both ways: the
// encoder's bytes and the decoder's fields, with the table sizes.
function three_requests(blocks: string[], huffman: boolean): string {
  let e: hpack.Encoder = hpack.encoder(4096);
  if (!huffman) {
    e = e.without_huffman();
  }
  let d: hpack.Decoder = hpack.decoder(4096, 65536);
  let out: string = "";
  let i: i32 = 0;
  while (i < 3) {
    let enc: hpack.Encoded = e.encode(request_fields(i + 1));
    e = enc.encoder;
    if (hex.hex_encode(enc.bytes) != blocks[i]) {
      return "request " + int.int_to_string(i + 1) + " encoded as " + hex.hex_encode(enc.bytes);
    }
    match (d.decode(enc.bytes)) {
      Ok(got) => {
        d = got.decoder;
        if (fields_text(got.fields) != fields_text(request_fields(i + 1))) {
          return "request " + int.int_to_string(i + 1) + " decoded as " + fields_text(got.fields);
        }
        out = out + int.int_to_string(d.table_size()) + " ";
      },
      Err(err) => {
        return err.message();
      }
    }
    i = i + 1;
  }
  return out + int.int_to_string(e.table_size());
}

function test_requests_plain(): test.TestOutcome {
  return test.assert_eq(three_requests(["828684410f7777772e6578616d706c652e636f6d", "828684be58086e6f2d6361636865", "828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565"], false), "57 110 164 164");
}

function test_requests_huffman(): test.TestOutcome {
  return test.assert_eq(three_requests(["828684418cf1e3c2e5f23a6ba0ab90f4ff", "828684be5886a8eb10649cbf", "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf"], true), "57 110 164 164");
}

function response_fields(n: i32): hpack.Field[] {
  if (n == 1) {
    return [hpack.field(":status", "302"), hpack.field("cache-control", "private"), hpack.field("date", "Mon, 21 Oct 2013 20:13:21 GMT"), hpack.field("location", "https://www.example.com")];
  }
  if (n == 2) {
    return [hpack.field(":status", "307"), hpack.field("cache-control", "private"), hpack.field("date", "Mon, 21 Oct 2013 20:13:21 GMT"), hpack.field("location", "https://www.example.com")];
  }
  return [hpack.field(":status", "200"), hpack.field("cache-control", "private"), hpack.field("date", "Mon, 21 Oct 2013 20:13:22 GMT"), hpack.field("location", "https://www.example.com"), hpack.field("content-encoding", "gzip"), hpack.field("set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1")];
}

// three_responses runs C.5 or C.6 under a 256-byte table: the first block
// starts with the size update, the second evicts the first status, the
// third evicts down to the set-cookie.
function three_responses(blocks: string[], huffman: boolean): string {
  let e: hpack.Encoder = hpack.encoder(4096).with_max_table(256);
  if (!huffman) {
    e = e.without_huffman();
  }
  let d: hpack.Decoder = hpack.decoder(4096, 65536);
  let out: string = "";
  let i: i32 = 0;
  while (i < 3) {
    let enc: hpack.Encoded = e.encode(response_fields(i + 1));
    e = enc.encoder;
    if (hex.hex_encode(enc.bytes) != blocks[i]) {
      return "response " + int.int_to_string(i + 1) + " encoded as " + hex.hex_encode(enc.bytes);
    }
    match (d.decode(enc.bytes)) {
      Ok(got) => {
        d = got.decoder;
        if (fields_text(got.fields) != fields_text(response_fields(i + 1))) {
          return "response " + int.int_to_string(i + 1) + " decoded as " + fields_text(got.fields);
        }
        out = out + int.int_to_string(d.table_size()) + " ";
      },
      Err(err) => {
        return err.message();
      }
    }
    i = i + 1;
  }
  return out + int.int_to_string(e.table_size());
}

function test_responses_plain(): test.TestOutcome {
  return test.assert_eq(three_responses(["3fe1014803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d", "4803333037c1c0bf", "88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31"], false), "222 222 215 215");
}

function test_responses_huffman(): test.TestOutcome {
  return test.assert_eq(three_responses(["3fe101488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3", "4883640effc1c0bf", "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007"], true), "222 222 215 215");
}

// A table held to zero bytes announces it and indexes nothing; a decoder
// refuses an update above what its settings allow, or after a field.
function test_size_updates(): test.TestOutcome {
  let e: hpack.Encoder = hpack.encoder(4096).with_max_table(0).without_huffman();
  let enc: hpack.Encoded = e.encode([hpack.field(":method", "GET"), hpack.field("x", "y")]);
  if (hex.hex_encode(enc.bytes) != "20824001780179" || enc.encoder.table_size() != 0) {
    return test.fail(hex.hex_encode(enc.bytes));
  }
  let d: hpack.Decoder = hpack.decoder(100, 65536);
  let got: string = decoded(d, "3fe101") + "|" + decoded(d, "8220") + "|" + decoded(d, "3f0582");
  return test.assert_eq(got, "hpack: dynamic table size update to 256 not allowed here|hpack: dynamic table size update to -1 not allowed here|:method: GET\ntable 0");
}

// What a decoder refuses: a block cut short, index 0 and one past the
// tables, an integer past 28 bits, Huffman padding of a whole byte and
// EOS inside a string.
function test_malformed(): test.TestOutcome {
  let d: hpack.Decoder = hpack.decoder(4096, 65536);
  let got: string = decoded(d, "400a637573746f6d") + "|" + decoded(d, "80") + "|" + decoded(d, "be") + "|" + decoded(d, "7fffffffff7f") + "|" + decoded(d, "0082ffff") + "|" + decoded(d, "0084fffffffc");
  return test.assert_eq(got, "hpack: header block ends inside a field|hpack: no table entry 0|hpack: no table entry 62|hpack: integer over 28 bits|hpack: bad Huffman string|hpack: bad Huffman string");
}

// decoded_twice decodes `first` and then `second` with the decoder the
// first left: what the second gives.
function decoded_twice(d: hpack.Decoder, first: u8[], second: u8[]): string {
  match (d.decode(first)) {
    Ok(got) => {
      return decoded(got.decoder, hex.hex_encode(second));
    },
    Err(e) => {
      return "first: " + e.message();
    }
  }
  return "";
}

// The list cap counts each field as 32 plus its bytes, a Huffman string
// as what it decodes to, and the field cap counts fields.
function test_bounds(): test.TestOutcome {
  let e: hpack.Encoder = hpack.encoder(4096);
  let two: hpack.Encoded = e.encode([hpack.field(":method", "GET"), hpack.field("custom-key", "custom-value")]);
  let three: hpack.Encoded = two.encoder.encode([hpack.field(":method", "GET"), hpack.field("custom-key", "custom-value"), hpack.field("another-key", "another-value")]);
  let small: hpack.Decoder = hpack.decoder(4096, 100);
  let got: string = decoded(small, hex.hex_encode(two.bytes)) + "|" + decoded_twice(small, two.bytes, three.bytes);
  let few: hpack.Decoder = hpack.decoder(4096, 65536).with_max_fields(2);
  got = got + "|" + decoded_twice(few, two.bytes, three.bytes);
  return test.assert_eq(got, ":method: GET\ncustom-key: custom-value\ntable 54|hpack: header list over 100 bytes|hpack: more than 2 header fields");
}

// Every byte value round-trips through the Huffman coding, and a value the
// coding would lengthen goes as its bytes.
function test_round_trip(): test.TestOutcome {
  let all: u8[] = [];
  let i: i32 = 0;
  while (i < 256) {
    all = all.append(i as u8);
    i = i + 1;
  }
  let value: string = string_from_bytes_unchecked(all);
  let e: hpack.Encoder = hpack.encoder(4096);
  let enc: hpack.Encoded = e.encode([hpack.field("x-all", value), hpack.sensitive("authorization", "Bearer 0123456789")]);
  match (hpack.decoder(4096, 65536).decode(enc.bytes)) {
    Ok(got) => {
      if (got.fields.len() != 2 || got.fields[0].value != value || !got.fields[1].sensitive || got.fields[1].value != "Bearer 0123456789") {
        return test.fail(fields_text(got.fields));
      }
      return test.assert_eq(int.int_to_string(got.decoder.table_size()) + " " + int.int_to_string(enc.encoder.table_size()), "293 293");
    },
    Err(err) => {
      return test.fail(err.message());
    }
  }
  return test.fail("unreachable");
}

// test_field_by_field: `begin`, `put` and `finish` write what `encode`
// writes for the same fields, the size update a smaller table owes
// included, and leave the encoder's table the same.
function test_field_by_field(): test.TestOutcome {
  let fields: hpack.Field[] = [hpack.field(":status", "200"), hpack.field("content-type", "text/plain"), hpack.sensitive("set-cookie", "s=1"), hpack.field("content-type", "text/plain")];
  let whole: hpack.Encoded = hpack.encoder(4096).with_max_table(256).encode(fields);
  let en: hpack.Encoding = hpack.encoder(4096).with_max_table(256).begin();
  for f in fields {
    en = en.put(f.name, f.value, f.sensitive);
  }
  let parts: hpack.Encoded = en.finish();
  if (hex.hex_encode(parts.bytes) != hex.hex_encode(whole.bytes)) {
    return test.fail("field by field " + hex.hex_encode(parts.bytes) + ", whole " + hex.hex_encode(whole.bytes));
  }
  let behind: hpack.Encoded = hpack.encoder(4096).with_max_table(256).begin_in([1 as u8, 2 as u8]).put(":status", "200", false).finish();
  if (hex.hex_encode(behind.bytes) != "0102" + hex.hex_encode(hpack.encoder(4096).with_max_table(256).encode([hpack.field(":status", "200")]).bytes)) {
    return test.fail("begun behind bytes " + hex.hex_encode(behind.bytes));
  }
  return test.assert_eq(parts.encoder.table_size(), whole.encoder.table_size());
}

// read_fields reads `block` one field at a time, as a connection does,
// and answers the fields as `decoded` writes them with the table size.
function read_fields(d: hpack.Decoder, block: u8[]): string {
  let st: hpack.Decoding = d.start();
  let out: string = "";
  while (st.more(block)) {
    st = st.next(block);
    if (st.has) {
      out = out + st.name + ": " + st.value;
      if (st.sensitive) {
        out = out + " (sensitive)";
      }
      out = out + "\n";
    }
  }
  match (st.error) {
    Some(e) => {
      return e.message();
    },
    None => {}
  }
  return out + "table " + int.int_to_string(d.finish(st).table_size());
}

// A block read one field at a time gives the fields `decode` gives, the
// table moved the same: C.4's three requests in turn, a size update, a
// sensitive literal, and the caps.
function test_field_at_a_time(): test.TestOutcome {
  let e: hpack.Encoder = hpack.encoder(4096);
  let d: hpack.Decoder = hpack.decoder(4096, 65536);
  let i: i32 = 0;
  while (i < 3) {
    let enc: hpack.Encoded = e.encode(request_fields(i + 1));
    e = enc.encoder;
    let one: string = read_fields(d, enc.bytes);
    if (one != decoded(d, hex.hex_encode(enc.bytes))) {
      return test.fail("request " + int.int_to_string(i + 1) + " read as " + one);
    }
    match (d.decode(enc.bytes)) {
      Ok(got) => {
        d = got.decoder;
      },
      Err(err) => {
        return test.fail(err.message());
      }
    }
    i = i + 1;
  }
  let got: string = read_fields(d, hex.hex_decode("20100870617373776f726406736563726574")) + "|" + read_fields(hpack.decoder(4096, 100), hex.hex_decode("828684410f7777772e6578616d706c652e636f6d")) + "|" + read_fields(hpack.decoder(4096, 65536).with_max_fields(2), hex.hex_decode("828684")) + "|" + read_fields(d, hex.hex_decode("82"));
  return test.assert_eq(got, "password: secret (sensitive)\ntable 0|hpack: header list over 100 bytes|hpack: more than 2 header fields|:method: GET\ntable 164");
}

// RFC 7541 Appendix A, entry 1 first.
const STATIC_TABLE: string[] = [
  ":authority", "", ":method", "GET", ":method", "POST", ":path", "/", ":path", "/index.html",
  ":scheme", "http", ":scheme", "https", ":status", "200", ":status", "204", ":status", "206",
  ":status", "304", ":status", "400", ":status", "404", ":status", "500", "accept-charset", "",
  "accept-encoding", "gzip, deflate", "accept-language", "", "accept-ranges", "", "accept", "",
  "access-control-allow-origin", "", "age", "", "allow", "", "authorization", "", "cache-control", "",
  "content-disposition", "", "content-encoding", "", "content-language", "", "content-length", "",
  "content-location", "", "content-range", "", "content-type", "", "cookie", "", "date", "", "etag", "",
  "expect", "", "expires", "", "from", "", "host", "", "if-match", "", "if-modified-since", "",
  "if-none-match", "", "if-range", "", "if-unmodified-since", "", "last-modified", "", "link", "",
  "location", "", "max-forwards", "", "proxy-authenticate", "", "proxy-authorization", "", "range", "",
  "referer", "", "refresh", "", "retry-after", "", "server", "", "set-cookie", "",
  "strict-transport-security", "", "transfer-encoding", "", "user-agent", "", "vary", "", "via", "",
  "www-authenticate", "",
];

// test_static_entries: every static entry is written as its index, and its
// name with another value as a literal naming the name's first entry.
function test_static_entries(): test.TestOutcome {
  let i: i32 = 0;
  while (i < STATIC_TABLE.len() / 2) {
    let name: string = STATIC_TABLE[2 * i];
    let whole: hpack.Encoded = hpack.encoder(4096).without_huffman().encode([hpack.field(name, STATIC_TABLE[2 * i + 1])]);
    if (hex.hex_encode(whole.bytes) != hex.hex_encode([(128 + i + 1) as u8])) {
      return test.fail(name + " " + STATIC_TABLE[2 * i + 1] + " is " + hex.hex_encode(whole.bytes));
    }
    let first: i32 = i;
    while (first > 0 && STATIC_TABLE[2 * (first - 1)] == name) {
      first = first - 1;
    }
    let other: hpack.Encoded = hpack.encoder(4096).without_huffman().encode([hpack.field(name, "x")]);
    if (hex.hex_encode(other.bytes) != hex.hex_encode([(64 + first + 1) as u8, 1 as u8, 120 as u8])) {
      return test.fail(name + " x is " + hex.hex_encode(other.bytes));
    }
    i = i + 1;
  }
  let none: hpack.Encoded = hpack.encoder(4096).without_huffman().encode([hpack.field("x-a-name-longer-than-any-static-one", "v")]);
  return test.assert_eq(hex.hex_encode(none.bytes), "4023782d612d6e616d652d6c6f6e6765722d7468616e2d616e792d7374617469632d6f6e650176");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/http/hpack");
  r = r.it("every static entry, and its name alone", test_static_entries);
  r = r.it("the literal representations", test_literals);
  r = r.it("three requests", test_requests_plain);
  r = r.it("three requests with Huffman coding", test_requests_huffman);
  r = r.it("three responses under a 256-byte table", test_responses_plain);
  r = r.it("three responses with Huffman coding", test_responses_huffman);
  r = r.it("dynamic table size updates", test_size_updates);
  r = r.it("malformed blocks", test_malformed);
  r = r.it("the list and field caps", test_bounds);
  r = r.it("every byte round-trips", test_round_trip);
  r = r.it("a block written field by field is the block encode writes", test_field_by_field);
  r = r.it("a block read one field at a time is the block decode reads", test_field_at_a_time);
  return r.finish();
}
