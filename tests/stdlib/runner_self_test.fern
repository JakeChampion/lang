import "std/test";
import "std/http";

function expect_pass(o: test.TestOutcome): test.TestOutcome {
  match (o) {
    Pass => {
      return test.pass();
    },
    Fail(msg) => {
      return test.fail("expected Pass, got Fail(" + msg + ")");
    }
  }
}

function expect_fail_containing(o: test.TestOutcome, needle: string): test.TestOutcome {
  match (o) {
    Fail(msg) => {
      if (msg.contains(needle)) {
        return test.pass();
      }
      return test.fail("Fail(\"" + msg + "\") does not contain \"" + needle + "\"");
    },
    Pass => {
      return test.fail("expected Fail, got Pass");
    }
  }
}

function test_assert_true_pass(): test.TestOutcome {
  return expect_pass(test.assert_true(true));
}

function test_assert_true_fail(): test.TestOutcome {
  return expect_fail_containing(test.assert_true(false), "assert_true");
}

function test_assert_false_pass(): test.TestOutcome {
  return expect_pass(test.assert_false(false));
}

function test_assert_false_fail(): test.TestOutcome {
  return expect_fail_containing(test.assert_false(true), "assert_false");
}

function test_eq_i32_pass(): test.TestOutcome {
  return expect_pass(test.assert_eq(42, 42));
}

function test_eq_i32_fail_message(): test.TestOutcome {
  let o: test.TestOutcome = test.assert_eq(4, 5);
  match (o) {
    Fail(msg) => {
      if (!msg.contains("expected \"5\"")) {
        return test.fail("missing 'expected \"5\"' in \"" + msg + "\"");
      }
      if (!msg.contains("got \"4\"")) {
        return test.fail("missing 'got \"4\"' in \"" + msg + "\"");
      }
      return test.pass();
    },
    Pass => {
      return test.fail("assert_eq(4, 5) should fail");
    }
  }
}

function test_eq_fail_quotes_empty_actual(): test.TestOutcome {
  let o: test.TestOutcome = test.assert_eq("", "x");
  match (o) {
    Fail(msg) => {
      if (!msg.contains("expected \"x\"")) {
        return test.fail("missing 'expected \"x\"' in \"" + msg + "\"");
      }
      if (!msg.contains("got \"\"")) {
        return test.fail("missing 'got \"\"' in \"" + msg + "\"");
      }
      return test.pass();
    },
    Pass => {
      return test.fail("assert_eq(\"\", \"x\") should fail");
    }
  }
}

function test_neq_fail_quotes_both(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_neq("a", "a"),
    "assert_neq: expected != \"a\", got \"a\"",
  );
}

function test_lt_pass(): test.TestOutcome {
  return expect_pass(test.assert_lt(1, 2));
}

function test_lt_fail_quotes_both(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_lt(2, 1),
    "assert_lt: expected \"2\" < \"1\"",
  );
}

function test_le_pass(): test.TestOutcome {
  return expect_pass(test.assert_le(2, 2));
}

function test_le_fail_quotes_both(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_le(3, 2),
    "assert_le: expected \"3\" <= \"2\"",
  );
}

function test_gt_pass(): test.TestOutcome {
  return expect_pass(test.assert_gt(2, 1));
}

function test_gt_fail_quotes_both(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_gt(1, 2),
    "assert_gt: expected \"1\" > \"2\"",
  );
}

function test_ge_pass(): test.TestOutcome {
  return expect_pass(test.assert_ge(2, 2));
}

function test_ge_fail_quotes_both(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_ge(1, 2),
    "assert_ge: expected \"1\" >= \"2\"",
  );
}

function test_eq_string_pass(): test.TestOutcome {
  return expect_pass(test.assert_eq("hello", "hello"));
}

function test_eq_string_fail(): test.TestOutcome {
  let o: test.TestOutcome = test.assert_eq("a", "b");
  return expect_fail_containing(o, "assert_eq");
}

function test_neq_i32(): test.TestOutcome {
  return expect_pass(test.assert_neq(1, 2));
}

function test_contains_pass(): test.TestOutcome {
  return expect_pass(test.assert_contains("hello world", "world"));
}

function test_contains_fail(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_contains("hello world", "xyz"),
    "assert_contains",
  );
}

function test_starts_with_pass(): test.TestOutcome {
  return expect_pass(test.assert_starts_with("foobar", "foo"));
}

function test_starts_with_fail(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_starts_with("foobar", "bar"),
    "assert_starts_with",
  );
}

function test_ends_with_pass(): test.TestOutcome {
  return expect_pass(test.assert_ends_with("foobar", "bar"));
}

function test_len_i32_pass(): test.TestOutcome {
  return expect_pass(test.assert_len_i32([1, 2, 3], 3));
}

function test_len_i32_fail(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_len_i32([1, 2, 3], 5),
    "expected length 5",
  );
}

function test_eq_i32_array_pass(): test.TestOutcome {
  return expect_pass(test.assert_eq_array([1, 2, 3], [1, 2, 3]));
}

function test_eq_i32_array_fail_index(): test.TestOutcome {
  let o: test.TestOutcome = test.assert_eq_array([1, 2, 3], [1, 9, 3]);
  return expect_fail_containing(o, "index 1");
}

function test_in_range_i32_pass(): test.TestOutcome {
  return expect_pass(test.assert_in_range_i32(5, 0, 10));
}

function test_in_range_i32_fail(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_in_range_i32(11, 0, 10),
    "assert_in_range_i32: 11 > upper bound 10",
  );
}

function test_in_range_i64_pass(): test.TestOutcome {
  return expect_pass(test.assert_in_range_i64(5 as i64, 0 as i64, 10 as i64));
}

function test_in_range_i64_fail(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_in_range_i64(0 as i64 - 1 as i64, 0 as i64, 10 as i64),
    "assert_in_range_i64: -1 < lower bound 0",
  );
}

function test_in_range_f64_pass(): test.TestOutcome {
  return expect_pass(test.assert_in_range_f64(0.5, 0.0, 1.0));
}

function test_in_range_f64_fail(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_in_range_f64(1.5, 0.0, 1.0),
    "assert_in_range_f64: 1.5 > upper bound 1",
  );
}

function test_in_range_f64_nan_fails(): test.TestOutcome {
  let nan: f64 = 0.0 / 0.0;
  let o: test.TestOutcome = expect_fail_containing(
    test.assert_in_range_f64(nan, 0.0, 1.0), "value is NaN",
  );
  match (o) {
    Fail(m) => {
      return test.fail(m);
    },
    Pass => {}
  }
  o = expect_fail_containing(
    test.assert_in_range_f64(0.5, nan, 1.0),
    "lower bound is NaN",
  );
  match (o) {
    Fail(m) => {
      return test.fail(m);
    },
    Pass => {}
  }
  return expect_fail_containing(
    test.assert_in_range_f64(0.5, 0.0, nan),
    "upper bound is NaN",
  );
}

function test_in_range_f32_pass(): test.TestOutcome {
  return expect_pass(test.assert_in_range_f32(0.5 as f32, 0.0 as f32, 1.0 as f32));
}

function test_in_range_f32_fail(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_in_range_f32(1.5 as f32, 0.0 as f32, 1.0 as f32),
    "assert_in_range_f32: 1.5 > upper bound 1",
  );
}

function test_in_range_f32_nan_fails(): test.TestOutcome {
  let z: f32 = 0.0 as f32;
  let nan: f32 = z / z;
  let one: f32 = 1.0 as f32;
  let half: f32 = 0.5 as f32;
  let o: test.TestOutcome = expect_fail_containing(
    test.assert_in_range_f32(nan, z, one), "value is NaN",
  );
  match (o) {
    Fail(m) => {
      return test.fail(m);
    },
    Pass => {}
  }
  o = expect_fail_containing(
    test.assert_in_range_f32(half, nan, one),
    "lower bound is NaN",
  );
  match (o) {
    Fail(m) => {
      return test.fail(m);
    },
    Pass => {}
  }
  return expect_fail_containing(
    test.assert_in_range_f32(half, z, nan),
    "upper bound is NaN",
  );
}

function test_in_range_inverted_fails(): test.TestOutcome {
  let o: test.TestOutcome = expect_fail_containing(
    test.assert_in_range_i32(5, 10, 0), "assert_in_range_i32: inverted range",
  );
  match (o) {
    Fail(m) => {
      return test.fail(m);
    },
    Pass => {}
  }
  o = expect_fail_containing(
    test.assert_in_range_i64(5 as i64, 10 as i64, 0 as i64),
    "assert_in_range_i64: inverted range",
  );
  match (o) {
    Fail(m) => {
      return test.fail(m);
    },
    Pass => {}
  }
  o = expect_fail_containing(
    test.assert_in_range_f64(0.5, 1.0, 0.0),
    "assert_in_range_f64: inverted range",
  );
  match (o) {
    Fail(m) => {
      return test.fail(m);
    },
    Pass => {}
  }
  return expect_fail_containing(
    test.assert_in_range_f32(0.5 as f32, 1.0 as f32, 0.0 as f32),
    "assert_in_range_f32: inverted range",
  );
}

function test_fail_returns_fail_case(): test.TestOutcome {
  return test.fail("deliberate failure recorded through a dropped handle");
}

function test_pass_returns_pass(): test.TestOutcome {
  return expect_pass(test.pass());
}

function test_fail_returns_fail(): test.TestOutcome {
  return expect_fail_containing(test.fail("custom message"), "custom message");
}

function test_dropped_it_result_still_counts(): test.TestOutcome {
  let sub: test.TestRunner = test.test_new_quiet("dropped-it");
  sub.it("dropped pass", test_pass_returns_pass);
  sub.it("dropped fail", test_fail_returns_fail_case);
  if (sub.emitted.get() != 2) {
    return test.fail("dropped cases lost: emitted=" + sub.emitted.get().to_string());
  }
  if (sub.emitted_failed.get() != 1) {
    return test.fail("dropped fail lost: emitted_failed=" + sub.emitted_failed.get().to_string());
  }
  return test.pass();
}

function test_unused_subsuite_handle_still_counts(): test.TestOutcome {
  let sub: test.TestRunner = test.test_new_quiet("unused-subsuite");
  sub = sub.it("parent pass", test_pass_returns_pass);
  let child: test.TestRunner = sub.subsuite("child");
  child = child.it("child pass", test_pass_returns_pass);
  child = child.it("child fail", test_fail_returns_fail_case);
  if (sub.emitted.get() != 3) {
    return test.fail("subsuite cases lost: emitted=" + sub.emitted.get().to_string());
  }
  if (sub.emitted_failed.get() != 1) {
    return test.fail("subsuite fail lost: emitted_failed=" + sub.emitted_failed.get().to_string());
  }
  return test.pass();
}

function test_finish_exits_nonzero_for_dropped_result(): test.TestOutcome {
  let kept: test.TestRunner = test.test_new_quiet("kept");
  kept = kept.it("kept pass", test_pass_returns_pass);
  if (kept.finish() != 0) {
    return test.fail("assigned all-passing child exited non-zero");
  }
  let dropped: test.TestRunner = test.test_new_quiet("dropped-exit");
  dropped.it("dropped pass", test_pass_returns_pass);
  if (dropped.finish() != 1) {
    return test.fail("a dropped passing result exited 0");
  }
  let bad: test.TestRunner = test.test_new_quiet("dropped-exit-fail");
  bad.it("dropped fail", test_fail_returns_fail_case);
  return test.assert_eq(bad.finish(), 1);
}

function nan_f64(): f64 {
  let z: f64 = 0.0;
  return z / z;
}

function test_le_nan_fails(): test.TestOutcome {
  return expect_fail_containing(test.assert_le(nan_f64(), 1.0), "assert_le");
}

function test_le_nan_bound_passes(): test.TestOutcome {
  return expect_pass(test.assert_le(1.0, nan_f64()));
}

function test_le_pass_still_passes(): test.TestOutcome {
  return expect_pass(test.assert_le(1.0, 2.0));
}

function test_ge_nan_fails(): test.TestOutcome {
  return expect_fail_containing(test.assert_ge(1.0, nan_f64()), "assert_ge");
}

function test_ge_nan_lhs_passes(): test.TestOutcome {
  return expect_pass(test.assert_ge(nan_f64(), 1.0));
}

function test_sorted_asc_nan_middle_fails(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_sorted_asc([3.0, nan_f64(), 1.0]),
    "assert_sorted_asc",
  );
}

function test_sorted_asc_nan_last_passes(): test.TestOutcome {
  return expect_pass(test.assert_sorted_asc([1.0, 3.0, nan_f64()]));
}

function test_unique_two_nans_fails(): test.TestOutcome {
  return expect_fail_containing(
    test.assert_unique([nan_f64(), nan_f64()]),
    "assert_unique",
  );
}

function test_unique_one_nan_passes(): test.TestOutcome {
  return expect_pass(test.assert_unique([1.0, nan_f64(), 2.0]));
}

function http_resp(): HttpResponse {
  return http.ok("hello").with_header("X-Kind", "greeting");
}

function test_assert_status_pass(): test.TestOutcome {
  return expect_pass(test.assert_status(http_resp(), 200));
}

function test_assert_status_fail(): test.TestOutcome {
  return expect_fail_containing(test.assert_status(http_resp(), 404), "assert_status: got 200, expected 404");
}

function test_assert_header_pass(): test.TestOutcome {
  return expect_pass(test.assert_header(http_resp(), "x-kind", "greeting"));
}

function test_assert_header_fail(): test.TestOutcome {
  let wrong: test.TestOutcome = expect_fail_containing(test.assert_header(http_resp(), "X-Kind", "farewell"), "assert_header: X-Kind is \"greeting\", expected \"farewell\"");
  match (wrong) {
    Fail(m) => {
      return test.fail(m);
    },
    Pass => {}
  }
  return expect_fail_containing(test.assert_header(http_resp(), "X-Other", "x"), "assert_header: no X-Other header");
}

function test_assert_no_header_pass(): test.TestOutcome {
  return expect_pass(test.assert_no_header(http_resp(), "X-Other"));
}

function test_assert_no_header_fail(): test.TestOutcome {
  return expect_fail_containing(test.assert_no_header(http_resp(), "x-kind"), "assert_no_header: x-kind is \"greeting\"");
}

function test_assert_body_pass(): test.TestOutcome {
  return expect_pass(test.assert_body(http_resp(), "hello"));
}

function test_assert_body_fail(): test.TestOutcome {
  return expect_fail_containing(test.assert_body(http_resp(), "bye"), "assert_body: got \"hello\", expected \"bye\"");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("runner self-test");
  r = r.it("assert_status pass", test_assert_status_pass);
  r = r.it("assert_status fail names both", test_assert_status_fail);
  r = r.it("assert_header pass", test_assert_header_pass);
  r = r.it("assert_header fail quotes the value or names the miss", test_assert_header_fail);
  r = r.it("assert_no_header pass", test_assert_no_header_pass);
  r = r.it("assert_no_header fail quotes the value", test_assert_no_header_fail);
  r = r.it("assert_body pass", test_assert_body_pass);
  r = r.it("assert_body fail quotes both", test_assert_body_fail);
  r = r.it("assert_true pass", test_assert_true_pass);
  r = r.it("assert_true fail message", test_assert_true_fail);
  r = r.it("assert_false pass", test_assert_false_pass);
  r = r.it("assert_false fail message", test_assert_false_fail);
  r = r.it("assert_eq pass", test_eq_i32_pass);
  r = r.it("assert_eq fail embeds both values", test_eq_i32_fail_message);
  r = r.it("assert_eq fail quotes an empty actual", test_eq_fail_quotes_empty_actual);
  r = r.it("assert_eq pass", test_eq_string_pass);
  r = r.it("assert_eq fail", test_eq_string_fail);
  r = r.it("assert_neq", test_neq_i32);
  r = r.it("assert_neq fail quotes both values", test_neq_fail_quotes_both);
  r = r.it("assert_lt pass", test_lt_pass);
  r = r.it("assert_lt fail quotes both values", test_lt_fail_quotes_both);
  r = r.it("assert_le pass", test_le_pass);
  r = r.it("assert_le fail quotes both values", test_le_fail_quotes_both);
  r = r.it("assert_gt pass", test_gt_pass);
  r = r.it("assert_gt fail quotes both values", test_gt_fail_quotes_both);
  r = r.it("assert_ge pass", test_ge_pass);
  r = r.it("assert_ge fail quotes both values", test_ge_fail_quotes_both);
  r = r.it("assert_in_range_i32 pass", test_in_range_i32_pass);
  r = r.it("assert_in_range_i32 fail", test_in_range_i32_fail);
  r = r.it("assert_in_range_i64 pass", test_in_range_i64_pass);
  r = r.it("assert_in_range_i64 fail", test_in_range_i64_fail);
  r = r.it("assert_in_range_f64 pass", test_in_range_f64_pass);
  r = r.it("assert_in_range_f64 fail", test_in_range_f64_fail);
  r = r.it("assert_in_range_f64 fails on NaN value or bound", test_in_range_f64_nan_fails);
  r = r.it("assert_in_range_f32 pass", test_in_range_f32_pass);
  r = r.it("assert_in_range_f32 fail", test_in_range_f32_fail);
  r = r.it("assert_in_range_f32 fails on NaN value or bound", test_in_range_f32_nan_fails);
  r = r.it("assert_in_range rejects an inverted range", test_in_range_inverted_fails);
  r = r.it("assert_contains pass", test_contains_pass);
  r = r.it("assert_contains fail", test_contains_fail);
  r = r.it("assert_starts_with pass", test_starts_with_pass);
  r = r.it("assert_starts_with fail", test_starts_with_fail);
  r = r.it("assert_ends_with pass", test_ends_with_pass);
  r = r.it("assert_len_i32 pass", test_len_i32_pass);
  r = r.it("assert_len_i32 fail", test_len_i32_fail);
  r = r.it("assert_eq_array pass", test_eq_i32_array_pass);
  r = r.it("assert_eq_array fail localises index", test_eq_i32_array_fail_index);
  r = r.it("pass() returns Pass", test_pass_returns_pass);
  r = r.it("fail(msg) returns Fail(msg)", test_fail_returns_fail);
  r = r.it("dropped it() result still counts", test_dropped_it_result_still_counts);
  r = r.it("unused subsuite handle still counts", test_unused_subsuite_handle_still_counts);
  r = r.it(
    "finish() exits 1 for a dropped result",
    test_finish_exits_nonzero_for_dropped_result,
  );
  r = r.it("assert_le rejects a NaN actual", test_le_nan_fails);
  r = r.it("assert_le holds against a NaN bound", test_le_nan_bound_passes);
  r = r.it("assert_le still passes on numbers", test_le_pass_still_passes);
  r = r.it("assert_ge rejects a NaN bound", test_ge_nan_fails);
  r = r.it("assert_ge holds for a NaN actual", test_ge_nan_lhs_passes);
  r = r.it("assert_sorted_asc rejects a NaN inversion", test_sorted_asc_nan_middle_fails);
  r = r.it("assert_sorted_asc accepts NaN last", test_sorted_asc_nan_last_passes);
  r = r.it("assert_unique rejects two NaNs", test_unique_two_nans_fails);
  r = r.it("assert_unique accepts one NaN", test_unique_one_nan_passes);
  return r.finish();
}
