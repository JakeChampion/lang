import "std/test";
import "core/cmp";
import "std/string";

function fold_order(a: string, b: string): i32 {
  return a.cmp_ignore_ascii_case(b);
}

function test_string_order(): test.TestOutcome {
  let lt: boolean = "apple".cmp("banana") < 0;
  let eq: boolean = "pear".cmp("pear") == 0;
  let gt: boolean = "pear".cmp("apple") > 0;
  return test.assert_true(lt && eq && gt);
}

function test_string_order_folded(): test.TestOutcome {
  let eq: boolean = "Apple".cmp_ignore_ascii_case("apple") == 0;
  let lt: boolean = "apple".cmp_ignore_ascii_case("Banana") < 0;
  return test.assert_true(eq && lt);
}

function test_sort_strings_desc(): test.TestOutcome {
  let xs: string[] = ["banana", "apple", "cherry"];
  return test.assert_eq_array(cmp.sort_desc(xs), ["cherry", "banana", "apple"]);
}

function test_sort_by_folded(): test.TestOutcome {
  let xs: string[] = ["Banana", "apple", "Cherry"];
  return test.assert_eq_array(cmp.sort_by(xs, fold_order), ["apple", "Banana", "Cherry"]);
}

function test_sort_by_folded_stable(): test.TestOutcome {
  let xs: string[] = ["b", "A", "B", "a"];
  return test.assert_eq_array(cmp.sort_by(xs, fold_order), ["A", "a", "b", "B"]);
}

function test_sort_by_desc(): test.TestOutcome {
  let xs: i32[] = [3, 1, 4, 1, 5, 9, 2, 6];
  let out = cmp.sort_by(xs, (a: i32, b: i32): i32 => b - a);
  return test.assert_eq_array(out, [9, 6, 5, 4, 3, 2, 1, 1]);
}

function test_sort_by_stable(): test.TestOutcome {
  let xs: i32[] = [1, 2, 3, 4, 5];
  let out = cmp.sort_by(xs, (a: i32, b: i32): i32 => a - b);
  return test.assert_eq_array(out, [1, 2, 3, 4, 5]);
}

function test_is_sorted_by_true(): test.TestOutcome {
  let xs: i32[] = [1, 3, 3, 7, 10];
  return test.assert_true(cmp.is_sorted_by(xs, (a: i32, b: i32): i32 => a - b));
}

function test_is_sorted_by_false(): test.TestOutcome {
  let xs: i32[] = [1, 3, 2, 7];
  return test.assert_false(cmp.is_sorted_by(xs, (a: i32, b: i32): i32 => a - b));
}

function test_sort_by_key_identity(): test.TestOutcome {
  let xs: i32[] = [4, 2, 8, 6];
  let out = cmp.sort_by_key(xs, (x: i32): i32 => x);
  return test.assert_eq_array(out, [2, 4, 6, 8]);
}

function test_sort_by_key_i32(): test.TestOutcome {
  let xs: i32[] = [4, 2, 8, 6];
  let out = cmp.sort_by_key(xs, (x: i32): i32 => 0 - x);
  return test.assert_eq_array(out, [8, 6, 4, 2]);
}

function test_sort_by_key_string(): test.TestOutcome {
  let xs: string[] = ["banana", "apple", "cherry", "apple"];
  let out = cmp.sort_by_key(xs, (w: string): string => w);
  return test.assert_eq_array(out, ["apple", "apple", "banana", "cherry"]);
}

function test_sort_by_key_stable(): test.TestOutcome {
  let xs: i32[] = [21, 11, 3, 13];
  let out = cmp.sort_by_key(xs, (x: i32): i32 => x - x / 10 * 10);
  return test.assert_eq_array(out, [21, 11, 3, 13]);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("cmp comparator + ci sorts");
  r = r.it("string cmp", test_string_order);
  r = r.it("string cmp_ignore_ascii_case", test_string_order_folded);
  r = r.it("sort_strings_desc", test_sort_strings_desc);
  r = r.it("sort_by ascii case fold", test_sort_by_folded);
  r = r.it("sort_by ascii case fold stable", test_sort_by_folded_stable);
  r = r.it("sort_by desc", test_sort_by_desc);
  r = r.it("sort_by stable", test_sort_by_stable);
  r = r.it("is_sorted_by true", test_is_sorted_by_true);
  r = r.it("is_sorted_by false", test_is_sorted_by_false);
  r = r.it("sort_by_key identity", test_sort_by_key_identity);
  r = r.it("sort_by_key i32", test_sort_by_key_i32);
  r = r.it("sort_by_key string", test_sort_by_key_string);
  r = r.it("sort_by_key stable", test_sort_by_key_stable);
  return r.finish();
}
