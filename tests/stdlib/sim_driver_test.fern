import "std/test";
import "std/async";
import "std/sim";
import "std/time";

function test_deadline_some_and_none(): test.TestOutcome {
  let d: sim.Sim = sim.new(7);
  let fs: async.Future[string][] = [
    sim.future_at(d, 40000000, "late"),
    sim.future_at(d, 10000000, "early"),
  ];
  let got: Option[string][] = async.with_deadline_on(d, time.duration_millis(25), fs);
  match (got[0]) {
    Some(v) => {
      return test.fail("late slot resolved under a 25ms deadline");
    },
    None => {}
  }
  match (got[1]) {
    Some(v) => {
      if (v != "early") {
        return test.fail("wrong winner value: " + v);
      }
    },
    None => {
      return test.fail("early slot timed out under a 25ms deadline");
    }
  }
  return test.assert_eq(d.now_ns(), 25000000 as i64);
}

function test_deadline_all_in_time(): test.TestOutcome {
  let d: sim.Sim = sim.new(7);
  let fs: async.Future[i32][] = [
    sim.future_at(d, 20000000, 40),
    sim.future_at(d, 5000000, 2),
  ];
  let got: Option[i32][] = async.with_deadline_on(d, time.duration_millis(100), fs);
  let sum: i32 = 0;
  match (got[0]) {
    Some(v) => {
      sum = sum + v;
    },
    None => {
      return test.fail("slot 0 timed out");
    }
  }
  match (got[1]) {
    Some(v) => {
      sum = sum + v;
    },
    None => {
      return test.fail("slot 1 timed out");
    }
  }
  if (sum != 42) {
    return test.fail("wrong values gathered");
  }
  return test.assert_eq(d.now_ns(), 20000000 as i64);
}

function __tie_winner(seed: i64): i32 {
  let d: sim.Sim = sim.new(seed);
  let fs: async.Future[i32][] = [
    sim.future_at(d, 5000000, 100),
    sim.future_at(d, 5000000, 200),
  ];
  let (w, v) = async.race_on(d, fs, -1);
  if (w == 0 && v != 100) {
    return -2;
  }
  if (w == 1 && v != 200) {
    return -3;
  }
  return w;
}

function test_race_tie_seeded(): test.TestOutcome {
  if (__tie_winner(1) != __tie_winner(1)) {
    return test.fail("same seed raced to different winners");
  }
  if (__tie_winner(1) != 0) {
    return test.fail("seed 1 pick drifted");
  }
  if (__tie_winner(2) != 1) {
    return test.fail("seed 2 pick drifted");
  }
  return test.pass();
}

function test_race_tie_seed_sweep(): test.TestOutcome {
  let s: i64 = 1;
  while (s <= 20) {
    let w: i32 = __tie_winner(s);
    if (w != 0 && w != 1) {
      return test.fail("seed " + s.to_string() + " gave invalid winner");
    }
    s = s + 1;
  }
  return test.pass();
}

function test_gather_out_of_order(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let fs: async.Future[i32][] = [
    sim.future_at(d, 30000000, 10),
    sim.future_at(d, 10000000, 20),
    sim.future_at(d, 20000000, 30),
  ];
  let got: i32[] = async.gather_on(d, fs, -1);
  if (got[0] != 10 || got[1] != 20 || got[2] != 30) {
    return test.fail("results not in input order");
  }
  return test.assert_eq(d.now_ns(), 30000000 as i64);
}

function test_chain_resolves_after_resuspensions(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let fs: async.Future[i32][] = [sim.future_chain(d, 10000000, 5000000, 3, 9)];
  let got: i32[] = async.gather_on(d, fs, -1);
  if (got[0] != 9) {
    return test.fail("chain resolved to wrong value");
  }
  return test.assert_eq(d.now_ns(), 25000000 as i64);
}

function test_chain_suspension_count(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let f: async.Future[i32] = sim.future_chain(d, 10000000, 5000000, 3, 9);
  let wakes: i32 = 0;
  let toks: i32[] = [];
  let guard: i32 = 0;
  while (guard < 10) {
    match (f) {
      Ready(v) => {
        if (v != 9) {
          return test.fail("wrong resolved value");
        }
        if (wakes != 4) {
          return test.fail("expected 4 wakes, got " + wakes.to_string());
        }
        if (toks[0] != 10 || toks[1] != 15 || toks[2] != 20 || toks[3] != 25) {
          return test.fail("wrong ready-at token schedule");
        }
        return test.pass();
      },
      Pending(tok, resume) => {
        toks = toks.append(tok);
        wakes = wakes + 1;
        f = resume(tok);
      }
    }
    guard = guard + 1;
  }
  return test.fail("chain never resolved");
}

function test_time_only_advances_in_poll(): test.TestOutcome {
  let d: sim.Sim = sim.new(3);
  let f: async.Future[i32] = sim.future_at(d, 90000000, 1);
  let t: i32 = d.timer(50000000);
  if (t != 50) {
    return test.fail("timer token is not its ready-at ms");
  }
  return test.assert_eq(d.now_ns(), 0 as i64);
}

function __draws(seed: i64): string {
  let s: sim.Sim = sim.new(seed);
  let out: string = "";
  let i: i32 = 0;
  while (i < 4) {
    out = out + (s.random_i32() & 255).to_string() + " ";
    i = i + 1;
  }
  return out;
}

function test_seed_replays_its_draws(): test.TestOutcome {
  if (sim.new(9).rng_state() != sim.new(9).rng_state()) {
    return test.fail("same-seed sims start with different PRNG states");
  }
  if (__draws(9) != __draws(9)) {
    return test.fail("same seed drew different values");
  }
  if (__draws(1) == __draws(2)) {
    return test.fail("seeds 1 and 2 drew identical values");
  }
  return test.assert_eq(__draws(1), "127 54 76 67 ");
}

function __not_seven(seed: i64): boolean {
  return seed != 7;
}

function __always(seed: i64): boolean {
  return true;
}

function test_sweep_finds_first_failing_seed(): test.TestOutcome {
  if (sim.sweep_seeds(20, __always) != 0 as i64) {
    return test.fail("a property that always holds reported a failing seed");
  }
  return test.assert_eq(sim.sweep_seeds(20, __not_seven), 7 as i64);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/sim driver");
  r = r.it("with_deadline some and none", test_deadline_some_and_none);
  r = r.it("with_deadline all in time", test_deadline_all_in_time);
  r = r.it("race tie seeded", test_race_tie_seeded);
  r = r.it("race tie seed sweep", test_race_tie_seed_sweep);
  r = r.it("gather out of order", test_gather_out_of_order);
  r = r.it("chain resolves after resuspensions", test_chain_resolves_after_resuspensions);
  r = r.it("chain suspension count", test_chain_suspension_count);
  r = r.it("time only advances in poll_ready", test_time_only_advances_in_poll);
  r = r.it("a seed replays its draws, another diverges", test_seed_replays_its_draws);
  r = r.it("sweep_seeds answers the first failing seed", test_sweep_finds_first_failing_seed);
  return r.finish();
}
