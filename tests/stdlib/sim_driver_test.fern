import "std/test";
import "std/async";
import "std/sim";
import "std/time";

function test_deadline_some_and_none(): test.TestOutcome {
  let d: sim.Sim = sim.new(7);
  let fs: async.Future[string][] = [
    sim.future_at(sim.at(time.duration_nanos(40000000)), "late"),
    sim.future_at(sim.at(time.duration_nanos(10000000)), "early"),
  ];
  let got: Option[string][] = sim.block_on(d, async.with_deadline(sim.at(time.duration_millis(25)), fs)).unwrap_or([]);
  if (got.len() != 2) {
    return test.fail("with_deadline ended cancelled");
  }
  match (got[0]) {
    Some(v) => {
      return test.fail("late slot resolved under a 25ms deadline");
    },
    None => {}
  }
  match (got[1]) {
    Some(v) => {
      if (v != "early") {
        return test.fail("wrong winner value: " + v);
      }
    },
    None => {
      return test.fail("early slot timed out under a 25ms deadline");
    }
  }
  return test.assert_eq(d.elapsed().as_nanos(), 25000000 as i64);
}

function test_deadline_all_in_time(): test.TestOutcome {
  let d: sim.Sim = sim.new(7);
  let fs: async.Future[i32][] = [
    sim.future_at(sim.at(time.duration_nanos(20000000)), 40),
    sim.future_at(sim.at(time.duration_nanos(5000000)), 2),
  ];
  let got: Option[i32][] = sim.block_on(d, async.with_deadline(sim.at(time.duration_millis(100)), fs)).unwrap_or([]);
  if (got.len() != 2) {
    return test.fail("with_deadline ended cancelled");
  }
  let sum: i32 = 0;
  match (got[0]) {
    Some(v) => {
      sum = sum + v;
    },
    None => {
      return test.fail("slot 0 timed out");
    }
  }
  match (got[1]) {
    Some(v) => {
      sum = sum + v;
    },
    None => {
      return test.fail("slot 1 timed out");
    }
  }
  if (sum != 42) {
    return test.fail("wrong values gathered");
  }
  return test.assert_eq(d.elapsed().as_nanos(), 20000000 as i64);
}

function __tie_winner(seed: i64): i32 {
  let d: sim.Sim = sim.new(seed);
  let fs: async.Future[i32][] = [
    sim.future_at(sim.at(time.duration_nanos(5000000)), 100),
    sim.future_at(sim.at(time.duration_nanos(5000000)), 200),
  ];
  match (sim.block_on(d, async.race(fs))) {
    Some(won) => {
      if (won.0 == 0 && won.1 != 100) {
        return -2;
      }
      if (won.0 == 1 && won.1 != 200) {
        return -3;
      }
      return won.0;
    },
    None => {
      return -4;
    }
  }
  return -5;
}

// Inside one race a tie goes to the lower index, whatever the seed.
function test_race_tie_lower_index(): test.TestOutcome {
  for seed in 1..21 {
    if (__tie_winner(seed as i64) != 0) {
      return test.fail("seed " + seed.to_string() + " broke a tie to the higher index");
    }
  }
  return test.pass();
}

// Between tasks the seed breaks a tie: the first task to run on wins the race for `order`.
function __first_of(seed: i64): i32 {
  let d: sim.Sim = sim.new(seed);
  let order: Cell[i32] = cell_new(0 - 1);
  let at: Instant = sim.at(time.duration_millis(5));
  let entries: (() => i32)[] = [
    (): i32 => {
      let moved: boolean = d.advance_to(at);
      if (order.get() < 0) {
        order.set(0);
      }
      return 0;
    },
    (): i32 => {
      let moved: boolean = d.advance_to(at);
      if (order.get() < 0) {
        order.set(1);
      }
      return 1;
    },
  ];
  let st: async.TaskStatus[i32][] = sim.run_tasks(d, entries, [None, None]);
  return order.get();
}

function test_task_tie_seeded(): test.TestOutcome {
  for seed in 1..21 {
    if (__first_of(seed as i64) != __first_of(seed as i64)) {
      return test.fail("seed " + seed.to_string() + " ran a tie in two orders");
    }
  }
  if (!async.parks()) {
    return test.pass();
  }
  let saw: i32[] = [0, 0];
  for seed in 1..21 {
    let w: i32 = __first_of(seed as i64);
    saw = saw.with(w, saw[w] + 1);
  }
  if (saw[0] == 0 || saw[1] == 0) {
    return test.fail("twenty seeds broke a tie the same way");
  }
  return test.pass();
}

function test_gather_out_of_order(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let fs: async.Future[i32][] = [
    sim.future_at(sim.at(time.duration_nanos(30000000)), 10),
    sim.future_at(sim.at(time.duration_nanos(10000000)), 20),
    sim.future_at(sim.at(time.duration_nanos(20000000)), 30),
  ];
  let got: i32[] = sim.block_on(d, async.gather(fs)).unwrap_or([0, 0, 0]);
  if (got[0] != 10 || got[1] != 20 || got[2] != 30) {
    return test.fail("results not in input order");
  }
  return test.assert_eq(d.elapsed().as_nanos(), 30000000 as i64);
}

function test_chain_resolves_after_resuspensions(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let fs: async.Future[i32][] = [sim.future_chain(sim.at(time.duration_nanos(10000000)), time.duration_nanos(5000000), 3, 9)];
  let got: i32[] = sim.block_on(d, async.gather(fs)).unwrap_or([0]);
  if (got[0] != 9) {
    return test.fail("chain resolved to wrong value");
  }
  return test.assert_eq(d.elapsed().as_nanos(), 25000000 as i64);
}

function test_chain_suspension_count(): test.TestOutcome {
  let d: sim.Sim = sim.new(1);
  let f: async.Future[i32] = sim.future_chain(sim.at(time.duration_nanos(10000000)), time.duration_nanos(5000000), 3, 9);
  let wakes: i32 = 0;
  let toks: i64[] = [];
  let guard: i32 = 0;
  while (guard < 10) {
    match (f) {
      Ready(v) => {
        if (v != 9) {
          return test.fail("wrong resolved value");
        }
        if (wakes != 4) {
          return test.fail("expected 4 wakes, got " + wakes.to_string());
        }
        if (toks[0] != 10 || toks[1] != 15 || toks[2] != 20 || toks[3] != 25) {
          return test.fail("wrong deadline schedule");
        }
        return test.pass();
      },
      Pending(w, resume) => {
        if let Some(at) = w.until {
          toks = toks.append(at.since(sim.at(time.duration_nanos(0))).as_millis());
        }
        wakes = wakes + 1;
        f = resume(async.Wake.TimedOut);
      },
      Cancelled => {
        return test.fail("chain ended cancelled");
      }
    }
    guard = guard + 1;
  }
  return test.fail("chain never resolved");
}

function test_time_only_advances_when_driven(): test.TestOutcome {
  let d: sim.Sim = sim.new(3);
  let f: async.Future[i32] = sim.future_at(sim.at(time.duration_millis(90)), 1);
  if (d.elapsed().as_nanos() != 0 as i64) {
    return test.fail("making a future moved the clock");
  }
  let v: i32 = sim.block_on(d, f).unwrap_or(0);
  if (v != 1) {
    return test.fail("the future did not resolve");
  }
  return test.assert_eq(d.elapsed().as_nanos(), 90000000 as i64);
}

function __draws(seed: i64): string {
  let s: sim.Sim = sim.new(seed);
  let out: string = "";
  let i: i32 = 0;
  while (i < 4) {
    out = out + (s.random_i32() & 255).to_string() + " ";
    i = i + 1;
  }
  return out;
}

function test_seed_replays_its_draws(): test.TestOutcome {
  if (sim.new(9).rng_state() != sim.new(9).rng_state()) {
    return test.fail("same-seed sims start with different PRNG states");
  }
  if (__draws(9) != __draws(9)) {
    return test.fail("same seed drew different values");
  }
  if (__draws(1) == __draws(2)) {
    return test.fail("seeds 1 and 2 drew identical values");
  }
  return test.assert_eq(__draws(1), "127 54 76 67 ");
}

function __not_seven(seed: i64): boolean {
  return seed != 7;
}

function __always(seed: i64): boolean {
  return true;
}

function test_sweep_finds_first_failing_seed(): test.TestOutcome {
  if (sim.sweep_seeds(20, __always) != 0 as i64) {
    return test.fail("a property that always holds reported a failing seed");
  }
  return test.assert_eq(sim.sweep_seeds(20, __not_seven), 7 as i64);
}

function main(): i32 {
  let r: test.TestRunner = test.new("std/sim driver");
  r = r.it("with_deadline some and none", test_deadline_some_and_none);
  r = r.it("with_deadline all in time", test_deadline_all_in_time);
  r = r.it("race tie goes to the lower index", test_race_tie_lower_index);
  r = r.it("a tie between tasks is the seed's", test_task_tie_seeded);
  r = r.it("gather out of order", test_gather_out_of_order);
  r = r.it("chain resolves after resuspensions", test_chain_resolves_after_resuspensions);
  r = r.it("chain suspension count", test_chain_suspension_count);
  r = r.it("time only advances when a future is driven", test_time_only_advances_when_driven);
  r = r.it("a seed replays its draws, another diverges", test_seed_replays_its_draws);
  r = r.it("sweep_seeds answers the first failing seed", test_sweep_finds_first_failing_seed);
  return r.finish();
}
