import "std/test";
import "std/http";

function body_text(req: HttpRequest): string {
  match (req.body_string()) {
    Ok(text) => {
      return text;
    },
    Err(e) => {
      return "<not utf-8>";
    }
  }
  return "<not utf-8>";
}

function test_parsed_headers_reachable_on_req(): test.TestOutcome {
  let wire: string = "GET /x HTTP/1.1\r\nHost: example.com\r\nContent-Type: application/json\r\nContent-Length: 0\r\n\r\n";
  match (http.http_parse_request(wire)) {
    Some(req) => {
      return test.assert_is_some_eq_string(
        req.headers.get("content-type"),
        "application/json",
      );
    },
    None => {
      return test.fail("parse failed on well-formed request");
    }
  }
  return test.fail("unreachable");
}

function test_parsed_header_count_is_3(): test.TestOutcome {
  let wire: string = "GET /x HTTP/1.1\r\nHost: example.com\r\nContent-Type: application/json\r\nContent-Length: 0\r\n\r\n";
  match (http.http_parse_request(wire)) {
    Some(req) => {
      return test.assert_eq(req.headers.len(), 3);
    },
    None => {
      return test.fail("parse failed");
    }
  }
  return test.fail("unreachable");
}

function test_duplicate_header_insertion_order(): test.TestOutcome {
  let wire: string = "GET / HTTP/1.1\r\nHost: h\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\nContent-Length: 0\r\n\r\n";
  match (http.http_parse_request(wire)) {
    Some(req) => {
      return test.assert_eq_array(
        req.headers.get_all("Set-Cookie"),
        ["a=1", "b=2"],
      );
    },
    None => {
      return test.fail("parse failed");
    }
  }
  return test.fail("unreachable");
}

function test_missing_header_returns_none(): test.TestOutcome {
  let wire: string = "GET / HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n";
  match (http.http_parse_request(wire)) {
    Some(req) => {
      return test.assert_is_none_string(req.headers.get("X-Absent"));
    },
    None => {
      return test.fail("parse failed");
    }
  }
  return test.fail("unreachable");
}

function test_get_all_on_missing_is_empty(): test.TestOutcome {
  let wire: string = "GET / HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n";
  match (http.http_parse_request(wire)) {
    Some(req) => {
      return test.assert_eq(req.headers.get_all("X-Absent").len(), 0);
    },
    None => {
      return test.fail("parse failed");
    }
  }
  return test.fail("unreachable");
}

function test_x_prefixed_cl_not_content_length(): test.TestOutcome {
  let wire: string = "GET / HTTP/1.1\r\nHost: h\r\nX-Custom-Content-Length: 5\r\n\r\nhello";
  match (http.http_parse_request(wire)) {
    Some(req) => {
      return test.assert_eq(body_text(req), "");
    },
    None => {
      return test.fail("well-formed request wrongly rejected");
    }
  }
  return test.fail("unreachable");
}

function test_duplicate_content_length_rejected(): test.TestOutcome {
  let wire: string = "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello!";
  match (http.http_parse_request(wire)) {
    Some(req) => {
      return test.fail("duplicate Content-Length must be rejected");
    },
    None => {
      return test.pass();
    }
  }
  return test.fail("unreachable");
}

function test_transfer_encoding_rejected(): test.TestOutcome {
  let wire: string = "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\nhello";
  match (http.http_parse_request(wire)) {
    Some(req) => {
      return test.fail("Transfer-Encoding beside Content-Length must be rejected");
    },
    None => {
      return test.pass();
    }
  }
  return test.fail("unreachable");
}

function test_http_header_value_via_headermap(): test.TestOutcome {
  let block: string = "Host: example.com\r\nContent-Type:  application/json  ";
  return test.assert_is_some_eq_string(
    http.http_header_value(block, "content-type"),
    "application/json",
  );
}

function test_http_header_value_missing_is_none(): test.TestOutcome {
  return test.assert_is_none_string(
    http.http_header_value("Host: e\r\n", "X-Absent"),
  );
}

function test_http_header_value_refuses_a_malformed_block(): test.TestOutcome {
  return test.assert_is_none_string(
    http.http_header_value("Host: e\r\nno colon\r\n", "host"),
  );
}

function test_no_headers_at_all_parses(): test.TestOutcome {
  match (http.http_parse_request("GET /bare HTTP/1.0\r\n\r\n")) {
    Some(req) => {
      return test.assert_eq(req.path, "/bare");
    },
    None => {
      return test.fail("a header-free request is well-formed");
    }
  }
  return test.fail("unreachable");
}

function test_no_headers_at_all_has_no_headers(): test.TestOutcome {
  match (http.http_parse_request("GET /bare HTTP/1.0\r\n\r\n")) {
    Some(req) => {
      return test.assert_eq(req.headers.len(), 0);
    },
    None => {
      return test.fail("a header-free request is well-formed");
    }
  }
  return test.fail("unreachable");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("HTTP request headers (migrated)");
  r = r.it(
    "Content-Type reachable case-insensitively",
    test_parsed_headers_reachable_on_req,
  );
  r = r.it(
    "3 wire headers -> size() = 3",
    test_parsed_header_count_is_3,
  );
  r = r.it(
    "duplicate Set-Cookie preserves insertion order",
    test_duplicate_header_insertion_order,
  );
  r = r.it(
    "missing header returns None",
    test_missing_header_returns_none,
  );
  r = r.it(
    "get_all on missing returns []",
    test_get_all_on_missing_is_empty,
  );
  r = r.it(
    "X-*-Content-Length is not the body length",
    test_x_prefixed_cl_not_content_length,
  );
  r = r.it(
    "duplicate Content-Length rejected",
    test_duplicate_content_length_rejected,
  );
  r = r.it(
    "Transfer-Encoding beside Content-Length rejected",
    test_transfer_encoding_rejected,
  );
  r = r.it(
    "http_header_value via HeaderMap",
    test_http_header_value_via_headermap,
  );
  r = r.it(
    "http_header_value missing returns None",
    test_http_header_value_missing_is_none,
  );
  r = r.it(
    "http_header_value refuses a malformed block",
    test_http_header_value_refuses_a_malformed_block,
  );
  r = r.it(
    "a request with no headers parses",
    test_no_headers_at_all_parses,
  );
  r = r.it(
    "a request with no headers has none",
    test_no_headers_at_all_has_no_headers,
  );
  return r.finish();
}
