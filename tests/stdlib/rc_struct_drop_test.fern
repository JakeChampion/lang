import "std/test";

struct Bag { items: i32[] }

struct Inner { v: i32 }

struct Nest { inners: Inner[] }

struct Acc { items: i32[] }

function build(a: Acc): Acc {
  a = Acc { items: [1] };
  a = Acc { items: [2, 3] };
  a = Acc { items: [4, 5, 6] };
  return a;
}

function bag_sum(): i32 {
  let b: Bag = Bag { items: [10, 20, 30] };
  return b.items[0] + b.items[1] + b.items[2];
}

function nest_sum(): i32 {
  let nz: Nest = Nest { inners: [Inner { v: 5 }, Inner { v: 7 }] };
  return nz.inners[0].v + nz.inners[1].v;
}

function test_scalar_array_field(): test.TestOutcome {
  let s: i32 = 0;
  let i: i32 = 0;
  while (i < 100) {
    s = s + bag_sum();
    i = i + 1;
  }
  return test.assert_eq(s, 6000);
}

function test_struct_array_field(): test.TestOutcome {
  let s: i32 = 0;
  let i: i32 = 0;
  while (i < 100) {
    s = s + nest_sum();
    i = i + 1;
  }
  return test.assert_eq(s, 1200);
}

function test_field_reclaim(): test.TestOutcome {
  let sum: i32 = 0;
  let i: i32 = 0;
  while (i < 50) {
    let seed: Acc = Acc { items: [0] };
    let r: Acc = build(seed);
    sum = sum + r.items[0] + r.items[1] + r.items[2];
    i = i + 1;
  }
  return test.assert_eq(sum, 750);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("rc struct drop");
  r = r.it("scalar-array field drop", test_scalar_array_field);
  r = r.it("struct-array field drop", test_struct_array_field);
  r = r.it("consume-rebind field reclaim", test_field_reclaim);
  return r.finish();
}
