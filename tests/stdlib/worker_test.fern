import "std/test";
import "std/worker";
import "core/map";

struct Report { total: i32, name: string }

struct Bundle { names: string[], result: Option[(string, Report)] }

function test_spawn_join_scalar(): test.TestOutcome {
  let n = 20;
  let w = worker.spawn((): i32 => n + 1);
  return test.assert_eq(w.join().to_string(), "21");
}

function test_spawn_join_record(): test.TestOutcome {
  let items: i32[] = [1, 2, 3];
  let label = "three";
  let w = worker.spawn((): Report => {
    let total = 0;
    for x in items {
      total += x;
    }
    return Report { total: total, name: label };
  });
  let r = w.join();
  if (r.total != 6) {
    return test.fail("total");
  }
  return test.assert_eq(r.name, "three");
}

function test_two_workers_join_out_of_order(): test.TestOutcome {
  let a = worker.spawn((): string => "first");
  let b = worker.spawn((): string => "second");
  let second = b.join();
  let first = a.join();
  return test.assert_eq(first + "," + second, "first,second");
}

function test_option_and_tuple_cross(): test.TestOutcome {
  let pair: (i32, string) = (7, "seven");
  let w = worker.spawn((): Option[(i32, string)] => Some(pair));
  match (w.join()) {
    Some(p) => {
      return test.assert_eq(p.0.to_string() + "=" + p.1, "7=seven");
    },
    None => {
      return test.fail("the worker returned None");
    }
  }
}

function bundle(n: i32): Bundle {
  return Bundle { names: ["worker-" + n.to_string(), "tail-" + n.to_string()], result: Some(("tuple-" + n.to_string(), Report { total: n, name: "report-" + n.to_string() })) };
}

function test_nested_results_survive_later_joins(): test.TestOutcome {
  let first = worker.spawn((): Bundle => bundle(7));
  let kept = first.join();
  for i in 0..32 {
    let next = worker.spawn((): Bundle => bundle(i));
    let value = next.join();
    if (value.names[0] != "worker-" + i.to_string()) {
      return test.fail("later result");
    }
  }
  if (kept.names[0] != "worker-7" || kept.names[1] != "tail-7") {
    return test.fail("retained array");
  }
  match (kept.result) {
    Some(pair) => {
      if (pair.0 != "tuple-7" || pair.1.total != 7) {
        return test.fail("retained tuple");
      }
      return test.assert_eq(pair.1.name, "report-7");
    },
    None => {
      return test.fail("retained enum");
    }
  }
}

function test_nested_worker_result(): test.TestOutcome {
  let outer = worker.spawn((): Bundle => {
    let inner = worker.spawn((): Bundle => bundle(11));
    return inner.join();
  });
  let value = outer.join();
  return test.assert_eq(value.names[0], "worker-11");
}

function test_map_crosses_both_ways(): test.TestOutcome {
  let prices: Map[string, i32] = map_new(4);
  prices = prices.insert("bolt", 25);
  prices = prices.insert("nut", 4);
  let w = worker.spawn((): Map[string, Report] => {
    let out: Map[string, Report] = map_new(4);
    for name in prices.keys() {
      out = out.insert(name, Report { total: prices.get_or(name, 0) * 2, name: name + "!" });
    }
    return out;
  });
  let doubled = w.join();
  if (doubled.len() != 2 || doubled.get_or("bolt", Report { total: 0, name: "" }).total != 50) {
    return test.fail("doubled map");
  }
  return test.assert_eq(doubled.get_or("nut", Report { total: 0, name: "" }).name, "nut!");
}

function test_captured_map_is_read_in_the_child(): test.TestOutcome {
  let prices: Map[string, i32] = map_new(4);
  prices = prices.insert("bolt", 25);
  prices = prices.insert("nut", 4);
  let w = worker.spawn((): i32 => {
    let total = 0;
    for name in prices.keys() {
      total += prices.get_or(name, 0);
    }
    return total;
  });
  return test.assert_eq(w.join().to_string(), "29");
}

function twice[T: worker.Send](x: T): (T, T) {
  let w = worker.spawn((): T => x);
  let y = w.join();
  return (x, y);
}

function test_bounded_type_parameter_crosses(): test.TestOutcome {
  let pair: (Report, Report) = twice(Report { total: 7, name: "seven" });
  if (pair.1.total != 7) {
    return test.fail("total");
  }
  let names: (string[], string[]) = twice(["ada", "rush"]);
  return test.assert_eq(pair.1.name + ":" + names.1[1], "seven:rush");
}

// Polls the worker until it is done, at most `limit` times, then joins it.
function poll_until_ready(own w: worker.Worker[i32], polls: i32, limit: i32): (i32, i32) {
  match (w.poll()) {
    worker.Finished(v) => {
      return (v, polls + 1);
    },
    worker.Running(again) => {
      if (polls + 1 >= limit) {
        return (again.join(), polls + 1);
      }
      return poll_until_ready(again, polls + 1, limit);
    }
  }
}

function spin(n: i32): i32 {
  let acc = 0;
  for i in 0..n {
    acc = (acc * 31 + i) % 1000003;
  }
  return acc;
}

function test_poll_returns_the_result(): test.TestOutcome {
  let n = 4;
  let got = poll_until_ready(worker.spawn((): i32 => n * 10), 0, 100000);
  return test.assert_eq(got.0.to_string(), "40");
}

// A body that runs for about a quarter of a second natively.
const SPIN_STEPS: i32 = 50000000;

const SPIN_RESULT: string = "922688";

// A worker that runs apart from the program is still running at the first
// poll. An engine that runs the body inline at `spawn` returns late from it,
// and its worker is ready. `parallel` says which of the two the engine does.
function test_poll_gives_a_running_worker_back(): test.TestOutcome {
  let parallel = worker.parallel();
  let start = monotonic_ns();
  let w = worker.spawn((): i32 => spin(SPIN_STEPS));
  let spawned = monotonic_ns();
  match (w.poll()) {
    worker.Finished(v) => {
      let polled = monotonic_ns();
      if (spawned - start < 20000000i64 && polled - start < 40000000i64) {
        return test.fail("a worker that runs apart was ready at once");
      }
      if (parallel && spawned - start > 200000000i64) {
        return test.fail("parallel is true, and spawn ran the body before it returned");
      }
      return test.assert_eq(v.to_string(), SPIN_RESULT);
    },
    worker.Running(again) => {
      if (!parallel) {
        return test.fail("parallel is false, and the worker ran beside its caller");
      }
      return test.assert_eq(again.join().to_string(), SPIN_RESULT);
    }
  }
}

struct Loop { job: Option[worker.Worker[string]], polls: i32 }

function step(own l: Loop): (Loop, string) {
  match (l.job) {
    Some(w) => {
      match (w.poll()) {
        worker.Finished(v) => {
          return (Loop { job: None, polls: l.polls + 1 }, v);
        },
        worker.Running(again) => {
          return (Loop { job: Some(again), polls: l.polls + 1 }, "");
        }
      }
    },
    None => {
      return (Loop { job: None, polls: l.polls }, "");
    }
  }
}

function test_an_event_loop_holds_a_worker(): test.TestOutcome {
  let name = "loop";
  let l = Loop { job: Some(worker.spawn((): string => name + "!")), polls: 0 };
  let got = "";
  while (got.len() == 0) {
    let next = step(l);
    l = next.0;
    got = next.1;
  }
  if (l.job.is_some() || l.polls < 1) {
    return test.fail("the loop kept its worker");
  }
  return test.assert_eq(got, "loop!");
}

function main(): i32 {
  let r = test.new("std/worker");
  r = r.it("spawn and join a scalar", test_spawn_join_scalar);
  r = r.it("spawn and join a record", test_spawn_join_record);
  r = r.it("two workers join out of order", test_two_workers_join_out_of_order);
  r = r.it("an Option of a tuple crosses the boundary", test_option_and_tuple_cross);
  r = r.it("nested results survive later joins", test_nested_results_survive_later_joins);
  r = r.it("a nested worker returns a copied result", test_nested_worker_result);
  r = r.it("a map crosses the boundary both ways", test_map_crosses_both_ways);
  r = r.it("a captured map is read in the child", test_captured_map_is_read_in_the_child);
  r = r.it("a type parameter bounded by Send crosses", test_bounded_type_parameter_crosses);
  r = r.it("poll returns the result of a finished worker", test_poll_returns_the_result);
  r = r.it("poll gives a running worker back", test_poll_gives_a_running_worker_back);
  r = r.it("an event loop holds a worker across polls", test_an_event_loop_holds_a_worker);
  return r.finish();
}
