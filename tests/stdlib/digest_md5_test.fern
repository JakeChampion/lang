import "std/test";
import "std/crypto" as crypto;
import "std/string";

function __pseudo(): u8[] {
  let b: u8[] = __alloc_u8(10003);
  let i: i32 = 0;
  while (i < 10003) {
    b = b.with(i, (i * 7 + 3 & 255) as u8);
    i = i + 1;
  }
  return b;
}

function __thousand_a(): string {
  let b: u8[] = __alloc_u8(1000);
  let i: i32 = 0;
  while (i < 1000) {
    b = b.with(i, 97 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

function test_empty(): test.TestOutcome {
  return test.assert_eq(crypto.md5_new().final_hex(), "d41d8cd98f00b204e9800998ecf8427e");
}

function test_abc(): test.TestOutcome {
  return test.assert_eq(crypto.md5_new().update("abc").final_hex(), "900150983cd24fb0d6963f7d28e17f72");
}

function test_multiblock(): test.TestOutcome {
  return test.assert_eq(
    crypto.md5_new().update("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq").final_hex(),
    "8215ef0796a20bcaaae116d3876c664a",
  );
}

function test_bytes_len(): test.TestOutcome {
  return test.assert_eq(crypto.md5_new().update("abc").final_bytes().len(), 16);
}

function test_million_a_chunked(): test.TestOutcome {
  let h: crypto.Md5 = crypto.md5_new();
  let chunk: string = __thousand_a();
  let i: i32 = 0;
  while (i < 1000) {
    h = h.update(chunk);
    i = i + 1;
  }
  return test.assert_eq(h.final_hex(), "7707d6ae4e027c70eea2a935c2296f21");
}

function test_seven_byte_updates(): test.TestOutcome {
  let msg: u8[] = __pseudo();
  let h: crypto.Md5 = crypto.md5_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    h = h.update_bytes(msg[i:i + 7]);
    i = i + 7;
  }
  h = h.update_bytes(msg[i:10003]);
  let chunked: string = h.final_hex();
  let whole: string = crypto.md5_new().update(string_from_bytes_unchecked(msg)).final_hex();
  if (chunked != "7c4e9f3504de1abd43ed7e37495a796a") {
    return test.fail("chunked: " + chunked);
  }
  return test.assert_eq(chunked, whole);
}

function test_update_bytes_and_oneshot(): test.TestOutcome {
  let via_bytes: string = crypto.md5_new().update_bytes("abc".bytes()).final_hex();
  if (via_bytes != crypto.md5_hex("abc")) {
    return test.fail("one-shot differs: " + via_bytes);
  }
  return test.assert_eq(via_bytes, "900150983cd24fb0d6963f7d28e17f72");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/crypto MD5");
  r = r.it("empty", test_empty);
  r = r.it("abc", test_abc);
  r = r.it("multi-block", test_multiblock);
  r = r.it("final_bytes len", test_bytes_len);
  r = r.it("million a, 1000x1000", test_million_a_chunked);
  r = r.it("7-byte updates", test_seven_byte_updates);
  r = r.it("update_bytes + one-shot", test_update_bytes_and_oneshot);
  return r.finish();
}
