import "std/test";
import "std/crypto" as crypto;
import "std/hex";
import "std/string";

// tests/stdlib/crypto_test.fern — pure-Fern coverage of std/crypto's
// SHA-256, HMAC-SHA256 and HMAC-SHA384 against the standard NIST
// (FIPS 180-4) and RFC 4231 known-answer vectors: the empty string, "abc",
// the classic pangram, the 32-byte raw-digest length, and HMAC vectors,
// HKDF over SHA-256 and SHA-384,
// and SHAKE128/256 against FIPS 202 outputs for the empty message and 200
// bytes of 0xa3.
// The Go-side suite unit-tests the rounds; this is the migration-shaped
// (pure-Fern, std/test-driven) companion. All arithmetic is u32, so this
// also exercises the unsigned round math end to end.

function test_sha256_empty(): test.TestOutcome {
  return test.assert_eq(
    crypto.sha256_hex(""),
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  );
}

function test_sha256_abc(): test.TestOutcome {
  return test.assert_eq(
    crypto.sha256_hex("abc"),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  );
}

function test_sha256_pangram(): test.TestOutcome {
  return test.assert_eq(
    crypto.sha256_hex("The quick brown fox jumps over the lazy dog"),
    "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592",
  );
}

function test_sha256_bytes_len(): test.TestOutcome {
  // The raw digest is exactly 32 bytes.
  return test.assert_eq(crypto.sha256_bytes("abc").len(), 32);
}

function test_hmac_sha256(): test.TestOutcome {
  // The well-known HMAC-SHA256("key", pangram) vector.
  return test.assert_eq(
    crypto.hmac_sha256_hex("key".bytes(), "The quick brown fox jumps over the lazy dog"),
    "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8",
  );
}

function test_hmac_bytes_len(): test.TestOutcome {
  return test.assert_eq(crypto.hmac_sha256_bytes("key".bytes(), "msg").len(), 32);
}

// consteq: equal contents true; a mismatch anywhere (first byte, last byte)
// and a length mismatch are all false. (#4384 — constant-time MAC compare.)
function test_consteq(): test.TestOutcome {
  return test.assert_true(
    crypto.consteq("abcdef".bytes(), "abcdef".bytes())
      && !crypto.consteq("abcdef".bytes(), "abcdeg".bytes())
      && !crypto.consteq("Xbcdef".bytes(), "abcdef".bytes())
      && !crypto.consteq("abc".bytes(), "abcd".bytes())
      && crypto.consteq("".bytes(), "".bytes()),
  );
}

// hmac_verify: the correct MAC verifies; a wrong MAC and a wrong key don't.
function test_hmac_verify(): test.TestOutcome {
  let mac: u8[] = crypto.hmac_sha256_bytes("key".bytes(), "The quick brown fox jumps over the lazy dog");
  return test.assert_true(
    crypto.hmac_verify("key".bytes(), "The quick brown fox jumps over the lazy dog", mac)
      && !crypto.hmac_verify("wrongkey".bytes(), "The quick brown fox jumps over the lazy dog", mac),
  );
}

// hmac_verify_hex against the known vector; a one-char-off hex fails.
function test_hmac_verify_hex(): test.TestOutcome {
  return test.assert_true(
    crypto.hmac_verify_hex(
      "key".bytes(), "The quick brown fox jumps over the lazy dog",
      "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8",
    ) && !crypto.hmac_verify_hex(
      "key".bytes(), "The quick brown fox jumps over the lazy dog",
      "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd9",
    ),
  );
}

// PBKDF2-HMAC-SHA256 against the standard known-answer vectors. Low
// iteration counts only — this suite runs on the (unoptimized) interp
// oracle; the compiled backends cover c=4096 in the Go differential test.
function test_pbkdf2_c1(): test.TestOutcome {
  return test.assert_eq(
    crypto.pbkdf2_sha256_hex("password", "salt".bytes(), 1, 32),
    "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
  );
}

function test_pbkdf2_c2(): test.TestOutcome {
  return test.assert_eq(
    crypto.pbkdf2_sha256_hex("password", "salt".bytes(), 2, 32),
    "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43",
  );
}

function test_pbkdf2_truncated(): test.TestOutcome {
  // A shorter dk_len is the prefix of the full-length output.
  return test.assert_eq(
    crypto.pbkdf2_sha256_hex("password", "salt".bytes(), 1, 16),
    "120fb6cffcf8b32c43e7225256c4f837",
  );
}

// pbkdf2_verify_hex accepts the right password and rejects a wrong one
// (and a wrong stored key), comparing in constant time.
function test_pbkdf2_verify(): test.TestOutcome {
  let stored: string = "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b";
  if (!crypto.pbkdf2_verify_hex("password", "salt".bytes(), 1, stored)) {
    return test.fail("should accept");
  }
  if (crypto.pbkdf2_verify_hex("wrongpw", "salt".bytes(), 1, stored)) {
    return test.fail("wrong password accepted");
  }
  // wrong stored key (last nibble flipped) must be rejected
  let tampered: string = "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17a";
  return test.assert_false(crypto.pbkdf2_verify_hex("password", "salt".bytes(), 1, tampered));
}

// HKDF-SHA256 (RFC 5869) against Test Case 1 and Test Case 3. Fast (a
// few HMACs), so the full vectors run on the interp oracle here.
function __hkdf_byte_rep(b: i32, n: i32): u8[] {
  let a: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    a = a.append(b as u8);
    i = i + 1;
  }
  return a;
}

function test_hkdf_tc1(): test.TestOutcome {
  let ikm: u8[] = __hkdf_byte_rep(11, 22);  // 0x0b × 22
  let salt: u8[] = [
    0 as u8, 1 as u8, 2 as u8, 3 as u8, 4 as u8, 5 as u8,
    6 as u8, 7 as u8, 8 as u8, 9 as u8, 10 as u8, 11 as u8, 12 as u8,
  ];
  // 0xf0..0xf9 — the RFC's `info` is arbitrary octets, not text, which
  // is why `info` is `u8[]` (#5730): as a `string` this vector would
  // need an unchecked construction of non-UTF-8 bytes.
  let info: u8[] = [
    240 as u8, 241 as u8, 242 as u8, 243 as u8, 244 as u8,
    245 as u8, 246 as u8, 247 as u8, 248 as u8, 249 as u8,
  ];
  return test.assert_eq(
    crypto.hkdf_sha256_hex(salt, ikm, info, 42),
    "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
  );
}

function test_hkdf_tc3_empty(): test.TestOutcome {
  // Zero-length salt (→ 32 zero bytes) and zero-length info.
  let ikm: u8[] = __hkdf_byte_rep(11, 22);
  let e: u8[] = [];
  return test.assert_eq(
    crypto.hkdf_sha256_hex(e, ikm, e, 42),
    "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8",
  );
}

function test_hkdf_expand_matches_oneshot(): test.TestOutcome {
  // hkdf_expand(hkdf_extract(...)) equals the one-shot hkdf_sha256.
  let ikm: u8[] = __hkdf_byte_rep(11, 22);
  let salt: u8[] = __hkdf_byte_rep(0, 13);
  let info: u8[] = __hkdf_byte_rep(255, 4);
  let prk: u8[] = crypto.hkdf_extract(salt, ikm);
  // Both sides are `u8[]`, which has no structural `==` (E041), so
  // compare byte-wise — consteq is exactly that compare.
  return test.assert_true(crypto.consteq(
    crypto.hkdf_expand(prk, info, 40),
    crypto.hkdf_sha256(salt, ikm, info, 40),
  ));
}

// The byte-message HMACs: RFC 4231 test cases 1, 2 and 6 (a key longer
// than SHA-384's 128-byte block) for HMAC-SHA384, and test case 1 for
// HMAC-SHA256.
function test_hmac_sha384_rfc4231(): test.TestOutcome {
  if (hex.hex_encode(crypto.hmac_sha384(__hkdf_byte_rep(0x0b, 20), "Hi There".bytes())) != "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6") {
    return test.fail("test case 1");
  }
  if (hex.hex_encode(crypto.hmac_sha384("Jefe".bytes(), "what do ya want for nothing?".bytes())) != "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649") {
    return test.fail("test case 2");
  }
  return test.assert_eq(
    hex.hex_encode(crypto.hmac_sha384(__hkdf_byte_rep(0xaa, 131), "Test Using Larger Than Block-Size Key - Hash Key First".bytes())),
    "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952",
  );
}

function test_hmac_sha256_bytes_message(): test.TestOutcome {
  return test.assert_eq(
    hex.hex_encode(crypto.hmac_sha256(__hkdf_byte_rep(0x0b, 20), "Hi There".bytes())),
    "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
  );
}

// HKDF-SHA384 over RFC 5869 test case 1's inputs, with outputs from Python's
// hmac module: one block and a bit, three blocks with a partial last one,
// and an empty salt.
function test_hkdf_sha384(): test.TestOutcome {
  let ikm: u8[] = __hkdf_byte_rep(11, 22);
  let salt: u8[] = hex.hex_decode("000102030405060708090a0b0c");
  let info: u8[] = hex.hex_decode("f0f1f2f3f4f5f6f7f8f9");
  let prk: u8[] = crypto.hkdf_sha384_extract(salt, ikm);
  if (hex.hex_encode(prk) != "704b39990779ce1dc548052c7dc39f303570dd13fb39f7acc564680bef80e8dec70ee9a7e1f3e293ef68eceb072a5ade") {
    return test.fail("extract");
  }
  if (hex.hex_encode(crypto.hkdf_sha384(salt, ikm, info, 42)) != "9b5097a86038b805309076a44b3a9f38063e25b516dcbf369f394cfab43685f748b6457763e4f0204fc5") {
    return test.fail("42 bytes");
  }
  let e: u8[] = [];
  if (hex.hex_encode(crypto.hkdf_sha384_extract(e, ikm)) != "10e40cf072a4c5626e43dd22c1cf727d4bb140975c9ad0cbc8e45b40068f8f0ba57cdb598af9dfa6963a96899af047e5") {
    return test.fail("empty salt");
  }
  return test.assert_eq(
    hex.hex_encode(crypto.hkdf_sha384_expand(prk, info, 100)),
    "9b5097a86038b805309076a44b3a9f38063e25b516dcbf369f394cfab43685f748b6457763e4f0204fc5d95d1da3e62587b22eb8943d0fab6bb631a2fe9df1a68c6ce5d56116a52005b3f122b88b39b7251fcd6c44d3ef25f20ed96802bf1b2c1d98bf74",
  );
}

// SHAKE128 and SHAKE256 (FIPS 202) for the empty message and for 200
// bytes of 0xa3, which is longer than either rate. Outputs past 64 bytes
// are compared by their SHA3-256.
function __a3x200(): u8[] {
  return __hkdf_byte_rep(0xa3, 200);
}

function __sha3_256_of(b: u8[]): string {
  return crypto.sha3_256_new().update_bytes(b).final_hex();
}

function test_shake128_empty(): test.TestOutcome {
  let e: u8[] = [];
  if (hex.hex_encode(crypto.shake128(e, 32)) != "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26") {
    return test.fail("32 bytes");
  }
  if (__sha3_256_of(crypto.shake128(e, 200)) != "0d8eb608fbb0c0196e2bb58ecd41e47aac9fbfbc2334e02e5d5a5767bf0a4d88") {
    return test.fail("200 bytes");
  }
  return test.assert_eq(__sha3_256_of(crypto.shake128(e, 512)), "783f768321fcc797b69ca9dc323343dbb776263d96e4c40e6c3b48678f355931");
}

function test_shake128_a3(): test.TestOutcome {
  if (hex.hex_encode(crypto.shake128(__a3x200(), 32)) != "131ab8d2b594946b9c81333f9bb6e0ce75c3b93104fa3469d3917457385da037") {
    return test.fail("32 bytes");
  }
  if (__sha3_256_of(crypto.shake128(__a3x200(), 200)) != "74aa9a100299230f02a2a0a01e12f18b58f324e3decca4468d4c684201085f4d") {
    return test.fail("200 bytes");
  }
  return test.assert_eq(__sha3_256_of(crypto.shake128(__a3x200(), 512)), "70ee622999bda44af5ef3bb03a4afb254e0973e12d8d6b3382e0613cfc8efc23");
}

function test_shake256_empty(): test.TestOutcome {
  let e: u8[] = [];
  if (hex.hex_encode(crypto.shake256(e, 64)) != "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be") {
    return test.fail("64 bytes");
  }
  if (__sha3_256_of(crypto.shake256(e, 200)) != "8f3e5ca710dda92d2d0dbfa8ee2d796ffdfca88bc43b97e1860e9ae24773ea03") {
    return test.fail("200 bytes");
  }
  return test.assert_eq(__sha3_256_of(crypto.shake256(e, 512)), "f758de459963f104daad27582204ddb6730c73b12dfbb359a10d97ed77ffd09b");
}

function test_shake256_a3(): test.TestOutcome {
  if (hex.hex_encode(crypto.shake256(__a3x200(), 32)) != "cd8a920ed141aa0407a22d59288652e9d9f1a7ee0c1e7c1ca699424da84a904d") {
    return test.fail("32 bytes");
  }
  if (__sha3_256_of(crypto.shake256(__a3x200(), 200)) != "efbb3e2319365b90f450f45a67944e009e2e0b629cf2a017cbf6c2ecdf225572") {
    return test.fail("200 bytes");
  }
  return test.assert_eq(__sha3_256_of(crypto.shake256(__a3x200(), 512)), "2730489e394c59f24db0aa5275070ec976a5e81f17599cb4c28149603ae10a09");
}

// Absorbing in two pieces and squeezing in five, across block boundaries,
// reads the same 512 bytes as the one-shot.
function test_shake_streaming(): test.TestOutcome {
  let msg: u8[] = __a3x200();
  let r: crypto.ShakeReader = crypto.shake128_new().update_bytes(msg[0:77]).update_bytes(msg[77:200]).reader();
  let out: u8[] = [];
  let sizes: i32[] = [1, 167, 1, 200, 143];
  let i: i32 = 0;
  while (i < 5) {
    let next: (u8[], crypto.ShakeReader) = r.squeeze(sizes[i]);
    out = out.concat(next.0);
    r = next.1;
    i = i + 1;
  }
  return test.assert_eq(hex.hex_encode(out), hex.hex_encode(crypto.shake128(msg, 512)));
}

// TOTP / HOTP (RFC 6238 SHA-256 mode) against Appendix B: key =
// "12345678901234567890123456789012" (32 ASCII bytes), 8 digits, 30s.
function test_totp_rfc6238(): test.TestOutcome {
  let key: u8[] = "12345678901234567890123456789012".bytes();
  if (crypto.totp_sha256(key, 59, 30, 8) != 46119246) {
    return test.fail("T=59");
  }
  if (crypto.totp_sha256(key, 1111111109, 30, 8) != 68084774) {
    return test.fail("T=1111111109");
  }
  if (crypto.totp_sha256(key, 20000000000, 30, 8) != 77737706) {
    return test.fail("T=2e10");
  }
  return test.pass();
}

function test_hotp_and_digits(): test.TestOutcome {
  let key: u8[] = "12345678901234567890123456789012".bytes();
  // TOTP at time 59 (period 30) is HOTP at counter 1.
  if (crypto.hotp_sha256(key, 1, 8) != 46119246) {
    return test.fail("hotp c=1");
  }
  // A 6-digit code is the low 6 digits of the 8-digit code.
  return test.assert_eq(crypto.hotp_sha256(key, 1, 6), 46119246 % 1000000);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/crypto");
  r = r.it("sha256 empty", test_sha256_empty);
  r = r.it("sha256 abc", test_sha256_abc);
  r = r.it("sha256 pangram", test_sha256_pangram);
  r = r.it("sha256_bytes len", test_sha256_bytes_len);
  r = r.it("hmac-sha256 vector", test_hmac_sha256);
  r = r.it("hmac_bytes len", test_hmac_bytes_len);
  r = r.it("consteq", test_consteq);
  r = r.it("hmac_verify", test_hmac_verify);
  r = r.it("hmac_verify_hex", test_hmac_verify_hex);
  r = r.it("pbkdf2 c=1", test_pbkdf2_c1);
  r = r.it("pbkdf2 c=2", test_pbkdf2_c2);
  r = r.it("pbkdf2 truncated", test_pbkdf2_truncated);
  r = r.it("pbkdf2 verify", test_pbkdf2_verify);
  r = r.it("hkdf TC1", test_hkdf_tc1);
  r = r.it("hkdf TC3 empty", test_hkdf_tc3_empty);
  r = r.it("hkdf expand==oneshot", test_hkdf_expand_matches_oneshot);
  r = r.it("hmac-sha384 RFC 4231", test_hmac_sha384_rfc4231);
  r = r.it("hmac-sha256 byte message", test_hmac_sha256_bytes_message);
  r = r.it("hkdf-sha384", test_hkdf_sha384);
  r = r.it("totp RFC 6238", test_totp_rfc6238);
  r = r.it("hotp + digits", test_hotp_and_digits);
  r = r.it("shake128 empty", test_shake128_empty);
  r = r.it("shake128 0xa3 x 200", test_shake128_a3);
  r = r.it("shake256 empty", test_shake256_empty);
  r = r.it("shake256 0xa3 x 200", test_shake256_a3);
  r = r.it("shake streaming", test_shake_streaming);
  return r.finish();
}
