import "std/test";
import "wavpack_check";
import "wavpack_vectors";

function main(): i32 {
  let runner = test.new("Independent WavPack lossless playback");
  for vector in wavpack_vectors.all() {
    runner = runner.it(vector.name, (): test.TestOutcome => wavpack_check.reference(vector));
  }
  return runner.finish();
}
