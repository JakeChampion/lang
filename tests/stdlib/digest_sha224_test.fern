import "std/test";
import "std/crypto" as crypto;
import "std/string";

function __pseudo(): u8[] {
  let b: u8[] = __alloc_u8(10003);
  let i: i32 = 0;
  while (i < 10003) {
    b = b.with(i, (i * 7 + 3 & 255) as u8);
    i = i + 1;
  }
  return b;
}

function __thousand_a(): string {
  let b: u8[] = __alloc_u8(1000);
  let i: i32 = 0;
  while (i < 1000) {
    b = b.with(i, 97 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

function test_empty(): test.TestOutcome {
  return test.assert_eq(crypto.sha224_new().final_hex(), "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f");
}

function test_abc(): test.TestOutcome {
  return test.assert_eq(crypto.sha224_new().update("abc".as_bytes()).final_hex(), "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7");
}

function test_multiblock(): test.TestOutcome {
  return test.assert_eq(
    crypto.sha224_new().update("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".as_bytes()).final_hex(),
    "75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525",
  );
}

function test_bytes_len(): test.TestOutcome {
  return test.assert_eq(crypto.sha224_new().update("abc".as_bytes()).final_bytes().len(), 28);
}

function test_million_a_chunked(): test.TestOutcome {
  let h: crypto.Sha256 = crypto.sha224_new();
  let chunk: string = __thousand_a();
  let i: i32 = 0;
  while (i < 1000) {
    h = h.update(chunk.as_bytes());
    i = i + 1;
  }
  return test.assert_eq(h.final_hex(), "20794655980c91d8bbb4c1ea97618a4bf03f42581948b2ee4ee7ad67");
}

function test_seven_byte_updates(): test.TestOutcome {
  let msg: u8[] = __pseudo();
  let h: crypto.Sha256 = crypto.sha224_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    h = h.update(msg[i:i + 7]);
    i = i + 7;
  }
  h = h.update(msg[i:10003]);
  let chunked: string = h.final_hex();
  let whole: string = crypto.sha224_new().update(msg).final_hex();
  if (chunked != "180cc94fa2f8fa787e1d0a7e4e33a351c7a97dae474735c9f91d558e") {
    return test.fail("chunked: " + chunked);
  }
  return test.assert_eq(chunked, whole);
}

function test_update_bytes_and_oneshot(): test.TestOutcome {
  let via_bytes: string = crypto.sha224_new().update("abc".bytes()).final_hex();
  if (via_bytes != crypto.sha224_hex("abc".as_bytes())) {
    return test.fail("one-shot differs: " + via_bytes);
  }
  return test.assert_eq(via_bytes, "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/crypto SHA-224");
  r = r.it("empty", test_empty);
  r = r.it("abc", test_abc);
  r = r.it("multi-block", test_multiblock);
  r = r.it("final_bytes len", test_bytes_len);
  r = r.it("million a, 1000x1000", test_million_a_chunked);
  r = r.it("7-byte updates", test_seven_byte_updates);
  r = r.it("update_bytes + one-shot", test_update_bytes_and_oneshot);
  return r.finish();
}
