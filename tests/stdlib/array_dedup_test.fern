import "std/test";
import "std/array";

function test_runs(): test.TestOutcome {
  return test.assert_eq_array(array.dedup([1, 1, 2, 2, 1]), [1, 2, 1]);
}

function test_all_equal(): test.TestOutcome {
  return test.assert_eq_array([7, 7, 7, 7].dedup(), [7]);
}

function test_no_dups(): test.TestOutcome {
  return test.assert_eq_array([1, 2, 3].dedup(), [1, 2, 3]);
}

function test_sorted_like_distinct(): test.TestOutcome {
  return test.assert_eq_array([1, 1, 2, 3, 3, 3, 4].dedup(), [1, 2, 3, 4]);
}

function test_empty(): test.TestOutcome {
  let e: i32[] = [];
  return test.assert_true(array.dedup(e).len() == 0);
}

function test_single(): test.TestOutcome {
  return test.assert_eq_array([5].dedup(), [5]);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/array dedup");
  r = r.it("runs", test_runs);
  r = r.it("all equal", test_all_equal);
  r = r.it("no dups", test_no_dups);
  r = r.it("sorted like distinct", test_sorted_like_distinct);
  r = r.it("empty", test_empty);
  r = r.it("single", test_single);
  return r.finish();
}
