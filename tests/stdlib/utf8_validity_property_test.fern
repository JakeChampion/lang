import "std/fuzz";
import "std/test";
import "std/string";
import "std/utf8" as utf8;

function alphabet(): string[] {
  return ["a", "Z", "1", " ", "\n", "_", "é", "ß", "中", "𝄞"];
}

function build(input: u8[]): string {
  let alpha: string[] = alphabet();
  let out: string = "";
  let n: i32 = input.len();
  if (n > 64) {
    n = 64;
  }
  let i: i32 = 0;
  while (i < n) {
    out = out + alpha[input[i] as i32 % alpha.len()];
    i = i + 1;
  }
  return out;
}

function ok(name: string, produced: string): string {
  if (utf8.is_valid_utf8(produced)) {
    return "";
  }
  return name + " produced invalid UTF-8";
}

function ok_all(name: string, produced: string[]): string {
  let i: i32 = 0;
  for part in produced {
    if (!utf8.is_valid_utf8(part)) {
      return name + " produced an invalid UTF-8 element at index " + i.to_string();
    }
    i = i + 1;
  }
  return "";
}

function first_fail(results: string[]): test.TestOutcome {
  for m in results {
    if (m.len() > 0) {
      return test.fail(m);
    }
  }
  return test.pass();
}

function check_byte_counts(input: u8[]): test.TestOutcome {
  let s: string = build(input);
  let n: i32 = 0;
  if (s.len() > 0) {
    n = input.len() * 7 % (s.len() + 1);
  }
  let (head, tail) = s.split_at(n);
  return first_fail([
    ok("take", s.take(n) + ""),
    ok("drop", s.drop(n) + ""),
    ok("slice_snap", s.slice_snap(0, n) + ""),
    ok("split_at.0", head),
    ok("split_at.1", tail),
    ok("truncate", s.truncate(n, "...")),
    ok("ellipsis", s.ellipsis(n)),
    ok("repeat_to", s.repeat_to(n)),
    ok_all("chunks", s.chunks(n + 1)),
  ]);
}

function check_slice_expression(input: u8[]): test.TestOutcome {
  let s: string = build(input);
  let lo: i32 = 0;
  let hi: i32 = 0;
  if (s.len() > 0) {
    lo = input.len() * 3 % (s.len() + 1);
    hi = input.len() * 5 % (s.len() + 1);
  }
  if (lo > hi) {
    return test.pass();
  }
  match (s[lo:hi]) {
    Some(v) => {
      return first_fail([ok("s[a:b]", v + "")]);
    },
    None => {
      return test.pass();
    }
  }
}

function check_width_ops(input: u8[]): test.TestOutcome {
  let s: string = build(input);
  let w: i32 = input.len() * 3 % 24;
  return first_fail([
    ok("pad_start", s.pad_start(w, "é")),
    ok("pad_end", s.pad_end(w, "中")),
    ok("center", s.center(w, "ß")),
    ok("indent", s.indent("  ")),
    ok("wrap", s.wrap("[", "]")),
  ]);
}

function check_case_and_style(input: u8[]): test.TestOutcome {
  let s: string = build(input);
  return first_fail([
    ok("to_upper", s.to_upper()),
    ok("to_lower", s.to_lower()),
    ok("swap_case", s.swap_case()),
    ok("capitalize", s.capitalize()),
    ok("title_case", s.title_case()),
    ok("case_fold", s.case_fold()),
    ok("snake_case", s.snake_case()),
    ok("kebab_case", s.kebab_case()),
    ok("camel_case", s.camel_case()),
    ok("pascal_case", s.pascal_case()),
    ok("slugify", s.slugify()),
  ]);
}

function chars_as_strings(s: string): string[] {
  let out: string[] = [];
  for c in s.chars() {
    out = out.append(utf8.utf8_encode(c));
  }
  return out;
}

function check_split_and_trim(input: u8[]): test.TestOutcome {
  let s: string = build(input);
  return first_fail([
    ok_all("split", s.split("é")),
    ok_all("lines", s.lines()),
    ok_all("fields", s.fields()),
    ok_all("chars", chars_as_strings(s)),
    ok("trim", s.trim() + ""),
    ok("trim_start", s.trim_start() + ""),
    ok("trim_end", s.trim_end() + ""),
    ok("reverse_words", s.reverse_words()),
    ok("replace", s.replace("é", "中")),
    ok("remove_all", s.remove_all("中")),
  ]);
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("utf8 validity is preserved by std/string");

  let seeds: u8[][] = [
    "".bytes(),
    "a".bytes(),
    "aZ1 \n_éß中𝄞".bytes(),
    "ééééé".bytes(),
    "𝄞𝄞𝄞".bytes(),
    "a é b 中 c".bytes(),
    "line one\nline two\n".bytes(),
  ];

  r = r.fuzz("byte-count operations snap to boundaries", seeds, 200, check_byte_counts);
  r = r.fuzz("s[a:b] Some payload is always valid", seeds, 200, check_slice_expression);
  r = r.fuzz("width padding keeps validity", seeds, 150, check_width_ops);
  r = r.fuzz("case and style conversion keeps validity", seeds, 150, check_case_and_style);
  r = r.fuzz("splitting and trimming keep validity", seeds, 150, check_split_and_trim);

  return r.finish();
}
