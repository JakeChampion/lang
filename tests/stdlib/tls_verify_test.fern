import "std/test";
import "core/int";
import "std/hex";
import "std/tls/pem";
import "std/tls/verify";
import "std/tls/x509";

// tests/stdlib/tls_verify_test.fern — std/tls/verify: chains made with
// Python's `cryptography` (P-256 with an intermediate, RSA and Ed25519),
// every refusal path validation has, name matching, and RFC 8448 §3's
// CertificateVerify signature checked under its certificate.

function ec_root(): u8[] {
  return hex.hex_decode("");
}

function ec_int(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_expired(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_no_eku(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_critical(): u8[] {
  return hex.hex_decode("");
}

function ec_int_not_ca(): u8[] {
  return hex.hex_decode("");
}

function ec_int2(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_under_int2(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_client(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf_sha384(): u8[] {
  return hex.hex_decode("");
}

function rsa_root(): u8[] {
  return hex.hex_decode("");
}

function rsa_leaf(): u8[] {
  return hex.hex_decode("");
}

function ed_root(): u8[] {
  return hex.hex_decode("");
}

function ed_leaf(): u8[] {
  return hex.hex_decode("");
}

// RFC 8448 §3's server certificate.
function rfc8448_certificate(): u8[] {
  return hex.hex_decode("");
}

// RFC 8448 §3's CertificateVerify signature.
function trace_signature(): u8[] {
  return hex.hex_decode("5a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3");
}

// 2026-05-28, inside every test certificate's validity.
function now(): i64 {
  return 1780000000 as i64;
}

function ec_roots(): verify.Roots {
  return verify.roots([ec_root()]);
}

function outcome(r: Result[x509.Certificate, verify.VerifyError]): string {
  match (r) {
    Ok(c) => {
      return "ok " + c.subject.common_name;
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function ec_chain(name: string): string {
  return outcome(verify.verify_server([ec_leaf(), ec_int()], ec_roots(), name, now()));
}

function test_valid_chains(): test.TestOutcome {
  if (ec_chain("example.com") != "ok example.com") {
    return test.fail("P-256 chain: " + ec_chain("example.com"));
  }
  if (outcome(verify.verify_server([rsa_leaf()], verify.roots([rsa_root()]), "rsa.example", now())) != "ok rsa.example") {
    return test.fail("RSA");
  }
  if (outcome(verify.verify_server([ed_leaf()], verify.roots([ed_root()]), "ed.example", now())) != "ok ed.example") {
    return test.fail("Ed25519");
  }
  if (outcome(verify.verify_server([ec_leaf_sha384(), ec_int()], ec_roots(), "example.com", now())) != "ok example.com") {
    return test.fail("SHA-384");
  }
  // Intermediates in any order, with an unrelated certificate among them;
  // a leaf with no extended key usage may serve.
  if (outcome(verify.verify_server([ec_leaf(), rsa_root(), ec_int()], ec_roots(), "example.com", now())) != "ok example.com") {
    return test.fail("order");
  }
  return test.assert_eq(outcome(verify.verify_server([ec_leaf_no_eku(), ec_int()], ec_roots(), "example.com", now())), "ok example.com");
}

// One chain verified for one name; the rest are matched against its leaf.
function test_names(): test.TestOutcome {
  if (ec_chain("www.example.com") != "tls verify: the certificate is not valid for www.example.com") {
    return test.fail("a name the chain does not cover");
  }
  match (x509.parse(ec_leaf())) {
    Ok(leaf) => {
      let good: string[] = ["example.com", "EXAMPLE.com.", "a.example.org", "192.0.2.1"];
      for n in good {
        if (!verify.matches_name(leaf, n)) {
          return test.fail(n);
        }
      }
      let bad: string[] = ["example.org", "a.b.example.org", "www.example.com", "192.0.2.2", ".example.org", "*.example.org"];
      for n in bad {
        if (verify.matches_name(leaf, n)) {
          return test.fail(n + " accepted");
        }
      }
      return test.pass();
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function test_time(): test.TestOutcome {
  if (outcome(verify.verify_server([ec_leaf_expired(), ec_int()], ec_roots(), "example.com", now())) != "tls verify: certificate 0 has expired") {
    return test.fail("expired");
  }
  return test.assert_eq(outcome(verify.verify_server([ec_leaf(), ec_int()], ec_roots(), "example.com", 1700000000 as i64)), "tls verify: certificate 0 is not yet valid");
}

function test_refusals(): test.TestOutcome {
  if (outcome(verify.verify_server([ec_leaf(), ec_int()], verify.roots([rsa_root()]), "example.com", now())) != "tls verify: no path from the certificate reaches a trusted root") {
    return test.fail("unknown root");
  }
  if (outcome(verify.verify_server([ec_leaf()], ec_roots(), "example.com", now())) != "tls verify: no path from the certificate reaches a trusted root") {
    return test.fail("missing intermediate");
  }
  if (outcome(verify.verify_server([ec_leaf_client(), ec_int()], ec_roots(), "example.com", now())) != "tls verify: the certificate is not for TLS servers") {
    return test.fail("client authentication only");
  }
  if (outcome(verify.verify_server([ec_leaf_critical(), ec_int()], ec_roots(), "example.com", now())) != "tls verify: certificate 0 has an unknown critical extension 1.3.6.1.4.1.99999.1") {
    return test.fail("unknown critical extension");
  }
  if (outcome(verify.verify_server([ec_leaf(), ec_int_not_ca()], ec_roots(), "example.com", now())) != "tls verify: certificate 1 issues certificates but is not a CA") {
    return test.fail("not a CA");
  }
  // The first intermediate allows no intermediate below it.
  if (outcome(verify.verify_server([ec_leaf_under_int2(), ec_int2(), ec_int()], ec_roots(), "example.com", now())) != "tls verify: certificate 2 allows a shorter path") {
    return test.fail("path length");
  }
  if (outcome(verify.verify_server([], ec_roots(), "example.com", now())) != "tls verify: the chain is empty") {
    return test.fail("empty");
  }
  return test.assert_eq(outcome(verify.verify_server([[1 as u8, 2 as u8]], ec_roots(), "example.com", now())), "tls verify: certificate 0: x509: der: truncated");
}

// One flipped bit in the leaf's serial number breaks its signature.
function test_bad_signature(): test.TestOutcome {
  let b: u8[] = ec_leaf();
  let serial: i32 = 0;
  while (serial + 2 < b.len() && !(b[serial] == 0x02 && b[serial + 1] == 0x01 && b[serial + 2] == 0x03)) {
    serial = serial + 1;
  }
  return test.assert_eq(outcome(verify.verify_server([b.with(serial + 2, 0x07 as u8), ec_int()], ec_roots(), "example.com", now())), "tls verify: certificate 0's signature does not verify");
}

function test_roots_from_pem(): test.TestOutcome {
  let bundle: string = pem.encode("CERTIFICATE", rsa_root()) + pem.encode("CERTIFICATE", ec_root());
  match (verify.roots_from_pem(bundle)) {
    Ok(r) => {
      if (r.certs.len() != 2) {
        return test.fail("two roots");
      }
      return test.assert_eq(outcome(verify.verify_server([ec_leaf(), ec_int()], r, "example.com", now())), "ok example.com");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

// RFC 8448 §3's CertificateVerify: rsa_pss_rsae_sha256 over the transcript
// through the server's Certificate.
function trace_signed(): u8[] {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < 64) {
    out = out.append(0x20 as u8);
    i = i + 1;
  }
  for b in "TLS 1.3, server CertificateVerify".bytes() {
    out = out.append(b);
  }
  out = out.append(0 as u8);
  for b in hex.hex_decode("764d6632b3c35c3f3205e3499ac3edbaabb88295fba751461d3678e2e5ea0687") {
    out = out.append(b);
  }
  return out;
}

function test_certificate_verify(): test.TestOutcome {
  match (x509.parse(rfc8448_certificate())) {
    Ok(c) => {
      let sig: u8[] = trace_signature();
      if (!verify.verify_signed(c, 0x0804, trace_signed(), sig)) {
        return test.fail("the trace's signature");
      }
      if (verify.verify_signed(c, 0x0403, trace_signed(), sig) || verify.verify_signed(c, 0x0804, trace_signed().with(70, 0 as u8), sig)) {
        return test.fail("a wrong scheme or content accepted");
      }
      // The certificate is self-signed, with PKCS #1 v1.5 over SHA-256.
      match (verify.signature_ok(c.key, c.algorithm, c.tbs, c.signature)) {
        Ok(ok) => {
          return test.assert_eq(ok, true);
        },
        Err(e) => {
          return test.fail(e.message());
        }
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/tls/verify");
  r = r.it("valid chains", test_valid_chains);
  r = r.it("names", test_names);
  r = r.it("validity periods", test_time);
  r = r.it("refusals", test_refusals);
  r = r.it("a bad signature", test_bad_signature);
  r = r.it("roots from PEM", test_roots_from_pem);
  r = r.it("RFC 8448's CertificateVerify", test_certificate_verify);
  return r.finish();
}
