import "std/test";
import "std/cli" as cli;
import "std/option";

function spec(): cli.CliSpec {
  let s: cli.CliSpec = cli.cli_new("greet", "print a greeting");
  s = s.option("name", "n", "who to greet");
  s = s.flag("shout", "s", "upper-case the greeting");
  s = s.flag("verbose", "v", "explain what is happening");
  return s;
}

function test_option_long(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "--name", "Ada"]);
  return test.assert_eq(a.value_or("name", "world"), "Ada");
}

function test_option_equals(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "--name=Bob"]);
  return test.assert_eq(a.value_or("name", "world"), "Bob");
}

function test_option_short(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "-n", "Cy"]);
  return test.assert_eq(a.value_or("name", "world"), "Cy");
}

function test_bool_flag(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "--shout"]);
  let b: cli.CliArgs = spec().parse(["greet", "-s"]);
  return test.assert_true(a.is_set("shout") && b.is_set("shout"));
}

function test_positionals(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "--name", "Ada", "one", "two"]);
  return test.assert_eq_array(a.operands(), ["one", "two"]);
}

function test_end_of_options(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "--", "--name", "-s"]);
  return test.assert_true(a.operands().len() == 2 && !a.is_set("name") && !a.is_set("shout"));
}

function test_value_or_default(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet"]);
  return test.assert_true(a.value_or("name", "world") == "world" && !a.is_set("shout"));
}

function test_unknown_option_errors(): test.TestOutcome {
  return test.assert_true(spec().parse(["greet", "--nope"]).is_error());
}

function test_missing_value_errors(): test.TestOutcome {
  return test.assert_true(spec().parse(["greet", "--name"]).is_error());
}

function test_value_on_bool_errors(): test.TestOutcome {
  return test.assert_true(spec().parse(["greet", "--shout=1"]).is_error());
}

function test_usage_lists_flags(): test.TestOutcome {
  let u: string = spec().usage();
  return test.assert_true(u.contains("--name") && u.contains("--shout") && u.contains("greet"));
}

function test_short_glued_value(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "-n5"]);
  return test.assert_eq(a.value_or("name", "x"), "5");
}

function test_short_bundled_bools(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "-vs"]);
  return test.assert_true(a.is_set("verbose") && a.is_set("shout"));
}

function test_short_bundle_ending_valued(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "-vn5"]);
  return test.assert_true(a.is_set("verbose") && a.value_or("name", "x") == "5");
}

function test_short_bundle_next_token_value(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "-vn", "5"]);
  return test.assert_true(a.is_set("verbose") && a.value_or("name", "x") == "5" && a.operands().len() == 0);
}

function test_short_lone_dash_is_positional(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "-"]);
  return test.assert_true(a.operands().len() == 1 && !a.is_error());
}

function test_short_multibyte_unknown(): test.TestOutcome {
  let a: cli.CliArgs = spec().parse(["greet", "-é"]);
  if (!a.is_error()) {
    return test.fail("expected an unknown-option error");
  }
  return test.assert_eq(a.error_text(), "unknown option -é");
}

function test_color_red(): test.TestOutcome {
  let red: string = cli.cli_red("x");
  if (cli.cli_color_enabled()) {
    return test.assert_true(red[0] == 27 && red.contains("31m") && red.contains("x"));
  }
  return test.assert_eq(red, "x");
}

function test_color_bold(): test.TestOutcome {
  let b: string = cli.cli_bold("hi");
  if (cli.cli_color_enabled()) {
    return test.assert_true(b[0] == 27 && b.contains("1m") && b.contains("hi"));
  }
  return test.assert_eq(b, "hi");
}

function spec_cmds(): cli.CliSpec {
  let deploy: cli.CliSpec = cli.cli_new("deploy", "push the build");
  deploy = deploy.option("env", "e", "target environment");
  let s: cli.CliSpec = cli.cli_new("tool", "ship things");
  s = s.flag("verbose", "v", "explain what is happening");
  s = s.option("name", "n", "who to ship as");
  return s.command(deploy);
}

function test_subcommand_parses(): test.TestOutcome {
  let a: cli.CliArgs = spec_cmds().parse(["tool", "-v", "deploy", "--env", "prod", "x"]);
  if (a.is_error()) {
    return test.fail(a.error_text());
  }
  return test.assert_true(a.subcommand().unwrap_or("") == "deploy" && a.is_set("verbose") && a.value_or("env", "") == "prod" && a.operands().len() == 1);
}

function test_unknown_command_errors(): test.TestOutcome {
  let a: cli.CliArgs = spec_cmds().parse(["tool", "launch"]);
  if (!a.is_error()) {
    return test.fail("expected an unknown-command error");
  }
  return test.assert_eq(a.error_text(), "unknown command launch");
}

function test_no_subcommand_is_none(): test.TestOutcome {
  let a: cli.CliArgs = spec_cmds().parse(["tool", "-v"]);
  return test.assert_true(!a.is_error() && a.subcommand().is_none() && a.is_set("verbose"));
}

function test_subcommand_scopes_flags(): test.TestOutcome {
  let a: cli.CliArgs = spec_cmds().parse(["tool", "deploy", "--name", "x"]);
  if (!a.is_error()) {
    return test.fail("expected an unknown-option error");
  }
  return test.assert_eq(a.error_text(), "unknown option --name");
}

function test_usage_lists_commands(): test.TestOutcome {
  let u: string = spec_cmds().usage();
  return test.assert_true(u.contains("<command>") && u.contains("Commands:") && u.contains("deploy") && u.contains("push the build"));
}

function test_completion_bash(): test.TestOutcome {
  match (spec_cmds().completion("bash")) {
    Some(c) => {
      return test.assert_true(c.contains("complete -o default -F _tool tool") && c.contains("--verbose -v") && c.contains("deploy) words='--env -e'"));
    },
    None => {
      return test.fail("bash is a supported shell");
    }
  }
}

function test_completion_zsh(): test.TestOutcome {
  match (spec_cmds().completion("zsh")) {
    Some(c) => {
      return test.assert_true(c.starts_with("#compdef tool\n") && c.contains("{-n,--name}'[who to ship as]:value:_files'") && c.contains("'deploy:push the build'"));
    },
    None => {
      return test.fail("zsh is a supported shell");
    }
  }
}

function test_completion_fish(): test.TestOutcome {
  match (spec_cmds().completion("fish")) {
    Some(c) => {
      return test.assert_true(c.contains("complete -c tool -n __fish_use_subcommand -l name -s n -d 'who to ship as' -r\n") && c.contains("complete -c tool -n '__fish_seen_subcommand_from deploy' -l env -s e"));
    },
    None => {
      return test.fail("fish is a supported shell");
    }
  }
}

function test_completion_unknown_shell(): test.TestOutcome {
  return test.assert_true(spec().completion("powershell").is_none());
}

function test_completion_quotes_help(): test.TestOutcome {
  let s: cli.CliSpec = cli.cli_new("q", "quoting");
  s = s.flag("it", "", "don't break");
  match (s.completion("fish")) {
    Some(c) => {
      return test.assert_true(c.contains("-d 'don'\\''t break'"));
    },
    None => {
      return test.fail("fish is a supported shell");
    }
  }
}

function test_manpage_sections(): test.TestOutcome {
  let m: string = spec().manpage("1");
  return test.assert_true(m.contains(".TH \"greet\" \"1\"")
    && m.contains(".SH NAME\ngreet \\- print a greeting")
    && m.contains(".SH SYNOPSIS\n\\fBgreet\\fR [options] [args]")
    && m.contains(".SH DESCRIPTION\nprint a greeting")
    && m.contains(".SH OPTIONS\n"));
}

function test_manpage_flags(): test.TestOutcome {
  let m: string = spec().manpage("1");
  return test.assert_true(m.contains(".TP\n\\fB\\-n\\fR, \\fB\\-\\-name\\fR \\fI<value>\\fR\nwho to greet")
    && m.contains(".TP\n\\fB\\-s\\fR, \\fB\\-\\-shout\\fR\nupper-case the greeting")
    && !m.contains("\\-\\-shout\\fR \\fI<value>"));
}

function test_manpage_commands(): test.TestOutcome {
  let m: string = spec_cmds().manpage("8");
  return test.assert_true(m.contains(".TH \"tool\" \"8\"")
    && m.contains("\\fBtool\\fR [options] <command> [args]")
    && m.contains(".SH COMMANDS\n.TP\n\\fBdeploy\\fR\npush the build"));
}

function test_manpage_roff_escapes_backslash(): test.TestOutcome {
  let s: cli.CliSpec = cli.cli_new("bs", "escaping");
  s = s.flag("win", "", "a \\ separator");
  let m: string = s.manpage("1");
  return test.assert_true(m.contains("a \\\\ separator") && !m.contains("a \\ separator"));
}

function test_manpage_roff_escapes_leading_dot(): test.TestOutcome {
  let s: cli.CliSpec = cli.cli_new("dot", ".config tool");
  s = s.flag("run", "", "./build first");
  let m: string = s.manpage("1");
  return test.assert_true(m.contains(".SH DESCRIPTION\n\\&.config tool")
    && m.contains("\\&./build first")
    && !m.contains("\n./build first"));
}

function test_usage_spec_leaf(): test.TestOutcome {
  let k: string = spec().usage_spec();
  return test.assert_eq(k, "bin \"greet\"\n"
    + "about \"print a greeting\"\n"
    + "flag \"-n --name <name>\" help=\"who to greet\"\n"
    + "flag \"-s --shout\" help=\"upper-case the greeting\"\n"
    + "flag \"-v --verbose\" help=\"explain what is happening\"\n"
    + "arg \"[args]...\" var=#true\n");
}

function test_usage_spec_commands(): test.TestOutcome {
  let k: string = spec_cmds().usage_spec();
  return test.assert_true(k.contains("bin \"tool\"\n")
    && k.contains("cmd \"deploy\" help=\"push the build\" {\n  flag ")
    && k.contains("\n  arg \"[args]...\" var=#true\n}\n")
    && !k.contains("\narg "));
}

function test_usage_spec_quotes(): test.TestOutcome {
  let s: cli.CliSpec = cli.cli_new("q", "");
  s = s.flag("raw", "", "keep \"as is\", C:\\path");
  return test.assert_eq(s.usage_spec(), "bin \"q\"\nflag \"--raw\" help=\"keep \\\"as is\\\", C:\\\\path\"\narg \"[args]...\" var=#true\n");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/cli");
  r = r.it("option --long V", test_option_long);
  r = r.it("option --long=V", test_option_equals);
  r = r.it("option -short V", test_option_short);
  r = r.it("boolean flag", test_bool_flag);
  r = r.it("positional operands", test_positionals);
  r = r.it("-- ends options", test_end_of_options);
  r = r.it("value_or default", test_value_or_default);
  r = r.it("unknown option errors", test_unknown_option_errors);
  r = r.it("missing value errors", test_missing_value_errors);
  r = r.it("value on bool errors", test_value_on_bool_errors);
  r = r.it("usage lists flags", test_usage_lists_flags);
  r = r.it("short glued value -n5", test_short_glued_value);
  r = r.it("short bundled bools -vs", test_short_bundled_bools);
  r = r.it("short bundle ending valued -vn5", test_short_bundle_ending_valued);
  r = r.it("short bundle next-token value -vn 5", test_short_bundle_next_token_value);
  r = r.it("lone dash is positional", test_short_lone_dash_is_positional);
  r = r.it("multibyte short flag unknown", test_short_multibyte_unknown);
  r = r.it("colour red wraps or passes", test_color_red);
  r = r.it("colour bold wraps or passes", test_color_bold);
  r = r.it("subcommand parses", test_subcommand_parses);
  r = r.it("unknown command errors", test_unknown_command_errors);
  r = r.it("no subcommand is none", test_no_subcommand_is_none);
  r = r.it("subcommand scopes flags", test_subcommand_scopes_flags);
  r = r.it("usage lists commands", test_usage_lists_commands);
  r = r.it("completion bash", test_completion_bash);
  r = r.it("completion zsh", test_completion_zsh);
  r = r.it("completion fish", test_completion_fish);
  r = r.it("completion unknown shell", test_completion_unknown_shell);
  r = r.it("completion quotes help", test_completion_quotes_help);
  r = r.it("manpage sections", test_manpage_sections);
  r = r.it("manpage flags", test_manpage_flags);
  r = r.it("manpage commands", test_manpage_commands);
  r = r.it("manpage escapes backslash", test_manpage_roff_escapes_backslash);
  r = r.it("manpage escapes leading dot", test_manpage_roff_escapes_leading_dot);
  r = r.it("usage spec leaf", test_usage_spec_leaf);
  r = r.it("usage spec commands", test_usage_spec_commands);
  r = r.it("usage spec quotes", test_usage_spec_quotes);
  return r.finish();
}
