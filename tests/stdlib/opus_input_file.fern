import "std/audio/opusfile";
import "std/audio/opusfile/input";
import "std/audio/opusfile/file";
import "std/audio/source";
import "opus_file_check";
import "opus_file_vectors";
import "opus_input_check";

function event(own state: input.Input, source: Reader, cooperative: boolean): Result[(input.Input, input.ReadEvent), input.ReadError] {
  if (cooperative) {
    return state.step(source);
  }
  let (next, value) = state.next(source)?;
  return Ok((next, match (value) { Some(value) => input.Output(value), None => input.Finished }));
}

function complete(source: Reader, ref: opus_file_check.Reference, progress: opus_file_check.Progress): Result[void, string] {
  let offset = match (source.seek(0i64, 1)) { Ok(value) => value, Err(e) => { return Err("seek: " + e.message()); } };
  if (offset != ref.bytes.len() as i64 || progress.link != ref.links.len()) {
    return Err("file position or complete reference PCM");
  }
  return Ok(());
}

function decode(source: Reader, ref: opus_file_check.Reference, cooperative: boolean): Result[void, string] {
  let state = match (input.create(opusfile.default_limits(), 17)) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
  let progress = opus_file_check.Progress { link: 0, stage: 0, samples: 0 };
  while (true) {
    let (next, value) = match (event(state, source, cooperative)) { Ok(value) => value, Err(e) => { return Err("decode: " + e.message()); } };
    state = next;
    let (current, finished) = opus_input_check.progress_event(value, ref, progress)?;
    progress = current;
    if (finished) {
      break;
    }
  }
  return complete(source, ref, progress);
}

function indexed(reader: Reader, ref: opus_file_check.Reference): Result[void, string] {
  let index = match (file.inspect(reader, opusfile.default_seek_limits())) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
  let cursor = opusfile.seek_reader(index);
  let (_, count) = cursor.want();
  if (count > 1) {
    if let Err(source.ReadSize) = file.step(reader, cursor, source.Limits { chunk_size: 1, max_buffer_bytes: 1 }) {} else {
      return Err("indexed read exceeded its window budget");
    }
    let fresh = match (file.inspect(reader, opusfile.default_seek_limits())) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
    cursor = opusfile.seek_reader(fresh);
  }
  let limits = source.Limits { chunk_size: 17, max_buffer_bytes: ref.bytes.len() };
  for link in 0..ref.links.len() {
    let want = ref.links[link];
    for start in [want.frames / 2i64, 0i64] {
      cursor = match (cursor.seek_exact(link, start)) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
      let progress = opus_file_check.Progress { link: link, stage: 2, samples: start as i32 * (want.fields[1] as i32) };
      while (progress.samples < want.pcm.len() / 4) {
        let (next, event) = match (file.step(reader, cursor, limits)) { Ok(value) => value, Err(e) => { return Err(e.message()); } };
        cursor = next;
        match (event) {
          opusfile.SeekSamples(audio) => {
            progress = opus_file_check.event_progress(Some(opusfile.Samples(audio)), ref, progress)?;
          },
          opusfile.SeekEnd => {
            return Err("early end of indexed file");
          },
          opusfile.SeekPending => {}
        }
      }
    }
  }
  return Ok(());
}

function read_file(path: string, ref: opus_file_check.Reference, mode: string): Result[void, string] {
  let source = match (open_reader(path)) { Ok(value) => value, Err(e) => { return Err("open: " + e.message()); } };
  let result = match (mode) {
    "indexed" => indexed(source, ref),
    "cooperative" => decode(source, ref, true),
    "sequential" => decode(source, ref, false),
    _ => Err("unknown reader mode"),
  };
  let closed = source.close();
  result?;
  return match (closed) { Ok(_) => Ok(()), Err(e) => Err(e.message()) };
}

function main(): i32 {
  let argv = args();
  if (argv.len() != 2 && argv.len() != 3) {
    return 2;
  }
  let Ok(ref) = opus_file_check.reference(opus_file_vectors.SMOKE) else {
    return 3;
  };
  let modes = ["sequential", "cooperative", "indexed"];
  if (argv.len() == 3) {
    modes = [argv[2]];
  }
  for mode in modes {
    if let Err(message) = read_file(argv[1], ref, mode) {
      eprint(message);
      return 1;
    }
  }
  return 0;
}
