import "std/log";
import "std/test";
import "std/string";

function test_text_basic(): test.TestOutcome {
  let lg: log.Logger = log.new_logger(log.level_info());
  return test.assert_eq(lg.info_().render("hello"), "[INFO] hello\n");
}

function test_text_fields(): test.TestOutcome {
  let lg: log.Logger = log.new_logger(log.level_trace());
  let line: string = lg.warn_().str("user", "bob").int("id", 7).bool("ok", true).render("hi");
  return test.assert_eq(line, "[WARN] hi user=bob id=7 ok=true\n");
}

function test_threshold_filters_below(): test.TestOutcome {
  let lg: log.Logger = log.new_logger(log.level_info());
  if (lg.debug_().str("k", "v").render("d") != "") {
    return test.fail("DEBUG should be filtered at INFO threshold");
  }
  return test.assert_eq(lg.trace_().render("t"), "");
}

function test_threshold_passes_at_or_above(): test.TestOutcome {
  let lg: log.Logger = log.new_logger(log.level_warn());
  if (lg.warn_().render("w") == "") {
    return test.fail("WARN should pass at WARN threshold");
  }
  return test.assert_eq(lg.error_().render("e"), "[ERROR] e\n");
}

function test_json_basic(): test.TestOutcome {
  let lg: log.Logger = log.new_json_logger(log.level_trace());
  return test.assert_eq(lg.info_().render("m"), "{\"level\":\"INFO\",\"msg\":\"m\"}\n");
}

function test_json_fields(): test.TestOutcome {
  let lg: log.Logger = log.new_json_logger(log.level_trace());
  let line: string = lg.error_().str("k", "v").int("n", 42).bool("ok", false).render("boom");
  return test.assert_eq(line, "{\"level\":\"ERROR\",\"msg\":\"boom\",\"k\":\"v\",\"n\":42,\"ok\":false}\n");
}

function test_json_escaping(): test.TestOutcome {
  let lg: log.Logger = log.new_json_logger(log.level_trace());
  let line: string = lg.info_().render("a\"b\\c");
  return test.assert_eq(line, "{\"level\":\"INFO\",\"msg\":\"a\\\"b\\\\c\"}\n");
}

function test_json_escaping_whitespace(): test.TestOutcome {
  let lg: log.Logger = log.new_json_logger(log.level_trace());
  let line: string = lg.info_().render("x\ny\rz\tw");
  return test.assert_eq(line, "{\"level\":\"INFO\",\"msg\":\"x\\ny\\rz\\tw\"}\n");
}

function test_json_escaping_control(): test.TestOutcome {
  let raw: u8[] = [65 as u8, 1 as u8, 66 as u8, 31 as u8];
  let msg: string = string_from_bytes_unchecked(raw);
  let lg: log.Logger = log.new_json_logger(log.level_trace());
  let line: string = lg.info_().render(msg);
  return test.assert_eq(line, "{\"level\":\"INFO\",\"msg\":\"A\\u0001B\\u001f\"}\n");
}

function test_level_names(): test.TestOutcome {
  if (log.level_name(log.level_trace()) != "TRACE") {
    return test.fail("trace name");
  }
  if (log.level_name(log.level_debug()) != "DEBUG") {
    return test.fail("debug name");
  }
  if (log.level_name(log.level_info()) != "INFO") {
    return test.fail("info name");
  }
  if (log.level_name(log.level_warn()) != "WARN") {
    return test.fail("warn name");
  }
  return test.assert_eq(log.level_name(log.level_error()), "ERROR");
}

function test_at_explicit_level(): test.TestOutcome {
  let lg: log.Logger = log.new_logger(log.level_debug());
  return test.assert_eq(lg.at(log.level_debug()).render("x"), "[DEBUG] x\n");
}

function test_sink_receives_each_line(): test.TestOutcome {
  let seen: Cell[string] = cell_new("");
  let lg: log.Logger = log.new_json_logger(log.level_info()).to((line: string): void => { seen.set(seen.get() + line + "|"); });
  lg.info_().emit("a");
  lg.debug_().emit("dropped");
  lg.warn_().str("k", "v").emit("b");
  return test.assert_eq(seen.get(), "{\"level\":\"INFO\",\"msg\":\"a\"}|{\"level\":\"WARN\",\"msg\":\"b\",\"k\":\"v\"}|");
}

function test_sink_keeps_level_and_mode(): test.TestOutcome {
  let seen: Cell[string] = cell_new("");
  let lg: log.Logger = log.new_logger(log.level_warn()).to((line: string): void => { seen.set(seen.get() + "<" + line + ">"); });
  lg.info_().emit("quiet");
  lg.error_().int("n", 3).emit("loud");
  if (lg.error_().int("n", 3).render("loud") != "[ERROR] loud n=3\n") {
    return test.fail("render keeps its newline");
  }
  return test.assert_eq(seen.get(), "<[ERROR] loud n=3>");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("leveled logger");
  r = r.it("text basic", test_text_basic);
  r = r.it("text fields", test_text_fields);
  r = r.it("threshold filters below", test_threshold_filters_below);
  r = r.it("threshold passes at/above", test_threshold_passes_at_or_above);
  r = r.it("json basic", test_json_basic);
  r = r.it("json fields", test_json_fields);
  r = r.it("json escaping", test_json_escaping);
  r = r.it("level names", test_level_names);
  r = r.it("at explicit level", test_at_explicit_level);
  r = r.it("json escaping whitespace", test_json_escaping_whitespace);
  r = r.it("json escaping control", test_json_escaping_control);
  r = r.it("sink receives each line", test_sink_receives_each_line);
  r = r.it("sink keeps level and mode", test_sink_keeps_level_and_mode);
  return r.finish();
}
