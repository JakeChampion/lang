import "std/fuzz";
import "std/test";
import "std/string";

function check_no_x(input: u8[]): test.TestOutcome {
  if (input.len() < 0) {
    return test.fail("len negative");
  }
  return test.pass();
}

function test_corpus_loads_and_runs(r: test.TestRunner): test.TestRunner {
  let (dir, rr) = test.must_temp_dir(r, "corpus-loads");
  if (dir == "") {
    return rr;
  }
  match (write_file(dir + "/01.bin", "hello")) {
    Ok(_) => {},
    Err(_) => {
      return rr.it("write 01", () => test.fail("io"));
    }
  }
  match (write_file(dir + "/02.bin", "world")) {
    Ok(_) => {},
    Err(_) => {
      return rr.it("write 02", () => test.fail("io"));
    }
  }
  match (write_file(dir + "/03.bin", "anything")) {
    Ok(_) => {},
    Err(_) => {
      return rr.it("write 03", () => test.fail("io"));
    }
  }
  match (write_file(dir + "/_skipme", "meta")) {
    Ok(_) => {},
    Err(_) => {
      return rr.it("write meta", () => test.fail("io"));
    }
  }

  match (fuzz.fuzz_corpus_from_dir(dir)) {
    Ok(seeds) => {
      rr = rr.it(
        "loads three seeds (skips _-prefixed)",
        () => test.assert_eq(seeds.len(), 3),
      );
      rr = rr.it(
        "first seed is 01.bin's content",
        () => test.assert_eq_array(seeds[0], "hello".bytes()),
      );
      rr = rr.fuzz_shrink(
        "corpus-loaded fuzz harness",
        seeds, 50, check_no_x,
      );
    },
    Err(_) => {
      rr = rr.it("load", () => test.fail("load returned Err"));
    }
  }
  return rr;
}

function test_corpus_dir_missing_uses_fallback(): test.TestOutcome {
  let seeds: u8[][] = fuzz.fuzz_corpus_from_dir_or(
    "/tmp/lang-corpus-definitely-does-not-exist-83472",
    ["one".bytes(), "two".bytes(), "three".bytes()],
  );
  return test.assert_eq(seeds.len(), 3);
}

function test_corpus_dir_empty_uses_fallback(r: test.TestRunner): test.TestRunner {
  let (dir, rr) = test.must_temp_dir(r, "corpus-empty");
  if (dir == "") {
    return rr;
  }
  let seeds: u8[][] = fuzz.fuzz_corpus_from_dir_or(dir, ["fallback".bytes()]);
  return rr.it("empty corpus falls back", () => test.assert_eq(seeds.len(), 1));
}

function test_new_mutators_dont_crash(): test.TestOutcome {
  return fuzz.fuzz_run(
    ["".bytes(), "abc".bytes(), "Hello World".bytes()],
    fuzz.fuzz_default_iterations(),
    check_no_x,
  );
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("fuzz corpus");
  r = test_corpus_loads_and_runs(r);
  r = r.it(
    "missing corpus dir falls back",
    test_corpus_dir_missing_uses_fallback,
  );
  r = test_corpus_dir_empty_uses_fallback(r);
  r = r.it("new mutators don't crash", test_new_mutators_dont_crash);
  return r.finish();
}
