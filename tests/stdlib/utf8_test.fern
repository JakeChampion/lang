import "std/test";
import "std/utf8" as utf8;
import "std/string";

function mixed(): string {
  let b: u8[] = [
    65 as u8, 195 as u8, 169 as u8, 226 as u8, 130 as u8,
    172 as u8, 240 as u8, 159 as u8, 152 as u8, 128 as u8,
  ];
  return string_from_bytes_unchecked(b);
}

function decode_cp(s: string, i: i32): i32 {
  match (utf8.decode_at(s, i)) {
    Some(p) => {
      return p.0;
    },
    None => {
      return 0 - 1;
    }
  }
}

function decode_len(s: string, i: i32): i32 {
  match (utf8.decode_at(s, i)) {
    Some(p) => {
      return p.1;
    },
    None => {
      return 0 - 1;
    }
  }
}

function test_decode_ascii(): test.TestOutcome {
  return test.assert_true(decode_cp("A", 0) == 65 && decode_len("A", 0) == 1);
}

function test_decode_two_byte(): test.TestOutcome {
  let s: string = string_from_bytes_unchecked([195 as u8, 169 as u8]);
  return test.assert_true(decode_cp(s, 0) == 233 && decode_len(s, 0) == 2);
}

function test_decode_three_byte(): test.TestOutcome {
  let s: string = string_from_bytes_unchecked([226 as u8, 130 as u8, 172 as u8]);
  return test.assert_true(decode_cp(s, 0) == 8364 && decode_len(s, 0) == 3);
}

function test_decode_four_byte(): test.TestOutcome {
  let s: string = string_from_bytes_unchecked([240 as u8, 159 as u8, 152 as u8, 128 as u8]);
  return test.assert_true(decode_cp(s, 0) == 128512 && decode_len(s, 0) == 4);
}

function test_decode_at_offset(): test.TestOutcome {
  return test.assert_true(decode_cp(mixed(), 3) == 8364 && decode_len(mixed(), 3) == 3);
}

function test_decode_stray_continuation(): test.TestOutcome {
  let s: string = string_from_bytes_unchecked([128 as u8]);
  return test.assert_eq(decode_cp(s, 0), 0 - 1);
}

function test_decode_truncated(): test.TestOutcome {
  let s: string = string_from_bytes_unchecked([226 as u8, 130 as u8]);
  return test.assert_eq(decode_cp(s, 0), 0 - 1);
}

function test_decode_overlong(): test.TestOutcome {
  let s: string = string_from_bytes_unchecked([192 as u8, 128 as u8]);
  return test.assert_eq(decode_cp(s, 0), 0 - 1);
}

function test_decode_surrogate(): test.TestOutcome {
  let s: string = string_from_bytes_unchecked([237 as u8, 160 as u8, 128 as u8]);
  return test.assert_eq(decode_cp(s, 0), 0 - 1);
}

function test_encode_lengths(): test.TestOutcome {
  return test.assert_true(
    utf8.encode(65 as char).len() == 1
      && utf8.encode(233 as char).len() == 2
      && utf8.encode(8364 as char).len() == 3
      && utf8.encode(128512 as char).len() == 4,
  );
}

function test_encode_decode_roundtrip(): test.TestOutcome {
  return test.assert_true(
    decode_cp(utf8.encode(8364 as char), 0) == 8364
      && decode_cp(utf8.encode(128512 as char), 0) == 128512,
  );
}

function test_encode_invalid_is_replacement(): test.TestOutcome {
  let neg: i32 = 0 - 1;
  let surrogate: i32 = 55296;
  let too_big: i32 = 1114112;
  return test.assert_true(
    decode_cp(utf8.encode(neg as char), 0) == 65533
      && decode_cp(utf8.encode(surrogate as char), 0) == 65533
      && decode_cp(utf8.encode(too_big as char), 0) == 65533,
  );
}

function test_char_from_i32(): test.TestOutcome {
  let ok_ascii: boolean = match (utf8.char_from_i32(65)) { Some(c) => c as i32 == 65, None => false };
  let ok_max: boolean = match (utf8.char_from_i32(1114111)) { Some(c) => c as i32 == 1114111, None => false };
  let no_big: boolean = match (utf8.char_from_i32(1114112)) { Some(_) => false, None => true };
  let no_lo: boolean = match (utf8.char_from_i32(55296)) { Some(_) => false, None => true };
  let no_hi: boolean = match (utf8.char_from_i32(57343)) { Some(_) => false, None => true };
  let no_neg: boolean = match (utf8.char_from_i32(0 - 1)) { Some(_) => false, None => true };
  return test.assert_true(ok_ascii && ok_max && no_big && no_lo && no_hi && no_neg);
}

function test_codepoint_count(): test.TestOutcome {
  return test.assert_true(mixed().len() == 10 && mixed().codepoint_count() == 4);
}

function test_codepoints_array(): test.TestOutcome {
  let cps: char[] = mixed().chars();
  if (cps.len() != 4) {
    return test.fail("codepoint count");
  }
  return test.assert_true(cps[0] as i32 == 65 && cps[1] as i32 == 233
    && cps[2] as i32 == 8364 && cps[3] as i32 == 128512);
}

function test_is_valid(): test.TestOutcome {
  let bad: string = string_from_bytes_unchecked([65 as u8, 128 as u8]);
  return test.assert_true(utf8.is_valid(mixed()) && !utf8.is_valid(bad));
}

function test_encode_all_roundtrip(): test.TestOutcome {
  return test.assert_eq(utf8.encode_all(mixed().chars()), mixed());
}

function e_acute(): string {
  return string_from_bytes_unchecked([195 as u8, 169 as u8]);
}

function euro(): string {
  return string_from_bytes_unchecked([226 as u8, 130 as u8, 172 as u8]);
}

function emoji(): string {
  return string_from_bytes_unchecked([240 as u8, 159 as u8, 152 as u8, 128 as u8]);
}

function cp_or(s: string, i: i32): i32 {
  match (utf8.codepoint_at(s, i)) {
    Some(c) => {
      return c as i32;
    },
    None => {
      return 0 - 1;
    }
  }
}

function char_or(s: string, i: i32): string {
  match (utf8.char_at(s, i)) {
    Some(c) => {
      return c;
    },
    None => {
      return "<none>";
    }
  }
}

function test_codepoint_at(): test.TestOutcome {
  return test.assert_true(
    cp_or(mixed(), 0) == 65
      && cp_or(mixed(), 3) == 8364
      && cp_or(mixed(), 100) == 0 - 1,
  );
}

function test_char_at(): test.TestOutcome {
  if (char_or(mixed(), 0) != "A") {
    return test.fail("char 0");
  }
  if (char_or(mixed(), 1) != e_acute()) {
    return test.fail("char 1 (é)");
  }
  if (char_or(mixed(), 2) != euro()) {
    return test.fail("char 2 (€)");
  }
  return test.assert_eq(char_or(mixed(), 3), emoji());
}

function test_char_at_bounds(): test.TestOutcome {
  return test.assert_true(char_or(mixed(), 4) == "<none>" && char_or(mixed(), 0 - 1) == "<none>");
}

function test_substring(): test.TestOutcome {
  if (utf8.substring(mixed(), 1, 3) != e_acute() + euro()) {
    return test.fail("[1,3)");
  }
  if (utf8.substring(mixed(), 0, 4) != mixed()) {
    return test.fail("full range");
  }
  if (utf8.substring(mixed(), 2, 100) != euro() + emoji()) {
    return test.fail("clamped end");
  }
  if (utf8.substring(mixed(), 3, 1) != "") {
    return test.fail("end <= start");
  }
  return test.assert_eq(utf8.substring(mixed(), 10, 12).to_owned(), "");
}

function test_is_char_boundary(): test.TestOutcome {
  let s: string = mixed();
  if (!utf8.is_char_boundary(s, 0)) {
    return test.fail("0 is a boundary");
  }
  if (!utf8.is_char_boundary(s, 1)) {
    return test.fail("1 is a boundary");
  }
  if (!utf8.is_char_boundary(s, 3)) {
    return test.fail("3 is a boundary");
  }
  if (!utf8.is_char_boundary(s, 6)) {
    return test.fail("6 is a boundary");
  }
  if (!utf8.is_char_boundary(s, 10)) {
    return test.fail("len is a boundary");
  }
  let i: i32 = 0;
  while (i < 10) {
    let inside: boolean = i == 2 || i >= 4 && i <= 5 || i >= 7 && i <= 9;
    if (inside && utf8.is_char_boundary(s, i)) {
      return test.fail("interior byte reported as a boundary");
    }
    i = i + 1;
  }
  return test.assert_true(true);
}

function test_is_char_boundary_edges(): test.TestOutcome {
  if (utf8.is_char_boundary(mixed(), 0 - 1)) {
    return test.fail("negative");
  }
  if (utf8.is_char_boundary(mixed(), 11)) {
    return test.fail("past the end");
  }
  if (!utf8.is_char_boundary("", 0)) {
    return test.fail("empty string at 0");
  }
  if (utf8.is_char_boundary("", 1)) {
    return test.fail("empty string past the end");
  }
  return test.assert_true(utf8.is_char_boundary("abc", 0) && utf8.is_char_boundary("abc", 1)
    && utf8.is_char_boundary("abc", 2) && utf8.is_char_boundary("abc", 3));
}

function test_floor_char_boundary(): test.TestOutcome {
  let s: string = mixed();
  if (utf8.floor_char_boundary(s, 6) != 6) {
    return test.fail("boundary is its own floor");
  }
  if (utf8.floor_char_boundary(s, 2) != 1) {
    return test.fail("inside é");
  }
  if (utf8.floor_char_boundary(s, 5) != 3) {
    return test.fail("inside €");
  }
  if (utf8.floor_char_boundary(s, 9) != 6) {
    return test.fail("inside 😀");
  }
  if (utf8.floor_char_boundary(s, 0 - 4) != 0) {
    return test.fail("negative clamps to 0");
  }
  return test.assert_eq(utf8.floor_char_boundary(s, 99), 10);
}

function test_ceil_char_boundary(): test.TestOutcome {
  let s: string = mixed();
  if (utf8.ceil_char_boundary(s, 6) != 6) {
    return test.fail("boundary is its own ceil");
  }
  if (utf8.ceil_char_boundary(s, 2) != 3) {
    return test.fail("inside é");
  }
  if (utf8.ceil_char_boundary(s, 4) != 6) {
    return test.fail("inside €");
  }
  if (utf8.ceil_char_boundary(s, 7) != 10) {
    return test.fail("inside 😀");
  }
  if (utf8.ceil_char_boundary(s, 0 - 4) != 0) {
    return test.fail("negative clamps to 0");
  }
  return test.assert_eq(utf8.ceil_char_boundary(s, 99), 10);
}

function test_boundary_snap_is_valid(): test.TestOutcome {
  let s: string = mixed();
  let a: i32 = 0;
  while (a <= 10) {
    let lo: i32 = utf8.floor_char_boundary(s, a);
    let hi: i32 = utf8.ceil_char_boundary(s, a);
    if (!utf8.is_char_boundary(s, lo)) {
      return test.fail("floor is not a boundary");
    }
    if (!utf8.is_char_boundary(s, hi)) {
      return test.fail("ceil is not a boundary");
    }
    if (lo > a) {
      return test.fail("floor grew the index");
    }
    if (hi < a) {
      return test.fail("ceil shrank the index");
    }
    let b: i32 = a;
    while (b <= 10) {
      let cut: str = slice_unchecked(s, utf8.floor_char_boundary(s, a), utf8.ceil_char_boundary(s, b));
      if (!utf8.is_valid(cut.to_owned())) {
        return test.fail("snapped slice is not valid UTF-8");
      }
      b = b + 1;
    }
    a = a + 1;
  }
  return test.assert_true(!utf8.is_valid(slice_unchecked(s, 0, 2).to_owned()));
}

function __lossy_len(b: u8[]): i32 {
  let s: string = string_from_bytes_unchecked(b);
  let a: i32 = s.codepoint_count();
  if (s.chars().len() != a) {
    return 0 - 1;
  }
  if (s.codepoint_count() != a) {
    return 0 - 1;
  }
  if (s.chars().len() != a) {
    return 0 - 1;
  }
  return a;
}

function test_lossy_maximal_subpart(): test.TestOutcome {
  if (__lossy_len([237 as u8, 160 as u8, 128 as u8]) != 3) {
    return test.fail("ED A0 80");
  }
  if (__lossy_len([192 as u8, 128 as u8]) != 2) {
    return test.fail("C0 80");
  }
  if (__lossy_len([224 as u8, 128 as u8, 128 as u8]) != 3) {
    return test.fail("E0 80 80");
  }
  if (__lossy_len([244 as u8, 144 as u8, 128 as u8, 128 as u8]) != 4) {
    return test.fail("F4 90 80 80");
  }
  if (__lossy_len([240 as u8, 159 as u8, 152 as u8]) != 1) {
    return test.fail("F0 9F 98");
  }
  return test.assert_eq(__lossy_len([97 as u8, 241 as u8, 128 as u8, 98 as u8]), 3);
}

function test_lossy_valid_neighbours(): test.TestOutcome {
  if (__lossy_len([240 as u8, 159 as u8, 152 as u8, 128 as u8]) != 1) {
    return test.fail("emoji");
  }
  if (__lossy_len([237 as u8, 159 as u8, 191 as u8]) != 1) {
    return test.fail("U+D7FF");
  }
  if (__lossy_len([244 as u8, 143 as u8, 191 as u8, 191 as u8]) != 1) {
    return test.fail("U+10FFFF");
  }
  return test.assert_eq(__lossy_len([65 as u8, 195 as u8, 169 as u8]), 2);
}

function test_lossy_indexing(): test.TestOutcome {
  let s: string = string_from_bytes_unchecked([97 as u8, 241 as u8, 128 as u8, 98 as u8]);
  let fffd: string = utf8.encode(65533 as char);
  match (utf8.char_at(s, 1)) {
    Some(c) => {
      if (c != fffd) {
        return test.fail("char_at(1) is not U+FFFD");
      }
    },
    None => {
      return test.fail("char_at(1) expected Some");
    }
  }
  match (utf8.char_at(s, 2)) {
    Some(c) => {
      if (c != "b") {
        return test.fail("char_at(2)");
      }
    },
    None => {
      return test.fail("char_at(2) expected Some");
    }
  }
  return test.assert_eq(utf8.substring(s, 2, 3).to_owned(), "b");
}

function test_from_bytes_lossy(): test.TestOutcome {
  let fffd: string = utf8.encode(65533 as char);
  let m: string = mixed();
  if (utf8.from_bytes_lossy(m.bytes()) != m) {
    return test.fail("well-formed input changed");
  }
  if (utf8.from_bytes_lossy([]).len() != 0) {
    return test.fail("empty");
  }
  if (utf8.from_bytes_lossy([226 as u8, 130 as u8, 65 as u8]) != fffd + "A") {
    return test.fail("truncated 3-byte");
  }
  if (utf8.from_bytes_lossy([240 as u8, 128 as u8]) != fffd + fffd) {
    return test.fail("F0 80");
  }
  if (utf8.from_bytes_lossy([65 as u8, 255 as u8, 66 as u8]) != "A" + fffd + "B") {
    return test.fail("one bad byte");
  }
  return test.assert_true(utf8.is_valid(utf8.from_bytes_lossy([237 as u8, 160 as u8, 128 as u8])));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/utf8");
  r = r.it("decode ascii", test_decode_ascii);
  r = r.it("decode 2-byte", test_decode_two_byte);
  r = r.it("decode 3-byte", test_decode_three_byte);
  r = r.it("decode 4-byte", test_decode_four_byte);
  r = r.it("decode at offset", test_decode_at_offset);
  r = r.it("decode stray continuation", test_decode_stray_continuation);
  r = r.it("decode truncated", test_decode_truncated);
  r = r.it("decode overlong", test_decode_overlong);
  r = r.it("decode surrogate", test_decode_surrogate);
  r = r.it("encode lengths", test_encode_lengths);
  r = r.it("encode/decode round trip", test_encode_decode_roundtrip);
  r = r.it("encode invalid -> U+FFFD", test_encode_invalid_is_replacement);
  r = r.it("char_from_i32", test_char_from_i32);
  r = r.it("codepoint count", test_codepoint_count);
  r = r.it("codepoints array", test_codepoints_array);
  r = r.it("is_valid_utf8", test_is_valid);
  r = r.it("encode_all round trip", test_encode_all_roundtrip);
  r = r.it("codepoint_at", test_codepoint_at);
  r = r.it("char_at", test_char_at);
  r = r.it("char_at bounds", test_char_at_bounds);
  r = r.it("substring", test_substring);
  r = r.it("is_char_boundary", test_is_char_boundary);
  r = r.it("is_char_boundary edges", test_is_char_boundary_edges);
  r = r.it("floor_char_boundary", test_floor_char_boundary);
  r = r.it("ceil_char_boundary", test_ceil_char_boundary);
  r = r.it("boundary snap is valid", test_boundary_snap_is_valid);
  r = r.it("lossy maximal subpart", test_lossy_maximal_subpart);
  r = r.it("lossy valid neighbours", test_lossy_valid_neighbours);
  r = r.it("lossy codepoint indexing", test_lossy_indexing);
  r = r.it("from_bytes_lossy", test_from_bytes_lossy);
  return r.finish();
}
