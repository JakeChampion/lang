import "std/f64";
import "std/test";

// Each value is the result of glibc 2.39 for the same call.
function same(cases: (string, f64, f64)[]): test.TestOutcome {
  for c in cases {
    let (name, got, want) = c;
    if (f64_bits(got) != f64_bits(want)) {
      return test.fail(name + ": got " + got.to_string() + ", want " + want.to_string());
    }
  }
  return test.pass();
}

function test_copysign(): test.TestOutcome {
  let negative_zero = -1.0 / (1.0 / 0.0);
  return same([
    ("copysign(3, -0)", 3.0.copysign(negative_zero), -3.0),
    ("copysign(0, -1)", 0.0.copysign(-1.0), negative_zero),
    ("copysign(-2, 0)", (-2.0).copysign(0.0), 2.0),
    ("f32 copysign(3, -0)", (3.0 as f32).copysign(negative_zero as f32) as f64, -3.0),
  ]);
}

function test_exact(): test.TestOutcome {
  let (f, e) = 5.5.frexp();
  let (sf, se) = 1e-310.frexp();
  let (mf, mw) = (-3.25).modf();
  return same([
    ("frexp(5.5)", f + e as f64, 0.6875 + 3.0),
    ("frexp(1e-310)", sf + se as f64, 0.5752618031559393 - 1029.0),
    ("modf(-3.25)", mf + mw * 10.0, -0.25 - 30.0),
    ("scalbn(3, 2)", 3.0.scalbn(2), 12.0),
    ("scalbn(1, -1074)", 1.0.scalbn(-1074), 5e-324),
    ("logb(0.3)", 0.3.logb(), -2.0),
    ("significand(1024)", 1024.0.significand(), 1.0),
    ("rint(2.5)", 2.5.rint(), 2.0),
    ("rint(3.5)", 3.5.rint(), 4.0),
    ("fmod(-10, 3)", (-10.0).fmod(3.0), -1.0),
    ("fmod(5.5, 1.25)", 5.5.fmod(1.25), 0.5),
    ("remainder(10, 3)", 10.0.remainder(3.0), 1.0),
    ("remainder(5.5, 1.25)", 5.5.remainder(1.25), 0.5),
    ("nextafter(1, 2)", 1.0.nextafter(2.0), 1.0000000000000002),
    ("fdim(1, 3)", 1.0.fdim(3.0), 0.0),
    ("fmax(1, nan)", 1.0.fmax(0.0 / 0.0), 1.0),
  ]);
}

// Each fma rounds one time: a factor above 1e300, a product that overflows,
// a product that underflows to a signed zero, and a tie in the subnormal range.
function test_fma(): test.TestOutcome {
  let negative_zero = -1.0 / (1.0 / 0.0);
  return same([
    ("fma(0.1, 10, -1)", 0.1.fma(10.0, -1.0), 5.551115123125783e-17),
    ("fma(2e301, 1e-298, -2260)", 1.9876973655947357e301.fma(1.1371440900119022e-298, -2260.298312018281), -1.0000533561184335e-13),
    ("fma(1.5e308, 2, -1.5e308)", 1.5e308.fma(2.0, -1.5e308), 1.5e308),
    ("fma(-1e-200, 1e-200, 0)", (-1.0e-200).fma(1.0e-200, 0.0), negative_zero),
    ("fma(1 + 2^-52, 2^-1023, 2^-1074)", 1.0000000000000002.fma(1.1125369292536007e-308, 5e-324), 1.1125369292536017e-308),
  ]);
}

function test_special(): test.TestOutcome {
  let (lg, sign) = (-1.5).lgamma_r();
  return same([
    ("erf(1)", 1.0.erf(), 0.8427007929497149),
    ("erfc(0.5)", 0.5.erfc(), 0.4795001221869535),
    ("lgamma(0.5)", 0.5.lgamma(), 0.5723649429247001),
    ("lgamma_r(-1.5)", lg + sign as f64, 0.8600470153764809 + 1.0),
    ("tgamma(5.5)", 5.5.tgamma(), 52.34277778455352),
    ("tgamma(-0.5)", (-0.5).tgamma(), -3.5449077018110318),
    ("j0(1)", 1.0.j0(), 0.7651976865579666),
    ("j1(2)", 2.0.j1(), 0.5767248077568733),
    ("y1(3)", 3.0.y1(), 0.3246744247917999),
    ("yn(2, 3)", 3.0.yn(2), -0.1604003934849238),
    ("acosh(2)", 2.0.acosh(), 1.3169578969248166),
    ("asinh(1)", 1.0.asinh(), 0.881373587019543),
    ("atanh(0.5)", 0.5.atanh(), 0.5493061443340548),
  ]);
}

function main(): i32 {
  let r = test.new("f64 special functions");
  r = r.it("copysign takes the sign bit", test_copysign);
  r = r.it("the exact functions", test_exact);
  r = r.it("fma rounds one time", test_fma);
  r = r.it("the special functions", test_special);
  return r.finish();
}
