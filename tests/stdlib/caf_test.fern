import "std/test";
import "caf_case_check";

function references(): test.TestOutcome {
  return caf_case_check.run(0);
}

function main(): i32 {
  let runner = test.new("CAF ALAC independent PCM and seek shard 1 of 4");
  runner = runner.it("all layouts, packet tables, partial frames, trim, and repeated seeks", references);
  return runner.finish();
}
