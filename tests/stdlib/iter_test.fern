import "std/test";
import "core/iter" as iter;

function test_sum_range(): test.TestOutcome {
  return test.assert_eq(iter.sum(iter.range(0, 5)), 10);
}

function test_len_range(): test.TestOutcome {
  return test.assert_eq(iter.range(2, 9).len(), 7);
}

function test_range_collect(): test.TestOutcome {
  return test.assert_eq_array(iter.range(2, 5).collect(), [2, 3, 4]);
}

function test_range_empty(): test.TestOutcome {
  return test.assert_eq(iter.range(5, 2).len(), 0);
}

function test_step_by(): test.TestOutcome {
  return test.assert_eq_array(iter.range(0, 10).step_by(3).collect(), [0, 3, 6, 9]);
}

function test_step_by_exact(): test.TestOutcome {
  return test.assert_eq_array(iter.range(0, 9).step_by(3).collect(), [0, 3, 6]);
}

function test_step_by_nonpositive(): test.TestOutcome {
  return test.assert_eq(iter.range(0, 10).step_by(0).len(), 0);
}

function test_of_sum(): test.TestOutcome {
  let xs: i32[] = [3, 1, 4, 1, 5];
  return test.assert_eq(iter.sum(iter.of(xs)), 14);
}

function test_product(): test.TestOutcome {
  return test.assert_eq(iter.product(iter.range(1, 5)), 24);
}

function test_nth(): test.TestOutcome {
  match (iter.nth(iter.range(0, 9), 4)) {
    Some(v) => {
      return test.assert_eq(v, 4);
    },
    None => {
      return test.fail("nth(0..9, 4) expected Some");
    }
  }
}

function test_last(): test.TestOutcome {
  match (iter.last(iter.range(0, 5))) {
    Some(v) => {
      return test.assert_eq(v, 4);
    },
    None => {
      return test.fail("last(0..5) expected Some");
    }
  }
}

function test_min(): test.TestOutcome {
  let xs: i32[] = [5, 2, 8, 1];
  match (iter.min(iter.of(xs))) {
    Some(v) => {
      return test.assert_eq(v, 1);
    },
    None => {
      return test.fail("min expected Some");
    }
  }
}

function test_max(): test.TestOutcome {
  let xs: i32[] = [5, 2, 8, 1];
  match (iter.max(iter.of(xs))) {
    Some(v) => {
      return test.assert_eq(v, 8);
    },
    None => {
      return test.fail("max expected Some");
    }
  }
}

function test_contains(): test.TestOutcome {
  return test.assert_true(iter.contains(iter.range(0, 5), 3));
}

function test_count(): test.TestOutcome {
  let xs: i32[] = [1, 2, 2, 3, 2];
  return test.assert_eq(iter.count(iter.of(xs), 2), 3);
}

function test_fold(): test.TestOutcome {
  let s = iter.range(1, 5).fold(0, (a: i32, x: i32): i32 => a + x);
  return test.assert_eq(s, 10);
}

function test_any(): test.TestOutcome {
  return test.assert_true(iter.range(0, 5).any((x: i32): boolean => x == 3));
}

function test_all(): test.TestOutcome {
  return test.assert_true(iter.range(0, 5).all((x: i32): boolean => x < 10));
}

function test_any_miss(): test.TestOutcome {
  return test.assert_false(iter.range(0, 5).any((x: i32): boolean => x > 99));
}

function test_map_filter(): test.TestOutcome {
  let xs: i32[] = [1, 2, 3, 4, 5, 6];
  let evens = iter.of(xs).filter((x: i32): boolean => x % 2 == 0).collect();
  let doubled = iter.of(evens).map((x: i32): i32 => x * 2).collect();
  return test.assert_eq(iter.sum(iter.of(doubled)), 24);
}

function main(): i32 {
  let r: test.TestRunner = test.new("core/iter");
  r = r.it("sum over a range", test_sum_range);
  r = r.it("len over a range", test_len_range);
  r = r.it("range collect", test_range_collect);
  r = r.it("range empty", test_range_empty);
  r = r.it("step_by", test_step_by);
  r = r.it("step_by exact end", test_step_by_exact);
  r = r.it("step_by nonpositive", test_step_by_nonpositive);
  r = r.it("of: array to iterator", test_of_sum);
  r = r.it("product", test_product);
  r = r.it("nth", test_nth);
  r = r.it("last", test_last);
  r = r.it("min", test_min);
  r = r.it("max", test_max);
  r = r.it("contains", test_contains);
  r = r.it("count", test_count);
  r = r.it("fold", test_fold);
  r = r.it("any hit", test_any);
  r = r.it("all true", test_all);
  r = r.it("any miss", test_any_miss);
  r = r.it("map + filter pipeline", test_map_filter);
  return r.finish();
}
