import "std/hash/crc32";
import "std/opus/celt_encoder";
import "std/test";

// Each case runs one analysis function of the encoder on random values: the
// transient analysis of a noise block with or without a burst, the
// pre-emphasis of random samples, or the transient patch of random energies.
// libopus 1.4, in its float build, gave the CRC-32 of each trace, from a C
// program that makes the same calls.

struct Gen { x: u32 }

function rnd(own g: Gen): (Gen, i32) {
  let x: u32 = g.x * 1664525u32 + 1013904223u32;
  return (Gen { x: x }, (x >> 8u32) as i32);
}

function frand(own g: Gen, lo: f32, hi: f32): (Gen, f32) {
  let (g1, r) = rnd(g);
  return (g1, lo + (hi - lo) * ((r % 65536) as f32) / 65536.0f32);
}

struct Fill { g: Gen, xs: f32[] }

function fill(own g: Gen, n: i32, lo: f32, hi: f32): Fill {
  let xs: f32[] = [];
  for i in 0..n {
    let (g1, v) = frand(g, lo, hi);
    g = g1;
    xs = xs.append(v);
  }
  return Fill { g: g, xs: xs };
}

function hash(xs: [f32]): u32 {
  let h: u32 = 0u32;
  for x in xs {
    h = h * 31u32 + f32_bits(x) as u32;
  }
  return h;
}

function flag(b: boolean): string {
  if (b) {
    return "1";
  }
  return "0";
}

function transient_case(own g: Gen): (Gen, string) {
  let (g1, lm0) = rnd(g);
  let lm: i32 = lm0 % 4;
  let n: i32 = (120 << lm) + 120;
  let (g2, c0) = rnd(g1);
  let c: i32 = 1 + c0 % 2;
  let (g3, w0) = rnd(g2);
  let weak: boolean = w0 % 2 == 1;
  let (g4, amp) = frand(g3, 0.5f32, 30000.0f32);
  let f: Fill = fill(g4, c * n, 0.0f32 - amp, amp);
  let g5: Gen = f.g;
  let xs: f32[] = f.xs;
  let (g6, burst) = rnd(g5);
  g5 = g6;
  if (burst % 2 == 1) {
    let (g7, at0) = rnd(g5);
    let (g8, w1) = rnd(g7);
    let (g9, gain) = frand(g8, 2.0f32, 80.0f32);
    g5 = g9;
    let at: i32 = at0 % (c * n);
    let i: i32 = at;
    while (i < at + 1 + w1 % 40 && i < c * n) {
      xs = xs.with(i, xs[i] * gain);
      i = i + 1;
    }
  }
  let t: celt_encoder.Transient = celt_encoder.transient_analysis(xs, n, c, weak);
  return (g5, "t " + lm.to_string() + " " + c.to_string() + " " + flag(weak) + " " + flag(t.transient) + " " + flag(t.weak) + " " + (f32_bits(t.tf_estimate) as u32).to_string() + " " + t.tf_chan.to_string());
}

function preemphasis_case(own g: Gen): (Gen, string) {
  let (g1, cc0) = rnd(g);
  let cc: i32 = 1 + cc0 % 2;
  let (g2, up0) = rnd(g1);
  let up: i32 = 1 + up0 % 3;
  let (g3, n0) = rnd(g2);
  let n: i32 = 120 * up * (1 + n0 % 8);
  let (g4, clip0) = rnd(g3);
  let (g5, c0) = rnd(g4);
  let c: i32 = c0 % cc;
  let (g6, mem) = frand(g5, -30000.0f32, 30000.0f32);
  let f: Fill = fill(g6, cc * n, -2.5f32, 2.5f32);
  let p: celt_encoder.Preemphasis = celt_encoder.preemphasis(f.xs, c, n, cc, up, mem, clip0 % 2 == 1);
  return (f.g, "p " + cc.to_string() + " " + up.to_string() + " " + n.to_string() + " " + (clip0 % 2).to_string() + " " + c.to_string() + " " + hash(p.samples).to_string() + " " + (f32_bits(p.mem) as u32).to_string());
}

function patch_case(own g: Gen): (Gen, string) {
  let (g1, c0) = rnd(g);
  let c: i32 = 1 + c0 % 2;
  let (g2, s0) = rnd(g1);
  let start: i32 = s0 % 5;
  let (g3, e0) = rnd(g2);
  let end: i32 = 13 + e0 % 9;
  let old_e: f32[] = [];
  let new_e: f32[] = [];
  let g4: Gen = g3;
  for i in 0..42 {
    let (g5, o) = frand(g4, -12.0f32, 18.0f32);
    let (g6, v) = frand(g5, -12.0f32, 18.0f32);
    g4 = g6;
    old_e = old_e.append(o);
    new_e = new_e.append(v);
  }
  let patched: boolean = celt_encoder.patch_transient_decision(new_e, old_e, 21, start, end, c);
  return (g4, "x " + c.to_string() + " " + start.to_string() + " " + end.to_string() + " " + flag(patched));
}

function trace(seed: u32, cases: i32): u32 {
  let g: Gen = Gen { x: seed };
  let c: crc32.Crc32 = crc32.new();
  for k in 0..cases {
    let (g1, what) = rnd(g);
    let line: string = "";
    if (what % 3 == 0) {
      let (g2, s) = transient_case(g1);
      g = g2;
      line = s;
    } else if (what % 3 == 1) {
      let (g2, s) = preemphasis_case(g1);
      g = g2;
      line = s;
    } else {
      let (g2, s) = patch_case(g1);
      g = g2;
      line = s;
    }
    c = c.update((line + "\n").as_bytes());
  }
  return c.finish();
}

function test_short_analysis_trace(): test.TestOutcome {
  return test.assert_eq(trace(3u32, 12), 4047543119u32);
}

function test_long_analysis_trace(): test.TestOutcome {
  return test.assert_eq(trace(17u32, 3000), 912817163u32);
}

function main(): i32 {
  let r: test.TestRunner = test.new("std/opus/celt_encoder");
  r = r.it("a short analysis trace is the libopus trace", test_short_analysis_trace);
  r = r.it("a long analysis trace is the libopus trace", test_long_analysis_trace);
  return r.finish();
}
