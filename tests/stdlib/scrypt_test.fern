import "std/test";
import "std/hex";
import "std/crypto/scrypt";

function shown(r: Result[u8[], scrypt.ScryptError]): string {
  match (r) {
    Ok(b) => {
      return hex.encode(b);
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_rfc_vector_1(): test.TestOutcome {
  return test.assert_eq(
    shown(scrypt.key([], [], 16, 1, 1, 64)),
    "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906",
  );
}

// Python's hashlib.scrypt (OpenSSL) gives these two keys.
function test_one_block(): test.TestOutcome {
  return test.assert_eq(shown(scrypt.key("password".as_bytes(), "salt".as_bytes(), 1024, 1, 1, 32)), "ef5fbdcf3c25403ea9e7e547b28111746cc933792561fa27f569503c3b3e842e");
}

function test_parallel_short_key(): test.TestOutcome {
  return test.assert_eq(shown(scrypt.key("password".as_bytes(), "salt".as_bytes(), 2, 1, 3, 40)), "b3c63a5c8b79ad9719772c8c82c958fc70085ebe985e295afd0a3aaead9b1ba7922d37f64046ecbc");
}

function test_empty_key(): test.TestOutcome {
  return test.assert_eq(shown(scrypt.key("password".as_bytes(), "salt".as_bytes(), 16, 1, 1, 0)), "");
}

function test_refusals(): test.TestOutcome {
  let cost = "scrypt: the cost N is 3, want a power of 2 that is more than 1";
  if (shown(scrypt.key([], [], 3, 1, 1, 32)) != cost) {
    return test.fail("N = 3");
  }
  if (shown(scrypt.key([], [], 1, 1, 1, 32)) != "scrypt: the cost N is 1, want a power of 2 that is more than 1") {
    return test.fail("N = 1");
  }
  if (shown(scrypt.key([], [], 0, 1, 1, 32)) != "scrypt: the cost N is 0, want a power of 2 that is more than 1") {
    return test.fail("N = 0");
  }
  if (shown(scrypt.key([], [], 16, 0, 1, 32)) != "scrypt: the block size r is 0, want 1 or more") {
    return test.fail("r = 0");
  }
  if (shown(scrypt.key([], [], 16, 1, -1, 32)) != "scrypt: the parallelization p is -1, want 1 or more") {
    return test.fail("p = -1");
  }
  if (shown(scrypt.key([], [], 1073741824, 8, 1, 32)) != "scrypt: the parameters need more than 2^31 - 1 slots of memory") {
    return test.fail("N = 2^30, r = 8");
  }
  return test.assert_eq(shown(scrypt.key([], [], 16, 1073741824, 1, 32)), "scrypt: the parameters need more than 2^31 - 1 slots of memory");
}

function main(): i32 {
  let r = test.new("std/crypto/scrypt");
  r = r.it("RFC 7914 12 vector 1", test_rfc_vector_1);
  r = r.it("N = 1024, r = 1, p = 1", test_one_block);
  r = r.it("p = 3 and a 40-byte key", test_parallel_short_key);
  r = r.it("an empty key", test_empty_key);
  r = r.it("parameter refusals", test_refusals);
  return r.finish();
}
