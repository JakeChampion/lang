import "std/video/mp4";
import "std/video/mp4/timing";
import "std/video/frame";
import "std/audio/mp4/boxes";
import "std/audio/pcm";
import "std/test";

function word(bytes: u8[], at: i32, value: u32): u8[] {
  for i in 0..4 {
    bytes = bytes.with(at + i, (value >> ((3 - i) * 8) as u32) as u8);
  }
  return bytes;
}

function table(counts: [u32], values: [u32], version: u32): u8[] {
  let bytes: u8[] = [];
  for _ in 0..16 + 8 * counts.len() {
    bytes = bytes.append(0u8);
  }
  bytes = word(word(word(word(bytes, 0, bytes.len() as u32), 4, boxes.tag("ctts")), 8, version << 24u32), 12, counts.len() as u32);
  for i in 0..counts.len() {
    bytes = word(word(bytes, 16 + 8 * i, counts[i]), 20 + 8 * i, values[i]);
  }
  return bytes;
}

function replace(input: u8[], old: boxes.Box, parents: [boxes.Box], replacement: [u8]): u8[] {
  let bytes: u8[] = [];
  for value in input[:old.start] {
    bytes = bytes.append(value);
  }
  for value in replacement {
    bytes = bytes.append(value);
  }
  for value in input[old.end:] {
    bytes = bytes.append(value);
  }
  let delta = replacement.len() - (old.end - old.start);
  for parent in parents {
    bytes = word(bytes, parent.start, (parent.end - parent.start + delta) as u32);
  }
  return bytes;
}

function expected(counts: [u32], values: [u32], version: u32, sample: i32): i64 {
  let covered = 0;
  for i in 0..counts.len() {
    covered += counts[i] as i32;
    if (sample < covered) {
      return if (version == 0u32) { values[i] as i64 } else { (values[i] as i32) as i64 };
    }
  }
  return -999i64;
}

function unchanged(actual: mp4.Packet, original: mp4.Packet): boolean {
  return actual.offset == original.offset && actual.bytes == original.bytes && actual.description == original.description && actual.decode_time == original.decode_time && actual.duration == original.duration && actual.sync == original.sync;
}

function compare(input: u8[], old: boxes.Box, parents: [boxes.Box], original: mp4.Track, counts: u32[], values: u32[], version: u32): boolean {
  let replacement = table(counts, values, version);
  let bytes = replace(input, old, parents, replacement);
  let Ok(index) = mp4.inspect(bytes, mp4.default_limits()) else {
    return false;
  };
  let Ok(box) = boxes.read(replacement, 0, replacement.len()) else {
    return false;
  };
  let Ok(offsets) = timing.composition(replacement, [box], 6) else {
    return false;
  };
  if (index.tracks[0].packets.len() != 6 || offsets.len() != 6) {
    return false;
  }
  for i in 0..6 {
    let want = expected(counts, values, version, i);
    let actual = index.tracks[0].packets[i];
    if (offsets[i] != want || actual.presentation_time != actual.decode_time + want || !unchanged(actual, original.packets[i])) {
      return false;
    }
  }
  return true;
}

pub function patterns(input: u8[], old: boxes.Box, parents: [boxes.Box]): test.TestOutcome {
  let Ok(original) = mp4.inspect(input, mp4.default_limits()) else {
    return test.fail("original index");
  };
  let raw = [0u32, 4294967295u32, 2147483648u32, 2147483647u32, 1u32, 17u32];
  for version in [0u32, 1u32] {
    for mask in 0..32 {
      let counts: u32[] = [];
      let values: u32[] = [];
      let run = 0u32;
      for i in 0..6 {
        run += 1u32;
        if (i == 5 || (mask & 1 << i) != 0) {
          counts = counts.append(run);
          values = values.append(raw[values.len()]);
          run = 0u32;
        }
      }
      if (!compare(input, old, parents, original.tracks[0], counts, values, version)) {
        return test.fail("composition runs " + mask.to_string() + " version " + version.to_string());
      }
    }
  }
  return test.pass();
}

function rejected(input: u8[], old: boxes.Box, parents: [boxes.Box], counts: u32[]): boolean {
  let values: u32[] = [];
  for _ in counts {
    values = values.append(0u32);
  }
  let replacement = table(counts, values, 0u32);
  if let Err(frame.Header) = mp4.inspect(replace(input, old, parents, replacement), mp4.default_limits()) {} else {
    return false;
  }
  let Ok(box) = boxes.read(replacement, 0, replacement.len()) else {
    return false;
  };
  if let Err(pcm.Header) = timing.composition(replacement, [box], 6) {} else {
    return false;
  }
  return true;
}

pub function errors(input: u8[], old: boxes.Box, parents: [boxes.Box]): test.TestOutcome {
  for counts in [[0u32], [5u32], [7u32], [5u32, 0u32], [5u32, 2u32], [5u32, 4294967295u32], [2u32, 2u32, 1u32], [0u32, 2u32, 1u32, 1u32, 1u32, 1u32], [1u32, 1u32, 1u32, 1u32, 1u32, 0u32], [1u32, 1u32, 1u32, 1u32, 1u32, 2u32], [1u32, 1u32, 1u32, 1u32, 1u32, 4294967295u32]] {
    if (!rejected(input, old, parents, counts)) {
      return test.fail("late composition run validation");
    }
  }
  let empty = table([], [], 0u32);
  let Ok(box) = boxes.read(empty, 0, empty.len()) else {
    return test.fail("empty box");
  };
  let Ok(zero) = timing.composition(empty, [box], 0) else {
    return test.fail("empty table and zero samples");
  };
  if (zero.len() != 0) {
    return test.fail("zero public array");
  }
  if let Err(pcm.Header) = timing.composition(empty, [box], 1) {} else {
    return test.fail("empty table cannot cover samples");
  }
  if let Err(pcm.Header) = timing.composition(empty, [box, box], 0) {} else {
    return test.fail("duplicate composition tables");
  }
  return test.pass();
}
