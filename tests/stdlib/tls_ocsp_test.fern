import "std/test";
import "std/codec";
import "std/hex";
import "std/time";
import "std/tls/ocsp";
import "std/tls/x509";

// The certificates and responses come from OpenSSL 3.0: an Ed25519 root, a
// leaf with the serial 0x1001, and responses that `openssl ocsp` signed. Each
// response has thisUpdate 2026-11-25T09:28:18Z and nextUpdate seven days later.
const CA: string = "";

const OTHER_CA: string = "";

const LEAF: string = "";

const LEAF_OTHER: string = "";

const GOOD: string = "";

const GOOD_SHA256: string = "";

const REVOKED: string = "";

const UNKNOWN: string = "";

const DELEGATED: string = "";

const DELEGATED_BY_KEY: string = "";

const DELEGATED_NO_EKU: string = "";

const OTHER_SIGNER: string = "";

// 2026-11-26T00:00:00Z, inside the validity window of each response.
const NOW: i64 = 1795651200;

// The offset of the first signature byte in GOOD.
const GOOD_SIGNATURE_AT: i32 = 201;

// The offset of the last byte of the CertID serial in GOOD.
const GOOD_SERIAL_AT: i32 = 152;

function h(s: string): u8[] {
  return __codec_bytes(hex.decode(s));
}

function cert(s: string): x509.Certificate {
  match (x509.parse(h(s))) {
    Ok(c) => {
      return c;
    },
    Err(e) => {
      eprint(e.message());
      exit(97);
    }
  }
  return cert(s);
}

function checked(resp: [u8], leaf: string, issuer: string, now: i64): string {
  match (ocsp.status(resp, cert(leaf), cert(issuer), time.timestamp_from_unix_millis(now * 1000))) {
    Ok(ocsp.Good) => {
      return "good";
    },
    Ok(ocsp.Revoked(at)) => {
      return "revoked " + at.to_string();
    },
    Ok(ocsp.Unknown) => {
      return "unknown";
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_good(): test.TestOutcome {
  let got = checked(h(GOOD), LEAF, CA, NOW);
  if (got != "good") {
    return test.fail("SHA-1 CertID: " + got);
  }
  got = checked(h(GOOD_SHA256), LEAF, CA, NOW);
  if (got != "good") {
    return test.fail("SHA-256 CertID: " + got);
  }
  return test.pass();
}

function test_revoked_and_unknown(): test.TestOutcome {
  // 2026-11-01T00:00:00Z.
  let got = checked(h(REVOKED), LEAF, CA, NOW);
  if (got != "revoked 1793491200") {
    return test.fail("revoked: " + got);
  }
  got = checked(h(UNKNOWN), LEAF, CA, NOW);
  if (got != "unknown") {
    return test.fail("unknown: " + got);
  }
  return test.pass();
}

function test_validity_window(): test.TestOutcome {
  // 2026-12-03T00:00:00Z is after nextUpdate.
  let got = checked(h(GOOD), LEAF, CA, 1796256000);
  if (got != "ocsp: the response expired at 1796203698") {
    return test.fail("expired: " + got);
  }
  // 2026-11-25T00:00:00Z is before thisUpdate.
  got = checked(h(GOOD), LEAF, CA, 1795564800);
  if (got != "ocsp: the response is not valid before 1795598898") {
    return test.fail("not yet valid: " + got);
  }
  return test.pass();
}

function test_delegated_responder(): test.TestOutcome {
  let got = checked(h(DELEGATED), LEAF, CA, NOW);
  if (got != "good") {
    return test.fail("by name: " + got);
  }
  got = checked(h(DELEGATED_BY_KEY), LEAF, CA, NOW);
  if (got != "good") {
    return test.fail("by key: " + got);
  }
  got = checked(h(DELEGATED_NO_EKU), LEAF, CA, NOW);
  if (got != "ocsp: the responder is not the issuer or a responder that the issuer delegated") {
    return test.fail("no OCSPSigning: " + got);
  }
  return test.pass();
}

function test_wrong_issuer(): test.TestOutcome {
  // The other root signs a response about the leaf of the test root.
  let got = checked(h(OTHER_SIGNER), LEAF, CA, NOW);
  if (got != "ocsp: the responder is not the issuer or a responder that the issuer delegated") {
    return test.fail("other signer: " + got);
  }
  // The response is about a leaf of the test root, and this leaf has the same serial under the other root.
  got = checked(h(GOOD), LEAF_OTHER, OTHER_CA, NOW);
  if (got != "ocsp: the responder is not the issuer or a responder that the issuer delegated") {
    return test.fail("other leaf: " + got);
  }
  got = checked(h(GOOD), LEAF, OTHER_CA, NOW);
  if (got != "ocsp: the responder is not the issuer or a responder that the issuer delegated") {
    return test.fail("other issuer: " + got);
  }
  return test.pass();
}

function test_bad_signature(): test.TestOutcome {
  let resp = h(GOOD);
  resp = resp.with(GOOD_SIGNATURE_AT, resp[GOOD_SIGNATURE_AT] ^ 1 as u8);
  let got = checked(resp, LEAF, CA, NOW);
  if (got != "ocsp: the signature of the response does not verify") {
    return test.fail("flipped signature bit: " + got);
  }
  // A changed byte in the signed data: the last byte of the serial in the CertID.
  let tbs = h(GOOD);
  tbs = tbs.with(GOOD_SERIAL_AT, 2 as u8);
  got = checked(tbs, LEAF, CA, NOW);
  if (got != "ocsp: the signature of the response does not verify") {
    return test.fail("changed serial: " + got);
  }
  return test.pass();
}

function test_parse(): test.TestOutcome {
  match (ocsp.parse(h(GOOD))) {
    Ok(r) => {
      if (r.responses.len() != 1 || r.produced_at != 1795598898 as i64 || r.responder_name.len() == 0 || r.certs.len() != 1) {
        return test.fail("fields");
      }
      if (hex.encode(r.responses[0].serial) != "1001" || r.responses[0].next_update != 1796203698 as i64) {
        return test.fail("single response");
      }
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  match (ocsp.parse(h("30030a0102"))) {
    Err(ocsp.NotSuccessful(code)) => {
      if (code != 2) {
        return test.fail("status " + code.to_string());
      }
    },
    _ => {
      return test.fail("internalError was accepted");
    }
  }
  let truncated = h(GOOD).take(100);
  if (checked(truncated, LEAF, CA, NOW) == "good") {
    return test.fail("a truncated response was accepted");
  }
  return test.pass();
}

function main(): i32 {
  let r = test.new("std/tls/ocsp");
  r = r.it("a good status, with a SHA-1 and a SHA-256 CertID", test_good);
  r = r.it("revoked and unknown statuses", test_revoked_and_unknown);
  r = r.it("the validity window of a response", test_validity_window);
  r = r.it("a delegated responder", test_delegated_responder);
  r = r.it("a responder or a leaf of another issuer", test_wrong_issuer);
  r = r.it("a bad signature", test_bad_signature);
  r = r.it("parse", test_parse);
  return r.finish();
}

function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
