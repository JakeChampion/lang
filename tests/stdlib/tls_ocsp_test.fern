import "std/test";
import "std/hex";
import "std/codec";
import "std/tls/der";
import "std/tls/ocsp";
import "std/tls/verify";
import "std/tls/x509";
import "std/time";

// Recorded with OpenSSL 3.0 `ocsp -index`: a P-256 root, an Ed25519 leaf, a
// delegated P-256 responder, and the responder of another root. Each
// response has a thisUpdate of 2026-11-25T09:30Z and a nextUpdate seven days later.
const ROOT_CERT: string = "";

const LEAF_CERT: string = "";

const REVOKED_CERT: string = "";

const UNKNOWN_CERT: string = "";

const GOOD_ROOT: string = "";

const GOOD_DELEGATED: string = "";

const REVOKED: string = "";

const UNKNOWN: string = "";

const WRONG_ISSUER: string = "";

const NO_EKU: string = "";

const BAD_SIGNATURE: string = "";

// 2026-11-26T00:00Z, inside the window of each response.
const NOW: i64 = 1795651200;

const REVOKED_AT: i64 = 1795132800;

function bytes_of(h: string): u8[] {
  match (hex.decode(h)) {
    Ok(b) => {
      return b;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}

function cert(h: string): x509.Certificate {
  match (x509.parse(bytes_of(h))) {
    Ok(c) => {
      return c;
    },
    Err(e) => {
      eprint(e.message());
      exit(98);
    }
  }
  return cert(h);
}

function at(sec: i64): time.Timestamp {
  return time.timestamp_from_unix_millis(sec * 1000);
}

function status_at(response: string, leaf: string, sec: i64): string {
  return status_of(bytes_of(response), leaf, sec);
}

function status_of(response: u8[], leaf: string, sec: i64): string {
  match (ocsp.check(response, cert(leaf), cert(ROOT_CERT), at(sec))) {
    Ok(s) => {
      match (s) {
        ocsp.Good => {
          return "good";
        },
        ocsp.Revoked(t) => {
          return "revoked " + t.to_string();
        },
        ocsp.Unknown => {
          return "unknown";
        }
      }
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function status(response: string, leaf: string): string {
  return status_at(response, leaf, NOW);
}

function test_good_from_the_issuer(): test.TestOutcome {
  return test.assert_eq(status(GOOD_ROOT, LEAF_CERT), "good");
}

function test_good_from_a_delegated_responder(): test.TestOutcome {
  return test.assert_eq(status(GOOD_DELEGATED, LEAF_CERT), "good");
}

function test_revoked(): test.TestOutcome {
  return test.assert_eq(status(REVOKED, REVOKED_CERT), "revoked " + REVOKED_AT.to_string());
}

function test_unknown(): test.TestOutcome {
  return test.assert_eq(status(UNKNOWN, UNKNOWN_CERT), "unknown");
}

function test_require_good(): test.TestOutcome {
  let got = "";
  for pair in [(GOOD_ROOT, LEAF_CERT), (REVOKED, REVOKED_CERT), (UNKNOWN, UNKNOWN_CERT)] {
    let (response, leaf) = pair;
    match (ocsp.require_good(bytes_of(response), cert(leaf), cert(ROOT_CERT), at(NOW))) {
      Ok(_) => {
        got = got + "ok;";
      },
      Err(e) => {
        got = got + e.message() + ";";
      }
    }
  }
  return test.assert_eq(got, "ok;" + ocsp.CertificateRevoked(REVOKED_AT).message() + ";" + ocsp.StatusUnknown.message() + ";");
}

function test_out_of_date(): test.TestOutcome {
  return test.assert_eq(status_at(GOOD_ROOT, LEAF_CERT, 1796860800), ocsp.Expired.message());
}

function test_not_yet_valid(): test.TestOutcome {
  return test.assert_eq(status_at(GOOD_ROOT, LEAF_CERT, 1795564800), ocsp.NotYetValid.message());
}

function test_responder_of_another_issuer(): test.TestOutcome {
  return test.assert_eq(status(WRONG_ISSUER, LEAF_CERT), ocsp.UnauthorizedResponder.message());
}

function test_responder_without_ocsp_signing(): test.TestOutcome {
  return test.assert_eq(status(NO_EKU, LEAF_CERT), ocsp.UnauthorizedResponder.message());
}

function test_bad_signature(): test.TestOutcome {
  return test.assert_eq(status(BAD_SIGNATURE, LEAF_CERT), ocsp.BadSignature.message());
}

function test_response_for_another_certificate(): test.TestOutcome {
  return test.assert_eq(status(GOOD_ROOT, REVOKED_CERT), ocsp.NoResponse.message());
}

function test_unsuccessful_and_malformed(): test.TestOutcome {
  let got = status("30030a0101", LEAF_CERT) + ";" + status_of(bytes_of(GOOD_ROOT).take(100), LEAF_CERT, NOW);
  return test.assert_eq(got, ocsp.NotSuccessful(1).message() + ";" + ocsp.Der(der.Truncated).message());
}

function test_issuer_of(): test.TestOutcome {
  let leaf = cert(LEAF_CERT);
  let found = "none";
  if let Some(c) = ocsp.issuer_of(leaf, [bytes_of(LEAF_CERT)], verify.roots([bytes_of(ROOT_CERT)])) {
    found = c.subject.common_name;
  }
  let in_chain = "none";
  if let Some(c) = ocsp.issuer_of(leaf, [bytes_of(LEAF_CERT), bytes_of(ROOT_CERT)], verify.no_roots()) {
    in_chain = c.subject.common_name;
  }
  let missing = ocsp.issuer_of(leaf, [bytes_of(LEAF_CERT)], verify.no_roots()).is_none();
  return test.assert_eq(found + ";" + in_chain + ";" + missing.to_string(), "Fern OCSP Test Root;Fern OCSP Test Root;true");
}

function main(): i32 {
  let r = test.new("std/tls/ocsp");
  r = r.it("a good status that the issuer signed", test_good_from_the_issuer);
  r = r.it("a good status that a delegated responder signed", test_good_from_a_delegated_responder);
  r = r.it("a revoked status", test_revoked);
  r = r.it("an unknown status", test_unknown);
  r = r.it("require_good refuses revoked and unknown", test_require_good);
  r = r.it("a response after its nextUpdate", test_out_of_date);
  r = r.it("a response before its thisUpdate", test_not_yet_valid);
  r = r.it("a responder of another issuer", test_responder_of_another_issuer);
  r = r.it("a responder without id-kp-OCSPSigning", test_responder_without_ocsp_signing);
  r = r.it("a bad signature", test_bad_signature);
  r = r.it("a response for another certificate", test_response_for_another_certificate);
  r = r.it("an unsuccessful and a truncated response", test_unsuccessful_and_malformed);
  r = r.it("the issuer of a leaf", test_issuer_of);
  return r.finish();
}
