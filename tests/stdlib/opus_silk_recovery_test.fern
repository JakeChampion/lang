import "std/hash/crc32";
import "std/opus/packet";
import "std/opus/range";
import "std/opus/silk/output";
import "std/test";
import "opus_silk_recovery_vectors";

function references(): test.TestOutcome {
  let rows = opus_silk_recovery_vectors.PACKETS;
  let at = 0;
  let index = 0;
  while (at < rows.len()) {
    let rate = rows[at];
    let channels = rows[at + 1];
    let steps = rows[at + 2];
    let state = match (output.decoder(rate, channels)) { Ok(value) => value, Err(_) => { return test.fail("output decoder creation"); } };
    at += 3;
    for _ in 0..steps {
      let size = rows[at];
      let bytes: u8[] = [];
      for i in 0..size {
        bytes = bytes.append(rows[at + 1 + i] as u8);
      }
      at += size + 1;
      let count = rows[at];
      let samples: f32[] = [];
      let final_range = 0u32;
      if (size == 0) {
        let duration = count / channels / (rate / 1000);
        let (next, values) = match (output.decode_lost(state, duration)) { Ok(values) => values, Err(_) => { return test.fail("libopus loss rejected"); } };
        state = next;
        samples = values;
      } else {
        let p = match (packet.parse(bytes)) { Ok(value) => value, Err(_) => { return test.fail("libopus packet framing"); } };
        let internal_rate = if (packet.bandwidth(p.toc) == packet.NARROWBAND) { 8 } else if (packet.bandwidth(p.toc) == packet.MEDIUMBAND) { 12 } else { 16 };
        let stream = if (packet.stereo(p.toc)) { 2 } else { 1 };
        let duration = packet.samples_per_frame(p.toc, 48000) / 48;
        let Ok(prepared) = output.begin_packet(state, internal_rate, stream) else {
          return test.fail("packet setup");
        };
        state = prepared;
        for frame in p.frames {
          let (next, last, values) = match (output.decode_frame(state, range.decoder(frame), duration)) { Ok(values) => values, Err(_) => { return test.fail("libopus recovery frame rejected"); } };
          state = next;
          final_range = last.rng;
          for sample in values {
            samples = samples.append(sample);
          }
        }
      }
      if (samples.len() != count) {
        return test.fail("libopus recovery length");
      }
      let pcm: u8[] = [];
      for value in samples {
        let integer = (value * 32768.0f32) as i32;
        pcm = pcm.append((integer & 255) as u8).append((integer >> 8 & 255) as u8);
      }
      if (crc32.of(pcm) != rows[at + 1] as u32) {
        return test.fail("libopus recovery PCM packet " + index.to_string());
      }
      if (final_range != rows[at + 2] as u32) {
        return test.fail("libopus recovery range packet " + index.to_string());
      }
      for i in 0..8 {
        if ((samples[i] * 32768.0f32) as i32 != rows[at + 3 + i] || (samples[count - 8 + i] * 32768.0f32) as i32 != rows[at + 11 + i]) {
          return test.fail("libopus recovery boundary samples");
        }
      }
      at += 19;
      index += 1;
    }
  }
  return test.assert_eq(index, 600);
}

function main(): i32 {
  let runner = test.new("SILK loss and recovery against libopus");
  runner = runner.it("600 received and lost packets with rate and channel changes", references);
  return runner.finish();
}
