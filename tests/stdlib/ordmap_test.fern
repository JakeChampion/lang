import "std/test";
import "std/ordmap" as ordmap;
import "std/option";
import "std/i32";
import "std/i64";
import "std/u64";
import "core/cmp";
import "core/iter";

function test_new_is_empty(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.new();
  if (!m.is_empty() || m.len() != 0) {
    return test.fail("empty map has entries");
  }
  return test.assert_true(m.get(1).is_none() && !m.contains(1) && m.min_key().is_none());
}

function test_insert_get(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, string] = ordmap.new();
  m = m.insert(2, "two");
  m = m.insert(1, "one");
  m = m.insert(3, "three");
  if (m.len() != 3) {
    return test.fail("len " + m.len().to_string() + " != 3");
  }
  if (m.get_or(2, "") != "two" || m.get_or(9, "none") != "none") {
    return test.fail("get_or");
  }
  return test.assert_eq(m.get(1).unwrap_or(""), "one");
}

function test_insert_replaces(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.from([(1, 10), (2, 20), (1, 11)]);
  if (m.len() != 2) {
    return test.fail("duplicate key grew the map");
  }
  return test.assert_eq(m.get_or(1, -1), 11);
}

function test_insert_is_persistent(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.new();
  let i: i32 = 0;
  while (i < 200) {
    m = m.insert(i * 37 % 200, i);
    i = i + 1;
  }
  let snapshot: ordmap.OrdMap[i32, i32] = m;
  i = 0;
  while (i < 200) {
    m = m.insert(i, i + 1000);
    i = i + 1;
  }
  if (snapshot.len() != 200 || m.len() != 200) {
    return test.fail("lengths");
  }
  i = 0;
  while (i < 200) {
    if (snapshot.get_or(i * 37 % 200, -1) != i) {
      return test.fail("snapshot changed at " + i.to_string());
    }
    if (m.get_or(i, -1) != i + 1000) {
      return test.fail("update lost at " + i.to_string());
    }
    i = i + 1;
  }
  return test.assert_true(snapshot.is_valid() && m.is_valid());
}

function test_remove(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.new();
  let i: i32 = 0;
  while (i < 300) {
    m = m.insert(i * 53 % 300, i);
    i = i + 1;
  }
  let keep: ordmap.OrdMap[i32, i32] = m;
  i = 0;
  while (i < 300) {
    if (i % 3 != 0) {
      m = m.remove(i);
    }
    if (!m.is_valid()) {
      return test.fail("invalid after removing " + i.to_string());
    }
    i = i + 1;
  }
  if (m.len() != 100 || keep.len() != 300) {
    return test.fail("len after remove: " + m.len().to_string());
  }
  if (m.contains(1) || !m.contains(3) || !keep.contains(1)) {
    return test.fail("membership after remove");
  }
  return test.assert_eq(m.remove(1).len(), 100);
}

function test_sorted_iteration(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.from([(5, 50), (1, 10), (4, 40), (2, 20), (3, 30)]);
  let ks: i32[] = m.keys();
  let vs: i32[] = m.values();
  if (ks.len() != 5 || vs.len() != 5) {
    return test.fail("lengths");
  }
  let i: i32 = 0;
  while (i < 5) {
    if (ks[i] != i + 1 || vs[i] != (i + 1) * 10) {
      return test.fail("order at " + i.to_string());
    }
    i = i + 1;
  }
  let sum: i32 = m.fold(0, (a: i32, k: i32, v: i32) => a + k * v);
  return test.assert_eq(sum, 550);
}

function test_rank(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.new();
  let i: i32 = 0;
  while (i < 100) {
    m = m.insert(i * 2, i);
    i = i + 1;
  }
  if (m.key_at(0).unwrap_or(-1) != 0 || m.key_at(99).unwrap_or(-1) != 198 || m.key_at(100).is_some()) {
    return test.fail("key_at");
  }
  if (m.value_at(10).unwrap_or(-1) != 10) {
    return test.fail("value_at");
  }
  if (m.index_of(40).unwrap_or(-1) != 20 || m.index_of(41).is_some()) {
    return test.fail("index_of");
  }
  return test.assert_true(m.min_key().unwrap_or(-1) == 0 && m.max_key().unwrap_or(-1) == 198);
}

function test_min_max_remove(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.from([(3, 0), (1, 0), (2, 0)]);
  let r: ordmap.OrdMap[i32, i32] = m.remove_min().remove_max();
  if (r.len() != 1 || !r.contains(2)) {
    return test.fail("remove_min/max");
  }
  return test.assert_eq(m.len(), 3);
}

function test_update_map_filter(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.from([(1, 1), (2, 2), (3, 3), (4, 4)]);
  let u: ordmap.OrdMap[i32, i32] = m.update(2, 0, (v: i32) => v * 100);
  if (u.get_or(2, -1) != 200 || m.get_or(2, -1) != 2) {
    return test.fail("update");
  }
  let a: ordmap.OrdMap[i32, i32] = m.update(9, 7, (v: i32) => v + 1);
  if (a.len() != 5 || a.get_or(9, -1) != 8 || m.contains(9)) {
    return test.fail("update absent");
  }
  let d: ordmap.OrdMap[i32, i32] = m.map_values((v: i32) => v * 2);
  if (d.get_or(4, -1) != 8 || !d.is_valid()) {
    return test.fail("map_values");
  }
  let f: ordmap.OrdMap[i32, i32] = m.filter((k: i32, v: i32) => k % 2 == 0);
  if (f.len() != 2 || f.contains(1) || !f.contains(4) || !f.is_valid()) {
    return test.fail("filter");
  }
  return test.assert_eq(m.len(), 4);
}

function test_set_algebra(): test.TestOutcome {
  let a: ordmap.OrdMap[i32, i32] = ordmap.new();
  let b: ordmap.OrdMap[i32, i32] = ordmap.new();
  let i: i32 = 0;
  while (i < 500) {
    a = a.insert(i, 1);
    i = i + 1;
  }
  i = 250;
  while (i < 750) {
    b = b.insert(i, 2);
    i = i + 1;
  }
  let u: ordmap.OrdMap[i32, i32] = a.merge(b);
  if (u.len() != 750 || !u.is_valid() || u.get_or(300, -1) != 2 || u.get_or(100, -1) != 1 || u.get_or(600, -1) != 2) {
    return test.fail("merge (other wins)");
  }
  let x: ordmap.OrdMap[i32, i32] = a.intersection(b);
  if (x.len() != 250 || !x.is_valid() || x.get_or(300, -1) != 1 || x.contains(100)) {
    return test.fail("intersection");
  }
  let d: ordmap.OrdMap[i32, i32] = a.difference(b);
  if (d.len() != 250 || !d.is_valid() || d.contains(300) || !d.contains(100)) {
    return test.fail("difference");
  }
  return test.assert_true(a.len() == 500 && b.len() == 500);
}

function test_split(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.new();
  let i: i32 = 0;
  while (i < 100) {
    m = m.insert(i, i);
    i = i + 1;
  }
  let lo: ordmap.OrdMap[i32, i32] = m.split_lt(40);
  let hi: ordmap.OrdMap[i32, i32] = m.split_gt(40);
  if (lo.len() != 40 || hi.len() != 59 || !lo.is_valid() || !hi.is_valid()) {
    return test.fail("split sizes");
  }
  return test.assert_true(lo.max_key().unwrap_or(-1) == 39 && hi.min_key().unwrap_or(-1) == 41);
}

function test_string_keys(): test.TestOutcome {
  let m: ordmap.OrdMap[string, i32] = ordmap.new();
  m = m.insert("pear", 3);
  m = m.insert("apple", 1);
  m = m.insert("fig", 2);
  let ks: string[] = m.keys();
  if (ks.len() != 3 || ks[0] != "apple" || ks[1] != "fig" || ks[2] != "pear") {
    return test.fail("string order");
  }
  let snap: ordmap.OrdMap[string, i32] = m;
  m = m.remove("fig");
  if (snap.len() != 3 || m.len() != 2 || !snap.contains("fig")) {
    return test.fail("string snapshot");
  }
  return test.assert_eq(m.get_or("pear", -1), 3);
}

function test_for_each(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.from([(2, 20), (1, 10)]);
  let seen: i32 = 0;
  function visit(k: i32, v: i32): void {
    seen = seen * 3 + k * 100 + v;
  }
  m.for_each(visit);
  return test.assert_eq(seen, 550);
}

function lcg(x: i32): i32 {
  return x * 1103515245 + 12345 & 2147483647;
}

// The entries that present holds, in key order, as the map should hold them.
function present_matches(m: ordmap.OrdMap[i32, i32], present: i32[]): boolean {
  let at: i32 = 0;
  let count: i32 = 0;
  for e in m.iter() {
    while (at < present.len() && present[at] < 0) {
      at = at + 1;
    }
    if (at >= present.len() || e.0 != at || e.1 != present[at]) {
      return false;
    }
    at = at + 1;
    count = count + 1;
  }
  while (at < present.len()) {
    if (present[at] >= 0) {
      return false;
    }
    at = at + 1;
  }
  return count == m.len();
}

function rank_matches(m: ordmap.OrdMap[i32, i32], present: i32[], probe: i32): boolean {
  let below: i32 = 0;
  let k: i32 = 0;
  while (k < probe) {
    if (present[k] >= 0) {
      below = below + 1;
    }
    k = k + 1;
  }
  let lo: ordmap.OrdMap[i32, i32] = m.split_lt(probe);
  let hi: ordmap.OrdMap[i32, i32] = m.split_gt(probe);
  let hit: i32 = 0;
  if (present[probe] >= 0) {
    hit = 1;
    if (m.index_of(probe).unwrap_or(-1) != below || m.key_at(below).unwrap_or(-1) != probe) {
      return false;
    }
  } else if (m.index_of(probe).is_some()) {
    return false;
  }
  return lo.is_valid() && hi.is_valid() && lo.len() == below && hi.len() == m.len() - below - hit
    && (lo.is_empty() || lo.max_key().unwrap_or(probe) < probe) && (hi.is_empty() || hi.min_key().unwrap_or(probe) > probe);
}

function test_random_ops(): test.TestOutcome {
  let range: i32 = 1200;
  let present: i32[] = [];
  let i: i32 = 0;
  while (i < range) {
    present = present.append(-1);
    i = i + 1;
  }
  let m: ordmap.OrdMap[i32, i32] = ordmap.new();
  i = 0;
  while (i < range) {
    m = m.insert(i, i);
    present = present.with(i, i);
    i = i + 1;
  }
  if (!m.is_valid() || !present_matches(m, present)) {
    return test.fail("ascending build");
  }
  let snap: ordmap.OrdMap[i32, i32] = m;
  let x: i32 = 7;
  let step: i32 = 0;
  while (step < 2000) {
    x = lcg(x);
    let k: i32 = x % range;
    let op: i32 = x / range % 10;
    if (op < 4) {
      m = m.insert(k, step);
      present = present.with(k, step);
    } else if (op < 9) {
      m = m.remove(k);
      present = present.with(k, -1);
    } else if (m.get_or(k, -1) != present[k]) {
      return test.fail("get " + k.to_string() + " at step " + step.to_string());
    }
    if (step % 500 == 499) {
      if (!m.is_valid()) {
        return test.fail("invalid at step " + step.to_string());
      }
      if (!present_matches(m, present)) {
        return test.fail("entries differ at step " + step.to_string());
      }
      if (!rank_matches(m, present, k)) {
        return test.fail("rank or split at " + k.to_string() + ", step " + step.to_string());
      }
    }
    step = step + 1;
  }
  if (!m.is_valid() || !present_matches(m, present)) {
    return test.fail("final state");
  }
  if (snap.len() != range || !snap.is_valid() || snap.get_or(range - 1, -1) != range - 1) {
    return test.fail("snapshot changed");
  }
  i = 0;
  while (i < range) {
    m = m.remove(i);
    i = i + 1;
  }
  return test.assert_true(m.is_empty() && m.is_valid() && m.iter().next().is_none());
}

function url(i: i32): string {
  return "https://example.com/items/" + i.to_string();
}

function strings_match(m: ordmap.OrdMap[string, i32], want: string[]): boolean {
  let ks: string[] = m.keys();
  if (ks.len() != want.len() || m.len() != want.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < ks.len()) {
    if (ks[i] != want[i] || m.get_or(want[i], -1) < 0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function test_shared_prefix_strings(): test.TestOutcome {
  let m: ordmap.OrdMap[string, i32] = ordmap.new();
  let all: string[] = [];
  let x: i32 = 11;
  let i: i32 = 0;
  while (i < 1200) {
    x = lcg(x);
    let k: string = url(x % 2000);
    if (!m.contains(k)) {
      all = all.append(k);
    }
    m = m.insert(k, i);
    i = i + 1;
  }
  for k in ["", "a", "ab", "abc", "https://", "https://example.com/items/", "https://example.com/items/1", "été", "zz", "https://example.com/itemz"] {
    if (!m.contains(k)) {
      all = all.append(k);
    }
    m = m.insert(k, 1);
  }
  let want: string[] = cmp.sort(all);
  if (!m.is_valid() || !strings_match(m, want)) {
    return test.fail("inserted strings");
  }
  for absent in ["https://example.com/items", "https://example.com/items/x", "https://example.com/itemy", "é", "b", "https:/"] {
    if (m.contains(absent)) {
      return test.fail("found " + absent);
    }
  }
  let kept: string[] = [];
  i = 0;
  while (i < want.len()) {
    if (i % 3 == 0) {
      m = m.remove(want[i]);
    } else {
      kept = kept.append(want[i]);
    }
    i = i + 1;
  }
  if (!m.is_valid() || !strings_match(m, kept)) {
    return test.fail("after removals");
  }
  let lo: ordmap.OrdMap[string, i32] = m.split_lt("https://example.com/items/3");
  let hi: ordmap.OrdMap[string, i32] = m.split_gt("https://example.com/items/3");
  let hit: i32 = 0;
  if (m.contains("https://example.com/items/3")) {
    hit = 1;
  }
  if (!lo.is_valid() || !hi.is_valid() || lo.len() + hi.len() + hit != m.len()) {
    return test.fail("split at a shared prefix");
  }
  return test.assert_eq(lo.max_key().unwrap_or("") < "https://example.com/items/3", true);
}

function test_wide_integer_keys(): test.TestOutcome {
  let m: ordmap.OrdMap[i64, i32] = ordmap.new();
  let ks: i64[] = [0i64, -1i64, 1i64, 9223372036854775807i64, -9223372036854775807i64 - 1i64, 4294967296i64, -4294967296i64, 255i64, -256i64];
  let i: i32 = 0;
  for k in ks {
    m = m.insert(k, i);
    i = i + 1;
  }
  let got: i64[] = m.keys();
  let want: i64[] = cmp.sort(ks);
  if (!m.is_valid() || got.len() != want.len()) {
    return test.fail("i64 keys");
  }
  i = 0;
  while (i < got.len()) {
    if (got[i] != want[i]) {
      return test.fail("i64 order at " + i.to_string());
    }
    i = i + 1;
  }
  let u: ordmap.OrdMap[u64, i32] = ordmap.new();
  for w in [18446744073709551615u64, 0u64, 9223372036854775808u64, 9223372036854775807u64, 1u64] {
    u = u.insert(w, 0);
  }
  if (!u.is_valid() || u.min_key().unwrap_or(5u64) != 0u64 || u.max_key().unwrap_or(5u64) != 18446744073709551615u64) {
    return test.fail("u64 order");
  }
  let n: ordmap.OrdMap[i32, i32] = ordmap.new();
  i = -1000;
  while (i < 1000) {
    n = n.insert(i * 7 % 2003, i);
    i = i + 1;
  }
  return test.assert_true(n.is_valid() && n.min_key().unwrap_or(0) < 0 && n.len() == 2000);
}

struct Rev { v: i32 }

impl cmp.Ord for Rev {
  function cmp(self: Rev, other: Rev): i32 {
    return other.v.cmp(self.v);
  }
}

function test_default_prefix_keys(): test.TestOutcome {
  let m: ordmap.OrdMap[Rev, i32] = ordmap.new();
  let i: i32 = 0;
  while (i < 500) {
    m = m.insert(Rev { v: i * 13 % 500 }, i);
    i = i + 1;
  }
  m = m.remove(Rev { v: 7 });
  let first: Rev = m.min_key().unwrap_or(Rev { v: -1 });
  return test.assert_true(m.is_valid() && m.len() == 499 && first.v == 499 && !m.contains(Rev { v: 7 }) && m.get_or(Rev { v: 8 }, -1) >= 0);
}

function test_lazy_iteration(): test.TestOutcome {
  let m: ordmap.OrdMap[i32, i32] = ordmap.new();
  let i: i32 = 0;
  while (i < 2000) {
    m = m.insert(1999 - i, i);
    i = i + 1;
  }
  let firsts: (i32, i32)[] = m.iter().take(3).collect();
  if (firsts.len() != 3 || firsts[0].0 != 0 || firsts[2].0 != 2) {
    return test.fail("take(3)");
  }
  let n: i32 = 0;
  let last: i32 = -1;
  for e in m.iter() {
    if (e.0 <= last) {
      return test.fail("order at " + e.0.to_string());
    }
    last = e.0;
    n = n + 1;
  }
  let empty: ordmap.OrdMap[i32, i32] = ordmap.new();
  return test.assert_true(n == 2000 && m.entries().len() == 2000 && empty.iter().next().is_none());
}

function filled(from: i32, to: i32, v: i32): ordmap.OrdMap[i32, i32] {
  let m: ordmap.OrdMap[i32, i32] = ordmap.new();
  let i: i32 = from;
  while (i < to) {
    m = m.insert(i, v);
    i = i + 1;
  }
  return m;
}

function algebra_ok(a: ordmap.OrdMap[i32, i32], b: ordmap.OrdMap[i32, i32]): boolean {
  let u: ordmap.OrdMap[i32, i32] = a.merge(b);
  let x: ordmap.OrdMap[i32, i32] = a.intersection(b);
  let d: ordmap.OrdMap[i32, i32] = a.difference(b);
  if (!u.is_valid() || !x.is_valid() || !d.is_valid()) {
    return false;
  }
  let both: i32 = 0;
  for e in a.iter() {
    let inb: boolean = b.contains(e.0);
    if (inb) {
      both = both + 1;
    }
    if (u.get_or(e.0, -1) != (if (inb) { b.get_or(e.0, -1) } else { e.1 })) {
      return false;
    }
    if (x.contains(e.0) != inb || d.contains(e.0) == inb) {
      return false;
    }
  }
  return u.len() == a.len() + b.len() - both && x.len() == both && d.len() == a.len() - both;
}

function test_set_algebra_sizes(): test.TestOutcome {
  let big: ordmap.OrdMap[i32, i32] = filled(0, 640, 1);
  let small: ordmap.OrdMap[i32, i32] = filled(620, 650, 2);
  let mid: ordmap.OrdMap[i32, i32] = filled(300, 1000, 3);
  if (!algebra_ok(big, small) || !algebra_ok(small, big)) {
    return test.fail("one map much smaller");
  }
  return test.assert_true(algebra_ok(big, mid) && algebra_ok(mid, big));
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/ordmap");
  r = r.it("new is empty", test_new_is_empty);
  r = r.it("insert + get", test_insert_get);
  r = r.it("insert replaces", test_insert_replaces);
  r = r.it("insert is persistent", test_insert_is_persistent);
  r = r.it("remove", test_remove);
  r = r.it("sorted iteration", test_sorted_iteration);
  r = r.it("rank access", test_rank);
  r = r.it("min/max remove", test_min_max_remove);
  r = r.it("update/map/filter", test_update_map_filter);
  r = r.it("set algebra", test_set_algebra);
  r = r.it("split", test_split);
  r = r.it("string keys", test_string_keys);
  r = r.it("for_each", test_for_each);
  r = r.it("random operations against a model", test_random_ops);
  r = r.it("strings with a shared prefix", test_shared_prefix_strings);
  r = r.it("wide integer keys", test_wide_integer_keys);
  r = r.it("keys with the default prefix", test_default_prefix_keys);
  r = r.it("lazy iteration", test_lazy_iteration);
  r = r.it("set algebra at different sizes", test_set_algebra_sizes);
  return r.finish();
}
