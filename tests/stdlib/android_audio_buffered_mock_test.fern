// The ring of a Buffered stream of std/android/audio against a stand-in for libaaudio.so
// (scripts/audio-reference/aaudio-buffered-mock.c). main gives 0, or the
// number of the first check that fails.
import "std/android/audio";
import "std/audio/pcm";
import "std/bench";

@import("libaaudio.so", "mock_pull")
function pull(frames: i32): i32;

@import("libaaudio.so", "mock_sample")
function sample(i: i32): i32;

@import("libaaudio.so", "mock_flushes")
function flushes(): i32;

@import("libaaudio.so", "mock_closed")
function closed(): i32;

@import("libaaudio.so", "mock_buffer_size")
function buffer_size(): i32;

// The first `n` samples that the last pull gave.
function pulled(n: i32): string {
  let out: string[] = [];
  for i in 0..n {
    out = out.append(sample(i).to_string());
  }
  return out.join(",");
}

function joined(xs: i32[]): string {
  return xs.map((x: i32): string => x.to_string()).join(",");
}

function counted(n: i32, first: i32): i32[] {
  let out: i32[] = [];
  for i in 0..n {
    out = out.append(first + i);
  }
  return out;
}

function compare_floats(m: audio.Buffered, values: [f32]): boolean {
  let Ok(reference) = pcm.quantize(values, pcm.Format { sample_rate: 48000, channels: 2, bits_per_sample: 16 }, pcm.default_limits()) else {
    return false;
  };
  let Ok(n) = m.write_f32(values) else {
    return false;
  };
  if (n != values.len() || pull(n / 2) != 0) {
    return false;
  }
  for i in 0..n {
    if (sample(i) != reference.samples[i]) {
      return false;
    }
  }
  return true;
}

function floats(): i32 {
  let m = audio.buffered(48000, 2);
  if (m.ring == 0 as usize) {
    return 20;
  }
  let values: f32[] = [0.0f32, -0.0f32, 1.0f32, -1.0f32, 1.5f32, -1.5f32, 0.0000152587890625f32, -0.0000152587890625f32, 0.0000457763671875f32, -0.0000457763671875f32, 0.999969482421875f32, -0.999969482421875f32];
  let Ok(reference) = pcm.quantize(values, pcm.Format { sample_rate: 48000, channels: 2, bits_per_sample: 16 }, pcm.default_limits()) else {
    return 21;
  };
  let before = bench.alloc_count();
  let wrote = m.write_f32(values);
  let allocations = bench.allocs_after(before);
  let Ok(count) = wrote else {
    return 22;
  };
  if (count != values.len() || allocations != 0i64) {
    return 23;
  }
  if (pull(count / 2) != 0) {
    return 24;
  }
  for i in 0..count {
    if (sample(i) != reference.samples[i]) {
      return 25;
    }
  }
  for bad in [f32_from_bits(2139095040), f32_from_bits(-8388608), f32_from_bits(2143289344)] {
    let before_queue = m.queued();
    let Err(pcm.Sample) = m.write_f32([0.5f32, bad]) else {
      return 26;
    };
    if (m.queued() != before_queue || pull(1) != 0 || sample(0) != 0 || sample(1) != 0) {
      return 27;
    }
  }
  // Compare each signed quantization threshold and its adjacent binary32 values.
  for block in 0..128 {
    let thresholds: f32[] = [];
    for i in 0..256 {
      let midpoint = ((block * 256 + i) as f32 + 0.5f32) / 32768.0f32;
      for delta in [-1, 0, 1] {
        let near = f32_from_bits(f32_bits(midpoint) + delta);
        thresholds = thresholds.append(near).append(-near);
      }
    }
    if (!compare_floats(m, thresholds)) {
      return 37;
    }
  }
  let extremes: f32[] = [];
  for exponent in 0..255 {
    for fraction in [0, 1, 4194303, 8388607] {
      let value = f32_from_bits(exponent << 23 | fraction);
      extremes = extremes.append(value).append(-value);
    }
  }
  if (!compare_floats(m, extremes)) {
    return 38;
  }
  let values: f32[] = [];
  for _ in 0..96002 {
    values = values.append(0.5f32);
  }
  let Ok(n) = m.write_f32(values) else {
    return 28;
  };
  if (n != 96000) {
    return 29;
  }
  let Ok(empty) = m.write_f32([f32_from_bits(2143289344), 0.0f32]) else {
    return 30;
  };
  if (empty != 0 || pull(2) != 0) {
    return 31;
  }
  let Ok(part) = m.write_f32([0.25f32, -0.25f32, 0.125f32, -0.125f32, f32_from_bits(2143289344)]) else {
    return 32;
  };
  if (part != 4) {
    return 33;
  }
  for _ in 0..23 {
    if (pull(2000) != 0) {
      return 34;
    }
  }
  if (pull(1998) != 0) {
    return 35;
  }
  if (pull(2) != 0 || pulled(4) != "8192,-8192,4096,-4096") {
    return 36;
  }
  m.close();
  return 0;
}

pub function main(): i32 {
  let m = audio.buffered(48000, 2);
  if (m.ptr == 0 as usize || m.ring == 0 as usize || m.rate != 48000 || m.channels != 2) {
    return 1;
  }
  // The ring holds the sound, so the device keeps a buffer of a twentieth
  // of a second, not its whole capacity.
  if (buffer_size() != 2400) {
    return 12;
  }
  // The device takes the samples on its own thread, in order.
  if (m.write([1, 2, 3, 4, 5, 6, 7, 8]) != 8 || m.queued() != 4 + 2400) {
    return 2;
  }
  if (pull(2) != 0 || pulled(4) != "1,2,3,4") {
    return 3;
  }
  // The ring holds too few: silence follows the last samples.
  if (pull(4) != 0 || pulled(8) != "5,6,7,8,0,0,0,0" || m.queued() != 2400) {
    return 4;
  }
  if (joined(m.recent(4)) != "5,6,7,8" || joined(m.recent(100)) != "1,2,3,4,5,6,7,8") {
    return 5;
  }
  // A flush drops what the ring holds, and the samples after it play.
  if (m.write([9, 10, 11, 12]) != 4) {
    return 6;
  }
  m.pause();
  m.flush();
  if (flushes() != 1 || m.write([13, 14]) != 2 || !m.start() || pull(1) != 0 || pulled(2) != "13,14") {
    return 7;
  }
  // A sample out of range is clipped, and an odd sample waits for its frame.
  if (m.write([40000, -40000, 7]) != 2 || pull(1) != 0 || pulled(2) != "32767,-32768") {
    return 8;
  }
  // The ring takes a second of sound and keeps the history: the rest waits.
  let room = (48000 + audio.HISTORY) * 2 - audio.HISTORY * 2;
  if (m.write(counted(room + 10, 100)) != room || m.write([1, 2]) != 0) {
    return 9;
  }
  if (pull(3) != 0 || pulled(6) != "100,101,102,103,104,105" || m.write([1, 2, 3, 4, 5, 6, 7, 8]) != 6) {
    return 10;
  }
  m.close();
  if (closed() != 1) {
    return 11;
  }
  return floats();
}
