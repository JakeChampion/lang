import "std/test";
import "std/hash" as hash;
import "std/string";

function __pseudo(): u8[] {
  let b: u8[] = __alloc_u8(10003);
  let i: i32 = 0;
  while (i < 10003) {
    b = b.with(i, (i * 7 + 3 & 255) as u8);
    i = i + 1;
  }
  return b;
}

function __thousand_a(): string {
  let b: u8[] = __alloc_u8(1000);
  let i: i32 = 0;
  while (i < 1000) {
    b = b.with(i, 97 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

function test_cksum_vectors(): test.TestOutcome {
  if (hash.cksum_of("") != 4294967295) {
    return test.fail("empty");
  }
  if (hash.cksum_of("abc") != 1219131554) {
    return test.fail("abc");
  }
  let c: hash.Cksum = hash.cksum_new().update("abc");
  if (c.byte_count() != 3 as u64) {
    return test.fail("len");
  }
  return test.assert_eq(c.finish(), 1219131554);
}

function test_cksum_finish_is_a_read(): test.TestOutcome {
  let c: hash.Cksum = hash.cksum_new().update("ab");
  let mid: u32 = c.finish();
  c = c.update("c");
  if (mid != 2072780115) {
    return test.fail("mid");
  }
  return test.assert_eq(c.finish(), 1219131554);
}

function test_cksum_seven_byte_updates(): test.TestOutcome {
  let msg: u8[] = __pseudo();
  let c: hash.Cksum = hash.cksum_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    c = c.update_bytes(msg[i:i + 7]);
    i = i + 7;
  }
  c = c.update_bytes(msg[i:10003]);
  if (c.finish() != 741291487) {
    return test.fail("chunked");
  }
  if (c.byte_count() != 10003 as u64) {
    return test.fail("len");
  }
  return test.assert_eq(c.finish(), hash.cksum_of(string_from_bytes_unchecked(msg)));
}

function test_cksum_string_chunks_match_the_table(): test.TestOutcome {
  let msg: string = string_from_bytes_unchecked(__pseudo());
  let cuts: i32[] = [1, 15, 16, 17, 31, 47, 63, 64, 65, 113, 191, 1009];
  let c: hash.Cksum = hash.cksum_new();
  let at: i32 = 0;
  let k: i32 = 0;
  while (at < 10003) {
    let take: i32 = cuts[k % cuts.len()];
    if (at + take > 10003) {
      take = 10003 - at;
    }
    c = c.update(slice_unchecked(msg, at, at + take));
    at = at + take;
    k = k + 1;
  }
  if (c.byte_count() != 10003 as u64) {
    return test.fail("len");
  }
  let viabytes: hash.Cksum = hash.cksum_new().update_bytes(__pseudo());
  if (c.finish() != viabytes.finish()) {
    return test.fail("chunked string vs table");
  }
  return test.assert_eq(c.finish(), hash.cksum_of(msg));
}

function test_bsd_sum(): test.TestOutcome {
  if (hash.bsd_sum_of("") != 0) {
    return test.fail("empty");
  }
  if (hash.bsd_sum_of("abc") != 16556) {
    return test.fail("abc");
  }
  let msg: u8[] = __pseudo();
  let s: hash.BsdSum = hash.bsd_sum_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    s = s.update_bytes(msg[i:i + 7]);
    i = i + 7;
  }
  s = s.update_bytes(msg[i:10003]);
  if (s.finish() != 21454) {
    return test.fail("chunked");
  }
  let array_sum: hash.BsdSum = hash.bsd_sum_new().update_array(msg);
  if (array_sum.finish() != s.finish() || array_sum.byte_count() != s.byte_count()) {
    return test.fail("owned-array BSD kernel");
  }
  if (s.finish() != hash.bsd_sum_of(string_from_bytes_unchecked(msg))) {
    return test.fail("one-shot");
  }
  if (s.byte_count() != 10003 as u64) {
    return test.fail("len");
  }
  return test.assert_eq(s.blocks(), 10 as u64);
}

function test_sysv_sum(): test.TestOutcome {
  if (hash.sysv_sum_of("") != 0) {
    return test.fail("empty");
  }
  if (hash.sysv_sum_of("abc") != 294) {
    return test.fail("abc");
  }
  let msg: u8[] = __pseudo();
  let s: hash.SysvSum = hash.sysv_sum_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    s = s.update_bytes(msg[i:i + 7]);
    i = i + 7;
  }
  s = s.update_bytes(msg[i:10003]);
  if (s.finish() != 29049) {
    return test.fail("chunked");
  }
  let array_sum: hash.SysvSum = hash.sysv_sum_new().update_array(msg);
  if (array_sum.finish() != s.finish() || array_sum.byte_count() != s.byte_count()) {
    return test.fail("owned-array System V kernel");
  }
  if (s.finish() != hash.sysv_sum_of(string_from_bytes_unchecked(msg))) {
    return test.fail("one-shot");
  }
  if (s.byte_count() != 10003 as u64) {
    return test.fail("len");
  }
  return test.assert_eq(s.blocks(), 20 as u64);
}

function __chunk(msg: u8[], from: i32, n: i32): string {
  let b: u8[] = __alloc_u8(n);
  let k: i32 = 0;
  while (k < n) {
    b = b.with(k, msg[from + k]);
    k = k + 1;
  }
  return string_from_bytes_unchecked(b);
}

function test_sysv_sum_string_updates(): test.TestOutcome {
  let msg: u8[] = __pseudo();
  let s: hash.SysvSum = hash.sysv_sum_new();
  let i: i32 = 0;
  while (i + 7 <= 10003) {
    s = s.update(__chunk(msg, i, 7));
    i = i + 7;
  }
  s = s.update(__chunk(msg, i, 10003 - i));
  if (s.finish() != 29049) {
    return test.fail("chunked string");
  }
  if (s.byte_count() != 10003 as u64) {
    return test.fail("len");
  }
  let b: hash.SysvSum = hash.sysv_sum_new().update_bytes(msg);
  return test.assert_eq(s.finish(), b.finish());
}

function test_block_counts(): test.TestOutcome {
  let b: u8[] = __alloc_u8(1025);
  let i: i32 = 0;
  while (i < 1025) {
    b = b.with(i, 0 as u8);
    i = i + 1;
  }
  let r: hash.BsdSum = hash.bsd_sum_new().update_bytes(b);
  let s: hash.SysvSum = hash.sysv_sum_new().update_bytes(b);
  if (r.blocks() != 2 as u64) {
    return test.fail("bsd 1025 -> 2");
  }
  if (s.blocks() != 3 as u64) {
    return test.fail("sysv 1025 -> 3");
  }
  if (hash.bsd_sum_new().blocks() != 0 as u64) {
    return test.fail("bsd empty");
  }
  return test.assert_eq(hash.sysv_sum_new().blocks(), 0 as u64);
}

function test_xxh64(): test.TestOutcome {
  let hundred: u8[] = [];
  while (hundred.len() < 100) {
    hundred = hundred.append(hundred.len() as u8);
  }
  let ins: u8[][] = ["".bytes(), "a".bytes(), "abc".bytes(), "Nobody inspects the spammish repetition".bytes(), hundred];
  let got: string = "";
  for b in ins {
    got = got + hash.xxh64(b, 0).to_string() + "/" + hash.xxh64(b, 2654435761).to_string() + " ";
  }
  return test.assert_eq(got.trim(), "17241709254077376921/12427117621484918767 15154266338359012955/4124638339981780891 4952883123889572249/1376095083568989693 18144624926692707313/6258634441271611719 7692681977284421015/9813981487457390353");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/hash checksums");
  r = r.it("cksum vectors", test_cksum_vectors);
  r = r.it("cksum finish is a read", test_cksum_finish_is_a_read);
  r = r.it("cksum 7-byte updates", test_cksum_seven_byte_updates);
  r = r.it("cksum string chunks match the table", test_cksum_string_chunks_match_the_table);
  r = r.it("bsd sum", test_bsd_sum);
  r = r.it("sysv sum", test_sysv_sum);
  r = r.it("sysv sum string updates", test_sysv_sum_string_updates);
  r = r.it("block counts", test_block_counts);
  r = r.it("xxh64", test_xxh64);
  return r.finish();
}
