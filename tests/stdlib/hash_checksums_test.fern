import "std/test";
import "std/hash" as hash;
import "std/string";

// tests/stdlib/hash_checksums_test.fern — std/hash's cksum(1) CRC-32 and the
// sum(1) checksums against values from GNU coreutils (`printf abc | cksum`,
// `sum -r`, `sum -s`), streamed in 7-byte updates and cross-checked against the
// one-shot forms, with the block counts the utilities print; and XXH64 against
// the reference vectors.

// __pseudo builds the 10,003-byte fixed pattern byte i = (i * 7 + 3) & 255:
// long enough that 7-byte updates straddle every block boundary offset, and
// not valid UTF-8, so the hasher is fed raw bytes.
function __pseudo(): u8[] {
  let b: u8[] = __alloc_u8(10003);
  let i: i32 = 0;
  while (i < 10003) {
    b = b.with(i, (i * 7 + 3 & 255) as u8);
    i = i + 1;
  }
  return b;
}

// __thousand_a is 1000 'a's, the unit of the million-'a' vector.
function __thousand_a(): string {
  let b: u8[] = __alloc_u8(1000);
  let i: i32 = 0;
  while (i < 1000) {
    b = b.with(i, 97 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

function test_cksum_vectors(): test.TestOutcome {
  if (hash.cksum_of("".as_bytes()) != 4294967295) {
    return test.fail("empty");
  }
  if (hash.cksum_of("abc".as_bytes()) != 1219131554) {
    return test.fail("abc");
  }
  let c: hash.Cksum = hash.cksum_new().update("abc".as_bytes());
  if (c.byte_count() != 3 as u64) {
