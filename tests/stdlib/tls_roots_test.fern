import "std/test";
import "core/int";
import "std/hex";
import "std/tls/pem";
import "std/tls/verify";
import "std/tls/x509";

// tests/stdlib/tls_roots_test.fern — std/tls/verify's root store: roots read
// from a PEM bundle on disk, a path that does not read, and the machine's
// own bundle. Kept apart from tls_verify_test because it needs a file system,
// which the wasm suite does not grant.

function ec_root(): u8[] {
  return hex.hex_decode("");
}

function ec_int(): u8[] {
  return hex.hex_decode("");
}

function ec_leaf(): u8[] {
  return hex.hex_decode("");
}

function rsa_root(): u8[] {
  return hex.hex_decode("");
}

function outcome(r: Result[x509.Certificate, verify.VerifyError]): string {
  match (r) {
    Ok(c) => {
      return "ok " + c.subject.common_name;
    },
    Err(e) => {
      return e.message();
    }
  }
  return "";
}

function test_bundle_file(dir: string): test.TestOutcome {
  let path: string = dir + "/bundle.pem";
  let text: string = "# test roots\n" + pem.encode("CERTIFICATE", rsa_root()) + pem.encode("CERTIFICATE", ec_root());
  match (write_file(path, text)) {
    Ok(_) => {},
    Err(_) => {
      return test.fail("write_file failed");
    }
  }
  match (verify.roots_from_file(path)) {
    Ok(r) => {
      if (r.certs.len() != 2) {
        return test.fail("two roots");
      }
      return test.assert_eq(outcome(verify.verify_server([ec_leaf(), ec_int()], r, "example.com", 1780000000 as i64)), "ok example.com");
    },
    Err(e) => {
      return test.fail(e.message());
    }
  }
  return test.fail("unreachable");
}

function test_unreadable(dir: string): test.TestOutcome {
  let empty: string = dir + "/empty.pem";
  match (write_file(empty, "no certificates here\n")) {
    Ok(_) => {},
    Err(_) => {
      return test.fail("write_file failed");
    }
  }
  match (verify.roots_from_file(empty)) {
    Ok(r) => {
      return test.fail("a bundle with no certificates accepted");
    },
    Err(e) => {
      if (e.message() != "tls verify: no certificates could be read from " + empty) {
        return test.fail(e.message());
      }
    }
  }
  match (verify.roots_from_file(dir + "/missing.pem")) {
    Ok(r) => {
      return test.fail("a missing file accepted");
    },
    Err(e) => {
      return test.assert_eq(e.message(), "tls verify: no certificates could be read from " + dir + "/missing.pem");
    }
  }
  return test.fail("unreachable");
}

// What the machine trusts depends on the machine; whatever it finds parsed.
function test_system_roots(): test.TestOutcome {
  match (verify.system_roots()) {
    Some(r) => {
      return test.assert_eq(r.certs.len() > 0, true);
    },
    None => {
      return test.pass();
    }
  }
  return test.fail("unreachable");
}

function main(): i32 {
  let r: test.TestRunner = test.test_new("std/tls/verify roots");
  let (dir, rr) = test.must_temp_dir(r, "tls-roots");
  if (dir == "") {
    return rr.finish();
  }
  rr = rr.it("roots from a bundle file", () => test_bundle_file(dir));
  rr = rr.it("a file with no roots", () => test_unreadable(dir));
  rr = rr.it("the system's roots", test_system_roots);
  return rr.finish();
}
