import "std/test";
import "std/f64";

function test_cbrt_perfect(): test.TestOutcome {
  if (!float_near(27.0.cbrt(), 3.0)) {
    return test.fail("cbrt 27");
  }
  return test.assert_eq_f64_near(8.0.cbrt(), 2.0, 0.001);
}

// A cube has its exact root, at each size. The largest and the smallest
// numbers have the nearest root.
function test_cbrt_exact(): test.TestOutcome {
  for n in [3.0, 7.0, 10.0, 99.0, 12345.0, 200000.0] {
    if ((n * n * n).cbrt() != n) {
      return test.fail("cbrt of the cube of " + n.to_string() + " is " + (n * n * n).cbrt().to_string());
    }
  }
  if (1e300.cbrt() != 1e100 || 1e-300.cbrt() != 1e-100 || 0.001.cbrt() != 0.1) {
    return test.fail("cbrt of a power of 1000");
  }
  if (1.7976931348623157e308.cbrt() != 5.643803094122362e102 || 5e-324.cbrt() != 1.7031839360032603e-108) {
    return test.fail("cbrt at the limits");
  }
  if (2.0.cbrt() != 1.2599210498948732 || (0.0 - 2.0).cbrt() != 0.0 - 1.2599210498948732) {
    return test.fail("cbrt 2");
  }
  let inf = 1.0 / 0.0;
  if (inf.cbrt() != inf || (0.0 - inf).cbrt() != 0.0 - inf) {
    return test.fail("cbrt of an infinity");
  }
  return test.pass();
}

function test_cbrt_negative(): test.TestOutcome {
  return test.assert_eq_f64_near((0.0 - 8.0).cbrt(), 0.0 - 2.0, 0.001);
}

function test_cbrt_fractional(): test.TestOutcome {
  return test.assert_eq_f64_near(0.125.cbrt(), 0.5, 0.001);
}

function test_hypot3_pythagorean(): test.TestOutcome {
  if (!float_near(2.0.hypot3(3.0, 6.0), 7.0)) {
    return test.fail("2,3,6 -> 7");
  }
  return test.assert_eq_f64_near(1.0.hypot3(2.0, 2.0), 3.0, 0.0001);
}

function test_hypot3_zero_and_2d(): test.TestOutcome {
  if (!float_near(0.0.hypot3(0.0, 0.0), 0.0)) {
    return test.fail("origin");
  }
  return test.assert_eq_f64_near(3.0.hypot3(4.0, 0.0), 5.0, 0.0001);
}

function test_f32(): test.TestOutcome {
  if (!float_near((27.0 as f32).cbrt() as f64, 3.0)) {
    return test.fail("cbrt f32");
  }
  return test.assert_eq_f64_near((2.0 as f32).hypot3(3.0 as f32, 6.0 as f32) as f64, 7.0, 0.001);
}

function float_near(a: f64, b: f64): boolean {
  let d = a - b;
  if (d < 0.0) {
    d = 0.0 - d;
  }
  return d < 0.001;
}

function main(): i32 {
  let r = test.new("std/f64 cbrt/hypot3");
  r = r.it("cbrt perfect cube", test_cbrt_perfect);
  r = r.it("cbrt is exact for a cube, and the nearest number at the limits", test_cbrt_exact);
  r = r.it("cbrt negative", test_cbrt_negative);
  r = r.it("cbrt fractional", test_cbrt_fractional);
  r = r.it("hypot3 pythagorean", test_hypot3_pythagorean);
  r = r.it("hypot3 zero and 2d", test_hypot3_zero_and_2d);
  r = r.it("f32", test_f32);
  return r.finish();
}
