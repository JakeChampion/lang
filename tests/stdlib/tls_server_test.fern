import "std/test";
import "std/hex";
import "std/i32";
import "std/tls/client";
import "std/tls/handshake";
import "std/tls/server";
import "std/tls/verify";
import "std/time";

// tests/stdlib/tls_server_test.fern — std/tls/server: keys read from PKCS #8
// and SEC 1, an identity checked against its leaf, and the session against
// std/tls/client over P-256, P-384 and Ed25519 leaves: ALPN, the name the
// client asked for, data both ways, close_notify, and the refusals. The
// certificates are under an Ed25519 root, valid from 2020 to 2100, made
// with Python's `cryptography`; the keys are the fixed scalars 0x33, 0x44
// and 0x22 repeated.

const ROOT: string = "";

const P256_LEAF: string = "";

const P384_LEAF: string = "";

const ED_LEAF: string = "";

