// A NativeActivity app for the emulator check of android.languages,
// std/i18n and the fallback fonts. At the first Resume it logs the
// languages of the person, and the language that std/i18n chooses for an
// app with German and English texts. Then it logs how many glyphs of a
// Hebrew, an Arabic and a Chinese word come from a fallback font and have
// pixels. The Chinese font of the system is CFF, in a collection. Last it
// logs whether the fatha of an Arabic letter is above the middle of the
// letter, and finishes.
import "std/android";
import "std/android/fonts";
import "std/android/launch";
import "std/android/text";
import "std/bidi";
import "std/i18n";
import "std/kv";
import "std/log";

struct App { ctx: usize, done: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last: App = android.run(ctx, App { ctx: ctx, done: false }, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => -1);
  return 0 as usize;
}

// The number of glyphs of `s` that come from a fallback font and have
// pixels, a slash, and the number of glyphs.
function drawn(fs: text.Fonts, s: string): string {
  let (_, placed) = text.layout(text.new_cache(), fs, 0, 32, 0, s);
  let n = 0;
  for p in placed {
    if (p.key >> 32 >= 64i64 * 4096i64 * 4i64 && p.bm.width > 0 && p.bm.coverage.len() > 0) {
      n += 1;
    }
  }
  return n.to_string() + "/" + placed.len().to_string();
}

// Whether the first glyph of `s` is above its last glyph, and whether its
// middle is near the middle of the last glyph.
function mark_on_base(fs: text.Fonts, s: string): string {
  let (_, placed) = text.layout(text.new_cache(), fs, 0, 64, 0, s);
  if (placed.len() < 2) {
    return "missing";
  }
  let (mark, base) = (placed[0], placed[placed.len() - 1]);
  let middle = mark.x + mark.bm.width / 2 - (base.x + base.bm.width / 2);
  return (mark.y + mark.bm.height <= base.y).to_string() + " " + (middle.abs() < base.bm.width / 4).to_string();
}

function step(s: App, e: android.Event): App {
  if let android.Resume = e {
    if (s.done) {
      return s;
    }
    let langs = android.languages(s.ctx);
    let lang = i18n.lookup(["de", "en"], langs, "de");
    let texts = i18n.strings(lang, kv.empty("en.kv").set("hello", "Hello"), kv.empty("de.kv").set("hello", "Hallo"));
    log.warn("i18ntest: languages " + langs.join(","));
    log.warn("i18ntest: chose " + lang + " " + texts.text("hello"));
    log.warn("i18ntest: rtl " + android.rtl_layout(s.ctx).to_string());
    for f in fonts.fallbacks(s.ctx, "sans-serif", 400, 20013) {
      log.warn("i18ntest: font of U+4E2D " + f.path + "#" + f.index.to_string());
    }
    let fs = text.system(s.ctx, "sans-serif", [400]);
    for word in ["שלום", "مرحبا", "中文"] {
      fs = fs.covering(0, word, text.system_fallbacks(s.ctx, "sans-serif"));
      log.warn("i18ntest: fallback " + drawn(fs, bidi.display(word, bidi.AUTO)));
    }
    let fatha = "\u{628}\u{64e}";
    fs = fs.covering(0, fatha, text.system_fallbacks(s.ctx, "sans-serif"));
    log.warn("i18ntest: mark " + mark_on_base(fs, bidi.display(fatha, bidi.AUTO)));
    android.finish(s.ctx);
    return App { ...s, done: true };
  }
  return s;
}
