// A NativeActivity app for the emulator check of android.languages and
// std/i18n. At the first Resume it logs the languages of the person, and
// the language that std/i18n chooses for an app with German and English
// texts, then finishes.
import "std/android";
import "std/android/launch";
import "std/i18n";
import "std/kv";
import "std/log";

struct App { ctx: usize, done: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last: App = android.run(ctx, App { ctx: ctx, done: false }, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => -1);
  return 0 as usize;
}

function step(s: App, e: android.Event): App {
  if let android.Resume = e {
    if (s.done) {
      return s;
    }
    let langs = android.languages(s.ctx);
    let lang = i18n.lookup(["de", "en"], langs, "de");
    let texts = i18n.strings(lang, kv.empty("en.kv").set("hello", "Hello"), kv.empty("de.kv").set("hello", "Hallo"));
    log.warn("i18ntest: languages " + langs.join(","));
    log.warn("i18ntest: chose " + lang + " " + texts.text("hello"));
    android.finish(s.ctx);
    return App { ...s, done: true };
  }
  return s;
}
