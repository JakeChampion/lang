// A NativeActivity app for std/android/speech. At the first Resume it asks
// for the permission to record. With the permission, it listens for speech
// in the language of the device. The app logs each event, and finishes
// after the words or after an error.
import "std/android";
import "std/android/launch";
import "std/android/speech";
import "std/log";

struct App { ctx: usize, recognizer: Option[speech.Recognizer], asked: boolean, started: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let first = App { ctx: ctx, recognizer: None, asked: false, started: false };
  let last: App = android.run(ctx, first, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => -1);
  return 0 as usize;
}

function step(s: App, e: android.Event): App {
  if let Some(c) = speech.event(e) {
    return heard(s, c);
  }
  match (e) {
    android.Resume => {
      return resumed(s);
    },
    _ => {
      return s;
    }
  }
}

function resumed(s: App): App {
  if (s.started) {
    return s;
  }
  if (speech.allowed(s.ctx)) {
    return start(App { ...s, started: true });
  }
  if (s.asked) {
    log.warn("speechtest: no permission to record");
    android.finish(s.ctx);
    return App { ...s, started: true };
  }
  speech.ask(s.ctx);
  return App { ...s, asked: true };
}

function start(s: App): App {
  let Some(r) = speech.new(s.ctx) else {
    log.warn("speechtest: no recognition service");
    android.finish(s.ctx);
    return s;
  };
  log.warn("speechtest: start sent " + speech.start(s.ctx, r, "").to_string());
  return App { ...s, recognizer: Some(r) };
}

function heard(s: App, c: speech.Change): App {
  match (c) {
    speech.Ready => {
      log.warn("speechtest: listening");
      return s;
    },
    speech.Partial(text) => {
      log.warn("speechtest: partial " + text);
      return s;
    },
    speech.Words(text) => {
      log.warn("speechtest: words " + text);
    },
    speech.Failed(code) => {
      log.warn("speechtest: failed " + code.to_string());
    }
  }
  if let Some(r) = s.recognizer {
    speech.close(s.ctx, r);
  }
  android.finish(s.ctx);
  return App { ...s, recognizer: None };
}
