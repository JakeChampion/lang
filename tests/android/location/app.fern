// A NativeActivity app for the emulator check of std/android/location. At
// the first Resume it asks for precise fixes each second. The check sets the
// place of the emulator. The app logs whether the first fix is near that
// place and whether `last` knows it, then stops the fixes and finishes.
import "std/android";
import "std/android/launch";
import "std/android/location";
import "std/log";
import "std/option";

const CLASS: string = "dev.fern.locationtest.Where";

const LATITUDE: f64 = 37.422;

const LONGITUDE: f64 = 0.0 - 122.084;

struct App { ctx: usize, on: Option[location.Location], fixes: i32 }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

@jni("dev.fern.locationtest.Where implements android.location.LocationListener", "void onLocationChanged(android.location.Location)")
pub function where_changed(env: usize, thiz: usize, loc: usize): void {
  location.changed(env, thiz, loc);
}

@jni("dev.fern.locationtest.Where", "void onProviderEnabled(java.lang.String)")
pub function where_enabled(env: usize, thiz: usize, provider: usize): void {
  location.enabled(env, thiz, provider);
}

@jni("dev.fern.locationtest.Where", "void onProviderDisabled(java.lang.String)")
pub function where_disabled(env: usize, thiz: usize, provider: usize): void {
  location.disabled(env, thiz, provider);
}

@jni("dev.fern.locationtest.Where", "void onStatusChanged(java.lang.String, int, android.os.Bundle)")
pub function where_status(env: usize, thiz: usize, provider: usize, status: i32, extras: usize): void {}

function app_main(ctx: usize): usize {
  let first = App { ctx: ctx, on: None, fixes: 0 };
  let last: App = android.run(ctx, first, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => -1);
  return 0 as usize;
}

function near(f: location.Fix): boolean {
  return (f.latitude - LATITUDE).abs() < 0.001 && (f.longitude - LONGITUDE).abs() < 0.001;
}

function step(s: App, e: android.Event): App {
  if let android.Resume = e {
    if (s.fixes > 0 || s.on.is_some()) {
      return s;
    }
    let started = location.start(s.ctx, CLASS, true, 1000i64);
    log.warn("locationtest: allowed " + location.allowed(s.ctx, true).to_string() + ", started " + started.is_some().to_string());
    return App { ...s, on: started };
  }
  let Some(on) = s.on else {
    return s;
  };
  let Some(location.Moved(f)) = location.event(e) else {
    return s;
  };
  log.warn("locationtest: fix near " + near(f).to_string() + " accuracy " + f.accuracy.to_string());
  if (!near(f)) {
    return s;
  }
  let known = match (location.last(s.ctx, true)) {
    Some(l) => near(l),
    None => false,
  };
  log.warn("locationtest: last near " + known.to_string());
  location.stop(s.ctx, on);
  log.warn("locationtest: stopped");
  android.finish(s.ctx);
  return App { ...s, on: None, fixes: s.fixes + 1 };
}
