// A NativeActivity app for the emulator check of std/android/camera. At the
// first Resume it opens the back camera at 320 by 240. It logs whether three
// frames have the size and a picture that is not one flat value, then
// stops the camera and finishes.
import "std/android";
import "std/android/camera";
import "std/android/launch";
import "std/log";
import "std/option";

const WIDTH: i32 = 320;

const HEIGHT: i32 = 240;

struct App { ctx: usize, on: Option[camera.Camera], frames: i32 }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let first = App { ctx: ctx, on: None, frames: 0 };
  let last: App = android.run(ctx, first, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => -1);
  return 0 as usize;
}

// Whether the luma of `f` has more than one value.
function varied(f: camera.Frame): boolean {
  for b in f.y {
    if (b != f.y[0]) {
      return true;
    }
  }
  return false;
}

function step(s: App, e: android.Event): App {
  if let android.Resume = e {
    if (s.frames > 0 || s.on.is_some()) {
      return s;
    }
    let sized = camera.sizes(camera.BACK).contains((WIDTH, HEIGHT));
    let started = camera.start(s.ctx, camera.BACK, WIDTH, HEIGHT);
    log.warn("cameratest: allowed " + camera.allowed(s.ctx).to_string() + ", size " + sized.to_string() + ", started " + started.is_some().to_string());
    return App { ...s, on: started };
  }
  let Some(on) = s.on else {
    return s;
  };
  let Some(f) = camera.event(on, e) else {
    return s;
  };
  let frames = s.frames + 1;
  let image = f.rgba();
  let whole = f.y.len() == WIDTH * HEIGHT && f.u.len() == WIDTH * HEIGHT / 4 && image.pixels.len() == WIDTH * HEIGHT * 4;
  log.warn("cameratest: frame " + frames.to_string() + " whole " + whole.to_string() + " varied " + varied(f).to_string() + " at " + f.ns.to_string());
  if (frames < 3) {
    return App { ...s, frames: frames };
  }
  camera.stop(on);
  log.warn("cameratest: stopped");
  android.finish(s.ctx);
  return App { ...s, on: None, frames: frames };
}
