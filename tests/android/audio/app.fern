// A NativeActivity app for the emulator check of std/android/audio and of
// JNI calls from the loop thread. At the first Resume it checks the
// RECORD_AUDIO permission, reads half a second from the microphone, plays
// half a second of a 400 Hz square wave, logs what happened, and finishes.
import "std/android";
import "std/android/audio";
import "std/log";

struct App { ctx: usize, done: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last: App = android.run(ctx, App { ctx: ctx, done: false }, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => -1);
  return 0 as usize;
}

function step(s: App, e: android.Event): App {
  match (e) {
    android.Resume => {
      if (!s.done) {
        check(s.ctx);
        android.finish(s.ctx);
      }
      return App { ...s, done: true };
    },
    _ => {
      return s;
    }
  }
}

function check(ctx: usize): void {
  log.warn("audiotest: sdk " + android.sdk_version(ctx).to_string() + ", record permission " + android.has_permission(ctx, "android.permission.RECORD_AUDIO").to_string());
  let mic: audio.Stream = audio.capture(48000);
  let read = 0;
  if (mic.start()) {
    for k in 0..25 {
      read += mic.read(960, 200).len();
    }
    mic.stop();
  }
  mic.close();
  log.warn("audiotest: capture rate " + mic.rate.to_string() + ", read " + read.to_string() + " samples");
  let speaker: audio.Stream = audio.playback(48000);
  let wrote = 0;
  if (speaker.start()) {
    for k in 0..25 {
      let tone: i32[] = [];
      for i in 0..960 {
        let level = 8000;
        if ((k * 960 + i) / 60 % 2 == 1) {
          level = -8000;
        }
        tone = tone.append(level);
      }
      wrote += speaker.write(tone, 200);
    }
    log_anchor(speaker);
    speaker.stop();
  }
  speaker.close();
  log.warn("audiotest: playback rate " + speaker.rate.to_string() + ", wrote " + wrote.to_string() + " samples");
}

function log_anchor(speaker: audio.Stream): void {
  match (speaker.timestamp()) {
    Some(value) => {
      log.warn("audiotest: timestamp frames " + value.frame_position.to_string() + " monotonic_ns " + value.monotonic_ns.to_string());
    },
    None => {
      log.warn("audiotest: timestamp unavailable");
    }
  }
}
