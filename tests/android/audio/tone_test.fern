import "./tone";
import "std/i32";

function short_writes(frames: i32, channels: i32, half_period: i32): boolean {
  let pos = cell_new(0);
  let calls = cell_new(0);
  let send = (samples: [i32], ms: i32): i32 => {
    calls.set(calls.get() + 1);
    if (calls.get() % 4 == 1) {
      return 0;
    }
    if (ms <= 0 || ms > 200) {
      return -1;
    }
    let n = samples.len().min(37 * channels);
    for i in 0..n {
      let index = pos.get() + i;
      let level = if (index % channels != 0) { 0 } else if (index / channels / half_period % 2 == 0) { 8000 } else { -8000 };
      if (samples[i] != level) {
        return -1;
      }
    }
    pos.set(pos.get() + n);
    return n;
  };
  let total = tone.play(frames, channels, half_period, send);
  return total == frames * channels * 25 && pos.get() == total;
}

function main(): i32 {
  if (!short_writes(960, 1, 60) || !short_writes(882, 2, 50)) {
    return 1;
  }
  let calls = cell_new(0);
  let stalled = (samples: [i32], ms: i32): i32 => {
    calls.set(calls.get() + 1);
    return if (samples.len() == 4) { 2 } else { 0 };
  };
  if (tone.block([10, 11, 20, 21], 2, stalled) != 2 || calls.get() != 3) {
    return 2;
  }
  if (tone.block([10, 11], 2, (samples: [i32], ms: i32): i32 => 1) != 0) {
    return 3;
  }
  if (tone.block([10, 11], 2, (samples: [i32], ms: i32): i32 => 4) != 0) {
    return 4;
  }
  return 0;
}
