// A NativeActivity app for the emulator check of std/android/sensors. At
// the first Resume it turns the accelerometer on at 20 ms. It logs three
// readings and whether the size of the acceleration is near gravity, then
// stops the sensor and finishes.
import "std/android";
import "std/android/launch";
import "std/android/sensors";
import "std/log";
import "std/option";

struct App { ctx: usize, sensors: Option[sensors.Sensors], seen: i32 }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let first = App { ctx: ctx, sensors: None, seen: 0 };
  let last: App = android.run(ctx, first, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => -1);
  return 0 as usize;
}

function step(s: App, e: android.Event): App {
  if let android.Resume = e {
    if (s.seen > 0 || s.sensors.is_some()) {
      return s;
    }
    let started = sensors.start(s.ctx, [sensors.ACCELEROMETER], 20000);
    log.warn("sensortest: has accelerometer " + sensors.has(s.ctx, sensors.ACCELEROMETER).to_string() + ", started " + started.is_some().to_string());
    return App { ...s, sensors: started };
  }
  let Some(on) = s.sensors else {
    return s;
  };
  let seen = s.seen;
  for r in sensors.event(on, e) {
    if (r.kind == sensors.ACCELEROMETER && seen < 3 && r.values.len() == 3) {
      seen += 1;
      let x = r.values[0];
      let y = r.values[1];
      let z = r.values[2];
      let size = (x * x + y * y + z * z).sqrt();
      log.warn("sensortest: reading " + seen.to_string() + " near gravity " + (size > 8.0f32 && size < 11.6f32).to_string() + " at " + r.ns.to_string());
    }
  }
  if (seen >= 3) {
    sensors.stop(on);
    log.warn("sensortest: stopped");
    android.finish(s.ctx);
    return App { ...s, sensors: None, seen: seen };
  }
  return App { ...s, seen: seen };
}
