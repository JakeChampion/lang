// A NativeActivity app for the emulator check of std/dns and the TLS roots on
// Android. At the first Resume it resolves a public name, which netd answers
// because no hosts file has it, and an IP literal. Then it opens a TLS
// connection that the system roots verify. It logs what it found, and
// finishes.
import "std/android";
import "std/dns";
import "std/log";
import "std/net";
import "std/time";
import "std/tls/client";
import "std/tls/verify";

struct App { done: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last: App = android.run(ctx, App { done: false }, (own s: App, e: android.Event): App => step(ctx, s, e), (s: App): i32 => 0 - 1);
  return 0 as usize;
}

function step(ctx: usize, s: App, e: android.Event): App {
  match (e) {
    android.Resume => {
      if (!s.done) {
        report("dns.google");
        report("192.0.2.7");
        tls_check("dns.google");
        android.finish(ctx);
      }
      return App { done: true };
    },
    _ => {
      return s;
    }
  }
}

function report(name: string): void {
  match (dns.resolve(name)) {
    Ok(addrs) => {
      let parts: string[] = [];
      for a in addrs {
        parts = parts.append(a.to_string());
      }
      log.warn("dnstest: " + name + " has " + addrs.len().to_string() + " addresses: " + parts.join(" "));
    },
    Err(e) => {
      log.warn("dnstest: " + name + " failed: " + e.message());
    }
  }
}

function tls_check(host: string): void {
  let Some(roots) = verify.system_roots() else {
    log.warn("dnstest: no system roots");
    return;
  };
  match (client.connect(host, 443, client.config(host, roots), time.duration_seconds(10 as i64))) {
    Ok(c) => {
      let closed = c.close();
      log.warn("dnstest: tls to " + host + " verified with " + roots.certs.len().to_string() + " system roots");
    },
    Err(e) => {
      log.warn("dnstest: tls to " + host + " failed: " + e.message());
    }
  }
}
