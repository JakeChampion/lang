// This fixture owns AAudio transport while the lower-level controller owns video.
import "std/android/audio";
import "./audio_pcm";
import "std/audio/pcm";
import "std/audio/mp4/time";
import "std/video/frame";
import "std/video/playback_clock";
import "std/option";

pub struct State { music: audio.Music, samples: i32[], at: i32, first: i32, origin: playback_clock.AudioOrigin, started_ns: i64, paused_ns: Option[i64], failed: boolean, base: i32, total: i32, source: Option[audio_pcm.Stream], path: string, peak: i32 }

function take_source(own state: State): (State, Option[audio_pcm.Stream]) {
  let State { music, samples, at, first, origin, started_ns, paused_ns, failed, base, total, source, path, peak } = state;
  return (State { music: music, samples: samples, at: at, first: first, origin: origin, started_ns: started_ns, paused_ns: paused_ns, failed: failed, base: base, total: total, source: None, path: path, peak: peak }, source);
}

function fill(own state: State, seek: (i64) => Result[i64, IoError], read: (i32) => Result[u8[], IoError]): State {
  let (rest, source) = take_source(state);
  let Some(stream) = source else {
    return State { ...rest, failed: true };
  };
  let (next, event) = match (stream.step_with(seek, read)) { Ok(value) => value, Err(_) => { return State { ...rest, failed: true }; } };
  let kept = State { ...rest, source: Some(next) };
  match (event) {
    audio_pcm.StreamPending => {
      return kept;
    },
    audio_pcm.StreamFinished => {
      return State { ...kept, failed: kept.at != kept.total };
    },
    audio_pcm.StreamSamples(block) => {
      if (block.samples.len() == 0 || block.samples.len() > 2048) {
        return State { ...kept, failed: true };
      }
      return State { ...kept, samples: block.samples, base: kept.at, peak: kept.peak.max(block.samples.len()) };
    }
  }
}

function write(own state: State): State {
  let offset = state.at - state.base;
  let end = (offset + 2048).min(state.samples.len());
  let wrote = state.music.write(state.samples[offset:end], 0);
  if (wrote < 0 || wrote > end - offset || wrote % 2 != 0) {
    return State { ...state, failed: true };
  }
  return State { ...state, at: state.at + wrote };
}

pub function pump(own state: State): State {
  if (state.failed || state.paused_ns.is_some() || state.at == state.total) {
    return state;
  }
  return write(state);
}

pub function pump_with(own state: State, seek: (i64) => Result[i64, IoError], read: (i32) => Result[u8[], IoError]): State {
  if (state.failed || state.paused_ns.is_some() || state.at == state.total) {
    return state;
  }
  for work in 0..8 {
    if (state.at - state.base < state.samples.len()) {
      return write(state);
    }
    state = fill(state, seek, read);
    if (state.failed) {
      return state;
    }
  }
  if (state.at - state.base < state.samples.len()) {
    return write(state);
  }
  return state;
}

pub function pump_stream(own state: State, reader: Reader): State {
  return pump_with(state, (offset: i64): Result[i64, IoError] => reader.seek(offset, 0), (count: i32): Result[u8[], IoError] => reader.read_chunk_bytes(count));
}

function primed(own state: State, seek: (i64) => Result[i64, IoError], read: (i32) => Result[u8[], IoError]): Result[State, frame.VideoError] {
  let next = state;
  for work in 0..16384 {
    next = pump_with(next, seek, read);
    if (next.failed) {
      next.close();
      return Err(frame.Platform);
    }
    if (next.samples.len() > 0) {
      if (!next.music.start()) {
        next.close();
        return Err(frame.Platform);
      }
      return Ok(State { ...next, started_ns: monotonic_ns() });
    }
  }
  next.close();
  return Err(frame.Limit);
}

pub function create_with(own stream: audio_pcm.Stream, seek: (i64) => Result[i64, IoError], read: (i32) => Result[u8[], IoError], path: string): Result[State, frame.VideoError] {
  let total = stream.info().frames as i32 * 2;
  let first = stream.first;
  let music = match (open_music()) {
    Ok(value) => value,
    Err(error) => { return Err(error); },
  };
  let state = State { music: music, samples: [], at: first, first: first, origin: playback_clock.AudioOrigin { frame_position: 0i64, media_us: first as i64 * 1000000i64 / 96000i64 }, started_ns: 0i64, paused_ns: None, failed: false, base: first, total: total, source: Some(stream), path: path, peak: 0 };
  return primed(state, seek, read);
}

pub function create_stream(own stream: audio_pcm.Stream, reader: Reader, path: string): Result[State, frame.VideoError] {
  return create_with(stream, (offset: i64): Result[i64, IoError] => reader.seek(offset, 0), (count: i32): Result[u8[], IoError] => reader.read_chunk_bytes(count), path);
}

function block_ok(block: pcm.Block): boolean {
  return block.format == pcm.Format { sample_rate: 48000, channels: 2, bits_per_sample: 16 } && block.samples.len() > 0 && block.samples.len() <= 48000 && block.samples.len() % 2 == 0;
}

function open_music(): Result[audio.Music, frame.VideoError] {
  let music = audio.music(48000, 2);
  if (music.ptr == 0 as usize || music.rate != 48000 || music.channels != 2) {
    music.close();
    return Err(frame.Unsupported);
  }
  return Ok(music);
}

pub function create(block: pcm.Block, media_us: i64): Result[State, frame.VideoError] {
  if (!block_ok(block) || media_us < 0i64) {
    return Err(frame.Header);
  }
  let first = match (time.rescale(media_us, 48000u32, 1000000u32)) { Ok(value) => value, Err(_) => { return Err(frame.Limit); } };
  if (first >= (block.samples.len() / 2) as i64) {
    return Err(frame.Header);
  }
  let music = open_music()?;
  let state = pump(State { music: music, samples: block.samples, at: first as i32 * 2, first: first as i32 * 2, origin: playback_clock.AudioOrigin { frame_position: 0i64, media_us: first * 1000000i64 / 48000i64 }, started_ns: 0i64, paused_ns: None, failed: false, base: 0, total: block.samples.len(), source: None, path: "", peak: block.samples.len() });
  if (state.failed || !music.start()) {
    music.close();
    return Err(frame.Platform);
  }
  return Ok(State { ...state, started_ns: monotonic_ns() });
}

pub function (state: State) ready(now_ns: i64): boolean {
  let frames = (state.total - state.first) / 2;
  let duration = frames as i64 * 1000000000i64 / 48000i64;
  return !state.failed && state.paused_ns.is_none() && state.at == state.total && now_ns - state.started_ns >= duration + 100000000i64;
}

pub function (own state: State) pause(now_ns: i64): State {
  if (state.paused_ns.is_none()) {
    state.music.pause();
    return State { ...state, paused_ns: Some(now_ns) };
  }
  return state;
}

pub function (own state: State) resume(now_ns: i64): State {
  let Some(paused) = state.paused_ns else {
    return state;
  };
  if (now_ns < paused || !state.music.start()) {
    return State { ...state, failed: true };
  }
  return State { ...state, started_ns: state.started_ns + now_ns - paused, paused_ns: None };
}

pub function (state: State) close(): void {
  state.music.pause();
  state.music.close();
}
