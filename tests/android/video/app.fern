// This app verifies real Android codecs, MP4 export, surface playback, and seek.
import "std/android";
import "std/android/video/player";
import "std/android/video/source";
import "std/android/video/capabilities";
import "std/video/frame";
import "std/log";
import "./roundtrip";
import "./audio_pcm";
import "./audio_path";
import "./content_read";
import "./audio_content";

pub struct App { ctx: usize, playback: Option[player.Player], fd: i32, content: Option[source.Source], sound: Option[audio_path.State], audio_reader: Option[Reader], content_audio: Option[audio_content.Input], stage: i32, resume_ns: i64, started_ns: i64, done: boolean, lifecycle_pause_ns: Option[i64], lifecycle_was_playing: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last = android.run(ctx, App { ctx: ctx, playback: None, fd: -1, content: None, sound: None, audio_reader: None, content_audio: None, stage: 0, resume_ns: 0i64, started_ns: monotonic_ns(), done: false, lifecycle_pause_ns: None, lifecycle_was_playing: false }, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => 5);
  let _ = cleanup(last);
  return 0 as usize;
}

function cleanup(own s: App): App {
  s = finish_sound(s);
  match (s.playback) {
    Some(p) => {
      let _ = p.close();
    },
    None => {}
  }
  match (s.content) {
    Some(src) => {
      let _ = src.close();
    },
    None => {}
  }
  if (s.fd >= 0) {
    roundtrip.close_file(s.fd);
  }
  return App { ...s, playback: None, fd: -1, content: None, sound: None };
}

function fail(own s: App, error: frame.VideoError): App {
  log.warn("videotest: FAIL " + error.message());
  return App { ...cleanup(s), done: true };
}

function start(own s: App, window: android.Window): App {
  let base = android.data_dir(s.ctx);
  let env = android.env(s.ctx);
  let api = android.sdk_version(s.ctx);
  log.warn("videotest: sdk=" + api.to_string() + " directory=" + base);
  let path = android.intent_extra(s.ctx, "av_path");
  if (path != "") {
    return start_av(s, window, path);
  }
  let av_uri = android.intent_extra(s.ctx, "av_uri");
  if (av_uri != "") {
    return start_content(s, window, av_uri, true);
  }
  let uri = android.intent_extra(s.ctx, "uri");
  if (uri != "") {
    return start_content(s, window, uri, false);
  }
  match (roundtrip.export_file(env, api, base + "/byte.mp4", false)) {
    Err(e) => {
      return fail(s, e);
    },
    _ => {}
  }
  match (roundtrip.export_file(env, api, base + "/surface.mp4", true)) {
    Err(e) => {
      return fail(s, e);
    },
    _ => {}
  }
  return start_file(s, window, base + "/byte.mp4");
}

function start_file(own s: App, window: android.Window, path: string): App {
  let env = android.env(s.ctx);
  let api = android.sdk_version(s.ctx);
  let fd = match (roundtrip.open_file(path, false)) { Ok(value) => value, Err(e) => { return fail(s, e); } };
  let p = match (player.open(env, api, fd, 0i64, roundtrip.length(fd), window.ptr, capabilities.PreferHardware, frame.default_limits())) {
    Ok(value) => value, Err(e) => { roundtrip.close_file(fd); return fail(s, e); },
  };
  log.warn("videotest: decoder name=" + p.info.name + " implementation=" + p.info.implementation.to_debug());
  return App { ...s, playback: Some(p), fd: fd, started_ns: monotonic_ns() };
}

function start_sound(own s: App, own stream: audio_pcm.Stream, own reader: Reader, path: string): App {
  let sound = match (audio_path.create_stream(stream, reader, path)) {
    Ok(value) => value,
    Err(error) => { let _ = reader.close(); return fail(s, error); },
  };
  return App { ...s, sound: Some(sound), audio_reader: Some(reader) };
}

function start_av(own s: App, window: android.Window, path: string): App {
  let (stream, reader) = match (audio_pcm.open(path, 0i64)) { Ok(value) => value, Err(error) => { return fail(s, error); } };
  let frames = stream.info().frames;
  let opened = start_file(s, window, path);
  if (opened.done) {
    let _ = reader.close();
    return opened;
  }
  log.warn("videotest: native AAC frames=" + frames.to_string() + " rate=48000 channels=2");
  return start_sound(opened, stream, reader, path);
}

function start_content(own s: App, window: android.Window, uri: string, native_audio: boolean): App {
  let env = android.env(s.ctx);
  let src = match (source.open(env, android.activity_object(s.ctx), uri, 1000000000i64)) {
    Ok(value) => value,
    Err(e) => { return fail(s, e); },
  };
  let checked = match (content_read.inspect(src)) {
    Ok(value) => value,
    Err(e) => { let _ = src.close(); return fail(s, e); },
  };
  log.warn("videotest: native content bytes=" + checked.bytes.to_string() + " sha256=" + checked.digest);
  let p = match (player.open(env, android.sdk_version(s.ctx), src.fd, src.offset, src.length, window.ptr, capabilities.PreferHardware, frame.default_limits())) {
    Ok(value) => value,
    Err(e) => { let _ = src.close(); return fail(s, e); },
  };
  log.warn("videotest: source=content offset=" + src.offset.to_string() + " length=" + src.length.to_string());
  log.warn("videotest: decoder name=" + p.info.name + " implementation=" + p.info.implementation.to_debug());
  let opened = App { ...s, playback: Some(p), content: Some(src), started_ns: monotonic_ns() };
  return if (native_audio) { start_content_sound(opened, src, 0i64) } else { opened };
}

function start_content_sound(own s: App, src: source.Source, media_us: i64): App {
  let (stream, io) = match (audio_content.open(src, media_us)) { Ok(value) => value, Err(error) => { return fail(s, error); } };
  let frames = stream.info().frames;
  let sound = match (audio_path.create_with(stream, io.seek, io.read, "")) { Ok(value) => value, Err(error) => { return fail(s, error); } };
  if (media_us == 0i64) {
    log.warn("videotest: native AAC frames=" + frames.to_string() + " rate=48000 channels=2");
    log.warn("videotest: native AV source=content");
  }
  return App { ...s, sound: Some(sound), content_audio: Some(io) };
}

function take_sound(own s: App): own (App, Option[audio_path.State]) {
  let sound = s.sound;
  return (App { ...s, sound: None }, sound);
}

pub function pause_sound(own s: App, now: i64): App {
  let (rest, source) = take_sound(s);
  if let Some(sound) = source {
    return App { ...rest, sound: Some(sound.pause(now)) };
  }
  return rest;
}

pub function resume_sound(own s: App, now: i64): App {
  let (rest, source) = take_sound(s);
  if let Some(sound) = source {
    let resumed = sound.resume(now);
    if (resumed.failed) {
      return fail(App { ...rest, sound: Some(resumed) }, frame.Platform);
    }
    return App { ...rest, sound: Some(resumed) };
  }
  return rest;
}

pub function pump_sound(own s: App): App {
  if (s.lifecycle_pause_ns.is_some()) {
    return s;
  }
  if let Some(p) = s.playback {
    if (p.paused) {
      return s;
    }
  }
  let (rest, source) = take_sound(s);
  if let Some(sound) = source {
    if let Some(io) = rest.content_audio {
      let next = audio_path.pump_with(sound, io.seek, io.read);
      return accept_sound(rest, next);
    }
    let Some(reader) = rest.audio_reader else {
      return fail(App { ...rest, sound: Some(sound) }, frame.Platform);
    };
    let next = audio_path.pump_stream(sound, reader);
    return accept_sound(rest, next);
  }
  return rest;
}

function accept_sound(own s: App, own sound: audio_path.State): App {
  if (sound.failed) {
    return fail(App { ...s, sound: Some(sound) }, frame.Platform);
  }
  return App { ...s, sound: Some(sound) };
}

function anchor(s: App, own p: player.Player): player.Tick {
  if let Some(sound) = s.sound {
    if (!p.output_eos && !p.paused) {
      return p.synchronize_music(sound.music, sound.origin);
    }
  }
  return player.Tick { player: p, event: player.Idle };
}

function seek_sound(own s: App, target_us: i64): App {
  let Some(sound) = s.sound else {
    return s;
  };
  let path = sound.path.to_owned();
  s = finish_sound(s);
  if let Some(src) = s.content {
    return start_content_sound(s, src, target_us);
  }
  let (stream, reader) = match (audio_pcm.open(path, target_us)) { Ok(value) => value, Err(error) => { return fail(s, error); } };
  return start_sound(s, stream, reader, path);
}

function report_sound(sound: audio_path.State): void {
  if (sound.source.is_some()) {
    log.warn("videotest: native AV cursor peak_samples=" + sound.peak.to_string());
  }
  log.warn("videotest: native AV submitted_frames=" + ((sound.at - sound.first) / 2).to_string() + " origin_us=" + sound.origin.media_us.to_string());
  match (sound.music.timestamp()) {
    Some(stamp) => {
      log.warn("videotest: native AV timestamp frames=" + stamp.frame_position.to_string() + " monotonic_ns=" + stamp.monotonic_ns.to_string());
    },
    None => {
      log.warn("videotest: native AV timestamp unavailable");
    }
  }
}

function finish_sound(own s: App): App {
  if let Some(sound) = s.sound {
    sound.close();
  }
  if let Some(reader) = s.audio_reader {
    let _ = reader.close();
  }
  return App { ...s, sound: None, audio_reader: None, content_audio: None };
}

function pause_and_replace(own s: App, own p: player.Player, now: i64): App {
  s = pause_sound(s, now);
  let window = p.window;
  let paused = p.pause(now);
  let replaced = paused.player.replace_surface(window);
  if let player.Failure(error) = replaced.event {
    return fail(App { ...s, playback: Some(replaced.player) }, error);
  }
  log.warn("videotest: same surface accepted while paused");
  return App { ...s, playback: Some(replaced.player), stage: 1, resume_ns: now + 100000000i64 };
}

function tick_at(own s: App, now: i64): App {
  if (s.done || s.lifecycle_pause_ns.is_some()) {
    return s;
  }
  let Some(borrowed) = s.playback else {
    return s;
  };
  let p = player.Player { ...borrowed };
  s = pump_sound(s);
  if (s.done) {
    return s;
  }
  if (now - s.started_ns > 20000000000i64) {
    return fail(s, frame.Platform);
  }
  if (s.stage == 0 && p.scheduled_frames >= 3i64) {
    return pause_and_replace(s, player.Player { ...p }, now);
  }
  if (s.stage == 1) {
    return after_pause(s, player.Player { ...p }, now);
  }
  return advance(s, player.Player { ...p }, now);
}

function after_pause(own s: App, own p: player.Player, now: i64): App {
  if (now < s.resume_ns) {
    return s;
  }
  s = resume_sound(s, now);
  if (s.done) {
    return s;
  }
  let resumed = p.resume(now);
  return App { ...s, playback: Some(resumed.player), stage: 2 };
}

function advance(own s: App, own p: player.Player, now: i64): App {
  let anchored = anchor(s, p);
  if let player.Failure(error) = anchored.event {
    return fail(App { ...s, playback: Some(anchored.player) }, error);
  }
  let next = anchored.player.tick(now);
  s = App { ...s, playback: Some(next.player) };
  match (next.event) {
    player.Failure(e) => {
      return fail(s, e);
    },
    player.End => {
      return ended(s, player.Player { ...next.player });
    },
    _ => {
      return s;
    }
  }
}

function ended(own s: App, own p: player.Player): App {
  if let Some(sound) = s.sound {
    if (!sound.ready(monotonic_ns())) {
      return s;
    }
    report_sound(sound);
  }
  if (s.stage < 2 || p.scheduled_frames == 0i64) {
    return fail(s, frame.Header);
  }
  if (s.stage == 2) {
    if (p.scheduled_frames + p.dropped_frames != 12i64) {
      return fail(s, frame.Header);
    }
    let seek = p.seek(100000i64);
    match (seek.event) {
      player.Failure(e) => {
        return fail(App { ...s, playback: Some(seek.player) }, e);
      },
      _ => {}
    }
    return seek_sound(App { ...s, playback: Some(seek.player), stage: 3 }, 100000i64);
  }
  if (p.scheduled_frames + p.dropped_frames != 24i64) {
    return fail(s, frame.Header);
  }
  log.warn("videotest: playback frames=" + p.scheduled_frames.to_string() + " dropped=" + p.dropped_frames.to_string() + " elapsed_ns=" + (monotonic_ns() - s.started_ns).to_string());
  log.warn("videotest: roundtrip complete");
  return finish_sound(App { ...s, done: true });
}

function step(own s: App, e: android.Event): App {
  return step_at(s, e, monotonic_ns());
}

pub function step_at(own s: App, e: android.Event, now: i64): App {
  match (e) {
    android.WindowCreated(w) => {
      if (!s.done) {
        return window_started_at(start(s, w), now);
      }
      return s;
    },
    android.WindowDestroyed(_) => {
      return App { ...cleanup(s), stage: 0, resume_ns: 0i64, lifecycle_was_playing: false };
    },
    android.Tick => {
      return tick_at(s, now);
    },
    android.Pause => {
      return pause_lifecycle(s, now);
    },
    android.Resume => {
      return resume_lifecycle(s, now);
    },
    _ => {
      return s;
    }
  }
}

// The window callback and host controls share this state transition after setup.
pub function window_started_at(own s: App, now: i64): App {
  if (s.done) {
    return s;
  }
  let paused = s.lifecycle_pause_ns.is_some();
  s = App { ...s, stage: 0, resume_ns: 0i64, started_ns: now, lifecycle_pause_ns: None, lifecycle_was_playing: false };
  if (paused) {
    return pause_lifecycle(s, now);
  }
  return s;
}

function pause_lifecycle(own s: App, now: i64): App {
  if (s.done || s.lifecycle_pause_ns.is_some()) {
    return s;
  }
  let playing = was_playing(s);
  return pause_playback(App { ...s, lifecycle_pause_ns: Some(now), lifecycle_was_playing: playing }, now);
}

function resume_lifecycle(own s: App, now: i64): App {
  let Some(at) = s.lifecycle_pause_ns else {
    return s;
  };
  let elapsed = (now - at).max(0i64);
  let playing = s.lifecycle_was_playing;
  let deadline = if (s.stage == 1) { s.resume_ns + elapsed } else { s.resume_ns };
  s = App { ...s, lifecycle_pause_ns: None, lifecycle_was_playing: false, started_ns: s.started_ns + elapsed, resume_ns: deadline };
  if (!playing) {
    return s;
  }
  return resume_playback(s, now);
}

function was_playing(s: App): boolean {
  if let Some(p) = s.playback {
    return !p.paused;
  }
  if let Some(sound) = s.sound {
    return sound.paused_ns.is_none();
  }
  return false;
}

function pause_playback(own s: App, now: i64): App {
  s = pause_sound(s, now);
  if let Some(p) = s.playback {
    let result = player.Player { ...p }.pause(now);
    return App { ...s, playback: Some(result.player) };
  }
  return s;
}

function resume_playback(own s: App, now: i64): App {
  s = resume_sound(s, now);
  if (s.done) {
    return s;
  }
  if let Some(p) = s.playback {
    let result = player.Player { ...p }.resume(now);
    return App { ...s, playback: Some(result.player) };
  }
  return s;
}
