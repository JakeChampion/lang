// This app verifies real Android codecs, MP4 export, surface playback, and seek.
import "std/android";
import "std/android/video/player";
import "std/android/video/source";
import "std/android/video/capabilities";
import "std/video/frame";
import "std/log";
import "./roundtrip";
import "./audio_pcm";
import "./audio_path";

struct App { ctx: usize, playback: Option[player.Player], fd: i32, content: Option[source.Source], sound: Option[audio_path.State], stage: i32, resume_ns: i64, started_ns: i64, done: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  android.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last = android.run(ctx, App { ctx: ctx, playback: None, fd: -1, content: None, sound: None, stage: 0, resume_ns: 0i64, started_ns: monotonic_ns(), done: false }, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => 5);
  let _ = cleanup(last);
  return 0 as usize;
}

function cleanup(own s: App): App {
  if let Some(sound) = s.sound {
    sound.close();
  }
  match (s.playback) {
    Some(p) => {
      let _ = p.close();
    },
    None => {}
  }
  match (s.content) {
    Some(src) => {
      let _ = src.close();
    },
    None => {}
  }
  if (s.fd >= 0) {
    roundtrip.close_file(s.fd);
  }
  return App { ...s, playback: None, fd: -1, content: None, sound: None };
}

function fail(own s: App, error: frame.VideoError): App {
  log.warn("videotest: FAIL " + error.message());
  return App { ...cleanup(s), done: true };
}

function start(own s: App, window: android.Window): App {
  let base = android.data_dir(s.ctx);
  let env = android.env(s.ctx);
  let api = android.sdk_version(s.ctx);
  log.warn("videotest: sdk=" + api.to_string() + " directory=" + base);
  let path = android.intent_extra(s.ctx, "av_path");
  if (path != "") {
    return start_av(s, window, path);
  }
  let uri = android.intent_extra(s.ctx, "uri");
  if (uri != "") {
    return start_content(s, window, uri);
  }
  match (roundtrip.export_file(env, api, base + "/byte.mp4", false)) {
    Err(e) => {
      return fail(s, e);
    },
    _ => {}
  }
  match (roundtrip.export_file(env, api, base + "/surface.mp4", true)) {
    Err(e) => {
      return fail(s, e);
    },
    _ => {}
  }
  return start_file(s, window, base + "/byte.mp4");
}

function start_file(own s: App, window: android.Window, path: string): App {
  let env = android.env(s.ctx);
  let api = android.sdk_version(s.ctx);
  let fd = match (roundtrip.open_file(path, false)) { Ok(value) => value, Err(e) => { return fail(s, e); } };
  let p = match (player.open(env, api, fd, 0i64, roundtrip.length(fd), window.ptr, capabilities.PreferHardware, frame.default_limits())) {
    Ok(value) => value, Err(e) => { roundtrip.close_file(fd); return fail(s, e); },
  };
  log.warn("videotest: decoder name=" + p.info.name + " implementation=" + p.info.implementation.to_debug());
  return App { ...s, playback: Some(p), fd: fd, started_ns: monotonic_ns() };
}

function start_av(own s: App, window: android.Window, path: string): App {
  let block = match (audio_pcm.read(path)) { Ok(value) => value, Err(error) => { return fail(s, error); } };
  let opened = start_file(s, window, path);
  if (opened.done) {
    return opened;
  }
  let sound = match (audio_path.create(block, 0i64)) { Ok(value) => value, Err(error) => { return fail(opened, error); } };
  log.warn("videotest: native AAC frames=" + (sound.samples.len() / 2).to_string() + " rate=48000 channels=2");
  return App { ...opened, sound: Some(sound) };
}

function start_content(own s: App, window: android.Window, uri: string): App {
  let env = android.env(s.ctx);
  let src = match (source.open(env, android.activity_object(s.ctx), uri, 1000000000i64)) {
    Ok(value) => value,
    Err(e) => { return fail(s, e); },
  };
  let p = match (player.open(env, android.sdk_version(s.ctx), src.fd, src.offset, src.length, window.ptr, capabilities.PreferHardware, frame.default_limits())) {
    Ok(value) => value,
    Err(e) => { let _ = src.close(); return fail(s, e); },
  };
  log.warn("videotest: source=content offset=" + src.offset.to_string() + " length=" + src.length.to_string());
  log.warn("videotest: decoder name=" + p.info.name + " implementation=" + p.info.implementation.to_debug());
  return App { ...s, playback: Some(p), content: Some(src), started_ns: monotonic_ns() };
}

function pause_sound(own s: App, now: i64): App {
  if let Some(sound) = s.sound {
    return App { ...s, sound: Some(audio_path.State { ...sound }.pause(now)) };
  }
  return s;
}

function resume_sound(own s: App, now: i64): App {
  if let Some(sound) = s.sound {
    let resumed = audio_path.State { ...sound }.resume(now);
    s = App { ...s, sound: Some(resumed) };
    if (resumed.failed) {
      return fail(s, frame.Platform);
    }
  }
  return s;
}

function pump_sound(own s: App): App {
  if let Some(p) = s.playback {
    if (p.paused) {
      return s;
    }
  }
  if let Some(sound) = s.sound {
    let next = audio_path.pump(audio_path.State { ...sound });
    s = App { ...s, sound: Some(next) };
    if (next.failed) {
      return fail(s, frame.Platform);
    }
  }
  return s;
}

function anchor(s: App, own p: player.Player): player.Tick {
  if let Some(sound) = s.sound {
    if (!p.output_eos && !p.paused) {
      return p.synchronize_music(sound.music, sound.origin);
    }
  }
  return player.Tick { player: p, event: player.Idle };
}

function seek_sound(own s: App, target_us: i64): App {
  let Some(sound) = s.sound else {
    return s;
  };
  let block = sound.block();
  sound.close();
  s = App { ...s, sound: None };
  let next = match (audio_path.create(block, target_us)) { Ok(value) => value, Err(error) => { return fail(s, error); } };
  return App { ...s, sound: Some(next) };
}

function report_sound(sound: audio_path.State): void {
  log.warn("videotest: native AV submitted_frames=" + ((sound.at - sound.first) / 2).to_string() + " origin_us=" + sound.origin.media_us.to_string());
  match (sound.music.timestamp()) {
    Some(stamp) => {
      log.warn("videotest: native AV timestamp frames=" + stamp.frame_position.to_string() + " monotonic_ns=" + stamp.monotonic_ns.to_string());
    },
    None => {
      log.warn("videotest: native AV timestamp unavailable");
    }
  }
}

function finish_sound(own s: App): App {
  if let Some(sound) = s.sound {
    sound.close();
  }
  return App { ...s, sound: None };
}

function pause_and_replace(own s: App, own p: player.Player, now: i64): App {
  s = pause_sound(s, now);
  let window = p.window;
  let paused = p.pause(now);
  let replaced = paused.player.replace_surface(window);
  if let player.Failure(error) = replaced.event {
    return fail(App { ...s, playback: Some(replaced.player) }, error);
  }
  log.warn("videotest: same surface accepted while paused");
  return App { ...s, playback: Some(replaced.player), stage: 1, resume_ns: now + 100000000i64 };
}

function tick(own s: App): App {
  if (s.done) {
    return s;
  }
  let Some(borrowed) = s.playback else {
    return s;
  };
  let p = player.Player { ...borrowed };
  let now = monotonic_ns();
  s = pump_sound(s);
  if (s.done) {
    return s;
  }
  if (now - s.started_ns > 20000000000i64) {
    return fail(s, frame.Platform);
  }
  if (s.stage == 0 && p.scheduled_frames >= 3i64) {
    return pause_and_replace(s, player.Player { ...p }, now);
  }
  if (s.stage == 1) {
    return after_pause(s, player.Player { ...p }, now);
  }
  return advance(s, player.Player { ...p }, now);
}

function after_pause(own s: App, own p: player.Player, now: i64): App {
  if (now < s.resume_ns) {
    return s;
  }
  s = resume_sound(s, now);
  if (s.done) {
    return s;
  }
  let resumed = p.resume(now);
  return App { ...s, playback: Some(resumed.player), stage: 2 };
}

function advance(own s: App, own p: player.Player, now: i64): App {
  let anchored = anchor(s, p);
  if let player.Failure(error) = anchored.event {
    return fail(App { ...s, playback: Some(anchored.player) }, error);
  }
  let next = anchored.player.tick(now);
  s = App { ...s, playback: Some(next.player) };
  match (next.event) {
    player.Failure(e) => {
      return fail(s, e);
    },
    player.End => {
      return ended(s, player.Player { ...next.player });
    },
    _ => {
      return s;
    }
  }
}

function ended(own s: App, own p: player.Player): App {
  if let Some(sound) = s.sound {
    if (!sound.ready(monotonic_ns())) {
      return s;
    }
    report_sound(sound);
  }
  if (s.stage < 2 || p.scheduled_frames == 0i64) {
    return fail(s, frame.Header);
  }
  if (s.stage == 2) {
    if (p.scheduled_frames + p.dropped_frames != 12i64) {
      return fail(s, frame.Header);
    }
    let seek = p.seek(100000i64);
    match (seek.event) {
      player.Failure(e) => {
        return fail(App { ...s, playback: Some(seek.player) }, e);
      },
      _ => {}
    }
    return seek_sound(App { ...s, playback: Some(seek.player), stage: 3 }, 100000i64);
  }
  if (p.scheduled_frames + p.dropped_frames != 24i64) {
    return fail(s, frame.Header);
  }
  log.warn("videotest: playback frames=" + p.scheduled_frames.to_string() + " dropped=" + p.dropped_frames.to_string() + " elapsed_ns=" + (monotonic_ns() - s.started_ns).to_string());
  log.warn("videotest: roundtrip complete");
  return finish_sound(App { ...s, done: true });
}

function step(own s: App, e: android.Event): App {
  match (e) {
    android.WindowCreated(w) => {
      if (!s.done) {
        return start(s, w);
      }
      return s;
    },
    android.WindowDestroyed(_) => {
      return cleanup(s);
    },
    android.Tick => {
      return tick(s);
    },
    android.Pause => {
      return pause_playback(s, monotonic_ns());
    },
    android.Resume => {
      return resume_playback(s, monotonic_ns());
    },
    _ => {
      return s;
    }
  }
}

function pause_playback(own s: App, now: i64): App {
  s = pause_sound(s, now);
  if let Some(p) = s.playback {
    let result = player.Player { ...p }.pause(now);
    return App { ...s, playback: Some(result.player) };
  }
  return s;
}

function resume_playback(own s: App, now: i64): App {
  s = resume_sound(s, now);
  if (s.done) {
    return s;
  }
  if let Some(p) = s.playback {
    let result = player.Player { ...p }.resume(now);
    return App { ...s, playback: Some(result.player) };
  }
  return s;
}
