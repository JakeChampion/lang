// Prepare bounded stereo PCM for the native AAC and lower-level video fixture.
import "std/audio/mp4";
import "std/audio/pcm";
import "std/audio/mp4/file";
import "std/audio/mp4/cursor";
import "std/audio/mp4/time";
import "std/audio/source";
import "std/video/frame";
import "std/io";

pub const MAX_INPUT: i32 = 2097152;

pub const MAX_SAMPLES: i32 = 48000;

function error(value: pcm.AudioError): frame.VideoError {
  return match (value) { pcm.Limit => frame.Limit, pcm.Unsupported => frame.Unsupported, pcm.Truncated => frame.Truncated, _ => frame.Header };
}

pub function decode(input: [u8]): Result[pcm.Block, frame.VideoError] {
  let base = mp4.default_limits();
  let budget = pcm.Limits { max_input_bytes: MAX_INPUT, max_samples: MAX_SAMPLES };
  let limits = mp4.Limits { ...base, audio: budget, max_tracks: 2, max_packets: 128, max_descriptions: 1, max_edits: 4 };
  let audio = match (mp4.decode(input, limits)) { Ok(value) => value, Err(value) => { return Err(error(value)); } };
  if (audio.sample_rate != 48000 || audio.channels != 2 || audio.frames <= 0i64) {
    return Err(frame.Unsupported);
  }
  return match (pcm.quantize(audio.samples, pcm.Format { sample_rate: audio.sample_rate, channels: audio.channels, bits_per_sample: 16 }, budget)) { Ok(value) => Ok(value), Err(value) => Err(error(value)) };
}

pub function read(path: string): Result[pcm.Block, frame.VideoError] {
  let Ok(reader) = open_reader(path) else {
    return Err(frame.Platform);
  };
  let result = read_from(reader);
  let _ = reader.close();
  return result;
}

function read_from(reader: Reader): Result[pcm.Block, frame.VideoError] {
  let bytes: u8[] = [];
  while (true) {
    let Ok(chunk) = reader.read_chunk_bytes(4096) else {
      return Err(frame.Platform);
    };
    if (chunk.len() == 0) {
      return decode(bytes);
    }
    if (chunk.len() > MAX_INPUT - bytes.len()) {
      return Err(frame.Limit);
    }
    for byte in chunk {
      bytes = bytes.append(byte);
    }
  }
  return Err(frame.Truncated);
}

pub struct Stream { decoder: cursor.Cursor, samples: f32[], first: i32, info: cursor.Info }

pub enum StreamEvent { StreamPending, StreamSamples(pcm.Block), StreamFinished }

function read_error(value: source.ReadError): frame.VideoError {
  return match (value) { source.ReadAudio(value) => error(value), source.ReadSize => frame.Limit, _ => frame.Platform };
}

function file_limits(): file.Limits {
  let base = file.default_limits();
  let index = mp4.Limits { ...base.index, audio: pcm.Limits { max_input_bytes: MAX_INPUT, max_samples: MAX_SAMPLES }, max_tracks: 2, max_packets: 128, max_descriptions: 1, max_edits: 4 };
  return file.Limits { ...base, index: index, input: source.Limits { chunk_size: 4096, max_buffer_bytes: MAX_INPUT }, max_file_bytes: MAX_INPUT as i64, max_metadata_bytes: MAX_INPUT };
}

function selected(index: mp4.Index): Result[i32, frame.VideoError] {
  for i in 0..index.tracks.len() {
    if (index.tracks[i].enabled) {
      return Ok(i);
    }
  }
  return Err(frame.Header);
}

function positioned(own decoder: cursor.Cursor, media_us: i64): Result[(cursor.Cursor, i32), frame.VideoError] {
  let info = decoder.info();
  if (info.sample_rate != 48000 || info.channels != 2 || info.frames <= 0i64) {
    return Err(frame.Unsupported);
  }
  let first = match (time.rescale(media_us, 48000u32, 1000000u32)) { Ok(value) => value, Err(_) => { return Err(frame.Limit); } };
  if (first >= info.frames) {
    return Err(frame.Header);
  }
  let sought = match (decoder.seek(first)) { Ok(value) => value, Err(value) => { return Err(read_error(value)); } };
  return Ok((sought, first as i32 * 2));
}

function open_in(bytes: i64, seek: (i64) => Result[i64, IoError], read: (i32) => Result[u8[], IoError], media_us: i64, limits: file.Limits): Result[Stream, frame.VideoError] {
  if (media_us < 0i64) {
    return Err(frame.Header);
  }
  let index = match (file.inspect_with(bytes, seek, read, limits)) { Ok(value) => value, Err(value) => { return Err(read_error(value)); } };
  let number = selected(index)?;
  let decoder = match (cursor.create(index, number, limits)) { Ok(value) => value, Err(value) => { return Err(read_error(value)); } };
  let info = decoder.info();
  let (sought, first) = positioned(decoder, media_us)?;
  return Ok(Stream { decoder: sought, samples: [], first: first, info: info });
}

pub function open_with(bytes: i64, seek: (i64) => Result[i64, IoError], read: (i32) => Result[u8[], IoError], media_us: i64): Result[Stream, frame.VideoError] {
  return open_in(bytes, seek, read, media_us, file_limits());
}

function from_reader(reader: Reader, media_us: i64): Result[Stream, frame.VideoError] {
  if (media_us < 0i64) {
    return Err(frame.Header);
  }
  let bytes = match (reader.seek(0i64, 2)) { Ok(value) => value, Err(_) => { return Err(frame.Platform); } };
  let limits = file_limits();
  return open_in(bytes, (offset: i64): Result[i64, IoError] => reader.seek(offset, 0), (count: i32): Result[u8[], IoError] => reader.read_chunk_bytes(count), media_us, file.Limits { ...limits, max_operations: limits.max_operations - 1 });
}

pub function open(path: string, media_us: i64): Result[(Stream, Reader), frame.VideoError] {
  let Ok(reader) = open_reader(path) else {
    return Err(frame.Platform);
  };
  let stream = match (from_reader(reader, media_us)) {
    Ok(value) => value,
    Err(error) => { let _ = reader.close(); return Err(error); },
  };
  return Ok((stream, reader));
}

pub function (state: Stream) info(): cursor.Info {
  return state.info;
}

function convert(samples: [f32]): Result[pcm.Block, frame.VideoError] {
  let format = pcm.Format { sample_rate: 48000, channels: 2, bits_per_sample: 16 };
  return match (pcm.quantize(samples, format, pcm.Limits { max_input_bytes: MAX_INPUT, max_samples: 2048 })) { Ok(value) => Ok(value), Err(value) => Err(error(value)) };
}

pub function (own state: Stream) step_with(seek: (i64) => Result[i64, IoError], read: (i32) => Result[u8[], IoError]): Result[(Stream, StreamEvent), frame.VideoError] {
  let Stream { decoder, samples, first, info } = state;
  let (next, event) = match (decoder.step_into_with(samples, seek, read)) { Ok(value) => value, Err(value) => { return Err(read_error(value)); } };
  match (event) {
    cursor.BufferPending(buffer) => {
      return Ok((Stream { decoder: next, samples: buffer, first: first, info: info }, StreamPending));
    },
    cursor.BufferFinished(buffer) => {
      return Ok((Stream { decoder: next, samples: buffer, first: first, info: info }, StreamFinished));
    },
    cursor.BufferSamples(block) => {
      let quantized = convert(block.samples[0:block.frames * block.info.channels])?;
      return Ok((Stream { decoder: next, samples: block.samples, first: first, info: info }, StreamSamples(quantized)));
    }
  }
}

pub function (own state: Stream) step(reader: Reader): Result[(Stream, StreamEvent), frame.VideoError] {
  return state.step_with((offset: i64): Result[i64, IoError] => reader.seek(offset, 0), (count: i32): Result[u8[], IoError] => reader.read_chunk_bytes(count));
}
