// A NativeActivity app for the emulator check of the typed JNI bindings
// that tools/jnibind writes (#14737). bindings.fern holds the wrappers of
// the classes in bindings.spec. At the first Resume the app calls a
// wrapper for each kind of member and each kind of result, logs what it
// got, and finishes.
import "std/android";
import "std/android/launch";
import "std/android/attestation";
import "std/android/keystore";
import "std/clock";
import "std/crypto";
import "std/hex";
import "std/jni";
import "std/log";
import "std/option";
import "std/tls/verify";
import "std/tls/x509";
import "./bindings";

struct App { done: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last: App = android.run(ctx, App { done: false }, (own s: App, e: android.Event): App => step(ctx, s, e), (s: App): i32 => -1);
  return 0 as usize;
}

function step(ctx: usize, s: App, e: android.Event): App {
  match (e) {
    android.Resume => {
      if (!s.done) {
        match (check(android.env(ctx), bindings.Activity { ref: android.activity_object(ctx) })) {
          Ok(n) => {
            log.warn("jnibind: done " + n.to_string());
          },
          Err(err) => {
            log.warn("jnibind: failed: " + err.message());
          }
        }
        android.finish(ctx);
      }
      return App { done: true };
    },
    _ => {
      return s;
    }
  }
}

// Calls each kind of wrapper. The result is the number of parts that ran.
function check(e: usize, act: bindings.Activity): Result[i32, jni.JavaError] {
  context_part(e, act)?;
  intent_part(e, act)?;
  object_part(e)?;
  static_part(e)?;
  thrown_part(e)?;
  marks_part(e)?;
  keystore_part(e)?;
  signing_part(e)?;
  return Ok(8);
}

// Methods of an object with a string and a boolean result, and a
// conversion to a parent class.
function context_part(e: usize, act: bindings.Activity): Result[void, jni.JavaError] {
  let activities = bindings.activity_class(e)?;
  let contexts = bindings.context_class(e)?;
  let formats = bindings.date_format_class(e)?;
  let name = activities.get_local_class_name(e, act)?;
  let finishing = activities.is_finishing(e, act)?;
  let package = contexts.get_package_name(e, act.as_context())?;
  let clock = formats.is24_hour_format(e, act.as_context())?;
  log.warn("jnibind: activity " + name + " finishing " + finishing.to_string() + " package " + package + " clock " + (clock || !clock).to_string());
  return Ok(());
}

// A constructor with a string, constants, a method that gives its own
// object, and an object of one class as the argument of another.
function intent_part(e: usize, act: bindings.Activity): Result[void, jni.JavaError] {
  let intents = bindings.intent_class(e)?;
  let contexts = bindings.context_class(e)?;
  let managers = bindings.package_manager_class(e)?;
  let lists = bindings.list_class(e)?;
  let unicode_action = "fern.🌿\x00end";
  let unicode_intent = intents.new(e, unicode_action)?;
  defer jni.delete_local_ref(e, unicode_intent.ref);
  let returned = intents.get_action(e, unicode_intent)?;
  if (returned != unicode_action) {
    return Err(jni.JavaError { text: "Intent.getAction changed the Unicode string" });
  }
  let intent = intents.new(e, bindings.INTENT_ACTION_MAIN)?;
  let same = intents.add_category(e, intent, bindings.INTENT_CATEGORY_LAUNCHER)?;
  let flagged = intents.add_flags(e, intent, bindings.INTENT_FLAG_ACTIVITY_NEW_TASK)?;
  let action = intents.get_action(e, intent)?;
  let flags = intents.get_flags(e, intent)?;
  let pm = contexts.get_package_manager(e, act.as_context())?;
  let found = managers.query_intent_activities(e, pm, intent, 0)?;
  let count = lists.size(e, found)?;
  let first = lists.get(e, found, 0)?;
  log.warn("jnibind: intent " + action + " flags " + flags.to_string() + " launchers " + (count > 0).to_string() + " first " + (!first.is_null()).to_string());
  for ref in [same.ref, flagged.ref, intent.ref, pm.ref, found.ref, first.ref] {
    jni.delete_local_ref(e, ref);
  }
  return Ok(());
}

// Two string arguments, two int arguments, a void method and fields of
// an object.
function object_part(e: usize): Result[void, jni.JavaError] {
  let names = bindings.component_name_class(e)?;
  let points = bindings.point_class(e)?;
  let name = names.new(e, "dev.fern.a", "dev.fern.a.Main")?;
  let short = names.flatten_to_short_string(e, name)?;
  let p = points.new(e, 0, 0)?;
  points.set_x(e, p, 3)?;
  points.set_y(e, p, -4)?;
  points.offset(e, p, 10, 20)?;
  let x = points.x(e, p)?;
  let y = points.y(e, p)?;
  log.warn("jnibind: component " + short + " point " + x.to_string() + " " + y.to_string());
  jni.delete_local_ref(e, name.ref);
  jni.delete_local_ref(e, p.ref);
  return Ok(());
}

// Static methods with a long, an int, a double and a float result, a
// static field, and a constant.
function static_part(e: usize): Result[void, jni.JavaError] {
  let clocks = bindings.system_clock_class(e)?;
  let integers = bindings.integer_class(e)?;
  let maths = bindings.math_class(e)?;
  let floats = bindings.float_class(e)?;
  let systems = bindings.system_class(e)?;
  let up = clocks.uptime_millis(e)?;
  let n = integers.parse_int(e, "-12345")?;
  let root = maths.sqrt(e, 2.25)?;
  let half = floats.parse_float(e, "0.5")?;
  let out = systems.out(e)?;
  log.warn("jnibind: uptime " + (up > 0 as i64).to_string() + " int " + n.to_string() + " max " + bindings.INTEGER_MAX_VALUE.to_string() + " sqrt " + root.to_string() + " float " + (half as f64).to_string() + " out " + (!out.is_null()).to_string());
  jni.delete_local_ref(e, out.ref);
  return Ok(());
}

// A String parameter that is null, a member that a device can lack, and
// a lookup of a member that the device does not have. With a null
// parent or an empty parent, Android gives the path of the child.
// A nonempty parent prefixes that path.
function marks_part(e: usize): Result[void, jni.JavaError] {
  let files = bindings.file_class(e)?;
  let clocks = bindings.system_clock_class(e)?;
  let bare = files.new(e, None, "x")?;
  let empty = files.new(e, Some(""), "x")?;
  let parented = files.new(e, Some("parent"), "x")?;
  let first = files.get_path(e, bare)?;
  let second = files.get_path(e, empty)?;
  let third = files.get_path(e, parented)?;
  jni.delete_local_ref(e, bare.ref);
  jni.delete_local_ref(e, empty.ref);
  jni.delete_local_ref(e, parented.ref);
  let lost = jni.optional_id(e, jni.get_static_method_id(e, clocks.class, "fernHasNoSuchMethod", "()V"));
  let up = clocks.uptime_millis(e)?;
  log.warn("jnibind: null " + first + " empty " + second + " parent " + third + " has " + clocks.has_uptime_millis().to_string() + " lost " + (lost == 0 as usize).to_string() + " then " + (up > 0 as i64).to_string());
  files.release(e);
  clocks.release(e);
  return Ok(());
}

// An exception of the Java code is an error, and the next call works.
function thrown_part(e: usize): Result[void, jni.JavaError] {
  let integers = bindings.integer_class(e)?;
  let thrown = match (integers.parse_int(e, "fern")) {
    Ok(n) => "no error",
    Err(err) => err.message(),
  };
  let after = integers.parse_int(e, "7")?;
  integers.release(e);
  log.warn("jnibind: thrown " + thrown + " then " + after.to_string());
  return Ok(());
}

// Use the device provider, including its random IV and authentication check.
function keystore_part(e: usize): Result[void, jni.JavaError] {
  let alias = "fern.jnibind.test";
  let data: u8[] = [0u8, 255u8, 37u8];
  keystore.ensure_key(e, alias)?;
  if (!keystore.has_key(e, alias)? || keystore.has_key(e, alias + ".unprovisioned")?) {
    return Err(jni.JavaError { text: "unexpected key alias status" });
  }
  let locked = keystore.KeyOptions { ...keystore.key_options(), unlocked_device_required: true };
  let locked_alias = alias + ".unlocked";
  if (!keystore.has_key(e, locked_alias)?) {
    keystore.ensure_key_with_options(e, locked_alias, locked)?;
  }
  if (keystore.ensure_key_with_options(e, alias, locked).is_ok()) {
    return Err(jni.JavaError { text: "keystore accepted new restrictions for an existing alias" });
  }
  let sealed = keystore.seal(e, alias, data)?;
  keystore.ensure_key(e, alias)?;
  let again = keystore.seal(e, alias, data)?;
  let plain = keystore.open(e, alias, sealed)?;
  let seed_context: u8[] = [1u8];
  let peer_context: u8[] = [2u8];
  let scoped = keystore.seal_with_context(e, alias, data, seed_context)?;
  let same = keystore.open_with_context(e, alias, scoped, seed_context)?;
  if (!crypto.consteq(same, data) || keystore.open_with_context(e, alias, scoped, peer_context).is_ok()) {
    return Err(jni.JavaError { text: "keystore context authentication failed" });
  }
  if (keystore.open(e, alias, scoped).is_ok() || keystore.open_with_context(e, alias, sealed, seed_context).is_ok()) {
    return Err(jni.JavaError { text: "keystore accepted an unexpected empty context" });
  }
  let distinct = !crypto.consteq(sealed[:12], again[:12]);
  let last = sealed.len() - 1;
  let changed = sealed.with(last, sealed[last] ^ 1u8);
  let refused = match (keystore.open(e, alias, changed)) { Ok(_) => false, Err(_) => true };
  log.warn("jnibind: keystore roundtrip " + crypto.consteq(plain, data).to_string() + " fresh iv " + distinct.to_string() + " refused " + refused.to_string());
  return Ok(());
}

// Make an attested signing key, check its chain to its own root, and verify a signature with the leaf key.
function signing_part(e: usize): Result[void, jni.JavaError] {
  let alias = "fern.jnibind.signing";
  let challenge: u8[] = [9u8, 8u8, 7u8, 6u8];
  keystore.delete_key(e, alias)?;
  let made = keystore.make_signing_key(e, alias, challenge, keystore.key_options())?;
  let again = keystore.make_signing_key(e, alias, challenge, keystore.key_options()).is_ok();
  let read = keystore.signing_key(e, alias)?;
  let same = crypto.consteq(made.public_key, read.public_key) && made.chain.len() == read.chain.len();
  let root = x509.parse(made.chain[made.chain.len() - 1]).map_err(failed)?;
  let pin = hex.encode(crypto.sha256_new().update(root.spki).finish());
  let now = clock.now();
  let proof = attestation.verify_with(made.chain, [pin], challenge, now).map_err(attestation_failed)?;
  let wrong = attestation.verify_with(made.chain, [pin], [1u8], now).is_ok();
  let message: u8[] = [1u8, 2u8, 3u8];
  let sig = keystore.sign(e, alias, message)?;
  let good = verify.signature_ok(proof.key, x509.EcdsaSha256, message, sig).unwrap_or(false);
  let forged = verify.signature_ok(proof.key, x509.EcdsaSha256, [1u8, 2u8, 4u8], sig).unwrap_or(true);
  keystore.delete_key(e, alias)?;
  let gone = keystore.signing_key(e, alias).is_err();
  log.warn("jnibind: signing chain " + made.chain.len().to_string() + " level " + attestation.level_name(proof.level) + " same " + same.to_string() + " again " + again.to_string() + " wrong " + wrong.to_string() + " good " + good.to_string() + " forged " + forged.to_string() + " gone " + gone.to_string());
  return Ok(());
}

function failed(err: x509.X509Error): jni.JavaError {
  return jni.JavaError { text: "attestation root: " + err.message() };
}

function attestation_failed(err: attestation.AttestationError): jni.JavaError {
  return jni.JavaError { text: "attestation: " + err.message() };
}
