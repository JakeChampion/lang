// A NativeActivity app for the emulator check of std/android/notify. At the
// first Resume it makes a channel and posts a notification, then posts it
// again with a progress bar. Five seconds later it cancels it. The app logs
// each step and finishes.
import "std/android";
import "std/android/launch";
import "std/android/notify";
import "std/log";

const ID: i32 = 7;

struct App { ctx: usize, posted_ns: i64, done: boolean }

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let first = App { ctx: ctx, posted_ns: -1i64, done: false };
  let last: App = android.run(ctx, first, (own s: App, e: android.Event): App => step(s, e), (s: App): i32 => if (s.posted_ns >= 0i64 && !s.done) { 500 } else { -1 });
  return 0 as usize;
}

function step(s: App, e: android.Event): App {
  match (e) {
    android.Resume => {
      if (s.posted_ns >= 0i64) {
        return s;
      }
      return post(s);
    },
    android.Tick => {
      if (s.posted_ns < 0i64 || s.done || monotonic_ns() - s.posted_ns < 5000000000i64) {
        return s;
      }
      notify.cancel(s.ctx, ID);
      log.warn("notifytest: cancelled");
      android.finish(s.ctx);
      return App { ...s, done: true };
    },
    _ => {
      return s;
    }
  }
}

function post(s: App): App {
  notify.channel(s.ctx, notify.Channel { id: "fern-test", name: "Fern test", importance: notify.DEFAULT });
  log.warn("notifytest: allowed " + notify.allowed(s.ctx).to_string());
  let n = notify.note(ID, "fern-test", "Fern notify test", "posted by std/android/notify");
  log.warn("notifytest: posted " + notify.post(s.ctx, n).to_string());
  log.warn("notifytest: progress " + notify.post(s.ctx, notify.Note { ...n, text: "half done", progress: 50, ongoing: true }).to_string());
  return App { ...s, posted_ns: monotonic_ns() };
}
