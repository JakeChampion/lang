// A NativeActivity app for the device procedure of std/android/keystore
// (README.md). At each Resume it opens the envelopes of the run before, makes
// a key and an envelope for each alias that has none, logs one line for each
// alias, and finishes.
import "core/error";
import "std/android";
import "std/android/launch";
import "std/android/keystore";
import "std/crypto";
import "std/jni";
import "std/log";
import "std/option";
import "std/result";

struct App { done: boolean }

struct Alias { name: string, alias: string, options: keystore.KeyOptions }

const VALUE: string = "fern keystore device check";

pub function ANativeActivity_onCreate(activity: usize, saved: usize, saved_size: usize): void {
  launch.start(activity, app_main_entry());
}

@callback("app_main")
function app_main_entry(): usize;

function app_main(ctx: usize): usize {
  let last: App = android.run(ctx, App { done: false }, (own s: App, e: android.Event): App => step(ctx, s, e), (s: App): i32 => -1);
  return 0 as usize;
}

function step(ctx: usize, s: App, e: android.Event): App {
  match (e) {
    android.Resume => {
      if (!s.done) {
        check(ctx);
        android.finish(ctx);
      }
      return App { done: true };
    },
    _ => {
      return s;
    }
  }
}

function aliases(): Alias[] {
  let none = keystore.key_options();
  return [
    Alias { name: "plain", alias: "fern.device.plain", options: none },
    Alias { name: "strongbox", alias: "fern.device.strongbox", options: keystore.KeyOptions { ...none, strongbox_required: true } },
    Alias { name: "auth", alias: "fern.device.auth", options: keystore.KeyOptions { ...none, user_authentication_required: true } },
  ];
}

function check(ctx: usize): void {
  let e = android.env(ctx);
  let keys = android.no_backup_dir(ctx);
  let data = android.data_dir(ctx);
  log.warn("keystore-device: api " + android.sdk_version(ctx).to_string());
  // Android backs up the data directory and not the key, so a restore
  // gives this envelope with no key to open it.
  log.warn("keystore-device: restored " + report(e, aliases()[0], data + "/plain.sealed"));
  for a in aliases() {
    log.warn("keystore-device: " + a.name + " " + report(e, a, keys + "/" + a.name + ".sealed"));
  }
  log.warn("keystore-device: done");
}

// The key state of `a`, the result of opening the envelope at `path`, and
// the result of sealing a new envelope there when the path has none.
function report(e: usize, a: Alias, path: string): string {
  let had = match (keystore.has_key(e, a.alias)) {
    Ok(b) => b.to_string(),
    Err(err) => "error " + err.message(),
  };
  let line = "key " + had;
  let saved = read_file_bytes(path);
  match (saved) {
    Ok(envelope) => {
      return line + " open " + opened(e, a, envelope);
    },
    Err(NotFound(_)) => {},
    Err(err) => {
      return line + " read " + err.message();
    }
  }
  if (had != "true") {
    if let Err(err) = keystore.ensure_key_with_options(e, a.alias, a.options) {
      return line + " open none provision " + err.message();
    }
  }
  return line + " open none seal " + sealed(e, a, path);
}

function opened(e: usize, a: Alias, envelope: [u8]): string {
  match (keystore.open(e, a.alias, envelope)) {
    Ok(plain) => {
      if (crypto.consteq(plain, VALUE.as_bytes())) {
        return "ok";
      }
      return "changed";
    },
    Err(err) => {
      return err.message();
    }
  }
}

function sealed(e: usize, a: Alias, path: string): string {
  return match (keystore.seal(e, a.alias, VALUE.as_bytes())) {
    Ok(envelope) => match (write_file_bytes(path, envelope)) {
      Ok(_) => "ok",
      Err(err) => "write " + err.message(),
    },
    Err(err) => err.message(),
  };
}
