function say(tag: string, o: Option[IoError]): void {
    match (o) {
        None => { print(tag + ": ok"); },
        Some(e) => {
            match (e) {
                NotFound(p) => { print(tag + ": NotFound"); },
                PermissionDenied(p) => { print(tag + ": PermissionDenied"); },
                AlreadyExists(p) => { print(tag + ": AlreadyExists"); },
                InvalidUtf8(p) => { print(tag + ": InvalidUtf8"); },
                Interrupted => { print(tag + ": Interrupted"); },
                Unsupported => { print(tag + ": Unsupported"); },
                Other(p, m) => { print(tag + ": Other " + m); }
            }
        }
    }
}

function main(): i32 {
    var path = "/tmp/syncprobe.txt";
    match (open_writer(path)) {
        Ok(w) => {
            w.write("hello sync\n");
            say("writer.fsync", w.fsync());
            say("writer.fdatasync", w.fdatasync());
            say("writer.syncfs", w.syncfs());
            w.close();
        },
        Err(e) => { print("open_writer failed"); }
    }
    match (open_reader(path)) {
        Ok(r) => {
            say("reader.fsync", r.fsync());
            say("reader.fdatasync", r.fdatasync());
            say("reader.syncfs", r.syncfs());
            r.close();
        },
        Err(e2) => { print("open_reader failed"); }
    }
    match (open_reader("/tmp")) {
        Ok(d) => {
            say("dir.fsync", d.fsync());
            say("dir.fdatasync", d.fdatasync());
            say("dir.syncfs", d.syncfs());
            d.close();
        },
        Err(e3) => { print("open_reader dir failed"); }
    }
    sync();
    print("sync: returned");
    return 0;
}
