






import "core/int";
import "std/string";
struct Item { tags: i32[] }
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let items: Item[] = [Item { tags: [i, i + 1] }, Item { tags: [i + 2] }];
        let f = (d: i32): i32 => { return items.len() + d; };
        acc = acc + f(0);
        i = i + 1;
    }
    return (acc - 200) + __rc_underflow_count();
}
