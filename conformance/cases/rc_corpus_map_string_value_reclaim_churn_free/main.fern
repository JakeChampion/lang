



















import "core/int";
import "core/map";
import "std/string";
function mk(): i32 {
    let shared: string = "value-aaaaaaaaaaaaaaaaaaaa-shared";
    let m: Map[i32, string] = map_new(8);
    m = m.insert(1, shared);
    m = m.insert(2, shared);
    m = m.insert(3, "value-bbbbbbbbbbbbbbbbbbbb-fresh");
    let got: Option[string] = m.get(1);
    let got_len: i32 = 0;
    match (got) { Some(s) => { got_len = s.len(); }, None => {} }
    return shared.len() + got_len;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 33000) + __rc_underflow_count();
}
