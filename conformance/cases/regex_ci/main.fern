



import "std/regex";

function main(): i32 {
  let r: i32 = 0;
  if (regex.regex_match("(?i)hello", "HELLO")) {
    r = r + 1;
  }
  if (regex.regex_match("(?i)Hello", "hELLo")) {
    r = r + 2;
  }
  if (!regex.regex_match("hello", "HELLO")) {
    r = r + 4;
  }
  if (regex.regex_match("(?i)^[a-z]+$", "AbCdE")) {
    r = r + 8;
  }
  if (regex.regex_match("(?i)(cat|dog)", "DOG")) {
    r = r + 16;
  }
  if let Some(6) = regex.regex_find("(?i)world", "Hello World") {
    r = r + 32;
  }
  if (require_regex_text(regex.regex_replace_all("(?i)a", "AbAcad", "X")) == "XbXcXd") {
    r = r + 64;
  }
  if (regex.regex_match("(?i)gr[ae]y", "GREY")) {
    r = r + 128;
  }
  return r;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
