





import "core/int";
import "std/string";
struct Row { cells: i32[] }
struct Grid { rows: Row[], tag: i32 }
function mk(n: i32): Grid { return Grid { rows: [Row { cells: [n, n + 1] }], tag: n }; }
function main(): i32 {
    let g: Grid = mk(9);
    let c: i32 = 0;
    while (c < 200) {
        let junk: i32[] = [c, c];
        c = c + 1;
    }
    return (g.rows[0].cells[1] - 10) + (g.rows.len() - 1) + __rc_underflow_count();
}
