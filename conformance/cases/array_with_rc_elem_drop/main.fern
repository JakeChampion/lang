// Regression: `array.with(i, v)` replacing an RC-tracked element (an enum
// carrying a heap string) must drop the overwritten element ONLY when frees
// are enabled. In no-free mode the replaced element leaks (arena-only), and
// the drop-fn body is never generated — so emitting the drop CALL there used
// to leave an undefined `__drop_enum_<E>` symbol at link time. This exercises
// that path without std/regex (see internal/ir emitArraySet gating).
enum Cell { Text(string), Num(i32), Empty }

function cell_len(c: Cell): i32 {
    match (c) {
        Text(s) => { return s.len(); },
        Num(n) => { return n; },
        Empty => { return 0; },
    }
}

function main(): i32 {
    var xs: Cell[] = [Text("aaaa"), Num(2), Text("cc"), Empty];
    // Replace a string-carrying element (drops the old "aaaa").
    xs = xs.with(0, Text("z"));
    // Replace a scalar element with a string-carrying one.
    xs = xs.with(1, Text("bbb"));
    // Replace a string-carrying element with another (drops old "cc").
    xs = xs.with(2, Text("dddddd"));
    var total: i32 = 0;
    var i: i32 = 0;
    while (i < xs.len()) {
        total = total + cell_len(xs[i]);   // 1 + 3 + 6 + 0 = 10
        i = i + 1;
    }
    return total;
}
