





enum Slot { Text(string), Num(i32), Empty }

function cell_len(c: Slot): i32 {
    match (c) {
        Text(s) => { return s.len(); },
        Num(n) => { return n; },
        Empty => { return 0; },
    }
}

function main(): i32 {
    let xs: Slot[] = [Text("aaaa"), Num(2), Text("cc"), Empty];

    xs = xs.with(0, Text("z"));

    xs = xs.with(1, Text("bbb"));

    xs = xs.with(2, Text("dddddd"));
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < xs.len()) {
        total = total + cell_len(xs[i]);
        i = i + 1;
    }
    return total;
}
