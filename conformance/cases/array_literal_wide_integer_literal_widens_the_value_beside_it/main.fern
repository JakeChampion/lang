// An integer literal that does not fit in i32 gives an array literal the
// element type i64. The narrower value beside it then widens, as it does
// beside an i64 value.
function main(): i32 {
    let i: i32 = 1;
    let ms = [i, 5000000000];
    let k: i64 = ms[0];
    print(k + ms[1]);
    let ns = [[i], [5000000000]];
    print(ns[0][0] + ns[1][0]);
    let u: u32 = 2;
    let us = [u, 1, -5000000000];
    print(us[0] + us[1] + us[2]);
    let ds: i64[] = [i, 5000000000];
    print(ds[0] + ds[1]);
    return 0;
}
