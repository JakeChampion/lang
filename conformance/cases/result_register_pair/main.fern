





function checked_div(a: i32, b: i32): Result[i32, i32] {
    if (b == 0) { return Err(7); }
    return Ok(a / b);
}

function main(): i32 {
    let flags: i32 = 0;
    match (checked_div(84, 2)) {
        Ok(v) => { if (v == 42) { flags = flags + 1; } },
        Err(_) => { flags = flags + 16; }
    }
    match (checked_div(1, 0)) {
        Ok(_) => { flags = flags + 32; },
        Err(e) => { if (e == 7) { flags = flags + 2; } }
    }
    return flags;
}
