// Full cross-backend coverage. The arm64-only heap-corruption that
// originally forced arm64 out of this case (a live string cell recycled
// by the RcFree freelist drop/reuse path) was root-caused to
// string_from_bytes allocating via plain __fern_alloc on the two-word
// ABI — so the resulting string had no rc header and __fern_str_dec
// read garbage at data-8 / data-4. Fixed in internal/codegen/arm64
// (string_from_bytes now uses __fern_alloc_rc1, matching __str_slice /
// __fern_strcat and the wasm two-word path). Tracked as #2817.
import "std/url";
import "std/i32";

// Property-based round-trip audit for std/url percent-encoding.
//
// Deterministic LCG => identical inputs on every backend. Each generated
// byte selects a character from an alphabet spanning all four UTF-8 widths
// and the ASCII bytes the encoder escapes (NUL, space, the reserved
// punctuation), lengths 0..47, so every escape path and every byte of a
// multi-byte sequence is exercised. A `string` is well-formed UTF-8
// (docs/STRINGS-SOTA.md, D9): an arbitrary byte sequence is not a string,
// and `url_decode` reads an escape that does not spell UTF-8 as U+FFFD, so
// the round-trip is a property of text; the bytes themselves round-trip
// through `url_decode_bytes`.
//
// Properties: url_decode(url_encode(s)) == s and
// url_decode_bytes(url_encode(s)) == s.bytes() for every generated s.

function lcg_next(state: i32): i32 {
    return ((state * 1103515245) + 12345) & 2147483647;
}

function alphabet(): string[] {
    return ["a", "Z", "0", " ", "%", "/", "?", "&", "=", "+", "~", "-", "_", ".",
            string_from_bytes_unchecked([0 as u8]), "é", "ß", "中", "€", "𝄞"];
}

function gen_text(seed: i32, n: i32, alpha: string[]): string {
    var out: string = "";
    var state: i32 = seed;
    var i: i32 = 0;
    while (i < n) {
        state = lcg_next(state);
        out = out + alpha[(state / 7) % alpha.len()];
        i = i + 1;
    }
    return out;
}

function same_bytes(a: u8[], b: u8[]): boolean {
    if (a.len() != b.len()) {
        return false;
    }
    var i: i32 = 0;
    while (i < a.len()) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

function main(): i32 {
    var alpha: string[] = alphabet();
    var state: i32 = 305419896;
    var trial: i32 = 0;
    while (trial < 300) {
        state = lcg_next(state);
        var n: i32 = state % 48;
        var s: string = gen_text(state, n, alpha);
        var enc: string = url.url_encode(s);

        if (url.url_decode(enc) != s) {
            print("url roundtrip FAILED at trial " + trial.to_string());
            return 1;
        }
        if (!same_bytes(url.url_decode_bytes(enc), s.bytes())) {
            print("url byte roundtrip FAILED at trial " + trial.to_string());
            return 1;
        }
        trial = trial + 1;
    }
    print("OK");
    return 0;
}
