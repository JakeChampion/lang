// `Tagged(4)` leaves Box's T unbound, so the array is a Box[never][]. Its
// element is a constant, built once as a static box, and the static box must
// carry the shape word a match on that instance tests for: it carried the
// bare variant name, so the match took the wrong arm.
enum Box[T] { Full(T), Tagged(i32) }

function main(): i32 {
    let b = Tagged(3);
    let xs = [Tagged(4)];
    let t: i32 = 0;
    match (b) { Tagged(n) => { t = t + n; }, _ => { t = t + 100; } }
    match (xs[0]) { Tagged(n) => { t = t + n * 10; }, _ => { t = t + 200; } }
    return t;
}
