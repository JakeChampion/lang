








import "core/int";
struct Pt { x: i32, y: i32 }
struct Outer { inner: Pt, tag: i32 }
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let o: Outer = Outer { inner: Pt { x: i, y: i + 1 }, tag: i };
        acc = acc + o.inner.y;
        i = i + 1;
    }
    return (acc - 5050) + __rc_underflow_count();
}
