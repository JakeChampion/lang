// The helper sits in a directory named `std` but is not the standard
// library, and it never imports std/result. The entry's import of
// std/result does not reach it.
import "std/result";
import "./std/first";

function main(): i32 {
  match (first.first(Ok(3))) {
    Some(v) => { return v; },
    None => { return 0; }
  }
}
