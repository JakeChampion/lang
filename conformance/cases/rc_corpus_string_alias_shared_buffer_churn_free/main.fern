










function mk(seed: i32): i32 {
    let pre: string = "a";
    let s: string = pre + "b";
    let s2: string = s;
    let s3: string = s2;
    return s.len() + s2.len() + s3.len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 250) { total = total + mk(k); k = k + 1; }
    return (total - 1500) + __rc_underflow_count();
}
