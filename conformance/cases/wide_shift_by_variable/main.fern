




























import "std/i32";
import "std/i64";
import "std/u64";
import "std/string";

function shifted_left(s: i64, n: i32): i64 { return s << n; }
function shifted_right(s: i64, n: i32): i64 { return s >> n; }
function shifted_right_u(s: u64, n: i32): u64 { return s >> (n as u64); }

function main(): i32 {
    let one: i64 = 1;
    let acc: string = "";
    for i in 0..8 {
        acc = acc + (one << i).to_string() + " ";
    }
    print(acc);


    print(shifted_left(1, 0).to_string());
    print(shifted_left(1, 63).to_string());
    print(shifted_right(-1024, 4).to_string());
    print(shifted_right_u(18446744073709551615, 60).to_string());



    let u: u64 = 1;
    let k: i32 = 40;
    print((u << (k as u64)).to_string());
    print((u << 40).to_string());


    let base: i32 = 30;
    print((one << (base + 2)).to_string());
    print(((one << 62) >> (base + 1)).to_string());

    return 0;
}
