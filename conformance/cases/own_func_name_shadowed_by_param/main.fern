










@noinline function keep(own xs: i32[], k: i32): i32[] {
    if (k > 0) { return xs; }
    return [k];
}




@noinline function count_matching(rows: i32[][], keep: (i32[]) => boolean): i32 {
    let n: i32 = 0;
    for r in rows {
        if (keep(r)) { n = n + 1; }
    }
    return n;
}




@noinline function not_consumed(own xs: i32[], keep: (i32[]) => boolean): i32 {
    let hit: i32 = 0;
    if (keep(xs)) { hit = 1; }
    return hit + xs.len();
}


@noinline function via_local(rows: i32[][]): i32 {
    let keep: (i32[]) => i32 = (v: i32[]) => v.len();
    return keep(rows[0]);
}




@noinline function via_loop(fns: ((i32[]) => i32)[], xs: i32[]): i32 {
    let n: i32 = 0;
    for keep in fns { n = n + keep(xs); }
    return n;
}

function main(): i32 {
    let kept: i32[] = keep([1, 2, 3], 1);
    let rows: i32[][] = [kept, [4], [5, 6, 7]];
    return count_matching(rows, (v: i32[]) => v.len() > 1)
        + not_consumed([8, 9], (v: i32[]) => v.len() > 1)
        + via_local(rows)
        + via_loop([(v: i32[]) => v.len()], kept);
}
