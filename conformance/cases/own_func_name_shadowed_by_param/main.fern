// A parameter that shadows an `own` function's name is a function VALUE. Its
// consuming positions come from its own type, not from the global declaration
// it happens to share a name with.
//
// The ownership guard resolved a callee by name against a global table and
// never asked whether the name was bound locally, so `keep(x)` below — a call
// through `count_matching`'s own parameter — was checked against the `keep`
// declared above it, and `x`, an ordinary borrowed loop variable, was reported
// as needing to be owned (#9532). The stdlib's `filter(xs, keep)` is the same
// shape, which made `import "std/string"` stop compiling for any program that
// declared an `own` function named `keep`.
@noinline function keep(own xs: i32[], k: i32): i32[] {
    if (k > 0) { return xs; }
    return [k];
}

// The argument through the shadowed callee is a POINTER on purpose: a scalar is
// excused as trivially owned whatever the callee is, so a scalar-only case
// passes whether or not the shadowing rule works.
@noinline function count_matching(rows: i32[][], keep: (i32[]) => boolean): i32 {
    var n: i32 = 0;
    for r in rows {
        if (keep(r)) { n = n + 1; }
    }
    return n;
}

// The consume classifier reads the same table: a shadowed callee must not mark
// its argument moved either, or `xs` here is a use-after-move. This is the E050
// half of the same bug.
//
// This call is also the whole of the fixture's census row of 1: one array
// handed to an `own` parameter and not reclaimed, which is the RECLAIM side
// the port has not reached yet. The row was 0 before this function existed.
@noinline function not_consumed(own xs: i32[], keep: (i32[]) => boolean): i32 {
    var hit: i32 = 0;
    if (keep(xs)) { hit = 1; }
    return hit + xs.len();
}

// A local binding shadows the same way, and so does a lambda parameter.
@noinline function via_local(rows: i32[][]): i32 {
    var keep: (i32[]) => i32 = (v: i32[]) => v.len();
    return keep(rows[0]);
}

function main(): i32 {
    var kept: i32[] = keep([1, 2, 3], 1);
    var rows: i32[][] = [kept, [4], [5, 6, 7]];
    return count_matching(rows, (v: i32[]) => v.len() > 1)
        + not_consumed([8, 9], (v: i32[]) => v.len() > 1)
        + via_local(rows);
}
