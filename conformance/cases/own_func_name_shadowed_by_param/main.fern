// A parameter that shadows an `own` function's name is a function VALUE. Its
// consuming positions come from its own type, not from the global declaration
// it happens to share a name with.
//
// The ownership guard resolved a callee by name against a global table and
// never asked whether the name was bound locally, so `keep(x)` below — a call
// through `count_matching`'s own parameter — was checked against the `keep`
// declared above it, and `x`, an ordinary borrowed loop variable, was reported
// as needing to be owned (#9532). The stdlib's `filter(xs, keep)` is the same
// shape, which made `import "std/string"` stop compiling for any program that
// declared an `own` function named `keep`.
@noinline function keep(own xs: i32[], k: i32): i32[] {
    if (k > 0) { return xs; }
    return [k];
}

@noinline function count_matching(xs: i32[], keep: (i32) => boolean): i32 {
    var n: i32 = 0;
    for x in xs {
        if (keep(x)) { n = n + 1; }
    }
    return n;
}

// A lambda parameter shadows the same way.
@noinline function via_lambda(xs: i32[]): i32 {
    var f: (((i32) => boolean)) => i32 = (keep: (i32) => boolean) => count_matching(xs, keep);
    return f((v: i32) => v > 2);
}

function main(): i32 {
    var kept: i32[] = keep([1, 2, 3], 1);
    return count_matching(kept, (v: i32) => v > 1) + kept.len() + via_lambda(kept);
}
