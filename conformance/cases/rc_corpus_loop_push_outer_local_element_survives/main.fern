










import "core/int";
struct Val { kind: i32, kids: i32[] }
function build(n: i32): i32 {
    let vals: Val[] = [];
    let v: Val = Val { kind: 7, kids: [1] };
    let i: i32 = 0;
    while (i < n) {
        if (i == 9999) { continue; }
        vals = vals.append(v);
        i = i + 1;
    }
    return vals.len() + v.kind + vals[0].kind;
}
function main(): i32 { return (build(4) - 18) + __rc_underflow_count(); }
