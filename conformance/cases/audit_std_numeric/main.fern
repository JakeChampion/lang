import "core/int";
import "std/i32";
import "std/math";
import "std/array";

// Audit fixture: std/i32 scalar methods, std/math helpers, and std/array
// reductions across every native backend.

function main(): i32 {
    // --- std/i32 scalar methods ---
    if ((0 - 5).abs() != 5) { print("FAIL abs"); return 11; }
    if ((3).max(7) != 7 || (3).min(7) != 3) { print("FAIL minmax"); return 12; }
    if ((9).clamp(0, 5) != 5) { print("FAIL clamp"); return 13; }
    if ((2).pow(10) != 1024) { print("FAIL pow"); return 14; }
    if ((12).gcd(8) != 4 || (4).lcm(6) != 12) { print("FAIL gcdlcm"); return 15; }
    if (!(7).is_prime() || (8).is_prime()) { print("FAIL prime"); return 16; }
    if (!(6).is_even() || (6).is_odd()) { print("FAIL evenodd"); return 17; }
    if ((0 - 3).signum() != (0 - 1) || (5).signum() != 1) { print("FAIL signum"); return 18; }

    // --- std/math helpers ---
    var r: i32[] = math.range(0, 5); // [0,1,2,3,4]
    var rs: i32 = 0;
    var ri: i32 = 0;
    while (ri < r.len()) { rs = rs + r[ri]; ri = ri + 1; }
    if (rs != 10) { print("FAIL range"); return 19; }

    // --- std/array reductions ---
    var a: i32[] = [3, 1, 2];
    if (a.sum() != 6) { print("FAIL arr-sum"); return 21; }
    var mx: i32 = match (a.max()) { Some(v) => v, None => 0 };
    var mn: i32 = match (a.min()) { Some(v) => v, None => 0 };
    if (mx != 3 || mn != 1) { print("FAIL arr-minmax"); return 22; }
    if (a.product() != 6) { print("FAIL arr-product"); return 23; }
    var s: i32[] = a.sorted_asc();
    if (s[0] != 1 || s[1] != 2 || s[2] != 3) { print("FAIL arr-sorted"); return 24; }

    print("OK");
    return 0;
}
