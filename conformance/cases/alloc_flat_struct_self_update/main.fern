// spec: AL-01























import "std/i32";
import "std/i64";

struct Pt { x: i32, y: i32 }
struct Named { tag: string, n: i32 }
struct Buf { xs: i32[], n: i32 }
struct Inner { tag: i32, data: i32[] }
struct Nest { xs: i32[], inner: Inner, n: i32 }

function scalar_only(k: i32): i32 {
    let p: Pt = Pt { x: 0, y: 0 };
    let i: i32 = 0;
    while (i < k) {
        p = Pt { ...p, x: p.x + 1 };
        i = i + 1;
    }
    return p.x + p.y;
}

function with_string(k: i32): i32 {
    let s: Named = Named { tag: "seed", n: 0 };
    let i: i32 = 0;
    while (i < k) {
        s = Named { ...s, n: s.n + 1 };
        i = i + 1;
    }
    return s.n + s.tag.len();
}

function with_array(k: i32): i32 {
    let b: Buf = Buf { xs: [], n: 0 };
    let i: i32 = 0;
    while (i < k) {
        b = Buf { ...b, xs: b.xs.append(i) };
        i = i + 1;
    }
    let sum: i32 = b.xs.len();
    let j: i32 = 0;
    while (j < b.xs.len()) { sum = sum + b.xs[j]; j = j + 1; }
    return sum;
}



function fork_base(k: i32): i32 {
    let a: Buf = Buf { xs: [k, k + 1], n: k };
    let b: Buf = Buf { ...a, n: a.n + 1 };
    let c: Buf = Buf { ...a, n: a.n + 2 };
    return a.n + b.n + c.n + a.xs[0] + b.xs[1] + c.xs[0];
}











function nested_struct(k: i32): i32 {
    let o: Nest = Nest { xs: [1, 2], inner: Inner { tag: 3, data: [9] }, n: 0 };
    let keep: Inner = o.inner;
    let i: i32 = 0;
    while (i < k) {
        o = Nest { ...o, xs: o.xs.append(i) };
        i = i + 1;
    }
    return o.xs.len() + o.inner.tag + keep.tag + keep.data[0];
}

function rounds(n: i32): i32 {
    let acc: i32 = 0;
    for i in 0..n {
        acc = acc + scalar_only(8) + with_string(8) + with_array(8) + fork_base(i)
            + nested_struct(8);
    }
    return acc;
}

function main(): i32 {
    let b0: i64 = __heap_bump_bytes();
    let x: i32 = rounds(50);
    let b1: i64 = __heap_bump_bytes();
    let y: i32 = rounds(100);
    let b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());

    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
