// A returned struct or tuple may not hold a view of storage the function
// owns: that storage is reclaimed when the function returns. The diagnostic
// is at the return, E063 for a `[T]` view and E065 for a `str` view.
struct Holder { xs: [i32] }
struct Named { s: str, n: i32 }

function holder(): Holder {
    let v: [i32] = [1, 2, 3];
    return Holder { xs: v };
}

function pair(): (i32, [i32]) {
    let v: [i32] = [1, 2];
    return (1, v);
}

function kept(): Holder {
    let v: [i32] = [4];
    let h: Holder = Holder { xs: v };
    return h;
}

function named(): Named {
    let s: string = "ab" + "c";
    let v: str = s;
    return Named { s: v, n: 1 };
}

function main(): i32 {
    return holder().xs.len() as i32;
}
