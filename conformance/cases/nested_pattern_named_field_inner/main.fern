




struct Rect { w: i32, h: i32 }
enum Shape { Boxed(Rect), Empty }
function g(o: Option[Shape]): i32 {
  match (o) {
    Some(Boxed(r)) => { return r.w + r.h; },
    Some(Empty()) => { return 0; },
    None => { return 0 - 1; },
  }
  return 0 - 2;
}
function main(): i32 { return g(Some(Boxed(Rect { w: 3, h: 4 }))) + g(Some(Empty)); }
