









import "core/map";
@noinline
function idm(x: Map[string, i32]): Map[string, i32] { return x; }
function main(): i32 {
    let m: Map[string, i32] = map_new(4);
    let f: () => i32 = (): i32 => { return m.len(); };
    let i: i32 = 0;
    while (i < 50) {
        m = idm(m);
        m = map_new(4);
        i = i + 1;
    }
    return m.len() + f() + __rc_underflow_count();
}
