// The index of `with` converts to i32 only when no value is lost, as any other
// i32 argument does. An i64 index needs an explicit `as i32`.
function put(xs: i32[], k: i64): i32[] {
  return xs.with(k, 9);
}

function main(): i32 {
  let u: u8 = 1;
  let ys = put([1, 2, 3], 1).with(u, 7);
  print(ys[1].to_string());
  return 0;
}
