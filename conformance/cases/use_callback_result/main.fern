



function stamped(n: i32, next: (i32) => Result[i32, string]): Result[i32, string] {
    let v: i32 = next(n + 1)?;
    return Ok(v * 2);
}

function half(n: i32): Result[i32, string] {
    if (n % 2 == 0) {
        return Ok(n / 2);
    }
    return Err("odd");
}

function run(n: i32): Result[i32, string] {
    use m <- stamped(n);
    let h: i32 = half(m)?;
    return Ok(h + 100);
}

function plain(n: i32): Result[i32, string] {
    use m <- stamped(n);
    return Ok(m);
}

function main(): i32 {
    let a: i32 = 0;
    match (run(7)) {
        Ok(v) => { a = v; },
        Err(_) => { a = 0 - 1; }
    }
    let b: i32 = 0;
    match (run(8)) {
        Ok(v) => { b = v; },
        Err(e) => { b = e.len(); }
    }
    let c: i32 = 0;
    match (plain(1)) {
        Ok(v) => { c = v; },
        Err(_) => { c = 0 - 1; }
    }
    return (a - 200) * 10 + b + c;
}
