













import "core/int";
import "core/map";
function mk(): i32 {
    let m: Map[i32, i32] = map_new(8);
    m = m.insert(1, 10);
    m = m.insert(2, 20);
    m = m.insert(3, 30);
    let ks = m.keys();
    let vs = m.values();
    let wm: Map[i64, i64] = map_new(8);
    wm = wm.insert(5, 50);
    wm = wm.insert(6, 60);
    let wks = wm.keys();
    let wvs = wm.values();
    let ks2 = m.keys();
    return ks2.len() + ks2[0] + ks2[1] + ks2[2];
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 4500) + __rc_underflow_count();
}
