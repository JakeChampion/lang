import "./tree";

function fill(c: Cell[Option[i32]]): void {
  c.set(Some(4));
}

function filled(xs: Option[string][]): Option[string][] {
  return xs.with(1, Some("x"));
}

function second_slot(): string {
  let slots = [None, None];
  slots = filled(slots);
  let Some(x) = slots[1] else {
    return "";
  };
  return x;
}

function main(): i32 {
  if (tree.leaves(tree.emptied(tree.Leaf("a"))) != 0) {
    return 1;
  }
  let kids = tree.cleared([tree.Leaf(1), tree.Leaf(2)]);
  if (tree.leaves(tree.Branch(kids)) != 1) {
    return 2;
  }
  let h = tree.Holder { size: 3, root: tree.Branch([tree.Leaf(1)]) };
  let d = h.dropped();
  if (d.size != 3 || tree.leaves(d.root) != 0) {
    return 3;
  }
  let errors = cell_new(None);
  fill(errors);
  let Some(n) = errors.get() else {
    return 4;
  };
  if (n != 4) {
    return 5;
  }
  if (second_slot() != "x") {
    return 6;
  }
  print("ok");
  return 0;
}
