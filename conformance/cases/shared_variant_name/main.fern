









enum A { Zed, Xx(i32) }
enum B { Yy(i32), Zed }

function a_of(v: A): i32 {
    match (v) {
        A.Zed => { return 1; },
        A.Xx(n) => { return n; },
    }
}

function b_of(v: B): i32 {
    match (v) {
        B.Zed => { return 4; },
        B.Yy(n) => { return n * 10; },
    }
}

function main(): i32 {
    let total: i32 = 0;
    total = total + a_of(A.Zed);
    total = total + a_of(A.Xx(2));
    total = total + b_of(B.Zed);
    total = total + b_of(B.Yy(1));



    let v: B = B.Zed;
    total = total + b_of(v);
    return total;
}
