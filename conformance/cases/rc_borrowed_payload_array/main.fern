
















enum N { Chr(i32), Seq(N[]), Plus(N) }

function closure(inner: N, reps: i32): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < reps) {
        let got: i32[] = [];
        got = got.append(sum(inner));
        acc = acc + got[0];
        i = i + 1;
    }
    return acc;
}

function sum(n: N): i32 {
    match (n) {
        Chr(c) => { return c; },
        Seq(xs) => { let s: i32 = 0; let k: i32 = 0; while (k < xs.len()) { s = s + sum(xs[k]); k = k + 1; } return s; },
        Plus(inner) => { return closure(inner, 8); }
    }
}

function main(): i32 {
    let items: N[] = [];
    items = items.append(Chr(1));
    items = items.append(Chr(2));
    let t: N = Plus(Seq(items));

    return sum(t);
}
