import "std/mock_platform";
import "std/platform";
import "std/http";
import "std/headers";
import "std/stream";
import "std/i32";







function handle(req: HttpRequest, plat: platform.Platform): HttpResponse {
    plat.log("serving " + req.path);
    match (plat.env("REGION")) {
        Some(v) => { plat.log("region=" + v); },
        None => { plat.log("no-region"); }
    }
    plat.log("done");
    return http.ok("body-" + req.path);
}

function main(): i32 {
    let m: mock_platform.MockPlatform = mock_platform.mock_platform_new();
    let req: HttpRequest = HttpRequest { method: "GET", path: "/a", body: stream.stream_empty(), headers: headers.header_map_new(), trailers: headers.header_map_new() };
    let resp: HttpResponse = handle(req, m);
    print(resp.body_string());
    print(m.call_count().to_string());
    let cs: mock_platform.MockCall[] = m.calls();
    print(cs[0].name);
    print(cs[0].args);
    print(cs[1].name);
    print(cs[1].args);
    if (m.has_call("env")) { print("has-env"); } else { print("no-env"); }
    if (m.has_call("fetch")) { print("has-fetch"); } else { print("no-fetch"); }
    match (m.find_call("log")) {
        Some(c) => { print(c.args); },
        None => { print("none"); },
    }
    match (m.find_call("nope")) {
        Some(c) => { print("unexpected"); },
        None => { print("find-none"); },
    }

    m.record("kv_set", "k=v");
    print(m.call_count().to_string());
    m.reset();
    print(m.call_count().to_string());
    return 0;
}
