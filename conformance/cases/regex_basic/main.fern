




import "std/regex";

function main(): i32 {
    let r: i32 = 0;
    if (regex.regex_match("abc", "xxabcyy")) { r = r + 1; }
    if (regex.regex_match("^a.c$", "axc")) { r = r + 2; }
    if (regex.regex_match("a*b", "aaab")) { r = r + 4; }
    if (regex.regex_match("colou?r", "color")) { r = r + 8; }
    if (regex.regex_match("[0-9]+", "abc123")) { r = r + 16; }
    if (regex.regex_match("gr(a|e)y", "grey")) { r = r + 32; }
    if (regex.regex_match("^(ab)+$", "ababab")) { r = r + 64; }
    if (regex.regex_match("^(cat|dog|bird)$", "dog")) { r = r + 128; }
    return r;
}
