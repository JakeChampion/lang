// std/regex (#2680) exercised across every native backend: literals, `.`,
// `^`/`$` anchors, the `*`/`+`/`?` quantifiers, `[...]` character classes
// with ranges, alternation `|`, and grouping `()` (including a quantifier
// over a group). Each check contributes a distinct bit; all eight match, so
// main returns 0b11111111 = 255.
import "std/regex";

function main(): i32 {
    var r: i32 = 0;
    if (regex.regex_match("abc", "xxabcyy")) { r = r + 1; }              // literal, searched
    if (regex.regex_match("^a.c$", "axc")) { r = r + 2; }               // anchors + `.`
    if (regex.regex_match("a*b", "aaab")) { r = r + 4; }                // `*` greedy
    if (regex.regex_match("colou?r", "color")) { r = r + 8; }           // `?` optional
    if (regex.regex_match("[0-9]+", "abc123")) { r = r + 16; }          // class + `+`
    if (regex.regex_match("gr(a|e)y", "grey")) { r = r + 32; }          // group + alternation
    if (regex.regex_match("^(ab)+$", "ababab")) { r = r + 64; }         // quantifier over a group
    if (regex.regex_match("^(cat|dog|bird)$", "dog")) { r = r + 128; }  // multi-way alternation
    return r;
}
