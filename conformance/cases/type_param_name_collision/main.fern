










import "core/int";
import "core/map";
import "std/array";

struct K { a: i32 }
struct V { n: i32 }
struct T { z: i32 }

function main(): i32 {
    let m: Map[i32, V] = map_new(8);
    m = m.insert(1, V { n: 10 });
    m = m.insert(2, V { n: 32 });

    let total: i32 = 0;
    match (m.get(1)) {
        Some(v) => { total = total + v.n; },
        None => {},
    }
    match (m.get(2)) {
        Some(v) => { total = total + v.n; },
        None => {},
    }



    let xs: i32[] = [1, 2, 3, 4];
    let k: K = K { a: xs.len() };
    let t: T = T { z: xs.sum() };

    return total + t.z + k.a + m.len();
}
