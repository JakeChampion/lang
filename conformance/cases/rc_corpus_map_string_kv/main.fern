



import "core/int";
import "core/map";
import "std/string";
function main(): i32 {
    let m: Map[string, string] = map_new(8);
    m = m.insert("hello", "world");
    m = m.insert("foo", "bar");
    let v: string = m.get_or("hello", "missing");
    return (v.len() - 5) + __rc_underflow_count();
}
