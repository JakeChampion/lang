// rc correctness: the program tears its values down and folds
// __rc_underflow_count() into its exit code, so 0 means no over-release.
//
// Map with string keys/values: build, read, drop.
import "core/int";
import "core/map";
import "std/string";
function main(): i32 {
    let m: Map[string, string] = map_new(8);
    m = m.insert("hello", "world");
    m = m.insert("foo", "bar");
    let v: string = m.get_or("hello", "missing");
    return (v.len() - 5) + __rc_underflow_count();
}
