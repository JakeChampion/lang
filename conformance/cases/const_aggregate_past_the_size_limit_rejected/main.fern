// A constant expression makes an aggregate of 1048576 scalars at most. Each
// const here holds the const before two times, so the aggregate doubles at
// each step. A19 has 1048576 scalars and A20 is the E093. A const that reads
// the refused const is an E093 too.
const A0: i32[] = [1, 2];
const A1: i32[][] = [A0, A0];
const A2: i32[][][] = [A1, A1];
const A3: i32[][][][] = [A2, A2];
const A4: i32[][][][][] = [A3, A3];
const A5: i32[][][][][][] = [A4, A4];
const A6: i32[][][][][][][] = [A5, A5];
const A7: i32[][][][][][][][] = [A6, A6];
const A8: i32[][][][][][][][][] = [A7, A7];
const A9: i32[][][][][][][][][][] = [A8, A8];
const A10: i32[][][][][][][][][][][] = [A9, A9];
const A11: i32[][][][][][][][][][][][] = [A10, A10];
const A12: i32[][][][][][][][][][][][][] = [A11, A11];
const A13: i32[][][][][][][][][][][][][][] = [A12, A12];
const A14: i32[][][][][][][][][][][][][][][] = [A13, A13];
const A15: i32[][][][][][][][][][][][][][][][] = [A14, A14];
const A16: i32[][][][][][][][][][][][][][][][][] = [A15, A15];
const A17: i32[][][][][][][][][][][][][][][][][][] = [A16, A16];
const A18: i32[][][][][][][][][][][][][][][][][][][] = [A17, A17];
const A19: i32[][][][][][][][][][][][][][][][][][][][] = [A18, A18];
const A20: i32[][][][][][][][][][][][][][][][][][][][][] = [A19, A19];
const A21: i32[][][][][][][][][][][][][][][][][][][][][][] = [A20, A20];

function main(): i32 {
    print(A1.len());
    return 0;
}
