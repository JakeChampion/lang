// spec: RH-27
struct Handle { fd: i32 }

function (own h: Handle) close(): i32 {
  return h.fd;
}

function take(own slot: Cell[Handle]): Handle {
  return slot.get();
}

function lift(h: Handle): Cell[Handle] {
  return cell_new(h);
}

function main(): i32 {
  print(take(cell_new(Handle { fd: 3 })).close());
  print(take(lift(Handle { fd: 4 })).close());
  return 0;
}
