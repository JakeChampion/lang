// A name with one declaration that is not fresh is not a fresh local. An
// alias of an own parameter that is given a borrowed value is not owned.
// Each call to the `own` parameter is refused.

struct Acc { items: i32[], w: Writer }
struct Box { a: Acc }

function sink(own a: Acc): i32 {
  return a.items.len();
}

function mk(n: i32): Acc {
  return Acc { items: [n], w: stdout() };
}

function one_stale(b: Box, k: i32): i32 {
  if (k > 0) {
    let a: Acc = b.a;
    print(a.items.len().to_string());
  }
  let a: Acc = mk(7);
  let n: i32 = sink(a);
  return n;
}

function alias_given_borrowed(own p: Acc, b: Box): i32 {
  let first: i32 = p.items.len();
  let q: Acc = p;
  q = b.a;
  let n: i32 = sink(q);
  return n + first;
}

function main(): i32 {
  return 0;
}
