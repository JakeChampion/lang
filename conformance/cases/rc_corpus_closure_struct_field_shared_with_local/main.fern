








import "core/int";
import "std/i32";
struct H { f: (i32) => i32 }
function main(): i32 {
    let n: i32 = 7;
    let h: (i32) => i32 = (x: i32) => x + n;
    let keep: H = H { f: h };
    let a: i32 = h(1);
    let b: i32 = (keep.f)(2);
    let c: i32 = h(3);
    return (a + b + c - 27) + __rc_underflow_count();
}
