// An integer literal in a const declared as a float takes the float type
// before the fold, as it does in a let. So 1 / 2 is 0.5, not 0.
const FIVE: f32 = 5;
const HALF: f64 = 1 / 2;
const PRODUCT: f64 = -3 * 2;
const NEG_ZERO: f64 = -0;
const PAIR: f64[] = [1, 3 / 4];

function main(): i32 {
    let half: f64 = 1 / 2;
    print(f"{FIVE} {HALF} {PRODUCT} {PAIR[0]} {PAIR[1]}");
    if (HALF == half) {
        print("same as let");
    }
    if (1.0 / NEG_ZERO < 0.0) {
        print("negative zero");
    }
    return 0;
}
