













import "core/int";
import "std/i32";
struct Hold { xs: i32[] }
function main(): i32 {
    let idf: (i32[]) => i32[] = (xs: i32[]) => xs;
    let wrap: (i32[]) => Hold = (xs: i32[]) => Hold { xs: xs };
    let nest: (i32[]) => i32[][] = (xs: i32[]) => [xs];
    let t: i32 = 0;
    let r: i32 = 0;
    while (r < 20) {
        let a: i32[] = idf([1, 2, 3]);
        let b: Hold = wrap([4, 5, 6]);
        let c: i32[][] = nest([7, 8, 9]);
        t = t + a[0] + a[2] + b.xs[1] + c[0][2];
        r = r + 1;
    }
    return (t - 360) + __rc_underflow_count();
}
