// Pins P001. The program is the example from that code's entry
// in the diagnostic catalogue (`fern explain P001`), so this case
// also checks the catalogue's example really does produce the error
// it documents.
function main(): i32 {
    var x: i32 = 1     // missing `;` → error[P001]: expected ";", got "}"
}

function f() {
    return x +;        // error[P001]: unexpected token ";"
}

function g(): broken { return 0; }   // error[P001]: expected type, got "{"
