




struct P { a: i32, b: i32 }
function mk_arr(): P[] { return [P{a:0,b:0}, P{a:1,b:1}]; }
function f(n: i32): i32 {
    let t: i32 = 0;
    for i in 0..n {
        let it: P[] = mk_arr();
        let a: P[] = it.append(P{a:i,b:i});
        t = t + a[2].a;
    }
    return t;
}
function main(): i32 { return (f(20) - 190) + __rc_underflow_count(); }
