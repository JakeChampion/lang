








import "std/i32";
import "std/i64";
import "std/u64";

function main(): i32 {

    let a: i64 = match ((6i64) %? (549i64)) { Some(x) => x, None => 111i64 };
    if (a != 6i64) { return 1; }


    let b: i64 = match ((6i64) %? (0i64)) { Some(x) => x, None => 5000000000i64 };
    if (b != 5000000000i64) { return 2; }


    let c: i64 = match (2i32) { 0 => 7i64, 1 => 8i64, _ => 9000000000i64 };
    if (c != 9000000000i64) { return 3; }


    let d: u64 = match ((6u64) %? (0u64)) { Some(x) => x, None => 9223372036854776520u64 };
    if (d != 9223372036854776520u64) { return 4; }



    let e: i64 = match (1i32) { 0 => 5000000000i64, _ => 12i64 };
    if (e != 12i64) { return 5; }
    let f: i32 = match (1i32) { 0 => 3i32, _ => 4i32 };
    if (f != 4i32) { return 6; }
    let g: string = match (1i32) { 0 => "no", _ => "yes" };
    if (g != "yes") { return 7; }

    return 11;
}
