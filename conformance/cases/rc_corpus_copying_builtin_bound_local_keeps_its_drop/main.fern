








@noinline
function mk(pad: string, i: i32): string { return pad + "0123456789abcdef"; }

function main(): i32 {
    let pad: string = "xyzw";
    let t: i32 = 0;
    let i: i32 = 0;
    while (i < 4) {
        let msg: string = mk(pad, i);
        t = t + __memchr(msg, 97, 0);
        i = i + 1;
    }
    return (t - 56) + __rc_underflow_count();
}
