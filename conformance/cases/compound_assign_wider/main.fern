import "core/int";

// Audit fixture: compound assignment (`+= -= *= /= %=`) beyond the i32 path —
// the read-modify-write lowering must use width-correct load/op/store for i64 /
// u32 / u8 (wrap) / f64 locals, and the full operator set on i32.
function main(): i32 {
    var i = 5 as i64;   i += 3 as i64;   // 8
    var j = 4 as i64;   j *= 3 as i64;   // 12
    var u = 100 as u32; u += 20 as u32;  // 120
    var w = 250 as u8;  w += 10 as u8;   // 4 (u8 wrap)
    var x = 2.5;        x += 1.5;        // 4.0
    var y = 3.0;        y *= 4.0;        // 12.0
    var a = 20;         a -= 5;          // 15
    var b = 20;         b /= 4;          // 5
    var c = 23;         c %= 5;          // 3

    // Loop accumulation into an i64 with `+=`.
    var s = 0 as i64;
    var k = 0;
    while (k < 5) { s += k as i64; k = k + 1; } // 0+1+2+3+4 = 10

    if ((i as i32) != 8) { return 11; }
    if ((j as i32) != 12) { return 12; }
    if ((u as i32) != 120) { return 13; }
    if ((w as i32) != 4) { return 14; }
    if ((x as i32) != 4) { return 15; }
    if ((y as i32) != 12) { return 16; }
    if (a != 15) { return 17; }
    if (b != 5) { return 18; }
    if (c != 3) { return 19; }
    if ((s as i32) != 10) { return 20; }
    print("ok");
    return 0;
}
