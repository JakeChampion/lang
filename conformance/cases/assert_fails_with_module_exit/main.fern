// A failing assert calls the builtin exit even when the module declares its
// own function named exit: the program stops with status 1, and the function
// of the module does not run.

function exit(code: i32): void {
  print("module exit");
}

function check(n: i32): void {
  assert(n == 0, "n is not zero");
  print("after the assert");
}

function main(): i32 {
  print("before");
  exit(0);
  check(3);
  print("after the call");
  return 0;
}
