


function hi(): i32 { return 6; }
function main(): i32 {
    let sum: i32 = 0;
    for i in 0..=5 { sum = sum + i; }
    for j in 2..=hi() {
        if (j == 4) { continue; }
        sum = sum + j;
    }
    for k in 5..=5 { sum = sum + 100; }
    for m in 9..=3 { sum = sum + 1000; }
    let n: i32 = 2;
    for p in 0..=n { sum = sum + 7; }
    return sum;
}
