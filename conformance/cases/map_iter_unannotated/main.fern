




import "core/map";

function main(): i32 {
    let m: Map[i32, i32] = map_new(8);
    m = m.insert(1, 10);
    m = m.insert(2, 20);


    let it = m.iter();
    let total: i32 = 0;
    let seen: i32 = 0;
    while (it.has_next()) {
        total = total + it.value();
        seen = seen + it.key();
        it.advance();
    }
    if (total != 30) { return 1; }
    if (seen != 3) { return 2; }



    let s: Map[string, string] = map_new(4);
    s = s.insert("a", "xy");
    let it2 = s.iter();
    let chars: i32 = 0;
    while (it2.has_next()) {
        chars = chars + it2.key().len() + it2.value().len();
        it2.advance();
    }
    if (chars != 3) { return 3; }

    return 42;
}
