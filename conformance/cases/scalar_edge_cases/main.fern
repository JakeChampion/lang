import "std/i32";
import "std/string";
import "core/int";















function d(n: i32): string { return int.int_to_string_radix(n, 10); }

function main(): i32 {
    let mn: i32 = 0 - 2147483647 - 1;
    print(d(mn.digits()));
    print(d(mn.sum_of_digits()));
    if (mn.has_digit(8)) { print("has8"); } else { print("no8"); }
    print(d((0 - 1234).reverse_digits()));


    print("[" + "hello".truncate(0 - 3, "..") + "]");
    print("[" + "hello".truncate(0, "..") + "]");

    let dm = (10).divmod(0);
    print(d(dm.0) + "," + d(dm.1));
    print("[" + int.int_to_string_radix(42, 99) + "]");
    print("[" + int.int_to_string_radix(42, 1) + "]");
    print(int.int_to_string_radix(0 - 255, 16));
    return 0;
}
