


struct Pair { a: i32, b: string }

function apply[S](init: S, f: (S) => i32): i32 {
    let run: () => i32 = (): i32 => f(init);
    return run();
}

function twice[S](init: S, f: (S) => i32): i32 {
    let g: (i32) => i32 = (k: i32): i32 => f(init) * k;
    return g(2);
}

function main(): i32 {
    print(apply(7, (n: i32): i32 => n + 1).to_string());
    print(apply("abcd", (s: string): i32 => s.len()).to_string());
    print(apply(Pair { a: 3, b: "xy" }, (p: Pair): i32 => p.a + p.b.len()).to_string());
    print(twice([1, 2, 3], (xs: i32[]): i32 => xs.len()).to_string());
    return 0;
}
