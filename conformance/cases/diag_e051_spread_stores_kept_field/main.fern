// A field value that stores a field the literal keeps from its base takes
// that part of the base. The literal then holds the part two times, so the
// local does not own it.
struct State { out: Writer, n: i32, name: string, label: string }

function bump(own s: State, by: i32): State {
  return State { ...s, n: s.n + by };
}

function step(own s0: State, k: i32): State {
  let s = State { ...s0, label: s0.name };
  if (k == 1) {
    return bump(s, 10);
  }
  return bump(s, 100);
}

function main(): i32 {
  let s = step(State { out: stdout(), n: 1, name: "a", label: "" }, 1);
  return s.n;
}
