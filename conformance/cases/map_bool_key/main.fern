import "core/map";





















function main(): i32 {
    let m: Map[boolean, i32] = map_new(2);
    m = m.insert(false, 7);
    m = m.insert(true, 5);
    if (m.len() != 2) { return 1; }
    if (!m.contains(true)) { return 2; }
    if (!m.contains(false)) { return 3; }
    if (m.get_or(true, 0) != 5) { return 4; }
    if (m.get_or(false, 0) != 7) { return 5; }

    let ks: boolean[] = m.keys();
    if (ks.len() != 2) { return 6; }
    if (ks[0]) { return 7; }
    if (!ks[1]) { return 8; }


    if (m.get_or(ks[0], 0) != 7) { return 9; }
    if (m.get_or(ks[1], 0) != 5) { return 10; }

    let trues: i32 = 0;
    let sum: i32 = 0;
    for (k, v) in m {
        if (k) { trues = trues + 1; }
        sum = sum + v;
    }
    if (trues != 1) { return 11; }
    if (sum != 12) { return 12; }


    m = m.insert(false, 30);
    if (m.len() != 2) { return 13; }
    if (m.get_or(false, 0) != 30) { return 14; }
    if (m.get_or(true, 0) != 5) { return 15; }

    match (m.get(true)) {
        Some(v) => { return v + 37; },
        None => { return 16; }
    }
}
