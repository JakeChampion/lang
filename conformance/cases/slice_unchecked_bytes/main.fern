// spec: ST-03
//
// `slice_unchecked(s, a, b)` is the byte slice under its honest name.
// It indexes BYTES, not code points, and it performs no code-point
// boundary check — the two bounds here cut the two-byte `é` of "héllo"
// in half and it hands the half back regardless. That is the whole
// reason the checked `s[a:b]` exists alongside it, and the reason this
// spelling is the one that reads as unchecked at the call site.
//
// The length is printed rather than the bytes: the result is not valid
// UTF-8, so what a terminal makes of it is not something to pin.
import "core/int";

function main(): i32 {
    var m: string = "héllo";          // 68 C3 A9 6C 6C 6F
    print(int.int_to_string(slice_unchecked(m, 1, 2).len()));   // 1: half of é
    print(int.int_to_string(slice_unchecked(m, 2, 4).len()));   // 2: the other half + l
    print(int.int_to_string(slice_unchecked(m, 0, 6).len()));   // 6: the whole string
    return 0;
}
