// spec: AL-01
//
// Pushing a value that was BOUND to a local first — `var v = …;
// xs = xs.append(v)` — must cost the same fresh memory as pushing the
// identical value inline. It did not: the element took a retain (the
// same `needsRcIncOnAlias` one an array literal's elements take) AND an
// escape taint, and the taint suppressed the release that would have
// balanced the retain, so one box per push was stranded.
//
// Both shapes here reach the buffer by different routes. The direct one
// leaked 320 B a round in a loop. The nested one — the push sitting in a
// struct literal's field, which is how an immutable accumulator threads
// through a loop — survived a fix to the direct shape, because the move
// analysis only ever looked one level into the statement.
//
// The straight-line half is the one that pins the cause: `build_ordered`
// and `build_swapped` differ ONLY in the order of two adjacent, mutually
// independent declarations, and that alone decided whether the push
// leaked (the exit sweep runs in declaration order, and the element's
// flat dec landing after the buffer's deep drop never reaches zero).
//
// The case prints the SHAPE, never a byte count — see
// docs/ALLOCATION-OBSERVABLE.md.
import "std/i32";
import "std/i64";

struct Val { kind: i32, kids: i32[] }
struct Doc { vals: Val[], root: i32 }

function direct(n: i32): i32 {
    var vals: Val[] = [];
    var total: i32 = 0;
    for i in 0..n {
        var v: Val = Val { kind: i, kids: [i, i + 1] };
        vals = vals.append(v);
        total = total + vals.len();
    }
    return total;
}

function nested(n: i32): i32 {
    var d: Doc = Doc { vals: [], root: 0 };
    var total: i32 = 0;
    for i in 0..n {
        var v: Val = Val { kind: i, kids: [i, i + 1] };
        d = Doc { ...d, vals: d.vals.append(v) };
        total = total + d.vals.len();
    }
    return total;
}

// Array declared BEFORE the element.
function build_ordered(k: i32): i32 {
    var vals: Val[] = [];
    var v: Val = Val { kind: k, kids: [k] };
    vals = vals.append(v);
    return vals.len();
}

// The same two declarations, swapped. Nothing else differs.
function build_swapped(k: i32): i32 {
    var v: Val = Val { kind: k, kids: [k] };
    var vals: Val[] = [];
    vals = vals.append(v);
    return vals.len();
}

function rounds(n: i32): i32 {
    var acc: i32 = 0;
    for i in 0..n {
        acc = acc + direct(8) + nested(8) + build_ordered(i) + build_swapped(i);
    }
    return acc;
}

function main(): i32 {
    var b0: i64 = __heap_bump_bytes();
    var x: i32 = rounds(50);
    var b1: i64 = __heap_bump_bytes();
    var y: i32 = rounds(100);
    var b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());
    // Twice the work must not cost more fresh memory.
    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
