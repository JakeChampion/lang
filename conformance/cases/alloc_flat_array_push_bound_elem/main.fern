// spec: AL-01






















import "std/i32";
import "std/i64";

struct Val { kind: i32, kids: i32[] }
struct Doc { vals: Val[], root: i32 }

function direct(n: i32): i32 {
    let vals: Val[] = [];
    let total: i32 = 0;
    for i in 0..n {
        let v: Val = Val { kind: i, kids: [i, i + 1] };
        vals = vals.append(v);
        total = total + vals.len();
    }
    return total;
}

function nested(n: i32): i32 {
    let d: Doc = Doc { vals: [], root: 0 };
    let total: i32 = 0;
    for i in 0..n {
        let v: Val = Val { kind: i, kids: [i, i + 1] };
        d = Doc { ...d, vals: d.vals.append(v) };
        total = total + d.vals.len();
    }
    return total;
}


function build_ordered(k: i32): i32 {
    let vals: Val[] = [];
    let v: Val = Val { kind: k, kids: [k] };
    vals = vals.append(v);
    return vals.len();
}


function build_swapped(k: i32): i32 {
    let v: Val = Val { kind: k, kids: [k] };
    let vals: Val[] = [];
    vals = vals.append(v);
    return vals.len();
}

function rounds(n: i32): i32 {
    let acc: i32 = 0;
    for i in 0..n {
        acc = acc + direct(8) + nested(8) + build_ordered(i) + build_swapped(i);
    }
    return acc;
}

function main(): i32 {
    let b0: i64 = __heap_bump_bytes();
    let x: i32 = rounds(50);
    let b1: i64 = __heap_bump_bytes();
    let y: i32 = rounds(100);
    let b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());

    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
