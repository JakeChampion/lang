















import "std/i32";

struct Unit { name: string, factor: i32 }

function table(): Unit[] {
    return [
        Unit { name: "m", factor: 1 },
        Unit { name: "km", factor: 1000 },
        Unit { name: "cm", factor: -100 },
    ];
}

function find(name: string): Option[Unit] {
    let us: Unit[] = table();
    for i in 0..us.len() {
        if (us[i].name == name) { return Some(us[i]); }
    }
    return None;
}

function last(name: string): Option[Unit] {
    let us: Unit[] = table();
    let found: Option[Unit] = None;
    for i in 0..us.len() {
        if (us[i].name == name) { found = Some(us[i]); }
    }
    return found;
}

function factor_of(o: Option[Unit]): i32 {
    match (o) {
        Some(u) => { return u.factor; },
        None => { return 0; },
    }
}

function name_of(o: Option[Unit]): string {
    match (o) {
        Some(u) => { return u.name; },
        None => { return "?"; },
    }
}

function main(): i32 {


    let total: i32 = 0;
    for i in 0..8 {
        total = total + factor_of(find("km"));
        total = total + factor_of(last("km"));
        total = total + factor_of(find("cm"));
        total = total + factor_of(last("cm"));
    }

    print(total.to_string());




    print(name_of(find("m")));
    print(name_of(last("cm")));
    print(name_of(find("furlong")));

    if (total != 14400) { return 1; }
    return 0;
}
