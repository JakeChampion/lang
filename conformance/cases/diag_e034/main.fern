// Pins E034. The program is the example from that code's entry
// in the diagnostic catalogue (`fern explain E034`), so this case
// also checks the catalogue's example really does produce the error
// it documents.
function main(): i32 {
    let xs: i32[] = [1, "two"];   // error[E034]: array element: expected i32, got string

    let i: f32 = 0.5;
    let x: i32 = xs[i];           // error[E034]: index must be i32, got f32

    let n: i32 = 42;
    return n[0];                  // error[E034]: indexing non-array value of type i32
}
