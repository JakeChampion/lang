// More lane values live at once than there are vector registers, across
// calls, beside f64 values: each spills to a 16-byte slot of its own and
// comes back whole.
import "std/f64";

function bump(x: f64): f64 {
  return x + 0.5;
}

function main(): i32 {
  let v0: f64x2 = __f64x2_of(1.0, -1.0);
  let v1: f64x2 = v0 + __f64x2_splat(1.0);
  let v2: f64x2 = v1 * __f64x2_splat(2.0);
  let v3: f64x2 = v2 - v0;
  let v4: f64x2 = v3 / __f64x2_splat(4.0);
  let v5: f64x2 = v4 + v1;
  let v6: f64x2 = v5 * v2;
  let v7: f64x2 = v6 - v3;
  let v8: f64x2 = v7 + v4;
  let v9: f64x2 = v8 * v0;
  let v10: f64x2 = v9 + v5;
  let v11: f64x2 = v10 - v6;
  let v12: f64x2 = v11 * v7;
  let v13: f64x2 = v12 + v8;
  let v14: f64x2 = v13 - v9;
  let v15: f64x2 = v14 + v10;
  let s0: f64 = bump(__f64x2_lane(v15, 0));
  let s1: f64 = bump(__f64x2_lane(v14, 1));
  let s2: f64 = bump(s0 + s1);
  let w: f32x4 = __f32x4_of(1.0, 2.0, 3.0, 4.0);
  let r: f64x2 = v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15;
  let s3: f64 = bump(s2);
  print(__f64x2_lane(r, 0).to_string() + " " + __f64x2_lane(r, 1).to_string());
  print(s0.to_string() + " " + s1.to_string() + " " + s2.to_string() + " " + s3.to_string());
  print((__f32x4_lane(w, 3) as f64).to_string() + " " + __f64x2_lane(v15, 1).to_string() + " " + __f64x2_lane(v7, 0).to_string());
  return 0;
}
