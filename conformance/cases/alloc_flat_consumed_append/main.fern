// spec: AL-01





















import "std/i32";
import "std/i64";

function sink(xs: i32[]): i32 {
    let s: i32 = 0;
    for i in 0..xs.len() { s = s + xs[i]; }
    return s;
}

function walk(path: i32[]): i32 {
    let t: i32 = 0;
    for i in 0..8 { t = t + sink(path.append(i)); }
    return t;
}

function round(n: i32): i32 {
    let full: i32[] = [n, n + 1];
    let roomy: i32[] = [];
    for i in 0..3 { roomy = roomy.append(n + i); }
    let xs: i32[][] = [[n], [n + 1]];

    let a: i32 = sink(full.append(10)) + sink(roomy.append(20)) + sink(xs[0].append(30));
    let b: i32 = sink(full) + sink(roomy) + sink(xs[0]) + sink(xs[1]);
    return a + b + walk(full) + full.len() + roomy.len() + xs[0].len();
}

function rounds(n: i32): i32 {
    let acc: i32 = 0;
    for i in 0..n {
        acc = acc + round(i);
    }
    return acc;
}

function main(): i32 {
    let b0: i64 = __heap_bump_bytes();
    let x: i32 = rounds(50);
    let b1: i64 = __heap_bump_bytes();
    let y: i32 = rounds(100);
    let b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());

    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
