







struct Box {
    xs: i32[],
}

function push_box(own b: Box, x: i32): Box {
    let ys: i32[] = b.xs.append(x);
    return Box { xs: ys };
}

function main(): i32 {
    let a: Box = Box { xs: [] };
    let i: i32 = 0;
    while (i < 500) {
        a = push_box(a, i);
        i = i + 1;
    }
    let n: i32 = a.xs.len();
    let first: i32 = a.xs[0];
    let last: i32 = a.xs[499];
    if (n != 500) { print("BAD len"); return 1; }
    if (first != 0) { print("BAD first"); return 2; }
    if (last != 499) { print("BAD last"); return 3; }
    print("ok");
    return 0;
}
