// shadow_destructure_in_lambda's property one pattern spelling over: a
// lambda's STRUCT-pattern parameter binds names that SHADOW the enclosing
// function's locals. The binders are renamed so the slot map's names stay
// unique within the function, and the checker registers each one as a
// synthetic local against the body that declares it — a lambda's locals
// belong to its own synthetic decl, not to the enclosing function — so the
// two have to be renamed together.
//
// The inner bindings must read the destructured argument and the outer ones
// must survive untouched, so this asserts both rather than merely exiting 0.
//
// One destructure site, on purpose: two in one function abort the wasm owned
// model (#7307).
struct Point { x: i32, y: i32 }

function main(): i32 {
    var x: i32 = 1;
    var y: i32 = 2;

    var lam = function (Point { x, y }: Point): i32 { return x * 10 + y; };
    if (lam(Point { x: 3, y: 4 }) != 34) { return 1; }

    if (x != 1) { return 2; }
    if (y != 2) { return 3; }
    return 0;
}
