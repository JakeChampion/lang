












struct Hold { t: (i32, i32[]), n: i32 }

function keepit(t: (i32, i32[]), n: i32): Hold { return Hold { t: t, n: n }; }

function shared(i: i32): i32 {
    let k: (i32, i32[]) = (i, [i, i + 1]);
    let h1: Hold = Hold { t: k, n: 1 };
    let h2: Hold = Hold { t: k, n: 2 };
    let a: i32 = h1.t.1[0];
    let b: i32 = h2.t.1[1];
    if (a != i) { return 0 - 1; }
    if (b != i + 1) { return 0 - 1; }
    return a + b + h1.n + h2.n;
}

function viaparam(i: i32): i32 {
    let k: (i32, i32[]) = (i, [i, i + 3]);
    let h: Hold = keepit(k, 4);
    let v: i32 = h.t.1[1];
    if (v != i + 3) { return 0 - 1; }
    return v + h.n;
}

function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let s: i32 = shared(i);
        let p: i32 = viaparam(i);
        if (s < 0 || p < 0) { return 253; }
        acc = acc + s + p;
        i = i + 1;
    }
    if (__rc_underflow_count() != 0) { return 251; }
    return acc % 113;
}
