// spec: RH-04

struct Handle { n: i32 }

function (h: Handle) read(): i32 {
  return h.n;
}

function (own h: Handle) close(): void {}

function factory(h: Handle): () => () => i32 {
  return (): (() => i32) => (): i32 => h.read();
}

function read_closed(own h: Handle): i32 {
  let next = factory(h);
  let read = next();
  h.close();
  return read();
}

function main(): i32 {
  return read_closed(Handle { n: 7 });
}
