struct B[T] { v: T }

function wrap[A](f: () => A): A {
  let g = (): A => f();
  return g();
}

function compose[A, B, C](f: (A) => B, g: (B) => C): (A) => C {
  return (x: A): C => g(f(x));
}

function same[A](f: (A) => A): (A) => A {
  return (x: A): A => f(x);
}

function drop[A](f: () => A): i32 {
  let g = (): i32 => {
    f();
    return 7;
  };
  return g();
}

function count[A](f: () => A[]): i32 {
  let g = (): i32 => f().len();
  return g();
}

function boxed[A](f: () => B[A]): A {
  let g = (): A => f().v;
  return g();
}

function main(): i32 {
  print(wrap((): i32 => 1));
  print(wrap((): string => "text"));
  let inc_len = compose((s: string): i32 => s.len(), (n: i32): i32 => n + 1);
  print(inc_len("four"));
  let twice = same((x: i32): i32 => x * 2);
  print(twice(21));
  print(drop((): string => "unused"));
  print(count((): i32[] => [1, 2, 3]));
  print(count((): string[] => ["a", "b"]));
  print(boxed((): B[f64] => B { v: 2.5 }));
  return 0;
}
