// Pins E061. The program is the example from that code's entry
// in the diagnostic catalogue (`fern explain E061`), so this case
// also checks the catalogue's example really does produce the error
// it documents.
function main(): i32 {
var x: i32 = {
    var a: i32 = 1;
    a + 1;               // error[E061]: trailing `;` makes this a statement, so the block has no value
};

    return 0;
}
