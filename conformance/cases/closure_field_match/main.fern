






















struct C { value: i32 }
struct S { name: string, run: (C) => Result[C, string] }
struct O { name: string, pick: (i32) => Option[i32] }

function bump(c: C): Result[C, string] {
    if (c.value < 0) { return Err("negative"); }
    return Ok(C { value: c.value + 1 });
}

function refuse(c: C): Result[C, string] { return Err("always"); }

function halve(n: i32): Option[i32] {
    if (n % 2 == 0) { return Some(n / 2); }
    return None;
}

function (s: S) twice(c: C): Result[C, string] {
    return Ok(C { value: c.value + 2 });
}


function direct(i: i32): i32 {
    let st: S = S { name: "b", run: bump };
    match (st.run(C { value: i })) {
        Ok(n) => { return n.value; },
        Err(e) => { return 253; }
    }
    return 253;
}


function elem(i: i32): i32 {
    let sts: S[] = [S { name: "b", run: bump }, S { name: "r", run: refuse }];
    let acc: i32 = 0;
    match (sts[0].run(C { value: i })) {
        Ok(n) => { acc = acc + n.value; },
        Err(e) => { return 253; }
    }
    match (sts[1].run(C { value: i })) {
        Ok(n) => { return 252; },
        Err(e) => { acc = acc + e.len(); }
    }
    return acc;
}


function opt(i: i32): i32 {
    let o: O = O { name: "h", pick: halve };
    let acc: i32 = 0;
    match (o.pick(i * 2)) {
        Some(v) => { acc = acc + v; },
        None => { return 253; }
    }
    match (o.pick(i * 2 + 1)) {
        Some(v) => { return 252; },
        None => { acc = acc + 1; }
    }
    return acc;
}


function err(i: i32): i32 {
    let st: S = S { name: "r", run: refuse };
    match (st.run(C { value: i })) {
        Ok(n) => { return 253; },
        Err(e) => { return e.len(); }
    }
    return 253;
}


function method(i: i32): i32 {
    let st: S = S { name: "b", run: bump };
    match (st.twice(C { value: i })) {
        Ok(n) => { return n.value; },
        Err(e) => { return 253; }
    }
    return 253;
}

function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        acc = acc + direct(i) + elem(i) + opt(i) + err(i) + method(i);
        i = i + 1;
    }
    if (__rc_underflow_count() != 0) { return 251; }
    return acc % 113;
}
