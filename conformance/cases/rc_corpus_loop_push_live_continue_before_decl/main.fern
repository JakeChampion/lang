








import "core/int";
struct Val { kind: i32, kids: i32[] }
function build(n: i32): i32 {
    let vals: Val[] = [];
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        i = i + 1;
        if (i % 2 == 0) { continue; }
        let v: Val = Val { kind: i, kids: [i] };
        vals = vals.append(v);
        total = total + vals.len() + vals[vals.len() - 1].kids[0];
    }
    return total;
}
function main(): i32 { return (build(6) - 15) + __rc_underflow_count(); }
