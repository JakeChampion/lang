




import "core/int";
import "std/u64";

function wide(a: i64): usize {
    return a as usize;
}

function main(): i32 {
    let past_i32: usize = 2147483648;
    let u32_max: usize = 4294967295;
    let two_32: usize = 4294967296;
    let max: usize = 18446744073709551615;
    let max_hex: usize = 0xFFFFFFFFFFFFFFFF;
    let folded: usize = 2147483647 + 1;
    print(past_i32.to_string());
    print(folded.to_string());
    print(u32_max.to_string());
    print(two_32.to_string());
    print(max.to_string());
    if (max == max_hex) {
        print("hex and decimal agree");
    }
    print((wide(4294967295) + wide(1)).to_string());
    print((wide(0) - wide(1)).to_string());
    print((u32_max + 1).to_string());
    print((max + 1).to_string());
    print((max * 2).to_string());
    print((wide(1) << 63).to_string());
    print((wide(1) << 64).to_string());
    print((max >> 1).to_string());
    print((max / 3).to_string());
    print((max % 10).to_string());
    if (wide(0) - wide(1) > wide(0)) {
        print("a borrow reads unsigned");
    }
    print(f"{two_32 - 1}");
    return 0;
}
