









import "std/i32";

function at(a: f32[], i: i32): f32 { return a[i]; }

function is_nan(a: f32[], i: i32): boolean {
    let v: f32 = a[i];
    return v != v;
}

function width(a: f32[]): i32 { return a.len(); }






struct Box { xs: f32[] }

function main(): i32 {
    let xs: f32[] = [1.5, 2.5, 4.0];
    if (is_nan(xs, 0)) { return 1; }
    let a: f32 = at(xs, 2);
    if (a < 3.9 || a > 4.1) { return 2; }
    let b: f32 = at(xs, 1);
    if (b < 2.4 || b > 2.6) { return 3; }


    if (width(xs).to_string() != "3") { return 4; }
    let bx: Box = Box { xs: [1.5, 2.5] };
    if (bx.xs[0] < 1.4 || bx.xs[0] > 1.6) { return 5; }
    if (bx.xs.len() != 2) { return 6; }
    return 7;
}
