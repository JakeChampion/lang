import "core/int";
import "std/json";

function main(): i32 {
  match (json.parse("{\"a\":1,\"b\":[2,3],\"c\":\"hi\"}")) {
    Ok(v) => {
      match (json.json_get_i32(v, "a")) {
        Some(n) => {
          if (n != 1) {
            print("FAIL geti");
            return 11;
          }
        },
        None => {
          print("FAIL geti-none");
          return 12;
        }
      }
      match (json.json_get_string(v, "c")) {
        Some(s) => {
          if (s != "hi") {
            print("FAIL gets");
            return 13;
          }
        },
        None => {
          print("FAIL gets-none");
          return 14;
        }
      }
      let enc: string = json.json_encode(v);
      match (json.parse(enc)) {
        Ok(v2) => {
          print("OK");
          return 0;
        },
        Err(_) => {
          print("FAIL reparse");
          return 15;
        }
      }
    },
    Err(_) => {
      print("FAIL parse");
      return 16;
    }
  }
}
