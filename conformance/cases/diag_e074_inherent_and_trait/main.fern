



trait Show { function show(self: Self): string; }

struct P { a: i32 }
impl Show for P { function show(self: Self): string { return "trait"; } }
function (p: P) show(): string { return "inherent"; }

struct Q { a: i32 }
function (q: Q) show(): string { return "inherent"; }
impl Show for Q { function show(self: Self): string { return "trait"; } }

function main(): i32 {
    return 0;
}
