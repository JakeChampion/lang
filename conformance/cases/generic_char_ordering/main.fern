import "core/cmp";

// An Ord-bounded comparison also orders char values after instantiation.
function lt_op[T: cmp.Ord](a: T, b: T): boolean { return a < b; }
function ge_op[T: cmp.Ord](a: T, b: T): boolean { return a >= b; }
function same_op[T: cmp.Eq](a: T, b: T): boolean { return a == b; }

function show(label: string, v: boolean): void {
    if (v) {
        print(label + " true");
    } else {
        print(label + " false");
    }
}

function main(): i32 {
    show("'a' < 'b'", lt_op('a', 'b'));
    show("'z' < 'a'", lt_op('z', 'a'));
    show("'q' >= 'q'", ge_op('q', 'q'));
    show("'a' == 'a'", same_op('a', 'a'));
    show("3 < 4", lt_op(3, 4));
    return 0;
}
