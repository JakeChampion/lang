// The unsafe obligation stays on a function that a module exports again.
// The importer accepts it in an unsafe block; a bare qualified call is refused.
import "./facade";

function accepted(): i32 {
    let v: i32 = 0;
    unsafe {
        v = facade.raw();
    }
    return v;
}

function main(): i32 {
    return accepted() + facade.raw();
}
