








struct P { tag: string, n: i32 }
function strs(k: string): i32 {
    let a: string = "s" + k;
    let b: string = "";
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        b = a;
        a = b + "x";
        total = total + b.len();
        i = i + 1;
    }
    return total;
}
function arms(k: string): i32 {
    let a: string = "t" + k;
    let b: string = "";
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        b = a;
        if (i % 2 == 0) {
            a = b + "y";
        } else {
            a = "z" + k;
        }
        total = total + b.len();
        i = i + 1;
    }
    return total;
}
function arrs(k: string): i32 {
    let a: i32[] = [k.len()];
    let b: i32[] = [];
    let i: i32 = 0;
    while (i < 50) {
        b = a;
        a = b.append(i);
        i = i + 1;
    }
    return b.len() + a.len();
}
function structs(k: string): i32 {
    let a: P = P { tag: "p" + k, n: 0 };
    let b: P = P { tag: "", n: 0 };
    let i: i32 = 0;
    while (i < 50) {
        b = a;
        a = P { tag: b.tag + "q", n: b.n + 1 };
        i = i + 1;
    }
    return a.n + b.tag.len();
}
function early(k: string, stop: i32): i32 {
    let a: string = "e" + k;
    let b: string = "";
    let i: i32 = 0;
    while (i < 50) {
        b = a;
        if (i == stop) {
            return b.len();
        }
        a = b + "w";
        i = i + 1;
    }
    return a.len();
}
function broken(k: string): i32 {
    let a: string = "b" + k;
    let b: string = "";
    let i: i32 = 0;
    while (i < 50) {
        b = a;
        if (i == 40) {
            break;
        }
        a = b + "v";
        i = i + 1;
    }
    return a.len() + b.len();
}
function main(): i32 {
    let bad: i32 = 0;
    if (strs("7") != 1325) { bad = bad + 1; }
    if (arms("7") != 125) { bad = bad + 2; }
    if (arrs("7") != 101) { bad = bad + 4; }
    if (structs("7") != 101) { bad = bad + 8; }
    if (early("7", 10) != 12) { bad = bad + 16; }
    if (broken("7") != 84) { bad = bad + 32; }
    return bad + __rc_underflow_count();
}
