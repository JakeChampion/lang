struct Handle { fd: i32 }

function (own h: Handle) close(): void {}

function read(h: Handle): i32 {
  return h.fd;
}

struct Box { run: () => i32 }

function call(b: Box): i32 {
  return b.run();
}

function make(h: Handle): Box {
  return Box { run: (): i32 => read(h) };
}

function main(): i32 {
  let h = Handle { fd: 3 };
  let b = make(h);
  h.close();
  return call(b);
}
