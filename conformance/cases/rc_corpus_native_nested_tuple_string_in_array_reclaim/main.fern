











import "core/int";
import "std/string";
function mk(): i32 {
    let a: (string, i32)[] = [("value-aaaaaaaaaaaaaaaaaa-" + "1", 7)];
    return a[0].0.len() + a[0].1;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 16500) + __rc_underflow_count();
}
