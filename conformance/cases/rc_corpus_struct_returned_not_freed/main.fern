







import "core/int";
struct Holder { xs: i32[], n: i32 }
function make_holder(k: i32): Holder {
    let h: Holder = Holder { xs: [k, k + 1], n: k };
    return h;
}
function main(): i32 {
    let got: i32 = 0;
    let k: i32 = 0;
    while (k < 50) {
        let h: Holder = make_holder(k);
        got = got + h.xs[1] + h.n;
        k = k + 1;
    }
    return (got - 2500) + __rc_underflow_count();
}
