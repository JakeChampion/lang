







enum N { L(i32), B(i32, N[]) }
function bump(n: N, v: i32): N {
    match (n) {
        L(x) => { return n; },
        B(c, kids) => { return B(c + v, kids); },
    }
}
function main(): i32 {
    let t: N = B(0, [L(1), L(2), L(3)]);
    let i: i32 = 0;
    while (i < 3) { t = bump(t, i); i = i + 1; }
    match (t) { L(x) => { return 7; }, B(c, k) => { return c - 3 + __rc_underflow_count(); } }
}
