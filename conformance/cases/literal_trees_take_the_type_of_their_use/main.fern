// A tree of integer literals has no type of its own. It takes the type of
// the operand beside it, or of its destination. A literal that does not fit
// i32 makes the tree i64. A suffix or a cast gives a tree its type.
function main(): i32 {
    let small: u8 = 200;
    let a = (1 + 2 * 3) + small;
    let b = small + (40 / 2 - 5 % 3);
    let c = (1 << 3 | 2 ^ 7 & 5) + small;
    let wide = 2147483648 + 1 - 2;
    let low = -2147483648;
    let lower = -2147483649 + 1 + 1;
    let pos = 5 - -(-3);
    let half: f64 = 1 + 2 * 3 / 4;
    let third: f32 = 2.5f32;
    let scaled = third * (1 + 1);
    let moved: i64 = (1 + 2) as i64 + 4000000000;
    let suffixed = 1u8 + 2 + 3;
    let shifted: i64 = 1 << 40;
    let big: i64 = 5;
    let mixed = 1 + 1 + big + 1 + 1;
    print(f"{a} {b} {c} {wide} {low} {lower} {pos}");
    print(f"{half} {scaled} {moved} {suffixed} {shifted} {mixed}");
    return 0;
}
