// E089: a const argument is an integer literal or a const parameter in
// scope. A local value or an expression is refused, because the argument
// names the instance the call runs. `ok` shows what is accepted.
function filled[const N: i32](x: f64): f64[] {
  let out: f64[] = [];
  while (out.len() < N) {
    out = out.append(x);
  }
  return out;
}

function ok[const M: i32](): i32 {
  return filled[M](1.0).len() + filled[2](1.0).len();
}

function main(): i32 {
  let k: i32 = 2;
  let a: i32 = filled[k](1.0).len();
  let b: i32 = filled[k + 1](1.0).len();
  return a + b + ok[1]();
}
