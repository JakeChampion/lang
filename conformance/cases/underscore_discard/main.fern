










function pair(): (i32, i32) {
    return (10, 3);
}


function constant(_: i32, _: string): i32 {
    return 7;
}

function main(): i32 {

    let (a, _) = pair();
    let (_, b) = pair();


    let (_, _) = pair();


    let _ = 99;
    let _ = 98;


    let m: i32 = 0;
    match (Some(5)) {
        Some(_) => { m = 1; },
        None => { m = 2; },
    }


    return a + b + constant(1, "x") + m;
}
