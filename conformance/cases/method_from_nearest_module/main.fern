// A method call resolves to the nearest module that declares the method:
// main imports near directly and reaches far only through mid, so near wins
// here, while mid, which imports far, gets far's methods.
import "near";
import "mid";
import "shape";

function main(): i32 {
    let xs: i32[] = [1, 2, 3];
    let p: shape.P = shape.P { w: 3, h: 4 };
    return xs.score() + mid.far_score(xs) + p.area() + mid.far_area(p);
}
