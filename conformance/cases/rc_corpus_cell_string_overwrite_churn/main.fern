











import "std/string";
function main(): i32 {
    let n: i32 = 0;
    let base: string = "hello";
    let i: i32 = 0;
    while (i < 100) {
        let c = cell_new(base + "_a");
        c.set(base + "_bb");
        let s = c.get();
        n = n + s.len();
        i = i + 1;
    }
    return (n - 800) + __rc_underflow_count();
}
