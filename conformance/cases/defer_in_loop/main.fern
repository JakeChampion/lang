












import "std/i32";



function counted(): i32 {
    let i: i32 = 0;
    while (i < 3) {
        let k: i32 = i * 10;
        defer print("w" + k.to_string());
        i = i + 1;
    }
    print("w-done");
    return i;
}



function ranged(): i32 {
    for i in 0..3 {
        defer print("f" + i.to_string());
    }
    print("f-done");
    return 0;
}



function edges(): i32 {
    let i: i32 = 0;
    while (i < 5) {
        let k: i32 = i;
        defer print("e" + k.to_string());
        i = i + 1;
        if (k == 1) { continue; }
        if (k == 3) { break; }
    }
    print("e-done");
    return 0;
}


function nested(): i32 {
    let i: i32 = 0;
    outer: while (i < 2) {
        defer print("o" + i.to_string());
        let j: i32 = 0;
        while (j < 3) {
            let jj: i32 = j;
            defer print("i" + jj.to_string());
            if (jj == 1) { break outer; }
            j = j + 1;
        }
        i = i + 1;
    }
    print("n-done");
    return 0;
}






function ahead(): i32 {
    let i: i32 = 0;
    while (i < 4) {
        i = i + 1;
        if (i == 2) { continue; }
        if (i == 4) { break; }
        let k: i32 = i * 10;
        defer print("a" + k.to_string());
    }
    print("a-done");
    return 0;
}




function early(): i32 {
    defer print("fn-last");
    let i: i32 = 0;
    while (i < 4) {
        let k: i32 = i;
        defer print("r" + k.to_string());
        if (k == 2) { return 7; }
        i = i + 1;
    }
    return 0;
}

function main(): i32 {
    if (counted() != 3) { return 1; }
    let r: i32 = ranged();
    if (r != 0) { return 2; }
    let e: i32 = edges();
    if (e != 0) { return 3; }
    let n: i32 = nested();
    if (n != 0) { return 4; }
    if (ahead() != 0) { return 6; }
    if (early() != 7) { return 5; }
    return 0;
}
