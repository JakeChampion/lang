









import "std/async";
import "std/clock";
import "std/i32";
import "std/time";

function after(ms: i32): Option[Instant] {
  return Some(clock.instant().add(time.duration_millis(ms as i64)));
}

function nap(label: string, ms: i32, v: i32): i32 {
  defer print("done " + label);
  let none: i32[] = [];
  let r: async.Wake = async.wait_any(none, after(ms));
  return v;
}

function quiet(ms: i32, v: i32): i32 {
  let none: i32[] = [];
  let r: async.Wake = async.wait_any(none, after(ms));
  return v;
}

function show_opt(o: Option[i32]): string {
  match (o) {
    Some(v) => {
      return v.to_string();
    },
    None => {
      return "none";
    }
  }
}

function leaf(n: i32): i32 {
  let none: i32[] = [];
  if let async.Wake.TimedOut = async.wait_any(none, after(1)) {
    return n - 1;
  }
  return n;
}

function mid(n: i32): i64 {
  let big: i64 = 5000000000i64 + (n as i64);
  let acc: i32 = 0;
  let i: i32 = 0;
  while (i < 2) {
    acc = acc + leaf(n + i);
    i = i + 1;
  }
  return big + (acc as i64);
}

function top(n: i32): i32 {
  let s: string = "held" + n.to_string();
  let h: f64 = 2.5;
  let a: i64 = mid(n);
  return ((a - 5000000000i64) as i32) * 100 + s.len() + ((h * 2.0) as i32);
}




function held(): i32 {
  let t: async.Task[i32] = async.task_new(() => top(5));
  let st: async.TaskStatus[i32] = async.task_start(t);
  let out: i32 = 0 - 1;
  let going: boolean = true;
  while (going) {
    match (st) {
      Done(v) => {
        out = v;
        going = false;
      },
      Suspended(w) => {
        st = async.task_resume(t, async.wait_any(w.set, w.until));
      }
    }
  }
  return out;
}

function main(): i32 {
  let all: async.Future[i32][] = [async.spawn(() => nap("a", 20, 1)), async.spawn(() => nap("b", 40, 2)), async.spawn(() => nap("c", 60, 3))];
  let g: i32[] = async.block_on(async.gather(all)).unwrap_or([0, 0, 0]);
  print("gather " + g[0].to_string() + " " + g[1].to_string() + " " + g[2].to_string());
  let timed: async.Future[i32][] = [async.spawn(() => quiet(20, 7)), async.spawn(() => quiet(40, 8))];
  let d: Option[i32][] = async.block_on(async.with_deadline(clock.instant().add(time.duration_millis(2000)), timed)).unwrap_or([None, None]);
  print("deadline " + show_opt(d[0]) + " " + show_opt(d[1]));
  let race: async.Future[i32][] = [async.spawn(() => quiet(20, 2)), async.spawn(() => quiet(300, 1))];
  match (async.block_on(async.race(race))) {
    Some(won) => {
      print("race " + won.0.to_string() + " " + won.1.to_string());
    },
    None => {
      print("race none");
    }
  }
  print("held " + held().to_string());
  return 0;
}
