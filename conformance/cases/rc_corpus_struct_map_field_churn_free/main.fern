








import "core/int";
import "core/map";
import "std/string";
struct Req { headers: Map[string, string], n: i32 }
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        let m: Map[string, string] = map_new(8);
        m = m.insert("k", "v");
        let r: Req = Req { headers: m, n: i };
        acc = acc + r.headers.get_or("k", "x").len();
        i = i + 1;
    }
    return (acc - 50) + __rc_underflow_count();
}
