











function mk(): string {
    print("mk");
    return "hello";
}

function mka(): i32[] {
    print("mka");
    return [1, 2, 3, 4];
}

function main(): i32 {
    match (mk()[2:]) {
        Some(t) => { print(t); },
        None => { print("none"); }
    }

    let s: string = "world";
    match (s[:]) {
        Some(w) => { print(w); },
        None => { print("none"); }
    }

    let lo: i32 = 1;
    match (s[lo:]) {
        Some(v) => { print(v); },
        None => { print("none"); }
    }

    let xs: [i32] = mka()[2:];
    if (xs.len() == 2 && xs[0] == 3 && xs[1] == 4) { print("arr-ok"); }

    let ys: [i32] = xs[:];
    if (ys.len() == 2) { print("arr-full-ok"); }

    return 0;
}
