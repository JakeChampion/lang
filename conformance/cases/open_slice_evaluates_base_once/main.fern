// An open-ended slice evaluates its base EXACTLY ONCE.
//
// `a[lo:]` and `a[:]` name no upper bound, so the bound is the
// receiver's own length. Producing that by rewriting the base into
// `base.len()` puts two independent copies of the base in the tree, and
// a side-effecting base then runs twice — `mk()[2:]` called `mk()`
// twice. Nothing caught it because no test used a base with an effect;
// each print below is the effect, and a doubled line is the bug.
//
// Both legs are pinned: a string slice (checked, `Option[str]`) and an
// array slice (a view), under both the open-high and fully-open forms.

function mk(): string {
    print("mk");
    return "hello";
}

function mka(): i32[] {
    print("mka");
    return [1, 2, 3, 4];
}

function main(): i32 {
    match (mk()[2:]) {
        Some(t) => { print(t); },
        None => { print("none"); }
    }

    var s: string = "world";
    match (s[:]) {
        Some(w) => { print(w); },
        None => { print("none"); }
    }

    var lo: i32 = 1;
    match (s[lo:]) {
        Some(v) => { print(v); },
        None => { print("none"); }
    }

    var xs: [i32] = mka()[2:];
    if (xs.len() == 2 && xs[0] == 3 && xs[1] == 4) { print("arr-ok"); }

    var ys: [i32] = xs[:];
    if (ys.len() == 2) { print("arr-full-ok"); }

    return 0;
}
