// #13083: contextual primitive names settle as types in generic brackets.
function identity[T](x: T): T {
  return x;
}

function main(): i32 {
  let c: char = identity[char]('é');
  let source: string = "hello";
  let view: str = slice_unchecked(source, 1, 4);
  let same: str = identity[str](view);
  let literal: str = identity[str]("abc");
  let cs: char[] = identity[char[]](['é']);
  if (c != 'é' || same != "ell" || literal != "abc" || cs[0] != c) {
    return 1;
  }
  print("contextual type arguments ok");
  return 0;
}
