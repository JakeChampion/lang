const FLOAT32: f32 = 5;

const FLOAT64: f64 = -7;

const QUOTIENT: f64 = 5 / 2;

const FLOATS: f32[] = [1, 2];

const TEXT_LT: boolean = "a" < "b";

const TEXT_LE: boolean = "a" <= "a";

const TEXT_GT: boolean = "é" > "z";

const TEXT_GE: boolean = "β" >= "β";

const TEXT_FALSE: boolean = "b" < "a";

const CHAR_LT: boolean = 'a' < 'b';

const CHAR_LE: boolean = 'a' <= 'a';

const CHAR_GT: boolean = '🦊' > 'z';

const CHAR_GE: boolean = 'β' >= 'β';

const CHAR_FALSE: boolean = 'b' < 'a';

function main(): i32 {
  if (FLOAT32 != 5f32 || FLOAT64 != -7f64 || QUOTIENT != 2.5 || FLOATS[0] != 1f32 || FLOATS[1] != 2f32) {
    return 1;
  }
  if (!TEXT_LT || !TEXT_LE || !TEXT_GT || !TEXT_GE || TEXT_FALSE) {
    return 2;
  }
  if (!CHAR_LT || !CHAR_LE || !CHAR_GT || !CHAR_GE || CHAR_FALSE) {
    return 3;
  }
  print("const scalar ordering ok");
  return 0;
}
