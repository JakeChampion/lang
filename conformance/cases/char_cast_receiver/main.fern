






















import "std/unicode";


function inline_upper(i: i32): i32 {
    if (((97 as char).to_upper() as i32) != 65) { return 253; }
    if (((913 as char).to_lower() as i32) != 945) { return 252; }
    return 3;
}


function inline_unchanged(i: i32): i32 {
    if (((48 as char).to_upper() as i32) != 48) { return 253; }
    return 1;
}



function bound_local(i: i32): i32 {
    let c: char = 97 as char;
    if ((c.to_upper() as i32) != 65) { return 253; }
    return 1;
}



function other_casts(i: i32): i32 {
    if (((97 as i64) + (1 as i64)) as i32 != 98) { return 253; }
    if (((97 as f64) * (2 as f64)) as i32 != 194) { return 252; }
    return 2;
}

function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        acc = acc + inline_upper(i) + inline_unchanged(i) + bound_local(i) + other_casts(i);
        i = i + 1;
    }
    if (__rc_underflow_count() != 0) { return 251; }
    return acc % 113;
}
