











struct Point { x: i32, y: i32 }
function main(): i32 {
    let x: i32 = 1;
    let f = (Point { x, y }: Point): i32 => { return x * 10 + y; };
    let g = ((x, y): (i32, i32)): i32 => { return x + y; };
    return f(Point { x: 3, y: 4 }) + g((2, 3)) - 39 + x - 1 + __rc_underflow_count();
}
