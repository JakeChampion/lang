import "core/map";








function main(): i32 {
    let m: Map[i32, i32] = map_new(8);
    let i: i32 = 0;
    while (i < 5) { m = m.insert(i, i * 10); i = i + 1; }

    let gone: boolean = m.contains(1);
    let m1 = m.remove(1);
    if (!gone) { return 91; }
    if (m1.contains(1)) { return 92; }
    if (m1.len() != 4) { return 93; }

    let ks: i32[] = m1.keys();
    let vs: i32[] = m1.values();
    let order: i32 = 0;
    let total: i32 = 0;
    let j: i32 = 0;
    while (j < ks.len()) {
        order = order * 10 + ks[j];
        total = total + vs[j];
        j = j + 1;
    }
    if (order != 423) { return 94; }
    if (total != 90) { return 95; }


    let e: Map[i32, i32] = map_new(4);
    e = e.insert(5, 50);
    let missing: boolean = e.contains(99);
    let e1 = e.remove(99);
    if (missing) { return 96; }
    if (e1.len() != 1) { return 97; }
    if (e1.get_or(5, 0) != 50) { return 98; }

    let m3: Map[i32, i32] = m1.cleared();
    if (m3.len() != 0) { return 99; }
    m3 = m3.insert(7, 3);
    return m3.len() * 10 + m3.get_or(7, 0);
}
