import "std/io_buffered";
import "std/string";
import "core/int";





function main(): i32 {
    let w: BytesWriter = io_buffered.bytes_writer_new();
    w = w.write_string("ab");
    w = w.write_byte(67);
    w = w.write_bytes([68 as u8, 69 as u8]);
    print(w.len().to_string());
    match (w.into_string()) {
        Some(s) => { print(s); },
        None => { return 1; },
    }
    let w2: BytesWriter = w.reset();
    print(w2.len().to_string());
    if (w2.is_empty()) { print("empty"); } else { print("nonempty"); }
    return 0;
}
