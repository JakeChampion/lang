struct A { x: i32 }
struct B { y: i32 }
type AB = A | B;

struct Cur { pos: i32 }

function mk(k: i32, c: Cur): (AB, Cur) {
  if (k == 0) { return (A { x: 40 }, Cur { pos: c.pos + 1 }); }
  return (B { y: 2 }, Cur { pos: c.pos + 2 });
}

function main(): i32 {
  let c = Cur { pos: 0 };
  let (v1, c1) = mk(0, c);
  let (v2, c2) = mk(1, c1);
  let t = 0;
  match (v1) { A(a) => { t = t + a.x; }, B(b) => { t = t + b.y; } }
  match (v2) { A(a) => { t = t + a.x; }, B(b) => { t = t + b.y; } }
  return t - c2.pos + 3;
}
