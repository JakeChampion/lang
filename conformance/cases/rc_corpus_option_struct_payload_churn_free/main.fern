










import "core/int";
struct Item { tags: i32[] }
function mk(n: i32): Option[Item] { return Some(Item { tags: [n, n + 1] }); }
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let o: Option[Item] = mk(i);
        match (o) { Some(it) => { acc = acc + it.tags[1]; }, None => { acc = acc + 0; } }
        i = i + 1;
    }
    return (acc - 5050) + __rc_underflow_count();
}
