


function checked_div(a: i32, b: i32): Option[i32] {
    if (b == 0) { return None; }
    return Some(a / b);
}

function compute(): Option[i32] {
    let x: i32 = checked_div(84, 2)?;
    let y: i32 = checked_div(x, 1)?;
    return Some(y);
}

function main(): i32 {
    match (compute()) {
        Some(n) => { return n; },
        None => { return 1; }
    }
}
