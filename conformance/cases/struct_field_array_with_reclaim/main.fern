// Replacing an element of an array held in a STRUCT FIELD must reclaim the
// element it replaced.
//
// A bare local array always did: its receiver is a reassign-to-self move, so
// the copy-on-write helper takes its in-place branch and the overwritten
// element's drop is the sole owner's release. Reading the array out of a
// struct field leaves it at rc >= 2, which forces the COPY branch — and that
// branch retains every element, so the old buffer's release has to give
// those retains back. It was a buffer-only free, so it did not, and one
// element box leaked per call, unbounded.
//
// The assertion is on GROWTH, not on an absolute byte count: run the same
// loop at two round counts and require the allocation delta not to scale
// with the rounds. That survives any change to allocator sizes or layout
// while still failing the moment a per-round leak returns.

import "std/i32";
import "std/i64";

struct P { a: i32, b: i32 }
struct Box { items: P[], tag: i32 }

// The array lives in a struct field and is replaced through a struct-update
// literal — the shape every store, cache and index in the language has.
function churn(rounds: i32): i32 {
    var b: Box = Box { items: [P { a: 0, b: 0 }, P { a: 0, b: 0 }], tag: 0 };
    for i in 0..rounds {
        b = Box { ...b, items: b.items.with(i % 2, P { a: i, b: i + 1 }) };
    }
    return b.items[0].a + b.items[1].b;
}

// The same loop with the `.with` bound to a local first, so the struct-update
// literal is not what is being tested.
function churn_bound(rounds: i32): i32 {
    var b: Box = Box { items: [P { a: 0, b: 0 }, P { a: 0, b: 0 }], tag: 0 };
    for i in 0..rounds {
        var next: P[] = b.items.with(i % 2, P { a: i, b: i + 1 });
        b = Box { items: next, tag: b.tag };
    }
    return b.items[0].a + b.items[1].b;
}

// A bare local array — the branch that always worked. Here as the control:
// if this ever starts growing too, the change broke the working path rather
// than the broken one.
function churn_local(rounds: i32): i32 {
    var xs: P[] = [P { a: 0, b: 0 }, P { a: 0, b: 0 }];
    for i in 0..rounds { xs = xs.with(i % 2, P { a: i, b: i + 1 }); }
    return xs[0].a + xs[1].b;
}

// Growth per additional round, in bytes. Zero (or near it) means the loop
// reclaims what it replaces.
function growth_of(small: i64, large: i64, extra: i32): i64 {
    if (large <= small) { return 0; }
    return (large - small) / (extra as i64);
}

function report(name: string, small: i64, large: i64, extra: i32): boolean {
    var g: i64 = growth_of(small, large, extra);
    if (g > 0) {
        print(name + ": " + g.to_string() + " bytes leaked per round");
        return false;
    }
    print(name + ": flat");
    return true;
}

function main(): i32 {
    var ok: boolean = true;
    var checksum: i32 = 0;

    var b0: i64 = __heap_bump_bytes();
    checksum = checksum + churn(200);
    var b1: i64 = __heap_bump_bytes();
    checksum = checksum + churn(1000);
    var b2: i64 = __heap_bump_bytes();
    if (!report("struct field", b1 - b0, b2 - b1, 800)) { ok = false; }

    var c0: i64 = __heap_bump_bytes();
    checksum = checksum + churn_bound(200);
    var c1: i64 = __heap_bump_bytes();
    checksum = checksum + churn_bound(1000);
    var c2: i64 = __heap_bump_bytes();
    if (!report("bound first", c1 - c0, c2 - c1, 800)) { ok = false; }

    var d0: i64 = __heap_bump_bytes();
    checksum = checksum + churn_local(200);
    var d1: i64 = __heap_bump_bytes();
    checksum = checksum + churn_local(1000);
    var d2: i64 = __heap_bump_bytes();
    if (!report("bare local", d1 - d0, d2 - d1, 800)) { ok = false; }

    // The loops must also still compute the right thing: at round r the
    // element at r%2 holds (r, r+1), so the last two rounds decide.
    // rounds=1000 -> index 0 written at i=998 (a=998), index 1 at i=999 (b=1000).
    print(checksum.to_string());
    if (!ok) { return 1; }
    return 0;
}
