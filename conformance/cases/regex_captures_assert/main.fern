







import "std/regex";



function patterns(): string[] {
  return [
    "(a|ab)", "^(a+)", "([a-z]+)$", "\\b(cat)\\b", "(a?)*b",
    "((a|b)c)+", "x(\\d{2,3})y", "(?i)h(el+)o", "(\\w+)@(\\w+)", "(a*)(b*)",
  ];
}

function texts(): string[] {
  return [
    "xab", "aab", "Hello world", "a cat sat", "b", "acbcac",
    "x123y x45y", "say HELLO", "a@b c@d", "aabb", "", "cat", "?=ab",
  ];
}

function main(): i32 {
  let r: i32 = 0;


  let an: regex.RCaps = require_caps(regex.regex_captures("^(a+)", "aab"));
  if (require_regex_text(an.group(1)) == "aa" && at(an.group_start(0), 0)) {
    r = r + 1;
  }
  match (regex.regex_captures("^(b)", "ab")) {
    Some(_) => {},
    None => {
      r = r + 2;
    }
  }


  let en: regex.RCaps = require_caps(regex.regex_captures("([a-z]+)$", "Hello world"));
  if (require_regex_text(en.group(1)) == "world" && at(en.group_end(0), 11)) {
    r = r + 4;
  }


  let wb: regex.RCaps = require_caps(regex.regex_captures("\\b(cat)\\b", "a cat sat"));
  let nb: regex.RCaps = require_caps(regex.regex_captures("\\B(at)", "a cat sat"));
  if (at(wb.group_start(1), 2) && at(nb.group_start(1), 3)) {
    r = r + 8;
  }



  let ep: regex.RCaps = require_caps(regex.regex_captures("(a?)*b", "b"));
  if (ep.has_group(1) && at(ep.group_start(1), 0) && at(ep.group_end(1), 0)) {
    r = r + 16;
  }



  let uf: regex.RCaps = require_caps(regex.regex_captures("(?=a)(b)", "?=ab"));
  if (uf.group_count() == 1 && require_regex_text(uf.group(1)) == "b") {
    r = r + 32;
  }



  let ps: string[] = patterns();
  let ts: string[] = texts();
  let spans_agree: boolean = true;
  let i: i32 = 0;
  while (i < ps.len()) {
    let j: i32 = 0;
    while (j < ts.len()) {
      if (!same_span(regex.regex_captures(ps[i], ts[j]), regex.regex_search(ps[i], ts[j]))) {
        spans_agree = false;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  if (spans_agree) {
    r = r + 64;
  }


  let counts_agree: boolean = true;
  i = 0;
  while (i < ps.len()) {
    let j2: i32 = 0;
    while (j2 < ts.len()) {
      if (regex.regex_captures_all(ps[i], ts[j2]).len() != regex.regex_find_all(ps[i], ts[j2]).len()) {
        counts_agree = false;
      }
      j2 = j2 + 1;
    }
    i = i + 1;
  }
  if (counts_agree) {
    r = r + 128;
  }

  return r;
}



function same_span(c: Option[regex.RCaps], s: Option[regex.RMatch]): boolean {
  match (c) {
    Some(caps) => {
      if let Some(m) = s {
        return at(caps.group_start(0), m.start) && at(caps.group_end(0), m.end);
      }
      return false;
    },
    None => {
      if let Some(_) = s {
        return false;
      }
      return true;
    }
  }
  return false;
}


function require_caps(result: Option[regex.RCaps]): regex.RCaps {
  if let Some(c) = result {
    return c;
  }
  exit(1);
  return regex.RCaps { text: "", starts: [], ends: [], names: [] };
}

function at(o: Option[i32], want: i32): boolean {
  if let Some(v) = o {
    return v == want;
  }
  return false;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
