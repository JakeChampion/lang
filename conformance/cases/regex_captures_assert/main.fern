import "std/regex";
import "std/result";

function patterns(): string[] {
  return [
    "(a|ab)", "^(a+)", "([a-z]+)$", "\\b(cat)\\b", "(a?)*b",
    "((a|b)c)+", "x(\\d{2,3})y", "(?i)h(el+)o", "(\\w+)@(\\w+)", "(a*)(b*)",
  ];
}

function texts(): string[] {
  return [
    "xab", "aab", "Hello world", "a cat sat", "b", "acbcac",
    "x123y x45y", "say HELLO", "a@b c@d", "aabb", "", "cat", "?=ab",
  ];
}

function main(): i32 {
  let r: i32 = 0;

  // ^ anchor through the capture engine
  let an: regex.Captures = require_caps({ let __checked_regex_10: regex.Regex = match (regex.compile("^(a+)")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_10.captures("aab") });
  if (require_regex_text(match (an.group(1)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "aa" && at(an.group_start(0), 0)) {
    r = r + 1;
  }
  match ({ let __checked_regex_9: regex.Regex = match (regex.compile("^(b)")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_9.captures("ab") }) {
    Some(_) => {},
    None => {
      r = r + 2;
    }
  }

  // $ anchor
  let en: regex.Captures = require_caps({ let __checked_regex_8: regex.Regex = match (regex.compile("([a-z]+)$")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_8.captures("Hello world") });
  if (require_regex_text(match (en.group(1)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "world" && at(en.group_end(0), 11)) {
    r = r + 4;
  }

  // \b and \B word boundaries
  let wb: regex.Captures = require_caps({ let __checked_regex_7: regex.Regex = match (regex.compile("\\b(cat)\\b")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_7.captures("a cat sat") });
  let nb: regex.Captures = require_caps({ let __checked_regex_6: regex.Regex = match (regex.compile("\\B(at)")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_6.captures("a cat sat") });
  if (at(wb.group_start(1), 2) && at(nb.group_start(1), 3)) {
    r = r + 8;
  }

  // a group whose star body matches only empty still PARTICIPATES with
  // an empty span (Go: FindStringSubmatchIndex("(a?)*b","b") = [0,1,0,0])
  let ep: regex.Captures = require_caps({ let __checked_regex_5: regex.Regex = match (regex.compile("(a?)*b")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_5.captures("b") });
  if (ep.has_group(1) && at(ep.group_start(1), 0) && at(ep.group_end(1), 0)) {
    r = r + 16;
  }

  // Unsupported group syntax reports a typed compile error.
  match (regex.compile("(?=a)(b)")) {
    Err(error) => {
      if (error.kind == UnsupportedGroup && error.offset == 0) {
        r = r + 32;
      }
    },
    Ok(_) => {}
  }

  let ps: string[] = patterns();
  let ts: string[] = texts();
  let spans_agree: boolean = true;
  let i: i32 = 0;
  while (i < ps.len()) {
    let j: i32 = 0;
    while (j < ts.len()) {
      if (!same_span({ let __checked_regex_3: regex.Regex = match (regex.compile(ps[i])) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_3.captures(ts[j]) }, { let __checked_regex_2: regex.Regex = match (regex.compile(ps[i])) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_2.find(ts[j]) })) {
        spans_agree = false;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  if (spans_agree) {
    r = r + 64;
  }

  let counts_agree: boolean = true;
  i = 0;
  while (i < ps.len()) {
    let j2: i32 = 0;
    while (j2 < ts.len()) {
      if ({ let __checked_regex_1: regex.Regex = match (regex.compile(ps[i])) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_1.captures_all(ts[j2]) }.len() != { let __checked_regex_0: regex.Regex = match (regex.compile(ps[i])) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_0.find_all(ts[j2]) }.len()) {
        counts_agree = false;
      }
      j2 = j2 + 1;
    }
    i = i + 1;
  }
  if (counts_agree) {
    r = r + 128;
  }

  return r;
}

// same_span is whether both engines found a match with one span, or neither
// found one.
function same_span(c: Option[regex.Captures], s: Option[regex.Match]): boolean {
  match (c) {
    Some(caps) => {
      if let Some(m) = s {
        return at(caps.group_start(0), m.start) && at(caps.group_end(0), m.end);
      }
      return false;
    },
    None => {
      if let Some(_) = s {
        return false;
      }
      return true;
    }
  }
  return false;
}

// require_caps is the match, exiting 1 when there is none.
function require_caps(result: Option[regex.Captures]): regex.Captures {
  if let Some(c) = result {
    return c;
  }
  exit(1);
  return regex.Captures { text: "", starts: [], ends: [], names: [] };
}

function at(o: Option[i32], want: i32): boolean {
  if let Some(v) = o {
    return v == want;
  }
  return false;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
