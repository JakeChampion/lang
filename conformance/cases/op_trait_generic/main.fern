





import "std/num";
function sum3[T: num.Num](a: T, b: T, c: T): T { return a + b + c; }
function dsq[T: num.Num](a: T, b: T): T { return (a + b) * (a - b); }
function negate[T: num.Neg](a: T): T { return -a; }
function main(): i32 {
    let s: i32 = sum3(10, 20, 12);
    s = s + dsq(5, 3);
    s = s + negate(0 - 8);
    return s;
}
