




















enum S { Leaf(i32), Node(i32) }
function walk_expr(n: i32, acc: string[]): string[] { return acc.append("z"); }
function walk_stmt(st: S, acc: string[]): string[] {
    match (st) {
        Leaf(n) => { return walk_expr(n, acc); },
        Node(n) => {
            acc = walk_expr(n, acc);
            return acc;
        }
    }
    return acc;
}
function work(body: S[]): i32 {
    let none: string[] = [];
    let k: i32 = 0;
    let t: i32 = 0;
    while (k < body.len()) {
        let r: string[] = walk_stmt(body[k], none);
        t = t + r.len();
        k = k + 1;
    }
    return t + none.len();
}
function main(): i32 {
    let d: i32 = work([Node(1), Leaf(2)]);
    return (d - 2) + __rc_underflow_count();
}
