









function mk(seed: i32): i32 {
    let a: string = "a" + "x";
    let b: string = "b" + "y";
    let arr: string[] = [a, b];
    return arr[0].len() + arr[1].len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 200) { total = total + mk(k); k = k + 1; }
    return (total - 800) + __rc_underflow_count();
}
