



function inc(n: i32, by: i32 = 1): i32 { return n + by; }
function box(w: i32, h: i32 = 2, d: i32 = 3): i32 { return w * 100 + h * 10 + d; }
function tag(n: i32, label: string = "ab"): i32 { return n + label.len(); }

function main(): i32 {
    let ok: i32 = 0;
    if (inc(10) == 11) { ok = ok + 1; }
    if (inc(10, 5) == 15) { ok = ok + 1; }
    if (box(1) == 123) { ok = ok + 1; }
    if (box(1, 9) == 193) { ok = ok + 1; }
    if (box(1, 9, 8) == 198) { ok = ok + 1; }
    if (tag(4) == 6) { ok = ok + 1; }
    return ok;
}
