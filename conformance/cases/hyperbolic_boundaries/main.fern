// Reference bits: glibc 2.41 via Python math; f64 tolerance 4 ULP, f32 1 ULP.
// Includes adjacent threshold inputs, signed zero, subnormals, infinity and NaN.
import "std/f64";
import "std/f32";

struct Case64 { x: f64, s: i64, c: i64, t: i64 }

function near64(got: f64, want: i64): boolean {
  let actual: i64 = f64_bits(got);
  if (actual == want) {
    return true;
  }
  let magnitude: i64 = want & 0x7fffffffffffffff;
  if (magnitude > 0x7ff0000000000000) {
    return got != got;
  }
  if (magnitude == 0 || magnitude == 0x7ff0000000000000 || actual < 0 != want < 0) {
    return false;
  }
  let delta: i64 = (actual & 0x7fffffffffffffff) - magnitude;
  return delta >= -4 && delta <= 4;
}

