    let row = cases[i];
    if (!near32(row.x.sinh(), row.s)) {
      print(f"sinh32 case {i}: {f32_bits(row.x.sinh())} expected {row.s}");
      return 1;
    }
    if (!near32(row.x.cosh(), row.c)) {
      print(f"cosh32 case {i}: {f32_bits(row.x.cosh())} expected {row.c}");
      return 2;
    }
    if (!near32(row.x.tanh(), row.t)) {
      print(f"tanh32 case {i}: {f32_bits(row.x.tanh())} expected {row.t}");
      return 3;
    }
    i = i + 1;
  }
  return 0;
