struct Case32 { x: f32, s: i32, c: i32, t: i32 }

function near32(got: f32, want: i32): boolean {
  let actual: i32 = f32_bits(got);
  if (actual == want) {
    return true;
  }
  let magnitude: i32 = want & 0x7fffffff;
  if (magnitude > 0x7f800000) {
    return got != got;
  }
  if (magnitude == 0 || magnitude == 0x7f800000 || actual < 0 != want < 0) {
    return false;
  }
  let delta: i32 = (actual & 0x7fffffff) - magnitude;
  return delta >= -1 && delta <= 1;
}

