



import "std/regex";

function main(): i32 {
    let r: i32 = 0;
    if (regex.regex_match("((a|b)c)+", "acbcac")) { r = r + 1; }
    if (regex.regex_match("a(bc)?d", "ad")) { r = r + 2; }
    if (regex.regex_match("a(bc)?d", "abcd")) { r = r + 4; }
    if (regex.regex_match("^(a|ab)c$", "abc")) { r = r + 8; }
    if (regex.regex_match("^(foo|bar)+$", "foobarbar")) { r = r + 16; }
    if (regex.regex_match("gr(a|e)y", "gray")) { r = r + 32; }
    if (!regex.regex_match("^(cat|dog)$", "fox")) { r = r + 64; }
    return r;
}
