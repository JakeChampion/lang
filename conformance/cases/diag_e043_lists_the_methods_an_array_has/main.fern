// The method list of an unknown-method error names each visible method
// that the receiver can take: `twice` is generic, `total` takes only an
// i32[], and `top` needs an element that implements cmp.Ord.
import "./lib";

struct P { x: i32 }

function main(): i32 {
    let ps = [P { x: 1 }];
    return ps.zzqq();
}
