

















import "std/i32";

enum Sh { A(i32), B, C(i32, i32) }
enum Msg { Txt(string), Num(i32) }
enum Wrap { P((Sh, i32)), Q }




function classify(t: (Sh, i32)): i32 {
    match (t) {
        (A(x), y) => { return x + y; },
        (B(), y) => { return 100 + y; },
        (C(p, q), 7) => { return p * q; },
        _ => { return 0 - 1; },
    }
}



function both(t: (Sh, Msg)): i32 {
    match (t) {
        (A(x), Num(n)) => { return x * 100 + n; },
        (A(x), Txt(s)) => { return x + s.len(); },
        (B(), Num(n)) => { return n; },
        _ => { return 0 - 2; },
    }
}



function opt(t: (Option[i32], i32)): i32 {
    match (t) {
        (Some(v), y) => { return v + y; },
        (None(), y) => { return 0 - y; },
        _ => { return 0; },
    }
}



function texts(t: (Msg, string)): string {
    match (t) {
        (Txt(s), tail) => { return s + tail; },
        _ => { return "?"; },
    }
}



function guarded(t: (Sh, i32)): i32 {
    match (t) {
        (A(x), y) when x > y => { return 1; },
        (A(x), y) => { return 2; },
        _ => { return 3; },
    }
}


function at_bound(t: (Sh, i32)): i32 {
    match (t) {
        w @ (A(x), y) => { return x + y + w.1; },
        _ => { return 0; },
    }
}


function pick(t: (Sh, i32)): i32 {
    return match (t) {
        (A(x), y) => x * 10 + y,
        (B(), _) => 200,
        _ => 0 - 3,
    };
}





function nested(w: Wrap): i32 {
    match (w) {
        P((A(n), y)) => { return n + y; },
        P((B(), y)) => { return 100 + y; },
        P(t) => { return 0; },
        Q => { return 0 - 1; },
    }
}

function main(): i32 {
    print(classify((Sh.A(5), 3)).to_string());
    print(classify((Sh.B, 4)).to_string());
    print(classify((Sh.C(6, 7), 7)).to_string());
    print(classify((Sh.C(6, 7), 8)).to_string());

    print(both((Sh.A(2), Msg.Num(9))).to_string());
    print(both((Sh.A(2), Msg.Txt("abc"))).to_string());
    print(both((Sh.B, Msg.Num(4))).to_string());
    print(both((Sh.B, Msg.Txt("z"))).to_string());

    print(opt((Some(4), 3)).to_string());
    print(opt((None, 3)).to_string());

    print(texts((Msg.Txt("ab"), "cd")));
    print(texts((Msg.Num(1), "cd")));

    print(guarded((Sh.A(9), 1)).to_string());
    print(guarded((Sh.A(1), 9)).to_string());
    print(guarded((Sh.B, 9)).to_string());

    print(at_bound((Sh.A(5), 2)).to_string());
    print(at_bound((Sh.B, 2)).to_string());

    print(pick((Sh.A(5), 3)).to_string());
    print(pick((Sh.B, 4)).to_string());
    print(pick((Sh.C(1, 2), 4)).to_string());

    print(nested(Wrap.P((Sh.A(5), 3))).to_string());
    print(nested(Wrap.P((Sh.B, 4))).to_string());
    print(nested(Wrap.P((Sh.C(1, 2), 4))).to_string());
    print(nested(Wrap.Q).to_string());
    return 0;
}
