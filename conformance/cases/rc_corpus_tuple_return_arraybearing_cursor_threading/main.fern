




















struct Tok { k: i32 }
struct Par { toks: Tok[], pos: i32 }
function (p: Par) advance(): Par {
    return Par { toks: p.toks, pos: p.pos + 1 };
}
function parse_one(p: Par): (i32, Par) {
    p = p.advance();
    if (p.pos % 3 == 0) { return (2, p); }
    p = p.advance();
    return (1, p);
}
function parse_many(p: Par): (i32, Par) {
    let n: i32 = 0;
    let guard: i32 = 0;
    while (guard < 200) {
        let (s, p2) = parse_one(p);
        p = p2;
        n = n + s;
        guard = guard + 1;
    }
    return (n, p);
}
function main(): i32 {
    let t0: Tok[] = [Tok { k: 1 }, Tok { k: 2 }];
    let total: i32 = 0;
    let r: i32 = 0;
    while (r < 30) {
        let (n, pf) = parse_many(Par { toks: t0, pos: 0 });
        total = total + n + pf.pos % 7;
        r = r + 1;
    }
    return (total / 30) - 306 + __rc_underflow_count();
}
