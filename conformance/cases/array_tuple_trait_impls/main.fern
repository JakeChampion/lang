// An array, a slice and a tuple can be the target of a trait impl and the
// receiver of a method. A parametric impl covers a type only when the parts
// it binds meet its bounds, and == and < call the impl's eq and cmp.
trait Eq {
  function eq(self: Self, other: Self): boolean;
}

trait Ord {
  function cmp(self: Self, other: Self): i32;
}

trait Size {
  function size(self: Self): i32;
}

impl Eq for i32 {
  function eq(self: i32, other: i32): boolean {
    return self - other == 0;
  }
}

impl Ord for i32 {
  function cmp(self: i32, other: i32): i32 {
    if (self - other < 0) {
      return -1;
    }
    if (self - other > 0) {
      return 1;
    }
    return 0;
  }
}

impl Eq for string {
  function eq(self: string, other: string): boolean {
    return self == other;
  }
}

impl[T: Eq] Eq for T[] {
  function eq(self: T[], other: T[]): boolean {
    if (self.len() != other.len()) {
      return false;
    }
    for i in 0..self.len() {
      if (!self[i].eq(other[i])) {
        return false;
      }
    }
    return true;
  }
}

impl[A: Eq, B: Eq] Eq for (A, B) {
  function eq(self: (A, B), other: (A, B)): boolean {
    return self.0.eq(other.0) && self.1.eq(other.1);
  }
}

impl[A: Ord, B: Ord] Ord for (A, B) {
  function cmp(self: (A, B), other: (A, B)): i32 {
    let c: i32 = self.0.cmp(other.0);
    if (c != 0) {
      return c;
    }
    return self.1.cmp(other.1);
  }
}

impl[T] Size for T[] {
  function size(self: T[]): i32 {
    return self.len();
  }
}

impl[T] Size for [T] {
  function size(self: [T]): i32 {
    return self.len() + 100;
  }
}

impl[A, B, C] Size for (A, B, C) {
  function size(self: (A, B, C)): i32 {
    return 3;
  }
}

function (t: (i32, i32)) sum(): i32 {
  return t.0 + t.1;
}

function all_equal[T: Eq](xs: T[], want: T): boolean {
  for x in xs {
    if (!x.eq(want)) {
      return false;
    }
  }
  return true;
}

function total[T: Size](xs: T[]): i32 {
  let n: i32 = 0;
  for x in xs {
    n = n + x.size();
  }
  return n;
}

function main(): i32 {
  let a: i32[] = [1, 2, 3];
  let n: i32[][] = [[1], [2, 3]];
  print(f"{a == [1, 2, 3]} {a != [1, 2]} {n == [[1], [2, 3]]} {n == [[1], [2]]}");
  let t: (i32, string) = (1, "a");
  print(f"{t == (1, "a")} {t == (1, "b")} {t.eq((1, "a"))}");
  let p: (i32, i32) = (1, 2);
  print(f"{p < (1, 3)} {p > (0, 9)} {p.cmp((1, 2))} {p.sum()}");
  print(f"{all_equal([[1, 2], [1, 2]], [1, 2])} {all_equal([(1, "a")], (1, "b"))}");
  let view: [i32] = a[0:2];
  print(f"{a.size()} {view.size()} {(1, "x", true).size()} {total([[1], [2, 3]])}");
  return 0;
}
