// spec: AL-01















import "std/i32";
import "std/i64";
import "std/string";

function round(s: string): i32 {
    let bs: u8[] = s.bytes();
    let t: string = string_from_bytes_unchecked(bs);
    return t.len();
}

function round_temp(s: string): i32 {
    return string_from_bytes_unchecked(s.bytes()).len();
}

function rounds(s: string, n: i32): i32 {
    let acc: i32 = 0;
    for i in 0..n {
        acc = acc + round(s) + round_temp(s);
    }
    return acc;
}

function main(): i32 {

    let narrow: string = "abcdefgh" + "ijklmnop";
    let wide: string = narrow.repeat(64);
    let warm: i32 = rounds(narrow, 1);
    let b0: i64 = __heap_bump_bytes();
    let x: i32 = rounds(narrow, 50);
    let b1: i64 = __heap_bump_bytes();
    warm = warm + rounds(wide, 1);
    let b2: i64 = __heap_bump_bytes();
    let y: i32 = rounds(wide, 50);
    let b3: i64 = __heap_bump_bytes();

    print(warm.to_string());
    print(x.to_string());
    print(y.to_string());

    if ((b3 - b2) > 2 * (b1 - b0)) { print("scales"); } else { print("constant"); }
    return 0;
}
