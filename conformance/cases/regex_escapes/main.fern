




import "std/regex";

function main(): i32 {
    let r: i32 = 0;
    if (regex.regex_match("\\d+", "abc123")) { r = r + 1; }
    if (regex.regex_match("^\\w+$", "hello_42")) { r = r + 2; }
    if (!regex.regex_match("^\\d+$", "12a")) { r = r + 4; }
    if (regex.regex_match("a\\.b", "a.b")) { r = r + 8; }
    if (!regex.regex_match("a\\.b", "axb")) { r = r + 16; }
    if (regex.regex_match("\\(\\)", "()")) { r = r + 32; }
    if (regex.regex_match("a\\|b", "a|b")) { r = r + 64; }
    if (regex.regex_match("\\s", "x y")) { r = r + 128; }
    return r;
}
