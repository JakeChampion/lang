



















import "std/i32";

enum E { A(i32), B, C(i32, i32) }

struct P { x: i32, y: i32 }
struct W { e: E, n: i32 }
struct S { tag: string, n: i32 }



function lit(p: P): i32 {
    match (p) {
        P { x: 0, y } => { return 100 + y; },
        P { x, y } => { return x + y; },
    }
}



function variant(w: W): i32 {
    match (w) {
        W { e: A(v), n } => { return v + n; },
        W { e: B(), n } => { return 200 + n; },
        W { e: C(q, r), n } => { return q * r + n; },
    }
}






function fallback(w: W): i32 {
    match (w) {
        W { e: A(v), n } => { return v + n; },
        _ => { return 0 - 1; },
    }
}



function tagged(s: S): i32 {
    match (s) {
        S { tag: "go", n } => { return 10 + n; },
        S { tag: "stop", n } => { return 20 + n; },
        S { tag, n } => { return n; },
    }
}



function both(p: P): i32 {
    match (p) {
        P { x: 1, y } => { return 100 + y; },
        P { x: 2, y } => { return 200 + y; },
        P { x, y } => { return x + y; },
    }
}


function renamed(w: W): i32 {
    match (w) {
        W { e: A(v), n: count } => { return v * count; },
        W { e, n: count } => { return count; },
    }
}





function guarded(w: W): i32 {
    match (w) {
        W { e: A(v), n } when v > n => { return v; },
        W { e: A(v), n } => { return n; },
        _ => { return 0; },
    }
}

function main(): i32 {
    print(lit(P { x: 0, y: 5 }).to_string());
    print(lit(P { x: 3, y: 4 }).to_string());

    print(variant(W { e: E.A(7), n: 1 }).to_string());
    print(variant(W { e: E.B, n: 1 }).to_string());
    print(variant(W { e: E.C(3, 4), n: 1 }).to_string());

    print(fallback(W { e: E.A(5), n: 2 }).to_string());
    print(fallback(W { e: E.B, n: 2 }).to_string());

    print(tagged(S { tag: "go", n: 1 }).to_string());
    print(tagged(S { tag: "stop", n: 1 }).to_string());
    print(tagged(S { tag: "other", n: 7 }).to_string());

    print(both(P { x: 1, y: 9 }).to_string());
    print(both(P { x: 2, y: 9 }).to_string());
    print(both(P { x: 5, y: 6 }).to_string());

    print(renamed(W { e: E.A(3), n: 4 }).to_string());
    print(renamed(W { e: E.B, n: 4 }).to_string());

    print(guarded(W { e: E.A(9), n: 1 }).to_string());
    print(guarded(W { e: E.A(1), n: 9 }).to_string());
    print(guarded(W { e: E.B, n: 9 }).to_string());
    return 0;
}
