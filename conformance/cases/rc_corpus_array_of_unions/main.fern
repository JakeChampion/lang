// rc correctness: the program tears its values down and folds
// __rc_underflow_count() into its exit code, so 0 means no over-release.
//
// Array of unions, built via push (the checker's array
// literal doesn't widen mixed variants to the union type),
// indexed + matched.
import "core/int";
import "std/array";
import "std/string";
struct VInt { v: i32 }
struct VArr { v: i32[] }
type Value = VInt | VArr;
function vi(n: i32): Value { return VInt { v: n }; }
function va(xs: i32[]): Value { return VArr { v: xs }; }
function main(): i32 {
    let vs: Value[] = [];
    vs = vs.append(vi(1));
    vs = vs.append(va([2, 3]));
    vs = vs.append(vi(4));
    let got: i32 = 0;
    match (vs[1]) { VInt(n) => { got = n.v; }, VArr(a) => { got = a.v[1]; } }
    return (got - 3) + (vs.len() - 3) + __rc_underflow_count();
}
