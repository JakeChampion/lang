




function main(): i32 {
  match (read_file(".")) {
    Ok(_) => { print("read a directory"); return 1; },
    Err(e) => {
      match (e) {
        Other(p, m, n) => {
          if (n != 21) { print("errno is not EISDIR"); return 3; }
          print(p + ": " + m);
          return 0;
        },
        _ => { print("wrong variant"); return 2; }
      }
    }
  }
}
