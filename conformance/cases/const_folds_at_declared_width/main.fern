// spec: IS-16
// Each const evaluates in its declared type. A remainder takes the sign of
// its dividend, and a shift right and a division of an unsigned type are
// unsigned. WIDE does not fit in an i32, and it fits in its i64.
import "std/i32";
import "std/i64";
import "std/u32";

const REM: i32 = (0 - 7) % 3;
const LOWEST: i32 = 0 - 2147483647 - 1;
const LOGICAL: u32 = 4294967288u32 >> 2;
const UNSIGNED: u32 = 4294967294u32 / 2;
const WIDE: i64 = 2147483647 + 1 + 2147483647 + 1;
const QUOT: i64 = 8589934592 / WIDE;
const QUARTER: f64 = 1.0 / 4.0;

function main(): i32 {
    print(REM.to_string());
    print(LOWEST.to_string());
    print(LOGICAL.to_string());
    print(UNSIGNED.to_string());
    print(WIDE.to_string());
    print(QUOT.to_string());
    if (QUARTER * 4.0 == 1.0) {
        print("quarter");
    }
    return 0;
}
