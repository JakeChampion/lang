import "core/int";

// Audit fixture: `var x = expr;` type inference (no explicit `: T`) across the
// wider scalar types and composites — not just the i32 path. Each binding's
// type is inferred from its initializer, then used in a way that only
// type-checks (and computes correctly) if inference picked the right type.
struct P { x: i32, y: i32 }
enum E { A(i32), B }

function ret_i64(): i64 { return 9 as i64; }

function main(): i32 {
    var n = 7 as i64;                 // i64
    var m = n + (3 as i64);           // i64 arithmetic -> 10
    var u = 100 as u32;               // u32
    var uw = (250 as u8) + (10 as u8); // u8 wrap -> 4
    var f = 2.5;                      // f64
    var g = f + 1.5;                  // f64 -> 4.0
    var b = (3 > 2);                  // boolean
    var s = "hello";                  // string
    var t = (3, 4);                   // (i32, i32)
    var p = P { x: 3, y: 4 };         // P
    var a = [10, 20, 30];             // i32[]
    var e = A(7);                     // E
    var fromcall = ret_i64();         // i64, inferred from the call's return

    if ((m as i32) != 10) { return 11; }
    if ((u as i32) != 100) { return 12; }
    if ((uw as i32) != 4) { return 13; }
    if ((g as i32) != 4) { return 14; }
    if (!b) { return 15; }
    if (s.len() != 5) { return 16; }
    if (t.0 + t.1 != 7) { return 17; }
    if (p.x + p.y != 7) { return 18; }
    if (a[1] != 20) { return 19; }
    if (match (e) { A(k) => k, B => 0 } != 7) { return 20; }
    if ((fromcall as i32) != 9) { return 21; }
    print("ok");
    return 0;
}
