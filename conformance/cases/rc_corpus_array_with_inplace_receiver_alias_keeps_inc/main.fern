
















function mkstr(p: string): string { return p + "!"; }
function main(): i32 {
    let xs: string[] = [mkstr("aaaaaaaaaa"), mkstr("b")];
    let y: string[] = xs;
    let zs: string[] = xs.with(0, mkstr("zz"));
    let c: i32 = y[0].len();
    let d: i32 = zs[0].len();
    return (c - 11) + (d - 3) + __rc_underflow_count();
}
