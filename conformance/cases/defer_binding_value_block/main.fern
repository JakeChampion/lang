import "core/int";

// Leaving a value block does not run cleanup. The block-local binding stays
// available until iteration exit, and replay observes its replacement.
function main(): i32 {
    let seen: i32 = 0;
    let before: i32 = 0;
    loop {
        let yielded: i32 = {
            let items: i32[] = [2];
            defer seen = items[0];
            items = [9];
            1
        };
        before = seen + yielded;
        break;
    }
    return before * 10 + seen;
}
