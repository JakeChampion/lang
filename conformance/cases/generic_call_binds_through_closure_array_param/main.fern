import "std/i32";

// A generic function's type parameter binds through a parameter that is an
// array of closures, so a generic call passing the array on instantiates
// its callee without a let annotation naming the result, nested in another
// call or not.
struct Slot[T] { f: () => T, n: i32 }

function start[T](entries: (() => T)[]): Slot[T][] {
  let out: Slot[T][] = [];
  let i: i32 = 0;
  while (i < entries.len()) {
    let e: () => T = entries[i];
    out = out.append(Slot { f: e, n: i });
    i = i + 1;
  }
  return out;
}

function total[T](slots: Slot[T][]): i32 {
  let n: i32 = 0;
  for s in slots {
    n = n + s.n + 1;
  }
  return n;
}

function first[T](entries: (() => T)[]): T {
  let slots = start(entries);
  let s: Slot[T] = slots[0];
  let f: () => T = s.f;
  print(total(start(entries)).to_string());
  return f();
}

function main(): i32 {
  let es: (() => i32)[] = [() => 41, () => 2, () => 3];
  print(first(es).to_string());
  return 0;
}
