



















import "std/i32";
import "std/string";
import "std/i64";

function wrap_param(v: i32): u8 { return (v % 256) as u8; }

function main(): i32 {

    let out: u8[] = [];
    for i in 0..8 {
        out = out.append(((i * 100) % 256) as u8);
    }
    let s: string = "";
    for i in 0..out.len() { s = s + (out[i] as i32).to_string() + " "; }
    print(s);



    let m: string = "";
    for i in 0..6 { m = m + ((i * 300) as u8 as i32).to_string() + " "; }
    print(m);



    let x: i32 = 300;
    print((x % 256).to_string());
    print(((x % 256) as u8 as i32).to_string());


    print((wrap_param(700) as i32).to_string());
    print(((((3 * 200) + 1) % 256) as u8 as i32).to_string());



    let big: i64 = 4611686018427387904 as i64;
    print(big.to_string());

    return 0;
}
