












import "std/i32";

enum Opt2 { Sm(i32), Nn }
enum Res2 { Ok2(i32), Er2 }
enum Nest2 { Wrap(Res2), Bare }
enum Pair2 { Pr(i32, i32), Non }
enum Msg { Txt(string), Num(i32) }


function classify(o: Opt2): string {
    match (o) {
        Sm(0) => { return "zero"; },
        Sm(n) => { return "some"; },
        Nn => { return "none"; },
    }
}



function pair_of(p: Pair2): i32 {
    match (p) {
        Pr(1, y) => { return 100 + y; },
        Pr(x, y) => { return x + y; },
        Non => { return 0; },
    }
}


function describe(m: Msg): string {
    match (m) {
        Txt("hi") => { return "greeting"; },
        Txt(s) => { return s; },
        Num(-1) => { return "minus one"; },
        Num(n) => { return "number"; },
    }
}




function unwrap(w: Nest2): i32 {
    match (w) {
        Wrap(Ok2(0)) => { return 40; },
        Wrap(Ok2(n)) => { return 41; },
        Wrap(Er2()) => { return 42; },
        Bare => { return 43; },
    }
}


function via_if_let(o: Opt2): i32 {
    if let Sm(0) = o { return 60; }
    return 61;
}

function guarded(o: Opt2): i32 {
    match (o) {
        Sm(0) when true => { return 80; },
        _ => { return 81; },
    }
}

function main(): i32 {
    print(classify(Opt2.Sm(0)));
    print(classify(Opt2.Sm(5)));
    print(classify(Opt2.Nn));

    print(pair_of(Pair2.Pr(1, 9)).to_string());
    print(pair_of(Pair2.Pr(3, 4)).to_string());
    print(pair_of(Pair2.Non).to_string());

    print(describe(Msg.Txt("hi")));
    print(describe(Msg.Txt("other")));
    print(describe(Msg.Num(0 - 1)));
    print(describe(Msg.Num(9)));

    print(unwrap(Nest2.Wrap(Res2.Ok2(0))).to_string());
    print(unwrap(Nest2.Wrap(Res2.Ok2(9))).to_string());
    print(unwrap(Nest2.Wrap(Res2.Er2)).to_string());
    print(unwrap(Nest2.Bare).to_string());

    print(via_if_let(Opt2.Sm(0)).to_string());
    print(via_if_let(Opt2.Sm(1)).to_string());

    print(guarded(Opt2.Sm(0)).to_string());
    print(guarded(Opt2.Sm(1)).to_string());
    return 0;
}
