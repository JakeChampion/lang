// Pins E051. The program is the example from that code's entry
// in the diagnostic catalogue (`fern explain E051`), so this case
// also checks the catalogue's example really does produce the error
// it documents.
function consume(own xs: i32[]): i32 { return xs[0]; }

function f(xs: i32[]): i32 {   // xs is BORROWED — f doesn't own it
    return consume(xs);        // error[E051]: can't transfer a borrowed value
}
