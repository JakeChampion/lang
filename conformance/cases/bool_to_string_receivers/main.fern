
















import "std/string";

struct Box { v: i32 }

function yes(): boolean { return true; }
function no(): boolean { return false; }
function (b: Box) over_ten(): boolean { return b.v > 10; }
function (b: Box) under_ten(): boolean { return b.v < 10; }

function main(): i32 {
    let b: boolean = true;
    let big: Box = Box { v: 42 };
    let small: Box = Box { v: 3 };
    let flags: boolean[] = [true, false];


    print("call_true=" + yes().to_string());
    print("call_false=" + no().to_string());
    print("method_true=" + big.over_ten().to_string());
    print("method_false=" + small.over_ten().to_string());
    print("method_other=" + small.under_ten().to_string());


    print("var=" + b.to_string());
    print("lit=" + true.to_string());
    print("lit_false=" + false.to_string());
    print("cmp=" + (1 == 1).to_string());
    print("neg=" + (!b).to_string());
    print("index=" + flags[1].to_string());
    return 0;
}
