import "core/int";

// Only a reached registration may read this branch-local array. Replay sees
// its replacement, not the value present when the defer was registered.
function observe(enabled: boolean): i32 {
    var seen: i32 = 1;
    loop {
        if (enabled) {
            var items: i32[] = [2];
            defer seen = items[0];
            items = [9];
        }
        break;
    }
    return seen;
}

function main(): i32 {
    return observe(true) * 10 + observe(false);
}
