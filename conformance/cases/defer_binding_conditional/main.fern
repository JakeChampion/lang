import "core/int";



function observe(enabled: boolean): i32 {
    let seen: i32 = 1;
    loop {
        if (enabled) {
            let items: i32[] = [2];
            defer seen = items[0];
            items = [9];
        }
        break;
    }
    return seen;
}

function main(): i32 {
    return observe(true) * 10 + observe(false);
}
