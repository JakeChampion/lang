import "std/base64";
import "std/codec";
import "std/string";


function main(): i32 {
  let s: string = "Fern!";
  if (string_from_bytes_unchecked(__codec_bytes(base64.decode(base64.encode(s.bytes())))) == s) {
    return 42;
  }
  return 1;
}


function __codec_bytes(value: Result[u8[], codec.DecodeError]): u8[] {
  match (value) {
    Ok(bytes) => {
      return bytes;
    },
    Err(problem) => {
      eprint(problem.message());
      exit(98);
      return [];
    }
  }
}
