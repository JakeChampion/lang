// std/array's rotate_left / rotate_right: cyclic shift by n mod len; negative n
// rotates the other way.
// A minimal inline body, so this pins the lowering of its shape rather than
// the shipped module.
//
// [1..5] rotate_left 2 -> [3,4,5,1,2]; sum of first two (3+4) tag = 7.
function rotate_left[T](xs: T[], n: i32): T[] { let len: i32 = xs.len(); let out: T[] = []; if (len == 0) { return out; } let sh: i32 = ((n % len) + len) % len; let i: i32 = 0; while (i < len) { out = out.append(xs[(i + sh) % len]); i = i + 1; } return out; }
function main(): i32 { let xs: i32[] = [1, 2, 3, 4, 5]; let r = rotate_left(xs, 2); return r[0] * 10 + r[1]; }
