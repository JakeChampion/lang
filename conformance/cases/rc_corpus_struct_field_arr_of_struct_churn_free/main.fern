








import "core/int";
struct Row { cells: i32[] }
struct Grid { rows: Row[], tag: i32 }
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let g: Grid = Grid { rows: [Row { cells: [i, i + 1] }, Row { cells: [i + 2] }], tag: i };
        acc = acc + g.rows[0].cells[1];
        i = i + 1;
    }
    return (acc - 5050) + __rc_underflow_count();
}
