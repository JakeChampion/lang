// rc correctness: the program tears its values down and folds
// __rc_underflow_count() into its exit code, so 0 means no over-release.
//
// Closure capturing a scalar (no pointer capture).
import "core/int";
function main(): i32 {
    let k: i32 = 42;
    let f = (x: i32): i32 => { return x + k; };
    return (f(0) - 42) + __rc_underflow_count();
}
