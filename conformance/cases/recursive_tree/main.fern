// A mutually-recursive type: a binary tree where interior nodes hold
// further Trees. The Leaf literals widen to the Tree union directly
// in Node's field initializers (no intermediate typed locals needed).
// 40 + 2 = 42.
struct Leaf { v: i32 }
struct Node { left: Tree, right: Tree }
type Tree = Leaf | Node;

function tree_sum(t: Tree): i32 {
    match (t) {
        Leaf(l) => { return l.v; },
        Node(n) => { return tree_sum(n.left) + tree_sum(n.right); }
    }
}

function main(): i32 {
    var t: Tree = Node { left: Leaf { v: 40 }, right: Leaf { v: 2 } };
    return tree_sum(t);
}
