// A local named exit is an ordinary callable that returns. A value branch
// that ends in a call to it has no value, in an if and in a match.
enum Opt { Has(i32), Nil }

function pick(c: boolean): i32 {
  let exit = (k: i32): void => {};
  return if (c) { 1 } else { exit(2); };
}

function take(o: Opt, exit: (i32) => void): i32 {
  return match (o) {
    Has(v) => v,
    Nil => { exit(3); },
  };
}

function main(): i32 {
  return pick(true) + take(Opt.Has(1), (k: i32): void => {});
}
