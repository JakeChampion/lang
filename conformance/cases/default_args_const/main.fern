




const LIMIT: i32 = 128;
const STEP: i32 = LIMIT / 2;

function listen(port: i32, backlog: i32 = LIMIT): i32 { return port + backlog; }
function advance(n: i32, by: i32 = STEP + 1): i32 { return n + by; }

function main(): i32 {
    let LIMIT: i32 = 1;
    let ok: i32 = 0;
    if (listen(80) == 208) { ok = ok + 1; }
    if (advance(1) == 66) { ok = ok + 1; }
    if (listen(80, LIMIT) == 81) { ok = ok + 1; }
    return ok;
}
