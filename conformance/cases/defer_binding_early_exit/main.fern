import "core/int";



function main(): i32 {
    let seen: i32 = 0;
    let i: i32 = 0;
    while (i < 3) {
        i = i + 1;
        if (i == 2) {
            continue;
        }
        let items: i32[] = [0];
        defer seen = seen * 10 + items[0];
        items = [i];
    }
    return seen;
}
