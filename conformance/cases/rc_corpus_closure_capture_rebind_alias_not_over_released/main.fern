






















import "core/int";
import "std/i32";
import "std/string";
@noinline
function mk(n: i32): string { return "captured-payload-" + n.to_string(); }
function main(): i32 {
    let a: string = mk(7);
    let s: string = "";
    let f: () => i32 = (): i32 => { return s.len(); };
    let i: i32 = 0;
    while (i < 500) {
        s = a;
        s = mk(i);
        i = i + 1;
    }
    s = a;
    return (a.len() + f() - 36) + __rc_underflow_count();
}
