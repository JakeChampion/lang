






enum E { Leaf(i32[]), Branch(E[]), Empty }
struct Vec { root: E, tail: i32[], n: i32 }

function vnew(): Vec {
    let e: E = Empty;
    let t: i32[] = [];
    return Vec { root: e, tail: t, n: 0 };
}

function push(v: Vec, x: i32): Vec {
    if (v.tail.len() < 4) {
        return Vec { ...v, tail: v.tail.append(x), n: v.n + 1 };
    }
    let leaf: E = Leaf(v.tail);
    let fresh: i32[] = [x];
    match (v.root) {
        Empty => { return Vec { root: leaf, tail: fresh, n: v.n + 1 }; },
        Leaf(xs) => { return Vec { root: Branch([v.root, leaf]), tail: fresh, n: v.n + 1 }; },
        Branch(kids) => { return Vec { root: Branch(kids.append(leaf)), tail: fresh, n: v.n + 1 }; }
    }
}

function sum_node(e: E): i32 {
    match (e) {
        Leaf(xs) => {
            let t: i32 = 0;
            let i: i32 = 0;
            while (i < xs.len()) { t = t + xs[i]; i = i + 1; }
            return t;
        },
        Branch(kids) => {
            let t: i32 = 0;
            for k in kids { t = t + sum_node(k); }
            return t;
        },
        Empty => { return 0; }
    }
}


function churn(): i32 {
    let junk: i32[][] = [];
    let i: i32 = 0;
    while (i < 400) { junk = junk.append([i, i, i, i]); i = i + 1; }
    return junk.len();
}

function main(): i32 {
    let total: i32 = 0;
    let r: i32 = 0;
    while (r < 6) {
        let v: Vec = vnew();
        let i: i32 = 0;
        while (i < 40) {
            v = push(v, i);
            i = i + 1;
        }
        churn();
        let k: i32 = 0;
        while (k < v.tail.len()) { total = total + v.tail[k]; k = k + 1; }
        total = total + sum_node(v.root) + v.n;
        r = r + 1;
    }
    return total % 64;
}
