







import "std/regex";

function main(): i32 {
  let r: i32 = 0;
  if (require_regex_text(regex.regex_replace_all("a", "aaa", "bb")) == "bbbbbb") {
    r = r + 1;
  }
  if (require_regex_text(regex.regex_replace_all("", "abc", "-")) == "-a-b-c-") {
    r = r + 2;
  }
  if (require_regex_text(regex.regex_replace_all("x*", "axbxc", "<>")) == "<>a<><>b<><>c<>") {
    r = r + 4;
  }
  if (require_regex_text(regex.regex_replace_all(".", "hi", "")) == "") {
    r = r + 8;
  }
  if (require_regex_text(regex.regex_replace_all("^", "abc", ">")) == ">abc") {
    r = r + 16;
  }
  if (require_regex_text(regex.regex_replace_all("z", "abc", "Q")) == "abc") {
    r = r + 32;
  }
  if (require_regex_text(regex.regex_replace_all("o", "foo bar boo", "0")) == "f00 bar b00") {
    r = r + 64;
  }
  if (require_regex_text(regex.regex_replace_all("X", "aXbXc", "-")) == "a-b-c") {
    r = r + 128;
  }
  return r;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
