  if (require_regex_text(match ({ let __checked_regex_7: regex.Regex = match (regex.compile("a")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_7.replace_all("aaa", "bb") }) { Ok(__text) => Some(__text), Err(__error) => { eprint(__error.to_string()); return 98; } }) == "bbbbbb") {  // multi-char repl grows output
