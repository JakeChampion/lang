// std/regex regex_replace_all: exercises the checked byte-buffer
// rewrite (#4379) on the paths the old `out = out + …` chain made quadratic
// and that are easiest to get wrong when re-piecing the output: a
// multi-character replacement that grows the result, the empty pattern
// (a zero-width match between every byte), a nullable `x*` star (zero-width
// carry of the skipped byte), full deletion (empty repl), a `^` anchor,
// no-match passthrough, a match-dense single-char replace, and a trailing
// tail after the last match. Each check sets a bit; all eight hold -> 255.
import "std/regex";

function main(): i32 {
  let r: i32 = 0;
  if (require_regex_text(regex.regex_replace_all("a", "aaa", "bb")) == "bbbbbb") {  // multi-char repl grows output
    r = r + 1;
  }
  if (require_regex_text(regex.regex_replace_all("", "abc", "-")) == "-a-b-c-") {  // empty pattern → between every byte
    r = r + 2;
  }
  if (require_regex_text(regex.regex_replace_all("x*", "axbxc", "<>")) == "<>a<><>b<><>c<>") {  // nullable star, zero-width carry
    r = r + 4;
  }
  if (require_regex_text(regex.regex_replace_all(".", "hi", "")) == "") {  // delete everything (empty repl)
    r = r + 8;
  }
  if (require_regex_text(regex.regex_replace_all("^", "abc", ">")) == ">abc") {  // anchored, single zero-width at start
    r = r + 16;
  }
  if (require_regex_text(regex.regex_replace_all("z", "abc", "Q")) == "abc") {  // no match → unchanged
    r = r + 32;
  }
  if (require_regex_text(regex.regex_replace_all("o", "foo bar boo", "0")) == "f00 bar b00") {  // dense single-char
    r = r + 64;
  }
  if (require_regex_text(regex.regex_replace_all("X", "aXbXc", "-")) == "a-b-c") {  // trailing tail after last match
    r = r + 128;
  }
  return r;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
