



















import "std/json";

struct Cfg { on: boolean, n: i32 }
enum Verdict { Yes(boolean), No }



function show(b: boolean): string { return b.to_json(); }

function main(): i32 {

    let ok: boolean = true;
    if (ok.to_json() != "true") { return 1; }
    let inferred = false;
    if (inferred.to_json() != "false") { return 2; }


    let alias = ok;
    if (alias.to_json() != "true") { return 3; }


    if (show(ok) != "true") { return 4; }
    if (show(false) != "false") { return 5; }


    let c: Cfg = Cfg { on: true, n: 5 };
    if (c.on.to_json() != "true") { return 6; }
    let fromfield = c.on;
    if (fromfield.to_json() != "true") { return 7; }



    let cmp = 1 < 2;
    if (cmp.to_json() != "true") { return 8; }
    let neg = !ok;
    if (neg.to_json() != "false") { return 9; }



    let bs: boolean[] = [true, false];
    let seen: string = "";
    for b in bs { seen = seen + b.to_json() + ","; }
    if (seen != "true,false,") { return 10; }
    if (bs[0].to_json() != "true") { return 11; }


    match (Yes(true)) { Yes(v) => { if (v.to_json() != "true") { return 12; } }, No => { return 13; } }



    if (ok.to_string() != "true") { return 14; }
    if (inferred.to_string() != "false") { return 15; }



    let n: i32 = 7;
    if (n.to_json() != "7") { return 16; }
    if (n.to_string() != "7") { return 17; }
    if (c.n.to_json() != "5") { return 18; }

    return 42;
}
