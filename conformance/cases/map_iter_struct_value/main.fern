




import "core/map";
import "core/cmp";

struct Item { qty: i32, name: string }

@derive(cmp.Eq, cmp.Hash)
struct Sku { code: i32 }

function main(): i32 {
    let m: Map[i32, Item] = map_new(8);
    m = m.insert(1, Item { qty: 10, name: "a" });
    m = m.insert(2, Item { qty: 20, name: "bb" });


    let it = m.iter();
    let qty: i32 = 0;
    let chars: i32 = 0;
    while (it.has_next()) {
        qty = qty + it.value().qty;
        chars = chars + it.value().name.len();
        it.advance();
    }
    if (qty != 30) { return 1; }
    if (chars != 3) { return 2; }


    let it2: MapIter[i32, Item] = m.iter();
    let viaBind: i32 = 0;
    while (it2.has_next()) {
        let v = it2.value();
        viaBind = viaBind + v.qty;
        it2.advance();
    }
    if (viaBind != 30) { return 3; }


    if (m.get_or(1, Item { qty: 0, name: "" }).qty != 10) { return 4; }







    let byKey: Map[Sku, Item] = map_new(8);
    byKey = byKey.insert(Sku { code: 5 }, Item { qty: 7, name: "z" });
    let it3 = byKey.iter();
    let keyed: i32 = 0;
    while (it3.has_next()) {
        keyed = keyed + it3.key().code + it3.value().qty;
        it3.advance();
    }
    if (keyed != 12) { return 5; }

    return 42;
}
