
























struct Table { rows: string[][], n: i32 }
struct Flat { rows: string[], n: i32 }
struct Scalar { rows: i32[][], n: i32 }


function total_len(t: Table): i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < t.rows.len()) {
        let j: i32 = 0;
        while (j < t.rows[i].len()) { n = n + t.rows[i][j].len(); j = j + 1; }
        i = i + 1;
    }
    return n;
}

function row_count(t: Table): i32 { return t.rows.len(); }

function pass_through(i: i32): i32 {
    let t: Table = Table { rows: [["ab", "cde"], ["f"]], n: i };
    return total_len(t) + row_count(t);
}


function nested_read(i: i32): i32 {
    let t: Table = Table { rows: [["xy"], ["z", "wv"]], n: i };
    if (t.rows[1][1].len() != 2) { return 253; }
    return total_len(t);
}


function empty_rows(i: i32): i32 {
    let e: Table = Table { rows: [], n: i };
    let r: Table = Table { rows: [[]], n: i };
    return total_len(e) + total_len(r) + row_count(r);
}


function flat_field(i: i32): i32 {
    let f: Flat = Flat { rows: ["gh", "ijk"], n: i };
    return flat_len(f);
}

function flat_len(f: Flat): i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < f.rows.len()) { n = n + f.rows[i].len(); i = i + 1; }
    return n;
}


function scalar_field(i: i32): i32 {
    let s: Scalar = Scalar { rows: [[1, 2], [3]], n: i };
    return scalar_sum(s);
}

function scalar_sum(s: Scalar): i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < s.rows.len()) {
        let j: i32 = 0;
        while (j < s.rows[i].len()) { n = n + s.rows[i][j]; j = j + 1; }
        i = i + 1;
    }
    return n;
}

function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        acc = acc + pass_through(i) + nested_read(i) + empty_rows(i)
            + flat_field(i) + scalar_field(i);
        i = i + 1;
    }
    if (__rc_underflow_count() != 0) { return 251; }
    return acc % 113;
}
