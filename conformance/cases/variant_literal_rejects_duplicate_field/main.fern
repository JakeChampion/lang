enum Shape {
  Rect { w: i32, h: i32 },
  Circle(i32),
  Dot,
}

function area(s: Shape): i32 {
  return match (s) {
    Rect { w, h } => w * h,
    Circle(r) => r,
    Dot => 0,
  };
}

function twice(): Shape {
  return Rect { w: 1, w: 2, h: 3 };
}

function main(): i32 {
  print(area(Rect { w: 1, h: 2 }).to_string());
  return 0;
}
