// spec: FS-07
import "std/float";
// f32 -> f64 and back. Both directions are exact for a value with few
// significant bits, so the round trip is portable; the same round trip
// on a value needing more than 24 bits of mantissa is not, which is why
// the case uses halves.
function half(n: i32): f32 {
    return (n as f32) * 0.5;
}

function main(): i32 {
    var s: f32 = half(5);
    var wide: f64 = s as f64;
    var back: f32 = wide as f32;

    var flags: i32 = 0;
    if (wide == 2.5) { flags = flags + 1; }
    if (back == s) { flags = flags + 2; }
    if (wide + wide == 5.0) { flags = flags + 4; }

    print(wide.to_string());
    return flags;
}
