// spec: FS-07
import "std/f64";




function half(n: i32): f32 {
    return (n as f32) * 0.5;
}

function main(): i32 {
    let s: f32 = half(5);
    let wide: f64 = s as f64;
    let back: f32 = wide as f32;

    let flags: i32 = 0;
    if (wide == 2.5) { flags = flags + 1; }
    if (back == s) { flags = flags + 2; }
    if (wide + wide == 5.0) { flags = flags + 4; }

    print(wide.to_string());
    return flags;
}
