// spec: RH-13
// A handle a closure captures stays shared with the closure, so a deferred
// consuming close of it is refused.

struct Handle { fd: i32 }

function (own h: Handle) close(): i32 {
  return h.fd;
}

function main(): i32 {
  let h: Handle = Handle { fd: 3 };
  let get = (): i32 => h.fd;
  defer h.close();
  return get();
}
