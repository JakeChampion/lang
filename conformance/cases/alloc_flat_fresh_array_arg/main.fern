// spec: AL-01
//
// The AL-01 shape for a fresh container handed to a CONSTRUCTOR that keeps
// it: `node(name, no_deps(), k)`. The callee takes its own reference when it
// stores the array in the struct it returns, so the caller's reference to the
// temp is the one with nothing to release it — and reclaiming it wrongly
// frees what the returned struct now owns.
//
// Both halves are here because they fail in opposite directions. The FRESH
// argument leaks if the caller never releases it (#6522, 32 B per node on all
// three backends, unbounded); the ALIASED argument — a live local passed at
// the same position — is a use-after-free if the caller releases one it does
// not own. The stored array is read back through the returned struct, and the
// live local is read after its call, so either mistake shows up as wrong
// output rather than as a byte count.
//
// The case prints the SHAPE, never a byte count — see
// docs/ALLOCATION-OBSERVABLE.md.
import "std/i32";
import "std/i64";
import "std/string";

struct Node { name: string, deps: string[], mtime: i32 }

// Past the small-string threshold, so every element is a real heap buffer.
function wide(n: i32): string { return "a-string-well-past-the-inline-threshold-" + n.to_string(); }

function deps_of(n: i32): string[] {
    var out: string[] = [];
    for i in 0..3 { out = out.append(wide(n + i)); }
    return out;
}

function node(name: string, deps: string[], mtime: i32): Node {
    return Node { name: name, deps: deps, mtime: mtime };
}

function round(n: i32): i32 {
    var fresh: Node = node(wide(n), deps_of(n), n);
    var live: string[] = deps_of(n + 7);
    var aliased: Node = node(wide(n), live, n);
    return fresh.deps.len() + fresh.deps[0].len()
        + aliased.deps.len() + aliased.deps[2].len()
        + live.len() + live[1].len();
}

function rounds(n: i32): i32 {
    var acc: i32 = 0;
    for i in 0..n {
        acc = acc + round(i);
    }
    return acc;
}

function main(): i32 {
    var b0: i64 = __heap_bump_bytes();
    var x: i32 = rounds(50);
    var b1: i64 = __heap_bump_bytes();
    var y: i32 = rounds(100);
    var b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());
    // Twice the work must not cost more fresh memory.
    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
