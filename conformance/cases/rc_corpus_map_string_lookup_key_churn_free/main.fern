















import "core/map";
import "std/string";
function mk(): i32 {
    let m: Map[string, i32] = map_new(8);
    let key: string = "ke" + "y";
    m = m.insert(key, 7);
    m = m.insert("ot" + "her", 3);
    let acc: i32 = 0;
    acc = acc + m.get_or(key, 0);
    acc = acc + m.get_or("ke" + "y", 0);
    if (m.contains("ke" + "y")) { acc = acc + 1; }
    if (m.contains(key)) { acc = acc + 1; }
    match (m.get("ke" + "y")) { Some(v) => { acc = acc + v; }, None => {} }
    match (m.get(key)) { Some(v) => { acc = acc + v; }, None => {} }
    return acc + key.len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 16500) + __rc_underflow_count();
}
