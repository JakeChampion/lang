












function collect(depth: i32, acc: string[]): string[] {
    let a: string[] = acc;
    let i: i32 = 0;
    while (i < 3) {
        if (a.len() > 0) { a = a.with(0, "x"); }
        a = a.append("n");
        if (depth > 0) { a = collect(depth - 1, a); }
        i = i + 1;
    }
    return a;
}
function main(): i32 {
    let s: string[] = [];
    s = collect(3, s);
    if (s.len() < 1) { return 91; }
    return __rc_underflow_count();
}
