import "core/map";






function main(): i32 {
    let m: Map[i32, i32] = map_new(8);
    m = m.insert(1, 10);

    let snapshot: Map[i32, i32] = m;


    m = m.insert(1, 99);
    m = m.insert(2, 20);


    if (snapshot.len() != 1) { return 81; }
    if (snapshot.get_or(1, -1) != 10) { return 82; }


    if (m.len() != 2) { return 83; }
    if (m.get_or(1, -1) != 99) { return 84; }


    return m.get_or(1, -1) + m.get_or(2, -1) + snapshot.get_or(1, -1);
}
