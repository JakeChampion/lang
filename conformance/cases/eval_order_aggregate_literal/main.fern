// spec: AL-06
//
// When an aggregate literal's box is bought. Every aggregate in Fern is an
// implicit heap allocation, and `__heap_alloc_count()` makes the moment it
// happens observable from inside the literal itself: a field expression that
// reads the counter reports one more allocation if the box was already bought
// and the same number if it was not.
//
// Fern buys the box LAST — a value's parts exist before the value does, which
// is the order every other allocating expression here already follows. Native
// used to buy it first and the self-host last, so the two compilers printed
// different numbers for the same source (#9614).
//
// The case prints the ORDER, never a count: how many allocator calls a
// construct costs is a legitimate per-backend difference and only the order is
// portable. See docs/ALLOCATION-OBSERVABLE.md.
//
// `order_of` reports "no box" rather than an order when the literal did not
// allocate at all, so a backend that stops boxing fails here instead of
// passing for a reason the case is not about. That is why only the struct and
// the array appear: a small tuple or single-payload variant is returned in
// registers in some contexts and has no box to time. Those two are pinned on
// the op stream instead, by internal/ir/aggregate_eval_order_test.go.
import "std/i64";
import "std/string";

struct M { a: i64, b: i64 }

function order_of(cost: i64, read_at: i64): string {
    if (cost == (0 as i64)) { return "no box"; }
    if (read_at == (0 as i64)) { return "fields-first"; }
    return "box-first";
}

function main(): i32 {
    var b0: i64 = __heap_alloc_count();
    var m: M = M { a: __heap_alloc_count(), b: 0 as i64 };
    var a0: i64 = __heap_alloc_count();
    print("struct: " + order_of(a0 - b0, m.a - b0));

    var b1: i64 = __heap_alloc_count();
    var v: i64[] = [__heap_alloc_count(), 0 as i64];
    var a1: i64 = __heap_alloc_count();
    print("array:  " + order_of(a1 - b1, v[0] - b1));
    return 0;
}
