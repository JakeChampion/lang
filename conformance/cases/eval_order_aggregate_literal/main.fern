// spec: AL-06






















import "std/i64";
import "std/string";

struct M { a: i64, b: i64 }

function order_of(cost: i64, read_at: i64): string {
    if (cost == (0 as i64)) { return "no box"; }
    if (read_at == (0 as i64)) { return "fields-first"; }
    return "box-first";
}

@noinline function a_of(m: M): i64 { return m.a; }

function main(): i32 {
    let b0: i64 = __heap_alloc_count();
    let m: M = M { a: __heap_alloc_count(), b: 0 as i64 };
    let a0: i64 = __heap_alloc_count();
    print("struct: " + order_of(a0 - b0, a_of(m) - b0));

    let b1: i64 = __heap_alloc_count();
    let v: i64[] = [__heap_alloc_count(), 0 as i64];
    let a1: i64 = __heap_alloc_count();
    print("array:  " + order_of(a1 - b1, v[0] - b1));
    return 0;
}
