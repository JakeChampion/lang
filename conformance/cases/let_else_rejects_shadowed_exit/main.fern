// A let-else else branch ending in a call through a parameter named exit
// does not diverge: the call resolves to the parameter, which returns.

enum Opt { Has(i32), Nil }

function let_else_param(o: Opt, exit: (i32) => void): i32 {
  let Has(v) = o else {
    exit(1);
  };
  return v;
}

function main(): i32 {
  return 0;
}
