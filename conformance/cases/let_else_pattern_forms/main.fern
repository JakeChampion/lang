











enum E { Aa(i32), Bb(i32), Cc(i32) }

function whole(e: E): i32 {
    match (e) {
        Aa(v) => { return v; },
        Bb(v) => { return v * 2; },
        Cc(v) => { return v * 3; },
    }
}


function at_head(e: E): i32 {
    let w @ Aa(x) = e else { return 30; };
    return whole(w) + x;
}


function or_head(e: E): i32 {
    let Aa(x) | Bb(x) = e else { return 15; };
    return x;
}

function main(): i32 {
    let total: i32 = 0;
    total = total + at_head(E.Aa(4));
    total = total + at_head(E.Bb(1));
    total = total + or_head(E.Aa(3));
    total = total + or_head(E.Bb(5));
    total = total + or_head(E.Cc(9));
    return total;
}
