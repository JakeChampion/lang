













import "std/i32";

struct Ctx { value: i32 }
struct Fault { step: string, code: i32 }

function failing(c: Ctx): Result[Ctx, Fault] {
    return Err(Fault { step: "boom", code: 7 });
}

function ok_step(c: Ctx): Result[Ctx, Fault] {
    return Ok(Ctx { value: c.value + 1 });
}


function via_try(c: Ctx): Result[Ctx, Fault] {
    let a: Ctx = ok_step(c)?;
    let b: Ctx = failing(a)?;
    return Ok(b);
}


function via_match(c: Ctx): Result[Ctx, Fault] {
    match (ok_step(c)) {
        Err(e) => { return Err(e); },
        Ok(a) => {
            match (failing(a)) {
                Err(e2) => { return Err(e2); },
                Ok(b) => { return Ok(b); }
            }
        }
    }
}

function describe(r: Result[Ctx, Fault]): string {
    match (r) {
        Ok(c) => { return "ok"; },
        Err(e) => { return e.step + ":" + e.code.to_string(); }
    }
}

function main(): i32 {
    let t: string = describe(via_try(Ctx { value: 1 }));
    let m: string = describe(via_match(Ctx { value: 1 }));
    print(t);
    print(m);
    if (t == m) { print("agree"); } else { print("differ"); }
    return 0;
}
