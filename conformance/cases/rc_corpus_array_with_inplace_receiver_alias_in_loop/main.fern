








function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 3) {
        let xs: i32[] = [1, 2, 3];
        let y: i32[] = xs;
        let zs: i32[] = xs.with(0, 9);
        acc = acc + y[0] + zs[0];
        i = i + 1;
    }
    return (acc - 30) + __rc_underflow_count();
}
