// A user enum may name a variant `Ok`, `Some`, `Err` or `None`, and two
// user enums may name the SAME variant. Both are places a compiler can
// decide by NAME what it should decide by type — and the self-host
// compiler did, in three positions: an arm pattern, a payload-less
// variant constructed by name, and a qualified `Enum.Variant` whose name
// another enum also declares.
//
// The failures were fatal or silent rather than diagnosable, which is why
// this is a conformance case: it runs on every self-host target, and it
// checks the ANSWER, not just that something compiled.
//
// References are qualified because a bare colliding name is ambiguous
// (E036) — including the builtins' own, once `Opt`/`Three` are in scope.
// The arm patterns need no qualifying: the scrutinee's type settles them.
enum Res { Ok(i32), Err(i32) }
enum Opt { Some(i32), None }
enum Three { None, Aa(i32), Bb(i32) }

function res(r: Res): i32 {
    match (r) {
        Res.Ok(n) => { return n; },
        Res.Err(n) => { return n * 10; },
    }
}

function opt(o: Opt): i32 {
    match (o) {
        Opt.Some(n) => { return n; },
        Opt.None => { return 7; },
    }
}

// `Three` also declares `None`, so `Opt.None` and `Three.None` are two
// decls sharing one name — the shape that resolved to whichever was
// declared first.
function three(t: Three): i32 {
    match (t) {
        Three.None => { return 5; },
        Three.Aa(n) => { return n; },
        Three.Bb(n) => { return n * 2; },
    }
}

function main(): i32 {
    var total: i32 = 0;
    total = total + res(Res.Ok(3));        // 3
    total = total + res(Res.Err(2));       // 23
    total = total + opt(Opt.Some(4));      // 27
    total = total + opt(Opt.None);         // 34
    total = total + three(Three.None);     // 39
    total = total + three(Three.Aa(1));    // 40
    total = total + three(Three.Bb(1));    // 42

    // The genuine builtins must still take the tag-test path.
    var real: Option[i32] = Option.Some(8);
    match (real) { Some(v) => { total = total + v; }, None => { total = total + 99; } }   // 50
    var none: Option[i32] = Option.None;
    match (none) { Some(v) => { total = total + 99; }, None => { total = total + 1; } }   // 51

    return total;
}
