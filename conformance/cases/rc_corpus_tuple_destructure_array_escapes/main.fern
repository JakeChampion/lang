










import "core/int";
function mk(): i32[] {
    let (a, b) = ([10, 20], [30, 40, 50]);
    return a;
}
function main(): i32 {
    let got: i32 = 0;
    let k: i32 = 0;
    while (k < 100) {
        let r: i32[] = mk();
        got = got + r[1];
        k = k + 1;
    }
    return (got - 2000) + __rc_underflow_count();
}
