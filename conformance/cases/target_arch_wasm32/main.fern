



import "core/int";

function main(): i32 {
    if (target_arch() == "arm64" || target_arch() == "x86-64") {
        print("native build");
    } else {
        print("not a native build");
    }
    if (target_arch() != "wasm32") {
        print("not wasm32");
    }
    print(target_arch());
    return 0;
}
