// An unsuffixed literal in an array literal takes the type of a concrete
// sibling: beside an f32 element a float literal is an f32, and so is an
// integer literal, wherever in the array the concrete element appears.
function half(x: f32): f32 { return x / 2.0; }
function id[T](x: T): T { return x; }

function main(): i32 {
    var xs: f32[] = id([2.5, half(3.0), 1.5]);
    var ys: f32[] = id([4, half(1.0), 0.5]);
    var zs = [0.25, half(0.5)];
    var s: f32 = xs[0] + xs[1] + xs[2] + ys[0] + ys[1] + ys[2] + zs[0] + zs[1];
    return (s * 4.0) as i32;
}
