



import "core/iter";

function main(): i32 {
  let it: iter.ArrayIter[(string, i32)] = iter.of([("a", 1), ("bc", 2)]);
  let n: i32 = 0;
  while (true) {
    match (it.next()) {
      Some(t) => {
        it = t.1;
        n = n + t.0.1 + t.0.0.len();
      },
      None => {
        break;
      }
    }
  }
  return n;
}
