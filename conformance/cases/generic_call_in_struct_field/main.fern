






















struct A { n: i32 }
struct S { s: string }
struct Holder { xs: A[], ys: A[], ss: S[], ts: S[] }
struct Bag { av: A[], sv: S[] }

function append_all[T](into: T[], more: T[]): T[] {
    let i: i32 = 0;
    while (i < more.len()) { into = into.append(more[i]); i = i + 1; }
    return into;
}


function build(h: Holder): Bag {
    return Bag { av: append_all(h.xs, h.ys), sv: append_all(h.ss, h.ts) };
}


function build_idents(a: A[], b: A[], s: S[], t: S[]): Bag {
    return Bag { av: append_all(a, b), sv: append_all(s, t) };
}


function build_bound(h: Holder): Bag {
    let av: A[] = append_all(h.xs, h.ys);
    let sv: S[] = append_all(h.ss, h.ts);
    return Bag { av: av, sv: sv };
}

function main(): i32 {
    let h: Holder = Holder {
        xs: [A { n: 1 }],
        ys: [A { n: 2 }, A { n: 3 }],
        ss: [S { s: "p" }],
        ts: [S { s: "q" }],
    };
    let b1: Bag = build(h);
    let b2: Bag = build_idents(h.xs, h.ys, h.ss, h.ts);
    let b3: Bag = build_bound(h);

    return b1.av.len() + b1.sv.len() + b2.av.len() + b2.sv.len() + b3.av.len() + b3.sv.len();
}
