




import "core/int";
import "std/string";
enum E { Arr(i32[]), Num(i32) }
function main(): i32 {
    let e: E = Arr([1, 2, 3, 4]);
    let n: E = Num(99);
    let got: i32 = 0;
    match (e) { Arr(a) => { got = a.len(); }, Num(_) => { got = 0; } }
