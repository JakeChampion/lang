pub struct Open { addr: string, n: i32 }

pub struct Holder { item: Option[i32] }

pub struct Flag { bit: boolean }

pub opaque struct Secret { n: i32 }

pub function secret(): Secret {
  return Secret { n: 9 };
}

pub enum Choice { Named { n: i32 }, Empty }

pub function choice(): Choice {
  return Named(11);
}

pub struct Group { n: i32 }

pub struct Quiet { n: i32 }

pub enum Event { Group(Group), Quiet }

pub function event(): Event {
  return Event.Group(Group { n: 7 });
}

pub function event_value(e: Event): i32 {
  return match (e) { Group(g) => g.n, Quiet => 0 };
}

pub struct OtherGroup { n: i32 }

pub type EventUnion = Group | OtherGroup;

pub function union_event(): EventUnion {
  return Group { n: 7 };
}

pub function union_event_value(e: EventUnion): i32 {
  return match (e) { Group(g) => g.n, OtherGroup(q) => q.n };
}
