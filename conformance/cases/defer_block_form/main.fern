import "core/int";








function two(): i32 {
    let acc: i32 = 0;
    defer { acc = acc + 100; }
    defer { acc = acc + 10; }
    return acc;
}

function risky(fail: boolean): Result[i32, i32] {
    let code: i32 = 0;
    errdefer { code = code + 7; }
    if (fail) { return Err(code + 1); }
    return Ok(50);
}

function early(n: i32): i32 {
    let x: i32 = 5;
    defer { x = 0; }
    if (n > 0) { return n; }
    return x;
}
function main(): i32 {
    let r: i32 = two();
    match (risky(false)) { Ok(v) => { r = r + v; }, Err(e) => { r = r + e; } }
    match (risky(true))  { Ok(v) => { r = r + v; }, Err(e) => { r = r + e; } }
    r = r + early(9);
    return r;
}
