













import "core/int";
struct Item { xs: i32[] }
struct Holder { b: Option[Item], n: i32 }
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let h: Holder = Holder { b: Some(Item { xs: [i, i + 1] }), n: i };
        match (h.b) { Some(it) => { acc = acc + it.xs[1]; }, None => { acc = acc + 0; } }
        i = i + 1;
    }
    return (acc - 5050) + __rc_underflow_count();
}
