













import "core/int";
import "core/map";
import "std/string";
function mk(): i32 {
    let src: string = "a=hi";
    let short_key: str = slice_unchecked(src, 0, 1);
    let short_val: str = slice_unchecked(src, 2, 4);
    let m: Map[string, string] = map_new(8);
    m = m.insert(short_key.to_owned(), short_val.to_owned());
    let n = m.len();
    return short_key.len() + short_val.len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 1500) + __rc_underflow_count();
}
