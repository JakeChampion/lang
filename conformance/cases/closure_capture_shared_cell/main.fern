import "std/i32";

function main(): i32 {

    let n: i32 = 1;
    let read = (): i32 => { return n; };
    n = 99;
    print(read().to_string());


    let m: i32 = 10;
    let bump = (): i32 => { m = m + 1; return m; };
    print(bump().to_string());
    print(bump().to_string());
    print(m.to_string());
    return 0;
}
