








function main(): i32 {
  let w: Writer = stdout();
  match (w.close()) {
    Err(_) => { return 2; },
    Ok(_) => {}
  }
  let again: Writer = stdout();
  match (again.write("x")) {
    Err(e) => {
      match (e) {
        Other(p, m, n) => {
          if (p == "" && m == "Bad file descriptor" && n == 9) { return 0; }
          eprint("Other(" + p + ", " + m + ")");
          return 3;
        },
        _ => { return 4; }
      }
    },
    Ok(_) => { return 5; }
  }
}
