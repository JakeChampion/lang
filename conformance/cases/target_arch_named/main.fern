






import "core/int";

function main(): i32 {
    let arch: string = target_arch();
    let named: boolean = arch == "arm64" || arch == "x86-64" || arch == "wasm32";
    if (named) {
        print("named");
    } else {
        print("unnamed: " + arch);
    }


    if (target_arch() != target_os()) {
        print("distinct halves");
    }
    let width: i32 = 0;
    if (target_arch() == "wasm32") {
        width = 32;
    } else if (target_arch() == "arm64" || target_arch() == "x86-64") {
        width = 64;
    }
    if (width != 0) {
        print("width known");
    }
    return 0;
}
