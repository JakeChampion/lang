// What every implementation must agree on about target_arch(): the value is
// one of the documented ISA names, and a branch on it takes the arm that
// name selects — on the interpreter, where the host is the target, as much
// as on a compile, where the value is a literal and the other arms are
// pruned. The per-target values are target_arch_x86_64 / target_arch_arm64 /
// target_arch_wasm32, which is also why the width below is asserted as
// "known" rather than printed: it is the one fact that differs per leg.
import "core/int";

function main(): i32 {
    var arch: string = target_arch();
    var named: boolean = arch == "arm64" || arch == "x86-64" || arch == "wasm32";
    if (named) {
        print("named");
    } else {
        print("unnamed: " + arch);
    }
    // The ISA half and the environment half are different questions: no
    // target names the same string for both.
    if (target_arch() != target_os()) {
        print("distinct halves");
    }
    var width: i32 = 0;
    if (target_arch() == "wasm32") {
        width = 32;
    } else if (target_arch() == "arm64" || target_arch() == "x86-64") {
        width = 64;
    }
    if (width != 0) {
        print("width known");
    }
    return 0;
}
