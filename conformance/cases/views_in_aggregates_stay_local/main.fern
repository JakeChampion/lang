// Views stored in a struct, tuple, enum, `Option` or array are fine
// while the aggregate stays inside the frame that owns the storage, and
// when they view a parameter the caller owns.

struct Window { xs: [i32], label: str }

enum Chunk { Part([i32]), Empty }

function total(xs: [i32]): i32 {
    let t: i32 = 0;
    for x in xs {
        t = t + x;
    }
    return t;
}

function window_of(a: i32[], label: str): Window {
    return Window { xs: a[1:3], label: label };
}

function chunk_total(c: Chunk): i32 {
    match (c) {
        Chunk.Part(xs) => { return total(xs); },
        Chunk.Empty => { return 0; }
    }
}

function main(): i32 {
    let a: i32[] = [1, 2, 3, 4];
    let s: string = "local" + " label";
    let w: Window = Window { xs: a[0:2], label: slice_unchecked(s, 0, 5) };
    print(total(w.xs));
    print(w.label);
    let pair: ([i32], i32) = (a[2:4], 10);
    print(total(pair.0) + pair.1);
    print(chunk_total(Chunk.Part(a[1:4])));
    let o: Option[[i32]] = Some(a[0:1]);
    match (o) {
        Some(xs) => { print(total(xs)); },
        None => { print(0); }
    }
    let parts: [i32][] = [a[0:2], a[2:4]];
    print(total(parts[0]) * total(parts[1]));
    let p: Window = window_of(a, "param");
    print(total(p.xs));
    print(p.label);
    return 0;
}
