// A nested function that calls itself and reads a local of its function is a
// value as other functions are. It keeps the local that it read when a later
// block binds the name again.

function apply(f: (i32) => i32, x: i32): i32 {
  return f(x);
}

@noinline
function never(): boolean {
  return false;
}

function main(): i32 {
  let k = 3;
  function add_down(n: i32): i32 {
    if (n == 0) {
      return k;
    }
    return 1 + add_down(n - 1);
  }
  let fs = [add_down];
  print(f"{fs[0](4)} {apply(add_down, 2)}");

  function through(n: i32): i32 {
    if (n <= 0) {
      return k;
    }
    return apply(through, n - 1) + 1;
  }
  print(through(3));

  function plain(n: i32): i32 {
    return n + k;
  }
  if (never()) {
    function plain(n: i32): i32 {
      if (n == 0) {
        return k;
      }
      return 1 + plain(n - 1);
    }
  }
  print(plain(4));

  if (k == 3) {
    let k = 20;
    print(add_down(1) + k);
  }
  for k in 5..6 {
    print(add_down(1) + k);
  }

  function outer(n: i32): i32 {
    function inner(m: i32): i32 {
      if (m == 0) {
        return n + k;
      }
      return inner(m - 1);
    }
    if (n == 0) {
      return inner(2);
    }
    return outer(n - 1) + inner(1);
  }
  print(outer(2));
  return 0;
}
