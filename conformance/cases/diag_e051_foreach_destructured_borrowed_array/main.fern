// The array is borrowed, so its elements and their fields are borrowed.
struct Handle { fd: i32, name: string }
function (own h: Handle) close(): i32 { return h.fd; }
struct Pair { k: i32, h: Handle }
function bad(ps: Pair[]): i32 { let t = 0; for p in ps { let Pair { k, h } = p; t += k + h.close(); } return t; }
function main(): i32 { return 0; }
