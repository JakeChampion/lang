import "std/i32";

function main(): i32 {
  match (i32.parse_i32_radix("ff", 16)) {
    Ok(v) => {
      print(v.to_string());
    },
    Err(_) => {
      print("none");
    }
  }
  match (i32.parse_i32_radix("-42", 10)) {
    Ok(v) => {
      print(v.to_string());
    },
    Err(_) => {
      print("none");
    }
  }
  match (i32.parse_i32_radix("101", 2)) {
    Ok(v) => {
      print(v.to_string());
    },
    Err(_) => {
      print("none");
    }
  }
  match (i32.parse_i32_radix("zz", 36)) {
    Ok(v) => {
      print(v.to_string());
    },
    Err(_) => {
      print("none");
    }
  }
  match (i32.parse_i32_radix("12x", 10)) {
    Ok(v) => {
      print("ok");
    },
    Err(_) => {
      print("none");
    }
  }
  match (i32.parse_i32_radix("", 10)) {
    Ok(v) => {
      print("ok");
    },
    Err(_) => {
      print("none");
    }
  }
  print(255.to_string_radix(16));
  return 0;
}
