// core/cmp gives arrays and tuples the Eq, Ord and Hash of their parts.
// An array orders lexicographically, a tuple by its first element first.
import "core/cmp";
import "std/option";

@derive(cmp.Eq, cmp.Ord, cmp.Hash)
struct P { x: i32 }

function show(xs: i32[][]): string {
  let out: string = "";
  for x in xs {
    out = out + "[";
    for v in x {
      out = out + v.to_string() + " ";
    }
    out = out + "] ";
  }
  return out;
}

function pairs(xs: (i32, string)[]): string {
  let out: string = "";
  for p in xs {
    out = out + p.0.to_string() + p.1 + " ";
  }
  return out;
}

function main(): i32 {
  let a: i32[] = [1, 2, 3];
  let b: i32[] = [1, 2];
  print(f"{a == [1, 2, 3]} {a == b} {a != b} {b < a} {a < [1, 3]} {a.cmp(a)}");
  let n: i32[][] = [[1], [2, 3]];
  print(f"{n == [[1], [2, 3]]} {n == [[1], [2]]}");
  print(show(cmp.sort([[2], [1, 5], [1], []])));
  print(f"{a.hash() == [1, 2, 3].hash()} {a.hash() == b.hash()}");
  let t: (i32, string) = (1, "a");
  print(f"{t == (1, "a")} {t == (1, "b")} {t < (1, "b")} {t < (0, "z")}");
  print(pairs(cmp.sort([(2, "a"), (1, "b"), (1, "a")])));
  print(f"{t.hash() == (1, "a").hash()} {t.hash() == (2, "a").hash()}");
  let t3: (i32, boolean, string) = (1, true, "x");
  let t4: (i32, i32, i32, i32) = (1, 2, 3, 4);
  print(f"{t3 == (1, true, "x")} {t4 < (1, 2, 3, 5)} {t4.cmp((1, 2, 3, 4))}");
  let o: Option[i32[]] = Some([1, 2]);
  print(f"{o == Some([1, 2])} {o == None} {o.hash() == Some([1, 2]).hash()}");
  let ps: P[] = [P { x: 1 }];
  print(f"{ps == [P { x: 1 }]} {cmp.contains(n, [2, 3])} {cmp.index_of([t], (1, "a")).is_some()}");
  return 0;
}
