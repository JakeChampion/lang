







import "core/int";
import "std/string";
function cat(a: string, b: string): string { return a + b; }
function callit(f: () => i32): i32 { return f(); }
function main(): i32 {
    let s: string = cat("ab", "cd");
    let f: () => i32 = () => s.len();
    let x: i32 = callit(f);
    let y: i32 = s.len();
    return (x + y - 8) + __rc_underflow_count();
}
