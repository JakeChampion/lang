


import "std/array";
import "std/option";

function inc(x: i32): i32 { return x + 1; }
function pos(x: i32): boolean { return x > 0; }
function add(a: i32, b: i32): i32 { return a + b; }

function main(): i32 {
    let a: i32[] = [1, 0 - 2, 3, 0 - 4];
    let r: i32 = 0;
    r = r + a.map(inc).fold(0, add);
    r = r + a.filter(pos).len();
    if (a.any(pos) && !a.all(pos)) { r = r + 10; }
    r = r + a.find(pos).unwrap_or(0);
    r = r + a.enumerate().len();
    return r;
}
