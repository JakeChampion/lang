




import "core/cmp";
import "core/int";

@derive(cmp.Eq, cmp.Hash)
struct Point { x: i32, y: i32 }

@derive(cmp.Hash)
enum Shape { Dot, Circle(i32), Rect(i32, i32) }

function main(): i32 {
    let r: i32 = 0;
    let a: Point = Point { x: 3, y: 4 };
    let b: Point = Point { x: 3, y: 4 };
    let c: Point = Point { x: 5, y: 4 };
    if (a.hash() == b.hash()) { r = r + 1; }
    if (a.hash() != c.hash()) { r = r + 2; }
    if ("hello".hash() != 0) { r = r + 4; }
    if (Dot.hash() != Circle(0).hash()) { r = r + 8; }
    if (Circle(7).hash() == Circle(7).hash()) { r = r + 16; }
    if (Circle(7).hash() != Rect(7, 0).hash()) { r = r + 32; }
    return r;
}
