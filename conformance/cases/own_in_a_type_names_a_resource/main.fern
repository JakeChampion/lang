



resource Conn;

function peek(c: borrow Conn): i32 { return 0; }

function close(c: own Conn): i32 { return peek(c); }

function total(own xs: i32[]): i32 { return xs.len(); }

function apply(f: (own i32[]) => i32): i32 { return f([1, 2]); }

struct Point { x: i32 }

function length(p: own Point): i32 { return 0; }

function main(): i32 { return apply(total); }
