



























import "std/i32";

enum Inner { Ok2(i32), Err2(i32) }
enum Outer { A(Inner), B }
enum Wrap { W((i32, i32)), Z(i32) }
enum Tag { T(string), U }



function nested(t: (Outer, i32)): i32 {
    match (t) {
        (A(Ok2(n)), y) => { return n + y; },
        (A(Err2(n)), y) => { return 0 - n - y; },
        (A(x), y) => { return 1000 + y; },
        (B(), y) => { return 7000 + y; },
        _ => { return 0; },
    }
}



function lit(t: (Wrap, i32)): i32 {
    match (t) {
        (Z(9), y) => { return 900 + y; },
        (Z(n), y) => { return n + y; },
        _ => { return 0 - 1; },
    }
}



function tup(t: (Wrap, i32)): i32 {
    match (t) {
        (W((0, b)), y) => { return 100 + b + y; },
        (W((a, b)), y) => { return a * b + y; },
        _ => { return 0 - 2; },
    }
}



function tagged(t: (Tag, i32)): i32 {
    match (t) {
        (T("go"), y) => { return 10 + y; },
        (T(s), y) => { return y; },
        (U(), y) => { return 20 + y; },
        _ => { return 0; },
    }
}



function deep(t: ((Outer, i32), i32)): i32 {
    match (t) {
        ((A(Ok2(n)), b), y) => { return n * 100 + b * 10 + y; },
        ((A(x), b), y) => { return b * 10 + y; },
        _ => { return 0 - 3; },
    }
}



function both(t: (Outer, Wrap)): i32 {
    match (t) {
        (A(Ok2(n)), Z(9)) => { return 9000 + n; },
        (A(Ok2(n)), Z(m)) => { return n * 10 + m; },
        (A(x), Z(m)) => { return m; },
        _ => { return 0 - 4; },
    }
}



function guarded(t: (Outer, i32)): i32 {
    match (t) {
        (A(Ok2(n)), y) when n > y => { return n; },
        (A(Ok2(n)), y) => { return y; },
        _ => { return 0; },
    }
}

function main(): i32 {
    print(nested((Outer.A(Inner.Ok2(5)), 1)).to_string());
    print(nested((Outer.A(Inner.Err2(3)), 2)).to_string());
    print(nested((Outer.B, 4)).to_string());

    print(lit((Wrap.Z(9), 1)).to_string());
    print(lit((Wrap.Z(2), 1)).to_string());

    print(tup((Wrap.W((0, 6)), 1)).to_string());
    print(tup((Wrap.W((3, 4)), 1)).to_string());

    print(tagged((Tag.T("go"), 1)).to_string());
    print(tagged((Tag.T("stop"), 7)).to_string());
    print(tagged((Tag.U, 1)).to_string());

    print(deep(((Outer.A(Inner.Ok2(3)), 4), 5)).to_string());
    print(deep(((Outer.A(Inner.Err2(3)), 4), 5)).to_string());

    print(both((Outer.A(Inner.Ok2(2)), Wrap.Z(9))).to_string());
    print(both((Outer.A(Inner.Ok2(2)), Wrap.Z(3))).to_string());
    print(both((Outer.A(Inner.Err2(2)), Wrap.Z(3))).to_string());

    print(guarded((Outer.A(Inner.Ok2(9)), 1)).to_string());
    print(guarded((Outer.A(Inner.Ok2(1)), 9)).to_string());
    print(guarded((Outer.B, 9)).to_string());
    return 0;
}
