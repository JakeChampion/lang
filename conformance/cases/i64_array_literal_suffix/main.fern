













import "std/i32";

struct Holder { v: i64[] }
struct UHolder { v: u64[] }

function main(): i32 {
    let h: Holder = Holder { v: [7i64, 9i64] };
    if ((h.v[1] as i32) != 9) { return 1; }
    if ((h.v[0] as i32) != 7) { return 2; }
    if (h.v.len() != 2) { return 3; }

    let u: UHolder = UHolder { v: [7u64, 9u64] };
    if ((u.v[1] as i32) != 9) { return 4; }



    let one: UHolder = UHolder { v: [1u64, 2u64] };
    if (one.v[0] != 1u64) { return 5; }

    let t: (i64[], i32) = ([7i64, 9i64], 1);
    if ((t.0[1] as i32) != 9) { return 6; }


    let big: i64[] = [5000000000, 9i64];
    if ((big[1] as i32) != 9) { return 7; }

    return 11;
}
