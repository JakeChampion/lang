// spec: SC-02
// Every raw builtin a program can reach is accepted inside an unsafe block:
// an allocation, a store, a load, a release, a copy, a fill and a length
// change, in a function body, in a loop, and in a closure.

function fill(): i32 {
    let total: i32 = 0;
    unsafe {
        let p: usize = __alloc(32);
        __memset(p, 0, 32);
        let i: i32 = 0;
        while (i < 8) {
            __store_i32(p + (i * 4) as usize, i + 1);
            i = i + 1;
        }
        let q: usize = __alloc(32);
        __memcpy(q, p, 32);
        i = 0;
        while (i < 8) {
            total = total + __load_i32(q + (i * 4) as usize);
            i = i + 1;
        }
        __free(q, 32);
        __free(p, 32);
    }
    return total;
}

function shrink(): i32 {
    let xs: u8[] = [1, 2, 3, 4];
    unsafe {
        __arr_set_len(xs, 2);
    }
    return xs.len();
}

function main(): i32 {
    let copied: () => i32 = (): i32 => {
        let n: i32 = 0;
        unsafe {
            let p: usize = __alloc(8);
            __store_i64(p, 4 as i64);
            n = __load_i64(p) as i32;
            __free(p, 8);
        }
        return n;
    };
    print(fill());
    print(shrink());
    print(copied());
    return 0;
}
