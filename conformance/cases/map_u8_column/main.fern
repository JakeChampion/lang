import "core/map";


















function main(): i32 {
    let keyed: Map[u8, i32] = map_new(2);
    let i: i32 = 0;
    while (i < 12) { keyed = keyed.insert(i as u8, i * 2); i = i + 1; }
    let ks: u8[] = keyed.keys();
    if (ks.len() != 12) { return 1; }
    if ((ks[5] as i32) != 5) { return 2; }
    if ((ks[11] as i32) != 11) { return 3; }
    let ksum: i32 = 0;
    for k in ks { ksum = ksum + (k as i32); }
    if (ksum != 66) { return 4; }

    let valued: Map[i32, u8] = map_new(2);
    let j: i32 = 0;
    while (j < 12) { valued = valued.insert(j, (j * 2) as u8); j = j + 1; }
    let vs: u8[] = valued.values();
    if (vs.len() != 12) { return 5; }
    if ((vs[5] as i32) != 10) { return 6; }
    let vsum: i32 = 0;
    for v in vs { vsum = vsum + (v as i32); }
    if (vsum != 132) { return 7; }

    let empty: Map[u8, i32] = map_new(2);
    let eks: u8[] = empty.keys();
    if (eks.len() != 0) { return 8; }

    let one: Map[u8, i32] = map_new(2);
    one = one.insert(9 as u8, 1);
    let oks: u8[] = one.keys();
    if (oks.len() != 1) { return 9; }
    if ((oks[0] as i32) != 9) { return 10; }

    return 42;
}
