// A `u32` Some payload bound in a value-position `match` whose other arm holds
// a CAPTURING value-position `if`. The capturing lambda cannot be hoisted, so
// the desugar stays an inline IIFE and its payload-width gate applies — the gate
// that named i32 and not u32 (#6400, fixed by #6497).
//
// #6497 pins this on the self-host x86-64 and arm64 IR paths. This case is the
// lane those do not reach: the four NATIVE backends, and the self-host WASM
// fixture leg. #6400 spent a comment correcting a wasm datapoint that was never
// a real measurement, which is reason enough to have one that runs.
function main(): i32 {
    var b: boolean = true;

    // None path: 2147484129 - 2147484571 underflows.
    var w: u32 = (match ((2147484129u32) -? (2147484571u32)) { Some(c) => c, None => (if (b) { 5u32 } else { 687u32 }) });
    if (w != 5u32) { return 1; }

    // Some path, above i32-max: the payload must survive the result temp whole
    // rather than being read back as a negative.
    var big: u32 = (match ((4000000000u32) -? (1u32)) { Some(c) => c, None => (if (b) { 0u32 } else { 1u32 }) });
    if (big != 3999999999u32) { return 2; }
    if ((big / 1000000u32) != 3999u32) { return 3; }

    return 0;
}
