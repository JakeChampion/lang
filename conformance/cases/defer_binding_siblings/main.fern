import "core/int";



function observe(enabled: boolean): i32 {
    let seen: i32 = 0;
    loop {
        if (enabled) {
            let items: i32[] = [1];
            defer seen = seen * 10 + items[0];
            items = [3];
        }
        if (enabled) {
            let items: i32[] = [2];
            defer seen = seen * 10 + items[0];
            items = [5];
        }
        break;
    }
    return seen;
}

function main(): i32 {
    return observe(true) + observe(false);
}
