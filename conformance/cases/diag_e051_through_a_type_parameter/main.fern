// spec: ML-01

struct H { fd: i32 }

function (own h: H) close(): void {}

function consume(own xs: H[]): i32 {
  return xs[0].fd;
}

function same[A](a: A): A {
  return a;
}

function relay(xs: H[]): H[] {
  return same(xs);
}

function main(): i32 {
  let xs: H[] = [H { fd: 1 }];
  return consume(relay(xs)) + xs[0].fd;
}
