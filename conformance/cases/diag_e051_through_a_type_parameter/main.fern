// spec: ML-01




struct Res { xs: i32[] }
function (own r: Res) close(): void {}

function consume(own r: Res): i32 { return r.xs[0]; }

function same[A](a: A): A { return a; }

function relay(r: Res): Res { return same(r); }

function main(): i32 {
    let r = Res { xs: [1] };
    return consume(relay(r));
}
