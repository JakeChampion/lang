



import "std/option";
import "std/result";

function inc(x: i32): i32 { return x + 1; }
function pos(x: i32): boolean { return x > 0; }

function main(): i32 {
    let a: Option[i32] = Some(10);
    let n: Option[i32] = None;
    let r: i32 = 0;
    r = r + a.unwrap_or(0) + n.unwrap_or(5);
    if (a.is_some() && n.is_none()) { r = r + 1; }
    r = r + a.map(inc).unwrap_or(0);
    r = r + a.filter(pos).unwrap_or(0);
    let oe: Result[i32, i32] = a.ok_or(99);
    r = r + oe.unwrap_or(0);

    let ok: Result[i32, i32] = Ok(20);
    let er: Result[i32, i32] = Err(3);
    r = r + ok.unwrap_or(0) + er.unwrap_or(8);
    r = r + ok.map(inc).unwrap_or(0);
    if (ok.is_ok() && er.is_err()) { r = r + 1; }
    r = r + ok.ok().unwrap_or(0);
    r = r + er.err().unwrap_or(0);


    r = r + a.map_or(0, inc) + n.map_or(7, inc);
    if (a.is_some_and(pos)) { r = r + 1; }
    r = r + a.or(Some(1)).unwrap_or(0);
    r = r + n.or(Some(4)).unwrap_or(0);
    r = r + a.and(Some(2)).unwrap_or(0);
    r = r + n.and(Some(9)).unwrap_or(0);


    r = r + ok.map_or(0, inc) + er.map_or(6, inc);
    if (ok.is_ok_and(pos)) { r = r + 1; }
    if (er.is_err_and(pos)) { r = r + 1; }
    let ok1: Result[i32, i32] = Ok(1);
    let ok5: Result[i32, i32] = Ok(5);
    r = r + ok.or(ok1).unwrap_or(0);
    r = r + er.or(ok5).unwrap_or(0);
    return r;
}
