// Each function has the name of a raw builtin. In the entry module the
// function of the program is the one that a call names, with no unsafe
// block, as for each other builtin name. Each one recurses, so no pass
// inlines it.

function __load_u8(n: i32): i32 {
  if (n <= 0) {
    return 7;
  }
  return __load_u8(n - 1) + 1;
}

function __bytes_data(text: string): string {
  if (text.len() >= 6) {
    return text;
  }
  return __bytes_data(text + "!");
}

function __task_new(n: i32): i32 {
  if (n <= 0) {
    return 0;
  }
  return __task_new(n - 1) + 3;
}

function main(): i32 {
  print(__load_u8(3).to_string());
  print(__bytes_data("own"));
  let kept = __bytes_data("kept");
  print(kept);
  print(__task_new(4).to_string());
  return 0;
}
