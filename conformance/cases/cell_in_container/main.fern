import "std/i32";





















enum Holder { Has(Cell[string]), Nothing }

function main(): i32 {

    let ti: (i32, Cell[i32]) = (7, cell_new(0));
    ti.1.set(ti.1.get() + ti.0);
    print(ti.1.get().to_string());


    let h: Holder = Has(cell_new("x"));
    match (h) {
        Has(c) => {
            c.set(c.get() + "y");
            print(c.get());
        },
        Nothing => { print("none"); }
    }




    let shared: Cell[string] = cell_new("s");
    let t1: (i32, Cell[string]) = (1, shared);
    let t2: (i32, Cell[string]) = (2, shared);
    t1.1.set("s!");
    print(t2.1.get());
    return 0;
}
