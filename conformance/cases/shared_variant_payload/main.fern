










enum A { W(i32), P }
enum B { W(f64), Q }
enum C { W(string), R }
enum D { W(i64), S }

function a_of(v: A): i32 {
    match (v) {
        A.W(n) => { return n; },
        A.P => { return 0; },
    }
}

function b_of(v: B): i32 {

    match (v) {
        B.W(n) => { if (n == 4.5) { return 2; } return 0; },
        B.Q => { return 0; },
    }
}

function c_of(v: C): i32 {


    match (v) {
        C.W(s) => { return s.len(); },
        C.R => { return 0; },
    }
}

function d_of(v: D): i32 {

    match (v) {
        D.W(n) => { if (n == 4294967296) { return 8; } return 0; },
        D.S => { return 0; },
    }
}



function b_bare(v: B): i32 {
    match (v) {
        W(n) => { if (n == 4.5) { return 16; } return 0; },
        _ => { return 0; },
    }
}

function main(): i32 {
    let total: i32 = 0;
    total = total + a_of(A.W(1));
    total = total + b_of(B.W(4.5));
    total = total + c_of(C.W("abcd"));
    total = total + d_of(D.W(4294967296));
    total = total + b_bare(B.W(4.5));
    return total;
}
