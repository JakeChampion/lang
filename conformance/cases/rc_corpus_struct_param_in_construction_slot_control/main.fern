







struct Ty { w: i32, s: string }
struct Node { ty: Ty, n: i32 }

@noinline
function t_i32(): Ty { return Ty { w: 32, s: "x" }; }

@noinline
function mknode(t: Ty, n: i32): Node { return Node { ty: t, n: n }; }

function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 4) {
        let nd: Node = mknode(t_i32(), i);
        acc = acc + nd.n;
        i = i + 1;
    }
    return (acc - 6) + __rc_underflow_count();
}
