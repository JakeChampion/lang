



function churn(n: i32): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let a: (i32, i32[]) = (i, [i, i + 1]);
        let s: i32 = a.0 + a.1[0] + a.1[1];
        let b: (i32, i32[]) = (s, [i + 2, i + 3]);
        acc = acc + b.0 + b.1[0] + b.1[1];
        i = i + 1;
    }
    return acc;
}

function main(): i32 {
    if (churn(200) != 100700) { return 99; }
    return 0;
}
