// spec: AL-01


















import "std/i32";
import "std/i64";

function rounds(r: Reader, size: i32, n: i32): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        match (r.read_chunk(size)) {
            Ok(chunk) => {
                if (chunk.len() == 0) { return acc; }
                acc = acc + chunk.len();
            },
            Err(e) => { return acc; }
        }
        i = i + 1;
    }
    return acc;
}

function main(): i32 {
    let r: Reader = stdin();
    let warm: i32 = rounds(r, 16, 1);
    let b0: i64 = __heap_bump_bytes();
    let x1: i32 = rounds(r, 16, 20);
    let b1: i64 = __heap_bump_bytes();
    let x2: i32 = rounds(r, 16, 20);
    let b2: i64 = __heap_bump_bytes();
    warm = warm + rounds(r, 1024, 1);
    let b3: i64 = __heap_bump_bytes();
    let y1: i32 = rounds(r, 1024, 20);
    let b4: i64 = __heap_bump_bytes();
    let y2: i32 = rounds(r, 1024, 20);
    let b5: i64 = __heap_bump_bytes();

    print(warm.to_string());
    print((x1 + x2).to_string());
    print((y1 + y2).to_string());

    if ((b2 - b1) > 0 || (b5 - b4) > 0) { print("scales"); } else { print("constant"); }
    return 0;
}
