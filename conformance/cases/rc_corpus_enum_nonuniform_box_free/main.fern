








import "core/int";
enum V { I(i32), A(i32[]) }
function mk(seed: i32): i32 {
    let v: V = A([seed, seed + 1]);
    let w: V = I(seed);
    let got: i32 = 0;
    match (v) { I(n) => { got = n; }, A(xs) => { got = xs[1]; } }
    match (w) { I(n) => { got = got + n; }, A(xs) => { got = got + xs[0]; } }
    return got;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 200) { total = total + mk(k); k = k + 1; }
    return (total - 40000) + __rc_underflow_count();
}
