



import "core/cmp";

function main(): i32 {
    let a: i32[] = cmp.sort_in_place([5, 3, 8, 1, 9, 2, 7]);

    if (a[0] != 1) { return 1; }
    if (a[6] != 9) { return 2; }
    if (a[3] != 5) { return 3; }
    let b: i32[] = cmp.sort_desc_in_place([5, 3, 8, 1, 9, 2, 7]);
    if (b[0] != 9) { return 4; }
    if (b[6] != 1) { return 5; }
    return 0;
}
