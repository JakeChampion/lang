// spec: AL-04


















import "core/map";
import "std/i32";
import "std/i64";

function lookups(index: Map[string, i32], n: i32): i32 {
    let i: i32 = 0;
    let hits: i32 = 0;
    while (i < n) {
        match (index.get("alpha")) {
            Some(g) => { hits = hits + g; },
            None => { hits = hits - 1; }
        }
        match (index.get("absent")) {
            Some(g) => { hits = hits + g; },
            None => { hits = hits + 2; }
        }
        i = i + 1;
    }
    return hits;
}

function main(): i32 {
    let index: Map[string, i32] = map_new(64);
    index = index.insert("alpha", 1);

    let b0: i64 = __heap_bump_bytes();
    let x: i32 = lookups(index, 50);
    let b1: i64 = __heap_bump_bytes();
    let y: i32 = lookups(index, 100);
    let b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());

    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }

    match (index.get("alpha")) { Some(g) => { print(g.to_string()); }, None => { print("lost"); } }
    return 0;
}
