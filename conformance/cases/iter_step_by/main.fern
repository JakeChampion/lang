import "core/iter";

function main(): i32 {
    let xs: i32[] = iter.range(0, 10).step_by(3).collect();
    if (xs.len() != 4 || xs[0] != 0 || xs[1] != 3 || xs[3] != 9) { return 1; }
    let exact: i32[] = iter.range(0, 9).step_by(3).collect();
    if (exact.len() != 3 || exact[2] != 6) { return 2; }
    if (iter.range(0, 10).step_by(0).len() != 0) { return 3; }
    if (iter.range(0, 10).step_by(-2).len() != 0) { return 4; }
    if (iter.range(0, 5).step_by(1).len() != 5) { return 5; }
    let tens: i32[] = iter.range(1, 8).map((x: i32): i32 => x * 10).step_by(2).collect();
    if (tens.len() != 4 || tens[0] != 10 || tens[3] != 70) { return 6; }
    let tail: i32[] = iter.range(0, 20).step_by(5).skip(1).collect();
    if (tail.len() != 3 || tail[0] != 5) { return 7; }
    return 42;
}
