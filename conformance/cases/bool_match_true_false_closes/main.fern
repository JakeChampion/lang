


function pick(b: boolean): i32 {
  match (b) {
    true => {
      return 7;
    },
    false => {
      return 3;
    }
  }
}

function name(b: boolean): string {
  return match (b) { false => "no", true => "yes" };
}

function main(): i32 {
  print(pick(true).to_string());
  print(pick(false).to_string());
  print(name(true));
  print(name(false));
  return pick(true) + pick(false);
}
