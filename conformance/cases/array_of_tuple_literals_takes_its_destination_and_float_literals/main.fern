// A tuple literal in an array literal takes the tuple type of a typed
// destination. An integer literal takes the float type of the same part of
// another tuple.
function main(): i32 {
    let i: i32 = 1;
    let widened: (i32, i64)[] = [(i, i)];
    print(widened[0].1 + 5000000000);
    let nested: (i64, (i32, i64[]))[] = [(i, (i, [i]))];
    print(nested[0].0 + nested[0].1.1[0] + 5000000000);
    let floats = [(1.5, 1), (2, 2)];
    print(floats[0].0 + floats[1].0);
    let later = [(1, 1), (2.5, 2)];
    print(later[0].0 + later[1].0);
    return 0;
}
