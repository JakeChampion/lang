











@noinline
function apply(f: (i32) => i32, v: i32): i32 { return f(v); }

@noinline
function run(f: (i32) => void, v: i32): void { f(v); }

@noinline
function returning(): i32 {
    let sink: i32 = 3;
    let add = (x: i32) => sink + x;
    return apply(add, 4) - 4;
}

@noinline
function statement(): i32 {
    let sink: i32 = 0;
    let log = (x: i32) => { sink = sink + x * 2; };
    run(log, 4);
    return sink - 8;
}

@noinline
function direct(): i32 {
    let sink: i32 = 0;
    let log = (x: i32) => { sink = sink + x * 2; };
    log(4);
    return sink - 8;
}

function main(): i32 {
    let t: i32 = 0;
    let i: i32 = 0;
    while (i < 4) { t = t + returning() + statement() + direct(); i = i + 1; }
    return (t - 12) + __rc_underflow_count();
}
