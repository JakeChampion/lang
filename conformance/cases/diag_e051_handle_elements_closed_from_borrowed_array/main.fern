// spec: RH-23
// A for-each over a borrowed array lends each element, so a consuming
// close of an element is refused.

struct Handle { fd: i32 }

function (own h: Handle) close(): i32 {
  return h.fd;
}

function close_all(hs: Handle[]): i32 {
  let n: i32 = 0;
  for h in hs {
    n = n + h.close();
  }
  return n;
}

function main(): i32 {
  return close_all([Handle { fd: 1 }]);
}
