import "std/http";
import "std/string";

// #4385: the plain http_response_* builders never set Content-Type,
// so a JSON API response could be sniffed as text. The typed builders
// (json / html / plain / json_status) and the with_content_type method
// set the media type up front. This pins that each media type reaches
// the serialized wire output. Returns 42 only if every check holds.
function main(): i32 {
    var j: string = http.http_serialize_response(http.http_response_json("{}"));
    if (!j.contains("content-type: application/json")) { return 1; }

    var h: string = http.http_serialize_response(http.http_response_html("<p>"));
    if (!h.contains("content-type: text/html; charset=utf-8")) { return 2; }

    var p: string = http.http_serialize_response(http.http_response_plain("x"));
    if (!p.contains("content-type: text/plain; charset=utf-8")) { return 3; }

    // Explicit status flows through with the JSON media type.
    var c: string = http.http_serialize_response(http.http_response_json_status(201, "{}"));
    if (!c.contains("HTTP/1.1 201 Created")) { return 4; }
    if (!c.contains("content-type: application/json")) { return 5; }

    // with_content_type overrides on top of a plain builder.
    var csv: string = http.http_serialize_response(
        http.http_response_ok("a,b").with_content_type("text/csv"));
    if (!csv.contains("content-type: text/csv")) { return 6; }

    // A plain builder still emits no Content-Type (unchanged behaviour).
    var ok: string = http.http_serialize_response(http.http_response_ok("hi"));
    if (ok.contains("content-type")) { return 7; }

    return 42;
}
