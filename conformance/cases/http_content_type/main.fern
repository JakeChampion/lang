import "std/http";
import "std/string";






function main(): i32 {
    let j: string = http.http_serialize_response(http.json("{}"));
    if (!j.contains("Content-Type: application/json")) { return 1; }

    let h: string = http.http_serialize_response(http.html("<p>"));
    if (!h.contains("Content-Type: text/html; charset=utf-8")) { return 2; }

    let p: string = http.http_serialize_response(http.plain("x"));
    if (!p.contains("Content-Type: text/plain; charset=utf-8")) { return 3; }


    let c: string = http.http_serialize_response(http.json_status(201, "{}"));
    if (!c.contains("HTTP/1.1 201 Created")) { return 4; }
    if (!c.contains("Content-Type: application/json")) { return 5; }


    let csv: string = http.http_serialize_response(
        http.ok("a,b").with_content_type("text/csv"));
    if (!csv.contains("Content-Type: text/csv")) { return 6; }


    let ok: string = http.http_serialize_response(http.ok("hi"));
    if (ok.contains("Content-Type")) { return 7; }

    return 42;
}
