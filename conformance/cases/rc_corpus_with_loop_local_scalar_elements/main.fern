







function mk_ints(): i32[] { return [0, 1]; }
function f(n: i32): i32 {
    let t: i32 = 0;
    for i in 0..n {
        let it: i32[] = mk_ints();
        let a: i32[] = it.with(0, i);
        t = t + a[0];
    }
    return t;
}
function main(): i32 { return (f(20) - 190) + __rc_underflow_count(); }
