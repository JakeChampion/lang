










function mk(seed: i32): i32 {
    let pre: string = "v";
    let s: string = pre + "x";
    let t: (string, i32) = (s, seed);
    let (a, b) = t;
    return a.len() + t.0.len() + s.len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 100) { total = total + mk(k); k = k + 1; }
    return (total - 600) + __rc_underflow_count();
}
