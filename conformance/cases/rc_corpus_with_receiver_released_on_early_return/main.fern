







enum N { L(i32), B(i32, N[]) }
function mk(c: i32, flag: boolean): N {
    let ks: N[] = [];
    ks = ks.append(L(1));
    ks = ks.append(L(2));
    if (flag) { return L(c); }
    return B(c, ks.with(0, L(c)));
}
function count(n: N): i32 {
    match (n) {
        L(x) => { return 1; },
        B(c, kids) => { return kids.len(); }
    }
}
function main(): i32 {
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let n: N = mk(i, i % 2 == 0);
        total = total + count(n);
        i = i + 1;
    }
    return (total - 150) + __rc_underflow_count();
}
