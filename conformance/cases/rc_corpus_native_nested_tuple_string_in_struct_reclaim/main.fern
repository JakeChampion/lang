












import "core/int";
import "std/string";
struct Box { items: (string, i32) }
function mk(): i32 {
    let b: Box = Box { items: ("value-aaaaaaaaaaaaaaaaaa-" + "1", 7) };
    return b.items.0.len() + b.items.1;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 16500) + __rc_underflow_count();
}
