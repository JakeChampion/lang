



function main(): i32 {
    let v: i32 = 1;
    {
        let v: i32 = 5;
        let f: () => i32 = (): i32 => { return v; };
        if (f() != 5) { return 1; }
    }
    {
        let v: i32 = 7;
        let g: (i32) => i32 = (n: i32): i32 => { return v + n; };
        if (g(1) != 8) { return 2; }
    }
    if (v != 1) { return 3; }
    return 0;
}
