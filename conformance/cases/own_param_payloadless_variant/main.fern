




enum Extent { Empty, Wide(i32[]) }

@noinline function eat(own sp: Extent): i32 {
    match (sp) {
        Wide(xs) => { return xs.len(); },
        Empty => { return 0; }
    }
}









@noinline function borrowed_len(sp: Extent): i32 {
    match (sp) {
        Wide(xs) => { return xs.len(); },
        Empty => { return 0; }
    }
}

function main(): i32 {
    let total: i32 = 0;
    total = total + eat(Empty);
    total = total + eat(Extent.Empty);
    total = total + eat(Wide([1, 2, 3]));
    let held: Extent = Wide([4, 5]);
    total = total + borrowed_len(held);
    total = total + borrowed_len(held);
    let i: i32 = 0;
    while (i < 4) { total = total + eat(Empty) + eat(Wide([7])); i = i + 1; }
    return total;
}
