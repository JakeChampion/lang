// A `for` header takes the same destructuring pattern a `let` binding does,
// so a tuple-element array iterates without unpacking the element by hand:
// arity beyond two, a nested element and a `_` discard all behave as they do
// in `let (a, b) = e;`. Which loop the pattern lowers to comes from the
// iterand's type — an array binds it against each element, a Map against each
// entry — so the Map form is exercised here alongside as the control.

import "core/map";

function main(): i32 {
    let sum: i32 = 0;

    let xs: (i32, i32)[] = [(1, 2), (3, 4)];
    for (a, b) in xs { sum = sum + a * b; }                  // 2 + 12 = 14

    let wide: (i32, i32, i32)[] = [(1, 2, 3), (4, 5, 6)];
    for (p, _, r) in wide { sum = sum + p + r; }             // 4 + 10 = 14

    let deep: ((i32, i32), string)[] = [((2, 3), "xy")];
    for ((a, b), s) in deep { sum = sum + a * b + s.len(); } // 6 + 2 = 8

    let m: Map[string, i32] = Map { "a": 1, "b": 2 };
    for (k, v) in m { sum = sum + v + k.len(); }             // 3 + 2 = 5

    return sum;                                              // 41
}
