






import "core/map";

function main(): i32 {
    let sum: i32 = 0;

    let xs: (i32, i32)[] = [(1, 2), (3, 4)];
    for (a, b) in xs { sum = sum + a * b; }

    let wide: (i32, i32, i32)[] = [(1, 2, 3), (4, 5, 6)];
    for (p, _, r) in wide { sum = sum + p + r; }

    let deep: ((i32, i32), string)[] = [((2, 3), "xy")];
    for ((a, b), s) in deep { sum = sum + a * b + s.len(); }

    let m: Map[string, i32] = Map { "a": 1, "b": 2 };
    for (k, v) in m { sum = sum + v + k.len(); }

    return sum;
}
