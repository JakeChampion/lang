// spec: ML-01
// A snapshot of a borrowed map holds the elements of that map. The map still
// owns them, so the snapshot does not go to an `own` parameter.

import "std/pmap";

struct H { fd: i32 }

function (own h: H) close(): i32 { return h.fd; }

function take(own xs: H[]): i32 { return xs.len(); }

function bad(m: pmap.PMap[i32, H]): i32 {
    return take(m.values());
}

function main(): i32 { return 0; }
