







import "core/int";
import "std/string";
function mk(): i32 {
    let p: (string, i32) = ("value-aaaaaaaaaaaaaaaaaa-" + "1", 7);
    let f: () => i32 = (): i32 => { return p.0.len() + p.1; };
    return f();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 16500) + __rc_underflow_count();
}
