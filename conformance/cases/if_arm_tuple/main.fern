function pick(cond: boolean): (i64, i32) {
    return if (cond) { (1234567890123, 42) } else { (9876543210, 0 - 1) };
}
function main(): i32 {
    var p = pick(true);
    var q = pick(false);
    if (p.0 == 1234567890123 && p.1 == 42 && q.0 == 9876543210 && q.1 == 0 - 1) { return 0; }
    return 1;
}
