// spec: AL-01
//
// The AL-01 shape for a value read OUT of a container that dies at the
// read: `mk()[0]` and `mk().field`. Nothing names the container, so the
// only place it can be reclaimed is the read itself — which also has to
// keep the extracted element alive, because the element aliases the
// buffer being freed.
//
// A sibling of alloc_flat_under_reclaim rather than a duplicate of it:
// that case lets the whole allocation die, so a lowering that simply
// never reclaims a container passes it. Here the element survives and
// the container does not, and getting only half of that right is a leak
// in one direction and a use-after-free in the other.
//
// Both consumers are covered because they reclaim by different routes:
// a BINDING takes the value as a move, while a borrowing `.len()`
// reclaims the temp after reading it. The index half leaked 304 B a
// round until the retain-and-deep-drop pair landed; the field half
// leaked 64 B a round in the borrowing shape alone.
//
// The case prints the SHAPE, never a byte count — see
// docs/ALLOCATION-OBSERVABLE.md.
import "std/i32";
import "std/i64";
import "std/string";

struct Box { name: string, k: i32 }

// Past the small-string threshold, so every element is a real heap
// buffer the container's deep drop has to reach.
function wide(n: i32): string { return "a-string-well-past-the-inline-threshold-" + n.to_string(); }

function strs(n: i32): string[] {
    var out: string[] = [];
    for i in 0..4 { out = out.append(wide(n + i)); }
    return out;
}

function boxed(n: i32): Box { return Box { name: wide(n), k: n }; }

function round(n: i32): i32 {
    var bound: string = strs(n)[1];
    var acc: i32 = bound.len() + strs(n)[0].len();
    var field: string = boxed(n).name;
    return acc + field.len() + boxed(n).name.len();
}

function rounds(n: i32): i32 {
    var acc: i32 = 0;
    for i in 0..n {
        acc = acc + round(i);
    }
    return acc;
}

function main(): i32 {
    var b0: i64 = __heap_bump_bytes();
    var x: i32 = rounds(50);
    var b1: i64 = __heap_bump_bytes();
    var y: i32 = rounds(100);
    var b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());
    // Twice the work must not cost more fresh memory.
    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
