// spec: CC-03
//
// Pins E049. The program is the example from that code's entry
// in the diagnostic catalogue (`fern explain E049`), so this case
// also checks the catalogue's example really does produce the error
// it documents.
function main(): i32 {
    var name: string = "a";
    var f = function (): i32 {
        name = "b";          // error[E049]: cannot assign to captured string "name"
        return name.len();
    };
    return f();
}
