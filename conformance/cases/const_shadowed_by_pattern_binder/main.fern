














const N: i32 = 5;


function shadow_for_each_pattern(): i32 {
    let xs: (i32, i32)[] = [(7, 1), (8, 2)];
    let t: i32 = 0;
    for (N, v) in xs {
        t = t + N;
    }
    return t;
}


function shadow_nested_destructure(): i32 {
    let t: ((i32, i32), i32) = ((7, 1), 2);
    let ((a, N), c) = t;
    return N + c;
}



function assign_to_pattern_binder(): i32 {
    let xs: (i32, i32)[] = [(7, 1)];
    let t: i32 = 0;
    for (N, v) in xs {
        N = 9;
        t = t + N;
    }
    return t;
}



function unshadowed(): i32 {
    return N;
}

function main(): i32 {
    let r: i32 = 0;
    if (shadow_for_each_pattern() == 15) { r = r + 1; }
    if (shadow_nested_destructure() == 3) { r = r + 2; }
    if (assign_to_pattern_binder() == 9) { r = r + 4; }
    return r + unshadowed();
}
