// `Vec[N, T]` is the second spelling of a lane type: `Vec[2, f64]` is f64x2
// and `Vec[4, f32]` is f32x4. A kernel over `Vec[N, T]` reads N as its lane
// count, and a call infers N and T from a lane type.
import "std/simd";
import "std/string";

function hsum[const N: i32, T](v: Vec[N, T]): f64 {
  let s: f64 = 0.0;
  let i: i32 = 0;
  while (i < N) {
    s = s + v.lane(i);
    i = i + 1;
  }
  return s;
}

function cube[const N: i32, T](v: Vec[N, T]): Vec[N, T] {
  return v.mul_add(v * v, v - v);
}

function weighted[const N: i32, T](xs: f64[], w: Vec[N, T]): f64 {
  let s: f64 = 0.0;
  let i: i32 = 0;
  while (i + N <= xs.len()) {
    let j: i32 = 0;
    while (j < N) {
      s = s + xs[i + j] * w.lane(j);
      j = j + 1;
    }
    i = i + N;
  }
  return s;
}

function head(v: Vec[2, f64]): f64 {
  return v.lane(0);
}

function main(): i32 {
  let a: Vec[2, f64] = __f64x2_of(1.0, 2.0);
  let b: f32x4 = __f32x4_of(1.0, 2.0, 3.0, 4.0);
  let xs: f64[] = [1.0, 1.0, 2.0, 2.0, 3.0, 3.0, 4.0, 4.0];
  print(head(a).to_string());
  print(hsum(a).to_string());
  print(hsum(b).to_string());
  print(hsum[2, f64](cube(a)).to_string());
  print(hsum(cube(b)).to_string());
  print(weighted(xs, a).to_string());
  print(weighted(xs, b).to_string());
  return 0;
}
