// Whether a call's result can be handed to an `own` parameter comes from what
// the callee RETURNS, not from whether it takes a reference. Every call below
// reaches `keep` through a callee that borrows a pointer and still builds its
// result fresh, so each one transfers.
function keep(own ys: i32[]): i32 { return ys[0] + ys.len(); }

function build(tag: string): i32[] { return [tag.len(), 1]; }
function sized(xs: i32[]): i32[] { return [xs.len(), 2]; }
function relay(ys: i32[]): i32[] { return sized(ys); }

// Recursion is seeded clean, so a cycle that returns only constructions is a
// fresh owner rather than the pessimistic answer.
function grow(xs: i32[], k: i32): i32[] {
    if (k <= 0) { return [xs.len(), 3]; }
    return grow(xs, k - 1);
}

// The callee that takes ownership and threads it out is the other shape a
// caller can transfer: it consumed the array, so nothing the caller holds
// aliases what comes back.
function thread(own xs: i32[], k: i32): i32[] {
    if (k <= 0) { return xs; }
    return [k, 4];
}

function main(): i32 {
    return keep(build("xy"))
         + keep(sized([1, 2, 3]))
         + keep(relay([1, 2, 3, 4]))
         + keep(grow([1, 2], 2))
         + keep(thread([7, 8], 0));
}
