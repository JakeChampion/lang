







import "core/int";
import "std/i32";
function main(): i32 {
    let len: (i32[]) => i32 = (xs: i32[]) => xs.len();
    let t: i32 = 0;
    let r: i32 = 0;
    while (r < 20) {
        let a: i32[] = [1, 2, 3];
        t = t + len(a) + len(a) + a[1];
        r = r + 1;
    }
    return (t - 160) + __rc_underflow_count();
}
