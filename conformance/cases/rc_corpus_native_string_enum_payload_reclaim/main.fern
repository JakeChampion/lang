









import "core/int";
import "std/string";
enum Msg { Text(string), Number(i32) }
function mk(): i32 {
    let m: Msg = Msg.Text("value-aaaaaaaaaaaaaaaaaa-" + "1");
    match (m) {
        Text(s) => { return s.len(); },
        Number(n) => { return n; }
    }
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 13000) + __rc_underflow_count();
}
