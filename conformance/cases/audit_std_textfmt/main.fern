import "core/int";
import "std/format";
import "std/csv";

// Audit fixture: std/csv + std/format helpers across every native backend.

function main(): i32 {
  let Ok(fields) = csv.parse_line("a,b,c") else {
    return 98;
  };
  if (fields.len() != 3) {
    print("FAIL csv-parse");
    return 11;
  }
  if (fields[0] != "a" || fields[2] != "c") {
    print("FAIL csv-elem");
    return 12;
  }
  if (csv.join(["p", "q"]) != "p,q") {
    print("FAIL csv-join");
    return 13;
  }
  // a value with a comma is quoted by csv.escape
  if (csv.escape("x,y").len() <= 3) {
    print("FAIL csv-escape");
    return 14;
  }
  if (format.format_bytes(1024).len() == 0) {
    print("FAIL fmt-bytes");
    return 15;
  }
  print("OK");
  return 0;
}
