// spec: IS-06
// spec: IS-07















import "std/i32";

function main(): i32 {
    let mn: i32 = -2147483648;
    let mx: i32 = 2147483647;


    print((mn / -1).to_string());
    print((mn % -1).to_string());
    print((mn / 1).to_string());
    print((mn % 1).to_string());


    let xs: i32[] = [7, -7, 7, -7];
    let ys: i32[] = [3, 3, -3, -3];
    for i in 0..xs.len() {
        print(xs[i].to_string() + "/" + ys[i].to_string() + "="
            + (xs[i] / ys[i]).to_string() + " %=" + (xs[i] % ys[i]).to_string());
    }



    print((mx + 1).to_string());
    print((mn - 1).to_string());
    print((mx * 2).to_string());
    print((0 - mn).to_string());
    if (0 - mn != mn) { return 1; }



    print((-8 >> 1).to_string());
    print((-1 >> 31).to_string());
    print((1 << 31).to_string());
    print((-1 << 1).to_string());


    print((-1 & 255).to_string());
    print((-8 | 7).to_string());
    print((-1 ^ 255).to_string());






    let w: i64 = mn as i64;
    let back: i32 = w as i32;
    if (back != mn) { return 2; }
    if (w != -2147483648) { return 3; }
    return 0;
}
