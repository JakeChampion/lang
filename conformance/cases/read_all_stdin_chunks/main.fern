import "std/io";











function main(): i32 {
  let s: string = "";
  match (io.read_all_stdin()) {
    Ok(text) => {
      s = text;
    },
    Err(_) => {
      return 9;
    }
  }
  let n: i32 = s.len();
  if (n != 5200) {
    return 1;
  }
  let i: i32 = 0;
  while (i < n) {
    let expected: i32 = 97 + i % 26;
    if (s[i] as i32 != expected) {
      return 2;
    }
    i = i + 1;
  }
  return 42;
}
