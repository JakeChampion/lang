// The element still holds the field for its second read.
struct Handle { fd: i32, name: string }
function (own h: Handle) close(): i32 { return h.fd; }
struct Pair { k: i32, h: Handle }
function bad(own ps: Pair[]): i32 { let t = 0; for p in ps { let h = p.h; t += h.close() + p.h.fd; } return t; }
function main(): i32 { return 0; }
