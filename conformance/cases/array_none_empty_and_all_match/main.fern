





function none[T](xs: T[], pred: (T) => boolean): boolean { for x in xs { if (pred(x)) { return false; } } return true; }
function is_neg(x: i32): boolean { return x < 0; }
function b2i(b: boolean): i32 { if (b) { return 1; } return 0; }
function main(): i32 { let e: i32[] = []; let negs: i32[] = [0 - 1, 0 - 2]; return b2i(none(e, is_neg)) * 10 + b2i(none(negs, is_neg)); }
