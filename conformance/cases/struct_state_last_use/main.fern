








struct Buf { code: i32[], names: string[], n: i32 }

function emit(s: Buf, v: i32): Buf {
    return Buf { ...s, code: s.code.append(v), n: s.n + 1 };
}

function name(s: Buf, nm: string): Buf {
    return Buf { ...s, names: s.names.append(nm) };
}

function lower_pair(s: Buf, a: i32, b: i32): Buf {
    let sl: Buf = emit(s, a);
    let sr: Buf = emit(sl, b);
    return sr;
}

function lower_chain(s: Buf, k: i32): Buf {
    let s1: Buf = emit(s, k);
    let s2: Buf = name(s1, "k");
    let s3: Buf = emit(s2, k + 2);
    let s4: Buf = emit(s3, k + 3);
    return s4;
}


function lower_rebound(s: Buf, k: i32): Buf {
    let st: Buf = emit(s, k);
    st = emit(st, k + 1);
    let out: Buf = emit(st, k + 2);
    return out;
}

function churn(): i32 {
    let junk: string[] = [];
    let i: i32 = 0;
    while (i < 300) { junk = junk.append("junk"); i = i + 1; }
    return junk.len();
}

function main(): i32 {
    let total: i32 = 0;
    let r: i32 = 0;
    while (r < 8) {
        let b: Buf = Buf { code: [], names: [], n: 0 };
        let i: i32 = 0;
        while (i < 30) {
            b = lower_pair(b, i, i * 2);
            b = lower_chain(b, i);
            b = lower_rebound(b, i);
            i = i + 1;
        }
        churn();
        let k: i32 = 0;
        while (k < b.code.len()) { total = total + b.code[k]; k = k + 1; }
        k = 0;
        while (k < b.names.len()) { total = total + b.names[k].len(); k = k + 1; }
        total = total + b.n;
        r = r + 1;
    }
    return total % 64;
}
