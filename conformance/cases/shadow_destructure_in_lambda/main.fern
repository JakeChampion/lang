// A lambda's destructuring parameter binds names that SHADOW the enclosing
// function's locals. The binders are renamed so the slot map's names stay
// unique within the function, and the checker registers each one as a
// synthetic local against the body that declares it — a lambda's locals
// belong to its own synthetic decl, not to the enclosing function — so the
// two have to be renamed together. Renaming only one is a refusal to compile
// ("destructure name has no slot"), not a wrong answer.
//
// The inner bindings must read the destructured argument and the outer ones
// must survive untouched, so this asserts both rather than merely exiting 0.
//
// One destructure site per case, on purpose: two in one function abort the
// wasm owned model (#7307). The combined case this was split out of belongs
// back here once that closes. Its struct-pattern parameter no longer needs
// waiting for — every implementation takes that spelling since #7306, and
// shadow_destructure_struct_param_in_lambda states this same property over it.
function main(): i32 {
    var x: i32 = 1;
    var y: i32 = 2;

    var lam = function ((x, y): (i32, i32)): i32 { return x * 10 + y; };
    if (lam((3, 4)) != 34) { return 1; }

    if (x != 1) { return 2; }
    if (y != 2) { return 3; }
    return 0;
}
