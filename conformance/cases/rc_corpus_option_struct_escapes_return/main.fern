





import "core/int";
struct Item { tags: i32[] }
function mk(n: i32): Option[Item] { return Some(Item { tags: [n, n + 1] }); }
function main(): i32 {
    let o: Option[Item] = mk(7);
    let c: i32 = 0;
    while (c < 200) {
        let junk: i32[] = [c, c];
        c = c + 1;
    }
    let got: i32 = 0;
    match (o) { Some(it) => { got = it.tags[1]; }, None => { got = 0; } }
    return (got - 8) + __rc_underflow_count();
}
