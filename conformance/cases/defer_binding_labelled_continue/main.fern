import "core/int";



function main(): i32 {
    let seen: i32 = 0;
    let i: i32 = 0;
    outer: while (i < 3) {
        i = i + 1;
        loop {
            let items: i32[] = [0];
            defer seen = seen * 3 + items[0];
            items = [i];
            continue outer;
        }
    }
    return seen;
}
