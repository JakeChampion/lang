








import "core/int";
import "std/string";
function consume(s: string): i32 { return s.len(); }
function build(a: string): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 3) { acc = acc + consume(a + "cd"); i = i + 1; }
    return acc;
}
function main(): i32 { return (build("ab") - 12) + __rc_underflow_count(); }
