

function main(): i32 {
    let sum: i32 = 0;


    outer: for i in 0..4 {
        for j in 0..4 {
            if (j == 2) { continue outer; }
            sum = sum + 1;
        }
        sum = sum + 100;
    }


    let k: i32 = 0;
    scan: for a in 0..10 {
        while (true) {
            k = k + 1;
            if (k == 5) { break scan; }
        }
    }
    sum = sum + k;


    let c: i32 = 0;
    counter: loop {
        c = c + 1;
        for x in 0..3 {
            if (c == 2 && x == 1) { continue counter; }
            if (x == 2 && c >= 4) { break counter; }
        }
    }
    sum = sum + c;

    return sum;
}
