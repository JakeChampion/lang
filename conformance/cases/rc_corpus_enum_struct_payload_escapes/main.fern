








import "core/int";
import "std/array";
import "std/string";
struct Item { tags: i32[] }
enum Node { Leaf(Item), Branch(i32) }
function main(): i32 {
    let keep: Node[] = [];
    keep = keep.append(Leaf(Item { tags: [5, 6] }));
    let c: i32 = 0;
    while (c < 200) {
        let junk: i32[] = [c, c];
        c = c + 1;
    }
    let got: i32 = 0;
    match (keep[0]) { Leaf(it) => { got = it.tags[1]; }, Branch(b) => { got = b; } }
    return (got - 6) + (keep.len() - 1) + __rc_underflow_count();
}
