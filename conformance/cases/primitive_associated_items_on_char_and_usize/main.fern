// usize and char take associated functions and constants like the other primitives,
// directly and through a type parameter.
import "std/i32";

trait Fresh {
  const FIRST: Self;
  function fresh(): Self;
}

impl Fresh for usize {
  const FIRST: usize = 1 as usize;
  function fresh(): usize {
    return 42 as usize;
  }
}

impl Fresh for char {
  const FIRST: char = 'a';
  function fresh(): char {
    return 'b';
  }
}

function like[T: Fresh](witness: T): T {
  return T.fresh();
}

function main(): i32 {
  let n: usize = usize.fresh() + usize.FIRST + like(7 as usize);
  let c: char = char.fresh();
  let d: char = char.FIRST;
  let e: char = like('z');
  print((n as i32).to_string());
  print((c as i32).to_string());
  print((d as i32).to_string());
  print((e as i32).to_string());
  return 0;
}
