function guarded(x: i32, flag: boolean): string {
  match (x) {
    1 | 2 when flag => {
      return "low-flag";
    },
    2 | 3 => {
      return "two-three";
    },
    4 | 5 | 6 when x != 5 => {
      return f"at {x}";
    },
    7..=9 | 20..30 => {
      return "ranges";
    },
    _ => {
      return "other";
    },
  }
}

function counted(x: i32): i32 {
  let n = 0;
  match (x * 2) {
    2 | 4 | 6 => {
      n = n + 1;
      n = n + 10;
    },
    8 => {
      n = 100;
    },
    _ => {}
  }
  return n;
}

function named(s: string): i32 {
  return match (s) {
    "a" | "b" => 1,
    "c" => 2,
    "d" | "e" | "f" => 3,
    _ => 0,
  };
}

function letter(c: char): i32 {
  match (c) {
    'x' | 'y' | 'z' => {
      return 1;
    },
    _ => {
      return 0;
    },
  }
}

function truth(b: boolean): i32 {
  let n = 0;
  match (b) {
    true | false => {
      n = n + 1;
      n = n + 10;
    },
  }
  return n;
}

function split(b: boolean): i32 {
  return match (b) {
    true => 1,
    false | true => 2,
  };
}

function main(): i32 {
  for x in 0..32 {
    print(f"{x} {guarded(x, true)} {guarded(x, false)} {counted(x)}");
  }
  for s in ["a", "b", "c", "d", "e", "f", "g"] {
    print(f"{s} {named(s)}");
  }
  print(f"{letter('x')} {letter('z')} {letter('w')}");
  print(f"{truth(true)} {truth(false)} {split(true)} {split(false)}");
  return 0;
}
