






import "core/int";
import "core/map";
struct Item { xs: i32[] }
function mk(n: i32): Item {
    let m: Map[i32, Item] = map_new(4);
    m = m.insert(0, Item { xs: [n, n + 1] });
    return m.get_or(0, Item { xs: [0] });
}
function main(): i32 {
    let got: i32 = 0;
    let c: i32 = 0;
    while (c < 200) {
        let it: Item = mk(c);
        got = got + it.xs[1];
        c = c + 1;
    }
    return (got - 20100) + __rc_underflow_count();
}
