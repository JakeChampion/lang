// spec: AB-08
// A view's bound is its own length, not its storage's. Index 2 of a
// two-element view aborts even though the backing array holds four.

import "std/i32";

function at(v: [i32], i: i32): i32 {
    return v[i];
}

function main(): i32 {
    let xs: i32[] = [1, 2, 3, 4];
    let v: [i32] = xs[1:3];
    print(at(v, 1).to_string());
    print(at(v, 2).to_string());
    return 0;
}
