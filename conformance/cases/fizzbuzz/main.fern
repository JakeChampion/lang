import "std/i32";


function main(): i32 {
    let i: i32 = 1;
    while (i <= 15) {
        if (i % 15 == 0) {
            print("FizzBuzz");
        } else if (i % 3 == 0) {
            print("Fizz");
        } else if (i % 5 == 0) {
            print("Buzz");
        } else {
            print(i.to_string());
        }
        i = i + 1;
    }
    return 0;
}
