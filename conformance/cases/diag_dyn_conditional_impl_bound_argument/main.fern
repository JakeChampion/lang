trait Show { function show(self: Self): string; }

impl Show for i32 { function show(self: Self): string { return "int:" + self.to_string(); } }

struct Box[T] { v: T }

impl[T: Show] Show for Box[T] { function show(self: Self): string { return "Box(" + self.v.show() + ")"; } }

function take(d: dyn Show): string { return d.show(); }

function main(): i32 {
    print(take(Box { v: "str" }));
    return 0;
}
