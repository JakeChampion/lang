









import "core/int";
import "std/string";
enum Wrap { Arr(i32[]), Empty }
function mk(n: i32): Wrap {
    let arr: i32[] = [n, n + 1, n + 2, n + 3];
    return Arr(arr);
}
function main(): i32 {
    let w: Wrap = mk(1000);
    let c: i32 = 0;
    while (c < 300) {
        let junk: i32[] = [c, c, c, c];
        c = c + 1;
    }
    let got: i32 = 0;
    match (w) {
        Arr(a) => { got = (a.len() - 4) + (a[0] - 1000) + (a[3] - 1003); },
        Empty => { got = 100; }
    }
    return got + __rc_underflow_count();
}
