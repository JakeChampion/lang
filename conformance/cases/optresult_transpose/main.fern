import "std/option";
import "std/result";


function main(): i32 {
    let a: Option[Result[i32, i32]] = Some(Ok(5));
    let b: Option[Result[i32, i32]] = Some(Err(9));
    let c: Option[Result[i32, i32]] = None;
    let r: i32 = 0;
    match (a.transpose()) {
        Ok(inner) => { match (inner) { Some(x) => { r = r + x; }, None => { r = r + 50; } } },
        Err(e) => { r = r + 60; }
    }
    match (b.transpose()) {
        Ok(inner) => { r = r + 70; },
        Err(e) => { r = r + e; }
    }
    match (c.transpose()) {
        Ok(inner) => { match (inner) { Some(x) => { r = r + 80; }, None => { r = r + 100; } } },
        Err(e) => { r = r + 90; }
    }

    let d: Result[Option[i32], i32] = Ok(Some(3));
    match (d.transpose().transpose()) {
        Ok(inner) => { match (inner) { Some(x) => { r = r + x; }, None => {} } },
        Err(e) => {}
    }
    return r;
}
