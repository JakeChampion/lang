// now_ns() — wall-clock nanoseconds since the Unix epoch (the i64
// nanosecond-resolution twin of now_unix_ms). Previously implemented
// only on native wasm; this fixture locks it in on all four native
// backends (interp + x86-64 + arm64 + wasm). Two reads of a
// non-decreasing wall clock satisfy b >= a, so exit 8 proves the
// runtime is present and well-ordered.
function main(): i32 {
    var a: i64 = now_ns();
    var b: i64 = now_ns();
    if (b >= a) { return 8; }
    return 1;
}
