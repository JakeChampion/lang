












import "core/int";
import "std/i32";
import "std/string";
function main(): i32 {
    let s: string = "";
    let f: () => i32 = (): i32 => { return s.len(); };
    let i: i32 = 0;
    while (i < 500) { s = i.to_string() + "-iteration"; i = i + 1; }
    return (f() - 13) + __rc_underflow_count();
}
