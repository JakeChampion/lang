import "std/i32";


function grow_i64(n: i32): i64 {
    let xs: i64[] = [];
    let i: i32 = 0;
    while (i < n) {
        xs = xs.append((i as i64) * 3000000000i64);
        i = i + 1;
    }
    return xs[n - 1] + xs[0];
}
function grow_u64(n: i32): u64 {
    let xs: u64[] = [];
    let i: i32 = 0;
    while (i < n) {
        xs = xs.append((i as u64) << (40 as u64));
        i = i + 1;
    }
    return xs[n - 1] >> (40 as u64);
}
function grow_f64(n: i32): f64 {
    let xs: f64[] = [];
    let i: i32 = 0;
    while (i < n) {
        xs = xs.append((i as f64) * 0.5);
        i = i + 1;
    }
    return xs[n - 1] + xs[1];
}
function main(): i32 {
    print(((grow_i64(100) / 1000000000i64) as i32).to_string());
    print((grow_u64(100) as i32).to_string());
    print(((grow_f64(100) * 2.0) as i32).to_string());
    return 0;
}
