// spec: VT-01
import "./key" as keys;

function cleanup(key: keys.Key): void {
  key.erase();
}

struct Identity { key: keys.Key }

function paired(key: keys.Key): Identity {
  return Identity { key: key };
}

function inspect(own identity: Identity): i32 {
  return identity.key.bytes[0] as i32;
}

function main(): i32 {
  let key = keys.Key { bytes: [7u8, 9u8] };
  let alias = key;
  cleanup(key);
  print(alias.bytes[0]);
  print(key.bytes[1]);
  print(inspect(paired(key)));
  print(alias.bytes.len());
  return 0;
}
