







function mk(seed: i32): i32 {
    let arr: string[] = [];
    let k: i32 = 0;
    while (k < 5) {
        let s: string = "v" + "x";
        arr = arr.append(s);
        k = k + 1;
    }
    return arr[3].len();
}
function main(): i32 {
    let total: i32 = 0;
    let j: i32 = 0;
    while (j < 100) { total = total + mk(j); j = j + 1; }
    return (total - 200) + __rc_underflow_count();
}
