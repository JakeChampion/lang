








enum Res { Ok2(i32), Err2, Third }
enum Nest { Wrap(Res), Bare }
function g(w: Nest): i32 {
  match (w) {
    Wrap(Ok2(n)) => { return n; },
    Wrap(Err2()) => { return 9; },
    _ => { return 1; },
  }
  return 0 - 2;
}
function main(): i32 { return g(Wrap(Ok2(5))) + g(Wrap(Err2)) * 10 + g(Wrap(Third)) * 100; }
