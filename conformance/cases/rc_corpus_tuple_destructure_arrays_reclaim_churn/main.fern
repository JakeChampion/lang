










import "core/int";
function mk(k: i32): i32 {
    let (a, b) = ([k, k + 1], [k + 2, k + 3, k + 4]);
    return a[1] + b[2];
}
function main(): i32 {
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < 200) { total = total + mk(i); i = i + 1; }
    return (total - 40800) + __rc_underflow_count();
}
