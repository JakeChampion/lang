import "std/io";
import "std/string";


function main(): i32 {
    match (io.read_line(stdin())) {
        Ok(Some(line)) => {
            match (line.trim().parse_int()) {
                Some(n) => { return n * 2; },
                None => { return 254; }
            }
        },
        Ok(None()) => { return 0; },
        Err(_) => { return 253; }
    }
}
