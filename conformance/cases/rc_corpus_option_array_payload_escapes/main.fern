




import "core/int";
function mk(n: i32): Option[i32[]] { return Some([n, n + 1, n + 2]); }
function main(): i32 {
    let o: Option[i32[]] = mk(7);
    let c: i32 = 0;
    while (c < 200) {
        let junk: i32[] = [c, c];
        c = c + 1;
    }
    let got: i32 = 0;
    match (o) { Some(a) => { got = a[2]; }, None => { got = 0; } }
    return (got - 9) + __rc_underflow_count();
}
