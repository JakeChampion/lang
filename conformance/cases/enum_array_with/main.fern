







enum EAW { EAWNum(i32), EAWTxt(string) }

function main(): i32 {
    let xs: EAW[] = [EAWNum(1), EAWTxt("two"), EAWNum(3)];
    xs = xs.with(1, EAWNum(2));
    xs = xs.with(0, EAWTxt("zero"));
    let r: i32 = 0;
    match (xs[1]) {
        EAWNum(n) => { r = 40 + n; },
        EAWTxt(_) => { r = 1; }
    }
    match (xs[0]) {
        EAWTxt(s) => { if (s == "zero") { r = r + 0; } else { r = 1; } },
        EAWNum(_) => { r = 2; }
    }
    return r;
}
