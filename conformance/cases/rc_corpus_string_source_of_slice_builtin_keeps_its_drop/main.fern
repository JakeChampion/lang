




















@noinline
function eat(s: str): i32 { return s.len(); }

function main(): i32 {
    let pad: string = "wxyz";
    let line: string = pad + "0123456789abcdef0123456789";
    let t: i32 = 0;
    let i: i32 = 0;
    while (i < 4) {
        t = t + eat(slice_unchecked(line, 4, 8));
        i = i + 1;
    }
    return (t - 16) + __rc_underflow_count();
}
