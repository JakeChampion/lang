// spec: AB-11
// A guard on i proves nothing about i - 1. With i at zero the guard holds
// and the read at -1 aborts.

import "std/i32";

@noinline
function below(xs: i32[], i: i32): i32 {
    if (i < xs.len()) {
        return xs[i - 1];
    }
    return -1;
}

function main(): i32 {
    let xs: i32[] = [10, 20, 30];
    print(below(xs, 2).to_string());
    print(below(xs, 0).to_string());
    return 0;
}
