import "std/i32";











struct Point { x: i32, y: i32 }

function (p: Point) manhattan(): i32 { return p.x + p.y; }

enum Shape { Circle(i32), Square(i32), Unit }

function area3(s: Shape): i32 {
    match (s) {
        Circle(r) => { return r * r * 3; },
        Square(a) => { return a * a; },
        Unit => { return 1; }
    }
}

function swap2(a: i32, b: i32): (i32, i32) { return (b, a); }

function main(): i32 {

    let p: Point = Point { x: 7, y: 3 };
    if (p.x != 7 || p.y != 3) { print("FAIL struct-lit"); return 11; }
    if (p.manhattan() != 10) { print("FAIL method"); return 12; }



    let p2: Point = Point { ...p, x: 40 };
    let p3: Point = Point { ...p2, y: 8 };
    if (p3.x != 40 || p3.y != 8 || p.x != 7) { print("FAIL struct-update"); return 13; }


    if (area3(Circle(4)) != 48) { print("FAIL enum-circle"); return 14; }
    if (area3(Square(6)) != 36) { print("FAIL enum-square"); return 15; }
    if (area3(Unit) != 1) { print("FAIL enum-unit"); return 16; }


    let s: Shape = Square(5);
    let m: i32 = match (s) {
        Circle(r) => r + 1,
        Square(a) => a + 2,
        Unit => 0
    };
    if (m != 7) { print("FAIL match-expr"); return 17; }


    let t: (i32, i32) = (7, 3);
    if (t.0 != 7 || t.1 != 3) { print("FAIL tuple-index"); return 18; }
    let (a, b) = swap2(3, 7);
    if (a != 7 || b != 3) { print("FAIL tuple-destr"); return 19; }


    let some: Option[i32] = Some(42);
    let none: Option[i32] = None;
    let sv: i32 = match (some) { Some(v) => v, None => 0 };
    let nv: i32 = match (none) { Some(v) => v, None => 99 };
    if (sv != 42 || nv != 99) { print("FAIL option"); return 20; }


    let ok: Result[i32, i32] = Ok(5);
    let err: Result[i32, i32] = Err(9);
    let ov: i32 = match (ok) { Ok(v) => v, Err(e) => 0 - e };
    let ev: i32 = match (err) { Ok(v) => v, Err(e) => e };
    if (ov != 5 || ev != 9) { print("FAIL result"); return 21; }

    print("OK");
    return 0;
}
