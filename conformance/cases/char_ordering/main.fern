@noinline
function compare(a: char, b: char): i32 {
  let bits: i32 = 0;
  if (a < b) { bits = bits + 1; }
  if (a <= b) { bits = bits + 2; }
  if (a > b) { bits = bits + 4; }
  if (a >= b) { bits = bits + 8; }
  return bits;
}

function main(): i32 {
  let chars: char[] = ['\0', 'a', 'z', '\u{D7FF}', '\u{E000}', '\u{FFFF}', '\u{10000}', '\u{10FFFF}'];
  for i in 0..chars.len() {
    for j in 0..chars.len() {
      let expected: i32 = 10;
      if (i < j) { expected = 3; }
      if (i > j) { expected = 12; }
      if (compare(chars[i], chars[j]) != expected) { return 1; }
    }
  }
  print("char ordering ok");
  return 0;
}
