



import "core/cmp";
import "core/map";
import "std/i32";


struct K { a: i32, junk: i32 }
impl cmp.Eq for K { function eq(self: Self, o: Self): boolean { return self.a == o.a; } }
impl cmp.Hash for K { function hash(self: Self): i32 { return self.a; } }


enum Shape { Circle(i32), Square(i32), Dot }
impl cmp.Eq for Shape { function eq(self: Self, o: Self): boolean { return self.size() == o.size(); } }
impl cmp.Hash for Shape { function hash(self: Self): i32 { return self.size(); } }
function (sh: Shape) size(): i32 {
  match (sh) {
    Circle(r) => { return r; },
    Square(s) => { return s; },
    Dot => { return 0; },
  }
}


@derive(cmp.Hash)
struct Mixed { a: i32, junk: i32 }
impl cmp.Eq for Mixed { function eq(self: Self, o: Self): boolean { return self.a == o.a; } }



@derive(cmp.Eq, cmp.Hash)
struct Outer { k: K, tag: i32 }

function yes(b: boolean): string {
  if (b) {
    return "yes";
  }
  return "no";
}

function main(): i32 {
  let m: Map[K, i32] = map_new(8);
  m = m.insert(K { a: 1, junk: 1 }, 10);
  m = m.insert(K { a: 1, junk: 2 }, 20);
  m = m.insert(K { a: 2, junk: 3 }, 30);
  print("K len " + m.len().to_string());
  print("K get_or " + m.get_or(K { a: 1, junk: 99 }, -1).to_string());
  print("K has " + yes(m.contains(K { a: 2, junk: 0 })));
  match (m.get(K { a: 3, junk: 1 })) {
    Some(v) => { print("K get " + v.to_string()); },
    None => { print("K get none"); },
  }
  let removed: boolean = m.contains(K { a: 2, junk: 77 });
  let m2 = m.remove(K { a: 2, junk: 77 });
  print("K without " + yes(removed) + " " + m2.len().to_string());

  let s: Map[Shape, i32] = map_new(8);
  s = s.insert(Circle(3), 1);
  s = s.insert(Square(3), 2);
  s = s.insert(Dot, 3);
  print("Shape len " + s.len().to_string());
  print("Shape get_or " + s.get_or(Circle(3), -1).to_string());
  print("Shape dot " + s.get_or(Square(0), -1).to_string());

  let x: Map[Mixed, i32] = map_new(8);
  x = x.insert(Mixed { a: 5, junk: 1 }, 50);
  x = x.insert(Mixed { a: 5, junk: 1 }, 55);
  x = x.insert(Mixed { a: 6, junk: 1 }, 60);
  print("Mixed len " + x.len().to_string());
  print("Mixed get_or " + x.get_or(Mixed { a: 5, junk: 1 }, -1).to_string());

  let o: Map[Outer, i32] = map_new(8);
  o = o.insert(Outer { k: K { a: 7, junk: 1 }, tag: 1 }, 70);
  o = o.insert(Outer { k: K { a: 7, junk: 2 }, tag: 1 }, 71);
  o = o.insert(Outer { k: K { a: 7, junk: 2 }, tag: 2 }, 72);
  print("Outer len " + o.len().to_string());
  print("Outer get_or " + o.get_or(Outer { k: K { a: 7, junk: 9 }, tag: 1 }, -1).to_string());
  return 0;
}
