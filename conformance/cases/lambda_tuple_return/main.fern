



function bump(n: i32): (string, i32) {
    return ("ab", n + 1);
}

function main(): i32 {
    let pair = (n: i32): (string, i32) => { return ("ab", n + 1); };
    let t = pair(6);


    let pair2 = (n: i32): (string, i32) => bump(n);
    let u = pair2(9);

    let mk = (): ((i32) => i32) => { return (x: i32): i32 => x * 2; };
    let f = mk();

    let mk2 = (): (i32) => i32 => { return (x: i32): i32 => x + 3; };
    if (t.0.len() == 2 && t.1 == 7 && u.1 == 10 && f(4) == 8 && mk2()(4) == 7) { return 0; }
    return 1;
}
