// spec: AL-01


























import "std/i32";
import "std/i64";
import "std/string";

struct Box { name: string, k: i32 }
struct Pair { a: i32, b: i32 }



function wide(n: i32): string { return "a-string-well-past-the-inline-threshold-" + n.to_string(); }

function (b: Box) rename(n: i32): Box { return Box { name: wide(n), k: b.k + n }; }




function (p: Pair) shift(n: i32): Pair { return Pair { a: p.a + n, b: p.b }; }

function round(n: i32): i32 {
    let seed: Box = Box { name: wide(n), k: n };
    let pair: Pair = Pair { a: n, b: 1 };


    let field: string = seed.rename(n).name;
    let acc: i32 = field.len() + seed.rename(n).name.len();
    acc = acc + pair.shift(n).a;
    return acc + seed.name.len() + pair.b;
}

function rounds(n: i32): i32 {
    let acc: i32 = 0;
    for i in 0..n {
        acc = acc + round(i);
    }
    return acc;
}

function main(): i32 {
    let b0: i64 = __heap_bump_bytes();
    let x: i32 = rounds(50);
    let b1: i64 = __heap_bump_bytes();
    let y: i32 = rounds(100);
    let b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());

    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
