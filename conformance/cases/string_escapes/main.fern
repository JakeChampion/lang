import "core/int";





function main(): i32 {


    print("tab[\t]end");
    print("bs[\\]end");
    print("dq[\"]end");
    print("hex[\x41\x7a]");


    if ("a\tb\nc".len() != 5) { return 11; }
    if ("x\\y\"z".len() != 5) { return 12; }
    if (("\x41")[0] as i32 != 65) { return 13; }
    if ("\r\0".len() != 2) { return 14; }
    if ("a\nb"[1] as i32 != 10) { return 15; }
    if ("\t".len() != 1) { return 16; }
    if ("\x00".len() != 1) { return 17; }
    if ("\x7a".len() != 1) { return 18; }
    return 0;
}
