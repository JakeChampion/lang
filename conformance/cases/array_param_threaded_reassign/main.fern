// An array PARAMETER the body reassigns (`acc = f(acc)`, `acc = acc.append(v)`)
// alternates between the caller's buffer and one this frame produced: the
// first rebind replaces the caller's borrow, every later one supersedes a
// buffer of ours. The self-host lowering released neither — a parameter's old
// value was "the caller's" at every rebind — so a threaded accumulator leaked
// one buffer per grow, at every level of the walker chain, which is what
// OOM-killed the self-built compiler compiling itself (#6644). Native tracks
// which of the two the slot holds in a runtime ownership flag; this pins the
// same protocol on the self-host. Every result is read back by bytes after the
// heap has been churned, so an early release shows up as a wrong answer, not
// only as a leak count. Elements are literals and every seed is a local, so
// the leak census sees this shape alone.
import "std/i32";

// the accumulator leaf: a borrowed param appended in return position
function visit(name: string, acc: string[]): string[] {
  return acc.append(name);
}

// the threading frame: a param rebound from a call, once per element
function fold(names: string[], acc: string[]): string[] {
  for n in names { acc = visit(n, acc); }
  return acc;
}

// a param rebound by its own self-append
function fill(out: string[], n: i32): string[] {
  var i: i32 = 0;
  while (i < n) { out = out.append("fill"); i = i + 1; }
  return out;
}

// an i32[] param rebound the same way
function fill_ints(out: i32[], n: i32): i32[] {
  var i: i32 = 0;
  while (i < n) { out = out.append(i * 3); i = i + 1; }
  return out;
}

// early return of the param BEFORE any rebind (still the caller's buffer)
// and AFTER one (a buffer this frame owns)
function maybe_grow(acc: string[], go: boolean, twice: boolean): string[] {
  if (!go) { return acc; }
  acc = acc.append("g1");
  if (!twice) { return acc; }
  acc = fill(acc, 6);
  return acc;
}

// the param is rebound and NOT returned: the frame's last buffer is released
// at exit, the caller's original is not
function count_grown(acc: string[]): i32 {
  acc = acc.append("c1");
  acc = fill(acc, 9);
  var n: i32 = acc.len();
  return n;
}

// the param rebound to an alias of another array, then grown
function swap_in(acc: string[], other: string[]): string[] {
  acc = other;
  acc = acc.append("swapped");
  return acc;
}

function churn(): i32 {
  var junk: string[] = [];
  var i: i32 = 0;
  while (i < 400) { junk = junk.append("junk" + i.to_string()); i = i + 1; }
  return junk.len();
}

function sum_bytes(xs: string[]): i32 {
  var t: i32 = 0;
  for s in xs {
    var i: i32 = 0;
    while (i < s.len()) { t = t + (s[i] as i32); i = i + 1; }
  }
  return t;
}

function main(): i32 {
  var names: string[] = [];
  var i: i32 = 0;
  while (i < 37) { names = names.append("name"); i = i + 1; }

  var total: i32 = 0;
  var round: i32 = 0;
  while (round < 20) {
    var seed: string[] = [];
    var folded: string[] = fold(names, seed);
    var seed2: string[] = [];
    var filled: string[] = fill(seed2, 21);
    var iseed: i32[] = [];
    var ints: i32[] = fill_ints(iseed, 40);
    var a1: string[] = ["a"];
    var g0: string[] = maybe_grow(a1, false, false);
    var a2: string[] = ["a", "b"];
    var g1: string[] = maybe_grow(a2, true, false);
    var a3: string[] = ["a", "b", "c"];
    var g2: string[] = maybe_grow(a3, true, true);
    var base: string[] = ["k0", "k1"];
    var swapped: string[] = swap_in(seed, base);
    var counted: i32 = count_grown(base);
    churn();
    total = total + sum_bytes(folded) + folded.len() + sum_bytes(filled) + sum_bytes(g0) + sum_bytes(g1) + sum_bytes(g2) + sum_bytes(swapped) + sum_bytes(base) + counted + seed.len() + a1.len() + a2.len() + a3.len();
    var k: i32 = 0;
    while (k < ints.len()) { total = total + ints[k]; k = k + 1; }
    round = round + 1;
  }
  return total % 64;
}
