import "core/map";
import "core/iter";

function main(): i32 {
  let m: Map[string, i32] = map_new(4);
  m = m.insert("a", 10);
  m = m.insert("b", 20);
  m = m.insert("c", 30);
  let it: iter.ArrayIter[(string, i32)] = m.iter();
  let sum: i32 = 0;
  for (__mapkey_it, __mapvalue_it) in it {
    sum = sum + __mapvalue_it;
  }
  return sum;
}
