import "core/map";
function main(): i32 {
    let m: Map[string, i32] = map_new(4);
    m = m.insert("a", 10);
    m = m.insert("b", 20);
    m = m.insert("c", 30);
    let it: MapIter[string, i32] = m.iter();
    let sum: i32 = 0;
    while (it.has_next()) {
        sum = sum + it.value();
        it.advance();
    }
    return sum;
}
