
















import "core/int";
import "std/i32";
struct P { a: i32, b: i32 }
struct Box { items: P[], tag: i32 }
@noinline function pick(b: Box): Box { return b; }
function main(): i32 {
    let t: i32 = 0;
    let r: i32 = 0;
    while (r < 20) {
        let bx: Box = Box { items: [P { a: 1, b: 2 }, P { a: 3, b: 4 }], tag: 5 };
        let a: P[] = pick(bx).items;
        let c: P[] = pick(bx).items;
        t = t + a[0].a + c[1].b + bx.items[1].a + bx.tag;
        r = r + 1;
    }
    return (t - 260) + __rc_underflow_count();
}
