
















function g(v: i32): Option[i32] {
    if (v < 100) { return Some(v + 1); }
    return None;
}

function build(out: Cell[i32]): Option[i32] {
    let n: i32 = 0;
    defer n = g(n)?;
    out.set(n);
    return Some(n);
}

function main(): i32 {
    let c: Cell[i32] = cell_new(0);
    build(c);
    return c.get();
}
