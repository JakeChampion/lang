




function main(): i32 {
  match (read_file("/dev/null/x")) {
    Ok(_) => { print("read through a device"); return 1; },
    Err(e) => {
      match (e) {
        Other(p, m, n) => {
          if (n != 20) { print("errno is not ENOTDIR"); return 3; }
          print(p + ": " + m);
          return 0;
        },
        _ => { print("wrong variant"); return 2; }
      }
    }
  }
}
