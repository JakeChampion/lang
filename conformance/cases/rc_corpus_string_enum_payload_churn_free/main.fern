









enum Msg { Text(string), Code(i32) }
function mk(seed: i32): i32 {
    let m: Msg = Text("hello" + "world");
    let out: string = "";
    match (m) { Text(t) => { out = t; }, Code(c) => { out = "z"; } }
    return out.len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 200) { total = total + mk(k); k = k + 1; }
    return (total - 2000) + __rc_underflow_count();
}
