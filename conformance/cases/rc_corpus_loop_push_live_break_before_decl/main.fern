





import "core/int";
struct Val { kind: i32, kids: i32[] }
function build(n: i32): i32 {
    let vals: Val[] = [];
    let i: i32 = 0;
    while (i < n) {
        if (i == 3) { break; }
        let v: Val = Val { kind: i, kids: [i] };
        vals = vals.append(v);
        i = i + 1;
    }
    let sum: i32 = 0;
    let k: i32 = 0;
    while (k < vals.len()) { sum = sum + vals[k].kids[0]; k = k + 1; }
    return vals.len() + sum;
}
function main(): i32 { return (build(9) - 6) + __rc_underflow_count(); }
