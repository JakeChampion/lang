import "core/map";





















function main(): i32 {
    let vm: Map[i32, boolean] = map_new(2);
    vm = vm.insert(0, true);
    vm = vm.insert(1, false);
    vm = vm.insert(2, true);
    vm = vm.insert(3, false);
    let vs: boolean[] = vm.values();
    if (vs.len() != 4) { return 1; }
    if (!vs[0]) { return 2; }
    if (vs[1]) { return 3; }
    if (!vs[2]) { return 4; }
    if (vs[3]) { return 5; }

    let vtrue: i32 = 0;
    for v in vs { if (v) { vtrue = vtrue + 1; } }
    if (vtrue != 2) { return 6; }



    let big: Map[i32, boolean] = map_new(2);
    let i: i32 = 0;
    while (i < 9) { big = big.insert(i, (i % 3) == 0); i = i + 1; }
    let bs: boolean[] = big.values();
    if (bs.len() != 9) { return 7; }
    if (!bs[6]) { return 8; }
    if (bs[7]) { return 9; }

    return 42;
}
