// General FBIP reuse token — CROSS-TYPE box-class reuse (Phase 5e-iii): a dead
// Holder (id, items) is reused for a Bag (tag, data) of the SAME freelist class
// but a DIFFERENT struct type. D's old array is freed at D's offset, C's stored
// at C's offset. Differentially pinned reuse-off == reuse-on, free-off == free-on.
struct Holder { id: i32, items: i32[] }
struct Bag { tag: i32, data: i32[] }

function churn(n: i32): i32 {
    var acc: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        var a: Holder = Holder { id: i, items: [i, i + 1] };
        var s: i32 = a.id + a.items[0] + a.items[1];   // a's last use
        var b: Bag = Bag { tag: s, data: [i + 2, i + 3] };   // reuses a's box (same class)
        acc = acc + b.tag + b.data[0] + b.data[1];
        i = i + 1;
    }
    return acc;
}

function main(): i32 {
    if (churn(200) != 100700) { return 99; }
    return 0;
}
