











@noinline
function mk(p: string): string[] { return [p + "seed"]; }

function main(): i32 {
    let pad: string = "wide-payload-";
    let t: i32 = 0;
    let i: i32 = 0;
    while (i < 8) {
        let x: i32[] = [];
        let k: i32 = 0;
        while (k < 6) { x = x.append(k).append(k + 1); k = k + 1; }
        let a: i32[] = [7].append(i);
        let b: string[] = mk(pad).append(pad + "lit").append(pad + "more");
        if (x[11] != 6) { return 90; }
        if (a[0] != 7) { return 91; }
        if (a[1] != i) { return 92; }
        if (b[2].len() != 17) { return 93; }
        t = t + x.len() + a.len() + b.len();
        i = i + 1;
    }
    return (t - 136) + __rc_underflow_count();
}
