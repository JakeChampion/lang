














import "std/result";
import "core/int";

enum Box[T, E] { Full(T), Blank(E) }

function (b: Box[T, E]) pair[U](other: Box[U, E]): Box[U, E] { return other; }

function take(b: Box[i32, string]): i32 {
    match (b) {
        Full(n) => { return n; },
        Blank(s) => { return s.len(); }
    }
}

function main(): i32 {
    let b: Box[i32, string] = Full(5);
    let inferred: i32 = take(b.pair(Full(9)));
    let advised: i32 = take(b.pair[i32](Full(7)));
    let spelled: i32 = take(b.pair[i32, string, i32](Full(4)));
    let r: Result[i32, string] = Ok(5);
    let combinator: i32 = r.and(Ok(3)).unwrap_or(0);
    return inferred + advised + spelled + combinator;
}
