





function count_where[T](xs: T[], pred: (T) => boolean): i32 { let c: i32 = 0; let i: i32 = 0; while (i < xs.len()) { if (pred(xs[i])) { c = c + 1; } i = i + 1; } return c; }
function sum_by[T](xs: T[], key: (T) => i32): i32 { let t: i32 = 0; let i: i32 = 0; while (i < xs.len()) { t = t + key(xs[i]); i = i + 1; } return t; }
function is_even(x: i32): boolean { return x % 2 == 0; }
function idn(x: i32): i32 { return x; }
function main(): i32 { let e: i32[] = []; return count_where(e, is_even) + 2 + sum_by(e, idn) + 3; }
