import "std/i32";

















function push_pair(own acc: i32[], v: i32): i32[] {
    acc = acc.append(v);
    acc = acc.append(v * 2);
    return acc;
}

function walk_inner(own acc: i32[], n: i32): i32[] {
    if (n <= 0) { return acc; }
    acc = push_pair(acc, n);
    return walk_inner(acc, n - 1);
}

function walk(own acc: i32[], rounds: i32): i32[] {
    let i: i32 = 0;
    while (i < rounds) {
        acc = walk_inner(acc, 4);
        i = i + 1;
    }
    return acc;
}

function main(): i32 {
    let out: i32[] = walk([], 50);
    if (out.len() != 400) { return 91; }

    let expect: i32[] = [4, 8, 3, 6, 2, 4, 1, 2];
    let bad: i32 = 0;
    let r: i32 = 0;
    while (r < 50) {
        let k: i32 = 0;
        while (k < 8) {
            if (out[r * 8 + k] != expect[k]) { bad = bad + 1; }
            k = k + 1;
        }
        r = r + 1;
    }
    if (bad != 0) { return 92; }
    return 0;
}
