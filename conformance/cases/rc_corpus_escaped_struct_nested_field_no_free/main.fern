












import "core/int";
import "std/array";
import "std/string";
struct Inner { vals: i32[] }
struct Outer { inner: Inner }
function main(): i32 {
    let shared: Inner = Inner { vals: [1, 2, 3] };
    let keep: Outer[] = [];
    let o: Outer = Outer { inner: shared };
    keep = keep.append(o);
    let c: i32 = 0;
    while (c < 200) {
        let junk: i32[] = [c, c, c];
        c = c + 1;
    }
    return (keep[0].inner.vals[1] - 2) + (keep.len() - 1) + __rc_underflow_count();
}
