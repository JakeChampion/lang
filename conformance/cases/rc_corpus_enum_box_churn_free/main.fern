







import "core/int";
enum Wrap { A(i32[]), B(i32[]) }
function mk(seed: i32): i32 {
    let w: Wrap = A([seed, seed + 1, seed + 2]);
    let got: i32 = 0;
    match (w) {
        A(xs) => { got = xs[2]; },
        B(xs) => { got = xs[0]; }
    }
    return got;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 200) { total = total + mk(k); k = k + 1; }
    return (total - 20300) + __rc_underflow_count();
}
