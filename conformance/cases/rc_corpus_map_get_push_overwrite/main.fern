







import "core/int";
import "core/map";
import "std/array";
import "std/string";
function main(): i32 {
    let m: Map[i32, i32[]] = map_new(4);
    m = m.insert(1, [10]);
    match (m.get(1)) {
        Some(cur) => { m = m.insert(1, cur.append(20)); },
        None => {}
    }
    let v: i32[] = m.get_or(1, []);
    return (v.len() - 2) + (v[1] - 20) + __rc_underflow_count();
}
