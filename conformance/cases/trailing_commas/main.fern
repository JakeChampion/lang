









struct Point {
    x: i32,
    y: i32,
}

enum Shape {
    Dot,
    Seg(i32, i32),
}

function add3(a: i32, b: i32, c: i32,): i32 {
    return a + b + c;
}

function pick[T,](xs: T[], i: i32): T {
    return xs[i];
}

function span(s: Shape): i32 {
    match (s) {
        Dot => { return 0; },
        Seg(a, b) => { return b - a; },
    }
}

function main(): i32 {

    let xs: i32[] = [1, 2, 3,];
    let grid: i32[][] = [[1, 2,], [3, 4,],];


    let p: Point = Point { x: 10, y: 4, };


    let t: (i32, i32) = (5, 6,);


    let sum: i32 = add3(xs[0], xs[1], xs[2],);
    let first: i32 = pick[i32,](xs, 0,);
    let seg: Shape = Seg(2, 9,);


    let twice: (i32) => i32 = (n: i32,) => n * 2;


    return sum + grid[1][1] + (p.x - p.y) + first + t.0 + t.1
        + span(seg) + twice(2);
}
