


import "std/option";
import "std/result";

enum Reply { Ok, Busy }

function code(r: Reply): i32 {
    match (r) {
        Reply.Ok => { return 1; },
        Reply.Busy => { return 2; },
    }
}

function main(): i32 {
    let o: Option[i32] = Some(41);
    return o.ok_or("no").unwrap_or(0) + code(Reply.Ok);
}
