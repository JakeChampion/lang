





import "std/regex";

function main(): i32 {
  let r: i32 = 0;

  let all: regex.RCaps[] = regex.regex_captures_all("(\\w+)@(\\w+)", "a@b c@d");
  if (all.len() == 2 && require_regex_text(all[0].group(1)) == "a" && require_regex_text(all[1].group(2)) == "d") {
    r = r + 1;
  }

  let nc: regex.RCaps = require_caps(regex.regex_captures("(?:ab)+(c)", "ababc"));
  if (nc.group_count() == 1 && require_regex_text(nc.group(0)) == "ababc" && require_regex_text(nc.group(1)) == "c") {
    r = r + 2;
  }

  let ci: regex.RCaps = require_caps(regex.regex_captures("(?i)(HEL+O)", "say hello"));
  if (require_regex_text(ci.group(1)) == "hello") {
    r = r + 4;
  }

  match (regex.regex_captures("(x)(y)", "abc")) {
    Some(_) => {},
    None => {
      r = r + 8;
    }
  }



  let z: regex.RCaps = require_caps(regex.regex_captures("(a*)", "bbb"));
  if (z.has_group(1) && at(z.group_start(1), 0) && at(z.group_end(1), 0)) {
    r = r + 16;
  }


  let nul: regex.RCaps = require_caps(regex.regex_captures("(a?)*b", "aaab"));
  if (require_regex_text(nul.group(0)) == "aaab") {
    r = r + 32;
  }


  let cr: regex.RCaps = require_caps(regex.regex_captures("(ab){2}", "abab"));
  if (require_regex_text(cr.group(0)) == "abab" && require_regex_text(cr.group(1)) == "ab") {
    r = r + 64;
  }



  let caps: regex.RCaps = require_caps(regex.regex_captures("(a|ab)", "xab"));
  let span: regex.RMatch = require_match(regex.regex_search("(a|ab)", "xab"));
  if (at(caps.group_start(0), span.start) && at(caps.group_end(0), span.end) && require_regex_text(caps.group(1)) == "ab") {
    r = r + 128;
  }

  return r;
}


function require_caps(result: Option[regex.RCaps]): regex.RCaps {
  if let Some(c) = result {
    return c;
  }
  exit(1);
  return regex.RCaps { text: "", starts: [], ends: [], names: [] };
}

function require_match(result: Option[regex.RMatch]): regex.RMatch {
  if let Some(m) = result {
    return m;
  }
  exit(1);
  return regex.RMatch { start: 0, end: 0 };
}

function at(o: Option[i32], want: i32): boolean {
  if let Some(v) = o {
    return v == want;
  }
  return false;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
