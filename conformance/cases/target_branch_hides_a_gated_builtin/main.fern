


function boot_word(): i32 {
    if (target_os() == "darwin") {
        match (sysctl([1, 1])) {
            Ok(bs) => { return bs.len(); },
            Err(_) => { return 0; }
        }
    }
    return 0;
}

function main(): i32 {
    if (boot_word() >= 0) {
        print("built");
    }
    return 0;
}
