// `if let` reads the shared pattern grammar (#5356): every pattern form a
// `match` accepts works in its head.
//
// A literal tuple element is refutable, so the else branch is live.
function main(): i32 {
  let t: (i32, i32) = (3, 4);
  if let (9, b) = t { return b; } else { return 7; }
  return 99;
}
