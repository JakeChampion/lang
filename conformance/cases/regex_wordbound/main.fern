



import "std/regex";

function main(): i32 {
  let r: i32 = 0;
  if (regex.regex_match("\\bcat\\b", "the cat sat")) {
    r = r + 1;
  }
  if (!regex.regex_match("\\bcat\\b", "scatter")) {
    r = r + 2;
  }
  if let Some(2) = regex.regex_find("\\bcat\\b", "a cat") {
    r = r + 4;
  }
  if (regex.regex_match("\\bword\\b", "word")) {
    r = r + 8;
  }
  if (regex.regex_match("ca\\Bt", "cat")) {
    r = r + 16;
  }
  if (!regex.regex_match("cat\\B", "cat ")) {
    r = r + 32;
  }

  let ms: regex.RMatch[] = regex.regex_find_all("\\b\\w+\\b", "one two three");
  if (ms.len() == 3) {
    r = r + 64;
  }

  if (require_regex_text(regex.regex_replace_all("\\bcat\\b", "cat cats category", "X")) == "X cats category") {
    r = r + 128;
  }
  return r;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
