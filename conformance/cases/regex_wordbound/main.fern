// std/regex (#2680) word-boundary assertions `\b` / `\B` across the native
// backends: whole-word matching, boundaries at text edges, the non-boundary
// `\B`, and `\b` composing with find / find_all / replace_all. Each check
// sets a bit; all eight hold -> 255.
import "std/regex";

function main(): i32 {
  var r: i32 = 0;
  if (regex.regex_match("\\bcat\\b", "the cat sat")) {  // whole word
    r = r + 1;
  }
  if (!regex.regex_match("\\bcat\\b", "scatter")) {  // inside a word: no
    r = r + 2;
  }
  if (regex.regex_find("\\bcat\\b", "a cat") == 2) {  // boundary position
    r = r + 4;
  }
  if (regex.regex_match("\\bword\\b", "word")) {  // boundaries at edges
    r = r + 8;
  }
  if (regex.regex_match("ca\\Bt", "cat")) {  // \B inside a word
    r = r + 16;
  }
  if (!regex.regex_match("cat\\B", "cat ")) {  // \B is false at a boundary
    r = r + 32;
  }

  var ms: regex.RMatch[] = regex.regex_find_all("\\b\\w+\\b", "one two three");
  if (ms.len() == 3) {  // word tokenisation
    r = r + 64;
  }

  if (require_regex_text(regex.regex_replace_all("\\bcat\\b", "cat cats category", "X")) == "X cats category") {
    r = r + 128;
  }
  return r;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
