




import "std/json";
import "core/cmp";

@derive(json.Json, cmp.Debug, cmp.Eq, cmp.Ord, cmp.Hash)
enum E { U, One(i32), Two(i32, string), Three(i32, string, i32) }

function main(): i32 {

    if (Two(2, "a") == Two(2, "b")) { return 1; }
    if (!(Two(2, "a") == Two(2, "a"))) { return 2; }
    if (Three(1, "a", 5) == Three(1, "a", 9)) { return 3; }


    if (!(Two(2, "a") < Two(2, "b"))) { return 4; }
    if (!(Three(1, "a", 5) < Three(1, "a", 9))) { return 5; }
    if (Two(2, "a") < Two(2, "a")) { return 6; }


    if (Two(2, "a").hash() == Two(2, "b").hash()) { return 7; }



    if (One(7).to_json() != "{\"One\":7}") { return 8; }
    if (Two(2, "hi").to_json() != "{\"Two\":[2,\"hi\"]}") { return 9; }
    if (Three(1, "a", 5).to_json() != "{\"Three\":[1,\"a\",5]}") { return 10; }
    if (U.to_json() != "\"U\"") { return 11; }


    if (One(7).to_debug() != "One(7)") { return 12; }
    if (Two(2, "hi").to_debug() != "Two(2, \"hi\")") { return 13; }
    if (Three(1, "a", 5).to_debug() != "Three(1, \"a\", 5)") { return 14; }
    if (U.to_debug() != "U") { return 15; }

    return 42;
}
