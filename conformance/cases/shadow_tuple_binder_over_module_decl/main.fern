// A match binder in an imported module shadowing a module-level decl keeps
// its bare name. Each probe returns 7 the moment its binder is visible to
// the "what does this arm bind" walk, and fails the checker otherwise, so
// the case says which pattern position regressed rather than only that one
// did.
import "./lib";

function main(): i32 {
    if (lib.tuple_binder() != 7) { return 1; }
    if (lib.variant_binder() != 7) { return 2; }
    if (lib.nested_tuple_binder() != 7) { return 3; }
    if (lib.payload_sub_binder() != 7) { return 4; }
    if (lib.tuple_variant_elem_binder() != 7) { return 5; }
    if (lib.match_expr_binder() != 7) { return 6; }
    if (lib.match_expr_variant_binder() != 7) { return 7; }
    return 0;
}
