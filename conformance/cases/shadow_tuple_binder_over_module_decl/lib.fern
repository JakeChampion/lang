// Every binder here shadows the module-level `helper`, so the import
// rewriter must leave each reference bare. A mangled one resolves to the
// function and the checker reports `operator "+" requires an integer type,
// got () => i32` on a program that is plainly legal.
//
// The entry module is not prefix-mangled, so the rule only has teeth from
// an IMPORTED module — which is why every probe lives here.
function helper(): i32 { return 100; }

enum Box { Wrap(i32), Nil }
enum Inner { Some1(i32), None1 }
enum Outer { Holds(Inner), Empty }

// A tuple pattern's binders ride TupleElems, not Bindings (#8607).
pub function tuple_binder(): i32 {
    var t: (i32, i32) = (3, 4);
    match (t) {
        (helper, b) => { return helper + b; }
    }
}

// Control: an ordinary payload binder of the same name, which the walk
// always saw. A regression that breaks both halves is a different bug from
// one that breaks only the tuple half.
pub function variant_binder(): i32 {
    var b: Box = Wrap(3);
    match (b) {
        Wrap(helper) => { return helper + 4; },
        Nil => { return 0; }
    }
}

// A nested tuple element recurses through TuplePatElem.Nested.
pub function nested_tuple_binder(): i32 {
    var t: (i32, (i32, i32)) = (1, (2, 4));
    match (t) {
        (a, (helper, c)) => { return a + helper + c; }
    }
}

// A payload SUB-PATTERN's binders ride Payloads, which the walk missed too.
pub function payload_sub_binder(): i32 {
    var o: Outer = Holds(Some1(3));
    match (o) {
        Holds(Some1(helper)) => { return helper + 4; },
        Holds(None1()) => { return 0; },
        Empty => { return 0; }
    }
}

// A variant sub-pattern sitting on a tuple ELEMENT.
pub function tuple_variant_elem_binder(): i32 {
    var t: (Box, i32) = (Wrap(3), 4);
    match (t) {
        (Wrap(helper), b) => { return helper + b; },
        _ => { return 0; }
    }
}

// The expression form carries the same pattern fields and was not walked
// at all — even its plain payload binder was invisible here.
pub function match_expr_binder(): i32 {
    var t: (i32, i32) = (3, 4);
    return match (t) {
        (helper, b) => helper + b
    };
}

pub function match_expr_variant_binder(): i32 {
    var b: Box = Wrap(3);
    return match (b) {
        Wrap(helper) => helper + 4,
        Nil => 0
    };
}
