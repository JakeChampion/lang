// Pins E060. The body is the example from that code's entry in the
// diagnostic catalogue (`fern explain E060`), completed into a program
// that compiles apart from the errors it documents — the catalogue's
// snippet names `Shape`, `Circle` and `Square` without declaring them,
// and a `dyn Shape` whose trait does not exist cannot be the reason a
// downcast is refused.
trait Shape { function area(self: Self): i32; }
struct Circle { r: i32 }
impl Shape for Circle { function area(self: Self): i32 { return self.r * self.r * 3; } }
struct Square { side: i32 }

function main(): i32 {
    var s: dyn Shape = Circle { r: 2 };
    var x = s as? Square;        // error[E060]: Square does not implement Shape
    var y = s as? i32;           // error[E060]: target must be a concrete struct/enum
    return 0;
}
