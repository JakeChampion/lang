// spec: RH-27
struct Handle { fd: i32 }

function (own h: Handle) close(): i32 {
  return h.fd;
}

function take(own slot: Cell[Handle]): Handle {
  return slot.get();
}

function lift(borrowed: Handle): Cell[Handle] {
  let slot = cell_new(Handle { fd: 1 });
  let alias = slot;
  alias.set(borrowed);
  return slot;
}

function main(): i32 {
  let h = Handle { fd: 7 };
  let other = take(lift(h));
  return other.close() + h.close();
}
