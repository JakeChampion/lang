





import "core/int";
import "core/map";
import "std/string";
function main(): i32 {
    let m: Map[i32, i32[]] = map_new(4);
    m = m.insert(1, [3, 4]);
    m = m.insert(2, [5, 6, 7]);
    let vs: i32[][] = m.values();
    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < vs.len()) { sum = sum + vs[i].len(); i = i + 1; }
    return (sum - 5) + __rc_underflow_count();
}
