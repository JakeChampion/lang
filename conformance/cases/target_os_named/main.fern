




import "core/int";
import "std/i32";

function main(): i32 {
    let os: string = target_os();
    let named: boolean = os == "linux" || os == "darwin" || os == "android"
        || os == "wasi" || os == "wasi-http";
    if (named) {
        print("named");
    } else {
        print("unnamed: " + os);
    }
    if (target_os() != "freestanding") {
        print("hosted");
    }
    let hosted: i32 = 0;
    if (target_os() == "wasi") {
        hosted = 1;
    } else if (target_os() == "linux" || target_os() == "darwin" || target_os() == "android") {
        hosted = 1;
    }
    print(hosted.to_string());
    return 0;
}
