











struct Op { a: i32, s: string }

@noinline
function mkop(i: i32): Op { return Op { a: i, s: "keep" }; }

@noinline
function keepf(o: Op): Op { return o; }

function main(): i32 {
    let t: i32 = 0;
    let i: i32 = 0;
    while (i < 4) {
        let r: Op = keepf(mkop(i));
        t = t + r.a + r.s.len();
        i = i + 1;
    }
    return (t - 22) + __rc_underflow_count();
}
