






import "core/int";
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let o: Option[i32] = Some(i);
        match (o) { Some(n) => { acc = acc + n; }, None => { acc = acc + 0; } }
        i = i + 1;
    }
    return (acc - 4950) + __rc_underflow_count();
}
