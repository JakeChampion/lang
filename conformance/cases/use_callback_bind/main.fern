// `use NAME <- call(...);` — the callback-flattening bind. The rest of
// the enclosing block becomes the trailing callback argument of the
// call, so `k` receives it and NAME is bound to what `k` is passed.
function with_doubled(n: i32, k: (i32) => i32): i32 { return k(n * 2); }

function main(): i32 {
    use v <- with_doubled(21);
    return v;
}
