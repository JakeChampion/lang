enum Kind { Plain, Fancy }

function note(tag: string): void {
  print(tag);
}

function literal(n: i32, raw: boolean): void {
  match (n) {
    1 => if (raw) { note("raw") } else { note("cooked") },
    _ => note("other"),
  }
  note("after");
}

function variant(k: Kind, raw: boolean): void {
  match (k) {
    Plain => if (raw) { note("plain raw") } else { note("plain cooked") },
    _ => note("fancy"),
  }
  note("after");
}

function chained(n: i32, k: i32): void {
  match (n) {
    1 => if (k == 0) { note("zero") } else if (k == 1) { note("one") } else { note("many") },
    2 => match (k) { 0 => note("m0"), _ => note("m*") },
    _ => note("other"),
  }
  note("after");
}

function counted(n: i32, raw: boolean): i32 {
  match (n) {
    1 => if (raw) { note("raw") } else { note("cooked") },
    _ => note("other"),
  }
  note("after");
  return n;
}

function main(): i32 {
  literal(1, true);
  literal(1, false);
  literal(2, true);
  variant(Plain, true);
  variant(Plain, false);
  variant(Fancy, true);
  chained(1, 0);
  chained(1, 1);
  chained(1, 5);
  chained(2, 0);
  chained(2, 3);
  chained(3, 0);
  if (counted(1, true) + counted(2, false) != 3) {
    return 1;
  }
  return 0;
}
