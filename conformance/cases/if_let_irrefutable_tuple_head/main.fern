// `if let` reads the shared pattern grammar (#5356): every pattern form a
// `match` accepts works in its head.
//
// An irrefutable head leaves the desugar's synthetic else arm unreachable;
// that arm is not the programmer's, so it must not draw E026 / E030.
function main(): i32 { let t: (i32, i32) = (1, 2); if let (a, b) = t { return a + b; } else { return 0; } return 0; }
