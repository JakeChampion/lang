// An integer lane value changes its shape in three ways. `widen_lo` and
// `widen_hi` give one half of the lanes at two times the width. `narrow`
// gives two values at half the width, with each lane held to the limits of
// the narrow lane. `narrow_u` holds a signed lane to the limits of the
// unsigned narrow lane. `swizzle` gives the bytes of a value at the indexes
// of another value, and zero for an index above 15.

function zeros(): u8[] {
  let out: u8[] = [];
  for i in 0..16 {
    out = out.append(0 as u8);
  }
  return out;
}

function text(xs: u8[]): string {
  let out = "";
  for x in xs {
    out = out + " " + x.to_string();
  }
  return out;
}

function ramp(): u8[] {
  let out: u8[] = [];
  for i in 0..16 {
    out = out.append((i * 37 + 120) as u8);
  }
  return out;
}

// Each pixel of `xs` at half of its level, through lanes of 16 bits.
function halve(xs: u8[]): u8[] {
  let v = __u8x16_load(xs, 0);
  let low = __u16x8_shr(__u8x16_widen_lo(v), 1);
  let high = __u16x8_shr(__u8x16_widen_hi(v), 1);
  return __u8x16_with(zeros(), 0, __u16x8_narrow(low, high));
}

function main(): i32 {
  let xs = ramp();
  let u = __u8x16_load(xs, 0);
  let s = __i8x16_load(xs, 0);
  print("bytes" + text(xs));
  print("u8 widen_lo" + text(__u16x8_with(zeros(), 0, __u8x16_widen_lo(u))));
  print("u8 widen_hi" + text(__u16x8_with(zeros(), 0, __u8x16_widen_hi(u))));
  print("i8 widen_lo" + text(__i16x8_with(zeros(), 0, __i8x16_widen_lo(s))));
  print("i8 widen_hi" + text(__i16x8_with(zeros(), 0, __i8x16_widen_hi(s))));
  let uw = __u16x8_load(xs, 0);
  let sw = __i16x8_load(xs, 0);
  print("u16 widen_lo" + text(__u32x4_with(zeros(), 0, __u16x8_widen_lo(uw))));
  print("u16 widen_hi" + text(__u32x4_with(zeros(), 0, __u16x8_widen_hi(uw))));
  print("i16 widen_lo" + text(__i32x4_with(zeros(), 0, __i16x8_widen_lo(sw))));
  print("i16 widen_hi" + text(__i32x4_with(zeros(), 0, __i16x8_widen_hi(sw))));
  let a = __i16x8_of(-300, -129, -128, -1, 0, 127, 128, 255);
  let b = __i16x8_of(256, 300, 32767, -32768, 1, 2, 3, 4);
  print("i16 narrow" + text(__i8x16_with(zeros(), 0, __i16x8_narrow(a, b))));
  print("i16 narrow_u" + text(__u8x16_with(zeros(), 0, __i16x8_narrow_u(a, b))));
  let c = __u16x8_of(0, 1, 254, 255, 256, 32767, 32768, 65535);
  print("u16 narrow" + text(__u8x16_with(zeros(), 0, __u16x8_narrow(c, c + c))));
  let d = __i32x4_of(-70000, -32768, 32767, 70000);
  let e = __i32x4_of(-1, 0, 65535, 65536);
  print("i32 narrow" + text(__i16x8_with(zeros(), 0, __i32x4_narrow(d, e))));
  print("i32 narrow_u" + text(__u16x8_with(zeros(), 0, __i32x4_narrow_u(d, e))));
  let f = __u32x4_of(0 as u32, 65535 as u32, 65536 as u32, 4000000000 as u32);
  print("u32 narrow" + text(__u16x8_with(zeros(), 0, __u32x4_narrow(f, f))));
  let reversed = __u8x16_of(15 as u8, 14 as u8, 13 as u8, 12 as u8, 11 as u8, 10 as u8, 9 as u8, 8 as u8, 7 as u8, 6 as u8, 5 as u8, 4 as u8, 3 as u8, 2 as u8, 1 as u8, 0 as u8);
  print("swizzle reverse" + text(__u8x16_with(zeros(), 0, __u8x16_swizzle(u, reversed))));
  let mixed = __u8x16_of(0 as u8, 0 as u8, 16 as u8, 17 as u8, 127 as u8, 128 as u8, 255 as u8, 3 as u8, 3 as u8, 15 as u8, 31 as u8, 32 as u8, 1 as u8, 240 as u8, 2 as u8, 200 as u8);
  print("swizzle mixed" + text(__u8x16_with(zeros(), 0, __u8x16_swizzle(u, mixed))));
  print("halve" + text(halve(xs)));
  return 0;
}
