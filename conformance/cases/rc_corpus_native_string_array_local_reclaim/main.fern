












import "core/int";
import "std/string";
function mk(): i32 {
    let arr: string[] = ["value-aaaaaaaaaaaaaaaa-" + "1", "value-aaaaaaaaaaaaaaaa-" + "2"];
    return arr[0].len() + arr[1].len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 24000) + __rc_underflow_count();
}
