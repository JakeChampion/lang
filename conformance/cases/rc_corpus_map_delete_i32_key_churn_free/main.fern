






import "core/int";
import "core/map";
function mk(): i32 {
    let acc: i32 = 0;
    let im: Map[i32, i32] = map_new(8);
    im = im.insert(1, 4);
    im = im.insert(2, 6);
    let it_had: boolean = im.contains(1);
    let it = im.remove(1);
    im = it;
    if (it_had) { acc = acc + 2; }
    let im2_had: boolean = im.contains(9);
    let im2 = im.remove(9);
    im = im2;
    if (im2_had) { acc = acc + 100; }
    acc = acc + im.get_or(2, 0);
    return acc;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 4000) + __rc_underflow_count();
}
