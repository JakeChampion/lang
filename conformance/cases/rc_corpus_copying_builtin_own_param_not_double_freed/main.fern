







@noinline
function mk(pad: string, i: i32): string { return pad + "0123456789abcdef"; }

@noinline
function eat(own text: string): i32 { return __count_byte(text, 97); }

function main(): i32 {
    let pad: string = "xyzw";
    let t: i32 = 0;
    let i: i32 = 0;
    while (i < 4) {
        t = t + eat(pad + "0123456789abcdef");
        i = i + 1;
    }
    return (t - 4) + __rc_underflow_count();
}
