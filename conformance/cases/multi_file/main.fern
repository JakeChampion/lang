import "./tokens";

// Pulls a sibling module in via a relative import. Returns 5 + 17 =
// 22 so the exit code proves cross-module dispatch resolved on every
// backend.
function main(): i32 {
    var t1: tokens.Tok = tokens.make_a();
    var v1: i32 = 0;
    match (t1) {
        tokens.TokA(a) => { v1 = a.x; },
        tokens.TokB(b) => { v1 = b.y; }
    }
    var t2: tokens.Tok = tokens.make_b();
    var v2: i32 = 0;
    match (t2) {
        tokens.TokA(a) => { v2 = a.x; },
        tokens.TokB(b) => { v2 = b.y; }
    }
    return v1 + v2;
}
