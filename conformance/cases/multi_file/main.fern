import "./tokens";




function main(): i32 {
    let t1: tokens.Tok = tokens.make_a();
    let v1: i32 = 0;
    match (t1) {
        tokens.TokA(a) => { v1 = a.x; },
        tokens.TokB(b) => { v1 = b.y; }
    }
    let t2: tokens.Tok = tokens.make_b();
    let v2: i32 = 0;
    match (t2) {
        tokens.TokA(a) => { v2 = a.x; },
        tokens.TokB(b) => { v2 = b.y; }
    }
    return v1 + v2;
}
