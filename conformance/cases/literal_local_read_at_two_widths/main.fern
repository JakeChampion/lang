// One unannotated local has one slot, so it cannot be read as both an i32 and
// an i64 (#10123): the first width-fixing use decides its type.
function main(): i32 {
    let x = 2147483647;
    x = x + 1;
    let a: i32 = x;
    let b: i64 = x;
    if (b > 0i64) { return 1; }
    if (a < 0) { return 2; }
    return 3;
}
