





import "core/int";
struct Val { kind: i32, kids: i32[] }
function build(n: i32): Val {
    let vals: Val[] = [];
    let i: i32 = 0;
    while (i < n) {
        let v: Val = Val { kind: i, kids: [i] };
        vals = vals.append(v);
        if (i == 2) { return v; }
        i = i + 1;
    }
    return Val { kind: -1, kids: [] };
}
function main(): i32 {
    let got: Val = build(5);
    return (got.kind + got.kids[0] - 4) + __rc_underflow_count();
}
