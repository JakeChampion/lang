


















struct G { text: string, lines: i32[] }

function main(): i32 {
    let placed: i32[][] = [[1, 2, 3], [4, 5], [6, 7, 8, 9]];

    let g: G = G { text: "a", lines: placed[0] };
    let h: G = G { text: "b", lines: placed[1] };


    let row: i32[] = placed[2];
    let k: G = G { text: "c", lines: row };



    let tail: i32 = placed[0][2] + placed[1][1] + placed[2][3];

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < g.lines.len()) { sum = sum + g.lines[i]; i = i + 1; }
    i = 0;
    while (i < h.lines.len()) { sum = sum + h.lines[i]; i = i + 1; }
    i = 0;
    while (i < k.lines.len()) { sum = sum + k.lines[i]; i = i + 1; }




    return sum + tail + g.lines.len() + h.lines.len() + k.lines.len();
}
