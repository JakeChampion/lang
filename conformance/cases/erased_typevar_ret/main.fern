

























import "core/cmp" as cmp;

function pick2[T](keep: (T) => boolean): T[] { let e: T[] = []; return e; }

function only[T](keep: (T) => boolean, xs: T[]): T[] { return xs; }


function erased(i: i32): i32 {
    let ys = pick2((x: i32): boolean => { return x > 0; });
    let s = cmp.sort(ys);
    if (s.len() != 0) { return 253; }
    return 1;
}


function bound_by_param(i: i32): i32 {
    let zs = only((x: i32): boolean => { return x > 1; }, [3, 1, 2]);
    let t = cmp.sort(zs);
    if (t.len() != 3) { return 253; }
    return t[0];
}


function string_elem(i: i32): i32 {
    let ss = pick2((x: string): boolean => { return x.len() > 0; });
    if (ss.len() != 0) { return 252; }
    return 1;
}


function two_calls(i: i32): i32 {
    let a = pick2((x: i32): boolean => { return true; });
    let b = pick2((x: string): boolean => { return true; });
    return a.len() + b.len() + 1;
}

function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        acc = acc + erased(i) + bound_by_param(i) + string_elem(i) + two_calls(i);
        i = i + 1;
    }
    if (__rc_underflow_count() != 0) { return 251; }
    return acc % 113;
}
