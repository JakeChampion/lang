// A generic whose type params are ALL erased — every one unbounded — still
// carries them in its RETURN type. `pick2[T](keep: (T) => boolean): T[]`
// reaches the monomorphiser with type_params EMPTY and ret_type "T[]", because
// T's only occurrence is inside a fn-param's argument. call_ret_type's fast
// path handed that back verbatim, so the caller's binding had an unresolved
// element type and a downstream generic monomorphised at the type PARAMETER:
// `call to unknown symbol T.cmp`, refusing the module.
//
// The partially-erased sibling (`sort_key[T, K: Ord]`, where the bounded-only
// substitution leaves T behind) was already resolved by the residual path;
// this routes the fully-erased case through the same resolution instead of
// short-circuiting past it.
//
// Distinct from #7765, which fixed the case WITH a bounded param present
// (`filter[T, I: Iterator[T]]`) by adding an argument-position clause to
// full_ret_binds. That fix is merged and did NOT close this one — verified —
// because with no bounded param the call never reaches infer_inst at all.
//
// Positions:
//   erased   — the bail shape: T only in the fn-param's argument, no bound.
//   bound_by_param — T also reachable from an ordinary parameter; always worked.
//   string_elem — a non-i32 element, so the recovery is not i32-shaped.
//   two_calls — the same generic instantiated at two different types, so a fix
//               that cached one instantiation for all callers is visible.
//
// Sentinels are 251-253, above the `% 113` the success path returns.
import "core/cmp" as cmp;

function pick2[T](keep: (T) => boolean): T[] { var e: T[] = []; return e; }

function only[T](keep: (T) => boolean, xs: T[]): T[] { return xs; }

// The bail shape: the result feeds a generic that needs the element type.
function erased(i: i32): i32 {
    var ys = pick2(function(x: i32): boolean { return x > 0; });
    var s = cmp.sort(ys);
    if (s.len() != 0) { return 253; }
    return 1;
}

// T also reachable from an ordinary parameter — this always lowered.
function bound_by_param(i: i32): i32 {
    var zs = only(function(x: i32): boolean { return x > 1; }, [3, 1, 2]);
    var t = cmp.sort(zs);
    if (t.len() != 3) { return 253; }
    return t[0];
}

// A non-i32 element, so the recovery is not i32-shaped.
function string_elem(i: i32): i32 {
    var ss = pick2(function(x: string): boolean { return x.len() > 0; });
    if (ss.len() != 0) { return 252; }
    return 1;
}

// The same generic at two element types in one program.
function two_calls(i: i32): i32 {
    var a = pick2(function(x: i32): boolean { return true; });
    var b = pick2(function(x: string): boolean { return true; });
    return a.len() + b.len() + 1;
}

function main(): i32 {
    var acc: i32 = 0;
    var i: i32 = 0;
    while (i < 50) {
        acc = acc + erased(i) + bound_by_param(i) + string_elem(i) + two_calls(i);
        i = i + 1;
    }
    if (__rc_underflow_count() != 0) { return 251; }
    return acc % 113;
}
