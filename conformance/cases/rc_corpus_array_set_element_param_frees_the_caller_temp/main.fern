







@noinline
function put(xs: string[], v: string): string[] { return xs.with(0, v); }

@noinline
function mk(pad: string): string[] {
    let o: string[] = [];
    o = o.append(pad + "-0123456789abcdef");
    return o;
}

function main(): i32 {
    let pad: string = "wxyz";
    let t: i32 = 0;
    let i: i32 = 0;
    while (i < 4) {
        let a: string[] = mk(pad);
        let b: string[] = put(a, pad + "-fedcba9876543210");
        t = t + b[0].len();
        i = i + 1;
    }
    return (t - 84) + __rc_underflow_count();
}
