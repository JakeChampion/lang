import "std/unicode";
import "core/int";
import "std/string";
import "std/array";

function main(): i32 {
  if ("hello".to_upper() != "HELLO") {
    print("FAIL upper");
    return 11;
  }
  if ("HeLLo".to_lower() != "hello") {
    print("FAIL lower");
    return 12;
  }
  if ("  hi  ".trim() != "hi") {
    print("FAIL trim");
    return 13;
  }
  if (!"hello".starts_with("he") || !"hello".ends_with("lo")) {
    print("FAIL ends");
    return 14;
  }
  if (!"hello".contains("ell") || "hello".contains("xyz")) {
    print("FAIL contains");
    return 15;
  }
  match ("hello".index_of("l")) {
    Some(i) => {
      if (i != 2) {
        print("FAIL indexof");
        return 16;
      }
    },
    None => {
      print("FAIL indexof-none");
      return 16;
    }
  }
  if ("hello".replace("l", "L") != "heLLo") {
    print("FAIL replace");
    return 17;
  }
  if ("ab".repeat(3) != "ababab") {
    print("FAIL repeat");
    return 18;
  }
  if ("x".pad_start(3, ' ') != "  x") {
    print("FAIL padstart");
    return 19;
  }

  let parts: string[] = "a,b,c".split(",");
  if (parts.len() != 3) {
    print("FAIL split-len");
    return 20;
  }
  if (parts[0] != "a" || parts[2] != "c") {
    print("FAIL split-elem");
    return 21;
  }

  match ("hello".index_of("ll")) {
    Some(i) => {
      if (i != 2) {
        print("FAIL find");
        return 22;
      }
    },
    None => {
      print("FAIL find-none");
      return 23;
    }
  }
  match ("hello".index_of("xyz")) {
    Some(_) => {
      print("FAIL find-miss");
      return 24;
    },
    None => {}
  }
  match ("hello hello".last_index_of("hello")) {
    Some(i) => {
      if (i != 6) {
        print("FAIL rfind");
        return 25;
      }
    },
    None => {
      print("FAIL rfind-none");
      return 26;
    }
  }
  match ("Hello".index_of_ci("LLO")) {
    Some(i) => {
      if (i != 2) {
        print("FAIL findci");
        return 27;
      }
    },
    None => {
      print("FAIL findci-none");
      return 28;
    }
  }
  match (parts.index_of("c")) {
    Some(i) => {
      if (i != 2) {
        print("FAIL position");
        return 29;
      }
    },
    None => {
      print("FAIL position-none");
      return 30;
    }
  }
  match (parts.index_of("z")) {
    Some(_) => {
      print("FAIL position-miss");
      return 31;
    },
    None => {}
  }

  print("OK");
  return 0;
}
