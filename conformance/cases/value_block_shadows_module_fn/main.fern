


















function widen(v: i64): i64 { return v; }

function main(): i32 {
    let widen: i64 = 7000000000i64;
    let xs: i64[] = [1i64, (if (true) { widen } else { 2i64 }), 3i64];
    if (xs[1] != 7000000000i64) { return 1; }


    let w: i64 = 6000000000i64;
    let ys: i64[] = [1i64, (if (true) { w } else { 2i64 }), 3i64];
    if (ys[1] != 6000000000i64) { return 2; }




    let zs: i64[] = [1i64, (if (true) { widen2(5000000000i64) } else { 2i64 }), 3i64];
    if (zs[1] != 5000000000i64) { return 3; }

    return 0;
}

function widen2(v: i64): i64 { return v; }
