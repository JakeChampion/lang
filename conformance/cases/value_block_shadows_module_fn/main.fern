// A value-position `if` desugars to a zero-argument IIFE, and the lift hoists a
// capture-free lambda bodily to a top-level `__lam_N`. `lambda_has_no_captures`
// decided "capture-free" by forgiving any free ident that names a module
// function — with no check that the name still MEANS the module function here.
//
// `widen` is both a module function and a local. The lambda reads the local, so
// it captures; the forgiveness said it did not, the body was hoisted, and
// `widen` re-resolved against the module inside the hoisted function. Element 1
// came back wrong (exit 1 below) while `-interp` was correct.
//
// This is the exclusion #6191 removed from `lambda_captures`, whose doc says
// why: "a name that is BOTH an enclosing local and a module function is
// shadowed, so it must be captured, and the gfns exclusion said the opposite."
// The sibling predicate kept it until #7253.
//
// Renaming the local — and nothing else — made the same program correct, which
// is what identified the key rather than the arithmetic. The second half below
// is that control, inlined so the two travel together: if the fix regresses,
// `xs` goes wrong and `ys` stays right.
function widen(v: i64): i64 { return v; }

function main(): i32 {
    var widen: i64 = 7000000000i64;
    var xs: i64[] = [1i64, (if (true) { widen } else { 2i64 }), 3i64];
    if (xs[1] != 7000000000i64) { return 1; }

    // The rename control: same shape, a name the module does not define.
    var w: i64 = 6000000000i64;
    var ys: i64[] = [1i64, (if (true) { w } else { 2i64 }), 3i64];
    if (ys[1] != 6000000000i64) { return 2; }

    // The forgiveness itself is load-bearing and must survive: a genuine call
    // to an unshadowed module function from inside a value-block IIFE still
    // lifts, rather than becoming a capture the lift cannot type.
    var zs: i64[] = [1i64, (if (true) { widen2(5000000000i64) } else { 2i64 }), 3i64];
    if (zs[1] != 5000000000i64) { return 3; }

    return 0;
}

function widen2(v: i64): i64 { return v; }
