// `if let` reads the shared pattern grammar (#5356): every pattern form a
// `match` accepts works in its head.
//
// Payload bindings stay scoped to the then-branch; the else branch
// sees the enclosing scope only.
enum Box { Full(i32), Empty }
function main(): i32 {
  let b: Box = Empty;
  if let Full(v) = b { return v; } else { return 42; }
  return 99;
}
