function run_i16x8(): void {
  let a = __i16x8_of(1, -2, 3, -4, 32767, -32768, 7, -100);
  let b = __i16x8_of(5, 5, -5, -5, 1, -1, 32767, 32767);
  print("i16x8 add" + bytes_i16x8(a + b));
  print("i16x8 sub" + bytes_i16x8(a - b));
