  print("i16x8 sub_sat" + bytes_i16x8(__i16x8_sub_sat(a, b)));
  print("i16x8 min" + bytes_i16x8(__i16x8_min(a, b)));
  print("i16x8 max" + bytes_i16x8(__i16x8_max(a, b)));
  print("i16x8 masks " + __i16x8_bitmask(a).to_string() + " " + __i16x8_bitmask(__i16x8_lt(a, b)).to_string() + " " + __i16x8_bitmask(__i16x8_eq(a, b)).to_string() + " " + __i16x8_bitmask(__i16x8_ne(a, b)).to_string());
  print("i16x8 bits" + bytes_i16x8(__i16x8_xor(__i16x8_and(a, b), __i16x8_or(a, b))));
  print("i16x8 select" + bytes_i16x8(through_i16x8(a, b)));
  print("i16x8 shl" + bytes_i16x8(__i16x8_shl(a, 3)));
  print("i16x8 shr" + bytes_i16x8(__i16x8_shr(a, 2)));
  print("i16x8 shr count" + bytes_i16x8(__i16x8_shr(a, 18)));
  let s = __i16x8_splat(32767);
  print("i16x8 lane " + __i16x8_lane(a, 0).to_string() + " " + __i16x8_lane(a, 7).to_string() + " " + __i16x8_lane(s, 7).to_string() + " " + __i16x8_lane(a + s, 1).to_string());
  let xs = ramp();
  print("i16x8 load" + bytes_i16x8(__i16x8_load(xs, 3) + a));
  print("i16x8 with" + text(__i16x8_with(xs, 4, a)));
}

function bytes_u32x4(v: u32x4): string {
  return text(__u32x4_with(zeros(), 0, v));
}

function through_u32x4(a: u32x4, b: u32x4): u32x4 {
  return __u32x4_select(a, b, __u32x4_lt(a, b));
}

function run_u32x4(): void {
  let a = __u32x4_of(1 as u32, 2 as u32, 3 as u32, 4294967290 as u32);
  let b = __u32x4_of(5 as u32, 5 as u32, 5 as u32, 10 as u32);
  print("u32x4 add" + bytes_u32x4(a + b));
  print("u32x4 sub" + bytes_u32x4(a - b));
  print("u32x4 mul" + bytes_u32x4(a * b));
  print("u32x4 min" + bytes_u32x4(__u32x4_min(a, b)));
  print("u32x4 max" + bytes_u32x4(__u32x4_max(a, b)));
  print("u32x4 masks " + __u32x4_bitmask(a).to_string() + " " + __u32x4_bitmask(__u32x4_lt(a, b)).to_string() + " " + __u32x4_bitmask(__u32x4_eq(a, b)).to_string() + " " + __u32x4_bitmask(__u32x4_ne(a, b)).to_string());
  print("u32x4 bits" + bytes_u32x4(__u32x4_xor(__u32x4_and(a, b), __u32x4_or(a, b))));
  print("u32x4 select" + bytes_u32x4(through_u32x4(a, b)));
  print("u32x4 shl" + bytes_u32x4(__u32x4_shl(a, 3)));
  print("u32x4 shr" + bytes_u32x4(__u32x4_shr(a, 2)));
  print("u32x4 shr count" + bytes_u32x4(__u32x4_shr(a, 34)));
  let s = __u32x4_splat(4294967295 as u32);
  print("u32x4 lane " + __u32x4_lane(a, 0).to_string() + " " + __u32x4_lane(a, 3).to_string() + " " + __u32x4_lane(s, 3).to_string() + " " + __u32x4_lane(a + s, 1).to_string());
  let xs = ramp();
  print("u32x4 load" + bytes_u32x4(__u32x4_load(xs, 3) + a));
  print("u32x4 with" + text(__u32x4_with(xs, 4, a)));
}

function bytes_i32x4(v: i32x4): string {
  return text(__i32x4_with(zeros(), 0, v));
}

function through_i32x4(a: i32x4, b: i32x4): i32x4 {
  return __i32x4_select(a, b, __i32x4_lt(a, b));
}

function run_i32x4(): void {
  let a = __i32x4_of(1, -2, 3, -4);
  let b = __i32x4_of(5, 5, -5, -5);
  print("i32x4 add" + bytes_i32x4(a + b));
  print("i32x4 sub" + bytes_i32x4(a - b));
  print("i32x4 mul" + bytes_i32x4(a * b));
  print("i32x4 neg" + bytes_i32x4(-a));
  print("i32x4 abs" + bytes_i32x4(__i32x4_abs(a)));
  print("i32x4 min" + bytes_i32x4(__i32x4_min(a, b)));
  print("i32x4 max" + bytes_i32x4(__i32x4_max(a, b)));
  print("i32x4 masks " + __i32x4_bitmask(a).to_string() + " " + __i32x4_bitmask(__i32x4_lt(a, b)).to_string() + " " + __i32x4_bitmask(__i32x4_eq(a, b)).to_string() + " " + __i32x4_bitmask(__i32x4_ne(a, b)).to_string());
  print("i32x4 bits" + bytes_i32x4(__i32x4_xor(__i32x4_and(a, b), __i32x4_or(a, b))));
  print("i32x4 select" + bytes_i32x4(through_i32x4(a, b)));
  print("i32x4 shl" + bytes_i32x4(__i32x4_shl(a, 3)));
  print("i32x4 shr" + bytes_i32x4(__i32x4_shr(a, 2)));
  print("i32x4 shr count" + bytes_i32x4(__i32x4_shr(a, 34)));
  let s = __i32x4_splat(2147483647);
  print("i32x4 lane " + __i32x4_lane(a, 0).to_string() + " " + __i32x4_lane(a, 3).to_string() + " " + __i32x4_lane(s, 3).to_string() + " " + __i32x4_lane(a + s, 1).to_string());
  let xs = ramp();
  print("i32x4 load" + bytes_i32x4(__i32x4_load(xs, 3) + a));
  print("i32x4 with" + text(__i32x4_with(xs, 4, a)));
}

function main(): i32 {
  run_u8x16();
  run_i8x16();
  run_u16x8();
  run_i16x8();
  run_u32x4();
  run_i32x4();
  return 0;
}
