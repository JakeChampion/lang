// spec: AL-05
















import "std/i32";
import "std/i64";
import "std/string";

function round(n: i32): i32 {
    let s: string = "abcdefgh" + n.to_string();
    return s.len();
}

function rounds(n: i32): i32 {
    let acc: i32 = 0;
    for i in 0..n {
        acc = acc + round(i);
    }
    return acc;
}

function main(): i32 {
    let c0: i64 = __heap_alloc_count();
    let x: i32 = rounds(50);
    let c1: i64 = __heap_alloc_count();
    let y: i32 = rounds(100);
    let c2: i64 = __heap_alloc_count();

    print(x.to_string());
    print(y.to_string());

    if ((c2 - c1) == (c1 - c0) * 2i64) { print("scales"); } else { print("off"); }


    if ((c1 - c0) > 0i64) { print("counted"); } else { print("blind"); }
    return 0;
}
