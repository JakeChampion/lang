











import "core/int";
import "std/string";
function mk(): i32 {
    let s: string = "value-aaaaaaaaaaaaaaaaaaaa-" + "1";
    return s.len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 14000) + __rc_underflow_count();
}
