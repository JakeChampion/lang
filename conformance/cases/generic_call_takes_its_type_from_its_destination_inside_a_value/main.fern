// The destination of a value gives a type to a generic call inside the
// value when the call has no argument that binds its type parameter. The
// call is the receiver of a method, an element of a tuple, the base of a
// struct update, or the result of a lambda with a written result type. The
// destination can name a type parameter of the function that the value is
// in. A call through a field that holds a function also gives a type to a
// generic call that takes its result.
struct El[M] { kids: El[M][], tap: Option[M], pad: f64, label: string }

function element[M](kids: El[M][]): El[M] {
    return El { kids: kids, tap: None, pad: 0.0, label: "" };
}

function text[M](s: string): El[M] {
    return El { ...element([]), label: s };
}

function button[M](s: string, m: M): El[M] {
    return El { ...element([text(s)]), tap: Some(m) };
}

function column[M](kids: El[M][]): El[M] {
    return element(kids);
}

function (e: El[M]) padded(v: f64): El[M] {
    return El { ...e, pad: v };
}

function (e: El[M]) on_tap(m: M): El[M] {
    return El { ...e, tap: Some(m) };
}

function wide_button[M](s: string, m: M): El[M] {
    return column([text(s).padded(1.0)]).padded(6.0).on_tap(m);
}

function (e: El[M]) taps(): i32 {
    let n = 0;
    if let Some(_) = e.tap {
        n = 1;
    }
    for kid in e.kids {
        n += kid.taps();
    }
    return n;
}

function rows[M](n: i32, build: (i32) => El[M]): El[M] {
    let kids: El[M][] = [];
    for i in 0..n {
        kids = kids.append(build(i));
    }
    return element(kids);
}

struct Program[S, M] { view: (S) => El[M] }

function program[S, M](view: (S) => El[M]): Program[S, M] {
    return Program { view: view };
}

function count[M](e: El[M]): i32 {
    return e.kids.len();
}

function shown[S, M](p: Program[S, M], state: S): i32 {
    return count(p.view(state));
}

enum Msg { Inc, Dec }

function receiver(): El[Msg] {
    let e: El[Msg] = text("a").padded(2.0);
    return e;
}

function chain(): El[Msg] {
    return column([text("a").padded(1.0), button("+", Inc).padded(2.0)]).padded(3.0);
}

function twice(): El[Msg] {
    return text("a").padded(1.0).padded(4.0);
}

function pair(): (El[Msg], i32) {
    let p: (El[Msg], i32) = (text("a").padded(5.0), 1);
    return p;
}

function view(n: i32): El[Msg] {
    if (n > 0) {
        return column([button("-", Dec), text("b")]);
    }
    return column([]);
}

function main(): i32 {
    print(receiver().pad);
    let c = chain();
    print(c.pad);
    print(c.kids.len());
    print(c.kids[1].pad);
    print(c.taps());
    print(twice().pad);
    let (p, one) = pair();
    print(p.pad);
    print(one);
    print(text[Msg]("label").label);
    print(button("x", Inc).kids.len());
    print(shown(program(view), 1));
    let listed: El[Msg] = rows(3, (i: i32): El[Msg] => text("row").padded(i as f64));
    print(listed.kids[2].pad);
    let w: El[Msg] = wide_button("w", Dec);
    print(w.pad);
    print(w.taps());
    return 0;
}
