// spec: ML-04
// The front end accepts this program: it does not follow a view that a
// reassignment puts in a local. The lowering follows each assignment in its
// order, and it refuses the view of `owned` in the returned array.
import "std/string";

function local_views(): str[] {
  let owned = "hello" + "!";
  let xs: str[] = [];
  xs = xs.append(owned.trim());
  return xs;
}

function main(): i32 {
  return local_views().len();
}
