













import "core/cmp";
import "core/int";

@derive(cmp.Eq, cmp.Display, cmp.Ord)
enum Shape { Square(i32), Empty }

struct Empty { n: i32 }
struct Square { side: i32 }

function name_of(s: Shape): string {
    match (s) {
        Shape.Square(n) => { return "sq" + n.to_string(); },
        Shape.Empty => { return "empty"; }
    }
}

function area(q: Square): i32 { return q.side * q.side; }

function main(): i32 {
    let e: Empty = Empty { n: 3 };
    let q: Square = Square { side: 4 };
    let v: Shape = Empty;
    let w: Shape = Square(7);
    let t: i32 = e.n + q.side;
    t = t + name_of(v).len();
    t = t + name_of(w).len();
    t = t + Empty.to_string().len();
    t = t + area(Square { side: 2 });
    let r: Square = Square { ...q, side: 5 };
    t = t + r.side;
    return t;
}
