





struct Holder { id: i32, items: i32[] }

function churn(n: i32): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < n) {
        let a: Holder = Holder { id: i, items: [i, i + 1] };
        let s: i32 = a.id + a.items[0] + a.items[1];
        if (i % 2 == 0) {
            let b: Holder = Holder { id: s, items: [i + 2, i + 3] };
            acc = acc + b.id + b.items[0] + b.items[1];
        }
        i = i + 1;
    }
    return acc;
}

function main(): i32 {

    if (churn(200) != 50100) { return 99; }
    return 0;
}
