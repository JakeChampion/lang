// rc correctness: the program tears its values down and folds
// __rc_underflow_count() into its exit code, so 0 means no over-release.
//
// Aliased array value: the set value is an Ident
// (needsRcIncOnAlias → inc-on-set), so the source local's
// exit dec and the map's drop balance to a single free.
import "core/int";
import "core/map";
function main(): i32 {
    let m: Map[i32, i32[]] = map_new(4);
    let arr: i32[] = [7, 8, 9];
    m = m.insert(5, arr);
    let v: i32[] = m.get_or(5, []);
    return (v[1] - 8) + __rc_underflow_count();
}
