




import "std/regex";

function main(): i32 {
  let r: i32 = 0;

  let m: regex.RCaps = require_caps(regex.regex_captures("(?<year>\\d{4})-(?<mon>\\d{2})", "date 2026-07 x"));
  if (require_regex_text(m.group_named("year")) == "2026" && require_regex_text(m.group_named("mon")) == "07") {
    r = r + 1;
  }

  if (require_regex_text(m.group(1)) == "2026" && at(m.group_index("year"), 1) && at(m.group_index("mon"), 2)) {
    r = r + 2;
  }


  let mix: regex.RCaps = require_caps(regex.regex_captures("(\\w+)@(?<host>\\w+)", "a@b"));
  if (require_regex_text(mix.group(1)) == "a" && require_regex_text(mix.group_named("host")) == "b" && at(mix.group_index("host"), 2)) {
    r = r + 4;
  }


  if (require_regex_text(m.group_named("nope")) == "" && none(m.group_index("nope"))) {
    r = r + 8;
  }


  let absent: regex.RCaps = require_caps(regex.regex_captures("a(?<b>bc)?d", "ad"));
  let present: regex.RCaps = require_caps(regex.regex_captures("a(?<b>bc)?d", "abcd"));
  if (!absent.has_group_named("b") && present.has_group_named("b") && require_regex_text(present.group_named("b")) == "bc") {
    r = r + 16;
  }


  let q: regex.RCaps = require_caps(regex.regex_captures("(?<pair>(a|b)c)+", "acbc"));
  if (require_regex_text(q.group_named("pair")) == "bc" && at(q.group_index("pair"), 1)) {
    r = r + 32;
  }


  if (require_regex_text(regex.regex_replace_all_groups("(?<k>\\w+)=(?<v>\\d+)", "a=1 b=22", "${v}:${k}")) == "1:a 22:b") {
    r = r + 64;
  }


  let ci: regex.RCaps = require_caps(regex.regex_captures("(?i)(?<g>HEL+O)", "say hello"));
  if (require_regex_text(ci.group_named("g")) == "hello") {
    r = r + 128;
  }

  return r;
}


function require_caps(result: Option[regex.RCaps]): regex.RCaps {
  if let Some(c) = result {
    return c;
  }
  exit(1);
  return regex.RCaps { text: "", starts: [], ends: [], names: [] };
}

function none(o: Option[i32]): boolean {
  if let Some(_) = o {
    return false;
  }
  return true;
}

function at(o: Option[i32], want: i32): boolean {
  if let Some(v) = o {
    return v == want;
  }
  return false;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
