





































import "core/iter" as iter;
import "core/cmp" as cmp;

function filter[T, I: iter.Iterator[T]](it: I, keep: (T) => boolean): T[] {
    let out: T[] = [];
    let cur = it;
    let go = true;
    while (go) {
        match (cur.next()) {
            Some(t) => {
                if (keep(t.0)) { out = out.append(t.0); }
                cur = t.1;
            },
            None => { go = false; }
        }
    }
    return out;
}

function map[T, U, I: iter.Iterator[T]](it: I, f: (T) => U): U[] {
    let out: U[] = [];
    let cur = it;
    let go = true;
    while (go) {
        match (cur.next()) {
            Some(t) => {
                out = out.append(f(t.0));
                cur = t.1;
            },
            None => { go = false; }
        }
    }
    return out;
}


function filter_chain(i: i32): i32 {
    let xs: i32[] = [5, 2, 8, 1, 4];
    let evens = filter(iter.of(xs), (x: i32): boolean => { return x % 2 == 0; });
    let asc = cmp.sort(evens);
    if (asc.len() != 3) { return 253; }
    return asc[0];
}


function map_chain(i: i32): i32 {
    let xs: i32[] = [3, 1, 2];
    let dbl = map(iter.of(xs), (x: i32): i32 => { return x * 2; });
    let asc = cmp.sort(dbl);
    if (asc.len() != 3) { return 253; }
    return asc[0];
}


function annotated(i: i32): i32 {
    let xs: i32[] = [5, 2, 8];
    let evens: i32[] = filter(iter.of(xs), (x: i32): boolean => { return x % 2 == 0; });
    let asc = cmp.sort(evens);
    return asc[0];
}


function strings(i: i32): i32 {
    let ss: string[] = ["pear", "fig", "plum"];
    let keep = filter(iter.of(ss), (s: string): boolean => { return s.len() > 3; });
    let asc = cmp.sort(keep);
    if (asc.len() != 2) { return 252; }
    return asc[0].len();
}


function floats(i: i32): i32 {
    let xs: f64[] = [5.5, 2.25, 8.5, 1.75, 4.5];
    let big = filter(iter.of(xs), (x: f64): boolean => { return x > 3.0; });
    if (big.len() != 3) { return 253; }
    return (big[0] as i32) + (big[1] as i32) + (big[2] as i32);
}


function env_lambda(i: i32): i32 {
    let xs: f64[] = [5.5, 2.25, 8.5, 1.75, 4.5];
    let keep = (x: f64): boolean => { return x > 3.0; };
    let big = filter(iter.of(xs), keep);
    if (big.len() != 3) { return 253; }
    return big[0] as i32;
}

function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        acc = acc + filter_chain(i) + map_chain(i) + annotated(i) + strings(i) + floats(i) + env_lambda(i);
        i = i + 1;
    }
    if (__rc_underflow_count() != 0) { return 251; }
    return acc % 113;
}
