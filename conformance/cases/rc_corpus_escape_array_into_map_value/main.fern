








import "core/int";
import "core/map";
import "std/string";
function add_pair(m: Map[i32, i32[]], k: i32): Map[i32, i32[]] {
    let arr: i32[] = [k * 10, k * 10 + 1];
    return m.insert(k, arr);
}
function main(): i32 {
    let m: Map[i32, i32[]] = map_new(8);
    m = add_pair(m, 7);
    let c: i32 = 0;
    while (c < 64) {
        let junk: i32[] = [c, c];
        c = c + junk.len();
    }
    let v: i32[] = m.get_or(7, []);
    return (v.len() - 2) + (v[0] - 70) + (v[1] - 71) + __rc_underflow_count();
}
