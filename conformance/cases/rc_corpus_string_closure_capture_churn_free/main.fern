









function make_box(seed: i32): () => i32 {
    let s: string = "ab" + "cd";
    return (): i32 => { return s.len(); };
}
function mk(seed: i32): i32 {
    let f: () => i32 = make_box(seed);
    return f();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 200) { total = total + mk(k); k = k + 1; }
    return (total - 800) + __rc_underflow_count();
}
