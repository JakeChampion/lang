import "std/string";
// Reads lines until EOF, summing the parsed integers.
// stdin "10\n15\n17\n" -> 42.
function main(): i32 {
    let total: i32 = 0;
    let done: boolean = false;
    while (!done) {
        match (read_line()) {
            Some(line) => {
                match (line.trim().parse_int()) {
                    Some(n) => { total = total + n; },
                    None => { }
                }
            },
            None => { done = true; }
        }
    }
    return total;
}
