// A tree of unsuffixed integer literals is evaluated at the type of the
// destination it is written to — a typed `let`, an assignment, a `return`, an
// argument — so `2147483647 + 1` written to an i64 is 2147483648, not an i32
// wrap. A u8 computation wraps at 8 bits, and the smallest i32 literal is an
// i32 that wraps on the way down.
import "std/i32";
import "std/i64";
import "std/u64";
import "core/int";

function ret(): i64 { return 2147483647 + 1; }
function arg(x: i64): i64 { return x; }

function main(): i32 {
  let a: i64 = 2147483647 + 1;
  let b: i64 = 0xFFFFFFFF;
  let c: u64 = 2147483647 * 4;
  let d: i64 = 0;
  d = 2147483647 + 2;
  let f: usize = 2147483647 + 1;
  print(a.to_string());
  print(b.to_string());
  print(c.to_string());
  print(d.to_string());
  print(f.to_string());
  print(ret().to_string());
  print(arg(2147483647 * 2).to_string());
  let w: u8 = 250u8 + 10u8;
  let z: u8 = 0u8 - 1u8;
  print((w as i32).to_string());
  print((z as i32).to_string());
  if (w < 10u8) {
    print("wrapped");
  }
  let mn: i32 = -2147483648;
  print((mn - 1).to_string());
  if (0 - mn != mn) {
    return 1;
  }
  return 0;
}
