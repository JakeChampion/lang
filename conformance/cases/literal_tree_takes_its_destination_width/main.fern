




import "std/i32";
import "std/i64";
import "std/u64";
import "core/int";

function ret(): i64 { return 2147483647 + 1; }
function arg(x: i64): i64 { return x; }
struct W { v: i32 }
function (w: W) wide(x: i64): i64 { return x; }
struct Box[T] { v: T }
function (b: Box[T]) or_v(x: T): T { return x; }

function main(): i32 {
  let a: i64 = 2147483647 + 1;
  let b: i64 = 0xFFFFFFFF;
  let c: u64 = 2147483647 * 4;
  let d: i64 = 0;
  d = 2147483647 + 2;
  let f: usize = 2147483647 + 1;
  print(a.to_string());
  print(b.to_string());
  print(c.to_string());
  print(d.to_string());
  print(f.to_string());
  print(ret().to_string());
  print(arg(2147483647 * 2).to_string());
  print(W { v: 0 }.wide(2147483647 + 1).to_string());
  let bx: Box[i64] = Box { v: 0 };
  print(bx.or_v(2147483647 * 3).to_string());
  let w: u8 = 250u8 + 10u8;
  let z: u8 = 0u8 - 1u8;
  print((w as i32).to_string());
  print((z as i32).to_string());
  if (w < 10u8) {
    print("wrapped");
  }
  let mn: i32 = -2147483648;
  print((mn - 1).to_string());
  if (0 - mn != mn) {
    return 1;
  }
  return 0;
}
