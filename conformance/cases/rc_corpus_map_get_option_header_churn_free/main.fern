












import "core/int";
import "core/map";
import "std/string";
function mk(): i32 {
    let m: Map[i32, i32] = map_new(8);
    m = m.insert(1, 5);
    m = m.insert(2, 9);
    let hit = m.get(1);
    let miss = m.get(99);
    let sm: Map[string, i32] = map_new(8);
    sm = sm.insert("a" + "a", 3);
    let shit = sm.get("a" + "a");
    let smiss = sm.get("z" + "z");
    let vm: Map[i32, string] = map_new(8);
    vm = vm.insert(1, "hi" + "there");
    let vhit = vm.get(1);
    let acc: i32 = 0;
    match (m.get(2)) { Some(x) => { acc = x; }, None => {} }
    return acc;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 4500) + __rc_underflow_count();
}
