







import "core/map";
import "core/cmp";
import "core/int";

@derive(cmp.Eq, cmp.Hash)
struct Name { first: string, rank: i32 }

@derive(cmp.Eq, cmp.Hash)
enum Tag { A(i32), B, C(string) }

function main(): i32 {

    let m: Map[Name, i32] = map_new(8);
    m = m.insert(Name { first: "ada", rank: 1 }, 10);
    m = m.insert(Name { first: "bob", rank: 2 }, 20);


    if (m.get_or(Name { first: "a" + "da", rank: 1 }, -1) != 10) { return 1; }
    if (m.get_or(Name { first: "bob", rank: 2 }, -1) != 20) { return 2; }
    if (m.get_or(Name { first: "ada", rank: 9 }, -1) != -1) { return 3; }
    if (!m.contains(Name { first: "ada", rank: 1 })) { return 4; }
    if (m.contains(Name { first: "zzz", rank: 1 })) { return 5; }
    m = m.insert(Name { first: "ada", rank: 1 }, 99);
    if (m.len() != 2) { return 6; }
    if (m.get_or(Name { first: "ada", rank: 1 }, -1) != 99) { return 7; }
    let removed: boolean = m.contains(Name { first: "ada", rank: 1 });
    let m2 = m.remove(Name { first: "ada", rank: 1 });
    m = m2;
    if (!removed) { return 8; }
    if (m.contains(Name { first: "ada", rank: 1 })) { return 9; }


    let em: Map[Tag, i32] = map_new(8);
    em = em.insert(A(1), 100);
    em = em.insert(B, 200);
    em = em.insert(C("x" + "y"), 300);
    if (em.get_or(A(1), 0) != 100) { return 10; }
    if (em.get_or(B, 0) != 200) { return 11; }
    if (em.get_or(C("xy"), 0) != 300) { return 12; }
    if (em.get_or(A(2), -1) != -1) { return 13; }
    if (em.get_or(C("zz"), -1) != -1) { return 14; }


    let total: i32 = 0;
    for k in em.keys() {
        total = total + em.get_or(k, 0);
    }
    if (total != 600) { return 15; }




    match (em.get(A(1))) { Some(v) => { if (v != 100) { return 16; } }, None => { return 17; } }
    match (em.get(A(9))) { Some(v) => { return 18; }, None => {} }




    let keysum: i32 = 0;
    for (k, v) in em { keysum = keysum + v; }
    if (keysum != 600) { return 19; }
    if (em.entries().len() != 3) { return 20; }



    let n: Map[Name, i32] = map_new(8);
    n = n.insert(Name { first: "bob", rank: 2 }, 77);
    n = n.insert(Name { first: "cat", rank: 3 }, 88);
    let mg = m.merge(n);
    if (mg.len() != 2) { return 21; }
    if (mg.get_or(Name { first: "bob", rank: 2 }, 0) != 77) { return 22; }
    if (mg.get_or(Name { first: "cat", rank: 3 }, 0) != 88) { return 23; }

    return 0;
}
