









struct Op { a: i32, b: i32 }
struct St { ops: Op[] }

@noinline
function mkop(i: i32): Op { return Op { a: i, b: i * 2 }; }

@noinline
function emit(s: St, o: Op): St { return St { ops: s.ops.append(o) }; }

function main(): i32 {
    let st: St = St { ops: [] };
    let i: i32 = 0;
    while (i < 3) {
        st = emit(st, mkop(i));
        i = i + 1;
    }
    let t: i32 = 0;
    let k: i32 = 0;
    while (k < st.ops.len()) {
        t = t * 10 + st.ops[k].a;
        k = k + 1;
    }
    return (t - 12) + __rc_underflow_count();
}
