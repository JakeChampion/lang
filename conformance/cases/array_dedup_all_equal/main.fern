// std/array's dedup: collapse each run of consecutive equal elements to one.
// A minimal inline body, so this pins the lowering of its shape rather than
// the shipped module.
//
// all-equal collapses to one: [7,7,7,7] -> [7]; len 1, elem 7 -> 17.
function dedup(xs: i32[]): i32[] { let out: i32[] = []; let i: i32 = 0; while (i < xs.len()) { if (i == 0 || !(xs[i] == xs[i - 1])) { out = out.append(xs[i]); } i = i + 1; } return out; }
function main(): i32 { let r = dedup([7, 7, 7, 7]); return r.len() * 10 + r[0]; }
