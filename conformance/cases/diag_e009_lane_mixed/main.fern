// E009: lane arithmetic takes two values of one lane type. A scalar is made a
// lane value with splat, and the two lane types do not mix.
import "std/f64";

function main(): i32 {
  let a: f64x2 = __f64x2_splat(1.0);
  let q: f32x4 = __f32x4_splat(1.0);
  let ok: f64x2 = a + __f64x2_splat(2.0);
  let b = a + 2.0;
  let c = a * q;
  return 0;
}
