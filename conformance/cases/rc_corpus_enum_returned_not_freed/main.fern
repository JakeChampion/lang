






import "core/int";
enum Wrap { A(i32[]), B(i32[]) }
function make_w(k: i32): Wrap {
    let w: Wrap = A([k, k + 1, k + 2]);
    return w;
}
function main(): i32 {
    let got: i32 = 0;
    let k: i32 = 0;
    while (k < 50) {
        let w: Wrap = make_w(k);
        match (w) {
            A(xs) => { got = got + xs[1]; },
            B(xs) => { got = got + xs[0]; }
        }
        k = k + 1;
    }
    return (got - 1275) + __rc_underflow_count();
}
