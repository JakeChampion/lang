





function g(o: Option[Result[i32, i32]]): i32 {
  match (o) {
    Some(Ok(n)) when n > 10 => { return n + 100; },
    Some(Ok(n)) => { return n; },
    Some(Err(e)) => { return e; },
    None => { return 0 - 1; },
  }
  return 0 - 2;
}
function main(): i32 { return g(Some(Ok(20))) + g(Some(Ok(3))); }
