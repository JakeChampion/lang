







import "core/int";
import "core/map";
import "std/string";
function mk(): i32 {
    let acc: i32 = 0;
    let sm: Map[string, i32] = map_new(8);
    sm = sm.insert("ke" + "y", 7);
    sm = sm.insert("ot" + "her", 3);
    sm = sm.insert("th" + "ird", 10);
    sm = sm.remove("th" + "ird");
    acc = acc + sm.get_or("ot" + "her", 0);
    return acc;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 1500) + __rc_underflow_count();
}
