import "std/string";
import "core/cmp";
















function fold_order(a: string, b: string): i32 {
    return a.cmp_ignore_ascii_case(b);
}

function lcg_next(state: i32): i32 {
    return ((state * 1103515245) + 12345) & 2147483647;
}

function count_of(xs: string[], target: string): i32 {
    let c: i32 = 0;
    for x in xs {
        if (x == target) { c = c + 1; }
    }
    return c;
}

function is_sorted_str(xs: string[]): boolean {
    let i: i32 = 1;
    while (i < xs.len()) {
        if (xs[i - 1].cmp(xs[i]) > 0) { return false; }
        i = i + 1;
    }
    return true;
}

function is_sorted_str_desc(xs: string[]): boolean {
    let i: i32 = 1;
    while (i < xs.len()) {
        if (xs[i - 1].cmp(xs[i]) < 0) { return false; }
        i = i + 1;
    }
    return true;
}

function is_sorted_str_ci(xs: string[]): boolean {
    let i: i32 = 1;
    while (i < xs.len()) {
        if (fold_order(xs[i - 1], xs[i]) > 0) { return false; }
        i = i + 1;
    }
    return true;
}

function permutation_of(a: string[], b: string[]): boolean {
    if (a.len() != b.len()) { return false; }
    for x in a {
        if (count_of(a, x) != count_of(b, x)) { return false; }
    }
    return true;
}



function word_at(i: i32): string {
    let words: string[] = ["apple", "Apple", "APPLE", "banana", "Ban",
                           "banana-split", "cherry", "", "a", "aa",
                           "Zebra", "zebra", "date", "Date", "fig"];
    return words[i % words.len()];
}

function main(): i32 {
    let state: i32 = 987654321;
    let trial: i32 = 0;
    while (trial < 60) {
        state = lcg_next(state);
        let n: i32 = state % 40;
        let arr: string[] = [];
        let i: i32 = 0;
        while (i < n) {
            state = lcg_next(state);
            arr = arr.append(word_at((state / 11) % 1000));
            i = i + 1;
        }

        let asc: string[] = cmp.sort(arr);
        if (!is_sorted_str(asc)) {
            print("asc ordering FAILED at trial " + trial.to_string());
            return 1;
        }
        if (!permutation_of(arr, asc)) {
            print("asc permutation FAILED at trial " + trial.to_string());
            return 1;
        }

        let desc: string[] = cmp.sort_desc(arr);
        if (!is_sorted_str_desc(desc)) {
            print("desc ordering FAILED at trial " + trial.to_string());
            return 1;
        }
        if (!permutation_of(arr, desc)) {
            print("desc permutation FAILED at trial " + trial.to_string());
            return 1;
        }

        let ci: string[] = cmp.sort_by(arr, fold_order);
        if (!is_sorted_str_ci(ci)) {
            print("ci ordering FAILED at trial " + trial.to_string());
            return 1;
        }
        if (!permutation_of(arr, ci)) {
            print("ci permutation FAILED at trial " + trial.to_string());
            return 1;
        }
        trial = trial + 1;
    }


    let empty: string[] = [];
    if (cmp.sort(empty).len() != 0) {
        print("empty FAILED");
        return 1;
    }
    let one: string[] = ["solo"];
    let one_sorted: string[] = cmp.sort(one);
    if (one_sorted.len() != 1) {
        print("singleton len FAILED");
        return 1;
    }
    if (one_sorted[0] != "solo") {
        print("singleton value FAILED");
        return 1;
    }
    if (one[0] != "solo") {
        print("singleton input clobbered FAILED");
        return 1;
    }


    let s: string[] = cmp.sort_by(["b", "A", "B", "a"], fold_order);
    if (s[0] != "A" || s[1] != "a" || s[2] != "b" || s[3] != "B") {
        print("ci stability FAILED");
        return 1;
    }

    print("OK");
    return 0;
}
