








function body(k: string): i32 {
    let b: string = "";
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        i = i + 1;
        let a: string = "d" + k + b;
        b = a;
        if (b.len() > 30) {
            b = "";
            continue;
        }
        if (i == 45) {
            break;
        }
        total = total + b.len();
    }
    return total + b.len();
}
function arm(k: string): i32 {
    let cur: string = "";
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        let line: string = "l" + k;
        if (i % 3 == 0) {
            line = line + cur;
            cur = line;
        } else if (i % 3 == 1) {
            cur = line;
        } else {
            cur = "o";
        }
        total = total + cur.len();
        i = i + 1;
    }
    return total;
}
function arrs(k: string): i32 {
    let b: i32[] = [];
    let total: i32 = 0;
    let i: i32 = 0;
    while (i < 50) {
        let a: i32[] = b.append(k.len());
        b = a;
        total = total + b.len();
        i = i + 1;
    }
    return total;
}
function early(k: string, stop: i32): i32 {
    let b: string = "";
    let i: i32 = 0;
    while (i < 50) {
        let a: string = "e" + k + b;
        b = a;
        if (i == stop) {
            return b.len();
        }
        i = i + 1;
    }
    return b.len();
}
function viewed(k: string): i32 {
    let prev: i32[] = [];
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < 3) {
        let src: i32[] = [k.len(), 2, 3];
        let v: i32[] = src;
        prev = src;
        prev = [k.len()];
        let w: i32[] = [100, 200, 300];
        n = n + v[0] + prev.len() + w.len();
        i = i + 1;
    }
    return n;
}
function main(): i32 {
    let bad: i32 = 0;
    if (body("7") != 662) { bad = bad + 1; }
    if (arm("7") != 100) { bad = bad + 2; }
    if (arrs("7") != 1275) { bad = bad + 4; }
    if (early("7", 10) != 22) { bad = bad + 8; }
    if (viewed("7") != 15) { bad = bad + 16; }
    return bad + __rc_underflow_count();
}
