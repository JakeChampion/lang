import "std/i32";
import "std/string";

function parse_positive(s: string): Result[i32, string] {
  match (i32.parse_i32(s.trim())) {
    Ok(n) => {
      if (n < 0) {
        return Err("negative");
      }
      return Ok(n);
    },
    Err(_) => {
      return Err("not a number");
    }
  }
}

function main(): i32 {
  match (parse_positive("nope")) {
    Ok(_) => {
      return 1;
    },
    Err(msg) => {
      if (msg == "not a number") {
        return 42;
      }
      return 2;
    }
  }
}
