import "std/option";


function pos(x: i32): boolean { return x > 0; }
function main(): i32 {
    let a: Option[i32] = Some(7);
    let b: Option[i32] = Some(0 - 3);
    let n: Option[i32] = None;
    let r: i32 = 0;
    if (a.is_none_or(pos)) { r = r + 10; }
    if (b.is_none_or(pos)) { r = r + 1; }
    if (n.is_none_or(pos)) { r = r + 32; }
    return r;
}
