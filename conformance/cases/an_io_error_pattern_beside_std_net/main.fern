// std/net declares NetError.Other beside IoError's Other. An arm matching an
// IoError names IoError's, at the top level and nested under Err (#10922).
import "std/net";

function classify(e: IoError): i32 {
  match (e) {
    Other(op, msg, n) => {
      return op.len() + msg.len() + n;
    },
    NotFound(p) => {
      return 100;
    },
    _ => {
      return 1;
    }
  }
}

function wrapped(r: Result[i32, IoError]): i32 {
  match (r) {
    Err(Other(op, msg, n)) => {
      return 20;
    },
    Err(NotFound(p)) => {
      return 40;
    },
    _ => {
      return 1;
    }
  }
}

function main(): i32 {
  let e: IoError = IoError.Other("open", "boom", 0);
  let r: Result[i32, IoError] = Err(IoError.Other("a", "b", 0));
  return classify(e) + wrapped(r);
}
