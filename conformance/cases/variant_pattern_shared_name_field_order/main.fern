// Two enums declare the variant Rect with fields in different orders. A
// record pattern binds each field by the declaration of the enum it matches.
enum A {
  Rect { w: i32, h: i32 },
  NoA,
}

enum B {
  Rect { h: string, w: string },
  NoB,
}

function b(x: B): string {
  return match (x) {
    Rect { w, h } => w + h,
    NoB => "",
  };
}

function a(x: A): i32 {
  return match (x) {
    Rect { w, h } => w * 10 + h,
    NoA => 0,
  };
}

function main(): i32 {
  print(b(B.Rect("h", "w")));
  print(a(A.Rect(1, 2)).to_string());
  return 0;
}
