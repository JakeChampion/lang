// spec: AL-02











import "std/i32";
import "std/i64";
import "std/string";

function grow(n: i32): string[] {
    let out: string[] = [];
    for i in 0..n {
        out = out.append("abcdefgh" + i.to_string());
    }
    return out;
}

function main(): i32 {
    let b0: i64 = __heap_bump_bytes();
    let a: string[] = grow(50);
    let b1: i64 = __heap_bump_bytes();
    let b: string[] = grow(100);
    let b2: i64 = __heap_bump_bytes();

    print(a.len().to_string());
    print(b.len().to_string());
    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
