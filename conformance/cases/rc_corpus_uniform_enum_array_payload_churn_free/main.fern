






import "core/int";
enum E { A(i32[]), B(i32[]) }
function mk(n: i32): E { return A([n, n + 1]); }
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let e: E = mk(i);
        match (e) { A(a) => { acc = acc + a[1]; }, B(b) => { acc = acc + b[0]; } }
        i = i + 1;
    }
    return (acc - 5050) + __rc_underflow_count();
}
