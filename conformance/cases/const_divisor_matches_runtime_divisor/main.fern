// Each division by a literal must agree with the same division by a divisor
// read at run time, which no backend can strength-reduce.
function mix(h: u64, v: u64): u64 {
  return (h ^ v) * 1099511628211u64;
}

function run_i32(xs: i32[], ds: i32[]): u64 {
  let h: u64 = 14695981039346656037u64;
  let bad: i32 = 0;
  let i: i32 = 0;
  while (i < xs.len()) {
    let x: i32 = xs[i];
    if (x / 0 != x / ds[0] || x % 0 != x % ds[0]) {
      if (bad < 8) {
        print("i32 " + x.to_string() + " / 0");
      }
      bad = bad + 1;
    }
    h = mix(mix(h, (x / 0) as u64), (x % 0) as u64);
    if (x / 1 != x / ds[1] || x % 1 != x % ds[1]) {
      if (bad < 8) {
        print("i32 " + x.to_string() + " / 1");
      }
      bad = bad + 1;
    }
    h = mix(mix(h, (x / 1) as u64), (x % 1) as u64);
    if (x / (0 - 1) != x / ds[2] || x % (0 - 1) != x % ds[2]) {
      if (bad < 8) {
        print("i32 " + x.to_string() + " / -1");
