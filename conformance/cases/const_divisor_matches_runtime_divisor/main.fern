      bad = bad + 1;
    }
    h = mix(mix(h, (x / (0 - 1)) as u64), (x % (0 - 1)) as u64);
    if (x / 2 != x / ds[3] || x % 2 != x % ds[3]) {
      if (bad < 8) {
        print("i32 " + x.to_string() + " / 2");
      }
      bad = bad + 1;
    }
    h = mix(mix(h, (x / 2) as u64), (x % 2) as u64);
