import "std/regex";
import "std/result";

function main(): i32 {
  let r: i32 = 0;

  let m: regex.Captures = require_caps({ let __checked_regex_5: regex.Regex = match (regex.compile("(\\d+)-(\\d+)")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_5.captures("order 123-456 shipped") });
  if (require_regex_text(match (m.group(1)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "123" && require_regex_text(match (m.group(2)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "456") {
    r = r + 1;
  }
  if (require_regex_text(match (m.group(0)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "123-456" && at(m.group_start(0), 6) && at(m.group_end(0), 13)) {
    r = r + 2;
  }
  if (m.group_count() == 2) {
    r = r + 4;
  }

  let absent: regex.Captures = require_caps({ let __checked_regex_4: regex.Regex = match (regex.compile("a(bc)?d")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_4.captures("ad") });
  if (!absent.has_group(1) && match (absent.group(1)) { Ok(None()) => true, _ => false }) {
    r = r + 8;
  }
  let present: regex.Captures = require_caps({ let __checked_regex_3: regex.Regex = match (regex.compile("a(bc)?d")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_3.captures("abcd") });
  if (present.has_group(1) && require_regex_text(match (present.group(1)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "bc") {
    r = r + 16;
  }

  let alt: regex.Captures = require_caps({ let __checked_regex_2: regex.Regex = match (regex.compile("gr(a|e)y")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_2.captures("say grey") });
  if (require_regex_text(match (alt.group(1)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "e") {
    r = r + 32;
  }

  // quantified nested groups report the LAST iteration's spans
  let nest: regex.Captures = require_caps({ let __checked_regex_1: regex.Regex = match (regex.compile("((a|b)c)+")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_1.captures("acbc") });
  if (require_regex_text(match (nest.group(0)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "acbc" && require_regex_text(match (nest.group(1)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "bc" && require_regex_text(match (nest.group(2)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "b") {
    r = r + 64;
  }

  // greedy quantifiers: the left group takes as much as it can
  let greedy: regex.Captures = require_caps({ let __checked_regex_0: regex.Regex = match (regex.compile("(a+)(a+)")) { Ok(__compiled) => __compiled, Err(__error) => { eprint(__error.to_string()); return 98; } }; __checked_regex_0.captures("aaaa") });
  if (require_regex_text(match (greedy.group(1)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "aaa" && require_regex_text(match (greedy.group(2)) { Ok(__value) => __value, Err(__error) => { eprint(__error.to_string()); return 98; } }) == "a") {
    r = r + 128;
  }

  return r;
}

// require_caps is the match, exiting 1 when there is none.
function require_caps(result: Option[regex.Captures]): regex.Captures {
  if let Some(c) = result {
    return c;
  }
  exit(1);
  return regex.Captures { text: "", starts: [], ends: [], names: [] };
}

function at(o: Option[i32], want: i32): boolean {
  if let Some(v) = o {
    return v == want;
  }
  return false;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
