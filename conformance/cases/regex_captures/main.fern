




import "std/regex";

function main(): i32 {
  let r: i32 = 0;

  let m: regex.RCaps = require_caps(regex.regex_captures("(\\d+)-(\\d+)", "order 123-456 shipped"));
  if (require_regex_text(m.group(1)) == "123" && require_regex_text(m.group(2)) == "456") {
    r = r + 1;
  }
  if (require_regex_text(m.group(0)) == "123-456" && at(m.group_start(0), 6) && at(m.group_end(0), 13)) {
    r = r + 2;
  }
  if (m.group_count() == 2) {
    r = r + 4;
  }

  let absent: regex.RCaps = require_caps(regex.regex_captures("a(bc)?d", "ad"));
  if (!absent.has_group(1) && require_regex_text(absent.group(1)) == "") {
    r = r + 8;
  }
  let present: regex.RCaps = require_caps(regex.regex_captures("a(bc)?d", "abcd"));
  if (present.has_group(1) && require_regex_text(present.group(1)) == "bc") {
    r = r + 16;
  }

  let alt: regex.RCaps = require_caps(regex.regex_captures("gr(a|e)y", "say grey"));
  if (require_regex_text(alt.group(1)) == "e") {
    r = r + 32;
  }


  let nest: regex.RCaps = require_caps(regex.regex_captures("((a|b)c)+", "acbc"));
  if (require_regex_text(nest.group(0)) == "acbc" && require_regex_text(nest.group(1)) == "bc" && require_regex_text(nest.group(2)) == "b") {
    r = r + 64;
  }


  let greedy: regex.RCaps = require_caps(regex.regex_captures("(a+)(a+)", "aaaa"));
  if (require_regex_text(greedy.group(1)) == "aaa" && require_regex_text(greedy.group(2)) == "a") {
    r = r + 128;
  }

  return r;
}


function require_caps(result: Option[regex.RCaps]): regex.RCaps {
  if let Some(c) = result {
    return c;
  }
  exit(1);
  return regex.RCaps { text: "", starts: [], ends: [], names: [] };
}

function at(o: Option[i32], want: i32): boolean {
  if let Some(v) = o {
    return v == want;
  }
  return false;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
