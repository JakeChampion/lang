// A `use` callback returns what the callee's callback slot returns, not what
// the enclosing function does: the rest of `a` is the `(i32) => dyn Shape`
// `mk` takes, so its `return` boxes a Sq into the dyn, where the enclosing
// i32 would refuse it.
trait Shape {
  function area(self: Self): i32;
}

struct Sq { s: i32 }

impl Shape for Sq {
  function area(self: Sq): i32 {
    return self.s * self.s;
  }
}

function mk(n: i32, k: (i32) => dyn Shape): i32 {
  return k(n).area();
}

function a(): i32 {
  use v <- mk(3);
  return Sq { s: v };
}

function main(): i32 {
  return a();
}
