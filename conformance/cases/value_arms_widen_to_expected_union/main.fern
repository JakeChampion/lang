import "std/i32";

// The arms of a value `match` or `if` are different members of a union.
// Where a union is expected (a return type, a `let` annotation, a
// parameter, an assignment), each arm widens to it.

struct Circle { r: i32 }
struct Square { side: string }
type Shape = Circle | Square;

function name(sh: Shape): string {
  match (sh) {
    Circle(c) => {
      return "circle " + c.r.to_string();
    },
    Square(q) => {
      return "square " + q.side;
    }
  }
}

function match_return(k: i32): Shape {
  return match (k) {
    0 => Circle { r: 1 },
    _ => Square { side: "two" },
  };
}

function if_return(b: boolean): Shape {
  return if (b) { Circle { r: 3 } } else { Square { side: "four" } };
}

function chain_return(k: i32): Shape {
  return if (k == 0) {
    Circle { r: 5 }
  } else if (k == 1) {
    let side: string = "six";
    Square { side: side }
  } else {
    match (k) { 2 => Circle { r: 7 }, _ => Square { side: "eight" } }
  };
}

function flip(sh: Shape): Shape {
  return match (sh) {
    Circle(c) => Square { side: c.r.to_string() },
    Square(q) => Circle { r: q.side.len() },
  };
}

struct Key { n: i32 }

function tuple_return(p: (i32, i32)): Shape {
  return match (p) { (0, _) => Circle { r: 22 }, _ => Square { side: "twenty-three" } };
}

function struct_return(key: Key): Shape {
  return match (key) { Key { n: 0 } => Square { side: "twenty-four" }, _ => Circle { r: 25 } };
}

function main(): i32 {
  let k: i32 = 0;
  while (k < 2) {
    let m: Shape = match (k) { 0 => Circle { r: 10 }, _ => Square { side: "eleven" } };
    let i: Shape = if (k == 0) { Square { side: "twelve" } } else { Circle { r: 13 } };
    let held: Shape = Circle { r: 14 };
    let mixed: Shape = match (k) { 0 => held, _ => Square { side: "fifteen" } };
    print("return " + name(match_return(k)) + ", " + name(if_return(k == 0)) + ", " + name(chain_return(k + 1)) + ", " + name(chain_return(k + 2)));
    print("let " + name(m) + ", " + name(i) + ", " + name(mixed));
    print("arg " + name(match (k) { 0 => Circle { r: 16 }, _ => Square { side: "seventeen" } }) + ", " + name(if (k == 0) { Square { side: "eighteen" } } else { Circle { r: 19 } }));
    let a: Shape = Circle { r: 0 };
    a = if (k == 0) { Square { side: "twenty" } } else { Circle { r: 21 } };
    print("assign " + name(a) + ", flip " + name(flip(m)));
    let t: Shape = match ((k, 1)) { (0, _) => Square { side: "twenty-six" }, _ => Circle { r: 27 } };
    a = match (Key { n: k }) { Key { n: 0 } => Circle { r: 28 }, _ => Square { side: "twenty-nine" } };
    print("tuple " + name(tuple_return((k, 0))) + ", " + name(t) + ", " + name(match ((k, 2)) { (0, _) => Circle { r: 30 }, _ => Square { side: "thirty-one" } }));
    print("struct " + name(struct_return(Key { n: k })) + ", " + name(a));
    k = k + 1;
  }
  return 0;
}
