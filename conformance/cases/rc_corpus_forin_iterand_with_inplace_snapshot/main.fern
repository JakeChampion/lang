











function mkstr(p: string): string { return p + "!"; }
function snap(): i32 {
    let xs: string[] = [mkstr("aaaaaaaaaa"), mkstr("")];
    let n: i32 = 0;
    for s in xs {
        n = n + s.len();
        xs = xs.with(0, mkstr("zz"));
    }
    return (n - 12) + (xs[0].len() - 3);
}
function main(): i32 {
    let c: i32 = snap();
    return c + __rc_underflow_count();
}
