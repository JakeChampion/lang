








struct Pt { x: i32, y: i32 }

enum Box { Val(i32[]), Empty }

function head(b: Box): i32 {
    match (b) {
        Val(xs) => { return xs[0]; },
        Empty => { return 0; }
    }
}

function churn(n: i32): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < n) {

        let row: i32[] = [i, i * 2, i * 3];

        let p: Pt = Pt { x: i, y: i + 1 };

        let b: Box = Val([i, i + 5]);
        acc = acc + (row[0] + row[1] + row[2]) - (i * 6);
        acc = acc + (p.y - p.x) - 1;
        acc = acc + head(b) - i;
        i = i + 1;
    }
    return acc;
}

function main(): i32 {



    return churn(300) + 42;
}
