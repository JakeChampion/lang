// The branches of an if-expression must have one type. Box[i32] and
// Box[string] have one name, but different type arguments.

struct Box[T] { v: T }

function main(): i32 {
  let a: Box[i32] = Box { v: 1 };
  let b: Box[string] = Box { v: "x" };
  let c = if (a.v > 0) { a } else { b };
  return 0;
}
