



struct Pt { x: i32, y: i32 }
function apply_o(f: (i32) => Option[i32], x: i32): Option[i32] { return f(x); }
function apply_p(f: (i32) => Pt, x: i32): Pt { return f(x); }
function half(x: i32): Option[i32] { if (x % 2 == 0) { return Some(x / 2); } return None; }
function mk(x: i32): Pt { return Pt { x: x, y: x + 1 }; }

function main(): i32 {
    let o: Option[i32] = apply_o(half, 10);
    let p: Pt = apply_p(mk, 7);
    let r: i32 = 0;
    match (o) { Some(v) => { r = r + v; }, None => { r = r + 100; } }
    r = r + p.x + p.y;
    let none: Option[i32] = apply_o(half, 7);
    match (none) { Some(v) => { r = r + v; }, None => { r = r + 1; } }
    return r;
}
