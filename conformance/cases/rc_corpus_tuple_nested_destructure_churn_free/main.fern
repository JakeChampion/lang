








import "core/int";
function mk(seed: i32): i32 {
    let t: (i32, (i32, i32)) = (seed, (seed + 1, seed + 2));
    let (a, b) = t;
    let (c, d) = b;
    return a + c + d;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 200) { total = total + mk(k); k = k + 1; }
    return (total - 60300) + __rc_underflow_count();
}
