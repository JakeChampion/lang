












struct P { xs: i32[], s: string }

function w(s: string): string { return s + ""; }

function round(base: P, i: i32): i32 {
    let t: i32 = 0;
    if (i % 2 == 0) { let v: P = P { xs: [i, i + 1], s: w("p") }; t = t + v.xs.len(); }
    if (i % 2 == 1) { let v: P = base; t = t + v.xs.len(); }
    return t;
}

function main(): i32 {
    let base: P = P { xs: [1, 2, 3], s: w("b") };
    let t: i32 = 0;
    let i: i32 = 0;
    while (i < 100) { t = t + round(base, i); i = i + 1; }
    if (__rc_underflow_count() != 0) { return 99; }

    if (base.xs.len() != 3) { return 98; }
    return t % 200;
}
