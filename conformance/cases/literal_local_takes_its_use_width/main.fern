


function main(): i32 {
    let t: i64 = 0 as i64;
    for i in 0..64 {
        let bits: i64 = (1 as u64 << i) as i64;
        t = t + bits;
    }
    if (t != -1i64) { return 1; }


    let x = 2147483647;
    x = x + 1;
    let wide: i64 = x;
    if (wide != 2147483648i64) { return 2; }


    let k = 7;
    let m = k + 1;
    let shifted: u64 = (1 as u64) << m;
    if (shifted != 256u64) { return 3; }
    if (k != 7) { return 4; }


    let n = 2147483647;
    n = n + 1;
    if (n >= 0) { return 5; }
    return 0;
}
