

enum Shape { Run(i32), Pair }

function branches(take: boolean): i32 {
    let s: i32 = 0;
    if (take) {
        for i in 0..4 { s = s + i; }
    } else {
        for j in 1..=3 { s = s + j; }
    }
    return s;
}

function arms(sh: Shape): i32 {
    let s: i32 = 0;
    match (sh) {
        Shape.Run(n) => { for i in 0..n { s = s + i; } },
        Shape.Pair => { for k in 1..=2 { s = s + 1; } },
    }
    return s;
}

function deferred(): i32 {
    let t: i32 = 0;
    loop {
        defer { for k in 0..3 { t = t + 1; } }
        break;
    }
    return t;
}

function main(): i32 {
    return branches(true) + branches(false) + arms(Shape.Run(4)) + arms(Shape.Pair) + deferred();
}
