// target_os() is the -target's environment, never the compiler's host: it is
// a string literal before the check, so the darwin arm below is pruned from
// the binary and only the linux arm runs. Both native legs of the runner
// compile for Linux; the wasm leg's answer is target_os_wasi.
import "core/int";

function main(): i32 {
    if (target_os() == "darwin") {
        print("darwin build");
    } else {
        print("not a darwin build");
    }
    if (target_os() != "linux") {
        print("not linux");
    }
    print(target_os());
    return 0;
}
