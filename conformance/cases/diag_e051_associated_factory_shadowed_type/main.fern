// spec: RH-27
trait Make {
  function make(): Self;
}

struct Handle { fd: i32 }

function (own h: Handle) close(): i32 {
  return h.fd;
}

struct Factory { make: () => Handle }

function take(own value: Handle): i32 {
  return value.close();
}

function shadowed[T: Make](T: Factory): i32 {
  return take(T.make());
}

function main(): i32 {
  return 0;
}
