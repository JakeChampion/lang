




import "std/i32";

enum Shape[T] { Circle(i32), Blank }
enum Pair[T] { Two(i32, T), Lone }
enum Bag[T] { Items(T[]), Pairs((T, i32)), Count(i32), Empty }
enum Nest[T] { Wrap(Shape), Hole(T) }

struct Holder { s: Shape, k: i32 }

function area(s: Shape): i32 {
    match (s) {
        Circle(r) => { return r * r; },
        Blank => { return 0; }
    }
    return 0;
}

function make(n: i32): Shape {
    if (n > 0) {
        return Circle(n);
    }
    return Blank;
}

function second(p: Pair): i32 {
    match (p) {
        Two(a, _) => { return a; },
        Lone => { return 7; }
    }
    return 0;
}


function plus_one(p: Pair): i32 {
    return 1 + (match (p) { Two(_, b) => b, _ => 2 });
}

function size(b: Bag): i32 {
    match (b) {
        Items(xs) => { return xs.len(); },
        Pairs(p) => { return p.1; },
        Count(n) => { return n; },
        Empty => { return 0; }
    }
    return 0;
}

function unwrap(n: Nest): i32 {
    match (n) {
        Wrap(s) => { return area(s); },
        _ => { return 0 - 1; }
    }
    return 0;
}

function main(): i32 {
    let s: Shape = Circle(2);
    let shapes: Shape[] = [Circle(1), Blank, make(4)];
    let total: i32 = 0;
    for x in shapes {
        total = total + area(x);
    }
    let h: Holder = Holder { s: make(5), k: 1 };
    print(area(Circle(3)).to_string());
    print(area(s).to_string());
    print(total.to_string());
    print((area(h.s) + h.k).to_string());
    print(area(make(0)).to_string());
    print(second(Lone).to_string());
    print(plus_one(Lone).to_string());
    print((size(Count(6)) + size(Empty)).to_string());
    print(unwrap(Wrap(Circle(6))).to_string());
    return area(Circle(3));
}
