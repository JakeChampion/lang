










enum E { Aa(i32), Bb(i32), Cc(i32) }
struct P { x: i32, y: i32 }
struct P3 { x: i32, y: i32, z: i32 }


function or_head(e: E): i32 {
    if let Aa(v) | Bb(v) = e { return v; }
    return 20;
}

function main(): i32 {
    let total: i32 = 0;
    total = total + or_head(E.Aa(1));
    total = total + or_head(E.Bb(2));
    total = total + or_head(E.Cc(9));

    let p: P = P { x: 3, y: 4 };
    if let P { x, y } = p { total = total + x + y; }
    if let P { x: a, y: b } = p { total = total + a * 10 + b; }
    if let w @ P { x, y } = p { total = total + w.x + y; }

    let q: P3 = P3 { x: 5, y: 6, z: 7 };
    if let P3 { x, .. } = q { total = total + x; }

    return total;
}
