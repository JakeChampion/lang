







import "core/cmp";

@derive(cmp.Default) struct Box[T] { v: T, tag: i32 }

function main(): i32 {
    let a: Box[i32] = Box.default();
    let b: Box[string] = Box.default();
    let c: Box[boolean] = Box.default();
    let d: Box[i64] = Box.default();
    let e: Box[f64] = Box.default();

    let r: i32 = a.v + a.tag + b.v.len() + b.tag + c.tag + (d.v as i32) + 9;
    if (c.v) { r = r + 100; }
    if (e.v == (0.0 as f64)) { r = r + 1; }
    return r;
}
