








struct Holder { name: string }
function mk(seed: i32): i32 {
    let h: Holder = Holder { name: "a literal value" };
    return h.name.len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 200) { total = total + mk(k); k = k + 1; }
    return (total - 3000) + __rc_underflow_count();
}
