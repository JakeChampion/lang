import "core/int";
import "std/i32";




function sum(s: [i32]): i32 {
    let t: i32 = 0;
    for x in s { t = t + x; }
    return t;
}

function main(): i32 {
    let a: i32[] = [10, 20, 30, 40, 50];
    let s: [i32] = a[1:4];
    print((s.len()).to_string());
    print((s[0]).to_string());
    print((s[2]).to_string());
    print((sum(s)).to_string());

    let s2: [i32] = s[0:2];
    print((s2.len()).to_string());

    let empty: [i32] = a[2:2];
    print((empty.len()).to_string());

    let strs: string[] = ["ab", "cde", "f"];
    let ss: [string] = strs[0:2];
    print((ss[1].len()).to_string());


    if (s.len() != 3) { return 11; }
    if (s[1] != 30) { return 12; }
    if (sum(a[0:5]) != 150) { return 13; }
    if (a[2:2].len() != 0) { return 14; }
    if (s[s.len() - 1] != 40) { return 15; }
    return 0;
}
