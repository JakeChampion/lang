













struct Bag { sink: Cell[string] }

function main(): i32 {
    let c: Cell[string] = cell_new("");
    c.set(c.get() + "one;");
    c.set(c.get() + "two;");
    c.set(c.get() + "three;");
    if (c.get() != "one;two;three;") { return 1; }

    let b: Bag = Bag { sink: cell_new("") };
    b.sink.set(b.sink.get() + "one;");
    b.sink.set(b.sink.get() + "two;");
    b.sink.set(b.sink.get() + "three;");
    if (b.sink.get() != "one;two;three;") { return 2; }




    let d: Cell[string] = cell_new("");
    let piece: string = "x";
    d.set(d.get() + piece + ";");
    d.set(d.get() + piece + ";");
    d.set(d.get() + piece + ";");
    if (d.get() != "x;x;x;") { return 3; }

    return 42;
}
