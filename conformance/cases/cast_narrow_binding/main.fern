





function main(): i32 {
    let v: i32 = 250 + 10;


    let a: u8 = v as u8;
    if (a as i32 != 4) { print("FAIL annotated-binding"); return 11; }


    let b = v as u8;
    if (b as i32 != 4) { print("FAIL inferred-binding"); return 12; }



    if (((v as u8) as i32) != 4) { print("FAIL expression"); return 13; }


    let c: u8 = 300 as i32 as u8;
    if (c as i32 != 44) { print("FAIL other-value"); return 14; }


    let d: u8 = 0;
    d = v as u8;
    if (d as i32 != 4) { print("FAIL reassign"); return 15; }

    print("OK");
    return 0;
}
