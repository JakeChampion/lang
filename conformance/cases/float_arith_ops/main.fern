// spec: FS-07
import "std/f64";



function scaled(n: i32): f64 {
    return (n as f64) * 0.5;
}

function main(): i32 {
    let a: f64 = scaled(15);
    let b: f64 = scaled(5);
    let d: f64 = a - b;
    let neg: f64 = -d;

    let flags: i32 = 0;
    if (a != b) { flags = flags + 1; }
    if (b <= a) { flags = flags + 2; }
    if (neg <= b) { flags = flags + 4; }
    if (a <= a) { flags = flags + 8; }

    print(d.to_string());
    print(neg.to_string());
    return flags;
}
