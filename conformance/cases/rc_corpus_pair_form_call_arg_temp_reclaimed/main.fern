



















import "std/string";
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 200) {
        match ("  12345678  ".trim().parse_int()) {
            Some(n) => { acc = acc + (n / 12345678); },
            None => { }
        }
        let o: Option[i32] = "  87654321  ".trim().parse_int();
        match (o) {
            Some(n) => { acc = acc + (n / 87654321); },
            None => { }
        }
        i = i + 1;
    }
    return (acc - 400) + __rc_underflow_count();
}
