









import "core/int";
function mk(n: i32): Option[i32[]] { return Some([n, n + 1]); }
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let o: Option[i32[]] = mk(i);
        match (o) { Some(a) => { acc = acc + a[1]; }, None => { acc = acc + 0; } }
        i = i + 1;
    }
    return (acc - 5050) + __rc_underflow_count();
}
