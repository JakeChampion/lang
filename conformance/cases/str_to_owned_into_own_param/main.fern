











import "std/string";
import "std/i32";

struct Box { name: string }

function consume(own s: string): i32 { return s.len(); }

function trimmed(s: string): string { return s.trim().to_owned(); }

function main(): i32 {
    let total: i32 = 0;
    for i in 0..8 {
        let src: string = "  item-" + i.to_string() + "  ";


        total = total + consume(src.trim().to_owned());
        total = total + src.len();


        let v: string = src.trim().to_owned();
        let b: Box = Box { name: src.trim().to_owned() };
        let arr: string[] = [trimmed(src)];
        if (v != b.name) { return 1; }
        if (arr[0] != v) { return 2; }
        if (v != "item-" + i.to_string()) { return 3; }
    }
    print(total.to_string());



    let a: string = "  keep me  ";
    let copy: string = a.trim().to_owned();
    a = "  something else  ";
    print(copy);
    print(a.trim().to_owned());
    return 0;
}
