// A match EXPRESSION whose arm body is just the name the arm binds. The
// result slot is sized before any arm is lowered, from each arm body's
// type — and the IR derives an identifier's type by NAME, against locals
// and params, neither of which a pattern binder is. So a bare binder body
// answered "no type", the slot fell back to i32, and a two-word `string`
// result was emitted through a one-word slot: the wasm module failed
// validation with `expected i32 but nothing on stack`, while the natives
// happened to survive it.
//
// A second arm whose body has a derivable type (a literal, a local) sizes
// the slot correctly and hides the defect, so every probe here keeps every
// arm body a bare binder.
//
// The tuple and payload-SUB-PATTERN spellings are the same rule reached
// through the desugars that route their arm values through a synthesised
// LOCAL rather than through `return`: the local was declared from the first
// arm's syntax, where a binder reads as i32, so a `string` or `i64` binder
// was stored into an i32 (#8657). Both halves are here because both are the
// same question — what type does a bare binder body have — asked of two
// desugars.
enum One { Only(string) }
enum Two { Left(string), Right(string) }
enum Res { Ok1(string), Err1(string) }
enum Wrap { Box(Res) }

function one_arm(): string {
    var o: One = Only("elem");
    return match (o) {
        Only(q) => q
    };
}

function two_arms(): string {
    var t: Two = Left("elem");
    return match (t) {
        Left(q) => q,
        Right(r) => r
    };
}

// Tuple scrutinee: the value local's declaration is what sizes the result.
function tuple_arm(): string {
    var t: (string, i32) = ("elem", 4);
    return match (t) {
        (q, n) => q
    };
}

// The same at 64-bit width rather than two words.
function tuple_arm_i64(): i64 {
    var t: (i64, i32) = (5000000000i64, 4);
    return match (t) {
        (q, n) => q
    };
}

// A tuple pattern nested inside a tuple pattern.
function nested_tuple_arm(): string {
    var t: (i32, (string, i32)) = (1, ("elem", 4));
    return match (t) {
        (a, (q, n)) => q
    };
}

// A payload SUB-pattern, which takes the flag-chain desugar.
function payload_sub_arm(): string {
    var w: Wrap = Box(Ok1("elem"));
    return match (w) {
        Box(Ok1(q)) => q,
        Box(Err1(r)) => r
    };
}

// The `@` whole-value binder names the SCRUTINEE, so its type is the one
// position the arm's own binding lists cannot supply.
function at_binder_arm(): One {
    var o: One = Only("elem");
    return match (o) {
        w @ Only(v) => w
    };
}

function unwrap_one(o: One): string {
    match (o) {
        Only(v) => { return v; }
    }
}

function main(): i32 {
    if (one_arm() != "elem") { return 1; }
    if (two_arms() != "elem") { return 2; }
    if (tuple_arm() != "elem") { return 3; }
    if (tuple_arm_i64() != 5000000000i64) { return 4; }
    if (nested_tuple_arm() != "elem") { return 5; }
    if (payload_sub_arm() != "elem") { return 6; }
    if (unwrap_one(at_binder_arm()) != "elem") { return 7; }
    return 0;
}
