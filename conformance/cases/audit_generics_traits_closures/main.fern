import "core/int";










function id[T](x: T): T { return x; }

struct Box[T] { v: T }
function (b: Box[i32]) get(): i32 { return b.v; }

trait Doubler { function dbl(self: Self): i32; }
impl Doubler for i32 { function dbl(self: Self): i32 { return self * 2; } }

function apply(f: (i32) => i32, x: i32): i32 { return f(x); }

function named_inc(x: i32): i32 { return x + 1; }

function sum_to(n: i32, acc: i32): i32 {
    if (n == 0) { return acc; }
    return sum_to(n - 1, acc + n);
}

function main(): i32 {

    if (id(42) != 42) { print("FAIL generic-fn"); return 11; }
    let box: Box[i32] = Box { v: 33 };
    if (box.v != 33 || box.get() != 33) { print("FAIL generic-struct"); return 12; }


    if ((21).dbl() != 42) { print("FAIL trait"); return 13; }


    let inc: (i32) => i32 = (x: i32): i32 => { return x + 1; };
    if (inc(41) != 42) { print("FAIL lambda"); return 14; }


    let n: i32 = 10;
    let addn: (i32) => i32 = (x: i32): i32 => { return x + n; };
    if (addn(5) != 15) { print("FAIL closure"); return 15; }


    let fv: (i32) => i32 = named_inc;
    if (fv(7) != 8) { print("FAIL fn-value"); return 16; }


    if (apply(inc, 100) != 101) { print("FAIL higher-order"); return 17; }


    if (sum_to(5000, 0) != 12502500) { print("FAIL tco"); return 18; }

    print("OK");
    return 0;
}
