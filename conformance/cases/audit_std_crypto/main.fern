import "core/int";
import "std/crypto";
import "std/hex";





function main(): i32 {
  if (hex.encode(crypto.sha256("abc".as_bytes())) != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") {
    print("FAIL abc");
    return 11;
  }
  if (hex.encode(crypto.sha256("".as_bytes())) != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") {
    print("FAIL empty");
    return 12;
  }
  print("OK");
  return 0;
}
