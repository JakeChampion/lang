// spec: AL-01


















import "core/int";
import "std/i32";
import "std/i64";
import "std/string";

struct Box { tag: string, n: i32 }

function (s: string) tail(n: i32): str {
    if (n <= 0) { return s; }
    let sLen: i32 = s.len();
    if (n >= sLen) { return ""; }
    return slice_unchecked(s, n, sLen);
}

function (b: Box) relabel(t: string): Box {
    if (t.len() == 0) { return b; }
    return Box { tag: t, n: b.n };
}

function rounds(n: i32): i32 {
    let t: i32 = 0;
    for i in 0..n {
        let base: string = "long-enough-payload-" + (i % 8).to_string();
        t = t + base.drop(2).len() + base.tail(4).to_owned().len();

        t = t + base.tail(0).len() + base.len();

        let b: Box = Box { tag: "start-tag-value", n: i % 8 };
        t = t + b.relabel("fresh-tag-value").tag.len();
        t = t + b.relabel("").tag.len() + b.tag.len();
    }
    return t;
}

function main(): i32 {
    let b0: i64 = __heap_bump_bytes();
    let x: i32 = rounds(50);
    let b1: i64 = __heap_bump_bytes();
    let y: i32 = rounds(100);
    let b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());

    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
