// spec: AL-01
//
// A source-declared receiver method whose result is consumed by another
// call — `base.drop(2).len()` — owns that result and must reclaim it.
// The reclaim gate rejected every `__`-prefixed callee that was not
// proven to return a fresh value, and a source method mangles to
// `__method_<Type>_<name>`, so an identity return anywhere in the body
// (`if (n <= 0) { return s; }`) disqualified the whole method and every
// materialised result was stranded. The builtin lowerings that gate is
// really about (`arr.push` / `m.set`) have no declaration at all, so
// they are excluded by not being user-declared.
//
// `tail(0)` and `keeps` are the controls on the is_unique gate: they
// take the identity path, so the result aliases a value the caller still
// owns and must survive being read afterwards. A reclaim that ignored
// the gate would free it here.
//
// The case prints the SHAPE, never a byte count — see
// docs/ALLOCATION-OBSERVABLE.md.
import "core/int";
import "std/i32";
import "std/i64";
import "std/string";

struct Box { tag: string, n: i32 }

function (s: string) tail(n: i32): str {
    if (n <= 0) { return s; }
    var sLen: i32 = s.len();
    if (n >= sLen) { return ""; }
    return s[n:sLen];
}

function (b: Box) relabel(t: string): Box {
    if (t.len() == 0) { return b; }
    return Box { tag: t, n: b.n };
}

function rounds(n: i32): i32 {
    var t: i32 = 0;
    for i in 0..n {
        var base: string = "long-enough-payload-" + (i % 8).to_string();
        t = t + base.drop(2).len() + base.tail(4).to_owned().len();
        // Identity path: the result aliases `base`, still live below.
        t = t + base.tail(0).len() + base.len();

        var b: Box = Box { tag: "start-tag-value", n: i % 8 };
        t = t + b.relabel("fresh-tag-value").tag.len();
        t = t + b.relabel("").tag.len() + b.tag.len();
    }
    return t;
}

function main(): i32 {
    var b0: i64 = __heap_bump_bytes();
    var x: i32 = rounds(50);
    var b1: i64 = __heap_bump_bytes();
    var y: i32 = rounds(100);
    var b2: i64 = __heap_bump_bytes();

    print(x.to_string());
    print(y.to_string());
    // Twice the work must not cost more fresh memory.
    if ((b2 - b1) > (b1 - b0)) { print("grows"); } else { print("flat"); }
    return 0;
}
