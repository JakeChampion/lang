import "core/int";









function main(): i32 {
    eprint("to-stderr");
    write("Hi");
    putchar(33);
    putchar(10);
    if ("abc".len() != 3) { print("FAIL len-str"); return 11; }
    let arr: i32[] = [1, 2, 3, 4];
    if (arr.len() != 4) { print("FAIL len-arr"); return 12; }
    print("done");
    return 0;
}
