










import "core/int";
import "std/string";
function cat(a: string, b: string): string { return a + b; }
function main(): i32 {
    let fresh: string = cat("aaaaaaaaa", "bbbbbbbb");
    let a: string[] = [fresh, "ccccccccccccccccc"];
    let keep: string = a[0];
    a = a.with(0, "ddddddddddddddddd");
    return (keep.len() + a[0].len() - 34) + __rc_underflow_count();
}
