// Direct output also carries the default formatter dependency before typing.
function main(): i32 {
  print(42 as i32);
  print(42 as i64);
  print(42 as u8);
  print(42 as u32);
  print(42 as u64);
  print(42 as usize);
  print(1.5 as f32);
  print(1.25 as f64);
  print(true);
  print('🦊');
  print("hello");
  return 0;
}
