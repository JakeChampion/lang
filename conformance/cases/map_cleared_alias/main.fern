





import "core/map";

function main(): i32 {
    let m: Map[string, i32] = map_new(8);
    m = m.insert("x", 10);
    m = m.insert("y", 20);
    if (m.len() != 2) { return 1; }

    let alias = m;
    m = m.cleared();
    if (m.len() != 0) { return 2; }
    if (m.contains("x")) { return 3; }
    if (alias.len() != 2) { return 4; }
    if (alias.get_or("x", 0) != 10) { return 5; }


    m = m.insert("z", 99);
    if (m.len() != 1) { return 6; }
    if (m.get_or("z", 0) != 99) { return 7; }


    let n: Map[i32, i32] = map_new(4);
    n = n.insert(7, 3);
    n = n.cleared();
    if (n.len() != 0) { return 8; }
    n = n.insert(7, 5);
    if (n.get_or(7, 0) != 5) { return 9; }

    return 42;
}
