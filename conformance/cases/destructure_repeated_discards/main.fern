// A `let` destructure reads the shared pattern grammar (#5356); `_` is renamed
// per occurrence, so a pattern can discard more than one slot.
//
// Repeated discards across and within patterns: each `_` gets its
// own internal name, so none of these redeclare anything.
// exit: 1 + 4 + 8
struct P { x: i32, y: i32 }
function main(): i32 {
  let (a, _) = (1, 2);
  let (_, b) = (3, 4);
  let (_, _) = (5, 6);
  let P { x: _, y } = P { x: 7, y: 8 };
  return a + b + y;
}
