// spec: ML-04
// The front end accepts this program: it does not follow a view that a
// reassignment puts in a local. The lowering follows each assignment in its
// order, and it refuses the view of `owned` in the returned map.
import "core/map";
import "std/string";

function local_view(): Map[string, str] {
  let owned = "hello" + "!";
  let m: Map[string, str] = map_new(4);
  m = m.insert("a", owned.trim());
  return m;
}

function main(): i32 {
  return local_view().len();
}
