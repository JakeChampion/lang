import "core/map";





function main(): i32 {

    let m: Map[i32, i32] = map_new(8);
    m = m.insert(7, 40);
    m = m.insert(11, 99);
    m = m.insert(7, 2);
    let v7: i32 = m.get_or(7, -1);


    let existed: boolean = m.contains(11);
    let m2 = m.remove(11);
    if (!existed) { return 91; }
    if (m2.contains(11)) { return 92; }
    let total: i32 = v7 + m2.len();


    let a: i32[] = [];
    a = a.append(10);
    a = a.append(20);
    a = a.with(0, 30);
    total = total + a[0] + a[1] + a.len();


    let m3: Map[i32, i32] = map_new(4);
    m3 = m3.insert(1, 1);
    m3 = m3.cleared();
    total = total + m3.len();

    return total;
}
