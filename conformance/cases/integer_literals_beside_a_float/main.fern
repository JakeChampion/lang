// An integer-literal operand of a typed float takes the float type before it
// is evaluated, as a whole integer-literal initializer of a float does. So
// 1 / 2 beside a float is 0.5, not 0, and -0 keeps its sign.
function main(): i32 {
    let f: f64 = 1.5;
    let q: f64 = 0.25;
    let a: f64 = f + 1 / 2;
    let b: f64 = 1 / 2 + f;
    let c: f64 = f * (3 / 2);
    let d: f64 = f * 2;
    let e: f64 = 2 * f;
    print(f"{a} {b} {c} {d} {e}");
    print(f"{-2 < q} {0 - 2 < q} {1 / 2 > q} {q < 1 / 2} {(q + 1) < 3}");
    let z: f64 = f * -0;
    if (1.0 / z < 0.0) {
        print("negative zero from -0");
    }
    let y: f64 = (0 / -1) * f;
    if (1.0 / y < 0.0) {
        print("negative zero from 0 / -1");
    }
    return 0;
}
