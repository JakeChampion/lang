








import "core/int";
struct Item { tags: i32[] }
function main(): i32 {
    let acc: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        let it: Item = Item { tags: [i, i + 1] };
        let f = (d: i32): i32 => { return it.tags[1] + d; };
        acc = acc + f(0);
        i = i + 1;
    }
    return (acc - 5050) + __rc_underflow_count();
}
