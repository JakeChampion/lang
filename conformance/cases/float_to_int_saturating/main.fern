// spec: FS-01
// spec: FS-02
// spec: FS-03
















import "std/i32";
import "std/i64";

function fid(x: f64): f64 { return x; }

function main(): i32 {
    let zero: f64 = fid(0.0);
    let nan: f64 = zero / zero;
    let inf: f64 = fid(1.0) / zero;

    print((nan as i32).to_string());
    print((inf as i32).to_string());
    print(((0.0 - inf) as i32).to_string());
    print((fid(3.9) as i32).to_string());
    print((fid(0.0 - 3.9) as i32).to_string());
    print((fid(0.0) as i32).to_string());


    print(((nan as u32) as i64).to_string());
    print(((fid(0.0 - 1.0) as u32) as i64).to_string());
    print(((inf as u32) as i64).to_string());




    print(((nan as u8) as i32).to_string());
    print(((fid(0.0 - 1.0) as u8) as i32).to_string());
    print(((fid(0.0 - 300.0) as u8) as i32).to_string());
    print(((fid(300.7) as u8) as i32).to_string());
    print(((fid(255.9) as u8) as i32).to_string());
    print(((inf as u8) as i32).to_string());
    return 0;
}
