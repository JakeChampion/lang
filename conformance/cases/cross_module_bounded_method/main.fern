





import "./lib";

struct Item { id: i32 }
impl lib.Render for Item {
    function render(self: Self): string {
        if (self.id == 1) { return "a"; }
        if (self.id == 2) { return "bb"; }
        return "ccc";
    }
}

function main(): i32 {
    let items: Item[] = [Item { id: 1 }, Item { id: 2 }, Item { id: 3 }];
    return items.render_all().len();
}
