// The function die never returns, but a local named die hides it. The call
// reaches the local, which returns, so the local that moves into the own
// parameter is read again after the branch.
struct W { d: i32[], n: i32 }

function die(code: i32): void {
  exit(code);
}

function eat(own w: W): i32 {
  return w.n + w.d.len();
}

function main(): i32 {
  let w: W = W { d: [1], n: 1 };
  let die = (k: i32): void => {};
  if (w.n > 5) {
    die(eat(w));
  }
  return w.n;
}
