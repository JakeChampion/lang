




import "core/int";
import "std/string";
struct Buf { data: i32[], n: i32 }
function mk(n: i32): Buf { return Buf { data: [n, n + 1, n + 2], n: n }; }
function main(): i32 {
    let b: Buf = mk(7);
    let c: i32 = 0;
    while (c < 200) {
        let junk: i32[] = [c, c];
        c = c + 1;
    }
    return (b.data[2] - 9) + (b.data.len() - 3) + __rc_underflow_count();
}
