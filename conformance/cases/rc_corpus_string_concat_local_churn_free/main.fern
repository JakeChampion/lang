











import "core/int";
import "std/string";
function mk(seed: i32): i32 {
    let pre: string = "v";
    let s: string = pre + "x";
    let n: i32 = s.len();
    let s2: string = s;
    return n + s2.len();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 300) { total = total + mk(k); k = k + 1; }
    return (total - 1200) + __rc_underflow_count();
}
