

















function apply(f: (i32) => i32, v: i32): i32 {
    return f(v);
}

function run(f: (i32) => void, v: i32): void {
    f(v);
}

function give(x: i32, cb: (i32) => i32): i32 {
    return cb(x);
}

enum Opt { Has(i32), Nil }

function main(): i32 {

    if (apply((x: i32) => x * 2, 4) != 8) {
        return 10;
    }

    let single = (x: i32) => { return x * 2; };
    if (apply(single, 4) != 8) {
        return 11;
    }

    let stmts = (x: i32) => { let y: i32 = x + 1; return y * 2; };
    if (apply(stmts, 3) != 8) {
        return 12;
    }

    let branch = (x: i32) => { if (x > 0) { return x; } return 0 - x; };
    if (apply(branch, 0 - 8) != 8) {
        return 13;
    }

    let tail = (x: i32) => { let y: i32 = x + 1; y * 2 };
    if (apply(tail, 3) != 8) {
        return 14;
    }

    let typed = (x: i32): i32 => { return x * 2; };
    if (apply(typed, 4) != 8) {
        return 15;
    }

    let sink: i32 = 0;
    let log = (x: i32) => { sink = sink + x * 2; };
    run(log, 4);
    if (sink != 8) {
        return 16;
    }

    let logged = (x: i32): void => { sink = sink + x; };
    run(logged, 2);
    if (sink != 10) {
        return 17;
    }

    let nothing = (x: i32) => {};
    run(nothing, 99);
    if (sink != 10) {
        return 18;
    }


    let classify = (x: i32) => {
        match (x) {
            0 => { return 100; },
            _ => {}
        }
        return x * 2;
    };
    if (apply(classify, 4) != 8) {
        return 19;
    }
    if (apply(classify, 0) != 100) {
        return 20;
    }

    let branchy = (x: i32) => {
        if (x > 0) { return x * 2; } else { return 0 - x; }
    };
    if (apply(branchy, 4) != 8) {
        return 21;
    }
    if (apply(branchy, 0 - 8) != 8) {
        return 22;
    }


    let bound = (): i32 => {
        use n <- give(41);
        return n + 1;
    };
    if (bound() != 42) {
        return 23;
    }
    let unwrapped = (): i32 => {
        let o: Opt = Nil;
        let Has(v) = o else { return 7; };
        return v;
    };
    if (unwrapped() != 7) {
        return 24;
    }

    let pick = (x: i32) => {
        let y: i32 = x + 1;
        match (y) { 0 => 100, _ => y * 2 }
    };
    if (apply(pick, 3) != 8) {
        return 25;
    }
    return 0;
}
