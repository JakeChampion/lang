import "./shadowlib";




function main(): i32 {
    if (shadowlib.unshadowed() != 100) { return 0; }
    let r: i32 = 0;
    if (shadowlib.tuple_binder() == 7) { r = r + 1; }
    if (shadowlib.nested_tuple_binder() == 7) { r = r + 2; }
    if (shadowlib.variant_in_tuple_binder() == 7) { r = r + 4; }
    if (shadowlib.payload_subpattern_binder() == 7) { r = r + 8; }
    if (shadowlib.match_expr_binder() == 7) { r = r + 16; }
    if (shadowlib.variant_binder() == 7) { r = r + 32; }
    return r;
}
