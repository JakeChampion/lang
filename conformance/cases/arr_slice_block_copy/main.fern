





struct Buf { xs: i32[], tag: string }

function (b: Buf) put(i: i32, v: i32): Buf {
    return Buf { ...b, xs: b.xs.with(i, v) };
}

function roll(n: i32): i32 {
    let xs: i32[] = [];
    let i: i32 = 0;
    while (i < n) { xs = xs.append(i + 1); i = i + 1; }
    let b: Buf = Buf { xs: xs, tag: "a refcounted field the copy carries" };
    let total: i32 = 0;
    let r: i32 = 0;
    while (r < 3) {
        let j: i32 = 0;
        while (j < n) {
            let prev: Buf = b;
            b = b.put(j, b.xs[j] + 1);
            total = total + prev.xs[j];
            j = j + 1;
        }
        r = r + 1;
    }
    let k: i32 = 0;
    while (k < n) { total = total + b.xs[k]; k = k + 1; }
    return total;
}

function main(): i32 {
    let t: i32 = 0;
    for n in [0, 1, 2, 7, 8, 9, 31, 32, 33] { t = t + roll(n); }
    return (t % 239) + 1;
}
