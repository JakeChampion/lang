import "core/map";
import "std/string";
function main(): i32 {
    let m: Map[string, i32] = map_new(4);
    m = m.insert("alpha", 1);
    m = m.insert("beta", 2);
    m = m.insert("gamma", 3);
    let ks: string[] = m.keys();
    let i: i32 = 0;
    let total: i32 = 0;
    while (i < ks.len()) {
        total = total + ks[i].len();
        i = i + 1;
    }
    return total;
}
