





import "core/cmp";
function eqd[T: cmp.Eq + cmp.Display + cmp.Debug](a: T, b: T): i32 {
    let n: i32 = 0;
    if (a.eq(b)) { n = n + 1; }
    n = n + a.to_string().len();
    n = n + a.to_debug().len();
    return n;
}
function ord3[T: cmp.Ord](a: T, b: T): i32 { return a.cmp(b); }
function main(): i32 {
    let n: i32 = eqd(3.5, 3.5);
    let lt: i32 = ord3(1.5, 2.5);
    let gt: i32 = ord3(9.5, 2.5);
    let eq: i32 = ord3(4.5, 4.5);

    return n * 10 + (lt + 1) + (gt + 1) + eq;
}
