




import "core/int";
import "std/array";
import "std/string";
struct Node { id: i32 }
function main(): i32 {
    let ns: Node[] = [];
    let i: i32 = 0;
    while (i < 8) {
        ns = ns.append(Node { id: i });
        i = i + 1;
    }
    return (ns.len() - 8) + (ns[7].id - 7) + __rc_underflow_count();
}
