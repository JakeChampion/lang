// A local that a struct literal initializes is owned when each part of the
// literal is at its last use. `w` has no later use, so the literal takes it,
// and the local passes to an `own` parameter.

struct H { w: Writer }

function finish(own h: H): i32 {
  return 1;
}

function main(): i32 {
  let w = stdout();
  let x = H { w: w };
  print(finish(x));
  return 0;
}
