








import "core/int";
import "std/string";
struct Item { name: string, count: i32 }
function mk(): i32 {
    let it: Item = Item { name: "value-aaaaaaaaaaaaaaaaaa-" + "1", count: 7 };
    return it.name.len() + it.count;
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 16500) + __rc_underflow_count();
}
