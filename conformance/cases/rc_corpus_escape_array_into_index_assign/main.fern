// rc correctness: the program tears its values down and folds
// __rc_underflow_count() into its exit code, so 0 means no over-release.
//
// Escape into an array element via index-assign
// (`grid[i] = row`): the store retains the value without an
// inc, so the owned inner array must survive the helper's
// exit. Churn forces reuse of any freed block.
import "core/int";
function main(): i32 {
    let row: i32[] = [6000, 6001, 6002, 6003];
    let grid: i32[][] = [[0, 0, 0, 0]];
    let grid2: i32[][] = grid.with(0, row);
    let c: i32 = 0;
    while (c < 300) {
        let junk: i32[] = [c, c, c, c];
        c = c + 1;
    }
    let r: i32[] = grid2[0];
    return (r[0] - 6000) + (r[3] - 6003) + __rc_underflow_count();
}
