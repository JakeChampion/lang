import "core/int";






function main(): i32 {
    print(int.int_to_string_radix(255, 16));
    print(int.int_to_string_radix(10, 2));
    print(int.int_to_string_radix(0, 16));
    print(int.int_to_string_radix(0 - 255, 16));
    print(int.int_to_string_radix(35, 36));
    print(int.int_to_string_radix(1234, 16));
    return 0;
}
