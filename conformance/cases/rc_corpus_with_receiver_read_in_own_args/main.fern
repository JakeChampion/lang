






function bump(own a: i32[]): i32[] { return a.with(0, a[0] + 1); }
function main(): i32 {
    let a: i32[] = [5, 2];
    a = bump(a);
    let b: i32[] = [7, 1];
    let c: i32[] = b.with(1, b[0] + b[1]);
    return (a[0] - 6) + (a[1] - 2) + (b[1] - 1) + (c[1] - 8) + __rc_underflow_count();
}
