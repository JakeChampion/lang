






import "core/int";
import "core/map";
function lookup(m: Map[i32, i32[]], k: i32): i32[] {
    return m.get_or(k, []);
}
function main(): i32 {
    let m: Map[i32, i32[]] = map_new(4);
    m = m.insert(1, [100, 200]);
    let got: i32[] = lookup(m, 1);
    return (got[1] - 200) + __rc_underflow_count();
}
