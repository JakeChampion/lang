






enum Box { Wrap(i32), Empty }
enum Holder { Has(Option[i32]), Nothing }

function tag(b: Box): i32 {
    match (b) {
        Wrap(_) => { return 1; },
        Empty => { return 0; }
    }
    return 0;
}


function flat_tuple(): i32 {
    let x: i32 = 1;
    let t: (i32, i32) = (5, 6);
    let inner: i32 = 0;
    match (t) {
        (x, y) => { inner = x + y; }
    }
    return x * 10 + inner;
}


function string_elem(): i32 {
    let s: string = "ab";
    let t: (i32, string) = (5, "xyz");
    let n: i32 = 0;
    match (t) {
        (v, s) => { n = v + s.len(); }
    }
    return n + s.len();
}


function nested_tuple(): i32 {
    let x: i32 = 1;
    let t: (i32, (i32, i32)) = (2, (5, 6));
    let inner: i32 = 0;
    match (t) {
        (a, (x, c)) => { inner = a + x + c; }
    }
    return x * 100 + inner;
}


function payload_subpattern(): i32 {
    let x: i32 = 1;
    let h: Holder = Has(Some(5));
    let inner: i32 = 0;
    match (h) {
        Has(Some(x)) => { inner = x; },
        _ => { inner = 0; }
    }
    return x * 10 + inner;
}



function at_binding(): i32 {
    let n: Box = Empty;
    let b: Box = Wrap(5);
    let inner: i32 = 0;
    match (b) {
        n @ Wrap(v) => { inner = v + tag(n); },
        _ => { inner = 0; }
    }
    return inner * 10 + tag(n);
}

function main(): i32 {
    let r: i32 = 0;
    if (flat_tuple() == 21) { r = r + 1; }
    if (string_elem() == 10) { r = r + 2; }
    if (nested_tuple() == 113) { r = r + 4; }
    if (payload_subpattern() == 15) { r = r + 8; }
    if (at_binding() == 60) { r = r + 16; }
    return r;
}
