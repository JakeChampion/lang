import "core/map";


















function main(): i32 {
    let small: Map[u8, i32] = map_new(2);
    let i: i32 = 0;
    while (i < 12) { small = small.insert(i as u8, i * 2); i = i + 1; }
    if (small.len() != 12) { return 1; }
    if (!small.contains(11 as u8)) { return 2; }
    if (small.contains(12 as u8)) { return 3; }

    let wide: Map[u32, string] = map_new(2);
    let j: i32 = 0;
    while (j < 9) { wide = wide.insert((j * 7) as u32, "v"); j = j + 1; }
    if (wide.len() != 9) { return 4; }
    if (wide.contains(1 as u32)) { return 5; }


    let sum: i32 = 0;
    for (k, v) in small { sum = sum + (k as i32) + v; }
    if (sum != 198) { return 6; }


    let ksum: i32 = 0;
    for k in wide.keys() { ksum = ksum + (k as i32) + wide.get_or(k, "").len(); }
    if (ksum != 261) { return 7; }

    match (small.get(6 as u8)) {
        Some(v) => { return v + 30; },
        None => { return 8; }
    }
}
