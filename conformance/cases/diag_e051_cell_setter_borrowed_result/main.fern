// spec: RH-27
struct Handle { fd: i32 }

function (own h: Handle) close(): i32 {
  return h.fd;
}

function take(own slot: Cell[Handle]): Handle {
  return slot.get();
}

function poison(own slot: Cell[Handle], borrowed: Handle): Cell[Handle] {
  slot.set(borrowed);
  return slot;
}

function main(): i32 {
  let h = Handle { fd: 7 };
  let slot = cell_new(Handle { fd: 3 });
  let changed = poison(slot, h);
  let other = take(changed);
  return other.close() + h.close();
}
