








struct Holder { name: string }
function main(): i32 {
    let arr: Holder[] = [];
    let k: i32 = 0;
    while (k < 50) {
        let pre: string = "x";
        let s: string = pre + "y";
        arr = arr.append(Holder { name: s });
        k = k + 1;
    }
    let got: i32 = arr[10].name.len();
    return (got - 2) + __rc_underflow_count();
}
