

















function main(): i32 {
    let keep: Option[i32[]][] = [Some([1, 2]), None, Some([3, 4, 5])];
    let t: i32 = 0;
    let i: i32 = 0;
    while (i < 100) {
        { let o: Option[i32[]] = Some([i + 7, i + 8]); match (o) { Some(q) => { t = t + q.len(); }, None => {} } }
        for o in keep { match (o) { Some(p) => { t = t + p[0]; }, None => {} } }
        i = i + 1;
    }
    if (__rc_underflow_count() != 0) { return 99; }

    let s: i32 = 0;
    for o in keep { match (o) { Some(p) => { s = s + p.len(); }, None => {} } }
    if (s != 5) { return 98; }
    return t % 113;
}
