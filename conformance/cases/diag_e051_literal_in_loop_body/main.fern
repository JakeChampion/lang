// A loop body can run again, so the flow keeps every later read of a loop.
import "std/worker";
struct Out { k: i32, w: Option[worker.Worker[i32]] }
function bump(own o: Out, d: i32): Out { return Out { ...o, k: o.k + d }; }
function bad(own o: Out, x: i32): Out { while (x > 0) { let t = Out { ...o, k: 1 }; return bump(t, 1); } return o; }
function main(): i32 { return 0; }
