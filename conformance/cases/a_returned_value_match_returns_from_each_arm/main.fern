enum Color { Red, Black }

enum Tree {
  Node(Color, Tree, i32, Tree),
  Leaf,
}

function is_red_expr(t: Tree): boolean {
  return match (t) { Node(Red(), _, _, _) => true, _ => false };
}

function is_red_stmt(t: Tree): boolean {
  match (t) {
    Node(Red(), _, _, _) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function grown(n: i32): Tree {
  if (n % 2 == 0) {
    return Node(Red, Leaf, n, Node(Black, Leaf, n + 1, Leaf));
  }
  return Node(Black, Leaf, n, Leaf);
}

function grown_is_red(n: i32): boolean {
  return match (grown(n)) { Node(Red(), _, _, _) => true, _ => false };
}

function band(n: i32): i32 {
  return if (n < 10) { 1 } else if (n < 100) { 2 } else { 3 };
}

function label(t: Tree, n: i32): string {
  return match (t) { Node(Red(), _, _, _) => "red " + n.to_string(), Node(_, _, k, _) => "black " + k.to_string(), Leaf => "leaf" };
}

function right_or_new(t: Tree, n: i32): Tree {
  return match (t) { Node(Red(), _, _, r) => r, _ => Node(Black, Leaf, n, Leaf) };
}

function key(t: Tree): i32 {
  return match (t) { Node(_, _, k, _) => k, Leaf => 0 - 1 };
}

function main(): i32 {
  let trees: Tree[] = [grown(4), grown(7), Leaf];
  let line: string = "";
  for t in trees {
    line = line + (if (is_red_expr(t) == is_red_stmt(t)) { "=" } else { "!" });
    line = line + (if (is_red_expr(t)) { "R" } else { "-" });
  }
  print(line);
  print((if (grown_is_red(2)) { "red" } else { "black" }) + " " + (if (grown_is_red(3)) { "red" } else { "black" }));
  print(band(3).to_string() + " " + band(30).to_string() + " " + band(300).to_string());
  print(label(trees[0], 1) + ", " + label(trees[1], 2) + ", " + label(trees[2], 3));
  print(key(right_or_new(trees[0], 9)).to_string() + " " + key(right_or_new(trees[1], 9)).to_string() + " " + key(right_or_new(Leaf, 8)).to_string());
  return 0;
}
