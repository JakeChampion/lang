// spec: ML-03
// The escape is followed through a local the aggregate is bound to.

struct Window { xs: [i32] }

function bound(): Window {
    let a: i32[] = [1, 2, 3];
    let w: Window = Window { xs: a[0:2] };
    return w;
}

function bound_pair(): (Window, i32) {
    let a: i32[] = [1, 2, 3];
    let w = Window { xs: a[1:3] };
    return (w, 0);
}

function main(): i32 {
    return 0;
}
