






















import "core/map";
function main(): i32 {
    let m: Map[string, i32] = map_new(4);
    let f: () => i32 = (): i32 => { return m.len(); };
    let i: i32 = 0;
    while (i < 50) {
        m = map_new(4);
        m = m.insert("k", i);
        i = i + 1;
    }
    return (m.len() - 1) + (f() - 1) + __rc_underflow_count();
}
