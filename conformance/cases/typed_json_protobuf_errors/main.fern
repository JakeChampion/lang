function varint_boundaries(): i32 {
  let prefix: u8[] = [8 as u8];
  let i: i32 = 0;
  while (i < 10) {
    match (protobuf.decode(prefix)) {
      Ok(_) => {
        return 61;
      },
      Err(e) => {
        if (e.offset != prefix.len() || e.field != 1) {
          return 62;
        }
        match (e.kind) {
          protobuf.UnexpectedEnd => {},
          _ => {
            return 63;
          }
        }
      }
    }
    if (i < 9) {
      prefix = prefix.append(128 as u8);
    }
    i = i + 1;
  }
  let last: i32 = 0;
  while (last < 256) {
    match (protobuf.decode(prefix.append(last as u8))) {
      Ok(fields) => {
        if (last > 1 || fields.len() != 1 || fields[0].word != last as i64 << 63) {
          return 64;
        }
      },
      Err(e) => {
        if (last <= 1 || e.offset != 10 || e.field != 1) {
          return 65;
        }
        match (e.kind) {
          protobuf.VarintOverflow => {},
          _ => {
            return 66;
          }
        }
      }
    }
    last = last + 1;
  }
  let values: i64[] = [0 as i64, 127 as i64, 128 as i64, 16383 as i64, 16384 as i64, 4294967296 as i64, 9223372036854775807 as i64, -(1 as i64)];
  for value in values {
    match (protobuf.decode(protobuf.varint_field(1, value))) {
      Ok(fields) => {
        if (fields.len() != 1 || fields[0].word != value) {
          return 67;
        }
      },
      Err(_) => {
        return 68;
      }
    }
  }
  return 0;
}

function main(): i32 {
  let j: i32 = json_cases();
  if (j != 0) {
