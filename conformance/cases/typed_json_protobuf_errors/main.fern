import "std/json" as js;
import "std/protobuf";
import "std/error";
import "core/cmp";
import "std/string";
import "std/i64";

@derive(js.FromJson)
struct Box[T] { value: T, rest: T[], maybe: Option[T] }

@derive(js.FromJson)
enum Choice { Empty, Pair(i32, string), Record { n: i64 } }

function describe[T: error.Error](e: T): string {
  return e.message();
}

function display[T: cmp.Display](e: T): string {
  return e.to_string();
}

function json_cases(): i32 {
  let bad: string = "{\n  \"value\": ]}";
  match (js.parse(bad)) {
    Ok(_) => {
      return 1;
    },
    Err(parsed) => {
      match (js.decode[Box[i64]](bad)) {
        Ok(_) => {
          return 2;
        },
        Err(e) => {
          if (e.offset != parsed.offset || e.line != 2 || e.col != parsed.col || e.message != parsed.message) {
            return 3;
          }
          if (describe(e) != display(e)) {
            return 4;
          }
          match (js.decode_array[Box[i64]](bad)) {
            Ok(_) => {
              return 5;
            },
            Err(nested) => {
              if (nested.offset != e.offset || nested.line != e.line || nested.col != e.col) {
                return 5;
              }
            }
          }
        }
      }
    }
  }
  let b: Result[Box[i64], js.JsonError] = Box.from_json("{\"value\":-9223372036854775808,\"rest\":[9223372036854775807]}");
  match (b) {
    Ok(v) => {
      if (v.value + 1 as i64 != -(9223372036854775807 as i64) || v.rest[0] != 9223372036854775807 as i64) {
        return 6;
      }
      match (v.maybe) {
        None => {},
        Some(_) => {
          return 7;
        }
      }
    },
    Err(_) => {
      return 8;
    }
  }
  match (js.parse("{\"n\":-9223372036854775808}")) {
    Ok(v) => {
      match (js.json_get_i64(v, "n")) {
        Some(n) => {
          if (n + 1 as i64 != -(9223372036854775807 as i64)) {
            return 9;
          }
        },
        None => {
          return 10;
        }
      }
    },
    Err(_) => {
      return 11;
    }
  }
  match (js.decode[i64]("9223372036854775808")) {
    Ok(_) => {
      return 12;
    },
    Err(e) => {
      if (e.offset != -1 || e.line != 0 || e.col != 0) {
        return 13;
      }
    }
  }
  match (js.decode[i64]("-9223372036854775809")) {
    Ok(_) => {
      return 14;
    },
    Err(_) => {}
  }
  match (js.decode[Box[i32]]("{\"value\":1,\"rest\":[\"bad\"]}")) {
    Ok(_) => {
      return 15;
    },
    Err(e) => {
      if (e.to_string() != "field \"rest\": [0]: expected an integer, got a string") {
        return 16;
      }
    }
  }
  let c: Result[Choice, js.JsonError] = Choice.from_json("{\"Pair\":[1,\"ok\"]}");
  match (c) {
    Ok(_) => {},
    Err(_) => {
      return 17;
    }
  }
  match (Choice.from_json("{\"Record\":{\"n\":false}}")) {
    Ok(_) => {
      return 18;
    },
    Err(e) => {
      if (e.to_string() != "variant \"Record\": field \"n\": expected an integer, got a boolean") {
        return 19;
      }
    }
  }
  match (Choice.from_json("\"Other\"")) {
    Ok(_) => {
      return 20;
    },
    Err(e) => {
      if (e.message != "unknown variant \"Other\"") {
        return 21;
      }
    }
  }
  return 0;
}

