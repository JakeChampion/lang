







import "core/int";
import "core/map";
function main(): i32 {
    let m: Map[i32, i32] = map_new(4);
    let i: i32 = 0;
    while (i < 100) { m = m.insert(i, i * 2); i = i + 1; }
    let sum: i32 = 0;
    let j: i32 = 0;
    while (j < 100) { sum = sum + m.get_or(j, -1); j = j + 1; }
    return (sum - 9900) + __rc_underflow_count();
}
