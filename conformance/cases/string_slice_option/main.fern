// spec: ST-01
// spec: ST-02











function show(label: string, o: Option[str]): void {
    match (o) {
        Some(v) => { print(label + ":[" + v + "]"); },
        None => { print(label + ":none"); }
    }
}

function main(): i32 {
    let s: string = "abcdefghij";
    show("A", s[2:5]);
    show("B", s[:3]);
    show("C", s[7:]);
    show("D", s[1:99]);
    let neg: i32 = 0 - 1;
    show("E", s[neg:3]);
    show("F", s[4:2]);
    show("G", s[10:10]);


    let m: string = "héllo";
    show("H", m[1:3]);
    show("I", m[1:2]);
    show("J", m[2:4]);
    show("K", m[3:3]);


    match (first_three(s)) {
        Some(v) => { print("L:[" + v + "]"); },
        None => { print("L:none"); }
    }
    match (first_three("ab")) {
        Some(v) => { print("M:[" + v + "]"); },
        None => { print("M:none"); }
    }


    let u: str = slice_unchecked(s, 2, 5);
    print("N:[" + u + "]");
    return 0;
}

function first_three(s: string): Option[str] {
    let v: str = s[0:3]?;
    return Some(v);
}
