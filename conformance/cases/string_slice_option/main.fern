// spec: ST-01
// spec: ST-02
//
// The checked string slice, end to end.
//
// `s[a:b]` yields `Option[str]`: `Some` of the byte view when
// `0 <= a <= b <= len` AND both bounds sit on a UTF-8 code-point
// boundary, `None` otherwise. An out-of-range bound is `None`, NOT an
// abort — the trap survives only in `slice_unchecked`, which is the
// unguarded form and still yields a bare `str`.
//
// The open forms desugar to the same expression: `s[:b]` is `s[0:b]`
// and `s[a:]` is `s[a:s.len()]`, so both are `Option[str]` too.
function show(label: string, o: Option[str]): void {
    match (o) {
        Some(v) => { print(label + ":[" + v + "]"); },
        None => { print(label + ":none"); }
    }
}

function main(): i32 {
    var s: string = "abcdefghij";
    show("A", s[2:5]);        // in range
    show("B", s[:3]);         // open low
    show("C", s[7:]);         // open high
    show("D", s[1:99]);       // high past the end -> None
    var neg: i32 = 0 - 1;
    show("E", s[neg:3]);      // negative low -> None
    show("F", s[4:2]);        // low > high -> None
    show("G", s[10:10]);      // empty AT the length -> Some("")

    // "héllo" is 68 C3 A9 6C 6C 6F: the é occupies bytes 1..3.
    var m: string = "héllo";
    show("H", m[1:3]);        // both bounds on a boundary
    show("I", m[1:2]);        // end splits the é -> None
    show("J", m[2:4]);        // start splits the é -> None
    show("K", m[3:3]);        // zero-width on a boundary -> Some("")

    // `?` composes with the slice now that it is an Option.
    match (first_three(s)) {
        Some(v) => { print("L:[" + v + "]"); },
        None => { print("L:none"); }
    }
    match (first_three("ab")) {
        Some(v) => { print("M:[" + v + "]"); },
        None => { print("M:none"); }
    }

    // The unguarded form is unchanged: a bare `str`, no Option.
    var u: str = slice_unchecked(s, 2, 5);
    print("N:[" + u + "]");
    return 0;
}

function first_three(s: string): Option[str] {
    var v: str = s[0:3]?;
    return Some(v);
}
