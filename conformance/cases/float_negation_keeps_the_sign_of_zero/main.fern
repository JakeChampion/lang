import "std/num";

function main(): i32 {
  let z: f64 = 0.0;
  let w: f32 = 0.0 as f32;
  let r: i32 = 0;
  if (1.0 / -z < 0.0) {
    r = r + 1;
  }
  if ((1.0 as f32) / -w < (0.0 as f32)) {
    r = r + 2;
  }
  if (1.0 / -(-z) > 0.0) {
    r = r + 4;
  }
  if (1.0 / z.neg() < 0.0) {
    r = r + 8;
  }
  if ((1.0 as f32) / w.neg() < (0.0 as f32)) {
    r = r + 16;
  }
  return r;
}
