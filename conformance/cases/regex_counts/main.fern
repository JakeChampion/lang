



import "std/regex";

function main(): i32 {
    let r: i32 = 0;
    if (regex.regex_match("^a{3}$", "aaa")) { r = r + 1; }
    if (!regex.regex_match("^a{3}$", "aa")) { r = r + 2; }
    if (!regex.regex_match("^a{3}$", "aaaa")) { r = r + 4; }
    if (regex.regex_match("^a{2,4}$", "aaa")) { r = r + 8; }
    if (!regex.regex_match("^a{2,4}$", "a")) { r = r + 16; }
    if (regex.regex_match("^a{2,}$", "aaaaa")) { r = r + 32; }
    if (regex.regex_match("^(ab){2}$", "abab")) { r = r + 64; }
    if (regex.regex_match("\\d{2,4}", "x4567")) { r = r + 128; }
    return r;
}
