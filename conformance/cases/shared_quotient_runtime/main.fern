













function mix(h: i64, v: i64): i64 {
  return h * 1000003i64 + v;
}

function main(): i32 {
  let h: i64 = 2i64;
  let xs: i32[] = [0, 1, -1, 7, -7, 97, -1023, 2147483647, -2147483648];
  let us: u32[] = [0u32, 1u32, 7u32, 97u32, 2147483648u32, 4294967295u32];
  let ws: i64[] = [0i64, 1i64, -1i64, 7i64, -97i64, 1000000007i64, 9223372036854775807i64, -9223372036854775808i64];
  let uws: u64[] = [0u64, 1u64, 7u64, 1000000007u64, 9223372036854775808u64, 18446744073709551615u64];
  let bs: u8[] = [0u8, 1u8, 7u8, 200u8, 255u8];
  for x in xs {
    for y in xs {
      h = mix(h, (x / y) as i64);
      h = mix(h, (x % y) as i64);
      let r: i32 = x % y;
      if (r != 3) {
        h = mix(h, (x / y) as i64 * 7i64 + r as i64);
      }
    }
  }
  for x in us {
    for y in us {
      let q: u32 = x / y;
      if (q != 5u32) {
        h = mix(h, (x % y) as i64);
      }
      h = mix(h, q as i64);
    }
  }
  for x in ws {
    for y in ws {
      let r: i64 = 0i64;
      if (x > y) {
        r = x % y;
      } else {
        r = x % y + 1i64;
      }
      h = mix(h, x / y);
      h = mix(h, r);
    }
  }
  for x in uws {
    for y in uws {
      h = mix(h, (x / y + x % y * 3u64) as i64);
    }
  }
  for x in bs {
    for y in bs {
      h = mix(h, (x / y) as i64 * 256i64 + (x % y) as i64);
    }
  }
  if (h < 0i64) {
    h = 0i64 - h;
  }
  return (h % 200i64 + 2i64) as i32;
}
