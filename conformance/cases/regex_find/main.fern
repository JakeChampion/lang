



import "std/regex";

function main(): i32 {
    let r: i32 = 0;
    if (at(regex.regex_find("cat", "the cat sat"), 4)) { r = r + 1; }
    match (regex.regex_find("dog", "the cat sat")) {
        Some(_) => {},
        None => { r = r + 2; }
    }
    if (at(regex.regex_find("[0-9]+", "abc42"), 3)) { r = r + 4; }
    if (at(regex.regex_find("^the", "the cat"), 0)) { r = r + 8; }

    if let Some(m) = regex.regex_search("(a|b)+", "xxabbay") {
        r = r + 16;
        if (m.start == 2) { r = r + 32; }
        if (m.end == 6) { r = r + 64; }
    }

    match (regex.regex_search("zzz", "abc")) {
        Some(_) => {},
        None => { r = r + 128; }
    }
    return r;
}

function at(o: Option[i32], want: i32): boolean {
    if let Some(v) = o {
        return v == want;
    }
    return false;
}
