// All four backends. wasm is back (#5992): this case's wasm leg is the
// NATIVE backend (wasmbin), which handles it correctly — the divergence
// that got wasm excluded is in the SELF-HOST wasm emitter (wasm_ir.fern),
// which no fixture leg runs, so the exclusion removed real native
// coverage and protected nothing. The self-host gap is pinned where it
// lives instead.
function main(): i32 {
    var i: i64 = 0 - 1i64;
    var u: u64 = i as u64;
    var f: f64 = u as f64;
    var threshold: f64 = 10000000000000000000.0f64;
    if (f > threshold) { return 0; }
    return 1;
}
