







import "core/int";
import "core/map";
function make_map(n: i32): Map[i32, i32] {
    let m: Map[i32, i32] = map_new(4);
    m = m.insert(1, n);
    m = m.insert(2, n * 2);
    return m;
}
function main(): i32 {
    let got: i32 = 0;
    let k: i32 = 0;
    while (k < 50) {
        let m: Map[i32, i32] = make_map(k);
        got = got + m.get_or(1, -1) + m.get_or(2, -1);
        k = k + 1;
    }
    return (got - 3675) + __rc_underflow_count();
}
