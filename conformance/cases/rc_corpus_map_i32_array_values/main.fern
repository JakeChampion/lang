






import "core/int";
import "core/map";
function main(): i32 {
    let m: Map[i32, i32[]] = map_new(4);
    m = m.insert(1, [10, 20, 30]);
    m = m.insert(2, [40, 50]);
    let v1: i32[] = m.get_or(1, []);
    let v2: i32[] = m.get_or(2, []);
    return (v1[2] + v2[0] - 70) + __rc_underflow_count();
}
