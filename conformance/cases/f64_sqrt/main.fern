import "std/float";
// std/float sqrt(16.0) = 4.0, byte-exact on all four backends.
// This used to opt out of arm64/x86_64 with "sqrt needs libm; the
// -nostdlib native backends can't link it" and to match on a
// substring "to stay robust to trailing fractional digits". Both
// were stale: sqrt lowers to a hardware instruction (sqrtsd /
// fsqrt) with nothing to link, and float formatting is pure Fern
// and prints no trailing digits. The exclusion cost two backends
// of real coverage.
function main(): i32 {
    var x: f64 = 16.0;
    print(x.sqrt().to_string());
    return 0;
}
