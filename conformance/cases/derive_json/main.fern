




import "std/json";
import "std/string";

@derive(json.Json)
struct User { id: i32, name: string, admin: boolean }

@derive(json.Json)
enum Shape { Empty, Circle(i32), Rect(i32, i32) }

@derive(json.Json)
struct Wrap { who: User, tag: string }

@derive(json.Json)
struct Measure { value: f64, unit: string }

@derive(json.Json)
struct Bag { items: i32[], names: string[] }

function check(got: string, want: string, code: i32): i32 {
    if (got == want) { return 0; }
    return code;
}

function main(): i32 {
    let u: User = User { id: 7, name: "Gloin", admin: true };
    let r: i32 = check(u.to_json(), "{\"id\":7,\"name\":\"Gloin\",\"admin\":true}", 1);
    if (r != 0) { return r; }
    r = check(Empty.to_json(), "\"Empty\"", 2);
    if (r != 0) { return r; }
    r = check(Circle(5).to_json(), "{\"Circle\":5}", 3);
    if (r != 0) { return r; }
    r = check(Rect(2, 3).to_json(), "{\"Rect\":[2,3]}", 4);
    if (r != 0) { return r; }
    r = check(Wrap { who: u, tag: "hi" }.to_json(),
              "{\"who\":{\"id\":7,\"name\":\"Gloin\",\"admin\":true},\"tag\":\"hi\"}", 5);
    if (r != 0) { return r; }

    let m: User = User { id: 0, name: "a\"b\nc", admin: false };
    r = check(m.to_json(), "{\"id\":0,\"name\":\"a\\\"b\\nc\",\"admin\":false}", 6);
    if (r != 0) { return r; }

    let d: Measure = Measure { value: 3.14, unit: "m" };
    r = check(d.to_json(), "{\"value\":3.14,\"unit\":\"m\"}", 7);
    if (r != 0) { return r; }


    let bag: Bag = Bag { items: [1, 2, 3], names: ["a", "b"] };
    r = check(bag.to_json(), "{\"items\":[1,2,3],\"names\":[\"a\",\"b\"]}", 8);
    if (r != 0) { return r; }

    let nums: i32[] = [10, 20];
    r = check(nums.to_json(), "[10,20]", 9);
    if (r != 0) { return r; }
    return 42;
}
