





import "core/int";
import "std/string";
struct Box { items: i32[] }
function mk(n: i32): Box {
    let arr: i32[] = [n, n + 1, n + 2];
    return Box { items: arr };
}
function main(): i32 {
    let b: Box = mk(5);
    let c: i32 = 0;
    while (c < 90) {
        let junk: i32[] = [c, c, c];
        c = c + junk.len();
    }
    return (b.items.len() - 3) + (b.items[2] - 7) + __rc_underflow_count();
}
