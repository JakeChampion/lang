












import "std/i32";
import "core/int";

enum List { Cons(i32, List), Nil }

function build(n: i32): List {
    let acc: List = Nil;
    let i: i32 = 1;
    while (i <= n) {
        acc = Cons(i, acc);
        i = i + 1;
    }
    return acc;
}

function inc_all(xs: List): List {
    match (xs) {
        Cons(h, t) => { return Cons(h + 1, inc_all(t)); },
        Nil => { return Nil; },
    }
}

function sum(l: List): i32 {
    match (l) {
        Cons(h, t) => { return h + sum(t); },
        Nil => { return 0; },
    }
}

function main(): i32 {

    let xs: List = build(4);
    print((sum(xs)).to_string());


    let keep: List = build(3);
    let grown: List = keep;
    grown = Cons(10, grown);
    print((sum(grown)).to_string());


    let ys: List = inc_all(keep);
    print((sum(ys)).to_string());
    print((sum(keep)).to_string());
    print((sum(grown)).to_string());
    return 0;
}
