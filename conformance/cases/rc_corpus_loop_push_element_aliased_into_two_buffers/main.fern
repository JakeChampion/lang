





import "core/int";
struct Val { kind: i32, kids: i32[] }
function build(n: i32): i32 {
    let a: Val[] = [];
    let b: Val[] = [];
    let i: i32 = 0;
    while (i < n) {
        if (i == 9999) { break; }
        let v: Val = Val { kind: i, kids: [i] };
        a = a.append(v);
        b = b.append(v);
        i = i + 1;
    }
    return a.len() + b.len() + a[0].kids.len() + b[0].kids.len();
}
function main(): i32 { return (build(4) - 10) + __rc_underflow_count(); }
