// Pins E033. The program is the example from that code's entry
// in the diagnostic catalogue (`fern explain E033`), so this case
// also checks the catalogue's example really does produce the error
// it documents.
struct Point { x: i32, y: i32 }
struct Vec2  { x: i32, y: i32 }

function f(p: Point): Vec2 {
    return p as Vec2;   // error[E033]: cannot cast Point to Vec2 ...
}
