




struct Point { x: i32, y: i32 }

struct Cfg { name: string, origin: Point, scale: i32 }

const BASE: i32 = 40;

const ORIGIN: Point = Point { x: 1, y: 2 };

const CFG: Cfg = Cfg { name: "grid", origin: Point { x: 3, y: BASE + 1 }, scale: BASE / 10 };

function sum(p: Point): i32 {
  return p.x + p.y;
}

function main(): i32 {
  print(ORIGIN.x.to_string());
  print(sum(ORIGIN).to_string());
  print(ORIGIN.y.to_string());
  print(CFG.name);
  print(CFG.origin.y.to_string());
  let c: Cfg = CFG;
  print((sum(c.origin) * c.scale).to_string());
  print(CFG.name);
  return sum(ORIGIN) + CFG.scale;
}
