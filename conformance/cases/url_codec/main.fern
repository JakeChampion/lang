import "core/int";
import "std/url";
import "std/i32";
import "core/map";

function main(): i32 {

    let enc: string = url.url_encode("a b/c?x=1");
    print(enc);
    print(url.url_decode(enc));

    print(url.url_encode("Hello-World_1.2~"));

    print(url.url_decode("100%zz"));

    match (url.url_parse("http://h.com:8080/p?q#f")) {
        Some(u) => { print(u.scheme + " " + u.host + " " + u.port.to_string() + " " + u.path + " " + u.query + " " + u.fragment); },
        None => { print("parse-none"); },
    }

    match (url.url_parse("")) {
        Some(u) => { print("unexpected"); },
        None => { print("empty-none"); },
    }

    let q: Map[string, string[]] = url.query_parse("a=1&b=2&a=3");
    match (q.get("a")) {
        Some(v) => { print("a=" + v.len().to_string()); },
        None => { print("a-none"); },
    }
    match (q.get("b")) {
        Some(v) => { print("b=" + v.len().to_string()); },
        None => { print("b-none"); },
    }
    return 0;
}
