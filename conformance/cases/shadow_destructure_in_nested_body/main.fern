








struct Point { x: i32, y: i32 }

function main(): i32 {
    let x: i32 = 1;
    let y: i32 = 2;


    let lam = (Point { x, y }: Point): i32 => { return x * 10 + y; };
    if (lam(Point { x: 3, y: 4 }) != 34) { return 1; }


    let outer = (): i32 => {
        let inner = ((x, y): (i32, i32)): i32 => { return x * 100 + y; };
        return inner((5, 6));
    };
    if (outer() != 506) { return 2; }


    function f(a: i32, b: i32): i32 { let (x, y) = (a, b); return x * 10 + y; }
    if (f(7, 8) != 78) { return 3; }



    let total: i32 = 0;
    for (x, y) in [(1, 2), (3, 4)] { total = total + x * 10 + y; }
    if (total != 46) { return 4; }


    let free = ((p, q): (i32, i32)): i32 => { return p - q; };
    if (free((9, 5)) != 4) { return 5; }

    if (x != 1) { return 6; }
    if (y != 2) { return 7; }
    return 0;
}
