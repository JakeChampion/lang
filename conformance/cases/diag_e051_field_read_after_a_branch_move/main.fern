// A field of an own parameter moves in a branch that does not leave. The
// read of the parameter after the branch can read the moved field, so the
// move is refused.

struct P { n: i32 }
struct S { p: P, k: i32, flag: boolean }

function take(own p: P): P {
  return p;
}

function step(own s: S): S {
  if (s.flag) {
    let a = take(s.p);
  }
  return s;
}

function main(): i32 {
  return step(S { p: P { n: 1 }, k: 0, flag: true }).k;
}
