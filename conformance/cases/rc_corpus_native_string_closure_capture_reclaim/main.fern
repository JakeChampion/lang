









import "core/int";
import "std/string";
function mk(): i32 {
    let s: string = "value-aaaaaaaaaaaaaaaaaa-" + "1";
    let f = (): i32 => { return s.len(); };
    return f();
}
function main(): i32 {
    let total: i32 = 0;
    let k: i32 = 0;
    while (k < 500) { total = total + mk(); k = k + 1; }
    return (total - 13000) + __rc_underflow_count();
}
