import "std/i32";
import "std/i64";
import "std/u32";
import "std/u64";
import "std/f32";
import "std/f64";
import "std/math";

function main(): i32 {
  if (i32.MAX != 2147483647) { return 1; }
  if (i32.MIN != 0 - 2147483647 - 1) { return 2; }
  if (i64.MAX != 9223372036854775807) { return 3; }
  if (i64.MIN + 1 != 0 - i64.MAX) { return 4; }
  if (u32.MAX != 4294967295) { return 5; }
  if (u64.MAX != 18446744073709551615) { return 6; }
  if (u32.MIN != 0) { return 7; }
  if (!(f64.INFINITY > f64.MAX)) { return 8; }
  if (!(f64.NEG_INFINITY < f64.MIN)) { return 9; }
  if (f64.NAN == f64.NAN) { return 10; }
  if (1.0 + f64.EPSILON == 1.0) { return 11; }
  if (1.0 + f64.EPSILON / 2.0 != 1.0) { return 12; }
  if (!(f64.MIN_POSITIVE > 0.0)) { return 13; }
  if (f32.NAN == f32.NAN) { return 14; }
  if (!(f32.INFINITY > f32.MAX)) { return 15; }
  if (math.TAU != 2.0 * math.PI) { return 16; }
  if (!(math.E > 2.718 && math.E < 2.719)) { return 17; }
  return 42;
}
