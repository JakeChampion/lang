// Regression for #4829: a comparator that is BOTH a direct-call target AND a
// closure value passed to `cmp.sort_by`. The closure-target ABI appends an
// env_ptr param to such a function's wasm signature, but the direct-call sites
// supplied only the natural args — a stack underflow that failed
// `-target wasm32-wasi` validation ("expected i32 but nothing on stack") while
// interp / x86-64 / arm64 all passed. The fix pushes a dummy env_ptr at direct
// calls to env-appended closure targets (see calleeEnvAppended in wasmbin).
// prop_sort_strings is the exhaustive property companion; this one pins the
// exact direct-call + delegation shape on every backend.
import "core/cmp";
import "std/string";

function fold_order(a: string, b: string): i32 {
    return a.cmp_ignore_ascii_case(b);
}

function main(): i32 {
    if ("ab".cmp("abc") >= 0) {
        print("direct cmp FAILED");
        return 1;
    }
    // Direct call to `fold_order` — the env-appended closure target must
    // still accept a bare (no-env) direct call.
    if (fold_order("ABC", "abc") != 0) {
        print("direct fold_order FAILED");
        return 1;
    }

    let arr: string[] = ["cherry", "Apple", "banana", "apple", "", "date"];

    let asc: string[] = cmp.sort(arr);
    if (asc[0] != "" || asc[1] != "Apple") {
        print("asc FAILED");
        return 1;
    }

    let desc: string[] = cmp.sort_desc(arr);
    if (desc[0] != "date") {
        print("desc FAILED");
        return 1;
    }

    let ci: string[] = cmp.sort_by(arr, fold_order);
    // ci-stable: "Apple" and "apple" compare equal, keep input order.
    if (ci[0] != "") {
        print("ci FAILED");
        return 1;
    }
    let seen_apple_upper: boolean = false;
    for x in ci {
        if (x == "Apple") { seen_apple_upper = true; }
        if (x == "apple") {
            if (!seen_apple_upper) {
                print("ci stability FAILED");
                return 1;
            }
        }
    }

    print("OK");
    return 0;
}
