



import "std/regex";

function main(): i32 {
  let r: i32 = 0;
  if (regex.regex_full_match("a|aa", "aa")) {
    r = r + 1;
  }
  if (regex.regex_full_match("[0-9]+", "12345")) {
    r = r + 2;
  }
  if (!regex.regex_full_match("[0-9]+", "12a45")) {
    r = r + 4;
  }
  if (!regex.regex_full_match("cat", "category")) {
    r = r + 8;
  }

  if (regex.regex_count("a", "banana") == 3) {
    r = r + 16;
  }
  if (regex.regex_count("xyz", "banana") == 0) {
    r = r + 32;
  }

  if (require_regex_text(regex.regex_replace("a", "banana", "X")) == "bXnana") {
    r = r + 64;
  }
  if (require_regex_text(regex.regex_replace("z", "banana", "X")) == "banana") {
    r = r + 128;
  }
  return r;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
