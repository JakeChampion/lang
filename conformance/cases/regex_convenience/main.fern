// std/regex (#2680) convenience entry points across the native backends:
// regex_full_match (whole-string), regex_count (number of matches), and
// regex_replace (first match only). Each check sets a bit; all eight hold
// -> 255.
import "std/regex";

function main(): i32 {
  var r: i32 = 0;
  if (regex.regex_full_match("a|aa", "aa")) {  // shorter alt exists; full still true
    r = r + 1;
  }
  if (regex.regex_full_match("[0-9]+", "12345")) {
    r = r + 2;
  }
  if (!regex.regex_full_match("[0-9]+", "12a45")) {  // not whole-string
    r = r + 4;
  }
  if (!regex.regex_full_match("cat", "category")) {  // prefix only
    r = r + 8;
  }

  if (regex.regex_count("a", "banana") == 3) {
    r = r + 16;
  }
  if (regex.regex_count("xyz", "banana") == 0) {
    r = r + 32;
  }

  if (require_regex_text(regex.regex_replace("a", "banana", "X")) == "bXnana") {  // first only
    r = r + 64;
  }
  if (require_regex_text(regex.regex_replace("z", "banana", "X")) == "banana") {  // no match → unchanged
    r = r + 128;
  }
  return r;
}

function require_regex_text(result: Option[string]): string {
  match (result) {
    Some(value) => {
      return value;
    },
    None => {
      exit(1);
    }
  }
  return "";
}
