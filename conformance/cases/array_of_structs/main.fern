

struct Item { qty: i32, price: i32 }

function main(): i32 {
    let items = [
        Item { qty: 2, price: 5 },
        Item { qty: 3, price: 4 },
        Item { qty: 1, price: 10 }
    ];
    let total: i32 = 0;
    for it in items {
        total = total + it.qty * it.price;
    }
    return total;
}
