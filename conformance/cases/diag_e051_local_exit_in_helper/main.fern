// The helper ends in a call through a local named exit. That call returns, so
// the helper returns too, and the local that moves into the own parameter is
// read again after the branch.
struct W { d: i32[], n: i32 }

function stop(code: i32): void {
  let exit = (k: i32): void => {};
  exit(code);
}

function eat(own w: W): i32 {
  return w.n + w.d.len();
}

function main(): i32 {
  let w: W = W { d: [1], n: 1 };
  if (w.n > 5) {
    stop(eat(w));
  }
  return w.n;
}
