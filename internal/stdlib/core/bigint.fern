// This module provides arbitrary-precision integers.

pub struct BigInt {
  neg: boolean,
  mag: u64[],
}

function __bi_mask(): u64 {
  return 4294967295 as u64;
}

function __bi_base(): u64 {
  return 4294967296 as u64;
}

function __bi_sh32(): u64 {
  return 32 as u64;
}

function __bi_trim(a: u64[]): u64[] {
  let n: i32 = a.len();
  while (n > 1 && a[n - 1] == 0 as u64) {
    n = n - 1;
  }
  if (n == a.len()) {
    return a;
  }
  let out: u64[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(a[i]);
    i = i + 1;
  }
  return out;
}

function __bi_is_zero_mag(a: u64[]): boolean {
  return a.len() == 1 && a[0] == 0 as u64;
}

function __bi_make(neg: boolean, mag: u64[]): BigInt {
  let m: u64[] = __bi_trim(mag);
  if (__bi_is_zero_mag(m)) {
    return BigInt { neg: false, mag: m };
  }
  return BigInt { neg: neg, mag: m };
}

function __bi_cmp_mag(a: u64[], b: u64[]): i32 {
  if (a.len() < b.len()) {
    return 0 - 1;
  }
  if (a.len() > b.len()) {
    return 1;
  }
  let i: i32 = a.len() - 1;
  while (i >= 0) {
    if (a[i] < b[i]) {
      return 0 - 1;
    }
    if (a[i] > b[i]) {
      return 1;
    }
    i = i - 1;
  }
  return 0;
}

function __bi_add_mag(a: u64[], b: u64[]): u64[] {
  let mask: u64 = __bi_mask();
  let sh: u64 = __bi_sh32();
  let la: i32 = a.len();
  let lb: i32 = b.len();
  let n: i32 = la;
  if (lb > n) {
    n = lb;
  }
  let out: u64[] = [];
  let carry: u64 = 0 as u64;
  let i: i32 = 0;
  while (i < n) {
    let s: u64 = carry;
    if (i < la) {
      s = s + a[i];
    }
    if (i < lb) {
      s = s + b[i];
    }
    out = out.append(s & mask);
    carry = s >> sh;
    i = i + 1;
  }
  if (carry > 0 as u64) {
    out = out.append(carry);
  }
  return __bi_trim(out);
}

function __bi_sub_mag(a: u64[], b: u64[]): u64[] {
  let base: u64 = __bi_base();
  let la: i32 = a.len();
  let lb: i32 = b.len();
  let out: u64[] = [];
  let borrow: u64 = 0 as u64;
  let i: i32 = 0;
  while (i < la) {
    let d: u64 = borrow;
    if (i < lb) {
      d = d + b[i];
    }
    if (a[i] >= d) {
      out = out.append(a[i] - d);
      borrow = 0 as u64;
    } else {
      out = out.append(a[i] + base - d);
      borrow = 1 as u64;
    }
    i = i + 1;
  }
  return __bi_trim(out);
}

function __bi_mul_mag(a: u64[], b: u64[]): u64[] {
  let mask: u64 = __bi_mask();
  let sh: u64 = __bi_sh32();
  let la: i32 = a.len();
  let lb: i32 = b.len();
  if (__bi_is_zero_mag(a) || __bi_is_zero_mag(b)) {
    let z: u64[] = [];
    return z.append(0 as u64);
  }
  let out: u64[] = [];
  let i: i32 = 0;
  while (i < la + lb) {
    out = out.append(0 as u64);
    i = i + 1;
  }
  i = 0;
  while (i < la) {
    let carry: u64 = 0 as u64;
    let ai: u64 = a[i];
    let j: i32 = 0;
    while (j < lb) {
      let cur: u64 = out[i + j] + ai * b[j] + carry;
      out = out.with(i + j, cur & mask);
      carry = cur >> sh;
      j = j + 1;
    }
    let k: i32 = i + lb;
    while (carry > 0 as u64) {
      let c2: u64 = out[k] + carry;
      out = out.with(k, c2 & mask);
      carry = c2 >> sh;
      k = k + 1;
    }
    i = i + 1;
  }
  return __bi_trim(out);
}

function __bi_mul_small(a: u64[], k: u64): u64[] {
  let mask: u64 = __bi_mask();
  let sh: u64 = __bi_sh32();
  let out: u64[] = a;
  let carry: u64 = 0 as u64;
  let i: i32 = 0;
  while (i < a.len()) {
    let prod: u64 = a[i] * k + carry;
    out = out.with(i, prod & mask);
    carry = prod >> sh;
    i = i + 1;
  }
  if (carry > 0 as u64) {
    out = out.append(carry);
  }
  return __bi_trim(out);
}

function __bi_add_small(a: u64[], k: u64): u64[] {
  let mask: u64 = __bi_mask();
  let sh: u64 = __bi_sh32();
  let out: u64[] = [];
  let carry: u64 = k;
  let i: i32 = 0;
  while (i < a.len()) {
    let cur: u64 = a[i] + carry;
    out = out.append(cur & mask);
    carry = cur >> sh;
    i = i + 1;
  }
  while (carry > 0 as u64) {
    out = out.append(carry & mask);
    carry = carry >> sh;
  }
  return __bi_trim(out);
}

function __bi_divmod_small(a: u64[], d: u64): (u64[], u64) {
  let mask: u64 = __bi_mask();
  let sh: u64 = __bi_sh32();
  let n: i32 = a.len();
  let q: u64[] = [];
  let i: i32 = 0;
  while (i < n) {
    q = q.append(0 as u64);
    i = i + 1;
  }
  let rem: u64 = 0 as u64;
  i = n - 1;
  while (i >= 0) {
    let cur: u64 = rem << sh | a[i] & mask;
    q = q.with(i, cur / d);
    rem = cur % d;
    i = i - 1;
  }
  return (__bi_trim(q), rem);
}

pub function zero(): BigInt {
  let z: u64[] = [];
  return BigInt { neg: false, mag: z.append(0 as u64) };
}

pub function from_i64(v: i64): BigInt {
  let mask: u64 = __bi_mask();
  let sh: u64 = __bi_sh32();
  let neg: boolean = v < 0;
  let u: u64 = v as u64;
  if (neg) {
    u = 0 as u64 - u;
  }
  let m: u64[] = [];
  m = m.append(u & mask);
  m = m.append(u >> sh & mask);
  return __bi_make(neg, m);
}

pub function parse(s: string): Option[BigInt] {
  let n: i32 = s.len();
  if (n == 0) {
    return None;
  }
  let i: i32 = 0;
  let neg: boolean = false;
  if (s[0] == 45) {
    neg = true;
    i = 1;
  } else {
    if (s[0] == 43) {
      i = 1;
    }
  }
  if (i >= n) {
    return None;
  }
  let mag: u64[] = [];
  mag = mag.append(0 as u64);
  while (i < n) {
    let chunk: u64 = 0 as u64;
    let scale: u64 = 1 as u64;
    let taken: i32 = 0;
    while (i < n && taken < 9) {
      let c: i32 = s[i] as i32;
      if (c < 48 || c > 57) {
        return None;
      }
      chunk = chunk * (10 as u64) + (c - 48) as u64;
      scale = scale * (10 as u64);
      taken = taken + 1;
      i = i + 1;
    }
    mag = __bi_mul_small(mag, scale);
    mag = __bi_add_small(mag, chunk);
  }
  return Some(__bi_make(neg, mag));
}

pub function (a: BigInt) is_zero(): boolean {
  return __bi_is_zero_mag(a.mag);
}

pub function (a: BigInt) is_negative(): boolean {
  return a.neg;
}

pub function (a: BigInt) bit_length(): i32 {
  if (__bi_is_zero_mag(a.mag)) {
    return 0;
  }
  let top: i32 = a.mag.len() - 1;
  let v: u64 = a.mag[top];
  let bits: i32 = 0;
  while (v > 0 as u64) {
    bits = bits + 1;
    v = v >> 1 as u64;
  }
  return top * 32 + bits;
}

pub function (a: BigInt) cmp(b: BigInt): i32 {
  if (a.neg && !b.neg) {
    return 0 - 1;
  }
  if (!a.neg && b.neg) {
    return 1;
  }
  let c: i32 = __bi_cmp_mag(a.mag, b.mag);
  if (a.neg) {
    return 0 - c;
  }
  return c;
}

pub function (a: BigInt) eq(b: BigInt): boolean {
  return a.cmp(b) == 0;
}

pub function (a: BigInt) hash(): i32 {
  let h: i32 = 17;
  if (a.neg) {
    h = 31;
  }
  let i: i32 = 0;
  while (i < a.mag.len()) {
    h = h * 31 + (a.mag[i] & __bi_mask()) as i32;
    i = i + 1;
  }
  return h;
}

pub function (a: BigInt) negate(): BigInt {
  return __bi_make(!a.neg, a.mag);
}

pub function (a: BigInt) abs(): BigInt {
  return __bi_make(false, a.mag);
}

pub function (a: BigInt) add(b: BigInt): BigInt {
  if (a.neg == b.neg) {
    return __bi_make(a.neg, __bi_add_mag(a.mag, b.mag));
  }
  let c: i32 = __bi_cmp_mag(a.mag, b.mag);
  if (c == 0) {
    return zero();
  }
  if (c > 0) {
    return __bi_make(a.neg, __bi_sub_mag(a.mag, b.mag));
  }
  return __bi_make(b.neg, __bi_sub_mag(b.mag, a.mag));
}

pub function (a: BigInt) sub(b: BigInt): BigInt {
  return a.add(b.negate());
}

pub function (a: BigInt) mul(b: BigInt): BigInt {
  let neg: boolean = a.neg != b.neg;
  return __bi_make(neg, __bi_mul_mag(a.mag, b.mag));
}

pub function (a: BigInt) mul_pow10(k: i32): BigInt {
  if (k <= 0) {
    return a;
  }
  let mag: u64[] = a.mag;
  let left: i32 = k;
  while (left > 0) {
    let step: i32 = left;
    if (step > 9) {
      step = 9;
    }
    let scale: u64 = 1 as u64;
    let i: i32 = 0;
    while (i < step) {
      scale = scale * (10 as u64);
      i = i + 1;
    }
    mag = __bi_mul_small(mag, scale);
    left = left - step;
  }
  return __bi_make(a.neg, mag);
}

pub function (a: BigInt) mul_pow5(k: i32): BigInt {
  if (k <= 0) {
    return a;
  }
  let mag: u64[] = a.mag;
  let left: i32 = k;
  while (left > 0) {
    let step: i32 = left;
    if (step > 13) {
      step = 13;
    }
    let scale: u64 = 1 as u64;
    let i: i32 = 0;
    while (i < step) {
      scale = scale * (5 as u64);
      i = i + 1;
    }
    mag = __bi_mul_small(mag, scale);
    left = left - step;
  }
  return __bi_make(a.neg, mag);
}

pub function (a: BigInt) shl(k: i32): BigInt {
  if (k <= 0 || __bi_is_zero_mag(a.mag)) {
    return a;
  }
  let mask: u64 = __bi_mask();
  let sh: u64 = __bi_sh32();
  let limbShift: i32 = k / 32;
  let bitShift: u64 = (k % 32) as u64;
  let out: u64[] = [];
  let i: i32 = 0;
  while (i < limbShift) {
    out = out.append(0 as u64);
    i = i + 1;
  }
  let carry: u64 = 0 as u64;
  i = 0;
  while (i < a.mag.len()) {
    let cur: u64 = a.mag[i] << bitShift | carry;
    out = out.append(cur & mask);
    carry = cur >> sh;
    i = i + 1;
  }
  if (carry > 0 as u64) {
    out = out.append(carry);
  }
  return __bi_make(a.neg, out);
}

pub function from_u64(v: u64): BigInt {
  let m: u64[] = [];
  m = m.append(v & __bi_mask());
  m = m.append(v >> __bi_sh32() & __bi_mask());
  return __bi_make(false, m);
}

pub function (a: BigInt) low_u64(): u64 {
  return a.word64(0);
}

pub function (a: BigInt) word64(i: i32): u64 {
  let lo: i32 = 2 * i;
  let v: u64 = 0 as u64;
  if (lo < a.mag.len()) {
    v = a.mag[lo];
  }
  if (lo + 1 < a.mag.len()) {
    v = v | a.mag[lo + 1] << __bi_sh32();
  }
  return v;
}

pub function (a: BigInt) has_low_bits(k: i32): boolean {
  let limbs: i32 = k / 32;
  let i: i32 = 0;
  while (i < limbs && i < a.mag.len()) {
    if (a.mag[i] != 0 as u64) {
      return true;
    }
    i = i + 1;
  }
  if (limbs >= a.mag.len() || k % 32 == 0) {
    return false;
  }
  let mask: u64 = (1 as u64 << (k % 32) as u64) - 1 as u64;
  return (a.mag[limbs] & mask) != 0 as u64;
}

pub function (a: BigInt) bit(i: i32): boolean {
  if (i < 0) {
    return false;
  }
  let limb: i32 = i / 32;
  if (limb >= a.mag.len()) {
    return false;
  }
  return (a.mag[limb] >> (i % 32) as u64 & 1 as u64) == 1 as u64;
}

pub function (a: BigInt) shr(k: i32): BigInt {
  if (k <= 0) {
    return a;
  }
  let mask: u64 = __bi_mask();
  let limbShift: i32 = k / 32;
  let bitShift: u64 = (k % 32) as u64;
  let n: i32 = a.mag.len() - limbShift;
  if (n <= 0) {
    return zero();
  }
  let out: u64[] = [];
  let i: i32 = 0;
  while (i < n) {
    let cur: u64 = a.mag[i + limbShift] >> bitShift;
    if (bitShift > 0 as u64 && i + limbShift + 1 < a.mag.len()) {
      cur = cur | a.mag[i + limbShift + 1] << 32 as u64 - bitShift & mask;
    }
    out = out.append(cur);
    i = i + 1;
  }
  return __bi_make(a.neg, out);
}

pub function (a: BigInt) pow(n: i32): BigInt {
  let result: BigInt = from_i64(1 as i64);
  let base: BigInt = a;
  let e: i32 = n;
  while (e > 0) {
    if (e % 2 == 1) {
      result = result.mul(base);
    }
    e = e / 2;
    if (e > 0) {
      base = base.mul(base);
    }
  }
  return result;
}

pub function (a: BigInt) divmod(b: BigInt): (BigInt, BigInt) {
  if (__bi_is_zero_mag(b.mag)) {
    return (zero(), a);
  }
  let qr: (u64[], u64[]) = __bi_divmod_mag(a.mag, b.mag);
  return (__bi_make(a.neg != b.neg, qr.0), __bi_make(a.neg, qr.1));
}

function __bi_divmod_mag(a: u64[], b: u64[]): (u64[], u64[]) {
  let mask: u64 = __bi_mask();
  let base: u64 = __bi_base();
  let sh: u64 = __bi_sh32();
  if (__bi_cmp_mag(a, b) < 0) {
    let z: u64[] = [];
    return (z.append(0 as u64), a);
  }
  if (b.len() == 1) {
    let dm: (u64[], u64) = __bi_divmod_small(a, b[0]);
    let r1: u64[] = [];
    return (dm.0, r1.append(dm.1));
  }
  let s: i32 = 0;
  let top: u64 = b[b.len() - 1];
  while ((top & 2147483648 as u64) == 0 as u64) {
    top = top << 1 as u64;
    s = s + 1;
  }
  let v: u64[] = __bi_shl_limbs(b, s, false);
  let u: u64[] = __bi_shl_limbs(a, s, true);
  let n: i32 = v.len();
  let m: i32 = u.len() - n;
  let q: u64[] = [];
  let k: i32 = 0;
  while (k < m) {
    q = q.append(0 as u64);
    k = k + 1;
  }
  let j: i32 = m - 1;
  while (j >= 0) {
    let num: u64 = u[j + n] << sh | u[j + n - 1];
    let qhat: u64 = num / v[n - 1];
    let rhat: u64 = num % v[n - 1];
    while (qhat >= base || qhat * v[n - 2] > (rhat << sh | u[j + n - 2])) {
      qhat = qhat - 1 as u64;
      rhat = rhat + v[n - 1];
      if (rhat >= base) {
        break;
      }
    }
    let carry: u64 = 0 as u64;
    let borrow: u64 = 0 as u64;
    let i: i32 = 0;
    while (i < n) {
      let p: u64 = qhat * v[i] + carry;
      carry = p >> sh;
      let sub: u64 = (p & mask) + borrow;
      if (u[i + j] >= sub) {
        u = u.with(i + j, u[i + j] - sub);
        borrow = 0 as u64;
      } else {
        u = u.with(i + j, u[i + j] + base - sub);
        borrow = 1 as u64;
      }
      i = i + 1;
    }
    let subTop: u64 = carry + borrow;
    if (u[j + n] >= subTop) {
      u = u.with(j + n, u[j + n] - subTop);
      q = q.with(j, qhat);
    } else {
      q = q.with(j, qhat - 1 as u64);
      let c2: u64 = 0 as u64;
      i = 0;
      while (i < n) {
        let sum: u64 = u[i + j] + v[i] + c2;
        u = u.with(i + j, sum & mask);
        c2 = sum >> sh;
        i = i + 1;
      }
      u = u.with(j + n, u[j + n] + base - subTop + c2 & mask);
    }
    j = j - 1;
  }
  let rem: u64[] = [];
  k = 0;
  while (k < n) {
    rem = rem.append(u[k]);
    k = k + 1;
  }
  return (__bi_trim(q), __bi_shr_limbs(__bi_trim(rem), s));
}

function __bi_shl_limbs(a: u64[], s: i32, extend: boolean): u64[] {
  let mask: u64 = __bi_mask();
  let sh: u64 = __bi_sh32();
  let bs: u64 = s as u64;
  let out: u64[] = [];
  let carry: u64 = 0 as u64;
  let i: i32 = 0;
  while (i < a.len()) {
    let cur: u64 = a[i] << bs | carry;
    out = out.append(cur & mask);
    carry = cur >> sh;
    i = i + 1;
  }
  if (extend || carry > 0 as u64) {
    out = out.append(carry);
  }
  return out;
}

function __bi_shr_limbs(a: u64[], s: i32): u64[] {
  if (s == 0) {
    return a;
  }
  let mask: u64 = __bi_mask();
  let bs: u64 = s as u64;
  let out: u64[] = [];
  let i: i32 = 0;
  while (i < a.len()) {
    let cur: u64 = a[i] >> bs;
    if (i + 1 < a.len()) {
      cur = cur | a[i + 1] << 32 as u64 - bs & mask;
    }
    out = out.append(cur);
    i = i + 1;
  }
  return __bi_trim(out);
}

pub function (a: BigInt) to_string(): string {
  if (__bi_is_zero_mag(a.mag)) {
    return "0";
  }
  let mask: u64 = __bi_mask();
  let sh: u64 = __bi_sh32();
  let ten9: u64 = 1000000000 as u64;
  let cur: u64[] = a.mag;
  let n: i32 = cur.len();
  let chunks: u64[] = [];
  while (n > 0) {
    let rem: u64 = 0 as u64;
    let i: i32 = n - 1;
    while (i >= 0) {
      let c: u64 = rem << sh | cur[i] & mask;
      cur = cur.with(i, c / ten9);
      rem = c % ten9;
      i = i - 1;
    }
    chunks = chunks.append(rem);
    while (n > 0 && cur[n - 1] == 0 as u64) {
      n = n - 1;
    }
  }
  let top: u64 = chunks[chunks.len() - 1];
  let lead: i32 = 1;
  let t: u64 = top / (10 as u64);
  while (t > 0 as u64) {
    lead = lead + 1;
    t = t / (10 as u64);
  }
  let start: i32 = 0;
  if (a.neg) {
    start = 1;
  }
  let total: i32 = start + lead + 9 * (chunks.len() - 1);
  let out: u8[] = __alloc_u8(total);
  if (a.neg) {
    out = out.with(0, 45 as u8);
  }
  let pos: i32 = total - 1;
  let k: i32 = 0;
  while (k < chunks.len()) {
    let v: u64 = chunks[k];
    let width: i32 = 9;
    if (k == chunks.len() - 1) {
      width = lead;
    }
    let d: i32 = 0;
    while (d < width) {
      out = out.with(pos, (v % (10 as u64) + 48 as u64) as u8);
      v = v / (10 as u64);
      pos = pos - 1;
      d = d + 1;
    }
    k = k + 1;
  }
  return string_from_bytes_unchecked(out);
}
