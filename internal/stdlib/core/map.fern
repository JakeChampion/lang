// core/map — generic Map[K, V] runtime.
//
// Auto-injected `Map` (a single-field i32-wrapper struct
// holding a kv-buffer pointer) plus its IndexMap-shaped
// open-addressing core. The wat shims `__memcpy`, `__memset`,
// `__alloc`, `__load_i32`, `__store_i32`, plus the slice /
// struct ↔ i32 escape-hatch casts let the runtime live in
// lang without sacrificing the byte-level layout the
// existing test suite already pins down.
//
// Lang-side: declarations use `i32` for K / V because the
// language doesn't yet have generic methods. The checker
// keeps its existing generic FuncSigs registrations
// (`(Map[K,V], K, V) → void` etc.) and the IR rewrites
// `__method_Map_*` / `map_new` calls to these `_impl`
// counterparts at codegen time — same shape as the
// `__array_append_jsonvalue → __array_append_string` alias
// in internal/codegen/wasm/wasm_ir.go.
//
// kv buffer layout (Map's `data` field points here):
//
//   +0   cap     : i32 — bucket count, power-of-2, ≥ 4
//   +4   len     : i32 — live entry count
//   +8   keyKind : i32 — 0 = i32-sized scalar, 1 = string
//   +12  valKind : i32 — 0 = i32-scalar, 1 = non-array
//        pointer, 2 = array(plain elems), 3 = array(rc elems)
//   +16  buckets : i32[cap]            (-1 empty, -2 tombstone)
//   +16+cap*4  entries : (k,v)[cap]    per-entry stride = 2 * __ptr_width()
//                                      (8 on wasm32, 16 on arm64)
//
// Lives in `core/` rather than `std/` because the bodies are
// raw-memory implementations the user shouldn't reach for
// directly — user code calls `m.set(k, v)` / etc. and the
// IR rewrites those to the `_impl` functions here.
//
// Migrated from the auto-injected prelude per
// docs/PRELUDE-TO-MODULES.md.

pub function __map_pow2_ceil(n: i32): i32 {
    if (n <= 4) { return 4; }
    var p: i32 = 4;
    while (p < n) {
        if (p >= 1073741824) { return p; }   // saturate at 2^30
        p = p << 1;
    }
    return p;
}

// Hash function:
//   keyKind 0 (i32-sized scalar)        : Wang's integer mix.
//   keyKind 1 (string)                  : FNV-1a 32-bit over bytes.
//   keyKind 2 (wide-scalar boxed)       : Wang's integer mix
//                                         over both 32-bit halves
//                                         of the dereferenced i64.
// All three produce a 32-bit hash that callers mask down to
// `cap - 1` (cap is power-of-2). The unsigned shifts go
// through `as u32` because the lang's `>>` defaults to
// `i32.shr_s` on i32 operands.
// __map_hash hashes a Map key. The param stays `i32` (not
// `usize`) deliberately: the IR uses cell-pointer boxing
// for wide-scalar K (i64 / u64 / f64) so the pointer that
// arrives here always fits in 32 bits on the cell-pointer
// path. For native scalar K (i32 / u32) the value fits
// trivially. The string path casts back via `k as string`,
// which on natives is a no-op pointer reinterpret —
// truncation isn't an issue when the prelude itself ALSO
// runs with i32-sized pointer locals on the call chain
// (see the rest of the Map runtime above for the usize
// migration that started with map_new_impl).
//
// Keeping the param as i32 lets the wide-scalar Map tests
// continue to pass (the i32-narrow at the call boundary
// gives kBits the right bits whether k arrived through a
// usize-typed __map_lookup call or via the older i32 path).
// A future PR can flip this when the wide-scalar K path
// gets its own dedicated hash entrypoint.
pub function __map_hash(k: i32, keyKind: i32): i32 {
    var h: i32 = 0;
    if (keyKind == 0) {
        h = k ^ 61;
        h = h ^ (((h as u32) >> (16 as u32)) as i32);
        h = h + (h << 3);
        h = h ^ (((h as u32) >> (4 as u32)) as i32);
        h = h * 668265261;                      // 0x27d4eb2d
        h = h ^ (((h as u32) >> (15 as u32)) as i32);
        return h;
    }
    if (keyKind == 2) {
        // Wide-scalar key on a narrow-ptr target (wasm32):
        // `k` is a heap cell pointer, the actual 8-byte
        // value lives at *k. Fold the two 32-bit halves
        // together with XOR before Wang's mix so each
        // half contributes to bucket choice.
        var w: i64 = __load_i64(k as usize);
        var lo: i32 = w as i32;
        var hi: i32 = (w >> (32 as i64)) as i32;
        var m: i32 = lo ^ hi;
        m = m ^ 61;
        m = m ^ (((m as u32) >> (16 as u32)) as i32);
        m = m + (m << 3);
        m = m ^ (((m as u32) >> (4 as u32)) as i32);
        m = m * 668265261;                      // 0x27d4eb2d
        m = m ^ (((m as u32) >> (15 as u32)) as i32);
        return m;
    }
    h = 0 - 2128831035;                         // 0x811c9dc5 sign-flipped
    var s: string = k as string;
    var sLen: i32 = s.len();
    var i: i32 = 0;
    while (i < sLen) {
        h = h ^ s[i];
        h = h * 16777619;                       // 0x01000193
        i = i + 1;
    }
    return h;
}

pub function map_new_impl(cap_hint: i32, keyKind: i32, valKind: i32): usize {
    var cap: i32 = __map_pow2_ceil(cap_hint);
    var entryStride: i32 = 2 * __ptr_width();
    var buf: usize = __alloc(16 + cap * (4 + entryStride));
    __store_i32(buf,      cap);
    __store_i32(buf + 4,  0);
    __store_i32(buf + 8,  keyKind);
    __store_i32(buf + 12, valKind);
    __memset(buf + 16, 255, cap * 4);            // buckets → all -1
    // Map handle is a heap-allocated pointer cell. 8 bytes
    // accommodates a 64-bit `buf` pointer on arm64; wasm32
    // only needs 4 but the extra padding is cheap and keeps
    // the handle layout uniform across targets. Using
    // `__store_ptr` / `__load_ptr` (pointer-width helpers)
    // lets backends pick the right STR/LDR width. The handle
    // pointer itself rides through `usize` end-to-end so
    // arm64-darwin's >4 GiB heap addresses survive the
    // round-trip through every Map helper below.
    //
    // Phase 1e-runtime: 8-byte rc header at `[m - 8]` holds
    // the static-sentinel 0x80000000 so a future Phase 1e
    // predicate widening can inc/dec Map handles without
    // touching real rc machinery. Alloc bumps from 8 to 16
    // (8 sentinel + 8 buf cell); the returned `m` is base+8,
    // and all downstream `__load_ptr(m)` / `__store_ptr(m,
    // buf)` reads + writes hit the buf cell exactly as
    // before — they're at offset 0 of the data pointer.
    var base: usize = __alloc(16);
    __store_i32(base, 1);  // Phase 2d: live rc=1 (was 0x80000000 sentinel)
    var m: usize = base + 8;
    __store_ptr(m, buf);
    return m;
}

// __map_cow_inplace — Phase 2d copy-on-write seam, modelled on
// __lang_arr_cow_inplace. Returns a handle the caller may safely
// mutate:
//
//   - rc <= 1 (sole owner, or the immortal high-bit sentinel
//     which reads as a large negative i32): mutate in place,
//     return `m` unchanged.
//   - rc >  1 (aliased): deep-copy BOTH the handle cell AND the
//     kv buffer (a shallow handle copy would still share the
//     buffer and alias mutations), give the fresh handle rc=1,
//     and return it. The source handle's rc is left to the
//     normal dec-on-overwrite at the assignment site; under the
//     Phase-1 bump allocator nothing is freed, so the functional
//     isolation comes from the copy, not the exact rc.
//
// Borrowed-parameter model (PR #1280) is what makes this safe:
// passing a Map to a function no longer inc's the handle, so a
// map mutated through a borrow stays rc==1 and is mutated in
// place (visible to the caller). Only a genuine local alias
// (`var m2 = m1`) bumps rc above 1 and so triggers the copy.
pub function __map_cow_inplace(m: usize): usize {
    var rc: i32 = __load_i32(m - 8);
    if (rc <= 1) { return m; }
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var entryStride: i32 = 2 * __ptr_width();
    var bufBytes: i32 = 16 + cap * (4 + entryStride);
    var newBuf: usize = __alloc(bufBytes);
    __memcpy(newBuf, buf, bufBytes);
    var base: usize = __alloc(16);
    __store_i32(base, 1);
    var nm: usize = base + 8;
    __store_ptr(nm, newBuf);
    return nm;
}

pub function __map_len_impl(m: usize): i32 {
    var buf: usize = __load_ptr(m);
    return __load_i32(buf + 4);
}

// __map_lookup returns the entry index of the matching key,
// or -1 if not present. Linear probing over the bucket array,
// skipping tombstones (which keep probing valid past
// deletions).
pub function __map_lookup(m: usize, k: usize): i32 {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var keyKind: i32 = __load_i32(buf + 8);
    var mask: i32 = cap - 1;
    var entryStride: i32 = 2 * __ptr_width();
    var entriesBase: usize = buf + 16 + cap * 4;
    var bucket: i32 = __map_hash(k, keyKind) & mask;
    while (true) {
        var b: i32 = __load_i32(buf + 16 + bucket * 4);
        if (b == 0 - 1) { return 0 - 1; }
        if (b != 0 - 2) {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            var eq: boolean = false;
            if (keyKind == 0) {
                eq = entryK == k;
            } else if (keyKind == 2) {
                // Wide-scalar boxed keys: both `entryK` and
                // `k` are cell pointers, the live 8-byte
                // value sits at *cell. Deref and compare.
                eq = __load_i64(entryK) == __load_i64(k);
            } else {
                eq = (entryK as string) == (k as string);
            }
            if (eq) { return b; }
        }
        bucket = (bucket + 1) & mask;
    }
    return 0 - 1;       // unreachable
}

pub function __map_has_impl(m: usize, k: usize): boolean {
    return __map_lookup(m, k) != (0 - 1);
}

// __map_retain_val bumps the rc of a pointer-shaped value that
// map_drop will later free (valKind 2/3 = array values), so a
// value handed out via get / get_or / values / iter co-owns its
// storage and survives the map's drop (the read side of
// map-value reclamation). A no-op for scalar (0) and non-array
// pointer (1) values, which map_drop does not yet reclaim.
function __map_retain_val(buf: usize, v: usize): usize {
    if (__load_i32(buf + 12) >= 2) {
        return __fern_rc_inc(v);
    }
    return v;
}

pub function __map_get_impl(m: usize, k: usize): Option[usize] {
    var idx: i32 = __map_lookup(m, k);
    if (idx == 0 - 1) { return None; }
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    return Some(__map_retain_val(buf, __load_ptr(entriesBase + idx * entryStride + ptrW)));
}

pub function __map_get_or_impl(m: usize, k: usize, fallback: usize): usize {
    var idx: i32 = __map_lookup(m, k);
    if (idx == 0 - 1) { return fallback; }
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    return __map_retain_val(buf, __load_ptr(entriesBase + idx * entryStride + ptrW));
}

// __map_grow doubles the kv buffer's capacity and re-hashes
// every existing entry into the new bucket array. Updates
// the wrapper's data ptr in place; returns the new buffer
// for the inline caller. The old buffer is returned to the
// freelist once the entries are copied (see the __free at the
// end) — a no-op when the freelist is disabled.
pub function __map_grow(m: usize): usize {
    var oldBuf: usize = __load_ptr(m);
    var oldCap: i32 = __load_i32(oldBuf);
    var oldLen: i32 = __load_i32(oldBuf + 4);
    var oldKK:  i32 = __load_i32(oldBuf + 8);
    var oldVK:  i32 = __load_i32(oldBuf + 12);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var oldEntries: usize = oldBuf + 16 + oldCap * 4;
    var newCap: i32 = 4;
    if (oldCap != 0) { newCap = oldCap << 1; }
    var newMask: i32 = newCap - 1;
    var newBuf: usize = __alloc(16 + newCap * (4 + entryStride));
    __store_i32(newBuf,      newCap);
    __store_i32(newBuf + 4,  oldLen);
    __store_i32(newBuf + 8,  oldKK);
    __store_i32(newBuf + 12, oldVK);
    __memset(newBuf + 16, 255, newCap * 4);      // empty buckets
    var newEntries: usize = newBuf + 16 + newCap * 4;
    var i: i32 = 0;
    while (i < oldLen) {
        var key: usize = __load_ptr(oldEntries + i * entryStride);
        var val: usize = __load_ptr(oldEntries + i * entryStride + ptrW);
        __store_ptr(newEntries + i * entryStride,        key);
        __store_ptr(newEntries + i * entryStride + ptrW, val);
        var bucket: i32 = __map_hash(key, oldKK) & newMask;
        while (true) {
            var b: i32 = __load_i32(newBuf + 16 + bucket * 4);
            if (b == 0 - 1) {
                __store_i32(newBuf + 16 + bucket * 4, i);
                break;
            }
            bucket = (bucket + 1) & newMask;
        }
        i = i + 1;
    }
    __store_ptr(m, newBuf);
    // Return the old kv buffer to the freelist. After the repoint
    // above, oldBuf is unreferenced: the entries' key/value POINTERS
    // were copied into newBuf (the keys/values themselves live in
    // their own allocations, untouched), and the handle now points at
    // newBuf. __map_set_impl runs __map_cow_inplace first, so the map
    // is uniquely owned here — nothing else aliases oldBuf. `__free`
    // is a no-op when the freelist is disabled.
    var oldBytes: i32 = 16 + oldCap * (4 + entryStride);
    __free(oldBuf, oldBytes);
    return newBuf;
}

pub function __map_set_impl(m: usize, k: usize, v: usize): usize {
    m = __map_cow_inplace(m);
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    // 75% load factor: trigger when (len + 1) * 4 >= cap * 3.
    if ((len_ + 1) * 4 >= cap * 3) {
        __map_grow(m);
        buf = __load_ptr(m);
        cap = __load_i32(buf);
        len_ = __load_i32(buf + 4);
    }
    var keyKind: i32 = __load_i32(buf + 8);
    var mask: i32 = cap - 1;
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var bucket: i32 = __map_hash(k, keyKind) & mask;
    var insertSlot: i32 = 0 - 1;
    var done: boolean = false;
    while (!done) {
        var b: i32 = __load_i32(buf + 16 + bucket * 4);
        if (b == 0 - 1) {
            if (insertSlot == 0 - 1) { insertSlot = bucket; }
            done = true;
        } else if (b == 0 - 2) {
            if (insertSlot == 0 - 1) { insertSlot = bucket; }
            bucket = (bucket + 1) & mask;
        } else {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            var eq: boolean = false;
            if (keyKind == 0) {
                eq = entryK == k;
            } else if (keyKind == 2) {
                eq = __load_i64(entryK) == __load_i64(k);
            } else {
                eq = (entryK as string) == (k as string);
            }
            if (eq) {
                __store_ptr(entriesBase + b * entryStride + ptrW, v);
                return m;
            }
            bucket = (bucket + 1) & mask;
        }
    }
    // Append entry at index = len.
    __store_ptr(entriesBase + len_ * entryStride,        k);
    __store_ptr(entriesBase + len_ * entryStride + ptrW, v);
    __store_i32(buf + 16 + insertSlot * 4, len_);
    __store_i32(buf + 4, len_ + 1);
    return m;
}

// Snapshot a column (keys or values) into a freshly-allocated
// length-prefixed array. `kvOffset` selects the column within
// each entry; `destStride` is the byte stride of the result
// array's element type (4 for i32-sized, ptr-width for
// pointer-shaped). Insertion order preserved up to any
// deletions (swap-with-last reorders past the deleted slot).
//
// Two-mode dispatch on destStride: i32-stride uses i32 loads/
// stores (low 32 bits of the entry slot, which IS the value
// when K/V is i32); pointer-stride uses __load_ptr / __store_
// ptr so the full heap address survives on arm64.
pub function __map_column(m: usize, kvOffset: i32, destStride: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var entryStride: i32 = 2 * __ptr_width();
    var entriesBase: usize = buf + 16 + cap * 4;
    // Header layout: length prefix lives at `data - 4` so
    // `len(arr)` works on the returned data pointer. When
    // destStride > 4 (pointer-stride arrays on arm64) the
    // first element must be stride-aligned, so the header
    // grows to destStride bytes with the length packed into
    // the last 4 of them.
    var hdr: i32 = 4;
    if (destStride > 4) { hdr = destStride; }
    var arr: usize = __alloc(hdr + len_ * destStride);
    __store_i32(arr + hdr - 4, len_);
    var i: i32 = 0;
    while (i < len_) {
        if (destStride == 4) {
            var v32: i32 = __load_i32(entriesBase + i * entryStride + kvOffset);
            __store_i32(arr + hdr + i * 4, v32);
        } else {
            var vp: usize = __load_ptr(entriesBase + i * entryStride + kvOffset);
            __store_ptr(arr + hdr + i * destStride, vp);
        }
        i = i + 1;
    }
    return arr + hdr;
}

pub function __map_keys_impl(m: usize): usize {
    var buf: usize = __load_ptr(m);
    var keyKind: i32 = __load_i32(buf + 8);
    if (keyKind == 1) {
        return __map_string_column(m, 0, 0);
    }
    return __map_column(m, 0, 4);
}

pub function __map_values_impl(m: usize): usize {
    var buf: usize = __load_ptr(m);
    var valKind: i32 = __load_i32(buf + 12);
    var ptrW: i32 = __ptr_width();
    // valKind != 0 == pointer-shaped (1 = string/struct/enum,
    // 2/3 = array values); all take the pointer-column path.
    // Array values (>= 2) are retained per element so the
    // snapshot co-owns storage map_drop will free.
    if (valKind != 0) {
        var retain: i32 = 0;
        if (valKind >= 2) { retain = 1; }
        return __map_string_column(m, ptrW, retain);
    }
    return __map_column(m, ptrW, 4);
}

// __map_string_column builds a fresh `string[]` snapshot of
// the Map's K or V column. Each entry slot holds a cell-
// pointer (Map K/V boxing); we deref each one via the
// `cellPtr as string` cast (which emits OpLoad{WidthString}
// on two-word targets and is a no-op on legacy native single-
// pointer-string targets) and push the resulting string into
// a growing `string[]`. Per-element stride is whatever the
// IR computes for `string[]` on this target (8 bytes on
// wasm32, 16 on flipped arm64, 8 on legacy native).
pub function __map_string_column(m: usize, kvOffset: i32, retainVals: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var out: string[] = [];
    var i: i32 = 0;
    while (i < len_) {
        var cellPtr: usize = __load_ptr(entriesBase + i * entryStride + kvOffset);
        // Array values (valKind 2/3) handed out via values() must
        // co-own their storage so map_drop's free doesn't strand
        // the snapshot's element pointers.
        if (retainVals == 1) { cellPtr = __fern_rc_inc(cellPtr); }
        var s: string = cellPtr as string;
        out = out.push(s);
        i = i + 1;
    }
    return out as usize;
}

// __map_drop_values frees the array-typed value column when a Map
// is dropped at its LAST reference. The IR emits a call to this
// just before the (unchanged, 1-arg) __fern_map_drop, so it
// guards on the handle rc itself (at [m-8]): only the last
// reference (rc==1) frees the values — a shared map (rc>1) or a
// static-sentinel handle (negative rc) leaves them untouched,
// matching __fern_map_drop's own rc==1 free of the buf+handle.
// valKind 2 = array of plain elements (arr_dec frees the buffer);
// valKind 3 = array of rc-tracked elements (drop_arr_ptr recurses
// one level then frees). valStride is the value element stride the
// IR computed from V. valKind 0/1 (scalar / non-array pointer)
// leave the column alone — those values still leak. Each value's
// rc was bumped on store (inc-on-set) and on every read
// (inc-on-get), so this dec is the balancing release.
pub function __map_drop_values(m: usize, valStride: i32) {
    if (__load_i32(m - 8) != 1) { return; }
    var buf: usize = __load_ptr(m);
    var vk: i32 = __load_i32(buf + 12);
    if (vk < 2) { return; }
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var i: i32 = 0;
    while (i < len_) {
        var v: usize = __load_ptr(entriesBase + i * entryStride + ptrW);
        if (vk == 3) {
            __fern_drop_arr_ptr(v, valStride);
        } else {
            __fern_arr_dec(v, valStride);
        }
        i = i + 1;
    }
}

pub function __map_delete_impl(m: usize, k: usize): boolean {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var keyKind: i32 = __load_i32(buf + 8);
    var mask: i32 = cap - 1;
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var bucket: i32 = __map_hash(k, keyKind) & mask;
    var foundBucket: i32 = 0 - 1;
    var idx: i32 = 0;
    while (true) {
        var b: i32 = __load_i32(buf + 16 + bucket * 4);
        if (b == 0 - 1) { break; }
        if (b != 0 - 2) {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            var eq: boolean = false;
            if (keyKind == 0) {
                eq = entryK == k;
            } else if (keyKind == 2) {
                eq = __load_i64(entryK) == __load_i64(k);
            } else {
                eq = (entryK as string) == (k as string);
            }
            if (eq) {
                foundBucket = bucket;
                idx = b;
                break;
            }
        }
        bucket = (bucket + 1) & mask;
    }
    if (foundBucket == 0 - 1) { return false; }
    // Tombstone the bucket so subsequent probes skip past it.
    __store_i32(buf + 16 + foundBucket * 4, 0 - 2);
    var last: i32 = len_ - 1;
    if (idx != last) {
        // Swap-with-last in the entries array, then patch the
        // moved entry's bucket pointer to its new index. The
        // last entry is alive (about to be removed) so the
        // probe will hit it.
        var lastKey: usize = __load_ptr(entriesBase + last * entryStride);
        var lastBucket: i32 = __map_hash(lastKey, keyKind) & mask;
        while (__load_i32(buf + 16 + lastBucket * 4) != last) {
            lastBucket = (lastBucket + 1) & mask;
        }
        var lastVal: usize = __load_ptr(entriesBase + last * entryStride + ptrW);
        __store_ptr(entriesBase + idx * entryStride,        lastKey);
        __store_ptr(entriesBase + idx * entryStride + ptrW, lastVal);
        __store_i32(buf + 16 + lastBucket * 4, idx);
    }
    __store_i32(buf + 4, last);
    return true;
}

pub function __map_clear_impl(m: usize) {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    __store_i32(buf + 4, 0);
    __memset(buf + 16, 255, cap * 4);
}

// MapIter is a 16-byte heap object: [buf:8][cursor:4][pad:4].
// The cursor lives at offset +8 (not +4) so the layout is the
// same on wasm32 (where __store_ptr is 4 bytes and the high 4
// bytes of the buf slot are wasted padding) and arm64 (where
// __store_ptr is the full 8-byte STR). Same idea as the Map
// handle: pick a layout that fits the widest pointer and pad
// on narrow targets.
//
// Phase 1e-runtime: 8-byte rc header at `[it - 8]` holds the
// static-sentinel 0x80000000. Alloc bumps from 16 to 24 (8
// sentinel + 16 iter payload); the returned `it` = base + 8.
// All `__mapiter_*` accesses are offsets from `it`, unchanged.
pub function __map_iter_impl(m: usize): usize {
    var base: usize = __alloc(24);
    __store_i32(base, 0 - 2147483647 - 1);  // 0x80000000 sentinel
    var it: usize = base + 8;
    __store_ptr(it,     __load_ptr(m));     // data ptr
    __store_i32(it + 8, 0);                  // cursor
    return it;
}

pub function __mapiter_has_next_impl(it: usize): boolean {
    var buf: usize = __load_ptr(it);
    var i: i32 = __load_i32(it + 8);
    return i < __load_i32(buf + 4);
}

// Shared address arithmetic for MapIter.key() / .value().
pub function __mapiter_entry_addr(it: usize): usize {
    var buf: usize = __load_ptr(it);
    var cap: i32 = __load_i32(buf);
    var i: i32 = __load_i32(it + 8);
    var entryStride: i32 = 2 * __ptr_width();
    return buf + 16 + cap * 4 + i * entryStride;
}

pub function __mapiter_key_impl(it: usize): usize {
    return __load_ptr(__mapiter_entry_addr(it));
}

pub function __mapiter_value_impl(it: usize): usize {
    return __map_retain_val(__load_ptr(it), __load_ptr(__mapiter_entry_addr(it) + __ptr_width()));
}

pub function __mapiter_advance_impl(it: usize) {
    __store_i32(it + 8, __load_i32(it + 8) + 1);
}
