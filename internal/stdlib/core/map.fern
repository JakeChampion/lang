// core/map — generic Map[K, V] runtime.
//
// The `Map` type (a single-field i32-wrapper struct
// holding a kv-buffer pointer) plus its IndexMap-shaped
// open-addressing core. The wat shims `__memcpy`, `__memset`,
// `__alloc`, `__load_i32`, `__store_i32`, plus the slice /
// struct ↔ i32 escape-hatch casts let the runtime live in
// lang without sacrificing the byte-level layout the
// existing test suite already pins down.
//
// Lang-side: declarations use `i32` for K / V because the
// language doesn't yet have generic methods. The checker
// keeps its existing generic FuncSigs registrations
// (`(Map[K,V], K, V) → void` etc.) and the IR rewrites
// `__method_Map_*` / `map_new` calls to these `_impl`
// counterparts at codegen time — same shape as the
// `__array_append_jsonvalue → __array_append_string` alias
// in internal/codegen/wasm/wasm_ir.go.
//
// kv buffer layout (Map's `data` field points here):
//
//   +0   cap     : i32 — bucket count, power-of-2, ≥ 4
//   +4   len     : i32 — live entry count
//   +8   keyKind : i32 — 0 = i32-sized scalar, 1 = string,
//        2 = wide-scalar-boxed (i64/f64 on a narrow-ptr target),
//        3 = user struct/enum key (hashed/compared via its derived
//        hash/eq, threaded in per call — see the keyKind-3 section)
//   +12  valTag : i32 — low byte = valKind (0 = i32-scalar,
//        1 = non-array pointer, 2 = array(plain elems),
//        3 = array(rc elems)); high bytes = value element
//        stride for kinds 2/3 (see mapValTag / __map_val_*)
//   +16  hashSeed : i32 — per-process string-hash seed, 0 = unseeded
//        (string keys only — see __map_seed / #6194)
//   +20  pad      : i32 — keeps the entry column 8-byte aligned
//   +24  buckets : i32[cap]            (-1 empty, -2 tombstone)
//   +24+cap*4  entries : (k,v)[cap]    per-entry stride = 2 * __ptr_width()
//                                      (8 on wasm32, 16 on arm64)
//
// Lives in `core/` rather than `std/` because the bodies are
// raw-memory implementations the user shouldn't reach for
// directly — user code calls `m.insert(k, v)` / etc. and the
// IR rewrites those to the `_impl` functions here.
//
// Iteration order (the contract every consumer relies on):
//
//   `insert` appends each NEW key to the end of the `entries`
//   array, so a map built by inserts alone iterates — via the
//   MapIter cursor (`for (k, v) in m`, `keys()`, `values()`,
//   `entries()`) — in INSERTION order. Re-inserting an existing
//   key overwrites in place and does NOT move it.
//
//   This holds only until the first `delete`. Delete is
//   swap-with-last (`__map_delete_impl` / the keyKind-3 twin):
//   the removed slot is backfilled with the array's LAST live
//   entry, so that entry jumps to the deleted position and the
//   sequence is no longer insertion order. There is no
//   order-preserving delete (a shift-down `delete_ordered` is a
//   possible future addition, #4388) and no shrink/rehash.
//
//   Consumers that depend on ordered iteration must therefore
//   only rely on it for delete-free maps. `std/json`'s
//   `json_encode` emits a `JObject`'s keys straight off this
//   cursor, so its output preserves input/insertion key order
//   for a map that was never deleted from, but a post-delete map
//   serialises with the swapped key order.

pub function __map_pow2_ceil(n: i32): i32 {
    if (n <= 4) { return 4; }
    var p: i32 = 4;
    while (p < n) {
        if (p >= 1073741824) { return p; }   // saturate at 2^30
        p = p << 1;
    }
    return p;
}

// __map_hdr_bytes returns the kv-buffer header size for a given key
// kind. Every kind — scalar / string / wide-boxed (0 / 1 / 2) and the
// user struct/enum key (kind 3) — uses the same 24-byte header (cap,
// len, keyKind, valTag, hashSeed, pad); buckets start at +24. The user
// key's derived hash/eq are threaded in as per-call function VALUES
// (there is no usize->fn cast; E033), NOT stored in the buffer, so
// kind 3 needs no extra header slots. The helper is retained (rather
// than inlining the constant at every site) so a future
// store-in-buffer optimisation can re-widen one kind's header without
// touching the ~20 offset sites. See #2671.
//
// The header widened 16 -> 24 for the hash seed (#6194). The pad at
// +20 keeps the buckets 8-byte aligned, which the entry column (two
// pointer-width slots) needs on arm64: an odd multiple of 4 before a
// cap*4 bucket array would leave the entries at a 4-byte offset.
pub function __map_hdr_bytes(keyKind: i32): i32 {
    return 24;
}

// __map_hdr reads the kv buffer's keyKind (at +8) and returns its
// header size — the buf-having counterpart to __map_hdr_bytes.
function __map_hdr(buf: usize): i32 {
    return __map_hdr_bytes(__load_i32(buf + 8));
}

// __map_seed reads the kv buffer's per-map hash seed (at +16).
//
// ZERO MEANS UNSEEDED, and that convention is load-bearing in two
// places: it makes an unseeded map hash byte-identically to the
// pre-#6194 implementation (__map_fnv_str_seeded's basis is the FNV
// offset basis XOR the seed), and it is what lets __map_bucket_hash
// pick between the seeded string hash and the caller-supplied
// `hash_fn` with a single compare and no extra function value.
//
// ONLY STRING-KEYED MAPS (keyKind 1) EVER CARRY A NONZERO SEED —
// map_new_impl is the only writer and seeds nothing else. That is the
// invariant __map_bucket_hash relies on when it reinterprets the key
// as a string on the seeded path: a scalar / wide / user-struct key
// reaching that branch would hash a non-string as a string. Seeding a
// user-struct key would need the seed threaded into the key type's
// derived `hash`, which is codegen's to do, not this module's.
function __map_seed(buf: usize): i32 {
    return __load_i32(buf + 16);
}

// Hash function:
//   keyKind 0 (i32-sized scalar)        : Wang's integer mix.
//   keyKind 1 (string)                  : FNV-1a 32-bit over bytes.
//   keyKind 2 (wide-scalar boxed)       : Wang's integer mix
//                                         over both 32-bit halves
//                                         of the dereferenced i64.
// All three produce a 32-bit hash that callers mask down to
// `cap - 1` (cap is power-of-2). The unsigned shifts go
// through `as u32` because the lang's `>>` defaults to
// `i32.shr_s` on i32 operands.
// __map_hash hashes a Map key. It is now SCALAR-ONLY: `k` is a
// native i32 / u32 key value, hashed directly. The former
// string (`k as string`) and wide-scalar (`k as usize` +
// __load_i64) branches were the #5042 "i32-param footgun" — a
// 32-bit param reinterpreted as a pointer, which truncated the
// high 32 bits once the heap crossed 4 GiB (arm64-darwin). They
// are dead since #5052 moved every non-scalar key onto its own
// honest `usize`-param adapter (__map_hash_str / __map_hash_wide,
// below), so no caller passes keyKind 1 / 2 here anymore. Removing
// them is the "future PR can flip this" the old doc anticipated,
// and it clears the last `i32 as string` reinterpret in the
// stdlib (unblocking the E064 checker rule — #5053). keyKind is
// kept in the signature for pub-ABI stability (treeshake keep-alive
// roots name __map_hash) even though only the scalar path remains.
// __map_wang_mix runs Wang's 32-bit integer mix (the bucket-choice
// hash for scalar and wide-scalar-folded keys). Shared by __map_hash
// and the default keyed-path adapters (#4388 item 1).
function __map_wang_mix(k: i32): i32 {
    var h: i32 = k ^ 61;
    h = h ^ (((h as u32) >> (16 as u32)) as i32);
    h = h + (h << 3);
    h = h ^ (((h as u32) >> (4 as u32)) as i32);
    h = h * 668265261;                          // 0x27d4eb2d
    h = h ^ (((h as u32) >> (15 as u32)) as i32);
    return h;
}

// __map_fnv_str_seeded is the string-key bucket hash: FNV-1a over 4-byte
// blocks, finished with a murmur3 fmix32 avalanche, over a seeded offset
// basis. Reached through __map_bucket_hash.
//
// Two changes from the textbook byte-at-a-time FNV-1a this replaced:
//
//   1. FOUR BYTES PER MULTIPLY. The mix runs once per 4-byte block instead of
//      once per byte; the loads and shifts that assemble the block are cheap
//      next to the multiply. (Assembling the word from four indexed loads is
//      deliberate: reading 4 bytes at once would need a raw pointer into the
//      string and an unaligned load, which is a portability question this
//      does not need to open.)
//
//   2. A FINAL AVALANCHE. Callers mask the result with `cap - 1` to pick a
//      bucket, so only the LOW bits are ever read — and low-bit diffusion is
//      FNV-1a's known weakness, since its multiply propagates influence
//      upward while a trailing byte's xor only perturbs the bottom 8. The
//      fmix32 tail spreads high-bit entropy back down before the mask sees
//      it, at a fixed cost of three multiplies per hash rather than per byte.
//
// MEASURED, so the trade is visible rather than assumed. Bucket occupancy
// moves close to the ideal for a uniform hash: 1000 short keys into 1024
// buckets fill 618 of them versus 562 before (ideal ~638), and 512
// common-prefix keys into 1024 fill 402 versus 392 (ideal ~403). End to end
// that is worth about 3-5% on a map-lookup-heavy benchmark (4000
// identifier-shaped keys, 60 lookup passes: 58-60 ms before, 56-58 ms after),
// because hashing is only one part of a lookup alongside probing and key
// comparison. It is NOT a 4x win, even though the per-block mix is 4x cheaper
// than the per-byte one — the fixed fmix32 tail eats much of that back, and
// for keys of 1-3 bytes it is a net INCREASE in multiplies, bought in
// exchange for the better spread.
//
// The hash is used only to choose a bucket within a live process — it is
// never persisted, compared across platforms, or exposed — so changing it
// affects distribution only. Iteration order is unaffected: entries live in
// an insertion-ordered array and the cursor walks that, not the buckets.
//
// SEEDING (#6194): the `seed` argument is XORed into the FNV offset basis, so
// `seed == 0` reproduces the unseeded hash EXACTLY — the pre-#6194 bucket
// layout is the seed-0 case of this function, not a separate code path. A
// nonzero seed enters the compression rather than post-mixing the result,
// which is the only placement that helps: post-mixing is a function of the
// hash, so `h(a) == h(b)` implies `mix(h(a)) == mix(h(b))` and every
// precomputed collision survives it.
//
// FNV-with-a-seeded-basis is NOT SipHash, and the difference matters against
// different attackers. It defeats OFFLINE precomputation, which is the whole
// of the practical hash-flooding attack: the collision set has to be computed
// against the live seed, and the seed is drawn per process. It does NOT
// defeat an attacker with an online oracle — FNV is invertible, so measurable
// per-request timing feedback can recover the seed and the attack resumes.
// SipHash-1-3 behind the same seed slot is the upgrade, and it is a drop-in
// here: nothing outside this function depends on how the seed is consumed.
function __map_fnv_str_seeded(s: string, seed: i32): i32 {
    var h: u32 = (2166136261 as u32) ^ (seed as u32);   // 0x811c9dc5, FNV offset basis
    var prime: u32 = 16777619 as u32;           // 0x01000193
    var sLen: i32 = s.len();
    var i: i32 = 0;
    while (i + 4 <= sLen) {
        var w: u32 = (s[i] as u32)
                   | ((s[i + 1] as u32) << (8 as u32))
                   | ((s[i + 2] as u32) << (16 as u32))
                   | ((s[i + 3] as u32) << (24 as u32));
        h = (h ^ w) * prime;
        i = i + 4;
    }
    while (i < sLen) {
        h = (h ^ (s[i] as u32)) * prime;
        i = i + 1;
    }
    // fmix32 — spread high-bit entropy down into the bits the bucket mask reads.
    h = h ^ (h >> (16 as u32));
    h = h * (2246822507 as u32);                // 0x85ebca6b
    h = h ^ (h >> (13 as u32));
    h = h * (3266489909 as u32);                // 0xc2b2ae35
    h = h ^ (h >> (16 as u32));
    return h as i32;
}

pub function __map_hash(k: i32, keyKind: i32): i32 {
    return __map_wang_mix(k);
}

pub function map_new_impl(cap_hint: i32, keyKind: i32, valKind: i32): usize {
    var cap: i32 = __map_pow2_ceil(cap_hint);
    var entryStride: i32 = 2 * __ptr_width();
    var hdr: i32 = __map_hdr_bytes(keyKind);
    var buf: usize = __alloc(hdr + cap * (4 + entryStride));
    __store_i32(buf,      cap);
    __store_i32(buf + 4,  0);
    __store_i32(buf + 8,  keyKind);
    __store_i32(buf + 12, valKind);
    // Hash seed (#6194) — string keys only, see __map_seed. The seed is
    // per PROCESS, not per map: __map_hash_seed() draws once from the same
    // CSPRNG as random_i32 and caches, so this is a load rather than a
    // syscall on every map after the first.
    //
    // Attacker-controlled strings reaching a Map is the ordinary case for
    // Fern's edge-handler workload — header, query, and JSON-object keys all
    // land here — so this defaults ON rather than waiting to be opted into.
    // An opt-in seed would have to be threaded through map literals,
    // `map.from`, and `json.parse` to reach the keys that actually need it,
    // which is exactly the surface an attacker picks.
    //
    // Safe to vary run to run because BUCKET ORDER IS NOT OBSERVABLE:
    // entries live in an insertion-ordered array and every iteration path
    // (`keys` / `values` / `entries` / the MapIter cursor) walks that array,
    // never the bucket table. std/json's key-order preservation rides on the
    // same property and is unaffected.
    var seed: i32 = 0;
    if (keyKind == 1) { seed = __map_hash_seed(); }
    __store_i32(buf + 16, seed);
    __store_i32(buf + 20, 0);                     // pad — keeps buckets 8-byte aligned
    __memset(buf + hdr, 255, cap * 4);            // buckets → all -1
    // Map handle is a heap-allocated pointer cell. 8 bytes
    // accommodates a 64-bit `buf` pointer on arm64; wasm32
    // only needs 4 but the extra padding is cheap and keeps
    // the handle layout uniform across targets. Using
    // `__store_ptr` / `__load_ptr` (pointer-width helpers)
    // lets backends pick the right STR/LDR width. The handle
    // pointer itself rides through `usize` end-to-end so
    // arm64-darwin's >4 GiB heap addresses survive the
    // round-trip through every Map helper below.
    //
    // Phase 1e-runtime: 8-byte rc header at `[m - 8]` holds
    // the static-sentinel 0x80000000 so a future Phase 1e
    // predicate widening can inc/dec Map handles without
    // touching real rc machinery. Alloc bumps from 8 to 16
    // (8 sentinel + 8 buf cell); the returned `m` is base+8,
    // and all downstream `__load_ptr(m)` / `__store_ptr(m,
    // buf)` reads + writes hit the buf cell exactly as
    // before — they're at offset 0 of the data pointer.
    var base: usize = __alloc(16);
    __store_i32(base, 1);  // Phase 2d: live rc=1 (was 0x80000000 sentinel)
    var m: usize = base + 8;
    __store_ptr(m, buf);
    return m;
}

// __map_cow_inplace — Phase 2d copy-on-write seam, modelled on
// __lang_arr_cow_inplace. Returns a handle the caller may safely
// mutate:
//
//   - rc <= 1 (sole owner, or the immortal high-bit sentinel
//     which reads as a large negative i32): mutate in place,
//     return `m` unchanged.
//   - rc >  1 (aliased): deep-copy BOTH the handle cell AND the
//     kv buffer (a shallow handle copy would still share the
//     buffer and alias mutations), give the fresh handle rc=1,
//     and return it. The source handle's rc is left to the
//     normal dec-on-overwrite at the assignment site; under the
//     Phase-1 bump allocator nothing is freed, so the functional
//     isolation comes from the copy, not the exact rc.
//
// Borrowed-parameter model (PR #1280) is what makes this safe:
// passing a Map to a function no longer inc's the handle, so a
// map mutated through a borrow stays rc==1 and is mutated in
// place (visible to the caller). Only a genuine local alias
// (`var m2 = m1`) bumps rc above 1 and so triggers the copy.
pub function __map_cow_inplace(m: usize): usize {
    var rc: i32 = __load_i32(m - 8);
    if (rc <= 1) { return m; }
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var entryStride: i32 = 2 * __ptr_width();
    var bufBytes: i32 = __map_hdr(buf) + cap * (4 + entryStride);
    var newBuf: usize = __alloc(bufBytes);
    __memcpy(newBuf, buf, bufBytes);
    __map_own_copied_cols(newBuf);
    var base: usize = __alloc(16);
    __store_i32(base, 1);
    var nm: usize = base + 8;
    __store_ptr(nm, newBuf);
    return nm;
}

// __map_own_copied_cols gives a freshly-__memcpy'd kv buffer its own claim on
// the pointer-shaped columns it would otherwise share with the buffer it came
// from. Both copies reach rc==1 independently, so both deep drops run and the
// first one to fire takes the other's memory with it.
//
// A string KEY slot means two different things across the two string ABIs, and
// __map_own_key covers both. Array VALUES are counted on every target, so one
// inc each is the whole claim — __map_retain_val's own kind guard decides
// which values get it.
//
// Struct values (valKind 4) are left shared: their deep drop is the IR-generated
// __drop_map_struct_<T> at the map local, and matching it needs the same
// per-field walk in the inc direction (#6242).
function __map_own_copied_cols(buf: usize): void {
    var ownKeys: boolean = __load_i32(buf + 8) == 1;
    var retainVals: boolean = __map_val_kind(buf) >= 2;
    if (!ownKeys && !retainVals) { return; }
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + __map_hdr(buf) + cap * 4;
    var i: i32 = 0;
    while (i < len_) {
        var slot: usize = entriesBase + i * entryStride;
        if (ownKeys) { __store_ptr(slot, __map_own_key(__load_ptr(slot))); }
        if (retainVals) { __map_retain_val(buf, __load_ptr(slot + ptrW)); }
        i = i + 1;
    }
}

// __map_own_key turns a shared string-key slot value into one this map owns.
//
// On a two-word-string target the slot holds a (data, len) cell that
// __drop_map_str_keys frees OUTRIGHT — it carries no refcount of its own — so
// a second owner needs a cell of its own. `as string` then `as usize` reboxes
// into exactly that, but it copies the two words WITHOUT counting them, and
// the drop behind each cell releases the bytes: the inc is what keeps the
// second release from being an over-release.
//
// On a single-word target there is no cell at all — the slot is the string
// data pointer, and the rebox hands back the very same pointer, which is what
// tells the two ABIs apart at runtime. The inc alone is the whole claim there,
// and it is the exact inverse of the __fern_rc_dec that column's drop emits.
//
// Both incs are the rc-guarded one: an inline (SSO) or static-sentinel key has
// nothing to count, and its drop releases nothing either.
function __map_own_key(slot: usize): usize {
    var boxed: usize = (slot as string) as usize;
    if (boxed == slot) { return __fern_rc_inc(slot); }
    __fern_rc_inc(__load_ptr(boxed));
    return boxed;
}

// __map_clone unconditionally deep-copies a Map handle — the rc>1 branch
// of __map_cow_inplace, but always taken. It produces a fresh handle (rc=1)
// over a freshly-copied kv buffer, fully independent of the source.
//
// Used by container construction (issue #2763): when a struct field of Map
// type is initialised by a COW mutator result (`Struct { m: s.m.insert(...) }`),
// that result may be the SAME handle the borrowed source still owns (the COW
// mutates in place at rc==1). Storing it into the new container without copying
// makes the two structs alias one buffer; dropping the old one then frees it
// out from under the new one — a use-after-free. Cloning gives the new
// container its own buffer so the lifetimes are independent. The columns are
// claimed by __map_own_copied_cols, exactly as in __map_cow_inplace.
pub function __map_clone(m: usize): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var entryStride: i32 = 2 * __ptr_width();
    var bufBytes: i32 = __map_hdr(buf) + cap * (4 + entryStride);
    var newBuf: usize = __alloc(bufBytes);
    __memcpy(newBuf, buf, bufBytes);
    __map_own_copied_cols(newBuf);
    var base: usize = __alloc(16);
    __store_i32(base, 1);
    var nm: usize = base + 8;
    __store_ptr(nm, newBuf);
    return nm;
}

pub function __map_len_impl(m: usize): i32 {
    var buf: usize = __load_ptr(m);
    return __load_i32(buf + 4);
}

// ---- default hash/eq (builtin key kinds) -----------------------------
//
// The probe/grow/set/delete machinery lives ONCE, in the `_keyed` family
// below, parameterized by `hash_fn` / `eq_fn` function values. The
// non-keyed entry points (the builtin i32 / wide-scalar / string key
// paths the IR calls directly) are thin dispatchers that read the map's
// keyKind and feed these default adapters in — #4388 item 1 collapsed
// the former eight near-verbatim body twins onto the keyed family.
//
// The adapters are named top-level functions (no captures, statically
// allocated closure cells — no per-call environment). They take the key
// as `usize` and hash/compare it DIRECTLY (via __map_wang_mix /
// __map_fnv_str_seeded / __load_i64): routing through `__map_hash(k as i32, …)`
// here would TRUNCATE a 64-bit string/cell pointer before the
// `k as string` reconstruction and silently probe the wrong bucket —
// exactly the i32-param footgun __map_hash's own doc describes (#5042
// root cause; the legacy monomorphic bodies only avoided it because a
// usize argument passed to the i32 param happened to keep the full
// register width).
function __map_hash_scalar(k: usize): i32 { return __map_wang_mix(k as i32); }
function __map_eq_scalar(a: usize, b: usize): boolean { return a == b; }
function __map_hash_wide(k: usize): i32 {
    var w: i64 = __load_i64(k);
    var lo: i32 = w as i32;
    var hi: i32 = (w >> (32 as i64)) as i32;
    return __map_wang_mix(lo ^ hi);
}
function __map_eq_wide(a: usize, b: usize): boolean { return __load_i64(a) == __load_i64(b); }
function __map_hash_str(k: usize): i32 { return __map_fnv_str_seeded(k as string, 0); }
function __map_eq_str(a: usize, b: usize): boolean { return (a as string) == (b as string); }

// __map_bucket_hash picks the bucket hash for one probe. It is the ONLY place
// the seed is consumed, so every probe/grow/set/delete site agrees by
// construction.
//
// The `seed` argument always comes from __map_seed(buf) at the call site —
// never threaded down from a caller. That is deliberate, and it is what makes
// a whole class of bug unrepresentable: a probe and a grow that disagreed
// about the seed would not corrupt the map, they would REHASH IT UNSEEDED and
// carry on working, silently losing the defence with no failing lookup to
// notice it. Reading from the buffer at each site leaves nothing to disagree
// about. (Confirmed the hard way: an earlier shape that passed the seed down
// as a parameter survived deliberately zeroing it at the grow call, because
// the grow wrote its zero into the new header and everything downstream then
// agreed on "unseeded".)
//
// Threading the seed as a plain i32 alongside the existing `hash_fn` function
// value — rather than replacing `hash_fn` with a seed-taking one — is what
// keeps this change inside this module. The `_keyed` entry points below are
// named by all six backends (`__method_Map_set_keyed` and friends resolve to
// `__map_set_keyed_impl`), so their `(usize) => i32` hash-function signature is
// part of the compiler/stdlib contract; widening it to `(usize, i32) => i32`
// would mean an arity change in every emitter for a seed that only the string
// path ever uses.
//
// Correctness rests on __map_seed's invariant that only keyKind 1 carries a
// nonzero seed: the seeded branch reinterprets `k` as a string, which is sound
// for a string key and nothing else. Scalar, wide, and user-struct keys hold a
// zero seed and so always take `hash_fn`.
function __map_bucket_hash(k: usize, hash_fn: (usize) => i32, seed: i32): i32 {
    if (seed != 0) { return __map_fnv_str_seeded(k as string, seed); }
    return hash_fn(k);
}

// __map_lookup returns the entry index of the matching key, or -1 if
// not present (probing details: __map_lookup_keyed).
pub function __map_lookup(m: usize, k: usize): i32 {
    var keyKind: i32 = __load_i32(__load_ptr(m) + 8);
    if (keyKind == 0) { return __map_lookup_keyed(m, k, __map_hash_scalar, __map_eq_scalar); }
    if (keyKind == 2) { return __map_lookup_keyed(m, k, __map_hash_wide, __map_eq_wide); }
    return __map_lookup_keyed(m, k, __map_hash_str, __map_eq_str);
}

pub function __map_has_impl(m: usize, k: usize): boolean {
    return __map_lookup(m, k) != (0 - 1);
}

// __map_val_kind / __map_val_stride unpack the value tag stored
// at buf+12 by map_new: the low byte is the valKind (0 = scalar,
// 1 = non-array pointer, 2 = plain-elem array, 3 = rc-elem
// array); for kinds 2/3 the high bytes carry the value element
// stride in bytes (the IR's mapValTag).
function __map_val_kind(buf: usize): i32 {
    return __load_i32(buf + 12) & 255;
}
function __map_val_stride(buf: usize): i32 {
    return __load_i32(buf + 12) >> 8;
}

// __map_dec_value releases one array-typed value (valKind 2/3) at
// the value element stride from the buf: arr_dec for plain-elem
// arrays, drop_arr_ptr (recurse one level) for rc-elem arrays.
// rc-aware — frees only at the value's last reference, so an
// outstanding inc-on-get borrow stays alive. No-op for scalar /
// non-array values.
function __map_dec_value(buf: usize, v: usize): void {
    var vk: i32 = __map_val_kind(buf);
    if (vk != 2 && vk != 3) { return; }
    var stride: i32 = __map_val_stride(buf);
    if (vk == 3) {
        __fern_drop_arr_ptr(v, stride);
    } else {
        __fern_arr_dec(v, stride);
    }
}

// __map_retain_val bumps the rc of a pointer-shaped value that
// map_drop will later free (valKind 2/3 = array values), so a
// value handed out via get / get_or / values / iter co-owns its
// storage and survives the map's drop (the read side of
// map-value reclamation). A no-op for scalar (0) and non-array
// pointer (1) values, which map_drop does not yet reclaim.
function __map_retain_val(buf: usize, v: usize): usize {
    if (__map_val_kind(buf) >= 2) {
        return __fern_rc_inc(v);
    }
    return v;
}

// __map_val_at loads the VALUE slot of entry `idx` — no retain, no
// bounds check (callers pass a __map_lookup* hit). The shared tail of
// get / get_or / lookup_val in BOTH key families (#4388 item 1's safe
// piece — the probe-loop collapse itself is blocked on #5042).
function __map_val_at(m: usize, idx: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var ptrW: i32 = __ptr_width();
    var entriesBase: usize = buf + __map_hdr(buf) + cap * 4;
    return __load_ptr(entriesBase + idx * (2 * ptrW) + ptrW);
}

pub function __map_get_impl(m: usize, k: usize): Option[usize] {
    var idx: i32 = __map_lookup(m, k);
    if (idx == 0 - 1) { return None; }
    return Some(__map_retain_val(__load_ptr(m), __map_val_at(m, idx)));
}

pub function __map_get_or_impl(m: usize, k: usize, fallback: usize): usize {
    var idx: i32 = __map_lookup(m, k);
    if (idx == 0 - 1) { return fallback; }
    return __map_retain_val(__load_ptr(m), __map_val_at(m, idx));
}

// __map_lookup_val returns the stored VALUE pointer for key k, or 0 if
// the key is absent — WITHOUT retaining it. The IR's overwrite pre-drop
// (struct/enum-valued maps) calls this just before `m.insert(k, v2)` to
// deep-drop the old value v1 that the set is about to replace, which the
// type-erased runtime overwrite-dec (__map_dec_value) can't do for those
// kinds. No retain: the returned pointer is consumed by the deep-drop,
// not handed to the program.
pub function __map_lookup_val(m: usize, k: usize): usize {
    var idx: i32 = __map_lookup(m, k);
    if (idx == 0 - 1) { return 0; }
    return __map_val_at(m, idx);
}

// __map_grow doubles the kv buffer's capacity and re-hashes every
// existing entry into the new bucket array (details: __map_grow_keyed,
// the single implementation). Dispatcher over the builtin key kinds.
pub function __map_grow(m: usize): usize {
    var keyKind: i32 = __load_i32(__load_ptr(m) + 8);
    if (keyKind == 0) { return __map_grow_keyed(m, __map_hash_scalar); }
    if (keyKind == 2) { return __map_grow_keyed(m, __map_hash_wide); }
    return __map_grow_keyed(m, __map_hash_str);
}

// Insert / overwrite (details: __map_set_keyed_impl, the single
// implementation — CoW, 75% load-factor grow, tombstone reuse, and the
// overwrite-dec of a replaced array value). Dispatcher over the builtin
// key kinds.
pub function __map_set_impl(m: usize, k: usize, v: usize): usize {
    var keyKind: i32 = __load_i32(__load_ptr(m) + 8);
    if (keyKind == 0) { return __map_set_keyed_impl(m, k, v, __map_hash_scalar, __map_eq_scalar); }
    if (keyKind == 2) { return __map_set_keyed_impl(m, k, v, __map_hash_wide, __map_eq_wide); }
    return __map_set_keyed_impl(m, k, v, __map_hash_str, __map_eq_str);
}

// Snapshot a column (keys or values) into a freshly-allocated
// length-prefixed array. `kvOffset` selects the column within
// each entry; `destStride` is the byte stride of the result
// array's element type (4 for i32-sized, ptr-width for
// pointer-shaped). Insertion order preserved up to any
// deletions (swap-with-last reorders past the deleted slot).
//
// Two-mode dispatch on destStride: i32-stride uses i32 loads/
// stores (low 32 bits of the entry slot, which IS the value
// when K/V is i32); pointer-stride uses __load_ptr / __store_
// ptr so the full heap address survives on arm64.
pub function __map_column(m: usize, kvOffset: i32, destStride: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var entryStride: i32 = 2 * __ptr_width();
    var entriesBase: usize = buf + __map_hdr(buf) + cap * 4;
    // Standard rc-array layout: a 16-byte header carrying capacity
    // (data-12), rc=1 (data-8) and length (data-4); data = arr + hdr.
    // Without the cap/rc slots the snapshot's scope-exit drop reads
    // heap-allocator metadata at data-8 as the refcount and underflows.
    // (When destStride > 16 the header grows to destStride so the first
    // element stays stride-aligned, matching ArrayLit.)
    var hdr: i32 = 16;
    if (destStride > 16) { hdr = destStride; }
    var arr: usize = __alloc(hdr + len_ * destStride);
    __store_i32(arr + hdr - 12, len_);   // capacity
    __store_i32(arr + hdr - 8, 1);       // rc = 1
    __store_i32(arr + hdr - 4, len_);    // length
    var i: i32 = 0;
    while (i < len_) {
        if (destStride == 4) {
            var v32: i32 = __load_i32(entriesBase + i * entryStride + kvOffset);
            __store_i32(arr + hdr + i * 4, v32);
        } else {
            var vp: usize = __load_ptr(entriesBase + i * entryStride + kvOffset);
            __store_ptr(arr + hdr + i * destStride, vp);
        }
        i = i + 1;
    }
    return arr + hdr;
}

// __map_keys_impl / __map_values_impl back `m.keys()` / `m.values()`.
// COST: each call ALLOCATES a fresh length-prefixed array snapshot of the
// column and retains every element — O(n) time + memory PER CALL. Calling
// either in a loop (or re-evaluating `for k in m.keys()`) re-snapshots each
// time. For the common "visit every entry" case use `for (k, v) in m`, which
// rides the MapIter cursor (__map_iter_impl) with NO per-iteration allocation.
// Use keys()/values() only when a materialised K[]/V[] is actually needed
// (sort / index / outlive the map). #2688; snapshot-free general protocol: #2686.
pub function __map_keys_impl(m: usize): usize {
    var buf: usize = __load_ptr(m);
    var keyKind: i32 = __load_i32(buf + 8);
    if (keyKind == 1) {
        return __map_string_column(m, 0);
    }
    // Struct / enum (keyKind 3) keys are single heap pointers stored in
    // the key column, so the snapshot is a pointer-stride `K[]` — NOT
    // the 4-byte i32 column below (which would truncate the pointer and
    // crash a consumer that dereferences it). Each key is retained so
    // the snapshot co-owns it alongside the map (#2671).
    if (keyKind == 3) {
        return __map_ptr_column(m, 0, 1);
    }
    return __map_column(m, 0, 4);
}

pub function __map_values_impl(m: usize): usize {
    var buf: usize = __load_ptr(m);
    var valKind: i32 = __map_val_kind(buf);
    var ptrW: i32 = __ptr_width();
    // Array values (valKind 2/3) are single heap pointers, so the
    // snapshot must be a pointer-stride array (ptrW) — NOT a
    // string-shaped one. string_column lays out two-word string
    // slots (8 on wasm32, 16 on flipped arm64), which would
    // mis-stride an i32[][] / string[][] snapshot and read out of
    // bounds on those targets (x86 only works because its string
    // is single-word). Each value is retained so the snapshot
    // co-owns storage map_drop will free.
    if (valKind >= 2) {
        return __map_ptr_column(m, ptrW, 1);
    }
    // string / struct / enum values: string-shaped column.
    if (valKind == 1) {
        return __map_string_column(m, ptrW);
    }
    return __map_column(m, ptrW, 4);
}

// __map_ptr_column snapshots a single-pointer column (array /
// struct / enum values) into a fresh pointer-element array laid out
// EXACTLY as the IR's rc-arrays are: a 16-byte header
// (headerBytes = max(16, stride); stride = ptrW here) with
// cap@data-12, rc@data-8, len@data-4, and one heap pointer per
// element at ptrW stride. That stride is what the consumer reads a
// V[][] back at — unlike string_column's two-word string slots
// (8 on wasm32, 16 on flipped arm64), which mis-stride a
// pointer-element snapshot and read out of bounds. The full header
// (rc=1, cap=len) is what lets the snapshot's own drop_arr_ptr free
// the buffer + dec its elements. retainVals==1 bumps each pointer's
// rc so the snapshot co-owns storage the map will free; the
// snapshot's drop balances that.
pub function __map_ptr_column(m: usize, kvOffset: i32, retainVals: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + __map_hdr(buf) + cap * 4;
    var base: usize = __alloc(16 + len_ * ptrW);
    __store_i32(base + 4, len_);   // cap   (= data - 12)
    __store_i32(base + 8, 1);      // rc=1  (= data - 8)
    __store_i32(base + 12, len_);  // len   (= data - 4)
    var data: usize = base + 16;
    var i: i32 = 0;
    while (i < len_) {
        var vp: usize = __load_ptr(entriesBase + i * entryStride + kvOffset);
        if (retainVals == 1) { vp = __fern_rc_inc(vp); }
        __store_ptr(data + i * ptrW, vp);
        i = i + 1;
    }
    return data;
}

// __map_string_column builds a fresh `string[]` snapshot of
// the Map's K or V column. Each entry slot holds a cell-
// pointer (Map K/V boxing); we deref each one via the
// `cellPtr as string` cast (which emits OpLoad{WidthString}
// on two-word targets and is a no-op on legacy native single-
// pointer-string targets) and push the resulting string into
// a growing `string[]`. Per-element stride is whatever the
// IR computes for `string[]` on this target (8 bytes on
// wasm32, 16 on flipped arm64, 8 on legacy native).
pub function __map_string_column(m: usize, kvOffset: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + __map_hdr(buf) + cap * 4;
    var out: string[] = [];
    var i: i32 = 0;
    while (i < len_) {
        var cellPtr: usize = __load_ptr(entriesBase + i * entryStride + kvOffset);
        var s: string = cellPtr as string;
        out = out.append(s);
        i = i + 1;
    }
    // `out as usize` severs the escape analysis, so the rc pass drops
    // `out` (a string[] local) at function exit even though it escapes
    // via the return. Retain the buffer once so that exit-drop balances
    // and the caller receives a live array. __map_column / __map_ptr_column
    // dodge this by returning a raw __alloc pointer, not a typed local.
    return __fern_rc_inc(out as usize);
}

// __map_drop_values frees the array-typed value column when a Map
// is dropped at its LAST reference. The IR emits a call to this
// just before the (1-arg) __fern_map_drop, so it guards on the
// handle rc itself (at [m-8]): only the last reference (rc==1)
// frees the values — a shared map (rc>1) or a static-sentinel
// handle (negative rc) leaves them untouched, matching
// __fern_map_drop's own rc==1 free of the buf+handle. The value
// element stride is read from the buf's packed valKind tag
// (__map_dec_value). valKind 0/1 (scalar / non-array pointer)
// leave the column alone — those values still leak. Each value's
// rc was bumped on store (inc-on-set) and on every read
// (inc-on-get), so this dec is the balancing release.
pub function __map_drop_values(m: usize): usize {
    // Null / low-address guard, mirroring __fern_map_drop: an
    // owned-Map slot can be unset on some path at the exit sweep.
    // Dereferencing m-8 without this traps. Returns m so the IR's
    // OpCallDirect/OpDrop pops a real value (matching every other
    // drop helper), not a void-call phantom.
    if (m < 65536) { return m; }
    if (__load_i32(m - 8) != 1) { return m; }
    var buf: usize = __load_ptr(m);
    var vk0: i32 = __map_val_kind(buf);
    // Only array values (2/3) are reclaimed here. Struct values (kind 4)
    // are deep-dropped by the IR-generated __drop_map_struct_<T> at the
    // map LOCAL's drop; a struct-valued map reached as a field / capture
    // routes through here and must NOT misread its struct pointers as
    // arrays — skip. Scalar (0) / other-pointer (1) leave the column.
    if (vk0 != 2 && vk0 != 3) { return m; }
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + __map_hdr(buf) + cap * 4;
    var i: i32 = 0;
    while (i < len_) {
        __map_dec_value(buf, __load_ptr(entriesBase + i * entryStride + ptrW));
        i = i + 1;
    }
    return m;
}

// Delete by key: tombstone the bucket, swap-with-last in the entries
// array (which is what breaks insertion-order iteration after a delete —
// see the module header's "Iteration order" contract, #4388). Details:
// __map_delete_keyed_impl, the single implementation. Dispatcher over
// the builtin key kinds.
pub function __map_delete_impl(m: usize, k: usize): boolean {
    var keyKind: i32 = __load_i32(__load_ptr(m) + 8);
    if (keyKind == 0) { return __map_delete_keyed_impl(m, k, __map_hash_scalar, __map_eq_scalar); }
    if (keyKind == 2) { return __map_delete_keyed_impl(m, k, __map_hash_wide, __map_eq_wide); }
    return __map_delete_keyed_impl(m, k, __map_hash_str, __map_eq_str);
}

pub function __map_clear_impl(m: usize): void {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    __store_i32(buf + 4, 0);
    __memset(buf + __map_hdr(buf), 255, cap * 4);
}

// ---- the keyed family: THE map implementation ------------------------
//
// Every probe / grow / set / delete lives here, parameterized by
// `hash_fn` / `eq_fn` function values. Two callers feed it:
//
//   - keyKind 3 (user struct / enum keys, #2671): such a key is
//     pointer-shaped (stored in the entries column exactly like a string
//     key), but the type-erased runtime can't hash or compare it
//     structurally, so the codegen threads the key type's derived
//     `hash(self): i32` / `eq(self, other): boolean` in as function
//     values. The functions can't be stored in the kv buffer (there is
//     no usize→fn cast; E033), so they're passed per call.
//
//   - the builtin key kinds (i32 / wide-scalar / string): the non-keyed
//     `__map_*` entry points above are thin dispatchers feeding the
//     `__map_hash_scalar`/… default adapters in (#4388 item 1 — these
//     used to be eight near-verbatim body twins of this family).

function __map_lookup_keyed(m: usize, k: usize, hash_fn: (usize) => i32, eq_fn: (usize, usize) => boolean): i32 {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var mask: i32 = cap - 1;
    var entryStride: i32 = 2 * __ptr_width();
    var entriesBase: usize = buf + __map_hdr(buf) + cap * 4;

    // Small maps skip hashing entirely and scan the entry array.
    //
    // Delete is swap-with-last, so entries [0, len) are all live with no
    // tombstones — a scan is exactly equivalent to a probe, and returns the
    // same entry index. Below the threshold it is also FASTER: hashing a key
    // costs more than a handful of key comparisons, and the whole entry array
    // is a cache line or two. Measured on a 6-entry string-keyed map, 1.2M
    // lookups: 213 ms through hash-and-probe, 96 ms scanning — ~2.2x. (That
    // comparison uses query strings built separately from the stored keys, so
    // it is not an artefact of pointer-equal fast paths in `eq_fn`.)
    //
    // The threshold is deliberately modest: the scan is O(len) per lookup, so
    // it must not extend to sizes where the probe's O(1) wins. Eight keeps it
    // to at most eight comparisons and matches the size where a table this
    // small is dominated by the fixed cost of hashing anyway.
    var len_: i32 = __load_i32(buf + 4);
    if (len_ <= 8) {
        var j: i32 = 0;
        while (j < len_) {
            var scanK: usize = __load_ptr(entriesBase + j * entryStride);
            if (eq_fn(scanK, k)) { return j; }
            j = j + 1;
        }
        return 0 - 1;
    }

    var bucket: i32 = __map_bucket_hash(k, hash_fn, __map_seed(buf)) & mask;
    while (true) {
        var b: i32 = __load_i32(buf + __map_hdr(buf) + bucket * 4);
        if (b == 0 - 1) { return 0 - 1; }
        if (b != 0 - 2) {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            if (eq_fn(entryK, k)) { return b; }
        }
        bucket = (bucket + 1) & mask;
    }
    return 0 - 1;
}

pub function __map_has_keyed_impl(m: usize, k: usize, hash_fn: (usize) => i32, eq_fn: (usize, usize) => boolean): boolean {
    return __map_lookup_keyed(m, k, hash_fn, eq_fn) != (0 - 1);
}

pub function __map_get_keyed_impl(m: usize, k: usize, hash_fn: (usize) => i32, eq_fn: (usize, usize) => boolean): Option[usize] {
    var idx: i32 = __map_lookup_keyed(m, k, hash_fn, eq_fn);
    if (idx == 0 - 1) { return None; }
    return Some(__map_retain_val(__load_ptr(m), __map_val_at(m, idx)));
}

pub function __map_get_or_keyed_impl(m: usize, k: usize, fallback: usize, hash_fn: (usize) => i32, eq_fn: (usize, usize) => boolean): usize {
    var idx: i32 = __map_lookup_keyed(m, k, hash_fn, eq_fn);
    if (idx == 0 - 1) { return fallback; }
    return __map_retain_val(__load_ptr(m), __map_val_at(m, idx));
}

pub function __map_lookup_val_keyed(m: usize, k: usize, hash_fn: (usize) => i32, eq_fn: (usize, usize) => boolean): usize {
    var idx: i32 = __map_lookup_keyed(m, k, hash_fn, eq_fn);
    if (idx == 0 - 1) { return 0; }
    return __map_val_at(m, idx);
}

function __map_grow_keyed(m: usize, hash_fn: (usize) => i32): usize {
    var oldBuf: usize = __load_ptr(m);
    var seed: i32 = __map_seed(oldBuf);
    var oldCap: i32 = __load_i32(oldBuf);
    var oldLen: i32 = __load_i32(oldBuf + 4);
    var oldKK:  i32 = __load_i32(oldBuf + 8);
    var oldVK:  i32 = __load_i32(oldBuf + 12);
    var hdr: i32 = __map_hdr_bytes(oldKK);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var oldEntries: usize = oldBuf + hdr + oldCap * 4;
    var newCap: i32 = 4;
    if (oldCap != 0) { newCap = oldCap << 1; }
    var newMask: i32 = newCap - 1;
    var newBuf: usize = __alloc(hdr + newCap * (4 + entryStride));
    __store_i32(newBuf,      newCap);
    __store_i32(newBuf + 4,  oldLen);
    __store_i32(newBuf + 8,  oldKK);
    __store_i32(newBuf + 12, oldVK);
    __store_i32(newBuf + 16, seed);   // a grow must not change the map's hash
    __store_i32(newBuf + 20, 0);
    __memset(newBuf + hdr, 255, newCap * 4);
    var newEntries: usize = newBuf + hdr + newCap * 4;
    var i: i32 = 0;
    while (i < oldLen) {
        var key: usize = __load_ptr(oldEntries + i * entryStride);
        var val: usize = __load_ptr(oldEntries + i * entryStride + ptrW);
        __store_ptr(newEntries + i * entryStride,        key);
        __store_ptr(newEntries + i * entryStride + ptrW, val);
        var bucket: i32 = __map_bucket_hash(key, hash_fn, seed) & newMask;
        while (true) {
            var b: i32 = __load_i32(newBuf + hdr + bucket * 4);
            if (b == 0 - 1) {
                __store_i32(newBuf + hdr + bucket * 4, i);
                break;
            }
            bucket = (bucket + 1) & newMask;
        }
        i = i + 1;
    }
    __store_ptr(m, newBuf);
    var oldBytes: i32 = hdr + oldCap * (4 + entryStride);
    __free(oldBuf, oldBytes);
    return newBuf;
}

pub function __map_set_keyed_impl(m: usize, k: usize, v: usize, hash_fn: (usize) => i32, eq_fn: (usize, usize) => boolean): usize {
    m = __map_cow_inplace(m);
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    if ((len_ + 1) * 4 >= cap * 3) {
        __map_grow_keyed(m, hash_fn);
        buf = __load_ptr(m);
        cap = __load_i32(buf);
        len_ = __load_i32(buf + 4);
    }
    var mask: i32 = cap - 1;
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + __map_hdr(buf) + cap * 4;
    var bucket: i32 = __map_bucket_hash(k, hash_fn, __map_seed(buf)) & mask;
    var insertSlot: i32 = 0 - 1;
    var done: boolean = false;
    while (!done) {
        var b: i32 = __load_i32(buf + __map_hdr(buf) + bucket * 4);
        if (b == 0 - 1) {
            if (insertSlot == 0 - 1) { insertSlot = bucket; }
            done = true;
        } else if (b == 0 - 2) {
            if (insertSlot == 0 - 1) { insertSlot = bucket; }
            bucket = (bucket + 1) & mask;
        } else {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            if (eq_fn(entryK, k)) {
                __map_dec_value(buf, __load_ptr(entriesBase + b * entryStride + ptrW));
                __store_ptr(entriesBase + b * entryStride + ptrW, v);
                return m;
            }
            bucket = (bucket + 1) & mask;
        }
    }
    __store_ptr(entriesBase + len_ * entryStride,        k);
    __store_ptr(entriesBase + len_ * entryStride + ptrW, v);
    __store_i32(buf + __map_hdr(buf) + insertSlot * 4, len_);
    __store_i32(buf + 4, len_ + 1);
    return m;
}

pub function __map_delete_keyed_impl(m: usize, k: usize, hash_fn: (usize) => i32, eq_fn: (usize, usize) => boolean): boolean {
    var buf: usize = __load_ptr(m);
    var seed: i32 = __map_seed(buf);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var mask: i32 = cap - 1;
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + __map_hdr(buf) + cap * 4;
    var bucket: i32 = __map_bucket_hash(k, hash_fn, seed) & mask;
    var foundBucket: i32 = 0 - 1;
    var idx: i32 = 0;
    while (true) {
        var b: i32 = __load_i32(buf + __map_hdr(buf) + bucket * 4);
        if (b == 0 - 1) { break; }
        if (b != 0 - 2) {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            if (eq_fn(entryK, k)) {
                foundBucket = bucket;
                idx = b;
                break;
            }
        }
        bucket = (bucket + 1) & mask;
    }
    if (foundBucket == 0 - 1) { return false; }
    __store_i32(buf + __map_hdr(buf) + foundBucket * 4, 0 - 2);
    var last: i32 = len_ - 1;
    if (idx != last) {
        // Swap-with-last (keyKind-3 twin of __map_delete_impl) —
        // breaks insertion-order iteration after a delete, same
        // as the scalar path. See the module header's "Iteration
        // order" contract (#4388).
        var lastKey: usize = __load_ptr(entriesBase + last * entryStride);
        var lastBucket: i32 = __map_bucket_hash(lastKey, hash_fn, seed) & mask;
        while (__load_i32(buf + __map_hdr(buf) + lastBucket * 4) != last) {
            lastBucket = (lastBucket + 1) & mask;
        }
        var lastVal: usize = __load_ptr(entriesBase + last * entryStride + ptrW);
        __store_ptr(entriesBase + idx * entryStride,        lastKey);
        __store_ptr(entriesBase + idx * entryStride + ptrW, lastVal);
        __store_i32(buf + __map_hdr(buf) + lastBucket * 4, idx);
    }
    __store_i32(buf + 4, last);
    return true;
}

// MapIter is a 16-byte heap object: [buf:8][cursor:4][pad:4].
// The cursor lives at offset +8 (not +4) so the layout is the
// same on wasm32 (where __store_ptr is 4 bytes and the high 4
// bytes of the buf slot are wasted padding) and arm64 (where
// __store_ptr is the full 8-byte STR). Same idea as the Map
// handle: pick a layout that fits the widest pointer and pad
// on narrow targets.
//
// Phase 1e-runtime: 8-byte rc header at `[it - 8]` holds the
// static-sentinel 0x80000000. Alloc bumps from 16 to 24 (8
// sentinel + 16 iter payload); the returned `it` = base + 8.
// All `__mapiter_*` accesses are offsets from `it`, unchanged.
pub function __map_iter_impl(m: usize): usize {
    var base: usize = __alloc(24);
    __store_i32(base, 0 - 2147483647 - 1);  // 0x80000000 sentinel
    var it: usize = base + 8;
    __store_ptr(it,     __load_ptr(m));     // data ptr
    __store_i32(it + 8, 0);                  // cursor
    return it;
}

pub function __mapiter_has_next_impl(it: usize): boolean {
    var buf: usize = __load_ptr(it);
    var i: i32 = __load_i32(it + 8);
    return i < __load_i32(buf + 4);
}

// Shared address arithmetic for MapIter.key() / .value().
pub function __mapiter_entry_addr(it: usize): usize {
    var buf: usize = __load_ptr(it);
    var cap: i32 = __load_i32(buf);
    var i: i32 = __load_i32(it + 8);
    var entryStride: i32 = 2 * __ptr_width();
    return buf + __map_hdr(buf) + cap * 4 + i * entryStride;
}

pub function __mapiter_key_impl(it: usize): usize {
    return __load_ptr(__mapiter_entry_addr(it));
}

pub function __mapiter_value_impl(it: usize): usize {
    return __map_retain_val(__load_ptr(it), __load_ptr(__mapiter_entry_addr(it) + __ptr_width()));
}

pub function __mapiter_advance_impl(it: usize): void {
    __store_i32(it + 8, __load_i32(it + 8) + 1);
}

// === higher-level Map verbs (#2685) =============================
//
// Built on the core builtins above (`keys` / `get` / `insert` /
// `len` / `map_new`). These are ordinary element-polymorphic Fern —
// they work for every K / V the map supports and need no codegen
// support — so they live alongside the runtime that backs them
// rather than in a separate module (which would double-bind the
// `map` import name against `core/map`).

// `m.entries()` — every key/value pair as a fresh `(K, V)[]`, in the
// map's iteration order. One call instead of zipping `keys()` with a
// per-key `get()` (or driving the `iter()` cursor by hand). Empty map
// → empty array.
pub function (m: Map[K, V]) entries(): (K, V)[] {
    var out: (K, V)[] = [];
    // Ride the MapIter cursor (`for (k, v) in m`) rather than snapshotting
    // `keys()` and re-`get()`ing each key: the cursor visits the columns in
    // the same storage order with NO per-call `K[]` snapshot and no per-key
    // hash lookup — O(n) with a single pass instead of O(n) lookups plus an
    // O(n) throwaway array. Order is unchanged (#4388).
    for (k, v) in m {
        out = out.append((k, v));
    }
    return out;
}

// `m.merge(other)` — a fresh map with all of `m`'s entries plus all of
// `other`'s; on a key present in both, `other`'s value wins (last-write
// semantics, matching a left-to-right `insert` fold). Neither input is
// mutated.
pub function (m: Map[K, V]) merge(other: Map[K, V]): Map[K, V] {
    var out: Map[K, V] = m;
    // Same cursor rewrite as `entries()`: fold `other`'s pairs in storage
    // order off the MapIter cursor rather than a `keys()` snapshot + per-key
    // `get()`. Left-to-right order preserved, so other-wins semantics are
    // unchanged (#4388).
    for (k, v) in other {
        out = out.insert(k, v);
    }
    return out;
}

// `m.extend(other)` — synonym for `merge`, named for the in-place
// "add all of other" intuition even though (like every map op) it
// returns a fresh value rather than mutating.
pub function (m: Map[K, V]) extend(other: Map[K, V]): Map[K, V] {
    return m.merge(other);
}

// `from(pairs)` — build a `Map[K, V]` from a `(K, V)[]`. Later pairs
// overwrite earlier ones on a duplicate key. (A free function rather
// than `Map::from` until associated-function namespacing lands, #2700;
// call it qualified: `map.from(pairs)`.)
pub function from[K, V](pairs: (K, V)[]): Map[K, V] {
    var m: Map[K, V] = map_new(pairs.len());
    for p in pairs {
        m = m.insert(p.0, p.1);
    }
    return m;
}

// `m.get_or_insert(k, fallback)` — insert-if-absent in a single lookup,
// the value-type-friendly shape of Roc's `Dict.update` for the common
// "default then use" case. Returns `(map, value)`: if `k` is present,
// the map is unchanged and its existing value is returned; otherwise
// `fallback` is inserted and returned. Threading the map back out keeps
// the map's value semantics (`insert` yields a fresh map) explicit:
//
//     var (m2, n) = counts.get_or_insert(key, 0);
//     m = m2.insert(key, n + 1);
pub function (m: Map[K, V]) get_or_insert(k: K, fallback: V): (Map[K, V], V) {
    match (m.get(k)) {
        Some(v) => { return (m, v); },
        None => {
            var m2: Map[K, V] = m.insert(k, fallback);
            return (m2, fallback);
        }
    }
}

// `m.update(k, init, fn)` — insert-or-modify in a single pass, the
// counting/grouping shape of Roc's `Dict.update`. The slot's current value
// (or `init` when `k` is absent) is fed through `fn`, and the result is
// stored under `k`. Returns the fresh map (map ops yield a new value). The
// classic word-count loop collapses to:
//
//     for w in words { counts = counts.update(w, 0, function (c: i32): i32 { return c + 1; }); }
pub function (m: Map[K, V]) update(k: K, init: V, fn: (V) => V): Map[K, V] {
    var cur: V = m.get_or(k, init);
    return m.insert(k, fn(cur));
}

// `m.contains_value(target)` — true iff some key maps to `target`. The value
// counterpart of `has` (which tests keys). Linear scan over the value column;
// `target` is compared with `==`, so V must be an equatable type (i32 /
// string — the value types the map supports). Empty map → false.
pub function (m: Map[K, V]) contains_value(target: V): boolean {
    for v in m.values() {
        if (v == target) { return true; }
    }
    return false;
}
