// core/cmp — the comparison + display trait foundation.
//
// Three small traits underpin the generic assertion helpers in
// `std/test` (and any user code that wants to abstract over
// "printable" / "comparable" values):
//
//   - `Display` — `(v).to_string()` for an error / log message.
//   - `Eq`      — value equality (`a.eq(b)`).
//   - `Ord`     — total ordering via `a.cmp(b)` returning -1 / 0 / 1
//                 (the std/sort convention).
//
// The primitive impls live here, in the trait's own module, which
// satisfies the orphan rule (an impl is legal in the trait's module or
// the type's module). The `Display` impls for the numeric types and
// `string` are empty — those types already carry a `to_string` method
// (from `std/i32` … and `std/string`), and an empty impl simply records
// that the type satisfies the trait by adopting its existing method.
// See docs/TRAITS.md.

import "std/i32";
import "std/i64";
import "std/u32";
import "std/u64";
import "std/float";
import "std/string";
// For the lexicographic `impl Ord for string` (reuses the tested
// byte-order comparator rather than re-deriving it).
import "std/sort";

pub trait Display {
    function to_string(self: Self): string;
}

pub trait Eq {
    function eq(self: Self, other: Self): boolean;
}

// `cmp(a, b)` returns -1 when a < b, 0 when equal, 1 when a > b — the
// same shape std/sort's comparators use, so an `Ord` type drops
// straight into a sort.
pub trait Ord {
    function cmp(self: Self, other: Self): i32;
}

// `hash(v)` returns a 32-bit hash of the value. Pairs with `Eq` under
// the usual law: `a == b ⇒ a.hash() == b.hash()`. `@derive(Hash)`
// composes field/variant-wise through `h = h * 31 + f.hash()`, so a
// type is hashable as soon as its fields are. The foundation for
// user-type Map keys / `Set[T]`.
pub trait Hash {
    function hash(self: Self): i32;
}

// `Default.default()` is an *associated function* (no `self`): it builds a
// type's zero value, called as `Type.default()`. `@derive(Default)`
// composes field/variant-wise — scalars use their zero literal, nominal
// fields delegate to their own `default()`, and an enum defaults to its
// first variant — so a type has a default as soon as its fields do.
pub trait Default {
    function default(): Self;
}

// `Debug.to_debug()` is developer/diagnostic formatting, distinct from
// `Display` (user-facing). `@derive(Debug)` renders the STRUCTURAL form —
// `Name { f: <debug f>, … }` for structs, `Variant(<debug payload>)` for
// enums — composing field/variant-wise through each field's own `Debug`.
// The one difference from the derived `Display` is that **strings are
// quoted** (`"hi"` not `hi`), so a debug dump is unambiguous. This is the
// `{:?}` half of the Display/Debug split (and the clean shape for
// `assert_eq[T: Eq + Debug]` in the test runner). See docs/TRAITS.md.
pub trait Debug {
    function to_debug(self: Self): string;
}

// ---- Display ---------------------------------------------------
// Numeric + string types already have `to_string`; empty impls adopt
// it. `boolean` and `u8` do not, so they get real bodies — `u8` is the
// byte type (`s[i]`, #5629) and has no scalar module of its own.

impl Display for i32 { }
impl Display for i64 { }
impl Display for u32 { }
impl Display for u64 { }
impl Display for f64 { }
impl Display for f32 { }
impl Display for string { }

// `u8` has no scalar module, so no `to_string` to adopt — it widens to
// i32 and borrows that one. Without this a byte cannot reach any
// `[T: Display]` generic, which is what `assert_eq` on two bytes needs.
impl Display for u8 {
    function to_string(self: Self): string { return (self as i32).to_string(); }
}

impl Display for boolean {
    function to_string(self: Self): string {
        if (self) { return "true"; }
        return "false";
    }
}

// ---- Eq --------------------------------------------------------

impl Eq for i32 {
    function eq(self: Self, other: Self): boolean { return self == other; }
}
impl Eq for i64 {
    function eq(self: Self, other: Self): boolean { return self == other; }
}
impl Eq for u32 {
    function eq(self: Self, other: Self): boolean { return self == other; }
}
impl Eq for u64 {
    function eq(self: Self, other: Self): boolean { return self == other; }
}
impl Eq for u8 {
    function eq(self: Self, other: Self): boolean { return self == other; }
}
impl Eq for string {
    function eq(self: Self, other: Self): boolean { return self == other; }
}
impl Eq for boolean {
    function eq(self: Self, other: Self): boolean { return self == other; }
}
impl Eq for f64 {
    function eq(self: Self, other: Self): boolean { return self == other; }
}
impl Eq for f32 {
    function eq(self: Self, other: Self): boolean { return self == other; }
}

// ---- Ord -------------------------------------------------------
// Relational comparison for the integer types. (string / boolean
// ordering isn't needed by the assertion helpers, so it's left for a
// follow-up.)

impl Ord for i32 {
    function cmp(self: Self, other: Self): i32 {
        if (self < other) { return 0 - 1; }
        if (self > other) { return 1; }
        return 0;
    }
}
impl Ord for i64 {
    function cmp(self: Self, other: Self): i32 {
        if (self < other) { return 0 - 1; }
        if (self > other) { return 1; }
        return 0;
    }
}
impl Ord for u32 {
    function cmp(self: Self, other: Self): i32 {
        if (self < other) { return 0 - 1; }
        if (self > other) { return 1; }
        return 0;
    }
}
impl Ord for u64 {
    function cmp(self: Self, other: Self): i32 {
        if (self < other) { return 0 - 1; }
        if (self > other) { return 1; }
        return 0;
    }
}
impl Ord for u8 {
    function cmp(self: Self, other: Self): i32 {
        if (self < other) { return 0 - 1; }
        if (self > other) { return 1; }
        return 0;
    }
}
// Float ordering is IEEE `< / >`. NaN compares false on both, so it falls
// through to `return 0` (treated equal) — fine for the assertion helpers and
// sorting a NaN-free array; a NaN-aware total order is a follow-up.
impl Ord for f64 {
    function cmp(self: Self, other: Self): i32 {
        if (self < other) { return 0 - 1; }
        if (self > other) { return 1; }
        return 0;
    }
}
impl Ord for f32 {
    function cmp(self: Self, other: Self): i32 {
        if (self < other) { return 0 - 1; }
        if (self > other) { return 1; }
        return 0;
    }
}

// Lexicographic byte-order comparison for strings, via std/sort's
// tested comparator — so `[T: Ord]` generics (sorted-array asserts,
// `@derive(Ord)` on a struct/enum with a string field) cover string.
impl Ord for string {
    function cmp(self: Self, other: Self): i32 {
        return sort.string_cmp(self, other);
    }
}

// ---- Hash ------------------------------------------------------
// Primitive hashes. Integers mix their bits (Wang's 32-bit mix) so
// low-entropy values (small ints, flags) spread across buckets rather
// than clustering; wide integers fold both halves first. `string`
// uses FNV-1a over the bytes — the same function the Map runtime hashes
// string keys with. `boolean` is 0 / 1.

function __hash_mix_i32(x: i32): i32 {
    var h: i32 = x ^ 61;
    h = h ^ (((h as u32) >> (16 as u32)) as i32);
    h = h + (h << 3);
    h = h ^ (((h as u32) >> (4 as u32)) as i32);
    h = h * 668265261;                      // 0x27d4eb2d
    h = h ^ (((h as u32) >> (15 as u32)) as i32);
    return h;
}

impl Hash for i32 {
    function hash(self: Self): i32 { return __hash_mix_i32(self); }
}
impl Hash for u8 {
    function hash(self: Self): i32 { return __hash_mix_i32(self as i32); }
}
impl Hash for u32 {
    function hash(self: Self): i32 { return __hash_mix_i32(self as i32); }
}
impl Hash for i64 {
    function hash(self: Self): i32 {
        var lo: i32 = self as i32;
        var hi: i32 = (self >> (32 as i64)) as i32;
        return __hash_mix_i32(lo ^ hi);
    }
}
impl Hash for u64 {
    function hash(self: Self): i32 {
        var lo: i32 = self as i32;
        var hi: i32 = (self >> (32 as u64)) as i32;
        return __hash_mix_i32(lo ^ hi);
    }
}
impl Hash for boolean {
    function hash(self: Self): i32 {
        if (self) { return 1; }
        return 0;
    }
}
impl Hash for string {
    function hash(self: Self): i32 {
        var h: i32 = 0 - 2128831035;            // 0x811c9dc5 sign-flipped
        var n: i32 = self.len();
        var i: i32 = 0;
        while (i < n) {
            h = h ^ (self[i] as i32);
            h = h * 16777619;                   // 0x01000193
            i = i + 1;
        }
        return h;
    }
}

// ---- Default ---------------------------------------------------
// Primitive zero values: numerics default to 0 (0.0 for floats),
// `string` to the empty string, `boolean` to false. These let a
// generic `@derive(Default)` over a primitive type parameter
// (`@derive(Default) struct Box[T]` instantiated at `Box[i32]`)
// resolve `T.default()` against the bound, the same way nominal
// fields delegate to their own derived `default()`.

impl Default for i32 {
    function default(): i32 { return 0; }
}
impl Default for i64 {
    function default(): i64 { return 0 as i64; }
}
impl Default for u32 {
    function default(): u32 { return 0 as u32; }
}
impl Default for u64 {
    function default(): u64 { return 0 as u64; }
}
impl Default for u8 {
    function default(): u8 { return 0 as u8; }
}
impl Default for string {
    function default(): string { return ""; }
}
impl Default for boolean {
    function default(): boolean { return false; }
}
impl Default for f32 {
    function default(): f32 { return 0.0 as f32; }
}
impl Default for f64 {
    function default(): f64 { return 0.0 as f64; }
}

// ---- Debug -----------------------------------------------------
// Numeric types debug as their decimal form (same as `to_string`);
// `boolean` as `true`/`false`. `string` is QUOTED with `"` — and the
// quote / backslash / newline / tab inside are escaped — so a debug dump
// round-trips visibly. These primitive impls let `[T: Debug]` generics
// (the test runner's `assert_eq`) and nested `@derive(Debug)` fields
// resolve `(v).to_debug()` for any leaf type.

impl Debug for i32 {
    function to_debug(self: Self): string { return self.to_string(); }
}
impl Debug for i64 {
    function to_debug(self: Self): string { return self.to_string(); }
}
impl Debug for u32 {
    function to_debug(self: Self): string { return self.to_string(); }
}
impl Debug for u64 {
    function to_debug(self: Self): string { return self.to_string(); }
}
// A byte has neither structure to render nor a `to_string` of its own to
// call, so it debugs as the decimal form of the i32 it widens to — the same
// borrow `impl Display for u8` makes.
impl Debug for u8 {
    function to_debug(self: Self): string { return (self as i32).to_string(); }
}
impl Debug for f64 {
    function to_debug(self: Self): string { return self.to_string(); }
}
impl Debug for f32 {
    function to_debug(self: Self): string { return self.to_string(); }
}
impl Debug for boolean {
    function to_debug(self: Self): string {
        if (self) { return "true"; }
        return "false";
    }
}
impl Debug for string {
    function to_debug(self: Self): string {
        var out: string = "\"";
        var i: i32 = 0;
        var n: i32 = self.len();
        while (i < n) {
            var b: i32 = self[i] as i32;
            if (b == 34) { out = out + "\\\""; }        // "
            else { if (b == 92) { out = out + "\\\\"; }  // backslash
            else { if (b == 10) { out = out + "\\n"; }
            else { if (b == 9) { out = out + "\\t"; }
            else { out = out + self[i : i + 1]; } } } }
            i = i + 1;
        }
        return out + "\"";
    }
}

// ---- Generic Ord helpers ---------------------------------------
// Free functions over any `T: Ord`, derived from the single `cmp`
// primitive — so they work for the integer/string impls above and for
// any user `Ord` type (incl. `@derive(Ord)`). A bounded generic whose
// body calls `a.cmp(b)` monomorphises to a direct call, so these lower
// on the self-host IR path too (#2691 / #3558).

// min returns the smaller of `a` and `b` (`a` when equal).
pub function min[T: Ord](a: T, b: T): T {
    if (b.cmp(a) < 0) { return b; }
    return a;
}

// max returns the larger of `a` and `b` (`a` when equal).
pub function max[T: Ord](a: T, b: T): T {
    if (a.cmp(b) < 0) { return b; }
    return a;
}

// clamp constrains `x` to the inclusive range [lo, hi]. Assumes lo <= hi.
pub function clamp[T: Ord](x: T, lo: T, hi: T): T {
    if (x.cmp(lo) < 0) { return lo; }
    if (x.cmp(hi) > 0) { return hi; }
    return x;
}

// max_of / min_of reduce an array to its largest / smallest element under
// `Ord`, returning `Option[T]` — `None` for an empty array (there is no
// extremum), `Some(x)` otherwise. The generic, any-`Ord`-type replacement for
// std/array's per-width `max_i64` / `min_i64` / `max_u32` / … zoo (#4387
// item 2): one body dispatching `.cmp`, monomorphised per element type, so it
// lowers on the self-host IR path like `sort` / `is_sorted`. On ties the first
// extremal element wins (a strict `> 0` / `< 0` only replaces on a genuine
// improvement), so the result is stable w.r.t. input order.
pub function max_of[T: Ord](xs: T[]): Option[T] {
    if (xs.len() == 0) { return None; }
    var best: T = xs[0];
    var i: i32 = 1;
    while (i < xs.len()) {
        if (xs[i].cmp(best) > 0) { best = xs[i]; }
        i = i + 1;
    }
    return Some(best);
}

// min_of is max_of's mirror: the smallest element, or `None` when empty.
pub function min_of[T: Ord](xs: T[]): Option[T] {
    if (xs.len() == 0) { return None; }
    var best: T = xs[0];
    var i: i32 = 1;
    while (i < xs.len()) {
        if (xs[i].cmp(best) < 0) { best = xs[i]; }
        i = i + 1;
    }
    return Some(best);
}

// lt / lte / gt / gte are the named relational forms of `cmp`, for call
// sites that read better than a bare `a.cmp(b) < 0`.
pub function lt[T: Ord](a: T, b: T): boolean { return a.cmp(b) < 0; }
pub function lte[T: Ord](a: T, b: T): boolean { return a.cmp(b) <= 0; }
pub function gt[T: Ord](a: T, b: T): boolean { return a.cmp(b) > 0; }
pub function gte[T: Ord](a: T, b: T): boolean { return a.cmp(b) >= 0; }

// is_sorted reports whether `arr` is in non-decreasing `Ord` order.
pub function is_sorted[T: Ord](arr: T[]): boolean {
    var i = 1;
    var n = arr.len();
    while (i < n) {
        if (arr[i].cmp(arr[i - 1]) < 0) { return false; }
        i = i + 1;
    }
    return true;
}

// __cmp_insertion sorts `a[lo..hi)` in place by insertion. O(k^2) on k elements
// but with a tiny constant, no allocation, and a branch-predictable inner loop
// — which is why every serious sort dispatches to one below a size threshold
// rather than recursing all the way down.
//
// `desc` flips the ordering by negating the three-way result, so ascending and
// descending share one body. The shift loop stops on a NON-positive compare, so
// equal elements never move past each other: insertion is stable.
function __cmp_insertion[T: Ord](a: T[], lo: i32, hi: i32, desc: boolean): T[] {
    var out: T[] = a;
    var i: i32 = lo + 1;
    while (i < hi) {
        var v: T = out[i];
        var j: i32 = i - 1;
        var moving: boolean = j >= lo;
        while (moving) {
            var o: i32 = out[j].cmp(v);
            if (desc) { o = 0 - o; }
            if (o > 0) {
                out = out.with(j + 1, out[j]);
                j = j - 1;
                moving = j >= lo;
            } else {
                moving = false;
            }
        }
        out = out.with(j + 1, v);
        i = i + 1;
    }
    return out;
}

// __cmp_sort_adaptive is the shared body behind `sort` and `sort_desc`: a
// natural-run merge sort.
//
//   n < 2   -> the input, untouched
//   n <= 32 -> one insertion sort, no merging and no extra allocation
//   larger  -> detect natural runs, then merge adjacent runs in balanced rounds
//
// The adaptivity is the point. The previous revision was a fixed bottom-up
// merge sort that materialised a FRESH FULL COPY of the array on every one of
// its ceil(log2 n) passes, and did so regardless of the input: an
// already-sorted array cost exactly as much as a random one. Here a sorted (or
// reverse-sorted) input is a SINGLE run, so the merge loop never executes and
// the whole call is O(n) with one copy. Partially ordered input — the common
// case in practice — lands in between.
//
// Stability is preserved throughout: a descending run is detected with a
// STRICT compare (so equal neighbours end the run rather than being swapped
// past each other) before being reversed, and the merge takes from the right
// run only when the left is strictly greater.
//
// Merging appends into a fresh array rather than writing through `.with`, so no
// merge ever reads a slot it has already overwritten. That sidesteps the
// aliasing hazard the old implementation guarded against with its
// fresh-copy-per-pass rule (a rule written for the self-host AST emitter, which
// has since been deleted in #3457/#5972) — append-only output cannot alias its
// input at all, on any backend, with or without Perceus.
//
// TWO SELF-HOST CONSTRAINTS shape how this is written; do not "tidy" either one
// away without re-running the self-host leg:
//
//  1. Every comparison is an INLINE `.cmp()` (a trait method) rather than a
//     call to a shared `__cmp_after(x, y, desc)` helper. A call to a free
//     GENERIC function from inside a loop bails the self-host IR path, and
//     since the AST emitters were deleted a bail is a hard compile error, not a
//     slow fallback. Trait-method calls in loops lower fine — which is why the
//     previous revision's `src[j].cmp(src[i])` was never a problem. The
//     `if (desc) { o = 0 - o; }` negation is what lets one body serve both
//     directions without such a helper.
//  2. For the same reason, runs are NOT extended to a minimum length with
//     insertion sort (Timsort's MIN_RUN step), since that would mean calling
//     __cmp_insertion from inside the run loop. Dropping it costs a few extra
//     merge rounds on random input — the merge tree is deeper when runs are
//     short — but changes neither the O(n log n) bound nor the O(n) sorted-input
//     behaviour. See docs/SOTA-STDLIB-BLUEPRINT.md.
function __cmp_sort_adaptive[T: Ord](arr: T[], desc: boolean): T[] {
    var n: i32 = arr.len();
    if (n < 2) { return arr; }

    // Own a copy: the descending-run reversal writes in place.
    var a: T[] = [];
    var c: i32 = 0;
    while (c < n) { a = a.append(arr[c]); c = c + 1; }

    if (n <= 32) { return __cmp_insertion(a, 0, n, desc); }

    // Pass 1 — natural runs. `bounds` holds each run's start, terminated by n.
    var bounds: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        bounds = bounds.append(i);
        var e: i32 = i + 1;
        if (e < n) {
            var head: i32 = a[i].cmp(a[e]);
            if (desc) { head = 0 - head; }
            if (head > 0) {
                // Strictly descending: extend, then reverse into order.
                var falling: boolean = true;
                while (falling) {
                    e = e + 1;
                    falling = false;
                    if (e < n) {
                        var od: i32 = a[e - 1].cmp(a[e]);
                        if (desc) { od = 0 - od; }
                        if (od > 0) { falling = true; }
                    }
                }
                var lo: i32 = i;
                var hi: i32 = e - 1;
                while (lo < hi) {
                    var t: T = a[lo];
                    a = a.with(lo, a[hi]);
                    a = a.with(hi, t);
                    lo = lo + 1;
                    hi = hi - 1;
                }
            } else {
                var rising: boolean = true;
                while (rising) {
                    e = e + 1;
                    rising = false;
                    if (e < n) {
                        var oa: i32 = a[e - 1].cmp(a[e]);
                        if (desc) { oa = 0 - oa; }
                        if (oa <= 0) { rising = true; }
                    }
                }
            }
        }
        i = e;
    }
    bounds = bounds.append(n);

    // Pass 2 — merge adjacent runs in rounds until one remains. Each round
    // rebuilds the array by appending merged segments, so the output never
    // aliases the input it is reading.
    while (bounds.len() > 2) {
        var out: T[] = [];
        var next: i32[] = [];
        var r: i32 = 0;
        while (r + 1 < bounds.len()) {
            var mlo: i32 = bounds[r];
            next = next.append(mlo);
            if (r + 2 < bounds.len()) {
                var mmid: i32 = bounds[r + 1];
                var mhi: i32 = bounds[r + 2];
                var p: i32 = mlo;
                var q: i32 = mmid;
                while (p < mmid && q < mhi) {
                    var om: i32 = a[p].cmp(a[q]);
                    if (desc) { om = 0 - om; }
                    if (om > 0) {
                        out = out.append(a[q]);
                        q = q + 1;
                    } else {
                        out = out.append(a[p]);
                        p = p + 1;
                    }
                }
                while (p < mmid) { out = out.append(a[p]); p = p + 1; }
                while (q < mhi) { out = out.append(a[q]); q = q + 1; }
                r = r + 2;
            } else {
                // Odd run out: carry it forward untouched.
                var mend: i32 = bounds[r + 1];
                var mk: i32 = mlo;
                while (mk < mend) { out = out.append(a[mk]); mk = mk + 1; }
                r = r + 1;
            }
        }
        next = next.append(n);
        a = out;
        bounds = next;
    }
    return a;
}

// sort returns a new array with `arr`'s elements in non-decreasing `Ord` order.
// Generic over any `T: Ord` (incl. `@derive(Ord)` types) — the type-erased,
// any-`Ord`-element replacement for std/sort's retired per-width `sort_i32_asc`
// / `sort_i64_asc` / `sort_u32_asc` / `sort_f64_asc` / `sort_strings_asc` zoo
// (#5397). The `T: Ord` bound monomorphises the `.cmp` compare per element type
// on the self-host IR path — an `i32` element lowers to the scalar three-way, a
// `u32` to the unsigned compare, a `string` to the lexicographic byte compare —
// so a single body gives every width the direct scalar/dedicated compare the
// zoo used to spell by hand.
//
// STABLE: equal elements keep their input order. Adaptive natural-run merge
// sort — O(n) on sorted or reverse-sorted input, O(n log n) worst case. See
// __cmp_sort_adaptive for the shape and docs/SOTA-STDLIB-BLUEPRINT.md for where
// it sits against the state of the art (pdqsort for an unstable sibling, and a
// radix path for integer keys, are both still open).
pub function sort[T: Ord](arr: T[]): T[] {
    return __cmp_sort_adaptive(arr, false);
}

// sort_desc is `sort`'s descending mirror: a new array with `arr`'s elements in
// non-increasing `Ord` order. The generic home for the retired per-width
// descending sorts (`sort_i32_desc` / `sort_i64_desc` / `sort_f64_desc` /
// `sort_strings_desc`, #5397). Stable on ties, same adaptive shape as `sort` —
// the two differ only in the sign of the three-way compare.
pub function sort_desc[T: Ord](arr: T[]): T[] {
    return __cmp_sort_adaptive(arr, true);
}

// ---- Eq-bounded sequence verbs ---------------------------------
// Free functions over any `T: Eq`, derived from the single `eq`
// primitive — so they cover the primitive impls above and any user
// type that impls `Eq`. Like the `Ord` verbs, a bounded generic whose
// body calls `x.eq(y)` monomorphises to a direct call, so these lower
// on the self-host IR path too (#2689 / #2691). They live here with
// the `Eq` trait they depend on — the single home for the generic
// equality-driven sequence verbs (the std/array duplicates were removed
// in #5348). They are element-type-generic, so unlike the i32[]/string[]-
// specific `contains` / `index_of` Array receiver methods in std/array
// they cover any `T: Eq`, including a `@derive(Eq)` struct or enum.

// contains reports whether `xs` holds a value equal to `target`.
pub function contains[T: Eq](xs: T[], target: T): boolean {
    for x in xs {
        if (x.eq(target)) { return true; }
    }
    return false;
}

// index_of returns `Some(i)` for the 0-based position of the first value
// equal to `target`, or `None` if no value matches. The `Option` return
// keeps "not found" out of band rather than leaning on a `-1` sentinel
// (the modern shape unified from std/array in #5348).
pub function index_of[T: Eq](xs: T[], target: T): Option[i32] {
    var i = 0;
    for x in xs {
        if (x.eq(target)) { return Some(i); }
        i = i + 1;
    }
    return None;
}

// distinct returns a new array with duplicate values removed, keeping
// the first occurrence of each in original order. O(n²) via `Eq` alone
// (no `Hash` needed) — suited to small / convenience inputs; a
// `Hash`-backed dedup is the larger-n follow-up.
pub function distinct[T: Eq](xs: T[]): T[] {
    var out: T[] = [];
    for x in xs {
        if (!contains(out, x)) { out = out.append(x); }
    }
    return out;
}

// eq_arrays reports whether `a` and `b` have the same length and equal
// elements pairwise under `Eq`.
pub function eq_arrays[T: Eq](a: T[], b: T[]): boolean {
    var n = a.len();
    if (n != b.len()) { return false; }
    var i = 0;
    while (i < n) {
        if (!a[i].eq(b[i])) { return false; }
        i = i + 1;
    }
    return true;
}
