// core/iter.fern — a numeric (i32) iterator protocol + an integer Range.
//
// This is the first slice of the iterator trait (#2686 / the open tail of
// #2699), specialised to i32 ("numbers") so it lowers on BOTH the native
// compiler and the self-hosted compiler's IR path. A *generic* `Iterator[T]`
// needs bounded generics over a parametrised-trait bound (`[I: Iterator[T]]`),
// which the self-host IR path does not yet monomorphise — so the trait is fixed
// to i32 for now (a generic version is a later slice).
//
// Iteration is value-semantic: `next` returns `Some((value, advanced))` where
// `advanced` is a FRESH iterator positioned just after `value`, or `None` at
// the end. There is no interior mutation — advancing yields a new iterator —
// which is the functional shape the self-host IR path already lowers (a
// Cell-backed mutable cursor would be a later optimisation).

// Iterator is the numeric iteration protocol: a type yields i32 values one at a
// time via `next`. `Some((v, it2))` produces the next value `v` and the
// iterator state `it2` to continue from; `None` signals exhaustion.
pub trait Iterator {
    function next(self: Self): Option[(i32, Self)];
}

// Range is the half-open integer interval [lo, hi) as an Iterator: it yields
// lo, lo+1, …, hi-1.
pub struct Range { lo: i32, hi: i32 }

// range(lo, hi) constructs the half-open range [lo, hi). `range(0, n)` is the
// iterator form of `for i in 0..n`, usable as a first-class value:
// `iter.sum(iter.range(0, n))`.
pub function range(lo: i32, hi: i32): Range {
    return Range { lo: lo, hi: hi };
}

impl Iterator for Range {
    function next(self: Self): Option[(i32, Self)] {
        if (self.lo >= self.hi) { return None; }
        return Some((self.lo, Range { lo: self.lo + 1, hi: self.hi }));
    }
}

// sum consumes the iterator, returning the sum of every value it yields (0 for
// an empty iterator).
pub function sum[I: Iterator](it: I): i32 {
    var total = 0;
    var cur = it;
    var go = true;
    while (go) {
        match (cur.next()) {
            Some(t) => { total = total + t.0; cur = t.1; },
            None => { go = false; },
        }
    }
    return total;
}

// count consumes the iterator, returning how many values it yields.
pub function count[I: Iterator](it: I): i32 {
    var n = 0;
    var cur = it;
    var go = true;
    while (go) {
        match (cur.next()) {
            Some(t) => { n = n + 1; cur = t.1; },
            None => { go = false; },
        }
    }
    return n;
}

// to_array collects the iterator's values into a fresh i32[], in order.
pub function to_array[I: Iterator](it: I): i32[] {
    var out: i32[] = [];
    var cur = it;
    var go = true;
    while (go) {
        match (cur.next()) {
            Some(t) => { out = out.append(t.0); cur = t.1; },
            None => { go = false; },
        }
    }
    return out;
}
