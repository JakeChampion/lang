// core/iter — value iterators and lazy adapters.
//
// Iterator[T].next returns Some((value, advanced_iterator)), or None at the end.
// Each step returns a new iterator value.
// iter.of(xs) wraps an array. Range walks the integers in [lo, hi).
// Map keys and values can use the same adapters through their array snapshots.
//
// Lazy map, filter, take, skip, and flat_map adapters build no intermediate array.
// Numeric reductions use the std/num traits. Comparisons use core/cmp.
// A for loop accepts an iterator or a type whose iter() method returns one.

import "core/cmp";
import "std/num";

// Iterator is the iteration protocol: a type yields `T` values one at a time
// via `next`. `Some((v, it2))` produces the next value `v` and the iterator
// state `it2` to continue from; `None` signals exhaustion.
pub trait Iterator[T] {
  function next(self: Self): Option[(T, Self)];

  // The lazy adapters: each wraps the iterator and does its work as values
  // are pulled, so `iter.of(xs).filter(p).map(f).fold(z, g)` reads left to
  // right and builds no intermediate array.
  function map[U](self: Self, f: (T) => U): Mapped[Self, T, U] {
    return Mapped { it: self, f: f };
  }
  function filter(self: Self, keep: (T) => boolean): Filtered[Self, T] {
    return Filtered { it: self, keep: keep };
  }
  function take(self: Self, n: i32): Taken[Self, T] {
    return Taken[Self, T] { it: self, left: n };
  }
  function skip(self: Self, n: i32): Skipped[Self, T] {
    return Skipped[Self, T] { it: self, left: n };
  }
  function flat_map[U](self: Self, f: (T) => U[]): FlatMapped[Self, T, U] {
    let none: U[] = [];
    return FlatMapped[Self, T, U] { it: self, f: f, ys: none, at: 0 };
  }
  function enumerate(self: Self): Enumerated[Self, T] {
    return Enumerated[Self, T] { it: self, at: 0 };
  }
  function zip[U, J: Iterator[U]](self: Self, other: J): Zipped[Self, T, J, U] {
    return Zipped[Self, T, J, U] { a: self, b: other };
  }

  // The sinks, which drain the iterator.
  function fold[A](self: Self, init: A, f: (A, T) => A): A {
    let acc: A = init;
    let cur: Self = self;
    let go: boolean = true;
    while (go) {
      match (cur.next()) {
        Some(t) => {
          acc = f(acc, t.0);
          cur = t.1;
        },
        None => {
          go = false;
        }
      }
    }
    return acc;
  }
  function count(self: Self): i32 {
    return self.fold(0, (n: i32, v: T): i32 => n + 1);
  }
  function collect(self: Self): T[] {
    let out: T[] = [];
    let cur: Self = self;
    let go: boolean = true;
    while (go) {
      match (cur.next()) {
        Some(t) => {
          out = out.append(t.0);
          cur = t.1;
        },
        None => {
          go = false;
        }
      }
    }
    return out;
  }
  function find(self: Self, pred: (T) => boolean): Option[T] {
    let cur: Self = self;
    let go: boolean = true;
    while (go) {
      match (cur.next()) {
        Some(t) => {
          if (pred(t.0)) {
            return Some(t.0);
          }
          cur = t.1;
        },
        None => {
          go = false;
        }
      }
    }
    return None;
  }
  function any(self: Self, pred: (T) => boolean): boolean {
    match (self.find(pred)) {
      Some(_) => {
        return true;
      },
      None => {
        return false;
      }
    }
  }
  function all(self: Self, pred: (T) => boolean): boolean {
    match (self.find((v: T): boolean => !pred(v))) {
      Some(_) => {
        return false;
      },
      None => {
        return true;
      }
    }
  }
}

// Mapped yields `f(v)` for each `v` of `it`.
pub struct Mapped[I, T, U] { it: I, f: (T) => U }

impl[I: Iterator[T], T, U] Iterator[U] for Mapped[I, T, U] {
  function next(self: Mapped[I, T, U]): Option[(U, Mapped[I, T, U])] {
    match (self.it.next()) {
      Some(t) => {
        return Some((self.f(t.0), Mapped { it: t.1, f: self.f }));
      },
      None => {
        return None;
      }
    }
  }
}

// Filtered yields the values of `it` that `keep` accepts.
pub struct Filtered[I, T] { it: I, keep: (T) => boolean }

impl[I: Iterator[T], T] Iterator[T] for Filtered[I, T] {
  function next(self: Filtered[I, T]): Option[(T, Filtered[I, T])] {
    let cur: I = self.it;
    while (true) {
      match (cur.next()) {
        Some(t) => {
          if (self.keep(t.0)) {
            return Some((t.0, Filtered { it: t.1, keep: self.keep }));
          }
          cur = t.1;
        },
        None => {
          return None;
        }
      }
    }
    return None;
  }
}

// Taken yields at most `left` more values of `it`; none once `left` is at or
// below zero.
pub struct Taken[I, T] { it: I, left: i32 }

impl[I: Iterator[T], T] Iterator[T] for Taken[I, T] {
  function next(self: Taken[I, T]): Option[(T, Taken[I, T])] {
    if (self.left <= 0) {
      return None;
    }
    match (self.it.next()) {
      Some(t) => {
        return Some((t.0, Taken[I, T] { it: t.1, left: self.left - 1 }));
      },
      None => {
        return None;
      }
    }
  }
}

// Skipped yields the values of `it` past its first `left`; all of them when
// `left` is at or below zero.
pub struct Skipped[I, T] { it: I, left: i32 }

impl[I: Iterator[T], T] Iterator[T] for Skipped[I, T] {
  function next(self: Skipped[I, T]): Option[(T, Skipped[I, T])] {
    let cur: I = self.it;
    let left: i32 = self.left;
    while (true) {
      match (cur.next()) {
        Some(t) => {
          if (left <= 0) {
            return Some((t.0, Skipped[I, T] { it: t.1, left: 0 }));
          }
          left = left - 1;
          cur = t.1;
        },
        None => {
          return None;
        }
      }
    }
    return None;
  }
}

// FlatMapped yields, for each value `v` of `it`, the values of `f(v)` in
// order: `ys` is the array being read and `at` the next index in it.
pub struct FlatMapped[I, T, U] { it: I, f: (T) => U[], ys: U[], at: i32 }

impl[I: Iterator[T], T, U] Iterator[U] for FlatMapped[I, T, U] {
  function next(self: FlatMapped[I, T, U]): Option[(U, FlatMapped[I, T, U])] {
    let cur: I = self.it;
    let ys: U[] = self.ys;
    let at: i32 = self.at;
    while (at >= ys.len()) {
      match (cur.next()) {
        Some(t) => {
          ys = self.f(t.0);
          at = 0;
          cur = t.1;
        },
        None => {
          return None;
        }
      }
    }
    return Some((ys[at], FlatMapped[I, T, U] { it: cur, f: self.f, ys: ys, at: at + 1 }));
  }
}

// Enumerated yields each value of `it` with its 0-based position.
pub struct Enumerated[I, T] { it: I, at: i32 }

impl[I: Iterator[T], T] Iterator[(i32, T)] for Enumerated[I, T] {
  function next(self: Enumerated[I, T]): Option[((i32, T), Enumerated[I, T])] {
    match (self.it.next()) {
      Some(t) => {
        return Some(((self.at, t.0), Enumerated[I, T] { it: t.1, at: self.at + 1 }));
      },
      None => {
        return None;
      }
    }
  }
}

// Zipped yields a value of `a` beside one of `b` until either runs out.
pub struct Zipped[I, T, J, U] { a: I, b: J }

impl[I: Iterator[T], T, J: Iterator[U], U] Iterator[(T, U)] for Zipped[I, T, J, U] {
  function next(self: Zipped[I, T, J, U]): Option[((T, U), Zipped[I, T, J, U])] {
    match (self.a.next()) {
      Some(x) => {
        match (self.b.next()) {
          Some(y) => {
            return Some(((x.0, y.0), Zipped[I, T, J, U] { a: x.1, b: y.1 }));
          },
          None => {
            return None;
          }
        }
      },
      None => {
        return None;
      }
    }
  }
}

// Range is the half-open integer interval [lo, hi) as an Iterator[i32]: it
// yields lo, lo+1, …, hi-1.
pub struct Range { lo: i32, hi: i32 }

// range(lo, hi) constructs the half-open range [lo, hi). `range(0, n)` is the
// iterator form of `for i in 0..n`, usable as a first-class value:
// `iter.sum(iter.range(0, n))`.
pub function range(lo: i32, hi: i32): Range {
  return Range { lo: lo, hi: hi };
}

// range_incl(lo, hi) constructs the CLOSED range [lo, hi] — it yields lo, lo+1,
// …, hi. The inclusive-value form of `a..=b` (the expression desugar target),
// expressed over the half-open Range as [lo, hi+1).
pub function range_incl(lo: i32, hi: i32): Range {
  return Range { lo: lo, hi: hi + 1 };
}

impl Iterator[i32] for Range {
  function next(self: Range): Option[(i32, Range)] {
    if (self.lo >= self.hi) {
      return None;
    }
    return Some((self.lo, Range { lo: self.lo + 1, hi: self.hi }));
  }
}

// ArrayIter is an Iterator[T] over a T[]: it yields xs[0], xs[1], …, in
// order. Iteration is value-semantic — `next` returns a fresh ArrayIter
// advanced one element, never mutating — matching Range's shape. This is
// what makes the whole combinator library (sum / count / map / filter /
// fold / take / …) usable on a plain array, and (via a map's `.keys()` /
// `.values()` snapshot) on map keys and values too:
//   iter.sum(iter.of(xs))
//   iter.of(m.keys()).count()
// Generic over the element type T, lowered through a parametric impl of the
// generic Iterator trait.
pub struct ArrayIter[T] { xs: T[], idx: i32 }

// of wraps an array as an Iterator[T] positioned at its first element.
pub function of[T](xs: T[]): ArrayIter[T] {
  return ArrayIter { xs: xs, idx: 0 };
}

impl[T] Iterator[T] for ArrayIter[T] {
  function next(self: ArrayIter[T]): Option[(T, ArrayIter[T])] {
    if (self.idx >= self.xs.len()) {
      return None;
    }
    return Some((self.xs[self.idx], ArrayIter { xs: self.xs, idx: self.idx + 1 }));
  }
}

// sum consumes an iterator, returning the sum of every value it yields
// (`T.zero()` for an empty iterator).
pub function sum[T: num.Add + num.Zero, I: Iterator[T]](it: I): T {
  let total: T = T.zero();
  let cur = it;
  let go = true;
  while (go) {
    match (cur.next()) {
      Some(t) => {
        total = total.add(t.0);
        cur = t.1;
      },
      None => {
        go = false;
      }
    }
  }
  return total;
}

// (A `to_map` terminal for a `(K, V)`-yielding iterator — the keyed `Map` half
// of #2709's FromIterator — is deferred: a fully-generic `Map[K, V]` built in a
// generic body hits the same abstract-key `Map` dispatch gap as the generic
// `Set[T]` in #2671, where the function's `K`/`V` don't unify with the `Map`
// method's own type params. It lands once that compiler gap closes.)

// position_by returns the 0-based index of the first value for which `pred` is
// true, or -1 if none matches. The closure-taking counterpart to `position`
// (which matches on `Eq` against a target).
pub function position_by[T, I: Iterator[T]](it: I, pred: (T) => boolean): i32 {
  let cur = it;
  let i = 0;
  let go = true;
  while (go) {
    match (cur.next()) {
      Some(t) => {
        if (pred(t.0)) {
          return i;
        }
        i = i + 1;
        cur = t.1;
      },
      None => {
        go = false;
      }
    }
  }
  return 0 - 1;
}

// count_by returns how many of the iterator's values satisfy `pred`. The
// closure-taking counterpart to `count_value` (which counts values `Eq` to a
// target).
pub function count_by[T, I: Iterator[T]](it: I, pred: (T) => boolean): i32 {
  let cur = it;
  let n = 0;
  let go = true;
  while (go) {
    match (cur.next()) {
      Some(t) => {
        if (pred(t.0)) {
          n = n + 1;
        }
        cur = t.1;
      },
      None => {
        go = false;
      }
    }
  }
  return n;
}

// nth returns the value at index `n` (0-based), or `None` if the iterator yields
// fewer than `n + 1` values. Generic over the element type `T`.
pub function nth[T, I: Iterator[T]](it: I, n: i32): Option[T] {
  let cur = it;
  let k = n;
  let go = true;
  while (go) {
    match (cur.next()) {
      Some(t) => {
        if (k == 0) {
          return Some(t.0);
        }
        k = k - 1;
        cur = t.1;
      },
      None => {
        go = false;
      }
    }
  }
  return None;
}

// min returns the smallest value an iterator yields by `Ord`'s `cmp`, or
// `None` if empty. Ties keep the first.
pub function min[T: cmp.Ord, I: Iterator[T]](it: I): Option[T] {
  match (it.next()) {
    Some(first) => {
      let best: T = first.0;
      let cur = first.1;
      let go = true;
      while (go) {
        match (cur.next()) {
          Some(t) => {
            if (t.0.cmp(best) < 0) {
              best = t.0;
            }
            cur = t.1;
          },
          None => {
            go = false;
          }
        }
      }
      return Some(best);
    },
    None => {
      return None;
    }
  }
}

// max returns the largest value an iterator yields by `Ord`'s `cmp`, or
// `None` if empty. Ties keep the first.
pub function max[T: cmp.Ord, I: Iterator[T]](it: I): Option[T] {
  match (it.next()) {
    Some(first) => {
      let best: T = first.0;
      let cur = first.1;
      let go = true;
      while (go) {
        match (cur.next()) {
          Some(t) => {
            if (t.0.cmp(best) > 0) {
              best = t.0;
            }
            cur = t.1;
          },
          None => {
            go = false;
          }
        }
      }
      return Some(best);
    },
    None => {
      return None;
    }
  }
}

// last returns the final value an iterator yields, or `None` if it is empty.
// Generic over the element type `T`.
pub function last[T, I: Iterator[T]](it: I): Option[T] {
  let cur = it;
  let acc: Option[T] = None;
  let go = true;
  while (go) {
    match (cur.next()) {
      Some(t) => {
        acc = Some(t.0);
        cur = t.1;
      },
      None => {
        go = false;
      }
    }
  }
  return acc;
}

// product returns the product of every value an iterator yields (`T.one()`
// for an empty iterator).
pub function product[T: num.Mul + num.One, I: Iterator[T]](it: I): T {
  let p: T = T.one();
  let cur = it;
  let go = true;
  while (go) {
    match (cur.next()) {
      Some(t) => {
        p = p.mul(t.0);
        cur = t.1;
      },
      None => {
        go = false;
      }
    }
  }
  return p;
}

// position returns the 0-based index of the first value equal to `target`, or
// `None` if no value matches. `position_by` is the closure-taking form.
pub function position[T: cmp.Eq, I: Iterator[T]](it: I, target: T): Option[i32] {
  let cur = it;
  let i = 0;
  let go = true;
  while (go) {
    match (cur.next()) {
      Some(t) => {
        if (t.0.eq(target)) {
          return Some(i);
        }
        i = i + 1;
        cur = t.1;
      },
      None => {
        go = false;
      }
    }
  }
  return None;
}

// contains reports whether the iterator yields a value equal to `target`.
// `any` is the closure-taking form.
pub function contains[T: cmp.Eq, I: Iterator[T]](it: I, target: T): boolean {
  let cur = it;
  let go = true;
  while (go) {
    match (cur.next()) {
      Some(t) => {
        if (t.0.eq(target)) {
          return true;
        }
        cur = t.1;
      },
      None => {
        go = false;
      }
    }
  }
  return false;
}

// count_value returns how many of the iterator's values equal `target`.
// `count_by` is the closure-taking form.
pub function count_value[T: cmp.Eq, I: Iterator[T]](it: I, target: T): i32 {
  let n = 0;
  let cur = it;
  let go = true;
  while (go) {
    match (cur.next()) {
      Some(t) => {
        if (t.0.eq(target)) {
          n = n + 1;
        }
        cur = t.1;
      },
      None => {
        go = false;
      }
    }
  }
  return n;
}
