// core/int — low-level integer to-string formatting helpers.
//
// `int_to_string(n)` and `__int_to_string_u64(mag, neg)` are
// the primitives the wider `(n).to_string()` method-syntax
// wrappers in `std/i32` / `std/i64` / `std/u32` / `std/u64`
// call into. They sit in `core/` because the implementation
// pokes raw memory (`__alloc_u8`, scratch buffers written
// backwards) — user code should reach for the method-syntax
// surface or `format(…)` rather than these directly.
//
// `parse_int_radix(s, base)` / `int_to_string_radix(n, base)`
// extend the same shape to bases 2..36 (digits 0-9 then a-z,
// ignoring case). Used by the `to_binary` / `to_oct` / `to_hex`
// / `parse_hex_int` / etc. method-style sugar in std/i32.

// `int_to_string(n)` — signed-i32 → ASCII decimal. The
// negation `n = 0 - n` is unsigned-safe for INT_MIN because
// we then read the result as u32 for the divmod chain, and
// -INT_MIN's unsigned value is exactly `2^31`.
//
// The digits are written backwards into `scratch[end..N]` then
// packed into a right-sized buffer with slot-aware array ops
// (`.with` / index), not a raw `__memcpy`: a byte copy assumes a
// PACKED `u8[]`, which holds on native / wasm but not on the
// self-hosted runtime (8-byte-slotted `u8[]`). The element-wise
// copy is layout-agnostic, so it is correct on every backend and
// lowers on the self-host IR path.
pub function int_to_string(n: i32): string {
    var scratch: u8[] = __alloc_u8(16);
    var end: i32 = 16;
    var neg: boolean = false;
    if (n < 0) {
        neg = true;
        n = 0 - n;
    }
    var u: u32 = n as u32;
    if (u == (0 as u32)) {
        end = end - 1;
        scratch = scratch.with(end, 48 as u8);
    } else {
        while (u != (0 as u32)) {
            end = end - 1;
            scratch = scratch.with(end, (((u % (10 as u32)) as i32) + 48) as u8);
            u = u / (10 as u32);
        }
    }
    if (neg) {
        end = end - 1;
        scratch = scratch.with(end, 45 as u8);
    }
    var n_bytes: i32 = 16 - end;
    // Pack the right-aligned digits `scratch[end..16]` into a fresh
    // `n_bytes`-long buffer using slot-aware array ops (`.with` / index)
    // rather than a raw `__memcpy` over `scratch as usize`. A raw byte copy
    // assumes a PACKED `u8[]` (one byte per element) — true on the native /
    // wasm backends but NOT on the self-hosted runtime, whose `u8[]` stores
    // each element in an 8-byte slot. The element-wise copy is correct on
    // every backend because `.with` / indexing / `string_from_bytes_unchecked` are all
    // layout-aware, so this is the portable shape (and lowers on the
    // self-host IR path, which the `__memcpy` form did not).
    var buf: u8[] = __alloc_u8(n_bytes);
    var i: i32 = 0;
    while (i < n_bytes) {
        buf = buf.with(i, scratch[end + i]);
        i = i + 1;
    }
    return string_from_bytes_unchecked(buf);
}

// `__int_to_string_u64(mag, neg)` — i64 / u64 cousin. `mag`
// carries the absolute value; `neg` is the sign flag (set
// for the i64-min path where the wrapped subtraction
// produces a u64 magnitude that's exact). The method
// wrappers in std/i64 / std/u32 / std/u64 dispatch here.
//
// Same usize-not-i32 contract as int_to_string above — see
// that comment for the native-arm64 high-mmap-address
// rationale.
pub function __int_to_string_u64(mag: i64, neg: i32): string {
    var scratch: u8[] = __alloc_u8(24);
    var end: i32 = 24;
    if (mag == (0 as i64)) {
        end = end - 1;
        scratch = scratch.with(end, 48 as u8);
    } else {
        while (mag != (0 as i64)) {
            end = end - 1;
            scratch = scratch.with(end, ((((mag as u64) % (10 as u64)) as i32) + 48) as u8);
            mag = ((mag as u64) / (10 as u64)) as i64;
        }
    }
    if (neg != 0) {
        end = end - 1;
        scratch = scratch.with(end, 45 as u8);
    }
    var n_bytes: i32 = 24 - end;
    // Slot-aware element copy of the right-aligned digits, not a raw
    // `__memcpy` over `scratch as usize` — see int_to_string for why the
    // byte-copy form miscompiles on the self-hosted runtime's slotted `u8[]`.
    var buf: u8[] = __alloc_u8(n_bytes);
    var i: i32 = 0;
    while (i < n_bytes) {
        buf = buf.with(i, scratch[end + i]);
        i = i + 1;
    }
    return string_from_bytes_unchecked(buf);
}

pub function __radix_digit(c: i32): i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }     // 0-9 → 0-9
    if (c >= 97 && c <= 122) { return c - 87; }     // a-z → 10-35
    if (c >= 65 && c <= 90)  { return c - 55; }     // A-Z → 10-35
    return 0 - 1;
}

pub function __radix_char(d: i32): i32 {
    if (d < 10) { return d + 48; }                   // 0-9
    return d + 87;                                    // a-z (lowercase)
}

pub function parse_int_radix(s: string, base: i32): Option[i32] {
    if (base < 2 || base > 36) { return None; }
    var n: i32 = s.len();
    if (n == 0) { return None; }
    var neg: boolean = false;
    var i: i32 = 0;
    if (s[0] == 45) {           // '-'
        neg = true;
        i = 1;
    } else if (s[0] == 43) {    // '+'
        i = 1;
    }
    if (i >= n) { return None; }    // sign without digits
    var v: i32 = 0;
    while (i < n) {
        var d: i32 = __radix_digit(s[i]);
        if (d < 0 || d >= base) { return None; }
        v = v * base + d;
        i = i + 1;
    }
    if (neg) { v = 0 - v; }
    return Some(v);
}

// `int_to_string_radix(n, base)` — render `n` in `base` (2..36), digits
// 0-9a-z, signed (a negative `n` gets a leading '-'). An out-of-range base
// (< 2 or > 36) returns "" as the "undefined" sentinel — the string-side
// mirror of `parse_int_radix`'s `None` on the same bad base. Callers passing
// a fixed valid base (`to_binary`/`to_hex`/… always do) never observe it.
pub function int_to_string_radix(n: i32, base: i32): string {
    if (base < 2 || base > 36) { return ""; }
    if (n == 0) { return "0"; }
    var neg: boolean = (n < 0);
    // Use i64 magnitude so INT_MIN's negation doesn't overflow.
    var mag: i64 = n as i64;
    if (neg) { mag = 0 - mag; }
    // Worst case is 32 binary digits + sign = 33; allocate slack.
    var digits: u8[] = __alloc_u8(33);
    var k: i32 = 0;
    var b64: i64 = base as i64;
    while (mag > (0 as i64)) {
        var d: i32 = (mag % b64) as i32;
        digits = digits.with(k, __radix_char(d) as u8);
        k = k + 1;
        mag = mag / b64;
    }
    var out_len: i32 = k;
    if (neg) { out_len = k + 1; }
    var buf: u8[] = __alloc_u8(out_len);
    var bi: i32 = 0;
    if (neg) {
        buf = buf.with(0, 45 as u8);        // '-'
        bi = 1;
    }
    var j: i32 = k - 1;
    while (j >= 0) {
        buf = buf.with(bi, digits[j]);
        bi = bi + 1;
        j = j - 1;
    }
    return string_from_bytes_unchecked(buf);
}
