// core/int — low-level integer to-string formatting helpers.
//
// `int_to_string(n)` and `__int_to_string_u64(mag, neg)` are
// the primitives the wider `(n).to_string()` method-syntax
// wrappers in `std/i32` / `std/i64` / `std/u32` / `std/u64`
// call into. They sit in `core/` because the implementation
// pokes raw memory (`__alloc_u8`, scratch buffers written
// backwards) — user code should reach for the method-syntax
// surface or `format(…)` rather than these directly.
//
// `parse_int_radix(s, base)` / `int_to_string_radix(n, base)`
// extend the same shape to bases 2..36 (digits 0-9 then a-z,
// ignoring case). Used by the `to_binary` / `to_oct` / `to_hex`
// / `parse_hex_int` / etc. method-style sugar in std/i32.

// __int_pair_table is "00", "01", … "99" concatenated: the two ASCII digits of
// `d` (0..99) live at offsets `2*d` and `2*d + 1`. It is what lets the
// conversion loops below consume TWO decimal digits per division.
//
// A string rather than a `u8[]` so it is a static constant on every backend —
// indexing a string yields a byte, and no allocation or one-time init is
// needed.
function __int_pair_table(): string {
    return "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899";
}

// __int_u32_digits returns how many decimal digits `u` needs, by a comparison
// ladder rather than by dividing.
//
// Knowing the width UP FRONT is what lets the conversion write straight into
// an exactly-sized buffer. The old shape could not: it discovered the width by
// dividing until zero, so it had to fill an over-sized scratch buffer from the
// right and then COPY the right-aligned tail into a second buffer. That copy
// is now gone — every conversion allocated and filled two buffers where one
// would do.
//
// Ten comparisons worst case, and a small integer (the common case: loop
// counters, indices, sizes) exits after one or two.
function __int_u32_digits(u: u32): i32 {
    if (u < (10 as u32)) { return 1; }
    if (u < (100 as u32)) { return 2; }
    if (u < (1000 as u32)) { return 3; }
    if (u < (10000 as u32)) { return 4; }
    if (u < (100000 as u32)) { return 5; }
    if (u < (1000000 as u32)) { return 6; }
    if (u < (10000000 as u32)) { return 7; }
    if (u < (100000000 as u32)) { return 8; }
    if (u < (1000000000 as u32)) { return 9; }
    return 10;
}

// `int_to_string(n)` — signed-i32 → ASCII decimal. The
// negation `n = 0 - n` is unsigned-safe for INT_MIN because
// we then read the result as u32 for the divmod chain, and
// -INT_MIN's unsigned value is exactly `2^31`.
//
// TWO DIGITS PER DIVISION, into an exactly-sized buffer. This was one divide
// and one modulo per digit, into an over-sized scratch buffer, followed by a
// full copy pass into a right-sized one — so a ten-digit number cost ten
// divisions, ten modulos, and two allocations. It now costs five of each and
// one allocation: `u % 100` indexes `__int_pair_table` for both digits at
// once, and `__int_u32_digits` gives the width before the loop starts so
// there is nothing to re-pack afterwards.
//
// Division is the expensive part — tens of cycles on every target here, and
// none of the backends turn a division by a runtime-shaped constant into the
// multiply-and-shift a C compiler would (see #6199 and the
// magic-number-division row in docs/SOTA-STDLIB-BLUEPRINT.md). Halving the
// count is the win available without that.
//
// Digits are written backwards into the buffer with slot-aware array ops
// (`.with` / index), not a raw `__memcpy`: a byte copy assumes a PACKED
// `u8[]`, which holds on native / wasm but not on the self-hosted runtime
// (8-byte-slotted `u8[]`). The element-wise form is layout-agnostic, so it is
// correct on every backend and lowers on the self-host IR path.
pub function int_to_string(n: i32): string {
    var neg: boolean = false;
    if (n < 0) {
        neg = true;
        n = 0 - n;
    }
    var u: u32 = n as u32;
    var ndig: i32 = __int_u32_digits(u);
    var total: i32 = ndig;
    if (neg) { total = total + 1; }
    var buf: u8[] = __alloc_u8(total);
    var tbl: string = __int_pair_table();
    var w: i32 = total;
    // Two digits at a time from the least significant end.
    while (u >= (100 as u32)) {
        var r: i32 = (u % (100 as u32)) as i32;
        u = u / (100 as u32);
        w = w - 2;
        buf = buf.with(w, tbl[r * 2] as u8);
        buf = buf.with(w + 1, tbl[r * 2 + 1] as u8);
    }
    // 1 or 2 digits left. Reading both from the table covers the two-digit
    // remainder without a second division; the one-digit case takes the low
    // half only, which is why the width was computed up front.
    var last: i32 = u as i32;
    if (u >= (10 as u32)) {
        w = w - 2;
        buf = buf.with(w, tbl[last * 2] as u8);
        buf = buf.with(w + 1, tbl[last * 2 + 1] as u8);
    } else {
        w = w - 1;
        buf = buf.with(w, (last + 48) as u8);
    }
    if (neg) { buf = buf.with(0, 45 as u8); }
    return string_from_bytes_unchecked(buf);
}

// `__int_to_string_u64(mag, neg)` — i64 / u64 cousin. `mag`
// carries the absolute value; `neg` is the sign flag (set
// for the i64-min path where the wrapped subtraction
// produces a u64 magnitude that's exact). The method
// wrappers in std/i64 / std/u32 / std/u64 dispatch here.
//
// Same usize-not-i32 contract as int_to_string above — see
// that comment for the native-arm64 high-mmap-address
// rationale.
// Same two-digits-per-division shape as int_to_string, at 64 bits. The width
// is counted by repeated division by 100 rather than by a comparison ladder:
// a u64 ladder would be twenty comparisons, and the count loop here runs at
// most ten times because it consumes two digits per step.
pub function __int_to_string_u64(mag: i64, neg: i32): string {
    var m: u64 = mag as u64;
    var ndig: i32 = 1;
    var probe: u64 = m;
    while (probe >= (100 as u64)) {
        ndig = ndig + 2;
        probe = probe / (100 as u64);
    }
    if (probe >= (10 as u64)) { ndig = ndig + 1; }
    var total: i32 = ndig;
    if (neg != 0) { total = total + 1; }
    var buf: u8[] = __alloc_u8(total);
    var tbl: string = __int_pair_table();
    var w: i32 = total;
    while (m >= (100 as u64)) {
        var r: i32 = (m % (100 as u64)) as i32;
        m = m / (100 as u64);
        w = w - 2;
        buf = buf.with(w, tbl[r * 2] as u8);
        buf = buf.with(w + 1, tbl[r * 2 + 1] as u8);
    }
    var last: i32 = m as i32;
    if (m >= (10 as u64)) {
        w = w - 2;
        buf = buf.with(w, tbl[last * 2] as u8);
        buf = buf.with(w + 1, tbl[last * 2 + 1] as u8);
    } else {
        w = w - 1;
        buf = buf.with(w, (last + 48) as u8);
    }
    if (neg != 0) { buf = buf.with(0, 45 as u8); }
    return string_from_bytes_unchecked(buf);
}

pub function __radix_digit(c: i32): i32 {
    if (c >= 48 && c <= 57)  { return (c as i32) - 48; }     // 0-9 → 0-9
    if (c >= 97 && c <= 122) { return (c as i32) - 87; }     // a-z → 10-35
    if (c >= 65 && c <= 90)  { return (c as i32) - 55; }     // A-Z → 10-35
    return 0 - 1;
}

pub function __radix_char(d: i32): i32 {
    if (d < 10) { return d + 48; }                   // 0-9
    return d + 87;                                    // a-z (lowercase)
}

pub function parse_int_radix(s: string, base: i32): Option[i32] {
    if (base < 2 || base > 36) { return None; }
    var n: i32 = s.len();
    if (n == 0) { return None; }
    var neg: boolean = false;
    var i: i32 = 0;
    if (s[0] == 45) {           // '-'
        neg = true;
        i = 1;
    } else if (s[0] == 43) {    // '+'
        i = 1;
    }
    if (i >= n) { return None; }    // sign without digits
    var v: i32 = 0;
    while (i < n) {
        var d: i32 = __radix_digit((s[i] as i32));
        if (d < 0 || d >= base) { return None; }
        v = v * base + d;
        i = i + 1;
    }
    if (neg) { v = 0 - v; }
    return Some(v);
}

// `int_to_string_radix(n, base)` — render `n` in `base` (2..36), digits
// 0-9a-z, signed (a negative `n` gets a leading '-'). An out-of-range base
// (< 2 or > 36) returns "" as the "undefined" sentinel — the string-side
// mirror of `parse_int_radix`'s `None` on the same bad base. Callers passing
// a fixed valid base (`to_binary`/`to_hex`/… always do) never observe it.
pub function int_to_string_radix(n: i32, base: i32): string {
    if (base < 2 || base > 36) { return ""; }
    if (n == 0) { return "0"; }
    var neg: boolean = (n < 0);
    // Use i64 magnitude so INT_MIN's negation doesn't overflow.
    var mag: i64 = n as i64;
    if (neg) { mag = 0 - mag; }
    // Worst case is 32 binary digits + sign = 33; allocate slack.
    var digits: u8[] = __alloc_u8(33);
    var k: i32 = 0;
    var b64: i64 = base as i64;
    while (mag > (0 as i64)) {
        var d: i32 = (mag % b64) as i32;
        digits = digits.with(k, __radix_char(d) as u8);
        k = k + 1;
        mag = mag / b64;
    }
    var out_len: i32 = k;
    if (neg) { out_len = k + 1; }
    var buf: u8[] = __alloc_u8(out_len);
    var bi: i32 = 0;
    if (neg) {
        buf = buf.with(0, 45 as u8);        // '-'
        bi = 1;
    }
    var j: i32 = k - 1;
    while (j >= 0) {
        buf = buf.with(bi, digits[j]);
        bi = bi + 1;
        j = j - 1;
    }
    return string_from_bytes_unchecked(buf);
}
