// std/io — convenience wrappers around the built-in Reader /
// Writer primitives.
//
// `read_all_stdin()` returns complete, validated stdin text as
// Result[string, IoError]; `read_input(path)` picks stdin or a file
// from a path operand and returns the same result type.
// The raw read_all_bytes/read_all_stdin_bytes/read_input_bytes counterparts
// return Result[u8[], IoError], preserving bytes and reporting I/O failures.
//
// The `path` these take is a plain `string`, so it inherits
// std/path's assumption that filesystem paths are valid UTF-8 —
// see that module's header for why there is no `OsStr` and what
// to do with a path that is not. This is the syscall boundary
// where such a path would enter, which is exactly where the
// problem should surface.
//
// No prelude: these are in scope only after a program
// declares `import "std/io";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

import "std/utf8" as utf8;

// The successful caller owns this packed buffer and must free it. Keeping
// it packed lets the text boundary validate without a whole-input u8[] copy.
function read_all_buffer(r: Reader): Result[usize, IoError] {
  let b: usize = buf_new(4096);
  while (true) {
    match (r.read_chunk_bytes(4096)) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return Ok(b);
        }
        buf_push_bytes_range(b, chunk, 0, chunk.len());
      },
      Err(e) => {
        buf_free(b);
        return Err(e);
      }
    }
  }
  return Ok(b);
}

// Read raw input to EOF without interpreting chunks as text. The caller owns
// the reader and remains responsible for closing it. A failed read returns
// its error, never a partial success; the accumulated buffer is released.
pub function read_all_bytes(r: Reader): Result[u8[], IoError] {
  match (read_all_buffer(r)) {
    Err(e) => {
      return Err(e);
    },
    Ok(b) => {
      let bytes: u8[] = buf_take_bytes(b);
      buf_free(b);
      return Ok(bytes);
    }
  }
}

function read_stdin_buffer(): Result[usize, IoError] {
  let r: Reader = stdin();
  let result: Result[usize, IoError] = read_all_buffer(r);
  let closed: Option[IoError] = r.close();
  match (result) {
    Err(e) => {
      return Err(e);
    },
    Ok(b) => {
      match (closed) {
        Some(e) => {
          buf_free(b);
          return Err(e);
        },
        None => {
          return Ok(b);
        }
      }
    }
  }
}

// Consume and close stdin. A read error takes precedence over a close error;
// otherwise a failed close is reported rather than silently discarded.
pub function read_all_stdin_bytes(): Result[u8[], IoError] {
  match (read_stdin_buffer()) {
    Err(e) => {
      return Err(e);
    },
    Ok(b) => {
      let bytes: u8[] = buf_take_bytes(b);
      buf_free(b);
      return Ok(bytes);
    }
  }
}

// Raw counterpart to read_input: empty and dash operands consume stdin;
// every other operand names a file. No UTF-8 decoding is performed.
pub function read_input_bytes(path: string): Result[u8[], IoError] {
  if (path == "-" || path == "") {
    return read_all_stdin_bytes();
  }
  return read_file_bytes(path);
}

// Consume and close stdin, then validate the complete input as UTF-8.
// A scalar may cross any read boundary. Empty input is Ok(""); malformed
// input is Err(InvalidUtf8("stdin")). I/O failures are propagated without
// returning partial text. Use read_all_stdin_bytes for arbitrary bytes.
pub function read_all_stdin(): Result[string, IoError] {
  match (read_stdin_buffer()) {
    Err(e) => {
      return Err(e);
    },
    Ok(b) => {
      // As in utf8.from_bytes, the unchecked representation stays
      // inside this constructor until validation succeeds.
      let text: string = buf_take(b);
      buf_free(b);
      if (utf8.is_valid_utf8(text)) {
        return Ok(text);
      }
      return Err(InvalidUtf8("stdin"));
    }
  }
}

// `read_input(path)` — read a CLI-style input operand: the
// conventional `-` (and the empty string) mean "read all of
// stdin"; any other value is a file path read via the `read_file`
// builtin. Returns `Result[string, IoError]` so callers can report
// a per-file error and continue — the exact shape the cat / wc /
// head / grep / … family wants instead of hand-rolling the
// stdin-vs-file branch in every tool.
//
//   match (io.read_input(path)) {
//     Ok(text) => { … },
//     Err(_)   => { eprint("tool: " + path + ": cannot open"); },
//   }
pub function read_input(path: string): Result[string, IoError] {
  if (path == "-" || path == "") {
    return read_all_stdin();
  }
  return read_file(path);
}
