// std/io — convenience wrappers around the built-in Reader /
// Writer primitives.
//
// `read_all_stdin()` pulls the whole of stdin into a single
// string; `read_input(path)` is the CLI-tool companion that picks
// stdin or a file from a path operand.
//
// No prelude: these are in scope only after a program
// declares `import "std/io";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

import "std/array";

// `read_all_stdin()` — read until EOF and return the result
// as a single string. Loops `Reader.read_chunk(4096)` until
// None.
//
// Chunks are collected into an array and joined once at EOF
// rather than folded with `out = out + chunk` per iteration.
// The naive fold is O(total²): each `+` copies the whole
// accumulated prefix, so an N-byte input in 4 KiB chunks
// copies ~N²/8192 bytes. `join` walks the chunk list twice
// (sum the lengths, then one preallocated blit), so the whole
// read is O(total). This is the core-CLI hot path — every
// `read_input("-")` from cat / wc / head / grep / … lands here.
pub function read_all_stdin(): string {
    var r: Reader = stdin();
    var chunks: string[] = [];
    while (true) {
        match (r.read_chunk(4096)) {
            Some(chunk) => { chunks = chunks.append(chunk); },
            None => {
                r.close();
                return chunks.join("");
            },
        }
    }
    return "";
}

// `read_input(path)` — read a CLI-style input operand: the
// conventional `-` (and the empty string) mean "read all of
// stdin"; any other value is a file path read via the `read_file`
// builtin. Returns `Result[string, IoError]` so callers can report
// a per-file error and continue — the exact shape the cat / wc /
// head / grep / … family wants instead of hand-rolling the
// stdin-vs-file branch in every tool.
//
//   match (io.read_input(path)) {
//     Ok(text) => { … },
//     Err(_)   => { eprint("tool: " + path + ": cannot open"); },
//   }
pub function read_input(path: string): Result[string, IoError] {
    if (path == "-" || path == "") {
        return Ok(read_all_stdin());
    }
    return read_file(path);
}
