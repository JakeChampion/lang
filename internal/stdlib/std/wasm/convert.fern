// std/wasm/convert — conversion + reinterpret + sign-extension
// instruction encoders for the WebAssembly Core 1.0 binary format.
//
// Spec: https://webassembly.github.io/spec/core/binary/instructions.html#numeric-instructions
// (the "Conversions" subsection plus the sign-extension extension).
//
// Sixth slice of Phase 1 of docs/TOOLCHAIN-SELF-HOSTING.md.
// Conversions are the last big single-byte / no-immediate family:
//
//   - Integer width: i32.wrap_i64, i64.extend_i32_{s,u}
//   - Float-to-int: i32 / i64 . trunc_f{32,64}_{s,u}
//   - Int-to-float: f32 / f64 . convert_i{32,64}_{s,u}
//   - Float width:  f32.demote_f64, f64.promote_f32
//   - Reinterpret (bit-pattern coercion, no value change):
//     i32.reinterpret_f32, i64.reinterpret_f64,
//     f32.reinterpret_i32, f64.reinterpret_i64
//   - Sign-extension (added after wasm 1.0 but always assumed
//     present today): i32.extend{8,16}_s, i64.extend{8,16,32}_s
//
// Same one-line shape as numeric.fern. ~28 functions.
// Saturating-truncate (multi-byte 0xFC-prefix) ops aren't included
// — the production wasm backend uses the trapping variants.

// ---- Integer width conversion ---------------------------------
pub function inst_i32_wrap_i64(buf: u8[]): u8[]     { return buf.push(167u8); }  // 0xA7
pub function inst_i64_extend_i32_s(buf: u8[]): u8[] { return buf.push(172u8); }  // 0xAC
pub function inst_i64_extend_i32_u(buf: u8[]): u8[] { return buf.push(173u8); }  // 0xAD

// ---- Float to integer (trapping) ------------------------------
pub function inst_i32_trunc_f32_s(buf: u8[]): u8[] { return buf.push(168u8); }  // 0xA8
pub function inst_i32_trunc_f32_u(buf: u8[]): u8[] { return buf.push(169u8); }  // 0xA9
pub function inst_i32_trunc_f64_s(buf: u8[]): u8[] { return buf.push(170u8); }  // 0xAA
pub function inst_i32_trunc_f64_u(buf: u8[]): u8[] { return buf.push(171u8); }  // 0xAB
pub function inst_i64_trunc_f32_s(buf: u8[]): u8[] { return buf.push(174u8); }  // 0xAE
pub function inst_i64_trunc_f32_u(buf: u8[]): u8[] { return buf.push(175u8); }  // 0xAF
pub function inst_i64_trunc_f64_s(buf: u8[]): u8[] { return buf.push(176u8); }  // 0xB0
pub function inst_i64_trunc_f64_u(buf: u8[]): u8[] { return buf.push(177u8); }  // 0xB1

// ---- Integer to float -----------------------------------------
pub function inst_f32_convert_i32_s(buf: u8[]): u8[] { return buf.push(178u8); }  // 0xB2
pub function inst_f32_convert_i32_u(buf: u8[]): u8[] { return buf.push(179u8); }  // 0xB3
pub function inst_f32_convert_i64_s(buf: u8[]): u8[] { return buf.push(180u8); }  // 0xB4
pub function inst_f32_convert_i64_u(buf: u8[]): u8[] { return buf.push(181u8); }  // 0xB5
pub function inst_f64_convert_i32_s(buf: u8[]): u8[] { return buf.push(183u8); }  // 0xB7
pub function inst_f64_convert_i32_u(buf: u8[]): u8[] { return buf.push(184u8); }  // 0xB8
pub function inst_f64_convert_i64_s(buf: u8[]): u8[] { return buf.push(185u8); }  // 0xB9
pub function inst_f64_convert_i64_u(buf: u8[]): u8[] { return buf.push(186u8); }  // 0xBA

// ---- Float width ----------------------------------------------
pub function inst_f32_demote_f64(buf: u8[]): u8[]  { return buf.push(182u8); }  // 0xB6
pub function inst_f64_promote_f32(buf: u8[]): u8[] { return buf.push(187u8); }  // 0xBB

// ---- Reinterpret ----------------------------------------------
//
// No conversion — the same 32 / 64 bits leave the stack with a
// different type label. Useful for inspecting f32 / f64 bit
// patterns or constructing them from u32 / u64.
pub function inst_i32_reinterpret_f32(buf: u8[]): u8[] { return buf.push(188u8); }  // 0xBC
pub function inst_i64_reinterpret_f64(buf: u8[]): u8[] { return buf.push(189u8); }  // 0xBD
pub function inst_f32_reinterpret_i32(buf: u8[]): u8[] { return buf.push(190u8); }  // 0xBE
pub function inst_f64_reinterpret_i64(buf: u8[]): u8[] { return buf.push(191u8); }  // 0xBF

// ---- Sign-extension -------------------------------------------
//
// These were a wasm 1.1 extension (the "sign-extension"
// proposal). Universally available in production engines today.
// They sign-extend the low 8 / 16 / 32 bits of the operand,
// filling the remaining bits with the sign.
pub function inst_i32_extend8_s(buf: u8[]): u8[]  { return buf.push(192u8); }  // 0xC0
pub function inst_i32_extend16_s(buf: u8[]): u8[] { return buf.push(193u8); }  // 0xC1
pub function inst_i64_extend8_s(buf: u8[]): u8[]  { return buf.push(194u8); }  // 0xC2
pub function inst_i64_extend16_s(buf: u8[]): u8[] { return buf.push(195u8); }  // 0xC3
pub function inst_i64_extend32_s(buf: u8[]): u8[] { return buf.push(196u8); }  // 0xC4
