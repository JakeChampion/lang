// std/wasm/module — top-level module composer for the
// WebAssembly Core 1.0 binary format.
//
// Spec: https://webassembly.github.io/spec/core/binary/modules.html
//
// Ninth slice of Phase 1 of docs/TOOLCHAIN-SELF-HOSTING.md.
// Bundles the section composers (sections.fern + imports.fern)
// behind a single `build` entry point: a caller fills in a
// `Module` struct field-by-field, then calls `build(m)` to get
// the complete module bytes back.
//
// Section ordering matters — the wasm spec requires sections in
// the order: type, import, function, table, memory, global,
// export, start, element, code, data. `build` emits them in that
// order, skipping any section whose input is empty.

import "std/wasm/encode";
import "std/wasm/sections";
import "std/wasm/imports";

// Module — the per-section inputs the existing section composers
// each take. Vector sections (`type_*`, `import_*`, `function_*`,
// `global_*`, `export_*`, `code_*`, `data_*`) skip emitting their
// section header when empty. Singleton sections (memory, start)
// gate on the matching boolean.
pub struct Module {
    // Type section
    type_params: u8[][],
    type_results: u8[][],

    // Import section
    import_modules: string[],
    import_names: string[],
    import_kinds: u8[],
    import_descs: u8[][],

    // Function section — one typeidx per declared (non-imported)
    // function, in declaration order.
    function_typeidxs: u32[],

    // Table section. wasm 1.0 caps tables at 1; `table_present`
    // gates a single funcref table for call_indirect dispatch.
    // `table_max = -1` means "no maximum".
    table_present: boolean,
    table_reftype: u8,
    table_min: u32,
    table_max: i32,

    // Memory section. wasm 1.0 caps memories at 1, so a single
    // optional limits record is enough.
    memory_present: boolean,
    memory_min: u32,
    memory_max: i32,

    // Global section
    global_valtypes: u8[],
    global_muts: u8[],
    global_inits: u8[][],

    // Export section
    export_names: string[],
    export_kinds: u8[],
    export_idxs: u32[],

    // Start section
    has_start: boolean,
    start_funcidx: u32,

    // Element section — active funcref segments that initialise
    // the table for call_indirect. Parallel arrays: one offset and
    // one funcidx list per segment.
    elem_offsets: i32[],
    elem_funcidxs: u32[][],

    // Code section — one pre-wrapped function body
    // (from inst.put_function_body) per typeidx in function_typeidxs.
    code_bodies: u8[][],

    // Data section
    data_offsets: i32[],
    data_inits: u8[][],
}

// module_new — a Module with every section empty. Callers
// populate the fields they need before calling build().
pub function module_new(): Module {
    return Module {
        type_params: [],
        type_results: [],
        import_modules: [],
        import_names: [],
        import_kinds: [],
        import_descs: [],
        function_typeidxs: [],
        table_present: false,
        table_reftype: 112u8,
        table_min: 0u32,
        table_max: 0 - 1,
        memory_present: false,
        memory_min: 0u32,
        memory_max: 0 - 1,
        global_valtypes: [],
        global_muts: [],
        global_inits: [],
        export_names: [],
        export_kinds: [],
        export_idxs: [],
        has_start: false,
        start_funcidx: 0u32,
        elem_offsets: [],
        elem_funcidxs: [],
        code_bodies: [],
        data_offsets: [],
        data_inits: [],
    };
}

// ============================================================
// Builder methods — populate a section and return a NEW Module
// (immutable update; the receiver is unchanged). Chain them off
// `module_new()`:
//
//     var m: module.Module = module.module_new()
//         .with_types([p0], [r0])
//         .with_functions([0u32])
//         .with_exports(["main"], [sections.export_func()], [0u32])
//         .with_code([fn]);
//
// Section field-groups (e.g. type_params + type_results) are set
// together so a populated section is never left half-built, and
// the singleton-section flags (`*_present` / `has_start`) are
// folded into the matching builder so callers can't set the data
// without the gate.
// ============================================================

// with_types — type section: one functype per (params, results)
// pair (parallel arrays).
pub function (m: Module) with_types(params: u8[][], results: u8[][]): Module {
    return Module { ...m, type_params: params, type_results: results };
}

// with_imports — import section: parallel (module, name, kind,
// desc) arrays, one per import.
pub function (m: Module) with_imports(modules: string[], names: string[], kinds: u8[], descs: u8[][]): Module {
    return Module { ...m, import_modules: modules, import_names: names, import_kinds: kinds, import_descs: descs };
}

// with_functions — function section: one typeidx per declared
// (non-imported) function, in declaration order.
pub function (m: Module) with_functions(typeidxs: u32[]): Module {
    return Module { ...m, function_typeidxs: typeidxs };
}

// with_table — table section (sets table_present). `max = -1`
// means "no maximum".
pub function (m: Module) with_table(reftype: u8, min: u32, max: i32): Module {
    return Module { ...m, table_present: true, table_reftype: reftype, table_min: min, table_max: max };
}

// with_memory — memory section (sets memory_present). `max = -1`
// means "no maximum".
pub function (m: Module) with_memory(min: u32, max: i32): Module {
    return Module { ...m, memory_present: true, memory_min: min, memory_max: max };
}

// with_globals — global section: parallel (valtype, mut, init)
// arrays, one per global.
pub function (m: Module) with_globals(valtypes: u8[], muts: u8[], inits: u8[][]): Module {
    return Module { ...m, global_valtypes: valtypes, global_muts: muts, global_inits: inits };
}

// with_exports — export section: parallel (name, kind, idx)
// arrays, one per export.
pub function (m: Module) with_exports(names: string[], kinds: u8[], idxs: u32[]): Module {
    return Module { ...m, export_names: names, export_kinds: kinds, export_idxs: idxs };
}

// with_start — start section (sets has_start).
pub function (m: Module) with_start(funcidx: u32): Module {
    return Module { ...m, has_start: true, start_funcidx: funcidx };
}

// with_elements — element section: parallel (offset, funcidx-list)
// arrays, one active funcref segment per pair.
pub function (m: Module) with_elements(offsets: i32[], funcidxs: u32[][]): Module {
    return Module { ...m, elem_offsets: offsets, elem_funcidxs: funcidxs };
}

// with_code — code section: one pre-wrapped function body per
// typeidx in function_typeidxs.
pub function (m: Module) with_code(bodies: u8[][]): Module {
    return Module { ...m, code_bodies: bodies };
}

// with_data — data section: parallel (offset, init-bytes) arrays,
// one active data segment per pair.
pub function (m: Module) with_data(offsets: i32[], inits: u8[][]): Module {
    return Module { ...m, data_offsets: offsets, data_inits: inits };
}

// build — serialise the module to the complete wasm binary:
// preamble (\0asm + version 1) followed by every populated
// section in spec-required order.
pub function build(m: Module): u8[] {
    var bytes: u8[] = encode.put_module_header([]);

    if (m.type_params.len() > 0) {
        bytes = sections.encode_type_section(bytes, m.type_params, m.type_results);
    }

    if (m.import_modules.len() > 0) {
        bytes = imports.encode_import_section(bytes, m.import_modules, m.import_names, m.import_kinds, m.import_descs);
    }

    if (m.function_typeidxs.len() > 0) {
        bytes = sections.encode_function_section(bytes, m.function_typeidxs);
    }

    if (m.table_present) {
        bytes = sections.encode_table_section(bytes, m.table_reftype, m.table_min, m.table_max);
    }

    if (m.memory_present) {
        bytes = sections.encode_memory_section(bytes, m.memory_min, m.memory_max);
    }

    if (m.global_valtypes.len() > 0) {
        bytes = imports.encode_global_section(bytes, m.global_valtypes, m.global_muts, m.global_inits);
    }

    if (m.export_names.len() > 0) {
        bytes = sections.encode_export_section(bytes, m.export_names, m.export_kinds, m.export_idxs);
    }

    if (m.has_start) {
        bytes = sections.encode_start_section(bytes, m.start_funcidx);
    }

    if (m.elem_offsets.len() > 0) {
        bytes = sections.encode_element_section(bytes, m.elem_offsets, m.elem_funcidxs);
    }

    if (m.code_bodies.len() > 0) {
        bytes = sections.encode_code_section(bytes, m.code_bodies);
    }

    if (m.data_offsets.len() > 0) {
        bytes = sections.encode_data_section(bytes, m.data_offsets, m.data_inits);
    }

    return bytes;
}
