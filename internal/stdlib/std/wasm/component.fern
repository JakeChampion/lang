}

pub function put_import_section_funcs(buf: u8[], names: string[], typeidxs: u32[]): u8[] {
  let body: u8[] = [];
  let n: i32 = names.len();
  body = leb128.uleb_u32(body, n as u32);
  let i: i32 = 0;
  while (i < n) {
    body = body.append(0u8);
    body = encode.put_name(body, names[i]);
    body = body.append(1u8);
    body = leb128.uleb_u32(body, typeidxs[i]);
    i = i + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_import());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_import_section_one_func(buf: u8[], name: string, typeidx: u32): u8[] {
  let names: string[] = [name];
  let typeidxs: u32[] = [typeidx];
  return put_import_section_funcs(buf, names, typeidxs);
}

pub function put_canon_section_lowers_no_opts(buf: u8[], func_idxs: u32[]): u8[] {
  let body: u8[] = [];
  let n: i32 = func_idxs.len();
  body = leb128.uleb_u32(body, n as u32);
  let i: i32 = 0;
  while (i < n) {
    body = body.append(1u8);
    body = body.append(0u8);
    body = leb128.uleb_u32(body, func_idxs[i]);
    body = leb128.uleb_u32(body, 0u32);
    i = i + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_canon());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_canon_section_lower_no_opts(buf: u8[], func_idx: u32): u8[] {
  let func_idxs: u32[] = [func_idx];
  return put_canon_section_lowers_no_opts(buf, func_idxs);
}

pub function put_export_section_funcs(buf: u8[], names: string[], func_idxs: u32[]): u8[] {
  let body: u8[] = [];
  let n: i32 = names.len();
  body = leb128.uleb_u32(body, n as u32);
  let i: i32 = 0;
  while (i < n) {
    body = body.append(0u8);
    body = encode.put_name(body, names[i]);
    body = body.append(1u8);
    body = leb128.uleb_u32(body, func_idxs[i]);
    body = body.append(0u8);
    i = i + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_export());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_export_section_one_func(buf: u8[], name: string, func_idx: u32): u8[] {
  let names: string[] = [name];
  let func_idxs: u32[] = [func_idx];
  return put_export_section_funcs(buf, names, func_idxs);
}

pub function build_lifted_export_component(core_bytes: u8[], core_export_name: string, export_name: string, result_valtype: u8): u8[] {
  let no_names: string[] = [];
  let no_valtypes: u8[] = [];
  return build_lifted_export_component_with_params(core_bytes, core_export_name, export_name, no_names, no_valtypes, result_valtype);
}

pub function build_lifted_export_component_with_params(core_bytes: u8[], core_export_name: string, export_name: string, param_names: string[], param_valtypes: u8[], result_valtype: u8): u8[] {
  let comp: u8[] = put_component_header([]);
  comp = put_core_module_section(comp, core_bytes);
  comp = put_core_instance_section_instantiate(comp, 0u32);
  comp = put_alias_section_core_export_func(comp, 0u32, core_export_name);
  comp = put_type_section_one_func(comp, param_names, param_valtypes, result_valtype);
  comp = put_canon_section_lift_no_opts(comp, 0u32, 0u32);
  comp = put_export_section_one_func(comp, export_name, 0u32);
  return comp;
}

pub function build_wasi_imported_component(core_bytes: u8[], interface_name: string, func_name: string, wasi_param_names: string[], wasi_param_valtypes: u8[], core_import_module: string): u8[] {
  let interface_names: string[] = [interface_name];
  let func_names: string[] = [func_name];
  let names_per: string[][] = [wasi_param_names];
  let valtypes_per: u8[][] = [wasi_param_valtypes];
  let core_modules: string[] = [core_import_module];
  return build_wasi_multi_imported_component(core_bytes, interface_names, func_names, names_per, valtypes_per, core_modules);
}

pub function build_wasi_multi_imported_component(core_bytes: u8[], interface_names: string[], func_names: string[], wasi_param_names_per: string[][], wasi_param_valtypes_per: u8[][], core_import_modules: string[]): u8[] {
  let comp: u8[] = put_component_header([]);
  let n: i32 = interface_names.len();

  let i: i32 = 0;
  while (i < n) {
    comp = put_type_section_one_instance_one_func_export(comp, func_names[i], wasi_param_names_per[i], wasi_param_valtypes_per[i]);
    comp = put_import_section_one_instance(comp, interface_names[i], i as u32);
    comp = put_alias_section_instance_export_func(comp, i as u32, func_names[i]);
    comp = put_canon_section_lower_no_opts(comp, i as u32);
    comp = put_core_instance_section_from_one_func_export(comp, func_names[i], i as u32);
    i = i + 1;
  }

  comp = put_core_module_section(comp, core_bytes);
  let instance_idxs: u32[] = [];
  let j: i32 = 0;
  while (j < n) {
    instance_idxs = instance_idxs.append(j as u32);
    j = j + 1;
  }
  comp = put_core_instance_section_instantiate_with_instance_args(comp, 0u32, core_import_modules, instance_idxs);
  return comp;
}
