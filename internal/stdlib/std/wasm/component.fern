  return encode.put_bytes(out, body);
}

pub function put_type_section_one_instance_one_func_export(buf: u8[], export_name: string, param_names: string[], param_valtypes: u8[]): u8[] {
  let names_per: string[][] = [param_names];
  let valtypes_per: u8[][] = [param_valtypes];
  let export_names: string[] = [export_name];
  return put_type_section_one_instance_with_func_exports(buf, export_names, names_per, valtypes_per);
}

pub function put_type_section_one_instance_one_func_with_result_export(buf: u8[], export_name: string, param_names: string[], param_valtypes: u8[], result_valtype: u8): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(66u8);
  body = leb128.uleb_u32(body, 2u32);

  body = body.append(1u8);
  body = body.append(64u8);
  let np: i32 = param_names.len();
  body = leb128.uleb_u32(body, np as u32);
  let i: i32 = 0;
  while (i < np) {
    body = encode.put_name(body, param_names[i]);
    body = body.append(param_valtypes[i]);
    i = i + 1;
  }
  body = body.append(0u8);
  body = body.append(result_valtype);

  body = body.append(4u8);
  body = body.append(0u8);
  body = encode.put_name(body, export_name);
  body = body.append(1u8);
  body = leb128.uleb_u32(body, 0u32);

  let out: u8[] = buf;
  out = out.append(section_type());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_type_section_one_instance_with_func_exports(buf: u8[], export_names: string[], param_names_per_func: string[][], param_valtypes_per_func: u8[][]): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(66u8);
  let n: i32 = export_names.len();
  body = leb128.uleb_u32(body, (n * 2) as u32);

  let f: i32 = 0;
  while (f < n) {
    body = body.append(1u8);
    body = body.append(64u8);
    let p_names: string[] = param_names_per_func[f];
    let p_valtypes: u8[] = param_valtypes_per_func[f];
    let np: i32 = p_names.len();
    body = leb128.uleb_u32(body, np as u32);
    let i: i32 = 0;
    while (i < np) {
      body = encode.put_name(body, p_names[i]);
      body = body.append(p_valtypes[i]);
      i = i + 1;
    }
    body = body.append(1u8);
    body = leb128.uleb_u32(body, 0u32);

    body = body.append(4u8);
    body = body.append(0u8);
    body = encode.put_name(body, export_names[f]);
    body = body.append(1u8);
    body = leb128.uleb_u32(body, f as u32);

    f = f + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_type());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_import_section_one_instance(buf: u8[], name: string, instance_typeidx: u32): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(0u8);
  body = encode.put_name(body, name);
  body = body.append(5u8);
  body = leb128.uleb_u32(body, instance_typeidx);

  let out: u8[] = buf;
  out = out.append(section_import());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

