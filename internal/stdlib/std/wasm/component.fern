  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(105u8);
  body = leb128.uleb_u32(body, resource_typeidx);

  let out: u8[] = buf;
  out = out.append(section_type());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_type_section_one_borrow(buf: u8[], resource_typeidx: u32): u8[] {
  let body: u8[] = [];
