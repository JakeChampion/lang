pub function put_start_section_no_args_no_results(buf: u8[], funcidx: u32): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, funcidx);
  body = leb128.uleb_u32(body, 0u32);
  body = leb128.uleb_u32(body, 0u32);

  let out: u8[] = buf;
  out = out.append(section_start());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_alias_section_core_exports(buf: u8[], core_sorts: u8[], core_instance_idxs: u32[], names: string[]): u8[] {
  let body: u8[] = [];
  let n: i32 = core_sorts.len();
  body = leb128.uleb_u32(body, n as u32);
  let i: i32 = 0;
  while (i < n) {
    body = body.append(0u8);
    body = body.append(core_sorts[i]);
    body = body.append(1u8);
    body = leb128.uleb_u32(body, core_instance_idxs[i]);
    body = encode.put_name(body, names[i]);
    i = i + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_alias());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_alias_section_core_export_func(buf: u8[], core_instance_idx: u32, name: string): u8[] {
  let sorts: u8[] = [core_sort_func()];
  let instance_idxs: u32[] = [core_instance_idx];
  let names: string[] = [name];
  return put_alias_section_core_exports(buf, sorts, instance_idxs, names);
}

pub function put_alias_section_instance_export_func(buf: u8[], instance_idx: u32, name: string): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(1u8);
  body = body.append(0u8);
  body = leb128.uleb_u32(body, instance_idx);
  body = encode.put_name(body, name);

  let out: u8[] = buf;
  out = out.append(section_alias());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_canon_section_lifts_no_opts(buf: u8[], core_func_idxs: u32[], typeidxs: u32[]): u8[] {
  let body: u8[] = [];
  let n: i32 = core_func_idxs.len();
  body = leb128.uleb_u32(body, n as u32);
  let i: i32 = 0;
  while (i < n) {
    body = body.append(0u8);
    body = body.append(0u8);
    body = leb128.uleb_u32(body, core_func_idxs[i]);
    body = leb128.uleb_u32(body, 0u32);
    body = leb128.uleb_u32(body, typeidxs[i]);
    i = i + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_canon());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_canon_section_lift_no_opts(buf: u8[], core_func_idx: u32, typeidx: u32): u8[] {
  let core_idxs: u32[] = [core_func_idx];
  let type_idxs: u32[] = [typeidx];
  return put_canon_section_lifts_no_opts(buf, core_idxs, type_idxs);
}

pub function canonopt_string_encoding_utf8(): u8 {
  return 0u8;
}

pub function canonopt_string_encoding_utf16(): u8 {
  return 1u8;
}

pub function canonopt_string_encoding_latin1_utf16(): u8 {
  return 2u8;
}

pub function canonopt_memory(): u8 {
  return 3u8;
}

pub function canonopt_realloc(): u8 {
  return 4u8;
}

pub function canonopt_post_return(): u8 {
  return 5u8;
}

pub function put_canon_section_lower_mem_realloc(buf: u8[], func_idx: u32, mem_idx: u32, realloc_func_idx: u32): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(1u8);
  body = body.append(0u8);
  body = leb128.uleb_u32(body, func_idx);
  body = leb128.uleb_u32(body, 2u32);
  body = body.append(canonopt_memory());
  body = leb128.uleb_u32(body, mem_idx);
  body = body.append(canonopt_realloc());
  body = leb128.uleb_u32(body, realloc_func_idx);

  let out: u8[] = buf;
  out = out.append(section_canon());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_canon_section_lift_mem_realloc_post_return(buf: u8[], core_func_idx: u32, typeidx: u32, mem_idx: u32, realloc_func_idx: u32, post_return_func_idx: u32): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(0u8);
  body = body.append(0u8);
  body = leb128.uleb_u32(body, core_func_idx);
  body = leb128.uleb_u32(body, 3u32);
  body = body.append(canonopt_memory());
  body = leb128.uleb_u32(body, mem_idx);
  body = body.append(canonopt_realloc());
  body = leb128.uleb_u32(body, realloc_func_idx);
  body = body.append(canonopt_post_return());
  body = leb128.uleb_u32(body, post_return_func_idx);
  body = leb128.uleb_u32(body, typeidx);

  let out: u8[] = buf;
  out = out.append(section_canon());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_canon_section_lift_mem_realloc_encoding(buf: u8[], core_func_idx: u32, typeidx: u32, mem_idx: u32, realloc_func_idx: u32, encoding_tag: u8): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
