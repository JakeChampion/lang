// This module constructs WebAssembly components in binary format.

import "std/wasm/leb128";
import "std/wasm/encode";

pub function section_core_module(): u8 {
  return 1u8;
}

pub function section_core_instance(): u8 {
  return 2u8;
}

pub function section_core_type(): u8 {
  return 3u8;
}

pub function section_instance(): u8 {
  return 5u8;
}

pub function section_alias(): u8 {
  return 6u8;
}

pub function section_type(): u8 {
  return 7u8;
}

pub function section_canon(): u8 {
  return 8u8;
}

pub function section_start(): u8 {
  return 9u8;
}

pub function section_import(): u8 {
  return 10u8;
}

pub function section_export(): u8 {
  return 11u8;
}

pub function put_component_header(buf: u8[]): u8[] {
  let out: u8[] = buf;
  out = out.append(0u8);
  out = out.append(97u8);
  out = out.append(115u8);
  out = out.append(109u8);
  out = out.append(13u8);
  out = out.append(0u8);
  out = out.append(1u8);
  out = out.append(0u8);
  return out;
}

pub function put_core_module_section(buf: u8[], core_bytes: u8[]): u8[] {
  let out: u8[] = buf;
  out = out.append(section_core_module());
  out = leb128.uleb_u32(out, core_bytes.len() as u32);
  return encode.put_bytes(out, core_bytes);
}

pub function put_core_type_section_one_func(buf: u8[], param_valtypes: u8[], result_valtypes: u8[]): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(96u8);
  let np: i32 = param_valtypes.len();
  body = leb128.uleb_u32(body, np as u32);
  let i: i32 = 0;
  while (i < np) {
    body = body.append(param_valtypes[i]);
    i = i + 1;
  }
  let nr: i32 = result_valtypes.len();
  body = leb128.uleb_u32(body, nr as u32);
  i = 0;
  while (i < nr) {
    body = body.append(result_valtypes[i]);
    i = i + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_core_type());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_component_type_section(buf: u8[], payload: u8[]): u8[] {
  let body: u8[] = encode.put_name([], "component-type");
  body = encode.put_bytes(body, payload);

  let out: u8[] = buf;
  out = out.append(0u8);
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_core_instance_section_instantiate(buf: u8[], module_idx: u32): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(0u8);
  body = leb128.uleb_u32(body, module_idx);
  body = leb128.uleb_u32(body, 0u32);

  let out: u8[] = buf;
  out = out.append(section_core_instance());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function core_sort_func(): u8 {
  return 0u8;
}

pub function core_sort_table(): u8 {
  return 1u8;
}

pub function core_sort_memory(): u8 {
  return 2u8;
}

pub function core_sort_global(): u8 {
  return 3u8;
}

pub function core_sort_type(): u8 {
  return 16u8;
}

pub function core_sort_module(): u8 {
  return 17u8;
}

pub function core_sort_instance(): u8 {
  return 18u8;
}

pub function put_core_instance_section_from_func_exports(buf: u8[], export_names: string[], core_func_idxs: u32[]): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(1u8);
  let n: i32 = export_names.len();
  body = leb128.uleb_u32(body, n as u32);
  let i: i32 = 0;
  while (i < n) {
    body = encode.put_name(body, export_names[i]);
    body = body.append(core_sort_func());
    body = leb128.uleb_u32(body, core_func_idxs[i]);
    i = i + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_core_instance());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_core_instance_section_from_one_func_export(buf: u8[], export_name: string, core_func_idx: u32): u8[] {
  let names: string[] = [export_name];
  let idxs: u32[] = [core_func_idx];
  return put_core_instance_section_from_func_exports(buf, names, idxs);
}

pub function put_core_instance_section_instantiate_with_instance_args(buf: u8[], module_idx: u32, arg_names: string[], instance_idxs: u32[]): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(0u8);
  body = leb128.uleb_u32(body, module_idx);
  let n: i32 = arg_names.len();
  body = leb128.uleb_u32(body, n as u32);
  let i: i32 = 0;
  while (i < n) {
    body = encode.put_name(body, arg_names[i]);
    body = body.append(core_sort_instance());
    body = leb128.uleb_u32(body, instance_idxs[i]);
    i = i + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_core_instance());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_core_instance_section_instantiate_with_one_instance_arg(buf: u8[], module_idx: u32, arg_name: string, instance_idx: u32): u8[] {
  let names: string[] = [arg_name];
  let idxs: u32[] = [instance_idx];
  return put_core_instance_section_instantiate_with_instance_args(buf, module_idx, names, idxs);
}

pub function cvaltype_bool(): u8 {
  return 127u8;
}

pub function cvaltype_s8(): u8 {
  return 126u8;
}

pub function cvaltype_u8(): u8 {
  return 125u8;
}

pub function cvaltype_s16(): u8 {
  return 124u8;
}

pub function cvaltype_u16(): u8 {
  return 123u8;
}

pub function cvaltype_s32(): u8 {
  return 122u8;
}

pub function cvaltype_u32(): u8 {
  return 121u8;
}

pub function cvaltype_s64(): u8 {
  return 120u8;
}

pub function cvaltype_u64(): u8 {
  return 119u8;
}

pub function cvaltype_f32(): u8 {
  return 118u8;
}

pub function cvaltype_f64(): u8 {
  return 117u8;
}

pub function cvaltype_char(): u8 {
  return 116u8;
}

pub function cvaltype_string(): u8 {
  return 115u8;
}

pub function put_type_section_funcs(buf: u8[], param_names_per_func: string[][], param_valtypes_per_func: u8[][], result_valtype_per_func: u8[]): u8[] {
  let body: u8[] = [];
  let n: i32 = result_valtype_per_func.len();
  body = leb128.uleb_u32(body, n as u32);
  let t: i32 = 0;
  while (t < n) {
    body = body.append(64u8);
    let p_names: string[] = param_names_per_func[t];
    let p_valtypes: u8[] = param_valtypes_per_func[t];
    let pn: i32 = p_names.len();
    body = leb128.uleb_u32(body, pn as u32);
    let i: i32 = 0;
    while (i < pn) {
      body = encode.put_name(body, p_names[i]);
      body = body.append(p_valtypes[i]);
      i = i + 1;
    }
    body = body.append(0u8);
    body = body.append(result_valtype_per_func[t]);
    t = t + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_type());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_type_section_one_func(buf: u8[], param_names: string[], param_valtypes: u8[], result_valtype: u8): u8[] {
  let names_per: string[][] = [param_names];
  let valtypes_per: u8[][] = [param_valtypes];
  let results_per: u8[] = [result_valtype];
  return put_type_section_funcs(buf, names_per, valtypes_per, results_per);
}

pub function put_type_section_one_func_no_param(buf: u8[], result_valtype: u8): u8[] {
  let no_names: string[] = [];
  let no_valtypes: u8[] = [];
  return put_type_section_one_func(buf, no_names, no_valtypes, result_valtype);
}

pub function put_type_section_one_func_no_result(buf: u8[], param_names: string[], param_valtypes: u8[]): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(64u8);
  let n: i32 = param_names.len();
  body = leb128.uleb_u32(body, n as u32);
  let i: i32 = 0;
  while (i < n) {
    body = encode.put_name(body, param_names[i]);
    body = body.append(param_valtypes[i]);
    i = i + 1;
  }
  body = body.append(1u8);
  body = leb128.uleb_u32(body, 0u32);

  let out: u8[] = buf;
  out = out.append(section_type());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

pub function put_type_section_one_resource(buf: u8[], rep_valtype: u8): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(63u8);
  body = body.append(rep_valtype);
  body = body.append(0u8);

  let out: u8[] = buf;
  out = out.append(section_type());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

