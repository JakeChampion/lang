}

pub function put_type_section_one_variant(buf: u8[], case_names: string[], case_has_payload: boolean[], case_payload_valtypes: u8[]): u8[] {
  let body: u8[] = [];
  body = leb128.uleb_u32(body, 1u32);
  body = body.append(113u8);
  let n: i32 = case_names.len();
  body = leb128.uleb_u32(body, n as u32);
  let i: i32 = 0;
  while (i < n) {
    body = encode.put_name(body, case_names[i]);
    if (case_has_payload[i]) {
      body = body.append(1u8);
      body = body.append(case_payload_valtypes[i]);
    } else {
      body = body.append(0u8);
    }
    body = body.append(0u8);
    i = i + 1;
  }

  let out: u8[] = buf;
  out = out.append(section_type());
  out = leb128.uleb_u32(out, body.len() as u32);
  return encode.put_bytes(out, body);
}

