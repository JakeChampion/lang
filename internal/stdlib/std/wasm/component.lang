// std/wasm/component — WebAssembly Component Model binary
// encoder primitives.
//
// Spec: https://github.com/WebAssembly/component-model/blob/main/design/mvp/Binary.md
//
// First slice of Phase 2 of docs/TOOLCHAIN-SELF-HOSTING.md. The
// std/wasm/* modules so far cover the Core 1.0 binary format —
// every byte the production compiler used to feed `wasm-tools
// parse`. Phase 2 is the layer above: wrapping a core module in
// the Component Model envelope so it can run under preview-2
// hosts (the production driver's current need, fulfilled today
// by `wasm-tools component embed` + `wasm-tools component new`).
//
// This slice only covers the preamble + the core-module section
// — the two pieces every component starts with. Type / import /
// export / instance / canon / alias sections come later as the
// production world (lang.wit, http.wit) shapes need them.
//
// Layout of the bytes inspected here:
//
//   Component preamble (8 bytes):
//     00 61 73 6d   magic ("\0asm")
//     0d 00         version 0x000d (component-model preview)
//     01 00         layer 0x0001  (component, vs 0x0000 for core)
//
//   Core-module section:
//     01            section id 1 = core-module
//     <uleb size>   length of the embedded core module
//     <bytes...>    a complete core wasm module (preamble + sections)

import "std/wasm/leb128";
import "std/wasm/encode";

// Component section IDs from the Binary.md spec table. The
// earlier version of this file (when only section_core_module was
// exercised) had the rest of the IDs off by one — they were copied
// from an older draft of the spec that had a separate `core-alias`
// section and an explicit `component-type` section. The current
// MVP binary format folded core-alias into the unified `alias`
// section (id 6) and the `component-type` payload lives in a
// custom section, not a top-level section. The constants below
// were verified against `wasm-tools parse` output for a handful of
// shapes (`(core module …)`, `(core instance …)`, `(alias …)`).
//
// One section ID is not present: section 4 = `component`, the
// recursive case where one component embeds another. The
// production driver doesn't need it; left out until something does.
pub function section_core_module(): u8   { return 1u8; }
pub function section_core_instance(): u8 { return 2u8; }
pub function section_core_type(): u8     { return 3u8; }
pub function section_instance(): u8      { return 5u8; }
pub function section_alias(): u8         { return 6u8; }
pub function section_type(): u8          { return 7u8; }
pub function section_canon(): u8         { return 8u8; }
pub function section_start(): u8         { return 9u8; }
pub function section_import(): u8        { return 10u8; }
pub function section_export(): u8        { return 11u8; }

// put_component_header — append the Component Model preamble:
// `\0asm` + version 0x000d + layer 0x0001. Always 8 bytes.
// Layer = 0x01 is what distinguishes a component from a core
// module (which uses layer 0x00 — i.e. its version field is
// 0x01000000 and there's no layer field).
pub function put_component_header(buf: u8[]): u8[] {
    var out: u8[] = buf;
    out = out.push(0u8);
    out = out.push(97u8);    // 'a'
    out = out.push(115u8);   // 's'
    out = out.push(109u8);   // 'm'
    out = out.push(13u8);    // version low byte (0x0d)
    out = out.push(0u8);     // version high byte
    out = out.push(1u8);     // layer low byte (0x01 — component)
    out = out.push(0u8);     // layer high byte
    return out;
}

// put_core_module_section — append a complete core wasm module
// as a core-module section: `id : u8 + size : uleb + body`.
// `core_bytes` is the entire core module starting with its own
// preamble (00 61 73 6d 01 00 00 00 ...) as produced by
// std/wasm/module.build.
pub function put_core_module_section(buf: u8[], core_bytes: u8[]): u8[] {
    var out: u8[] = buf;
    out = out.push(section_core_module());
    out = leb128.uleb_u32(out, core_bytes.len() as u32);
    return encode.put_bytes(out, core_bytes);
}

// put_core_instance_section_instantiate — emit a core-instance
// section that contains a single "instantiate" entry: instantiate
// a core module by index, with no `instantiation-arg`s. This is
// the minimum shape needed by a self-contained core module (one
// with no imports, e.g. the lang CLI core after every WASI import
// is satisfied by canonical-ABI host imports at the component
// level).
//
// Spec (Binary.md, `core:instance` production):
//   core-instance ::= 0x00 m:module-idx args:vec(core-instantiation-arg)
//                   | 0x01 e:vec(core-instance-export)
//
// We emit the first form with `args = []`. Encoded body for one
// instance with module_idx=0:
//
//   01           // vec length = 1 instance
//   00           // tag = 0 (instantiate)
//   00           // module_idx (uleb) = 0
//   00           // args vec length = 0
//
// Section header wrapped on top: `id=2 + uleb size + body`.
pub function put_core_instance_section_instantiate(buf: u8[], module_idx: u32): u8[] {
    var body: u8[] = [];
    body = leb128.uleb_u32(body, 1u32);          // one instance entry
    body = body.push(0u8);                       // tag: instantiate
    body = leb128.uleb_u32(body, module_idx);    // which core module
    body = leb128.uleb_u32(body, 0u32);          // no args

    var out: u8[] = buf;
    out = out.push(section_core_instance());
    out = leb128.uleb_u32(out, body.len() as u32);
    return encode.put_bytes(out, body);
}

// Component primitive valtype bytes. Distinct numbering from the
// core wasm valtypes (which live in std/wasm/encode); core i32 is
// 0x7f whereas component bool is also 0x7f. Each space is parsed
// independently — the same byte means different things inside a
// core type section vs a component type section.
//
// The numbering counts down from 0x7f. Bytes confirmed against
// `wasm-tools parse` output for `(component (type (func (result X))))`
// across every variant below.
pub function cvaltype_bool(): u8   { return 127u8; }   // 0x7f
pub function cvaltype_s8(): u8     { return 126u8; }   // 0x7e
pub function cvaltype_u8(): u8     { return 125u8; }   // 0x7d
pub function cvaltype_s16(): u8    { return 124u8; }   // 0x7c
pub function cvaltype_u16(): u8    { return 123u8; }   // 0x7b
pub function cvaltype_s32(): u8    { return 122u8; }   // 0x7a
pub function cvaltype_u32(): u8    { return 121u8; }   // 0x79
pub function cvaltype_s64(): u8    { return 120u8; }   // 0x78
pub function cvaltype_u64(): u8    { return 119u8; }   // 0x77
pub function cvaltype_f32(): u8    { return 118u8; }   // 0x76
pub function cvaltype_f64(): u8    { return 117u8; }   // 0x75
pub function cvaltype_char(): u8   { return 116u8; }   // 0x74
pub function cvaltype_string(): u8 { return 115u8; }   // 0x73

// put_type_section_one_func — emit a component-level type section
// that defines a single functype with the given parameter list and
// one anonymous result. Each parameter has a name + a valtype byte;
// the two parallel arrays must have equal length.
//
// Spec (Binary.md):
//   functype   ::= 0x40 ps:vec(<paramname valtype>) rs:resultlist
//   paramname  ::= <name>                              -- uleb-prefixed UTF-8
//   resultlist ::= 0x00 t:<valtype>                    -- single anonymous
//                | 0x01 lts:vec(<labelvaltype>)        -- named results
//
// Encoded body for one functype with N params:
//
//   01                  // vec(1) types
//   40                  // functype form
//   <N:uleb>            // params vec count
//   (<name> <valtype>)* // N pairs, each: uleb-prefixed name + valtype byte
//   00                  // resultlist tag = single anonymous
//   <result_valtype>    // result valtype byte
//
// Section header: `id=7 + uleb size + body`.
pub function put_type_section_one_func(buf: u8[], param_names: string[], param_valtypes: u8[], result_valtype: u8): u8[] {
    var body: u8[] = [];
    body = leb128.uleb_u32(body, 1u32);          // vec(1) of types
    body = body.push(64u8);                       // functype form (0x40)
    var n: i32 = param_names.len();
    body = leb128.uleb_u32(body, n as u32);      // params vec count
    var i: i32 = 0;
    while (i < n) {
        body = encode.put_name(body, param_names[i]);
        body = body.push(param_valtypes[i]);
        i = i + 1;
    }
    body = body.push(0u8);                        // resultlist tag: single anon
    body = body.push(result_valtype);             // result valtype byte

    var out: u8[] = buf;
    out = out.push(section_type());
    out = leb128.uleb_u32(out, body.len() as u32);
    return encode.put_bytes(out, body);
}

// put_type_section_one_func_no_param — thin convenience wrapper
// over `put_type_section_one_func` for the zero-parameter case.
// Retained as a named entry point because earlier slices already
// call it from the e2e tests; new code with params should reach for
// `put_type_section_one_func` directly.
pub function put_type_section_one_func_no_param(buf: u8[], result_valtype: u8): u8[] {
    var no_names: string[] = [];
    var no_valtypes: u8[] = [];
    return put_type_section_one_func(buf, no_names, no_valtypes, result_valtype);
}

// put_alias_section_core_export_func — emit an alias section
// containing one entry that surfaces a core function export of a
// core instance as a top-level core-sort func. After this alias
// runs, the alias-defined core function can be referenced by a
// later canon-lift to turn it into a component-level function.
//
// Spec (Binary.md, `alias` production):
//   alias ::= s:sort t:aliastarget
//   sort  ::= 0x00 cs:core-sort     -- core sort, with sub-kind
//           | 0x01 -- func          | 0x02 -- value
//           | 0x03 -- type          | 0x04 -- component
//           | 0x05 -- instance
//   core-sort   ::= 0x00 -- func    | 0x01 -- table
//                 | 0x02 -- memory  | 0x03 -- global
//                 | 0x10 -- type    | 0x11 -- module
//                 | 0x12 -- instance
//   aliastarget ::= 0x00 i:instance-idx       n:name  -- from instance export
//                 | 0x01 i:core-instance-idx  n:name  -- from core instance export
//                 | 0x02 ct:u32 idx:u32               -- outer-component
//
// Encoded body for "alias core export `core_instance_idx` `name` as
// a core func":
//
//   01           // vec(1) alias entries
//   00 00        // sort = core (0x00) + core-sort = func (0x00)
//   01           // aliastarget = core-instance-export
//   <idx:uleb>   // core-instance-idx
//   <name>       // uleb-prefixed UTF-8
pub function put_alias_section_core_export_func(buf: u8[], core_instance_idx: u32, name: string): u8[] {
    var body: u8[] = [];
    body = leb128.uleb_u32(body, 1u32);          // vec(1)
    body = body.push(0u8);                       // sort: core
    body = body.push(0u8);                       // core-sort: func
    body = body.push(1u8);                       // target: from core-instance-export
    body = leb128.uleb_u32(body, core_instance_idx);
    body = encode.put_name(body, name);

    var out: u8[] = buf;
    out = out.push(section_alias());
    out = leb128.uleb_u32(out, body.len() as u32);
    return encode.put_bytes(out, body);
}

// put_canon_section_lift_no_opts — emit a canon section containing
// a single `canon lift` entry that turns a core function (already
// referenceable via an alias or import) into a component-level
// function with the given type signature. `opts` is left empty —
// no `memory`, `realloc`, `post-return`, or non-default string
// encoding. That's sufficient for callee functions whose signature
// only mentions scalar valtypes (no strings, no lists, no
// resources).
//
// Spec (Binary.md):
//   canon ::= 0x00 0x00 f:<core-func-idx> opts:vec(<canonopt>) ft:<typeidx>  -- lift
//           | 0x01 0x00 f:<func-idx>      opts:vec(<canonopt>) ct:<core-typeidx> -- lower
//           | 0x02 rt:<typeidx>           -- resource.new
//           ... etc.
//
// Encoded body for one canon-lift entry:
//
//   01                  // vec(1) canon entries
//   00 00               // discriminator: lift, function-lift sub-tag
//   <core-func-idx:uleb>
//   00                  // opts vec count = 0
//   <typeidx:uleb>
pub function put_canon_section_lift_no_opts(buf: u8[], core_func_idx: u32, typeidx: u32): u8[] {
    var body: u8[] = [];
    body = leb128.uleb_u32(body, 1u32);          // vec(1)
    body = body.push(0u8);                       // canon-lift
    body = body.push(0u8);                       // function-lift sub-tag
    body = leb128.uleb_u32(body, core_func_idx);
    body = leb128.uleb_u32(body, 0u32);          // no opts
    body = leb128.uleb_u32(body, typeidx);

    var out: u8[] = buf;
    out = out.push(section_canon());
    out = leb128.uleb_u32(out, body.len() as u32);
    return encode.put_bytes(out, body);
}

// put_import_section_one_func — emit a component-level import
// section with a single entry that declares an imported function
// at the given name, of the given component-level functype.
//
// Spec (Binary.md):
//   import     ::= n:<importname> ed:<externdesc>
//   importname ::= 0x00 <name>   -- "label" form: plain UTF-8 name
//                | 0x01 <name>   -- "interface name" (a:b/c@x.y.z form)
//   externdesc ::= 0x00 0x11 i:<u32>  -- core-module type
//                | 0x01 i:<u32>       -- func type
//                | 0x02 b:<typebound>  -- type
//                | 0x03 i:<u32>       -- component type
//                | 0x04 i:<u32>       -- instance type
//                | 0x05 i:<u32>       -- value type
//
// Encoded body for "import label `name` as a func of type `typeidx`":
//
//   01           // vec(1) imports
//   00 <name>    // importname kind=0 (label) + uleb-prefixed UTF-8
//   01           // externdesc kind = func type
//   <typeidx>    // uleb
//
// The label form (kind 0x00) is the right choice for plain function
// imports. WASI-style interface imports — e.g.
// `wasi:cli/exit@0.2.0` — use the kind-0x01 "interface name" form
// and externdesc kind 0x04 (instance type); those land in a later
// slice once instance-type section support exists.
pub function put_import_section_one_func(buf: u8[], name: string, typeidx: u32): u8[] {
    var body: u8[] = [];
    body = leb128.uleb_u32(body, 1u32);          // vec(1)
    body = body.push(0u8);                       // importname kind = label
    body = encode.put_name(body, name);
    body = body.push(1u8);                       // externdesc: func type
    body = leb128.uleb_u32(body, typeidx);

    var out: u8[] = buf;
    out = out.push(section_import());
    out = leb128.uleb_u32(out, body.len() as u32);
    return encode.put_bytes(out, body);
}

// put_export_section_one_func — emit a component-level export
// section with a single entry that exposes a component-level
// function (created by canon-lift) under the given name.
//
// Spec (Binary.md):
//   export     ::= n:<exportname> si:<sortidx> [t:<externdesc>]?
//   exportname ::= 0x00 <name>   -- "label" form: plain UTF-8 name
//                | 0x01 <name>   -- "deprecated label"
//                | ...           -- interface name, etc.
//   sortidx    ::= s:<sort> i:<u32>
//
// Encoded body for one func export named `name` at component-func
// index `func_idx`:
//
//   01                  // vec(1) exports
//   00 <name>           // exportname kind=0 (label) + uleb-prefixed UTF-8
//   01                  // sort = func (0x01)
//   <func_idx:uleb>
//   00                  // no externdesc tag
pub function put_export_section_one_func(buf: u8[], name: string, func_idx: u32): u8[] {
    var body: u8[] = [];
    body = leb128.uleb_u32(body, 1u32);          // vec(1)
    body = body.push(0u8);                       // exportname kind = label
    body = encode.put_name(body, name);
    body = body.push(1u8);                       // sort: func
    body = leb128.uleb_u32(body, func_idx);
    body = body.push(0u8);                       // no externdesc

    var out: u8[] = buf;
    out = out.push(section_export());
    out = leb128.uleb_u32(out, body.len() as u32);
    return encode.put_bytes(out, body);
}
