pub function inst_f32_neg(buf: u8[]): u8[]      { return buf.push(140u8); }  // 0x8C
pub function inst_f32_ceil(buf: u8[]): u8[]     { return buf.push(141u8); }  // 0x8D
pub function inst_f32_floor(buf: u8[]): u8[]    { return buf.push(142u8); }  // 0x8E
pub function inst_f32_trunc(buf: u8[]): u8[]    { return buf.push(143u8); }  // 0x8F
pub function inst_f32_nearest(buf: u8[]): u8[]  { return buf.push(144u8); }  // 0x90
pub function inst_f32_sqrt(buf: u8[]): u8[]     { return buf.push(145u8); }  // 0x91
pub function inst_f32_add(buf: u8[]): u8[]      { return buf.push(146u8); }  // 0x92
pub function inst_f32_sub(buf: u8[]): u8[]      { return buf.push(147u8); }  // 0x93
pub function inst_f32_mul(buf: u8[]): u8[]      { return buf.push(148u8); }  // 0x94
pub function inst_f32_div(buf: u8[]): u8[]      { return buf.push(149u8); }  // 0x95
pub function inst_f32_min(buf: u8[]): u8[]      { return buf.push(150u8); }  // 0x96
pub function inst_f32_max(buf: u8[]): u8[]      { return buf.push(151u8); }  // 0x97
pub function inst_f32_copysign(buf: u8[]): u8[] { return buf.push(152u8); }  // 0x98

