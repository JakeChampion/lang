pub function inst_f32_sqrt(buf: u8[]): u8[]     { return buf.append(145u8); }  // 0x91
pub function inst_f32_add(buf: u8[]): u8[]      { return buf.append(146u8); }  // 0x92
pub function inst_f32_sub(buf: u8[]): u8[]      { return buf.append(147u8); }  // 0x93
pub function inst_f32_mul(buf: u8[]): u8[]      { return buf.append(148u8); }  // 0x94
pub function inst_f32_div(buf: u8[]): u8[]      { return buf.append(149u8); }  // 0x95
pub function inst_f32_min(buf: u8[]): u8[]      { return buf.append(150u8); }  // 0x96
pub function inst_f32_max(buf: u8[]): u8[]      { return buf.append(151u8); }  // 0x97
pub function inst_f32_copysign(buf: u8[]): u8[] { return buf.append(152u8); }  // 0x98

