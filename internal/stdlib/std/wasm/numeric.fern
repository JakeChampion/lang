pub function inst_f64_eq(buf: u8[]): u8[] { return buf.push(97u8);  }  // 0x61
pub function inst_f64_ne(buf: u8[]): u8[] { return buf.push(98u8);  }  // 0x62
pub function inst_f64_lt(buf: u8[]): u8[] { return buf.push(99u8);  }  // 0x63
