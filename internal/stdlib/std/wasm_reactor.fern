// std/wasm_reactor — pollable-based readiness scheduler (wasm/WASI).
//
// The wasm twin of std/reactor: it drives generic stackless tasks to
// completion over `wasi:io/poll` pollables, using the `wasm_poll`
// builtin (wasi:io/poll.poll(list<pollable>) -> list<u32>) as the
// readiness multiplexer — instead of raw file descriptors + the native
// `poll(2)` syscall std/reactor uses. A task suspended on a pollable is
// resumed when that pollable becomes ready.
//
// WASM-ONLY: wasm_poll / wasm_block / wasm_timer_pollable are
// Preview-2 pollable builtins emitted only by the wasm backend
// (docs/WASM-REACTOR-PLAN.md). They type-check on every backend (the
// FuncSigs are global) but codegen only on wasm, so this module is the
// wasm counterpart of the native-only std/reactor — import whichever
// matches the target. The portable, simulation-friendly model stays in
// std/task (imported by the `concurrent { … }` desugar), so concurrent
// programs still compile everywhere.
//
// A task is a Step, the stackless-CPS shape from
// docs/ASYNC-IMPLEMENTATION-RESEARCH.md, but with the wait TOKEN being
// a `pollable` handle: Wait(pollable, resume) suspends until `pollable`
// is ready, then `resume(pollable)` produces the next step — typically
// a read followed by Done. Step is generic in its result type T (an
// i32 status / count, or a string body), exactly like std/reactor's
// IoStep[T].
//
// Timer pollables come from `wasm_timer_pollable(duration_ns)`; socket
// / stream pollables (when those land on wasm) plug into the same loop.

// A pollable-tagged task step.
//
//   Done(result)        — finished with this result of type T.
//   Wait(pollable, resume) — suspended until `pollable` is ready; the
//                            runtime calls `resume(pollable)` for the
//                            next step.
pub enum Step[T] {
    Done(T),
    Wait(i32, (i32) => Step[T]),
}

// __wr_all_done(states) — true once no task is still waiting.
function __wr_all_done[T](states: Step[T][]): boolean {
    var i: i32 = 0;
    while (i < states.len()) {
        match (states[i]) {
            Done(v) => { },
            Wait(p, c) => { return false; },
        }
        i = i + 1;
    }
    return true;
}

// run(states, not_ready) — drive a set of already-started
// pollable-tagged tasks to completion on a single thread, multiplexing
// their pollables through `wasm_poll`, and return their results (type
// T) in task order.
//
// Each round: gather the pollables of the still-waiting tasks, block in
// `wasm_poll` until one is ready, resume that task (its continuation
// does the actual read), and repeat until every task is Done. All
// tasks' pollables are in flight simultaneously, so their I/O overlaps
// on one thread — the edge-handler fan-out, over wasi pollables.
//
// A task whose pollable never becomes ready leaves the loop only via
// the wasm_poll error guard (-1), landing `not_ready` in its result
// slot (e.g. -1 for an i32 status, "" for a string body).
pub function run[T](states_in: Step[T][], not_ready: T): T[] {
    var states: Step[T][] = states_in;
    while (true) {
        if (__wr_all_done(states)) { break; }
        // Gather waiting pollables and their task indices (parallel arrays).
        var polls: i32[] = [];
        var idxs: i32[] = [];
        var i: i32 = 0;
        while (i < states.len()) {
            match (states[i]) {
                Done(v) => { },
                Wait(p, c) => {
                    polls = polls.append(p);
                    idxs = idxs.append(i);
                },
            }
            i = i + 1;
        }
        // Block until at least one of the waiting pollables is ready.
        var ready: i32 = wasm_poll(polls);
        if (ready < 0) { break; }
        var ti: i32 = idxs[ready];
        var st: Step[T] = states[ti];
        match (st) {
            Done(v) => { },
            Wait(p, resume) => {
                // Resume past the now-ready pollable, then drop it —
                // the handle has fired and won't be polled again, so
                // free it instead of leaking until component exit.
                states = states.with(ti, resume(p));
                var dropped: i32 = wasm_pollable_drop(p);
            },
        }
    }
    var results: T[] = [];
    var k: i32 = 0;
    while (k < states.len()) {
        match (states[k]) {
            Done(v) => { results = results.append(v); },
            Wait(p, c) => { results = results.append(not_ready); },
        }
        k = k + 1;
    }
    return results;
}

// run_deadline(states, deadline_ns, not_ready) — like run, but the
// whole fan-out must finish within `deadline_ns` nanoseconds. The wasm
// twin of std/reactor.run_io_deadline: a single deadline timer
// pollable is added to every poll round, so when it fires first the
// loop abandons the still-waiting tasks (their result slots take
// `not_ready`) — happy-eyeballs with an upper bound, the edge-handler
// SLA shape. Tasks that complete before the deadline carry their
// result.
//
// The deadline pollable lives at poll-index 0 each round (idx -1 in the
// task map); a ready index of 0 means the deadline fired. It is created
// once and dropped at the end; per-task pollables are dropped as they
// fire (as in run).
pub function run_deadline[T](states_in: Step[T][], deadline_ns: i64, not_ready: T): T[] {
    var states: Step[T][] = states_in;
    var deadline_p: i32 = wasm_timer_pollable(deadline_ns);
    while (true) {
        if (__wr_all_done(states)) { break; }
        // poll-index 0 is the deadline; the rest are waiting tasks.
        var polls: i32[] = [deadline_p];
        var idxs: i32[] = [0 - 1];
        var i: i32 = 0;
        while (i < states.len()) {
            match (states[i]) {
                Done(v) => { },
                Wait(p, c) => {
                    polls = polls.append(p);
                    idxs = idxs.append(i);
                },
            }
            i = i + 1;
        }
        var ready: i32 = wasm_poll(polls);
        if (ready < 0) { break; }
        if (ready == 0) { break; } // deadline fired — abandon stragglers
        var ti: i32 = idxs[ready];
        var st: Step[T] = states[ti];
        match (st) {
            Done(v) => { },
            Wait(p, resume) => {
                states = states.with(ti, resume(p));
                var dropped: i32 = wasm_pollable_drop(p);
            },
        }
    }
    var d2: i32 = wasm_pollable_drop(deadline_p);
    var results: T[] = [];
    var k: i32 = 0;
    while (k < states.len()) {
        match (states[k]) {
            Done(v) => { results = results.append(v); },
            Wait(p, c) => { results = results.append(not_ready); },
        }
        k = k + 1;
    }
    return results;
}

// __wr_drop_waiting(states, except) — drop the pollable of every
// still-waiting task except the one at `except` (whose pollable the
// caller already dropped). Used by select to cancel the losers. Returns
// the number dropped.
function __wr_drop_waiting[T](states: Step[T][], except: i32): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < states.len()) {
        if (i != except) {
            match (states[i]) {
                Done(v) => { },
                Wait(p, c) => {
                    var d: i32 = wasm_pollable_drop(p);
                    n = n + 1;
                },
            }
        }
        i = i + 1;
    }
    return n;
}

// select(states, none_val) — drive the tasks until the FIRST one
// completes, then return its value and cancel the rest (dropping their
// pollables). The first-wins counterpart to `run` (which waits for ALL)
// — the structured-concurrency `select` / `race` shape: fan out to N
// upstreams, take the fastest answer, abandon the others. Returns
// `none_val` if no task can make progress (poll error / no waiters).
pub function select[T](states_in: Step[T][], none_val: T): T {
    var states: Step[T][] = states_in;
    // An already-Done task wins immediately.
    var j: i32 = 0;
    while (j < states.len()) {
        match (states[j]) {
            Done(v) => { return v; },
            Wait(p, c) => { },
        }
        j = j + 1;
    }
    while (true) {
        var polls: i32[] = [];
        var idxs: i32[] = [];
        var i: i32 = 0;
        while (i < states.len()) {
            match (states[i]) {
                Done(v) => { },
                Wait(p, c) => {
                    polls = polls.append(p);
                    idxs = idxs.append(i);
                },
            }
            i = i + 1;
        }
        if (polls.len() == 0) { return none_val; }
        var ready: i32 = wasm_poll(polls);
        if (ready < 0) { return none_val; }
        var ti: i32 = idxs[ready];
        var st: Step[T] = states[ti];
        match (st) {
            Done(v) => { return v; },
            Wait(p, resume) => {
                var nx: Step[T] = resume(p);
                var dropped: i32 = wasm_pollable_drop(p);
                match (nx) {
                    Done(v) => {
                        // First to finish — cancel the other waiters.
                        var c: i32 = __wr_drop_waiting(states, ti);
                        return v;
                    },
                    Wait(np, nc) => {
                        states = states.with(ti, nx);
                    },
                }
            },
        }
    }
    return none_val;
}

// sleep_pollable(duration_ns) — a Wait step that fires after the given
// duration. Sugar over wasm_timer_pollable for building timer tasks:
//   wasm_reactor.run([wasm_reactor.sleep_pollable(ms, (p) => Done(1))], -1)
pub function sleep_pollable[T](duration_ns: i64, resume: (i32) => Step[T]): Step[T] {
    return Wait(wasm_timer_pollable(duration_ns), resume);
}
