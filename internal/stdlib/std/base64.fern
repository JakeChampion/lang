// This module encodes and decodes Base64 data under RFC 4648.

function __b64_alphabet(v: i32): i32 {
  if (v < 26) {
    return v + 65;
  }
  if (v < 52) {
    return v + 71;
  }
  if (v < 62) {
    return v - 4;
  }
  if (v == 62) {
    return 43;
  }
  return 47;
}

function __b64_decode_char(c: i32): i32 {
  if (c >= 65 && c < 91) {
    return c - 65;
  }
  if (c >= 97 && c < 123) {
    return c - 71;
  }
  if (c >= 48 && c < 58) {
    return c + 4;
  }
  if (c == 43) {
    return 62;
  }
  if (c == 47) {
    return 63;
  }
  return 0 - 1;
}

pub function base64_encode(bs: u8[]): string {
  let n: i32 = bs.len();
  if (n == 0) {
    return "";
  }
  let out_len: i32 = (n + 2) / 3 * 4;
  let buf: u8[] = __alloc_u8(out_len);
  let i: i32 = 0;
  let j: i32 = 0;
  let b0: i32 = 0;
  let b1: i32 = 0;
  let b2: i32 = 0;
  while (i + 3 <= n) {
    b0 = bs[i] as i32;
    b1 = bs[i + 1] as i32;
    b2 = bs[i + 2] as i32;
    buf = buf.with(j, __b64_alphabet(b0 >> 2) as u8);
    buf = buf.with(j + 1, __b64_alphabet((b0 & 3) << 4 | b1 >> 4) as u8);
    buf = buf.with(j + 2, __b64_alphabet((b1 & 15) << 2 | b2 >> 6) as u8);
    buf = buf.with(j + 3, __b64_alphabet(b2 & 63) as u8);
    i = i + 3;
    j = j + 4;
  }
  let rem: i32 = n - i;
  if (rem == 1) {
    b0 = bs[i] as i32;
    buf = buf.with(j, __b64_alphabet(b0 >> 2) as u8);
    buf = buf.with(j + 1, __b64_alphabet((b0 & 3) << 4) as u8);
    buf = buf.with(j + 2, 61 as u8);
    buf = buf.with(j + 3, 61 as u8);
  } else if (rem == 2) {
    b0 = bs[i] as i32;
    b1 = bs[i + 1] as i32;
    buf = buf.with(j, __b64_alphabet(b0 >> 2) as u8);
    buf = buf.with(j + 1, __b64_alphabet((b0 & 3) << 4 | b1 >> 4) as u8);
    buf = buf.with(j + 2, __b64_alphabet((b1 & 15) << 2) as u8);
    buf = buf.with(j + 3, 61 as u8);
  }
  return string_from_bytes_unchecked(buf);
}

pub function base64_decode(s: string): u8[] {
  let sLen: i32 = s.len();
  let n: i32 = 0;
  while (n < sLen) {
    if (__b64_decode_char(s[n] as i32) < 0) {
      break;
    }
    n = n + 1;
  }
  if (n == 0) {
    return [];
  }
  let out_len: i32 = n * 3 / 4;
  if (out_len == 0) {
    return [];
  }
  let buf: u8[] = __alloc_u8(out_len);
  let i: i32 = 0;
  let j: i32 = 0;
  let acc: i32 = 0;
  let bits: i32 = 0;
  while (i < n) {
    acc = acc << 6 | __b64_decode_char(s[i] as i32);
    bits = bits + 6;
    if (bits >= 8) {
      bits = bits - 8;
      buf = buf.with(j, (acc >> bits & 255) as u8);
      j = j + 1;
    }
    i = i + 1;
  }
  return buf;
}

pub function base64_decode_strict(s: string): Option[u8[]] {
  let sLen: i32 = s.len();
  let n: i32 = 0;
  while (n < sLen) {
    if (__b64_decode_char(s[n] as i32) < 0) {
      break;
    }
    n = n + 1;
  }
  let p: i32 = n;
  let pad: i32 = 0;
  while (p < sLen) {
    if (s[p] != 61) {
      return None;
    }
    pad = pad + 1;
    p = p + 1;
  }
  if (pad > 2) {
    return None;
  }
  if (n == 0) {
    if (pad > 0) {
      return None;
    }
    return Some([]);
  }
  if (n % 4 == 1) {
    return None;
  }
  if (pad > 0 && (n + pad) % 4 != 0) {
    return None;
  }
  let out_len: i32 = n * 3 / 4;
  if (out_len == 0) {
    return Some([]);
  }
  let buf: u8[] = __alloc_u8(out_len);
  let i: i32 = 0;
  let j: i32 = 0;
  let acc: i32 = 0;
  let bits: i32 = 0;
  while (i < n) {
    acc = acc << 6 | __b64_decode_char(s[i] as i32);
    bits = bits + 6;
    if (bits >= 8) {
      bits = bits - 8;
      buf = buf.with(j, (acc >> bits & 255) as u8);
      j = j + 1;
    }
    i = i + 1;
  }
  return Some(buf);
}

function __b64_std_to_url(s: string): string {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c == 43) {
      out = out.append(45 as u8);
    } else if (c == 47) {
      out = out.append(95 as u8);
    } else if (c == 61) {} else {
      out = out.append(s[i] as u8);
    }
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

function __b64_url_to_std(s: string): string {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c == 45) {
      out = out.append(43 as u8);
    } else if (c == 95) {
      out = out.append(47 as u8);
    } else {
      out = out.append(s[i] as u8);
    }
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

pub function base64url_encode(bs: u8[]): string {
  return __b64_std_to_url(base64_encode(bs));
}

pub function base64url_decode(s: string): u8[] {
  return base64_decode(__b64_url_to_std(s));
}

pub function base64url_decode_strict(s: string): Option[u8[]] {
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == 43 || s[i] == 47) {
      return None;
    }
    i = i + 1;
  }
  return base64_decode_strict(__b64_url_to_std(s));
}
