// std/base64 — RFC 4648 (standard alphabet) base64 encode /
// decode.
//
// `base64_encode(b)` / `base64_decode(s)` — round-trip
// content-preserving on raw bytes. Encode emits `=` padding
// to align to a 4-character group. Decode terminates at the
// first non-base64 character (so trailing `=` padding works
// without special handling), preserving the bytes
// successfully decoded up to that point.
//
// Bytes are `u8[]` on both sides (#5730, decision D9): arbitrary input
// decodes to arbitrary bytes, which are not UTF-8 and so must not be
// typed as a `string`, and encoding is the inverse — its job is
// rendering bytes as text. Read a decode result back with
// `std/utf8.from_bytes` when the bytes are supposed to be text; encode
// a string's bytes with `std/string`'s `s.bytes()`.
//
// No prelude: these are in scope only after a program
// declares `import "std/base64";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

function __b64_alphabet(v: i32): i32 {
    if (v < 26)  { return v + 65; }     // A-Z (0..25 → 65..90)
    if (v < 52)  { return v + 71; }     // a-z (26..51 → 97..122)
    if (v < 62)  { return v - 4; }      // 0-9 (52..61 → 48..57)
    if (v == 62) { return 43; }         // '+'
    return 47;                          // '/'
}

function __b64_decode_char(c: i32): i32 {
    if (c >= 65 && c < 91)  { return c - 65; }     // A-Z
    if (c >= 97 && c < 123) { return c - 71; }     // a-z
    if (c >= 48 && c < 58)  { return c + 4; }      // 0-9 (48..57 → 52..61)
    if (c == 43) { return 62; }                    // '+'
    if (c == 47) { return 63; }                    // '/'
    return 0 - 1;
}

pub function base64_encode(bs: u8[]): string {
    var n: i32 = bs.len();
    if (n == 0) { return ""; }
    var out_len: i32 = ((n + 2) / 3) * 4;
    var buf: u8[] = __alloc_u8(out_len);
    var i: i32 = 0;
    var j: i32 = 0;
    // Single shared `b0` / `b1` / `b2` declarations so the
    // wasm emitter (which names locals by lang identifier)
    // doesn't trip on duplicate declarations across the
    // sibling 3-byte / 1-byte / 2-byte branches.
    var b0: i32 = 0;
    var b1: i32 = 0;
    var b2: i32 = 0;
    while (i + 3 <= n) {
        b0 = bs[i] as i32;
        b1 = bs[i + 1] as i32;
        b2 = bs[i + 2] as i32;
        buf = buf.with(j, __b64_alphabet(b0 >> 2) as u8);
        buf = buf.with(j + 1, __b64_alphabet(((b0 & 3) << 4) | (b1 >> 4)) as u8);
        buf = buf.with(j + 2, __b64_alphabet(((b1 & 15) << 2) | (b2 >> 6)) as u8);
        buf = buf.with(j + 3, __b64_alphabet(b2 & 63) as u8);
        i = i + 3;
        j = j + 4;
    }
    var rem: i32 = n - i;
    if (rem == 1) {
        b0 = bs[i] as i32;
        buf = buf.with(j, __b64_alphabet(b0 >> 2) as u8);
        buf = buf.with(j + 1, __b64_alphabet((b0 & 3) << 4) as u8);
        buf = buf.with(j + 2, 61 as u8);                      // '='
        buf = buf.with(j + 3, 61 as u8);
    } else if (rem == 2) {
        b0 = bs[i] as i32;
        b1 = bs[i + 1] as i32;
        buf = buf.with(j, __b64_alphabet(b0 >> 2) as u8);
        buf = buf.with(j + 1, __b64_alphabet(((b0 & 3) << 4) | (b1 >> 4)) as u8);
        buf = buf.with(j + 2, __b64_alphabet((b1 & 15) << 2) as u8);
        buf = buf.with(j + 3, 61 as u8);
    }
    return string_from_bytes_unchecked(buf);
}

pub function base64_decode(s: string): u8[] {
    var sLen: i32 = s.len();
    // Walk forward to count consecutive valid base64 chars;
    // first non-base64 (eg `=` padding) terminates the input.
    var n: i32 = 0;
    while (n < sLen) {
        if (__b64_decode_char((s[n] as i32)) < 0) { break; }
        n = n + 1;
    }
    if (n == 0) { return []; }
    var out_len: i32 = (n * 3) / 4;
    if (out_len == 0) { return []; }
    var buf: u8[] = __alloc_u8(out_len);
    var i: i32 = 0;
    var j: i32 = 0;
    var acc: i32 = 0;       // 6-bit-shift accumulator
    var bits: i32 = 0;      // bits currently held in acc
    while (i < n) {
        acc = (acc << 6) | __b64_decode_char((s[i] as i32));
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            buf = buf.with(j, ((acc >> bits) & 255) as u8);
            j = j + 1;
        }
        i = i + 1;
    }
    return buf;
}

// `base64_decode_strict(s)` — like `base64_decode` but returns `None` on
// malformed input instead of silently truncating at the first bad byte.
// Decoding an attacker-supplied token/signature with the lenient variant
// hides tampering (a flipped byte just shortens the output); the strict
// variant makes malformed input observable (#4384). Rules: the leading run
// of valid base64 chars may be followed ONLY by `=` padding (at most two, and
// nothing after it); a run length of n%4==1 is impossible base64; and any
// padding must align the total to a multiple of 4 (proper RFC 4648). A bare
// `""` decodes to `Some("")`; `"=="` (padding, no data) is `None`.
pub function base64_decode_strict(s: string): Option[u8[]] {
    var sLen: i32 = s.len();
    var n: i32 = 0;
    while (n < sLen) {
        if (__b64_decode_char((s[n] as i32)) < 0) { break; }
        n = n + 1;
    }
    // Everything after the data run must be `=` padding — a non-`=` char
    // (including a valid base64 char after a `=`) means the token is malformed.
    var p: i32 = n;
    var pad: i32 = 0;
    while (p < sLen) {
        if (s[p] != 61) { return None; }   // 61 = '='
        pad = pad + 1;
        p = p + 1;
    }
    if (pad > 2) { return None; }
    if (n == 0) {
        if (pad > 0) { return None; }
        return Some([]);
    }
    if (n % 4 == 1) { return None; }
    if (pad > 0 && (n + pad) % 4 != 0) { return None; }
    var out_len: i32 = (n * 3) / 4;
    if (out_len == 0) { return Some([]); }
    var buf: u8[] = __alloc_u8(out_len);
    var i: i32 = 0;
    var j: i32 = 0;
    var acc: i32 = 0;
    var bits: i32 = 0;
    while (i < n) {
        acc = (acc << 6) | __b64_decode_char((s[i] as i32));
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            buf = buf.with(j, ((acc >> bits) & 255) as u8);
            j = j + 1;
        }
        i = i + 1;
    }
    return Some(buf);
}

// std/base64 url-safe variant (RFC 4648 §5): the same base64 with the
// two alphabet characters `+` `/` replaced by `-` `_` (so the output is
// safe in URLs and filenames), and no `=` padding on encode. This is the
// encoding JWTs and most URL tokens use.
//
// Implemented by reusing the standard core: encode then translate the
// two distinct characters and drop padding; decode by translating back
// and handing off to `base64_decode`, which already tolerates missing
// padding (it decodes the leading run of valid characters). Round-trips
// with `base64url_encode` for any byte content.

function __b64_std_to_url(s: string): string {
    var out: u8[] = [];
    var i: i32 = 0;
    while (i < s.len()) {
        var c: i32 = s[i] as i32;
        if (c == 43) { out = out.append(45 as u8); }        // '+' → '-'
        else if (c == 47) { out = out.append(95 as u8); }   // '/' → '_'
        else if (c == 61) { }                                // drop '=' padding
        else { out = out.append(s[i] as u8); }
        i = i + 1;
    }
    return string_from_bytes_unchecked(out);
}

function __b64_url_to_std(s: string): string {
    var out: u8[] = [];
    var i: i32 = 0;
    while (i < s.len()) {
        var c: i32 = s[i] as i32;
        if (c == 45) { out = out.append(43 as u8); }        // '-' → '+'
        else if (c == 95) { out = out.append(47 as u8); }   // '_' → '/'
        else { out = out.append(s[i] as u8); }
        i = i + 1;
    }
    return string_from_bytes_unchecked(out);
}

// `base64url_encode(b)` — URL-safe base64 of `b`, no `=` padding.
pub function base64url_encode(bs: u8[]): string {
    return __b64_std_to_url(base64_encode(bs));
}

// `base64url_decode(s)` — inverse of `base64url_encode`. Accepts input
// with or without `=` padding (padding is ignored). Lenient like
// `base64_decode`: stops at the first character that is neither a
// url-safe base64 digit nor padding.
pub function base64url_decode(s: string): u8[] {
    return base64_decode(__b64_url_to_std(s));
}

// `base64url_decode_strict(s)` — the strict URL-safe decoder: `None` on
// malformed input instead of truncating, the url-safe counterpart of
// `base64_decode_strict`. This is the one to use on a JWT segment or a
// URL token, where a tampered byte must be observable rather than
// silently dropped (#4384).
//
// Stricter than `base64url_decode` in two ways: it rejects the standard-
// alphabet `+` / `/` (only `-` / `_` are URL-safe), and it applies the
// full `base64_decode_strict` structural rules (valid chars, `=` only at
// the end aligning to a 4-char group, no `n%4==1` run). Padding stays
// optional — canonical base64url is unpadded. `""` decodes to `Some("")`.
pub function base64url_decode_strict(s: string): Option[u8[]] {
    // Reject the non-URL-safe standard-alphabet characters up front:
    // `__b64_url_to_std` leaves `+` / `/` untouched, so base64_decode_strict
    // would otherwise accept them.
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] == 43 || s[i] == 47) { return None; }   // '+' or '/'
        i = i + 1;
    }
    return base64_decode_strict(__b64_url_to_std(s));
}
