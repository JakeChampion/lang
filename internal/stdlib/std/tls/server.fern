// std/tls/server — a TLS 1.3 server: std/tls/handshake's server signing its
// CertificateVerify with the certificate's private key, as a sans-IO
// `Session` any transport can carry, and as a `Connection` over an accepted
// TCP socket.
//
//   let id: identity.Identity = identity.from_pem(chain_pem, key_pem)?;
//   let cfg: server.Config = server.config(id).with_alpn(["http/1.1"]);
//   let c: server.Connection = server.accept(fd, cfg, time.duration_seconds(10 as i64))?;
//   let got: server.Received = c.recv(time.duration_seconds(30 as i64))?;
//   c = got.conn.send("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n".bytes())?;
//
// The identity is std/tls/identity's: a P-256, P-384 or Ed25519 key with
// its chain. The signature scheme offered is the key's, so a client that
// does not accept it gets handshake_failure. The server takes every
// suite, X25519MLKEM768, X25519, secp256r1 and SecP256r1MLKEM768, asking
// for a share by HelloRetryRequest when the client sent none of them, and
// chooses the first of its own protocols the client offers by ALPN.

import "std/crypto";
import "std/crypto/chacha20poly1305";
import "std/i32";
import "std/net";
import "std/tcp";
import "std/time";
import "std/tls/handshake";
import "std/tls/identity";
import "std/tls/keyschedule";
import "std/tls/ktls";
import "std/tls/message";
import "std/tls/record";
import "std/tls/verify";

// Config — the identity to present, the protocols to accept by ALPN in
// preference order, and the session tickets: whether to issue one per
// connection, how long it lives, and the key it is sealed under, which
// every server that is to resume it must share.
pub struct Config { identity: identity.Identity, alpn: string[], tickets: boolean, ticket_lifetime: Duration, ticket_key: u8[], client_roots: Option[verify.Roots] }

// config accepts no application protocol and issues tickets that live two
// hours under a key drawn for this config.
pub function config(id: identity.Identity): Config {
  return Config { identity: id, alpn: [], tickets: true, ticket_lifetime: time.duration_seconds(7200 as i64), ticket_key: random_bytes(32), client_roots: None };
}

pub function (c: Config) with_alpn(protocols: string[]): Config {
  return Config { ...c, alpn: protocols };
}

// with_ticket_key seals tickets under a key derived from the caller's
// bytes, so that servers sharing them resume each other's sessions.
pub function (c: Config) with_ticket_key(key: u8[]): Config {
  return Config { ...c, ticket_key: crypto.sha256_new().update_bytes(key).final_bytes() };
}

pub function (c: Config) with_ticket_lifetime(d: Duration): Config {
  return Config { ...c, ticket_lifetime: d };
}

// without_tickets issues none; a ticket offered is still resumed when it
// opens under the key.
pub function (c: Config) without_tickets(): Config {
  return Config { ...c, tickets: false };
}

// with_client_roots asks every client for a certificate and requires one
// whose chain reaches the roots at the current time, allowed a TLS
// client, with a CertificateVerify under its key; a client sending none
// is refused with certificate_required. A resumed session asks for none:
// the ticket stands for the certificate shown when it was issued.
pub function (c: Config) with_client_roots(roots: verify.Roots): Config {
  return Config { ...c, client_roots: Some(roots) };
}

// TlsError — why a connection failed: the handshake's own refusal, the
// key failing to sign, the socket's error, the handshake outlasting its
// bound, the peer closing before the handshake ended, or closing inside a
// record.
pub enum TlsError {
  HandshakeFailed(handshake.HandshakeError),
  SigningFailed,
  // A client certificate is required and the client sent none.
  ClientCertificateMissing,
  ClientUntrusted(verify.VerifyError),
  ClientSignatureInvalid,
  ClientSchemeMismatch,
  NetFailed(net.NetError),
  HandshakeTimeout,
  ClosedEarly,
  RecordCut,
  // The kernel's TLS record layer refused a KeyUpdate's keys, with the
  // errno: Linux before 6.14 takes one key per direction.
  KeysRefused(i32),
}

// One arm per variant.
// fern-lint: allow cyclomatic-complexity
pub function (e: TlsError) message(): string {
  match (e) {
    HandshakeFailed(h) => {
      return h.message();
    },
    SigningFailed => {
      return "the key could not sign the CertificateVerify";
    },
    ClientCertificateMissing => {
      return "the client sent no certificate";
    },
    ClientUntrusted(v) => {
      return "the client's certificate is not trusted: " + v.message();
    },
    ClientSignatureInvalid => {
      return "the client's CertificateVerify does not verify";
    },
    ClientSchemeMismatch => {
      return "the client's CertificateVerify names a scheme its key cannot make";
    },
    NetFailed(n) => {
      return n.message();
    },
    HandshakeTimeout => {
      return "the handshake did not finish in time";
    },
    ClosedEarly => {
      return "the peer closed the connection during the handshake";
    },
    RecordCut => {
      return "the peer closed the connection inside a record";
    },
    KeysRefused(errno) => {
      return "the kernel's TLS record layer refused new keys (errno " + errno.to_string() + "); Linux before 6.14 takes one key per direction";
    }
  }
  return "";
}

// Session — one connection's TLS, bytes in and bytes out: the handshake's
// server, the config it signs and seals tickets with, and the bytes of a
// record still arriving.
pub struct Session { server: handshake.Server, config: Config, held: u8[] }

// Failure — why `read` failed, and the alert record to send the client
// before closing, sealed under the keys in force when it failed.
pub struct Failure { error: TlsError, alert: u8[] }

pub function (f: Failure) message(): string {
  return f.error.message();
}

// Step — the session after a call, the bytes to send, the application data
// read, whether the peer has sent close_notify, and, once offloaded, the
// keys a KeyUpdate gave the kernel to take next.
pub struct Step { session: Session, output: u8[], data: u8[], closed: boolean, rekeyed: handshake.KernelKeys }

// start waits for a ClientHello: there is nothing to send until `read` has
// taken one.
pub function start(config: Config): Result[Session, TlsError] {
  let asks: boolean = false;
  match (config.client_roots) {
    Some(_) => {
      asks = true;
    },
    None => {}
  }
  let sc: handshake.ServerConfig = handshake.ServerConfig { ...handshake.server_config(config.identity.chain, [config.identity.key.scheme()]), alpn: config.alpn, request_client_certificate: asks };
  match (handshake.server_new(sc, random_bytes(handshake.server_entropy(sc)))) {
    Ok(s) => {
      return Ok(Session { server: s, config: config, held: [] });
    },
    Err(e) => {
      return Err(HandshakeFailed(e));
    }
  }
  return Err(ClosedEarly);
}

// read takes bytes from the client, signing the CertificateVerify when the
// handshake reaches it. Whole records go to the handshake one at a time:
// the keys change only between records, so a failure's alert is sealed
// under the keys the records before it left.
pub function (s: Session) read(input: [u8]): Result[Step, Failure] {
  let buf: u8[] = __copy(s.held);
  buf = __cat(buf, input);
  let session: Session = Session { ...s, held: [] };
  let output: u8[] = [];
  let data: u8[] = [];
  let closed: boolean = false;
  let keys: handshake.KernelKeys = __no_keys();
  let at: i32 = 0;
  while (!closed && buf.len() - at >= 5) {
    let end: i32 = at + 5 + (buf[at + 3] as i32 << 8 | buf[at + 4] as i32);
    if (end > buf.len()) {
      break;
    }
    let next: Step = __record(session, buf[at:end])?;
    session = next.session;
    output = __cat(output, next.output);
    data = __cat(data, next.data);
    closed = next.closed;
    keys = keys.then(next.rekeyed);
    at = end;
  }
  return Ok(Step { session: Session { ...session, held: __copy(buf[at:buf.len()]) }, output: output, data: data, closed: closed, rekeyed: keys });
}

function __record(s: Session, record: [u8]): Result[Step, Failure] {
  match (s.server.read(record)) {
    Ok(step) => {
      return __signed(s, step);
    },
    Err(e) => {
      return Err(Failure { error: HandshakeFailed(e), alert: s.server.alert(e) });
    }
  }
  return Err(Failure { error: ClosedEarly, alert: [] });
}

// write seals application data; the session must be connected.
pub function (s: Session) write(data: [u8]): Result[Step, TlsError] {
  let step: handshake.ServerStep = __step(s.server.write(data))?;
  return Ok(Step { session: Session { ...s, server: step.server }, output: step.output, data: [], closed: false, rekeyed: __no_keys() });
}

// close is the close_notify to send; nothing more may be written.
pub function (s: Session) close(): Result[Step, TlsError] {
  let step: handshake.ServerStep = __step(s.server.close())?;
  return Ok(Step { session: Session { ...s, server: step.server }, output: step.output, data: [], closed: false, rekeyed: __no_keys() });
}

// update_keys sends a KeyUpdate and moves to the next write key; `request`
// asks the client to move to its next one too.
pub function (s: Session) update_keys(request: boolean): Result[Step, TlsError] {
  let step: handshake.ServerStep = __step(s.server.update_keys(request))?;
  return Ok(Step { session: Session { ...s, server: step.server }, output: step.output, data: [], closed: false, rekeyed: handshake.rekeyed(step.server.cipher_suite(), step.events) });
}

// Offloaded — a session whose records the kernel now seals and opens
// (std/tls/ktls), and the keys to give it.
pub struct Offloaded { session: Session, keys: handshake.KernelKeys }

// offload hands the record layer to the kernel, or None while the session
// is not connected or holds bytes of a record still arriving. Afterwards
// `write`, `close` and a failure's alert are plaintext records for the
// kernel to seal, `read` takes the records the kernel opened, framed as
// they arrived, and a KeyUpdate either way is in a step's `rekeyed`.
pub function (s: Session) offload(): Option[Offloaded] {
  if (s.held.len() != 0) {
    return None;
  }
  match (s.server.offload()) {
    Some(o) => {
      return Some(Offloaded { session: Session { ...s, server: o.server }, keys: o.keys });
    },
    None => {}
  }
  return None;
}

pub function (s: Session) connected(): boolean {
  return s.server.connected();
}

// Whether the kernel seals and opens the session's records (`offload`).
pub function (s: Session) offloaded(): boolean {
  return s.server.offloaded();
}

// The protocol chosen by ALPN, empty when none was.
pub function (s: Session) alpn(): string {
  return s.server.alpn;
}

// The name the client asked for by SNI, empty when it sent none.
pub function (s: Session) server_name(): string {
  return s.server.server_name;
}

// Whether the handshake resumed from a ticket, in which case no
// certificate was sent.
pub function (s: Session) resumed(): boolean {
  return s.server.resumed();
}

// The chain the client presented, leaf first, judged against the config's
// client roots; empty when the session resumed or no roots were set.
pub function (s: Session) client_chain(): u8[][] {
  return s.server.client_chain();
}

function __step(r: Result[handshake.ServerStep, handshake.HandshakeError]): Result[handshake.ServerStep, TlsError] {
  match (r) {
    Ok(step) => {
      return Ok(step);
    },
    Err(e) => {
      return Err(HandshakeFailed(e));
    }
  }
  return Err(ClosedEarly);
}

function __failed(srv: handshake.Server, r: Result[handshake.ServerStep, handshake.HandshakeError]): Result[handshake.ServerStep, Failure] {
  match (r) {
    Ok(step) => {
      return Ok(step);
    },
    Err(e) => {
      return Err(Failure { error: HandshakeFailed(e), alert: srv.alert(e) });
    }
  }
  return Err(Failure { error: ClosedEarly, alert: [] });
}

// __signed answers each event in a step that asks something of the server
// (a signature, a ticket lookup, a ticket to issue once connected) and
// gathers what the handshake goes on to produce.
function __signed(s: Session, first: handshake.ServerStep): Result[Step, Failure] {
  let srv: handshake.Server = first.server;
  let output: u8[] = first.output;
  let data: u8[] = first.data;
  let events: handshake.Event[] = first.events;
  let closed: boolean = false;
  let i: i32 = 0;
  while (i < events.len()) {
    let next: handshake.ServerStep = __answered(s, srv, events[i])?;
    closed = closed || __peer_closed(events[i]);
    srv = next.server;
    output = __cat(output, next.output);
    data = __cat(data, next.data);
    events = __more(events, next.events);
    i = i + 1;
  }
  return Ok(Step { session: Session { ...s, server: srv }, output: output, data: data, closed: closed, rekeyed: handshake.rekeyed(srv.cipher_suite(), events) });
}

function __no_keys(): handshake.KernelKeys {
  return handshake.KernelKeys { transmit: [], receive: [] };
}

function __peer_closed(e: handshake.Event): boolean {
  match (e) {
    handshake.PeerClosed => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// __answered is what the server does about one event: nothing, for most.
function __answered(s: Session, srv: handshake.Server, e: handshake.Event): Result[handshake.ServerStep, Failure] {
  match (e) {
    handshake.SignNeeded(sg) => {
      match (s.config.identity.key.sign(sg.scheme, sg.signed)) {
        Ok(sig) => {
          return __failed(srv, srv.signature(sig));
        },
        Err(_) => {
          return Err(Failure { error: SigningFailed, alert: srv.alert(handshake.HandshakeFailure("signing")) });
        }
      }
    },
    handshake.ResumeOffered(offer) => {
      return __failed(srv, srv.resume(__lookup(s.config, offer, now_unix_ms())));
    },
    handshake.VerifyClient(v) => {
      match (__client_trusted(s.config, v)) {
        Ok(_) => {
          return __failed(srv, srv.verdict(true));
        },
        Err(err) => {
          return Err(Failure { error: err, alert: srv.alert(__client_alert(err)) });
        }
      }
    },
    handshake.Connected => {
      if (s.config.tickets) {
        return __failed(srv, srv.ticket(__issue(s.config, srv, now_unix_ms())));
      }
    },
    _ => {}
  }
  return Ok(handshake.ServerStep { server: srv, output: [], data: [], events: [] });
}

// __client_trusted judges a client's chain against the config's roots now,
// and its CertificateVerify under the leaf's key.
function __client_trusted(config: Config, v: handshake.Verification): Result[void, TlsError] {
  let roots: verify.Roots = verify.roots([]);
  match (config.client_roots) {
    Some(r) => {
      roots = r;
    },
    None => {
      return Ok(());
    }
  }
  if (v.chain.len() == 0) {
    return Err(ClientCertificateMissing);
  }
  match (verify.verify_client(v.chain, roots, now_unix_ms() / 1000)) {
    Ok(leaf) => {
      if (!verify.scheme_fits(leaf, v.scheme)) {
        return Err(ClientSchemeMismatch);
      }
      if (!verify.verify_signed(leaf, v.scheme, v.signed, v.signature)) {
        return Err(ClientSignatureInvalid);
      }
      return Ok(());
    },
    Err(e) => {
      return Err(ClientUntrusted(e));
    }
  }
  return Err(ClientSignatureInvalid);
}

// The alert a refused client certificate draws: certificate_required for
// none, bad_certificate for an untrusted chain, decrypt_error for a
// CertificateVerify that does not verify and illegal_parameter for one
// under a scheme the key cannot make (§4.4.3, §4.2.3).
function __client_alert(e: TlsError): handshake.HandshakeError {
  match (e) {
    ClientCertificateMissing => {
      return handshake.CertificateRequired;
    },
    ClientSignatureInvalid => {
      return handshake.DecryptError;
    },
    ClientSchemeMismatch => {
      return handshake.Illegal("signature scheme for the client's key");
    },
    _ => {
      return handshake.BadCertificate;
    }
  }
  return handshake.BadCertificate;
}

// Tickets. A ticket is the PSK it stands for, the suite it was issued
// under, when it was issued and for how long, and the name it was issued
// to, sealed under the config's key behind a fresh nonce (§4.6.1).

const TICKET_AAD: string = "fern tls ticket";

const TICKET_VERSION: i32 = 1;

// __issue is the ticket to send once connected: nonce 0 is the only one
// issued per connection.
function __issue(config: Config, srv: handshake.Server, now: i64): message.NewSessionTicket {
  let nonce: u8[] = [0 as u8];
  let lifetime: i64 = config.ticket_lifetime.as_millis() / (1000 as i64);
  let age_add: u8[] = random_bytes(4);
  let body: u8[] = [TICKET_VERSION as u8];
  body = __u16(body, srv.cipher_suite().code());
  body = __i64(body, now);
  body = __u16(__i64(body, lifetime), srv.server_name.bytes().len());
  body = __cat(body, srv.server_name.bytes());
  match (srv.resumption_psk(nonce)) {
    Ok(psk) => {
      body = __cat(body, psk);
    },
    Err(_) => {}
  }
  let ticket_nonce: u8[] = random_bytes(12);
  let sealed: u8[] = [];
  match (chacha20poly1305.seal(config.ticket_key, ticket_nonce, body, TICKET_AAD.bytes())) {
    Ok(b) => {
      sealed = b;
    },
    Err(_) => {}
  }
  return message.NewSessionTicket { lifetime: lifetime as u32, age_add: __u32_of(age_add), nonce: nonce, ticket: __cat(ticket_nonce, sealed), extensions: [] };
}

// __lookup is the first ticket offered that opens under the key, was issued
// under a suite with the chosen suite's hash, to the name asked for, and is
// still alive at `now`; None resumes nothing.
function __lookup(config: Config, offer: handshake.Offer, now: i64): Option[handshake.Resumed] {
  let i: i32 = 0;
  while (i < offer.identities.len()) {
    match (__open_ticket(config, offer, offer.identities[i].identity, now)) {
      Some(psk) => {
        return Some(handshake.Resumed { index: i, psk: psk });
      },
      None => {}
    }
    i = i + 1;
  }
  return None;
}

function __open_ticket(config: Config, offer: handshake.Offer, id: [u8], now: i64): Option[u8[]] {
  if (id.len() < 12) {
    return None;
  }
  match (chacha20poly1305.open(config.ticket_key, __copy(id[0:12]), __copy(id[12:id.len()]), TICKET_AAD.bytes())) {
    Ok(body) => {
      return __usable_ticket(body, offer, now);
    },
    Err(_) => {
      return None;
    }
  }
  return None;
}

// __usable_ticket reads an opened ticket and judges it against the offer.
function __usable_ticket(body: u8[], offer: handshake.Offer, now: i64): Option[u8[]] {
  let size: i32 = offer.suite.hash().size();
  if (body.len() < 21 || body[0] as i32 != TICKET_VERSION) {
    return None;
  }
  let name_len: i32 = body[19] as i32 << 8 | body[20] as i32;
  if (body.len() != 21 + name_len + size) {
    return None;
  }
  match (keyschedule.cipher_suite(body[1] as i32 << 8 | body[2] as i32)) {
    Some(suite) => {
      if (suite.hash().size() != size) {
        return None;
      }
    },
    None => {
      return None;
    }
  }
  let issued: i64 = __i64_at(body, 3);
  let lifetime: i64 = __i64_at(body, 11);
  if (now < issued || now >= issued + lifetime * (1000 as i64)) {
    return None;
  }
  if (!__same(body[21:21 + name_len], offer.server_name.bytes())) {
    return None;
  }
  return Some(__copy(body[21 + name_len:body.len()]));
}

function __u16(own out: u8[], v: i32): u8[] {
  return out.append((v >> 8 & 255) as u8).append((v & 255) as u8);
}

function __i64(own out: u8[], v: i64): u8[] {
  let i: i32 = 7;
  while (i >= 0) {
    out = out.append((v >> (8 * i) as i64 & 255 as i64) as u8);
    i = i - 1;
  }
  return out;
}

function __i64_at(b: [u8], at: i32): i64 {
  let v: i64 = 0 as i64;
  let i: i32 = 0;
  while (i < 8) {
    v = v << 8 as i64 | b[at + i] as i64;
    i = i + 1;
  }
  return v;
}

function __u32_of(b: u8[]): u32 {
  return b[0] as u32 << 24 | b[1] as u32 << 16 | b[2] as u32 << 8 | b[3] as u32;
}

function __cat(own a: u8[], b: [u8]): u8[] {
  let i: i32 = 0;
  while (i < b.len()) {
    a = a.append(b[i]);
    i = i + 1;
  }
  return a;
}

function __copy(b: [u8]): u8[] {
  return __cat([], b);
}

function __same(a: [u8], b: [u8]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function __more(own a: handshake.Event[], b: handshake.Event[]): handshake.Event[] {
  for e in b {
    a = a.append(e);
  }
  return a;
}

// Over a socket.

// Connection — a session over an accepted TCP socket, with the application
// data the client sent in the same read as the end of the handshake, and
// whether it has already closed.
// `open` is whether the socket is still the connection's: a failure in
// `recv` or `send` sends the alert and closes it, and `close` after that
// does nothing.
pub struct Connection { fd: i32, session: Session, pending: u8[], ended: boolean, open: Cell[boolean] }

// Received — what `recv` read: application data, empty when the wait
// passed first, and whether the peer has ended the stream, by close_notify
// or by closing the socket.
pub struct Received { conn: Connection, data: u8[], ended: boolean }

// accept completes a handshake on a socket just accepted, within
// `timeout`. The socket is closed if the handshake fails.
pub function accept(fd: i32, config: Config, timeout: Duration): Result[Connection, TlsError] {
  match (__handshake_on(fd, config, monotonic_ns() + timeout.as_nanos())) {
    Ok(c) => {
      return Ok(c);
    },
    Err(e) => {
      tcp_close(fd);
      return Err(e);
    }
  }
  return Err(ClosedEarly);
}

function __handshake_on(fd: i32, config: Config, deadline: i64): Result[Connection, TlsError] {
  let s: Session = start(config)?;
  let pending: u8[] = [];
  let ended: boolean = false;
  while (!s.connected() && !ended) {
    let input: u8[] = [];
    match (__await(fd, deadline)?) {
      Some(b) => {
        input = b;
      },
      None => {
        return Err(HandshakeTimeout);
      }
    }
    if (input.len() == 0) {
      return Err(ClosedEarly);
    }
    let step: Step = __exchange_fd(fd, s, input)?;
    s = step.session;
    pending = __cat(pending, step.data);
    ended = step.closed;
  }
  if (!s.connected()) {
    return Err(ClosedEarly);
  }
  return Ok(Connection { fd: fd, session: s, pending: pending, ended: ended, open: cell_new(true) });
}

// send writes data to the client.
pub function (c: Connection) send(data: [u8]): Result[Connection, TlsError] {
  if (c.session.offloaded()) {
    __send_fd(c.fd, data)?;
    return Ok(c);
  }
  let step: Step = c.session.write(data)?;
  __send_fd(c.fd, step.output)?;
  return Ok(Connection { ...c, session: step.session });
}

// offload moves the connection's records into the kernel (std/tls/ktls),
// which then seals what `send` writes and opens what `recv` reads. Where
// the kernel has no TLS record layer, or the session holds bytes of a
// record still arriving, the connection is returned as it was and goes on
// sealing its own (`offloaded` says which). It fails only when the kernel
// took one direction and refused the other, which closes the socket.
pub function (c: Connection) offload(): Result[Connection, TlsError] {
  if let Some(o) = c.session.offload() {
    match (ktls.attach(c.fd, o.keys)) {
      ktls.Kernel => {
        return Ok(Connection { ...c, session: o.session });
      },
      ktls.Unchanged => {},
      ktls.Broken(e) => {
        tcp_close(c.fd);
        c.open.set(false);
        return Err(NetFailed(net.error_from_errno(e)));
      }
    }
  }
  return Ok(c);
}

// Whether the kernel seals and opens the connection's records (`offload`).
pub function (c: Connection) offloaded(): boolean {
  return c.session.offloaded();
}

// update_keys sends a KeyUpdate and moves to the next write key; `request`
// asks the client to move to its next one too. Once offloaded the kernel takes
// the new key after the KeyUpdate it seals under the old one; a kernel
// that refuses it (before 6.14) leaves the socket unusable, and it is
// closed.
pub function (c: Connection) update_keys(request: boolean): Result[Connection, TlsError] {
  let step: Step = c.session.update_keys(request)?;
  __send_out(c.fd, c.session, step.output)?;
  let r: i32 = ktls.install(c.fd, step.rekeyed);
  if (r < 0) {
    tcp_close(c.fd);
    c.open.set(false);
    return Err(KeysRefused(0 - r));
  }
  return Ok(Connection { ...c, session: step.session });
}

// recv waits at most `wait` for application data, answering first with
// what arrived with the handshake.
pub function (c: Connection) recv(wait: Duration): Result[Received, TlsError] {
  if (c.pending.len() > 0 || c.ended) {
    return Ok(Received { conn: Connection { ...c, pending: [] }, data: c.pending, ended: c.ended });
  }
  if (c.session.offloaded()) {
    return __recv_kernel(c, monotonic_ns() + wait.as_nanos());
  }
  return __recv_until(c, monotonic_ns() + wait.as_nanos());
}

// __recv_kernel reads records the kernel opened until application data or
// the end of the stream arrives, or the deadline passes; any other record
// goes through the session.
function __recv_kernel(c: Connection, deadline: i64): Result[Received, TlsError] {
  let s: Session = c.session;
  while (true) {
    let left: i64 = deadline - monotonic_ns();
    if (left <= 0) {
      return Ok(__received(c, s, [], false));
    }
    let next: Kerneled = __kernel_next(c, s, ktls.recv(c.fd, time.duration_nanos(left)))?;
    s = next.session;
    if (next.done) {
      return Ok(next.got);
    }
  }
  return Ok(__received(c, s, [], true));
}

// Kerneled — the session after one record off an offloaded socket, and
// what `recv` answers when that record ends the wait (`done`).
struct Kerneled { session: Session, got: Received, done: boolean }

function __kernel_next(c: Connection, s: Session, read: ktls.Read): Result[Kerneled, TlsError] {
  match (read) {
    ktls.Opened(t, content) => {
      if (t == 23) {
        return Ok(Kerneled { session: s, got: __received(c, s, content, false), done: true });
      }
      let step: Step = __exchange(c, s, ktls.framed(t, content))?;
      let ends: boolean = step.data.len() > 0 || step.closed;
      return Ok(Kerneled { session: step.session, got: __received(c, step.session, step.data, step.closed), done: ends });
    },
    ktls.StreamEnded => {
      return Ok(Kerneled { session: s, got: __stream_ended(c, s)?, done: true });
    },
    ktls.NothingYet => {
      return Ok(Kerneled { session: s, got: __received(c, s, [], false), done: true });
    },
    ktls.WaitCancelled => {
      return Err(NetFailed(net.Interrupted));
    },
    ktls.ReadFailed(e) => {
      return Err(__kernel_failed(c, e));
    }
  }
  return Err(ClosedEarly);
}

// __kernel_failed is a read the kernel refused: a record that did not open
// or overflowed gets its alert, and the socket is closed either way.
function __kernel_failed(c: Connection, errno: i32): TlsError {
  let err: TlsError = NetFailed(net.error_from_errno(errno));
  if (errno == 74) {
    ktls.alert(c.fd, 20);
    err = HandshakeFailed(handshake.Record(record.BadRecordMac));
  } else if (errno == 90) {
    ktls.alert(c.fd, 22);
    err = HandshakeFailed(handshake.Record(record.RecordOverflow(0)));
  }
  tcp_close(c.fd);
  c.open.set(false);
  return err;
}

// __recv_until reads until application data or the end of the stream
// arrives, or the deadline passes.
function __recv_until(c: Connection, deadline: i64): Result[Received, TlsError] {
  let s: Session = c.session;
  while (true) {
    let input: u8[] = [];
    match (__await(c.fd, deadline)?) {
      Some(b) => {
        input = b;
      },
      None => {
        return Ok(__received(c, s, [], false));
      }
    }
    if (input.len() == 0) {
      return __stream_ended(c, s);
    }
    let step: Step = __exchange(c, s, input)?;
    s = step.session;
    if (step.data.len() > 0 || step.closed) {
      return Ok(__received(c, s, step.data, step.closed));
    }
  }
  return Ok(__received(c, c.session, [], true));
}

function __received(c: Connection, s: Session, data: u8[], ended: boolean): Received {
  return Received { conn: Connection { ...c, session: s, ended: ended }, data: data, ended: ended };
}

// __stream_ended is the socket's end of stream: the peer has gone, which
// inside a record is a cut.
function __stream_ended(c: Connection, s: Session): Result[Received, TlsError] {
  if (s.held.len() > 0) {
    return Err(RecordCut);
  }
  return Ok(__received(c, s, [], true));
}

// __exchange reads input on an open connection and sends what the session
// answers; a failure sends its alert and closes the socket.
function __exchange(c: Connection, s: Session, input: [u8]): Result[Step, TlsError] {
  match (__exchange_fd(c.fd, s, input)) {
    Ok(step) => {
      return Ok(step);
    },
    Err(e) => {
      tcp_close(c.fd);
      c.open.set(false);
      return Err(e);
    }
  }
  return Err(ClosedEarly);
}

// __exchange_fd reads input and sends what the session answers, or the
// alert a failure calls for. Once offloaded, the keys a KeyUpdate set go to
// the kernel after what the session answered under the old ones.
function __exchange_fd(fd: i32, s: Session, input: [u8]): Result[Step, TlsError] {
  match (s.read(input)) {
    Ok(step) => {
      __send_out(fd, s, step.output)?;
      let r: i32 = ktls.install(fd, step.rekeyed);
      if (r < 0) {
        return Err(KeysRefused(0 - r));
      }
      return Ok(step);
    },
    Err(f) => {
      __send_out(fd, s, f.alert);
      return Err(f.error);
    }
  }
  return Err(ClosedEarly);
}

// __send_out sends what a session wrote: records it sealed, or once
// offloaded the records it framed for the kernel.
function __send_out(fd: i32, s: Session, out: [u8]): Result[void, TlsError] {
  if (!s.offloaded()) {
    return __send_fd(fd, out);
  }
  let r: i32 = ktls.send_records(fd, out);
  if (r < 0) {
    return Err(NetFailed(net.error_from_errno(0 - r)));
  }
  return Ok(());
}

// close sends close_notify and closes the socket, once.
pub function (c: Connection) close(): void {
  if (!c.open.get()) {
    return;
  }
  c.open.set(false);
  if let Ok(step) = c.session.close() {
    __send_out(c.fd, c.session, step.output);
  }
  tcp_close(c.fd);
}

function __send_fd(fd: i32, data: [u8]): Result[void, TlsError] {
  let at: i32 = 0;
  while (at < data.len()) {
    let n: i32 = tcp_send_bytes(fd, __cat([], data[at:data.len()]));
    if (n < 0) {
      return Err(NetFailed(net.error_from_errno(0 - n)));
    }
    if (n == 0) {
      return Err(NetFailed(net.ConnectionReset));
    }
    at = at + n;
  }
  return Ok(());
}

// __await is the next bytes off the socket before `deadline`, empty at the
// end of the stream, or None once the deadline has passed.
function __await(fd: i32, deadline: i64): Result[Option[u8[]], TlsError] {
  let left: i64 = deadline - monotonic_ns();
  if (left <= 0) {
    return Ok(None);
  }
  return __recv_fd(fd, time.duration_nanos(left));
}

// __recv_fd is the next bytes off the socket within `wait`, empty at the
// end of the stream, or None when the wait passed first.
function __recv_fd(fd: i32, wait: Duration): Result[Option[u8[]], TlsError] {
  match (tcp.tcp_recv_deadline(fd, 65536, wait)) {
    tcp.Chunk(b) => {
      return Ok(Some(b));
    },
    tcp.Elapsed => {
      return Ok(None);
    },
    tcp.Abandoned => {
      return Err(NetFailed(net.Interrupted));
    }
  }
  return Ok(None);
}
