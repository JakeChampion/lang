// std/tls/client — a TLS 1.3 client: std/tls/handshake's client with the
// server's certificate judged against a root store, as a sans-IO `Session`
// any transport can carry, and as a `Connection` over a TCP socket.
//
//   let roots: verify.Roots = ...;   // verify.system_roots(), or the caller's
//   let c: client.Connection = client.connect("example.com", 443, client.config("example.com", roots), time.duration_seconds(10 as i64))?;
//   c = c.send("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n".bytes())?;
//   let got: client.Received = c.recv(time.duration_seconds(30 as i64))?;
//
// The server's chain must reach one of the roots at the time the session
// is given (a `Connection` gives the current one) and name the server
// (std/tls/verify), and its CertificateVerify must verify
// under the leaf's key. The client offers X25519MLKEM768 with X25519,
// secp256r1 and SecP256r1MLKEM768 as the groups a HelloRetryRequest may
// ask for, every suite, and the protocols in `alpn`. A server name that is an IP address is checked against the
// certificate's addresses and not sent as SNI, which carries names only.

import "core/int";
import "std/dns";
import "std/i32";
import "std/net";
import "std/tcp";
import "std/time";
import "std/tls/handshake";
import "std/tls/identity";
import "std/tls/keyschedule";
import "std/tls/ktls";
import "std/tls/message";
import "std/tls/record";
import "std/tls/verify";
import "std/tls/x509";

// Config — the name the certificate must carry, the protocols to offer by
// ALPN in preference order, the roots to trust, a ticket to resume from,
// and an identity to present when the server asks for one.
pub struct Config { server_name: string, alpn: string[], roots: verify.Roots, resume: Option[Ticket], identity: Option[identity.Identity] }

// Ticket — a session ticket a server issued, as `Step.tickets` hands it
// over: what to offer, the PSK it stands for, the suite it was issued
// under, how long it lives from when it was received, and the name of the
// server that issued it, which is the only one it is offered to.
pub struct Ticket { identity: u8[], psk: u8[], suite: i32, lifetime: u32, age_add: u32, received_ms: i64, server_name: string }

// config offers no application protocol and no ticket.
pub function config(server_name: string, roots: verify.Roots): Config {
  return Config { server_name: server_name, alpn: [], roots: roots, resume: None, identity: None };
}

pub function (c: Config) with_alpn(protocols: string[]): Config {
  return Config { ...c, alpn: protocols };
}

// with_ticket offers a ticket for resumption, when it was issued to the
// server named and has not expired.
pub function (c: Config) with_ticket(t: Ticket): Config {
  return Config { ...c, resume: Some(t) };
}

// with_identity presents the chain, signed with its key, when the server
// asks for a client certificate; without one the client answers with an
// empty Certificate and the server decides.
pub function (c: Config) with_identity(id: identity.Identity): Config {
  return Config { ...c, identity: Some(id) };
}

// TlsError — why a connection failed: the handshake's own refusal, a chain
// the roots do not vouch for, a CertificateVerify that does not verify, the
// name not resolving, the socket's error, the handshake outlasting its
// bound, the peer closing before the handshake ended, or closing inside a
// record.
pub enum TlsError {
  HandshakeFailed(handshake.HandshakeError),
  Untrusted(verify.VerifyError),
  SignatureInvalid,
  // The identity's key could not sign the CertificateVerify.
  SigningFailed,
  Unresolved(dns.DnsError),
  NetFailed(net.NetError),
  HandshakeTimeout,
  ClosedEarly,
  RecordCut,
  // The kernel's TLS record layer refused a KeyUpdate's keys, with the
  // errno: Linux before 6.14 takes one key per direction.
  KeysRefused(i32),
}

// One arm per variant.
// fern-lint: allow cyclomatic-complexity
pub function (e: TlsError) message(): string {
  match (e) {
    HandshakeFailed(h) => {
      return h.message();
    },
    Untrusted(v) => {
      return "the server's certificate is not trusted: " + v.message();
    },
    SignatureInvalid => {
      return "the server's CertificateVerify does not verify";
    },
    SigningFailed => {
      return "the identity's key could not sign the CertificateVerify";
    },
    Unresolved(d) => {
      return d.message();
    },
    NetFailed(n) => {
      return n.message();
    },
    HandshakeTimeout => {
      return "the handshake did not finish in time";
    },
    ClosedEarly => {
      return "the peer closed the connection during the handshake";
    },
    RecordCut => {
      return "the peer closed the connection inside a record";
    },
    KeysRefused(errno) => {
      return "the kernel's TLS record layer refused new keys (errno " + errno.to_string() + "); Linux before 6.14 takes one key per direction";
    }
  }
  return "";
}

// Session — one connection's TLS, bytes in and bytes out: the handshake's
// client, the name and roots it is judged by, and the bytes of a record
// still arriving.
pub struct Session { client: handshake.Client, name: string, roots: verify.Roots, identity: Option[identity.Identity], held: u8[] }

// Failure — why `read` failed, and the alert record to send the server
// before closing, sealed under the keys in force when it failed.
pub struct Failure { error: TlsError, alert: u8[] }

pub function (f: Failure) message(): string {
  return f.error.message();
}

// Step — the session after a call, the bytes to send, the application data
// read, whether the peer has sent close_notify, the tickets the server
// issued, to keep for `with_ticket`, and, once offloaded, the keys a
// KeyUpdate gave the kernel to take next.
pub struct Step { session: Session, output: u8[], data: u8[], closed: boolean, tickets: Ticket[], rekeyed: handshake.KernelKeys }

// start begins a handshake at `now`, the wall-clock time in Unix
// milliseconds; send `output`, then feed what arrives to `read`.
pub function start(config: Config, now: i64): Result[Step, TlsError] {
  let sni: string = config.server_name;
  if (__is_address(sni)) {
    sni = "";
  }
  let hc: handshake.ClientConfig = handshake.ClientConfig { ...handshake.client_config(sni), alpn: config.alpn, resume: __offer(config, now) };
  match (config.identity) {
    Some(id) => {
      hc = handshake.ClientConfig { ...hc, chain: id.chain, sign_schemes: [id.key.scheme()] };
    },
    None => {}
  }
  match (handshake.client_start(hc, random_bytes(handshake.client_entropy(hc)))) {
    Ok(step) => {
      let s: Session = Session { client: step.client, name: config.server_name, roots: config.roots, identity: config.identity, held: [] };
      return Ok(Step { session: s, output: step.output, data: [], closed: false, tickets: [], rekeyed: __no_keys() });
    },
    Err(e) => {
      return Err(HandshakeFailed(e));
    }
  }
  return Err(ClosedEarly);
}

// __offer is the ticket to offer at `now`: the config's, when it was
// issued to the server named and is still within its lifetime.
function __offer(config: Config, now: i64): Option[handshake.Resumption] {
  match (config.resume) {
    Some(t) => {
      let age: i64 = now - t.received_ms;
      if (t.server_name != config.server_name || age < 0 as i64 || age >= t.lifetime as i64 * (1000 as i64)) {
        return None;
      }
      match (keyschedule.cipher_suite(t.suite)) {
        Some(suite) => {
          let obfuscated: i64 = age + t.age_add as i64 & 0xffffffff as i64;
          return Some(handshake.Resumption { identity: t.identity, psk: t.psk, suite: suite, obfuscated_age: obfuscated as u32 });
        },
        None => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
  return None;
}

function __is_address(name: string): boolean {
  match (net.ip_parse(name)) {
    Some(_) => {
      return true;
    },
    None => {
      return false;
    }
  }
  return false;
}

// read takes bytes from the server that arrived at `now`, in Unix
// milliseconds, judging its certificate at that time when the handshake
// reaches it. Whole records go to the handshake one at a time: the keys
// change only between records, so a failure's alert is sealed under the
// keys the records before it left.
pub function (s: Session) read(input: [u8], now: i64): Result[Step, Failure] {
  let buf: u8[] = __copy(s.held);
  buf = __cat(buf, input);
  let session: Session = Session { ...s, held: [] };
  let output: u8[] = [];
  let data: u8[] = [];
  let closed: boolean = false;
  let tickets: Ticket[] = [];
  let keys: handshake.KernelKeys = __no_keys();
  let at: i32 = 0;
  while (!closed && buf.len() - at >= 5) {
    let end: i32 = at + 5 + (buf[at + 3] as i32 << 8 | buf[at + 4] as i32);
    if (end > buf.len()) {
      break;
    }
    let next: Step = __record(session, buf[at:end], now)?;
    session = next.session;
    output = __cat(output, next.output);
    data = __cat(data, next.data);
    closed = next.closed;
    for t in next.tickets {
      tickets = tickets.append(t);
    }
    keys = keys.then(next.rekeyed);
    at = end;
  }
  return Ok(Step { session: Session { ...session, held: __copy(buf[at:buf.len()]) }, output: output, data: data, closed: closed, tickets: tickets, rekeyed: keys });
}

function __record(s: Session, record: [u8], now: i64): Result[Step, Failure] {
  match (s.client.read(record)) {
    Ok(step) => {
      return __judged(s, step, now);
    },
    Err(e) => {
      return Err(Failure { error: HandshakeFailed(e), alert: s.client.alert(e) });
    }
  }
  return Err(Failure { error: ClosedEarly, alert: [] });
}

// write seals application data; the session must be connected.
pub function (s: Session) write(data: [u8]): Result[Step, TlsError] {
  let step: handshake.ClientStep = __step(s.client.write(data))?;
  return Ok(Step { session: Session { ...s, client: step.client }, output: step.output, data: [], closed: false, tickets: [], rekeyed: __no_keys() });
}

// close is the close_notify to send; nothing more may be written.
pub function (s: Session) close(): Result[Step, TlsError] {
  let step: handshake.ClientStep = __step(s.client.close())?;
  return Ok(Step { session: Session { ...s, client: step.client }, output: step.output, data: [], closed: false, tickets: [], rekeyed: __no_keys() });
}

// update_keys sends a KeyUpdate and moves to the next write key; `request`
// asks the server to move to its next one too.
pub function (s: Session) update_keys(request: boolean): Result[Step, TlsError] {
  let step: handshake.ClientStep = __step(s.client.update_keys(request))?;
  return Ok(Step { session: Session { ...s, client: step.client }, output: step.output, data: [], closed: false, tickets: [], rekeyed: handshake.rekeyed(step.client.cipher_suite(), step.events) });
}

// Offloaded — a session whose records the kernel now seals and opens
// (std/tls/ktls), and the keys to give it.
pub struct Offloaded { session: Session, keys: handshake.KernelKeys }

// offload hands the record layer to the kernel, as server.Session.offload
// does.
pub function (s: Session) offload(): Option[Offloaded] {
  if (s.held.len() != 0) {
    return None;
  }
  match (s.client.offload()) {
    Some(o) => {
      return Some(Offloaded { session: Session { ...s, client: o.client }, keys: o.keys });
    },
    None => {}
  }
  return None;
}

pub function (s: Session) connected(): boolean {
  return s.client.connected();
}

// Whether the kernel seals and opens the session's records (`offload`).
pub function (s: Session) offloaded(): boolean {
  return s.client.offloaded();
}

// The protocol the server chose by ALPN, empty when none was.
pub function (s: Session) alpn(): string {
  return s.client.alpn();
}

// Whether the session resumed from the ticket offered, in which case the
// server sent no certificate: the ticket vouches for it.
pub function (s: Session) resumed(): boolean {
  return s.client.resumed();
}

// save is a connected session as bytes, for a pool that keeps idle
// connections where only bytes can go; `restore` makes it again. It holds
// the traffic secrets.
pub function (s: Session) save(): Result[u8[], TlsError] {
  let c: u8[] = __handshake_ok(s.client.save())?;
  let n: i32 = c.len();
  let out: u8[] = [(n >> 24 & 255) as u8, (n >> 16 & 255) as u8, (n >> 8 & 255) as u8, (n & 255) as u8];
  return Ok(__cat(__cat(out, c), s.held));
}

pub function restore(saved: [u8]): Result[Session, TlsError] {
  if (saved.len() < 4) {
    return Err(HandshakeFailed(handshake.Misuse("restore")));
  }
  let n: i32 = saved[0] as i32 << 24 | saved[1] as i32 << 16 | saved[2] as i32 << 8 | saved[3] as i32;
  if (n < 0 || n > saved.len() - 4) {
    return Err(HandshakeFailed(handshake.Misuse("restore")));
  }
  match (handshake.client_restore(saved[4:4 + n])) {
    Ok(c) => {
      return Ok(Session { client: c, name: "", roots: verify.roots([]), identity: None, held: __copy(saved[4 + n:saved.len()]) });
    },
    Err(e) => {
      return Err(HandshakeFailed(e));
    }
  }
  return Err(ClosedEarly);
}

function __step(r: Result[handshake.ClientStep, handshake.HandshakeError]): Result[handshake.ClientStep, TlsError] {
  match (r) {
    Ok(step) => {
      return Ok(step);
    },
    Err(e) => {
      return Err(HandshakeFailed(e));
    }
  }
  return Err(ClosedEarly);
}

function __verdict(c: handshake.Client): Result[handshake.ClientStep, Failure] {
  match (c.verdict(true)) {
    Ok(step) => {
      return Ok(step);
    },
    Err(e) => {
      return Err(Failure { error: HandshakeFailed(e), alert: c.alert(e) });
    }
  }
  return Err(Failure { error: ClosedEarly, alert: [] });
}

function __handshake_ok(r: Result[u8[], handshake.HandshakeError]): Result[u8[], TlsError] {
  match (r) {
    Ok(b) => {
      return Ok(b);
    },
    Err(e) => {
      return Err(HandshakeFailed(e));
    }
  }
  return Err(ClosedEarly);
}

// __judged answers each event in a step that asks something of the client
// (a verdict on the server's chain, a signature) and gathers what the
// handshake goes on to produce, and the tickets issued.
function __judged(s: Session, first: handshake.ClientStep, now: i64): Result[Step, Failure] {
  let c: handshake.Client = first.client;
  let output: u8[] = first.output;
  let data: u8[] = first.data;
  let events: handshake.Event[] = first.events;
  let closed: boolean = false;
  let tickets: Ticket[] = [];
  let i: i32 = 0;
  while (i < events.len()) {
    match (events[i]) {
      handshake.Ticket(t) => {
        tickets = __kept(tickets, s, c, t, now);
      },
      handshake.PeerClosed => {
        closed = true;
      },
      _ => {
        let next: handshake.ClientStep = __answered(s, c, events[i], now)?;
        c = next.client;
        output = __cat(output, next.output);
        data = __cat(data, next.data);
        events = __more(events, next.events);
      }
    }
    i = i + 1;
  }
  return Ok(Step { session: Session { ...s, client: c }, output: output, data: data, closed: closed, tickets: tickets, rekeyed: handshake.rekeyed(c.cipher_suite(), events) });
}

function __no_keys(): handshake.KernelKeys {
  return handshake.KernelKeys { transmit: [], receive: [] };
}

// __kept is the tickets with a new one the server issued at `now`, as the
// caller keeps it.
function __kept(own tickets: Ticket[], s: Session, c: handshake.Client, t: message.NewSessionTicket, now: i64): Ticket[] {
  match (c.resumption_psk(t.nonce)) {
    Ok(psk) => {
      return tickets.append(Ticket { identity: t.ticket, psk: psk, suite: c.cipher_suite().code(), lifetime: t.lifetime, age_add: t.age_add, received_ms: now, server_name: s.name });
    },
    Err(_) => {
      return tickets;
    }
  }
  return tickets;
}

// __answered is what the client does about one event: nothing, for most.
function __answered(s: Session, c: handshake.Client, e: handshake.Event, now: i64): Result[handshake.ClientStep, Failure] {
  match (e) {
    handshake.VerifyServer(v) => {
      match (__trusted(s, v, now)) {
        Ok(_) => {
          return __verdict(c);
        },
        Err(err) => {
          return Err(Failure { error: err, alert: c.alert(handshake.BadCertificate) });
        }
      }
    },
    handshake.SignNeeded(sg) => {
      return __signature(s, c, sg);
    },
    _ => {}
  }
  return Ok(handshake.ClientStep { client: c, output: [], data: [], events: [] });
}

// __signature signs the client's CertificateVerify with the identity's key.
function __signature(s: Session, c: handshake.Client, sg: handshake.Signing): Result[handshake.ClientStep, Failure] {
  let sig: u8[] = [];
  match (s.identity) {
    Some(id) => {
      match (id.key.sign(sg.scheme, sg.signed)) {
        Ok(b) => {
          sig = b;
        },
        Err(_) => {
          return Err(Failure { error: SigningFailed, alert: c.alert(handshake.HandshakeFailure("signing")) });
        }
      }
    },
    None => {
      return Err(Failure { error: SigningFailed, alert: c.alert(handshake.HandshakeFailure("signing")) });
    }
  }
  match (c.signature(sig)) {
    Ok(step) => {
      return Ok(step);
    },
    Err(e) => {
      return Err(Failure { error: HandshakeFailed(e), alert: c.alert(e) });
    }
  }
  return Err(Failure { error: ClosedEarly, alert: [] });
}

// __trusted checks the chain against the roots for the session's name at
// `now`, in Unix milliseconds, and the CertificateVerify under the leaf's key.
function __trusted(s: Session, v: handshake.Verification, now: i64): Result[void, TlsError] {
  match (verify.verify_server(v.chain, s.roots, s.name, now / 1000)) {
    Ok(leaf) => {
      if (!verify.verify_signed(leaf, v.scheme, v.signed, v.signature)) {
        return Err(SignatureInvalid);
      }
      return Ok(());
    },
    Err(e) => {
      return Err(Untrusted(e));
    }
  }
  return Err(SignatureInvalid);
}

function __cat(own a: u8[], b: [u8]): u8[] {
  let i: i32 = 0;
  while (i < b.len()) {
    a = a.append(b[i]);
    i = i + 1;
  }
  return a;
}

function __copy(b: [u8]): u8[] {
  return __cat([], b);
}

function __more(own a: handshake.Event[], b: handshake.Event[]): handshake.Event[] {
  for e in b {
    a = a.append(e);
  }
  return a;
}

// Over a socket.

// Connection — a session over a connected TCP socket, and the tickets the
// server has issued on it so far, for `with_ticket`.
// `open` is whether the socket is still the connection's: a failure in
// `recv` or `send` sends the alert and closes it, and `close` after that
// does nothing.
pub struct Connection { fd: i32, session: Session, tickets: Ticket[], open: Cell[boolean] }

// Received — what `recv` read: application data, empty when the wait
// passed first, and whether the peer has ended the stream, by close_notify
// or by closing the socket.
pub struct Received { conn: Connection, data: u8[], ended: boolean }

// connect resolves `host`, races its addresses and completes a handshake,
// all within `timeout`.
pub function connect(host: string, port: i32, config: Config, timeout: Duration): Result[Connection, TlsError] {
  let deadline: i64 = monotonic_ns() + timeout.as_nanos();
  let addrs: net.IpAddr[] = [];
  match (dns.resolve(host)) {
    Ok(a) => {
      addrs = a;
    },
    Err(e) => {
      return Err(Unresolved(e));
    }
  }
  match (dns.connect_race(addrs, port, dns.DialOptions { ...dns.dial_options(), timeout: timeout })) {
    Ok(fd) => {
      return __handshake_by(fd, config, deadline);
    },
    Err(e) => {
      return Err(NetFailed(e));
    }
  }
  return Err(ClosedEarly);
}

// over completes a handshake on a socket already connected, within
// `timeout`: after a STARTTLS, or through a proxy's tunnel. The socket is
// closed if the handshake fails.
pub function over(fd: i32, config: Config, timeout: Duration): Result[Connection, TlsError] {
  return __handshake_by(fd, config, monotonic_ns() + timeout.as_nanos());
}

function __handshake_by(fd: i32, config: Config, deadline: i64): Result[Connection, TlsError] {
  match (__handshake_on(fd, config, deadline)) {
    Ok(st) => {
      return Ok(st);
    },
    Err(e) => {
      tcp_close(fd);
      return Err(e);
    }
  }
  return Err(ClosedEarly);
}

function __handshake_on(fd: i32, config: Config, deadline: i64): Result[Connection, TlsError] {
  let step: Step = start(config, now_unix_ms())?;
  __send_fd(fd, step.output)?;
  let s: Session = step.session;
  let tickets: Ticket[] = [];
  while (!s.connected()) {
    let input: u8[] = [];
    match (__await(fd, deadline)?) {
      Some(b) => {
        input = b;
      },
      None => {
        return Err(HandshakeTimeout);
      }
    }
    if (input.len() == 0) {
      return Err(ClosedEarly);
    }
    let step: Step = __exchange_fd(fd, s, input)?;
    s = step.session;
    tickets = __more_tickets(tickets, step.tickets);
  }
  return Ok(Connection { fd: fd, session: s, tickets: tickets, open: cell_new(true) });
}

function __more_tickets(own a: Ticket[], b: Ticket[]): Ticket[] {
  for t in b {
    a = a.append(t);
  }
  return a;
}

// send writes data to the server.
pub function (c: Connection) send(data: [u8]): Result[Connection, TlsError] {
  if (c.session.offloaded()) {
    __send_fd(c.fd, data)?;
    return Ok(c);
  }
  let step: Step = c.session.write(data)?;
  __send_fd(c.fd, step.output)?;
  return Ok(Connection { ...c, session: step.session });
}

// offload moves the connection's records into the kernel, as
// server.Connection.offload does. A ticket the server sends afterwards
// still reaches `tickets`.
pub function (c: Connection) offload(): Result[Connection, TlsError] {
  if let Some(o) = c.session.offload() {
    match (ktls.attach(c.fd, o.keys)) {
      ktls.Kernel => {
        return Ok(Connection { ...c, session: o.session });
      },
      ktls.Unchanged => {},
      ktls.Broken(e) => {
        tcp_close(c.fd);
        c.open.set(false);
        return Err(NetFailed(net.error_from_errno(e)));
      }
    }
  }
  return Ok(c);
}

// Whether the kernel seals and opens the connection's records (`offload`).
pub function (c: Connection) offloaded(): boolean {
  return c.session.offloaded();
}

// update_keys sends a KeyUpdate and moves to the next write key; `request`
// asks the server to move to its next one too. Once offloaded the kernel takes
// the new key after the KeyUpdate it seals under the old one; a kernel
// that refuses it (before 6.14) leaves the socket unusable, and it is
// closed.
pub function (c: Connection) update_keys(request: boolean): Result[Connection, TlsError] {
  let step: Step = c.session.update_keys(request)?;
  __send_out(c.fd, c.session, step.output)?;
  let r: i32 = ktls.install(c.fd, step.rekeyed);
  if (r < 0) {
    tcp_close(c.fd);
    c.open.set(false);
    return Err(KeysRefused(0 - r));
  }
  return Ok(Connection { ...c, session: step.session });
}

// recv waits at most `wait` for application data.
pub function (c: Connection) recv(wait: Duration): Result[Received, TlsError] {
  let deadline: i64 = monotonic_ns() + wait.as_nanos();
  if (c.session.offloaded()) {
    return __recv_kernel(c, deadline);
  }
  let conn: Connection = c;
  let s: Session = c.session;
  while (true) {
    let input: u8[] = [];
    match (__await(c.fd, deadline)?) {
      Some(b) => {
        input = b;
      },
      None => {
        return Ok(__received(conn, s, [], false));
      }
    }
    if (input.len() == 0) {
      return __stream_ended(conn, s);
    }
    let step: Step = __exchange(c, s, input)?;
    s = step.session;
    conn = Connection { ...conn, tickets: __more_tickets(conn.tickets, step.tickets) };
    if (step.data.len() > 0 || step.closed) {
      return Ok(__received(conn, s, step.data, step.closed));
    }
  }
  return Ok(__received(conn, c.session, [], true));
}

function __received(c: Connection, s: Session, data: u8[], ended: boolean): Received {
  return Received { conn: Connection { ...c, session: s }, data: data, ended: ended };
}

// __recv_kernel reads records the kernel opened until application data or
// the end of the stream arrives, or the deadline passes; any other record
// (a ticket, a KeyUpdate, an alert) goes through the session.
function __recv_kernel(c: Connection, deadline: i64): Result[Received, TlsError] {
  let conn: Connection = c;
  while (true) {
    let left: i64 = deadline - monotonic_ns();
    if (left <= 0) {
      return Ok(__received(conn, conn.session, [], false));
    }
    let next: Kerneled = __kernel_next(conn, ktls.recv(c.fd, time.duration_nanos(left)))?;
    conn = Connection { ...conn, tickets: __more_tickets(conn.tickets, next.tickets) };
    if (next.done) {
      return Ok(__received(conn, next.session, next.data, next.ended));
    }
    conn = Connection { ...conn, session: next.session };
  }
  return Ok(__received(conn, conn.session, [], true));
}

// Kerneled — what one read off an offloaded socket gave: the session after
// it, the application data, whether the stream ended, the tickets the
// server issued, and whether it ends the wait (`done`).
struct Kerneled { session: Session, data: u8[], ended: boolean, tickets: Ticket[], done: boolean }

function __kernel_next(c: Connection, read: ktls.Read): Result[Kerneled, TlsError] {
  let s: Session = c.session;
  match (read) {
    ktls.Opened(t, content) => {
      if (t == 23) {
        return Ok(Kerneled { session: s, data: content, ended: false, tickets: [], done: true });
      }
      let step: Step = __exchange(c, s, ktls.framed(t, content))?;
      return Ok(Kerneled { session: step.session, data: step.data, ended: step.closed, tickets: step.tickets, done: step.data.len() > 0 || step.closed });
    },
    ktls.StreamEnded => {
      return Ok(Kerneled { session: s, data: [], ended: true, tickets: [], done: true });
    },
    ktls.NothingYet => {
      return Ok(Kerneled { session: s, data: [], ended: false, tickets: [], done: true });
    },
    ktls.WaitCancelled => {
      return Err(NetFailed(net.Interrupted));
    },
    ktls.ReadFailed(e) => {
      return Err(__kernel_failed(c, e));
    }
  }
  return Err(ClosedEarly);
}

// __kernel_failed is a read the kernel refused: a record that did not open
// or overflowed gets its alert, and the socket is closed either way.
function __kernel_failed(c: Connection, errno: i32): TlsError {
  let err: TlsError = NetFailed(net.error_from_errno(errno));
  if (errno == 74) {
    ktls.alert(c.fd, 20);
    err = HandshakeFailed(handshake.Record(record.BadRecordMac));
  } else if (errno == 90) {
    ktls.alert(c.fd, 22);
    err = HandshakeFailed(handshake.Record(record.RecordOverflow(0)));
  }
  tcp_close(c.fd);
  c.open.set(false);
  return err;
}

// __stream_ended is the socket's end of stream: the peer has gone, which
// inside a record is a cut.
function __stream_ended(c: Connection, s: Session): Result[Received, TlsError] {
  if (s.held.len() > 0) {
    return Err(RecordCut);
  }
  return Ok(__received(c, s, [], true));
}

// __exchange reads input on an open connection and sends what the session
// answers; a failure sends its alert and closes the socket.
function __exchange(c: Connection, s: Session, input: [u8]): Result[Step, TlsError] {
  match (__exchange_fd(c.fd, s, input)) {
    Ok(step) => {
      return Ok(step);
    },
    Err(e) => {
      tcp_close(c.fd);
      c.open.set(false);
      return Err(e);
    }
  }
  return Err(ClosedEarly);
}

// __exchange_fd reads input and sends what the session answers, or the
// alert a failure calls for. Once offloaded, the keys a KeyUpdate set go to
// the kernel after what the session answered under the old ones.
function __exchange_fd(fd: i32, s: Session, input: [u8]): Result[Step, TlsError] {
  match (s.read(input, now_unix_ms())) {
    Ok(step) => {
      __send_out(fd, s, step.output)?;
      let r: i32 = ktls.install(fd, step.rekeyed);
      if (r < 0) {
        return Err(KeysRefused(0 - r));
      }
      return Ok(step);
    },
    Err(f) => {
      __send_out(fd, s, f.alert);
      return Err(f.error);
    }
  }
  return Err(ClosedEarly);
}

// __send_out sends what a session wrote: records it sealed, or once
// offloaded the records it framed for the kernel.
function __send_out(fd: i32, s: Session, out: [u8]): Result[void, TlsError] {
  if (!s.offloaded()) {
    return __send_fd(fd, out);
  }
  let r: i32 = ktls.send_records(fd, out);
  if (r < 0) {
    return Err(NetFailed(net.error_from_errno(0 - r)));
  }
  return Ok(());
}

// close sends close_notify and closes the socket, once.
pub function (c: Connection) close(): void {
  if (!c.open.get()) {
    return;
  }
  c.open.set(false);
  if let Ok(step) = c.session.close() {
    __send_out(c.fd, c.session, step.output);
  }
  tcp_close(c.fd);
}

function __send_fd(fd: i32, data: [u8]): Result[void, TlsError] {
  let at: i32 = 0;
  while (at < data.len()) {
    let n: i32 = tcp_send_bytes(fd, __cat([], data[at:data.len()]));
    if (n < 0) {
      return Err(NetFailed(net.error_from_errno(0 - n)));
    }
    if (n == 0) {
      return Err(NetFailed(net.ConnectionReset));
    }
    at = at + n;
  }
  return Ok(());
}

// __await is the next bytes off the socket before `deadline`, empty at the
// end of the stream, or None once the deadline has passed.
function __await(fd: i32, deadline: i64): Result[Option[u8[]], TlsError] {
  let left: i64 = deadline - monotonic_ns();
  if (left <= 0) {
    return Ok(None);
  }
  return __recv_fd(fd, time.duration_nanos(left));
}

// __recv_fd is the next bytes off the socket within `wait`, empty at the
// end of the stream, or None when the wait passed first.
function __recv_fd(fd: i32, wait: Duration): Result[Option[u8[]], TlsError] {
  match (tcp.tcp_recv_deadline(fd, 65536, wait)) {
    tcp.Chunk(b) => {
      return Ok(Some(b));
    },
    tcp.Elapsed => {
      return Ok(None);
    },
    tcp.Abandoned => {
      return Err(NetFailed(net.Interrupted));
    }
  }
  return Ok(None);
}
