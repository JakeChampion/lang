// std/fetch — outbound HTTP/1.1 client (the upstream-fetch half of the
// edge-handler use case: docs/PLATFORM-RESEARCH.md Rec §1,
// docs/ASYNC-REDESIGN.md).
//
// Built on the native socket primitives (tcp_connect / tcp_send /
// tcp_recv / tcp_close). A single `fetch_get` is a blocking request;
// overlapping several upstreams is `std/async`'s job — `fetch_future`
// (below) returns an `async.Future[string]` you fan out through
// `async.gather` / `async.race`, and their reads overlap on one thread.
//
// `host_be` is the IPv4 address in network byte order packed into an
// i32 (use `ipv4(a,b,c,d)`); pass the upstream port separately. URL /
// DNS parsing is a higher layer.

import "std/string";
import "std/async";
// std/tcp — tcp_recv_deadline, the recv-with-deadline primitive behind
// the *_deadline fetch variants.
import "std/tcp";

// ipv4(a, b, c, d) — pack a dotted-quad into the network-byte-order
// i32 that tcp_connect wants in sin_addr. ipv4(127,0,0,1) addresses
// loopback.
pub function ipv4(a: i32, b: i32, c: i32, d: i32): i32 {
    return (a & 255) | ((b & 255) << 8) | ((c & 255) << 16) | ((d & 255) << 24);
}

// fetch_raw(host_be, port, request) — open a connection, send `request`
// verbatim, and read the whole response until the peer closes (the
// request should carry `Connection: close`). Returns the raw response
// bytes as a string, or "" if the connection or send failed. Blocking;
// for overlap, use `fetch_future` through `async.gather` / `async.race`.
pub function fetch_raw(host_be: i32, port: i32, request: string): string {
    var c: i32 = tcp_connect(host_be, port);
    if (c < 0) {
        return "";
    }
    if (tcp_send(c, request) < 0) {
        tcp_close(c);
        return "";
    }
    var resp: string = "";
    while (true) {
        // PR2 (#5714) makes this path byte-based.
        var chunk: string = string_from_bytes_unchecked(tcp_recv(c, 4096));
        if (chunk.len() == 0) {
            break;
        }
        resp = resp + chunk;
    }
    tcp_close(c);
    return resp;
}

// fetch_get(host_be, port, path) — issue `GET <path>` against the
// upstream and return the raw HTTP/1.1 response (status line + headers
// + body). `Connection: close` so the read terminates at EOF. Use
// `http_body(resp)` to peel the body off.
pub function fetch_get(host_be: i32, port: i32, path: string): string {
    var request: string = "GET " + path + " HTTP/1.1\r\nHost: fern\r\nConnection: close\r\n\r\n";
    return fetch_raw(host_be, port, request);
}

// fetch_raw_deadline(host_be, port, request, deadline_ms) — `fetch_raw`
// with a total read deadline: `Some(response)` when the upstream's
// whole response arrived within `deadline_ms` of the send, `None` when
// the deadline passed first (the connection is closed either way). A
// connect/send failure is `Some("")`, mirroring `fetch_raw`'s "" — so
// None means exactly one thing: too slow. The deadline covers the read
// phase; `tcp_connect` itself is still a blocking connect (no
// non-blocking connect primitive yet), which on a reachable-but-dead
// upstream fails fast but on a black-holed address is at the mercy of
// the kernel SYN timeout. On interp the deadline degrades to blocking
// reads (see `tcp_recv_deadline`).
pub function fetch_raw_deadline(host_be: i32, port: i32, request: string, deadline_ms: i32): Option[string] {
    var c: i32 = tcp_connect(host_be, port);
    if (c < 0) {
        return Some("");
    }
    if (tcp_send(c, request) < 0) {
        tcp_close(c);
        return Some("");
    }
    var ns_per_ms: i64 = 1000000;
    var start_ns: i64 = monotonic_ns();
    var resp: string = "";
    while (true) {
        var remaining_ms: i32 = (((deadline_ms as i64) * ns_per_ms - (monotonic_ns() - start_ns)) / ns_per_ms) as i32;
        if (remaining_ms <= 0) {
            tcp_close(c);
            return None;
        }
        var chunk: string = "";
        var timed_out: boolean = false;
        match (tcp.tcp_recv_deadline(c, 4096, remaining_ms)) {
            Some(got) => { chunk = got; },
            None => { timed_out = true; },
        }
        if (timed_out) {
            tcp_close(c);
            return None;
        }
        if (chunk.len() == 0) {
            break;
        }
        resp = resp + chunk;
    }
    tcp_close(c);
    return Some(resp);
}

// fetch_get_deadline(host_be, port, path, deadline_ms) — `fetch_get`
// with a total read deadline. `Some(raw response)` in time (use
// `http_body` / `http_status`), `None` when the upstream was too slow.
pub function fetch_get_deadline(host_be: i32, port: i32, path: string, deadline_ms: i32): Option[string] {
    var request: string = "GET " + path + " HTTP/1.1\r\nHost: fern\r\nConnection: close\r\n\r\n";
    return fetch_raw_deadline(host_be, port, request, deadline_ms);
}

// fetch_future(host_be, port, path) — the AWAITABLE fetch: open a
// connection and send the request NON-blocking, then return a
// `Future[string]` that resolves to the response body once the socket
// is readable. This is the combinator-surface fetch
// (docs/ASYNC-REDESIGN.md): drive several through `async.gather` and
// their reads overlap on one thread —
//
//   var bodies = async.gather([
//       fetch.fetch_future(cache, 80, "/k"),
//       fetch.fetch_future(primary, 80, "/k"),
//   ], "");
//
// On a connect/send failure it resolves immediately to "" (a `Ready`
// future), so a failed upstream doesn't stall the fan-out. The read is
// STREAMING — `__fetch_drain` re-suspends per chunk and accumulates, so
// the whole response comes back (not just one `recv` buffer) while
// staying overlapped with the other futures. PORTABLE native + wasm: the
// wait token is `tcp_pollable(c)` — the raw fd on native (identity), a
// real wasi:io/poll pollable handle on wasm — so `poll` (poll(2) /
// ppoll(2) native, wasi:io/poll.poll on wasm) drives it either way. The
// continuation captures the connection `c` (it reads the socket, not the
// woken token, which differs by backend). On interp the `poll` stub
// means the `Pending` never resolves (consistent with std/async).
pub function fetch_future(host_be: i32, port: i32, path: string): async.Future[string] {
    var request: string = "GET " + path + " HTTP/1.1\r\nHost: fern\r\nConnection: close\r\n\r\n";
    var c: i32 = tcp_connect(host_be, port);
    if (c < 0) {
        return Ready("");
    }
    if (tcp_send(c, request) < 0) {
        tcp_close(c);
        return Ready("");
    }
    return __fetch_drain(c, "");
}

// __fetch_drain(c, acc) — one step of the streaming response read: a `Future`
// that, once `c` is readable, drops the woken pollable, `recv`s a chunk, and
// either FINISHES (empty recv = EOF, since we send `Connection: close`) by
// returning the parsed body, or RE-SUSPENDS to read more. `acc` carries the
// bytes read so far across re-suspends, so a response spanning multiple recv
// buffers / TCP segments is read in FULL — the previous single-`recv` version
// truncated anything past one 4 KiB chunk. Re-suspending (rather than looping
// `recv` synchronously) keeps the read overlapped with the other futures in a
// `gather`/`race`. At most one pollable is live at a time (each step drops the
// previous before subscribing the next), so the socket has no child pollable
// when `tcp_close` runs.
function __fetch_drain(c: i32, acc: string): async.Future[string] {
    function resume(woken: i32): async.Future[string] {
        var dropped: i32 = wasm_pollable_drop(woken);
        var chunk: string = string_from_bytes_unchecked(tcp_recv(c, 4096));
        if (chunk.len() == 0) {
            tcp_close(c);
            return Ready(http_body(acc) + "");
        }
        return __fetch_drain(c, acc + chunk);
    }
    return Pending(tcp_pollable(c), resume);
}

// http_status(resp) — parse the numeric status code from an HTTP/1.1 response's
// status line (`HTTP/1.1 200 OK` → 200), or -1 if the response is empty or the
// status line is malformed. The code is the run of digits after the first space.
pub function http_status(resp: string): i32 {
    var sp: i32 = resp.index_of(" ");
    if (sp < 0) {
        return -1;
    }
    var i: i32 = sp + 1;
    var code: i32 = 0;
    var have: boolean = false;
    while (i < resp.len()) {
        var ch: i32 = resp[i] as i32;
        if (ch < 48 || ch > 57) {
            break;
        }
        code = code * 10 + (ch - 48);
        have = true;
        i = i + 1;
    }
    if (!have) {
        return -1;
    }
    return code;
}

// http_body(resp) — return the body of an HTTP response (everything
// after the first blank line `\r\n\r\n`), or "" if the response has no
// header/body separator. Does not interpret Content-Length / chunked
// encoding; it returns whatever followed the headers.
pub function http_body(resp: string): str {
    var sep: i32 = resp.index_of("\r\n\r\n");
    if (sep < 0) {
        return "";
    }
    return slice_unchecked(resp, sep + 4, resp.len());
}

// parse_ipv4(s) — parse a dotted-quad "a.b.c.d" into the network-byte-
// order i32 tcp_connect wants, or -1 if it isn't four 0..255 octets.
// No DNS — a literal address only.
pub function parse_ipv4(s: string): i32 {
    var octets: i32[] = [];
    var cur: i32 = 0;
    var have: boolean = false;
    var i: i32 = 0;
    while (i < s.len()) {
        var ch: i32 = s[i] as i32;
        if (ch == 46) { // '.'
            if (!have) { return -1; }
            octets = octets.append(cur);
            cur = 0;
            have = false;
        } else if (ch >= 48 && ch <= 57) {
            cur = cur * 10 + (ch - 48);
            if (cur > 255) { return -1; }
            have = true;
        } else {
            return -1;
        }
        i = i + 1;
    }
    if (!have) { return -1; }
    octets = octets.append(cur);
    if (octets.len() != 4) { return -1; }
    return ipv4(octets[0], octets[1], octets[2], octets[3]);
}

// (plat: Platform).fetch(host, port, path) — the capability-scoped outbound GET
// an edge handler reaches for: `plat.fetch("a.b.c.d", port, "/x")`. Routing
// outbound I/O through the `Platform` bag keeps the capability model
// (docs/PLATFORM-RESEARCH.md Rec §1) — a handler can only fetch through the
// platform it was handed. `host` is a literal IPv4. Returns the HTTP STATUS CODE
// (an i32, e.g. 200 / 404), or -1 on a parse / connect / malformed-response
// failure. For the response BODY, or to overlap several fetches, use
// `fetch_future` through `async.gather` / `async.race`. Blocking.
pub function (plat: Platform) fetch(host: string, port: i32, path: string): i32 {
    var h: i32 = parse_ipv4(host);
    if (h < 0) {
        return -1;
    }
    return http_status(fetch_get(h, port, path));
}

// get_url(url) — fetch a full `http://HOST[:PORT]/PATH` URL in one
// call: split the scheme / host / optional port / path and GET it,
// returning the raw response (use `http_body`). HOST must be a literal
// IPv4 (no DNS / TLS yet); the port defaults to 80; a missing path
// becomes "/". Returns "" on a malformed URL or a connect failure.
pub function get_url(url: string): string {
    // Require and strip the http:// scheme.
    var prefix: string = "http://";
    if (url.len() < prefix.len()) { return ""; }
    if (url[0 : prefix.len()] != prefix) { return ""; }
    var rest: str = slice_unchecked(url, prefix.len(), url.len());
    // authority is up to the first '/'; the rest (incl. the '/') is the path.
    var slash: i32 = rest.index_of("/");
    var authority: str = rest;
    var path: str = "/";
    if (slash >= 0) {
        authority = slice_unchecked(rest, 0, slash);
        path = slice_unchecked(rest, slash, rest.len());
    }
    // authority = HOST[:PORT].
    var host: str = authority;
    var port: i32 = 80;
    var colon: i32 = authority.index_of(":");
    if (colon >= 0) {
        host = slice_unchecked(authority, 0, colon);
        var portstr: str = slice_unchecked(authority, colon + 1, authority.len());
        port = 0;
        var i: i32 = 0;
        while (i < portstr.len()) {
            var ch: i32 = portstr[i] as i32;
            if (ch < 48 || ch > 57) { return ""; }
            port = port * 10 + (ch - 48);
            i = i + 1;
        }
        if (i == 0) { return ""; }
    }
    var h: i32 = parse_ipv4(host);
    if (h < 0) { return ""; }
    return fetch_get(h, port, path);
}
