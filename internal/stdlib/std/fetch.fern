// std/fetch — outbound HTTP/1.1 client (the upstream-fetch half of the
// edge-handler use case: docs/PLATFORM-RESEARCH.md Rec §1).
//
// A request is a value built from a URL (`get(url)`, `request(method,
// url)`, then `with_header`, `with_text`, `with_bytes`, `with_body`,
// `with_timeouts`, `with_limits`) and sent with `send(req)` from a program
// with a `main`, or through the platform a handler was handed
// (`plat.http(req)`, std/platform), which is the capability-scoped route: a
// handler can only fetch through the platform it was given, and a mock
// answers what the test canned instead of opening a socket.
//
// The answer is `Result[HttpResponse, FetchError]`: the status is data on
// the response (`ok_or_status()` turns a status outside 2xx into an
// `Err`), and `FetchError` is a closed sum over the phase that failed. The
// response is the same byte-bodied type the server side builds, headers
// case-folded by `HeaderMap` with the hop-by-hop fields stripped, a
// chunked body decoded and its trailers in `trailers`; `body_text()` is the
// checked UTF-8 read of a body that came off the wire, which may hold
// anything. The name is resolved by `std/dns` (a literal address, the
// hosts file, then DNS) and the addresses raced the way `dns.connect_race`
// does. Every phase is bounded by `Timeouts`. A 3xx with a `Location` is
// followed, ten hops by default, the credentials dropped when a hop
// leaves the origin; an idempotent request the peer resets before
// answering is sent once more. No TLS where the client dials (`https`
// fails with `Tls`). A connection whose response was framed and that the
// peer did not ask to close is kept in the transport's `Idle` pool, and
// the next idempotent request to the same host and port takes it rather
// than dialling; `send` keeps a pool for the one call (so a redirect back
// to the same origin reuses its connection) and closes it after, a caller
// holding a `Sockets` across `send_on` calls keeps one across them, and a
// host platform's `plat.http` keeps the platform's own, for as long as the
// platform lives (std/platform). A `wasm32-wasi-http` build dials nothing: the
// request goes to the host's wasi:http/outgoing-handler (std/wasi_http),
// which resolves the name, connects and speaks TLS, and everything above
// the transport is the same. Where the client dials, it reaches the
// network only through `Transport`: `send` and `plat.http` use the
// machine's (`sockets()`), and `send_on(tr, req, policy)` any other, which
// is how std/sim_fetch runs this client in virtual time.
// The client asks for `gzip` unless the caller wrote an `Accept-Encoding`
// of their own, and undoes the coding it asked for, so a caller sees the
// bytes the origin meant: the body cap bounds what the decoder may
// produce, and `Decoding`'s depth and ratio refuse a response that
// stacks codings or grew implausibly.
//
// The two routes differ in what they may reach. `plat.http` refuses a
// host that resolves to an address `net.is_global` does not admit
// (loopback, a private or link-local block, the cloud metadata address,
// an IPv4 one carried inside an IPv6 one), checked on the addresses the
// client is about to dial rather than on the name, so a record that
// rebinds is caught too; a handler's upstream URL may have come from a
// request, and the platform it runs on is not its to reach. `send` has no
// such rule. Both go through the forward proxy the environment names
// (`ProxyEnv`: the lowercase `http_proxy`, `no_proxy`, nothing under
// `REQUEST_METHOD`); the handler's route still resolves and checks the
// origin before handing a request to the proxy, so a deployment where
// only the proxy can resolve names reaches it through `send`. Neither
// route resolves an IPv4 address written as anything but four decimal
// octets. On wasi-http the host owns the network: its outbound policy
// is the rule for both routes, and the environment's proxy is the
// host's own to go through.
//
// A single `send` is a blocking request; overlapping several upstreams is
// `std/async`'s job — `fetch_future` returns an `async.Future[u8[]]` you
// fan out through `async.gather` / `async.race`, and their reads overlap
// on one thread.

import "std/string";
import "std/async";
import "std/time";
// std/tcp — tcp_recv_deadline, the recv-with-deadline primitive behind
// the inactivity and total timeouts, and `Recv`, what a transport's `read`
// answers.
import "std/tcp";
import "std/http";
import "std/headers";
import "std/url";
import "std/dns";
import "std/net";
import "std/base64";
import "std/deflate";
// std/wasi_http — the host's client a `wasm32-wasi-http` build sends
// through, the one target with no sockets of its own.
import "std/wasi_http";
import "core/int";

// ipv4(a, b, c, d) — pack a dotted-quad into the network-byte-order
// i32 that tcp_connect wants in sin_addr. ipv4(127,0,0,1) addresses
// loopback.
pub function ipv4(a: i32, b: i32, c: i32, d: i32): i32 {
  return a & 255 | (b & 255) << 8 | (c & 255) << 16 | (d & 255) << 24;
}

// ---------------------------------------------------------------------------
// Errors

// `Phase` — which bound a `Timeout` passed: `Connecting` for the connect
// timeout, `Inactivity` for the longest the client waits for the next
// byte of the response, `Total` for the whole request.
pub enum Phase { Connecting, Inactivity, Total }

// `FetchError` — why a request failed, by phase. `InvalidUrl` for a URL
// `std/url` cannot parse, with no scheme or host, with a scheme other
// than `http` and `https`, or whose path or query cannot stand on a
// request line; `InvalidRequest` for a method that is not a token, a
// header that cannot be written as one line, or a file body (a handler
// reads files through its bag, not through the client); `Dns` for a name
// that did not resolve; `Connect` for
// addresses that all failed; `Blocked` for a host that resolves to an
// address the route may not reach (`plat.http` and `net.is_global`);
// `Tls` for `https` (not supported yet);
// `Timeout` for a bound passed; `Protocol` for a response this client
// cannot read, with what was wrong; `Io` for a send or read the kernel
// refused; `Redirect` for a redirect the client would not follow: more
// hops than `Request.redirects`, a 3xx without a `Location`, or one that
// is not a URL; `BodyLimit` for a body past `HttpLimits.body`, decoded or
// not; `Decode` for a content coding the client could not undo: more
// codings than `Decoding.depth`, a body that is not gzip, or one grown
// past what `Decoding.ratio` allows, the message naming the allowance;
// `Cancelled` for a request whose task was cancelled while it waited to
// connect or for the next byte (docs/ASYNC.md §8), the wait answering
// `async.cancelled()`. `FetchError` is `http.ToResponse`, below.
pub enum FetchError {
  InvalidUrl(string),
  InvalidRequest(string),
  Dns(dns.DnsError),
  Connect(net.NetError),
  Blocked(string),
  Tls(string),
  Timeout(Phase),
  Protocol(string),
  Io(net.NetError),
  Redirect(string),
  BodyLimit,
  Decode(string),
  Host(string),
  Cancelled,
}

pub function (p: Phase) message(): string {
  match (p) {
    Connecting => {
      return "connecting";
    },
    Inactivity => {
      return "waiting for the response";
    },
    Total => {
      return "in all";
    }
  }
  return "";
}

pub function (e: FetchError) message(): string {
  match (e) {
    InvalidUrl(what) => {
      return "invalid URL: " + what;
    },
    InvalidRequest(what) => {
      return "invalid request: " + what;
    },
    Dns(d) => {
      return "resolve: " + d.message();
    },
    Connect(n) => {
      return "connect: " + n.message();
    },
    Tls(what) => {
      return "TLS: " + what;
    },
    Timeout(p) => {
      return "timed out " + p.message();
    },
    _ => {
      return __later_message(e);
    }
  }
  return "";
}

function __later_message(e: FetchError): string {
  match (e) {
    Protocol(what) => {
      return "protocol: " + what;
    },
    Io(n) => {
      return "i/o: " + n.message();
    },
    Blocked(what) => {
      return "blocked: " + what;
    },
    Redirect(what) => {
      return "redirect: " + what;
    },
    BodyLimit => {
      return "response body past its limit";
    },
    Decode(what) => {
      return "decode: " + what;
    },
    Host(what) => {
      return "host: " + what;
    },
    Cancelled => {
      return "cancelled";
    },
    _ => {
      return "";
    }
  }
  return "";
}

pub function (e: FetchError) to_string(): string {
  return e.message();
}

// A handler that fetches upstream fails with `?`: a timeout answers 504, a
// method, header or body the handler wrote that cannot go on the wire
// answers 500, and every other failure 502, an unparseable URL among them
// since it may have come off the request being served. The message is not
// sent, since it names upstream hosts and addresses.
impl http.ToResponse for FetchError {
  function to_response(self: FetchError): HttpResponse {
    match (self) {
      Timeout(_) => {
        return http.problem(504, "", "");
      },
      InvalidRequest(_) => {
        return http.problem(500, "", "");
      },
      _ => {
        return http.problem(502, "", "");
      }
    }
    return http.problem(502, "", "");
  }
}

// ---------------------------------------------------------------------------
// Requests

// `Timeouts` — the bounds on one request: `connect` on the connect (the
// whole address race), `inactivity` on the wait for the next byte of the
// response, `total` on the request from its start to the last byte read.
pub struct Timeouts { connect: Duration, inactivity: Duration, total: Duration }

// `timeouts()` — ten seconds to connect, thirty between bytes, sixty in
// all.
pub function timeouts(): Timeouts {
  return Timeouts { connect: time.duration_seconds(10 as i64), inactivity: time.duration_seconds(30 as i64), total: time.duration_seconds(60 as i64) };
}

// `Request` — what `send` sends: the method, the URL, the headers
// (end-to-end ones; the client writes `Host`, `Content-Length` and
// `Connection` itself), the body, the bounds on the response
// (`timeouts`, and `limits` for its size: the body cap is
// `limits.body`, the status line is capped by `limits.request_line`),
// and `redirects`, the most 3xx hops `send` follows (0 answers the 3xx
// as data).
pub struct Request { method: string, url: string, headers: HeaderMap, body: Body, timeouts: Timeouts, limits: http.HttpLimits, redirects: i32, decoding: Decoding }

// `Decoding` — what the client undoes in a response body: `depth`, how
// many content codings it undoes (each one `gzip`), 0 for none, and then
// it asks for none either; `ratio`, the most the decoded body may exceed
// its encoded size, as a multiple, judged on the response as a whole once
// every coding is undone. A decoded body of 64 KiB or less is never
// refused on the ratio: a small body compresses far past any plausible
// ratio (a run of zeros a thousandfold), and the cap already bounds it.
// A `ratio` of 0 or less admits only that much. A body refused names
// the allowance that refused it, so a caller sees which bound applied.
// The decoder never produces more than `limits.body` bytes whatever the
// ratio says, so the ratio is a policy on a response's shape, not what
// bounds memory.
pub struct Decoding { depth: i32, ratio: i32 }

// What the ratio never refuses: a decoded body of this many bytes or
// fewer.
const RATIO_FLOOR: i32 = 65536;

// `decoding()` — one coding undone, a body allowed to grow a hundredfold.
pub function decoding(): Decoding {
  return Decoding { depth: 1, ratio: 100 };
}

// `request(method, url)` — a request with no headers and no body, the
// default bounds, ten redirects and the default decoding.
pub function request(method: string, url: string): Request {
  let none: u8[] = [];
  return Request { method: method, url: url, headers: headers.header_map_new(), body: BodyBytes(none), timeouts: timeouts(), limits: http.http_limits(), redirects: 10, decoding: decoding() };
}

// `get(url)` — `request("GET", url)`.
pub function get(url: string): Request {
  return request("GET", url);
}

// `(r: Request).with_header(name, value)` — `r` with the field appended.
pub function (r: Request) with_header(name: string, value: string): Request {
  return Request { ...r, headers: r.headers.append(name, value) };
}

// `(r: Request).with_body(body)` — `r` with `body` as its body: text,
// bytes, a stream or chunks. A `BodyFile` is refused by `send` with
// `InvalidRequest`: the client never reads a file.
pub function (r: Request) with_body(body: Body): Request {
  return Request { ...r, body: body };
}

// `(r: Request).with_text(s)` — `r` with `s` as its body.
pub function (r: Request) with_text(s: string): Request {
  return Request { ...r, body: BodyText(s) };
}

// `(r: Request).with_bytes(bs)` — `r` with `bs` as its body.
pub function (r: Request) with_bytes(bs: u8[]): Request {
  return Request { ...r, body: BodyBytes(bs) };
}

// `(r: Request).with_timeouts(t)` — `r` bounded by `t`.
pub function (r: Request) with_timeouts(t: Timeouts): Request {
  return Request { ...r, timeouts: t };
}

// `(r: Request).with_limits(l)` — `r` with the response capped by `l`.
pub function (r: Request) with_limits(l: http.HttpLimits): Request {
  return Request { ...r, limits: l };
}

// `(r: Request).with_redirects(hops)` — `r` following at most `hops`
// redirects; 0 answers a 3xx as the response it is.
pub function (r: Request) with_redirects(hops: i32): Request {
  return Request { ...r, redirects: hops };
}

// `(r: Request).with_decoding(d)` — `r` undoing content codings as `d`
// says; `Decoding { depth: 0, ... }` asks for none and undoes none.
pub function (r: Request) with_decoding(d: Decoding): Request {
  return Request { ...r, decoding: d };
}

// `(r: HttpResponse).ok_or_status()` — `Ok(r)` for a 2xx status, else
// `Err(status)`: for a caller that treats anything else as a failure.
pub function (r: HttpResponse) ok_or_status(): Result[HttpResponse, i32] {
  if (r.status >= 200 && r.status < 300) {
    return Ok(r);
  }
  return Err(r.status);
}

// ---------------------------------------------------------------------------
// Sending

// Where a request goes: the host and port to dial, the request-target
// for the request line, the `Host` value (the origin's, whichever is
// dialled), the `Proxy-Authorization` to write (empty for none), whether
// the origin itself is dialled, and the origin's host either way.
struct __Target { host: string, port: i32, target: string, host_field: string, proxy_auth: string, direct: boolean, origin: string, tls: boolean }

// `__target_of(url, policy)` — the URL split for the wire, or why it
// cannot be: through the proxy the environment names for it, as the
// absolute-form target a proxy forwards (RFC 9112 §3.2.2), else straight
// to the origin.
function __target_of(raw: string, policy: Policy): Result[__Target, FetchError] {
  let u: Url = __http_url(raw)?;
  let port: i32 = __effective_port(u);
  let tls: boolean = u.scheme == "https";
  let host_field: string = __host_field(u.host, port, tls);
  let target: string = __request_target(u)?;
  match (policy.proxies.proxy_for(raw)) {
    Some(spec) => {
      let p: __Proxy = __proxy_of(spec)?;
      return Ok(__Target { host: p.host, port: p.port, target: "http://" + host_field + target, host_field: host_field, proxy_auth: p.auth, direct: false, origin: u.host, tls: tls });
    },
    None => {}
  }
  return Ok(__Target { host: u.host, port: port, target: target, host_field: host_field, proxy_auth: "", direct: true, origin: u.host, tls: tls });
}

// `__host_tls()` — whether a host speaks TLS for this client: the
// wasi-http host does, and no other target has TLS yet.
function __host_tls(): boolean {
  return target_os() == "wasi-http";
}

// `__http_url(raw)` — `raw` parsed, when it is an `http` URL naming a
// host this client dials. An IPv4 address is four decimal octets or
// nothing: `2130706433`, `0177.0.0.1` and `127.1` each read as loopback
// to some resolvers and as a name to others, and an address that reads
// two ways is how a block list is bypassed.
function __http_url(raw: string): Result[Url, FetchError] {
  let u: Url = Url { scheme: "", host: "", port: 0, path: "", query: "", fragment: "" };
  match (url.url_parse(raw)) {
    Some(parsed) => {
      u = parsed;
    },
    None => {
      return Err(InvalidUrl(raw));
    }
  }
  if (u.scheme == "https" && !__host_tls()) {
    return Err(Tls("https is not supported on this target"));
  }
  if (u.scheme.len() == 0) {
    return Err(InvalidUrl("no scheme in " + raw));
  }
  if (u.scheme != "http" && u.scheme != "https") {
    return Err(InvalidUrl("scheme " + u.scheme + " is not http"));
  }
  if (u.host.len() == 0) {
    return Err(InvalidUrl("no host in " + raw));
  }
  if (__ambiguous_ipv4(u.host)) {
    return Err(InvalidUrl("an IPv4 address that is not four decimal octets"));
  }
  return Ok(u);
}

// `__ambiguous_ipv4(host)` — a host whose last label starts with a digit
// (no top-level domain does) and that is not a dotted quad: a number a
// resolver may read as an address.
function __ambiguous_ipv4(host: string): boolean {
  if (host.index_of(":") >= 0) {
    return false;
  }
  let end: i32 = host.len();
  if (end > 0 && host[end - 1] == 46) {
    end = end - 1;
  }
  let start: i32 = slice_unchecked(host, 0, end).to_owned().last_index_of(".") + 1;
  if (start >= end || host[start] < 48 || host[start] > 57) {
    return false;
  }
  match (net.ipv4_parse(host)) {
    Some(a) => {
      return false;
    },
    None => {
      return true;
    }
  }
  return true;
}

// `__request_target(u)` — the origin-form request-target of `u`: its
// path (`/` for none) and query, when they can stand on a request line.
function __request_target(u: Url): Result[string, FetchError] {
  let target: string = u.path;
  if (target.len() == 0) {
    target = "/";
  }
  if (u.query.len() > 0) {
    target = target + "?" + u.query;
  }
  if (!http.http_target_ok(target)) {
    return Err(InvalidUrl("a path or query that cannot be written on a request line"));
  }
  return Ok(target);
}

// `__request_ok(req)` — the request refused before a byte is written when
// its method or a header could not be put on the wire as one line, or
// its body is a file. The messages name the rule and never the value,
// which may be the injected bytes themselves.
function __request_ok(req: Request): Result[void, FetchError] {
  if (!http.http_method_ok(req.method)) {
    return Err(InvalidRequest("the method is not a token"));
  }
  let i: i32 = 0;
  while (i < req.headers.names.len()) {
    if (!http.http_field_name_ok(req.headers.names[i])) {
      return Err(InvalidRequest("a header name is not a token"));
    }
    if (!http.http_field_value_ok(req.headers.values[i])) {
      return Err(InvalidRequest("a header value has a byte that cannot be written"));
    }
    i = i + 1;
  }
  match (req.body) {
    BodyFile(path) => {
      return Err(InvalidRequest("a file body cannot be sent"));
    },
    _ => {}
  }
  return Ok(());
}

// `__host_field(host, port, tls)` — the `Host` value: the host, bracketed when
// it is an IPv6 address, and the port when it is not the scheme's default.
function __host_field(host: string, port: i32, tls: boolean): string {
  let h: string = host;
  if (h.index_of(":") >= 0) {
    h = "[" + h + "]";
  }
  let default_port: i32 = 80;
  if (tls) {
    default_port = 443;
  }
  if (port != default_port) {
    return h + ":" + int.int_to_string(port);
  }
  return h;
}

// `__head(req, t, body_len)` — the request line and header block: the
// caller's end-to-end fields, then what the client decides.
function __head(req: Request, t: __Target, body_len: i32): string {
  let out: string = req.method + " " + t.target + " HTTP/1.1\r\n" + "Host: " + t.host_field + "\r\n";
  let fields: HeaderMap = __sent_fields(req, t, body_len);
  let i: i32 = 0;
  while (i < fields.names.len()) {
    out = out + fields.names[i] + ": " + fields.values[i] + "\r\n";
    i = i + 1;
  }
  return out + "\r\n";
}

// `__sent_fields(req, t, body_len)` — the fields a request carries
// beyond `Host`: the caller's end-to-end ones (`Host` and
// `Content-Length` are the client's to write), then the ones the client
// decides: the body's length (always for a method that usually carries
// one), the `Accept-Encoding: gzip` it undoes itself, and the proxy's
// credentials when the caller wrote none.
function __sent_fields(req: Request, t: __Target, body_len: i32): HeaderMap {
  let out: HeaderMap = __without(http.http_end_to_end(req.headers), ["host", "content-length"]);
  if (body_len > 0 || req.method == "POST" || req.method == "PUT" || req.method == "PATCH") {
    out = out.append("content-length", int.int_to_string(body_len));
  }
  if (__asks_gzip(req)) {
    out = out.append("accept-encoding", "gzip");
  }
  if (t.proxy_auth.len() > 0 && !__holds(req.headers.names, "proxy-authorization")) {
    out = out.append("proxy-authorization", t.proxy_auth);
  }
  return out;
}

// `__asks_gzip(req)` — whether the client writes `Accept-Encoding: gzip`
// for `req`, and so undoes the coding: a depth above 0 and no
// `Accept-Encoding` of the caller's own, whose codings are theirs to undo.
function __asks_gzip(req: Request): boolean {
  return req.decoding.depth > 0 && !__holds(req.headers.names, "accept-encoding");
}

// `Transport` — the I/O the dialled route does, behind one seam: the
// clock its bounds are measured on, name lookup, connecting, and reading
// and writing a connection by the number `connect` handed out. `Sockets`
// is the machine's; std/sim_fetch scripts one in virtual time. Every
// policy the client applies (the block list, the bounds, retrying a
// reset, following a redirect, decoding) stays above the seam, so a
// scripted transport exercises exactly what a real one would.
//
// `connect` races `addrs` as `dns.connect_race` does: a bound that has
// already passed is `TimedOut` before any attempt, every address refusing
// is the last refusal, and none connected within the bound is `TimedOut`.
// `read` answers within `wait_ms` as `tcp_recv_deadline` does: a chunk, an
// empty chunk at the end of the stream, `Elapsed` when the wait passed with
// nothing, or `Abandoned` when the task reading was cancelled first, which
// the client reports as `Cancelled`. `write` answers
// the bytes taken, or a negated errno. `idle` is the transport's pool of
// connections kept for reuse; the client decides what goes in and comes
// out of it.
pub trait Transport {
  function now_ns(self: Self): i64;
  function lookup(self: Self, host: string, checked: boolean): Result[Lookup, dns.DnsError];
  function connect(self: Self, addrs: net.IpAddr[], port: i32, timeout_ms: i32): Result[i32, net.NetError];
  function write(self: Self, conn: i32, data: u8[]): i32;
  function read(self: Self, conn: i32, max: i32, wait_ms: i64): tcp.Recv;
  function close(self: Self, conn: i32): i32;
  function idle(self: Self): Idle;
}

// `Idle` — the connections a transport keeps for the next request to the
// same place: at most `max` of them, none reused once idle past `idle_ms`.
// A cell holds only a scalar or a string, so `rows` is the table, a
// connection a line of its key, number and the nanosecond it went idle.
pub struct Idle { rows: Cell[string], max: i32, idle_ms: i32 }

// `idle()` — an empty pool keeping up to 64 connections, each for 90 s
// (Go's `IdleConnTimeout`).
pub function idle(): Idle {
  return idle_limited(64, 90000);
}

// `idle_limited(max, idle_ms)` — an empty pool keeping up to `max`
// connections, each for `idle_ms`; a `max` of 0 keeps none.
pub function idle_limited(max: i32, idle_ms: i32): Idle {
  return Idle { rows: cell_new(""), max: max, idle_ms: idle_ms };
}

// `close_idle(tr)` — every connection `tr` keeps for reuse closed.
pub function close_idle[T: Transport](tr: T): void {
  let pool: Idle = tr.idle();
  for row in __idle_rows(pool) {
    tr.close(__idle_conn(row));
  }
  pool.rows.set("");
}

// `__pool_key(t, guard)` — where a connection reaches: the host and port
// dialled, and whether the block list judged the addresses, so a
// connection the open route made is never handed to the guarded one.
function __pool_key(t: __Target, guard: boolean): string {
  let route: string = "open ";
  if (guard) {
    route = "global ";
  }
  return route + t.host + " " + int.int_to_string(t.port);
}

// `__take_idle(tr, key)` — the connection to `key` kept last, taken out
// of the pool, or -1; any connection idle past the pool's bound is closed
// on the way.
function __take_idle[T: Transport](tr: T, key: string): i32 {
  let rows: string[] = __live_rows(tr);
  let pick: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < rows.len()) {
    if (__idle_key(rows[i]) == key) {
      pick = i;
    }
    i = i + 1;
  }
  if (pick < 0) {
    return 0 - 1;
  }
  tr.idle().rows.set(__idle_joined(rows, pick));
  return __idle_conn(rows[pick]);
}

// `__park(tr, key, conn)` — `conn` kept for the next request to `key`, the
// longest-idle connections closed while the pool holds more than its
// `max`.
function __park[T: Transport](tr: T, key: string, conn: i32): void {
  let rows: string[] = __live_rows(tr).append(key + "\t" + int.int_to_string(conn) + "\t" + tr.now_ns().to_string());
  let from: i32 = 0;
  while (rows.len() - from > tr.idle().max) {
    tr.close(__idle_conn(rows[from]));
    from = from + 1;
  }
  let kept: string[] = [];
  while (from < rows.len()) {
    kept = kept.append(rows[from]);
    from = from + 1;
  }
  tr.idle().rows.set(__idle_joined(kept, 0 - 1));
}

// `__live_rows(tr)` — the pool's connections still inside its idle bound,
// oldest first; the rest closed and dropped from the pool.
function __live_rows[T: Transport](tr: T): string[] {
  let pool: Idle = tr.idle();
  let now: i64 = tr.now_ns();
  let bound: i64 = pool.idle_ms as i64 * 1000000;
  let out: string[] = [];
  for row in __idle_rows(pool) {
    if (now - __idle_since(row) > bound) {
      tr.close(__idle_conn(row));
    } else {
      out = out.append(row);
    }
  }
  pool.rows.set(__idle_joined(out, 0 - 1));
  return out;
}

function __idle_rows(pool: Idle): string[] {
  let out: string[] = [];
  for row in pool.rows.get().split("\n") {
    if (row.len() > 0) {
      out = out.append(row);
    }
  }
  return out;
}

// `__idle_joined(rows, skip)` — `rows` as the pool's table, row `skip`
// left out.
function __idle_joined(rows: string[], skip: i32): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < rows.len()) {
    if (i != skip) {
      out = out + rows[i] + "\n";
    }
    i = i + 1;
  }
  return out;
}

function __idle_key(row: string): string {
  return row.split("\t")[0];
}

function __idle_conn(row: string): i32 {
  match (int.parse_int_radix(row.split("\t")[1], 10)) {
    Some(n) => {
      return n;
    },
    None => {
      return 0 - 1;
    }
  }
  return 0 - 1;
}

function __idle_since(row: string): i64 {
  let v: i64 = 0;
  for b in row.split("\t")[2].bytes() {
    v = v * 10 + (b as i64 - 48);
  }
  return v;
}

// `Lookup` — a name's addresses: `dial` the ones to connect to, and, when
// the lookup is `checked` for the block list, `named` the ones the network
// returned with `judged[i]` the address `named[i]` carries (itself, or
// the IPv4 one under a NAT64 prefix), which the block list judges.
pub struct Lookup { dial: net.IpAddr[], named: net.IpAddr[], judged: net.IpAddr[] }

// `Sockets` — the machine's transport: the system resolver, raced
// connects (`dns.connect_race`), TCP sockets read under a deadline, and
// the pool of the ones kept for reuse.
pub struct Sockets { pool: Idle }

// `sockets()` — the machine's transport with an empty `idle()` pool;
// `close_idle` closes what it kept.
pub function sockets(): Sockets {
  return sockets_with(idle());
}

// `sockets_with(pool)` — the machine's transport keeping connections in
// `pool`.
pub function sockets_with(pool: Idle): Sockets {
  return Sockets { pool: pool };
}

impl Transport for Sockets {
  function now_ns(self: Sockets): i64 {
    return monotonic_ns();
  }
  function lookup(self: Sockets, host: string, checked: boolean): Result[Lookup, dns.DnsError] {
    let none: net.IpAddr[] = [];
    if (!checked) {
      let found: net.IpAddr[] = dns.resolve(host)?;
      return Ok(Lookup { dial: found, named: none, judged: none });
    }
    let plain: net.IpAddr[] = dns.resolve_plain(host)?;
    let carried: net.IpAddr[] = [];
    for a in plain {
      match (dns.nat64_carried(a)) {
        Some(v4) => {
          carried = carried.append(v4);
        },
        None => {
          carried = carried.append(a);
        }
      }
    }
    return Ok(Lookup { dial: dns.synthesized(plain), named: plain, judged: carried });
  }
  function connect(self: Sockets, addrs: net.IpAddr[], port: i32, timeout_ms: i32): Result[i32, net.NetError] {
    return dns.connect_race(addrs, port, dns.DialOptions { ...dns.dial_options(), timeout: time.duration_millis(timeout_ms as i64) });
  }
  function write(self: Sockets, conn: i32, data: u8[]): i32 {
    return tcp_send_bytes(conn, data);
  }
  function read(self: Sockets, conn: i32, max: i32, wait_ms: i64): tcp.Recv {
    return tcp.tcp_recv_deadline(conn, max, time.duration_millis(wait_ms));
  }
  function close(self: Sockets, conn: i32): i32 {
    tcp_close(conn);
    return 0;
  }
  function idle(self: Sockets): Idle {
    return self.pool;
  }
}

// `send(req)` — the request sent and its response read, as the module
// comment says: a 3xx with a `Location` is followed up to
// `req.redirects` hops, all under the one total bound. Blocking: every
// connection is closed before it answers.
pub function send(req: Request): Result[HttpResponse, FetchError] {
  return __send_closing(Policy { public_only: false, proxies: __proxies() }, req);
}

// `send_public(req)` — `send`, refusing a host that resolves to an address
// that is not global (`Blocked`), since a handler reaches only what the
// deployment exposes publicly. A proxy the environment names is dialled
// wherever it is.
pub function send_public(req: Request): Result[HttpResponse, FetchError] {
  return __send_closing(Policy { public_only: true, proxies: __proxies() }, req);
}

// `send_public_on(tr, req)` — `send_public` over the transport `tr`, whose
// pool keeps the connection for the next request: the route a handler's
// platform fetches through (std/platform), the pool the platform's own.
pub function send_public_on[T: Transport](tr: T, req: Request): Result[HttpResponse, FetchError] {
  return send_on(tr, req, Policy { public_only: true, proxies: __proxies() });
}

// `__send_closing(policy, req)` — `req` sent over the machine's transport
// with a pool for this one call, closed once it answers. On wasi-http the
// host dials and nothing is kept; the `else` arm is what the fold drops,
// so that build reaches no socket.
function __send_closing(policy: Policy, req: Request): Result[HttpResponse, FetchError] {
  let tr: Sockets = sockets();
  if (target_os() == "wasi-http") {
    return send_on(tr, req, policy);
  } else {
    let answer: Result[HttpResponse, FetchError] = send_on(tr, req, policy);
    close_idle(tr);
    return answer;
  }
}

// `__proxies()` — the environment's proxy configuration where this
// client dials: none on wasi-http, where the host dials and a proxy is
// the host's own to go through. The `else` arm is what the fold drops,
// so a wasi-http build imports no configuration store for it.
function __proxies(): ProxyEnv {
  if (target_os() == "wasi-http") {
    return ProxyEnv { http_proxy: "", no_proxy: "" };
  } else {
    return proxy_env();
  }
}

// `Policy` — what a route may reach: `public_only` refuses a host that
// resolves to an address `net.is_global` does not admit; `proxies` is the
// proxy configuration, which `send` and `plat.http` read from the
// environment once per request.
pub struct Policy { public_only: boolean, proxies: ProxyEnv }

// `send_on(tr, req, policy)` — `send` over the transport `tr` under
// `policy`: every connection, read and clock reading of the dialled route
// is `tr`'s, so a scripted transport (std/sim_fetch) runs the whole client
// in virtual time. A wasi-http build hands the request to the host and
// never asks `tr`.
pub function send_on[T: Transport](tr: T, req: Request, policy: Policy): Result[HttpResponse, FetchError] {
  let started: i64 = tr.now_ns();
  let cur: Request = req;
  let hops: i32 = 0;
  while (true) {
    let resp: HttpResponse = __send_once(tr, cur, started, policy)?;
    if (!__redirects(resp.status) || req.redirects == 0) {
      return Ok(resp);
    }
    if (hops >= req.redirects) {
      return Err(Redirect("more than " + int.int_to_string(req.redirects) + " redirects"));
    }
    hops = hops + 1;
    cur = __next_hop(cur, resp)?;
  }
  return Err(Redirect("unreachable"));
}

// `__redirects(status)` — whether a status sends the client elsewhere:
// 301, 302, 303, 307 and 308 (RFC 9110 §15.4).
function __redirects(status: i32): boolean {
  return status == 301 || status == 302 || status == 303 || status == 307 || status == 308;
}

// `__next_hop(cur, resp)` — the request for `resp`'s `Location`: the
// method and body kept on a 307 and 308, a GET with no body on a 303 and
// on a 301 or 302 answering a POST (RFC 9110 §15.4), and the credentials
// (`Authorization`, `Proxy-Authorization`, `Cookie`) dropped when the hop
// leaves the origin. `Host` is written per hop by the client.
function __next_hop(cur: Request, resp: HttpResponse): Result[Request, FetchError] {
  let location: string = "";
  match (resp.headers.get("location")) {
    Some(l) => {
      location = l;
    },
    None => {
      return Err(Redirect("a " + int.int_to_string(resp.status) + " without a Location"));
    }
  }
  let target: string = "";
  match (url.url_resolve(cur.url, location)) {
    Some(t) => {
      target = t;
    },
    None => {
      return Err(Redirect("a Location that is not a URL"));
    }
  }
  let next: Request = Request { ...cur, url: target };
  if (__rewrites_to_get(resp.status, cur.method)) {
    let none: u8[] = [];
    next = Request { ...next, method: "GET", body: BodyBytes(none), headers: __without(next.headers, ["content-type", "content-length"]) };
  }
  if (!__same_origin(cur.url, target)) {
    next = Request { ...next, headers: __without(next.headers, ["authorization", "proxy-authorization", "cookie"]) };
  }
  return Ok(next);
}

// `__rewrites_to_get(status, method)` — whether the hop becomes a GET
// without the body: a 303 for anything but HEAD, and a 301 or 302
// answering a POST, as browsers do (RFC 9110 §15.4.2 to §15.4.4).
function __rewrites_to_get(status: i32, method: string): boolean {
  if (status == 303) {
    return method != "HEAD";
  }
  return (status == 301 || status == 302) && method == "POST";
}

// `__without(h, names)` — `h` less the fields named (case-folded names).
function __without(h: HeaderMap, names: string[]): HeaderMap {
  let out: HeaderMap = headers.header_map_new();
  let i: i32 = 0;
  while (i < h.names.len()) {
    if (!__holds(names, h.names[i])) {
      out = out.append(h.names[i], h.values[i]);
    }
    i = i + 1;
  }
  return out;
}

function __holds(names: string[], name: string): boolean {
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

// `__same_origin(a, b)` — whether two URLs share scheme, host (ASCII
// case-folded) and effective port, the origin a credential is scoped to.
function __same_origin(a: string, b: string): boolean {
  let ua: Url = Url { scheme: "", host: "", port: 0, path: "", query: "", fragment: "" };
  let ub: Url = ua;
  match (url.url_parse(a)) {
    Some(p) => {
      ua = p;
    },
    None => {
      return false;
    }
  }
  match (url.url_parse(b)) {
    Some(p) => {
      ub = p;
    },
    None => {
      return false;
    }
  }
  return ua.scheme.to_lower() == ub.scheme.to_lower() && ua.host.to_lower() == ub.host.to_lower() && __effective_port(ua) == __effective_port(ub);
}

function __effective_port(u: Url): i32 {
  if (u.port != 0) {
    return u.port;
  }
  if (u.scheme == "https") {
    return 443;
  }
  return 80;
}

// `__send_once(tr, req, started, policy)` — one hop: the request validated,
// then sent by the transport the target has. A wasi-http build has no
// sockets and hands the request to the host's client; every other
// target dials the origin itself. The branch is on the target's name, a
// literal by the time anything is emitted, so each build carries one
// transport.
function __send_once[T: Transport](tr: T, req: Request, started: i64, policy: Policy): Result[HttpResponse, FetchError] {
  let t: __Target = __target_of(req.url, policy)?;
  match (__request_ok(req)) {
    Ok(_) => {},
    Err(e) => {
      return Err(e);
    }
  }
  if (target_os() == "wasi-http") {
    return __send_hosted(req, t);
  } else {
    return __send_dialled(tr, req, t, started, policy);
  }
}

// `__send_dialled(tr, req, t, started, policy)` — the request on a
// connection this client opens: its origin resolved and checked when the
// route reaches global addresses only and a proxy carries the request
// (the proxy's address is the deployment's choice and goes unchecked),
// then sent and its response read, and sent once more on a new
// connection when the peer reset the connection before any response byte
// and the method is idempotent (RFC 9110 §9.2.2): a reset before an
// answer says nothing happened, which is also how a kept connection the
// peer has since closed answers, and another kept connection to the same
// place is as likely closed.
function __send_dialled[T: Transport](tr: T, req: Request, t: __Target, started: i64, policy: Policy): Result[HttpResponse, FetchError] {
  __origin_checked(tr, t, policy)?;
  let guard: boolean = policy.public_only && t.direct;
  let first: Result[HttpResponse, FetchError] = __attempt(tr, req, t, started, guard, true);
  match (first) {
    Err(e) => {
      if (__reset(e) && http.http_method_idempotent(req.method)) {
        return __attempt(tr, req, t, started, guard, false);
      }
      return Err(e);
    },
    Ok(resp) => {
      return Ok(resp);
    }
  }
  return first;
}

// `__origin_checked(tr, t, policy)` — on the route that reaches global
// addresses only, the origin a proxy will reach for `t` resolved and
// checked, as `__connect` checks a host it dials itself; nothing when
// the origin is dialled directly or the route has no such rule.
function __origin_checked[T: Transport](tr: T, t: __Target, policy: Policy): Result[void, FetchError] {
  if (policy.public_only && !t.direct) {
    let checked: net.IpAddr[] = __resolve(tr, t.origin, true)?;
  }
  return Ok(());
}

// `__reset(e)` — whether `e` is the peer dropping the connection before
// answering: a reset or abort on the socket, a broken pipe, or the close
// `__read_response` reports when no byte came.
function __reset(e: FetchError): boolean {
  match (e) {
    Io(n) => {
      return n.eq(net.ConnectionReset) || n.eq(net.ConnectionAborted) || n.eq(net.Other(32));
    },
    _ => {
      return false;
    }
  }
  return false;
}

// `__attempt(tr, req, t, started, guard, reuse)` — one connection: a kept
// one to the same place when `reuse` and the method is idempotent (one
// that is not may have been acted on by the time a closed kept connection
// shows itself, so it never risks one), else one opened (only to a global
// address when `guard`); the request written, the response read, and the
// connection kept when the response left it reusable, closed otherwise.
function __attempt[T: Transport](tr: T, req: Request, t: __Target, started: i64, guard: boolean, reuse: boolean): Result[HttpResponse, FetchError] {
  let key: string = __pool_key(t, guard);
  let conn: i32 = 0 - 1;
  if (reuse && http.http_method_idempotent(req.method)) {
    conn = __take_idle(tr, key);
  }
  if (conn < 0) {
    conn = __connect(tr, t, req.timeouts, guard)?;
  }
  let body: u8[] = req.body.bytes();
  let sent: Result[void, FetchError] = __send_all(tr, conn, __head(req, t, body.len()).bytes().concat(body));
  match (sent) {
    Ok(_) => {},
    Err(e) => {
      tr.close(conn);
      return Err(e);
    }
  }
  match (__read_response(tr, conn, req, started)) {
    Ok(read) => {
      if (read.keep) {
        __park(tr, key, conn);
      } else {
        tr.close(conn);
      }
      return __decoded(read.response, req);
    },
    Err(e) => {
      tr.close(conn);
      return Err(e);
    }
  }
  return Err(Protocol("unreachable"));
}

// `__connect(tr, t, timeouts, guard)` — a connection to the host,
// resolved and raced under the connect bound; with `guard`, refused
// before the race when any address resolved is not a global one.
function __connect[T: Transport](tr: T, t: __Target, timeouts: Timeouts, guard: boolean): Result[i32, FetchError] {
  let addrs: net.IpAddr[] = __resolve(tr, t.host, guard)?;
  match (tr.connect(addrs, t.port, __connect_bound(timeouts).as_millis() as i32)) {
    Ok(conn) => {
      return Ok(conn);
    },
    Err(e) => {
      if (e.eq(net.TimedOut)) {
        return Err(Timeout(Connecting));
      }
      if (e.eq(net.Interrupted)) {
        return Err(FetchError.Cancelled);
      }
      return Err(Connect(e));
    }
  }
  return Err(Timeout(Connecting));
}

// `__connect_bound(timeouts)` — the connect bound, never past the total.
function __connect_bound(timeouts: Timeouts): Duration {
  if (timeouts.total.as_nanos() < timeouts.connect.as_nanos()) {
    return timeouts.total;
  }
  return timeouts.connect;
}

// `__resolve(tr, host, guard)` — the addresses of `host` as `tr` reaches
// them; with `guard`, refused as `Blocked` when any of them, as the
// network names it before NAT64 synthesis, is not a global address.
function __resolve[T: Transport](tr: T, host: string, guard: boolean): Result[net.IpAddr[], FetchError] {
  match (tr.lookup(host, guard)) {
    Ok(found) => {
      if (guard) {
        __global_only(found)?;
      }
      return Ok(found.dial);
    },
    Err(e) => {
      return Err(Dns(e));
    }
  }
  return Err(Dns(dns.NoData));
}

// `__global_only(found)` — the refusal naming the first address the
// network named that is not a global one, judged by the address it
// carries when it sits under a NAT64 prefix.
function __global_only(found: Lookup): Result[void, FetchError] {
  let i: i32 = 0;
  while (i < found.named.len()) {
    if (!found.judged[i].is_global()) {
      return Err(Blocked(found.named[i].to_string() + " is not a global address"));
    }
    i = i + 1;
  }
  return Ok(());
}

// `__send_hosted(req, t)` — the request handed to the wasi-http host's
// client (std/wasi_http): the host resolves the name, dials and speaks
// TLS, under the connect and inactivity bounds (`request-options` has
// no total bound). Both routes reach what the host lets them: the host
// resolves names and owns the network, so its outbound policy is the
// rule there, and this client's block list does not apply.
function __send_hosted(req: Request, t: __Target): Result[HttpResponse, FetchError] {
  let body: u8[] = req.body.bytes();
  let o: wasi_http.Outgoing = wasi_http.Outgoing { method: req.method, authority: t.host_field, tls: t.tls, target: t.target, headers: __sent_fields(req, t, body.len()), body: body, connect: __connect_bound(req.timeouts), inactivity: req.timeouts.inactivity, body_cap: req.limits.body };
  match (wasi_http.outgoing(o)) {
    Ok(resp) => {
      return __decoded(HttpResponse { ...resp, headers: http.http_end_to_end(resp.headers) }, req);
    },
    Err(e) => {
      return Err(__hosted_error(e));
    }
  }
  return Err(FetchError.Cancelled);
}

// `__hosted_error(e)` — the host's refusal as this client's error.
function __hosted_error(e: wasi_http.OutgoingError): FetchError {
  match (e) {
    Code(code) => {
      return __host_code(code);
    },
    Field(name) => {
      return InvalidRequest("a field the host refuses to carry: " + name);
    },
    BodyPastCap => {
      return BodyLimit;
    },
    CutShort => {
      return Protocol("the response ended before it was complete");
    },
    Lost => {
      return Protocol("the host gave no response");
    }
  }
  return FetchError.Cancelled;
}

// `__host_code(code)` — a wasi:http `error-code` case as the phase it
// failed in, read by its position in the WIT's declaration order.
function __host_code(code: i32): FetchError {
  if (code < 3) {
    return __host_dns_code(code);
  }
  if (code < 12) {
    return __host_connect_code(code);
  }
  if (code < 15) {
    return __host_tls_code(code);
  }
  if (code < 25) {
    return __host_request_code(code);
  }
  if (code < 33) {
    return __host_response_code(code);
  }
  return __host_late_code(code);
}

// `DNS-timeout`, `DNS-error`, `destination-not-found`.
function __host_dns_code(code: i32): FetchError {
  if (code == 0) {
    return Dns(dns.NoReply);
  }
  if (code == 1) {
    return Dns(dns.ServerFailure);
  }
  return Dns(dns.NoSuchName);
}

// `destination-unavailable` to `connection-limit-reached`.
function __host_connect_code(code: i32): FetchError {
  if (code == 3) {
    return Connect(net.HostUnreachable);
  }
  if (code == 4) {
    return Blocked("an address the host refuses to reach");
  }
  if (code == 5) {
    return Connect(net.NetworkUnreachable);
  }
  if (code == 6) {
    return Connect(net.ConnectionRefused);
  }
  if (code == 7) {
    return Io(net.ConnectionReset);
  }
  if (code == 8) {
    return Timeout(Connecting);
  }
  if (code < 11) {
    return Timeout(Inactivity);
  }
  return Host("the connection limit was reached");
}

// `TLS-protocol-error`, `TLS-certificate-error`, `TLS-alert-received`.
function __host_tls_code(code: i32): FetchError {
  if (code == 12) {
    return Tls("a protocol error");
  }
  if (code == 13) {
    return Tls("the certificate was refused");
  }
  return Tls("an alert was received");
}

// `HTTP-request-denied` to `HTTP-request-trailer-size`: what the host
// would not send.
function __host_request_code(code: i32): FetchError {
  if (code == 15) {
    return Host("the request was denied");
  }
  if (code == 16) {
    return InvalidRequest("the host requires a length");
  }
  if (code == 17) {
    return InvalidRequest("the body is larger than the host sends");
  }
  if (code == 18) {
    return InvalidRequest("the method is not one the host sends");
  }
  if (code < 21) {
    return InvalidUrl("not one the host sends");
  }
  return InvalidRequest("the fields are larger than the host sends");
}

// `HTTP-response-incomplete` to `HTTP-response-content-coding`: what
// the host could not read.
function __host_response_code(code: i32): FetchError {
  if (code == 25) {
    return Protocol("the response ended before it was complete");
  }
  if (code == 28) {
    return BodyLimit;
  }
  if (code == 31) {
    return Protocol("a transfer coding the host could not read");
  }
  if (code == 32) {
    return Decode("a content coding the host could not undo");
  }
  return Protocol("the response fields are larger than the host reads");
}

// `HTTP-response-timeout` to `internal-error`. The host's protocol error
// covers a connection closed before any response byte as well (wasmtime
// reports every failure of its HTTP client that is not a connect or TLS
// failure as one), so the hosted route cannot tell a reset from a
// malformed response and never sends a request again.
function __host_late_code(code: i32): FetchError {
  if (code == 33) {
    return Timeout(Inactivity);
  }
  if (code == 34) {
    return Protocol("the upgrade failed");
  }
  if (code == 35) {
    return Protocol("the host read a malformed response");
  }
  if (code == 36) {
    return Host("a loop was detected");
  }
  if (code == 37) {
    return Host("the host is misconfigured");
  }
  if (code == 38) {
    return Host("an internal error");
  }
  return Host("error code " + int.int_to_string(code));
}

// `__Read` — a final response as it came off the connection, and whether
// the connection outlives it: the peer did not ask to close (`Connection:
// close`, or an HTTP/1.0 response without `keep-alive`), the body was
// framed rather than ended by the close, and nothing followed it.
struct __Read { response: HttpResponse, keep: boolean }

// `__reusable(framed, from, read, eof)` — whether the connection outlives
// the final response `framed`, which began at `from` of the `read` bytes.
function __reusable(framed: http.HttpResponseFramed, from: i32, read: i32, eof: boolean): boolean {
  return framed.keep_alive && !eof && from + framed.len == read;
}

// `__send_all(tr, conn, payload)` — every byte of `payload` written, or
// the failure as the transport reported it.
function __send_all[T: Transport](tr: T, conn: i32, payload: u8[]): Result[void, FetchError] {
  let at: i32 = 0;
  while (at < payload.len()) {
    let rest: u8[] = payload;
    if (at > 0) {
      let b: usize = buf_new(payload.len() - at);
      buf_push_bytes_range(b, payload, at, payload.len());
      rest = buf_take_bytes(b);
      buf_free(b);
    }
    let n: i32 = tr.write(conn, rest);
    if (n < 0) {
      return Err(Io(net.error_from_errno(0 - n)));
    }
    if (n == 0) {
      return Err(Io(net.ConnectionReset));
    }
    at = at + n;
  }
  return Ok(());
}

// `__read_response(tr, conn, req, started)` — the response read under the
// inactivity and total bounds, interim 1xx responses stepped over (within
// one header budget for all of them, so a peer cannot stream `100
// Continue` for as long as the timeout allows), and handed back with its
// hop-by-hop fields stripped. The buffer is uniquely owned and grows in
// place, so the read stays linear in the response.
function __read_response[T: Transport](tr: T, conn: i32, req: Request, started: i64): Result[__Read, FetchError] {
  let buf: u8[] = [];
  let from: i32 = 0;
  let eof: boolean = false;
  while (true) {
    match (http.http_parse_response_framed_from(buf, from, req.method, eof, req.limits)) {
      Complete(framed) => {
        let next: i32 = __after_interim(framed, from, req.limits)?;
        if (next < 0) {
          let response: HttpResponse = HttpResponse { ...framed.response, headers: http.http_end_to_end(framed.response.headers) };
          return Ok(__Read { response: response, keep: __reusable(framed, from, buf.len(), eof) });
        }
        from = next;
        continue;
      },
      Unfinished => {
        if (eof) {
          return Err(__closed_early(buf.len() - from));
        }
      },
      Rejected(code) => {
        return Err(__rejected(code));
      }
    }
    let chunk: u8[] = __recv_bounded(tr, conn, req.timeouts, started)?;
    if (chunk.len() == 0) {
      eof = true;
    } else {
      buf = __append_bytes(buf, chunk);
    }
  }
  return Err(Protocol("unreachable"));
}

// `__append_bytes(buf, chunk)` — `buf` with `chunk` on its end, grown in
// place: `buf` is owned here, so each push lands on a unique array and
// the accumulation over a whole response is one linear pass.
function __append_bytes(own buf: u8[], chunk: u8[]): u8[] {
  let i: i32 = 0;
  while (i < chunk.len()) {
    buf = buf.append(chunk[i]);
    i = i + 1;
  }
  return buf;
}

// `__closed_early(got)` — the peer's close read as the client's error:
// a reset when no byte of the response came, since the request may not
// have been read at all and an idempotent one is sent again, and a
// protocol failure once a response had begun.
function __closed_early(got: i32): FetchError {
  if (got == 0) {
    return Io(net.ConnectionReset);
  }
  return Protocol("the connection closed before the response ended");
}

// `__decoded(resp, req)` — `resp` with its content codings undone when
// the client asked for them: a `Content-Encoding` of `gzip` (or
// `x-gzip`) codings, each undone in turn from the last applied, each
// under `req.limits.body`, their number under `req.decoding.depth` and
// the whole under `req.decoding.ratio`; the `Content-Encoding` and
// `Content-Length` fields then dropped since neither describes the body
// any more. A body with no coding, an empty one (a HEAD or 204 answer may
// still name a coding), and a coding the client did not ask for are
// handed back as they came.
function __decoded(resp: HttpResponse, req: Request): Result[HttpResponse, FetchError] {
  let codings: string[] = __codings(resp.headers);
  let body: u8[] = resp.body_bytes();
  if (!__asks_gzip(req) || codings.len() == 0 || body.len() == 0 || !__all_gzip(codings)) {
    return Ok(resp);
  }
  if (codings.len() > req.decoding.depth) {
    return Err(Decode("content codings past the depth of " + int.int_to_string(req.decoding.depth)));
  }
  let encoded: i32 = body.len();
  let left: i32 = codings.len();
  while (left > 0) {
    body = __gunzipped(body, req.limits.body)?;
    left = left - 1;
  }
  let allowed: i64 = __allowed(encoded, req.decoding.ratio);
  if (body.len() as i64 > allowed) {
    return Err(Decode("a body of " + int.int_to_string(body.len()) + " bytes from " + int.int_to_string(encoded) + " encoded, past the " + int.int_to_string(allowed as i32) + " allowed"));
  }
  return Ok(HttpResponse { ...resp, body: BodyBytes(body), headers: __without(resp.headers, ["content-encoding", "content-length"]) });
}

// `__allowed(encoded, ratio)` — the most decoded bytes a response of
// `encoded` bytes may become: `ratio` times that, and never less than
// `RATIO_FLOOR`. A refusal fits `i32` since the body it names is under
// `limits.body`.
function __allowed(encoded: i32, ratio: i32): i64 {
  let allowed: i64 = encoded as i64 * (ratio as i64);
  if (allowed < RATIO_FLOOR as i64) {
    return RATIO_FLOOR as i64;
  }
  return allowed;
}

// `__codings(h)` — the `Content-Encoding` codings in the order applied,
// each trimmed and case-folded, `identity` dropped.
function __codings(h: HeaderMap): string[] {
  let out: string[] = [];
  for v in h.get_all("content-encoding") {
    for c in v.split(",") {
      let name: string = c.trim().to_lower();
      if (name.len() > 0 && name != "identity") {
        out = out.append(name);
      }
    }
  }
  return out;
}

// `__all_gzip(codings)` — whether every coding is one the client asked
// for.
function __all_gzip(codings: string[]): boolean {
  for c in codings {
    if (c != "gzip" && c != "x-gzip") {
      return false;
    }
  }
  return true;
}

// `__gunzipped(body, max_out)` — one gzip coding undone, the decoder
// producing at most `max_out` bytes.
function __gunzipped(body: u8[], max_out: i32): Result[u8[], FetchError] {
  match (deflate.gunzip(body, max_out)) {
    Ok(out) => {
      return Ok(out);
    },
    Err(e) => {
      return Err(__undecodable(e));
    }
  }
  return Ok(body);
}

// `__undecodable(e)` — the decoder's refusal as a `FetchError`: the
// output cap is the body cap, anything else is a `Decode`.
function __undecodable(e: deflate.InflateError): FetchError {
  match (e) {
    deflate.OutputLimit => {
      return BodyLimit;
    },
    _ => {
      return Decode("a gzip body that does not decode: " + e.message());
    }
  }
  return BodyLimit;
}

// `__after_interim(framed, from, limits)` — where the response behind an
// interim `framed` begins, -1 when `framed` is the final response, or
// the refusal: a 101, since what follows a switch is another protocol
// and this client never asks for one, and interim responses past one
// header budget between them.
function __after_interim(framed: http.HttpResponseFramed, from: i32, limits: http.HttpLimits): Result[i32, FetchError] {
  if (framed.response.status == 101) {
    return Err(Protocol("a protocol switch the client did not ask for"));
  }
  if (!__interim(framed.response.status)) {
    return Ok(0 - 1);
  }
  let next: i32 = from + framed.len;
  if (next > limits.header_bytes) {
    return Err(Protocol("interim responses past the header budget"));
  }
  return Ok(next);
}

// `__interim(status)` — whether a status is a 1xx the final response
// follows (RFC 9110 §15.2); `__after_interim` refuses 101 before asking.
function __interim(status: i32): boolean {
  return status >= 100 && status < 200;
}

// `__recv_bounded(tr, conn, timeouts, started)` — the next chunk of the
// response within the tighter of the inactivity bound and what is left
// of the total, the bound that passed, or `Cancelled` when the task reading
// was cancelled while it waited.
function __recv_bounded[T: Transport](tr: T, conn: i32, timeouts: Timeouts, started: i64): Result[u8[], FetchError] {
  let ns_per_ms: i64 = 1000000;
  let left_ms: i64 = timeouts.total.as_millis() - (tr.now_ns() - started) / ns_per_ms;
  if (left_ms <= 0) {
    return Err(Timeout(Total));
  }
  let wait_ms: i64 = timeouts.inactivity.as_millis();
  let bound: Phase = Inactivity;
  if (left_ms < wait_ms) {
    wait_ms = left_ms;
    bound = Total;
  }
  match (tr.read(conn, 65536, wait_ms)) {
    Chunk(chunk) => {
      return Ok(chunk);
    },
    Elapsed => {
      return Err(Timeout(bound));
    },
    Abandoned => {
      return Err(FetchError.Cancelled);
    }
  }
  return Err(Timeout(bound));
}

// `__rejected(code)` — the parser's refusal as a `FetchError`.
function __rejected(code: i32): FetchError {
  if (code == 413) {
    return BodyLimit;
  }
  if (code == 431) {
    return Protocol("the header block or chunk framing is past its limit");
  }
  if (code == 501) {
    return Protocol("a transfer coding other than chunked");
  }
  if (code == 505) {
    return Protocol("an HTTP version other than 1");
  }
  return Protocol("a malformed response");
}

// ---------------------------------------------------------------------------
// Proxies

// `ProxyEnv` — the forward-proxy configuration an environment carries:
// `http_proxy`, the proxy for `http` URLs as `[http://][user:password@]host[:port]`,
// empty for none; `no_proxy`, the comma-separated hosts reached directly.
pub struct ProxyEnv { http_proxy: string, no_proxy: string }

// `proxy_env()` — the configuration as the environment sets it, read
// through `config_get` so it arrives the same way on every target (a
// variable where there is an environment, a binding on the proxy world);
// `proxy_env_from` says which names.
pub function proxy_env(): ProxyEnv {
  return proxy_env_from(config_get("http_proxy"), config_get("no_proxy"), config_get("NO_PROXY"), config_get("REQUEST_METHOD"));
}

// `proxy_env_from(http_proxy, no_proxy, no_proxy_upper, request_method)` —
// the configuration from its variables. Only the lowercase `http_proxy`
// is read, as curl reads it: a CGI host turns a client's `Proxy:` request
// header into the uppercase `HTTP_PROXY` (httpoxy). Under `REQUEST_METHOD`,
// the sign of a CGI invocation, no proxy is read at all, since there even
// the lowercase name may be the client's. `no_proxy` is read either way,
// the lowercase name first.
pub function proxy_env_from(http_proxy: Option[string], no_proxy: Option[string], no_proxy_upper: Option[string], request_method: Option[string]): ProxyEnv {
  let proxy: string = "";
  match (http_proxy) {
    Some(p) => {
      proxy = p;
    },
    None => {}
  }
  match (request_method) {
    Some(m) => {
      proxy = "";
    },
    None => {}
  }
  let skip: string = "";
  match (no_proxy) {
    Some(n) => {
      skip = n;
    },
    None => {
      match (no_proxy_upper) {
        Some(n) => {
          skip = n;
        },
        None => {}
      }
    }
  }
  return ProxyEnv { http_proxy: proxy, no_proxy: skip };
}

// `(p).proxy_for(url)` — the proxy a request for `url` goes through, or
// `None` for a direct connection: no `http_proxy`; a host that is
// `localhost`, under it, or a loopback address, never proxied whatever
// `no_proxy` says; or a host `no_proxy` names. An entry of `no_proxy` is
// `*` for every host; an address block in CIDR notation (`10.0.0.0/8`,
// `fd00::/8`) for a host that is an address in it; an address, bracketed
// or not, its zone ignored (a zone in an entry is what let `[::1%25.example.com]`
// pass as a subdomain elsewhere); or a domain, matching the host and its
// subdomains, only the subdomains with a leading dot. A `:port` on an
// entry limits it to that port. Names compare ASCII case-folded, without
// a trailing dot.
pub function (p: ProxyEnv) proxy_for(target_url: string): Option[string] {
  if (p.http_proxy.len() == 0) {
    return None;
  }
  let u: Url = Url { scheme: "", host: "", port: 0, path: "", query: "", fragment: "" };
  match (url.url_parse(target_url)) {
    Some(parsed) => {
      u = parsed;
    },
    None => {
      return None;
    }
  }
  let host: string = __host_name(u.host);
  let ip: Option[net.IpAddr] = __canonical_ip(host);
  if (__never_proxied(host, ip)) {
    return None;
  }
  for entry in p.no_proxy.split(",") {
    if (__no_proxy_matches(entry.trim(), host, __effective_port(u), ip)) {
      return None;
    }
  }
  return Some(p.http_proxy);
}

// `__never_proxied(host, ip)` — `localhost`, a name under it, or a
// loopback address: reached directly whatever `no_proxy` says.
function __never_proxied(host: string, ip: Option[net.IpAddr]): boolean {
  if (host == "localhost" || host.ends_with(".localhost")) {
    return true;
  }
  match (ip) {
    Some(a) => {
      return a.is_loopback();
    },
    None => {
      return false;
    }
  }
  return false;
}

// `__host_name(h)` — `h` ASCII case-folded, its trailing dot dropped.
function __host_name(h: string): string {
  let s: string = h.to_lower();
  if (s.len() > 1 && s.ends_with(".")) {
    return slice_unchecked(s, 0, s.len() - 1).to_owned();
  }
  return s;
}

// `__canonical_ip(text)` — `text` as an address, an IPv4 one unwrapped
// from its IPv6 form, or `None` for a name.
function __canonical_ip(text: string): Option[net.IpAddr] {
  match (net.ip_parse(text)) {
    Some(a) => {
      return Some(a.to_canonical());
    },
    None => {
      return None;
    }
  }
  return None;
}

// One `no_proxy` entry: its name, address or block, and the port it is
// limited to (0 for any, -1 for a port that does not read).
struct __Rule { name: string, port: i32 }

// `__no_proxy_matches(entry, host, port, ip)` — whether one `no_proxy`
// entry names `host` (an address `ip` when it is one) at `port`.
function __no_proxy_matches(entry: string, host: string, port: i32, ip: Option[net.IpAddr]): boolean {
  if (entry.len() == 0) {
    return false;
  }
  if (entry == "*") {
    return true;
  }
  let rule: __Rule = __entry_rule(entry);
  if (rule.port != 0 && rule.port != port) {
    return false;
  }
  let name: string = __host_name(rule.name);
  if (name.index_of("/") >= 0) {
    return __in_block(ip, name);
  }
  match (__canonical_ip(name)) {
    Some(a) => {
      return __same_ip(ip, a);
    },
    None => {}
  }
  if (name.starts_with(".")) {
    return host.ends_with(name);
  }
  return host == name || host.ends_with("." + name);
}

// `__entry_rule(entry)` — `entry` split into what it names and its
// `:port`: a bracketed address keeps its brackets' contents, a bare one
// with more than one colon is an IPv6 address with no port, and a zone
// (`%eth0`) is dropped from either, a `/bits` after it kept.
function __entry_rule(entry: string): __Rule {
  let name: string = entry;
  let rest: string = "";
  if (entry.starts_with("[")) {
    let close: i32 = entry.index_of("]");
    if (close < 0) {
      return __Rule { name: entry, port: -1 };
    }
    name = slice_unchecked(entry, 1, close).to_owned();
    rest = slice_unchecked(entry, close + 1, entry.len()).to_owned();
  } else {
    let colon: i32 = entry.index_of(":");
    if (colon >= 0 && colon == entry.last_index_of(":")) {
      name = slice_unchecked(entry, 0, colon).to_owned();
      rest = slice_unchecked(entry, colon, entry.len()).to_owned();
    }
  }
  return __Rule { name: __without_zone(name), port: __rule_port(rest) };
}

// `__without_zone(name)` — `name` less its `%zone`, a `/bits` after the
// zone kept.
function __without_zone(name: string): string {
  let zone: i32 = name.index_of("%");
  if (zone < 0) {
    return name;
  }
  let after: string = slice_unchecked(name, zone, name.len()).to_owned();
  let slash: i32 = after.index_of("/");
  if (slash < 0) {
    return slice_unchecked(name, 0, zone).to_owned();
  }
  return slice_unchecked(name, 0, zone).to_owned() + slice_unchecked(after, slash, after.len()).to_owned();
}

// `__rule_port(rest)` — the port of a `:port`, 0 for nothing, -1 for
// anything else.
function __rule_port(rest: string): i32 {
  if (rest.len() == 0) {
    return 0;
  }
  if (!rest.starts_with(":")) {
    return -1;
  }
  match (int.parse_int_radix(slice_unchecked(rest, 1, rest.len()).to_owned(), 10)) {
    Some(n) => {
      if (n > 0 && n < 65536) {
        return n;
      }
      return -1;
    },
    None => {
      return -1;
    }
  }
  return -1;
}

// `__same_ip(ip, a)` — whether the host is the address `a`.
function __same_ip(ip: Option[net.IpAddr], a: net.IpAddr): boolean {
  match (ip) {
    Some(h) => {
      return h.eq(a);
    },
    None => {
      return false;
    }
  }
  return false;
}

// `__in_block(ip, block)` — whether the host is an address in the CIDR
// `block`.
function __in_block(ip: Option[net.IpAddr], block: string): boolean {
  let slash: i32 = block.index_of("/");
  let bits: i32 = -1;
  match (int.parse_int_radix(slice_unchecked(block, slash + 1, block.len()).to_owned(), 10)) {
    Some(n) => {
      bits = n;
    },
    None => {}
  }
  let prefix: Option[net.IpAddr] = __canonical_ip(slice_unchecked(block, 0, slash).to_owned());
  match (ip) {
    Some(a) => {
      match (prefix) {
        Some(p) => {
          return __prefix_matches(a, p, bits);
        },
        None => {
          return false;
        }
      }
    },
    None => {
      return false;
    }
  }
  return false;
}

// `__prefix_matches(a, p, bits)` — same family and the first `bits` bits
// equal.
function __prefix_matches(a: net.IpAddr, p: net.IpAddr, bits: i32): boolean {
  let ab: u8[] = a.bytes();
  let pb: u8[] = p.bytes();
  if (ab.len() != pb.len() || bits < 0 || bits > ab.len() * 8) {
    return false;
  }
  let i: i32 = 0;
  while (i * 8 + 8 <= bits) {
    if (ab[i] != pb[i]) {
      return false;
    }
    i = i + 1;
  }
  let rem: i32 = bits - i * 8;
  if (rem == 0) {
    return true;
  }
  let mask: i32 = 255 << 8 - rem & 255;
  return (ab[i] as i32 & mask) == (pb[i] as i32 & mask);
}

// The proxy `http_proxy` names: where to dial it and the
// `Proxy-Authorization` value its credentials make, empty for none.
struct __Proxy { host: string, port: i32, auth: string }

// `__proxy_of(spec)` — `spec` as `[http://][user:password@]host[:port]`,
// port 80 when none, or why it names no proxy this client can use.
function __proxy_of(spec: string): Result[__Proxy, FetchError] {
  let full: string = spec;
  if (full.index_of("://") < 0) {
    full = "http://" + full;
  }
  let u: Url = Url { scheme: "", host: "", port: 0, path: "", query: "", fragment: "" };
  match (url.url_parse(full)) {
    Some(parsed) => {
      u = parsed;
    },
    None => {
      return Err(InvalidUrl("http_proxy is not a URL"));
    }
  }
  if (u.scheme != "http" || u.host.len() == 0) {
    return Err(InvalidUrl("http_proxy is not an http URL with a host"));
  }
  let port: i32 = u.port;
  if (port == 0) {
    port = 80;
  }
  return Ok(__Proxy { host: u.host, port: port, auth: __proxy_auth(full) });
}

// `__proxy_auth(full)` — `Basic` with the URL's userinfo as RFC 7617's
// `user:password`, the colon supplied when the URL names no password; or
// empty.
function __proxy_auth(full: string): string {
  let start: i32 = full.index_of("://") + 3;
  let end: i32 = full.len();
  let slash: i32 = slice_unchecked(full, start, end).to_owned().index_of("/");
  if (slash >= 0) {
    end = start + slash;
  }
  let authority: string = slice_unchecked(full, start, end).to_owned();
  let at: i32 = authority.last_index_of("@");
  if (at < 0) {
    return "";
  }
  let userinfo: string = slice_unchecked(authority, 0, at).to_owned();
  if (userinfo.index_of(":") < 0) {
    userinfo = userinfo + ":";
  }
  return "Basic " + base64.base64_encode(userinfo.bytes());
}

// ---------------------------------------------------------------------------
// The awaitable fetch

// __join_bytes(chunks) — the chunk list flattened into one buffer, sized
// up front so the fill is a single pass over a uniquely-owned array.
//
// `__fetch_drain` collects its `recv` buffers into a list and joins once,
// because its accumulator is captured by `resume`: a second reference
// makes every append copy the whole response so far, and
// `__arr_push_shared_count()` is what makes that visible. The blocking
// client's buffer has no second reference, so it appends in place
// (`__append_bytes`) instead.
function __join_bytes(chunks: u8[][]): u8[] {
  let total: i32 = 0;
  let k: i32 = 0;
  while (k < chunks.len()) {
    total = total + chunks[k].len();
    k = k + 1;
  }
  let out: u8[] = __alloc_u8(total);
  let w: i32 = 0;
  let j: i32 = 0;
  while (j < chunks.len()) {
    let i: i32 = 0;
    let n: i32 = chunks[j].len();
    while (i < n) {
      out = out.with(w, chunks[j][i]);
      w = w + 1;
      i = i + 1;
    }
    j = j + 1;
  }
  return out;
}

// fetch_future(host_be, port, path) — the AWAITABLE fetch: open a
// connection and send the request NON-blocking, then return a
// `Future[u8[]]` that resolves to the response body once the socket
// is readable. This is the combinator-surface fetch
// (docs/ASYNC-REDESIGN.md): drive several through `async.gather` and
// their reads overlap on one thread —
//
//   let none: u8[] = [];
//   let bodies = async.gather([
//       fetch.fetch_future(cache, 80, "/k"),
//       fetch.fetch_future(primary, 80, "/k"),
//   ], none);
//
// On a connect/send failure it resolves immediately to the empty body (a
// `Ready` future), so a failed upstream doesn't stall the fan-out, and so
// does a response the parser refuses or a `path` that cannot stand on a
// request line (`http_target_ok`), which is refused before connecting. The
// read is STREAMING — `__fetch_drain` re-suspends per chunk and accumulates, so
// the whole response comes back (not just one `recv` buffer) while
// staying overlapped with the other futures. PORTABLE native + wasm: the
// wait token is `tcp_pollable(c)` — the raw fd on native (identity), a
// real wasi:io/poll pollable handle on wasm — so `poll` (poll(2) /
// ppoll(2) native, wasi:io/poll.poll on wasm) drives it either way. The
// continuation captures the connection `c` (it reads the socket, not the
// woken token, which differs by backend).
pub function fetch_future(host_be: i32, port: i32, path: string): async.Future[u8[]] {
  let empty: u8[] = [];
  if (!http.http_target_ok(path)) {
    return Ready(empty);
  }
  let request: string = "GET " + path + " HTTP/1.1\r\nHost: fern\r\nConnection: close\r\n\r\n";
  let c: i32 = tcp_connect(host_be, port);
  if (c < 0) {
    return Ready(empty);
  }
  if (tcp_send(c, request) < 0) {
    tcp_close(c);
    return Ready(empty);
  }
  let no_chunks: u8[][] = [];
  return __fetch_drain(c, no_chunks);
}

// __fetch_drain(c, chunks) — one step of the streaming response read: a `Future`
// that, once `c` is readable, drops the woken pollable, `recv`s a chunk, and
// either FINISHES (empty recv = EOF, since we send `Connection: close`) by
// returning the parsed body, or RE-SUSPENDS to read more. `chunks` carries the
// buffers read so far across re-suspends, so a response spanning multiple recv
// buffers / TCP segments is read in FULL. Re-suspending (rather than looping
// `recv` synchronously) keeps the read overlapped with the other futures in a
// `gather`/`race`. At most one pollable is live at a time (each step drops the
// previous before subscribing the next), so the socket has no child pollable
// when `tcp_close` runs.
//
// It carries a LIST of chunks rather than one growing buffer because the
// accumulator is captured by `resume`: a captured array is a second
// reference, so appending to it copies the whole thing on every step, and
// concatenating bytes that way is quadratic in the response size. Appending
// the chunk POINTER is quadratic only in the chunk COUNT, and `__join_bytes`
// pays one linear pass at EOF.
function __fetch_drain(c: i32, chunks: u8[][]): async.Future[u8[]] {
  function resume(woken: i32): async.Future[u8[]] {
    let dropped: i32 = wasm_pollable_drop(woken);
    let chunk: u8[] = tcp_recv(c, 4096);
    if (chunk.len() == 0) {
      tcp_close(c);
      return Ready(__body_of(__join_bytes(chunks)));
    }
    return __fetch_drain(c, chunks.append(chunk));
  }
  return Pending(tcp_pollable(c), resume);
}

// `__body_of(raw)` — the body of the whole response `raw`, decoded under
// its framing, or empty for one the parser refuses.
function __body_of(raw: u8[]): u8[] {
  match (http.http_parse_response_framed(raw, "GET", true, http.http_limits())) {
    Complete(framed) => {
      return framed.response.body_bytes();
    },
    _ => {
      let empty: u8[] = [];
      return empty;
    }
  }
  let none: u8[] = [];
  return none;
}
