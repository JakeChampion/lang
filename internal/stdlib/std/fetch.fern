// std/fetch — outbound HTTP/1.1 client (the upstream-fetch half of the
// edge-handler use case: docs/PLATFORM-RESEARCH.md Rec §1,
// docs/ASYNC-REDESIGN.md).
//
// Built on the native socket primitives (tcp_connect / tcp_send /
// tcp_recv / tcp_close). A single `fetch_get` is a blocking request;
// overlapping several upstreams is `std/async`'s job — `fetch_future`
// (below) returns an `async.Future[u8[]]` you fan out through
// `async.gather` / `async.race`, and their reads overlap on one thread.
//
// `host_be` is the IPv4 address in network byte order packed into an
// i32 (use `ipv4(a,b,c,d)`); pass the upstream port separately. URL /
// DNS parsing is a higher layer.
//
// Responses are `u8[]`, not `string`. An upstream serves whatever bytes
// it likes — a PNG, a gzip stream, a truncated UTF-8 sequence — so a
// text-typed response would be a `string` that is not well-formed UTF-8,
// which the D9 invariant forbids (docs/STRINGS-SOTA.md). Callers that
// want text decode explicitly: `utf8.from_bytes(fetch.http_body(resp))`
// returns `None` when the body is not valid UTF-8.

import "std/string";
import "std/async";
// std/tcp — tcp_recv_deadline, the recv-with-deadline primitive behind
// the *_deadline fetch variants.
import "std/tcp";
import "std/platform";
import "core/int";

// ipv4(a, b, c, d) — pack a dotted-quad into the network-byte-order
// i32 that tcp_connect wants in sin_addr. ipv4(127,0,0,1) addresses
// loopback.
pub function ipv4(a: i32, b: i32, c: i32, d: i32): i32 {
    return (a & 255) | ((b & 255) << 8) | ((c & 255) << 16) | ((d & 255) << 24);
}

// __join_bytes(chunks) — the chunk list flattened into one buffer, sized
// up front so the fill is a single pass over a uniquely-owned array.
//
// Every read path here collects `recv` buffers into a list and joins once
// rather than concatenating onto a growing accumulator. Concatenation is
// quadratic in the response size whenever the accumulator has a second
// reference — which it always does inside `__fetch_drain`, where `resume`
// captures it — and `__arr_push_shared_count()` is what makes that
// visible: one crossing per chunk, each copying the whole response so far.
function __join_bytes(chunks: u8[][]): u8[] {
    var total: i32 = 0;
    var k: i32 = 0;
    while (k < chunks.len()) {
        total = total + chunks[k].len();
        k = k + 1;
    }
    var out: u8[] = __alloc_u8(total);
    var w: i32 = 0;
    var j: i32 = 0;
    while (j < chunks.len()) {
        var i: i32 = 0;
        var n: i32 = chunks[j].len();
        while (i < n) {
            out = out.with(w, chunks[j][i]);
            w = w + 1;
            i = i + 1;
        }
        j = j + 1;
    }
    return out;
}

// fetch_raw(host_be, port, request) — open a connection, send `request`
// verbatim, and read the whole response until the peer closes (the
// request should carry `Connection: close`). Returns the raw response
// bytes, or the empty array if the connection or send failed. Blocking;
// for overlap, use `fetch_future` through `async.gather` / `async.race`.
pub function fetch_raw(host_be: i32, port: i32, request: string): u8[] {
    var empty: u8[] = [];
    var c: i32 = tcp_connect(host_be, port);
    if (c < 0) {
        return empty;
    }
    if (tcp_send(c, request) < 0) {
        tcp_close(c);
        return empty;
    }
    var chunks: u8[][] = [];
    while (true) {
        var chunk: u8[] = tcp_recv(c, 4096);
        if (chunk.len() == 0) {
            break;
        }
        chunks = chunks.append(chunk);
    }
    tcp_close(c);
    return __join_bytes(chunks);
}

// fetch_get(host_be, port, path) — issue `GET <path>` against the
// upstream and return the raw HTTP/1.1 response bytes (status line +
// headers + body). `Connection: close` so the read terminates at EOF.
// Use `http_body(resp)` to peel the body off.
pub function fetch_get(host_be: i32, port: i32, path: string): u8[] {
    var request: string = "GET " + path + " HTTP/1.1\r\nHost: fern\r\nConnection: close\r\n\r\n";
    return fetch_raw(host_be, port, request);
}

// fetch_raw_deadline(host_be, port, request, deadline_ms) — `fetch_raw`
// with a total read deadline: `Some(response)` when the upstream's
// whole response arrived within `deadline_ms` of the send, `None` when
// the deadline passed first (the connection is closed either way). A
// connect/send failure is `Some([])`, mirroring `fetch_raw`'s empty
// response — so None means exactly one thing: too slow. The deadline
// covers the read phase; `tcp_connect` itself is still a blocking connect (no
// non-blocking connect primitive yet), which on a reachable-but-dead
// upstream fails fast but on a black-holed address is at the mercy of
// the kernel SYN timeout. On interp the deadline degrades to blocking
// reads (see `tcp_recv_deadline`).
pub function fetch_raw_deadline(host_be: i32, port: i32, request: string, deadline_ms: i32): Option[u8[]] {
    var empty: u8[] = [];
    var c: i32 = tcp_connect(host_be, port);
    if (c < 0) {
        return Some(empty);
    }
    if (tcp_send(c, request) < 0) {
        tcp_close(c);
        return Some(empty);
    }
    var ns_per_ms: i64 = 1000000;
    var start_ns: i64 = monotonic_ns();
    var chunks: u8[][] = [];
    while (true) {
        var remaining_ms: i32 = (((deadline_ms as i64) * ns_per_ms - (monotonic_ns() - start_ns)) / ns_per_ms) as i32;
        if (remaining_ms <= 0) {
            tcp_close(c);
            return None;
        }
        var chunk: u8[] = [];
        var timed_out: boolean = false;
        match (tcp.tcp_recv_deadline(c, 4096, remaining_ms)) {
            Some(got) => { chunk = got; },
            None => { timed_out = true; },
        }
        if (timed_out) {
            tcp_close(c);
            return None;
        }
        if (chunk.len() == 0) {
            break;
        }
        chunks = chunks.append(chunk);
    }
    tcp_close(c);
    return Some(__join_bytes(chunks));
}

// fetch_get_deadline(host_be, port, path, deadline_ms) — `fetch_get`
// with a total read deadline. `Some(raw response bytes)` in time (use
// `http_body` / `http_status`), `None` when the upstream was too slow.
pub function fetch_get_deadline(host_be: i32, port: i32, path: string, deadline_ms: i32): Option[u8[]] {
    var request: string = "GET " + path + " HTTP/1.1\r\nHost: fern\r\nConnection: close\r\n\r\n";
    return fetch_raw_deadline(host_be, port, request, deadline_ms);
}

// fetch_future(host_be, port, path) — the AWAITABLE fetch: open a
// connection and send the request NON-blocking, then return a
// `Future[u8[]]` that resolves to the response body once the socket
// is readable. This is the combinator-surface fetch
// (docs/ASYNC-REDESIGN.md): drive several through `async.gather` and
// their reads overlap on one thread —
//
//   var none: u8[] = [];
//   var bodies = async.gather([
//       fetch.fetch_future(cache, 80, "/k"),
//       fetch.fetch_future(primary, 80, "/k"),
//   ], none);
//
// On a connect/send failure it resolves immediately to the empty body (a
// `Ready` future), so a failed upstream doesn't stall the fan-out. The
// read is STREAMING — `__fetch_drain` re-suspends per chunk and accumulates, so
// the whole response comes back (not just one `recv` buffer) while
// staying overlapped with the other futures. PORTABLE native + wasm: the
// wait token is `tcp_pollable(c)` — the raw fd on native (identity), a
// real wasi:io/poll pollable handle on wasm — so `poll` (poll(2) /
// ppoll(2) native, wasi:io/poll.poll on wasm) drives it either way. The
// continuation captures the connection `c` (it reads the socket, not the
// woken token, which differs by backend). On interp the `poll` stub
// means the `Pending` never resolves (consistent with std/async).
pub function fetch_future(host_be: i32, port: i32, path: string): async.Future[u8[]] {
    var request: string = "GET " + path + " HTTP/1.1\r\nHost: fern\r\nConnection: close\r\n\r\n";
    var empty: u8[] = [];
    var c: i32 = tcp_connect(host_be, port);
    if (c < 0) {
        return Ready(empty);
    }
    if (tcp_send(c, request) < 0) {
        tcp_close(c);
        return Ready(empty);
    }
    var no_chunks: u8[][] = [];
    return __fetch_drain(c, no_chunks);
}

// __fetch_drain(c, chunks) — one step of the streaming response read: a `Future`
// that, once `c` is readable, drops the woken pollable, `recv`s a chunk, and
// either FINISHES (empty recv = EOF, since we send `Connection: close`) by
// returning the parsed body, or RE-SUSPENDS to read more. `chunks` carries the
// buffers read so far across re-suspends, so a response spanning multiple recv
// buffers / TCP segments is read in FULL — the previous single-`recv` version
// truncated anything past one 4 KiB chunk. Re-suspending (rather than looping
// `recv` synchronously) keeps the read overlapped with the other futures in a
// `gather`/`race`. At most one pollable is live at a time (each step drops the
// previous before subscribing the next), so the socket has no child pollable
// when `tcp_close` runs.
//
// It carries a LIST of chunks rather than one growing buffer because the
// accumulator is captured by `resume`: a captured array is a second
// reference, so appending to it copies the whole thing on every step, and
// concatenating bytes that way is quadratic in the response size. Appending
// the chunk POINTER is quadratic only in the chunk COUNT, and `__join_bytes`
// pays one linear pass at EOF.
function __fetch_drain(c: i32, chunks: u8[][]): async.Future[u8[]] {
    function resume(woken: i32): async.Future[u8[]] {
        var dropped: i32 = wasm_pollable_drop(woken);
        var chunk: u8[] = tcp_recv(c, 4096);
        if (chunk.len() == 0) {
            tcp_close(c);
            return Ready(http_body(__join_bytes(chunks)));
        }
        return __fetch_drain(c, chunks.append(chunk));
    }
    return Pending(tcp_pollable(c), resume);
}

// http_status(resp) — parse the numeric status code from an HTTP/1.1 response's
// status line (`HTTP/1.1 200 OK` → 200), or -1 if the response is empty or the
// status line is malformed. The code is the run of digits after the first space.
pub function http_status(resp: u8[]): i32 {
    var n: i32 = resp.len();
    var sp: i32 = -1;
    var i: i32 = 0;
    while (i < n) {
        if ((resp[i] as i32) == 32) {
            sp = i;
            break;
        }
        i = i + 1;
    }
    if (sp < 0) {
        return -1;
    }
    var j: i32 = sp + 1;
    var code: i32 = 0;
    var have: boolean = false;
    while (j < n) {
        var ch: i32 = resp[j] as i32;
        if (ch < 48 || ch > 57) {
            break;
        }
        code = code * 10 + (ch - 48);
        have = true;
        j = j + 1;
    }
    if (!have) {
        return -1;
    }
    return code;
}

// http_body(resp) — return the body of an HTTP response (everything
// after the first blank line `\r\n\r\n`), or the empty array if the
// response has no header/body separator. Does not interpret
// Content-Length / chunked encoding; it returns whatever followed the
// headers. Decode with `utf8.from_bytes` when the body is meant to be
// text — an upstream can serve anything.
pub function http_body(resp: u8[]): u8[] {
    var out: u8[] = [];
    var n: i32 = resp.len();
    var sep: i32 = -1;
    var i: i32 = 0;
    while (i + 3 < n) {
        if ((resp[i] as i32) == 13 && (resp[i + 1] as i32) == 10
            && (resp[i + 2] as i32) == 13 && (resp[i + 3] as i32) == 10) {
            sep = i;
            break;
        }
        i = i + 1;
    }
    if (sep < 0) {
        return out;
    }
    var start: i32 = sep + 4;
    out = __alloc_u8(n - start);
    var j: i32 = start;
    while (j < n) {
        out = out.with(j - start, resp[j]);
        j = j + 1;
    }
    return out;
}

// parse_ipv4(s) — parse a dotted-quad "a.b.c.d" into the network-byte-
// order i32 tcp_connect wants, or -1 if it isn't four 0..255 octets.
// No DNS — a literal address only.
pub function parse_ipv4(s: string): i32 {
    var octets: i32[] = [];
    var cur: i32 = 0;
    var have: boolean = false;
    var i: i32 = 0;
    while (i < s.len()) {
        var ch: i32 = s[i] as i32;
        if (ch == 46) { // '.'
            if (!have) { return -1; }
            octets = octets.append(cur);
            cur = 0;
            have = false;
        } else if (ch >= 48 && ch <= 57) {
            cur = cur * 10 + (ch - 48);
            if (cur > 255) { return -1; }
            have = true;
        } else {
            return -1;
        }
        i = i + 1;
    }
    if (!have) { return -1; }
    octets = octets.append(cur);
    if (octets.len() != 4) { return -1; }
    return ipv4(octets[0], octets[1], octets[2], octets[3]);
}

// (plat: Platform).fetch(host, port, path) — the capability-scoped outbound GET
// an edge handler reaches for: `plat.fetch("a.b.c.d", port, "/x")`. Routing
// outbound I/O through the `Platform` bag keeps the capability model
// (docs/PLATFORM-RESEARCH.md Rec §1) — a handler can only fetch through the
// platform it was handed. `host` is a literal IPv4. Returns the HTTP STATUS CODE
// (an i32, e.g. 200 / 404), or -1 on a parse / connect / malformed-response
// failure. For the response BODY, or to overlap several fetches, use
// `fetch_future` through `async.gather` / `async.race`. Blocking.
//
// A recording bag reaches no socket: the call is logged as `fetch` with a
// `host:port path` summary and answered -1, the same value a real fetch gives
// for a host it could not reach (std/mock_platform).
pub function (plat: Platform) fetch(host: string, port: i32, path: string): i32 {
    if (plat.is_mock()) {
        plat.record("fetch", host + ":" + int.int_to_string(port) + " " + path);
        return -1;
    }
    var h: i32 = parse_ipv4(host);
    if (h < 0) {
        return -1;
    }
    return http_status(fetch_get(h, port, path));
}

// get_url(url) — fetch a full `http://HOST[:PORT]/PATH` URL in one
// call: split the scheme / host / optional port / path and GET it,
// returning the raw response bytes (use `http_body`). HOST must be a
// literal IPv4 (no DNS / TLS yet); the port defaults to 80; a missing
// path becomes "/". Returns the empty array on a malformed URL or a
// connect failure.
pub function get_url(url: string): u8[] {
    var empty: u8[] = [];
    // Require and strip the http:// scheme.
    var prefix: string = "http://";
    if (!url.starts_with(prefix)) { return empty; }
    var rest: str = slice_unchecked(url, prefix.len(), url.len());
    // authority is up to the first '/'; the rest (incl. the '/') is the path.
    var slash: i32 = rest.index_of("/");
    var authority: str = rest;
    var path: str = "/";
    if (slash >= 0) {
        authority = slice_unchecked(rest, 0, slash);
        path = slice_unchecked(rest, slash, rest.len());
    }
    // authority = HOST[:PORT].
    var host: str = authority;
    var port: i32 = 80;
    var colon: i32 = authority.index_of(":");
    if (colon >= 0) {
        host = slice_unchecked(authority, 0, colon);
        var portstr: str = slice_unchecked(authority, colon + 1, authority.len());
        port = 0;
        var i: i32 = 0;
        while (i < portstr.len()) {
            var ch: i32 = portstr[i] as i32;
            if (ch < 48 || ch > 57) { return empty; }
            port = port * 10 + (ch - 48);
            i = i + 1;
        }
        if (i == 0) { return empty; }
    }
    var h: i32 = parse_ipv4(host);
    if (h < 0) { return empty; }
    return fetch_get(h, port, path);
}
