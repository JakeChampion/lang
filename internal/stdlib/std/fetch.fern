// std/fetch — outbound HTTP/1.1 client (the upstream-fetch half of the
// edge-handler use case: docs/PLATFORM-RESEARCH.md Rec §1).
//
// A request is a value built from a URL (`get(url)`, `request(method,
// url)`, then `with_header`, `with_text`, `with_bytes`, `with_body`,
// `with_timeouts`, `with_limits`) and sent with `send(req)` from a program
// with a `main`, or through the `Platform` bag a handler was handed
// (`plat.http(req)`), which is the capability-scoped route: a handler can
// only fetch through the platform it was given, and a recording bag
// answers what the test canned instead of opening a socket.
//
// The answer is `Result[HttpResponse, FetchError]`: the status is data on
// the response (`ok_or_status()` turns a status outside 2xx into an
// `Err`), and `FetchError` is a closed sum over the phase that failed. The
// response is the same byte-bodied type the server side builds, headers
// case-folded by `HeaderMap` with the hop-by-hop fields stripped, a
// chunked body decoded and its trailers in `trailers`; `body_text()` is the
// checked UTF-8 read of a body that came off the wire, which may hold
// anything. The name is resolved by `std/dns` (a literal address, the
// hosts file, then DNS) and the addresses raced the way `dns.connect_race`
// does. Every phase is bounded by `Timeouts`. A 3xx with a `Location` is
// followed, ten hops by default, the credentials dropped when a hop
// leaves the origin; an idempotent request the peer resets before
// answering is sent once more. No TLS yet (`https` fails with `Tls`), no
// pool: each request is one connection sent with `Connection: close`.
// The client asks for `gzip` unless the caller wrote an `Accept-Encoding`
// of their own, and undoes the coding it asked for under `Decoding`'s
// depth and ratio and the body cap, so a caller sees the bytes the
// origin meant and a hostile origin cannot inflate past the bounds.
//
// The two routes differ in what they may reach. `plat.http` refuses a
// host that resolves to an address `net.is_global` does not admit
// (loopback, a private or link-local block, the cloud metadata address,
// an IPv4 one carried inside an IPv6 one), checked on the addresses the
// client is about to dial rather than on the name, so a record that
// rebinds is caught too; a handler's upstream URL may have come from a
// request, and the platform it runs on is not its to reach. `send` has no
// such rule. Both go through the forward proxy the environment names
// (`ProxyEnv`: the lowercase `http_proxy`, `no_proxy`, nothing under
// `REQUEST_METHOD`); the handler's route still resolves and checks the
// origin before handing a request to the proxy, so a deployment where
// only the proxy can resolve names reaches it through `send`. Neither
// route resolves an IPv4 address written as anything but four decimal
// octets.
//
// A single `send` is a blocking request; overlapping several upstreams is
// `std/async`'s job — `fetch_future` returns an `async.Future[u8[]]` you
// fan out through `async.gather` / `async.race`, and their reads overlap
// on one thread.

import "std/string";
import "std/async";
import "std/time";
// std/tcp — tcp_recv_deadline, the recv-with-deadline primitive behind
// the inactivity and total timeouts.
import "std/tcp";
import "std/platform";
import "std/http";
import "std/headers";
import "std/url";
import "std/dns";
import "std/net";
import "std/base64";
import "std/deflate";
import "core/int";

// ipv4(a, b, c, d) — pack a dotted-quad into the network-byte-order
// i32 that tcp_connect wants in sin_addr. ipv4(127,0,0,1) addresses
// loopback.
pub function ipv4(a: i32, b: i32, c: i32, d: i32): i32 {
  return a & 255 | (b & 255) << 8 | (c & 255) << 16 | (d & 255) << 24;
}

// ---------------------------------------------------------------------------
// Errors

// `Phase` — which bound a `Timeout` passed: `Connecting` for the connect
// timeout, `Inactivity` for the longest the client waits for the next
// byte of the response, `Total` for the whole request.
pub enum Phase { Connecting, Inactivity, Total }

// `FetchError` — why a request failed, by phase. `InvalidUrl` for a URL
// `std/url` cannot parse, with no scheme or host, with a scheme other
// than `http` and `https`, or whose path or query cannot stand on a
// request line; `InvalidRequest` for a method that is not a token, a
// header that cannot be written as one line, or a file body (a handler
// reads files through its bag, not through the client); `Dns` for a name
// that did not resolve; `Connect` for
// addresses that all failed; `Blocked` for a host that resolves to an
// address the route may not reach (`plat.http` and `net.is_global`);
// `Tls` for `https` (not supported yet);
// `Timeout` for a bound passed; `Protocol` for a response this client
// cannot read, with what was wrong; `Io` for a send or read the kernel
// refused; `Redirect` for a redirect the client would not follow: more
// hops than `Request.redirects`, a 3xx without a `Location`, or one that
// is not a URL; `BodyLimit` for a body past `HttpLimits.body`, decoded or
// not; `Decode` for a content coding the client could not undo: more
// codings than `Decoding.depth`, a body that is not gzip, or one grown
// past `Decoding.ratio`;
// `Cancelled` for a request abandoned by its caller, part of the sum so a
// match written today survives the client growing cancellation; this
// client does not produce it yet.
pub enum FetchError {
  InvalidUrl(string),
  InvalidRequest(string),
  Dns(dns.DnsError),
  Connect(net.NetError),
  Blocked(string),
  Tls,
  Timeout(Phase),
  Protocol(string),
  Io(net.NetError),
  Redirect(string),
  BodyLimit,
  Decode(string),
  Cancelled,
}

pub function (p: Phase) message(): string {
  match (p) {
    Connecting => {
      return "connecting";
    },
    Inactivity => {
      return "waiting for the response";
    },
    Total => {
      return "in all";
    }
  }
  return "";
}

pub function (e: FetchError) message(): string {
  match (e) {
    InvalidUrl(what) => {
      return "invalid URL: " + what;
    },
    InvalidRequest(what) => {
      return "invalid request: " + what;
    },
    Dns(d) => {
      return "resolve: " + d.message();
    },
    Connect(n) => {
      return "connect: " + n.message();
    },
    Tls => {
      return "TLS is not supported";
    },
    Timeout(p) => {
      return "timed out " + p.message();
    },
    _ => {
      return __later_message(e);
    }
  }
  return "";
}

function __later_message(e: FetchError): string {
  match (e) {
    Protocol(what) => {
      return "protocol: " + what;
    },
    Io(n) => {
      return "i/o: " + n.message();
    },
    Blocked(what) => {
      return "blocked: " + what;
    },
    Redirect(what) => {
      return "redirect: " + what;
    },
    BodyLimit => {
      return "response body past its limit";
    },
    Decode(what) => {
      return "decode: " + what;
    },
    Cancelled => {
      return "cancelled";
    },
    _ => {
      return "";
    }
  }
  return "";
}

pub function (e: FetchError) to_string(): string {
  return e.message();
}

// ---------------------------------------------------------------------------
// Requests

// `Timeouts` — the bounds on one request, in milliseconds: `connect_ms`
// on the connect (the whole address race), `inactivity_ms` on the wait
// for the next byte of the response, `total_ms` on the request from its
// start to the last byte read.
pub struct Timeouts { connect_ms: i32, inactivity_ms: i32, total_ms: i32 }

// `timeouts()` — ten seconds to connect, thirty between bytes, sixty in
// all.
pub function timeouts(): Timeouts {
  return Timeouts { connect_ms: 10000, inactivity_ms: 30000, total_ms: 60000 };
}

// `Request` — what `send` sends: the method, the URL, the headers
// (end-to-end ones; the client writes `Host`, `Content-Length` and
// `Connection` itself), the body, the bounds on the response
// (`timeouts`, and `limits` for its size: the body cap is
// `limits.body`, the status line is capped by `limits.request_line`),
// and `redirects`, the most 3xx hops `send` follows (0 answers the 3xx
// as data).
pub struct Request { method: string, url: string, headers: HeaderMap, body: Body, timeouts: Timeouts, limits: http.HttpLimits, redirects: i32, decoding: Decoding }

// `Decoding` — what the client undoes in a response body: `depth`, how
// many content codings it undoes (each one `gzip`), 0 for none, and then
// it asks for none either; `ratio`, the most a body may grow in decoding,
// as a multiple of its encoded size. The decoded body is bounded by
// `limits.body` as any body is.
pub struct Decoding { depth: i32, ratio: i32 }

// `decoding()` — one coding undone, a body allowed to grow a hundredfold.
pub function decoding(): Decoding {
  return Decoding { depth: 1, ratio: 100 };
}

// `request(method, url)` — a request with no headers and no body, the
// default bounds, ten redirects and the default decoding.
pub function request(method: string, url: string): Request {
  var none: u8[] = [];
  return Request { method: method, url: url, headers: headers.header_map_new(), body: BodyBytes(none), timeouts: timeouts(), limits: http.http_limits(), redirects: 10, decoding: decoding() };
}

// `get(url)` — `request("GET", url)`.
pub function get(url: string): Request {
  return request("GET", url);
}

// `(r: Request).with_header(name, value)` — `r` with the field appended.
pub function (r: Request) with_header(name: string, value: string): Request {
  return Request { ...r, headers: r.headers.append(name, value) };
}

// `(r: Request).with_body(body)` — `r` with `body` as its body: text,
// bytes, a stream or chunks. A `BodyFile` is refused by `send` with
// `InvalidRequest`: the client never reads a file.
pub function (r: Request) with_body(body: Body): Request {
  return Request { ...r, body: body };
}

// `(r: Request).with_text(s)` — `r` with `s` as its body.
pub function (r: Request) with_text(s: string): Request {
  return Request { ...r, body: BodyText(s) };
}

// `(r: Request).with_bytes(bs)` — `r` with `bs` as its body.
pub function (r: Request) with_bytes(bs: u8[]): Request {
  return Request { ...r, body: BodyBytes(bs) };
}

// `(r: Request).with_timeouts(t)` — `r` bounded by `t`.
pub function (r: Request) with_timeouts(t: Timeouts): Request {
  return Request { ...r, timeouts: t };
}

// `(r: Request).with_limits(l)` — `r` with the response capped by `l`.
pub function (r: Request) with_limits(l: http.HttpLimits): Request {
  return Request { ...r, limits: l };
}

// `(r: Request).with_redirects(hops)` — `r` following at most `hops`
// redirects; 0 answers a 3xx as the response it is.
pub function (r: Request) with_redirects(hops: i32): Request {
  return Request { ...r, redirects: hops };
}

// `(r: Request).with_decoding(d)` — `r` undoing content codings as `d`
// says; `Decoding { depth: 0, ... }` asks for none and undoes none.
pub function (r: Request) with_decoding(d: Decoding): Request {
  return Request { ...r, decoding: d };
}

// `(r: HttpResponse).ok_or_status()` — `Ok(r)` for a 2xx status, else
// `Err(status)`: for a caller that treats anything else as a failure.
pub function (r: HttpResponse) ok_or_status(): Result[HttpResponse, i32] {
  if (r.status >= 200 && r.status < 300) {
    return Ok(r);
  }
  return Err(r.status);
}

// ---------------------------------------------------------------------------
// Sending

// Where a request goes: the host and port to dial, the request-target
// for the request line, the `Host` value (the origin's, whichever is
// dialled), the `Proxy-Authorization` to write (empty for none), whether
// the origin itself is dialled, and the origin's host either way.
struct __Target { host: string, port: i32, target: string, host_field: string, proxy_auth: string, direct: boolean, origin: string }

// `__target_of(url, policy)` — the URL split for the wire, or why it
// cannot be: through the proxy the environment names for it, as the
// absolute-form target a proxy forwards (RFC 9112 §3.2.2), else straight
// to the origin.
function __target_of(raw: string, policy: __Policy): Result[__Target, FetchError] {
  var u: Url = __http_url(raw)?;
  var port: i32 = u.port;
  if (port == 0) {
    port = 80;
  }
  var host_field: string = __host_field(u.host, port);
  var target: string = __request_target(u)?;
  match (policy.proxies.proxy_for(raw)) {
    Some(spec) => {
      var p: __Proxy = __proxy_of(spec)?;
      return Ok(__Target { host: p.host, port: p.port, target: "http://" + host_field + target, host_field: host_field, proxy_auth: p.auth, direct: false, origin: u.host });
    },
    None => {}
  }
  return Ok(__Target { host: u.host, port: port, target: target, host_field: host_field, proxy_auth: "", direct: true, origin: u.host });
}

// `__http_url(raw)` — `raw` parsed, when it is an `http` URL naming a
// host this client dials. An IPv4 address is four decimal octets or
// nothing: `2130706433`, `0177.0.0.1` and `127.1` each read as loopback
// to some resolvers and as a name to others, and an address that reads
// two ways is how a block list is bypassed.
function __http_url(raw: string): Result[Url, FetchError] {
  var u: Url = Url { scheme: "", host: "", port: 0, path: "", query: "", fragment: "" };
  match (url.url_parse(raw)) {
    Some(parsed) => {
      u = parsed;
    },
    None => {
      return Err(InvalidUrl(raw));
    }
  }
  if (u.scheme == "https") {
    return Err(Tls);
  }
  if (u.scheme.len() == 0) {
    return Err(InvalidUrl("no scheme in " + raw));
  }
  if (u.scheme != "http") {
    return Err(InvalidUrl("scheme " + u.scheme + " is not http"));
  }
  if (u.host.len() == 0) {
    return Err(InvalidUrl("no host in " + raw));
  }
  if (__ambiguous_ipv4(u.host)) {
    return Err(InvalidUrl("an IPv4 address that is not four decimal octets"));
  }
  return Ok(u);
}

// `__ambiguous_ipv4(host)` — a host whose last label starts with a digit
// (no top-level domain does) and that is not a dotted quad: a number a
// resolver may read as an address.
function __ambiguous_ipv4(host: string): boolean {
  if (host.index_of(":") >= 0) {
    return false;
  }
  var end: i32 = host.len();
  if (end > 0 && host[end - 1] == 46) {
    end = end - 1;
  }
  var start: i32 = slice_unchecked(host, 0, end).to_owned().last_index_of(".") + 1;
  if (start >= end || host[start] < 48 || host[start] > 57) {
    return false;
  }
  match (net.ipv4_parse(host)) {
    Some(a) => {
      return false;
    },
    None => {
      return true;
    }
  }
  return true;
}

// `__request_target(u)` — the origin-form request-target of `u`: its
// path (`/` for none) and query, when they can stand on a request line.
function __request_target(u: Url): Result[string, FetchError] {
  var target: string = u.path;
  if (target.len() == 0) {
    target = "/";
  }
  if (u.query.len() > 0) {
    target = target + "?" + u.query;
  }
  if (!http.http_target_ok(target)) {
    return Err(InvalidUrl("a path or query that cannot be written on a request line"));
  }
  return Ok(target);
}

// `__request_ok(req)` — the request refused before a byte is written when
// its method or a header could not be put on the wire as one line, or
// its body is a file. The messages name the rule and never the value,
// which may be the injected bytes themselves.
function __request_ok(req: Request): Result[void, FetchError] {
  if (!http.http_method_ok(req.method)) {
    return Err(InvalidRequest("the method is not a token"));
  }
  var i: i32 = 0;
  while (i < req.headers.names.len()) {
    if (!http.http_field_name_ok(req.headers.names[i])) {
      return Err(InvalidRequest("a header name is not a token"));
    }
    if (!http.http_field_value_ok(req.headers.values[i])) {
      return Err(InvalidRequest("a header value has a byte that cannot be written"));
    }
    i = i + 1;
  }
  match (req.body) {
    BodyFile(path) => {
      return Err(InvalidRequest("a file body cannot be sent"));
    },
    _ => {}
  }
  return Ok(());
}

// `__host_field(host, port)` — the `Host` value: the host, bracketed when
// it is an IPv6 address, and the port when it is not the scheme's default.
function __host_field(host: string, port: i32): string {
  var h: string = host;
  if (h.index_of(":") >= 0) {
    h = "[" + h + "]";
  }
  if (port != 80) {
    return h + ":" + int.int_to_string(port);
  }
  return h;
}

// `__head(req, t, body_len)` — the request line and header block: the
// caller's end-to-end fields, then what the client decides.
function __head(req: Request, t: __Target, body_len: i32): string {
  var out: string = req.method + " " + t.target + " HTTP/1.1\r\n" + "Host: " + t.host_field + "\r\n";
  var fields: HeaderMap = http.http_end_to_end(req.headers);
  var i: i32 = 0;
  while (i < fields.names.len()) {
    if (fields.names[i] != "host" && fields.names[i] != "content-length") {
      out = out + fields.names[i] + ": " + fields.values[i] + "\r\n";
    }
    i = i + 1;
  }
  return out + __client_fields(req, t, body_len) + "Connection: close\r\n\r\n";
}

// `__client_fields(req, t, body_len)` — the fields the client decides:
// the body's length (always for a method that usually carries one), the
// `Accept-Encoding: gzip` it undoes itself, and the proxy's credentials
// when the caller wrote none.
function __client_fields(req: Request, t: __Target, body_len: i32): string {
  var out: string = "";
  if (body_len > 0 || req.method == "POST" || req.method == "PUT" || req.method == "PATCH") {
    out = out + "Content-Length: " + int.int_to_string(body_len) + "\r\n";
  }
  if (__asks_gzip(req)) {
    out = out + "Accept-Encoding: gzip\r\n";
  }
  if (t.proxy_auth.len() > 0 && !__holds(req.headers.names, "proxy-authorization")) {
    out = out + "Proxy-Authorization: " + t.proxy_auth + "\r\n";
  }
  return out;
}

// `__asks_gzip(req)` — whether the client writes `Accept-Encoding: gzip`
// for `req`, and so undoes the coding: a depth above 0 and no
// `Accept-Encoding` of the caller's own, whose codings are theirs to undo.
function __asks_gzip(req: Request): boolean {
  return req.decoding.depth > 0 && !__holds(req.headers.names, "accept-encoding");
}

// `send(req)` — the request sent and its response read, as the module
// comment says: a 3xx with a `Location` is followed up to
// `req.redirects` hops, all under the one total bound. Blocking: every
// connection is closed before it answers.
pub function send(req: Request): Result[HttpResponse, FetchError] {
  return __send_as(req, __Policy { public_only: false, proxies: proxy_env() });
}

// `__Policy` — what a route may reach: `public_only` refuses a host that
// resolves to an address `net.is_global` does not admit; `proxies` is the
// environment's proxy configuration, read once per `send`.
struct __Policy { public_only: boolean, proxies: ProxyEnv }

// `__send_as(req, policy)` — `send` under a route's policy.
function __send_as(req: Request, policy: __Policy): Result[HttpResponse, FetchError] {
  var started: i64 = monotonic_ns();
  var cur: Request = req;
  var hops: i32 = 0;
  while (true) {
    var resp: HttpResponse = __send_once(cur, started, policy)?;
    if (!__redirects(resp.status) || req.redirects == 0) {
      return Ok(resp);
    }
    if (hops >= req.redirects) {
      return Err(Redirect("more than " + int.int_to_string(req.redirects) + " redirects"));
    }
    hops = hops + 1;
    cur = __next_hop(cur, resp)?;
  }
  return Err(Redirect("unreachable"));
}

// `__redirects(status)` — whether a status sends the client elsewhere:
// 301, 302, 303, 307 and 308 (RFC 9110 §15.4).
function __redirects(status: i32): boolean {
  return status == 301 || status == 302 || status == 303 || status == 307 || status == 308;
}

// `__next_hop(cur, resp)` — the request for `resp`'s `Location`: the
// method and body kept on a 307 and 308, a GET with no body on a 303 and
// on a 301 or 302 answering a POST (RFC 9110 §15.4), and the credentials
// (`Authorization`, `Proxy-Authorization`, `Cookie`) dropped when the hop
// leaves the origin. `Host` is written per hop by the client.
function __next_hop(cur: Request, resp: HttpResponse): Result[Request, FetchError] {
  var location: string = "";
  match (resp.headers.get("location")) {
    Some(l) => {
      location = l;
    },
    None => {
      return Err(Redirect("a " + int.int_to_string(resp.status) + " without a Location"));
    }
  }
  var target: string = "";
  match (url.url_resolve(cur.url, location)) {
    Some(t) => {
      target = t;
    },
    None => {
      return Err(Redirect("a Location that is not a URL"));
    }
  }
  var next: Request = Request { ...cur, url: target };
  if (__rewrites_to_get(resp.status, cur.method)) {
    var none: u8[] = [];
    next = Request { ...next, method: "GET", body: BodyBytes(none), headers: __without(next.headers, ["content-type", "content-length"]) };
  }
  if (!__same_origin(cur.url, target)) {
    next = Request { ...next, headers: __without(next.headers, ["authorization", "proxy-authorization", "cookie"]) };
  }
  return Ok(next);
}

// `__rewrites_to_get(status, method)` — whether the hop becomes a GET
// without the body: a 303 for anything but HEAD, and a 301 or 302
// answering a POST, as browsers do (RFC 9110 §15.4.2 to §15.4.4).
function __rewrites_to_get(status: i32, method: string): boolean {
  if (status == 303) {
    return method != "HEAD";
  }
  return (status == 301 || status == 302) && method == "POST";
}

// `__without(h, names)` — `h` less the fields named (case-folded names).
function __without(h: HeaderMap, names: string[]): HeaderMap {
  var out: HeaderMap = headers.header_map_new();
  var i: i32 = 0;
  while (i < h.names.len()) {
    if (!__holds(names, h.names[i])) {
      out = out.append(h.names[i], h.values[i]);
    }
    i = i + 1;
  }
  return out;
}

function __holds(names: string[], name: string): boolean {
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

// `__same_origin(a, b)` — whether two URLs share scheme, host (ASCII
// case-folded) and effective port, the origin a credential is scoped to.
function __same_origin(a: string, b: string): boolean {
  var ua: Url = Url { scheme: "", host: "", port: 0, path: "", query: "", fragment: "" };
  var ub: Url = ua;
  match (url.url_parse(a)) {
    Some(p) => {
      ua = p;
    },
    None => {
      return false;
    }
  }
  match (url.url_parse(b)) {
    Some(p) => {
      ub = p;
    },
    None => {
      return false;
    }
  }
  return ua.scheme.to_lower() == ub.scheme.to_lower() && ua.host.to_lower() == ub.host.to_lower() && __effective_port(ua) == __effective_port(ub);
}

function __effective_port(u: Url): i32 {
  if (u.port != 0) {
    return u.port;
  }
  if (u.scheme == "https") {
    return 443;
  }
  return 80;
}

// `__send_once(req, started, policy)` — one hop: the request validated,
// its origin resolved and checked when the route reaches global addresses
// only and a proxy carries the request (the proxy's address is the
// deployment's choice and goes unchecked), then sent
// and its response read, and sent once more when the peer reset the
// connection before any response byte and the method is idempotent
// (RFC 9110 §9.2.2): a reset before an answer says nothing happened.
function __send_once(req: Request, started: i64, policy: __Policy): Result[HttpResponse, FetchError] {
  var t: __Target = __target_of(req.url, policy)?;
  match (__request_ok(req)) {
    Ok(_) => {},
    Err(e) => {
      return Err(e);
    }
  }
  __origin_checked(t, policy)?;
  var guard: boolean = policy.public_only && t.direct;
  var first: Result[HttpResponse, FetchError] = __attempt(req, t, started, guard);
  match (first) {
    Err(e) => {
      if (__reset(e) && http.http_method_idempotent(req.method)) {
        return __attempt(req, t, started, guard);
      }
      return Err(e);
    },
    Ok(resp) => {
      return Ok(resp);
    }
  }
  return first;
}

// `__origin_checked(t, policy)` — on the route that reaches global
// addresses only, the origin a proxy will reach for `t` resolved and
// checked, as `__connect` checks a host it dials itself; nothing when
// the origin is dialled directly or the route has no such rule.
function __origin_checked(t: __Target, policy: __Policy): Result[void, FetchError] {
  if (policy.public_only && !t.direct) {
    var checked: net.IpAddr[] = __resolve(t.origin, true)?;
  }
  return Ok(());
}

// `__reset(e)` — whether `e` is the peer dropping the connection before
// answering: a reset or abort on the socket, a broken pipe, or the close
// `__read_response` reports when no byte came.
function __reset(e: FetchError): boolean {
  match (e) {
    Io(n) => {
      return n.eq(net.ConnectionReset) || n.eq(net.ConnectionAborted) || n.eq(net.Other(32));
    },
    _ => {
      return false;
    }
  }
  return false;
}

// `__attempt(req, t, started, guard)` — one connection: opened (only to
// a global address when `guard`), the request written, the response
// read, and closed.
function __attempt(req: Request, t: __Target, started: i64, guard: boolean): Result[HttpResponse, FetchError] {
  var sock: i32 = __connect(t, req.timeouts, guard)?;
  var body: u8[] = req.body.bytes();
  var sent: Result[void, FetchError] = __send_all(sock, __head(req, t, body.len()) + string_from_bytes_unchecked(body));
  match (sent) {
    Ok(_) => {},
    Err(e) => {
      tcp_close(sock);
      return Err(e);
    }
  }
  var answer: Result[HttpResponse, FetchError] = __read_response(sock, req, started);
  tcp_close(sock);
  return answer;
}

// `__connect(t, timeouts, guard)` — a connection to the host, resolved
// and raced under the connect bound; with `guard`, refused before the
// race when any address resolved is not a global one.
function __connect(t: __Target, timeouts: Timeouts, guard: boolean): Result[i32, FetchError] {
  var addrs: net.IpAddr[] = __resolve(t.host, guard)?;
  var connect_ms: i32 = timeouts.connect_ms;
  if (timeouts.total_ms < connect_ms) {
    connect_ms = timeouts.total_ms;
  }
  var opts: dns.DialOptions = dns.DialOptions { ...dns.dial_options(), timeout_ms: connect_ms };
  match (dns.connect_race(addrs, t.port, opts)) {
    Ok(sock) => {
      return Ok(sock);
    },
    Err(e) => {
      if (e.eq(net.TimedOut)) {
        return Err(Timeout(Connecting));
      }
      return Err(Connect(e));
    }
  }
  return Err(Timeout(Connecting));
}

// `__resolve(host, guard)` — the addresses of `host` as this machine
// reaches them; with `guard`, refused as `Blocked` when any of them, as
// the network names it before NAT64 synthesis, is not a global address.
function __resolve(host: string, guard: boolean): Result[net.IpAddr[], FetchError] {
  if (!guard) {
    match (dns.resolve(host)) {
      Ok(found) => {
        return Ok(found);
      },
      Err(e) => {
        return Err(Dns(e));
      }
    }
  }
  match (dns.resolve_plain(host)) {
    Ok(plain) => {
      __global_only(plain)?;
      return Ok(dns.synthesized(plain));
    },
    Err(e) => {
      return Err(Dns(e));
    }
  }
  return Err(Dns(dns.NoData));
}

// `__global_only(addrs)` — the refusal naming the first of `addrs` that
// is not a global address, when there is one; an address under a NAT64
// prefix the nameservers reveal is judged by the address it carries.
function __global_only(addrs: net.IpAddr[]): Result[void, FetchError] {
  for a in addrs {
    var seen: net.IpAddr = a;
    match (dns.nat64_carried(a)) {
      Some(v4) => {
        seen = v4;
      },
      None => {}
    }
    if (!seen.is_global()) {
      return Err(Blocked(a.to_string() + " is not a global address"));
    }
  }
  return Ok(());
}

// `__send_all(sock, payload)` — every byte of `payload` written, or the
// failure as the kernel reported it. The payload is handed to `tcp_send`
// as the bytes it holds; a body is not text, and never read as one.
function __send_all(sock: i32, payload: string): Result[void, FetchError] {
  var at: i32 = 0;
  while (at < payload.len()) {
    var n: i32 = tcp_send(sock, slice_unchecked(payload, at, payload.len()).to_owned());
    if (n < 0) {
      return Err(Io(net.error_from_errno(0 - n)));
    }
    if (n == 0) {
      return Err(Io(net.ConnectionReset));
    }
    at = at + n;
  }
  return Ok(());
}

// `__read_response(sock, req, started)` — the response read under the
// inactivity and total bounds, interim 1xx responses stepped over (within
// one header budget for all of them, so a peer cannot stream `100
// Continue` for as long as the timeout allows), and handed back with its
// hop-by-hop fields stripped. The buffer is uniquely owned and grows in
// place, so the read stays linear in the response.
function __read_response(sock: i32, req: Request, started: i64): Result[HttpResponse, FetchError] {
  var buf: u8[] = [];
  var from: i32 = 0;
  var eof: boolean = false;
  while (true) {
    match (http.http_parse_response_framed_from(buf, from, req.method, eof, req.limits)) {
      Complete(framed) => {
        var next: i32 = __after_interim(framed, from, req.limits)?;
        if (next < 0) {
          return __decoded(HttpResponse { ...framed.response, headers: http.http_end_to_end(framed.response.headers) }, req);
        }
        from = next;
        continue;
      },
      Unfinished => {
        if (eof) {
          return Err(__closed_early(buf.len() - from));
        }
      },
      Rejected(code) => {
        return Err(__rejected(code));
      }
    }
    var chunk: u8[] = __recv_bounded(sock, req.timeouts, started)?;
    if (chunk.len() == 0) {
      eof = true;
    } else {
      buf = __append_bytes(buf, chunk);
    }
  }
  return Err(Protocol("unreachable"));
}

// `__append_bytes(buf, chunk)` — `buf` with `chunk` on its end, grown in
// place: `buf` is owned here, so each push lands on a unique array and
// the accumulation over a whole response is one linear pass.
function __append_bytes(own buf: u8[], chunk: u8[]): u8[] {
  var i: i32 = 0;
  while (i < chunk.len()) {
    buf = buf.append(chunk[i]);
    i = i + 1;
  }
  return buf;
}

// `__closed_early(got)` — the peer's close read as the client's error:
// a reset when no byte of the response came, since the request may not
// have been read at all and an idempotent one is sent again, and a
// protocol failure once a response had begun.
function __closed_early(got: i32): FetchError {
  if (got == 0) {
    return Io(net.ConnectionReset);
  }
  return Protocol("the connection closed before the response ended");
}

// `__decoded(resp, req)` — `resp` with its content codings undone when
// the client asked for them: a `Content-Encoding` of `gzip` (or
// `x-gzip`) codings, each undone in turn from the last applied, under
// `req.decoding.depth`, `req.decoding.ratio` and `req.limits.body`, the
// `Content-Encoding` and `Content-Length` fields then dropped since
// neither describes the body any more. A body with no coding, an empty
// one (a HEAD or 204 answer may still name a coding), and a coding the
// client did not ask for are handed back as they came.
function __decoded(resp: HttpResponse, req: Request): Result[HttpResponse, FetchError] {
  var codings: string[] = __codings(resp.headers);
  var body: u8[] = resp.body_bytes();
  if (!__asks_gzip(req) || codings.len() == 0 || body.len() == 0 || !__all_gzip(codings)) {
    return Ok(resp);
  }
  if (codings.len() > req.decoding.depth) {
    return Err(Decode("content codings past the depth of " + int.int_to_string(req.decoding.depth)));
  }
  var left: i32 = codings.len();
  while (left > 0) {
    body = __gunzipped(body, req)?;
    left = left - 1;
  }
  return Ok(HttpResponse { ...resp, body: BodyBytes(body), headers: __without(resp.headers, ["content-encoding", "content-length"]) });
}

// `__codings(h)` — the `Content-Encoding` codings in the order applied,
// each trimmed and case-folded, `identity` dropped.
function __codings(h: HeaderMap): string[] {
  var out: string[] = [];
  for v in h.get_all("content-encoding") {
    for c in v.split(",") {
      var name: string = c.trim().to_lower();
      if (name.len() > 0 && name != "identity") {
        out = out.append(name);
      }
    }
  }
  return out;
}

// `__all_gzip(codings)` — whether every coding is one the client asked
// for.
function __all_gzip(codings: string[]): boolean {
  for c in codings {
    if (c != "gzip" && c != "x-gzip") {
      return false;
    }
  }
  return true;
}

// `__gunzipped(body, req)` — one gzip coding undone, under the body cap
// and the ratio.
function __gunzipped(body: u8[], req: Request): Result[u8[], FetchError] {
  match (deflate.gunzip(body, req.limits.body)) {
    Ok(out) => {
      if (out.len() as i64 > body.len() as i64 * (req.decoding.ratio as i64)) {
        return Err(Decode("a body past " + int.int_to_string(req.decoding.ratio) + " times its encoded size"));
      }
      return Ok(out);
    },
    Err(e) => {
      return Err(__undecodable(e));
    }
  }
  return Ok(body);
}

// `__undecodable(e)` — the decoder's refusal as a `FetchError`: the
// output cap is the body cap, anything else is a `Decode`.
function __undecodable(e: deflate.InflateError): FetchError {
  match (e) {
    deflate.OutputLimit => {
      return BodyLimit;
    },
    _ => {
      return Decode("a gzip body that does not decode: " + e.message());
    }
  }
  return BodyLimit;
}

// `__after_interim(framed, from, limits)` — where the response behind an
// interim `framed` begins, -1 when `framed` is the final response, or
// the refusal: a 101, since what follows a switch is another protocol
// and this client never asks for one, and interim responses past one
// header budget between them.
function __after_interim(framed: http.HttpResponseFramed, from: i32, limits: http.HttpLimits): Result[i32, FetchError] {
  if (framed.response.status == 101) {
    return Err(Protocol("a protocol switch the client did not ask for"));
  }
  if (!__interim(framed.response.status)) {
    return Ok(0 - 1);
  }
  var next: i32 = from + framed.len;
  if (next > limits.header_bytes) {
    return Err(Protocol("interim responses past the header budget"));
  }
  return Ok(next);
}

// `__interim(status)` — whether a status is a 1xx the final response
// follows (RFC 9110 §15.2); `__after_interim` refuses 101 before asking.
function __interim(status: i32): boolean {
  return status >= 100 && status < 200;
}

// `__recv_bounded(sock, timeouts, started)` — the next chunk of the
// response within the tighter of the inactivity bound and what is left
// of the total, or the bound that passed.
function __recv_bounded(sock: i32, timeouts: Timeouts, started: i64): Result[u8[], FetchError] {
  var ns_per_ms: i64 = 1000000;
  var left_ms: i64 = timeouts.total_ms as i64 - (monotonic_ns() - started) / ns_per_ms;
  if (left_ms <= 0) {
    return Err(Timeout(Total));
  }
  var wait_ms: i64 = timeouts.inactivity_ms as i64;
  var bound: Phase = Inactivity;
  if (left_ms < wait_ms) {
    wait_ms = left_ms;
    bound = Total;
  }
  match (tcp.tcp_recv_deadline(sock, 65536, time.duration_millis(wait_ms))) {
    Some(chunk) => {
      return Ok(chunk);
    },
    None => {
      return Err(Timeout(bound));
    }
  }
  return Err(Timeout(bound));
}

// `__rejected(code)` — the parser's refusal as a `FetchError`.
function __rejected(code: i32): FetchError {
  if (code == 413) {
    return BodyLimit;
  }
  if (code == 431) {
    return Protocol("the header block or chunk framing is past its limit");
  }
  if (code == 501) {
    return Protocol("a transfer coding other than chunked");
  }
  if (code == 505) {
    return Protocol("an HTTP version other than 1");
  }
  return Protocol("a malformed response");
}

// `(plat: Platform).http(req)` — `send(req)` through the handler's
// `Platform` bag, the capability-scoped route (docs/PLATFORM-RESEARCH.md
// Rec §1): a handler can only fetch through the platform it was handed,
// and only to a global address (`Blocked` otherwise); a proxy the
// environment names is dialled wherever it is, since the environment is
// the deployment's.
//
// A recording bag reaches no socket: the call is logged as `http` with
// `METHOD url` and answered with what the test canned for that pair
// (std/mock_platform's `http_set`), else `Err(Connect(ConnectionRefused))`,
// what a real request gives for a host that is not listening.
pub function (plat: Platform) http(req: Request): Result[HttpResponse, FetchError] {
  if (!plat.is_mock()) {
    return __send_as(req, __Policy { public_only: true, proxies: proxy_env() });
  }
  var summary: string = req.method + " " + req.url;
  plat.record("http", summary);
  match (plat.canned("http " + summary)) {
    Some(v) => {
      return Ok(__canned_response(v));
    },
    None => {
      return Err(Connect(net.ConnectionRefused));
    }
  }
  return Err(Connect(net.ConnectionRefused));
}

// `__canned_response(v)` — the canned `STATUS BODY` as a response, 200
// when the status does not read.
function __canned_response(v: string): HttpResponse {
  var sp: i32 = v.index_of(" ");
  var code: string = v;
  var body: string = "";
  if (sp >= 0) {
    code = slice_unchecked(v, 0, sp).to_owned();
    body = slice_unchecked(v, sp + 1, v.len()).to_owned();
  }
  var status: i32 = 200;
  match (int.parse_int_radix(code, 10)) {
    Some(n) => {
      status = n;
    },
    None => {}
  }
  return http.text(status, body);
}

// ---------------------------------------------------------------------------
// Proxies

// `ProxyEnv` — the forward-proxy configuration an environment carries:
// `http_proxy`, the proxy for `http` URLs as `[http://][user:password@]host[:port]`,
// empty for none; `no_proxy`, the comma-separated hosts reached directly.
pub struct ProxyEnv { http_proxy: string, no_proxy: string }

// `proxy_env()` — the configuration as the environment sets it, read
// through `config_get` so it arrives the same way on every target (a
// variable where there is an environment, a binding on the proxy world);
// `proxy_env_from` says which names.
pub function proxy_env(): ProxyEnv {
  return proxy_env_from(config_get("http_proxy"), config_get("no_proxy"), config_get("NO_PROXY"), config_get("REQUEST_METHOD"));
}

// `proxy_env_from(http_proxy, no_proxy, no_proxy_upper, request_method)` —
// the configuration from its variables. Only the lowercase `http_proxy`
// is read, as curl reads it: a CGI host turns a client's `Proxy:` request
// header into the uppercase `HTTP_PROXY` (httpoxy). Under `REQUEST_METHOD`,
// the sign of a CGI invocation, no proxy is read at all, since there even
// the lowercase name may be the client's. `no_proxy` is read either way,
// the lowercase name first.
pub function proxy_env_from(http_proxy: Option[string], no_proxy: Option[string], no_proxy_upper: Option[string], request_method: Option[string]): ProxyEnv {
  var proxy: string = "";
  match (http_proxy) {
    Some(p) => {
      proxy = p;
    },
    None => {}
  }
  match (request_method) {
    Some(m) => {
      proxy = "";
    },
    None => {}
  }
  var skip: string = "";
  match (no_proxy) {
    Some(n) => {
      skip = n;
    },
    None => {
      match (no_proxy_upper) {
        Some(n) => {
          skip = n;
        },
        None => {}
      }
    }
  }
  return ProxyEnv { http_proxy: proxy, no_proxy: skip };
}

// `(p).proxy_for(url)` — the proxy a request for `url` goes through, or
// `None` for a direct connection: no `http_proxy`; a host that is
// `localhost`, under it, or a loopback address, never proxied whatever
// `no_proxy` says; or a host `no_proxy` names. An entry of `no_proxy` is
// `*` for every host; an address block in CIDR notation (`10.0.0.0/8`,
// `fd00::/8`) for a host that is an address in it; an address, bracketed
// or not, its zone ignored (a zone in an entry is what let `[::1%25.example.com]`
// pass as a subdomain elsewhere); or a domain, matching the host and its
// subdomains, only the subdomains with a leading dot. A `:port` on an
// entry limits it to that port. Names compare ASCII case-folded, without
// a trailing dot.
pub function (p: ProxyEnv) proxy_for(target_url: string): Option[string] {
  if (p.http_proxy.len() == 0) {
    return None;
  }
  var u: Url = Url { scheme: "", host: "", port: 0, path: "", query: "", fragment: "" };
  match (url.url_parse(target_url)) {
    Some(parsed) => {
      u = parsed;
    },
    None => {
      return None;
    }
  }
  var host: string = __host_name(u.host);
  var ip: Option[net.IpAddr] = __canonical_ip(host);
  if (__never_proxied(host, ip)) {
    return None;
  }
  for entry in p.no_proxy.split(",") {
    if (__no_proxy_matches(entry.trim(), host, __effective_port(u), ip)) {
      return None;
    }
  }
  return Some(p.http_proxy);
}

// `__never_proxied(host, ip)` — `localhost`, a name under it, or a
// loopback address: reached directly whatever `no_proxy` says.
function __never_proxied(host: string, ip: Option[net.IpAddr]): boolean {
  if (host == "localhost" || host.ends_with(".localhost")) {
    return true;
  }
  match (ip) {
    Some(a) => {
      return a.is_loopback();
    },
    None => {
      return false;
    }
  }
  return false;
}

// `__host_name(h)` — `h` ASCII case-folded, its trailing dot dropped.
function __host_name(h: string): string {
  var s: string = h.to_lower();
  if (s.len() > 1 && s.ends_with(".")) {
    return slice_unchecked(s, 0, s.len() - 1).to_owned();
  }
  return s;
}

// `__canonical_ip(text)` — `text` as an address, an IPv4 one unwrapped
// from its IPv6 form, or `None` for a name.
function __canonical_ip(text: string): Option[net.IpAddr] {
  match (net.ip_parse(text)) {
    Some(a) => {
      return Some(a.to_canonical());
    },
    None => {
      return None;
    }
  }
  return None;
}

// One `no_proxy` entry: its name, address or block, and the port it is
// limited to (0 for any, -1 for a port that does not read).
struct __Rule { name: string, port: i32 }

// `__no_proxy_matches(entry, host, port, ip)` — whether one `no_proxy`
// entry names `host` (an address `ip` when it is one) at `port`.
function __no_proxy_matches(entry: string, host: string, port: i32, ip: Option[net.IpAddr]): boolean {
  if (entry.len() == 0) {
    return false;
  }
  if (entry == "*") {
    return true;
  }
  var rule: __Rule = __entry_rule(entry);
  if (rule.port != 0 && rule.port != port) {
    return false;
  }
  var name: string = __host_name(rule.name);
  if (name.index_of("/") >= 0) {
    return __in_block(ip, name);
  }
  match (__canonical_ip(name)) {
    Some(a) => {
      return __same_ip(ip, a);
    },
    None => {}
  }
  if (name.starts_with(".")) {
    return host.ends_with(name);
  }
  return host == name || host.ends_with("." + name);
}

// `__entry_rule(entry)` — `entry` split into what it names and its
// `:port`: a bracketed address keeps its brackets' contents, a bare one
// with more than one colon is an IPv6 address with no port, and a zone
// (`%eth0`) is dropped from either, a `/bits` after it kept.
function __entry_rule(entry: string): __Rule {
  var name: string = entry;
  var rest: string = "";
  if (entry.starts_with("[")) {
    var close: i32 = entry.index_of("]");
    if (close < 0) {
      return __Rule { name: entry, port: -1 };
    }
    name = slice_unchecked(entry, 1, close).to_owned();
    rest = slice_unchecked(entry, close + 1, entry.len()).to_owned();
  } else {
    var colon: i32 = entry.index_of(":");
    if (colon >= 0 && colon == entry.last_index_of(":")) {
      name = slice_unchecked(entry, 0, colon).to_owned();
      rest = slice_unchecked(entry, colon, entry.len()).to_owned();
    }
  }
  return __Rule { name: __without_zone(name), port: __rule_port(rest) };
}

// `__without_zone(name)` — `name` less its `%zone`, a `/bits` after the
// zone kept.
function __without_zone(name: string): string {
  var zone: i32 = name.index_of("%");
  if (zone < 0) {
    return name;
  }
  var after: string = slice_unchecked(name, zone, name.len()).to_owned();
  var slash: i32 = after.index_of("/");
  if (slash < 0) {
    return slice_unchecked(name, 0, zone).to_owned();
  }
  return slice_unchecked(name, 0, zone).to_owned() + slice_unchecked(after, slash, after.len()).to_owned();
}

// `__rule_port(rest)` — the port of a `:port`, 0 for nothing, -1 for
// anything else.
function __rule_port(rest: string): i32 {
  if (rest.len() == 0) {
    return 0;
  }
  if (!rest.starts_with(":")) {
    return -1;
  }
  match (int.parse_int_radix(slice_unchecked(rest, 1, rest.len()).to_owned(), 10)) {
    Some(n) => {
      if (n > 0 && n < 65536) {
        return n;
      }
      return -1;
    },
    None => {
      return -1;
    }
  }
  return -1;
}

// `__same_ip(ip, a)` — whether the host is the address `a`.
function __same_ip(ip: Option[net.IpAddr], a: net.IpAddr): boolean {
  match (ip) {
    Some(h) => {
      return h.eq(a);
    },
    None => {
      return false;
    }
  }
  return false;
}

// `__in_block(ip, block)` — whether the host is an address in the CIDR
// `block`.
function __in_block(ip: Option[net.IpAddr], block: string): boolean {
  var slash: i32 = block.index_of("/");
  var bits: i32 = -1;
  match (int.parse_int_radix(slice_unchecked(block, slash + 1, block.len()).to_owned(), 10)) {
    Some(n) => {
      bits = n;
    },
    None => {}
  }
  var prefix: Option[net.IpAddr] = __canonical_ip(slice_unchecked(block, 0, slash).to_owned());
  match (ip) {
    Some(a) => {
      match (prefix) {
        Some(p) => {
          return __prefix_matches(a, p, bits);
        },
        None => {
          return false;
        }
      }
    },
    None => {
      return false;
    }
  }
  return false;
}

// `__prefix_matches(a, p, bits)` — same family and the first `bits` bits
// equal.
function __prefix_matches(a: net.IpAddr, p: net.IpAddr, bits: i32): boolean {
  var ab: u8[] = a.bytes();
  var pb: u8[] = p.bytes();
  if (ab.len() != pb.len() || bits < 0 || bits > ab.len() * 8) {
    return false;
  }
  var i: i32 = 0;
  while (i * 8 + 8 <= bits) {
    if (ab[i] != pb[i]) {
      return false;
    }
    i = i + 1;
  }
  var rem: i32 = bits - i * 8;
  if (rem == 0) {
    return true;
  }
  var mask: i32 = 255 << 8 - rem & 255;
  return (ab[i] as i32 & mask) == (pb[i] as i32 & mask);
}

// The proxy `http_proxy` names: where to dial it and the
// `Proxy-Authorization` value its credentials make, empty for none.
struct __Proxy { host: string, port: i32, auth: string }

// `__proxy_of(spec)` — `spec` as `[http://][user:password@]host[:port]`,
// port 80 when none, or why it names no proxy this client can use.
function __proxy_of(spec: string): Result[__Proxy, FetchError] {
  var full: string = spec;
  if (full.index_of("://") < 0) {
    full = "http://" + full;
  }
  var u: Url = Url { scheme: "", host: "", port: 0, path: "", query: "", fragment: "" };
  match (url.url_parse(full)) {
    Some(parsed) => {
      u = parsed;
    },
    None => {
      return Err(InvalidUrl("http_proxy is not a URL"));
    }
  }
  if (u.scheme != "http" || u.host.len() == 0) {
    return Err(InvalidUrl("http_proxy is not an http URL with a host"));
  }
  var port: i32 = u.port;
  if (port == 0) {
    port = 80;
  }
  return Ok(__Proxy { host: u.host, port: port, auth: __proxy_auth(full) });
}

// `__proxy_auth(full)` — `Basic` with the URL's userinfo as RFC 7617's
// `user:password`, the colon supplied when the URL names no password; or
// empty.
function __proxy_auth(full: string): string {
  var start: i32 = full.index_of("://") + 3;
  var end: i32 = full.len();
  var slash: i32 = slice_unchecked(full, start, end).to_owned().index_of("/");
  if (slash >= 0) {
    end = start + slash;
  }
  var authority: string = slice_unchecked(full, start, end).to_owned();
  var at: i32 = authority.last_index_of("@");
  if (at < 0) {
    return "";
  }
  var userinfo: string = slice_unchecked(authority, 0, at).to_owned();
  if (userinfo.index_of(":") < 0) {
    userinfo = userinfo + ":";
  }
  return "Basic " + base64.base64_encode(userinfo.bytes());
}

// ---------------------------------------------------------------------------
// The awaitable fetch

// __join_bytes(chunks) — the chunk list flattened into one buffer, sized
// up front so the fill is a single pass over a uniquely-owned array.
//
// `__fetch_drain` collects its `recv` buffers into a list and joins once,
// because its accumulator is captured by `resume`: a second reference
// makes every append copy the whole response so far, and
// `__arr_push_shared_count()` is what makes that visible. The blocking
// client's buffer has no second reference, so it appends in place
// (`__append_bytes`) instead.
function __join_bytes(chunks: u8[][]): u8[] {
  var total: i32 = 0;
  var k: i32 = 0;
  while (k < chunks.len()) {
    total = total + chunks[k].len();
    k = k + 1;
  }
  var out: u8[] = __alloc_u8(total);
  var w: i32 = 0;
  var j: i32 = 0;
  while (j < chunks.len()) {
    var i: i32 = 0;
    var n: i32 = chunks[j].len();
    while (i < n) {
      out = out.with(w, chunks[j][i]);
      w = w + 1;
      i = i + 1;
    }
    j = j + 1;
  }
  return out;
}

// fetch_future(host_be, port, path) — the AWAITABLE fetch: open a
// connection and send the request NON-blocking, then return a
// `Future[u8[]]` that resolves to the response body once the socket
// is readable. This is the combinator-surface fetch
// (docs/ASYNC-REDESIGN.md): drive several through `async.gather` and
// their reads overlap on one thread —
//
//   var none: u8[] = [];
//   var bodies = async.gather([
//       fetch.fetch_future(cache, 80, "/k"),
//       fetch.fetch_future(primary, 80, "/k"),
//   ], none);
//
// On a connect/send failure it resolves immediately to the empty body (a
// `Ready` future), so a failed upstream doesn't stall the fan-out, and so
// does a response the parser refuses or a `path` that cannot stand on a
// request line (`http_target_ok`), which is refused before connecting. The
// read is STREAMING — `__fetch_drain` re-suspends per chunk and accumulates, so
// the whole response comes back (not just one `recv` buffer) while
// staying overlapped with the other futures. PORTABLE native + wasm: the
// wait token is `tcp_pollable(c)` — the raw fd on native (identity), a
// real wasi:io/poll pollable handle on wasm — so `poll` (poll(2) /
// ppoll(2) native, wasi:io/poll.poll on wasm) drives it either way. The
// continuation captures the connection `c` (it reads the socket, not the
// woken token, which differs by backend). On interp the `poll` stub
// means the `Pending` never resolves (consistent with std/async).
pub function fetch_future(host_be: i32, port: i32, path: string): async.Future[u8[]] {
  var empty: u8[] = [];
  if (!http.http_target_ok(path)) {
    return Ready(empty);
  }
  var request: string = "GET " + path + " HTTP/1.1\r\nHost: fern\r\nConnection: close\r\n\r\n";
  var c: i32 = tcp_connect(host_be, port);
  if (c < 0) {
    return Ready(empty);
  }
  if (tcp_send(c, request) < 0) {
    tcp_close(c);
    return Ready(empty);
  }
  var no_chunks: u8[][] = [];
  return __fetch_drain(c, no_chunks);
}

// __fetch_drain(c, chunks) — one step of the streaming response read: a `Future`
// that, once `c` is readable, drops the woken pollable, `recv`s a chunk, and
// either FINISHES (empty recv = EOF, since we send `Connection: close`) by
// returning the parsed body, or RE-SUSPENDS to read more. `chunks` carries the
// buffers read so far across re-suspends, so a response spanning multiple recv
// buffers / TCP segments is read in FULL. Re-suspending (rather than looping
// `recv` synchronously) keeps the read overlapped with the other futures in a
// `gather`/`race`. At most one pollable is live at a time (each step drops the
// previous before subscribing the next), so the socket has no child pollable
// when `tcp_close` runs.
//
// It carries a LIST of chunks rather than one growing buffer because the
// accumulator is captured by `resume`: a captured array is a second
// reference, so appending to it copies the whole thing on every step, and
// concatenating bytes that way is quadratic in the response size. Appending
// the chunk POINTER is quadratic only in the chunk COUNT, and `__join_bytes`
// pays one linear pass at EOF.
function __fetch_drain(c: i32, chunks: u8[][]): async.Future[u8[]] {
  function resume(woken: i32): async.Future[u8[]] {
    var dropped: i32 = wasm_pollable_drop(woken);
    var chunk: u8[] = tcp_recv(c, 4096);
    if (chunk.len() == 0) {
      tcp_close(c);
      return Ready(__body_of(__join_bytes(chunks)));
    }
    return __fetch_drain(c, chunks.append(chunk));
  }
  return Pending(tcp_pollable(c), resume);
}

// `__body_of(raw)` — the body of the whole response `raw`, decoded under
// its framing, or empty for one the parser refuses.
function __body_of(raw: u8[]): u8[] {
  match (http.http_parse_response_framed(raw, "GET", true, http.http_limits())) {
    Complete(framed) => {
      return framed.response.body_bytes();
    },
    _ => {
      var empty: u8[] = [];
      return empty;
    }
  }
  var none: u8[] = [];
  return none;
}
