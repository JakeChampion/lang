// _db_word decodes the 64-bit word that starts at `at`: 11 characters, most
// significant base-64 digit first. The accumulator cannot overflow because
// every encoded word is itself a 64-bit value.
function _db_word(s: string, at: i32): u64 {
  let v: u64 = 0 as u64;
  let i: i32 = at;
  let end: i32 = at + 11;
  while (i < end) {
    let c: i32 = s[i] as i32;
    if (c < 92) {
      c = c - 48;
    } else {
      c = c - 49;
    }
    v = v << 6 as u64 | c as u64;
    i = i + 1;
  }
  return v;
}

// floor(log10(2^e)), floor(log2(10^e)) and floor(log10(2^e * 3/4)) — the
// magic-multiply approximations from the reference, exact over the exponent
// ranges Dragonbox uses. `>>` on a negative i32 floors, which is what these
// need. Every product stays well inside i32.
function _db_log10_pow2(e: i32): i32 {
  return e * 315653 >> 20;
}

function _db_log2_pow10(e: i32): i32 {
  return e * 1741647 >> 19;
}

function _db_log10_pow2_m43(e: i32): i32 {
  return e * 631305 - 261663 >> 21;
}

// _db_mul_hi is the high half of the 64x64 -> 128 widening multiply; the low
// half is the machine's wrapping product. Scalar results throughout this file
// rather than pairs, because a returned tuple is a heap cell.
function _db_mul_hi(x: u64, y: u64): u64 {
  return __mulhi_u64(x, y);
}

// _db_mul192_hi / _db_mul192_lo are the upper 128 bits of (64-bit x) *
// (128-bit cache), a word each. `lo == 0` is Dragonbox's integer check.
function _db_mul192_lo(x: u64, chi: u64, clo: u64): u64 {
  return x * chi + _db_mul_hi(x, clo);
}

function _db_mul192_hi(x: u64, chi: u64, clo: u64): u64 {
  let hi: u64 = _db_mul_hi(x, chi);
  if (_db_mul192_lo(x, chi, clo) < x * chi) {  // carry out of the low half
    hi = hi + 1 as u64;
  }
  return hi;
}

// _db_parity64 answers bit 0 set for parity and bit 1 set for is_integer,
// of the lower 128 bits of two_f * cache: the tie-break probe Dragonbox
// uses at the interval endpoints. beta is in [6, 9] here, so both shifts
// stay in range.
function _db_parity64(two_f: u64, chi: u64, clo: u64, beta: i32): i32 {
  let hi: u64 = two_f * chi + _db_mul_hi(two_f, clo);
  let lo: u64 = two_f * clo;
  let back: u64 = (64 - beta) as u64;
  let flags: i32 = (hi >> back & 1 as u64) as i32;
  if ((hi << beta as u64 | lo >> back) == 0 as u64) {
    flags = flags + 2;
  }
  return flags;
}

// _db_rtz strips trailing zeros from the significand, folding each into the
// decimal exponent. The zero guard is unreachable for a finite non-zero
// input; it is there so a broken invariant can never hang the formatter.
function _db_rtz(sig: u64, exp: i32): (i64, i32) {
  while (sig != 0 as u64 && sig % (10 as u64) == 0 as u64) {
    sig = sig / (10 as u64);
    exp = exp + 1;
  }
  return (sig as i64, exp);
}

// __db_shortest64 returns (significand, decimal exponent) for a POSITIVE
// finite f64, with value == significand * 10^exponent and the significand as
// short as round-tripping allows. kappa is 2 for binary64, so the divisors
// below are 10^3 and 10^2.
function __db_shortest64(n: f64): (i64, i32) {
  let bits: u64 = f64_bits(n) as u64;
  let ebits: i32 = (bits >> 52 as u64 & 2047 as u64) as i32;
  let two_fc: u64 = (bits & 4503599627370495 as u64) << 1 as u64;
  // A closed interval means both endpoints round back to n, which is the
  // case exactly when the significand is even (round-half-to-even).
  let closed: boolean = (bits & 1 as u64) == 0 as u64;
  let be: i32 = 0 - 1074;
  if (ebits != 0) {
    be = ebits - 1075;
    // A power of two has a shorter interval on its left side.
    if (two_fc == 0 as u64) {
      return __db_shorter64(be);
    }
    two_fc = two_fc | 9007199254740992 as u64;  // implicit bit, << 1
  }

  let mk: i32 = _db_log10_pow2(be) - 2;
  let k: i32 = 0 - mk;
  let beta: i32 = be + _db_log2_pow10(k);
  let tbl: string = _db_cache64();
  let at: i32 = (k + 292) * 22;
  let chi: u64 = _db_word(tbl, at);
  let clo: u64 = _db_word(tbl, at + 11);

  let deltai: u64 = chi >> (63 - beta) as u64;
  let zx: u64 = (two_fc | 1 as u64) << beta as u64;
  let zi: u64 = _db_mul192_hi(zx, chi, clo);
  let z_int: boolean = _db_mul192_lo(zx, chi, clo) == 0 as u64;

  let sig: u64 = zi / (1000 as u64);
  let r: u64 = zi - 1000 as u64 * sig;

  // Step 2: try the larger divisor. Falling through to the return means the
  // shorter significand is in the interval; every other path drops to step 3.
  let smaller: boolean = false;
  if (r < deltai) {
    if (r == 0 as u64 && z_int && !closed) {
      sig = sig - 1 as u64;
      r = 1000 as u64;
      smaller = true;
    }
  } else if (r > deltai) {
    smaller = true;
  } else {
    let xp: i32 = _db_parity64(two_fc - 1 as u64, chi, clo, beta);
    if (!((xp & 1) != 0 || (xp & 2) != 0 && closed)) {
      smaller = true;
    }
  }
  if (!smaller) {
    return _db_rtz(sig, mk + 3);
  }

  // Step 3: find the significand with the smaller divisor. r >= deltai here
  // (or r was reset to 1000), and deltai < 1000, so `dist` cannot underflow.
  sig = sig * (10 as u64);
  let dist: u64 = r - deltai / (2 as u64) + 50 as u64;
  // The reference computes ((dist ^ (small_divisor / 2)) & 1) != 0; here
  // small_divisor / 2 is 50, which is even, so this is just dist's parity.
  let approx: boolean = (dist & 1 as u64) != 0 as u64;
  let divisible: boolean = dist % (100 as u64) == 0 as u64;
  sig = sig + dist / (100 as u64);
  if (divisible) {
    let yp: i32 = _db_parity64(two_fc, chi, clo, beta);
    if ((yp & 1) != 0 != approx) {
      sig = sig - 1 as u64;
    } else if (sig % (2 as u64) != 0 as u64 && (yp & 2) != 0) {
      sig = sig - 1 as u64;
    }
  }
  return (sig as i64, mk + 2);
}

// __db_shorter64 handles the asymmetric interval at a power of two, where the
// gap below n is half the gap above it. The interval is closed under
// nearest-to-even, so the right endpoint is never pulled in; the left one is
// nudged up unless it lands on an integer.
function __db_shorter64(be: i32): (i64, i32) {
  let mk: i32 = _db_log10_pow2_m43(be);
  let k: i32 = 0 - mk;
  let beta: i32 = be + _db_log2_pow10(k);
  let chi: u64 = _db_word(_db_cache64(), (k + 292) * 22);

  let sh: u64 = (11 - beta) as u64;
  let xi: u64 = chi - (chi >> 54 as u64) >> sh;
  let zi: u64 = chi + (chi >> 53 as u64) >> sh;
  if (!(be >= 2 && be <= 3)) {
    xi = xi + 1 as u64;
  }

  let sig: u64 = zi / (10 as u64);
  if (sig * (10 as u64) >= xi) {
    return _db_rtz(sig, mk + 1);
  }

  sig = ((chi >> (10 - beta) as u64) + 1 as u64) / (2 as u64);
  // be == -77 is the only binary exponent where the rounded-up y can tie.
  if (sig % (2 as u64) != 0 as u64 && be == 0 - 77) {
    sig = sig - 1 as u64;
  } else if (sig < xi) {
    sig = sig + 1 as u64;
  }
  return (sig as i64, mk);
}

// __db_shortest32 is the binary32 sibling: 23-bit fraction, 8-bit exponent,
// a 64-bit cache instead of 128-bit, and kappa 1 (divisors 10^2 and 10^1).
function __db_shortest32(n: f32): (i64, i32) {
  let bits: u64 = (f32_bits(n) as i64) as u64;
  let ebits: i32 = (bits >> 23 as u64 & 255 as u64) as i32;
  let two_fc: u64 = (bits & 8388607 as u64) << 1 as u64;
  let closed: boolean = (bits & 1 as u64) == 0 as u64;
  let be: i32 = 0 - 149;
  if (ebits != 0) {
    be = ebits - 150;
    if (two_fc == 0 as u64) {
      return __db_shorter32(be);
    }
    two_fc = two_fc | 16777216 as u64;  // implicit bit, << 1
  }

  let mk: i32 = _db_log10_pow2(be) - 1;
  let k: i32 = 0 - mk;
  let beta: i32 = be + _db_log2_pow10(k);
  let c: u64 = _db_word(_db_cache32(), (k + 31) * 11);

  let deltai: u64 = c >> (63 - beta) as u64;
  // The binary32 product is 96-bit: widen the 32-bit operand into the high
  // half and keep the upper 64 bits.
  let prod: u64 = _db_mul_hi((two_fc | 1 as u64) << beta as u64 << 32 as u64, c);
  let zi: u64 = prod >> 32 as u64;
  let z_int: boolean = (prod & 4294967295 as u64) == 0 as u64;

  let sig: u64 = zi / (100 as u64);
  let r: u64 = zi - 100 as u64 * sig;

  let smaller: boolean = false;
  if (r < deltai) {
    if (r == 0 as u64 && z_int && !closed) {
      sig = sig - 1 as u64;
      r = 100 as u64;
      smaller = true;
    }
  } else if (r > deltai) {
    smaller = true;
  } else {
    let xp: i32 = _db_parity32(two_fc - 1 as u64, c, beta);
    if (!((xp & 1) != 0 || (xp & 2) != 0 && closed)) {
      smaller = true;
    }
  }
  if (!smaller) {
    return _db_rtz(sig, mk + 2);
  }

  sig = sig * (10 as u64);
  let dist: u64 = r - deltai / (2 as u64) + 5 as u64;
  // Here small_divisor / 2 is 5, which is ODD, so ((dist ^ 5) & 1) != 0
  // inverts dist's parity.
  let approx: boolean = (dist & 1 as u64) == 0 as u64;
  let divisible: boolean = dist % (10 as u64) == 0 as u64;
  sig = sig + dist / (10 as u64);
  if (divisible) {
    let yp: i32 = _db_parity32(two_fc, c, beta);
    if ((yp & 1) != 0 != approx) {
      sig = sig - 1 as u64;
    } else if (sig % (2 as u64) != 0 as u64 && (yp & 2) != 0) {
      sig = sig - 1 as u64;
    }
  }
  return (sig as i64, mk + 1);
}

// _db_parity32 is _db_parity64's 96-bit counterpart: the low 64 bits of the
// product carry everything it needs. beta is in [3, 6] here.
function _db_parity32(two_f: u64, c: u64, beta: i32): i32 {
  let r: u64 = two_f * c;
  let flags: i32 = (r >> (64 - beta) as u64 & 1 as u64) as i32;
  if ((r >> (32 - beta) as u64 & 4294967295 as u64) == 0 as u64) {
    flags = flags + 2;
  }
  return flags;
}

function __db_shorter32(be: i32): (i64, i32) {
  let mk: i32 = _db_log10_pow2_m43(be);
  let k: i32 = 0 - mk;
  let beta: i32 = be + _db_log2_pow10(k);
  let c: u64 = _db_word(_db_cache32(), (k + 31) * 11);

  let sh: u64 = (40 - beta) as u64;
  let xi: u64 = c - (c >> 25 as u64) >> sh;
  let zi: u64 = c + (c >> 24 as u64) >> sh;
  if (!(be >= 2 && be <= 3)) {
    xi = xi + 1 as u64;
  }

  let sig: u64 = zi / (10 as u64);
  if (sig * (10 as u64) >= xi) {
    return _db_rtz(sig, mk + 1);
  }

  sig = ((c >> (39 - beta) as u64) + 1 as u64) / (2 as u64);
  if (sig % (2 as u64) != 0 as u64 && be == 0 - 35) {
    sig = sig - 1 as u64;
  } else if (sig < xi) {
    sig = sig + 1 as u64;
  }
  return (sig as i64, mk);
}

// Format shortest significand `sig` with most-significant-digit decimal
// exponent `msd`: scientific when msd < -4 or msd >= 21, else fixed-point.
// The low threshold is Go / C 'g'; the high one and the unpadded `e+`/`e-`
// spelling are JavaScript's, so 1e20 prints in full where Go %v gives 1e+20.
function __float_fmt_sci(sig: string, msd: i32): string {
  let nd: i32 = sig.len();
  if (msd < 0 - 4 || msd >= 21) {
    // scientific: d[.ddd]e±XX
    let out: string = "" + slice_unchecked(sig, 0, 1);
    if (nd > 1) {
      out = out + "." + slice_unchecked(sig, 1, nd);
    }
    if (msd < 0) {
      return out + "e-" + (0 - msd).to_string();
    }
    return out + "e+" + msd.to_string();
  }
  if (msd < 0) {
    // 0.000sig
    let z: string = "";
    let i: i32 = 0;
    while (i < 0 - msd - 1) {
      z = z + "0";
      i = i + 1;
    }
    return "0." + z + sig;
  }
  if (msd + 1 >= nd) {
    // integer, pad trailing zeros
    let z2: string = "";
    let i2: i32 = 0;
    while (i2 < msd + 1 - nd) {
      z2 = z2 + "0";
      i2 = i2 + 1;
    }
    return sig + z2;
  }
  // point in the middle
  return "" + slice_unchecked(sig, 0, msd + 1) + "." + slice_unchecked(sig, msd + 1, nd);
}

// Render a Dragonbox result — significand `sig` with decimal exponent `exp`,
// value == sig * 10^exp — in Go %v / strconv 'g' style, prefixed by `out`
// (the already-extracted sign). Shared by the f32 and f64 formatters.
function __float_render(out: string, sig: i64, exp: i32): string {
  let digits: string = sig.to_string();
  return out + __float_fmt_sci(digits, digits.len() - 1 + exp);
}

function __float_shortest(n: f64): string {
  if (n != n) {
    return "NaN";
  }
  let out: string = "";
  if (n < 0.0) {
    out = "-";
    n = 0.0 - n;
  }
  if (n != 0.0 && n * 2.0 == n) {
    return out + "Inf";
  }
  if (n == 0.0) {
    return out + "0";
  }
  let d: (i64, i32) = __db_shortest64(n);
  return __float_render(out, d.0, d.1);
}

// f32 shortest-round-trip formatter. Same shape as the f64 path — sign / NaN
// / Inf / 0 handling, then Dragonbox over the binary32 fields — so an f32
// renders with the fewest digits that still parse back to it (e.g. 0.1f32 ->
// "0.1", not "0.099999994").
function __float_shortest_f32(n: f32): string {
  if (n != n) {
    return "NaN";
  }
  let out: string = "";
  if (n < 0.0) {
    out = "-";
    n = 0.0 - n;
  }
  if (n != 0.0 && n * 2.0 == n) {
    return out + "Inf";
  }
  if (n == 0.0) {
    return out + "0";
  }
  let d: (i64, i32) = __db_shortest32(n);
  return __float_render(out, d.0, d.1);
}

pub function (n: f64) to_string(): string {
  return __float_shortest(n);
}

pub function (n: f32) to_string(): string {
  return __float_shortest_f32(n);
}

// `shortest_digits()` — the shortest decimal that reads back as `n`, as
// (significand, exponent) with |n| == significand × 10^exponent and no
// trailing zero on the significand, so its digit count is the fewest any
// decimal of `n` that round-trips can have. Zero, an infinity and NaN
// answer (0, 0). The sign is not part of the answer.
pub function (n: f64) shortest_digits(): (i64, i32) {
  if (n != n || n == 0.0 || n * 2.0 == n) {
    return (0 as i64, 0);
  }
  if (n < 0.0) {
    n = 0.0 - n;
  }
  return __db_trim(__db_shortest64(n));
}

pub function (n: f32) shortest_digits(): (i64, i32) {
  if (n != n || n == 0.0 || n * 2.0 == n) {
    return (0 as i64, 0);
  }
  if (n < 0.0) {
    n = 0.0 - n;
  }
  return __db_trim(__db_shortest32(n));
}

// `pow10_hi(k)` / `pow10_lo(k)` — the 128-bit significand of 10^k the
// shortest search runs on, for a caller doing its own scaled arithmetic:
// with c the two words, 10^k == (c − θ) × 2^(pow10_log2(k) − 127) for some
// 0 ≤ θ < 1 (c is 10^k rounded up), for k in -292..326.
pub function pow10_hi(k: i32): u64 {
  return _db_word(_db_cache64(), (k + 292) * 22);
}

pub function pow10_lo(k: i32): u64 {
  return _db_word(_db_cache64(), (k + 292) * 22 + 11);
}

// `pow10_log2(k)` — floor(log2(10^k)), the exponent `pow10_hi` is stated against.
pub function pow10_log2(k: i32): i32 {
  return _db_log2_pow10(k);
}

function __db_trim(d: (i64, i32)): (i64, i32) {
  let sig: i64 = d.0;
  if (sig % (10 as i64) != 0 as i64) {
    return d;
  }
  let exp: i32 = d.1;
  while (sig % (10 as i64) == 0 as i64) {
    sig = sig / (10 as i64);
    exp = exp + 1;
  }
  return (sig, exp);
}

// __float_to_string_prec renders `n` with EXACTLY `prec` fractional
// digits — no trailing-zero trimming — rounding half away from zero.
// Unlike the default shortest formatter (which emits the fewest digits
// that round-trip), this gives the fixed-width output that table /
// currency formatting wants: `3.14159 @ prec 2` -> "3.14", `2.5 @ prec 0` ->
// "3", `1.0 @ prec 3` -> "1.000". The whole computation stays in the
// float domain via __float_int_part, so no value crosses the
// trapping/non-portable `f64 -> i64` boundary regardless of magnitude.
function __float_to_string_prec(n: f64, prec: i32): string {
  if (n != n) {
    return "NaN";
  }
  let out: string = "";
  if (n < 0.0) {
    out = "-";
    n = 0.0 - n;
  }
  if (n != 0.0 && n * 2.0 == n) {
    return out + "Inf";
  }
  // mult = 10^prec.
  let mult: f64 = 1.0;
  let i: i32 = 0;
  while (i < prec) {
    mult = mult * 10.0;
    i = i + 1;
  }
  // Scale, round half away from zero, and split into integer + fraction
  // halves — both integer-valued f64s now.
  let scaled: f64 = __floor_f64(n * mult + 0.5);
  let intf: f64 = __floor_f64(scaled / mult);
  let fracf: f64 = scaled - intf * mult;
  out = out + __float_int_part(intf);
  if (prec == 0) {
    return out;
  }
  // Zero-pad the fractional digits out to `prec` places.
  let fracStr: string = __float_int_part(fracf);
  while (fracStr.len() < prec) {
    fracStr = "0" + fracStr;
  }
  return out + "." + fracStr;
}

// `to_string_prec(prec)` — fixed-precision rendering with exactly
// `prec` fractional digits (rounded half away from zero). The
// precision-controlled counterpart to `to_string()`, for the
// width/precision table output (issue #2684).
pub function (n: f32) to_string_prec(prec: i32): string {
  return __float_to_string_prec(n as f64, prec);
}

pub function (n: f64) to_string_prec(prec: i32): string {
  return __float_to_string_prec(n, prec);
}

// f64 math methods — receiver-syntax wrappers around the
// checker-injected builtins. Each method's body is a single
// call into the matching `__<op>_f64` primitive, so codegen
// can inline them away entirely on every backend that
// supports float ops natively (every backend except the
// interp, which goes through the builtin's Go-side
// implementation).
//
// All methods follow IEEE-754 semantics: NaN / ±Inf
// propagate, division-by-zero yields ±Inf or NaN per the
// usual rules, no integer-style traps. Callers building
// numerically-sensitive code (`x.sqrt()` on x close to 0,
// `x.log()` on negative x) should compare results against
// the textbook formula for the edge cases — std/float
// doesn't guard.

pub function (x: f64) abs(): f64 {
  return __abs_f64(x);
}

pub function (x: f64) floor(): f64 {
  return __floor_f64(x);
}

pub function (x: f64) ceil(): f64 {
  return __ceil_f64(x);
}

// `round(x)` follows the "round half away from zero"
// convention (matches Go's `math.Round`). Tests that need
// banker's rounding (round half to even) should reach
// into the bit-pattern themselves.
pub function (x: f64) round(): f64 {
  return __round_f64(x);
}

// `round_to(digits)` — round `x` to `digits` decimal places, half away from
// zero (like `round`): `(3.14159).round_to(2)` is `3.14`, `(2.5).round_to(0)`
// is `3.0`. Negative `digits` round to tens / hundreds
// (`(1234.0).round_to(-2)` is `1200.0`). Scales by `10^digits`, rounds, and
// unscales; the usual float-representation caveat applies (the result is the
// nearest f64 to the rounded decimal, which for most display / money use is
// exact enough). NaN / ±Inf pass through unchanged.
pub function (x: f64) round_to(digits: i32): f64 {
  if (x != x) {  // NaN
    return x;
  }
  if (x != 0.0 && x * 2.0 == x) {  // ±Inf
    return x;
  }
  let scale: f64 = 1.0;
  let i: i32 = 0;
  let d: i32 = digits;
  if (d < 0) {
    d = 0 - d;
  }
  while (i < d) {
    scale = scale * 10.0;
    i = i + 1;
  }
  if (digits >= 0) {
    return __round_f64(x * scale) / scale;
  }
  return __round_f64(x / scale) * scale;
}

// `trunc(x)` is round-toward-zero, equivalent to
// `(x as i64) as f64` for values that fit in the i64 range.
// The primitive form handles ±Inf / NaN that the cast
// version would reject.
pub function (x: f64) trunc(): f64 {
  return __trunc_f64(x);
}

pub function (x: f64) sqrt(): f64 {
  return __sqrt_f64(x);
}

// `log2(x)` / `log10(x)` — logarithms in base 2 and base 10, derived from
// the natural log by dividing by `ln(2)` / `ln(10)` (change-of-base).
// `log2(8)` is `3`, `log10(1000)` is `3`; `log2` of a power of two and
// `log10` of a power of ten come out exact up to rounding.
pub function (x: f64) log2(): f64 {
  return x.log() / 0.6931471805599453;
}

pub function (x: f64) log10(): f64 {
  return x.log() / 2.302585092994046;
}

// `exp2(x)` / `exp10(x)` — base-2 and base-10 exponentials, the inverses of
// `log2` / `log10`, via `2^x == e^(x*ln2)` and `10^x == e^(x*ln10)`.
// `exp2(3)` is `8`, `exp2(10)` is `1024`, `exp10(3)` is `1000`; `exp2` of a
// whole number and `exp10` of a whole number land on the exact power up to
// rounding, and both round-trip with their logs (`exp2(x).log2() == x`).
pub function (x: f64) exp2(): f64 {
  return (x * 0.6931471805599453).exp();
}

pub function (x: f64) exp10(): f64 {
  return (x * 2.302585092994046).exp();
}

pub function (x: f64) sin(): f64 {
  return _fd_trig(x, 0);
}

pub function (x: f64) cos(): f64 {
  return _fd_trig(x, 1);
}

// `tan(x)` — tangent, as `sin(x) / cos(x)`. Blows up to ±Inf near the odd
// multiples of π/2 where `cos` crosses zero, as expected.
pub function (x: f64) tan(): f64 {
  return _fd_trig(x, 0) / _fd_trig(x, 1);
}

// ---- exp, log, sin, cos and pow ---------------------------------------------
//
// The one definition of these five: every backend compiles these kernels and
// -interp runs them, so each target computes the same separately rounded
// operations in the same order and they agree bit for bit. exp, sin and cos
// are fdlibm's, reduced Cody-Waite (and Payne-Hanek for a trig argument at or
// past 2^20); log is the table-driven no-FMA algorithm glibc and ARM's
// optimized-routines use, its data generated below; pow is exact repeated
// squaring for an integral exponent and sign * exp(y * log|x|) otherwise.

// _fd_rint is v rounded to an integer, ties to even, for |v| < 2^51: at
// 1.5 * 2^52 a double has no fraction bits left, so the add rounds and the
// subtraction is exact.
function _fd_rint(v: f64): f64 {
  return v + 6755399441055744.0 - 6755399441055744.0;
}

// e^x = 2^k e^r: k = rint(x / ln2), and r = x - k ln2 against ln2 split so
// that k * ln2_hi is exact. 2^k is two half-scales, since one exponent field
// cannot hold a k below -1022 and a multiply by a power of two is exact until
// the result is itself subnormal.
pub function (x: f64) exp(): f64 {
  if (x != x) {
    return x;
  }
  if (x > 709.782712893383973096) {
    return f64_from_bits(0x7ff0000000000000);
  }
  if (x < -745.133219101941108420) {
    return 0.0;
  }
  let kf: f64 = _fd_rint(x * 1.44269504088896338700e+00);
  let hi: f64 = x - kf * 6.93147180369123816490e-01;
  let lo: f64 = kf * 1.90821492927058770002e-10;
  let r: f64 = hi - lo;
  let t: f64 = r * r;
  let c: f64 = r - t * (1.66666666666666019037e-01 + t * (-2.77777777770155933842e-03 + t * (6.61375632143793436117e-05 + t * (-1.65339022054652515390e-06 + t * 4.13813679705723846039e-08))));
  let e: f64 = 1.0 - (lo - r * c / (2.0 - c) - hi);
  let k: i64 = kf as i64;
  let k1: i64 = k >> 1;
  return e * f64_from_bits(k1 + 1023 << 52) * f64_from_bits(k - k1 + 1023 << 52);
}

