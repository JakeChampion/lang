// std/float — f32 / f64 to-string formatting.
//
// Up to 7 fractional digits for f32, 15 for f64 (matching IEEE
// 754 single / double precision); trailing zeros trimmed and
// the decimal point is dropped if the fraction is zero. NaN
// gets the canonical "NaN"; ±Inf get "Inf" / "-Inf". Detection
// of Inf is approximate — the threshold check (`n * 2.0 == n`)
// covers every practically-encountered case but isn't bit-
// exact against `f64.const inf`.
//
// No prelude: these are in scope only after a program
// declares `import "std/float";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

// The formatters dispatch (i64) `.to_string()` (e.g. __float_int_part's
// digit chunks, __float_to_string_prec) and (i32) `.to_string()` (the
// shortest formatter's decimal-exponent rendering). Declare std/i64 and
// std/i32 so those receiver methods register under no-prelude.
import "std/i32";
import "std/i64";

// __float_int_part renders a non-negative, integer-valued f64 that
// is too large for the i64 range (>= 2^63) as decimal digits,
// working entirely in floating point so no value ever crosses the
// trapping/non-portable `as i64` boundary. Digits are peeled off
// least-significant-first via `floor(n / 10)`; the per-step
// remainder is nominally 0..9 but `n / 10` and `* 10` each round,
// so for very large magnitudes it can land just outside that range
// — clamp before indexing the digit table. The printed digits
// reflect the f64's stored (rounded) value — exact for round
// magnitudes like 1e20, approximate where the double itself can't
// represent the integer exactly, which is inherent to f64 and not
// something this formatter can recover.
function __float_int_part(n: f64): string {
    if (n < 1.0) { return "0"; }
    var digits: string = "0123456789";
    // Two-pass exact-size buffer (#4379). Digits peel off least-significant
    // first, so the old `out = digits[d] + out` prepended each one — recopying
    // the whole growing string every step, O(digits²) (up to ~309 digits for
    // the largest f64 magnitudes). Instead: a counting pass sizes the result,
    // then a fill pass writes each digit straight into its final slot from the
    // right. Byte-for-byte identical output.
    var count: i32 = 0;
    var m: f64 = n;
    while (m >= 1.0) {
        m = __floor_f64(m / 10.0);
        count = count + 1;
    }
    var buf: u8[] = __alloc_u8(count);
    var pos: i32 = count - 1;
    while (n >= 1.0) {
        var q: f64 = __floor_f64(n / 10.0);
        var d: i32 = (n - q * 10.0) as i32;
        if (d < 0) { d = 0; }
        if (d > 9) { d = 9; }
        buf = buf.with(pos, digits[d] as u8);
        pos = pos - 1;
        n = q;
    }
    return string_from_bytes_unchecked(buf);
}


// Shortest round-trip f64 formatting (#5536). Exact bignum digit
// generation from the IEEE-754 mantissa/exponent (f64_bits), then the
// shortest significand whose value falls in the ULP interval of n
// (round-half-to-even). No parse_float dependency. Validated against
// Go strconv shortest over extremes, subnormals, and random f64s.
// bignum: i64[] limbs, base 2^32 (4294967296).
function bn_from_i64(v: i64): i64[] { var a: i64[] = []; a = a.append(v & 4294967295); a = a.append((v >> 32) & 4294967295); return a; }
function bn_len(a: i64[]): i32 { var n: i32 = a.len(); while (n > 1 && a[n - 1] == 0) { n = n - 1; } return n; }
function bn_mul_small(a: i64[], k: i64): i64[] {
    var n: i32 = a.len(); var out: i64[] = []; var carry: i64 = 0; var i: i32 = 0;
    while (i < n) { var prod: i64 = a[i] * k + carry; out = out.append(prod & 4294967295); carry = prod >> 32; i = i + 1; }
    while (carry > 0) { out = out.append(carry & 4294967295); carry = carry >> 32; }
    return out;
}
function bn_to_decimal(a: i64[]): string {
    var n: i32 = bn_len(a); var w: i64[] = []; var i: i32 = 0; while (i < n) { w = w.append(a[i]); i = i + 1; }
    var dc: string = "0123456789"; var rev: u8[] = [];
    while (true) {
        var rem: i64 = 0; var j: i32 = n - 1;
        while (j >= 0) { var cur: i64 = (rem << 32) | w[j]; w = w.with(j, cur / 10); rem = cur % 10; j = j - 1; }
        rev = rev.append(dc[rem as i32] as u8);
        while (n > 1 && w[n - 1] == 0) { n = n - 1; }
        if (n == 1 && w[0] == 0) { var o: u8[] = []; var mm: i32 = rev.len() - 1; while (mm >= 0) { o = o.append(rev[mm]); mm = mm - 1; } return string_from_bytes_unchecked(o); }
    }
    return "";
}
function bn_cmp(a: i64[], b: i64[]): i32 {
    var la: i32 = bn_len(a); var lb: i32 = bn_len(b);
    if (la < lb) { return 0 - 1; }
    if (la > lb) { return 1; }
    var i: i32 = la - 1;
    while (i >= 0) { if (a[i] < b[i]) { return 0 - 1; } if (a[i] > b[i]) { return 1; } i = i - 1; }
    return 0;
}
// compare C*10^p  vs  V*2^b  (all fit i64 inputs). Returns -1/0/1.
function cmp_val(C: i64, p: i32, V: i64, b: i32): i32 {
    var L: i64[] = bn_from_i64(C); var R: i64[] = bn_from_i64(V);
    var x: i32 = 0;
    if (p > 0) { x = 0; while (x < p) { L = bn_mul_small(L, 10); x = x + 1; } }
    if (p < 0) { x = 0; var pp: i32 = 0 - p; while (x < pp) { R = bn_mul_small(R, 10); x = x + 1; } }
    if (b > 0) { x = 0; while (x < b) { R = bn_mul_small(R, 2); x = x + 1; } }
    if (b < 0) { x = 0; var bb: i32 = 0 - b; while (x < bb) { L = bn_mul_small(L, 2); x = x + 1; } }
    return bn_cmp(L, R);
}
function inc_digits(s: string): string {
    var b: u8[] = []; var i: i32 = 0; while (i < s.len()) { b = b.append(s[i] as u8); i = i + 1; }
    var j: i32 = b.len() - 1; var carry: i32 = 1;
    while (j >= 0 && carry == 1) { var d: i32 = (b[j] as i32) - 48 + carry; if (d >= 10) { d = d - 10; carry = 1; } else { carry = 0; } b = b.with(j, (d + 48) as u8); j = j - 1; }
    var out: string = string_from_bytes_unchecked(b); if (carry == 1) { out = "1" + out; } return out;
}
function digits_to_i64(s: string): i64 { var v: i64 = 0; var i: i32 = 0; while (i < s.len()) { v = v * 10 + ((s[i] as i64) - 48); i = i + 1; } return v; }

// Shortest-significand search shared by the f32 and f64 formatters. Given a
// float decoded to `value = m * 2^e` (m the integer significand, e its binary
// exponent) and whether m is even, it generates the exact decimal expansion
// via bignum and returns the SHORTEST "sig|msd" prefix that still rounds back
// to the same float — testing each k-digit candidate against the value's ULP
// boundaries lo=(2m-1)*2^(e-1) / hi=(2m+1)*2^(e-1), inclusive on ties when m
// is even (round-half-to-even). `digcap` bounds the search (17 for f64, 9 for
// f32 — the max shortest lengths of each).
function __float_sig_core(m: i64, e: i64, meven: boolean, digcap: i32): string {
    var N: i64[] = bn_from_i64(m); var scale: i32 = 0;
    if (e >= 0) { var c: i64 = 0; while (c < e) { N = bn_mul_small(N, 2); c = c + 1; } }
    else { var c2: i64 = 0; var ae: i64 = 0 - e; while (c2 < ae) { N = bn_mul_small(N, 5); c2 = c2 + 1; } scale = (0 - ae) as i32; }
    var sig: string = bn_to_decimal(N);
    var msdexp: i32 = (sig.len() - 1) + scale;
    // boundaries of n: lo=(2m-1)*2^(e-1), hi=(2m+1)*2^(e-1)
    var lv: i64 = 2 * m - 1; var hv: i64 = 2 * m + 1; var eb: i32 = (e - 1) as i32;
    var kmax: i32 = sig.len(); if (kmax > digcap) { kmax = digcap; }
    var k: i32 = 1;
    while (k <= kmax) {
        var roundup: boolean = false;
        if (k < sig.len()) { var nd: i32 = (sig[k] as i32) - 48; if (nd >= 5) { roundup = true; } }
        var cand: string = "" + sig[0:k]; var cmsd: i32 = msdexp;
        if (roundup) { cand = inc_digits(cand); if (cand.len() > k) { cmsd = cmsd + 1; cand = "" + cand[0:k]; } }
        var Ci: i64 = digits_to_i64(cand);
        var p: i32 = cmsd - (cand.len() - 1);
        // rounds to n iff lo < cand*10^p < hi
        var lo_c: i32 = cmp_val(Ci, p, lv, eb); var hi_c: i32 = cmp_val(Ci, p, hv, eb);
        var lo_ok: boolean = lo_c > 0; var hi_ok: boolean = hi_c < 0;
        if (meven) { lo_ok = lo_c >= 0; hi_ok = hi_c <= 0; }
        if (lo_ok && hi_ok) { return cand + "|" + cmsd.to_string(); }
        k = k + 1;
    }
    return sig + "|" + msdexp.to_string();
}
function __float_sig_pack(n: f64): string {
    var bits: i64 = f64_bits(n);
    var be: i64 = (bits >> 52) & 2047; var frac: i64 = bits & 4503599627370495;
    var m: i64 = frac; var e: i64 = 0 - 1074;
    if (be != 0) { m = frac | 4503599627370496; e = be - 1075; }
    return __float_sig_core(m, e, (m & 1) == 0, 17);
}
// f32 sibling of __float_sig_pack: 23-bit fraction, 8-bit exponent, bias 127.
// value = (frac | 2^23) * 2^(be-150) for normals, frac * 2^-149 for
// subnormals. n is pre-stripped of its sign, so f32_bits(n) is non-negative.
function __float_sig_pack_f32(n: f32): string {
    var bits: i64 = f32_bits(n) as i64;
    var be: i64 = (bits >> 23) & 255; var frac: i64 = bits & 8388607;
    var m: i64 = frac; var e: i64 = 0 - 149;
    if (be != 0) { m = frac | 8388608; e = be - 150; }
    return __float_sig_core(m, e, (m & 1) == 0, 9);
}

// Format shortest significand `sig` with most-significant-digit decimal
// exponent `msd` into Go %v / strconv 'g' style: scientific when msd < -4 or
// msd >= 21, else fixed-point.
function __float_fmt_sci(sig: string, msd: i32): string {
    var nd: i32 = sig.len();
    if (msd < 0 - 4 || msd >= 21) {
        // scientific: d[.ddd]e±XX
        var out: string = "" + sig[0:1];
        if (nd > 1) { out = out + "." + sig[1:nd]; }
        if (msd < 0) { return out + "e-" + (0 - msd).to_string(); }
        return out + "e+" + msd.to_string();
    }
    if (msd < 0) {
        // 0.000sig
        var z: string = ""; var i: i32 = 0; while (i < (0 - msd) - 1) { z = z + "0"; i = i + 1; }
        return "0." + z + sig;
    }
    if (msd + 1 >= nd) {
        // integer, pad trailing zeros
        var z2: string = ""; var i2: i32 = 0; while (i2 < (msd + 1) - nd) { z2 = z2 + "0"; i2 = i2 + 1; }
        return sig + z2;
    }
    // point in the middle
    return "" + sig[0:msd+1] + "." + sig[msd+1:nd];
}
// Split a "sig|msd" pack (see __float_sig_core) into its significand + most-
// significant-digit exponent and render it in strconv 'g' style, prefixed by
// `out` (the already-extracted sign). Shared by the f32 and f64 formatters.
function __float_render(out: string, packed: string): string {
    var bar: i32 = 0; while (packed[bar] != 124) { bar = bar + 1; }   // '|' == 124
    var sig: string = "" + packed[0:bar];
    var msd: i32 = 0; var neg: boolean = false; var q: i32 = bar + 1;
    if (packed[q] == 45) { neg = true; q = q + 1; }
    while (q < packed.len()) { msd = msd * 10 + ((packed[q] as i32) - 48); q = q + 1; }
    if (neg) { msd = 0 - msd; }
    return out + __float_fmt_sci(sig, msd);
}
function __float_shortest(n: f64): string {
    if (n != n) { return "NaN"; }
    var out: string = "";
    if (n < 0.0) { out = "-"; n = 0.0 - n; }
    if (n != 0.0 && n * 2.0 == n) { return out + "Inf"; }
    if (n == 0.0) { return out + "0"; }
    return __float_render(out, __float_sig_pack(n));
}
// f32 shortest-round-trip formatter (#5536 follow-on). Same shape as the f64
// path — sign / NaN / Inf / 0 handling, then the shared shortest-digit search
// via the f32 field unpacker — so an f32 renders with the fewest digits that
// still parse back to it (e.g. 0.1f32 -> "0.1", not "0.099999994").
function __float_shortest_f32(n: f32): string {
    if (n != n) { return "NaN"; }
    var out: string = "";
    if (n < 0.0) { out = "-"; n = 0.0 - n; }
    if (n != 0.0 && n * 2.0 == n) { return out + "Inf"; }
    if (n == 0.0) { return out + "0"; }
    return __float_render(out, __float_sig_pack_f32(n));
}


pub function (n: f64) to_string(): string {
    return __float_shortest(n);
}

pub function (n: f32) to_string(): string {
    return __float_shortest_f32(n);
}

// __float_to_string_prec renders `n` with EXACTLY `prec` fractional
// digits — no trailing-zero trimming — rounding half away from zero.
// Unlike the default shortest formatter (which emits the fewest digits
// that round-trip), this gives the fixed-width output that table /
// currency formatting wants: `3.14159 @ prec 2` -> "3.14", `2.5 @ prec 0` ->
// "3", `1.0 @ prec 3` -> "1.000". The whole computation stays in the
// float domain via __float_int_part, so no value crosses the
// trapping/non-portable `f64 -> i64` boundary regardless of magnitude.
function __float_to_string_prec(n: f64, prec: i32): string {
    if (n != n) { return "NaN"; }
    var out: string = "";
    if (n < 0.0) {
        out = "-";
        n = 0.0 - n;
    }
    if (n != 0.0 && n * 2.0 == n) { return out + "Inf"; }
    // mult = 10^prec.
    var mult: f64 = 1.0;
    var i: i32 = 0;
    while (i < prec) { mult = mult * 10.0; i = i + 1; }
    // Scale, round half away from zero, and split into integer + fraction
    // halves — both integer-valued f64s now.
    var scaled: f64 = __floor_f64(n * mult + 0.5);
    var intf: f64 = __floor_f64(scaled / mult);
    var fracf: f64 = scaled - intf * mult;
    out = out + __float_int_part(intf);
    if (prec == 0) { return out; }
    // Zero-pad the fractional digits out to `prec` places.
    var fracStr: string = __float_int_part(fracf);
    while (fracStr.len() < prec) { fracStr = "0" + fracStr; }
    return out + "." + fracStr;
}

// `to_string_prec(prec)` — fixed-precision rendering with exactly
// `prec` fractional digits (rounded half away from zero). The
// precision-controlled counterpart to `to_string()`, for the
// width/precision table-output story (issue #2684).
pub function (n: f32) to_string_prec(prec: i32): string {
    return __float_to_string_prec(n as f64, prec);
}

pub function (n: f64) to_string_prec(prec: i32): string {
    return __float_to_string_prec(n, prec);
}

// f64 math methods — receiver-syntax wrappers around the
// checker-injected builtins. Each method's body is a single
// call into the matching `__<op>_f64` primitive, so codegen
// can inline them away entirely on every backend that
// supports float ops natively (every backend except the
// interp, which goes through the builtin's Go-side
// implementation).
//
// All methods follow IEEE-754 semantics: NaN / ±Inf
// propagate, division-by-zero yields ±Inf or NaN per the
// usual rules, no integer-style traps. Callers building
// numerically-sensitive code (`x.sqrt()` on x close to 0,
// `x.log()` on negative x) should compare results against
// the textbook formula for the edge cases — std/float
// doesn't guard.

pub function (x: f64) abs(): f64 { return __abs_f64(x); }
pub function (x: f64) floor(): f64 { return __floor_f64(x); }
pub function (x: f64) ceil(): f64 { return __ceil_f64(x); }
// `round(x)` follows the "round half away from zero"
// convention (matches Go's `math.Round`). Tests that need
// banker's rounding (round half to even) should reach
// into the bit-pattern themselves.
pub function (x: f64) round(): f64 { return __round_f64(x); }

// `round_to(digits)` — round `x` to `digits` decimal places, half away from
// zero (like `round`): `(3.14159).round_to(2)` is `3.14`, `(2.5).round_to(0)`
// is `3.0`. Negative `digits` round to tens / hundreds
// (`(1234.0).round_to(-2)` is `1200.0`). Scales by `10^digits`, rounds, and
// unscales; the usual float-representation caveat applies (the result is the
// nearest f64 to the rounded decimal, which for most display / money use is
// exact enough). NaN / ±Inf pass through unchanged.
pub function (x: f64) round_to(digits: i32): f64 {
    if (x != x) { return x; }                    // NaN
    if (x != 0.0 && x * 2.0 == x) { return x; }  // ±Inf
    var scale: f64 = 1.0;
    var i: i32 = 0;
    var d: i32 = digits;
    if (d < 0) { d = 0 - d; }
    while (i < d) { scale = scale * 10.0; i = i + 1; }
    if (digits >= 0) {
        return __round_f64(x * scale) / scale;
    }
    return __round_f64(x / scale) * scale;
}

// `trunc(x)` is round-toward-zero, equivalent to
// `(x as i64) as f64` for values that fit in the i64 range.
// The primitive form handles ±Inf / NaN that the cast
// version would reject.
pub function (x: f64) trunc(): f64 { return __trunc_f64(x); }
pub function (x: f64) sqrt(): f64 { return __sqrt_f64(x); }
pub function (x: f64) log(): f64 { return __log_f64(x); }
// `log2(x)` / `log10(x)` — logarithms in base 2 and base 10, derived from
// the natural log by dividing by `ln(2)` / `ln(10)` (change-of-base). No new
// primitive needed — they ride on the same `__log_f64` the wasm-IR backend
// already lowers. `log2(8)` is `3`, `log10(1000)` is `3`; `log2` of a power
// of two and `log10` of a power of ten come out exact up to rounding.
pub function (x: f64) log2(): f64 { return __log_f64(x) / 0.6931471805599453; }
pub function (x: f64) log10(): f64 { return __log_f64(x) / 2.302585092994046; }
pub function (x: f64) exp(): f64 { return __exp_f64(x); }
// `exp2(x)` / `exp10(x)` — base-2 and base-10 exponentials, the inverses of
// `log2` / `log10`. Built on the natural `exp` via `2^x == e^(x*ln2)` and
// `10^x == e^(x*ln10)`, so — like the logs — they reuse the `__exp_f64` the
// wasm-IR backend already lowers rather than needing a new primitive.
// `exp2(3)` is `8`, `exp2(10)` is `1024`, `exp10(3)` is `1000`; `exp2` of a
// whole number and `exp10` of a whole number land on the exact power up to
// rounding, and both round-trip with their logs (`exp2(x).log2() == x`).
pub function (x: f64) exp2(): f64 { return __exp_f64(x * 0.6931471805599453); }
pub function (x: f64) exp10(): f64 { return __exp_f64(x * 2.302585092994046); }
pub function (x: f64) sin(): f64 { return __sin_f64(x); }
pub function (x: f64) cos(): f64 { return __cos_f64(x); }
// `tan(x)` — tangent, as `sin(x) / cos(x)`; the missing sibling of the
// existing `sin` / `cos`. Blows up to ±Inf near the odd multiples of π/2
// where `cos` crosses zero, as expected.
pub function (x: f64) tan(): f64 { return __sin_f64(x) / __cos_f64(x); }
// `sinh(x)` / `cosh(x)` / `tanh(x)` — the hyperbolic trig functions, built on
// the natural `exp` (`sinh = (eˣ - e⁻ˣ)/2`, `cosh = (eˣ + e⁻ˣ)/2`) so — like
// `exp2` / `log2` — they need no new primitive and ride the `__exp_f64` the
// wasm-IR backend already lowers. `sinh(0)` is `0`, `cosh(0)` is `1`,
// `tanh(0)` is `0`, and the identity `cosh² - sinh² == 1` holds. `tanh` uses
// the stable `(e²ˣ - 1)/(e²ˣ + 1)` form and saturates to `±1` past `|x| = 20`
// (where it already equals `±1` to f64 precision), avoiding the `Inf/Inf` NaN
// that `sinh/cosh` would give for large magnitudes.
pub function (x: f64) sinh(): f64 { return (__exp_f64(x) - __exp_f64(0.0 - x)) * 0.5; }
pub function (x: f64) cosh(): f64 { return (__exp_f64(x) + __exp_f64(0.0 - x)) * 0.5; }
pub function (x: f64) tanh(): f64 {
    if (x > 20.0) { return 1.0; }
    if (x < 0.0 - 20.0) { return 0.0 - 1.0; }
    var e2: f64 = __exp_f64(x * 2.0);
    return (e2 - 1.0) / (e2 + 1.0);
}
// `pow(x, y)` — two-argument form; method receiver is the
// base. Use `(b).pow(e)` for `b ^ e`.
pub function (x: f64) pow(y: f64): f64 { return __pow_f64(x, y); }

// `cbrt(x)` — the real cube root, the companion to `sqrt` but defined for
// negative inputs too (`cbrt(-8)` is `-2`). Since `pow` of a negative base with
// a fractional exponent is NaN, the sign is peeled off and reapplied around
// `pow(|x|, 1/3)`. `cbrt(0)` is `0` (sign preserved), NaN passes through.
pub function (x: f64) cbrt(): f64 {
    if (x != x) { return x; }
    if (x == 0.0) { return x; }
    if (x < 0.0) { return 0.0 - __pow_f64(0.0 - x, 1.0 / 3.0); }
    return __pow_f64(x, 1.0 / 3.0);
}

// `hypot(x, y)` — the Euclidean length `sqrt(x*x + y*y)`, computed via the
// scaled form `hi * sqrt(1 + (lo/hi)^2)` (hi/lo the larger/smaller magnitude)
// so it does NOT overflow when a naive `x*x + y*y` would, and stays accurate
// for very lopsided inputs. `hypot(0, 0)` is `0`.
pub function (x: f64) hypot(y: f64): f64 {
    var ax: f64 = x.abs();
    var ay: f64 = y.abs();
    var hi: f64 = ax.max(ay);
    var lo: f64 = ax.min(ay);
    if (hi == 0.0) { return 0.0; }
    var r: f64 = lo / hi;
    return hi * (1.0 + r * r).sqrt();
}

// `hypot3(x, y, z)` — the 3-D Euclidean length `sqrt(x*x + y*y + z*z)`, the
// three-argument sibling of `hypot`. Same overflow-safe scaling: divide through
// by the largest magnitude before squaring, so a component near the f64 max
// doesn't overflow the sum. `hypot3(0, 0, 0)` is `0`; `hypot3(2, 3, 6)` is `7`.
pub function (x: f64) hypot3(y: f64, z: f64): f64 {
    var ax: f64 = x.abs();
    var ay: f64 = y.abs();
    var az: f64 = z.abs();
    var hi: f64 = ax.max(ay).max(az);
    if (hi == 0.0) { return 0.0; }
    var rx: f64 = ax / hi;
    var ry: f64 = ay / hi;
    var rz: f64 = az / hi;
    return hi * (rx * rx + ry * ry + rz * rz).sqrt();
}

// `fract(x)` — the fractional part, `x - trunc(x)`; keeps `x`'s sign, so
// `fract(-3.75)` is `-0.75`. The companion to `trunc` / `floor` / `ceil`.
pub function (x: f64) fract(): f64 { return x - __trunc_f64(x); }

// `is_nan(x)` / `is_inf(x)` / `is_finite(x)` — IEEE-754
// classification. The NaN predicate uses the textbook
// "x != x" pattern; `is_inf` checks both ±Inf by squaring
// (Inf * 2 == Inf, finite * 2 grows), `is_finite` is the
// negation. Helpers so test code doesn't have to spell out
// the textbook patterns every time.
pub function (x: f64) is_nan(): boolean { return x != x; }
pub function (x: f64) is_finite(): boolean {
    if (x != x) { return false; }
    if (x != 0.0 && x * 2.0 == x) { return false; }
    return true;
}
// `(x: f64) is_sign_negative()` / `is_sign_positive()` — test the IEEE-754
// sign BIT, so they classify `-0.0` as negative and `+0.0` as positive
// (unlike `x < 0.0`, which is false for both zeros and for any NaN). A
// NaN's sign is whatever bit it carries. Read via `f64_bits` (bit 63),
// so no comparison-with-zero rounding is involved.
pub function (x: f64) is_sign_negative(): boolean { return f64_bits(x) < 0; }
pub function (x: f64) is_sign_positive(): boolean { return f64_bits(x) >= 0; }
pub function (x: f64) is_inf(): boolean {
    if (x != x) { return false; }
    if (x == 0.0) { return false; }
    return x * 2.0 == x;
}

// `min(x, y)` / `max(x, y)` — return the smaller / larger
// value. NaN inputs are infectious (any NaN in → NaN out),
// matching Go's `math.Min` / `math.Max` semantics. Float
// comparisons with NaN are well-defined as "always false",
// which is what the inline check below relies on.
pub function (x: f64) min(y: f64): f64 {
    if (x != x) { return x; }
    if (y != y) { return y; }
    if (x < y) { return x; }
    return y;
}
pub function (x: f64) max(y: f64): f64 {
    if (x != x) { return x; }
    if (y != y) { return y; }
    if (x > y) { return x; }
    return y;
}

// `clamp(x, lo, hi)` — restrict to `[lo, hi]`. Implemented
// as `max(lo, min(hi, x))`; preserves NaN if any input is
// NaN.
pub function (x: f64) clamp(lo: f64, hi: f64): f64 {
    return lo.max(x.min(hi));
}

// `clamp01(x)` — restrict to the unit interval `[0, 1]`, the common case for
// colour channels, probabilities, and interpolation weights. Shorthand for
// `clamp(0, 1)`; NaN propagates like `clamp`.
pub function (x: f64) clamp01(): f64 {
    return (0.0).max(x.min(1.0));
}

// `abs_diff(a, b)` — the absolute difference `|a - b|`, the float sibling of the
// i32 / i64 helpers. NaN in either operand propagates.
pub function (a: f64) abs_diff(b: f64): f64 {
    var d: f64 = a - b;
    if (d < 0.0) { return 0.0 - d; }
    return d;
}

// `mul_add(a, b, c)` — `a * b + c`. A convenience for the common
// multiply-accumulate step; note this is NOT a hardware-fused FMA — the
// intermediate `a * b` rounds before the add, so it is exactly `a * b + c` in
// f64 arithmetic, not the single-rounding `fma`.
pub function (a: f64) mul_add(b: f64, c: f64): f64 {
    return a * b + c;
}

// `signum(x)` — `1.0` if positive, `-1.0` if negative, the value itself
// (`0.0` / `-0.0`) at zero, and `NaN` for `NaN`. Matches Rust's `f64::signum`
// EXCEPT at zero, where Rust returns `±1.0` on signed zeros; here signed zero
// returns zero, which is the more common "sign of a magnitude" expectation.
pub function (x: f64) signum(): f64 {
    if (x != x) { return x; }
    if (x > 0.0) { return 1.0; }
    if (x < 0.0) { return 0.0 - 1.0; }
    return x;
}

// `lerp(a, b, t)` — linear interpolation from `a` (at `t == 0`) to `b`
// (at `t == 1`). Uses the precise `a + (b - a) * t` form; `t` outside
// `[0, 1]` extrapolates. NaN in any operand propagates.
pub function (a: f64) lerp(b: f64, t: f64): f64 {
    return a + (b - a) * t;
}

// `recip(x)` — the reciprocal `1 / x`. `recip(4)` is `0.25`; `recip(0)` is
// `+Inf` (and `recip(-0)` is `-Inf`, since the division carries the sign).
// Purely arithmetic — no libm primitive — so it lowers on every backend.
pub function (x: f64) recip(): f64 { return 1.0 / x; }

// `copysign(x, sign)` — the magnitude of `x` carrying the sign of `sign`:
// `copysign(3, -1)` is `-3`, `copysign(-3, 2)` is `3`. The sign test is
// `sign < 0`, so a signed negative zero (`-0.0`, which compares equal to
// `+0.0`) reads as positive here — the one case where this differs from a
// bit-level copysign. NaN magnitude passes through with the chosen sign.
pub function (x: f64) copysign(sign: f64): f64 {
    var m: f64 = x.abs();
    if (sign < 0.0) { return 0.0 - m; }
    return m;
}

// `midpoint(a, b)` — the point halfway between `a` and `b`, computed as
// `a*0.5 + b*0.5` so it never overflows the way `(a + b) / 2` would when both
// operands are near the f64 max. `midpoint(2, 4)` is `3`, `midpoint(1, 2)` is
// `1.5`.
pub function (a: f64) midpoint(b: f64): f64 {
    return a * 0.5 + b * 0.5;
}

// `to_radians()` / `to_degrees()` — convert between degrees and radians,
// the natural companions to `sin` / `cos` (which take radians). Uses a
// high-precision π; the round-trip `d.to_radians().to_degrees()` recovers
// `d` to f64 accuracy.
pub function (deg: f64) to_radians(): f64 {
    return deg * (3.141592653589793 / 180.0);
}
pub function (rad: f64) to_degrees(): f64 {
    return rad * (180.0 / 3.141592653589793);
}

// f32 mirror methods for explicitly-f32 values (a bare `3.14`
// is f64 — the language's default float, #5363 — and takes the
// f64 receiver methods above). Each wraps the f64 primitive —
// promote to f64, apply, demote back. Float precision in the
// final answer is bounded by the f32 input + the operation's
// f64-domain accuracy; the demotion-to-f32 rounds the result
// to the nearest f32.

pub function (x: f32) abs(): f32 { return __abs_f64(x as f64) as f32; }
pub function (x: f32) floor(): f32 { return __floor_f64(x as f64) as f32; }
pub function (x: f32) ceil(): f32 { return __ceil_f64(x as f64) as f32; }
pub function (x: f32) round(): f32 { return __round_f64(x as f64) as f32; }
pub function (x: f32) round_to(digits: i32): f32 {
    return (x as f64).round_to(digits) as f32;
}
pub function (x: f32) trunc(): f32 { return __trunc_f64(x as f64) as f32; }
pub function (x: f32) sqrt(): f32 { return __sqrt_f64(x as f64) as f32; }
pub function (x: f32) log(): f32 { return __log_f64(x as f64) as f32; }
pub function (x: f32) log2(): f32 { return (__log_f64(x as f64) / 0.6931471805599453) as f32; }
pub function (x: f32) log10(): f32 { return (__log_f64(x as f64) / 2.302585092994046) as f32; }
pub function (x: f32) exp(): f32 { return __exp_f64(x as f64) as f32; }
pub function (x: f32) exp2(): f32 { return __exp_f64(x as f64 * 0.6931471805599453) as f32; }
pub function (x: f32) exp10(): f32 { return __exp_f64(x as f64 * 2.302585092994046) as f32; }
pub function (x: f32) sin(): f32 { return __sin_f64(x as f64) as f32; }
pub function (x: f32) cos(): f32 { return __cos_f64(x as f64) as f32; }
pub function (x: f32) tan(): f32 { return (__sin_f64(x as f64) / __cos_f64(x as f64)) as f32; }
pub function (x: f32) sinh(): f32 { return (x as f64).sinh() as f32; }
pub function (x: f32) cosh(): f32 { return (x as f64).cosh() as f32; }
pub function (x: f32) tanh(): f32 { return (x as f64).tanh() as f32; }
pub function (x: f32) pow(y: f32): f32 {
    return __pow_f64(x as f64, y as f64) as f32;
}
pub function (x: f32) cbrt(): f32 {
    return (x as f64).cbrt() as f32;
}
pub function (x: f32) hypot(y: f32): f32 {
    var ax: f64 = (x as f64).abs();
    var ay: f64 = (y as f64).abs();
    var hi: f64 = ax.max(ay);
    var lo: f64 = ax.min(ay);
    if (hi == 0.0) { return 0.0 as f32; }
    var r: f64 = lo / hi;
    return (hi * (1.0 + r * r).sqrt()) as f32;
}
pub function (x: f32) hypot3(y: f32, z: f32): f32 {
    return (x as f64).hypot3(y as f64, z as f64) as f32;
}
pub function (x: f32) fract(): f32 { return (x as f64 - __trunc_f64(x as f64)) as f32; }

pub function (x: f32) is_nan(): boolean { return x != x; }
pub function (x: f32) is_finite(): boolean {
    if (x != x) { return false; }
    if (x != (0.0 as f32) && x * (2.0 as f32) == x) { return false; }
    return true;
}
// `(x: f32) is_sign_negative()` / `is_sign_positive()` — the f32 siblings;
// the sign is bit 31 of `f32_bits`. See the f64 forms above.
pub function (x: f32) is_sign_negative(): boolean { return f32_bits(x) < 0; }
pub function (x: f32) is_sign_positive(): boolean { return f32_bits(x) >= 0; }
pub function (x: f32) is_inf(): boolean {
    if (x != x) { return false; }
    if (x == (0.0 as f32)) { return false; }
    return x * (2.0 as f32) == x;
}

pub function (x: f32) min(y: f32): f32 {
    if (x != x) { return x; }
    if (y != y) { return y; }
    if (x < y) { return x; }
    return y;
}
pub function (x: f32) max(y: f32): f32 {
    if (x != x) { return x; }
    if (y != y) { return y; }
    if (x > y) { return x; }
    return y;
}
pub function (x: f32) clamp(lo: f32, hi: f32): f32 {
    return lo.max(x.min(hi));
}
pub function (x: f32) clamp01(): f32 {
    return (0.0 as f32).max(x.min(1.0 as f32));
}
pub function (a: f32) abs_diff(b: f32): f32 {
    var d: f32 = a - b;
    if (d < (0.0 as f32)) { return (0.0 as f32) - d; }
    return d;
}
pub function (a: f32) mul_add(b: f32, c: f32): f32 {
    return a * b + c;
}

pub function (x: f32) signum(): f32 {
    if (x != x) { return x; }
    if (x > (0.0 as f32)) { return 1.0 as f32; }
    if (x < (0.0 as f32)) { return (0.0 as f32) - (1.0 as f32); }
    return x;
}
pub function (a: f32) lerp(b: f32, t: f32): f32 {
    return a + (b - a) * t;
}
pub function (x: f32) recip(): f32 { return (1.0 as f32) / x; }
pub function (x: f32) copysign(sign: f32): f32 {
    var m: f32 = x.abs();
    if (sign < (0.0 as f32)) { return (0.0 as f32) - m; }
    return m;
}
pub function (a: f32) midpoint(b: f32): f32 {
    return (a as f64 * 0.5 + b as f64 * 0.5) as f32;
}
pub function (deg: f32) to_radians(): f32 {
    return (deg as f64 * (3.141592653589793 / 180.0)) as f32;
}
pub function (rad: f32) to_degrees(): f32 {
    return (rad as f64 * (180.0 / 3.141592653589793)) as f32;
}
