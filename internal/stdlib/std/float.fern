// <<< generated

// log x = k ln2 + log c + log1p(r) for x = 2^k z, with c the midpoint of the
// table row z falls in and r = (z - c) / c; near 1, where those terms cancel,
// log1p(x - 1) directly.
pub function (x: f64) log(): f64 {
  let ix: i64 = f64_bits(x);
  if (ix >= 0x3fee000000000000 && ix < 0x3ff1090000000000) {
    return _fd_log_near1(x - 1.0);
  }
  let top: i64 = ix >> 52 & 0xfff;
  if (top == 0 || top >= 0x7ff) {
    return _fd_log_special(x);
  }
  return _fd_log_main(ix);
}

// _fd_log_special is log of ±0, a subnormal, a negative, ±Inf or a NaN. A
// subnormal stores its magnitude in leading zeros: scaling by 2^52 moves it
// into the exponent, and taking 52 back off the field hands the reduction a k
// no exponent field could hold.
@noinline
function _fd_log_special(x: f64): f64 {
  let ix: i64 = f64_bits(x);
  if (ix << 1 == 0) {
    return -f64_from_bits(0x7ff0000000000000);
  }
  if (x != x || ix == 0x7ff0000000000000) {
    return x;
  }
  if (ix < 0) {
    return f64_from_bits(0x7ff8000000000000);
  }
  return _fd_log_main(f64_bits(x * 4503599627370496.0) - 0x0340000000000000);
}

// _fd_log_main is log x for the bits of a normal positive x away from 1. z - c
// is exact, and k * ln2_hi + logc_hi is too, both being on the 2^-43 grid.
function _fd_log_main(ix: i64): f64 {
  let tmp: i64 = ix - 0x3fe6000000000000;
  let i: i32 = (tmp >> 45) as i32 & 127;
  let iz: i64 = ix - (tmp >> 52 << 52);
  let z: f64 = f64_from_bits(iz);
  let c: f64 = f64_from_bits(iz >> 45 << 45 | 0x100000000000);
  let r: f64 = (z - c) * _log_invc()[i];
  let kd: f64 = (tmp >> 52) as f64;
  let w: f64 = kd * 6.93147180369123816490e-01 + _log_logc_hi()[i];
  let hi: f64 = w + r;
  let lo: f64 = w - hi + r + (kd * 1.90821492927058770002e-10 + _log_logc_lo()[i]);
  let r2: f64 = r * r;
  let a: f64[] = _log_poly();
  let p: f64 = a[0] + r * a[1] + r2 * (a[2] + r * a[3]);
  return lo - r2 * 0.5 + r * r2 * p + hi;
}

// _fd_log_near1 is log1p(r) for the exact r = x - 1 of an x in
// [1 - 2^-4, 1 + 0x1.09p-4], with r - r^2/2 carried as hi + lo: rhi keeps r's
// top 26 bits, so rhi * rhi is exact.
function _fd_log_near1(r: f64): f64 {
  let r2: f64 = r * r;
  let r3: f64 = r * r2;
  let b: f64[] = _log_near1_poly();
  let p: f64 = b[6] + r * b[7] + r2 * b[8] + r3 * b[9];
  p = b[3] + r * b[4] + r2 * b[5] + r3 * p;
  p = b[0] + r * b[1] + r2 * b[2] + r3 * p;
  let y: f64 = r3 * p;
  let w: f64 = r * 134217728.0;
  let rhi: f64 = r + w - w;
  let rlo: f64 = r - rhi;
  let h: f64 = rhi * rhi * 0.5;
  let hi: f64 = r - h;
  let lo: f64 = r - hi - h - rlo * 0.5 * (rhi + r);
  return y + lo + hi;
}

// _fd_trig is sin x for shift 0 and cos x for shift 1: cos's quadrant table is
// sin's one quadrant on. NaN returns itself and ±Inf becomes NaN, there being
// no reduction of an infinity; sin returns a tiny x itself, which is what it
// rounds to and keeps the sign of a -0. Below 2^20 the reduction is
// Cody-Waite, with pi/2 in three 33-bit chunks: k * pio2_h is exact while k
// fits pio2_h's 22 trailing zero bits, and near a zero of sin the reduced
// argument is the answer, so two chunks are not enough.
function _fd_trig(x: f64, shift: i64): f64 {
  if (x != x) {
    return x;
  }
  let ab: i64 = f64_bits(x) & 0x7fffffffffffffff;
  if (ab == 0x7ff0000000000000) {
    return f64_from_bits(0x7ff8000000000000);
  }
  if (shift == 0 && ab < 0x3e40000000000000) {
    return x;
  }
  if (ab >= 0x4130000000000000) {
    return _fd_trig_large(x, shift);
  }
  let kf: f64 = _fd_rint(x * 6.36619772367581382433e-01);
  let r: f64 = x - kf * 1.57079632673412561417e+00 - kf * 6.07710050630396597660e-11 - kf * 2.02226624879595063154e-21;
  // Quadrant n of r takes sin r, cos r, -sin r, -cos r, here and in
  // _fd_trig_large; the select is spelled in both so neither path calls it.
  let n: i64 = kf as i64 + shift;
  let y: f64 = 0.0;
  if ((n & 1) == 0) {
    y = _fd_ksin(r);
  } else {
    y = _fd_kcos(r);
  }
  if ((n & 2) != 0) {
    return -y;
  }
  return y;
}

function _fd_ksin(r: f64): f64 {
  let z: f64 = r * r;
  let p: f64 = -1.66666666666666324348e-01 + z * (8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 + z * (2.75573137070700676789e-06 + z * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10))));
  return r + p * (z * r);
}

// The (1 - w) - hz rewrite recovers the bits 1 - hz discards.
function _fd_kcos(r: f64): f64 {
  let z: f64 = r * r;
  let p: f64 = 4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 + z * (2.48015872894767294178e-05 + z * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11))));
  let hz: f64 = 0.5 * z;
  let w: f64 = 1.0 - hz;
  return w + (1.0 - w - hz + z * p * z);
}

// _two_over_pi is 2/pi in binary, one limb per 64 fraction bits from 2^-1 in
// limb 1; the leading zero limb lets the window start above 2^-1.
function _two_over_pi(): u64[] {
  return [
    0x0000000000000000, 0xa2f9836e4e441529, 0xfc2757d1f534ddc0,
    0xdb6295993c439041, 0xfe5163abdebbc561, 0xb7246e3a424dd2e0,
    0x06492eea09d1921c, 0xfe1deb1cb129a73e, 0xe88235f52ebb4484,
    0xe99c7026b45f7e41, 0x3991d639835339f4, 0x9c845f8bbdf9283b,
    0x1ff897ffde05980f, 0xef2f118b5a0a6d1f, 0x6d367ecf27cb09b7,
    0x4f463f669e5fea2d, 0x7527bac7ebe5f17b, 0x3d0739f78a5292ea,
    0x6bfb5fb11f8d5d08, 0x56033046fc7b6bab, 0xf0cfbc209af4361d,
  ];
}

// _fd_trig_large is _fd_trig for |x| >= 2^20, reduced Payne-Hanek: the
// significand times the window of 2/pi the exponent selects is a Q126 whose
// top two bits are the quadrant and the rest the fraction of x / (pi/2),
// neither of which loses accuracy with the magnitude. A fraction at or past a
// half belongs to the next quadrant, as the negative remainder below it. It
// stays a call, so that the common case keeps no register for it.
@noinline
function _fd_trig_large(x: f64, shift: i64): f64 {
  let b: i64 = f64_bits(x);
  let m: u64 = (b & 0x000fffffffffffff | 0x0010000000000000) as u64;
  let idx: i64 = (b >> 52 & 0x7ff) - 1013;
  let off: u64 = (idx & 63) as u64;
  let rest: u64 = 63 as u64 - off;
  let one: u64 = 1 as u64;
  let limb: i32 = (idx >> 6) as i32;
  let t: u64[] = _two_over_pi();
  let w0: u64 = t[limb] << off | t[limb + 1] >> one >> rest;
  let w1: u64 = t[limb + 1] << off | t[limb + 2] >> one >> rest;
  let w2: u64 = t[limb + 2] << off | t[limb + 3] >> one >> rest;
  let p1lo: u64 = m * w1;
  let lo: u64 = p1lo + _db_mul_hi(m, w2);
  let hi: u64 = m * w0 + _db_mul_hi(m, w1);
  if (lo < p1lo) {
    hi = hi + one;
  }
  let q: i64 = (hi >> 62 as u64) as i64;
  hi = hi & 0x3fffffffffffffff as u64;
  let neg: boolean = hi >= 0x2000000000000000 as u64;
  if (neg) {
    q = q + 1;
    hi = 0x4000000000000000 as u64 - hi;
    if (lo != 0 as u64) {
      hi = hi - one;
    }
    lo = 0 as u64 - lo;
  }
  // The low word's bottom 11 bits fall off the double anyway; dropping them
  // keeps its conversion exact.
  let fr: f64 = (hi as i64) as f64 * 2.168404344971009e-19 + ((lo >> 11 as u64) as i64) as f64 * 2.407412430484045e-35;
  if (neg) {
    fr = -fr;
  }
  if (b < 0) {
    fr = -fr;
    q = 0 - q;
  }
  let r: f64 = fr * 1.5707963267948966 + fr * 6.123233995736766e-17;
  let n: i64 = q + shift;
  let y: f64 = 0.0;
  if ((n & 1) == 0) {
    y = _fd_ksin(r);
  } else {
    y = _fd_kcos(r);
  }
  if ((n & 2) != 0) {
    return -y;
  }
  return y;
}

// pow's integral y is repeated squaring, exact wherever the result is
// representable, up to |y| = 1074, past which no base outside (0.5, 2) has a
// finite non-zero result; any other y is sign * exp(y * log|x|) (below). A
// negative n takes the reciprocal; when that underflows because x^|n|
// overflowed, (1/x)^|n| is what is representable.
function _fd_pow_int(x: f64, n: i64): f64 {
  if (n >= 0) {
    return _fd_pow_sq(x, n);
  }
  let q: f64 = 1.0 / _fd_pow_sq(x, 0 - n);
  if (q != 0.0) {
    return q;
  }
  return _fd_pow_sq(1.0 / x, 0 - n);
}

function _fd_pow_sq(b: f64, n: i64): f64 {
  let r: f64 = 1.0;
  let p: f64 = b;
  let k: i64 = n;
  while (k != 0) {
    if ((k & 1) != 0) {
      r = r * p;
    }
    p = p * p;
    k = k >> 1;
  }
  return r;
}

// A negative base has a real power only for an integral y, whose parity is
// the sign; every |y| >= 2^53 is an even integer, which leaves pow(-x, ±Inf)
// a magnitude. |x| == 1 is 1 for every y, the NaN and ±Inf that y * log|x|
// would turn into NaN included.
function _fd_pow_general(x: f64, y: f64): f64 {
  let sign: f64 = 1.0;
  let ax: f64 = x;
  if (f64_bits(x) < 0) {
    ax = -x;
    let ay: i64 = f64_bits(y) & 0x7fffffffffffffff;
    if (ay > 0x7ff0000000000000) {
      return f64_from_bits(0x7ff8000000000000);
    }
    if (ay < 0x4340000000000000) {
      let ny: i64 = y as i64;
      if (ny as f64 != y) {
        return f64_from_bits(0x7ff8000000000000);
      }
      if ((ny & 1) != 0) {
        sign = -1.0;
      }
    }
  }
  if (ax == 1.0) {
    return sign;
  }
  return (y * ax.log()).exp() * sign;
}

// ---- inverse trig, expm1 and log1p ------------------------------------------
//
// Ports of fdlibm (FreeBSD msun's e_asin.c, e_acos.c, s_atan.c, e_atan2.c,
// s_expm1.c, s_log1p.c), so each is a real kernel rather than a composition
// that inherits its parts' error. The high and low 32-bit words fdlibm reads
// are `_fd_hi` / `_fd_lo`, kept as i64 so the signed high word compares the way
// C's int32_t does.

function _fd_hi(x: f64): i64 {
  return f64_bits(x) >> 32;
}

function _fd_lo(x: f64): i64 {
  return f64_bits(x) & 0xffffffff;
}

function _fd_words(hi: i64, lo: i64): f64 {
  return f64_from_bits(hi << 32 | lo & 0xffffffff);
}

// R(t) for asin / acos: (pS0..pS5) / (1 + qS1..qS4), the rational
// approximation of (asin(x) - x) / x^3 in t = x^2.
function _fd_asin_r(t: f64): f64 {
  let p: f64 = t * (1.66666666666666657415e-01 + t * (-3.25565818622400915405e-01 + t * (2.01212532134862925881e-01 + t * (-4.00555345006794114027e-02 + t * (7.91534994289814532176e-04 + t * 3.47933107596021167570e-05)))));
  let q: f64 = 1.0 + t * (-2.40339491173441421878e+00 + t * (2.02094576023350569471e+00 + t * (-6.88283971605453293030e-01 + t * 7.70381505559019352791e-02)));
  return p / q;
}

// `asin(x)` — arcsine in [-π/2, π/2]; NaN outside [-1, 1].
pub function (x: f64) asin(): f64 {
  let pio2_hi: f64 = 1.57079632679489655800e+00;
  let pio2_lo: f64 = 6.12323399573676603587e-17;
  let pio4_hi: f64 = 7.85398163397448278999e-01;
  let hx: i64 = _fd_hi(x);
  let ix: i64 = hx & 0x7fffffff;
  if (ix >= 0x3ff00000) {
    if ((ix - 0x3ff00000 | _fd_lo(x)) == 0) {
      return x * pio2_hi + x * pio2_lo;
    }
    return (x - x) / (x - x);
  }
  if (ix < 0x3fe00000) {
    if (ix < 0x3e500000) {
      return x;
    }
    return x + x * _fd_asin_r(x * x);
  }
  let w: f64 = 1.0 - __abs_f64(x);
  let t: f64 = w * 0.5;
  let r: f64 = _fd_asin_r(t);
  let s: f64 = __sqrt_f64(t);
  let res: f64 = 0.0;
  if (ix >= 0x3fef3333) {
    res = pio2_hi - (2.0 * (s + s * r) - pio2_lo);
  } else {
    let sw: f64 = _fd_words(_fd_hi(s), 0);
    let c: f64 = (t - sw * sw) / (s + sw);
    let p: f64 = 2.0 * s * r - (pio2_lo - 2.0 * c);
    let q: f64 = pio4_hi - 2.0 * sw;
    res = pio4_hi - (p - q);
  }
  if (hx > 0) {
    return res;
  }
  return -res;
}

// `acos(x)` — arccosine in [0, π]; NaN outside [-1, 1].
pub function (x: f64) acos(): f64 {
  let pi: f64 = 3.14159265358979311600e+00;
  let pio2_hi: f64 = 1.57079632679489655800e+00;
  let pio2_lo: f64 = 6.12323399573676603587e-17;
  let hx: i64 = _fd_hi(x);
  let ix: i64 = hx & 0x7fffffff;
  if (ix >= 0x3ff00000) {
    if ((ix - 0x3ff00000 | _fd_lo(x)) == 0) {
      if (hx > 0) {
        return 0.0;
      }
      return pi + 2.0 * pio2_lo;
    }
    return (x - x) / (x - x);
  }
  if (ix < 0x3fe00000) {
    if (ix <= 0x3c600000) {
      return pio2_hi + pio2_lo;
    }
    let r: f64 = _fd_asin_r(x * x);
    return pio2_hi - (x - (pio2_lo - x * r));
  }
  if (hx < 0) {
    let z: f64 = (1.0 + x) * 0.5;
    let s: f64 = __sqrt_f64(z);
    let w: f64 = _fd_asin_r(z) * s - pio2_lo;
    return pi - 2.0 * (s + w);
  }
  let z: f64 = (1.0 - x) * 0.5;
  let s: f64 = __sqrt_f64(z);
  let df: f64 = _fd_words(_fd_hi(s), 0);
  let c: f64 = (z - df * df) / (s + df);
  let w: f64 = _fd_asin_r(z) * s + c;
  return 2.0 * (df + w);
}

// `atan(x)` — arctangent in (-π/2, π/2).
// Branches mirror the msun source so the port can be read against it.
// fern-lint: allow cyclomatic-complexity
pub function (x: f64) atan(): f64 {
  let hx: i64 = _fd_hi(x);
  let ix: i64 = hx & 0x7fffffff;
  if (ix >= 0x44100000) {
    if (ix > 0x7ff00000 || ix == 0x7ff00000 && _fd_lo(x) != 0) {
      return x + x;
    }
    if (hx > 0) {
      return 1.57079632679489655800e+00 + 6.12323399573676603587e-17;
    }
    return -1.57079632679489655800e+00 - 6.12323399573676603587e-17;
  }
  let id: i32 = -1;
  let v: f64 = x;
  if (ix < 0x3fdc0000) {
    if (ix < 0x3e400000) {
      return x;
    }
  } else {
    v = __abs_f64(x);
    if (ix < 0x3ff30000) {
      if (ix < 0x3fe60000) {
        id = 0;
        v = (2.0 * v - 1.0) / (2.0 + v);
      } else {
        id = 1;
        v = (v - 1.0) / (v + 1.0);
      }
    } else if (ix < 0x40038000) {
      id = 2;
      v = (v - 1.5) / (1.0 + 1.5 * v);
    } else {
      id = 3;
      v = -1.0 / v;
    }
  }
  let z: f64 = v * v;
  let w: f64 = z * z;
  let s1: f64 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 + w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02 + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))));
  let s2: f64 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 + w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))));
  if (id < 0) {
    return v - v * (s1 + s2);
  }
  let hi: f64 = 1.57079632679489655800e+00;
  let lo: f64 = 6.12323399573676603587e-17;
  if (id == 0) {
    hi = 4.63647609000806093515e-01;
    lo = 2.26987774529616870924e-17;
  } else if (id == 1) {
    hi = 7.85398163397448278999e-01;
    lo = 3.06161699786838301793e-17;
  } else if (id == 2) {
    hi = 9.82793723247329054082e-01;
    lo = 1.39033110312309984516e-17;
  }
  let r: f64 = hi - (v * (s1 + s2) - lo - v);
  if (hx < 0) {
    return -r;
  }
  return r;
}

// `atan2(x)` on receiver `y` — the angle of the point (x, y) in [-π, π],
// with C's signed-zero and infinity cases.
// Branches mirror the msun source so the port can be read against it.
// fern-lint: allow cyclomatic-complexity
pub function (y: f64) atan2(x: f64): f64 {
  let pi_o_4: f64 = 7.8539816339744827900e-01;
  let pi_o_2: f64 = 1.5707963267948965580e+00;
  let pi: f64 = 3.1415926535897931160e+00;
  let pi_lo: f64 = 1.2246467991473531772e-16;
  if (x != x || y != y) {
    return x + y;
  }
  let hx: i64 = _fd_hi(x);
  let ix: i64 = hx & 0x7fffffff;
  let lx: i64 = _fd_lo(x);
  let hy: i64 = _fd_hi(y);
  let iy: i64 = hy & 0x7fffffff;
  let ly: i64 = _fd_lo(y);
  if (hx == 0x3ff00000 && lx == 0) {
    return y.atan();
  }
  // 2 * sign(x) + sign(y)
  let m: i32 = 0;
  if (hy < 0) {
    m = m + 1;
  }
  if (hx < 0) {
    m = m + 2;
  }
  if ((iy | ly) == 0) {
    if (m < 2) {
      return y;
    }
    if (m == 2) {
      return pi;
    }
    return -pi;
  }
  if ((ix | lx) == 0) {
    if (hy < 0) {
      return -pi_o_2;
    }
    return pi_o_2;
  }
  if (ix == 0x7ff00000) {
    if (iy == 0x7ff00000) {
      if (m == 0) {
        return pi_o_4;
      }
      if (m == 1) {
        return -pi_o_4;
      }
      if (m == 2) {
        return 3.0 * pi_o_4;
      }
      return -3.0 * pi_o_4;
    }
    if (m == 0) {
      return 0.0;
    }
    if (m == 1) {
      return -0.0;
    }
    if (m == 2) {
      return pi;
    }
    return -pi;
  }
  if (iy == 0x7ff00000) {
    if (hy < 0) {
      return -pi_o_2;
    }
    return pi_o_2;
  }
  let k: i64 = iy - ix >> 20;
  let z: f64 = 0.0;
  if (k > 60) {
    z = pi_o_2 + 0.5 * pi_lo;
    m = m % 2;
  } else if (hx < 0 && k < -60) {
    z = 0.0;
  } else {
    z = __abs_f64(y / x).atan();
  }
  if (m == 0) {
    return z;
  }
  if (m == 1) {
    return -z;
  }
  if (m == 2) {
    return pi - (z - pi_lo);
  }
  return z - pi_lo - pi;
}

// `expm1(x)` — eˣ − 1, exact near zero where `exp(x) - 1.0` cancels away.
// Branches mirror the msun source so the port can be read against it.
// fern-lint: allow cyclomatic-complexity
pub function (x: f64) expm1(): f64 {
  let ln2_hi: f64 = 6.93147180369123816490e-01;
  let ln2_lo: f64 = 1.90821492927058770002e-10;
  let invln2: f64 = 1.44269504088896338700e+00;
  let b: i64 = f64_bits(x);
  let neg: boolean = b < 0;
  let hx: i64 = b >> 32 & 0x7fffffff;
  if (hx >= 0x4043687a) {
    if (hx >= 0x40862e42) {
      if (hx >= 0x7ff00000) {
        if ((hx & 0xfffff | _fd_lo(x)) != 0) {
          return x + x;
        }
        if (neg) {
          return -1.0;
        }
        return x;
      }
      if (x > 7.09782712893383973096e+02) {
        return 1.0e300 * 1.0e300;
      }
    }
    if (neg) {
      return -1.0;
    }
  }
  let k: i32 = 0;
  let c: f64 = 0.0;
  let v: f64 = x;
  if (hx > 0x3fd62e42) {
    let hi: f64 = 0.0;
    let lo: f64 = 0.0;
    if (hx < 0x3ff0a2b2) {
      if (!neg) {
        hi = x - ln2_hi;
        lo = ln2_lo;
        k = 1;
      } else {
        hi = x + ln2_hi;
        lo = -ln2_lo;
        k = -1;
      }
    } else {
      let half: f64 = 0.5;
      if (neg) {
        half = -0.5;
      }
      k = (invln2 * x + half) as i32;
      let t: f64 = k as f64;
      hi = x - t * ln2_hi;
      lo = t * ln2_lo;
    }
    v = hi - lo;
    c = hi - v - lo;
  } else if (hx < 0x3c900000) {
    return x;
  }
  let hfx: f64 = 0.5 * v;
  let hxs: f64 = v * hfx;
  let r1: f64 = 1.0 + hxs * (-3.33333333333331316428e-02 + hxs * (1.58730158725481460165e-03 + hxs * (-7.93650757867487942473e-05 + hxs * (4.00821782732936239552e-06 + hxs * -2.01099218183624371326e-07))));
  let t: f64 = 3.0 - r1 * hfx;
  let e: f64 = hxs * ((r1 - t) / (6.0 - v * t));
  if (k == 0) {
    return v - (v * e - hxs);
  }
  e = v * (e - c) - c;
  e = e - hxs;
  if (k == -1) {
    return 0.5 * (v - e) - 0.5;
  }
  if (k == 1) {
    if (v < -0.25) {
      return -2.0 * (e - (v + 0.5));
    }
    return 1.0 + 2.0 * (v - e);
  }
  if (k <= -2 || k > 56) {
    let y: f64 = 1.0 - (e - v);
    if (k == 1024) {
      y = y * 2.0 * _fd_words(0x7fe00000, 0);
    } else {
      y = y * _fd_words(0x3ff + k as i64 << 20, 0);
    }
    return y - 1.0;
  }
  let twopk: f64 = _fd_words(0x3ff + k as i64 << 20, 0);
  if (k < 20) {
    let tk: f64 = _fd_words(0x3ff00000 - (0x200000 as i64 >> k as i64), 0);
    return (tk - (e - v)) * twopk;
  }
  let tk: f64 = _fd_words(0x3ff - k as i64 << 20, 0);
  return (v - (e + tk) + 1.0) * twopk;
}

// `log1p(x)` — ln(1 + x), exact near zero where `(1.0 + x).log()` loses x.
// -1 is -Inf and anything below it NaN.
// Branches mirror the msun source so the port can be read against it.
// fern-lint: allow cyclomatic-complexity
pub function (x: f64) log1p(): f64 {
  let ln2_hi: f64 = 6.93147180369123816490e-01;
  let ln2_lo: f64 = 1.90821492927058770002e-10;
  let hx: i64 = _fd_hi(x);
  let ax: i64 = hx & 0x7fffffff;
  let k: i32 = 1;
  let f: f64 = 0.0;
  let hu: i64 = 0;
  let c: f64 = 0.0;
  if (hx < 0x3fda827a) {
    if (ax >= 0x3ff00000) {
      if (x == -1.0) {
        return -1.0 / 0.0;
      }
      return (x - x) / (x - x);
    }
    if (ax < 0x3e200000) {
      if (ax < 0x3c900000) {
        return x;
      }
      return x - x * x * 0.5;
    }
    if (hx > 0 || hx <= -1076707644) {
      k = 0;
      f = x;
      hu = 1;
    }
  }
  if (hx >= 0x7ff00000) {
    return x + x;
  }
  if (k != 0) {
    let u: f64 = x;
    if (hx < 0x43400000) {
      u = 1.0 + x;
      hu = _fd_hi(u);
      k = ((hu >> 20) - 1023) as i32;
      if (k > 0) {
        c = 1.0 - (u - x);
      } else {
        c = x - (u - 1.0);
      }
      c = c / u;
    } else {
      hu = _fd_hi(u);
      k = ((hu >> 20) - 1023) as i32;
      c = 0.0;
    }
    hu = hu & 0x000fffff;
    if (hu < 0x6a09e) {
      u = _fd_words(hu | 0x3ff00000, _fd_lo(u));
    } else {
      k = k + 1;
      u = _fd_words(hu | 0x3fe00000, _fd_lo(u));
      hu = 0x00100000 - hu >> 2;
    }
    f = u - 1.0;
  }
  let hfsq: f64 = 0.5 * f * f;
  let dk: f64 = k as f64;
  if (hu == 0) {
    if (f == 0.0) {
      if (k == 0) {
        return 0.0;
      }
      c = c + dk * ln2_lo;
      return dk * ln2_hi + c;
    }
    let r: f64 = hfsq * (1.0 - 0.66666666666666666 * f);
    if (k == 0) {
      return f - r;
    }
    return dk * ln2_hi - (r - (dk * ln2_lo + c) - f);
  }
  let s: f64 = f / (2.0 + f);
  let z: f64 = s * s;
  let r: f64 = z * (6.666666666666735130e-01 + z * (3.999999999940941908e-01 + z * (2.857142874366239149e-01 + z * (2.222219843214978396e-01 + z * (1.818357216161805012e-01 + z * (1.531383769920937332e-01 + z * 1.479819860511658591e-01))))));
  if (k == 0) {
    return f - (hfsq - s * (hfsq + r));
  }
  return dk * ln2_hi - (hfsq - (s * (hfsq + r) + (dk * ln2_lo + c)) - f);
}

// `sinh(x)` / `cosh(x)` / `tanh(x)` — the hyperbolic trig functions, built on
// the natural `exp` (`sinh = (eˣ - e⁻ˣ)/2`, `cosh = (eˣ + e⁻ˣ)/2`).
// `sinh(0)` is `0`, `cosh(0)` is `1`,
// `tanh(0)` is `0`, and the identity `cosh² - sinh² == 1` holds. `tanh` uses
// the stable `(e²ˣ - 1)/(e²ˣ + 1)` form and saturates to `±1` past `|x| = 20`
// (where it already equals `±1` to f64 precision), avoiding the `Inf/Inf` NaN
// that `sinh/cosh` would give for large magnitudes.
pub function (x: f64) sinh(): f64 {
  return (x.exp() - (0.0 - x).exp()) * 0.5;
}

pub function (x: f64) cosh(): f64 {
  return (x.exp() + (0.0 - x).exp()) * 0.5;
}

pub function (x: f64) tanh(): f64 {
  if (x > 20.0) {
    return 1.0;
  }
  if (x < 0.0 - 20.0) {
    return 0.0 - 1.0;
  }
  let e2: f64 = (x * 2.0).exp();
  return (e2 - 1.0) / (e2 + 1.0);
}

// `pow(x, y)` — two-argument form; method receiver is the
// base. Use `(b).pow(e)` for `b ^ e`.
pub function (x: f64) pow(y: f64): f64 {
  let n: i64 = y as i64;
  if (n as f64 == y && n <= 1074 && n >= -1074) {
    return _fd_pow_int(x, n);
  }
  return _fd_pow_general(x, y);
}

// `cbrt(x)` — the real cube root, the companion to `sqrt` but defined for
// negative inputs too (`cbrt(-8)` is `-2`). Since `pow` of a negative base with
// a fractional exponent is NaN, the sign is peeled off and reapplied around
// `pow(|x|, 1/3)`. `cbrt(0)` is `0` (sign preserved), NaN passes through.
pub function (x: f64) cbrt(): f64 {
  if (x != x) {
    return x;
  }
  if (x == 0.0) {
    return x;
  }
  if (x < 0.0) {
    return 0.0 - (0.0 - x).pow(1.0 / 3.0);
  }
  return x.pow(1.0 / 3.0);
}

// `hypot(x, y)` — the Euclidean length `sqrt(x*x + y*y)`, computed via the
// scaled form `hi * sqrt(1 + (lo/hi)^2)` (hi/lo the larger/smaller magnitude)
// so it does NOT overflow when a naive `x*x + y*y` would, and stays accurate
// for very lopsided inputs. `hypot(0, 0)` is `0`.
pub function (x: f64) hypot(y: f64): f64 {
  let ax: f64 = x.abs();
  let ay: f64 = y.abs();
  let hi: f64 = ax.max(ay);
  let lo: f64 = ax.min(ay);
  if (hi == 0.0) {
    return 0.0;
  }
  let r: f64 = lo / hi;
  return hi * (1.0 + r * r).sqrt();
}

// `hypot3(x, y, z)` — the 3-D Euclidean length `sqrt(x*x + y*y + z*z)`, the
// three-argument sibling of `hypot`. Same overflow-safe scaling: divide through
// by the largest magnitude before squaring, so a component near the f64 max
// doesn't overflow the sum. `hypot3(0, 0, 0)` is `0`; `hypot3(2, 3, 6)` is `7`.
pub function (x: f64) hypot3(y: f64, z: f64): f64 {
  let ax: f64 = x.abs();
  let ay: f64 = y.abs();
  let az: f64 = z.abs();
  let hi: f64 = ax.max(ay).max(az);
  if (hi == 0.0) {
    return 0.0;
  }
  let rx: f64 = ax / hi;
  let ry: f64 = ay / hi;
  let rz: f64 = az / hi;
  return hi * (rx * rx + ry * ry + rz * rz).sqrt();
}

// `fract(x)` — the fractional part, `x - trunc(x)`; keeps `x`'s sign, so
// `fract(-3.75)` is `-0.75`. The companion to `trunc` / `floor` / `ceil`.
pub function (x: f64) fract(): f64 {
  return x - __trunc_f64(x);
}

// `is_nan(x)` / `is_inf(x)` / `is_finite(x)` — IEEE-754
// classification. The NaN predicate uses the textbook
// "x != x" pattern; `is_inf` checks both ±Inf by squaring
// (Inf * 2 == Inf, finite * 2 grows), `is_finite` is the
// negation. Helpers so test code doesn't have to spell out
// the textbook patterns every time.
pub function (x: f64) is_nan(): boolean {
  return x != x;
}

pub function (x: f64) is_finite(): boolean {
  if (x != x) {
    return false;
  }
  if (x != 0.0 && x * 2.0 == x) {
    return false;
  }
  return true;
}

// `(x: f64) is_sign_negative()` / `is_sign_positive()` — test the IEEE-754
// sign BIT, so they classify `-0.0` as negative and `+0.0` as positive
// (unlike `x < 0.0`, which is false for both zeros and for any NaN). A
// NaN's sign is whatever bit it carries. Read via `f64_bits` (bit 63),
// so no comparison-with-zero rounding is involved.
pub function (x: f64) is_sign_negative(): boolean {
  return f64_bits(x) < 0;
}

pub function (x: f64) is_sign_positive(): boolean {
  return f64_bits(x) >= 0;
}

pub function (x: f64) is_inf(): boolean {
  if (x != x) {
    return false;
  }
  if (x == 0.0) {
    return false;
  }
  return x * 2.0 == x;
}

// `min(x, y)` / `max(x, y)` — return the smaller / larger
// value. NaN inputs are infectious (any NaN in → NaN out),
// matching Go's `math.Min` / `math.Max` semantics. Float
// comparisons with NaN are well-defined as "always false",
// which is what the inline check below relies on.
pub function (x: f64) min(y: f64): f64 {
  if (x != x) {
    return x;
  }
  if (y != y) {
    return y;
  }
  if (x < y) {
    return x;
  }
  return y;
}

pub function (x: f64) max(y: f64): f64 {
  if (x != x) {
    return x;
  }
  if (y != y) {
    return y;
  }
  if (x > y) {
    return x;
  }
  return y;
}

// `clamp(x, lo, hi)` — restrict to `[lo, hi]`. Implemented
// as `max(lo, min(hi, x))`; preserves NaN if any input is
// NaN.
pub function (x: f64) clamp(lo: f64, hi: f64): f64 {
  return lo.max(x.min(hi));
}

// `clamp01(x)` — restrict to the unit interval `[0, 1]`, the common case for
// colour channels, probabilities, and interpolation weights. Shorthand for
// `clamp(0, 1)`; NaN propagates like `clamp`.
pub function (x: f64) clamp01(): f64 {
  return 0.0.max(x.min(1.0));
}

// `abs_diff(a, b)` — the absolute difference `|a - b|`, the float sibling of the
// i32 / i64 helpers. NaN in either operand propagates.
pub function (a: f64) abs_diff(b: f64): f64 {
  let d: f64 = a - b;
  if (d < 0.0) {
    return 0.0 - d;
  }
  return d;
}

// `mul_add(a, b, c)` — `a * b + c`. A convenience for the common
// multiply-accumulate step; note this is NOT a hardware-fused FMA — the
// intermediate `a * b` rounds before the add, so it is exactly `a * b + c` in
// f64 arithmetic, not the single-rounding `fma`.
pub function (a: f64) mul_add(b: f64, c: f64): f64 {
  return a * b + c;
}

// `signum(x)` — `1.0` if positive, `-1.0` if negative, the value itself
// (`0.0` / `-0.0`) at zero, and `NaN` for `NaN`. Matches Rust's `f64::signum`
// EXCEPT at zero, where Rust returns `±1.0` on signed zeros; here signed zero
// returns zero, which is the more common "sign of a magnitude" expectation.
pub function (x: f64) signum(): f64 {
  if (x != x) {
    return x;
  }
  if (x > 0.0) {
    return 1.0;
  }
  if (x < 0.0) {
    return 0.0 - 1.0;
  }
  return x;
}

// `lerp(a, b, t)` — linear interpolation from `a` (at `t == 0`) to `b`
// (at `t == 1`). Uses the precise `a + (b - a) * t` form; `t` outside
// `[0, 1]` extrapolates. NaN in any operand propagates.
pub function (a: f64) lerp(b: f64, t: f64): f64 {
  return a + (b - a) * t;
}

// `recip(x)` — the reciprocal `1 / x`. `recip(4)` is `0.25`; `recip(0)` is
// `+Inf` (and `recip(-0)` is `-Inf`, since the division carries the sign).
// Purely arithmetic — no libm primitive — so it lowers on every backend.
pub function (x: f64) recip(): f64 {
  return 1.0 / x;
}

// `copysign(x, sign)` — the magnitude of `x` carrying the sign of `sign`:
// `copysign(3, -1)` is `-3`, `copysign(-3, 2)` is `3`. The sign test is
// `sign < 0`, so a signed negative zero (`-0.0`, which compares equal to
// `+0.0`) reads as positive here — the one case where this differs from a
// bit-level copysign. NaN magnitude passes through with the chosen sign.
pub function (x: f64) copysign(sign: f64): f64 {
  let m: f64 = x.abs();
  if (sign < 0.0) {
    return 0.0 - m;
  }
  return m;
}

// `midpoint(a, b)` — the point halfway between `a` and `b`, computed as
// `a*0.5 + b*0.5` so it never overflows the way `(a + b) / 2` would when both
// operands are near the f64 max. `midpoint(2, 4)` is `3`, `midpoint(1, 2)` is
// `1.5`.
pub function (a: f64) midpoint(b: f64): f64 {
  return a * 0.5 + b * 0.5;
}

// `to_radians()` / `to_degrees()` — convert between degrees and radians,
// the natural companions to `sin` / `cos` (which take radians). Uses a
// high-precision π; the round-trip `d.to_radians().to_degrees()` recovers
// `d` to f64 accuracy.
pub function (deg: f64) to_radians(): f64 {
  return deg * (3.141592653589793 / 180.0);
}

pub function (rad: f64) to_degrees(): f64 {
  return rad * (180.0 / 3.141592653589793);
}

// f32 mirror methods for explicitly-f32 values (a bare `3.14`
// is f64 — the language's default float, #5363 — and takes the
// f64 receiver methods above). Each wraps the f64 primitive —
// promote to f64, apply, demote back. Float precision in the
// final answer is bounded by the f32 input + the operation's
// f64-domain accuracy; the demotion-to-f32 rounds the result
// to the nearest f32.

pub function (x: f32) abs(): f32 {
  return __abs_f64(x as f64) as f32;
}

pub function (x: f32) floor(): f32 {
  return __floor_f64(x as f64) as f32;
}

pub function (x: f32) ceil(): f32 {
  return __ceil_f64(x as f64) as f32;
}

pub function (x: f32) round(): f32 {
  return __round_f64(x as f64) as f32;
}

pub function (x: f32) round_to(digits: i32): f32 {
  return (x as f64).round_to(digits) as f32;
}

pub function (x: f32) trunc(): f32 {
  return __trunc_f64(x as f64) as f32;
}

pub function (x: f32) sqrt(): f32 {
  return __sqrt_f64(x as f64) as f32;
}

pub function (x: f32) log(): f32 {
  return (x as f64).log() as f32;
}

pub function (x: f32) log2(): f32 {
  return ((x as f64).log() / 0.6931471805599453) as f32;
}

pub function (x: f32) log10(): f32 {
  return ((x as f64).log() / 2.302585092994046) as f32;
}

pub function (x: f32) exp(): f32 {
  return (x as f64).exp() as f32;
}

pub function (x: f32) exp2(): f32 {
  return (x as f64 * 0.6931471805599453).exp() as f32;
}

pub function (x: f32) exp10(): f32 {
  return (x as f64 * 2.302585092994046).exp() as f32;
}

pub function (x: f32) sin(): f32 {
  return _fd_trig(x as f64, 0) as f32;
}

pub function (x: f32) cos(): f32 {
  return _fd_trig(x as f64, 1) as f32;
}

pub function (x: f32) tan(): f32 {
  return (_fd_trig(x as f64, 0) / _fd_trig(x as f64, 1)) as f32;
}

pub function (x: f32) sinh(): f32 {
  return (x as f64).sinh() as f32;
}

pub function (x: f32) cosh(): f32 {
  return (x as f64).cosh() as f32;
}

pub function (x: f32) tanh(): f32 {
  return (x as f64).tanh() as f32;
}

pub function (x: f32) asin(): f32 {
  return (x as f64).asin() as f32;
}

pub function (x: f32) acos(): f32 {
  return (x as f64).acos() as f32;
}

pub function (x: f32) atan(): f32 {
  return (x as f64).atan() as f32;
}

pub function (x: f32) expm1(): f32 {
  return (x as f64).expm1() as f32;
}

pub function (x: f32) log1p(): f32 {
  return (x as f64).log1p() as f32;
}

pub function (y: f32) atan2(x: f32): f32 {
  return (y as f64).atan2(x as f64) as f32;
}

pub function (x: f32) pow(y: f32): f32 {
  return (x as f64).pow(y as f64) as f32;
}

pub function (x: f32) cbrt(): f32 {
  return (x as f64).cbrt() as f32;
}

pub function (x: f32) hypot(y: f32): f32 {
  let ax: f64 = (x as f64).abs();
  let ay: f64 = (y as f64).abs();
  let hi: f64 = ax.max(ay);
  let lo: f64 = ax.min(ay);
  if (hi == 0.0) {
    return 0.0 as f32;
  }
  let r: f64 = lo / hi;
  return (hi * (1.0 + r * r).sqrt()) as f32;
}

pub function (x: f32) hypot3(y: f32, z: f32): f32 {
  return (x as f64).hypot3(y as f64, z as f64) as f32;
}

pub function (x: f32) fract(): f32 {
  return (x as f64 - __trunc_f64(x as f64)) as f32;
}

pub function (x: f32) is_nan(): boolean {
  return x != x;
}

pub function (x: f32) is_finite(): boolean {
  if (x != x) {
    return false;
  }
  if (x != 0.0 as f32 && x * (2.0 as f32) == x) {
    return false;
  }
  return true;
}

// `(x: f32) is_sign_negative()` / `is_sign_positive()` — the f32 siblings;
// the sign is bit 31 of `f32_bits`. See the f64 forms above.
pub function (x: f32) is_sign_negative(): boolean {
  return f32_bits(x) < 0;
}

pub function (x: f32) is_sign_positive(): boolean {
  return f32_bits(x) >= 0;
}

pub function (x: f32) is_inf(): boolean {
  if (x != x) {
    return false;
  }
  if (x == 0.0 as f32) {
    return false;
  }
  return x * (2.0 as f32) == x;
}

pub function (x: f32) min(y: f32): f32 {
  if (x != x) {
    return x;
  }
  if (y != y) {
    return y;
  }
  if (x < y) {
    return x;
  }
  return y;
}

pub function (x: f32) max(y: f32): f32 {
  if (x != x) {
    return x;
  }
  if (y != y) {
    return y;
  }
  if (x > y) {
    return x;
  }
  return y;
}

pub function (x: f32) clamp(lo: f32, hi: f32): f32 {
  return lo.max(x.min(hi));
}

pub function (x: f32) clamp01(): f32 {
  return (0.0 as f32).max(x.min(1.0 as f32));
}

pub function (a: f32) abs_diff(b: f32): f32 {
  let d: f32 = a - b;
  if (d < 0.0 as f32) {
    return 0.0 as f32 - d;
  }
  return d;
}

pub function (a: f32) mul_add(b: f32, c: f32): f32 {
  return a * b + c;
}

pub function (x: f32) signum(): f32 {
  if (x != x) {
    return x;
  }
  if (x > 0.0 as f32) {
    return 1.0 as f32;
  }
  if (x < 0.0 as f32) {
    return 0.0 as f32 - 1.0 as f32;
  }
  return x;
}

pub function (a: f32) lerp(b: f32, t: f32): f32 {
  return a + (b - a) * t;
}

pub function (x: f32) recip(): f32 {
  return 1.0 as f32 / x;
}

pub function (x: f32) copysign(sign: f32): f32 {
  let m: f32 = x.abs();
  if (sign < 0.0 as f32) {
    return 0.0 as f32 - m;
  }
  return m;
}

pub function (a: f32) midpoint(b: f32): f32 {
  return (a as f64 * 0.5 + b as f64 * 0.5) as f32;
}

pub function (deg: f32) to_radians(): f32 {
  return (deg as f64 * (3.141592653589793 / 180.0)) as f32;
}

pub function (rad: f32) to_degrees(): f32 {
  return (rad as f64 * (180.0 / 3.141592653589793)) as f32;
}
