// `string_cmp(a, b)` — lexicographic byte-order comparator.
// Returns -1 / 0 / 1. Lang's `<` / `>` operators only work
// on numerics; string-array sort needs a dedicated three-way
// comparator. Compares byte-by-byte up to the shorter
// length, then breaks ties on length (shorter < longer).
pub function string_cmp(a: string, b: string): i32 {
    var n: i32 = len(a);
    var m: i32 = len(b);
    var min: i32 = n;
    if (m < n) { min = m; }
    var i: i32 = 0;
    while (i < min) {
        if (a[i] < b[i]) { return 0 - 1; }
        if (a[i] > b[i]) { return 1; }
        i = i + 1;
    }
    if (n < m) { return 0 - 1; }
    if (n > m) { return 1; }
    return 0;
}

// `sort_strings_asc(arr)` / `sort_strings_desc(arr)` —
// lexicographic byte-order sort of a string array. Insertion
// sort like the i32 helpers; O(n²) worst case fine for the
// small-list use cases (config keys, sorted output for
// stable tests, alphabetised CLI flags).
pub function sort_strings_asc(arr: string[]): string[] {
    var n: i32 = len(arr);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.push(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: string = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && string_cmp(out[j], key) > 0) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        k = k + 1;
    }
    return out;
}

pub function sort_strings_desc(arr: string[]): string[] {
    var n: i32 = len(arr);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.push(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: string = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && string_cmp(out[j], key) < 0) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        k = k + 1;
    }
    return out;
}

// `string_cmp_ci(a, b)` — same as string_cmp but ASCII case-
// folded per byte. Useful as the ordering for case-insensitive
// sort.
pub function string_cmp_ci(a: string, b: string): i32 {
    var n: i32 = len(a);
    var m: i32 = len(b);
    var min: i32 = n;
    if (m < n) { min = m; }
    var i: i32 = 0;
    while (i < min) {
        var ca: i32 = a[i].to_lower();
        var cb: i32 = b[i].to_lower();
        if (ca < cb) { return 0 - 1; }
        if (ca > cb) { return 1; }
        i = i + 1;
    }
    if (n < m) { return 0 - 1; }
    if (n > m) { return 1; }
    return 0;
}

// `sort_strings_asc_ci(arr)` — case-insensitive ascending
// sort. Useful for user-facing alphabetical listings where
// case shouldn't fragment the ordering.
pub function sort_strings_asc_ci(arr: string[]): string[] {
    var n: i32 = len(arr);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.push(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: string = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && string_cmp_ci(out[j], key) > 0) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        k = k + 1;
    }
    return out;
}
