pub function sort_i32_desc(arr: i32[]): i32[] {
    var n: i32 = arr.len();
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && out[j] < key) {
            out = out.with(j + 1, out[j]);
            j = j - 1;
        }
        out = out.with(j + 1, key);
        k = k + 1;
    }
    return out;
}

// `string_cmp(a, b)` — lexicographic byte-order comparator.
// Returns -1 / 0 / 1. Lang's `<` / `>` operators only work
// on numerics; string-array sort needs a dedicated three-way
// comparator. Compares byte-by-byte up to the shorter
// length, then breaks ties on length (shorter < longer).
pub function string_cmp(a: string, b: string): i32 {
    var n: i32 = a.len();
    var m: i32 = b.len();
    var min: i32 = n;
    if (m < n) { min = m; }
    var i: i32 = 0;
    while (i < min) {
        if (a[i] < b[i]) { return 0 - 1; }
        if (a[i] > b[i]) { return 1; }
        i = i + 1;
    }
    if (n < m) { return 0 - 1; }
    if (n > m) { return 1; }
    return 0;
}

// `sort_strings_asc(arr)` / `sort_strings_desc(arr)` —
// lexicographic byte-order sort of a string array. Insertion
// sort like the i32 helpers; O(n²) worst case fine for the
// small-list use cases (config keys, sorted output for
// stable tests, alphabetised CLI flags).
pub function sort_strings_asc(arr: string[]): string[] {
    var n: i32 = arr.len();
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: string = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && string_cmp(out[j], key) > 0) {
            out = out.with(j + 1, out[j]);
            j = j - 1;
        }
        out = out.with(j + 1, key);
        k = k + 1;
    }
    return out;
}

pub function sort_strings_desc(arr: string[]): string[] {
    var n: i32 = arr.len();
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: string = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && string_cmp(out[j], key) < 0) {
            out = out.with(j + 1, out[j]);
            j = j - 1;
        }
        out = out.with(j + 1, key);
        k = k + 1;
    }
    return out;
}

// `string_cmp_ci(a, b)` — same as string_cmp but ASCII case-
// folded per byte. Useful as the ordering for case-insensitive
// sort.
pub function string_cmp_ci(a: string, b: string): i32 {
    var n: i32 = a.len();
    var m: i32 = b.len();
    var min: i32 = n;
    if (m < n) { min = m; }
    var i: i32 = 0;
    while (i < min) {
        var ca: i32 = a[i].to_lower();
        var cb: i32 = b[i].to_lower();
        if (ca < cb) { return 0 - 1; }
        if (ca > cb) { return 1; }
        i = i + 1;
    }
    if (n < m) { return 0 - 1; }
    if (n > m) { return 1; }
    return 0;
}

// `sort_strings_asc_ci(arr)` — case-insensitive ascending
// sort. Useful for user-facing alphabetical listings where
// case shouldn't fragment the ordering.
pub function sort_strings_asc_ci(arr: string[]): string[] {
    var n: i32 = arr.len();
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: string = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && string_cmp_ci(out[j], key) > 0) {
            out = out.with(j + 1, out[j]);
            j = j - 1;
        }
        out = out.with(j + 1, key);
        k = k + 1;
    }
    return out;
}

// --- In-place (`own`) sorts ------------------------------------------------
//
// The `sort_*_asc`/`_desc` functions above are non-mutating: they copy the
// input into a fresh buffer and sort that, so a borrowed array survives the
// call unchanged. That copy is pure overhead when the caller is finished with
// the input and just wants it sorted.
//
// `sort_i32_inplace_asc`/`_desc` take the array `own` (consuming): the caller
// transfers ownership, so the sort permutes the input buffer directly and hands
// the *same* allocation back — no copy, zero allocation. Because the parameter
// is `own`, the checker's affine + ownership-guard rules (E050/E051) require the
// argument to be an owned value (a fresh literal or another `own` binding), and
// the caller cannot use the array afterwards — exactly the contract that makes
// the in-place mutation sound.
//
// This dogfoods the `own` consuming-parameter feature in the stdlib: real code
// whose ownership transfer (the returned array IS the input box) is pinned by
// the differential e2e gates.

// `sort_i32_inplace_asc(own arr)` — ascending insertion-sort performed directly
// on the (owned) input buffer; returns that same buffer, now sorted.
pub fip function sort_i32_inplace_asc(own arr: i32[]): i32[] {
    var n: i32 = arr.len();
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = arr[k];
        var j: i32 = k - 1;
        while (j >= 0 && arr[j] > key) {
            arr = arr.with(j + 1, arr[j]);
            j = j - 1;
        }
        arr = arr.with(j + 1, key);
        k = k + 1;
    }
    return arr;
}

// `sort_i32_inplace_desc(own arr)` — as above, descending.
pub fip function sort_i32_inplace_desc(own arr: i32[]): i32[] {
    var n: i32 = arr.len();
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = arr[k];
        var j: i32 = k - 1;
        while (j >= 0 && arr[j] < key) {
            arr = arr.with(j + 1, arr[j]);
            j = j - 1;
        }
        arr = arr.with(j + 1, key);
        k = k + 1;
    }
    return arr;
}

// `sort_by[T](arr, cmp)` — return a fresh copy of `arr` sorted by the
// comparator closure `cmp(a, b)`, which returns < 0 when a should come
// before b, > 0 when after, 0 when equivalent (the std/sort convention,
// and what `core/cmp`'s `Ord.cmp` returns — so `sort_by(xs, Ord.cmp)`
// is the comparator form of `core/cmp`'s `sort[T: Ord]`). Generic over
// ANY element type via the comparator, without an `Ord` bound: sort by a
// projected key, reverse order, or any custom relation. Stable insertion
// sort, O(n²) — same small-input niche as the monomorphic sorts above;
// it now lowers on the self-host IR path too (the closure-arg
// infrastructure the module header once deferred has since landed, incl.
// fn-typed args in loop conditions). The input is not mutated.
pub function sort_by[T](arr: T[], cmp: (T, T) => i32): T[] {
    var out: T[] = arr;
    var n: i32 = out.len();
    var i: i32 = 1;
    while (i < n) {
        var j: i32 = i;
        while (j > 0 && cmp(out[j], out[j - 1]) < 0) {
            var tmp: T = out[j];
            out = out.with(j, out[j - 1]);
            out = out.with(j - 1, tmp);
            j = j - 1;
        }
        i = i + 1;
    }
    return out;
}

// `is_sorted_by[T](arr, cmp)` — true iff `arr` is in non-decreasing order
// under the comparator `cmp` (no adjacent pair where the later sorts
// strictly before the earlier). The verification companion to `sort_by`.
pub function is_sorted_by[T](arr: T[], cmp: (T, T) => i32): boolean {
    var i: i32 = 1;
    var n: i32 = arr.len();
    while (i < n) {
        if (cmp(arr[i], arr[i - 1]) < 0) { return false; }
        i = i + 1;
    }
    return true;
}

// `sort_by_i32_key[T](arr, key)` — return a fresh copy of `arr` sorted
// ascending by the i32 `key(x)` projection. The common "sort records by a
// numeric field" case (`sort_by_i32_key(rows, \r -> r.timestamp)`), without
// spelling a full comparator. Keys are computed ONCE up front into a parallel
// array (a Schwartzian transform — each element's `key` is evaluated a single
// time, not O(n log n) times), then the elements and their keys are insertion-
// sorted together by the precomputed i32 key. Stable, O(n²); the input is not
// mutated. (Correct on every backend; on the self-host it currently lowers via
// the AST emitter rather than the IR path — a closure-typed param over a
// generic `T[]` isn't yet IR-eligible there.)
pub function sort_by_i32_key[T](arr: T[], key: (T) => i32): T[] {
    var out: T[] = arr;
    var keys: i32[] = [];
    for x in out { keys = keys.append(key(x)); }
    var n: i32 = out.len();
    var i: i32 = 1;
    while (i < n) {
        var j: i32 = i;
        while (j > 0 && keys[j] < keys[j - 1]) {
            var tv: T = out[j];
            out = out.with(j, out[j - 1]);
            out = out.with(j - 1, tv);
            var tk: i32 = keys[j];
            keys = keys.with(j, keys[j - 1]);
            keys = keys.with(j - 1, tk);
            j = j - 1;
        }
        i = i + 1;
    }
    return out;
}
