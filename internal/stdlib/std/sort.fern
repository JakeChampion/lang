pub function sort_u64_asc(arr: u64[]): u64[] {
    var n: i32 = arr.len();
    var out: u64[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: u64 = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && out[j] > key) {
            out = out.with(j + 1, out[j]);
            j = j - 1;
