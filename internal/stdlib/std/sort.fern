// std/sort — comparator-driven and case-insensitive string sorts, the
// `own`-consuming in-place i32 sorts, and the byte-lexicographic string
// comparators. The per-width *monomorphic* sort zoo (`sort_i32_asc` /
// `sort_i64_asc` / `sort_u32_asc` / `sort_u64_asc` / `sort_f64_asc` and their
// `_desc` mirrors, plus `sort_strings_asc` / `sort_strings_desc`) was retired
// in #5397 in favour of `core/cmp`'s generic `sort[T: Ord]` / `sort_desc[T:
// Ord]`: one body dispatching `.cmp`, monomorphised per element type on the
// self-host IR path (so an `i32` element still lowers to the direct scalar
// three-way, a `u32` to the unsigned compare, a `string` to the lexicographic
// byte compare — no comparator-closure indirection), covering every `Ord`
// element type incl. `@derive(Ord)` structs / enums. Call `cmp.sort(xs)` /
// `cmp.sort_desc(xs)` where you used to call `sort_i32_asc(xs)` etc.
//
// What still lives here (no generic `Ord` equivalent):
//   - `sort_by[T](arr, cmp)` — comparator form for ANY element type / custom
//     ordering without an `Ord` bound (sort by a projected key, reverse order,
//     any relation). `sort_by_i32_key` / `sort_key` are its Schwartzian-transform
//     key-projection siblings.
//   - `sort_strings_asc_ci(arr)` — case-insensitive string sort (no generic
//     case-folding `Ord`); a `sort_by` delegation over `string_cmp_ci`.
//   - `sort_i32_inplace_asc` / `_desc` — `own`-consuming, zero-allocation
//     insertion sorts (`fip`); no generic consuming equivalent.
//   - `string_cmp` / `string_cmp_ci` — three-way comparators for callers that
//     need one directly (a `sort_by` argument, say) rather than the `<` / `>`
//     operators.
//
// Aliasing rule (shared by every merge sort in this file and by `cmp.sort`):
// each merge pass materializes its scratch buffer as a FRESH copy (an `.append`
// loop), never `var dst = src;`, so no merge ever reads a slot it has already
// overwritten. Append-only output cannot alias its input on any backend. The
// rule was forced by the self-host AST emitter, which had no Perceus and wrote
// `.with` through an alias in place, corrupting an aliased merge (#5397); that
// emitter is deleted (#3457/#5972) and the shape stays because it is the correct
// one. Do NOT "optimize" any of these back to an aliased copy-on-write buffer.
//
// No prelude: a program `import "std/sort";` explicitly. The generic sorts live
// in `core/cmp`, so reach for `cmp.sort` via `import "core/cmp";`.

// `string_cmp_ci` folds each BYTE through `(u8) .to_ascii_lower()`, which
// lives in std/i32 — declare it so the receiver method registers under
// no-prelude rather than arriving by luck through core/cmp's own imports.
import "std/i32";

// `sort_key` compares projected keys via `core/cmp`'s `Ord.cmp`, so
// declare it to register the `.cmp()` method under no-prelude.
import "core/cmp";

// `string_cmp(a, b)` — three-way form of the `<` / `>` operators'
// byte-order comparison, for the comparator-taking sorts. Returns
// -1 / 0 / 1.
pub function string_cmp(a: string, b: string): i32 {
    if (a < b) { return 0 - 1; }
    if (a > b) { return 1; }
    return 0;
}

// `string_cmp_ci(a, b)` — `string_cmp`'s ordering with each ASCII
// letter case-folded first. Stays a byte loop rather than delegating
// to the operators: they compare raw bytes, and folding both operands
// into fresh lowercase strings first would allocate twice per
// comparison, inside a sort's O(n log n) inner loop.
pub function string_cmp_ci(a: string, b: string): i32 {
    var n: i32 = a.len();
    var m: i32 = b.len();
    var min: i32 = n;
    if (m < n) { min = m; }
    var i: i32 = 0;
    while (i < min) {
        var ca: i32 = a[i].to_ascii_lower() as i32;
        var cb: i32 = b[i].to_ascii_lower() as i32;
        if (ca < cb) { return 0 - 1; }
        if (ca > cb) { return 1; }
        i = i + 1;
    }
    if (n < m) { return 0 - 1; }
    if (n > m) { return 1; }
    return 0;
}

// `sort_strings_asc_ci(arr)` — case-insensitive ascending
// sort over `string_cmp_ci`. Useful for user-facing
// alphabetical listings where case shouldn't fragment the
// ordering. Stable (merge sort): strings that compare ci-equal
// ("Apple" / "apple") keep their input order. One-line `sort_by`
// delegation (#4829); no generic `Ord` equivalent, since `Ord for
// string` is case-sensitive. Passing the bare `string_cmp_ci`
// comparator also keeps the wasm direct-call + closure-target ABI
// reconciliation (#4829) exercised through the real std/sort module.
pub function sort_strings_asc_ci(arr: string[]): string[] {
    return sort_by(arr, string_cmp_ci);
}

// --- In-place (`own`) sorts ------------------------------------------------
//
// The generic `cmp.sort` / `cmp.sort_desc` (and `sort_by` below) are
// non-mutating: the input array survives the call unchanged (the merge scratch
// buffer is a fresh copy). That fresh result is pure overhead when the caller is
// finished with the input and just wants it sorted.
//
// `sort_i32_inplace_asc`/`_desc` take the array `own` (consuming): the caller
// transfers ownership, so the sort permutes the input buffer directly and hands
// the *same* allocation back — no copy, zero allocation. Because the parameter
// is `own`, the checker's affine + ownership-guard rules (E050/E051) require the
// argument to be an owned value (a fresh literal or another `own` binding), and
// the caller cannot use the array afterwards — exactly the contract that makes
// the in-place mutation sound.
//
// These stay insertion sorts (O(n²) worst case) deliberately: `fip` functions
// must not allocate, and a merge sort needs a scratch buffer. Reach for them
// on small inputs where the zero-allocation property matters; for large inputs
// prefer the O(n log n) non-consuming sorts. No generic consuming equivalent
// exists yet, so these stay monomorphic.
//
// This dogfoods the `own` consuming-parameter feature in the stdlib: real code
// whose ownership transfer (the returned array IS the input box) is pinned by
// the differential e2e gates.

// `sort_i32_inplace_asc(own arr)` — ascending insertion-sort performed directly
// on the (owned) input buffer; returns that same buffer, now sorted.
pub fip function sort_i32_inplace_asc(own arr: i32[]): i32[] {
    var n: i32 = arr.len();
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = arr[k];
        var j: i32 = k - 1;
        while (j >= 0 && arr[j] > key) {
            arr = arr.with(j + 1, arr[j]);
            j = j - 1;
        }
        arr = arr.with(j + 1, key);
        k = k + 1;
    }
    return arr;
}

// `sort_i32_inplace_desc(own arr)` — as above, descending.
pub fip function sort_i32_inplace_desc(own arr: i32[]): i32[] {
    var n: i32 = arr.len();
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = arr[k];
        var j: i32 = k - 1;
        while (j >= 0 && arr[j] < key) {
            arr = arr.with(j + 1, arr[j]);
            j = j - 1;
        }
        arr = arr.with(j + 1, key);
        k = k + 1;
    }
    return arr;
}

// `sort_by[T](arr, cmp)` — return a fresh copy of `arr` sorted by the
// comparator closure `cmp(a, b)`, which returns < 0 when a should come
// before b, > 0 when after, 0 when equivalent (the std/sort convention,
// and what `core/cmp`'s `Ord.cmp` returns — so `sort_by(xs, Ord.cmp)`
// is the comparator form of `core/cmp`'s `sort[T: Ord]`). Generic over
// ANY element type via the comparator, without an `Ord` bound: sort by a
// projected key, reverse order, or any custom relation.
//
// STABLE and ADAPTIVE: a natural-run merge sort, the comparator-closure
// sibling of `core/cmp`'s `sort`. O(n) on already-sorted or reverse-sorted
// input, O(n log n) worst case.
//
//   n < 2   -> the input, untouched
//   n <= 32 -> one insertion sort, no merging and no per-pass copy
//   larger  -> detect natural runs, then merge adjacent runs in balanced rounds
//
// The adaptivity is what changed. This was a FIXED bottom-up merge sort that
// materialised a fresh full copy of the array on every one of its ceil(log2 n)
// passes, and did so regardless of the input — an already-sorted array cost
// exactly as much as a random one, which is the common case in practice for a
// `sort_by` over rows that arrive mostly ordered. Now a sorted (or
// reverse-sorted) input is a SINGLE run: the merge loop never executes and the
// call is O(n) with one copy.
//
// Stability is preserved throughout: a descending run is detected with a
// STRICT compare (equal neighbours end the run rather than being swapped past
// each other) before being reversed, and a merge takes from the right run only
// when the left compares strictly greater.
//
// Merging appends into a fresh array rather than writing through `.with`, so no
// merge ever reads a slot it has already overwritten. That retires the
// fresh-copy-per-pass rule the old body carried: it was written for the
// self-host AST emitter, deleted since (#3457/#5972), and append-only output
// cannot alias its input on any backend regardless.
pub function sort_by[T](arr: T[], cmp: (T, T) => i32): T[] {
    var n: i32 = arr.len();
    if (n < 2) { return arr; }

    // Own a copy: the descending-run reversal writes in place.
    var a: T[] = [];
    var c: i32 = 0;
    while (c < n) { a = a.append(arr[c]); c = c + 1; }

    if (n <= 32) { return __sort_insertion_by(a, 0, n, cmp); }

    // Pass 1 — natural runs. `bounds` holds each run's start, terminated by n.
    var bounds: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        bounds = bounds.append(i);
        var e: i32 = i + 1;
        if (e < n) {
            if (cmp(a[i], a[e]) > 0) {
                // Strictly descending: extend, then reverse into order.
                var falling: boolean = true;
                while (falling) {
                    e = e + 1;
                    falling = false;
                    if (e < n) {
                        if (cmp(a[e - 1], a[e]) > 0) { falling = true; }
                    }
                }
                var lo: i32 = i;
                var hi: i32 = e - 1;
                while (lo < hi) {
                    var t: T = a[lo];
                    a = a.with(lo, a[hi]);
                    a = a.with(hi, t);
                    lo = lo + 1;
                    hi = hi - 1;
                }
            } else {
                var rising: boolean = true;
                while (rising) {
                    e = e + 1;
                    rising = false;
                    if (e < n) {
                        if (cmp(a[e - 1], a[e]) <= 0) { rising = true; }
                    }
                }
            }
        }
        i = e;
    }
    bounds = bounds.append(n);

    // Pass 2 — merge adjacent runs in rounds until one remains. Each round
    // rebuilds the array by appending merged segments, so the output never
    // aliases the input it is reading.
    while (bounds.len() > 2) {
        var out: T[] = [];
        var next: i32[] = [];
        var r: i32 = 0;
        while (r + 1 < bounds.len()) {
            var mlo: i32 = bounds[r];
            next = next.append(mlo);
            if (r + 2 < bounds.len()) {
                var mmid: i32 = bounds[r + 1];
                var mhi: i32 = bounds[r + 2];
                var p: i32 = mlo;
                var q: i32 = mmid;
                while (p < mmid && q < mhi) {
                    if (cmp(a[p], a[q]) > 0) {
                        out = out.append(a[q]);
                        q = q + 1;
                    } else {
                        out = out.append(a[p]);
                        p = p + 1;
                    }
                }
                while (p < mmid) { out = out.append(a[p]); p = p + 1; }
                while (q < mhi) { out = out.append(a[q]); q = q + 1; }
                r = r + 2;
            } else {
                // Odd run out: carry it forward untouched.
                var mend: i32 = bounds[r + 1];
                var mk: i32 = mlo;
                while (mk < mend) { out = out.append(a[mk]); mk = mk + 1; }
                r = r + 1;
            }
        }
        next = next.append(n);
        a = out;
        bounds = next;
    }
    return a;
}

// `__sort_insertion_by[T](a, lo, hi, cmp)` — insertion-sort `a[lo:hi]` in
// place under the comparator, returning the array.
//
// The base case for `sort_by`. Insertion sort wins decisively on short spans:
// no allocation, sequential access, and a nearly-sorted span costs close to a
// single pass — which is why every serious merge sort dispatches to one below a
// size threshold rather than merging all the way down.
//
// The shift loop stops on a NON-positive compare, so equal elements never move
// past each other: insertion is stable, and therefore so is `sort_by`.
function __sort_insertion_by[T](a: T[], lo: i32, hi: i32, cmp: (T, T) => i32): T[] {
    var out: T[] = a;
    var i: i32 = lo + 1;
    while (i < hi) {
        var v: T = out[i];
        var j: i32 = i - 1;
        var moving: boolean = j >= lo;
        while (moving) {
            if (cmp(out[j], v) > 0) {
                out = out.with(j + 1, out[j]);
                j = j - 1;
                moving = j >= lo;
            } else {
                moving = false;
            }
        }
        out = out.with(j + 1, v);
        i = i + 1;
    }
    return out;
}

// `is_sorted_by[T](arr, cmp)` — true iff `arr` is in non-decreasing order
// under the comparator `cmp` (no adjacent pair where the later sorts
// strictly before the earlier). The verification companion to `sort_by`.
pub function is_sorted_by[T](arr: T[], cmp: (T, T) => i32): boolean {
    var i: i32 = 1;
    var n: i32 = arr.len();
    while (i < n) {
        if (cmp(arr[i], arr[i - 1]) < 0) { return false; }
        i = i + 1;
    }
    return true;
}

// `sort_by_i32_key[T](arr, key)` — return a fresh copy of `arr` sorted
// ascending by the i32 `key(x)` projection. The common "sort records by a
// numeric field" case (`sort_by_i32_key(rows, \r -> r.timestamp)`), without
// spelling a full comparator. Keys are computed ONCE up front into a parallel
// array (a Schwartzian transform — each element's `key` is evaluated a single
// time, not O(n log n) times), then the elements and their keys are merge-
// sorted together in lockstep by the precomputed i32 key. Stable bottom-up
// merge sort, O(n log n) (#4387 item 3); the input is not mutated. Each merge
// pass materializes fresh `dstv` / `dstk` copies, so no merge reads a slot it
// has already overwritten (see the file-header aliasing rule).
//
// This body IS `sort_key` with `K` fixed to `i32` — `impl Ord for i32` is `<` /
// `>`, so the two order identically, stability included — and it stays spelled
// out rather than delegating because the self-host cannot yet monomorphise a
// generic that FORWARDS its closure parameter to another generic (#7187).
pub function sort_by_i32_key[T](arr: T[], key: (T) => i32): T[] {
    var srcv: T[] = arr;
    var srck: i32[] = [];
    for x in srcv { srck = srck.append(key(x)); }
    var n: i32 = srcv.len();
    if (n < 2) { return srcv; }
    var width: i32 = 1;
    while (width < n) {
        var dstv: T[] = [];
        var dstk: i32[] = [];
        var c: i32 = 0;
        while (c < n) { dstv = dstv.append(srcv[c]); dstk = dstk.append(srck[c]); c = c + 1; }
        var lo: i32 = 0;
        while (lo < n) {
            var mid: i32 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i32 = lo + width + width;
            if (hi > n) { hi = n; }
            var i: i32 = lo;
            var j: i32 = mid;
            var k: i32 = lo;
            while (i < mid && j < hi) {
                if (srck[j] < srck[i]) {
                    dstv = dstv.with(k, srcv[j]); dstk = dstk.with(k, srck[j]); j = j + 1;
                } else {
                    dstv = dstv.with(k, srcv[i]); dstk = dstk.with(k, srck[i]); i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) { dstv = dstv.with(k, srcv[i]); dstk = dstk.with(k, srck[i]); i = i + 1; k = k + 1; }
            while (j < hi) { dstv = dstv.with(k, srcv[j]); dstk = dstk.with(k, srck[j]); j = j + 1; k = k + 1; }
            lo = lo + width + width;
        }
        srcv = dstv;
        srck = dstk;
        width = width + width;
    }
    return srcv;
}

// `sort_key[T, K: cmp.Ord](arr, key)` — return a fresh copy of `arr`
// sorted ascending by the `key(x)` projection, where the key type `K`
// is any `core/cmp.Ord` (scalar, `string`, or a `@derive(Ord)` struct
// / enum). The generic-key generalisation of `sort_by_i32_key`: where
// that one is pinned to an i32 key and a scalar `<`, this dispatches
// the ordering through `k.cmp(k2)`, so you can sort records by a
// `string` name, a `u64` id, or any composite `Ord` key without
// spelling a full comparator. The `K: cmp.Ord` bound monomorphises the
// compare per key type on the self-host IR path — a `string` key
// lowers `.cmp` to the lexicographic byte compare, an `i32` key to the
// scalar three-way — where an unbounded `[K]` would erase and mis-
// order strings. Like `sort_by_i32_key` it is a Schwartzian transform:
// each element's `key` is evaluated ONCE up front into a parallel
// `K[]`, then the elements and their keys merge-sort in lockstep, so a
// costly projection is not recomputed O(n log n) times. Stable bottom-
// up merge sort, O(n log n); the input is not mutated (equal keys keep
// input order — the merge takes from the right run only on a STRICT
// `.cmp(...) < 0`). Fresh scratch copies per pass — see the file-header
// aliasing rule.
pub function sort_key[T, K: cmp.Ord](arr: T[], key: (T) => K): T[] {
    var srcv: T[] = arr;
    var srck: K[] = [];
    for x in srcv { srck = srck.append(key(x)); }
    var n: i32 = srcv.len();
    if (n < 2) { return srcv; }
    var width: i32 = 1;
    while (width < n) {
        var dstv: T[] = [];
        var dstk: K[] = [];
        var c: i32 = 0;
        while (c < n) { dstv = dstv.append(srcv[c]); dstk = dstk.append(srck[c]); c = c + 1; }
        var lo: i32 = 0;
        while (lo < n) {
            var mid: i32 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i32 = lo + width + width;
            if (hi > n) { hi = n; }
            var i: i32 = lo;
            var j: i32 = mid;
            var k: i32 = lo;
            while (i < mid && j < hi) {
                if (srck[j].cmp(srck[i]) < 0) {
                    dstv = dstv.with(k, srcv[j]); dstk = dstk.with(k, srck[j]); j = j + 1;
                } else {
                    dstv = dstv.with(k, srcv[i]); dstk = dstk.with(k, srck[i]); i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) { dstv = dstv.with(k, srcv[i]); dstk = dstk.with(k, srck[i]); i = i + 1; k = k + 1; }
            while (j < hi) { dstv = dstv.with(k, srcv[j]); dstk = dstk.with(k, srck[j]); j = j + 1; k = k + 1; }
            lo = lo + width + width;
        }
        srcv = dstv;
        srck = dstk;
        width = width + width;
    }
    return srcv;
}
