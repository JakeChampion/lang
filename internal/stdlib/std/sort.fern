// std/sort — free `sort_*` functions for scalar and string arrays.
//
// All the non-consuming sorts are stable bottom-up (iterative) merge
// sorts, O(n log n) comparisons — the same shape as the generic
// `sort_by` below and `core/cmp`'s `sort[T: Ord]` (#4387 item 3), so
// the monomorphic entry points are safe on arbitrary / large inputs,
// not just the compiler's small-list use cases (sorted field offsets,
// declaration orders, capacity hints). Stability: on a tie the left
// run's element is emitted first (the merge only takes from the right
// run when it compares *strictly* less), so equal keys keep their
// input order. The `own`-consuming in-place variants remain insertion
// sorts: `fip` functions must not allocate, and a merge sort needs a
// scratch buffer. (Like `sort_by`, the i32 pass arithmetic assumes
// n <= 2^30 — beyond that `lo + width + width` would wrap. Unreachable
// today: no target's heap arena can hold such an array plus its merge
// scratch.)
//
// The scalar entry points (`sort_i32_*` / `sort_i64_*` / `sort_u32/u64_*`)
// keep monomorphic bodies so the hot-loop compare is the direct scalar
// `<` / `>` — no per-element comparator-closure indirection (their
// allocation profile matches `sort_by`'s: one scratch copy per merge
// pass, materialized explicitly — see sort_i32_asc's doc comment for
// why it must not alias). The string sorts, by contrast, are now
// one-line `sort_by` delegations: a string compare is a call either
// way, so routing it through the generic comparator costs nothing. The
// full enabler chain has landed — modload rewrites module-local
// comparator references from arg positions and lambda bodies of a
// mangled module (#4802), the `call_indirect` signature seam accepts
// two-slot `string` params (#4804), the `__fern_box_free` funcidx
// collision is fixed (#4816), and the wasm closure-target ABI now
// reconciles a function that is BOTH direct-called and used as a
// closure value — a bare comparator like `string_cmp` — by pushing a
// dummy env_ptr at its direct-call sites (#4829). The generic
// comparator form `sort_by[T](arr, cmp)` (below) covers any element
// type / custom ordering.
//
// No prelude: a program now `import "std/sort";` explicitly to
// call `sort_i32_asc(arr)` etc. (docs/PRELUDE-TO-MODULES.md,
// Phase 5).
//
// `string_cmp` / `string_cmp_ci` are the underlying byte-
// lex comparators the string sorts use; exporting them so
// callers that need direct ordering checks (without a full
// sort) don't have to roll their own.

// `sort_i32_asc(arr)` — return `arr`'s elements ascending-sorted.
// Stable bottom-up merge sort, O(n log n). The input is never
// mutated; an already-trivially-sorted input (n < 2) is returned
// as-is (same as `sort_by`), otherwise the result is a fresh array.
// `sort_i32_desc` flips the comparison direction. (For an
// arbitrary element type or ordering, see generic `sort_by`.)
//
// Free function rather than a method: lang's receiver
// syntax only accepts struct, enum, or built-in types —
// not array types. A future PR can add array-method
// dispatch and re-spell these as `arr.sort_asc()`.
//
// Functional shape (returns a new array) matches the rest
// of std/array's conventions (`arr.push` returns a
// new array); the input is not mutated — each merge pass
// materializes `dst` as a FRESH copy of `src` (append loop)
// before overwriting it slot by slot. Do not "optimize" this
// back to `var dst = src;` + copy-on-write: the self-hosted
// compiler has Perceus only on its IR paths, so on the AST paths `.with`
// writes through an alias in place, and an aliased merge
// corrupts (reads see this pass's writes — caught by
// TestSelfHostSortX86_64 / TestSelfHostAuditStdArray in CI).
// Native and the self-host IR path handle the aliased CoW
// shape correctly (generic `sort_by` below still uses it, and
// is green in its own gates), but the monomorphic bodies keep
// the explicit copy so they are correct on every path. Under
// native RC the fresh buffer is rc==1, so the merge's `.with`
// writes stay in-place — same cost as the CoW copy.

// std/sort's case-insensitive string comparison dispatches
// (string) `.to_lower()` — declare std/string so the receiver
// method registers under no-prelude.
import "std/string";

// `sort_key` compares projected keys via `core/cmp`'s `Ord.cmp`, so
// declare it to register the `.cmp()` method under no-prelude. This
// closes an import cycle (core/cmp's `impl Ord for string` already
// calls `sort.string_cmp`), which modload resolves by its load-once
// dedupe — a program importing only `std/sort` still gets the `Ord`
// impls transitively, so `sort_key` needs no extra import at the call
// site.
import "core/cmp";

pub function sort_i32_asc(arr: i32[]): i32[] {
    var n: i32 = arr.len();
    if (n < 2) { return arr; }
    var src: i32[] = arr;
    var width: i32 = 1;
    while (width < n) {
        var dst: i32[] = [];
        var c: i32 = 0;
        while (c < n) { dst = dst.append(src[c]); c = c + 1; }
        var lo: i32 = 0;
        while (lo < n) {
            var mid: i32 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i32 = lo + width + width;
            if (hi > n) { hi = n; }
            var i: i32 = lo;
            var j: i32 = mid;
            var k: i32 = lo;
            while (i < mid && j < hi) {
                if (src[j] < src[i]) {
                    dst = dst.with(k, src[j]);
                    j = j + 1;
                } else {
                    dst = dst.with(k, src[i]);
                    i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) { dst = dst.with(k, src[i]); i = i + 1; k = k + 1; }
            while (j < hi) { dst = dst.with(k, src[j]); j = j + 1; k = k + 1; }
            lo = lo + width + width;
        }
        src = dst;
        width = width + width;
    }
    return src;
}

// i64 / u32 / u64 variants. Same stable bottom-up merge-sort
// shape as sort_i32_asc, monomorphised per element width so
// the compare is the plain scalar `<` / `>` for that type.

pub function sort_i64_asc(arr: i64[]): i64[] {
    var n: i32 = arr.len();
    if (n < 2) { return arr; }
    var src: i64[] = arr;
    var width: i32 = 1;
    while (width < n) {
        var dst: i64[] = [];
        var c: i32 = 0;
        while (c < n) { dst = dst.append(src[c]); c = c + 1; }
        var lo: i32 = 0;
        while (lo < n) {
            var mid: i32 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i32 = lo + width + width;
            if (hi > n) { hi = n; }
            var i: i32 = lo;
            var j: i32 = mid;
            var k: i32 = lo;
            while (i < mid && j < hi) {
                if (src[j] < src[i]) {
                    dst = dst.with(k, src[j]);
                    j = j + 1;
                } else {
                    dst = dst.with(k, src[i]);
                    i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) { dst = dst.with(k, src[i]); i = i + 1; k = k + 1; }
            while (j < hi) { dst = dst.with(k, src[j]); j = j + 1; k = k + 1; }
            lo = lo + width + width;
        }
        src = dst;
        width = width + width;
    }
    return src;
}

pub function sort_i64_desc(arr: i64[]): i64[] {
    var n: i32 = arr.len();
    if (n < 2) { return arr; }
    var src: i64[] = arr;
    var width: i32 = 1;
    while (width < n) {
        var dst: i64[] = [];
        var c: i32 = 0;
        while (c < n) { dst = dst.append(src[c]); c = c + 1; }
        var lo: i32 = 0;
        while (lo < n) {
            var mid: i32 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i32 = lo + width + width;
            if (hi > n) { hi = n; }
            var i: i32 = lo;
            var j: i32 = mid;
            var k: i32 = lo;
            while (i < mid && j < hi) {
                if (src[j] > src[i]) {
                    dst = dst.with(k, src[j]);
                    j = j + 1;
                } else {
                    dst = dst.with(k, src[i]);
                    i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) { dst = dst.with(k, src[i]); i = i + 1; k = k + 1; }
            while (j < hi) { dst = dst.with(k, src[j]); j = j + 1; k = k + 1; }
            lo = lo + width + width;
        }
