}

pub function sort_i32_desc(arr: i32[]): i32[] {
    var n: i32 = arr.len();
    if (n < 2) { return arr; }
    var src: i32[] = arr;
    var width: i32 = 1;
    while (width < n) {
        var dst: i32[] = [];
        var c: i32 = 0;
        while (c < n) { dst = dst.append(src[c]); c = c + 1; }
        var lo: i32 = 0;
        while (lo < n) {
            var mid: i32 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i32 = lo + width + width;
            if (hi > n) { hi = n; }
            var i: i32 = lo;
            var j: i32 = mid;
            var k: i32 = lo;
            while (i < mid && j < hi) {
                if (src[j] > src[i]) {
                    dst = dst.with(k, src[j]);
                    j = j + 1;
                } else {
                    dst = dst.with(k, src[i]);
                    i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) { dst = dst.with(k, src[i]); i = i + 1; k = k + 1; }
            while (j < hi) { dst = dst.with(k, src[j]); j = j + 1; k = k + 1; }
            lo = lo + width + width;
        }
        src = dst;
        width = width + width;
    }
    return src;
}

// `string_cmp(a, b)` — lexicographic byte-order comparator.
// Returns -1 / 0 / 1. Lang's `<` / `>` operators only work
// on numerics; string-array sort needs a dedicated three-way
// comparator. Compares byte-by-byte up to the shorter
// length, then breaks ties on length (shorter < longer).
pub function string_cmp(a: string, b: string): i32 {
    var n: i32 = a.len();
    var m: i32 = b.len();
    var min: i32 = n;
    if (m < n) { min = m; }
    var i: i32 = 0;
    while (i < min) {
        if (a[i] < b[i]) { return 0 - 1; }
        if (a[i] > b[i]) { return 1; }
        i = i + 1;
    }
    if (n < m) { return 0 - 1; }
    if (n > m) { return 1; }
    return 0;
}

// `sort_strings_asc(arr)` / `sort_strings_desc(arr)` —
// lexicographic byte-order sort of a string array. Stable
// bottom-up merge sort over `string_cmp`, O(n log n) — safe
// for large listings as well as the small-list use cases
// (config keys, sorted output for stable tests, alphabetised
// CLI flags).
//
// One-line delegations to the generic `sort_by`: a string compare
// is a call either way, so routing it through the comparator costs
// nothing, and the whole enabler chain (#4802/#4804/#4816/#4829)
// has landed. `desc` passes an inline lambda that flips the
// comparison; `asc` passes the bare `string_cmp` comparator —
// which the wasm closure-target ABI now handles even though
// `string_cmp` is also called directly (env_ptr reconciliation,
// #4829). Regression coverage: `prop_sort_strings` (exhaustive
// property fixture) + `sort_strings_delegation_wasm` (the minimal
// direct-call + delegation shape).
pub function sort_strings_asc(arr: string[]): string[] {
    return sort_by(arr, string_cmp);
}

pub function sort_strings_desc(arr: string[]): string[] {
    return sort_by(arr, function (a: string, b: string): i32 { return string_cmp(b, a); });
}

// `string_cmp_ci(a, b)` — same as string_cmp but ASCII case-
// folded per byte. Useful as the ordering for case-insensitive
// sort.
pub function string_cmp_ci(a: string, b: string): i32 {
    var n: i32 = a.len();
    var m: i32 = b.len();
    var min: i32 = n;
    if (m < n) { min = m; }
    var i: i32 = 0;
    while (i < min) {
        var ca: i32 = a[i].to_lower();
        var cb: i32 = b[i].to_lower();
        if (ca < cb) { return 0 - 1; }
        if (ca > cb) { return 1; }
        i = i + 1;
    }
    if (n < m) { return 0 - 1; }
    if (n > m) { return 1; }
    return 0;
}

// `sort_strings_asc_ci(arr)` — case-insensitive ascending
// sort over `string_cmp_ci`. Useful for user-facing
// alphabetical listings where case shouldn't fragment the
// ordering. Stable (merge sort): strings that compare ci-equal
// ("Apple" / "apple") keep their input order. One-line `sort_by`
// delegation like `sort_strings_asc` (#4829).
pub function sort_strings_asc_ci(arr: string[]): string[] {
    return sort_by(arr, string_cmp_ci);
}

// --- In-place (`own`) sorts ------------------------------------------------
//
// The `sort_*_asc`/`_desc` functions above are non-mutating: the input array
// survives the call unchanged (the merge scratch buffer copies on the first
// `.with`). That fresh result is pure overhead when the caller is finished
// with the input and just wants it sorted.
//
// `sort_i32_inplace_asc`/`_desc` take the array `own` (consuming): the caller
// transfers ownership, so the sort permutes the input buffer directly and hands
// the *same* allocation back — no copy, zero allocation. Because the parameter
// is `own`, the checker's affine + ownership-guard rules (E050/E051) require the
// argument to be an owned value (a fresh literal or another `own` binding), and
// the caller cannot use the array afterwards — exactly the contract that makes
// the in-place mutation sound.
//
// These stay insertion sorts (O(n²) worst case) deliberately: `fip` functions
// must not allocate, and a merge sort needs a scratch buffer. Reach for them
// on small inputs where the zero-allocation property matters; for large inputs
// prefer the O(n log n) non-consuming sorts above.
//
// This dogfoods the `own` consuming-parameter feature in the stdlib: real code
// whose ownership transfer (the returned array IS the input box) is pinned by
// the differential e2e gates.

// `sort_i32_inplace_asc(own arr)` — ascending insertion-sort performed directly
// on the (owned) input buffer; returns that same buffer, now sorted.
pub fip function sort_i32_inplace_asc(own arr: i32[]): i32[] {
    var n: i32 = arr.len();
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = arr[k];
        var j: i32 = k - 1;
        while (j >= 0 && arr[j] > key) {
            arr = arr.with(j + 1, arr[j]);
            j = j - 1;
        }
        arr = arr.with(j + 1, key);
        k = k + 1;
    }
    return arr;
}

// `sort_i32_inplace_desc(own arr)` — as above, descending.
pub fip function sort_i32_inplace_desc(own arr: i32[]): i32[] {
    var n: i32 = arr.len();
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = arr[k];
        var j: i32 = k - 1;
        while (j >= 0 && arr[j] < key) {
            arr = arr.with(j + 1, arr[j]);
            j = j - 1;
        }
        arr = arr.with(j + 1, key);
        k = k + 1;
    }
    return arr;
}

// `sort_by[T](arr, cmp)` — return a fresh copy of `arr` sorted by the
// comparator closure `cmp(a, b)`, which returns < 0 when a should come
// before b, > 0 when after, 0 when equivalent (the std/sort convention,
// and what `core/cmp`'s `Ord.cmp` returns — so `sort_by(xs, Ord.cmp)`
// is the comparator form of `core/cmp`'s `sort[T: Ord]`). Generic over
// ANY element type via the comparator, without an `Ord` bound: sort by a
// projected key, reverse order, or any custom relation.
//
// Stable bottom-up (iterative) merge sort, O(n log n) comparisons — the
// same shape the monomorphic `sort_i32_*` / `sort_strings_*` entry points
// above use, for arbitrary / large inputs (#4387 item 3). Stability:
// on a tie the left run's element is emitted first (the merge only takes
// from the right run when it compares *strictly* less), so equal keys keep
// their input order. It lowers on the self-host IR path (only `while`,
// closure calls, `.with`/`.len()`/index, and i32 arithmetic). The input
// is not mutated: the first `.with` on the aliased scratch buffer
// copies-on-write, leaving `arr` untouched.
pub function sort_by[T](arr: T[], cmp: (T, T) => i32): T[] {
    var n: i32 = arr.len();
    if (n < 2) { return arr; }
    var src: T[] = arr;
    var width: i32 = 1;
    while (width < n) {
        // Merge adjacent runs of `width` from `src` into `dst`. `dst`
        // starts aliased to `src`; the first `.with` copies it, so reads
        // from `src` stay valid while we overwrite `dst` slot by slot.
        var dst: T[] = src;
        var lo: i32 = 0;
        while (lo < n) {
            var mid: i32 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i32 = lo + width + width;
            if (hi > n) { hi = n; }
            var i: i32 = lo;
            var j: i32 = mid;
            var k: i32 = lo;
            while (i < mid && j < hi) {
                if (cmp(src[j], src[i]) < 0) {
                    dst = dst.with(k, src[j]);
                    j = j + 1;
                } else {
                    dst = dst.with(k, src[i]);
                    i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) { dst = dst.with(k, src[i]); i = i + 1; k = k + 1; }
            while (j < hi) { dst = dst.with(k, src[j]); j = j + 1; k = k + 1; }
            lo = lo + width + width;
        }
        src = dst;
        width = width + width;
    }
    return src;
}

// `is_sorted_by[T](arr, cmp)` — true iff `arr` is in non-decreasing order
// under the comparator `cmp` (no adjacent pair where the later sorts
// strictly before the earlier). The verification companion to `sort_by`.
pub function is_sorted_by[T](arr: T[], cmp: (T, T) => i32): boolean {
    var i: i32 = 1;
    var n: i32 = arr.len();
    while (i < n) {
        if (cmp(arr[i], arr[i - 1]) < 0) { return false; }
        i = i + 1;
    }
    return true;
}

// `sort_by_i32_key[T](arr, key)` — return a fresh copy of `arr` sorted
// ascending by the i32 `key(x)` projection. The common "sort records by a
// numeric field" case (`sort_by_i32_key(rows, \r -> r.timestamp)`), without
// spelling a full comparator. Keys are computed ONCE up front into a parallel
// array (a Schwartzian transform — each element's `key` is evaluated a single
// time, not O(n log n) times), then the elements and their keys are merge-
// sorted together in lockstep by the precomputed i32 key. Stable bottom-up
// merge sort, O(n log n) (#4387 item 3); the input is not mutated. (Correct
// on every backend; on the self-host it currently lowers via the AST emitter
// rather than the IR path — a closure-typed param over a generic `T[]` isn't
// yet IR-eligible there.)
pub function sort_by_i32_key[T](arr: T[], key: (T) => i32): T[] {
    var srcv: T[] = arr;
    var srck: i32[] = [];
    for x in srcv { srck = srck.append(key(x)); }
    var n: i32 = srcv.len();
    if (n < 2) { return srcv; }
    var width: i32 = 1;
    while (width < n) {
        var dstv: T[] = srcv;
        var dstk: i32[] = srck;
        var lo: i32 = 0;
        while (lo < n) {
            var mid: i32 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i32 = lo + width + width;
            if (hi > n) { hi = n; }
            var i: i32 = lo;
            var j: i32 = mid;
            var k: i32 = lo;
            while (i < mid && j < hi) {
                if (srck[j] < srck[i]) {
                    dstv = dstv.with(k, srcv[j]); dstk = dstk.with(k, srck[j]); j = j + 1;
                } else {
                    dstv = dstv.with(k, srcv[i]); dstk = dstk.with(k, srck[i]); i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) { dstv = dstv.with(k, srcv[i]); dstk = dstk.with(k, srck[i]); i = i + 1; k = k + 1; }
            while (j < hi) { dstv = dstv.with(k, srcv[j]); dstk = dstk.with(k, srck[j]); j = j + 1; k = k + 1; }
            lo = lo + width + width;
        }
        srcv = dstv;
        srck = dstk;
        width = width + width;
    }
    return srcv;
}

// `sort_key[T, K: cmp.Ord](arr, key)` — return a fresh copy of `arr`
// sorted ascending by the `key(x)` projection, where the key type `K`
// is any `core/cmp.Ord` (scalar, `string`, or a `@derive(Ord)` struct
// / enum). The generic-key generalisation of `sort_by_i32_key`: where
// that one is pinned to an i32 key and a scalar `<`, this dispatches
// the ordering through `k.cmp(k2)`, so you can sort records by a
// `string` name, a `u64` id, or any composite `Ord` key without
// spelling a full comparator. The `K: cmp.Ord` bound monomorphises the
// compare per key type on the self-host IR path — a `string` key
// lowers `.cmp` to the lexicographic byte compare, an `i32` key to the
// scalar three-way — where an unbounded `[K]` would erase and mis-
// order strings. Like `sort_by_i32_key` it is a Schwartzian transform:
// each element's `key` is evaluated ONCE up front into a parallel
// `K[]`, then the elements and their keys merge-sort in lockstep, so a
// costly projection is not recomputed O(n log n) times. Stable bottom-
// up merge sort, O(n log n); the input is not mutated (equal keys keep
// input order — the merge takes from the right run only on a STRICT
// `.cmp(...) < 0`).
pub function sort_key[T, K: cmp.Ord](arr: T[], key: (T) => K): T[] {
    var srcv: T[] = arr;
    var srck: K[] = [];
    for x in srcv { srck = srck.append(key(x)); }
    var n: i32 = srcv.len();
    if (n < 2) { return srcv; }
    var width: i32 = 1;
    while (width < n) {
        var dstv: T[] = srcv;
        var dstk: K[] = srck;
        var lo: i32 = 0;
        while (lo < n) {
            var mid: i32 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i32 = lo + width + width;
            if (hi > n) { hi = n; }
            var i: i32 = lo;
            var j: i32 = mid;
            var k: i32 = lo;
            while (i < mid && j < hi) {
                if (srck[j].cmp(srck[i]) < 0) {
                    dstv = dstv.with(k, srcv[j]); dstk = dstk.with(k, srck[j]); j = j + 1;
                } else {
                    dstv = dstv.with(k, srcv[i]); dstk = dstk.with(k, srck[i]); i = i + 1;
                }
                k = k + 1;
            }
            while (i < mid) { dstv = dstv.with(k, srcv[i]); dstk = dstk.with(k, srck[i]); i = i + 1; k = k + 1; }
            while (j < hi) { dstv = dstv.with(k, srcv[j]); dstk = dstk.with(k, srck[j]); j = j + 1; k = k + 1; }
            lo = lo + width + width;
        }
        srcv = dstv;
        srck = dstk;
        width = width + width;
    }
    return srcv;
}
