// std/sort — free `sort_*` functions for i32[] and string[].
//
// Insertion-sort implementations: O(n²) worst case, but for
// the compiler's small-list use cases (sorted field offsets,
// declaration orders, capacity hints) it's fine. The monomorphic
// `sort_i32_*` / `sort_strings_*` entry points stay as the
// allocation-light common cases; the generic comparator form
// `sort_by[T](arr, cmp)` (below) covers any element type / custom
// ordering now that closure args lower on every backend.
//
// Migrated from the former auto-injected prelude per
// docs/PRELUDE-TO-MODULES.md. The prelude was removed in
// Phase 5, so a program now `import "std/sort";` explicitly
// to call `sort_i32_asc(arr)` etc.
//
// `string_cmp` / `string_cmp_ci` are the underlying byte-
// lex comparators the string sorts use; exporting them so
// callers that need direct ordering checks (without a full
// sort) don't have to roll their own.

// `sort_i32_asc(arr)` — return a fresh ascending-sorted
// copy of `arr`. Insertion-sort: O(n²) worst case, but
// for the compiler's small-list use cases (sorted field
// offsets, declaration orders, capacity hints) it's fine.
// `sort_i32_desc` flips the comparison direction. (For an
// arbitrary element type or ordering, see generic `sort_by`.)
//
// Free function rather than a method: lang's receiver
// syntax only accepts struct, enum, or built-in types —
// not array types. A future PR can add array-method
// dispatch and re-spell these as `arr.sort_asc()`.
//
// Functional shape (returns a new array) matches the rest
// of the prelude's array conventions (`arr.push` returns a
// new array); the input is not mutated.

// std/sort's case-insensitive string comparison dispatches
// (string) `.to_lower()` — declare std/string so the receiver
// method registers under no-prelude.
import "std/string";

pub function sort_i32_asc(arr: i32[]): i32[] {
    var n: i32 = arr.len();
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && out[j] > key) {
            out = out.with(j + 1, out[j]);
            j = j - 1;
        }
        out = out.with(j + 1, key);
        k = k + 1;
    }
    return out;
}

// i64 / u32 / u64 variants. Same insertion-sort shape as
// sort_i32_asc; copies into a fresh buffer + sorts in place
// via the in-bounds index-assign that lang's arrays support
// for every scalar element type.

pub function sort_i64_asc(arr: i64[]): i64[] {
    var n: i32 = arr.len();
    var out: i64[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: i64 = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && out[j] > key) {
            out = out.with(j + 1, out[j]);
            j = j - 1;
        }
        out = out.with(j + 1, key);
        k = k + 1;
    }
    return out;
}

pub function sort_i64_desc(arr: i64[]): i64[] {
    var n: i32 = arr.len();
    var out: i64[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: i64 = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && out[j] < key) {
            out = out.with(j + 1, out[j]);
            j = j - 1;
        }
        out = out.with(j + 1, key);
        k = k + 1;
    }
    return out;
}

