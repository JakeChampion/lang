// The category of `c`.
pub function category(c: i32): i32 {
  let lo = 0;
  let hi = STARTS.len();
  while (lo < hi) {
    let mid = (lo + hi) / 2;
    if (STARTS[mid] <= c) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return if (lo == 0) { 0 } else { CATEGORIES[lo - 1] };
}
