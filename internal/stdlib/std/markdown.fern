// CommonMark 0.31.2 to HTML. The output is the output of cmark for the same
// input and options.
import "std/i32";
import "std/io_buffered";
import "std/markdown/blocks";
import "std/markdown/inlines";
import "std/markdown/utf8";
import "std/markdown/tables";

// The options of cmark. `sourcepos` gives each block the attribute
// `data-sourcepos`. `hardbreaks` makes each soft line break a hard line
// break, and `nobreaks` makes it a space. `smart` gives curly quotes,
// dashes and ellipses. Without `unsafe_html`, raw HTML is a comment, and a
// link to a `javascript:`, `vbscript:`, `file:` or `data:` URL has an empty
// destination. `width` is the width of a line for the renderers that wrap
// text, or 0 for no wrap.
pub struct Options { sourcepos: boolean, hardbreaks: boolean, nobreaks: boolean, smart: boolean, unsafe_html: boolean, tasklist: boolean, strikethrough: boolean, autolink: boolean, tables: boolean, width: i32 }

// The defaults of cmark: no option is set.
pub function options(): Options {
  return Options { sourcepos: false, hardbreaks: false, nobreaks: false, smart: false, unsafe_html: false, tasklist: false, strikethrough: false, autolink: false, tables: false, width: 0 };
}

// The bytes `b` with each sequence that is not UTF-8 replaced by U+FFFD, as
// `cmark --validate-utf8` replaces it. cmark checks each line on its own,
// without its line ending. One U+FFFD replaces a lead byte and the
// continuation bytes after it that are valid, or the bytes that are left
// when the sequence is too long for the line, or the whole sequence of an
// overlong form, a surrogate or a code point above U+10FFFF.
pub function validated(b: u8[]): u8[] {
  let n = b.len();
  let out = buf_new(n + 16);
  let i = 0;
  let from = 0;
  let le = -1;
  while (i < n) {
    let c = b[i] as i32;
    if (c < 0x80) {
      i += 1;
      continue;
    }
    if (le < i) {
      le = i;
      while (le < n && b[le] != 10 as u8 && b[le] != 13 as u8) {
        le += 1;
      }
    }
    let len = utf8.length(b, i, le);
    if (len > 0) {
      i += len;
      continue;
    }
    buf_push_bytes_range(out, b, from, i);
    buf_push(out, "�");
    i -= len;
    from = i;
  }
  buf_push_bytes_range(out, b, from, n);
  let text = buf_take_bytes(out);
  buf_free(out);
  return text;
}

// The options of the inline phase, as the flags of `inlines`.
pub function inline_flags(o: Options): i32 {
  let f = 0;
  if (o.smart) {
    f |= inlines.O_SMART;
  }
  if (o.unsafe_html) {
    f |= inlines.O_UNSAFE;
  }
  if (o.hardbreaks) {
    f |= inlines.O_HARDBREAKS;
  }
  if (o.nobreaks) {
    f |= inlines.O_NOBREAKS;
  }
  return f;
}

// The HTML of the CommonMark document `src`. As in cmark, the bytes of the
// source that are not UTF-8 stay as they are.
pub function to_html(src: u8[], o: Options): u8[] {
  let b = buf_new(src.len() + src.len() / 4 + 64);
  render(b, src, o);
  let out = buf_take_bytes(b);
  buf_free(b);
  return out;
}

// Writes the HTML of the CommonMark document `src` to the byte builder `out`.
pub function render(out: usize, src: u8[], o: Options): void {
  let d = blocks.parse_options(src, o.sourcepos, o.tables);
  let s = start(o);
  for r in 0..d.count() {
    s = step(out, d, r, s);
  }
}

// Writes the HTML of the CommonMark document `src` to `w`. The writer gets
// the HTML of a part of the document each time its buffer holds `part`
// bytes or more.
pub function write(w: io_buffered.BufWriter, src: u8[], part: i32, o: Options): Result[io_buffered.BufWriter, IoError] {
  let d = blocks.parse_options(src, o.sourcepos, o.tables);
  let out = w.handle();
  let s = start(o);
  let q = w;
  for r in 0..d.count() {
    s = step(out, d, r, s);
    if (buf_len(out) >= part) {
      let Ok(next) = q.flush() else {
        return q.flush();
      };
      q = next;
    }
  }
  return Ok(q);
}

// The state of the writer between two records. `w` holds the tables of the
// inline phase. `open` is true when the output does not end with a line
// feed. `tight` has an entry for each open container. The entry is 1 when
// the paragraphs directly in the container have no `<p>` tags, as in an
// item of a tight list.
struct State { w: inlines.Work, open: boolean, tight: i32[], depth: i32, o: Options }

function start(o: Options): State {
  let flags = inline_flags(o);
  if (o.strikethrough) {
    flags |= inlines.O_STRIKETHROUGH;
  }
  if (o.autolink) {
    flags |= inlines.O_AUTOLINK;
  }
  return State { w: inlines.work(flags), open: false, tight: [0], depth: 1, o: o };
}

// Writes the attribute `data-sourcepos` of the record `r` when the option
// `sourcepos` is set, in the start tag `text` of the record `r`. The
// attribute goes before the byte `at` of the tag.
@inline
function tag(out: usize, d: blocks.Doc, r: i32, s: State, text: string, at: i32): void {
  if (!s.o.sourcepos) {
    buf_push(out, text);
    return;
  }
  let (sl, sc, el, ec) = d.span_of(r);
  positioned_tag(out, text, at, sl, sc, el, ec);
}

function positioned_tag(out: usize, text: string, at: i32, sl: i32, sc: i32, el: i32, ec: i32): void {
  buf_push_range(out, text, 0, at);
  buf_push(out, " data-sourcepos=\"" + sl.to_string() + ":" + sc.to_string() + "-" + el.to_string() + ":" + ec.to_string() + "\"");
  buf_push_range(out, text, at, text.len());
}

// Writes the record `r`.
function step(out: usize, d: blocks.Doc, r: i32, s: State): State {
  let k = d.kind(r);
  if (k == blocks.PARAGRAPH) {
    return paragraph(out, d, r, s);
  }
  if (k == blocks.END) {
    return leave(out, d, r, s);
  }
  cr(out, s.open);
  if (k == blocks.HEADING) {
    let digit = 48 + d.value(r);
    buf_push(out, "<h");
    buf_push_byte(out, digit);
    tag(out, d, r, s, ">", 0);
    let w = inlines.render(out, d, d.from(r), d.to(r), s.w);
    buf_push(out, "</h");
    buf_push_byte(out, digit);
    buf_push(out, ">\n");
    return State { ...s, w: w, open: false };
  }
  if (k == blocks.CODE) {
    code(out, d, r, s);
  } else if (k == blocks.HTML && s.o.unsafe_html) {
    lines(out, d, d.from(r), d.to(r));
  } else if (k == blocks.HTML) {
    buf_push(out, inlines.OMITTED);
    buf_push_byte(out, 10);
  } else if (k == blocks.RULE) {
    tag(out, d, r, s, "<hr />\n", 3);
  } else {
    return enter(out, d, r, k, s);
  }
  return State { ...s, open: false };
}

// Writes the start of a container.
function enter(out: usize, d: blocks.Doc, r: i32, k: i32, s: State): State {
  if (k == blocks.QUOTE) {
    tag(out, d, r, s, "<blockquote>\n", 11);
    return push(s, 0, false);
  }
  if (k == blocks.LIST) {
    list_start(out, d, r, s);
    if (d.has_flag(r, blocks.F_TIGHT)) {
      return push(s, 1, false);
    }
    return push(s, 0, false);
  }
  tag(out, d, r, s, "<li>", 3);
  return push(s, s.tight[s.depth - 1], true);
}

function push(s: State, v: i32, open: boolean): State {
  if (s.depth < s.tight.len()) {
    return State { ...s, tight: s.tight.with(s.depth, v), depth: s.depth + 1, open: open };
  }
  return State { ...s, tight: s.tight.append(v), depth: s.depth + 1, open: open };
}

// Starts a new line of output when the output does not end with a line feed.
function cr(out: usize, open: boolean): void {
  if (open) {
    buf_push_byte(out, 10);
  }
}

// Writes the end of a container.
function leave(out: usize, d: blocks.Doc, r: i32, s: State): State {
  let k = d.value(r);
  if (k == blocks.QUOTE) {
    cr(out, s.open);
    buf_push(out, "</blockquote>\n");
  } else if (k == blocks.LIST) {
    if (d.has_flag(r, blocks.F_ORDERED)) {
      buf_push(out, "</ol>\n");
    } else {
      buf_push(out, "</ul>\n");
    }
  } else {
    buf_push(out, "</li>\n");
  }
  return State { ...s, open: false, depth: s.depth - 1 };
}

function list_start(out: usize, d: blocks.Doc, r: i32, s: State): void {
  let start = d.value(r);
  if (!d.has_flag(r, blocks.F_ORDERED)) {
    tag(out, d, r, s, "<ul>\n", 3);
  } else if (start == 1) {
    tag(out, d, r, s, "<ol>\n", 3);
  } else {
    let text = "<ol start=\"" + start.to_string() + "\">\n";
    tag(out, d, r, s, text, text.len() - 2);
  }
}

function task_marker(src: u8[], a: i32, e: i32): boolean {
  return e - a >= 3 && src[a] == 91 as u8 && src[a + 2] == 93 as u8;
}

// A task marker can open the first paragraph of an ordered or unordered item.
function task_prefix(out: usize, d: blocks.Doc, r: i32, o: Options): i32 {
  if (!o.tasklist || r == 0 || d.kind(r - 1) != blocks.ITEM || d.from(r) >= d.to(r)) {
    return 0;
  }
  let seg = d.segs[d.from(r)];
  let a = blocks.seg_start(seg);
  let e = blocks.seg_end(seg);
  if (blocks.seg_pad(seg) != 0 || !task_marker(d.src, a, e)) {
    return 0;
  }
  let mark = d.src[a + 1];
  let end = a + 3;
  while (end < e && (d.src[end] == 32 as u8 || d.src[end] == 9 as u8)) {
    end += 1;
  }
  if (end == a + 3 && end < e) {
    return 0;
  }
  if (mark == 32 as u8 || mark == 9 as u8) {
    buf_push(out, "<input type=\"checkbox\" disabled=\"\" /> ");
  } else if (mark == 120 as u8 || mark == 88 as u8) {
    buf_push(out, "<input type=\"checkbox\" checked=\"\" disabled=\"\" /> ");
  } else {
    return 0;
  }
  return end - a;
}

// A paragraph in an item of a tight list has no `<p>` tags. The text of a
// paragraph does not end with a line feed.
function paragraph(out: usize, d: blocks.Doc, r: i32, s: State): State {
  let from = d.from(r);
  let to = d.to(r);
  if (s.o.tables) {
    for header in from..to - 1 {
      let cols = blocks.table_columns(d.src, d.segs, header);
      if (cols.len() > 0) {
        if (header > from) {
          s = paragraph_lines(out, d, r, s, from, header);
        }
        cr(out, s.open);
        table_tag(out, d, r, s, header, to, cols.len());
        let (w, next) = tables.render(out, d, r, header, to, cols, s.w);
        s = State { ...s, w: w, open: false };
        if (next < to) {
          if (tables.html_block(d, next)) {
            table_html(out, d, next, to, s);
            return s;
          }
          return paragraph_lines(out, d, r, s, next, to);
        }
        return s;
      }
    }
  }
  return paragraph_lines(out, d, r, s, from, to);
}

function table_tag(out: usize, d: blocks.Doc, r: i32, s: State, header: i32, to: i32, width: i32): void {
  if (!s.o.sourcepos) {
    buf_push(out, "<table>\n");
    return;
  }
  let stop = tables.limit(d, header, to, width);
  let (sl, sc, el, ec) = d.span_of(r);
  if (stop < to) {
    let last = blocks.seg_end(d.segs[stop - 1]);
    el -= to - stop;
    ec = last - tables.line_start(d.src, last);
  }
  positioned_tag(out, "<table>\n", 6, sl, sc, el, ec);
}

// Paragraph segments omit leading whitespace. A top-level HTML block
// following a table keeps that whitespace on every line.
function table_html(out: usize, d: blocks.Doc, from: i32, to: i32, s: State): void {
  if (!s.o.unsafe_html) {
    buf_push(out, inlines.OMITTED);
    buf_push_byte(out, 10);
    return;
  }
  if (s.depth > 1) {
    lines(out, d, from, to);
    return;
  }
  for k in from..to {
    let seg = d.segs[k];
    let a = blocks.seg_start(seg);
    while (a > 0 && (d.src[a - 1] == b' ' || d.src[a - 1] == b'\t')) {
      a -= 1;
    }
    buf_push_bytes_range(out, d.src, a, blocks.seg_end(seg));
    buf_push_byte(out, 10);
  }
}

function paragraph_lines(out: usize, d: blocks.Doc, r: i32, s: State, from: i32, to: i32): State {
  if (s.tight[s.depth - 1] == 1) {
    let before = buf_len(out);
    let skip = task_prefix(out, d, r, s.o);
    let w = inlines.render_after(out, d, from, to, s.w, skip);
    return State { ...s, w: w, open: s.open || buf_len(out) > before };
  }
  cr(out, s.open);
  if (s.o.sourcepos && to < d.to(r)) {
    positioned_tag(out, "<p>", 2, 0, 0, 0, 0);
  } else if (s.o.sourcepos && from > d.from(r)) {
    let (_, _, el, ec) = d.span_of(r);
    let a = blocks.seg_start(d.segs[from]);
    positioned_tag(out, "<p>", 2, el - (to - from - 1), a - tables.line_start(d.src, a) + 1, el, ec);
  } else {
    tag(out, d, r, s, "<p>", 2);
  }
  let skip = task_prefix(out, d, r, s.o);
  let w = inlines.render_after(out, d, from, to, s.w, skip);
  buf_push(out, "</p>\n");
  return State { ...s, w: w, open: false };
}

// The lines `from` to `to`, each with a line feed after it.
function lines(out: usize, d: blocks.Doc, from: i32, to: i32): void {
  for k in from..to {
    let s = d.segs[k];
    for _ in 0..blocks.seg_pad(s) {
      buf_push_byte(out, 32);
    }
    buf_push_bytes_range(out, d.src, blocks.seg_start(s), blocks.seg_end(s));
    buf_push_byte(out, 10);
  }
}

function code(out: usize, d: blocks.Doc, r: i32, st: State): void {
  let t = st.w.t;
  let from = d.from(r);
  let to = d.to(r);
  let lang: u8[] = [];
  if (d.has_flag(r, blocks.F_FENCED)) {
    lang = info_word(d, from, t);
    from += 1;
  }
  if (lang.len() > 0) {
    tag(out, d, r, st, "<pre><code class=\"", 4);
    if (lang.len() < 9 || __mismatch_bytes_str(lang, 0, "language-", 0, 9) < 9) {
      buf_push(out, "language-");
    }
    inlines.escape(out, lang, 0, lang.len(), t);
    buf_push(out, "\">");
  } else {
    tag(out, d, r, st, "<pre><code>", 4);
  }
  for k in from..to {
    let s = d.segs[k];
    for _ in 0..blocks.seg_pad(s) {
      buf_push_byte(out, 32);
    }
    inlines.escape(out, d.src, blocks.seg_start(s), blocks.seg_end(s), t);
    buf_push_byte(out, 10);
  }
  buf_push(out, "</code></pre>\n");
}

// The first word of the info string of a fenced code block, which is on the
// line `k`.
function info_word(d: blocks.Doc, k: i32, t: inlines.Tables): u8[] {
  let info = info_string(d, k, t);
  let e = 0;
  while (e < info.len() && !is_space(info[e] as i32)) {
    e += 1;
  }
  return __bytes_range(info, 0, e);
}

// The info string of a fenced code block, which is on the line `k`. As in
// cmark, the entity references go before the whitespace at each end, and
// the backslash escapes after it.
@inline
pub function info_string(d: blocks.Doc, k: i32, t: inlines.Tables): u8[] {
  let raw = inlines.decode(d.src, blocks.seg_start(d.segs[k]), blocks.seg_end(d.segs[k]), t);
  let a = 0;
  let b = raw.len();
  while (a < b && is_space(raw[a] as i32)) {
    a += 1;
  }
  while (b > a && is_space(raw[b - 1] as i32)) {
    b -= 1;
  }
  return inlines.unescape(raw[a:b]);
}

function is_space(c: i32): boolean {
  return c == 32 || c >= 9 && c <= 13;
}
