// std/tz — the local time zone as glibc's tzset finds it: a TZif file
// (RFC 8536) or a POSIX TZ rule, answering the UTC offset and the
// abbreviation in force at an instant. `std/time` models a zone as a
// fixed offset; this is the function from instant to that offset, and
// `at` is the bridge between the two.
//
// `who` and `pinky` both render a login time as local wall-clock, which
// is localtime(3), which is tzset(3) plus a lookup. tzset has two
// sources and this module is both:
//
//   1. The TZ environment variable. An empty value is UTC. Otherwise a
//      leading `:` is dropped and what is left is tried as a FILE first
//      — absolute as it stands, relative under $TZDIR (default
//      /usr/share/zoneinfo) — and only if no file is there is it parsed
//      as a POSIX rule string. That order is why `TZ=EST5EDT` reads the
//      zoneinfo file of that name rather than the rule it also spells,
//      and the two differ before 2007, where the file has the old US
//      dates and the rule does not.
//   2. TZ unset: /etc/localtime, the same file format.
//
// Anything that fails to parse is UTC, which is what a C program gets
// when tzset finds nothing it understands.
//
// That is glibc. Darwin's tzset is tzcode's, and `zone_from_tz` follows
// it there; the section at the end of this file says where it differs.
//
// `iana_zone` is the one way in that reads no host file: it looks a name
// up in the IANA table generated into the end of this file.
//
// Where this parts from glibc, and why (docs/COREUTILS.md): a TZ string
// that names a daylight zone but no usable pair of dates — `ABC1DEF`,
// or `EST5EDT,J0,J300` where the dates are out of range — leaves the
// dates to the implementation. glibc reads them from
// /usr/share/zoneinfo/posixrules, a copy of America/New_York that
// upstream tzdata stopped shipping in 2020 and Debian still carries;
// this applies the POSIX default dates, which is what glibc itself
// falls back to where that file is absent.
//
// The file is TZif (RFC 8536): a header, a table of transition times
// with the offset in effect after each, and — from version 2 on — the
// whole table again with 64-bit times, then a POSIX rule string in a
// footer that governs every time past the last transition. A zone file
// ends its table around 2037, so the footer is what answers a question
// about 2040 and it is not an edge case.
//
// What is read off it is the UTC offset and the ABBREVIATION (`EST`,
// `+0545`) in force at an instant — `pr -D %Z` and `date` both print
// the latter. The leap-second table and the standard/UT indicators are
// parsed past.
import "std/string";
import "std/array";
import "std/time";
import "std/utf8";

// ---- the zone ---------------------------------------------------------------
// `Zone` — a transition table plus the rule that takes over past its
// end. `first` / `first_abbr` / `first_dst` are what stands before the
// first transition; `times`, `offs`, `abbrs` and `dsts` are the same
// length, entry `i` being in effect from `times[i]` until
// `times[i + 1]`.
pub struct Zone { times: i64[], offs: i32[], abbrs: string[], dsts: boolean[], first: i32, first_abbr: string, first_dst: boolean, rule: Rule }

// `Rule` — a POSIX TZ string: the standard offset, and when DST is
// observed, the DST offset and the two dates that switch between them.
// Offsets are SECONDS EAST of Greenwich, the sign localtime adds — the
// opposite of the sign the TZ string writes, where `EST5` means five
// hours WEST.
pub struct Rule { valid: boolean, has_dst: boolean, std_off: i32, dst_off: i32, std_name: string, dst_name: string, start: DateRule, end: DateRule }

// `DateRule` — one of POSIX's three ways to name a day of the year,
// plus the local time of day the change happens at:
//
//   kind 0  `Mm.w.d`  the `d`th weekday of week `w` of month `m`,
//                     with week 5 meaning the last such weekday
//   kind 1  `Jn`      day n of the year counting from 1 with February
//                     29 never counted, so a date keeps its number in
//                     a leap year
//   kind 2  `n`       day n counting from 0 WITH February 29 counted
pub struct DateRule { kind: i32, mon: i32, week: i32, day: i32, n: i32, time: i32 }

pub function utc_rule(): Rule {
  let none: DateRule = DateRule { kind: 2, mon: 0, week: 0, day: 0, n: 0, time: 0 };
  return Rule { valid: false, has_dst: false, std_off: 0, dst_off: 0, std_name: "", dst_name: "", start: none, end: none };
}

// `fixed_zone(off, name)` — a zone with no transitions and no rule, so
// every instant is the same offset under the same name.
pub function fixed_zone(off: i32, name: string): Zone {
  let t: i64[] = [];
  let o: i32[] = [];
  let a: string[] = [];
  let d: boolean[] = [];
  return Zone { times: t, offs: o, abbrs: a, dsts: d, first: off, first_abbr: name, first_dst: false, rule: utc_rule() };
}

pub function utc_zone(): Zone {
  return fixed_zone(0, "UTC");
}

// `local_zone()` — tzset's answer for this process.
pub function local_zone(): Zone {
  match (env("TZ")) {
    Some(spec) => {
      return zone_from_tz(spec);
    },
    None => {
      return default_zone();
    }
  }
}

// `zone_from_tz(spec)` — the zone a TZ value names, by tzset's rules:
// a file first, then a POSIX rule.
pub function zone_from_tz(spec: string): Zone {
  if (target_os() == "darwin") {
    return darwin_zone_from_tz(spec);
  }
  // glibc substitutes the NAME `Universal` for an empty TZ and then
  // runs it through the same two steps, which is why `TZ=` prints
  // that word as its abbreviation on a machine carrying no
  // zoneinfo file of that name.
  let name: string = spec;
  if (name.len() == 0) {
    name = "Universal";
  }
  if (name[0] as i32 == 58) {
    name = slice_unchecked(name, 1, name.len()) + "";
  }
  // `TZ=:` is the colon and nothing else, which names no file and
  // leaves glibc on the default one.
  if (name.len() == 0) {
    return default_zone();
  }
  match (read_zone_file(zone_path(name))) {
    Some(z) => {
      return z;
    },
    None => {}
  }
  let r: Rule = parse_posix(name);
  if (!r.valid) {
    // A TZ that is neither a file nor a rule leaves tzset with the
    // UTC offset and NO abbreviation, which is what a fresh
    // process then prints for it.
    return fixed_zone(0, "");
  }
  return rule_zone(r);
}

// The zone a process with no usable TZ gets: /etc/localtime, and UTC
// where even that is not there.
function default_zone(): Zone {
  match (read_zone_file("/etc/localtime")) {
    Some(z) => {
      return z;
    },
    None => {
      return utc_zone();
    }
  }
}

// A zone that is nothing but a rule: no transitions, so every time is
// answered by the rule.
function rule_zone(r: Rule): Zone {
  let t: i64[] = [];
  let o: i32[] = [];
  let a: string[] = [];
  let d: boolean[] = [];
  return Zone { times: t, offs: o, abbrs: a, dsts: d, first: r.std_off, first_abbr: r.std_name, first_dst: false, rule: r };
}

// Where a TZ value names a file. An absolute name is itself; a relative
// one hangs under $TZDIR, which glibc reads and defaults to the compiled
// -in zoneinfo directory.
function zone_path(name: string): string {
  if (name.len() == 0) {
    return "";
  }
  if (name[0] as i32 == 47) {
    return name;
  }
  let dir: string = "/usr/share/zoneinfo";
  match (env("TZDIR")) {
    Some(d) => {
      if (d.len() > 0) {
        dir = d;
      }
    },
    None => {}
  }
  return dir + "/" + name;
}

// `(z: Zone) offset_at(sec)` — seconds east of Greenwich at that
// instant. Before the first transition the zone's opening offset
// stands; past the last one the footer rule does, when there is one.
pub function (z: Zone) offset_at(sec: i64): i32 {
  let i: i32 = z.index_at(sec);
  if (i == 0 - 1) {
    return z.first;
  }
  if (i == 0 - 2) {
    if (rule_dst(z.rule, sec)) {
      return z.rule.dst_off;
    }
    return z.rule.std_off;
  }
  return z.offs[i];
}

// `(z: Zone) is_dst_at(sec)` — localtime's tm_isdst at that instant:
// the table entry's own flag, or which side of the footer rule it
// falls on.
pub function (z: Zone) is_dst_at(sec: i64): boolean {
  let i: i32 = z.index_at(sec);
  if (i == 0 - 1) {
    return z.first_dst;
  }
  if (i == 0 - 2) {
    return rule_dst(z.rule, sec);
  }
  return z.dsts[i];
}

// `(z: Zone) is_fixed()` — one offset for all time: no transition and
// no daylight rule.
pub function (z: Zone) is_fixed(): boolean {
  return z.times.len() == 0 && !(z.rule.valid && z.rule.has_dst);
}

// `Entry` — everything a zone says about one instant: the offset, the
// designation and the DST flag, from one lookup.
pub struct Entry { off: i32, abbrev: string, dst: boolean }

// `(z: Zone) entry_at(sec)` — the offset, designation and DST flag at
// that instant, from a single search of the table.
pub function (z: Zone) entry_at(sec: i64): Entry {
  let i: i32 = z.index_at(sec);
  if (i == 0 - 1) {
    return Entry { off: z.first, abbrev: z.first_abbr, dst: z.first_dst };
  }
  if (i == 0 - 2) {
    if (rule_dst(z.rule, sec)) {
      return Entry { off: z.rule.dst_off, abbrev: z.rule.dst_name, dst: true };
    }
    return Entry { off: z.rule.std_off, abbrev: z.rule.std_name, dst: false };
  }
  return Entry { off: z.offs[i], abbrev: z.abbrs[i], dst: z.dsts[i] };
}

// `(z: Zone) abbrev_at(sec)` — the zone designation in force at that
// instant: the table's own string, or the name the footer rule gives
// the side of the year `sec` falls on.
// `at(sec)` — the fixed offset in force at `sec` as the `TimeZone` every
// `std/time` operation takes, named by the abbreviation in force then. A
// zone is a function from instant to offset; this is one evaluation of it.
pub function (z: Zone) at(sec: i64): TimeZone {
  let e: Entry = z.entry_at(sec);
  return TimeZone { name: e.abbrev, offset_seconds: e.off };
}

pub function (z: Zone) abbrev_at(sec: i64): string {
  let i: i32 = z.index_at(sec);
  if (i == 0 - 1) {
    return z.first_abbr;
  }
  if (i == 0 - 2) {
    if (rule_dst(z.rule, sec)) {
      return z.rule.dst_name;
    }
    return z.rule.std_name;
  }
  return z.abbrs[i];
}

// Which entry of the table answers `sec`: its index, `-1` for the state
// before the first transition, or `-2` when the footer rule has taken
// over past the last one.
function (z: Zone) index_at(sec: i64): i32 {
  let n: i32 = z.times.len();
  if (n == 0) {
    if (z.rule.valid) {
      return 0 - 2;
    }
    return 0 - 1;
  }
  if (sec < z.times[0]) {
    return 0 - 1;
  }
  if (z.rule.valid && sec >= z.times[n - 1]) {
    return 0 - 2;
  }
  let lo: i32 = 0;
  let hi: i32 = n - 1;
  while (lo < hi) {
    let mid: i32 = lo + (hi - lo + 1) / 2;
    if (z.times[mid] <= sec) {
      lo = mid;
    } else {
      hi = mid - 1;
    }
  }
  return lo;
}

// ---- the embedded IANA table ------------------------------------------------
// `iana_zone(name)`: the zone an IANA name (`Europe/London`, `Etc/GMT+5`,
// an alias such as `US/Pacific`) denotes in the tzdata release compiled
// into this module, `iana_version()`. No file is read, so it answers the
// same on every target, wasm included. None for a name the release does
// not have.
//
// The table starts at 1970: an instant before the epoch reads the offset
// in force at the epoch, not its historical one. Past a zone's last
// transition its POSIX rule governs, so a far-future date follows the
// zone's current daylight-saving rules.
//
// This is not tzset: `local_zone` and `zone_from_tz` still read the
// host's zoneinfo, as a C program's localtime does.
pub function iana_zone(name: string): Option[Zone] {
  if (name.len() == 0 || has_table_separator(name)) {
    return None;
  }
  let names: string = iana_names();
  let at: i32 = names.index_of(";" + name + "=");
  if (at < 0) {
    return None;
  }
  let off: (i32, i32) = table_uint(names, at + name.len() + 2);
  return Some(decode_record(iana_records(), off.0));
}

// A name holding `;` or `=` could match across two entries of the index.
function has_table_separator(name: string): boolean {
  let i: i32 = 0;
  while (i < name.len()) {
    let c: i32 = name[i] as i32;
    if (c == 59 || c == 61) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// The record at `at`: `footer|types|transitions;`, laid out as
// internal/tables/tzdata documents.
function decode_record(s: string, at: i32): Zone {
  let p: i32 = at;
  while (s[p] as i32 != 124) {
    p = p + 1;
  }
  let rule: Rule = parse_posix(slice_unchecked(s, at, p) + "");
  let ty: TypeTable = decode_types(s, p + 1);
  let times: i64[] = [];
  let offs: i32[] = [];
  let abbrs: string[] = [];
  let dsts: boolean[] = [];
  let t: i64 = 0;
  p = ty.next;
  while (s[p] as i32 != 59) {
    let v: (i64, i32) = table_varint(s, p);
    if (v.0 % (2 as i64) == 0 as i64) {
      t = t + v.0 / (2 as i64) * (60 as i64);
    } else {
      t = t + v.0 / (2 as i64);
    }
    let k: i32 = table_digit(s[v.1] as i32);
    times = times.append(t);
    offs = offs.append(ty.offs[k]);
    abbrs = abbrs.append(ty.abbrs[k]);
    dsts = dsts.append(ty.dsts[k]);
    p = v.1 + 1;
  }
  return Zone { times: times, offs: offs, abbrs: abbrs, dsts: dsts, first: ty.offs[0], first_abbr: ty.abbrs[0], first_dst: ty.dsts[0], rule: rule };
}

// A record's local time types; the first is in force from the epoch to
// the first transition. `next` is where the transitions start.
struct TypeTable { offs: i32[], abbrs: string[], dsts: boolean[], next: i32 }

// `abbr:off:dst` entries separated by `,`, ended by `|`.
function decode_types(s: string, from: i32): TypeTable {
  let offs: i32[] = [];
  let abbrs: string[] = [];
  let dsts: boolean[] = [];
  let p: i32 = from;
  while (s[p] as i32 != 124) {
    let a: i32 = p;
    while (s[p] as i32 != 58) {
      p = p + 1;
    }
    abbrs = abbrs.append(slice_unchecked(s, a, p) + "");
    let neg: boolean = s[p + 1] as i32 == 45;
    if (neg) {
      p = p + 1;
    }
    let v: (i32, i32) = table_uint(s, p + 1);
    if (neg) {
      offs = offs.append(0 - v.0);
    } else {
      offs = offs.append(v.0);
    }
    dsts = dsts.append(s[v.1 + 1] as i32 == 49);
    p = v.1 + 2;
    if (s[p] as i32 == 44) {
      p = p + 1;
    }
  }
  return TypeTable { offs: offs, abbrs: abbrs, dsts: dsts, next: p + 1 };
}

// The decimal digits at `p`, as (value, next).
function table_uint(s: string, p: i32): (i32, i32) {
  let i: i32 = p;
  let v: i32 = 0;
  while (is_digit(s[i] as i32)) {
    v = v * 10 + (s[i] as i32 - 48);
    i = i + 1;
  }
  return (v, i);
}

// The varint at `p`: five bits per digit, least significant first, 32
// added to every digit but the last. Answers (value, next).
function table_varint(s: string, p: i32): (i64, i32) {
  let v: i64 = 0;
  let shift: i64 = 1;
  let i: i32 = p;
  let d: i32 = 32;
  while (d >= 32) {
    d = table_digit(s[i] as i32);
    v = v + (d % 32) as i64 * shift;
    shift = shift * (32 as i64);
    i = i + 1;
  }
  return (v, i);
}

// One digit of `0-9A-Za-z+-`.
function table_digit(c: i32): i32 {
  if (c <= 57) {
    if (c == 43) {
      return 62;
    }
    if (c == 45) {
      return 63;
    }
    return c - 48;
  }
  if (c <= 90) {
    return c - 55;
  }
  return c - 61;
}

// ---- TZif -------------------------------------------------------------------
function be32(bs: u8[], o: i32): i64 {
  let v: i64 = 0;
  let i: i32 = 0;
  while (i < 4) {
    v = v * (256 as i64) + bs[o + i] as i64;
    i = i + 1;
  }
  return v;
}

function be32s(bs: u8[], o: i32): i64 {
  let v: i64 = be32(bs, o);
  if (v > 2147483647 as i64) {
    return v - 4294967296 as i64;
  }
  return v;
}

function be64s(bs: u8[], o: i32): i64 {
  let v: i64 = 0;
  let i: i32 = 0;
  while (i < 8) {
    v = v * (256 as i64) + bs[o + i] as i64;
    i = i + 1;
  }
  return v;
}

// The six counts of a TZif header, in file order. `-1` in any of them
// says the header is not there at all.
struct Counts { isut: i32, isstd: i32, leap: i32, time: i32, type_: i32, chars: i32 }

function read_counts(bs: u8[], off: i32): Counts {
  let bad: Counts = Counts { isut: 0 - 1, isstd: 0, leap: 0, time: 0, type_: 0, chars: 0 };
  if (off < 0 || off + 44 > bs.len()) {
    return bad;
  }
  if (bs[off] as i32 != 84 || bs[off + 1] as i32 != 90 || bs[off + 2] as i32 != 105 || bs[off + 3] as i32 != 102) {
    return bad;
  }
  // A count with its high bit set is not a count. Reading them through
  // i64 and refusing the negatives keeps the arithmetic below in range
  // rather than wrapping into an offset that passes a length check.
  let c: Counts = Counts { isut: clamp(be32(bs, off + 20)), isstd: clamp(be32(bs, off + 24)), leap: clamp(be32(bs, off + 28)), time: clamp(be32(bs, off + 32)), type_: clamp(be32(bs, off + 36)), chars: clamp(be32(bs, off + 40)) };
  if (c.isut < 0 || c.isstd < 0 || c.leap < 0 || c.time < 0 || c.type_ < 0 || c.chars < 0) {
    return bad;
  }
  return c;
}

// A header count, or -1 for one no file can mean.
function clamp(v: i64): i32 {
  if (v > 1073741823 as i64) {
    return 0 - 1;
  }
  return v as i32;
}

// The byte length of a data block whose transition times are `width`
// bytes and whose leap records are `width + 4`. Counted in 64 bits: a
// file whose header claims a billion transitions would overflow the
// length this is checked against, and the check is what keeps every
// read below inside the buffer.
function block_bytes(c: Counts, width: i32): i64 {
  return c.time as i64 * (width as i64) + c.time as i64 + c.type_ as i64 * (6 as i64) + c.chars as i64 + c.leap as i64 * ((width + 4) as i64) + c.isstd as i64 + c.isut as i64;
}

// `read_zone_file(path)` — the file at `path` as a Zone, or None when it
// is missing, unreadable or not TZif.
function read_zone_file(path: string): Option[Zone] {
  if (path.len() == 0) {
    return None;
  }
  match (read_file_bytes(path)) {
    Ok(bs) => {
      return parse_tzif(bs);
    },
    Err(_) => {
      return None;
    }
  }
}

// Binary TZif data is accepted only when every returned designation and
// the POSIX footer are valid UTF-8. Invalid text makes the file unusable.
pub function parse_tzif(bs: u8[]): Option[Zone] {
  let h1: Counts = read_counts(bs, 0);
  if (h1.isut < 0 || h1.type_ < 1) {
    return None;
  }
  let version: i32 = bs[4] as i32;
  let off: i32 = 44;
  let width: i32 = 4;
  let c: Counts = h1;
  let footer: string = "";
  if (version != 0) {
    // Version 2 and up repeat everything with 64-bit times; the second
    // block is the authoritative one and the footer follows it.
    let first_block: i64 = off as i64 + block_bytes(h1, 4);
    if (first_block <= bs.len() as i64) {
      let second: i32 = first_block as i32;
      let h2: Counts = read_counts(bs, second);
      if (h2.isut >= 0 && h2.type_ >= 1) {
        c = h2;
        off = second + 44;
        width = 8;
        let end: i64 = off as i64 + block_bytes(h2, 8);
        if (end <= bs.len() as i64) {
          match (read_footer(bs, end as i32)) {
            Some(text) => {
              footer = text;
            },
            None => {
              return None;
            }
          }
        }
      }
    }
  }
  if (off as i64 + block_bytes(c, width) > bs.len() as i64) {
    return None;
  }
  return read_zone_block(bs, c, off, width, footer);
}

// The caller has checked the complete block's bounds and selected the
// authoritative table width. Decode its types and transitions together.
function read_zone_block(bs: u8[], c: Counts, off: i32, width: i32, footer: string): Option[Zone] {
  // The transition times, then the index into the type table that each
  // one selects, then the types themselves.
  let idx_off: i32 = off + c.time * width;
  let type_off: i32 = idx_off + c.time;
  let chars_off: i32 = type_off + c.type_ * 6;
  let offs: i32[] = [];
  let isdst: boolean[] = [];
  let names: string[] = [];
  let i: i32 = 0;
  while (i < c.type_) {
    offs = offs.append(be32s(bs, type_off + i * 6) as i32);
    isdst = isdst.append(bs[type_off + i * 6 + 4] as i32 != 0);
    match (designation(bs, chars_off, c.chars, bs[type_off + i * 6 + 5] as i32)) {
      Some(name) => {
        names = names.append(name);
      },
      None => {
        return None;
      }
    }
    i = i + 1;
  }
  let times: i64[] = [];
  let tofs: i32[] = [];
  let tabb: string[] = [];
  let tdst: boolean[] = [];
  i = 0;
  while (i < c.time) {
    let t: i64 = 0;
    if (width == 8) {
      t = be64s(bs, off + i * 8);
    } else {
      t = be32s(bs, off + i * 4);
    }
    let k: i32 = bs[idx_off + i] as i32;
    if (k >= c.type_) {
      k = 0;
    }
    times = times.append(t);
    tofs = tofs.append(offs[k]);
    tabb = tabb.append(names[k]);
    tdst = tdst.append(isdst[k]);
    i = i + 1;
  }
  // Before the first transition, localtime uses the first type that is
  // not daylight saving, and type 0 when every type is.
  let first: i32 = offs[0];
  let first_name: string = names[0];
  i = 0;
  while (i < c.type_) {
    if (!isdst[i]) {
      first = offs[i];
      first_name = names[i];
      i = c.type_;
    } else {
      i = i + 1;
    }
  }
  return Some(Zone { times: times, offs: tofs, abbrs: tabb, dsts: tdst, first: first, first_abbr: first_name, first_dst: false, rule: parse_posix(footer) });
}

// One entry of the designation table: the NUL-terminated string at
// `at` bytes into the block of `len` that starts at `base`.
function designation(bs: u8[], base: i32, len: i32, at: i32): Option[string] {
  if (at < 0 || at >= len) {
    return Some("");
  }
  let out: u8[] = [];
  let i: i32 = base + at;
  let end: i32 = base + len;
  while (i < end && i < bs.len() && bs[i] as i32 != 0) {
    out = out.append(bs[i]);
    i = i + 1;
  }
  return utf8.from_bytes(out);
}

// The footer of a version-2 file: a newline, the rule, a newline. An
// empty rule (the two newlines with nothing between) means the file
// says nothing about times past its table.
function read_footer(bs: u8[], start: i32): Option[string] {
  if (start >= bs.len() || bs[start] as i32 != 10) {
    return Some("");
  }
  let i: i32 = start + 1;
  let out: u8[] = [];
  while (i < bs.len() && bs[i] as i32 != 10) {
    out = out.append(bs[i]);
    i = i + 1;
  }
  return utf8.from_bytes(out);
}

// ---- the POSIX TZ string ----------------------------------------------------
// `parse_posix(s)` — `std offset[dst[offset][,start[/time],end[/time]]]`.
// An unparsable string is `valid: false`, which every caller reads as
// UTC.
//
// The two defaults are the ones that bite: a DST name with no offset of
// its own means one hour ahead of standard time, and DST with no rules
// at all means the United States dates, which is what glibc supplies.
pub function parse_posix(s: string): Rule {
  let r: Rule = utc_rule();
  let std_name: (string, i32) = take_name(s, 0);
  if (std_name.1 <= 0) {
    return r;
  }
  let p: i32 = std_name.1;
  // The offset POSIX demands is optional to glibc, which reads a bare
  // name as that name at UTC — `TZ=Universal`, and `TZ=` with it.
  let std: (boolean, i32, i32) = parse_offset(s, p);
  let std_off: i32 = 0;
  if (std.0) {
    // A TZ string writes the offset to ADD to local time to get UT, so
    // `EST5` is five hours west and localtime subtracts five.
    std_off = 0 - std.1;
    p = std.2;
  }
  r = Rule { ...r, valid: true, std_off: std_off, dst_off: std_off, std_name: std_name.0, dst_name: std_name.0 };
  let dst_name: (string, i32) = take_name(s, p);
  if (dst_name.1 <= p) {
    return r;
  }
  r = Rule { ...r, has_dst: true, dst_off: r.std_off + 3600, dst_name: dst_name.0 };
  p = dst_name.1;
  if (p < s.len() && s[p] as i32 != 44) {
    let d: (boolean, i32, i32) = parse_offset(s, p);
    if (!d.0) {
      return Rule { ...r, valid: false };
    }
    r = Rule { ...r, dst_off: 0 - d.1 };
    p = d.2;
  }
  // A rule that does not parse is not fatal: the offsets stand and the
  // dates fall back to the default, which is what a TZ string naming a
  // daylight zone and no dates at all gets.
  let fallback: Rule = Rule { ...r, start: us_dst_start(), end: us_dst_end() };
  if (p >= s.len() || s[p] as i32 != 44) {
    return fallback;
  }
  let a: (boolean, DateRule, i32) = parse_date_rule(s, p + 1);
  if (!a.0 || a.2 >= s.len() || s[a.2] as i32 != 44) {
    return fallback;
  }
  let b: (boolean, DateRule, i32) = parse_date_rule(s, a.2 + 1);
  if (!b.0) {
    return fallback;
  }
  return Rule { ...r, start: a.1, end: b.1 };
}

// The POSIX default dates, which are the United States rule in force
// since 2007: the second Sunday in March and the first in November,
// both at 02:00 local.
function us_dst_start(): DateRule {
  return DateRule { kind: 0, mon: 3, week: 2, day: 0, n: 0, time: 7200 };
}

function us_dst_end(): DateRule {
  return DateRule { kind: 0, mon: 11, week: 1, day: 0, n: 0, time: 7200 };
}

// The zone designation at `p`: three or more letters, or three or more
// of anything but `>` inside angle brackets. Answers the name and the
// offset past it, or `p` itself when there is no name there — which is
// how a two-character quoted name refuses the whole string.
function take_name(s: string, p: i32): (string, i32) {
  if (p >= s.len()) {
    return ("", p);
  }
  if (s[p] as i32 == 60) {
    let i: i32 = p + 1;
    while (i < s.len() && s[i] as i32 != 62) {
      i = i + 1;
    }
    if (i >= s.len() || i - p - 1 < 3) {
      return ("", p);
    }
    return (slice_unchecked(s, p + 1, i) + "", i + 1);
  }
  let j: i32 = p;
  while (j < s.len() && is_alpha(s[j] as i32)) {
    j = j + 1;
  }
  if (j - p < 3) {
    return ("", p);
  }
  return (slice_unchecked(s, p, j) + "", j);
}

function is_alpha(c: i32): boolean {
  return c >= 65 && c <= 90 || c >= 97 && c <= 122;
}

function is_digit(c: i32): boolean {
  return c >= 48 && c <= 57;
}

// `[+-]hh[:mm[:ss]]` at `p`, as (ok, seconds, next). Every field is
// CLAMPED rather than refused when it is out of range, which is what
// glibc does: `TZ=AAA+25` is a 24-hour offset and `AAA+25:59:59` is
// 24:59:59, neither of them the 25 hours written.
function parse_offset(s: string, p: i32): (boolean, i32, i32) {
  let i: i32 = p;
  let neg: boolean = false;
  if (i < s.len() && (s[i] as i32 == 43 || s[i] as i32 == 45)) {
    neg = s[i] as i32 == 45;
    i = i + 1;
  }
  if (i >= s.len() || !is_digit(s[i] as i32)) {
    return (false, 0, p);
  }
  let h: i32 = 0;
  let n: i32 = 0;
  while (i < s.len() && is_digit(s[i] as i32) && n < 3) {
    h = h * 10 + (s[i] as i32 - 48);
    i = i + 1;
    n = n + 1;
  }
  if (h > 24) {
    h = 24;
  }
  let total: i32 = h * 3600;
  let k: i32 = 0;
  while (k < 2 && i < s.len() && s[i] as i32 == 58) {
    i = i + 1;
    let v: i32 = 0;
    let d: i32 = 0;
    while (i < s.len() && is_digit(s[i] as i32) && d < 2) {
      v = v * 10 + (s[i] as i32 - 48);
      i = i + 1;
      d = d + 1;
    }
    if (d == 0) {
      return (false, 0, p);
    }
    if (v > 59) {
      v = 59;
    }
    if (k == 0) {
      total = total + v * 60;
    } else {
      total = total + v;
    }
    k = k + 1;
  }
  if (neg) {
    total = 0 - total;
  }
  return (true, total, i);
}

// `Mm.w.d`, `Jn` or `n`, each with an optional `/time` whose default is
// 02:00:00 local.
function parse_date_rule(s: string, p: i32): (boolean, DateRule, i32) {
  let bad: DateRule = DateRule { kind: 2, mon: 0, week: 0, day: 0, n: 0, time: 0 };
  let i: i32 = p;
  let out: DateRule = bad;
  if (i < s.len() && s[i] as i32 == 77) {
    let m: (boolean, i32, i32) = parse_uint(s, i + 1);
    if (!m.0 || m.2 >= s.len() || s[m.2] as i32 != 46) {
      return (false, bad, p);
    }
    let w: (boolean, i32, i32) = parse_uint(s, m.2 + 1);
    if (!w.0 || w.2 >= s.len() || s[w.2] as i32 != 46) {
      return (false, bad, p);
    }
    let d: (boolean, i32, i32) = parse_uint(s, w.2 + 1);
    if (!d.0) {
      return (false, bad, p);
    }
    if (m.1 < 1 || m.1 > 12 || w.1 < 1 || w.1 > 5 || d.1 > 6) {
      return (false, bad, p);
    }
    out = DateRule { kind: 0, mon: m.1, week: w.1, day: d.1, n: 0, time: 7200 };
    i = d.2;
  } else if (i < s.len() && s[i] as i32 == 74) {
    let j: (boolean, i32, i32) = parse_uint(s, i + 1);
    if (!j.0 || j.1 < 1 || j.1 > 365) {
      return (false, bad, p);
    }
    out = DateRule { kind: 1, mon: 0, week: 0, day: 0, n: j.1, time: 7200 };
    i = j.2;
  } else {
    let z: (boolean, i32, i32) = parse_uint(s, i);
    if (!z.0) {
      return (false, bad, p);
    }
    out = DateRule { kind: 2, mon: 0, week: 0, day: 0, n: z.1, time: 7200 };
    i = z.2;
  }
  if (i < s.len() && s[i] as i32 == 47) {
    let t: (boolean, i32, i32) = parse_rule_time(s, i + 1);
    if (!t.0) {
      return (false, bad, p);
    }
    out = DateRule { ...out, time: t.1 };
    i = t.2;
  }
  return (true, out, i);
}

// The `/time` of a date rule: `[+-]hh[:mm[:ss]]` with hours from -167
// to 167, so `M3.4.4/26` is 02:00 the day after (Jerusalem) and
// `M3.5.0/-1` 23:00 the day before (Nuuk). Unlike an offset it is
// not clamped to 24 hours.
function parse_rule_time(s: string, p: i32): (boolean, i32, i32) {
  let i: i32 = p;
  let sign: i32 = 1;
  if (i < s.len() && (s[i] as i32 == 43 || s[i] as i32 == 45)) {
    if (s[i] as i32 == 45) {
      sign = -1;
    }
    i = i + 1;
  }
  let h: (boolean, i32, i32) = parse_uint(s, i);
  if (!h.0 || h.1 > 167) {
    return (false, 0, p);
  }
  let total: i32 = h.1 * 3600;
  i = h.2;
  let unit: i32 = 60;
  while (unit > 0 && i < s.len() && s[i] as i32 == 58) {
    let v: (boolean, i32, i32) = parse_uint(s, i + 1);
    if (!v.0 || v.1 > 59) {
      return (false, 0, p);
    }
    total = total + v.1 * unit;
    i = v.2;
    unit = unit / 60;
  }
  return (true, sign * total, i);
}

function parse_uint(s: string, p: i32): (boolean, i32, i32) {
  let i: i32 = p;
  let v: i32 = 0;
  while (i < s.len() && is_digit(s[i] as i32)) {
    v = v * 10 + (s[i] as i32 - 48);
    i = i + 1;
  }
  if (i == p) {
    return (false, 0, p);
  }
  return (true, v, i);
}

// ---- applying a rule --------------------------------------------------------
// `rule_dst(r, sec)` — whether the rule has daylight time running at a
// UTC instant, which is the one decision both the offset and the
// abbreviation are read off.
//
// Which side of a change an instant falls on is decided in LOCAL time,
// and the two ends use different offsets to get there: the spring date
// is a standard-time wall clock and the autumn one a daylight-time wall
// clock, because each names the clock that is running when the change
// happens.
function rule_dst(r: Rule, sec: i64): boolean {
  if (!r.has_dst) {
    return false;
  }
  // The year the dates are computed for is the UTC one, not the local
  // one, so an instant in the last hours of December is measured
  // against the NEXT year's dates where the zone is west of Greenwich.
  let year: i32 = year_of(sec);
  let start: i64 = rule_instant(r.start, year) - r.std_off as i64;
  let end: i64 = rule_instant(r.end, year) - r.dst_off as i64;
  let on: boolean = false;
  if (start <= end) {
    on = sec >= start && sec < end;
  } else {
    // A southern-hemisphere zone, where daylight time spans the turn of
    // the year and the window is everything OUTSIDE the two dates.
    on = sec >= start || sec < end;
  }
  return on;
}

// The local-time instant a rule names in `year`, as seconds since the
// epoch with no offset applied.
//
// The day is counted forward from the first of January, and that base
// does not go BACK past the epoch: a year at or before 1970 is measured
// from 1970-01-01 as glibc measures it, so the dates a rule names in
// 1969 are the dates it names in 1970.
function rule_instant(d: DateRule, year: i32): i64 {
  let base: i32 = 0;
  if (year > 1970) {
    base = epoch_day(year, 1, 1);
  }
  let doy: i32 = 1;
  if (d.kind == 0) {
    doy = month_week_day(year, d.mon, d.week, d.day);
  } else if (d.kind == 1) {
    // February 29 is not counted, so on or after March 1 of a leap year
    // the calendar day is one later than the number.
    doy = d.n;
    if (doy >= 60 && time.is_leap_year(year)) {
      doy = doy + 1;
    }
  } else {
    doy = d.n + 1;
  }
  return (base + doy - 1) as i64 * (86400 as i64) + d.time as i64;
}

// The day of the year of the `week`th `day`-of-the-week in `mon`, with
// week 5 meaning the last one in the month.
function month_week_day(year: i32, mon: i32, week: i32, day: i32): i32 {
  let first: i64 = days_from_civil(year as i64, mon, 1);
  let wd: i32 = floor_mod(first + 4 as i64, 7 as i64) as i32;
  let dom: i32 = 1 + (day - wd + 7) % 7 + (week - 1) * 7;
  let last: i32 = time.days_in_month(year, mon);
  while (dom > last) {
    dom = dom - 7;
  }
  return (first + (dom - 1) as i64 - days_from_civil(year as i64, 1, 1)) as i32 + 1;
}

function epoch_day(year: i32, mon: i32, day: i32): i32 {
  return days_from_civil(year as i64, mon, day) as i32;
}

function year_of(local_sec: i64): i32 {
  return civil_from_days(floor_div(local_sec, 86400 as i64)).0 as i32;
}

// ---- what a caller prints ---------------------------------------------------
// `(z: Zone) civil(sec)` — the broken-down local time, which is
// localtime(3) with the fields nobody here prints left out.
pub function (z: Zone) civil(sec: i64): DateTime {
  let off: i32 = z.offset_at(sec);
  return time.instant_from_unix(sec).in_zone(time.timezone_fixed_offset(off)).to_datetime();
}

// `Civil` — localtime(3)'s fields with the year kept in 64 bits, so a
// timestamp the calendar has a year for is never narrowed on the way
// to being printed or parsed.
pub struct Civil { year: i64, month: i32, day: i32, hour: i32, min: i32, sec: i32, wday: i32, yday: i32 }

// `(z: Zone) local_fields(sec)` — the broken-down local time at `sec`.
pub function (z: Zone) local_fields(sec: i64): Civil {
  return civil_at(sec + z.offset_at(sec) as i64);
}

// `civil_at(local)` — the fields of a local-seconds count, which is a
// UTC instant when the offset is zero.
pub function civil_at(local: i64): Civil {
  let days: i64 = floor_div(local, 86400 as i64);
  let rem: i32 = (local - days * (86400 as i64)) as i32;
  let ymd: (i64, i32, i32) = civil_from_days(days);
  let wday: i32 = floor_mod(days + 4 as i64, 7 as i64) as i32;
  let yday: i32 = (days - days_from_civil(ymd.0, 1, 1)) as i32;
  return Civil { year: ymd.0, month: ymd.1, day: ymd.2, hour: rem / 3600, min: rem / 60 % 60, sec: rem % 60, wday: wday, yday: yday };
}

pub function floor_div(a: i64, b: i64): i64 {
  let q: i64 = a / b;
  if (a % b != 0 as i64 && a < 0 as i64 != b < 0 as i64) {
    q = q - 1 as i64;
  }
  return q;
}

pub function floor_mod(a: i64, b: i64): i64 {
  return a - floor_div(a, b) * b;
}

// `days_from_civil(y, m, d)` — days since 1970-01-01 of a proleptic
// Gregorian date, Hinnant's algorithm in 64 bits. The month must be
// 1..12; the day may be anything, which is how a caller normalises
// `mday` the way mktime does.
pub function days_from_civil(y: i64, m: i32, d: i32): i64 {
  let yy: i64 = y;
  if (m <= 2) {
    yy = yy - 1 as i64;
  }
  let era: i64 = floor_div(yy, 400 as i64);
  let yoe: i64 = yy - era * (400 as i64);
  let mp: i32 = m + 9;
  if (m > 2) {
    mp = m - 3;
  }
  let doy: i64 = ((153 * mp + 2) / 5) as i64 + d as i64 - 1 as i64;
  let doe: i64 = yoe * (365 as i64) + yoe / (4 as i64) - yoe / (100 as i64) + doy;
  return era * (146097 as i64) + doe - 719468 as i64;
}

// `civil_from_days(z)` — the inverse: (year, month, day).
pub function civil_from_days(z_in: i64): (i64, i32, i32) {
  let z: i64 = z_in + 719468 as i64;
  let era: i64 = floor_div(z, 146097 as i64);
  let doe: i64 = z - era * (146097 as i64);
  let yoe: i64 = (doe - doe / (1460 as i64) + doe / (36524 as i64) - doe / (146096 as i64)) / (365 as i64);
  let y: i64 = yoe + era * (400 as i64);
  let doy: i64 = doe - (365 as i64 * yoe + yoe / (4 as i64) - yoe / (100 as i64));
  let mp: i64 = (5 as i64 * doy + 2 as i64) / (153 as i64);
  let d: i32 = (doy - (153 as i64 * mp + 2 as i64) / (5 as i64) + 1 as i64) as i32;
  let m: i32 = (mp + 3 as i64) as i32;
  if (mp >= 10 as i64) {
    m = (mp - 9 as i64) as i32;
  }
  if (m <= 2) {
    y = y + 1 as i64;
  }
  return (y, m, d);
}

// ---- Darwin's tzset ---------------------------------------------------------
// Libc's stdtime/FreeBSD/localtime.c, which differs from glibc wherever a TZ
// value is not a clean answer:
//
//   - The zone directory is compiled in; $TZDIR is never read.
//   - A value that is neither a zone file nor a whole POSIX rule is UTC,
//     named `UTC`: a bare name with no offset, an empty TZ, a bad date.
//   - A name is any run up to a digit, `,`, `+` or `-`, or anything between
//     `<` and `>`, of any length.
//   - An hour may run to 167, and a field out of range refuses the rule
//     rather than being clamped.
//   - A rule is written out as two transitions a year from 1970 until the
//     1200-entry table is full, which is through 2569, and no rule is kept
//     past them. So it is standard time before the first, and after the
//     last it stays in the state the last one set.
//
// A daylight zone with no dates takes them from the posixrules file there;
// this applies the POSIX default dates instead, as it does for glibc.
function darwin_zone_from_tz(spec: string): Zone {
  if (spec.len() == 0) {
    return utc_zone();
  }
  match (read_zone_file(darwin_zone_path(spec))) {
    Some(z) => {
      return z;
    },
    None => {}
  }
  if (spec[0] as i32 == 58) {
    return utc_zone();
  }
  let r: Rule = darwin_parse_posix(spec);
  if (!r.valid) {
    return utc_zone();
  }
  return darwin_rule_zone(r);
}

// tzload's path: a leading `:` dropped, and a relative name under the
// compiled-in zone directory.
function darwin_zone_path(spec: string): string {
  let name: string = spec;
  if (name[0] as i32 == 58) {
    name = slice_unchecked(name, 1, name.len()) + "";
  }
  if (name.len() > 0 && name[0] as i32 == 47) {
    return name;
  }
  return "/usr/share/zoneinfo/" + name;
}

// A rule as tzparse's table: TZ_MAX_TIMES transitions, two a year from
// 1970.
function darwin_rule_zone(r: Rule): Zone {
  if (!r.has_dst) {
    return rule_zone(r);
  }
  let times: i64[] = [];
  let offs: i32[] = [];
  let abbrs: string[] = [];
  let dsts: boolean[] = [];
  let year: i32 = 1970;
  while (year < 1970 + 600) {
    let start: i64 = rule_instant(r.start, year) - r.std_off as i64;
    let end: i64 = rule_instant(r.end, year) - r.dst_off as i64;
    if (start > end) {
      times = times.append(end).append(start);
      offs = offs.append(r.std_off).append(r.dst_off);
      abbrs = abbrs.append(r.std_name).append(r.dst_name);
      dsts = dsts.append(false).append(true);
    } else {
      times = times.append(start).append(end);
      offs = offs.append(r.dst_off).append(r.std_off);
      abbrs = abbrs.append(r.dst_name).append(r.std_name);
      dsts = dsts.append(true).append(false);
    }
    year = year + 1;
  }
  return Zone { times: times, offs: offs, abbrs: abbrs, dsts: dsts, first: r.std_off, first_abbr: r.std_name, first_dst: false, rule: utc_rule() };
}

// tzparse: `std offset [dst [offset] [,start,end]]`, where `;` may stand
// for either comma and anything malformed refuses the whole string.
function darwin_parse_posix(s: string): Rule {
  let bad: Rule = utc_rule();
  let std_name: (string, i32) = darwin_name(s, 0);
  if (std_name.1 >= s.len()) {
    return bad;
  }
  let std: (boolean, i32, i32) = darwin_offset(s, std_name.1);
  if (!std.0) {
    return bad;
  }
  let std_off: i32 = 0 - std.1;
  let r: Rule = Rule { ...bad, valid: true, std_off: std_off, dst_off: std_off, std_name: std_name.0, dst_name: std_name.0 };
  if (std.2 >= s.len()) {
    return r;
  }
  return darwin_parse_dst(s, std.2, r);
}

// What follows the standard offset: the daylight name, its own offset when
// one is written, and the dates.
function darwin_parse_dst(s: string, from: i32, std: Rule): Rule {
  let name: (boolean, string, i32) = darwin_dst_name(s, from);
  if (!name.0) {
    return utc_rule();
  }
  let p: i32 = name.2;
  let r: Rule = Rule { ...std, has_dst: true, dst_off: std.std_off + 3600, dst_name: name.1 };
  if (p < s.len() && !is_rule_comma(s[p] as i32)) {
    let d: (boolean, i32, i32) = darwin_offset(s, p);
    if (!d.0) {
      return utc_rule();
    }
    r = Rule { ...r, dst_off: 0 - d.1 };
    p = d.2;
  }
  return darwin_rule_dates(r, s, p);
}

// The `,start,end` that ends a rule with DST at `p`, or the US rules when
// the string ends there instead.
function darwin_rule_dates(r: Rule, s: string, p: i32): Rule {
  if (p >= s.len()) {
    return Rule { ...r, start: us_dst_start(), end: us_dst_end() };
  }
  if (!is_rule_comma(s[p] as i32)) {
    return utc_rule();
  }
  return darwin_parse_dates(s, p + 1, r);
}

// `start,end`, which must end the string.
function darwin_parse_dates(s: string, from: i32, r: Rule): Rule {
  let a: (boolean, DateRule, i32) = darwin_date_rule(s, from);
  if (!a.0 || a.2 >= s.len() || s[a.2] as i32 != 44) {
    return utc_rule();
  }
  let b: (boolean, DateRule, i32) = darwin_date_rule(s, a.2 + 1);
  if (!b.0 || b.2 != s.len()) {
    return utc_rule();
  }
  return Rule { ...r, start: a.1, end: b.1 };
}

function is_rule_comma(c: i32): boolean {
  return c == 44 || c == 59;
}

// The daylight name: getqzname's when it opens with `<`, which then needs its
// `>`, and getzname's otherwise.
function darwin_dst_name(s: string, p: i32): (boolean, string, i32) {
  if (s[p] as i32 != 60) {
    let n: (string, i32) = darwin_name(s, p);
    return (true, n.0, n.1);
  }
  return darwin_quoted(s, p);
}

// getzname: the quoted form when a `>` follows the `<` anywhere, and
// otherwise a run of anything but a digit, `,`, `+` or `-`.
function darwin_name(s: string, p: i32): (string, i32) {
  let q: (boolean, string, i32) = darwin_quoted(s, p);
  if (q.0) {
    return (q.1, q.2);
  }
  let j: i32 = p;
  while (j < s.len() && !ends_name(s[j] as i32)) {
    j = j + 1;
  }
  return (slice_unchecked(s, p, j) + "", j);
}

// The first `>` at or after `p`, or the string's length.
function darwin_close(s: string, p: i32): i32 {
  let k: i32 = p;
  while (k < s.len() && s[k] as i32 != 62) {
    k = k + 1;
  }
  return k;
}

function ends_name(c: i32): boolean {
  return is_digit(c) || c == 44 || c == 43 || c == 45;
}

// `<...>` at `p`, as (found, the text between, the index past `>`).
function darwin_quoted(s: string, p: i32): (boolean, string, i32) {
  if (p >= s.len() || s[p] as i32 != 60) {
    return (false, "", p);
  }
  let k: i32 = darwin_close(s, p + 1);
  if (k >= s.len()) {
    return (false, "", p);
  }
  return (true, slice_unchecked(s, p + 1, k) + "", k + 1);
}

// getoffset: `[+-]` then getsecs, as (ok, seconds west, next).
function darwin_offset(s: string, p: i32): (boolean, i32, i32) {
  let i: i32 = p;
  let neg: boolean = false;
  if (i < s.len() && (s[i] as i32 == 43 || s[i] as i32 == 45)) {
    neg = s[i] as i32 == 45;
    i = i + 1;
  }
  let t: (boolean, i32, i32) = darwin_secs(s, i);
  if (!t.0 || !neg) {
    return t;
  }
  return (true, 0 - t.1, t.2);
}

// getsecs: `hh[:mm[:ss]]`, hours to 167, minutes to 59 and seconds to 60.
function darwin_secs(s: string, p: i32): (boolean, i32, i32) {
  let h: (boolean, i32, i32) = darwin_num(s, p, 0, 167);
  if (!h.0) {
    return h;
  }
  let total: i32 = h.1 * 3600;
  let i: i32 = h.2;
  if (i < s.len() && s[i] as i32 == 58) {
    let m: (boolean, i32, i32) = darwin_num(s, i + 1, 0, 59);
    if (!m.0) {
      return m;
    }
    total = total + m.1 * 60;
    i = m.2;
    if (i < s.len() && s[i] as i32 == 58) {
      let sec: (boolean, i32, i32) = darwin_num(s, i + 1, 0, 60);
      if (!sec.0) {
        return sec;
      }
      total = total + sec.1;
      i = sec.2;
    }
  }
  return (true, total, i);
}

// getnum: one or more digits, refused as soon as the value passes `max`.
function darwin_num(s: string, p: i32, min: i32, max: i32): (boolean, i32, i32) {
  if (p >= s.len() || !is_digit(s[p] as i32)) {
    return (false, 0, p);
  }
  let v: i32 = 0;
  let i: i32 = p;
  while (i < s.len() && is_digit(s[i] as i32)) {
    v = v * 10 + (s[i] as i32 - 48);
    if (v > max) {
      return (false, 0, p);
    }
    i = i + 1;
  }
  if (v < min) {
    return (false, 0, p);
  }
  return (true, v, i);
}

// The `m.w.d` after an `M`, at `p`.
function darwin_month_rule(s: string, p: i32): (boolean, DateRule, i32) {
  let bad: DateRule = DateRule { kind: 2, mon: 0, week: 0, day: 0, n: 0, time: 0 };
  let m: (boolean, i32, i32) = darwin_num(s, p, 1, 12);
  if (!m.0 || m.2 >= s.len() || s[m.2] as i32 != 46) {
    return (false, bad, p);
  }
  let w: (boolean, i32, i32) = darwin_num(s, m.2 + 1, 1, 5);
  if (!w.0 || w.2 >= s.len() || s[w.2] as i32 != 46) {
    return (false, bad, p);
  }
  let d: (boolean, i32, i32) = darwin_num(s, w.2 + 1, 0, 6);
  if (!d.0) {
    return (false, bad, p);
  }
  return (true, DateRule { kind: 0, mon: m.1, week: w.1, day: d.1, n: 0, time: 7200 }, d.2);
}

// getrule: `Jn` (1-365), `n` (0-365) or `Mm.w.d`, then an optional
// `/time` that cannot be negative.
function darwin_date_rule(s: string, p: i32): (boolean, DateRule, i32) {
  let day: (boolean, DateRule, i32) = darwin_rule_day(s, p);
  if (!day.0 || day.2 >= s.len() || s[day.2] as i32 != 47) {
    return day;
  }
  let t: (boolean, i32, i32) = darwin_secs(s, day.2 + 1);
  if (!t.0) {
    return (false, day.1, p);
  }
  return (true, DateRule { ...day.1, time: t.1 }, t.2);
}

function darwin_rule_day(s: string, p: i32): (boolean, DateRule, i32) {
  if (p < s.len() && s[p] as i32 == 74) {
    let j: (boolean, i32, i32) = darwin_num(s, p + 1, 1, 365);
    return (j.0, DateRule { kind: 1, mon: 0, week: 0, day: 0, n: j.1, time: 7200 }, j.2);
  }
  if (p < s.len() && s[p] as i32 == 77) {
    return darwin_month_rule(s, p + 1);
  }
  let n: (boolean, i32, i32) = darwin_num(s, p, 0, 365);
  return (n.0, DateRule { kind: 2, mon: 0, week: 0, day: 0, n: n.1, time: 7200 }, n.2);
}

