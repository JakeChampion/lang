// std/utf8 — UTF-8 codepoint decoding, encoding, and validation.
//
// Fern strings are byte arrays: `s[i]` is a byte (0..255) and
// `s.len()` is the byte length. That's correct and fast for ASCII and
// raw-byte work, but anything non-ASCII needs codepoint-level
// operations — `"héllo".len()` is 6, not 5, and `s[1]` is half of an
// `é`. This module is the bridge: decode the byte stream into Unicode
// scalar values, encode scalar values back to UTF-8 bytes, count, and
// validate.
//
// A "codepoint" here is a Unicode scalar value carried in an i32 (0 ..
// 0x10FFFF, excluding the UTF-16 surrogate range 0xD800..0xDFFF).
// There is no dedicated `Char` type yet (#4416); an i32 is the honest
// representation. U+FFFD (65533) is the REPLACEMENT CHARACTER the lossy
// decoders substitute for malformed input.

import "std/string";

// `utf8_decode_at(s, i)` — decode the single codepoint whose UTF-8
// encoding starts at byte index `i`, as `Some((codepoint, byte_len))`,
// or `None` when `i` is out of range or the bytes there aren't a valid,
// minimally-encoded, non-surrogate sequence. Strict: overlong forms,
// stray continuation / lead bytes, truncated tails, surrogates, and
// values past U+10FFFF all yield None. This is the low-level primitive
// every other function here is built on.
//
// (Locals are uniquely named per byte-width branch — the wasm / self-
// host emitters name locals by source identifier, so a re-declared
// `var cp` in sibling scopes would collide; see the json_encode note.)
pub function utf8_decode_at(s: string, i: i32): Option[(i32, i32)] {
    var n: i32 = s.len();
    if (i < 0 || i >= n) { return None; }
    var b0: i32 = s[i];
    // 1-byte: 0xxxxxxx (ASCII).
    if (b0 < 128) { return Some((b0, 1)); }
    // 0x80..0xBF is a stray continuation byte; not a valid lead.
    if (b0 < 192) { return None; }
    if (b0 < 224) {
        // 2-byte: 110xxxxx 10xxxxxx.
        if (i + 1 >= n) { return None; }
        var c1: i32 = s[i + 1];
        if (c1 < 128 || c1 >= 192) { return None; }
        var cp2: i32 = ((b0 - 192) << 6) | (c1 - 128);
        if (cp2 < 128) { return None; }             // overlong
        return Some((cp2, 2));
    }
    if (b0 < 240) {
        // 3-byte: 1110xxxx 10xxxxxx 10xxxxxx.
        if (i + 2 >= n) { return None; }
        var d1: i32 = s[i + 1];
        var d2: i32 = s[i + 2];
        if (d1 < 128 || d1 >= 192) { return None; }
        if (d2 < 128 || d2 >= 192) { return None; }
        var cp3: i32 = ((b0 - 224) << 12) | ((d1 - 128) << 6) | (d2 - 128);
        if (cp3 < 2048) { return None; }            // overlong
        if (cp3 >= 55296 && cp3 <= 57343) { return None; }  // surrogate
        return Some((cp3, 3));
    }
    if (b0 < 248) {
        // 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx.
        if (i + 3 >= n) { return None; }
        var e1: i32 = s[i + 1];
        var e2: i32 = s[i + 2];
        var e3: i32 = s[i + 3];
        if (e1 < 128 || e1 >= 192) { return None; }
        if (e2 < 128 || e2 >= 192) { return None; }
        if (e3 < 128 || e3 >= 192) { return None; }
        var cp4: i32 = ((b0 - 240) << 18) | ((e1 - 128) << 12) | ((e2 - 128) << 6) | (e3 - 128);
        if (cp4 < 65536) { return None; }           // overlong
        if (cp4 > 1114111) { return None; }         // > U+10FFFF
        return Some((cp4, 4));
    }
    return None;   // 0xF8..0xFF: invalid lead byte
}

// `utf8_encode(c)` — the UTF-8 byte string for a single scalar. An
// out-of-range or surrogate value encodes U+FFFD instead (lossy), so the
// result is always valid UTF-8. Inverse of `utf8_decode_at` for a valid
// scalar value.
//
// Takes a `char` (#5629). The range check stays because `as char` is not
// yet validating: a `char` built by casting an arbitrary i32 can still
// hold a surrogate or an out-of-range value, so this is the last line of
// defence for "the output is always well-formed UTF-8".
pub function utf8_encode(ch: char): string {
    var c: i32 = ch as i32;
    if (c < 0 || c > 1114111 || (c >= 55296 && c <= 57343)) { c = 65533; }  // U+FFFD
    if (c < 128) {
        var one: u8[] = [c as u8];
        return string_from_bytes(one);
    }
    if (c < 2048) {
        var two: u8[] = [(192 + (c >> 6)) as u8, (128 + (c & 63)) as u8];
        return string_from_bytes(two);
    }
    if (c < 65536) {
        var three: u8[] = [(224 + (c >> 12)) as u8, (128 + ((c >> 6) & 63)) as u8, (128 + (c & 63)) as u8];
        return string_from_bytes(three);
    }
    var four: u8[] = [(240 + (c >> 18)) as u8, (128 + ((c >> 12) & 63)) as u8, (128 + ((c >> 6) & 63)) as u8, (128 + (c & 63)) as u8];
    return string_from_bytes(four);
}

// `codepoints(s)` — decode the whole string to its sequence of
// codepoints. LOSSY: each malformed / truncated byte contributes one
// U+FFFD and the scan resumes one byte later, so the result is always
// well-formed (and non-empty for a non-empty input). Byte-for-byte the
// codepoint sibling of `string.chars()`.
pub function codepoints(s: string): char[] {
    var out: char[] = [];
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n) {
        match (utf8_decode_at(s, i)) {
            Some(pair) => { out = out.append(pair.0 as char); i = i + pair.1; },
            None => { out = out.append(65533 as char); i = i + 1; }
        }
    }
    return out;
}

// `codepoint_count(s)` — the number of codepoints, counted with the
// same lossy walk as `codepoints` (so it equals `codepoints(s).len()`)
// without materialising the array. This is the "character length" a
// user means when `s.len()` (byte length) surprises them.
pub function codepoint_count(s: string): i32 {
    var n: i32 = s.len();
    var i: i32 = 0;
    var count: i32 = 0;
    while (i < n) {
        match (utf8_decode_at(s, i)) {
            Some(pair) => { i = i + pair.1; },
            None => { i = i + 1; }
        }
        count = count + 1;
    }
    return count;
}

// `is_valid_utf8(s)` — true iff every byte is part of a valid,
// minimally-encoded, non-surrogate UTF-8 sequence (a strict scan). The
// empty string is valid.
pub function is_valid_utf8(s: string): boolean {
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n) {
        match (utf8_decode_at(s, i)) {
            Some(pair) => { i = i + pair.1; },
            None => { return false; }
        }
    }
    return true;
}

// `encode_all(cps)` — concatenate the UTF-8 encodings of a codepoint
// sequence into a string. Inverse of `codepoints` for valid input
// (`encode_all(codepoints(s)) == s` when `s` is valid UTF-8).
pub function encode_all(cps: char[]): string {
    var out: string = "";
    var i: i32 = 0;
    var n: i32 = cps.len();
    while (i < n) {
        out = out + utf8_encode(cps[i]);
        i = i + 1;
    }
    return out;
}

// `codepoint_at(s, byte_index)` — the codepoint whose encoding starts
// at `byte_index`, or None when the index is out of range or not a
// valid sequence start. The length-free companion to `utf8_decode_at`
// for callers that want only the scalar value, not the byte width.
pub function codepoint_at(s: string, byte_index: i32): Option[char] {
    match (utf8_decode_at(s, byte_index)) {
        Some(pair) => { return Some(pair.0 as char); },
        None => { return None; }
    }
}

// `char_at(s, index)` — the single character at codepoint index `index`
// (0-based) as a one-character string, or None when `index` is negative
// or past the last codepoint. This is the "Nth character" byte indexing
// can't do: `s[i]` is a byte, `char_at(s, i)` is a whole character. A
// valid character comes back as its exact original bytes; a malformed
// byte counts as one U+FFFD character (matching `codepoints`).
pub function char_at(s: string, index: i32): Option[string] {
    if (index < 0) { return None; }
    var n: i32 = s.len();
    var i: i32 = 0;
    var cp_idx: i32 = 0;
    while (i < n) {
        var start: i32 = i;
        var valid: boolean = true;
        match (utf8_decode_at(s, i)) {
            Some(pair) => { i = i + pair.1; },
            None => { i = i + 1; valid = false; }
        }
        if (cp_idx == index) {
            if (valid) { return Some(s[start : i].to_owned()); }
            return Some(utf8_encode(65533 as char));   // U+FFFD for a malformed byte
        }
        cp_idx = cp_idx + 1;
    }
    return None;
}

// `substring(s, start, end)` — the text spanning codepoint indices
// `[start, end)` (0-based, half-open) as a string. Bounds are clamped
// to `[0, codepoint_count]` and start-past-end yields "", so out-of-
// range indices never fault. This is the codepoint-aware analogue of a
// byte slice `s[a:b]` — which would split multibyte characters and
// produce invalid UTF-8. A single O(n) scan records the byte offsets
// where the codepoint cursor crosses `start` and `end`.
pub function substring(s: string, start: i32, end: i32): str {
    var n: i32 = s.len();
    var lo: i32 = start;
    if (lo < 0) { lo = 0; }
    var i: i32 = 0;
    var cp_idx: i32 = 0;
    var byte_start: i32 = 0 - 1;   // sentinel: `lo` not reached
    var byte_end: i32 = n;         // default: `end` at/after the string
    while (i < n) {
        if (cp_idx == lo) { byte_start = i; }
        if (cp_idx == end) { byte_end = i; }
        match (utf8_decode_at(s, i)) {
            Some(pair) => { i = i + pair.1; },
            None => { i = i + 1; }
        }
        cp_idx = cp_idx + 1;
    }
    // Boundaries landing exactly at the end-of-string (cp_idx == count).
    if (cp_idx == lo) { byte_start = i; }
    if (cp_idx == end) { byte_end = i; }
    if (byte_start < 0) { return ""; }          // `start` past the last codepoint
    if (byte_end < byte_start) { return ""; }   // `end` <= `start`
    return s[byte_start : byte_end];
}
