// std/crypto/field25519: arithmetic in the integers mod p = 2^255 - 19,
// the field X25519 and Ed25519 are both built over.
//
// An element is four 64-bit limbs, least significant first, standing for a
// value below 2^256 that need not be below p: 2^256 = 38 mod p, so a carry
// out of the top limb folds back in as 38. Every operation takes and answers
// such values, and only `to_bytes` reduces fully. The limb arithmetic is
// straight-line code generated by scripts/gen-field25519.py, its carries
// computed from the top bits, so nothing branches on, or indexes memory
// with, a limb; the exponents of `invert` and `pow22523` are public.

const ALL: u64 = 0xffffffffffffffffu64;

pub struct Fe { l0: u64, l1: u64, l2: u64, l3: u64 }

// from_i64 is v, which must not be negative.
pub function from_i64(v: i64): Fe {
  return Fe { l0: v as u64, l1: 0u64, l2: 0u64, l3: 0u64 };
}

pub function neg(a: Fe): Fe {
  return sub(from_i64(0), a);
}

// cswap swaps a and b when swap is 1 and keeps them when it is 0, by mask.
pub function cswap(a: Fe, b: Fe, swap: i64): (Fe, Fe) {
  let m: u64 = 0u64 - swap as u64;
  let x0: u64 = m & (a.l0 ^ b.l0);
  let x1: u64 = m & (a.l1 ^ b.l1);
  let x2: u64 = m & (a.l2 ^ b.l2);
  let x3: u64 = m & (a.l3 ^ b.l3);
  return (Fe { l0: a.l0 ^ x0, l1: a.l1 ^ x1, l2: a.l2 ^ x2, l3: a.l3 ^ x3 }, Fe { l0: b.l0 ^ x0, l1: b.l1 ^ x1, l2: b.l2 ^ x2, l3: b.l3 ^ x3 });
}

// cmov is b when flag is 1 and a when it is 0, by mask.
pub function cmov(a: Fe, b: Fe, flag: i64): Fe {
  let m: u64 = 0u64 - flag as u64;
  return Fe { l0: a.l0 ^ m & (a.l0 ^ b.l0), l1: a.l1 ^ m & (a.l1 ^ b.l1), l2: a.l2 ^ m & (a.l2 ^ b.l2), l3: a.l3 ^ m & (a.l3 ^ b.l3) };
}

// from_bytes reads 32 little-endian bytes, the top bit ignored.
pub function from_bytes(b: [u8]): Fe {
  return Fe { l0: __word(b, 0), l1: __word(b, 8), l2: __word(b, 16), l3: __word(b, 24) & 0x7fffffffffffffffu64 };
}

function __word(b: [u8], at: i32): u64 {
  let w: u64 = 0u64;
  let i: i32 = 7;
  while (i >= 0) {
    w = w << 8u64 | b[at + i] as u64;
    i = i - 1;
  }
  return w;
}

// to_bytes is the canonical encoding: a reduced below p, little-endian.
pub function to_bytes(a: Fe): u8[] {
  let c: Fe = __canonical(a);
  let out: u8[] = __alloc_u8(32);
  out = __put(out, 0, c.l0);
  out = __put(out, 8, c.l1);
  out = __put(out, 16, c.l2);
  return __put(out, 24, c.l3);
}

function __put(own out: u8[], at: i32, w: u64): u8[] {
  let i: i32 = 0;
  while (i < 8) {
    out = out.with(at + i, (w >> (8 * i) as u64 & 255u64) as u8);
    i = i + 1;
  }
  return out;
}

// __sqn is a squared `times` times.
function __sqn(a: Fe, times: i32): Fe {
  let r: Fe = a;
  let i: i32 = 0;
  while (i < times) {
    r = sq(r);
    i = i + 1;
  }
  return r;
}

// __pow250 is a^(2^250 - 1) and a^11, the shared start of `invert` and
// `pow22523`'s addition chains (ref10's fe_invert and fe_pow22523).
function __pow250(a: Fe): (Fe, Fe) {
  let t0: Fe = sq(a);
  let t1: Fe = mul(a, __sqn(t0, 2));
  let a11: Fe = mul(t0, t1);
  let x5: Fe = mul(t1, sq(a11));
  let x10: Fe = mul(__sqn(x5, 5), x5);
  let x20: Fe = mul(__sqn(x10, 10), x10);
  let x40: Fe = mul(__sqn(x20, 20), x20);
  let x50: Fe = mul(__sqn(x40, 10), x10);
  let x100: Fe = mul(__sqn(x50, 50), x50);
  let x200: Fe = mul(__sqn(x100, 100), x100);
  return (mul(__sqn(x200, 50), x50), a11);
}

// invert is a^(p - 2) = 1/a, by 254 squarings and 11 multiplications.
pub function invert(a: Fe): Fe {
  let t: (Fe, Fe) = __pow250(a);
  return mul(__sqn(t.0, 5), t.1);
}

// pow22523 is a^((p - 5) / 8) = a^(2^252 - 3), the power a square root is
// built from.
pub function pow22523(a: Fe): Fe {
  return mul(__sqn(__pow250(a).0, 2), a);
}

