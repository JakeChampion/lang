// std/crypto/rsa — RSA signature verification: RSASSA-PKCS1-v1_5 and
// RSASSA-PSS (RFC 8017) over SHA-256, SHA-384 and SHA-512, the forms TLS 1.3
// and X.509 chains use.
//
//   let key: rsa.PublicKey = rsa.public_key(modulus, exponent)?;
//   if (rsa.verify_pss(key, rsa.Sha256, message, signature)) { … }
//
// Verification handles only public values (the key, the message, the
// signature), so unlike the AEAD and the key exchange it does not need to
// run in constant time.

import "core/bigint";
import "core/int";
import "std/crypto";

// The digest a signature was made over.
pub enum Hash {
  Sha256,
  Sha384,
  Sha512,
}

// RsaError — why a public key was refused.
pub enum RsaError {
  // The modulus has fewer bits than the 1,024 this module accepts at all.
  ModulusTooSmall(i32),
  // The modulus has more bits than the 16,384 this module accepts.
  ModulusTooLarge(i32),
  // The exponent is even, less than 3, or wider than 64 bits.
  BadExponent,
}

pub function (e: RsaError) message(): string {
  match (e) {
    ModulusTooSmall(bits) => {
      return "rsa: the modulus is " + int.int_to_string(bits) + " bits, want at least 1024";
    },
    ModulusTooLarge(bits) => {
      return "rsa: the modulus is " + int.int_to_string(bits) + " bits, want at most 16384";
    },
    BadExponent => {
      return "rsa: the exponent must be odd, at least 3 and at most 64 bits";
    }
  }
  return "";
}

// PublicKey — an RSA public key: the modulus n, the public exponent e, and
// the length of n in bytes, which every signature under the key has.
pub struct PublicKey { n: bigint.BigInt, e: bigint.BigInt, bytes: i32, bits: i32 }

// __from_be is the unsigned big-endian integer b denotes.
function __from_be(b: [u8]): bigint.BigInt {
  let v: bigint.BigInt = bigint.zero();
  let i: i32 = 0;
  while (i < b.len()) {
    v = v.shl(8).add(bigint.from_u64(b[i] as u64));
    i = i + 1;
  }
  return v;
}

// __to_be is v as exactly `len` big-endian bytes, v below 2^(8*len).
function __to_be(v: bigint.BigInt, len: i32): u8[] {
  let out: u8[] = __alloc_u8(len);
  let i: i32 = 0;
  while (i < len) {
    let w: u64 = v.word64(i / 8);
    out = out.with(len - 1 - i, (w >> (i % 8 * 8) as u64 & 255) as u8);
    i = i + 1;
  }
  return out;
}

// public_key(modulus, exponent) — the key with the big-endian modulus and
// exponent a certificate or a TLS message carries.
pub function public_key(modulus: [u8], exponent: [u8]): Result[PublicKey, RsaError] {
  let n: bigint.BigInt = __from_be(modulus);
  let e: bigint.BigInt = __from_be(exponent);
  let bits: i32 = n.bit_length();
  if (bits < 1024) {
    return Err(ModulusTooSmall(bits));
  }
  // Both bounds are OpenSSL's: a certificate is attacker-supplied, and
  // verification costs grow with the modulus and the exponent.
  if (bits > 16384) {
    return Err(ModulusTooLarge(bits));
  }
  if (!e.bit(0) || e.bit_length() < 2 || e.bit_length() > 64) {
    return Err(BadExponent);
  }
  return Ok(PublicKey { n: n, e: e, bytes: (bits + 7) / 8, bits: bits });
}

// __modpow is b^e mod n, by square-and-multiply over e's public bits.
function __modpow(b: bigint.BigInt, e: bigint.BigInt, n: bigint.BigInt): bigint.BigInt {
  let r: bigint.BigInt = bigint.from_u64(1 as u64);
  let i: i32 = e.bit_length() - 1;
  while (i >= 0) {
    r = r.mul(r).divmod(n).1;
    if (e.bit(i)) {
      r = r.mul(b).divmod(n).1;
    }
    i = i - 1;
  }
  return r;
}

// __open is the encoded message a signature carries: s^e mod n as `len`
// bytes, or nothing when the signature is not one of n's length or is not
// below n.
function __open(key: PublicKey, sig: [u8], len: i32): Option[u8[]] {
  if (sig.len() != key.bytes) {
    return None;
  }
  let s: bigint.BigInt = __from_be(sig);
  if (s.cmp(key.n) >= 0) {
    return None;
  }
  let m: bigint.BigInt = __modpow(s, key.e, key.n);
  if (m.bit_length() > len * 8) {
    return None;
  }
  return Some(__to_be(m, len));
}

function __digest(h: Hash, msg: [u8]): u8[] {
  match (h) {
    Sha256 => {
      return crypto.sha256_new().update_bytes(msg).final_bytes();
    },
    Sha384 => {
      return crypto.sha384_new().update_bytes(msg).final_bytes();
    },
    Sha512 => {
      return crypto.sha512_new().update_bytes(msg).final_bytes();
    }
  }
  return [];
}

// __digest_info is the DER DigestInfo prefix PKCS#1 v1.5 puts before the
// hash (RFC 8017 §9.2, note 1).
function __digest_info(h: Hash): string {
  match (h) {
    Sha256 => {
      return "3031300d060960864801650304020105000420";
    },
    Sha384 => {
      return "3041300d060960864801650304020205000430";
    },
    Sha512 => {
      return "3051300d060960864801650304020305000440";
    }
  }
  return "";
}

function __unhex(s: string): u8[] {
  let out: u8[] = __alloc_u8(s.len() / 2);
  let i: i32 = 0;
  while (i < s.len() / 2) {
    out = out.with(i, (__nibble(s[2 * i] as i32) * 16 + __nibble(s[2 * i + 1] as i32)) as u8);
    i = i + 1;
  }
  return out;
}

function __nibble(c: i32): i32 {
  if (c >= 97) {
    return c - 87;
  }
  return c - 48;
}

// __range is b[from, from+len) as its own array.
function __range(b: [u8], from: i32, len: i32): u8[] {
  let out: u8[] = __alloc_u8(len);
  let i: i32 = 0;
  while (i < len) {
    out = out.with(i, b[from + i]);
    i = i + 1;
  }
  return out;
}

// __same is whether a and b hold the same bytes.
function __same(a: [u8], b: [u8]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// __pkcs1_em is the RSASSA-PKCS1-v1_5 encoding of msg's digest in `len`
// bytes: 00 01 FF…FF 00, the DigestInfo for `hash`, and the digest; or
// nothing when `len` cannot hold it with eight bytes of padding.
function __pkcs1_em(hash: Hash, msg: [u8], len: i32): Option[u8[]] {
  let info: u8[] = __unhex(__digest_info(hash));
  let digest: u8[] = __digest(hash, msg);
  let t: i32 = info.len() + digest.len();
  if (len < t + 11) {
    return None;
  }
  let em: u8[] = __alloc_u8(len);
  let ps_end: i32 = len - t - 1;
  let i: i32 = 0;
  while (i < ps_end) {
    em = em.with(i, 255 as u8);
    i = i + 1;
  }
  em = em.with(0, 0 as u8).with(1, 1 as u8).with(ps_end, 0 as u8);
  i = 0;
  while (i < t) {
    if (i < info.len()) {
      em = em.with(ps_end + 1 + i, info[i]);
    } else {
      em = em.with(ps_end + 1 + i, digest[i - info.len()]);
    }
    i = i + 1;
  }
  return Some(em);
}

// verify_pkcs1v15(key, hash, msg, sig) — whether sig is key's RSASSA-PKCS1-v1_5
// signature over msg: the encoding is built from msg and compared whole with
// what the signature opens to.
pub function verify_pkcs1v15(key: PublicKey, hash: Hash, msg: [u8], sig: [u8]): boolean {
  match (__open(key, sig, key.bytes)) {
    Some(got) => {
      match (__pkcs1_em(hash, msg, key.bytes)) {
        Some(want) => {
          return __same(got, want);
        },
        None => {
          return false;
        }
      }
    },
    None => {
      return false;
    }
  }
  return false;
}

// __mgf1 is MGF1 over `seed` with the digest `hash`, `len` bytes long.
function __mgf1(hash: Hash, seed: [u8], len: i32): u8[] {
  let out: u8[] = __alloc_u8(len);
  let at: i32 = 0;
  let counter: i32 = 0;
  let input: u8[] = __alloc_u8(seed.len() + 4);
  let i: i32 = 0;
  while (i < seed.len()) {
    input = input.with(i, seed[i]);
    i = i + 1;
  }
  while (at < len) {
    let c: i32 = seed.len();
    input = input.with(c, (counter >> 24 & 255) as u8).with(c + 1, (counter >> 16 & 255) as u8).with(c + 2, (counter >> 8 & 255) as u8).with(c + 3, (counter & 255) as u8);
    let block: u8[] = __digest(hash, input);
    let j: i32 = 0;
    while (j < block.len() && at < len) {
      out = out.with(at, block[j]);
      at = at + 1;
      j = j + 1;
    }
    counter = counter + 1;
  }
  return out;
}

// __pss_salt is the salt of a PSS encoded message em whose hash is h:
// the data block unmasked with MGF1(h), its top `top` bits cleared, which
// must be zeros, a 01, and an `s_len`-byte salt; nothing when it is not.
function __pss_salt(hash: Hash, em: [u8], h: [u8], top: i32, s_len: i32): Option[u8[]] {
  let db_len: i32 = em.len() - h.len() - 1;
  let mask: u8[] = __mgf1(hash, h, db_len);
  let db: u8[] = __alloc_u8(db_len);
  let i: i32 = 0;
  while (i < db_len) {
    db = db.with(i, em[i] ^ mask[i]);
    i = i + 1;
  }
  db = db.with(0, (db[0] as i32 & 255 >> top) as u8);
  let ps: i32 = db_len - s_len - 1;
  i = 0;
  while (i < ps) {
    if (db[i] != 0 as u8) {
      return None;
    }
    i = i + 1;
  }
  if (db[ps] != 1 as u8) {
    return None;
  }
  return Some(__range(db, ps + 1, s_len));
}

// __pss_hash is the digest PSS compares against the encoded message's: of
// eight zero bytes, msg's digest, and the salt.
function __pss_hash(hash: Hash, m_hash: [u8], salt: [u8]): u8[] {
  let m2: u8[] = __alloc_u8(8 + m_hash.len() + salt.len());
  let i: i32 = 0;
  while (i < m2.len()) {
    if (i < 8) {
      m2 = m2.with(i, 0 as u8);
    } else if (i < 8 + m_hash.len()) {
      m2 = m2.with(i, m_hash[i - 8]);
    } else {
      m2 = m2.with(i, salt[i - 8 - m_hash.len()]);
    }
    i = i + 1;
  }
  return __digest(hash, m2);
}

// verify_pss(key, hash, msg, sig) — whether sig is key's RSASSA-PSS
// signature over msg, with MGF1 over the same digest and a salt as long as
// the digest, the parameters TLS 1.3 fixes (RFC 8446 §4.2.3).
pub function verify_pss(key: PublicKey, hash: Hash, msg: [u8], sig: [u8]): boolean {
  let em_bits: i32 = key.bits - 1;
  let em_len: i32 = (em_bits + 7) / 8;
  let top: i32 = 8 * em_len - em_bits;
  let m_hash: u8[] = __digest(hash, msg);
  let h_len: i32 = m_hash.len();
  match (__open(key, sig, em_len)) {
    Some(em) => {
      if (em_len < 2 * h_len + 2 || em[em_len - 1] != 188 as u8 || (em[0] as i32 & (255 >> top ^ 255)) != 0) {
        return false;
      }
      let h: u8[] = __range(em, em_len - h_len - 1, h_len);
      match (__pss_salt(hash, em, h, top, h_len)) {
        Some(salt) => {
          return __same(__pss_hash(hash, m_hash, salt), h);
        },
        None => {
          return false;
        }
      }
    },
    None => {
      return false;
    }
  }
  return false;
}
