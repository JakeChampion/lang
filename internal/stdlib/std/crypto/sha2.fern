// This module defines the SHA-2 digest types for signature algorithms.

import "std/crypto";

pub enum Hash {
  Sha256,
  Sha384,
  Sha512,
}

pub function (h: Hash) size(): i32 {
  match (h) {
    Sha256 => {
      return 32;
    },
    Sha384 => {
      return 48;
    },
    Sha512 => {
      return 64;
    }
  }
  return 0;
}

pub function (h: Hash) digest(msg: [u8]): u8[] {
  match (h) {
    Sha256 => {
      return crypto.sha256_new().update_bytes(msg).final_bytes();
    },
    Sha384 => {
      return crypto.sha384_new().update_bytes(msg).final_bytes();
    },
    Sha512 => {
      return crypto.sha512_new().update_bytes(msg).final_bytes();
    }
  }
  return [];
}
