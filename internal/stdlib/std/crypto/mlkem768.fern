// std/crypto/mlkem768 — ML-KEM-768, the module-lattice key-encapsulation
// mechanism of FIPS 203, at the parameter set TLS 1.3's X25519MLKEM768
// hybrid key share uses.
//
//   let keys: mlkem768.KeyPair = mlkem768.keygen_derand(d, z)?;
//   let sent: mlkem768.Encapsulation = mlkem768.encaps_derand(keys.encapsulation_key, m)?;
//   let shared: u8[] = mlkem768.decaps(keys.decapsulation_key, sent.ciphertext)?;
//
// d, z and m are 32 random bytes each, drawn by the caller. The
// encapsulation key is 1,184 bytes, the decapsulation key 2,400, the
// ciphertext 1,088 and the shared secret 32. `decaps` does not fail on a
// ciphertext of the right length: one that does not re-encrypt to itself
// yields a secret derived from z instead (implicit rejection). The input
// checks FIPS 203 requires refuse an encapsulation key with a coefficient
// that is not below q (`EncapsulationKeyModulus`) and a decapsulation key
// whose stored hash of its encapsulation key does not match
// (`DecapsulationKeyHash`).
//
// Constant time by construction: coefficients mod q = 3329 are `i32`s
// reduced by Barrett multiplication and masked subtraction, never `%` or
// `/`; compression divides by q with a multiply and a shift; and `decaps`
// compares the re-encryption and selects the secret with masks. Only the
// matrix sampling branches, on bytes expanded from the public seed.

import "core/int";
import "std/crypto";

// MlKemError — an input of the wrong length (the length it had), or a key
// that fails the check FIPS 203 sets for it.
pub enum MlKemError {
  SeedLength(i32),
  MessageLength(i32),
  EncapsulationKeyLength(i32),
  DecapsulationKeyLength(i32),
  CiphertextLength(i32),
  EncapsulationKeyModulus,
  DecapsulationKeyHash,
}

pub function (e: MlKemError) message(): string {
  match (e) {
    SeedLength(n) => {
      return "mlkem768: the seed is " + int.int_to_string(n) + " bytes, want 32";
    },
    MessageLength(n) => {
      return "mlkem768: the message is " + int.int_to_string(n) + " bytes, want 32";
    },
    EncapsulationKeyLength(n) => {
      return "mlkem768: the encapsulation key is " + int.int_to_string(n) + " bytes, want 1184";
    },
    DecapsulationKeyLength(n) => {
      return "mlkem768: the decapsulation key is " + int.int_to_string(n) + " bytes, want 2400";
    },
    CiphertextLength(n) => {
      return "mlkem768: the ciphertext is " + int.int_to_string(n) + " bytes, want 1088";
    },
    EncapsulationKeyModulus => {
      return "mlkem768: the encapsulation key has a coefficient not below q";
    },
    DecapsulationKeyHash => {
      return "mlkem768: the decapsulation key's hash of its encapsulation key does not match";
    }
  }
  return "";
}

// KeyPair — an encapsulation key, which is public, and its decapsulation
// key, which is secret.
pub struct KeyPair {
  encapsulation_key: u8[],
  decapsulation_key: u8[],
}

// Encapsulation — a shared secret and the ciphertext that carries it to the
// holder of the decapsulation key.
pub struct Encapsulation {
  shared_secret: u8[],
  ciphertext: u8[],
}

const Q: i32 = 3329;

// ZETAS[i] is 17^BitRev7(i) mod q (FIPS 203, Appendix A).
const ZETAS: i32[] = [
  1, 1729, 2580, 3289, 2642, 630, 1897, 848, 1062, 1919, 193, 797, 2786, 3260, 569, 1746,
  296, 2447, 1339, 1476, 3046, 56, 2240, 1333, 1426, 2094, 535, 2882, 2393, 2879, 1974, 821,
  289, 331, 3253, 1756, 1197, 2304, 2277, 2055, 650, 1977, 2513, 632, 2865, 33, 1320, 1915,
  2319, 1435, 807, 452, 1438, 2868, 1534, 2402, 2647, 2617, 1481, 648, 2474, 3110, 1227, 910,
  17, 2761, 583, 2649, 1637, 723, 2288, 1100, 1409, 2662, 3281, 233, 756, 2156, 3015, 3050,
  1703, 1651, 2789, 1789, 1847, 952, 1461, 2687, 939, 2308, 2437, 2388, 733, 2337, 268, 641,
  1584, 2298, 2037, 3220, 375, 2549, 2090, 1645, 1063, 319, 2773, 757, 2099, 561, 2466, 2594,
  2804, 1092, 403, 1026, 1143, 2150, 2775, 886, 1722, 1212, 1874, 1029, 2110, 2935, 885, 2154,
];

// __csubq is x - q when x >= q, for 0 <= x < 2q, chosen by mask.
function __csubq(x: i32): i32 {
  let r: i32 = x - Q;
  return r + (r >> 31 & Q);
}

// __reduce is x mod q for 0 <= x < 2^31. Barrett's quotient estimate,
// x * floor(2^32 / q) >> 32, is low by at most one, which __csubq takes
// back.
function __reduce(x: i32): i32 {
  return __csubq(x - (x as i64 * 1290167 >> 32) as i32 * Q);
}

function __zeros(n: i32): i32[] {
  let a: i32[] = __alloc_i32(n);
  let i: i32 = 0;
  while (i < n) {
    a = a.with(i, 0);
    i = i + 1;
  }
  return a;
}

function __copy(own dst: u8[], at: i32, src: [u8], from: i32, len: i32): u8[] {
  let i: i32 = 0;
  while (i < len) {
    dst = dst.with(at + i, src[from + i]);
    i = i + 1;
  }
  return dst;
}

// __add adds the count coefficients of g to those of f.
function __add(own f: i32[], g: [i32], count: i32): i32[] {
  let i: i32 = 0;
  while (i < count) {
    f = f.with(i, __csubq(f[i] + g[i]));
    i = i + 1;
  }
  return f;
}

// __ntt is the number-theoretic transform of the polynomial at f[at]
// (FIPS 203, Algorithm 9).
function __ntt(own f: i32[], at: i32): i32[] {
  let k: i32 = 1;
  let len: i32 = 128;
  while (len >= 2) {
    let start: i32 = at;
    while (start < at + 256) {
      let zeta: i32 = ZETAS[k];
      k = k + 1;
      let j: i32 = start;
      while (j < start + len) {
        let t: i32 = __reduce(zeta * f[j + len]);
        let a: i32 = f[j];
        f = f.with(j + len, __csubq(a - t + Q));
        f = f.with(j, __csubq(a + t));
        j = j + 1;
      }
      start = start + 2 * len;
    }
    len = len / 2;
  }
  return f;
}

// __inv_ntt is the inverse transform (Algorithm 10), scaled by
// 128^-1 = 3303.
function __inv_ntt(own f: i32[], at: i32): i32[] {
  let k: i32 = 127;
  let len: i32 = 2;
  while (len <= 128) {
    let start: i32 = at;
    while (start < at + 256) {
      let zeta: i32 = ZETAS[k];
      k = k - 1;
      let j: i32 = start;
      while (j < start + len) {
        let t: i32 = f[j];
        let u: i32 = f[j + len];
        f = f.with(j, __csubq(t + u));
        f = f.with(j + len, __reduce(zeta * (u - t + Q)));
        j = j + 1;
      }
      start = start + 2 * len;
    }
    len = len * 2;
  }
  let i: i32 = at;
  while (i < at + 256) {
    f = f.with(i, __reduce(f[i] * 3303));
    i = i + 1;
  }
  return f;
}

// __mul_acc adds the product of the NTT-domain polynomials at a[ai] and
// b[bi] (Algorithm 11) to the one at acc[at]. The gamma of pair 2i is
// ZETAS[64 + i] and that of pair 2i + 1 is its negation.
function __mul_acc(own acc: i32[], at: i32, a: [i32], ai: i32, b: [i32], bi: i32): i32[] {
  let i: i32 = 0;
  while (i < 64) {
    let g: i32 = ZETAS[64 + i];
    acc = __basemul(acc, at + 4 * i, a, ai + 4 * i, b, bi + 4 * i, g);
    acc = __basemul(acc, at + 4 * i + 2, a, ai + 4 * i + 2, b, bi + 4 * i + 2, Q - g);
    i = i + 1;
  }
  return acc;
}

// __basemul adds (a0 + a1 X)(b0 + b1 X) mod X^2 - g to the pair at acc[at]
// (Algorithm 12).
function __basemul(own acc: i32[], at: i32, a: [i32], ai: i32, b: [i32], bi: i32, g: i32): i32[] {
  let a0: i32 = a[ai];
  let a1: i32 = a[ai + 1];
  let b0: i32 = b[bi];
  let b1: i32 = b[bi + 1];
  let c0: i32 = __reduce(a0 * b0 + __reduce(a1 * b1) * g);
  let c1: i32 = __reduce(a0 * b1 + a1 * b0);
  return acc.with(at, __csubq(acc[at] + c0)).with(at + 1, __csubq(acc[at + 1] + c1));
}

// __mat_vec adds the product of the 3x3 matrix a and the vector v, both in
// the NTT domain, to acc.
function __mat_vec(a: [i32], v: [i32], own acc: i32[]): i32[] {
  let i: i32 = 0;
  while (i < 3) {
    let j: i32 = 0;
    while (j < 3) {
      acc = __mul_acc(acc, 256 * i, a, 768 * i + 256 * j, v, 256 * j);
      j = j + 1;
    }
    i = i + 1;
  }
  return acc;
}

// __dot is the inner product of the vectors a and v in the NTT domain.
function __dot(a: [i32], v: [i32]): i32[] {
  let acc: i32[] = __zeros(256);
  let j: i32 = 0;
  while (j < 3) {
    acc = __mul_acc(acc, 0, a, 256 * j, v, 256 * j);
    j = j + 1;
  }
  return acc;
}

// __sample_ntt draws the polynomial at a[at] uniformly from
// SHAKE128(rho || j || i) by rejection (Algorithm 7). The seed is public,
// so the rejection may branch.
function __sample_ntt(own a: i32[], at: i32, rho: [u8], j: i32, i: i32): i32[] {
  let seed: u8[] = __copy(__alloc_u8(34), 0, rho, 0, 32).with(32, j as u8).with(33, i as u8);
  let x: crypto.ShakeReader = crypto.shake128_new().update_bytes(seed).reader();
  let n: i32 = 0;
  while (n < 256) {
    let next: (u8[], crypto.ShakeReader) = x.squeeze(168);
    let b: u8[] = next.0;
    x = next.1;
    let k: i32 = 0;
    while (k < 168 && n < 256) {
      let d1: i32 = b[k] as i32 | (b[k + 1] as i32 & 15) << 8;
      let d2: i32 = b[k + 1] as i32 >> 4 | b[k + 2] as i32 << 4;
      if (d1 < Q) {
        a = a.with(at + n, d1);
        n = n + 1;
      }
      if (d2 < Q && n < 256) {
        a = a.with(at + n, d2);
        n = n + 1;
      }
      k = k + 3;
    }
  }
  return a;
}

// __matrix is A with entry (i, j) at 768 i + 256 j, sampled from
// rho || j || i, or its transpose.
function __matrix(rho: [u8], transposed: boolean): i32[] {
  let a: i32[] = __alloc_i32(2304);
  let i: i32 = 0;
  while (i < 3) {
    let j: i32 = 0;
    while (j < 3) {
      if (transposed) {
        a = __sample_ntt(a, 768 * i + 256 * j, rho, i, j);
      } else {
        a = __sample_ntt(a, 768 * i + 256 * j, rho, j, i);
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return a;
}

// __cbd writes the polynomial at f[at] drawn from the centred binomial
// distribution with eta = 2 (Algorithm 8) over the 128 bytes of
// PRF(s, n) = SHAKE256(s || n). Each byte gives two coefficients: t holds
// its bits summed in pairs, and a coefficient is one pair sum minus the
// next.
function __cbd(own f: i32[], at: i32, s: [u8], n: i32): i32[] {
  let b: u8[] = crypto.shake256(__copy(__alloc_u8(33), 0, s, 0, 32).with(32, n as u8), 128);
  let i: i32 = 0;
  while (i < 128) {
    let x: i32 = b[i] as i32;
    let t: i32 = (x & 0x55) + (x >> 1 & 0x55);
    f = f.with(at + 2 * i, __csubq((t & 3) - (t >> 2 & 3) + Q));
    f = f.with(at + 2 * i + 1, __csubq((t >> 4 & 3) - (t >> 6 & 3) + Q));
    i = i + 1;
  }
  return f;
}

// __encode is ByteEncode_d (Algorithm 5): count coefficients of d bits from
// f, packed little-endian into out at `at`.
function __encode(own out: u8[], at: i32, f: [i32], count: i32, d: i32): u8[] {
  let acc: i64 = 0;
  let bits: i32 = 0;
  let pos: i32 = at;
  let i: i32 = 0;
  while (i < count) {
    acc = acc | f[i] as i64 << bits;
    bits = bits + d;
    while (bits >= 8) {
      out = out.with(pos, (acc & 255) as u8);
      acc = acc >> 8;
      bits = bits - 8;
      pos = pos + 1;
    }
    i = i + 1;
  }
  return out;
}

// __decode is ByteDecode_d (Algorithm 6) without its reduction mod q:
// count coefficients of d bits from b at `from`.
function __decode(b: [u8], from: i32, count: i32, d: i32): i32[] {
  let f: i32[] = __alloc_i32(count);
  let mask: i64 = (1 as i64 << d) - 1;
  let acc: i64 = 0;
  let bits: i32 = 0;
  let pos: i32 = from;
  let i: i32 = 0;
  while (i < count) {
    while (bits < d) {
      acc = acc | b[pos] as i64 << bits;
      bits = bits + 8;
      pos = pos + 1;
    }
    f = f.with(i, (acc & mask) as i32);
    acc = acc >> d;
    bits = bits - d;
    i = i + 1;
  }
  return f;
}

// __decode12 is ByteDecode_12 of a vector, each coefficient reduced mod q.
function __decode12(b: [u8], from: i32): i32[] {
  let f: i32[] = __decode(b, from, 768, 12);
  let i: i32 = 0;
  while (i < 768) {
    f = f.with(i, __csubq(f[i]));
    i = i + 1;
  }
  return f;
}

// __compress is Compress_d (4.7), round(2^d x / q) mod 2^d, on every
// coefficient of f. The division by q is a multiply by ceil(2^40 / q) and
// a shift, exact for every dividend below 2^24.
function __compress(own f: i32[], d: i32): i32[] {
  let i: i32 = 0;
  while (i < f.len()) {
    let y: i64 = (f[i] as i64 << d) + 1664;
    f = f.with(i, (y * 330282857 >> 40) as i32 & (1 << d) - 1);
    i = i + 1;
  }
  return f;
}

// __decompress is Decompress_d (4.8), round(q y / 2^d), on every
// coefficient of f.
function __decompress(own f: i32[], d: i32): i32[] {
  let i: i32 = 0;
  while (i < f.len()) {
    f = f.with(i, f[i] * Q + (1 << d - 1) >> d);
    i = i + 1;
  }
  return f;
}

// __h is H = SHA3-256 and __g is G = SHA3-512 over a || b.
function __h(b: [u8]): u8[] {
  return crypto.sha3_256_new().update_bytes(b).final_bytes();
}

function __g(a: [u8], b: [u8]): u8[] {
  return crypto.sha3_512_new().update_bytes(a).update_bytes(b).final_bytes();
}

// __keygen is K-PKE.KeyGen inside ML-KEM.KeyGen_internal (Algorithms 13
// and 16).
function __keygen(d: [u8], z: [u8]): KeyPair {
  let rs: u8[] = __g(d, [3 as u8]);
  let rho: [u8] = rs[0:32];
  let sigma: [u8] = rs[32:64];
  let a: i32[] = __matrix(rho, false);
  let s: i32[] = __alloc_i32(768);
  let e: i32[] = __alloc_i32(768);
  let i: i32 = 0;
  while (i < 3) {
    s = __ntt(__cbd(s, 256 * i, sigma, i), 256 * i);
    e = __ntt(__cbd(e, 256 * i, sigma, 3 + i), 256 * i);
    i = i + 1;
  }
  let t: i32[] = __mat_vec(a, s, e);
  let ek: u8[] = __copy(__encode(__alloc_u8(1184), 0, t, 768, 12), 1152, rho, 0, 32);
  let dk: u8[] = __copy(__encode(__alloc_u8(2400), 0, s, 768, 12), 1152, ek, 0, 1184);
  dk = __copy(dk, 2336, __h(ek), 0, 32);
  dk = __copy(dk, 2368, z, 0, 32);
  return KeyPair { encapsulation_key: ek, decapsulation_key: dk };
}

// __encrypt is K-PKE.Encrypt (Algorithm 14) of the message m with
// randomness r, under the key whose t-hat is t and whose seed is rho.
function __encrypt(t: [i32], rho: [u8], m: [u8], r: [u8]): u8[] {
  let at: i32[] = __matrix(rho, true);
  let y: i32[] = __alloc_i32(768);
  let e1: i32[] = __alloc_i32(768);
  let i: i32 = 0;
  while (i < 3) {
    y = __ntt(__cbd(y, 256 * i, r, i), 256 * i);
    e1 = __cbd(e1, 256 * i, r, 3 + i);
    i = i + 1;
  }
  let u: i32[] = __mat_vec(at, y, __zeros(768));
  i = 0;
  while (i < 3) {
    u = __inv_ntt(u, 256 * i);
    i = i + 1;
  }
  u = __add(u, e1, 768);
  let v: i32[] = __inv_ntt(__dot(t, y), 0);
  v = __add(v, __cbd(__alloc_i32(256), 0, r, 6), 256);
  v = __add(v, __decompress(__decode(m, 0, 256, 1), 1), 256);
  let c: u8[] = __encode(__alloc_u8(1088), 0, __compress(u, 10), 768, 10);
  return __encode(c, 960, __compress(v, 4), 256, 4);
}

// __decrypt is K-PKE.Decrypt (Algorithm 15) of c under the secret s-hat.
function __decrypt(s: [i32], c: [u8]): u8[] {
  let u: i32[] = __decompress(__decode(c, 0, 768, 10), 10);
  let i: i32 = 0;
  while (i < 3) {
    u = __ntt(u, 256 * i);
    i = i + 1;
  }
  let w: i32[] = __inv_ntt(__dot(s, u), 0);
  let v: i32[] = __decompress(__decode(c, 960, 256, 4), 4);
  i = 0;
  while (i < 256) {
    v = v.with(i, __csubq(v[i] - w[i] + Q));
    i = i + 1;
  }
  return __encode(__alloc_u8(32), 0, __compress(v, 1), 256, 1);
}

// __same reports whether a and b agree in their first n bytes. Only public
// values are compared with it.
function __same(a: [u8], b: [u8], n: i32): boolean {
  let diff: u8 = 0;
  let i: i32 = 0;
  while (i < n) {
    diff = diff | a[i] ^ b[i];
    i = i + 1;
  }
  return diff == 0;
}

// keygen_derand(d, z) — the key pair ML-KEM.KeyGen_internal derives from
// the 32-byte seeds d and z (FIPS 203, Algorithm 16).
pub function keygen_derand(d: [u8], z: [u8]): Result[KeyPair, MlKemError] {
  if (d.len() != 32) {
    return Err(SeedLength(d.len()));
  }
  if (z.len() != 32) {
    return Err(SeedLength(z.len()));
  }
  return Ok(__keygen(d, z));
}

// encaps_derand(ek, m) — a shared secret and its ciphertext under the
// encapsulation key ek, from the 32-byte message m (Algorithm 17), after
// the modulus check of Algorithm 20: ek must re-encode to itself, which is
// every coefficient below q.
pub function encaps_derand(ek: [u8], m: [u8]): Result[Encapsulation, MlKemError] {
  if (ek.len() != 1184) {
    return Err(EncapsulationKeyLength(ek.len()));
  }
  if (m.len() != 32) {
    return Err(MessageLength(m.len()));
  }
  let t: i32[] = __decode12(ek, 0);
  if (!__same(__encode(__alloc_u8(1152), 0, t, 768, 12), ek, 1152)) {
    return Err(EncapsulationKeyModulus);
  }
  let kr: u8[] = __g(m, __h(ek));
  return Ok(Encapsulation { shared_secret: __copy(__alloc_u8(32), 0, kr, 0, 32), ciphertext: __encrypt(t, ek[1152:1184], m, kr[32:64]) });
}

// decaps(dk, c) — the shared secret the ciphertext c carries under the
// decapsulation key dk (Algorithm 18), after the hash check of Algorithm
// 21. A ciphertext that does not re-encrypt to itself yields
// J(z || c) = SHAKE256(z || c) instead, chosen by mask.
pub function decaps(dk: [u8], c: [u8]): Result[u8[], MlKemError] {
  if (dk.len() != 2400) {
    return Err(DecapsulationKeyLength(dk.len()));
  }
  if (c.len() != 1088) {
    return Err(CiphertextLength(c.len()));
  }
  let ek: [u8] = dk[1152:2336];
  let h: [u8] = dk[2336:2368];
  if (!__same(__h(ek), h, 32)) {
    return Err(DecapsulationKeyHash);
  }
  let m: u8[] = __decrypt(__decode12(dk, 0), c);
  let kr: u8[] = __g(m, h);
  let rejected: u8[] = crypto.shake256_new().update_bytes(dk[2368:2400]).update_bytes(c).reader().squeeze(32).0;
  let again: u8[] = __encrypt(__decode12(ek, 0), ek[1152:1184], m, kr[32:64]);
  let diff: i32 = 0;
  let i: i32 = 0;
  while (i < 1088) {
    diff = diff | (c[i] ^ again[i]) as i32;
    i = i + 1;
  }
  // 255 when c re-encrypted exactly, 0 otherwise.
  let keep: i32 = diff - 1 >> 31 & 255;
  let k: u8[] = __alloc_u8(32);
  i = 0;
  while (i < 32) {
    k = k.with(i, (kr[i] as i32 & keep | rejected[i] as i32 & (keep ^ 255)) as u8);
    i = i + 1;
  }
  return Ok(k);
}
