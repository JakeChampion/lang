// This module implements the X25519 Diffie-Hellman function under RFC 7748.

import "core/int";
import "std/crypto/ed25519";
import "std/crypto/field25519" as fe;
import "std/error";
import "core/cmp";

pub enum X25519Error {
  ScalarLength(i32),
  PointLength(i32),
  LowOrder,
}

pub function (e: X25519Error) to_string(): string {
  return e.message();
}

impl error.Error for X25519Error {}

impl cmp.Display for X25519Error {}

pub function (e: X25519Error) message(): string {
  match (e) {
    ScalarLength(n) => {
      return "x25519: the scalar is " + int.int_to_string(n) + " bytes, want 32";
    },
    PointLength(n) => {
      return "x25519: the point is " + int.int_to_string(n) + " bytes, want 32";
    },
    LowOrder => {
      return "x25519: the peer key is of low order";
    }
  }
  return "";
}

function __ladder(k: [u8], u: fe.Fe): fe.Fe {
  let x2: fe.Fe = fe.from_i64(1);
  let z2: fe.Fe = fe.from_i64(0);
  let x3: fe.Fe = u;
  let z3: fe.Fe = fe.from_i64(1);
  let swap: i64 = 0;
  let t: i32 = 254;
  while (t >= 0) {
    let byte: i64 = k[t / 8] as i64;
    if (t / 8 == 0) {
      byte = byte & 248;
    }
    if (t / 8 == 31) {
      byte = byte & 127 | 64;
    }
    let bit: i64 = byte >> t % 8 & 1;
    swap = swap ^ bit;
    let xs: (fe.Fe, fe.Fe) = fe.cswap(x2, x3, swap);
    let zs: (fe.Fe, fe.Fe) = fe.cswap(z2, z3, swap);
    x2 = xs.0;
    x3 = xs.1;
    z2 = zs.0;
    z3 = zs.1;
    swap = bit;
    let a: fe.Fe = fe.add(x2, z2);
    let aa: fe.Fe = fe.sq(a);
    let b: fe.Fe = fe.sub(x2, z2);
    let bb: fe.Fe = fe.sq(b);
    let e: fe.Fe = fe.sub(aa, bb);
    let c: fe.Fe = fe.add(x3, z3);
    let d: fe.Fe = fe.sub(x3, z3);
    let da: fe.Fe = fe.mul(d, a);
    let cb: fe.Fe = fe.mul(c, b);
    x3 = fe.sq(fe.add(da, cb));
    z3 = fe.mul(u, fe.sq(fe.sub(da, cb)));
    x2 = fe.mul(aa, bb);
    z2 = fe.mul(e, fe.add(aa, fe.mul_small(e, 121665u64)));
    t = t - 1;
  }
  let xs: (fe.Fe, fe.Fe) = fe.cswap(x2, x3, swap);
  let zs: (fe.Fe, fe.Fe) = fe.cswap(z2, z3, swap);
  return fe.mul(xs.0, fe.invert(zs.0));
}

pub function x25519(scalar: [u8], point: [u8]): Result[u8[], X25519Error] {
  if (scalar.len() != 32) {
    return Err(ScalarLength(scalar.len()));
  }
  if (point.len() != 32) {
    return Err(PointLength(point.len()));
  }
  let out: u8[] = fe.to_bytes(__ladder(scalar, fe.from_bytes(point)));
  let any: u8 = 0;
  let i: i32 = 0;
  while (i < 32) {
    any = any | out[i];
    i = i + 1;
  }
  let verdict: u8[] = __alloc_u8(1);
  verdict = verdict.with(0, any);
  __ct_public(verdict);
  if (verdict[0] == 0) {
    return Err(LowOrder);
  }
  return Ok(out);
}

pub function public_key(scalar: [u8]): Result[u8[], X25519Error] {
  if (scalar.len() != 32) {
    return Err(ScalarLength(scalar.len()));
  }
  let k: u8[] = __alloc_u8(32);
  let i: i32 = 0;
  while (i < 32) {
    k = k.with(i, scalar[i]);
    i = i + 1;
  }
  k = k.with(0, k[0] & 248 as u8).with(31, k[31] & 127 as u8 | 64 as u8);
  return Ok(ed25519.montgomery_base(k));
}
