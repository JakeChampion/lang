// std/crypto/x25519 — the X25519 Diffie-Hellman function of RFC 7748.
//
//   let public: u8[] = x25519.public_key(secret)?;
//   let shared: u8[] = x25519.x25519(secret, peer_public)?;
//
// A secret and a public key are 32 bytes. `x25519` refuses a peer key that
// takes the shared secret to all zeros (`LowOrder`), as TLS 1.3 requires.
//
// Constant time by construction: the field arithmetic
// (`std/crypto/field25519`) is ten signed limbs of 26 and 25 bits in `i64`,
// so every product fits; the ladder swaps with a mask, never a branch; and
// the inversion's exponent is a public constant. The valgrind gate
// (`__ct_secret`, docs/TEST-GATES.md) checks this.

import "core/int";
import "std/crypto/field25519" as fe;

// X25519Error — a scalar or a point of the wrong length (the length it had),
// or a peer key whose shared secret is all zeros.
pub enum X25519Error {
  ScalarLength(i32),
  PointLength(i32),
  LowOrder,
}

pub function (e: X25519Error) message(): string {
  match (e) {
    ScalarLength(n) => {
      return "x25519: the scalar is " + int.int_to_string(n) + " bytes, want 32";
    },
    PointLength(n) => {
      return "x25519: the point is " + int.int_to_string(n) + " bytes, want 32";
    },
    LowOrder => {
      return "x25519: the peer key is of low order";
    }
  }
  return "";
}

// __ladder is the u-coordinate of k times the point with u-coordinate u,
// k clamped as RFC 7748 §5 sets out.
function __ladder(k: [u8], u: fe.Fe): fe.Fe {
  let x2: fe.Fe = fe.from_i64(1);
  let z2: fe.Fe = fe.from_i64(0);
  let x3: fe.Fe = u;
  let z3: fe.Fe = fe.from_i64(1);
  let a24: fe.Fe = fe.from_i64(121665);
  let swap: i64 = 0;
  let t: i32 = 254;
  while (t >= 0) {
    let byte: i64 = k[t / 8] as i64;
    if (t / 8 == 0) {
      byte = byte & 248;
    }
    if (t / 8 == 31) {
      byte = byte & 127 | 64;
    }
    let bit: i64 = byte >> t % 8 & 1;
    swap = swap ^ bit;
    let xs: (fe.Fe, fe.Fe) = fe.cswap(x2, x3, swap);
    let zs: (fe.Fe, fe.Fe) = fe.cswap(z2, z3, swap);
    x2 = xs.0;
    x3 = xs.1;
    z2 = zs.0;
    z3 = zs.1;
    swap = bit;
    let a: fe.Fe = fe.add(x2, z2);
    let aa: fe.Fe = fe.sq(a);
    let b: fe.Fe = fe.sub(x2, z2);
    let bb: fe.Fe = fe.sq(b);
    let e: fe.Fe = fe.sub(aa, bb);
    let c: fe.Fe = fe.add(x3, z3);
    let d: fe.Fe = fe.sub(x3, z3);
    let da: fe.Fe = fe.mul(d, a);
    let cb: fe.Fe = fe.mul(c, b);
    x3 = fe.sq(fe.add(da, cb));
    z3 = fe.mul(u, fe.sq(fe.sub(da, cb)));
    x2 = fe.mul(aa, bb);
    z2 = fe.mul(e, fe.add(aa, fe.mul(a24, e)));
    t = t - 1;
  }
  let xs: (fe.Fe, fe.Fe) = fe.cswap(x2, x3, swap);
  let zs: (fe.Fe, fe.Fe) = fe.cswap(z2, z3, swap);
  return fe.mul(xs.0, fe.invert(zs.0));
}

// x25519(scalar, point) — the shared secret of a 32-byte secret scalar and
// a peer's 32-byte public key, refused as `LowOrder` when it is all zeros.
pub function x25519(scalar: [u8], point: [u8]): Result[u8[], X25519Error] {
  if (scalar.len() != 32) {
    return Err(ScalarLength(scalar.len()));
  }
  if (point.len() != 32) {
    return Err(PointLength(point.len()));
  }
  let out: u8[] = fe.to_bytes(__ladder(scalar, fe.from_bytes(point)));
  let any: u8 = 0;
  let i: i32 = 0;
  while (i < 32) {
    any = any | out[i];
    i = i + 1;
  }
  // Whether the secret is all zeros is the one secret-derived value allowed
  // to steer a branch.
  let verdict: u8[] = __alloc_u8(1);
  verdict = verdict.with(0, any);
  __ct_public(verdict);
  if (verdict[0] == 0) {
    return Err(LowOrder);
  }
  return Ok(out);
}

// public_key(scalar) — the public key of a 32-byte secret: the scalar times
// the base point, u = 9.
pub function public_key(scalar: [u8]): Result[u8[], X25519Error] {
  if (scalar.len() != 32) {
    return Err(ScalarLength(scalar.len()));
  }
  return Ok(fe.to_bytes(__ladder(scalar, fe.from_i64(9))));
}
