// std/sim_fetch — a scripted network for std/fetch's client, in virtual
// time.
//
// A `Net` is a `fetch.Transport`: `fetch.send_on(n, req, policy)` runs the
// whole client (lookup, the block list, connect and read bounds, retrying
// a reset, redirects, decoding) against names, listeners and answers a
// test scripts, on the clock of a `sim.Sim`. Nothing waits: a read that
// would block moves the clock to the moment the scripted bytes arrive, or
// by the whole wait when nothing does, so a bound that passes passes at
// its exact virtual time. Under `sim.run_tasks` each move is a park
// (`Sim.advance_to`), so the client's task interleaves with the others,
// and a task cancelled while it waits reads `Abandoned`: the client's
// `Cancelled`.
//
//   let d: sim.Sim = sim.new(1);
//   let n: sim_fetch.Net = sim_fetch.net(d)
//       .host("example.test", ["93.184.216.34"])
//       .listen("93.184.216.34", 80, 5)
//       .route("93.184.216.34", 80, "/", [sim_fetch.reply(200, "hi").after(20)]);
//   let got = fetch.send_on(n, fetch.get("http://example.test/"), policy);
//   // d.now_ns() is 25 ms: 5 to connect, 20 to the first byte.
//
// A name resolves to the addresses `host` gives it, or to itself when it
// is an IP literal; any other name is `NoSuchName`. The addresses are
// raced as `dns.connect_race` races them: each attempt starts the
// fallback delay after the one before, or at once when that one was
// refused, an address with no `listen`er on the port refusing at once;
// the first to finish its connect time wins, and none finishing within
// the client's bound is a timeout at the bound. A bound of zero has
// passed before any attempt starts, so it times out even where every
// address refuses. The request
// written on a connection picks its route by address, port and request
// target (`*` matches any target), and the n-th request a route takes is
// answered with its n-th `Answer`, the last repeating; a request no route
// takes is answered 404, unless a handler `serve`s the address and port:
// then the request is parsed and answered in memory, the way a serve loop
// answers it. A connection answers one request unless its
// answer is `kept()`, or the served request keeps the connection, when it
// stays open for the next one; the `Net`'s `Idle` pool is where the client
// keeps it in between.
//
// The module is std/sim's sibling rather than part of it so that std/sim,
// which reaches nothing but the clock and randomness, does not import the
// client and everything it reaches.

import "std/sim";
import "std/fetch";
import "std/http";
import "std/net";
import "std/dns";
import "std/i64";
import "core/int";
import "std/hex";
import "std/utf8";
import "std/url";
import "std/json";
import "std/headers";

// `Answer` — one scripted response: `bytes` on the wire, the first of
// them `first_ms` after the request was written, then `chunk` bytes at a
// time (all at once when 0) every `chunk_ms`; once all are read the
// connection closes, or stays open and silent when `close` is false.
pub struct Answer { bytes: u8[], first_ms: i64, chunk_ms: i64, chunk: i32, close: boolean }

// `reply(status, body)` — a response with `status`, a `Content-Length`
// and `body`, written at once and followed by a close it announces with
// `Connection: close`.
pub function reply(status: i32, body: string): Answer {
  return raw("HTTP/1.1 " + int.int_to_string(status) + " Status\r\nContent-Length: " + int.int_to_string(body.len()) + CLOSING + body);
}

// `redirect(status, location)` — a 3xx sending the client to `location`,
// followed by a close it announces.
pub function redirect(status: i32, location: string): Answer {
  return raw("HTTP/1.1 " + int.int_to_string(status) + " Status\r\nLocation: " + location + "\r\nContent-Length: 0" + CLOSING);
}

// The end of the header block of an answer that closes after it.
const CLOSING: string = "\r\nConnection: close\r\n\r\n";

// `raw(text)` — `text` on the wire as written, then a close.
pub function raw(text: string): Answer {
  return raw_bytes(text.bytes());
}

// `raw_bytes(bytes)` — `bytes` on the wire as given, then a close.
pub function raw_bytes(bytes: u8[]): Answer {
  return Answer { bytes: bytes, first_ms: 0, chunk_ms: 0, chunk: 0, close: true };
}

// `reset()` — the connection closed before any byte of an answer.
pub function reset(): Answer {
  let none: u8[] = [];
  return raw_bytes(none);
}

// `silent()` — no byte, and no close: the client's bounds end the wait.
pub function silent(): Answer {
  return Answer { ...reset(), close: false };
}

// `a.after(ms)` — `a` with its first byte `ms` after the request.
pub function (a: Answer) after(ms: i64): Answer {
  return Answer { ...a, first_ms: ms };
}

// `a.in_chunks(size, every_ms)` — `a` delivered `size` bytes at a time,
// one chunk every `every_ms` after the first.
pub function (a: Answer) in_chunks(size: i32, every_ms: i64): Answer {
  return Answer { ...a, chunk: size, chunk_ms: every_ms };
}

// `a.held()` — `a` with the connection left open after its last byte.
pub function (a: Answer) held(): Answer {
  return Answer { ...a, close: false };
}

// `a.kept()` — `a` on a persistent connection: its `Connection: close`
// dropped and the connection left open for the next request.
pub function (a: Answer) kept(): Answer {
  let at: i32 = __find_bytes(a.bytes, CLOSING.as_bytes());
  let end: i32 = __find_bytes(a.bytes, "\r\n\r\n".as_bytes());
  if (at < 0 || end < 0 || at + CLOSING.len() != end + 4) {
    return a.held();
  }
  let h: usize = buf_new(a.bytes.len() - CLOSING.len() + 4);
  buf_push_bytes_range(h, a.bytes, 0, at);
  buf_push(h, "\r\n\r\n");
  buf_push_bytes_range(h, a.bytes, at + CLOSING.len(), a.bytes.len());
  let bytes: u8[] = buf_take_bytes(h);
  buf_free(h);
  return Answer { ...a, bytes: bytes, close: false };
}

// `Name` — a host name and the addresses it resolves to, in order.
pub struct Name { host: string, addrs: string[] }

// `Listener` — an address and port that accepts after `connect_ms`.
pub struct Listener { addr: string, port: i32, connect_ms: i64 }

// `Route` — the answers an address and port give a request target, in
// the order requests reach it.
pub struct Route { addr: string, port: i32, path: string, answers: Answer[] }

// `Server` — a handler answering in memory every request `addr:port`
// takes that no route answers; `n.serve` adds one.
pub struct Server { addr: string, port: i32, handler: (HttpRequest) => HttpResponse }

// `Net` — the scripted network, on `drv`'s clock. The builders return a
// new `Net` sharing the same state cells, so a value built once and
// handed to the client records what the client did: the connections
// table, how many requests each route took, every request written, and
// every response a server made.
pub struct Net { drv: sim.Sim, names: Name[], listeners: Listener[], routes: Route[], servers: Server[], conns: Cell[string], hits: Cell[string], sent: Cell[string], made: Cell[string], next: Cell[i32], pool: fetch.Idle }

// `net(drv)` — an empty network on `drv`'s clock: every name unknown and
// every address refusing.
pub function net(drv: sim.Sim): Net {
  let names: Name[] = [];
  let listeners: Listener[] = [];
  let routes: Route[] = [];
  let servers: Server[] = [];
  return Net { drv: drv, names: names, listeners: listeners, routes: routes, servers: servers, conns: cell_new(""), hits: cell_new(""), sent: cell_new(""), made: cell_new(""), next: cell_new(1), pool: fetch.idle() };
}

// `n.pooling(pool)` — `n` keeping the client's idle connections in `pool`
// rather than the default `fetch.idle()`.
pub function (n: Net) pooling(pool: fetch.Idle): Net {
  return Net { ...n, pool: pool };
}

// `n.host(name, addrs)` — `name` resolving to `addrs`.
pub function (n: Net) host(name: string, addrs: string[]): Net {
  return Net { ...n, names: n.names.append(Name { host: name, addrs: addrs }) };
}

// `n.listen(addr, port, connect_ms)` — `addr:port` accepting after
// `connect_ms`.
pub function (n: Net) listen(addr: string, port: i32, connect_ms: i64): Net {
  return Net { ...n, listeners: n.listeners.append(Listener { addr: __canon(addr), port: port, connect_ms: connect_ms }) };
}

// `n.route(addr, port, path, answers)` — the answers `addr:port` gives
// requests for `path` (`*` for any).
pub function (n: Net) route(addr: string, port: i32, path: string, answers: Answer[]): Net {
  return Net { ...n, routes: n.routes.append(Route { addr: __canon(addr), port: port, path: path, answers: answers }) };
}

// `n.serve(addr, port, handler)` — `addr:port` accepting at once and
// answering each request it takes with `handler`, the way a serve loop
// answers it: the request parsed out of the bytes the client wrote, the
// response framed for the request's method, and the connection kept when
// the request keeps it; bytes that are not one whole request are
// answered 400 and the connection closed. A route on the same address
// and port is consulted first. A test runs its routes and middleware
// under the client with no socket:
//
//   n.serve(ORIGIN, 80, (req: HttpRequest): HttpResponse => r.handle(req, plat))
pub function (n: Net) serve(addr: string, port: i32, handler: (HttpRequest) => HttpResponse): Net {
  let listening: Net = n.listen(addr, port, 0);
  return Net { ...listening, servers: listening.servers.append(Server { addr: __canon(addr), port: port, handler: handler }) };
}

// `n.connects()` — how many connections the client opened.
pub function (n: Net) connects(): i32 {
  return n.next.get() - 1;
}

// `n.open()` — how many of them the client has not closed.
pub function (n: Net) open(): i32 {
  let count: i32 = 0;
  for row in __rows(n.conns.get()) {
    if (row[7] == "1") {
      count = count + 1;
    }
  }
  return count;
}

// `n.sent_count()` — how many requests the client wrote.
pub function (n: Net) sent_count(): i32 {
  return __sent_all(n).len();
}

// `n.sent(i)` - the bytes of the i-th write, including any binary body.
// Text callers validate explicitly with utf8.from_bytes.
pub function (n: Net) sent(i: i32): u8[] {
  let all: string[] = __sent_all(n);
  if (i < 0 || i >= all.len()) {
    let none: u8[] = [];
    return none;
  }
  return hex.hex_decode(all[i]);
}

impl fetch.Transport for Net {
  function now_ns(self: Net): i64 {
    return self.drv.clock_ns.get();
  }
  function wall_ms(self: Net): i64 {
    return self.drv.clock_ns.get() / 1000000;
  }
  function lookup(self: Net, host: string, checked: boolean): Result[fetch.Lookup, dns.DnsError] {
    let found: net.IpAddr[] = __addrs_of(self, host);
    if (found.len() == 0) {
      return Err(dns.NoSuchName);
    }
    let none: net.IpAddr[] = [];
    if (!checked) {
      return Ok(fetch.Lookup { dial: found, named: none, judged: none });
    }
    return Ok(fetch.Lookup { dial: found, named: found, judged: found });
  }
  function connect(self: Net, addrs: net.IpAddr[], port: i32, timeout_ms: i32): Result[i32, net.NetError] {
    let fallback_ms: i64 = dns.dial_options().fallback.as_millis();
    let start_ms: i64 = 0;
    let best_ms: i64 = 0 - 1;
    let best: string = "";
    for a in addrs {
      let key: string = a.to_string();
      let delay: i64 = __connect_ms(self, key, port);
      if (delay >= 0) {
        let done_ms: i64 = start_ms + delay;
        if (best_ms < 0 || done_ms < best_ms) {
          best_ms = done_ms;
          best = key;
        }
        start_ms = start_ms + fallback_ms;
      }
    }
    if (timeout_ms <= 0) {
      return Err(net.TimedOut);
    }
    if (best_ms < 0) {
      return Err(net.ConnectionRefused);
    }
    if (best_ms > timeout_ms as i64) {
      if (!self.drv.advance_to(self.drv.clock_ns.get() + timeout_ms as i64 * 1000000)) {
        return Err(net.Interrupted);
      }
      return Err(net.TimedOut);
    }
    if (!self.drv.advance_to(self.drv.clock_ns.get() + best_ms * 1000000)) {
      return Err(net.Interrupted);
    }
    let id: i32 = self.next.get();
    self.next.set(id + 1);
    self.conns.set(self.conns.get() + __row(id, best, port, 0 - 1, 0, 0, 0, 1));
    return Ok(id);
  }
  function write(self: Net, conn: i32, bytes: u8[]): i32 {
    let row: string[] = __conn(self, conn);
    if (row.len() == 0 || row[7] != "1") {
      return 0 - 9;
    }
    // Cell admits strings but not arrays. Encode the shared journal as
    // ASCII instead of keeping arbitrary request bytes in a string.
    let encoded: string = hex.hex_encode(bytes);
    self.sent.set(self.sent.get() + int.int_to_string(encoded.len()) + ":" + encoded);
    if (__busy(self, row)) {
      return bytes.len();
    }
    let port: i32 = __field(row, 2);
    let target: string = __target(bytes);
    let route: i32 = 0 - 2;
    let answer: i32 = 0;
    let i: i32 = 0;
    while (i < self.routes.len()) {
      let r: Route = self.routes[i];
      if (r.addr == row[1] && r.port == port && (r.path == target || r.path == "*")) {
        route = i;
        answer = __took(self, i);
        break;
      }
      i = i + 1;
    }
    if (route == 0 - 2) {
      route = __served(self, row[1], port, bytes);
    }
    let first_ms: i64 = 0;
    if (route >= 0) {
      first_ms = __answer(self, route, answer).first_ms;
    }
    __set_conn(self, conn, __row(conn, row[1], port, route, answer, 0, self.drv.clock_ns.get() + first_ms * 1000000, 1));
    return bytes.len();
  }
  function read(self: Net, conn: i32, max: i32, wait_ms: i64): Result[net.Recv, net.NetError] {
    let row: string[] = __conn(self, conn);
    let now: i64 = self.drv.clock_ns.get();
    let deadline: i64 = now + wait_ms * 1000000;
    let route: i32 = __field(row, 3);
    if (row.len() == 0 || route == 0 - 1) {
      return Ok(__elapsed(self, deadline));
    }
    let a: Answer = __answer(self, route, __field(row, 4));
    let offset: i32 = __field(row, 5);
    if (offset >= a.bytes.len()) {
      if (a.close) {
        let none: u8[] = [];
        return Ok(net.Chunk(none));
      }
      return Ok(__elapsed(self, deadline));
    }
    let ready: i64 = __field64(row, 6);
    if (ready > deadline) {
      return Ok(__elapsed(self, deadline));
    }
    if (!self.drv.advance_to(ready)) {
      return Ok(net.Abandoned);
    }
    let size: i32 = a.bytes.len() - offset;
    if (a.chunk > 0 && a.chunk < size) {
      size = a.chunk;
    }
    if (max < size) {
      size = max;
    }
    let out: u8[] = [];
    let k: i32 = 0;
    while (k < size) {
      out = out.append(a.bytes[offset + k]);
      k = k + 1;
    }
    __set_conn(self, conn, __row(conn, row[1], __field(row, 2), route, __field(row, 4), offset + size, self.drv.clock_ns.get() + a.chunk_ms * 1000000, 1));
    return Ok(net.Chunk(out));
  }
  function close(self: Net, conn: i32): i32 {
    let row: string[] = __conn(self, conn);
    if (row.len() > 0) {
      __set_conn(self, conn, __row(conn, row[1], __field(row, 2), __field(row, 3), __field(row, 4), __field(row, 5), __field64(row, 6), 0));
    }
    return 0;
  }
  function idle(self: Net): fetch.Idle {
    return self.pool;
  }
  function socket(self: Net, conn: i32): i32 {
    return 0 - 1;
  }
}

// === a cassette: recording and replay ====================================
//
// A cassette holds the exchanges a client made, one per line, as a JSON
// object: the request's method and URL, the response's status, its
// headers as [name, value] pairs, and its body as text (`body`), or as
// hex (`body_hex`) when it is not UTF-8. The response is the one the
// client returned, decoded, so `Content-Encoding`, `Content-Length`,
// `Transfer-Encoding` and `Connection` are the wire's and are not kept.
//
//   {"method":"GET","url":"http://api.test/users/7","status":200,"headers":[["content-type","application/json"]],"body":"{\"id\":7}"}
//
// A run against the real upstream records one with `send_taped`; a test
// replays it with `n.replay(cassette)`, which answers each recorded
// request target in recorded order.

// `taped(req, resp)` — the cassette line for one exchange, newline included.
pub function taped(req: fetch.Request, resp: HttpResponse): string {
  let pairs: json.JsonValue[] = [];
  let i: i32 = 0;
  while (i < resp.headers.names.len()) {
    let name: string = resp.headers.names[i].to_lower();
    if (!__wire_only(name)) {
      pairs = pairs.append(json.JArray([json.JString(name), json.JString(resp.headers.values[i])]));
    }
    i = i + 1;
  }
  let keys: string[] = ["method", "url", "status", "headers"];
  let values: json.JsonValue[] = [json.JString(req.method), json.JString(req.url), json.JNumber(int.int_to_string(resp.status)), json.JArray(pairs)];
  let body: u8[] = resp.body_bytes();
  match (utf8.from_bytes(body)) {
    Some(text) => {
      keys = keys.append("body");
      values = values.append(json.JString(text));
    },
    None => {
      keys = keys.append("body_hex");
      values = values.append(json.JString(hex.hex_encode(body)));
    }
  }
  return json.json_encode(json.JObject(json.object_of(keys, values))) + "\n";
}

// `__wire_only(name)` — a response field that frames the wire rather than
// describing the resource, which a replay frames afresh.
function __wire_only(name: string): boolean {
  return name == "content-length" || name == "content-encoding" || name == "transfer-encoding" || name == "connection";
}

// `send_taped(tr, tape, req, policy)` — `fetch.send_on`, appending the
// exchange to `tape` when it answers with a response.
pub function send_taped[T: fetch.Transport](tr: T, tape: Cell[string], req: fetch.Request, policy: fetch.Policy): Result[HttpResponse, fetch.FetchError] {
  match (fetch.send_on(tr, req, policy)) {
    Ok(resp) => {
      tape.set(tape.get() + taped(req, resp));
      return Ok(resp);
    },
    Err(e) => {
      return Err(e);
    }
  }
}

// `n.replay(cassette)` — `n` answering the exchanges `cassette` holds: each
// URL's host resolves to an address of the replay's own (an IP literal to
// itself, any other host to the first of `93.184.216.34` upward that no
// name has), listening at once on the URL's port, and the route for each
// request target answers in recorded order, the last answer repeating.
// The simulated network carries no TLS, so an `https` exchange replays as
// plain `http` on port 80: a program replaying one fetches `http://` for
// the same host. A line that is not an exchange is the error, with the
// line's number from 1.
pub function (n: Net) replay(cassette: string): Result[Net, string] {
  let out: Net = n;
  let line_no: i32 = 0;
  for line in cassette.split("\n") {
    line_no = line_no + 1;
    if (line.len() > 0) {
      match (__exchange(line)) {
        Some(e) => {
          out = __replayed(out, e);
        },
        None => {
          return Err("sim_fetch: cassette line " + int.int_to_string(line_no) + " is not an exchange");
        }
      }
    }
  }
  return Ok(out);
}

// `__Exchange` — one cassette line parsed: where the request went, and
// the answer the replay gives it.
struct __Exchange { host: string, port: i32, target: string, answer: Answer }

function __exchange(line: string): Option[__Exchange] {
  match (json.json_parse(line)) {
    Some(v) => {
      match (v) {
        json.JObject(o) => {
          return __exchange_of(o);
        },
        _ => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
  return None;
}

function __exchange_of(o: json.JsonObject): Option[__Exchange] {
  let method: string = __string_member(o, "method");
  let status: i32 = __int(__string_member(o, "status"));
  let Some(u) = url.url_parse(__string_member(o, "url")) else {
    return None;
  };
  if (method.len() == 0 || status <= 0 || u.host.len() == 0) {
    return None;
  }
  let port: i32 = u.port;
  if (port == 0 || u.scheme == "https") {
    port = 80;
  }
  let target: string = u.path;
  if (target.len() == 0) {
    target = "/";
  }
  if (u.query.len() > 0) {
    target = target + "?" + u.query;
  }
  let resp: HttpResponse = HttpResponse { status: status, body: BodyBytes(__body_member(o)), headers: __headers_member(o), trailers: headers.header_map_new(), background: None };
  return Some(__Exchange { host: u.host, port: port, target: target, answer: raw_bytes(http.http_serialize_response_to_bytes(method, "HTTP/1.1", resp, false)) });
}

// `__string_member(o, key)` — `o`'s `key` as text: a string's text, a
// number's digits, "" for anything else.
function __string_member(o: json.JsonObject, key: string): string {
  match (o.get(key)) {
    Some(v) => {
      match (v) {
        json.JString(s) => {
          return s;
        },
        json.JNumber(digits) => {
          return digits;
        },
        _ => {
          return "";
        }
      }
    },
    None => {
      return "";
    }
  }
  return "";
}

function __headers_member(o: json.JsonObject): HeaderMap {
  let out: HeaderMap = headers.header_map_new();
  match (o.get("headers")) {
    Some(v) => {
      match (v) {
        json.JArray(pairs) => {
          for p in pairs {
            match (p) {
              json.JArray(kv) => {
                if (kv.len() == 2) {
                  out = out.append(__text(kv[0]), __text(kv[1]));
                }
              },
              _ => {}
            }
          }
        },
        _ => {}
      }
    },
    None => {}
  }
  return out;
}

function __text(v: json.JsonValue): string {
  match (v) {
    json.JString(s) => {
      return s;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function __body_member(o: json.JsonObject): u8[] {
  if (o.contains("body_hex")) {
    return hex.hex_decode(__string_member(o, "body_hex"));
  }
  return __string_member(o, "body").bytes();
}

// `__replayed(n, e)` — `n` with `e`'s answer appended to the route its
// target takes, the host named and the port listening when they are not.
function __replayed(n: Net, e: __Exchange): Net {
  let out: Net = n;
  let addr: string = __replay_addr(out, e.host);
  if (__addrs_of(out, e.host).len() == 0) {
    out = out.host(e.host, [addr]);
  }
  if (__connect_ms(out, addr, e.port) < 0) {
    out = out.listen(addr, e.port, 0);
  }
  let i: i32 = 0;
  while (i < out.routes.len()) {
    let r: Route = out.routes[i];
    if (r.addr == addr && r.port == e.port && r.path == e.target) {
      return Net { ...out, routes: out.routes.with(i, Route { ...r, answers: r.answers.append(e.answer) }) };
    }
    i = i + 1;
  }
  return out.route(addr, e.port, e.target, [e.answer]);
}

// `__replay_addr(n, host)` — the address `host` has on `n`: itself when a
// literal, the first it is named to, else the first of `93.184.216.34`
// upward that no name on `n` has.
function __replay_addr(n: Net, host: string): string {
  let known: net.IpAddr[] = __addrs_of(n, host);
  if (known.len() > 0) {
    return known[0].to_string();
  }
  let last: i32 = 34;
  while (last < 255) {
    let candidate: string = "93.184.216." + int.int_to_string(last);
    if (!__addr_named(n, candidate)) {
      return candidate;
    }
    last = last + 1;
  }
  return "93.184.216.255";
}

function __addr_named(n: Net, addr: string): boolean {
  for name in n.names {
    for a in name.addrs {
      if (a == addr) {
        return true;
      }
    }
  }
  return false;
}

// `__busy(n, row)` — whether the connection `row` is still answering a
// request, so a write on it takes no new one: it took one, and has not
// delivered all of a `kept()` answer.
function __busy(n: Net, row: string[]): boolean {
  let route: i32 = __field(row, 3);
  if (route == 0 - 1) {
    return false;
  }
  let a: Answer = __answer(n, route, __field(row, 4));
  return a.close || __field(row, 5) < a.bytes.len();
}

// `__canon(addr)` — `addr` in the one spelling `IpAddr.to_string` gives
// it, so a listener written `::1` matches the address the client dials.
function __canon(addr: string): string {
  match (net.ip_parse(addr)) {
    Some(a) => {
      return a.to_string();
    },
    None => {
      return addr;
    }
  }
  return addr;
}

// `__connect_ms(n, addr, port)` — the connect time of the listener on
// `addr:port`, or -1 when none listens there.
function __connect_ms(n: Net, addr: string, port: i32): i64 {
  for l in n.listeners {
    if (l.addr == addr && l.port == port) {
      return l.connect_ms;
    }
  }
  return 0 - 1;
}

// `__addrs_of(n, host)` — `host` itself when it is an IP literal, else the
// addresses `n` names it.
function __addrs_of(n: Net, host: string): net.IpAddr[] {
  let out: net.IpAddr[] = [];
  match (net.ip_parse(host)) {
    Some(a) => {
      return out.append(a);
    },
    None => {}
  }
  for name in n.names {
    if (name.host == host) {
      for s in name.addrs {
        match (net.ip_parse(s)) {
          Some(a) => {
            out = out.append(a);
          },
          None => {}
        }
      }
    }
  }
  return out;
}

// `__elapsed(n, to_ns)` — a wait passed with nothing at `to_ns`, or
// `Abandoned` when the task waiting was cancelled first.
function __elapsed(n: Net, to_ns: i64): net.Recv {
  if (!n.drv.advance_to(to_ns)) {
    return net.Abandoned;
  }
  return net.Elapsed;
}

// Search the fixed ASCII delimiters without interpreting payload as text.
function __find_bytes(data: [u8], needle: [u8]): i32 {
  let at: i32 = 0;
  while (at <= data.len() - needle.len()) {
    let j: i32 = 0;
    while (j < needle.len() && data[at + j] == needle[j]) {
      j = j + 1;
    }
    if (j == needle.len()) {
      return at;
    }
    at = at + 1;
  }
  return 0 - 1;
}

// `__target(data)` - the request target of the request line `data` starts
// with.
function __target(data: u8[]): string {
  let end: i32 = __find_bytes(data, "\r\n".as_bytes());
  if (end < 0) {
    end = data.len();
  }
  let start: i32 = 0;
  while (start < end && data[start] != 32 as u8) {
    start = start + 1;
  }
  if (start == end) {
    return "";
  }
  start = start + 1;
  let stop: i32 = start;
  while (stop < end && data[stop] != 32 as u8) {
    stop = stop + 1;
  }
  let bytes: u8[] = __alloc_u8(stop - start);
  let i: i32 = 0;
  while (start + i < stop) {
    bytes = bytes.with(i, data[start + i]);
    i = i + 1;
  }
  match (utf8.from_bytes(bytes)) {
    Some(target) => {
      return target;
    },
    None => {
      return "";
    }
  }
}

// `__took(n, route)` — the count of requests `route` had taken before this
// one, counting this one.
function __took(n: Net, route: i32): i32 {
  let counts: string[] = n.hits.get().split(",");
  let out: string = "";
  let before: i32 = 0;
  let i: i32 = 0;
  while (i < n.routes.len()) {
    let c: i32 = 0;
    if (i < counts.len()) {
      c = __int(counts[i]);
    }
    if (i == route) {
      before = c;
      c = c + 1;
    }
    out = out + int.int_to_string(c) + ",";
    i = i + 1;
  }
  n.hits.set(out);
  return before;
}

// `__served(n, addr, port, bytes)` — the request in `bytes` answered by
// the server on `addr:port`, its response journaled in `made` and named
// by the route -3 - k; -2 when no server listens there.
function __served(n: Net, addr: string, port: i32, bytes: u8[]): i32 {
  for s in n.servers {
    if (s.addr == addr && s.port == port) {
      let k: i32 = __journal_all(n.made.get()).len();
      let entry: string = __response_entry(s, bytes);
      n.made.set(n.made.get() + int.int_to_string(entry.len()) + ":" + entry);
      return 0 - 3 - k;
    }
  }
  return 0 - 2;
}

// `__response_entry(s, bytes)` — what `s` writes for the request in
// `bytes`, as ASCII hex behind one byte saying whether the connection
// stays open (`k`) or closes with the response (`c`).
function __response_entry(s: Server, bytes: u8[]): string {
  match (http.http_parse_request_framed(bytes)) {
    http.Framed(f) => {
      let h: (HttpRequest) => HttpResponse = s.handler;
      let resp: HttpResponse = h(f.request);
      let flag: string = "c";
      if (f.keep_alive) {
        flag = "k";
      }
      return flag + hex.hex_encode(http.http_serialize_response_to_bytes(f.request.method, f.version, resp, f.keep_alive));
    },
    http.Incomplete => {
      return __refused_entry();
    },
    http.Continue => {
      return __refused_entry();
    },
    http.Malformed(_) => {
      return __refused_entry();
    }
  }
  return __refused_entry();
}

function __refused_entry(): string {
  return "c" + hex.hex_encode(http.http_serialize_response_conn_bytes(http.text(400, "bad request"), false));
}

// `__answer(n, route, i)` — the answer to `route`'s `i`-th request, the
// last repeating; a server's response when a server made one (a route
// of -3 - k); a 404 when nothing took the request.
function __answer(n: Net, route: i32, i: i32): Answer {
  if (route <= 0 - 3) {
    let entry: string = __journal_all(n.made.get())[0 - 3 - route];
    return Answer { bytes: hex.hex_decode(slice_unchecked(entry, 1, entry.len()).to_owned()), first_ms: 0, chunk_ms: 0, chunk: 0, close: entry[0] == b'c' };
  }
  if (route < 0) {
    return reply(404, "");
  }
  let answers: Answer[] = n.routes[route].answers;
  if (answers.len() == 0) {
    return reply(404, "");
  }
  if (i >= answers.len()) {
    return answers[answers.len() - 1];
  }
  return answers[i];
}

// The connections table: one `;`-ended row per connection, its fields
// split on `|` (an IPv6 address holds `:`): id, address, port, route
// (-1 before a request, -2 when none took it), answer, bytes read, when
// the next bytes are ready (ns), open.
function __row(id: i32, addr: string, port: i32, route: i32, answer: i32, offset: i32, ready_ns: i64, open: i32): string {
  return int.int_to_string(id) + "|" + addr + "|" + int.int_to_string(port) + "|" + int.int_to_string(route) + "|" + int.int_to_string(answer) + "|" + int.int_to_string(offset) + "|" + ready_ns.to_string() + "|" + int.int_to_string(open) + ";";
}

function __rows(table: string): string[][] {
  let rows: string[][] = [];
  for entry in table.split(";") {
    if (entry.len() > 0) {
      rows = rows.append(entry.split("|"));
    }
  }
  return rows;
}

function __conn(n: Net, id: i32): string[] {
  for row in __rows(n.conns.get()) {
    if (__field(row, 0) == id) {
      return row;
    }
  }
  let none: string[] = [];
  return none;
}

function __set_conn(n: Net, id: i32, row: string): i32 {
  let out: string = "";
  for r in __rows(n.conns.get()) {
    if (__field(r, 0) == id) {
      out = out + row;
    } else {
      out = out + __row(__field(r, 0), r[1], __field(r, 2), __field(r, 3), __field(r, 4), __field(r, 5), __field64(r, 6), __field(r, 7));
    }
  }
  n.conns.set(out);
  return 0;
}

function __field(row: string[], i: i32): i32 {
  if (i >= row.len()) {
    return 0;
  }
  return __int(row[i]);
}

function __int(s: string): i32 {
  if (s.len() > 0 && s[0] == b'-') {
    return 0 - __int(s.split("-")[1]);
  }
  match (int.parse_int_radix(s, 10)) {
    Some(v) => {
      return v;
    },
    None => {
      return 0;
    }
  }
  return 0;
}

// `__field64(row, i)` — a non-negative decimal field as an i64.
function __field64(row: string[], i: i32): i64 {
  let v: i64 = 0;
  if (i >= row.len()) {
    return v;
  }
  for b in row[i].bytes() {
    v = v * 10 + (b as i64 - 48);
  }
  return v;
}

// Every write encoded as ASCII hex. The journal frames the encoded text
// with its length and ':', so empty writes remain distinct entries.
function __sent_all(n: Net): string[] {
  return __journal_all(n.sent.get());
}

// `__journal_all(log)` — the entries of a journal of `len:text` frames.
function __journal_all(log: string): string[] {
  let bs: u8[] = log.bytes();
  let out: string[] = [];
  let at: i32 = 0;
  while (at < bs.len()) {
    let len: i32 = 0;
    while (at < bs.len() && bs[at] != 58 as u8) {
      len = len * 10 + (bs[at] as i32 - 48);
      at = at + 1;
    }
    at = at + 1;
    out = out.append(slice_unchecked(log, at, at + len).to_owned());
    at = at + len;
  }
  return out;
}
