// The struct of IDs of each class of this module.
pub struct Classes { context: ContextClass, broadcast_receiver: BroadcastReceiverClass, intent_filter: IntentFilterClass, class: ClassClass, class_loader: ClassLoaderClass }

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let context = match (context_class(e)) {
    Ok(c) => c,
    Err(err) => {
      return Err(err);
    },
  };
  let broadcast_receiver = match (broadcast_receiver_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      return Err(err);
    },
  };
  let intent_filter = match (intent_filter_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      broadcast_receiver.release(e);
      return Err(err);
    },
  };
  let class = match (class_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      broadcast_receiver.release(e);
      intent_filter.release(e);
      return Err(err);
    },
  };
  let class_loader = match (class_loader_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      broadcast_receiver.release(e);
      intent_filter.release(e);
      class.release(e);
      return Err(err);
    },
  };
  return Ok(Classes { context: context, broadcast_receiver: broadcast_receiver, intent_filter: intent_filter, class: class, class_loader: class_loader });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.context.release(e);
  c.broadcast_receiver.release(e);
  c.intent_filter.release(e);
  c.class.release(e);
  c.class_loader.release(e);
}
