// The struct of IDs of each class of this module.
pub struct Classes { key_store: KeyStoreClass, key_generator: KeyGeneratorClass, key_gen_parameter_spec_builder: KeyGenParameterSpec_BuilderClass, cipher: CipherClass, gcmparameter_spec: GCMParameterSpecClass }

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let key_store = match (key_store_class(e)) {
    Ok(c) => c,
    Err(err) => {
      return Err(err);
    },
  };
  let key_generator = match (key_generator_class(e)) {
    Ok(c) => c,
    Err(err) => {
      key_store.release(e);
      return Err(err);
    },
  };
  let key_gen_parameter_spec_builder = match (key_gen_parameter_spec_builder_class(e)) {
    Ok(c) => c,
    Err(err) => {
      key_store.release(e);
      key_generator.release(e);
      return Err(err);
    },
  };
  let cipher = match (cipher_class(e)) {
    Ok(c) => c,
    Err(err) => {
      key_store.release(e);
      key_generator.release(e);
      key_gen_parameter_spec_builder.release(e);
      return Err(err);
    },
  };
  let gcmparameter_spec = match (gcmparameter_spec_class(e)) {
    Ok(c) => c,
    Err(err) => {
      key_store.release(e);
      key_generator.release(e);
      key_gen_parameter_spec_builder.release(e);
      cipher.release(e);
      return Err(err);
    },
  };
  return Ok(Classes { key_store: key_store, key_generator: key_generator, key_gen_parameter_spec_builder: key_gen_parameter_spec_builder, cipher: cipher, gcmparameter_spec: gcmparameter_spec });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.key_store.release(e);
  c.key_generator.release(e);
  c.key_gen_parameter_spec_builder.release(e);
  c.cipher.release(e);
  c.gcmparameter_spec.release(e);
}
