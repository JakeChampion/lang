  made = made.append(uri.class);
  let file = deleted_on_error(e, file_class(e), made)?;
  return Ok(Classes { context: context, download_manager: download_manager, download_manager_request: download_manager_request, download_manager_query: download_manager_query, cursor: cursor, uri: uri, file: file });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.context.release(e);
  c.download_manager.release(e);
  c.download_manager_request.release(e);
  c.download_manager_query.release(e);
  c.cursor.release(e);
  c.uri.release(e);
  c.file.release(e);
}
