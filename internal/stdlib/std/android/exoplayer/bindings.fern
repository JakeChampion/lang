    Err(err) => {
      looper.release(e);
      handler.release(e);
      message.release(e);
      surface.release(e);
      surface_texture.release(e);
      context.release(e);
      list.release(e);
      atomic_long_array.release(e);
      atomic_reference.release(e);
      audio_attributes.release(e);
      audio_attributes_builder.release(e);
      exo_player.release(e);
      exo_player_builder.release(e);
      player.release(e);
      player_listener.release(e);
      player_events.release(e);
      media_item.release(e);
      tracks.release(e);
      tracks_group.release(e);
      track_group.release(e);
      track_selection_parameters.release(e);
      track_selection_parameters_builder.release(e);
      track_selection_override.release(e);
      video_size.release(e);
      playback_exception.release(e);
      audio_capabilities.release(e);
      cue_group.release(e);
      cue.release(e);
      return Err(err);
    },
  };
  return Ok(Classes { looper: looper, handler: handler, message: message, surface: surface, surface_texture: surface_texture, context: context, list: list, atomic_long_array: atomic_long_array, atomic_reference: atomic_reference, audio_attributes: audio_attributes, audio_attributes_builder: audio_attributes_builder, exo_player: exo_player, exo_player_builder: exo_player_builder, player: player, player_listener: player_listener, player_events: player_events, media_item: media_item, tracks: tracks, tracks_group: tracks_group, track_group: track_group, track_selection_parameters: track_selection_parameters, track_selection_parameters_builder: track_selection_parameters_builder, track_selection_override: track_selection_override, video_size: video_size, playback_exception: playback_exception, audio_capabilities: audio_capabilities, cue_group: cue_group, cue: cue, bitmap: bitmap });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.looper.release(e);
  c.handler.release(e);
  c.message.release(e);
  c.surface.release(e);
  c.surface_texture.release(e);
  c.context.release(e);
  c.list.release(e);
  c.atomic_long_array.release(e);
  c.atomic_reference.release(e);
  c.audio_attributes.release(e);
  c.audio_attributes_builder.release(e);
  c.exo_player.release(e);
  c.exo_player_builder.release(e);
  c.player.release(e);
  c.player_listener.release(e);
  c.player_events.release(e);
  c.media_item.release(e);
  c.tracks.release(e);
  c.tracks_group.release(e);
  c.track_group.release(e);
  c.track_selection_parameters.release(e);
  c.track_selection_parameters_builder.release(e);
  c.track_selection_override.release(e);
  c.video_size.release(e);
  c.playback_exception.release(e);
  c.audio_capabilities.release(e);
  c.cue_group.release(e);
  c.cue.release(e);
  c.bitmap.release(e);
}
