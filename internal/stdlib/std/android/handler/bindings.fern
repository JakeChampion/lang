// Typed JNI bindings. std/jni/bind wrote this module. Do not edit it.
import "std/jni";

// A android.os.Looper.
pub struct Looper { ref: usize }

pub function (x: Looper) is_null(): boolean {
  return x.ref == 0 as usize;
}

pub function (x: Looper) object(): jni.Object {
  return jni.Object { ref: x.ref };
}

// The class android.os.Looper and the IDs of its members.
pub struct LooperClass { class: usize, id_get_main_looper: usize }

// One lookup for each member, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function looper_class(e: usize): Result[LooperClass, jni.JavaError] {
  let class = jni.global_class(e, "android/os/Looper")?;
  let id_get_main_looper = jni.checked_id(e, class, jni.get_static_method_id(e, class, "getMainLooper", "()Landroid/os/Looper;"))?;
  return Ok(LooperClass { class: class, id_get_main_looper: id_get_main_looper });
}

// Deletes the reference to the class. Do not use `c` after this call.
pub function (c: LooperClass) release(e: usize): void {
  jni.delete_global_ref(e, c.class);
}

// android.os.Looper.getMainLooper()Landroid/os/Looper;
pub function (c: LooperClass) get_main_looper(e: usize): Result[Looper, jni.JavaError] {
  let args = jni.jvalue_alloc(0);
  let got = jni.invoke(e, jni.CALL_STATIC + 0, c.class, c.id_get_main_looper, args);
  jni.free_buffer(args);
  jni.check(e)?;
  return Ok(Looper { ref: got });
}

