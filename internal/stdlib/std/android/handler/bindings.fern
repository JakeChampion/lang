// android.os.Handler.<init>(Landroid/os/Looper;Landroid/os/Handler$Callback;)V
pub function (c: HandlerClass) new(e: usize, a0: Looper, a1: jni.Object): Result[Handler, jni.JavaError] {
  let args = jni.jvalue_alloc(2);
  jni.jvalue_set_int(args, 0, a0.ref);
  jni.jvalue_set_int(args, 1, a1.ref);
  let got = jni.invoke(e, 30, c.class, c.id_new, args);
  jni.free_buffer(args);
  jni.check(e)?;
  return Ok(Handler { ref: got });
}

// android.os.Handler.obtainMessage(IIILjava/lang/Object;)Landroid/os/Message;
pub function (c: HandlerClass) obtain_message(e: usize, self: Handler, a0: i32, a1: i32, a2: i32, a3: jni.Object): Result[Message, jni.JavaError] {
  let args = jni.jvalue_alloc(4);
  jni.jvalue_set_int(args, 0, a0 as usize);
  jni.jvalue_set_int(args, 1, a1 as usize);
  jni.jvalue_set_int(args, 2, a2 as usize);
  jni.jvalue_set_int(args, 3, a3.ref);
  let got = jni.invoke(e, jni.CALL_METHOD + 0, self.ref, c.id_obtain_message, args);
  jni.free_buffer(args);
  jni.check(e)?;
  return Ok(Message { ref: got });
}

