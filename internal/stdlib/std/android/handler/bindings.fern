// The struct of IDs of each class of this module.
pub struct Classes { looper: LooperClass, handler: HandlerClass, message: MessageClass }

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let looper = match (looper_class(e)) {
    Ok(c) => c,
    Err(err) => {
      return Err(err);
    },
  };
  let handler = match (handler_class(e)) {
    Ok(c) => c,
    Err(err) => {
      looper.release(e);
      return Err(err);
    },
  };
  let message = match (message_class(e)) {
    Ok(c) => c,
    Err(err) => {
      looper.release(e);
      handler.release(e);
      return Err(err);
    },
  };
  return Ok(Classes { looper: looper, handler: handler, message: message });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.looper.release(e);
  c.handler.release(e);
  c.message.release(e);
}
