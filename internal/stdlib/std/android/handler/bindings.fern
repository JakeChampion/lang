pub struct HandlerClass { class: usize, id_new: usize, id_obtain_message: usize }

// One lookup for each member, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function handler_class(e: usize): Result[HandlerClass, jni.JavaError] {
  let class = jni.global_class(e, "android/os/Handler")?;
  let id_new = jni.checked_id(e, class, jni.get_method_id(e, class, "<init>", "(Landroid/os/Looper;Landroid/os/Handler$Callback;)V"))?;
  let id_obtain_message = jni.checked_id(e, class, jni.get_method_id(e, class, "obtainMessage", "(IIILjava/lang/Object;)Landroid/os/Message;"))?;
  return Ok(HandlerClass { class: class, id_new: id_new, id_obtain_message: id_obtain_message });
