pub function (c: Classes) release(e: usize): void {
  c.context.release(e);
  c.class_loader.release(e);
  c.class.release(e);
  c.audio_manager.release(e);
  c.audio_manager_on_audio_focus_change_listener.release(e);
  c.audio_focus_request.release(e);
  c.audio_focus_request_builder.release(e);
