// The struct of IDs of each class of this module.
pub struct Classes { pending_intent: PendingIntentClass, app_widget_manager: AppWidgetManagerClass, component_name: ComponentNameClass, context: ContextClass, intent: IntentClass, package_manager: PackageManagerClass, remote_views: RemoteViewsClass }

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let pending_intent = match (pending_intent_class(e)) {
    Ok(c) => c,
    Err(err) => {
      return Err(err);
    },
  };
  let app_widget_manager = match (app_widget_manager_class(e)) {
    Ok(c) => c,
    Err(err) => {
      pending_intent.release(e);
      return Err(err);
    },
  };
  let component_name = match (component_name_class(e)) {
    Ok(c) => c,
    Err(err) => {
      pending_intent.release(e);
      app_widget_manager.release(e);
      return Err(err);
    },
  };
  let context = match (context_class(e)) {
    Ok(c) => c,
    Err(err) => {
      pending_intent.release(e);
      app_widget_manager.release(e);
      component_name.release(e);
      return Err(err);
    },
  };
  let intent = match (intent_class(e)) {
    Ok(c) => c,
    Err(err) => {
      pending_intent.release(e);
      app_widget_manager.release(e);
      component_name.release(e);
      context.release(e);
      return Err(err);
    },
  };
  let package_manager = match (package_manager_class(e)) {
    Ok(c) => c,
    Err(err) => {
      pending_intent.release(e);
      app_widget_manager.release(e);
      component_name.release(e);
      context.release(e);
      intent.release(e);
      return Err(err);
    },
  };
  let remote_views = match (remote_views_class(e)) {
    Ok(c) => c,
    Err(err) => {
      pending_intent.release(e);
      app_widget_manager.release(e);
      component_name.release(e);
      context.release(e);
      intent.release(e);
      package_manager.release(e);
      return Err(err);
    },
  };
  return Ok(Classes { pending_intent: pending_intent, app_widget_manager: app_widget_manager, component_name: component_name, context: context, intent: intent, package_manager: package_manager, remote_views: remote_views });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.pending_intent.release(e);
  c.app_widget_manager.release(e);
  c.component_name.release(e);
  c.context.release(e);
  c.intent.release(e);
  c.package_manager.release(e);
  c.remote_views.release(e);
}
