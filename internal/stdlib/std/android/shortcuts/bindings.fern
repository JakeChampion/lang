// The struct of IDs of each class of this module.
pub struct Classes { activity: ActivityClass, component_name: ComponentNameClass, context: ContextClass, intent: IntentClass, shortcut_info: ShortcutInfoClass, shortcut_info_builder: ShortcutInfo_BuilderClass, shortcut_manager: ShortcutManagerClass, array_list: ArrayListClass, list: ListClass }

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let activity = match (activity_class(e)) {
    Ok(c) => c,
    Err(err) => {
      return Err(err);
    },
  };
  let component_name = match (component_name_class(e)) {
    Ok(c) => c,
    Err(err) => {
      activity.release(e);
      return Err(err);
    },
  };
  let context = match (context_class(e)) {
    Ok(c) => c,
    Err(err) => {
      activity.release(e);
      component_name.release(e);
      return Err(err);
    },
  };
  let intent = match (intent_class(e)) {
    Ok(c) => c,
    Err(err) => {
      activity.release(e);
      component_name.release(e);
      context.release(e);
      return Err(err);
    },
  };
  let shortcut_info = match (shortcut_info_class(e)) {
    Ok(c) => c,
    Err(err) => {
      activity.release(e);
      component_name.release(e);
      context.release(e);
      intent.release(e);
      return Err(err);
    },
  };
  let shortcut_info_builder = match (shortcut_info_builder_class(e)) {
    Ok(c) => c,
    Err(err) => {
      activity.release(e);
      component_name.release(e);
      context.release(e);
      intent.release(e);
      shortcut_info.release(e);
      return Err(err);
    },
  };
  let shortcut_manager = match (shortcut_manager_class(e)) {
    Ok(c) => c,
    Err(err) => {
      activity.release(e);
      component_name.release(e);
      context.release(e);
      intent.release(e);
      shortcut_info.release(e);
      shortcut_info_builder.release(e);
      return Err(err);
    },
  };
  let array_list = match (array_list_class(e)) {
    Ok(c) => c,
    Err(err) => {
      activity.release(e);
      component_name.release(e);
      context.release(e);
      intent.release(e);
      shortcut_info.release(e);
      shortcut_info_builder.release(e);
      shortcut_manager.release(e);
      return Err(err);
    },
  };
  let list = match (list_class(e)) {
    Ok(c) => c,
    Err(err) => {
      activity.release(e);
      component_name.release(e);
      context.release(e);
      intent.release(e);
      shortcut_info.release(e);
      shortcut_info_builder.release(e);
      shortcut_manager.release(e);
      array_list.release(e);
      return Err(err);
    },
  };
  return Ok(Classes { activity: activity, component_name: component_name, context: context, intent: intent, shortcut_info: shortcut_info, shortcut_info_builder: shortcut_info_builder, shortcut_manager: shortcut_manager, array_list: array_list, list: list });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.activity.release(e);
  c.component_name.release(e);
  c.context.release(e);
  c.intent.release(e);
  c.shortcut_info.release(e);
  c.shortcut_info_builder.release(e);
  c.shortcut_manager.release(e);
  c.array_list.release(e);
  c.list.release(e);
}
