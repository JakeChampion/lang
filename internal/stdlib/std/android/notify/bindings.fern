  return Ok(Intent { ref: got });
}

// The struct of IDs of each class of this module.
pub struct Classes { notification: NotificationClass, notification_builder: Notification_BuilderClass, notification_channel: NotificationChannelClass, notification_manager: NotificationManagerClass, pending_intent: PendingIntentClass, context: ContextClass, intent: IntentClass, package_manager: PackageManagerClass }

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let notification = match (notification_class(e)) {
    Ok(c) => c,
    Err(err) => {
      return Err(err);
    },
  };
  let notification_builder = match (notification_builder_class(e)) {
    Ok(c) => c,
    Err(err) => {
      notification.release(e);
      return Err(err);
    },
  };
  let notification_channel = match (notification_channel_class(e)) {
    Ok(c) => c,
    Err(err) => {
      notification.release(e);
      notification_builder.release(e);
      return Err(err);
    },
  };
  let notification_manager = match (notification_manager_class(e)) {
    Ok(c) => c,
    Err(err) => {
      notification.release(e);
      notification_builder.release(e);
      notification_channel.release(e);
      return Err(err);
    },
  };
  let pending_intent = match (pending_intent_class(e)) {
    Ok(c) => c,
    Err(err) => {
      notification.release(e);
      notification_builder.release(e);
      notification_channel.release(e);
      notification_manager.release(e);
      return Err(err);
    },
  };
  let context = match (context_class(e)) {
    Ok(c) => c,
    Err(err) => {
      notification.release(e);
      notification_builder.release(e);
      notification_channel.release(e);
      notification_manager.release(e);
      pending_intent.release(e);
      return Err(err);
    },
  };
  let intent = match (intent_class(e)) {
    Ok(c) => c,
    Err(err) => {
      notification.release(e);
      notification_builder.release(e);
      notification_channel.release(e);
      notification_manager.release(e);
      pending_intent.release(e);
      context.release(e);
      return Err(err);
    },
  };
  let package_manager = match (package_manager_class(e)) {
    Ok(c) => c,
    Err(err) => {
      notification.release(e);
      notification_builder.release(e);
      notification_channel.release(e);
      notification_manager.release(e);
      pending_intent.release(e);
      context.release(e);
      intent.release(e);
      return Err(err);
    },
  };
  return Ok(Classes { notification: notification, notification_builder: notification_builder, notification_channel: notification_channel, notification_manager: notification_manager, pending_intent: pending_intent, context: context, intent: intent, package_manager: package_manager });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.notification.release(e);
  c.notification_builder.release(e);
  c.notification_channel.release(e);
  c.notification_manager.release(e);
  c.pending_intent.release(e);
  c.context.release(e);
  c.intent.release(e);
  c.package_manager.release(e);
}
