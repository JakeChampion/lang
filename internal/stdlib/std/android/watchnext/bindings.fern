pub function (c: Classes) release(e: usize): void {
  c.context.release(e);
  c.content_resolver.release(e);
  c.content_values.release(e);
  c.package_manager.release(e);
  c.cursor.release(e);
  c.uri.release(e);
  c.tv_contract.release(e);
  c.long.release(e);
}
