// The struct of IDs of each class of this module.
pub struct Classes { context: ContextClass, content_resolver: ContentResolverClass, content_values: ContentValuesClass, package_manager: PackageManagerClass, uri: UriClass, tv_contract: TvContractClass, long: LongClass }

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let context = match (context_class(e)) {
    Ok(c) => c,
    Err(err) => {
      return Err(err);
    },
  };
  let content_resolver = match (content_resolver_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      return Err(err);
    },
  };
  let content_values = match (content_values_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      content_resolver.release(e);
      return Err(err);
    },
  };
  let package_manager = match (package_manager_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      content_resolver.release(e);
      content_values.release(e);
      return Err(err);
    },
  };
  let uri = match (uri_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      content_resolver.release(e);
      content_values.release(e);
      package_manager.release(e);
      return Err(err);
    },
  };
  let tv_contract = match (tv_contract_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      content_resolver.release(e);
      content_values.release(e);
      package_manager.release(e);
      uri.release(e);
      return Err(err);
    },
  };
  let long = match (long_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      content_resolver.release(e);
      content_values.release(e);
      package_manager.release(e);
      uri.release(e);
      tv_contract.release(e);
      return Err(err);
    },
  };
  return Ok(Classes { context: context, content_resolver: content_resolver, content_values: content_values, package_manager: package_manager, uri: uri, tv_contract: tv_contract, long: long });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.context.release(e);
  c.content_resolver.release(e);
  c.content_values.release(e);
  c.package_manager.release(e);
  c.uri.release(e);
  c.tv_contract.release(e);
  c.long.release(e);
}
