// Typed JNI bindings. std/jni/bind wrote this module. Do not edit it.
import "std/jni";

// A android.content.Context.
pub struct Context { ref: usize }

pub function (x: Context) is_null(): boolean {
  return x.ref == 0 as usize;
}

pub function (x: Context) object(): jni.Object {
  return jni.Object { ref: x.ref };
}

// The class android.content.Context and the IDs of its members.
pub struct ContextClass { class: usize, id_get_package_name: usize }

// One lookup for each member, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function context_class(e: usize): Result[ContextClass, jni.JavaError] {
  let local = jni.find_class(e, "android/content/Context");
  jni.check(e)?;
  let class = jni.new_global_ref(e, local);
  jni.delete_local_ref(e, local);
  let id_get_package_name = jni.checked_id(e, class, jni.get_method_id(e, class, "getPackageName", "()Ljava/lang/String;"))?;
  return Ok(ContextClass { class: class, id_get_package_name: id_get_package_name });
}

// Deletes the reference to the class. Do not use `c` after this call.
pub function (c: ContextClass) release(e: usize): void {
  jni.delete_global_ref(e, c.class);
}

// android.content.Context.getPackageName()Ljava/lang/String;
pub function (c: ContextClass) get_package_name(e: usize, self: Context): Result[string, jni.JavaError] {
  let args = jni.jvalue_alloc(0);
  let got = jni.invoke(e, jni.CALL_METHOD + 0, self.ref, c.id_get_package_name, args);
  jni.free_buffer(args);
  jni.check(e)?;
  let text = jni.string_of(e, got);
  jni.delete_local_ref(e, got);
  return Ok(text);
}

// The struct of IDs of each class of this module.
pub struct Classes { context: ContextClass }

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let context = match (context_class(e)) {
    Ok(c) => c,
    Err(err) => {
      return Err(err);
    },
  };
  return Ok(Classes { context: context });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.context.release(e);
}
