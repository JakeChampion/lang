// The struct of IDs of each class of this module.
pub struct Classes { context: ContextClass, activity: ActivityClass, file: FileClass, intent: IntentClass, package_manager: PackageManagerClass, key_character_map: KeyCharacterMapClass, settings_system: Settings_SystemClass, audio_manager: AudioManagerClass, time_zone: TimeZoneClass, resources: ResourcesClass, configuration: ConfigurationClass, locale_list: LocaleListClass }

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let context = match (context_class(e)) {
    Ok(c) => c,
    Err(err) => {
      return Err(err);
    },
  };
  let activity = match (activity_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      return Err(err);
    },
  };
  let file = match (file_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      return Err(err);
    },
  };
  let intent = match (intent_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      file.release(e);
      return Err(err);
    },
  };
  let package_manager = match (package_manager_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      file.release(e);
      intent.release(e);
      return Err(err);
    },
  };
  let key_character_map = match (key_character_map_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      file.release(e);
      intent.release(e);
      package_manager.release(e);
      return Err(err);
    },
  };
  let settings_system = match (settings_system_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      file.release(e);
      intent.release(e);
      package_manager.release(e);
      key_character_map.release(e);
      return Err(err);
    },
  };
  let audio_manager = match (audio_manager_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      file.release(e);
      intent.release(e);
      package_manager.release(e);
      key_character_map.release(e);
      settings_system.release(e);
      return Err(err);
    },
  };
  let time_zone = match (time_zone_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      file.release(e);
      intent.release(e);
      package_manager.release(e);
      key_character_map.release(e);
      settings_system.release(e);
      audio_manager.release(e);
      return Err(err);
    },
  };
  let resources = match (resources_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      file.release(e);
      intent.release(e);
      package_manager.release(e);
      key_character_map.release(e);
      settings_system.release(e);
      audio_manager.release(e);
      time_zone.release(e);
      return Err(err);
    },
  };
  let configuration = match (configuration_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      file.release(e);
      intent.release(e);
      package_manager.release(e);
      key_character_map.release(e);
      settings_system.release(e);
      audio_manager.release(e);
      time_zone.release(e);
      resources.release(e);
      return Err(err);
    },
  };
  let locale_list = match (locale_list_class(e)) {
    Ok(c) => c,
    Err(err) => {
      context.release(e);
      activity.release(e);
      file.release(e);
      intent.release(e);
      package_manager.release(e);
      key_character_map.release(e);
      settings_system.release(e);
      audio_manager.release(e);
      time_zone.release(e);
      resources.release(e);
      configuration.release(e);
      return Err(err);
    },
  };
  return Ok(Classes { context: context, activity: activity, file: file, intent: intent, package_manager: package_manager, key_character_map: key_character_map, settings_system: settings_system, audio_manager: audio_manager, time_zone: time_zone, resources: resources, configuration: configuration, locale_list: locale_list });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.context.release(e);
  c.activity.release(e);
  c.file.release(e);
  c.intent.release(e);
  c.package_manager.release(e);
  c.key_character_map.release(e);
  c.settings_system.release(e);
  c.audio_manager.release(e);
  c.time_zone.release(e);
  c.resources.release(e);
  c.configuration.release(e);
  c.locale_list.release(e);
}
