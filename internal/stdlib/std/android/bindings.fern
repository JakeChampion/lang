// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.context.release(e);
  c.activity.release(e);
  c.file.release(e);
  c.intent.release(e);
  c.package_manager.release(e);
  c.key_character_map.release(e);
  c.settings_system.release(e);
  c.audio_manager.release(e);
  c.time_zone.release(e);
  c.resources.release(e);
  c.configuration.release(e);
  c.locale_list.release(e);
  c.window.release(e);
  c.view.release(e);
  c.view_on_apply_window_insets_listener.release(e);
  c.window_insets.release(e);
  c.window_insets_type.release(e);
  c.insets.release(e);
  c.on_back_invoked_dispatcher.release(e);
  c.on_back_invoked_callback.release(e);
  c.window_manager.release(e);
  c.window_manager_layout_params.release(e);
  c.display.release(e);
  c.display_mode.release(e);
  c.picture_in_picture_params_builder.release(e);
  c.rational.release(e);
  c.input_device.release(e);
  c.system.release(e);
  c.build_version.release(e);
}
