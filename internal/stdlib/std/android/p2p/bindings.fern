  made = made.append(class.class);
  let class_loader = deleted_on_error(e, class_loader_class(e), made)?;
  return Ok(Classes { context: context, broadcast_receiver: broadcast_receiver, intent: intent, intent_filter: intent_filter, looper: looper, parcelable: parcelable, wifi_p2p_manager: wifi_p2p_manager, wifi_p2p_manager_channel: wifi_p2p_manager_channel, wifi_p2p_manager_channel_listener: wifi_p2p_manager_channel_listener, wifi_p2p_manager_action_listener: wifi_p2p_manager_action_listener, wifi_p2p_config: wifi_p2p_config, wifi_p2p_device_list: wifi_p2p_device_list, wifi_p2p_device: wifi_p2p_device, wifi_p2p_info: wifi_p2p_info, inet_address: inet_address, collection: collection, class: class, class_loader: class_loader });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.context.release(e);
  c.broadcast_receiver.release(e);
  c.intent.release(e);
  c.intent_filter.release(e);
  c.looper.release(e);
  c.parcelable.release(e);
  c.wifi_p2p_manager.release(e);
  c.wifi_p2p_manager_channel.release(e);
  c.wifi_p2p_manager_channel_listener.release(e);
  c.wifi_p2p_manager_action_listener.release(e);
  c.wifi_p2p_config.release(e);
  c.wifi_p2p_device_list.release(e);
  c.wifi_p2p_device.release(e);
  c.wifi_p2p_info.release(e);
  c.inet_address.release(e);
  c.collection.release(e);
  c.class.release(e);
  c.class_loader.release(e);
}
