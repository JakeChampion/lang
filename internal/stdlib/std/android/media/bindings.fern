  jni.delete_global_ref(e, c.class);
}

// A java.util.List.
pub struct List { ref: usize }

pub function (x: List) is_null(): boolean {
  return x.ref == 0 as usize;
}

pub function (x: List) object(): jni.Object {
  return jni.Object { ref: x.ref };
}

pub function (x: List) as_collection(): Collection {
  return Collection { ref: x.ref };
}

// The class java.util.List and the IDs of its members.
pub struct ListClass { class: usize }

// One lookup for each member, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function list_class(e: usize): Result[ListClass, jni.JavaError] {
  let class = jni.global_class(e, "java/util/List")?;
  return Ok(ListClass { class: class });
}

// Deletes the reference to the class. Do not use `c` after this call.
pub function (c: ListClass) release(e: usize): void {
  jni.delete_global_ref(e, c.class);
}

// The struct of IDs of each class of this module.
pub struct Classes { activity: ActivityClass, pending_intent: PendingIntentClass, content_resolver: ContentResolverClass, content_uris: ContentUrisClass, context: ContextClass, intent: IntentClass, intent_sender: IntentSenderClass, cursor: CursorClass, uri: UriClass, media_store: MediaStoreClass, media_store_audio_media: MediaStore_Audio_MediaClass, output_stream: OutputStreamClass, collections: CollectionsClass, collection: CollectionClass, list: ListClass }

// `r`, after the deletion of the classes `made` if `r` is an error.
function deleted_on_error[T](e: usize, own r: Result[T, jni.JavaError], made: usize[]): Result[T, jni.JavaError] {
  if let Err(_) = r {
    for class in made {
      jni.delete_global_ref(e, class);
    }
  }
  return r;
}

// Makes the struct of IDs of each class. Call it one time, and call
// `release` when the app does not call Java again. One lookup for each
// class, and each one can fail.
// fern-lint: allow cyclomatic-complexity
pub function classes(e: usize): Result[Classes, jni.JavaError] {
  let made: usize[] = [];
  let activity = deleted_on_error(e, activity_class(e), made)?;
  made = made.append(activity.class);
  let pending_intent = deleted_on_error(e, pending_intent_class(e), made)?;
  made = made.append(pending_intent.class);
  let content_resolver = deleted_on_error(e, content_resolver_class(e), made)?;
  made = made.append(content_resolver.class);
  let content_uris = deleted_on_error(e, content_uris_class(e), made)?;
  made = made.append(content_uris.class);
  let context = deleted_on_error(e, context_class(e), made)?;
  made = made.append(context.class);
  let intent = deleted_on_error(e, intent_class(e), made)?;
  made = made.append(intent.class);
  let intent_sender = deleted_on_error(e, intent_sender_class(e), made)?;
  made = made.append(intent_sender.class);
  let cursor = deleted_on_error(e, cursor_class(e), made)?;
  made = made.append(cursor.class);
  let uri = deleted_on_error(e, uri_class(e), made)?;
  made = made.append(uri.class);
  let media_store = deleted_on_error(e, media_store_class(e), made)?;
  made = made.append(media_store.class);
  let media_store_audio_media = deleted_on_error(e, media_store_audio_media_class(e), made)?;
  made = made.append(media_store_audio_media.class);
  let output_stream = deleted_on_error(e, output_stream_class(e), made)?;
  made = made.append(output_stream.class);
  let collections = deleted_on_error(e, collections_class(e), made)?;
  made = made.append(collections.class);
  let collection = deleted_on_error(e, collection_class(e), made)?;
  made = made.append(collection.class);
  let list = deleted_on_error(e, list_class(e), made)?;
  return Ok(Classes { activity: activity, pending_intent: pending_intent, content_resolver: content_resolver, content_uris: content_uris, context: context, intent: intent, intent_sender: intent_sender, cursor: cursor, uri: uri, media_store: media_store, media_store_audio_media: media_store_audio_media, output_stream: output_stream, collections: collections, collection: collection, list: list });
}

// Deletes the reference to each class. Do not use `c` after this call.
pub function (c: Classes) release(e: usize): void {
  c.activity.release(e);
  c.pending_intent.release(e);
  c.content_resolver.release(e);
  c.content_uris.release(e);
  c.context.release(e);
  c.intent.release(e);
  c.intent_sender.release(e);
  c.cursor.release(e);
  c.uri.release(e);
  c.media_store.release(e);
  c.media_store_audio_media.release(e);
  c.output_stream.release(e);
  c.collections.release(e);
  c.collection.release(e);
  c.list.release(e);
}
