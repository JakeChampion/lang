// std/ordmap — a persistent, ordered map with structural sharing.
//
// `OrdMap[K, V]` is a weight-balanced binary tree (Adams's bounded-
// balance trees, the shape behind Haskell's Data.Map) keyed by any
// `core/cmp.Ord` type. Every operation is value-returning:
//
//   import "std/ordmap";
//   let m: ordmap.OrdMap[string, i32] = ordmap.ordmap_new();
//   m = m.insert("b", 2);
//   m = m.insert("a", 1);
//   let snapshot: ordmap.OrdMap[string, i32] = m;   // O(1), shares every node
//   m = m.insert("c", 3);                           // snapshot is unchanged
//   m.get("a");          // Some(1)
//   m.keys();            // ["a", "b", "c"]  (always in key order)
//   snapshot.len();      // 2
//
// # Two paths, one API
//
// An update rebuilds the O(log n) nodes on the path to the key and
// shares everything else with the input. Which of two things happens
// to those path nodes is decided by the compiler, not by this module:
//
//   - **Shared** (another binding still holds the input, as `snapshot`
//     above): the path nodes are freshly allocated and the input is
//     left intact — the classic persistent structure, O(log n) per
//     update, O(1) snapshot.
//   - **Unique** (the input's binding dies at the call, as in
//     `m = m.insert(k, v)`): the reference-counting reuse pass writes
//     the new nodes into the old nodes' boxes in place, so the same
//     source line allocates nothing at all.
//
// So `m = m.insert(k, v)` in a loop costs what a mutable balanced tree
// costs, and taking a snapshot first costs one pointer copy. Neither
// path needs a transient/builder API, and there is no `own` on the
// receiver: an `own` receiver would forbid `let m2 = m.insert(k, v)`
// (E051), which is the whole point of a persistent map.
//
// # Ordering and equality
//
// Keys are ordered by the bound's `cmp` method, never the `<` operator
// (which resolves through a `Type.cmp` lookup not visible from this
// module, #6846), so a `@derive(cmp.Ord)` struct or enum works as a
// key. Two keys are the same key when `cmp` returns 0. Iteration —
// `for (k, v) in m`, `keys()`, `values()`, `fold`, `for_each` — is always
// in ascending key order, and `key_at(i)` / `index_of(k)` give O(log n) rank access
// because every node stores the size of its subtree.
//
// # Complexity
//
//   insert / get / contains / remove / min / max / key_at / index_of
//     O(log n)
//   union / intersection / difference        O(m log(n/m + 1))
//     (split-and-join, Blelloch et al. "Just Join for Parallel
//      Ordered Sets"), so merging a small map into a large one is
//      O(m log n) rather than O(n + m).
//   keys / values / fold / for_each / filter / map_values   O(n)
//   iter                                                     O(n)
//   from_arrays                                              O(n log n)
//
// The balance parameters are delta = 3, ratio = 2 (Hirai & Yamamoto,
// "Balancing weight-balanced trees", 2011), the pair proven correct
// for every rebalancing shape join-based union produces.
import "core/cmp";
import "core/iter";

// The map is the tree. `Bin` is (left, key, value, right, size); `Tip`
// is the empty tree. The size field makes `len()` O(1) and rank queries
// O(log n). Construct one only through `ordmap_new` / `from_arrays`.
pub enum OrdMap[K, V] { Tip, Bin(OrdMap[K, V], K, V, OrdMap[K, V], i32) }

// `ordmap_new()` — the empty map. The key and value types are fixed by
// the annotation at the binding (`let m: OrdMap[string, i32] =
// ordmap_new();`).
pub function ordmap_new[K, V](): OrdMap[K, V] {
  let e: OrdMap[K, V] = Tip;
  return e;
}

// `from_arrays(keys, values)` — the map holding `keys[i] -> values[i]`
// for every i. A key repeated in `keys` takes its LAST value. The two
// arrays must have the same length; extra entries in the longer one are
// ignored.
pub function from_arrays[K: cmp.Ord, V](keys: K[], values: V[]): OrdMap[K, V] {
  let m: OrdMap[K, V] = ordmap_new();
  let n: i32 = keys.len();
  if (values.len() < n) {
    n = values.len();
  }
  let i: i32 = 0;
  while (i < n) {
    m = m.insert(keys[i], values[i]);
    i = i + 1;
  }
  return m;
}

// ---- node helpers ---------------------------------------------------
function node_size[K, V](t: OrdMap[K, V]): i32 {
  match (t) {
    Tip => {
      return 0;
    },
    Bin(l, k, v, r, s) => {
      return s;
    }
  }
}

// node_bin builds a node from already-balanced children.
function node_bin[K, V](l: OrdMap[K, V], k: K, v: V, r: OrdMap[K, V]): OrdMap[K, V] {
  return Bin(l, k, v, r, node_size(l) + node_size(r) + 1);
}

function node_single[K, V](k: K, v: V): OrdMap[K, V] {
  let e: OrdMap[K, V] = Tip;
  return Bin(e, k, v, e, 1);
}

// node_rotate_l: the right subtree is too heavy. A single rotation when
// its inner child is light, a double rotation otherwise.
function node_rotate_l[K, V](l: OrdMap[K, V], k: K, v: V, r: OrdMap[K, V]): OrdMap[K, V] {
  match (r) {
    Tip => {
      return node_bin(l, k, v, r);
    },
    Bin(rl, rk, rv, rr, rs) => {
      if (node_size(rl) < 2 * node_size(rr)) {
        let nl: OrdMap[K, V] = node_bin(l, k, v, rl);
        return node_bin(nl, rk, rv, rr);
      }
      match (rl) {
        Tip => {
          let nl: OrdMap[K, V] = node_bin(l, k, v, rl);
          return node_bin(nl, rk, rv, rr);
        },
        Bin(rll, rlk, rlv, rlr, rls) => {
          let nl: OrdMap[K, V] = node_bin(l, k, v, rll);
          let nr: OrdMap[K, V] = node_bin(rlr, rk, rv, rr);
          return node_bin(nl, rlk, rlv, nr);
        }
      }
    }
  }
}

// node_rotate_r: mirror of node_rotate_l for a too-heavy left subtree.
function node_rotate_r[K, V](l: OrdMap[K, V], k: K, v: V, r: OrdMap[K, V]): OrdMap[K, V] {
  match (l) {
    Tip => {
      return node_bin(l, k, v, r);
    },
    Bin(ll, lk, lv, lr, ls) => {
      if (node_size(lr) < 2 * node_size(ll)) {
        let nr: OrdMap[K, V] = node_bin(lr, k, v, r);
        return node_bin(ll, lk, lv, nr);
      }
      match (lr) {
        Tip => {
          let nr: OrdMap[K, V] = node_bin(lr, k, v, r);
          return node_bin(ll, lk, lv, nr);
        },
        Bin(lrl, lrk, lrv, lrr, lrs) => {
          let nl: OrdMap[K, V] = node_bin(ll, lk, lv, lrl);
          let nr: OrdMap[K, V] = node_bin(lrr, k, v, r);
          return node_bin(nl, lrk, lrv, nr);
        }
      }
    }
  }
}

// node_balance restores the weight invariant after one child changed
// size by at most one element (insert / delete) — the precondition for
// a single (possibly double) rotation to suffice.
function node_balance[K, V](l: OrdMap[K, V], k: K, v: V, r: OrdMap[K, V]): OrdMap[K, V] {
  let sl: i32 = node_size(l);
  let sr: i32 = node_size(r);
  if (sl + sr <= 1) {
    return Bin(l, k, v, r, sl + sr + 1);
  }
  if (sr > 3 * sl) {
    return node_rotate_l(l, k, v, r);
  }
  if (sl > 3 * sr) {
    return node_rotate_r(l, k, v, r);
  }
  return Bin(l, k, v, r, sl + sr + 1);
}

function node_insert[K: cmp.Ord, V](t: OrdMap[K, V], k: K, v: V): OrdMap[K, V] {
  match (t) {
    Tip => {
      return node_single(k, v);
    },
    Bin(l, nk, nv, r, s) => {
      let c: i32 = k.cmp(nk);
      if (c < 0) {
        let nl: OrdMap[K, V] = node_insert(l, k, v);
        return node_balance(nl, nk, nv, r);
      }
      if (c > 0) {
        let nr: OrdMap[K, V] = node_insert(r, k, v);
        return node_balance(l, nk, nv, nr);
      }
      return Bin(l, k, v, r, s);
    }
  }
}

// node_find returns the node holding `k`, or Tip. Iterative, so a
// lookup never recurses.
function node_find[K: cmp.Ord, V](t: OrdMap[K, V], k: K): OrdMap[K, V] {
  let cur: OrdMap[K, V] = t;
  let searching: boolean = true;
  while (searching) {
    match (cur) {
      Tip => {
        searching = false;
      },
      Bin(l, nk, nv, r, s) => {
        let c: i32 = k.cmp(nk);
        if (c == 0) {
          return cur;
        }
        if (c < 0) {
          cur = l;
        } else {
          cur = r;
        }
      }
    }
  }
  return cur;
}

// node_min_node / node_max_node return the leftmost / rightmost node
// (Tip for an empty tree).
function node_min_node[K, V](t: OrdMap[K, V]): OrdMap[K, V] {
  let cur: OrdMap[K, V] = t;
  let walking: boolean = true;
  while (walking) {
    match (cur) {
      Tip => {
        walking = false;
      },
      Bin(l, k, v, r, s) => {
        match (l) {
          Tip => {
            return cur;
          },
          Bin(ll, lk, lv, lr, ls) => {
            cur = l;
          }
        }
      }
    }
  }
  return cur;
}

function node_max_node[K, V](t: OrdMap[K, V]): OrdMap[K, V] {
  let cur: OrdMap[K, V] = t;
  let walking: boolean = true;
  while (walking) {
    match (cur) {
      Tip => {
        walking = false;
      },
      Bin(l, k, v, r, s) => {
        match (r) {
          Tip => {
            return cur;
          },
          Bin(rl, rk, rv, rr, rs) => {
            cur = r;
          }
        }
      }
    }
  }
  return cur;
}

function node_delete_min[K, V](t: OrdMap[K, V]): OrdMap[K, V] {
  match (t) {
    Tip => {
      return t;
    },
    Bin(l, k, v, r, s) => {
      match (l) {
        Tip => {
          return r;
        },
        Bin(ll, lk, lv, lr, ls) => {
          let nl: OrdMap[K, V] = node_delete_min(l);
          return node_balance(nl, k, v, r);
        }
      }
    }
  }
}

function node_delete_max[K, V](t: OrdMap[K, V]): OrdMap[K, V] {
  match (t) {
    Tip => {
      return t;
    },
    Bin(l, k, v, r, s) => {
      match (r) {
        Tip => {
          return l;
        },
        Bin(rl, rk, rv, rr, rs) => {
          let nr: OrdMap[K, V] = node_delete_max(r);
          return node_balance(l, k, v, nr);
        }
      }
    }
  }
}

// node_glue joins two trees whose sizes differ by at most a constant
// factor and whose keys are already separated (every key of `l` is
// below every key of `r`), by lifting the larger side's extreme
// element to the root.
function node_glue[K, V](l: OrdMap[K, V], r: OrdMap[K, V]): OrdMap[K, V] {
  match (l) {
    Tip => {
      return r;
    },
    Bin(ll, lk, lv, lr, ls) => {
      match (r) {
        Tip => {
          return l;
        },
        Bin(rl, rk, rv, rr, rs) => {
          if (ls > rs) {
            match (node_max_node(l)) {
              Tip => {
                return r;
              },
              Bin(ml, mk, mv, mr, ms) => {
                let nl: OrdMap[K, V] = node_delete_max(l);
                return node_balance(nl, mk, mv, r);
              }
            }
          }
          match (node_min_node(r)) {
            Tip => {
              return l;
            },
            Bin(ml, mk, mv, mr, ms) => {
              let nr: OrdMap[K, V] = node_delete_min(r);
              return node_balance(l, mk, mv, nr);
            }
          }
        }
      }
    }
  }
}

function node_delete[K: cmp.Ord, V](t: OrdMap[K, V], k: K): OrdMap[K, V] {
  match (t) {
    Tip => {
      return t;
    },
    Bin(l, nk, nv, r, s) => {
      let c: i32 = k.cmp(nk);
      if (c < 0) {
        let nl: OrdMap[K, V] = node_delete(l, k);
        return node_balance(nl, nk, nv, r);
      }
      if (c > 0) {
        let nr: OrdMap[K, V] = node_delete(r, k);
        return node_balance(l, nk, nv, nr);
      }
      return node_glue(l, r);
    }
  }
}

// ---- join / split (the set-algebra core) ----------------------------
function node_insert_min[K, V](k: K, v: V, t: OrdMap[K, V]): OrdMap[K, V] {
  match (t) {
    Tip => {
      return node_single(k, v);
    },
    Bin(l, nk, nv, r, s) => {
      let nl: OrdMap[K, V] = node_insert_min(k, v, l);
      return node_balance(nl, nk, nv, r);
    }
  }
}

function node_insert_max[K, V](k: K, v: V, t: OrdMap[K, V]): OrdMap[K, V] {
  match (t) {
    Tip => {
      return node_single(k, v);
    },
    Bin(l, nk, nv, r, s) => {
      let nr: OrdMap[K, V] = node_insert_max(k, v, r);
      return node_balance(l, nk, nv, nr);
    }
  }
}

// node_join builds the tree (l, k, v, r) for ARBITRARY sizes of `l` and
// `r` (every key of `l` below `k`, every key of `r` above): descend the
// heavier side until the two are within the balance bound, then rebuild.
function node_join[K, V](l: OrdMap[K, V], k: K, v: V, r: OrdMap[K, V]): OrdMap[K, V] {
  match (l) {
    Tip => {
      return node_insert_min(k, v, r);
    },
    Bin(ll, lk, lv, lr, ls) => {
      match (r) {
        Tip => {
          return node_insert_max(k, v, l);
        },
        Bin(rl, rk, rv, rr, rs) => {
          if (3 * ls < rs) {
            let nl: OrdMap[K, V] = node_join(l, k, v, rl);
            return node_balance(nl, rk, rv, rr);
          }
          if (3 * rs < ls) {
            let nr: OrdMap[K, V] = node_join(lr, k, v, r);
            return node_balance(ll, lk, lv, nr);
          }
          return Bin(l, k, v, r, ls + rs + 1);
        }
      }
    }
  }
}

// node_merge concatenates two key-separated trees of arbitrary size
// (the keyless node_join).
function node_merge[K, V](l: OrdMap[K, V], r: OrdMap[K, V]): OrdMap[K, V] {
  match (l) {
    Tip => {
      return r;
    },
    Bin(ll, lk, lv, lr, ls) => {
      match (r) {
        Tip => {
          return l;
        },
        Bin(rl, rk, rv, rr, rs) => {
          if (3 * ls < rs) {
            let nl: OrdMap[K, V] = node_merge(l, rl);
            return node_balance(nl, rk, rv, rr);
          }
          if (3 * rs < ls) {
            let nr: OrdMap[K, V] = node_merge(lr, r);
            return node_balance(ll, lk, lv, nr);
          }
          return node_glue(l, r);
        }
      }
    }
  }
}

// A split of a tree around a key: the entries below it, the node
// holding it (Tip when absent), and the entries above it.
struct OrdSplit[K, V] { lt: OrdMap[K, V], hit: OrdMap[K, V], gt: OrdMap[K, V] }

function node_split[K: cmp.Ord, V](t: OrdMap[K, V], k: K): OrdSplit[K, V] {
  match (t) {
    Tip => {
      return OrdSplit { lt: t, hit: t, gt: t };
    },
    Bin(l, nk, nv, r, s) => {
      let c: i32 = k.cmp(nk);
      if (c < 0) {
        let sp: OrdSplit[K, V] = node_split(l, k);
        let gt: OrdMap[K, V] = node_join(sp.gt, nk, nv, r);
        return OrdSplit { lt: sp.lt, hit: sp.hit, gt: gt };
      }
      if (c > 0) {
        let sp: OrdSplit[K, V] = node_split(r, k);
        let lt: OrdMap[K, V] = node_join(l, nk, nv, sp.lt);
        return OrdSplit { lt: lt, hit: sp.hit, gt: sp.gt };
      }
      return OrdSplit { lt: l, hit: t, gt: r };
    }
  }
}

// node_union is left-biased: a key in both keeps `a`'s value.
function node_union[K: cmp.Ord, V](a: OrdMap[K, V], b: OrdMap[K, V]): OrdMap[K, V] {
  match (a) {
    Tip => {
      return b;
    },
    Bin(al, ak, av, ar, asz) => {
      match (b) {
        Tip => {
          return a;
        },
        Bin(bl, bk, bv, br, bsz) => {
          let sp: OrdSplit[K, V] = node_split(b, ak);
          let l: OrdMap[K, V] = node_union(al, sp.lt);
          let r: OrdMap[K, V] = node_union(ar, sp.gt);
          return node_join(l, ak, av, r);
        }
      }
    }
  }
}

// node_intersection keeps `a`'s values for the keys present in both.
function node_intersection[K: cmp.Ord, V](a: OrdMap[K, V], b: OrdMap[K, V]): OrdMap[K, V] {
  match (a) {
    Tip => {
      return a;
    },
    Bin(al, ak, av, ar, asz) => {
      match (b) {
        Tip => {
          return b;
        },
        Bin(bl, bk, bv, br, bsz) => {
          let sp: OrdSplit[K, V] = node_split(b, ak);
          let l: OrdMap[K, V] = node_intersection(al, sp.lt);
          let r: OrdMap[K, V] = node_intersection(ar, sp.gt);
          match (sp.hit) {
            Tip => {
              return node_merge(l, r);
            },
            Bin(hl, hk, hv, hr, hs) => {
              return node_join(l, ak, av, r);
            }
          }
        }
      }
    }
  }
}

// node_difference drops from `a` every key present in `b`.
function node_difference[K: cmp.Ord, V](a: OrdMap[K, V], b: OrdMap[K, V]): OrdMap[K, V] {
  match (a) {
    Tip => {
      return a;
    },
    Bin(al, ak, av, ar, asz) => {
      match (b) {
        Tip => {
          return a;
        },
        Bin(bl, bk, bv, br, bsz) => {
          let sp: OrdSplit[K, V] = node_split(a, bk);
          let l: OrdMap[K, V] = node_difference(sp.lt, bl);
          let r: OrdMap[K, V] = node_difference(sp.gt, br);
          return node_merge(l, r);
        }
      }
    }
  }
}

// ---- traversals -------------------------------------------------------
//
// The accumulator-threading helpers take their array as `own` and are
// called in the self-reassigning form `acc = f(t, acc)`, so the append
// runs on a uniquely-held buffer and grows it in place rather than
// copying it at every node.
function node_keys_into[K, V](t: OrdMap[K, V], own acc: K[]): K[] {
  match (t) {
    Tip => {
      return acc;
    },
    Bin(l, k, v, r, s) => {
      acc = node_keys_into(l, acc);
      acc = acc.append(k);
      acc = node_keys_into(r, acc);
      return acc;
    }
  }
}

function node_values_into[K, V](t: OrdMap[K, V], own acc: V[]): V[] {
  match (t) {
    Tip => {
      return acc;
    },
    Bin(l, k, v, r, s) => {
      acc = node_values_into(l, acc);
      acc = acc.append(v);
      acc = node_values_into(r, acc);
      return acc;
    }
  }
}

function node_entries_into[K, V](t: OrdMap[K, V], own acc: (K, V)[]): (K, V)[] {
  match (t) {
    Tip => {
      return acc;
    },
    Bin(l, k, v, r, s) => {
      acc = node_entries_into(l, acc);
      acc = acc.append((k, v));
      acc = node_entries_into(r, acc);
      return acc;
    }
  }
}

function node_fold[K, V, A](t: OrdMap[K, V], init: A, f: (A, K, V) => A): A {
  match (t) {
    Tip => {
      return init;
    },
    Bin(l, k, v, r, s) => {
      let a: A = node_fold(l, init, f);
      a = f(a, k, v);
      return node_fold(r, a, f);
    }
  }
}

function node_for_each[K, V](t: OrdMap[K, V], f: (K, V) => void): void {
  match (t) {
    Tip => {
      return;
    },
    Bin(l, k, v, r, s) => {
      node_for_each(l, f);
      f(k, v);
      node_for_each(r, f);
    }
  }
}

// node_map_values rebuilds the tree with every value transformed; the
// shape (and so the balance) is unchanged.
function node_map_values[K, V, W](t: OrdMap[K, V], f: (V) => W): OrdMap[K, W] {
  match (t) {
    Tip => {
      let e: OrdMap[K, W] = Tip;
      return e;
    },
    Bin(l, k, v, r, s) => {
      let nl: OrdMap[K, W] = node_map_values(l, f);
      let nr: OrdMap[K, W] = node_map_values(r, f);
      return Bin(nl, k, f(v), nr, s);
    }
  }
}

// node_filter keeps the entries the predicate accepts, joining the
// surviving halves around each kept key.
function node_filter[K, V](t: OrdMap[K, V], pred: (K, V) => boolean): OrdMap[K, V] {
  match (t) {
    Tip => {
      return t;
    },
    Bin(l, k, v, r, s) => {
      let fl: OrdMap[K, V] = node_filter(l, pred);
      let fr: OrdMap[K, V] = node_filter(r, pred);
      if (pred(k, v)) {
        return node_join(fl, k, v, fr);
      }
      return node_merge(fl, fr);
    }
  }
}

// node_at returns the node of rank `i` (0-based, in key order), Tip
// when out of range.
function node_at[K, V](t: OrdMap[K, V], i: i32): OrdMap[K, V] {
  let cur: OrdMap[K, V] = t;
  let want: i32 = i;
  if (want < 0) {
    let e: OrdMap[K, V] = Tip;
    return e;
  }
  let walking: boolean = true;
  while (walking) {
    match (cur) {
      Tip => {
        walking = false;
      },
      Bin(l, k, v, r, s) => {
        let sl: i32 = node_size(l);
        if (want < sl) {
          cur = l;
        } else if (want == sl) {
          return cur;
        } else {
          want = want - sl - 1;
          cur = r;
        }
      }
    }
  }
  return cur;
}

// node_index_of returns the rank of `k`, or -1 when absent.
function node_index_of[K: cmp.Ord, V](t: OrdMap[K, V], k: K): i32 {
  let cur: OrdMap[K, V] = t;
  let below: i32 = 0;
  let walking: boolean = true;
  while (walking) {
    match (cur) {
      Tip => {
        walking = false;
      },
      Bin(l, nk, nv, r, s) => {
        let c: i32 = k.cmp(nk);
        if (c == 0) {
          return below + node_size(l);
        }
        if (c < 0) {
          cur = l;
        } else {
          below = below + node_size(l) + 1;
          cur = r;
        }
      }
    }
  }
  return 0 - 1;
}

// node_ordered: every key of `l` is below `k` and every key of `r` above
// it (checked at the extremes, which is enough once the children are
// themselves valid).
function node_ordered[K: cmp.Ord, V](l: OrdMap[K, V], k: K, r: OrdMap[K, V]): boolean {
  match (node_max_node(l)) {
    Tip => {},
    Bin(ml, mk, mv, mr, ms) => {
      if (mk >= k) {
        return false;
      }
    }
  }
  match (node_min_node(r)) {
    Tip => {},
    Bin(ml, mk, mv, mr, ms) => {
      if (mk <= k) {
        return false;
      }
    }
  }
  return true;
}

// node_valid checks the ordering, size, and balance invariants over the
// whole tree — the test hook behind `is_valid()`.
function node_valid[K: cmp.Ord, V](t: OrdMap[K, V]): boolean {
  match (t) {
    Tip => {
      return true;
    },
    Bin(l, k, v, r, s) => {
      let sl: i32 = node_size(l);
      let sr: i32 = node_size(r);
      if (s != sl + sr + 1) {
        return false;
      }
      if (sl + sr > 1 && (sr > 3 * sl || sl > 3 * sr)) {
        return false;
      }
      if (!node_ordered(l, k, r)) {
        return false;
      }
      return node_valid(l) && node_valid(r);
    }
  }
}

// ---- public surface ---------------------------------------------------
// `len()` — the number of entries. O(1).
pub function (m: OrdMap[K, V]) len(): i32 {
  return node_size(m);
}

// `is_empty()` — true when there are no entries.
pub function (m: OrdMap[K, V]) is_empty(): boolean {
  return node_size(m) == 0;
}

// `insert(k, v)` — the map with `k -> v`; an existing `k` takes the new
// value. Never touches the receiver's nodes, so a snapshot taken
// before the call is unchanged after it.
pub function (m: OrdMap[K, V]) insert[K: cmp.Ord, V](k: K, v: V): OrdMap[K, V] {
  return node_insert(m, k, v);
}

// `remove(k)` — the map without `k`; the receiver unchanged when `k`
// is absent.
pub function (m: OrdMap[K, V]) remove[K: cmp.Ord, V](k: K): OrdMap[K, V] {
  return node_delete(m, k);
}

// `get(k)` — `Some(value)` when `k` is present.
pub function (m: OrdMap[K, V]) get[K: cmp.Ord, V](k: K): Option[V] {
  match (node_find(m, k)) {
    Tip => {
      return None;
    },
    Bin(l, nk, nv, r, s) => {
      return Some(nv);
    }
  }
}

// `get_or(k, fallback)` — the value at `k`, or `fallback`.
pub function (m: OrdMap[K, V]) get_or[K: cmp.Ord, V](k: K, fallback: V): V {
  match (node_find(m, k)) {
    Tip => {
      return fallback;
    },
    Bin(l, nk, nv, r, s) => {
      return nv;
    }
  }
}

// `contains(k)` — is `k` a key?
pub function (m: OrdMap[K, V]) contains[K: cmp.Ord, V](k: K): boolean {
  match (node_find(m, k)) {
    Tip => {
      return false;
    },
    Bin(l, nk, nv, r, s) => {
      return true;
    }
  }
}

// `update(k, f)` — the map with the value at `k` replaced by `f(old)`;
// the receiver unchanged when `k` is absent.
pub function (m: OrdMap[K, V]) update[K: cmp.Ord, V](k: K, f: (V) => V): OrdMap[K, V] {
  match (node_find(m, k)) {
    Tip => {
      return m;
    },
    Bin(l, nk, nv, r, s) => {
      return node_insert(m, k, f(nv));
    }
  }
}

// `min_key()` / `max_key()` — the smallest / largest key. O(log n).
pub function (m: OrdMap[K, V]) min_key(): Option[K] {
  match (node_min_node(m)) {
    Tip => {
      return None;
    },
    Bin(l, k, v, r, s) => {
      return Some(k);
    }
  }
}

pub function (m: OrdMap[K, V]) max_key(): Option[K] {
  match (node_max_node(m)) {
    Tip => {
      return None;
    },
    Bin(l, k, v, r, s) => {
      return Some(k);
    }
  }
}

// `remove_min()` / `remove_max()` — the map without its smallest /
// largest entry (unchanged when empty).
pub function (m: OrdMap[K, V]) remove_min(): OrdMap[K, V] {
  return node_delete_min(m);
}

pub function (m: OrdMap[K, V]) remove_max(): OrdMap[K, V] {
  return node_delete_max(m);
}

// `key_at(i)` / `value_at(i)` — the entry of rank `i` (0-based, in key
// order); `None` when out of range. O(log n).
pub function (m: OrdMap[K, V]) key_at(i: i32): Option[K] {
  match (node_at(m, i)) {
    Tip => {
      return None;
    },
    Bin(l, k, v, r, s) => {
      return Some(k);
    }
  }
}

pub function (m: OrdMap[K, V]) value_at(i: i32): Option[V] {
  match (node_at(m, i)) {
    Tip => {
      return None;
    },
    Bin(l, k, v, r, s) => {
      return Some(v);
    }
  }
}

// `index_of(k)` — the rank of `k` in key order, or -1 when absent.
pub function (m: OrdMap[K, V]) index_of[K: cmp.Ord, V](k: K): i32 {
  return node_index_of(m, k);
}

// `keys()` / `values()` — the entries in ascending key order.
pub function (m: OrdMap[K, V]) keys(): K[] {
  let acc: K[] = [];
  acc = node_keys_into(m, acc);
  return acc;
}

pub function (m: OrdMap[K, V]) values(): V[] {
  let acc: V[] = [];
  acc = node_values_into(m, acc);
  return acc;
}

// `iter()` — an Iterator over the `(key, value)` entries in key order,
// which is what `for (k, v) in m` walks.
pub function (m: OrdMap[K, V]) iter(): iter.ArrayIter[(K, V)] {
  let acc: (K, V)[] = [];
  acc = node_entries_into(m, acc);
  return iter.of(acc);
}

// `fold(init, f)` — `f(f(f(init, k0, v0), k1, v1), …)` in key order.
pub function (m: OrdMap[K, V]) fold[K, V, A](init: A, f: (A, K, V) => A): A {
  return node_fold(m, init, f);
}

// `for_each(f)` — call `f(k, v)` on every entry in key order.
pub function (m: OrdMap[K, V]) for_each(f: (K, V) => void): void {
  node_for_each(m, f);
}

// `map_values(f)` — the map with every value replaced by `f(value)`;
// keys and shape are unchanged, so this is O(n) with no rebalancing.
pub function (m: OrdMap[K, V]) map_values[K, V, W](f: (V) => W): OrdMap[K, W] {
  return node_map_values(m, f);
}

// `filter(pred)` — the map of the entries `pred(k, v)` accepts.
pub function (m: OrdMap[K, V]) filter(pred: (K, V) => boolean): OrdMap[K, V] {
  return node_filter(m, pred);
}

// `union(other)` — every entry of both; a key in both keeps THIS map's
// value. O(m log(n/m + 1)).
pub function (m: OrdMap[K, V]) union[K: cmp.Ord, V](other: OrdMap[K, V]): OrdMap[K, V] {
  return node_union(m, other);
}

// `intersection(other)` — the entries whose key is in both, with THIS
// map's values.
pub function (m: OrdMap[K, V]) intersection[K: cmp.Ord, V](other: OrdMap[K, V]): OrdMap[K, V] {
  return node_intersection(m, other);
}

// `difference(other)` — this map's entries whose key is NOT in `other`.
pub function (m: OrdMap[K, V]) difference[K: cmp.Ord, V](other: OrdMap[K, V]): OrdMap[K, V] {
  return node_difference(m, other);
}

// `split(k)` — the entries below `k` and the entries above it, as two
// maps (an entry AT `k` is in neither). O(log n).
pub function (m: OrdMap[K, V]) split_lt[K: cmp.Ord, V](k: K): OrdMap[K, V] {
  let sp: OrdSplit[K, V] = node_split(m, k);
  return sp.lt;
}

pub function (m: OrdMap[K, V]) split_gt[K: cmp.Ord, V](k: K): OrdMap[K, V] {
  let sp: OrdSplit[K, V] = node_split(m, k);
  return sp.gt;
}

// `is_valid()` — do the ordering, size, and balance invariants hold
// over every node? Always true for a map built through this module;
// exposed for tests and for anyone porting the balance rules.
pub function (m: OrdMap[K, V]) is_valid[K: cmp.Ord, V](): boolean {
  return node_valid(m);
}
