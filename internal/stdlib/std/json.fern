// std/json — JSON encode / decode over the `JsonValue` enum,
// which an importer names `json.JsonValue`.
//
// `json_encode(v)` walks the `JsonValue` tree and produces
// canonical JSON text. `json_parse(s)` is the inverse —
// recursive descent returning `Option[JsonValue]` (None on any
// malformed input).
//
// Numbers are stored verbatim as `JNumber`'s string payload;
// the responsibility for valid numeric formatting sits with
// the caller. String escapes are decoded on parse (`\"`,
// `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`, `\uXXXX` for BMP
// code points). Surrogate pairs aren't combined yet.
//
// No prelude: these are in scope only after a program
// declares `import "std/json";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

// === JSON encoding ===
//
// `json_encode(v)` walks the `JsonValue` tree and produces
// the canonical JSON text. Strings are escape-
// encoded; arrays / objects recurse. Numbers emit their
// payload string verbatim — the responsibility for valid
// numeric formatting sits with the caller.

// A large object's index hashes its keys as Map does.
import "core/map";
// String / byte methods inside the encoder / parser bodies.
import "std/string";
import "std/i32";
// Numeric `to_string` for the `impl Json for <int>` serialisers.
import "std/i64";
import "std/u32";
import "std/u64";
// Float `to_string` for the `impl Json for f32 / f64` serialisers.
import "std/f64";
import "std/error";
import "core/cmp";

// JsonValue is a JSON document. A number keeps its text, since JSON fixes no
// precision; `s.parse_int()` / `s.parse_float()` read it.
pub enum JsonValue {
  JNull,
  JBool(boolean),
  JNumber(string),
  JString(string),
  JArray(JsonValue[]),
  JObject(JsonObject),
}

// JsonObject is a JSON object's members in document order, one per key. One
// of more than JSON_LINEAR_MAX members also carries `index`, a power-of-two
// open-addressed table of member position + 1 (0 is empty) by seeded key
// hash, sized for half load; a smaller one is searched linearly.
pub struct JsonObject { names: string[], items: JsonValue[], index: i32[] }

const JSON_LINEAR_MAX: i32 = 8;

// object is the empty JSON object.
pub function object(): JsonObject {
  return JsonObject { names: [], items: [], index: [] };
}

// object_of is the object of parallel `keys` and `values`. A repeated key keeps
// its first position and takes its last value, as repeated `insert`s would.
pub function object_of(keys: string[], values: JsonValue[]): JsonObject {
  let n: i32 = keys.len();
  if (n <= JSON_LINEAR_MAX) {
    let i: i32 = 1;
    while (i < n) {
      if (__json_linear_find(keys, i, keys[i]) >= 0) {
        return __json_dedupe(keys, values);
      }
      i = i + 1;
    }
    return JsonObject { names: keys, items: values, index: [] };
  }
  let index: i32[] = __json_index_new(n);
  let seed: i32 = __map_hash_seed();
  let i: i32 = 0;
  while (i < n) {
    let slot: i32 = __json_index_slot(index, keys, keys[i], seed);
    if (index[slot] != 0) {
      return __json_dedupe(keys, values);
    }
    index = index.with(slot, i + 1);
    i = i + 1;
  }
  return JsonObject { names: keys, items: values, index: index };
}

// __json_dedupe rebuilds an object whose keys repeat by inserting each member.
function __json_dedupe(keys: string[], values: JsonValue[]): JsonObject {
  let o: JsonObject = object();
  let i: i32 = 0;
  while (i < keys.len()) {
    o = o.insert(keys[i], values[i]);
    i = i + 1;
  }
  return o;
}

// __json_linear_find is the position of `key` among `keys[0..n)`, or -1.
function __json_linear_find(keys: string[], n: i32, key: string): i32 {
  let i: i32 = 0;
  while (i < n) {
    if (keys[i] == key) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

// __json_index_new is an empty index for `n` members: the least power of two
// of at least 2n slots.
function __json_index_new(n: i32): i32[] {
  let cap: i32 = 16;
  while (cap < 2 * n) {
    cap = cap * 2;
  }
  let index: i32[] = [];
  while (index.len() < cap) {
    index = index.append(0);
  }
  return index;
}

// __json_index_slot is the slot of `index` that holds `key`, or the empty slot
// it would take.
function __json_index_slot(index: i32[], keys: string[], key: string, seed: i32): i32 {
  let mask: i32 = index.len() - 1;
  let h: i32 = __map_fnv_str_seeded(key, seed) & mask;
  while (true) {
    let at: i32 = index[h];
    if (at == 0 || keys[at - 1] == key) {
      return h;
    }
    h = h + 1 & mask;
  }
  return h;
}

// __json_index_of is `keys[0..n)` indexed.
function __json_index_of(keys: string[], n: i32): i32[] {
  let index: i32[] = __json_index_new(n);
  let seed: i32 = __map_hash_seed();
  let i: i32 = 0;
  while (i < n) {
    index = index.with(__json_index_slot(index, keys, keys[i], seed), i + 1);
    i = i + 1;
  }
  return index;
}

// position is where `key` is among the object's members, or -1.
pub function (o: JsonObject) position(key: string): i32 {
  if (o.index.len() == 0) {
    return __json_linear_find(o.names, o.names.len(), key);
  }
  return o.index[__json_index_slot(o.index, o.names, key, __map_hash_seed())] - 1;
}

pub function (o: JsonObject) len(): i32 {
  return o.names.len();
}

pub function (o: JsonObject) is_empty(): boolean {
  return o.names.len() == 0;
}

pub function (o: JsonObject) contains(key: string): boolean {
  return o.position(key) >= 0;
}

pub function (o: JsonObject) get(key: string): Option[JsonValue] {
  let at: i32 = o.position(key);
  if (at < 0) {
    return None;
  }
  return Some(o.items[at]);
}

pub function (o: JsonObject) get_or(key: string, fallback: JsonValue): JsonValue {
  let at: i32 = o.position(key);
  if (at < 0) {
    return fallback;
  }
  return o.items[at];
}

// insert is the object with `key` bound to `value`: in place of its value when
// the key is present, as a new last member otherwise.
pub function (own o: JsonObject) insert(key: string, value: JsonValue): JsonObject {
  let at: i32 = o.position(key);
  if (at >= 0) {
    return JsonObject { ...o, items: o.items.with(at, value) };
  }
  let n: i32 = o.names.len();
  let keys: string[] = o.names.append(key);
  let values: JsonValue[] = o.items.append(value);
  let index: i32[] = o.index;
  if (n + 1 > JSON_LINEAR_MAX) {
    if (2 * (n + 1) > index.len()) {
      index = __json_index_of(keys, n + 1);
    } else {
      index = index.with(__json_index_slot(index, keys, key, __map_hash_seed()), n + 1);
    }
  }
  return JsonObject { names: keys, items: values, index: index };
}

// remove is the object without `key`, the others keeping their order; the
// receiver when the key is absent.
pub function (o: JsonObject) remove(key: string): JsonObject {
  let at: i32 = o.position(key);
  if (at < 0) {
    return o;
  }
  let keys: string[] = [];
  let values: JsonValue[] = [];
  let i: i32 = 0;
  while (i < o.names.len()) {
    if (i != at) {
      keys = keys.append(o.names[i]);
      values = values.append(o.items[i]);
    }
    i = i + 1;
  }
  return object_of(keys, values);
}

// update is the object with `key` bound to `f` of its value, or of `init`
// when the key is absent.
pub function (own o: JsonObject) update(key: string, init: JsonValue, f: (JsonValue) => JsonValue): JsonObject {
  let v: JsonValue = f(o.get_or(key, init));
  return o.insert(key, v);
}

// merge is the object with every member of `other` inserted: on a key in
// both, `other`'s value wins.
pub function (own o: JsonObject) merge(other: JsonObject): JsonObject {
  let out: JsonObject = o;
  let i: i32 = 0;
  while (i < other.names.len()) {
    out = out.insert(other.names[i], other.items[i]);
    i = i + 1;
  }
  return out;
}

// keys and values are the members' keys and values, in document order.
pub function (o: JsonObject) keys(): string[] {
  return o.names;
}

pub function (o: JsonObject) values(): JsonValue[] {
  return o.items;
}

// entries is every `(key, value)` member, in document order.
pub function (o: JsonObject) entries(): (string, JsonValue)[] {
  let out: (string, JsonValue)[] = [];
  let i: i32 = 0;
  while (i < o.names.len()) {
    out = out.append((o.names[i], o.items[i]));
    i = i + 1;
  }
  return out;
}

// filter is the object of the members `pred(key, value)` accepts.
pub function (o: JsonObject) filter(pred: (string, JsonValue) => boolean): JsonObject {
  let keys: string[] = [];
  let values: JsonValue[] = [];
  let i: i32 = 0;
  while (i < o.names.len()) {
    if (pred(o.names[i], o.items[i])) {
      keys = keys.append(o.names[i]);
      values = values.append(o.items[i]);
    }
    i = i + 1;
  }
  return object_of(keys, values);
}

// fold is `f(f(f(init, k0, v0), k1, v1), …)` in document order.
pub function (o: JsonObject) fold[A](init: A, f: (A, string, JsonValue) => A): A {
  let acc: A = init;
  let i: i32 = 0;
  while (i < o.names.len()) {
    acc = f(acc, o.names[i], o.items[i]);
    i = i + 1;
  }
  return acc;
}

// map_values is the object with every value replaced by `f(value)`.
pub function (o: JsonObject) map_values(f: (JsonValue) => JsonValue): JsonObject {
  let values: JsonValue[] = [];
  let i: i32 = 0;
  while (i < o.items.len()) {
    values = values.append(f(o.items[i]));
    i = i + 1;
  }
  return JsonObject { ...o, items: values };
}

// for_each calls `f(key, value)` on every member in document order.
pub function (o: JsonObject) for_each(f: (string, JsonValue) => void): void {
  let i: i32 = 0;
  while (i < o.names.len()) {
    f(o.names[i], o.items[i]);
    i = i + 1;
  }
}

function __json_hex_lower(d: i32): i32 {
  if (d < 10) {  // '0' + d
    return d + 48;
  }
  return d + 87;  // 'a' - 10 + d
}

// JSON_ESCAPES marks the bytes json_escape rewrites: every C0 control, `"`
// and `\`. A byte past its end is not in it.
const JSON_ESCAPES: u8[] = [
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8,
];

// `json.json_escape(s)` — escape a raw string for embedding inside a
// JSON string literal (the caller supplies the surrounding quotes).
// Backslash and double-quote are backslash-escaped, newline / carriage-
// return / tab take their short escapes (\n \r \t), and every other C0
// control byte (0x00-0x08, 0x0B, 0x0C, 0x0E-0x1F) — forbidden bare in a
// JSON string — is emitted as lowercase `\u00XX`. Everything else
// passes through byte-for-byte (UTF-8 sequences are >= 0x80, so
// multi-byte characters are untouched). This is the ONE shared JSON
// string escaper: the `JsonValue` encoder, `@derive(json.Json)`'s
// string leaf, and `std/log`'s JSON-lines mode all route through it
// (#4388 item 4 — it was previously copy-pasted per consumer).
pub function json_escape(s: string): string {
  let n: i32 = s.len();
  let i: i32 = __scan_set(s, 0, JSON_ESCAPES);
  if (i == n) {
    return s;
  }
  // An exact-size buffer (#4379): each escaped byte widens to its escape.
  let total: i32 = n;
  while (i < n) {
    total = total + __json_escape_width(s[i] as i32) - 1;
    i = __scan_set(s, i + 1, JSON_ESCAPES);
  }
  let buf: u8[] = __alloc_u8(total);
  let pos: i32 = 0;
  let from: i32 = 0;
  while (from < n) {
    let stop: i32 = __scan_set(s, from, JSON_ESCAPES);
    while (from < stop) {
      buf = buf.with(pos, s[from] as u8);
      pos = pos + 1;
      from = from + 1;
    }
    if (stop < n) {
      buf = __json_put_escape(buf, pos, s[stop] as i32);
      pos = pos + __json_escape_width(s[stop] as i32);
      from = stop + 1;
    }
  }
  return string_from_bytes_unchecked(buf);
}

// The escape of a byte JSON_ESCAPES marks is two bytes for `"`, `\`, newline,
// carriage return and tab, and a six-byte `\u00XX` for any other control.
function __json_escape_width(b: i32): i32 {
  if (b == 34 || b == 92 || b == 10 || b == 13 || b == 9) {
    return 2;
  }
  return 6;
}

// __json_put_escape writes the escape of `b` into `buf` at `pos`.
function __json_put_escape(buf: u8[], pos: i32, b: i32): u8[] {
  let out: u8[] = buf.with(pos, 92 as u8);
  if (b == 34 || b == 92) {
    return out.with(pos + 1, b as u8);
  }
  if (b == 10) {
    return out.with(pos + 1, 110 as u8);
  }
  if (b == 13) {
    return out.with(pos + 1, 114 as u8);
  }
  if (b == 9) {
    return out.with(pos + 1, 116 as u8);
  }
  // \u00XX with lowercase hex.
  out = out.with(pos + 1, 117 as u8);
  out = out.with(pos + 2, 48 as u8);
  out = out.with(pos + 3, 48 as u8);
  out = out.with(pos + 4, __json_hex_lower(b >> 4 & 15) as u8);
  return out.with(pos + 5, __json_hex_lower(b & 15) as u8);
}

pub function json_encode(v: JsonValue): string {
  // One `buf` and `i` shared across the match arms: only one
  // composite arm runs per call, so `buf` needs no reset.
  let buf: u8[] = [];
  let i: i32 = 0;
  match (v) {
    JNull => {
      return "null";
    },
    JBool(b) => {
      if (b) {
        return "true";
      }
      return "false";
    },
    JNumber(s) => {
      return s;
    },
    JString(s) => {
      return "\"" + json_escape(s) + "\"";
    },
    JArray(arr) => {
      // Accumulate this level into a LOCAL u8[] (#4379) rather than
      // `out = out + json_encode(arr[i])`, which recopied the whole
      // encoded-so-far prefix on every element — O(level²) at each nesting
      // level. Every append targets the local `buf`, so it grows in place
      // (amortized O(1)); the child bytes are inlined (not routed through a
      // helper, whose borrowed-param append would copy per call). Byte-for-
      // byte identical output.
      buf = buf.append(91 as u8);  // '['
      let n: i32 = arr.len();
      while (i < n) {
        if (i > 0) {  // ','
          buf = buf.append(44 as u8);
        }
        let enc: string = json_encode(arr[i]);
        let el: i32 = enc.len();
        let k: i32 = 0;
        while (k < el) {
          buf = buf.append(enc[k] as u8);
          k = k + 1;
        }
        i = i + 1;
      }
      buf = buf.append(93 as u8);  // ']'
      return string_from_bytes_unchecked(buf);
    },
    JObject(o) => {
      // Same local-u8[] accumulation as JArray (#4379): the old
      // `out = out + …` recopied the growing object text on every member.
      buf = buf.append(123 as u8);  // '{'
      let mi: i32 = 0;
      while (mi < o.names.len()) {
        if (mi > 0) {  // ','
          buf = buf.append(44 as u8);
        }
        buf = buf.append(34 as u8);  // '"'
        let ek: string = json_escape(o.names[mi]);
        let ekl: i32 = ek.len();
        let kk: i32 = 0;
        while (kk < ekl) {
          buf = buf.append(ek[kk] as u8);
          kk = kk + 1;
        }
        buf = buf.append(34 as u8);  // '"'
        buf = buf.append(58 as u8);  // ':'
        let ev: string = json_encode(o.items[mi]);
        let evl: i32 = ev.len();
        let vk: i32 = 0;
        while (vk < evl) {
          buf = buf.append(ev[vk] as u8);
          vk = vk + 1;
        }
        mi = mi + 1;
      }
      buf = buf.append(125 as u8);  // '}'
      return string_from_bytes_unchecked(buf);
    }
  }
}

// === JSON pretty-printing ===
//
// `json_encode_pretty(v, indent)` renders the same JSON as
// `json_encode` but human-readable: each array element / object member
// on its own line, nested `indent` spaces deeper per level. Empty
// arrays / objects stay on one line (`[]` / `{}`). Scalars and string
// escaping are identical to `json_encode`, so the two agree on every
// value token — only whitespace differs. `indent` is spaces per level
// (2 is the common default; 0 yields newlines with no indentation).

// __json_spaces returns a string of `n` spaces.
function __json_spaces(n: i32): string {
  let b: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    b = b.append(32 as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

// __json_append_str appends `s`'s bytes onto `buf` (the same local-u8[]
// accumulation json_encode uses to avoid O(n²) string concat).
function __json_append_str(buf: u8[], s: string): u8[] {
  let i: i32 = 0;
  let out: u8[] = buf;
  while (i < s.len()) {
    out = out.append(s[i] as u8);
    i = i + 1;
  }
  return out;
}

function __json_pretty(v: JsonValue, indent: i32, depth: i32): string {
  match (v) {
    JNull => {
      return "null";
    },
    JBool(b) => {
      if (b) {
        return "true";
      }
      return "false";
    },
    JNumber(s) => {
      return s;
    },
    JString(s) => {
      return "\"" + json_escape(s) + "\"";
    },
    JArray(arr) => {
      let n: i32 = arr.len();
      if (n == 0) {
        return "[]";
      }
      let inner: string = __json_spaces((depth + 1) * indent);
      let close: string = __json_spaces(depth * indent);
      let buf: u8[] = [];
      buf = buf.append(91 as u8);  // '['
      buf = __json_append_str(buf, "\n");
      let i: i32 = 0;
      while (i < n) {
        if (i > 0) {
          buf = __json_append_str(buf, ",\n");
        }
        buf = __json_append_str(buf, inner);
        buf = __json_append_str(buf, __json_pretty(arr[i], indent, depth + 1));
        i = i + 1;
      }
      buf = __json_append_str(buf, "\n");
      buf = __json_append_str(buf, close);
      buf = buf.append(93 as u8);  // ']'
      return string_from_bytes_unchecked(buf);
    },
    JObject(o) => {
      if (o.len() == 0) {
        return "{}";
      }
      let inner: string = __json_spaces((depth + 1) * indent);
      let close: string = __json_spaces(depth * indent);
      let buf: u8[] = [];
      buf = buf.append(123 as u8);  // '{'
      buf = __json_append_str(buf, "\n");
      let mi: i32 = 0;
      while (mi < o.names.len()) {
        if (mi > 0) {
          buf = __json_append_str(buf, ",\n");
        }
        buf = __json_append_str(buf, inner);
        buf = buf.append(34 as u8);  // '"'
        buf = __json_append_str(buf, json_escape(o.names[mi]));
        buf = buf.append(34 as u8);  // '"'
        buf = __json_append_str(buf, ": ");
        buf = __json_append_str(buf, __json_pretty(o.items[mi], indent, depth + 1));
        mi = mi + 1;
      }
      buf = __json_append_str(buf, "\n");
      buf = __json_append_str(buf, close);
      buf = buf.append(125 as u8);  // '}'
      return string_from_bytes_unchecked(buf);
    }
  }
}

// `json_encode_pretty(v, indent)` — indented, human-readable JSON.
pub function json_encode_pretty(v: JsonValue, indent: i32): string {
  return __json_pretty(v, indent, 0);
}

// === JSON parsing ===
//
// `json_parse(s)` is the inverse of `json_encode`. Returns
// `Option[JsonValue]`; `None` on any malformed input. Recursive descent
// over `s`: each parser starts at the offset in a shared `Cell[i32]` and
// leaves it just past what it consumed. A failure stores `-1 - offset`
// there instead, so a negative cell is a failed parse, and the first
// failure — the innermost, which describes the document — is never
// overwritten. Numbers are stored verbatim as `JNumber`'s string payload.
// String escapes are decoded (`\"`, `\\`, `\/`, `\b`, `\f`, `\n`,
// `\r`, `\t`, and `\uXXXX`, surrogate pairs combined).
//
// Nesting is bounded at 128 containers, serde_json's default limit, so a
// hostile `[[[[…` body cannot recurse until the stack overflows.

// JSON_NOT_WS marks every byte but the four JSON whitespace bytes, so a scan
// over it finds the end of a whitespace run.
const JSON_NOT_WS: u8[] = [
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 0u8, 0u8, 1u8, 1u8, 0u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  0u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
];

// __json_ws is the first offset at or after `i` that is not JSON whitespace.
function __json_ws(s: string, i: i32): i32 {
  if (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b == 32 || b == 9 || b == 10 || b == 13) {
      return __scan_set(s, i + 1, JSON_NOT_WS);
    }
  }
  return i;
}

// __json_byte is the byte at `i`, or 0 past the end.
function __json_byte(s: string, i: i32): i32 {
  if (i >= s.len()) {
    return 0;
  }
  return s[i] as i32;
}

// __json_fail records a failure at `pos` unless one is already recorded.
function __json_fail(at: Cell[i32], pos: i32): void {
  if (at.get() >= 0) {
    at.set(-1 - pos);
  }
}

function __json_hex_value(c: i32): i32 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return -1;
}

// __json_number_end is the offset just past the number starting at `start`,
// or -1 - offset of the first byte that breaks its grammar, and whether it is
// an integer. Each digit run is one scan.
function __json_number_end(s: string, start: i32): (i32, boolean) {
  let n: i32 = s.len();
  let i: i32 = start;
  if (i < n && s[i] == 45) {  // '-'
    i = i + 1;
  }
  // RFC 8259's `int` is `zero / digit1-9 *DIGIT`, so a leading zero may not
  // be followed by another digit: `01` is two tokens, not a number.
  let intStart: i32 = i;
  i = __scan_set(s, i, JSON_NOT_DIGIT);
  if (i == intStart) {
    return (-1 - i, false);
  }
  if (s[intStart] == 48 && i - intStart > 1) {
    return (-2 - intStart, false);
  }
  let whole: boolean = true;
  // `frac` is `"." 1*DIGIT`.
  if (i < n && s[i] == 46) {
    let fracStart: i32 = i + 1;
    i = __scan_set(s, fracStart, JSON_NOT_DIGIT);
    if (i == fracStart) {
      return (-1 - i, false);
    }
    whole = false;
  }
  // `exp` is `[eE][+-]?1*DIGIT`.
  if (i < n && (s[i] == 101 || s[i] == 69)) {
    i = i + 1;
    if (i < n && (s[i] == 43 || s[i] == 45)) {
      i = i + 1;
    }
    let expStart: i32 = i;
    i = __scan_set(s, expStart, JSON_NOT_DIGIT);
    if (i == expStart) {
      return (-1 - i, false);
    }
    whole = false;
  }
  return (i, whole);
}

// __json_p_number reads the number starting at `start`.
function __json_p_number(s: string, start: i32, at: Cell[i32]): JsonValue {
  let (end, _) = __json_number_end(s, start);
  if (end < 0) {
    __json_fail(at, -1 - end);
    return JNull;
  }
  at.set(end);
  return JNumber(slice_unchecked(s, start, end) + "");
}

// JSON_NOT_DIGIT marks every byte but `0`-`9`, so a scan over it finds the
// end of a digit run.
const JSON_NOT_DIGIT: u8[] = [
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
];

// __json_emit_codepoint encodes a single Unicode scalar value
// as the matching UTF-8 byte sequence (1-4 bytes) and appends
// it to `out`. Supports the full Unicode range up to
// U+10FFFF; the caller is expected to have resolved any
// surrogate pairs into a single code point already.
// The UTF-8 byte sequence (1–4 bytes) for a Unicode scalar value. Pure — the
// caller appends the returned bytes to its output buffer, so no growing string
// is threaded through (see __json_p_string's O(n) u8[] accumulation, #4379).
function __json_cp_bytes(cp: i32): u8[] {
  if (cp < 128) {
    return [cp as u8];
  }
  if (cp < 2048) {
    return [
      (cp >> 6 | 192) as u8,
      (cp & 63 | 128) as u8,
    ];
  }
  if (cp < 65536) {
    return [
      (cp >> 12 | 224) as u8,
      (cp >> 6 & 63 | 128) as u8,
      (cp & 63 | 128) as u8,
    ];
  }
  return [
    (cp >> 18 | 240) as u8,
    (cp >> 12 & 63 | 128) as u8,
    (cp >> 6 & 63 | 128) as u8,
    (cp & 63 | 128) as u8,
  ];
}

// __json_p_uhex is the value of the 4 hex digits at `i`, or -1 after
// recording a failure at the first that is missing or not hex.
function __json_p_uhex(s: string, i: i32, at: Cell[i32]): i32 {
  if (i + 4 > s.len()) {
    __json_fail(at, i);
    return -1;
  }
  let u: i32 = 0;
  let k: i32 = 0;
  while (k < 4) {
    let hv: i32 = __json_hex_value(s[i + k] as i32);
    if (hv < 0) {
      __json_fail(at, i + k);
      return -1;
    }
    u = u << 4 | hv;
    k = k + 1;
  }
  return u;
}

// __json_p_string reads the string whose opening quote is at `start`.
function __json_p_string(s: string, start: i32, at: Cell[i32]): string {
  if (__json_byte(s, start) != 34) {
    __json_fail(at, start);
    return "";
  }
  let i: i32 = start + 1;
  // A string with no escape is one slice of the input.
  let plain: i32 = __scan_set(s, i, JSON_STRING_STOPS);
  if (plain < s.len() && s[plain] == 34) {
    at.set(plain + 1);
    return slice_unchecked(s, i, plain) + "";
  }
  // The decoded value accumulates in a local u8[], which grows in place
  // (#4379); codepoint escapes append their 1-4 UTF-8 bytes from the pure
  // __json_cp_bytes.
  let out: u8[] = [];
  let n: i32 = s.len();
  let b: i32 = 0;
  let cb: u8[] = [];
  let ci: i32 = 0;
  while (true) {
    b = __json_byte(s, i);
    if (b < 32) {
      __json_fail(at, i);
      return "";
    }
    if (b == 34) {
      at.set(i + 1);
      return string_from_bytes_unchecked(out);
    }
    if (b == 92) {  // '\\'
      i = i + 1;
      let esc: i32 = __json_byte(s, i);
      if (esc == 0) {
        __json_fail(at, i);
        return "";
      }
      if (esc == 117) {  // 'u' — \uXXXX
        i = i + 1;
        let u: i32 = __json_p_uhex(s, i, at);
        if (u < 0) {
          return "";
        }
        i = i + 4;
        // High surrogate (D800..DBFF): combine with
        // the following low surrogate (DC00..DFFF) to
        // form a single astral code point. Lone or
        // mismatched surrogates fall back to U+FFFD
        // (REPLACEMENT CHARACTER) — matches Go's
        // encoding/json + most strict UTF-8 emitters. The branch
        // funnels to a primary codepoint `cp1` plus, for the
        // mismatched-low-surrogate case, a second `cp2` (-1 = none).
        let cp1: i32 = 65533;
        let cp2: i32 = -1;
        if (u >= 55296 && u <= 56319) {
          if (i + 6 > n
            || s[i] != 92
            || s[i + 1] != 117) {
            cp1 = 65533;
          } else {
            i = i + 2;
            let low: i32 = __json_p_uhex(s, i, at);
            if (low < 0) {
              return "";
            }
            i = i + 4;
            if (low < 56320 || low > 57343) {
              cp1 = 65533;
              cp2 = low;
            } else {
              cp1 = 65536
                + (u - 55296 << 10)
                + (low - 56320);
            }
          }
        } else if (u >= 56320 && u <= 57343) {
          cp1 = 65533;
        } else {
          cp1 = u;
        }
        cb = __json_cp_bytes(cp1);
        ci = 0;
        while (ci < cb.len()) {
          out = out.append(cb[ci] as u8);
          ci = ci + 1;
        }
        if (cp2 >= 0) {
          cb = __json_cp_bytes(cp2);
          ci = 0;
          while (ci < cb.len()) {
            out = out.append(cb[ci] as u8);
            ci = ci + 1;
          }
        }
      } else {
        let ch: i32 = -1;
        if (esc == 34 || esc == 92 || esc == 47) {
          ch = esc;
        } else if (esc == 110) {
          ch = 10;
        } else if (esc == 114) {
          ch = 13;
        } else if (esc == 116) {
          ch = 9;
        } else if (esc == 98) {
          ch = 8;
        } else if (esc == 102) {
          ch = 12;
        } else {
          __json_fail(at, i);
          return "";
        }
        out = out.append(ch as u8);
        i = i + 1;
      }
    } else {
      let stop: i32 = __scan_set(s, i, JSON_STRING_STOPS);
      out = __json_append_run(out, s, i, stop);
      i = stop;
    }
  }
  return "";  // unreachable
}

// JSON_STRING_STOPS marks where a string's plain run ends: `"`, `\`, and the
// C0 controls, which RFC 8259 requires escaped, so one falls through to the
// loop that rejects it.
const JSON_STRING_STOPS: u8[] = [
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
];

// __json_append_run appends s[from:stop] to out.
function __json_append_run(out: u8[], s: string, from: i32, stop: i32): u8[] {
  let acc: u8[] = out;
  let i: i32 = from;
  while (i < stop) {
    acc = acc.append(s[i] as u8);
    i = i + 1;
  }
  return acc;
}

// __json_p_array reads the array whose `[` is at `start`; `depth` counts
// it.
function __json_p_array(s: string, start: i32, at: Cell[i32], depth: i32): JsonValue {
  let i: i32 = __json_ws(s, start + 1);
  if (__json_byte(s, i) == 93) {  // ']'
    at.set(i + 1);
    let empty: JsonValue[] = [];
    return JArray(empty);
  }
  let arr: JsonValue[] = [];
  at.set(i);
  while (true) {
    let elem: JsonValue = __json_p_value(s, at, depth);
    i = at.get();
    if (i < 0) {
      return JNull;
    }
    arr = arr.append(elem);
    i = __json_ws(s, i);
    let b: i32 = __json_byte(s, i);
    if (b == 44) {  // ','
      at.set(i + 1);
      continue;
    }
    if (b == 93) {  // ']'
      at.set(i + 1);
      return JArray(arr);
    }
    __json_fail(at, i);
    return JNull;
  }
  return JNull;  // unreachable
}

// __json_p_object reads the object whose `{` is at `start`; `depth` counts
// it.
function __json_p_object(s: string, start: i32, at: Cell[i32], depth: i32): JsonValue {
  let i: i32 = __json_ws(s, start + 1);
  if (__json_byte(s, i) == 125) {  // '}'
    at.set(i + 1);
    return JObject(object());
  }
  let keys: string[] = [];
  let values: JsonValue[] = [];
  while (true) {
    let key: string = __json_p_string(s, i, at);
    i = at.get();
    if (i < 0) {
      return JNull;
    }
    i = __json_ws(s, i);
    if (__json_byte(s, i) != 58) {  // ':'
      __json_fail(at, i);
      return JNull;
    }
    at.set(i + 1);
    let val: JsonValue = __json_p_value(s, at, depth);
    i = at.get();
    if (i < 0) {
      return JNull;
    }
    keys = keys.append(key);
    values = values.append(val);
    i = __json_ws(s, i);
    let b: i32 = __json_byte(s, i);
    if (b == 44) {  // ','
      i = __json_ws(s, i + 1);
      continue;
    }
    if (b == 125) {  // '}'
      at.set(i + 1);
      return JObject(object_of(keys, values));
    }
    __json_fail(at, i);
    return JNull;
  }
  return JNull;  // unreachable
}

// __json_p_value reads the value at or after the offset in `at`, past any
// leading whitespace, inside `depth` containers.
function __json_p_value(s: string, at: Cell[i32], depth: i32): JsonValue {
  let i: i32 = __json_ws(s, at.get());
  let b: i32 = __json_byte(s, i);
  if (b == 34) {  // '"' — string
    let str: string = __json_p_string(s, i, at);
    if (at.get() < 0) {
      return JNull;
    }
    return JString(str);
  }
  if (b == 45 || b >= 48 && b <= 57) {  // '-' or digit
    return __json_p_number(s, i, at);
  }
  if (b == 91 || b == 123) {  // '[' or '{'
    if (depth >= 128) {
      __json_fail(at, i);
      return JNull;
    }
    if (b == 91) {
      return __json_p_array(s, i, at, depth + 1);
    }
    return __json_p_object(s, i, at, depth + 1);
  }
  if (b == 110 && __json_word(s, i, "null")) {
    at.set(i + 4);
    return JNull;
  }
  if (b == 116 && __json_word(s, i, "true")) {
    at.set(i + 4);
    return JBool(true);
  }
  if (b == 102 && __json_word(s, i, "false")) {
    at.set(i + 5);
    return JBool(false);
  }
  __json_fail(at, i);
  return JNull;
}

// __json_word reports whether `word` is spelled at `i`.
function __json_word(s: string, i: i32, word: string): boolean {
  if (i + word.len() > s.len()) {
    return false;
  }
  let k: i32 = 1;
  while (k < word.len()) {
    if (s[i + k] != word[k]) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// __json_line_col converts a byte offset into 1-based (line, column),
// counting a column in BYTES rather than code points — the same unit the
// offset is in, so the two always agree.
function __json_line_col(s: string, off: i32): (i32, i32) {
  let line: i32 = 1;
  let col: i32 = 1;
  let i: i32 = 0;
  let stop: i32 = off;
  if (stop > s.len()) {
    stop = s.len();
  }
  while (i < stop) {
    if (s[i] as i32 == 10) {
      line = line + 1;
      col = 1;
    } else {
      col = col + 1;
    }
    i = i + 1;
  }
  return (line, col);
}

// A syntax error, located. `offset` is the byte index; `line` and `col` are
// 1-based and derived from it.
pub struct JsonError {
  message: string,
  offset: i32,
  line: i32,
  col: i32,
}

pub function (e: JsonError) message(): string {
  return e.to_string();
}

impl error.Error for JsonError {}

impl cmp.Display for JsonError {}

pub function (e: JsonError) to_string(): string {
  return e.line.to_string() + ":" + e.col.to_string() + ": " + e.message;
}

// __json_message describes the failure at `off` from the input alone, so
// the 20 failure sites stay a single shared helper rather than each
// carrying its own wording.
function __json_message(s: string, off: i32): string {
  if (off >= s.len()) {
    return "unexpected end of input";
  }
  let b: i32 = s[off] as i32;
  if (b < 32) {
    return "unexpected control byte in input";
  }
  if (b < 128) {
    return "unexpected byte '" + string_from_bytes_unchecked([s[off]]) + "'";
  }
  // A non-ASCII byte renders as hex — quoting it alone could split a
  // multibyte code point.
  return "unexpected byte '\\x" + b.to_hex().pad_start(2, "0") + "'";
}

// json_parse_result is json_parse plus the position of the failure.
// Prefer it wherever the input can be malformed and a human will read the
// result: a config file, a request body, anything hand-edited.
pub function json_parse_result(s: string): Result[JsonValue, JsonError] {
  let at: Cell[i32] = cell_new(0);
  let v: JsonValue = __json_p_value(s, at, 0);
  let end: i32 = at.get();
  if (end < 0) {
    let off: i32 = -1 - end;
    let (ln, cl) = __json_line_col(s, off);
    return Err(JsonError {
      message: __json_message(s, off),
      offset: off,
      line: ln,
      col: cl,
    });
  }
  end = __json_ws(s, end);
  if (end < s.len()) {
    let (ln2, cl2) = __json_line_col(s, end);
    return Err(JsonError {
      message: "trailing content after the top-level value",
      offset: end,
      line: ln2,
      col: cl2,
    });
  }
  return Ok(v);
}

pub function json_parse(s: string): Option[JsonValue] {
  match (json_parse_result(s)) {
    Ok(v) => {
      return Some(v);
    },
    Err(_) => {
      return None;
    }
  }
}

// === Document: a parse that allocates no value ===
//
// parse_document reads JSON into a tape: two u64 words per value, in document
// order, over the source text, so no value is allocated until one is asked for.
// Word 0 holds the kind in its top byte, flags in bits 32-55 and a field in the
// low 32 bits; word 1 holds a second field.
//
//   array, object   next = the node after the container; count = elements, or
//                   members for an object
//   string          start, end = the content's offsets, between the quotes;
//                   flag 1 when it holds an escape
//   number          start, end = the text's offsets; flag 1 when it is an
//                   integer (no fraction or exponent)
//   null, true, false
//
// A scalar's next node is the one after it, and an object's members are a key
// node then its value. Nodes are named by index; the root is node 0. It accepts
// exactly what json_parse does and reports a failure at the same offset.
pub struct Document { text: string, tape: u64[] }

const JSON_T_NULL: i32 = 1;

const JSON_T_TRUE: i32 = 2;

const JSON_T_FALSE: i32 = 3;

const JSON_T_NUMBER: i32 = 4;

const JSON_T_STRING: i32 = 5;

const JSON_T_ARRAY: i32 = 6;

const JSON_T_OBJECT: i32 = 7;

function __json_t_word(kind: i32, flags: i32, a: i32): u64 {
  return kind as u64 << 56 as u64 | flags as u64 << 32 as u64 | (a as u32) as u64;
}

function __json_t_node(own tape: u64[], kind: i32, flags: i32, a: i32, b: i32): u64[] {
  return tape.append(__json_t_word(kind, flags, a)).append((b as u32) as u64);
}

// __json_t_close fills in the container at `node` now that `tape` ends after
// it.
function __json_t_close(own tape: u64[], node: i32, kind: i32, count: i32): u64[] {
  let next: i32 = tape.len() / 2;
  return tape.with(2 * node, __json_t_word(kind, 0, next)).with(2 * node + 1, (count as u32) as u64);
}

// __json_string_end is the offset just past a string whose first run of plain
// bytes ends at `plain`, or -1 - offset of what breaks it.
function __json_string_end(s: string, plain: i32): i32 {
  let i: i32 = plain;
  while (true) {
    let b: i32 = __json_byte(s, i);
    if (b == 34) {
      return i + 1;
    }
    if (b == 92) {  // '\\'
      i = __json_escape_end(s, i + 1);
    } else if (b < 32) {
      return -1 - i;
    } else {
      i = __scan_set(s, i, JSON_STRING_STOPS);
    }
    if (i < 0) {
      return i;
    }
  }
  return -1;  // unreachable
}

// __json_short_escape reports whether `\` then `esc` is a one-letter escape.
function __json_short_escape(esc: i32): boolean {
  return esc == 34 || esc == 92 || esc == 47 || esc == 110 || esc == 114 || esc == 116 || esc == 98 || esc == 102;
}

// __json_escape_end is the offset past the escape whose letter is at `i`, or
// -1 - offset of what breaks it.
function __json_escape_end(s: string, i: i32): i32 {
  let esc: i32 = __json_byte(s, i);
  if (__json_short_escape(esc)) {
    return i + 1;
  }
  if (esc != 117) {  // 'u'
    return -1 - i;
  }
  let h: i32 = i + 1;
  if (h + 4 > s.len()) {
    return -1 - h;
  }
  let k: i32 = 0;
  while (k < 4) {
    if (__json_hex_value(s[h + k] as i32) < 0) {
      return -1 - (h + k);
    }
    k = k + 1;
  }
  return h + 4;
}

// __json_t_scalar parses the scalar at `i` onto the tape and answers the
// offset past it, or -1 - offset of a failure.
function __json_t_scalar(s: string, i: i32, own tape: u64[]): (u64[], i32) {
  let b: i32 = __json_byte(s, i);
  if (b == 34) {  // '"'
    return __json_t_string(s, i, tape);
  }
  if (b == 45 || b >= 48 && b <= 57) {  // '-' or digit
    let (end, whole) = __json_number_end(s, i);
    if (end < 0) {
      return (tape, end);
    }
    let flag: i32 = 0;
    if (whole) {
      flag = 1;
    }
    return (__json_t_node(tape, JSON_T_NUMBER, flag, i, end), end);
  }
  return __json_t_literal(s, i, b, tape);
}

// __json_t_string parses the string whose `"` is at `i`.
function __json_t_string(s: string, i: i32, own tape: u64[]): (u64[], i32) {
  let plain: i32 = __scan_set(s, i + 1, JSON_STRING_STOPS);
  if (plain < s.len() && s[plain] == 34) {
    return (__json_t_node(tape, JSON_T_STRING, 0, i + 1, plain), plain + 1);
  }
  let end: i32 = __json_string_end(s, plain);
  if (end < 0) {
    return (tape, end);
  }
  return (__json_t_node(tape, JSON_T_STRING, 1, i + 1, end - 1), end);
}

// __json_t_literal parses the `null`, `true` or `false` whose first byte `b`
// is at `i`.
function __json_t_literal(s: string, i: i32, b: i32, own tape: u64[]): (u64[], i32) {
  if (b == 110 && __json_word(s, i, "null")) {
    return (__json_t_node(tape, JSON_T_NULL, 0, 0, 0), i + 4);
  }
  if (b == 116 && __json_word(s, i, "true")) {
    return (__json_t_node(tape, JSON_T_TRUE, 0, 0, 0), i + 4);
  }
  if (b == 102 && __json_word(s, i, "false")) {
    return (__json_t_node(tape, JSON_T_FALSE, 0, 0, 0), i + 5);
  }
  return (tape, -1 - i);
}

// __json_t_key parses the member key at `i` and the `:` after it onto the tape
// and answers the offset past the `:`, or -1 - offset of a failure.
function __json_t_key(s: string, i: i32, own tape: u64[]): (u64[], i32) {
  if (__json_byte(s, i) != 34) {
    return (tape, -1 - i);
  }
  let (t, end) = __json_t_string(s, i, tape);
  if (end < 0) {
    return (t, end);
  }
  let k: i32 = __json_ws(s, end);
  if (__json_byte(s, k) != 58) {  // ':'
    return (t, -1 - k);
  }
  return (t, k + 1);
}

function __json_t_kind(tape: u64[], node: i32): i32 {
  return (tape[2 * node] >> 56 as u64) as i32;
}

// __json_t_value parses the value at `i`, inside `depth` containers, onto the
// tape and answers the offset past it, or -1 - offset of a failure.
function __json_t_value(s: string, i: i32, own tape: u64[], depth: i32): (u64[], i32) {
  let b: i32 = __json_byte(s, i);
  if (b != 91 && b != 123) {  // not '[' or '{'
    return __json_t_scalar(s, i, tape);
  }
  if (depth >= 128) {
    return (tape, -1 - i);
  }
  if (b == 91) {
    return __json_t_array(s, i, tape, depth + 1);
  }
  return __json_t_object(s, i, tape, depth + 1);
}

// __json_t_array parses the array whose `[` is at `start`; `depth` counts it.
function __json_t_array(s: string, start: i32, own tape: u64[], depth: i32): (u64[], i32) {
  let node: i32 = tape.len() / 2;
  tape = __json_t_node(tape, JSON_T_ARRAY, 0, 0, 0);
  let i: i32 = __json_ws(s, start + 1);
  let count: i32 = 0;
  if (__json_byte(s, i) == 93) {  // ']'
    return (__json_t_close(tape, node, JSON_T_ARRAY, 0), i + 1);
  }
  while (true) {
    let (t, end) = __json_t_value(s, i, tape, depth);
    tape = t;
    if (end < 0) {
      return (tape, end);
    }
    count = count + 1;
    i = __json_ws(s, end);
    let b: i32 = __json_byte(s, i);
    if (b == 93) {
      return (__json_t_close(tape, node, JSON_T_ARRAY, count), i + 1);
    }
    if (b != 44) {  // ','
      return (tape, -1 - i);
    }
    i = __json_ws(s, i + 1);
  }
  return (tape, -1);  // unreachable
}

// __json_t_object parses the object whose `{` is at `start`; `depth` counts
// it.
function __json_t_object(s: string, start: i32, own tape: u64[], depth: i32): (u64[], i32) {
  let node: i32 = tape.len() / 2;
  tape = __json_t_node(tape, JSON_T_OBJECT, 0, 0, 0);
  let i: i32 = __json_ws(s, start + 1);
  let count: i32 = 0;
  if (__json_byte(s, i) == 125) {  // '}'
    return (__json_t_close(tape, node, JSON_T_OBJECT, 0), i + 1);
  }
  while (true) {
    let (t, at) = __json_t_key(s, i, tape);
    tape = t;
    if (at < 0) {
      return (tape, at);
    }
    let (t2, end) = __json_t_value(s, __json_ws(s, at), tape, depth);
    tape = t2;
    if (end < 0) {
      return (tape, end);
    }
    count = count + 1;
    i = __json_ws(s, end);
    let b: i32 = __json_byte(s, i);
    if (b == 125) {
      return (__json_t_close(tape, node, JSON_T_OBJECT, count), i + 1);
    }
    if (b != 44) {  // ','
      return (tape, -1 - i);
    }
    i = __json_ws(s, i + 1);
  }
  return (tape, -1);  // unreachable
}

// parse_document reads `s` into a Document, or the JsonError json_parse_result
// would report for it.
pub function parse_document(s: string): Result[Document, JsonError] {
  let empty: u64[] = [];
  let (tape, end) = __json_t_value(s, __json_ws(s, 0), empty, 0);
  let fail: i32 = -1 - end;
  if (end >= 0) {
    fail = __json_ws(s, end);
    if (fail == s.len()) {
      return Ok(Document { text: s, tape: tape });
    }
  }
  let (ln, cl) = __json_line_col(s, fail);
  if (end >= 0) {
    return Err(JsonError { message: "trailing content after the top-level value", offset: fail, line: ln, col: cl });
  }
  return Err(JsonError { message: __json_message(s, fail), offset: fail, line: ln, col: cl });
}

function __json_t_a(d: Document, n: i32): i32 {
  return (d.tape[2 * n] & 4294967295u64) as i32;
}

function __json_t_b(d: Document, n: i32): i32 {
  return d.tape[2 * n + 1] as i32;
}

function __json_t_flag(d: Document, n: i32): boolean {
  return (d.tape[2 * n] >> 32u64 & 1u64) == 1u64;
}

// __json_t_after is the node after `n` and everything inside it.
function __json_t_after(d: Document, n: i32): i32 {
  let k: i32 = __json_t_kind(d.tape, n);
  if (k == JSON_T_ARRAY || k == JSON_T_OBJECT) {
    return __json_t_a(d, n);
  }
  return n + 1;
}

// root is the document's top-level value.
pub function (d: Document) root(): i32 {
  return 0;
}

pub function (d: Document) is_null(n: i32): boolean {
  return __json_t_kind(d.tape, n) == JSON_T_NULL;
}

pub function (d: Document) is_bool(n: i32): boolean {
  let k: i32 = __json_t_kind(d.tape, n);
  return k == JSON_T_TRUE || k == JSON_T_FALSE;
}

pub function (d: Document) is_number(n: i32): boolean {
  return __json_t_kind(d.tape, n) == JSON_T_NUMBER;
}

pub function (d: Document) is_string(n: i32): boolean {
  return __json_t_kind(d.tape, n) == JSON_T_STRING;
}

pub function (d: Document) is_array(n: i32): boolean {
  return __json_t_kind(d.tape, n) == JSON_T_ARRAY;
}

pub function (d: Document) is_object(n: i32): boolean {
  return __json_t_kind(d.tape, n) == JSON_T_OBJECT;
}

// len is an array's element count or an object's member count; 0 otherwise.
pub function (d: Document) len(n: i32): i32 {
  let k: i32 = __json_t_kind(d.tape, n);
  if (k == JSON_T_ARRAY || k == JSON_T_OBJECT) {
    return __json_t_b(d, n);
  }
  return 0;
}

// first is an array's first element or an object's first key, or -1 when it
// has none or `n` is not a container. `next(n, c)` steps to the one after `c`;
// an object's member is its key node, and `value(key)` is its value.
pub function (d: Document) first(n: i32): i32 {
  if (d.len(n) == 0) {
    return -1;
  }
  return n + 1;
}

pub function (d: Document) next(parent: i32, c: i32): i32 {
  let after: i32 = __json_t_after(d, c);
  if (__json_t_kind(d.tape, parent) == JSON_T_OBJECT) {
    after = __json_t_after(d, after);
  }
  if (after >= __json_t_a(d, parent)) {
    return -1;
  }
  return after;
}

pub function (d: Document) value(key: i32): i32 {
  return key + 1;
}

// at is an array's element `k`.
pub function (d: Document) at(n: i32, k: i32): Option[i32] {
  if (__json_t_kind(d.tape, n) != JSON_T_ARRAY || k < 0 || k >= __json_t_b(d, n)) {
    return None;
  }
  let c: i32 = n + 1;
  let j: i32 = 0;
  while (j < k) {
    c = __json_t_after(d, c);
    j = j + 1;
  }
  return Some(c);
}

// get is the value of an object's member named `key`; the last when the
// document repeats it, as json_parse keeps.
pub function (d: Document) get(n: i32, key: string): Option[i32] {
  if (__json_t_kind(d.tape, n) != JSON_T_OBJECT) {
    return None;
  }
  let found: i32 = -1;
  let c: i32 = d.first(n);
  while (c >= 0) {
    if (__json_t_key_is(d, c, key)) {
      found = c + 1;
    }
    c = d.next(n, c);
  }
  if (found < 0) {
    return None;
  }
  return Some(found);
}

function __json_t_key_is(d: Document, k: i32, key: string): boolean {
  if (__json_t_flag(d, k)) {
    return __json_t_decode(d, k) == key;
  }
  let a: i32 = __json_t_a(d, k);
  let b: i32 = __json_t_b(d, k);
  return b - a == key.len() && slice_unchecked(d.text, a, b) == key;
}

// __json_t_slice is the source text node `n` spans.
function __json_t_slice(d: Document, n: i32): string {
  return slice_unchecked(d.text, __json_t_a(d, n), __json_t_b(d, n)) + "";
}

// __json_t_text is the string at `n` with any escapes decoded.
function __json_t_text(d: Document, n: i32): string {
  if (__json_t_flag(d, n)) {
    return __json_t_decode(d, n);
  }
  return __json_t_slice(d, n);
}

// __json_t_decode is the string at `n` with its escapes decoded.
function __json_t_decode(d: Document, n: i32): string {
  return __json_p_string(d.text, __json_t_a(d, n) - 1, cell_new(0));
}

pub function (d: Document) as_bool(n: i32): Option[boolean] {
  let k: i32 = __json_t_kind(d.tape, n);
  if (k == JSON_T_TRUE) {
    return Some(true);
  }
  if (k == JSON_T_FALSE) {
    return Some(false);
  }
  return None;
}

// as_string is a string's value with its escapes decoded; an object's key
// node answers its key.
pub function (d: Document) as_string(n: i32): Option[string] {
  if (__json_t_kind(d.tape, n) != JSON_T_STRING) {
    return None;
  }
  return Some(__json_t_text(d, n));
}

// number_text is a number as written.
pub function (d: Document) number_text(n: i32): Option[string] {
  if (__json_t_kind(d.tape, n) != JSON_T_NUMBER) {
    return None;
  }
  return Some(__json_t_slice(d, n));
}

pub function (d: Document) as_f64(n: i32): Option[f64] {
  if (__json_t_kind(d.tape, n) != JSON_T_NUMBER) {
    return None;
  }
  return slice_unchecked(d.text, __json_t_a(d, n), __json_t_b(d, n)).parse_float();
}

// as_i64 is an integer that fits an i64; None for one with a fraction or an
// exponent, or one out of range.
pub function (d: Document) as_i64(n: i32): Option[i64] {
  if (__json_t_kind(d.tape, n) != JSON_T_NUMBER || !__json_t_flag(d, n)) {
    return None;
  }
  let i: i32 = __json_t_a(d, n);
  let end: i32 = __json_t_b(d, n);
  let neg: boolean = d.text[i] == 45;
  if (neg) {
    i = i + 1;
  }
  // Accumulated negative, so i64's minimum fits.
  let acc: i64 = 0;
  let floor: i64 = -922337203685477580;
  while (i < end) {
    let digit: i64 = (d.text[i] - 48) as i64;
    if (acc < floor || acc == floor && digit > 8) {
      return None;
    }
    acc = acc * 10 - digit;
    i = i + 1;
  }
  if (neg) {
    return Some(acc);
  }
  if (acc == -9223372036854775807 - 1) {
    return None;
  }
  return Some(0 - acc);
}

// to_value is the JsonValue json_parse would build for node `n`.
pub function (d: Document) to_value(n: i32): JsonValue {
  let k: i32 = __json_t_kind(d.tape, n);
  if (k == JSON_T_NULL) {
    return JNull;
  }
  if (k == JSON_T_TRUE || k == JSON_T_FALSE) {
    return JBool(k == JSON_T_TRUE);
  }
  if (k == JSON_T_NUMBER) {
    return JNumber(__json_t_slice(d, n));
  }
  if (k == JSON_T_STRING) {
    return JString(__json_t_text(d, n));
  }
  if (k == JSON_T_ARRAY) {
    return JArray(__json_t_elements(d, n));
  }
  return JObject(__json_t_members(d, n));
}

function __json_t_elements(d: Document, n: i32): JsonValue[] {
  let arr: JsonValue[] = [];
  let c: i32 = d.first(n);
  while (c >= 0) {
    arr = arr.append(d.to_value(c));
    c = d.next(n, c);
  }
  return arr;
}

function __json_t_members(d: Document, n: i32): JsonObject {
  let keys: string[] = [];
  let values: JsonValue[] = [];
  let c: i32 = d.first(n);
  while (c >= 0) {
    keys = keys.append(__json_t_text(d, c));
    values = values.append(d.to_value(c + 1));
    c = d.next(n, c);
  }
  return object_of(keys, values);
}

// ============================================================
// Schema-directed JSON extraction helpers — Tier-C Rec §12
// (docs/STDLIB-DESIGN-RESEARCH.md Rec §3) Phase 1.
//
// The full design is `json_parse[T](bytes) → Result[T,
// JsonError]` where the compiler generates a per-struct walker
// for each T. That needs a new IR pass to monomorphise + emit
// per-T decoder code — multi-week. Phase 1 (this surface)
// ships typed-field extraction helpers on `JsonValue`:
// callers parse once with json_parse(), then walk the DOM
// with these helpers instead of pattern-matching every level.
//
// Typical use:
//
//   let text: string = req.body_string()?;
//   match (json_parse(text)) {
//       Some(v) => {
//           let name = json_get_string(v, "name");
//           let age  = json_get_i32(v, "age");
//           match ((name, age)) {
//               (Some(n), Some(a)) => return Some(CreateUser { name: n, age: a }),
//               _ => return None,
//           }
//       },
//       None => return None,
//   }
//
// Phase 2 will let callers skip the manual assembly:
//
//   let u: CreateUser = json_parse[CreateUser](req.body_bytes())?;
// ============================================================

// `json_get(obj, key)` — look up `key` in a JObject. Returns
// None when `obj` isn't a JObject or `key` isn't present.
// Foundation for the typed getters below.
pub function json_get(obj: JsonValue, key: string): Option[JsonValue] {
  match (obj) {
    JObject(m) => {
      match (m.get(key)) {
        Some(v) => {
          return Some(v);
        },
        None => {
          return None;
        }
      }
    },
    _ => {
      return None;
    }
  }
  return None;
}

// `json_get_string(obj, key)` — typed-extract a JString.
// Returns None when the key is missing or the value isn't
// a string.
pub function json_get_string(obj: JsonValue, key: string): Option[string] {
  match (json_get(obj, key)) {
    Some(v) => {
      match (v) {
        JString(s) => {
          return Some(s);
        },
        _ => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
  return None;
}

// `json_get_i32(obj, key)` — typed-extract a JNumber as i32.
// Returns None when the key is missing, the value isn't a
// number, the number doesn't parse as an integer (a `.` or `e`
// makes it a float — use json_get_f64), OR the value doesn't fit
// in i32. Overflow is a hard None rather than the old silent
// two's-complement wrap: the magnitude is accumulated in a wider
// i64 and range-checked, so `2147483648` on an i32 field is
// rejected instead of coming back as the min value (#4384 item 4).
pub function json_get_i32(obj: JsonValue, key: string): Option[i32] {
  match (json_get(obj, key)) {
    Some(v) => {
      match (v) {
        JNumber(s) => {
          return __json_number_i32(s);
        },
        _ => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
  return None;
}

// __json_number_i32 reads a JNumber's decimal text as an i32: an optional
// '-' then digits, None for anything else or a value outside the range.
function __json_number_i32(s: string): Option[i32] {
  let acc: i64 = 0;
  let i: i32 = 0;
  let neg: boolean = false;
  let nlen: i32 = s.len();
  if (nlen == 0) {
    return None;
  }
  if (s[0] == 45) {
    neg = true;
    i = 1;
  }
  if (i >= nlen) {
    return None;
  }
  while (i < nlen) {
    let b: i32 = s[i] as i32;
    if (b < 48 || b > 57) {
      return None;
    }
    acc = acc * 10 + (b - 48) as i64;
    // 2147483648 == |i32 min|; anything past it can't fit
    // either sign. Bounding here also keeps `acc` small
    // enough that it never overflows the i64 itself.
    if (acc > 2147483648) {
      return None;
    }
    i = i + 1;
  }
  // Negatives reach down to -2147483648; positives top out
  // one lower at 2147483647.
  if (neg) {
    return Some((0 - acc) as i32);
  }
  if (acc > 2147483647) {
    return None;
  }
  return Some(acc as i32);
}

// `json_get_i64(obj, key)` — typed-extract a JNumber as i64. Like
// `json_get_i32` but accumulates in 64-bit, for fields wider than i32
// (timestamps, large ids). A non-numeric value or a non-digit body returns
// None. Overflow now signals None rather than wrapping silently (#4384
// item 4): the positive magnitude is accumulated in i64, and a two's-
// complement wrap past i64 max shows up as a negative accumulator while
// a >19-digit body can't fit at all — both return None. (Edge: i64 min,
// -9223372036854775808, has magnitude 2^63 which the positive accumulator
// can't hold, so it too reads as overflow; callers needing exactly the
// minimum must special-case it.)
pub function json_get_i64(obj: JsonValue, key: string): Option[i64] {
  match (json_get(obj, key)) {
    Some(v) => {
      match (v) {
        JNumber(s) => {
          return __json_number_i64(s);
        },
        _ => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
  return None;
}

// __json_number_i64 reads a JNumber's decimal text as an i64, None for a
// non-digit body or a value past i64 max (the wrap shows as a negative
// accumulator; more than 19 digits cannot fit at all).
function __json_number_i64(s: string): Option[i64] {
  let n: i64 = 0;
  let i: i32 = 0;
  let sign: i64 = 1;
  let nlen: i32 = s.len();
  let digits: i32 = 0;
  if (nlen == 0) {
    return None;
  }
  if (s[0] == 45) {
    sign = 0 - 1;
    i = 1;
  }
  if (i >= nlen) {
    return None;
  }
  while (i < nlen) {
    let b: i32 = s[i] as i32;
    if (b < 48 || b > 57) {
      return None;
    }
    n = n * 10 + (b - 48) as i64;
    digits = digits + 1;
    if (n < 0 || digits > 19) {
      return None;
    }
    i = i + 1;
  }
  return Some(n * sign);
}

// __json_number_u64 reads a JNumber's decimal text as a u64: digits only,
// None for a sign, a non-digit body or a value past u64 max.
function __json_number_u64(s: string): Option[u64] {
  let n: u64 = 0;
  let i: i32 = 0;
  let nlen: i32 = s.len();
  if (nlen == 0) {
    return None;
  }
  while (i < nlen) {
    let b: i32 = s[i] as i32;
    if (b < 48 || b > 57) {
      return None;
    }
    let d: u64 = (b - 48) as u64;
    // 1844674407370955161 is u64 max with its last digit (5) dropped.
    if (n > 1844674407370955161) {
      return None;
    }
    if (n == 1844674407370955161 && d > 5) {
      return None;
    }
    n = n * 10 + d;
    i = i + 1;
  }
  return Some(n);
}

// `json_get_f64(obj, key)` — typed-extract a JNumber as f64. The
// float accessor JSON needs but lacked: `3.14` parses fine but the
// integer getters reject it, so before this there was no way to read
// a fractional field back out (#4384 item 4). Returns None when the
// key is missing or the value isn't a number; any JSON number (int,
// fraction, or exponent form) decodes via std/string's parse_float
// (#5420 — the raw text of a parser-validated JNumber is a valid
// parse_float input, so the Some/None split falls out for free).
pub function json_get_f64(obj: JsonValue, key: string): Option[f64] {
  match (json_get(obj, key)) {
    Some(v) => {
      match (v) {
        JNumber(s) => {
          return s.parse_float();
        },
        _ => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
  return None;
}

// `json_get_bool(obj, key)` — typed-extract a JBool.
pub function json_get_bool(obj: JsonValue, key: string): Option[boolean] {
  match (json_get(obj, key)) {
    Some(v) => {
      match (v) {
        JBool(b) => {
          return Some(b);
        },
        _ => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
  return None;
}

// `json_get_array(obj, key)` — typed-extract a JArray.
// Returns the array's element list directly so callers can
// `len()` / index over it without further matching.
pub function json_get_array(obj: JsonValue, key: string): Option[JsonValue[]] {
  match (json_get(obj, key)) {
    Some(v) => {
      match (v) {
        JArray(arr) => {
          return Some(arr);
        },
        _ => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
  return None;
}

// `json_get_object(obj, key)` — typed-extract a JObject as
// a JsonValue (chain extracts through nested objects).
// Doesn't unwrap to the JsonObject — the JsonValue
// shape composes with the other json_get_* helpers, so
// chains read more naturally as:
//
//   let addr = json_get_object(user, "address");
//   let city = json_get_string(addr.unwrap_or(JNull), "city");
//
// (The unwrap_or pattern works around chained-Option
// unwrapping until Fern grows a `?.` operator.)
pub function json_get_object(obj: JsonValue, key: string): Option[JsonValue] {
  match (json_get(obj, key)) {
    Some(v) => {
      match (v) {
        JObject(_) => {
          return Some(v);
        },
        _ => {
          return None;
        }
      }
    },
    None => {
      return None;
    }
  }
  return None;
}

// `__json_ptr_unescape(tok)` — decode a single RFC 6901 reference
// token: `~1` -> `/` and `~0` -> `~`, in one left-to-right pass so
// `~01` correctly decodes to `~1` (not `/`). A lone `~` not followed
// by `0`/`1` is passed through literally (lenient). Tokens are short
// keys, so the `out + …` build is fine and only runs on the rare
// escape-bearing path (a `~`-free token returns unchanged).
function __json_ptr_unescape(tok: string): string {
  let n: i32 = tok.len();
  let has: boolean = false;
  let i: i32 = 0;
  while (i < n) {
    if (tok[i] == 126) {  // '~' = 126
      has = true;
      i = n;
    } else {
      i = i + 1;
    }
  }
  if (!has) {
    return tok;
  }
  // Byte-level rebuild: pass-through bytes of a valid string stay
  // valid, and the ~0/~1 escapes are ASCII.
  let out: u8[] = [];
  i = 0;
  while (i < n) {
    let c: i32 = tok[i] as i32;
    if (c == 126 && i + 1 < n) {
      let d: i32 = tok[i + 1] as i32;
      if (d == 49) {  // ~1 -> /
        out = out.append(47 as u8);
        i = i + 2;
      } else if (d == 48) {  // ~0 -> ~
        out = out.append(126 as u8);
        i = i + 2;
      } else {
        out = out.append(tok[i]);
        i = i + 1;
      }
    } else {
      out = out.append(tok[i]);
      i = i + 1;
    }
  }
  return string_from_bytes_unchecked(out);
}

// `__json_ptr_index(tok)` — parse an RFC 6901 array-index token to a
// non-negative i32, or -1 if it isn't a valid index. Per §4 the token
// must be `0` or `[1-9][0-9]*` — leading zeros, the `-` end-of-array
// token, non-digits, and out-of-i32 magnitudes all yield -1 (a
// guaranteed miss).
function __json_ptr_index(tok: string): i32 {
  let n: i32 = tok.len();
  if (n == 0) {
    return 0 - 1;
  }
  if (tok[0] == 48 && n > 1) {  // leading zero
    return 0 - 1;
  }
  let acc: i64 = 0;
  let i: i32 = 0;
  while (i < n) {
    let b: i32 = tok[i] as i32;
    if (b < 48 || b > 57) {
      return 0 - 1;
    }
    acc = acc * 10 + (b - 48) as i64;
    if (acc > 2147483647) {  // past any real array length
      return 0 - 1;
    }
    i = i + 1;
  }
  return acc as i32;
}

// `json_pointer(doc, pointer)` — resolve an RFC 6901 JSON Pointer
// against a JsonValue tree. `""` selects the whole document; a
// non-empty pointer must start with `/`, and each `/`-separated
// reference token descends one level: a token indexes a JObject by
// key or a JArray by numeric index (`~1`/`~0` unescape to `/`/`~` in
// keys). Returns None on a missing key, an out-of-range or malformed
// array index, a descent into a scalar, or a pointer that doesn't
// begin with `/`.
//
//   json_pointer(doc, "/user/tags/0")   // first tag
//   json_pointer(doc, "/a~1b")          // key literally "a/b"
pub function json_pointer(doc: JsonValue, pointer: string): Option[JsonValue] {
  let n: i32 = pointer.len();
  if (n == 0) {
    return Some(doc);
  }
  if (pointer[0] != 47) {  // must start with '/' = 47
    return None;
  }
  let cur: JsonValue = doc;
  let i: i32 = 1;  // past the leading '/'
  while (i <= n) {
    // Token runs from i up to the next '/' (or the end).
    let j: i32 = i;
    while (j < n && pointer[j] != 47) {
      j = j + 1;
    }
    let tok: string = __json_ptr_unescape(slice_unchecked(pointer, i, j));
    match (cur) {
      JObject(m) => {
        match (m.get(tok)) {
          Some(v) => {
            cur = v;
          },
          None => {
            return None;
          }
        }
      },
      JArray(arr) => {
        let idx: i32 = __json_ptr_index(tok);
        if (idx < 0 || idx >= arr.len()) {
          return None;
        }
        cur = arr[idx];
      },
      _ => {
        return None;
      }
    }
    i = j + 1;  // past the terminating '/'
  }
  return Some(cur);
}

// `json_is_null(v)` — true iff `v` is JNull. Convenience
// over the bare match for the common nullability check.
pub function json_is_null(v: JsonValue): boolean {
  match (v) {
    JNull => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// === Json trait + @derive(Json) ===
//
// `Json` is the structural-serialisation spine: `v.to_json()` returns
// canonical JSON text. `@derive(Json)` synthesises it field-/variant-
// wise (the checker's synthJson / synthEnumJson) so a type serialises as
// soon as its fields do — no per-type encoder. A struct becomes a JSON
// object (`{"field":<value>}`), an enum is externally tagged (a unit
// variant is its name as a JSON string; a payload variant is a single-
// key object, multiple payloads a JSON array). The primitive impls below
// are the leaves of that composition; string values are escaped through
// the same `json_escape` the `JsonValue` encoder uses.
//
//   @derive(json.Json)
//   struct User { id: i32, name: string, admin: boolean }
//   let body: string = User { id: 7, name: "Glóin", admin: true }.to_json();
//   // {"id":7,"name":"Glóin","admin":true}
//
// Floats are leaves too (decimal `to_string`). Arrays serialise via the
// generic `(xs: T[]) to_json[T: Json]()` below (#2766); map objects are a
// remaining follow-up.
pub trait Json {
  function to_json(self: Self): string;
}

impl Json for i32 {
  function to_json(self: i32): string {
    return self.to_string();
  }
}

impl Json for i64 {
  function to_json(self: i64): string {
    return self.to_string();
  }
}

impl Json for u32 {
  function to_json(self: u32): string {
    return self.to_string();
  }
}

impl Json for u64 {
  function to_json(self: u64): string {
    return self.to_string();
  }
}

impl Json for boolean {
  function to_json(self: boolean): string {
    if (self) {
      return "true";
    }
    return "false";
  }
}

// Floats serialise as their decimal `to_string`. Like the `JNumber`
// encoder, valid JSON numeric formatting is the caller's responsibility:
// a non-finite value (NaN / ±Inf) has no JSON representation and would
// produce invalid output — guard those before serialising if they can
// occur.
impl Json for f64 {
  function to_json(self: f64): string {
    return self.to_string();
  }
}

impl Json for f32 {
  function to_json(self: f32): string {
    return self.to_string();
  }
}

impl Json for string {
  function to_json(self: string): string {
    return "\"" + json_escape(self) + "\"";
  }
}

// Array serialiser: a `T[]` whose element type is `Json` renders as a JSON
// array `[e0,e1,…]`. Element-polymorphic + method-level bounded, so it works
// for arrays of scalars, strings, and `@derive(Json)` structs/enums. The
// monomorphiser folds the method into a free generic and clones it once per
// element type (`__arrm_`, compiler/parser.fern); `xs[i].to_json()` then
// dispatches to the element type's impl (the cross-module trait-method
// visibility this relies on landed in #2774).
pub function (xs: T[]) to_json[T: Json](): string {
  // Local growable u8[] accumulation (#4379), like json_encode's JArray arm:
  // the old `out = out + xs[i].to_json()` recopied the whole encoded-so-far
  // prefix on every element — O(array²). Every append targets the local `out`,
  // so it grows in place (amortized O(1)); the per-element bytes are inlined.
  // Byte-for-byte identical output.
  let out: u8[] = [];
  out = out.append(91 as u8);  // '['
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i > 0) {  // ','
      out = out.append(44 as u8);
    }
    let e: string = xs[i].to_json();
    let el: i32 = e.len();
    let k: i32 = 0;
    while (k < el) {
      out = out.append(e[k] as u8);
      k = k + 1;
    }
    i = i + 1;
  }
  out = out.append(93 as u8);  // ']'
  return string_from_bytes_unchecked(out);
}

// === FromJson trait + @derive(FromJson) ===
//
// `FromJson` is the decode half of `Json`: `T.from_json_value(v)` builds a
// `T` from a parsed `JsonValue`, `Err(why)` when the value has the wrong
// shape. `@derive(json.FromJson)` synthesises it field-wise for a struct
// (the checker's synthFromJsonValue), with the companion `T.from_json(text)`
// that parses the text first. The primitive impls below are the leaves; a
// nested struct decodes through its own impl, an array field through
// `from_json_array`, an `Option` field through `from_json_option`, so a
// struct decodes as soon as its fields do. A shape error names where it
// happened: `missing field "id"`, `field "id": expected an integer, got a
// string`, `field "tags": [1]: expected a string, got null`.
//
//   @derive(json.Json, json.FromJson)
//   struct User { id: i32, name: string, tags: string[], nick: Option[string] }
//   let u: User = json.decode[User](text)?;      // or User.from_json(text)
//
// `decode[T](text)` parses and decodes in one call; a parse failure reads
// `invalid JSON: <line>:<col>: <why>`. An HTTP handler reaches the same
// decoder through `http.body_json[T](req)`, which also checks the media
// type and answers each failure with its own status.
pub trait FromJson {
  function from_json_value(v: JsonValue): Result[Self, string];
}

// `json_kind(v)` — what a value is, for a shape error's "got ...".
pub function json_kind(v: JsonValue): string {
  match (v) {
    JNull => {
      return "null";
    },
    JBool(b) => {
      return "a boolean";
    },
    JNumber(s) => {
      return "a number";
    },
    JString(s) => {
      return "a string";
    },
    JArray(xs) => {
      return "an array";
    },
    JObject(m) => {
      return "an object";
    }
  }
  return "";
}

impl FromJson for i32 {
  function from_json_value(v: JsonValue): Result[i32, string] {
    match (v) {
      JNumber(s) => {
        match (__json_number_i32(s)) {
          Some(n) => {
            return Ok(n);
          },
          None => {
            return Err("expected an integer in the i32 range, got " + s);
          }
        }
      },
      _ => {
        return Err("expected an integer, got " + json_kind(v));
      }
    }
    return Err("");
  }
}

impl FromJson for i64 {
  function from_json_value(v: JsonValue): Result[i64, string] {
    match (v) {
      JNumber(s) => {
        match (__json_number_i64(s)) {
          Some(n) => {
            return Ok(n);
          },
          None => {
            return Err("expected an integer in the i64 range, got " + s);
          }
        }
      },
      _ => {
        return Err("expected an integer, got " + json_kind(v));
      }
    }
    return Err("");
  }
}

impl FromJson for u32 {
  function from_json_value(v: JsonValue): Result[u32, string] {
    match (v) {
      JNumber(s) => {
        match (__json_number_i64(s)) {
          Some(n) => {
            if (n < 0 || n > 4294967295) {
              return Err("expected an integer in the u32 range, got " + s);
            }
            return Ok(n as u32);
          },
          None => {
            return Err("expected an integer in the u32 range, got " + s);
          }
        }
      },
      _ => {
        return Err("expected an integer, got " + json_kind(v));
      }
    }
    return Err("");
  }
}

impl FromJson for u64 {
  function from_json_value(v: JsonValue): Result[u64, string] {
    match (v) {
      JNumber(s) => {
        match (__json_number_u64(s)) {
          Some(n) => {
            return Ok(n);
          },
          None => {
            return Err("expected an integer in the u64 range, got " + s);
          }
        }
      },
      _ => {
        return Err("expected an integer, got " + json_kind(v));
      }
    }
    return Err("");
  }
}

impl FromJson for f64 {
  function from_json_value(v: JsonValue): Result[f64, string] {
    match (v) {
      JNumber(s) => {
        match (s.parse_float()) {
          Some(f) => {
            return Ok(f);
          },
          None => {
            return Err("expected a number, got " + s);
          }
        }
      },
      _ => {
        return Err("expected a number, got " + json_kind(v));
      }
    }
    return Err("");
  }
}

impl FromJson for f32 {
  function from_json_value(v: JsonValue): Result[f32, string] {
    match (v) {
      JNumber(s) => {
        match (s.parse_float()) {
          Some(f) => {
            return Ok(f as f32);
          },
          None => {
            return Err("expected a number, got " + s);
          }
        }
      },
      _ => {
        return Err("expected a number, got " + json_kind(v));
      }
    }
    return Err("");
  }
}

impl FromJson for boolean {
  function from_json_value(v: JsonValue): Result[boolean, string] {
    match (v) {
      JBool(b) => {
        return Ok(b);
      },
      _ => {
        return Err("expected a boolean, got " + json_kind(v));
      }
    }
    return Err("");
  }
}

impl FromJson for string {
  function from_json_value(v: JsonValue): Result[string, string] {
    match (v) {
      JString(s) => {
        return Ok(s);
      },
      _ => {
        return Err("expected a string, got " + json_kind(v));
      }
    }
    return Err("");
  }
}

// `decode[T](text)` — parse `text` and decode it as a `T`.
pub function decode[T: FromJson](text: string): Result[T, string] {
  match (json_parse_result(text)) {
    Ok(v) => {
      return T.from_json_value(v);
    },
    Err(e) => {
      return Err("invalid JSON: " + e.to_string());
    }
  }
  return Err("");
}

// `from_json_elem[T](v)` — `v` decoded as a `T`. A derived FromJson decodes
// each plain field through it, so the field type is named in type position,
// where an imported module of the same name (`std/i32`, `std/string`) cannot
// take it for a module-qualified call.
pub function from_json_elem[T: FromJson](v: JsonValue): Result[T, string] {
  return T.from_json_value(v);
}

// `from_json_array[T](v)` — every element of a JSON array as a `T`; an
// element's shape error is prefixed with its index.
pub function from_json_array[T: FromJson](v: JsonValue): Result[T[], string] {
  match (v) {
    JArray(xs) => {
      let out: T[] = [];
      let i: i32 = 0;
      while (i < xs.len()) {
        match (T.from_json_value(xs[i])) {
          Ok(x) => {
            out = out.append(x);
          },
          Err(why) => {
            return Err(from_json_index(i, why));
          }
        }
        i = i + 1;
      }
      return Ok(out);
    },
    _ => {
      return Err("expected an array, got " + json_kind(v));
    }
  }
  return Err("");
}

// `from_json_option[T](v)` — `None` for an absent value, else the value
// decoded as a `T`. The derive pairs it with `from_json_optional_field`.
pub function from_json_option[T: FromJson](v: Option[JsonValue]): Result[Option[T], string] {
  match (v) {
    Some(jv) => {
      match (T.from_json_value(jv)) {
        Ok(x) => {
          return Ok(Some(x));
        },
        Err(why) => {
          return Err(why);
        }
      }
    },
    None => {
      return Ok(None);
    }
  }
  return Err("");
}

// The derive's field readers. `from_json_field(v, name)` is the field's
// value, `Err` for a value that is not an object or a field that is not
// there; `from_json_optional_field` answers `Ok(None)` for a field that is
// missing or null instead; `from_json_at(name, why)` prefixes a field's
// shape error with its name.
pub function from_json_field(v: JsonValue, name: string): Result[JsonValue, string] {
  match (v) {
    JObject(m) => {
      match (m.get(name)) {
        Some(fv) => {
          return Ok(fv);
        },
        None => {
          return Err("missing field \"" + name + "\"");
        }
      }
    },
    _ => {
      return Err("expected an object, got " + json_kind(v));
    }
  }
  return Err("");
}

pub function from_json_optional_field(v: JsonValue, name: string): Result[Option[JsonValue], string] {
  match (v) {
    JObject(m) => {
      match (m.get(name)) {
        Some(fv) => {
          match (fv) {
            JNull => {
              return Ok(None);
            },
            _ => {
              return Ok(Some(fv));
            }
          }
        },
        None => {
          return Ok(None);
        }
      }
    },
    _ => {
      return Err("expected an object, got " + json_kind(v));
    }
  }
  return Err("");
}

pub function from_json_at(name: string, why: string): string {
  return "field \"" + name + "\": " + why;
}

// `from_json_index(i, why)` prefixes element i's shape error with its index.
pub function from_json_index(i: i32, why: string): string {
  return "[" + i.to_string() + "]: " + why;
}

// The enum derive's readers. A derived enum's JSON is its variant's name: a
// string for a unit variant, else an object whose one key is the name and
// whose value is the payload. `from_json_variant(v)` is that name,
// `from_json_payload(v)` the payload (null for the string form), and
// `from_json_in(name, why)` prefixes a payload's shape error with the variant.
pub function from_json_variant(v: JsonValue): Result[string, string] {
  match (v) {
    JString(s) => {
      return Ok(s);
    },
    JObject(m) => {
      if (m.len() != 1) {
        return Err("expected an object with one key, got " + m.len().to_string());
      }
      return Ok(m.names[0]);
    },
    _ => {
      return Err("expected a variant name or a one-key object, got " + json_kind(v));
    }
  }
  return Err("");
}

pub function from_json_payload(v: JsonValue): JsonValue {
  match (v) {
    JObject(m) => {
      if (m.len() == 1) {
        return m.items[0];
      }
    },
    _ => {}
  }
  return JNull;
}

pub function from_json_in(variant: string, why: string): string {
  return "variant \"" + variant + "\": " + why;
}

pub function from_json_unknown_variant(name: string): string {
  return "unknown variant \"" + name + "\"";
}

// `from_json_item(p, i, n)` is payload i of a variant with n positional
// payloads: p itself when n is 1, else element i of p, an array of n.
// `from_json_optional_item` answers `Ok(None)` for a null one instead.
pub function from_json_item(p: JsonValue, i: i32, n: i32): Result[JsonValue, string] {
  if (n == 1) {
    return Ok(p);
  }
  match (p) {
    JArray(xs) => {
      if (xs.len() != n) {
        return Err("expected an array of " + n.to_string() + ", got " + xs.len().to_string());
      }
      return Ok(xs[i]);
    },
    _ => {
      return Err("expected an array, got " + json_kind(p));
    }
  }
  return Err("");
}

pub function from_json_optional_item(p: JsonValue, i: i32, n: i32): Result[Option[JsonValue], string] {
  match (from_json_item(p, i, n)) {
    Ok(x) => {
      match (x) {
        JNull => {
          return Ok(None);
        },
        _ => {
          return Ok(Some(x));
        }
      }
    },
    Err(why) => {
      return Err(why);
    }
  }
  return Err("");
}
