// std/json — JSON encode / decode over the built-in
// `JsonValue` enum.
//
// `json_encode(v)` walks the `JsonValue` tree and produces
// canonical JSON text. `json_parse(s)` is the inverse —
// recursive descent over a `__JsonParser` state struct,
// returning `Option[JsonValue]` (None on any malformed input).
//
// Numbers are stored verbatim as `JNumber`'s string payload;
// the responsibility for valid numeric formatting sits with
// the caller. String escapes are decoded on parse (`\"`,
// `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`, `\uXXXX` for BMP
// code points). Surrogate pairs aren't combined yet.
//
// No prelude: these are in scope only after a program
// declares `import "std/json";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

// === JSON encoding ===
//
// `json_encode(v)` walks the `JsonValue` tree and produces
// the canonical JSON text. Strings are escape-
// encoded; arrays / objects recurse. Numbers emit their
// payload string verbatim — the responsibility for valid
// numeric formatting sits with the caller.

// json_encode walks Map[string, JsonValue] for JObject values
// via `.iter()` / `.has_next()` / `.key()` / `.value()`;
// json_parse builds one with `map_new` / `.insert(...)`. Declare
// core/map so the receiver methods register under no-prelude
// and the Map runtime helpers link cleanly.
import "core/map";
// String / byte methods inside the encoder / parser bodies.
import "std/string";
import "std/i32";
// Numeric `to_string` for the `impl Json for <int>` serialisers.
import "std/i64";
import "std/u32";
import "std/u64";
// Float `to_string` for the `impl Json for f32 / f64` serialisers.
import "std/float";

function __json_hex_lower(d: i32): i32 {
    if (d < 10) { return d + 48; }   // '0' + d
    return d + 87;                    // 'a' - 10 + d
}

// `json.json_escape(s)` — escape a raw string for embedding inside a
// JSON string literal (the caller supplies the surrounding quotes).
// Backslash and double-quote are backslash-escaped, newline / carriage-
// return / tab take their short escapes (\n \r \t), and every other C0
// control byte (0x00-0x08, 0x0B, 0x0C, 0x0E-0x1F) — forbidden bare in a
// JSON string — is emitted as lowercase `\u00XX`. Everything else
// passes through byte-for-byte (UTF-8 sequences are >= 0x80, so
// multi-byte characters are untouched). This is the ONE shared JSON
// string escaper: the `JsonValue` encoder, `@derive(json.Json)`'s
// string leaf, and `std/log`'s JSON-lines mode all route through it
// (#4388 item 4 — it was previously copy-pasted per consumer).
pub function json_escape(s: string): string {
    var n: i32 = s.len();
    // Two-pass exact-size buffer (#4379): the five named escapes (" \ \n \r \t)
    // expand to 2 bytes, any other control byte (<32) to a 6-byte \u00XX, and
    // everything else passes through 1:1. Replaces the O(n²) `out = out + …` that
    // recopied the growing result each byte.
    var total: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 34 || b == 92 || b == 10 || b == 13 || b == 9) { total = total + 2; }
        else if (b < 32) { total = total + 6; }
        else { total = total + 1; }
        i = i + 1;
    }
    var buf: u8[] = __alloc_u8(total);
    var pos: i32 = 0;
    i = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 34)      { buf = buf.with(pos, 92 as u8); buf = buf.with(pos + 1, 34 as u8);  pos = pos + 2; }   // \"
        else if (b == 92) { buf = buf.with(pos, 92 as u8); buf = buf.with(pos + 1, 92 as u8);  pos = pos + 2; }   // \\
        else if (b == 10) { buf = buf.with(pos, 92 as u8); buf = buf.with(pos + 1, 110 as u8); pos = pos + 2; }   // \n
        else if (b == 13) { buf = buf.with(pos, 92 as u8); buf = buf.with(pos + 1, 114 as u8); pos = pos + 2; }   // \r
        else if (b == 9)  { buf = buf.with(pos, 92 as u8); buf = buf.with(pos + 1, 116 as u8); pos = pos + 2; }   // \t
        else if (b < 32) {
            // \u00XX with lowercase hex.
            buf = buf.with(pos, 92 as u8);       // \
            buf = buf.with(pos + 1, 117 as u8);  // u
            buf = buf.with(pos + 2, 48 as u8);   // 0
            buf = buf.with(pos + 3, 48 as u8);   // 0
            buf = buf.with(pos + 4, __json_hex_lower((b >> 4) & 15) as u8);
            buf = buf.with(pos + 5, __json_hex_lower(b & 15) as u8);
            pos = pos + 6;
        } else {
            buf = buf.with(pos, s[i] as u8);
            pos = pos + 1;
        }
        i = i + 1;
    }
    return string_from_bytes_unchecked(buf);
}

pub function json_encode(v: JsonValue): string {
    // Single shared `buf` and `i` across match arms — the
    // wasm emitter names locals by lang identifier, so
    // re-declaring a `var` in nested scopes collides
    // (same footgun parse_float hit). Only one composite arm
    // runs per call, so the shared `buf` needs no reset.
    var buf: u8[] = [];
    var i: i32 = 0;
    match (v) {
        JNull => { return "null"; },
        JBool(b) => {
            if (b) { return "true"; }
            return "false";
        },
        JNumber(s) => { return s; },
        JString(s) => {
            return "\"" + json_escape(s) + "\"";
        },
        JArray(arr) => {
            // Accumulate this level into a LOCAL u8[] (#4379) rather than
            // `out = out + json_encode(arr[i])`, which recopied the whole
            // encoded-so-far prefix on every element — O(level²) at each nesting
            // level. Every append targets the local `buf`, so it grows in place
            // (amortized O(1)); the child bytes are inlined (not routed through a
            // helper, whose borrowed-param append would copy per call). Byte-for-
            // byte identical output.
            buf = buf.append(91 as u8);   // '['
            var n: i32 = arr.len();
            while (i < n) {
                if (i > 0) { buf = buf.append(44 as u8); }   // ','
                var enc: string = json_encode(arr[i]);
                var el: i32 = enc.len();
                var k: i32 = 0;
                while (k < el) {
                    buf = buf.append(enc[k] as u8);
                    k = k + 1;
                }
                i = i + 1;
            }
            buf = buf.append(93 as u8);   // ']'
            return string_from_bytes_unchecked(buf);
        },
        JObject(m) => {
            // Keys are emitted straight off the map's iteration
            // cursor, which is INSERTION order for a map built by
            // inserts alone — so a decode→encode round-trip
            // preserves key order. A map that has had a key
            // `delete`d iterates in the swap-with-last order
            // instead (see core/map's "Iteration order" contract,
            // #4388); JSON object member order is not semantically
            // significant, so this only affects byte-exactness.
            // Same local-u8[] accumulation as JArray (#4379): the old
            // `out = out + …` recopied the growing object text on every member.
            buf = buf.append(123 as u8);   // '{'
            var first: boolean = true;
            var iter: MapIter[string, JsonValue] = m.iter();
            while (iter.has_next()) {
                if (!first) { buf = buf.append(44 as u8); }   // ','
                first = false;
                buf = buf.append(34 as u8);   // '"'
                var ek: string = json_escape(iter.key());
                var ekl: i32 = ek.len();
                var kk: i32 = 0;
                while (kk < ekl) {
                    buf = buf.append(ek[kk] as u8);
                    kk = kk + 1;
                }
                buf = buf.append(34 as u8);   // '"'
                buf = buf.append(58 as u8);   // ':'
                var ev: string = json_encode(iter.value());
                var evl: i32 = ev.len();
                var vk: i32 = 0;
                while (vk < evl) {
                    buf = buf.append(ev[vk] as u8);
                    vk = vk + 1;
                }
                iter.advance();
            }
            buf = buf.append(125 as u8);   // '}'
            return string_from_bytes_unchecked(buf);
        }
    }
}

// === JSON pretty-printing ===
//
// `json_encode_pretty(v, indent)` renders the same JSON as
// `json_encode` but human-readable: each array element / object member
// on its own line, nested `indent` spaces deeper per level. Empty
// arrays / objects stay on one line (`[]` / `{}`). Scalars and string
// escaping are identical to `json_encode`, so the two agree on every
// value token — only whitespace differs. `indent` is spaces per level
// (2 is the common default; 0 yields newlines with no indentation).

// __json_spaces returns a string of `n` spaces.
function __json_spaces(n: i32): string {
    var b: u8[] = [];
    var i: i32 = 0;
    while (i < n) {
        b = b.append(32 as u8);
        i = i + 1;
    }
    return string_from_bytes_unchecked(b);
}

// __json_append_str appends `s`'s bytes onto `buf` (the same local-u8[]
// accumulation json_encode uses to avoid O(n²) string concat).
function __json_append_str(buf: u8[], s: string): u8[] {
    var i: i32 = 0;
    var out: u8[] = buf;
    while (i < s.len()) {
        out = out.append(s[i] as u8);
        i = i + 1;
    }
    return out;
}

function __json_pretty(v: JsonValue, indent: i32, depth: i32): string {
    match (v) {
        JNull => { return "null"; },
        JBool(b) => {
            if (b) { return "true"; }
            return "false";
        },
        JNumber(s) => { return s; },
        JString(s) => { return "\"" + json_escape(s) + "\""; },
        JArray(arr) => {
            var n: i32 = arr.len();
            if (n == 0) { return "[]"; }
            var inner: string = __json_spaces((depth + 1) * indent);
            var close: string = __json_spaces(depth * indent);
            var buf: u8[] = [];
            buf = buf.append(91 as u8);           // '['
            buf = __json_append_str(buf, "\n");
            var i: i32 = 0;
            while (i < n) {
                if (i > 0) { buf = __json_append_str(buf, ",\n"); }
                buf = __json_append_str(buf, inner);
                buf = __json_append_str(buf, __json_pretty(arr[i], indent, depth + 1));
                i = i + 1;
            }
            buf = __json_append_str(buf, "\n");
            buf = __json_append_str(buf, close);
            buf = buf.append(93 as u8);           // ']'
            return string_from_bytes_unchecked(buf);
        },
        JObject(m) => {
            if (m.len() == 0) { return "{}"; }
            var inner: string = __json_spaces((depth + 1) * indent);
            var close: string = __json_spaces(depth * indent);
            var buf: u8[] = [];
            buf = buf.append(123 as u8);          // '{'
            buf = __json_append_str(buf, "\n");
            var first: boolean = true;
            var iter: MapIter[string, JsonValue] = m.iter();
            while (iter.has_next()) {
                if (!first) { buf = __json_append_str(buf, ",\n"); }
                first = false;
                buf = __json_append_str(buf, inner);
                buf = buf.append(34 as u8);       // '"'
                buf = __json_append_str(buf, json_escape(iter.key()));
                buf = buf.append(34 as u8);       // '"'
                buf = __json_append_str(buf, ": ");
                buf = __json_append_str(buf, __json_pretty(iter.value(), indent, depth + 1));
                iter.advance();
            }
            buf = __json_append_str(buf, "\n");
            buf = __json_append_str(buf, close);
            buf = buf.append(125 as u8);          // '}'
            return string_from_bytes_unchecked(buf);
        }
    }
}

// `json_encode_pretty(v, indent)` — indented, human-readable JSON.
pub function json_encode_pretty(v: JsonValue, indent: i32): string {
    return __json_pretty(v, indent, 0);
}

// === JSON parsing ===
//
// `json_parse(s)` is the inverse of `json_encode`. Returns
// `Option[JsonValue]`; `None` on any malformed input.
// Recursive descent over a `__JsonParser` state struct
// (s + pos + error). Numbers are stored verbatim as
// `JNumber`'s string payload. String escapes are decoded
// (`\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`,
// `\uXXXX` for BMP code points). Surrogate pairs aren't
// combined yet.

struct __JsonParser {
    s: string,
    pos: i32,
    error: i32,
    // Current container-nesting depth, threaded through every
    // cursor so the recursive descent can bound how deep it
    // will go. A hostile `[[[[…` / `{"a":{"a":{…` body would
    // otherwise recurse without limit and overflow the stack
    // (a DoS on an untrusted request body). The cap is 128 (see
    // __json_p_value), matching serde_json's default recursion
    // limit — well clear of any realistic document, well short of
    // a stack overflow.
    depth: i32,
}

// __json_p_skip_ws advances past leading whitespace and returns
// the advanced cursor. Advance-only: no value to surface, so it
// returns just the new __JsonParser (rebind: `p = __json_p_skip_ws(p);`).
function __json_p_skip_ws(p: __JsonParser): __JsonParser {
    var cur: __JsonParser = p;
    var n: i32 = cur.s.len();
    while (cur.pos < n) {
        var b: i32 = cur.s[cur.pos];
        if (b != 32 && b != 9 && b != 10 && b != 13) { break; }
        cur = __JsonParser { ...cur, pos: cur.pos + 1 };
    }
    return cur;
}

function __json_p_byte(p: __JsonParser): i32 {
    if (p.pos >= p.s.len()) { return 0; }
    return p.s[p.pos];
}

function __json_hex_value(c: i32): i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70)  { return c - 55; }
    return -1;
}

// __json_p_number consumes a JSON number and returns the
// decoded JNumber plus the advanced cursor: `(JsonValue,
// __JsonParser)`. On a malformed number it threads back a
// cursor with `error: 1` and a JNull placeholder.
function __json_p_number(p0: __JsonParser): (JsonValue, __JsonParser) {
    // Copy the borrowed parameter into a local before threading it
    // through struct-updates. Reassigning the *parameter* in a loop
    // and returning it trips an RC over-release in the current
    // struct-update lowering (a separate codegen bug); the local
    // copy — the same shape __json_p_skip_ws uses — sidesteps it.
    var p: __JsonParser = p0;
    var start: i32 = p.pos;
    var n: i32 = p.s.len();
    var b: i32 = 0;
    // Optional '-'
    if (__json_p_byte(p) == 45) { p = __JsonParser { ...p, pos: p.pos + 1 }; }
    // At least one digit.
    b = __json_p_byte(p);
    if (b < 48 || b > 57) { return (JNull, __JsonParser { ...p, error: 1 }); }
    // Integer digits.
    while (p.pos < n) {
        b = p.s[p.pos];
        if (b < 48 || b > 57) { break; }
        p = __JsonParser { ...p, pos: p.pos + 1 };
    }
    // Optional '.<digits>'.
    if (__json_p_byte(p) == 46) {
        p = __JsonParser { ...p, pos: p.pos + 1 };
        while (p.pos < n) {
            b = p.s[p.pos];
            if (b < 48 || b > 57) { break; }
            p = __JsonParser { ...p, pos: p.pos + 1 };
        }
    }
    // Optional [eE][+-]?<digits>.
    b = __json_p_byte(p);
    if (b == 101 || b == 69) {
        p = __JsonParser { ...p, pos: p.pos + 1 };
        b = __json_p_byte(p);
        if (b == 43 || b == 45) { p = __JsonParser { ...p, pos: p.pos + 1 }; }
        while (p.pos < n) {
            b = p.s[p.pos];
            if (b < 48 || b > 57) { break; }
            p = __JsonParser { ...p, pos: p.pos + 1 };
        }
    }
    return (JNumber(p.s[start:p.pos] + ""), p);
}

// __json_emit_codepoint encodes a single Unicode scalar value
// as the matching UTF-8 byte sequence (1-4 bytes) and appends
// it to `out`. Supports the full Unicode range up to
// U+10FFFF; the caller is expected to have resolved any
// surrogate pairs into a single code point already.
// The UTF-8 byte sequence (1–4 bytes) for a Unicode scalar value. Pure — the
// caller appends the returned bytes to its output buffer, so no growing string
// is threaded through (see __json_p_string's O(n) u8[] accumulation, #4379).
function __json_cp_bytes(cp: i32): u8[] {
    if (cp < 128) {
        return [cp as u8];
    }
    if (cp < 2048) {
        return [
            ((cp >> 6) | 192) as u8,
            ((cp & 63) | 128) as u8
        ];
    }
    if (cp < 65536) {
        return [
            ((cp >> 12) | 224) as u8,
            (((cp >> 6) & 63) | 128) as u8,
            ((cp & 63) | 128) as u8
        ];
    }
    return [
        ((cp >> 18) | 240) as u8,
        (((cp >> 12) & 63) | 128) as u8,
        (((cp >> 6) & 63) | 128) as u8,
        ((cp & 63) | 128) as u8
    ];
}

// __json_p_uhex parses 4 hex digits at p.pos (without
// consuming the leading `\u`) and returns the decoded value.
// Sets p.error and returns 0 on any non-hex digit or
// past-end-of-input. Does NOT consume the hex digits past
// what it reads — it advances p.pos by 4 on success.
function __json_p_uhex(p0: __JsonParser): (i32, __JsonParser) {
    // See __json_p_number: thread a local copy of the param, not the
    // param itself, to avoid the struct-update RC over-release.
    var p: __JsonParser = p0;
    if (p.pos + 4 > p.s.len()) { return (0, __JsonParser { ...p, error: 1 }); }
    var u: i32 = 0;
    var i: i32 = 0;
    while (i < 4) {
        var hv: i32 = __json_hex_value(p.s[p.pos]);
        if (hv < 0) { return (0, __JsonParser { ...p, error: 1 }); }
        u = (u << 4) | hv;
        p = __JsonParser { ...p, pos: p.pos + 1 };
        i = i + 1;
    }
    return (u, p);
}

// __json_p_string consumes a quoted JSON string and returns the
// decoded value plus the advanced cursor: `(string,
// __JsonParser)`. Error paths thread back a cursor with
// `error: 1` and an empty-string placeholder.
function __json_p_string(p0: __JsonParser): (string, __JsonParser) {
    // See __json_p_number: thread a local copy of the param.
    var p: __JsonParser = p0;
    if (__json_p_byte(p) != 34) { return ("", __JsonParser { ...p, error: 1 }); }
    p = __JsonParser { ...p, pos: p.pos + 1 };
    // Accumulate the decoded value in a LOCAL growable u8[] (#4379): the old
    // `out = out + p.s[p.pos:p.pos+1]` appended one byte at a time onto an
    // immutable string -- O(value²), recopying the whole decoded prefix per
    // character on the hot request-body parse path. Every append targets the
    // local `out`, so it grows in place (amortized O(1)); codepoint escapes emit
    // their 1-4 UTF-8 bytes (from the pure __json_cp_bytes) through the hoisted
    // `cb` / `ci` cursor. Byte-for-byte identical decoding.
    var out: u8[] = [];
    var n: i32 = p.s.len();
    var b: i32 = 0;
    var cb: u8[] = [];
    var ci: i32 = 0;
    while (true) {
        b = __json_p_byte(p);
        if (b == 0) { return ("", __JsonParser { ...p, error: 1 }); }
        if (b == 34) { return (string_from_bytes_unchecked(out), __JsonParser { ...p, pos: p.pos + 1 }); }
        if (b == 92) {                                  // '\\'
            p = __JsonParser { ...p, pos: p.pos + 1 };
            var esc: i32 = __json_p_byte(p);
            if (esc == 0) { return ("", __JsonParser { ...p, error: 1 }); }
            if (esc == 117) {                           // 'u' — \uXXXX
                p = __JsonParser { ...p, pos: p.pos + 1 };
                var (u, pu) = __json_p_uhex(p);
                p = pu;
                if (p.error != 0) { return ("", p); }
                // High surrogate (D800..DBFF): combine with
                // the following low surrogate (DC00..DFFF) to
                // form a single astral code point. Lone or
                // mismatched surrogates fall back to U+FFFD
                // (REPLACEMENT CHARACTER) — matches Go's
                // encoding/json + most strict UTF-8 emitters. The branch
                // funnels to a primary codepoint `cp1` plus, for the
                // mismatched-low-surrogate case, a second `cp2` (-1 = none).
                var cp1: i32 = 65533;
                var cp2: i32 = -1;
                if (u >= 55296 && u <= 56319) {
                    if (p.pos + 6 > n
                        || p.s[p.pos] != 92
                        || p.s[p.pos+1] != 117) {
                        cp1 = 65533;
                    } else {
                        p = __JsonParser { ...p, pos: p.pos + 2 };
                        var (low, pl) = __json_p_uhex(p);
                        p = pl;
                        if (p.error != 0) { return ("", p); }
                        if (low < 56320 || low > 57343) {
                            cp1 = 65533;
                            cp2 = low;
                        } else {
                            cp1 = 65536
                                + ((u - 55296) << 10)
                                + (low - 56320);
                        }
                    }
                } else if (u >= 56320 && u <= 57343) {
                    cp1 = 65533;
                } else {
                    cp1 = u;
                }
                cb = __json_cp_bytes(cp1);
                ci = 0;
                while (ci < cb.len()) { out = out.append(cb[ci] as u8); ci = ci + 1; }
                if (cp2 >= 0) {
                    cb = __json_cp_bytes(cp2);
                    ci = 0;
                    while (ci < cb.len()) { out = out.append(cb[ci] as u8); ci = ci + 1; }
                }
            } else {
                var ch: i32 = -1;
                if (esc == 34 || esc == 92 || esc == 47) { ch = esc; }
                else if (esc == 110) { ch = 10; }
                else if (esc == 114) { ch = 13; }
                else if (esc == 116) { ch = 9; }
                else if (esc == 98)  { ch = 8; }
                else if (esc == 102) { ch = 12; }
                else { return ("", __JsonParser { ...p, error: 1 }); }
                out = out.append(ch as u8);
                p = __JsonParser { ...p, pos: p.pos + 1 };
            }
        } else {
            out = out.append(p.s[p.pos] as u8);
            p = __JsonParser { ...p, pos: p.pos + 1 };
        }
    }
    return ("", p);   // unreachable
}

// __json_p_array consumes a JSON array and returns the decoded
// JArray plus the advanced cursor: `(JsonValue, __JsonParser)`.
// Recurses into __json_p_value for each element, threading the
// cursor through. Error paths thread back `error: 1` + JNull.
function __json_p_array(p0: __JsonParser): (JsonValue, __JsonParser) {
    // See __json_p_number: thread a local copy of the param.
    var p: __JsonParser = p0;
    p = __JsonParser { ...p, pos: p.pos + 1 };          // consume '['
    p = __json_p_skip_ws(p);
    if (__json_p_byte(p) == 93) {                       // ']'
        p = __JsonParser { ...p, pos: p.pos + 1 };
        var empty: JsonValue[] = [];
        return (JArray(empty), p);
    }
    var arr: JsonValue[] = [];
    while (true) {
        var (elem, pe) = __json_p_value(p);
        p = pe;
        if (p.error != 0) { return (JNull, p); }
        arr = arr.append(elem);
        p = __json_p_skip_ws(p);
        var b: i32 = __json_p_byte(p);
        if (b == 44) {                                  // ','
            p = __JsonParser { ...p, pos: p.pos + 1 };
            p = __json_p_skip_ws(p);
            continue;
        }
        if (b == 93) {                                  // ']'
            p = __JsonParser { ...p, pos: p.pos + 1 };
            return (JArray(arr), p);
        }
        return (JNull, __JsonParser { ...p, error: 1 });
    }
    return (JNull, p);   // unreachable
}

// __json_p_object consumes a JSON object and returns the decoded
// JObject plus the advanced cursor: `(JsonValue, __JsonParser)`.
// Recurses into __json_p_string (keys) and __json_p_value
// (values), threading the cursor through. Error paths thread
// back `error: 1` + JNull.
function __json_p_object(p0: __JsonParser): (JsonValue, __JsonParser) {
    // See __json_p_number: thread a local copy of the param.
    var p: __JsonParser = p0;
    p = __JsonParser { ...p, pos: p.pos + 1 };          // consume '{'
    p = __json_p_skip_ws(p);
    var m: Map[string, JsonValue] = map_new(8);
    if (__json_p_byte(p) == 125) {                      // '}'
        p = __JsonParser { ...p, pos: p.pos + 1 };
        return (JObject(m), p);
    }
    while (true) {
        var (key, pk) = __json_p_string(p);
        p = pk;
        if (p.error != 0) { return (JNull, p); }
        p = __json_p_skip_ws(p);
        if (__json_p_byte(p) != 58) {                   // ':'
            return (JNull, __JsonParser { ...p, error: 1 });
        }
        p = __JsonParser { ...p, pos: p.pos + 1 };
        var (val, pv) = __json_p_value(p);
        p = pv;
        if (p.error != 0) { return (JNull, p); }
        m = m.insert(key, val);
        p = __json_p_skip_ws(p);
        var b: i32 = __json_p_byte(p);
        if (b == 44) {                                  // ','
            p = __JsonParser { ...p, pos: p.pos + 1 };
            p = __json_p_skip_ws(p);
            continue;
        }
        if (b == 125) {                                 // '}'
            p = __JsonParser { ...p, pos: p.pos + 1 };
            return (JObject(m), p);
        }
        return (JNull, __JsonParser { ...p, error: 1 });
    }
    return (JNull, p);   // unreachable
}

// __json_p_value is the recursive-descent dispatch: it skips
// leading whitespace, peeks the next byte, and delegates to the
// number / string / array / object parsers. Returns the decoded
// value plus the advanced cursor: `(JsonValue, __JsonParser)`.
// Error paths thread back `error: 1` + JNull.
function __json_p_value(p0: __JsonParser): (JsonValue, __JsonParser) {
    // See __json_p_number: thread a local copy of the param.
    var p: __JsonParser = p0;
    p = __json_p_skip_ws(p);
    var b: i32 = __json_p_byte(p);
    if (b == 0) { return (JNull, __JsonParser { ...p, error: 1 }); }
    if (b == 110) {                                     // 'n' — null
        if (p.pos + 4 > p.s.len()) { return (JNull, __JsonParser { ...p, error: 1 }); }
        if (p.s[p.pos+1] != 117 || p.s[p.pos+2] != 108 || p.s[p.pos+3] != 108) {
            return (JNull, __JsonParser { ...p, error: 1 });
        }
        return (JNull, __JsonParser { ...p, pos: p.pos + 4 });
    }
    if (b == 116) {                                     // 't' — true
        if (p.pos + 4 > p.s.len()) { return (JNull, __JsonParser { ...p, error: 1 }); }
        if (p.s[p.pos+1] != 114 || p.s[p.pos+2] != 117 || p.s[p.pos+3] != 101) {
            return (JNull, __JsonParser { ...p, error: 1 });
        }
        return (JBool(true), __JsonParser { ...p, pos: p.pos + 4 });
    }
    if (b == 102) {                                     // 'f' — false
        if (p.pos + 5 > p.s.len()) { return (JNull, __JsonParser { ...p, error: 1 }); }
        if (p.s[p.pos+1] != 97 || p.s[p.pos+2] != 108 ||
            p.s[p.pos+3] != 115 || p.s[p.pos+4] != 101) {
            return (JNull, __JsonParser { ...p, error: 1 });
        }
        return (JBool(false), __JsonParser { ...p, pos: p.pos + 5 });
    }
    if (b == 34) {                                      // '"' — string
        var (s, ps) = __json_p_string(p);
        p = ps;
        if (p.error != 0) { return (JNull, p); }
        return (JString(s), p);
    }
    if (b == 91) {                                      // '['
        // Bound the recursion: a value nested past 128 containers
        // (serde_json's default limit) is rejected before descending
        // another level, so a hostile deeply-nested body can't
        // overflow the stack.
        if (p.depth >= 128) { return (JNull, __JsonParser { ...p, error: 1 }); }
        var savedA: i32 = p.depth;
        p = __JsonParser { ...p, depth: p.depth + 1 };
        var (av, pa) = __json_p_array(p);
        // Restore the caller's depth on the way out so siblings at
        // this level see the correct nesting, not an inflated one.
        return (av, __JsonParser { ...pa, depth: savedA });
    }
    if (b == 123) {                                     // '{'
        if (p.depth >= 128) { return (JNull, __JsonParser { ...p, error: 1 }); }
        var savedO: i32 = p.depth;
        p = __JsonParser { ...p, depth: p.depth + 1 };
        var (ov, po) = __json_p_object(p);
        return (ov, __JsonParser { ...po, depth: savedO });
    }
    if (b == 45 || (b >= 48 && b <= 57)) {              // '-' or digit
        return __json_p_number(p);
    }
    return (JNull, __JsonParser { ...p, error: 1 });
}

pub function json_parse(s: string): Option[JsonValue] {
    var p: __JsonParser = __JsonParser { s: s, pos: 0, error: 0, depth: 0 };
    var (v, pv) = __json_p_value(p);
    p = pv;
    p = __json_p_skip_ws(p);
    if (p.error != 0 || p.pos < p.s.len()) { return None; }
    return Some(v);
}

// ============================================================
// Schema-directed JSON extraction helpers — Tier-C Rec §12
// (docs/STDLIB-DESIGN-RESEARCH.md Rec §3) Phase 1.
//
// The full vision is `json_parse[T](bytes) → Result[T,
// JsonError]` where the compiler generates a per-struct walker
// for each T. That needs a new IR pass to monomorphise + emit
// per-T decoder code — multi-week. Phase 1 (this surface)
// ships typed-field extraction helpers on `JsonValue`:
// callers parse once with json_parse(), then walk the DOM
// with these helpers instead of pattern-matching every level.
//
// Typical use:
//
//   match (json_parse(req.body_string())) {
//       Some(v) => {
//           var name = json_get_string(v, "name");
//           var age  = json_get_i32(v, "age");
//           match ((name, age)) {
//               (Some(n), Some(a)) => return Some(CreateUser { name: n, age: a }),
//               _ => return None,
//           }
//       },
//       None => return None,
//   }
//
// Phase 2 will let callers skip the manual assembly:
//
//   var u: CreateUser = json_parse[CreateUser](req.body_bytes())?;
// ============================================================

// `json_get(obj, key)` — look up `key` in a JObject. Returns
// None when `obj` isn't a JObject or `key` isn't present.
// Foundation for the typed getters below.
pub function json_get(obj: JsonValue, key: string): Option[JsonValue] {
    match (obj) {
        JObject(m) => {
            match (m.get(key)) {
                Some(v) => { return Some(v); },
                None => { return None; }
            }
        },
        _ => { return None; }
    }
    return None;
}

// `json_get_string(obj, key)` — typed-extract a JString.
// Returns None when the key is missing or the value isn't
// a string.
pub function json_get_string(obj: JsonValue, key: string): Option[string] {
    match (json_get(obj, key)) {
        Some(v) => {
            match (v) {
                JString(s) => { return Some(s); },
                _ => { return None; }
            }
        },
        None => { return None; }
    }
    return None;
}

// `json_get_i32(obj, key)` — typed-extract a JNumber as i32.
// Returns None when the key is missing, the value isn't a
// number, the number doesn't parse as an integer (a `.` or `e`
// makes it a float — use json_get_f64), OR the value doesn't fit
// in i32. Overflow is a hard None rather than the old silent
// two's-complement wrap: the magnitude is accumulated in a wider
// i64 and range-checked, so `2147483648` on an i32 field is
// rejected instead of coming back as the min value (#4384 item 4).
pub function json_get_i32(obj: JsonValue, key: string): Option[i32] {
    match (json_get(obj, key)) {
        Some(v) => {
            match (v) {
                JNumber(s) => {
                    // JNumber carries the raw decimal text; parse to i32.
                    var acc: i64 = 0;
                    var i: i32 = 0;
                    var neg: boolean = false;
                    var nlen: i32 = s.len();
                    if (nlen == 0) { return None; }
                    if (s[0] == 45) { neg = true; i = 1; }
                    if (i >= nlen) { return None; }
                    while (i < nlen) {
                        var b: i32 = s[i];
                        if (b < 48 || b > 57) { return None; }
                        acc = acc * 10 + ((b - 48) as i64);
                        // 2147483648 == |i32 min|; anything past it can't fit
                        // either sign. Bounding here also keeps `acc` small
                        // enough that it never overflows the i64 itself.
                        if (acc > 2147483648) { return None; }
                        i = i + 1;
                    }
                    // Negatives reach down to -2147483648; positives top out
                    // one lower at 2147483647.
                    if (neg) { return Some((0 - acc) as i32); }
                    if (acc > 2147483647) { return None; }
                    return Some(acc as i32);
                },
                _ => { return None; }
            }
        },
        None => { return None; }
    }
    return None;
}

// `json_get_i64(obj, key)` — typed-extract a JNumber as i64. Like
// `json_get_i32` but accumulates in 64-bit, for fields wider than i32
// (timestamps, large ids). A non-numeric value or a non-digit body returns
// None. Overflow now signals None rather than wrapping silently (#4384
// item 4): the positive magnitude is accumulated in i64, and a two's-
// complement wrap past i64 max shows up as a negative accumulator while
// a >19-digit body can't fit at all — both return None. (Edge: i64 min,
// -9223372036854775808, has magnitude 2^63 which the positive accumulator
// can't hold, so it too reads as overflow; callers needing exactly the
// minimum must special-case it.)
pub function json_get_i64(obj: JsonValue, key: string): Option[i64] {
    match (json_get(obj, key)) {
        Some(v) => {
            match (v) {
                JNumber(s) => {
                    var n: i64 = 0;
                    var i: i32 = 0;
                    var sign: i64 = 1;
                    var nlen: i32 = s.len();
                    var digits: i32 = 0;
                    if (nlen == 0) { return None; }
                    if (s[0] == 45) { sign = 0 - 1; i = 1; }
                    if (i >= nlen) { return None; }
                    while (i < nlen) {
                        var b: i32 = s[i];
                        if (b < 48 || b > 57) { return None; }
                        n = n * 10 + ((b - 48) as i64);
                        digits = digits + 1;
                        if (n < 0 || digits > 19) { return None; }
                        i = i + 1;
                    }
                    return Some(n * sign);
                },
                _ => { return None; }
            }
        },
        None => { return None; }
    }
    return None;
}

// `json_get_f64(obj, key)` — typed-extract a JNumber as f64. The
// float accessor JSON needs but lacked: `3.14` parses fine but the
// integer getters reject it, so before this there was no way to read
// a fractional field back out (#4384 item 4). Returns None when the
// key is missing or the value isn't a number; any JSON number (int,
// fraction, or exponent form) decodes via std/string's parse_float
// (#5420 — the raw text of a parser-validated JNumber is a valid
// parse_float input, so the Some/None split falls out for free).
pub function json_get_f64(obj: JsonValue, key: string): Option[f64] {
    match (json_get(obj, key)) {
        Some(v) => {
            match (v) {
                JNumber(s) => { return s.parse_float(); },
                _ => { return None; }
            }
        },
        None => { return None; }
    }
    return None;
}

// `json_get_bool(obj, key)` — typed-extract a JBool.
pub function json_get_bool(obj: JsonValue, key: string): Option[boolean] {
    match (json_get(obj, key)) {
        Some(v) => {
            match (v) {
                JBool(b) => { return Some(b); },
                _ => { return None; }
            }
        },
        None => { return None; }
    }
    return None;
}

// `json_get_array(obj, key)` — typed-extract a JArray.
// Returns the array's element list directly so callers can
// `len()` / index over it without further matching.
pub function json_get_array(obj: JsonValue, key: string): Option[JsonValue[]] {
    match (json_get(obj, key)) {
        Some(v) => {
            match (v) {
                JArray(arr) => { return Some(arr); },
                _ => { return None; }
            }
        },
        None => { return None; }
    }
    return None;
}

// `json_get_object(obj, key)` — typed-extract a JObject as
// a JsonValue (chain extracts through nested objects).
// Doesn't unwrap to Map[string, JsonValue] — the JsonValue
// shape composes with the other json_get_* helpers, so
// chains read more naturally as:
//
//   var addr = json_get_object(user, "address");
//   var city = json_get_string(addr.unwrap_or(JNull), "city");
//
// (The unwrap_or pattern works around chained-Option
// unwrapping until lang grows a `?.` operator.)
pub function json_get_object(obj: JsonValue, key: string): Option[JsonValue] {
    match (json_get(obj, key)) {
        Some(v) => {
            match (v) {
                JObject(_) => { return Some(v); },
                _ => { return None; }
            }
        },
        None => { return None; }
    }
    return None;
}

// `__json_ptr_unescape(tok)` — decode a single RFC 6901 reference
// token: `~1` -> `/` and `~0` -> `~`, in one left-to-right pass so
// `~01` correctly decodes to `~1` (not `/`). A lone `~` not followed
// by `0`/`1` is passed through literally (lenient). Tokens are short
// keys, so the `out + …` build is fine and only runs on the rare
// escape-bearing path (a `~`-free token returns unchanged).
function __json_ptr_unescape(tok: string): string {
    var n: i32 = tok.len();
    var has: boolean = false;
    var i: i32 = 0;
    while (i < n) {
        if (tok[i] == 126) { has = true; i = n; } else { i = i + 1; }   // '~' = 126
    }
    if (!has) { return tok; }
    var out: string = "";
    i = 0;
    while (i < n) {
        var c: i32 = tok[i];
        if (c == 126 && i + 1 < n) {
            var d: i32 = tok[i + 1];
            if (d == 49)      { out = out + "/"; i = i + 2; }   // ~1 -> /
            else if (d == 48) { out = out + "~"; i = i + 2; }   // ~0 -> ~
            else              { out = out + tok[i : i + 1]; i = i + 1; }
        } else {
            out = out + tok[i : i + 1];
            i = i + 1;
        }
    }
    return out;
}

// `__json_ptr_index(tok)` — parse an RFC 6901 array-index token to a
// non-negative i32, or -1 if it isn't a valid index. Per §4 the token
// must be `0` or `[1-9][0-9]*` — leading zeros, the `-` end-of-array
// token, non-digits, and out-of-i32 magnitudes all yield -1 (a
// guaranteed miss).
function __json_ptr_index(tok: string): i32 {
    var n: i32 = tok.len();
    if (n == 0) { return 0 - 1; }
    if (tok[0] == 48 && n > 1) { return 0 - 1; }   // leading zero
    var acc: i64 = 0;
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = tok[i];
        if (b < 48 || b > 57) { return 0 - 1; }
        acc = acc * 10 + ((b - 48) as i64);
        if (acc > 2147483647) { return 0 - 1; }    // past any real array length
        i = i + 1;
    }
    return acc as i32;
}

// `json_pointer(doc, pointer)` — resolve an RFC 6901 JSON Pointer
// against a JsonValue tree. `""` selects the whole document; a
// non-empty pointer must start with `/`, and each `/`-separated
// reference token descends one level: a token indexes a JObject by
// key or a JArray by numeric index (`~1`/`~0` unescape to `/`/`~` in
// keys). Returns None on a missing key, an out-of-range or malformed
// array index, a descent into a scalar, or a pointer that doesn't
// begin with `/`.
//
//   json_pointer(doc, "/user/tags/0")   // first tag
//   json_pointer(doc, "/a~1b")          // key literally "a/b"
pub function json_pointer(doc: JsonValue, pointer: string): Option[JsonValue] {
    var n: i32 = pointer.len();
    if (n == 0) { return Some(doc); }
    if (pointer[0] != 47) { return None; }   // must start with '/' = 47
    var cur: JsonValue = doc;
    var i: i32 = 1;                            // past the leading '/'
    while (i <= n) {
        // Token runs from i up to the next '/' (or the end).
        var j: i32 = i;
        while (j < n && pointer[j] != 47) { j = j + 1; }
        var tok: string = __json_ptr_unescape(pointer[i : j]);
        match (cur) {
            JObject(m) => {
                match (m.get(tok)) {
                    Some(v) => { cur = v; },
                    None => { return None; }
                }
            },
            JArray(arr) => {
                var idx: i32 = __json_ptr_index(tok);
                if (idx < 0 || idx >= arr.len()) { return None; }
                cur = arr[idx];
            },
            _ => { return None; }
        }
        i = j + 1;                            // past the terminating '/'
    }
    return Some(cur);
}

// `json_is_null(v)` — true iff `v` is JNull. Convenience
// over the bare match for the common nullability check.
pub function json_is_null(v: JsonValue): boolean {
    match (v) {
        JNull => { return true; },
        _ => { return false; }
    }
    return false;
}

// === Json trait + @derive(Json) ===
//
// `Json` is the structural-serialisation spine: `v.to_json()` returns
// canonical JSON text. `@derive(Json)` synthesises it field-/variant-
// wise (the checker's synthJson / synthEnumJson) so a type serialises as
// soon as its fields do — no per-type encoder. A struct becomes a JSON
// object (`{"field":<value>}`), an enum is externally tagged (a unit
// variant is its name as a JSON string; a payload variant is a single-
// key object, multiple payloads a JSON array). The primitive impls below
// are the leaves of that composition; string values are escaped through
// the same `json_escape` the `JsonValue` encoder uses.
//
//   @derive(json.Json)
//   struct User { id: i32, name: string, admin: boolean }
//   var body: string = User { id: 7, name: "Glóin", admin: true }.to_json();
//   // {"id":7,"name":"Glóin","admin":true}
//
// Floats are leaves too (decimal `to_string`). Arrays serialise via the
// generic `(xs: T[]) to_json[T: Json]()` below (#2766); map objects are a
// remaining follow-up.
pub trait Json {
    function to_json(self: Self): string;
}

impl Json for i32 {
    function to_json(self: Self): string { return self.to_string(); }
}
impl Json for i64 {
    function to_json(self: Self): string { return self.to_string(); }
}
impl Json for u32 {
    function to_json(self: Self): string { return self.to_string(); }
}
impl Json for u64 {
    function to_json(self: Self): string { return self.to_string(); }
}
impl Json for boolean {
    function to_json(self: Self): string {
        if (self) { return "true"; }
        return "false";
    }
}
// Floats serialise as their decimal `to_string`. Like the `JNumber`
// encoder, valid JSON numeric formatting is the caller's responsibility:
// a non-finite value (NaN / ±Inf) has no JSON representation and would
// produce invalid output — guard those before serialising if they can
// occur.
impl Json for f64 {
    function to_json(self: Self): string { return self.to_string(); }
}
impl Json for f32 {
    function to_json(self: Self): string { return self.to_string(); }
}
impl Json for string {
    function to_json(self: Self): string {
        return "\"" + json_escape(self) + "\"";
    }
}

// Array serialiser: a `T[]` whose element type is `Json` renders as a JSON
// array `[e0,e1,…]`. Element-polymorphic + method-level bounded, so it works
// for arrays of scalars, strings, and `@derive(Json)` structs/enums. On the
// native compiler the monomorphiser substitutes `T` and re-checks the clone;
// `xs[i].to_json()` then dispatches to the element type's impl (the
// cross-module trait-method visibility this relies on landed in #2774). On
// the self-hosted compiler the call site is intercepted (the IR/AST emit
// special-cases `arr.to_json()` on a known array element type) so the erased
// generic body never has to dispatch on `T`.
pub function (xs: T[]) to_json[T: Json](): string {
    // Local growable u8[] accumulation (#4379), like json_encode's JArray arm:
    // the old `out = out + xs[i].to_json()` recopied the whole encoded-so-far
    // prefix on every element — O(array²). Every append targets the local `out`,
    // so it grows in place (amortized O(1)); the per-element bytes are inlined.
    // (On the self-hosted compiler this body is dead — `arr.to_json()` call sites
    // are intercepted by lower_array_to_json, whose codegen carries the matching
    // rewrite — but the native monomorphiser compiles it, so it must stay O(n)
    // and lower cleanly.) Byte-for-byte identical output.
    var out: u8[] = [];
    out = out.append(91 as u8);   // '['
    var i: i32 = 0;
    while (i < xs.len()) {
        if (i > 0) { out = out.append(44 as u8); }   // ','
        var e: string = xs[i].to_json();
        var el: i32 = e.len();
        var k: i32 = 0;
        while (k < el) {
            out = out.append(e[k] as u8);
            k = k + 1;
        }
        i = i + 1;
    }
    out = out.append(93 as u8);   // ']'
    return string_from_bytes_unchecked(out);
}
