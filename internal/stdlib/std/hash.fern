// std/hash — non-cryptographic checksums: the two CRC-32s that cksum(1)
// prints and the two sum(1) checksums (BSD `sum -r`, System V `sum -s`).
//
// These share std/crypto's streaming shape — a value with `update`
// that is rebound (`c = c.update(chunk)`) and read out with
// `finish()` — but live apart from it because none of them is a hash
// function in the cryptographic sense: a CRC detects line noise, not an
// adversary, and putting it under `crypto` would suggest otherwise. This is
// also where a future non-cryptographic hash (FNV, xxHash, a map hasher)
// belongs.
//
// Each carries the byte count the utilities print next to the checksum:
// cksum's is the exact length, sum's are 1 KiB (BSD) and 512-byte (System V)
// block counts, rounded up. Bit-for-bit what GNU coreutils prints:
//
//   cksum:  crc = CRC-32/CKSUM (poly 0x04C11DB7, MSB first, no reflection),
//           over the data followed by the length in little-endian bytes with
//           trailing zero bytes dropped, then complemented.
//   cksum -a crc32b:
//           CRC-32/ISO-HDLC, the zlib one (poly 0xEDB88320 reflected, the
//           register complemented at both ends, the length not folded in).
//   sum -r: 16-bit right-rotate-then-add over every byte.
//   sum -s: the 32-bit byte sum folded to 16 bits twice.

// === CRC-32 as cksum(1) computes it ===

pub struct Cksum {
  crc: u32,
  len: u64,
  // Eight 256-entry slicing tables laid end to end: table `k` occupies
  // `[k * 256, k * 256 + 256)`. Table 0 is `(i << 24)` fed through eight
  // polynomial steps; table `k + 1` is table `k` advanced one byte
  // position further, which is what lets the absorb loop consume eight
  // bytes against eight INDEPENDENT lookups instead of a chain of eight
  // dependent ones. Built once per hasher and only ever read.
  table: u32[],
}

function __cksum_tables(): u32[] {
  let t: u32[] = [];
  let i: u32 = 0;
  while (i < 256) {
    let c: u32 = i << 24;
    let k: i32 = 0;
    while (k < 8) {
      if ((c & 0x80000000) != 0) {
        c = c << 1 ^ 0x04c11db7;
      } else {
        c = c << 1;
      }
      k = k + 1;
    }
    t = t.append(c);
    i = i + 1;
  }
  let j: i32 = 0;
  let p: u32 = 0;
  while (j < 1792) {
    p = t[j];
    t = t.append(p << 8 ^ t[(p >> 24 & 255) as i32]);
    j = j + 1;
  }
  return t;
}

pub function cksum_new(): Cksum {
  return Cksum { crc: 0, len: 0 as u64, table: __cksum_tables() };
}

// Borrow byte input and use the existing checksum kernel for its layout.
pub function (c: Cksum) update(chunk: [u8]): Cksum {
  return Cksum {
    ...c, crc: __crc32_cksum_array(c.crc as i32, chunk) as u32,
    len: c.len + chunk.len() as u64,
  };
}

// byte_count() — the number of bytes absorbed, the second field of cksum's
// output. A u64, not a collection length: a stream can pass 4 GiB.
pub function (c: Cksum) byte_count(): u64 {
  return c.len;
}

// finish() — the CRC with the length folded in and complemented. Reads the
// state without consuming it: more `update`s may follow.
pub function (c: Cksum) finish(): u32 {
  let t: u32[] = c.table;
  let crc: u32 = c.crc;
  let n: u64 = c.len;
  while (n != 0 as u64) {
    crc = crc << 8 ^ t[((crc >> 24 ^ (n & 255 as u64) as u32) & 255) as i32];
    n = n >> 8 as u64;
  }
  return crc ^ 0xffffffff;
}

// cksum_of(s) — the one-shot checksum of `s`.
pub function cksum_of(s: [u8]): u32 {
  return cksum_new().update(s).finish();
}

// === CRC-32 as everything else computes it (zlib, `cksum -a crc32b`) ===
//
// The REFLECTED form of the same polynomial cksum uses: bits enter at the
// bottom, the table is built from 0xEDB88320, and the register starts and
// ends complemented. It is a different function from the one above it over a
// polynomial that looks the same, which is why both live here.
pub struct Crc32 {
  crc: u32,
  len: u64,
  // Eight 256-entry slicing tables laid end to end, as Cksum's are, so
  // the absorb loop consumes eight bytes against eight independent
  // lookups rather than a chain of eight dependent ones.
  table: u32[],
}

function __crc32b_tables(): u32[] {
  let t: u32[] = [];
  let i: u32 = 0;
  while (i < 256) {
    let c: u32 = i;
    let k: i32 = 0;
    while (k < 8) {
      if ((c & 1) != 0) {
        c = c >> 1 ^ 0xedb88320;
      } else {
        c = c >> 1;
      }
      k = k + 1;
    }
    t = t.append(c);
    i = i + 1;
  }
  let j: i32 = 0;
  let p: u32 = 0;
  while (j < 1792) {
    p = t[j];
    t = t.append(p >> 8 ^ t[(p & 255) as i32]);
    j = j + 1;
  }
  return t;
}

pub function crc32_new(): Crc32 {
  return Crc32 { crc: 0xffffffff, len: 0 as u64, table: __crc32b_tables() };
}

function __crc32_absorb(c: Crc32, bs: [u8]): Crc32 {
  let t: u32[] = c.table;
  let crc: u32 = c.crc;
  let n: i32 = bs.len();
  let i: i32 = 0;
  let lim: i32 = n - 8;
  let w0: u32 = 0;
  let w1: u32 = 0;
  while (i <= lim) {
    w0 = crc ^ (bs[i] as u32 | bs[i + 1] as u32 << 8 | bs[i + 2] as u32 << 16 | bs[i + 3] as u32 << 24);
    w1 = bs[i + 4] as u32 | bs[i + 5] as u32 << 8 | bs[i + 6] as u32 << 16 | bs[i + 7] as u32 << 24;
    crc = t[1792 + (w0 & 255) as i32] ^ t[1536 + (w0 >> 8 & 255) as i32] ^ t[1280 + (w0 >> 16 & 255) as i32] ^ t[1024 + (w0 >> 24 & 255) as i32] ^ t[768 + (w1 & 255) as i32] ^ t[512 + (w1 >> 8 & 255) as i32] ^ t[256 + (w1 >> 16 & 255) as i32] ^ t[(w1 >> 24 & 255) as i32];
    i = i + 8;
  }
  while (i < n) {
    crc = crc >> 8 ^ t[((crc ^ bs[i] as u32) & 255) as i32];
    i = i + 1;
  }
  return Crc32 { ...c, crc: crc, len: c.len + n as u64 };
}

// Borrow byte input and use the existing checksum kernel for its layout.
pub function (c: Crc32) update(chunk: [u8]): Crc32 {
  c = __crc32_absorb(c, chunk);
  return c;
}

// byte_count() reports the number of bytes absorbed.
pub function (c: Crc32) byte_count(): u64 {
  return c.len;
}

// finish() — the register complemented. Reads the state without
// consuming it: more `update`s may follow.
pub function (c: Crc32) finish(): u32 {
  return c.crc ^ 0xffffffff;
}

// crc32_of(s) — the one-shot checksum of `s`.
pub function crc32_of(s: [u8]): u32 {
  return crc32_new().update(s).finish();
}

// === BSD sum (`sum -r`): 16-bit rotate-and-add, 1 KiB blocks ===

pub struct BsdSum {
  sum: u32,
  len: u64,
}

pub function bsd_sum_new(): BsdSum {
  return BsdSum { sum: 0, len: 0 as u64 };
}

// Borrow byte input and use the existing checksum kernel for its layout.
pub function (s: BsdSum) update(chunk: [u8]): BsdSum {
  return BsdSum { sum: __bsd_sum_bytes(chunk, s.sum as i32) as u32, len: s.len + chunk.len() as u64 };
}

// finish() — the 16-bit checksum (0..65535).
pub function (s: BsdSum) finish(): u32 {
  return s.sum;
}

pub function (s: BsdSum) byte_count(): u64 {
  return s.len;
}

// blocks() — the 1 KiB block count sum(1) prints, rounded up.
pub function (s: BsdSum) blocks(): u64 {
  return (s.len + 1023 as u64) / (1024 as u64);
}

// bsd_sum_of(s) — the one-shot checksum of `s`.
pub function bsd_sum_of(s: [u8]): u32 {
  return bsd_sum_new().update(s).finish();
}

// === System V sum (`sum -s`): folded 32-bit byte sum, 512-byte blocks ===

pub struct SysvSum {
  sum: u32,
  len: u64,
}

pub function sysv_sum_new(): SysvSum {
  return SysvSum { sum: 0, len: 0 as u64 };
}

// Borrow byte input and use the existing checksum kernel for its layout.
pub function (s: SysvSum) update(chunk: [u8]): SysvSum {
  return SysvSum { sum: s.sum + __sum_bytes_array(chunk) as u32, len: s.len + chunk.len() as u64 };
}

// finish() — the 16-bit checksum: the wrapped 32-bit byte sum folded to
// 16 bits, then folded once more so the carry of the first fold lands.
pub function (s: SysvSum) finish(): u32 {
  let r: u32 = (s.sum & 0xffff) + (s.sum >> 16);
  return (r & 0xffff) + (r >> 16);
}

pub function (s: SysvSum) byte_count(): u64 {
  return s.len;
}

// blocks() — the 512-byte block count sum(1) prints, rounded up.
pub function (s: SysvSum) blocks(): u64 {
  return (s.len + 511 as u64) / (512 as u64);
}

// sysv_sum_of(s) — the one-shot checksum of `s`.
pub function sysv_sum_of(s: [u8]): u32 {
  return sysv_sum_new().update(s).finish();
}

// === XXH64: Yann Collet's 64-bit hash, the checksum zstd frames carry ===

// xxh64(bs, seed) — XXH64 of `bs` under `seed`.
pub function xxh64(bs: [u8], seed: u64): u64 {
  let n: i32 = bs.len();
  let at: i32 = 0;
  let h: u64 = seed + 0x27D4EB2F165667C5;
  if (n >= 32) {
    let v: u64[] = [seed + 0x9E3779B185EBCA87 + 0xC2B2AE3D27D4EB4F, seed + 0xC2B2AE3D27D4EB4F, seed, seed - 0x9E3779B185EBCA87];
    while (at + 32 <= n) {
      v = [__xxh_round(v[0], __le64(bs, at)), __xxh_round(v[1], __le64(bs, at + 8)), __xxh_round(v[2], __le64(bs, at + 16)), __xxh_round(v[3], __le64(bs, at + 24))];
      at = at + 32;
    }
    h = __rotl64(v[0], 1) + __rotl64(v[1], 7) + __rotl64(v[2], 12) + __rotl64(v[3], 18);
    for x in v {
      h = (h ^ __xxh_round(0, x)) * 0x9E3779B185EBCA87 + 0x85EBCA77C2B2AE63;
    }
  }
  return __xxh_tail(bs, at, h + n as u64);
}

// __xxh_tail(bs, at, h) — the bytes past the last 32-byte stripe folded
// into `h`, then the final mix.
function __xxh_tail(bs: [u8], at: i32, h: u64): u64 {
  let n: i32 = bs.len();
  while (at + 8 <= n) {
    h = __rotl64(h ^ __xxh_round(0, __le64(bs, at)), 27) * 0x9E3779B185EBCA87 + 0x85EBCA77C2B2AE63;
    at = at + 8;
  }
  if (at + 4 <= n) {
    let w: u64 = bs[at] as u64 | bs[at + 1] as u64 << 8 | bs[at + 2] as u64 << 16 | bs[at + 3] as u64 << 24;
    h = __rotl64(h ^ w * 0x9E3779B185EBCA87, 23) * 0xC2B2AE3D27D4EB4F + 0x165667B19E3779F9;
    at = at + 4;
  }
  while (at < n) {
    h = __rotl64(h ^ bs[at] as u64 * 0x27D4EB2F165667C5, 11) * 0x9E3779B185EBCA87;
    at = at + 1;
  }
  h = (h ^ h >> 33) * 0xC2B2AE3D27D4EB4F;
  h = (h ^ h >> 29) * 0x165667B19E3779F9;
  return h ^ h >> 32;
}

function __xxh_round(acc: u64, input: u64): u64 {
  return __rotl64(acc + input * 0xC2B2AE3D27D4EB4F, 31) * 0x9E3779B185EBCA87;
}

function __rotl64(x: u64, r: u64): u64 {
  return x << r | x >> 64 - r;
}

function __le64(bs: [u8], at: i32): u64 {
  let v: u64 = 0;
  let i: i32 = 7;
  while (i >= 0) {
    v = v << 8 | bs[at + i] as u64;
    i = i - 1;
  }
  return v;
}
