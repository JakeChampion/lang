// This module implements the `Semantic Versioning 2.0.0` rules.

import "std/string";

pub struct SemVer {
  major: i32,
  minor: i32,
  patch: i32,
  prerelease: string,
  build: string,
}

function __sv_all_digits(s: string): boolean {
  if (s.len() == 0) {
    return false;
  }
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] < 48 || s[i] > 57) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function __sv_num(s: string): Option[i32] {
  if (!__sv_all_digits(s)) {
    return None;
  }
  if (s.len() > 1 && s[0] == 48) {
    return None;
  }
  return s.parse_int();
}

function __sv_slice(s: string, start: i32, end: i32): string {
  let b: u8[] = [];
  let i: i32 = start;
  while (i < end) {
    b = b.append(s[i] as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(b);
}

function __sv_str_cmp(a: string, b: string): i32 {
  let n: i32 = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  let i: i32 = 0;
  while (i < n) {
    if (a[i] < b[i]) {
      return 0 - 1;
    }
    if (a[i] > b[i]) {
      return 1;
    }
    i = i + 1;
  }
  if (a.len() < b.len()) {
    return 0 - 1;
  }
  if (a.len() > b.len()) {
    return 1;
  }
  return 0;
}

function __sv_significant_digits(s: string): string {
  let i: i32 = 0;
  while (i < s.len() && s[i] == 48) {
    i = i + 1;
  }
  return __sv_slice(s, i, s.len());
}

function __sv_cmp_numeric(x: string, y: string): i32 {
  let xs: string = __sv_significant_digits(x);
  let ys: string = __sv_significant_digits(y);
  if (xs.len() != ys.len()) {
    if (xs.len() < ys.len()) {
      return 0 - 1;
    }
    return 1;
  }
  return __sv_str_cmp(xs, ys);
}

function __sv_cmp_ident(x: string, y: string): i32 {
  let xn: boolean = __sv_all_digits(x);
  let yn: boolean = __sv_all_digits(y);
  if (xn && yn) {
    return __sv_cmp_numeric(x, y);
  }
  if (xn && !yn) {
    return 0 - 1;
  }
  if (!xn && yn) {
    return 1;
  }
  return __sv_str_cmp(x, y);
}

pub function parse(s: string): Option[SemVer] {
  let core_pre: string = s;
  let build: string = "";
  if let Some(plus) = s.index_of("+") {
    core_pre = __sv_slice(s, 0, plus);
    build = __sv_slice(s, plus + 1, s.len());
    if (build.len() == 0) {
      return None;
    }
  }
  let core: string = core_pre;
  let pre: string = "";
  if let Some(dash) = core_pre.index_of("-") {
    core = __sv_slice(core_pre, 0, dash);
    pre = __sv_slice(core_pre, dash + 1, core_pre.len());
    if (pre.len() == 0) {
      return None;
    }
  }
  let parts: string[] = core.split(".");
  if (parts.len() != 3) {
    return None;
  }
  let maj: Option[i32] = __sv_num(parts[0]);
  let min: Option[i32] = __sv_num(parts[1]);
  let pat: Option[i32] = __sv_num(parts[2]);
  match (maj) {
    None => {
      return None;
    },
    Some(mj) => {
      match (min) {
        None => {
          return None;
        },
        Some(mn) => {
          match (pat) {
            None => {
              return None;
            },
            Some(pt) => {
              if (pre.len() > 0) {
                let ids: string[] = pre.split(".");
                let i: i32 = 0;
                while (i < ids.len()) {
                  let id: string = ids[i];
                  if (id.len() == 0) {
                    return None;
                  }
                  if (__sv_all_digits(id) && id.len() > 1 && id[0] == 48) {
                    return None;
                  }
                  i = i + 1;
                }
              }
              return Some(SemVer { major: mj, minor: mn, patch: pt, prerelease: pre, build: build });
            }
          }
        }
      }
    }
  }
}

pub function (a: SemVer) compare(b: SemVer): i32 {
  if (a.major != b.major) {
    if (a.major < b.major) {
      return 0 - 1;
    }
    return 1;
  }
  if (a.minor != b.minor) {
    if (a.minor < b.minor) {
      return 0 - 1;
    }
    return 1;
  }
  if (a.patch != b.patch) {
    if (a.patch < b.patch) {
      return 0 - 1;
    }
    return 1;
  }
  let ap: boolean = a.prerelease.len() > 0;
  let bp: boolean = b.prerelease.len() > 0;
  if (!ap && !bp) {
    return 0;
  }
  if (!ap && bp) {
    return 1;
  }
  if (ap && !bp) {
    return 0 - 1;
  }
  let ai: string[] = a.prerelease.split(".");
  let bi: string[] = b.prerelease.split(".");
  let n: i32 = ai.len();
  if (bi.len() < n) {
    n = bi.len();
  }
  let i: i32 = 0;
  while (i < n) {
    let c: i32 = __sv_cmp_ident(ai[i], bi[i]);
    if (c != 0) {
      return c;
    }
    i = i + 1;
  }
  if (ai.len() < bi.len()) {
    return 0 - 1;
  }
  if (ai.len() > bi.len()) {
    return 1;
  }
  return 0;
}

pub function (a: SemVer) eq(b: SemVer): boolean {
  return a.compare(b) == 0;
}

pub function (a: SemVer) lt(b: SemVer): boolean {
  return a.compare(b) < 0;
}

pub function (a: SemVer) gt(b: SemVer): boolean {
  return a.compare(b) > 0;
}

pub function (v: SemVer) to_string(): string {
  let out: string = v.major.to_string() + "." + v.minor.to_string() + "." + v.patch.to_string();
  if (v.prerelease.len() > 0) {
    out = out + "-" + v.prerelease;
  }
  if (v.build.len() > 0) {
    out = out + "+" + v.build;
  }
  return out;
}
