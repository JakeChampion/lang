// std/semver — Semantic Versioning 2.0.0 (https://semver.org).
//
// Parse a version string into its parts and compare two versions by
// SemVer precedence (§11). `SemVer` is a plain struct of scalars +
// strings, so it copies by value with no aliasing surprises.
//
//   var a: SemVer = ...;   // via semver.parse("1.2.3-rc.1")
//   a.compare(b);          // -1 / 0 / 1
//   a.to_string();         // "1.2.3-rc.1"
//
// Precedence, per §11:
//   - major, minor, patch compared numerically;
//   - a version WITH a prerelease has LOWER precedence than the same
//     version without one (1.0.0-rc.1 < 1.0.0);
//   - prerelease identifiers compare left-to-right: numeric identifiers
//     numerically, alphanumeric lexically (ASCII), numeric < alphanumeric,
//     and a larger set of identifiers outranks a strict prefix;
//   - BUILD METADATA IS IGNORED for precedence (1.0.0+a == 1.0.0+b).

import "std/string";

// major.minor.patch plus optional prerelease / build (each "" when
// absent). Construct via `parse`, not a raw literal, so validation runs.
pub struct SemVer {
    major: i32,
    minor: i32,
    patch: i32,
    prerelease: string,
    build: string,
}

// __sv_all_digits reports whether `s` is non-empty and all ASCII digits.
function __sv_all_digits(s: string): boolean {
    if (s.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] < 48 || s[i] > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// __sv_num parses a numeric version core field: all-digits, and no
// leading zero unless the value is exactly "0" (§2). None otherwise.
function __sv_num(s: string): Option[i32] {
    if (!__sv_all_digits(s)) { return None; }
    if (s.len() > 1 && s[0] == 48) { return None; }   // leading zero
    return s.parse_int();
}

// __sv_slice returns the bytes [start, end) of `s` as a fresh string
// (byte-indexed — SemVer syntax is ASCII, so byte offsets are fine).
function __sv_slice(s: string, start: i32, end: i32): string {
    var b: u8[] = [];
    var i: i32 = start;
    while (i < end) {
        b = b.append(s[i] as u8);
        i = i + 1;
    }
    return string_from_bytes_unchecked(b);
}

// __sv_str_cmp compares two strings by ASCII byte order: -1 / 0 / 1.
function __sv_str_cmp(a: string, b: string): i32 {
    var n: i32 = a.len();
    if (b.len() < n) { n = b.len(); }
    var i: i32 = 0;
    while (i < n) {
        if (a[i] < b[i]) { return 0 - 1; }
        if (a[i] > b[i]) { return 1; }
        i = i + 1;
    }
    if (a.len() < b.len()) { return 0 - 1; }
    if (a.len() > b.len()) { return 1; }
    return 0;
}

// __sv_cmp_ident compares two prerelease identifiers (§11): numeric vs
// numeric numerically, numeric < alphanumeric, else lexical.
function __sv_cmp_ident(x: string, y: string): i32 {
    var xn: boolean = __sv_all_digits(x);
    var yn: boolean = __sv_all_digits(y);
    if (xn && yn) {
        var xi: i32 = x.parse_int_or(0);
        var yi: i32 = y.parse_int_or(0);
        if (xi < yi) { return 0 - 1; }
        if (xi > yi) { return 1; }
        return 0;
    }
    if (xn && !yn) { return 0 - 1; }
    if (!xn && yn) { return 1; }
    return __sv_str_cmp(x, y);
}

// `parse(s)` — parse a SemVer string, `None` if malformed. Requires
// exactly `major.minor.patch` (each a valid numeric identifier); an
// optional `-prerelease` and `+build` follow. Prerelease / build
// identifiers must be non-empty; a numeric prerelease identifier may not
// have a leading zero.
pub function parse(s: string): Option[SemVer] {
    // Split off build metadata at the first '+'.
    var core_pre: string = s;
    var build: string = "";
    var plus: i32 = s.index_of("+");
    if (plus >= 0) {
        core_pre = __sv_slice(s, 0, plus);
        build = __sv_slice(s, plus + 1, s.len());
        if (build.len() == 0) { return None; }
    }
    // Split off prerelease at the first '-'.
    var core: string = core_pre;
    var pre: string = "";
    var dash: i32 = core_pre.index_of("-");
    if (dash >= 0) {
        core = __sv_slice(core_pre, 0, dash);
        pre = __sv_slice(core_pre, dash + 1, core_pre.len());
        if (pre.len() == 0) { return None; }
    }
    var parts: string[] = core.split(".");
    if (parts.len() != 3) { return None; }
    var maj: Option[i32] = __sv_num(parts[0]);
    var min: Option[i32] = __sv_num(parts[1]);
    var pat: Option[i32] = __sv_num(parts[2]);
    match (maj) {
        None => { return None; },
        Some(mj) => {
            match (min) {
                None => { return None; },
                Some(mn) => {
                    match (pat) {
                        None => { return None; },
                        Some(pt) => {
                            // Validate each prerelease identifier: non-empty; a
                            // purely-numeric one has no leading zero.
                            if (pre.len() > 0) {
                                var ids: string[] = pre.split(".");
                                var i: i32 = 0;
                                while (i < ids.len()) {
                                    var id: string = ids[i];
                                    if (id.len() == 0) { return None; }
                                    if (__sv_all_digits(id) && id.len() > 1 && id[0] == 48) { return None; }
                                    i = i + 1;
                                }
                            }
                            return Some(SemVer { major: mj, minor: mn, patch: pt, prerelease: pre, build: build });
                        }
                    }
                }
            }
        }
    }
}

// `(a).compare(b)` — SemVer precedence: -1 if a < b, 0 if equal, 1 if
// a > b. Build metadata is ignored.
pub function (a: SemVer) compare(b: SemVer): i32 {
    if (a.major != b.major) { if (a.major < b.major) { return 0 - 1; } return 1; }
    if (a.minor != b.minor) { if (a.minor < b.minor) { return 0 - 1; } return 1; }
    if (a.patch != b.patch) { if (a.patch < b.patch) { return 0 - 1; } return 1; }
    // Equal core: a version with a prerelease ranks below one without.
    var ap: boolean = a.prerelease.len() > 0;
    var bp: boolean = b.prerelease.len() > 0;
    if (!ap && !bp) { return 0; }
    if (!ap && bp) { return 1; }
    if (ap && !bp) { return 0 - 1; }
    var ai: string[] = a.prerelease.split(".");
    var bi: string[] = b.prerelease.split(".");
    var n: i32 = ai.len();
    if (bi.len() < n) { n = bi.len(); }
    var i: i32 = 0;
    while (i < n) {
        var c: i32 = __sv_cmp_ident(ai[i], bi[i]);
        if (c != 0) { return c; }
        i = i + 1;
    }
    // All shared identifiers equal: more identifiers wins.
    if (ai.len() < bi.len()) { return 0 - 1; }
    if (ai.len() > bi.len()) { return 1; }
    return 0;
}

// `(a).eq(b)` / `(a).lt(b)` / `(a).gt(b)` — precedence convenience
// predicates. `eq` follows precedence (build metadata does not count).
pub function (a: SemVer) eq(b: SemVer): boolean { return a.compare(b) == 0; }
pub function (a: SemVer) lt(b: SemVer): boolean { return a.compare(b) < 0; }
pub function (a: SemVer) gt(b: SemVer): boolean { return a.compare(b) > 0; }

// `(v).to_string()` — the canonical `major.minor.patch[-pre][+build]`.
pub function (v: SemVer) to_string(): string {
    var out: string = v.major.to_string() + "." + v.minor.to_string() + "." + v.patch.to_string();
    if (v.prerelease.len() > 0) { out = out + "-" + v.prerelease; }
    if (v.build.len() > 0) { out = out + "+" + v.build; }
    return out;
}
