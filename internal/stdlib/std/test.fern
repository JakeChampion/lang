// std/test — pure-Fern unit-test runner.
//
// Designed to replace the Go-side `*_test.go` harness once the
// compiler itself is self-hosted (see
// docs/ROADMAP-AND-SELF-HOSTING.md). The runner takes no
// compiler dependency: it's an ordinary Fern program that
// uses the helpers exported here, threads a `TestRunner`
// accumulator through each test case, and exits 0 on success
// / 1 on any failure. Output is TAP-13
// (https://testanything.org/) so existing CI tooling
// (`prove`, `tape`, jUnit converters) can consume it directly
// while we transition off Go.
//
// A test program imports this module and calls its free
// functions qualified (`test.test_new`, `test.assert_eq`,
// `test.fail`), with the runner type written `test.TestRunner`;
// receiver methods (`.it`, `.finish`) stay bare:
//
//   import "std/test";
//
//   function test_addition(): TestOutcome {
//       return test.assert_eq(2 + 2, 4);
//   }
//
//   function test_strings(): TestOutcome {
//       return test.assert_eq("foo" + "bar", "foobar");
//   }
//
//   function main(): i32 {
//       var r: test.TestRunner = test.test_new("arithmetic");
//       r = r.it("addition", test_addition);
//       r = r.it("strings", test_strings);
//       return r.finish();
//   }
//
// Tests are functions returning TestOutcome:
//   Pass       — the case passed
//   Fail(msg)  — the case failed; msg is the human-readable diff
//
// The runner is value-semantic — `r.it(...)` returns a fresh
// TestRunner with the result folded in. That matches the rest
// of Fern's stdlib (Array.push, struct receiver methods) and
// sidesteps the lack of interior mutability.
//
// (`it` matches the BDD `describe / it` convention from JS / Ruby
// test frameworks.)
//
// Discovery is intentionally explicit: Fern has no reflection,
// so `main` lists the tests it runs. That's the same shape
// Zig's `test` blocks compile down to and the same shape any
// future macro / build-step driven discovery would lower to.

// std/test reaches for (i32).to_string() in the f-string
// failure messages and (string).contains / .starts_with /
// .ends_with in the substring assertion helpers, so it
// declares the stdlib modules it leans on explicitly.
import "std/i32";
import "core/map";
// Display / Eq / Ord traits + their primitive impls back the generic
// `assert_eq` / `assert_neq` / `assert_lt` … helpers.
import "core/cmp";
// Wider int formatters for the i64 / u32 / u64 assertion
// families. Each module exposes a `(n).to_string()` receiver
// method dispatching through `__int_to_string_u64`.
import "std/i64";
import "std/u32";
import "std/u64";
// f32 / f64 `.to_string()` for the near/rel float assertion families.
import "std/float";
import "std/array";
import "std/string";
// `assert_json_eq` parses both sides and walks the JsonValue
// trees in order-independent fashion (JObject keys can come
// out of `Map.keys()` in any order). Std/json is already a
// stdlib module, so the dependency is just an in-stdlib link.
import "std/json";

// TestRunner — per-suite accumulator. Threaded through each
// `.it(name, body)` call. `failures` keeps the formatted
// "<name>: <message>" line for every failing case so finish()
// can repeat them at the bottom of the run (TAP consumers can
// look at the per-line not-ok output; humans want a summary).
//
// `skipped` mirrors `failures` for cases that bailed out before
// running their assertion — toolchain missing, OS-conditional,
// etc. They print as `ok N - name # SKIP reason` per TAP-13,
// stay counted separately from passes / fails, and don't affect
// the exit code (skipping isn't a failure).
//
// `prefix` lets nested subsuites prepend "<parent> / " to each
// case name without losing the flat TAP stream. The parent
// runner threads a child through `(r) subsuite(name)` which
// inherits the parent's counters by reference (via the
// `child = parent` value copy + a merge at the end), then
// `(parent) merge(child)` folds the child's counts back. The
// flat stream makes the output legible under any TAP consumer
// while the name prefix preserves the hierarchy.
pub struct TestRunner {
    suite: string,
    passed: i32,
    failed: i32,
    skipped: i32,
    failures: string[],
    skip_reasons: string[],
    verbose: boolean,
    prefix: string,
    base_idx: i32,
    // `cleanup_paths` is the list of paths to `remove_dir_all`
    // when `finish()` runs. Registered via
    // `(r) defer_cleanup(path)` — typically a tempdir from
    // `temp_dir(...)`. The cleanup runs even when tests fail
    // (it's the test-end behaviour, not the test-success
    // behaviour) — failures still produce the non-zero exit
    // code but the filesystem stays tidy.
    cleanup_paths: string[],
    // `filter` substrings the runner against. Empty string means
    // "run every case". Set via `test_new_filtered(...)` or
    // `parse_filter_from_args(args())` so a test program can
    // accept `fern -interp test.fern -- --filter PATTERN`
    // without hand-rolling the argv plumbing. Cases whose
    // (prefix + name) don't contain the filter substring get
    // converted to skips with reason "filtered out".
    filter: string,
    // `fail_fast` short-circuits subsequent `it()` calls into
    // skips once any case has failed. Use for long suites
    // where you want to fix the first failure before learning
    // about the next 50. Off by default (the full TAP stream
    // is usually more useful in CI). Set via
    // `test_new_fail_fast(suite)` or
    // `parse_fail_fast_from_args(args())` so a test program
    // can accept `fern -interp test.fern -- --fail-fast`.
    fail_fast: boolean,
    // `quiet` suppresses the per-case `ok N - name` line for
    // passes + skips so the user sees only the failures (and
    // the summary). Trade-off: TAP consumers that rely on the
    // case list reconstruct from the `1..N` plan line at the
    // bottom; humans get a short failure-focused report.
    // Off by default — full TAP is the better default for CI
    // log scrapers. Set via `test_new_quiet(suite)` /
    // `(r).with_quiet()` / `parse_quiet_from_args(args())`.
    quiet: boolean,
}

// TestOutcome — the result of running one assertion / test case.
//
//   Pass        — the case passed
//   Fail(msg)   — the case failed; `msg` is the human-readable diff
//
// This is the honest model: a passing case is `Pass`, a failing case
// carries its diagnostic in `Fail`. (An earlier shape reused
// `Option[string]` with `None` = pass, which inverted the usual
// "None means absent/bad" intuition — see issue #2666.) Construct
// outcomes with the `pass()` / `fail(msg)` helpers (or the bare
// `Pass` / `Fail(msg)` variants), and pass them unevaluated to
// `(r).it(name, body)`.
pub enum TestOutcome {
    Pass,
    Fail(string),
}

// test_new(suite) — start a new run. `suite` labels the run in
// the TAP `# Suite:` comment line. Tests print as they execute
// so a hanging case is obvious in the output stream.
pub function test_new(suite: string): TestRunner {
    print("TAP version 13");
    print("# Suite: " + suite);
    return TestRunner {
        suite: suite,
        passed: 0,
        failed: 0,
        skipped: 0,
        failures: [],
        skip_reasons: [],
        verbose: false,
        prefix: "",
        base_idx: 0,
        cleanup_paths: [],
        filter: "",
        fail_fast: false,
        quiet: false,
    };
}

// test_new_filtered(suite, filter) — same as test_new but
// pre-installs a case-name filter. Cases whose
// (prefix + name) don't contain the filter substring skip
// instead of running. Use `parse_filter_from_args(args())`
// to lift the filter from a `--filter PATTERN` command-line
// flag without hand-rolling the argv plumbing.
pub function test_new_filtered(suite: string, filter: string): TestRunner {
    var r: TestRunner = test_new(suite);
    return TestRunner { ...r, filter: filter };
}

// parse_filter_from_args(args) — scan a `args()`-style
// string array for `--filter PATTERN` or `--filter=PATTERN`
// and return the pattern. Returns "" if no flag was given,
// which matches the "no filter" sentinel `test_new_filtered`
// uses.
//
//   var r: TestRunner = test_new_filtered("my suite",
//                                         parse_filter_from_args(args()));
//
// Skip patterns that are CLI-flag-shaped beyond the basic
// `--filter` — anything fancier should reach for a real
// argv-parser module once one lands.
pub function parse_filter_from_args(argv: string[]): string {
    var i: i32 = 0;
    while (i < argv.len()) {
        var a: string = argv[i];
        if (a == "--filter" && i + 1 < argv.len()) {
            return argv[i + 1];
        }
        if (a.starts_with("--filter=")) {
            return a[9:a.len()].to_owned();
        }
        i = i + 1;
    }
    return "";
}

// test_new_fail_fast(suite) — same as test_new but enables
// fail-fast mode. Once any case fails, subsequent `it()`
// calls auto-skip with the reason "fail-fast: prior case
// failed" rather than running. Use for long suites where
// you want to fix the first failure before learning
// about the next 50.
//
// Pair with `parse_fail_fast_from_args(args())` to lift the
// setting from a `--fail-fast` command-line flag:
//
//   var r: TestRunner = test_new("my suite");
//   if (parse_fail_fast_from_args(args())) { r = r.with_fail_fast(); }
pub function test_new_fail_fast(suite: string): TestRunner {
    var r: TestRunner = test_new(suite);
    return r.with_fail_fast();
}

// `(r).with_fail_fast()` — flips fail-fast mode on for an
// existing runner. Lets a test that already constructed
// `r` via `test_new(...)` opt into fail-fast based on a
// CLI flag without having to discard the runner.
pub function (r: TestRunner) with_fail_fast(): TestRunner {
    return TestRunner { ...r, fail_fast: true };
}

// `parse_fail_fast_from_args(argv)` — true iff `--fail-fast`
// appears anywhere in `argv`. Use with `with_fail_fast()`:
//
//   var r: TestRunner = test_new("my suite");
//   if (parse_fail_fast_from_args(args())) {
//       r = r.with_fail_fast();
//   }
pub function parse_fail_fast_from_args(argv: string[]): boolean {
    var i: i32 = 0;
    while (i < argv.len()) {
        if (argv[i] == "--fail-fast") { return true; }
        i = i + 1;
    }
    return false;
}

// `test_new_quiet(suite)` — same as test_new but enables
// quiet mode. In quiet mode, the per-case `ok N - name`
// line is suppressed for passes + skips; only failures
// emit per-case detail. The `1..N` plan line and the
// summary at the bottom still print, so TAP consumers
// that need the case count reconstruct it from there.
//
// Use for the developer loop where seeing every passing
// test is more noise than signal. CI logs are usually
// better off WITHOUT this (full TAP makes regressions
// easier to triage).
//
// Pair with `parse_quiet_from_args(args())` to lift the
// setting from a `--quiet` command-line flag:
//
//   var r = test_new("my suite");
//   if (parse_quiet_from_args(args())) { r = r.with_quiet(); }
pub function test_new_quiet(suite: string): TestRunner {
    var r: TestRunner = test_new(suite);
    return r.with_quiet();
}

// `(r).with_quiet()` — flips quiet mode on for an existing
// runner. Lets a test that already constructed `r` via
// `test_new(...)` opt into quiet based on a CLI flag
// without having to discard the runner.
pub function (r: TestRunner) with_quiet(): TestRunner {
    return TestRunner { ...r, quiet: true };
}

// `parse_quiet_from_args(argv)` — true iff `--quiet`
// appears anywhere in `argv`. Use with `with_quiet()`:
//
//   var r = test_new("my suite");
//   if (parse_quiet_from_args(args())) { r = r.with_quiet(); }
pub function parse_quiet_from_args(argv: string[]): boolean {
    var i: i32 = 0;
    while (i < argv.len()) {
        if (argv[i] == "--quiet") { return true; }
        i = i + 1;
    }
    return false;
}

// test_new_verbose(suite) — same as test_new but flags the
// runner for future verbose output. Currently identical to
// test_new because TAP-13 already prints every case; the flag
// is reserved for a future "--verbose" mode that adds timing
// or extra context to passing cases.
pub function test_new_verbose(suite: string): TestRunner {
    var r: TestRunner = test_new(suite);
    return TestRunner { ...r, verbose: true };
}

// (r) it(name, body) — run one test and record its outcome.
// `body` is the test itself, passed unevaluated — a bare
// function name, or `() => …` for anything taking arguments:
//
//   r = r.it("parses", test_parses);
//   r = r.it("adds",   () => assert_eq(add(2, 2), 4));
//
// Its outcome decides the line:
//   Pass       prints "ok N - name"
//   Fail(msg)  prints "not ok N - name" + the YAML-ish ---
//              block TAP uses for diagnostic detail
//
// Taking the test unevaluated is what makes the runner's own
// controls real: a case the filter excludes, or one cut short
// by fail-fast, is never RUN — where an already-evaluated
// outcome had done its work before `it` could see it.
//
// The displayed name is `r.prefix + name`, so a subsuite's
// cases land as "parent / child / actual case" in the flat
// TAP stream. The bare `name` is what surfaces in the
// failures summary at the bottom of finish() — typically the
// prefix duplicates the suite line so the bottom summary
// stays scannable.
pub function (r: TestRunner) it(name: string, body: () => TestOutcome): TestRunner {
    var display: string = r.prefix + name;
    // Pre-filter: skip cases whose display name doesn't match
    // the runner's filter pattern (set via `test_new_filter`).
    // Counted as skipped rather than not-printed so the TAP
    // stream stays a faithful record of the test list.
    if (r.filter.len() > 0 && !display.contains(r.filter)) {
        return r.skip(name, "filtered out (--filter=" + r.filter + ")");
    }
    // Fail-fast short-circuit. Once any case has failed in
    // this run, convert subsequent `it()` calls into skips.
    // We still emit a TAP line so the case appears in the
    // plan — same handling as a filter skip; the
    // distinguishing wording in the SKIP reason is what
    // tells the reader what cut the run short.
    if (r.fail_fast && r.failed > 0) {
        return r.skip(name, "fail-fast: prior case failed");
    }
    var idx: i32 = r.base_idx + r.passed + r.failed + r.skipped + 1;
    // Everything that could skip this case has been decided, so
    // now the test actually runs.
    match (body()) {
        Pass => {
            // Suppress the per-case line in quiet mode —
            // failures still print below (they always
            // print, regardless of mode).
            if (!r.quiet) {
                print("ok " + idx.to_string() + " - " + display);
            }
            return TestRunner { ...r, passed: r.passed + 1 };
        },
        Fail(msg) => {
            print("not ok " + idx.to_string() + " - " + display);
            print("  ---");
            print("  message: " + msg);
            print("  ---");
            var fs: string[] = r.failures.append(display + ": " + msg);
            return TestRunner { ...r, failed: r.failed + 1, failures: fs };
        }
    }
}

// (r) skip(name, reason) — record a case that didn't run.
// Emits TAP-13's `# SKIP <reason>` directive on the `ok` line
// so consumers (`prove`, `tape`, jUnit converters) can
// distinguish it from a real pass. The skipped count is
// tracked separately and doesn't influence the exit code:
// missing toolchains / OS-conditional cases shouldn't fail
// CI on dev laptops that lack the optional dep.
//
// Typical use:
//
//   if (env("WASMTIME_PATH").is_none()) {
//       r = r.skip("wasm e2e", "wasmtime not on $PATH");
//   } else {
//       r = r.it("wasm e2e", run_wasm_test);
//   }
pub function (r: TestRunner) skip(name: string, reason: string): TestRunner {
    var idx: i32 = r.base_idx + r.passed + r.failed + r.skipped + 1;
    var display: string = r.prefix + name;
    if (!r.quiet) {
        print("ok " + idx.to_string() + " - " + display + " # SKIP " + reason);
    }
    var sr: string[] = r.skip_reasons.append(display + ": " + reason);
    return TestRunner { ...r, skipped: r.skipped + 1, skip_reasons: sr };
}

// (r) skip_if(cond, name, reason, body) — conditional run.
// If `cond` is true, the case skips with `reason`; otherwise
// `body` runs and is recorded as usual. Lets callers keep the
// test list flat without an `if`/`else` per gated case.
//
//   r = r.skip_if(env("CI").is_none(), "ci-only", "not CI", run_test);
//
// A skipped case does not run: `body` is passed unevaluated, so
// setup that is expensive or touches the world is skipped too.
pub function (r: TestRunner) skip_if(cond: boolean, name: string, reason: string, body: () => TestOutcome): TestRunner {
    if (cond) { return r.skip(name, reason); }
    return r.it(name, body);
}

// (r) subsuite(name) — start a nested grouping. Returns a
// fresh TestRunner that inherits the parent's prefix and
// counts. After the subsuite's cases land via `child.it(...)`
// / `child.skip(...)`, the parent calls `parent.merge(child)`
// to fold the counters back. The child's case names print
// with the combined prefix so the flat TAP stream stays
// hierarchical:
//
//   r = r.it("standalone", run_standalone);
//   var arm = r.subsuite("arm64");
//   arm = arm.it("exit-code", run_arm64_exit);
//   arm = arm.it("stdout",    run_arm64_stdout);
//   r = r.merge(arm);
//   r = r.it("after subsuite", run_after);
//
// The child runner does NOT print a `# Suite:` line — that's
// reserved for top-level `test_new`. The prefix string is
// the only nesting signal. Two-level nesting works too
// (`arm.subsuite("regress")`) by chaining the prefixes.
pub function (r: TestRunner) subsuite(name: string): TestRunner {
    // Spread `...r` carries the config fields (verbose / filter /
    // fail_fast / quiet) forward; the overrides below reset the
    // counters + accumulators and re-root the prefix / base_idx.
    return TestRunner {
        ...r,
        passed: 0,
        failed: 0,
        skipped: 0,
        failures: [],
        skip_reasons: [],
        prefix: r.prefix + name + " / ",
        // Inherit the parent's running count so the subsuite's
        // first case prints `ok N+1` rather than restarting at
        // `ok 1`. TAP's plan line at the bottom assumes
        // monotonic case numbering across the whole stream.
        base_idx: r.base_idx + r.passed + r.failed + r.skipped,
        // Cleanup hooks registered on the child get returned
        // to the parent via `merge` so finish() always runs
        // them. Empty here — the child accumulates its own as
        // tests register them.
        cleanup_paths: [],
    };
}

// `__append_all(dst, src)` — return `dst` with every element of
// `src` appended in order. The three string-array accumulators in
// `merge` (failures / skip_reasons / cleanup_paths) all folded a
// child list onto a parent with the identical index loop; this
// names that loop once. Plain monomorphic helper (no generics /
// closures) so it stays inside the self-host fixed-point emit
// surface that std/test lands in via the differential gate.
function __append_all(dst: string[], src: string[]): string[] {
    var out: string[] = dst;
    var i: i32 = 0;
    while (i < src.len()) {
        out = out.append(src[i]);
        i = i + 1;
    }
    return out;
}

// (r) merge(child) — fold a subsuite's counters and failure
// notes back into the parent. The child's `passed / failed /
// skipped` get added; its `failures` / `skip_reasons` get
// concatenated. The parent's prefix and verbose flag are
// preserved.
pub function (r: TestRunner) merge(child: TestRunner): TestRunner {
    var fs: string[] = __append_all(r.failures, child.failures);
    var sr: string[] = __append_all(r.skip_reasons, child.skip_reasons);
    var cl: string[] = __append_all(r.cleanup_paths, child.cleanup_paths);
    return TestRunner {
        ...r,
        passed: r.passed + child.passed,
        failed: r.failed + child.failed,
        skipped: r.skipped + child.skipped,
        failures: fs,
        skip_reasons: sr,
        cleanup_paths: cl,
    };
}

// (r) defer_cleanup(path) — register a filesystem path that
// should be removed when `finish()` runs, regardless of test
// outcome. Designed for the `temp_dir(...)` pattern: a test
// creates a fresh directory, registers it for cleanup
// immediately, then writes fixtures + spawns subprocesses
// against it.
//
//   var dir: string = expect_ok(temp_dir("foo"));
//   r = r.defer_cleanup(dir);
//
// Each registered path goes through `remove_dir_all` at
// finish() time. Errors from cleanup are recorded as test
// failures (so a bug that leaves the tmpfs unwritable
// surfaces in CI), but they don't replace the test exit
// code's "real" cause — fast-failing on a cleanup error
// would hide the actual test failure.
pub function (r: TestRunner) defer_cleanup(path: string): TestRunner {
    var cl: string[] = r.cleanup_paths.append(path);
    return TestRunner { ...r, cleanup_paths: cl };
}

// (r) log(msg) — emit a TAP comment (`# msg`) without
// recording a test outcome. Useful for debug breadcrumbs in
// long-running suites — TAP consumers ignore unknown comment
// lines, humans grep for them. Returns the runner unchanged
// so the call chains cleanly between `.it(...)` records:
//
//   r = r.log("about to spawn child");
//   r = r.it("spawned", spawn_test);
//
// Newlines in `msg` get printed verbatim — multiple TAP
// comment lines if `msg` contains `\n`. Lang's `print`
// already handles the trailing newline.
pub function (r: TestRunner) log(msg: string): TestRunner {
    print("# " + msg);
    return r;
}

// `(r).log_kv_string(key, value)` — formatted key=value
// TAP comment. Quotes the value so embedded spaces /
// special chars stay visually separable from the key.
//
//   r = r.log_kv_string("session_id", id);
//   # session_id="abc-123"
//
// Use over plain `r.log(...)` when emitting a structured
// breadcrumb the post-run log scraper might want to parse
// (e.g., "what tempdir did this test use", "what trace id
// did the subprocess produce") — the key=value shape is
// `grep | awk -F=` friendly.
pub function (r: TestRunner) log_kv_string(key: string, value: string): TestRunner {
    print("# " + key + "=\"" + value + "\"");
    return r;
}

// `(r).log_kv_i32(key, value)` — integer-valued breadcrumb.
// Value rendered unquoted so numeric grep / awk filters
// (e.g., `awk -F= '$1=="bytes" && $2>1024'`) work without
// stripping quotes.
pub function (r: TestRunner) log_kv_i32(key: string, value: i32): TestRunner {
    print("# " + key + "=" + value.to_string());
    return r;
}

// `(r).log_kv_i64(key, value)` — wider-int breadcrumb. Use
// for byte counts, timestamps, anything beyond i32 range.
pub function (r: TestRunner) log_kv_i64(key: string, value: i64): TestRunner {
    print("# " + key + "=" + value.to_string());
    return r;
}

// (r) finish() — print the TAP plan line + per-suite summary
// and return the process exit code (0 = all passed, 1 = any
// failed). Call this exactly once at the end of main().
//
// TAP plan goes at the bottom of the output (the "lazy plan"
// shape) because the test count isn't known up-front — we'd
// have to count cases in main() before running them, which
// every test file would have to remember to keep in sync.
// Bottom-plan is permitted by TAP-13 and most consumers
// (`prove`, `tape`) handle it.
pub function (r: TestRunner) finish(): i32 {
    var total: i32 = r.passed + r.failed + r.skipped;
    print("1.." + total.to_string());
    print("# tests " + total.to_string());
    print("# pass " + r.passed.to_string());
    print("# fail " + r.failed.to_string());
    if (r.skipped > 0) {
        print("# skip " + r.skipped.to_string());
    }
    if (r.skipped > 0) {
        print("# skipped:");
        var j: i32 = 0;
        while (j < r.skip_reasons.len()) {
            print("#   " + r.skip_reasons[j]);
            j = j + 1;
        }
    }
    // Run deferred cleanup hooks. Errors print as comments so
    // a tmpfs that's gone read-only on us doesn't get
    // silently swallowed, but they don't override the "real"
    // test result. The exit code below still reflects whether
    // the test assertions themselves passed.
    var k: i32 = 0;
    var cleanup_errored: boolean = false;
    while (k < r.cleanup_paths.len()) {
        var p: string = r.cleanup_paths[k];
        match (remove_dir_all(p)) {
            Ok(_) => { },
            Err(_) => {
                print("# cleanup failed for " + p);
                cleanup_errored = true;
            },
        }
        k = k + 1;
    }
    if (r.failed > 0) {
        print("# failures:");
        var i: i32 = 0;
        while (i < r.failures.len()) {
            print("#   " + r.failures[i]);
            i = i + 1;
        }
        return 1;
    }
    if (cleanup_errored) {
        // No test failed but cleanup did — surface as exit
        // code 2 so CI can tell the difference between "tests
        // ran clean" (0), "tests failed" (1), and
        // "tests passed but cleanup leaked" (2).
        return 2;
    }
    return 0;
}

// =================== ASSERTION HELPERS ===================
//
// Each helper returns TestOutcome:
//   Pass       — the assertion holds
//   Fail(msg)  — the assertion failed; msg describes the diff
//
// Message format: "<predicate>: <detail>" — predicate names the
// assertion so the failure log is grep-able, detail carries the
// actual / expected values formatted for human reading.
//
// Helpers are split per-type because lang doesn't have a way to
// express "any printable value" in a generic signature today.
// As soon as a `Display`/`ToString` trait lands, these collapse
// into one generic helper per family (eq, neq, contains, ...).

// `pass()` — explicit Pass for cases that need an early
// successful return (eg a test that walks a list and bails
// out on the first interesting state).
pub function pass(): TestOutcome {
    return Pass;
}

// `fail(msg)` — explicit failure with a custom message. Useful
// when a test computes its own diff or wants to flag an
// unreachable branch ("expected match to have hit the first arm").
pub function fail(msg: string): TestOutcome {
    return Fail(msg);
}

// `unreachable(label)` — sugar for `fail("unreachable: " +
// label)`. Used in match-default arms / impossible-branch
// dispatchers that the test logic claims can't fire. If the
// branch DOES fire (a refactor expanded the input space), the
// failure message names the label so the bug is grep-able in
// CI logs.
pub function unreachable(label: string): TestOutcome {
    return Fail("unreachable: " + label);
}

// `assert_true(cond)` / `assert_false(cond)` — boolean
// predicates. The failure message names which direction failed
// so a glance at the log makes it obvious.
pub function assert_true(cond: boolean): TestOutcome {
    if (cond) { return Pass; }
    return Fail("assert_true: condition was false");
}

pub function assert_false(cond: boolean): TestOutcome {
    if (!cond) { return Pass; }
    return Fail("assert_false: condition was true");
}

// Generic equality + relational assertions over the core/cmp traits.
// `assert_eq` / `assert_neq` accept any `Eq + Display` type (i32 / i64
// / u32 / u64 / string / boolean, and any user type that implements
// both traits); `assert_lt` / `_le` / `_gt` / `_ge` accept any
// `Ord + Display` type. These replaced the old per-width
// `assert_eq_i32` / `assert_lt_u64` / … families once traits landed
// (docs/TRAITS.md). The failure messages embed both values via
// `to_string` so you don't have to re-run a test to see what came out.
pub function assert_eq[T: cmp.Eq + cmp.Display](actual: T, expected: T): TestOutcome {
    if (actual.eq(expected)) { return Pass; }
    return Fail("assert_eq: expected " + expected.to_string() +
                ", got " + actual.to_string());
}

pub function assert_neq[T: cmp.Eq + cmp.Display](actual: T, expected: T): TestOutcome {
    if (!actual.eq(expected)) { return Pass; }
    return Fail("assert_neq: expected != " + expected.to_string() +
                ", got " + actual.to_string());
}

pub function assert_lt[T: cmp.Ord + cmp.Display](a: T, b: T): TestOutcome {
    if (a.cmp(b) < 0) { return Pass; }
    return Fail("assert_lt: expected " + a.to_string() + " < " + b.to_string());
}

pub function assert_le[T: cmp.Ord + cmp.Display](a: T, b: T): TestOutcome {
    if (a.cmp(b) <= 0) { return Pass; }
    return Fail("assert_le: expected " + a.to_string() + " <= " + b.to_string());
}

pub function assert_gt[T: cmp.Ord + cmp.Display](a: T, b: T): TestOutcome {
    if (a.cmp(b) > 0) { return Pass; }
    return Fail("assert_gt: expected " + a.to_string() + " > " + b.to_string());
}

pub function assert_ge[T: cmp.Ord + cmp.Display](a: T, b: T): TestOutcome {
    if (a.cmp(b) >= 0) { return Pass; }
    return Fail("assert_ge: expected " + a.to_string() + " >= " + b.to_string());
}

// Float equality with a tolerance, plus exact equality for
// callers that want it. Naive `actual == expected` on floats
// is almost never what you want — every textbook says use an
// epsilon. `assert_eq_f32_near` / `_f64_near` make that the
// default; `assert_eq_f32_exact` is the escape hatch for
// canonicalisation tests (NaN bit patterns, f32_bits round-
// trips) where you genuinely want bitwise equality.

// `assert_eq_f64_near(actual, expected, epsilon)` — passes if
// `|actual - expected| <= epsilon`. NaN inputs always fail
// (NaN != anything, including itself); the message names
// "NaN" so the failure is obvious. The helper returns None
// for ±Inf-matching-±Inf, since float subtraction would
// yield NaN there.
pub function assert_eq_f64_near(actual: f64, expected: f64, epsilon: f64): TestOutcome {
    // NaN guard: both `actual != actual` and `expected !=
    // expected` indicate NaN. Bail before subtraction so the
    // failure message can name the offender clearly.
    if (actual != actual) {
        return Fail("assert_eq_f64_near: actual is NaN");
    }
    if (expected != expected) {
        return Fail("assert_eq_f64_near: expected is NaN");
    }
    // ±Inf match-pass: subtraction would yield NaN.
    if (actual == expected) { return Pass; }
    var diff: f64 = actual - expected;
    if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff <= epsilon) { return Pass; }
    return Fail("assert_eq_f64_near: |" + actual.to_string() +
                " - " + expected.to_string() + "| = " + diff.to_string() +
                " > epsilon " + epsilon.to_string());
}

// `assert_eq_f32_near(actual, expected, epsilon)` — f32
// version of the same idea. Widens both sides to f64 for the
// difference calc to avoid the precision-loss artifact where
// `(small_f32 - small_other_f32)` underflows to zero in f32
// arithmetic but the values were genuinely different.
pub function assert_eq_f32_near(actual: f32, expected: f32, epsilon: f32): TestOutcome {
    return assert_eq_f64_near(actual as f64, expected as f64, epsilon as f64);
}

// `assert_eq_f64_rel(actual, expected, rel_tol)` — relative-
// tolerance float compare. Passes when
// `|actual - expected| / |expected| <= rel_tol`. Use this
// when the scale of the expected value varies by many orders
// of magnitude across test cases — an absolute epsilon that's
// generous for `expected=1e6` is wildly too loose for
// `expected=1e-6`. NaN inputs always fail. Falls back to
// absolute compare when `expected == 0.0` (the rel formula
// would divide by zero).
pub function assert_eq_f64_rel(actual: f64, expected: f64, rel_tol: f64): TestOutcome {
    if (actual != actual) {
        return Fail("assert_eq_f64_rel: actual is NaN");
    }
    if (expected != expected) {
        return Fail("assert_eq_f64_rel: expected is NaN");
    }
    if (actual == expected) { return Pass; }
    var diff: f64 = actual - expected;
    if (diff < 0.0) { diff = 0.0 - diff; }
    var denom: f64 = expected;
    if (denom < 0.0) { denom = 0.0 - denom; }
    // expected == 0 makes the ratio undefined — fall back to
    // raw |diff| against `rel_tol` so callers don't have to
    // special-case zero in their test data.
    if (denom == 0.0) {
        if (diff <= rel_tol) { return Pass; }
        return Fail("assert_eq_f64_rel: |" + actual.to_string() +
                    " - 0| = " + diff.to_string() +
                    " > rel_tol " + rel_tol.to_string());
    }
    var ratio: f64 = diff / denom;
    if (ratio <= rel_tol) { return Pass; }
    return Fail("assert_eq_f64_rel: |" + actual.to_string() +
                " - " + expected.to_string() + "| / |" + expected.to_string() +
                "| = " + ratio.to_string() +
                " > rel_tol " + rel_tol.to_string());
}

// `assert_eq_f32_rel(actual, expected, rel_tol)` — f32 mirror
// of `assert_eq_f64_rel`. Same widen-to-f64 trick as
// `assert_eq_f32_near` to avoid precision-loss surprises.
pub function assert_eq_f32_rel(actual: f32, expected: f32, rel_tol: f32): TestOutcome {
    return assert_eq_f64_rel(actual as f64, expected as f64, rel_tol as f64);
}

// `assert_eq_f64_exact(actual, expected)` — bitwise-equal
// floats. Use for f32_bits round-trip tests / canonical-NaN
// checks where epsilons would smuggle bugs through. Most
// other callers want `_near`.
pub function assert_eq_f64_exact(actual: f64, expected: f64): TestOutcome {
    if (actual == expected) { return Pass; }
    // Distinguish NaN failures from value mismatches in the
    // message — NaN never compares equal to anything, so a
    // plain "expected vs actual" diff looks misleading.
    if (actual != actual || expected != expected) {
        return Fail("assert_eq_f64_exact: NaN involved (actual=" +
                    actual.to_string() + ", expected=" + expected.to_string() + ")");
    }
    return Fail("assert_eq_f64_exact: expected " + expected.to_string() +
                ", got " + actual.to_string());
}

// `assert_is_nan_f64(v)` — explicit NaN check. `v != v` is
// the textbook NaN predicate (the only float that doesn't
// compare equal to itself). Helper exists because writing
// `v != v` in a test reads like a typo.
pub function assert_is_nan_f64(v: f64): TestOutcome {
    if (v != v) { return Pass; }
    return Fail("assert_is_nan_f64: expected NaN, got " + v.to_string());
}

pub function assert_is_nan_f32(v: f32): TestOutcome {
    if (v != v) { return Pass; }
    return Fail("assert_is_nan_f32: expected NaN, got " + v.to_string());
}

// boolean / string equality is handled by the generic `assert_eq` /
// `assert_neq` above (boolean and string both implement
// cmp.Eq + cmp.Display). For whitespace-sensitive string comparisons
// where quoted diffs help, reach for `assert_eq_string_diff`.

// `assert_contains(haystack, needle)` — substring search.
// Empty needle always passes (mirrors `(s).contains("")` which
// returns true everywhere). Failure embeds the haystack so the
// diff against your fixture is one glance.
pub function assert_contains(haystack: string, needle: string): TestOutcome {
    if (haystack.contains(needle)) { return Pass; }
    return Fail("assert_contains: \"" + haystack + "\" does not contain \"" + needle + "\"");
}

// `assert_not_contains(haystack, needle)` — the inverse. Empty
// needle always fails because every string contains the empty
// string.
pub function assert_not_contains(haystack: string, needle: string): TestOutcome {
    if (!haystack.contains(needle)) { return Pass; }
    return Fail("assert_not_contains: \"" + haystack + "\" contains \"" + needle + "\"");
}

pub function assert_starts_with(s: string, prefix: string): TestOutcome {
    if (s.starts_with(prefix)) { return Pass; }
    return Fail("assert_starts_with: \"" + s + "\" does not start with \"" + prefix + "\"");
}

pub function assert_ends_with(s: string, suffix: string): TestOutcome {
    if (s.ends_with(suffix)) { return Pass; }
    return Fail("assert_ends_with: \"" + s + "\" does not end with \"" + suffix + "\"");
}

// =================== CASE-INSENSITIVE STRING ASSERTIONS ===================
//
// Strings whose casing isn't observable: HTTP headers,
// environment variable names, file extensions on case-
// insensitive filesystems, user-supplied identifiers
// where the production layer normalised the case.
// std/string already exposes `.eq_ignore_ascii_case`,
// `.contains_ci`, `.starts_with_ci`, `.ends_with_ci` as
// receiver methods; these helpers wrap them in the
// assertion shape (`Fail(msg)` on mismatch) and quote
// both sides in the diagnostic so a case-mismatch
// failure is unambiguous.

// `assert_eq_string_ci(actual, expected)` — ASCII case-
// insensitive equality. Failure embeds both raw values
// (no case-folding applied for display) so the reader
// sees exactly which bytes differ.
pub function assert_eq_string_ci(actual: string, expected: string): TestOutcome {
    if (actual.eq_ignore_ascii_case(expected)) { return Pass; }
    return Fail("assert_eq_string_ci: expected \"" + expected +
                "\" (case-insensitive), got \"" + actual + "\"");
}

// `assert_neq_string_ci(actual, expected)` — must differ
// even after case-folding.
pub function assert_neq_string_ci(actual: string, expected: string): TestOutcome {
    if (!actual.eq_ignore_ascii_case(expected)) { return Pass; }
    return Fail("assert_neq_string_ci: \"" + actual +
                "\" matches \"" + expected + "\" (case-insensitive)");
}

// `assert_contains_ci(haystack, needle)` — case-
// insensitive substring search.
pub function assert_contains_ci(haystack: string, needle: string): TestOutcome {
    if (haystack.contains_ci(needle)) { return Pass; }
    return Fail("assert_contains_ci: \"" + haystack +
                "\" does not contain \"" + needle + "\" (case-insensitive)");
}

// `assert_starts_with_ci(s, prefix)` — case-insensitive
// prefix check.
pub function assert_starts_with_ci(s: string, prefix: string): TestOutcome {
    if (s.starts_with_ci(prefix)) { return Pass; }
    return Fail("assert_starts_with_ci: \"" + s +
                "\" does not start with \"" + prefix + "\" (case-insensitive)");
}

// `assert_ends_with_ci(s, suffix)` — case-insensitive
// suffix check.
pub function assert_ends_with_ci(s: string, suffix: string): TestOutcome {
    if (s.ends_with_ci(suffix)) { return Pass; }
    return Fail("assert_ends_with_ci: \"" + s +
                "\" does not end with \"" + suffix + "\" (case-insensitive)");
}

// `assert_empty_string(s)` — sugar for assert_eq_i32(len(s), 0)
// that names the assertion in the failure message.
pub function assert_empty_string(s: string): TestOutcome {
    if (s.len() == 0) { return Pass; }
    return Fail("assert_empty_string: expected \"\", got \"" + s + "\"");
}

pub function assert_non_empty_string(s: string): TestOutcome {
    if (s.len() > 0) { return Pass; }
    return Fail("assert_non_empty_string: string was empty");
}

// `assert_string_count(haystack, needle, n)` — `needle`
// appears exactly `n` times (non-overlapping) in
// `haystack`. Use when the test cares about cardinality
// (e.g., "the log has 3 ERROR lines", "the output has
// exactly one newline") without committing to where the
// occurrences sit.
// Delegates to `std/string`'s `.count(sub)` receiver
// method so the "non-overlapping" semantics stay
// consistent with other string library callers.
pub function assert_string_count(haystack: string, needle: string, n: i32): TestOutcome {
    var got: i32 = haystack.count(needle);
    if (got == n) { return Pass; }
    return Fail("assert_string_count: \"" + needle +
                "\" appears " + got.to_string() +
                " times, expected " + n.to_string());
}

// `assert_len_i32(arr, n)` / `assert_len_string(arr, n)` —
// array length checks. Split per element type because lang
// doesn't have a `T[]` generic at the function-signature
// level for the call sites we currently want.
// Generic ordered / set array assertions over core/cmp. `assert_sorted_*`
// need `Ord + Display`; `assert_set_eq` / `assert_subset` / `assert_unique`
// need `Eq + Display`. These replaced the per-element-type families once
// traits landed. (`set_eq` / `unique` compare in O(n^2) via `.eq()`
// rather than sorting, since there is no generic sort — same result.)
// See docs/TRAITS.md.
pub function assert_sorted_asc[T: cmp.Ord + cmp.Display](arr: T[]): TestOutcome {
    var i: i32 = 1;
    while (i < arr.len()) {
        if (arr[i - 1].cmp(arr[i]) > 0) {
            return Fail("assert_sorted_asc: inversion at index " + i.to_string() +
                        ": " + arr[i - 1].to_string() + " > " + arr[i].to_string());
        }
        i = i + 1;
    }
    return Pass;
}

pub function assert_sorted_desc[T: cmp.Ord + cmp.Display](arr: T[]): TestOutcome {
    var i: i32 = 1;
    while (i < arr.len()) {
        if (arr[i - 1].cmp(arr[i]) < 0) {
            return Fail("assert_sorted_desc: inversion at index " + i.to_string() +
                        ": " + arr[i - 1].to_string() + " < " + arr[i].to_string());
        }
        i = i + 1;
    }
    return Pass;
}

pub function assert_strictly_sorted_asc[T: cmp.Ord + cmp.Display](arr: T[]): TestOutcome {
    var i: i32 = 1;
    while (i < arr.len()) {
        if (arr[i - 1].cmp(arr[i]) >= 0) {
            return Fail("assert_strictly_sorted_asc: not strict at index " + i.to_string() +
                        ": " + arr[i - 1].to_string() + " >= " + arr[i].to_string());
        }
        i = i + 1;
    }
    return Pass;
}

pub function assert_unique[T: cmp.Eq + cmp.Display](arr: T[]): TestOutcome {
    var i: i32 = 0;
    while (i < arr.len()) {
        var j: i32 = i + 1;
        while (j < arr.len()) {
            if (arr[i].eq(arr[j])) {
                return Fail("assert_unique: duplicate value " + arr[i].to_string());
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return Pass;
}

pub function assert_subset[T: cmp.Eq + cmp.Display](superset: T[], subset: T[]): TestOutcome {
    var used: boolean[] = [];
    var sn: i32 = superset.len();
    var i: i32 = 0;
    while (i < sn) { used = used.append(false); i = i + 1; }
    var j: i32 = 0;
    while (j < subset.len()) {
        var want: T = subset[j];
        var matched: boolean = false;
        var k: i32 = 0;
        while (k < sn && !matched) {
            if (!used[k] && superset[k].eq(want)) {
                used = used.with(k, true);
                matched = true;
            }
            k = k + 1;
        }
        if (!matched) {
            return Fail("assert_subset: " + want.to_string() + " not in superset (with required multiplicity)");
        }
        j = j + 1;
    }
    return Pass;
}

pub function assert_set_eq[T: cmp.Eq + cmp.Display](actual: T[], expected: T[]): TestOutcome {
    var an: i32 = actual.len();
    var en: i32 = expected.len();
    if (an != en) {
        return Fail("assert_set_eq: length differs - expected " +
                    en.to_string() + ", got " + an.to_string());
    }
    // Equal length + actual is a (multiset) subset of expected ⟹ equal.
    var used: boolean[] = [];
    var i: i32 = 0;
    while (i < en) { used = used.append(false); i = i + 1; }
    var j: i32 = 0;
    while (j < an) {
        var want: T = actual[j];
        var matched: boolean = false;
        var k: i32 = 0;
        while (k < en && !matched) {
            if (!used[k] && expected[k].eq(want)) { used = used.with(k, true); matched = true; }
            k = k + 1;
        }
        if (!matched) {
            return Fail("assert_set_eq: multiset differs - extra " + want.to_string());
        }
        j = j + 1;
    }
    return Pass;
}

pub function assert_len_i32(arr: i32[], n: i32): TestOutcome {
    var got: i32 = arr.len();
    if (got == n) { return Pass; }
    return Fail("assert_len_i32: expected length " + n.to_string() +
                ", got " + got.to_string());
}

pub function assert_len_string(arr: string[], n: i32): TestOutcome {
    var got: i32 = arr.len();
    if (got == n) { return Pass; }
    return Fail("assert_len_string: expected length " + n.to_string() +
                ", got " + got.to_string());
}

// `assert_at_i32(arr, idx, expected)` — single-position
// element compare. Use when the test only cares about a
// specific slot of a long array (e.g., "the first emitted
// opcode is OpLoad"). Beats writing a full
// `assert_eq_i32_array` with placeholders, OR an
// `assert_eq_i32(arr[idx], expected)` that won't bound-
// check the index. Out-of-bounds `idx` reports the
// problem distinctly from a value mismatch so the
// regression mode is readable.

// `assert_at_string(arr, idx, expected)` — string-typed
// mirror. Quotes both sides of the diff in the failure
// message.

// `assert_at_i64(arr, idx, expected)` — i64-element mirror.

// `assert_at_u32(arr, idx, expected)` — u32-element mirror.
// Unsigned eq so callers don't have to cast at the call
// site; failure message dispatches through `.to_string`
// which respects the unsigned formatting.

// `assert_at_u64(arr, idx, expected)` — u64-element mirror.

// `assert_at_f64(arr, idx, expected, epsilon)` — f64
// element with tolerance (mirrors `assert_eq_f64_near`'s
// semantics). NaN inputs always fail. The `epsilon`
// parameter is mandatory because exact float equality
// is almost never what tests actually want.
// Generic array assertions over core/cmp. `assert_eq_array` /
// `assert_at` / `assert_array_contains` / `assert_array_not_contains`
// accept any `Eq + Display` element type — they replaced the old
// per-element-width families (`assert_eq_i32_array`, `assert_at_string`,
// …) once traits landed. See docs/TRAITS.md.
pub function assert_eq_array[T: cmp.Eq + cmp.Display](actual: T[], expected: T[]): TestOutcome {
    var an: i32 = actual.len();
    var en: i32 = expected.len();
    if (an != en) {
        return Fail("assert_eq_array: length differs - expected " +
                    en.to_string() + ", got " + an.to_string());
    }
    var i: i32 = 0;
    while (i < an) {
        if (!actual[i].eq(expected[i])) {
            return Fail("assert_eq_array: at index " + i.to_string() +
                        " expected " + expected[i].to_string() +
                        ", got " + actual[i].to_string());
        }
        i = i + 1;
    }
    return Pass;
}

pub function assert_at[T: cmp.Eq + cmp.Display](arr: T[], idx: i32, expected: T): TestOutcome {
    var n: i32 = arr.len();
    if (idx < 0 || idx >= n) {
        return Fail("assert_at: index " + idx.to_string() +
                    " out of bounds (length " + n.to_string() + ")");
    }
    if (arr[idx].eq(expected)) { return Pass; }
    return Fail("assert_at: at index " + idx.to_string() +
                " expected " + expected.to_string() +
                ", got " + arr[idx].to_string());
}

pub function assert_array_contains[T: cmp.Eq + cmp.Display](arr: T[], needle: T): TestOutcome {
    var i: i32 = 0;
    while (i < arr.len()) {
        if (arr[i].eq(needle)) { return Pass; }
        i = i + 1;
    }
    return Fail("assert_array_contains: " +
                needle.to_string() + " not found in array of length " +
                arr.len().to_string());
}

pub function assert_array_not_contains[T: cmp.Eq + cmp.Display](arr: T[], needle: T): TestOutcome {
    var i: i32 = 0;
    while (i < arr.len()) {
        if (arr[i].eq(needle)) {
            return Fail("assert_array_not_contains: " +
                        needle.to_string() +
                        " unexpectedly present at index " + i.to_string());
        }
        i = i + 1;
    }
    return Pass;
}

pub function assert_at_f64(arr: f64[], idx: i32, expected: f64, epsilon: f64): TestOutcome {
    var n: i32 = arr.len();
    if (idx < 0 || idx >= n) {
        return Fail("assert_at_f64: index " + idx.to_string() +
                    " out of bounds (length " + n.to_string() + ")");
    }
    var a: f64 = arr[idx];
    if (a != a) {
        return Fail("assert_at_f64: at index " + idx.to_string() +
                    " actual is NaN");
    }
    if (expected != expected) {
        return Fail("assert_at_f64: at index " + idx.to_string() +
                    " expected is NaN");
    }
    if (a == expected) { return Pass; }
    var diff: f64 = a - expected;
    if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff <= epsilon) { return Pass; }
    return Fail("assert_at_f64: at index " + idx.to_string() +
                " |" + a.to_string() + " - " + expected.to_string() +
                "| = " + diff.to_string() +
                " > epsilon " + epsilon.to_string());
}

// `assert_at_f32(arr, idx, expected, epsilon)` — f32
// mirror. Widens both sides per-element to f64 for the
// difference calc (same precision-safety trick as the
// scalar `assert_eq_f32_near`).
pub function assert_at_f32(arr: f32[], idx: i32, expected: f32, epsilon: f32): TestOutcome {
    var n: i32 = arr.len();
    if (idx < 0 || idx >= n) {
        return Fail("assert_at_f32: index " + idx.to_string() +
                    " out of bounds (length " + n.to_string() + ")");
    }
    var a: f32 = arr[idx];
    if (a != a) {
        return Fail("assert_at_f32: at index " + idx.to_string() +
                    " actual is NaN");
    }
    if (expected != expected) {
        return Fail("assert_at_f32: at index " + idx.to_string() +
                    " expected is NaN");
    }
    if (a == expected) { return Pass; }
    var diff: f64 = (a as f64) - (expected as f64);
    if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff <= (epsilon as f64)) { return Pass; }
    return Fail("assert_at_f32: at index " + idx.to_string() +
                " |" + a.to_string() + " - " + expected.to_string() +
                "| > epsilon " + epsilon.to_string());
}

// `assert_eq_i32_array(actual, expected)` — element-wise i32[]
// equality. Returns the first mismatching index so the failure
// localises a long array diff.


// `assert_eq_i64_array(actual, expected)` — element-wise
// i64 array equality. The width-narrow `_i32_array` won't
// implicitly accept i64 element types (lang has no
// numeric-array covariance), so widening the test to i64
// timestamps / sizes / process IDs needs this dedicated
// helper rather than a cast at every call site.

// `assert_eq_u32_array(actual, expected)` — element-wise
// unsigned i32 array equality. Distinct from `_i32_array`
// because lang treats u32 / i32 as different types under
// `==` for the array element check (and the failure
// message's `to_string` dispatches to the unsigned
// formatter).

// `assert_eq_u64_array(actual, expected)` — element-wise
// u64 array equality.

// `assert_eq_f64_array_near(actual, expected, epsilon)` —
// element-wise float array compare. Each pair must satisfy
// `|actual[i] - expected[i]| <= epsilon`. NaN anywhere fails
// (NaN never compares within tolerance). Use when a function
// returns f64[] and the test wants to pin the whole vector;
// the `_near` semantics mean cumulative rounding error in
// vector ops doesn't fail the test spuriously.
pub function assert_eq_f64_array_near(actual: f64[], expected: f64[], epsilon: f64): TestOutcome {
    var an: i32 = actual.len();
    var en: i32 = expected.len();
    if (an != en) {
        return Fail("assert_eq_f64_array_near: length differs - expected " +
                    en.to_string() + ", got " + an.to_string());
    }
    var i: i32 = 0;
    while (i < an) {
        var a: f64 = actual[i];
        var e: f64 = expected[i];
        if (a != a || e != e) {
            return Fail("assert_eq_f64_array_near: NaN at index " +
                        i.to_string());
        }
        if (a != e) {
            var diff: f64 = a - e;
            if (diff < 0.0) { diff = 0.0 - diff; }
            if (diff > epsilon) {
                return Fail("assert_eq_f64_array_near: at index " +
                            i.to_string() + " |" + a.to_string() +
                            " - " + e.to_string() + "| = " + diff.to_string() +
                            " > epsilon " + epsilon.to_string());
            }
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_eq_f32_array_near(actual, expected, epsilon)` —
// f32 mirror. Widens both sides per element to f64 for the
// difference calc, same precision-safety trick as the
// scalar `assert_eq_f32_near`.
pub function assert_eq_f32_array_near(actual: f32[], expected: f32[], epsilon: f32): TestOutcome {
    var an: i32 = actual.len();
    var en: i32 = expected.len();
    if (an != en) {
        return Fail("assert_eq_f32_array_near: length differs - expected " +
                    en.to_string() + ", got " + an.to_string());
    }
    var i: i32 = 0;
    while (i < an) {
        var a: f32 = actual[i];
        var e: f32 = expected[i];
        if (a != a || e != e) {
            return Fail("assert_eq_f32_array_near: NaN at index " +
                        i.to_string());
        }
        if (a != e) {
            var diff: f64 = (a as f64) - (e as f64);
            if (diff < 0.0) { diff = 0.0 - diff; }
            if (diff > (epsilon as f64)) {
                return Fail("assert_eq_f32_array_near: at index " +
                            i.to_string() + " |" + a.to_string() +
                            " - " + e.to_string() + "| > epsilon " +
                            epsilon.to_string());
            }
        }
        i = i + 1;
    }
    return Pass;
}

// =================== SET-EQUALITY ASSERTIONS ===================
//
// Order-independent multiset comparison for cases where the
// production order is genuinely not observable — `Map.keys()`,
// `read_dir(...)`, parallel-set-difference outputs, etc.
// "Multiset" because duplicates count: `[1, 1, 2]` and
// `[1, 2, 2]` are NOT set-equal here (i.e., both element
// counts must match), matching the typical "same bag of
// values, any order" intent.
//
// Failure messages name the FIRST element that's missing /
// extra so the diff against the fixture is localised, same
// shape as the multi-substring assertions.

// `assert_set_eq_i32(actual, expected)` — multiset
// equality for i32[]. Sorts both inputs ascending via
// `cmp.sort` then delegates to the ordered comparison
// — O(n²) on the sort but n is bounded by the array size
// the test produced.

// `assert_set_eq_string(actual, expected)` — multiset
// equality for string[]. Sorts both via `cmp.sort`
// then delegates to ordered compare.

// `assert_subset_i32(superset, subset)` — every element of
// `subset` must appear in `superset` (with multiplicity).
// O(n*m) over the two lengths; fine for the modest sizes
// that come up in test fixtures.


// =================== PROCESS ASSERTIONS ===================
//
// The migrated e2e suite spawns the compiler binary under test
// and asserts on a (stdout, stderr, exit_code) triple. The
// `exec(cmd, args, stdin)` builtin returns a ProcessResult
// struct; these helpers turn the most common assertions into
// one-liners that fold cleanly into the runner's
// TestOutcome result shape.

// assert_exit(actual: ProcessResult, expected: i32) — verify
// the spawned process exited with the given code. Failure
// message embeds stdout + stderr (truncated to keep CI logs
// readable) so the diff against your fixture is one glance.
pub function assert_exit(actual: ProcessResult, expected: i32): TestOutcome {
    if (actual.exit_code == expected) { return Pass; }
    var tail: string = "";
    if (actual.stdout.len() > 0) {
        tail = tail + "\n  stdout: " + actual.stdout;
    }
    if (actual.stderr.len() > 0) {
        tail = tail + "\n  stderr: " + actual.stderr;
    }
    return Fail("assert_exit: expected " + expected.to_string() +
                ", got " + actual.exit_code.to_string() + tail);
}

// assert_stdout_eq / assert_stderr_eq — exact-byte match
// against the captured stream. Whitespace counts; trim the
// inputs before calling if you want to ignore trailing
// newlines.
pub function assert_stdout_eq(actual: ProcessResult, expected: string): TestOutcome {
    if (actual.stdout == expected) { return Pass; }
    return Fail("assert_stdout_eq: expected \"" + expected +
                "\", got \"" + actual.stdout + "\"");
}

pub function assert_stderr_eq(actual: ProcessResult, expected: string): TestOutcome {
    if (actual.stderr == expected) { return Pass; }
    return Fail("assert_stderr_eq: expected \"" + expected +
                "\", got \"" + actual.stderr + "\"");
}

// assert_stdout_contains / assert_stderr_contains — substring
// search. The expected-substring search is way friendlier
// than exact equality for diagnostic output (where the wording
// changes more often than the substantive content).
pub function assert_stdout_contains(actual: ProcessResult, needle: string): TestOutcome {
    if (actual.stdout.contains(needle)) { return Pass; }
    return Fail("assert_stdout_contains: stdout does not contain \"" +
                needle + "\"\n  stdout: " + actual.stdout);
}

pub function assert_stderr_contains(actual: ProcessResult, needle: string): TestOutcome {
    if (actual.stderr.contains(needle)) { return Pass; }
    return Fail("assert_stderr_contains: stderr does not contain \"" +
                needle + "\"\n  stderr: " + actual.stderr);
}

// assert_process(actual, exit, stdout_substr) — fold the
// common "exit + stdout-contains" triple into one helper so
// the typical e2e shape stays a one-liner. `stdout_substr`
// is treated as a substring search (the most-used direction);
// callers wanting exact match should use
// assert_stdout_eq separately.
pub function assert_process(actual: ProcessResult, expected_exit: i32, stdout_substr: string): TestOutcome {
    if (actual.exit_code != expected_exit) {
        return assert_exit(actual, expected_exit);
    }
    if (stdout_substr.len() > 0 && !actual.stdout.contains(stdout_substr)) {
        return Fail("assert_process: exit " + expected_exit.to_string() +
                    " ok, but stdout missing \"" + stdout_substr +
                    "\"\n  stdout: " + actual.stdout);
    }
    return Pass;
}

// `assert_exit_zero(actual)` — sugar for `assert_exit(..,
// 0)`. By far the most common shape (the "successful CLI
// invocation" path), and naming it explicitly reads
// better in a test summary than `assert_exit(_, 0)`.
pub function assert_exit_zero(actual: ProcessResult): TestOutcome {
    return assert_exit(actual, 0);
}

// `assert_exit_nonzero(actual)` — must have exited with
// some non-zero code (the "expected failure" path).
// Doesn't pin a specific code; use `assert_exit(_, N)`
// when the test cares which non-zero code surfaced.
pub function assert_exit_nonzero(actual: ProcessResult): TestOutcome {
    if (actual.exit_code != 0) { return Pass; }
    return Fail("assert_exit_nonzero: process exited 0, expected non-zero");
}

// `assert_stdout_lines(actual, expected_lines)` — split
// the captured stdout on `\n` and compare to a string
// array. Delegates to `assert_lines_eq` so the failure
// message names the first differing line (same wording
// as the file-side / in-memory variants); a trailing
// newline does NOT count as an extra empty line.
pub function assert_stdout_lines(actual: ProcessResult, expected_lines: string[]): TestOutcome {
    return assert_lines_eq(actual.stdout, expected_lines);
}

// `assert_stderr_lines(actual, expected_lines)` — stderr
// mirror.
pub function assert_stderr_lines(actual: ProcessResult, expected_lines: string[]): TestOutcome {
    return assert_lines_eq(actual.stderr, expected_lines);
}

// `assert_stdout_line_count(actual, n)` — line cardinality
// on stdout. Use when the contract is "produce N records"
// and the lines themselves vary too much to pin exactly
// (timestamps, random ids, etc.). Same line definition as
// `.lines()` — trailing newline doesn't overcount.
pub function assert_stdout_line_count(actual: ProcessResult, n: i32): TestOutcome {
    var got: i32 = (actual.stdout.lines()).len();
    if (got == n) { return Pass; }
    return Fail("assert_stdout_line_count: got " + got.to_string() +
                " lines, expected " + n.to_string());
}

// `assert_stderr_line_count(actual, n)` — stderr mirror.
pub function assert_stderr_line_count(actual: ProcessResult, n: i32): TestOutcome {
    var got: i32 = (actual.stderr.lines()).len();
    if (got == n) { return Pass; }
    return Fail("assert_stderr_line_count: got " + got.to_string() +
                " lines, expected " + n.to_string());
}

// =================== MULTI-SUBSTRING ASSERTIONS ===================
//
// Diagnostic-message tests typically want to check that a
// compiler error mentions several relevant tokens — the offending
// identifier, a "did you mean" hint, the source position. Doing
// that with `assert_contains` per substring inflates the case
// count and obscures the actual contract; these collapse the
// check to one assertion with a substring vector.

// `assert_contains_all(haystack, needles)` — every entry in
// `needles` must appear somewhere in `haystack` (order is NOT
// required; if order matters, use a sequence of substring
// `index_of` checks). Empty needles list always passes.
pub function assert_contains_all(haystack: string, needles: string[]): TestOutcome {
    var i: i32 = 0;
    while (i < needles.len()) {
        if (!haystack.contains(needles[i])) {
            return Fail("assert_contains_all: missing \"" + needles[i] +
                        "\" in:\n  " + haystack);
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_contains_any(haystack, needles)` — at least one entry
// in `needles` must appear. Useful for "the diagnostic mentions
// EITHER X or Y" cases where the exact wording is incidental.
// Empty needles list always fails (vacuously: nothing to match).
pub function assert_contains_any(haystack: string, needles: string[]): TestOutcome {
    if (needles.len() == 0) {
        return Fail("assert_contains_any: empty needles list");
    }
    var i: i32 = 0;
    while (i < needles.len()) {
        if (haystack.contains(needles[i])) {
            return Pass;
        }
        i = i + 1;
    }
    return Fail("assert_contains_any: none of " + i.to_string() +
                " needles matched in:\n  " + haystack);
}

// `assert_contains_in_order(haystack, needles)` — every needle
// must appear AND the matches must be in the order given.
// Useful for asserting on a structured diagnostic ("expected
// X at line N, got Y") where the file/line/expected/actual
// sequence is contractual.
pub function assert_contains_in_order(haystack: string, needles: string[]): TestOutcome {
    var cursor: i32 = 0;
    var i: i32 = 0;
    while (i < needles.len()) {
        var rest: str = haystack[cursor:haystack.len()];
        var idx: i32 = rest.index_of(needles[i]);
        if (idx < 0) {
            return Fail("assert_contains_in_order: \"" + needles[i] +
                        "\" not found after byte " + cursor.to_string() +
                        " in:\n  " + haystack);
        }
        cursor = cursor + idx + needles[i].len();
        i = i + 1;
    }
    return Pass;
}

// =================== STRING DIFF ===================
//
// `assert_eq_string` works fine on short values but produces
// unreadable failure messages on multi-line strings — the
// expected/actual blocks blur together and the eye can't find
// the first mismatch. `assert_eq_string_diff` walks both sides
// line-by-line and reports the first differing line with its
// line number + surrounding context.

// `__diff_lines(a, b)` — return the 1-based line number where
// `a` and `b` first differ, or 0 if they match. Counts a length
// difference past end-of-shorter as a difference at the
// shorter's last+1 line.
function __diff_lines(a: string, b: string): i32 {
    var a_lines: string[] = a.lines();
    var b_lines: string[] = b.lines();
    var n: i32 = a_lines.len();
    if (b_lines.len() < n) { n = b_lines.len(); }
    var i: i32 = 0;
    while (i < n) {
        if (a_lines[i] != b_lines[i]) { return i + 1; }
        i = i + 1;
    }
    if (a_lines.len() != b_lines.len()) { return n + 1; }
    return 0;
}

// `assert_eq_string_diff(actual, expected)` — exact equality but
// the failure message reports the first differing line + its
// line number + the values on each side. The diff is friendlier
// than the plain `assert_eq_string` shape for multi-line stdout
// or generated source.
pub function assert_eq_string_diff(actual: string, expected: string): TestOutcome {
    if (actual == expected) { return Pass; }
    var line_no: i32 = __diff_lines(expected, actual);
    var a_lines: string[] = actual.lines();
    var e_lines: string[] = expected.lines();
    var actual_line: string = "<past end>";
    var expected_line: string = "<past end>";
    var ix: i32 = line_no - 1;
    if (ix >= 0 && ix < a_lines.len()) { actual_line = a_lines[ix]; }
    if (ix >= 0 && ix < e_lines.len()) { expected_line = e_lines[ix]; }
    return Fail("assert_eq_string_diff: differ at line " + line_no.to_string() +
                "\n  expected: " + expected_line +
                "\n  actual:   " + actual_line);
}

// `assert_lines_eq(actual, expected_lines)` — split `actual`
// on `\n` and compare line-by-line against `expected_lines`.
// The expected side is an explicit string[], which reads
// better in tests than wrapping the expected output in one
// long backslash-escaped literal. Failure message names the
// first differing line + its 1-based index + both values,
// same shape as `assert_eq_string_diff`.
pub function assert_lines_eq(actual: string, expected_lines: string[]): TestOutcome {
    var a_lines: string[] = actual.lines();
    var an: i32 = a_lines.len();
    var en: i32 = expected_lines.len();
    if (an != en) {
        return Fail("assert_lines_eq: line count differs - expected " +
                    en.to_string() + ", got " + an.to_string());
    }
    var i: i32 = 0;
    while (i < an) {
        if (a_lines[i] != expected_lines[i]) {
            return Fail("assert_lines_eq: differ at line " + (i + 1).to_string() +
                        "\n  expected: " + expected_lines[i] +
                        "\n  actual:   " + a_lines[i]);
        }
        i = i + 1;
    }
    return Pass;
}

// =================== NUMERIC RANGE ASSERTIONS ===================
//
// Common in property tests: "the result must land between two
// inclusive bounds". Equivalent to `assert_ge_i32(v, lo) +
// assert_le_i32(v, hi)` but in one line, with a failure message
// that names the violated side.

// `assert_in_range_i32(v, lo, hi)` — `lo <= v <= hi`.
pub function assert_in_range_i32(v: i32, lo: i32, hi: i32): TestOutcome {
    if (v < lo) {
        return Fail("assert_in_range_i32: " + v.to_string() +
                    " < lower bound " + lo.to_string());
    }
    if (v > hi) {
        return Fail("assert_in_range_i32: " + v.to_string() +
                    " > upper bound " + hi.to_string());
    }
    return Pass;
}

// `assert_in_range_i64(v, lo, hi)` — same for wider ints.
pub function assert_in_range_i64(v: i64, lo: i64, hi: i64): TestOutcome {
    if (v < lo) {
        return Fail("assert_in_range_i64: " + v.to_string() +
                    " < lower bound " + lo.to_string());
    }
    if (v > hi) {
        return Fail("assert_in_range_i64: " + v.to_string() +
                    " > upper bound " + hi.to_string());
    }
    return Pass;
}

// `assert_in_range_f64(v, lo, hi)` — inclusive float range.
// NaN inputs always fail (NaN never satisfies an ordering
// comparison; pretending it's in-range would mask bugs).
pub function assert_in_range_f64(v: f64, lo: f64, hi: f64): TestOutcome {
    if (v != v) {
        return Fail("assert_in_range_f64: value is NaN");
    }
    if (v < lo) {
        return Fail("assert_in_range_f64: " + v.to_string() +
                    " < lower bound " + lo.to_string());
    }
    if (v > hi) {
        return Fail("assert_in_range_f64: " + v.to_string() +
                    " > upper bound " + hi.to_string());
    }
    return Pass;
}

// `assert_in_range_f32(v, lo, hi)` — f32 mirror. Direct
// implementation (not delegating to `_f64`) so the failure
// message names this helper, keeping diagnostics greppable.
pub function assert_in_range_f32(v: f32, lo: f32, hi: f32): TestOutcome {
    if (v != v) {
        return Fail("assert_in_range_f32: value is NaN");
    }
    if (v < lo) {
        return Fail("assert_in_range_f32: " + v.to_string() +
                    " < lower bound " + lo.to_string());
    }
    if (v > hi) {
        return Fail("assert_in_range_f32: " + v.to_string() +
                    " > upper bound " + hi.to_string());
    }
    return Pass;
}

// =================== ORDER / UNIQUENESS ASSERTIONS ===================
//
// Properties that hold across an entire array:
// monotonically non-decreasing (`assert_sorted_*`) and
// no repeated elements (`assert_unique_*`). Pair with sort
// / dedup helpers in production code so the test pins the
// post-condition rather than the implementation detail.

// `assert_sorted_asc_i32(arr)` — `arr[i] <= arr[i+1]` for
// every adjacent pair. Empty / single-element arrays are
// vacuously sorted. Failure message names the first
// inversion + its index so the diagnostic is grep-able.

// `assert_sorted_asc_string(arr)` — lexicographic
// non-decreasing order on strings. Delegates to the
// `sort.string_cmp` ordering used elsewhere in the stdlib
// so "sorted" here means the same thing as
// `cmp.sort(arr)` would produce.

// `assert_sorted_desc_i32(arr)` — strictly the inverse of
// `_asc_i32`: every adjacent pair must satisfy
// `arr[i-1] >= arr[i]`. Use this to pin `cmp.sort_desc(...)`
// output or any reverse-sorted-by-construction code path.

// `assert_sorted_desc_string(arr)` — descending lexicographic.

// `assert_strictly_sorted_asc_i32(arr)` — `arr[i-1] < arr[i]`
// (strict). Use when the contract is "sorted AND unique" —
// equal adjacent pairs are a violation here, unlike the
// non-strict `_asc_i32`. Saves writing `assert_sorted_asc +
// assert_unique` separately.

// `assert_strictly_sorted_asc_string(arr)` — strict
// lexicographic order on strings (same "sorted + unique"
// contract as the i32 variant).

// `assert_unique_i32(arr)` — every element appears at most
// once. Implementation sorts a copy then walks adjacent
// pairs (O(n log n)) — simpler than a hash set and works
// without any extra stdlib dependency. Failure message
// names the first repeated value so the bug is grep-able.

// `assert_unique_string(arr)` — same pattern for strings.

// =================== FILESYSTEM ASSERTIONS ===================
//
// File-state assertions for tests that build a fixture tree
// then verify a subprocess produced the expected output files.
// Layered on `read_file` / `read_dir` so they work under
// `fern -interp`. Names are deliberately verbose
// (`assert_file_exists` rather than `file_exists`) to keep them
// clearly distinguishable from `read_file` itself in user code.

// `assert_file_exists(path)` — the path must be a readable
// file. The check goes through `read_file`, so a path that
// exists but isn't readable surfaces as a failure too.
pub function assert_file_exists(path: string): TestOutcome {
    match (read_file(path)) {
        Ok(_) => { return Pass; },
        Err(_) => {
            return Fail("assert_file_exists: \"" + path + "\" does not exist or is unreadable");
        }
    }
    return Pass;
}

// `assert_file_not_exists(path)` — the path must NOT resolve
// to a readable file. Useful for asserting that a cleanup
// actually scrubbed something.
pub function assert_file_not_exists(path: string): TestOutcome {
    match (read_file(path)) {
        Ok(_) => {
            return Fail("assert_file_not_exists: \"" + path + "\" still exists");
        },
        Err(_) => { return Pass; }
    }
    return Pass;
}

// `assert_file_contents(path, expected)` — read the file and
// compare its full contents (byte-exact) to `expected`. Routes
// the long-string diff through `assert_eq_string_diff` so the
// failure message localises the first differing line.
pub function assert_file_contents(path: string, expected: string): TestOutcome {
    match (read_file(path)) {
        Ok(actual) => { return assert_eq_string_diff(actual, expected); },
        Err(_) => {
            return Fail("assert_file_contents: failed to read \"" + path + "\"");
        }
    }
    return Pass;
}

// `assert_file_lines(path, expected_lines)` — read the file
// and compare its line-decomposed contents to a string array.
// Common shape: a subprocess writes N lines to its output
// file, the test wants to pin each line WITHOUT escaping a
// long multi-line string literal. Delegates to
// `assert_lines_eq` so the line-by-line diff and failure
// message wording stay identical to the in-memory version.
pub function assert_file_lines(path: string, expected_lines: string[]): TestOutcome {
    match (read_file(path)) {
        Ok(actual) => { return assert_lines_eq(actual, expected_lines); },
        Err(_) => {
            return Fail("assert_file_lines: failed to read \"" + path + "\"");
        }
    }
    return Pass;
}

// `assert_file_line_count(path, n)` — count lines in a file.
// Uses the same definition of "line" as `lines()`: a final
// trailing newline does NOT add an extra empty line. Use
// when the contract is "produce N records" and the test
// cares about cardinality more than content.
pub function assert_file_line_count(path: string, n: i32): TestOutcome {
    match (read_file(path)) {
        Ok(actual) => {
            var got: i32 = (actual.lines()).len();
            if (got == n) { return Pass; }
            return Fail("assert_file_line_count: \"" + path +
                        "\" has " + got.to_string() +
                        " lines, expected " + n.to_string());
        },
        Err(_) => {
            return Fail("assert_file_line_count: failed to read \"" +
                        path + "\"");
        }
    }
    return Pass;
}

// `assert_is_file(path)` / `assert_is_dir(path)` —
// `stat`-backed type predicates. `assert_file_exists` (above)
// goes through `read_file` which succeeds for regular files;
// these are the explicit pair for callers that need to
// distinguish files from directories without inspecting the
// raw FileStat themselves.
pub function assert_is_file(path: string): TestOutcome {
    match (stat(path)) {
        Ok(s) => {
            if (s.is_file) { return Pass; }
            if (s.is_dir) {
                return Fail("assert_is_file: \"" + path + "\" is a directory");
            }
            return Fail("assert_is_file: \"" + path + "\" is not a regular file");
        },
        Err(_) => {
            return Fail("assert_is_file: \"" + path + "\" does not exist");
        }
    }
    return Pass;
}

pub function assert_is_dir(path: string): TestOutcome {
    match (stat(path)) {
        Ok(s) => {
            if (s.is_dir) { return Pass; }
            if (s.is_file) {
                return Fail("assert_is_dir: \"" + path + "\" is a regular file");
            }
            return Fail("assert_is_dir: \"" + path + "\" is not a directory");
        },
        Err(_) => {
            return Fail("assert_is_dir: \"" + path + "\" does not exist");
        }
    }
    return Pass;
}

// `assert_file_size(path, expected)` — match the file's byte
// size against an i64 expectation. Useful for fixture tests
// that copy / generate files of a known size.
pub function assert_file_size(path: string, expected: i64): TestOutcome {
    match (stat(path)) {
        Ok(s) => {
            if (s.size == expected) { return Pass; }
            return Fail("assert_file_size: \"" + path + "\" is " +
                        s.size.to_string() + " bytes, expected " + expected.to_string());
        },
        Err(_) => {
            return Fail("assert_file_size: \"" + path + "\" does not exist");
        }
    }
    return Pass;
}

// `assert_eq_dir_listing(dir, expected_names)` — list the
// directory and verify its contents (file/subdir names,
// not paths) form the same multiset as `expected_names`.
// `readdir` order isn't observable, so the helper compares
// by sorting both sides and delegating to
// `assert_eq_string_array` — the failure message
// localises the first mismatching name + its index in
// sorted order.
//
// Pair with `must_temp_dir(r, prefix)` + a fixture-
// creation step to pin "the operation produced exactly
// these files".
pub function assert_eq_dir_listing(dir: string, expected_names: string[]): TestOutcome {
    match (read_dir(dir)) {
        Ok(names) => {
            var actual_sorted: string[] = cmp.sort(names);
            var expected_sorted: string[] = cmp.sort(expected_names);
            return assert_eq_array(actual_sorted, expected_sorted);
        },
        Err(_) => {
            return Fail("assert_eq_dir_listing: failed to read \"" +
                        dir + "\"");
        }
    }
    return Pass;
}

// `assert_file_contains(path, needle)` — file contents include
// the given substring. Faster than `assert_file_contents` when
// the test only cares that the output mentions something
// specific, not that it matches a full golden.
pub function assert_file_contains(path: string, needle: string): TestOutcome {
    match (read_file(path)) {
        Ok(actual) => {
            if (actual.contains(needle)) { return Pass; }
            return Fail("assert_file_contains: \"" + path +
                        "\" does not contain \"" + needle +
                        "\"\n  contents: " + actual);
        },
        Err(_) => {
            return Fail("assert_file_contains: failed to read \"" + path + "\"");
        }
    }
    return Pass;
}

// =================== TEMPDIR CONVENIENCE ===================
//
// `must_temp_dir(r, prefix)` — single-shot tempdir + cleanup
// registration. Returns the path (empty string on failure) and
// a runner with the cleanup hook already wired. Callers that
// expect tempdir creation to always succeed (the typical
// case — `/tmp` is writable on every supported platform) can
// skip the match boilerplate.
//
//   var dir: string = "";
//   var rr: TestRunner = r;
//   match (must_temp_dir(rr, "my-fixture")) {
//       (p, nr) => { dir = p; rr = nr; }
//   }
//
// Returns a 2-tuple `(path, runner)`. When tempdir creation
// fails the runner gets a `skip` recorded and the path is
// empty — callers should check `dir != ""` before using it.
pub function must_temp_dir(r: TestRunner, prefix: string): (string, TestRunner) {
    match (temp_dir(prefix)) {
        Ok(dir) => {
            return (dir, r.defer_cleanup(dir));
        },
        Err(_) => {
            return ("", r.skip("temp_dir " + prefix, "tempdir creation failed"));
        }
    }
    return ("", r);
}

// =================== BENCHMARKS ===================
//
// `(r) bench(name, iterations, fn)` runs `fn` `iterations`
// times, measures each elapsed time via `monotonic_ns()`, and
// emits a TAP comment line with min / median / mean / max in
// microseconds. The case always passes — benchmarks aren't
// pass/fail by default; reach for `bench_max_us` when you
// want a regression bound.
//
// `fn` must be a 0-arg `() => void` closure. Pass a free
// function (`my_workload`) or a tiny shim that drives the
// real workload. Iteration count of 10-100 is typical;
// each iteration runs the whole `fn` body once.

// __bench_sort_us — Sort the elapsed-time samples ascending
// so percentile lookups are straightforward. Selection sort
// because lang's `+` doesn't concatenate non-string arrays
// (the insertion-sort version would have used array
// concatenation to splice the key); selection sort builds
// each step by `push`, which DOES work on every element
// type. O(n²) either way; sample counts stay under ~100 so
// the absolute cost is negligible.
function __bench_sort_us(samples: i64[]): i64[] {
    var n: i32 = samples.len();
    // Track which indices have been consumed via a parallel
    // boolean array — easier than mutating `samples` in place
    // (lang has no in-place array set today).
    var taken: boolean[] = [];
    var i: i32 = 0;
    while (i < n) { taken = taken.append(false); i = i + 1; }
    var out: i64[] = [];
    i = 0;
    while (i < n) {
        // Find the smallest still-available value.
        var best: i32 = 0 - 1;
        var j: i32 = 0;
        while (j < n) {
            if (!taken[j]) {
                if (best < 0 || samples[j] < samples[best]) { best = j; }
            }
            j = j + 1;
        }
        out = out.append(samples[best]);
        taken = taken.append(true);   // append to keep length aligned ...
        // ... then re-flag the chosen index. Lang has no
        // in-place set; rebuild `taken` with the slot
        // updated.
        var t2: boolean[] = [];
        var k: i32 = 0;
        while (k < n) {
            if (k == best) { t2 = t2.append(true); }
            else { t2 = t2.append(taken[k]); }
            k = k + 1;
        }
        taken = t2;
        i = i + 1;
    }
    return out;
}

// `(r) bench(name, iterations, fn)` — run `fn` repeatedly,
// emit a TAP comment with the per-iteration timing summary.
// Always passes; use `bench_max_us` for a regression bound.
pub function (r: TestRunner) bench(name: string, iterations: i32, fn: () => void): TestRunner {
    if (iterations <= 0) {
        return r.it(name, () => fail("bench: iterations must be > 0"));
    }
    var samples: i64[] = [];
    var i: i32 = 0;
    while (i < iterations) {
        var start_ns: i64 = monotonic_ns();
        fn();
        var elapsed_ns: i64 = monotonic_ns() - start_ns;
        samples = samples.append(elapsed_ns / (1000 as i64));
        i = i + 1;
    }
    var sorted: i64[] = __bench_sort_us(samples);
    var min_us: i64 = sorted[0];
    var max_us: i64 = sorted[iterations - 1];
    var median_us: i64 = sorted[iterations / 2];
    var sum_us: i64 = 0 as i64;
    var k: i32 = 0;
    while (k < iterations) {
        sum_us = sum_us + sorted[k];
        k = k + 1;
    }
    var mean_us: i64 = sum_us / (iterations as i64);
    print("# bench " + name + " (" + iterations.to_string() + " iters): " +
          "min=" + min_us.to_string() + "us " +
          "median=" + median_us.to_string() + "us " +
          "mean=" + mean_us.to_string() + "us " +
          "max=" + max_us.to_string() + "us");
    return r.it(name, () => Pass);
}

// `(r) bench_max_us(name, iterations, fn, max_us)` — same as
// `bench` but fails when the MEDIAN per-iteration time
// exceeds `max_us`. Median (not mean) is the right
// regression signal: one GC pause inflates the mean but
// leaves the median honest.
pub function (r: TestRunner) bench_max_us(name: string, iterations: i32, fn: () => void, max_us: i64): TestRunner {
    if (iterations <= 0) {
        return r.it(name, () => fail("bench: iterations must be > 0"));
    }
    var samples: i64[] = [];
    var i: i32 = 0;
    while (i < iterations) {
        var start_ns: i64 = monotonic_ns();
        fn();
        var elapsed_ns: i64 = monotonic_ns() - start_ns;
        samples = samples.append(elapsed_ns / (1000 as i64));
        i = i + 1;
    }
    var sorted: i64[] = __bench_sort_us(samples);
    var median_us: i64 = sorted[iterations / 2];
    var max_us_observed: i64 = sorted[iterations - 1];
    print("# bench " + name + " (" + iterations.to_string() + " iters): " +
          "median=" + median_us.to_string() + "us " +
          "max=" + max_us_observed.to_string() + "us " +
          "budget=" + max_us.to_string() + "us");
    if (median_us > max_us) {
        // Format before the lambda so it captures a string, not the two
        // i64s: the self-host compiler's IR path cannot lower an i64
        // capture and bails the whole module to the (deleted) AST
        // emitter. Building the message once is better here anyway.
        var over_us: string = "bench_max_us: median " + median_us.to_string() +
                              "us > budget " + max_us.to_string() + "us";
        return r.it(name, () => Fail(over_us));
    }
    return r.it(name, () => Pass);
}

// `(r) bench_max_ms(name, iterations, fn, max_ms)` —
// millisecond-scale companion to `bench_max_us`. Use when
// the budget is naturally expressed in ms (e.g. "rendering a
// frame in under 16ms") so test authors don't have to
// hand-multiply by 1000. Internally just delegates: 1 ms =
// 1000 us.
pub function (r: TestRunner) bench_max_ms(name: string, iterations: i32, fn: () => void, max_ms: i64): TestRunner {
    return r.bench_max_us(name, iterations, fn, max_ms * (1000 as i64));
}

// =================== TIMING ASSERTIONS ===================
//
// Benchmark-shape assertions: "the operation under test
// completed within N milliseconds". Pair with the
// `monotonic_ns()` builtin to stamp the start time, then
// pass the stamp + the deadline to one of these helpers.
// The deadline is the upper bound — passes when elapsed
// is strictly LESS than the deadline.
//
// Use `monotonic_ns` for the timestamps (not `now_unix_ms`)
// so NTP-style wall-clock adjustments don't move the
// goalposts mid-test.

// `assert_elapsed_lt_ms(start_ns, max_ms)` — passes if the
// elapsed time since `start_ns` (a `monotonic_ns()` stamp)
// is below `max_ms`. The failure message embeds both the
// observed elapsed and the deadline so a flaky-bench
// failure logs enough context to decide whether to bump
// the bound.
pub function assert_elapsed_lt_ms(start_ns: i64, max_ms: i64): TestOutcome {
    var elapsed_ns: i64 = monotonic_ns() - start_ns;
    var elapsed_ms: i64 = elapsed_ns / (1000000 as i64);
    if (elapsed_ms < max_ms) { return Pass; }
    return Fail("assert_elapsed_lt_ms: " + elapsed_ms.to_string() +
                "ms elapsed, expected < " + max_ms.to_string() + "ms");
}

// `assert_elapsed_lt_us(start_ns, max_us)` — finer-grained
// for sub-millisecond budgets. Same shape as the `_ms`
// variant; the failure message reports microseconds.
pub function assert_elapsed_lt_us(start_ns: i64, max_us: i64): TestOutcome {
    var elapsed_ns: i64 = monotonic_ns() - start_ns;
    var elapsed_us: i64 = elapsed_ns / (1000 as i64);
    if (elapsed_us < max_us) { return Pass; }
    return Fail("assert_elapsed_lt_us: " + elapsed_us.to_string() +
                "us elapsed, expected < " + max_us.to_string() + "us");
}

// `assert_close_to_now_ms(actual_ms, max_skew_ms)` —
// compare a wall-clock timestamp against `now_unix_ms()`
// with a tolerance. Used for tests that produce a "this
// happened around now" timestamp (e.g., a log entry, a
// session cookie's issued-at) and want to verify the
// value is recent without pinning it exactly. The skew is
// bidirectional — anything from `now - max_skew_ms` to
// `now + max_skew_ms` passes. Failure message names the
// observed skew (signed; negative means the actual is in
// the future) and the bound.
pub function assert_close_to_now_ms(actual_ms: i64, max_skew_ms: i64): TestOutcome {
    var now_ms: i64 = now_unix_ms();
    var skew_ms: i64 = now_ms - actual_ms;
    var abs_skew: i64 = skew_ms;
    if (abs_skew < (0 as i64)) { abs_skew = (0 as i64) - abs_skew; }
    if (abs_skew <= max_skew_ms) { return Pass; }
    return Fail("assert_close_to_now_ms: skew " + skew_ms.to_string() +
                "ms exceeds bound " + max_skew_ms.to_string() + "ms");
}

// =================== JSON DEEP EQUALITY ===================
//
// Structured-output tests (HTTP handlers emitting JSON,
// diagnostic emitters with structured fields) want to assert
// on the document shape rather than the exact byte-for-byte
// serialization. JObject key order, whitespace, and JNumber
// formatting all vary across emitters; `assert_json_eq`
// parses both sides via `std/json` and walks the JsonValue
// trees in order-independent fashion.

// __json_value_eq compares two JsonValue trees recursively.
// JObject is order-independent (Map iteration order isn't
// observable); arrays, strings, numbers, booleans, null all
// compare structurally. JNumber compares the textual payload
// — the JSON spec doesn't fix precision, so two emitters
// producing "1.0" vs "1" would diverge here; callers that
// want numeric tolerance should parse + cast themselves.
function __json_value_eq(a: JsonValue, b: JsonValue): boolean {
    match (a) {
        JNull => {
            match (b) {
                JNull => { return true; },
                _ => { return false; }
            }
        },
        JBool(av) => {
            match (b) {
                JBool(bv) => { return av == bv; },
                _ => { return false; }
            }
        },
        JNumber(av) => {
            match (b) {
                JNumber(bv) => { return av == bv; },
                _ => { return false; }
            }
        },
        JString(av) => {
            match (b) {
                JString(bv) => { return av == bv; },
                _ => { return false; }
            }
        },
        JArray(av) => {
            match (b) {
                JArray(bv) => {
                    if (av.len() != bv.len()) { return false; }
                    var i: i32 = 0;
                    while (i < av.len()) {
                        if (!__json_value_eq(av[i], bv[i])) { return false; }
                        i = i + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        JObject(am) => {
            match (b) {
                JObject(bm) => {
                    if (am.len() != bm.len()) { return false; }
                    var keys: string[] = am.keys();
                    var i: i32 = 0;
                    while (i < keys.len()) {
                        var k: string = keys[i];
                        match (am.get(k)) {
                            None => { return false; },
                            Some(av) => {
                                match (bm.get(k)) {
                                    None => { return false; },
                                    Some(bv) => {
                                        if (!__json_value_eq(av, bv)) { return false; }
                                    }
                                }
                            }
                        }
                        i = i + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        }
    }
    return false;
}

// =================== GOLDEN FILES ===================
//
// Golden-file testing: compare `actual` against the contents
// of `path`. If `path` doesn't exist, write `actual` to it and
// pass — the next run becomes the comparison baseline. This
// is the classic "approve by running" workflow for tests
// whose expected output is too verbose to inline. CI runs
// MUST fail on a missing golden file (the writer side is a
// developer-time convenience); `assert_matches_golden_strict`
// surfaces that distinction.

// `assert_matches_golden(path, actual)` — if `path` exists,
// compare byte-exactly via the line-diff helper. If `path`
// doesn't exist, write `actual` to it and pass with a TAP
// comment noting the bootstrap. Use this during development;
// run `assert_matches_golden_strict` in CI to catch missing-
// golden cases that would silently bootstrap themselves.
pub function assert_matches_golden(path: string, actual: string): TestOutcome {
    match (read_file(path)) {
        Ok(expected) => {
            return assert_eq_string_diff(actual, expected);
        },
        Err(_) => {
            // Golden missing — write the current output as the
            // baseline. The TAP comment makes the bootstrap
            // visible in logs so accidental "approve by
            // running on CI" is easy to spot.
            match (write_file(path, actual)) {
                Ok(_) => {
                    print("# golden file bootstrapped at " + path);
                    return Pass;
                },
                Err(_) => {
                    return Fail("assert_matches_golden: could not write " + path);
                }
            }
        }
    }
    return Pass;
}

// `assert_matches_golden_strict(path, actual)` — same compare
// behaviour but a missing golden file is a FAILURE rather than
// a bootstrap. Use in CI; reach for the auto-bootstrap variant
// only during development.
pub function assert_matches_golden_strict(path: string, actual: string): TestOutcome {
    match (read_file(path)) {
        Ok(expected) => {
            return assert_eq_string_diff(actual, expected);
        },
        Err(_) => {
            return Fail("assert_matches_golden_strict: golden file missing: " + path);
        }
    }
    return Pass;
}

// =================== ENV-VAR ASSERTIONS ===================
//
// Wrap the `env(name)` builtin's Option[string] return in
// `assert_*` form so tests don't have to write the match
// boilerplate every time. Useful for verifying that a
// subprocess inherited the expected environment, or that a
// `setenv` shim took effect.

// `assert_env_set(name)` — `env(name)` returns Some(_). The
// value isn't checked; use `assert_env_eq` when the exact
// content matters.
pub function assert_env_set(name: string): TestOutcome {
    match (env(name)) {
        Some(_) => { return Pass; },
        None => {
            return Fail("assert_env_set: $" + name + " is not set");
        }
    }
    return Pass;
}

// `assert_env_unset(name)` — the inverse. Useful for tests
// that exercise the "use the default when env var missing"
// fallback path.
pub function assert_env_unset(name: string): TestOutcome {
    match (env(name)) {
        Some(v) => {
            return Fail("assert_env_unset: $" + name + " is set to \"" + v + "\"");
        },
        None => { return Pass; }
    }
    return Pass;
}

// `assert_env_eq(name, expected)` — set AND equal to
// `expected`. Failure message distinguishes "var missing"
// from "var present but wrong value" so the diagnostic is
// unambiguous.
pub function assert_env_eq(name: string, expected: string): TestOutcome {
    match (env(name)) {
        Some(v) => {
            if (v == expected) { return Pass; }
            return Fail("assert_env_eq: $" + name + " = \"" + v +
                        "\", expected \"" + expected + "\"");
        },
        None => {
            return Fail("assert_env_eq: $" + name + " is not set");
        }
    }
    return Pass;
}

// =================== MAP ASSERTIONS ===================
//
// `Map[K, V]` is the language's IndexMap container. Tests that
// build a map up and then inspect its contents reach for a
// "does the map have this key", "does the value at this key
// match X", "is the map size N" shape — these helpers fold
// the per-receiver-method check + the assertion into one call.
//
// One generic helper per shape, over
// `[K: cmp.Eq + cmp.Display, V: cmp.Eq + cmp.Display]`: works for any
// K/V whose types implement Eq + Display (i32, string, …). The
// monomorphiser clones a concrete map helper per instantiation on every
// backend — including the self-hosted compiler, whose monomorphiser
// infers both K and V from a single `Map[K, V]` argument. Values render
// via Display, so a string-valued failure prints unquoted.

// `assert_map_len(m, n)` — map length matches.
pub function assert_map_len[K: cmp.Eq + cmp.Display, V: cmp.Eq + cmp.Display](m: Map[K, V], n: i32): TestOutcome {
    var got: i32 = m.len();
    if (got == n) { return Pass; }
    return Fail("assert_map_len: expected " + n.to_string() +
                " entries, got " + got.to_string());
}

// `assert_map_has(m, k, v)` — key `k` is present with value `v`.
// Failure message distinguishes "key missing" from "key present
// with wrong value".
pub function assert_map_has[K: cmp.Eq + cmp.Display, V: cmp.Eq + cmp.Display](m: Map[K, V], k: K, v: V): TestOutcome {
    match (m.get(k)) {
        Some(got) => {
            if (got.eq(v)) { return Pass; }
            return Fail("assert_map_has: key " + k.to_string() +
                        " -> " + got.to_string() + ", expected " + v.to_string());
        },
        None => {
            return Fail("assert_map_has: key " + k.to_string() + " missing");
        }
    }
    return Pass;
}

// `assert_map_lacks(m, k)` — key `k` is NOT present. Used
// after a delete or in negative-result tests.
pub function assert_map_lacks[K: cmp.Eq + cmp.Display, V: cmp.Eq + cmp.Display](m: Map[K, V], k: K): TestOutcome {
    if (m.has(k)) {
        return Fail("assert_map_lacks: key " + k.to_string() + " unexpectedly present");
    }
    return Pass;
}

// `assert_eq_map(actual, expected)` — full map deep equality. Same
// length AND every key in `actual` is present in `expected` with an
// equal value (by pigeonhole this implies the reverse direction too, so
// we only walk one side). Map iteration order isn't observable, so the
// helper walks `actual.keys()` rather than `iter` — order-independent by
// construction. Values are compared with `.eq` and the per-key lookup
// goes through `expected.get(k)` / `actual.get(k)` so the body never
// needs a V-typed default literal. Use this when the test wants to pin
// the WHOLE map state; reach for `_has` / `_lacks` / `_len` when only
// individual entries matter.
pub function assert_eq_map[K: cmp.Eq + cmp.Display, V: cmp.Eq + cmp.Display](actual: Map[K, V], expected: Map[K, V]): TestOutcome {
    var an: i32 = actual.len();
    var en: i32 = expected.len();
    if (an != en) {
        return Fail("assert_eq_map: length differs - expected " +
                    en.to_string() + ", got " + an.to_string());
    }
    var ks: K[] = actual.keys();
    var i: i32 = 0;
    while (i < ks.len()) {
        var k: K = ks[i];
        match (expected.get(k)) {
            None => {
                return Fail("assert_eq_map: key " + k.to_string() +
                            " missing from expected");
            },
            Some(ev) => {
                match (actual.get(k)) {
                    Some(av) => {
                        if (!av.eq(ev)) {
                            return Fail("assert_eq_map: at key " + k.to_string() +
                                        " expected " + ev.to_string() +
                                        ", got " + av.to_string());
                        }
                    },
                    None => {}
                }
            }
        }
        i = i + 1;
    }
    return Pass;
}

// =================== ARRAY-PREDICATE ASSERTIONS ===================
//
// Quantifier helpers over arrays: "every element satisfies
// P" (∀) and "at least one element satisfies P" (∃). The
// predicate is a `(T) => boolean` so callers can pass a
// lambda inline. Failure messages embed the offending
// element's value + 0-based index so a long-array failure
// localises.

// `assert_all_i32(arr, pred)` — every element returns true.
// Vacuously holds for an empty array (matches the
// mathematical convention `∀ x ∈ ∅ : P(x)`).
pub function assert_all_i32(arr: i32[], pred: (i32) => boolean): TestOutcome {
    var i: i32 = 0;
    while (i < arr.len()) {
        if (!pred(arr[i])) {
            return Fail("assert_all_i32: predicate failed at index " +
                        i.to_string() + ": value " + arr[i].to_string());
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_all_string(arr, pred)` — string-typed mirror.
pub function assert_all_string(arr: string[], pred: (string) => boolean): TestOutcome {
    var i: i32 = 0;
    while (i < arr.len()) {
        if (!pred(arr[i])) {
            return Fail("assert_all_string: predicate failed at index " +
                        i.to_string() + ": value \"" + arr[i] + "\"");
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_any_i32(arr, pred)` — at least one element
// returns true. Vacuously FAILS on an empty array
// (`∃ x ∈ ∅ : P(x)` is always false — same convention as
// classical logic). Failure message names the array length
// so an empty-array failure is obvious.
pub function assert_any_i32(arr: i32[], pred: (i32) => boolean): TestOutcome {
    var n: i32 = arr.len();
    var i: i32 = 0;
    while (i < n) {
        if (pred(arr[i])) { return Pass; }
        i = i + 1;
    }
    return Fail("assert_any_i32: no element of " +
                n.to_string() + " matched");
}

// `assert_any_string(arr, pred)` — string-typed mirror.
pub function assert_any_string(arr: string[], pred: (string) => boolean): TestOutcome {
    var n: i32 = arr.len();
    var i: i32 = 0;
    while (i < n) {
        if (pred(arr[i])) { return Pass; }
        i = i + 1;
    }
    return Fail("assert_any_string: no element of " +
                n.to_string() + " matched");
}

// =================== MEMBERSHIP / COUNT ASSERTIONS ===================
//
// Membership: does `needle` appear in `arr`. Same idea as
// the existing `assert_contains(haystack: string, needle:
// string)` but lifted to typed arrays so callers don't
// have to roll their own loop or smuggle the value through
// `assert_any_*` + a `== needle` lambda. The failure
// message embeds the needle so the diagnostic is grep-able.

// `assert_array_contains_i32(arr, needle)` — `needle`
// appears at least once in `arr` (linear scan). Empty
// arrays fail vacuously — there's no element to match.

// `assert_array_contains_string(arr, needle)` — same for
// string elements. Empty array fails vacuously.

// `assert_array_not_contains_i32(arr, needle)` — negative
// membership; useful after a delete / filter operation.

// `assert_array_not_contains_string(arr, needle)` — negative
// membership for string arrays.

// `assert_count_i32(arr, pred, expected_count)` — exactly
// `expected_count` elements of `arr` satisfy `pred`. Sits
// between `assert_all` (every element) and `assert_any` (at
// least one) — pin the exact cardinality. Failure message
// embeds the observed count so the diff is obvious.
pub function assert_count_i32(arr: i32[], pred: (i32) => boolean, expected_count: i32): TestOutcome {
    var hits: i32 = 0;
    var i: i32 = 0;
    while (i < arr.len()) {
        if (pred(arr[i])) { hits = hits + 1; }
        i = i + 1;
    }
    if (hits == expected_count) { return Pass; }
    return Fail("assert_count_i32: expected " +
                expected_count.to_string() + " matches, got " +
                hits.to_string());
}

// `assert_count_string(arr, pred, expected_count)` — string-
// typed mirror.
pub function assert_count_string(arr: string[], pred: (string) => boolean, expected_count: i32): TestOutcome {
    var hits: i32 = 0;
    var i: i32 = 0;
    while (i < arr.len()) {
        if (pred(arr[i])) { hits = hits + 1; }
        i = i + 1;
    }
    if (hits == expected_count) { return Pass; }
    return Fail("assert_count_string: expected " +
                expected_count.to_string() + " matches, got " +
                hits.to_string());
}

// =================== ENUMERATED-VALUE ASSERTIONS ===================
//
// Membership in an allowed set / absence from a forbidden
// set. Common shape: "the response code is one of [200,
// 201, 204]" or "the error class is NOT one of the
// transient ones". Beats writing N OR'd assertions or
// abusing `assert_any_*` with an equality lambda.

// `assert_one_of_i32(actual, allowed)` — `actual ∈ allowed`
// (linear scan on the allowed list — fine for the typical
// 2–10 element allowed sets these helpers target).
// Failure message embeds both the actual value AND the
// full allowed list so the diagnostic carries enough
// context to fix the call site without re-reading the
// test source.
pub function assert_one_of_i32(actual: i32, allowed: i32[]): TestOutcome {
    var i: i32 = 0;
    while (i < allowed.len()) {
        if (allowed[i] == actual) { return Pass; }
        i = i + 1;
    }
    // Build a comma-separated rendering of the allowed set
    // so the message reads like a normal failure diff.
    var rendered: string = "[";
    var j: i32 = 0;
    while (j < allowed.len()) {
        if (j > 0) { rendered = rendered + ", "; }
        rendered = rendered + allowed[j].to_string();
        j = j + 1;
    }
    rendered = rendered + "]";
    return Fail("assert_one_of_i32: " + actual.to_string() +
                " not in allowed set " + rendered);
}

// `assert_one_of_string(actual, allowed)` — string-typed
// mirror.
pub function assert_one_of_string(actual: string, allowed: string[]): TestOutcome {
    var i: i32 = 0;
    while (i < allowed.len()) {
        if (allowed[i] == actual) { return Pass; }
        i = i + 1;
    }
    var rendered: string = "[";
    var j: i32 = 0;
    while (j < allowed.len()) {
        if (j > 0) { rendered = rendered + ", "; }
        rendered = rendered + "\"" + allowed[j] + "\"";
        j = j + 1;
    }
    rendered = rendered + "]";
    return Fail("assert_one_of_string: \"" + actual +
                "\" not in allowed set " + rendered);
}

// `assert_none_of_i32(actual, forbidden)` — `actual ∉
// forbidden`. Use for negative-list checks: "the
// returned exit code is not any of these failure
// sentinels". Failure message names the forbidden value
// the actual matched against, so a refactor that
// accidentally returns the bad value points at the right
// case immediately.
pub function assert_none_of_i32(actual: i32, forbidden: i32[]): TestOutcome {
    var i: i32 = 0;
    while (i < forbidden.len()) {
        if (forbidden[i] == actual) {
            return Fail("assert_none_of_i32: " + actual.to_string() +
                        " matched forbidden value");
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_none_of_string(actual, forbidden)` — string-typed
// mirror.
pub function assert_none_of_string(actual: string, forbidden: string[]): TestOutcome {
    var i: i32 = 0;
    while (i < forbidden.len()) {
        if (forbidden[i] == actual) {
            return Fail("assert_none_of_string: \"" + actual +
                        "\" matched forbidden value");
        }
        i = i + 1;
    }
    return Pass;
}

// =================== OPTION RESULT ASSERTIONS ===================
//
// Wrap the canonical `match (opt) { Some(v) => ..., None
// => fail(...) }` boilerplate that surrounds every test
// of a `Option[T]`-returning function. Lang has no
// generics over the Option payload, so the assertion has
// to be specialised by element type — i32 and string cover
// the bulk of practical Option usage; widen later as
// needed.

// `assert_is_some_i32(opt)` — Option must be `Some(_)`,
// payload value is irrelevant (use `_eq` variant when
// the value also matters).
pub function assert_is_some_i32(opt: Option[i32]): TestOutcome {
    match (opt) {
        Some(_) => { return Pass; },
        None    => { return Fail("assert_is_some_i32: got None"); }
    }
}

// `assert_is_some_string(opt)` — string-typed mirror.
pub function assert_is_some_string(opt: Option[string]): TestOutcome {
    match (opt) {
        Some(_) => { return Pass; },
        None    => { return Fail("assert_is_some_string: got None"); }
    }
}

// `assert_is_none_i32(opt)` — Option must be `None`.
// Failure message embeds the unexpected payload so the
// regression case has its bad value in the log.
pub function assert_is_none_i32(opt: Option[i32]): TestOutcome {
    match (opt) {
        Some(v) => {
            return Fail("assert_is_none_i32: got Some(" +
                        v.to_string() + ")");
        },
        None => { return Pass; }
    }
}

// `assert_is_none_string(opt)` — string-typed mirror.
pub function assert_is_none_string(opt: Option[string]): TestOutcome {
    match (opt) {
        Some(v) => {
            return Fail("assert_is_none_string: got Some(\"" +
                        v + "\")");
        },
        None => { return Pass; }
    }
}

// `assert_is_some_eq_i32(opt, expected)` — Option must be
// `Some(expected)`. The single most common shape: a
// function returns `Option[i32]` indicating "found" /
// "not found", and the test wants to pin both the
// found-ness AND the value. Distinguishes None failures
// from value mismatches in the failure message.
pub function assert_is_some_eq_i32(opt: Option[i32], expected: i32): TestOutcome {
    match (opt) {
        Some(v) => {
            if (v == expected) { return Pass; }
            return Fail("assert_is_some_eq_i32: got Some(" +
                        v.to_string() + "), expected Some(" +
                        expected.to_string() + ")");
        },
        None => {
            return Fail("assert_is_some_eq_i32: got None, expected Some(" +
                        expected.to_string() + ")");
        }
    }
}

// `assert_is_some_eq_string(opt, expected)` — string-typed
// mirror. Quotes both sides in the failure message.
pub function assert_is_some_eq_string(opt: Option[string], expected: string): TestOutcome {
    match (opt) {
        Some(v) => {
            if (v == expected) { return Pass; }
            return Fail("assert_is_some_eq_string: got Some(\"" +
                        v + "\"), expected Some(\"" +
                        expected + "\")");
        },
        None => {
            return Fail("assert_is_some_eq_string: got None, expected Some(\"" +
                        expected + "\")");
        }
    }
}

// =================== RESULT ASSERTIONS ===================
//
// Wrap the canonical `match (res) { Ok(v) => ..., Err(e)
// => fail("expected Ok") }` boilerplate that surrounds
// every test of a `Result[T, IoError]`-returning function
// (`read_file`, `read_dir`, `temp_dir`, `fuzz_corpus_from_
// _dir`, etc.). Stdlib's Result error type is uniformly
// `IoError`, so these helpers specialise on the Ok-type
// only — string and string[] are the practical Ok shapes
// today; widen later as the stdlib grows new fallible
// Result-returning operations.

// `assert_is_ok_string(res)` — Result must be `Ok(_)`,
// payload string is irrelevant.
pub function assert_is_ok_string(res: Result[string, IoError]): TestOutcome {
    match (res) {
        Ok(_)  => { return Pass; },
        Err(_) => { return Fail("assert_is_ok_string: got Err"); }
    }
}

// `assert_is_err_string(res)` — Result must be `Err(_)`.
// Used after a negative-path operation (read a missing
// file, parse invalid input) to confirm the failure
// surfaced. Payload of the Err is irrelevant — pair with
// a downstream substring check on the formatted error if
// the test cares about the error message text.
pub function assert_is_err_string(res: Result[string, IoError]): TestOutcome {
    match (res) {
        Ok(v)  => {
            return Fail("assert_is_err_string: got Ok(\"" + v + "\")");
        },
        Err(_) => { return Pass; }
    }
}

// `assert_is_ok_eq_string(res, expected)` — Result must be
// `Ok(expected)`. The single most common shape: a function
// returns `Result[string, IoError]` and the test wants to
// pin both the success AND the value. Failure messages
// distinguish "got Err when Ok expected" from "got Ok
// with wrong value" so the regression mode is readable.
pub function assert_is_ok_eq_string(res: Result[string, IoError], expected: string): TestOutcome {
    match (res) {
        Ok(v) => {
            if (v == expected) { return Pass; }
            return Fail("assert_is_ok_eq_string: got Ok(\"" +
                        v + "\"), expected Ok(\"" +
                        expected + "\")");
        },
        Err(_) => {
            return Fail("assert_is_ok_eq_string: got Err, expected Ok(\"" +
                        expected + "\")");
        }
    }
}

// `assert_is_ok_string_array(res)` — string-array variant
// (e.g., `read_dir` returns `Result[string[], IoError]`).
pub function assert_is_ok_string_array(res: Result[string[], IoError]): TestOutcome {
    match (res) {
        Ok(_)  => { return Pass; },
        Err(_) => { return Fail("assert_is_ok_string_array: got Err"); }
    }
}

// `assert_is_err_string_array(res)` — Err variant for the
// string-array shape.
pub function assert_is_err_string_array(res: Result[string[], IoError]): TestOutcome {
    match (res) {
        Ok(v)  => {
            return Fail("assert_is_err_string_array: got Ok of length " +
                        v.len().to_string());
        },
        Err(_) => { return Pass; }
    }
}

// =================== ARRAY SET-OPERATION ASSERTIONS ===================
//
// Set-relation properties between two arrays. Pair these
// with `assert_set_eq_*` (full multiset equality) /
// `assert_subset_*` (containment) — they fill out the
// remaining standard set-relation tests:
// "do these share any element" / "are these completely
// disjoint".

// `assert_array_intersects_i32(a, b)` — at least one
// element of `a` also appears in `b`. Empty array on
// either side always fails (intersection with empty is
// empty). Linear-time `O(|a| * |b|)` scan — fine for
// the typical short test arrays.
pub function assert_array_intersects_i32(a: i32[], b: i32[]): TestOutcome {
    var i: i32 = 0;
    while (i < a.len()) {
        var j: i32 = 0;
        while (j < b.len()) {
            if (a[i] == b[j]) { return Pass; }
            j = j + 1;
        }
        i = i + 1;
    }
    return Fail("assert_array_intersects_i32: no shared element between arrays of length " +
                a.len().to_string() + " and " + b.len().to_string());
}

// `assert_array_intersects_string(a, b)` — string-typed
// mirror.
pub function assert_array_intersects_string(a: string[], b: string[]): TestOutcome {
    var i: i32 = 0;
    while (i < a.len()) {
        var j: i32 = 0;
        while (j < b.len()) {
            if (a[i] == b[j]) { return Pass; }
            j = j + 1;
        }
        i = i + 1;
    }
    return Fail("assert_array_intersects_string: no shared element between arrays of length " +
                a.len().to_string() + " and " + b.len().to_string());
}

// `assert_array_disjoint_i32(a, b)` — NO element of `a`
// appears in `b`. The complementary test to `_intersects`;
// either array empty vacuously passes (the intersection
// of empty with anything is empty). Failure message names
// the first shared element.
pub function assert_array_disjoint_i32(a: i32[], b: i32[]): TestOutcome {
    var i: i32 = 0;
    while (i < a.len()) {
        var j: i32 = 0;
        while (j < b.len()) {
            if (a[i] == b[j]) {
                return Fail("assert_array_disjoint_i32: shared element " +
                            a[i].to_string());
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_array_disjoint_string(a, b)` — string-typed
// mirror.
pub function assert_array_disjoint_string(a: string[], b: string[]): TestOutcome {
    var i: i32 = 0;
    while (i < a.len()) {
        var j: i32 = 0;
        while (j < b.len()) {
            if (a[i] == b[j]) {
                return Fail("assert_array_disjoint_string: shared element \"" +
                            a[i] + "\"");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return Pass;
}

// =================== ARRAY PREFIX / SUFFIX / SUBSEQ ===================
//
// Order-sensitive contiguous-region relations. Different
// shape from `assert_set_eq_*` / `assert_subset_*` (which
// ignore order). Common test target: "the result array
// begins with the same header rows", "the buffer ends in
// the EOF sentinel", "the emitted opcodes contain this
// sequence somewhere".

// `assert_array_starts_with_i32(arr, prefix)` —
// `arr[0..len(prefix)] == prefix` (element-wise). Empty
// prefix vacuously passes (every array starts with the
// empty prefix). Failure either reports too-short OR
// names the first non-matching index.
pub function assert_array_starts_with_i32(arr: i32[], prefix: i32[]): TestOutcome {
    var pn: i32 = prefix.len();
    if (pn > arr.len()) {
        return Fail("assert_array_starts_with_i32: array length " +
                    arr.len().to_string() + " < prefix length " +
                    pn.to_string());
    }
    var i: i32 = 0;
    while (i < pn) {
        if (arr[i] != prefix[i]) {
            return Fail("assert_array_starts_with_i32: at index " +
                        i.to_string() + " expected " +
                        prefix[i].to_string() + ", got " +
                        arr[i].to_string());
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_array_starts_with_string(arr, prefix)` — string-
// typed mirror.
pub function assert_array_starts_with_string(arr: string[], prefix: string[]): TestOutcome {
    var pn: i32 = prefix.len();
    if (pn > arr.len()) {
        return Fail("assert_array_starts_with_string: array length " +
                    arr.len().to_string() + " < prefix length " +
                    pn.to_string());
    }
    var i: i32 = 0;
    while (i < pn) {
        if (arr[i] != prefix[i]) {
            return Fail("assert_array_starts_with_string: at index " +
                        i.to_string() + " expected \"" +
                        prefix[i] + "\", got \"" + arr[i] + "\"");
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_array_ends_with_i32(arr, suffix)` —
// `arr[len(arr)-len(suffix)..] == suffix`. Empty suffix
// vacuously passes. Failure reports too-short or names
// the first mismatching index (offset into `arr`).
pub function assert_array_ends_with_i32(arr: i32[], suffix: i32[]): TestOutcome {
    var sn: i32 = suffix.len();
    var an: i32 = arr.len();
    if (sn > an) {
        return Fail("assert_array_ends_with_i32: array length " +
                    an.to_string() + " < suffix length " +
                    sn.to_string());
    }
    var off: i32 = an - sn;
    var i: i32 = 0;
    while (i < sn) {
        if (arr[off + i] != suffix[i]) {
            return Fail("assert_array_ends_with_i32: at index " +
                        (off + i).to_string() + " expected " +
                        suffix[i].to_string() + ", got " +
                        arr[off + i].to_string());
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_array_ends_with_string(arr, suffix)` — string-
// typed mirror.
pub function assert_array_ends_with_string(arr: string[], suffix: string[]): TestOutcome {
    var sn: i32 = suffix.len();
    var an: i32 = arr.len();
    if (sn > an) {
        return Fail("assert_array_ends_with_string: array length " +
                    an.to_string() + " < suffix length " +
                    sn.to_string());
    }
    var off: i32 = an - sn;
    var i: i32 = 0;
    while (i < sn) {
        if (arr[off + i] != suffix[i]) {
            return Fail("assert_array_ends_with_string: at index " +
                        (off + i).to_string() + " expected \"" +
                        suffix[i] + "\", got \"" + arr[off + i] + "\"");
        }
        i = i + 1;
    }
    return Pass;
}

// `__match_subseq_i32` — true iff `needle` appears as a
// contiguous sub-array of `arr` starting at any offset.
// Plain O(N*M) scan; fine for the typical short arrays in
// tests.
function __match_subseq_i32(arr: i32[], needle: i32[]): boolean {
    var nn: i32 = needle.len();
    if (nn == 0) { return true; }
    var an: i32 = arr.len();
    if (nn > an) { return false; }
    var start: i32 = 0;
    while (start <= an - nn) {
        var matched: boolean = true;
        var i: i32 = 0;
        while (i < nn) {
            if (arr[start + i] != needle[i]) { matched = false; i = nn; }
            else { i = i + 1; }
        }
        if (matched) { return true; }
        start = start + 1;
    }
    return false;
}

// `assert_array_contains_subseq_i32(arr, needle)` —
// `needle` appears anywhere in `arr` as a contiguous
// sub-array (order matters). Empty needle vacuously
// passes. Failure message just notes the absence (the
// offending side is the needle, already given to the
// helper — embedding `arr` would bloat the diagnostic
// without adding signal).
pub function assert_array_contains_subseq_i32(arr: i32[], needle: i32[]): TestOutcome {
    if (__match_subseq_i32(arr, needle)) { return Pass; }
    return Fail("assert_array_contains_subseq_i32: needle of length " +
                needle.len().to_string() +
                " not found in array of length " +
                arr.len().to_string());
}

function __match_subseq_string(arr: string[], needle: string[]): boolean {
    var nn: i32 = needle.len();
    if (nn == 0) { return true; }
    var an: i32 = arr.len();
    if (nn > an) { return false; }
    var start: i32 = 0;
    while (start <= an - nn) {
        var matched: boolean = true;
        var i: i32 = 0;
        while (i < nn) {
            if (arr[start + i] != needle[i]) { matched = false; i = nn; }
            else { i = i + 1; }
        }
        if (matched) { return true; }
        start = start + 1;
    }
    return false;
}

// `assert_array_contains_subseq_string(arr, needle)` —
// string-typed mirror.
pub function assert_array_contains_subseq_string(arr: string[], needle: string[]): TestOutcome {
    if (__match_subseq_string(arr, needle)) { return Pass; }
    return Fail("assert_array_contains_subseq_string: needle of length " +
                needle.len().to_string() +
                " not found in array of length " +
                arr.len().to_string());
}

// =================== STRING-ARRAY SUBSTRING ASSERTIONS ===================
//
// "Every line of output starts with TIMESTAMP" / "every
// error message contains a specific code prefix" / "every
// emitted name ends in .fern" — common shapes that
// previously needed a manual loop or
// `assert_all_string + (s) => s.starts_with(prefix)`. The
// helpers below short-circuit on the first non-matching
// element and embed both the offending index AND the
// offending value in the failure message so a long-array
// failure localises immediately.

// `assert_all_starts_with(arr, prefix)` — every element of
// `arr` has `prefix` at byte 0. Empty array vacuously
// passes (∀ over ∅). Empty prefix vacuously passes for
// every non-null string.
pub function assert_all_starts_with(arr: string[], prefix: string): TestOutcome {
    var i: i32 = 0;
    while (i < arr.len()) {
        if (!arr[i].starts_with(prefix)) {
            return Fail("assert_all_starts_with: at index " +
                        i.to_string() + " value \"" + arr[i] +
                        "\" does not start with \"" + prefix + "\"");
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_all_ends_with(arr, suffix)` — every element ends
// with `suffix`. Same shape as the `_starts_with` mirror.
pub function assert_all_ends_with(arr: string[], suffix: string): TestOutcome {
    var i: i32 = 0;
    while (i < arr.len()) {
        if (!arr[i].ends_with(suffix)) {
            return Fail("assert_all_ends_with: at index " +
                        i.to_string() + " value \"" + arr[i] +
                        "\" does not end with \"" + suffix + "\"");
        }
        i = i + 1;
    }
    return Pass;
}

// `assert_all_contain(arr, needle)` — every element
// contains `needle` as a substring. Use when the contract
// is "every error message mentions the operation name" or
// "every emitted log line has the trace id".
pub function assert_all_contain(arr: string[], needle: string): TestOutcome {
    var i: i32 = 0;
    while (i < arr.len()) {
        if (!arr[i].contains(needle)) {
            return Fail("assert_all_contain: at index " +
                        i.to_string() + " value \"" + arr[i] +
                        "\" does not contain \"" + needle + "\"");
        }
        i = i + 1;
    }
    return Pass;
}

// =================== MULTI-OPTION SUBSTRING ASSERTIONS ===================
//
// "String matches one of these prefixes / suffixes" —
// single-string + multiple options. Complement to
// `assert_starts_with(s, prefix)` (single option) and the
// `_all_` family above (every-element + single option).

// `assert_starts_with_any(s, prefixes)` — `s` starts with
// at least one prefix in `prefixes`. Empty `prefixes`
// list always fails (nothing to match).
pub function assert_starts_with_any(s: string, prefixes: string[]): TestOutcome {
    var i: i32 = 0;
    while (i < prefixes.len()) {
        if (s.starts_with(prefixes[i])) { return Pass; }
        i = i + 1;
    }
    return Fail("assert_starts_with_any: \"" + s +
                "\" matches none of " + prefixes.len().to_string() +
                " prefixes");
}

// `assert_ends_with_any(s, suffixes)` — same pattern for
// the suffix family. Common shape: "the file extension is
// one of [.fern, .ll, .s]".
pub function assert_ends_with_any(s: string, suffixes: string[]): TestOutcome {
    var i: i32 = 0;
    while (i < suffixes.len()) {
        if (s.ends_with(suffixes[i])) { return Pass; }
        i = i + 1;
    }
    return Fail("assert_ends_with_any: \"" + s +
                "\" matches none of " + suffixes.len().to_string() +
                " suffixes");
}

// `assert_json_eq(actual, expected)` — both inputs are JSON
// text. Parses each via `std/json`'s `json_parse`, walks the
// resulting trees in order-independent fashion, and reports
// a failure with both raw documents quoted when they differ.
// Invalid JSON on either side surfaces as a failure with
// the offender named so the diagnostic is unambiguous.
//
// Uses the qualified `json.json_parse(...)` form rather than
// bare `json_parse(...)` so modload's rewriter routes the
// call correctly under both the flat-load path (`LoadStdlibFlat`)
// AND the user-side mangled-load path (where the user's own
// `import "std/json";` would have already loaded json's
// decls under the `json__` prefix; bare-name lookup would
// miss them).
pub function assert_json_eq(actual: string, expected: string): TestOutcome {
    var av: Option[JsonValue] = json.json_parse(actual);
    var ev: Option[JsonValue] = json.json_parse(expected);
    match (av) {
        None => {
            return Fail("assert_json_eq: actual is not valid JSON: " + actual);
        },
        Some(a) => {
            match (ev) {
                None => {
                    return Fail("assert_json_eq: expected is not valid JSON: " + expected);
                },
                Some(e) => {
                    if (__json_value_eq(a, e)) { return Pass; }
                    return Fail("assert_json_eq: documents differ\n" +
                                "  expected: " + expected + "\n" +
                                "  actual:   " + actual);
                }
            }
        }
    }
    return Pass;
}

// =================== NARROWER JSON ASSERTIONS ===================
//
// `assert_json_eq` is full-document compare. These helpers
// pin narrower properties so tests don't have to commit to
// pinning every field of a response.

// `assert_json_has_key(json_text, key)` — top-level JObject
// contains `key`. Fails if `json_text` doesn't parse OR
// the top-level value isn't a JObject OR the key is
// absent. Distinct diagnostics for each so the regression
// case names the actual failure mode.
pub function assert_json_has_key(json_text: string, key: string): TestOutcome {
    match (json.json_parse(json_text)) {
        None => {
            return Fail("assert_json_has_key: not valid JSON: " + json_text);
        },
        Some(v) => {
            match (v) {
                JObject(m) => {
                    if (m.has(key)) { return Pass; }
                    return Fail("assert_json_has_key: key \"" + key +
                                "\" not present in object of size " +
                                m.len().to_string());
                },
                JNull      => { return Fail("assert_json_has_key: top-level value is null, not object"); },
                JBool(_)   => { return Fail("assert_json_has_key: top-level value is bool, not object"); },
                JNumber(_) => { return Fail("assert_json_has_key: top-level value is number, not object"); },
                JString(_) => { return Fail("assert_json_has_key: top-level value is string, not object"); },
                JArray(_)  => { return Fail("assert_json_has_key: top-level value is array, not object"); }
            }
        }
    }
    return Pass;
}

// `assert_json_lacks_key(json_text, key)` — top-level
// JObject does NOT contain `key`. Use after a delete /
// filter operation, or to assert a sensitive field
// (e.g., "password_hash") was stripped from a response.
pub function assert_json_lacks_key(json_text: string, key: string): TestOutcome {
    match (json.json_parse(json_text)) {
        None => {
            return Fail("assert_json_lacks_key: not valid JSON: " + json_text);
        },
        Some(v) => {
            match (v) {
                JObject(m) => {
                    if (!m.has(key)) { return Pass; }
                    return Fail("assert_json_lacks_key: key \"" + key +
                                "\" unexpectedly present");
                },
                JNull      => { return Fail("assert_json_lacks_key: top-level value is null, not object"); },
                JBool(_)   => { return Fail("assert_json_lacks_key: top-level value is bool, not object"); },
                JNumber(_) => { return Fail("assert_json_lacks_key: top-level value is number, not object"); },
                JString(_) => { return Fail("assert_json_lacks_key: top-level value is string, not object"); },
                JArray(_)  => { return Fail("assert_json_lacks_key: top-level value is array, not object"); }
            }
        }
    }
    return Pass;
}

// `assert_json_array_len(json_text, n)` — top-level
// JArray has exactly `n` elements. Use when the test
// cares about cardinality (e.g., "the endpoint returned
// 5 records") without pinning each element.
pub function assert_json_array_len(json_text: string, n: i32): TestOutcome {
    match (json.json_parse(json_text)) {
        None => {
            return Fail("assert_json_array_len: not valid JSON: " + json_text);
        },
        Some(v) => {
            match (v) {
                JArray(arr) => {
                    var got: i32 = arr.len();
                    if (got == n) { return Pass; }
                    return Fail("assert_json_array_len: expected length " +
                                n.to_string() + ", got " + got.to_string());
                },
                JNull      => { return Fail("assert_json_array_len: top-level value is null, not array"); },
                JBool(_)   => { return Fail("assert_json_array_len: top-level value is bool, not array"); },
                JNumber(_) => { return Fail("assert_json_array_len: top-level value is number, not array"); },
                JString(_) => { return Fail("assert_json_array_len: top-level value is string, not array"); },
                JObject(_) => { return Fail("assert_json_array_len: top-level value is object, not array"); }
            }
        }
    }
    return Pass;
}

// `assert_json_object_size(json_text, n)` — top-level
// JObject has exactly `n` keys. Cardinality complement to
// `_array_len`.
pub function assert_json_object_size(json_text: string, n: i32): TestOutcome {
    match (json.json_parse(json_text)) {
        None => {
            return Fail("assert_json_object_size: not valid JSON: " + json_text);
        },
        Some(v) => {
            match (v) {
                JObject(m) => {
                    var got: i32 = m.len();
                    if (got == n) { return Pass; }
                    return Fail("assert_json_object_size: expected " +
                                n.to_string() + " keys, got " + got.to_string());
                },
                JNull      => { return Fail("assert_json_object_size: top-level value is null, not object"); },
                JBool(_)   => { return Fail("assert_json_object_size: top-level value is bool, not object"); },
                JNumber(_) => { return Fail("assert_json_object_size: top-level value is number, not object"); },
                JString(_) => { return Fail("assert_json_object_size: top-level value is string, not object"); },
                JArray(_)  => { return Fail("assert_json_object_size: top-level value is array, not object"); }
            }
        }
    }
    return Pass;
}

// =================== JSON FIELD EXTRACTION ASSERTIONS ===================
//
// `assert_json_has_key` checks key presence but not value.
// `assert_json_eq` checks the whole document. These
// helpers sit between: pin a SINGLE top-level field's
// value at a specific type. The most common HTTP/RPC
// test shape — "the response has `user_id` equal to
// 'abc-123'" without committing to the rest of the
// document.
//
// All four parse via `std/json` and report distinct
// diagnostics for invalid JSON / non-object top-level /
// missing key / wrong value type at that key / wrong
// value.

// `assert_json_eq_field_string(json_text, key, expected)`
// — top-level object's `key` is a JString equal to
// `expected`. Failure cases (each distinct in the
// diagnostic): invalid JSON, top-level not object,
// missing key, key not a string, value mismatch.
pub function assert_json_eq_field_string(json_text: string, key: string, expected: string): TestOutcome {
    match (json.json_parse(json_text)) {
        None => {
            return Fail("assert_json_eq_field_string: not valid JSON: " + json_text);
        },
        Some(v) => {
            match (v) {
                JObject(m) => {
                    if (!m.has(key)) {
                        return Fail("assert_json_eq_field_string: key \"" + key +
                                    "\" not present");
                    }
                    match (m.get_or(key, JNull)) {
                        JString(s) => {
                            if (s == expected) { return Pass; }
                            return Fail("assert_json_eq_field_string: at \"" + key +
                                        "\" expected \"" + expected +
                                        "\", got \"" + s + "\"");
                        },
                        JNull      => { return Fail("assert_json_eq_field_string: at \"" + key + "\" value is null, not string"); },
                        JBool(_)   => { return Fail("assert_json_eq_field_string: at \"" + key + "\" value is bool, not string"); },
                        JNumber(_) => { return Fail("assert_json_eq_field_string: at \"" + key + "\" value is number, not string"); },
                        JArray(_)  => { return Fail("assert_json_eq_field_string: at \"" + key + "\" value is array, not string"); },
                        JObject(_) => { return Fail("assert_json_eq_field_string: at \"" + key + "\" value is object, not string"); }
                    }
                },
                JNull      => { return Fail("assert_json_eq_field_string: top-level value is null, not object"); },
                JBool(_)   => { return Fail("assert_json_eq_field_string: top-level value is bool, not object"); },
                JNumber(_) => { return Fail("assert_json_eq_field_string: top-level value is number, not object"); },
                JString(_) => { return Fail("assert_json_eq_field_string: top-level value is string, not object"); },
                JArray(_)  => { return Fail("assert_json_eq_field_string: top-level value is array, not object"); }
            }
        }
    }
    return Pass;
}

// `assert_json_eq_field_i32(json_text, key, expected)` —
// top-level object's `key` is a JNumber parseable to i32
// and equal to `expected`. JNumber stores numbers verbatim
// as strings; we delegate to `parse_int` here so
// "non-numeric" JNumbers (the parser accepts decimals +
// exponents) surface as a parse failure rather than a
// silent miscompare.
pub function assert_json_eq_field_i32(json_text: string, key: string, expected: i32): TestOutcome {
    match (json.json_parse(json_text)) {
        None => {
            return Fail("assert_json_eq_field_i32: not valid JSON: " + json_text);
        },
        Some(v) => {
            match (v) {
                JObject(m) => {
                    if (!m.has(key)) {
                        return Fail("assert_json_eq_field_i32: key \"" + key +
                                    "\" not present");
                    }
                    match (m.get_or(key, JNull)) {
                        JNumber(s) => {
                            match (s.parse_int()) {
                                None => {
                                    return Fail("assert_json_eq_field_i32: at \"" + key +
                                                "\" value \"" + s + "\" not i32-parseable");
                                },
                                Some(got) => {
                                    if (got == expected) { return Pass; }
                                    return Fail("assert_json_eq_field_i32: at \"" + key +
                                                "\" expected " + expected.to_string() +
                                                ", got " + got.to_string());
                                }
                            }
                        },
                        JNull      => { return Fail("assert_json_eq_field_i32: at \"" + key + "\" value is null, not number"); },
                        JBool(_)   => { return Fail("assert_json_eq_field_i32: at \"" + key + "\" value is bool, not number"); },
                        JString(_) => { return Fail("assert_json_eq_field_i32: at \"" + key + "\" value is string, not number"); },
                        JArray(_)  => { return Fail("assert_json_eq_field_i32: at \"" + key + "\" value is array, not number"); },
                        JObject(_) => { return Fail("assert_json_eq_field_i32: at \"" + key + "\" value is object, not number"); }
                    }
                },
                JNull      => { return Fail("assert_json_eq_field_i32: top-level value is null, not object"); },
                JBool(_)   => { return Fail("assert_json_eq_field_i32: top-level value is bool, not object"); },
                JNumber(_) => { return Fail("assert_json_eq_field_i32: top-level value is number, not object"); },
                JString(_) => { return Fail("assert_json_eq_field_i32: top-level value is string, not object"); },
                JArray(_)  => { return Fail("assert_json_eq_field_i32: top-level value is array, not object"); }
            }
        }
    }
    return Pass;
}

// `assert_json_eq_field_bool(json_text, key, expected)` —
// top-level object's `key` is a JBool equal to `expected`.
pub function assert_json_eq_field_bool(json_text: string, key: string, expected: boolean): TestOutcome {
    match (json.json_parse(json_text)) {
        None => {
            return Fail("assert_json_eq_field_bool: not valid JSON: " + json_text);
        },
        Some(v) => {
            match (v) {
                JObject(m) => {
                    if (!m.has(key)) {
                        return Fail("assert_json_eq_field_bool: key \"" + key +
                                    "\" not present");
                    }
                    match (m.get_or(key, JNull)) {
                        JBool(b) => {
                            if (b == expected) { return Pass; }
                            var ebs: string = "false";
                            if (expected) { ebs = "true"; }
                            var gbs: string = "false";
                            if (b) { gbs = "true"; }
                            return Fail("assert_json_eq_field_bool: at \"" + key +
                                        "\" expected " + ebs + ", got " + gbs);
                        },
                        JNull      => { return Fail("assert_json_eq_field_bool: at \"" + key + "\" value is null, not bool"); },
                        JNumber(_) => { return Fail("assert_json_eq_field_bool: at \"" + key + "\" value is number, not bool"); },
                        JString(_) => { return Fail("assert_json_eq_field_bool: at \"" + key + "\" value is string, not bool"); },
                        JArray(_)  => { return Fail("assert_json_eq_field_bool: at \"" + key + "\" value is array, not bool"); },
                        JObject(_) => { return Fail("assert_json_eq_field_bool: at \"" + key + "\" value is object, not bool"); }
                    }
                },
                JNull      => { return Fail("assert_json_eq_field_bool: top-level value is null, not object"); },
                JBool(_)   => { return Fail("assert_json_eq_field_bool: top-level value is bool, not object"); },
                JNumber(_) => { return Fail("assert_json_eq_field_bool: top-level value is number, not object"); },
                JString(_) => { return Fail("assert_json_eq_field_bool: top-level value is string, not object"); },
                JArray(_)  => { return Fail("assert_json_eq_field_bool: top-level value is array, not object"); }
            }
        }
    }
    return Pass;
}
