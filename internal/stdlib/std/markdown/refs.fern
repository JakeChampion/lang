// Link reference definitions (CommonMark 0.31.2, section 4.7) and the
// normalization of link labels. The block parser calls `parse_def` on the
// text of a paragraph when the paragraph closes. The inline parser looks a
// label up with `normalize`.
import "core/map";
import "std/unicode";
import "std/markdown/utf8";

// The destination and the title of a definition, as they are in the source.
// Backslash escapes and entity references are not decoded yet. The title
// keeps its quotes or parentheses, and is empty when there is no title.
pub struct Ref { dest: u8[], title: u8[] }

// A definition that `parse_def` found: `end` is the index after its line, or
// -1 when the text at the start index is not a definition.
pub struct Def { end: i32, label: string, dest: u8[], title: u8[] }

function no_def(): Def {
  return Def { end: -1, label: "", dest: [], title: [] };
}

pub function is_punct(c: i32): boolean {
  return c >= 33 && c <= 47 || c >= 58 && c <= 64 || c >= 91 && c <= 96 || c >= 123 && c <= 126;
}

// The whitespace of cmark: space, tab, line feed, vertical tab, form feed and
// carriage return.
pub function is_space(c: i32): boolean {
  return c == 32 || c >= 9 && c <= 13;
}

// The byte at `i` of a text that ends at `end`, or 0 after its end.
function byte(s: u8[], i: i32, end: i32): i32 {
  if (i < end) {
    return s[i] as i32;
  }
  return 0;
}

function skip_spaces(s: u8[], i: i32, end: i32): i32 {
  let j = i;
  while (byte(s, j, end) == 32 || byte(s, j, end) == 9) {
    j += 1;
  }
  return j;
}

// The index after a line ending at `i`, or `i` at the end of the text, or -1.
function line_end(s: u8[], i: i32, end: i32): i32 {
  let j = i;
  if (byte(s, j, end) == 13) {
    j += 1;
  }
  if (byte(s, j, end) == 10) {
    j += 1;
  }
  if (j > i || j >= end) {
    return j;
  }
  return -1;
}

// Spaces and tabs, then at most one line ending, then spaces and tabs.
function spnl(s: u8[], i: i32, end: i32): i32 {
  let j = skip_spaces(s, i, end);
  let k = line_end(s, j, end);
  if (k > j) {
    return skip_spaces(s, k, end);
  }
  return j;
}

// The index after the `]` of a link label that starts at `i`, or -1. The
// text ends at `end`. A label has no unescaped bracket. As in cmark, it has
// at most 1000 bytes, where the spec has at most 999 characters.
pub function label_end(s: u8[], i: i32, end: i32): i32 {
  if (byte(s, i, end) != 91) {
    return -1;
  }
  let j = i + 1;
  let n = 0;
  while (j < end) {
    let c = s[j] as i32;
    if (c == 91 || c == 93) {
      break;
    }
    j += 1;
    n += 1;
    if (c == 92 && is_punct(byte(s, j, end))) {
      j += 1;
      n += 1;
    }
    if (n > 1000) {
      return -1;
    }
  }
  if (byte(s, j, end) == 93) {
    return j + 1;
  }
  return -1;
}

// The end of a link destination that starts at `i`, or -1. The text ends
// at `end`. A destination in pointy brackets ends after its `>`.
pub function dest_end(s: u8[], i: i32, end: i32): i32 {
  if (byte(s, i, end) == 60) {
    let j = i + 1;
    while (j < end) {
      let c = s[j] as i32;
      if (c == 62) {
        return j + 1;
      }
      if (c == 10 || c == 60) {
        return -1;
      }
      j += 1;
      if (c == 92) {
        j += 1;
      }
    }
    return -1;
  }
  return bare_dest_end(s, i, end);
}

// A destination without brackets: no whitespace, and each unescaped
// parenthesis balanced, at most 32 deep. As in cmark, a control character
// other than whitespace is part of the destination.
// fern-lint: allow cyclomatic-complexity
function bare_dest_end(s: u8[], i: i32, end: i32): i32 {
  let j = i;
  let depth = 0;
  while (j < end && depth <= 32) {
    let c = s[j] as i32;
    if (is_space(c) || c == 41 && depth == 0) {
      break;
    }
    if (c == 40) {
      depth += 1;
    } else if (c == 41) {
      depth -= 1;
    } else if (c == 92 && is_punct(byte(s, j + 1, end))) {
      j += 1;
    }
    j += 1;
  }
  if (j == i && byte(s, j, end) != 41 || j >= end || depth != 0) {
    return -1;
  }
  return j;
}

// The end of a link title that starts at `i`, or -1: text in double quotes,
// in single quotes or in parentheses. A quote in the text needs a backslash
// before it. As in cmark, the title is the longest match. Thus a closing
// quote after a backslash ends the title when no later quote can end it.
pub function title_end(s: u8[], i: i32, end: i32): i32 {
  let open = byte(s, i, end);
  let close = open;
  if (open == 40) {
    close = 41;
  } else if (open != 34 && open != 39) {
    return -1;
  }
  let last = -1;
  for j in i + 1..end {
    let c = s[j] as i32;
    let escaped = s[j - 1] == b'\\';
    if (c == close) {
      last = j + 1;
      if (!escaped) {
        return last;
      }
    } else if (open == 40 && c == 40 && !escaped) {
      return last;
    }
  }
  return last;
}

function has_text(s: u8[], a: i32, b: i32): boolean {
  for i in a..b {
    if (!is_space(s[i] as i32)) {
      return true;
    }
  }
  return false;
}

// The definition that starts at `i` in the text of a paragraph, which ends
// at `end`.
pub function parse_def(s: u8[], i: i32, end: i32): Def {
  let le = label_end(s, i, end);
  if (le < 0 || byte(s, le, end) != 58 || !has_text(s, i + 1, le - 1)) {
    return no_def();
  }
  let ds = spnl(s, le + 1, end);
  let de = dest_end(s, ds, end);
  if (de < 0) {
    return no_def();
  }
  let dest = __bytes_range(s, ds, de);
  if (byte(s, ds, end) == 60) {
    dest = __bytes_range(s, ds + 1, de - 1);
  }
  let ts = spnl(s, de, end);
  let title: u8[] = [];
  if (ts > de) {
    let te = title_end(s, ts, end);
    if (te > 0) {
      title = __bytes_range(s, ts, te);
      let stop = line_end(s, skip_spaces(s, te, end), end);
      if (stop >= 0) {
        return Def { end: stop, label: normalize(s[i + 1:le - 1]), dest: dest, title: title };
      }
    }
  }
  // When the title is not the end of its line, the definition ends after
  // the destination. As in cmark, it keeps the title.
  let stop = line_end(s, skip_spaces(s, de, end), end);
  if (stop < 0) {
    return no_def();
  }
  return Def { end: stop, label: normalize(s[i + 1:le - 1]), dest: dest, title: title };
}

// The form of a label that two matching labels share: Unicode case folding,
// with each run of whitespace made one space, and no space at either end.
pub function normalize(label: [u8]): string {
  let text = folded_text(label);
  if (is_normal(text)) {
    return text;
  }
  let folded = text.case_fold();
  let b = buf_new(folded.len());
  let gap = false;
  let any = false;
  for i in 0..folded.len() {
    let c = folded[i] as i32;
    if (is_space(c)) {
      gap = any;
    } else {
      if (gap) {
        buf_push_byte(b, 32);
        gap = false;
      }
      buf_push_byte(b, c);
      any = true;
    }
  }
  let out = buf_take(b);
  buf_free(b);
  return out;
}

// The label as the case folding of cmark reads it: each byte where no valid
// UTF-8 sequence starts is U+FFFD.
function folded_text(label: [u8]): string {
  let n = label.len();
  let b = buf_new(n);
  let i = 0;
  while (i < n) {
    let len = 1;
    if (label[i] >= 0x80 as u8) {
      len = utf8.length(label, i, n);
    }
    if (len < 0) {
      buf_push(b, "�");
      i += 1;
    } else {
      for k in i..i + len {
        buf_push_byte(b, label[k] as i32);
      }
      i += len;
    }
  }
  let out = buf_take(b);
  buf_free(b);
  return out;
}

// True when `normalize` gives the label as it is: ASCII with no capital
// letter, and one space between two words.
function is_normal(label: string): boolean {
  let n = label.len();
  if (n == 0 || label[0] == b' ' || label[n - 1] == b' ') {
    return false;
  }
  for i in 0..n {
    let c = label[i] as i32;
    if (c == 32 && label[i - 1] == b' ' || c != 32 && !keeps(c)) {
      return false;
    }
  }
  return true;
}

// True for a printable ASCII byte that is not a capital letter.
function keeps(c: i32): boolean {
  return c > 32 && c < 127 && (c < 65 || c > 90);
}

// Adds each definition at the start of `s[from:end]` to `refs`. The first
// definition of a label wins. Gives the index after the last definition.
pub function take_defs(s: u8[], from: i32, end: i32, refs: Map[string, Ref]): (i32, Map[string, Ref]) {
  let i = from;
  let out = refs;
  while (byte(s, i, end) == 91) {
    let d = parse_def(s, i, end);
    if (d.end < 0) {
      break;
    }
    if (!out.contains(d.label)) {
      out = out.insert(d.label, Ref { dest: d.dest, title: d.title });
    }
    i = d.end;
  }
  return (i, out);
}
