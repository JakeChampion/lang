// Pipe tables use byte ranges into the block parser's source lines.
import "std/i32";
import "std/markdown/blocks";
import "std/markdown/inlines";
import "std/markdown/tags";

function space(c: u8): boolean {
  return c == b' ' || c == b'\t';
}

function trim(s: u8[], a: i32, e: i32): (i32, i32) {
  while (a < e && space(s[a])) {
    a += 1;
  }
  while (e > a && space(s[e - 1])) {
    e -= 1;
  }
  return (a, e);
}

// Adjacent entries hold the start and end of each cell before whitespace trimming.
function cells(s: u8[], a: i32, e: i32): i32[] {
  let spans: i32[] = [];
  let (start, limit) = trim(s, a, e);
  a = start;
  if (a < limit && s[a] == b'|') {
    a += 1;
  }
  while (a < limit) {
    let end = a;
    while (end < limit && (s[end] != b'|' || end > a && s[end - 1] == 92 as u8)) {
      end += 1;
    }
    let last = end;
    if (end == limit) {
      last = e;
    }
    spans = spans.append(a).append(last);
    a = end + 1;
  }
  return spans;
}

function line(d: blocks.Doc, seg: i32): i32[] {
  let part = d.segs[seg];
  return cells(d.src, blocks.seg_start(part), blocks.seg_end(part));
}

// -1 means this cell cannot be part of a delimiter row.
function alignment(s: u8[], a: i32, e: i32): i32 {
  let flags = 0;
  if (a < e && s[a] == b':') {
    flags = 1;
    a += 1;
  }
  if (a < e && s[e - 1] == b':') {
    flags += 2;
    e -= 1;
  }
  if (a == e) {
    return -1;
  }
  for k in a..e {
    if (s[k] != b'-') {
      return -1;
    }
  }
  return flags;
}

pub function columns(d: blocks.Doc, from: i32): i32[] {
  let result: i32[] = [];
  let seg = d.segs[from + 1];
  let start = blocks.seg_start(seg);
  if (start >= blocks.seg_end(seg)) {
    return result;
  }
  let c = d.src[start];
  if (c != b'|' && c != b':' && c != b'-' && !space(c)) {
    return result;
  }
  let delimiter = line(d, from + 1);
  if (delimiter.len() > 131070 || delimiter.len() != line(d, from).len()) {
    return result;
  }
  for col in 0..delimiter.len() / 2 {
    let (a, e) = trim(d.src, delimiter[2 * col], delimiter[2 * col + 1]);
    let align = alignment(d.src, a, e);
    if (align < 0) {
      return [];
    }
    result = result.append(align);
  }
  return result;
}

const ALIGN: string[] = ["", " align=\"left\"", " align=\"right\"", " align=\"center\""];

// The table grammar removes a backslash before a pipe even inside code spans.
function cell(out: usize, d: blocks.Doc, a: i32, e: i32, w: inlines.Work): inlines.Work {
  let from = a;
  let buf = 0 as usize;
  for k in a..e {
    if (d.src[k] == b'|' && k > a && d.src[k - 1] == 92 as u8) {
      if (buf == 0 as usize) {
        buf = buf_new(e - a);
      }
      buf_push_bytes_range(buf, d.src, from, k - 1);
      from = k;
    }
  }
  if (from == a) {
    return inlines.inline(out, d.src, a, e, d, w);
  }
  buf_push_bytes_range(buf, d.src, from, e);
  let text = buf_take_bytes(buf);
  buf_free(buf);
  return inlines.inline(out, text, 0, text.len(), d, w);
}

struct Position { line: i32, column: i32, offset: i32, end: i32 }

// Source columns count bytes. Body cells are relative to the table's start
// column, even when a body row uses different indentation from the header.
function position(d: blocks.Doc, r: i32, k: i32, header: boolean): Position {
  let p = Position { line: 0, column: 0, offset: 0, end: 0 };
  if (d.pos.len() == 0) {
    return p;
  }
  let (sl, sc, el, ec) = d.span_of(r);
  let a = blocks.seg_start(d.segs[k]);
  let e = blocks.seg_end(d.segs[k]);
  if (header) {
    let prefix = 0;
    for i in d.from(r)..k {
      prefix += blocks.seg_end(d.segs[i]) - blocks.seg_start(d.segs[i]) + 1;
    }
    return Position { line: sl, column: sc, offset: sc + prefix - a, end: sc + prefix + e - a - 1 };
  }
  let start = line_start(d.src, a);
  return Position { line: el - (d.to(r) - k - 1), column: sc, offset: sc - a, end: e - start };
}

function sourcepos(out: usize, line: i32, start: i32, end: i32): void {
  if (line > 0) {
    buf_push(out, " data-sourcepos=\"" + line.to_string() + ":" + start.to_string() + "-" + line.to_string() + ":" + end.to_string() + "\"");
  }
}

function row(out: usize, d: blocks.Doc, spans: i32[], cols: i32[], tag: string, pos: Position, w: inlines.Work): inlines.Work {
  buf_push(out, "<tr");
  sourcepos(out, pos.line, pos.column, pos.end);
  buf_push(out, ">\n");
  for i in 0..cols.len() {
    buf_push(out, "<" + tag + ALIGN[cols[i]]);
    if (2 * i < spans.len()) {
      let start = spans[2 * i];
      let end = spans[2 * i + 1];
      sourcepos(out, pos.line, pos.offset + start, pos.offset + end - 1);
      buf_push(out, ">");
      let (a, e) = trim(d.src, start, end);
      w = cell(out, d, a, e, w);
    } else {
      sourcepos(out, pos.line, 0, 0);
      buf_push(out, ">");
    }
    buf_push(out, "</" + tag + ">\n");
  }
  buf_push(out, "</tr>\n");
  return w;
}

// A complete HTML tag can interrupt a table even when it cannot interrupt
// a CommonMark paragraph.
pub function html_block(d: blocks.Doc, k: i32): boolean {
  let seg = d.segs[k];
  let a = blocks.seg_start(seg);
  let e = blocks.seg_end(seg);
  return a < e && d.src[a] == b'<' && tags.block_start(d.src, a, e, false) == 7;
}

// Find the last source line before writing the table's opening tag. The
// normal HTML path can emit each row without this lookahead.
pub function limit(d: blocks.Doc, from: i32, to: i32, width: i32): i32 {
  let next = from + 2;
  let padded = 0;
  while (next < to && padded <= 0x80000 && !html_block(d, next)) {
    let count = line(d, next).len() / 2;
    if (count == 0 || count > 65535) {
      break;
    }
    if (count < width) {
      padded += width - count;
    }
    next += 1;
  }
  return next;
}

pub function line_start(src: u8[], a: i32): i32 {
  while (a > 0 && src[a - 1] != 10 as u8 && src[a - 1] != 13 as u8) {
    a -= 1;
  }
  return a;
}

pub function render(out: usize, d: blocks.Doc, r: i32, from: i32, to: i32, cols: i32[], w: inlines.Work): (inlines.Work, i32) {
  buf_push(out, "<thead>\n");
  w = row(out, d, line(d, from), cols, "th", position(d, r, from, true), w);
  buf_push(out, "</thead>\n");
  let next = from + 2;
  let padded = 0;
  while (next < to && padded <= 0x80000 && !html_block(d, next)) {
    let spans = line(d, next);
    if (spans.len() == 0 || spans.len() > 131070) {
      break;
    }
    if (next == from + 2) {
      buf_push(out, "<tbody>\n");
    }
    if (spans.len() / 2 < cols.len()) {
      padded += cols.len() - spans.len() / 2;
    }
    w = row(out, d, spans, cols, "td", position(d, r, next, false), w);
    next += 1;
  }
  if (next > from + 2) {
    buf_push(out, "</tbody>\n");
  }
  buf_push(out, "</table>\n");
  return (w, next);
}
