// std/http/huffman — the Huffman code HTTP header compression shares:
// HPACK's (RFC 7541 Appendix B), which QPACK (RFC 9204 §4.1.2) uses as is.
//
// A string is coded symbol by symbol and padded to a byte with the most
// significant bits of EOS, all ones; a decoder refuses EOS itself, padding
// of eight bits or more, and padding that is not all ones (RFC 7541 §5.2).

// HuffmanError — why a coded string was refused: it is not one, or it
// decodes to more than the room given.
pub enum HuffmanError { InvalidCode, ExceedsRoom }

// encoded_len is the bytes the coding of `bytes` takes.
pub function encoded_len(bytes: [u8]): i32 {
  let bits: i32 = 0;
  for b in bytes {
    bits = bits + HUFF_LEN[b as i32] as i32;
  }
  return (bits + 7) / 8;
}

// encode appends the codes of `bytes` to `out`, padded to a byte.
pub function encode(out: u8[], bytes: [u8]): u8[] {
  let o: u8[] = out;
  let acc: i64 = 0;
  let n: i32 = 0;
  for b in bytes {
    let sym: i32 = b as i32;
    acc = acc << HUFF_LEN[sym] as i32 | HUFF_CODE[sym] as i64;
    n = n + HUFF_LEN[sym] as i32;
    while (n >= 8) {
      n = n - 8;
      o = o.append((acc >> n & 255) as u8);
    }
  }
  if (n > 0) {
    acc = acc << 8 - n | ((1 << 8 - n) - 1) as i64;
    o = o.append((acc & 255) as u8);
  }
  return o;
}

// decode reads a coded string, refusing one that decodes to more than
// `room` bytes as soon as it would. The code is canonical, so a symbol is
// found by its offset from the first code of its length.
pub function decode(coded: [u8], room: i32): Result[u8[], HuffmanError] {
  let out: u8[] = [];
  let code: i32 = 0;
  let len: i32 = 0;
  for b in coded {
    let bit: i32 = 7;
    while (bit >= 0) {
      code = code << 1 | b as i32 >> bit & 1;
      len = len + 1;
      let sym: i32 = __symbol(code, len);
      if (sym == 256) {
        return Err(InvalidCode);
      }
      if (sym >= 0) {
        if (out.len() >= room) {
          return Err(ExceedsRoom);
        }
        out = out.append(sym as u8);
        code = 0;
        len = 0;
      }
      bit = bit - 1;
    }
  }
  // What is left must be EOS's prefix: under eight bits, all ones.
  if (len >= 8 || code != (1 << len) - 1) {
    return Err(InvalidCode);
  }
  return Ok(out);
}

// __symbol is the symbol `code` of `len` bits names, -1 when no code is
// that long yet, and EOS (256) for one too long to be a code.
function __symbol(code: i32, len: i32): i32 {
  if (len > 30) {
    return 256;
  }
  if (DEC_COUNT[len] == 0) {
    return 0 - 1;
  }
  let offset: i32 = code - DEC_FIRST[len];
  if (offset < 0 || offset >= DEC_COUNT[len]) {
    return 0 - 1;
  }
  return DEC_SYMS[DEC_START[len] + offset];
}

