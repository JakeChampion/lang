// std/http/hpack — HPACK, the header compression of HTTP/2 (RFC 7541).
//
// A `Decoder` turns a header block into fields and a `Encoder` turns
// fields into one, each keeping the dynamic table the other side's
// mirrors. Both are values: a step returns the next decoder or encoder
// with its result, so a connection carries one of each and threads it
// through its frames.
//
//   let d: hpack.Decoder = hpack.decoder(4096, 65536);
//   let got: hpack.Decoded = d.decode(block)?;      // got.fields, got.decoder
//   let e: hpack.Encoder = hpack.encoder(4096);
//   let out: hpack.Encoded = e.encode([hpack.field(":status", "200")]);   // out.bytes, out.encoder
//
// The decoder is bounded the way RFC 9113 §10.5 and the header-bomb
// record ask: every field counts name, value and 32 against `max_list`
// as it is decoded, a Huffman string included, so a block that would
// expand past the cap stops before it has, and more than `max_fields`
// fields is refused too. A dynamic table size update is taken only at the
// start of a block and only up to the size the local settings allow. An
// error is the connection's: HTTP/2 answers it with COMPRESSION_ERROR.
//
// The encoder indexes a field that the static or dynamic table holds,
// names one the table holds the name of, adds a literal to the table
// unless it is `sensitive` (never indexed: authorization, cookies, and
// whatever the caller marks), and Huffman-codes a string when that is no
// longer than its bytes. `with_max_table` queues the size update the next block must
// start with, as §4.2 asks after a settings change.

import "core/int";
import "std/array";
import "std/http/huffman";
import "std/string";

// Field — one header field; `sensitive` keeps it out of both tables.
pub struct Field { name: string, value: string, sensitive: boolean }

pub function field(name: string, value: string): Field {
  return Field { name: name, value: value, sensitive: false };
}

// sensitive is a field never indexed: the peer's table never holds it, so
// its value cannot be probed by guessing (§7.1.3).
pub function sensitive(name: string, value: string): Field {
  return Field { name: name, value: value, sensitive: true };
}

pub enum HpackError {
  // The block ended inside a field.
  Truncated,
  // An index of 0, or past the tables.
  BadIndex(i32),
  // An integer of more than 28 bits.
  BadInteger,
  // A Huffman string with a code that is not one, EOS inside it, or
  // padding that is not EOS's prefix of under eight bits.
  BadHuffman,
  // A dynamic table size update above the size the settings allow, or
  // after a field.
  BadSizeUpdate(i32),
  // The fields decoded so far outgrow the list cap.
  TooLarge(i32),
  // More fields than the cap.
  TooMany(i32),
}

pub function (e: HpackError) message(): string {
  match (e) {
    Truncated => {
      return "hpack: header block ends inside a field";
    },
    BadIndex(i) => {
      return "hpack: no table entry " + int.int_to_string(i);
    },
    BadInteger => {
      return "hpack: integer over 28 bits";
    },
    BadHuffman => {
      return "hpack: bad Huffman string";
    },
    BadSizeUpdate(n) => {
      return "hpack: dynamic table size update to " + int.int_to_string(n) + " not allowed here";
    },
    TooLarge(n) => {
      return "hpack: header list over " + int.int_to_string(n) + " bytes";
    },
    TooMany(n) => {
      return "hpack: more than " + int.int_to_string(n) + " header fields";
    }
  }
  return "hpack: error";
}

// === the tables ============================================================

// Table — a dynamic table: entries newest first, the size they take (name,
// value and 32 each, §4.1) and the size they may take.
pub struct Table { names: string[], values: string[], size: i32, max: i32 }

pub function table(max: i32): Table {
  return Table { names: [], values: [], size: 0, max: max };
}

pub function (t: Table) len(): i32 {
  return t.names.len();
}

pub function (t: Table) size(): i32 {
  return t.size;
}

function __entry_size(name: string, value: string): i32 {
  return name.len() + value.len() + 32;
}

// __added is `t` with the entry newest, after evicting the oldest until it
// fits; an entry larger than the table empties it (§4.4).
function __added(t: Table, name: string, value: string): Table {
  let need: i32 = __entry_size(name, value);
  let room: Table = __evicted(t, t.max - need);
  if (need > t.max) {
    return room;
  }
  let names: string[] = [name];
  let values: string[] = [value];
  let i: i32 = 0;
  while (i < room.names.len()) {
    names = names.append(room.names[i]);
    values = values.append(room.values[i]);
    i = i + 1;
  }
  return Table { names: names, values: values, size: room.size + need, max: t.max };
}

// __evicted is `t` with its oldest entries dropped until its size is at
// most `limit`.
function __evicted(t: Table, limit: i32): Table {
  let keep: i32 = t.names.len();
  let size: i32 = t.size;
  while (keep > 0 && size > limit) {
    keep = keep - 1;
    size = size - __entry_size(t.names[keep], t.values[keep]);
  }
  if (keep == t.names.len()) {
    return t;
  }
  let names: string[] = [];
  let values: string[] = [];
  let i: i32 = 0;
  while (i < keep) {
    names = names.append(t.names[i]);
    values = values.append(t.values[i]);
    i = i + 1;
  }
  return Table { names: names, values: values, size: size, max: t.max };
}

// __resized is `t` allowed `max` bytes, evicted down to it.
function __resized(t: Table, max: i32): Table {
  let out: Table = __evicted(t, max);
  return Table { ...out, max: max };
}

const STATIC_LEN: i32 = 61;

// __name_at is the name at `index` (1-based, the static table then the
// dynamic one), empty when there is none.
function __name_at(t: Table, index: i32): string {
  if (index >= 1 && index <= STATIC_LEN) {
    return STATIC_NAMES[index - 1];
  }
  let at: i32 = index - STATIC_LEN - 1;
  if (at >= 0 && at < t.names.len()) {
    return t.names[at];
  }
  return "";
}

function __value_at(t: Table, index: i32): string {
  if (index >= 1 && index <= STATIC_LEN) {
    return STATIC_VALUES[index - 1];
  }
  let at: i32 = index - STATIC_LEN - 1;
  if (at >= 0 && at < t.names.len()) {
    return t.values[at];
  }
  return "";
}

// __find is the index of an entry with this name and value, or negated
// the index of one with the name alone, or 0: the static table is
// searched first, then the dynamic one newest first.
function __find(t: Table, name: string, value: string): i32 {
  let found: i32 = __find_static(name, value);
  if (found > 0) {
    return found;
  }
  let name_only: i32 = 0 - found;
  let i: i32 = 0;
  while (i < t.names.len()) {
    if (t.names[i] == name) {
      if (t.values[i] == value) {
        return STATIC_LEN + 1 + i;
      }
      if (name_only == 0) {
        name_only = STATIC_LEN + 1 + i;
      }
    }
    i = i + 1;
  }
  return 0 - name_only;
}

// __find_static is __find over the static table alone. Only the names as
// long as `name` are compared, and a name's entries are adjacent, so its
// values are the ones after the first.
function __find_static(name: string, value: string): i32 {
  let n: i32 = name.len();
  if (n + 1 >= STATIC_LENGTH_FROM.len()) {
    return 0;
  }
  let k: i32 = STATIC_LENGTH_FROM[n];
  while (k < STATIC_LENGTH_FROM[n + 1]) {
    let i: i32 = STATIC_BY_LENGTH[k];
    if (STATIC_NAMES[i] == name) {
      let first: i32 = i;
      while (i < STATIC_LEN && STATIC_NAMES[i] == name) {
        if (STATIC_VALUES[i] == value) {
          return i + 1;
        }
        i = i + 1;
      }
      return 0 - (first + 1);
    }
    k = k + 1;
  }
  return 0;
}

// === decoding ==============================================================

// Decoder — the dynamic table the peer's encoder fills, the size the
// local settings let it have, and the caps on what one block may decode
// to.
pub struct Decoder { table: Table, settings_max: i32, max_list: i32, max_fields: i32 }

// decoder(max_table, max_list) — a decoder whose table may grow to
// `max_table` (SETTINGS_HEADER_TABLE_SIZE, 4096 by default) and whose
// blocks may decode to `max_list` bytes of fields, counted as
// SETTINGS_MAX_HEADER_LIST_SIZE counts them, and at most 256 fields.
pub function decoder(max_table: i32, max_list: i32): Decoder {
  return Decoder { table: table(max_table), settings_max: max_table, max_list: max_list, max_fields: 256 };
}

pub function (d: Decoder) with_max_fields(n: i32): Decoder {
  return Decoder { ...d, max_fields: n };
}

// with_max_table is the decoder after the local settings changed the size
// the peer's table may have: the peer's next block must start with an
// update to at most this.
pub function (d: Decoder) with_max_table(n: i32): Decoder {
  let t: Table = d.table;
  if (n < t.max) {
    t = __resized(t, n);
  }
  return Decoder { ...d, table: t, settings_max: n };
}

pub function (d: Decoder) table_size(): i32 {
  return d.table.size;
}

// Decoded — the fields a block held, and the decoder after it.
pub struct Decoded { decoder: Decoder, fields: Field[] }

// decode takes one whole header block (every CONTINUATION joined).
pub function (d: Decoder) decode(block: u8[]): Result[Decoded, HpackError] {
  let st: __Dec = __Dec { table: d.table, at: 0, fields: [], total: 0, started: false, value: 0, text: "", touched: false };
  while (st.at < block.len()) {
    st = __field(d, st, block)?;
  }
  if (!st.touched) {
    return Ok(Decoded { decoder: d, fields: st.fields });
  }
  return Ok(Decoded { decoder: Decoder { ...d, table: st.table }, fields: st.fields });
}

// __Dec — a decode in progress: the table, the offset, the fields so far,
// their size, whether a field has come (after which no size update may),
// the last integer and string read, so a read hands back the decode and
// nothing else, and whether the table has changed, so a block that leaves
// it alone hands the decoder back as it was.
struct __Dec { table: Table, at: i32, fields: Field[], total: i32, started: boolean, value: i32, text: string, touched: boolean }

// __field reads one representation (§6): by its first bits, an indexed
// field, a literal added to the table, a size update, or a literal that
// is not added, never indexed when the fourth bit is set.
function __field(d: Decoder, st: __Dec, block: u8[]): Result[__Dec, HpackError] {
  let b: i32 = block[st.at] as i32;
  if (b >= 128) {
    return __indexed(d, st, block);
  }
  if (b >= 64) {
    return __literal(d, st, block, 6, true, false);
  }
  if (b >= 32) {
    return __size_update(d, st, block);
  }
  return __literal(d, st, block, 4, false, b >= 16);
}

function __indexed(d: Decoder, st: __Dec, block: u8[]): Result[__Dec, HpackError] {
  st = __integer(st, block, 7)?;
  let index: i32 = st.value;
  if (index == 0 || __name_at(st.table, index).len() == 0 && index > STATIC_LEN) {
    return Err(BadIndex(index));
  }
  return __taken(d, st, Field { name: __name_at(st.table, index), value: __value_at(st.table, index), sensitive: false }, false);
}

// __size_update takes a dynamic table size update, allowed only before
// the block's fields and only up to the settings.
function __size_update(d: Decoder, st: __Dec, block: u8[]): Result[__Dec, HpackError] {
  if (st.started) {
    return Err(BadSizeUpdate(0 - 1));
  }
  st = __integer(st, block, 5)?;
  if (st.value > d.settings_max) {
    return Err(BadSizeUpdate(st.value));
  }
  let size: i32 = st.value;
  return Ok(__Dec { ...st, table: __resized(st.table, size), touched: true });
}

// __literal reads a literal field whose name is indexed by `prefix` bits
// or follows as a string, then its value, and keeps the field, added to
// the table when `index`.
function __literal(d: Decoder, st: __Dec, block: u8[], prefix: i32, index: boolean, sensitive: boolean): Result[__Dec, HpackError] {
  st = __integer(st, block, prefix)?;
  let name: string = "";
  if (st.value > 0) {
    name = __name_at(st.table, st.value);
    if (name.len() == 0 && st.value > STATIC_LEN) {
      return Err(BadIndex(st.value));
    }
  } else {
    st = __string(d, st, block)?;
    name = st.text;
  }
  let total: i32 = st.total;
  st = __string(d, __Dec { ...st, total: total + name.len() }, block)?;
  let value: string = st.text;
  return __taken(d, __Dec { ...st, total: total }, Field { name: name, value: value, sensitive: sensitive }, index);
}

// __taken counts a field against the caps and keeps it, adding it to the
// table when the representation asks.
function __taken(d: Decoder, st: __Dec, f: Field, index: boolean): Result[__Dec, HpackError] {
  let total: i32 = st.total + __entry_size(f.name, f.value);
  if (total > d.max_list) {
    return Err(TooLarge(d.max_list));
  }
  if (st.fields.len() >= d.max_fields) {
    return Err(TooMany(d.max_fields));
  }
  if (index) {
    let t: Table = st.table;
    return Ok(__Dec { ...st, table: __added(t, f.name, f.value), fields: st.fields.append(f), total: total, started: true, touched: true });
  }
  return Ok(__Dec { ...st, fields: st.fields.append(f), total: total, started: true });
}

// __integer reads an integer with an N-bit prefix (§5.1) at the decode's
// offset into its `value`, the offset moved past it.
function __integer(st: __Dec, block: u8[], prefix: i32): Result[__Dec, HpackError] {
  let at: i32 = st.at;
  if (at >= block.len()) {
    return Err(Truncated);
  }
  let limit: i32 = (1 << prefix) - 1;
  let value: i32 = block[at] as i32 & limit;
  let i: i32 = at + 1;
  if (value < limit) {
    return Ok(__Dec { ...st, value: value, at: i });
  }
  let shift: i32 = 0;
  while (true) {
    if (i >= block.len()) {
      return Err(Truncated);
    }
    let b: i32 = block[i] as i32;
    i = i + 1;
    if (shift > 21) {
      return Err(BadInteger);
    }
    value = value + ((b & 127) << shift);
    if (value < 0) {
      return Err(BadInteger);
    }
    shift = shift + 7;
    if (b < 128) {
      return Ok(__Dec { ...st, value: value, at: i });
    }
  }
  return Err(BadInteger);
}

// __string reads a string literal (§5.2) at the decode's offset into its
// `text`, Huffman-decoded when its first bit says, within the room the
// list size leaves.
function __string(d: Decoder, st: __Dec, block: u8[]): Result[__Dec, HpackError] {
  if (st.at >= block.len()) {
    return Err(Truncated);
  }
  let huffman: boolean = block[st.at] as i32 >= 128;
  st = __integer(st, block, 7)?;
  let n: i32 = st.value;
  let from: i32 = st.at;
  if (n > block.len() - from) {
    return Err(Truncated);
  }
  let room: i32 = d.max_list - st.total - 32;
  if (!huffman) {
    if (n > room) {
      return Err(TooLarge(d.max_list));
    }
    return Ok(__Dec { ...st, text: string_from_bytes_range_unchecked(block, from, from + n), at: from + n });
  }
  match (huffman.decode(block[from:from + n], room)) {
    Ok(out) => {
      return Ok(__Dec { ...st, text: string_from_bytes_unchecked(out), at: from + n });
    },
    Err(huffman.ExceedsRoom()) => {
      return Err(TooLarge(d.max_list));
    },
    Err(_) => {
      return Err(BadHuffman);
    }
  }
}

// === encoding ==============================================================

// Encoder — the dynamic table the peer's decoder mirrors, a size update
// the next block must start with (negative for none), and whether strings
// are Huffman-coded when that is shorter.
pub struct Encoder { table: Table, update: i32, huffman: boolean }

// encoder(max_table) — a table of `max_table` bytes, the peer's
// SETTINGS_HEADER_TABLE_SIZE (4096 before it says).
pub function encoder(max_table: i32): Encoder {
  return Encoder { table: table(max_table), update: 0 - 1, huffman: true };
}

// with_max_table is the encoder after the peer's settings changed its
// table size: the table is held to `n` now and the next block announces it
// (§4.2), whatever the previous size.
pub function (e: Encoder) with_max_table(n: i32): Encoder {
  return Encoder { ...e, table: __resized(e.table, n), update: n };
}

// without_huffman writes every string as its bytes.
pub function (e: Encoder) without_huffman(): Encoder {
  return Encoder { ...e, huffman: false };
}

pub function (e: Encoder) table_size(): i32 {
  return e.table.size;
}

// Encoded — a header block, and the encoder after it.
pub struct Encoded { encoder: Encoder, bytes: u8[] }

// encode is `fields` as one header block.
pub function (e: Encoder) encode(fields: Field[]): Encoded {
  let en: Encoding = e.begin();
  for f in fields {
    en = en.put(f.name, f.value, f.sensitive);
  }
  return en.finish();
}

// Encoding — a header block being written field by field: the encoder as
// its table grows, and the bytes so far.
pub struct Encoding { encoder: Encoder, out: u8[] }

// `(e).begin()` — a header block started: the size update the encoder
// owes, if any, goes first.
pub function (e: Encoder) begin(): Encoding {
  if (e.update < 0) {
    return Encoding { encoder: e, out: [] };
  }
  return Encoding { encoder: Encoder { ...e, update: 0 - 1 }, out: __put_integer([], 32, 5, e.update) };
}

// `(en).put(name, value, sensitive)` — one field written as `encode`
// writes it: indexed when the table has it, a literal added to the table
// otherwise, and never indexed when `sensitive`.
pub function (en: Encoding) put(name: string, value: string, sensitive: boolean): Encoding {
  let e: Encoder = en.encoder;
  let out: u8[] = en.out;
  let found: i32 = __find(e.table, name, value);
  if (found > 0 && !sensitive) {
    return Encoding { encoder: e, out: __put_integer(out, 128, 7, found) };
  }
  if (sensitive) {
    out = __put_integer(out, 16, 4, __abs(found));
    return Encoding { encoder: e, out: __put_name_value(out, e, name, value, found) };
  }
  out = __put_integer(out, 64, 6, __abs(found));
  out = __put_name_value(out, e, name, value, found);
  return Encoding { encoder: Encoder { ...e, table: __added(e.table, name, value) }, out: out };
}

// `(en).finish()` — the block's bytes and the encoder to carry on with.
pub function (en: Encoding) finish(): Encoded {
  return Encoded { encoder: en.encoder, bytes: en.out };
}

function __abs(n: i32): i32 {
  if (n < 0) {
    return 0 - n;
  }
  return n;
}

// __put_name_value writes the name when the table did not have it, then
// the value.
function __put_name_value(out: u8[], e: Encoder, name: string, value: string, found: i32): u8[] {
  let o: u8[] = out;
  if (found == 0) {
    o = __put_string(o, e, name);
  }
  return __put_string(o, e, value);
}

// __put_integer writes `value` with `prefix` bits after the `pattern`
// bits of the first byte (§5.1).
function __put_integer(out: u8[], pattern: i32, prefix: i32, value: i32): u8[] {
  let limit: i32 = (1 << prefix) - 1;
  if (value < limit) {
    return out.append((pattern | value) as u8);
  }
  let o: u8[] = out.append((pattern | limit) as u8);
  let rest: i32 = value - limit;
  while (rest >= 128) {
    o = o.append((rest & 127 | 128) as u8);
    rest = rest >> 7;
  }
  return o.append(rest as u8);
}

// __put_string writes a string literal, Huffman-coded when the encoder
// codes strings and the coding is no longer than the bytes.
function __put_string(out: u8[], e: Encoder, s: string): u8[] {
  let bytes: u8[] = s.bytes();
  if (e.huffman) {
    let coded: i32 = huffman.encoded_len(bytes);
    if (coded <= bytes.len()) {
      return huffman.encode(__put_integer(out, 128, 7, coded), bytes);
    }
  }
  let o: u8[] = __put_integer(out, 0, 7, bytes.len());
  return o.concat(bytes);
}

// === RFC 7541's tables =====================================================
//
// Appendix A's static table is STATIC_NAMES and STATIC_VALUES, entry 1
// first.

const STATIC_NAMES: string[] = [
  ":authority", ":method", ":method", ":path",
  ":path", ":scheme", ":scheme", ":status",
  ":status", ":status", ":status", ":status",
  ":status", ":status", "accept-charset", "accept-encoding",
  "accept-language", "accept-ranges", "accept", "access-control-allow-origin",
  "age", "allow", "authorization", "cache-control",
  "content-disposition", "content-encoding", "content-language", "content-length",
  "content-location", "content-range", "content-type", "cookie",
  "date", "etag", "expect", "expires",
  "from", "host", "if-match", "if-modified-since",
  "if-none-match", "if-range", "if-unmodified-since", "last-modified",
  "link", "location", "max-forwards", "proxy-authenticate",
  "proxy-authorization", "range", "referer", "refresh",
  "retry-after", "server", "set-cookie", "strict-transport-security",
  "transfer-encoding", "user-agent", "vary", "via",
  "www-authenticate",
];

// The first index of each distinct static name, shortest names first, and
// where the names of each length start among them: those of length n are
// STATIC_BY_LENGTH[STATIC_LENGTH_FROM[n]] up to STATIC_LENGTH_FROM[n + 1].
const STATIC_BY_LENGTH: i32[] = [
  20, 59, 32, 33, 36, 37, 44, 58, 3, 21, 49, 18, 31, 34, 53, 1, 5, 7, 35, 50, 51, 38, 41, 45, 0, 54,
  57, 52, 30, 46, 17, 22, 23, 29, 40, 43, 14, 27, 15, 16, 25, 26, 28, 60, 39, 56, 47, 24, 42, 48, 55, 19,
];

const STATIC_LENGTH_FROM: i32[] = [
  0, 0, 0, 0, 2, 8, 11, 15, 21, 24, 24, 27, 28, 30, 36, 38, 40, 44, 46, 47, 50, 50, 50, 50, 50, 50,
  51, 51, 52,
];

const STATIC_VALUES: string[] = [
  "", "GET", "POST", "/",
  "/index.html", "http", "https", "200",
  "204", "206", "304", "400",
  "404", "500", "", "gzip, deflate",
  "", "", "", "",
  "", "", "", "",
  "", "", "", "",
  "", "", "", "",
  "", "", "", "",
  "", "", "", "",
  "", "", "", "",
  "", "", "", "",
  "", "", "", "",
  "", "", "", "",
  "", "", "", "",
  "",
];
