// std/http/h2 — an HTTP/2 connection (RFC 9113), the server's side, as a
// sans-IO state machine: bytes in, bytes out, requests as events, and a
// response given back for each stream.
//
//   let step: h2.Step = h2.server(h2.config());        // step.output: the server's SETTINGS
//   step = step.conn.read(received);                    // step.events: Request(stream, req), ...
//   step = step.conn.respond(stream, resp);             // step.output: HEADERS, DATA, ...
//
// A connection holds the streams the client opened, each with its request
// as it is assembled from HEADERS, CONTINUATION and DATA frames, both
// flow-control windows at both levels, the settings each side sent, and
// one HPACK decoder and encoder. A request is handed over whole once its
// stream's END_STREAM arrives, with its trailers; a response is written as
// HEADERS (and CONTINUATION, past the peer's frame size), DATA as the
// windows allow, the rest held until a WINDOW_UPDATE, and trailers last.
//
// The bounds RFC 9113 §10 and the attack record ask for are held here:
//   - a handler runs for a stream only while the stream counts against
//     max_concurrent_streams, and a stream the client resets keeps counting
//     until the handler answers (`respond` or `reset`), so a reset does not
//     free a slot (Rapid Reset); a stream past the limit is refused;
//   - a header block is bounded in frames and bytes as it is assembled,
//     and the HPACK decoder bounds what it decodes to, so a CONTINUATION
//     flood or a header bomb closes the connection before the memory goes;
//   - every RST_STREAM, the client's and the server's own, counts against
//     one reset budget per span of frames (MadeYouReset), and empty DATA
//     frames against another; past either the connection is closed with
//     ENHANCE_YOUR_CALM.
// A connection error is answered with GOAWAY and reported as `Closed`; a
// stream error with RST_STREAM. Priorities are read and ignored (§5.3).
// Push is not offered, and a PUSH_PROMISE from the client is an error.

import "core/int";
import "std/array";
import "std/string";
import "std/http";
import "std/headers";
import "std/http/hpack";
import "std/http/h2/frame";

// Config — what the server allows and advertises.
pub struct Config {
  // Streams whose handler may run at once; the rest are refused.
  max_concurrent_streams: i32,
  // The receive window each stream starts with, and the connection's.
  initial_window: i32,
  // The largest frame the server reads.
  max_frame_size: i32,
  // The most a header block may decode to, name, value and 32 per field.
  max_header_list: i32,
  // The dynamic table the client's encoder may use.
  header_table_size: i32,
  // The most body bytes one request may carry.
  max_body: i32,
  // Resets either side sends, and empty DATA frames, allowed per
  // `budget_frames` frames received.
  reset_budget: i32,
  empty_data_budget: i32,
  budget_frames: i32,
  // The most frames one header block may span.
  header_frames_max: i32,
  // Whether a request is handed over as soon as its header block is
  // complete (`Streamed`), its body following as `StreamData` events and
  // its end as `StreamEnd`, with the windows replenished as the handler
  // consumes (`consumed`); off, a request is handed over whole at its
  // END_STREAM.
  stream_bodies: boolean,
}

pub function config(): Config {
  return Config { max_concurrent_streams: 100, initial_window: 65535, max_frame_size: frame.MIN_FRAME_SIZE, max_header_list: 65536, header_table_size: 4096, max_body: http.http_limits().body, reset_budget: 1000, empty_data_budget: 1000, budget_frames: 10000, header_frames_max: 32, stream_bodies: false };
}

// Event — what a step reports.
pub enum Event {
  // A whole request on a stream: answer it with `respond(stream, resp)`.
  Request(i32, HttpRequest),
  // A request handed over at its header block (`Config.stream_bodies`),
  // its body still to come as `StreamData` and `StreamEnd`; answer it
  // with `respond`, or with `respond_head`, `write` and `end`.
  Streamed(i32, HttpRequest),
  // Body bytes of a streamed request; `consumed(stream, n)` once taken,
  // so the client's windows are replenished.
  StreamData(i32, u8[]),
  // The end of a streamed request's body, with its trailers.
  StreamEnd(i32, HeaderMap),
  // The client reset a stream with this code. Its handler, if one runs,
  // still answers with `respond` or `reset`, which frees its slot.
  Reset(i32, i32),
  // The client's GOAWAY: no new streams will come; the open ones finish.
  GoAway(i32),
  // The server closed the connection with this error code, after GOAWAY;
  // the reason is for the log.
  Closed(i32, string),
  // On a client connection: the response to the request this client sent
  // on the stream, whole, its trailers in `resp.trailers`.
  Answered(i32, HttpResponse),
}

// Step — the connection after a call, the bytes to send and what happened.
pub struct Step { conn: Conn, output: u8[], events: Event[] }

const OPEN: i32 = 0;

// The client has sent END_STREAM; the response is owed.
const HALF_REMOTE: i32 = 1;

// The response is sent; the client's END_STREAM is awaited.
const HALF_LOCAL: i32 = 2;

// __Stream — one stream and its request as it is assembled, its windows,
// and the response bytes still owed to it.
struct __Stream {
  id: i32,
  state: i32,
  send_window: i32,
  recv_window: i32,
  method: string,
  scheme: string,
  authority: string,
  path: string,
  fields: HeaderMap,
  body: u8[],
  length: i32,
  // Whether the request has been handed over and its handler counts.
  handling: boolean,
  // Whether the client reset it while its handler ran.
  reset: boolean,
  pending: u8[],
  trailers: HeaderMap,
  owes_end: boolean,
  // Whether the request was handed over at its header block, its body
  // reported as it comes (`received` counts it against content-length),
  // and whether the response's body is being written in parts.
  streaming: boolean,
  // Which pseudo-headers the header block carried: 1 :method, 2 :scheme,
  // 4 :path, 8 :authority.
  seen: i32,
  received: i32,
  producing: boolean,
  // On a client connection: the response's status once its head has come.
  status: i32,
}

const AWAITING_PREFACE: i32 = 0;

const AWAITING_SETTINGS: i32 = 1;

const RUNNING: i32 = 2;

const CLOSED: i32 = 3;

// Conn — the connection.
pub struct Conn {
  config: Config,
  phase: i32,
  // Bytes read and not yet framed, the next frame at `inbox_at`. Within one
  // `read` the frames are taken by moving inbox_at; a frame that ends the
  // inbox empties it, and what is left over is copied out once at the
  // read's end, so it is 0 between calls and the caller has its buffer
  // back.
  inbox: u8[],
  inbox_at: i32,
  decoder: hpack.Decoder,
  encoder: hpack.Encoder,
  peer_max_frame: i32,
  peer_initial_window: i32,
  settings_acked: boolean,
  send_window: i32,
  recv_window: i32,
  streams: __Stream[],
  last_stream: i32,
  handling: i32,
  // A header block being assembled: its stream (0 for none), the bytes so
  // far, whether END_STREAM came with it, and the frames it has spanned.
  block_stream: i32,
  block: u8[],
  block_end: boolean,
  block_frames: i32,
  // The budgets' counters and the frames since they were last reset.
  resets: i32,
  empty_data: i32,
  frames: i32,
  peer_going_away: boolean,
  // Whether this side opened the connection (`client`), and the stream it
  // opens next, odd for a client (§5.1.1).
  client: boolean,
  next_stream: i32,
}

// server is a new connection and the SETTINGS it opens with (§3.4).
pub function server(cfg: Config): Step {
  return __opened(cfg, false);
}

// client is a new connection from the client's side: the connection
// preface and the SETTINGS it opens with (§3.4), the server's SETTINGS
// expected first. `request` opens a stream on it; the response comes back
// as `Answered`. The connection sets ENABLE_PUSH to 0, so a PUSH_PROMISE
// closes it.
pub function client(cfg: Config): Step {
  let start: Step = __opened(cfg, true);
  return Step { ...start, output: frame.preface().concat(start.output) };
}

// __opened is a new connection for either side and the SETTINGS it sends.
function __opened(cfg: Config, client: boolean): Step {
  let phase: i32 = AWAITING_PREFACE;
  if (client) {
    phase = AWAITING_SETTINGS;
  }
  let c: Conn = Conn { config: cfg, phase: phase, inbox: [], inbox_at: 0, decoder: hpack.decoder(cfg.header_table_size, cfg.max_header_list), encoder: hpack.encoder(4096), peer_max_frame: frame.MIN_FRAME_SIZE, peer_initial_window: 65535, settings_acked: false, send_window: 65535, recv_window: 65535, streams: [], last_stream: 0, handling: 0, block_stream: 0, block: [], block_end: false, block_frames: 0, resets: 0, empty_data: 0, frames: 0, peer_going_away: false, client: client, next_stream: 1 };
  let settings: frame.Setting[] = [frame.Setting { id: frame.SETTINGS_HEADER_TABLE_SIZE, value: cfg.header_table_size }, frame.Setting { id: frame.SETTINGS_ENABLE_PUSH, value: 0 }, frame.Setting { id: frame.SETTINGS_MAX_CONCURRENT_STREAMS, value: cfg.max_concurrent_streams }, frame.Setting { id: frame.SETTINGS_INITIAL_WINDOW_SIZE, value: cfg.initial_window }, frame.Setting { id: frame.SETTINGS_MAX_FRAME_SIZE, value: cfg.max_frame_size }, frame.Setting { id: frame.SETTINGS_MAX_HEADER_LIST_SIZE, value: cfg.max_header_list }];
  let out: u8[] = frame.encode(frame.Settings(false, settings));
  if (cfg.initial_window > 65535) {
    out = out.concat(frame.encode(frame.WindowUpdate(0, cfg.initial_window - 65535)));
    return Step { conn: Conn { ...c, recv_window: cfg.initial_window }, output: out, events: [] };
  }
  return Step { conn: c, output: out, events: [] };
}

// Outgoing — a request a client sends: the method, scheme, authority and
// path that become the pseudo-header fields, the fields (`host` and the
// connection-specific ones left out, the rest lowered), the whole body
// and the trailers sent after it.
pub struct Outgoing { method: string, scheme: string, authority: string, path: string, headers: HeaderMap, body: u8[], trailers: HeaderMap }

// request opens a stream for `out` on a client connection: HEADERS with
// the pseudo-header fields first, the body as DATA under the windows and
// the trailers after it; the stream's id is answered beside the step,
// -1 when the connection is closed or going away and takes no more.
pub function (c: Conn) request(out: Outgoing): (Step, i32) {
  if (c.phase == CLOSED || c.peer_going_away || !c.client) {
    return (Step { conn: c, output: [], events: [] }, 0 - 1);
  }
  let stream: i32 = c.next_stream;
  let enc: hpack.Encoded = __request_block(c.encoder, out);
  let last: boolean = out.body.len() == 0 && out.trailers.len() == 0;
  let state: i32 = OPEN;
  if (last) {
    state = HALF_LOCAL;
  }
  let s: __Stream = __Stream { id: stream, state: state, send_window: c.peer_initial_window, recv_window: c.config.initial_window, method: out.method, scheme: out.scheme, authority: out.authority, path: out.path, fields: headers.header_map_new(), body: [], length: 0 - 1, handling: false, reset: false, pending: out.body, trailers: out.trailers, owes_end: !last, streaming: false, received: 0, producing: false, status: 0, seen: 0 };
  c = Conn { ...c, encoder: enc.encoder, streams: c.streams.append(s), last_stream: stream, next_stream: stream + 2 };
  let r: __Run = __header_frames(__run(c), stream, enc.bytes, last);
  if (!last) {
    r = __flushed(r);
  }
  return (__step(r), stream);
}

// __request_block is a request's header block: the pseudo-header fields,
// then the fields with `host` and the connection-specific ones left out,
// and a content-length for a body that has none.
function __request_block(e: hpack.Encoder, out: Outgoing): hpack.Encoded {
  let en: hpack.Encoding = e.begin().put(":method", out.method, false).put(":scheme", out.scheme, false).put(":authority", out.authority, false).put(":path", out.path, false);
  let has_length: boolean = false;
  let i: i32 = 0;
  while (i < out.headers.names.len()) {
    let name: string = __lowered(out.headers.names[i]);
    if (name == "content-length") {
      has_length = true;
    }
    if (!__connection_specific(name) && name != "host") {
      en = en.put(name, out.headers.values[i], __sensitive(name));
    }
    i = i + 1;
  }
  if (!has_length && out.body.len() > 0) {
    en = en.put("content-length", int.int_to_string(out.body.len()), false);
  }
  return en.finish();
}

// going_away is whether the peer sent GOAWAY: the open streams finish,
// no new one may be opened.
pub function (c: Conn) going_away(): boolean {
  return c.peer_going_away;
}

// preface is what a client sends first (§3.4), by which a loop knows a
// connection is HTTP/2's.
pub function preface(): u8[] {
  return frame.preface();
}

pub function (c: Conn) closed(): boolean {
  return c.phase == CLOSED;
}

// handling is how many streams' handlers count against the limit.
pub function (c: Conn) handling(): i32 {
  return c.handling;
}

pub function (c: Conn) streams_open(): i32 {
  return c.streams.len();
}

// settings_acked is whether the peer acknowledged this side's SETTINGS.
// Nothing times the acknowledgement out (RFC 9113 §6.5.3 leaves that
// optional); the suites read it to see a handshake through.
pub function (c: Conn) settings_acked(): boolean {
  return c.settings_acked;
}

// __Run — a read in progress: the connection, the bytes gathered to send
// and the events so far.
struct __Run { conn: Conn, out: u8[], events: Event[] }

function __run(c: Conn): __Run {
  return __Run { conn: c, out: [], events: [] };
}

function __step(r: __Run): Step {
  return Step { conn: r.conn, output: r.out, events: r.events };
}

function __send(r: __Run, f: frame.Frame): __Run {
  return __send_bytes(r, frame.encode(f));
}

// __send_bytes queues a frame already on the wire.
function __send_bytes(r: __Run, bytes: u8[]): __Run {
  return __Run { ...r, out: __joined(r.out, bytes) };
}

// __joined(a, b) — the bytes of `a` then `b`, either one as it is when the
// other is empty.
function __joined(a: u8[], b: u8[]): u8[] {
  if (a.len() == 0) {
    return b;
  }
  if (b.len() == 0) {
    return a;
  }
  return a.concat(b);
}

// === reading ===============================================================

// read takes bytes from the client: the frames they complete are acted
// on, and what is left is kept for the next call in bytes of the
// connection's own, so `bytes` is the caller's to reuse once the call
// returns. Nothing is read after a close.
pub function (c: Conn) read(bytes: u8[]): Step {
  if (c.phase == CLOSED) {
    return Step { conn: c, output: [], events: [] };
  }
  let held: boolean = c.inbox.len() > 0;
  let r: __Run = __run(Conn { ...c, inbox: __joined(c.inbox, bytes) });
  if (r.conn.phase == AWAITING_PREFACE) {
    r = __preface(r);
  }
  while (r.conn.phase == AWAITING_SETTINGS || r.conn.phase == RUNNING) {
    let before: i32 = r.conn.inbox.len() - r.conn.inbox_at;
    r = __next_frame(r);
    if (r.conn.inbox.len() - r.conn.inbox_at == before) {
      break;
    }
  }
  // Joined onto bytes already held, the inbox is the connection's own;
  // otherwise it is `bytes` itself, and what is left of it is copied out.
  if (r.conn.inbox_at > 0 || !held && r.conn.inbox.len() > 0) {
    let out: u8[] = r.out;
    let events: Event[] = r.events;
    let conn: Conn = r.conn;
    r = __Run { conn: Conn { ...conn, inbox: __rest(conn.inbox, conn.inbox_at), inbox_at: 0 }, out: out, events: events };
  }
  return __step(r);
}

// __preface checks the 24 bytes a client opens with (§3.4), once they
// are all here.
function __preface(r: __Run): __Run {
  let want: u8[] = frame.preface();
  let have: u8[] = r.conn.inbox;
  let n: i32 = have.len();
  if (n > want.len()) {
    n = want.len();
  }
  let i: i32 = 0;
  while (i < n) {
    if (have[i] != want[i]) {
      return __fail(r, frame.PROTOCOL_ERROR, "not the HTTP/2 connection preface");
    }
    i = i + 1;
  }
  if (have.len() < want.len()) {
    return r;
  }
  return __Run { ...r, conn: Conn { ...r.conn, phase: AWAITING_SETTINGS, inbox_at: want.len() } };
}

// __next_frame takes one frame off the inbox and acts on it; with no
// whole frame there, the inbox is left as it is.
function __next_frame(r: __Run): __Run {
  match (frame.read(r.conn.inbox, r.conn.inbox_at, r.conn.config.max_frame_size)) {
    Ok(got) => {
      match (got) {
        frame.Got(f, n) => {
          let out: u8[] = r.out;
          let events: Event[] = r.events;
          let c: Conn = r.conn;
          c = __counted(__taken(c, n));
          return __frame(__Run { conn: c, out: out, events: events }, f);
        },
        frame.More => {
          return r;
        }
      }
    },
    Err(e) => {
      if (e.stream == 0) {
        return __fail(r, e.code, e.reason);
      }
      // A stream error in a frame's shape: the frame is dropped whole.
      let dropped: __Run = __Run { ...r, conn: Conn { ...r.conn, inbox_at: __past_frame(r.conn.inbox, r.conn.inbox_at) } };
      return __reset_stream(dropped, e.stream, e.code);
    }
  }
  return r;
}

// __taken is c with the n bytes at inbox_at taken: the inbox emptied when
// they were the last, which spares the read its cut at the end.
function __taken(c: Conn, n: i32): Conn {
  if (c.inbox_at + n >= c.inbox.len()) {
    return Conn { ...c, inbox: [], inbox_at: 0 };
  }
  return Conn { ...c, inbox_at: c.inbox_at + n };
}

// __past_frame is where the frame at `at` in the inbox ends, by its header.
function __past_frame(inbox: u8[], at: i32): i32 {
  let len: i32 = inbox[at] as i32 << 16 | inbox[at + 1] as i32 << 8 | inbox[at + 2] as i32;
  return at + frame.HEADER_LEN + len;
}

// __counted counts a frame against the budgets' span, resetting them
// when the span is over.
function __counted(c: Conn): Conn {
  if (c.frames + 1 >= c.config.budget_frames) {
    return Conn { ...c, frames: 0, resets: 0, empty_data: 0 };
  }
  return Conn { ...c, frames: c.frames + 1 };
}

// __frame acts on one frame. A header block in progress takes only its
// CONTINUATION frames (§6.2); the first frame must be SETTINGS (§3.4).
function __frame(r: __Run, f: frame.Frame): __Run {
  if (r.conn.block_stream != 0) {
    return __in_block(r, f);
  }
  if (r.conn.phase == AWAITING_SETTINGS) {
    return __first_frame(r, f);
  }
  match (f) {
    frame.Data(d) => {
      return __data(r, d);
    },
    frame.Headers(h) => {
      return __headers(r, h);
    },
    frame.Settings(ack, settings) => {
      return __settings(r, ack, settings);
    },
    frame.WindowUpdate(stream, increment) => {
      return __window_update(r, stream, increment);
    },
    frame.RstStream(stream, code) => {
      return __rst_stream(r, stream, code);
    },
    _ => {
      return __frame_rest(r, f);
    }
  }
  return r;
}

function __frame_rest(r: __Run, f: frame.Frame): __Run {
  match (f) {
    frame.Ping(ack, data) => {
      if (ack) {
        return r;
      }
      return __send(r, frame.Ping(true, data));
    },
    frame.GoAway(g) => {
      return __Run { ...r, conn: Conn { ...r.conn, peer_going_away: true }, events: r.events.append(Event.GoAway(g.code)) };
    },
    frame.PushPromise(p) => {
      return __fail(r, frame.PROTOCOL_ERROR, "PUSH_PROMISE with push disabled");
    },
    frame.Continuation(stream, end, block) => {
      return __fail(r, frame.PROTOCOL_ERROR, "CONTINUATION with no header block open");
    },
    frame.PriorityFrame(stream, p) => {
      // Read and ignored (§5.3.2), except a stream depending on itself
      // (§5.3.1), which is a stream error.
      if (p.dependency == stream) {
        return __reset_stream(__Run { ...r, conn: Conn { ...r.conn, last_stream: __max(r.conn.last_stream, stream) } }, stream, frame.PROTOCOL_ERROR);
      }
      return r;
    },
    _ => {
      // A frame of an unknown type (§4.1).
      return r;
    }
  }
  return r;
}

// __self_dependent is whether a HEADERS frame's priority names its own
// stream as the one it depends on (§5.3.1).
function __self_dependent(priority: Option[frame.Priority], stream: i32): boolean {
  match (priority) {
    Some(p) => {
      return p.dependency == stream;
    },
    None => {
      return false;
    }
  }
  return false;
}

function __first_frame(r: __Run, f: frame.Frame): __Run {
  match (f) {
    frame.Settings(ack, settings) => {
      if (ack) {
        return __fail(r, frame.PROTOCOL_ERROR, "the first frame is a SETTINGS ACK");
      }
      return __settings(__Run { ...r, conn: Conn { ...r.conn, phase: RUNNING } }, false, settings);
    },
    _ => {
      return __fail(r, frame.PROTOCOL_ERROR, "the first frame is not SETTINGS");
    }
  }
  return r;
}

// __in_block takes the next frame of a header block: a CONTINUATION on
// the block's stream, within the frame and byte budgets.
function __in_block(r: __Run, f: frame.Frame): __Run {
  match (f) {
    frame.Continuation(stream, end_headers, block) => {
      if (stream != r.conn.block_stream) {
        return __fail(r, frame.PROTOCOL_ERROR, "CONTINUATION on another stream");
      }
      return __block_part(r, block, end_headers);
    },
    _ => {
      return __fail(r, frame.PROTOCOL_ERROR, "a frame inside a header block");
    }
  }
  return r;
}

// __block_part adds a fragment to the block in progress and, at
// END_HEADERS, decodes it. The block may span header_frames_max frames
// and, raw, the list cap plus a frame (a Huffman-coded block decodes to
// more, never less than four-fifths): past either the connection closes.
function __block_part(r: __Run, part: u8[], end_headers: boolean): __Run {
  let block: u8[] = __joined(r.conn.block, part);
  if (r.conn.block_frames + 1 > r.conn.config.header_frames_max || block.len() > r.conn.config.max_header_list + r.conn.config.max_frame_size) {
    return __fail(r, frame.ENHANCE_YOUR_CALM, "header block over the budget");
  }
  let out: u8[] = r.out;
  let events: Event[] = r.events;
  let c: Conn = r.conn;
  if (!end_headers) {
    c = Conn { ...c, block: block, block_frames: c.block_frames + 1 };
    return __Run { conn: c, out: out, events: events };
  }
  let stream: i32 = c.block_stream;
  let end_stream: boolean = c.block_end;
  c = Conn { ...c, block_stream: 0, block: [], block_frames: 0 };
  return __block_done(__Run { conn: c, out: out, events: events }, stream, block, end_stream);
}

// __headers starts a request, or its trailers, on a stream.
function __headers(r: __Run, h: frame.HeadersFrame): __Run {
  let out: u8[] = r.out;
  let events: Event[] = r.events;
  let c: Conn = r.conn;
  if (__self_dependent(h.priority, h.stream)) {
    c = Conn { ...c, last_stream: __max(c.last_stream, h.stream) };
    return __reset_stream(__Run { conn: c, out: out, events: events }, h.stream, frame.PROTOCOL_ERROR);
  }
  c = Conn { ...c, block_stream: h.stream, block: [], block_end: h.end_stream, block_frames: 0 };
  return __block_part(__Run { conn: c, out: out, events: events }, h.block, h.end_headers);
}

// __block_done decodes a whole header block: a request's headers on a
// new stream, or trailers on one whose body is arriving.
function __block_done(r: __Run, stream: i32, block: u8[], end_stream: boolean): __Run {
  match (r.conn.decoder.decode(block)) {
    Ok(got) => {
      let out: u8[] = r.out;
      let events: Event[] = r.events;
      let c: Conn = r.conn;
      c = Conn { ...c, decoder: got.decoder };
      let at: i32 = __stream_at(c, stream);
      if (c.client) {
        return __client_block(__Run { conn: c, out: out, events: events }, stream, at, got.fields, end_stream);
      }
      if (at >= 0) {
        return __trailers(__Run { conn: c, out: out, events: events }, at, got.fields, end_stream);
      }
      return __request(__Run { conn: c, out: out, events: events }, stream, got.fields, end_stream);
    },
    Err(e) => {
      return __fail(r, frame.COMPRESSION_ERROR, e.message());
    }
  }
  return r;
}

// __client_block takes a header block on a client connection: the
// response's head on a stream this client opened and has no status for
// yet (an informational one stepped over), else its trailers; a block on
// a stream the server would open is a protocol error, push being
// disabled, and one on a stream that has closed a stream error.
function __client_block(r: __Run, stream: i32, at: i32, fields: hpack.Field[], end_stream: boolean): __Run {
  if (at < 0) {
    if (stream % 2 == 0) {
      return __fail(r, frame.PROTOCOL_ERROR, "HEADERS on a stream the server opened");
    }
    if (stream > r.conn.last_stream) {
      return __fail(r, frame.PROTOCOL_ERROR, "HEADERS on an idle stream");
    }
    return __reset_stream(r, stream, frame.STREAM_CLOSED);
  }
  if (r.conn.streams[at].status != 0) {
    return __trailers(r, at, fields, end_stream);
  }
  return __response_head(r, at, fields, end_stream);
}

// __response_head reads a response's header block (§8.3.2): `:status`
// first and alone among the pseudo-header fields, the rest regular. A 1xx
// other than 101 is stepped over, the final response still to come.
function __response_head(r: __Run, at: i32, fields: hpack.Field[], end_stream: boolean): __Run {
  let s: __Stream = r.conn.streams[at];
  match (__parsed_response(s, fields)) {
    Ok(headed) => {
      if (headed.status >= 100 && headed.status < 200 && headed.status != 101) {
        if (end_stream) {
          return __reset_stream(r, s.id, frame.PROTOCOL_ERROR);
        }
        return r;
      }
      let out: u8[] = r.out;
      let events: Event[] = r.events;
      let c: Conn = r.conn;
      c = Conn { ...c, streams: c.streams.with(at, headed) };
      if (end_stream) {
        return __answered(__Run { conn: c, out: out, events: events }, at, headers.header_map_new());
      }
      return __Run { conn: c, out: out, events: events };
    },
    Err(why) => {
      return __reset_stream(r, s.id, frame.PROTOCOL_ERROR);
    }
  }
  return r;
}

// __parsed_response is the stream with the response's status and fields
// read off its header block, or why the block is malformed.
function __parsed_response(s: __Stream, fields: hpack.Field[]): Result[__Stream, string] {
  let status: i32 = 0;
  let out: HeaderMap = headers.header_map_new();
  let length: i32 = 0 - 1;
  let regular: boolean = false;
  for f in fields {
    if (f.name.len() == 0) {
      return Err("empty field name");
    }
    if (f.name[0] == b':') {
      status = __status_of(f, regular || status != 0)?;
    } else {
      regular = true;
      length = __response_length(f, length)?;
      out = __response_regular(out, f)?;
    }
  }
  if (status == 0) {
    return Err("no :status");
  }
  return Ok(__Stream { ...s, status: status, fields: out, length: length });
}

// __status_of is the status a `:status` field carries: the one pseudo-header
// a response has, first and once (`late` says a field came before it).
function __status_of(f: hpack.Field, late: boolean): Result[i32, string] {
  if (late || f.name != ":status" || f.value.len() != 3) {
    return Err("pseudo-header " + f.name);
  }
  match (int.parse_int_radix(f.value, 10)) {
    Some(n) => {
      if (n >= 100 && n <= 999) {
        return Ok(n);
      }
    },
    None => {}
  }
  return Err(":status " + f.value);
}

// __response_regular is `out` with a response's regular field appended,
// the field checked as a request's is.
function __response_regular(out: HeaderMap, f: hpack.Field): Result[HeaderMap, string] {
  if (__has_upper(f.name) || !http.http_field_name_ok(f.name) || !http.http_field_value_ok(f.value) || __connection_specific(f.name)) {
    return Err("field " + f.name);
  }
  return Ok(out.append(f.name, f.value));
}

// __response_length is the body length a response's content-length field
// declares, `length` as it was for any other field, and an error for one
// that is not a length or disagrees with an earlier one.
function __response_length(f: hpack.Field, length: i32): Result[i32, string] {
  if (f.name != "content-length") {
    return Ok(length);
  }
  match (int.parse_int_radix(f.value, 10)) {
    Some(n) => {
      if (n >= 0 && (length < 0 || length == n)) {
        return Ok(n);
      }
    },
    None => {}
  }
  return Err("content-length");
}

// __answered hands a client's response over whole, the stream done with.
function __answered(r: __Run, at: i32, trailers: HeaderMap): __Run {
  let s: __Stream = r.conn.streams[at];
  if (s.length >= 0 && s.length != s.body.len()) {
    return __reset_stream(r, s.id, frame.PROTOCOL_ERROR);
  }
  let out: u8[] = r.out;
  let events: Event[] = r.events;
  let c: Conn = r.conn;
  let resp: HttpResponse = HttpResponse { status: s.status, body: BodyBytes(s.body), headers: s.fields, trailers: trailers, background: None };
  c = Conn { ...c, streams: __without(c.streams, at) };
  return __Run { conn: c, out: out, events: events.append(Answered(s.id, resp)) };
}

// __trailers ends a request with its trailers (§8.1): they must carry
// END_STREAM and no pseudo-header, on a stream whose request has not
// already ended, which is a STREAM_CLOSED error (§5.1).
function __trailers(r: __Run, at: i32, fields: hpack.Field[], end_stream: boolean): __Run {
  let s: __Stream = r.conn.streams[at];
  if (s.state != OPEN && s.state != HALF_LOCAL) {
    return __reset_stream(r, s.id, frame.STREAM_CLOSED);
  }
  if (!end_stream) {
    return __reset_stream(r, s.id, frame.PROTOCOL_ERROR);
  }
  let trailers: HeaderMap = headers.header_map_new();
  for f in fields {
    if (f.name.len() > 0 && f.name[0] == b':') {
      return __reset_stream(r, s.id, frame.PROTOCOL_ERROR);
    }
    trailers = trailers.append(f.name, f.value);
  }
  if (s.streaming) {
    return __stream_ended(r, at, trailers);
  }
  return __finished(r, at, trailers);
}

// __request opens a stream for a request's headers (§5.1.1, §8.3.1): an
// odd id above every one before it, under the concurrency limit, with
// the pseudo-headers a request needs and none it may not have.
function __request(r: __Run, stream: i32, fields: hpack.Field[], end_stream: boolean): __Run {
  if (stream % 2 == 0 || stream <= r.conn.last_stream) {
    return __fail(r, frame.PROTOCOL_ERROR, "stream " + int.int_to_string(stream) + " is not a new client stream");
  }
  let going_away: boolean = r.conn.peer_going_away;
  let refused: boolean = r.conn.handling + __waiting(r.conn) >= r.conn.config.max_concurrent_streams;
  let out: u8[] = r.out;
  let events: Event[] = r.events;
  let c: Conn = r.conn;
  c = Conn { ...c, last_stream: stream };
  if (going_away) {
    return __Run { conn: c, out: out, events: events };
  }
  if (refused) {
    return __reset_stream(__Run { conn: c, out: out, events: events }, stream, frame.REFUSED_STREAM);
  }
  match (__parsed(fields, stream, c.peer_initial_window, c.config.initial_window)) {
    Ok(s) => {
      if (s.method != "CONNECT") {
        match (http.http_request_target(s.method, s.path)) {
          Ok(path) => {
            s = __Stream { ...s, path: path };
          },
          Err(status) => {
            let encoded: hpack.Encoded = c.encoder.encode([hpack.field(":status", int.int_to_string(status))]);
            let rejected: __Run = __header_frames(__Run { conn: Conn { ...c, encoder: encoded.encoder }, out: out, events: events }, stream, encoded.bytes, true);
            if (!end_stream) {
              return __send(rejected, frame.RstStream(stream, frame.NO_ERROR));
            }
            return rejected;
          }
        }
      }
      let streaming: boolean = c.config.stream_bodies;
      if (end_stream) {
        return __finished_at_headers(__Run { conn: c, out: out, events: events }, s);
      }
      c = Conn { ...c, streams: c.streams.append(s) };
      let at: i32 = c.streams.len() - 1;
      if (streaming) {
        return __streamed(__Run { conn: c, out: out, events: events }, at);
      }
      return __Run { conn: c, out: out, events: events };
    },
    Err(why) => {
      return __reset_stream(__Run { conn: c, out: out, events: events }, stream, frame.PROTOCOL_ERROR);
    }
  }
  return __Run { conn: c, out: out, events: events };
}

// __waiting is how many streams have a request still arriving: they take
// a slot before their handler runs, so a client cannot hold a thousand
// half-sent requests.
function __waiting(c: Conn): i32 {
  let n: i32 = 0;
  for s in c.streams {
    if (!s.handling && !s.reset) {
      n = n + 1;
    }
  }
  return n;
}

// __parsed reads a request's header fields (§8.3): the pseudo-headers
// first, each once, `:method`, `:scheme` and `:path` present (CONNECT
// aside), names in lower case, no connection-specific field and `te` only
// `trailers`; content-length is remembered to check the body against.
function __parsed(fields: hpack.Field[], id: i32, send_window: i32, recv_window: i32): Result[__Stream, string] {
  let s: __Stream = __Stream { id: id, state: OPEN, send_window: send_window, recv_window: recv_window, method: "", scheme: "", authority: "", path: "", fields: headers.header_map_new(), body: [], length: 0 - 1, handling: false, reset: false, pending: [], trailers: headers.header_map_new(), owes_end: false, streaming: false, received: 0, producing: false, status: 0, seen: 0 };
  let regular: boolean = false;
  for f in fields {
    if (f.name.len() == 0) {
      return Err("empty field name");
    }
    if (f.name[0] == b':') {
      if (regular) {
        return Err("pseudo-header after a regular field");
      }
      s = __pseudo(s, f.name, f.value)?;
    } else {
      regular = true;
      s = __regular(s, f.name, f.value)?;
    }
  }
  return __complete(s);
}

// __complete checks the pseudo-headers a request must have (§8.3.1).
function __complete(s: __Stream): Result[__Stream, string] {
  if (s.method.len() == 0) {
    return Err("no :method");
  }
  if (s.method != "CONNECT" && (s.scheme.len() == 0 || s.path.len() == 0)) {
    return Err("no :scheme or :path");
  }
  if (s.authority.len() > 0 && !s.fields.has("host")) {
    let authority: string = s.authority;
    return Ok(__Stream { ...s, fields: s.fields.append("host", authority) });
  }
  return Ok(s);
}

// Each pseudo-header once (§8.3.1), seen or not by `seen`'s bits, since
// an empty first value would otherwise let a second through.
function __pseudo(s: __Stream, name: string, value: string): Result[__Stream, string] {
  if (name == ":method" && (s.seen & 1) == 0) {
    return Ok(__Stream { ...s, method: value, seen: s.seen | 1 });
  }
  if (name == ":scheme" && (s.seen & 2) == 0) {
    return Ok(__Stream { ...s, scheme: value, seen: s.seen | 2 });
  }
  if (name == ":path" && (s.seen & 4) == 0 && value.len() > 0) {
    return Ok(__Stream { ...s, path: value, seen: s.seen | 4 });
  }
  if (name == ":authority" && (s.seen & 8) == 0) {
    return Ok(__Stream { ...s, authority: value, seen: s.seen | 8 });
  }
  return Err("pseudo-header " + name);
}

function __regular(s: __Stream, name: string, value: string): Result[__Stream, string] {
  if (__has_upper(name) || !http.http_field_name_ok(name) || !http.http_field_value_ok(value)) {
    return Err("field " + name);
  }
  if (__connection_specific(name)) {
    return Err("connection-specific field " + name);
  }
  if (name == "te" && value != "trailers") {
    return Err("te other than trailers");
  }
  if (name == "content-length") {
    return __with_length(s, value);
  }
  return Ok(__Stream { ...s, fields: s.fields.append(name, value) });
}

// __has_upper is whether a field name has an ASCII capital, which HTTP/2
// refuses (§8.2.1).
function __has_upper(name: string): boolean {
  let i: i32 = 0;
  while (i < name.len()) {
    if (name[i] >= b'A' && name[i] <= b'Z') {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// __connection_specific names the fields HTTP/2 has no place for (§8.2.2).
function __connection_specific(name: string): boolean {
  return name == "connection" || name == "keep-alive" || name == "proxy-connection" || name == "transfer-encoding" || name == "upgrade";
}

// __with_length remembers a content-length, which must be a number and
// agree with any other.
function __with_length(s: __Stream, value: string): Result[__Stream, string] {
  match (int.parse_int_radix(value, 10)) {
    Some(n) => {
      if (n < 0 || s.length >= 0 && s.length != n) {
        return Err("content-length");
      }
      return Ok(__Stream { ...s, length: n, fields: s.fields.append("content-length", value) });
    },
    None => {
      return Err("content-length");
    }
  }
  return Err("content-length");
}

// __data takes a DATA frame on an open stream: within both receive
// windows, within the body cap, counted when empty, and the request
// finished at END_STREAM.
function __data(r: __Run, d: frame.DataFrame): __Run {
  let c: Conn = r.conn;
  let at: i32 = __stream_at(c, d.stream);
  if (at < 0) {
    if (d.stream > c.last_stream) {
      return __fail(r, frame.PROTOCOL_ERROR, "DATA on an idle stream");
    }
    return __reset_stream(r, d.stream, frame.STREAM_CLOSED);
  }
  let s: __Stream = c.streams[at];
  if (s.state != OPEN && s.state != HALF_LOCAL) {
    return __reset_stream(r, s.id, frame.STREAM_CLOSED);
  }
  let took: i32 = d.data.len() + d.padding;
  if (took > c.recv_window) {
    return __fail(r, frame.FLOW_CONTROL_ERROR, "DATA past the connection window");
  }
  if (took > s.recv_window) {
    return __reset_stream(r, s.id, frame.FLOW_CONTROL_ERROR);
  }
  if (d.data.len() == 0 && !d.end_stream) {
    if (c.empty_data + 1 > c.config.empty_data_budget) {
      return __fail(r, frame.ENHANCE_YOUR_CALM, "empty DATA frames over the budget");
    }
    c = Conn { ...c, empty_data: c.empty_data + 1 };
  }
  return __body_grown(__Run { ...r, conn: c }, at, d, took);
}

// __body_grown takes a DATA frame's bytes into the body, under the cap,
// and finishes the request at END_STREAM.
function __body_grown(r: __Run, at: i32, d: frame.DataFrame, took: i32): __Run {
  let c: Conn = r.conn;
  let s: __Stream = c.streams[at];
  if (s.streaming) {
    return __body_reported(r, at, d, took);
  }
  if (s.body.len() + d.data.len() > c.config.max_body) {
    return __reset_stream(r, s.id, frame.REFUSED_STREAM);
  }
  let grown: __Stream = __Stream { ...s, body: s.body.concat(d.data), recv_window: s.recv_window - took };
  let next: __Run = __replenished(__Run { ...r, conn: Conn { ...c, recv_window: c.recv_window - took, streams: c.streams.with(at, grown) } }, at);
  if (d.end_stream) {
    return __finished(next, at, headers.header_map_new());
  }
  return next;
}

// __body_reported hands a streamed request's DATA on as it comes: the
// windows are charged and left for `consumed` to replenish, so a handler
// that reads slowly holds the client to what it has not taken yet. The
// padding, which no handler can take, is credited back at once.
function __body_reported(r: __Run, at: i32, d: frame.DataFrame, took: i32): __Run {
  let c: Conn = r.conn;
  let s: __Stream = c.streams[at];
  let grown: __Stream = __Stream { ...s, received: s.received + d.data.len(), recv_window: s.recv_window - took };
  let next: __Run = __Run { ...r, conn: Conn { ...c, recv_window: c.recv_window - took, streams: c.streams.with(at, grown) } };
  if (d.padding > 0) {
    next = __credited(next, at, d.padding, !d.end_stream);
  }
  if (d.data.len() > 0) {
    next = __Run { ...next, events: next.events.append(StreamData(s.id, d.data)) };
  }
  if (d.end_stream) {
    return __stream_ended(next, at, headers.header_map_new());
  }
  return next;
}

// __streamed hands a request over at its header block
// (`Config.stream_bodies`): the handler runs while the body arrives.
function __streamed(r: __Run, at: i32): __Run {
  let c: Conn = r.conn;
  let s: __Stream = c.streams[at];
  let fields: HeaderMap = s.fields;
  if (s.authority.len() > 0 && !fields.has("host")) {
    fields = fields.append("host", s.authority);
  }
  let empty: u8[] = [];
  let req: HttpRequest = HttpRequest { method: s.method, path: s.path, body: Stream { data: empty, pos: 0, source: None }, headers: fields, trailers: headers.header_map_new() };
  let handed: __Stream = __Stream { ...s, handling: true, streaming: true };
  let next: Conn = Conn { ...c, streams: c.streams.with(at, handed), handling: c.handling + 1 };
  return __Run { ...r, conn: next, events: r.events.append(Streamed(s.id, req)) };
}

// __stream_ended ends a streamed request's body: what came must be what
// content-length said; the stream closes when the response has already
// gone, and awaits it otherwise.
function __stream_ended(r: __Run, at: i32, trailers: HeaderMap): __Run {
  let c: Conn = r.conn;
  let s: __Stream = c.streams[at];
  if (s.length >= 0 && s.length != s.received) {
    return __reset_stream(r, s.id, frame.PROTOCOL_ERROR);
  }
  let ended: __Run = __Run { ...r, events: r.events.append(StreamEnd(s.id, trailers)) };
  if (s.state == HALF_LOCAL) {
    return __Run { ...ended, conn: Conn { ...c, streams: __without(c.streams, at) } };
  }
  return __Run { ...ended, conn: Conn { ...c, streams: c.streams.with(at, __Stream { ...s, state: HALF_REMOTE }) } };
}

// __replenished sends WINDOW_UPDATE for the connection and the stream
// once either window has fallen to half, since the body is held here and
// the client may keep sending.
function __replenished(r: __Run, at: i32): __Run {
  let c: Conn = r.conn;
  let out: __Run = r;
  let half: i32 = c.config.initial_window / 2;
  if (c.recv_window <= half) {
    out = __send(__Run { ...out, conn: Conn { ...out.conn, recv_window: c.config.initial_window } }, frame.WindowUpdate(0, c.config.initial_window - c.recv_window));
  }
  let s: __Stream = out.conn.streams[at];
  if (s.recv_window <= half && s.state == OPEN) {
    let filled: __Stream = __Stream { ...s, recv_window: c.config.initial_window };
    out = __send(__Run { ...out, conn: Conn { ...out.conn, streams: out.conn.streams.with(at, filled) } }, frame.WindowUpdate(s.id, c.config.initial_window - s.recv_window));
  }
  return out;
}

// __finished hands a stream's request over once the client's END_STREAM
// has come: the body must be what content-length said.
function __finished(r: __Run, at: i32, trailers: HeaderMap): __Run {
  if (r.conn.client) {
    return __answered(r, at, trailers);
  }
  let s: __Stream = r.conn.streams[at];
  if (s.length >= 0 && s.length != s.body.len()) {
    return __reset_stream(r, s.id, frame.PROTOCOL_ERROR);
  }
  let out: u8[] = r.out;
  let events: Event[] = r.events;
  let c: Conn = r.conn;
  let req: HttpRequest = __request_of(s, trailers);
  let handed: __Stream = __Stream { ...s, state: HALF_REMOTE, body: [], handling: true };
  c = Conn { ...c, streams: c.streams.with(at, handed), handling: c.handling + 1 };
  return __Run { conn: c, out: out, events: events.append(Request(s.id, req)) };
}

// __finished_at_headers is `__finished` for a request whose END_STREAM
// came with its header block: the stream, not yet among the connection's,
// joins them handed over.
function __finished_at_headers(r: __Run, s: __Stream): __Run {
  if (s.length > 0) {
    return __reset_stream(r, s.id, frame.PROTOCOL_ERROR);
  }
  let out: u8[] = r.out;
  let events: Event[] = r.events;
  let c: Conn = r.conn;
  let id: i32 = s.id;
  let req: HttpRequest = __request_of(s, headers.header_map_new());
  let handed: __Stream = __Stream { ...s, state: HALF_REMOTE, handling: true };
  c = Conn { ...c, streams: c.streams.append(handed), handling: c.handling + 1 };
  return __Run { conn: c, out: out, events: events.append(Request(id, req)) };
}

// __request_of is the request a stream's header block and body make.
function __request_of(s: __Stream, trailers: HeaderMap): HttpRequest {
  return HttpRequest { method: s.method, path: s.path, body: Stream { data: s.body, pos: 0, source: None }, headers: s.fields, trailers: trailers };
}

// __settings applies the client's settings and acknowledges them (§6.5).
function __settings(r: __Run, ack: boolean, settings: frame.Setting[]): __Run {
  if (ack) {
    return __Run { ...r, conn: Conn { ...r.conn, settings_acked: true } };
  }
  let out: __Run = r;
  for s in settings {
    if (s.id == frame.SETTINGS_INITIAL_WINDOW_SIZE) {
      out = __windows_moved(out, s.value);
    }
    if (s.id == frame.SETTINGS_MAX_FRAME_SIZE) {
      out = __Run { ...out, conn: Conn { ...out.conn, peer_max_frame: s.value } };
    }
    if (s.id == frame.SETTINGS_HEADER_TABLE_SIZE) {
      out = __Run { ...out, conn: Conn { ...out.conn, encoder: out.conn.encoder.with_max_table(__min(s.value, 4096)) } };
    }
    if (out.conn.phase == CLOSED) {
      return out;
    }
  }
  return __send(out, frame.Settings(true, []));
}

// __windows_moved moves every stream's send window by the change in the
// client's initial window (§6.9.2); past 2^31-1 is a connection error.
function __windows_moved(r: __Run, initial: i32): __Run {
  let c: Conn = r.conn;
  let delta: i32 = initial - c.peer_initial_window;
  let streams: __Stream[] = [];
  for s in c.streams {
    let moved: i32 = s.send_window + delta;
    if (moved < 0 && delta > 0) {
      return __fail(r, frame.FLOW_CONTROL_ERROR, "a stream's window past 2^31-1");
    }
    streams = streams.append(__Stream { ...s, send_window: moved });
  }
  return __flushed(__Run { ...r, conn: Conn { ...c, peer_initial_window: initial, streams: streams } });
}

// __window_update widens the connection's or a stream's send window
// (§6.9), then sends what the width allows.
function __window_update(r: __Run, stream: i32, increment: i32): __Run {
  let c: Conn = r.conn;
  if (stream == 0) {
    if (c.send_window + increment < 0) {
      return __fail(r, frame.FLOW_CONTROL_ERROR, "the connection window past 2^31-1");
    }
    return __flushed(__Run { ...r, conn: Conn { ...c, send_window: c.send_window + increment } });
  }
  let at: i32 = __stream_at(c, stream);
  if (at < 0) {
    if (stream > c.last_stream) {
      return __fail(r, frame.PROTOCOL_ERROR, "WINDOW_UPDATE on an idle stream");
    }
    return r;
  }
  let s: __Stream = c.streams[at];
  if (s.send_window + increment < 0) {
    return __reset_stream(r, s.id, frame.FLOW_CONTROL_ERROR);
  }
  return __flushed(__Run { ...r, conn: Conn { ...c, streams: c.streams.with(at, __Stream { ...s, send_window: s.send_window + increment }) } });
}

// __rst_stream takes the client's RST_STREAM: the stream goes, its
// handler (if one runs) is told and keeps its slot until it answers, and
// the reset counts.
function __rst_stream(r: __Run, stream: i32, code: i32): __Run {
  let c: Conn = r.conn;
  if (stream > c.last_stream) {
    return __fail(r, frame.PROTOCOL_ERROR, "RST_STREAM on an idle stream");
  }
  let budgeted: __Run = __reset_counted(r);
  if (budgeted.conn.phase == CLOSED) {
    return budgeted;
  }
  let at: i32 = __stream_at(c, stream);
  if (at < 0) {
    return budgeted;
  }
  let s: __Stream = c.streams[at];
  let next: Conn = budgeted.conn;
  if (s.handling) {
    next = Conn { ...next, streams: next.streams.with(at, __Stream { ...s, reset: true, pending: [], owes_end: false }) };
  } else {
    next = Conn { ...next, streams: __without(next.streams, at) };
  }
  return __Run { ...budgeted, conn: next, events: budgeted.events.append(Reset(stream, code)) };
}

// __reset_counted counts one reset, either side's, against the budget.
function __reset_counted(r: __Run): __Run {
  let c: Conn = r.conn;
  if (c.resets + 1 > c.config.reset_budget) {
    return __fail(r, frame.ENHANCE_YOUR_CALM, "resets over the budget");
  }
  return __Run { ...r, conn: Conn { ...c, resets: c.resets + 1 } };
}

// __reset_stream is a stream error (§5.4.2): RST_STREAM sent, the stream
// dropped, the reset counted.
function __reset_stream(r: __Run, stream: i32, code: i32): __Run {
  let budgeted: __Run = __reset_counted(r);
  if (budgeted.conn.phase == CLOSED) {
    return budgeted;
  }
  let c: Conn = budgeted.conn;
  let at: i32 = __stream_at(c, stream);
  if (at >= 0) {
    let s: __Stream = c.streams[at];
    if (s.handling) {
      c = Conn { ...c, streams: c.streams.with(at, __Stream { ...s, reset: true, pending: [], owes_end: false }) };
    } else {
      c = Conn { ...c, streams: __without(c.streams, at) };
    }
  }
  return __send(__Run { ...budgeted, conn: c }, frame.RstStream(stream, code));
}

// __fail is a connection error (§5.4.1): GOAWAY with the last stream
// taken, the connection closed, and the reason reported.
function __fail(r: __Run, code: i32, reason: string): __Run {
  let c: Conn = r.conn;
  let out: __Run = __send(r, frame.GoAway(frame.GoAwayFrame { last_stream: c.last_stream, code: code, debug: reason.bytes() }));
  return __Run { ...out, conn: Conn { ...c, phase: CLOSED, streams: [], handling: 0, inbox: [], inbox_at: 0 }, events: out.events.append(Closed(code, reason)) };
}

// === responding ============================================================

// respond answers the request on `stream`: its handler's slot is freed,
// the headers go now, the body as the windows allow, and the trailers
// last. A stream the client reset, or one the server never opened,
// takes no response. A response to HEAD sends no body, under the length
// the body would have.
pub function (c: Conn) respond(stream: i32, resp: HttpResponse): Step {
  let at: i32 = __stream_at(c, stream);
  if (at < 0 || c.phase == CLOSED) {
    return Step { conn: c, output: [], events: [] };
  }
  let s: __Stream = c.streams[at];
  if (!s.handling) {
    return Step { conn: c, output: [], events: [] };
  }
  if (s.reset) {
    return Step { conn: Conn { ...c, handling: c.handling - 1, streams: __without(c.streams, at) }, output: [], events: [] };
  }
  // What the stream decides is read before the connection is rebuilt, so
  // the rebuild reuses its box rather than copying it under the read.
  let headless: boolean = __headless(s, resp);
  let stream_window: i32 = s.send_window;
  let body: u8[] = resp.body_bytes();
  let length: i32 = body.len();
  if (headless) {
    body = [];
  }
  if (resp.trailers.len() > 0) {
    length = 0 - 1;
  }
  let enc: hpack.Encoded = __response_block(c.encoder, resp, length);
  c = Conn { ...c, handling: c.handling - 1, encoder: enc.encoder };
  // A body both windows and the frame size take goes out now, in one
  // DATA frame after the HEADERS, and the stream is done with; the rest
  // is owed to the stream and sent as the windows allow.
  let n: i32 = __min(__min(body.len(), c.peer_max_frame), __min(stream_window, c.send_window));
  if (n == body.len() && resp.trailers.len() == 0) {
    let r: __Run = __header_frames(__run(c), stream, enc.bytes, n == 0);
    if (n > 0) {
      let out: u8[] = r.out;
      let events: Event[] = r.events;
      let sent: Conn = r.conn;
      r = __send_bytes(__Run { conn: Conn { ...sent, send_window: sent.send_window - n }, out: out, events: events }, frame.data_bytes(stream, true, body));
    }
    return __step(__ended(r, at));
  }
  let kept: __Stream = c.streams[at];
  let owed: __Stream = __Stream { ...kept, handling: false, pending: body, trailers: resp.trailers, owes_end: true };
  c = Conn { ...c, streams: c.streams.with(at, owed) };
  return __step(__flushed(__header_frames(__run(c), stream, enc.bytes, false)));
}

// respond_head begins answering the request on `stream` with the
// response's status and headers, its body to follow through `write` and
// `end`: for a body produced in parts, under the windows as they open.
// `resp.body` is ignored, and the stream takes no response until `end`.
// A response that carries no body (`producing` false after) ends here.
pub function (c: Conn) respond_head(stream: i32, resp: HttpResponse): Step {
  let at: i32 = __stream_at(c, stream);
  if (at < 0 || c.phase == CLOSED) {
    return Step { conn: c, output: [], events: [] };
  }
  let s: __Stream = c.streams[at];
  if (!s.handling) {
    return Step { conn: c, output: [], events: [] };
  }
  let freed: Conn = Conn { ...c, handling: c.handling - 1 };
  if (s.reset) {
    return Step { conn: Conn { ...freed, streams: __without(freed.streams, at) }, output: [], events: [] };
  }
  let headless: boolean = __headless(s, resp);
  let enc: hpack.Encoded = __response_block(freed.encoder, resp, 0 - 1);
  let r: __Run = __header_frames(__run(Conn { ...freed, encoder: enc.encoder }), stream, enc.bytes, headless);
  let owed: __Stream = __Stream { ...s, handling: false, pending: [], trailers: headers.header_map_new(), owes_end: !headless, producing: !headless };
  r = __Run { ...r, conn: Conn { ...r.conn, streams: r.conn.streams.with(at, owed) } };
  if (headless) {
    return __step(__ended(r, at));
  }
  return __step(r);
}

// __headless is whether the response on `s` carries no body: one to HEAD,
// or a 1xx, 204 or 304.
function __headless(s: __Stream, resp: HttpResponse): boolean {
  return s.method == "HEAD" || http.http_bodiless(resp.status);
}

// producing is whether `stream` takes the body a `respond_head` began
// through `write`: false once that body has ended, for a response that
// carries none, and for a stream the client reset or that is gone.
pub function (c: Conn) producing(stream: i32): boolean {
  let at: i32 = __stream_at(c, stream);
  return at >= 0 && c.phase != CLOSED && c.streams[at].producing;
}

// write adds `bytes` to the body a `respond_head` began, sent as the
// windows allow; `pending(stream)` is how much waits on them.
pub function (c: Conn) write(stream: i32, bytes: u8[]): Step {
  let at: i32 = __stream_at(c, stream);
  if (at < 0 || c.phase == CLOSED || !c.streams[at].producing) {
    return Step { conn: c, output: [], events: [] };
  }
  let s: __Stream = c.streams[at];
  let grown: __Stream = __Stream { ...s, pending: s.pending.concat(bytes) };
  return __step(__flushed(__run(Conn { ...c, streams: c.streams.with(at, grown) })));
}

// end finishes the body a `respond_head` began: what is pending goes as
// the windows allow, then `trailers` if any and END_STREAM.
pub function (c: Conn) end(stream: i32, trailers: HeaderMap): Step {
  let at: i32 = __stream_at(c, stream);
  if (at < 0 || c.phase == CLOSED || !c.streams[at].producing) {
    return Step { conn: c, output: [], events: [] };
  }
  let s: __Stream = c.streams[at];
  let ending: __Stream = __Stream { ...s, trailers: trailers, producing: false };
  return __step(__flushed(__run(Conn { ...c, streams: c.streams.with(at, ending) })));
}

// pending is how many body bytes `write` has queued on `stream` that the
// windows have not yet let out, for a producer to pace itself by; 0 for a
// stream that is not being written.
pub function (c: Conn) pending(stream: i32): i32 {
  let at: i32 = __stream_at(c, stream);
  if (at < 0) {
    return 0;
  }
  return c.streams[at].pending.len();
}

// consumed replenishes the windows for `n` bytes of a streamed request's
// body the handler has taken (`StreamData`): the connection's, and the
// stream's while the client may still send on it.
pub function (c: Conn) consumed(stream: i32, n: i32): Step {
  if (c.phase == CLOSED || n <= 0) {
    return Step { conn: c, output: [], events: [] };
  }
  return __step(__credited(__run(c), __stream_at(c, stream), n, true));
}

// __credited replenishes the windows for `n` bytes: the connection's, and
// the stream's at `at` when asked and while the client may still send on
// it.
function __credited(r: __Run, at: i32, n: i32, stream_too: boolean): __Run {
  let out: __Run = __send(__Run { ...r, conn: Conn { ...r.conn, recv_window: r.conn.recv_window + n } }, frame.WindowUpdate(0, n));
  if (!stream_too || at < 0) {
    return out;
  }
  let s: __Stream = out.conn.streams[at];
  if (s.state != OPEN && s.state != HALF_LOCAL) {
    return out;
  }
  let filled: __Stream = __Stream { ...s, recv_window: s.recv_window + n };
  return __send(__Run { ...out, conn: Conn { ...out.conn, streams: out.conn.streams.with(at, filled) } }, frame.WindowUpdate(s.id, n));
}

// __response_fields is the response's header list: `:status` first, then
// each field in lower case, connection-specific ones dropped (§8.2.2),
// cookies never indexed, and the body's length when it is known (`length`
// below 0 when it is not: trailers follow, or the body comes in parts).
function __response_block(e: hpack.Encoder, resp: HttpResponse, length: i32): hpack.Encoded {
  let en: hpack.Encoding = e.begin().put(":status", __status_text(resp.status), false);
  let i: i32 = 0;
  let has_length: boolean = false;
  while (i < resp.headers.names.len()) {
    let name: string = __lowered(resp.headers.names[i]);
    if (name == "content-length") {
      has_length = true;
    }
    if (!__connection_specific(name)) {
      en = en.put(name, resp.headers.values[i], __sensitive(name));
    }
    i = i + 1;
  }
  if (!has_length && length >= 0 && !http.http_bodiless(resp.status)) {
    en = en.put("content-length", int.int_to_string(length), false);
  }
  return en.finish();
}

// __status_text is the status as the :status field carries it, the common
// ones without a string built for each response.
function __status_text(status: i32): string {
  if (status == 200) {
    return "200";
  }
  if (status == 204) {
    return "204";
  }
  if (status == 304) {
    return "304";
  }
  if (status == 400) {
    return "400";
  }
  if (status == 404) {
    return "404";
  }
  if (status == 500) {
    return "500";
  }
  return int.int_to_string(status);
}

// __sensitive says whether a field is never indexed, so the client's table
// cannot be probed for a cookie or a credential.
function __sensitive(name: string): boolean {
  return name == "set-cookie" || name == "authorization" || name == "proxy-authenticate";
}

// __lowered is `name` in lower case, `name` itself when it already is.
function __lowered(name: string): string {
  let i: i32 = 0;
  while (i < name.len()) {
    if (name[i] >= b'A' && name[i] <= b'Z') {
      return name.to_lower();
    }
    i = i + 1;
  }
  return name;
}

// __header_frames writes a header block as HEADERS and, past the peer's
// frame size, CONTINUATION frames (§6.2).
function __header_frames(r: __Run, stream: i32, block: u8[], end_stream: boolean): __Run {
  let max: i32 = r.conn.peer_max_frame;
  let first: i32 = block.len();
  if (first > max) {
    first = max;
  }
  let head: u8[] = block;
  if (first < block.len()) {
    head = __bytes_range(block, 0, first);
  }
  let out: __Run = __send_bytes(r, frame.headers_bytes(stream, end_stream, first == block.len(), head));
  let at: i32 = first;
  while (at < block.len()) {
    let to: i32 = at + max;
    if (to > block.len()) {
      to = block.len();
    }
    out = __send(out, frame.Continuation(stream, to == block.len(), __bytes_range(block, at, to)));
    at = to;
  }
  return out;
}

// __flushed sends what every stream's pending body the windows allow,
// and the trailers and END_STREAM of each body that is all sent.
function __flushed(r: __Run): __Run {
  let out: __Run = r;
  let i: i32 = 0;
  while (i < out.conn.streams.len()) {
    let before: i32 = out.conn.streams.len();
    out = __flush_stream(out, i);
    if (out.conn.streams.len() == before) {
      i = i + 1;
    }
  }
  return out;
}

// __flush_stream sends the stream at `at` as much of its body as both
// windows and the frame size allow, then its end when the body is gone
// and no more is being written (`producing`).
function __flush_stream(r: __Run, at: i32): __Run {
  let out: __Run = r;
  while (true) {
    let c: Conn = out.conn;
    let s: __Stream = c.streams[at];
    if (!s.owes_end) {
      return out;
    }
    if (s.pending.len() == 0) {
      if (s.producing) {
        return out;
      }
      if (s.trailers.len() == 0) {
        out = __send_bytes(out, frame.data_bytes(s.id, true, []));
      }
      return __ended(out, at);
    }
    let n: i32 = __min(__min(s.pending.len(), c.peer_max_frame), __min(s.send_window, c.send_window));
    if (n <= 0) {
      return out;
    }
    let final: boolean = n == s.pending.len() && s.trailers.len() == 0 && !s.producing;
    let sent: __Stream = __Stream { ...s, pending: __rest(s.pending, n), send_window: s.send_window - n };
    out = __send_bytes(__Run { ...out, conn: Conn { ...c, send_window: c.send_window - n, streams: c.streams.with(at, sent) } }, frame.data_bytes(s.id, final, __bytes_range(s.pending, 0, n)));
    if (final) {
      return __ended(out, at);
    }
  }
  return out;
}

// __ended closes the server's side of a stream: trailers if any are owed
// (as a HEADERS with END_STREAM), then the stream closes, or waits for the
// client's END_STREAM.
function __ended(r: __Run, at: i32): __Run {
  let s: __Stream = r.conn.streams[at];
  if (s.trailers.len() > 0) {
    let en: hpack.Encoding = r.conn.encoder.begin();
    let i: i32 = 0;
    while (i < s.trailers.names.len()) {
      en = en.put(__lowered(s.trailers.names[i]), s.trailers.values[i], false);
      i = i + 1;
    }
    let enc: hpack.Encoded = en.finish();
    let out: u8[] = r.out;
    let events: Event[] = r.events;
    let c: Conn = r.conn;
    c = Conn { ...c, encoder: enc.encoder };
    r = __header_frames(__Run { conn: c, out: out, events: events }, s.id, enc.bytes, true);
  }
  let out: u8[] = r.out;
  let events: Event[] = r.events;
  let c: Conn = r.conn;
  if (s.state == HALF_REMOTE) {
    c = Conn { ...c, streams: __without(c.streams, at) };
    return __Run { conn: c, out: out, events: events };
  }
  let done: __Stream = __Stream { ...s, state: HALF_LOCAL, handling: false, pending: [], trailers: headers.header_map_new(), owes_end: false };
  c = Conn { ...c, streams: c.streams.with(at, done) };
  return __Run { conn: c, out: out, events: events };
}

// reset ends a stream the server will not answer: RST_STREAM with `code`,
// its handler's slot freed. The reset counts against the budget as the
// client's do.
pub function (c: Conn) reset(stream: i32, code: i32): Step {
  let at: i32 = __stream_at(c, stream);
  if (at < 0 || c.phase == CLOSED) {
    return Step { conn: c, output: [], events: [] };
  }
  let s: __Stream = c.streams[at];
  let freed: Conn = c;
  if (s.handling) {
    freed = Conn { ...c, handling: c.handling - 1, streams: c.streams.with(at, __Stream { ...s, handling: false }) };
  }
  if (s.reset) {
    return Step { conn: Conn { ...freed, streams: __without(freed.streams, at) }, output: [], events: [] };
  }
  return __step(__reset_stream(__run(freed), stream, code));
}

// goaway tells the client no new streams will be taken (§6.8): the open
// ones finish, and the loop closes the socket once they have.
pub function (c: Conn) goaway(code: i32): Step {
  if (c.phase == CLOSED) {
    return Step { conn: c, output: [], events: [] };
  }
  return __step(__send(__run(Conn { ...c, peer_going_away: true }), frame.GoAway(frame.GoAwayFrame { last_stream: c.last_stream, code: code, debug: [] })));
}

// ping sends a PING the client answers, which the loop uses to find a
// dead connection.
pub function (c: Conn) ping(data: u8[]): Step {
  return __step(__send(__run(c), frame.Ping(false, data)));
}

// === helpers ===============================================================

function __stream_at(c: Conn, id: i32): i32 {
  let i: i32 = 0;
  while (i < c.streams.len()) {
    if (c.streams[i].id == id) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function __without(streams: __Stream[], at: i32): __Stream[] {
  let out: __Stream[] = [];
  let i: i32 = 0;
  while (i < streams.len()) {
    if (i != at) {
      out = out.append(streams[i]);
    }
    i = i + 1;
  }
  return out;
}

function __max(a: i32, b: i32): i32 {
  if (a > b) {
    return a;
  }
  return b;
}

function __min(a: i32, b: i32): i32 {
  if (a < b) {
    return a;
  }
  return b;
}

function __rest(buf: u8[], from: i32): u8[] {
  if (from >= buf.len()) {
    return [];
  }
  return __bytes_range(buf, from, buf.len());
}
