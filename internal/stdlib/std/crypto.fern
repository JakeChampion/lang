        w2 = ((bs[off + 8] as u32) << 24) | ((bs[off + 9] as u32) << 16) | ((bs[off + 10] as u32) << 8) | (bs[off + 11] as u32);
        w3 = ((bs[off + 12] as u32) << 24) | ((bs[off + 13] as u32) << 16) | ((bs[off + 14] as u32) << 8) | (bs[off + 15] as u32);
        w4 = ((bs[off + 16] as u32) << 24) | ((bs[off + 17] as u32) << 16) | ((bs[off + 18] as u32) << 8) | (bs[off + 19] as u32);
        w5 = ((bs[off + 20] as u32) << 24) | ((bs[off + 21] as u32) << 16) | ((bs[off + 22] as u32) << 8) | (bs[off + 23] as u32);
