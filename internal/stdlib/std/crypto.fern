    var w1: u32 = 0;
    var w2: u32 = 0;
    var w3: u32 = 0;
    var w4: u32 = 0;
    var w5: u32 = 0;
    var w6: u32 = 0;
    var w7: u32 = 0;
    var w8: u32 = 0;
    var w9: u32 = 0;
    var w10: u32 = 0;
    var w11: u32 = 0;
    var w12: u32 = 0;
    var w13: u32 = 0;
    var w14: u32 = 0;
