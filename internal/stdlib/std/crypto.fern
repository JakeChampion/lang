        off = off + 64;
        blk = blk + 1;
    }
    return Sha1 { ...st, h0: a, h1: b, h2: c, h3: d, h4: e };
}

function __sha1_absorb(own h: Sha1, bs: [u8]): Sha1 {
    var n: i32 = bs.len();
    var pos: i32 = 0;
    var bl: i32 = h.buf_len;
    if (bl > 0) {
        var take: i32 = 64 - bl;
        if (take > n) { take = n; }
        h = Sha1 { ...h, buf: __copy_in(h.buf, bl, bs, 0, take) };
        bl = bl + take;
        pos = take;
        if (bl == 64) {
            h = __sha1_blocks(h, h.buf, 0, 1);
            bl = 0;
        }
    }
    var nb: i32 = (n - pos) / 64;
    if (nb > 0) {
        h = __sha1_blocks(h, bs, pos, nb);
        pos = pos + nb * 64;
    }
    if (pos < n) {
        h = Sha1 { ...h, buf: __copy_in(h.buf, bl, bs, pos, n - pos) };
        bl = bl + (n - pos);
    }
    return Sha1 { ...h, buf_len: bl, total: h.total + (n as u64) };
}

// update / update_bytes absorb a chunk of arbitrary length — a string, or a
// `[u8]` view (a `u8[]` lends itself, `arr[a:b]` slices one). Rebind the result
// (`h = h.update(chunk)`): the state is a value, and the rebind is what lets the
// pending block be reused in place rather than copied.
pub function (h: Sha1) update(chunk: string): Sha1 {
    h = __sha1_absorb(h, chunk.as_bytes());
    return h;
}

pub function (h: Sha1) update_bytes(chunk: [u8]): Sha1 {
    h = __sha1_absorb(h, chunk);
    return h;
}

pub function (h: Sha1) final_bytes(): u8[] {
    var bl: i32 = h.buf_len;
    var plen: i32 = 64;
    if (bl >= 56) { plen = 128; }
    var pad: u8[] = __copy_in(__zero_u8(plen), 0, h.buf, 0, bl);
    pad = pad.with(bl, 0x80 as u8);
    var bits: u64 = h.total << (3 as u64);
    pad = __put_be64(pad, plen - 8, bits);
    var st: Sha1 = __sha1_blocks(h, pad, 0, plen / 64);
    var out: u8[] = __alloc_u8(st.out_len);
    out = __put_be32(out, 0, st.h0);
    out = __put_be32(out, 4, st.h1);
    out = __put_be32(out, 8, st.h2);
    out = __put_be32(out, 12, st.h3);
    out = __put_be32(out, 16, st.h4);
    return out;
}

pub function (h: Sha1) final_hex(): string {
    return __bytes_to_hex(h.final_bytes());
}

// sha1_bytes / sha1_hex — the one-shot digest of `s`.
pub function sha1_bytes(s: string): u8[] {
    return sha1_new().update(s).final_bytes();
}

pub function sha1_hex(s: string): string {
    return __bytes_to_hex(sha1_new().update(s).final_bytes());
}

// === SHA-224 / SHA-256 (FIPS 180-4) — one state type, the IV and output length differ ===

pub struct Sha256 {
    h0: u32,
    h1: u32,
    h2: u32,
    h3: u32,
    h4: u32,
    h5: u32,
    h6: u32,
    h7: u32,
    // Pending partial block (64 bytes, `buf_len` of them live) and the byte count.
    buf: u8[],
    buf_len: i32,
    total: u64,
    out_len: i32
}

pub function sha256_new(): Sha256 {
    return Sha256 { h0: 0x6a09e667, h1: 0xbb67ae85, h2: 0x3c6ef372, h3: 0xa54ff53a, h4: 0x510e527f, h5: 0x9b05688c, h6: 0x1f83d9ab, h7: 0x5be0cd19,
        buf: __zero_u8(64), buf_len: 0, total: 0 as u64, out_len: 32 };
}

pub function sha224_new(): Sha256 {
    return Sha256 { h0: 0xc1059ed8, h1: 0x367cd507, h2: 0x3070dd17, h3: 0xf70e5939, h4: 0xffc00b31, h5: 0x68581511, h6: 0x64f98fa7, h7: 0xbefa4fa4,
        buf: __zero_u8(64), buf_len: 0, total: 0 as u64, out_len: 28 };
}

// __sha256_blocks folds `nblocks` 64-byte blocks of `bs`, starting at byte
