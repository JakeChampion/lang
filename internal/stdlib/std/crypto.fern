        aa = aa + ((bb >> 27) | (bb << 5)) + (cc ^ dd ^ ee) + 0xca62c1d6 + w0;
        cc = ((cc >> 2) | (cc << 30));
        w1 = (((w1 ^ w3 ^ w9 ^ w14) >> 31) | ((w1 ^ w3 ^ w9 ^ w14) << 1));
        ee = ee + ((aa >> 27) | (aa << 5)) + (bb ^ cc ^ dd) + 0xca62c1d6 + w1;
        bb = ((bb >> 2) | (bb << 30));
        w2 = (((w2 ^ w4 ^ w10 ^ w15) >> 31) | ((w2 ^ w4 ^ w10 ^ w15) << 1));
        dd = dd + ((ee >> 27) | (ee << 5)) + (aa ^ bb ^ cc) + 0xca62c1d6 + w2;
        aa = ((aa >> 2) | (aa << 30));
        w3 = (((w3 ^ w5 ^ w11 ^ w0) >> 31) | ((w3 ^ w5 ^ w11 ^ w0) << 1));
        cc = cc + ((dd >> 27) | (dd << 5)) + (ee ^ aa ^ bb) + 0xca62c1d6 + w3;
        ee = ((ee >> 2) | (ee << 30));
        w4 = (((w4 ^ w6 ^ w12 ^ w1) >> 31) | ((w4 ^ w6 ^ w12 ^ w1) << 1));
        bb = bb + ((cc >> 27) | (cc << 5)) + (dd ^ ee ^ aa) + 0xca62c1d6 + w4;
        dd = ((dd >> 2) | (dd << 30));
        w5 = (((w5 ^ w7 ^ w13 ^ w2) >> 31) | ((w5 ^ w7 ^ w13 ^ w2) << 1));
        aa = aa + ((bb >> 27) | (bb << 5)) + (cc ^ dd ^ ee) + 0xca62c1d6 + w5;
        cc = ((cc >> 2) | (cc << 30));
        w6 = (((w6 ^ w8 ^ w14 ^ w3) >> 31) | ((w6 ^ w8 ^ w14 ^ w3) << 1));
        ee = ee + ((aa >> 27) | (aa << 5)) + (bb ^ cc ^ dd) + 0xca62c1d6 + w6;
        bb = ((bb >> 2) | (bb << 30));
        w7 = (((w7 ^ w9 ^ w15 ^ w4) >> 31) | ((w7 ^ w9 ^ w15 ^ w4) << 1));
        dd = dd + ((ee >> 27) | (ee << 5)) + (aa ^ bb ^ cc) + 0xca62c1d6 + w7;
        aa = ((aa >> 2) | (aa << 30));
        w8 = (((w8 ^ w10 ^ w0 ^ w5) >> 31) | ((w8 ^ w10 ^ w0 ^ w5) << 1));
        cc = cc + ((dd >> 27) | (dd << 5)) + (ee ^ aa ^ bb) + 0xca62c1d6 + w8;
        ee = ((ee >> 2) | (ee << 30));
        w9 = (((w9 ^ w11 ^ w1 ^ w6) >> 31) | ((w9 ^ w11 ^ w1 ^ w6) << 1));
        bb = bb + ((cc >> 27) | (cc << 5)) + (dd ^ ee ^ aa) + 0xca62c1d6 + w9;
        dd = ((dd >> 2) | (dd << 30));
        w10 = (((w10 ^ w12 ^ w2 ^ w7) >> 31) | ((w10 ^ w12 ^ w2 ^ w7) << 1));
        aa = aa + ((bb >> 27) | (bb << 5)) + (cc ^ dd ^ ee) + 0xca62c1d6 + w10;
        cc = ((cc >> 2) | (cc << 30));
        w11 = (((w11 ^ w13 ^ w3 ^ w8) >> 31) | ((w11 ^ w13 ^ w3 ^ w8) << 1));
        ee = ee + ((aa >> 27) | (aa << 5)) + (bb ^ cc ^ dd) + 0xca62c1d6 + w11;
        bb = ((bb >> 2) | (bb << 30));
        w12 = (((w12 ^ w14 ^ w4 ^ w9) >> 31) | ((w12 ^ w14 ^ w4 ^ w9) << 1));
        dd = dd + ((ee >> 27) | (ee << 5)) + (aa ^ bb ^ cc) + 0xca62c1d6 + w12;
        aa = ((aa >> 2) | (aa << 30));
        w13 = (((w13 ^ w15 ^ w5 ^ w10) >> 31) | ((w13 ^ w15 ^ w5 ^ w10) << 1));
        cc = cc + ((dd >> 27) | (dd << 5)) + (ee ^ aa ^ bb) + 0xca62c1d6 + w13;
        ee = ((ee >> 2) | (ee << 30));
        w14 = (((w14 ^ w0 ^ w6 ^ w11) >> 31) | ((w14 ^ w0 ^ w6 ^ w11) << 1));
        bb = bb + ((cc >> 27) | (cc << 5)) + (dd ^ ee ^ aa) + 0xca62c1d6 + w14;
        dd = ((dd >> 2) | (dd << 30));
        w15 = (((w15 ^ w1 ^ w7 ^ w12) >> 31) | ((w15 ^ w1 ^ w7 ^ w12) << 1));
        aa = aa + ((bb >> 27) | (bb << 5)) + (cc ^ dd ^ ee) + 0xca62c1d6 + w15;
