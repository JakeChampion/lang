// std/crypto — message digests (MD5, SHA-1, SHA-224/256, SHA-384/512,
// BLAKE2b), HMAC-SHA256 (RFC 2104), PBKDF2, HKDF and HOTP/TOTP.
//
// Pure-Fern, no dependencies — suited to the fast-startup / no-deps
// posture. All arithmetic is on `u32` / `u64` (wrapping add, logical
// `>>`), so the round math is exact on every backend. Verified against
// the RFC / NIST known-answer vectors (examples/tests/digest_*_test.fern).
//
// Every digest is a STREAMING hasher — a value with `update` / `final`:
//
//   var h: crypto.Sha256 = crypto.sha256_new();
//   h = h.update(chunk);            // any length; a Reader.read_chunk piece
//   h = h.update_bytes(more);       // the [u8] form: a u8[] or a slice of one
//   var hex: string = h.final_hex();   // or final_bytes(): u8[]
//
// The hasher is an immutable value in the rebind style (docs/CURSOR-IDIOM.md):
// `h = h.update(chunk)` hands the state back to itself, and that rebind is
// what lets the compiler reuse the pending-block buffer and the state box in
// place instead of copying them per call. A state can be forked — `var h2 =
// h.update("x")` while `h` stays live — and each side then owns its own
// copy. `md5_hex(s)` / `sha256_bytes(s)` / … are the one-shot forms. SHA-224
// shares `Sha256` (`sha224_new()`) and SHA-384 shares `Sha512`
// (`sha384_new()`): same block function, different IV and output length.
// BLAKE2b takes its digest length at construction (`blake2b_new(64)`).
//
// The block functions are generated by tools/gen_digests.py (see the marker
// comments): fully unrolled rounds over locals, no arrays in the hot loop.
// MD5 and SHA-1 are here for interoperability (checksums, legacy protocols);
// neither is collision-resistant, so nothing new should be keyed on them.
//
// Bytes are `u8[]`, not `string` (#5730, decision D9): a digest is
// arbitrary bytes, so typing it as a `string` would break the
// invariant that a `string` is well-formed UTF-8. So the `*_bytes`
// digests, the KDF outputs, and every key / salt / IKM / info input
// are `u8[]`; the `*_hex` variants still return a `string`, because
// hex output genuinely is text. Inputs that are legitimately text —
// the message to hash, the password to stretch — stay `string`;
// pass a string's bytes to the byte-typed parameters with
// `std/string`'s `s.bytes()`.

// __zero_u8 builds an n-byte zeroed buffer. __alloc_u8 does NOT guarantee
// zeroed memory on the AOT backends (a reused freelist block carries stale
// bytes), so every buffer whose padding matters is zeroed explicitly.
function __zero_u8(n: i32): u8[] {
    var a: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) { a = a.with(i, 0 as u8); i = i + 1; }
    return a;
}

// __copy_in writes src[from .. from+len) over dst[at ..] and returns dst,
// consumed and rewritten in place. A `u8[]` argument lends itself as the
// `[u8]` view without a copy.
function __copy_in(own dst: u8[], at: i32, src: [u8], from: i32, len: i32): u8[] {
    var i: i32 = 0;
    while (i < len) {
        dst = dst.with(at + i, src[from + i]);
        i = i + 1;
    }
    return dst;
}

// Fixed-width word stores, big- and little-endian, in place.
function __put_be32(own d: u8[], at: i32, v: u32): u8[] {
    d = d.with(at, (v >> 24) as u8);
    d = d.with(at + 1, ((v >> 16) & 255) as u8);
    d = d.with(at + 2, ((v >> 8) & 255) as u8);
    d = d.with(at + 3, (v & 255) as u8);
    return d;
}

function __put_le32(own d: u8[], at: i32, v: u32): u8[] {
    d = d.with(at, (v & 255) as u8);
    d = d.with(at + 1, ((v >> 8) & 255) as u8);
    d = d.with(at + 2, ((v >> 16) & 255) as u8);
    d = d.with(at + 3, (v >> 24) as u8);
    return d;
}

function __put_be64(own d: u8[], at: i32, v: u64): u8[] {
    var i: i32 = 0;
    while (i < 8) {
        d = d.with(at + i, ((v >> (((7 - i) * 8) as u64)) & (255 as u64)) as u8);
        i = i + 1;
    }
    return d;
}

function __put_le64(own d: u8[], at: i32, v: u64): u8[] {
    var i: i32 = 0;
    while (i < 8) {
        d = d.with(at + i, ((v >> ((i * 8) as u64)) & (255 as u64)) as u8);
        i = i + 1;
    }
    return d;
}

// __str_to_bytes copies a raw byte string into a fresh u8[] (each
// `s[i]` is a 0..255 byte). The MAC / KDF helpers work on `u8[]` arrays
// (the same type __alloc_u8 builds for HMAC's intermediate blocks).
function __str_to_bytes(s: string): u8[] {
    var n: i32 = s.len();
    var b: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) { b = b.with(i, s[i] as u8); i = i + 1; }
    return b;
}

// __hex_char renders a nibble (0-15) as its lowercase hex character
// byte value ('0'..'9' / 'a'..'f').
function __hex_char(d: i32): i32 {
    if (d < 10) { return 48 + d; }   // '0'..'9'
    return 87 + d;                    // 10 -> 'a' (97)
}

// __bytes_to_hex renders a byte array as a lowercase hex string.
// Output is exactly 2·len bytes, so fill one preallocated buffer
// (O(n)) rather than the `out = out + …` concat chain, which recopied
// the whole prefix each step (O(n²) — the #4379 hot path). Same
// preallocated-u8[] shape hex_encode uses; byte-for-byte identical.
function __bytes_to_hex(b: u8[]): string {
    var n: i32 = b.len();
    if (n == 0) { return ""; }
    var buf: u8[] = __alloc_u8(n * 2);
    var i: i32 = 0;
    while (i < n) {
        var v: i32 = b[i] as i32;
        buf = buf.with(i * 2, __hex_char((v >> 4) & 15) as u8);
        buf = buf.with(i * 2 + 1, __hex_char(v & 15) as u8);
        i = i + 1;
    }
    return string_from_bytes_unchecked(buf);
}

