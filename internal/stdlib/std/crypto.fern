// === MD5 (RFC 1321) ===

pub struct Md5 {
    h0: u32,
    h1: u32,
    h2: u32,
    h3: u32,
    // Pending partial block (64 bytes, `buf_len` of them live) and the byte count.
    buf: u8[],
    buf_len: i32,
    total: u64,
    out_len: i32
}

pub function md5_new(): Md5 {
    return Md5 { h0: 0x67452301, h1: 0xefcdab89, h2: 0x98badcfe, h3: 0x10325476,
        buf: __zero_u8(64), buf_len: 0, total: 0 as u64, out_len: 16 };
}

