            bl = 0;
        }
    }
    var nb: i32 = (n - pos) / 64;
    if (nb > 0) {
        h = __md5_blocks(h, bs, pos, nb);
        pos = pos + nb * 64;
    }
    if (pos < n) {
        h = Md5 { ...h, buf: __copy_in(h.buf, bl, bs, pos, n - pos) };
        bl = bl + (n - pos);
    }
    return Md5 { ...h, buf_len: bl, total: h.total + (n as u64) };
}

// update / update_bytes absorb a chunk of arbitrary length — a string, or a
// `[u8]` view (a `u8[]` lends itself, `arr[a:b]` slices one). Rebind the result
// (`h = h.update(chunk)`): the state is a value, and the rebind is what lets the
// pending block be reused in place rather than copied.
pub function (h: Md5) update(chunk: string): Md5 {
    h = __md5_absorb(h, chunk.as_bytes());
    return h;
}

pub function (h: Md5) update_bytes(chunk: [u8]): Md5 {
    h = __md5_absorb(h, chunk);
    return h;
}

pub function (h: Md5) final_bytes(): u8[] {
    var bl: i32 = h.buf_len;
    var plen: i32 = 64;
    if (bl >= 56) { plen = 128; }
    var pad: u8[] = __copy_in(__zero_u8(plen), 0, h.buf, 0, bl);
    pad = pad.with(bl, 0x80 as u8);
    var bits: u64 = h.total << (3 as u64);
    pad = __put_le64(pad, plen - 8, bits);
    var st: Md5 = __md5_blocks(h, pad, 0, plen / 64);
    var out: u8[] = __alloc_u8(st.out_len);
    out = __put_le32(out, 0, st.h0);
    out = __put_le32(out, 4, st.h1);
    out = __put_le32(out, 8, st.h2);
    out = __put_le32(out, 12, st.h3);
    return out;
}

pub function (h: Md5) final_hex(): string {
    return __bytes_to_hex(h.final_bytes());
}

// md5_bytes / md5_hex — the one-shot digest of `s`.
pub function md5_bytes(s: string): u8[] {
    return md5_new().update(s).final_bytes();
}

pub function md5_hex(s: string): string {
    return __bytes_to_hex(md5_new().update(s).final_bytes());
}

// === SHA-1 (RFC 3174) ===

pub struct Sha1 {
    h0: u32,
    h1: u32,
    h2: u32,
    h3: u32,
    h4: u32,
    // Pending partial block (64 bytes, `buf_len` of them live) and the byte count.
    buf: u8[],
    buf_len: i32,
    total: u64,
    out_len: i32
}

pub function sha1_new(): Sha1 {
    return Sha1 { h0: 0x67452301, h1: 0xefcdab89, h2: 0x98badcfe, h3: 0x10325476, h4: 0xc3d2e1f0,
        buf: __zero_u8(64), buf_len: 0, total: 0 as u64, out_len: 20 };
}

// __sha1_blocks folds `nblocks` 64-byte blocks of `bs`, starting at byte
