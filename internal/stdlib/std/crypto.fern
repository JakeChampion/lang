function __sha512_absorb(own h: Sha512, bs: [u8]): Sha512 {
    var n: i32 = bs.len();
    var pos: i32 = 0;
    var bl: i32 = h.buf_len;
    if (bl > 0) {
        var take: i32 = 128 - bl;
        if (take > n) { take = n; }
        h = Sha512 { ...h, buf: __copy_in(h.buf, bl, bs, 0, take) };
        bl = bl + take;
        pos = take;
        if (bl == 128) {
            h = __sha512_blocks(h, h.buf, 0, 1);
            bl = 0;
        }
    }
    var nb: i32 = (n - pos) / 128;
    if (nb > 0) {
        h = __sha512_blocks(h, bs, pos, nb);
        pos = pos + nb * 128;
    }
    if (pos < n) {
        h = Sha512 { ...h, buf: __copy_in(h.buf, bl, bs, pos, n - pos) };
        bl = bl + (n - pos);
    }
    return Sha512 { ...h, buf_len: bl, total: h.total + (n as u64) };
}

// update / update_bytes absorb a chunk of arbitrary length — a string, or a
// `[u8]` view (a `u8[]` lends itself, `arr[a:b]` slices one). Rebind the result
// (`h = h.update(chunk)`): the state is a value, and the rebind is what lets the
// pending block be reused in place rather than copied.
pub function (h: Sha512) update(chunk: string): Sha512 {
    h = __sha512_absorb(h, chunk.as_bytes());
    return h;
}

pub function (h: Sha512) update_bytes(chunk: [u8]): Sha512 {
    h = __sha512_absorb(h, chunk);
    return h;
}

pub function (h: Sha512) final_bytes(): u8[] {
    var bl: i32 = h.buf_len;
    var plen: i32 = 128;
    if (bl >= 112) { plen = 256; }
    var pad: u8[] = __copy_in(__zero_u8(plen), 0, h.buf, 0, bl);
    pad = pad.with(bl, 0x80 as u8);
    var bits: u64 = h.total << (3 as u64);
    pad = __put_be64(pad, plen - 8, bits);
    var st: Sha512 = __sha512_blocks(h, pad, 0, plen / 128);
    var out: u8[] = __alloc_u8(st.out_len);
    out = __put_be64(out, 0, st.h0);
    out = __put_be64(out, 8, st.h1);
    out = __put_be64(out, 16, st.h2);
    out = __put_be64(out, 24, st.h3);
    out = __put_be64(out, 32, st.h4);
    out = __put_be64(out, 40, st.h5);
    if (st.out_len >= 56) { out = __put_be64(out, 48, st.h6); }
    if (st.out_len >= 64) { out = __put_be64(out, 56, st.h7); }
    return out;
}

pub function (h: Sha512) final_hex(): string {
    return __bytes_to_hex(h.final_bytes());
}

// sha512_bytes / sha512_hex — the one-shot digest of `s`.
pub function sha512_bytes(s: string): u8[] {
    return sha512_new().update(s).final_bytes();
}

pub function sha512_hex(s: string): string {
    return __bytes_to_hex(sha512_new().update(s).final_bytes());
}

// sha384_bytes / sha384_hex — the one-shot digest of `s`.
pub function sha384_bytes(s: string): u8[] {
    return sha384_new().update(s).final_bytes();
}

pub function sha384_hex(s: string): string {
    return __bytes_to_hex(sha384_new().update(s).final_bytes());
}

// === BLAKE2b (RFC 7693), unkeyed, digest length 1..64 bytes ===

pub struct Blake2b {
    h0: u64,
    h1: u64,
    h2: u64,
    h3: u64,
    h4: u64,
    h5: u64,
    h6: u64,
    h7: u64,
    // Pending block (up to 128 bytes live) and the count of bytes already
    // compressed — BLAKE2b holds a full block back until more input arrives,
    // since the last block is compressed with the final flag set.
    buf: u8[],
    buf_len: i32,
    total: u64,
    out_len: i32
}

// blake2b_new(out_len) — a hasher producing an `out_len`-byte digest (1..64).
// b2sum's default is 64; `-l N` is N bits, so pass N / 8.
pub function blake2b_new(out_len: i32): Blake2b {
    var n: i32 = out_len;
    if (n < 1) { n = 1; }
    if (n > 64) { n = 64; }
    var h: Blake2b = Blake2b { h0: (0x6a09e667f3bcc908 as u64), h1: (0xbb67ae8584caa73b as u64), h2: (0x3c6ef372fe94f82b as u64), h3: (0xa54ff53a5f1d36f1 as u64), h4: (0x510e527fade682d1 as u64), h5: (0x9b05688c2b3e6c1f as u64), h6: (0x1f83d9abfb41bd6b as u64), h7: (0x5be0cd19137e2179 as u64),
        buf: __zero_u8(128), buf_len: 0, total: 0 as u64, out_len: n };
    // Parameter block word 0: digest length, key length 0, fanout 1, depth 1.
    return Blake2b { ...h, h0: h.h0 ^ (0x01010000 as u64) ^ (n as u64) };
}

// __blake2b_blocks compresses `nblocks` 128-byte blocks of `bs` from byte
// `from`; `t` is the byte counter after the first of them (it advances 128 per
// block) and `last` marks the final block of the message. Generated, like the
// SHA cores: the 12 rounds are unrolled over 16 state locals and 16 message
// locals with the sigma permutation applied at generation time.
function __blake2b_blocks(st: Blake2b, bs: [u8], from: i32, nblocks: i32, t: u64, last: boolean): Blake2b {
    var h0: u64 = st.h0;
    var h1: u64 = st.h1;
    var h2: u64 = st.h2;
    var h3: u64 = st.h3;
    var h4: u64 = st.h4;
    var h5: u64 = st.h5;
    var h6: u64 = st.h6;
    var h7: u64 = st.h7;
    var m0: u64 = 0 as u64;
    var m1: u64 = 0 as u64;
    var m2: u64 = 0 as u64;
    var m3: u64 = 0 as u64;
    var m4: u64 = 0 as u64;
    var m5: u64 = 0 as u64;
    var m6: u64 = 0 as u64;
    var m7: u64 = 0 as u64;
    var m8: u64 = 0 as u64;
    var m9: u64 = 0 as u64;
    var m10: u64 = 0 as u64;
    var m11: u64 = 0 as u64;
    var m12: u64 = 0 as u64;
    var m13: u64 = 0 as u64;
    var m14: u64 = 0 as u64;
    var m15: u64 = 0 as u64;
    var v0: u64 = 0 as u64;
    var v1: u64 = 0 as u64;
    var v2: u64 = 0 as u64;
    var v3: u64 = 0 as u64;
    var v4: u64 = 0 as u64;
    var v5: u64 = 0 as u64;
    var v6: u64 = 0 as u64;
    var v7: u64 = 0 as u64;
    var v8: u64 = 0 as u64;
    var v9: u64 = 0 as u64;
    var v10: u64 = 0 as u64;
    var v11: u64 = 0 as u64;
    var v12: u64 = 0 as u64;
    var v13: u64 = 0 as u64;
    var v14: u64 = 0 as u64;
    var v15: u64 = 0 as u64;
    var counter: u64 = t;
    var off: i32 = from;
    var blk: i32 = 0;
    while (blk < nblocks) {
        m0 = (bs[off] as u64) | ((bs[off + 1] as u64) << (8 as u64)) | ((bs[off + 2] as u64) << (16 as u64)) | ((bs[off + 3] as u64) << (24 as u64)) | ((bs[off + 4] as u64) << (32 as u64)) | ((bs[off + 5] as u64) << (40 as u64)) | ((bs[off + 6] as u64) << (48 as u64)) | ((bs[off + 7] as u64) << (56 as u64));
