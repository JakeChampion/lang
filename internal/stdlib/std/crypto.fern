function __blake2b_absorb(own h: Blake2b, bs: [u8]): Blake2b {
    var n: i32 = bs.len();
    if (n == 0) { return h; }
    var pos: i32 = 0;
    var bl: i32 = h.buf_len;
    var total: u64 = h.total;
    // Only compress once the input runs past a full block: the block that
    // ends the message must be the one compressed with `last` set.
    if (bl + n > 128) {
        var take: i32 = 128 - bl;
        if (take > 0) { h = Blake2b { ...h, buf: __copy_in(h.buf, bl, bs, 0, take) }; }
        total = total + (128 as u64);
        h = __blake2b_blocks(h, h.buf, 0, 1, total, false);
        bl = 0;
        pos = take;
        var nb: i32 = (n - pos - 1) / 128;
        if (nb > 0) {
            h = __blake2b_blocks(h, bs, pos, nb, total + (128 as u64), false);
            total = total + ((nb * 128) as u64);
            pos = pos + nb * 128;
        }
    }
    h = Blake2b { ...h, buf: __copy_in(h.buf, bl, bs, pos, n - pos) };
    return Blake2b { ...h, buf_len: bl + (n - pos), total: total };
}

// update / update_bytes absorb a chunk of arbitrary length — a string, or a
// `[u8]` view (a `u8[]` lends itself, `arr[a:b]` slices one). Rebind the result
// (`h = h.update(chunk)`): the state is a value, and the rebind is what lets the
// pending block be reused in place rather than copied.
pub function (h: Blake2b) update(chunk: string): Blake2b {
    h = __blake2b_absorb(h, chunk.as_bytes());
    return h;
}

pub function (h: Blake2b) update_bytes(chunk: [u8]): Blake2b {
    h = __blake2b_absorb(h, chunk);
    return h;
}

pub function (h: Blake2b) final_bytes(): u8[] {
    var bl: i32 = h.buf_len;
    // The tail of the block must be zero; the buffer may hold stale bytes.
    var pad: u8[] = __copy_in(__zero_u8(128), 0, h.buf, 0, bl);
    var st: Blake2b = __blake2b_blocks(h, pad, 0, 1, h.total + (bl as u64), true);
    var full: u8[] = __alloc_u8(64);
    full = __put_le64(full, 0, st.h0);
    full = __put_le64(full, 8, st.h1);
    full = __put_le64(full, 16, st.h2);
    full = __put_le64(full, 24, st.h3);
    full = __put_le64(full, 32, st.h4);
    full = __put_le64(full, 40, st.h5);
    full = __put_le64(full, 48, st.h6);
    full = __put_le64(full, 56, st.h7);
    if (st.out_len == 64) { return full; }
    return __copy_in(__alloc_u8(st.out_len), 0, full, 0, st.out_len);
}

pub function (h: Blake2b) final_hex(): string {
    return __bytes_to_hex(h.final_bytes());
}

// blake2b_bytes / blake2b_hex — the one-shot `out_len`-byte digest of `s`.
pub function blake2b_bytes(s: string, out_len: i32): u8[] {
    return blake2b_new(out_len).update(s).final_bytes();
}

pub function blake2b_hex(s: string, out_len: i32): string {
    return __bytes_to_hex(blake2b_new(out_len).update(s).final_bytes());
}

// <<< generated

// __sha256_core hashes a byte array and returns the 32-byte digest — the
// form HMAC's block arithmetic wants.
function __sha256_core(msg: u8[]): u8[] {
    return sha256_new().update_bytes(msg).final_bytes();
}

// size: keys longer than 64 bytes are hashed first, then all keys are
// zero-padded to 64 bytes.
function __block_key(key: u8[]): u8[] {
    var k: u8[] = key;
    if (key.len() > 64) { k = __sha256_core(key); }
    // Zero the block explicitly (key padding) — __alloc_u8 isn't guaranteed
    // zeroed on the AOT backends.
    var out: u8[] = __alloc_u8(64);
    var z: i32 = 0;
    while (z < 64) { out = out.with(z, 0 as u8); z = z + 1; }
    var i: i32 = 0;
    while (i < k.len()) { out = out.with(i, k[i]); i = i + 1; }
    return out;
}

// __hmac_core computes HMAC-SHA256(key, msg) and returns the 32-byte
// digest. inner = H((k0 ^ ipad) || msg); out = H((k0 ^ opad) || inner).
function __hmac_core(key: u8[], msg: u8[]): u8[] {
    var k0: u8[] = __block_key(key);
    // Inner block: (k0 ^ 0x36) followed by the message.
    var inner: u8[] = __alloc_u8(64 + msg.len());
    var i: i32 = 0;
    while (i < 64) { inner = inner.with(i, ((k0[i] as i32) ^ 0x36) as u8); i = i + 1; }
    var j: i32 = 0;
    while (j < msg.len()) { inner = inner.with(64 + j, msg[j]); j = j + 1; }
    var inner_hash: u8[] = __sha256_core(inner);
    // Outer block: (k0 ^ 0x5c) followed by the inner hash (32 bytes).
    var outer: u8[] = __alloc_u8(64 + 32);
    i = 0;
    while (i < 64) { outer = outer.with(i, ((k0[i] as i32) ^ 0x5c) as u8); i = i + 1; }
    j = 0;
    while (j < 32) { outer = outer.with(64 + j, inner_hash[j]); j = j + 1; }
    return __sha256_core(outer);
}

// hmac_sha256_bytes returns the raw 32-byte HMAC-SHA256 digest.
pub function hmac_sha256_bytes(key: u8[], msg: string): u8[] {
    return __hmac_core(key, __str_to_bytes(msg));
}

// hmac_sha256_hex returns the HMAC-SHA256 digest as a 64-character
// lowercase hex string.
pub function hmac_sha256_hex(key: u8[], msg: string): string {
    return __bytes_to_hex(__hmac_core(key, __str_to_bytes(msg)));
}

// consteq compares two byte arrays in CONSTANT TIME with respect to their
// contents — it never short-circuits on the first differing byte, so an
// attacker can't time a MAC/token check to recover the expected value one
// byte at a time (#4384). A plain `a == b` bails at the first mismatch and
// leaks that position. Use this to compare a computed MAC against an
// attacker-supplied one; to compare two secrets that really are text (an
// API token, a hex digest), pass `s.bytes()` from `std/string`. The
// lengths themselves are not secret (MACs are fixed-length), so a length
// mismatch is folded into the accumulator and returns false; equal-length
// inputs are compared with no data-dependent branch or exit.
pub function consteq(a: u8[], b: u8[]): boolean {
    var la: i32 = a.len();
    var lb: i32 = b.len();
    var diff: i32 = la ^ lb;
    var n: i32 = la;
    if (lb < n) { n = lb; }
    var i: i32 = 0;
    while (i < n) {
        diff = diff | ((a[i] as i32) ^ (b[i] as i32));
        i = i + 1;
    }
    return diff == 0;
}

// hmac_verify returns true iff `mac` (raw 32-byte HMAC-SHA256) is the correct
// MAC for (key, msg). The comparison is constant-time (consteq), so verifying
// an attacker-supplied MAC is not a timing oracle — this is the safe way to
// check a MAC, unlike `hmac_sha256_bytes(key, msg) == mac`.
pub function hmac_verify(key: u8[], msg: string, mac: u8[]): boolean {
    return consteq(hmac_sha256_bytes(key, msg), mac);
}

// hmac_verify_hex is hmac_verify for a hex-encoded MAC (64 lowercase hex
// chars). The constant-time compare runs over the hex text.
pub function hmac_verify_hex(key: u8[], msg: string, mac_hex: string): boolean {
    return consteq(__str_to_bytes(hmac_sha256_hex(key, msg)), __str_to_bytes(mac_hex));
}

// === PBKDF2-HMAC-SHA256 (RFC 8018 / RFC 2898) ===
//
// Password-based key derivation: stretch a low-entropy password into a
// `dk_len`-byte key by iterating HMAC-SHA256 `iterations` times per
// output block. Use a random per-password salt and a high iteration
// count (tens of thousands+) for password storage. Verified against the
// standard PBKDF2-HMAC-SHA256 known-answer vectors.

// __pbkdf2_core derives `dk_len` bytes. For block i (1-based):
//   U1 = HMAC(pw, salt || INT32_BE(i)); Uj = HMAC(pw, U(j-1));
//   T_i = U1 xor U2 xor … xor U_iterations. DK = T_1 || T_2 || … .
function __pbkdf2_core(pw: u8[], salt: u8[], iterations: i32, dk_len: i32): u8[] {
    var hLen: i32 = 32;                 // SHA-256 output size
    var dk: u8[] = __alloc_u8(dk_len);
    var offset: i32 = 0;
    var block_index: i32 = 1;
    while (offset < dk_len) {
        // msg = salt || INT32_BE(block_index)
        var msg: u8[] = __alloc_u8(salt.len() + 4);
        var s: i32 = 0;
        while (s < salt.len()) { msg = msg.with(s, salt[s]); s = s + 1; }
        msg = msg.with(salt.len(), ((block_index >> 24) & 255) as u8);
        msg = msg.with(salt.len() + 1, ((block_index >> 16) & 255) as u8);
        msg = msg.with(salt.len() + 2, ((block_index >> 8) & 255) as u8);
        msg = msg.with(salt.len() + 3, (block_index & 255) as u8);
        var u: u8[] = __hmac_core(pw, msg);
        var t: u8[] = u;                // T = U1
        var c: i32 = 1;
        while (c < iterations) {
            u = __hmac_core(pw, u);
            var nt: u8[] = __alloc_u8(hLen);
            var x: i32 = 0;
            while (x < hLen) {
                nt = nt.with(x, ((t[x] as i32) ^ (u[x] as i32)) as u8);
                x = x + 1;
            }
            t = nt;
            c = c + 1;
        }
        var k: i32 = 0;
        while (k < hLen && offset + k < dk_len) {
            dk = dk.with(offset + k, t[k]);
            k = k + 1;
        }
        offset = offset + hLen;
        block_index = block_index + 1;
    }
    return dk;
}

// pbkdf2_sha256(password, salt, iterations, dk_len) — the derived key,
// `dk_len` bytes.
pub function pbkdf2_sha256(password: string, salt: u8[], iterations: i32, dk_len: i32): u8[] {
    return __pbkdf2_core(__str_to_bytes(password), salt, iterations, dk_len);
}

// pbkdf2_sha256_hex — the derived key as a lowercase hex string
// (`2 * dk_len` characters).
pub function pbkdf2_sha256_hex(password: string, salt: u8[], iterations: i32, dk_len: i32): string {
    return __bytes_to_hex(__pbkdf2_core(__str_to_bytes(password), salt, iterations, dk_len));
}

// pbkdf2_verify(password, salt, iterations, expected) — re-derive the key
// for `password` and compare it, IN CONSTANT TIME (consteq), against the
// stored `expected` bytes. This is the correct way to verify a password:
// a plain `pbkdf2_sha256(...) == expected` short-circuits at the first
// differing byte and is a timing oracle that leaks the stored key one
// byte at a time — the same data-obliviousness rule that governs the KDF
// itself. `dk_len` is taken from `expected`'s length. The derivation is
// already oblivious to the password's byte *values* (SHA-256 word ops
// only), so this check adds no new leak beyond `expected`'s length.
pub function pbkdf2_verify(password: string, salt: u8[], iterations: i32, expected: u8[]): boolean {
    return consteq(pbkdf2_sha256(password, salt, iterations, expected.len()), expected);
}

// pbkdf2_verify_hex — pbkdf2_verify for a hex-encoded stored key. The
// constant-time compare runs over the hex text; `dk_len` is
// `expected_hex.len() / 2`.
pub function pbkdf2_verify_hex(password: string, salt: u8[], iterations: i32, expected_hex: string): boolean {
    return consteq(__str_to_bytes(pbkdf2_sha256_hex(password, salt, iterations, expected_hex.len() / 2)), __str_to_bytes(expected_hex));
}

// === HKDF-SHA256 (RFC 5869) ===
//
// The HMAC-based key-derivation function: turn input keying material
// (IKM) into one or more cryptographically strong subkeys. Two steps —
// EXTRACT concentrates the entropy of IKM into a fixed-length pseudo-
// random key (PRK); EXPAND stretches the PRK into `length` output bytes
// bound to an application-specific `info` label. Unlike PBKDF2 (which
// stretches a low-entropy PASSWORD with many iterations), HKDF assumes
// already-high-entropy IKM (a shared secret, a random key) and is fast.
// Built on the same HMAC-SHA256 core; verified against the RFC 5869
// known-answer vectors.

// hkdf_extract(salt, ikm) — the 32-byte PRK. PRK = HMAC(salt, IKM); an
// empty salt is replaced by hLen (32) zero bytes, per RFC 5869 §2.2.
pub function hkdf_extract(salt: u8[], ikm: u8[]): u8[] {
    var s: u8[] = salt;
    if (salt.len() == 0) {
        s = __alloc_u8(32);
        var i: i32 = 0;
        while (i < 32) { s = s.with(i, 0 as u8); i = i + 1; }
    }
    return __hmac_core(s, ikm);
}

// hkdf_expand(prk, info, length) — `length` output bytes from a PRK.
// OKM = T(1) || T(2) || … truncated to `length`, where
// T(i) = HMAC(PRK, T(i-1) || info || byte(i)) and T(0) is empty
// (RFC 5869 §2.3). `length` must be ≤ 255*32 (the counter is one byte).
pub function hkdf_expand(prk: u8[], info: u8[], length: i32): u8[] {
    var hLen: i32 = 32;
    var okm: u8[] = __alloc_u8(length);
    var t: u8[] = [];               // T(0)
    var offset: i32 = 0;
    var i: i32 = 1;
    while (offset < length) {
        var msg: u8[] = __alloc_u8(t.len() + info.len() + 1);
        var p: i32 = 0;
        var k: i32 = 0;
        while (k < t.len())    { msg = msg.with(p, t[k]);    p = p + 1; k = k + 1; }
        k = 0;
        while (k < info.len()) { msg = msg.with(p, info[k]); p = p + 1; k = k + 1; }
        msg = msg.with(p, (i & 255) as u8);
        t = __hmac_core(prk, msg);
        var c: i32 = 0;
        while (c < hLen && offset + c < length) { okm = okm.with(offset + c, t[c]); c = c + 1; }
        offset = offset + hLen;
        i = i + 1;
    }
    return okm;
}

// hkdf_sha256(salt, ikm, info, length) — the one-shot extract-then-
// expand: derive `length` bytes of keying material from `ikm`.
pub function hkdf_sha256(salt: u8[], ikm: u8[], info: u8[], length: i32): u8[] {
    return hkdf_expand(hkdf_extract(salt, ikm), info, length);
}

// hkdf_sha256_hex — the one-shot HKDF as a lowercase hex string.
pub function hkdf_sha256_hex(salt: u8[], ikm: u8[], info: u8[], length: i32): string {
    return __bytes_to_hex(hkdf_expand(hkdf_extract(salt, ikm), info, length));
}

// === HOTP / TOTP (RFC 4226 / RFC 6238), HMAC-SHA256 ===
//
// One-time passwords for 2FA. HOTP is counter-based; TOTP is HOTP over a
// time-step counter. This uses HMAC-SHA256 (RFC 6238's SHA-256 mode) —
// pass the RAW secret bytes as `key` (base32-decode a base32 secret
// with std/base32 first). Returns the OTP as an integer; the caller
// zero-pads it to `digits` for display.

// hotp_sha256(key, counter, digits) — counter-based one-time password,
// with dynamic truncation (RFC 4226 §5.3 / §5.4) using the last nibble
// of the 32-byte HMAC-SHA256 digest as the offset. Returns a
// `digits`-digit code.
pub function hotp_sha256(key: u8[], counter: i64, digits: i32): i32 {
    // 8-byte big-endian counter.
    var msg: u8[] = __alloc_u8(8);
    var i: i32 = 0;
    while (i < 8) {
        var shift: i64 = ((7 - i) * 8) as i64;
        msg = msg.with(i, ((counter >> shift) & (255 as i64)) as u8);
        i = i + 1;
    }
    var hs: u8[] = __hmac_core(key, msg);
    var offset: i32 = (hs[hs.len() - 1] as i32) & 15;
    // 31-bit dynamic-truncation value (top bit masked → stays non-negative).
    var bin: i32 = (((hs[offset] as i32) & 127) << 24)
                 | ((hs[offset + 1] as i32) << 16)
                 | ((hs[offset + 2] as i32) << 8)
                 | (hs[offset + 3] as i32);
    var m: i32 = 1;
    var d: i32 = 0;
    while (d < digits) { m = m * 10; d = d + 1; }
    return bin % m;
}

// totp_sha256(key, unix_time, period, digits) — time-based one-time
// password: HOTP over the time-step counter `floor(unix_time / period)`
// (period is the step in seconds, typically 30).
pub function totp_sha256(key: u8[], unix_time: i64, period: i32, digits: i32): i32 {
    var counter: i64 = unix_time / (period as i64);
    return hotp_sha256(key, counter, digits);
}
