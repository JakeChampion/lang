function __sha256_absorb(own h: Sha256, bs: [u8]): Sha256 {
    var n: i32 = bs.len();
    var pos: i32 = 0;
    var bl: i32 = h.buf_len;
    if (bl > 0) {
        var take: i32 = 64 - bl;
        if (take > n) { take = n; }
        h = Sha256 { ...h, buf: __copy_in(h.buf, bl, bs, 0, take) };
        bl = bl + take;
        pos = take;
        if (bl == 64) {
            h = __sha256_blocks(h, h.buf, 0, 1);
            bl = 0;
        }
    }
    var nb: i32 = (n - pos) / 64;
    if (nb > 0) {
        h = __sha256_blocks(h, bs, pos, nb);
        pos = pos + nb * 64;
    }
    if (pos < n) {
        h = Sha256 { ...h, buf: __copy_in(h.buf, bl, bs, pos, n - pos) };
        bl = bl + (n - pos);
    }
    return Sha256 { ...h, buf_len: bl, total: h.total + (n as u64) };
}

// update / update_bytes absorb a chunk of arbitrary length — a string, or a
// `[u8]` view (a `u8[]` lends itself, `arr[a:b]` slices one). Rebind the result
// (`h = h.update(chunk)`): the state is a value, and the rebind is what lets the
// pending block be reused in place rather than copied.
pub function (h: Sha256) update(chunk: string): Sha256 {
    h = __sha256_absorb(h, chunk.as_bytes());
    return h;
}

pub function (h: Sha256) update_bytes(chunk: [u8]): Sha256 {
    h = __sha256_absorb(h, chunk);
    return h;
}

pub function (h: Sha256) final_bytes(): u8[] {
    var bl: i32 = h.buf_len;
    var plen: i32 = 64;
    if (bl >= 56) { plen = 128; }
    var pad: u8[] = __copy_in(__zero_u8(plen), 0, h.buf, 0, bl);
    pad = pad.with(bl, 0x80 as u8);
    var bits: u64 = h.total << (3 as u64);
    pad = __put_be64(pad, plen - 8, bits);
    var st: Sha256 = __sha256_blocks(h, pad, 0, plen / 64);
    var out: u8[] = __alloc_u8(st.out_len);
    out = __put_be32(out, 0, st.h0);
    out = __put_be32(out, 4, st.h1);
    out = __put_be32(out, 8, st.h2);
    out = __put_be32(out, 12, st.h3);
    out = __put_be32(out, 16, st.h4);
    out = __put_be32(out, 20, st.h5);
    out = __put_be32(out, 24, st.h6);
    if (st.out_len >= 32) { out = __put_be32(out, 28, st.h7); }
    return out;
}

pub function (h: Sha256) final_hex(): string {
    return __bytes_to_hex(h.final_bytes());
}

// sha256_bytes / sha256_hex — the one-shot digest of `s`.
pub function sha256_bytes(s: string): u8[] {
    return sha256_new().update(s).final_bytes();
}

pub function sha256_hex(s: string): string {
    return __bytes_to_hex(sha256_new().update(s).final_bytes());
}

// sha224_bytes / sha224_hex — the one-shot digest of `s`.
pub function sha224_bytes(s: string): u8[] {
    return sha224_new().update(s).final_bytes();
}

pub function sha224_hex(s: string): string {
    return __bytes_to_hex(sha224_new().update(s).final_bytes());
}

// === SHA-384 / SHA-512 (FIPS 180-4) — u64 arithmetic, 128-byte blocks ===

pub struct Sha512 {
    h0: u64,
    h1: u64,
    h2: u64,
    h3: u64,
    h4: u64,
    h5: u64,
    h6: u64,
    h7: u64,
    // Pending partial block (128 bytes, `buf_len` of them live) and the byte count.
    buf: u8[],
    buf_len: i32,
    total: u64,
    out_len: i32
}

pub function sha512_new(): Sha512 {
    return Sha512 { h0: (0x6a09e667f3bcc908 as u64), h1: (0xbb67ae8584caa73b as u64), h2: (0x3c6ef372fe94f82b as u64), h3: (0xa54ff53a5f1d36f1 as u64), h4: (0x510e527fade682d1 as u64), h5: (0x9b05688c2b3e6c1f as u64), h6: (0x1f83d9abfb41bd6b as u64), h7: (0x5be0cd19137e2179 as u64),
        buf: __zero_u8(128), buf_len: 0, total: 0 as u64, out_len: 64 };
}

pub function sha384_new(): Sha512 {
    return Sha512 { h0: (0xcbbb9d5dc1059ed8 as u64), h1: (0x629a292a367cd507 as u64), h2: (0x9159015a3070dd17 as u64), h3: (0x152fecd8f70e5939 as u64), h4: (0x67332667ffc00b31 as u64), h5: (0x8eb44a8768581511 as u64), h6: (0xdb0c2e0d64f98fa7 as u64), h7: (0x47b5481dbefa4fa4 as u64),
        buf: __zero_u8(128), buf_len: 0, total: 0 as u64, out_len: 48 };
}

