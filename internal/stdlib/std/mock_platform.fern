// std/mock_platform — a Platform that records instead of acting
// (docs/PLATFORM-RESEARCH.md Rec §6).
//
// A handler can only reach the effects its bag carries, so substituting the
// bag is the whole test seam: hand `handle` a mock, run it, and read back
// what it tried to do.
//
//     var m: MockPlatform = mock_platform_new();
//     var resp: HttpResponse = handle(req, m.as_platform());
//
//     assert_eq(resp.status, 200);
//     assert_eq(m.call_count(), 2);
//     assert_eq(m.calls()[0].name, "log");
//
// The recorded calls live in a `Cell[string]` the mock and the bag share —
// one cell, two views — because a cell is the language's shared-mutable box
// and its element must be a scalar or a string (E057). `calls()` parses that
// log back into `MockCall` values; the mock itself stays a value you can
// pass around.
//
// What a mocked capability RETURNS is fixed today: `now_ms` and
// `elapsed_ns` answer 0, `env` answers None, `random_i32` answers 0, `log`
// swallows the line, and `fetch` answers -1 — the value a real fetch gives
// for a host it could not reach, so a handler that already handles a failed
// fetch handles a mocked one. Canned per-call responses are the next slice;
// they want a second cell and a lookup, not a different shape.

import "std/string";
import "std/platform";

// `mock_platform_new()` — a fresh mock with an empty log.
pub function mock_platform_new(): MockPlatform {
    return MockPlatform { sink: cell_new("") };
}

// `(m: MockPlatform).as_platform()` — the bag to hand a handler. It carries
// the mock's own sink, so every capability call the handler makes lands in
// `m`'s log rather than on the host.
pub function (m: MockPlatform) as_platform(): Platform {
    return platform.platform_mock(m.sink);
}

// `(m: MockPlatform).record(name, args)` — append an entry by hand, for a
// test that wants to drive the log directly rather than through a handler.
// Mutates through the shared cell: the mock is a value, its log is not.
pub function (m: MockPlatform) record(name: string, args: string): void {
    m.as_platform().record(name, args);
}

// `(m: MockPlatform).calls()` — the recorded calls, in order.
pub function (m: MockPlatform) calls(): MockCall[] {
    var out: MockCall[] = [];
    var log: string = m.sink.get();
    var lines: string[] = log.split("\n");
    var i: i32 = 0;
    while (i < lines.len()) {
        var line: string = lines[i];
        i = i + 1;
        if (line.len() == 0) { continue; }
        var tab: i32 = line.index_of("\t");
        if (tab < 0) {
            out = out.append(MockCall { name: line, args: "" });
            continue;
        }
        out = out.append(MockCall {
            name: slice_unchecked(line, 0, tab) + "",
            args: slice_unchecked(line, tab + 1, line.len()) + ""
        });
    }
    return out;
}

// `(m: MockPlatform).call_count()` — how many calls were recorded.
pub function (m: MockPlatform) call_count(): i32 {
    return m.calls().len();
}

// `(m: MockPlatform).reset()` — drop the log. Mutates through the shared
// cell, so a bag already handed to a handler keeps recording into the
// now-empty log rather than into a stale one.
pub function (m: MockPlatform) reset(): void {
    m.sink.set("");
}

// `(m: MockPlatform).has_call(name)` — did this effect happen at all?
// Less precise than indexing `calls()`, and the right question when the
// test cares that something was reached, not when.
pub function (m: MockPlatform) has_call(name: string): boolean {
    var cs: MockCall[] = m.calls();
    var i: i32 = 0;
    while (i < cs.len()) {
        if (cs[i].name == name) { return true; }
        i = i + 1;
    }
    return false;
}

// `(m: MockPlatform).find_call(name)` — the first call with this name, for
// a test that wants its arguments without pinning its position.
pub function (m: MockPlatform) find_call(name: string): Option[MockCall] {
    var cs: MockCall[] = m.calls();
    var i: i32 = 0;
    while (i < cs.len()) {
        if (cs[i].name == name) { return Some(cs[i]); }
        i = i + 1;
    }
    return None;
}
