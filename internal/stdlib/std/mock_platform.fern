// std/mock_platform — a Platform that records instead of acting
// (docs/PLATFORM-RESEARCH.md Rec §6).
//
// A handler can only reach the effects its bag carries, so substituting the
// bag is the whole test seam: hand `handle` a mock, run it, and read back
// what it tried to do.
//
//     var m: MockPlatform = mock_platform_new();
//     var resp: HttpResponse = handle(req, m.as_platform());
//
//     assert_eq(resp.status, 200);
//     assert_eq(m.call_count(), 2);
//     assert_eq(m.calls()[0].name, "log");
//
// The recorded calls live in a `Cell[string]` the mock and the bag share —
// one cell, two views — because a cell is the language's shared-mutable box
// and its element must be a scalar or a string (E057). `calls()` parses that
// log back into `MockCall` values; the mock itself stays a value you can
// pass around.
//
// What a mocked capability RETURNS is what the test canned for it, or a
// fixed value: `env_set`, `config_set`, `secret_set`, `now_set`,
// `elapsed_set`, `random_set` and `fetch_set` record an answer the bag gives
// from then on; otherwise `now_ms` and `elapsed_ns` answer 0, `env`,
// `config` and `secret` answer None, `random_i32`
// answers 0, `log` discards the line, and `fetch` answers -1 — the value a
// real fetch gives for a host it could not reach, so a handler that
// already handles a failed fetch handles a mocked one. A canned answer is
// a row of the same cell the log lives in, which `calls()` skips and
// `reset()` keeps.
import "std/string";
import "std/platform";

// `mock_platform_new()` — a fresh mock with an empty log.
pub function mock_platform_new(): MockPlatform {
  return MockPlatform { sink: cell_new("") };
}

// `(m: MockPlatform).as_platform()` — the bag to hand a handler. It carries
// the mock's own sink, so every capability call the handler makes lands in
// `m`'s log rather than on the host.
pub function (m: MockPlatform) as_platform(): Platform {
  return platform.platform_mock(m.sink);
}

// `(m: MockPlatform).record(name, args)` — append an entry by hand, for a
// test that wants to drive the log directly rather than through a handler.
// Mutates through the shared cell: the mock is a value, its log is not.
pub function (m: MockPlatform) record(name: string, args: string): void {
  m.as_platform().record(name, args);
}

// `(m: MockPlatform).env_set(name, value)` — `plat.env(name)` answers
// `Some(value)` from now on.
pub function (m: MockPlatform) env_set(name: string, value: string): void {
  m.as_platform().can("env " + name, value);
}

// `(m: MockPlatform).config_set(name, value)` — `plat.config(name)` answers
// `Some(value)` from now on.
pub function (m: MockPlatform) config_set(name: string, value: string): void {
  m.as_platform().can("config " + name, value);
}

// `(m: MockPlatform).secret_set(name, value)` — `plat.secret(name)` answers
// `Some(value)` from now on. The value is held with the canned answers,
// which `calls()` never returns.
pub function (m: MockPlatform) secret_set(name: string, value: string): void {
  m.as_platform().can("secret " + name, value);
}

// `(m: MockPlatform).now_set(ms)` — `plat.now_ms()` answers `ms`.
pub function (m: MockPlatform) now_set(ms: i64): void {
  m.as_platform().can("now_ms", ms.to_string());
}

// `(m: MockPlatform).elapsed_set(ns)` — `plat.elapsed_ns()` answers `ns`.
pub function (m: MockPlatform) elapsed_set(ns: i64): void {
  m.as_platform().can("elapsed_ns", ns.to_string());
}

// `(m: MockPlatform).random_set(v)` — `plat.random_i32()` answers `v`.
pub function (m: MockPlatform) random_set(v: i32): void {
  m.as_platform().can("random_i32", v.to_string());
}

// `(m: MockPlatform).fetch_set(host, port, path, status)` —
// `plat.fetch(host, port, path)` answers `status` for that host, port and
// path; any other fetch still answers -1.
pub function (m: MockPlatform) fetch_set(host: string, port: i32, path: string, status: i32): void {
  m.as_platform().can("fetch " + host + ":" + port.to_string() + " " + path, status.to_string());
}

// `(m: MockPlatform).calls()` — the recorded calls, in order; the canned
// answers sharing the cell are not calls.
pub function (m: MockPlatform) calls(): MockCall[] {
  var out: MockCall[] = [];
  var log: string = m.sink.get();
  var lines: string[] = log.split("\n");
  var i: i32 = 0;
  while (i < lines.len()) {
    var line: string = lines[i];
    i = i + 1;
    if (line.len() == 0) {
      continue;
    }
    var tab: i32 = line.index_of("\t");
    if (tab < 0) {
      out = out.append(MockCall { name: line, args: "" });
      continue;
    }
    if (slice_unchecked(line, 0, tab) + "" == "canned") {
      continue;
    }
    out = out.append(MockCall {
      name: slice_unchecked(line, 0, tab) + "",
      args: slice_unchecked(line, tab + 1, line.len()) + "",
    });
  }
  return out;
}

// `(m: MockPlatform).call_count()` — how many calls were recorded.
pub function (m: MockPlatform) call_count(): i32 {
  return m.calls().len();
}

// `(m: MockPlatform).reset()` — drop the log, keeping the canned answers.
// Mutates through the shared cell, so a bag already handed to a handler
// keeps recording into the now-empty log rather than into a stale one.
pub function (m: MockPlatform) reset(): void {
  var kept: string = "";
  for line in m.sink.get().split("\n") {
    if (line.len() > 7 && slice_unchecked(line, 0, 7) + "" == "canned\t") {
      kept = kept + line + "\n";
    }
  }
  m.sink.set(kept);
}

// `(m: MockPlatform).has_call(name)` — did this effect happen at all?
// Less precise than indexing `calls()`, and the right question when the
// test cares that something was reached, not when.
pub function (m: MockPlatform) has_call(name: string): boolean {
  var cs: MockCall[] = m.calls();
  var i: i32 = 0;
  while (i < cs.len()) {
    if (cs[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// `(m: MockPlatform).find_call(name)` — the first call with this name, for
// a test that wants its arguments without pinning its position.
pub function (m: MockPlatform) find_call(name: string): Option[MockCall] {
  var cs: MockCall[] = m.calls();
  var i: i32 = 0;
  while (i < cs.len()) {
    if (cs[i].name == name) {
      return Some(cs[i]);
    }
    i = i + 1;
  }
  return None;
}
