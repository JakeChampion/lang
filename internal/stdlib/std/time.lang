// std/time — six-type date/time module, jiff/NodaTime shape.
//
// Backs the seven time types registered as built-ins:
// `Instant`, `Date`, `Time`, `DateTime`, `Zoned`, `Span`,
// `Duration`, plus `TimeZone`. Each is meaning-distinct
// (docs/STDLIB-DESIGN-RESEARCH.md Rec §4):
//
//   Instant   — point in physical time, UTC, ns precision.
//   Date      — civil (year, month, day); no time, no zone.
//   Time      — civil wall-clock (h, m, s, ns); no date, no zone.
//   DateTime  — pair of (Date, Time); no zone.
//   Zoned     — Instant + TimeZone, fully qualified.
//   Span      — calendar-flavoured interval (years, months, …).
//   Duration  — absolute interval (sec + nsec).
//
// Conversions stay explicit:
//   Date → Instant requires a TimeZone.
//   Zoned → Date discards the zone.
//   Span ↔ Duration only round-trips in the no-DST-shift case.
//
// Phase 1 (this PR): constants + the simplest constructors.
// Phase 2: Instant.now() via clock_gettime, basic arithmetic.
// Phase 3: Hinnant civil-date algorithms (add_days, weekday).
// Phase 4: RFC 3339 parse + format.
// Phase 5: TimeZone.iana(name) + Zoned operations.
// Phase 6: Span vs Duration calendar arithmetic.

import "core/int";

// Unit conversion constants — used everywhere; pull them out
// so callers don't repeat magic numbers.
pub const NANOS_PER_SECOND: i32 = 1000000000;
pub const NANOS_PER_MILLI: i32 = 1000000;
pub const NANOS_PER_MICRO: i32 = 1000;
pub const SECONDS_PER_MINUTE: i32 = 60;
pub const SECONDS_PER_HOUR: i32 = 3600;
pub const SECONDS_PER_DAY: i32 = 86400;
pub const MINUTES_PER_HOUR: i32 = 60;
pub const HOURS_PER_DAY: i32 = 24;
pub const DAYS_PER_WEEK: i32 = 7;

// `instant_from_unix(sec)` — build an Instant from a Unix
// epoch second count. Sub-second precision is left at zero;
// callers needing nanoseconds use the struct literal directly.
//
// Negative `sec` is accepted (pre-1970 instants) and the
// nsec stays non-negative — same shape as `clock_gettime`.
pub function instant_from_unix(sec: i64): Instant {
    return Instant { sec: sec, nsec: 0 };
}

// `instant_now()` — wall-clock now, UTC. Reads the system
// real-time clock through `now_unix_ms()` (which delegates
// to host-specific syscalls: wasi:clocks/wall-clock on the
// wasm target, Go's time.Now() under the interp). Splits
// the result into (sec, nsec) — `nsec` only carries
// millisecond resolution since the underlying primitive
// caps there; future Phase 2.x can swap to a nanosecond-
// resolution call when the backends grow it.
//
// NTP-adjustable: subject to backward clock jumps when the
// host adjusts time. Use `monotonic_ns` (also in this
// module's future surface) for benchmark / elapsed-time
// measurement.
pub function instant_now(): Instant {
    var ms: i64 = now_unix_ms();
    var sec: i64 = ms / (1000 as i64);
    var rem_ms: i64 = ms - sec * (1000 as i64);
    var ns: i32 = (rem_ms as i32) * 1000000; // NANOS_PER_MILLI (see duration_millis)
    return Instant { sec: sec, nsec: ns };
}

// `date_make(year, month, day)` — construct a civil Date.
// Doesn't validate that the date is real (Feb 30 builds fine);
// validation lands with the Hinnant arithmetic in Phase 3.
pub function date_make(year: i32, month: i32, day: i32): Date {
    return Date { year: year, month: month, day: day };
}

// `time_make(hour, minute, second)` — construct a Time at
// second precision. Use the struct literal directly when you
// need nanosecond precision.
pub function time_make(hour: i32, minute: i32, second: i32): Time {
    return Time { hour: hour, minute: minute, second: second, nsec: 0 };
}

// `datetime_make(d, t)` — pair a Date with a Time, no zone.
pub function datetime_make(d: Date, t: Time): DateTime {
    return DateTime { date: d, time: t };
}

// `timezone_utc()` — the UTC zone constant. Offset zero.
// IANA zone lookup (`timezone_iana(name)`) lands in Phase 5.
pub function timezone_utc(): TimeZone {
    return TimeZone { name: "UTC", offset_seconds: 0 };
}

// `duration_seconds(s)` — absolute interval of `s` seconds.
// Negative is allowed (start-after-end durations).
pub function duration_seconds(s: i64): Duration {
    return Duration { sec: s, nsec: 0 };
}

// `duration_millis(ms)` — convert milliseconds to a Duration.
// Splits whole-seconds + sub-second nsec so the storage
// matches the (sec, nsec) shape callers see in struct fields.
//
// The `1000000` is `NANOS_PER_MILLI` inlined — modload's
// flat-load path doesn't yet plumb constants across modules,
// so references to the prelude-exposed const above resolve
// only at the qualified-import call site, not from inside
// the module's own bodies. Use the literal until the const
// resolution gets fixed.
pub function duration_millis(ms: i64): Duration {
    var s: i64 = ms / (1000 as i64);
    var rem_ms: i64 = ms - s * (1000 as i64);
    var ns: i32 = (rem_ms as i32) * 1000000;
    return Duration { sec: s, nsec: ns };
}

// `span_days(n)` — calendar-flavoured interval of n days.
// Convenience for the common "tomorrow" / "yesterday" use
// case (`today.add_span(span_days(1))` once Phase 3 lands).
pub function span_days(n: i32): Span {
    return Span {
        years: 0, months: 0, weeks: 0, days: n,
        hours: 0, minutes: 0, seconds: 0, nanos: 0,
    };
}

// `span_hours(n)` — calendar-flavoured interval of n hours.
// Distinct from `duration_seconds(n * 3600)` — `span_hours(24)`
// is "same wall-clock time tomorrow," not "exactly 86400
// seconds later," and the two diverge across DST boundaries
// (once TimeZone arithmetic lands).
pub function span_hours(n: i32): Span {
    return Span {
        years: 0, months: 0, weeks: 0, days: 0,
        hours: n, minutes: 0, seconds: 0, nanos: 0,
    };
}

// ============================================================
// Civil-date arithmetic — Howard Hinnant's algorithms (Phase 3
// per docs/STDLIB-DESIGN-RESEARCH.md Rec §4). Reference impl:
// https://hinnant.github.io/date_v2.html. Days-since-epoch
// is a signed i32 (range ±5.8M years from 1970, plenty).
// ============================================================

// `__days_from_civil(y, m, d)` — serial day number relative to
// 1970-01-01. Assumes the input is a valid civil date — Feb 30
// produces a nonsense result rather than trapping; callers
// should `.is_valid()` first if they're sanitising user input.
//
// The era trick (groups of 400 years = 146097 days) folds
// negative-year arithmetic into the same closed form as
// positive — no branchy "is this year before epoch" guards.
function __days_from_civil(y_in: i32, m: i32, d: i32): i32 {
    var y: i32 = y_in;
    if (m <= 2) { y = y - 1; }
    var era: i32 = 0;
    if (y >= 0) {
        era = y / 400;
    } else {
        era = (y - 399) / 400;
    }
    var yoe: i32 = y - era * 400;
    var mp: i32 = 0;
    if (m > 2) {
        mp = m - 3;
    } else {
        mp = m + 9;
    }
    var doy: i32 = (153 * mp + 2) / 5 + d - 1;
    var doe: i32 = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

// `__civil_from_days(z)` — inverse of `__days_from_civil`.
// Returns a Date. Same era trick for the negative branch.
function __civil_from_days(z_in: i32): Date {
    var z: i32 = z_in + 719468;
    var era: i32 = 0;
    if (z >= 0) {
        era = z / 146097;
    } else {
        era = (z - 146096) / 146097;
    }
    var doe: i32 = z - era * 146097;
    var yoe: i32 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    var y: i32 = yoe + era * 400;
    var doy: i32 = doe - (365 * yoe + yoe / 4 - yoe / 100);
    var mp: i32 = (5 * doy + 2) / 153;
    var d: i32 = doy - (153 * mp + 2) / 5 + 1;
    var m: i32 = 0;
    if (mp < 10) {
        m = mp + 3;
    } else {
        m = mp - 9;
    }
    if (m <= 2) { y = y + 1; }
    return Date { year: y, month: m, day: d };
}

// `is_leap_year(y)` — Gregorian leap-year rule. Divisible by 4,
// except century years (divisible by 100) which must also be
// divisible by 400. 2000 yes, 1900 no, 2024 yes, 2100 no.
pub function is_leap_year(y: i32): boolean {
    if (y % 4 != 0) { return false; }
    if (y % 100 != 0) { return true; }
    return y % 400 == 0;
}

// `days_in_month(y, m)` — calendar days for the given month.
// Handles February's leap-year branch. Returns 0 for an
// out-of-range month — callers should `.is_valid()` first if
// they care.
pub function days_in_month(y: i32, m: i32): i32 {
    if (m == 1) { return 31; }
    if (m == 2) {
        if (is_leap_year(y)) { return 29; }
        return 28;
    }
    if (m == 3) { return 31; }
    if (m == 4) { return 30; }
    if (m == 5) { return 31; }
    if (m == 6) { return 30; }
    if (m == 7) { return 31; }
    if (m == 8) { return 31; }
    if (m == 9) { return 30; }
    if (m == 10) { return 31; }
    if (m == 11) { return 30; }
    if (m == 12) { return 31; }
    return 0;
}

// `(d).is_valid()` — does the (year, month, day) triple name
// a real Gregorian date? Year is unbounded (negative years are
// "BCE", which Hinnant's algorithm handles); month must be
// 1..12; day must be 1..days_in_month(year, month).
pub function (d: Date) is_valid(): boolean {
    if (d.month < 1) { return false; }
    if (d.month > 12) { return false; }
    if (d.day < 1) { return false; }
    return d.day <= days_in_month(d.year, d.month);
}

// `(d).add_days(n)` — calendar-add `n` days. Negative `n` walks
// backward. Round-trips through the serial day number so
// month / year / leap-year boundaries handle themselves.
pub function (d: Date) add_days(n: i32): Date {
    var z: i32 = __days_from_civil(d.year, d.month, d.day);
    return __civil_from_days(z + n);
}

// `(d).days_since(other)` — number of whole days from `other`
// to `d`. Positive when `d` is after `other`; negative when
// before. Subtracts serial day numbers — exact, no floating
// point.
pub function (d: Date) days_since(other: Date): i32 {
    var a: i32 = __days_from_civil(d.year, d.month, d.day);
    var b: i32 = __days_from_civil(other.year, other.month, other.day);
    return a - b;
}

// `(d).weekday()` — 0..6 with Sunday=0 (Hinnant convention,
// matches `strftime` `%w`). 1970-01-01 was a Thursday so
// `__days_from_civil` returns 0 for that date; we offset by
// 4 to land Thursday → 4. The `((x % 7) + 7) % 7` trick
// makes the result non-negative even when `__days_from_civil`
// returns a negative i32 (pre-1970 dates).
pub function (d: Date) weekday(): i32 {
    var z: i32 = __days_from_civil(d.year, d.month, d.day);
    return ((z + 4) % 7 + 7) % 7;
}

// `(d).day_of_year()` — 1..366. Jan 1 returns 1. Computed
// from Hinnant's intra-year offset; doesn't need the era
// machinery since the value only depends on (month, day) plus
// the leap-year flag.
//
// Hinnant's frame anchors at March 1 (so months map to mp =
// {Mar→0, Apr→1, …, Feb→11}); Jan/Feb of year Y are framed in
// year Y-1, so their frame-doy values 307..365 (+1 in leap)
// map to Jan-based 1..59 (+1). Convert with two cases:
//   m ≤ 2:  Jan-based = frame_doy - 306
//   m > 2:  Jan-based = frame_doy + 59 + (is_leap_year(y) ? 1 : 0)
// Mar 1 is day 60 in non-leap, 61 in leap; Dec 31 is 365 / 366.
pub function (d: Date) day_of_year(): i32 {
    var m: i32 = d.month;
    var mp: i32 = 0;
    if (m > 2) {
        mp = m - 3;
    } else {
        mp = m + 9;
    }
    var doy: i32 = (153 * mp + 2) / 5 + d.day;
    if (m <= 2) {
        return doy - 306;
    }
    var add_for_leap: i32 = 0;
    if (is_leap_year(d.year)) { add_for_leap = 1; }
    return doy + 59 + add_for_leap;
}

// ============================================================
// RFC 3339 / ISO 8601 parsing + formatting — Phase 4 per
// docs/STDLIB-DESIGN-RESEARCH.md Rec §4.
//
// Surface today: ISO date (YYYY-MM-DD) and UTC RFC 3339 instant
// (YYYY-MM-DDTHH:MM:SS[.fraction]Z). DateTime + zoned-offset
// forms (`+01:00`) land with TimeZone in Phase 5.
// ============================================================

// `__pad2(n)` — zero-pad an i32 to two digits. Assumes 0 ≤ n ≤ 99.
function __pad2(n: i32): string {
    if (n < 10) {
        return "0" + int.int_to_string(n);
    }
    return int.int_to_string(n);
}

// `__pad4(n)` — zero-pad a non-negative i32 to four digits.
// Years past 9999 stretch beyond four; ISO 8601 allows them
// (with a leading `+` sign on extended-year form) but Phase 4
// emits the natural decimal representation for those — RFC
// 3339 parsers in practice tolerate the extra digit.
function __pad4(n: i32): string {
    if (n < 10) { return "000" + int.int_to_string(n); }
    if (n < 100) { return "00" + int.int_to_string(n); }
    if (n < 1000) { return "0" + int.int_to_string(n); }
    return int.int_to_string(n);
}

// `__parse_digits(s, start, end)` — parse the [start, end) slice
// of `s` as a decimal integer. Returns -1 on any non-digit byte
// — callers use this as a sentinel for malformed input. Doesn't
// handle leading sign; date components are all non-negative.
function __parse_digits(s: string, start: i32, end: i32): i32 {
    if (start >= end) { return -1; }
    var acc: i32 = 0;
    var i: i32 = start;
    while (i < end) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return -1; }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    return acc;
}

// `(d: Date).format_iso()` — emit `YYYY-MM-DD`. Doesn't
// validate; callers should `.is_valid()` first if the date
// came from arithmetic that could produce nonsense.
pub function (d: Date) format_iso(): string {
    return __pad4(d.year) + "-" + __pad2(d.month) + "-" + __pad2(d.day);
}

// `date_parse_iso(s)` — parse `YYYY-MM-DD`. Returns None on
// any deviation from the exact shape: wrong length, missing
// hyphens at offsets 4 and 7, or non-digit bytes in the
// year/month/day slices. Doesn't check that the resulting
// date is calendar-valid (Feb 30 parses); callers use
// `.is_valid()` afterward.
pub function date_parse_iso(s: string): Option[Date] {
    if (len(s) != 10) { return None; }
    if (s[4] != 45 || s[7] != 45) { return None; }   // '-' = 45
    var y: i32 = __parse_digits(s, 0, 4);
    var m: i32 = __parse_digits(s, 5, 7);
    var d: i32 = __parse_digits(s, 8, 10);
    if (y < 0 || m < 0 || d < 0) { return None; }
    return Some(Date { year: y, month: m, day: d });
}

// `(i: Instant).format_rfc3339()` — emit
// `YYYY-MM-DDTHH:MM:SSZ` (UTC). When `i.nsec > 0`, includes a
// fractional-seconds component `.nnnnnnnnn` (always 9 digits;
// callers wanting trimmed trailing zeros can post-process).
//
// Built from the civil-date arithmetic: `sec / 86400` →
// serial days → `__civil_from_days` → Y/M/D. Remainder gives
// H/M/S. nsec passes through unchanged.
//
// Negative `i.sec` (pre-1970) works via the era trick in
// `__civil_from_days`; the day-rem-and-sec-rem math below
// uses floor division on negatives by adjusting when the
// remainder would otherwise come back negative.
pub function (i: Instant) format_rfc3339(): string {
    var sec: i64 = i.sec;
    var spd: i64 = 86400 as i64;
    var days: i64 = sec / spd;
    var sec_in_day: i64 = sec - days * spd;
    if (sec_in_day < (0 as i64)) {
        sec_in_day = sec_in_day + spd;
        days = days - (1 as i64);
    }
    var d: Date = __civil_from_days(days as i32);
    var sid: i32 = sec_in_day as i32;
    var h: i32 = sid / 3600;
    var rem: i32 = sid - h * 3600;
    var mn: i32 = rem / 60;
    var s: i32 = rem - mn * 60;
    var head: string = d.format_iso() + "T" + __pad2(h) + ":" + __pad2(mn) + ":" + __pad2(s);
    if (i.nsec == 0) {
        return head + "Z";
    }
    // 9-digit fractional. Build manually to preserve leading
    // zeros — int_to_string(123) is "123", which would
    // misrepresent ".000000123" as ".123".
    var ns: i32 = i.nsec;
    var div: i32 = 100000000;
    var frac: string = "";
    while (div >= 1) {
        var digit: i32 = (ns / div) - (ns / (div * 10)) * 10;
        // Bytes 48..57 = '0'..'9'. We append each digit as a
        // 1-char string via index → __char_to_string trick:
        // emitting the literal digit chars via switch is the
        // cleanest path that doesn't need a char helper.
        if (digit == 0) { frac = frac + "0"; }
        else if (digit == 1) { frac = frac + "1"; }
        else if (digit == 2) { frac = frac + "2"; }
        else if (digit == 3) { frac = frac + "3"; }
        else if (digit == 4) { frac = frac + "4"; }
        else if (digit == 5) { frac = frac + "5"; }
        else if (digit == 6) { frac = frac + "6"; }
        else if (digit == 7) { frac = frac + "7"; }
        else if (digit == 8) { frac = frac + "8"; }
        else { frac = frac + "9"; }
        if (div == 1) { div = 0; } else { div = div / 10; }
    }
    return head + "." + frac + "Z";
}

// `instant_parse_rfc3339(s)` — parse the UTC form
// `YYYY-MM-DDTHH:MM:SS[.fraction]Z`. Returns None on any
// deviation. Doesn't accept the lowercase `t` / `z` variants
// (RFC 3339 §5.6 allows them, but the canonical form
// dominates in the wild and accepting both invites
// case-mismatch bugs in callers comparing strings).
//
// Zone offsets `+HH:MM` / `-HH:MM` land in Phase 5 with
// TimeZone.
pub function instant_parse_rfc3339(s: string): Option[Instant] {
    var n: i32 = len(s);
    // 20 = "YYYY-MM-DDTHH:MM:SSZ" minimum. Beyond that there's
    // an optional ".fraction" before the trailing Z.
    if (n < 20) { return None; }
    if (s[4] != 45 || s[7] != 45) { return None; }    // hyphens
    if (s[10] != 84) { return None; }                  // 'T' = 84
    if (s[13] != 58 || s[16] != 58) { return None; }  // colons
    var y: i32 = __parse_digits(s, 0, 4);
    var mo: i32 = __parse_digits(s, 5, 7);
    var d: i32 = __parse_digits(s, 8, 10);
    var h: i32 = __parse_digits(s, 11, 13);
    var mn: i32 = __parse_digits(s, 14, 16);
    var sc: i32 = __parse_digits(s, 17, 19);
    if (y < 0 || mo < 0 || d < 0 || h < 0 || mn < 0 || sc < 0) { return None; }
    // Fraction (optional) + trailing Z.
    var nsec: i32 = 0;
    if (s[19] == 46) {  // '.' = 46
        // Find Z; everything between '.' and 'Z' is digits.
        var z_idx: i32 = -1;
        var i: i32 = 20;
        while (i < n) {
            if (s[i] == 90) {   // 'Z' = 90
                z_idx = i;
                i = n;
            } else {
                i = i + 1;
            }
        }
        if (z_idx < 0) { return None; }
        if (z_idx == 20) { return None; }   // empty fraction
        if (z_idx - 20 > 9) { return None; } // too many digits (>nsec)
        var frac: i32 = __parse_digits(s, 20, z_idx);
        if (frac < 0) { return None; }
        // Pad to 9 digits: each missing digit multiplies by 10.
        var pad: i32 = 9 - (z_idx - 20);
        while (pad > 0) {
            frac = frac * 10;
            pad = pad - 1;
        }
        nsec = frac;
    } else if (s[19] == 90) {
        // Bare Z directly after seconds; nsec stays 0.
    } else {
        return None;
    }
    // Compose Instant: seconds = days_from_civil(y,m,d)*86400 + h*3600 + mn*60 + sc.
    var days: i32 = __days_from_civil(y, mo, d);
    var spd: i64 = 86400 as i64;
    var sec: i64 = (days as i64) * spd
        + ((h * 3600 + mn * 60 + sc) as i64);
    return Some(Instant { sec: sec, nsec: nsec });
}

// ============================================================
// TimeZone + Zoned — Phase 5 per docs/STDLIB-DESIGN-RESEARCH.md
// Rec §4. Fixed-offset zones only in this PR — IANA tzdb
// lookup (with DST transition tables) lands separately.
// ============================================================

// `timezone_fixed_offset(offset_seconds)` — construct a fixed-
// offset TimeZone (no DST). Common use: `±09:00` (Japan),
// `±05:00` (Eastern US in winter), `±00:00` (UTC alias).
// The name field carries the canonical `UTC+HH:MM` /
// `UTC-HH:MM` representation for display.
//
// Range: ±14:00:00 covers every real fixed offset (the IANA
// extreme is +14:00 Kiribati / -12:00 Baker Island). Out-of-
// range offsets get the same canonical-name treatment; we
// don't reject them here.
pub function timezone_fixed_offset(offset_seconds: i32): TimeZone {
    var abs_sec: i32 = offset_seconds;
    var sign: string = "+";
    if (offset_seconds < 0) {
        abs_sec = -offset_seconds;
        sign = "-";
    }
    var h: i32 = abs_sec / 3600;
    var m: i32 = (abs_sec - h * 3600) / 60;
    var name: string = "UTC" + sign + __pad2(h) + ":" + __pad2(m);
    return TimeZone { name: name, offset_seconds: offset_seconds };
}

// `(i: Instant).in_zone(z)` — pair this UTC instant with a
// zone. Doesn't change the absolute time; the Zoned shows
// the *wall-clock* time at the zone when subsequently
// formatted or decomposed.
pub function (i: Instant) in_zone(z: TimeZone): Zoned {
    return Zoned { instant: i, zone: z };
}

// `(z: Zoned).to_datetime()` — split into the wall-clock
// `DateTime` at the zone. Drops the zone — callers needing
// the round-trip should hold onto the Zoned.
pub function (z: Zoned) to_datetime(): DateTime {
    var spd: i64 = 86400 as i64;
    // Wall-clock seconds = UTC + offset (offset is positive
    // east of UTC, so east-of-UTC zones get later wall-clock).
    var local_sec: i64 = z.instant.sec + (z.zone.offset_seconds as i64);
    var days: i64 = local_sec / spd;
    var sec_in_day: i64 = local_sec - days * spd;
    if (sec_in_day < (0 as i64)) {
        sec_in_day = sec_in_day + spd;
        days = days - (1 as i64);
    }
    var d: Date = __civil_from_days(days as i32);
    var sid: i32 = sec_in_day as i32;
    var h: i32 = sid / 3600;
    var rem: i32 = sid - h * 3600;
    var mn: i32 = rem / 60;
    var s: i32 = rem - mn * 60;
    return DateTime {
        date: d,
        time: Time { hour: h, minute: mn, second: s, nsec: z.instant.nsec },
    };
}

// `(z: Zoned).format_rfc3339()` — emit
// `YYYY-MM-DDTHH:MM:SS[.fraction]±HH:MM`. UTC zones (offset
// zero) emit `Z` instead of `+00:00`, matching the canonical
// form. Other zones emit the signed offset; mirrors the
// shape `instant_zoned_parse_rfc3339` round-trips against.
pub function (z: Zoned) format_rfc3339(): string {
    var dt: DateTime = z.to_datetime();
    var head: string = dt.date.format_iso() + "T"
        + __pad2(dt.time.hour) + ":" + __pad2(dt.time.minute) + ":" + __pad2(dt.time.second);
    var tail: string = "";
    if (dt.time.nsec != 0) {
        // Reuse the Instant fractional emitter logic via a
        // surrogate Instant. Cheap — no syscalls.
        var tmp: Instant = Instant { sec: 0 as i64, nsec: dt.time.nsec };
        var s: string = tmp.format_rfc3339();
        // tmp's format is "1970-01-01T00:00:00.<frac>Z" —
        // splice the fractional segment (between '.' and 'Z').
        var dot: i32 = s.index_of(".");
        var z_idx: i32 = s.index_of("Z");
        tail = s[dot:z_idx];
    }
    if (z.zone.offset_seconds == 0) {
        return head + tail + "Z";
    }
    var off: i32 = z.zone.offset_seconds;
    var sign: string = "+";
    if (off < 0) {
        off = -off;
        sign = "-";
    }
    var oh: i32 = off / 3600;
    var om: i32 = (off - oh * 3600) / 60;
    return head + tail + sign + __pad2(oh) + ":" + __pad2(om);
}

// `instant_zoned_parse_rfc3339(s)` — parse the full RFC 3339
// surface: `YYYY-MM-DDTHH:MM:SS[.fraction](Z|±HH:MM)`.
// Returns the parsed Zoned (instant in UTC; zone holds the
// original offset). `Z` is a fixed-offset alias for `+00:00`
// — the returned Zoned's zone.name is `"UTC"` for that case,
// or `"UTC±HH:MM"` for explicit offsets.
//
// Lowercase `t`/`z` still rejected (same strictness as
// `instant_parse_rfc3339`).
pub function instant_zoned_parse_rfc3339(s: string): Option[Zoned] {
    var n: i32 = len(s);
    if (n < 20) { return None; }
    if (s[4] != 45 || s[7] != 45) { return None; }
    if (s[10] != 84) { return None; }
    if (s[13] != 58 || s[16] != 58) { return None; }
    var y: i32 = __parse_digits(s, 0, 4);
    var mo: i32 = __parse_digits(s, 5, 7);
    var d: i32 = __parse_digits(s, 8, 10);
    var h: i32 = __parse_digits(s, 11, 13);
    var mn: i32 = __parse_digits(s, 14, 16);
    var sc: i32 = __parse_digits(s, 17, 19);
    if (y < 0 || mo < 0 || d < 0 || h < 0 || mn < 0 || sc < 0) { return None; }
    // After seconds: optional `.fraction`, then `Z` or `±HH:MM`.
    var pos: i32 = 19;
    var nsec: i32 = 0;
    if (s[pos] == 46) {  // '.'
        var frac_start: i32 = pos + 1;
        var frac_end: i32 = -1;
        var i: i32 = frac_start;
        while (i < n) {
            var b: i32 = s[i];
            if (b == 90 || b == 43 || b == 45) {  // Z, +, -
                frac_end = i;
                i = n;
            } else {
                i = i + 1;
            }
        }
        if (frac_end < 0) { return None; }
        if (frac_end == frac_start) { return None; }
        if (frac_end - frac_start > 9) { return None; }
        var frac: i32 = __parse_digits(s, frac_start, frac_end);
        if (frac < 0) { return None; }
        var pad: i32 = 9 - (frac_end - frac_start);
        while (pad > 0) { frac = frac * 10; pad = pad - 1; }
        nsec = frac;
        pos = frac_end;
    }
    // Now pos points at Z / + / -. Need at least 1 more byte
    // for Z, or 6 more for ±HH:MM.
    var offset_seconds: i32 = 0;
    var zone_name: string = "";
    if (s[pos] == 90) {  // Z
        if (pos + 1 != n) { return None; }
        zone_name = "UTC";
    } else if (s[pos] == 43 || s[pos] == 45) {
        if (pos + 6 != n) { return None; }
        if (s[pos + 3] != 58) { return None; }  // colon
        var oh: i32 = __parse_digits(s, pos + 1, pos + 3);
        var om: i32 = __parse_digits(s, pos + 4, pos + 6);
        if (oh < 0 || om < 0) { return None; }
        offset_seconds = oh * 3600 + om * 60;
        if (s[pos] == 45) { offset_seconds = -offset_seconds; }
        var sign_str: string = "+";
        if (s[pos] == 45) { sign_str = "-"; }
        zone_name = "UTC" + sign_str + __pad2(oh) + ":" + __pad2(om);
    } else {
        return None;
    }
    // Compose: local sec from y/m/d/h/mn/sc, then subtract
    // offset to get UTC sec.
    var days: i32 = __days_from_civil(y, mo, d);
    var spd: i64 = 86400 as i64;
    var local_sec: i64 = (days as i64) * spd
        + ((h * 3600 + mn * 60 + sc) as i64);
    var utc_sec: i64 = local_sec - (offset_seconds as i64);
    return Some(Zoned {
        instant: Instant { sec: utc_sec, nsec: nsec },
        zone: TimeZone { name: zone_name, offset_seconds: offset_seconds },
    });
}
