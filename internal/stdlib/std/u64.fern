// std/u64 — unsigned 64-bit integer receiver methods.
//
// Counterpart to std/u32 for the wider type. Migrated from the
// former auto-injected prelude per docs/PRELUDE-TO-MODULES.md.

import "core/int";

pub function (n: u64) min(other: u64): u64 {
    if (n < other) { return n; }
    return other;
}

pub function (n: u64) max(other: u64): u64 {
    if (n > other) { return n; }
    return other;
}

pub function (n: u64) clamp(lo: u64, hi: u64): u64 {
    if (n < lo) { return lo; }
    if (n > hi) { return hi; }
    return n;
}

// `(n: u64) to_string()` — decimal representation. Reinterprets
// the underlying bits as i64 to share the i64 formatter helper;
// `__int_to_string_u64` treats its argument as unsigned given
// `neg == 0`.
pub function (n: u64) to_string(): string {
    return int.__int_to_string_u64(n as i64, 0);
}

// `(n: u64) is_zero()` / `is_even()` / `is_odd()` — parity + zero
// predicates matching the std/i64 versions.
pub function (n: u64) is_zero(): boolean { return n == (0 as u64); }
pub function (n: u64) is_even(): boolean { return n % (2 as u64) == (0 as u64); }
pub function (n: u64) is_odd(): boolean  { return n % (2 as u64) != (0 as u64); }

// `abs_diff(other)` — the absolute difference `|n - other|`, the wider sibling
// of u32's. Unsigned, so it is the larger minus the smaller and always fits.
pub function (n: u64) abs_diff(other: u64): u64 {
    if (n >= other) { return n - other; }
    return other - n;
}

// `is_in_range(lo, hi)` — half-open `[lo, hi)`, unsigned. Mirrors std/i64.
pub function (n: u64) is_in_range(lo: u64, hi: u64): boolean {
    return n >= lo && n < hi;
}

// `is_between(lo, hi)` — inclusive `[lo, hi]`, unsigned.
pub function (n: u64) is_between(lo: u64, hi: u64): boolean {
    return n >= lo && n <= hi;
}

// `(n: u64) pow(exp)` — exponentiation by squaring. Overflow wraps
// (unsigned, modulo 2^64), same shape as the i64 version.
pub function (n: u64) pow(exp: i32): u64 {
    if (exp < 0) { return 0 as u64; }
    var base: u64 = n;
    var e: i32 = exp;
    var out: u64 = 1 as u64;
    while (e > 0) {
        if (e % 2 == 1) { out = out * base; }
        base = base * base;
        e = e / 2;
    }
    return out;
}

// === u64 saturating / checked arithmetic ===
//
// Unsigned overflow has no sign bit to inspect: an add overflows
// exactly when the wrapped result is smaller than an operand, and a
// sub underflows exactly when the subtrahend exceeds the minuend.
// `saturating_*` clamps to u64::MAX / 0; `checked_*` returns None.

pub function (n: u64) saturating_add(other: u64): u64 {
    var r: u64 = n + other;
    // u64::MAX is the all-ones value; the 2^64-1 decimal literal isn't
    // i64-representable, so build it by underflow (matches umax()).
    if (r < n) { return (0 as u64) - (1 as u64); }        // wrapped → clamp to MAX
    return r;
}

pub function (n: u64) saturating_sub(other: u64): u64 {
    if (other > n) { return 0 as u64; }                  // would underflow → clamp to 0
    return n - other;
}

pub function (n: u64) checked_add(other: u64): Option[u64] {
    var r: u64 = n + other;
    if (r < n) { return None; }
    return Some(r);
}

pub function (n: u64) checked_sub(other: u64): Option[u64] {
    if (other > n) { return None; }
    return Some(n - other);
}
