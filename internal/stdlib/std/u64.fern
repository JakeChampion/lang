// std/u64 — unsigned 64-bit integer receiver methods.
//
// Counterpart to std/u32 for the wider type. Migrated from the
// former auto-injected prelude per docs/PRELUDE-TO-MODULES.md.

import "core/int";

pub function (n: u64) min(other: u64): u64 {
    if (n < other) { return n; }
    return other;
}

pub function (n: u64) max(other: u64): u64 {
    if (n > other) { return n; }
    return other;
}

pub function (n: u64) clamp(lo: u64, hi: u64): u64 {
    if (n < lo) { return lo; }
    if (n > hi) { return hi; }
    return n;
}

// `(n: u64) to_string()` — decimal representation. Reinterprets
// the underlying bits as i64 to share the i64 formatter helper;
// `__int_to_string_u64` treats its argument as unsigned given
// `neg == 0`.
pub function (n: u64) to_string(): string {
    return int.__int_to_string_u64(n as i64, 0);
}

// `(n: u64) is_zero()` / `is_even()` / `is_odd()` — parity + zero
// predicates matching the std/i64 versions.
pub function (n: u64) is_zero(): boolean { return n == (0 as u64); }
pub function (n: u64) is_even(): boolean { return n % (2 as u64) == (0 as u64); }
pub function (n: u64) is_odd(): boolean  { return n % (2 as u64) != (0 as u64); }

// `abs_diff(other)` — the absolute difference `|n - other|`, the wider sibling
// of u32's. Unsigned, so it is the larger minus the smaller and always fits.
pub function (n: u64) abs_diff(other: u64): u64 {
    if (n >= other) { return n - other; }
    return other - n;
}

// `(n: u64) midpoint(other)` — the overflow-safe average via
// `(a & b) + ((a ^ b) >> 1)` (logical shift), the u64 sibling of std/u32's
// `midpoint`. `(a + b) / 2` wraps for large unsigned operands; this form never
// does, so it is exact across the whole u64 range.
pub function (n: u64) midpoint(other: u64): u64 {
    return (n & other) + ((n ^ other) >> (1 as u64));
}

// `is_in_range(lo, hi)` — half-open `[lo, hi)`, unsigned. Mirrors std/i64.
pub function (n: u64) is_in_range(lo: u64, hi: u64): boolean {
    return n >= lo && n < hi;
}

// `is_between(lo, hi)` — inclusive `[lo, hi]`, unsigned.
pub function (n: u64) is_between(lo: u64, hi: u64): boolean {
    return n >= lo && n <= hi;
}

// `(n: u64) pow(exp)` — exponentiation by squaring. Overflow wraps
// (unsigned, modulo 2^64), same shape as the i64 version.
pub function (n: u64) pow(exp: i32): u64 {
    if (exp < 0) { return 0 as u64; }
    var base: u64 = n;
    var e: i32 = exp;
    var out: u64 = 1 as u64;
    while (e > 0) {
        if (e % 2 == 1) { out = out * base; }
        base = base * base;
        e = e / 2;
    }
    return out;
}

// === u64 saturating / checked arithmetic ===
//
// Unsigned overflow has no sign bit to inspect: an add overflows
// exactly when the wrapped result is smaller than an operand, and a
// sub underflows exactly when the subtrahend exceeds the minuend.
// `saturating_*` clamps to u64::MAX / 0; `checked_*` returns None.

pub function (n: u64) saturating_add(other: u64): u64 {
    var r: u64 = n + other;
    // u64::MAX is the all-ones value; the 2^64-1 decimal literal isn't
    // i64-representable, so build it by underflow (matches umax()).
    if (r < n) { return (0 as u64) - (1 as u64); }        // wrapped → clamp to MAX
    return r;
}

pub function (n: u64) saturating_sub(other: u64): u64 {
    if (other > n) { return 0 as u64; }                  // would underflow → clamp to 0
    return n - other;
}

pub function (n: u64) checked_add(other: u64): Option[u64] {
    var r: u64 = n + other;
    if (r < n) { return None; }
    return Some(r);
}

pub function (n: u64) checked_sub(other: u64): Option[u64] {
    if (other > n) { return None; }
    return Some(n - other);
}

// `(n: u64) sqrt_floor()` — floor of the integer square root, via Newton's
// method. Unsigned, so there are no negative-input cases: `sqrt_floor(0)` is 0,
// and the iteration converges in O(log n). Exact across the full u64 range,
// e.g. `sqrt_floor(18446744065119617025)` (which is `(2^32 - 1)^2`) is
// `4294967295`.
pub function (n: u64) sqrt_floor(): u64 {
    if (n < (2 as u64)) { return n; }
    var x: u64 = n / (2 as u64);
    while (true) {
        var y: u64 = (x + n / x) / (2 as u64);
        if (y >= x) { return x; }
        x = y;
    }
    return x;
}

// `(n: u64) is_power_of_2()` — true iff `n` is a power of two, via the
// `n & (n - 1) == 0` bit trick (with `n != 0` ruled out first). `2^63` is the
// largest power of two a u64 holds, and it reports true.
pub function (n: u64) is_power_of_2(): boolean {
    if (n == (0 as u64)) { return false; }
    return (n & (n - (1 as u64))) == (0 as u64);
}

// `(n: u64) next_power_of_2()` — the smallest power of two `>= n`. Returns `1`
// for `n <= 1`. The largest power of two representable in a u64 is 2^63 (built
// here as `1 << 63` rather than a bare literal, which would exceed the signed
// range the lexer stores numbers in), so `n` above that returns `0` (the "no
// representable power" sentinel) — which also keeps the doubling loop from
// wrapping to zero and spinning forever.
pub function (n: u64) next_power_of_2(): u64 {
    if (n <= (1 as u64)) { return 1 as u64; }
    if (n > ((1 as u64) << (63 as u64))) { return 0 as u64; }
    var p: u64 = 1 as u64;
    while (p < n) { p = p * (2 as u64); }
    return p;
}

// `(n: u64) log2_floor()` — `floor(log2 n)` for `n >= 1`, returned as an i32
// (the exponent spans 0..63); `-1` for `n == 0` (no real log; the sentinel
// lets callers test `>= 0` for "valid"). Counts halvings, so it needs no
// leading-zeros primitive.
pub function (n: u64) log2_floor(): i32 {
    if (n == (0 as u64)) { return 0 - 1; }
    var r: i32 = 0;
    var m: u64 = n;
    while (m > (1 as u64)) { m = m / (2 as u64); r = r + 1; }
    return r;
}

// === u64 bit ops (the unsigned counterparts to std/i64's) ===
// Software implementations over u64 shifts/masks, O(64) per call — the
// same shape as std/i64's, but with no sign bit (unsigned shifts are
// logical).

// `count_ones()` — the number of set bits in `n`.
pub function (n: u64) count_ones(): i32 {
    var u: u64 = n;
    var c: i32 = 0;
    var i: i32 = 0;
    while (i < 64) {
        if ((u & (1 as u64)) != (0 as u64)) { c = c + 1; }
        u = u >> (1 as u64);
        i = i + 1;
    }
    return c;
}

// `count_zeros()` — the number of clear bits (`64 - count_ones()`).
pub function (n: u64) count_zeros(): i32 { return 64 - n.count_ones(); }

// `leading_zeros()` — the number of zero bits above the highest set bit
// (`0` → 64).
pub function (n: u64) leading_zeros(): i32 {
    if (n == (0 as u64)) { return 64; }
    var u: u64 = n;
    var top: u64 = (1 as u64) << (63 as u64);
    var c: i32 = 0;
    while ((u & top) == (0 as u64)) {
        c = c + 1;
        u = u << (1 as u64);
    }
    return c;
}

// `trailing_zeros()` — the number of zero bits below the lowest set bit
// (`0` → 64).
pub function (n: u64) trailing_zeros(): i32 {
    if (n == (0 as u64)) { return 64; }
    var u: u64 = n;
    var c: i32 = 0;
    while ((u & (1 as u64)) == (0 as u64)) {
        c = c + 1;
        u = u >> (1 as u64);
    }
    return c;
}

// `bit_length()` — the position of the highest set bit, plus one
// (`64 - leading_zeros()`); `0` → 0.
pub function (n: u64) bit_length(): i32 { return 64 - n.leading_zeros(); }

// `rotate_left(bits)` / `rotate_right(bits)` — cyclic bit rotation.
// `bits` is taken mod 64.
pub function (n: u64) rotate_left(bits: i32): u64 {
    var k: i32 = bits & 63;
    if (k == 0) { return n; }
    var left: u64 = n << (k as u64);
    var right: u64 = n >> ((64 - k) as u64);
    return left | right;
}

pub function (n: u64) rotate_right(bits: i32): u64 {
    var k: i32 = bits & 63;
    if (k == 0) { return n; }
    var right: u64 = n >> (k as u64);
    var left: u64 = n << ((64 - k) as u64);
    return right | left;
}

// `byte_swap()` — reverse the 8 bytes of `n` (endianness swap). The
// unsigned 64-bit sibling of std/i32's `byte_swap`.
pub function (n: u64) byte_swap(): u64 {
    var r: u64 = 0 as u64;
    var i: i32 = 0;
    while (i < 8) {
        var b: u64 = (n >> ((i * 8) as u64)) & (255 as u64);
        r = r | (b << (((7 - i) * 8) as u64));
        i = i + 1;
    }
    return r;
}

// `bit(i)` / `set_bit(i)` / `clear_bit(i)` / `toggle_bit(i)` — read /
// set / clear / flip bit `i` (0 = LSB), the unsigned 64-bit siblings of
// std/i32's accessors. Out-of-range `i` (< 0 or >= 64) reads false /
// returns `n`.
pub function (n: u64) bit(i: i32): boolean {
    if (i < 0 || i >= 64) { return false; }
    return (n & ((1 as u64) << (i as u64))) != (0 as u64);
}
pub function (n: u64) set_bit(i: i32): u64 {
    if (i < 0 || i >= 64) { return n; }
    return n | ((1 as u64) << (i as u64));
}
pub function (n: u64) clear_bit(i: i32): u64 {
    if (i < 0 || i >= 64) { return n; }
    var inv: u64 = (((0 as i64) - (1 as i64)) as u64) ^ ((1 as u64) << (i as u64));
    return n & inv;
}
pub function (n: u64) toggle_bit(i: i32): u64 {
    if (i < 0 || i >= 64) { return n; }
    return n ^ ((1 as u64) << (i as u64));
}
