// std/stream — byte-stream value backing the eventual
// `HttpRequest.body: Stream` migration
// (docs/STDLIB-DESIGN-RESEARCH.md Rec §1).
//
// Phase 1 (this PR): in-memory buffer-backed Stream with a
// `data: u8[]` payload + a `pos: i32` read cursor. Reads
// advance the cursor; `.read_all_string()` / `.read_all()`
// consume the remainder. The buffer is allocated up-front;
// no lazy / chunked reads yet.
//
// Phase 2: replace the buffer with a host-side reader that
// pulls bytes on demand (wasi:http/incoming-body for
// wasi-http; TCP socket for tcp_serve). The lang-side API
// shape stays identical — handler code written against the
// Phase 1 surface keeps working under Phase 2 without
// changes.
//
// `bytes` is `u8[]` throughout the codebase (no separate
// type alias today). Stream constructors / readers all use
// `u8[]` for the byte-array side.

import "std/string";
import "core/int";

// `stream_from_bytes(bs)` — wrap a `u8[]` buffer as a
// Stream. The Stream owns the buffer; subsequent reads
// advance the cursor.
pub function stream_from_bytes(bs: u8[]): Stream {
    return Stream { data: bs, pos: 0 };
}

// `stream_from_string(s)` — wrap a string's bytes as a
// Stream. Cheap byte conversion (`s.bytes()` returns the
// fresh `u8[]`).
pub function stream_from_string(s: string): Stream {
    return Stream { data: s.bytes(), pos: 0 };
}

// `stream_empty()` — zero-length Stream. Useful as a default
// / placeholder.
pub function stream_empty(): Stream {
    var empty: u8[] = [];
    return Stream { data: empty, pos: 0 };
}

// `(s: Stream).len()` — total byte count of the Stream's
// backing buffer (independent of the read cursor).
pub function (s: Stream) len(): i32 {
    return s.data.len();
}

// `(s: Stream).remaining()` — bytes between the cursor and
// the end of the buffer. Zero when the Stream is fully
// consumed.
pub function (s: Stream) remaining(): i32 {
    var total: i32 = s.data.len();
    if (s.pos >= total) { return 0; }
    return total - s.pos;
}

// `(s: Stream).is_empty()` — whether the Stream has any
// unread bytes left. The dual of `.remaining() == 0`;
// reads better at call sites that gate on "any more data?"
pub function (s: Stream) is_empty(): boolean {
    return s.pos >= s.data.len();
}

// `(s: Stream).read_all()` — consume the remaining bytes
// as a fresh `u8[]`, returning `(bytes, advancedStream)` per
// the cursor idiom (docs/CURSOR-IDIOM.md). The returned
// Stream's cursor is at the end of the buffer; rebind it:
// `var (bytes, s) = s.read_all();`.
//
// Phase 2 will fold an IoError into the result once host-
// side reads can fail; Phase 1's in-memory buffer can't
// fail so the bare bytes return is fine.
pub function (s: Stream) read_all(): (u8[], Stream) {
    var rem: i32 = s.remaining();
    if (rem == 0) {
        var empty: u8[] = [];
        return (empty, s);
    }
    var out: u8[] = [];
    var i: i32 = s.pos;
    var end: i32 = s.data.len();
    while (i < end) {
        out = out.append(s.data[i]);
        i = i + 1;
    }
    return (out, Stream { ...s, pos: end });
}

// `(s: Stream).read_all_string()` — consume the remaining
// bytes as a UTF-8 string, returning `(string, advancedStream)`.
// Convenience over `string_from_bytes_unchecked` on `read_all`'s bytes,
// and so UNCHECKED: non-UTF-8 input round-trips through the string as
// raw bytes rather than being rejected. A reader is a genuine ingest
// boundary, so callers who need the bytes to actually be text should
// take `read_all` and pass the bytes to `std/utf8.from_bytes`, which
// validates and returns `Option[string]` (#5634, D9).
pub function (s: Stream) read_all_string(): (string, Stream) {
    var (bytes, s2) = s.read_all();
    return (string_from_bytes_unchecked(bytes), s2);
}

// ============================================================
// Reader-shape methods — Tier-C Rec §13.
//
// These follow the immutable CURSOR IDIOM (docs/CURSOR-IDIOM.md):
// a read returns `(value, advancedStream)` and the caller
// rebinds the Stream. Stream is a value-semantic in-memory
// reader.
//
// NOTE — Stream and the fd-backed Reader are DELIBERATELY
// SEPARATE shapes (the "share method names so they compose"
// convention that this comment used to describe is RETIRED).
// The fd-backed Reader is effectful — its position lives in
// kernel fd state, not a Fern value — so it cannot adopt the
// value-threaded cursor idiom: its `read_line()` stays a bare
// `Option[string]` that advances the fd as a side effect.
// Immutable readers (Stream) and effectful readers (fd) are
// distinct abstractions; unifying them waits on nominal
// interface types AND a decision on how an effectful reader
// presents a value-shaped surface (if ever).
// ============================================================

// `(s: Stream).read_byte()` — read a single byte from the
// cursor. Returns `(Option[i32], advancedStream)`: Some(b)
// + a Stream advanced past it, or None + the unchanged
// Stream when exhausted. Rebind: `var (b, s) = s.read_byte();`.
pub function (s: Stream) read_byte(): (Option[i32], Stream) {
    if (s.pos >= s.data.len()) { return (None, s); }
    var b: i32 = s.data[s.pos] as i32;
    return (Some(b), Stream { ...s, pos: s.pos + 1 });
}

// `(s: Stream).read_n(n)` — read up to `n` bytes from the
// cursor, returning `(bytes, advancedStream)`. The byte array
// holds the actual bytes consumed (possibly fewer than `n` at
// EOF); empty when already exhausted or `n <= 0`.
pub function (s: Stream) read_n(n: i32): (u8[], Stream) {
    var out: u8[] = [];
    if (n <= 0) { return (out, s); }
    var pos: i32 = s.pos;
    var end: i32 = pos + n;
    if (end > s.data.len()) { end = s.data.len(); }
    while (pos < end) {
        out = out.append(s.data[pos]);
        pos = pos + 1;
    }
    return (out, Stream { ...s, pos: pos });
}

// `(s: Stream).read_line()` — read up to and including the
// next `\n`, returning `(Option[string], advancedStream)`.
// The line excludes the trailing newline; a trailing `\r`
// (Windows line endings) is also stripped. None + unchanged
// Stream when exhausted at the start of the call (EOF); a
// final unterminated line returns Some(line) + the advanced
// Stream, then None on the subsequent call.
pub function (s: Stream) read_line(): (Option[string], Stream) {
    if (s.pos >= s.data.len()) { return (None, s); }
    var line_bytes: u8[] = [];
    var pos: i32 = s.pos;
    while (pos < s.data.len()) {
        var b: i32 = s.data[pos] as i32;
        pos = pos + 1;
        if (b == 10) {
            // \n — strip a trailing \r if present.
            var n: i32 = line_bytes.len();
            if (n > 0) {
                if ((line_bytes[n - 1] as i32) == 13) {
                    var stripped: u8[] = [];
                    var i: i32 = 0;
                    while (i < n - 1) {
                        stripped = stripped.append(line_bytes[i]);
                        i = i + 1;
                    }
                    return (Some(string_from_bytes_unchecked(stripped)), Stream { ...s, pos: pos });
                }
            }
            return (Some(string_from_bytes_unchecked(line_bytes)), Stream { ...s, pos: pos });
        }
        line_bytes = line_bytes.append(b as u8);
    }
    return (Some(string_from_bytes_unchecked(line_bytes)), Stream { ...s, pos: pos });
}
