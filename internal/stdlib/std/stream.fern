// std/stream — the byte-stream value behind `HttpRequest.body`
// (docs/STDLIB-DESIGN-RESEARCH.md Rec §1).
//
// A Stream is a `data: u8[]` buffer with a `pos: i32` read cursor; reads
// advance the cursor and `.read_all()` / `.read_all_string()` consume
// the remainder. A Stream made by `stream_from_source` also carries a
// `BodySource`: when a read exhausts the buffer it asks the source for
// the next chunk, which replaces the buffer, so a body that arrives as
// it is read (std/serve's streamed request body,
// docs/NET-P3-SUSPENSION-PLAN.md §3.9) is never held whole. The source
// answers None at its end and on every call after, and its `fault` says
// why the stream ended early. The reader API is the same either way.
//
// `bytes` is `u8[]` throughout the codebase (no separate
// type alias today). Stream constructors / readers all use
// `u8[]` for the byte-array side.

import "std/string";
import "std/utf8" as utf8;
import "core/int";

// `stream_from_bytes(bs)` — wrap a `u8[]` buffer as a
// Stream. The Stream owns the buffer; subsequent reads
// advance the cursor.
pub function stream_from_bytes(bs: u8[]): Stream {
  return Stream { data: bs, pos: 0, source: None };
}

// `stream_from_string(s)` — wrap a string's bytes as a
// Stream. Cheap byte conversion (`s.bytes()` returns the
// fresh `u8[]`).
pub function stream_from_string(s: string): Stream {
  return Stream { data: s.bytes(), pos: 0, source: None };
}

// `stream_empty()` — zero-length Stream. Useful as a default
// / placeholder.
pub function stream_empty(): Stream {
  let empty: u8[] = [];
  return Stream { data: empty, pos: 0, source: None };
}

// `stream_from_source(src)` — a Stream over a source that answers the
// next chunk on demand: the buffer starts empty, and a read that
// exhausts it asks `src.next()` for more, which replaces the buffer.
// `None` ends the stream; `(s).fault()` says why it ended early.
pub function stream_from_source(src: BodySource): Stream {
  let empty: u8[] = [];
  return Stream { data: empty, pos: 0, source: Some(src) };
}

// `(s: Stream).fault()` — why a sourced stream ended early: an HTTP
// status (413 past the cap, 408 stalled, 400 malformed or cut short) or
// `async.cancelled()`; 0 for a stream that reached, or has not reached,
// its end, and for one with no source.
pub function (s: Stream) fault(): i32 {
  match (s.source) {
    Some(src) => {
      return src.fault.get();
    },
    None => {
      return 0;
    }
  }
  return 0;
}

// `__fill(s)` — the stream with bytes to read when it can have them: an
// exhausted buffer is replaced by the source's next chunk, until one has
// bytes or the source answers None. A stream with no source is answered
// as it is.
function __fill(s: Stream): Stream {
  let out: Stream = s;
  while (out.pos >= out.data.len()) {
    match (out.source) {
      Some(src) => {
        match (src.next()) {
          Some(chunk) => {
            out = Stream { ...out, data: chunk, pos: 0 };
          },
          None => {
            return out;
          }
        }
      },
      None => {
        return out;
      }
    }
  }
  return out;
}

// `(s: Stream).len()` — byte count of the Stream's backing buffer
// (independent of the read cursor): the whole body of an in-memory
// Stream, the chunk being read of a sourced one.
pub function (s: Stream) len(): i32 {
  return s.data.len();
}

// `(s: Stream).remaining()` — bytes between the cursor and
// the end of the buffer. Zero when the Stream is fully
// consumed; a sourced Stream may still have chunks to pull.
pub function (s: Stream) remaining(): i32 {
  let total: i32 = s.data.len();
  if (s.pos >= total) {
    return 0;
  }
  return total - s.pos;
}

// `(s: Stream).is_empty()` — whether the Stream has any
// unread bytes left. The dual of `.remaining() == 0`;
// reads better at call sites that gate on "any more data?"
pub function (s: Stream) is_empty(): boolean {
  return s.pos >= s.data.len();
}

// `(s: Stream).read_all()` — consume the remaining bytes, and every
// chunk a source has still to give, as a fresh `u8[]`, returning
// `(bytes, advancedStream)` per the cursor idiom (docs/CURSOR-IDIOM.md).
// The returned Stream's cursor is at the end; rebind it: `let (bytes, s)
// = s.read_all();`, and `s.fault()` says whether a sourced stream ended
// early.
pub function (s: Stream) read_all(): (u8[], Stream) {
  let out: u8[] = [];
  let cur: Stream = __fill(s);
  while (cur.pos < cur.data.len()) {
    if (cur.pos == 0) {
      out = out.concat(cur.data);
    } else {
      let i: i32 = cur.pos;
      while (i < cur.data.len()) {
        out = out.append(cur.data[i]);
        i = i + 1;
      }
    }
    cur = __fill(Stream { ...cur, pos: cur.data.len() });
  }
  return (out, cur);
}

// `(s: Stream).read_all_string()` consumes and validates the remaining bytes.
// Valid UTF-8 yields Some(text), including Some("") at EOF; malformed bytes
// yield None. The returned cursor advances to EOF in either case. The original
// Stream remains unchanged, so callers can still recover its bytes with read_all.
pub function (s: Stream) read_all_string(): (Option[string], Stream) {
  let (bytes, s2) = s.read_all();
  return (utf8.from_bytes(bytes), s2);
}

// ============================================================
// Reader-shape methods — Tier-C Rec §13.
//
// These follow the immutable CURSOR IDIOM (docs/CURSOR-IDIOM.md):
// a read returns `(value, advancedStream)` and the caller
// rebinds the Stream. Stream is a value-semantic in-memory
// reader.
//
// NOTE — Stream and the fd-backed Reader are DELIBERATELY
// SEPARATE shapes (the "share method names so they compose"
// convention that this comment used to describe is RETIRED).
// The fd-backed Reader is effectful — its position lives in
// kernel fd state, not a Fern value — so it cannot adopt the
// value-threaded cursor idiom: its `read_line()` stays a bare
// `Option[string]` that advances the fd as a side effect.
// Immutable readers (Stream) and effectful readers (fd) are
// distinct abstractions; unifying them waits on nominal
// interface types AND a decision on how an effectful reader
// presents a value-shaped surface (if ever).
// ============================================================

// `(s: Stream).read_byte()` — read a single byte from the
// cursor. Returns `(Option[i32], advancedStream)`: Some(b)
// + a Stream advanced past it, or None + the unchanged
// Stream when exhausted. Rebind: `let (b, s) = s.read_byte();`.
pub function (s: Stream) read_byte(): (Option[i32], Stream) {
  let cur: Stream = __fill(s);
  if (cur.pos >= cur.data.len()) {
    return (None, cur);
  }
  let b: i32 = cur.data[cur.pos] as i32;
  return (Some(b), Stream { ...cur, pos: cur.pos + 1 });
}

// `(s: Stream).read_n(n)` — read up to `n` bytes from the
// cursor, returning `(bytes, advancedStream)`. The byte array
// holds the actual bytes consumed (possibly fewer than `n` at
// EOF); empty when already exhausted or `n <= 0`.
pub function (s: Stream) read_n(n: i32): (u8[], Stream) {
  let out: u8[] = [];
  if (n <= 0) {
    return (out, s);
  }
  let cur: Stream = __fill(s);
  while (out.len() < n && cur.pos < cur.data.len()) {
    let pos: i32 = cur.pos;
    let end: i32 = pos + (n - out.len());
    if (end > cur.data.len()) {
      end = cur.data.len();
    }
    while (pos < end) {
      out = out.append(cur.data[pos]);
      pos = pos + 1;
    }
    cur = __fill(Stream { ...cur, pos: pos });
  }
  return (out, cur);
}

// `(s: Stream).read_line()` — read up to and including the
// next `\n`, returning `(Option[string], advancedStream)`.
// The line excludes the trailing newline; a trailing `\r`
// (Windows line endings) is also stripped. None + unchanged
// Stream when exhausted at the start of the call (EOF); a
// final unterminated line returns Some(line) + the advanced
// Stream, then None on the subsequent call. An ill-formed
// sequence reads as U+FFFD: this reader's None already means
// end of input, so it has no arm to refuse into.
pub function (s: Stream) read_line(): (Option[string], Stream) {
  let cur: Stream = __fill(s);
  if (cur.pos >= cur.data.len()) {
    return (None, cur);
  }
  let line_bytes: u8[] = [];
  while (true) {
    let pos: i32 = cur.pos;
    while (pos < cur.data.len()) {
      let b: i32 = cur.data[pos] as i32;
      pos = pos + 1;
      if (b == 10) {
        return (Some(utf8.from_bytes_lossy(__without_cr(line_bytes))), Stream { ...cur, pos: pos });
      }
      line_bytes = line_bytes.append(b as u8);
    }
    cur = __fill(Stream { ...cur, pos: pos });
    if (cur.pos >= cur.data.len()) {
      return (Some(utf8.from_bytes_lossy(line_bytes)), cur);
    }
  }
  return (None, cur);
}

// `__without_cr(line)` — the line without the `\r` a CRLF ending leaves
// on it.
function __without_cr(line: u8[]): u8[] {
  let n: i32 = line.len();
  if (n == 0 || line[n - 1] as i32 != 13) {
    return line;
  }
  let stripped: u8[] = [];
  let i: i32 = 0;
  while (i < n - 1) {
    stripped = stripped.append(line[i]);
    i = i + 1;
  }
  return stripped;
}
