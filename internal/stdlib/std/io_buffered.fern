// std/io_buffered — in-memory buffered writers + readers,
// Tier-C Rec §13 Phase 1 (docs/STDLIB-DESIGN-RESEARCH.md
// Rec §5).
//
// Lang doesn't yet have nominal interface types — the doc's
// `interface Reader { read(buf): Result[i32, IoError] }`
// surface is deferred. Phase 1 uses convention-based
// polymorphism: BytesWriter shares the `.write_string()` /
// `.write_bytes()` method shape with the fd-backed Writer
// type, so generic code that calls those names works
// against either.
//
// Intended use — build up an HTTP response body without
// per-write socket calls:
//
//   var w: BytesWriter = bytes_writer_new();
//   w.write_string("HTTP/1.1 200 OK\r\n");
//   w.write_string("Content-Length: " + body.to_string() + "\r\n");
//   w.write_string("\r\n");
//   w.write_string(body);
//   tcp_send(fd, w.into_string());
//
// `BufWriter` wraps an fd-backed Writer with a flush threshold so
// per-write syscall overhead drops to per-block, and `LineReader`
// wraps a Reader and yields one line per call without buffering
// the whole input. Both are below.
//
// Deferred: nominal `Reader` / `Writer` interfaces. Once lang grows
// interface types, Stream, BytesWriter, BufWriter and the fd-backed
// Reader / Writer all `impl Reader` / `impl Writer` and generic code
// accepts any of them via the interface.
import "std/string";

// `bytes_writer_new()` — fresh empty BytesWriter.
pub function bytes_writer_new(): BytesWriter {
  var empty: u8[] = [];
  return BytesWriter { data: empty };
}

// `(w: BytesWriter).write_string(s)` — append a string's
// bytes. Same call shape as the fd-backed Writer's write
// method.
pub function (w: BytesWriter) write_string(s: string): BytesWriter {
  // A VIEW, not a copy: the loop below only reads bs, and the
  // view never outlives s (a live parameter), so `bytes()` here
  // would allocate and copy the whole string for nothing.
  var bs: [u8] = s.as_bytes();
  var data: u8[] = w.data;
  var i: i32 = 0;
  while (i < bs.len()) {
    data = data.append(bs[i]);
    i = i + 1;
  }
  return BytesWriter { ...w, data: data };
}

// `(w: BytesWriter).write_bytes(bs)` — append a byte slice
// directly (no string round-trip).
pub function (w: BytesWriter) write_bytes(bs: u8[]): BytesWriter {
  var data: u8[] = w.data;
  var i: i32 = 0;
  while (i < bs.len()) {
    data = data.append(bs[i]);
    i = i + 1;
  }
  return BytesWriter { ...w, data: data };
}

// `(w: BytesWriter).write_byte(b)` — single-byte write.
pub function (w: BytesWriter) write_byte(b: i32): BytesWriter {
  return BytesWriter { ...w, data: w.data.append(b as u8) };
}

// `(w: BytesWriter).len()` — total bytes written so far.
pub function (w: BytesWriter) len(): i32 {
  return w.data.len();
}

// `(w: BytesWriter).is_empty()` — convenience over
// `.len() == 0`.
pub function (w: BytesWriter) is_empty(): boolean {
  return w.data.len() == 0;
}

// `(w: BytesWriter).into_bytes()` — return the accumulated
// buffer as a `u8[]`. Consumer-side; the BytesWriter remains
// usable but callers typically discard it after this.
pub function (w: BytesWriter) into_bytes(): u8[] {
  return w.data;
}

// `(w: BytesWriter).into_string()` — same as into_bytes
// followed by `string_from_bytes_unchecked`. Convenience for the
// common "build a string buffered" pattern.
pub function (w: BytesWriter) into_string(): string {
  return string_from_bytes_unchecked(w.data);
}

// `(w: BytesWriter).reset(): BytesWriter` — return a writer with
// an empty buffer. Functional (immutable data structures): rebind
// the result — `w = w.reset()`.
pub function (w: BytesWriter) reset(): BytesWriter {
  var empty: u8[] = [];
  return BytesWriter { ...w, data: empty };
}

// ---- BufWriter -------------------------------------------------------------
//
// A Writer with a buffer in front of it. Writes accumulate in `buf`
// and reach the fd in one write(2) per `cap` bytes; a write that is
// itself at least `cap` bytes goes straight through rather than being
// copied twice. A write failure is sticky: `err` holds the first
// IoError, later writes are dropped, and the caller reads it back
// with `.error()` — the C stdio contract, where a failed flush is
// found at the next write or at close.
//
// The buffer is grown inside the struct literal (`{ ...b, buf: b.buf
// + s }`) because E048 leaves no other way to write it. That shape
// grows the buffer in place when the frame OWNS the box being updated
// (#8785); here it does not, because borrow inference makes the
// receiver the caller's, so a write still copies what is buffered.
// The cost is bounded rather than quadratic — the buffer flushes at
// `cap` — so a 4 KiB writer pays about 2 KB of memcpy per write.
// #8785's parameter half is what removes it.
pub struct BufWriter { w: Writer, buf: string, cap: i32, err: Option[IoError] }

// `buf_writer_new(w, cap)` — buffer `w` with a `cap`-byte threshold.
pub function buf_writer_new(w: Writer, cap: i32): BufWriter {
  return BufWriter { w: w, buf: "", cap: cap, err: None };
}

// `(b).write_string(s)` — append `s`, flushing when the threshold is
// reached. Rebind: `b = b.write_string(s);`.
pub function (b: BufWriter) write_string(s: string): BufWriter {
  if (b.buf.len() + s.len() < b.cap) {
    return BufWriter { ...b, buf: b.buf + s };
  }
  if (b.buf.len() == 0) {
    return __buf_writer_put(b, s);
  }
  var flushed: BufWriter = __buf_writer_put(b, b.buf + s);
  return BufWriter { ...flushed, buf: "" };
}

// `(b).write_byte(byte)` — append one byte.
pub function (b: BufWriter) write_byte(byte: i32): BufWriter {
  return b.write_string(string_from_bytes_unchecked([byte as u8]));
}

// `(b).write_u64(n)` — append `n` in decimal. The digits are static
// one-byte literals, so a digit costs one write_string append and no
// allocation of its own; that append still copies the buffer once it
// outgrows the inline form. `n.to_string()` makes a whole string per
// call, which is most of what a counting utility's output loop spends.
pub function (b: BufWriter) write_u64(n: u64): BufWriter {
  var p: u64 = 1 as u64;
  while (n / p >= 10 as u64) {
    p = p * (10 as u64);
  }
  var out: BufWriter = b;
  var rest: u64 = n;
  while (p > 0 as u64) {
    out = out.write_string(__digit_literal((rest / p) as i32));
    rest = rest % p;
    p = p / (10 as u64);
  }
  return out;
}

// `(b).write_i64(n)` — `write_u64` with a sign.
pub function (b: BufWriter) write_i64(n: i64): BufWriter {
  if (n < 0 as i64) {
    return b.write_string("-").write_u64((0 as u64) - (n as u64));
  }
  return b.write_u64(n as u64);
}

// The ten digits as literals: a static string each, never allocated.
function __digit_literal(d: i32): string {
  if (d == 0) { return "0"; }
  if (d == 1) { return "1"; }
  if (d == 2) { return "2"; }
  if (d == 3) { return "3"; }
  if (d == 4) { return "4"; }
  if (d == 5) { return "5"; }
  if (d == 6) { return "6"; }
  if (d == 7) { return "7"; }
  if (d == 8) { return "8"; }
  return "9";
}

// `(b).flush()` — write whatever is buffered. Rebind the result.
pub function (b: BufWriter) flush(): BufWriter {
  if (b.buf.len() == 0) {
    return b;
  }
  var flushed: BufWriter = __buf_writer_put(b, b.buf);
  return BufWriter { ...flushed, buf: "" };
}

// `(b).close()` — flush, then close the Writer: fclose. The error is the
// close's when that fails, else the flush's; pending bytes behind a
// sticky error count as a failed write, as the fd already refused them.
pub function (b: BufWriter) close(): Option[IoError] {
  var flushed: BufWriter = b.flush();
  match (b.w.close()) {
    Some(e) => {
      return Some(e);
    },
    None => {}
  }
  if (b.buf.len() > 0) {
    return flushed.error();
  }
  return None;
}

// `(b).error()` — the first write failure, if any.
pub function (b: BufWriter) error(): Option[IoError] {
  return b.err;
}

// `(b).buffered()` — bytes held back so far.
pub function (b: BufWriter) buffered(): i32 {
  return b.buf.len();
}

// One write(2) of `s`, recording the first failure.
function __buf_writer_put(b: BufWriter, s: string): BufWriter {
  match (b.err) {
    Some(_) => {
      return b;
    },
    None => {}
  }
  match (b.w.write(s)) {
    Some(e) => {
      return BufWriter { ...b, err: Some(e) };
    },
    None => {
      return b;
    }
  }
}

// ---- LineReader ------------------------------------------------------------
//
// Lines from a Reader, one per call, read in `chunk_size`-byte
// chunks. A line INCLUDES its terminating byte when the input had
// one, so a caller can tell a final unterminated line from a
// terminated one — cat, wc, nl and the rest of the line utilities
// all care. The terminator is a parameter because `-z` (NUL-
// terminated lines) is common in coreutils.
//
// A failed read ends the input the way EOF does and is held in `err`
// for the caller to read back with `.error()` — the same sticky-error
// contract BufWriter has for writes, and the reason a directory
// operand is distinguishable from an empty file (#8700).
//
// Cursor idiom (docs/CURSOR-IDIOM.md): `var (line, lr) = lr.next_line();`.
pub struct LineReader { r: Reader, chunk: string, pos: i32, eof: boolean, term: i32, chunk_size: i32, err: Option[IoError] }

// `line_reader_new(r, term, chunk_size)` — read lines from `r`
// ending in byte `term`.
pub function line_reader_new(r: Reader, term: i32, chunk_size: i32): LineReader {
  return LineReader { r: r, chunk: "", pos: 0, eof: false, term: term, chunk_size: chunk_size, err: None };
}

// `(lr).error()` — the read failure that ended the input, if one did.
pub function (lr: LineReader) error(): Option[IoError] {
  return lr.err;
}

// `(lr).next_line()` — the next line, or None at end of input.
pub function (lr: LineReader) next_line(): (Option[string], LineReader) {
  var s: LineReader = lr;
  var tail: string = "";
  while (true) {
    var j: i32 = __memchr(s.chunk, s.term, s.pos);
    if (j >= 0) {
      var line: string = tail + slice_unchecked(s.chunk, s.pos, j + 1);
      return (Some(line), LineReader { ...s, pos: j + 1 });
    }
    if (s.pos < s.chunk.len()) {
      tail = tail + slice_unchecked(s.chunk, s.pos, s.chunk.len());
    }
    if (s.eof) {
      s = LineReader { ...s, chunk: "", pos: 0 };
      if (tail.len() == 0) {
        return (None, s);
      }
      return (Some(tail), s);
    }
    match (s.r.read_chunk(s.chunk_size)) {
      Ok(c) => {
        if (c.len() == 0) {
          s = LineReader { ...s, chunk: "", pos: 0, eof: true };
        } else {
          s = LineReader { ...s, chunk: c, pos: 0 };
        }
      },
      Err(e) => {
        s = LineReader { ...s, chunk: "", pos: 0, eof: true, err: Some(e) };
      }
    }
  }
  return (None, s);
}

// `(lr).next_chunk()` — the rest of the current chunk plus every
// following chunk, unsplit, for a caller that has finished with lines
// and wants the remaining bytes as fast as they arrive. None at end
// of input.
pub function (lr: LineReader) next_chunk(): (Option[string], LineReader) {
  var s: LineReader = lr;
  if (s.pos < s.chunk.len()) {
    var rest: string = slice_unchecked(s.chunk, s.pos, s.chunk.len()) + "";
    return (Some(rest), LineReader { ...s, chunk: "", pos: 0 });
  }
  if (s.eof) {
    return (None, s);
  }
  match (s.r.read_chunk(s.chunk_size)) {
    Ok(c) => {
      if (c.len() == 0) {
        return (None, LineReader { ...s, eof: true });
      }
      return (Some(c), s);
    },
    Err(e) => {
      return (None, LineReader { ...s, eof: true, err: Some(e) });
    }
  }
}
