// std/io_buffered — in-memory buffered writers + readers,
// Tier-C Rec §13 Phase 1 (docs/STDLIB-DESIGN-RESEARCH.md
// Rec §5).
//
// BytesWriter accumulates bytes in memory. Its write_string and write_bytes
// methods return an updated BytesWriter. The fd-backed Writer instead has
// write(string) and write_bytes([u8]), which return Option[IoError].
//
// Build a byte buffer without a host write for each piece:
//
//   let w: BytesWriter = bytes_writer_new();
//   w = w.write_string("header\n");
//   w = w.write_bytes([0 as u8, 255 as u8]);
//   let bytes: u8[] = w.into_bytes();
//
// `BufWriter` wraps an fd-backed Writer with a flush threshold so
// per-write syscall overhead drops to per-block, and `LineReader`
// wraps a Reader and yields one line per call without buffering
// the whole input. Both are below.
//
import "core/mem";
import "std/string";
import "std/utf8" as utf8;

// `bytes_writer_new()` — fresh empty BytesWriter.
pub function bytes_writer_new(): BytesWriter {
  let empty: u8[] = [];
  return BytesWriter { data: empty };
}

// `(w: BytesWriter).write_string(s)` — append a string's
// bytes. Rebind the returned writer to keep the appended bytes.
pub function (w: BytesWriter) write_string(s: string): BytesWriter {
  // A VIEW, not a copy: the loop below only reads bs, and the
  // view never outlives s (a live parameter), so `bytes()` here
  // would allocate and copy the whole string for nothing.
  let bs: [u8] = s.as_bytes();
  let data: u8[] = w.data;
  let i: i32 = 0;
  while (i < bs.len()) {
    data = data.append(bs[i]);
    i = i + 1;
  }
  return BytesWriter { ...w, data: data };
}

// `(w: BytesWriter).write_bytes(bs)` — append a byte slice
// directly (no string round-trip).
pub function (w: BytesWriter) write_bytes(bs: u8[]): BytesWriter {
  let data: u8[] = w.data;
  let i: i32 = 0;
  while (i < bs.len()) {
    data = data.append(bs[i]);
    i = i + 1;
  }
  return BytesWriter { ...w, data: data };
}

// `(w: BytesWriter).write_byte(b)` — single-byte write.
pub function (w: BytesWriter) write_byte(b: i32): BytesWriter {
  return BytesWriter { ...w, data: w.data.append(b as u8) };
}

// `(w: BytesWriter).len()` — total bytes written so far.
pub function (w: BytesWriter) len(): i32 {
  return w.data.len();
}

// `(w: BytesWriter).is_empty()` — convenience over
// `.len() == 0`.
pub function (w: BytesWriter) is_empty(): boolean {
  return w.data.len() == 0;
}

// `(w: BytesWriter).into_bytes()` — return the accumulated
// buffer as a `u8[]`. Consumer-side; the BytesWriter remains
// usable but callers typically discard it after this.
pub function (w: BytesWriter) into_bytes(): u8[] {
  return w.data;
}

// `(w: BytesWriter).into_string()` validates the complete buffer as UTF-8.
// Empty and valid buffers yield Some(text); malformed bytes yield None.
// Conversion leaves the writer unchanged. Use into_bytes for arbitrary bytes.
pub function (w: BytesWriter) into_string(): Option[string] {
  return utf8.from_bytes(w.data);
}

// `(w: BytesWriter).reset(): BytesWriter` — return a writer with
// an empty buffer. Functional (immutable data structures): rebind
// the result — `w = w.reset()`.
pub function (w: BytesWriter) reset(): BytesWriter {
  let empty: u8[] = [];
  return BytesWriter { ...w, data: empty };
}

// ---- BufWriter -------------------------------------------------------------
//
// A Writer with a buffer in front of it. Writes accumulate in `buf`
// and reach the fd in one write(2) per `cap` bytes; a write that is
// itself at least `cap` bytes goes straight through rather than being
// copied twice. A write failure is sticky: `err` holds the first
// IoError, later writes are dropped, and the caller reads it back
// with `.error()` — the C stdio contract, where a failed flush is
// found at the next write or at close.
//
// The buffer is a capacity-carrying builder (#8773), so a write is a
// compare, a memcpy and a length store rather than a call that re-derives
// the buffer's capacity from the allocator's size class every time.
//
// A builder is a HANDLE, which changes what copying a BufWriter means: two
// copies share one buffer rather than each owning one. The functional
// rebind this API is written in (`b = b.write_string(s)`) never keeps the
// old value, so that is invisible to callers -- but a caller that
// deliberately kept two copies to get two buffers would now get one.
// The handle is freed when the last copy dies, so a writer over stdout
// that is flushed and never closed still gives its buffer back.
pub struct BufWriter { w: Writer, buf: BufBlock, cap: i32, err: Option[IoError] }

// The builder behind a BufWriter, freed with the last writer holding it.
pub struct BufBlock { h: usize }

impl mem.Drop for BufBlock {
  function drop(self: BufBlock): void {
    buf_free(self.h);
  }
}

// `buf_writer_new(w, cap)` — buffer `w` with a `cap`-byte threshold.
pub function buf_writer_new(w: Writer, cap: i32): BufWriter {
  return BufWriter { w: w, buf: BufBlock { h: buf_new(cap) }, cap: cap, err: None };
}

// `(b).write_string(s)` — append `s`, flushing when the threshold is
// reached. Rebind: `b = b.write_string(s);`.
pub function (b: BufWriter) write_string(s: string): BufWriter {
  // A write at least as big as the threshold goes straight to the fd when
  // nothing is buffered, rather than being copied in and straight back out.
  if (buf_len(b.buf.h) == 0 && s.len() >= b.cap) {
    return __buf_writer_put(b, s);
  }
  buf_push(b.buf.h, s);
  if (buf_len(b.buf.h) < b.cap) {
    return b;
  }
  return b.flush();
}

// Append raw bytes, bypassing the buffer for a full block when it is empty.
pub function (b: BufWriter) write_bytes(bytes: u8[]): BufWriter {
  if (buf_len(b.buf.h) == 0 && bytes.len() >= b.cap) {
    return __buf_writer_put_bytes(b, bytes);
  }
  buf_push_bytes_range(b.buf.h, bytes, 0, bytes.len());
  return b.settle();
}

// Append a clamped raw range without allocating an intermediate array.
pub function (b: BufWriter) write_bytes_range(bytes: u8[], lo: i32, hi: i32): BufWriter {
  if (lo <= 0 && hi >= bytes.len()) {
    return b.write_bytes(bytes);
  }
  buf_push_bytes_range(b.buf.h, bytes, lo, hi);
  return b.settle();
}

// `(b).write_range(s, lo, hi)` — append `s[lo:hi]` without building the
// substring first. The shape every line-oriented utility's output loop is
// made of, and the reason the builder carries a range push at all.
pub function (b: BufWriter) write_range(s: string, lo: i32, hi: i32): BufWriter {
  buf_push_range(b.buf.h, s, lo, hi);
  if (buf_len(b.buf.h) < b.cap) {
    return b;
  }
  return b.flush();
}

// `(b).write_mapped(s, table)` — append each byte `c` of `s` as
// `table[c]`, or unchanged when `c` is past the table's end: a byte
// translation with no intermediate string.
pub function (b: BufWriter) write_mapped(s: string, table: u8[]): BufWriter {
  buf_push_mapped(b.buf.h, s, table);
  if (buf_len(b.buf.h) < b.cap) {
    return b;
  }
  return b.flush();
}

// `(b).write_filtered(s, drop)` — append each byte `c` of `s` whose
// `drop[c]` is zero, or that is past the table's end: a byte deletion with
// no intermediate string.
pub function (b: BufWriter) write_filtered(s: string, drop: u8[]): BufWriter {
  buf_push_filtered(b.buf.h, s, drop);
  if (buf_len(b.buf.h) < b.cap) {
    return b;
  }
  return b.flush();
}

// `(b).write_expanded(s, table)` — append each byte `c` of `s` as the
// record at `table[c * 8]`: a length byte (above 7 counts as 7), then the
// bytes. A byte whose record is not wholly inside the table is appended
// unchanged.
pub function (b: BufWriter) write_expanded(s: string, table: u8[]): BufWriter {
  buf_push_expanded(b.buf.h, s, table);
  if (buf_len(b.buf.h) < b.cap) {
    return b;
  }
  return b.flush();
}

// `(b).write_byte(byte)` — append one byte.
pub function (b: BufWriter) write_byte(byte: i32): BufWriter {
  buf_push_byte(b.buf.h, byte);
  if (buf_len(b.buf.h) < b.cap) {
    return b;
  }
  return b.flush();
}

// `(b).write_u64(n)` — append `n` in decimal.
pub function (b: BufWriter) write_u64(n: u64): BufWriter {
  buf_push_u64(b.buf.h, n);
  if (buf_len(b.buf.h) < b.cap) {
    return b;
  }
  return b.flush();
}

// `(b).write_i64(n)` — `write_u64` with a sign.
pub function (b: BufWriter) write_i64(n: i64): BufWriter {
  if (n < 0 as i64) {
    return b.write_string("-").write_u64(0 as u64 - n as u64);
  }
  return b.write_u64(n as u64);
}

// `buf_push_u64(h, n)` — `n` in decimal, pushed straight into a builder:
// `write_u64` for a loop that holds the `.handle()`. Two digits go in per
// push from a table of the hundred pairs, so one division buys two digits
// and a number under a hundred costs no division at all. The pushes go
// out most significant pair first, through the recursion.
pub function buf_push_u64(h: usize, n: u64): void {
  if (n < 100 as u64) {
    if (n < 10 as u64) {
      buf_push_byte(h, 48 + n as i32);
      return;
    }
    let k: i32 = n as i32 * 2;
    buf_push_range(h, digit_pairs(), k, k + 2);
    return;
  }
  let q: u64 = n / (100 as u64);
  buf_push_u64(h, q);
  let r: i32 = (n - q * (100 as u64)) as i32 * 2;
  buf_push_range(h, digit_pairs(), r, r + 2);
}

// `buf_push_i64(h, n)` — `buf_push_u64` with a sign.
pub function buf_push_i64(h: usize, n: i64): void {
  if (n < 0 as i64) {
    buf_push_byte(h, 45);
    buf_push_u64(h, 0 as u64 - n as u64);
    return;
  }
  buf_push_u64(h, n as u64);
}

// `buf_u64_len(n)` — how many bytes `buf_push_u64` writes for `n`, for a
// caller that pads the number to a field.
pub function buf_u64_len(n: u64): i32 {
  let d: i32 = 1;
  let p: u64 = 10 as u64;
  while (n >= p) {
    d = d + 1;
    if (d == 20) {
      return d;
    }
    p = p * (10 as u64);
  }
  return d;
}

// "00" through "99", each at twice its value: a static literal, never
// allocated.
pub function digit_pairs(): string {
  return "0001020304050607080910111213141516171819202122232425262728293031323334353637383940414243444546474849505152535455565758596061626364656667686970717273747576777879808182838485868788899091929394959697989900";
}

// `(b).flush()` — write whatever is buffered. Rebind the result.
pub function (b: BufWriter) flush(): BufWriter {
  if (buf_len(b.buf.h) == 0) {
    return b;
  }
  // The take rewinds the builder, so a sticky error still discards the
  // bytes the fd has already refused, as it did before.
  return __buf_writer_put_bytes(b, buf_take_bytes(b.buf.h));
}

// `(b).close()` — flush, then close the Writer: fclose. The error is the
// close's when that fails, else the flush's; pending bytes behind a
// sticky error count as a failed write, as the fd already refused them.
pub function (b: BufWriter) close(): Option[IoError] {
  // Read the pending count BEFORE the flush: the builder is shared between
  // `b` and `flushed`, so afterwards both report zero.
  let pending: i32 = buf_len(b.buf.h);
  let flushed: BufWriter = b.flush();
  let closed: Option[IoError] = b.w.close();
  match (closed) {
    Some(e) => {
      return Some(e);
    },
    None => {}
  }
  if (pending > 0) {
    return flushed.error();
  }
  return None;
}

// `(b).error()` — the first write failure, if any.
pub function (b: BufWriter) error(): Option[IoError] {
  return b.err;
}

// `(b).handle()` — the builder behind the writer. For an output loop that
// pushes several pieces per line: pushing the handle costs a compare and a
// memcpy, where going through `write_string` adds a method call, a struct
// rebuild and a threshold check to each piece. The caller owns asking
// `.buffered() >= cap` and flushing; the handle stays valid across a flush,
// which takes the bytes and re-arms the same builder, for as long as a copy
// of the writer is alive.
pub function (b: BufWriter) handle(): usize {
  return b.buf.h;
}

// `(b).settle()` — flush if what has been pushed since the last flush has
// reached the threshold. What a loop that pushed straight into `.handle()`
// must do at the end of each line, in place of the check `write_string` does
// for itself.
pub function (b: BufWriter) settle(): BufWriter {
  if (buf_len(b.buf.h) < b.cap) {
    return b;
  }
  return b.flush();
}

// `(b).buffered()` — bytes held back so far.
pub function (b: BufWriter) buffered(): i32 {
  return buf_len(b.buf.h);
}

// One write(2) of `s`, recording the first failure.
function __buf_writer_put(b: BufWriter, s: string): BufWriter {
  match (b.err) {
    Some(_) => {
      return b;
    },
    None => {}
  }
  match (b.w.write(s)) {
    Some(e) => {
      return BufWriter { ...b, err: Some(e) };
    },
    None => {
      return b;
    }
  }
}

// Buffered content can end inside a scalar or contain arbitrary mapped bytes.
// Keep it in the byte domain and retain the same first-error behavior.
function __buf_writer_put_bytes(b: BufWriter, bytes: u8[]): BufWriter {
  match (b.err) {
    Some(_) => {
      return b;
    },
    None => {}
  }
  match (b.w.write_bytes(bytes)) {
    Some(e) => {
      return BufWriter { ...b, err: Some(e) };
    },
    None => {
      return b;
    }
  }
}

// ---- ByteLineReader --------------------------------------------------------
//
// Raw records include their terminating byte. The reader remains borrowed:
// callers close it. Results own their bytes and survive later cursor reads.
// A read failure is sticky; a partial final record is returned before None.
pub struct ByteLineReader { r: Reader, chunk: u8[], pos: i32, eof: boolean, term: i32, chunk_size: i32, err: Option[IoError] }

pub function byte_line_reader_new(r: Reader, term: i32, chunk_size: i32): ByteLineReader {
  return ByteLineReader { r: r, chunk: [], pos: 0, eof: false, term: term, chunk_size: chunk_size, err: None };
}

pub function (lr: ByteLineReader) error(): Option[IoError] {
  return lr.err;
}

function copy_line_bytes(chunk: u8[], lo: i32, hi: i32): u8[] {
  let out: u8[] = __alloc_u8(hi - lo);
  let i: i32 = lo;
  while (i < hi) {
    out = out.with(i - lo, chunk[i]);
    i = i + 1;
  }
  return out;
}

function byte_line_end(chunk: u8[], pos: i32, term: i32): i32 {
  let end: i32 = __memchr_bytes(chunk, term, pos);
  if (end < 0) {
    return chunk.len();
  }
  return end;
}

pub function (lr: ByteLineReader) next_line_bytes(): (Option[u8[]], ByteLineReader) {
  let s: ByteLineReader = lr;
  // Allocate a builder only when a record spans chunks. Repeatedly copying
  // the accumulated prefix would make long records quadratic.
  let b: usize = 0 as usize;
  while (true) {
    let end: i32 = byte_line_end(s.chunk, s.pos, s.term);
    if (end < s.chunk.len()) {
      end = end + 1;
      if (b == 0 as usize) {
        return (Some(copy_line_bytes(s.chunk, s.pos, end)), ByteLineReader { ...s, pos: end });
      }
      buf_push_bytes_range(b, s.chunk, s.pos, end);
      let line: u8[] = buf_take_bytes(b);
      buf_free(b);
      return (Some(line), ByteLineReader { ...s, pos: end });
    }
    if (s.pos < s.chunk.len()) {
      if (b == 0 as usize) {
        b = buf_new(s.chunk.len() - s.pos);
      }
      buf_push_bytes_range(b, s.chunk, s.pos, s.chunk.len());
    }
    if (s.eof) {
      s = ByteLineReader { ...s, chunk: [], pos: 0 };
      if (b == 0 as usize) {
        return (None, s);
      }
      let tail: u8[] = buf_take_bytes(b);
      buf_free(b);
      return (Some(tail), s);
    }
    match (s.r.read_chunk_bytes(s.chunk_size)) {
      Ok(chunk) => {
        s = ByteLineReader { ...s, chunk: chunk, pos: 0, eof: chunk.len() == 0 };
      },
      Err(e) => {
        s = ByteLineReader { ...s, chunk: [], pos: 0, eof: true, err: Some(e) };
      }
    }
  }
  return (None, s);
}

// Switch from records to raw chunks without discarding the unread suffix.
pub function (lr: ByteLineReader) next_chunk_bytes(): (Option[u8[]], ByteLineReader) {
  let s: ByteLineReader = lr;
  if (s.pos < s.chunk.len()) {
    let rest: u8[] = copy_line_bytes(s.chunk, s.pos, s.chunk.len());
    return (Some(rest), ByteLineReader { ...s, chunk: [], pos: 0 });
  }
  if (s.eof) {
    return (None, s);
  }
  match (s.r.read_chunk_bytes(s.chunk_size)) {
    Ok(chunk) => {
      if (chunk.len() == 0) {
        return (None, ByteLineReader { ...s, eof: true });
      }
      return (Some(chunk), s);
    },
    Err(e) => {
      return (None, ByteLineReader { ...s, eof: true, err: Some(e) });
    }
  }
}

// ---- LineReader ------------------------------------------------------------
//
// Lines from a Reader, one per call, read in `chunk_size`-byte
// chunks. A line INCLUDES its terminating byte when the input had
// one, so a caller can tell a final unterminated line from a
// terminated one — cat, wc, nl and the rest of the line utilities
// all care. The terminator is a parameter because `-z` (NUL-
// terminated lines) is common in coreutils.
//
// A failed read ends the input the way EOF does and is held in `err`
// for the caller to read back with `.error()` — the same sticky-error
// contract BufWriter has for writes, and the reason a directory
// operand is distinguishable from an empty file (#8700).
//
// Cursor idiom (docs/CURSOR-IDIOM.md): `let (line, lr) = lr.next_line();`.
pub struct LineReader { r: Reader, chunk: string, pos: i32, eof: boolean, term: i32, chunk_size: i32, err: Option[IoError] }

// `line_reader_new(r, term, chunk_size)` — read lines from `r`
// ending in byte `term`.
pub function line_reader_new(r: Reader, term: i32, chunk_size: i32): LineReader {
  return LineReader { r: r, chunk: "", pos: 0, eof: false, term: term, chunk_size: chunk_size, err: None };
}

// `(lr).error()` — the read failure that ended the input, if one did.
pub function (lr: LineReader) error(): Option[IoError] {
  return lr.err;
}

// `(lr).next_line()` — the next line, or None at end of input.
pub function (lr: LineReader) next_line(): (Option[string], LineReader) {
  let s: LineReader = lr;
  let tail: string = "";
  while (true) {
    let j: i32 = __memchr(s.chunk, s.term, s.pos);
    if (j >= 0) {
      let line: string = tail + slice_unchecked(s.chunk, s.pos, j + 1);
      return (Some(line), LineReader { ...s, pos: j + 1 });
    }
    if (s.pos < s.chunk.len()) {
      tail = tail + slice_unchecked(s.chunk, s.pos, s.chunk.len());
    }
    if (s.eof) {
      s = LineReader { ...s, chunk: "", pos: 0 };
      if (tail.len() == 0) {
        return (None, s);
      }
      return (Some(tail), s);
    }
    match (s.r.read_chunk(s.chunk_size)) {
      Ok(c) => {
        if (c.len() == 0) {
          s = LineReader { ...s, chunk: "", pos: 0, eof: true };
        } else {
          s = LineReader { ...s, chunk: c, pos: 0 };
        }
      },
      Err(e) => {
        s = LineReader { ...s, chunk: "", pos: 0, eof: true, err: Some(e) };
      }
    }
  }
  return (None, s);
}

// `(lr).next_chunk()` — the rest of the current chunk plus every
// following chunk, unsplit, for a caller that has finished with lines
// and wants the remaining bytes as fast as they arrive. None at end
// of input.
pub function (lr: LineReader) next_chunk(): (Option[string], LineReader) {
  let s: LineReader = lr;
  if (s.pos < s.chunk.len()) {
    let rest: string = slice_unchecked(s.chunk, s.pos, s.chunk.len()) + "";
    return (Some(rest), LineReader { ...s, chunk: "", pos: 0 });
  }
  if (s.eof) {
    return (None, s);
  }
  match (s.r.read_chunk(s.chunk_size)) {
    Ok(c) => {
      if (c.len() == 0) {
        return (None, LineReader { ...s, eof: true });
      }
      return (Some(c), s);
    },
    Err(e) => {
      return (None, LineReader { ...s, eof: true, err: Some(e) });
    }
  }
}
