// std/pmap — a persistent hash map with structural sharing.
//
// `PMap[K, V]` is a hash array mapped trie (Bagwell's HAMT, the shape
// behind Clojure's and Scala's immutable hash maps) keyed by any type
// with `core/cmp.Hash + core/cmp.Eq`. Every operation is value-
// returning:
//
//   import "std/pmap";
//   let m: pmap.PMap[string, i32] = pmap.pmap_new();
//   m = m.insert("a", 1);
//   let snapshot: pmap.PMap[string, i32] = m;   // O(1), shares every node
//   m = m.insert("b", 2);                       // snapshot is unchanged
//   m.get("b");         // Some(2)
//   snapshot.len();     // 1
//
// # Two paths, one API
//
// An update rebuilds the O(log32 n) nodes on the path to the key —
// at most seven, because the hash is 32 bits and each level consumes
// five of them — and shares everything else with the input. Which of
// two things happens to those path nodes is decided by the compiler,
// not by this module:
//
//   - **Shared** (another binding still holds the input, as `snapshot`
//     above): the path nodes and their child arrays are freshly
//     allocated and the input is left intact.
//   - **Unique** (the input's binding dies at the call, as in
//     `m = m.insert(k, v)`): the reference-counting reuse pass writes
//     the new nodes into the old boxes and the child-array update runs
//     in place, so the same source line allocates nothing.
//
// There is no transient/builder API and no `own` on the receiver: an
// `own` receiver would forbid `let m2 = m.insert(k, v)` (E051), which
// is the whole point of a persistent map.
//
// # Hashing, equality, order
//
// Keys are hashed by the bound's `hash` (mixed once more here, so a
// weak derived hash still spreads over the trie) and compared by its
// `eq`, never the `==` operator (which resolves through a `Type.eq`
// lookup not visible from this module, #6846) — so a
// `@derive(cmp.Eq, cmp.Hash)` struct or enum works as a key. Keys with
// equal hashes live in one collision node and are told apart by `eq`.
//
// Iteration (`keys()`, `values()`, `fold`, `for_each`) visits entries
// in HASH order, which is stable for a given set of keys but is not
// insertion order and is not sorted; for either of those use
// `core/map` (insertion order, mutable-looking) or `std/ordmap` (key
// order, persistent).
//
// # Complexity
//
//   insert / get / contains / remove          O(log32 n), at most 7 levels
//   len                                       O(1) (every branch caches its size)
//   union / intersection / difference         O(m log32 n) for the smaller side m
//   keys / values / fold / for_each / filter / map_values   O(n)
import "core/cmp";
import "core/iter";
import "std/i32";

// The trie. `Leaf` is (hash, key, value). `Coll` holds the leaves of
// keys with one full 32-bit hash, so its array is only ever scanned by
// `eq`. `Branch` is (bitmap, size, children): bit i of the bitmap says
// whether the child for 5-bit index i is present, and the children are
// packed in index order, so a child's slot is the popcount of the bits
// below its own; `size` is the number of leaves in the subtree. `Empty`
// is only ever the root of an empty map. The map is the trie: construct
// one only through `pmap_new` / `from`.
pub enum PMap[K, V] { Empty, Leaf(i32, K, V), Coll(i32, PMap[K, V][]), Branch(i32, i32, PMap[K, V][]) }

// `pmap_new()` — the empty map. The key and value types are fixed by
// the annotation at the binding (`let m: PMap[string, i32] =
// pmap_new();`).
pub function pmap_new[K, V](): PMap[K, V] {
  let e: PMap[K, V] = Empty;
  return e;
}

// `from(pairs)` — the map holding each `(k, v)`. A key repeated in
// `pairs` takes its LAST value.
pub function from[K: cmp.Hash + cmp.Eq, V](pairs: (K, V)[]): PMap[K, V] {
  let m: PMap[K, V] = pmap_new();
  for p in pairs {
    m = m.insert(p.0, p.1);
  }
  return m;
}

// ---- hashing and bit helpers -----------------------------------------
// node_mix is the murmur3 32-bit finaliser: an avalanche over a hash
// whose entropy may sit in its low bits (a derived `h * 31 + f` hash),
// so every 5-bit slice of the result is usable as a trie index. All
// arithmetic is wrapping i32; only the logical shifts go through u32.
function node_mix(x: i32): i32 {
  let h: i32 = x;
  h = h ^ (h as u32 >> 16 as u32) as i32;
  h = h * (0 - 2048144789);  // 0x85ebca6b
  h = h ^ (h as u32 >> 13 as u32) as i32;
  h = h * (0 - 1028477387);  // 0xc2b2ae35
  h = h ^ (h as u32 >> 16 as u32) as i32;
  return h;
}

// node_frag is the 5-bit slice of `h` selected at trie depth `shift`
// (shift = 0, 5, 10, … 30; the last slice has 2 bits).
function node_frag(h: i32, shift: i32): i32 {
  return (h as u32 >> shift as u32) as i32 & 31;
}

// node_slot is the child index of `bit` in a branch with `bitmap`: the
// number of present children below it.
function node_slot(bitmap: i32, bit: i32): i32 {
  return (bitmap & bit - 1).count_ones();
}

function node_size[K, V](n: PMap[K, V]): i32 {
  match (n) {
    Empty => {
      return 0;
    },
    Leaf(h, k, v) => {
      return 1;
    },
    Coll(h, leaves) => {
      return leaves.len();
    },
    Branch(bm, s, kids) => {
      return s;
    }
  }
}

// node_insert_at inserts `x` at index `i` of `xs`, shifting the rest up.
function node_insert_at[K, V](xs: PMap[K, V][], i: i32, x: PMap[K, V]): PMap[K, V][] {
  let out: PMap[K, V][] = [];
  let j: i32 = 0;
  while (j < i) {
    out = out.append(xs[j]);
    j = j + 1;
  }
  out = out.append(x);
  while (j < xs.len()) {
    out = out.append(xs[j]);
    j = j + 1;
  }
  return out;
}

// node_remove_at drops index `i` of `xs`.
function node_remove_at[K, V](xs: PMap[K, V][], i: i32): PMap[K, V][] {
  let out: PMap[K, V][] = [];
  let j: i32 = 0;
  while (j < xs.len()) {
    if (j != i) {
      out = out.append(xs[j]);
    }
    j = j + 1;
  }
  return out;
}

// node_pair builds the smallest subtree holding two leaves whose hashes
// differ (or a collision node when they do not), starting at depth
// `shift`.
function node_pair[K, V](a: PMap[K, V], ah: i32, b: PMap[K, V], bh: i32, shift: i32): PMap[K, V] {
  if (ah == bh) {
    return Coll(ah, [a, b]);
  }
  if (shift >= 32) {
    return Coll(ah, [a, b]);
  }
  let fa: i32 = node_frag(ah, shift);
  let fb: i32 = node_frag(bh, shift);
  if (fa == fb) {
    let inner: PMap[K, V] = node_pair(a, ah, b, bh, shift + 5);
    return Branch(1 << fa, 2, [inner]);
  }
  if (fa < fb) {
    return Branch(1 << fa | 1 << fb, 2, [a, b]);
  }
  return Branch(1 << fa | 1 << fb, 2, [b, a]);
}

// node_coll_index is the index of the leaf holding `k` in a collision
// node's array, or -1.
function node_coll_index[K: cmp.Hash + cmp.Eq, V](leaves: PMap[K, V][], k: K): i32 {
  let i: i32 = 0;
  while (i < leaves.len()) {
    match (leaves[i]) {
      Leaf(eh, ek, ev) => {
        if (ek.eq(k)) {
          return i;
        }
      },
      Empty => {},
      Coll(xh, xs) => {},
      Branch(xb, xs, xk) => {}
    }
    i = i + 1;
  }
  return 0 - 1;
}

// node_insert returns the trie with `k -> v` added or replaced; `h` is
// the mixed hash of `k`. The match consumes `n`, so on the unique path
// each level's box is released and its child array rewritten in place:
// the arms rebuild the node from its bindings rather than reading `n`
// again, and the Branch arm takes the child OUT of its slot
// (`kids.with(idx, Empty)`) before descending, so it reaches the recursive
// call at its own count; see docs/PERSISTENT-COLLECTIONS.md.
function node_insert[K: cmp.Hash + cmp.Eq, V](n: PMap[K, V], h: i32, shift: i32, k: K, v: V): PMap[K, V] {
  match (n) {
    Empty => {
      return Leaf(h, k, v);
    },
    Leaf(lh, lk, lv) => {
      if (lh == h && lk.eq(k)) {
        return Leaf(h, k, v);
      }
      let fresh: PMap[K, V] = Leaf(h, k, v);
      return node_pair(Leaf(lh, lk, lv), lh, fresh, h, shift);
    },
    Coll(ch, leaves) => {
      if (ch != h) {
        let fresh: PMap[K, V] = Leaf(h, k, v);
        return node_pair(Coll(ch, leaves), ch, fresh, h, shift);
      }
      let i: i32 = node_coll_index(leaves, k);
      if (i >= 0) {
        return Coll(ch, leaves.with(i, Leaf(h, k, v)));
      }
      return Coll(ch, leaves.append(Leaf(h, k, v)));
    },
    Branch(bm, s, kids) => {
      let bit: i32 = 1 << node_frag(h, shift);
      let idx: i32 = node_slot(bm, bit);
      if ((bm & bit) == 0) {
        let fresh: PMap[K, V] = Leaf(h, k, v);
        let grown: PMap[K, V][] = node_insert_at(kids, idx, fresh);
        return Branch(bm | bit, s + 1, grown);
      }
      let e: PMap[K, V] = Empty;
      let child: PMap[K, V] = kids[idx];
      let rest: PMap[K, V][] = kids.with(idx, e);
      let old: i32 = node_size(child);
      child = node_insert(child, h, shift + 5, k, v);
      let added: i32 = node_size(child) - old;
      return Branch(bm, s + added, rest.with(idx, child));
    }
  }
}

// node_find returns the leaf holding `k`, or Empty. Iterative through
// the branches; only a collision node is scanned.
function node_find[K: cmp.Hash + cmp.Eq, V](n: PMap[K, V], h: i32, k: K): PMap[K, V] {
  let cur: PMap[K, V] = n;
  let shift: i32 = 0;
  let descending: boolean = true;
  while (descending) {
    match (cur) {
      Empty => {
        return cur;
      },
      Leaf(lh, lk, lv) => {
        if (lk.eq(k)) {
          return cur;
        }
        descending = false;
      },
      Coll(ch, leaves) => {
        let i: i32 = node_coll_index(leaves, k);
        if (i >= 0) {
          return leaves[i];
        }
        descending = false;
      },
      Branch(bm, s, kids) => {
        let bit: i32 = 1 << node_frag(h, shift);
        if ((bm & bit) == 0) {
          descending = false;
        } else {
          cur = kids[node_slot(bm, bit)];
          shift = shift + 5;
        }
      }
    }
  }
  let e: PMap[K, V] = Empty;
  return e;
}

// node_is_branch: true for a Branch node (a Leaf or Coll can stand alone
// as a parent's only child; a Branch cannot, because its hash prefix
// would be lost).
function node_is_branch[K, V](n: PMap[K, V]): boolean {
  match (n) {
    Branch(bm, s, kids) => {
      return true;
    },
    Empty => {
      return true;
    },
    Leaf(h, k, v) => {
      return false;
    },
    Coll(h, xs) => {
      return false;
    }
  }
}

// node_remove_branch is the Branch arm of node_remove. A branch left with
// a single leaf or collision child collapses to that child, so a trie's
// shape depends only on its keys.
function node_remove_branch[K: cmp.Hash + cmp.Eq, V](n: PMap[K, V], bm: i32, s: i32, kids: PMap[K, V][], h: i32, shift: i32, k: K): PMap[K, V] {
  let bit: i32 = 1 << node_frag(h, shift);
  if ((bm & bit) == 0) {
    return n;
  }
  let idx: i32 = node_slot(bm, bit);
  let old: i32 = node_size(kids[idx]);
  let child: PMap[K, V] = node_remove(kids[idx], h, shift + 5, k);
  let now: i32 = node_size(child);
  if (now == old) {
    return n;
  }
  if (now > 0) {
    if (kids.len() == 1 && !node_is_branch(child)) {
      return child;
    }
    return Branch(bm, s - 1, kids.with(idx, child));
  }
  if (kids.len() == 1) {
    return child;
  }
  let rest: PMap[K, V][] = node_remove_at(kids, idx);
  if (rest.len() == 1 && !node_is_branch(rest[0])) {
    return rest[0];
  }
  return Branch(bm & 0 - 1 - bit, s - 1, rest);
}

// node_remove returns the trie without `k`; the input itself when `k`
// is absent.
function node_remove[K: cmp.Hash + cmp.Eq, V](n: PMap[K, V], h: i32, shift: i32, k: K): PMap[K, V] {
  match (n) {
    Empty => {
      return n;
    },
    Leaf(lh, lk, lv) => {
      if (lh == h && lk.eq(k)) {
        let e: PMap[K, V] = Empty;
        return e;
      }
      return n;
    },
    Coll(ch, leaves) => {
      if (ch != h) {
        return n;
      }
      let i: i32 = node_coll_index(leaves, k);
      if (i < 0) {
        return n;
      }
      if (leaves.len() == 2) {
        return leaves[1 - i];
      }
      return Coll(ch, node_remove_at(leaves, i));
    },
    Branch(bm, s, kids) => {
      return node_remove_branch(n, bm, s, kids, h, shift, k);
    }
  }
}

// ---- traversals -------------------------------------------------------
//
// The accumulator-threading helpers take their array as `own` and are
// called in the self-reassigning form `acc = f(n, acc)`, so the append
// runs on a uniquely-held buffer and grows it in place.
// The key / value walks recurse over the child index rather than
// looping, so the `own` accumulator is consumed once per frame in the
// self-reassigning form (an `own` value consumed inside a loop is not
// reclaimed in place).
function node_keys_into[K, V](n: PMap[K, V], own acc: K[]): K[] {
  match (n) {
    Empty => {
      return acc;
    },
    Leaf(h, k, v) => {
      acc = acc.append(k);
      return acc;
    },
    Coll(h, leaves) => {
      acc = node_keys_kids(leaves, 0, acc);
      return acc;
    },
    Branch(bm, s, kids) => {
      acc = node_keys_kids(kids, 0, acc);
      return acc;
    }
  }
}

function node_keys_kids[K, V](kids: PMap[K, V][], i: i32, own acc: K[]): K[] {
  if (i >= kids.len()) {
    return acc;
  }
  acc = node_keys_into(kids[i], acc);
  acc = node_keys_kids(kids, i + 1, acc);
  return acc;
}

function node_values_into[K, V](n: PMap[K, V], own acc: V[]): V[] {
  match (n) {
    Empty => {
      return acc;
    },
    Leaf(h, k, v) => {
      acc = acc.append(v);
      return acc;
    },
    Coll(h, leaves) => {
      acc = node_values_kids(leaves, 0, acc);
      return acc;
    },
    Branch(bm, s, kids) => {
      acc = node_values_kids(kids, 0, acc);
      return acc;
    }
  }
}

function node_values_kids[K, V](kids: PMap[K, V][], i: i32, own acc: V[]): V[] {
  if (i >= kids.len()) {
    return acc;
  }
  acc = node_values_into(kids[i], acc);
  acc = node_values_kids(kids, i + 1, acc);
  return acc;
}

function node_entries_into[K, V](n: PMap[K, V], own acc: (K, V)[]): (K, V)[] {
  match (n) {
    Empty => {
      return acc;
    },
    Leaf(h, k, v) => {
      acc = acc.append((k, v));
      return acc;
    },
    Coll(h, leaves) => {
      acc = node_entries_kids(leaves, 0, acc);
      return acc;
    },
    Branch(bm, s, kids) => {
      acc = node_entries_kids(kids, 0, acc);
      return acc;
    }
  }
}

function node_entries_kids[K, V](kids: PMap[K, V][], i: i32, own acc: (K, V)[]): (K, V)[] {
  if (i >= kids.len()) {
    return acc;
  }
  acc = node_entries_into(kids[i], acc);
  acc = node_entries_kids(kids, i + 1, acc);
  return acc;
}

function node_fold[K, V, A](n: PMap[K, V], init: A, f: (A, K, V) => A): A {
  match (n) {
    Empty => {
      return init;
    },
    Leaf(h, k, v) => {
      return f(init, k, v);
    },
    Coll(h, leaves) => {
      let a: A = init;
      let i: i32 = 0;
      while (i < leaves.len()) {
        a = node_fold(leaves[i], a, f);
        i = i + 1;
      }
      return a;
    },
    Branch(bm, s, kids) => {
      let a: A = init;
      let i: i32 = 0;
      while (i < kids.len()) {
        a = node_fold(kids[i], a, f);
        i = i + 1;
      }
      return a;
    }
  }
}

function node_for_each[K, V](n: PMap[K, V], f: (K, V) => void): void {
  match (n) {
    Empty => {
      return;
    },
    Leaf(h, k, v) => {
      f(k, v);
    },
    Coll(h, leaves) => {
      let i: i32 = 0;
      while (i < leaves.len()) {
        node_for_each(leaves[i], f);
        i = i + 1;
      }
    },
    Branch(bm, s, kids) => {
      let i: i32 = 0;
      while (i < kids.len()) {
        node_for_each(kids[i], f);
        i = i + 1;
      }
    }
  }
}

// node_map_values rebuilds the trie with every value transformed; the
// shape, hashes, and sizes are unchanged.
function node_map_values[K, V, W](n: PMap[K, V], f: (V) => W): PMap[K, W] {
  match (n) {
    Empty => {
      let e: PMap[K, W] = Empty;
      return e;
    },
    Leaf(h, k, v) => {
      return Leaf(h, k, f(v));
    },
    Coll(h, leaves) => {
      let out: PMap[K, W][] = [];
      let i: i32 = 0;
      while (i < leaves.len()) {
        out = out.append(node_map_values(leaves[i], f));
        i = i + 1;
      }
      return Coll(h, out);
    },
    Branch(bm, s, kids) => {
      let out: PMap[K, W][] = [];
      let i: i32 = 0;
      while (i < kids.len()) {
        out = out.append(node_map_values(kids[i], f));
        i = i + 1;
      }
      return Branch(bm, s, out);
    }
  }
}

// node_prefix_ok: does `lh` agree with the path prefix `h` on the
// `shift` low bits already consumed above this node?
function node_prefix_ok(lh: i32, h: i32, shift: i32): boolean {
  if (shift == 0) {
    return true;
  }
  let keep: u32 = (32 - shift) as u32;
  return (lh as u32 << keep) as i32 == (h as u32 << keep) as i32;
}

// node_valid_coll: a collision node holds at least two leaves, all with
// its hash.
function node_valid_coll[K, V](ch: i32, leaves: PMap[K, V][]): boolean {
  if (leaves.len() < 2) {
    return false;
  }
  let i: i32 = 0;
  while (i < leaves.len()) {
    match (leaves[i]) {
      Leaf(lh, lk, lv) => {
        if (lh != ch) {
          return false;
        }
      },
      Empty => {
        return false;
      },
      Coll(xh, xs) => {
        return false;
      },
      Branch(xb, xs, xk) => {
        return false;
      }
    }
    i = i + 1;
  }
  return true;
}

// node_child_hash is the hash a Leaf / Coll child carries, or -1 for a
// Branch (which has no single hash) — used to check a child sits in the
// slot its hash selects.
function node_child_hash[K, V](n: PMap[K, V]): i32 {
  match (n) {
    Leaf(lh, lk, lv) => {
      return lh;
    },
    Coll(ch, xs) => {
      return ch;
    },
    Branch(bm, s, kids) => {
      return 0 - 1;
    },
    Empty => {
      return 0 - 1;
    }
  }
}

// node_valid_branch: the bitmap's popcount is the child count, no child
// is Empty, a lone child is a Branch (a lone leaf would have collapsed),
// every Leaf / Coll child sits in the slot its hash selects, and the
// cached size is the children's total.
function node_valid_branch[K, V](bm: i32, s: i32, kids: PMap[K, V][], h: i32, shift: i32): boolean {
  if (bm.count_ones() != kids.len() || kids.len() == 0) {
    return false;
  }
  if (kids.len() == 1 && !node_is_branch(kids[0])) {
    return false;
  }
  let total: i32 = 0;
  let i: i32 = 0;
  let frag: i32 = 0;
  while (frag < 32) {
    if ((bm & 1 << frag) != 0) {
      let child: PMap[K, V] = kids[i];
      let ch: i32 = node_child_hash(child);
      if (ch != 0 - 1 && node_frag(ch, shift) != frag) {
        return false;
      }
      if (!node_valid(child, h | frag << shift, shift + 5)) {
        return false;
      }
      total = total + node_size(child);
      i = i + 1;
    }
    frag = frag + 1;
  }
  return total == s;
}

// node_valid checks the structural invariants below a node reached
// through path prefix `h` at depth `shift`.
function node_valid[K, V](n: PMap[K, V], h: i32, shift: i32): boolean {
  match (n) {
    Empty => {
      return shift == 0;
    },
    Leaf(lh, lk, lv) => {
      return node_prefix_ok(lh, h, shift);
    },
    Coll(ch, leaves) => {
      return node_prefix_ok(ch, h, shift) && node_valid_coll(ch, leaves);
    },
    Branch(bm, s, kids) => {
      return node_valid_branch(bm, s, kids, h, shift);
    }
  }
}

// ---- public surface ---------------------------------------------------
// `len()` — the number of entries. O(1).
pub function (m: PMap[K, V]) len(): i32 {
  return node_size(m);
}

// `is_empty()` — true when there are no entries.
pub function (m: PMap[K, V]) is_empty(): boolean {
  return node_size(m) == 0;
}

// `insert(k, v)` — the map with `k -> v`; an existing `k` takes the new
// value. Never touches the receiver's nodes, so a snapshot taken
// before the call is unchanged after it.
pub function (m: PMap[K, V]) insert[K: cmp.Hash + cmp.Eq, V](k: K, v: V): PMap[K, V] {
  return node_insert(m, node_mix(k.hash()), 0, k, v);
}

// `remove(k)` — the map without `k`; the receiver unchanged when `k`
// is absent.
pub function (m: PMap[K, V]) remove[K: cmp.Hash + cmp.Eq, V](k: K): PMap[K, V] {
  return node_remove(m, node_mix(k.hash()), 0, k);
}

// `get(k)` — `Some(value)` when `k` is present.
pub function (m: PMap[K, V]) get[K: cmp.Hash + cmp.Eq, V](k: K): Option[V] {
  match (node_find(m, node_mix(k.hash()), k)) {
    Leaf(h, lk, lv) => {
      return Some(lv);
    },
    Empty => {
      return None;
    },
    Coll(h, xs) => {
      return None;
    },
    Branch(b, s, xs) => {
      return None;
    }
  }
}

// `get_or(k, fallback)` — the value at `k`, or `fallback`.
pub function (m: PMap[K, V]) get_or[K: cmp.Hash + cmp.Eq, V](k: K, fallback: V): V {
  match (node_find(m, node_mix(k.hash()), k)) {
    Leaf(h, lk, lv) => {
      return lv;
    },
    Empty => {
      return fallback;
    },
    Coll(h, xs) => {
      return fallback;
    },
    Branch(b, s, xs) => {
      return fallback;
    }
  }
}

// `contains(k)` — is `k` a key?
pub function (m: PMap[K, V]) contains[K: cmp.Hash + cmp.Eq, V](k: K): boolean {
  match (node_find(m, node_mix(k.hash()), k)) {
    Leaf(h, lk, lv) => {
      return true;
    },
    Empty => {
      return false;
    },
    Coll(h, xs) => {
      return false;
    },
    Branch(b, s, xs) => {
      return false;
    }
  }
}

// `update(k, init, f)` — the map with `k -> f(old)`, or `k -> f(init)`
// when `k` is absent.
pub function (m: PMap[K, V]) update[K: cmp.Hash + cmp.Eq, V](k: K, init: V, f: (V) => V): PMap[K, V] {
  let h: i32 = node_mix(k.hash());
  match (node_find(m, h, k)) {
    Leaf(lh, lk, lv) => {
      return node_insert(m, h, 0, k, f(lv));
    },
    _ => {
      return node_insert(m, h, 0, k, f(init));
    }
  }
}

// `keys()` / `values()` — the entries, in hash order.
pub function (m: PMap[K, V]) keys(): K[] {
  let acc: K[] = [];
  acc = node_keys_into(m, acc);
  return acc;
}

pub function (m: PMap[K, V]) values(): V[] {
  let acc: V[] = [];
  acc = node_values_into(m, acc);
  return acc;
}

// `iter()` — an Iterator over the `(key, value)` entries in hash order,
// which is what `for (k, v) in m` walks.
pub function (m: PMap[K, V]) iter(): iter.ArrayIter[(K, V)] {
  let acc: (K, V)[] = [];
  acc = node_entries_into(m, acc);
  return iter.of(acc);
}

// `fold(init, f)` — `f` over every entry in hash order.
pub function (m: PMap[K, V]) fold[K, V, A](init: A, f: (A, K, V) => A): A {
  return node_fold(m, init, f);
}

// `for_each(f)` — call `f(k, v)` on every entry in hash order.
pub function (m: PMap[K, V]) for_each(f: (K, V) => void): void {
  node_for_each(m, f);
}

// `map_values(f)` — the map with every value replaced by `f(value)`;
// keys and shape are unchanged.
pub function (m: PMap[K, V]) map_values[K, V, W](f: (V) => W): PMap[K, W] {
  return node_map_values(m, f);
}

// `filter(pred)` — the map of the entries `pred(k, v)` accepts.
pub function (m: PMap[K, V]) filter[K: cmp.Hash + cmp.Eq, V](pred: (K, V) => boolean): PMap[K, V] {
  let out: PMap[K, V] = pmap_new();
  let ks: K[] = m.keys();
  let vs: V[] = m.values();
  let i: i32 = 0;
  while (i < ks.len()) {
    if (pred(ks[i], vs[i])) {
      out = out.insert(ks[i], vs[i]);
    }
    i = i + 1;
  }
  return out;
}

// `merge(other)` — every entry of both; a key in both takes `other`'s
// value. The smaller map is folded into the larger, O(m log32 n).
pub function (m: PMap[K, V]) merge[K: cmp.Hash + cmp.Eq, V](other: PMap[K, V]): PMap[K, V] {
  if (m.len() >= other.len()) {
    let out: PMap[K, V] = m;
    let ks: K[] = other.keys();
    let vs: V[] = other.values();
    let i: i32 = 0;
    while (i < ks.len()) {
      out = out.insert(ks[i], vs[i]);
      i = i + 1;
    }
    return out;
  }
  let out: PMap[K, V] = other;
  let ks: K[] = m.keys();
  let vs: V[] = m.values();
  let i: i32 = 0;
  while (i < ks.len()) {
    if (!out.contains(ks[i])) {
      out = out.insert(ks[i], vs[i]);
    }
    i = i + 1;
  }
  return out;
}

// `entries()` — every `(key, value)` pair, in hash order.
pub function (m: PMap[K, V]) entries(): (K, V)[] {
  let out: (K, V)[] = [];
  let ks: K[] = m.keys();
  let vs: V[] = m.values();
  let i: i32 = 0;
  while (i < ks.len()) {
    out = out.append((ks[i], vs[i]));
    i = i + 1;
  }
  return out;
}

// `intersection(other)` — the entries whose key is in both, with THIS
// map's values.
pub function (m: PMap[K, V]) intersection[K: cmp.Hash + cmp.Eq, V](other: PMap[K, V]): PMap[K, V] {
  let out: PMap[K, V] = pmap_new();
  let ks: K[] = m.keys();
  let vs: V[] = m.values();
  let i: i32 = 0;
  while (i < ks.len()) {
    if (other.contains(ks[i])) {
      out = out.insert(ks[i], vs[i]);
    }
    i = i + 1;
  }
  return out;
}

// `difference(other)` — this map's entries whose key is NOT in `other`.
pub function (m: PMap[K, V]) difference[K: cmp.Hash + cmp.Eq, V](other: PMap[K, V]): PMap[K, V] {
  let out: PMap[K, V] = m;
  let ks: K[] = other.keys();
  let i: i32 = 0;
  while (i < ks.len()) {
    out = out.remove(ks[i]);
    i = i + 1;
  }
  return out;
}

// `is_valid()` — do the trie invariants hold over every node? Always
// true for a map built through this module; exposed for tests.
pub function (m: PMap[K, V]) is_valid(): boolean {
  return node_valid(m, 0, 0);
}
