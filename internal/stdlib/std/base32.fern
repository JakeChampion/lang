// This module encodes and decodes Base32 data under RFC 4648.

function __b32_alphabet(v: i32): i32 {
  if (v < 26) {
    return v + 65;
  }
  return v + 24;
}

function __b32_decode_char(c: i32): i32 {
  if (c >= 65 && c < 91) {
    return c - 65;
  }
  if (c >= 50 && c < 56) {
    return c - 24;
  }
  return 0 - 1;
}

pub function base32_encode(bs: u8[]): string {
  let out: u8[] = [];
  let acc: i32 = 0;
  let bits: i32 = 0;
  let i: i32 = 0;
  let n: i32 = bs.len();
  while (i < n) {
    acc = acc << 8 | bs[i] as i32;
    bits = bits + 8;
    while (bits >= 5) {
      bits = bits - 5;
      out = out.append(__b32_alphabet(acc >> bits & 31) as u8);
    }
    i = i + 1;
  }
  if (bits > 0) {
    out = out.append(__b32_alphabet(acc << 5 - bits & 31) as u8);
  }
  while (out.len() % 8 != 0) {
    out = out.append(61 as u8);
  }
  return string_from_bytes_unchecked(out);
}

pub function base32_decode(s: string): u8[] {
  let n: i32 = 0;
  let sLen: i32 = s.len();
  while (n < sLen) {
    if (__b32_decode_char(s[n] as i32) < 0) {
      break;
    }
    n = n + 1;
  }
  let out: u8[] = [];
  let acc: i32 = 0;
  let bits: i32 = 0;
  let i: i32 = 0;
  while (i < n) {
    acc = acc << 5 | __b32_decode_char(s[i] as i32);
    bits = bits + 5;
    if (bits >= 8) {
      bits = bits - 8;
      out = out.append((acc >> bits & 255) as u8);
    }
    i = i + 1;
  }
  return out;
}

pub function base32_decode_strict(s: string): Option[u8[]] {
  let sLen: i32 = s.len();
  let n: i32 = 0;
  while (n < sLen) {
    if (__b32_decode_char(s[n] as i32) < 0) {
      break;
    }
    n = n + 1;
  }
  let p: i32 = n;
  let pad: i32 = 0;
  while (p < sLen) {
    if (s[p] != 61) {
      return None;
    }
    pad = pad + 1;
    p = p + 1;
  }
  if (pad > 6) {
    return None;
  }
  if (n == 0) {
    if (pad > 0) {
      return None;
    }
    return Some([]);
  }
  let rem: i32 = n % 8;
  if (rem == 1 || rem == 3 || rem == 6) {
    return None;
  }
  if (pad > 0 && (n + pad) % 8 != 0) {
    return None;
  }
  let out_len: i32 = n * 5 / 8;
  if (out_len == 0) {
    return Some([]);
  }
  let buf: u8[] = __alloc_u8(out_len);
  let i: i32 = 0;
  let j: i32 = 0;
  let acc: i32 = 0;
  let bits: i32 = 0;
  while (i < n) {
    acc = acc << 5 | __b32_decode_char(s[i] as i32);
    bits = bits + 5;
    if (bits >= 8) {
      bits = bits - 8;
      buf = buf.with(j, (acc >> bits & 255) as u8);
      j = j + 1;
    }
    i = i + 1;
  }
  return Some(buf);
}
