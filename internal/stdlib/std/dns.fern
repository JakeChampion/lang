// std/dns — a stub resolver (#9855, the P2 slice of the networking plan
// in #9851): the RFC 1035 wire codec, `/etc/hosts`, `/etc/resolv.conf`,
// a query over UDP that retries over TCP when the reply is truncated,
// and the A, AAAA and canonical-name lookups built on them.
//
// The pieces, bottom up:
//
//   - `Message`, `Question`, `Record`, `RData` — a DNS message as data.
//     `encode` writes one (names uncompressed, which a query never needs),
//     `decode` reads one, following compression pointers that only ever
//     point backwards. `query(id, name, qtype)` is a recursion-desired
//     question, and `with_edns(m)` appends the OPT record that lets a
//     server answer 4096 bytes over UDP (EDNS0, RFC 6891).
//   - `parse_hosts` and `parse_resolv_conf` read the two files glibc's
//     resolver reads, with its defaults and caps: `ndots` up to 15,
//     `timeout` up to 30 s, `attempts` up to 5, three nameservers, and
//     the search list from the machine's own domain when the file names
//     none. `RES_OPTIONS`, `LOCALDOMAIN` and `HOSTALIASES` are not read,
//     and a nameserver with an IPv6 zone (`fe80::1%eth0`) is skipped.
//   - `search_plan` is res_search's order for a name: a name with at
//     least `ndots` dots is asked as it stands before the search domains,
//     one with fewer after them, and a name ending in a dot only as it
//     stands.
//   - `exchange(ns, q, timeout_ms)` is one query to one nameserver: UDP,
//     the reply awaited up to the timeout, a reply with another id
//     ignored, and a truncated reply asked again over TCP;
//     `exchange_many` sends several queries at once and awaits their
//     replies together. `ask(conf, q)` and `ask_many` are res_send over
//     the nameservers: each is tried in turn, `attempts` times round,
//     from a rotating start when `rotate` is set, a server that fails,
//     refuses or stays silent handing the query to the next.
//   - `lookup_a`, `lookup_aaaa` and `canonical_name` walk the search plan
//     over `ask` and read the answer section, following a CNAME chain to
//     the owner of the records; `lookup_records_with` takes the asker as
//     a function, which is how the walk is tested without a socket.
//     `lookup_addresses` asks for the A and AAAA records together.
//   - `order_addresses` is the destination address selection of RFC
//     6724, over the source address the host would use for each
//     destination (`source_for`); `sort_addresses` probes and orders.
//   - `connect_race` is the RFC 8305 dialer: the addresses tried in turn,
//     each attempt running alone for the attempt delay before the next
//     starts beside it, the first to connect winning. `dial(name, port)`
//     resolves and races.
//   - `nat64_prefixes` reads the prefixes a NAT64 translator answers under
//     from the AAAA records of ipv4only.arpa (RFC 7050), and `synthesize`
//     embeds an IPv4 address under one (RFC 6052); `resolve` does that for
//     a host with no IPv4 route.
//   - `system_conf()` and `system_hosts()` read the machine's files, and
//     `resolve(name)` is the lookup a program wants by default: an address
//     literal as it is, then the hosts file, then DNS, the addresses in
//     RFC 6724 order.
//
// `.local` names are not special here: there is no mDNS, so they go to
// the nameservers like any other name, which is what a resolver without
// an mDNS backend does.
//
// Reaches the host for the files (`read_file`, `hostname`), the sockets
// (`udp_*`, `tcp_*`, `poll`), the query id (`random_i32`) and the clock
// the wait is measured by (`monotonic_ns`).
import "std/net";
import "std/async";
import "std/i32";
import "std/string";
import "std/array";
import "std/error";
import "std/utf8" as utf8;

// ---------------------------------------------------------------------------
// Errors

// DnsError — why a lookup answered nothing.
//
// `NoSuchName` is the server's NXDOMAIN, `NoData` a clean reply with no
// record of the asked type, `NoReply` a nameserver that stayed silent
// through the timeout, `ServerFailure` and `Refused` its SERVFAIL and
// REFUSED, `Malformed` a reply, a name or a file that does not parse,
// `NoNameserver` a configuration naming none, and `Socket` what the
// transport reported.
pub enum DnsError {
  NoSuchName,
  NoData,
  NoReply,
  ServerFailure,
  Refused,
  Malformed,
  NoNameserver,
  Socket(net.NetError),
}

pub function (e: DnsError) message(): string {
  match (e) {
    NoSuchName => {
      return "Name or service not known";
    },
    NoData => {
      return "No address associated with hostname";
    },
    NoReply => {
      return "Temporary failure in name resolution";
    },
    ServerFailure => {
      return "Name server failed";
    },
    Refused => {
      return "Name server refused the query";
    },
    Malformed => {
      return "Malformed DNS message";
    },
    NoNameserver => {
      return "No name server configured";
    },
    Socket(ne) => {
      return ne.message();
    }
  }
  return "";
}

impl error.Error for DnsError {}

pub function (e: DnsError) to_string(): string {
  return e.message();
}

// ---------------------------------------------------------------------------
// The message

// The record types and class this module reads and writes by name; any
// other type travels as `Raw` bytes.
pub function type_a(): i32 {
  return 1;
}

pub function type_cname(): i32 {
  return 5;
}

pub function type_ptr(): i32 {
  return 12;
}

pub function type_aaaa(): i32 {
  return 28;
}

pub function type_opt(): i32 {
  return 41;
}

pub function class_in(): i32 {
  return 1;
}

// The response codes a reply's header carries (RFC 1035 §4.1.1).
pub function rcode_ok(): i32 {
  return 0;
}

pub function rcode_format_error(): i32 {
  return 1;
}

pub function rcode_server_failure(): i32 {
  return 2;
}

pub function rcode_name_error(): i32 {
  return 3;
}

pub function rcode_not_implemented(): i32 {
  return 4;
}

pub function rcode_refused(): i32 {
  return 5;
}

// RData — a record's data: an address, the name a CNAME or PTR points
// at, or the bytes of a type this module does not read.
pub enum RData {
  A(net.IpAddr),
  AAAA(net.IpAddr),
  CNAME(string),
  PTR(string),
  Raw(u8[]),
}

// Question — one entry of the question section.
pub struct Question { name: string, qtype: i32, qclass: i32 }

// Record — one resource record: its owner name, type, class, TTL and data.
pub struct Record { name: string, rtype: i32, rclass: i32, ttl: i32, data: RData }

// Message — a whole DNS message. `rcode` is the four-bit response code,
// `opcode` the four-bit operation (0 is a standard query).
pub struct Message {
  id: i32,
  response: boolean,
  opcode: i32,
  authoritative: boolean,
  truncated: boolean,
  recursion_desired: boolean,
  recursion_available: boolean,
  rcode: i32,
  questions: Question[],
  answers: Record[],
  authority: Record[],
  additional: Record[],
}

// `query(id, name, qtype)` — a recursion-desired query for the records
// of `name` of type `qtype`, class IN.
pub function query(id: i32, name: string, qtype: i32): Message {
  var qs: Question[] = [Question { name: name, qtype: qtype, qclass: class_in() }];
  return Message {
    id: id & 65535, response: false, opcode: 0, authoritative: false, truncated: false,
    recursion_desired: true, recursion_available: false, rcode: 0,
    questions: qs, answers: [], authority: [], additional: [],
  };
}

// `udp_payload()` — the UDP payload size this module advertises with EDNS0,
// what Go, hickory and c-ares advertise.
pub function udp_payload(): i32 {
  return 4096;
}

// `with_edns(m)` — `m` with the OPT pseudo-record of EDNS0 appended to its
// additional section: owner the root, type OPT, the class carrying the UDP
// payload size, no options.
pub function with_edns(m: Message): Message {
  var none: u8[] = [];
  var opt: Record = Record { name: "", rtype: type_opt(), rclass: udp_payload(), ttl: 0, data: Raw(none) };
  return Message { ...m, additional: m.additional.append(opt) };
}

// `rcode_name(rcode)` — a response code by its RFC 1035 name, for log
// lines.
pub function rcode_name(rcode: i32): string {
  if (rcode == 0) {
    return "NOERROR";
  }
  if (rcode == 1) {
    return "FORMERR";
  }
  if (rcode == 2) {
    return "SERVFAIL";
  }
  if (rcode == 3) {
    return "NXDOMAIN";
  }
  if (rcode == 4) {
    return "NOTIMP";
  }
  if (rcode == 5) {
    return "REFUSED";
  }
  return "RCODE" + rcode.to_string();
}

// ---- encoding ---------------------------------------------------------------

function put16(b: u8[], v: i32): u8[] {
  var out: u8[] = b.append((v >> 8 & 255) as u8);
  return out.append((v & 255) as u8);
}

function put32(b: u8[], v: i32): u8[] {
  var out: u8[] = put16(b, v >> 16 & 65535);
  return put16(out, v & 65535);
}

// A name on the wire: each label behind its length, the root as a lone
// zero byte. A trailing dot is the root and is dropped. An empty label
// (`a..b`), one over 63 bytes, or a name over 255 bytes on the wire
// cannot be encoded.
pub function encode_name(name: string): Result[u8[], DnsError] {
  var out: u8[] = [];
  var n: string = name;
  if (n.ends_with(".")) {
    n = slice_unchecked(n, 0, n.len() - 1) + "";
  }
  if (n.len() == 0) {
    return Ok(out.append(0 as u8));
  }
  var labels: string[] = n.split(".");
  var i: i32 = 0;
  while (i < labels.len()) {
    var l: string = labels[i];
    if (l.len() == 0 || l.len() > 63) {
      return Err(Malformed);
    }
    out = out.append(l.len() as u8);
    var j: i32 = 0;
    while (j < l.len()) {
      out = out.append(l[j]);
      j = j + 1;
    }
    i = i + 1;
  }
  out = out.append(0 as u8);
  if (out.len() > 255) {
    return Err(Malformed);
  }
  return Ok(out);
}

function encode_question(b: u8[], q: Question): Result[u8[], DnsError] {
  var name: u8[] = encode_name(q.name)?;
  var out: u8[] = b.concat(name);
  out = put16(out, q.qtype);
  return Ok(put16(out, q.qclass));
}

function encode_rdata(d: RData): Result[u8[], DnsError] {
  match (d) {
    A(ip) => {
      if (!ip.is_v4()) {
        return Err(Malformed);
      }
      return Ok(ip.bytes());
    },
    AAAA(ip) => {
      if (!ip.is_v6()) {
        return Err(Malformed);
      }
      return Ok(ip.bytes());
    },
    CNAME(n) => {
      return encode_name(n);
    },
    PTR(n) => {
      return encode_name(n);
    },
    Raw(bytes) => {
      return Ok(bytes);
    }
  }
  var none: u8[] = [];
  return Ok(none);
}

function encode_record(b: u8[], r: Record): Result[u8[], DnsError] {
  var name: u8[] = encode_name(r.name)?;
  var data: u8[] = encode_rdata(r.data)?;
  if (data.len() > 65535) {
    return Err(Malformed);
  }
  var out: u8[] = b.concat(name);
  out = put16(out, r.rtype);
  out = put16(out, r.rclass);
  out = put32(out, r.ttl);
  out = put16(out, data.len());
  return Ok(out.concat(data));
}

function encode_records(b: u8[], rs: Record[]): Result[u8[], DnsError] {
  var out: u8[] = b;
  var i: i32 = 0;
  while (i < rs.len()) {
    out = encode_record(out, rs[i])?;
    i = i + 1;
  }
  return Ok(out);
}

// `encode(m)` — the message on the wire, without the two-byte length a
// TCP exchange puts in front. Names are written uncompressed. A section
// of more than 65535 entries, or a name that cannot be encoded, is
// `Malformed`.
pub function encode(m: Message): Result[u8[], DnsError] {
  if (!sections_fit(m)) {
    return Err(Malformed);
  }
  var out: u8[] = [];
  out = put16(out, m.id & 65535);
  out = put16(out, header_flags(m));
  out = put16(out, m.questions.len());
  out = put16(out, m.answers.len());
  out = put16(out, m.authority.len());
  out = put16(out, m.additional.len());
  var i: i32 = 0;
  while (i < m.questions.len()) {
    out = encode_question(out, m.questions[i])?;
    i = i + 1;
  }
  out = encode_records(out, m.answers)?;
  out = encode_records(out, m.authority)?;
  return encode_records(out, m.additional);
}

function sections_fit(m: Message): boolean {
  return m.questions.len() <= 65535 && m.answers.len() <= 65535 && m.authority.len() <= 65535 && m.additional.len() <= 65535;
}

// The second header word: QR, opcode, AA, TC, RD, RA and the rcode.
function header_flags(m: Message): i32 {
  var flags: i32 = (m.opcode & 15) << 11 | m.rcode & 15;
  if (m.response) {
    flags = flags | 32768;
  }
  if (m.authoritative) {
    flags = flags | 1024;
  }
  if (m.truncated) {
    flags = flags | 512;
  }
  if (m.recursion_desired) {
    flags = flags | 256;
  }
  if (m.recursion_available) {
    flags = flags | 128;
  }
  return flags;
}

// ---- decoding ---------------------------------------------------------------

function be16(m: u8[], i: i32): i32 {
  return m[i] as i32 << 8 | m[i + 1] as i32;
}

function be32(m: u8[], i: i32): i32 {
  return be16(m, i) << 16 | be16(m, i + 2);
}

// NameAt — a decoded name and the offset past it in the message.
pub struct NameAt { name: string, next: i32 }

// `decode_name(msg, pos)` — the name at `pos`: labels up to the root, or
// up to a compression pointer, which is followed to a lower offset. A
// pointer forward or to itself, a label past the end, or a name over 255
// bytes is `Malformed`; `next` is the offset after the labels or after
// the first pointer, which is where the message continues.
pub function decode_name(msg: u8[], pos: i32): Result[NameAt, DnsError] {
  var out: string = "";
  var total: i32 = 0;
  var p: i32 = pos;
  var next: i32 = -1;
  var hops: i32 = 0;
  while (p < msg.len()) {
    var l: i32 = msg[p] as i32;
    if (l == 0) {
      return Ok(NameAt { name: out, next: first_of(next, p + 1) });
    }
    if ((l & 192) == 192) {
      next = first_of(next, p + 2);
      hops = hops + 1;
      p = pointer_target(msg, p, hops)?;
      continue;
    }
    total = total + 1 + l;
    if ((l & 192) != 0 || p + 1 + l > msg.len() || total > 254) {
      return Err(Malformed);
    }
    match (join_label(out, msg, p + 1, l)) {
      Some(joined) => {
        out = joined;
      },
      None => {
        return Err(Malformed);
      }
    }
    p = p + 1 + l;
  }
  return Err(Malformed);
}

// `next` once it is set, else `at`: the offset after the first pointer or
// the root is where the message continues.
function first_of(next: i32, at: i32): i32 {
  if (next < 0) {
    return at;
  }
  return next;
}

// The offset a compression pointer at `p` points at, which has to be
// lower than `p`; `hops` bounds a chain of pointers by the message's
// size, since each has to go backwards.
function pointer_target(msg: u8[], p: i32, hops: i32): Result[i32, DnsError] {
  if (p + 1 >= msg.len()) {
    return Err(Malformed);
  }
  var target: i32 = (msg[p] as i32 & 63) << 8 | msg[p + 1] as i32;
  if (target >= p || hops > 127) {
    return Err(Malformed);
  }
  return Ok(target);
}

// `out` with the `len` bytes at `at` appended as its next label, or
// None when those bytes are not well-formed UTF-8: a name is text, and
// the wire is the boundary where that is checked.
function join_label(out: string, msg: u8[], at: i32, len: i32): Option[string] {
  var label: u8[] = [];
  var k: i32 = 0;
  while (k < len) {
    label = label.append(msg[at + k]);
    k = k + 1;
  }
  match (utf8.from_bytes(label)) {
    Some(text) => {
      if (out.len() > 0) {
        return Some(out + "." + text);
      }
      return Some(text);
    },
    None => {
      return None;
    }
  }
  return None;
}

struct QuestionAt { q: Question, next: i32 }

function decode_question(msg: u8[], pos: i32): Result[QuestionAt, DnsError] {
  var n: NameAt = decode_name(msg, pos)?;
  if (n.next + 4 > msg.len()) {
    return Err(Malformed);
  }
  var q: Question = Question { name: n.name, qtype: be16(msg, n.next), qclass: be16(msg, n.next + 2) };
  return Ok(QuestionAt { q: q, next: n.next + 4 });
}

struct RecordAt { r: Record, next: i32 }

function decode_rdata(msg: u8[], rtype: i32, rclass: i32, at: i32, rdlen: i32): Result[RData, DnsError] {
  var raw: u8[] = [];
  var k: i32 = 0;
  while (k < rdlen) {
    raw = raw.append(msg[at + k]);
    k = k + 1;
  }
  if (rclass != class_in()) {
    return Ok(Raw(raw));
  }
  if (rtype == type_cname() || rtype == type_ptr()) {
    return decode_name_rdata(msg, rtype, at, rdlen);
  }
  return decode_address_rdata(rtype, raw);
}

// An A or AAAA record's address, when the data is the right length for
// it; any other type, or length, keeps its bytes.
function decode_address_rdata(rtype: i32, raw: u8[]): Result[RData, DnsError] {
  if (rtype == type_a() && raw.len() == 4) {
    return Ok(A(net.ipv4(raw[0] as i32, raw[1] as i32, raw[2] as i32, raw[3] as i32)));
  }
  if (rtype == type_aaaa() && raw.len() == 16) {
    match (net.ipv6(raw)) {
      Some(ip) => {
        return Ok(AAAA(ip));
      },
      None => {
        return Err(Malformed);
      }
    }
  }
  return Ok(Raw(raw));
}

// A CNAME or PTR record's name, which may point back into the message
// but has to end within the record's data.
function decode_name_rdata(msg: u8[], rtype: i32, at: i32, rdlen: i32): Result[RData, DnsError] {
  var n: NameAt = decode_name(msg, at)?;
  if (n.next > at + rdlen) {
    return Err(Malformed);
  }
  if (rtype == type_cname()) {
    return Ok(CNAME(n.name));
  }
  return Ok(PTR(n.name));
}

function decode_record(msg: u8[], pos: i32): Result[RecordAt, DnsError] {
  var n: NameAt = decode_name(msg, pos)?;
  var p: i32 = n.next;
  if (p + 10 > msg.len()) {
    return Err(Malformed);
  }
  var rtype: i32 = be16(msg, p);
  var rclass: i32 = be16(msg, p + 2);
  var ttl: i32 = be32(msg, p + 4);
  var rdlen: i32 = be16(msg, p + 8);
  p = p + 10;
  if (p + rdlen > msg.len()) {
    return Err(Malformed);
  }
  var data: RData = decode_rdata(msg, rtype, rclass, p, rdlen)?;
  var r: Record = Record { name: n.name, rtype: rtype, rclass: rclass, ttl: ttl, data: data };
  return Ok(RecordAt { r: r, next: p + rdlen });
}

struct RecordsAt { rs: Record[], next: i32 }

function decode_records(msg: u8[], pos: i32, count: i32): Result[RecordsAt, DnsError] {
  var out: Record[] = [];
  var p: i32 = pos;
  var i: i32 = 0;
  while (i < count) {
    var r: RecordAt = decode_record(msg, p)?;
    out = out.append(r.r);
    p = r.next;
    i = i + 1;
  }
  return Ok(RecordsAt { rs: out, next: p });
}

// `decode(msg)` — the message the bytes carry. Anything that does not
// fit — a short header, a section count past the end, a bad pointer —
// is `Malformed`; bytes after the last section are ignored.
pub function decode(msg: u8[]): Result[Message, DnsError] {
  if (msg.len() < 12) {
    return Err(Malformed);
  }
  var flags: i32 = be16(msg, 2);
  var qd: i32 = be16(msg, 4);
  var an: i32 = be16(msg, 6);
  var ns: i32 = be16(msg, 8);
  var ar: i32 = be16(msg, 10);
  var p: i32 = 12;
  var qs: Question[] = [];
  var i: i32 = 0;
  while (i < qd) {
    var q: QuestionAt = decode_question(msg, p)?;
    qs = qs.append(q.q);
    p = q.next;
    i = i + 1;
  }
  var answers: RecordsAt = decode_records(msg, p, an)?;
  var authority: RecordsAt = decode_records(msg, answers.next, ns)?;
  var additional: RecordsAt = decode_records(msg, authority.next, ar)?;
  return Ok(Message {
    id: be16(msg, 0),
    response: (flags & 32768) != 0,
    opcode: flags >> 11 & 15,
    authoritative: (flags & 1024) != 0,
    truncated: (flags & 512) != 0,
    recursion_desired: (flags & 256) != 0,
    recursion_available: (flags & 128) != 0,
    rcode: flags & 15,
    questions: qs,
    answers: answers.rs,
    authority: authority.rs,
    additional: additional.rs,
  });
}

// `names_equal(a, b)` — two names compared as DNS compares them: without
// regard to ASCII case, and a trailing dot is the root.
pub function names_equal(a: string, b: string): boolean {
  return strip_root(a).eq_ignore_ascii_case(strip_root(b));
}

function strip_root(n: string): string {
  if (n.ends_with(".") && n.len() > 1) {
    return slice_unchecked(n, 0, n.len() - 1) + "";
  }
  return n;
}

// `(m).answers_question(q)` — whether `m` is a reply to the question
// `q`: the same id is the caller's to check; this is the question itself,
// name, type and class.
pub function (m: Message) answers_question(q: Question): boolean {
  if (m.questions.len() != 1) {
    return false;
  }
  var mq: Question = m.questions[0];
  return mq.qtype == q.qtype && mq.qclass == q.qclass && names_equal(mq.name, q.name);
}

// Answer — what the answer section says about a name: the owner the
// CNAME chain ends at, and that owner's records of the asked type.
pub struct Answer { canonical: string, records: Record[] }

// `records_for(m, name, rtype)` — the records of type `rtype` the answer
// section holds for `name`, following CNAMEs from `name` to the owner
// that has them. A chain longer than the section is cut off where it
// loops.
pub function records_for(m: Message, name: string, rtype: i32): Answer {
  var cur: string = name;
  var hops: i32 = 0;
  while (hops <= m.answers.len()) {
    var at: OwnerScan = scan_owner(m, cur, rtype);
    if (at.found.len() > 0 || at.alias.len() == 0) {
      return Answer { canonical: cur, records: at.found };
    }
    cur = at.alias;
    hops = hops + 1;
  }
  var none: Record[] = [];
  return Answer { canonical: cur, records: none };
}

// What the answer section holds for one owner: its records of the asked
// type, and the target of its first CNAME.
struct OwnerScan { found: Record[], alias: string }

function scan_owner(m: Message, owner: string, rtype: i32): OwnerScan {
  var found: Record[] = [];
  var alias: string = "";
  var i: i32 = 0;
  while (i < m.answers.len()) {
    var r: Record = m.answers[i];
    i = i + 1;
    if (r.rclass != class_in() || !names_equal(r.name, owner)) {
      continue;
    }
    if (r.rtype == rtype) {
      found = found.append(r);
    } else if (r.rtype == type_cname() && alias.len() == 0) {
      alias = cname_target(r.data);
    }
  }
  return OwnerScan { found: found, alias: alias };
}

function cname_target(d: RData): string {
  match (d) {
    CNAME(target) => {
      return target;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// `addresses_of(records)` — the addresses the A and AAAA records among
// `records` carry, in their order.
pub function addresses_of(records: Record[]): net.IpAddr[] {
  var out: net.IpAddr[] = [];
  var i: i32 = 0;
  while (i < records.len()) {
    match (records[i].data) {
      A(ip) => {
        out = out.append(ip);
      },
      AAAA(ip) => {
        out = out.append(ip);
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

// ---------------------------------------------------------------------------
// /etc/hosts

// HostsEntry — one line of the hosts file: its address and the names on
// it, the canonical name first.
pub struct HostsEntry { ip: net.IpAddr, names: string[] }

// `parse_hosts(contents)` — the entries of a hosts file, in file order.
// `#` starts a comment; a line whose first field is not an address of
// either family, or that names nothing, is skipped.
pub function parse_hosts(contents: string): HostsEntry[] {
  var out: HostsEntry[] = [];
  var lines: string[] = contents.lines();
  var i: i32 = 0;
  while (i < lines.len()) {
    var f: string[] = strip_comment(lines[i], "#").fields();
    i = i + 1;
    if (f.len() < 2) {
      continue;
    }
    match (net.ip_parse(f[0])) {
      Some(ip) => {
        out = out.append(HostsEntry { ip: ip, names: f.drop(1) });
      },
      None => {}
    }
  }
  return out;
}

// `hosts_lookup(entries, name)` — every address of a line whose canonical
// name or alias is `name`, compared without regard to ASCII case, in file
// order; empty when no line names it.
pub function hosts_lookup(entries: HostsEntry[], name: string): net.IpAddr[] {
  var out: net.IpAddr[] = [];
  var i: i32 = 0;
  while (i < entries.len()) {
    if (entry_names(entries[i], name)) {
      out = out.append(entries[i].ip);
    }
    i = i + 1;
  }
  return out;
}

// `hosts_canonical(entries, name)` — the canonical name of the first line
// naming `name`, as getaddrinfo's AI_CANONNAME reads it from the files
// backend.
pub function hosts_canonical(entries: HostsEntry[], name: string): Option[string] {
  var i: i32 = 0;
  while (i < entries.len()) {
    if (entry_names(entries[i], name)) {
      return Some(entries[i].names[0]);
    }
    i = i + 1;
  }
  return None;
}

function entry_names(e: HostsEntry, name: string): boolean {
  var j: i32 = 0;
  while (j < e.names.len()) {
    if (names_equal(e.names[j], name)) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

// The line up to its first `marker`, if any.
function strip_comment(line: string, marker: string): string {
  var h: i32 = line.index_of(marker);
  if (h < 0) {
    return line;
  }
  return slice_unchecked(line, 0, h) + "";
}

// ---------------------------------------------------------------------------
// /etc/resolv.conf

// ResolvConf — what the resolver reads off resolv.conf: the nameservers
// (at most three, as glibc keeps), the search list, `ndots`, the timeout
// of one try in milliseconds, how many times round the servers, and
// whether to start each query at the next server (`rotate`).
pub struct ResolvConf {
  nameservers: net.SocketAddr[],
  search: string[],
  ndots: i32,
  timeout_ms: i32,
  attempts: i32,
  rotate: boolean,
}

// `dns_port()` — 53.
pub function dns_port(): i32 {
  return 53;
}

// `resolv_defaults(host)` — res_init with no file: 127.0.0.1 as the only
// nameserver, the search list from `host`'s domain, `ndots` 1, a 5 s
// timeout, 2 attempts, no rotation.
pub function resolv_defaults(host: string): ResolvConf {
  var ns: net.SocketAddr[] = [net.socket_addr(net.ipv4_loopback(), dns_port())];
  return ResolvConf { nameservers: ns, search: host_domain(host), ndots: 1, timeout_ms: 5000, attempts: 2, rotate: false };
}

// `parse_resolv_conf(contents, host)` — glibc's res_init over the file.
// `host` is the machine's own name, whose domain is the search list when
// the file names none. `#` and `;` start comments. `domain` and `search`
// each replace the list, so the last one wins. On an `options` line,
// `ndots:n` is capped at 15, `timeout:n` (seconds) at 30, `attempts:n`
// at 5, and `rotate` is read; anything else is ignored. A `nameserver`
// that is not an address, or that carries an IPv6 zone, is skipped, and
// only the first three count.
pub function parse_resolv_conf(contents: string, host: string): ResolvConf {
  var rc: ResolvConf = resolv_defaults(host);
  var ns: net.SocketAddr[] = [];
  var have_search: boolean = false;
  var lines: string[] = contents.lines();
  var i: i32 = 0;
  while (i < lines.len()) {
    var f: string[] = strip_comment(strip_comment(lines[i], "#"), ";").fields();
    i = i + 1;
    if (f.len() < 2) {
      continue;
    }
    if (f[0] == "nameserver") {
      ns = with_nameserver(ns, f[1]);
    } else if (f[0] == "domain" || f[0] == "search") {
      have_search = true;
      rc = ResolvConf { ...rc, search: search_domains(f) };
    } else if (f[0] == "options") {
      rc = parse_options(f, rc);
    }
  }
  if (!have_search) {
    rc = ResolvConf { ...rc, search: host_domain(host) };
  }
  if (ns.len() > 0) {
    rc = ResolvConf { ...rc, nameservers: ns };
  }
  return rc;
}

// `ns` with the nameserver `text` names at port 53: an address of either
// family, not one with an IPv6 zone, and only while there are fewer than
// three.
function with_nameserver(ns: net.SocketAddr[], text: string): net.SocketAddr[] {
  if (ns.len() >= 3 || text.index_of("%") >= 0) {
    return ns;
  }
  match (net.ip_parse(text)) {
    Some(ip) => {
      return ns.append(net.socket_addr(ip, dns_port()));
    },
    None => {
      return ns;
    }
  }
  return ns;
}

// The domains of a `search` or `domain` line: `domain` takes one, `search`
// takes all; a trailing dot is dropped and an entry that is only a dot is
// the root and contributes nothing.
function search_domains(f: string[]): string[] {
  var out: string[] = [];
  var n: i32 = f.len();
  if (f[0] == "domain") {
    n = 2;
  }
  var i: i32 = 1;
  while (i < n) {
    var d: string = f[i];
    if (d.ends_with(".")) {
      d = slice_unchecked(d, 0, d.len() - 1) + "";
    }
    if (d.len() > 0) {
      out = out.append(d);
    }
    i = i + 1;
  }
  return out;
}

function parse_options(f: string[], rc0: ResolvConf): ResolvConf {
  var rc: ResolvConf = rc0;
  var i: i32 = 1;
  while (i < f.len()) {
    var o: string = f[i];
    i = i + 1;
    if (o == "rotate") {
      rc = ResolvConf { ...rc, rotate: true };
    } else if (o.starts_with("ndots:")) {
      rc = ResolvConf { ...rc, ndots: option_value(o, 6, 0, 15, rc.ndots) };
    } else if (o.starts_with("timeout:")) {
      rc = ResolvConf { ...rc, timeout_ms: option_value(o, 8, 1, 30, rc.timeout_ms / 1000) * 1000 };
    } else if (o.starts_with("attempts:")) {
      rc = ResolvConf { ...rc, attempts: option_value(o, 9, 1, 5, rc.attempts) };
    }
  }
  return rc;
}

// The number after an option's colon, clamped to `lo..hi`; `current`
// when it is not a number.
function option_value(o: string, at: i32, lo: i32, hi: i32, current: i32): i32 {
  match ((slice_unchecked(o, at, o.len()) + "").parse_int()) {
    Some(n) => {
      if (n < lo) {
        return lo;
      }
      if (n > hi) {
        return hi;
      }
      return n;
    },
    None => {
      return current;
    }
  }
  return current;
}

// The search list glibc derives from the local hostname: everything after
// its first dot, or nothing.
function host_domain(host: string): string[] {
  var out: string[] = [];
  var dot: i32 = host.index_of(".");
  if (dot < 0 || dot + 1 >= host.len()) {
    return out;
  }
  return out.append(slice_unchecked(host, dot + 1, host.len()) + "");
}

// ---------------------------------------------------------------------------
// The search list

// SearchPlan — the three pieces __res_context_search works in, which are
// not interchangeable with a flat candidate list. `as_is` is the name as
// it stands, `suffixes` the search-list names, and `leads` says whether
// the as-is query runs before the suffixes (glibc's `tried_as_is`) or is
// the retry after them. Which of the two it is decides both whether that
// retry happens at all and whose status is reported.
pub struct SearchPlan { as_is: string, suffixes: string[], leads: boolean }

// `search_plan(name, rc)` — res_search's plan for `name`. A name ending in
// a dot is asked for as it stands and nothing else. Otherwise a name with
// at least `ndots` dots leads with the as-is query and then tries each
// search domain; one with fewer tries the search domains first and the
// as-is name after them.
pub function search_plan(name: string, rc: ResolvConf): SearchPlan {
  var none: string[] = [];
  if (name.ends_with(".")) {
    return SearchPlan { as_is: strip_root(name), suffixes: none, leads: true };
  }
  var dots: i32 = 0;
  var i: i32 = 0;
  while (i < name.len()) {
    if (name[i] == 46) {
      dots = dots + 1;
    }
    i = i + 1;
  }
  var sfx: string[] = [];
  var j: i32 = 0;
  while (j < rc.search.len()) {
    sfx = sfx.append(name + "." + rc.search[j]);
    j = j + 1;
  }
  return SearchPlan { as_is: name, suffixes: sfx, leads: dots >= rc.ndots };
}

// `search_candidates(name, rc)` — the plan flattened into the order the
// names are asked in.
pub function search_candidates(name: string, rc: ResolvConf): string[] {
  var p: SearchPlan = search_plan(name, rc);
  var out: string[] = [];
  if (p.leads) {
    out = out.append(p.as_is);
  }
  var j: i32 = 0;
  while (j < p.suffixes.len()) {
    out = out.append(p.suffixes[j]);
    j = j + 1;
  }
  if (!p.leads) {
    out = out.append(p.as_is);
  }
  return out;
}

// ---------------------------------------------------------------------------
// The exchange

// `new_id()` — a query id drawn from the platform's random numbers.
pub function new_id(): i32 {
  return random_i32() & 65535;
}

function zero_bytes(n: i32): u8[] {
  var out: u8[] = [];
  var i: i32 = 0;
  while (i < n) {
    out = out.append(0 as u8);
    i = i + 1;
  }
  return out;
}

function now_ms(): i64 {
  return monotonic_ns() / 1000000i64;
}

// Whether `fd` is readable within `wait_ms`: `first_readable` for one
// socket, as the TCP reads use it.
function readable_within(fd: i32, wait_ms: i32): boolean {
  var ms: i32 = wait_ms;
  if (ms < 1) {
    ms = 1;
  }
  var ns_per_ms: i64 = 1000000i64;
  var start: i64 = monotonic_ns();
  var tok: i32 = tcp_pollable(fd);
  var timer: i32 = wasm_timer_pollable(ms as i64 * ns_per_ms);
  var pollset: i32[] = [tok, timer];
  var ready: i32 = poll(pollset, ms);
  var dtimer: i32 = wasm_pollable_drop(timer);
  var dtok: i32 = wasm_pollable_drop(tok);
  if (ready == 0) {
    return true;
  }
  if (ready == 1) {
    return false;
  }
  var waited: i64 = monotonic_ns() - start;
  return waited * 2i64 < ms as i64 * ns_per_ms;
}

function local_for(ns: net.SocketAddr): net.SocketAddr {
  if (ns.ip.is_v6()) {
    return net.socket_addr(net.ipv6_unspecified(), 0);
  }
  return net.socket_addr(net.ipv4_unspecified(), 0);
}

// `exchange(ns, q, timeout_ms)` — one query to one nameserver. The
// message goes over UDP with EDNS0 and the reply is awaited up to the
// timeout; a datagram that is not a reply to `q` (another id, another
// question) is ignored and the wait goes on. A truncated reply is asked
// again over TCP, where the reply is read whole behind its length. A
// server that stays silent is `NoReply`, one that cannot be reached
// `Socket(e)`.
pub function exchange(ns: net.SocketAddr, q: Message, timeout_ms: i32): Result[Message, DnsError] {
  return exchange_many(ns, [q], timeout_ms)[0];
}

// `exchange_many(ns, qs, timeout_ms)` — `exchange` for several queries at
// once: each goes on its own socket and the replies are awaited
// together, so the queries cost one round trip between them rather
// than one each. The answers are parallel to `qs`.
pub function exchange_many(ns: net.SocketAddr, qs: Message[], timeout_ms: i32): Result[Message, DnsError][] {
  var deadline: i64 = now_ms() + timeout_ms as i64;
  var slots: Slot[] = [];
  var i: i32 = 0;
  while (i < qs.len()) {
    slots = slots.append(opened_slot(ns, qs[i]));
    i = i + 1;
  }
  slots = await_udp_replies(slots, deadline);
  var out: Result[Message, DnsError][] = [];
  i = 0;
  while (i < slots.len()) {
    if (slots[i].sock >= 0) {
      var closed: Result[void, net.NetError] = net.close(slots[i].sock);
    }
    out = out.append(slot_result(ns, slots[i], deadline));
    i = i + 1;
  }
  return out;
}

// One query in flight: its socket (-1 when none could be opened), its
// reply once one came, and otherwise its failure.
struct Slot { q: Message, sock: i32, reply: Option[Message], err: DnsError }

// Whether a slot is still waiting: it has a socket and no reply yet.
function waiting(s: Slot): boolean {
  if (s.sock < 0) {
    return false;
  }
  match (s.reply) {
    Some(_) => {
      return false;
    },
    None => {
      return true;
    }
  }
  return true;
}

// A slot with `q` sent to `ns`, or one carrying the failure to send it.
function opened_slot(ns: net.SocketAddr, q: Message): Slot {
  var bytes: u8[] = [];
  match (encode(with_edns(q))) {
    Ok(b) => {
      bytes = b;
    },
    Err(e) => {
      return Slot { q: q, sock: 0 - 1, reply: None, err: e };
    }
  }
  match (send_udp(ns, bytes)) {
    Ok(sock) => {
      return Slot { q: q, sock: sock, reply: None, err: NoReply };
    },
    Err(e) => {
      return Slot { q: q, sock: 0 - 1, reply: None, err: e };
    }
  }
  return Slot { q: q, sock: 0 - 1, reply: None, err: NoReply };
}

// A slot's reply as the query's result: a truncated reply is asked again
// over TCP within what is left of the deadline.
function slot_result(ns: net.SocketAddr, s: Slot, deadline: i64): Result[Message, DnsError] {
  match (s.reply) {
    Some(reply) => {
      if (reply.truncated) {
        return exchange_tcp(ns, s.q, (deadline - now_ms()) as i32);
      }
      return Ok(reply);
    },
    None => {
      return Err(s.err);
    }
  }
  return Err(s.err);
}

// A datagram socket of the nameserver's family with `bytes` sent to it.
function send_udp(ns: net.SocketAddr, bytes: u8[]): Result[i32, DnsError] {
  var sock: i32 = 0;
  match (net.udp_socket(local_for(ns))) {
    Ok(s) => {
      sock = s;
    },
    Err(e) => {
      return Err(Socket(e));
    }
  }
  match (net.send_to(sock, string_from_bytes_unchecked(bytes), ns)) {
    Ok(_) => {
      return Ok(sock);
    },
    Err(e) => {
      var closed: Result[void, net.NetError] = net.close(sock);
      return Err(Socket(e));
    }
  }
  return Ok(sock);
}

// The indexes of the slots still waiting.
function pending_slots(slots: Slot[]): i32[] {
  var out: i32[] = [];
  var i: i32 = 0;
  while (i < slots.len()) {
    if (waiting(slots[i])) {
      out = out.append(i);
    }
    i = i + 1;
  }
  return out;
}

// The replies to the waiting slots' queries before `deadline`, datagrams
// that are not one ignored; a slot still waiting at the deadline keeps
// `NoReply`. The sockets are polled as one set, so the replies are taken
// in whichever order the server sends them; where the host has no poll
// (the interpreter) the sockets are made non-blocking and tried in turn
// instead, a millisecond's pause between rounds.
function await_udp_replies(slots: Slot[], deadline: i64): Slot[] {
  var out: Slot[] = slots;
  var pending: i32[] = pending_slots(out);
  var left: i32 = (deadline - now_ms()) as i32;
  while (pending.len() > 0 && left > 0) {
    var ready: i32 = first_readable(out, pending, left);
    if (ready == 0 - 1) {
      return out;
    }
    if (ready == 0 - 2) {
      out = sweep_replies(out, pending);
    } else {
      out = taken(out, pending[ready]);
    }
    pending = pending_slots(out);
    left = (deadline - now_ms()) as i32;
  }
  return out;
}

// Slot `k` with the datagram its socket holds taken: its reply when the
// datagram is one, or its socket closed on a receive error.
function taken(slots: Slot[], k: i32): Slot[] {
  match (take_reply(slots[k].sock, slots[k].q)) {
    Ok(found) => {
      match (found) {
        Some(reply) => {
          return slots.with(k, Slot { ...slots[k], reply: Some(reply) });
        },
        None => {
          return slots;
        }
      }
    },
    Err(e) => {
      return slots.with(k, Slot { ...slots[k], sock: closed_slot(slots[k].sock), err: e });
    }
  }
  return slots;
}

// One round over the pending slots without a poll: each socket is made
// non-blocking and tried, a round that found nothing pausing a
// millisecond so the wait does not spin.
function sweep_replies(slots: Slot[], pending: i32[]): Slot[] {
  var out: Slot[] = slots;
  var i: i32 = 0;
  while (i < pending.len()) {
    var k: i32 = pending[i];
    var nb: Result[void, net.NetError] = net.set_nonblocking(out[k].sock, true);
    out = taken(out, k);
    i = i + 1;
  }
  if (pending_slots(out).len() == pending.len()) {
    sleep_ms(1i64);
  }
  return out;
}

// The socket closed, and -1 for the slot that held it.
function closed_slot(sock: i32): i32 {
  var closed: Result[void, net.NetError] = net.close(sock);
  return 0 - 1;
}

// Which of the pending slots is readable within `wait_ms`, as an index
// into `pending`; -1 at the deadline, -2 where the host has no poll: the
// poll shape std/tcp's recv-with-deadline uses. A native poll(2) honours
// the timeout and answers the first readable socket; wasm ignores its
// argument and the timer pollable fires at the deadline; the
// interpreter's poll is a stub that answers -1 at once, which is told
// from a native timeout by the time that passed.
function first_readable(slots: Slot[], pending: i32[], wait_ms: i32): i32 {
  var ms: i32 = wait_ms;
  if (ms < 1) {
    ms = 1;
  }
  var ns_per_ms: i64 = 1000000i64;
  var start: i64 = monotonic_ns();
  var pollset: i32[] = [];
  var i: i32 = 0;
  while (i < pending.len()) {
    pollset = pollset.append(tcp_pollable(slots[pending[i]].sock));
    i = i + 1;
  }
  var timer: i32 = wasm_timer_pollable(ms as i64 * ns_per_ms);
  pollset = pollset.append(timer);
  var ready: i32 = poll(pollset, ms);
  i = 0;
  while (i < pollset.len()) {
    var dropped: i32 = wasm_pollable_drop(pollset[i]);
    i = i + 1;
  }
  if (ready >= 0 && ready < pending.len()) {
    return ready;
  }
  if (ready == pending.len()) {
    return 0 - 1;
  }
  var waited: i64 = monotonic_ns() - start;
  if (waited * 2i64 >= ms as i64 * ns_per_ms) {
    return 0 - 1;
  }
  return 0 - 2;
}

// One datagram off `sock`: the reply to `q` when it is one, `None` when
// it is something else or nothing was queued after all.
function take_reply(sock: i32, q: Message): Result[Option[Message], DnsError] {
  var buf: u8[] = zero_bytes(udp_payload());
  var n: i32 = 0;
  match (net.recv_from(sock, buf)) {
    Ok(got) => {
      n = got.0;
    },
    Err(e) => {
      match (e) {
        WouldBlock => {
          return Ok(None);
        },
        _ => {
          return Err(Socket(e));
        }
      }
    }
  }
  match (decode(buf.take(n))) {
    Ok(reply) => {
      if (reply.id == q.id && reply.response && reply.answers_question(q.questions[0])) {
        return Ok(Some(reply));
      }
      return Ok(None);
    },
    Err(_) => {
      return Ok(None);
    }
  }
  return Ok(None);
}

// `exchange_tcp(ns, q, timeout_ms)` — the query over TCP: the message
// behind a two-byte length, the reply read until its own length is
// satisfied, each read awaited up to the timeout.
pub function exchange_tcp(ns: net.SocketAddr, q: Message, timeout_ms: i32): Result[Message, DnsError] {
  var bytes: u8[] = encode(q)?;
  var framed: u8[] = [];
  framed = put16(framed, bytes.len());
  var sock: i32 = send_tcp(ns, framed.concat(bytes))?;
  var got: Result[u8[], DnsError] = read_framed(sock, now_ms() + timeout_ms as i64);
  tcp_close(sock);
  var reply: Message = decode(got?)?;
  if (reply.id != q.id || !reply.response || !reply.answers_question(q.questions[0])) {
    return Err(Malformed);
  }
  return Ok(reply);
}

// A connection to the nameserver with `framed` written to it.
function send_tcp(ns: net.SocketAddr, framed: u8[]): Result[i32, DnsError] {
  var sock: i32 = 0;
  match (net.connect(ns)) {
    Ok(s) => {
      sock = s;
    },
    Err(e) => {
      return Err(Socket(e));
    }
  }
  var sent: i32 = tcp_send(sock, string_from_bytes_unchecked(framed));
  if (sent < 0) {
    tcp_close(sock);
    return Err(Socket(net.error_from_errno(sent)));
  }
  return Ok(sock);
}

// The message behind the two-byte length on `sock`, each read awaited up
// to `deadline`: `NoReply` when it passes, `Malformed` when the peer
// closes short of the length.
function read_framed(sock: i32, deadline: i64): Result[u8[], DnsError] {
  var buf: u8[] = [];
  var want: i32 = -1;
  while (want < 0 || buf.len() < want) {
    var left: i32 = (deadline - now_ms()) as i32;
    if (left <= 0 || !readable_within(sock, left)) {
      return Err(NoReply);
    }
    var chunk: u8[] = tcp_recv(sock, 4096);
    if (chunk.len() == 0) {
      return Err(Malformed);
    }
    buf = buf.concat(chunk);
    if (want < 0 && buf.len() >= 2) {
      want = 2 + be16(buf, 0);
    }
  }
  return Ok(buf.drop(2).take(want - 2));
}

// `ask(conf, q)` — res_send: `q` put to the nameservers of `conf` in
// turn, `attempts` times round, from a rotating start under `rotate`,
// until one answers. A reply with SERVFAIL or REFUSED, silence, and an
// unreachable server each hand the query to the next; when every server
// has been tried the failure reported is SERVFAIL if any said so, else
// REFUSED, else silence, else the last socket error.
pub function ask(conf: ResolvConf, q: Message): Result[Message, DnsError] {
  return ask_many(conf, [q])[0];
}

// `ask_many(conf, qs)` — `ask` for several queries at once: the queries
// still unanswered go to each server together (`exchange_many`), and a
// server's answer to one is kept while the others go on to the next.
// The answers are parallel to `qs`.
pub function ask_many(conf: ResolvConf, qs: Message[]): Result[Message, DnsError][] {
  var n: i32 = conf.nameservers.len();
  var asked: Asked[] = [];
  var i: i32 = 0;
  while (i < qs.len()) {
    asked = asked.append(Asked { reply: None, tally: Tally { servfail: false, refused: false, silent: false, last: NoNameserver } });
    i = i + 1;
  }
  if (n > 0) {
    var start: i32 = 0;
    if (conf.rotate) {
      start = (random_i32() & 2147483647) % n;
    }
    var round: i32 = 0;
    while (round < conf.attempts) {
      var k: i32 = 0;
      while (k < n) {
        asked = ask_server(conf.nameservers[(start + k) % n], qs, asked, conf.timeout_ms);
        k = k + 1;
      }
      round = round + 1;
    }
  }
  var out: Result[Message, DnsError][] = [];
  i = 0;
  while (i < asked.len()) {
    out = out.append(asked_result(asked[i]));
    i = i + 1;
  }
  return out;
}

// One query's progress through the servers: its answer once a server
// gave one, else what the servers said so far.
struct Asked { reply: Option[Message], tally: Tally }

function asked_result(a: Asked): Result[Message, DnsError] {
  match (a.reply) {
    Some(reply) => {
      return Ok(reply);
    },
    None => {
      return Err(tally_error(a.tally));
    }
  }
  return Err(tally_error(a.tally));
}

function unanswered(a: Asked): boolean {
  match (a.reply) {
    Some(_) => {
      return false;
    },
    None => {
      return true;
    }
  }
  return true;
}

// The unanswered queries put to one server, their replies noted.
function ask_server(ns: net.SocketAddr, qs: Message[], asked: Asked[], timeout_ms: i32): Asked[] {
  var open: i32[] = [];
  var open_qs: Message[] = [];
  var i: i32 = 0;
  while (i < asked.len()) {
    if (unanswered(asked[i])) {
      open = open.append(i);
      open_qs = open_qs.append(qs[i]);
    }
    i = i + 1;
  }
  if (open.len() == 0) {
    return asked;
  }
  var replies: Result[Message, DnsError][] = exchange_many(ns, open_qs, timeout_ms);
  var out: Asked[] = asked;
  i = 0;
  while (i < open.len()) {
    out = out.with(open[i], noted(out[open[i]], replies[i]));
    i = i + 1;
  }
  return out;
}

// A server's answer to one query folded into its progress: a usable
// reply settles it, SERVFAIL, REFUSED and a failure are tallied.
function noted(a: Asked, r: Result[Message, DnsError]): Asked {
  match (r) {
    Ok(reply) => {
      if (reply.rcode != rcode_server_failure() && reply.rcode != rcode_refused()) {
        return Asked { ...a, reply: Some(reply) };
      }
      return Asked { ...a, tally: noted_rcode(a.tally, reply.rcode) };
    },
    Err(e) => {
      return Asked { ...a, tally: noted_failure(a.tally, e) };
    }
  }
  return a;
}

// What the servers said while none answered: the failures seen, and the
// last error that was neither silence nor a server's own code.
struct Tally { servfail: boolean, refused: boolean, silent: boolean, last: DnsError }

function noted_rcode(t: Tally, rcode: i32): Tally {
  if (rcode == rcode_server_failure()) {
    return Tally { ...t, servfail: true };
  }
  return Tally { ...t, refused: true };
}

function noted_failure(t: Tally, e: DnsError): Tally {
  match (e) {
    NoReply => {
      return Tally { ...t, silent: true };
    },
    _ => {
      return Tally { ...t, last: e };
    }
  }
  return t;
}

function tally_error(t: Tally): DnsError {
  if (t.servfail) {
    return ServerFailure;
  }
  if (t.refused) {
    return Refused;
  }
  if (t.silent) {
    return NoReply;
  }
  return t.last;
}

// ---------------------------------------------------------------------------
// Lookups

// `answer_records(reply, qname, rtype)` — the records of `rtype` a reply
// to `qname` carries, following the CNAME chain, as the result of the
// query: NXDOMAIN is `NoSuchName`, a clean reply with none of them
// `NoData`, SERVFAIL and REFUSED their errors, any other rcode
// `Malformed`.
pub function answer_records(reply: Message, qname: string, rtype: i32): Result[Answer, DnsError] {
  if (reply.rcode == rcode_name_error()) {
    return Err(NoSuchName);
  }
  if (reply.rcode == rcode_server_failure()) {
    return Err(ServerFailure);
  }
  if (reply.rcode == rcode_refused()) {
    return Err(Refused);
  }
  if (reply.rcode != rcode_ok()) {
    return Err(Malformed);
  }
  var a: Answer = records_for(reply, qname, rtype);
  if (a.records.len() == 0) {
    return Err(NoData);
  }
  return Ok(a);
}

// `lookup_records_with(conf, name, rtype, asker)` — `search_with` over
// the plan for `name`; `rtype` is the asker's to put in its queries.
pub function lookup_records_with(conf: ResolvConf, name: string, rtype: i32, asker: (string) => Result[Answer, DnsError]): Result[Answer, DnsError] {
  return search_with(search_plan(name, conf), asker);
}

// `search_with(plan, asker)` — the search walk of __res_context_search
// over `asker`, which answers one query: the first name with records
// wins. A `NoSuchName` or `NoData` moves on to the next candidate;
// `ServerFailure` does too but is remembered; `Refused` from a suffix
// ends the walk; silence or a socket error ends the suffixes but the
// as-is name is still tried when it comes last. When the walk finds
// nothing, the as-is query's failure is reported when it led, else a
// remembered `ServerFailure`, else the last failure.
pub function search_with(plan: SearchPlan, asker: (string) => Result[Answer, DnsError]): Result[Answer, DnsError] {
  var lead_failed: boolean = false;
  var lead_err: DnsError = NoSuchName;
  if (plan.leads) {
    match (asker(plan.as_is)) {
      Ok(a) => {
        return Ok(a);
      },
      Err(e) => {
        lead_failed = true;
        lead_err = e;
      }
    }
  }
  var sfx: Suffixes = search_suffixes(plan.suffixes, asker);
  match (sfx.answer) {
    Some(a) => {
      return Ok(a);
    },
    None => {}
  }
  if (sfx.refused) {
    return Err(Refused);
  }
  var last: DnsError = sfx.last;
  if (!plan.leads) {
    match (asker(plan.as_is)) {
      Ok(a) => {
        return Ok(a);
      },
      Err(e) => {
        last = e;
      }
    }
  }
  return Err(search_failure(lead_failed, lead_err, sfx.servfail, last));
}

// What a walk that found nothing reports: the as-is query's failure when
// it led, else a server failure a suffix met, else the last failure.
function search_failure(lead_failed: boolean, lead_err: DnsError, servfail: boolean, last: DnsError): DnsError {
  if (lead_failed) {
    return lead_err;
  }
  if (servfail) {
    return ServerFailure;
  }
  return last;
}

// How the search domains went: the answer one gave, or whether one was
// refused (the walk ends), whether one failed at the server, and the
// last failure.
struct Suffixes { answer: Option[Answer], refused: boolean, servfail: boolean, last: DnsError }

function search_suffixes(suffixes: string[], asker: (string) => Result[Answer, DnsError]): Suffixes {
  var out: Suffixes = Suffixes { answer: None, refused: false, servfail: false, last: NoSuchName };
  var i: i32 = 0;
  while (i < suffixes.len()) {
    match (asker(suffixes[i])) {
      Ok(a) => {
        return Suffixes { ...out, answer: Some(a) };
      },
      Err(e) => {
        out = suffix_failed(out, e);
        if (out.refused || !continues_search(e)) {
          return out;
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function suffix_failed(out: Suffixes, e: DnsError): Suffixes {
  match (e) {
    Refused => {
      return Suffixes { ...out, refused: true };
    },
    ServerFailure => {
      return Suffixes { ...out, servfail: true };
    },
    _ => {
      return Suffixes { ...out, last: e };
    }
  }
  return out;
}

// Whether a suffix's failure lets the next suffix be tried: a name the
// server does not know does, silence and a socket error do not.
function continues_search(e: DnsError): boolean {
  match (e) {
    NoSuchName => {
      return true;
    },
    NoData => {
      return true;
    },
    ServerFailure => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// `lookup_records(conf, name, rtype)` — `lookup_records_with` over the
// nameservers of `conf`.
pub function lookup_records(conf: ResolvConf, name: string, rtype: i32): Result[Answer, DnsError] {
  return lookup_records_with(conf, name, rtype, (qname: string): Result[Answer, DnsError] => ask_one(conf, qname, rtype));
}

// One query of the walk: `qname` put to the nameservers and its reply
// read for the records of `rtype`.
function ask_one(conf: ResolvConf, qname: string, rtype: i32): Result[Answer, DnsError] {
  var reply: Message = ask(conf, query(new_id(), qname, rtype))?;
  return answer_records(reply, qname, rtype);
}

// `lookup_a(conf, name)` — the IPv4 addresses of `name`.
pub function lookup_a(conf: ResolvConf, name: string): Result[net.IpAddr[], DnsError] {
  var a: Answer = lookup_records(conf, name, type_a())?;
  return Ok(addresses_of(a.records));
}

// `lookup_aaaa(conf, name)` — the IPv6 addresses of `name`.
pub function lookup_aaaa(conf: ResolvConf, name: string): Result[net.IpAddr[], DnsError] {
  var a: Answer = lookup_records(conf, name, type_aaaa())?;
  return Ok(addresses_of(a.records));
}

// `canonical_name(conf, name)` — the owner of `name`'s A records once
// its CNAME chain is followed, as getaddrinfo's AI_CANONNAME reads it off
// the DNS backend.
pub function canonical_name(conf: ResolvConf, name: string): Result[string, DnsError] {
  var a: Answer = lookup_records(conf, name, type_a())?;
  return Ok(a.canonical);
}

// `lookup_addresses(conf, name)` — every address of `name`: its A and
// AAAA records asked together at each step of the search walk, the
// result in RFC 6724 order. A candidate name is passed over only when
// both record types pass it over (`NoSuchName`, `NoData`); a failure on
// either ends the walk as it does for one query.
pub function lookup_addresses(conf: ResolvConf, name: string): Result[net.IpAddr[], DnsError] {
  var found: net.IpAddr[] = found_addresses(conf, name)?;
  return Ok(sort_addresses(found));
}

// The paired walk's addresses for `name`, in the order the server gave.
function found_addresses(conf: ResolvConf, name: string): Result[net.IpAddr[], DnsError] {
  var a: Answer = search_with(search_plan(name, conf), (qname: string): Result[Answer, DnsError] => ask_pair(conf, qname))?;
  return Ok(addresses_of(a.records));
}

// One step of the paired walk: `qname`'s A and AAAA queries put to the
// nameservers together, their replies read and combined.
function ask_pair(conf: ResolvConf, qname: string): Result[Answer, DnsError] {
  var replies: Result[Message, DnsError][] = ask_many(conf, [query(new_id(), qname, type_a()), query(new_id(), qname, type_aaaa())]);
  return combine_pair(reply_records(replies[0], qname, type_a()), reply_records(replies[1], qname, type_aaaa()));
}

function reply_records(r: Result[Message, DnsError], qname: string, rtype: i32): Result[Answer, DnsError] {
  var reply: Message = r?;
  return answer_records(reply, qname, rtype);
}

// `combine_pair(a, aaaa)` — the two record types' results as one: the
// records of both when either has some, under the A query's canonical
// name when it has one. When neither has, a failure that ends a search
// (silence, a socket error, SERVFAIL, REFUSED) is reported over one that
// passes a name over, the A query's first; both passing it over is
// `NoSuchName` only when both said so, else `NoData`.
pub function combine_pair(a: Result[Answer, DnsError], aaaa: Result[Answer, DnsError]): Result[Answer, DnsError] {
  match (a) {
    Ok(ra) => {
      match (aaaa) {
        Ok(r6) => {
          return Ok(Answer { canonical: ra.canonical, records: ra.records.concat(r6.records) });
        },
        Err(_) => {
          return Ok(ra);
        }
      }
    },
    Err(ea) => {
      match (aaaa) {
        Ok(r6) => {
          return Ok(r6);
        },
        Err(e6) => {
          return Err(pair_failure(ea, e6));
        }
      }
    }
  }
  return a;
}

function pair_failure(ea: DnsError, e6: DnsError): DnsError {
  if (!passes_over(ea)) {
    return ea;
  }
  if (!passes_over(e6)) {
    return e6;
  }
  if (is_no_such_name(ea) && is_no_such_name(e6)) {
    return NoSuchName;
  }
  return NoData;
}

// Whether a failure passes a search candidate over rather than ending
// the walk.
function passes_over(e: DnsError): boolean {
  match (e) {
    NoSuchName => {
      return true;
    },
    NoData => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function is_no_such_name(e: DnsError): boolean {
  match (e) {
    NoSuchName => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// ---------------------------------------------------------------------------
// Address ordering (RFC 6724 §6)
//
// A name with several addresses is tried in the order the destination
// address selection rules give, each destination judged beside the
// source address the host would use for it: an address the host has no
// route to goes last, then matching scope, matching label, higher
// precedence, smaller scope and the longest common prefix decide, and
// what they leave tied keeps the order the server gave. The rules for
// deprecated and home addresses and for native transport need what no
// socket reports and are skipped, as Go skips them.

// `Policy` — an address's row of the RFC 6724 §2.1 policy table.
pub struct Policy { precedence: i32, label: i32 }

// `policy_of(ip)` — the policy table row for `ip`, an IPv4 address read
// as its v4-mapped form: `::1` 50/0, `::/0` 40/1, `::ffff:0:0/96` 35/4,
// `2002::/16` 30/2, `2001::/32` 5/5, `fc00::/7` 3/13, `::/96` 1/3,
// `fec0::/10` 1/11, `3ffe::/16` 1/12.
pub function policy_of(ip: net.IpAddr): Policy {
  if (ip.is_v4()) {
    return Policy { precedence: 35, label: 4 };
  }
  if (ip.is_loopback()) {
    return Policy { precedence: 50, label: 0 };
  }
  var b: u8[] = ip.bytes();
  if (leading_zero_bytes(b) >= 10) {
    return policy_embedded(b);
  }
  return policy_prefixed(b);
}

// The rows for an address whose first ten bytes are zero: v4-mapped and
// IPv4-compatible, else the default.
function policy_embedded(b: u8[]): Policy {
  if (b[10] == 255u8 && b[11] == 255u8) {
    return Policy { precedence: 35, label: 4 };
  }
  if (b[10] == 0u8 && b[11] == 0u8) {
    return Policy { precedence: 1, label: 3 };
  }
  return Policy { precedence: 40, label: 1 };
}

// The rows keyed on a leading prefix: 6to4, Teredo and 6bone here, the
// local prefixes in policy_local, else the default.
function policy_prefixed(b: u8[]): Policy {
  if (b[0] == 32u8 && b[1] == 2u8) {
    return Policy { precedence: 30, label: 2 };
  }
  if (b[0] == 32u8 && b[1] == 1u8 && b[2] == 0u8 && b[3] == 0u8) {
    return Policy { precedence: 5, label: 5 };
  }
  if (b[0] == 63u8 && b[1] == 254u8) {
    return Policy { precedence: 1, label: 12 };
  }
  return policy_local(b);
}

// Unique local (`fc00::/7`) and site-local (`fec0::/10`) addresses, else
// the default row.
function policy_local(b: u8[]): Policy {
  if ((b[0] & 254u8) == 252u8) {
    return Policy { precedence: 3, label: 13 };
  }
  if (b[0] == 254u8 && (b[1] & 192u8) == 192u8) {
    return Policy { precedence: 1, label: 11 };
  }
  return Policy { precedence: 40, label: 1 };
}

// How many of the address's bytes are zero before the first that is not.
function leading_zero_bytes(b: u8[]): i32 {
  var n: i32 = 0;
  while (n < b.len() && b[n] == 0u8) {
    n = n + 1;
  }
  return n;
}

// `scope_of(ip)` — the address's scope as RFC 6724 §3 reads it, in the
// IPv6 multicast scope numbers: link-local is 2 (loopback and
// `fe80::/10`, `127/8` and `169.254/16`), site-local 5 (`fec0::/10`),
// global 14, and a multicast address its own nibble.
pub function scope_of(ip: net.IpAddr): i32 {
  if (ip.is_v4()) {
    return scope_v4(ip.bytes());
  }
  return scope_v6(ip, ip.bytes());
}

function scope_v4(b: u8[]): i32 {
  if (b[0] == 127u8 || b[0] == 169u8 && b[1] == 254u8) {
    return 2;
  }
  if (b[0] == 224u8 && b[1] == 0u8 && b[2] == 0u8) {
    return 2;
  }
  if (b[0] == 239u8) {
    return 5;
  }
  return 14;
}

function scope_v6(ip: net.IpAddr, b: u8[]): i32 {
  if (b[0] == 255u8) {
    return (b[1] & 15u8) as i32;
  }
  if (ip.is_loopback() || b[0] == 254u8 && (b[1] & 192u8) == 128u8) {
    return 2;
  }
  if (b[0] == 254u8 && (b[1] & 192u8) == 192u8) {
    return 5;
  }
  return 14;
}

// `common_prefix_len(a, b)` — how many leading bits two IPv6 addresses
// share, at most 64 since the interface identifier says nothing about
// the route; 0 when either is IPv4. The RFC's rule 9 reads both families,
// but Go does not compare it for IPv4 (go.dev/issue/13283), and this
// follows Go.
pub function common_prefix_len(a: net.IpAddr, b: net.IpAddr): i32 {
  if (a.is_v4() || b.is_v4()) {
    return 0;
  }
  var ab: u8[] = a.bytes();
  var bb: u8[] = b.bytes();
  var bits: i32 = 0;
  var i: i32 = 0;
  while (i < 8) {
    var x: i32 = (ab[i] ^ bb[i]) as i32;
    if (x != 0) {
      var m: i32 = 128;
      while (m > 0 && (x & m) == 0) {
        bits = bits + 1;
        m = m >> 1;
      }
      return bits;
    }
    bits = bits + 8;
    i = i + 1;
  }
  return bits;
}

// `source_for(dst)` — the address the host would send to `dst` from: a
// datagram socket connected to it, which picks the route without a
// packet, asked for its local address; `None` when the host has no
// route, which is what makes `dst` unusable.
pub function source_for(dst: net.IpAddr): Option[net.IpAddr] {
  var probe: net.SocketAddr = net.socket_addr(dst, 9);
  var sock: i32 = 0;
  match (net.udp_socket(local_for(probe))) {
    Ok(s) => {
      sock = s;
    },
    Err(_) => {
      return None;
    }
  }
  var found: Option[net.IpAddr] = None;
  match (net.set_peer(sock, probe)) {
    Ok(_) => {
      match (net.local_addr(sock)) {
        Ok(local) => {
          found = Some(local.ip);
        },
        Err(_) => {}
      }
    },
    Err(_) => {}
  }
  var closed: Result[void, net.NetError] = net.close(sock);
  return found;
}

// `order_addresses(dsts, srcs)` — `dsts` in RFC 6724 order, `srcs[i]`
// being the source the host would use for `dsts[i]` (`None` for no
// route). A stable sort, so what the rules leave tied keeps its order.
pub function order_addresses(dsts: net.IpAddr[], srcs: Option[net.IpAddr][]): net.IpAddr[] {
  var out: net.IpAddr[] = [];
  var taken: boolean[] = [];
  var i: i32 = 0;
  while (i < dsts.len()) {
    taken = taken.append(false);
    i = i + 1;
  }
  var placed: i32 = 0;
  while (placed < dsts.len()) {
    var best: i32 = 0 - 1;
    i = 0;
    while (i < dsts.len()) {
      if (!taken[i] && (best < 0 || prefers(dsts[i], srcs[i], dsts[best], srcs[best]) < 0)) {
        best = i;
      }
      i = i + 1;
    }
    taken = taken.with(best, true);
    out = out.append(dsts[best]);
    placed = placed + 1;
  }
  return out;
}

// `sort_addresses(dsts)` — `order_addresses` over the source the host
// would use for each destination.
pub function sort_addresses(dsts: net.IpAddr[]): net.IpAddr[] {
  var srcs: Option[net.IpAddr][] = [];
  var i: i32 = 0;
  while (i < dsts.len()) {
    srcs = srcs.append(source_for(dsts[i]));
    i = i + 1;
  }
  return order_addresses(dsts, srcs);
}

// The rules in order, for two destinations beside their sources:
// negative when `a` goes first, positive when `b` does, 0 when they tie.
function prefers(a: net.IpAddr, sa: Option[net.IpAddr], b: net.IpAddr, sb: Option[net.IpAddr]): i32 {
  match (sa) {
    Some(src_a) => {
      match (sb) {
        Some(src_b) => {
          return prefers_routed(a, src_a, b, src_b);
        },
        None => {
          return 0 - 1;
        }
      }
    },
    None => {
      match (sb) {
        Some(_) => {
          return 1;
        },
        None => {
          return 0;
        }
      }
    }
  }
  return 0;
}

// Rules 2, 5, 6, 8 and 9 for two destinations the host can reach.
function prefers_routed(a: net.IpAddr, sa: net.IpAddr, b: net.IpAddr, sb: net.IpAddr): i32 {
  var scope_a: i32 = scope_of(a);
  var scope_b: i32 = scope_of(b);
  var r: i32 = prefer_true(scope_a == scope_of(sa), scope_b == scope_of(sb));
  if (r != 0) {
    return r;
  }
  var pa: Policy = policy_of(a);
  var pb: Policy = policy_of(b);
  r = prefer_true(pa.label == policy_of(sa).label, pb.label == policy_of(sb).label);
  if (r != 0) {
    return r;
  }
  if (pa.precedence != pb.precedence) {
    return pb.precedence - pa.precedence;
  }
  if (scope_a != scope_b) {
    return scope_a - scope_b;
  }
  return common_prefix_len(b, sb) - common_prefix_len(a, sa);
}

// Which of two destinations a rule's test singles out: the one it holds
// for, when it holds for exactly one.
function prefer_true(for_a: boolean, for_b: boolean): i32 {
  if (for_a && !for_b) {
    return 0 - 1;
  }
  if (for_b && !for_a) {
    return 1;
  }
  return 0;
}

// ---------------------------------------------------------------------------
// Dialing (RFC 8305, Happy Eyeballs)
//
// A name's addresses are tried in turn rather than one after another to
// completion: the first attempt runs alone for the attempt delay, then
// the next address is tried beside it, and so on, the first to connect
// winning and the rest closed. An attempt that fails hands its turn to
// the next at once. The addresses are in RFC 6724 order with the
// families alternating (§4), so a family whose packets go nowhere costs
// one delay rather than the whole list.

// `DialOptions` — how `connect_race` and `dial` try a name's addresses:
// `fallback_ms` is how long an attempt runs alone before the next address
// is tried beside it (the connection attempt delay, Go's 300 ms), and
// `timeout_ms` bounds the whole dial.
pub struct DialOptions { fallback_ms: i32, timeout_ms: i32 }

// `dial_options()` — 300 ms between attempts and ten seconds in all.
pub function dial_options(): DialOptions {
  return DialOptions { fallback_ms: 300, timeout_ms: 10000 };
}

// `interleave_families(addrs)` — RFC 8305 §4's order: the first address's
// family leads and the families alternate from there, each keeping its
// own order.
pub function interleave_families(addrs: net.IpAddr[]): net.IpAddr[] {
  if (addrs.len() == 0) {
    return addrs;
  }
  var lead_v6: boolean = addrs[0].is_v6();
  var lead: net.IpAddr[] = [];
  var other: net.IpAddr[] = [];
  var i: i32 = 0;
  while (i < addrs.len()) {
    if (addrs[i].is_v6() == lead_v6) {
      lead = lead.append(addrs[i]);
    } else {
      other = other.append(addrs[i]);
    }
    i = i + 1;
  }
  var out: net.IpAddr[] = [];
  i = 0;
  while (i < lead.len() || i < other.len()) {
    if (i < lead.len()) {
      out = out.append(lead[i]);
    }
    if (i < other.len()) {
      out = out.append(other[i]);
    }
    i = i + 1;
  }
  return out;
}

// One connect under way: its socket, watched for writability, which is
// how a connect reports that it ended.
struct Attempt { sock: i32 }

// `connect_race(addrs, port, opts)` — a connection to the first of
// `addrs` at `port` that answers, as the section above says, in the
// blocking mode `connect` gives: `TimedOut` once `timeout_ms` passes
// with none connected, the last failure when every address failed,
// `HostUnreachable` for no addresses.
pub function connect_race(addrs: net.IpAddr[], port: i32, opts: DialOptions): Result[i32, net.NetError] {
  var drv: async.RealDriver = async.real_driver();
  var deadline: i64 = now_ms() + opts.timeout_ms as i64;
  var race: Race = Race { open: [], next: 0, due: now_ms(), last: HostUnreachable };
  while (true) {
    var now: i64 = now_ms();
    if (now >= deadline) {
      close_attempts(drv, race.open);
      return Err(TimedOut);
    }
    if (race.next < addrs.len() && (race.open.len() == 0 || now >= race.due)) {
      race = started(drv, race, net.socket_addr(addrs[race.next], port), opts);
      continue;
    }
    if (race.open.len() == 0) {
      return Err(race.last);
    }
    var woke: i32[] = drv.wait(race.open.len(), wait_window(race, addrs.len(), now, deadline));
    match (settled(drv, race)) {
      Ok(sock) => {
        var blocking: Result[void, net.NetError] = net.set_nonblocking(sock, false);
        return Ok(sock);
      },
      Err(after) => {
        race = after;
      }
    }
  }
  return Err(TimedOut);
}

// How long the race may wait before it has something to do: the next
// attempt's start when an address is left, else the deadline, and at
// least a millisecond.
function wait_window(race: Race, n: i32, now: i64, deadline: i64): i32 {
  var wait_ms: i32 = (deadline - now) as i32;
  if (race.next < n && (race.due - now) as i32 < wait_ms) {
    wait_ms = (race.due - now) as i32;
  }
  if (wait_ms < 1) {
    return 1;
  }
  return wait_ms;
}

// The race's state: the attempts under way, the next address to try,
// when it may start, and the last failure.
struct Race { open: Attempt[], next: i32, due: i64, last: net.NetError }

// The next address's attempt started: watched when it is under way, the
// turn handed on at once when it failed to start. Where the host
// connects before answering (the interpreter), the attempt is already
// settled and the next wait finds it so.
function started(drv: async.RealDriver, race: Race, addr: net.SocketAddr, opts: DialOptions): Race {
  var next: i32 = race.next + 1;
  match (net.connect_start(addr)) {
    Ok(sock) => {
      var watched: i32 = drv.watch(sock, 2);
      return Race { open: race.open.append(Attempt { sock: sock }), next: next, due: now_ms() + opts.fallback_ms as i64, last: race.last };
    },
    Err(e) => {
      return Race { ...race, next: next, due: now_ms(), last: e };
    }
  }
  return Race { ...race, next: next };
}

// Every open attempt asked how its connect ended: the first that
// connected is the winner, the others closed; one that failed is closed
// and its turn handed on at once; the rest stay open.
function settled(drv: async.RealDriver, race: Race): Result[i32, Race] {
  var keep: Attempt[] = [];
  var out: Race = race;
  var i: i32 = 0;
  while (i < race.open.len()) {
    var a: Attempt = race.open[i];
    match (net.connect_result(a.sock)) {
      Ok(_) => {
        var unwatched: i32 = drv.unwatch(a.sock);
        close_attempts(drv, keep);
        close_attempts(drv, after(race.open, i));
        return Ok(a.sock);
      },
      Err(e) => {
        if (e.eq(net.InProgress)) {
          keep = keep.append(a);
        } else {
          close_attempts(drv, [a]);
          out = Race { ...out, due: now_ms(), last: e };
        }
      }
    }
    i = i + 1;
  }
  return Err(Race { ...out, open: keep });
}

// The attempts past index `i`.
function after(attempts: Attempt[], i: i32): Attempt[] {
  var out: Attempt[] = [];
  var k: i32 = i + 1;
  while (k < attempts.len()) {
    out = out.append(attempts[k]);
    k = k + 1;
  }
  return out;
}

function close_attempts(drv: async.RealDriver, attempts: Attempt[]): void {
  var i: i32 = 0;
  while (i < attempts.len()) {
    var unwatched: i32 = drv.unwatch(attempts[i].sock);
    var closed: Result[void, net.NetError] = net.close(attempts[i].sock);
    i = i + 1;
  }
}

// `dial(name, port, opts)` — `name` resolved and its addresses raced:
// a connection, or the resolver's failure, or the dial's as
// `Socket(e)`.
pub function dial(name: string, port: i32, opts: DialOptions): Result[i32, DnsError] {
  var addrs: net.IpAddr[] = resolve(name)?;
  match (connect_race(interleave_families(addrs), port, opts)) {
    Ok(sock) => {
      return Ok(sock);
    },
    Err(e) => {
      return Err(Socket(e));
    }
  }
  return Err(NoNameserver);
}

// ---------------------------------------------------------------------------
// NAT64 (RFC 7050 discovery, RFC 6052 synthesis)

// `Nat64Prefix` — a prefix a NAT64 translator answers under: the first
// `bits` bits of `bytes` (32, 40, 48, 56, 64 or 96), the rest zero.
pub struct Nat64Prefix { bytes: u8[], bits: i32 }

// `nat64_prefix_of(aaaa)` — the prefix an AAAA record for ipv4only.arpa
// reveals: the well-known 192.0.0.170 or 192.0.0.171 embedded where RFC
// 6052 puts an IPv4 address under one of the six prefix lengths, the
// longest tried first, as RFC 7050 §3 reads it; `None` for an address
// that embeds neither.
pub function nat64_prefix_of(aaaa: net.IpAddr): Option[Nat64Prefix] {
  if (!aaaa.is_v6()) {
    return None;
  }
  var b: u8[] = aaaa.bytes();
  var lengths: i32[] = [96, 64, 56, 48, 40, 32];
  var i: i32 = 0;
  while (i < lengths.len()) {
    if (is_well_known(embedded_v4(b, lengths[i]))) {
      return Some(Nat64Prefix { bytes: b.take(lengths[i] / 8).concat(zero_bytes(16 - lengths[i] / 8)), bits: lengths[i] });
    }
    i = i + 1;
  }
  return None;
}

// RFC 7050's well-known IPv4 addresses, 192.0.0.170 and 192.0.0.171.
function is_well_known(v4: u8[]): boolean {
  return v4[0] == 192u8 && v4[1] == 0u8 && v4[2] == 0u8 && (v4[3] == 170u8 || v4[3] == 171u8);
}

// The IPv4 address an IPv6 address embeds under a prefix of `bits`, in
// RFC 6052 §2.2's layout: the four bytes after the prefix, skipping byte
// 8, which a /40, /48 or /56 prefix's address straddles.
function embedded_v4(b: u8[], bits: i32): u8[] {
  var out: u8[] = [];
  var at: i32 = bits / 8;
  while (out.len() < 4) {
    if (at != 8) {
      out = out.append(b[at]);
    }
    at = at + 1;
  }
  return out;
}

// `synthesize(prefix, v4)` — `v4` under `prefix` as RFC 6052 §2.2 lays
// it out: the four bytes follow the prefix, skipping byte 8, which stays
// zero. An IPv6 address is answered as it is.
pub function synthesize(prefix: Nat64Prefix, v4: net.IpAddr): net.IpAddr {
  if (!v4.is_v4()) {
    return v4;
  }
  var src: u8[] = v4.bytes();
  var out: u8[] = prefix.bytes.take(prefix.bits / 8);
  var k: i32 = 0;
  while (out.len() < 16) {
    if (out.len() != 8 && k < 4) {
      out = out.append(src[k]);
      k = k + 1;
    } else {
      out = out.append(0u8);
    }
  }
  match (net.ipv6(out)) {
    Some(ip) => {
      return ip;
    },
    None => {
      return v4;
    }
  }
  return v4;
}

// `nat64_prefixes(conf)` — the prefixes the nameservers reveal through
// the AAAA records of ipv4only.arpa, each once, in the order the records
// came; none when the name has no such record or the query fails, which
// is every network without a translator.
pub function nat64_prefixes(conf: ResolvConf): Nat64Prefix[] {
  var out: Nat64Prefix[] = [];
  match (lookup_aaaa(conf, "ipv4only.arpa.")) {
    Ok(xs) => {
      var i: i32 = 0;
      while (i < xs.len()) {
        match (nat64_prefix_of(xs[i])) {
          Some(p) => {
            if (!has_prefix(out, p)) {
              out = out.append(p);
            }
          },
          None => {}
        }
        i = i + 1;
      }
    },
    Err(_) => {}
  }
  return out;
}

function has_prefix(ps: Nat64Prefix[], p: Nat64Prefix): boolean {
  var i: i32 = 0;
  while (i < ps.len()) {
    if (ps[i].bits == p.bits && same_bytes(ps[i].bytes, p.bytes)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function same_bytes(a: u8[], b: u8[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  var i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// `addrs` as this host can reach them: on a host with no IPv4 route and a
// list of IPv4 addresses with no IPv6 beside them (RFC 8305 §7.3), each is
// replaced by its synthesis under every prefix the nameservers reveal;
// elsewhere, or with no prefix revealed, `addrs` as it is.
function with_nat64(conf: ResolvConf, addrs: net.IpAddr[]): net.IpAddr[] {
  var i: i32 = 0;
  while (i < addrs.len()) {
    if (addrs[i].is_v6()) {
      return addrs;
    }
    i = i + 1;
  }
  if (addrs.len() == 0) {
    return addrs;
  }
  match (source_for(addrs[0])) {
    Some(_) => {
      return addrs;
    },
    None => {}
  }
  var prefixes: Nat64Prefix[] = nat64_prefixes(conf);
  if (prefixes.len() == 0) {
    return addrs;
  }
  var out: net.IpAddr[] = [];
  i = 0;
  while (i < addrs.len()) {
    var k: i32 = 0;
    while (k < prefixes.len()) {
      out = out.append(synthesize(prefixes[k], addrs[i]));
      k = k + 1;
    }
    i = i + 1;
  }
  return out;
}

// `system_conf()` — the resolver this machine is configured with: its
// `/etc/resolv.conf` over its hostname, the defaults when the file is
// missing.
pub function system_conf(): ResolvConf {
  var contents: string = "";
  match (read_file("/etc/resolv.conf")) {
    Ok(c) => {
      contents = c;
    },
    Err(_) => {}
  }
  return parse_resolv_conf(contents, hostname());
}

// `system_hosts()` — this machine's `/etc/hosts`, empty when missing.
pub function system_hosts(): HostsEntry[] {
  match (read_file("/etc/hosts")) {
    Ok(c) => {
      return parse_hosts(c);
    },
    Err(_) => {
      var none: HostsEntry[] = [];
      return none;
    }
  }
  var none2: HostsEntry[] = [];
  return none2;
}

// `resolve(name)` — the addresses of `name` on this machine: an address
// literal as it is, then the hosts file, then DNS. The first source with
// an address answers, the addresses in RFC 6724 order; DNS reports its
// failure when the hosts file has none. On a host with no IPv4 route,
// IPv4 addresses with no IPv6 beside them are synthesized under the
// NAT64 prefixes the nameservers reveal.
pub function resolve(name: string): Result[net.IpAddr[], DnsError] {
  var conf: ResolvConf = system_conf();
  match (net.ip_parse(name)) {
    Some(ip) => {
      return Ok(with_nat64(conf, [ip]));
    },
    None => {}
  }
  var hosts: net.IpAddr[] = hosts_lookup(system_hosts(), name);
  if (hosts.len() > 0) {
    return Ok(sort_addresses(with_nat64(conf, hosts)));
  }
  var found: net.IpAddr[] = found_addresses(conf, name)?;
  return Ok(sort_addresses(with_nat64(conf, found)));
}
