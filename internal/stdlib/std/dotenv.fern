// std/dotenv — parse a `.env` file (12-factor KEY=VALUE config) into a
// Map[string, string].
//
// `parse(s)` reads the common dotenv surface:
//   - `KEY=value` lines; the key and value are trimmed of surrounding
//     whitespace.
//   - blank lines and `#` comment lines (leading whitespace allowed)
//     are ignored.
//   - an optional `export ` prefix is stripped (`export KEY=value`).
//   - `KEY="value"` — double-quoted; the quotes are removed and the
//     escapes `\n \t \r \\ \" \'` are interpreted.
//   - `KEY='value'` — single-quoted; taken literally (no escapes).
//   - a line with no `=`, or an empty key, is skipped.
//   - on a repeated key the LAST assignment wins.
//
// `\r\n` line endings are handled (the trailing `\r` is trimmed). An
// inline `#` comment after an UNQUOTED value is NOT stripped — quote the
// value if it must contain `#` or trailing spaces.

import "core/map";
import "std/string";

function __de_is_space(c: i32): boolean {
    return c == 32 || c == 9 || c == 13;    // space, tab, CR
}

// __de_slice returns bytes [a, b) of `s` as a fresh string.
function __de_slice(s: string, a: i32, b: i32): string {
    var out: u8[] = [];
    var i: i32 = a;
    while (i < b) {
        out = out.append(s[i] as u8);
        i = i + 1;
    }
    return string_from_bytes_unchecked(out);
}

// __de_trim strips leading/trailing ASCII whitespace (incl. CR).
function __de_trim(s: string): string {
    var a: i32 = 0;
    var b: i32 = s.len();
    while (a < b && __de_is_space((s[a] as i32))) { a = a + 1; }
    while (b > a && __de_is_space((s[b - 1] as i32))) { b = b - 1; }
    return __de_slice(s, a, b);
}

// __de_unescape interprets the double-quoted escapes over `s` (the text
// INSIDE the quotes).
function __de_unescape(s: string): string {
    var out: u8[] = [];
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] == 92 && i + 1 < s.len()) {   // backslash
            var n: i32 = s[i + 1] as i32;
            if (n == 110)      { out = out.append(10 as u8); }   // \n
            else if (n == 116) { out = out.append(9 as u8); }    // \t
            else if (n == 114) { out = out.append(13 as u8); }   // \r
            else if (n == 92)  { out = out.append(92 as u8); }   // \\
            else if (n == 34)  { out = out.append(34 as u8); }   // \"
            else if (n == 39)  { out = out.append(39 as u8); }   // \'
            else { out = out.append(92 as u8); out = out.append(n as u8); }
            i = i + 2;
        } else {
            out = out.append(s[i] as u8);
            i = i + 1;
        }
    }
    return string_from_bytes_unchecked(out);
}

// `parse(s)` — the dotenv document `s` as a Map[string, string].
pub function parse(s: string): Map[string, string] {
    var m: Map[string, string] = map_new(8);
    var lines: string[] = s.split("\n");
    var li: i32 = 0;
    while (li < lines.len()) {
        var line: string = __de_trim(lines[li]);
        li = li + 1;
        if (line.len() == 0) { continue; }
        if (line[0] == 35) { continue; }                        // '#' comment
        if (line.starts_with("export ")) {
            line = __de_trim(__de_slice(line, 7, line.len()));
        }
        var eq: i32 = line.index_of("=");
        if (eq < 0) { continue; }
        var key: string = __de_trim(__de_slice(line, 0, eq));
        if (key.len() == 0) { continue; }
        var raw: string = __de_trim(__de_slice(line, eq + 1, line.len()));
        var val: string = raw;
        if (raw.len() >= 2 && raw[0] == 34 && raw[raw.len() - 1] == 34) {
            val = __de_unescape(__de_slice(raw, 1, raw.len() - 1));      // "..."
        } else if (raw.len() >= 2 && raw[0] == 39 && raw[raw.len() - 1] == 39) {
            val = __de_slice(raw, 1, raw.len() - 1);                     // '...'
        }
        m = m.insert(key, val);
    }
    return m;
}
