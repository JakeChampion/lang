// std/test — pure-Lang unit-test runner.
//
// Designed to replace the Go-side `*_test.go` harness once the
// compiler itself is self-hosted (see
// docs/ROADMAP-AND-SELF-HOSTING.md). The runner takes no
// compiler dependency: it's an ordinary Lang program that
// uses the helpers exported here, threads a `TestRunner`
// accumulator through each test case, and exits 0 on success
// / 1 on any failure. Output is TAP-13
// (https://testanything.org/) so existing CI tooling
// (`prove`, `tape`, jUnit converters) can consume it directly
// while we transition off Go.
//
// std/test is part of the auto-prelude (see
// `internal/prelude/prelude.lang`), so test programs reach for
// the helpers by bare name — no `test.assert_eq_i32(...)`
// qualification, no `import "std/test";` line needed. A user
// program that opts out of the prelude with `import
// "core/no_prelude";` would have to import this module
// explicitly and qualify its names.
//
//   function test_addition(): Option[string] {
//       return assert_eq_i32(2 + 2, 4);
//   }
//
//   function test_strings(): Option[string] {
//       return assert_eq_string("foo" + "bar", "foobar");
//   }
//
//   function main(): i32 {
//       var r: TestRunner = test_new("arithmetic");
//       r = r.it("addition", test_addition());
//       r = r.it("strings", test_strings());
//       return r.finish();
//   }
//
// Tests are functions returning Option[string]:
//   None       — the case passed
//   Some(msg)  — the case failed; msg is the human-readable diff
//
// The runner is value-semantic — `r.it(...)` returns a fresh
// TestRunner with the result folded in. That matches the rest
// of lang's stdlib (Array.push, struct receiver methods) and
// sidesteps the lack of interior mutability.
//
// (`case` would have been the obvious method name but it's a
// reserved keyword for `switch` arms; `it` matches the BDD
// `describe / it` convention from JS / Ruby test frameworks.)
//
// Discovery is intentionally explicit: lang has no reflection,
// so `main` lists the tests it runs. That's the same shape
// Zig's `test` blocks compile down to and the same shape any
// future macro / build-step driven discovery would lower to.

// std/test reaches for (i32).to_string() in the f-string
// failure messages and (string).contains / .starts_with /
// .ends_with in the substring assertion helpers. The
// auto-prelude pulls those in for the test program too, so
// no extra `import` is needed here when std/test is included
// in the auto-prelude — but stdlib modules can't lean on
// the prelude's transitive imports, so they get declared
// explicitly.
import "std/i32";
// Wider int formatters for the i64 / u32 / u64 assertion
// families. Each module exposes a `(n).to_string()` receiver
// method dispatching through `__int_to_string_u64`.
import "std/i64";
import "std/u32";
import "std/u64";
import "std/array";
import "std/string";
// `assert_json_eq` parses both sides and walks the JsonValue
// trees in order-independent fashion (JObject keys can come
// out of `Map.keys()` in any order). Std/json is already on
// the auto-prelude path, so the dependency is just an
// in-stdlib link.
import "std/json";

// TestRunner — per-suite accumulator. Threaded through each
// `.it(name, result)` call. `failures` keeps the formatted
// "<name>: <message>" line for every failing case so finish()
// can repeat them at the bottom of the run (TAP consumers can
// look at the per-line not-ok output; humans want a summary).
//
// `skipped` mirrors `failures` for cases that bailed out before
// running their assertion — toolchain missing, OS-conditional,
// etc. They print as `ok N - name # SKIP reason` per TAP-13,
// stay counted separately from passes / fails, and don't affect
// the exit code (skipping isn't a failure).
//
// `prefix` lets nested subsuites prepend "<parent> / " to each
// case name without losing the flat TAP stream. The parent
// runner threads a child through `(r) subsuite(name)` which
// inherits the parent's counters by reference (via the
// `child = parent` value copy + a merge at the end), then
// `(parent) merge(child)` folds the child's counts back. The
// flat stream makes the output legible under any TAP consumer
// while the name prefix preserves the hierarchy.
pub struct TestRunner {
    suite: string,
    passed: i32,
    failed: i32,
    skipped: i32,
    failures: string[],
    skip_reasons: string[],
    verbose: boolean,
    prefix: string,
    base_idx: i32,
    // `cleanup_paths` is the list of paths to `remove_dir_all`
    // when `finish()` runs. Registered via
    // `(r) defer_cleanup(path)` — typically a tempdir from
    // `temp_dir(...)`. The cleanup runs even when tests fail
    // (it's the test-end behaviour, not the test-success
    // behaviour) — failures still produce the non-zero exit
    // code but the filesystem stays tidy.
    cleanup_paths: string[],
    // `filter` substrings the runner against. Empty string means
    // "run every case". Set via `test_new_filtered(...)` or
    // `parse_filter_from_args(args())` so a test program can
    // accept `lang -interp test.lang -- --filter PATTERN`
    // without hand-rolling the argv plumbing. Cases whose
    // (prefix + name) don't contain the filter substring get
    // converted to skips with reason "filtered out".
    filter: string,
}

// test_new(suite) — start a new run. `suite` labels the run in
// the TAP `# Suite:` comment line. Tests print as they execute
// so a hanging case is obvious in the output stream.
pub function test_new(suite: string): TestRunner {
    print("TAP version 13");
    print("# Suite: " + suite);
    return TestRunner {
        suite: suite,
        passed: 0,
        failed: 0,
        skipped: 0,
        failures: [],
        skip_reasons: [],
        verbose: false,
        prefix: "",
        base_idx: 0,
        cleanup_paths: [],
        filter: "",
    };
}

// test_new_filtered(suite, filter) — same as test_new but
// pre-installs a case-name filter. Cases whose
// (prefix + name) don't contain the filter substring skip
// instead of running. Use `parse_filter_from_args(args())`
// to lift the filter from a `--filter PATTERN` command-line
// flag without hand-rolling the argv plumbing.
pub function test_new_filtered(suite: string, filter: string): TestRunner {
    var r: TestRunner = test_new(suite);
    return TestRunner {
        suite: r.suite,
        passed: r.passed,
        failed: r.failed,
        skipped: r.skipped,
        failures: r.failures,
        skip_reasons: r.skip_reasons,
        verbose: r.verbose,
        prefix: r.prefix,
        base_idx: r.base_idx,
        cleanup_paths: r.cleanup_paths,
        filter: filter,
    };
}

// parse_filter_from_args(args) — scan a `args()`-style
// string array for `--filter PATTERN` or `--filter=PATTERN`
// and return the pattern. Returns "" if no flag was given,
// which matches the "no filter" sentinel `test_new_filtered`
// uses.
//
//   var r: TestRunner = test_new_filtered("my suite",
//                                         parse_filter_from_args(args()));
//
// Skip patterns that are CLI-flag-shaped beyond the basic
// `--filter` — anything fancier should reach for a real
// argv-parser module once one lands.
pub function parse_filter_from_args(argv: string[]): string {
    var i: i32 = 0;
    while (i < len(argv)) {
        var a: string = argv[i];
        if (a == "--filter" && i + 1 < len(argv)) {
            return argv[i + 1];
        }
        if (a.starts_with("--filter=")) {
            return a[9:len(a)];
        }
        i = i + 1;
    }
    return "";
}

// test_new_verbose(suite) — same as test_new but flags the
// runner for future verbose output. Currently identical to
// test_new because TAP-13 already prints every case; the flag
// is reserved for a future "--verbose" mode that adds timing
// or extra context to passing cases.
pub function test_new_verbose(suite: string): TestRunner {
    var r: TestRunner = test_new(suite);
    return TestRunner {
        suite: r.suite,
        passed: r.passed,
        failed: r.failed,
        skipped: r.skipped,
        failures: r.failures,
        skip_reasons: r.skip_reasons,
        verbose: true,
        prefix: r.prefix,
        base_idx: r.base_idx,
        cleanup_paths: r.cleanup_paths,
        filter: r.filter,
    };
}

// (r) it(name, result) — record the outcome of one test.
// `result` is the value returned by the test function:
//   None       prints "ok N - name"
//   Some(msg)  prints "not ok N - name" + the YAML-ish ---
//              block TAP uses for diagnostic detail
//
// The displayed name is `r.prefix + name`, so a subsuite's
// cases land as "parent / child / actual case" in the flat
// TAP stream. The bare `name` is what surfaces in the
// failures summary at the bottom of finish() — typically the
// prefix duplicates the suite line so the bottom summary
// stays scannable.
pub function (r: TestRunner) it(name: string, result: Option[string]): TestRunner {
    var display: string = r.prefix + name;
    // Pre-filter: skip cases whose display name doesn't match
    // the runner's filter pattern (set via `test_new_filter`).
    // Counted as skipped rather than not-printed so the TAP
    // stream stays a faithful record of the test list.
    if (len(r.filter) > 0 && !display.contains(r.filter)) {
        return r.skip(name, "filtered out (--filter=" + r.filter + ")");
    }
    var idx: i32 = r.base_idx + r.passed + r.failed + r.skipped + 1;
    match (result) {
        None => {
            print("ok " + idx.to_string() + " - " + display);
            return TestRunner {
                suite: r.suite,
                passed: r.passed + 1,
                failed: r.failed,
                skipped: r.skipped,
                failures: r.failures,
                skip_reasons: r.skip_reasons,
                verbose: r.verbose,
                prefix: r.prefix,
                base_idx: r.base_idx,
                cleanup_paths: r.cleanup_paths,
                filter: r.filter,
            };
        },
        Some(msg) => {
            print("not ok " + idx.to_string() + " - " + display);
            print("  ---");
            print("  message: " + msg);
            print("  ---");
            var fs: string[] = r.failures.push(display + ": " + msg);
            return TestRunner {
                suite: r.suite,
                passed: r.passed,
                failed: r.failed + 1,
                skipped: r.skipped,
                failures: fs,
                skip_reasons: r.skip_reasons,
                verbose: r.verbose,
                prefix: r.prefix,
                base_idx: r.base_idx,
                cleanup_paths: r.cleanup_paths,
                filter: r.filter,
            };
        }
    }
}

// (r) skip(name, reason) — record a case that didn't run.
// Emits TAP-13's `# SKIP <reason>` directive on the `ok` line
// so consumers (`prove`, `tape`, jUnit converters) can
// distinguish it from a real pass. The skipped count is
// tracked separately and doesn't influence the exit code:
// missing toolchains / OS-conditional cases shouldn't fail
// CI on dev laptops that lack the optional dep.
//
// Typical use:
//
//   if (env("WASMTIME_PATH").is_none()) {
//       r = r.skip("wasm e2e", "wasmtime not on $PATH");
//   } else {
//       r = r.it("wasm e2e", run_wasm_test());
//   }
pub function (r: TestRunner) skip(name: string, reason: string): TestRunner {
    var idx: i32 = r.base_idx + r.passed + r.failed + r.skipped + 1;
    var display: string = r.prefix + name;
    print("ok " + idx.to_string() + " - " + display + " # SKIP " + reason);
    var sr: string[] = r.skip_reasons.push(display + ": " + reason);
    return TestRunner {
        suite: r.suite,
        passed: r.passed,
        failed: r.failed,
        skipped: r.skipped + 1,
        failures: r.failures,
        skip_reasons: sr,
        verbose: r.verbose,
        prefix: r.prefix,
        base_idx: r.base_idx,
        cleanup_paths: r.cleanup_paths,
        filter: r.filter,
    };
}

// (r) skip_if(cond, name, reason, result) — conditional run.
// If `cond` is true, the case skips with `reason`; otherwise
// `result` is recorded as usual. Lets callers keep the test
// list flat without an `if`/`else` per gated case.
//
//   r = r.skip_if(env("CI").is_none(), "ci-only", "not CI", run_test());
//
// `result` is evaluated eagerly (lang has no lazy params), so
// any setup the test does runs whether or not it's skipped.
// For setup that's expensive or has side effects, branch on
// `cond` yourself and use `skip` / `it` directly.
pub function (r: TestRunner) skip_if(cond: boolean, name: string, reason: string, result: Option[string]): TestRunner {
    if (cond) { return r.skip(name, reason); }
    return r.it(name, result);
}

// (r) subsuite(name) — start a nested grouping. Returns a
// fresh TestRunner that inherits the parent's prefix and
// counts. After the subsuite's cases land via `child.it(...)`
// / `child.skip(...)`, the parent calls `parent.merge(child)`
// to fold the counters back. The child's case names print
// with the combined prefix so the flat TAP stream stays
// hierarchical:
//
//   r = r.it("standalone", run_standalone());
//   var arm = r.subsuite("arm64");
//   arm = arm.it("exit-code", run_arm64_exit());
//   arm = arm.it("stdout",    run_arm64_stdout());
//   r = r.merge(arm);
//   r = r.it("after subsuite", run_after());
//
// The child runner does NOT print a `# Suite:` line — that's
// reserved for top-level `test_new`. The prefix string is
// the only nesting signal. Two-level nesting works too
// (`arm.subsuite("regress")`) by chaining the prefixes.
pub function (r: TestRunner) subsuite(name: string): TestRunner {
    return TestRunner {
        suite: r.suite,
        passed: 0,
        failed: 0,
        skipped: 0,
        failures: [],
        skip_reasons: [],
        verbose: r.verbose,
        prefix: r.prefix + name + " / ",
        // Inherit the parent's running count so the subsuite's
        // first case prints `ok N+1` rather than restarting at
        // `ok 1`. TAP's plan line at the bottom assumes
        // monotonic case numbering across the whole stream.
        base_idx: r.base_idx + r.passed + r.failed + r.skipped,
        // Cleanup hooks registered on the child get returned
        // to the parent via `merge` so finish() always runs
        // them. Empty here — the child accumulates its own as
        // tests register them.
        cleanup_paths: [],
        // The child inherits the parent's filter so a
        // `--filter PATTERN` applied at the top level applies
        // to every nested case too.
        filter: r.filter,
    };
}

// (r) merge(child) — fold a subsuite's counters and failure
// notes back into the parent. The child's `passed / failed /
// skipped` get added; its `failures` / `skip_reasons` get
// concatenated. The parent's prefix and verbose flag are
// preserved.
pub function (r: TestRunner) merge(child: TestRunner): TestRunner {
    var fs: string[] = r.failures;
    var i: i32 = 0;
    while (i < len(child.failures)) {
        fs = fs.push(child.failures[i]);
        i = i + 1;
    }
    var sr: string[] = r.skip_reasons;
    i = 0;
    while (i < len(child.skip_reasons)) {
        sr = sr.push(child.skip_reasons[i]);
        i = i + 1;
    }
    var cl: string[] = r.cleanup_paths;
    i = 0;
    while (i < len(child.cleanup_paths)) {
        cl = cl.push(child.cleanup_paths[i]);
        i = i + 1;
    }
    return TestRunner {
        suite: r.suite,
        passed: r.passed + child.passed,
        failed: r.failed + child.failed,
        skipped: r.skipped + child.skipped,
        failures: fs,
        skip_reasons: sr,
        verbose: r.verbose,
        prefix: r.prefix,
        base_idx: r.base_idx,
        cleanup_paths: cl,
        filter: r.filter,
    };
}

// (r) defer_cleanup(path) — register a filesystem path that
// should be removed when `finish()` runs, regardless of test
// outcome. Designed for the `temp_dir(...)` pattern: a test
// creates a fresh directory, registers it for cleanup
// immediately, then writes fixtures + spawns subprocesses
// against it.
//
//   var dir: string = expect_ok(temp_dir("foo"));
//   r = r.defer_cleanup(dir);
//
// Each registered path goes through `remove_dir_all` at
// finish() time. Errors from cleanup are recorded as test
// failures (so a bug that leaves the tmpfs unwritable
// surfaces in CI), but they don't replace the test exit
// code's "real" cause — fast-failing on a cleanup error
// would hide the actual test failure.
pub function (r: TestRunner) defer_cleanup(path: string): TestRunner {
    var cl: string[] = r.cleanup_paths.push(path);
    return TestRunner {
        suite: r.suite,
        passed: r.passed,
        failed: r.failed,
        skipped: r.skipped,
        failures: r.failures,
        skip_reasons: r.skip_reasons,
        verbose: r.verbose,
        prefix: r.prefix,
        base_idx: r.base_idx,
        cleanup_paths: cl,
        filter: r.filter,
    };
}

// (r) log(msg) — emit a TAP comment (`# msg`) without
// recording a test outcome. Useful for debug breadcrumbs in
// long-running suites — TAP consumers ignore unknown comment
// lines, humans grep for them. Returns the runner unchanged
// so the call chains cleanly between `.it(...)` records:
//
//   r = r.log("about to spawn child");
//   r = r.it("spawned", spawn_test());
//
// Newlines in `msg` get printed verbatim — multiple TAP
// comment lines if `msg` contains `\n`. Lang's `print`
// already handles the trailing newline.
pub function (r: TestRunner) log(msg: string): TestRunner {
    print("# " + msg);
    return r;
}

// (r) finish() — print the TAP plan line + per-suite summary
// and return the process exit code (0 = all passed, 1 = any
// failed). Call this exactly once at the end of main().
//
// TAP plan goes at the bottom of the output (the "lazy plan"
// shape) because the test count isn't known up-front — we'd
// have to count cases in main() before running them, which
// every test file would have to remember to keep in sync.
// Bottom-plan is permitted by TAP-13 and most consumers
// (`prove`, `tape`) handle it.
pub function (r: TestRunner) finish(): i32 {
    var total: i32 = r.passed + r.failed + r.skipped;
    print("1.." + total.to_string());
    print("# tests " + total.to_string());
    print("# pass " + r.passed.to_string());
    print("# fail " + r.failed.to_string());
    if (r.skipped > 0) {
        print("# skip " + r.skipped.to_string());
    }
    if (r.skipped > 0) {
        print("# skipped:");
        var j: i32 = 0;
        while (j < len(r.skip_reasons)) {
            print("#   " + r.skip_reasons[j]);
            j = j + 1;
        }
    }
    // Run deferred cleanup hooks. Errors print as comments so
    // a tmpfs that's gone read-only on us doesn't get
    // silently swallowed, but they don't override the "real"
    // test result. The exit code below still reflects whether
    // the test assertions themselves passed.
    var k: i32 = 0;
    var cleanup_errored: boolean = false;
    while (k < len(r.cleanup_paths)) {
        var p: string = r.cleanup_paths[k];
        match (remove_dir_all(p)) {
            None => { },
            Some(_) => {
                print("# cleanup failed for " + p);
                cleanup_errored = true;
            },
        }
        k = k + 1;
    }
    if (r.failed > 0) {
        print("# failures:");
        var i: i32 = 0;
        while (i < len(r.failures)) {
            print("#   " + r.failures[i]);
            i = i + 1;
        }
        return 1;
    }
    if (cleanup_errored) {
        // No test failed but cleanup did — surface as exit
        // code 2 so CI can tell the difference between "tests
        // ran clean" (0), "tests failed" (1), and
        // "tests passed but cleanup leaked" (2).
        return 2;
    }
    return 0;
}

// =================== ASSERTION HELPERS ===================
//
// Each helper returns Option[string]:
//   None       — the assertion holds
//   Some(msg)  — the assertion failed; msg describes the diff
//
// Message format: "<predicate>: <detail>" — predicate names the
// assertion so the failure log is grep-able, detail carries the
// actual / expected values formatted for human reading.
//
// Helpers are split per-type because lang doesn't have a way to
// express "any printable value" in a generic signature today.
// As soon as a `Display`/`ToString` trait lands, these collapse
// into one generic helper per family (eq, neq, contains, ...).

// `pass()` — explicit None for cases that need an early
// successful return (eg a test that walks a list and bails
// out on the first interesting state).
pub function pass(): Option[string] {
    return None;
}

// `fail(msg)` — explicit failure with a custom message. Useful
// when a test computes its own diff or wants to flag an
// unreachable branch ("expected match to have hit the first arm").
pub function fail(msg: string): Option[string] {
    return Some(msg);
}

// `assert_true(cond)` / `assert_false(cond)` — boolean
// predicates. The failure message names which direction failed
// so a glance at the log makes it obvious.
pub function assert_true(cond: boolean): Option[string] {
    if (cond) { return None; }
    return Some("assert_true: condition was false");
}

pub function assert_false(cond: boolean): Option[string] {
    if (!cond) { return None; }
    return Some("assert_false: condition was true");
}

// `assert_eq_i32(actual, expected)` — i32 equality. Failure
// message embeds both values so you don't have to re-run the
// test to see what came out.
pub function assert_eq_i32(actual: i32, expected: i32): Option[string] {
    if (actual == expected) { return None; }
    return Some("assert_eq_i32: expected " + expected.to_string() +
                ", got " + actual.to_string());
}

pub function assert_neq_i32(actual: i32, expected: i32): Option[string] {
    if (actual != expected) { return None; }
    return Some("assert_neq_i32: expected != " + expected.to_string() +
                ", got " + actual.to_string());
}

// `assert_lt_i32(a, b)` / `assert_le_i32(a, b)` — relational
// predicates. Mirror the eq/neq shape so a test that checks
// "monotonically increasing" doesn't have to roll its own
// failure message every time.
pub function assert_lt_i32(a: i32, b: i32): Option[string] {
    if (a < b) { return None; }
    return Some("assert_lt_i32: expected " + a.to_string() + " < " + b.to_string());
}

pub function assert_le_i32(a: i32, b: i32): Option[string] {
    if (a <= b) { return None; }
    return Some("assert_le_i32: expected " + a.to_string() + " <= " + b.to_string());
}

pub function assert_gt_i32(a: i32, b: i32): Option[string] {
    if (a > b) { return None; }
    return Some("assert_gt_i32: expected " + a.to_string() + " > " + b.to_string());
}

pub function assert_ge_i32(a: i32, b: i32): Option[string] {
    if (a >= b) { return None; }
    return Some("assert_ge_i32: expected " + a.to_string() + " >= " + b.to_string());
}

// i64 / u32 / u64 equality assertions. Same shape as the i32
// family, split per width because lang doesn't have a numeric
// width-polymorphic generic at the function-signature level
// today. A future `Eq` trait would collapse the entire family
// to one helper per direction (eq / neq / lt / le / ...).

pub function assert_eq_i64(actual: i64, expected: i64): Option[string] {
    if (actual == expected) { return None; }
    return Some("assert_eq_i64: expected " + expected.to_string() +
                ", got " + actual.to_string());
}

pub function assert_neq_i64(actual: i64, expected: i64): Option[string] {
    if (actual != expected) { return None; }
    return Some("assert_neq_i64: expected != " + expected.to_string() +
                ", got " + actual.to_string());
}

pub function assert_eq_u32(actual: u32, expected: u32): Option[string] {
    if (actual == expected) { return None; }
    return Some("assert_eq_u32: expected " + expected.to_string() +
                ", got " + actual.to_string());
}

pub function assert_neq_u32(actual: u32, expected: u32): Option[string] {
    if (actual != expected) { return None; }
    return Some("assert_neq_u32: expected != " + expected.to_string() +
                ", got " + actual.to_string());
}

pub function assert_eq_u64(actual: u64, expected: u64): Option[string] {
    if (actual == expected) { return None; }
    return Some("assert_eq_u64: expected " + expected.to_string() +
                ", got " + actual.to_string());
}

pub function assert_neq_u64(actual: u64, expected: u64): Option[string] {
    if (actual != expected) { return None; }
    return Some("assert_neq_u64: expected != " + expected.to_string() +
                ", got " + actual.to_string());
}

// i64 / u32 / u64 relational assertions mirror the i32 family
// (`assert_lt_i32` / `_le_i32` / `_gt_i32` / `_ge_i32`). The
// migration's monotonic-counter / capacity-bound checks need
// these on every numeric width — and writing them out
// per-width is friendlier than burying the width in a runtime
// tag arg, especially since the failure messages name the
// width so a grep across CI logs surfaces the right helper.

pub function assert_lt_i64(a: i64, b: i64): Option[string] {
    if (a < b) { return None; }
    return Some("assert_lt_i64: expected " + a.to_string() + " < " + b.to_string());
}

pub function assert_le_i64(a: i64, b: i64): Option[string] {
    if (a <= b) { return None; }
    return Some("assert_le_i64: expected " + a.to_string() + " <= " + b.to_string());
}

pub function assert_gt_i64(a: i64, b: i64): Option[string] {
    if (a > b) { return None; }
    return Some("assert_gt_i64: expected " + a.to_string() + " > " + b.to_string());
}

pub function assert_ge_i64(a: i64, b: i64): Option[string] {
    if (a >= b) { return None; }
    return Some("assert_ge_i64: expected " + a.to_string() + " >= " + b.to_string());
}

pub function assert_lt_u32(a: u32, b: u32): Option[string] {
    if (a < b) { return None; }
    return Some("assert_lt_u32: expected " + a.to_string() + " < " + b.to_string());
}

pub function assert_le_u32(a: u32, b: u32): Option[string] {
    if (a <= b) { return None; }
    return Some("assert_le_u32: expected " + a.to_string() + " <= " + b.to_string());
}

pub function assert_gt_u32(a: u32, b: u32): Option[string] {
    if (a > b) { return None; }
    return Some("assert_gt_u32: expected " + a.to_string() + " > " + b.to_string());
}

pub function assert_ge_u32(a: u32, b: u32): Option[string] {
    if (a >= b) { return None; }
    return Some("assert_ge_u32: expected " + a.to_string() + " >= " + b.to_string());
}

pub function assert_lt_u64(a: u64, b: u64): Option[string] {
    if (a < b) { return None; }
    return Some("assert_lt_u64: expected " + a.to_string() + " < " + b.to_string());
}

pub function assert_le_u64(a: u64, b: u64): Option[string] {
    if (a <= b) { return None; }
    return Some("assert_le_u64: expected " + a.to_string() + " <= " + b.to_string());
}

pub function assert_gt_u64(a: u64, b: u64): Option[string] {
    if (a > b) { return None; }
    return Some("assert_gt_u64: expected " + a.to_string() + " > " + b.to_string());
}

pub function assert_ge_u64(a: u64, b: u64): Option[string] {
    if (a >= b) { return None; }
    return Some("assert_ge_u64: expected " + a.to_string() + " >= " + b.to_string());
}

// Float equality with a tolerance, plus exact equality for
// callers that want it. Naive `actual == expected` on floats
// is almost never what you want — every textbook says use an
// epsilon. `assert_eq_f32_near` / `_f64_near` make that the
// default; `assert_eq_f32_exact` is the escape hatch for
// canonicalisation tests (NaN bit patterns, f32_bits round-
// trips) where you genuinely want bitwise equality.

// `assert_eq_f64_near(actual, expected, epsilon)` — passes if
// `|actual - expected| <= epsilon`. NaN inputs always fail
// (NaN != anything, including itself); the message names
// "NaN" so the failure is obvious. The helper returns None
// for ±Inf-matching-±Inf, since float subtraction would
// yield NaN there.
pub function assert_eq_f64_near(actual: f64, expected: f64, epsilon: f64): Option[string] {
    // NaN guard: both `actual != actual` and `expected !=
    // expected` indicate NaN. Bail before subtraction so the
    // failure message can name the offender clearly.
    if (actual != actual) {
        return Some("assert_eq_f64_near: actual is NaN");
    }
    if (expected != expected) {
        return Some("assert_eq_f64_near: expected is NaN");
    }
    // ±Inf match-pass: subtraction would yield NaN.
    if (actual == expected) { return None; }
    var diff: f64 = actual - expected;
    if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff <= epsilon) { return None; }
    return Some("assert_eq_f64_near: |" + actual.to_string() +
                " - " + expected.to_string() + "| = " + diff.to_string() +
                " > epsilon " + epsilon.to_string());
}

// `assert_eq_f32_near(actual, expected, epsilon)` — f32
// version of the same idea. Widens both sides to f64 for the
// difference calc to avoid the precision-loss artifact where
// `(small_f32 - small_other_f32)` underflows to zero in f32
// arithmetic but the values were genuinely different.
pub function assert_eq_f32_near(actual: f32, expected: f32, epsilon: f32): Option[string] {
    return assert_eq_f64_near(actual as f64, expected as f64, epsilon as f64);
}

// `assert_eq_f64_exact(actual, expected)` — bitwise-equal
// floats. Use for f32_bits round-trip tests / canonical-NaN
// checks where epsilons would smuggle bugs through. Most
// other callers want `_near`.
pub function assert_eq_f64_exact(actual: f64, expected: f64): Option[string] {
    if (actual == expected) { return None; }
    // Distinguish NaN failures from value mismatches in the
    // message — NaN never compares equal to anything, so a
    // plain "expected vs actual" diff looks misleading.
    if (actual != actual || expected != expected) {
        return Some("assert_eq_f64_exact: NaN involved (actual=" +
                    actual.to_string() + ", expected=" + expected.to_string() + ")");
    }
    return Some("assert_eq_f64_exact: expected " + expected.to_string() +
                ", got " + actual.to_string());
}

// `assert_is_nan_f64(v)` — explicit NaN check. `v != v` is
// the textbook NaN predicate (the only float that doesn't
// compare equal to itself). Helper exists because writing
// `v != v` in a test reads like a typo.
pub function assert_is_nan_f64(v: f64): Option[string] {
    if (v != v) { return None; }
    return Some("assert_is_nan_f64: expected NaN, got " + v.to_string());
}

pub function assert_is_nan_f32(v: f32): Option[string] {
    if (v != v) { return None; }
    return Some("assert_is_nan_f32: expected NaN, got " + v.to_string());
}

// `assert_eq_bool(actual, expected)` — boolean equality. Less
// common than assert_true/false but useful for tests that
// compute a boolean and want to compare it against an expected
// value driven from a table.
pub function assert_eq_bool(actual: boolean, expected: boolean): Option[string] {
    if (actual == expected) { return None; }
    var a: string = "false";
    if (actual) { a = "true"; }
    var e: string = "false";
    if (expected) { e = "true"; }
    return Some("assert_eq_bool: expected " + e + ", got " + a);
}

// `assert_eq_string(actual, expected)` — string equality. The
// raw values are quoted in the message so leading / trailing
// whitespace stays visible.
pub function assert_eq_string(actual: string, expected: string): Option[string] {
    if (actual == expected) { return None; }
    return Some("assert_eq_string: expected \"" + expected + "\", got \"" + actual + "\"");
}

pub function assert_neq_string(actual: string, expected: string): Option[string] {
    if (actual != expected) { return None; }
    return Some("assert_neq_string: expected != \"" + expected + "\", got \"" + actual + "\"");
}

// `assert_contains(haystack, needle)` — substring search.
// Empty needle always passes (mirrors `(s).contains("")` which
// returns true everywhere). Failure embeds the haystack so the
// diff against your fixture is one glance.
pub function assert_contains(haystack: string, needle: string): Option[string] {
    if (haystack.contains(needle)) { return None; }
    return Some("assert_contains: \"" + haystack + "\" does not contain \"" + needle + "\"");
}

// `assert_not_contains(haystack, needle)` — the inverse. Empty
// needle always fails because every string contains the empty
// string.
pub function assert_not_contains(haystack: string, needle: string): Option[string] {
    if (!haystack.contains(needle)) { return None; }
    return Some("assert_not_contains: \"" + haystack + "\" contains \"" + needle + "\"");
}

pub function assert_starts_with(s: string, prefix: string): Option[string] {
    if (s.starts_with(prefix)) { return None; }
    return Some("assert_starts_with: \"" + s + "\" does not start with \"" + prefix + "\"");
}

pub function assert_ends_with(s: string, suffix: string): Option[string] {
    if (s.ends_with(suffix)) { return None; }
    return Some("assert_ends_with: \"" + s + "\" does not end with \"" + suffix + "\"");
}

// `assert_empty_string(s)` — sugar for assert_eq_i32(len(s), 0)
// that names the assertion in the failure message.
pub function assert_empty_string(s: string): Option[string] {
    if (len(s) == 0) { return None; }
    return Some("assert_empty_string: expected \"\", got \"" + s + "\"");
}

pub function assert_non_empty_string(s: string): Option[string] {
    if (len(s) > 0) { return None; }
    return Some("assert_non_empty_string: string was empty");
}

// `assert_len_i32(arr, n)` / `assert_len_string(arr, n)` —
// array length checks. Split per element type because lang
// doesn't have a `T[]` generic at the function-signature
// level for the call sites we currently want.
pub function assert_len_i32(arr: i32[], n: i32): Option[string] {
    var got: i32 = len(arr);
    if (got == n) { return None; }
    return Some("assert_len_i32: expected length " + n.to_string() +
                ", got " + got.to_string());
}

pub function assert_len_string(arr: string[], n: i32): Option[string] {
    var got: i32 = len(arr);
    if (got == n) { return None; }
    return Some("assert_len_string: expected length " + n.to_string() +
                ", got " + got.to_string());
}

// `assert_eq_i32_array(actual, expected)` — element-wise i32[]
// equality. Returns the first mismatching index so the failure
// localises a long array diff.
pub function assert_eq_i32_array(actual: i32[], expected: i32[]): Option[string] {
    var an: i32 = len(actual);
    var en: i32 = len(expected);
    if (an != en) {
        return Some("assert_eq_i32_array: length differs - expected " +
                    en.to_string() + ", got " + an.to_string());
    }
    var i: i32 = 0;
    while (i < an) {
        if (actual[i] != expected[i]) {
            return Some("assert_eq_i32_array: at index " + i.to_string() +
                        " expected " + expected[i].to_string() +
                        ", got " + actual[i].to_string());
        }
        i = i + 1;
    }
    return None;
}

pub function assert_eq_string_array(actual: string[], expected: string[]): Option[string] {
    var an: i32 = len(actual);
    var en: i32 = len(expected);
    if (an != en) {
        return Some("assert_eq_string_array: length differs - expected " +
                    en.to_string() + ", got " + an.to_string());
    }
    var i: i32 = 0;
    while (i < an) {
        if (actual[i] != expected[i]) {
            return Some("assert_eq_string_array: at index " + i.to_string() +
                        " expected \"" + expected[i] + "\", got \"" + actual[i] + "\"");
        }
        i = i + 1;
    }
    return None;
}

// =================== PROCESS ASSERTIONS ===================
//
// The migrated e2e suite spawns the compiler binary under test
// and asserts on a (stdout, stderr, exit_code) triple. The
// `exec(cmd, args, stdin)` builtin returns a ProcessResult
// struct; these helpers turn the most common assertions into
// one-liners that fold cleanly into the runner's
// Option[string] result shape.

// assert_exit(actual: ProcessResult, expected: i32) — verify
// the spawned process exited with the given code. Failure
// message embeds stdout + stderr (truncated to keep CI logs
// readable) so the diff against your fixture is one glance.
pub function assert_exit(actual: ProcessResult, expected: i32): Option[string] {
    if (actual.exit_code == expected) { return None; }
    var tail: string = "";
    if (len(actual.stdout) > 0) {
        tail = tail + "\n  stdout: " + actual.stdout;
    }
    if (len(actual.stderr) > 0) {
        tail = tail + "\n  stderr: " + actual.stderr;
    }
    return Some("assert_exit: expected " + expected.to_string() +
                ", got " + actual.exit_code.to_string() + tail);
}

// assert_stdout_eq / assert_stderr_eq — exact-byte match
// against the captured stream. Whitespace counts; trim the
// inputs before calling if you want to ignore trailing
// newlines.
pub function assert_stdout_eq(actual: ProcessResult, expected: string): Option[string] {
    if (actual.stdout == expected) { return None; }
    return Some("assert_stdout_eq: expected \"" + expected +
                "\", got \"" + actual.stdout + "\"");
}

pub function assert_stderr_eq(actual: ProcessResult, expected: string): Option[string] {
    if (actual.stderr == expected) { return None; }
    return Some("assert_stderr_eq: expected \"" + expected +
                "\", got \"" + actual.stderr + "\"");
}

// assert_stdout_contains / assert_stderr_contains — substring
// search. The expected-substring search is way friendlier
// than exact equality for diagnostic output (where the wording
// changes more often than the substantive content).
pub function assert_stdout_contains(actual: ProcessResult, needle: string): Option[string] {
    if (actual.stdout.contains(needle)) { return None; }
    return Some("assert_stdout_contains: stdout does not contain \"" +
                needle + "\"\n  stdout: " + actual.stdout);
}

pub function assert_stderr_contains(actual: ProcessResult, needle: string): Option[string] {
    if (actual.stderr.contains(needle)) { return None; }
    return Some("assert_stderr_contains: stderr does not contain \"" +
                needle + "\"\n  stderr: " + actual.stderr);
}

// assert_process(actual, exit, stdout_substr) — fold the
// common "exit + stdout-contains" triple into one helper so
// the typical e2e shape stays a one-liner. `stdout_substr`
// is treated as a substring search (the most-used direction);
// callers wanting exact match should use
// assert_stdout_eq separately.
pub function assert_process(actual: ProcessResult, expected_exit: i32, stdout_substr: string): Option[string] {
    if (actual.exit_code != expected_exit) {
        return assert_exit(actual, expected_exit);
    }
    if (len(stdout_substr) > 0 && !actual.stdout.contains(stdout_substr)) {
        return Some("assert_process: exit " + expected_exit.to_string() +
                    " ok, but stdout missing \"" + stdout_substr +
                    "\"\n  stdout: " + actual.stdout);
    }
    return None;
}

// =================== MULTI-SUBSTRING ASSERTIONS ===================
//
// Diagnostic-message tests typically want to check that a
// compiler error mentions several relevant tokens — the offending
// identifier, a "did you mean" hint, the source position. Doing
// that with `assert_contains` per substring inflates the case
// count and obscures the actual contract; these collapse the
// check to one assertion with a substring vector.

// `assert_contains_all(haystack, needles)` — every entry in
// `needles` must appear somewhere in `haystack` (order is NOT
// required; if order matters, use a sequence of substring
// `index_of` checks). Empty needles list always passes.
pub function assert_contains_all(haystack: string, needles: string[]): Option[string] {
    var i: i32 = 0;
    while (i < len(needles)) {
        if (!haystack.contains(needles[i])) {
            return Some("assert_contains_all: missing \"" + needles[i] +
                        "\" in:\n  " + haystack);
        }
        i = i + 1;
    }
    return None;
}

// `assert_contains_any(haystack, needles)` — at least one entry
// in `needles` must appear. Useful for "the diagnostic mentions
// EITHER X or Y" cases where the exact wording is incidental.
// Empty needles list always fails (vacuously: nothing to match).
pub function assert_contains_any(haystack: string, needles: string[]): Option[string] {
    if (len(needles) == 0) {
        return Some("assert_contains_any: empty needles list");
    }
    var i: i32 = 0;
    while (i < len(needles)) {
        if (haystack.contains(needles[i])) {
            return None;
        }
        i = i + 1;
    }
    return Some("assert_contains_any: none of " + i.to_string() +
                " needles matched in:\n  " + haystack);
}

// `assert_contains_in_order(haystack, needles)` — every needle
// must appear AND the matches must be in the order given.
// Useful for asserting on a structured diagnostic ("expected
// X at line N, got Y") where the file/line/expected/actual
// sequence is contractual.
pub function assert_contains_in_order(haystack: string, needles: string[]): Option[string] {
    var cursor: i32 = 0;
    var i: i32 = 0;
    while (i < len(needles)) {
        var rest: string = haystack[cursor:len(haystack)];
        var idx: i32 = rest.index_of(needles[i]);
        if (idx < 0) {
            return Some("assert_contains_in_order: \"" + needles[i] +
                        "\" not found after byte " + cursor.to_string() +
                        " in:\n  " + haystack);
        }
        cursor = cursor + idx + len(needles[i]);
        i = i + 1;
    }
    return None;
}

// =================== STRING DIFF ===================
//
// `assert_eq_string` works fine on short values but produces
// unreadable failure messages on multi-line strings — the
// expected/actual blocks blur together and the eye can't find
// the first mismatch. `assert_eq_string_diff` walks both sides
// line-by-line and reports the first differing line with its
// line number + surrounding context.

// `__diff_lines(a, b)` — return the 1-based line number where
// `a` and `b` first differ, or 0 if they match. Counts a length
// difference past end-of-shorter as a difference at the
// shorter's last+1 line.
function __diff_lines(a: string, b: string): i32 {
    var a_lines: string[] = a.lines();
    var b_lines: string[] = b.lines();
    var n: i32 = len(a_lines);
    if (len(b_lines) < n) { n = len(b_lines); }
    var i: i32 = 0;
    while (i < n) {
        if (a_lines[i] != b_lines[i]) { return i + 1; }
        i = i + 1;
    }
    if (len(a_lines) != len(b_lines)) { return n + 1; }
    return 0;
}

// `assert_eq_string_diff(actual, expected)` — exact equality but
// the failure message reports the first differing line + its
// line number + the values on each side. The diff is friendlier
// than the plain `assert_eq_string` shape for multi-line stdout
// or generated source.
pub function assert_eq_string_diff(actual: string, expected: string): Option[string] {
    if (actual == expected) { return None; }
    var line_no: i32 = __diff_lines(expected, actual);
    var a_lines: string[] = actual.lines();
    var e_lines: string[] = expected.lines();
    var actual_line: string = "<past end>";
    var expected_line: string = "<past end>";
    var ix: i32 = line_no - 1;
    if (ix >= 0 && ix < len(a_lines)) { actual_line = a_lines[ix]; }
    if (ix >= 0 && ix < len(e_lines)) { expected_line = e_lines[ix]; }
    return Some("assert_eq_string_diff: differ at line " + line_no.to_string() +
                "\n  expected: " + expected_line +
                "\n  actual:   " + actual_line);
}

// `assert_lines_eq(actual, expected_lines)` — split `actual`
// on `\n` and compare line-by-line against `expected_lines`.
// The expected side is an explicit string[], which reads
// better in tests than wrapping the expected output in one
// long backslash-escaped literal. Failure message names the
// first differing line + its 1-based index + both values,
// same shape as `assert_eq_string_diff`.
pub function assert_lines_eq(actual: string, expected_lines: string[]): Option[string] {
    var a_lines: string[] = actual.lines();
    var an: i32 = len(a_lines);
    var en: i32 = len(expected_lines);
    if (an != en) {
        return Some("assert_lines_eq: line count differs - expected " +
                    en.to_string() + ", got " + an.to_string());
    }
    var i: i32 = 0;
    while (i < an) {
        if (a_lines[i] != expected_lines[i]) {
            return Some("assert_lines_eq: differ at line " + (i + 1).to_string() +
                        "\n  expected: " + expected_lines[i] +
                        "\n  actual:   " + a_lines[i]);
        }
        i = i + 1;
    }
    return None;
}

// =================== NUMERIC RANGE ASSERTIONS ===================
//
// Common in property tests: "the result must land between two
// inclusive bounds". Equivalent to `assert_ge_i32(v, lo) +
// assert_le_i32(v, hi)` but in one line, with a failure message
// that names the violated side.

// `assert_in_range_i32(v, lo, hi)` — `lo <= v <= hi`.
pub function assert_in_range_i32(v: i32, lo: i32, hi: i32): Option[string] {
    if (v < lo) {
        return Some("assert_in_range_i32: " + v.to_string() +
                    " < lower bound " + lo.to_string());
    }
    if (v > hi) {
        return Some("assert_in_range_i32: " + v.to_string() +
                    " > upper bound " + hi.to_string());
    }
    return None;
}

// `assert_in_range_i64(v, lo, hi)` — same for wider ints.
pub function assert_in_range_i64(v: i64, lo: i64, hi: i64): Option[string] {
    if (v < lo) {
        return Some("assert_in_range_i64: " + v.to_string() +
                    " < lower bound " + lo.to_string());
    }
    if (v > hi) {
        return Some("assert_in_range_i64: " + v.to_string() +
                    " > upper bound " + hi.to_string());
    }
    return None;
}

// =================== FILESYSTEM ASSERTIONS ===================
//
// File-state assertions for tests that build a fixture tree
// then verify a subprocess produced the expected output files.
// Layered on `read_file` / `read_dir` so they work under
// `lang -interp`. Names are deliberately verbose
// (`assert_file_exists` rather than `file_exists`) to keep them
// clearly distinguishable from `read_file` itself in user code.

// `assert_file_exists(path)` — the path must be a readable
// file. The check goes through `read_file`, so a path that
// exists but isn't readable surfaces as a failure too.
pub function assert_file_exists(path: string): Option[string] {
    match (read_file(path)) {
        Ok(_) => { return None; },
        Err(_) => {
            return Some("assert_file_exists: \"" + path + "\" does not exist or is unreadable");
        }
    }
    return None;
}

// `assert_file_not_exists(path)` — the path must NOT resolve
// to a readable file. Useful for asserting that a cleanup
// actually scrubbed something.
pub function assert_file_not_exists(path: string): Option[string] {
    match (read_file(path)) {
        Ok(_) => {
            return Some("assert_file_not_exists: \"" + path + "\" still exists");
        },
        Err(_) => { return None; }
    }
    return None;
}

// `assert_file_contents(path, expected)` — read the file and
// compare its full contents (byte-exact) to `expected`. Routes
// the long-string diff through `assert_eq_string_diff` so the
// failure message localises the first differing line.
pub function assert_file_contents(path: string, expected: string): Option[string] {
    match (read_file(path)) {
        Ok(actual) => { return assert_eq_string_diff(actual, expected); },
        Err(_) => {
            return Some("assert_file_contents: failed to read \"" + path + "\"");
        }
    }
    return None;
}

// `assert_is_file(path)` / `assert_is_dir(path)` —
// `stat`-backed type predicates. `assert_file_exists` (above)
// goes through `read_file` which succeeds for regular files;
// these are the explicit pair for callers that need to
// distinguish files from directories without inspecting the
// raw FileStat themselves.
pub function assert_is_file(path: string): Option[string] {
    match (stat(path)) {
        Ok(s) => {
            if (s.is_file) { return None; }
            if (s.is_dir) {
                return Some("assert_is_file: \"" + path + "\" is a directory");
            }
            return Some("assert_is_file: \"" + path + "\" is not a regular file");
        },
        Err(_) => {
            return Some("assert_is_file: \"" + path + "\" does not exist");
        }
    }
    return None;
}

pub function assert_is_dir(path: string): Option[string] {
    match (stat(path)) {
        Ok(s) => {
            if (s.is_dir) { return None; }
            if (s.is_file) {
                return Some("assert_is_dir: \"" + path + "\" is a regular file");
            }
            return Some("assert_is_dir: \"" + path + "\" is not a directory");
        },
        Err(_) => {
            return Some("assert_is_dir: \"" + path + "\" does not exist");
        }
    }
    return None;
}

// `assert_file_size(path, expected)` — match the file's byte
// size against an i64 expectation. Useful for fixture tests
// that copy / generate files of a known size.
pub function assert_file_size(path: string, expected: i64): Option[string] {
    match (stat(path)) {
        Ok(s) => {
            if (s.size == expected) { return None; }
            return Some("assert_file_size: \"" + path + "\" is " +
                        s.size.to_string() + " bytes, expected " + expected.to_string());
        },
        Err(_) => {
            return Some("assert_file_size: \"" + path + "\" does not exist");
        }
    }
    return None;
}

// `assert_file_contains(path, needle)` — file contents include
// the given substring. Faster than `assert_file_contents` when
// the test only cares that the output mentions something
// specific, not that it matches a full golden.
pub function assert_file_contains(path: string, needle: string): Option[string] {
    match (read_file(path)) {
        Ok(actual) => {
            if (actual.contains(needle)) { return None; }
            return Some("assert_file_contains: \"" + path +
                        "\" does not contain \"" + needle +
                        "\"\n  contents: " + actual);
        },
        Err(_) => {
            return Some("assert_file_contains: failed to read \"" + path + "\"");
        }
    }
    return None;
}

// =================== TEMPDIR CONVENIENCE ===================
//
// `must_temp_dir(r, prefix)` — single-shot tempdir + cleanup
// registration. Returns the path (empty string on failure) and
// a runner with the cleanup hook already wired. Callers that
// expect tempdir creation to always succeed (the typical
// case — `/tmp` is writable on every supported platform) can
// skip the match boilerplate.
//
//   var dir: string = "";
//   var rr: TestRunner = r;
//   match (must_temp_dir(rr, "my-fixture")) {
//       (p, nr) => { dir = p; rr = nr; }
//   }
//
// Returns a 2-tuple `(path, runner)`. When tempdir creation
// fails the runner gets a `skip` recorded and the path is
// empty — callers should check `dir != ""` before using it.
pub function must_temp_dir(r: TestRunner, prefix: string): (string, TestRunner) {
    match (temp_dir(prefix)) {
        Ok(dir) => {
            return (dir, r.defer_cleanup(dir));
        },
        Err(_) => {
            return ("", r.skip("temp_dir " + prefix, "tempdir creation failed"));
        }
    }
    return ("", r);
}

// =================== BENCHMARKS ===================
//
// `(r) bench(name, iterations, fn)` runs `fn` `iterations`
// times, measures each elapsed time via `monotonic_ns()`, and
// emits a TAP comment line with min / median / mean / max in
// microseconds. The case always passes — benchmarks aren't
// pass/fail by default; reach for `bench_max_us` when you
// want a regression bound.
//
// `fn` must be a 0-arg `() => void` closure. Pass a free
// function (`my_workload`) or a tiny shim that drives the
// real workload. Iteration count of 10-100 is typical;
// each iteration runs the whole `fn` body once.

// __bench_sort_us — Sort the elapsed-time samples ascending
// so percentile lookups are straightforward. Selection sort
// because lang's `+` doesn't concatenate non-string arrays
// (the insertion-sort version would have used array
// concatenation to splice the key); selection sort builds
// each step by `push`, which DOES work on every element
// type. O(n²) either way; sample counts stay under ~100 so
// the absolute cost is negligible.
function __bench_sort_us(samples: i64[]): i64[] {
    var n: i32 = len(samples);
    // Track which indices have been consumed via a parallel
    // boolean array — easier than mutating `samples` in place
    // (lang has no in-place array set today).
    var taken: boolean[] = [];
    var i: i32 = 0;
    while (i < n) { taken = taken.push(false); i = i + 1; }
    var out: i64[] = [];
    i = 0;
    while (i < n) {
        // Find the smallest still-available value.
        var best: i32 = 0 - 1;
        var j: i32 = 0;
        while (j < n) {
            if (!taken[j]) {
                if (best < 0 || samples[j] < samples[best]) { best = j; }
            }
            j = j + 1;
        }
        out = out.push(samples[best]);
        taken = taken.push(true);   // append to keep length aligned ...
        // ... then re-flag the chosen index. Lang has no
        // in-place set; rebuild `taken` with the slot
        // updated.
        var t2: boolean[] = [];
        var k: i32 = 0;
        while (k < n) {
            if (k == best) { t2 = t2.push(true); }
            else { t2 = t2.push(taken[k]); }
            k = k + 1;
        }
        taken = t2;
        i = i + 1;
    }
    return out;
}

// `(r) bench(name, iterations, fn)` — run `fn` repeatedly,
// emit a TAP comment with the per-iteration timing summary.
// Always passes; use `bench_max_us` for a regression bound.
pub function (r: TestRunner) bench(name: string, iterations: i32, fn: () => void): TestRunner {
    if (iterations <= 0) {
        return r.it(name, fail("bench: iterations must be > 0"));
    }
    var samples: i64[] = [];
    var i: i32 = 0;
    while (i < iterations) {
        var start_ns: i64 = monotonic_ns();
        fn();
        var elapsed_ns: i64 = monotonic_ns() - start_ns;
        samples = samples.push(elapsed_ns / (1000 as i64));
        i = i + 1;
    }
    var sorted: i64[] = __bench_sort_us(samples);
    var min_us: i64 = sorted[0];
    var max_us: i64 = sorted[iterations - 1];
    var median_us: i64 = sorted[iterations / 2];
    var sum_us: i64 = 0 as i64;
    var k: i32 = 0;
    while (k < iterations) {
        sum_us = sum_us + sorted[k];
        k = k + 1;
    }
    var mean_us: i64 = sum_us / (iterations as i64);
    print("# bench " + name + " (" + iterations.to_string() + " iters): " +
          "min=" + min_us.to_string() + "us " +
          "median=" + median_us.to_string() + "us " +
          "mean=" + mean_us.to_string() + "us " +
          "max=" + max_us.to_string() + "us");
    return r.it(name, None);
}

// `(r) bench_max_us(name, iterations, fn, max_us)` — same as
// `bench` but fails when the MEDIAN per-iteration time
// exceeds `max_us`. Median (not mean) is the right
// regression signal: one GC pause inflates the mean but
// leaves the median honest.
pub function (r: TestRunner) bench_max_us(name: string, iterations: i32, fn: () => void, max_us: i64): TestRunner {
    if (iterations <= 0) {
        return r.it(name, fail("bench: iterations must be > 0"));
    }
    var samples: i64[] = [];
    var i: i32 = 0;
    while (i < iterations) {
        var start_ns: i64 = monotonic_ns();
        fn();
        var elapsed_ns: i64 = monotonic_ns() - start_ns;
        samples = samples.push(elapsed_ns / (1000 as i64));
        i = i + 1;
    }
    var sorted: i64[] = __bench_sort_us(samples);
    var median_us: i64 = sorted[iterations / 2];
    var max_us_observed: i64 = sorted[iterations - 1];
    print("# bench " + name + " (" + iterations.to_string() + " iters): " +
          "median=" + median_us.to_string() + "us " +
          "max=" + max_us_observed.to_string() + "us " +
          "budget=" + max_us.to_string() + "us");
    if (median_us > max_us) {
        return r.it(name, Some("bench_max_us: median " +
                               median_us.to_string() +
                               "us > budget " + max_us.to_string() + "us"));
    }
    return r.it(name, None);
}

// =================== TIMING ASSERTIONS ===================
//
// Benchmark-shape assertions: "the operation under test
// completed within N milliseconds". Pair with the
// `monotonic_ns()` builtin to stamp the start time, then
// pass the stamp + the deadline to one of these helpers.
// The deadline is the upper bound — passes when elapsed
// is strictly LESS than the deadline.
//
// Use `monotonic_ns` for the timestamps (not `now_unix_ms`)
// so NTP-style wall-clock adjustments don't move the
// goalposts mid-test.

// `assert_elapsed_lt_ms(start_ns, max_ms)` — passes if the
// elapsed time since `start_ns` (a `monotonic_ns()` stamp)
// is below `max_ms`. The failure message embeds both the
// observed elapsed and the deadline so a flaky-bench
// failure logs enough context to decide whether to bump
// the bound.
pub function assert_elapsed_lt_ms(start_ns: i64, max_ms: i64): Option[string] {
    var elapsed_ns: i64 = monotonic_ns() - start_ns;
    var elapsed_ms: i64 = elapsed_ns / (1000000 as i64);
    if (elapsed_ms < max_ms) { return None; }
    return Some("assert_elapsed_lt_ms: " + elapsed_ms.to_string() +
                "ms elapsed, expected < " + max_ms.to_string() + "ms");
}

// `assert_elapsed_lt_us(start_ns, max_us)` — finer-grained
// for sub-millisecond budgets. Same shape as the `_ms`
// variant; the failure message reports microseconds.
pub function assert_elapsed_lt_us(start_ns: i64, max_us: i64): Option[string] {
    var elapsed_ns: i64 = monotonic_ns() - start_ns;
    var elapsed_us: i64 = elapsed_ns / (1000 as i64);
    if (elapsed_us < max_us) { return None; }
    return Some("assert_elapsed_lt_us: " + elapsed_us.to_string() +
                "us elapsed, expected < " + max_us.to_string() + "us");
}

// =================== JSON DEEP EQUALITY ===================
//
// Structured-output tests (HTTP handlers emitting JSON,
// diagnostic emitters with structured fields) want to assert
// on the document shape rather than the exact byte-for-byte
// serialization. JObject key order, whitespace, and JNumber
// formatting all vary across emitters; `assert_json_eq`
// parses both sides via `std/json` and walks the JsonValue
// trees in order-independent fashion.

// __json_value_eq compares two JsonValue trees recursively.
// JObject is order-independent (Map iteration order isn't
// observable); arrays, strings, numbers, booleans, null all
// compare structurally. JNumber compares the textual payload
// — the JSON spec doesn't fix precision, so two emitters
// producing "1.0" vs "1" would diverge here; callers that
// want numeric tolerance should parse + cast themselves.
function __json_value_eq(a: JsonValue, b: JsonValue): boolean {
    match (a) {
        JNull => {
            match (b) {
                JNull => { return true; },
                _ => { return false; }
            }
        },
        JBool(av) => {
            match (b) {
                JBool(bv) => { return av == bv; },
                _ => { return false; }
            }
        },
        JNumber(av) => {
            match (b) {
                JNumber(bv) => { return av == bv; },
                _ => { return false; }
            }
        },
        JString(av) => {
            match (b) {
                JString(bv) => { return av == bv; },
                _ => { return false; }
            }
        },
        JArray(av) => {
            match (b) {
                JArray(bv) => {
                    if (len(av) != len(bv)) { return false; }
                    var i: i32 = 0;
                    while (i < len(av)) {
                        if (!__json_value_eq(av[i], bv[i])) { return false; }
                        i = i + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        JObject(am) => {
            match (b) {
                JObject(bm) => {
                    if (am.len() != bm.len()) { return false; }
                    var keys: string[] = am.keys();
                    var i: i32 = 0;
                    while (i < len(keys)) {
                        var k: string = keys[i];
                        match (am.get(k)) {
                            None => { return false; },
                            Some(av) => {
                                match (bm.get(k)) {
                                    None => { return false; },
                                    Some(bv) => {
                                        if (!__json_value_eq(av, bv)) { return false; }
                                    }
                                }
                            }
                        }
                        i = i + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        }
    }
    return false;
}

// =================== GOLDEN FILES ===================
//
// Golden-file testing: compare `actual` against the contents
// of `path`. If `path` doesn't exist, write `actual` to it and
// pass — the next run becomes the comparison baseline. This
// is the classic "approve by running" workflow for tests
// whose expected output is too verbose to inline. CI runs
// MUST fail on a missing golden file (the writer side is a
// developer-time convenience); `assert_matches_golden_strict`
// surfaces that distinction.

// `assert_matches_golden(path, actual)` — if `path` exists,
// compare byte-exactly via the line-diff helper. If `path`
// doesn't exist, write `actual` to it and pass with a TAP
// comment noting the bootstrap. Use this during development;
// run `assert_matches_golden_strict` in CI to catch missing-
// golden cases that would silently bootstrap themselves.
pub function assert_matches_golden(path: string, actual: string): Option[string] {
    match (read_file(path)) {
        Ok(expected) => {
            return assert_eq_string_diff(actual, expected);
        },
        Err(_) => {
            // Golden missing — write the current output as the
            // baseline. The TAP comment makes the bootstrap
            // visible in logs so accidental "approve by
            // running on CI" is easy to spot.
            match (write_file(path, actual)) {
                None => {
                    print("# golden file bootstrapped at " + path);
                    return None;
                },
                Some(_) => {
                    return Some("assert_matches_golden: could not write " + path);
                }
            }
        }
    }
    return None;
}

// `assert_matches_golden_strict(path, actual)` — same compare
// behaviour but a missing golden file is a FAILURE rather than
// a bootstrap. Use in CI; reach for the auto-bootstrap variant
// only during development.
pub function assert_matches_golden_strict(path: string, actual: string): Option[string] {
    match (read_file(path)) {
        Ok(expected) => {
            return assert_eq_string_diff(actual, expected);
        },
        Err(_) => {
            return Some("assert_matches_golden_strict: golden file missing: " + path);
        }
    }
    return None;
}

// =================== MAP ASSERTIONS ===================
//
// `Map[K, V]` is the language's IndexMap container. Tests that
// build a map up and then inspect its contents reach for a
// "does the map have this key", "does the value at this key
// match X", "is the map size N" shape — these helpers fold
// the per-receiver-method check + the assertion into one call.
//
// Two width pairs cover the migration's needs: (i32, i32) and
// (string, string). Other K/V combinations should write the
// receiver-method dispatch inline.

// `assert_map_len_i32_i32(m, n)` — map length matches.
pub function assert_map_len_i32_i32(m: Map[i32, i32], n: i32): Option[string] {
    var got: i32 = m.len();
    if (got == n) { return None; }
    return Some("assert_map_len: expected " + n.to_string() +
                " entries, got " + got.to_string());
}

pub function assert_map_len_string_string(m: Map[string, string], n: i32): Option[string] {
    var got: i32 = m.len();
    if (got == n) { return None; }
    return Some("assert_map_len: expected " + n.to_string() +
                " entries, got " + got.to_string());
}

// `assert_map_has_i32_i32(m, k, v)` — key `k` is present with
// value `v`. Failure message distinguishes "key missing" from
// "key present with wrong value".
pub function assert_map_has_i32_i32(m: Map[i32, i32], k: i32, v: i32): Option[string] {
    match (m.get(k)) {
        Some(got) => {
            if (got == v) { return None; }
            return Some("assert_map_has: key " + k.to_string() +
                        " -> " + got.to_string() + ", expected " + v.to_string());
        },
        None => {
            return Some("assert_map_has: key " + k.to_string() + " missing");
        }
    }
    return None;
}

pub function assert_map_has_string_string(m: Map[string, string], k: string, v: string): Option[string] {
    match (m.get(k)) {
        Some(got) => {
            if (got == v) { return None; }
            return Some("assert_map_has: key \"" + k +
                        "\" -> \"" + got + "\", expected \"" + v + "\"");
        },
        None => {
            return Some("assert_map_has: key \"" + k + "\" missing");
        }
    }
    return None;
}

// `assert_map_lacks_*(m, k)` — key `k` is NOT present. Used
// after a delete or in negative-result tests.
pub function assert_map_lacks_i32_i32(m: Map[i32, i32], k: i32): Option[string] {
    if (m.has(k)) {
        return Some("assert_map_lacks: key " + k.to_string() + " unexpectedly present");
    }
    return None;
}

pub function assert_map_lacks_string_string(m: Map[string, string], k: string): Option[string] {
    if (m.has(k)) {
        return Some("assert_map_lacks: key \"" + k + "\" unexpectedly present");
    }
    return None;
}

// `assert_json_eq(actual, expected)` — both inputs are JSON
// text. Parses each via `std/json`'s `json_parse`, walks the
// resulting trees in order-independent fashion, and reports
// a failure with both raw documents quoted when they differ.
// Invalid JSON on either side surfaces as a failure with
// the offender named so the diagnostic is unambiguous.
//
// Uses the qualified `json.json_parse(...)` form rather than
// bare `json_parse(...)` so modload's rewriter routes the
// call correctly under both the auto-prelude flat-load path
// AND the user-side mangled-load path (where the user's own
// `import "std/json";` would have already loaded json's
// decls under the `json__` prefix; bare-name lookup would
// miss them).
pub function assert_json_eq(actual: string, expected: string): Option[string] {
    var av: Option[JsonValue] = json.json_parse(actual);
    var ev: Option[JsonValue] = json.json_parse(expected);
    match (av) {
        None => {
            return Some("assert_json_eq: actual is not valid JSON: " + actual);
        },
        Some(a) => {
            match (ev) {
                None => {
                    return Some("assert_json_eq: expected is not valid JSON: " + expected);
                },
                Some(e) => {
                    if (__json_value_eq(a, e)) { return None; }
                    return Some("assert_json_eq: documents differ\n" +
                                "  expected: " + expected + "\n" +
                                "  actual:   " + actual);
                }
            }
        }
    }
    return None;
}
