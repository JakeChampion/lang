// std/serve — the HTTP/1.1 server: its `Config` and the entry points that
// run it.
//
// `run(port, cfg, handler)` runs an HTTP/1.1 accept loop on
// `port`, calling `handler(req, plat)` once per request; `supervise`
// runs `cfg.workers` of those loops in forked workers under a supervisor
// that replaces whichever dies. `plat` is the worker's `platform.Host`,
// the capabilities a handler reaches the host through
// (docs/PLATFORM-RESEARCH.md Rec §1); a handler written against the
// `platform.Platform` trait takes it, as it would a test's mock.
// When the listener can't be bound (EADDRINUSE, say) the address and the
// error's text go to stderr and the entry returns 98; otherwise the loop
// runs until SIGTERM or SIGINT, then
// drains and returns `__stop_code`: 0 when every request in
// flight was answered, 1 when one was cut off.
//
// The loop is a reactor (#9853): one readiness set from the Driver seam
// (`async.real_driver()`: epoll, kqueue or wasi pollables) watches the
// listener and every open connection, so many slow clients are read
// side by side and a request is answered as soon as its bytes are in.
// Per-connection lifecycle (under `Config.tls` every read below goes
// through the connection's TLS session and every write is sealed by it,
// the handshake running on the same reads and writes before the first
// request):
//   1. accept when the listener is readable, switch the connection to
//      non-blocking and watch it for reads; its read deadline (default
//      10 s; `Config.recv_deadline`) is the
//      slow-loris guard: a connection past it is closed without a
//      response, and the wait's timeout is the earliest one due. Once
//      the header block is in, the body extends the deadline by what it
//      has delivered: after a grace (5 s) it may take as long as its
//      bytes buy at the minimum rate (240 bytes per second), so a large
//      upload that keeps flowing outlasts the deadline and a trickle
//      does not. At `max_connections` open the listener is left
//      unwatched, so further connections wait in the accept queue until
//      one closes.
//   2. when it is readable, tcp_recv_into the loop's one 4 KiB buffer
//      until a read comes back short, lending the buffer to a connection
//      with nothing buffered and appending to one with a partial request
//      (at most the parser's header and body caps unread).
//   3. http_parse_request_framed — Incomplete ⇒ keep reading (on EOF, 400 and close);
//      Continue ⇒ send `100 Continue` once (RFC 9110 §10.1.1) and keep
//      reading; Malformed(status) ⇒ answer with that status (400, 413,
//      414, 417, 431 or 501), an empty body and `Connection: close`, then close; a
//      malformed request behind an answered one gets no answer, since
//      that answer already said close (RFC 9112 §9.6).
//   4. handler(req, plat) runs as a task: it returns the HttpResponse,
//      or parks on a wait (`plat.http` waiting on its upstream, through
//      `async.wait_any`), in which case the loop watches what it waits
//      on, serves other connections meanwhile, and answers when it runs
//      on and returns (`__Flight`). A connection with a parked handler
//      takes no further request until it answers, so its pipelined
//      requests stay in order. `run_with`'s handler, whose state threads
//      through every request, runs to completion instead. A handler that
//      has not answered by `Config.handler_deadline` is answered 503 in
//      its place, and cancelled when it is parked then. A response's
//      background work (`HttpResponse.background`) starts as a task once
//      the event that wrote the response is done, parking as a handler
//      does, until `Config.background_deadline` cancels it.
//   5. http_serialize_response_into the loop's one builder →
//      tcp_send_buf, with a `Date` the loop formats once per second (RFC
//      9110 §6.6.1) unless the handler set one, and no body on a response
//      to HEAD or a 1xx, 204 or 304;
//      what the kernel does not take stays with the connection, watched
//      for writability until it drains.
//   6. a connection persists across requests (RFC 9112 §9.3: HTTP/1.1
//      unless `Connection: close`, HTTP/1.0 only with `Connection:
//      keep-alive`) until the keep-alive idle span passes with no request
//      or it has answered `keep_alive_requests`; the request's bytes are
//      dropped from its buffer, so requests pipelined behind them are
//      answered from the same readable event, their responses corked
//      into one write (`__corks`) → unwatch → tcp_close.
//   7. SIGTERM or SIGINT, a readiness event on the reactor, starts the
//      shutdown:
//      the loop keeps accepting for `shutdown_grace` (whoever routes to
//      it removes it in parallel), answers 503 on `readiness_path`,
//      then closes the listener, stops keep-alive (every response says
//      close), closes the connections with nothing in flight, and gives
//      the rest `drain_deadline` from the signal to finish before
//      closing them too, responses' background work getting the same
//      span; it returns 0 once every connection and background task is
//      gone, 1 when it cut a connection off. A listener the process was started with
//      (`LISTEN_FDS`, descriptor 3) is served instead of a fresh one.
//   8. the loop counts its requests (std/metrics `ServerMetrics`: the
//      duration histogram by method and status, connections accepted and
//      open) and, with `metrics_port`, answers scrapes: under `supervise`
//      by shipping the text to the supervisor down a pipe once a second,
//      the supervisor summing the workers' snapshots on `/metrics`;
//      under `run`, from its own exporter on that port.
//
// The native targets wire this through the Fern-bodied __fern_tcp_* and
// __fern_reactor_* helpers over the syscall floor. The wasm side gates
// tcp_* on wasi:sockets at module instantiation; CLI-mode programs that
// call `run` need a host-pre-opened socket (`wasmtime run -S tcp=y`).
//
// `__port_from_env(name, fallback)` is the convenience helper
// the auto-`main`-from-`handle()` synthesis uses so handler-
// shaped programs can be tuned via `PORT=N ./bin` without a
// manual main().
//
// No prelude: these are in scope only after a program
// declares `import "std/serve";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

import "std/async";
import "std/platform";
import "std/fetch";
import "std/http/trace";
import "std/http/cookie";
import "std/http/forwarded";
import "std/http";
import "std/stream";
import "std/net";
import "std/time";
import "std/metrics";
import "std/tls/server";
import "std/i64";
// core/int — int_to_string for the supervisor's worker-death log
// lines (the raw exit code, straight to stderr).
import "core/int";
import "std/http/h2";

// __recv_deadline_default() — default per-request read deadline for the
// serve loops (10 s): the whole request (headers + body) must arrive
// within this window or the connection is closed without a response.
// This is the slow-loris guard — without it one client trickling bytes
// pins the single-threaded accept loop forever. `Config.recv_deadline`
// takes a caller-chosen value.
function __recv_deadline_default(): Duration {
  return time.duration_seconds(10 as i64);
}

// Config — what a serve loop asks of its listener and of each
// connection: the accept queue depth, whether other listeners may share
// the port (`SO_REUSEPORT`, the kernel balancing accepted connections
// across them; ignored on wasm, where a port is one socket's), the
// per-request read deadline (`__recv_deadline_default`), the least
// rate at which a request body must keep arriving once its header block
// is in (bytes per second, judged after its grace: the body may take as
// long as its bytes buy at that rate, beyond the read deadline), the
// least rate at which a response must be drained (judged after its own
// grace: a response being drained may take as long as the bytes the peer
// has taken buy; 0 for no bound but the read deadline), how
// long an idle persistent connection is kept waiting for its next
// request, how many requests one connection may carry before its
// response says `Connection: close`, how many connections the loop
// holds open at once (past it, the listener is not read and connections
// wait in its accept queue until one closes), how many of them one
// client may hold (by the peer's address key, `net.peer_key`, counted by
// this loop alone; a connection past it is closed as it is accepted; 0
// for no cap), how many handlers and chunk producers the loop keeps
// parked on their waits at once (a handler whose `plat.http` waits on
// its upstream parks, as does a producer waiting for its next chunk, and
// the loop serves other connections meanwhile; at the cap the listener
// is not read until one finishes), how many workers
// `supervise` forks, each running its own loop over the
// one listener (below 1: one per processing unit the process may use,
// what `cpu_count()` answers), and the shutdown a
// SIGTERM starts (`__serve_stopping`): how long the loop keeps accepting
// after the signal, since whoever routes to it removes it in parallel,
// the path it answers 503 from the signal on (a readiness probe; "" for
// none), how long the requests in flight get to finish once the
// listener is closed before the loop gives up on them, the parser's
// caps on each request (`http.HttpLimits`), whether the parent's exit
// starts that shutdown too (`async.Driver.watch_parent`), which the
// supervisor sets for its workers, and whether a handler starts on its
// request's header block, its body a Stream that pulls the bytes as the
// handler reads them (`stream_bodies`, docs/NET-P3-SUSPENSION-PLAN.md
// §3.9) rather than once the body has arrived whole; the stateful loop
// (`run_with`) runs its handler to completion and reads bodies whole either
// way; and whether each worker's platform carries a cookie jar
// (`cookie_jar`, std/http/cookie), its `plat.http` then sending and storing
// cookies as a browser would, the hosts that `plat.http` may reach
// (`http_allow`, `fetch.allow`; None for any global address), and how
// long a handler has to answer from its start (`handler_deadline`, which
// the handler reads as `plat.deadline()`; 0 for no bound): a handler parked
// when it passes is cancelled, and one that has not answered by then is
// answered 503 in its place; and how long a response's background work
// (`HttpResponse.background`, std/http's `with_background`) may run on
// after it, the loop cancelling it then (`background_deadline`, 30 s as
// Cloudflare Workers bound `waitUntil`; 0 for no bound); and whether each
// request opens a span (`trace`, std/http/trace), continuing the caller's
// trace from its `traceparent` or starting one, which the handler reads as
// `plat.trace()` and `plat.http` carries upstream; and the metrics the
// program exposes (`metrics`, a std/metrics `Registry`, beside the
// request-duration histogram and connection counts the loop records on its
// own) and the port they are scraped on (`metrics_port`; 0 for none): under
// `supervise` the supervisor answers `/metrics`, `/healthz` and `/readyz`
// there from the snapshot each worker ships it once a second, so a scrape
// never touches a worker, and under `run` the loop answers them itself.
pub struct Config {
  backlog: i32,
  reuse_port: boolean,
  recv_deadline: Duration,
  min_data_rate: i32,
  data_rate_grace: Duration,
  response_min_data_rate: i32,
  response_data_rate_grace: Duration,
  keep_alive_idle: Duration,
  keep_alive_requests: i32,
  max_connections: i32,
  max_connections_per_ip: i32,
  max_in_flight: i32,
  workers: i32,
  shutdown_grace: Duration,
  readiness_path: string,
  drain_deadline: Duration,
  limits: http.HttpLimits,
  stop_with_parent: boolean,
  stream_bodies: boolean,
  tls: Option[server.Config],
  cookie_jar: boolean,
  http_allow: Option[fetch.Allow],
  handler_deadline: Duration,
  background_deadline: Duration,
  trace: boolean,
  proxy_protocol: boolean,
  metrics: metrics.Registry,
  metrics_port: i32,
  // Whether a connection that opens with HTTP/2's preface (prior-knowledge
  // h2c), or negotiates `h2` by ALPN under TLS, is served over HTTP/2.
  h2: boolean,
}

// config() — the defaults: a backlog of 128, the port held
// by one listener, the 10 s read deadline, a 130 s keep-alive idle span,
// 1000 requests per connection, 1024 connections open and 100 of them per
// client, 1024 handlers or chunk producers parked at once, a worker per
// processing unit, no handler deadline, background work cut off after
// 30 s, no tracing, and
// the parser's `http_limits()`, bodies read whole before the handler runs.
pub function config(): Config {
  return Config { backlog: 128, reuse_port: false, recv_deadline: __recv_deadline_default(), min_data_rate: 240, data_rate_grace: time.duration_seconds(5 as i64), response_min_data_rate: 240, response_data_rate_grace: time.duration_seconds(5 as i64), keep_alive_idle: time.duration_seconds(130 as i64), keep_alive_requests: 1000, max_connections: 1024, max_connections_per_ip: 100, max_in_flight: 1024, workers: 0, shutdown_grace: time.duration_seconds(2 as i64), readiness_path: "", drain_deadline: time.duration_seconds(30 as i64), limits: http.http_limits(), stop_with_parent: false, stream_bodies: false, tls: None, cookie_jar: false, http_allow: None, handler_deadline: time.duration_seconds(0 as i64), background_deadline: time.duration_seconds(30 as i64), trace: false, proxy_protocol: false, metrics: metrics.registry(), metrics_port: 0, h2: false };
}

// (c).with_tls(cfg) — every connection speaks TLS 1.3 under `cfg`
// (std/tls/server): the handshake runs on the connection's own reads and
// writes before its first request, responses are sealed as they are
// written, and a file body is read and sealed rather than moved by
// sendfile. The protocol offered by ALPN is `http/1.1`, whatever `cfg`
// named. A client that does not speak TLS, or whose handshake the server
// refuses, is sent the alert and closed; the read deadline bounds the
// handshake as it bounds a request.
pub function (c: Config) with_tls(cfg: server.Config): Config {
  return Config { ...c, tls: Some(cfg.with_alpn(["http/1.1"])) };
}

// (c).with_h2() — HTTP/2 served beside HTTP/1.1 (std/http/h2): a connection
// that opens with the HTTP/2 connection preface is served over it, and under
// TLS the protocols offered by ALPN are `h2` and `http/1.1`. The handler is
// the same; a request's `:authority` arrives as its `host`. Each stream's
// handler runs to its answer on the loop; `run_with`'s stateful loop serves
// HTTP/1.1 only.
pub function (c: Config) with_h2(): Config {
  return Config { ...c, h2: true };
}

// run(port, opts, handler) — serve `handler` on `port` in this process,
// under `opts`.
pub function run(port: i32, opts: Config, handler: (HttpRequest, platform.Host) => HttpResponse): i32 {
  return run_shutdown(port, opts, handler, (reason: string): void => {});
}

// run_shutdown(port, opts, handler, shutdown) — `run`
// with a hook the loop calls once it has stopped, before returning: with
// "sigterm" or "sigint", the signal that started the shutdown, when every
// request in flight was answered, or "drain-deadline" when one was cut
// off at the drain deadline.
pub function run_shutdown(port: i32, opts: Config, handler: (HttpRequest, platform.Host) => HttpResponse, shutdown: (string) => void): i32 {
  let l: __Listen = __serve_listener(port, opts);
  if (l.fd < 0) {
    return __listen_failed(l);
  }
  return __serve_loop(l.fd, handler, opts, shutdown, None);
}

// __serve_listener(port, opts) — the listener a serve loop runs over: the
// one the process was started with when `LISTEN_FDS` says it has one
// (descriptor 3, the systemd convention, which is also how a restarted
// server takes over a socket without a gap), else a fresh one on `port`.
function __serve_listener(port: i32, opts: Config): __Listen {
  let l: __Listen = __listener_of(port, opts);
  // Non-blocking: a wake-up over a listener workers share can reach
  // more than one of them, and the one that finds nothing to accept
  // must return to its wait rather than block in accept until the next
  // connection, deaf to SIGTERM.
  if (l.fd >= 0) {
    tcp_socket_ctl(l.fd, 3, 1);
  }
  return l;
}

// __Listen — a listener's descriptor, or the -errno that refused it, and
// the address it was bound to or tried (empty for one inherited).
struct __Listen { fd: i32, addr: string }

// __listen_failed(l) — a refused listener: the address and the error's
// text on stderr, and 98, the exit code a serve entry answers for it.
function __listen_failed(l: __Listen): i32 {
  eprint("serve: cannot listen on " + l.addr + ": " + net.error_from_errno(l.fd).message());
  return 98;
}

// __listener_of(port, opts) — the listener handed in through LISTEN_FDS,
// or a fresh one on `port`: on `::` for both families, or on `0.0.0.0`
// where the host has no IPv6 (the family refused, or the address not
// there to bind) and on wasm, whose `::` listener would be IPv6-only.
function __listener_of(port: i32, opts: Config): __Listen {
  match (env("LISTEN_FDS")) {
    Some(n) => {
      match (int.parse_int_radix(n, 10)) {
        Some(count) => {
          if (count >= 1) {
            return __Listen { fd: 3, addr: "" };
          }
        },
        None => {}
      }
    },
    None => {}
  }
  if (target_os() != "wasi") {
    let both: i32 = tcp_listen_with(__every_v6(), port, opts.backlog, opts.reuse_port);
    if (both >= 0 || !__no_v6(both)) {
      return __Listen { fd: both, addr: net.socket_addr(net.ipv6_unspecified(), port).to_string() };
    }
  }
  return __Listen { fd: tcp_listen_with(__every_v4(), port, opts.backlog, opts.reuse_port), addr: net.socket_addr(net.ipv4_unspecified(), port).to_string() };
}

// __no_v6(r) — a `::` listener refused because the host has no IPv6:
// -EAFNOSUPPORT from socket(2), or -EADDRNOTAVAIL from a bind where the
// family exists but is switched off.
function __no_v6(r: i32): boolean {
  let e: net.NetError = net.error_from_errno(r);
  return e.eq(net.AddrNotAvailable) || r == 0 - __eafnosupport();
}

function __eafnosupport(): i32 {
  if (target_os() == "darwin") {
    return 47;
  }
  return 97;
}

// run_with(port, opts, init, handler) — serve with a caller-owned
// state value threaded through the request chain. `handler` takes the
// state alongside the request and returns the state the NEXT request
// will see, paired with the response to send:
//
//     function handle(hits: Map[string, i32], req: HttpRequest,
//                     plat: platform.Platform): (Map[string, i32], HttpResponse) {
//         let n: i32 = hits.get_or(req.path, 0) + 1;
//         return (hits.insert(req.path, n),
//                 http.ok(int.int_to_string(n)));
//     }
//     let init: Map[string, i32] = map_new(8);
//     serve.run_with(8080, serve.config(), init, handle);
//
// `init` needs the annotated local when its value comes from a
// context-typed builtin like `map_new`: inline, `S` binds from the
// unsettled argument before the handler can pin it down.
//
// The state lives in the accept loop's own frame, which is what makes
// it process-lifetime: Fern has no module-level mutable state. The cell
// alternative holds any cycle-free value, a `Map` included, but nothing
// that can carry a function or another cell (E057). Threading has no
// such limit: `S` is any type.
//
// Under `supervise_with` each worker carries a copy of its own, and a
// worker forked again after a death starts from `init`: state that must
// outlive a crash belongs in a store the handler reaches through `plat`.
pub function run_with[S](port: i32, opts: Config, init: S, handler: (S, HttpRequest, platform.Host) => (S, HttpResponse)): i32 {
  return run_with_shutdown(port, opts, init, handler, (reason: string, state: S): void => {});
}

// run_with_shutdown(port, opts, init, handler, shutdown) —
// `run_with` with a hook the loop calls once it has stopped,
// before returning, with the reason `run_shutdown` gives and the
// state as the last request left it: where a counter is flushed or a
// store is closed.
pub function run_with_shutdown[S](port: i32, opts: Config, init: S, handler: (S, HttpRequest, platform.Host) => (S, HttpResponse), shutdown: (string, S) => void): i32 {
  let l: __Listen = __serve_listener(port, opts);
  if (l.fd < 0) {
    return __listen_failed(l);
  }
  return __serve_loop_with(l.fd, init, handler, opts, shutdown, None);
}

// __eagain() — EAGAIN as this target numbers it: what a non-blocking read
// answers while nothing is queued. wasm's reads never block and use the
// same answer.
// 0.0.0.0 and ::, the unspecified address of each family.
function __every_v4(): u8[] {
  return [0u8, 0u8, 0u8, 0u8];
}

function __every_v6(): u8[] {
  return [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
}

function __eagain(): i32 {
  if (target_os() == "darwin") {
    return 35;
  }
  if (target_os() == "wasi") {
    return 6;
  }
  return 11;
}

function __enotsup(): i32 {
  if (target_os() == "darwin") {
    return 45;
  }
  if (target_os() == "wasi") {
    return 58;
  }
  return 95;
}

// __recv_room() — how much one read may take: the scratch's room.
function __recv_room(): i32 {
  return 4096;
}

// __recv_scratch() — the loop's one read buffer. A read fills it at its
// room and shortens it to the bytes read (`__arr_set_len`); the loop lends
// it to the connection whose empty buffer the read filled, for the event
// (`__serve_read`), and takes it back once the event is done with the
// connection (`__serve_compact`).
function __recv_scratch(): u8[] {
  return __alloc_u8(__recv_room());
}

// __Conns — the open connections of a serve loop, by position: the
// descriptor, the request bytes read and not yet answered, how many of
// them the requests answered in the current event occupied (0 between
// events: the answered bytes are dropped once per event, not per
// request), the response bytes the kernel has not taken yet ("" while a
// request is being read), the monotonic time its deadline falls due (the
// read deadline, the same span again for a write, the keep-alive idle
// span between requests), whether the connection persists once the
// response in flight is sent, how many requests it has answered, and
// whether a complete request is still buffered because the event's
// burst ended before it (answered on the next wait, which returns at
// once), whether the request being read has had its `100 Continue`, and
// the data-rate clock: the monotonic time the request's header block
// was found complete (-1 while it is being read or nothing is) and how
// many bytes the buffer held then, so the bytes since are the body's;
// or, once a response is being drained, the time of its first short
// write and how many bytes were pending then; and the peer's address key
// (`tcp_socket_ctl` op 7; 0 when the host will not say), by which the
// per-client cap counts. `last` is the request the loop took last, on
// any connection, less its body: every parse's `prev`, one per loop so an
// idle connection holds none. `out` is the builder every reply is
// serialized into and sent from, also one per loop: what it holds between
// replies is what the event's burst has corked, and it is empty between
// events. `lent` is the position of the connection the loop's read
// scratch is lent to for the current event, -1 between events: only that
// connection's buffer may be the scratch, and `__serve_compact` hands it
// back before the event is done with the connection. `parked` is the
// flights a chunk producer's park staged during the event, and `later`
// the background work of the responses it wrote
// (`HttpResponse.background`), for the loop to take (`__staged_taken`)
// once the event's work hands the connections back. `framing` is what the
// loop reads each connection's bytes as (`__Framing`). `metrics` is what
// the loop counts about itself (std/metrics `ServerMetrics`): its cells are
// shared by every copy of the value, so a count never needs the table back.
struct __Conns { fds: i32[], bufs: u8[][], offs: i32[], pending: u8[][], deadlines: i64[], keep: boolean[], served: i32[], backlog: boolean[], continued: boolean[], rate_since: i64[], rate_base: i32[], send_since: i64[], send_base: i32[], peers: i32[], hosts: platform.Host[], tails: __Tail[], tls: __Tls[], framing: __Framing[], last: http.HttpFramed, out: usize, lent: i32, parked: __Flight[], later: (() => void)[], metrics: metrics.ServerMetrics }

// __Tls — a connection's TLS: none; its session, through which every
// byte read and written passes; lent to the handler pulling a streamed
// body (`__Body.tls`), which reads the connection itself until the body
// ends; or awaiting the PROXY protocol header (`Config.proxy_protocol`),
// with the session to run once it has come and its bytes so far.
enum __Tls { Plain, Secured(server.Session), Lent, Awaiting(Option[server.Session], u8[]) }

// __Framing — what the loop reads a connection's bytes as: HTTP/1.1
// requests; an HTTP/1.1 request whose streamed body a pull owns the read
// side of (`__serve_stream`), the body the loop writes through when the
// session is lent (`__serve_send`) and an upgraded connection's producer
// flight carries; or HTTP/2 frames into the connection's state.
enum __Framing { Http1, Pulling(__Body), Http2(h2.Conn) }

// __pulling(c, at) — the streamed body a pull owns on the connection at
// `at`, None when none does.
function __pulling(c: __Conns, at: i32): Option[__Body] {
  match (c.framing[at]) {
    Pulling(body) => {
      return Some(body);
    },
    _ => {
      return None;
    }
  }
  return None;
}

// __Tail — what of a response is still to be produced once its head and
// the bytes pending have gone: nothing; a range of a file the loop reads
// as the socket takes it, with the bytes the range still owes and the
// spans after it (`FileTail`), or the seam written between two ranges
// (`SeamTail`); or the
// chunks a producer answers from the next index, under chunked transfer
// coding with the last chunk and trailer section that end them, or
// close-delimited (an empty ending) for an HTTP/1.0 client; or those
// chunks while the producer is parked on a wait for the next one
// (`ParkedTail`), the flight running it holding the task.
enum __Tail { NoTail, FileTail(Reader, i64, __Spans), SeamTail(Reader, u8[], __Spans), ChunkTail(ChunkProducer, i32, string), ParkedTail(ChunkProducer, i32, string) }

// __Spans — what a file body sends after its current range: the ranges
// still to come (start, length pairs) and the seams written after the
// current range and after each of those.
struct __Spans { ranges: i64[], seams: u8[][] }

// __after_range(r, rest) — the tail once a range of `r` has gone: the seam
// after it, else the next range, else nothing, `r` closed then. None when
// the next range cannot be sought to.
function __after_range(r: Reader, rest: __Spans): Option[__Tail] {
  let next: __Spans = __Spans { ranges: rest.ranges, seams: __from(rest.seams, 1) };
  if (rest.seams.len() > 0 && rest.seams[0].len() > 0) {
    return Some(SeamTail(r, rest.seams[0], next));
  }
  return __range_tail(r, next);
}

// __range_tail(r, sp) — the tail sending the first of `sp`'s ranges, `r`
// sought to its start; nothing once no range is left, `r` closed.
function __range_tail(r: Reader, sp: __Spans): Option[__Tail] {
  if (sp.ranges.len() < 2) {
    r.close();
    return Some(NoTail);
  }
  let rest: __Spans = __Spans { ranges: __from(sp.ranges, 2), seams: sp.seams };
  if (sp.ranges[1] == 0 as i64) {
    return __after_range(r, rest);
  }
  match (r.seek(sp.ranges[0], 0)) {
    Ok(at) => {
      return Some(FileTail(r, sp.ranges[1], rest));
    },
    Err(e) => {
      r.close();
      return None;
    }
  }
  return None;
}

function __from[T](xs: T[], from: i32): T[] {
  let out: T[] = [];
  let i: i32 = from;
  while (i < xs.len()) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}

// __tail_keeps(t) — whether the connection may persist once `t` has
// gone: a close-delimited tail is what ends it.
function __tail_keeps(t: __Tail): boolean {
  match (t) {
    ChunkTail(_, _, end) => {
      return end.len() > 0;
    },
    ParkedTail(_, _, end) => {
      return end.len() > 0;
    },
    _ => {}
  }
  return true;
}

// __Clock — the `Date` every response carries (RFC 9110 §6.6.1),
// formatted once per second: the wall-clock second it was formatted for,
// and the field line, `Date: ` and the IMF-fixdate text and CRLF.
struct __Clock { sec: i64, line: string }

// __clock_tick(clk) — the clock brought to the current second, the date
// reformatted only when the second has changed. Read once per wait, so
// the responses of one event share it.
function __clock_tick(clk: __Clock): __Clock {
  let sec: i64 = now_unix_ms() / 1000;
  if (sec == clk.sec && clk.line.len() > 0) {
    return clk;
  }
  return __Clock { sec: sec, line: "Date: " + time.instant_from_unix(sec).format_http_date() + "\r\n" };
}

// __serve_wire(out, method, version, answer, keep_alive, clk) — the
// response pushed into the builder `out` as the loop writes it: the
// handler's `Date` when it set one, the clock's otherwise, and no body
// where the request's method or the status says none. A body held whole
// goes behind the head byte for byte, under its byte length. What is
// left of the response, the tail still to be produced, is the result;
// whether the connection may persist after it follows from the tail
// (`__tail_keeps`), so nothing is built to carry the two together.
// A response with a header or trailer that cannot be written as one field
// line is answered 500 in its place, so no handler-supplied byte can end a
// line or start another response. A 101 whose body is a producer is an
// upgrade (std/http/websocket): its chunks go on the wire as they are,
// close-delimited, the producer running the session on the connection.
function __serve_wire(out: usize, method: string, version: string, answer: HttpResponse, keep_alive: boolean, clk: __Clock): __Tail {
  if (!http.http_fields_ok(answer.headers) || !http.http_fields_ok(answer.trailers)) {
    return __serve_wire(out, method, version, http.internal_error(""), keep_alive, clk);
  }
  let date: string = clk.line;
  if (answer.headers.has("date")) {
    date = "";
  }
  let headless: boolean = http.http_bodiless(answer.status) || method == "HEAD";
  match (answer.body) {
    BodyFile(path) => {
      let whole: i64[] = [];
      let none: u8[] = [];
      return __wire_file(out, method, version, answer, path, __Spans { ranges: whole, seams: [none, none] }, headless, keep_alive, clk, date);
    },
    BodyFileRanges(path, ranges, seams) => {
      if (ranges.len() == 0 || !http.file_ranges_ok(ranges, seams)) {
        return __serve_wire(out, method, version, http.internal_error(""), keep_alive, clk);
      }
      return __wire_file(out, method, version, answer, path, __Spans { ranges: ranges, seams: seams }, headless, keep_alive, clk, date);
    },
    BodyChunks(producer) => {
      if (answer.status == 101) {
        http.http_serialize_response_head_into(out, answer, false, date);
        return ChunkTail(producer, 0, "");
      }
      return __wire_chunks(out, version, answer, producer, headless, keep_alive, date);
    },
    _ => {
      http.http_serialize_response_into(out, method, answer, keep_alive, date);
      return NoTail;
    }
  }
  return NoTail;
}

// __wire_file(out, method, version, resp, path, body, headless, keep_alive,
// clk, date) — a file body opened here: the head under the body's length,
// its first seam, and its ranges as the tail, the whole file when `body`
// names none; or a 404 when the file cannot be opened, no longer holds the
// ranges, or cannot be sought to the first, decided before the head goes.
function __wire_file(out: usize, method: string, version: string, resp: HttpResponse, path: string, body: __Spans, headless: boolean, keep_alive: boolean, clk: __Clock, date: string): __Tail {
  match (open_reader(path)) {
    Ok(r) => {
      let ranges: i64[] = __ranges_held(r, body.ranges);
      if (ranges.len() == 0) {
        r.close();
        return __serve_wire(out, method, version, http.not_found(), keep_alive, clk);
      }
      let framing: string = date + "Content-Length: " + http.file_ranges_len(ranges, body.seams).to_string() + "\r\n";
      if (headless) {
        r.close();
        http.http_serialize_response_head_into(out, resp, keep_alive, framing);
        return NoTail;
      }
      match (__range_tail(r, __Spans { ranges: ranges, seams: __from(body.seams, 1) })) {
        Some(t) => {
          http.http_serialize_response_head_into(out, resp, keep_alive, framing);
          buf_push_bytes_range(out, body.seams[0], 0, body.seams[0].len());
          return t;
        },
        None => {
          return __serve_wire(out, method, version, http.not_found(), keep_alive, clk);
        }
      }
    },
    Err(e) => {
      return __serve_wire(out, method, version, http.not_found(), keep_alive, clk);
    }
  }
  return NoTail;
}

// __ranges_held(r, ranges) — `ranges` when the file holds every one of
// them, the whole file as one range when there are none; empty when the
// file cannot be measured or ends before a range does.
function __ranges_held(r: Reader, ranges: i64[]): i64[] {
  let none: i64[] = [];
  let size: i64 = 0 - 1 as i64;
  match (r.stat()) {
    Ok(st) => {
      size = st.size;
    },
    Err(e) => {
      return none;
    }
  }
  if (ranges.len() == 0) {
    return [0 as i64, size];
  }
  let i: i32 = 0;
  while (i + 1 < ranges.len()) {
    if (ranges[i] + ranges[i + 1] > size) {
      return none;
    }
    i = i + 2;
  }
  return ranges;
}

// __wire_chunks(out, version, resp, producer, headless, keep_alive, date) —
// a chunk producer as the tail: under chunked transfer coding for an
// HTTP/1.1 client, close-delimited for an HTTP/1.0 one, the connection
// ending with it.
function __wire_chunks(out: usize, version: string, resp: HttpResponse, producer: ChunkProducer, headless: boolean, keep_alive: boolean, date: string): __Tail {
  if (headless) {
    http.http_serialize_response_head_into(out, resp, keep_alive, date);
    return NoTail;
  }
  if (version == "HTTP/1.0") {
    http.http_serialize_response_head_into(out, resp, false, date);
    return ChunkTail(producer, 0, "");
  }
  let framing: string = date + "Transfer-Encoding: chunked\r\n";
  if (resp.trailers.names.len() > 0) {
    framing = framing + "Trailer: " + resp.trailers.names.join(", ") + "\r\n";
  }
  http.http_serialize_response_head_into(out, resp, keep_alive, framing);
  return ChunkTail(producer, 0, "0\r\n" + http.http_serialize_fields(resp.trailers) + "\r\n");
}

// __in_flight(c, at) — whether a response is still going out on the
// connection: bytes pending, or a tail still to be produced.
function __in_flight(c: __Conns, at: i32): boolean {
  if (c.pending[at].len() > 0) {
    return true;
  }
  match (c.tails[at]) {
    NoTail => {
      return false;
    },
    _ => {
      return true;
    }
  }
  return true;
}

// __tail_left(c, at) — the bytes a file tail still owes, 0 for any other.
function __tail_left(c: __Conns, at: i32): i32 {
  let left: i64 = 0 as i64;
  match (c.tails[at]) {
    FileTail(r, n, rest) => {
      left = n + http.file_ranges_len(rest.ranges, rest.seams);
    },
    SeamTail(r, seam, rest) => {
      left = seam.len() as i64 + http.file_ranges_len(rest.ranges, rest.seams);
    },
    _ => {
      return 0;
    }
  }
  if (left > 2147483647 as i64) {
    return 2147483647;
  }
  return left as i32;
}

// __tail_drop(c, at) — the tail let go: a file's reader closed.
function __tail_drop(c: __Conns, at: i32): __Conns {
  match (c.tails[at]) {
    FileTail(r, left, rest) => {
      r.close();
    },
    SeamTail(r, seam, rest) => {
      r.close();
    },
    _ => {}
  }
  return __Conns { ...c, tails: c.tails.with(at, NoTail) };
}

// __tail_piece(drv, c, at) — the next piece of the tail, produced: `(conns,
// piece, ok)`, with the tail advanced past it; an empty piece once the
// tail is exhausted, or while a chunk producer is parked on a wait for
// its next chunk, the tail then a `ParkedTail` and the flight that runs
// it on staged on the connections (`parked`); and `ok` false when the
// tail cannot be honoured (a file shorter than the length its head
// announced, or one that cannot be read, a producer cancelled), which
// only closing the connection answers honestly. A producer runs as a
// task, so one that waits for its next chunk parks the connection and
// not the worker.
function __tail_piece[D: async.Driver](drv: D, c: __Conns, at: i32): (__Conns, u8[], boolean) {
  let none: u8[] = [];
  match (c.tails[at]) {
    NoTail => {
      return (c, none, true);
    },
    ParkedTail(_, _, _) => {
      return (c, none, true);
    },
    FileTail(r, left, after) => {
      return __file_piece(c, at, r, left, after);
    },
    SeamTail(r, seam, after) => {
      return __tail_then(c, at, __range_tail(r, after), seam);
    },
    ChunkTail(producer, index, end) => {
      return __chunk_piece(drv, c, at, producer, index, end);
    }
  }
  return (c, none, true);
}

// __file_piece(c, at, r, left, after) — `__tail_piece` for a range of a
// file: its next piece, read.
function __file_piece(c: __Conns, at: i32, r: Reader, left: i64, after: __Spans): (__Conns, u8[], boolean) {
  let none: u8[] = [];
  let want: i32 = 65536;
  if (left < want as i64) {
    want = left as i32;
  }
  match (r.read_chunk_bytes(want)) {
    Ok(bytes) => {
      if (bytes.len() == 0) {
        return (__tail_drop(c, at), none, false);
      }
      let rest: i64 = left - bytes.len() as i64;
      if (rest <= 0 as i64) {
        return __tail_then(c, at, __after_range(r, after), bytes);
      }
      return (__Conns { ...c, tails: c.tails.with(at, FileTail(r, rest, after)) }, bytes, true);
    },
    Err(e) => {
      return (__tail_drop(c, at), none, false);
    }
  }
  return (c, none, false);
}

// __tail_then(c, at, next, piece) — `piece` sent with the tail moved on to
// `next`; a tail that cannot go on (None) fails the connection.
function __tail_then(c: __Conns, at: i32, next: Option[__Tail], piece: u8[]): (__Conns, u8[], boolean) {
  match (next) {
    Some(t) => {
      return (__Conns { ...c, tails: c.tails.with(at, t) }, piece, true);
    },
    None => {
      return (__Conns { ...c, tails: c.tails.with(at, NoTail) }, piece, false);
    }
  }
  return (c, piece, false);
}

// __chunk_piece(drv, c, at, producer, index, end) — `__tail_piece` for a
// chunk tail: the producer asked for chunk `index` and on, past any
// empty chunk, as a task.
function __chunk_piece[D: async.Driver](drv: D, c: __Conns, at: i32, producer: ChunkProducer, index: i32, end: string): (__Conns, u8[], boolean) {
  let none: u8[] = [];
  let next: (i32) => Option[u8[]] = producer.next;
  let i: i32 = index;
  while (true) {
    let t: async.Task[Option[u8[]]] = async.task_new((): Option[u8[]] => next(i));
    match (async.task_start(t)) {
      Done(chunk) => {
        async.task_free(t);
        let step: (__Tail, u8[], boolean) = __chunk_step(producer, i, end, chunk);
        if (step.2) {
          return (__Conns { ...c, tails: c.tails.with(at, step.0) }, step.1, true);
        }
      },
      Suspended(w) => {
        return (__tail_park(drv, c, at, producer, i, end, t, w), none, true);
      },
      Cancelled => {
        async.task_free(t);
        return (__tail_drop(c, at), none, false);
      }
    }
    i = i + 1;
  }
  return (c, none, true);
}

// __chunk_step(producer, index, end, chunk) — the tail after the producer
// answered `chunk` for `index`, the piece that goes on the wire for it
// (under its hexadecimal size and CRLF when the tail is chunk-coded,
// `end` holding what ends it; as it is when close-delimited), and
// whether there is one: an empty chunk writes nothing, and the next is
// asked for.
function __chunk_step(producer: ChunkProducer, index: i32, end: string, chunk: Option[u8[]]): (__Tail, u8[], boolean) {
  match (chunk) {
    Some(bytes) => {
      let tail: __Tail = ChunkTail(producer, index + 1, end);
      if (bytes.len() == 0) {
        return (tail, bytes, false);
      }
      return (tail, __chunk_framed(bytes, end), true);
    },
    None => {
      return (NoTail, end.bytes(), true);
    }
  }
  return (NoTail, end.bytes(), true);
}

// __chunk_framed(bytes, end) — the chunk as it goes on the wire: under
// its hexadecimal size and CRLF when the tail is chunk-coded (`end`
// holds what ends it), as it is when close-delimited.
function __chunk_framed(bytes: u8[], end: string): u8[] {
  if (end.len() == 0) {
    return bytes;
  }
  return (int.int_to_string_radix(bytes.len(), 16) + "\r\n").bytes().concat(bytes).concat("\r\n".bytes());
}

// __idle_due(producer, now) — when the producer's filler is next due,
// -1 for a producer with none.
function __idle_due(producer: ChunkProducer, now: i64): i64 {
  if (producer.idle_ms <= 0 || producer.filler.len() == 0) {
    return 0 - 1 as i64;
  }
  return now + producer.idle_ms as i64 * 1000000;
}

// __flight_filler(drv, c, fls, fi, opts) — the filler of the producer
// parked as flight `fi` written, its tail still parked, and the next one
// scheduled; nothing while bytes are still going out, since the peer is
// receiving then. A write the kernel refuses closes the connection and
// cancels the flight.
function __flight_filler[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], fi: i32, opts: Config): (__Conns, __Flight[]) {
  let fl: __Flight = fls[fi];
  let at: i32 = __conns_index(c, fl.fd);
  if (at < 0) {
    return (c, fls.with(fi, __Flight { ...fl, idle: 0 - 1 as i64 }));
  }
  let piece: u8[] = [];
  match (c.tails[at]) {
    ParkedTail(producer, _, end) => {
      piece = __chunk_framed(producer.filler, end);
      fls = fls.with(fi, __Flight { ...fl, idle: __idle_due(producer, monotonic_ns()) });
    },
    _ => {
      return (c, fls.with(fi, __Flight { ...fl, idle: 0 - 1 as i64 }));
    }
  }
  if (c.pending[at].len() > 0) {
    return (c, fls);
  }
  let sent: (__Conns, __Sent) = __serve_send(drv, c, at, piece, opts);
  match (sent.1) {
    Failed => {
      __flight_cancel(drv, fls[fi]);
      return (__serve_close(drv, sent.0, at), __flights_remove(fls, fi));
    },
    _ => {
      return (sent.0, fls);
    }
  }
  return (sent.0, fls);
}

// __tail_park(drv, c, at, producer, index, end, t, w) — the producer's
// task `t`, parked on `w` for chunk `index`, held as a flight staged on
// the connections for the loop to take, the tail marked parked, and the
// connection watched for reads only (a hang-up ends the flight; its
// bytes are the next request's) under no deadline, since nothing is
// owed until the chunk comes. On an upgraded connection the flight
// carries the lent body instead, the read side being the session's.
function __tail_park[D: async.Driver](drv: D, c: __Conns, at: i32, producer: ChunkProducer, index: i32, end: string, t: async.Task[Option[u8[]]], w: async.Wait): __Conns {
  let none: i32[] = [];
  let now: i64 = monotonic_ns();
  let fl: __Flight = __flight_watch(drv, __Flight { job: Producer(t), wait: w, fd: c.fds[at], set: none, due: 0 - 1 as i64, method: "", version: "", kept: false, behind: Idle, body: __pulling(c, at), idle: __idle_due(producer, now), ends: 0 - 1 as i64 }, now);
  match (c.framing[at]) {
    Pulling(b) => {},
    _ => {
      drv.watch(c.fds[at], 1);
    }
  }
  return __Conns { ...c, tails: c.tails.with(at, ParkedTail(producer, index, end)), deadlines: c.deadlines.with(at, __held_deadline()), parked: c.parked.append(fl) };
}

// __producer_done(drv, c, fd, chunk, opts, clk) — the producer parked on
// connection `fd` answered `chunk`: the piece written and the tail
// produced on, as the drain of a writable connection does, a request
// buffered behind the response left as the connection's backlog; a
// connection that went away meanwhile drops it.
function __producer_done[D: async.Driver](drv: D, c: __Conns, fd: i32, chunk: Option[u8[]], opts: Config, clk: __Clock): __Conns {
  let at: i32 = __conns_index(c, fd);
  if (at < 0) {
    return c;
  }
  let piece: u8[] = [];
  match (c.tails[at]) {
    ParkedTail(producer, index, end) => {
      let step: (__Tail, u8[], boolean) = __chunk_step(producer, index, end, chunk);
      c = __Conns { ...c, tails: c.tails.with(at, step.0) };
      piece = step.1;
    },
    _ => {
      return c;
    }
  }
  if (piece.len() > 0) {
    let sent: (__Conns, __Sent) = __serve_send(drv, c, at, piece, opts);
    c = sent.0;
    match (sent.1) {
      Partial => {
        return c;
      },
      Failed => {
        return __serve_close(drv, c, at);
      },
      Whole => {}
    }
  }
  let drained: (__Conns, i32) = __serve_drain(drv, c, at, opts, clk);
  c = drained.0;
  if (drained.1 >= 0) {
    return __Conns { ...c, backlog: c.backlog.with(drained.1, true) };
  }
  return c;
}

// __staged_taken(drv, c, fls, opts) — what the event's work staged, taken
// once it is done: the flights a producer's park staged, and the
// background work of the responses it wrote, each started as a task, one
// that parks held as a flight under `Config.background_deadline`.
function __staged_taken[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], opts: Config): (__Conns, __Flight[]) {
  let taken: (__Conns, __Flight[]) = __parked_taken(c, fls);
  c = taken.0;
  fls = taken.1;
  if (c.later.len() == 0) {
    return (c, fls);
  }
  let work: (() => void)[] = c.later;
  let none: (() => void)[] = [];
  c = __Conns { ...c, later: none };
  for w in work {
    fls = __background_start(drv, fls, w, opts);
  }
  return (c, fls);
}

// __background_start(drv, fls, work, opts) — `work` run as a task: done
// at once, or parked and held as a flight on no connection until it ends
// or `Config.background_deadline` cancels it.
function __background_start[D: async.Driver](drv: D, fls: __Flight[], work: () => void, opts: Config): __Flight[] {
  let t: async.Task[i32] = async.task_new((): i32 => __background_run(work));
  match (async.task_start(t)) {
    Suspended(w) => {
      let none: i32[] = [];
      let now: i64 = monotonic_ns();
      return fls.append(__flight_watch(drv, __Flight { job: Background(t), wait: w, fd: 0 - 1, set: none, due: 0 - 1 as i64, method: "", version: "", kept: false, behind: Idle, body: None, idle: 0 - 1 as i64, ends: __bound_ends(opts.background_deadline, now) }, now));
    },
    _ => {
      async.task_free(t);
    }
  }
  return fls;
}

function __background_run(work: () => void): i32 {
  work();
  return 0;
}

// __serve_count(c, at, method, status) — the request answered on the
// connection at `at` counted: its duration from the request's clock
// (`rate_since[at]`, running since its header block was complete), by
// method and status. The metrics' cells take the count in place; the table
// is only rebuilt when a method and status pair is seen for the first time.
function __serve_count(c: __Conns, at: i32, method: string, status: i32): __Conns {
  let m: metrics.ServerMetrics = c.metrics;
  let grown: metrics.ServerMetrics = m.request(method, status, monotonic_ns() - c.rate_since[at]);
  if (grown.methods.len() == m.methods.len()) {
    return c;
  }
  return __Conns { ...c, metrics: grown };
}

// __stage_background(c, resp) — the response's background work staged for
// the loop to start once the event is done (`__staged_taken`).
function __stage_background(c: __Conns, resp: HttpResponse): __Conns {
  match (resp.background) {
    Some(work) => {
      return __Conns { ...c, later: c.later.append(work) };
    },
    None => {
      return c;
    }
  }
  return c;
}

// __parked_taken(c, fls) — the flights a producer's park staged on the
// connections, moved to the loop's.
function __parked_taken(c: __Conns, fls: __Flight[]): (__Conns, __Flight[]) {
  if (c.parked.len() == 0) {
    return (c, fls);
  }
  let none: __Flight[] = [];
  return (__Conns { ...c, parked: none }, fls.concat(c.parked));
}

function __conns_index(c: __Conns, fd: i32): i32 {
  let i: i32 = 0;
  while (i < c.fds.len()) {
    if (c.fds[i] == fd) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

// A TLS connection starts with `keep` set: its handshake may leave bytes
// pending, and a connection that has drained its pending bytes is closed
// unless it persists.
function __conns_add(c: __Conns, fd: i32, deadline: i64, peer: i32, host: platform.Host, tls: __Tls): __Conns {
  let empty: u8[] = [];
  let keep: boolean = false;
  match (tls) {
    Secured(_) => {
      keep = true;
    },
    Awaiting(next, _) => {
      match (next) {
        Some(_) => {
          keep = true;
        },
        None => {}
      }
    },
    _ => {}
  }
  return __Conns { fds: c.fds.append(fd), bufs: c.bufs.append(empty), offs: c.offs.append(0), pending: c.pending.append(empty), deadlines: c.deadlines.append(deadline), keep: c.keep.append(keep), served: c.served.append(0), backlog: c.backlog.append(false), continued: c.continued.append(false), rate_since: c.rate_since.append(0 - 1 as i64), rate_base: c.rate_base.append(0), send_since: c.send_since.append(0 - 1 as i64), send_base: c.send_base.append(0), peers: c.peers.append(peer), hosts: c.hosts.append(host), tails: c.tails.append(NoTail), tls: c.tls.append(tls), framing: c.framing.append(Http1), last: c.last, out: c.out, lent: c.lent, parked: c.parked, later: c.later, metrics: c.metrics };
}

// __conns_from_peer(c, peer) — how many open connections the peer holds.
function __conns_from_peer(c: __Conns, peer: i32): i32 {
  let n: i32 = 0;
  for p in c.peers {
    if (p == peer) {
      n = n + 1;
    }
  }
  return n;
}

function __conns_remove(c: __Conns, at: i32): __Conns {
  let fds: i32[] = [];
  let bufs: u8[][] = [];
  let offs: i32[] = [];
  let pending: u8[][] = [];
  let deadlines: i64[] = [];
  let keep: boolean[] = [];
  let served: i32[] = [];
  let backlog: boolean[] = [];
  let continued: boolean[] = [];
  let rate_since: i64[] = [];
  let rate_base: i32[] = [];
  let send_since: i64[] = [];
  let send_base: i32[] = [];
  let peers: i32[] = [];
  let hosts: platform.Host[] = [];
  let tails: __Tail[] = [];
  let tls: __Tls[] = [];
  let framing: __Framing[] = [];
  let i: i32 = 0;
  while (i < c.fds.len()) {
    if (i != at) {
      fds = fds.append(c.fds[i]);
      bufs = bufs.append(c.bufs[i]);
      offs = offs.append(c.offs[i]);
      pending = pending.append(c.pending[i]);
      deadlines = deadlines.append(c.deadlines[i]);
      keep = keep.append(c.keep[i]);
      served = served.append(c.served[i]);
      backlog = backlog.append(c.backlog[i]);
      continued = continued.append(c.continued[i]);
      rate_since = rate_since.append(c.rate_since[i]);
      rate_base = rate_base.append(c.rate_base[i]);
      send_since = send_since.append(c.send_since[i]);
      send_base = send_base.append(c.send_base[i]);
      peers = peers.append(c.peers[i]);
      hosts = hosts.append(c.hosts[i]);
      tails = tails.append(c.tails[i]);
      tls = tls.append(c.tls[i]);
      framing = framing.append(c.framing[i]);
    }
    i = i + 1;
  }
  return __Conns { fds: fds, bufs: bufs, offs: offs, pending: pending, deadlines: deadlines, keep: keep, served: served, backlog: backlog, continued: continued, rate_since: rate_since, rate_base: rate_base, send_since: send_since, send_base: send_base, peers: peers, hosts: hosts, tails: tails, tls: tls, framing: framing, last: c.last, out: c.out, lent: 0 - 1, parked: c.parked, later: c.later, metrics: c.metrics };
}

// __conns_timeout(c, now) — the wait's timeout: the milliseconds until the
// earliest read deadline (0 once one is due, or while a connection has a
// request its event's burst left unanswered), or -1 with nothing open.
function __conns_timeout(c: __Conns, now: i64): i32 {
  for b in c.backlog {
    if (b) {
      return 0;
    }
  }
  let best: i64 = -(1 as i64);
  for d in c.deadlines {
    if (best < 0 as i64 || d < best) {
      best = d;
    }
  }
  if (best < 0 as i64) {
    return -1;
  }
  if (best <= now) {
    return 0;
  }
  let ms: i64 = (best - now + 999999 as i64) / 1000000;
  if (ms > 2147483647 as i64) {
    return 2147483647;
  }
  return ms as i32;
}

// __serve_accept(drv, listener, c, opts, host_for) — one accepted connection,
// its handlers' platform `host_for` its peer, built once for the
// connection rather than per request,
// non-blocking and watched for reads; a refused watch closes it again,
// and so does a peer already holding `max_connections_per_ip` of them.
// wasm has no non-blocking mode to switch on and its reads never block.
function __serve_accept[D: async.Driver](drv: D, listener: i32, c: __Conns, opts: Config, host_for: (Option[net.SocketAddr]) => platform.Host): __Conns {
  let fd: i32 = tcp_accept(listener);
  if (fd < 0) {
    return c;
  }
  let peer: i32 = 0;
  if (opts.max_connections_per_ip > 0) {
    peer = tcp_socket_ctl(fd, 7, 0);
    if (peer != 0 && __conns_from_peer(c, peer) >= opts.max_connections_per_ip) {
      tcp_close(fd);
      return c;
    }
  }
  tcp_socket_ctl(fd, 3, 1);
  tcp_socket_ctl(fd, 1, 1);
  let tls: __Tls = Plain;
  match (__tls_session(opts)) {
    Ok(t) => {
      tls = t;
    },
    Err(_) => {
      tcp_close(fd);
      return c;
    }
  }
  if (opts.proxy_protocol) {
    tls = __awaiting(tls);
  }
  if (drv.watch(fd, 1) < 0) {
    tcp_close(fd);
    return c;
  }
  c.metrics.accepted.inc();
  c.metrics.open.inc();
  return __conns_add(c, fd, monotonic_ns() + opts.recv_deadline.as_nanos(), peer, host_for(__peer_of(fd)), tls);
}

// __peer_of(fd) — the connection's peer, which its handlers' platform
// answers `peer()` with.
function __peer_of(fd: i32): Option[net.SocketAddr] {
  match (net.peer_addr(fd)) {
    Ok(a) => {
      return Some(a);
    },
    Err(e) => {
      return None;
    }
  }
  return None;
}

// __tls_session(opts) — a fresh TLS session for a connection under
// `Config.tls`, or none without it.
function __tls_session(opts: Config): Result[__Tls, server.TlsError] {
  match (opts.tls) {
    Some(cfg) => {
      let offered: server.Config = cfg;
      if (opts.h2) {
        offered = cfg.with_alpn(["h2", "http/1.1"]);
      }
      let sess: server.Session = server.start(offered)?;
      return Ok(Secured(sess));
    },
    None => {
      return Ok(Plain);
    }
  }
  return Ok(Plain);
}

// __serve_close(drv, c, at) — the connection at `at` unwatched, closed
// and forgotten.
function __serve_close[D: async.Driver](drv: D, c: __Conns, at: i32): __Conns {
  drv.unwatch(c.fds[at]);
  c.metrics.open.dec();
  match (c.tls[at]) {
    Secured(sess) => {
      if let Ok(step) = sess.close() {
        tcp_send_bytes(c.fds[at], step.output);
      }
    },
    Lent => {
      __lent_closed(c, at);
    },
    _ => {}
  }
  tcp_close(c.fds[at]);
  return __conns_remove(__tail_drop(c, at), at);
}

// __serve_read(drv, c, at, scratch, opts) — the readable connection at `at`
// read until a read comes back short or nothing is queued: `(conns,
// done)`, where `done` says the peer is finished (EOF, an error, or the
// size cap) and what it sent is what the buffer holds. A read into an
// empty buffer lends the loop's scratch to the connection, shortened to
// the bytes read, so a request answered within the event is never copied;
// a second read takes the scratch back first, copying its bytes out, and
// so does `__serve_compact` once the event is done with the connection.
// The readiness is level-triggered, so a short read leaves nothing the
// next wait would not report. The first bytes of a request start its read
// deadline, replacing the keep-alive idle span an answered connection
// was waiting under, and the body's clock keeps the deadline no earlier
// than what the body has delivered buys (`__body_deadline`).
function __serve_read[D: async.Driver](drv: D, c: __Conns, at: i32, scratch: u8[], opts: Config): (__Conns, boolean) {
  match (c.tls[at]) {
    Secured(sess) => {
      return __serve_read_tls(drv, c, at, sess, scratch, opts);
    },
    Awaiting(next, head) => {
      return __serve_read_proxy(drv, c, at, next, head, scratch, opts);
    },
    _ => {
      return __serve_read_plain(c, at, scratch, opts);
    }
  }
  return __serve_read_plain(c, at, scratch, opts);
}

// __awaiting(t) — the TLS state `t` once a PROXY protocol header has come.
function __awaiting(t: __Tls): __Tls {
  let none: u8[] = [];
  match (t) {
    Secured(s) => {
      return Awaiting(Some(s), none);
    },
    _ => {
      return Awaiting(None, none);
    }
  }
  return Awaiting(None, none);
}

// __serve_read_proxy(drv, c, at, next, head, scratch, opts) — `__serve_read`
// on a connection owed its PROXY protocol header: the bytes kept aside
// from the request buffer until the header is whole, under the deadline
// the connection was accepted with; then its source the connection's peer
// and what follows it the connection's first bytes. A connection that does
// not start with a header, or whose header outgrows any real one, is
// finished with nothing to answer.
function __serve_read_proxy[D: async.Driver](drv: D, c: __Conns, at: i32, next: Option[server.Session], head: u8[], scratch: u8[], opts: Config): (__Conns, boolean) {
  let deadline: i64 = c.deadlines[at];
  let read: (__Conns, boolean) = __serve_read_plain(c, at, scratch, opts);
  let bytes: u8[] = head.concat(read.0.bufs[at]);
  let empty: u8[] = [];
  let lent: i32 = read.0.lent;
  if (lent == at) {
    lent = 0 - 1;
  }
  c = __Conns { ...read.0, bufs: read.0.bufs.with(at, empty), lent: lent, deadlines: read.0.deadlines.with(at, deadline) };
  match (forwarded.proxy_header(bytes, 0)) {
    HeaderRead(src, n) => {
      return __proxied(drv, c, at, next, src, __bytes_from(bytes, n), opts, read.1);
    },
    HeaderShort => {
      return (__Conns { ...c, tls: c.tls.with(at, Awaiting(next, bytes)) }, read.1 || bytes.len() > 65551);
    },
    HeaderBad => {
      return (c, true);
    }
  }
  return (c, true);
}

// __proxied(drv, c, at, next, src, rest, opts, done) — a connection whose
// PROXY protocol header has come: `src` its peer when the header named
// one, and `rest` its first bytes, through its TLS session when it has one.
function __proxied[D: async.Driver](drv: D, c: __Conns, at: i32, next: Option[server.Session], src: Option[net.SocketAddr], rest: u8[], opts: Config, done: boolean): (__Conns, boolean) {
  match (src) {
    Some(a) => {
      c = __Conns { ...c, hosts: c.hosts.with(at, c.hosts[at].with_peer(src)) };
    },
    None => {}
  }
  match (next) {
    Some(sess) => {
      let took: (__Conns, server.Session, u8[], boolean) = __tls_taken(drv, c, at, sess, rest[0:rest.len()], opts);
      return (__Conns { ...took.0, bufs: took.0.bufs.with(at, took.2), tls: took.0.tls.with(at, Secured(took.1)) }, done || took.3);
    },
    None => {
      return (__Conns { ...c, bufs: c.bufs.with(at, rest), tls: c.tls.with(at, Plain) }, done);
    }
  }
  return (c, done);
}

// __serve_read_plain(c, at, scratch, opts) — `__serve_read` on the socket's
// own bytes.
function __serve_read_plain(c: __Conns, at: i32, scratch: u8[], opts: Config): (__Conns, boolean) {
  let buf: u8[] = c.bufs[at];
  let was_idle: boolean = buf.len() == 0;
  let lent: i32 = c.lent;
  let done: boolean = false;
  let more: boolean = true;
  while (more) {
    if (lent == at) {
      buf = __bytes_from(buf, 0);
      lent = 0 - 1;
    }
    __arr_set_len(scratch, __recv_room());
    let n: i32 = tcp_recv_into(c.fds[at], scratch);
    if (n == 0 - __eagain()) {
      more = false;
    } else if (n <= 0) {
      more = false;
      done = true;
    } else {
      __arr_set_len(scratch, n);
      if (buf.len() == 0) {
        buf = scratch;
        lent = at;
      } else {
        buf = buf.concat(scratch);
      }
      // A connection holds at most the parser's largest request unread;
      // past that the peer is treated as finished: what is complete is
      // answered, then the connection is closed.
      if (buf.len() > http.http_request_bytes_cap(opts.limits)) {
        more = false;
        done = true;
      } else {
        more = n == __recv_room();
      }
    }
  }
  c = __Conns { ...c, bufs: c.bufs.with(at, buf), lent: lent };
  if (done) {
    return (c, true);
  }
  let deadline: i64 = c.deadlines[at];
  if (was_idle && buf.len() > 0) {
    deadline = monotonic_ns() + opts.recv_deadline.as_nanos();
  }
  c = __Conns { ...c, deadlines: c.deadlines.with(at, deadline) };
  return (__body_deadline(c, at, opts, monotonic_ns()), false);
}

// __serve_read_tls(drv, c, at, sess, scratch, opts) — `__serve_read` for a
// TLS connection: each read goes through the session, what the handshake
// answers is written at once (a short write pends it, as a response's),
// and the application data it yields is what the buffer gains; the
// peer's close_notify, a refused record and a failed write all finish
// the connection. The scratch is never lent: the plaintext is the
// session's own array.
function __serve_read_tls[D: async.Driver](drv: D, c: __Conns, at: i32, sess: server.Session, scratch: u8[], opts: Config): (__Conns, boolean) {
  let buf: u8[] = c.bufs[at];
  let was_idle: boolean = buf.len() == 0;
  let s: server.Session = sess;
  let done: boolean = false;
  let more: boolean = true;
  while (more) {
    __arr_set_len(scratch, __recv_room());
    let n: i32 = tcp_recv_into(c.fds[at], scratch);
    if (n == 0 - __eagain()) {
      more = false;
    } else if (n <= 0) {
      more = false;
      done = true;
    } else {
      let took: (__Conns, server.Session, u8[], boolean) = __tls_taken(drv, c, at, s, scratch[0:n], opts);
      c = took.0;
      s = took.1;
      buf = buf.concat(took.2);
      done = took.3;
      more = !done && n == __recv_room() && buf.len() <= http.http_request_bytes_cap(opts.limits);
      if (buf.len() > http.http_request_bytes_cap(opts.limits)) {
        done = true;
      }
    }
  }
  c = __Conns { ...c, bufs: c.bufs.with(at, buf), tls: c.tls.with(at, Secured(s)) };
  if (done) {
    return (c, true);
  }
  let deadline: i64 = c.deadlines[at];
  if (was_idle && buf.len() > 0) {
    deadline = monotonic_ns() + opts.recv_deadline.as_nanos();
  }
  c = __Conns { ...c, deadlines: c.deadlines.with(at, deadline) };
  return (__body_deadline(c, at, opts, monotonic_ns()), false);
}

// __tls_taken(drv, c, at, sess, raw, opts) — raw bytes off a TLS
// connection given to its session: `(conns, session, data, done)`, the
// plaintext they yielded and whether the connection is finished. What the
// session answers is written through `__serve_send_raw`; a failure's
// alert is written as far as the socket takes it.
function __tls_taken[D: async.Driver](drv: D, c: __Conns, at: i32, sess: server.Session, raw: [u8], opts: Config): (__Conns, server.Session, u8[], boolean) {
  let none: u8[] = [];
  match (sess.read(raw)) {
    Ok(step) => {
      let done: boolean = step.closed;
      if (step.output.len() > 0) {
        let sent: (__Conns, __Sent) = __serve_send_raw(drv, c, at, step.output, opts);
        c = sent.0;
        match (sent.1) {
          Failed => {
            done = true;
          },
          _ => {}
        }
      }
      return (c, step.session, step.data, done);
    },
    Err(f) => {
      tcp_send_bytes(c.fds[at], f.alert);
      return (c, sess, none, true);
    }
  }
  return (c, sess, none, true);
}

// __bytes_from(buf, from) — buf[from, len) as its own array: the bytes
// behind an answered request, the next pipelined request's, or the shared
// empty array.
function __bytes_from(buf: u8[], from: i32): u8[] {
  return __bytes_range(buf, from, buf.len());
}

// __bytes_range(buf, from, end) — buf[from, end) as a fresh array in one
// allocation, or the shared empty array when the range is empty. The
// caller keeps from <= end <= buf.len(): __alloc_u8 aborts on a negative
// size. std/http's __bytes_range is the same copy.
function __bytes_range(buf: u8[], from: i32, end: i32): u8[] {
  let out: u8[] = __alloc_u8(end - from);
  let i: i32 = 0;
  while (from + i < end) {
    out = out.with(i, buf[from + i]);
    i = i + 1;
  }
  return out;
}

// __Behind — what the bytes behind an answered request hold, as the loop
// carries it: a complete request (`Pipelined`, the request itself beside
// it), nothing complete yet (`Idle`), a request awaiting `100 Continue`
// (`Expecting`), or a malformed one and the status that refuses it
// (`Illformed`). The parse's own framing is taken apart into these at once:
// carried whole into the loop's tuples and flights, it would be the one
// box the parse builds, where every reader taking it apart has it returned
// in two words.
enum __Behind { Pipelined, Idle, Expecting, Illformed(i32) }

// __serve_behind(fr, none) — a parse's framing as the loop carries it:
// what is behind and the framed request, `none` when there is none. The
// caller passes a request it already holds for `none`, read only behind
// `Pipelined`: a fresh `http_framed_none()` would be three boxes per
// parse, and a field read off the connection table pins the table past
// its next rebuild.
function __serve_behind(fr: http.HttpFraming, none: http.HttpFramed): (__Behind, http.HttpFramed) {
  match (fr) {
    http.Framed(f) => {
      return (Pipelined, f);
    },
    http.Incomplete => {
      return (Idle, none);
    },
    http.Continue => {
      return (Expecting, none);
    },
    http.Malformed(status) => {
      return (Illformed(status), none);
    }
  }
  return (Idle, none);
}

// __tail_persists(behind, eof) — whether the connection outlives the
// response being decided, given what is behind the answered request: a
// malformed tail ends it, so the response says `close` and the close
// follows it; once the peer has finished sending, only another complete
// request keeps it open, so the last response on a half-closed connection
// says `close` too.
function __tail_persists(behind: __Behind, eof: boolean): boolean {
  match (behind) {
    Pipelined => {
      return true;
    },
    Idle => {
      return !eof;
    },
    Expecting => {
      return !eof;
    },
    Illformed(_) => {
      return false;
    }
  }
  return false;
}

// __serve_took(c, at, f, opts, eof) — the request behind the answered
// bytes consumed: the offset moved past it, the served count up, and
// whether the connection persists after this response decided (the
// request's own say, the per-connection request cap, and what the bytes
// behind it hold, per `__tail_persists`, and never once the loop is
// stopping): `(conns, keep_alive, behind, next)`, with `behind` and
// `next` the one parse of the bytes behind the request, which the
// response and the next turn of the loop read rather than parse again.
function __serve_took(c: __Conns, at: i32, f: http.HttpFramed, opts: Config, eof: boolean, stop: __Stop): (__Conns, boolean, __Behind, http.HttpFramed) {
  let served: i32 = c.served[at] + 1;
  let keep: boolean = f.keep_alive && served < opts.keep_alive_requests && !__serve_stopping(stop);
  c = __Conns { ...c, offs: c.offs.with(at, c.offs[at] + f.len), served: c.served.with(at, served), backlog: c.backlog.with(at, false), continued: c.continued.with(at, false), last: http.http_framed_kept(f) };
  let parsed: (__Behind, http.HttpFramed) = __serve_behind(http.http_parse_request_framed_from(c.bufs[at], c.offs[at], opts.limits, c.last), f);
  if (keep) {
    keep = __tail_persists(parsed.0, eof);
  }
  return (__Conns { ...c, keep: c.keep.with(at, keep) }, keep, parsed.0, parsed.1);
}

// __serve_compact(c, at) — the bytes the event's answered requests
// occupied dropped, once, when the event is done with the connection; a
// connection lent the scratch keeps a copy of what is left, which is the
// shared empty array once everything read was answered.
function __serve_compact(c: __Conns, at: i32): __Conns {
  if (c.lent == at) {
    return __Conns { ...c, bufs: c.bufs.with(at, __bytes_from(c.bufs[at], c.offs[at])), offs: c.offs.with(at, 0), lent: 0 - 1 };
  }
  if (c.offs[at] == 0) {
    return c;
  }
  return __Conns { ...c, bufs: c.bufs.with(at, __bytes_from(c.bufs[at], c.offs[at])), offs: c.offs.with(at, 0) };
}

// __pipeline_burst() — how many pipelined requests one readiness event
// answers before the loop returns to the wait, so one connection's
// pipeline cannot hold every other client off the reactor. What is left
// is the connection's backlog, answered on the next wait.
function __pipeline_burst(): i32 {
  return 32;
}

// __serve_next(c, at, opts) — an answered connection with nothing left
// to answer, and the deadline it waits under: the idle span once its
// buffer is empty, the read deadline while a partial request holds
// bytes in it. The deadline bounds the wait for the peer, not the
// handlers run before it, so a partial request's clock starts here
// rather than at its first byte, which may have arrived a burst ago;
// the body's clock starts over with it.
function __serve_next(c: __Conns, at: i32, opts: Config): __Conns {
  let now: i64 = monotonic_ns();
  let span: Duration = opts.keep_alive_idle;
  if (c.bufs[at].len() > c.offs[at]) {
    span = opts.recv_deadline;
  }
  c = __Conns { ...c, deadlines: c.deadlines.with(at, now + span.as_nanos()), rate_since: c.rate_since.with(at, 0 - 1 as i64) };
  return __body_deadline(c, at, opts, now);
}

// __body_deadline(c, at, opts, now) — the connection's deadline held no
// earlier than its body has earned: the body's clock starts when the
// request's header block is found complete, and from then the request
// may take the grace plus what its bytes since buy at the minimum rate.
// A body that keeps flowing outlasts the read deadline; one that stalls
// or trickles does not.
function __body_deadline(c: __Conns, at: i32, opts: Config, now: i64): __Conns {
  let since: i64 = c.rate_since[at];
  let base: i32 = c.rate_base[at];
  let buf: u8[] = c.bufs[at];
  if (since < 0 as i64) {
    if (buf.len() <= c.offs[at] || !http.http_header_block_complete(buf, c.offs[at], opts.limits)) {
      return c;
    }
    since = now;
    base = buf.len();
  }
  let earned: i64 = since + opts.data_rate_grace.as_nanos();
  if (opts.min_data_rate > 0) {
    earned = earned + (buf.len() - base) as i64 * (1000000000 as i64) / (opts.min_data_rate as i64);
  }
  let deadline: i64 = c.deadlines[at];
  if (earned > deadline) {
    deadline = earned;
  }
  return __Conns { ...c, deadlines: c.deadlines.with(at, deadline), rate_since: c.rate_since.with(at, since), rate_base: c.rate_base.with(at, base) };
}

// __serve_ready(drv, c, at, opts, behind) — a persisting connection whose
// response has gone out whole, given the framing of what it has buffered:
// `(conns, more)`, `more` when a complete request is buffered, for the
// loop to answer now; a connection with a request to answer is not
// waiting on the peer, so its deadline is left alone. Less than a request
// waits under `__serve_next`'s deadline, and a malformed one is refused
// now: no bytes could complete it.
function __serve_ready[D: async.Driver](drv: D, c: __Conns, at: i32, opts: Config, behind: __Behind, clk: __Clock): (__Conns, boolean) {
  match (behind) {
    Pipelined => {
      return (c, true);
    },
    Idle => {
      return (__serve_next(c, at, opts), false);
    },
    Expecting => {
      return (__serve_continue(drv, c, at, opts), false);
    },
    Illformed(status) => {
      return (__serve_refuse(drv, c, at, status, opts, clk), false);
    }
  }
  return (c, false);
}

// __serve_continue(drv, c, at, opts) — a request whose header block asks
// for `100 Continue` before its body is sent (RFC 9110 §10.1.1): the
// interim response, once per request, then the wait for the body under
// `__serve_next`'s deadline. A short write leaves the rest pending, to be
// finished by a later wait, and the connection is kept for the request
// it is still reading; a refused write closes it.
function __serve_continue[D: async.Driver](drv: D, c: __Conns, at: i32, opts: Config): __Conns {
  if (c.continued[at]) {
    return __serve_next(c, at, opts);
  }
  c = __Conns { ...c, continued: c.continued.with(at, true), keep: c.keep.with(at, true) };
  buf_push(c.out, "HTTP/1.1 100 Continue\r\n\r\n");
  let sent: (__Conns, __Sent) = __serve_send_out(drv, c, at, opts);
  match (sent.1) {
    Partial => {
      return sent.0;
    },
    Failed => {
      return __serve_close(drv, sent.0, at);
    },
    Whole => {
      return __serve_next(sent.0, at, opts);
    }
  }
  return sent.0;
}

// __serve_refuse(drv, c, at, status, opts) — the loop's own answer to a
// malformed request: `status` with an empty body and `Connection:
// close`, then the close. A short write leaves the rest pending, to be
// finished by a later wait, which closes the connection once it has gone
// out; a refused write closes it now.
function __serve_refuse[D: async.Driver](drv: D, c: __Conns, at: i32, status: i32, opts: Config, clk: __Clock): __Conns {
  c = __Conns { ...c, metrics: c.metrics.request("", status, 0 as i64) };
  __serve_wire(c.out, "GET", "HTTP/1.1", http.text(status, ""), false, clk);
  let sent: (__Conns, __Sent) = __serve_send_out(drv, __Conns { ...c, keep: c.keep.with(at, false) }, at, opts);
  match (sent.1) {
    Partial => {
      return sent.0;
    },
    Failed => {
      return __serve_close(drv, sent.0, at);
    },
    Whole => {
      return __serve_close(drv, sent.0, at);
    }
  }
  return sent.0;
}

// __serve_respond(drv, c, at, method, version, resp, keep_alive, opts,
// answered, behind, clk) — the response `resp` to a `method` request under
// `version`, counted in the loop's metrics from the request's start
// (`starts[at]`), written into the loop's builder (`__serve_wire`), sent, and
// the connection's next state, given the framing of the bytes behind the
// answered request: `(conns, more)`, where `more` says the connection
// persists with its next request already buffered, so the loop answers it
// now. A short write leaves the rest pending, to be
// finished by a later wait (`__serve_drain`); a write the kernel refuses
// closes the connection; a finished write closes a connection that does
// not persist; and the `answered`th response of one event ends the
// event's burst, leaving a request still buffered as the connection's
// backlog. The responses of one burst are corked: the builder keeps what
// the burst has answered and not yet written, in front of this response,
// so one readable event's answers leave in one write (`__corks`).
function __serve_respond[D: async.Driver](drv: D, c: __Conns, at: i32, method: string, version: string, resp: HttpResponse, keep_alive: boolean, opts: Config, answered: i32, behind: __Behind, clk: __Clock): (__Conns, boolean) {
  c = __serve_count(c, at, method, resp.status);
  c = __stage_background(c, resp);
  let rest: __Tail = __serve_wire(c.out, method, version, resp, keep_alive, clk);
  c = __Conns { ...c, tails: c.tails.with(at, rest), keep: c.keep.with(at, c.keep[at] && keep_alive && __tail_keeps(rest)) };
  if (__corks(rest, c.keep[at], answered, behind)) {
    return (c, true);
  }
  let sent: (__Conns, __Sent) = __serve_send_out(drv, c, at, opts);
  c = sent.0;
  match (sent.1) {
    Partial => {
      return (c, false);
    },
    Failed => {
      return (__serve_close(drv, c, at), false);
    },
    Whole => {}
  }
  let produced: (__Conns, __Sent) = __serve_produce(drv, c, at, opts);
  c = produced.0;
  match (produced.1) {
    Partial => {
      return (c, false);
    },
    Failed => {
      return (__serve_close(drv, c, at), false);
    },
    Whole => {}
  }
  if (!c.keep[at]) {
    return (__serve_close(drv, c, at), false);
  }
  let ready: (__Conns, boolean) = __serve_ready(drv, c, at, opts, behind, clk);
  c = ready.0;
  if (!ready.1) {
    return (c, false);
  }
  if (answered >= __pipeline_burst()) {
    return (__Conns { ...c, backlog: c.backlog.with(at, true) }, false);
  }
  return (c, true);
}

// __corks(rest, persists, answered, behind) — whether a response waits to
// go out with the next one: a whole response (no tail to produce) on a
// persisting connection whose next request is already framed and inside
// the burst. That request's response is then written by this burst, so
// nothing corked outlives the event, and no other write (an interim
// `100 Continue`, a refusal) can come between.
function __corks(rest: __Tail, persists: boolean, answered: i32, behind: __Behind): boolean {
  if (!persists || answered >= __pipeline_burst()) {
    return false;
  }
  match (rest) {
    NoTail => {},
    _ => {
      return false;
    }
  }
  match (behind) {
    Pipelined => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// __serve_drain(drv, c, at, opts) — a writable connection with a response
// still pending: the rest written and the next piece of its tail
// produced, and `(conns, at)` once it has gone out whole on a
// persisting connection with a request buffered behind it, watched for
// reads again; `(conns, -1)` while it is still draining, when the
// connection waits for its next request, or when it is closed (the write
// failed, the connection does not persist, or the reactor refused to
// watch it again).
function __serve_drain[D: async.Driver](drv: D, c: __Conns, at: i32, opts: Config, clk: __Clock): (__Conns, i32) {
  let sent: (__Conns, __Sent) = __serve_send_raw(drv, c, at, c.pending[at], opts);
  c = sent.0;
  match (sent.1) {
    Partial => {
      return (c, -1);
    },
    Failed => {
      return (__serve_close(drv, c, at), -1);
    },
    Whole => {}
  }
  let produced: (__Conns, __Sent) = __serve_produce(drv, __Conns { ...c, pending: c.pending.with(at, []) }, at, opts);
  c = produced.0;
  match (produced.1) {
    Partial => {
      return (c, -1);
    },
    Failed => {
      return (__serve_close(drv, c, at), -1);
    },
    Whole => {}
  }
  if (!c.keep[at]) {
    return (__serve_close(drv, c, at), -1);
  }
  if (drv.watch(c.fds[at], 1) < 0) {
    return (__serve_close(drv, c, at), -1);
  }
  let parsed: (__Behind, http.HttpFramed) = __serve_behind(http.http_parse_request_framed_from(c.bufs[at], c.offs[at], opts.limits, c.last), c.last);
  let ready: (__Conns, boolean) = __serve_ready(drv, __Conns { ...c, pending: c.pending.with(at, []) }, at, opts, parsed.0, clk);
  if (!ready.1) {
    return (ready.0, -1);
  }
  return (ready.0, at);
}

// === HTTP/2 ================================================================

const H2_NOT: i32 = 0;

const H2_SERVED: i32 = 1;

const H2_AWAITED: i32 = 2;

// __h2_mode(c, at, opts) — whether the connection at `at` is served over
// HTTP/2: it already is; or, with `Config.h2`, a fresh connection whose
// first bytes are the connection preface (RFC 9113 §3.4), which is awaited
// while the bytes so far are a prefix of it.
function __h2_mode(c: __Conns, at: i32, opts: Config): i32 {
  match (c.framing[at]) {
    Http2(conn) => {
      return H2_SERVED;
    },
    _ => {}
  }
  if (!opts.h2 || c.served[at] > 0) {
    return H2_NOT;
  }
  let buf: u8[] = c.bufs[at];
  let from: i32 = c.offs[at];
  let want: u8[] = h2.preface();
  let i: i32 = 0;
  while (i < want.len() && from + i < buf.len()) {
    if (buf[from + i] != want[i]) {
      return H2_NOT;
    }
    i = i + 1;
  }
  if (buf.len() - from < want.len()) {
    return H2_AWAITED;
  }
  return H2_SERVED;
}

// __h2_config(opts) — the HTTP/2 connection's bounds from the loop's.
function __h2_config(opts: Config): h2.Config {
  return h2.Config { ...h2.config(), max_header_list: opts.limits.header_bytes, max_body: opts.limits.body, max_concurrent_streams: opts.max_in_flight };
}

// __serve_h2(drv, c, at, handler, opts, eof) — an HTTP/2 connection's
// turn: the bytes read go into its state machine (a new one for a
// connection that just sent the preface, with the server's SETTINGS
// first), each request it hands over runs the handler and is answered on
// its stream, and what the connection has to say goes out through the
// loop's write path, pending bytes and all. The connection closes once
// the state machine has closed it, or the peer has finished.
function __serve_h2[D: async.Driver](drv: D, c: __Conns, at: i32, handler: (HttpRequest, platform.Host) => HttpResponse, opts: Config, eof: boolean): __Conns {
  let opened: h2.Step = __h2_opened(c, at, opts);
  let conn: h2.Conn = opened.conn;
  let out: u8[] = opened.output;
  let bytes: u8[] = __bytes_from(c.bufs[at], c.offs[at]);
  let lent: i32 = c.lent;
  if (lent == at) {
    lent = 0 - 1;
  }
  c = __Conns { ...c, bufs: c.bufs.with(at, []), offs: c.offs.with(at, 0), lent: lent };
  let step: h2.Step = conn.read(bytes);
  out = out.concat(step.output);
  let answered: __H2Answered = __h2_answered(step.conn, step.events, c, at, handler);
  conn = answered.conn;
  c = __Conns { ...answered.conns, framing: answered.conns.framing.with(at, Http2(conn)), keep: answered.conns.keep.with(at, !conn.closed() && !eof) };
  out = out.concat(answered.out);
  if (out.len() > 0) {
    let sent: (__Conns, __Sent) = __serve_send(drv, c, at, out, opts);
    c = sent.0;
    match (sent.1) {
      Partial => {
        return c;
      },
      Failed => {
        return __serve_close(drv, c, at);
      },
      Whole => {}
    }
  }
  if (conn.closed() || eof) {
    return __serve_close(drv, c, at);
  }
  return __serve_next(c, at, opts);
}

// __h2_opened(c, at, opts) — the connection's HTTP/2 state machine, or a
// new one with the SETTINGS it opens with for a connection that just sent
// the preface.
function __h2_opened(c: __Conns, at: i32, opts: Config): h2.Step {
  match (c.framing[at]) {
    Http2(open) => {
      return h2.Step { conn: open, output: [], events: [] };
    },
    _ => {
      return h2.server(__h2_config(opts));
    }
  }
  return h2.server(__h2_config(opts));
}

// __H2Answered — the connection after its requests were answered, the
// loop's table with the requests counted, and the bytes to send.
struct __H2Answered { conn: h2.Conn, conns: __Conns, out: u8[] }

// __h2_answered(conn, events, c, at, handler) — every request the step
// handed over run through the handler and answered on its stream, and
// counted as the loop counts HTTP/1.1 requests.
function __h2_answered(conn: h2.Conn, events: h2.Event[], c: __Conns, at: i32, handler: (HttpRequest, platform.Host) => HttpResponse): __H2Answered {
  let out: u8[] = [];
  let next: h2.Conn = conn;
  let conns: __Conns = c;
  for e in events {
    match (e) {
      h2.Request(stream, req) => {
        conns = __serve_started(conns, at);
        let resp: HttpResponse = handler(req, conns.hosts[at]);
        conns = __serve_count(conns, at, req.method, resp.status);
        let step: h2.Step = next.respond(stream, resp);
        next = step.conn;
        out = out.concat(step.output);
      },
      _ => {}
    }
  }
  return __H2Answered { conn: next, conns: conns, out: out };
}

// __serve_eof(drv, c, at, opts, clk) — the peer has finished sending: a
// response still draining goes out and then closes the connection; a
// request the peer left incomplete is answered 400 and closed; anything
// else closes it now.
function __serve_eof[D: async.Driver](drv: D, c: __Conns, at: i32, opts: Config, clk: __Clock): __Conns {
  if (__in_flight(c, at)) {
    return __Conns { ...c, keep: c.keep.with(at, false) };
  }
  if (__holds_request(__bytes_from(c.bufs[at], c.offs[at]))) {
    return __serve_refuse(drv, c, at, 400, opts, clk);
  }
  return __serve_close(drv, c, at);
}

// __holds_request(buf) — whether `buf` holds the start of a request: any
// byte but the blank lines a client may send between requests.
function __holds_request(buf: u8[]): boolean {
  for b in buf {
    if (b != 13 as u8 && b != 10 as u8) {
      return true;
    }
  }
  return false;
}

// __serve_event(drv, c, fd, scratch, opts) — one readiness event on the
// connection `fd`, brought to where its buffered requests can be answered:
// `(conns, at, eof)`, with `at` the connection's position, or -1 when this
// event ends with nothing to answer (an unknown descriptor, a response still
// draining, a connection closed once it drained, a readiness whose read
// brought no bytes and no backlog to answer), and `eof` when the peer has
// finished sending.
function __serve_event[D: async.Driver](drv: D, c: __Conns, fd: i32, scratch: u8[], opts: Config, clk: __Clock): (__Conns, i32, boolean) {
  let at: i32 = __conns_index(c, fd);
  if (at < 0) {
    return (c, -1, false);
  }
  if (__in_flight(c, at)) {
    let drained: (__Conns, i32) = __serve_drain(drv, c, at, opts, clk);
    return (drained.0, drained.1, false);
  }
  let had: i32 = c.bufs[at].len();
  let backlog: boolean = c.backlog[at];
  let read: (__Conns, boolean) = __serve_read(drv, c, at, scratch, opts);
  if (!read.1 && !backlog && read.0.bufs[at].len() == had) {
    return (read.0, -1, false);
  }
  return (read.0, at, read.1);
}

// __serve_finish(drv, c, fd, eof, opts, clk) — after an event's requests are
// answered: the answered bytes dropped, and a peer that has finished sending
// closed, once anything still draining has gone out (`__serve_eof`). A connection whose
// burst left a request buffered is not closed yet: the backlog answers
// it on the next wait, whose read sees the end of stream again.
function __serve_finish[D: async.Driver](drv: D, c: __Conns, fd: i32, eof: boolean, opts: Config, clk: __Clock): __Conns {
  let at: i32 = __conns_index(c, fd);
  if (at < 0) {
    return c;
  }
  c = __serve_compact(c, at);
  if (!eof || c.backlog[at]) {
    return c;
  }
  return __serve_eof(drv, c, at, opts, clk);
}

// __with_backlog(c, events) — the wait's events with one more for every
// connection whose burst left a request buffered and that the wait did
// not report itself, so the loop answers the backlog on this pass
// without the peer having to send anything, and once per pass.
function __with_backlog(c: __Conns, own events: i32[]): i32[] {
  let n: i32 = async.ready_pairs(events);
  let reported: i32 = n * 2;
  let i: i32 = 0;
  while (i < c.fds.len()) {
    if (c.backlog[i] && !__reported(events, reported, c.fds[i])) {
      if (n * 2 + 1 < events.len()) {
        events = events.with(n * 2, c.fds[i]).with(n * 2 + 1, 0);
      } else {
        events = events.append(c.fds[i]).append(0);
      }
      n = n + 1;
    }
    i = i + 1;
  }
  return async.end_pairs(events, n);
}

// __reported(events, n, fd) — whether `fd` is among the first `n` entries
// of the wait's (fd, readiness) pairs.
function __reported(events: i32[], n: i32, fd: i32): boolean {
  let k: i32 = 0;
  while (k + 1 < n) {
    if (events[k] == fd) {
      return true;
    }
    k = k + 2;
  }
  return false;
}

// __Sent — how far a write got: the kernel took it all, keeps the rest
// as the connection's pending bytes, or refused it.
enum __Sent { Whole, Partial, Failed }

// __serve_send(drv, c, at, payload, opts) — the response written to
// the connection at `at`: `(conns, sent)`. A short write keeps the rest
// as the connection's pending bytes, watches it for writability instead
// of reads and gives it what `__drain_deadline` allows; the loop
// finishes the write on later waits. A write the kernel refuses (the
// peer is gone) leaves the connection to the caller to close.
function __serve_send[D: async.Driver](drv: D, c: __Conns, at: i32, payload: u8[], opts: Config): (__Conns, __Sent) {
  match (c.tls[at]) {
    Secured(sess) => {
      match (sess.write(payload)) {
        Ok(step) => {
          return __serve_send_raw(drv, __Conns { ...c, tls: c.tls.with(at, Secured(step.session)) }, at, step.output, opts);
        },
        Err(_) => {
          return (c, Failed);
        }
      }
    },
    Lent => {
      match (__lent_sealed(c, at, payload)) {
        Some(sealed) => {
          return __serve_send_raw(drv, c, at, sealed, opts);
        },
        None => {
          return (c, Failed);
        }
      }
    },
    _ => {}
  }
  return __serve_send_raw(drv, c, at, payload, opts);
}

// __lent_closed(c, at) — the close alert of the session a pull holds for
// the connection at `at`, written as the connection closes.
function __lent_closed(c: __Conns, at: i32): void {
  match (c.framing[at]) {
    Pulling(body) => {
      match (body.tls.get()) {
        Some(sess) => {
          body.tls.set(None);
          if let Ok(step) = sess.close() {
            tcp_send_bytes(c.fds[at], step.output);
          }
        },
        None => {}
      }
    },
    _ => {}
  }
}

// __lent_sealed(c, at, payload) — `payload` sealed by the session a pull
// holds for the connection at `at` (`__Body.tls`), the session moved on
// in its cell; None when the session refuses it, or the connection has
// no body to hold one.
function __lent_sealed(c: __Conns, at: i32, payload: u8[]): Option[u8[]] {
  match (c.framing[at]) {
    Pulling(body) => {
      match (body.tls.get()) {
        Some(sess) => {
          match (sess.write(payload)) {
            Ok(step) => {
              body.tls.set(Some(step.session));
              return Some(step.output);
            },
            Err(_) => {
              return None;
            }
          }
        },
        None => {
          return Some(payload);
        }
      }
    },
    _ => {
      return Some(payload);
    }
  }
  return None;
}

// __serve_send_raw(drv, c, at, payload, opts) — `__serve_send` for bytes
// that go on the wire as they are: a plain connection's, or a TLS
// connection's records once sealed, which is also what its pending bytes
// are.
function __serve_send_raw[D: async.Driver](drv: D, c: __Conns, at: i32, payload: u8[], opts: Config): (__Conns, __Sent) {
  let n: i32 = tcp_send_bytes(c.fds[at], payload);
  if (n >= payload.len()) {
    return (c, Whole);
  }
  if (n < 0 && n != 0 - __eagain()) {
    return (c, Failed);
  }
  let rest: u8[] = payload;
  if (n > 0) {
    rest = __bytes_from(payload, n);
  }
  return (__serve_pend(drv, c, at, rest, opts), Partial);
}

// __serve_send_out(drv, c, at, opts) — what the loop's builder holds
// written to the connection at `at`, as `__serve_send` writes an array,
// and the builder emptied: only a short write copies, the rest it leaves
// becoming the connection's pending bytes.
function __serve_send_out[D: async.Driver](drv: D, c: __Conns, at: i32, opts: Config): (__Conns, __Sent) {
  match (c.tls[at]) {
    Secured(sess) => {
      return __serve_send(drv, c, at, buf_take_bytes(c.out), opts);
    },
    _ => {}
  }
  let n: i32 = tcp_send_buf(c.fds[at], c.out, 0);
  if (n >= buf_len(c.out)) {
    buf_clear(c.out);
    return (c, Whole);
  }
  if (n < 0 && n != 0 - __eagain()) {
    buf_clear(c.out);
    return (c, Failed);
  }
  let rest: u8[] = buf_take_bytes(c.out);
  if (n > 0) {
    rest = __bytes_from(rest, n);
  }
  return (__serve_pend(drv, c, at, rest, opts), Partial);
}

// __serve_pend(drv, c, at, rest, opts) — `rest`, what a short write left,
// kept as the connection's pending bytes, the connection watched for
// writability instead of reads and given what `__drain_deadline` allows.
function __serve_pend[D: async.Driver](drv: D, c: __Conns, at: i32, rest: u8[], opts: Config): __Conns {
  drv.watch(c.fds[at], 2);
  let first: boolean = c.pending[at].len() == 0;
  return __drain_deadline(__Conns { ...c, pending: c.pending.with(at, rest) }, at, opts, first);
}

// __serve_produce(drv, c, at, opts) — the next piece of the tail on the
// connection at `at` produced and written, once its pending bytes have
// gone: `(conns, sent)` as `__serve_send` answers it, Partial while the
// tail has more to produce, since the loop writes one piece per wait
// and a writable socket wakes it again at once, and Partial while its
// producer is parked, when the flight running it wakes it instead; a
// tail that cannot be honoured is Failed, for the caller to close.
function __serve_produce[D: async.Driver](drv: D, c: __Conns, at: i32, opts: Config): (__Conns, __Sent) {
  if (!__in_flight(c, at)) {
    return (c, Whole);
  }
  if (__tail_parked(c, at)) {
    return (c, Partial);
  }
  let moved: (__Conns, __Sent, boolean) = __file_tail_send(drv, c, at, opts);
  c = moved.0;
  if (moved.2) {
    return (c, moved.1);
  }
  let produced: (__Conns, u8[], boolean) = __tail_piece(drv, c, at);
  c = produced.0;
  if (!produced.2) {
    return (c, Failed);
  }
  if (__tail_parked(c, at)) {
    return (c, Partial);
  }
  let sent: (__Conns, __Sent) = __serve_send(drv, c, at, produced.1, opts);
  c = sent.0;
  match (sent.1) {
    Whole => {},
    _ => {
      return (c, sent.1);
    }
  }
  if (!__in_flight(c, at)) {
    return (c, Whole);
  }
  drv.watch(c.fds[at], 2);
  return (c, Partial);
}

// __tail_parked(c, at) — whether the connection's producer is parked,
// its flight to wake it: the tail then owes nothing until it does, and
// the connection is watched for reads, not writes, which a level-
// triggered reactor would report on every wait.
function __tail_parked(c: __Conns, at: i32): boolean {
  match (c.tails[at]) {
    ParkedTail(_, _, _) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// __file_tail_send(drv, c, at, opts) — the next piece of a file tail
// moved from the file to the socket with no copy through the process
// (tcp_sendfile): `(conns, sent, moved)`, `moved` false where the target
// has no sendfile or the tail is not a file's, so the caller reads and
// sends the piece itself. A file shorter than its head announced is
// Failed, as the read path answers it.
function __file_tail_send[D: async.Driver](drv: D, c: __Conns, at: i32, opts: Config): (__Conns, __Sent, boolean) {
  match (c.tls[at]) {
    Secured(sess) => {
      return (c, Whole, false);
    },
    _ => {}
  }
  match (c.tails[at]) {
    FileTail(r, left, after) => {
      let want: i32 = 65536;
      if (left < want as i64) {
        want = left as i32;
      }
      let n: i32 = tcp_sendfile(c.fds[at], r.fd, want);
      if (n == 0 - __enotsup()) {
        return (c, Whole, false);
      }
      if (n == 0 - __eagain()) {
        drv.watch(c.fds[at], 2);
        return (__drain_deadline(c, at, opts, true), Partial, true);
      }
      if (n <= 0) {
        return (__tail_drop(c, at), Failed, true);
      }
      let rest: i64 = left - n as i64;
      if (rest <= 0 as i64) {
        return __sent_range(drv, c, at, __after_range(r, after));
      }
      drv.watch(c.fds[at], 2);
      return (__Conns { ...c, tails: c.tails.with(at, FileTail(r, rest, after)) }, Partial, true);
    },
    _ => {
      return (c, Whole, false);
    }
  }
  return (c, Whole, false);
}

// __sent_range(drv, c, at, next) — `__file_tail_send` once a range has
// gone by sendfile: Whole when nothing follows, Partial with the tail moved
// on when a seam or range does, Failed when the next range cannot be
// sought to.
function __sent_range[D: async.Driver](drv: D, c: __Conns, at: i32, next: Option[__Tail]): (__Conns, __Sent, boolean) {
  match (next) {
    Some(t) => {
      let moved: __Conns = __Conns { ...c, tails: c.tails.with(at, t) };
      match (t) {
        NoTail => {
          return (moved, Whole, true);
        },
        _ => {
          drv.watch(c.fds[at], 2);
          return (moved, Partial, true);
        }
      }
    },
    None => {
      return (__Conns { ...c, tails: c.tails.with(at, NoTail) }, Failed, true);
    }
  }
  return (c, Failed, true);
}

// __drain_deadline(c, at, opts, first) — the deadline of a response being
// drained: its clock starts at the first short write, with the bytes the
// peer had not taken then (pending here, plus what the socket holds
// unacknowledged) as its base, and from then the peer may take the grace
// plus what the bytes it has taken since buy at the minimum rate, so a
// peer that stops reading is cut off after the grace and one that keeps
// reading above the rate never is. The loop re-reads this at the
// deadline (`__serve_expire`), since the socket reports the peer's
// progress without a readiness event. Without a rate, the read deadline
// from each write. Where the socket cannot report its queue (wasm), the
// bytes the loop has handed it are the progress.
function __drain_deadline(c: __Conns, at: i32, opts: Config, first: boolean): __Conns {
  let now: i64 = monotonic_ns();
  let since: i64 = c.send_since[at];
  let base: i32 = c.send_base[at];
  let queued: i32 = tcp_socket_ctl(c.fds[at], 6, 0);
  if (queued < 0) {
    queued = 0;
  }
  let outstanding: i32 = c.pending[at].len() + queued + __tail_left(c, at);
  if (first) {
    since = now;
    base = outstanding;
  }
  let deadline: i64 = now + opts.recv_deadline.as_nanos();
  if (opts.response_min_data_rate > 0) {
    deadline = since + opts.response_data_rate_grace.as_nanos() + (base - outstanding) as i64 * (1000000000 as i64) / (opts.response_min_data_rate as i64);
  }
  return __Conns { ...c, deadlines: c.deadlines.with(at, deadline), send_since: c.send_since.with(at, since), send_base: c.send_base.with(at, base) };
}

// __listener_interest(opts) — how a loop watches its listener: for reads,
// and exclusively when other workers watch the same listener, so a
// connection wakes one of them rather than all.
function __listener_interest(opts: Config): i32 {
  if (opts.workers > 1) {
    return 5;
  }
  return 1;
}

// __stop_begin(stop, sig) — the shutdown `sig` started, once: a second
// signal changes nothing.
function __stop_begin(stop: __Stop, sig: i32): __Stop {
  if (__serve_stopping(stop)) {
    return stop;
  }
  return __Stop { ...stop, at: monotonic_ns(), sig: sig };
}

// __serve_stop_sources(drv, opts) — the loop's stop sources watched:
// SIGTERM, SIGINT and, when `opts.stop_with_parent`, the parent's exit,
// which is a SIGTERM already delivered when the parent is gone.
function __serve_stop_sources(drv: async.RealDriver, opts: Config): __Stop {
  drv.watch_signal(15);
  drv.watch_signal(2);
  if (opts.stop_with_parent && drv.watch_parent() == 0 - 3) {
    return __stop_begin(__stop_none(), 15);
  }
  return __stop_none();
}

// __stop_signal(fd) — the signal a wait's event reports, when it is one
// that stops a server (SIGTERM or SIGINT, reported as -15 and -2), else 0.
function __stop_signal(fd: i32): i32 {
  if (fd == 0 - 15 || fd == 0 - 2) {
    return 0 - fd;
  }
  return 0;
}

// __serve_pass_end(drv, listener, c, opts, stop, accepting, parked) — what
// one pass of the loop does after its events: connections past their
// deadline are closed, the listener is gated by the connection cap and the
// count of parked handlers (until a shutdown, which owns the listener from
// then), and the shutdown takes its next step. `(conns, stop, accepting,
// done)`.
function __serve_pass_end[D: async.Driver](drv: D, listener: i32, c: __Conns, opts: Config, stop: __Stop, accepting: boolean, parked: i32): (__Conns, __Stop, boolean, boolean) {
  let now: i64 = monotonic_ns();
  c = __serve_expire(drv, c, opts, now);
  if (!__serve_stopping(stop)) {
    accepting = __serve_gate(drv, listener, c, opts, accepting, parked);
  }
  return __serve_stop_step(drv, listener, c, opts, stop, accepting, now, parked);
}

// __Stop — where a loop is in its shutdown: the monotonic time the stop
// signal arrived (-1 before it) and which one it was, whether the
// listener has been closed since, and whether a connection was cut off
// with a request in flight.
struct __Stop { at: i64, sig: i32, closed: boolean, aborted: boolean }

function __stop_none(): __Stop {
  return __Stop { at: 0 - 1 as i64, sig: 0, closed: false, aborted: false };
}

// __serve_stopping(stop) — whether a stop signal has arrived.
function __serve_stopping(stop: __Stop): boolean {
  return stop.at >= 0 as i64;
}

// __stop_timeout(stop, opts, now, timeout) — the wait's timeout brought
// forward to the next step of a shutdown: the end of the accept grace,
// then the drain deadline.
function __stop_timeout(stop: __Stop, opts: Config, now: i64, timeout: i32): i32 {
  if (!__serve_stopping(stop)) {
    return timeout;
  }
  let due: i64 = stop.at + opts.shutdown_grace.as_nanos();
  if (stop.closed) {
    due = stop.at + opts.drain_deadline.as_nanos();
  }
  let ms: i64 = (due - now + 999999 as i64) / 1000000;
  if (ms < 0 as i64) {
    ms = 0 as i64;
  }
  if (timeout >= 0 && timeout as i64 < ms) {
    return timeout;
  }
  if (ms > 2147483647 as i64) {
    return 2147483647;
  }
  return ms as i32;
}

// __serve_stop_step(drv, listener, c, opts, stop, accepting, now, parked) —
// the shutdown's next step, once per pass: past the accept grace the
// listener is closed and every connection with nothing in flight (an
// empty buffer and nothing to write) is closed too; past the drain
// deadline the rest are closed and the loop remembers it cut them off.
// `(conns, stop, accepting, done)`, `done` once the listener is closed,
// no connection remains, and no background work is left (`__stop_done`).
function __serve_stop_step[D: async.Driver](drv: D, listener: i32, c: __Conns, opts: Config, stop: __Stop, accepting: boolean, now: i64, parked: i32): (__Conns, __Stop, boolean, boolean) {
  if (!__serve_stopping(stop)) {
    return (c, stop, accepting, false);
  }
  if (!stop.closed) {
    if (now < stop.at + opts.shutdown_grace.as_nanos()) {
      return (c, stop, accepting, false);
    }
    if (accepting) {
      drv.unwatch(listener);
    }
    tcp_close(listener);
    stop = __Stop { ...stop, closed: true };
    accepting = false;
  }
  let past_drain: boolean = now >= stop.at + opts.drain_deadline.as_nanos();
  let swept: (__Conns, __Stop) = __stop_sweep(drv, c, stop, past_drain);
  return (swept.0, swept.1, accepting, __stop_done(swept.0, parked, past_drain));
}

// __stop_done(c, parked, past_drain) — whether a shutdown has finished:
// every connection closed, and the flights left, which with no connection
// are responses' background work, ended or cut off at the drain deadline.
function __stop_done(c: __Conns, parked: i32, past_drain: boolean): boolean {
  return c.fds.len() == 0 && (parked == 0 || past_drain);
}

// __stop_sweep(drv, c, stop, past_drain) — the connections with nothing
// in flight closed, and past the drain deadline every connection, the
// shutdown remembering the ones it cut off.
function __stop_sweep[D: async.Driver](drv: D, c: __Conns, stop: __Stop, past_drain: boolean): (__Conns, __Stop) {
  let i: i32 = 0;
  while (i < c.fds.len()) {
    let idle: boolean = c.bufs[i].len() == 0 && !__in_flight(c, i) && !c.backlog[i];
    if (idle || past_drain) {
      if (!idle) {
        stop = __Stop { ...stop, aborted: true };
      }
      c = __serve_close(drv, c, i);
    } else {
      i = i + 1;
    }
  }
  return (c, stop);
}

// __stop_code(stop) — what a finished shutdown exits with: 0 when every
// request in flight was answered, 1 when one was cut off at the drain
// deadline.
function __stop_code(stop: __Stop): i32 {
  if (stop.aborted) {
    return 1;
  }
  return 0;
}

// __stop_reason(stop) — what a finished shutdown tells the program's
// `shutdown` hook: "sigterm" or "sigint", the signal that started it,
// when every request in flight was answered, "drain-deadline" when one
// was cut off.
function __stop_reason(stop: __Stop): string {
  if (stop.aborted) {
    return "drain-deadline";
  }
  if (stop.sig == 2) {
    return "sigint";
  }
  return "sigterm";
}

// __serve_not_ready(f, opts, stop) — whether the request is the
// readiness probe of a loop that is stopping, to be answered 503 by the
// loop itself so whoever routes to it stops.
function __serve_not_ready(f: http.HttpFramed, opts: Config, stop: __Stop): boolean {
  return __serve_stopping(stop) && opts.readiness_path.len() > 0 && f.request.path == opts.readiness_path;
}

// __serve_gate(drv, listener, c, opts, accepting) — whether the listener
// is watched after this pass: unwatched once `max_connections` are open
// or `max_in_flight` handlers or producers are parked, so the accept queue holds the
// rest, and watched again once one has closed or finished. A watch the
// reactor refuses leaves the listener unwatched until the next pass tries
// again.
function __serve_gate[D: async.Driver](drv: D, listener: i32, c: __Conns, opts: Config, accepting: boolean, parked: i32): boolean {
  let cap: i32 = opts.max_connections;
  if (cap < 1) {
    cap = 1;
  }
  let full: boolean = c.fds.len() >= cap || parked >= opts.max_in_flight;
  if (accepting && full) {
    drv.unwatch(listener);
    return false;
  }
  if (!accepting && !full) {
    return drv.watch(listener, __listener_interest(opts)) >= 0;
  }
  return accepting;
}

// __serve_expire(drv, c, opts, now) — every connection whose deadline is
// due closed, without a response or with the rest of one unsent; one
// still draining a response has its deadline re-read first, since the
// peer's progress shows in the socket's queue and not only in a
// readiness event. A connection whose backlog holds a request is not
// waiting on the peer: its deadline is stale from the read that filled
// the backlog, and it stays open for the next wait to answer it.
function __serve_expire[D: async.Driver](drv: D, c: __Conns, opts: Config, now: i64): __Conns {
  let i: i32 = 0;
  while (i < c.fds.len()) {
    if (c.deadlines[i] <= now && !c.backlog[i] && __in_flight(c, i)) {
      c = __drain_deadline(c, i, opts, false);
    }
    if (c.deadlines[i] <= now && !c.backlog[i]) {
      c = __serve_close(drv, c, i);
    } else {
      i = i + 1;
    }
  }
  return c;
}

// ---- Streamed request bodies (docs/NET-P3-SUSPENSION-PLAN.md §3.9) ------
//
// With `Config.stream_bodies` a request whose header block has arrived
// starts its handler at once, its body a Stream that pulls the bytes as
// the handler reads them. The pull owns the connection's read side until
// the body ends: it parks on the descriptor under the body's data-rate
// deadline (the handler's task parks, the worker serves other connections
// meanwhile), then reads what the framing still owes — a Content-Length
// body to its length and never past it, a chunked body through
// `http.ChunkDecoder`, the bytes past its last chunk kept for the loop. The
// loop hands the pull the body bytes it already holds, leaves the
// connection unread while the body is live, and takes it back when the
// flight answers. `Expect: 100-continue` is answered by the pull before its
// first wait, when no body byte has arrived, so a handler that refuses the
// request never invites the body. A body that ends early faults the stream
// (413 past the cap, 408 under the minimum data rate, 400 malformed or cut
// short, `async.cancelled()` with the task), and the connection does not
// persist past a response to a request whose body was not read whole.

// __Body — what the loop and a flight's pull share about a streamed body:
// `state`, 0 while the body is being read, 1 once it ended whole, 2 once
// it faulted; `rest`, the bytes the pull read past the body, the next
// request's, for the loop to take back.
struct __Body { state: Cell[i32], rest: Cell[u8[]], tls: Cell[Option[server.Session]] }

// __Pull — a streamed body's reader: the connection; what a Content-Length
// body still owes (`left`, -1 for a chunked body) or the chunked decoder's
// state (`dstate`, `dheld`, `dleft`, `dbudget`, `droom`, as
// `http.ChunkDecoder` holds it, in cells so the pull keeps it across
// calls); the body bytes handed over at the start, not yet taken
// (`pending`); the data-rate clock (`since`, 0 until the first wait, and
// `got`, the bytes read since); whether `100 Continue` is still owed; and
// the body's shared state and the stream's fault.
struct __Pull { fd: i32, left: Cell[i32], dstate: Cell[i32], dheld: Cell[u8[]], dleft: Cell[i32], dbudget: Cell[i32], droom: Cell[i32], pending: Cell[u8[]], since: Cell[i64], got: Cell[i32], continue_owed: Cell[i32], opts: Config, body: __Body, fault: Cell[i32] }

// __body_source(fd, head, initial, opts, body) — the source a streamed
// request's body pulls from.
function __body_source(fd: i32, head: http.HttpHead, initial: u8[], opts: Config, body: __Body): BodySource {
  let fault: Cell[i32] = cell_new(0);
  let owed: i32 = 0;
  if (head.expects_continue && initial.len() == 0) {
    owed = 1;
  }
  let empty: u8[] = [];
  let p: __Pull = __Pull { fd: fd, left: cell_new(head.length), dstate: cell_new(0), dheld: cell_new(empty), dleft: cell_new(0), dbudget: cell_new(opts.limits.header_bytes), droom: cell_new(opts.limits.body), pending: cell_new(initial), since: cell_new(0 as i64), got: cell_new(0), continue_owed: cell_new(owed), opts: opts, body: body, fault: fault };
  return BodySource { next: (): Option[u8[]] => __body_next(p), fault: fault, send: (bytes: u8[]): i32 => __pull_write(p, bytes) };
}

// __pull_write(p, bytes) — `bytes` written to the connection the pull
// reads, through its session on a TLS one, as far as the socket takes
// them and then the rest once it is writable again, the wait bounded as
// the raw read is: the bytes written, or a negative errno when the peer
// is gone, the session refused them, the wait ran out (-ETIMEDOUT) or
// the task was cancelled (-ECANCELED). The write side of an upgraded
// connection (std/http/websocket).
function __pull_write(p: __Pull, bytes: u8[]): i32 {
  let wire: u8[] = bytes;
  match (p.body.tls.get()) {
    Some(sess) => {
      match (sess.write(bytes)) {
        Ok(step) => {
          p.body.tls.set(Some(step.session));
          wire = step.output;
        },
        Err(_) => {
          return 0 - 71;
        }
      }
    },
    None => {}
  }
  let at: i32 = 0;
  while (at < wire.len()) {
    let n: i32 = tcp_send_bytes(p.fd, __bytes_from(wire, at));
    if (n > 0) {
      at = at + n;
      continue;
    }
    if (n != 0 - __eagain()) {
      return n;
    }
    let set: i32[] = [p.fd, 2];
    let woke: i32 = async.wait_any(set, __idle_ms(p.opts));
    if (woke == async.cancelled()) {
      return 0 - 125;
    }
    if (woke < 0) {
      return 0 - 110;
    }
  }
  return bytes.len();
}

// __idle_ms(opts) — the bound on a raw read or write: `keep_alive_idle`,
// how long an upgraded connection may be quiet, as a persistent one may
// between requests.
function __idle_ms(opts: Config): i32 {
  let ms: i64 = opts.keep_alive_idle.as_millis();
  if (ms > 2147483647 as i64) {
    return 2147483647;
  }
  if (ms <= 0 as i64) {
    return 1;
  }
  return ms as i32;
}

// __body_next(p) — the body's next bytes: what was handed over first,
// then what the connection delivers, each decoded under the framing;
// None once the body ended, whole or early.
function __body_next(p: __Pull): Option[u8[]] {
  if (p.body.state.get() != 0) {
    return None;
  }
  if (p.continue_owed.get() == 1) {
    p.continue_owed.set(0);
    __pull_send(p, "HTTP/1.1 100 Continue\r\n\r\n".bytes());
  }
  while (p.body.state.get() == 0) {
    let bytes: u8[] = __body_take(p);
    if (bytes.len() > 0) {
      let out: u8[] = __body_decode(p, bytes);
      if (out.len() > 0) {
        return Some(out);
      }
    }
  }
  return None;
}

// __body_take(p) — the next raw bytes: the pending ones, else one read
// after the connection is readable, bounded by what the framing owes;
// empty with the body faulted when the wait passed the data-rate deadline
// (408), the task was cancelled, or the peer closed or failed (400).
function __body_take(p: __Pull): u8[] {
  let none: u8[] = [];
  let pending: u8[] = p.pending.get();
  if (pending.len() > 0) {
    p.pending.set(none);
    return pending;
  }
  while (true) {
    let wait_ms: i32 = __body_wait_ms(p);
    if (wait_ms <= 0) {
      return __body_fault(p, 408);
    }
    let set: i32[] = [p.fd, 1];
    let woke: i32 = async.wait_any(set, wait_ms);
    if (woke == async.cancelled()) {
      return __body_fault(p, async.cancelled());
    }
    if (woke < 0) {
      return __body_fault(p, 408);
    }
    match (__pull_chunk(p)) {
      Some(bytes) => {
        return bytes;
      },
      None => {}
    }
  }
  return none;
}

// __pull_chunk(p) — one read off a readable connection: the bytes to hand
// the body (none once it faulted), or None to wait for more, nothing
// having arrived or a TLS record still arriving.
function __pull_chunk(p: __Pull): Option[u8[]] {
  let scratch: u8[] = __alloc_u8(__body_recv_size(p));
  let n: i32 = tcp_recv_into(p.fd, scratch);
  if (n > 0) {
    p.got.set(p.got.get() + n);
    let data: u8[] = __pull_read(p, scratch.take(n));
    if (data.len() > 0 || p.body.state.get() != 0) {
      return Some(data);
    }
    return None;
  }
  if (n != 0 - __eagain()) {
    return Some(__body_fault(p, 400));
  }
  return None;
}

// __pull_read(p, raw) — raw bytes a pull read as the body sees them:
// themselves on a plain connection, or the plaintext the session yields on
// a TLS one, the body faulted when the session ended.
function __pull_read(p: __Pull, raw: u8[]): u8[] {
  match (p.body.tls.get()) {
    Some(sess) => {
      match (__pull_opened(p, sess, raw)) {
        Some(data) => {
          return data;
        },
        None => {
          return __body_fault(p, 400);
        }
      }
    },
    None => {
      return raw;
    }
  }
  return raw;
}

// __pull_opened(p, sess, raw) — raw bytes a pull read, opened by the
// session it holds: the plaintext (possibly none yet, a record still
// arriving), or None when the peer closed the session or a record was
// refused, its alert written. What the session answers is written as far
// as the socket takes it.
function __pull_opened(p: __Pull, sess: server.Session, raw: u8[]): Option[u8[]] {
  match (sess.read(raw)) {
    Ok(step) => {
      p.body.tls.set(Some(step.session));
      if (step.output.len() > 0) {
        tcp_send_bytes(p.fd, step.output);
      }
      if (step.closed) {
        return None;
      }
      return Some(step.data);
    },
    Err(f) => {
      tcp_send_bytes(p.fd, f.alert);
      return None;
    }
  }
  return None;
}

// __pull_send(p, bytes) — bytes written on the pull's connection, sealed
// by the session it holds.
function __pull_send(p: __Pull, bytes: u8[]): void {
  match (p.body.tls.get()) {
    Some(sess) => {
      if let Ok(step) = sess.write(bytes) {
        p.body.tls.set(Some(step.session));
        tcp_send_bytes(p.fd, step.output);
      }
    },
    None => {
      tcp_send_bytes(p.fd, bytes);
    }
  }
}

// __body_wait_ms(p) — how long the pull may wait for the next bytes: what
// the body has earned under `Config.min_data_rate` from its first wait,
// the grace plus what its bytes since buy, as `__body_deadline` counts it
// for a body the loop reads; 0 once that has passed. An upgraded
// connection's bytes come when the peer has something to say, so its
// bound is the idle span instead.
function __body_wait_ms(p: __Pull): i32 {
  if (p.left.get() == 0 - 2) {
    return __idle_ms(p.opts);
  }
  let now: i64 = monotonic_ns();
  if (p.since.get() == 0 as i64) {
    p.since.set(now);
  }
  let earned: i64 = p.since.get() + p.opts.data_rate_grace.as_nanos();
  if (p.opts.min_data_rate > 0) {
    earned = earned + p.got.get() as i64 * (1000000000 as i64) / (p.opts.min_data_rate as i64);
  }
  if (earned <= now) {
    return 0;
  }
  let ms: i64 = (earned - now + 999999 as i64) / (1000000 as i64);
  if (ms > 2147483647 as i64) {
    return 2147483647;
  }
  return ms as i32;
}

// __body_recv_size(p) — how much one read may take: a scratch buffer's
// worth, and never past what a Content-Length body still owes, so the
// next request's bytes are left on the socket.
function __body_recv_size(p: __Pull): i32 {
  let left: i32 = p.left.get();
  if (left >= 0 && left < 4096) {
    return left;
  }
  return 4096;
}

// __body_decode(p, bytes) — the raw bytes decoded under the framing: a
// Content-Length body passed on to its length, what lies past it kept
// for the loop; a chunked body through the decoder; an upgraded
// connection's (`left` -2) as they are, until the peer closes. The
// body's state moves to 1 at its end, 2 on a refusal.
function __body_decode(p: __Pull, bytes: u8[]): u8[] {
  let left: i32 = p.left.get();
  if (left == 0 - 2) {
    return bytes;
  }
  if (left < 0) {
    return __body_decode_chunked(p, bytes);
  }
  if (bytes.len() < left) {
    p.left.set(left - bytes.len());
    return bytes;
  }
  p.left.set(0);
  p.body.state.set(1);
  if (bytes.len() == left) {
    return bytes;
  }
  p.body.rest.set(__bytes_from(bytes, left));
  return bytes.take(left);
}

function __body_decode_chunked(p: __Pull, bytes: u8[]): u8[] {
  let d: http.ChunkDecoder = http.ChunkDecoder { state: p.dstate.get(), held: p.dheld.get(), left: p.dleft.get(), budget: p.dbudget.get(), room: p.droom.get(), fields: p.opts.limits.header_fields, trailers: HeaderMap { names: [], values: [] } };
  match (d.feed(bytes)) {
    http.ChunkData(next, data) => {
      p.dstate.set(next.state);
      p.dheld.set(next.held);
      p.dleft.set(next.left);
      p.dbudget.set(next.budget);
      p.droom.set(next.room);
      return data;
    },
    http.ChunkEnd(data, trailers, rest) => {
      p.body.rest.set(rest);
      p.body.state.set(1);
      return data;
    },
    http.ChunkRefused(status) => {
      return __body_fault(p, status);
    }
  }
  return __body_fault(p, 400);
}

// __body_fault(p, status) — the body ended early: the stream's fault set,
// and nothing more to read.
function __body_fault(p: __Pull, status: i32): u8[] {
  let none: u8[] = [];
  p.fault.set(status);
  p.body.state.set(2);
  return none;
}

// __body_live(fl) — whether the flight's pull is still reading its body.
function __body_live(fl: __Flight): boolean {
  match (fl.body) {
    Some(b) => {
      return b.state.get() == 0;
    },
    None => {
      return false;
    }
  }
  return false;
}

// __body_settled(drv, c, at, body) — the connection taken back from a
// flight's pull as the flight answers: what the pull read past the body
// goes before what the loop has read since, the loop reads the connection
// again, and a connection whose body was not read whole does not persist,
// since what is left of the body would be read as the next request.
function __body_settled[D: async.Driver](drv: D, c: __Conns, at: i32, body: __Body): __Conns {
  c = __tls_back(__Conns { ...c, framing: c.framing.with(at, Http1) }, at, body);
  let rest: u8[] = body.rest.get();
  if (rest.len() > 0) {
    c = __Conns { ...c, bufs: c.bufs.with(at, rest.concat(__bytes_from(c.bufs[at], c.offs[at]))), offs: c.offs.with(at, 0) };
  }
  drv.watch(c.fds[at], 1);
  if (body.state.get() != 1) {
    return __Conns { ...c, keep: c.keep.with(at, false) };
  }
  return c;
}

// __tls_back(c, at, body) — the TLS session a streamed body's pull held,
// back on the connection.
function __tls_back(c: __Conns, at: i32, body: __Body): __Conns {
  match (body.tls.get()) {
    Some(sess) => {
      body.tls.set(None);
      return __Conns { ...c, tls: c.tls.with(at, Secured(sess)) };
    },
    None => {
      return c;
    }
  }
  return c;
}

// __tls_regained(c, at, fl) — the connection with its session back from
// the flight's body once the pull is done with it, so the loop's reads
// go through it again.
function __tls_regained(c: __Conns, at: i32, fl: __Flight): __Conns {
  match (fl.body) {
    Some(b) => {
      return __tls_back(c, at, b);
    },
    None => {
      return c;
    }
  }
  return c;
}

// __serve_unframed(drv, c, fls, at, expecting, …) — a request whose body
// has not arrived: with `stream_bodies` and its header block complete,
// its handler starts now on a streamed body; otherwise the loop keeps
// reading, answering `100 Continue` first when the request expects it.
// `(conns, flights, more, next)` as the burst loop reads them,
// `more` when a response went out and the next request is framed.
function __serve_unframed[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], at: i32, expecting: boolean, start: (http.HttpFramed, boolean, __Stop, platform.Host) => __Started, opts: Config, stop: __Stop, count: i32, clk: __Clock, eof: boolean): (__Conns, __Flight[], boolean, __Behind, http.HttpFramed) {
  if (!opts.stream_bodies || eof) {
    if (expecting) {
      c = __serve_continue(drv, c, at, opts);
    }
    return (c, fls, false, Idle, c.last);
  }
  match (http.http_parse_request_head_from(c.bufs[at], c.offs[at], opts.limits, c.last.request)) {
    http.Headed(h) => {
      return __serve_stream(drv, c, fls, at, h, start, opts, stop, count, clk);
    },
    http.HeadIncomplete => {
      return (c, fls, false, Idle, c.last);
    },
    http.HeadMalformed(status) => {
      return (__serve_refuse(drv, c, at, status, opts, clk), fls, false, Idle, c.last);
    }
  }
  return (c, fls, false, Idle, c.last);
}

// __upgrade_head(f) — the framed upgrade request as a head whose body is
// the connection's bytes after it, until the session ends (`length` -2,
// `__body_source`'s raw framing). Its keep-alive is the request's, so an
// upgrade the handler declines (a response that is not a 101) is answered
// and the connection persists as any HTTP/1.1 request's would (RFC 9110
// §7.8 lets a server ignore an Upgrade it cannot honour); the 101 path
// passes keep-alive false itself, taking the connection for the session.
function __upgrade_head(f: http.HttpFramed): http.HttpHead {
  return http.HttpHead { request: f.request, len: f.len, keep_alive: f.keep_alive, version: f.version, length: 0 - 2, expects_continue: false };
}

// __serve_stream(drv, c, fls, at, h, start, …) — the handler started on
// the request head `h` through `start` (the loop's `__serve_start` with
// its handler and platform bound), its body streamed: the body bytes buffered so far are the
// pull's, the buffer is taken as answered, and the handler runs until it
// answers or parks. A handler that answers at once is responded to with
// the connection taken back, unless its answer upgrades the connection
// (`__upgrading`), when the body stays the session's; one that parks
// becomes a flight carrying its body's state.
function __serve_stream[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], at: i32, h: http.HttpHead, start: (http.HttpFramed, boolean, __Stop, platform.Host) => __Started, opts: Config, stop: __Stop, count: i32, clk: __Clock): (__Conns, __Flight[], boolean, __Behind, http.HttpFramed) {
  let fd: i32 = c.fds[at];
  let buf: u8[] = c.bufs[at];
  let empty: u8[] = [];
  let body: __Body = __Body { state: cell_new(0), rest: cell_new(empty), tls: cell_new(None) };
  match (c.tls[at]) {
    Secured(sess) => {
      body.tls.set(Some(sess));
      c = __Conns { ...c, tls: c.tls.with(at, Lent) };
    },
    _ => {}
  }
  let src: BodySource = __body_source(fd, h, __bytes_from(buf, c.offs[at] + h.len), opts, body);
  let req: HttpRequest = HttpRequest { ...h.request, body: stream.stream_from_source(src) };
  let served: i32 = c.served[at] + 1;
  let keep: boolean = h.keep_alive && served < opts.keep_alive_requests && !__serve_stopping(stop);
  c = __Conns { ...c, offs: c.offs.with(at, buf.len()), served: c.served.with(at, served), backlog: c.backlog.with(at, false), continued: c.continued.with(at, false), keep: c.keep.with(at, keep), framing: c.framing.with(at, Pulling(body)) };
  let f: http.HttpFramed = http.HttpFramed { request: req, len: 0, keep_alive: keep, version: h.version };
  c = __serve_started(c, at);
  match (start(f, keep, stop, c.hosts[at])) {
    HandlerDone(resp) => {
      if (__upgrading(resp)) {
        let upgraded: (__Conns, boolean) = __serve_respond(drv, c, at, h.request.method, h.version, resp, false, opts, count + 1, Idle, clk);
        return (upgraded.0, fls, false, Idle, c.last);
      }
      c = __body_settled(drv, c, at, body);
      if (h.length == 0 - 2) {
        c = __Conns { ...c, keep: c.keep.with(at, keep) };
      }
      let parsed: (__Behind, http.HttpFramed) = __serve_behind(http.http_parse_request_framed_from(c.bufs[at], c.offs[at], opts.limits, c.last), c.last);
      let answered: (__Conns, boolean) = __serve_respond(drv, c, at, h.request.method, h.version, resp, c.keep[at], opts, count + 1, parsed.0, clk);
      return (answered.0, fls, answered.1, parsed.0, parsed.1);
    },
    HandlerParked(fl) => {
      let parked: (__Conns, __Flight[]) = __serve_park(drv, c, fls, at, __flight_watch(drv, __Flight { ...fl, body: Some(body) }, monotonic_ns()), opts);
      return (parked.0, parked.1, false, Idle, c.last);
    }
  }
  return (c, fls, false, Idle, c.last);
}

// __Flight — a handler parked on a connection (docs/NET-P3-SUSPENSION-PLAN.md
// §3.4): its task; the connection's descriptor; the (fd, interest) pairs it
// waits on, each watched on the worker's reactor; the monotonic nanosecond
// its wait is due by, -1 for no bound; and what its response needs when it
// comes: the request's method and version, whether the connection persists
// past it, and the framing of the bytes behind the request. A connection
// with a flight takes no further request until the flight answers, so
// pipelined requests stay in order; what the peer sends meanwhile is read
// into the buffer, and the end of its stream closes the connection after
// the response, as it does today — except while the flight's own pull is
// reading a streamed body (`body`), when the connection is the pull's to
// read. `idle` is the monotonic nanosecond a parked producer's filler is
// next due at (`ChunkProducer.idle_ms`), -1 for none, and `ends` the one
// a handler's request is due by (`Config.handler_deadline`), -1 for none.
struct __Flight { job: __Job, wait: async.Wait, fd: i32, set: i32[], due: i64, method: string, version: string, kept: boolean, behind: __Behind, body: Option[__Body], idle: i64, ends: i64 }

// __Job — the task a flight runs: a handler, whose response the flight
// answers, a response's chunk producer (`__tail_park`), whose chunk
// the flight writes, or a response's background work, which answers
// nothing and holds no connection.
enum __Job { Handler(async.Call[HttpRequest, platform.Host, HttpResponse]), Producer(async.Task[Option[u8[]]]), Background(async.Task[i32]) }

// __Started — how a handler's first run ended: with its response, or parked
// on a wait, the flight not yet watching it.
enum __Started { HandlerDone(HttpResponse), HandlerParked(__Flight) }

// __started_again(s) — `s` built again from its parts, for a caller that
// cannot take a start apart in place (a lambda returning it).
function __started_again(s: __Started): __Started {
  match (s) {
    HandlerDone(resp) => {
      return HandlerDone(resp);
    },
    HandlerParked(fl) => {
      return HandlerParked(fl);
    }
  }
  return s;
}

// __serve_start(handler, plat, f, kept, behind, opts, stop) — the handler run
// for the request as a task: its response when it returns, the flight and
// the wait it parked on otherwise, for the loop to watch. The readiness
// probe of a stopping loop is answered 503 without running it.
function __serve_start(handler: (HttpRequest, platform.Host) => HttpResponse, plat: platform.Host, f: http.HttpFramed, kept: boolean, behind: __Behind, opts: Config, stop: __Stop): __Started {
  if (__serve_not_ready(f, opts, stop)) {
    return HandlerDone(http.text(503, ""));
  }
  let req: HttpRequest = f.request;
  let held: (platform.Host, i64) = __request_host(plat, req, opts);
  plat = held.0;
  let ends: i64 = held.1;
  match (async.call_start(handler, req, plat)) {
    Done(resp) => {
      return HandlerDone(__in_time(resp, ends, plat.elapsed_ns()));
    },
    Suspended(w) => {
      let none: i32[] = [];
      return HandlerParked(__Flight { job: Handler(async.call_of(w, handler, req, plat)), wait: w, fd: 0, set: none, due: 0 - 1 as i64, method: req.method, version: f.version, kept: kept, behind: behind, body: None, idle: 0 - 1 as i64, ends: ends });
    },
    Cancelled => {}
  }
  return HandlerDone(http.text(503, ""));
}

// __bound_ends(bound, now) — the monotonic nanosecond `bound` from `now`
// falls due, -1 for a zero bound, which is none.
function __bound_ends(bound: Duration, now: i64): i64 {
  let span: i64 = bound.as_nanos();
  if (span <= 0 as i64) {
    return 0 - 1 as i64;
  }
  return now + span;
}

// __in_time(resp, ends, now) — the handler's response, or 503 in its place
// when it came after `ends`.
function __in_time(resp: HttpResponse, ends: i64, now: i64): HttpResponse {
  if (ends >= 0 as i64 && now >= ends) {
    return http.text(503, "");
  }
  return resp;
}

// __serve_step(handler, st, req, plat, opts) — the stateful handler run for
// the request under its deadline, as `__serve_start` runs `run`'s.
function __serve_step[S](handler: (S, HttpRequest, platform.Host) => (S, HttpResponse), st: S, req: HttpRequest, plat: platform.Host, opts: Config): (S, HttpResponse) {
  let held: (platform.Host, i64) = __request_host(plat, req, opts);
  let stepped: (S, HttpResponse) = handler(st, req, held.0);
  return (stepped.0, __in_time(stepped.1, held.1, held.0.elapsed_ns()));
}

// __serve_started(c, at) — the connection at `at` with its request's clock
// running: the body's clock (`__body_deadline`) when the header block was
// found complete by an earlier read, else started now, as that would start
// it. The duration its answer is counted under measures from it.
function __serve_started(c: __Conns, at: i32): __Conns {
  if (c.rate_since[at] >= 0 as i64) {
    return c;
  }
  return __Conns { ...c, rate_since: c.rate_since.with(at, monotonic_ns()), rate_base: c.rate_base.with(at, c.bufs[at].len()) };
}

// __request_host(plat, req, opts) — the host a handler runs `req` under,
// and the monotonic nanosecond it must answer by (-1 for none): the
// connection's host with the request's deadline (`Config.handler_deadline`)
// and, when `Config.trace` asks, the span the request opens, continuing the
// caller's trace from its `traceparent`.
function __request_host(plat: platform.Host, req: HttpRequest, opts: Config): (platform.Host, i64) {
  let ends: i64 = __bound_ends(opts.handler_deadline, plat.elapsed_ns());
  if (ends >= 0 as i64) {
    plat = plat.with_deadline(ends);
  }
  if (opts.trace) {
    let host: platform.Host = plat;
    plat = plat.with_trace(trace.continue_from(req.headers, (): i32 => host.random_i32()));
  }
  return (plat, ends);
}

// __serve_park(drv, c, fls, at, fl, opts) — the connection at `at`
// held for the flight: what the event's burst had corked goes out first,
// since the flight's response comes after it, and the connection's read
// deadline is lifted while the handler waits. A write the kernel refuses
// closes the connection and cancels the flight.
function __serve_park[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], at: i32, fl: __Flight, opts: Config): (__Conns, __Flight[]) {
  let fd: i32 = c.fds[at];
  if (buf_len(c.out) > 0) {
    let sent: (__Conns, __Sent) = __serve_send_out(drv, c, at, opts);
    c = sent.0;
    match (sent.1) {
      Failed => {
        __flight_cancel(drv, fl);
        return (__serve_close(drv, c, at), fls);
      },
      _ => {}
    }
  }
  return (__Conns { ...c, deadlines: c.deadlines.with(at, __held_deadline()) }, fls.append(__Flight { ...fl, fd: fd }));
}

// __held_deadline() — the read deadline of a connection whose handler is
// parked: none, since the peer has nothing to send until the response.
function __held_deadline(): i64 {
  let g: i64 = 1000000000 as i64;
  return g * g * 9;
}

// __serve_held_event(drv, c, fls, fi, fd, readiness, scratch, opts) — a
// readiness event on a connection whose flight `fi` is parked: a hang-up
// cancels the flight and closes the connection; while the flight's pull is
// reading a streamed body the connection is its to read, so the loop
// unwatches it (the pull watches it again when it parks on it) rather than
// spin on bytes it will not take; anything else is read into the buffer,
// the end of the stream remembered, and the read deadline kept lifted.
function __serve_held_event[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], fi: i32, fd: i32, readiness: i32, scratch: u8[], opts: Config): (__Conns, __Flight[]) {
  let at: i32 = __conns_index(c, fd);
  if (at < 0) {
    return (c, fls);
  }
  if ((readiness & 4) != 0) {
    __flight_cancel(drv, fls[fi]);
    return (__serve_close(drv, c, at), __flights_remove(fls, fi));
  }
  if (__body_live(fls[fi])) {
    drv.unwatch(fd);
    return (c, fls);
  }
  let read: (__Conns, boolean) = __serve_read(drv, __tls_regained(c, at, fls[fi]), at, scratch, opts);
  c = __serve_compact(read.0, at);
  if (read.1) {
    c = __serve_parked_eof(c, fd);
  }
  return (__Conns { ...c, deadlines: c.deadlines.with(at, __held_deadline()) }, fls);
}

// __serve_settle(drv, c, fls, fd, eof, opts, clk) — `__serve_finish` after
// an event, except that a peer that finished sending while a handler is
// parked on `fd` waits for that handler's response (`__serve_parked_eof`).
function __serve_settle[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], fd: i32, eof: boolean, opts: Config, clk: __Clock): __Conns {
  if (eof && __flight_at(fls, fd) >= 0) {
    return __serve_parked_eof(__serve_finish(drv, c, fd, false, opts, clk), fd);
  }
  return __serve_finish(drv, c, fd, eof, opts, clk);
}

// __serve_parked_eof(c, fd) — the peer finished sending while a handler is
// parked on `fd`: that handler's response still goes out, and the
// connection closes after it.
function __serve_parked_eof(c: __Conns, fd: i32): __Conns {
  let at: i32 = __conns_index(c, fd);
  if (at < 0) {
    return c;
  }
  return __Conns { ...c, keep: c.keep.with(at, false) };
}

// __flight_wake(drv, c, fls, fi, ready, opts, clk) — flight `fi` run on
// with `ready`, the index of the pair that became ready (-1 at its bound):
// its response (a handler) or its chunk (a producer) answered on its
// connection when it returns, its new wait watched when it parks again,
// its connection closed when it was cancelled. A producer whose
// connection went away is cancelled rather than run on.
function __flight_wake[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], fi: i32, ready: i32, opts: Config, clk: __Clock): (__Conns, __Flight[]) {
  let fl: __Flight = fls[fi];
  __flight_unwatch(drv, fl);
  fls = __flights_remove(fls, fi);
  match (fl.job) {
    Handler(call) => {
      return __handler_wake(drv, c, fls, fl, call, ready, opts, clk);
    },
    Producer(t) => {
      if (__conns_index(c, fl.fd) < 0) {
        let gone: async.TaskStatus[Option[u8[]]] = async.task_cancel(t);
        async.task_free(t);
        return (c, fls);
      }
      match (async.task_resume(t, ready)) {
        Done(chunk) => {
          async.task_free(t);
          return (__producer_done(drv, c, fl.fd, chunk, opts, clk), fls);
        },
        Suspended(w) => {
          return (c, fls.append(__flight_watch(drv, __Flight { ...fl, wait: w }, monotonic_ns())));
        },
        Cancelled => {
          async.task_free(t);
          return (__serve_abandon(drv, c, fl.fd), fls);
        }
      }
    },
    Background(t) => {
      return (c, __background_wake(drv, fls, fl, t, ready));
    }
  }
  return (c, fls);
}

// __handler_wake(drv, c, fls, fl, call, ready, opts, clk) — handler flight
// `fl` run on with `ready`: its response answered when it returns (503 in
// its place past its deadline), its new wait watched when it parks again,
// its connection closed when it was cancelled.
function __handler_wake[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], fl: __Flight, call: async.Call[HttpRequest, platform.Host, HttpResponse], ready: i32, opts: Config, clk: __Clock): (__Conns, __Flight[]) {
  match (async.call_resume(call, ready)) {
    Done(resp) => {
      async.call_free(call);
      return (__serve_answer(drv, c, fl, __in_time(resp, fl.ends, monotonic_ns()), opts, clk), fls);
    },
    Suspended(w) => {
      return (c, fls.append(__flight_watch(drv, __Flight { ...fl, wait: w }, monotonic_ns())));
    },
    Cancelled => {
      async.call_free(call);
      return (__serve_abandon(drv, c, fl.fd), fls);
    }
  }
  return (c, fls);
}

// __background_wake(drv, fls, fl, t, ready) — background flight `fl` run
// on with `ready`: held again when it parks, freed when it ends.
function __background_wake[D: async.Driver](drv: D, fls: __Flight[], fl: __Flight, t: async.Task[i32], ready: i32): __Flight[] {
  match (async.task_resume(t, ready)) {
    Suspended(w) => {
      return fls.append(__flight_watch(drv, __Flight { ...fl, wait: w }, monotonic_ns()));
    },
    _ => {
      async.task_free(t);
    }
  }
  return fls;
}

// __serve_answer(drv, c, fl, resp, opts, clk) — the flight's response
// written on its connection, outside any burst (so it is never corked),
// and the request behind it, if one is framed, left as the connection's
// backlog for the next pass. A connection that went away meanwhile drops
// the response.
function __serve_answer[D: async.Driver](drv: D, c: __Conns, fl: __Flight, resp: HttpResponse, opts: Config, clk: __Clock): __Conns {
  let at: i32 = __conns_index(c, fl.fd);
  if (at < 0) {
    return c;
  }
  let behind: __Behind = fl.behind;
  match (fl.body) {
    Some(b) => {
      if (__upgrading(resp)) {
        return __serve_respond(drv, c, at, fl.method, fl.version, resp, false, opts, __pipeline_burst(), Idle, clk).0;
      }
      c = __body_settled(drv, c, at, b);
      behind = __serve_behind(http.http_parse_request_framed_from(c.bufs[at], c.offs[at], opts.limits, c.last), c.last).0;
    },
    None => {}
  }
  let answered: (__Conns, boolean) = __serve_respond(drv, c, at, fl.method, fl.version, resp, fl.kept && c.keep[at], opts, __pipeline_burst(), behind, clk);
  return __serve_finish(drv, answered.0, fl.fd, false, opts, clk);
}

// __upgrading(resp) — whether the response takes the connection over: a
// 101 whose body is the producer that runs the session.
function __upgrading(resp: HttpResponse): boolean {
  if (resp.status != 101) {
    return false;
  }
  match (resp.body) {
    BodyChunks(p) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// __upgrade_request(req) — whether the request is a WebSocket handshake
// (RFC 6455 §4.1: `Sec-WebSocket-Key`, `Upgrade`, and `upgrade` among the
// `Connection` tokens), the one upgrade the loop lends the connection for.
// Its body is the connection's bytes after the head, the session's once
// the handler answers 101, so it is streamed to the handler whatever
// `stream_bodies` says. An upgrade the loop cannot serve — no
// `Sec-WebSocket-Key` — is not matched here, so it reaches the handler as
// an ordinary request and the connection persists as any request's would;
// a matched handshake the handler declines (a response that is not a 101)
// is answered and its connection kept, as `__upgrade_head` says.
function __upgrade_request(req: HttpRequest): boolean {
  if (!req.headers.has("sec-websocket-key") || !req.headers.has("upgrade")) {
    return false;
  }
  for v in req.headers.get_all("connection") {
    for tok in v.split(",") {
      if (tok.trim().eq_ignore_ascii_case("upgrade")) {
        return true;
      }
    }
  }
  return false;
}

// __serve_abandon(drv, c, fd) — the connection `fd` closed, when it is
// still open: its handler was cancelled and answers nothing.
function __serve_abandon[D: async.Driver](drv: D, c: __Conns, fd: i32): __Conns {
  let at: i32 = __conns_index(c, fd);
  if (at < 0) {
    return c;
  }
  return __serve_close(drv, c, at);
}

// __flight_watch(drv, fl, now) — the flight waiting on `fl.wait`: each pair
// watched with its interest, the bound kept as the flight's due time.
function __flight_watch[D: async.Driver](drv: D, fl: __Flight, now: i64): __Flight {
  let w: async.Wait = fl.wait;
  let i: i32 = 0;
  while (i + 1 < w.set.len()) {
    let watched: i32 = drv.watch(w.set[i], w.set[i + 1]);
    i = i + 2;
  }
  let due: i64 = 0 - 1 as i64;
  if (w.timeout_ms >= 0) {
    due = now + w.timeout_ms as i64 * 1000000;
  }
  return __Flight { ...fl, set: w.set, due: due };
}

// __flight_unwatch(drv, fl) — the flight's pairs unwatched before it runs
// on or goes.
function __flight_unwatch[D: async.Driver](drv: D, fl: __Flight): void {
  let i: i32 = 0;
  while (i + 1 < fl.set.len()) {
    let unwatched: i32 = drv.unwatch(fl.set[i]);
    i = i + 2;
  }
}

// __flight_cancel(drv, fl) — the flight run on to its end with every wait
// answering `async.cancelled()`, and its record freed.
function __flight_cancel[D: async.Driver](drv: D, fl: __Flight): void {
  __flight_unwatch(drv, fl);
  match (fl.job) {
    Handler(call) => {
      let st: async.TaskStatus[HttpResponse] = async.call_cancel(call);
      async.call_free(call);
    },
    Producer(t) => {
      let st: async.TaskStatus[Option[u8[]]] = async.task_cancel(t);
      async.task_free(t);
    },
    Background(t) => {
      let st: async.TaskStatus[i32] = async.task_cancel(t);
      async.task_free(t);
    }
  }
}

// __flights_cancel(drv, fls) — every flight cancelled, as the loop ends.
function __flights_cancel[D: async.Driver](drv: D, fls: __Flight[]): void {
  for fl in fls {
    __flight_cancel(drv, fl);
  }
}

// __flight_index(fls, fd) — the flight watching descriptor `fd`, -1 for
// none.
function __flight_index(fls: __Flight[], fd: i32): i32 {
  let i: i32 = 0;
  while (i < fls.len()) {
    if (__flight_pair(fls[i], fd) >= 0) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

// __flight_pair(fl, fd) — the index of the pair in the flight's set whose
// descriptor is `fd`, -1 for none.
function __flight_pair(fl: __Flight, fd: i32): i32 {
  let i: i32 = 0;
  while (i + 1 < fl.set.len()) {
    if (fl.set[i] == fd) {
      return i / 2;
    }
    i = i + 2;
  }
  return -1;
}

// __flight_at(fls, fd) — the flight parked on connection `fd`, -1 for none.
function __flight_at(fls: __Flight[], fd: i32): i32 {
  let i: i32 = 0;
  while (i < fls.len()) {
    if (fls[i].fd == fd) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

function __flights_remove(fls: __Flight[], at: i32): __Flight[] {
  let out: __Flight[] = [];
  let i: i32 = 0;
  while (i < fls.len()) {
    if (i != at) {
      out = out.append(fls[i]);
    }
    i = i + 1;
  }
  return out;
}

// __flights_timeout(fls, now) — the milliseconds until the earliest bound
// a flight waits under (0 once one is due), -1 with none bounded.
function __flights_timeout(fls: __Flight[], now: i64): i32 {
  let best: i64 = 0 - 1 as i64;
  for fl in fls {
    best = __sooner(best, fl.due);
    best = __sooner(best, fl.idle);
    best = __sooner(best, fl.ends);
  }
  if (best < 0 as i64) {
    return -1;
  }
  if (best <= now) {
    return 0;
  }
  let ms: i64 = (best - now + 999999 as i64) / 1000000;
  if (ms > 2147483647 as i64) {
    return 2147483647;
  }
  return ms as i32;
}

// __sooner(a, b) — the sooner of two monotonic due times, -1 meaning none.
function __sooner(a: i64, b: i64): i64 {
  if (b < 0 as i64) {
    return a;
  }
  if (a < 0 as i64 || b < a) {
    return b;
  }
  return a;
}

// __least_timeout(a, b) — the sooner of two wait timeouts, -1 meaning none.
function __least_timeout(a: i32, b: i32): i32 {
  if (a < 0) {
    return b;
  }
  if (b < 0 || a < b) {
    return a;
  }
  return b;
}

// __flights_expire(drv, c, fls, opts, clk) — every handler whose request's
// deadline has passed cancelled and answered 503, every flight whose bound
// has passed run on with -1, the timeout answer, and every parked producer
// whose filler is due given it, as many times as one is due.
function __flights_expire[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], opts: Config, clk: __Clock): (__Conns, __Flight[]) {
  let again: boolean = true;
  while (again) {
    again = false;
    let now: i64 = monotonic_ns();
    let i: i32 = 0;
    while (i < fls.len() && !again) {
      if (fls[i].ends >= 0 as i64 && fls[i].ends <= now) {
        let late: (__Conns, __Flight[]) = __flight_overdue(drv, c, fls, i, opts, clk);
        c = late.0;
        fls = late.1;
        again = true;
      } else if (fls[i].due >= 0 as i64 && fls[i].due <= now) {
        let woke: (__Conns, __Flight[]) = __flight_wake(drv, c, fls, i, -1, opts, clk);
        c = woke.0;
        fls = woke.1;
        again = true;
      } else if (fls[i].idle >= 0 as i64 && fls[i].idle <= now) {
        let filled: (__Conns, __Flight[]) = __flight_filler(drv, c, fls, i, opts);
        c = filled.0;
        fls = filled.1;
        again = true;
      }
      i = i + 1;
    }
  }
  return (c, fls);
}

// __flight_overdue(drv, c, fls, i, opts, clk) — flight `i`, past the bound
// its request or its background work had, cancelled, and a handler's
// request answered 503 in place of the response it did not give.
function __flight_overdue[D: async.Driver](drv: D, c: __Conns, fls: __Flight[], i: i32, opts: Config, clk: __Clock): (__Conns, __Flight[]) {
  let late: __Flight = fls[i];
  __flight_cancel(drv, late);
  fls = __flights_remove(fls, i);
  match (late.job) {
    Handler(call) => {
      return (__serve_answer(drv, c, late, http.text(503, ""), opts, clk), fls);
    },
    _ => {}
  }
  return (c, fls);
}

// __host_platform — the platform the accept loops hand every handler: the
// host over the worker's reactor, 0 where the target has none, with this
// worker's cookie jar when the configuration asks for one. Built once per
// loop rather than per request, since no request can change it.
function __host_platform(reactor: i32, opts: Config): platform.Host {
  let host: platform.Host = platform.host();
  if (reactor >= 0) {
    host = platform.host_on(reactor);
  }
  match (opts.http_allow) {
    Some(a) => {
      host = host.with_allow(a);
    },
    None => {}
  }
  if (opts.cookie_jar) {
    return host.with_jar(cookie.jar());
  }
  return host;
}

// __init_platform() — the platform a handler program's `init(plat)` is
// handed: the host with no reactor, since it runs once in the supervising
// parent before any worker's loop exists.
function __init_platform(): platform.Host {
  return platform.host();
}

// __serve_loop — the HTTP/1.1 reactor loop factored out of `run`
// so `supervise` can run the same loop against a listener fd
// it does NOT create: the supervising parent owns the listening socket
// (created before the first fork, inherited by every worker), so the
// kernel backlog — and any pending connections in it — survives a worker
// death. Runs until SIGTERM or SIGINT: the shutdown drains, `on_stop` is handed
// `__stop_reason(stop)`, and the loop returns `__stop_code(stop)`; a
// listener the reactor cannot watch returns its -errno like a failed
// bind. `opts` bounds each connection's request read and its
// persistence.
function __serve_loop(listener: i32, handler: (HttpRequest, platform.Host) => HttpResponse, opts: Config, on_stop: (string) => void, snap: Option[Writer]): i32 {
  let drv: async.RealDriver = async.real_driver();
  let watched: i32 = drv.watch(listener, __listener_interest(opts));
  if (watched < 0) {
    return watched;
  }
  let accepting: boolean = true;
  let stop: __Stop = __serve_stop_sources(drv, opts);
  let plat: platform.Host = __host_platform(drv.handle(), opts);
  let host_for: (Option[net.SocketAddr]) => platform.Host = (peer: Option[net.SocketAddr]): platform.Host => plat.with_peer(peer);
  let conns: __Conns = __Conns { fds: [], bufs: [], offs: [], pending: [], deadlines: [], keep: [], served: [], backlog: [], continued: [], rate_since: [], rate_base: [], send_since: [], send_base: [], peers: [], hosts: [], tails: [], tls: [], framing: [], last: http.http_framed_none(), out: buf_new(4096), lent: 0 - 1, parked: [], later: [], metrics: metrics.server_metrics() };
  let flights: __Flight[] = [];
  let scratch: u8[] = __recv_scratch();
  let clk: __Clock = __Clock { sec: 0 as i64, line: "" };
  let events: i32[] = async.event_room(64);
  let ex: Option[metrics.Exporter] = __exporter(drv, opts, snap);
  // The streamed-body start, with the handler and platform bound once:
  // what `__serve_stream` runs a handler through, holding no platform of
  // its own (E080 reads a platform parameter as a handler's). It takes
  // the start apart and builds it again so the loop's own call, which
  // takes it apart, gets it in two words; the box is paid here, on the
  // streamed path, where the handler parks anyway.
  let start: (http.HttpFramed, boolean, __Stop, platform.Host) => __Started = (f: http.HttpFramed, kept: boolean, st: __Stop, host: platform.Host): __Started => __started_again(__serve_start(handler, host, f, kept, Idle, opts, st));
  while (true) {
    let now: i64 = monotonic_ns();
    events = __with_backlog(conns, drv.wait_into(events, __snapshot_timeout(snap, __stop_timeout(stop, opts, now, __least_timeout(__conns_timeout(conns, now), __flights_timeout(flights, now))))));
    let ends: i32 = async.ready_pairs(events) * 2;
    let second: i64 = clk.sec;
    clk = __clock_tick(clk);
    if (clk.sec != second) {
      __snapshot_send(snap, conns.metrics, opts);
    }
    let k: i32 = 0;
    while (k < ends) {
      let fd: i32 = events[k];
      let readiness: i32 = events[k + 1];
      k = k + 2;
      let sig: i32 = __stop_signal(fd);
      if (sig != 0) {
        stop = __stop_begin(stop, sig);
        continue;
      }
      if (__exporter_owns(ex, fd)) {
        ex = __scrape_wake(drv, ex, fd, __loop_exposition(conns.metrics, opts), !__serve_stopping(stop));
        continue;
      }
      if (fd == listener) {
        conns = __serve_accept(drv, listener, conns, opts, host_for);
        continue;
      }
      let fi: i32 = __flight_index(flights, fd);
      if (fi >= 0) {
        let woke: (__Conns, __Flight[]) = __flight_wake(drv, conns, flights, fi, __flight_pair(flights[fi], fd), opts, clk);
        conns = woke.0;
        flights = woke.1;
        let taken: (__Conns, __Flight[]) = __staged_taken(drv, conns, flights, opts);
        conns = taken.0;
        flights = taken.1;
        continue;
      }
      let busy: i32 = __flight_at(flights, fd);
      if (busy >= 0) {
        let held: (__Conns, __Flight[]) = __serve_held_event(drv, conns, flights, busy, fd, readiness, scratch, opts);
        conns = held.0;
        flights = held.1;
        let taken: (__Conns, __Flight[]) = __staged_taken(drv, conns, flights, opts);
        conns = taken.0;
        flights = taken.1;
        continue;
      }
      let ev: (__Conns, i32, boolean) = __serve_event(drv, conns, fd, scratch, opts, clk);
      conns = ev.0;
      let at: i32 = ev.1;
      if (at < 0) {
        continue;
      }
      let mode: i32 = __h2_mode(conns, at, opts);
      if (mode == H2_AWAITED) {
        continue;
      }
      if (mode == H2_SERVED) {
        conns = __serve_h2(drv, conns, at, handler, opts, ev.2);
        continue;
      }
      let more: boolean = true;
      let count: i32 = 0;
      let parsed: (__Behind, http.HttpFramed) = __serve_behind(http.http_parse_request_framed_from(conns.bufs[at], conns.offs[at], opts.limits, conns.last), conns.last);
      let behind: __Behind = parsed.0;
      let framed: http.HttpFramed = parsed.1;
      while (more) {
        let next: __Behind = Idle;
        let next_framed: http.HttpFramed = framed;
        match (behind) {
          Pipelined => {
            let f: http.HttpFramed = framed;
            if (__upgrade_request(f.request)) {
              let upgraded: (__Conns, __Flight[], boolean, __Behind, http.HttpFramed) = __serve_stream(drv, conns, flights, at, __upgrade_head(f), start, opts, stop, count, clk);
              conns = upgraded.0;
              flights = upgraded.1;
              more = false;
              continue;
            }
            let took: (__Conns, boolean, __Behind, http.HttpFramed) = __serve_took(conns, at, f, opts, ev.2, stop);
            conns = __serve_started(took.0, at);
            count = count + 1;
            match (__serve_start(handler, conns.hosts[at], f, took.1, took.2, opts, stop)) {
              HandlerDone(resp) => {
                let answered: (__Conns, boolean) = __serve_respond(drv, conns, at, f.request.method, f.version, resp, took.1, opts, count, took.2, clk);
                conns = answered.0;
                more = answered.1;
                next = took.2;
                next_framed = took.3;
              },
              HandlerParked(fl) => {
                let parked: (__Conns, __Flight[]) = __serve_park(drv, conns, flights, at, __flight_watch(drv, fl, monotonic_ns()), opts);
                conns = parked.0;
                flights = parked.1;
                more = false;
              }
            }
          },
          Idle => {
            let unframed: (__Conns, __Flight[], boolean, __Behind, http.HttpFramed) = __serve_unframed(drv, conns, flights, at, false, start, opts, stop, count, clk, ev.2);
            conns = unframed.0;
            flights = unframed.1;
            more = unframed.2;
            next = unframed.3;
            next_framed = unframed.4;
            if (more) {
              count = count + 1;
            }
          },
          Expecting => {
            let unframed: (__Conns, __Flight[], boolean, __Behind, http.HttpFramed) = __serve_unframed(drv, conns, flights, at, true, start, opts, stop, count, clk, ev.2);
            conns = unframed.0;
            flights = unframed.1;
            more = unframed.2;
            next = unframed.3;
            next_framed = unframed.4;
            if (more) {
              count = count + 1;
            }
          },
          Illformed(status) => {
            conns = __serve_refuse(drv, conns, at, status, opts, clk);
            more = false;
          }
        }
        behind = next;
        framed = next_framed;
      }
      conns = __serve_settle(drv, conns, flights, fd, ev.2, opts, clk);
      let taken: (__Conns, __Flight[]) = __staged_taken(drv, conns, flights, opts);
      conns = taken.0;
      flights = taken.1;
    }
    let due: (__Conns, __Flight[]) = __flights_expire(drv, conns, flights, opts, clk);
    conns = due.0;
    flights = due.1;
    let woken: (__Conns, __Flight[]) = __staged_taken(drv, conns, flights, opts);
    conns = woken.0;
    flights = woken.1;
    let ended: (__Conns, __Stop, boolean, boolean) = __serve_pass_end(drv, listener, conns, opts, stop, accepting, flights.len());
    conns = ended.0;
    stop = ended.1;
    accepting = ended.2;
    if (ended.3) {
      __flights_cancel(drv, flights);
      __exporter_close(drv, ex);
      drv.close();
      buf_free(conns.out);
      on_stop(__stop_reason(stop));
      return __stop_code(stop);
    }
  }
  // A bounded loop (the census fixtures) hands the listener back with
  // nothing watching it: on wasm a socket still subscribed cannot close.
  if (accepting) {
    drv.unwatch(listener);
  }
  __exporter_close(drv, ex);
  drv.close();
  buf_free(conns.out);
  return 0;
}

// __serve_loop_with — `__serve_loop` threading a caller-owned state
// value through the handler chain. The state lives in the loop frame,
// so it is process-lifetime without any language-level global: each
// request sees the value the previous one returned.
function __serve_loop_with[S](listener: i32, init: S, handler: (S, HttpRequest, platform.Host) => (S, HttpResponse), opts: Config, on_stop: (string, S) => void, snap: Option[Writer]): i32 {
  let st: S = init;
  let drv: async.RealDriver = async.real_driver();
  let watched: i32 = drv.watch(listener, __listener_interest(opts));
  if (watched < 0) {
    return watched;
  }
  let accepting: boolean = true;
  let stop: __Stop = __serve_stop_sources(drv, opts);
  let plat: platform.Host = __host_platform(drv.handle(), opts);
  let host_for: (Option[net.SocketAddr]) => platform.Host = (peer: Option[net.SocketAddr]): platform.Host => plat.with_peer(peer);
  let conns: __Conns = __Conns { fds: [], bufs: [], offs: [], pending: [], deadlines: [], keep: [], served: [], backlog: [], continued: [], rate_since: [], rate_base: [], send_since: [], send_base: [], peers: [], hosts: [], tails: [], tls: [], framing: [], last: http.http_framed_none(), out: buf_new(4096), lent: 0 - 1, parked: [], later: [], metrics: metrics.server_metrics() };
  let flights: __Flight[] = [];
  let scratch: u8[] = __recv_scratch();
  let clk: __Clock = __Clock { sec: 0 as i64, line: "" };
  let events: i32[] = async.event_room(64);
  let ex: Option[metrics.Exporter] = __exporter(drv, opts, snap);
  while (true) {
    let now: i64 = monotonic_ns();
    events = __with_backlog(conns, drv.wait_into(events, __snapshot_timeout(snap, __stop_timeout(stop, opts, now, __least_timeout(__conns_timeout(conns, now), __flights_timeout(flights, now))))));
    let ends: i32 = async.ready_pairs(events) * 2;
    let second: i64 = clk.sec;
    clk = __clock_tick(clk);
    if (clk.sec != second) {
      __snapshot_send(snap, conns.metrics, opts);
    }
    let k: i32 = 0;
    while (k < ends) {
      let fd: i32 = events[k];
      let readiness: i32 = events[k + 1];
      k = k + 2;
      let sig: i32 = __stop_signal(fd);
      if (sig != 0) {
        stop = __stop_begin(stop, sig);
        continue;
      }
      if (__exporter_owns(ex, fd)) {
        ex = __scrape_wake(drv, ex, fd, __loop_exposition(conns.metrics, opts), !__serve_stopping(stop));
        continue;
      }
      if (fd == listener) {
        conns = __serve_accept(drv, listener, conns, opts, host_for);
        continue;
      }
      let fi: i32 = __flight_index(flights, fd);
      if (fi >= 0) {
        let woke: (__Conns, __Flight[]) = __flight_wake(drv, conns, flights, fi, __flight_pair(flights[fi], fd), opts, clk);
        conns = woke.0;
        flights = woke.1;
        let taken: (__Conns, __Flight[]) = __staged_taken(drv, conns, flights, opts);
        conns = taken.0;
        flights = taken.1;
        continue;
      }
      let busy: i32 = __flight_at(flights, fd);
      if (busy >= 0) {
        let held: (__Conns, __Flight[]) = __serve_held_event(drv, conns, flights, busy, fd, readiness, scratch, opts);
        conns = held.0;
        flights = held.1;
        let taken: (__Conns, __Flight[]) = __staged_taken(drv, conns, flights, opts);
        conns = taken.0;
        flights = taken.1;
        continue;
      }
      let ev: (__Conns, i32, boolean) = __serve_event(drv, conns, fd, scratch, opts, clk);
      conns = ev.0;
      let at: i32 = ev.1;
      if (at < 0) {
        continue;
      }
      let more: boolean = true;
      let count: i32 = 0;
      let parsed: (__Behind, http.HttpFramed) = __serve_behind(http.http_parse_request_framed_from(conns.bufs[at], conns.offs[at], opts.limits, conns.last), conns.last);
      let behind: __Behind = parsed.0;
      let framed: http.HttpFramed = parsed.1;
      while (more) {
        let next: __Behind = Idle;
        let next_framed: http.HttpFramed = framed;
        match (behind) {
          Pipelined => {
            let f: http.HttpFramed = framed;
            let took: (__Conns, boolean, __Behind, http.HttpFramed) = __serve_took(conns, at, f, opts, ev.2, stop);
            conns = took.0;
            count = count + 1;
            conns = __serve_started(conns, at);
            let stepped: (S, HttpResponse) = (st, http.text(503, ""));
            if (!__serve_not_ready(f, opts, stop)) {
              stepped = __serve_step(handler, st, f.request, conns.hosts[at], opts);
            }
            st = stepped.0;
            let answered: (__Conns, boolean) = __serve_respond(drv, conns, at, f.request.method, f.version, stepped.1, took.1, opts, count, took.2, clk);
            conns = answered.0;
            more = answered.1;
            next = took.2;
            next_framed = took.3;
          },
          Idle => {
            more = false;
          },
          Expecting => {
            conns = __serve_continue(drv, conns, at, opts);
            more = false;
          },
          Illformed(status) => {
            conns = __serve_refuse(drv, conns, at, status, opts, clk);
            more = false;
          }
        }
        behind = next;
        framed = next_framed;
      }
      conns = __serve_finish(drv, conns, fd, ev.2, opts, clk);
      let taken: (__Conns, __Flight[]) = __staged_taken(drv, conns, flights, opts);
      conns = taken.0;
      flights = taken.1;
    }
    let due: (__Conns, __Flight[]) = __flights_expire(drv, conns, flights, opts, clk);
    conns = due.0;
    flights = due.1;
    let woken: (__Conns, __Flight[]) = __staged_taken(drv, conns, flights, opts);
    conns = woken.0;
    flights = woken.1;
    let ended: (__Conns, __Stop, boolean, boolean) = __serve_pass_end(drv, listener, conns, opts, stop, accepting, flights.len());
    conns = ended.0;
    stop = ended.1;
    accepting = ended.2;
    if (ended.3) {
      __flights_cancel(drv, flights);
      __exporter_close(drv, ex);
      drv.close();
      buf_free(conns.out);
      on_stop(__stop_reason(stop), st);
      return __stop_code(stop);
    }
  }
  // A bounded loop (the census fixtures) hands the listener back with
  // nothing watching it: on wasm a socket still subscribed cannot close.
  if (accepting) {
    drv.unwatch(listener);
  }
  __exporter_close(drv, ex);
  drv.close();
  buf_free(conns.out);
  return 0;
}

// supervise(port, opts, handler) — `run` under a supervising
// parent (docs/CRASH-ONLY-SERVE.md): the listener is made here, before
// the first fork, and every worker inherits it, so pending connections
// survive a worker's death; a worker that dies is logged and forked
// again under a bounded backoff, and eight deaths within 100 ms of
// their forks in a row give up with the last exit code. Serves
// single-process where there is no fork (the interpreter).
// `opts.workers` workers are forked (below 1: one
// per processing unit), each running its own loop over the one
// listener, watched exclusively so a connection wakes one of them — or,
// with `reuse_port`, over a listener of its own bound beside the others'
// (`__per_worker_listeners`); whichever dies is replaced, the backoff
// and the fast-death count shared among them. SIGTERM or SIGINT is
// forwarded to every worker and the supervisor waits for them, exiting with the
// worst code they answered (1 when one cut a request off).
pub function supervise(port: i32, opts: Config, handler: (HttpRequest, platform.Host) => HttpResponse): i32 {
  return supervise_shutdown(port, opts, handler, (reason: string): void => {});
}

// supervise_shutdown(port, opts, handler, shutdown) —
// `supervise` with a hook each worker's loop calls once
// it has stopped, as `run_shutdown` does: with `opts.workers`
// workers it runs once per worker.
pub function supervise_shutdown(port: i32, opts: Config, handler: (HttpRequest, platform.Host) => HttpResponse, shutdown: (string) => void): i32 {
  return __supervise(port, opts, (fd: i32, worker_opts: Config, snap: Option[Writer]): i32 => __serve_loop(fd, handler, worker_opts, shutdown, snap));
}

// supervise_with(port, opts, init, handler) —
// `supervise` threading a state through the handler
// chain as `run_with` does. The state is built once, before the
// first fork, and every worker inherits a copy: what one worker's
// requests make of it is that worker's alone, and a worker forked again
// after a death starts from the copy `init` was, not from where the
// dead one left it.
pub function supervise_with[S](port: i32, opts: Config, init: S, handler: (S, HttpRequest, platform.Host) => (S, HttpResponse)): i32 {
  return supervise_with_shutdown(port, opts, init, handler, (reason: string, state: S): void => {});
}

// supervise_with_shutdown(port, opts, init, handler, shutdown)
// — `supervise_with` with a hook each worker's loop calls once
// it has stopped, with the reason and the state as that worker's last
// request left it.
pub function supervise_with_shutdown[S](port: i32, opts: Config, init: S, handler: (S, HttpRequest, platform.Host) => (S, HttpResponse), shutdown: (string, S) => void): i32 {
  return __supervise(port, opts, (fd: i32, worker_opts: Config, snap: Option[Writer]): i32 => __serve_loop_with(fd, init, handler, worker_opts, shutdown, snap));
}

// __supervise(port, opts, worker) — the supervisor every `supervise*`
// entry is: `worker(listener, opts, snap)` is a worker's whole life, a
// serve loop over the listener it is handed, shipping its metrics down the
// pipe `snap` (-1 for none) once a second, answering the code the worker
// exits with. With `Config.metrics_port` the supervisor answers scrapes
// there from the workers' latest snapshots (std/metrics `merge`).
function __supervise(port: i32, opts: Config, worker: (i32, Config, Option[Writer]) => i32): i32 {
  // Listener FIRST, in the parent — the whole design hinges on
  // workers inheriting this fd rather than owning it. Per-worker
  // listeners are the opt-in that gives that up: each worker binds
  // its own once forked.
  let listener: i32 = 0 - 1;
  if (!__per_worker_listeners(opts)) {
    let l: __Listen = __serve_listener(port, opts);
    if (l.fd < 0) {
      return __listen_failed(l);
    }
    listener = l.fd;
  }
  let workers: i32 = opts.workers;
  if (workers < 1) {
    workers = cpu_count();
  }
  if (workers < 1) {
    workers = 1;
  }
  let resolved: Config = Config { ...opts, workers: workers };
  let sup: __Supervisor = __Supervisor { pids: [], spawned: [], pipes: [], partial: [], snaps: [], backoff_ms: 100 as i64, fork_after: 0 as i64, fast_deaths: 0, stopping: false, worst: 0, crashed: 0 };
  let drv: async.RealDriver = async.real_driver();
  let chld: i32 = drv.watch_signal(17);
  if (chld < 0) {
    return chld;
  }
  drv.watch_signal(15);
  drv.watch_signal(2);
  // The scrape exporter is opened once a worker has forked: where there is
  // no fork the worker's loop runs in this process and opens it itself.
  let ex: Option[metrics.Exporter] = None;
  while (true) {
    let refork_ms: i32 = -1;
    if (!sup.stopping && sup.pids.len() < workers) {
      let wait_ms: i64 = sup.fork_after - now_unix_ms();
      if (wait_ms <= 0 as i64) {
        let forked: (__Supervisor, i32) = __supervisor_fork(drv, port, listener, worker, resolved, sup);
        sup = forked.0;
        if (forked.1 != 0 - 1) {
          return forked.1;
        }
        if (opts.metrics_port > 0 && !__exporter_up(ex) && sup.pids.len() == 1) {
          ex = __exporter(drv, opts, None);
          if (!__exporter_up(ex)) {
            __supervisor_abandon(drv, sup);
            drv.close();
            return 98;
          }
        }
        continue;
      }
      refork_ms = wait_ms as i32;
    }
    if (sup.stopping && sup.pids.len() == 0) {
      __exporter_close(drv, ex);
      drv.close();
      return sup.worst;
    }
    // Parent: supervise. A child's death and SIGTERM both arrive as
    // readiness events; a death is reaped by probing every worker. A
    // refork the backoff holds back is what the wait's deadline is.
    let events: i32[] = drv.wait(8, refork_ms);
    sup = __supervisor_events(sup, events);
    ex = __supervisor_scrapes(drv, ex, events, sup);
    if (sup.gave_up()) {
      __supervisor_abandon(drv, sup);
      __exporter_close(drv, ex);
      drv.close();
      return sup.crashed;
    }
  }
  return 0;
}

// __supervisor_events(sup, events) — the wait's events acted on: SIGTERM
// or SIGINT forwarded, SIGCHLD (-17) reaped, a worker's pipe read for the
// snapshots it carries.
function __supervisor_events(sup: __Supervisor, events: i32[]): __Supervisor {
  let k: i32 = 0;
  while (k + 1 < events.len()) {
    let fd: i32 = events[k];
    k = k + 2;
    let sig: i32 = __stop_signal(fd);
    if (sig != 0) {
      sup = __supervisor_stop(sup, sig);
    }
    if (fd == 0 - 17) {
      sup = __supervisor_reap(sup);
    }
    let pipe: i32 = __index_of_i32(sup.pipes, fd);
    if (fd >= 0 && pipe >= 0) {
      sup = __supervisor_snapshot(sup, pipe);
    }
  }
  return sup;
}

// __supervisor_snapshot(sup, i) — worker `i`'s pipe read: what it holds is
// added to the bytes read before, and the last complete snapshot in them
// becomes the worker's.
function __supervisor_snapshot(sup: __Supervisor, i: i32): __Supervisor {
  let got: u8[] = tcp_recv(sup.pipes[i], 65536);
  if (got.len() == 0) {
    return sup;
  }
  let framed: (string[], string) = metrics.frames(sup.partial[i] + string_from_bytes_unchecked(got));
  sup = __Supervisor { ...sup, partial: sup.partial.with(i, framed.1) };
  if (framed.0.len() > 0) {
    sup = __Supervisor { ...sup, snaps: sup.snaps.with(i, framed.0[framed.0.len() - 1]) };
  }
  return sup;
}

// __supervisor_scrapes(drv, ex, events, sup) — the exporter's events acted
// on: a scrape is answered from the workers' latest snapshots summed, and
// `/readyz` says the pool is ready while a worker is alive and no stop has
// begun.
function __supervisor_scrapes(drv: async.RealDriver, ex: Option[metrics.Exporter], events: i32[], sup: __Supervisor): Option[metrics.Exporter] {
  let k: i32 = 0;
  while (k + 1 < events.len()) {
    let fd: i32 = events[k];
    k = k + 2;
    if (__exporter_owns(ex, fd)) {
      ex = __scrape_wake(drv, ex, fd, metrics.merge(sup.snaps), !sup.stopping && sup.pids.len() > 0);
    }
  }
  return ex;
}

function __index_of_i32(xs: i32[], x: i32): i32 {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == x) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

// __supervisor_fork(drv, port, listener, worker, opts, sup) — one more
// worker forked and recorded: `(sup, -1)`, or `(sup, code)` for the
// supervisor to return with: a fork the host refuses, or the loop's own
// result where there is no fork at all (ENOSYS: the interpreter), which
// serves single-process instead. The child runs `worker` over the
// inherited listener, or one of its own where `listener` is none
// (`__worker_listener`), shuts down when the supervisor dies
// (`stop_with_parent`), and exits with its code rather than returning
// into a second supervision loop; the reactor is the parent's, shared
// across the fork, so the child only closes its copy, since an unwatch
// would take the parent's signals out of the set the parent waits on.
function __supervisor_fork(drv: async.RealDriver, port: i32, listener: i32, worker: (i32, Config, Option[Writer]) => i32, opts: Config, sup: __Supervisor): (__Supervisor, i32) {
  let snap: Option[Pipe] = __snapshot_pipe(opts);
  let pid: i32 = proc_fork();
  if (pid == -38) {
    eprint("serve: supervision unavailable; serving single-process");
    __snapshot_pipe_close(snap);
    drv.unwatch_signal(17);
    drv.unwatch_signal(15);
    drv.unwatch_signal(2);
    drv.close();
    let single: __Listen = __worker_listener(port, listener, opts);
    if (single.fd < 0) {
      return (sup, __listen_failed(single));
    }
    return (sup, worker(single.fd, Config { ...opts, workers: 1 }, None));
  }
  if (pid < 0) {
    __snapshot_pipe_close(snap);
    return (sup, pid);
  }
  if (pid == 0) {
    drv.close();
    let own: __Listen = __worker_listener(port, listener, opts);
    if (own.fd < 0) {
      exit(__listen_failed(own));
    }
    let loop_opts: Config = Config { ...opts, stop_with_parent: true };
    if (listener < 0) {
      loop_opts = Config { ...loop_opts, workers: 1 };
    }
    exit(worker(own.fd, loop_opts, __snapshot_writer(snap)));
    return (sup, 0);
  }
  let read_end: i32 = 0 - 1;
  match (snap) {
    Some(q) => {
      q.w.close();
      drv.watch(q.r.fd, 1);
      read_end = q.r.fd;
    },
    None => {}
  }
  return (__Supervisor { ...sup, pids: sup.pids.append(pid), spawned: sup.spawned.append(now_unix_ms()), pipes: sup.pipes.append(read_end), partial: sup.partial.append(""), snaps: sup.snaps.append("") }, 0 - 1);
}

// __snapshot_pipe(opts) — the pipe a worker ships its metrics snapshots
// down, when `Config.metrics_port` asks for them; None otherwise. The
// write end does not block: a snapshot the supervisor has not drained room
// for is dropped, never a stall of the worker behind it.
function __snapshot_pipe(opts: Config): Option[Pipe] {
  if (opts.metrics_port <= 0) {
    return None;
  }
  match (pipe()) {
    Ok(q) => {
      tcp_socket_ctl(q.w.fd, 3, 1);
      return Some(q);
    },
    Err(e) => {
      return None;
    }
  }
  return None;
}

// __snapshot_writer(snap) — the worker's end of the pipe, the read end
// closed since the worker never reads it.
function __snapshot_writer(snap: Option[Pipe]): Option[Writer] {
  match (snap) {
    Some(q) => {
      q.r.close();
      return Some(q.w);
    },
    None => {
      return None;
    }
  }
  return None;
}

function __snapshot_pipe_close(snap: Option[Pipe]): void {
  match (snap) {
    Some(q) => {
      q.r.close();
      q.w.close();
    },
    None => {}
  }
}

// __snapshot_timeout(snap, timeout) — the loop's wait bounded to a second
// while it has a pipe to ship snapshots down.
function __snapshot_timeout(snap: Option[Writer], timeout: i32): i32 {
  match (snap) {
    Some(w) => {
      return __least_timeout(timeout, 1000);
    },
    None => {
      return timeout;
    }
  }
  return timeout;
}

// __snapshot_send(snap, m, opts) — the loop's exposition, ended by the
// EOF line, written down the pipe; nothing without one.
function __snapshot_send(snap: Option[Writer], m: metrics.ServerMetrics, opts: Config): void {
  match (snap) {
    Some(w) => {
      w.write(__loop_exposition(m, opts) + metrics.EOF);
    },
    None => {}
  }
}

// __loop_exposition(m, opts) — what one loop exposes: what it counted
// itself, then the program's registry.
function __loop_exposition(m: metrics.ServerMetrics, opts: Config): string {
  return m.render() + opts.metrics.render();
}

// __exporter(drv, opts, snap) — the scrape exporter a loop answers itself,
// on `Config.metrics_port`, when it has no supervisor to ship snapshots to
// (no `snap` pipe): `run`'s loop, the supervisor itself, and the single
// process `supervise` falls back to where there is no fork. None when the
// port is 0 or the bind failed, which is logged as a listen failure.
function __exporter(drv: async.RealDriver, opts: Config, snap: Option[Writer]): Option[metrics.Exporter] {
  if (opts.metrics_port <= 0 || __snapshot_timeout(snap, 0 - 1) >= 0) {
    return None;
  }
  match (metrics.listen(drv, opts.metrics_port)) {
    Ok(e) => {
      return Some(e);
    },
    Err(code) => {
      eprint("serve: cannot listen for metrics on port " + int.int_to_string(opts.metrics_port) + ": " + net.error_from_errno(code).message());
      return None;
    }
  }
  return None;
}

function __exporter_up(ex: Option[metrics.Exporter]): boolean {
  match (ex) {
    Some(e) => {
      return true;
    },
    None => {
      return false;
    }
  }
  return false;
}

function __exporter_owns(ex: Option[metrics.Exporter], fd: i32): boolean {
  match (ex) {
    Some(e) => {
      return e.owns(fd);
    },
    None => {
      return false;
    }
  }
  return false;
}

// __scrape_wake(drv, ex, fd, text, ready) — the exporter's event on `fd`
// answered: `/metrics` with `text`, `/readyz` by `ready`.
function __scrape_wake(drv: async.RealDriver, ex: Option[metrics.Exporter], fd: i32, text: string, ready: boolean): Option[metrics.Exporter] {
  match (ex) {
    Some(e) => {
      return Some(e.wake(drv, fd, (path: string): HttpResponse => metrics.scrape(path, (): string => text, ready)));
    },
    None => {
      return None;
    }
  }
  return None;
}

function __exporter_close(drv: async.RealDriver, ex: Option[metrics.Exporter]): void {
  match (ex) {
    Some(e) => {
      e.close(drv);
    },
    None => {}
  }
}

// __per_worker_listeners(opts) — whether each worker binds a listener of
// its own rather than inheriting the supervisor's: the `reuse_port`
// opt-in, unless the process was handed its listener (`LISTEN_FDS`),
// which there is only one of. The kernel spreads connections over the
// group's listeners, by the CPU each arrived on where the host can steer
// (`tcp_socket_ctl` op 8, Linux), by its own hash elsewhere; what a
// worker's listener holds unaccepted when the worker dies is lost with
// it unless the kernel migrates it (`net.ipv4.tcp_migrate_req`), where
// the inherited listener keeps it for the next worker.
function __per_worker_listeners(opts: Config): boolean {
  if (!opts.reuse_port) {
    return false;
  }
  match (env("LISTEN_FDS")) {
    Some(n) => {
      return false;
    },
    None => {
      return true;
    }
  }
  return true;
}

// __worker_listener(port, listener, opts) — the listener a worker serves:
// the inherited one, or its own beside the other workers' (SO_REUSEPORT,
// steered by CPU where the host can, which every socket of the group
// then shares).
function __worker_listener(port: i32, listener: i32, opts: Config): __Listen {
  if (listener >= 0) {
    return __Listen { fd: listener, addr: "" };
  }
  let own: __Listen = __serve_listener(port, opts);
  if (own.fd >= 0) {
    tcp_socket_ctl(own.fd, 8, 0);
  }
  return own;
}

// __Supervisor — the supervisor's workers (pids, and when each was
// forked), its refork backoff and the time before which nothing is
// forked again, its consecutive fast-death count, whether a stop signal
// has been forwarded, the worst exit code a worker answered while stopping
// (the clean shutdown's exit) and the last code a worker died with while
// serving (a give-up's exit).
struct __Supervisor { pids: i32[], spawned: i64[], pipes: i32[], partial: string[], snaps: string[], backoff_ms: i64, fork_after: i64, fast_deaths: i32, stopping: boolean, worst: i32, crashed: i32 }

// `.gave_up()` — eight consecutive fast deaths: the supervisor exits with
// the last one's code rather than spinning.
function (s: __Supervisor) gave_up(): boolean {
  return s.fast_deaths >= 8;
}

// __supervisor_abandon(drv, sup) — the pool stopped after a give-up: the
// fast deaths were counted over every worker, so others may be alive,
// holding the listener with nothing left to refork them. SIGTERM to each,
// up to five seconds for them to drain, then SIGKILL for the rest, every
// one reaped before the supervisor returns.
function __supervisor_abandon(drv: async.RealDriver, sup: __Supervisor): void {
  let s: __Supervisor = __supervisor_stop(sup, 15);
  let until: i64 = now_unix_ms() + 5000 as i64;
  while (s.pids.len() > 0) {
    let left: i64 = until - now_unix_ms();
    if (left <= 0 as i64) {
      break;
    }
    drv.wait(8, left as i32);
    s = __supervisor_reap(s);
  }
  for pid in s.pids {
    match (signal_send(pid, 9)) {
      Ok(_) => {},
      Err(_) => {}
    }
  }
  while (s.pids.len() > 0) {
    drv.wait(8, 50);
    s = __supervisor_reap(s);
  }
}

// __supervisor_stop(sup, sig) — the stop signal forwarded to every
// worker, each of which drains and exits; nothing is forked again.
function __supervisor_stop(sup: __Supervisor, sig: i32): __Supervisor {
  if (sup.stopping) {
    return sup;
  }
  for pid in sup.pids {
    match (signal_send(pid, sig)) {
      Ok(_) => {},
      Err(_) => {}
    }
  }
  return __Supervisor { ...sup, stopping: true };
}

// __supervisor_reap(sup) — every worker that has exited reaped: a death
// while serving is logged with the raw exit code (134 = trap, 137 =
// arena exhaustion, 101 = todo, 1 = assert), kept as the last crash and
// counted against the backoff, which sets the time before which the loop
// forks no replacement; a death after SIGTERM is the worker's shutdown,
// and its code is the worst the shutdown answers.
function __supervisor_reap(sup: __Supervisor): __Supervisor {
  let i: i32 = 0;
  while (i < sup.pids.len()) {
    let code: i32 = proc_waitpid_nohang(sup.pids[i]);
    if (code == 0 - 1) {
      i = i + 1;
      continue;
    }
    if (code < 0) {
      code = 0 - code;
    }
    let lived_ms: i64 = now_unix_ms() - sup.spawned[i];
    if (sup.pipes[i] >= 0) {
      tcp_close(sup.pipes[i]);
    }
    sup = __Supervisor { ...sup, pids: __without_index_i32(sup.pids, i), spawned: __without_index_i64(sup.spawned, i), pipes: __without_index_i32(sup.pipes, i), partial: __without_index_str(sup.partial, i), snaps: __without_index_str(sup.snaps, i) };
    if (sup.stopping) {
      if (code > sup.worst) {
        sup = __Supervisor { ...sup, worst: code };
      }
      continue;
    }
    eprint("serve: worker died with exit code " + int.int_to_string(code) + "; restarting");
    sup = __Supervisor { ...sup, crashed: code };
    if (lived_ms < 100 as i64) {
      sup = __Supervisor { ...sup, fast_deaths: sup.fast_deaths + 1 };
      if (sup.gave_up()) {
        eprint("serve: giving up after 8 consecutive fast worker deaths");
        return sup;
      }
    } else {
      sup = __Supervisor { ...sup, fast_deaths: 0, backoff_ms: 100 as i64 };
    }
    let next: i64 = sup.backoff_ms * (2 as i64);
    if (next > 5000 as i64) {
      next = 5000 as i64;
    }
    sup = __Supervisor { ...sup, fork_after: now_unix_ms() + sup.backoff_ms, backoff_ms: next };
  }
  return sup;
}

function __without_index_i32(xs: i32[], at: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i != at) {
      out = out.append(xs[i]);
    }
    i = i + 1;
  }
  return out;
}

function __without_index_str(xs: string[], at: i32): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i != at) {
      out = out.append(xs[i]);
    }
    i = i + 1;
  }
  return out;
}

function __without_index_i64(xs: i64[], at: i32): i64[] {
  let out: i64[] = [];
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i != at) {
      out = out.append(xs[i]);
    }
    i = i + 1;
  }
  return out;
}

// Pull a port number out of an env var. Returns the parsed
// integer on success, -1 on missing / malformed / out-of-
// range. Used by the auto-`main()`-from-`handle()` synthesis
// so handler-shaped programs can be tuned via `PORT=N ./bin`
// without writing a manual main().
//
// Inline i32-only digit accumulation rather than std/string's
// `s.parse_int()` (which uses i64 for overflow safety and would
// pull that module in just for a port number). The result is
// bounded to a valid TCP port (0..65535), so i32 suffices.
function __port_from_env(name: string, fallback: i32): i32 {
  match (env(name)) {
    Some(s) => {
      let n: i32 = 0;
      let i: i32 = 0;
      while (i < s.len()) {
        let b: i32 = s[i] as i32;
        if (b < 48 || b > 57) {
          return fallback;
        }
        n = n * 10 + (b - 48);
        if (n > 65535) {
          return fallback;
        }
        i = i + 1;
      }
      if (i == 0) {
        return fallback;
      }
      return n;
    },
    None => {
      return fallback;
    }
  }
}
