// std/headers — HTTP HeaderMap with case-insensitive lookup,
// multi-valued entries, and insertion-ordered iteration.
//
// Backs the `headers: HeaderMap` field that's slated to land on
// `HttpRequest` and `HttpResponse` (docs/STDLIB-DESIGN-RESEARCH.md
// Rec §2). This PR lands the type + methods only; the HttpRequest
// / HttpResponse wiring + the wasi-http canonical-ABI fields-
// resource integration follow in their own reviewable units.
//
// Storage: two parallel arrays. `names` holds each name as it was
// given, and lookups compare names ASCII-case-insensitively (field
// names are case-insensitive, RFC 9110 §5.1), so nothing is copied
// to fold them. `values` holds the raw value at the matching index
// in insertion order. Linear-scan lookup is fine for the typical
// <20-header request, matches the spirit of hyper's HeaderMap, and
// avoids the IndexMap indexing-table overhead until profiling says
// otherwise.
//
// Invariants:
//   - `len(h.names) == len(h.values)`.
//   - Iteration / append order is insertion order; `.set`
//     replaces in-place at the existing index, with the spelling
//     the caller passed, and drops any additional duplicates
//     further down.

import "std/string";
import "core/map";

// `header_map_new()` — empty HeaderMap. Use when constructing
// HttpRequest / HttpResponse from lang code (the wasi-http
// wrapper + http_parse_request will populate one for you on the
// inbound path once the integration PR lands).
pub function header_map_new(): HeaderMap {
  let names: string[] = [];
  let values: string[] = [];
  return HeaderMap { names: names, values: values };
}

// `.get(name)` — first value for `name`, case-insensitive. Returns
// None when no entry matches; use `.get_all` when duplicates
// matter (`Set-Cookie`, `Accept`, `Via`).
pub function (h: HeaderMap) get(name: string): Option[string] {
  let i: i32 = 0;
  while (i < h.names.len()) {
    if (h.names[i].eq_ignore_ascii_case(name)) {
      return Some(h.values[i]);
    }
    i = i + 1;
  }
  return None;
}

// `.get_all(name)` — every value for `name` in insertion order.
// Returns an empty array when no entry matches (callers
// shouldn't need to special-case "missing" separately from
// "present but empty list").
pub function (h: HeaderMap) get_all(name: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < h.names.len()) {
    if (h.names[i].eq_ignore_ascii_case(name)) {
      out = out.append(h.values[i]);
    }
    i = i + 1;
  }
  return out;
}

// `.append(name, value)` — add an entry without replacing
// existing entries with the same name. The canonical "I want
// duplicate-safe insertion" call (`headers.append("Set-Cookie",
// "...")` keeps each cookie distinct).
pub function (h: HeaderMap) append(name: string, value: string): HeaderMap {
  return HeaderMap {
    ...h,
    names: h.names.append(name),
    values: h.values.append(value),
  };
}

// `.set(name, value)` — replace any/all existing entries for
// `name` with a single new entry. Position-stable: if `name`
// already existed at index k, the new value lands at index k and
// further duplicates are dropped; if `name` was absent, the new
// entry appends.
pub function (h: HeaderMap) set(name: string, value: string): HeaderMap {
  let new_names: string[] = [];
  let new_values: string[] = [];
  let inserted: boolean = false;
  let i: i32 = 0;
  while (i < h.names.len()) {
    if (h.names[i].eq_ignore_ascii_case(name)) {
      if (!inserted) {
        new_names = new_names.append(name);
        new_values = new_values.append(value);
        inserted = true;
      }
    } else {
      new_names = new_names.append(h.names[i]);
      new_values = new_values.append(h.values[i]);
    }
    i = i + 1;
  }
  if (!inserted) {
    new_names = new_names.append(name);
    new_values = new_values.append(value);
  }
  return HeaderMap { ...h, names: new_names, values: new_values };
}

// `.len()` — total entries (duplicates counted separately).
// `h = h.set("Set-Cookie", "a"); h = h.append("Set-Cookie",
// "b"); h.len()` is 2. (set/append are functional — rebind.)
pub function (h: HeaderMap) len(): i32 {
  return h.names.len();
}
