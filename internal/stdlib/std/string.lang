// std/string — string receiver methods.
//
// Methods are migrated here gradually from the auto-injected
// magic prelude per docs/PRELUDE-TO-MODULES.md. Files declare
// `import "std/string";` to bring the methods into scope.
// During the transition the prelude itself does the same import
// so existing single-file programs keep working unchanged.

// `s.is_empty()` is a length-zero shorthand. The IR's len fold
// resolves `len(s)` to a single i32.load at compile time when
// `s` is statically known to be a string, so this typically
// folds to one i32.eqz at the call site.
pub function (s: string) is_empty(): boolean {
    return len(s) == 0;
}

// `(s: string) to_string()` — identity on strings. Lets the
// f-string lexer's blanket `(<expr>).to_string()` desugar work
// uniformly on every interpolant, regardless of whether the
// interpolant is already a string. Has no runtime cost: the IR's
// inliner collapses the call to its operand.
pub function (s: string) to_string(): string {
    return s;
}

// `s.repeat(n)` — `n` copies of s concatenated. `n <= 0`
// returns empty; `n == 1` returns a fresh independent copy
// of s (the `+` lowering allocates). Quadratic on large n
// because each `+` allocates a fresh buffer; if a benchmark
// shows that's a real bottleneck, drop to a single-pass
// memcpy via a `__memcpy` shim.
pub function (s: string) repeat(n: i32): string {
    if (n <= 0) { return ""; }
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        out = out + s;
        i = i + 1;
    }
    return out;
}

// `s.starts_with(prefix)` / `s.ends_with(suffix)` /
// `s.contains(needle)` / `s.index_of(needle)` —
// byte-level prefix / suffix / substring scans. UTF-8
// agnostic: they walk raw bytes, which means a partial-
// codepoint search will match its byte sequence wherever
// it appears (same as Go's `strings.Contains`). Empty
// needle / prefix / suffix return true / 0 to match the
// `strstr` / Go conventions.

pub function (s: string) starts_with(prefix: string): boolean {
    var sLen: i32 = len(s);
    var pLen: i32 = len(prefix);
    if (pLen > sLen) { return false; }
    var i: i32 = 0;
    while (i < pLen) {
        if (s[i] != prefix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub function (s: string) ends_with(suffix: string): boolean {
    var sLen: i32 = len(s);
    var sufLen: i32 = len(suffix);
    if (sufLen > sLen) { return false; }
    var off: i32 = sLen - sufLen;
    var i: i32 = 0;
    while (i < sufLen) {
        if (s[off + i] != suffix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// __substr_eq compares len(needle) bytes starting at
// `offset` in `s` against `needle` byte-by-byte. The
// caller has already bounds-checked `offset + nLen <=
// len(s)`, so this just walks until the first mismatch.
function __substr_eq(s: string, offset: i32, needle: string, nLen: i32): boolean {
    var i: i32 = 0;
    while (i < nLen) {
        if (s[offset + i] != needle[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub function (s: string) contains(needle: string): boolean {
    var nLen: i32 = len(needle);
    if (nLen == 0) { return true; }
    var sLen: i32 = len(s);
    if (nLen > sLen) { return false; }
    var last: i32 = sLen - nLen;
    var i: i32 = 0;
    while (i <= last) {
        if (__substr_eq(s, i, needle, nLen)) { return true; }
        i = i + 1;
    }
    return false;
}

pub function (s: string) index_of(needle: string): i32 {
    var nLen: i32 = len(needle);
    if (nLen == 0) { return 0; }
    var sLen: i32 = len(s);
    if (nLen > sLen) { return 0 - 1; }
    var last: i32 = sLen - nLen;
    var i: i32 = 0;
    while (i <= last) {
        if (__substr_eq(s, i, needle, nLen)) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// `s.last_index_of(needle)` — rightmost occurrence; -1 if
// absent. Empty needle returns len(s) to match Python rfind /
// Go LastIndex conventions (the "match at every gap" trick).
// Walks bytes from the right; O(n*m) worst case like
// index_of.
pub function (s: string) last_index_of(needle: string): i32 {
    var nLen: i32 = len(needle);
    var sLen: i32 = len(s);
    if (nLen == 0) { return sLen; }
    if (nLen > sLen) { return 0 - 1; }
    var i: i32 = sLen - nLen;
    while (i >= 0) {
        if (__substr_eq(s, i, needle, nLen)) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

// `s.capitalize()` — uppercase the first byte, leave the
// rest unchanged. ASCII-only: non-letter first bytes pass
// through. Different from `to_upper` (which folds every
// letter) and from Python's str.capitalize (which also
// LOWERCASES the rest — our version intentionally preserves
// the tail since the lossy fold is rarely what callers
// want).
pub function (s: string) capitalize(): string {
    var n: i32 = len(s);
    if (n == 0) { return ""; }
    var first: i32 = s[0].to_upper();
    if (first == s[0]) { return s; }
    var buf: u8[] = __alloc_u8(1);
    buf[0] = first as u8;
    return string_from_bytes(buf) + s[1:n];
}

// `s.word_count()` — number of whitespace-separated words.
// Same notion as fields(): runs of any ASCII whitespace
// count as a single separator, empty pieces dropped. Empty
// / all-whitespace input returns 0.
pub function (s: string) word_count(): i32 {
    var n: i32 = len(s);
    var c: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        while (i < n && __is_ascii_ws(s[i])) { i = i + 1; }
        if (i >= n) { return c; }
        c = c + 1;
        while (i < n && !__is_ascii_ws(s[i])) { i = i + 1; }
    }
    return c;
}

// `s.escape_html()` — escape the five characters that have
// special meaning in HTML / XML: & < > " '. Produces a
// string safe to splice into element bodies and attribute
// values; matches Go html.EscapeString.
pub function (s: string) escape_html(): string {
    var n: i32 = len(s);
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 38)      { out = out + "&amp;"; }    // &
        else if (b == 60) { out = out + "&lt;"; }     // <
        else if (b == 62) { out = out + "&gt;"; }     // >
        else if (b == 34) { out = out + "&#34;"; }    // "
        else if (b == 39) { out = out + "&#39;"; }    // '
        else              { out = out + s[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

// `s.strip_quotes()` — if s starts and ends with the same
// quote character (either " or '), return Some(inner).
// Otherwise None. Useful for parsing config files / CLI
// flags / JSON strings where quotes are optional.
pub function (s: string) strip_quotes(): Option[string] {
    var n: i32 = len(s);
    if (n < 2) { return None; }
    var first: i32 = s[0];
    var last: i32 = s[n - 1];
    if ((first == 34 && last == 34) || (first == 39 && last == 39)) {
        return Some(s[1:n - 1]);
    }
    return None;
}

// `s.leading_count(b)` — number of leading bytes equal to b.
// "    hello".leading_count(32) == 4 (count of spaces).
// Useful for indent detection / column alignment.
pub function (s: string) leading_count(b: i32): i32 {
    var n: i32 = len(s);
    var i: i32 = 0;
    while (i < n && s[i] == b) { i = i + 1; }
    return i;
}

// `s.trailing_count(b)` — number of trailing bytes equal to b.
// "hello   ".trailing_count(32) == 3. Symmetric to
// leading_count.
pub function (s: string) trailing_count(b: i32): i32 {
    var n: i32 = len(s);
    var i: i32 = 0;
    while (i < n && s[n - 1 - i] == b) { i = i + 1; }
    return i;
}

// `s.hash_fnv32()` — FNV-1a 32-bit hash of the byte content.
// Non-cryptographic; good for hash-table bucket selection
// and fingerprinting. Constant-time per input length (no
// data-dependent branches). Reference: http://www.isthe.com/
// chongo/tech/comp/fnv/.
//
// Returns u32 because the multiply / xor mixing is defined
// over unsigned arithmetic.
pub function (s: string) hash_fnv32(): u32 {
    // FNV offset basis (decimal: 2166136261); written as
    // (-2128831035 as u32) since lang doesn't lex u32 literals
    // above i32::MAX. The cast preserves the bit pattern.
    var h: u32 = (0 - 2128831035) as u32;
    var prime: u32 = 16777619 as u32;
    var n: i32 = len(s);
    var i: i32 = 0;
    while (i < n) {
        h = h ^ (s[i] as u32);
        h = h * prime;
        i = i + 1;
    }
    return h;
}

// `(s: string) hash_djb2()` — Bernstein's djb2 hash. Alternate
// non-cryptographic hash to FNV-1a; sometimes a better fit
// for short keys due to the differing mixing. Initial value
// 5381; multiplier 33. Returns u32.
pub function (s: string) hash_djb2(): u32 {
    var h: u32 = 5381 as u32;
    var mult: u32 = 33 as u32;
    var n: i32 = len(s);
    var i: i32 = 0;
    while (i < n) {
        h = h * mult + (s[i] as u32);
        i = i + 1;
    }
    return h;
}

// `s.escape_c()` — C-style escape: backslash + double-quote
// each become \\ \", and the four whitespace bytes (\n \t
// \r \0) become their two-char escapes. Other bytes pass
// through unchanged. Standard shape for emitting source-
// code-ready string literals.
pub function (s: string) escape_c(): string {
    var n: i32 = len(s);
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 92)       { out = out + "\\\\"; }
        else if (b == 34)  { out = out + "\\\""; }
        else if (b == 10)  { out = out + "\\n"; }
        else if (b == 9)   { out = out + "\\t"; }
        else if (b == 13)  { out = out + "\\r"; }
        else if (b == 0)   { out = out + "\\0"; }
        else               { out = out + s[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

// `(s: string) escape_shell()` — POSIX-shell-safe quoting.
// Wraps s in single quotes and replaces any interior `'`
// with the standard close-quote / escaped-single-quote /
// reopen-quote dance: `'` → `'\''`. The result can be
// concatenated into a shell command line without word
// splitting or substitution.
pub function (s: string) escape_shell(): string {
    return "'" + s.replace("'", "'\\''") + "'";
}

// `(s: string) snake_case()` / `kebab_case()` — convert
// camelCase or PascalCase to lower-case-with-separator
// names. Inserts an underscore (or hyphen) before each
// internal capital letter; lowercases everything; leaves
// existing separators (_, -, space) alone besides the case
// fold.
pub function (s: string) snake_case(): string {
    return __case_separator(s, 95);
}

pub function (s: string) kebab_case(): string {
    return __case_separator(s, 45);
}

function __case_separator(s: string, sep_byte: i32): string {
    var n: i32 = len(s);
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b.is_upper() && i > 0) {
            out = out + sep_byte.to_ascii_string();
        }
        if (b == 32) {
            out = out + sep_byte.to_ascii_string();
        } else {
            out = out + b.to_lower().to_ascii_string();
        }
        i = i + 1;
    }
    return out;
}

// `s.is_valid_identifier()` — true if s matches lang's /
// C / JS identifier pattern: starts with a letter or
// underscore, continues with letters / digits / underscores.
// Empty string returns false.
pub function (s: string) is_valid_identifier(): boolean {
    var n: i32 = len(s);
    if (n == 0) { return false; }
    var first: i32 = s[0];
    if (!first.is_alpha() && first != 95) { return false; }
    var i: i32 = 1;
    while (i < n) {
        if (!s[i].is_alnum() && s[i] != 95) { return false; }
        i = i + 1;
    }
    return true;
}
