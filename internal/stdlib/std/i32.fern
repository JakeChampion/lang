// std/i32 — integer (i32) receiver methods.
//
// There is no prelude: a program sees these methods only after
// it declares `import "std/i32";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5). Callers reference the free functions qualified
// (`i32.<name>`) and the receiver methods bare (`n.abs()`).

import "core/int";
// std/i32's bodies dispatch (string) methods like `s.pad_start(
// width, "0")` (inside to_string_padded / to_string_with_sep).
// Declaring the import makes those resolve under no-prelude;
// the resulting std/i32 ↔ std/string cycle is handled by
// modload's stdlib-cycle support.
import "std/string";

// `(n: i32) abs()` — absolute value. Edge case: i32::MIN
// (-2147483648) has no positive counterpart in i32; the
// magnitude is carried through i64 so the result wraps to
// i32::MIN itself (matches Rust i32::wrapping_abs / Go's
// behaviour). Callers needing exact handling should widen
// to i64 first.
pub function (n: i32) abs(): i32 {
    if (n < 0) {
        var w: i64 = 0 - (n as i64);
        return w as i32;
    }
    return n;
}

// `abs_diff(other)` — the absolute difference `|n - other|`, always
// non-negative for any pair whose true difference fits in i32. Branches on the
// ordering and subtracts the smaller from the larger so the result is the
// non-negative magnitude directly (unlike `(n - other).abs()`, which trips
// `abs`'s own i32::MIN edge). Like Rust's `i32::abs_diff` in spirit, but the
// return is i32 (not u32), so a difference exceeding i32::MAX — only reachable
// when the operands straddle nearly the whole range, e.g. MAX vs MIN — wraps;
// widen to i64 first if that range matters.
pub function (n: i32) abs_diff(other: i32): i32 {
    if (n >= other) { return n - other; }
    return other - n;
}
// ASCII byte predicates — `is_digit` / `is_alpha` / `is_alnum` /
// `is_ascii_white_space` classify a single byte (typically an
// `s[i]` index into a string, i.e. a UTF-8 code unit, hence the
// byte-range narrowing). Multibyte UTF-8 sequences pass through as
// false for the alphabetic / digit predicates because their
// leading bytes are all >= 0x80 — that matches Go's
// `unicode/utf8` convention.
//
// Method-style chosen so call sites read as `s[i].is_digit()`
// — matches the rest of the i32 / string receiver surface's
// `to_string()` / `is_empty()` shape. `__is_ascii_ws`
// stays as a free function for the `trim()` body that pre-
// dates this surface.

pub function (b: i32) is_digit(): boolean {
    return b >= 48 && b <= 57;
}

pub function (b: i32) is_alpha(): boolean {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
}

pub function (b: i32) is_alnum(): boolean {
    return b.is_digit() || b.is_alpha();
}

pub function (b: i32) is_ascii_white_space(): boolean {
    return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
}

// `(b: i32) is_newline()` — true for LF (10) or CR (13). Use
// when tokenising line-oriented input that should treat the
// CRLF pair like a single boundary; pair with the trailing-CR
// strip in lines().
pub function (b: i32) is_newline(): boolean {
    return b == 10 || b == 13;
}

// `(b: i32) is_vowel()` — true for ASCII a/e/i/o/u in either
// case. Y is not counted (it's contextual; matches the
// English-class default). Useful for text analysis,
// Pig Latin / spelling-rule kinds of routines.
pub function (b: i32) is_vowel(): boolean {
    if (b == 97 || b == 101 || b == 105 || b == 111 || b == 117) { return true; }
    if (b == 65 || b == 69 || b == 73 || b == 79 || b == 85) { return true; }
    return false;
}

// `(b: i32) is_printable()` — printable ASCII (32..126).
// Excludes control characters (0..31, 127) and the high-
// byte range (128..255). Useful for log sanitisation /
// diagnostic dumps.
pub function (b: i32) is_printable(): boolean {
    return b >= 32 && b <= 126;
}

// `(b: i32) is_control()` — ASCII control character: 0..31
// or 127. Inverse of is_printable in the ASCII range; the
// high-byte range (128..255) is neither printable nor
// control under this definition.
pub function (b: i32) is_control(): boolean {
    return (b >= 0 && b <= 31) || b == 127;
}

// `(b: i32) matches_any(bytes)` — true if b appears anywhere
// in the bytes string. Linear scan over bytes. Useful for
// custom classifier predicates without writing a chain of
// `b == x || b == y || ...` comparisons.
pub function (b: i32) matches_any(bytes: string): boolean {
    var n: i32 = bytes.len();
    var i: i32 = 0;
    while (i < n) {
        if (bytes[i] == b) { return true; }
        i = i + 1;
    }
    return false;
}

// `(b: i32) is_letter()` — alias for is_alpha. The name
// matches the Unicode-aware convention seen in Roc / MoonBit;
// is_alpha is the Python / Go convention. Both stay.
pub function (b: i32) is_letter(): boolean {
    return b.is_alpha();
}

pub function (b: i32) is_hex_digit(): boolean {
    return b.is_digit() ||
           (b >= 65 && b <= 70) ||   // A-F
           (b >= 97 && b <= 102);    // a-f
}

pub function (b: i32) is_ascii(): boolean {
    return b >= 0 && b <= 127;
}

// `(b: i32) is_punct()` — true for an ASCII punctuation byte.
// Set matches Python's `string.punctuation`: 32 chars in the
// four ranges 33-47, 58-64, 91-96, 123-126. Useful for
// tokenisers that slice on `!"#$%&'()*+,-./:;<=>?@[\]^_\``{|}~`.
pub function (b: i32) is_punct(): boolean {
    if (b >= 33 && b <= 47)  { return true; }
    if (b >= 58 && b <= 64)  { return true; }
    if (b >= 91 && b <= 96)  { return true; }
    if (b >= 123 && b <= 126){ return true; }
    return false;
}

// `(b: i32) hex_digit()` — single-byte string with the byte's
// lowercase hex representation, or "" if b isn't a valid
// digit (0..15). Inverse of is_hex_digit which classifies
// the string byte → numeric value direction.
pub function (b: i32) hex_digit(): string {
    if (b < 0 || b > 15) { return ""; }
    var buf: u8[] = __alloc_u8(1);
    if (b < 10) { buf = buf.with(0, (b + 48) as u8); }
    else        { buf = buf.with(0, (b + 87) as u8); }
    return string_from_bytes(buf);
}

// `(b: i32) digit_value()` — '0'..'9' → 0..9, -1 otherwise.
// Useful for hand-rolled numeric parsers without the
// __radix_digit detour.
pub function (b: i32) digit_value(): i32 {
    if (b >= 48 && b <= 57) { return b - 48; }
    return 0 - 1;
}

// `(b: i32) hex_value()` — '0'..'9' / 'a'..'f' / 'A'..'F'
// → 0..15, -1 otherwise. Same semantics as the internal
// __hex_value but on the public byte-receiver surface.
pub function (b: i32) hex_value(): i32 {
    if (b >= 48 && b <= 57)  { return b - 48; }      // 0-9
    if (b >= 97 && b <= 102) { return b - 87; }      // a-f
    if (b >= 65 && b <= 70)  { return b - 55; }      // A-F
    return 0 - 1;
}

// `(b: i32) to_ascii_string()` — single-byte string from a
// byte value. Out-of-range (< 0 or > 255) returns "". The
// inverse of `s[0]` for single-char strings. Useful when
// composing tokeniser output where you've got the byte and
// want a string at the call site.
pub function (b: i32) to_ascii_string(): string {
    if (b < 0 || b > 255) { return ""; }
    var buf: u8[] = __alloc_u8(1);
    buf = buf.with(0, b as u8);
    return string_from_bytes(buf);
}

// === i32 sign helpers ===
//
// `(n: i32) signum()` — -1 / 0 / 1 indicating the sign.
// `is_positive` / `is_negative` / `is_zero` — boolean
// companions. signum is the function name used by Rust /
// Java / Haskell; matches Rust i32::signum exactly.
pub function (n: i32) signum(): i32 {
    if (n > 0) { return 1; }
    if (n < 0) { return 0 - 1; }
    return 0;
}

pub function (n: i32) is_positive(): boolean { return n > 0; }
pub function (n: i32) is_negative(): boolean { return n < 0; }
pub function (n: i32) is_zero(): boolean { return n == 0; }

// `(n: i32) is_in_range(lo, hi)` — true iff lo <= n < hi
// (half-open). Empty / inverted ranges return false. The
// standard "bucket" / "valid array index" check shape.
pub function (n: i32) is_in_range(lo: i32, hi: i32): boolean {
    return n >= lo && n < hi;
}

// `(n: i32) is_between(lo, hi)` — inclusive range check
// (lo <= n <= hi). Companion to is_in_range which is half-
// open. The closed form is the more natural shape for
// human-facing bounds ("number must be between 1 and 100").
pub function (n: i32) is_between(lo: i32, hi: i32): boolean {
    return n >= lo && n <= hi;
}

// `(n: i32) reverse_digits()` — flip the decimal digit
// order. 1234 → 4321. Sign preserved. Leading zeros after
// reverse drop (1000 → 1). Overflow on the reverse is
// possible for large values; wraps silently.
pub function (n: i32) reverse_digits(): i32 {
    var neg: boolean = (n < 0);
    // i64 magnitude so i32::MIN reverses instead of spinning zero times
    // (abs() can't represent 2147483648). The reversed accumulator stays
    // i32, so it still wraps silently on overflow, as documented.
    var mag: i64 = n as i64;
    if (neg) { mag = 0 - mag; }
    var r: i32 = 0;
    while (mag > 0) {
        r = r * 10 + ((mag % 10) as i32);
        mag = mag / 10;
    }
    if (neg) { return 0 - r; }
    return r;
}

// `(n: i32) is_palindrome()` — true iff the decimal
// representation reads the same backwards. Negative
// numbers return false (the minus sign doesn't reverse
// to itself). 0 is a palindrome.
pub function (n: i32) is_palindrome(): boolean {
    if (n < 0) { return false; }
    return n == n.reverse_digits();
}

// `(n: i32) sum_of_digits()` — total of the decimal digits.
// 123 → 6. Negative numbers use their magnitude. Useful for
// digital-root puzzles, checksum precomputation.
pub function (n: i32) sum_of_digits(): i32 {
    // i64 magnitude so i32::MIN's digits are summed (abs() wraps it back
    // negative, which an i32 `while (mag > 0)` loop would skip entirely).
    var mag: i64 = n as i64;
    if (mag < 0) { mag = 0 - mag; }
    var s: i32 = 0;
    while (mag > 0) {
        s = s + ((mag % 10) as i32);
        mag = mag / 10;
    }
    return s;
}

// `(n: i32) has_digit(d)` — true if d (0..9) appears in
// the decimal representation. Negative numbers use their
// magnitude.
pub function (n: i32) has_digit(d: i32): boolean {
    if (d < 0 || d > 9) { return false; }
    // i64 magnitude so i32::MIN's digits are scanned (abs() wraps it back
    // negative, which an i32 `while (mag > 0)` loop would skip entirely).
    var mag: i64 = n as i64;
    if (mag < 0) { mag = 0 - mag; }
    if (mag == 0) { return d == 0; }
    while (mag > 0) {
        if ((mag % 10) as i32 == d) { return true; }
        mag = mag / 10;
    }
    return false;
}

// `(n: i32) percent_of(total)` — what percentage of `total`
// is `n`? Returns `(n * 100) / total`, integer-truncated.
// `total <= 0` returns 0 (sentinel for "undefined"; a
// caller wanting `None` should check first). The `n * 100`
// is computed in i64 so it can't wrap for large |n| (the old
// i32 multiply silently wrapped for |n| beyond ~21M); the
// quotient is correct whenever the true percentage fits i32.
pub function (n: i32) percent_of(total: i32): i32 {
    if (total <= 0) { return 0; }
    return ((n as i64) * 100 / (total as i64)) as i32;
}

// `(n: i32) is_multiple_of(d)` — true if d divides n
// evenly. `d == 0` returns false (no value is a multiple
// of zero; avoids the divide-by-zero trap). Negative
// divisors are normalised via the modulo — `(-6) % 3 == 0`
// holds.
pub function (n: i32) is_multiple_of(d: i32): boolean {
    if (d == 0) { return false; }
    return n % d == 0;
}

// `(n: i32) min_zero()` — saturate to non-negative: return
// 0 when `n < 0`, otherwise `n`. Cheaper / clearer than
// `n.max(0)` for the common "negative-as-error" pattern.
pub function (n: i32) min_zero(): i32 {
    if (n < 0) { return 0; }
    return n;
}

// `(n: i32) sign_str()` — string form of the sign:
// "+" for positive, "-" for negative, "" for zero.
// Useful for human-readable signed-magnitude formatting.
pub function (n: i32) sign_str(): string {
    if (n > 0) { return "+"; }
    if (n < 0) { return "-"; }
    return "";
}

// `(n: i32) is_perfect_square()` — true if n is k*k for some
// non-negative k. Negative n returns false. Uses
// `sqrt_floor`, so the check is O(log n) via that helper's
// binary search; faster than a linear k-walk.
pub function (n: i32) is_perfect_square(): boolean {
    if (n < 0) { return false; }
    var k: i32 = n.sqrt_floor();
    return k * k == n;
}

// `(n: i32) factorial()` — n! for n in 0..12. Returns 1 for
// 0!. Caps at 12! = 479001600 (the largest factorial that
// fits in i32); n >= 13 or n < 0 returns 0 as the
// out-of-range sentinel. Callers needing 13!+ should widen
// to i64 / bigint when those land.
pub function (n: i32) factorial(): i32 {
    if (n < 0 || n > 12) { return 0; }
    var result: i32 = 1;
    var i: i32 = 2;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

// `(n: i32) is_prime()` — primality check via 6k±1 trial
// division. n < 2 returns false. O(sqrt n). Adequate for
// the small-n use cases (input validation, puzzle code);
// callers running heavy number theory should bring a
// sieve.
pub function (n: i32) is_prime(): boolean {
    if (n < 2) { return false; }
    if (n == 2 || n == 3) { return true; }
    if (n % 2 == 0 || n % 3 == 0) { return false; }
    var i: i32 = 5;
    while (i * i <= n) {
        if (n % i == 0 || n % (i + 2) == 0) { return false; }
        i = i + 6;
    }
    return true;
}

// === Byte-level case helpers ===
//
// `(b: i32) is_lower()` / `is_upper()` / `to_lower()` /
// `to_upper()` — ASCII-only. Non-letter bytes (digits, punct,
// non-ASCII) pass through unchanged for the to_* path and
// return false for the is_* path. Used by string-level
// methods below and by hand-rolled tokenisers.

pub function (b: i32) is_lower(): boolean {
    return b >= 97 && b <= 122;
}

pub function (b: i32) is_upper(): boolean {
    return b >= 65 && b <= 90;
}

pub function (b: i32) to_lower(): i32 {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

pub function (b: i32) to_upper(): i32 {
    if (b >= 97 && b <= 122) { return b - 32; }
    return b;
}

// === i32 numeric methods ===
//
// `(n: i32) abs()` migrated to `std/i32` — see the
// `import "std/i32";` at the top of this file. The checker's
// method auto-discovery (`internal/checker/checker.go`)
// registers these off the stdlib imports a program declares,
// so an explicit `import "std/i32";` brings them into scope.
//
// `(n: i32) min(other) i32` / `max` / `clamp(lo, hi)` —
// scalar reductions. Standard shape; matches Rust /
// Gleam / Go (stdlib min/max which landed in Go 1.21).
pub function (n: i32) min(other: i32): i32 {
    if (n < other) { return n; }
    return other;
}

pub function (n: i32) max(other: i32): i32 {
    if (n > other) { return n; }
    return other;
}

pub function (n: i32) clamp(lo: i32, hi: i32): i32 {
    if (n < lo) { return lo; }
    if (n > hi) { return hi; }
    return n;
}

// === i32 saturating / checked arithmetic ===
//
// `saturating_*` clamps to i32::MAX / i32::MIN instead of
// wrapping; `checked_*` returns None on overflow so the
// caller can decide. Overflow detection is sign-bit-based —
// no i64 widening (the natives' i64 codegen has a comparison
// bug with values straddling the i32::MAX threshold).

pub function (n: i32) saturating_add(other: i32): i32 {
    var r: i32 = n + other;
    // Overflow: both signs match but result flips sign.
    if (n > 0 && other > 0 && r < 0) { return 2147483647; }
    if (n < 0 && other < 0 && r >= 0) { return 0 - 2147483647 - 1; }
    return r;
}

pub function (n: i32) saturating_sub(other: i32): i32 {
    var r: i32 = n - other;
    // Overflow: signs differ and result has the wrong sign.
    if (n >= 0 && other < 0 && r < 0) { return 2147483647; }
    if (n < 0 && other > 0 && r > 0) { return 0 - 2147483647 - 1; }
    return r;
}

pub function (n: i32) checked_add(other: i32): Option[i32] {
    var r: i32 = n + other;
    if (n > 0 && other > 0 && r < 0) { return None; }
    if (n < 0 && other < 0 && r >= 0) { return None; }
    return Some(r);
}

pub function (n: i32) checked_sub(other: i32): Option[i32] {
    var r: i32 = n - other;
    if (n >= 0 && other < 0 && r < 0) { return None; }
    if (n < 0 && other > 0 && r > 0) { return None; }
    return Some(r);
}

// `(n: i32) checked_div(other)` — None on divide-by-zero
// OR on i32::MIN / -1 (the one i32 division that overflows).
pub function (n: i32) checked_div(other: i32): Option[i32] {
    if (other == 0) { return None; }
    var min32: i32 = 0 - 2147483647 - 1;
    if (n == min32 && other == (0 - 1)) { return None; }
    return Some(n / other);
}

// === i32 / i64 parity + power + gcd/lcm ===

pub function (n: i32) is_even(): boolean { return n % 2 == 0; }
pub function (n: i32) is_odd(): boolean  { return n % 2 != 0; }

// `(n: i32) pow(exp)` — integer exponentiation by squaring.
// Negative exponents return 0 (lang has no fractional i32).
// Overflow wraps silently (matches Rust wrapping_pow); use
// i64 power for ranges beyond ~2^31.
pub function (n: i32) pow(exp: i32): i32 {
    if (exp < 0) { return 0; }
    var base: i32 = n;
    var e: i32 = exp;
    var out: i32 = 1;
    while (e > 0) {
        if (e % 2 == 1) { out = out * base; }
        base = base * base;
        e = e / 2;
    }
    return out;
}

// `(n: i32) gcd(other)` — greatest common divisor via the
// Euclidean algorithm. Sign-agnostic — both operands are
// abs()'d up front. gcd(0, n) == gcd(n, 0) == abs(n); gcd(0,
// 0) == 0 per the standard convention.
pub function (n: i32) gcd(other: i32): i32 {
    var a: i32 = n.abs();
    var b: i32 = other.abs();
    while (b != 0) {
        var t: i32 = b;
        b = a % b;
        a = t;
    }
    return a;
}

// `(n: i32) lcm(other)` — least common multiple. Computed as
// abs(a*b) / gcd(a, b) with the gcd-first ordering so an
// overflow-prone multiply gets divided down before the
// result lands. lcm(0, _) == lcm(_, 0) == 0.
pub function (n: i32) lcm(other: i32): i32 {
    if (n == 0 || other == 0) { return 0; }
    var g: i32 = n.gcd(other);
    return (n / g).abs() * other.abs();
}

// `(n: i32) is_power_of_2()` — true iff n is a positive
// power of 2 (1, 2, 4, 8, ...). Uses the (n & (n-1)) == 0
// trick. Zero and negative numbers return false (zero is
// debatable; we follow Rust's convention where 0 isn't a
// power of 2).
pub function (n: i32) is_power_of_2(): boolean {
    if (n <= 0) { return false; }
    return (n & (n - 1)) == 0;
}

// `(n: i32) next_power_of_2()` — smallest power of 2 that
// is >= n. Returns 1 for n <= 1 (consistent with Rust's
// next_power_of_two). For n > 2^30 wraps to 0 — overflow
// equivalent to "no representable power".
pub function (n: i32) next_power_of_2(): i32 {
    if (n <= 1) { return 1; }
    var p: i32 = 1;
    while (p < n) { p = p * 2; }
    return p;
}

// `(n: i32) log2_floor()` — floor(log2(n)) for n >= 1; -1
// for n <= 0 (no real log; sentinel chosen so callers can
// test `>= 0` to mean "valid"). Equivalent to 31 -
// leading_zeros(n) for positives.
pub function (n: i32) log2_floor(): i32 {
    if (n <= 0) { return 0 - 1; }
    return 31 - n.leading_zeros();
}

// `(n: i32) sqrt_floor()` — integer square root. floor(sqrt(n))
// for n >= 0; 0 for n <= 0 (degenerate fallback). Newton's
// method from a half-of-n starting point — converges in
// O(log n) iterations regardless of starting guess.
pub function (n: i32) sqrt_floor(): i32 {
    if (n <= 0) { return 0; }
    if (n < 4) { return 1; }
    var x: i32 = n / 2;
    while (true) {
        var y: i32 = (x + n / x) / 2;
        if (y >= x) { return x; }
        x = y;
    }
    return x;
}

// `(n: i32) ceil_div(d)` — n divided by d, rounded up.
// Matches the standard (n + d - 1) / d formula for positive
// d; for negative or zero d the result is undefined and
// returns 0 (no panic — caller validates).
pub function (n: i32) ceil_div(d: i32): i32 {
    if (d <= 0) { return 0; }
    if (n <= 0) { return n / d; }
    return (n + d - 1) / d;
}

// `(n: i32) round_up_to(m)` — round n up to the nearest
// multiple of m (m > 0). For n already a multiple, returns
// n unchanged. m <= 0 returns n.
pub function (n: i32) round_up_to(m: i32): i32 {
    if (m <= 0) { return n; }
    if (n <= 0) { return 0; }
    return ((n + m - 1) / m) * m;
}

// `(n: i32) round_down_to(m)` — round n down to the nearest
// multiple of m. Mirror of round_up_to.
pub function (n: i32) round_down_to(m: i32): i32 {
    if (m <= 0) { return n; }
    if (n < 0) { return 0 - ((0 - n + m - 1) / m * m); }
    return (n / m) * m;
}

// `(n: i32) divmod(d)` — `(quotient, remainder)` pair from a
// single division. Saves the two-call boilerplate `(n/d, n%d)`
// and signals intent at the call site (the pair is the unit
// of work). d == 0 returns (0, 0) — caller validates.
pub function (n: i32) divmod(d: i32): (i32, i32) {
    if (d == 0) { return (0, 0); }
    return (n / d, n % d);
}

// === i32 bit ops ===
//
// `count_ones` / `leading_zeros` / `trailing_zeros` /
// `byte_swap` — bit-fiddling utilities. Software
// implementations (no intrinsics surface in lang); O(width)
// per call, fine for the use cases (hash mixing, bit-packed
// flag inspection, endian conversion).

pub function (n: i32) count_ones(): i32 {
    var u: u32 = n as u32;
    var c: i32 = 0;
    var i: i32 = 0;
    while (i < 32) {
        if ((u & (1 as u32)) != (0 as u32)) { c = c + 1; }
        u = u >> (1 as u32);
        i = i + 1;
    }
    return c;
}

// `count_zeros` — the number of ZERO bits in the 32-bit two's-complement
// representation; the complement of `count_ones` (the two always sum to 32).
pub function (n: i32) count_zeros(): i32 {
    return 32 - n.count_ones();
}

pub function (n: i32) leading_zeros(): i32 {
    if (n == 0) { return 32; }
    var u: u32 = n as u32;
    // Top-bit mask = 1 << 31. Lang doesn't lex hex literals
    // big enough to spell 0x80000000 directly, so construct
    // via a left shift.
    var top: u32 = (1 as u32) << (31 as u32);
    var c: i32 = 0;
    while ((u & top) == (0 as u32)) {
        c = c + 1;
        u = u << (1 as u32);
    }
    return c;
}

pub function (n: i32) trailing_zeros(): i32 {
    if (n == 0) { return 32; }
    var u: u32 = n as u32;
    var c: i32 = 0;
    while ((u & (1 as u32)) == (0 as u32)) {
        c = c + 1;
        u = u >> (1 as u32);
    }
    return c;
}

// `(n: i32) bit(i)` — read bit at position i (0 = LSB).
// Out-of-range returns false. Useful for unpacking bit-
// packed flags / nibbles.
pub function (n: i32) bit(i: i32): boolean {
    if (i < 0 || i >= 32) { return false; }
    var mask: u32 = (1 as u32) << (i as u32);
    return ((n as u32) & mask) != (0 as u32);
}

// `(n: i32) set_bit(i)` / `clear_bit(i)` / `toggle_bit(i)`
// — return a fresh i32 with bit i set / cleared / flipped.
// Out-of-range i is a no-op (returns n unchanged).
pub function (n: i32) set_bit(i: i32): i32 {
    if (i < 0 || i >= 32) { return n; }
    var mask: u32 = (1 as u32) << (i as u32);
    return ((n as u32) | mask) as i32;
}

pub function (n: i32) clear_bit(i: i32): i32 {
    if (i < 0 || i >= 32) { return n; }
    var mask: u32 = (1 as u32) << (i as u32);
    var inv: u32 = ((0 - 1) as u32) ^ mask;
    return ((n as u32) & inv) as i32;
}

pub function (n: i32) toggle_bit(i: i32): i32 {
    if (i < 0 || i >= 32) { return n; }
    var mask: u32 = (1 as u32) << (i as u32);
    return ((n as u32) ^ mask) as i32;
}

// `(n: i32) byte_swap()` — reverse the four bytes of n.
// Useful for endian conversion when reading / writing on-
// disk formats. Reverses bytewise: ABCD → DCBA.
pub function (n: i32) byte_swap(): i32 {
    var u: u32 = n as u32;
    var b0: u32 = u & (255 as u32);
    var b1: u32 = (u >> (8 as u32)) & (255 as u32);
    var b2: u32 = (u >> (16 as u32)) & (255 as u32);
    var b3: u32 = (u >> (24 as u32)) & (255 as u32);
    return ((b0 << (24 as u32)) | (b1 << (16 as u32)) | (b2 << (8 as u32)) | b3) as i32;
}

// `(n: i32) rotate_left(bits)` / `rotate_right(bits)` —
// circular shift by `bits` positions. Bits shifted out one
// end re-enter the other. The bit count is masked to 0..31
// (modulo 32) so out-of-range values still produce a valid
// rotation. Useful for hash mixing, bit-permutation cipher
// stages, and other bit-rotation primitives.
pub function (n: i32) rotate_left(bits: i32): i32 {
    var k: i32 = bits & 31;
    if (k == 0) { return n; }
    var u: u32 = n as u32;
    var left: u32 = u << (k as u32);
    var right: u32 = u >> ((32 - k) as u32);
    return (left | right) as i32;
}

pub function (n: i32) rotate_right(bits: i32): i32 {
    var k: i32 = bits & 31;
    if (k == 0) { return n; }
    var u: u32 = n as u32;
    var right: u32 = u >> (k as u32);
    var left: u32 = u << ((32 - k) as u32);
    return (left | right) as i32;
}


// `(n: i32) to_binary()` / `to_oct()` — sugar for
// int_to_string_radix(n, 2) / (n, 8). Signed (negatives
// emit a leading `-`).
pub function (n: i32) to_binary(): string {
    return int.int_to_string_radix(n, 2);
}

pub function (n: i32) to_oct(): string {
    return int.int_to_string_radix(n, 8);
}


// `(n: i32) digits()` — number of decimal digits in n. The
// minus sign isn't counted. Zero has 1 digit. Useful for
// table-column-width math and progress bars.
pub function (n: i32) digits(): i32 {
    if (n == 0) { return 1; }
    // Magnitude in i64: |i32::MIN| = 2147483648 doesn't fit in i32 (abs()
    // wraps it back to i32::MIN, which is < 0, so an i32 `while (u > 0)`
    // loop would spin zero times and wrongly report 0 digits).
    var u: i64 = n as i64;
    if (u < 0) { u = 0 - u; }
    var c: i32 = 0;
    while (u > 0) {
        c = c + 1;
        u = u / 10;
    }
    return c;
}

// `(n: i32) pluralize(singular, plural)` — pick `singular`
// when |n| == 1, otherwise `plural`. Standard English-plural
// helper. Doesn't compose the count into the result — caller
// formats `"$n widget$s"` themselves via concat or format().
pub function (n: i32) pluralize(singular: string, plural: string): string {
    if (n.abs() == 1) { return singular; }
    return plural;
}

// `(n: i32) ordinal()` — the English ordinal string: `1` → `"1st"`,
// `2` → `"2nd"`, `3` → `"3rd"`, `4` → `"4th"`, with the 11/12/13
// exception (`11` → `"11th"`, `112` → `"112th"`) and the tens carrying
// through (`21` → `"21st"`, `102` → `"102nd"`). The suffix is chosen
// from |n|, so a negative keeps its sign (`-1` → `"-1st"`). For turning
// a rank into display text ("the 3rd result").
pub function (n: i32) ordinal(): string {
    var m: i32 = n.abs();
    var suffix: string = "th";
    var mod100: i32 = m % 100;
    // 11, 12, 13 are always "th"; otherwise the last digit decides.
    if (mod100 < 11 || mod100 > 13) {
        var mod10: i32 = m % 10;
        if (mod10 == 1) { suffix = "st"; }
        else if (mod10 == 2) { suffix = "nd"; }
        else if (mod10 == 3) { suffix = "rd"; }
    }
    return n.to_string() + suffix;
}

// `(i32).to_string()` / `(u32).to_string()` /
// `(i64).to_string()` / `(u64).to_string()` — method-syntax
// wrappers around the formatter. The receiver-method
// dispatch in the checker maps `n.to_string()` to the
// appropriate `__method_<type>_to_string` mangled name.
//
// Routes through the pure-i32 `int_to_string` so handler-shaped
// programs (whose codegen pulls in the f-string `.to_string()`
// desugar via `int_to_string`) compile for arm64, where the
// backend hasn't lowered i64 ops yet. INT_MIN
// (-2147483648) is special-cased before the negate-to-magnitude
// step in int_to_string would overflow i32.
pub function (n: i32) to_string(): string {
    if (n == 0 - 2147483647 - 1) {
        return "-2147483648";
    }
    return int.int_to_string(n);
}

// `(n: i32) to_string_padded(width)` — decimal with zero-pad
// to a minimum byte width. Negative numbers get their '-' in
// the slot AFTER the leading zeros (i.e. "-0042", not
// "0-042"). Already-wide values pass through.
pub function (n: i32) to_string_padded(width: i32): string {
    var s: string = n.to_string();
    if (s.len() >= width) { return s; }
    if (n >= 0) { return s.pad_start(width, "0"); }
    // For negatives, pad the body and re-prefix with '-'.
    var body: str = s[1:s.len()];
    return "-" + body.pad_start(width - 1, "0");
}

// `(n: i32) to_string_with_sep(sep)` — decimal with `sep`
// inserted every three digits from the right. "1,234,567"
// shape; `sep` is typically "," or "_" or " ". Negative
// numbers keep the "-" prefix outside the grouping.
pub function (n: i32) to_string_with_sep(sep: string): string {
    var s: string = n.to_string();
    var sign: string = "";
    if (n < 0) {
        sign = "-";
        s = s[1:s.len()].to_owned();
    }
    var L: i32 = s.len();
    if (L <= 3) { return sign + s; }
    var out: string = "";
    var i: i32 = 0;
    while (i < L) {
        var idx: i32 = L - 1 - i;
        out = s[idx:idx + 1] + out;
        if (i % 3 == 2 && i < L - 1) {
            out = sep + out;
        }
        i = i + 1;
    }
    return sign + out;
}

// `(n: i32) to_hex()` — lowercase hex without prefix.
// Sugar for `int_to_string_radix(n, 16)` — emits a leading
// '-' for negative numbers. Callers that want the two's-
// complement bit pattern should widen to u32 first and use
// `int_to_string_radix` on that; the i32 form here keeps
// the signed semantics consistent with `to_string`.
pub function (n: i32) to_hex(): string {
    return int.int_to_string_radix(n, 16);
}

// `(n: i32) to_rgb_hex()` — render the low 24 bits as a
// "#RRGGBB" colour string (lowercase hex, leading "#",
// zero-padded). Useful for CSS / SVG / terminal-ANSI
// emission. Bits above bit 23 are ignored.
pub function (n: i32) to_rgb_hex(): string {
    var r: i32 = (n >> 16) & 255;
    var g: i32 = (n >> 8) & 255;
    var b: i32 = n & 255;
    return "#" + r.to_hex().pad_start(2, "0") +
                 g.to_hex().pad_start(2, "0") +
                 b.to_hex().pad_start(2, "0");
}


// `(n: i32) is_one()` / `is_minus_one()` — sentinel-value
// shortcuts for the two most-checked small-integer constants.
// Mirror `is_zero` / `is_positive` / `is_negative` already in
// this module.
pub function (n: i32) is_one(): boolean { return n == 1; }
pub function (n: i32) is_minus_one(): boolean { return n == (0 - 1); }
