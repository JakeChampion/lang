// std/task — cooperative single-threaded task runtime (Phase-2 core).
//
// Backend-independent core of Fern's concurrency model
// (docs/ASYNC-IMPLEMENTATION-PLAN.md, docs/ASYNC-IMPLEMENTATION-RESEARCH.md,
// docs/CONCURRENCY-RESEARCH.md). COLORLESS structured concurrency as
// STACKLESS continuations driven by a single-threaded readiness
// reactor — never stackful green threads (which need per-arch
// assembly and have no WASM story), never a general algebraic-effect
// system (deferred; effects are the eventual colorless substrate, not
// the cheapest first step).
//
// A task is a STATE MACHINE. Stepping it once either completes it
// with a result (Done) or suspends it on a reactor token until that
// token's I/O is ready, carrying a continuation to resume with the
// woken value (Wait). The continuation captures the task's live
// locals by value — its "stack frame" across the suspension point —
// AND threads the Reactor, so a resumed task may register a FURTHER
// wait (multi-await: a sequence of dependent I/Os). Every task —
// regardless of internal structure — is uniformly a `Step`, so the
// runtime needs no generics, no `dyn`, and no per-backend support.
// The recursive `Step`/continuation type compiles + runs unchanged on
// interp / x86-64 / arm64 and compiles on wasm32 (verified).
//
// Phase 2 (this module): multi-await tasks + a real multi-round
// scheduler, still over an in-memory reactor so the suspend / resume
// / overlap / re-await model is testable in pure Fern on every
// backend. Phase 1 (next) swaps the reactor internals for poll(2) /
// epoll / kqueue (native) and wasi:io/poll (wasm) over real fds — the
// lang-side API below is the frozen interface that work targets.
// Phase 3 adds the `concurrent { … }` / `spawn` / `await` surface
// syntax as a parser-time desugar that EMITS exactly this shape, so
// user code never writes a state machine by hand.
//
// Phase-2 scope: results are i32 (or pointer-sized) — generic
// `Task[T]` is gated on self-host generic monomorphization
// (docs/SELF-HOST-AUDIT.md). The Go compiler already monomorphizes;
// keeping the runtime concrete keeps it green on the self-hosted path.


// The uniform task step.
//
//   Done(result)        — the task finished with this i32 result.
//   Wait(token, resume) — the task is suspended on reactor `token`;
//                         call `resume(value, rx)` once the token's
//                         I/O completes (with the i32 the I/O yielded
//                         — a byte count, an fd, a status, …) to get
//                         `(nextStep, advancedReactor)`. `resume` may
//                         register a further wait on the reactor, so
//                         a task can await any number of times.
pub enum Step {
    Done(i32),
    Wait(i32, (i32, Reactor) => (Step, Reactor)),
}

// Reactor — the readiness registry that multiplexes pending I/O.
//
// It carries TWO token classes, drained by the same `poll_ready()`:
//
//   * In-memory completions — `register(value)` allocates a token and
//     queues the value its completion will deliver (a simulated, known
//     I/O result). Portable: works identically on every backend, so
//     the suspend / resume / overlap model is testable in pure Fern.
//
//   * Real-fd waits — `register_fd(fd)` allocates a token bound to a
//     file descriptor; `poll_ready()` blocks in the OS `poll` syscall until
//     one of the registered fds is readable, then delivers that
//     token with the fd as its value (the continuation does the
//     actual non-blocking read). NATIVE-ONLY in effect: the `poll`
//     builtin is real on x86-64 / arm64 and a `-1` stub on
//     interp / wasm, so fd-backed tokens simply never resolve there
//     (the in-memory path is unaffected — `std/task` stays portable).
//
// This is the reactor unification (docs/ASYNC-IMPLEMENTATION-PLAN.md
// Phase 1/4 option 1): `concurrent` / `race` / `await` desugar onto
// this one API and now drive REAL overlapping I/O on native without
// a second, native-only reactor type — the public method shapes are
// unchanged from the Phase-2 in-memory core.
pub struct Reactor {
    next_token: i32,
    tokens: i32[],
    values: i32[],
    fd_tokens: i32[],
    fds: i32[],
}

// reactor_new() — a fresh, empty reactor. Tokens start at 1 so 0 can
// serve as a "no token" sentinel in later phases.
pub function reactor_new(): Reactor {
    var t: i32[] = [];
    var v: i32[] = [];
    var ft: i32[] = [];
    var fd: i32[] = [];
    return Reactor { next_token: 1, tokens: t, values: v, fd_tokens: ft, fds: fd };
}

// __remove_at(xs, idx) — `xs` with the element at `idx` dropped (the
// other elements keep their order). Used by `poll_ready()` to retire a
// delivered fd-backed token from the parallel fd arrays.
function __remove_at(xs: i32[], idx: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < xs.len()) {
        if (i != idx) { out = out.append(xs[i]); }
        i = i + 1;
    }
    return out;
}

// (rx).register(value) — allocate a fresh token and queue its
// completion value, returning `(token, advancedReactor)` per the
// cursor idiom (docs/CURSOR-IDIOM.md). This is the in-memory
// (portable, simulated-completion) path; `poll()` delivers these
// completions immediately on the next round.
pub function (rx: Reactor) register(value: i32): (i32, Reactor) {
    var tok: i32 = rx.next_token;
    var t2: i32[] = rx.tokens.append(tok);
    var v2: i32[] = rx.values.append(value);
    return (tok, Reactor { ...rx, next_token: tok + 1, tokens: t2, values: v2 });
}

// (rx).register_fd(fd) — allocate a fresh token bound to a file
// descriptor, returning `(token, advancedReactor)`. The completion
// value is NOT known up front: `poll_ready()` blocks in the OS `poll`
// syscall until `fd` is readable, then delivers this token with `fd`
// as the woken value so the resumed continuation can do the actual
// non-blocking read. On interp / wasm the `poll` builtin is a `-1`
// stub, so fd-backed tokens never resolve there — register real fds
// only on the native backends.
pub function (rx: Reactor) register_fd(fd: i32): (i32, Reactor) {
    var tok: i32 = rx.next_token;
    var ft2: i32[] = rx.fd_tokens.append(tok);
    var fd2: i32[] = rx.fds.append(fd);
    return (tok, Reactor { ...rx, next_token: tok + 1, fd_tokens: ft2, fds: fd2 });
}

// (rx).poll_ready() — report the next batch of completed (token, value)
// pairs, returning `(tokens, values, drainedReactor)`.
//
// In-memory completions take priority and drain ALL AT ONCE: if any
// `register`ed value is queued, every queued (token, value) pair is
// returned in this one round (they are simulated as already-ready) and
// the in-memory queue is emptied. Only once the in-memory queue is
// empty does it consult the real fds: it blocks in the OS `poll`
// syscall until one registered fd is readable, then delivers THAT
// single token with the fd as its value and retires it from the fd
// set. The scheduler (`run` / `select`) re-polls until every task
// finishes, so waits registered mid-run are picked up on a later
// round.
//
// An empty return — no in-memory completions and either no fds or a
// `poll` error / stub (-1, e.g. on interp / wasm) — signals the
// scheduler's deadlock guard: no task can make further progress.
pub function (rx: Reactor) poll_ready(): (i32[], i32[], Reactor) {
    // In-memory completions first: drain the whole queue in one round.
    if (rx.tokens.len() > 0) {
        var empty_t: i32[] = [];
        var empty_v: i32[] = [];
        return (rx.tokens, rx.values, Reactor { ...rx, tokens: empty_t, values: empty_v });
    }
    // No simulated completions: block on the real fds (native only).
    if (rx.fd_tokens.len() == 0) {
        var none_t: i32[] = [];
        var none_v: i32[] = [];
        return (none_t, none_v, rx);
    }
    var ready: i32 = poll(rx.fds, -1);
    if (ready < 0) {
        // poll error, or the interp / wasm stub: no fd resolvable.
        var err_t: i32[] = [];
        var err_v: i32[] = [];
        return (err_t, err_v, rx);
    }
    // Deliver the ready fd's token; the woken value is the fd itself so
    // the resumed continuation can read it. Retire it from the fd set.
    var tok: i32 = rx.fd_tokens[ready];
    var woken_fd: i32 = rx.fds[ready];
    var rt: i32[] = [tok];
    var rv: i32[] = [woken_fd];
    var nft: i32[] = __remove_at(rx.fd_tokens, ready);
    var nfd: i32[] = __remove_at(rx.fds, ready);
    return (rt, rv, Reactor { ...rx, fd_tokens: nft, fds: nfd });
}

// (rx).pending() — how many registered tokens (in-memory completions
// plus real-fd waits) have not yet been drained by `poll()`. Zero
// means no outstanding I/O.
pub function (rx: Reactor) pending(): i32 {
    return rx.tokens.len() + rx.fd_tokens.len();
}

// __all_done(states) — true once no task is still waiting.
function __all_done(states: Step[]): boolean {
    var i: i32 = 0;
    while (i < states.len()) {
        match (states[i]) {
            Done(v) => { },
            Wait(t, c) => { return false; },
        }
        i = i + 1;
    }
    return true;
}

// __find_waiter(states, tok) — index of the task suspended on `tok`,
// or -1 if none. Linear scan: the live set is tiny (one entry per
// in-flight I/O within a single handler).
function __find_waiter(states: Step[], tok: i32): i32 {
    var i: i32 = 0;
    while (i < states.len()) {
        match (states[i]) {
            Done(v) => { },
            Wait(t, c) => { if (t == tok) { return i; } },
        }
        i = i + 1;
    }
    return -1;
}

// run(states, rx) — drive a set of already-started tasks to
// completion on a single thread, multiplexing their waits through the
// reactor, and return their i32 results in task order.
//
// `states[i]` is the current Step of task i (what its start function
// returned). Every task has already registered its first wait BEFORE
// this call, so all that I/O is in flight simultaneously — that
// overlap is the fan-out the edge-handler use case needs (issue two
// upstream fetches, await both). Each round polls the reactor for
// completed tokens, resumes the matching tasks (which may register a
// further wait), and repeats until every task is Done.
//
// A task that never completes (its token is never delivered) lands as
// -1 in the results; with the in-memory reactor that only happens if
// the deadlock guard trips (no completions but tasks remain). The
// Phase-1 reactor's poll blocks until a fd is ready, so a live task
// always makes progress.
pub function run(states_in: Step[], rx_in: Reactor): i32[] {
    var states: Step[] = states_in;
    var rx: Reactor = rx_in;
    while (true) {
        if (__all_done(states)) { break; }
        var (toks, vals, rx2) = rx.poll_ready();
        rx = rx2;
        if (toks.len() == 0) {
            // No completions yet tasks remain: the in-memory reactor
            // is out of queued events. The real reactor's poll blocks
            // instead of returning empty, so this guard only fires in
            // the in-memory model (and means a task awaited a token
            // nobody will complete).
            break;
        }
        var j: i32 = 0;
        while (j < toks.len()) {
            var tok: i32 = toks[j];
            var val: i32 = vals[j];
            var i: i32 = __find_waiter(states, tok);
            if (i >= 0) {
                var st: Step = states[i];
                match (st) {
                    Done(v) => { },
                    Wait(t, resume) => {
                        var (next, rx3) = resume(val, rx);
                        rx = rx3;
                        states = states.with(i, next);
                    },
                }
            }
            j = j + 1;
        }
    }
    var results: i32[] = [];
    var k: i32 = 0;
    while (k < states.len()) {
        match (states[k]) {
            Done(v) => { results = results.append(v); },
            Wait(t, c) => { results = results.append(-1); },
        }
        k = k + 1;
    }
    return results;
}

// __first_done(states) — index of the lowest-numbered already-Done
// task, or -1 if none are done yet.
function __first_done(states: Step[]): i32 {
    var i: i32 = 0;
    while (i < states.len()) {
        match (states[i]) {
            Done(v) => { return i; },
            Wait(t, c) => { },
        }
        i = i + 1;
    }
    return -1;
}

// __result_at(states, i) — the result of task i if Done, else -1.
function __result_at(states: Step[], i: i32): i32 {
    match (states[i]) {
        Done(v) => { return v; },
        Wait(t, c) => { return -1; },
    }
}

// select(states, rx) — run tasks until the FIRST one completes, then
// return `(winnerIndex, winnerResult)` and abandon the rest. This is
// the happy-eyeballs / race primitive (docs/CONCURRENCY-RESEARCH.md
// Rec §5): fan out to a cache and a primary store, take whichever
// answers first.
//
// CANCELLATION is structural: a losing task is simply never resumed
// again — its parked continuation (and the live frame it captured) is
// dropped when `states` goes out of scope, and reference counting
// reclaims it. There is no separate cancel signal to thread; not
// resuming IS the cancel. (The Phase-1 reactor will additionally
// close the loser's fd so the OS stops the in-flight I/O.)
//
// "First" = earliest to reach Done across scheduler rounds, so a task
// that awaits fewer times beats a deeper one. An already-Done task at
// entry wins immediately (lowest index). Returns (-1, -1) only if the
// reactor runs dry with no task completing (in-memory deadlock guard;
// the real reactor's poll blocks instead).
pub function select(states_in: Step[], rx_in: Reactor): (i32, i32) {
    var states: Step[] = states_in;
    var rx: Reactor = rx_in;
    var pre: i32 = __first_done(states);
    if (pre >= 0) {
        return (pre, __result_at(states, pre));
    }
    while (true) {
        var (toks, vals, rx2) = rx.poll_ready();
        rx = rx2;
        if (toks.len() == 0) {
            return (-1, -1);
        }
        var j: i32 = 0;
        while (j < toks.len()) {
            var i: i32 = __find_waiter(states, toks[j]);
            if (i >= 0) {
                var st: Step = states[i];
                match (st) {
                    Done(v) => { },
                    Wait(t, resume) => {
                        var (next, rx3) = resume(vals[j], rx);
                        rx = rx3;
                        states = states.with(i, next);
                        match (next) {
                            Done(v) => { return (i, v); },
                            Wait(t2, r2) => { },
                        }
                    },
                }
            }
            j = j + 1;
        }
    }
    return (-1, -1);
}
