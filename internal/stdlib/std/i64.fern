// std/i64 — signed 64-bit integer receiver methods.
//
// Counterpart to std/i32 for the wider type. No prelude: a
// program `import "std/i64";` explicitly to call `n.abs()` /
// `.gcd(…)` / etc. on an i64 (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

import "core/int";

// `(n: i64) abs()` — absolute value. i64::MIN wraps to
// itself (no i128 to widen into); matches Rust's
// wrapping_abs. Callers needing exact handling should
// pre-check `n != i64::MIN`.
pub function (n: i64) abs(): i64 {
    if (n < (0 as i64)) { return (0 as i64) - n; }
    return n;
}

pub function (n: i64) min(other: i64): i64 {
    if (n < other) { return n; }
    return other;
}

pub function (n: i64) max(other: i64): i64 {
    if (n > other) { return n; }
    return other;
}

pub function (n: i64) clamp(lo: i64, hi: i64): i64 {
    if (n < lo) { return lo; }
    if (n > hi) { return hi; }
    return n;
}

// `(n: i64) pow(exp)` — same exponentiation-by-squaring
// shape as the i32 version. Overflow wraps silently;
// callers needing exact handling should check `exp` and
// `n.abs()` against `i64::MAX`'s bit width.
pub function (n: i64) pow(exp: i32): i64 {
    if (exp < 0) { return 0 as i64; }
    var base: i64 = n;
    var e: i32 = exp;
    var out: i64 = 1 as i64;
    while (e > 0) {
        if (e % 2 == 1) { out = out * base; }
        base = base * base;
        e = e / 2;
    }
    return out;
}

pub function (n: i64) gcd(other: i64): i64 {
    var a: i64 = n.abs();
    var b: i64 = other.abs();
    while (b != (0 as i64)) {
        var t: i64 = b;
        b = a % b;
        a = t;
    }
    return a;
}

pub function (n: i64) lcm(other: i64): i64 {
    if (n == (0 as i64) || other == (0 as i64)) { return 0 as i64; }
    var g: i64 = n.gcd(other);
    return (n / g).abs() * other.abs();
}

// `(n: i64) to_string()` — decimal representation via the
// pure-i64 formatter helper `__int_to_string_u64`.
pub function (n: i64) to_string(): string {
    var mag: i64 = n;
    var neg: i32 = 0;
    if (n < (0 as i64)) {
        neg = 1;
        mag = (0 as i64) - n;
    }
    return int.__int_to_string_u64(mag, neg);
}

// `(n: i64) is_even()` / `is_odd()` — parity helpers
// matching the i32 versions in std/i32.
pub function (n: i64) is_even(): boolean { return n % (2 as i64) == (0 as i64); }
pub function (n: i64) is_odd(): boolean  { return n % (2 as i64) != (0 as i64); }

// `(n: i64) signum()` — -1 / 0 / 1 indicating the sign, with
// `is_positive` / `is_negative` / `is_zero` boolean companions.
// Matches Rust i64::signum. The i64 siblings of the std/i32
// versions — the wide type is the one CLI / edge code reaches for
// (timestamps, byte counts, durations).
pub function (n: i64) signum(): i64 {
    if (n > (0 as i64)) { return 1 as i64; }
    if (n < (0 as i64)) { return (0 as i64) - (1 as i64); }
    return 0 as i64;
}

pub function (n: i64) is_positive(): boolean { return n > (0 as i64); }
pub function (n: i64) is_negative(): boolean { return n < (0 as i64); }
pub function (n: i64) is_zero(): boolean     { return n == (0 as i64); }

// `abs_diff(other)` — the absolute difference `|n - other|`, the wider
// counterpart to std/i32's `abs_diff`. Branches on the ordering and subtracts
// the smaller from the larger, so the result is the non-negative magnitude
// directly (avoiding `abs`'s own i64::MIN edge). There is no i128 to widen
// into, so a difference exceeding i64::MAX — only reachable when the operands
// straddle nearly the whole range — wraps.
pub function (n: i64) abs_diff(other: i64): i64 {
    if (n >= other) { return n - other; }
    return other - n;
}

// `(n: i64) midpoint(other)` — the average of `n` and `other`, rounded toward
// negative infinity, computed WITHOUT overflow via the classic
// `(a & b) + ((a ^ b) >> 1)` identity — the i64 sibling of std/i32's `midpoint`.
// The naive `(a + b) / 2` overflows for large same-sign operands; this form
// never does, so it is exact across the whole i64 range.
pub function (n: i64) midpoint(other: i64): i64 {
    return (n & other) + ((n ^ other) >> (1 as i64));
}

// `is_in_range(lo, hi)` — true iff `lo <= n < hi` (half-open); the wider
// counterpart to std/i32's `is_in_range`. Empty / inverted ranges → false.
pub function (n: i64) is_in_range(lo: i64, hi: i64): boolean {
    return n >= lo && n < hi;
}

// `is_between(lo, hi)` — inclusive range check (`lo <= n <= hi`); the closed-
// range companion to `is_in_range`, mirroring std/i32.
pub function (n: i64) is_between(lo: i64, hi: i64): boolean {
    return n >= lo && n <= hi;
}

// === i64 bit ops (the wider counterparts to std/i32's) ===

// `count_ones()` — the number of set bits in `n`'s 64-bit two's-complement
// representation (so a negative `n` counts the sign-extended high bits, like
// Rust's `i64::count_ones`). Software popcount, O(64) per call. Returns an i32.
pub function (n: i64) count_ones(): i32 {
    var u: u64 = n as u64;
    var c: i32 = 0;
    var i: i32 = 0;
    while (i < 64) {
        if ((u & (1 as u64)) != (0 as u64)) { c = c + 1; }
        u = u >> (1 as u64);
        i = i + 1;
    }
    return c;
}

// `count_zeros()` — the number of ZERO bits in the 64-bit two's-complement
// representation; the complement of `count_ones` (the two always sum to 64).
pub function (n: i64) count_zeros(): i32 {
    return 64 - n.count_ones();
}

// `leading_zeros()` — the number of zero bits above the highest set bit in
// the 64-bit two's-complement representation. `0` has all 64 leading zeros;
// a negative `n` has none (its sign bit is set). The i64 counterpart of
// std/i32's `leading_zeros`.
pub function (n: i64) leading_zeros(): i32 {
    if (n == (0 as i64)) { return 64; }
    var u: u64 = n as u64;
    // Top-bit mask = 1 << 63, built by shifting (no 64-bit hex literal).
    var top: u64 = (1 as u64) << (63 as u64);
    var c: i32 = 0;
    while ((u & top) == (0 as u64)) {
        c = c + 1;
        u = u << (1 as u64);
    }
    return c;
}

// `trailing_zeros()` — the number of zero bits below the lowest set bit.
// `0` has all 64 trailing zeros. The i64 counterpart of std/i32's.
pub function (n: i64) trailing_zeros(): i32 {
    if (n == (0 as i64)) { return 64; }
    var u: u64 = n as u64;
    var c: i32 = 0;
    while ((u & (1 as u64)) == (0 as u64)) {
        c = c + 1;
        u = u >> (1 as u64);
    }
    return c;
}

// `rotate_left(bits)` / `rotate_right(bits)` — cyclic bit rotation of the
// 64-bit pattern: bits shifted off one end re-enter the other (unlike `<<` /
// `>>`, which drop them). `bits` is taken mod 64, so any rotation count is
// valid. The i64 counterparts of std/i32's rotates.
pub function (n: i64) rotate_left(bits: i32): i64 {
    var k: i32 = bits & 63;
    if (k == 0) { return n; }
    var u: u64 = n as u64;
    var left: u64 = u << (k as u64);
    var right: u64 = u >> ((64 - k) as u64);
    return (left | right) as i64;
}

pub function (n: i64) rotate_right(bits: i32): i64 {
    var k: i32 = bits & 63;
    if (k == 0) { return n; }
    var u: u64 = n as u64;
    var right: u64 = u >> (k as u64);
    var left: u64 = u << ((64 - k) as u64);
    return (left | right) as i64;
}

// `bit_length()` — the number of bits needed to represent the MAGNITUDE `|n|`
// (highest set bit + 1), the wider counterpart to std/i32's `bit_length`. `0`
// needs 0 bits; a negative `n` uses its magnitude. i64::MIN is special-cased
// (its magnitude 2^63 needs 64 bits and `0 - MIN` would overflow). Returns i32.
pub function (n: i64) bit_length(): i32 {
    if (n == (0 as i64)) { return 0; }
    var mn: i64 = (0 as i64) - (9223372036854775807 as i64) - (1 as i64);  // i64::MIN
    if (n == mn) { return 64; }
    var mag: i64 = n;
    if (mag < (0 as i64)) { mag = 0 - mag; }
    var u: u64 = mag as u64;
    var c: i32 = 0;
    while (u != (0 as u64)) {
        c = c + 1;
        u = u >> (1 as u64);
    }
    return c;
}

// `to_string_radix(base)` — render `n` in an arbitrary `base` (2..36), digits
// `0-9a-z` (lowercase), signed (a negative `n` gets a leading `-`); the wider
// counterpart to std/i32's `to_string_radix`. The magnitude is taken as a u64
// (unsigned negation, so i64::MIN's magnitude 2^63 renders correctly without
// overflow) and divided down in `base`. An out-of-range base (< 2 or > 36)
// yields `""`. The write-side inverse of parsing an i64 in that base.
pub function (n: i64) to_string_radix(base: i32): string {
    if (base < 2 || base > 36) { return ""; }
    if (n == (0 as i64)) { return "0"; }
    var neg: boolean = (n < (0 as i64));
    var mag: u64 = n as u64;
    if (neg) { mag = (0 as u64) - mag; }        // unsigned negation → magnitude
    var b: u64 = base as u64;
    // Worst case is 64 binary digits + sign; allocate slack.
    var digits: u8[] = __alloc_u8(65);
    var k: i32 = 0;
    while (mag > (0 as u64)) {
        var d: i32 = (mag % b) as i32;
        digits = digits.with(k, int.__radix_char(d) as u8);
        k = k + 1;
        mag = mag / b;
    }
    var out_len: i32 = k;
    if (neg) { out_len = k + 1; }
    var buf: u8[] = __alloc_u8(out_len);
    var bi: i32 = 0;
    if (neg) {
        buf = buf.with(0, 45 as u8);            // '-'
        bi = 1;
    }
    var j: i32 = k - 1;
    while (j >= 0) {
        buf = buf.with(bi, digits[j]);
        bi = bi + 1;
        j = j - 1;
    }
    return string_from_bytes(buf);
}

// === i64 saturating / checked arithmetic ===
//
// `saturating_*` clamps to i64::MAX / i64::MIN instead of
// wrapping; `checked_*` returns None on overflow so the caller
// can decide. Overflow detection is sign-bit-based (same shape as
// the std/i32 versions): an add of two same-sign operands that
// flips sign overflowed, and a sub whose operands differ in sign
// from a wrong-signed result overflowed.

pub function (n: i64) saturating_add(other: i64): i64 {
    var r: i64 = n + other;
    if (n > (0 as i64) && other > (0 as i64) && r < (0 as i64)) { return 9223372036854775807 as i64; }
    if (n < (0 as i64) && other < (0 as i64) && r >= (0 as i64)) { return (0 as i64) - 9223372036854775807 - 1; }
    return r;
}

pub function (n: i64) saturating_sub(other: i64): i64 {
    var r: i64 = n - other;
    if (n >= (0 as i64) && other < (0 as i64) && r < (0 as i64)) { return 9223372036854775807 as i64; }
    if (n < (0 as i64) && other > (0 as i64) && r > (0 as i64)) { return (0 as i64) - 9223372036854775807 - 1; }
    return r;
}

pub function (n: i64) checked_add(other: i64): Option[i64] {
    var r: i64 = n + other;
    if (n > (0 as i64) && other > (0 as i64) && r < (0 as i64)) { return None; }
    if (n < (0 as i64) && other < (0 as i64) && r >= (0 as i64)) { return None; }
    return Some(r);
}

pub function (n: i64) checked_sub(other: i64): Option[i64] {
    var r: i64 = n - other;
    if (n >= (0 as i64) && other < (0 as i64) && r < (0 as i64)) { return None; }
    if (n < (0 as i64) && other > (0 as i64) && r > (0 as i64)) { return None; }
    return Some(r);
}

// `(n: i64) checked_div(other)` — None on divide-by-zero and on the single
// signed-overflow case `i64::MIN / -1` (whose true quotient is 2^63, one past
// i64::MAX); otherwise Some(n / other). The i64 sibling of std/i32's
// `checked_div`.
pub function (n: i64) checked_div(other: i64): Option[i64] {
    if (other == (0 as i64)) { return None; }
    var min64: i64 = (0 as i64) - (9223372036854775807 as i64) - (1 as i64);
    if (n == min64 && other == ((0 as i64) - (1 as i64))) { return None; }
    return Some(n / other);
}

// `(n: i64) checked_mul(other)` — `Some(n * other)`, or `None` on i64 overflow.
// The i64 sibling of std/i32's `checked_mul`, completing the `checked_` family.
// i64 has no wider type to widen into, so it detects overflow with the inverse
// division: a non-overflowing product divides back exactly (`p / n == other`),
// a wrap does not. The one case that check can't see — `i64::MIN * -1` (either
// order), which wraps to MIN while the inverse `MIN / -1` itself overflows — is
// rejected explicitly first.
pub function (n: i64) checked_mul(other: i64): Option[i64] {
    if (n == (0 as i64) || other == (0 as i64)) { return Some(0 as i64); }
    var min64: i64 = (0 as i64) - (9223372036854775807 as i64) - (1 as i64);
    var neg1: i64 = (0 as i64) - (1 as i64);
    if ((n == min64 && other == neg1) || (other == min64 && n == neg1)) { return None; }
    var p: i64 = n * other;
    if (p / n != other) { return None; }
    return Some(p);
}

// `(n: i64) saturating_mul(other)` — `n * other` clamped to the i64 range
// instead of wrapping: a positive overflow saturates to i64::MAX, a negative
// one to i64::MIN. The clamping companion of `checked_mul`; i64 has no wider
// type, so it reuses the inverse-division overflow test and picks the clamp
// bound from the sign of the true product (same-sign operands overflow high,
// opposite-sign overflow low). MIN * -1 (either order) overflows positive, so
// it clamps to MAX.
pub function (n: i64) saturating_mul(other: i64): i64 {
    if (n == (0 as i64) || other == (0 as i64)) { return 0 as i64; }
    var max64: i64 = 9223372036854775807 as i64;
    var min64: i64 = (0 as i64) - max64 - (1 as i64);
    var neg1: i64 = (0 as i64) - (1 as i64);
    if ((n == min64 && other == neg1) || (other == min64 && n == neg1)) { return max64; }
    var p: i64 = n * other;
    if (p / n != other) {
        if ((n > (0 as i64)) == (other > (0 as i64))) { return max64; }
        return min64;
    }
    return p;
}

// `(n: i64) checked_pow(exp)` — `Some(n ** exp)` by exponentiation-by-squaring,
// or `None` on i64 overflow; the i64 sibling of std/i32's `checked_pow`. i64 has
// no wider type, so each intermediate product is overflow-tested inline with the
// same inverse division `checked_mul` uses (`p / base == result` iff the multiply
// didn't wrap; `base` is non-zero throughout because `n == 0` is handled up
// front). Negative `exp` returns `None`; `exp == 0` is `Some(1)`. The final base
// squaring is skipped once the exponent is exhausted, so an exact result never
// reports a spurious overflow.
pub function (n: i64) checked_pow(exp: i32): Option[i64] {
    if (exp < 0) { return None; }
    if (n == (0 as i64)) {
        if (exp == 0) { return Some(1 as i64); }
        return Some(0 as i64);
    }
    var result: i64 = 1 as i64;
    var base: i64 = n;
    var e: i32 = exp;
    while (e > 0) {
        if (e % 2 == 1) {
            var p: i64 = result * base;
            if (p / base != result) { return None; }
            result = p;
        }
        e = e / 2;
        if (e > 0) {
            var q: i64 = base * base;
            if (q / base != base) { return None; }
            base = q;
        }
    }
    return Some(result);
}

// `(n: i64) overflowing_add(other)` / `overflowing_sub(other)` /
// `overflowing_mul(other)` — the wrapped result paired with a did-overflow
// boolean, the i64 siblings of std/i32's overflowing_* family. i64 mul has no
// wider type, so it wraps via `*` and detects overflow with the inverse
// division `checked_mul` uses (with the MIN * -1 special case, which wraps to
// MIN and reports overflow).
pub function (n: i64) overflowing_add(other: i64): (i64, boolean) {
    var r: i64 = n + other;
    return (r, (n > (0 as i64) && other > (0 as i64) && r < (0 as i64)) || (n < (0 as i64) && other < (0 as i64) && r >= (0 as i64)));
}
pub function (n: i64) overflowing_sub(other: i64): (i64, boolean) {
    var r: i64 = n - other;
    return (r, (n >= (0 as i64) && other < (0 as i64) && r < (0 as i64)) || (n < (0 as i64) && other > (0 as i64) && r > (0 as i64)));
}
pub function (n: i64) overflowing_mul(other: i64): (i64, boolean) {
    if (n == (0 as i64) || other == (0 as i64)) { return (0 as i64, false); }
    var min64: i64 = (0 as i64) - (9223372036854775807 as i64) - (1 as i64);
    var neg1: i64 = (0 as i64) - (1 as i64);
    var p: i64 = n * other;
    if ((n == min64 && other == neg1) || (other == min64 && n == neg1)) { return (p, true); }
    return (p, p / n != other);
}

// `(n: i64) sqrt_floor()` — floor of the integer square root, the i64 sibling
// of std/i32's `sqrt_floor`. Newton's method on the wider type, so it stays
// exact for magnitudes past the i32 range (e.g. `sqrt_floor(10000000000)` is
// `100000`). Non-positive `n` returns `0`.
pub function (n: i64) sqrt_floor(): i64 {
    if (n <= (0 as i64)) { return 0 as i64; }
    if (n < (4 as i64)) { return 1 as i64; }
    var x: i64 = n / (2 as i64);
    while (true) {
        var y: i64 = (x + n / x) / (2 as i64);
        if (y >= x) { return x; }
        x = y;
    }
    return x;
}

// `(n: i64) is_power_of_2()` — true iff `n` is a positive power of two, via the
// `n & (n - 1) == 0` bit trick (safe here because `n > 0` is checked first).
// `is_power_of_2(4611686018427387904)` (2^62) is true; zero and negatives are
// false.
pub function (n: i64) is_power_of_2(): boolean {
    if (n <= (0 as i64)) { return false; }
    return (n & (n - (1 as i64))) == (0 as i64);
}

// `(n: i64) is_perfect_square()` — true iff `n` is a non-negative perfect
// square, checked as `sqrt_floor(n) ^ 2 == n`. Exact into the i64 range where
// std/i32's version would overflow.
pub function (n: i64) is_perfect_square(): boolean {
    if (n < (0 as i64)) { return false; }
    var k: i64 = n.sqrt_floor();
    return k * k == n;
}

// `(n: i64) is_multiple_of(d)` — true iff `n` is an exact multiple of `d`.
// `d == 0` returns false (nothing is a multiple of zero here).
pub function (n: i64) is_multiple_of(d: i64): boolean {
    if (d == (0 as i64)) { return false; }
    return n % d == (0 as i64);
}

// `(n: i64) next_power_of_2()` — the smallest power of two `>= n`. Returns `1`
// for `n <= 1` (matching Rust's `next_power_of_two`). The largest power of two
// representable in a signed i64 is 2^62, so `n` above that returns `0` — the
// "no representable power" sentinel — which also keeps the doubling loop from
// running away past the sign boundary.
pub function (n: i64) next_power_of_2(): i64 {
    if (n <= (1 as i64)) { return 1 as i64; }
    if (n > (4611686018427387904 as i64)) { return 0 as i64; }
    var p: i64 = 1 as i64;
    while (p < n) { p = p * (2 as i64); }
    return p;
}

// `(n: i64) ceil_div(d)` — `n` divided by `d`, rounded toward positive infinity,
// via the standard `(n + d - 1) / d` for positive operands. `d <= 0` returns 0
// (undefined divisor); non-positive `n` falls back to plain truncating division.
pub function (n: i64) ceil_div(d: i64): i64 {
    if (d <= (0 as i64)) { return 0 as i64; }
    if (n <= (0 as i64)) { return n / d; }
    return (n + d - (1 as i64)) / d;
}

// `(n: i64) div_euclid(rhs)` — Euclidean division, the i64 sibling of std/i32's
// `div_euclid`: the quotient whose remainder `n - rhs*q` lands in `[0, |rhs|)`.
// For `n >= 0` it equals `n / rhs`; for negative `n` it rounds one step further
// from zero. `rhs` must be non-zero (same contract as `/`).
pub function (n: i64) div_euclid(rhs: i64): i64 {
    var q: i64 = n / rhs;
    if (n % rhs < (0 as i64)) {
        if (rhs > (0 as i64)) { return q - (1 as i64); }
        return q + (1 as i64);
    }
    return q;
}

// `(n: i64) rem_euclid(rhs)` — the non-negative Euclidean remainder in
// `[0, |rhs|)`, the i64 sibling of std/i32's `rem_euclid`. Pairs with
// `div_euclid`: `n == rhs * n.div_euclid(rhs) + n.rem_euclid(rhs)`. `rhs` must
// be non-zero.
pub function (n: i64) rem_euclid(rhs: i64): i64 {
    var r: i64 = n % rhs;
    if (r < (0 as i64)) {
        if (rhs < (0 as i64)) { return r - rhs; }
        return r + rhs;
    }
    return r;
}

// `(n: i64) log2_floor()` — `floor(log2(n))` for `n >= 1`; `-1` for `n <= 0`
// (no real log; the sentinel lets callers test `>= 0` for "valid"). Counts
// halvings rather than leaning on `leading_zeros` (which i64 doesn't expose),
// so it spans the full 0..62 exponent range.
pub function (n: i64) log2_floor(): i32 {
    if (n <= (0 as i64)) { return 0 - 1; }
    var r: i32 = 0;
    var m: i64 = n;
    while (m > (1 as i64)) { m = m / (2 as i64); r = r + 1; }
    return r;
}

// `(n: i64) log10_floor()` — `floor(log10(n))` for `n >= 1`; `-1` for `n <= 0`
// (the same `>= 0`-means-valid sentinel as `log2_floor`), returned as an i32
// (the exponent spans 0..18 across the i64 range). The base-10 sibling of
// `log2_floor` and the wide digit-count primitive — a positive `n` has
// `n.log10_floor() + 1` decimal digits. Counts divisions by ten, so it stays
// exact where a float `log10` would round near powers of ten.
pub function (n: i64) log10_floor(): i32 {
    if (n <= (0 as i64)) { return 0 - 1; }
    var r: i32 = 0;
    var m: i64 = n;
    while (m >= (10 as i64)) { m = m / (10 as i64); r = r + 1; }
    return r;
}

// `byte_swap()` — reverse the 8 bytes of `n` (endianness swap). The
// 64-bit counterpart of std/i32's `byte_swap`; useful for big-/little-
// endian conversion of wide integers.
pub function (n: i64) byte_swap(): i64 {
    var u: u64 = n as u64;
    var r: u64 = 0 as u64;
    var i: i32 = 0;
    while (i < 8) {
        var b: u64 = (u >> ((i * 8) as u64)) & (255 as u64);
        r = r | (b << (((7 - i) * 8) as u64));
        i = i + 1;
    }
    return r as i64;
}

// `(n: i64) reverse_bits()` — reverse the ORDER of the 64 bits: bit i moves to
// bit 63-i. The i64 sibling of std/i32's `reverse_bits` and the bit-level
// counterpart of `byte_swap`. Operates on the raw two's-complement pattern via
// u64 (logical shifts), so it round-trips
// (`n.reverse_bits().reverse_bits() == n`).
pub function (n: i64) reverse_bits(): i64 {
    var u: u64 = n as u64;
    var r: u64 = 0 as u64;
    var i: i32 = 0;
    while (i < 64) {
        r = (r << (1 as u64)) | (u & (1 as u64));
        u = u >> (1 as u64);
        i = i + 1;
    }
    return r as i64;
}

// `bit(i)` / `set_bit(i)` / `clear_bit(i)` / `toggle_bit(i)` — read /
// set / clear / flip bit `i` (0 = LSB), the 64-bit counterparts to
// std/i32's accessors. An out-of-range `i` (< 0 or >= 64) reads false /
// returns `n` unchanged.
pub function (n: i64) bit(i: i32): boolean {
    if (i < 0 || i >= 64) { return false; }
    var mask: u64 = (1 as u64) << (i as u64);
    return ((n as u64) & mask) != (0 as u64);
}
pub function (n: i64) set_bit(i: i32): i64 {
    if (i < 0 || i >= 64) { return n; }
    var mask: u64 = (1 as u64) << (i as u64);
    return ((n as u64) | mask) as i64;
}
pub function (n: i64) clear_bit(i: i32): i64 {
    if (i < 0 || i >= 64) { return n; }
    var mask: u64 = (1 as u64) << (i as u64);
    var inv: u64 = (((0 as i64) - (1 as i64)) as u64) ^ mask;
    return ((n as u64) & inv) as i64;
}
pub function (n: i64) toggle_bit(i: i32): i64 {
    if (i < 0 || i >= 64) { return n; }
    var mask: u64 = (1 as u64) << (i as u64);
    return ((n as u64) ^ mask) as i64;
}
