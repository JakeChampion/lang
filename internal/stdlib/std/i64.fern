// This module provides signed 64-bit integer methods.

import "core/int";

pub function (n: i64) abs(): i64 {
  if (n < 0 as i64) {
    return 0 as i64 - n;
  }
  return n;
}

pub function (n: i64) min(other: i64): i64 {
  if (n < other) {
    return n;
  }
  return other;
}

pub function (n: i64) max(other: i64): i64 {
  if (n > other) {
    return n;
  }
  return other;
}

pub function (n: i64) clamp(lo: i64, hi: i64): i64 {
  if (n < lo) {
    return lo;
  }
  if (n > hi) {
    return hi;
  }
  return n;
}

pub function (n: i64) pow(exp: i32): i64 {
  if (exp < 0) {
    return 0 as i64;
  }
  let base: i64 = n;
  let e: i32 = exp;
  let out: i64 = 1 as i64;
  while (e > 0) {
    if (e % 2 == 1) {
      out = out * base;
    }
    base = base * base;
    e = e / 2;
  }
  return out;
}

pub function (n: i64) gcd(other: i64): i64 {
  let a: i64 = n.abs();
  let b: i64 = other.abs();
  while (b != 0 as i64) {
    let t: i64 = b;
    b = a % b;
    a = t;
  }
  return a;
}

pub function (n: i64) lcm(other: i64): i64 {
  if (n == 0 as i64 || other == 0 as i64) {
    return 0 as i64;
  }
  let g: i64 = n.gcd(other);
  return (n / g).abs() * other.abs();
}

pub function (n: i64) to_string(): string {
  let mag: i64 = n;
  let neg: i32 = 0;
  if (n < 0 as i64) {
    neg = 1;
    mag = 0 as i64 - n;
  }
  return int.__int_to_string_u64(mag, neg);
}

pub function (n: i64) is_even(): boolean {
  return n % (2 as i64) == 0 as i64;
}

pub function (n: i64) is_odd(): boolean {
  return n % (2 as i64) != 0 as i64;
}

pub function (n: i64) signum(): i64 {
  if (n > 0 as i64) {
    return 1 as i64;
  }
  if (n < 0 as i64) {
    return 0 as i64 - 1 as i64;
  }
  return 0 as i64;
}

pub function (n: i64) is_positive(): boolean {
  return n > 0 as i64;
}

pub function (n: i64) is_negative(): boolean {
  return n < 0 as i64;
}

pub function (n: i64) is_zero(): boolean {
  return n == 0 as i64;
}

pub function (n: i64) abs_diff(other: i64): i64 {
  if (n >= other) {
    return n - other;
  }
  return other - n;
}

pub function (n: i64) midpoint(other: i64): i64 {
  return (n & other) + ((n ^ other) >> 1 as i64);
}

pub function (n: i64) is_in_range(lo: i64, hi: i64): boolean {
  return n >= lo && n < hi;
}

pub function (n: i64) is_between(lo: i64, hi: i64): boolean {
  return n >= lo && n <= hi;
}

pub function (n: i64) count_ones(): i32 {
  return __popcount64(n as u64);
}

pub function (n: i64) count_zeros(): i32 {
  return 64 - n.count_ones();
}

pub function (n: i64) leading_zeros(): i32 {
  return __clz64(n as u64);
}

pub function (n: i64) trailing_zeros(): i32 {
  return __ctz64(n as u64);
}

pub function (n: i64) rotate_left(bits: i32): i64 {
  let k: i32 = bits & 63;
  if (k == 0) {
    return n;
  }
  let u: u64 = n as u64;
  let left: u64 = u << k as u64;
  let right: u64 = u >> (64 - k) as u64;
  return (left | right) as i64;
}

pub function (n: i64) rotate_right(bits: i32): i64 {
  let k: i32 = bits & 63;
  if (k == 0) {
    return n;
  }
  let u: u64 = n as u64;
  let right: u64 = u >> k as u64;
  let left: u64 = u << (64 - k) as u64;
  return (left | right) as i64;
}

pub function (n: i64) bit_length(): i32 {
  if (n == 0 as i64) {
    return 0;
  }
  let mn: i64 = 0 as i64 - 9223372036854775807 as i64 - 1 as i64;
  if (n == mn) {
    return 64;
  }
  let mag: i64 = n;
  if (mag < 0 as i64) {
    mag = 0 - mag;
  }
  let u: u64 = mag as u64;
  let c: i32 = 0;
  while (u != 0 as u64) {
    c = c + 1;
    u = u >> 1 as u64;
  }
  return c;
}

pub function (n: i64) to_string_radix(base: i32): string {
  if (base < 2 || base > 36) {
    return "";
  }
  if (n == 0 as i64) {
    return "0";
  }
  let neg: boolean = n < 0 as i64;
  let mag: u64 = n as u64;
  if (neg) {
    mag = 0 as u64 - mag;
  }
  let b: u64 = base as u64;
  let digits: u8[] = __alloc_u8(65);
  let k: i32 = 0;
  while (mag > 0 as u64) {
    let d: i32 = (mag % b) as i32;
    digits = digits.with(k, int.__radix_char(d) as u8);
    k = k + 1;
    mag = mag / b;
  }
  let out_len: i32 = k;
  if (neg) {
    out_len = k + 1;
  }
  let buf: u8[] = __alloc_u8(out_len);
  let bi: i32 = 0;
  if (neg) {
    buf = buf.with(0, 45 as u8);
    bi = 1;
  }
  let j: i32 = k - 1;
  while (j >= 0) {
    buf = buf.with(bi, digits[j]);
    bi = bi + 1;
    j = j - 1;
  }
  return string_from_bytes_unchecked(buf);
}

pub function (n: i64) saturating_add(other: i64): i64 {
  let r: i64 = n + other;
  if (n > 0 as i64 && other > 0 as i64 && r < 0 as i64) {
    return 9223372036854775807 as i64;
  }
  if (n < 0 as i64 && other < 0 as i64 && r >= 0 as i64) {
    return 0 as i64 - 9223372036854775807 - 1;
  }
  return r;
}

pub function (n: i64) saturating_sub(other: i64): i64 {
  let r: i64 = n - other;
  if (n >= 0 as i64 && other < 0 as i64 && r < 0 as i64) {
    return 9223372036854775807 as i64;
  }
  if (n < 0 as i64 && other > 0 as i64 && r > 0 as i64) {
    return 0 as i64 - 9223372036854775807 - 1;
  }
  return r;
}

pub function (n: i64) checked_add(other: i64): Option[i64] {
  let r: i64 = n + other;
  if (n > 0 as i64 && other > 0 as i64 && r < 0 as i64) {
    return None;
  }
  if (n < 0 as i64 && other < 0 as i64 && r >= 0 as i64) {
    return None;
  }
  return Some(r);
}

pub function (n: i64) checked_sub(other: i64): Option[i64] {
  let r: i64 = n - other;
  if (n >= 0 as i64 && other < 0 as i64 && r < 0 as i64) {
    return None;
  }
  if (n < 0 as i64 && other > 0 as i64 && r > 0 as i64) {
    return None;
  }
  return Some(r);
}

pub function (n: i64) checked_div(other: i64): Option[i64] {
  if (other == 0 as i64) {
    return None;
  }
  let min64: i64 = 0 as i64 - 9223372036854775807 as i64 - 1 as i64;
  if (n == min64 && other == 0 as i64 - 1 as i64) {
    return None;
  }
  return Some(n / other);
}

pub function (n: i64) checked_rem(other: i64): Option[i64] {
  if (other == 0 as i64) {
    return None;
  }
  let min64: i64 = 0 as i64 - 9223372036854775807 as i64 - 1 as i64;
  if (n == min64 && other == 0 as i64 - 1 as i64) {
    return None;
  }
  return Some(n % other);
}

pub function (n: i64) checked_mul(other: i64): Option[i64] {
  if (n == 0 as i64 || other == 0 as i64) {
    return Some(0 as i64);
  }
  let min64: i64 = 0 as i64 - 9223372036854775807 as i64 - 1 as i64;
  let neg1: i64 = 0 as i64 - 1 as i64;
  if (n == min64 && other == neg1 || other == min64 && n == neg1) {
    return None;
  }
  let p: i64 = n * other;
  if (p / n != other) {
    return None;
  }
  return Some(p);
}

pub function (n: i64) saturating_mul(other: i64): i64 {
  if (n == 0 as i64 || other == 0 as i64) {
    return 0 as i64;
  }
  let max64: i64 = 9223372036854775807 as i64;
  let min64: i64 = 0 as i64 - max64 - 1 as i64;
  let neg1: i64 = 0 as i64 - 1 as i64;
  if (n == min64 && other == neg1 || other == min64 && n == neg1) {
    return max64;
  }
  let p: i64 = n * other;
  if (p / n != other) {
    if (n > 0 as i64 == other > 0 as i64) {
      return max64;
    }
    return min64;
  }
  return p;
}

pub function (n: i64) saturating_div(other: i64): i64 {
  let min64: i64 = 0 as i64 - 9223372036854775807 as i64 - 1 as i64;
  if (n == min64 && other == 0 as i64 - 1 as i64) {
    return 9223372036854775807 as i64;
  }
  return n / other;
}

pub function (n: i64) saturating_neg(): i64 {
  if (n == 0 as i64 - 9223372036854775807 as i64 - 1 as i64) {
    return 9223372036854775807 as i64;
  }
  return 0 as i64 - n;
}

pub function (n: i64) saturating_abs(): i64 {
  if (n == 0 as i64 - 9223372036854775807 as i64 - 1 as i64) {
    return 9223372036854775807 as i64;
  }
  if (n < 0 as i64) {
    return 0 as i64 - n;
  }
  return n;
}

pub function (n: i64) checked_pow(exp: i32): Option[i64] {
  if (exp < 0) {
    return None;
  }
  if (n == 0 as i64) {
    if (exp == 0) {
      return Some(1 as i64);
    }
    return Some(0 as i64);
  }
  let result: i64 = 1 as i64;
  let base: i64 = n;
  let e: i32 = exp;
  while (e > 0) {
    if (e % 2 == 1) {
      let p: i64 = result * base;
      if (p / base != result) {
        return None;
      }
      result = p;
    }
    e = e / 2;
    if (e > 0) {
      let q: i64 = base * base;
      if (q / base != base) {
        return None;
      }
      base = q;
    }
  }
  return Some(result);
}

pub function (n: i64) overflowing_add(other: i64): (i64, boolean) {
  let r: i64 = n + other;
  return (r, n > 0 as i64 && other > 0 as i64 && r < 0 as i64 || n < 0 as i64 && other < 0 as i64 && r >= 0 as i64);
}

pub function (n: i64) overflowing_sub(other: i64): (i64, boolean) {
  let r: i64 = n - other;
  return (r, n >= 0 as i64 && other < 0 as i64 && r < 0 as i64 || n < 0 as i64 && other > 0 as i64 && r > 0 as i64);
}

pub function (n: i64) overflowing_mul(other: i64): (i64, boolean) {
  if (n == 0 as i64 || other == 0 as i64) {
    return (0 as i64, false);
  }
  let min64: i64 = 0 as i64 - 9223372036854775807 as i64 - 1 as i64;
  let neg1: i64 = 0 as i64 - 1 as i64;
  let p: i64 = n * other;
  if (n == min64 && other == neg1 || other == min64 && n == neg1) {
    return (p, true);
  }
  return (p, p / n != other);
}

pub function (n: i64) overflowing_div(other: i64): (i64, boolean) {
  let min64: i64 = 0 as i64 - 9223372036854775807 as i64 - 1 as i64;
  if (n == min64 && other == 0 as i64 - 1 as i64) {
    return (min64, true);
  }
  return (n / other, false);
}

pub function (n: i64) overflowing_rem(other: i64): (i64, boolean) {
  let min64: i64 = 0 as i64 - 9223372036854775807 as i64 - 1 as i64;
  if (n == min64 && other == 0 as i64 - 1 as i64) {
    return (0 as i64, true);
  }
  return (n % other, false);
}

pub function (n: i64) checked_neg(): Option[i64] {
  if (n == 0 as i64 - 9223372036854775807 as i64 - 1 as i64) {
    return None;
  }
  return Some(0 as i64 - n);
}

pub function (n: i64) checked_abs(): Option[i64] {
  if (n == 0 as i64 - 9223372036854775807 as i64 - 1 as i64) {
    return None;
  }
  if (n < 0 as i64) {
    return Some(0 as i64 - n);
  }
  return Some(n);
}

pub function (n: i64) unsigned_abs(): u64 {
  if (n < 0 as i64) {
    return (0 as i64 - n) as u64;
  }
  return n as u64;
}

pub function (n: i64) overflowing_neg(): (i64, boolean) {
  if (n == 0 as i64 - 9223372036854775807 as i64 - 1 as i64) {
    return (n, true);
  }
  return (0 as i64 - n, false);
}

pub function (n: i64) checked_shl(rhs: i32): Option[i64] {
  return n <<? rhs as i64;
}

pub function (n: i64) checked_shr(rhs: i32): Option[i64] {
  return n >>? rhs as i64;
}

pub function (n: i64) sqrt_floor(): i64 {
  if (n <= 0 as i64) {
    return 0 as i64;
  }
  if (n < 4 as i64) {
    return 1 as i64;
  }
  let x: i64 = n / (2 as i64);
  while (true) {
    let y: i64 = (x + n / x) / (2 as i64);
    if (y >= x) {
      return x;
    }
    x = y;
  }
  return x;
}

pub function (n: i64) is_power_of_2(): boolean {
  if (n <= 0 as i64) {
    return false;
  }
  return (n & n - 1 as i64) == 0 as i64;
}

pub function (n: i64) is_perfect_square(): boolean {
  if (n < 0 as i64) {
    return false;
  }
  let k: i64 = n.sqrt_floor();
  return k * k == n;
}

pub function (n: i64) is_multiple_of(d: i64): boolean {
  if (d == 0 as i64) {
    return false;
  }
  return n % d == 0 as i64;
}

pub function (n: i64) next_power_of_2(): i64 {
  if (n <= 1 as i64) {
    return 1 as i64;
  }
  if (n > 4611686018427387904 as i64) {
    return 0 as i64;
  }
  let p: i64 = 1 as i64;
  while (p < n) {
    p = p * (2 as i64);
  }
  return p;
}

pub function (n: i64) ceil_div(d: i64): i64 {
  if (d <= 0 as i64) {
    return 0 as i64;
  }
  if (n <= 0 as i64) {
    return n / d;
  }
  return (n + d - 1 as i64) / d;
}

pub function (n: i64) div_euclid(rhs: i64): i64 {
  let q: i64 = n / rhs;
  if (n % rhs < 0 as i64) {
    if (rhs > 0 as i64) {
      return q - 1 as i64;
    }
    return q + 1 as i64;
  }
  return q;
}

pub function (n: i64) rem_euclid(rhs: i64): i64 {
  let r: i64 = n % rhs;
  if (r < 0 as i64) {
    if (rhs < 0 as i64) {
      return r - rhs;
    }
    return r + rhs;
  }
  return r;
}

pub function (n: i64) log2_floor(): i32 {
  if (n <= 0 as i64) {
    return 0 - 1;
  }
  let r: i32 = 0;
  let m: i64 = n;
  while (m > 1 as i64) {
    m = m / (2 as i64);
    r = r + 1;
  }
  return r;
}

pub function (n: i64) log10_floor(): i32 {
  if (n <= 0 as i64) {
    return 0 - 1;
  }
  let r: i32 = 0;
  let m: i64 = n;
  while (m >= 10 as i64) {
    m = m / (10 as i64);
    r = r + 1;
  }
  return r;
}

pub function (n: i64) byte_swap(): i64 {
  let u: u64 = n as u64;
  let r: u64 = 0 as u64;
  let i: i32 = 0;
  while (i < 8) {
    let b: u64 = u >> (i * 8) as u64 & 255 as u64;
    r = r | b << ((7 - i) * 8) as u64;
    i = i + 1;
  }
  return r as i64;
}

pub function (n: i64) reverse_bits(): i64 {
  let u: u64 = n as u64;
  let r: u64 = 0 as u64;
  let i: i32 = 0;
  while (i < 64) {
    r = r << 1 as u64 | u & 1 as u64;
    u = u >> 1 as u64;
    i = i + 1;
  }
  return r as i64;
}

pub function (n: i64) bit(i: i32): boolean {
  if (i < 0 || i >= 64) {
    return false;
  }
  let mask: u64 = 1 as u64 << i as u64;
  return (n as u64 & mask) != 0 as u64;
}

pub function (n: i64) set_bit(i: i32): i64 {
  if (i < 0 || i >= 64) {
    return n;
  }
  let mask: u64 = 1 as u64 << i as u64;
  return (n as u64 | mask) as i64;
}

pub function (n: i64) clear_bit(i: i32): i64 {
  if (i < 0 || i >= 64) {
    return n;
  }
  let mask: u64 = 1 as u64 << i as u64;
  let inv: u64 = (0 as i64 - 1 as i64) as u64 ^ mask;
  return (n as u64 & inv) as i64;
}

pub function (n: i64) toggle_bit(i: i32): i64 {
  if (i < 0 || i >= 64) {
    return n;
  }
  let mask: u64 = 1 as u64 << i as u64;
  return (n as u64 ^ mask) as i64;
}

pub function (n: i64) div_ceil(d: i64): i64 {
  if (d == 0) {
    return 0;
  }
  let q: i64 = n / d;
  let r: i64 = n % d;
  if (r > 0 && d > 0 || r < 0 && d < 0) {
    return q + 1;
  }
  return q;
}

pub function (n: i64) div_floor(d: i64): i64 {
  if (d == 0) {
    return 0;
  }
  let q: i64 = n / d;
  let r: i64 = n % d;
  if (r > 0 && d < 0 || r < 0 && d > 0) {
    return q - 1;
  }
  return q;
}

pub function (n: i64) next_multiple_of(d: i64): i64 {
  if (d == 0) {
    return 0;
  }
  return n.div_ceil(d) * d;
}

pub function gcd_all(xs: i64[]): i64 {
  let g: i64 = 0;
  let i: i32 = 0;
  while (i < xs.len()) {
    g = g.gcd(xs[i]);
    i = i + 1;
  }
  return g;
}

pub function lcm_all(xs: i64[]): i64 {
  let l: i64 = 1;
  let i: i32 = 0;
  while (i < xs.len()) {
    l = l.lcm(xs[i]);
    i = i + 1;
  }
  return l;
}
