// std/uuid — UUID generation (RFC 4122 / RFC 9562).
//
// `uuid_v4()` — a random version-4 UUID. `uuid_v7()` — a
// time-ordered version-7 UUID (48-bit Unix-ms timestamp prefix +
// random tail), useful as a sortable identifier. Both render the
// canonical hyphenated lowercase form `xxxxxxxx-xxxx-xxxx-xxxx-
// xxxxxxxxxxxx`. The companion validator is `string.is_uuid()`.
//
// The byte source is `random_bytes(n)` (kernel CSPRNG); a UUID
// string is built purely from string concat + a sliced hex-digit
// literal, so `uuid_v4` lowers through the self-hosted compiler's
// IR path on every backend (no chr / byte-array round-trip).

// uuid_hex_digit renders a nibble (0-15) as a one-character
// lowercase hex string. Slicing a literal (rather than `chr`)
// keeps the helper in the IR-lowerable string subset.
function uuid_hex_digit(n: i32): str {
    return "0123456789abcdef"[n : n + 1];
}

// uuid_byte_hex renders a byte (0-255) as two lowercase hex chars.
function uuid_byte_hex(b: i32): string {
    return uuid_hex_digit((b >> 4) & 15) + uuid_hex_digit(b & 15);
}

// uuid_v4(): a random UUID. Bytes 6 and 8 carry the version (4)
// and the RFC 4122 variant (10xx); every other byte is random.
pub function uuid_v4(): string {
    var b: string = random_bytes(16);
    var b6: i32 = ((b[6] as i32) & 15) | 64;    // version 4 in the high nibble
    var b8: i32 = ((b[8] as i32) & 63) | 128;   // variant 10xx in the high bits
    return uuid_byte_hex((b[0] as i32)) + uuid_byte_hex((b[1] as i32)) + uuid_byte_hex((b[2] as i32)) + uuid_byte_hex((b[3] as i32))
        + "-" + uuid_byte_hex((b[4] as i32)) + uuid_byte_hex((b[5] as i32))
        + "-" + uuid_byte_hex(b6) + uuid_byte_hex((b[7] as i32))
        + "-" + uuid_byte_hex(b8) + uuid_byte_hex((b[9] as i32))
        + "-" + uuid_byte_hex((b[10] as i32)) + uuid_byte_hex((b[11] as i32)) + uuid_byte_hex((b[12] as i32))
        + uuid_byte_hex((b[13] as i32)) + uuid_byte_hex((b[14] as i32)) + uuid_byte_hex((b[15] as i32));
}

// uuid_v7(): a time-ordered UUID. The first 48 bits are the
// big-endian Unix-millisecond timestamp; byte 6 carries version 7,
// byte 8 the variant, and the remaining 74 bits are random. Two
// v7s minted in the same millisecond order by their random tail.
pub function uuid_v7(): string {
    var ms: i64 = now_unix_ms();
    var r: string = random_bytes(10);  // 10 random bytes for the tail
    var t0: i32 = ((ms >> 40) & 255) as i32;
    var t1: i32 = ((ms >> 32) & 255) as i32;
    var t2: i32 = ((ms >> 24) & 255) as i32;
    var t3: i32 = ((ms >> 16) & 255) as i32;
    var t4: i32 = ((ms >> 8) & 255) as i32;
    var t5: i32 = (ms & 255) as i32;
    var b6: i32 = ((r[0] as i32) & 15) | 112;   // version 7 in the high nibble
    var b8: i32 = ((r[2] as i32) & 63) | 128;   // variant 10xx in the high bits
    return uuid_byte_hex(t0) + uuid_byte_hex(t1) + uuid_byte_hex(t2) + uuid_byte_hex(t3)
        + "-" + uuid_byte_hex(t4) + uuid_byte_hex(t5)
        + "-" + uuid_byte_hex(b6) + uuid_byte_hex((r[1] as i32))
        + "-" + uuid_byte_hex(b8) + uuid_byte_hex((r[3] as i32))
        + "-" + uuid_byte_hex((r[4] as i32)) + uuid_byte_hex((r[5] as i32)) + uuid_byte_hex((r[6] as i32))
        + uuid_byte_hex((r[7] as i32)) + uuid_byte_hex((r[8] as i32)) + uuid_byte_hex((r[9] as i32));
}

// `uuid_nil()` — the all-zeros "nil" UUID (RFC 4122 §5.9), the
// canonical sentinel / default value.
pub function uuid_nil(): string {
    return "00000000-0000-0000-0000-000000000000";
}

// `uuid_is_nil(s)` — true iff `s` is exactly the nil UUID.
pub function uuid_is_nil(s: string): boolean {
    return s == uuid_nil();
}

// __uuid_nibble(b) — hex value 0..15 of an ASCII hex byte, or -1.
function __uuid_nibble(b: i32): i32 {
    if (b >= 48 && b <= 57) { return b - 48; }        // '0'..'9'
    if (b >= 97 && b <= 102) { return b - 97 + 10; }  // 'a'..'f'
    if (b >= 65 && b <= 70) { return b - 65 + 10; }   // 'A'..'F'
    return -1;
}

// `uuid_version(s)` — the version number a canonical UUID encodes in
// the first nibble of its 3rd group (index 14): `4` for `uuid_v4()`,
// `7` for `uuid_v7()`, `0` for `uuid_nil()`. Returns -1 unless `s` is a
// well-formed 36-char hyphenated UUID (correct length, hyphens at
// 8/13/18/23, a hex version nibble). Structural check only — for full
// validation call `string.is_uuid()` first.
pub function uuid_version(s: string): i32 {
    if (s.len() != 36) { return -1; }
    if (s[8] != 45 || s[13] != 45 || s[18] != 45 || s[23] != 45) { return -1; }   // '-'
    return __uuid_nibble((s[14] as i32));
}
