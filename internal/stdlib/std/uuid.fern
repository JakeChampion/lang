// This module generates and validates UUIDs.

import "std/hex";
import "std/i32";

function canonical(b: u8[]): string {
  let h: string = hex.hex_encode(b);
  return slice_unchecked(h, 0, 8) + "-" + slice_unchecked(h, 8, 12) + "-" + slice_unchecked(h, 12, 16)
    + "-" + slice_unchecked(h, 16, 20) + "-" + slice_unchecked(h, 20, 32);
}

pub function uuid_v4(): string {
  let b: u8[] = random_bytes(16);
  b = b.with(6, b[6] & 15 | 64);
  b = b.with(8, b[8] & 63 | 128);
  return canonical(b);
}

pub function uuid_v7(): string {
  let ms: i64 = now_unix_ms();
  let r: u8[] = random_bytes(10);
  let b: u8[] = [];
  let shift: i64 = 40;
  while (shift >= 0) {
    b = b.append((ms >> shift & 255) as u8);
    shift = shift - 8;
  }
  b = b.append(r[0] & 15 | 112);
  b = b.append(r[1]);
  b = b.append(r[2] & 63 | 128);
  let i: i32 = 3;
  while (i < 10) {
    b = b.append(r[i]);
    i = i + 1;
  }
  return canonical(b);
}

pub function uuid_nil(): string {
  return "00000000-0000-0000-0000-000000000000";
}

pub function uuid_is_nil(s: string): boolean {
  return s == uuid_nil();
}

pub function is_valid(s: string): boolean {
  if (s.len() != 36) {
    return false;
  }
  let i: i32 = 0;
  while (i < 36) {
    if (i == 8 || i == 13 || i == 18 || i == 23) {
      if (s[i] != 45) {
        return false;
      }
    } else {
      if (!s[i].is_ascii_hex_digit()) {
        return false;
      }
    }
    i = i + 1;
  }
  return true;
}

pub function uuid_version(s: string): Option[i32] {
  if (!is_valid(s)) {
    return None;
  }
  return s[14].hex_value();
}
