// std/num — arithmetic operator traits + a `Num` supertrait, with impls for
// the built-in numeric types.
//
// These give generic code the vocabulary to bound a type parameter on
// arithmetic and dispatch the operation by method:
//
//     import "std/num" as num;
//
//     function (a: T[]) total[T: num.Num](init: T): T {
//         var s = init;
//         var i = 0;
//         while (i < a.len()) { s = s.add(a[i]); i = i + 1; }
//         return s;
//     }
//     var xs: i64[] = [40, 2];
//     var t: i64 = xs.total(0);            // works for ANY Num element type
//
// The method names match the operator-overload convention (#2706: `+` -> add,
// `-` -> sub, `*` -> mul, `/` -> div, unary `-` -> neg), so a user struct that
// `impl`s these gets BOTH the `+`/`-`/… operators on the concrete type AND the
// `T: Add` / `T: Num` bound for generic use. On the built-in numeric types the
// operators stay native (operator overloading only intercepts composite types);
// these impls just expose the same operation as a method + satisfy the bound.
//
// `Num` is the supertrait of the four binary operators — the common bound for
// generic numeric code (`T: num.Num` ⇒ add/sub/mul/div all available). `Neg` is
// separate and implemented for the signed/float types only (i32/i64/f32/f64);
// the unsigned u32/u64 get Add/Sub/Mul/Div/Num but no Neg.

import "core/iter";

pub trait Add { function add(self: Self, o: Self): Self; }
pub trait Sub { function sub(self: Self, o: Self): Self; }
pub trait Mul { function mul(self: Self, o: Self): Self; }
pub trait Div { function div(self: Self, o: Self): Self; }
pub trait Neg { function neg(self: Self): Self; }
// Zero is the additive identity (0) as an associated function, so generic
// reducers can seed an accumulator without a caller-supplied init
// (`var s = T.zero();`). Kept a STANDALONE trait — not folded into Num — so its
// primitive impls register across module imports the same way Add/Sub/… do.
pub trait Zero { function zero(): Self; }
// One is the multiplicative identity (1) as an associated function — the
// `product` counterpart to Zero. Standalone (like Zero) so its primitive
// impls register across module imports.
pub trait One { function one(): Self; }

// Num bundles the four binary arithmetic operators — the conventional bound for
// "any number". Implementors get it for free once they impl Add/Sub/Mul/Div.
pub trait Num: Add + Sub + Mul + Div {}

// ---- i32 ----
impl Add for i32 { function add(self: Self, o: Self): Self { return self + o; } }
impl Sub for i32 { function sub(self: Self, o: Self): Self { return self - o; } }
impl Mul for i32 { function mul(self: Self, o: Self): Self { return self * o; } }
impl Div for i32 { function div(self: Self, o: Self): Self { return self / o; } }
impl Neg for i32 { function neg(self: Self): Self { return 0 - self; } }
impl Zero for i32 { function zero(): Self { return 0; } }
impl One for i32 { function one(): Self { return 1; } }
impl Num for i32 {}

// ---- i64 ----
impl Add for i64 { function add(self: Self, o: Self): Self { return self + o; } }
impl Sub for i64 { function sub(self: Self, o: Self): Self { return self - o; } }
impl Mul for i64 { function mul(self: Self, o: Self): Self { return self * o; } }
impl Div for i64 { function div(self: Self, o: Self): Self { return self / o; } }
impl Neg for i64 { function neg(self: Self): Self { return 0 - self; } }
impl Zero for i64 { function zero(): Self { return 0; } }
impl One for i64 { function one(): Self { return 1; } }
impl Num for i64 {}

// ---- f64 ----
impl Add for f64 { function add(self: Self, o: Self): Self { return self + o; } }
impl Sub for f64 { function sub(self: Self, o: Self): Self { return self - o; } }
impl Mul for f64 { function mul(self: Self, o: Self): Self { return self * o; } }
impl Div for f64 { function div(self: Self, o: Self): Self { return self / o; } }
impl Neg for f64 { function neg(self: Self): Self { return 0.0 - self; } }
impl Zero for f64 { function zero(): Self { return 0.0; } }
impl One for f64 { function one(): Self { return 1.0; } }
impl Num for f64 {}

// ---- f32 ----
impl Add for f32 { function add(self: Self, o: Self): Self { return self + o; } }
impl Sub for f32 { function sub(self: Self, o: Self): Self { return self - o; } }
impl Mul for f32 { function mul(self: Self, o: Self): Self { return self * o; } }
impl Div for f32 { function div(self: Self, o: Self): Self { return self / o; } }
impl Neg for f32 { function neg(self: Self): Self { return 0.0 - self; } }
impl Zero for f32 { function zero(): Self { return 0.0; } }
impl One for f32 { function one(): Self { return 1.0; } }
impl Num for f32 {}

// ---- u32 ---- (unsigned: no Neg)
impl Add for u32 { function add(self: Self, o: Self): Self { return self + o; } }
impl Sub for u32 { function sub(self: Self, o: Self): Self { return self - o; } }
impl Mul for u32 { function mul(self: Self, o: Self): Self { return self * o; } }
impl Div for u32 { function div(self: Self, o: Self): Self { return self / o; } }
impl Zero for u32 { function zero(): Self { return 0; } }
impl One for u32 { function one(): Self { return 1; } }
impl Num for u32 {}

// ---- u64 ---- (unsigned: no Neg)
impl Add for u64 { function add(self: Self, o: Self): Self { return self + o; } }
impl Sub for u64 { function sub(self: Self, o: Self): Self { return self - o; } }
impl Mul for u64 { function mul(self: Self, o: Self): Self { return self * o; } }
impl Div for u64 { function div(self: Self, o: Self): Self { return self / o; } }
impl Zero for u64 { function zero(): Self { return 0; } }
impl One for u64 { function one(): Self { return 1; } }
impl Num for u64 {}

// ---- generic numeric reducers ------------------------------------------------
//
// One implementation, every width — the #2706 payoff: a `[T: Add]` / `[T: Mul]`
// bound collapses the width-suffixed `sum_i64` / `product_u32` / … zoo into a
// single generic body that dispatches `.add` / `.mul` by method. They work for
// the primitive impls above AND for any user type that `impl`s the trait (a 2D
// vector, a money type, …) — `sum_with(vectors, V2 { x: 0, y: 0 })` folds with
// the user's `Add`. The accumulator's bounded-generic method call monomorphises
// to a direct call, so these lower on the self-host IR path too (#2691 / #3558).
//
// The identity (`zero` for `sum_with`, `one` for `product_with`) is passed
// explicitly rather than recovered from the `Zero` / `One` trait. `T.zero()` /
// `T.one()` on a bound type parameter now DO lower on the self-host IR path —
// the monomorphiser emits the numeric identity literal directly for a primitive
// `T` (mirroring `T.default()`), so a bare `sum[T: Add + Zero](xs): T` form
// lowers on every backend. The explicit-identity API is kept regardless: it
// works for a user `Add`/`Mul` type that has no `Zero`/`One` impl, and lets a
// caller choose the seed (e.g. `0.0` vs a trait-fixed value) at the call site.

// sum_with folds `xs` left with `.add`, starting from `zero`: the generic
// element-wise total. Empty `xs` returns `zero` unchanged.
pub function sum_with[T: Add](xs: T[], zero: T): T {
    var acc = zero;
    for x in xs { acc = acc.add(x); }
    return acc;
}

// product_with folds `xs` left with `.mul`, starting from `one`: the generic
// element-wise product. Empty `xs` returns `one` unchanged.
pub function product_with[T: Mul](xs: T[], one: T): T {
    var acc = one;
    for x in xs { acc = acc.mul(x); }
    return acc;
}

// sum / product are the implicit-identity forms — `sum_with` / `product_with`
// without the explicit seed, recovering it from the `Zero` / `One` trait
// (`T.zero()` / `T.one()`). Enabled now that an associated-function call on a
// bound type parameter lowers on the self-host IR path (#3749), so the bare
// `sum[T: Add + Zero](xs): T` the explicit forms' note once deferred now works
// on every backend. Bound on `Add + Zero` / `Mul + One`: usable for the
// primitive numerics and any user type that impls BOTH the operator and the
// identity. (A user `Add` type with no `Zero` impl still has `sum_with`.)

// sum totals `xs` from the additive identity; empty `xs` returns `T.zero()`.
pub function sum[T: Add + Zero](xs: T[]): T {
    var acc: T = T.zero();
    for x in xs { acc = acc.add(x); }
    return acc;
}

// product multiplies `xs` from the multiplicative identity; empty `xs` returns
// `T.one()`.
pub function product[T: Mul + One](xs: T[]): T {
    var acc: T = T.one();
    for x in xs { acc = acc.mul(x); }
    return acc;
}

// `cumsum(xs)` — the running (prefix) sums: `out[i]` is the sum of
// `xs[0..=i]`, so `cumsum([1,2,3,4])` is `[1,3,6,10]`. The closure-free
// specialisation of `scan(+)` — the cumulative sibling of `sum`. Empty in,
// empty out. Same `Add + Zero` bound, so it works for every numeric width.
pub function cumsum[T: Add + Zero](xs: T[]): T[] {
    var out: T[] = [];
    var run: T = T.zero();
    for x in xs { run = run.add(x); out = out.append(run); }
    return out;
}

// `cumproduct(xs)` — the running products: `out[i]` is the product of
// `xs[0..=i]` (`cumproduct([1,2,3,4])` is `[1,2,6,24]`). The cumulative
// sibling of `product`; same `Mul + One` bound.
pub function cumproduct[T: Mul + One](xs: T[]): T[] {
    var out: T[] = [];
    var run: T = T.one();
    for x in xs { run = run.mul(x); out = out.append(run); }
    return out;
}

// ---- iterator forms ----------------------------------------------------------
//
// The Iterator counterparts of sum_with / product_with — they fold any
// `iter.Iterator[T]` directly, without first collecting it into an array, so a
// numeric pipeline composes end to end:
//   num.sum_iter(iter.of(xs), 0)
//   num.sum_iter(iter.filter(iter.of(xs), keep_positive), 0)
// `T` appears only inside the iterator bound (`I: iter.Iterator[T]`); it is
// recovered by bound-driven inference once `I` is pinned by the argument
// (#2691). The identity is passed explicitly so these stay usable for a user
// `Add`/`Mul` type that has no `Zero`/`One` impl, and so a caller can choose
// the seed (e.g. `0.0`); the implicit-identity array forms `sum` / `product`
// above cover the `T: Add + Zero` case. The accumulator's `.add` / `.mul`
// monomorphises to a direct call, so these lower on the self-host IR path like
// core/iter's other bounded collectors (#2691 / #3558).

// sum_iter totals every value an iterator yields, starting from `zero`
// (returned unchanged for an empty iterator).
pub function sum_iter[T: Add, I: iter.Iterator[T]](it: I, zero: T): T {
    var acc = zero;
    var cur = it;
    var go = true;
    while (go) {
        match (cur.next()) {
            Some(t) => { acc = acc.add(t.0); cur = t.1; },
            None => { go = false; },
        }
    }
    return acc;
}

// product_iter multiplies every value an iterator yields, starting from `one`
// (returned unchanged for an empty iterator).
pub function product_iter[T: Mul, I: iter.Iterator[T]](it: I, one: T): T {
    var acc = one;
    var cur = it;
    var go = true;
    while (go) {
        match (cur.next()) {
            Some(t) => { acc = acc.mul(t.0); cur = t.1; },
            None => { go = false; },
        }
    }
    return acc;
}
