// std/async — structured-concurrency combinators over `Future[T]`.
//
// This is the SUPPORTED async surface (docs/ASYNC-REDESIGN.md). It
// replaces the `concurrent { … }` / `await` / `race` keyword surface
// (a parser-side CPS transform) with plain library functions over one
// abstraction — a `Future[T]`, a not-yet-ready value of type `T`. The
// concurrency points are explicit (you call `gather` / `race`), the
// model is colorless (no function coloring, no compiler transform),
// and it has a real wasm path (it drives the universal `poll`
// builtin, not stackful green threads).
//
// PORTABILITY: every combinator compiles and runs on all backends.
//   * `Ready(v)` futures resolve immediately everywhere — so a fan-out
//     of ready futures (the unit-test shape) works on interp / wasm /
//     native alike.
//   * `Pending(fd, resume)` futures resolve when `fd` is readable,
//     driven by the `poll` builtin: poll(2) / ppoll(2) on native, a set
//     over the handles' descriptors on the interpreter, wasi:io/poll on
//     wasm (component-model-async via `@import async` is folded in later —
//     docs/ASYNC-REDESIGN.md PR5).
//
// Generic over `T`: the native compiler monomorphizes, so
// `gather` over `Future[string]` (response bodies) is a first-class
// case, not a hand-duplicated `…Str` twin. This is the shape that
// drops the i32-throughout restriction of the old `std/task` runtime.

import "core/int";
import "std/string";
import "std/time";

// A pending computation yielding a value of type `T`.
//
//   Ready(value)         — already resolved with this value.
//   Pending(fd, resume)  — suspended until `fd` is readable; the
//                          driver calls `resume(fd)` to get the next
//                          Future (typically a non-blocking read that
//                          returns `Ready(...)`). Multi-step I/O
//                          chains by returning another `Pending`.
//
// A combinator that abandons a pending future (a `race` loser, a
// `with_deadline` straggler, what `gather` holds when its wait fails) drops
// its token and then calls `resume(cancelled())` once: a continuation handed
// `cancelled()` releases what it holds, a socket above all, and returns
// `Ready` without waiting. A wait there could rewind a task into the
// cancellation and run its release twice, and a close is not idempotent.
pub enum Future[T] {
  Ready(T),
  Pending(i32, (i32) => Future[T]),
}

// Driver — the waiting seam (docs/DST-PLATFORM-BRIEF.md). Everything
// nondeterministic the combinators and the serve loop do funnels through
// these primitives; substituting them (std/sim) makes gather / race /
// with_deadline and a reactor loop fully deterministic on every backend,
// including the interpreter.
//
// The first four are the one-shot waits: `poll_ready(toks, timeout_ms)`
// returns the index of the first ready token, a hung-up or failed one
// included, or -1 when none became ready, the contract of the `poll`
// builtin.
//
// The rest are the reactor (#9853): a readiness set that outlives one
// wait. `watch(fd, interest)` registers a descriptor for the interest bits
// (1 readable, 2 writable; 4 exclusive, so that of several processes
// watching one descriptor a readiness wakes one rather than all, epoll's
// EPOLLEXCLUSIVE, and nothing elsewhere) or changes them, `unwatch(fd)`
// drops it, and
// `wait(max, timeout_ms)` is the (fd, readiness) pairs of up to `max`
// ready descriptors, readiness 1 readable, 2 writable and 4 an error or
// hang-up: empty on the timeout (-1 waits without one) and on an error.
// `wait_into(events, timeout_ms)` is the same wait written into an array the
// caller keeps, so a loop that waits again and again allocates nothing: the
// pairs fill `events` from the start, as many as it has room for, and when
// fewer arrive the pair after the last has readiness -1 (`ready_pairs`
// counts them). `wait` is `wait_into` over a fresh array. A
// host may report readiness spuriously, so a reader reads until -EAGAIN;
// a descriptor is unwatched before it is closed. `watch_signal(sig)` makes
// a signal a readiness event, reported as the pair (-sig, 1) and no longer
// ending the process (signalfd behind a blocked signal on Linux, kqueue's
// EVFILT_SIGNAL behind an ignored one on Darwin; -ENOTSUP on wasm, which
// has no signals), and `unwatch_signal(sig)` restores its default.
// `watch_parent()` reports the exit of the process's parent the way a
// watched SIGTERM is reported, as (-15, 1): -ESRCH when the parent is
// already gone, -ENOTSUP on wasm. Linux delivers it as SIGTERM
// (PR_SET_PDEATHSIG), Darwin as kqueue's EVFILT_PROC. A parent that dies
// before the call is caught by finding the process reparented to init, so a
// subreaper other than init hides that early death on Linux.
// `close()` releases the set.
pub trait Driver {
  function poll_ready(self: Self, toks: i32[], timeout_ms: i32): i32;
  function now_ns(self: Self): i64;
  function timer(self: Self, ns: i64): i32;
  function drop_token(self: Self, tok: i32): i32;
  function watch(self: Self, fd: i32, interest: i32): i32;
  function unwatch(self: Self, fd: i32): i32;
  function wait_into(self: Self, own events: i32[], timeout_ms: i32): i32[];
  function wait(self: Self, max: i32, timeout_ms: i32): i32[] {
    let got: i32[] = self.wait_into(event_room(max), timeout_ms);
    return got.take(ready_pairs(got) * 2);
  }
  function watch_signal(self: Self, sig: i32): i32;
  function unwatch_signal(self: Self, sig: i32): i32;
  function watch_parent(self: Self): i32;
  function close(self: Self): i32;
}

// event_room(max) — an events array for `wait_into` with room for `max`
// pairs and none in it yet.
pub function event_room(max: i32): i32[] {
  let events: i32[] = [];
  while (events.len() < max * 2) {
    events = events.append(0);
  }
  return end_pairs(events, 0);
}

// ready_pairs(events) — how many (fd, readiness) pairs `wait_into` left at
// the start of `events`.
pub function ready_pairs(events: i32[]): i32 {
  let n: i32 = 0;
  while (n * 2 + 1 < events.len() && events[n * 2 + 1] >= 0) {
    n = n + 1;
  }
  return n;
}

// end_pairs(events, n) — `events` with its pairs ending after the first `n`.
pub function end_pairs(own events: i32[], n: i32): i32[] {
  if (n * 2 + 1 < events.len()) {
    return events.with(n * 2 + 1, -1);
  }
  return events;
}

// RealDriver — the production Driver: each wait is exactly the builtin
// the combinator loops used to call directly (poll(2) / ppoll(2) on
// native, wasi:io/poll on wasm, a set over the handles on interp), and the reactor
// is the `reactor_*` floor (epoll, kqueue, a table of wasi pollables),
// made on the first watch so a driver that only polls costs nothing.
// `signals` is the watched signals as rows `sig:descriptor;`, the
// descriptor being what the floor answered for the watch and wants back
// for the unwatch.
pub struct RealDriver { reactor: Cell[i32], signals: Cell[string] }

// __eintr() — the errno a wait a signal interrupted fails with.
function __eintr(): i32 {
  if (target_os() == "wasi") {
    return 27;
  }
  return 4;
}

// real_driver() — the Driver the public combinators run on.
pub function real_driver(): RealDriver {
  return RealDriver { reactor: cell_new(-1), signals: cell_new("") };
}

// The descriptor a watched signal's row holds, -1 when it is not watched.
function __real_signal_fd(d: RealDriver, sig: i32): i32 {
  for row in d.signals.get().split(";") {
    let parts: string[] = row.split(":");
    if (parts.len() == 2 && parts[0] == int.int_to_string(sig)) {
      match (int.parse_int_radix(parts[1], 10)) {
        Some(v) => {
          return v;
        },
        None => {
          return -1;
        }
      }
    }
  }
  return -1;
}

function __real_reactor(d: RealDriver): i32 {
  let r: i32 = d.reactor.get();
  if (r >= 0) {
    return r;
  }
  r = reactor_new();
  if (r >= 0) {
    d.reactor.set(r);
  }
  return r;
}

// `.handle()` — the driver's reactor as the opaque handle a `platform.Host`
// carries (`handle`), made on first use like `watch` makes it; negative
// when the target has no reactor.
pub function (d: RealDriver) handle(): i32 {
  return __real_reactor(d);
}

impl Driver for RealDriver {
  // Under a task the wait parks on the tokens, so gather / race /
  // with_deadline inside a handler park the handler (§8 of ASYNC.md).
  function poll_ready(self: RealDriver, toks: i32[], timeout_ms: i32): i32 {
    if (__task_cur() != 0) {
      return park_tokens(toks, timeout_ms);
    }
    return poll(toks, timeout_ms);
  }
  function now_ns(self: RealDriver): i64 {
    return monotonic_ns();
  }
  function timer(self: RealDriver, ns: i64): i32 {
    return wasm_timer_pollable(ns);
  }
  function drop_token(self: RealDriver, tok: i32): i32 {
    return wasm_pollable_drop(tok);
  }
  function watch(self: RealDriver, fd: i32, interest: i32): i32 {
    let r: i32 = __real_reactor(self);
    if (r < 0) {
      return r;
    }
    return reactor_ctl(r, 1, fd, interest);
  }
  function unwatch(self: RealDriver, fd: i32): i32 {
    let r: i32 = self.reactor.get();
    if (r < 0) {
      return 0;
    }
    return reactor_ctl(r, 2, fd, 0);
  }
  function wait_into(self: RealDriver, own events: i32[], timeout_ms: i32): i32[] {
    let r: i32 = __real_reactor(self);
    if (r < 0 || events.len() < 2) {
      return end_pairs(events, 0);
    }
    // A wait a signal interrupted is waited again for what is left of the
    // timeout: epoll_wait fails with EINTR after a stop and continue even
    // with no handler installed.
    let deadline: i64 = monotonic_ns() + timeout_ms as i64 * (1000000 as i64);
    let n: i32 = reactor_wait(r, events, timeout_ms);
    while (n == 0 - __eintr()) {
      let wait_ms: i32 = timeout_ms;
      if (timeout_ms >= 0) {
        let ns: i64 = deadline - monotonic_ns();
        if (ns <= 0 as i64) {
          return end_pairs(events, 0);
        }
        wait_ms = ((ns + 999999 as i64) / (1000000 as i64)) as i32;
      }
      n = reactor_wait(r, events, wait_ms);
    }
    if (n <= 0) {
      return end_pairs(events, 0);
    }
    return end_pairs(events, n);
  }
  function watch_signal(self: RealDriver, sig: i32): i32 {
    if (__real_signal_fd(self, sig) >= 0) {
      return 0;
    }
    let r: i32 = __real_reactor(self);
    if (r < 0) {
      return r;
    }
    let sfd: i32 = reactor_ctl(r, 4, sig, 0);
    if (sfd < 0) {
      return sfd;
    }
    self.signals.set(self.signals.get() + int.int_to_string(sig) + ":" + int.int_to_string(sfd) + ";");
    return 0;
  }
  function unwatch_signal(self: RealDriver, sig: i32): i32 {
    let sfd: i32 = __real_signal_fd(self, sig);
    if (sfd < 0) {
      return 0;
    }
    let kept: string = "";
    for row in self.signals.get().split(";") {
      if (row.len() > 0 && !row.starts_with(int.int_to_string(sig) + ":")) {
        kept = kept + row + ";";
      }
    }
    self.signals.set(kept);
    return reactor_ctl(self.reactor.get(), 5, sig, sfd);
  }
  function watch_parent(self: RealDriver): i32 {
    let watched: i32 = self.watch_signal(15);
    if (watched < 0) {
      return watched;
    }
    return reactor_ctl(__real_reactor(self), 6, 0, 0);
  }
  function close(self: RealDriver): i32 {
    let r: i32 = self.reactor.get();
    if (r < 0) {
      return 0;
    }
    self.reactor.set(-1);
    self.signals.set("");
    return reactor_ctl(r, 3, 0, 0);
  }
}

// __all_ready(fs) — true once no future is still pending.
function __all_ready[T](fs: Future[T][]): boolean {
  let i: i32 = 0;
  while (i < fs.len()) {
    match (fs[i]) {
      Ready(v) => {},
      Pending(fd, c) => {
        return false;
      }
    }
    i = i + 1;
  }
  return true;
}

// gather(fs, on_incomplete) — await ALL futures, returning their
// values in input order. The canonical edge fan-out: issue N outbound
// fetches, take every result (cache + primary). All pending futures'
// fds are in flight simultaneously, so their I/O overlaps on one
// thread. A future that never resolves (a poll error) is cancelled and lands
// `on_incomplete` in its slot — generic `T` has no default,
// so the caller supplies the fallback (matching the realities of a
// blocking poll, which otherwise always makes progress).
pub function gather[T](fs_in: Future[T][], on_incomplete: T): T[] {
  return gather_on(real_driver(), fs_in, on_incomplete);
}

// gather_on(drv, fs, on_incomplete) — gather with the waits routed
// through an explicit Driver (std/sim substitutes a virtual one).
pub function gather_on[D: Driver, T](drv: D, fs_in: Future[T][], on_incomplete: T): T[] {
  let fs: Future[T][] = fs_in;
  while (true) {
    if (__all_ready(fs)) {
      break;
    }
    let fds: i32[] = [];
    let idxs: i32[] = [];
    let i: i32 = 0;
    while (i < fs.len()) {
      match (fs[i]) {
        Ready(v) => {},
        Pending(fd, c) => {
          fds = fds.append(fd);
          idxs = idxs.append(i);
        }
      }
      i = i + 1;
    }
    let ready: i32 = drv.poll_ready(fds, -1);
    if (ready < 0) {
      let dl: i32 = __drop_losers(drv, fs, -1);
      break;
    }
    let ti: i32 = idxs[ready];
    match (fs[ti]) {
      Ready(v) => {},
      Pending(fd, resume) => {
        fs = fs.with(ti, resume(fd));
      }
    }
  }
  let out: T[] = [];
  let k: i32 = 0;
  while (k < fs.len()) {
    match (fs[k]) {
      Ready(v) => {
        out = out.append(v);
      },
      Pending(fd, c) => {
        out = out.append(on_incomplete);
      }
    }
    k = k + 1;
  }
  return out;
}

// __drop_losers(fs, winner) — cancel every still-Pending future EXCEPT
// `winner` (whose own continuation already consumed its token). Its token is
// dropped first: on wasm a Pending's token is a wasi:io/poll pollable that is
// a CHILD of its socket, and wasmtime traps with "resource has children" at
// teardown if the socket goes first. `wasm_pollable_drop` is a no-op on
// native/interp. Then `resume(cancelled())` runs once, so the continuation
// closes what it holds, and the token of a Pending it hands back is dropped
// too. Pass `winner = -1` to cancel every Pending future.
function __drop_losers[D: Driver, T](drv: D, fs: Future[T][], winner: i32): i32 {
  let i: i32 = 0;
  while (i < fs.len()) {
    if (i != winner) {
      match (fs[i]) {
        Ready(v) => {},
        Pending(tok, c) => {
          let d: i32 = drv.drop_token(tok);
          match (c(cancelled())) {
            Ready(v) => {},
            Pending(rest, rc) => {
              let dr: i32 = drv.drop_token(rest);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return 0;
}

// race(fs, none_val) — await the FIRST future to resolve, returning
// `(winnerIndex, value)`. Happy-eyeballs: fan out to N upstreams, take
// the fastest answer, abandon the rest. The losers are cancelled
// (`__drop_losers`): each token is dropped, so wasm doesn't trap on an
// abandoned pollable, and each continuation is resumed with `cancelled()`
// so it closes its socket. An already-`Ready` future wins
// immediately (lowest index). Returns `(-1, none_val)` only if no future
// can make progress (poll error / no pending fds).
pub function race[T](fs_in: Future[T][], none_val: T): (i32, T) {
  return race_on(real_driver(), fs_in, none_val);
}

// race_on(drv, fs, none_val) — race with the waits routed through an
// explicit Driver (std/sim substitutes a virtual one).
pub function race_on[D: Driver, T](drv: D, fs_in: Future[T][], none_val: T): (i32, T) {
  let fs: Future[T][] = fs_in;
  let j: i32 = 0;
  while (j < fs.len()) {
    match (fs[j]) {
      Ready(v) => {
        let d0: i32 = __drop_losers(drv, fs, j);
        return (j, v);
      },
      Pending(fd, c) => {}
    }
    j = j + 1;
  }
  while (true) {
    let fds: i32[] = [];
    let idxs: i32[] = [];
    let i: i32 = 0;
    while (i < fs.len()) {
      match (fs[i]) {
        Ready(v) => {},
        Pending(fd, c) => {
          fds = fds.append(fd);
          idxs = idxs.append(i);
        }
      }
      i = i + 1;
    }
    if (fds.len() == 0) {
      return (-1, none_val);
    }
    let ready: i32 = drv.poll_ready(fds, -1);
    if (ready < 0) {
      let de: i32 = __drop_losers(drv, fs, -1);
      return (-1, none_val);
    }
    let ti: i32 = idxs[ready];
    match (fs[ti]) {
      Ready(v) => {
        return (ti, v);
      },
      Pending(fd, resume) => {
        let nx: Future[T] = resume(fd);
        match (nx) {
          Ready(v) => {
            let dw: i32 = __drop_losers(drv, fs, ti);
            return (ti, v);
          },
          Pending(nfd, nc) => {
            fs = fs.with(ti, nx);
          }
        }
      }
    }
  }
  return (-1, none_val);
}

// with_deadline(deadline, fs) — await ALL futures, but bound the whole
// fan-out by `deadline` of wall-clock time, returning an `Option[T]` per future:
// `Some(value)` for one that resolved in time, `None` for one abandoned
// at the deadline. (None — rather than a caller-supplied sentinel —
// because a timed-out slot must be distinguishable from a real result
// that happens to equal the sentinel, e.g. an empty body.) This is
// happy-eyeballs with an SLA: fan out to
// N upstreams, take whatever answers in time, cancel the rest.
pub function with_deadline[T](deadline: Duration, fs_in: Future[T][]): Option[T][] {
  return with_deadline_on(real_driver(), deadline, fs_in);
}

// with_deadline_on(drv, deadline, fs) — with_deadline with the clock and
// the waits routed through an explicit Driver (std/sim substitutes a
// virtual one, making the deadline exact instead of wall-clock).
pub function with_deadline_on[D: Driver, T](drv: D, deadline: Duration, fs_in: Future[T][]): Option[T][] {
  let fs: Future[T][] = fs_in;
  let start_ns: i64 = drv.now_ns();
  let ns_per_ms: i64 = 1000000;
  let deadline_ns: i64 = deadline.as_nanos();
  while (true) {
    if (__all_ready(fs)) {
      break;
    }
    let fds: i32[] = [];
    let idxs: i32[] = [];
    let i: i32 = 0;
    while (i < fs.len()) {
      match (fs[i]) {
        Ready(v) => {},
        Pending(fd, c) => {
          fds = fds.append(fd);
          idxs = idxs.append(i);
        }
      }
      i = i + 1;
    }
    let remaining_ns: i64 = deadline_ns - (drv.now_ns() - start_ns);
    if (remaining_ns <= 0) {
      break;
    }
    let remaining_ms: i32 = (remaining_ns / ns_per_ms) as i32;
    if (remaining_ms <= 0) {
      remaining_ms = 1;
    }
    // Bound the wait on EVERY backend: native poll(2) honors `remaining_ms`
    // and the appended timer is -1 (ignored); wasm `poll` ignores its
    // timeout arg, so the real timer pollable in the set is what fires at
    // the deadline. A `ready` of `nfds` (the timer's slot) = deadline hit.
    // wasm_timer_pollable is -1 on native/interp, which poll skips.
    let nfds: i32 = fds.len();
    let timer: i32 = drv.timer(remaining_ns);
    let pollset: i32[] = fds.append(timer);
    let ready: i32 = drv.poll_ready(pollset, remaining_ms);
    if (ready < 0) {
      let dpe: i32 = drv.drop_token(timer);
      break;
    }
    if (ready == nfds) {
      let dpt: i32 = drv.drop_token(timer);
      break;
    }
    let dpr: i32 = drv.drop_token(timer);
    let ti: i32 = idxs[ready];
    match (fs[ti]) {
      Ready(v) => {},
      Pending(fd, resume) => {
        fs = fs.with(ti, resume(fd));
      }
    }
  }
  // Cancel every future that timed out (still Pending).
  let dd: i32 = __drop_losers(drv, fs, -1);
  // Some(v) for a future that resolved in time; None for one that timed out
  // (no sentinel ambiguity — an empty/zero result is distinct from absent).
  let out: Option[T][] = [];
  let k: i32 = 0;
  while (k < fs.len()) {
    match (fs[k]) {
      Ready(v) => {
        out = out.append(Some(v));
      },
      Pending(fd, c) => {
        out = out.append(None);
      }
    }
    k = k + 1;
  }
  return out;
}

// Tasks (docs/NET-P3-SUSPENSION-PLAN.md §3.4). A Task runs an entry under a
// scheduler: `task_start` runs it until it returns or parks on a wait,
// `task_resume` runs a parked task on from its park with the word the
// scheduler read, and `task_cancel` runs it on with every later wait
// answering `cancelled()`. A function reaches the park through `wait_any`,
// which blocks instead when no task is current, so the same code runs under
// a scheduler and in a plain program. The self-host compiler lowers the
// functions that reach a park to resumable form; the native compiler keeps
// the blocking fallback, where a task always runs to completion.
pub enum TaskStatus[T] { Done(T), Suspended(Wait), Cancelled }

// `Wait` — what a parked task waits for, as its scheduler reads it: the
// (fd, interest) pairs of `wait_any`'s set, and the milliseconds it gave
// (-1 for no bound). The scheduler watches each pair and resumes the task
// with the index of the pair that became ready, or -1 at the timeout.
pub struct Wait { set: i32[], timeout_ms: i32 }

pub struct Task[T] { id: i32, entry: () => T }

// `cancelled()` — what `suspend` answers in a cancelled task, on every wait
// from the cancellation on.
pub function cancelled(): i32 {
  return 0 - 2;
}

pub function task_new[T](entry: () => T): Task[T] {
  return Task { id: __task_new(), entry: entry };
}

pub function task_start[T](t: Task[T]): TaskStatus[T] {
  return run_task(t, 0);
}

// `task_resume(t, ready)` — the parked task runs on, its `suspend`
// answering `ready`.
pub function task_resume[T](t: Task[T], ready: i32): TaskStatus[T] {
  __task_set_ready(t.id, ready);
  return run_task(t, 2);
}

// `task_cancel(t)` — the parked task runs on to its end with every wait
// answering `cancelled()`, and cannot park again.
pub function task_cancel[T](t: Task[T]): TaskStatus[T] {
  __task_set_cancelled(t.id);
  let st: TaskStatus[T] = run_task(t, 2);
  return Cancelled;
}

// `task_free(t)` — hand the task's record back once it is done.
pub function task_free[T](t: Task[T]): void {
  __task_free(t.id);
}

function run_task[T](t: Task[T], mode: i32): TaskStatus[T] {
  __task_enter(t.id, mode);
  let v: T = t.entry();
  let m: i32 = __task_leave();
  if (m == 1) {
    return Suspended(Wait { set: __task_wait(t.id), timeout_ms: __task_timeout(t.id) });
  }
  return Done(v);
}

// park_tokens(toks, timeout_ms) — a driver's `poll_ready` under a task:
// parks on every token that is a descriptor, readable, and maps the answer
// back to the token's index; a token of -1 (the native timer slot) has no
// pair. The answer is `cancelled()` in a cancelled task.
pub function park_tokens(toks: i32[], timeout_ms: i32): i32 {
  let set: i32[] = [];
  let idxs: i32[] = [];
  let i: i32 = 0;
  while (i < toks.len()) {
    if (toks[i] >= 0) {
      set = set.append(toks[i]);
      set = set.append(1);
      idxs = idxs.append(i);
    }
    i = i + 1;
  }
  // poll_ready calls this only with a current task. Park directly: the
  // blocking wait_any fallback would also pull native reactors into wasm.
  let r: i32 = __task_park(set, timeout_ms);
  if (r < 0) {
    return r;
  }
  return idxs[r];
}

// ---- Task combinators ------------------------------------------------
//
// `gather_tasks`, `race_tasks` and `with_deadline_tasks` run their entries
// as tasks and drive them together: a child that parks hands back its wait,
// the combinator parks on the union of the children's waits, and resumes
// the child whose pair became ready, or every child whose bound passed. A
// child the combinator is finished with while it is still parked is
// cancelled, not abandoned: `task_cancel` runs it on with every wait
// answering `cancelled()`, so it leaves through its own exit paths and its
// `defer`s. The calling task being cancelled cancels every child the same
// way. With no task current the combinator's own wait blocks, and under
// the blocking fallback each entry runs to its end inside `task_start`, so
// the entries run one after another in order.

// A child of a combinator: its task, where it stands, and when its wait is
// due as monotonic nanoseconds, `__no_due()` with no bound.
struct __Child[T] { task: Task[T], st: TaskStatus[T], due: i64 }

function __no_due(): i64 {
  let g: i64 = 1000000000 as i64;
  return g * g * 9;
}

function __child_due[T](st: TaskStatus[T], now: i64): i64 {
  match (st) {
    Suspended(w) => {
      if (w.timeout_ms < 0) {
        return __no_due();
      }
      return now + w.timeout_ms as i64 * (1000000 as i64);
    },
    Done(v) => {
      return __no_due();
    },
    Cancelled => {
      return __no_due();
    }
  }
}

function __children_start[T](entries: (() => T)[]): __Child[T][] {
  let kids: __Child[T][] = [];
  for e in entries {
    let t: Task[T] = task_new(e);
    let st: TaskStatus[T] = task_start(t);
    kids = kids.append(__Child { task: t, st: st, due: __child_due(st, monotonic_ns()) });
  }
  return kids;
}

function __children_parked[T](kids: __Child[T][]): boolean {
  for k in kids {
    match (k.st) {
      Suspended(w) => {
        return true;
      },
      Done(v) => {},
      Cancelled => {}
    }
  }
  return false;
}

// The lowest index of a child that is done, -1 with none.
function __children_done[T](kids: __Child[T][]): i32 {
  let i: i32 = 0;
  while (i < kids.len()) {
    let k: __Child[T] = kids[i];
    match (k.st) {
      Done(v) => {
        return i;
      },
      Suspended(w) => {},
      Cancelled => {}
    }
    i = i + 1;
  }
  return 0 - 1;
}

function __children_due[T](kids: __Child[T][]): i64 {
  let due: i64 = __no_due();
  for k in kids {
    if (k.due < due) {
      due = k.due;
    }
  }
  return due;
}

// Milliseconds from `now` to `due`, rounded up; -1 for no bound.
function __ms_until(due: i64, now: i64): i32 {
  if (due >= __no_due()) {
    return 0 - 1;
  }
  if (due <= now) {
    return 0;
  }
  let ms: i64 = (due - now + 999999 as i64) / (1000000 as i64);
  if (ms > 2147483647 as i64) {
    return 2147483647;
  }
  return ms as i32;
}

function __child_resume[T](kids: __Child[T][], i: i32, word: i32): __Child[T][] {
  let k: __Child[T] = kids[i];
  let st: TaskStatus[T] = task_resume(k.task, word);
  return kids.with(i, __Child { task: k.task, st: st, due: __child_due(st, monotonic_ns()) });
}

// Every child still parked is cancelled: it runs on to its end with its
// waits answering `cancelled()`.
function __children_cancel[T](kids: __Child[T][]): __Child[T][] {
  let out: __Child[T][] = [];
  for k in kids {
    match (k.st) {
      Suspended(w) => {
        let c: TaskStatus[T] = task_cancel(k.task);
        out = out.append(__Child { task: k.task, st: c, due: __no_due() });
      },
      Done(v) => {
        out = out.append(k);
      },
      Cancelled => {
        out = out.append(k);
      }
    }
  }
  return out;
}

function __children_free[T](kids: __Child[T][]): i32 {
  for k in kids {
    task_free(k.task);
  }
  return 0;
}

// The union of the parked children's waits as one set, with the child and
// the pair within its set that each pair of the union came from.
struct __Union { set: i32[], owner: i32[], at: i32[] }

function __children_union[T](kids: __Child[T][]): __Union {
  let u: __Union = __Union { set: [], owner: [], at: [] };
  let i: i32 = 0;
  while (i < kids.len()) {
    let k: __Child[T] = kids[i];
    match (k.st) {
      Suspended(w) => {
        let j: i32 = 0;
        while (j + 1 < w.set.len()) {
          u = __Union { set: u.set.append(w.set[j]).append(w.set[j + 1]), owner: u.owner.append(i), at: u.at.append(j / 2) };
          j = j + 2;
        }
      },
      Done(v) => {},
      Cancelled => {}
    }
    i = i + 1;
  }
  return u;
}

// Every child whose bound has passed runs on with -1, the timeout answer.
function __children_expire[T](kids_in: __Child[T][], now: i64): __Child[T][] {
  let kids: __Child[T][] = kids_in;
  let i: i32 = 0;
  while (i < kids.len()) {
    if (kids[i].due <= now) {
      kids = __child_resume(kids, i, 0 - 1);
    }
    i = i + 1;
  }
  return kids;
}

// __children_drive(kids, until_ns, first) runs the children on until none
// is parked, until one is done when `first`, or until `until_ns`
// (monotonic, `__no_due()` for none) passes; the children still parked at
// that point, or when the calling task is cancelled, are cancelled.
function __children_drive[T](kids_in: __Child[T][], until_ns: i64, first: boolean): __Child[T][] {
  let kids: __Child[T][] = kids_in;
  while (__children_parked(kids) && !(first && __children_done(kids) >= 0)) {
    let now: i64 = monotonic_ns();
    let due: i64 = __children_due(kids);
    if (due > until_ns) {
      due = until_ns;
    }
    let u: __Union = __children_union(kids);
    let woke: i32 = wait_any(u.set, __ms_until(due, now));
    if (woke == cancelled()) {
      return __children_cancel(kids);
    }
    if (woke >= 0) {
      kids = __child_resume(kids, u.owner[woke], u.at[woke]);
    } else {
      now = monotonic_ns();
      if (now >= until_ns) {
        return __children_cancel(kids);
      }
      kids = __children_expire(kids, now);
    }
  }
  return kids;
}

// `gather_tasks(entries, on_incomplete)` — run every entry as a task and
// answer their results in input order; a child that could not finish (the
// calling task was cancelled) lands `on_incomplete` in its slot.
pub function gather_tasks[T](entries: (() => T)[], on_incomplete: T): T[] {
  let kids: __Child[T][] = __children_drive(__children_start(entries), __no_due(), false);
  let out: T[] = [];
  for k in kids {
    match (k.st) {
      Done(v) => {
        out = out.append(v);
      },
      Suspended(w) => {
        out = out.append(on_incomplete);
      },
      Cancelled => {
        out = out.append(on_incomplete);
      }
    }
  }
  let f: i32 = __children_free(kids);
  return out;
}

// `race_tasks(entries, none_val)` — run every entry as a task and answer
// `(index, value)` of the first to finish; the rest are cancelled. Answers
// `(-1, none_val)` when none finishes (the calling task was cancelled).
pub function race_tasks[T](entries: (() => T)[], none_val: T): (i32, T) {
  let kids: __Child[T][] = __children_drive(__children_start(entries), __no_due(), true);
  let won: i32 = __children_done(kids);
  let v: T = none_val;
  if (won >= 0) {
    let k: __Child[T] = kids[won];
    match (k.st) {
      Done(x) => {
        v = x;
      },
      Suspended(w) => {},
      Cancelled => {}
    }
  }
  let f: i32 = __children_free(__children_cancel(kids));
  return (won, v);
}

// `with_deadline_tasks(deadline, entries)` — run every entry as a task and
// answer `Some(value)` for each that finishes inside `deadline`, `None` for
// each cancelled at it.
pub function with_deadline_tasks[T](deadline: Duration, entries: (() => T)[]): Option[T][] {
  let kids: __Child[T][] = __children_drive(__children_start(entries), monotonic_ns() + deadline.as_nanos(), false);
  let out: Option[T][] = [];
  for k in kids {
    match (k.st) {
      Done(v) => {
        out = out.append(Some(v));
      },
      Suspended(w) => {
        out = out.append(None);
      },
      Cancelled => {
        out = out.append(None);
      }
    }
  }
  let f: i32 = __children_free(kids);
  return out;
}

// `wait_any(set, timeout_ms)` — wait for any of the (fd, interest) pairs in
// `set`, interest 1 readable and 2 writable as `Driver.wait` reports them:
// the index of the first pair that became ready, -1 once `timeout_ms`
// passed (-1 waits without a bound), and `cancelled()` in a cancelled
// task. Under a scheduler the task parks and the scheduler's word is the
// answer; with no task current the wait blocks here. On wasm an fd is a
// socket handle, subscribed for the wait.
pub function wait_any(set: i32[], timeout_ms: i32): i32 {
  if (__task_cur() != 0) {
    return __task_park(set, timeout_ms);
  }
  let n: i32 = set.len() / 2;
  if (n <= 0) {
    return 0 - 1;
  }
  let reads: boolean = true;
  let i: i32 = 0;
  while (i < n) {
    if (set[i * 2 + 1] != 1) {
      reads = false;
    }
    i = i + 1;
  }
  if (reads) {
    return __wait_readable(set, n, timeout_ms);
  }
  return __wait_watched(set, n, timeout_ms);
}

// A read-only set waits in one `poll`, the socket subscriptions dropped
// after it. wasm's poll ignores its timeout, so a bound is a timer
// pollable in the set that fires at the deadline; on native and the
// interpreter that token is -1, which poll skips, and the timeout itself
// bounds the wait.
function __wait_readable(set: i32[], n: i32, timeout_ms: i32): i32 {
  let toks: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    toks = toks.append(tcp_pollable(set[i * 2]));
    i = i + 1;
  }
  let timer: i32 = 0 - 1;
  if (timeout_ms >= 0) {
    timer = wasm_timer_pollable(timeout_ms as i64 * 1000000i64);
    toks = toks.append(timer);
  }
  let ready: i32 = poll(toks, timeout_ms);
  i = 0;
  while (i < n) {
    let dropped: i32 = wasm_pollable_drop(toks[i]);
    i = i + 1;
  }
  if (timer >= 0) {
    let dtimer: i32 = wasm_pollable_drop(timer);
  }
  if (ready >= 0 && ready < n) {
    return ready;
  }
  return 0 - 1;
}

// A set with a write interest waits on a reactor made for the call, each
// pair watched with its interest and unwatched after.
function __wait_watched(set: i32[], n: i32, timeout_ms: i32): i32 {
  let drv: RealDriver = real_driver();
  let i: i32 = 0;
  while (i < n) {
    let watched: i32 = drv.watch(set[i * 2], set[i * 2 + 1]);
    i = i + 1;
  }
  let woke: i32[] = drv.wait(n, timeout_ms);
  i = 0;
  while (i < n) {
    let unwatched: i32 = drv.unwatch(set[i * 2]);
    i = i + 1;
  }
  let closed: i32 = drv.close();
  let hit: i32 = 0 - 1;
  let k: i32 = 0;
  while (k + 1 < woke.len()) {
    i = 0;
    while (i < n) {
      if (set[i * 2] == woke[k] && (hit < 0 || i < hit)) {
        hit = i;
      }
      i = i + 1;
    }
    k = k + 2;
  }
  return hit;
}
