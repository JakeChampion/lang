// std/fuzz — byte-stream fuzzing harness layered on `std/test`.
//
// A fuzz target is a function that takes a string of bytes
// (the fuzz input) and returns test.TestOutcome — same shape as
// a regular test:
//   Pass       — the input passed all the property checks
//   Fail(msg)  — a counter-example: `msg` describes the
//                violation, the runner records both the
//                message + the offending input (escaped) so
//                the failure log doubles as a reproducer.
//
// Inputs are drawn from a seed corpus the caller supplies,
// plus mutated variants of each seed (byte flip / byte
// insert / byte delete). Iteration count is fixed per call
// (`iterations` arg) — lang has no panic-recovery yet, so
// a fuzz target that genuinely crashes (out-of-bounds index,
// division by zero) aborts the whole run; that's the trade
// for not needing a coroutine / fiber primitive. Real fuzzing
// frameworks add coverage feedback (libFuzzer / AFL) — we
// don't, but the API is shaped so coverage can layer in
// later without a breaking change.
//
// Usage:
//
//   function check_no_panic(input: string): test.TestOutcome {
//       // try to parse `input`; return Fail(msg) if a property
//       // we care about doesn't hold.
//       return test.pass();
//   }
//
//   function main(): i32 {
//       var r: TestRunner = test_new("parser fuzz");
//       r = r.fuzz("parse", ["function main(): i32 { return 0; }", ""],
//                  100, check_no_panic);
//       return r.finish();
//   }
//
// `r.fuzz(name, seeds, iterations, target)` reports as one
// TAP case ("ok N - <name>" or "not ok N - <name>"). The
// counter-example input is included in the failure
// diagnostics so CI logs preserve enough state to reproduce
// locally without re-running the whole loop.

import "std/i32";
import "std/string";
import "std/array";
import "std/math";
import "std/rand";
// std/fuzz hangs fuzz()/fuzz_shrink() methods off std/test's
// TestRunner; import it so the receiver type resolves under no-prelude.
import "std/test";

// fuzz_default_iterations — used by callers that want the
// default loop count without pulling in a config constant
// per call site. Tuned to land sub-second runs on the small
// targets the migration uses; bigger property tests can pass
// a larger explicit count.
pub function fuzz_default_iterations(): i32 { return 200; }

// __fuzz_pick_seed — round-robin a seed from the corpus.
// Uses the iteration index modulo corpus length rather than
// `random_int` so every seed gets touched at least once even
// on small iteration counts. Random mutation is layered on
// top by __fuzz_mutate.
function __fuzz_pick_seed(seeds: string[], iter: i32): string {
    var n: i32 = seeds.len();
    if (n == 0) { return ""; }
    return seeds[iter % n];
}

// __fuzz_mutate — produce a mutated copy of `seed`. Eight
// strategies, sampled uniformly:
//   0 byte flip      replace seed[i] with a random byte
//   1 byte drop      concatenate seed[:i] + seed[i+1:]
//   2 byte insert    seed[:i] + random byte + seed[i:]
//   3 bit flip       toggle one bit at a random byte
//   4 byte duplicate seed[:i] + seed[i] + seed[i] + seed[i+1:]
//   5 byte zero      replace seed[i] with 0x00
//   6 byte max       replace seed[i] with 0xFF
//   7 leave unchanged (run the seed verbatim)
//
// The bit-flip / byte-zero / byte-max strategies are
// borrowed from AFL — they're useful for fishing for
// boundary-conditions bugs that random-byte flips would
// miss (e.g. parsers that special-case 0x00 or 0xFF).
//
// The "unchanged" path is important: every iteration should
// have a chance of running the seed verbatim so a buggy
// seed isn't masked by mutations.
//
// Draws come from a THREADED PCG32 state rather than the CSPRNG:
// `state` in, `(state', mutated)` out. That is what makes a fuzz run
// reproducible from its seed — and it drops the syscall count from one
// per draw (up to two per mutation) to zero.
function __fuzz_mutate(seed: string, mode: i32, state: i64): (i64, string) {
    var n: i32 = seed.len();
    // Insert is the only strategy that can grow an empty
    // seed; every other strategy needs at least one byte.
    if (n == 0 && mode != 2) { return (state, seed); }
    if (mode == 0) {
        var pi = rand.rng_below(state, n);
        var pb = rand.rng_below(pi.0, 256);
        return (pb.0, seed[0:pi.1] + (pb.1 as u8).to_ascii_string() + seed[pi.1 + 1:n]);
    }
    if (mode == 1) {
        var p1 = rand.rng_below(state, n);
        return (p1.0, seed[0:p1.1] + seed[p1.1 + 1:n]);
    }
    if (mode == 2) {
        var p2 = rand.rng_below(state, n + 1);
        var b2 = rand.rng_below(p2.0, 256);
        return (b2.0, seed[0:p2.1] + (b2.1 as u8).to_ascii_string() + seed[p2.1:n]);
    }
    if (mode == 3) {
        // bit flip — pick a byte, XOR with a single-bit mask.
        var p3 = rand.rng_below(state, n);
        var bit = rand.rng_below(p3.0, 8);
        var orig: i32 = seed[p3.1] as i32;
        var flipped: i32 = orig ^ (1 << bit.1);
        return (bit.0, seed[0:p3.1] + (flipped as u8).to_ascii_string() + seed[p3.1 + 1:n]);
    }
    if (mode == 4) {
        // byte duplicate
        var p4 = rand.rng_below(state, n);
        return (p4.0, seed[0:p4.1] + seed[p4.1:p4.1 + 1] + seed[p4.1:n]);
    }
    if (mode == 5) {
        // byte zero
        var p5 = rand.rng_below(state, n);
        return (p5.0, seed[0:p5.1] + (0 as u8).to_ascii_string() + seed[p5.1 + 1:n]);
    }
    if (mode == 6) {
        // byte max (0xFF)
        var p6 = rand.rng_below(state, n);
        return (p6.0, seed[0:p6.1] + (255 as u8).to_ascii_string() + seed[p6.1 + 1:n]);
    }
    // verbatim (mode 7 or higher)
    return (state, seed);
}

// __fuzz_mutator_count is the upper bound passed to
// `random_int` when picking a mutation strategy. Bump when
// adding new modes above; tests don't directly assert on
// the constant, but `__fuzz_mutate`'s implicit contract is
// that every mode 0..count-1 returns a valid mutation.
function __fuzz_mutator_count(): i32 { return 8; }

// __fuzz_escape — render an arbitrary byte string for the
// failure diagnostic. Non-printable bytes go to "\xNN", quote
// + backslash get escaped, everything else passes through.
// Caps output at 200 bytes with a trailing " ..." so a
// pathological input doesn't blow up the log.
function __fuzz_escape(s: string): string {
    var n: i32 = s.len();
    var cap: i32 = 200;
    var trimmed: boolean = false;
    if (n > cap) { n = cap; trimmed = true; }
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i] as i32;
        if (b == 92) {
            out = out + "\\\\";
        } else if (b == 34) {
            out = out + "\\\"";
        } else if (b == 10) {
            out = out + "\\n";
        } else if (b == 13) {
            out = out + "\\r";
        } else if (b == 9) {
            out = out + "\\t";
        } else if (b >= 32 && b < 127) {
            out = out + (b as u8).to_ascii_string();
        } else {
            out = out + "\\x" + b.to_hex().pad_start(2, "0");
        }
        i = i + 1;
    }
    if (trimmed) { out = out + " ..."; }
    return out;
}

// fuzz_run(name, seeds, iterations, target) — run the
// `target` function against `iterations` inputs drawn from
// `seeds` + mutations. Returns:
//   Pass              — every input passed
//   Fail(diagnostic)  — the first failing input, with the
//                       target's message, the escaped
//                       offending input, and the RNG SEED
//                       embedded — pass that seed to
//                       `fuzz_run_seeded` to replay the exact
//                       sequence that found it
//
// The mutation sequence comes from a seeded PCG32 (std/rand), drawn once
// from the CSPRNG per run rather than per mutation. So a run is still
// different every time, but any failure it finds is reproducible.
//
// Use through `r.fuzz(...)` rather than calling directly;
// the receiver-method form folds the result into the
// runner's TAP stream.
// The body is spelled out here rather than delegating to `fuzz_run_seeded`
// with a freshly drawn seed, which is what it obviously wants to be. That
// one-line delegation MISCOMPILES on the self-host x86-64 IR path: the
// callee ends up invoking a DIFFERENT function value than the one passed, so
// `fuzz_run(seeds, n, always_passing_target)` reported a failure raised by a
// target from an earlier call. Verified by bisection — the pre-delegation
// shape and this inlined shape both behave; tail and non-tail delegation both
// misbehave.
//
// The trigger is narrower than "forwarding a function parameter", which is
// why this is inlined rather than reported as a blanket hazard: a
// single-module forward of an i32-returning fn, of an enum-returning fn, and
// std/array's own `(xs: T[]) any(pred) { return any(xs, pred); }` receiver
// delegations all lower correctly. Something about this particular shape does
// not. Do NOT "simplify" this back into a delegation without re-running
// internal/e2e's fuzz coverage through the self-host x86-64 backend.
pub function fuzz_run(seeds: string[], iterations: i32, target: (string) => test.TestOutcome): test.TestOutcome {
    var rng_seed: i64 = (math.random_int(0 - 2000000000, 2000000000)) as i64;
    if (iterations <= 0) {
        return test.fail("fuzz_run: iterations must be > 0, got " + iterations.to_string());
    }
    if (seeds.len() == 0) {
        return test.fail("fuzz_run: at least one seed required");
    }
    var i: i32 = 0;
    while (i < seeds.len()) {
        match (target(seeds[i])) {
            Fail(msg) => {
                return test.fail("seed[" + i.to_string() + "] = \"" +
                            __fuzz_escape(seeds[i]) + "\": " + msg);
            },
            Pass => { },
        }
        i = i + 1;
    }
    var st: i64 = rand.rng_seed(rng_seed);
    var iter: i32 = 0;
    while (iter < iterations) {
        var seed: string = __fuzz_pick_seed(seeds, iter);
        var mpick = rand.rng_below(st, __fuzz_mutator_count());
        st = mpick.0;
        var mode: i32 = mpick.1;
        var mutated = __fuzz_mutate(seed, mode, st);
        st = mutated.0;
        var input: string = mutated.1;
        match (target(input)) {
            Fail(msg) => {
                return test.fail("iter " + iter.to_string() +
                            " mode " + mode.to_string() +
                            " rng_seed " + rng_seed.to_string() +
                            " input \"" + __fuzz_escape(input) + "\": " + msg);
            },
            Pass => { },
        }
        iter = iter + 1;
    }
    return test.pass();
}

// fuzz_run_seeded(seeds, iterations, rng_seed, target) — `fuzz_run` with the
// mutation sequence pinned to `rng_seed`. Equal seeds replay the identical
// sequence of inputs, so a failure `fuzz_run` reports can be reproduced
// exactly by calling this with the seed named in the diagnostic.
pub function fuzz_run_seeded(seeds: string[], iterations: i32, rng_seed: i64, target: (string) => test.TestOutcome): test.TestOutcome {
    if (iterations <= 0) {
        return test.fail("fuzz_run: iterations must be > 0, got " + iterations.to_string());
    }
    if (seeds.len() == 0) {
        return test.fail("fuzz_run: at least one seed required");
    }
    // Always run every seed verbatim first so a regression
    // in the trivial-input case isn't masked by mutation
    // randomness. Then layer the mutated iterations.
    var i: i32 = 0;
    while (i < seeds.len()) {
        match (target(seeds[i])) {
            Fail(msg) => {
                return test.fail("seed[" + i.to_string() + "] = \"" +
                            __fuzz_escape(seeds[i]) + "\": " + msg);
            },
            Pass => { },
        }
        i = i + 1;
    }
    // Mutation pass, over a threaded PCG32 state seeded from `rng_seed`.
    var st: i64 = rand.rng_seed(rng_seed);
    var iter: i32 = 0;
    while (iter < iterations) {
        var seed: string = __fuzz_pick_seed(seeds, iter);
        var mpick = rand.rng_below(st, __fuzz_mutator_count());
        st = mpick.0;
        var mode: i32 = mpick.1;
        var mutated = __fuzz_mutate(seed, mode, st);
        st = mutated.0;
        var input: string = mutated.1;
        match (target(input)) {
            Fail(msg) => {
                // The rng seed is in the diagnostic on purpose: it is what
                // makes the failure replayable via fuzz_run_seeded.
                return test.fail("iter " + iter.to_string() +
                            " mode " + mode.to_string() +
                            " rng_seed " + rng_seed.to_string() +
                            " input \"" + __fuzz_escape(input) + "\": " + msg);
            },
            Pass => { },
        }
        iter = iter + 1;
    }
    return test.pass();
}

// (r) fuzz(name, seeds, iterations, target) — run a fuzz
// target and report its outcome as a single TAP case.
// Pass at most one fuzz target per `it`-equivalent line so
// the failure attribution stays clean.
pub function (r: test.TestRunner) fuzz(name: string, seeds: string[], iterations: i32, target: (string) => test.TestOutcome): test.TestRunner {
    return r.it(name, () => fuzz_run(seeds, iterations, target));
}

// =================== SHRINKING ===================
//
// When a fuzz target finds a failing input, the raw bytes
// are often much larger than the property's actual trigger.
// Shrinking (a.k.a. delta debugging / minimisation) walks
// the input looking for a smaller variant that still trips
// the same property, so the failure log is a *minimal*
// reproducer rather than the wild mutated buffer that
// happened to fire first.
//
// We implement the two cheapest strategies that cover most
// of the win:
//   1. Halving — drop the first or second half; recurse if
//      either still fails. O(log n) wins in the lucky case.
//   2. Single-byte drops — try removing one byte at a time
//      from the smallest still-failing input. O(n) per
//      pass, repeated until a full pass yields no further
//      reduction.
//
// Cap total `target(...)` calls during shrinking at
// `__fuzz_shrink_budget` so a pathological input doesn't
// stall the suite. The budget is small enough to keep a
// failed run under a second on the migration's test sizes,
// large enough to flatten typical 50-byte mutated buffers
// down to the actual minimal trigger.
function __fuzz_shrink_budget(): i32 { return 256; }

// __fuzz_shrink_once tries every "drop one byte" position
// against `seed` and returns the SHORTEST input that still
// fails. Returns the original seed when no position drops
// the failure (i.e. the input is already minimal under
// single-byte deletes). Counts every call into `budget` and
// stops returning new candidates when the budget is
// exhausted.
function __fuzz_shrink_once(seed: string, target: (string) => test.TestOutcome, budget: i32): (string, i32) {
    var n: i32 = seed.len();
    var best: string = seed;
    var best_len: i32 = n;
    var i: i32 = 0;
    while (i < n && budget > 0) {
        var candidate: string = seed[0:i] + seed[i + 1:n];
        budget = budget - 1;
        match (target(candidate)) {
            Fail(_) => {
                if (candidate.len() < best_len) {
                    best = candidate;
                    best_len = candidate.len();
                }
            },
            Pass => { },
        }
        i = i + 1;
    }
    return (best, budget);
}

// __fuzz_shrink_halve tries the "drop first half" and
// "drop second half" candidates and recurses on whichever
// still fails. Logarithmic win when the failure is
// localised; falls through to __fuzz_shrink_once for
// fine-grained minimisation.
function __fuzz_shrink_halve(seed: string, target: (string) => test.TestOutcome, budget: i32): (string, i32) {
    var n: i32 = seed.len();
    if (n < 2 || budget <= 0) { return (seed, budget); }
    var mid: i32 = n / 2;
    var left: string = seed[0:mid].to_owned();
    var right: string = seed[mid:n].to_owned();
    // Try left half first — same lexicographic preference
    // the seed-iteration order uses, so failures cluster
    // toward the "obvious" minimal reproducer.
    budget = budget - 1;
    match (target(left)) {
        Fail(_) => {
            return __fuzz_shrink_halve(left, target, budget);
        },
        Pass => { },
    }
    if (budget <= 0) { return (seed, budget); }
    budget = budget - 1;
    match (target(right)) {
        Fail(_) => {
            return __fuzz_shrink_halve(right, target, budget);
        },
        Pass => { },
    }
    return (seed, budget);
}

// __fuzz_shrink drives both strategies. Halve until no
// further halving wins, then single-byte-drop until a full
// pass yields no reduction. Return the best (shortest)
// failing input found.
function __fuzz_shrink(seed: string, target: (string) => test.TestOutcome): string {
    var budget: i32 = __fuzz_shrink_budget();
    var current: string = seed;
    // Halving pass.
    var (h, b) = __fuzz_shrink_halve(current, target, budget);
    current = h;
    budget = b;
    // Single-byte-drop pass, repeating until a full pass
    // doesn't shrink any further. Bounded by `budget`.
    var stable: boolean = false;
    while (!stable && budget > 0) {
        var (s, b2) = __fuzz_shrink_once(current, target, budget);
        if (s.len() < current.len()) {
            current = s;
            budget = b2;
        } else {
            stable = true;
        }
    }
    return current;
}

// fuzz_run_shrink — run the regular fuzz loop, and on the
// first failure shrink the offending input to a minimal
// reproducer before returning. The diagnostic embeds both
// the original failing input AND the minimised one when
// they differ, so the log shows what the harness found
// AND what survived shrinking.
//
// Counts shrink-time `target(...)` calls under a separate
// budget that does NOT inflate the user-visible `iterations`
// param — `iterations` is the mutation count, shrinking is
// a post-process amortised against the first failure.
pub function fuzz_run_shrink(seeds: string[], iterations: i32, target: (string) => test.TestOutcome): test.TestOutcome {
    if (iterations <= 0) {
        return test.fail("fuzz_run_shrink: iterations must be > 0, got " + iterations.to_string());
    }
    if (seeds.len() == 0) {
        return test.fail("fuzz_run_shrink: at least one seed required");
    }
    // Pass 1: seeds verbatim.
    var i: i32 = 0;
    while (i < seeds.len()) {
        match (target(seeds[i])) {
            Fail(msg) => {
                var min: string = __fuzz_shrink(seeds[i], target);
                return test.fail(__fuzz_format_failure(
                    "seed[" + i.to_string() + "]", seeds[i], min, msg));
            },
            Pass => { },
        }
        i = i + 1;
    }
    // Pass 2: mutated iterations, over a threaded PCG32 state. The seed is
    // drawn once from the CSPRNG rather than once per mutation, and it is
    // named in the diagnostic so the run can be replayed.
    var rng_seed: i64 = (math.random_int(0 - 2000000000, 2000000000)) as i64;
    var st: i64 = rand.rng_seed(rng_seed);
    var iter: i32 = 0;
    while (iter < iterations) {
        var seed: string = __fuzz_pick_seed(seeds, iter);
        var mpick = rand.rng_below(st, __fuzz_mutator_count());
        st = mpick.0;
        var mode: i32 = mpick.1;
        var mutated = __fuzz_mutate(seed, mode, st);
        st = mutated.0;
        var input: string = mutated.1;
        match (target(input)) {
            Fail(msg) => {
                var min: string = __fuzz_shrink(input, target);
                return test.fail(__fuzz_format_failure(
                    "iter " + iter.to_string() + " mode " + mode.to_string()
                        + " rng_seed " + rng_seed.to_string(),
                    input, min, msg));
            },
            Pass => { },
        }
        iter = iter + 1;
    }
    return test.pass();
}

// __fuzz_format_failure builds the diagnostic block. When
// shrinking is a no-op (already minimal) the message omits
// the redundant "shrunk to" line.
function __fuzz_format_failure(origin: string, raw: string, minimised: string, msg: string): string {
    if (raw == minimised) {
        return origin + " input \"" + __fuzz_escape(raw) + "\" (" +
               raw.len().to_string() + " bytes): " + msg;
    }
    return origin + ": " + msg +
           "\n  raw     (" + raw.len().to_string() + " bytes): \"" +
                __fuzz_escape(raw) + "\"" +
           "\n  shrunk  (" + minimised.len().to_string() + " bytes): \"" +
                __fuzz_escape(minimised) + "\"";
}

// (r) fuzz_shrink — receiver-method form. Reports as one
// TAP case; on failure the case message embeds the
// minimised counter-example so CI logs preserve a clean
// reproducer.
pub function (r: test.TestRunner) fuzz_shrink(name: string, seeds: string[], iterations: i32, target: (string) => test.TestOutcome): test.TestRunner {
    return r.it(name, () => fuzz_run_shrink(seeds, iterations, target));
}

// =================== CORPUS LOADING ===================
//
// Larger fuzz campaigns want their seed corpus on disk so
// that interesting inputs accumulated over time can be
// committed to the repo as `testdata/fuzz_corpus/*.bin`
// — same shape Go's testing.F+`-fuzz` uses.
//
// `fuzz_corpus_from_dir(path)` reads every file under
// `path` (non-recursive) and returns each file's contents
// as a seed. Files are sorted by name so the verbatim
// pass — which runs every seed first — has a deterministic
// order regardless of the OS-level directory enumeration
// order. Hidden / `_`-prefixed entries are skipped so
// scratch metadata doesn't get treated as fuzz input.

import "core/cmp";

// fuzz_corpus_from_dir(path) — load every regular file under
// `path` as a seed string. Returns the seeds via Result so
// the caller can fall back to inline seeds when the corpus
// directory isn't present (typical pattern: ship a small
// inline corpus + grow it on disk over time).
pub function fuzz_corpus_from_dir(path: string): Result[string[], IoError] {
    match (read_dir(path)) {
        Err(e) => { return Err(e); },
        Ok(names) => {
            // Stable order so the verbatim-seed pass + the
            // mutation pass both walk the corpus the same
            // way each run. Qualified `cmp.sort` call so
            // modload's rewriter routes correctly under the
            // user-side mangled-load path too (the flat-load
            // path would resolve the bare name).
            var sorted: string[] = cmp.sort(names);
            var seeds: string[] = [];
            var i: i32 = 0;
            while (i < sorted.len()) {
                var name: string = sorted[i];
                // Skip dotfiles + underscored metadata.
                if (name.len() > 0 && name[0] != 46 && name[0] != 95) {
                    var full: string = path + "/" + name;
                    match (stat(full)) {
                        Ok(s) => {
                            if (s.is_file) {
                                match (read_file(full)) {
                                    Ok(content) => { seeds = seeds.append(content); },
                                    Err(_) => { },
                                }
                            }
                        },
                        Err(_) => { },
                    }
                }
                i = i + 1;
            }
            return Ok(seeds);
        }
    }
    return Ok([]);
}

// fuzz_corpus_from_dir_or(path, fallback) — convenience for
// the typical "use the on-disk corpus when present, else
// fall back to inline seeds" pattern:
//
//   var seeds: string[] = fuzz_corpus_from_dir_or(
//       "testdata/parser_corpus",
//       ["", "function main(): i32 { return 0; }"]);
//
// Concatenates the on-disk seeds AFTER the fallback so the
// inline ones are guaranteed to run even if the disk
// corpus is empty.
pub function fuzz_corpus_from_dir_or(path: string, fallback: string[]): string[] {
    match (fuzz_corpus_from_dir(path)) {
        Ok(loaded) => {
            if (loaded.len() == 0) { return fallback; }
            var out: string[] = fallback;
            var i: i32 = 0;
            while (i < loaded.len()) {
                out = out.append(loaded[i]);
                i = i + 1;
            }
            return out;
        },
        Err(_) => { return fallback; }
    }
    return fallback;
}
