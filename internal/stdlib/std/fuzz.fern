// This module runs tests with generated byte buffers.
import "std/i32";
import "std/string";
import "std/array";
import "std/math";
import "std/rand";
import "core/cmp";
import "std/test";

pub const DEFAULT_ITERATIONS: i32 = 200;

function __fuzz_pick_seed(seeds: u8[][], iter: i32): u8[] {
  let n: i32 = seeds.len();
  if (n == 0) {
    let empty: u8[] = [];
    return empty;
  }
  return seeds[iter % n];
}

function __fuzz_bytes_slice(xs: u8[], lo: i32, hi: i32): u8[] {
  let out: u8[] = [];
  let i: i32 = lo;
  while (i < hi) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}

function __fuzz_bytes_replace(xs: u8[], at: i32, b: u8): u8[] {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i == at) {
      out = out.append(b);
    } else {
      out = out.append(xs[i]);
    }
    i = i + 1;
  }
  return out;
}

function __fuzz_bytes_drop(xs: u8[], at: i32): u8[] {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i != at) {
      out = out.append(xs[i]);
    }
    i = i + 1;
  }
  return out;
}

function __fuzz_bytes_insert(xs: u8[], at: i32, b: u8): u8[] {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i == at) {
      out = out.append(b);
    }
    out = out.append(xs[i]);
    i = i + 1;
  }
  if (at >= xs.len()) {
    out = out.append(b);
  }
  return out;
}

function __fuzz_mutate(seed: u8[], mode: i32, state: i64): (i64, u8[]) {
  let n: i32 = seed.len();
  if (n == 0 && mode != 2) {
    return (state, seed);
  }
  if (mode == 0) {
    let pi = rand.rng_below(state, n);
    let pb = rand.rng_below(pi.0, 256);
    return (pb.0, __fuzz_bytes_replace(seed, pi.1, pb.1 as u8));
  }
  if (mode == 1) {
    let p1 = rand.rng_below(state, n);
    return (p1.0, __fuzz_bytes_drop(seed, p1.1));
  }
  if (mode == 2) {
    let p2 = rand.rng_below(state, n + 1);
    let b2 = rand.rng_below(p2.0, 256);
    return (b2.0, __fuzz_bytes_insert(seed, p2.1, b2.1 as u8));
  }
  if (mode == 3) {
    let p3 = rand.rng_below(state, n);
    let bit = rand.rng_below(p3.0, 8);
    let flipped: i32 = seed[p3.1] as i32 ^ 1 << bit.1;
    return (bit.0, __fuzz_bytes_replace(seed, p3.1, flipped as u8));
  }
  if (mode == 4) {
    let p4 = rand.rng_below(state, n);
    return (p4.0, __fuzz_bytes_insert(seed, p4.1, seed[p4.1]));
  }
  if (mode == 5) {
    let p5 = rand.rng_below(state, n);
    return (p5.0, __fuzz_bytes_replace(seed, p5.1, 0 as u8));
  }
  if (mode == 6) {
    let p6 = rand.rng_below(state, n);
    return (p6.0, __fuzz_bytes_replace(seed, p6.1, 255 as u8));
  }
  return (state, seed);
}

function __fuzz_mutator_count(): i32 {
  return 8;
}

function __fuzz_escape(bs: u8[]): string {
  let n: i32 = bs.len();
  let cap: i32 = 200;
  let trimmed: boolean = false;
  if (n > cap) {
    n = cap;
    trimmed = true;
  }
  let out: string = "";
  let i: i32 = 0;
  while (i < n) {
    let b: i32 = bs[i] as i32;
    if (b == 92) {
      out = out + "\\\\";
    } else if (b == 34) {
      out = out + "\\\"";
    } else if (b == 10) {
      out = out + "\\n";
    } else if (b == 13) {
      out = out + "\\r";
    } else if (b == 9) {
      out = out + "\\t";
    } else if (b >= 32 && b < 127) {
      out = out + (b as u8).to_ascii_string();
    } else {
      out = out + "\\x" + b.to_hex().pad_start(2, '0');
    }
    i = i + 1;
  }
  if (trimmed) {
    out = out + " ...";
  }
  return out;
}

pub function run(seeds: u8[][], iterations: i32, target: (u8[]) => test.TestOutcome): test.TestOutcome {
  return run_seeded(seeds, iterations, math.random_int(0 - 2000000000, 2000000000) as i64, target);
}

pub function run_seeded(seeds: u8[][], iterations: i32, rng_seed: i64, target: (u8[]) => test.TestOutcome): test.TestOutcome {
  if (iterations <= 0) {
    return test.fail("run: iterations must be > 0, got " + iterations.to_string());
  }
  if (seeds.len() == 0) {
    return test.fail("run: at least one seed required");
  }
  let i: i32 = 0;
  while (i < seeds.len()) {
    match (target(seeds[i])) {
      Fail(msg) => {
        return test.fail("seed[" + i.to_string() + "] = \""
          + __fuzz_escape(seeds[i]) + "\": " + msg);
      },
      Pass => {}
    }
    i = i + 1;
  }
  let st: i64 = rand.rng_seed(rng_seed);
  let iter: i32 = 0;
  while (iter < iterations) {
    let seed: u8[] = __fuzz_pick_seed(seeds, iter);
    let mpick = rand.rng_below(st, __fuzz_mutator_count());
    st = mpick.0;
    let mode: i32 = mpick.1;
    let mutated = __fuzz_mutate(seed, mode, st);
    st = mutated.0;
    let input: u8[] = mutated.1;
    match (target(input)) {
      Fail(msg) => {
        return test.fail("iter " + iter.to_string()
          + " mode " + mode.to_string()
          + " rng_seed " + rng_seed.to_string()
          + " input \"" + __fuzz_escape(input) + "\": " + msg);
      },
      Pass => {}
    }
    iter = iter + 1;
  }
  return test.pass();
}

pub function (r: test.TestRunner) fuzz(name: string, seeds: u8[][], iterations: i32, target: (u8[]) => test.TestOutcome): test.TestRunner {
  return r.it(name, () => run(seeds, iterations, target));
}

function __fuzz_shrink_budget(): i32 {
  return 256;
}

function __fuzz_shrink_once(seed: u8[], target: (u8[]) => test.TestOutcome, budget: i32): (u8[], i32) {
  let n: i32 = seed.len();
  let best: u8[] = seed;
  let best_len: i32 = n;
  let i: i32 = 0;
  while (i < n && budget > 0) {
    let candidate: u8[] = __fuzz_bytes_drop(seed, i);
    budget = budget - 1;
    match (target(candidate)) {
      Fail(_) => {
        if (candidate.len() < best_len) {
          best = candidate;
          best_len = candidate.len();
        }
      },
      Pass => {}
    }
    i = i + 1;
  }
  return (best, budget);
}

function __fuzz_shrink_halve(seed: u8[], target: (u8[]) => test.TestOutcome, budget: i32): (u8[], i32) {
  let n: i32 = seed.len();
  if (n < 2 || budget <= 0) {
    return (seed, budget);
  }
  let mid: i32 = n / 2;
  let left: u8[] = __fuzz_bytes_slice(seed, 0, mid);
  let right: u8[] = __fuzz_bytes_slice(seed, mid, n);
  budget = budget - 1;
  match (target(left)) {
    Fail(_) => {
      return __fuzz_shrink_halve(left, target, budget);
    },
    Pass => {}
  }
  if (budget <= 0) {
    return (seed, budget);
  }
  budget = budget - 1;
  match (target(right)) {
    Fail(_) => {
      return __fuzz_shrink_halve(right, target, budget);
    },
    Pass => {}
  }
  return (seed, budget);
}

function __fuzz_shrink(seed: u8[], target: (u8[]) => test.TestOutcome): u8[] {
  let budget: i32 = __fuzz_shrink_budget();
  let current: u8[] = seed;
  let (h, b) = __fuzz_shrink_halve(current, target, budget);
  current = h;
  budget = b;
  let stable: boolean = false;
  while (!stable && budget > 0) {
    let (s, b2) = __fuzz_shrink_once(current, target, budget);
    if (s.len() < current.len()) {
      current = s;
      budget = b2;
    } else {
      stable = true;
    }
  }
  return current;
}

pub function run_shrink(seeds: u8[][], iterations: i32, target: (u8[]) => test.TestOutcome): test.TestOutcome {
  if (iterations <= 0) {
    return test.fail("run_shrink: iterations must be > 0, got " + iterations.to_string());
  }
  if (seeds.len() == 0) {
    return test.fail("run_shrink: at least one seed required");
  }
  let i: i32 = 0;
  while (i < seeds.len()) {
    match (target(seeds[i])) {
      Fail(msg) => {
        let min: u8[] = __fuzz_shrink(seeds[i], target);
        return test.fail(__fuzz_format_failure(
          "seed[" + i.to_string() + "]", seeds[i], min, msg,
        ));
      },
      Pass => {}
    }
    i = i + 1;
  }
  let rng_seed: i64 = math.random_int(0 - 2000000000, 2000000000) as i64;
  let st: i64 = rand.rng_seed(rng_seed);
  let iter: i32 = 0;
  while (iter < iterations) {
    let seed: u8[] = __fuzz_pick_seed(seeds, iter);
    let mpick = rand.rng_below(st, __fuzz_mutator_count());
    st = mpick.0;
    let mode: i32 = mpick.1;
    let mutated = __fuzz_mutate(seed, mode, st);
    st = mutated.0;
    let input: u8[] = mutated.1;
    match (target(input)) {
      Fail(msg) => {
        let min: u8[] = __fuzz_shrink(input, target);
        return test.fail(__fuzz_format_failure(
          "iter " + iter.to_string() + " mode " + mode.to_string()
            + " rng_seed " + rng_seed.to_string(),
          input, min, msg,
        ));
      },
      Pass => {}
    }
    iter = iter + 1;
  }
  return test.pass();
}

function __fuzz_format_failure(origin: string, raw: u8[], minimised: u8[], msg: string): string {
  if (cmp.eq_arrays(raw, minimised)) {
    return origin + " input \"" + __fuzz_escape(raw) + "\" ("
      + raw.len().to_string() + " bytes): " + msg;
  }
  return origin + ": " + msg
    + "\n  raw     (" + raw.len().to_string() + " bytes): \""
    + __fuzz_escape(raw) + "\""
    + "\n  shrunk  (" + minimised.len().to_string() + " bytes): \""
    + __fuzz_escape(minimised) + "\"";
}

pub function (r: test.TestRunner) fuzz_shrink(name: string, seeds: u8[][], iterations: i32, target: (u8[]) => test.TestOutcome): test.TestRunner {
  return r.it(name, () => run_shrink(seeds, iterations, target));
}

pub function corpus_from_dir(path: string): Result[u8[][], IoError] {
  match (read_dir(path)) {
    Err(e) => {
      return Err(e);
    },
    Ok(names) => {
      let sorted: string[] = cmp.sort(names);
      let seeds: u8[][] = [];
      let i: i32 = 0;
      while (i < sorted.len()) {
        let name: string = sorted[i];
        if (name.len() > 0 && name[0] != 46 && name[0] != 95) {
          let full: string = path + "/" + name;
          match (stat(full)) {
            Ok(s) => {
              if (s.is_file) {
                match (read_file_bytes(full)) {
                  Ok(content) => {
                    seeds = seeds.append(content);
                  },
                  Err(_) => {}
                }
              }
            },
            Err(_) => {}
          }
        }
        i = i + 1;
      }
      return Ok(seeds);
    }
  }
  return Ok([]);
}

pub function corpus_from_dir_or(path: string, fallback: u8[][]): u8[][] {
  match (corpus_from_dir(path)) {
    Ok(loaded) => {
      if (loaded.len() == 0) {
        return fallback;
      }
      let out: u8[][] = fallback;
      let i: i32 = 0;
      while (i < loaded.len()) {
        out = out.append(loaded[i]);
        i = i + 1;
      }
      return out;
    },
    Err(_) => {
      return fallback;
    }
  }
  return fallback;
}
