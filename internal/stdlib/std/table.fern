// std/table — render rows of strings as a column-aligned text table,
// the kind of output CLI tools print.
//
//   render([["name", "age"], ["ada", "36"], ["bo", "9"]])
//     name  age
//     ada   36
//     bo    9
//
// Each column is padded (with spaces) to the widest cell in that column;
// columns are separated by two spaces and the last column is not padded
// (no trailing whitespace). Short rows are treated as having empty
// trailing cells. Widths are measured in Unicode CODE POINTS, so
// accented text lines up; full-width (CJK) and combining marks are a
// known limitation (they count as one column each).

import "std/utf8";
import "std/string";
import "std/array";

// __tbl_pad appends spaces so `s` reaches `width` code points.
function __tbl_pad(s: string, width: i32): string {
    var out: u8[] = [];
    var i: i32 = 0;
    while (i < s.len()) {
        out = out.append(s[i] as u8);
        i = i + 1;
    }
    var pad: i32 = width - utf8.codepoint_count(s);
    var p: i32 = 0;
    while (p < pad) {
        out = out.append(32 as u8);
        p = p + 1;
    }
    return string_from_bytes_unchecked(out);
}

// __tbl_widths returns the per-column max code-point width across `rows`.
function __tbl_widths(rows: string[][]): i32[] {
    var ncols: i32 = 0;
    var r: i32 = 0;
    while (r < rows.len()) {
        if (rows[r].len() > ncols) { ncols = rows[r].len(); }
        r = r + 1;
    }
    var widths: i32[] = [];
    var c: i32 = 0;
    while (c < ncols) { widths = widths.append(0); c = c + 1; }
    r = 0;
    while (r < rows.len()) {
        c = 0;
        while (c < rows[r].len()) {
            var w: i32 = utf8.codepoint_count(rows[r][c]);
            if (w > widths[c]) { widths = widths.with(c, w); }
            c = c + 1;
        }
        r = r + 1;
    }
    return widths;
}

// __tbl_row renders one row against the given column widths (the last
// column is emitted unpadded).
function __tbl_row(row: string[], widths: i32[]): string {
    var cells: string[] = [];
    var c: i32 = 0;
    while (c < widths.len()) {
        var cell: string = "";
        if (c < row.len()) { cell = row[c]; }
        if (c == widths.len() - 1) { cells = cells.append(cell); }
        else { cells = cells.append(__tbl_pad(cell, widths[c])); }
        c = c + 1;
    }
    return cells.join("  ");
}

// `render(rows)` — the column-aligned table (no header rule). Rows are
// joined by newlines, with no trailing newline.
pub function render(rows: string[][]): string {
    var widths: i32[] = __tbl_widths(rows);
    var lines: string[] = [];
    var r: i32 = 0;
    while (r < rows.len()) {
        lines = lines.append(__tbl_row(rows[r], widths));
        r = r + 1;
    }
    return lines.join("\n");
}

// `render_with_header(headers, rows)` — like `render`, but with the
// header row followed by a rule of `-` under each column (widths span
// the header AND the rows).
pub function render_with_header(headers: string[], rows: string[][]): string {
    // Combine into one array to size the columns over everything.
    var all: string[][] = [headers];
    var i: i32 = 0;
    while (i < rows.len()) {
        all = all.append(rows[i]);
        i = i + 1;
    }
    var widths: i32[] = __tbl_widths(all);
    var lines: string[] = [];
    lines = lines.append(__tbl_row(headers, widths));
    // Rule row: each column's width in '-'.
    var rule: string[] = [];
    var c: i32 = 0;
    while (c < widths.len()) {
        var dashes: u8[] = [];
        var d: i32 = 0;
        while (d < widths[c]) { dashes = dashes.append(45 as u8); d = d + 1; }   // '-'
        rule = rule.append(string_from_bytes_unchecked(dashes));
        c = c + 1;
    }
    lines = lines.append(__tbl_row(rule, widths));
    var r: i32 = 0;
    while (r < rows.len()) {
        lines = lines.append(__tbl_row(rows[r], widths));
        r = r + 1;
    }
    return lines.join("\n");
}
