// std/http — HTTP/1.1 request parsing, response building, and
// serialization. Helpers that compose on top of the runtime's
// raw `tcp_*` socket primitives so user code (and the
// auto-synthesised handler `main()`) can do
// request → response work without rolling its own parser.
//
// No prelude: callers now `import "std/http";` explicitly
// (docs/PRELUDE-TO-MODULES.md, Phase 5).
//
// Scope: HTTP/1.1 and HTTP/1.0, request bodies delimited by
// Content-Length or by chunked transfer coding (trailers into
// `request.trailers`); a request line of at most 8 KiB, a header block of at most
// 32 KiB and 100 fields, a body of at most 1 MiB with at most 32 KiB of
// chunk framing, and no lenient mode: a malformed request is refused
// (RFC 9112 §2.2, §3.2, §5, §6.1, §6.3, §7.1), never repaired, with the
// status the serve loop answers it with.
// Persistent connections are the serve loop's: `http_parse_request_framed`
// says how many bytes a request occupied and whether the connection
// outlives it, and `http_serialize_response_conn` writes the `Connection`
// the loop decided. Responses are Content-Length-delimited. No TLS.

import "core/int";
import "core/map";
// std/http's bodies dispatch (string) methods all over the
// request parser and response builder — `.index_of()`,
// `.split()`, `.trim()`, `.to_lower()`, etc. Declare std/string
// so those receiver methods register under no-prelude.
import "std/string";
// std/headers backs the HttpRequest.headers field — header_map_new
// for the parse-request entry placeholder, append for populating
// from the parsed header block.
import "std/headers";
import "std/io_buffered" as io_buffered;
import "std/json";
// std/stream backs the HttpRequest.body field — stream_from_string
// to wrap a parsed body, and the cursor readers the whole-body
// shims below run over it.
import "std/stream";
import "std/error";
import "std/platform";
import "std/utf8" as utf8;

// `http_status_text(code)` — IANA reason phrase for the
// common HTTP status codes (RFC 9110). Returns "" for
// unknown codes — callers should fall back to a generic
// phrase rather than emitting nothing.
pub function http_status_text(code: i32): string {
  let codes: i32[] = [
    100, 101, 200, 201, 204, 301, 302, 304, 307, 308,
    400, 401, 403, 404, 405, 408, 409, 410, 413, 414, 415, 417, 418, 422, 429, 431,
    500, 501, 502, 503, 504, 505,
  ];
  let phrases: string[] = [
    "Continue", "Switching Protocols", "OK", "Created", "No Content", "Moved Permanently", "Found", "Not Modified", "Temporary Redirect", "Permanent Redirect",
    "Bad Request", "Unauthorized", "Forbidden", "Not Found", "Method Not Allowed", "Request Timeout", "Conflict", "Gone", "Payload Too Large", "URI Too Long", "Unsupported Media Type", "Expectation Failed", "I'm a teapot", "Unprocessable Entity", "Too Many Requests", "Request Header Fields Too Large",
    "Internal Server Error", "Not Implemented", "Bad Gateway", "Service Unavailable", "Gateway Timeout", "HTTP Version Not Supported",
  ];
  let i: i32 = 0;
  while (i < codes.len()) {
    if (codes[i] == code) {
      return phrases[i];
    }
    i = i + 1;
  }
  return "";
}

// `is_valid_http_status(code)` — true if code is in the RFC
// 9110 range of [100, 599]. The full HTTP status range is
// 100..999 by the BNF but only the first three centuries
// have semantic meaning; servers shouldn't emit codes
// outside [100, 599].
pub function is_valid_http_status(code: i32): boolean {
  return code >= 100 && code <= 599;
}

// Status-class predicates — the RFC 9110 §15 response classes, for
// branching on a response code without hard-coding range bounds at
// every call site (`if (http_is_success(resp.status)) { … }`). Each
// tests the code's leading digit / century:
//   1xx informational, 2xx success, 3xx redirect,
//   4xx client error, 5xx server error.
// A code outside [100, 599] belongs to no class, so every predicate is
// false for it.
pub function http_is_informational(code: i32): boolean {
  return code >= 100 && code <= 199;
}

pub function http_is_success(code: i32): boolean {
  return code >= 200 && code <= 299;
}

pub function http_is_redirect(code: i32): boolean {
  return code >= 300 && code <= 399;
}

pub function http_is_client_error(code: i32): boolean {
  return code >= 400 && code <= 499;
}

pub function http_is_server_error(code: i32): boolean {
  return code >= 500 && code <= 599;
}

// `http_is_error(code)` — client OR server error (4xx / 5xx), the
// common "did the request fail?" check.
pub function http_is_error(code: i32): boolean {
  return code >= 400 && code <= 599;
}

// `ok(body)` — 200 OK with the given body.
// `text(status, body)` — explicit status code.
// `not_found()` — common 404 builder.
// Saves the `HttpResponse { status: 200, body: ... }` boiler-
// plate at every handler call site.
pub function ok(body: string): HttpResponse {
  return HttpResponse { status: 200, body: BodyText(body), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

pub function text(status: i32, body: string): HttpResponse {
  return HttpResponse { status: status, body: BodyText(body), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

pub function not_found(): HttpResponse {
  return HttpResponse { status: 404, body: BodyText("Not Found"), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// `bad_request(body)` — 400 with the given
// body. Common shape for validation-failure responses.
pub function bad_request(body: string): HttpResponse {
  return HttpResponse { status: 400, body: BodyText(body), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// `internal_error(body)` — 500. The default
// body shape for unhandled / unexpected exceptions in a
// handler.
pub function internal_error(body: string): HttpResponse {
  return HttpResponse { status: 500, body: BodyText(body), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// `redirect(location)` — 302 Found with the
// redirect target both in the body (for clients that ignore
// headers) and as a real `Location:` header.
pub function redirect(location: string): HttpResponse {
  let h: HeaderMap = headers.header_map_new();
  h = h.set("Location", location);
  return HttpResponse { status: 302, body: BodyText(location), headers: h, trailers: headers.header_map_new() };
}

// `no_content()` — 204 No Content, empty
// body. The standard "I handled it, nothing to say"
// response for DELETE / PUT / etc.
pub function no_content(): HttpResponse {
  return HttpResponse { status: 204, body: BodyText(""), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// `created(body)` — 201 Created with the given body: what a POST that
// made something answers, the new resource's address in the body or
// set on `Location` by the caller.
pub function created(body: string): HttpResponse {
  return HttpResponse { status: 201, body: BodyText(body), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// ============================================================
// Typed-body builders (#4385 — "response builders never set
// Content-Type"). The plain builders above (`ok`, `text`, …)
// leave the media type unset, so a browser sniffs the body and
// a JSON API response can render as text. These set the right
// `Content-Type` up front, saving the `.with_header("Content-
// Type", …)` at every handler call site. Body types that carry
// text use an explicit `charset=utf-8` (Fern strings are UTF-8).
// ============================================================

// Build a 200 response with `Content-Type: ct` set.
function __http_response_typed(status: i32, body: string, ct: string): HttpResponse {
  let h: HeaderMap = headers.header_map_new();
  h = h.set("Content-Type", ct);
  return HttpResponse { status: status, body: BodyText(body), headers: h, trailers: headers.header_map_new() };
}

// `json(body)` — 200 with `Content-Type:
// application/json`. `body` is the already-serialized JSON
// text (e.g. from `json.encode(...)`); this only sets the
// media type, it does not itself serialize.
pub function json(body: string): HttpResponse {
  return __http_response_typed(200, body, "application/json");
}

// `json_status(status, body)` — like
// `json` but with an explicit status code, for
// `201 Created` / `422 Unprocessable Entity` / … JSON replies.
pub function json_status(status: i32, body: string): HttpResponse {
  return __http_response_typed(status, body, "application/json");
}

// `html(body)` — 200 with `Content-Type:
// text/html; charset=utf-8`.
pub function html(body: string): HttpResponse {
  return __http_response_typed(200, body, "text/html; charset=utf-8");
}

// `plain(body)` — 200 with `Content-Type:
// text/plain; charset=utf-8`. The typed sibling of
// `ok`, for when the client should be told the
// body is plain text rather than left to sniff it.
pub function plain(body: string): HttpResponse {
  return __http_response_typed(200, body, "text/plain; charset=utf-8");
}

// ============================================================
// Errors a handler answers with (#9854).
//
// `ToResponse` is the error side of a handler written as a
// `Result[HttpResponse, E]`: `respond(result)` answers `Ok(r)` with `r`
// and `Err(e)` with `e.to_response()`, so a handler's helpers fail with
// `?` and one `respond` at the end turns the failure into the reply. A
// `handle` declared with that return type needs no `respond` of its
// own: both compilers rename it `__fern_handle_result` and synthesise
// the plain `handle` calling `respond` (or `respond_with` for the
// state-threading pair) over it.
// `problem(status, title, detail)` is the RFC 9457 problem-details
// answer (`application/problem+json`, a title of "" reading as the
// status text, a detail of "" left out), `HttpError` the error value
// carrying one, and `fail(status, detail)` builds it titled with the
// status text. std/json's `JsonError` answers 400 with where the text
// broke, and a `string` error answers 500 with the status text alone —
// the message is dropped, so log it before the `?` when it matters, or
// fail with an `HttpError` to put it on the wire. std/fetch's `FetchError`
// answers 504 for a timeout, 500 for an `InvalidRequest` and 502 for the
// rest, without its message. A handler whose errors are `dyn error.Error`
// is answered by `respond_error`, which logs each message through the
// platform.

pub trait ToResponse {
  function to_response(self: Self): HttpResponse;
}

pub function respond[E: ToResponse](result: Result[HttpResponse, E]): HttpResponse {
  match (result) {
    Ok(r) => {
      return r;
    },
    Err(e) => {
      return e.to_response();
    }
  }
  return problem(500, "", "");
}

// `respond_with(pair)` — `respond` for a state-threading handler: the
// state passes through beside the answer.
pub function respond_with[S, E: ToResponse](pair: (S, Result[HttpResponse, E])): (S, HttpResponse) {
  return (pair.0, respond(pair.1));
}

// `respond_error(result, plat)` — `respond` for a handler whose errors are
// `dyn error.Error`: the error's message goes to `plat.log` and the answer
// is a bare 500 problem, since the message may say more than a client
// should see. A `handle` declared with that error type is adapted with it.
pub function respond_error(result: Result[HttpResponse, dyn error.Error], plat: platform.Platform): HttpResponse {
  match (result) {
    Ok(r) => {
      return r;
    },
    Err(e) => {
      plat.log("handler error: " + e.message());
      return problem(500, "", "");
    }
  }
  return problem(500, "", "");
}

// `respond_error_with(pair, plat)` — `respond_error` for a state-threading
// handler.
pub function respond_error_with[S](pair: (S, Result[HttpResponse, dyn error.Error]), plat: platform.Platform): (S, HttpResponse) {
  return (pair.0, respond_error(pair.1, plat));
}

pub function problem(status: i32, title: string, detail: string): HttpResponse {
  let t: string = title;
  if (t.len() == 0) {
    t = http_status_text(status);
  }
  let body: string = "{\"type\":\"about:blank\",\"title\":\"" + json.json_escape(t) + "\",\"status\":" + int.int_to_string(status);
  if (detail.len() > 0) {
    body = body + ",\"detail\":\"" + json.json_escape(detail) + "\"";
  }
  return __http_response_typed(status, body + "}", "application/problem+json");
}

pub struct HttpError { status: i32, title: string, detail: string }

pub function fail(status: i32, detail: string): HttpError {
  return HttpError { status: status, title: http_status_text(status), detail: detail };
}

impl ToResponse for HttpError {
  function to_response(self: HttpError): HttpResponse {
    return problem(self.status, self.title, self.detail);
  }
}

impl ToResponse for json.JsonError {
  function to_response(self: json.JsonError): HttpResponse {
    return problem(400, "Malformed JSON", self.message + " at line " + int.int_to_string(self.line) + ", column " + int.int_to_string(self.col));
  }
}

impl ToResponse for string {
  function to_response(self: string): HttpResponse {
    return problem(500, "", "");
  }
}

// ============================================================
// A typed JSON body (#9854).
//
// `body_json[T](req)` decodes a request's body as a `T` that implements
// `json.FromJson` (`@derive(json.FromJson)` on a struct), and tells the
// four failures apart so each answers with its own status: a media type
// that is not JSON (`UnsupportedMediaType`, 415), a body that is not
// text (`NotUtf8`, 400 — the error `body_string` carries too), a body
// that is not JSON (`MalformedJson`, 400, with where the text broke), and
// JSON of the wrong shape (`WrongShape`, 422, naming the field).
// `BodyError` is `ToResponse`, so a handler declared as
// `Result[HttpResponse, BodyError]` fails with `?`:
//
//     function handle(req: HttpRequest, plat: platform.Platform): Result[HttpResponse, http.BodyError] {
//         let item: Item = http.body_json[Item](req)?;
//         return Ok(http.json(item.to_json()));
//     }
//
// The media type is the `Content-Type` header's type without its
// parameters, `application/json` or any `+json` suffix, compared without
// regard to case; a request without the header is refused too.

pub enum BodyError {
  UnsupportedMediaType(string),
  MalformedJson(json.JsonError),
  WrongShape(string),
  NotUtf8,
  EndedEarly(i32),
}

impl ToResponse for BodyError {
  function to_response(self: BodyError): HttpResponse {
    match (self) {
      NotUtf8 => {
        return problem(400, "", "body is not valid UTF-8");
      },
      EndedEarly(fault) => {
        return problem(__ended_early_status(fault), "", __ended_early_detail(fault));
      },
      UnsupportedMediaType(ct) => {
        if (ct.len() == 0) {
          return problem(415, "", "expected a Content-Type of application/json");
        }
        return problem(415, "", "expected application/json, got " + ct);
      },
      MalformedJson(e) => {
        return problem(400, "Malformed JSON", e.to_string());
      },
      WrongShape(why) => {
        return problem(422, "", why);
      }
    }
    return problem(500, "", "");
  }
}

// `__ended_early_status(fault)` — the status a body that ended early is
// refused with: the stream's fault when it is one (413 past the cap, 408
// stalled, 400 malformed or cut short), else 500, for a body abandoned
// with the task that read it.
function __ended_early_status(fault: i32): i32 {
  if (fault >= 400 && fault < 600) {
    return fault;
  }
  return 500;
}

function __ended_early_detail(fault: i32): string {
  if (fault == 413) {
    return "the body is past the limit";
  }
  if (fault == 408) {
    return "the body arrived too slowly";
  }
  if (fault == 400) {
    return "the body was malformed or cut short";
  }
  if (fault == 431) {
    return "the body's framing is past the limit";
  }
  return "the body did not arrive whole";
}

pub function body_json[T: json.FromJson](req: HttpRequest): Result[T, BodyError] {
  match (req.headers.get("content-type")) {
    Some(ct) => {
      if (!__media_type_is_json(ct)) {
        return Err(UnsupportedMediaType(ct));
      }
    },
    None => {
      return Err(UnsupportedMediaType(""));
    }
  }
  let text: string = req.body_string()?;
  match (json.json_parse_result(text)) {
    Ok(v) => {
      match (T.from_json_value(v)) {
        Ok(t) => {
          return Ok(t);
        },
        Err(why) => {
          return Err(WrongShape(why));
        }
      }
    },
    Err(e) => {
      return Err(MalformedJson(e));
    }
  }
  return Err(UnsupportedMediaType(""));
}

// __media_type_is_json: the type before any `;` parameter, trimmed, is
// `application/json` or ends in `+json`, in any case.
function __media_type_is_json(ct: string): boolean {
  let mt: string = ct;
  let semi: i32 = ct.index_of(";");
  if (semi >= 0) {
    mt = slice_unchecked(ct, 0, semi) + "";
  }
  mt = mt.trim();
  if (mt.len() == 16 && mt.starts_with_ci("application/json")) {
    return true;
  }
  return mt.ends_with_ci("+json");
}

// `http_path_segments(path)` — split an HTTP path into
// non-empty components. Drops the leading "/" and any
// double slashes; query string (`?...`) is also stripped.
// Useful for simple routing — `/api/users/42` → `["api",
// "users", "42"]`.
// Each segment is materialised with `+ ""`: a bare slice views `path`, which
// the returned array outlives.
pub function http_path_segments(path: string): string[] {
  let n: i32 = path.len();
  // Strip query string.
  let q: i32 = path.index_of("?");
  if (q >= 0) {
    n = q;
  }
  let out: string[] = [];
  let i: i32 = 0;
  while (i < n) {
    while (i < n && path[i] == 47) {  // skip /
      i = i + 1;
    }
    if (i >= n) {
      return out;
    }
    let start: i32 = i;
    while (i < n && path[i] != 47) {
      i = i + 1;
    }
    out = out.append(slice_unchecked(path, start, i) + "");
  }
  return out;
}

// `http_url_path_only(path)` — strip the query string
// (everything from the first `?` onward). Returns path
// unchanged when there's no query. Companion to
// http_path_segments when callers want the bare path
// without splitting.
pub function http_url_path_only(path: string): string {
  let q: i32 = path.index_of("?");
  if (q < 0) {
    return path;
  }
  return slice_unchecked(path, 0, q) + "";
}

// `http_user_agent_is_bot(ua)` — heuristic bot detection
// via the User-Agent string. Checks for common bot tokens
// ("bot", "crawler", "spider", "slurp") case-insensitively.
// False negatives are common (sophisticated bots forge UAs);
// false positives possible (a browser called "BotSimulator").
// Use as a hint, not a security control.
pub function http_user_agent_is_bot(ua: string): boolean {
  if (ua.contains_ci("bot")) {
    return true;
  }
  if (ua.contains_ci("crawler")) {
    return true;
  }
  if (ua.contains_ci("spider")) {
    return true;
  }
  if (ua.contains_ci("slurp")) {
    return true;
  }
  return false;
}

// `http_header_value(block, key)` — the value of the first header named
// `key` (case-insensitively) in a raw CRLF-separated header block, with
// the whitespace around it trimmed, or `None` when no line names it.
// The block is read by the request parser's rules, so one it would
// refuse (a line without a colon, a name that is not a token, obs-fold,
// more than 100 fields) is `None` for every key. Multi-valued headers
// want `http_parse_request` and `get_all`.
pub function http_header_value(block: string, key: string): Option[string] {
  let bs: u8[] = block.bytes();
  match (__parse_header_bytes(bs, 0, bs.len(), http_limits().header_fields)) {
    Ok(h) => {
      return h.get(key);
    },
    Err(_) => {
      return None;
    }
  }
  return None;
}

// __find_crlf is the index of the first CRLF at or after `from` and before
// `end`, or -1; __find_byte the same for one byte.
function __find_crlf(buf: u8[], from: i32, end: i32): i32 {
  let i: i32 = __memchr_bytes(buf, 13, from);
  while (i >= 0 && i + 1 < end) {
    if (buf[i + 1] == 10 as u8) {
      return i;
    }
    i = __memchr_bytes(buf, 13, i + 1);
  }
  return -1;
}

function __find_byte(buf: u8[], from: i32, end: i32, b: u8): i32 {
  let i: i32 = __memchr_bytes(buf, b as i32, from);
  if (i < end) {
    return i;
  }
  return -1;
}

// __bytes_range copies buf[from, end) into a fresh array, and __bytes_string
// copies the same range into a fresh string. The parser's outputs are owned
// copies of what the handler keeps, so the wire buffer can be reused once the
// parse is done.
function __bytes_range(buf: u8[], from: i32, end: i32): u8[] {
  let out: u8[] = __alloc_u8(end - from);
  let i: i32 = 0;
  while (from + i < end) {
    out = out.with(i, buf[from + i]);
    i = i + 1;
  }
  return out;
}

function __bytes_string(buf: u8[], from: i32, end: i32): string {
  return string_from_bytes_range_unchecked(buf, from, end);
}

// HttpLimits — the parser's caps (RFC 9112 §2.3 leaves them to the
// server): the bytes of the request line, of the header block (request
// line included) and the number of its fields, and the bytes of the
// body; the framing of a chunked body (chunk-size lines, the CRLFs, the
// trailer section) gets another `header_bytes`, and its trailers the
// same field count. A request past any of them is malformed, refused
// before a handler sees any of it.
pub struct HttpLimits { request_line: i32, header_bytes: i32, header_fields: i32, body: i32 }

// `http_limits()` — the caps `http_parse_request_framed` and a serve loop
// use unless told otherwise: an 8 KiB request line, a 32 KiB header block
// of at most 100 fields, and a 1 MiB body.
pub function http_limits(): HttpLimits {
  return HttpLimits { request_line: 8192, header_bytes: 32768, header_fields: 100, body: 1048576 };
}

// `http_request_bytes_cap(limits)` — the most bytes one request occupies
// on the wire: a header block at its cap, the CRLF CRLF that ends it, a
// body at its cap and its chunk framing at its cap. A connection
// buffering more than this without a complete request in it holds
// nothing the parser would frame.
pub function http_request_bytes_cap(limits: HttpLimits): i32 {
  return limits.header_bytes + 4 + limits.body + limits.header_bytes;
}

// NOT_TCHAR marks, by byte value, every byte that is not a tchar, the bytes
// of a token (RFC 9110 §5.6.2): a letter, a digit, or one of
// `!#$%&'*+-.^_`|~`. FIELD_CTL marks every control a field value may not
// hold, all but HTAB below SP and DEL. A byte past FIELD_CTL's end is not in
// it.
const NOT_TCHAR: u8[] = [
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 0u8, 0u8, 1u8, 0u8, 0u8, 1u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 1u8, 0u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
];

const FIELD_CTL: u8[] = [
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 0u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8,
];

// `__is_token(buf, from, end)` — whether buf[from, end) is a non-empty
// token.
function __is_token(buf: u8[], from: i32, end: i32): boolean {
  return end > from && __token_end(buf, from, end) == end;
}

// `__token_is(s, want)` — whether `s`, less the SP and HTAB around it,
// is the token `want` under ASCII case folding (RFC 9110 §5.6.2): each byte
// equal to `want`'s once an ASCII capital is lowered, which makes it a tchar
// because `want` is a token. Byte-wise on purpose: a Unicode fold would let U+212A KELVIN
// SIGN match `k`, and a byte-oriented intermediary would frame the
// message differently.
function __token_is(s: string, want: string): boolean {
  let from: i32 = 0;
  let end: i32 = s.len();
  while (from < end && __is_ows(s[from])) {
    from = from + 1;
  }
  while (end > from && __is_ows(s[end - 1])) {
    end = end - 1;
  }
  if (end - from != want.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < want.len()) {
    if (__ascii_lower(s[from + i]) != want[i] as i32) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// `__is_ows(b)` — SP or HTAB, the optional whitespace of RFC 9112 §5.5.
function __is_ows(b: u8): boolean {
  return b == 32 as u8 || b == 9 as u8;
}

// `__ascii_lower(b)` — the byte with an ASCII capital lowered.
function __ascii_lower(b: u8): i32 {
  let v: i32 = b as i32;
  if (v >= 65 && v <= 90) {
    return v + 32;
  }
  return v;
}

// `__field_value(buf, from, end)` — a field value's bytes less the
// optional whitespace around them (RFC 9112 §5.5, SP and HTAB only), or
// `None` when a byte is a control other than HTAB (RFC 9110 §5.5 lets a
// recipient refuse one; a lenient reading would let a VT or FF ride in a
// token that a byte-oriented intermediary reads differently).
function __field_value(buf: u8[], from: i32, end: i32): Option[string] {
  while (from < end && __is_ows(buf[from])) {
    from = from + 1;
  }
  while (end > from && __is_ows(buf[end - 1])) {
    end = end - 1;
  }
  if (__scan_set_bytes(buf, from, FIELD_CTL) < end) {
    return None;
  }
  let v: string = __bytes_string(buf, from, end);
  if (!utf8.is_valid_utf8(v)) {
    return None;
  }
  return Some(v);
}

// `__parse_header_bytes(buf, from, end)` — the CRLF-separated header
// lines in buf[from, end) as a HeaderMap, or the status that refuses
// them (RFC 9112 §5, with no lenient mode): 400 for a line with no colon
// or a name that is not a token (so empty, holding whitespace before the
// colon — a `Content-Length : 5` dropped instead would strand its body
// for the next pipelined parse — or starting with the SP or HTAB of
// obs-fold, §5.2) or a value holding a control byte other than HTAB
// or bytes that are not well-formed UTF-8 (RFC 9110 §5.5 leaves
// obs-text opaque; a `string` is text, so the octets have to spell
// some), 431 for more fields than the cap. Names keep the client's
// spelling; a value loses the SP and HTAB around it
// (`__field_value`).
function __parse_header_bytes(buf: u8[], from: i32, end: i32, fields: i32): Result[HeaderMap, i32] {
  let h: HeaderMap = headers.header_map_new();
  let count: i32 = 0;
  let at: i32 = from;
  while (at < end) {
    let e: i32 = __find_crlf(buf, at, end);
    if (e < 0) {
      e = end;
    }
    let col: i32 = __find_byte(buf, at, e, 58 as u8);
    if (col < 0 || !__is_token(buf, at, col)) {
      return Err(400);
    }
    count = count + 1;
    if (count > fields) {
      return Err(431);
    }
    match (__field_value(buf, col + 1, e)) {
      Some(v) => {
        h = h.append(__bytes_string(buf, at, col), v);
      },
      None => {
        return Err(400);
      }
    }
    at = e + 2;
  }
  return Ok(h);
}

// `__crlf_terminated(buf, from, end)` — whether every LF in buf[from, end)
// is preceded by CR and every CR whose next byte has arrived is followed
// by LF. A bare CR or LF in a request line or header block is malformed
// (RFC 9112 §2.2), not a line terminator and not a byte of a value, and
// it is known as soon as it is read: a partial block is scanned too, so
// only a CR at the very end of the buffer is still undecided.
function __crlf_terminated(buf: u8[], from: i32, end: i32): boolean {
  let i: i32 = from;
  while (true) {
    let cr: i32 = __memchr_bytes(buf, 13, i);
    let lf: i32 = __memchr_bytes(buf, 10, i);
    if (cr < 0 || cr >= end) {
      return lf < 0 || lf >= end;
    }
    if (lf >= 0 && lf < cr) {
      return false;
    }
    if (cr + 1 < buf.len() && buf[cr + 1] != 10 as u8) {
      return false;
    }
    i = cr + 2;
  }
  return true;
}

// `__request_line_end(buf, from)` — where the request line's CRLF starts,
// -1 while the buffer holds less than a line, or -2 once it holds more
// than the cap without one. `__header_block_end` is the same for the
// CRLF CRLF that ends the header block.
function __request_line_end(buf: u8[], from: i32, cap: i32): i32 {
  let limit: i32 = from + cap + 2;
  let end: i32 = buf.len();
  if (limit < end) {
    end = limit;
  }
  let at: i32 = __find_crlf(buf, from, end);
  if (at >= 0) {
    return at;
  }
  if (buf.len() >= limit) {
    return -2;
  }
  return -1;
}

function __header_block_end(buf: u8[], from: i32, cap: i32): i32 {
  let limit: i32 = from + cap + 4;
  let n: i32 = buf.len();
  let end: i32 = n;
  if (limit < end) {
    end = limit;
  }
  let at: i32 = __find_crlf_crlf(buf, from, end);
  if (at >= 0) {
    return at;
  }
  if (n >= limit) {
    return -2;
  }
  return -1;
}

// `http_header_block_complete(buf, from, limits)` — whether the request
// at `from` has its whole header block buffered: the CRLF CRLF that ends
// it lies within the header cap. What follows is the body, and a serve loop times
// the body by how fast it arrives rather than by the deadline the header
// block had.
pub function http_header_block_complete(buf: u8[], from: i32, limits: HttpLimits): boolean {
  return __header_block_end(buf, __past_empty_line(buf, from), limits.header_bytes) >= 0;
}

// `__find_crlf_crlf(buf, from, end)` — where the first CRLF CRLF whose
// four bytes lie in buf[from, end) starts, or -1.
function __find_crlf_crlf(buf: u8[], from: i32, end: i32): i32 {
  let i: i32 = __memchr_bytes(buf, 13, from);
  while (i >= 0 && i + 3 < end) {
    if (buf[i + 1] == 10 as u8 && buf[i + 2] == 13 as u8 && buf[i + 3] == 10 as u8) {
      return i;
    }
    i = __memchr_bytes(buf, 13, i + 1);
  }
  return -1;
}

// `__http_content_length(h)` — the body length the parsed headers
// declare: `Some(0)` with no `Content-Length`, `None` to refuse the
// request (RFC 9112 §6.3): a duplicate `Content-Length` (identical
// values are refused too, rather than collapsed), or a value that is not
// all digits or overflows i32. The overflow is checked before each
// multiply: the body cap cannot catch a length that has already wrapped
// to a small nonnegative value.
// `__field_at(h, key, from)` — the index of the first field named `key` at
// or after `from`, or -1, comparing names ASCII-case-insensitively, so
// the framing rules read the map without building anything.
function __field_at(h: HeaderMap, key: string, from: i32): i32 {
  let i: i32 = from;
  while (i < h.names.len()) {
    if (h.names[i].eq_ignore_ascii_case(key)) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

function __http_content_length(h: HeaderMap): Option[i32] {
  let at: i32 = __field_at(h, "content-length", 0);
  if (at < 0) {
    return Some(0);
  }
  if (__field_at(h, "content-length", at + 1) >= 0) {
    return None;
  }
  let value: string = h.values[at];
  if (value.len() == 0) {
    return None;
  }
  let acc: i32 = 0;
  let i: i32 = 0;
  while (i < value.len()) {
    let b: i32 = value[i] as i32;
    if (b < 48 || b > 57) {
      return None;
    }
    let digit: i32 = b - 48;
    if (acc > 214748364 || acc == 214748364 && digit > 7) {
      return None;
    }
    acc = acc * 10 + digit;
    i = i + 1;
  }
  return Some(acc);
}

// __BodyFraming — how a request's body is delimited (RFC 9112 §6.3): by
// `Content-Length` (`Length(0)` with neither header), or by chunked
// transfer coding.
enum __BodyFraming { Length(i32), Chunked }

// `__http_body_framing(h)` — the body's framing from the parsed headers,
// or the status that refuses the request (RFC 9112 §6.1, §6.3): 400 for
// `Transfer-Encoding` beside `Content-Length` (the request-smuggling
// shape), for a coding list whose last coding is not `chunked` (its
// length cannot be determined), for `chunked` applied twice, or for a
// `Content-Length` the parser cannot read; 501 for a coding applied
// under the final `chunked`, which this parser cannot decode. A lenient
// reading of any of them would be a framing disagreement with the next
// parser on the path.
function __http_body_framing(h: HeaderMap): Result[__BodyFraming, i32] {
  let te: i32 = __field_at(h, "transfer-encoding", 0);
  if (te < 0) {
    match (__http_content_length(h)) {
      Some(n) => {
        return Ok(Length(n));
      },
      None => {
        return Err(400);
      }
    }
    return Err(400);
  }
  if (__field_at(h, "content-length", 0) >= 0 || __field_at(h, "transfer-encoding", te + 1) >= 0) {
    return Err(400);
  }
  let codings: string[] = h.values[te].split(",");
  if (!__token_is(codings[codings.len() - 1], "chunked")) {
    return Err(400);
  }
  let i: i32 = 0;
  while (i + 1 < codings.len()) {
    if (__token_is(codings[i], "chunked")) {
      return Err(400);
    }
    i = i + 1;
  }
  if (codings.len() > 1) {
    return Err(501);
  }
  return Ok(Chunked);
}

// `__host_ok(h, version)` — the `Host` rule (RFC 9112 §3.2): an
// HTTP/1.1 request carries exactly one, any request at most one, and
// its value is a host with an optional port, so it holds nothing but
// visible ASCII (an empty value is the request-target's authority, and
// allowed).
function __host_ok(h: HeaderMap, version: string): boolean {
  let at: i32 = __field_at(h, "host", 0);
  if (at < 0) {
    return version != "HTTP/1.1";
  }
  if (__field_at(h, "host", at + 1) >= 0) {
    return false;
  }
  let host: string = h.values[at];
  let i: i32 = 0;
  while (i < host.len()) {
    let b: i32 = host[i] as i32;
    if (b < 33 || b > 126) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function __hex_digit(b: u8): i32 {
  if (b >= 48 as u8 && b <= 57 as u8) {
    return b as i32 - 48;
  }
  if (b >= 97 as u8 && b <= 102 as u8) {
    return b as i32 - 87;
  }
  if (b >= 65 as u8 && b <= 70 as u8) {
    return b as i32 - 55;
  }
  return -1;
}

// A chunked body (RFC 9112 §7.1) is walked before it is copied: the walk
// checks the framing and records where each chunk's data lies, so the
// copy is one allocation of the decoded length rather than one per
// chunk. The framing — chunk-size lines, extensions, the CRLFs and the
// trailer section — shares a budget of `limits.header_bytes` bytes,
// so what a connection holds for a chunked request is bounded like the
// rest of it, and the decoded body is held to `limits.body`. Every
// violation is refused as soon as it is known: a chunk that could not
// fit under the cap before its data arrives, a byte where a chunk's
// CRLF must be before the CRLF is complete, a line past the budget
// before its end.
//
// The walk and its helpers answer like the parse, with a status where
// the parse says `Malformed`: 1 incomplete, 2 complete, and 400 or more
// refused with that status (400 malformed framing, 413 a body past its
// cap, 431 framing or trailers past their budget).
//
// `__chunked_walk(buf, from)` — `(2, end, spans, trailers)` once the body
// is complete, with `end` the offset past the trailer section's
// terminator, `spans` the (start, len) pairs of the chunk data and
// `trailers` the trailer section's fields.
function __chunked_walk(buf: u8[], from: i32, limits: HttpLimits): (i32, i32, i32[], HeaderMap) {
  let n: i32 = buf.len();
  let at: i32 = from;
  let budget: i32 = limits.header_bytes;
  let room: i32 = limits.body;
  let spans: i32[] = [];
  let none: HeaderMap = headers.header_map_new();
  while (true) {
    let line: (i32, i32, i32) = __chunk_size_line(buf, at, budget, room);
    if (line.0 != 2) {
      return (line.0, 0, spans, none);
    }
    let data: i32 = line.1 + 2;
    let size: i32 = line.2;
    budget = budget - (data - at) - 2;
    if (budget < 0) {
      return (431, 0, spans, none);
    }
    if (size == 0) {
      return __chunked_trailers(buf, data, budget + 2, spans, limits.header_fields);
    }
    let crlf: i32 = __crlf_at(buf, data + size);
    if (crlf == 0) {
      return (400, 0, spans, none);
    }
    if (crlf == 1) {
      return (1, 0, spans, none);
    }
    spans = spans.append(data).append(size);
    room = room - size;
    at = data + size + 2;
  }
  return (400, 0, spans, none);
}

// `__crlf_at(buf, at)` — whether buf[at, at + 2) is CRLF: 2 when it is,
// 0 when a byte that has arrived says it is not, 1 while neither has.
function __crlf_at(buf: u8[], at: i32): i32 {
  let n: i32 = buf.len();
  if (at < n && buf[at] != 13 as u8) {
    return 0;
  }
  if (at + 1 < n && buf[at + 1] != 10 as u8) {
    return 0;
  }
  if (at + 2 > n) {
    return 1;
  }
  return 2;
}

// `__chunk_size_line(buf, at, budget, room)` — the chunk-size line at
// `at`: `(2, crlf, size)` once it has arrived whole, `(1, _, _)` while it
// has not; refused with 400 for no hex digit, anything but a chunk
// extension after the size (§7.1.1; an extension is skipped unread) or a
// bare CR or LF, 413 for a chunk larger than `room` (what the body cap
// has left, so the chunk could never fit), 431 for a line longer than
// the framing budget.
function __chunk_size_line(buf: u8[], at: i32, budget: i32, room: i32): (i32, i32, i32) {
  let n: i32 = buf.len();
  let limit: i32 = at + budget;
  if (limit > n) {
    limit = n;
  }
  let crlf: i32 = __find_crlf(buf, at, limit);
  let scanned: i32 = limit;
  if (crlf >= 0) {
    scanned = crlf;
  }
  if (!__crlf_terminated(buf, at, scanned)) {
    return (400, 0, 0);
  }
  if (crlf < 0) {
    if (n >= at + budget) {
      return (431, 0, 0);
    }
    return (1, 0, 0);
  }
  let size: (i32, i32, i32) = __chunk_size(buf, at, crlf, room);
  if (size.0 != 0) {
    return (size.0, 0, 0);
  }
  if (!__chunk_exts_ok(buf, size.2, crlf)) {
    return (400, 0, 0);
  }
  return (2, crlf, size.1);
}

// `__chunk_size(buf, at, end, room)` — the hex chunk size at `at`:
// `(0, size, next)` with `next` the offset past its digits, `(400, _, _)`
// with no digit, `(413, _, _)` for a size past `room`.
function __chunk_size(buf: u8[], at: i32, end: i32, room: i32): (i32, i32, i32) {
  let size: i32 = 0;
  let i: i32 = at;
  while (i < end && __hex_digit(buf[i]) >= 0) {
    let d: i32 = __hex_digit(buf[i]);
    if (size * 16 + d > room) {
      return (413, 0, i);
    }
    size = size * 16 + d;
    i = i + 1;
  }
  if (i == at) {
    return (400, 0, i);
  }
  return (0, size, i);
}

// `__chunk_exts_ok(buf, from, end)` — whether buf[from, end), what
// follows a chunk's size, is chunk extensions (RFC 9112 §7.1.1): each a
// `;`, a name token, and at most one `=` with a token or a quoted string
// for its value, with whitespace allowed only before a `;` and around an
// `=`, so none may trail the size or the last extension. Nothing reads an
// extension, so a well-formed one is skipped; an ill-formed one is refused
// rather than guessed at.
function __chunk_exts_ok(buf: u8[], from: i32, end: i32): boolean {
  let i: i32 = from;
  while (i < end) {
    let semi: i32 = __bws_end(buf, i, end);
    if (semi >= end || buf[semi] != 59 as u8) {
      return false;
    }
    i = __bws_end(buf, semi + 1, end);
    let name_end: i32 = __token_end(buf, i, end);
    if (name_end == i) {
      return false;
    }
    i = name_end;
    let eq: i32 = __bws_end(buf, name_end, end);
    if (eq < end && buf[eq] == 61 as u8) {
      i = __chunk_ext_val_end(buf, __bws_end(buf, eq + 1, end), end);
      if (i < 0) {
        return false;
      }
    }
  }
  return true;
}

// `__bws_end(buf, from, end)` — the offset past the SP and HTAB at `from`.
function __bws_end(buf: u8[], from: i32, end: i32): i32 {
  let i: i32 = from;
  while (i < end && __is_ows(buf[i])) {
    i = i + 1;
  }
  return i;
}

// `__token_end(buf, from, end)` — the offset past the tchars at `from`.
function __token_end(buf: u8[], from: i32, end: i32): i32 {
  let i: i32 = __scan_set_bytes(buf, from, NOT_TCHAR);
  if (i > end) {
    return end;
  }
  return i;
}

// `__chunk_ext_val_end(buf, from, end)` — the offset past a chunk
// extension's value at `from`, a token or a quoted string (RFC 9110
// §5.6.4: qdtext or a `\`-escaped byte, between two `"`), or -1 when
// neither is there whole.
function __chunk_ext_val_end(buf: u8[], from: i32, end: i32): i32 {
  if (from >= end) {
    return -1;
  }
  if (buf[from] != 34 as u8) {
    let tok: i32 = __token_end(buf, from, end);
    if (tok == from) {
      return -1;
    }
    return tok;
  }
  let i: i32 = from + 1;
  while (i < end) {
    let b: u8 = buf[i];
    if (b == 34 as u8) {
      return i + 1;
    }
    if (b == 92 as u8) {
      i = i + 1;
    }
    if (i >= end || !__is_quoted_byte(buf[i])) {
      return -1;
    }
    i = i + 1;
  }
  return -1;
}

// `__is_quoted_byte(b)` — a byte a quoted string may hold, as itself or
// after a `\`: HTAB, SP, a visible byte or obs-text.
function __is_quoted_byte(b: u8): boolean {
  return b == 9 as u8 || b >= 32 as u8 && b != 127 as u8;
}

// `__chunked_trailers(buf, at, budget, spans, fields)` — the trailer section that
// follows the last chunk's CRLF, at `at`, through the CRLF that ends it:
// `(2, end, spans, trailers)` with `end` past that CRLF, `(1, _, _, _)`
// while it has not arrived; refused with `__parse_header_bytes`'s status
// when a line breaks the header rules (the count cap included), 400 for
// a bare CR or LF, 431 when the section outgrows the framing budget. The
// fields are the request's `trailers`, kept apart from its headers:
// nothing here knows a trailer's semantics, so none may merge (RFC 9110
// §6.5.1).
function __chunked_trailers(buf: u8[], at: i32, budget: i32, spans: i32[], fields: i32): (i32, i32, i32[], HeaderMap) {
  let n: i32 = buf.len();
  let trailers: HeaderMap = headers.header_map_new();
  let limit: i32 = at + budget;
  if (limit > n) {
    limit = n;
  }
  // The last chunk's own CRLF, at `at - 2`, starts the CRLF CRLF when
  // there are no trailers.
  let sep: i32 = __find_crlf_crlf(buf, at - 2, limit);
  let scanned: i32 = limit;
  if (sep >= 0) {
    scanned = sep;
  }
  if (scanned > at && !__crlf_terminated(buf, at, scanned)) {
    return (400, 0, spans, trailers);
  }
  if (sep < 0) {
    if (n >= at + budget) {
      return (431, 0, spans, trailers);
    }
    return (1, 0, spans, trailers);
  }
  if (sep > at) {
    match (__parse_header_bytes(buf, at, sep, fields)) {
      Ok(h) => {
        trailers = h;
      },
      Err(status) => {
        return (status, 0, spans, trailers);
      }
    }
  }
  return (2, sep + 4, spans, trailers);
}

// `__chunked_body(buf, spans)` — the chunk data the walk recorded, as
// one array.
function __chunked_body(buf: u8[], spans: i32[]): u8[] {
  let total: i32 = 0;
  let k: i32 = 1;
  while (k < spans.len()) {
    total = total + spans[k];
    k = k + 2;
  }
  let out: u8[] = __alloc_u8(total);
  let o: i32 = 0;
  k = 0;
  while (k + 1 < spans.len()) {
    let start: i32 = spans[k];
    let i: i32 = 0;
    while (i < spans[k + 1]) {
      out = out.with(o + i, buf[start + i]);
      i = i + 1;
    }
    o = o + spans[k + 1];
    k = k + 2;
  }
  return out;
}

// `__framed_body(buf, at, framing, version)` — the body that starts at
// `at` under its framing: `(2, body, end, trailers)` with `end` past it,
// `(1, _, _, _)` while it has not arrived; refused with 413 for a
// declared length past the body cap (known before the body arrives),
// with `__chunked_walk`'s status for a chunked body that breaks its
// rules, and with 400 for chunked coding on a request that is not
// HTTP/1.1 (§6.1 gives the coding to HTTP/1.1; an older peer cannot have
// sent it, and reading its body as empty would be a framing
// disagreement). Only a chunked body has trailers.
function __framed_body(buf: u8[], at: i32, framing: __BodyFraming, version: string, limits: HttpLimits): (i32, u8[], i32, HeaderMap) {
  let empty: u8[] = [];
  let none: HeaderMap = headers.header_map_new();
  match (framing) {
    Length(content_length) => {
      if (content_length > limits.body) {
        return (413, empty, 0, none);
      }
      if (at + content_length > buf.len()) {
        return (1, empty, 0, none);
      }
      return (2, __bytes_range(buf, at, at + content_length), at + content_length, none);
    },
    Chunked => {
      if (version != "HTTP/1.1") {
        return (400, empty, 0, none);
      }
      let walk: (i32, i32, i32[], HeaderMap) = __chunked_walk(buf, at, limits);
      if (walk.0 != 2) {
        return (walk.0, empty, 0, none);
      }
      return (2, __chunked_body(buf, walk.2), walk.1, walk.3);
    }
  }
  return (400, empty, 0, none);
}

// ---- A chunked body decoded as it arrives ------------------------------
//
// `ChunkDecoder` — the chunked walk above, fed the body's bytes as they
// arrive and answering each chunk's data as soon as it is read, so a body
// that is streamed to a handler (docs/NET-P3-SUSPENSION-PLAN.md §3.9) is
// never held whole. Its rules are `__chunked_walk`'s, through the same
// helpers: the framing budget, the body cap, the extensions, the trailer
// section and every refusal, so feeding a body in any split answers what
// the walk answers for the whole. `state` is what the next byte belongs
// to: 0 a chunk-size line, 1 chunk data with `left` bytes to come, 2 the
// CRLF after a chunk's data, 3 the trailer section, 4 done; `held` is the
// framing not yet complete, kept until it is.
pub struct ChunkDecoder { state: i32, held: u8[], left: i32, budget: i32, room: i32, fields: i32, trailers: HeaderMap }

// `ChunkStep` — what a feed answers: `ChunkData(next, data)`, the data
// decoded from this feed (none when the feed held framing alone) and the
// decoder to feed next; `ChunkEnd(data, trailers, rest)` once the body is
// complete, with the trailer section's fields and the bytes past its end,
// the next request's; `ChunkRefused(status)` with the walk's status (400
// malformed framing, 413 a body past its cap, 431 framing or trailers
// past their budget).
pub enum ChunkStep { ChunkData(ChunkDecoder, u8[]), ChunkEnd(u8[], HeaderMap, u8[]), ChunkRefused(i32) }

// `chunk_decoder(limits)` — a decoder at the start of a chunked body under
// `limits`.
pub function chunk_decoder(limits: HttpLimits): ChunkDecoder {
  let none: u8[] = [];
  return ChunkDecoder { state: 0, held: none, left: 0, budget: limits.header_bytes, room: limits.body, fields: limits.header_fields, trailers: headers.header_map_new() };
}

// `(d: ChunkDecoder).feed(bytes)` — the body's next bytes decoded.
pub function (d: ChunkDecoder) feed(bytes: u8[]): ChunkStep {
  let buf: u8[] = bytes;
  if (d.held.len() > 0) {
    buf = d.held.concat(bytes);
  }
  let none: u8[] = [];
  let cur: ChunkDecoder = ChunkDecoder { ...d, held: none };
  let out: u8[] = [];
  let at: i32 = 0;
  while (true) {
    let step: (i32, ChunkDecoder, i32, u8[]) = __chunk_step(cur, buf, at, out);
    cur = step.1;
    at = step.2;
    out = step.3;
    if (step.0 == 1) {
      return ChunkData(ChunkDecoder { ...cur, held: __bytes_range(buf, at, buf.len()) }, out);
    }
    if (step.0 == 2) {
      return ChunkEnd(out, cur.trailers, __bytes_range(buf, at, buf.len()));
    }
    if (step.0 >= 400) {
      return ChunkRefused(step.0);
    }
  }
  return ChunkRefused(400);
}

// `__chunk_step(d, buf, at, out)` — one state's share of `buf` from `at`:
// `(0, next, at, out)` to go on from `at` in the next state, `(1, ...)`
// when more bytes are needed first, `(2, ...)` with `at` past the body's
// end, or the refusing status.
function __chunk_step(d: ChunkDecoder, buf: u8[], at: i32, out: u8[]): (i32, ChunkDecoder, i32, u8[]) {
  if (d.state == 1) {
    return __chunk_data_step(d, buf, at, out);
  }
  if (d.state == 2) {
    let crlf: i32 = __crlf_at(buf, at);
    if (crlf == 0) {
      return (400, d, at, out);
    }
    if (crlf == 1) {
      return (1, d, at, out);
    }
    return (0, ChunkDecoder { ...d, state: 0 }, at + 2, out);
  }
  if (d.state == 0) {
    return __chunk_size_step(d, buf, at, out);
  }
  if (d.state == 3) {
    return __chunk_trailers_step(d, buf, at, out);
  }
  return (2, d, at, out);
}

// The chunk's data, as much of it as `buf` holds, passed on.
function __chunk_data_step(d: ChunkDecoder, buf: u8[], at: i32, out: u8[]): (i32, ChunkDecoder, i32, u8[]) {
  let take: i32 = d.left;
  if (take > buf.len() - at) {
    take = buf.len() - at;
  }
  let passed: u8[] = out.concat(__bytes_range(buf, at, at + take));
  let next: ChunkDecoder = ChunkDecoder { ...d, left: d.left - take };
  if (next.left > 0) {
    return (1, next, at + take, passed);
  }
  return (0, ChunkDecoder { ...next, state: 2 }, at + take, passed);
}

// The chunk-size line at `at`, as the walk reads it: the budget charged
// for the line and the chunk's CRLF, the body cap for its size; the last
// chunk's line hands over to the trailer section, from its own CRLF, as
// the walk does.
function __chunk_size_step(d: ChunkDecoder, buf: u8[], at: i32, out: u8[]): (i32, ChunkDecoder, i32, u8[]) {
  let line: (i32, i32, i32) = __chunk_size_line(buf, at, d.budget, d.room);
  if (line.0 != 2) {
    return (line.0, d, at, out);
  }
  let data: i32 = line.1 + 2;
  let size: i32 = line.2;
  let budget: i32 = d.budget - (data - at) - 2;
  if (budget < 0) {
    return (431, d, at, out);
  }
  if (size == 0) {
    return (0, ChunkDecoder { ...d, state: 3, budget: budget }, data - 2, out);
  }
  return (0, ChunkDecoder { ...d, state: 1, left: size, budget: budget, room: d.room - size }, data, out);
}

// The trailer section, `buf[at]` the last chunk's own CRLF.
function __chunk_trailers_step(d: ChunkDecoder, buf: u8[], at: i32, out: u8[]): (i32, ChunkDecoder, i32, u8[]) {
  let none: i32[] = [];
  let t: (i32, i32, i32[], HeaderMap) = __chunked_trailers(buf, at + 2, d.budget + 2, none, d.fields);
  if (t.0 != 2) {
    return (t.0, d, at, out);
  }
  return (2, ChunkDecoder { ...d, state: 4, trailers: t.3 }, t.1, out);
}

// `http_parse_request_bytes(buf)` parses a full HTTP/1.1 request
// out of the bytes the caller has read from the wire, as they
// came: no text bridge. The caller accumulates bytes via
// `tcp_recv_into` until the buffer holds at least the header
// block (terminated by `\r\n\r\n`) plus Content-Length bytes
// of body — the parser returns None on a partial buffer rather
// than blocking, so callers driving the read loop keep reading
// until the parse succeeds (or a hard cap fires).
//
// A malformed request and a partial one both surface as None here;
// `http_parse_request_framed` tells them apart for a loop that must
// close on the first and keep reading on the second.
//
// What the request keeps are owned copies — the method, the
// path, each header's name and value, the body — so the wire
// buffer is the connection's to reuse once this returns.
pub function http_parse_request_bytes(buf: u8[]): Option[HttpRequest] {
  match (http_parse_request_framed(buf)) {
    Framed(f) => {
      return Some(f.request);
    },
    Incomplete => {
      return None;
    },
    Continue => {
      return None;
    },
    Malformed(_) => {
      return None;
    }
  }
  return None;
}

// HttpFramed — a parsed request with its framing: `len` is the bytes it
// occupies at the head of the buffer, so a serve loop can drop them and
// look for the next pipelined request, and `keep_alive` is whether the
// connection persists after its response (RFC 9112 §9.3: HTTP/1.1 unless
// the request says `Connection: close`; HTTP/1.0 only when it says
// `Connection: keep-alive`).
pub struct HttpFramed { request: HttpRequest, len: i32, keep_alive: boolean, version: string }

// HttpFraming — what a buffer holds at an offset: a complete request with
// its framing; less than one (the loop keeps reading); less than one
// whose header block has arrived and says `Expect: 100-continue`, so the
// loop sends `100 Continue` once and then keeps reading (RFC 9110
// §10.1.1; a request whose body has already arrived is `Framed` and
// gets no interim response); or a malformed one, carrying the status
// the loop answers it with before closing the connection: 400 for a
// request the grammar refuses (RFC 9112 §2.2, §3, §5, §6.3, §7.1) or
// that breaks the `Host` rule (§3.2), 413 for a body past its cap, 414
// for a request line past its cap, 417 for an expectation other than
// `100-continue`, 431 for a header block past its byte or field cap or
// chunk framing past its budget, 501 for a transfer coding this parser
// cannot decode. There is no lenient mode, and a request past a cap is
// malformed as soon as the cap is passed, before its end has arrived.
pub enum HttpFraming { Framed(HttpFramed), Incomplete, Continue, Malformed(i32) }

// `__expectation(h)` — what the `Expect` field asks (RFC 9110 §10.1.1):
// 0 with none, 1 for `100-continue`, 417 for anything else, which this
// server cannot meet.
function __expectation(h: HeaderMap): i32 {
  let at: i32 = __field_at(h, "expect", 0);
  if (at < 0) {
    return 0;
  }
  while (at >= 0) {
    if (!__token_is(h.values[at], "100-continue")) {
      return 417;
    }
    at = __field_at(h, "expect", at + 1);
  }
  return 1;
}

// `__header_rules(h, version)` — the status that refuses a parsed header
// block on its own terms, or 0: 400 for the `Host` rule, 417 for an
// expectation the server cannot meet.
function __header_rules(h: HeaderMap, version: string): i32 {
  if (!__host_ok(h, version)) {
    return 400;
  }
  if (__expectation(h) == 417) {
    return 417;
  }
  return 0;
}

// `__unframed(kind, h, version)` — the answer for a body that has not
// framed: `Malformed` with `kind` when it is a status, `Continue` when an
// HTTP/1.1 request expects `100 Continue` before sending its body,
// `Incomplete` otherwise. An HTTP/1.0 request's `100-continue` is
// ignored (RFC 9110 §10.1.1): its client cannot read the interim answer.
function __unframed(kind: i32, h: HeaderMap, version: string): HttpFraming {
  if (kind >= 400) {
    return HttpFraming.Malformed(kind);
  }
  if (version != "HTTP/1.0" && __expectation(h) == 1) {
    return Continue;
  }
  return Incomplete;
}

// `__request_line(buf, from, end)` — the request line buf[from, end)
// read: `(0, sp1, sp2, path)` with the offsets of its two spaces and the
// path `http_request_target` gives, or `(status, _, _, _)` refusing it:
// 400 for a method that is not a token, a missing space, an empty
// target or a version that is not an HTTP-version, 505 for another
// major version, and the target's own refusals.
function __request_line(buf: u8[], from: i32, end: i32): (i32, i32, i32, string) {
  let sp1: i32 = __find_byte(buf, from, end, 32 as u8);
  if (sp1 < 0 || !__is_token(buf, from, sp1)) {
    return (400, -1, -1, "");
  }
  let sp2: i32 = __find_byte(buf, sp1 + 1, end, 32 as u8);
  if (sp2 < 0 || sp2 == sp1 + 1) {
    return (400, -1, -1, "");
  }
  let version_status: i32 = __version_status(buf, sp2 + 1, end);
  if (version_status != 0) {
    return (version_status, -1, -1, "");
  }
  match (http_request_target(__bytes_string(buf, from, sp1), __bytes_string(buf, sp1 + 1, sp2))) {
    Ok(p) => {
      return (0, sp1, sp2, p);
    },
    Err(status) => {
      return (status, -1, -1, "");
    }
  }
  return (400, -1, -1, "");
}

// `http_parse_request_framed(buf)` — `http_parse_request_bytes` with the
// framing a persistent connection needs, and the three-way answer, under
// `http_limits()`.
pub function http_parse_request_framed(buf: u8[]): HttpFraming {
  return http_parse_request_framed_from(buf, 0, http_limits());
}

// `http_parse_request_framed_from(buf, from, limits)` — the same parse
// over buf[from, len) under `limits`: the request behind the ones a serve
// loop has already answered, without copying the rest of the buffer
// forward. `len` counts from `from`.
pub function http_parse_request_framed_from(buf: u8[], from: i32, limits: HttpLimits): HttpFraming {
  match (__request_head(buf, from, limits)) {
    Ok(head) => {
      let body: (i32, u8[], i32, HeaderMap) = __framed_body(buf, from + head.len, head.framing, head.version, limits);
      if (body.0 != 2) {
        return __unframed(body.0, head.headers, head.version);
      }
      let req: HttpRequest = HttpRequest { method: head.method, path: head.path, body: stream.stream_from_bytes(body.1), headers: head.headers, trailers: body.3 };
      return Framed(HttpFramed { request: req, len: body.2 - from, keep_alive: head.keep_alive, version: head.version });
    },
    Err(status) => {
      if (status == 1) {
        return Incomplete;
      }
      return HttpFraming.Malformed(status);
    }
  }
  return Incomplete;
}

// `HttpHead` — a request whose header block has arrived, its body not
// read: the request with an empty body, the bytes its request line and
// header block occupy from where the parse started, its persistence and
// version, its body's declared length (-1 for a chunked body), and
// whether it expects `100 Continue` before sending the body. What a
// serve loop streaming request bodies starts a handler on
// (docs/NET-P3-SUSPENSION-PLAN.md §3.9).
pub struct HttpHead { request: HttpRequest, len: i32, keep_alive: boolean, version: string, length: i32, expects_continue: boolean }

// `HttpHeading` — what a buffer holds at an offset, read to the end of
// the header block: a head; less than one; or a malformed one, carrying
// the status that refuses it as `HttpFraming.Malformed` does, 413 for a
// declared length past the body cap included, since that is known before
// the body arrives.
pub enum HttpHeading { Headed(HttpHead), HeadIncomplete, HeadMalformed(i32) }

// `http_parse_request_head_from(buf, from, limits)` — the request head at
// `from`, under `limits`.
pub function http_parse_request_head_from(buf: u8[], from: i32, limits: HttpLimits): HttpHeading {
  match (__request_head(buf, from, limits)) {
    Ok(head) => {
      let length: i32 = __declared(head.framing);
      if (length > limits.body) {
        return HeadMalformed(413);
      }
      if (length < 0 && head.version != "HTTP/1.1") {
        return HeadMalformed(400);
      }
      let empty: u8[] = [];
      let req: HttpRequest = HttpRequest { method: head.method, path: head.path, body: stream.stream_from_bytes(empty), headers: head.headers, trailers: headers.header_map_new() };
      let expects: boolean = head.version != "HTTP/1.0" && __expectation(head.headers) == 1;
      return Headed(HttpHead { request: req, len: head.len, keep_alive: head.keep_alive, version: head.version, length: length, expects_continue: expects });
    },
    Err(status) => {
      if (status == 1) {
        return HeadIncomplete;
      }
      return HeadMalformed(status);
    }
  }
  return HeadIncomplete;
}

// `__Head` — a request head as parsed, before either public shape is
// built from it: the method and path, the headers, the version, the
// bytes the head occupies from where the parse started, its persistence
// and its body framing.
struct __Head { method: string, path: string, headers: HeaderMap, version: string, len: i32, keep_alive: boolean, framing: __BodyFraming }

// `__request_head(buf, from, limits)` — the request line and header block
// at `from`, read and checked (the request line's rules, the header
// rules, the body framing's): `Err(1)` while less than the block has
// arrived, `Err(status)` refusing it.
function __request_head(buf: u8[], from: i32, limits: HttpLimits): Result[__Head, i32] {
  let start: i32 = from;
  from = __past_empty_line(buf, from);
  let first_crlf: i32 = __request_line_end(buf, from, limits.request_line);
  let headers_end: i32 = __header_block_end(buf, from, limits.header_bytes);
  let bounded: i32 = __head_bounded(buf, from, limits, first_crlf, headers_end);
  if (bounded != 0) {
    return Err(bounded);
  }
  // The request line (RFC 9112 §3): a method token, a space, a
  // request-target, a space, an HTTP-version. It is refused as soon as
  // its CRLF has arrived, before the rest of the block.
  let line: (i32, i32, i32, string) = (0, -1, -1, "");
  if (first_crlf >= 0) {
    line = __request_line(buf, from, first_crlf);
    if (line.0 != 0) {
      return Err(line.0);
    }
  }
  let sp1: i32 = line.1;
  let sp2: i32 = line.2;
  let path: string = line.3;
  if (first_crlf < 0 || headers_end < 0) {
    return Err(1);
  }
  let headers_len: i32 = headers_end + 4 - from;
  // Parse the header block into a HeaderMap *first*, then derive
  // Content-Length from it. `first_crlf + 2` skips the CRLF that
  // terminates the request line; `headers_end` is the start of the
  // `\r\n\r\n` separator, so the block excludes the empty line.
  //
  // The two coincide exactly when the request carried no headers at
  // all (`GET / HTTP/1.0\r\n\r\n`): the request line's own CRLF is
  // the first two bytes of the separator. Clamping is what keeps the
  // block from running backwards there.
  let hdr_start: i32 = first_crlf + 2;
  if (hdr_start > headers_end) {
    hdr_start = headers_end;
  }
  let req_headers: HeaderMap = headers.header_map_new();
  match (__parse_header_bytes(buf, hdr_start, headers_end, limits.header_fields)) {
    Ok(h) => {
      req_headers = h;
    },
    Err(status) => {
      return Err(status);
    }
  }
  let version: string = __version_of(buf, sp2 + 1);
  let refused: i32 = __header_rules(req_headers, version);
  if (refused > 0) {
    return Err(refused);
  }
  let framing: __BodyFraming = Length(0);
  match (__http_body_framing(req_headers)) {
    Ok(f) => {
      framing = f;
    },
    Err(status) => {
      return Err(status);
    }
  }
  return Ok(__Head { method: __bytes_string(buf, from, sp1), path: path, headers: req_headers, version: version, len: from + headers_len - start, keep_alive: __persists(version, req_headers), framing: framing });
}

// `__head_bounded(buf, from, limits, first_crlf, headers_end)` — 0 when
// the request line and header block at `from` are within their limits so
// far, `first_crlf` and `headers_end` where each ends (-1 while it has not
// arrived, -2 past its cap); else the status refusing them: 414 for a
// request line past its cap, 431 for a header block past its, 400 for a
// bare CR or LF in what is buffered of the block (the bytes before `from`
// are answered requests, the bytes after the block a body, which may hold
// anything).
function __head_bounded(buf: u8[], from: i32, limits: HttpLimits, first_crlf: i32, headers_end: i32): i32 {
  if (first_crlf == -2) {
    return 414;
  }
  if (headers_end == -2) {
    return 431;
  }
  let n: i32 = buf.len();
  let scanned: i32 = headers_end;
  if (scanned < 0) {
    scanned = from + limits.header_bytes + 4;
    if (n < scanned) {
      scanned = n;
    }
  }
  if (!__crlf_terminated(buf, from, scanned)) {
    return 400;
  }
  return 0;
}

// `__declared(f)` — a body framing as its declared length, -1 for chunked.
function __declared(f: __BodyFraming): i32 {
  match (f) {
    Length(n) => {
      return n;
    },
    Chunked => {
      return 0 - 1;
    }
  }
  return 0 - 1;
}

// `http_request_target(method, target)` — the request-target (RFC 9112
// §3.2) as the path a handler sees, or the status refusing it. An
// origin-form target (`/a/b?q`) and an absolute-form one
// (`http://host/a/b?q`, which a server accepts from any client, §3.2.2)
// give the path decoded once and with its dot segments removed
// (RFC 3986 §5.2.4), then the query as it came; the asterisk-form `*` is
// only for OPTIONS (§3.2.4). Refused with 400: a target that is none of
// the three, an authority-form target (nothing here tunnels), an empty
// authority, a byte outside `pchar` and `/` in the path or `pchar`, `/`
// and `?` in the query, a `%` not followed by two hex digits, a decoded
// NUL, a decoded slash (`%2F` would make a segment the sender hid from
// the path's grammar), and a path that climbs above the root (`/../x`:
// a client resolves that before sending, so a server only sees it from
// something else). The query is not decoded: its encoding depends on
// what reads it (`form_decode` folds `+`, `url_decode` does not).
pub function http_request_target(method: string, target: string): Result[string, i32] {
  if (target == "*") {
    if (method == "OPTIONS") {
      return Ok("*");
    }
    return Err(400);
  }
  let path_from: i32 = 0;
  if (target.len() == 0 || target[0] != 47 as u8) {
    path_from = __absolute_form_path(target);
    if (path_from < 0) {
      return Err(400);
    }
  }
  let q: i32 = __find_char(target, path_from, target.len(), 63 as u8);
  if (q >= 0 && !__query_ok(target, q + 1, target.len())) {
    return Err(400);
  }
  let path_end: i32 = target.len();
  if (q >= 0) {
    path_end = q;
  }
  match (__decoded_path(target, path_from, path_end)) {
    Ok(p) => {
      if (q < 0) {
        return Ok(p);
      }
      return Ok(p + slice_unchecked(target, q, target.len()) + "");
    },
    Err(status) => {
      return Err(status);
    }
  }
  return Err(400);
}

// `__absolute_form_path(target)` — where the path of an absolute-form
// target starts: past `http://` or `https://` in any case and a
// non-empty authority, at the `/` or `?` that ends it, or the target's
// end when it has no path. -1 for any other shape.
function __absolute_form_path(target: string): i32 {
  let n: i32 = target.len();
  let at: i32 = -1;
  if (__prefix_ci(target, "http://")) {
    at = 7;
  }
  if (__prefix_ci(target, "https://")) {
    at = 8;
  }
  if (at < 0) {
    return -1;
  }
  let authority_end: i32 = at;
  while (authority_end < n && target[authority_end] != 47 as u8 && target[authority_end] != 63 as u8) {
    if (!__is_pchar(target[authority_end])) {
      return -1;
    }
    authority_end = authority_end + 1;
  }
  if (authority_end == at) {
    return -1;
  }
  return authority_end;
}

// `__prefix_ci(s, want)` — whether `s` starts with `want` under an ASCII
// fold; `want` is written in lower case.
function __prefix_ci(s: string, want: string): boolean {
  if (s.len() < want.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < want.len()) {
    if (__ascii_lower(s[i]) != want[i] as i32) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// `__find_char(s, from, end, c)` — the first index of byte `c` in
// s[from, end), or -1.
function __find_char(s: string, from: i32, end: i32, c: u8): i32 {
  let i: i32 = from;
  while (i < end) {
    if (s[i] == c) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

// `__is_pchar(b)` — a byte a path segment may carry as itself (RFC 3986
// §3.3): unreserved, a sub-delim, `:` or `@`; `%` is admitted here and
// judged with its two digits where it is read.
function __is_pchar(b: u8): boolean {
  let v: i32 = b as i32;
  return __is_unreserved(v) || __is_sub_delim(v) || v == 58 || v == 64 || v == 37;
}

function __is_unreserved(b: i32): boolean {
  return b >= 97 && b <= 122 || b >= 65 && b <= 90 || b >= 48 && b <= 57
    || b == 45 || b == 46 || b == 95 || b == 126;
}

function __is_sub_delim(b: i32): boolean {
  let delims: string = "!$&'()*+,;=";
  let i: i32 = 0;
  while (i < delims.len()) {
    if (delims[i] as i32 == b) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// `__query_ok(s, from, end)` — whether s[from, end) is a query (RFC 3986
// §3.4): `pchar`, `/` and `?`, every `%` followed by two hex digits.
function __query_ok(s: string, from: i32, end: i32): boolean {
  let i: i32 = from;
  while (i < end) {
    let b: u8 = s[i];
    if (b == 37 as u8) {
      if (__pct_byte(s, i, end) < 0) {
        return false;
      }
      i = i + 3;
    } else {
      if (!__is_pchar(b) && b != 47 as u8 && b != 63 as u8) {
        return false;
      }
      i = i + 1;
    }
  }
  return true;
}

// `__pct_byte(s, at, end)` — the byte a `%XX` at `at` encodes, or -1 when
// the two hex digits are not there.
function __pct_byte(s: string, at: i32, end: i32): i32 {
  if (at + 2 >= end) {
    return -1;
  }
  let hi: i32 = __hex_digit(s[at + 1]);
  let lo: i32 = __hex_digit(s[at + 2]);
  if (hi < 0 || lo < 0) {
    return -1;
  }
  return hi * 16 + lo;
}

// `__decoded_path(s, from, end)` — s[from, end), which starts with `/`,
// decoded once and with its dot segments removed, or the status refusing
// it: a byte the grammar does not admit, an escape of `/` or NUL, dot
// segments climbing above the root, or escapes that decode to ill-formed
// UTF-8.
function __decoded_path(s: string, from: i32, end: i32): Result[string, i32] {
  if (end <= from) {
    return Ok("/");
  }
  let out: u8[] = [];
  let i: i32 = from;
  while (i < end) {
    let b: i32 = s[i] as i32;
    if (b == 37) {
      b = __pct_byte(s, i, end);
      if (b <= 0 || b == 47) {
        return Err(400);
      }
      i = i + 3;
    } else {
      if (!__is_pchar(b as u8) && b != 47) {
        return Err(400);
      }
      i = i + 1;
    }
    out = out.append(b as u8);
  }
  // Only an escape can put a non-ASCII byte here (`__is_pchar` refuses a
  // raw one), and a sequence of them has to spell UTF-8 (RFC 3987 §3.1).
  if (!utf8.is_valid_utf8(string_from_bytes_unchecked(out))) {
    return Err(400);
  }
  return __without_dot_segments(out);
}

// `__without_dot_segments(path)` — RFC 3986 §5.2.4 over a path that
// starts with `/`: a `.` segment is dropped, a `..` segment takes the
// one before it with it, and either at the end keeps the trailing
// slash. A `..` with nothing before it climbs above the root and is
// refused. Empty segments (`a//b`) are kept: they are the sender's to
// mean something by.
function __without_dot_segments(path: u8[]): Result[string, i32] {
  let segments: string[] = [];
  let depth: i32 = 0;
  let n: i32 = path.len();
  let at: i32 = 1;
  let trailing: boolean = false;
  while (at <= n) {
    let seg_end: i32 = at;
    while (seg_end < n && path[seg_end] != 47 as u8) {
      seg_end = seg_end + 1;
    }
    let seg: string = __bytes_string(path, at, seg_end);
    trailing = seg_end == n;
    if (seg == "..") {
      if (depth == 0) {
        return Err(400);
      }
      depth = depth - 1;
    } else if (seg != ".") {
      segments = __set_segment(segments, depth, seg);
      depth = depth + 1;
      trailing = false;
    }
    at = seg_end + 1;
  }
  return Ok(__joined_segments(segments, depth, trailing));
}

// `__set_segment(segments, at, seg)` — `segments` with `seg` at index
// `at`, which is at most its length: a `..` lowers `depth` without
// shrinking the array, so a later segment overwrites what it dropped.
function __set_segment(segments: string[], at: i32, seg: string): string[] {
  if (at < segments.len()) {
    return segments.with(at, seg);
  }
  return segments.append(seg);
}

// `__joined_segments(segments, depth, trailing)` — `/` before each of
// the first `depth` segments, and a `/` after the last when the path
// ended in a dot segment; the root when there are none.
function __joined_segments(segments: string[], depth: i32, trailing: boolean): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < depth) {
    out = out + "/" + segments[i];
    i = i + 1;
  }
  if (out.len() == 0 || trailing) {
    out = out + "/";
  }
  return out;
}

// `__past_empty_line(buf, from)` — `from` past one CRLF at it: a server
// ignores at least one empty line before a request-line (RFC 9112 §2.2),
// since a client may send one after a body. A second is the request
// line's to refuse.
function __past_empty_line(buf: u8[], from: i32): i32 {
  if (from + 1 < buf.len() && buf[from] == 13 as u8 && buf[from + 1] == 10 as u8) {
    return from + 2;
  }
  return from;
}

// `__version_status(buf, from, end)` — 0 when buf[from, end) is an
// HTTP-version (RFC 9112 §2.3: `HTTP/`, a digit, `.`, a digit, in that
// case), 400 when it is not, 505 for a major version other than 1: this
// parser speaks HTTP/1, and cannot promise to read the framing of another
// major version (RFC 9110 §15.6.6).
function __version_status(buf: u8[], from: i32, end: i32): i32 {
  if (end - from != 8 || !__bytes_are(buf, from, "HTTP/")) {
    return 400;
  }
  if (!__is_digit(buf[from + 5]) || buf[from + 6] != 46 as u8 || !__is_digit(buf[from + 7])) {
    return 400;
  }
  if (buf[from + 5] != 49 as u8) {
    return 505;
  }
  return 0;
}

// `__version_of(buf, from)` — the version the rules read, for a version
// `__version_status` passed: `HTTP/1.0` for itself, and every other minor
// as `HTTP/1.1`, the highest this parser knows (§2.3).
function __version_of(buf: u8[], from: i32): string {
  if (buf[from + 7] == 48 as u8) {
    return "HTTP/1.0";
  }
  return "HTTP/1.1";
}

function __is_digit(b: u8): boolean {
  return b >= 48 as u8 && b <= 57 as u8;
}

// `__bytes_are(buf, from, want)` — whether the bytes at `from` start with
// `want`.
function __bytes_are(buf: u8[], from: i32, want: string): boolean {
  if (from + want.len() > buf.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < want.len()) {
    if (buf[from + i] != want[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// __persists(version, h) — whether the connection outlives this
// request: a `Connection` header carrying `close` ends an HTTP/1.1
// connection where one carrying `keep-alive` extends an HTTP/1.0 one.
// The header is a comma-separated token list, and only a whole token
// counts: `x-close` neither closes nor keeps. `version` is one of the two
// `__version_of` gives.
function __persists(version: string, h: HeaderMap): boolean {
  let close: boolean = false;
  let keep: boolean = false;
  let at: i32 = __field_at(h, "connection", 0);
  while (at >= 0) {
    for tok in h.values[at].split(",") {
      if (__token_is(tok, "close")) {
        close = true;
      }
      if (__token_is(tok, "keep-alive")) {
        keep = true;
      }
    }
    at = __field_at(h, "connection", at + 1);
  }
  if (close) {
    return false;
  }
  if (version == "HTTP/1.0") {
    return keep;
  }
  return true;
}

// `http_parse_request(buf)` — the same parse over a request held as
// text: a test's literal, a block already in a string. It costs one
// copy of the bytes; a serve loop holds its buffer as `u8[]` and calls
// `http_parse_request_bytes`.
pub function http_parse_request(buf: string): Option[HttpRequest] {
  return http_parse_request_bytes(buf.bytes());
}

// Reason phrase for the status line. Delegates to the public
// `http_status_text` table (the single source of truth) rather
// than keeping a second, narrower copy that drifted out of sync:
// the old duplicate only knew 13 codes, so a 307 / 429 / 502
// response serialized with the bogus phrase "Status" even though
// `http_status_text` spelled it correctly. Unknown codes still
// fall back to a generic phrase — the kernel doesn't care and
// clients display the numeric code regardless.
function __http_reason(code: i32): string {
  let text: string = http_status_text(code);
  if (text.len() == 0) {
    return "Status";
  }
  return text;
}

// `http_serialize_response(resp)` builds the wire-format
// response from an HttpResponse, advertising `Connection: close`
// so the client's `read()` returns the EOF that tells it the
// response is complete after the caller's `tcp_send` finishes the
// write. No chunked TE. This text form decodes byte bodies with replacement;
// use http_serialize_response_bytes to preserve a binary body.
pub function http_serialize_response(resp: HttpResponse): string {
  return http_serialize_response_conn(resp, false);
}

// `http_serialize_response_conn(resp, keep_alive)` — the response as
// a serve loop sends it to a GET: `Connection: keep-alive` when the
// connection persists for the next request, `Connection: close` when
// this response ends it. Every response carries the header, so an
// HTTP/1.0 client that asked to keep the connection learns that it was
// kept.
pub function http_serialize_response_conn(resp: HttpResponse, keep_alive: boolean): string {
  return http_serialize_response_to("GET", resp, keep_alive);
}

// `http_serialize_response_to(method, resp, keep_alive)` — the response
// as a serve loop sends it to a request made with `method` (RFC 9112
// §6.3): a response to HEAD carries the `Content-Length` its body would
// have and none of the body, and a 1xx, 204 or 304 response carries
// neither, whatever the handler put in the body. Every other response
// carries `Content-Length` and the body.
pub function http_serialize_response_to(method: string, resp: HttpResponse, keep_alive: boolean): string {
  let bodiless: boolean = http_bodiless(resp.status);
  let framing: string = "";
  let body: string = "";
  if (!bodiless) {
    body = resp.body_string();
    framing = "Content-Length: " + int.int_to_string(body.len()) + "\r\n";
  }
  let head: string = http_serialize_response_head(resp, keep_alive, framing);
  if (bodiless || method == "HEAD") {
    return head;
  }
  return head + body;
}

// Byte-domain counterparts of the text serializers above. The body is read
// once, including a chunk producer, and Content-Length counts those bytes.
// A file body must first be materialized, as for the text form.
pub function http_serialize_response_bytes(resp: HttpResponse): u8[] {
  return http_serialize_response_conn_bytes(resp, false);
}

pub function http_serialize_response_conn_bytes(resp: HttpResponse, keep_alive: boolean): u8[] {
  return http_serialize_response_to_bytes("GET", resp, keep_alive);
}

pub function http_serialize_response_to_bytes(method: string, resp: HttpResponse, keep_alive: boolean): u8[] {
  if (http_bodiless(resp.status)) {
    let bare: usize = buf_new(256);
    __push_head(bare, resp);
    __push_close(bare, keep_alive);
    return __take_wire(bare);
  }
  if (method == "HEAD") {
    let head: usize = buf_new(256);
    __push_head(head, resp);
    __push_length(head, resp.body_len());
    __push_close(head, keep_alive);
    return __take_wire(head);
  }
  let text: string = "";
  let body: u8[] = [];
  match (resp.body) {
    BodyText(s) => {
      text = s;
    },
    _ => {
      body = resp.body_bytes();
    }
  }
  let len: i32 = text.len() + body.len();
  let cap: i32 = len;
  if (len <= 2147483647 - 256) {
    cap = len + 256;
  }
  let builder: usize = buf_new(cap);
  __push_head(builder, resp);
  __push_length(builder, len);
  __push_close(builder, keep_alive);
  assert(len <= 2147483647 - buf_len(builder));
  buf_push(builder, text);
  buf_push_bytes_range(builder, body, 0, body.len());
  return __take_wire(builder);
}

// `http_bodiless(status)` — whether a response with `status` carries no
// body whatever the request: 1xx, 204 and 304 (RFC 9112 §6.3).
pub function http_bodiless(status: i32): boolean {
  return status < 200 || status == 204 || status == 304;
}

// `http_serialize_response_head(resp, keep_alive, framing)` — the
// status line and header block of `resp`, ending in the blank line:
// the handler's headers but `Content-Length`, `Transfer-Encoding` and
// `Connection`, which the caller's `framing` (a `Content-Length` or
// `Transfer-Encoding` line, or none for a close-delimited or bodiless
// response) and `keep_alive` decide. The serve loop writes a streamed
// body behind this head.
// `http_serialize_fields(fields)` — the map as field lines, `name: value`
// and CRLF each, in the map's order: a trailer section's body.
pub function http_serialize_fields(fields: HeaderMap): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < fields.names.len()) {
    out = out + fields.names[i] + ": " + fields.values[i] + "\r\n";
    i = i + 1;
  }
  return out;
}

pub function http_serialize_response_head(resp: HttpResponse, keep_alive: boolean, framing: string): string {
  let b: usize = buf_new(256);
  __push_head(b, resp);
  buf_push(b, framing);
  __push_close(b, keep_alive);
  let head: string = buf_take(b);
  buf_free(b);
  return head;
}

// `__push_head(b, resp)` — the status line and the handler's fields into
// the builder `b`, all but `Content-Length`, `Connection` and
// `Transfer-Encoding`, which the framing writes.
function __push_head(b: usize, resp: HttpResponse): void {
  buf_push(b, "HTTP/1.1 ");
  io_buffered.buf_push_i64(b, resp.status as i64);
  buf_push(b, " ");
  buf_push(b, __http_reason(resp.status));
  buf_push(b, "\r\n");
  let i: i32 = 0;
  while (i < resp.headers.names.len()) {
    let hname: string = resp.headers.names[i];
    if (!hname.eq_ignore_ascii_case("content-length") && !hname.eq_ignore_ascii_case("connection") && !hname.eq_ignore_ascii_case("transfer-encoding")) {
      buf_push(b, hname);
      buf_push(b, ": ");
      buf_push(b, resp.headers.values[i]);
      buf_push(b, "\r\n");
    }
    i = i + 1;
  }
}

function __push_length(b: usize, len: i32): void {
  buf_push(b, "Content-Length: ");
  io_buffered.buf_push_i64(b, len as i64);
  buf_push(b, "\r\n");
}

// `__push_close(b, keep_alive)` — the `Connection` field and the blank
// line that ends the head.
function __push_close(b: usize, keep_alive: boolean): void {
  if (keep_alive) {
    buf_push(b, "Connection: keep-alive\r\n\r\n");
    return;
  }
  buf_push(b, "Connection: close\r\n\r\n");
}

function __take_wire(b: usize): u8[] {
  let wire: u8[] = buf_take_bytes(b);
  buf_free(b);
  return wire;
}

// ============================================================
// HttpRequest.body whole-body readers.
//
// The field is a `Stream` (docs/PLATFORM-RESEARCH.md Rec §4):
// a handler that wants the body incrementally takes
// `req.body_stream()` and drives std/stream's cursor methods
// (`read_n`, `read_line`, `read_all`), rebinding the returned
// Stream each step. The three readers here are the
// whole-body shortcuts for handlers that do not care —
// each reads the backing buffer directly rather than the
// cursor, so they answer the same thing however far a
// separate `body_stream()` walk has advanced.
// ============================================================

// `request(method, path)` — a request to hand a handler in a test: the
// method and path as given, no headers and no body, built up with
// `with_header`, `with_body` and `with_json`. It reads the way a served
// request does (`body_string`, `cookie`, `headers.get`), so a handler
// under test sees what it would in a serve loop.
//
//     let resp: HttpResponse = handle(http.request("POST", "/items").with_json("{\"n\": 1}"), m);
//     return test.assert_status(resp, 201);
pub function request(method: string, path: string): HttpRequest {
  let empty: u8[] = [];
  return HttpRequest { method: method, path: path, body: stream.stream_from_bytes(empty), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// `(r: HttpRequest).with_header(name, value)` — the request with `name`
// set to `value` (replacing an earlier value of the same name).
pub function (r: HttpRequest) with_header(name: string, value: string): HttpRequest {
  return HttpRequest { ...r, headers: r.headers.set(name, value) };
}

// `(r: HttpRequest).with_body(body)` — the request with `body` as its
// body and the `Content-Length` a client would send for it.
pub function (r: HttpRequest) with_body(body: string): HttpRequest {
  return HttpRequest { ...r, body: stream.stream_from_bytes(body.bytes()), headers: r.headers.set("content-length", int.int_to_string(body.len())) };
}

// `(r: HttpRequest).with_json(body)` — `with_body` with the
// `Content-Type` of JSON.
pub function (r: HttpRequest) with_json(body: string): HttpRequest {
  return r.with_body(body).with_header("content-type", "application/json");
}

// `(r: HttpRequest).body_stream()` — the body as a Stream,
// positioned at the start. The entry point for incremental
// reads: `let (line, s) = req.body_stream().read_line();`.
pub function (r: HttpRequest) body_stream(): Stream {
  return r.body;
}

// `(r: HttpRequest).body_string()` — the whole body as text, cursor
// position ignored, or `Err(NotUtf8)` when its bytes are not
// well-formed UTF-8, or `Err(EndedEarly(fault))` when a body that
// arrives as it is read (std/serve's streamed request body) ended early.
// The body is the sender's bytes, so this is the boundary D9
// (docs/STRINGS-SOTA.md) checks at; the error is `ToResponse` (400, or
// the fault's status), so a handler declared `Result[HttpResponse,
// BodyError]` takes the text with `?`, and `body_bytes` is the body as
// it came.
pub function (r: HttpRequest) body_string(): Result[string, BodyError] {
  let (bytes, rest) = __whole_body(r.body);
  if (rest.fault() != 0) {
    return Err(EndedEarly(rest.fault()));
  }
  match (utf8.from_bytes(bytes)) {
    Some(s) => {
      return Ok(s);
    },
    None => {
      return Err(NotUtf8);
    }
  }
  return Err(NotUtf8);
}

// `__whole_body(s)` — the body from its start, the cursor ignored, and
// everything a source has still to give.
function __whole_body(s: Stream): (u8[], Stream) {
  let from_start: Stream = Stream { ...s, pos: 0 };
  return from_start.read_all();
}

// `(r: HttpRequest).body_bytes()` — the whole body as a u8 array, cursor
// position ignored; what arrived of a streamed body that ended early,
// which `body_string` reports.
pub function (r: HttpRequest) body_bytes(): u8[] {
  let (bytes, rest) = __whole_body(r.body);
  return bytes;
}

// `(r: HttpRequest).body_len()` — body length in bytes. The whole
// buffer, not `remaining()`: a handler asking a request how big its body
// is wants the Content-Length answer, not what a partial read has left.
// For a streamed body it is the declared `Content-Length`, -1 when the
// body is chunked and its length unknown.
pub function (r: HttpRequest) body_len(): i32 {
  match (r.body.source) {
    Some(src) => {
      return __declared_length(r.headers);
    },
    None => {
      return r.body.data.len();
    }
  }
  return r.body.data.len();
}

function __declared_length(h: HeaderMap): i32 {
  match (h.get("content-length")) {
    Some(v) => {
      match (int.parse_int_radix(v.trim(), 10)) {
        Some(n) => {
          return n;
        },
        None => {
          return 0 - 1;
        }
      }
    },
    None => {
      return 0 - 1;
    }
  }
  return 0 - 1;
}

// `(r: HttpResponse).body_string()` — the body as text, whichever
// `Body` holds it: the text itself, the bytes or the Stream's remainder,
// or every chunk the producer answers, joined. The byte-domain bodies
// are the program's own bytes and this reader has no error channel, so
// an ill-formed sequence reads as U+FFFD; `body_bytes` is the body as
// it is.
// A `BodyFile` answers "" here: the file is streamed by the serve loop
// as the response is written, never read by code a handler reaches,
// since a handler's host effects go through its platform (E080).
// The response-side twin of the HttpRequest readers above.
pub function (r: HttpResponse) body_string(): string {
  match (r.body) {
    BodyText(s) => {
      return s;
    },
    BodyBytes(bs) => {
      return utf8.from_bytes_lossy(bs);
    },
    BodyStream(st) => {
      let rest: (u8[], Stream) = st.read_all();
      return utf8.from_bytes_lossy(rest.0);
    },
    BodyFile(path) => {
      return "";
    },
    BodyChunks(producer) => {
      let joined: u8[] = __chunks_joined(producer);
      return utf8.from_bytes_lossy(joined);
    }
  }
  return "";
}

// `(r: HttpResponse).body_bytes()` — the body as bytes, read as
// `body_string` reads it.
pub function (r: HttpResponse) body_bytes(): u8[] {
  return r.body.bytes();
}

// `(b: Body).bytes()` — the bytes a `Body` holds, read as `body_bytes`
// reads them: a `BodyFile` answers none, since the file is streamed by
// the serve loop and never read by code a handler reaches.
pub function (b: Body) bytes(): u8[] {
  match (b) {
    BodyText(s) => {
      return s.bytes();
    },
    BodyBytes(bs) => {
      return bs;
    },
    BodyStream(st) => {
      let rest: (u8[], Stream) = st.read_all();
      return rest.0;
    },
    BodyFile(path) => {
      let none: u8[] = [];
      return none;
    },
    BodyChunks(producer) => {
      return __chunks_joined(producer);
    }
  }
  let empty: u8[] = [];
  return empty;
}

// `__chunks_joined(producer)` — every chunk the producer answers, from
// index 0 until it answers None, as one byte string.
function __chunks_joined(producer: ChunkProducer): u8[] {
  let next: (i32) => Option[u8[]] = producer.next;
  let out: u8[] = [];
  let i: i32 = 0;
  while (true) {
    match (next(i)) {
      Some(chunk) => {
        out = out.concat(chunk);
      },
      None => {
        return out;
      }
    }
    i = i + 1;
  }
  return out;
}

// `(r: HttpResponse).body_len()` — the body's length in bytes: the
// text's or the bytes' length, the Stream's remainder, the chunks'
// total, 0 for a file the loop has not opened yet.
pub function (r: HttpResponse) body_len(): i32 {
  match (r.body) {
    BodyText(s) => {
      return s.len();
    },
    BodyBytes(bs) => {
      return bs.len();
    },
    BodyStream(st) => {
      return st.remaining();
    },
    BodyFile(path) => {
      return 0;
    },
    BodyChunks(producer) => {
      return __chunks_joined(producer).len();
    }
  }
  return 0;
}

// `http_materialize(r)` — the response with a `BodyFile` read into a
// `BodyBytes`, or a 404 when the file cannot be read; any other body
// as it was. For a test that wants the bytes a served file body would
// carry: the serve loop itself streams the file from a `Reader` as the
// socket takes it, after the handler has answered, on the loop's own
// thread of control and outside the reach of E080's rule that a
// handler's host effects go through its bag.
pub function http_materialize(r: HttpResponse): HttpResponse {
  match (r.body) {
    BodyFile(path) => {
      match (read_file_bytes(path)) {
        Ok(bs) => {
          return HttpResponse { ...r, body: BodyBytes(bs) };
        },
        Err(e) => {
          return not_found();
        }
      }
      return not_found();
    },
    _ => {
      return r;
    }
  }
  return r;
}

// `bytes(status, bs)` — a response whose body is
// given as bytes rather than a string, so a handler holding
// `u8[]` (an image, a decoded frame, bytes read off a request
// Stream) does not have to spell the conversion itself.
pub function bytes(status: i32, bs: u8[]): HttpResponse {
  return HttpResponse { status: status, body: BodyBytes(bs), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// `stream(status, s)` — a response whose body is what
// is left of a Stream: bytes already in memory, drained to the wire
// from its cursor.
pub function stream(status: i32, s: Stream): HttpResponse {
  return HttpResponse { status: status, body: BodyStream(s), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// `file(path)` — a 200 whose body is the file at `path`,
// streamed by the serve loop as the socket takes it, so a handler
// answers a file without holding it or reaching the filesystem; a file
// the loop cannot open is answered 404 in its place. The
// `Content-Type` is the caller's to set.
pub function file(path: string): HttpResponse {
  return HttpResponse { status: 200, body: BodyFile(path), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// `chunks(status, next)` — a response whose body is what
// `next` answers for the indexes 0, 1, 2, … until it answers None, each
// chunk produced as the socket takes the one before it. The serve loop
// writes it under chunked transfer coding to an HTTP/1.1 client and
// close-delimited to an HTTP/1.0 one, so the length need not be known
// up front; a `Content-Length` the handler set is dropped. The
// `Content-Type` is the caller's to set.
pub function chunks(status: i32, next: (i32) => Option[u8[]]): HttpResponse {
  return HttpResponse { status: status, body: BodyChunks(ChunkProducer { next: next }), headers: headers.header_map_new(), trailers: headers.header_map_new() };
}

// ============================================================
// Header convenience methods — the ergonomic immutable-update
// shape for handler code. Under immutable data structures
// `r.headers.set(k, v)` returns a new HeaderMap but can't
// write it back into `r`, so handlers would otherwise need the
// verbose `r = HttpResponse { ...r, headers: r.headers.set(k,
// v) };`. These wrap that into a single rebind — the Rust
// `http` builder idiom: `r = r.with_header("X-Trace", "1");`.
// ============================================================

// `(r: HttpResponse).with_header(name, value)` — replace any
// existing entries for `name` (set semantics) and return the
// updated response. Rebind: `r = r.with_header(k, v);`.
pub function (r: HttpResponse) with_header(name: string, value: string): HttpResponse {
  return HttpResponse { ...r, headers: r.headers.set(name, value) };
}

// `(r: HttpResponse).with_trailer(name, value)` — set (replace) a trailer
// field, sent after a chunked body's last chunk and announced in the
// head's `Trailer` field (RFC 9110 §6.5). Only a body the serve loop
// sends chunked, `chunks(status, next)`, carries them: a body with a
// length, an HTTP/1.0 client's close-delimited stream and the wasi-http
// wrapper's outgoing body go without.
pub function (r: HttpResponse) with_trailer(name: string, value: string): HttpResponse {
  return HttpResponse { ...r, trailers: r.trailers.set(name, value) };
}

// `(r: HttpResponse).with_appended_header(name, value)` — add
// an entry without replacing existing same-name entries
// (append semantics — duplicate-safe, e.g. Set-Cookie).
pub function (r: HttpResponse) with_appended_header(name: string, value: string): HttpResponse {
  return HttpResponse { ...r, headers: r.headers.append(name, value) };
}

// `(r: HttpResponse).with_content_type(ct)` — set (replace) the
// `Content-Type` header. Convenience over `with_header` for the
// most common single header a handler overrides; pairs with the
// plain builders (`ok`, `text`, …) when you want to keep their
// status/body but add a media type:
//   r = ok(csv).with_content_type("text/csv");
pub function (r: HttpResponse) with_content_type(ct: string): HttpResponse {
  return HttpResponse { ...r, headers: r.headers.set("Content-Type", ct) };
}

// ============================================================
// Cookies (RFC 6265) — the last helper family from the
// 2026-07-02 stdlib review's http list (#4385 noted "no cookie
// helpers"). Request side: read a cookie out of the `Cookie`
// header(s). Response side: a `SetCookie` value with the
// standard attributes, serialized onto the response as an
// appended `Set-Cookie` header (append semantics — one header
// per cookie, per the RFC).
// ============================================================

// `(r: HttpRequest).cookie(name)` — the value of cookie `name`
// from the request's `Cookie` header(s), or None. Parses the
// RFC 6265 §5.4 cookie-string shape (`a=1; b=2`) across every
// `Cookie` header present (clients send one, but proxies can
// split). Names are case-SENSITIVE per the RFC. The value is
// returned raw: surrounding double quotes (allowed by the
// grammar) are not stripped, and no decoding is applied.
pub function (r: HttpRequest) cookie(name: string): Option[string] {
  let hs: string[] = r.headers.get_all("cookie");
  let i: i32 = 0;
  while (i < hs.len()) {
    let parts: string[] = hs[i].split(";");
    let j: i32 = 0;
    while (j < parts.len()) {
      let pair: str = parts[j].trim();
      let eq: i32 = pair.index_of("=");
      if (eq > 0) {
        if (slice_unchecked(pair, 0, eq) == name) {
          return Some(slice_unchecked(pair, eq + 1, pair.len()).to_owned());
        }
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return None;
}

// `SetCookie` — a response cookie with the standard RFC 6265
// attributes. Build with `cookie_new` / `cookie_delete`, adjust
// fields via struct-update spread, attach with
// `resp.with_set_cookie(c)`:
//
//   let c: SetCookie = http.cookie_new("session", sid);
//   resp = resp.with_set_cookie(SetCookie { ...c, secure: true });
//
// Field conventions: `path`/`same_site` empty = attribute
// omitted; `max_age` negative = omitted (a session cookie),
// `0` = expire immediately (deletion).
pub struct SetCookie {
  name: string,
  value: string,
  path: string,
  max_age: i32,
  http_only: boolean,
  secure: boolean,
  same_site: string,
}

// `cookie_new(name, value)` — a `SetCookie` with the modern
// framework defaults: `Path=/`, session lifetime (no Max-Age),
// `HttpOnly`, `SameSite=Lax`, not `Secure` (defaulting Secure on
// would silently break plain-http development; set it explicitly
// for production HTTPS).
pub function cookie_new(name: string, value: string): SetCookie {
  return SetCookie {
    name: name,
    value: value,
    path: "/",
    max_age: -1,
    http_only: true,
    secure: false,
    same_site: "Lax",
  };
}

// `cookie_delete(name)` — a `SetCookie` that expires the cookie
// immediately (`Max-Age=0`, empty value) on `Path=/`. Attach it
// like any other: `resp = resp.with_set_cookie(http.cookie_delete("session"));`.
pub function cookie_delete(name: string): SetCookie {
  return SetCookie { ...cookie_new(name, ""), max_age: 0 };
}

// `__cookie_clean(s, drop_eq)` — header-injection defence for
// serialize: strip control bytes (CR/LF would let a value inject
// extra headers onto the wire) and the cookie structure bytes `;`
// (and `=` for names). Everything else passes through unchanged;
// callers needing arbitrary bytes in a value should encode first
// (e.g. base64 / percent).
function __cookie_clean(s: string, drop_eq: boolean): string {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    let keep: boolean = b >= 32 && b != 59;
    if (drop_eq && b == 61) {
      keep = false;
    }
    if (keep) {
      out = out.append(b as u8);
    }
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

// `(c: SetCookie).serialize()` — the `Set-Cookie` header VALUE
// (`name=value; Path=/; Max-Age=0; Secure; HttpOnly;
// SameSite=Lax`, attributes in that order, omitted per the field
// conventions on `SetCookie`).
pub function (c: SetCookie) serialize(): string {
  let out: string = __cookie_clean(c.name, true) + "=" + __cookie_clean(c.value, false);
  if (c.path.len() > 0) {
    out = out + "; Path=" + c.path;
  }
  if (c.max_age >= 0) {
    out = out + "; Max-Age=" + int.int_to_string(c.max_age);
  }
  if (c.secure) {
    out = out + "; Secure";
  }
  if (c.http_only) {
    out = out + "; HttpOnly";
  }
  if (c.same_site.len() > 0) {
    out = out + "; SameSite=" + c.same_site;
  }
  return out;
}

// `(r: HttpResponse).with_set_cookie(c)` — append a `Set-Cookie`
// header for `c` (append semantics: each cookie gets its own
// header line, and setting several cookies on one response
// works). Rebind: `r = r.with_set_cookie(c);`.
pub function (r: HttpResponse) with_set_cookie(c: SetCookie): HttpResponse {
  return HttpResponse { ...r, headers: r.headers.append("Set-Cookie", c.serialize()) };
}

// ---------------------------------------------------------------------------
// Response framing — the client side of the wire. `std/fetch` reads a
// response with these; the request parser above is their twin.

// `HttpResponseFramed` — a parsed response: the response, how many bytes
// it occupied from where the parse began (so an interim 1xx response can
// be stepped over to the one behind it), its version, and whether the
// connection outlives it under the rule `__persists` applies to requests.
pub struct HttpResponseFramed { response: HttpResponse, len: i32, version: string, keep_alive: boolean }

// `HttpResponseFraming` — `Complete(framed)` once the whole response is
// in the buffer, `Unfinished` while it is not, `Rejected(code)` for one
// this parser will not read: 400 for a malformed status line, header
// block or body framing, 413 for a body past `limits.body`, 431 for a
// header block or chunk framing past its budget, 501 for a transfer
// coding under `chunked`, and 505 for a major version other than 1.
pub enum HttpResponseFraming { Complete(HttpResponseFramed), Unfinished, Rejected(i32) }

// `http_parse_response_framed(buf, method, eof, limits)` — the response
// at the head of `buf` to a request sent with `method`, under `limits`
// (`request_line` caps the status line). `eof` says the peer has closed:
// a response with neither `Content-Length` nor `Transfer-Encoding` is
// delimited by the close (RFC 9112 §6.3 item 8), so it is `Unfinished`
// until then and the rest of the buffer once it has. A response to HEAD,
// and a 1xx, 204 or 304, has no body whatever its headers say (§6.3
// items 1 and 2). The trailers of a chunked body are the response's
// `trailers`.
pub function http_parse_response_framed(buf: u8[], method: string, eof: boolean, limits: HttpLimits): HttpResponseFraming {
  return http_parse_response_framed_from(buf, 0, method, eof, limits);
}

// `http_parse_response_framed_from(buf, from, method, eof, limits)` —
// the same parse over buf[from, len); `len` counts from `from`.
pub function http_parse_response_framed_from(buf: u8[], from: i32, method: string, eof: boolean, limits: HttpLimits): HttpResponseFraming {
  let first_crlf: i32 = __request_line_end(buf, from, limits.request_line);
  let headers_end: i32 = __header_block_end(buf, from, limits.header_bytes);
  let refused: i32 = __response_head_refused(buf, from, first_crlf, headers_end, limits);
  if (refused != 0) {
    return Rejected(refused);
  }
  if (first_crlf < 0 || headers_end < 0) {
    return Unfinished;
  }
  return __response_body(buf, from, first_crlf, headers_end, __status_code(buf, from), method, eof, limits);
}

// `__response_head_refused(buf, from, first_crlf, headers_end, limits)`
// — the code refusing the status line and header block as far as they
// have arrived, or 0: the status line is refused as soon as its CRLF is
// in, the block's line endings as they come.
function __response_head_refused(buf: u8[], from: i32, first_crlf: i32, headers_end: i32, limits: HttpLimits): i32 {
  if (first_crlf == -2) {
    return 400;
  }
  if (headers_end == -2) {
    return 431;
  }
  if (!__crlf_terminated(buf, from, __head_scanned(buf, from, headers_end, limits))) {
    return 400;
  }
  if (first_crlf >= 0) {
    return __status_line_refused(buf, from, first_crlf);
  }
  return 0;
}

// `__head_scanned(buf, from, headers_end, limits)` — how far the header
// block's line endings are checked: to its end once that has arrived,
// else as far as the block may run.
function __head_scanned(buf: u8[], from: i32, headers_end: i32, limits: HttpLimits): i32 {
  if (headers_end >= 0) {
    return headers_end;
  }
  let scanned: i32 = from + limits.header_bytes + 4;
  if (buf.len() < scanned) {
    return buf.len();
  }
  return scanned;
}

// `__status_line_refused(buf, from, end)` — 0 when buf[from, end) is a
// status line (RFC 9112 §4: an HTTP-version, a space, three digits, then
// the end or a space and a reason phrase), 400 when it is not, 505 for
// a major version other than 1.
function __status_line_refused(buf: u8[], from: i32, end: i32): i32 {
  if (end - from < 8) {
    return 400;
  }
  let version: i32 = __version_status(buf, from, from + 8);
  if (version != 0) {
    return version;
  }
  if (end < from + 12 || buf[from + 8] != 32 as u8 || !__three_digits(buf, from + 9)) {
    return 400;
  }
  if (end > from + 12 && buf[from + 12] != 32 as u8) {
    return 400;
  }
  if (!__reason_ok(buf, from + 13, end)) {
    return 400;
  }
  return 0;
}

function __three_digits(buf: u8[], at: i32): boolean {
  return __is_digit(buf[at]) && __is_digit(buf[at + 1]) && __is_digit(buf[at + 2]);
}

// `__reason_ok(buf, from, end)` — whether a reason phrase holds no control
// byte other than HTAB.
function __reason_ok(buf: u8[], from: i32, end: i32): boolean {
  let i: i32 = from;
  while (i < end) {
    if (buf[i] < 32 as u8 && buf[i] != 9 as u8) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// `__status_code(buf, from)` — the three digits of a status line
// `__status_line_refused` passed.
function __status_code(buf: u8[], from: i32): i32 {
  return (buf[from + 9] as i32 - 48) * 100 + (buf[from + 10] as i32 - 48) * 10 + (buf[from + 11] as i32 - 48);
}

// `__response_body(...)` — the rest of the parse once the header block
// has arrived: the headers, then the body under the response's framing.
function __response_body(buf: u8[], from: i32, first_crlf: i32, headers_end: i32, status: i32, method: string, eof: boolean, limits: HttpLimits): HttpResponseFraming {
  let hdr_start: i32 = first_crlf + 2;
  if (hdr_start > headers_end) {
    hdr_start = headers_end;
  }
  let h: HeaderMap = headers.header_map_new();
  match (__parse_header_bytes(buf, hdr_start, headers_end, limits.header_fields)) {
    Ok(parsed) => {
      h = parsed;
    },
    Err(code) => {
      return Rejected(code);
    }
  }
  let version: string = __version_of(buf, from);
  let at: i32 = headers_end + 4;
  let body: (i32, u8[], i32, HeaderMap) = __response_payload(buf, at, h, status, method, eof, version, limits);
  if (body.0 == 1) {
    return Unfinished;
  }
  if (body.0 != 2) {
    return Rejected(body.0);
  }
  let resp: HttpResponse = HttpResponse { status: status, body: BodyBytes(body.1), headers: h, trailers: body.3 };
  return Complete(HttpResponseFramed { response: resp, len: body.2 - from, version: version, keep_alive: __persists(version, h) });
}

// `__response_payload(buf, at, h, status, method, eof, version)` — the
// response's body from `at`, as `__framed_body` answers: none for a
// bodiless response, the rest of the buffer at the close for one its
// headers do not delimit, and the declared framing otherwise.
function __response_payload(buf: u8[], at: i32, h: HeaderMap, status: i32, method: string, eof: boolean, version: string, limits: HttpLimits): (i32, u8[], i32, HeaderMap) {
  let empty: u8[] = [];
  let none: HeaderMap = headers.header_map_new();
  if (method == "HEAD" || http_bodiless(status)) {
    return (2, empty, at, none);
  }
  if (__field_at(h, "transfer-encoding", 0) < 0 && __field_at(h, "content-length", 0) < 0) {
    if (!eof) {
      return (1, empty, 0, none);
    }
    if (buf.len() - at > limits.body) {
      return (413, empty, 0, none);
    }
    return (2, __bytes_range(buf, at, buf.len()), buf.len(), none);
  }
  match (__http_body_framing(h)) {
    Ok(framing) => {
      return __framed_body(buf, at, framing, version, limits);
    },
    Err(code) => {
      return (code, empty, 0, none);
    }
  }
  return (400, empty, 0, none);
}

// `http_hop_by_hop(name)` — whether a field is hop-by-hop (RFC 9110 §7.6.1
// and the fields the `Connection` of either peer controls): a client
// strips these from what it sends and from what it hands back, since the
// connection they describe is its own, not the caller's.
pub function http_hop_by_hop(name: string): boolean {
  return name.eq_ignore_ascii_case("connection") || name.eq_ignore_ascii_case("keep-alive") || name.eq_ignore_ascii_case("proxy-connection") || name.eq_ignore_ascii_case("transfer-encoding") || name.eq_ignore_ascii_case("te") || name.eq_ignore_ascii_case("trailer") || name.eq_ignore_ascii_case("upgrade");
}

// `http_end_to_end(h)` — `h` without its hop-by-hop fields and without
// the fields its `Connection` names (§7.6.1: those are hop-by-hop too).
pub function http_end_to_end(h: HeaderMap): HeaderMap {
  let named: string[] = [];
  for v in h.get_all("connection") {
    for tok in v.split(",") {
      named = named.append(tok.trim());
    }
  }
  let out: HeaderMap = headers.header_map_new();
  let i: i32 = 0;
  while (i < h.names.len()) {
    if (!http_hop_by_hop(h.names[i]) && !__names_hold(named, h.names[i])) {
      out = out.append(h.names[i], h.values[i]);
    }
    i = i + 1;
  }
  return out;
}

function __names_hold(names: string[], name: string): boolean {
  for n in names {
    if (n.eq_ignore_ascii_case(name)) {
      return true;
    }
  }
  return false;
}

// `(r: HttpResponse).body_text()` — the body as text when it is valid
// UTF-8, `None` when it is not: the read for a body that came off the
// wire, which may hold anything, where `body_string` is for one a
// handler built.
pub function (r: HttpResponse) body_text(): Option[string] {
  return utf8.from_bytes(r.body_bytes());
}

// ---------------------------------------------------------------------------
// Request writing — what a client may put on the wire. The parser above
// refuses these bytes coming in; a client refuses them going out, so a
// caller's URL or field cannot split the request it is written into.

// `http_method_ok(method)` — whether `method` is a token (RFC 9110 §9.1).
pub function http_method_ok(method: string): boolean {
  let b: u8[] = method.bytes();
  return __is_token(b, 0, b.len());
}

// `http_method_idempotent(method)` — whether a request with `method` may
// be sent again when the first attempt failed before any response byte
// arrived (RFC 9110 §9.2.2): GET, HEAD, PUT, DELETE, OPTIONS and TRACE.
pub function http_method_idempotent(method: string): boolean {
  return method == "GET" || method == "HEAD" || method == "PUT" || method == "DELETE" || method == "OPTIONS" || method == "TRACE";
}

// `http_target_ok(target)` — whether `target` can stand as an origin-form
// request-target (RFC 9112 §3.2.1): `/`, then `pchar` and `/`, then
// optionally `?` and a query of `pchar`, `/` and `?`, every `%` followed by
// two hex digits. A space, a control byte and a byte past ASCII all fail.
// `%2F` passes: a client sends the target as its caller encoded it, and
// what a decoded segment may hold is the server's rule (`__decoded_path`
// refuses it), so the set written is wider than the set read.
pub function http_target_ok(target: string): boolean {
  if (target.len() == 0 || target[0] != 47 as u8) {
    return false;
  }
  let q: i32 = __find_char(target, 0, target.len(), 63 as u8);
  if (q < 0) {
    return __query_ok(target, 0, target.len());
  }
  return __query_ok(target, 0, q) && __query_ok(target, q + 1, target.len());
}

// `http_field_name_ok(name)` — whether `name` is a field name, a token
// (RFC 9110 §5.1).
pub function http_field_name_ok(name: string): boolean {
  let n: u8[] = name.bytes();
  return __is_token(n, 0, n.len());
}

// `http_fields_ok(fields)` — whether every field of the map can be written
// as a field line: a token name and a value `http_field_value_ok` admits.
pub function http_fields_ok(fields: HeaderMap): boolean {
  let i: i32 = 0;
  while (i < fields.names.len()) {
    if (!http_field_name_ok(fields.names[i]) || !http_field_value_ok(fields.values[i])) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// `http_field_value_ok(value)` — whether `value` can be written as one
// line: no control byte but HTAB and no DEL (RFC 9110 §5.5), the rule
// `__field_value` reads a value by.
pub function http_field_value_ok(value: string): boolean {
  let i: i32 = 0;
  while (i < value.len()) {
    if (value[i] < 32 as u8 && value[i] != 9 as u8 || value[i] == 127 as u8) {
      return false;
    }
    i = i + 1;
  }
  return true;
}
