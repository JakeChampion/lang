// std/http — HTTP/1.1 request parsing, response building, and
// serialization. Helpers that compose on top of the runtime's
// raw `tcp_*` socket primitives so user code (and the
// auto-synthesised handler `main()`) can do
// request → response work without rolling its own parser.
//
// No prelude: callers now `import "std/http";` explicitly
// (docs/PRELUDE-TO-MODULES.md, Phase 5).
//
// Scope: HTTP/1.1 and HTTP/1.0, request bodies delimited by
// Content-Length or by chunked transfer coding (trailers into
// `request.trailers`); a request line of at most 8 KiB, a header block of at most
// 32 KiB and 100 fields, a body of at most 1 MiB with at most 32 KiB of
// chunk framing, and no lenient mode: a malformed request is refused
// (RFC 9112 §2.2, §3.2, §5, §6.1, §6.3, §7.1), never repaired, with the
// status the serve loop answers it with.
// Persistent connections are the serve loop's: `http_parse_request_framed`
// says how many bytes a request occupied and whether the connection
// outlives it, and `http_serialize_response_conn` writes the `Connection`
// the loop decided. Responses are Content-Length-delimited. No TLS.

import "core/int";
import "core/map";
// std/http's bodies dispatch (string) methods all over the
// request parser and response builder — `.index_of()`,
// `.split()`, `.trim()`, `.to_lower()`, etc. Declare std/string
// so those receiver methods register under no-prelude.
import "std/string";
// std/headers backs the HttpRequest.headers field — header_map_new
// for the parse-request entry placeholder, append for populating
// from the parsed header block.
import "std/headers";
// std/stream backs the HttpRequest.body field — stream_from_string
// to wrap a parsed body, and the cursor readers the whole-body
// shims below run over it.
import "std/stream";

// `http_status_text(code)` — IANA reason phrase for the
// common HTTP status codes (RFC 9110). Returns "" for
// unknown codes — callers should fall back to a generic
// phrase rather than emitting nothing.
pub function http_status_text(code: i32): string {
    if (code < 400) { return __status_text_below_400(code); }
    if (code < 500) { return __status_text_4xx(code); }
    return __status_text_5xx(code);
}

function __status_text_below_400(code: i32): string {
    if (code == 100) { return "Continue"; }
    if (code == 101) { return "Switching Protocols"; }
    if (code == 200) { return "OK"; }
    if (code == 201) { return "Created"; }
    if (code == 204) { return "No Content"; }
    if (code == 301) { return "Moved Permanently"; }
    if (code == 302) { return "Found"; }
    if (code == 304) { return "Not Modified"; }
    if (code == 307) { return "Temporary Redirect"; }
    if (code == 308) { return "Permanent Redirect"; }
    return "";
}

function __status_text_4xx(code: i32): string {
    if (code == 400) { return "Bad Request"; }
    if (code == 401) { return "Unauthorized"; }
    if (code == 403) { return "Forbidden"; }
    if (code == 404) { return "Not Found"; }
    if (code == 405) { return "Method Not Allowed"; }
    if (code == 408) { return "Request Timeout"; }
    if (code == 409) { return "Conflict"; }
    if (code == 410) { return "Gone"; }
    if (code == 413) { return "Payload Too Large"; }
    if (code == 414) { return "URI Too Long"; }
    if (code == 415) { return "Unsupported Media Type"; }
    if (code == 417) { return "Expectation Failed"; }
    if (code == 418) { return "I'm a teapot"; }
    if (code == 422) { return "Unprocessable Entity"; }
    if (code == 429) { return "Too Many Requests"; }
    if (code == 431) { return "Request Header Fields Too Large"; }
    return "";
}

function __status_text_5xx(code: i32): string {
    if (code == 500) { return "Internal Server Error"; }
    if (code == 501) { return "Not Implemented"; }
    if (code == 502) { return "Bad Gateway"; }
    if (code == 503) { return "Service Unavailable"; }
    if (code == 504) { return "Gateway Timeout"; }
    return "";
}

// `is_valid_http_status(code)` — true if code is in the RFC
// 9110 range of [100, 599]. The full HTTP status range is
// 100..999 by the BNF but only the first three centuries
// have semantic meaning; servers shouldn't emit codes
// outside [100, 599].
pub function is_valid_http_status(code: i32): boolean {
    return code >= 100 && code <= 599;
}

// Status-class predicates — the RFC 9110 §15 response classes, for
// branching on a response code without hard-coding range bounds at
// every call site (`if (http_is_success(resp.status)) { … }`). Each
// tests the code's leading digit / century:
//   1xx informational, 2xx success, 3xx redirect,
//   4xx client error, 5xx server error.
// A code outside [100, 599] belongs to no class, so every predicate is
// false for it.
pub function http_is_informational(code: i32): boolean { return code >= 100 && code <= 199; }
pub function http_is_success(code: i32): boolean       { return code >= 200 && code <= 299; }
pub function http_is_redirect(code: i32): boolean      { return code >= 300 && code <= 399; }
pub function http_is_client_error(code: i32): boolean  { return code >= 400 && code <= 499; }
pub function http_is_server_error(code: i32): boolean  { return code >= 500 && code <= 599; }

// `http_is_error(code)` — client OR server error (4xx / 5xx), the
// common "did the request fail?" check.
pub function http_is_error(code: i32): boolean {
    return code >= 400 && code <= 599;
}

// `http_response_ok(body)` — 200 OK with the given body.
// `http_response_text(status, body)` — explicit status code.
// `http_response_not_found()` — common 404 builder.
// Saves the `HttpResponse { status: 200, body: ... }` boiler-
// plate at every handler call site.
pub function http_response_ok(body: string): HttpResponse {
    return HttpResponse { status: 200, body: body, headers: headers.header_map_new() };
}

pub function http_response_text(status: i32, body: string): HttpResponse {
    return HttpResponse { status: status, body: body, headers: headers.header_map_new() };
}

pub function http_response_not_found(): HttpResponse {
    return HttpResponse { status: 404, body: "Not Found", headers: headers.header_map_new() };
}

// `http_response_bad_request(body)` — 400 with the given
// body. Common shape for validation-failure responses.
pub function http_response_bad_request(body: string): HttpResponse {
    return HttpResponse { status: 400, body: body, headers: headers.header_map_new() };
}

// `http_response_internal_error(body)` — 500. The default
// body shape for unhandled / unexpected exceptions in a
// handler.
pub function http_response_internal_error(body: string): HttpResponse {
    return HttpResponse { status: 500, body: body, headers: headers.header_map_new() };
}

// `http_response_redirect(location)` — 302 Found with the
// redirect target both in the body (for clients that ignore
// headers) and as a real `Location:` header.
pub function http_response_redirect(location: string): HttpResponse {
    var h: HeaderMap = headers.header_map_new();
    h = h.set("Location", location);
    return HttpResponse { status: 302, body: location, headers: h };
}

// `http_response_no_content()` — 204 No Content, empty
// body. The standard "I handled it, nothing to say"
// response for DELETE / PUT / etc.
pub function http_response_no_content(): HttpResponse {
    return HttpResponse { status: 204, body: "", headers: headers.header_map_new() };
}

// ============================================================
// Typed-body builders (#4385 — "response builders never set
// Content-Type"). The plain `http_response_*` builders above
// leave the media type unset, so a browser sniffs the body and
// a JSON API response can render as text. These set the right
// `Content-Type` up front, saving the `.with_header("Content-
// Type", …)` at every handler call site. Body types that carry
// text use an explicit `charset=utf-8` (Fern strings are UTF-8).
// ============================================================

// Build a 200 response with `Content-Type: ct` set.
function __http_response_typed(status: i32, body: string, ct: string): HttpResponse {
    var h: HeaderMap = headers.header_map_new();
    h = h.set("Content-Type", ct);
    return HttpResponse { status: status, body: body, headers: h };
}

// `http_response_json(body)` — 200 with `Content-Type:
// application/json`. `body` is the already-serialized JSON
// text (e.g. from `json.encode(...)`); this only sets the
// media type, it does not itself serialize.
pub function http_response_json(body: string): HttpResponse {
    return __http_response_typed(200, body, "application/json");
}

// `http_response_json_status(status, body)` — like
// `http_response_json` but with an explicit status code, for
// `201 Created` / `422 Unprocessable Entity` / … JSON replies.
pub function http_response_json_status(status: i32, body: string): HttpResponse {
    return __http_response_typed(status, body, "application/json");
}

// `http_response_html(body)` — 200 with `Content-Type:
// text/html; charset=utf-8`.
pub function http_response_html(body: string): HttpResponse {
    return __http_response_typed(200, body, "text/html; charset=utf-8");
}

// `http_response_plain(body)` — 200 with `Content-Type:
// text/plain; charset=utf-8`. The typed sibling of
// `http_response_ok`, for when the client should be told the
// body is plain text rather than left to sniff it.
pub function http_response_plain(body: string): HttpResponse {
    return __http_response_typed(200, body, "text/plain; charset=utf-8");
}

// `http_path_segments(path)` — split an HTTP path into
// non-empty components. Drops the leading "/" and any
// double slashes; query string (`?...`) is also stripped.
// Useful for simple routing — `/api/users/42` → `["api",
// "users", "42"]`.
// Each segment is materialised with `+ ""`: a bare slice views `path`, which
// the returned array outlives.
pub function http_path_segments(path: string): string[] {
    var n: i32 = path.len();
    // Strip query string.
    var q: i32 = path.index_of("?");
    if (q >= 0) { n = q; }
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        while (i < n && path[i] == 47) { i = i + 1; }   // skip /
        if (i >= n) { return out; }
        var start: i32 = i;
        while (i < n && path[i] != 47) { i = i + 1; }
        out = out.append(slice_unchecked(path, start, i) + "");
    }
    return out;
}

// `http_url_path_only(path)` — strip the query string
// (everything from the first `?` onward). Returns path
// unchanged when there's no query. Companion to
// http_path_segments when callers want the bare path
// without splitting.
pub function http_url_path_only(path: string): string {
    var q: i32 = path.index_of("?");
    if (q < 0) { return path; }
    return (slice_unchecked(path, 0, q) + "");
}

// `http_user_agent_is_bot(ua)` — heuristic bot detection
// via the User-Agent string. Checks for common bot tokens
// ("bot", "crawler", "spider", "slurp") case-insensitively.
// False negatives are common (sophisticated bots forge UAs);
// false positives possible (a browser called "BotSimulator").
// Use as a hint, not a security control.
pub function http_user_agent_is_bot(ua: string): boolean {
    if (ua.contains_ci("bot")) { return true; }
    if (ua.contains_ci("crawler")) { return true; }
    if (ua.contains_ci("spider")) { return true; }
    if (ua.contains_ci("slurp")) { return true; }
    return false;
}

// `http_header_value(block, key)` — the value of the first header named
// `key` (case-insensitively) in a raw CRLF-separated header block, with
// the whitespace around it trimmed, or `None` when no line names it.
// The block is read by the request parser's rules, so one it would
// refuse (a line without a colon, a name that is not a token, obs-fold,
// more than 100 fields) is `None` for every key. Multi-valued headers
// want `http_parse_request` and `get_all`.
pub function http_header_value(block: string, key: string): Option[string] {
    var bs: u8[] = block.bytes();
    match (__parse_header_bytes(bs, 0, bs.len())) {
        Ok(h) => { return h.get(key); },
        Err(_) => { return None; }
    }
    return None;
}

// __find_crlf is the index of the first CRLF at or after `from` and before
// `end`, or -1; __find_byte the same for one byte.
function __find_crlf(buf: u8[], from: i32, end: i32): i32 {
    var i: i32 = from;
    while (i + 1 < end) {
        if (buf[i] == (13 as u8) && buf[i + 1] == (10 as u8)) { return i; }
        i = i + 1;
    }
    return -1;
}

function __find_byte(buf: u8[], from: i32, end: i32, b: u8): i32 {
    var i: i32 = from;
    while (i < end) {
        if (buf[i] == b) { return i; }
        i = i + 1;
    }
    return -1;
}

// __bytes_range copies buf[from, end) into a fresh array; __bytes_string
// is that copy as text. The parser's outputs are owned copies of what the
// handler keeps, so the wire buffer can be reused once the parse is done.
function __bytes_range(buf: u8[], from: i32, end: i32): u8[] {
    var out: u8[] = __alloc_u8(end - from);
    var i: i32 = 0;
    while (from + i < end) {
        out = out.with(i, buf[from + i]);
        i = i + 1;
    }
    return out;
}

function __bytes_string(buf: u8[], from: i32, end: i32): string {
    return string_from_bytes_unchecked(__bytes_range(buf, from, end));
}

// The parser's caps (RFC 9112 §2.3 leaves them to the server): a request
// line of at most 8 KiB, a header block, request line included, of at
// most 32 KiB and 100 fields, a body of at most 1 MiB, and the framing
// of a chunked body (chunk-size lines, the CRLFs, the trailer section)
// of at most another 32 KiB. A request past any of them is malformed,
// refused before a handler sees any of it.
function __request_line_cap(): i32 { return 8192; }
pub function http_header_bytes_cap(): i32 { return 32768; }
function __header_count_cap(): i32 { return 100; }
pub function http_body_cap(): i32 { return 1048576; }

// `http_request_bytes_cap()` — the most bytes one request occupies on the
// wire: a header block at its cap, the CRLF CRLF that ends it, a body at
// its cap and its chunk framing at its cap. A connection buffering more
// than this without a complete request in it holds nothing the parser
// would frame.
pub function http_request_bytes_cap(): i32 { return http_header_bytes_cap() + 4 + http_body_cap() + http_header_bytes_cap(); }

// `__is_tchar(b)` — a byte of a token (RFC 9110 §5.6.2): a letter, a
// digit, or one of `!#$%&'*+-.^_`|~`, split at `@` to keep each half's
// branch count under the lint cap.
function __is_tchar(b: u8): boolean {
    return __is_tchar_below_at(b) || __is_tchar_above_at(b);
}

function __is_tchar_below_at(b: u8): boolean {
    return b == (33 as u8) || (b >= (35 as u8) && b <= (39 as u8)) || b == (42 as u8) || b == (43 as u8)
        || b == (45 as u8) || b == (46 as u8) || (b >= (48 as u8) && b <= (57 as u8));
}

function __is_tchar_above_at(b: u8): boolean {
    return (b >= (65 as u8) && b <= (90 as u8)) || (b >= (94 as u8) && b <= (96 as u8))
        || (b >= (97 as u8) && b <= (122 as u8)) || b == (124 as u8) || b == (126 as u8);
}

// `__is_token(buf, from, end)` — whether buf[from, end) is a non-empty
// token.
function __is_token(buf: u8[], from: i32, end: i32): boolean {
    if (end <= from) { return false; }
    var i: i32 = from;
    while (i < end) {
        if (!__is_tchar(buf[i])) { return false; }
        i = i + 1;
    }
    return true;
}

// `__token_is(s, want)` — whether `s`, less the SP and HTAB around it,
// is the token `want` under ASCII case folding (RFC 9110 §5.6.2): every
// byte a tchar, and each equal to `want`'s once an ASCII capital is
// lowered. Byte-wise on purpose: a Unicode fold would let U+212A KELVIN
// SIGN match `k`, and a byte-oriented intermediary would frame the
// message differently.
function __token_is(s: string, want: string): boolean {
    var from: i32 = 0;
    var end: i32 = s.len();
    while (from < end && __is_ows(s[from])) { from = from + 1; }
    while (end > from && __is_ows(s[end - 1])) { end = end - 1; }
    if (end - from != want.len()) { return false; }
    var i: i32 = 0;
    while (i < want.len()) {
        if (!__is_tchar(s[from + i]) || __ascii_lower(s[from + i]) != (want[i] as i32)) { return false; }
        i = i + 1;
    }
    return true;
}

// `__is_ows(b)` — SP or HTAB, the optional whitespace of RFC 9112 §5.5.
function __is_ows(b: u8): boolean {
    return b == (32 as u8) || b == (9 as u8);
}

// `__ascii_lower(b)` — the byte with an ASCII capital lowered.
function __ascii_lower(b: u8): i32 {
    var v: i32 = b as i32;
    if (v >= 65 && v <= 90) { return v + 32; }
    return v;
}

// `__field_value(buf, from, end)` — a field value's bytes less the
// optional whitespace around them (RFC 9112 §5.5, SP and HTAB only), or
// `None` when a byte is a control other than HTAB (RFC 9110 §5.5 lets a
// recipient refuse one; a lenient reading would let a VT or FF ride in a
// token that a byte-oriented intermediary reads differently).
function __field_value(buf: u8[], from: i32, end: i32): Option[string] {
    while (from < end && __is_ows(buf[from])) { from = from + 1; }
    while (end > from && __is_ows(buf[end - 1])) { end = end - 1; }
    var i: i32 = from;
    while (i < end) {
        if ((buf[i] < (32 as u8) && buf[i] != (9 as u8)) || buf[i] == (127 as u8)) { return None; }
        i = i + 1;
    }
    return Some(__bytes_string(buf, from, end));
}

// `__parse_header_bytes(buf, from, end)` — the CRLF-separated header
// lines in buf[from, end) as a HeaderMap, or the status that refuses
// them (RFC 9112 §5, with no lenient mode): 400 for a line with no colon
// or a name that is not a token (so empty, holding whitespace before the
// colon — a `Content-Length : 5` dropped instead would strand its body
// for the next pipelined parse — or starting with the SP or HTAB of
// obs-fold, §5.2) or a value holding a control byte other than HTAB
// (RFC 9110 §5.5), 431 for more fields than the cap. Names are
// case-folded by HeaderMap.append; a value loses the SP and HTAB around
// it (`__field_value`).
function __parse_header_bytes(buf: u8[], from: i32, end: i32): Result[HeaderMap, i32] {
    var h: HeaderMap = headers.header_map_new();
    var count: i32 = 0;
    var at: i32 = from;
    while (at < end) {
        var e: i32 = __find_crlf(buf, at, end);
        if (e < 0) { e = end; }
        var col: i32 = __find_byte(buf, at, e, 58 as u8);
        if (col < 0 || !__is_token(buf, at, col)) { return Err(400); }
        count = count + 1;
        if (count > __header_count_cap()) { return Err(431); }
        match (__field_value(buf, col + 1, e)) {
            Some(v) => { h = h.append(__bytes_string(buf, at, col), v); },
            None => { return Err(400); }
        }
        at = e + 2;
    }
    return Ok(h);
}

// `__crlf_terminated(buf, from, end)` — whether every LF in buf[from, end)
// is preceded by CR and every CR whose next byte has arrived is followed
// by LF. A bare CR or LF in a request line or header block is malformed
// (RFC 9112 §2.2), not a line terminator and not a byte of a value, and
// it is known as soon as it is read: a partial block is scanned too, so
// only a CR at the very end of the buffer is still undecided.
function __crlf_terminated(buf: u8[], from: i32, end: i32): boolean {
    var i: i32 = from;
    while (i < end) {
        if (buf[i] == (10 as u8)) { return false; }
        if (buf[i] == (13 as u8)) {
            if (i + 1 < buf.len() && buf[i + 1] != (10 as u8)) { return false; }
            i = i + 1;
        }
        i = i + 1;
    }
    return true;
}

// `__request_line_end(buf, from)` — where the request line's CRLF starts,
// -1 while the buffer holds less than a line, or -2 once it holds more
// than the cap without one. `__header_block_end` is the same for the
// CRLF CRLF that ends the header block.
function __request_line_end(buf: u8[], from: i32): i32 {
    var limit: i32 = from + __request_line_cap() + 2;
    var end: i32 = buf.len();
    if (limit < end) { end = limit; }
    var at: i32 = __find_crlf(buf, from, end);
    if (at >= 0) { return at; }
    if (buf.len() >= limit) { return -2; }
    return -1;
}

function __header_block_end(buf: u8[], from: i32): i32 {
    var limit: i32 = from + http_header_bytes_cap() + 4;
    var n: i32 = buf.len();
    var end: i32 = n;
    if (limit < end) { end = limit; }
    var at: i32 = __find_crlf_crlf(buf, from, end);
    if (at >= 0) { return at; }
    if (n >= limit) { return -2; }
    return -1;
}

// `__find_crlf_crlf(buf, from, end)` — where the first CRLF CRLF whose
// four bytes lie in buf[from, end) starts, or -1.
function __find_crlf_crlf(buf: u8[], from: i32, end: i32): i32 {
    var i: i32 = from;
    while (i + 3 < end) {
        if (buf[i] == (13 as u8) && buf[i + 1] == (10 as u8) && buf[i + 2] == (13 as u8) && buf[i + 3] == (10 as u8)) { return i; }
        i = i + 1;
    }
    return -1;
}

// `__http_content_length(h)` — the body length the parsed headers
// declare: `Some(0)` with no `Content-Length`, `None` to refuse the
// request (RFC 9112 §6.3): a duplicate `Content-Length` (identical
// values are refused too, rather than collapsed), or a value that is not
// all digits or overflows i32. The overflow is checked before each
// multiply: the body cap cannot catch a length that has already wrapped
// to a small nonnegative value.
function __http_content_length(h: HeaderMap): Option[i32] {
    var cls: string[] = h.get_all("content-length");
    if (cls.len() == 0) {
        return Some(0);
    }
    if (cls.len() > 1) {
        return None;
    }
    var value: string = cls[0];
    if (value.len() == 0) {
        return None;
    }
    var acc: i32 = 0;
    var i: i32 = 0;
    while (i < value.len()) {
        var b: i32 = value[i] as i32;
        if (b < 48 || b > 57) {
            return None;
        }
        var digit: i32 = b - 48;
        if (acc > 214748364 || (acc == 214748364 && digit > 7)) {
            return None;
        }
        acc = acc * 10 + digit;
        i = i + 1;
    }
    return Some(acc);
}

// __BodyFraming — how a request's body is delimited (RFC 9112 §6.3): by
// `Content-Length` (`Length(0)` with neither header), or by chunked
// transfer coding.
enum __BodyFraming { Length(i32), Chunked }

// `__http_body_framing(h)` — the body's framing from the parsed headers,
// or the status that refuses the request (RFC 9112 §6.1, §6.3): 400 for
// `Transfer-Encoding` beside `Content-Length` (the request-smuggling
// shape), for `chunked` applied twice, or for a `Content-Length` the
// parser cannot read; 501 for a coding other than `chunked`, which this
// parser cannot decode. A lenient reading of any of them would be a
// framing disagreement with the next parser on the path.
function __http_body_framing(h: HeaderMap): Result[__BodyFraming, i32] {
    var te: string[] = h.get_all("transfer-encoding");
    if (te.len() == 0) {
        match (__http_content_length(h)) {
            Some(n) => { return Ok(Length(n)); },
            None => { return Err(400); }
        }
        return Err(400);
    }
    if (h.get_all("content-length").len() > 0 || te.len() > 1) { return Err(400); }
    if (!__token_is(te[0], "chunked")) { return Err(501); }
    return Ok(Chunked);
}

// `__host_ok(h, version)` — the `Host` rule (RFC 9112 §3.2): an
// HTTP/1.1 request carries exactly one, any request at most one, and
// its value is a host with an optional port, so it holds nothing but
// visible ASCII (an empty value is the request-target's authority, and
// allowed).
function __host_ok(h: HeaderMap, version: string): boolean {
    var hosts: string[] = h.get_all("host");
    if (hosts.len() > 1) { return false; }
    if (hosts.len() == 0) { return version != "HTTP/1.1"; }
    var i: i32 = 0;
    while (i < hosts[0].len()) {
        var b: i32 = hosts[0][i] as i32;
        if (b < 33 || b > 126) { return false; }
        i = i + 1;
    }
    return true;
}

function __hex_digit(b: u8): i32 {
    if (b >= (48 as u8) && b <= (57 as u8)) { return (b as i32) - 48; }
    if (b >= (97 as u8) && b <= (102 as u8)) { return (b as i32) - 87; }
    if (b >= (65 as u8) && b <= (70 as u8)) { return (b as i32) - 55; }
    return -1;
}

// A chunked body (RFC 9112 §7.1) is walked before it is copied: the walk
// checks the framing and records where each chunk's data lies, so the
// copy is one allocation of the decoded length rather than one per
// chunk. The framing — chunk-size lines, extensions, the CRLFs and the
// trailer section — shares a budget of `http_header_bytes_cap()` bytes,
// so what a connection holds for a chunked request is bounded like the
// rest of it, and the decoded body is held to `http_body_cap()`. Every
// violation is refused as soon as it is known: a chunk that could not
// fit under the cap before its data arrives, a byte where a chunk's
// CRLF must be before the CRLF is complete, a line past the budget
// before its end.
//
// The walk and its helpers answer like the parse, with a status where
// the parse says `Malformed`: 1 incomplete, 2 complete, and 400 or more
// refused with that status (400 malformed framing, 413 a body past its
// cap, 431 framing or trailers past their budget).
//
// `__chunked_walk(buf, from)` — `(2, end, spans, trailers)` once the body
// is complete, with `end` the offset past the trailer section's
// terminator, `spans` the (start, len) pairs of the chunk data and
// `trailers` the trailer section's fields.
function __chunked_walk(buf: u8[], from: i32): (i32, i32, i32[], HeaderMap) {
    var n: i32 = buf.len();
    var at: i32 = from;
    var budget: i32 = http_header_bytes_cap();
    var room: i32 = http_body_cap();
    var spans: i32[] = [];
    var none: HeaderMap = headers.header_map_new();
    while (true) {
        var line: (i32, i32, i32) = __chunk_size_line(buf, at, budget, room);
        if (line.0 != 2) { return (line.0, 0, spans, none); }
        var data: i32 = line.1 + 2;
        var size: i32 = line.2;
        budget = budget - (data - at) - 2;
        if (budget < 0) { return (431, 0, spans, none); }
        if (size == 0) { return __chunked_trailers(buf, data, budget + 2, spans); }
        var crlf: i32 = __crlf_at(buf, data + size);
        if (crlf == 0) { return (400, 0, spans, none); }
        if (crlf == 1) { return (1, 0, spans, none); }
        spans = spans.append(data).append(size);
        room = room - size;
        at = data + size + 2;
    }
    return (400, 0, spans, none);
}

// `__crlf_at(buf, at)` — whether buf[at, at + 2) is CRLF: 2 when it is,
// 0 when a byte that has arrived says it is not, 1 while neither has.
function __crlf_at(buf: u8[], at: i32): i32 {
    var n: i32 = buf.len();
    if (at < n && buf[at] != (13 as u8)) { return 0; }
    if (at + 1 < n && buf[at + 1] != (10 as u8)) { return 0; }
    if (at + 2 > n) { return 1; }
    return 2;
}

// `__chunk_size_line(buf, at, budget, room)` — the chunk-size line at
// `at`: `(2, crlf, size)` once it has arrived whole, `(1, _, _)` while it
// has not; refused with 400 for no hex digit, anything but a chunk
// extension after the size (§7.1.1; an extension is skipped unread) or a
// bare CR or LF, 413 for a chunk larger than `room` (what the body cap
// has left, so the chunk could never fit), 431 for a line longer than
// the framing budget.
function __chunk_size_line(buf: u8[], at: i32, budget: i32, room: i32): (i32, i32, i32) {
    var n: i32 = buf.len();
    var limit: i32 = at + budget;
    if (limit > n) { limit = n; }
    var crlf: i32 = __find_crlf(buf, at, limit);
    var scanned: i32 = limit;
    if (crlf >= 0) { scanned = crlf; }
    if (!__crlf_terminated(buf, at, scanned)) { return (400, 0, 0); }
    if (crlf < 0) {
        if (n >= at + budget) { return (431, 0, 0); }
        return (1, 0, 0);
    }
    var size: (i32, i32, i32) = __chunk_size(buf, at, crlf, room);
    if (size.0 != 0) { return (size.0, 0, 0); }
    if (!__chunk_ext_only(buf, size.2, crlf)) { return (400, 0, 0); }
    return (2, crlf, size.1);
}

// `__chunk_size(buf, at, end, room)` — the hex chunk size at `at`:
// `(0, size, next)` with `next` the offset past its digits, `(400, _, _)`
// with no digit, `(413, _, _)` for a size past `room`.
function __chunk_size(buf: u8[], at: i32, end: i32, room: i32): (i32, i32, i32) {
    var size: i32 = 0;
    var i: i32 = at;
    while (i < end && __hex_digit(buf[i]) >= 0) {
        var d: i32 = __hex_digit(buf[i]);
        if (size * 16 + d > room) { return (413, 0, i); }
        size = size * 16 + d;
        i = i + 1;
    }
    if (i == at) { return (400, 0, i); }
    return (0, size, i);
}

// `__chunk_ext_only(buf, from, end)` — whether buf[from, end) is empty
// or, past optional whitespace, a chunk extension (§7.1.1).
function __chunk_ext_only(buf: u8[], from: i32, end: i32): boolean {
    var i: i32 = from;
    while (i < end && (buf[i] == (32 as u8) || buf[i] == (9 as u8))) { i = i + 1; }
    return i == end || buf[i] == (59 as u8);
}

// `__chunked_trailers(buf, at, budget, spans)` — the trailer section that
// follows the last chunk's CRLF, at `at`, through the CRLF that ends it:
// `(2, end, spans, trailers)` with `end` past that CRLF, `(1, _, _, _)`
// while it has not arrived; refused with `__parse_header_bytes`'s status
// when a line breaks the header rules (the count cap included), 400 for
// a bare CR or LF, 431 when the section outgrows the framing budget. The
// fields are the request's `trailers`, kept apart from its headers:
// nothing here knows a trailer's semantics, so none may merge (RFC 9110
// §6.5.1).
function __chunked_trailers(buf: u8[], at: i32, budget: i32, spans: i32[]): (i32, i32, i32[], HeaderMap) {
    var n: i32 = buf.len();
    var trailers: HeaderMap = headers.header_map_new();
    var limit: i32 = at + budget;
    if (limit > n) { limit = n; }
    // The last chunk's own CRLF, at `at - 2`, starts the CRLF CRLF when
    // there are no trailers.
    var sep: i32 = __find_crlf_crlf(buf, at - 2, limit);
    var scanned: i32 = limit;
    if (sep >= 0) { scanned = sep; }
    if (scanned > at && !__crlf_terminated(buf, at, scanned)) { return (400, 0, spans, trailers); }
    if (sep < 0) {
        if (n >= at + budget) { return (431, 0, spans, trailers); }
        return (1, 0, spans, trailers);
    }
    if (sep > at) {
        match (__parse_header_bytes(buf, at, sep)) {
            Ok(h) => { trailers = h; },
            Err(status) => { return (status, 0, spans, trailers); }
        }
    }
    return (2, sep + 4, spans, trailers);
}

// `__chunked_body(buf, spans)` — the chunk data the walk recorded, as
// one array.
function __chunked_body(buf: u8[], spans: i32[]): u8[] {
    var total: i32 = 0;
    var k: i32 = 1;
    while (k < spans.len()) {
        total = total + spans[k];
        k = k + 2;
    }
    var out: u8[] = __alloc_u8(total);
    var o: i32 = 0;
    k = 0;
    while (k + 1 < spans.len()) {
        var start: i32 = spans[k];
        var i: i32 = 0;
        while (i < spans[k + 1]) {
            out = out.with(o + i, buf[start + i]);
            i = i + 1;
        }
        o = o + spans[k + 1];
        k = k + 2;
    }
    return out;
}

// `__framed_body(buf, at, framing, version)` — the body that starts at
// `at` under its framing: `(2, body, end, trailers)` with `end` past it,
// `(1, _, _, _)` while it has not arrived; refused with 413 for a
// declared length past the body cap (known before the body arrives),
// with `__chunked_walk`'s status for a chunked body that breaks its
// rules, and with 400 for chunked coding on a request that is not
// HTTP/1.1 (§6.1 gives the coding to HTTP/1.1; an older peer cannot have
// sent it, and reading its body as empty would be a framing
// disagreement). Only a chunked body has trailers.
function __framed_body(buf: u8[], at: i32, framing: __BodyFraming, version: string): (i32, u8[], i32, HeaderMap) {
    var empty: u8[] = [];
    var none: HeaderMap = headers.header_map_new();
    match (framing) {
        Length(content_length) => {
            if (content_length > http_body_cap()) { return (413, empty, 0, none); }
            if (at + content_length > buf.len()) { return (1, empty, 0, none); }
            return (2, __bytes_range(buf, at, at + content_length), at + content_length, none);
        },
        Chunked => {
            if (version != "HTTP/1.1") { return (400, empty, 0, none); }
            var walk: (i32, i32, i32[], HeaderMap) = __chunked_walk(buf, at);
            if (walk.0 != 2) { return (walk.0, empty, 0, none); }
            return (2, __chunked_body(buf, walk.2), walk.1, walk.3);
        }
    }
    return (400, empty, 0, none);
}

// `http_parse_request_bytes(buf)` parses a full HTTP/1.1 request
// out of the bytes the caller has read from the wire, as they
// came: no text bridge. The caller accumulates bytes via
// `tcp_recv_into` until the buffer holds at least the header
// block (terminated by `\r\n\r\n`) plus Content-Length bytes
// of body — the parser returns None on a partial buffer rather
// than blocking, so callers driving the read loop keep reading
// until the parse succeeds (or a hard cap fires).
//
// A malformed request and a partial one both surface as None here;
// `http_parse_request_framed` tells them apart for a loop that must
// close on the first and keep reading on the second.
//
// What the request keeps are owned copies — the method, the
// path, each header's name and value, the body — so the wire
// buffer is the connection's to reuse once this returns.
pub function http_parse_request_bytes(buf: u8[]): Option[HttpRequest] {
    match (http_parse_request_framed(buf)) {
        Framed(f) => { return Some(f.request); },
        Incomplete => { return None; },
        Continue => { return None; },
        Malformed(_) => { return None; }
    }
    return None;
}

// HttpFramed — a parsed request with its framing: `len` is the bytes it
// occupies at the head of the buffer, so a serve loop can drop them and
// look for the next pipelined request, and `keep_alive` is whether the
// connection persists after its response (RFC 9112 §9.3: HTTP/1.1 unless
// the request says `Connection: close`; HTTP/1.0 only when it says
// `Connection: keep-alive`).
pub struct HttpFramed { request: HttpRequest, len: i32, keep_alive: boolean }

// HttpFraming — what a buffer holds at an offset: a complete request with
// its framing; less than one (the loop keeps reading); less than one
// whose header block has arrived and says `Expect: 100-continue`, so the
// loop sends `100 Continue` once and then keeps reading (RFC 9110
// §10.1.1; a request whose body has already arrived is `Framed` and
// gets no interim response); or a malformed one, carrying the status
// the loop answers it with before closing the connection: 400 for a
// request the grammar refuses (RFC 9112 §2.2, §3, §5, §6.3, §7.1) or
// that breaks the `Host` rule (§3.2), 413 for a body past its cap, 414
// for a request line past its cap, 417 for an expectation other than
// `100-continue`, 431 for a header block past its byte or field cap or
// chunk framing past its budget, 501 for a transfer coding this parser
// cannot decode. There is no lenient mode, and a request past a cap is
// malformed as soon as the cap is passed, before its end has arrived.
pub enum HttpFraming { Framed(HttpFramed), Incomplete, Continue, Malformed(i32) }

// `__expectation(h)` — what the `Expect` field asks (RFC 9110 §10.1.1):
// 0 with none, 1 for `100-continue`, 417 for anything else, which this
// server cannot meet.
function __expectation(h: HeaderMap): i32 {
    var expect: string[] = h.get_all("expect");
    if (expect.len() == 0) { return 0; }
    for v in expect {
        if (!__token_is(v, "100-continue")) { return 417; }
    }
    return 1;
}

// `__header_rules(h, version)` — the status that refuses a parsed header
// block on its own terms, or 0: 400 for the `Host` rule, 417 for an
// expectation the server cannot meet.
function __header_rules(h: HeaderMap, version: string): i32 {
    if (!__host_ok(h, version)) { return 400; }
    if (__expectation(h) == 417) { return 417; }
    return 0;
}

// `__unframed(kind, h)` — the answer for a body that has not framed:
// `Malformed` with `kind` when it is a status, `Continue` when the
// request expects `100 Continue` before sending its body, `Incomplete`
// otherwise.
function __unframed(kind: i32, h: HeaderMap): HttpFraming {
    if (kind >= 400) { return Malformed(kind); }
    if (__expectation(h) == 1) { return Continue; }
    return Incomplete;
}

// `http_parse_request_framed(buf)` — `http_parse_request_bytes` with the
// framing a persistent connection needs, and the three-way answer.
pub function http_parse_request_framed(buf: u8[]): HttpFraming {
    return http_parse_request_framed_from(buf, 0);
}

// `http_parse_request_framed_from(buf, from)` — the same parse over
// buf[from, len): the request behind the ones a serve loop has already
// answered, without copying the rest of the buffer forward. `len` counts
// from `from`.
pub function http_parse_request_framed_from(buf: u8[], from: i32): HttpFraming {
    var n: i32 = buf.len();
    var first_crlf: i32 = __request_line_end(buf, from);
    if (first_crlf == -2) { return Malformed(414); }
    var headers_end: i32 = __header_block_end(buf, from);
    if (headers_end == -2) { return Malformed(431); }
    // What is buffered of the header block, whether or not its end has
    // arrived: the bytes before `from` are answered requests, and the
    // bytes after the block are a body, which may hold anything.
    var scanned: i32 = headers_end;
    if (scanned < 0) {
        scanned = from + http_header_bytes_cap() + 4;
        if (n < scanned) { scanned = n; }
    }
    if (!__crlf_terminated(buf, from, scanned)) { return Malformed(400); }
    // The request line (RFC 9112 §3): a method token, a space, a
    // non-empty target, a space, a non-empty version. It is refused as
    // soon as its CRLF has arrived, before the rest of the block.
    var sp1: i32 = -1;
    var sp2: i32 = -1;
    if (first_crlf >= 0) {
        sp1 = __find_byte(buf, from, first_crlf, 32 as u8);
        if (sp1 < 0 || !__is_token(buf, from, sp1)) { return Malformed(400); }
        sp2 = __find_byte(buf, sp1 + 1, first_crlf, 32 as u8);
        if (sp2 < 0 || sp2 == sp1 + 1 || sp2 + 1 == first_crlf) { return Malformed(400); }
    }
    if (first_crlf < 0 || headers_end < 0) { return Incomplete; }
    var headers_len: i32 = headers_end + 4 - from;
    // Parse the header block into a HeaderMap *first*, then derive
    // Content-Length from it. `first_crlf + 2` skips the CRLF that
    // terminates the request line; `headers_end` is the start of the
    // `\r\n\r\n` separator, so the block excludes the empty line.
    //
    // The two coincide exactly when the request carried no headers at
    // all (`GET / HTTP/1.0\r\n\r\n`): the request line's own CRLF is
    // the first two bytes of the separator. Clamping is what keeps the
    // block from running backwards there.
    var hdr_start: i32 = first_crlf + 2;
    if (hdr_start > headers_end) {
        hdr_start = headers_end;
    }
    var req_headers: HeaderMap = headers.header_map_new();
    match (__parse_header_bytes(buf, hdr_start, headers_end)) {
        Ok(h) => { req_headers = h; },
        Err(status) => { return Malformed(status); }
    }
    var version: string = __bytes_string(buf, sp2 + 1, first_crlf);
    var refused: i32 = __header_rules(req_headers, version);
    if (refused > 0) { return Malformed(refused); }
    var framing: __BodyFraming = Length(0);
    match (__http_body_framing(req_headers)) {
        Ok(f) => { framing = f; },
        Err(status) => { return Malformed(status); }
    }
    var body: (i32, u8[], i32, HeaderMap) = __framed_body(buf, from + headers_len, framing, version);
    if (body.0 != 2) { return __unframed(body.0, req_headers); }
    var request: HttpRequest = HttpRequest {
        method: __bytes_string(buf, from, sp1),
        path: __bytes_string(buf, sp1 + 1, sp2),
        body: stream.stream_from_bytes(body.1),
        headers: req_headers,
        trailers: body.3,
    };
    return Framed(HttpFramed { request: request, len: body.2 - from, keep_alive: __persists(version, req_headers) });
}

// __persists(version, h) — whether the connection outlives this
// request: a `Connection` header carrying `close` ends an HTTP/1.1
// connection where one carrying `keep-alive` extends an HTTP/1.0 one.
// The header is a comma-separated token list, and only a whole token
// counts: `x-close` neither closes nor keeps. A version that is neither
// `HTTP/1.1` nor `HTTP/1.0` is answered and closed; nothing here
// negotiates one.
function __persists(version: string, h: HeaderMap): boolean {
    if (version != "HTTP/1.1" && version != "HTTP/1.0") { return false; }
    var close: boolean = false;
    var keep: boolean = false;
    for v in h.get_all("connection") {
        for tok in v.split(",") {
            if (__token_is(tok, "close")) { close = true; }
            if (__token_is(tok, "keep-alive")) { keep = true; }
        }
    }
    if (close) { return false; }
    if (version == "HTTP/1.0") { return keep; }
    return true;
}

// `http_parse_request(buf)` — the same parse over a request held as
// text: a test's literal, a block already in a string. It costs one
// copy of the bytes; a serve loop holds its buffer as `u8[]` and calls
// `http_parse_request_bytes`.
pub function http_parse_request(buf: string): Option[HttpRequest] {
    return http_parse_request_bytes(buf.bytes());
}

// Reason phrase for the status line. Delegates to the public
// `http_status_text` table (the single source of truth) rather
// than keeping a second, narrower copy that drifted out of sync:
// the old duplicate only knew 13 codes, so a 307 / 429 / 502
// response serialized with the bogus phrase "Status" even though
// `http_status_text` spelled it correctly. Unknown codes still
// fall back to a generic phrase — the kernel doesn't care and
// clients display the numeric code regardless.
function __http_reason(code: i32): string {
    var text: string = http_status_text(code);
    if (text.len() == 0) { return "Status"; }
    return text;
}

// `http_serialize_response(resp)` builds the wire-format
// response from an HttpResponse, advertising `Connection: close`
// so the client's `read()` returns the EOF that tells it the
// response is complete after the caller's `tcp_send` finishes the
// write. No chunked TE.
pub function http_serialize_response(resp: HttpResponse): string {
    return http_serialize_response_conn(resp, false);
}

// `http_serialize_response_conn(resp, keep_alive)` — the response as
// a serve loop sends it to a GET: `Connection: keep-alive` when the
// connection persists for the next request, `Connection: close` when
// this response ends it. Every response carries the header, so an
// HTTP/1.0 client that asked to keep the connection learns that it was
// kept.
pub function http_serialize_response_conn(resp: HttpResponse, keep_alive: boolean): string {
    return http_serialize_response_to("GET", resp, keep_alive);
}

// `http_serialize_response_to(method, resp, keep_alive)` — the response
// as a serve loop sends it to a request made with `method` (RFC 9112
// §6.3): a response to HEAD carries the `Content-Length` its body would
// have and none of the body, and a 1xx, 204 or 304 response carries
// neither, whatever the handler put in the body. Every other response
// carries `Content-Length` and the body.
pub function http_serialize_response_to(method: string, resp: HttpResponse, keep_alive: boolean): string {
    var connection: string = "Connection: close\r\n";
    if (keep_alive) { connection = "Connection: keep-alive\r\n"; }
    var status_line: string = "HTTP/1.1 " + int.int_to_string(resp.status)
        + " " + __http_reason(resp.status) + "\r\n";
    // User-supplied headers first; skip `content-length` and
    // `connection` so the auto-block below stays authoritative.
    // (Names in HeaderMap are case-folded on insert, so a direct
    // string compare against the lowercase sentinel is correct.)
    var hdr_block: string = "";
    var i: i32 = 0;
    while (i < resp.headers.names.len()) {
        var hname: string = resp.headers.names[i];
        if (hname != "content-length" && hname != "connection") {
            hdr_block = hdr_block + hname + ": " + resp.headers.values[i] + "\r\n";
        }
        i = i + 1;
    }
    var bodiless: boolean = resp.status < 200 || resp.status == 204 || resp.status == 304;
    if (!bodiless) {
        hdr_block = hdr_block + "Content-Length: " + int.int_to_string(resp.body_len()) + "\r\n";
    }
    hdr_block = hdr_block + connection + "\r\n";
    if (bodiless || method == "HEAD") { return status_line + hdr_block; }
    return status_line + hdr_block + resp.body_string();
}

// ============================================================
// HttpRequest.body whole-body readers.
//
// The field is a `Stream` (docs/PLATFORM-RESEARCH.md Rec §4):
// a handler that wants the body incrementally takes
// `req.body_stream()` and drives std/stream's cursor methods
// (`read_n`, `read_line`, `read_all`), rebinding the returned
// Stream each step. The three readers here are the
// whole-body shortcuts for handlers that do not care —
// each reads the backing buffer directly rather than the
// cursor, so they answer the same thing however far a
// separate `body_stream()` walk has advanced.
// ============================================================

// `(r: HttpRequest).body_stream()` — the body as a Stream,
// positioned at the start. The entry point for incremental
// reads: `var (line, s) = req.body_stream().read_line();`.
pub function (r: HttpRequest) body_stream(): Stream {
    return r.body;
}

// `(r: HttpRequest).body_string()` — the whole body as a
// UTF-8 string, cursor position ignored.
pub function (r: HttpRequest) body_string(): string {
    return string_from_bytes_unchecked(r.body.data);
}

// `(r: HttpRequest).body_bytes()` — the whole body as a u8
// array, cursor position ignored.
pub function (r: HttpRequest) body_bytes(): u8[] {
    return r.body.data;
}

// `(r: HttpRequest).body_len()` — body length in bytes. The
// whole buffer, not `remaining()`: a handler asking a request
// how big its body is wants the Content-Length answer, not
// what a partial read has left.
pub function (r: HttpRequest) body_len(): i32 {
    return r.body.data.len();
}

// `(r: HttpResponse).body_string()` — body as a UTF-8 string.
// The response-side twin of the HttpRequest readers above.
// A response body stays a `string`: the streaming half of
// Rec §4 gives the response an explicit writer
// (`resp.write` / `flush` / `finish`) rather than a Stream
// field, so that `HttpResponse { status: 200, body: "ok" }`
// keeps working as the sugar the recommendation preserves.
pub function (r: HttpResponse) body_string(): string {
    return r.body;
}

// `(r: HttpResponse).body_bytes()` — body as a u8 array.
pub function (r: HttpResponse) body_bytes(): u8[] {
    return r.body.bytes();
}

// `(r: HttpResponse).body_len()` — body length in bytes.
pub function (r: HttpResponse) body_len(): i32 {
    return r.body.len();
}

// `http_response_bytes(status, bs)` — a response whose body is
// given as bytes rather than a string, so a handler holding
// `u8[]` (an image, a decoded frame, bytes read off a request
// Stream) does not have to spell the conversion itself.
pub function http_response_bytes(status: i32, bs: u8[]): HttpResponse {
    return HttpResponse { status: status, body: string_from_bytes_unchecked(bs), headers: headers.header_map_new() };
}

// ============================================================
// Header convenience methods — the ergonomic immutable-update
// shape for handler code. Under immutable data structures
// `r.headers.set(k, v)` returns a new HeaderMap but can't
// write it back into `r`, so handlers would otherwise need the
// verbose `r = HttpResponse { ...r, headers: r.headers.set(k,
// v) };`. These wrap that into a single rebind — the Rust
// `http` builder idiom: `r = r.with_header("X-Trace", "1");`.
// ============================================================

// `(r: HttpResponse).with_header(name, value)` — replace any
// existing entries for `name` (set semantics) and return the
// updated response. Rebind: `r = r.with_header(k, v);`.
pub function (r: HttpResponse) with_header(name: string, value: string): HttpResponse {
    return HttpResponse { ...r, headers: r.headers.set(name, value) };
}

// `(r: HttpResponse).with_appended_header(name, value)` — add
// an entry without replacing existing same-name entries
// (append semantics — duplicate-safe, e.g. Set-Cookie).
pub function (r: HttpResponse) with_appended_header(name: string, value: string): HttpResponse {
    return HttpResponse { ...r, headers: r.headers.append(name, value) };
}

// `(r: HttpResponse).with_content_type(ct)` — set (replace) the
// `Content-Type` header. Convenience over `with_header` for the
// most common single header a handler overrides; pairs with the
// plain `http_response_*` builders when you want to keep their
// status/body but add a media type:
//   r = http_response_ok(csv).with_content_type("text/csv");
pub function (r: HttpResponse) with_content_type(ct: string): HttpResponse {
    return HttpResponse { ...r, headers: r.headers.set("Content-Type", ct) };
}

// ============================================================
// Cookies (RFC 6265) — the last helper family from the
// 2026-07-02 stdlib review's http list (#4385 noted "no cookie
// helpers"). Request side: read a cookie out of the `Cookie`
// header(s). Response side: a `SetCookie` value with the
// standard attributes, serialized onto the response as an
// appended `Set-Cookie` header (append semantics — one header
// per cookie, per the RFC).
// ============================================================

// `(r: HttpRequest).cookie(name)` — the value of cookie `name`
// from the request's `Cookie` header(s), or None. Parses the
// RFC 6265 §5.4 cookie-string shape (`a=1; b=2`) across every
// `Cookie` header present (clients send one, but proxies can
// split). Names are case-SENSITIVE per the RFC. The value is
// returned raw: surrounding double quotes (allowed by the
// grammar) are not stripped, and no decoding is applied.
pub function (r: HttpRequest) cookie(name: string): Option[string] {
    var hs: string[] = r.headers.get_all("cookie");
    var i: i32 = 0;
    while (i < hs.len()) {
        var parts: string[] = hs[i].split(";");
        var j: i32 = 0;
        while (j < parts.len()) {
            var pair: str = parts[j].trim();
            var eq: i32 = pair.index_of("=");
            if (eq > 0) {
                if (slice_unchecked(pair, 0, eq) == name) {
                    return Some(slice_unchecked(pair, eq + 1, pair.len()).to_owned());
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return None;
}

// `SetCookie` — a response cookie with the standard RFC 6265
// attributes. Build with `cookie_new` / `cookie_delete`, adjust
// fields via struct-update spread, attach with
// `resp.with_set_cookie(c)`:
//
//   var c: SetCookie = http.cookie_new("session", sid);
//   resp = resp.with_set_cookie(SetCookie { ...c, secure: true });
//
// Field conventions: `path`/`same_site` empty = attribute
// omitted; `max_age` negative = omitted (a session cookie),
// `0` = expire immediately (deletion).
pub struct SetCookie {
    name: string,
    value: string,
    path: string,
    max_age: i32,
    http_only: boolean,
    secure: boolean,
    same_site: string,
}

// `cookie_new(name, value)` — a `SetCookie` with the modern
// framework defaults: `Path=/`, session lifetime (no Max-Age),
// `HttpOnly`, `SameSite=Lax`, not `Secure` (defaulting Secure on
// would silently break plain-http development; set it explicitly
// for production HTTPS).
pub function cookie_new(name: string, value: string): SetCookie {
    return SetCookie {
        name: name,
        value: value,
        path: "/",
        max_age: -1,
        http_only: true,
        secure: false,
        same_site: "Lax",
    };
}

// `cookie_delete(name)` — a `SetCookie` that expires the cookie
// immediately (`Max-Age=0`, empty value) on `Path=/`. Attach it
// like any other: `resp = resp.with_set_cookie(http.cookie_delete("session"));`.
pub function cookie_delete(name: string): SetCookie {
    return SetCookie { ...cookie_new(name, ""), max_age: 0 };
}

// `__cookie_clean(s, drop_eq)` — header-injection defence for
// serialize: strip control bytes (CR/LF would let a value inject
// extra headers onto the wire) and the cookie structure bytes `;`
// (and `=` for names). Everything else passes through unchanged;
// callers needing arbitrary bytes in a value should encode first
// (e.g. base64 / percent).
function __cookie_clean(s: string, drop_eq: boolean): string {
    var out: u8[] = [];
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i] as i32;
        var keep: boolean = b >= 32 && b != 59;
        if (drop_eq && b == 61) { keep = false; }
        if (keep) { out = out.append(b as u8); }
        i = i + 1;
    }
    return string_from_bytes_unchecked(out);
}

// `(c: SetCookie).serialize()` — the `Set-Cookie` header VALUE
// (`name=value; Path=/; Max-Age=0; Secure; HttpOnly;
// SameSite=Lax`, attributes in that order, omitted per the field
// conventions on `SetCookie`).
pub function (c: SetCookie) serialize(): string {
    var out: string = __cookie_clean(c.name, true) + "=" + __cookie_clean(c.value, false);
    if (c.path.len() > 0) { out = out + "; Path=" + c.path; }
    if (c.max_age >= 0) { out = out + "; Max-Age=" + int.int_to_string(c.max_age); }
    if (c.secure) { out = out + "; Secure"; }
    if (c.http_only) { out = out + "; HttpOnly"; }
    if (c.same_site.len() > 0) { out = out + "; SameSite=" + c.same_site; }
    return out;
}

// `(r: HttpResponse).with_set_cookie(c)` — append a `Set-Cookie`
// header for `c` (append semantics: each cookie gets its own
// header line, and setting several cookies on one response
// works). Rebind: `r = r.with_set_cookie(c);`.
pub function (r: HttpResponse) with_set_cookie(c: SetCookie): HttpResponse {
    return HttpResponse { ...r, headers: r.headers.append("Set-Cookie", c.serialize()) };
}
