// std/regex — a small regular-expression matcher.
//
// Fern had no pattern-matching engine (#2680). This one parses a pattern
// into a tree (`RNode`) and matches it as a Thompson-style NFA: each step
// carries the SET of text positions the pattern could be at, so
// alternation and the star/plus closures are handled without
// backtracking blow-up (and a star over an empty match can't loop — the
// position set only ever grows, then stops). It's ordinary Fern.
//
// Supported syntax:
//   .            any single byte
//   c            the literal byte `c`
//   [abc]        character class — any one of the listed bytes
//   [a-z]        class with ranges (inclusive, by byte value)
//   [^...]       negated class — any byte NOT listed
//   ( ... )      grouping (scopes a quantifier or an alternation)
//   a|b|c        alternation — match any one alternative
//   *  +  ?      zero-or-more / one-or-more / optional, on the preceding
//                atom OR group (`(ab)+`, `(a|b)*`)
//   {n} {n,} {n,m}  counted repetition: exactly n / at-least n / between n
//                and m, of the preceding atom or group (`a{3}`, `\d{2,4}`)
//   ^            anchor at the start of the text
//   $            anchor at the end of the text
//   \d \w \s     shorthand classes: digit / word (`[A-Za-z0-9_]`) /
//                whitespace; `\D \W \S` are their negations
//   \b \B        word boundary / non-boundary (zero-width, between a
//                `\w` and a non-`\w` byte or a text edge)
//   (?i)…        a leading `(?i)` turns on ASCII case-insensitive matching
//                (A–Z ↔ a–z) for the whole pattern
//   \n \t \r     the newline / tab / carriage-return bytes
//   \<meta>      a backslash before any other byte is that literal byte —
//                use it to match a metacharacter (`\.`, `\(`, `\*`, `\\`, …)
//
// Three entry points, all SEARCHES (the pattern may match anywhere; anchor
// with `^` / `$` for a whole-string match like `"^(cat|dog)$"`):
//   - `regex_match(pattern, text)`  → boolean: did it match anywhere?
//   - `regex_find(pattern, text)`   → i32: start byte index of the leftmost
//                                     match, or -1.
//   - `regex_search(pattern, text)` → RMatch { found, start, end }: the
//                                     leftmost-longest match span; the
//                                     matched text is `text[start:end]`.
// `regex_full_match` requires the pattern to match the whole text;
// `regex_count` returns the number of matches; `regex_find_all` /
// `regex_replace` / `regex_replace_all` / `regex_split` cover the bulk
// operations.
// Matching is on raw bytes, so multi-byte UTF-8 is matched byte-wise. There
// are no capturing-group extractions or backreferences — grouping is purely
// for quantifier / alternation scoping.
//
// Backend note: the matcher and the whole module compile and run on the
// native compiler's interp / x86-64 / arm64 / wasm backends. The grammar's
// recursive-descent PARSER for a `( … )` group currently trips a self-host
// IR codegen bug (#3720) — a struct/array that holds an array-payload enum,
// returned across a recursive parse — so a pattern containing a *grouped*
// subexpression does not yet lower through the self-host compiler. Plain
// (un-grouped) patterns do. The native path is unaffected.

// RNode is the parsed pattern tree. Leaf atoms (`RChar` / `RAny` /
// `RClass` / `RStart` / `REnd`, plus `RBound` for a `\b` / `\B`
// word-boundary assertion) and the composites `RSeq` (concatenation)
// / `RAlt` (alternation) / `RStar` / `RPlus` / `ROpt` (quantifiers over a
// sub-node, which a group makes an arbitrary tree).
pub enum RNode {
    RChar(i32), RAny, RClass(string), RStart, REnd, RBound(boolean),
    RSeq(RNode[]), RAlt(RNode[]), RStar(RNode), RPlus(RNode), ROpt(RNode)
}

// RParse threads the recursive-descent parser's cursor: the node parsed
// so far and the index just past it.
struct RParse { node: RNode, pos: i32 }

// __rx_atom parses one atom: a `( … )` group (transparent — the inner
// tree is returned directly), a `[ … ]` class, `.` / `^` / `$`, or a
// literal byte.
function __rx_atom(p: string, i: i32): RParse {
    var c: i32 = p[i];
    if (c == 92) {                                   // '\' escape
        if (i + 1 >= p.len()) { return RParse { node: RChar(92), pos: i + 1 }; } // trailing → literal '\'
        var d: i32 = p[i + 1];
        // Shorthand classes (and their negations) desugar to an equivalent
        // `[ … ]` class token the matcher already understands.
        if (d == 100) { return RParse { node: RClass("[0-9]"), pos: i + 2 }; }          // \d
        if (d == 68)  { return RParse { node: RClass("[^0-9]"), pos: i + 2 }; }         // \D
        if (d == 119) { return RParse { node: RClass("[A-Za-z0-9_]"), pos: i + 2 }; }   // \w
        if (d == 87)  { return RParse { node: RClass("[^A-Za-z0-9_]"), pos: i + 2 }; }  // \W
        if (d == 115) { return RParse { node: RClass("[ \t\n\r]"), pos: i + 2 }; }      // \s
        if (d == 83)  { return RParse { node: RClass("[^ \t\n\r]"), pos: i + 2 }; }     // \S
        // Word-boundary assertions (zero-width).
        if (d == 98)  { return RParse { node: RBound(true),  pos: i + 2 }; }            // \b
        if (d == 66)  { return RParse { node: RBound(false), pos: i + 2 }; }            // \B
        // Escaped control bytes.
        if (d == 110) { return RParse { node: RChar(10), pos: i + 2 }; }   // \n
        if (d == 116) { return RParse { node: RChar(9),  pos: i + 2 }; }   // \t
        if (d == 114) { return RParse { node: RChar(13), pos: i + 2 }; }   // \r
        // Any other escaped byte is that literal byte — covers the
        // metacharacters `\. \* \+ \? \( \) \[ \] \| \^ \$ \\` etc.
        return RParse { node: RChar(d), pos: i + 2 };
    }
    if (c == 40) {                                   // '('
        var inner: RParse = __rx_alt(p, i + 1);
        var pos: i32 = inner.pos;
        if (pos < p.len() && p[pos] == 41) { pos = pos + 1; }   // ')'
        return RParse { node: inner.node, pos: pos };
    }
    if (c == 91) {                                   // '['
        var j: i32 = i + 1;
        if (j < p.len() && p[j] == 94) { j = j + 1; }            // leading '^'
        if (j < p.len() && p[j] == 93) { j = j + 1; }            // ']' as first member
        while (j < p.len() && p[j] != 93) { j = j + 1; }
        var endb: i32 = j;
        if (endb < p.len()) { endb = endb + 1; }                 // include ']'
        return RParse { node: RClass(p[i : endb] + ""), pos: endb };
    }
    if (c == 46) { return RParse { node: RAny, pos: i + 1 }; }   // '.'
    if (c == 94) { return RParse { node: RStart, pos: i + 1 }; } // '^'
    if (c == 36) { return RParse { node: REnd, pos: i + 1 }; }   // '$'
    return RParse { node: RChar(c), pos: i + 1 };                // literal
}

// __rx_repeat desugars a counted quantifier `node{n,m}` into the existing
// node kinds: `n` required copies, then either an `RStar` (unbounded
// `{n,}`) or `m - n` `ROpt` copies (bounded `{n,m}`). `{n}` is `m == n`.
// Reusing the same `node` value across the copies is safe — the tree is
// immutable during matching.
function __rx_repeat(node: RNode, n: i32, m: i32, has_max: boolean): RNode {
    var items: RNode[] = [];
    var i: i32 = 0;
    while (i < n) { items = items.append(node); i = i + 1; }
    if (!has_max) {
        items = items.append(RStar(node));
    } else {
        var k: i32 = n;
        while (k < m) { items = items.append(ROpt(node)); k = k + 1; }
    }
    if (items.len() == 1) { return items[0]; }
    return RSeq(items);
}

// __rx_count parses a `{n}` / `{n,}` / `{n,m}` counted quantifier following
// an atom and applies it. A malformed run (no leading count, or no closing
// `}`) is NOT consumed — the caller leaves the `{` to be read as a literal
// byte, matching the lenient behaviour of most engines. `a` is the
// already-parsed atom at index `pos` (the `{`).
function __rx_count(p: string, pos: i32, a: RParse): RParse {
    var j: i32 = pos + 1;
    var n: i32 = 0;
    var have_n: boolean = false;
    while (j < p.len() && p[j] >= 48 && p[j] <= 57) { n = n * 10 + (p[j] - 48); j = j + 1; have_n = true; }
    if (!have_n) { return a; }
    var m: i32 = n;
    var has_max: boolean = true;
    if (j < p.len() && p[j] == 44) {                 // ','
        j = j + 1;
        if (j < p.len() && p[j] == 125) {            // `{n,}`
            has_max = false;
        } else {
            m = 0;
            while (j < p.len() && p[j] >= 48 && p[j] <= 57) { m = m * 10 + (p[j] - 48); j = j + 1; }
        }
    }
    if (j >= p.len() || p[j] != 125) { return a; }   // no closing '}' → literal '{'
    return RParse { node: __rx_repeat(a.node, n, m, has_max), pos: j + 1 };
}

// __rx_quant parses an atom plus an optional trailing quantifier:
// `*` / `+` / `?`, or a counted `{n}` / `{n,}` / `{n,m}`.
function __rx_quant(p: string, i: i32): RParse {
    var a: RParse = __rx_atom(p, i);
    var pos: i32 = a.pos;
    if (pos < p.len()) {
        var c: i32 = p[pos];
        if (c == 42) { return RParse { node: RStar(a.node), pos: pos + 1 }; }
        if (c == 43) { return RParse { node: RPlus(a.node), pos: pos + 1 }; }
        if (c == 63) { return RParse { node: ROpt(a.node), pos: pos + 1 }; }
        if (c == 123) { return __rx_count(p, pos, a); }   // '{'
    }
    return a;
}

// __rx_seq parses a concatenation of quantified atoms, stopping at `|` or
// `)` (or end). An empty run yields `RSeq([])`, which matches the empty
// string (so `a|` and `()` behave).
function __rx_seq(p: string, i: i32): RParse {
    var items: RNode[] = [];
    var pos: i32 = i;
    while (pos < p.len() && p[pos] != 124 && p[pos] != 41) {     // not '|' / ')'
        var q: RParse = __rx_quant(p, pos);
        items = items.append(q.node);
        pos = q.pos;
    }
    if (items.len() == 1) { return RParse { node: items[0], pos: pos }; }
    return RParse { node: RSeq(items), pos: pos };
}

// __rx_alt parses `seq ('|' seq)*`, the top of the grammar (also entered
// for the body of each group).
function __rx_alt(p: string, i: i32): RParse {
    var first: RParse = __rx_seq(p, i);
    var branches: RNode[] = [first.node];
    var pos: i32 = first.pos;
    while (pos < p.len() && p[pos] == 124) {                     // '|'
        var nxt: RParse = __rx_seq(p, pos + 1);
        branches = branches.append(nxt.node);
        pos = nxt.pos;
    }
    if (branches.len() == 1) { return RParse { node: branches[0], pos: pos }; }
    return RParse { node: RAlt(branches), pos: pos };
}

// __rx_is_word reports whether byte `c` is a word character (`[A-Za-z0-9_]`)
// — the alphabet a `\b` word boundary is defined against.
function __rx_is_word(c: i32): boolean {
    if (c >= 48 && c <= 57) { return true; }    // 0-9
    if (c >= 65 && c <= 90) { return true; }    // A-Z
    if (c >= 97 && c <= 122) { return true; }   // a-z
    if (c == 95) { return true; }               // _
    return false;
}

function __rx_has(xs: i32[], v: i32): boolean {
    var i: i32 = 0;
    while (i < xs.len()) { if (xs[i] == v) { return true; } i = i + 1; }
    return false;
}

// __rx_fold lowercases an ASCII uppercase byte when case-insensitive
// matching (`ci`) is on; otherwise returns the byte unchanged. The whole
// case-insensitive story is ASCII A–Z ↔ a–z.
function __rx_fold(c: i32, ci: boolean): i32 {
    if (ci && c >= 65 && c <= 90) { return c + 32; }
    return c;
}

// RProg is a compiled pattern: the parsed tree plus whether matching is
// case-insensitive (set by a leading `(?i)` flag).
pub struct RProg { root: RNode, ci: boolean }

// __rx_compile parses `pattern`, honouring a leading `(?i)` flag that turns
// on ASCII case-insensitive matching for the entire pattern. All the public
// entry points compile through here, so `(?i)` works uniformly.
function __rx_compile(pattern: string): RProg {
    if (pattern.len() >= 4 && pattern[0 : 4] == "(?i)") {
        return RProg { root: __rx_alt(pattern, 4).node, ci: true };
    }
    return RProg { root: __rx_alt(pattern, 0).node, ci: false };
}

// __rx_class tests a byte against a `[ … ]` class token (including its
// brackets): ranges `a-b`, a leading `^` negation, and bare members. Under
// `ci`, the candidate byte and the class members/bounds are folded.
function __rx_class(tok: string, c0: i32, ci: boolean): boolean {
    var c: i32 = __rx_fold(c0, ci);
    var j: i32 = 1;                       // skip '['
    var neg: boolean = false;
    if (j < tok.len() && tok[j] == 94) { neg = true; j = j + 1; }
    var found: boolean = false;
    var end: i32 = tok.len() - 1;         // index of ']'
    while (j < end) {
        if (tok[j + 1] == 45 && j + 2 < end) {       // 'a' '-' 'b'
            if (c >= __rx_fold(tok[j], ci) && c <= __rx_fold(tok[j + 2], ci)) { found = true; }
            j = j + 3;
        } else {
            if (c == __rx_fold(tok[j], ci)) { found = true; }
            j = j + 1;
        }
    }
    if (neg) { return !found; }
    return found;
}

// __rx_closure computes every text position reachable from `ti` by
// matching `inner` zero-or-more (`allow_zero`, for `*`) or one-or-more
// (for `+`) times. A breadth-first set expansion: dedup against `seen`
// guarantees termination even when `inner` can match the empty string.
function __rx_closure(inner: RNode, t: string, ti: i32, allow_zero: boolean, ci: boolean): i32[] {
    var seen: i32[] = [];
    var frontier: i32[] = [];
    if (allow_zero) {
        seen = seen.append(ti);
        frontier = frontier.append(ti);
    } else {
        var first: i32[] = __rx_match(inner, t, ti, ci);
        var s: i32 = 0;
        while (s < first.len()) {
            if (!__rx_has(seen, first[s])) { seen = seen.append(first[s]); frontier = frontier.append(first[s]); }
            s = s + 1;
        }
    }
    while (frontier.len() > 0) {
        var nf: i32[] = [];
        var m: i32 = 0;
        while (m < frontier.len()) {
            var sub: i32[] = __rx_match(inner, t, frontier[m], ci);
            var s2: i32 = 0;
            while (s2 < sub.len()) {
                if (!__rx_has(seen, sub[s2])) { seen = seen.append(sub[s2]); nf = nf.append(sub[s2]); }
                s2 = s2 + 1;
            }
            m = m + 1;
        }
        frontier = nf;
    }
    return seen;
}

// __rx_match returns the set of text positions at which a match of `n`
// starting at `ti` can END (empty = no match). Anchors contribute the
// current position when satisfied; `RSeq` threads the set through each
// child; `RAlt` unions the alternatives.
function __rx_match(n: RNode, t: string, ti: i32, ci: boolean): i32[] {
    match (n) {
        RChar(c) => { var e: i32[] = []; if (ti < t.len() && __rx_fold(t[ti], ci) == __rx_fold(c, ci)) { e = e.append(ti + 1); } return e; },
        RAny => { var e: i32[] = []; if (ti < t.len()) { e = e.append(ti + 1); } return e; },
        RClass(tok) => { var e: i32[] = []; if (ti < t.len() && __rx_class(tok, t[ti], ci)) { e = e.append(ti + 1); } return e; },
        RStart => { var e: i32[] = []; if (ti == 0) { e = e.append(ti); } return e; },
        REnd => { var e: i32[] = []; if (ti >= t.len()) { e = e.append(ti); } return e; },
        RBound(want) => {
            var before: boolean = false;
            if (ti > 0) { before = __rx_is_word(t[ti - 1]); }
            var after: boolean = false;
            if (ti < t.len()) { after = __rx_is_word(t[ti]); }
            var e: i32[] = [];
            if ((before != after) == want) { e = e.append(ti); }   // zero-width
            return e;
        },
        RSeq(xs) => {
            var cur: i32[] = [ti];
            var k: i32 = 0;
            while (k < xs.len()) {
                var nextset: i32[] = [];
                var m: i32 = 0;
                while (m < cur.len()) {
                    var sub: i32[] = __rx_match(xs[k], t, cur[m], ci);
                    var s: i32 = 0;
                    while (s < sub.len()) { if (!__rx_has(nextset, sub[s])) { nextset = nextset.append(sub[s]); } s = s + 1; }
                    m = m + 1;
                }
                cur = nextset;
                k = k + 1;
            }
            return cur;
        },
        RAlt(xs) => {
            var out: i32[] = [];
            var k: i32 = 0;
            while (k < xs.len()) {
                var sub: i32[] = __rx_match(xs[k], t, ti, ci);
                var s: i32 = 0;
                while (s < sub.len()) { if (!__rx_has(out, sub[s])) { out = out.append(sub[s]); } s = s + 1; }
                k = k + 1;
            }
            return out;
        },
        ROpt(inner) => {
            var out: i32[] = [ti];
            var sub: i32[] = __rx_match(inner, t, ti, ci);
            var s: i32 = 0;
            while (s < sub.len()) { if (!__rx_has(out, sub[s])) { out = out.append(sub[s]); } s = s + 1; }
            return out;
        },
        RStar(inner) => { return __rx_closure(inner, t, ti, true, ci); },
        RPlus(inner) => { return __rx_closure(inner, t, ti, false, ci); }
    }
}

// RMatch is the result of `regex_search`: whether a match was found and,
// if so, its half-open byte span `[start, end)` in the text. On no match,
// `found` is false and `start` / `end` are -1. The matched substring is
// `text[start:end]`.
pub struct RMatch { found: boolean, start: i32, end: i32 }

// __rx_search_from finds the LEFTMOST match of an already-parsed tree at or
// after byte offset `from`, returning its span. Among matches that start at
// the leftmost position it takes the longest end (greedy), so
// `text[start:end]` is the longest leftmost match — the conventional search
// semantics. The scanning helper behind search / find_all / replace / split.
function __rx_search_from(root: RNode, text: string, from: i32, ci: boolean): RMatch {
    var ti: i32 = from;
    while (true) {
        var ends: i32[] = __rx_match(root, text, ti, ci);
        if (ends.len() > 0) {
            var best: i32 = ends[0];
            var i: i32 = 1;
            while (i < ends.len()) { if (ends[i] > best) { best = ends[i]; } i = i + 1; }
            return RMatch { found: true, start: ti, end: best };
        }
        if (ti >= text.len()) { return RMatch { found: false, start: 0 - 1, end: 0 - 1 }; }
        ti = ti + 1;
    }
    return RMatch { found: false, start: 0 - 1, end: 0 - 1 };
}

// `regex_search(pattern, text)` — find the leftmost-longest match of
// `pattern` in `text` and return its `RMatch` span (`found` false on no
// match). The pattern is parsed once; a `^` / `$` anchor self-limits the
// match.
pub function regex_search(pattern: string, text: string): RMatch {
    var prog: RProg = __rx_compile(pattern);
    return __rx_search_from(prog.root, text, 0, prog.ci);
}

// `regex_match(pattern, text)` — true when `pattern` matches anywhere in
// `text` (a search). A `^` / `$` anchor in the pattern self-limits the
// match.
pub function regex_match(pattern: string, text: string): boolean {
    return regex_search(pattern, text).found;
}

// `regex_find(pattern, text)` — the start byte index of the leftmost match,
// or -1 if the pattern doesn't match anywhere. The position counterpart to
// the boolean `regex_match`; pair with `regex_search` when the end / the
// matched substring is also needed.
pub function regex_find(pattern: string, text: string): i32 {
    var m: RMatch = regex_search(pattern, text);
    if (m.found) { return m.start; }
    return 0 - 1;
}

// __rx_advance returns the next scan position after a match, always making
// progress: the match's end, or one past its start for a zero-width match
// (`a*` matching empty) so the left-to-right scanners can't loop forever.
function __rx_advance(m: RMatch): i32 {
    if (m.end > m.start) { return m.end; }
    return m.start + 1;
}

// `regex_find_all(pattern, text)` — every non-overlapping leftmost-longest
// match, left to right, as an `RMatch[]`. A zero-width match advances one
// byte so the scan terminates; the result is empty when nothing matches.
pub function regex_find_all(pattern: string, text: string): RMatch[] {
    var prog: RProg = __rx_compile(pattern);
    var out: RMatch[] = [];
    var pos: i32 = 0;
    while (pos <= text.len()) {
        var m: RMatch = __rx_search_from(prog.root, text, pos, prog.ci);
        if (!m.found) { return out; }
        out = out.append(m);
        pos = __rx_advance(m);
    }
    return out;
}

// `regex_replace_all(pattern, text, repl)` — replace every non-overlapping
// match of `pattern` with the literal string `repl`, returning the new
// string. `repl` is inserted verbatim (no `$1`/`\1` group substitution).
pub function regex_replace_all(pattern: string, text: string, repl: string): string {
    var prog: RProg = __rx_compile(pattern);
    // Collect the output pieces in one scan (amortized-O(1) appends, like
    // regex_find_all), summing their lengths, then fill one exact-size buffer
    // (#4379). The old `out = out + text[…] + repl` per match recopied the
    // whole growing result on every step -- O(output²) on a match-dense text.
    var parts: string[] = [];
    var total: i32 = 0;
    var last: i32 = 0;          // end of the text already emitted
    var pos: i32 = 0;
    var done: boolean = false;
    while (!done && pos <= text.len()) {
        var m: RMatch = __rx_search_from(prog.root, text, pos, prog.ci);
        if (!m.found) {
            done = true;
        } else {
            var seg: string = text[last : m.start] + "";
            parts = parts.append(seg);  total = total + seg.len();
            parts = parts.append(repl); total = total + repl.len();
            last = m.end;
            var nxt: i32 = __rx_advance(m);
            // a zero-width match leaves `last` at m.start; carry the skipped
            // byte into the output by emitting it before advancing.
            if (m.end <= m.start && nxt <= text.len() && nxt > last) {
                var z: string = text[last : nxt] + "";
                parts = parts.append(z);  total = total + z.len();
                last = nxt;
            }
            pos = nxt;
        }
    }
    var tail: string = text[last : text.len()] + "";
    parts = parts.append(tail); total = total + tail.len();
    var buf: u8[] = __alloc_u8(total);
    var bpos: i32 = 0;
    var pi: i32 = 0;
    while (pi < parts.len()) {
        var s: string = parts[pi];
        var sl: i32 = s.len();
        var k: i32 = 0;
        while (k < sl) {
            buf = buf.with(bpos, s[k] as u8);
            bpos = bpos + 1;
            k = k + 1;
        }
        pi = pi + 1;
    }
    return string_from_bytes(buf);
}

// `regex_split(text, pattern)` — split `text` on non-overlapping matches of
// `pattern`, returning the pieces between matches (the separators are
// dropped). Zero-width matches are skipped as separators (so splitting on a
// nullable pattern doesn't shatter the string); a non-matching pattern
// yields the whole text as a single element.
pub function regex_split(text: string, pattern: string): string[] {
    var prog: RProg = __rx_compile(pattern);
    var out: string[] = [];
    var last: i32 = 0;
    var pos: i32 = 0;
    while (pos <= text.len()) {
        var m: RMatch = __rx_search_from(prog.root, text, pos, prog.ci);
        if (!m.found) {
            out = out.append(text[last : text.len()]);
            return out;
        }
        if (m.end > m.start) {           // non-empty separator
            out = out.append(text[last : m.start]);
            last = m.end;
            pos = m.end;
        } else {
            pos = m.start + 1;           // skip a zero-width match
        }
    }
    out = out.append(text[last : text.len()]);
    return out;
}

// `regex_full_match(pattern, text)` — true only when `pattern` matches the
// ENTIRE text (as if anchored `^…$`). Tests whether a match starting at 0
// can end exactly at `text.len()`, so it's correct even when the pattern
// has shorter matches too (`a|aa` fully matches "aa").
pub function regex_full_match(pattern: string, text: string): boolean {
    var prog: RProg = __rx_compile(pattern);
    var ends: i32[] = __rx_match(prog.root, text, 0, prog.ci);
    var i: i32 = 0;
    while (i < ends.len()) {
        if (ends[i] == text.len()) { return true; }
        i = i + 1;
    }
    return false;
}

// `regex_count(pattern, text)` — the number of non-overlapping matches of
// `pattern` in `text` (0 when it doesn't match).
pub function regex_count(pattern: string, text: string): i32 {
    return regex_find_all(pattern, text).len();
}

// `regex_replace(pattern, text, repl)` — replace only the FIRST match of
// `pattern` with the literal `repl`, returning the new string; the text is
// returned unchanged when there is no match. The single-match counterpart
// to `regex_replace_all`.
pub function regex_replace(pattern: string, text: string, repl: string): string {
    var m: RMatch = regex_search(pattern, text);
    if (!m.found) { return text; }
    return text[0 : m.start] + repl + text[m.end : text.len()];
}
