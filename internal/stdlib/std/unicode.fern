// _prop_kept says whether a byte of a name counts: not a space, an
// underscore, a hyphen or a byte outside ASCII.
function _prop_kept(c: i32): boolean {
  return c != 32 && c != 95 && c != 45 && c < 128;
}

// _prop_key gives the loose form of a name, as regex-syntax makes it: no
// "is" at the start, no case, and only the bytes that _prop_kept keeps.
// "isc" stays, as an alias of the category Other.
function _prop_key(name: string): string {
  let from = _prop_is(name);
  let n = 0;
  for i in from..name.len() {
    if (_prop_kept(name[i] as i32)) {
      n += 1;
    }
  }
  let out = __alloc_u8(n);
  n = 0;
  for i in from..name.len() {
    let c = name[i] as i32;
    if (_prop_kept(c)) {
      if (c >= 65 && c <= 90) {
        c += 32;
      }
      out = out.with(n, c as u8);
      n += 1;
    }
  }
  let key = unsafe { string_from_bytes_unchecked(out) };
  return if (from == 2 && key == "c") { "isc" } else { key };
}

// _prop_is gives 2 for a name that starts with "is" in any case, else 0.
function _prop_is(name: string): i32 {
  return if (name.len() >= 2 && (name[0] | 32u8) == 105u8 && (name[1] | 32u8) == 115u8) { 2 } else { 0 };
}

// _prop_index gives the offset and the count of the ranges of a key, or -1
// and 0.
function _prop_index(key: string): (i32, i32) {
  let t = _prop_names_table();
  let i = 0;
  while (i < t.len()) {
    let eq = __memchr(t, 61, i);
    if (eq - i == key.len() && _same_at(t, i, key)) {
      return (_fld(t, eq + 1), _fld(t, eq + 5));
    }
    i = eq + 10;
  }
  return (-1, 0);
}

function _same_at(t: string, at: i32, key: string): boolean {
  for k in 0..key.len() {
    if (t[at + k] != key[k]) {
      return false;
    }
  }
  return true;
}

function _prop_decode(span: (i32, i32)): Option[i32[]] {
  if (span.0 < 0) {
    return None;
  }
  let t = _prop_table();
  let out = __alloc_i32(2 * span.1);
  for k in 0..2 * span.1 {
    out = out.with(k, _fld(t, 8 * span.0 + 4 * k));
  }
  return Some(out);
}

// property_ranges gives the code points of a general category, a script or a
// binary property, as pairs of the first and the last code point of each
// range in order. The name is that of `\p{...}` in a regular expression, as
// regex-syntax reads it: case, spaces, underscores, hyphens and an "is" at
// the start do not count. `gc=`, `sc=`, `General_Category=` and `Script=`, or the
// same names with `:` or `!=`, select the kind of property. Without a kind, a
// binary property comes first, then a general category, then a script.
// An unknown name gives None.
pub function property_ranges(name: string): Option[i32[]] {
  let (op, width) = _prop_op(name);
  if (op >= 0) {
    let kind = _prop_key(slice_unchecked(name, 0, op) + "");
    return _prop_decode(_prop_valued(kind, _prop_key(slice_unchecked(name, op + width, name.len()) + "")));
  }
  let key = _prop_key(name);
  let span = if (key != "cf" && key != "sc" && key != "lc") { _prop_index("bp:" + key) } else { (-1, 0) };
  if (span.0 < 0) {
    span = _prop_index("gc:" + key);
  }
  if (span.0 < 0) {
    span = _prop_index("sc:" + key);
  }
  return _prop_decode(span);
}

// _prop_valued gives the span of the ranges of a value of the property
// kind: a general category, Any, Assigned and ASCII for gc, or a script.
function _prop_valued(kind: string, value: string): (i32, i32) {
  if (kind == "sc" || kind == "script") {
    return _prop_index("sc:" + value);
  }
  if (kind != "gc" && kind != "generalcategory") {
    return (-1, 0);
  }
  let span = _prop_index("gc:" + value);
  if (span.0 < 0 && (value == "any" || value == "assigned" || value == "ascii")) {
    return _prop_index("bp:" + value);
  }
  return span;
}

// _prop_op gives the offset and the width of the operator of a name with a
// kind: the first "!=", else the first ":", else the first "=", or -1.
function _prop_op(name: string): (i32, i32) {
  for i in 0..name.len() {
    if (name[i] == 33u8 && i + 1 < name.len() && name[i + 1] == 61u8) {
      return (i, 2);
    }
  }
  let colon = __memchr(name, 58, 0);
  if (colon >= 0) {
    return (colon, 1);
  }
  return (__memchr(name, 61, 0), 1);
}

// word_ranges gives the word characters of UTS #18, which `\w` matches:
// Alphabetic, Mark, Decimal_Number, Connector_Punctuation and Join_Control.
pub function word_ranges(): i32[] {
  let Some(rs) = _prop_decode(_prop_index("pw:word")) else {
    return [];
  };
  return rs;
}

function _fold_next(cp: i32): i32 {
  let t = _fold_runs_table();
  let lo = 0;
  let hi = t.len() / 16 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 16;
    let rlo = _fld(t, base);
    if (cp < rlo) {
      hi = mid - 1;
    } else if (cp > _fld(t, base + 4)) {
      lo = mid + 1;
    } else if ((cp - rlo & 1) == 0) {
      return cp + _fld(t, base + 8) - 8388608;
    } else {
      return cp + _fld(t, base + 12) - 8388608;
    }
  }
  return cp;
}

// simple_fold gives the next character of the orbit of `c` under simple case
// folding, or `c` when the orbit has no other character. The orbit goes up
// and then comes back to its lowest character: k, then KELVIN SIGN, then K.
pub function simple_fold(c: char): char {
  return _fold_next(c as i32) as char;
}

// fold_equivalents gives the characters that simple case folding makes
// equal to a character from `lo` to `hi`. They can repeat, and they can be in
// the range.
pub function fold_equivalents(lo: char, hi: char): char[] {
  let out: char[] = [];
  let t = _fold_runs_table();
  let first = lo as i32;
  let last = hi as i32;
  let k = 0;
  let runs = t.len() / 16;
  while (k < runs && _fld(t, 16 * k + 4) < first) {
    k += 1;
  }
  while (k < runs && _fld(t, 16 * k) <= last) {
    let from = _fld(t, 16 * k);
    let to = _fld(t, 16 * k + 4);
    if (from < first) {
      from = first;
    }
    if (to > last) {
      to = last;
    }
    for cp in from..to + 1 {
      let x = _fold_next(cp);
      while (x != cp) {
        out = out.append(x as char);
        x = _fold_next(x);
      }
    }
    k += 1;
  }
  return out;
}

function _dig(c: i32): i32 {
  if (c <= 91) {
    return c - 48;
  }
  return c - 49;
}

function _fld(t: string, i: i32): i32 {
  return _dig(t[i] as i32) << 18 | _dig(t[i + 1] as i32) << 12 | _dig(t[i + 2] as i32) << 6 | _dig(t[i + 3] as i32);
}

function _case_apply(cp: i32, want_upper: boolean): i32 {
  let t = _case_table();
  let lo = 0;
  let hi = t.len() / 20 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 20;
    let rlo = _fld(t, base);
    if (cp < rlo) {
      hi = mid - 1;
    } else if (cp > _fld(t, base + 4)) {
      lo = mid + 1;
    } else {
      if (_fld(t, base + 8) == 0) {
        if (want_upper) {
          return cp + _fld(t, base + 12) - 8388608;
        }
        return cp + _fld(t, base + 16) - 8388608;
      }
      let odd = cp - rlo & 1;
      if (want_upper) {
        return cp - odd;
      }
      return cp + 1 - odd;
    }
  }
  return cp;
}

function _upper_cp(cp: i32): i32 {
  if (cp < 128) {
    if (cp >= 97 && cp <= 122) {
      return cp - 32;
    }
    return cp;
  }
  return _case_apply(cp, true);
}

function _lower_cp(cp: i32): i32 {
  if (cp < 128) {
    if (cp >= 65 && cp <= 90) {
      return cp + 32;
    }
    return cp;
  }
  return _case_apply(cp, false);
}

function _is_ascii(s: string): boolean {
  let n = s.len();
  let i = 0;
  while (i < n) {
    if (s[i] >= 128) {
      return false;
    }
    i += 1;
  }
  return true;
}

function _ascii_fold(s: string, from: i32, to: i32): string {
  let n = s.len();
  let first = 0;
  while (first < n && (s[first] as i32 < from || s[first] as i32 >= from + 26)) {
    first += 1;
  }
  if (first == n) {
    return s;
  }
  let buf = __alloc_u8(n);
  let i = 0;
  while (i < n) {
    let b = s[i] as i32;
    if (b >= from && b < from + 26) {
      b += to - from;
    }
    buf = buf.with(i, b as u8);
    i += 1;
  }
  unsafe {
    return string_from_bytes_unchecked(buf);
  }
}

// _full_case_append appends the full case mapping of `cp` to the scalar buffer.
// The simple table applies when `cp` has no expansion.
// Binary search over 16-character records; a trailing 0 field means the
// expansion is shorter than 3 code points.
function _full_case_append(out: char[], cp: i32, want_upper: boolean): char[] {
  let t = _full_lower_table();
  if (want_upper) {
    t = _full_upper_table();
  }
  let lo = 0;
  let hi = t.len() / 16 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 16;
    let from = _fld(t, base);
    if (cp < from) {
      hi = mid - 1;
    } else if (cp > from) {
      lo = mid + 1;
    } else {
      out = out.append(_fld(t, base + 4) as char);
      let c2 = _fld(t, base + 8);
      if (c2 != 0) {
        out = out.append(c2 as char);
      }
      let c3 = _fld(t, base + 12);
      if (c3 != 0) {
        out = out.append(c3 as char);
      }
      return out;
    }
  }
  return out.append(_case_apply(cp, want_upper) as char);
}

function _final_sigma(s: string, at: i32, sigma_len: i32): boolean {
  let before = false;
  let k = at;
  while (k > 0) {
    let st = utf8.floor_char_boundary(s, k - 1);
    let cp = 65533;
    match (utf8.decode_at(s, st)) {
      Some(pr) => {
        cp = pr.0;
      },
      None => {}
    }
    if (_in_ranges(_caseignorable_ranges(), cp)) {
      k = st;
    } else {
      before = _in_ranges(_cased_ranges(), cp);
      k = 0;
    }
  }
  if (!before) {
    return false;
  }
  let n = s.len();
  let i = at + sigma_len;
  while (i < n) {
    let cp2 = 65533;
    let w = 1;
    match (utf8.decode_at(s, i)) {
      Some(pr2) => {
        cp2 = pr2.0;
        w = pr2.1;
      },
      None => {}
    }
    if (_in_ranges(_caseignorable_ranges(), cp2)) {
      i += w;
    } else {
      return !_in_ranges(_cased_ranges(), cp2);
    }
  }
  return true;
}

// _map_upper and _map_lower decode `s`, map every code point, and
// re-encode. Malformed bytes each become U+FFFD, with one U+FFFD per invalid byte.
//
// FULL mapping: a code point with a 1->N expansion (`ß` -> `SS`, the
// ligatures, the Greek iota-subscript forms) contributes several code
// points, so the result can be longer than the input in BOTH bytes and
// code points. Everything else takes the simple 1:1 table.
//
// These are deliberately TWO functions rather than one taking a direction
// flag. Only the lowercase path needs Final_Sigma, and Final_Sigma reaches
// the Cased and Case_Ignorable range tables — about 8.9 KB. With a shared
// body, per-function DCE cannot tell that an uppercase-only program never
// reaches them, so every such program paid for tables it could not use.
// Do not merge these back together.
function _map_upper(s: string): string {
  let out: char[] = [];
  let n = s.len();
  let i = 0;
  while (i < n) {
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        out = _full_case_append(out, pair.0, true);
        i += pair.1;
      },
      None => {
        out = out.append(65533 as char);
        i += 1;
      }
    }
  }
  return utf8.encode_all(out);
}

function _map_lower(s: string): string {
  let out: char[] = [];
  let n = s.len();
  let i = 0;
  while (i < n) {
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        if (pair.0 == 931 && _final_sigma(s, i, pair.1)) {
          out = out.append(962 as char);
        } else {
          out = _full_case_append(out, pair.0, false);
        }
        i += pair.1;
      },
      None => {
        out = out.append(65533 as char);
        i += 1;
      }
    }
  }
  return utf8.encode_all(out);
}

// `s.to_upper()` — `s` uppercased with FULL Unicode mapping, so
// a code point may expand to several (`ß` -> `SS`). Pure-ASCII input takes
// a byte fold and never touches a table.
pub function (s: string) to_upper(): string {
  if (_is_ascii(s)) {
    return _ascii_fold(s, 97, 65);
  }
  return _map_upper(s);
}

// `s.to_lower()` — `s` lowercased with FULL Unicode mapping.
// Greek Final_Sigma IS applied: a word-final `Σ` becomes `ς`, a
// medial one `σ`.
pub function (s: string) to_lower(): string {
  if (_is_ascii(s)) {
    return _ascii_fold(s, 65, 97);
  }
  return _map_lower(s);
}

// _fold_append appends the case-folded form of one code point.
// Case folding differs from lowercase conversion: `ß`
// folds to `ss` and `ſ` folds to `s`, neither of which the char `to_lower`
// does. Only the differing code points are tabulated; the rest fall
// through to the simple lowercase mapping.
function _fold_append(out: char[], cp: i32): char[] {
  let t = _fold_table();
  let lo = 0;
  let hi = t.len() / 16 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 16;
    let from = _fld(t, base);
    if (cp < from) {
      hi = mid - 1;
    } else if (cp > from) {
      lo = mid + 1;
    } else {
      out = out.append(_fld(t, base + 4) as char);
      let c2 = _fld(t, base + 8);
      if (c2 != 0) {
        out = out.append(c2 as char);
      }
      let c3 = _fld(t, base + 12);
      if (c3 != 0) {
        out = out.append(c3 as char);
      }
      return out;
    }
  }
  return out.append(_lower_cp(cp) as char);
}

// `s.case_fold()` — `s` mapped to a form suitable for caseless comparison.
// NOT the same as lowercasing: folding `ß` gives `ss`, so folding two
// strings and comparing catches equivalences `to_lower` misses. The
// result is for COMPARISON only — it is not meant to be displayed.
pub function (s: string) case_fold(): string {
  if (_is_ascii(s)) {
    return _ascii_fold(s, 65, 97);
  }
  let out: char[] = [];
  let n = s.len();
  let i = 0;
  while (i < n) {
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        out = _fold_append(out, pair.0);
        i += pair.1;
      },
      None => {
        out = out.append(65533 as char);
        i += 1;
      }
    }
  }
  return utf8.encode_all(out);
}

// `a.eq_ignore_case(b)` — caseless equality under full case FOLDING, so
// `ß` and `ss` compare equal and `ſ` matches `s`. Pure-ASCII
// operands stream byte-wise and allocate nothing; anything else folds
// both sides, because a fold can change length and so the two cannot be
// walked in lockstep.
pub function (a: string) eq_ignore_case(b: string): boolean {
  if (_is_ascii(a) && _is_ascii(b)) {
    let na = a.len();
    if (na != b.len()) {
      return false;
    }
    let k = 0;
    while (k < na) {
      let ca = a[k] as i32;
      let cb = b[k] as i32;
      if (ca >= 65 && ca <= 90) {
        ca += 32;
      }
      if (cb >= 65 && cb <= 90) {
        cb += 32;
      }
      if (ca != cb) {
        return false;
      }
      k += 1;
    }
    return true;
  }
  return a.case_fold() == b.case_fold();
}

function _swap_case_cp(cp: i32): i32 {
  if (_is_upper_cp(cp)) {
    return _lower_cp(cp);
  }
  if (_is_lower_cp(cp)) {
    return _upper_cp(cp);
  }
  return cp;
}

// `s.swap_case()` — every uppercase code point becomes lowercase and vice
// versa. Its own inverse on any string whose code points round-trip
// under simple mapping.
pub function (s: string) swap_case(): string {
  if (_is_ascii(s)) {
    let n = s.len();
    let buf = __alloc_u8(n);
    let k = 0;
    while (k < n) {
      let b = s[k] as i32;
      if (b >= 65 && b <= 90) {
        b += 32;
      } else if (b >= 97 && b <= 122) {
        b -= 32;
      }
      buf = buf.with(k, b as u8);
      k += 1;
    }
    unsafe {
      return string_from_bytes_unchecked(buf);
    }
  }
  let out: char[] = [];
  let len = s.len();
  let i = 0;
  while (i < len) {
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        out = out.append(_swap_case_cp(pair.0) as char);
        i += pair.1;
      },
      None => {
        out = out.append(65533 as char);
        i += 1;
      }
    }
  }
  return utf8.encode_all(out);
}

// `s.capitalize()` — uppercase the FIRST code point, leave the rest
// exactly as they are. Not Python's str.capitalize, which also
// lowercases the tail; preserving the tail is the less lossy default.
pub function (s: string) capitalize(): string {
  let n = s.len();
  if (n == 0) {
    return "";
  }
  match (utf8.decode_at(s, 0)) {
    Some(pair) => {
      let up = _upper_cp(pair.0);
      if (up == pair.0) {
        return s;
      }
      return utf8.encode(up as char) + slice_unchecked(s, pair.1, n);
    },
    None => {
      return s;
    }
  }
}

// `s.title_case()` — uppercase the first code point of every
// whitespace-separated word, leaving the rest of each word alone (so
// "FOX" stays "FOX"). Word breaks are any Unicode whitespace, not just
// U+0020 — the ASCII `to_ascii_title_case` breaks on the space byte
// only, so a tab-separated string titles differently between the two.
// This is a word-BREAK notion, not UAX #29 segmentation (#5633).
pub function (s: string) title_case(): string {
  let out: char[] = [];
  let n = s.len();
  let i = 0;
  let at_start = true;
  while (i < n) {
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        let cp = pair.0;
        let mapped = cp;
        if (at_start) {
          mapped = _upper_cp(cp);
        }
        out = out.append(mapped as char);
        at_start = _is_whitespace_cp(cp);
        i += pair.1;
      },
      None => {
        out = out.append(65533 as char);
        at_start = false;
        i += 1;
      }
    }
  }
  return utf8.encode_all(out);
}

function _in_ranges(t: string, cp: i32): boolean {
  let lo = 0;
  let hi = t.len() / 8 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 8;
    if (cp < _fld(t, base)) {
      hi = mid - 1;
    } else if (cp > _fld(t, base + 4)) {
      lo = mid + 1;
    } else {
      return true;
    }
  }
  return false;
}

function _is_letter_cp(cp: i32): boolean {
  if (cp < 128) {
    return cp >= 65 && cp <= 90 || cp >= 97 && cp <= 122;
  }
  return _in_ranges(_letter_ranges(), cp);
}

function _is_digit_cp(cp: i32): boolean {
  if (cp < 128) {
    return cp >= 48 && cp <= 57;
  }
  return _in_ranges(_digit_ranges(), cp);
}

function _is_alnum_cp(cp: i32): boolean {
  return _is_letter_cp(cp) || _is_digit_cp(cp);
}

function _is_whitespace_cp(cp: i32): boolean {
  if (cp < 128) {
    return cp == 32 || cp >= 9 && cp <= 13;
  }
  return _in_ranges(_space_ranges(), cp);
}

function _is_upper_cp(cp: i32): boolean {
  if (cp < 128) {
    return cp >= 65 && cp <= 90;
  }
  return _in_ranges(_upper_ranges(), cp);
}

function _is_lower_cp(cp: i32): boolean {
  if (cp < 128) {
    return cp >= 97 && cp <= 122;
  }
  return _in_ranges(_lower_ranges(), cp);
}

pub function (c: char) to_upper(): char {
  return _upper_cp(c as i32) as char;
}

pub function (c: char) to_lower(): char {
  return _lower_cp(c as i32) as char;
}

pub function (c: char) is_letter(): boolean {
  return _is_letter_cp(c as i32);
}

pub function (c: char) is_digit(): boolean {
  return _is_digit_cp(c as i32);
}

// `c.is_alphanumeric()` — a letter or a decimal digit.
pub function (c: char) is_alphanumeric(): boolean {
  return _is_alnum_cp(c as i32);
}

pub function (c: char) is_whitespace(): boolean {
  return _is_whitespace_cp(c as i32);
}

pub function (c: char) is_upper(): boolean {
  return _is_upper_cp(c as i32);
}

pub function (c: char) is_lower(): boolean {
  return _is_lower_cp(c as i32);
}

function _all_cp(s: string, kind: i32): boolean {
  let n = s.len();
  if (n == 0) {
    return false;
  }
  let i = 0;
  while (i < n) {
    let cp = 65533;
    let w = 1;
    match (utf8.decode_at(s, i)) {
      Some(pr) => {
        cp = pr.0;
        w = pr.1;
      },
      None => {}
    }
    if (kind == 0) {
      if (!_is_letter_cp(cp)) {
        return false;
      }
    } else if (kind == 1) {
      if (!_is_alnum_cp(cp)) {
        return false;
      }
    } else {
      if (!_is_digit_cp(cp)) {
        return false;
      }
    }
    i += w;
  }
  return true;
}

// `is_letters(s)` — every code point is a Unicode letter, so `élan` and
// `Ελλάδα` qualify where the byte-wise ASCII check rejects them.
pub function (s: string) is_letters(): boolean {
  return _all_cp(s, 0);
}

// `is_alphanumeric(s)` — every code point is a letter or a decimal digit.
pub function (s: string) is_alphanumeric(): boolean {
  return _all_cp(s, 1);
}

// `is_digits(s)` — every code point is a Unicode decimal digit (category
// Nd), which includes the Arabic-Indic and fullwidth digits, not just
// ASCII 0-9. Note this is a DIGIT test, not a number-parse test: it says
// nothing about signs, separators or overflow.
pub function (s: string) is_digits(): boolean {
  return _all_cp(s, 2);
}

function _ccc_of(cp: char): i32 {
  let n = cp as i32;
  if (n < 768) {
    return 0;
  }
  let t = _ccc_ranges();
  let lo = 0;
  let hi = t.len() / 12 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 12;
    if (n < _fld(t, base)) {
      hi = mid - 1;
    } else if (n > _fld(t, base + 4)) {
      lo = mid + 1;
    } else {
      return _fld(t, base + 8);
    }
  }
  return 0;
}

function _decomp_append(out: char[], cp: char): char[] {
  let n = cp as i32;
  if (n >= 44032 && n < 55204) {
    let si = n - 44032;
    out = out.append((4352 + si / 588) as char);
    out = out.append((4449 + si % 588 / 28) as char);
    let tj = si % 28;
    if (tj != 0) {
      out = out.append((4519 + tj) as char);
    }
    return out;
  }
  let t = _decomp_table();
  let lo = 0;
  let hi = t.len() / 20 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 20;
    let from = _fld(t, base);
    if (n < from) {
      hi = mid - 1;
    } else if (n > from) {
      lo = mid + 1;
    } else {
      let k = 1;
      while (k <= 4) {
        let c = _fld(t, base + k * 4);
        if (c == 0) {
          return out;
        }
        out = out.append(c as char);
        k += 1;
      }
      return out;
    }
  }
  return out.append(cp);
}

function _canon_order(cps: char[]): char[] {
  let n = cps.len();
  let i = 1;
  while (i < n) {
    let c = _ccc_of(cps[i]);
    if (c != 0) {
      let j = i;
      while (j > 0) {
        if (_ccc_of(cps[j - 1]) <= c) {
          break;
        }
        let tmp = cps[j - 1];
        cps = cps.with(j - 1, cps[j]);
        cps = cps.with(j, tmp);
        j -= 1;
      }
    }
    i += 1;
  }
  return cps;
}

function _compose_pair(a: char, b: char): i32 {
  let x = a as i32;
  let y = b as i32;
  if (x >= 4352 && x < 4371 && y >= 4449 && y < 4470) {
    return 44032 + ((x - 4352) * 21 + (y - 4449)) * 28;
  }
  if (x >= 44032 && x < 55204 && y > 4519 && y < 4547) {
    if ((x - 44032) % 28 == 0) {
      return x + (y - 4519);
    }
    return 0;
  }
  let t = _compose_table();
  let lo = 0;
  let hi = t.len() / 12 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 12;
    let ka = _fld(t, base);
    let kb = _fld(t, base + 4);
    if (x < ka || x == ka && y < kb) {
      hi = mid - 1;
    } else if (x > ka || x == ka && y > kb) {
      lo = mid + 1;
    } else {
      return _fld(t, base + 8);
    }
  }
  return 0;
}

function _nfd_cps(s: string): char[] {
  let cps = s.chars();
  let out: char[] = [];
  let i = 0;
  while (i < cps.len()) {
    out = _decomp_append(out, cps[i]);
    i += 1;
  }
  return _canon_order(out);
}

function _compose(cps: char[]): char[] {
  let n = cps.len();
  if (n == 0) {
    return cps;
  }
  let out: char[] = [];
  out = out.append(cps[0]);
  let starter = -1;
  if (_ccc_of(cps[0]) == 0) {
    starter = 0;
  }
  let prev_cc = -1;
  let i = 1;
  while (i < n) {
    let cp = cps[i];
    let cc = _ccc_of(cp);
    let joined = false;
    if (starter >= 0 && (prev_cc == -1 || prev_cc < cc)) {
      let comp = _compose_pair(out[starter], cp);
      if (comp != 0) {
        out = out.with(starter, comp as char);
        joined = true;
      }
    }
    if (!joined) {
      if (cc == 0) {
        starter = out.len();
        prev_cc = -1;
      } else {
        prev_cc = cc;
      }
      out = out.append(cp);
    }
    i += 1;
  }
  return out;
}

pub function nfd(s: string): string {
  if (_is_ascii(s)) {
    return s;
  }
  return utf8.encode_all(_nfd_cps(s));
}

pub function nfc(s: string): string {
  if (_is_ascii(s)) {
    return s;
  }
  return utf8.encode_all(_compose(_nfd_cps(s)));
}

pub function is_nfd(s: string): boolean {
  if (_is_ascii(s)) {
    return true;
  }
  let cps = s.chars();
  let prev_cc = 0;
  let i = 0;
  while (i < cps.len()) {
    let cp = cps[i];
    if (_in_ranges(_nfd_no_ranges(), cp as i32)) {
      return false;
    }
    let cc = _ccc_of(cp);
    if (cc != 0 && prev_cc > cc) {
      return false;
    }
    prev_cc = cc;
    i += 1;
  }
  return true;
}

pub function is_nfc(s: string): boolean {
  if (_is_ascii(s)) {
    return true;
  }
  let cps = s.chars();
  let prev_cc = 0;
  let i = 0;
  while (i < cps.len()) {
    let cp = cps[i];
    let n = cp as i32;
    let cc = _ccc_of(cp);
    if (cc != 0 && prev_cc > cc) {
      return false;
    }
    if (_in_ranges(_nfc_no_ranges(), n)) {
      return false;
    }
    if (_in_ranges(_nfc_maybe_ranges(), n)) {
      return nfc(s) == s;
    }
    prev_cc = cc;
    i += 1;
  }
  return true;
}

pub function eq_canonical(a: string, b: string): boolean {
  if (a == b) {
    return true;
  }
  return nfc(a) == nfc(b);
}

function _gcb_of(cp: char): i32 {
  let n = cp as i32;
  let t = _gcb_ranges();
  let lo = 0;
  let hi = t.len() / 12 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 12;
    if (n < _fld(t, base)) {
      hi = mid - 1;
    } else if (n > _fld(t, base + 4)) {
      lo = mid + 1;
    } else {
      return _fld(t, base + 8);
    }
  }
  return 0;
}

function _is_extpict(cp: char): boolean {
  return _in_ranges(_extpict_ranges(), cp as i32);
}

function _gcb_break(prev: i32, cur: i32, ri: i32, pict: i32, cur_pict: boolean): boolean {
  if (prev == 1 && cur == 2) {
    return false;
  }
  if (prev == 1 || prev == 2 || prev == 3) {
    return true;
  }
  if (cur == 1 || cur == 2 || cur == 3) {
    return true;
  }
  if (prev == 9 && (cur == 9 || cur == 10 || cur == 12 || cur == 13)) {
    return false;
  }
  if ((prev == 12 || prev == 10) && (cur == 10 || cur == 11)) {
    return false;
  }
  if ((prev == 13 || prev == 11) && cur == 11) {
    return false;
  }
  if (cur == 4 || cur == 5) {
    return false;
  }
  if (cur == 8) {
    return false;
  }
  if (prev == 7) {
    return false;
  }
  if (pict == 2 && cur_pict) {
    return false;
  }
  if (prev == 6 && cur == 6 && ri % 2 == 1) {
    return false;
  }
  return true;
}

function _pict_next(pict: i32, cls: i32, cur_pict: boolean): i32 {
  if (cur_pict) {
    return 1;
  }
  if (pict == 1 && cls == 4) {
    return 1;
  }
  if (pict == 1 && cls == 5) {
    return 2;
  }
  return 0;
}

pub function graphemes(s: string): string[] {
  let out: string[] = [];
  let start = 0;
  let n = s.len();
  if (n == 0) {
    return out;
  }
  let i = 0;
  let prev = -1;
  let ri = 0;
  let pict = 0;
  while (i < n) {
    let cp = 0 as char;
    let w = 1;
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        cp = pair.0 as char;
        w = pair.1;
      },
      None => {
        cp = s[i] as char;
        w = 1;
      }
    }
    let cls = _gcb_of(cp);
    let cur_pict = _is_extpict(cp);
    if (prev >= 0) {
      if (_gcb_break(prev, cls, ri, pict, cur_pict)) {
        out = out.append(slice_unchecked(s, start, i) + "");
        start = i;
      }
    }
    if (cls == 6) {
      ri += 1;
    } else {
      ri = 0;
    }
    pict = _pict_next(pict, cls, cur_pict);
    prev = cls;
    i += w;
  }
  return out.append(slice_unchecked(s, start, n) + "");
}

pub function grapheme_count(s: string): i32 {
  let out = 1;
  let n = s.len();
  if (n == 0) {
    return 0;
  }
  let i = 0;
  let prev = -1;
  let ri = 0;
  let pict = 0;
  while (i < n) {
    let cp = 0 as char;
    let w = 1;
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        cp = pair.0 as char;
        w = pair.1;
      },
      None => {
        cp = s[i] as char;
        w = 1;
      }
    }
    let cls = _gcb_of(cp);
    let cur_pict = _is_extpict(cp);
    if (prev >= 0) {
      if (_gcb_break(prev, cls, ri, pict, cur_pict)) {
        out += 1;
      }
    }
    if (cls == 6) {
      ri += 1;
    } else {
      ri = 0;
    }
    pict = _pict_next(pict, cls, cur_pict);
    prev = cls;
    i += w;
  }
  return out;
}

function _grapheme_ends(s: string): i32[] {
  let out: i32[] = [];
  let n = s.len();
  if (n == 0) {
    return out;
  }
  let i = 0;
  let prev = -1;
  let ri = 0;
  let pict = 0;
  while (i < n) {
    let cp = 0 as char;
    let w = 1;
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        cp = pair.0 as char;
        w = pair.1;
      },
      None => {
        cp = s[i] as char;
        w = 1;
      }
    }
    let cls = _gcb_of(cp);
    let cur_pict = _is_extpict(cp);
    if (prev >= 0) {
      if (_gcb_break(prev, cls, ri, pict, cur_pict)) {
        out = out.append(i);
      }
    }
    if (cls == 6) {
      ri += 1;
    } else {
      ri = 0;
    }
    pict = _pict_next(pict, cls, cur_pict);
    prev = cls;
    i += w;
  }
  return out.append(n);
}

pub function reverse_graphemes(s: string): string {
  let n = s.len();
  if (n == 0) {
    return "";
  }
  let ends = _grapheme_ends(s);
  let bytes = s.bytes();
  let h = buf_new(n);
  let i = ends.len() - 1;
  while (i >= 0) {
    let start = 0;
    if (i > 0) {
      start = ends[i - 1];
    }
    buf_push_bytes_range(h, bytes, start, ends[i]);
    i -= 1;
  }
  let result = "";
  unsafe {
    result = string_from_bytes_unchecked(buf_take_bytes(h));
  }
  buf_free(h);
  return result;
}

function _wb_of(cp: char): i32 {
  let t = _wb_ranges();
  let n = cp as i32;
  let lo = 0;
  let hi = t.len() / 12 - 1;
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2;
    let base = mid * 12;
    if (n < _fld(t, base)) {
      hi = mid - 1;
    } else if (n > _fld(t, base + 4)) {
      lo = mid + 1;
    } else {
      return _fld(t, base + 8);
    }
  }
  return 0;
}

function _wb_ignorable(cls: i32): boolean {
  return cls == 4 || cls == 5 || cls == 7;
}

function _wb_needs_next(cls: i32): boolean {
  return cls == 11 || cls == 12 || cls == 13 || cls == 14 || cls == 15;
}

function _wb_next(s: string, i: i32): i32 {
  let n = s.len();
  let j = i;
  while (j < n) {
    let cp = 0 as char;
    let w = 1;
    match (utf8.decode_at(s, j)) {
      Some(pair) => {
        cp = pair.0 as char;
        w = pair.1;
      },
      None => {
        cp = s[j] as char;
        w = 1;
      }
    }
    let cls = _wb_of(cp);
    if (!_wb_ignorable(cls)) {
      return cls;
    }
    j += w;
  }
  return 0 - 1;
}

function _wb_break(prev2: i32, prev: i32, raw_prev: i32, cur: i32, next: i32, ri: i32, cur_pict: boolean): boolean {
  if (raw_prev == 1 && cur == 2) {
    return false;
  }
  if (raw_prev == 3 || raw_prev == 1 || raw_prev == 2) {
    return true;
  }
  if (cur == 3 || cur == 1 || cur == 2) {
    return true;
  }
  if (raw_prev == 5 && cur_pict) {
    return false;
  }
  if (raw_prev == 18 && cur == 18) {
    return false;
  }
  if (_wb_ignorable(cur)) {
    return false;
  }

  let ah_prev = prev == 10 || prev == 9;
  let ah_prev2 = prev2 == 10 || prev2 == 9;
  let ah_cur = cur == 10 || cur == 9;
  let ah_next = next == 10 || next == 9;
  let mid_letter_q = cur == 14 || cur == 13 || cur == 11;
  let prev_mid_letter_q = prev == 14 || prev == 13 || prev == 11;
  let mid_num_q = cur == 15 || cur == 13 || cur == 11;
  let prev_mid_num_q = prev == 15 || prev == 13 || prev == 11;

  if (ah_prev && ah_cur) {
    return false;
  }
  if (ah_prev && mid_letter_q && ah_next) {
    return false;
  }
  if (ah_prev2 && prev_mid_letter_q && ah_cur) {
    return false;
  }
  if (prev == 9 && cur == 11) {
    return false;
  }
  if (prev == 9 && cur == 12 && next == 9) {
    return false;
  }
  if (prev2 == 9 && prev == 12 && cur == 9) {
    return false;
  }
  if (prev == 16 && cur == 16) {
    return false;
  }
  if (ah_prev && cur == 16) {
    return false;
  }
  if (prev == 16 && ah_cur) {
    return false;
  }
  if (prev2 == 16 && prev_mid_num_q && cur == 16) {
    return false;
  }
  if (prev == 16 && mid_num_q && next == 16) {
    return false;
  }
  if (prev == 8 && cur == 8) {
    return false;
  }
  if ((ah_prev || prev == 16 || prev == 8 || prev == 17) && cur == 17) {
    return false;
  }
  if (prev == 17 && (ah_cur || cur == 16 || cur == 8)) {
    return false;
  }
  if (prev == 6 && cur == 6 && ri % 2 == 1) {
    return false;
  }
  return true;
}

function _wb_is_word(s: string, a: i32, b: i32): boolean {
  let i = a;
  while (i < b) {
    let cp = 0 as char;
    let w = 1;
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        cp = pair.0 as char;
        w = pair.1;
      },
      None => {
        cp = s[i] as char;
        w = 1;
      }
    }
    let n = cp as i32;
    if (_is_letter_cp(n) || _is_digit_cp(n)) {
      return true;
    }
    i += w;
  }
  return false;
}

pub function word_segments(s: string): string[] {
  let out: string[] = [];
  let n = s.len();
  if (n == 0) {
    return out;
  }
  let start = 0;
  let i = 0;
  let prev2 = -1;
  let prev = -1;
  let raw_prev = -1;
  let ri = 0;
  while (i < n) {
    let cp = 0 as char;
    let w = 1;
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        cp = pair.0 as char;
        w = pair.1;
      },
      None => {
        cp = s[i] as char;
        w = 1;
      }
    }
    let cls = _wb_of(cp);
    if (i > 0) {
      let nxt = -1;
      if (_wb_needs_next(cls)) {
        nxt = _wb_next(s, i + w);
      }
      if (_wb_break(prev2, prev, raw_prev, cls, nxt, ri, _is_extpict(cp))) {
        out = out.append(slice_unchecked(s, start, i) + "");
        start = i;
      }
    }
    raw_prev = cls;
    if (!_wb_ignorable(cls)) {
      prev2 = prev;
      prev = cls;
      if (cls == 6) {
        ri += 1;
      } else {
        ri = 0;
      }
    }
    i += w;
  }
  return out.append(slice_unchecked(s, start, n) + "");
}

pub function words(s: string): string[] {
  let segs = word_segments(s);
  let out: string[] = [];
  let i = 0;
  let off = 0;
  while (i < segs.len()) {
    let w = segs[i].len();
    if (_wb_is_word(s, off, off + w)) {
      out = out.append(segs[i]);
    }
    off += w;
    i += 1;
  }
  return out;
}

pub function word_count(s: string): i32 {
  let n = s.len();
  if (n == 0) {
    return 0;
  }
  let count = 0;
  let start = 0;
  let i = 0;
  let prev2 = -1;
  let prev = -1;
  let raw_prev = -1;
  let ri = 0;
  while (i < n) {
    let cp = 0 as char;
    let w = 1;
    match (utf8.decode_at(s, i)) {
      Some(pair) => {
        cp = pair.0 as char;
        w = pair.1;
      },
      None => {
        cp = s[i] as char;
        w = 1;
      }
    }
    let cls = _wb_of(cp);
    if (i > 0) {
      let nxt = -1;
      if (_wb_needs_next(cls)) {
        nxt = _wb_next(s, i + w);
      }
      if (_wb_break(prev2, prev, raw_prev, cls, nxt, ri, _is_extpict(cp))) {
        if (_wb_is_word(s, start, i)) {
          count += 1;
        }
        start = i;
      }
    }
    raw_prev = cls;
    if (!_wb_ignorable(cls)) {
      prev2 = prev;
      prev = cls;
      if (cls == 6) {
        ri += 1;
      } else {
        ri = 0;
      }
    }
    i += w;
  }
  if (_wb_is_word(s, start, n)) {
    count += 1;
  }
  return count;
}
