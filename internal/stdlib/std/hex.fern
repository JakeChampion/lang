// std/hex encodes bytes as hexadecimal text and checks text before decode.
// Decode accepts either case. Invalid bytes and odd lengths return typed errors.
// Encode borrows bytes. Decode returns an owned byte array.

import "std/codec";

function __hex_lower_char(d: i32): i32 {
  if (d < 10) {  // '0' + d
    return d + 48;
  }
  return d + 87;  // 'a' - 10 + d
}

function __hex_upper_char(d: i32): i32 {
  if (d < 10) {  // '0' + d
    return d + 48;
  }
  return d + 55;  // 'A' - 10 + d
}

function __hex_value(c: i32): i32 {
  if (c >= 48 && c < 58) {  // 0-9
    return c - 48;
  }
  if (c >= 97 && c < 103) {  // a-f
    return c - 87;
  }
  if (c >= 65 && c < 71) {  // A-F
    return c - 55;
  }
  return 0 - 1;
}

pub function encode(bs: [u8]): string {
  let n: i32 = bs.len();
  if (n == 0) {
    return "";
  }
  let buf: u8[] = __alloc_u8(n * 2);
  let i: i32 = 0;
  while (i < n) {
    let b: i32 = bs[i] as i32;
    buf = buf.with(i * 2, __hex_lower_char(b >> 4 & 15) as u8);
    buf = buf.with(i * 2 + 1, __hex_lower_char(b & 15) as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(buf);
}

// `encode_upper(b)` — like `encode` but emits uppercase
// `0-9A-F`. Useful where a protocol / display convention calls for
// uppercase hex (MAC addresses, some checksums, fingerprints). Decodes
// with the same `decode` (which accepts either case).
pub function encode_upper(bs: [u8]): string {
  let n: i32 = bs.len();
  if (n == 0) {
    return "";
  }
  let buf: u8[] = __alloc_u8(n * 2);
  let i: i32 = 0;
  while (i < n) {
    let b: i32 = bs[i] as i32;
    buf = buf.with(i * 2, __hex_upper_char(b >> 4 & 15) as u8);
    buf = buf.with(i * 2 + 1, __hex_upper_char(b & 15) as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(buf);
}

// Decode requires complete hexadecimal input. Error offsets count bytes.
pub function decode(input: string): Result[u8[], codec.DecodeError] {
  let i: i32 = 0;
  while (i < input.len()) {
    if (__hex_value(input[i] as i32) < 0) {
      return Err(codec.error("hex", i, codec.InvalidByte(input[i])));
    }
    i = i + 1;
  }
  if (input.len() % 2 != 0) {
    return Err(codec.error("hex", input.len(), codec.InvalidLength));
  }
  let bytes: u8[] = __alloc_u8(input.len() / 2);
  i = 0;
  while (i < bytes.len()) {
    let hi: i32 = __hex_value(input[i * 2] as i32);
    let lo: i32 = __hex_value(input[i * 2 + 1] as i32);
    bytes = bytes.with(i, (hi << 4 | lo) as u8);
    i = i + 1;
  }
  return Ok(bytes);
}
