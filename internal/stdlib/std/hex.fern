// std/hex — lowercase hex encode / decode.
//
// `hex_encode(b)` / `hex_decode(s)` — round-trip
// content-preserving on raw bytes. Encode emits lowercase
// `0-9a-f`. Decode accepts both cases; terminates at the
// first non-hex character or at an odd-length tail without
// raising — partial inputs round-trip cleanly. Companion
// to base64 with no `=` padding.
//
// DECODE yields `u8[]`, not `string` (#5730, decision D9):
// decoding arbitrary hex produces arbitrary bytes, which are
// not UTF-8 and so must not be typed as a `string`. Read the
// result back as text with `std/utf8.from_bytes` when the
// bytes are supposed to be text.
//
// ENCODE still takes a `string` and is still a byte container
// on that side — it is the other half of the same wart. It
// stays for now because it is coupled to `std/crypto`, whose
// digest functions also return bytes as `string`; both move
// together in a later slice of #5730.
//
// No prelude: these are in scope only after a program
// declares `import "std/hex";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

function __hex_lower_char(d: i32): i32 {
    if (d < 10) { return d + 48; }      // '0' + d
    return d + 87;                       // 'a' - 10 + d
}

function __hex_upper_char(d: i32): i32 {
    if (d < 10) { return d + 48; }      // '0' + d
    return d + 55;                       // 'A' - 10 + d
}

function __hex_value(c: i32): i32 {
    if (c >= 48 && c < 58)  { return c - 48; }      // 0-9
    if (c >= 97 && c < 103) { return c - 87; }      // a-f
    if (c >= 65 && c < 71)  { return c - 55; }      // A-F
    return 0 - 1;
}

pub function hex_encode(s: string): string {
    var n: i32 = s.len();
    if (n == 0) { return ""; }
    var buf: u8[] = __alloc_u8(n * 2);
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        buf = buf.with(i * 2, __hex_lower_char((b >> 4) & 15) as u8);
        buf = buf.with(i * 2 + 1, __hex_lower_char(b & 15) as u8);
        i = i + 1;
    }
    return string_from_bytes_unchecked(buf);
}

// `hex_encode_upper(s)` — like `hex_encode` but emits uppercase
// `0-9A-F`. Useful where a protocol / display convention calls for
// uppercase hex (MAC addresses, some checksums, fingerprints). Decodes
// with the same `hex_decode` / `hex_decode_strict` (both accept either
// case).
pub function hex_encode_upper(s: string): string {
    var n: i32 = s.len();
    if (n == 0) { return ""; }
    var buf: u8[] = __alloc_u8(n * 2);
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        buf = buf.with(i * 2, __hex_upper_char((b >> 4) & 15) as u8);
        buf = buf.with(i * 2 + 1, __hex_upper_char(b & 15) as u8);
        i = i + 1;
    }
    return string_from_bytes_unchecked(buf);
}

pub function hex_decode(s: string): u8[] {
    var sLen: i32 = s.len();
    // Walk forward to count consecutive valid hex chars;
    // first non-hex (or odd-length tail) terminates.
    var n: i32 = 0;
    while (n < sLen) {
        if (__hex_value(s[n]) < 0) { break; }
        n = n + 1;
    }
    var pairs: i32 = n / 2;
    if (pairs == 0) { return []; }
    var buf: u8[] = __alloc_u8(pairs);
    var i: i32 = 0;
    while (i < pairs) {
        var hi: i32 = __hex_value(s[i * 2]);
        var lo: i32 = __hex_value(s[i * 2 + 1]);
        buf = buf.with(i, ((hi << 4) | lo) as u8);
        i = i + 1;
    }
    return buf;
}

// `hex_decode_strict(s)` — like `hex_decode` but returns `None` on malformed
// input instead of silently truncating at the first non-hex char or an odd
// tail. Decoding an attacker-supplied signature with the lenient variant
// hides tampering (a bad nibble just shortens the output); the strict variant
// makes malformed input observable (#4384). Every character must be a hex
// digit (either case) and the length must be even (an odd tail can't form a
// byte). `""` decodes to `Some([])`.
pub function hex_decode_strict(s: string): Option[u8[]] {
    var sLen: i32 = s.len();
    var k: i32 = 0;
    while (k < sLen) {
        if (__hex_value(s[k]) < 0) { return None; }
        k = k + 1;
    }
    if (sLen % 2 != 0) { return None; }
    if (sLen == 0) { return Some([]); }
    var pairs: i32 = sLen / 2;
    var buf: u8[] = __alloc_u8(pairs);
    var i: i32 = 0;
    while (i < pairs) {
        var hi: i32 = __hex_value(s[i * 2]);
        var lo: i32 = __hex_value(s[i * 2 + 1]);
        buf = buf.with(i, ((hi << 4) | lo) as u8);
        i = i + 1;
    }
    return Some(buf);
}
