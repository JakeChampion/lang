// This module encodes and decodes hexadecimal data.

function __hex_lower_char(d: i32): i32 {
  if (d < 10) {
    return d + 48;
  }
  return d + 87;
}

function __hex_upper_char(d: i32): i32 {
  if (d < 10) {
    return d + 48;
  }
  return d + 55;
}

function __hex_value(c: i32): i32 {
  if (c >= 48 && c < 58) {
    return c - 48;
  }
  if (c >= 97 && c < 103) {
    return c - 87;
  }
  if (c >= 65 && c < 71) {
    return c - 55;
  }
  return 0 - 1;
}

pub function hex_encode(bs: u8[]): string {
  let n: i32 = bs.len();
  if (n == 0) {
    return "";
  }
  let buf: u8[] = __alloc_u8(n * 2);
  let i: i32 = 0;
  while (i < n) {
    let b: i32 = bs[i] as i32;
    buf = buf.with(i * 2, __hex_lower_char(b >> 4 & 15) as u8);
    buf = buf.with(i * 2 + 1, __hex_lower_char(b & 15) as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(buf);
}

pub function hex_encode_upper(bs: u8[]): string {
  let n: i32 = bs.len();
  if (n == 0) {
    return "";
  }
  let buf: u8[] = __alloc_u8(n * 2);
  let i: i32 = 0;
  while (i < n) {
    let b: i32 = bs[i] as i32;
    buf = buf.with(i * 2, __hex_upper_char(b >> 4 & 15) as u8);
    buf = buf.with(i * 2 + 1, __hex_upper_char(b & 15) as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(buf);
}

pub function hex_decode(s: string): u8[] {
  let sLen: i32 = s.len();
  let n: i32 = 0;
  while (n < sLen) {
    if (__hex_value(s[n] as i32) < 0) {
      break;
    }
    n = n + 1;
  }
  let pairs: i32 = n / 2;
  if (pairs == 0) {
    return [];
  }
  let buf: u8[] = __alloc_u8(pairs);
  let i: i32 = 0;
  while (i < pairs) {
    let hi: i32 = __hex_value(s[i * 2] as i32);
    let lo: i32 = __hex_value(s[i * 2 + 1] as i32);
    buf = buf.with(i, (hi << 4 | lo) as u8);
    i = i + 1;
  }
  return buf;
}

pub function hex_decode_strict(s: string): Option[u8[]] {
  let sLen: i32 = s.len();
  let k: i32 = 0;
  while (k < sLen) {
    if (__hex_value(s[k] as i32) < 0) {
      return None;
    }
    k = k + 1;
  }
  if (sLen % 2 != 0) {
    return None;
  }
  if (sLen == 0) {
    return Some([]);
  }
  let pairs: i32 = sLen / 2;
  let buf: u8[] = __alloc_u8(pairs);
  let i: i32 = 0;
  while (i < pairs) {
    let hi: i32 = __hex_value(s[i * 2] as i32);
    let lo: i32 = __hex_value(s[i * 2 + 1] as i32);
    buf = buf.with(i, (hi << 4 | lo) as u8);
    i = i + 1;
  }
  return Some(buf);
}
