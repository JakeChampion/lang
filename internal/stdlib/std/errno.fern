// std/errno — the errno an IoError stands for, and names for every errno the
// runtime reports.
//
// `IoError.Other(path, message, errno)` carries the errno in LINUX numbering
// on every target: a Darwin or WASI runtime translates its host's number, so
// `errno.of(e) == errno.ENOTDIR` holds wherever the program runs. An errno past
// the runtime's strerror table carries 0, which no constant here equals.
//
//     import "std/errno";
//
//     match (remove_dir(path)) {
//       Err(e) => {
//         if (errno.of(e) == errno.ENOTEMPTY) { … }
//       },
//       Ok(_) => {}
//     }
//
// The constants are internal/tables/strerror's rows, which its
// selfhost_parity_test pins this list to; regenerate with
// `go run ./internal/tables/strerror/gen_selfhost_lists`. Linux has no number
// of its own for ENOATTR or EOPNOTSUPP: each is the errno glibc defines it as
// (ENODATA, ENOTSUP), and a Darwin host's own ENOATTR or EOPNOTSUPP arrives
// carrying that number.

pub const EPERM: i32 = 1;

pub const ENOENT: i32 = 2;

pub const ESRCH: i32 = 3;

pub const EINTR: i32 = 4;

pub const EIO: i32 = 5;

pub const ENXIO: i32 = 6;

pub const E2BIG: i32 = 7;

pub const ENOEXEC: i32 = 8;

pub const EBADF: i32 = 9;

pub const ECHILD: i32 = 10;

pub const EAGAIN: i32 = 11;

pub const ENOMEM: i32 = 12;

pub const EACCES: i32 = 13;

pub const EFAULT: i32 = 14;

pub const EBUSY: i32 = 16;

pub const EEXIST: i32 = 17;

pub const EXDEV: i32 = 18;

pub const ENODEV: i32 = 19;

pub const ENOTDIR: i32 = 20;

pub const EISDIR: i32 = 21;

pub const EINVAL: i32 = 22;

pub const ENFILE: i32 = 23;

pub const EMFILE: i32 = 24;

pub const ENOTTY: i32 = 25;

pub const ETXTBSY: i32 = 26;

pub const EFBIG: i32 = 27;

pub const ENOSPC: i32 = 28;

pub const ESPIPE: i32 = 29;

pub const EROFS: i32 = 30;

pub const EMLINK: i32 = 31;

pub const EPIPE: i32 = 32;

pub const ERANGE: i32 = 34;

pub const EDEADLK: i32 = 35;

pub const ENAMETOOLONG: i32 = 36;

pub const ENOLCK: i32 = 37;

pub const ENOSYS: i32 = 38;

pub const ENOTEMPTY: i32 = 39;

pub const ELOOP: i32 = 40;

pub const ENODATA: i32 = 61;

pub const ENOATTR: i32 = 61;

pub const EOVERFLOW: i32 = 75;

pub const EILSEQ: i32 = 84;

pub const ENOTSOCK: i32 = 88;

pub const EMSGSIZE: i32 = 90;

pub const EPROTOTYPE: i32 = 91;

pub const ENOPROTOOPT: i32 = 92;

pub const EPROTONOSUPPORT: i32 = 93;

pub const ENOTSUP: i32 = 95;

pub const EAFNOSUPPORT: i32 = 97;

pub const EADDRINUSE: i32 = 98;

pub const EADDRNOTAVAIL: i32 = 99;

pub const ENETDOWN: i32 = 100;

pub const ENETUNREACH: i32 = 101;

pub const ENETRESET: i32 = 102;

pub const ECONNABORTED: i32 = 103;

pub const ECONNRESET: i32 = 104;

pub const ENOBUFS: i32 = 105;

pub const EISCONN: i32 = 106;

pub const ENOTCONN: i32 = 107;

pub const ETIMEDOUT: i32 = 110;

pub const ECONNREFUSED: i32 = 111;

pub const EHOSTUNREACH: i32 = 113;

pub const EALREADY: i32 = 114;

pub const EINPROGRESS: i32 = 115;

pub const ESTALE: i32 = 116;

pub const EDQUOT: i32 = 122;

pub const ECANCELED: i32 = 125;

pub const EOWNERDEAD: i32 = 130;

pub const ENOTRECOVERABLE: i32 = 131;

pub const EOPNOTSUPP: i32 = 95;

// `of(e)` — the errno `e` stands for, in Linux numbering. A named variant is
// the errno every runtime classifies into it; `Unsupported` is an operation
// the target does not offer, refused before any host is asked. A host's own
// ENOTSUP arrives as `Other` carrying it.
pub function of(e: IoError): i32 {
  match (e) {
    NotFound(_) => {
      return ENOENT;
    },
    PermissionDenied(_) => {
      return EACCES;
    },
    AlreadyExists(_) => {
      return EEXIST;
    },
    InvalidUtf8(_) => {
      return EILSEQ;
    },
    Interrupted => {
      return EINTR;
    },
    Unsupported => {
      return EOPNOTSUPP;
    },
    Other(_, _, n) => {
      return n;
    }
  }
}
