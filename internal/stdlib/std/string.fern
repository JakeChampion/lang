// std/string — string receiver methods.
//
// Methods were migrated here from the former auto-injected
// magic prelude per docs/PRELUDE-TO-MODULES.md. The prelude was
// removed in Phase 5, so a file now `import "std/string";`
// explicitly to bring the methods into scope.

import "core/int";
// std/string's bodies dispatch (i32) byte methods on `s[i]`
// values — `.to_upper()`, `.is_digit()`, `.is_alpha()`,
// `.is_hex_digit()`, `.to_ascii_string()`. Declaring std/i32
// makes those resolve under no-prelude; modload's stdlib-cycle
// support handles the std/string ↔ std/i32 back-edge.
import "std/i32";
// Plus Array methods on string[] / i32[] values:
// `.reverse().join(" ")` in reverse_words, `.take(...)`, and
// `.index_of(...)` in the trim_chars family.
import "std/array";

// `s.is_empty()` is a length-zero shorthand. The IR's len fold
// resolves `len(s)` to a single i32.load at compile time when
// `s` is statically known to be a string, so this typically
// folds to one i32.eqz at the call site.
pub function (s: string) is_empty(): boolean {
    return s.len() == 0;
}

// `(s: string) to_string()` — identity on strings. Lets the
// f-string lexer's blanket `(<expr>).to_string()` desugar work
// uniformly on every interpolant, regardless of whether the
// interpolant is already a string. Has no runtime cost: the IR's
// inliner collapses the call to its operand.
pub function (s: string) to_string(): string {
    return s;
}

// `s.repeat(n)` — `n` copies of s concatenated. `n <= 0`
// returns empty; `n == 1` returns a fresh independent copy
// of s (the `+` lowering allocates). Quadratic on large n
// because each `+` allocates a fresh buffer; if a benchmark
// shows that's a real bottleneck, drop to a single-pass
// memcpy via a `__memcpy` shim.
pub function (s: string) repeat(n: i32): string {
    if (n <= 0) { return ""; }
    var sl: i32 = s.len();
    if (sl == 0) { return ""; }
    // Fill one exact-size (sl·n) buffer instead of `out = out + s`,
    // which recopied the growing prefix each step (O((sl·n)²) — #4379).
    var buf: u8[] = __alloc_u8(sl * n);
    var pos: i32 = 0;
    var k: i32 = 0;
    while (k < n) {
        var j: i32 = 0;
        while (j < sl) {
            buf = buf.with(pos, s[j] as u8);
            pos = pos + 1;
            j = j + 1;
        }
        k = k + 1;
    }
    return string_from_bytes(buf);
}

// `s.starts_with(prefix)` / `s.ends_with(suffix)` /
// `s.contains(needle)` / `s.index_of(needle)` —
// byte-level prefix / suffix / substring scans. UTF-8
// agnostic: they walk raw bytes, which means a partial-
// codepoint search will match its byte sequence wherever
// it appears (same as Go's `strings.Contains`). Empty
// needle / prefix / suffix return true / 0 to match the
// `strstr` / Go conventions.

pub function (s: string) starts_with(prefix: string): boolean {
    var sLen: i32 = s.len();
    var pLen: i32 = prefix.len();
    if (pLen > sLen) { return false; }
    var i: i32 = 0;
    while (i < pLen) {
        if (s[i] != prefix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub function (s: string) ends_with(suffix: string): boolean {
    var sLen: i32 = s.len();
    var sufLen: i32 = suffix.len();
    if (sufLen > sLen) { return false; }
    var off: i32 = sLen - sufLen;
    var i: i32 = 0;
    while (i < sufLen) {
        if (s[off + i] != suffix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// __substr_eq compares len(needle) bytes starting at
// `offset` in `s` against `needle` byte-by-byte. The
// caller has already bounds-checked `offset + nLen <=
// len(s)`, so this just walks until the first mismatch.
function __substr_eq(s: string, offset: i32, needle: string, nLen: i32): boolean {
    var i: i32 = 0;
    while (i < nLen) {
        if (s[offset + i] != needle[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub function (s: string) contains(needle: string): boolean {
    var nLen: i32 = needle.len();
    if (nLen == 0) { return true; }
    var sLen: i32 = s.len();
    if (nLen > sLen) { return false; }
    var last: i32 = sLen - nLen;
    var i: i32 = 0;
    while (i <= last) {
        if (__substr_eq(s, i, needle, nLen)) { return true; }
        i = i + 1;
    }
    return false;
}

pub function (s: string) index_of(needle: string): i32 {
    var nLen: i32 = needle.len();
    if (nLen == 0) { return 0; }
    var sLen: i32 = s.len();
    if (nLen > sLen) { return 0 - 1; }
    var last: i32 = sLen - nLen;
    var i: i32 = 0;
    while (i <= last) {
        if (__substr_eq(s, i, needle, nLen)) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// `s.last_index_of(needle)` — rightmost occurrence; -1 if
// absent. Empty needle returns len(s) to match Python rfind /
// Go LastIndex conventions (the "match at every gap" trick).
// Walks bytes from the right; O(n*m) worst case like
// index_of.
pub function (s: string) last_index_of(needle: string): i32 {
    var nLen: i32 = needle.len();
    var sLen: i32 = s.len();
    if (nLen == 0) { return sLen; }
    if (nLen > sLen) { return 0 - 1; }
    var i: i32 = sLen - nLen;
    while (i >= 0) {
        if (__substr_eq(s, i, needle, nLen)) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

// `s.find(needle)` / `s.rfind(needle)` — the Option-returning
// companions to `index_of` / `last_index_of`. They report
// "not found" as `None` instead of the `-1` sentinel, which is
// the convention the rest of the stdlib settled on (split_once,
// strip_prefix, the i32[] first_index_of family). Prefer these
// in new code so a forgotten `< 0` check can't silently read a
// bogus index; `index_of` / `last_index_of` stay as the
// low-level i32 form (and the self-host compiler's own builtin).
//
// Empty-needle semantics match the underlying primitive: `find`
// returns `Some(0)` and `rfind` returns `Some(len(s))`, never
// `None`, since an empty needle is always "found".
pub function (s: string) find(needle: string): Option[i32] {
    var idx: i32 = s.index_of(needle);
    if (idx < 0) { return None; }
    return Some(idx);
}

pub function (s: string) rfind(needle: string): Option[i32] {
    var idx: i32 = s.last_index_of(needle);
    if (idx < 0) { return None; }
    return Some(idx);
}

// `s.capitalize()` — uppercase the first byte, leave the
// rest unchanged. ASCII-only: non-letter first bytes pass
// through. Different from `to_upper` (which folds every
// letter) and from Python's str.capitalize (which also
// LOWERCASES the rest — our version intentionally preserves
// the tail since the lossy fold is rarely what callers
// want).
pub function (s: string) capitalize(): string {
    var n: i32 = s.len();
    if (n == 0) { return ""; }
    var first: i32 = s[0].to_upper();
    if (first == s[0]) { return s; }
    var buf: u8[] = __alloc_u8(1);
    buf = buf.with(0, first as u8);
    return string_from_bytes(buf) + s[1:n];
}

// `s.word_count()` — number of whitespace-separated words.
// Same notion as fields(): runs of any ASCII whitespace
// count as a single separator, empty pieces dropped. Empty
// / all-whitespace input returns 0.
pub function (s: string) word_count(): i32 {
    var n: i32 = s.len();
    var c: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        while (i < n && __is_ascii_ws(s[i])) { i = i + 1; }
        if (i >= n) { return c; }
        c = c + 1;
        while (i < n && !__is_ascii_ws(s[i])) { i = i + 1; }
    }
    return c;
}

// `s.escape_html()` — escape the five characters that have
// special meaning in HTML / XML: & < > " '. Produces a
// string safe to splice into element bodies and attribute
// values; matches Go html.EscapeString.
// put_bytes writes src's bytes into buf starting at pos and returns the buffer;
// the caller advances pos by src.len(). buf must already have room. Used by the
// escapers' exact-size second pass so an expanding escape appends in O(len(src))
// instead of the O(n²) `out = out + esc` that recopied the whole result each byte.
function put_bytes(buf: u8[], pos: i32, src: string): u8[] {
    var b: u8[] = buf;
    var j: i32 = 0;
    while (j < src.len()) {
        b = b.with(pos + j, src[j] as u8);
        j = j + 1;
    }
    return b;
}

pub function (s: string) escape_html(): string {
    var n: i32 = s.len();
    // Two passes over one exact-size buffer instead of `out = out + …`, which
    // recopied the growing result each byte (O(n²) — #4379). Pass 1 sizes the
    // output (the five metacharacters expand to 4–5 bytes, everything else is
    // 1:1); pass 2 fills it.
    var total: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 38 || b == 34 || b == 39) { total = total + 5; }   // &amp; &#34; &#39;
        else if (b == 60 || b == 62)       { total = total + 4; }   // &lt; &gt;
        else                               { total = total + 1; }
        i = i + 1;
    }
    var buf: u8[] = __alloc_u8(total);
    var pos: i32 = 0;
    i = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 38)      { buf = put_bytes(buf, pos, "&amp;"); pos = pos + 5; }   // &
        else if (b == 60) { buf = put_bytes(buf, pos, "&lt;");  pos = pos + 4; }   // <
        else if (b == 62) { buf = put_bytes(buf, pos, "&gt;");  pos = pos + 4; }   // >
        else if (b == 34) { buf = put_bytes(buf, pos, "&#34;"); pos = pos + 5; }   // "
        else if (b == 39) { buf = put_bytes(buf, pos, "&#39;"); pos = pos + 5; }   // '
        else              { buf = buf.with(pos, s[i] as u8); pos = pos + 1; }
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `s.strip_quotes()` — if s starts and ends with the same
// quote character (either " or '), return Some(inner).
// Otherwise None. Useful for parsing config files / CLI
// flags / JSON strings where quotes are optional.
pub function (s: string) strip_quotes(): Option[string] {
    var n: i32 = s.len();
    if (n < 2) { return None; }
    var first: i32 = s[0];
    var last: i32 = s[n - 1];
    if ((first == 34 && last == 34) || (first == 39 && last == 39)) {
        return Some(s[1:n - 1].to_owned());
    }
    return None;
}

// `s.leading_count(b)` — number of leading bytes equal to b.
// "    hello".leading_count(32) == 4 (count of spaces).
// Useful for indent detection / column alignment.
pub function (s: string) leading_count(b: i32): i32 {
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n && s[i] == b) { i = i + 1; }
    return i;
}

// `s.trailing_count(b)` — number of trailing bytes equal to b.
// "hello   ".trailing_count(32) == 3. Symmetric to
// leading_count.
pub function (s: string) trailing_count(b: i32): i32 {
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n && s[n - 1 - i] == b) { i = i + 1; }
    return i;
}

// `s.hash_fnv32()` — FNV-1a 32-bit hash of the byte content.
// Non-cryptographic; good for hash-table bucket selection
// and fingerprinting. Constant-time per input length (no
// data-dependent branches). Reference: http://www.isthe.com/
// chongo/tech/comp/fnv/.
//
// Returns u32 because the multiply / xor mixing is defined
// over unsigned arithmetic.
pub function (s: string) hash_fnv32(): u32 {
    // FNV offset basis (decimal: 2166136261); written as
    // (-2128831035 as u32) since lang doesn't lex u32 literals
    // above i32::MAX. The cast preserves the bit pattern.
    var h: u32 = (0 - 2128831035) as u32;
    var prime: u32 = 16777619 as u32;
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n) {
        h = h ^ (s[i] as u32);
        h = h * prime;
        i = i + 1;
    }
    return h;
}

// `(s: string) hash_djb2()` — Bernstein's djb2 hash. Alternate
// non-cryptographic hash to FNV-1a; sometimes a better fit
// for short keys due to the differing mixing. Initial value
// 5381; multiplier 33. Returns u32.
pub function (s: string) hash_djb2(): u32 {
    var h: u32 = 5381 as u32;
    var mult: u32 = 33 as u32;
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n) {
        h = h * mult + (s[i] as u32);
        i = i + 1;
    }
    return h;
}

// `s.escape_c()` — C-style escape: backslash + double-quote
// each become \\ \", and the four whitespace bytes (\n \t
// \r \0) become their two-char escapes. Other bytes pass
// through unchanged. Standard shape for emitting source-
// code-ready string literals.
pub function (s: string) escape_c(): string {
    var n: i32 = s.len();
    // Two-pass exact-size buffer (same as escape_html): the six escaped bytes
    // (\ " \n \t \r \0) each become 2 bytes, everything else passes through 1:1.
    // Replaces the O(n²) `out = out + …` accumulation (#4379).
    var total: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 92 || b == 34 || b == 10 || b == 9 || b == 13 || b == 0) { total = total + 2; }
        else { total = total + 1; }
        i = i + 1;
    }
    var buf: u8[] = __alloc_u8(total);
    var pos: i32 = 0;
    i = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 92)       { buf = put_bytes(buf, pos, "\\\\"); pos = pos + 2; }
        else if (b == 34)  { buf = put_bytes(buf, pos, "\\\""); pos = pos + 2; }
        else if (b == 10)  { buf = put_bytes(buf, pos, "\\n");  pos = pos + 2; }
        else if (b == 9)   { buf = put_bytes(buf, pos, "\\t");  pos = pos + 2; }
        else if (b == 13)  { buf = put_bytes(buf, pos, "\\r");  pos = pos + 2; }
        else if (b == 0)   { buf = put_bytes(buf, pos, "\\0");  pos = pos + 2; }
        else               { buf = buf.with(pos, s[i] as u8); pos = pos + 1; }
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `(s: string) escape_shell()` — POSIX-shell-safe quoting.
// Wraps s in single quotes and replaces any interior `'`
// with the standard close-quote / escaped-single-quote /
// reopen-quote dance: `'` → `'\''`. The result can be
// concatenated into a shell command line without word
// splitting or substitution.
pub function (s: string) escape_shell(): string {
    return "'" + s.replace("'", "'\\''") + "'";
}

// `(s: string) snake_case()` / `kebab_case()` — convert
// camelCase or PascalCase to lower-case-with-separator
// names. Inserts an underscore (or hyphen) before each
// internal capital letter; lowercases everything; leaves
// existing separators (_, -, space) alone besides the case
// fold.
pub function (s: string) snake_case(): string {
    return __case_separator(s, 95);
}

pub function (s: string) kebab_case(): string {
    return __case_separator(s, 45);
}

function __case_separator(s: string, sep_byte: i32): string {
    var n: i32 = s.len();
    // Two-pass exact-size buffer (#4379): an internal uppercase emits sep + its
    // lowercase (2 bytes), every other byte emits 1 (a space becomes the
    // separator, anything else its lowercase). Replaces the O(n²) `out = out + …`
    // accumulation that recopied the growing result each byte.
    var total: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b.is_upper() && i > 0) { total = total + 2; }
        else { total = total + 1; }
        i = i + 1;
    }
    var buf: u8[] = __alloc_u8(total);
    var pos: i32 = 0;
    i = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b.is_upper() && i > 0) {
            buf = buf.with(pos, sep_byte as u8);
            pos = pos + 1;
        }
        if (b == 32) {
            buf = buf.with(pos, sep_byte as u8);
        } else {
            buf = buf.with(pos, b.to_lower() as u8);
        }
        pos = pos + 1;
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `(s: string) slugify()` — turn arbitrary text into a URL slug: lower-
// case, with every run of non-`[a-z0-9]` bytes collapsed to a single
// `-` and no leading/trailing hyphen. `"Hello, World! 2024"` →
// `"hello-world-2024"`, `"  --Foo__Bar--  "` → `"foo-bar"`.
//
// Unlike `kebab_case` (which folds camelCase identifiers but keeps
// punctuation), this is for free-form titles. ASCII-only: any byte
// outside `[a-z0-9]` after lower-casing — punctuation, whitespace, and
// non-ASCII/UTF-8 bytes alike — acts as a separator, so accented
// letters are dropped rather than transliterated. An input with no
// alphanumerics yields `""`.
pub function (s: string) slugify(): string {
    var n: i32 = s.len();
    var out: u8[] = [];
    var pending: boolean = false;   // a separator run is buffered
    var i: i32 = 0;
    while (i < n) {
        var lc: i32 = s[i].to_lower();
        var alnum: boolean = (lc >= 97 && lc <= 122) || (lc >= 48 && lc <= 57);
        if (alnum) {
            // Emit the buffered separator only between alphanumerics, so
            // leading separators (out empty) and trailing ones (never
            // flushed) are dropped and internal runs collapse to one.
            if (pending && out.len() > 0) { out = out.append(45 as u8); }
            pending = false;
            out = out.append(lc as u8);
        } else {
            pending = true;
        }
        i = i + 1;
    }
    return string_from_bytes(out);
}

// `s.is_valid_identifier()` — true if s matches lang's /
// C / JS identifier pattern: starts with a letter or
// underscore, continues with letters / digits / underscores.
// Empty string returns false.
pub function (s: string) is_valid_identifier(): boolean {
    var n: i32 = s.len();
    if (n == 0) { return false; }
    var first: i32 = s[0];
    if (!first.is_alpha() && first != 95) { return false; }
    var i: i32 = 1;
    while (i < n) {
        if (!s[i].is_alnum() && s[i] != 95) { return false; }
        i = i + 1;
    }
    return true;
}

// `s.is_ipv4()` — true if s parses as a dotted-decimal IPv4
// address: four octets, each 0..255, separated by dots. No
// leading-zero check; "0.0.0.0" / "255.255.255.255" / common
// shapes all pass.
//
// Octet parse is a manual digit-walk rather than parse_int: it
// accepts ONLY a run of 1..3 ASCII digits, so a leading sign
// ("+1" / "-1"), embedded whitespace, or an empty octet is
// rejected — the strict shape an IPv4 octet needs (parse_int
// would happily read "+1" / "-1" as 1). (An earlier version of
// this note blamed a since-fixed parse_int i64-comparison bug;
// parse_int("127") returns Some(127) on every backend today.)
pub function (s: string) is_ipv4(): boolean {
    var parts: string[] = s.split(".");
    if (parts.len() != 4) { return false; }
    var i: i32 = 0;
    while (i < 4) {
        var p: string = parts[i];
        var plen: i32 = p.len();
        if (plen == 0 || plen > 3) { return false; }
        var v: i32 = 0;
        var j: i32 = 0;
        while (j < plen) {
            var b: i32 = p[j];
            if (!b.is_digit()) { return false; }
            v = v * 10 + (b - 48);
            j = j + 1;
        }
        if (v < 0 || v > 255) { return false; }
        i = i + 1;
    }
    return true;
}

// `s.is_email_like()` — basic syntactic check: exactly one
// '@' with non-empty local + domain parts, and the domain
// contains at least one dot. Not RFC 5322 compliant (real
// email validation needs a parser); useful as a quick
// sanity check before downstream validation.
//
// Tuple fields are bound to locals before passing to `len` —
// `len(p.0)` directly on a `(string, string)` tuple-field
// access crashes the arm64 backend (the load folds
// incorrectly). Binding through `var` is a safe workaround
// pending a codegen fix.
pub function (s: string) is_email_like(): boolean {
    match (s.split_once("@")) {
        Some(p) => {
            var lo: string = p.0;
            var dom: string = p.1;
            if (lo.len() == 0) { return false; }
            if (dom.len() == 0) { return false; }
            return dom.contains(".");
        },
        None => { return false; },
    }
}

// `s.is_url_like()` — true if s starts with `http://` or
// `https://` and contains at least one dot after the scheme
// (so localhost-style "http://nodot" fails). Very loose
// shape check, like `is_email_like`; defer to a real URL
// parser when one lands.
pub function (s: string) is_url_like(): boolean {
    var rest: str = "";
    if (s.starts_with("https://")) {
        rest = s.remove_prefix("https://");
    } else if (s.starts_with("http://")) {
        rest = s.remove_prefix("http://");
    } else {
        return false;
    }
    if (rest.len() == 0) { return false; }
    return rest.contains(".");
}

// `s.is_json_like()` — true if s (after trimming whitespace)
// starts and ends with matching `{}` or `[]`. Not a real
// JSON validator — just a fast pre-flight check before
// attempting a parse. Empty strings return false.
pub function (s: string) is_json_like(): boolean {
    var t: str = s.trim();
    var n: i32 = t.len();
    if (n < 2) { return false; }
    var first: i32 = t[0];
    var last: i32 = t[n - 1];
    if (first == 123 && last == 125) { return true; }   // { }
    if (first == 91 && last == 93) { return true; }     // [ ]
    return false;
}

// `s.common_prefix(other)` — longest shared leading
// substring. Returns "" when the first byte differs or
// either argument is empty.
pub function (s: string) common_prefix(other: string): str {
    var n: i32 = s.len();
    var m: i32 = other.len();
    var cap: i32 = n;
    if (m < cap) { cap = m; }
    var i: i32 = 0;
    while (i < cap) {
        if (s[i] != other[i]) { return s.take(i); }
        i = i + 1;
    }
    return s.take(cap);
}

// `s.common_suffix(other)` — longest shared trailing
// substring. Returns "" when no overlap or either side
// is empty.
pub function (s: string) common_suffix(other: string): str {
    var n: i32 = s.len();
    var m: i32 = other.len();
    var cap: i32 = n;
    if (m < cap) { cap = m; }
    var i: i32 = 0;
    while (i < cap) {
        if (s[n - 1 - i] != other[m - 1 - i]) {
            return s.drop(n - i);
        }
        i = i + 1;
    }
    return s.drop(n - cap);
}

// `s.starts_with_any(prefixes)` — true if any entry in
// prefixes is a prefix of s. Empty prefixes array → false.
// An empty-string prefix always matches (consistent with
// `starts_with("")`).
pub function (s: string) starts_with_any(prefixes: string[]): boolean {
    var n: i32 = prefixes.len();
    var i: i32 = 0;
    while (i < n) {
        if (s.starts_with(prefixes[i])) { return true; }
        i = i + 1;
    }
    return false;
}

// `s.ends_with_any(suffixes)` — true if any entry in
// suffixes is a suffix of s. Empty suffixes array → false.
pub function (s: string) ends_with_any(suffixes: string[]): boolean {
    var n: i32 = suffixes.len();
    var i: i32 = 0;
    while (i < n) {
        if (s.ends_with(suffixes[i])) { return true; }
        i = i + 1;
    }
    return false;
}

// `s.replace_first(old, new)` — replace only the first
// occurrence of `old` with `new`. Convenience wrapper over
// `replace_n(old, new, 1)`. Empty `old` is a no-op
// (matches `replace`'s semantics).
pub function (s: string) replace_first(old: string, new: string): string {
    return s.replace_n(old, new, 1);
}

// `s.word_at(i)` — Option[string] of the i-th word in s
// using whitespace as separator. Multiple consecutive
// whitespace bytes collapse (driven by `fields()`).
// Negative indices and indices >= word_count return None.
pub function (s: string) word_at(i: i32): Option[string] {
    if (i < 0) { return None; }
    var words: string[] = s.fields();
    if (i >= words.len()) { return None; }
    return Some(words[i]);
}

// `s.word_count_min(min_len)` — count of whitespace-
// delimited words at least `min_len` bytes long.
// `min_len <= 0` counts every word.
pub function (s: string) word_count_min(min_len: i32): i32 {
    var words: string[] = s.fields();
    var n: i32 = words.len();
    var c: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        if (words[i].len() >= min_len) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// `s.longest_word()` — Option[string] of the longest
// whitespace-delimited word. Ties go to the first
// occurrence. Empty / all-whitespace input → None.
pub function (s: string) longest_word(): Option[string] {
    var words: string[] = s.fields();
    var n: i32 = words.len();
    if (n == 0) { return None; }
    var best: string = words[0];
    var i: i32 = 1;
    while (i < n) {
        if (words[i].len() > best.len()) { best = words[i]; }
        i = i + 1;
    }
    return Some(best);
}

// `s.is_quoted()` — true if s has at least 2 bytes and
// the first and last bytes are matching quote characters
// (", `, or '). Doesn't validate escaping inside the
// quotes — purely a shape predicate. Empty / single-char
// strings return false (need at least an opening and
// closing quote).
pub function (s: string) is_quoted(): boolean {
    var n: i32 = s.len();
    if (n < 2) { return false; }
    var first: i32 = s[0];
    var last: i32 = s[n - 1];
    if (first != last) { return false; }
    if (first == 34 || first == 39 || first == 96) { return true; }
    return false;
}

// `s.is_kebab_case()` — true if s is non-empty,
// lowercase / digit / hyphen only, no leading or trailing
// hyphen, and no consecutive hyphens. Matches the
// "url-slug" shape kebab-case usually denotes.
pub function (s: string) is_kebab_case(): boolean {
    var n: i32 = s.len();
    if (n == 0) { return false; }
    if (s[0] == 45 || s[n - 1] == 45) { return false; }   // leading/trailing -
    var i: i32 = 0;
    var prev_hyphen: boolean = false;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 45) {
            if (prev_hyphen) { return false; }
            prev_hyphen = true;
        } else if ((b >= 97 && b <= 122) || (b >= 48 && b <= 57)) {
            prev_hyphen = false;
        } else {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// `s.is_snake_case()` — true if s is non-empty,
// lowercase / digit / underscore only, no leading or
// trailing underscore, and no consecutive underscores.
pub function (s: string) is_snake_case(): boolean {
    var n: i32 = s.len();
    if (n == 0) { return false; }
    if (s[0] == 95 || s[n - 1] == 95) { return false; }   // leading/trailing _
    var i: i32 = 0;
    var prev_under: boolean = false;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 95) {
            if (prev_under) { return false; }
            prev_under = true;
        } else if ((b >= 97 && b <= 122) || (b >= 48 && b <= 57)) {
            prev_under = false;
        } else {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// `s.shift_byte(delta)` — Caesar-style byte shift: each
// byte += delta, wrapping at 256. Negative deltas are
// supported. Useful for simple obfuscation / toy ciphers;
// don't rely on it for security.
pub function (s: string) shift_byte(delta: i32): string {
    var n: i32 = s.len();
    if (n == 0) { return s; }
    var buf: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i] + delta;
        // Normalise into 0..255 with two mods (handles
        // negative deltas correctly — `(-1) % 256 == -1`
        // in i32, hence the second add).
        b = ((b % 256) + 256) % 256;
        buf = buf.with(i, b as u8);
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `__byte_in_set(b, set)` — true iff byte `b` appears anywhere
// in `set`. The shared inner loop behind without_chars /
// contains_only / count_chars_in (and any future set-membership
// string verb). Plain i32/string -> bool (no closures), so it
// stays inside the self-host fixed-point emit surface.
function __byte_in_set(b: i32, set: string): boolean {
    var j: i32 = 0;
    var setLen: i32 = set.len();
    while (j < setLen) {
        if (set[j] == b) { return true; }
        j = j + 1;
    }
    return false;
}

// `s.without_chars(set)` — remove every byte from s that
// appears anywhere in `set`. Empty set → unchanged.
// ASCII-level character class semantics.
pub function (s: string) without_chars(set: string): string {
    var n: i32 = s.len();
    if (n == 0) { return s; }
    if (set.len() == 0) { return s; }
    var buf: u8[] = __alloc_u8(n);
    var pos: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (!__byte_in_set(b, set)) {
            buf = buf.with(pos, b as u8);
            pos = pos + 1;
        }
        i = i + 1;
    }
    var out: u8[] = __alloc_u8(pos);
    var k: i32 = 0;
    while (k < pos) {
        out = out.with(k, buf[k]);
        k = k + 1;
    }
    return string_from_bytes(out);
}

// `s.contains_only(set)` — true if every byte in s is in
// `set`. Empty s → true (vacuous). Empty set with non-empty
// s → false (no characters allowed). ASCII-level.
pub function (s: string) contains_only(set: string): boolean {
    var n: i32 = s.len();
    if (n == 0) { return true; }
    if (set.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < n) {
        if (!__byte_in_set(s[i], set)) { return false; }
        i = i + 1;
    }
    return true;
}

// `s.count_chars_in(set)` — count bytes of s that appear
// in `set`. Counterpart to `without_chars` / `contains_only`.
// Empty set → 0.
pub function (s: string) count_chars_in(set: string): i32 {
    var n: i32 = s.len();
    if (n == 0 || set.len() == 0) { return 0; }
    var c: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        if (__byte_in_set(s[i], set)) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// `s.split_at(i)` — split s into two parts at byte index i.
// Returns a (string, string) tuple. Negative i clamps to 0;
// i >= len(s) puts everything in the first part.
pub function (s: string) split_at(i: i32): (string, string) {
    var n: i32 = s.len();
    var k: i32 = i;
    if (k < 0) { k = 0; }
    if (k > n) { k = n; }
    return (s[0:k].to_owned(), s[k:n].to_owned());
}

// `s.replace_byte(from, to)` — return a copy of s with every
// byte equal to `from` replaced by `to`. ASCII-level; for
// multi-byte sequences use `replace(old, new)`. Both args
// are i32 byte values (use the literal character code or a
// helper like `b'-' as i32`).
pub function (s: string) replace_byte(from: i32, to: i32): string {
    var n: i32 = s.len();
    if (n == 0) { return s; }
    var buf: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == from) { buf = buf.with(i, to as u8); } else { buf = buf.with(i, b as u8); }
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `s.to_acronym()` — first byte of each whitespace-
// separated token, uppercased and concatenated. "hello
// world" → "HW". Empty / all-whitespace input → "".
// ASCII upper-fold only.
pub function (s: string) to_acronym(): string {
    var toks: string[] = s.fields();
    var n: i32 = toks.len();
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var t: string = toks[i];
        if (t.len() > 0) {
            var b: i32 = t[0];
            out = out + (b.to_upper()).to_ascii_string();
        }
        i = i + 1;
    }
    return out;
}

// `s.title_case()` — uppercase the first byte of every
// space-separated word, leave the rest untouched. Splits
// on the literal ' ' byte (preserves multi-space gaps as
// trailing spaces on the previous word the way Go's
// `strings.Title` does). ASCII-only; "FOX" stays "FOX".
pub function (s: string) title_case(): string {
    var n: i32 = s.len();
    if (n == 0) { return s; }
    var buf: u8[] = __alloc_u8(n);
    var prev_space: boolean = true;
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (prev_space) {
            buf = buf.with(i, b.to_upper() as u8);
        } else {
            buf = buf.with(i, b as u8);
        }
        prev_space = (b == 32);
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `s.lines_non_empty()` — like `lines()` but drops empty
// entries. Useful for parsing text that uses blank lines
// as separators where you don't care about them.
pub function (s: string) lines_non_empty(): string[] {
    var raw: string[] = s.lines();
    var n: i32 = raw.len();
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        if (raw[i].len() != 0) { out = out.append(raw[i]); }
        i = i + 1;
    }
    return out;
}

// === String predicates (whole-string ASCII checks) ===
//
// `(s: string) is_ascii_only()` / `is_numeric()` /
// `is_alpha_only()` / `is_alnum_only()` — true iff EVERY
// byte matches the predicate. Empty strings return true for
// is_ascii_only (no non-ASCII bytes) and false for the
// numeric / alpha variants (vacuously empty doesn't qualify
// as a numeric or alphabetic word — matches Python str
// isdigit / isalpha conventions).
//
// Suffix `_only` chosen because the bare names (`is_numeric`,
// `is_alpha`) on a string would shadow the byte-receiver
// versions above. The byte ones are scanner-loop hot paths
// already; renaming would churn user code with no win.

pub function (s: string) is_ascii_only(): boolean {
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n) {
        if (s[i] > 127) { return false; }
        i = i + 1;
    }
    return true;
}

pub function (s: string) is_numeric(): boolean {
    var n: i32 = s.len();
    if (n == 0) { return false; }
    var i: i32 = 0;
    while (i < n) {
        if (!s[i].is_digit()) { return false; }
        i = i + 1;
    }
    return true;
}

pub function (s: string) is_alpha_only(): boolean {
    var n: i32 = s.len();
    if (n == 0) { return false; }
    var i: i32 = 0;
    while (i < n) {
        if (!s[i].is_alpha()) { return false; }
        i = i + 1;
    }
    return true;
}

pub function (s: string) is_alnum_only(): boolean {
    var n: i32 = s.len();
    if (n == 0) { return false; }
    var i: i32 = 0;
    while (i < n) {
        if (!s[i].is_alnum()) { return false; }
        i = i + 1;
    }
    return true;
}

// `s.is_int()` — true if s parses as a decimal integer
// (optional leading `+` / `-`, then one-or-more digits).
// Doesn't check for i32 overflow — `s.parse_int()` is the
// validating + parsing form.
pub function (s: string) is_int(): boolean {
    var n: i32 = s.len();
    if (n == 0) { return false; }
    var i: i32 = 0;
    if (s[0] == 45 || s[0] == 43) { i = 1; }
    if (i >= n) { return false; }
    while (i < n) {
        if (!s[i].is_digit()) { return false; }
        i = i + 1;
    }
    return true;
}

// `s.is_float()` — true if s looks like a decimal float:
// optional sign, digits, optional `.digits`. No exponent
// form (`1e10`) — that's a follow-up. Pure-int strings are
// also accepted (5 → true). Used as a quick "looks numeric"
// check before invoking parse_float.
pub function (s: string) is_float(): boolean {
    var n: i32 = s.len();
    if (n == 0) { return false; }
    var i: i32 = 0;
    if (s[0] == 45 || s[0] == 43) { i = 1; }
    if (i >= n) { return false; }
    var any_digits: boolean = false;
    while (i < n && s[i].is_digit()) {
        any_digits = true;
        i = i + 1;
    }
    if (i < n && s[i] == 46) {
        i = i + 1;
        while (i < n && s[i].is_digit()) {
            any_digits = true;
            i = i + 1;
        }
    }
    return any_digits && i == n;
}

// `s.wrap(prefix, suffix)` — concatenate prefix + s +
// suffix. Saves the multi-+ call site when wrapping a value
// in brackets / quotes / tags. `"x".wrap("[", "]")` →
// `"[x]"`.
pub function (s: string) wrap(prefix: string, suffix: string): string {
    return prefix + s + suffix;
}

// `s.is_blank()` — true if s is empty or contains only ASCII
// whitespace. Differs from is_empty by also matching strings
// of pure tabs / spaces / newlines. Useful for "skip blank
// lines" passes.
pub function (s: string) is_blank(): boolean {
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n) {
        if (!__is_ascii_ws(s[i])) { return false; }
        i = i + 1;
    }
    return true;
}

// `s.is_hex_string()` — every byte is a hex digit (case-
// insensitive). Empty string returns false (mirrors the
// is_numeric / is_alpha_only conventions). Useful for
// validating user-supplied hex hashes / hex-color values.
pub function (s: string) is_hex_string(): boolean {
    var n: i32 = s.len();
    if (n == 0) { return false; }
    var i: i32 = 0;
    while (i < n) {
        if (!s[i].is_hex_digit()) { return false; }
        i = i + 1;
    }
    return true;
}

// `s.indent(prefix)` — prepend prefix to every line of s.
// Empty lines get the prefix too (matches Python textwrap
// indent's default; the predicate-gated variant is a
// follow-up). Lines are determined by '\n'; CRLF input
// gets prefix between the CR and the LF only on the first
// line and after each '\n', which matches the bytewise
// model.
pub function (s: string) indent(prefix: string): string {
    var n: i32 = s.len();
    if (n == 0) { return ""; }
    var pl: i32 = prefix.len();
    // Two-pass exact-size buffer (#4379): the output is the input plus one prefix
    // at the start and after every NON-final newline. Replaces the O(n²)
    // `out = out + …` that recopied the growing result each byte.
    var nl: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        if (s[i] == 10 && i + 1 < n) { nl = nl + 1; }
        i = i + 1;
    }
    var buf: u8[] = __alloc_u8(pl * (1 + nl) + n);
    var pos: i32 = 0;
    buf = put_bytes(buf, pos, prefix);
    pos = pos + pl;
    i = 0;
    while (i < n) {
        buf = buf.with(pos, s[i] as u8);
        pos = pos + 1;
        if (s[i] == 10 && i + 1 < n) {
            buf = put_bytes(buf, pos, prefix);
            pos = pos + pl;
        }
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `s.dedent()` — remove the longest common leading-whitespace prefix
// (spaces / tabs) shared by every non-blank line, the inverse of
// `indent` and Python's `textwrap.dedent`. Lines that are entirely
// whitespace (or empty) are normalised to `""` and don't constrain the
// common prefix, so a blank indented line in a here-doc doesn't defeat
// the dedent. Because the prefix is matched byte-for-byte, a line
// indented with a tab and one indented with spaces share no prefix (as
// in Python). Lines are split on `\n`.
pub function (s: string) dedent(): string {
    var lines: string[] = s.split("\n");
    // First pass: the common leading-whitespace prefix over non-blank lines.
    var common: string = "";
    var have_common: boolean = false;
    var i: i32 = 0;
    while (i < lines.len()) {
        var line: string = lines[i];
        var ws: i32 = 0;
        while (ws < line.len() && (line[ws] == 32 || line[ws] == 9)) { ws = ws + 1; }
        if (ws < line.len()) {                     // has non-whitespace content
            var lead: string = line[0:ws] + "";
            if (!have_common) {
                common = lead;
                have_common = true;
            } else {
                var k: i32 = 0;
                var maxk: i32 = common.len();
                if (lead.len() < maxk) { maxk = lead.len(); }
                while (k < maxk && common[k] == lead[k]) { k = k + 1; }
                common = common[0:k] + "";
            }
        }
        i = i + 1;
    }
    // Second pass: strip `common` from each line; blank lines → "".
    var clen: i32 = common.len();
    var out: string[] = [];
    var j: i32 = 0;
    while (j < lines.len()) {
        var ln: string = lines[j];
        var wsj: i32 = 0;
        while (wsj < ln.len() && (ln[wsj] == 32 || ln[wsj] == 9)) { wsj = wsj + 1; }
        if (wsj == ln.len()) {                     // whitespace-only or empty
            out = out.append("");
        } else {
            out = out.append(ln[clen:ln.len()] + "");
        }
        j = j + 1;
    }
    return out.join("\n");
}

// The trim family returns `str` (#4813 producer flip, slice P1): the
// declared type says "this is a view of the receiver's bytes" even though
// the native/wasm backends still COPY today (the asm-IR path is already
// zero-copy, #4294). Consumers read/pass it freely (borrowed positions)
// and materialise with .to_owned() to store it in an owning sink; E065
// governs escapes. The backend zero-copy convergence is slice P3.
//
// to_owned materialises an OWNED `string` from a borrowed `str` view
// (#4813): `str` shares the `string` method surface, so a view receiver
// dispatches here. `s + ""` is a fresh-owned producer on EVERY backend and
// path -- unlike slicing, which is a zero-copy immortal view on the asm-IR
// path (#4294) and would hand back another view instead of a copy. On an
// already-owned `string` receiver it is a plain (cheap) copy.
pub function (s: string) to_owned(): string {
    return s + "";
}

pub function (s: string) trim(): str {
    var n: i32 = s.len();
    var low: i32 = 0;
    var high: i32 = n;
    while (low < high) {
        if (!__is_ascii_ws(s[low])) { break; }
        low = low + 1;
    }
    while (high > low) {
        if (!__is_ascii_ws(s[high - 1])) { break; }
        high = high - 1;
    }
    return s[low:high];
}

// `s.trim_start()` / `trim_end()` — one-sided whitespace
// strip. The bare `trim` already covers both ends; these
// are the asymmetric variants useful for trimming a
// prompt prefix without eating trailing data, or vice versa.
pub function (s: string) trim_start(): str {
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n && __is_ascii_ws(s[i])) { i = i + 1; }
    return s[i:n];
}

pub function (s: string) trim_end(): str {
    var n: i32 = s.len();
    var end: i32 = n;
    while (end > 0 && __is_ascii_ws(s[end - 1])) { end = end - 1; }
    return s[0:end];
}

// `s.rstrip_newline()` — strip a single trailing newline.
// Removes "\n" or "\r\n" (the CRLF pair) but stops there —
// runs of multiple newlines are preserved beyond the first
// strip. Use trim_end for full whitespace strip.
pub function (s: string) rstrip_newline(): str {
    var n: i32 = s.len();
    if (n == 0) { return s; }
    if (s[n - 1] == 10) {
        if (n >= 2 && s[n - 2] == 13) { return s[0:n - 2]; }
        return s[0:n - 1];
    }
    return s;
}

// `s.trim_chars(chars)` — strip any byte that appears in
// `chars` from both ends. Empty `chars` is a no-op. Useful
// for stripping a chosen set of delimiters / wrapping
// characters in one pass.
pub function (s: string) trim_chars(chars: string): str {
    var n: i32 = s.len();
    if (chars.len() == 0) { return s; }
    var low: i32 = 0;
    var high: i32 = n;
    while (low < high) {
        if (chars.index_of(s[low:low + 1]) < 0) { break; }
        low = low + 1;
    }
    while (high > low) {
        if (chars.index_of(s[high - 1:high]) < 0) { break; }
        high = high - 1;
    }
    return s[low:high];
}

// `s.trim_start_chars(chars)` / `s.trim_end_chars(chars)` —
// one-sided variants of trim_chars. Strip any byte in `chars`
// from the start / end only.
pub function (s: string) trim_start_chars(chars: string): str {
    var n: i32 = s.len();
    if (chars.len() == 0) { return s; }
    var i: i32 = 0;
    while (i < n && chars.index_of(s[i:i + 1]) >= 0) {
        i = i + 1;
    }
    return s[i:n];
}

pub function (s: string) trim_end_chars(chars: string): str {
    var n: i32 = s.len();
    if (chars.len() == 0) { return s; }
    var end: i32 = n;
    while (end > 0 && chars.index_of(s[end - 1:end]) >= 0) {
        end = end - 1;
    }
    return s[0:end];
}

// `s.starts_with_ci(prefix)` / `s.ends_with_ci(suffix)` —
// ASCII case-insensitive variants of starts_with / ends_with.
// Folds A-Z to a-z per byte.
pub function (s: string) starts_with_ci(prefix: string): boolean {
    var sLen: i32 = s.len();
    var pLen: i32 = prefix.len();
    if (pLen > sLen) { return false; }
    var i: i32 = 0;
    while (i < pLen) {
        if (s[i].to_lower() != prefix[i].to_lower()) { return false; }
        i = i + 1;
    }
    return true;
}

pub function (s: string) ends_with_ci(suffix: string): boolean {
    var sLen: i32 = s.len();
    var uLen: i32 = suffix.len();
    if (uLen > sLen) { return false; }
    var off: i32 = sLen - uLen;
    var i: i32 = 0;
    while (i < uLen) {
        if (s[off + i].to_lower() != suffix[i].to_lower()) { return false; }
        i = i + 1;
    }
    return true;
}

// `s.bytes()` — returns a fresh `u8[]` whose contents are
// independently owned. Use `s.as_bytes()` (slice form) when
// you don't need ownership; that's the zero-copy companion.
pub function (s: string) bytes(): u8[] {
    var n: i32 = s.len();
    var out: u8[] = __alloc_u8(n);
    if (n > 0) {
        // Use `as usize`, not `as i32`: native 64-bit targets
        // (arm64-linux on AWS Graviton / Ampere Altra) place
        // heap mmap regions above 4 GiB, so `pointer as i32`
        // silently truncates and __memcpy traps on the bad
        // address. See `int_to_string` in core/int.fern for
        // the same fix in context.
        __memcpy(out as usize, s.as_bytes() as usize, n);
    }
    return out;
}

// __string_case_fold drives `to_lower` / `to_upper`.
// Allocates a fresh `u8[]` of the same length, byte-by-byte
// remaps any A..A+25 source range to dstBase..dstBase+25,
// passes everything else through. Non-ASCII bytes (>= 0x80)
// always fall outside the [srcBase, srcBase+26) check, so
// UTF-8 multibyte sequences pass through unchanged.
function __string_case_fold(s: string, srcBase: i32, dstBase: i32): string {
    var n: i32 = s.len();
    var buf: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b >= srcBase && b < srcBase + 26) {
            b = b + (dstBase - srcBase);
        }
        buf = buf.with(i, b as u8);
        i = i + 1;
    }
    return string_from_bytes(buf);
}

pub function (s: string) to_lower(): string {
    return __string_case_fold(s, 65, 97);     // A-Z → a-z
}

pub function (s: string) to_upper(): string {
    return __string_case_fold(s, 97, 65);     // a-z → A-Z
}

// `s.split(sep)` — splits on every non-overlapping
// occurrence of sep. Empty pieces around adjacent
// separators are preserved (`",a,b,".split(",")` →
// `["", "a", "b", ""]`). Empty separator splits into
// single-byte strings (matches JS's `split("")`). Result
// is built incrementally via `__array_append_string`.
pub function (s: string) split(sep: string): string[] {
    var n: i32 = s.len();
    var sepLen: i32 = sep.len();
    var out: string[] = [];
    // Single shared `i` across the empty-sep / non-empty-sep
    // branches — the wasm emitter names locals by their lang
    // identifier, so two `var i: i32 = 0;` in sibling scopes
    // would collide as duplicate locals.
    var i: i32 = 0;
    if (sepLen == 0) {
        while (i < n) {
            out = out.append(s[i:i+1]);
            i = i + 1;
        }
        return out;
    }
    var start: i32 = 0;
    while (i + sepLen <= n) {
        if (__substr_eq(s, i, sep, sepLen)) {
            out = out.append(s[start:i]);
            i = i + sepLen;
            start = i;
        } else {
            i = i + 1;
        }
    }
    return out.append(s[start:n]);
}

// `s.splitn(sep, n)` — like split but caps the result at n
// pieces; the last piece carries the unsplit tail. n <= 0
// returns the empty array; n == 1 returns [s] unchanged.
// Useful for "first token, rest" parsing — HTTP request
// lines, URL scheme separation, header `key: value`.
pub function (s: string) splitn(sep: string, n: i32): string[] {
    var out: string[] = [];
    if (n <= 0) { return out; }
    if (n == 1) { return out.append(s); }
    var sepLen: i32 = sep.len();
    // Hoist sLen / i / start to function scope — wasm rejects
    // sibling-scope duplicate locals.
    var sLen: i32 = s.len();
    var i: i32 = 0;
    var start: i32 = 0;
    if (sepLen == 0) {
        // Match split's empty-sep behaviour: per-byte slicing.
        while (i < sLen && out.len() < n - 1) {
            out = out.append(s[i:i + 1]);
            i = i + 1;
        }
        return out.append(s[i:sLen]);
    }
    while (i + sepLen <= sLen && out.len() < n - 1) {
        if (__substr_eq(s, i, sep, sepLen)) {
            out = out.append(s[start:i]);
            i = i + sepLen;
            start = i;
        } else {
            i = i + 1;
        }
    }
    return out.append(s[start:sLen]);
}

// `s.first()` / `s.last()` — first / last byte as Option[i32].
// None on empty. Convenience over `s.at(0)` / `s.at(len(s) - 1)`
// — the indices are easy to mis-write.
pub function (s: string) first(): Option[i32] {
    if (s.len() == 0) { return None; }
    return Some(s[0]);
}

pub function (s: string) last(): Option[i32] {
    var n: i32 = s.len();
    if (n == 0) { return None; }
    return Some(s[n - 1]);
}

// `s.take(n)` / `s.drop(n)` — prefix and suffix slicing
// with bounds clamping. take(big) returns the whole string;
// drop(big) returns empty. take(neg) / drop(neg) treat
// the count as 0. Saves the `s[0:min(n, len(s))]` /
// `s[min(n, len(s)):len(s)]` boilerplate at every call site.
pub function (s: string) take(n: i32): str {
    if (n <= 0) { return ""; }
    var sLen: i32 = s.len();
    if (n >= sLen) { return s; }
    return s[0:n];
}

pub function (s: string) drop(n: i32): str {
    if (n <= 0) { return s; }
    var sLen: i32 = s.len();
    if (n >= sLen) { return ""; }
    return s[n:sLen];
}

// `s.chunks(size)` — split into consecutive size-byte
// chunks. The last chunk may be shorter. size <= 0 returns
// an array containing just s (or empty if s is empty).
// Useful for base64 line-wrapping, hex-dump formatting,
// paged output.
pub function (s: string) chunks(size: i32): string[] {
    var sLen: i32 = s.len();
    var out: string[] = [];
    if (sLen == 0) { return out; }
    if (size <= 0) { return out.append(s); }
    var i: i32 = 0;
    while (i < sLen) {
        var end: i32 = i + size;
        if (end > sLen) { end = sLen; }
        out = out.append(s[i:end]);
        i = end;
    }
    return out;
}

// `s.lines()` — splits on '\n', strips a trailing '\r' from
// each line (so CRLF is treated as LF), and drops the trailing
// empty line that a final '\n' would otherwise produce. Matches
// Python's `str.splitlines()` and Go's `bufio.Scanner` with
// `ScanLines`:
//
//   "a\nb\nc"   → ["a", "b", "c"]
//   "a\nb\n"    → ["a", "b"]            (trailing '\n' eaten)
//   "a\r\nb"    → ["a", "b"]            (CR stripped)
//   "\n"        → [""]                  (one empty line)
//   ""          → []                    (no lines at all)
//
// O(n) single-pass byte walk; uses index-of-byte (s[i]) and
// substring slicing rather than the per-byte `s[i:i+1] == "\n"`
// pattern, so the inner loop allocates nothing.
pub function (s: string) lines(): string[] {
    var n: i32 = s.len();
    var out: string[] = [];
    if (n == 0) { return out; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        if (s[i] == 10) {
            var end: i32 = i;
            if (end > start) {
                if (s[end - 1] == 13) { end = end - 1; }
            }
            out = out.append(s[start:end]);
            i = i + 1;
            start = i;
        } else {
            i = i + 1;
        }
    }
    // Trailing chunk (no final '\n'): emit only when non-empty.
    // start == n means the input ended with '\n' and we DON'T
    // want a phantom empty line.
    if (start < n) {
        var endTail: i32 = n;
        if (endTail > start) {
            if (s[endTail - 1] == 13) { endTail = endTail - 1; }
        }
        out = out.append(s[start:endTail]);
    }
    return out;
}

// `s.fields()` — split on runs of ASCII whitespace, dropping
// empty pieces. Differs from `split(" ")` which preserves
// adjacent-separator empties and only matches the single
// space byte. Whitespace classifier matches the trim() one
// (space / tab / CR / LF / VT / FF). Result is the run of
// non-empty fields in order. Empty / all-whitespace input
// returns an empty array.
//
// Matches Go strings.Fields, Roc Str.split (whitespace
// flavour), Python str.split() (no-arg).
pub function (s: string) fields(): string[] {
    var n: i32 = s.len();
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        while (i < n && __is_ascii_ws(s[i])) { i = i + 1; }
        if (i >= n) { break; }
        var start: i32 = i;
        while (i < n && !__is_ascii_ws(s[i])) { i = i + 1; }
        out = out.append(s[start:i]);
    }
    return out;
}

// `s.eq_ignore_ascii_case(other)` — equality with ASCII A-Z
// folded to a-z on both sides. Non-ASCII bytes (>= 0x80) only
// match byte-exact — multibyte UTF-8 sequences and Unicode
// case folding aren't handled. Standard shape for HTTP header
// keys ("Content-Type" vs "content-type") where the fold is
// strictly ASCII per RFC 7230.
pub function (s: string) eq_ignore_ascii_case(other: string): boolean {
    var n: i32 = s.len();
    if (n != other.len()) { return false; }
    var i: i32 = 0;
    while (i < n) {
        var a: i32 = s[i];
        var b: i32 = other[i];
        // Fold A-Z (65..90) into a-z (97..122) by setting bit 5.
        if (a >= 65 && a <= 90) { a = a + 32; }
        if (b >= 65 && b <= 90) { b = b + 32; }
        if (a != b) { return false; }
        i = i + 1;
    }
    return true;
}

// `s.strip_prefix(p)` — Some(rest) if s starts with p, None
// otherwise. The Some payload is s[len(p):], which under lang's
// arena model is a fresh independent slice (string slicing
// allocates). Companion to starts_with that ALSO gives you
// the trailing chunk in a single call.
pub function (s: string) strip_prefix(prefix: string): Option[string] {
    if (!s.starts_with(prefix)) { return None; }
    return Some(s[prefix.len():s.len()].to_owned());
}

// `s.strip_suffix(s)` — Some(head) if s ends with the suffix.
// Symmetric to strip_prefix; returns s[0:len(s)-len(suffix)].
pub function (s: string) strip_suffix(suffix: string): Option[string] {
    if (!s.ends_with(suffix)) { return None; }
    var k: i32 = s.len() - suffix.len();
    return Some(s[0:k].to_owned());
}

// `s.remove_prefix(prefix)` / `s.remove_suffix(suffix)` —
// like strip_prefix / strip_suffix but return s unchanged
// when the prefix / suffix doesn't match, instead of
// Option. Avoids the match boilerplate when the unchanged
// value is the right fallback.
pub function (s: string) remove_prefix(prefix: string): str {
    if (!s.starts_with(prefix)) { return s; }
    return s[prefix.len():s.len()];
}

pub function (s: string) remove_suffix(suffix: string): str {
    if (!s.ends_with(suffix)) { return s; }
    var k: i32 = s.len() - suffix.len();
    return s[0:k];
}

// `s.is_uuid()` — true if s matches the canonical UUID
// format: 8-4-4-4-12 hex digits separated by dashes,
// total 36 characters. Doesn't validate the version or
// variant nibble — just the shape.
pub function (s: string) is_uuid(): boolean {
    if (s.len() != 36) { return false; }
    var i: i32 = 0;
    while (i < 36) {
        if (i == 8 || i == 13 || i == 18 || i == 23) {
            if (s[i] != 45) { return false; }    // '-'
        } else {
            if (!s[i].is_hex_digit()) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// `s.pad_start(n, ch)` / `s.pad_end(n, ch)` — left- and right-
// pad the string with `ch` (the first byte is used) so the
// result is at least n bytes long. Already-long strings pass
// through unchanged. Standard alignment shape for tables, hex
// dumps, fixed-width column output.
//
// `ch` is a single-byte string; multibyte fill characters
// would need codepoint handling we don't have yet. Empty `ch`
// degenerates to no padding (returns the original).
pub function (s: string) pad_start(n: i32, ch: string): string {
    var sl: i32 = s.len();
    if (sl >= n) { return s; }
    if (ch.len() == 0) { return s; }
    // Result is exactly n bytes; fill one buffer (O(n)) instead of the
    // `pad = pad + ch[0:1]` loop, which recopied the growing pad each
    // step (O(need²) — the #4379 hot path). `need` fill bytes, then s.
    var c: i32 = ch[0];
    var need: i32 = n - sl;
    var buf: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < need) { buf = buf.with(i, c as u8); i = i + 1; }
    var j: i32 = 0;
    while (j < sl) { buf = buf.with(need + j, s[j] as u8); j = j + 1; }
    return string_from_bytes(buf);
}

pub function (s: string) pad_end(n: i32, ch: string): string {
    var sl: i32 = s.len();
    if (sl >= n) { return s; }
    if (ch.len() == 0) { return s; }
    // Result is exactly n bytes; fill one buffer (O(n)). s, then `need`
    // fill bytes.
    var c: i32 = ch[0];
    var need: i32 = n - sl;
    var buf: u8[] = __alloc_u8(n);
    var j: i32 = 0;
    while (j < sl) { buf = buf.with(j, s[j] as u8); j = j + 1; }
    var i: i32 = 0;
    while (i < need) { buf = buf.with(sl + i, c as u8); i = i + 1; }
    return string_from_bytes(buf);
}

// `s.split_once(sep)` — splits at the FIRST occurrence of
// sep, returning Some((head, tail)). The separator is dropped
// from the output. Returns None when sep doesn't appear or
// sep is empty. Useful for "key=value", "name:port",
// "scheme://rest" patterns where you only want one split.
pub function (s: string) split_once(sep: string): Option[(string, string)] {
    if (sep.len() == 0) { return None; }
    var n: i32 = s.len();
    var sLen: i32 = sep.len();
    var i: i32 = 0;
    while (i + sLen <= n) {
        if (__substr_eq(s, i, sep, sLen)) {
            return Some((s[0:i].to_owned(), s[i + sLen:n].to_owned()));
        }
        i = i + 1;
    }
    return None;
}

// `s.trim_start_matches(sub)` / `s.trim_end_matches(sub)` —
// peel sub off the beginning / end as many times as it
// appears, contiguously. Symmetric with the regular trim()
// that strips whitespace.
pub function (s: string) trim_start_matches(sub: string): str {
    if (sub.len() == 0) { return s; }
    var n: i32 = s.len();
    var subLen: i32 = sub.len();
    var i: i32 = 0;
    while (i + subLen <= n && __substr_eq(s, i, sub, subLen)) {
        i = i + subLen;
    }
    return s[i:n];
}

pub function (s: string) trim_end_matches(sub: string): str {
    if (sub.len() == 0) { return s; }
    var n: i32 = s.len();
    var subLen: i32 = sub.len();
    var end: i32 = n;
    while (end - subLen >= 0 && __substr_eq(s, end - subLen, sub, subLen)) {
        end = end - subLen;
    }
    return s[0:end];
}

// `s.contains_ci(needle)` / `index_of_ci(needle)` — case-
// insensitive ASCII versions of `contains` / `index_of`.
// Folds A-Z to a-z on both sides per byte. Multibyte UTF-8
// matches only as exact bytes (no Unicode case folding).
pub function (s: string) contains_ci(needle: string): boolean {
    return s.index_of_ci(needle) >= 0;
}

pub function (s: string) index_of_ci(needle: string): i32 {
    var nLen: i32 = needle.len();
    if (nLen == 0) { return 0; }
    var sLen: i32 = s.len();
    if (nLen > sLen) { return 0 - 1; }
    var last: i32 = sLen - nLen;
    var i: i32 = 0;
    while (i <= last) {
        var j: i32 = 0;
        var ok: boolean = true;
        while (j < nLen) {
            if (s[i + j].to_lower() != needle[j].to_lower()) {
                ok = false;
                j = nLen;
            } else {
                j = j + 1;
            }
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// `s.find_ci(needle)` — Option-returning companion to
// `index_of_ci`: `Some(byte-index)` of the first case-
// insensitive match, `None` when absent. Empty needle returns
// `Some(0)`. Same Option convention as `find` / `rfind`.
pub function (s: string) find_ci(needle: string): Option[i32] {
    var idx: i32 = s.index_of_ci(needle);
    if (idx < 0) { return None; }
    return Some(idx);
}

// `s.pad_start_str(width, fill)` / `pad_end_str(width, fill)`
// — left- and right-pad to a minimum BYTE width using the
// multi-byte `fill` string as the padding unit. The pad
// repeats; if the byte-count overshoots, the LAST occurrence
// is truncated at the boundary. The simpler `pad_start(n, ch)`
// from earlier always uses a single-byte fill — these are
// the cousins for prefix dashes / line rules / "....." kinds
// of decorative padding.
pub function (s: string) pad_start_str(width: i32, fill: string): string {
    var sLen: i32 = s.len();
    if (sLen >= width || fill.len() == 0) { return s; }
    var pad: string = "";
    while (pad.len() + fill.len() <= width - sLen) {
        pad = pad + fill;
    }
    if (pad.len() < width - sLen) {
        pad = pad + fill[0:width - sLen - pad.len()];
    }
    return pad + s;
}

pub function (s: string) pad_end_str(width: i32, fill: string): string {
    var sLen: i32 = s.len();
    if (sLen >= width || fill.len() == 0) { return s; }
    var pad: string = "";
    while (pad.len() + fill.len() <= width - sLen) {
        pad = pad + fill;
    }
    if (pad.len() < width - sLen) {
        pad = pad + fill[0:width - sLen - pad.len()];
    }
    return s + pad;
}

// `s.center(width, ch)` — center s within a width-byte field,
// padding equally on both sides with the single byte `ch`.
// Odd-padding splits leave the extra byte on the right. ch
// is a single-byte string (only first byte used). Already-
// long strings pass through unchanged.
pub function (s: string) center(width: i32, ch: string): string {
    var sLen: i32 = s.len();
    if (sLen >= width || ch.len() == 0) { return s; }
    var total: i32 = width - sLen;
    var lpad: i32 = total / 2;
    var rpad: i32 = total - lpad;
    return repeat_char(ch[0], lpad) + s + repeat_char(ch[0], rpad);
}

// `s.reverse_words()` — split on ASCII whitespace, reverse
// the resulting word list, join with a single space. Drops
// the original whitespace structure (multiple spaces / tabs
// / newlines all collapse to single ' '). Empty input
// returns "".
pub function (s: string) reverse_words(): string {
    var words: string[] = s.fields();
    return words.reverse().join(" ");
}

// `s.truncate(n, ellipsis)` — if len(s) > n, return the first
// (n - len(ellipsis)) bytes followed by `ellipsis`. If
// len(s) <= n, return s unchanged. If n is smaller than the
// ellipsis itself, just hard-truncate s to n bytes (the
// ellipsis would otherwise overflow). A non-positive cap yields
// "" (guarded like the `ellipsis` sibling — otherwise a negative
// n would fall through to `s[0:n]`, a negative slice bound).
pub function (s: string) truncate(n: i32, ellipsis: string): string {
    if (n <= 0) { return ""; }
    var sLen: i32 = s.len();
    if (sLen <= n) { return s; }
    var eLen: i32 = ellipsis.len();
    if (n <= eLen) { return s[0:n].to_owned(); }
    return s[0:n - eLen] + ellipsis;
}

// `s.ellipsis(n)` — fit s into n bytes, marking truncation
// with "...". When len(s) <= n, returns s unchanged.
// Otherwise: if n >= 3, return the first (n-3) bytes
// followed by "..." (so an n=3 cap on a long string is just
// "..." — different from `truncate(3, "...")` which would
// hard-truncate the source). If n < 3, return the first n
// bytes of "..." as a degenerate placeholder.
pub function (s: string) ellipsis(n: i32): string {
    if (s.len() <= n) { return s; }
    if (n < 3) {
        if (n <= 0) { return ""; }
        return "..."[0:n].to_owned();
    }
    if (n == 3) { return "..."; }
    return s[0:n - 3] + "...";
}

// `s.first_line()` — Option[string] containing the prefix
// up to (but not including) the first '\n'. Returns None
// for the empty string. If there's no newline, returns
// Some(s).
pub function (s: string) first_line(): Option[string] {
    if (s.len() == 0) { return None; }
    var idx: i32 = s.index_of("\n");
    if (idx < 0) { return Some(s); }
    return Some(s[0:idx].to_owned());
}

// `s.at(i)` — bounds-checked byte access. Returns Some(byte)
// for in-range i or None if i is out of [0, len). Counterpart
// to `s[i]` which traps on OOB; useful in tokeniser loops
// where the end check would otherwise need an explicit bounds
// guard at every step.
pub function (s: string) at(i: i32): Option[i32] {
    if (i < 0 || i >= s.len()) { return None; }
    return Some(s[i]);
}

// `s.chars()` — byte array of the string's contents as
// i32 values (one per byte). Byte-level, not codepoint —
// multibyte UTF-8 sequences come out as separate i32s in
// order. Convenience over s.bytes() (which returns u8[])
// when callers want to do i32 arithmetic / comparisons on
// each byte without manually widening. The bytes() function
// stays as the canonical way to get a u8[] slice; chars() is
// the i32 sibling.
pub function (s: string) chars(): i32[] {
    var n: i32 = s.len();
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(s[i]);
        i = i + 1;
    }
    return out;
}

// `s.to_array()` — string[] one element per byte (each a
// single-byte string). Companion to chars() but with
// string elements; useful when later operations need
// string semantics rather than raw byte values.
pub function (s: string) to_array(): string[] {
    var n: i32 = s.len();
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.append(s[i:i + 1]);
        i = i + 1;
    }
    return out;
}

// --- UTF-8 codepoint layer -------------------------------------------------
//
// Strings are byte-indexed; `chars()` above yields raw bytes, so anything
// non-ASCII is fragile. These decode/encode the UTF-8 content as Unicode
// scalar values (codepoints, as i32), the eager-array form the roadmap
// asks for (#4416 ROADMAP #6). Ill-formed input never throws: a malformed
// lead, a truncated or bad continuation, an overlong encoding, a UTF-16
// surrogate (U+D800..U+DFFF), or a value past U+10FFFF each decodes to one
// U+FFFD (`�`, the Unicode replacement character) and the scan resumes —
// the WHATWG-style substitution policy, so `codepoints()` is total.

// `__utf8_is_cont(b)` — is byte `b` a UTF-8 continuation byte (0x80..0xBF)?
function __utf8_is_cont(b: i32): boolean { return b >= 128 && b < 192; }

// `__utf8_step(s, i, n)` — number of bytes the codepoint starting at `i`
// consumes: 1 for ASCII, a stray continuation, or an invalid / truncated
// lead; otherwise the 2/3/4 the lead's continuation structure spells (even
// when the value is overlong / a surrogate / out of range — those still
// consume the whole sequence, they just decode to U+FFFD). Sharing this
// with both decoders keeps `codepoint_count()` == `codepoints().len()`.
function __utf8_step(s: string, i: i32, n: i32): i32 {
    var b0: i32 = s[i];
    if (b0 < 192) { return 1; }   // ASCII (< 128) or stray continuation
    if (b0 < 224) {
        if (i + 1 < n && __utf8_is_cont(s[i + 1])) { return 2; }
        return 1;
    }
    if (b0 < 240) {
        if (i + 2 < n && __utf8_is_cont(s[i + 1]) && __utf8_is_cont(s[i + 2])) { return 3; }
        return 1;
    }
    if (b0 < 248) {
        if (i + 3 < n && __utf8_is_cont(s[i + 1]) && __utf8_is_cont(s[i + 2]) && __utf8_is_cont(s[i + 3])) { return 4; }
        return 1;
    }
    return 1;   // 0xF8..0xFF: never a valid lead
}

// `__utf8_decode_at(s, i, step)` — the scalar value at `i` given the
// `__utf8_step` length, folding every ill-formed case to U+FFFD (65533).
function __utf8_decode_at(s: string, i: i32, step: i32): i32 {
    var b0: i32 = s[i];
    if (step == 1) {
        if (b0 < 128) { return b0; }
        return 65533;   // stray continuation / invalid / truncated lead
    }
    if (step == 2) {
        var cp2: i32 = ((b0 & 31) << 6) | (s[i + 1] & 63);
        if (cp2 < 128) { return 65533; }   // overlong
        return cp2;
    }
    if (step == 3) {
        var cp3: i32 = ((b0 & 15) << 12) | ((s[i + 1] & 63) << 6) | (s[i + 2] & 63);
        if (cp3 < 2048) { return 65533; }                   // overlong
        if (cp3 >= 55296 && cp3 <= 57343) { return 65533; } // UTF-16 surrogate
        return cp3;
    }
    var cp4: i32 = ((b0 & 7) << 18) | ((s[i + 1] & 63) << 12) | ((s[i + 2] & 63) << 6) | (s[i + 3] & 63);
    if (cp4 < 65536) { return 65533; }     // overlong
    if (cp4 > 1114111) { return 65533; }   // beyond U+10FFFF
    return cp4;
}

// `s.codepoints()` — decode the UTF-8 content to Unicode scalar values,
// one i32 per codepoint (ill-formed bytes → U+FFFD; see the layer note).
// The codepoint counterpart of `chars()` (which is per-byte).
pub function (s: string) codepoints(): i32[] {
    var n: i32 = s.len();
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        var step: i32 = __utf8_step(s, i, n);
        out = out.append(__utf8_decode_at(s, i, step));
        i = i + step;
    }
    return out;
}

// `s.codepoint_count()` — number of Unicode codepoints in the UTF-8
// content, without materialising the array. Equal to `codepoints().len()`
// (both advance by `__utf8_step`), including the one-U+FFFD-per-ill-formed
// -unit accounting. This is the "length in characters" a byte `len()`
// can't give for non-ASCII text.
pub function (s: string) codepoint_count(): i32 {
    var n: i32 = s.len();
    var count: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        i = i + __utf8_step(s, i, n);
        count = count + 1;
    }
    return count;
}

// `__utf8_encoded_len(c)` — bytes a (already-sanitised) codepoint `c`
// occupies in UTF-8: 1/2/3/4 across the ASCII / 2-byte / BMP / astral
// boundaries.
function __utf8_encoded_len(c: i32): i32 {
    if (c < 128) { return 1; }
    if (c < 2048) { return 2; }
    if (c < 65536) { return 3; }
    return 4;
}

// `__utf8_sanitise(c)` — map a value that is negative, past U+10FFFF, or a
// UTF-16 surrogate to U+FFFD; pass every other scalar through. Keeps the
// encoders total, mirroring the decoder's substitution policy.
function __utf8_sanitise(c: i32): i32 {
    if (c < 0 || c > 1114111 || (c >= 55296 && c <= 57343)) { return 65533; }
    return c;
}

// `__utf8_put(buf, pos, c)` — write the UTF-8 bytes of sanitised codepoint
// `c` at `pos`, returning the (possibly grown) buffer. Caller sizes `buf`
// via `__utf8_encoded_len` and advances `pos` by the same.
function __utf8_put(buf_in: u8[], pos: i32, c: i32): u8[] {
    var buf: u8[] = buf_in;
    if (c < 128) {
        buf = buf.with(pos, c as u8);
    } else if (c < 2048) {
        buf = buf.with(pos, (192 | (c >> 6)) as u8);
        buf = buf.with(pos + 1, (128 | (c & 63)) as u8);
    } else if (c < 65536) {
        buf = buf.with(pos, (224 | (c >> 12)) as u8);
        buf = buf.with(pos + 1, (128 | ((c >> 6) & 63)) as u8);
        buf = buf.with(pos + 2, (128 | (c & 63)) as u8);
    } else {
        buf = buf.with(pos, (240 | (c >> 18)) as u8);
        buf = buf.with(pos + 1, (128 | ((c >> 12) & 63)) as u8);
        buf = buf.with(pos + 2, (128 | ((c >> 6) & 63)) as u8);
        buf = buf.with(pos + 3, (128 | (c & 63)) as u8);
    }
    return buf;
}

// `string_from_codepoint(cp)` — the single-codepoint UTF-8 string for
// scalar `cp` (out-of-range / surrogate → U+FFFD). The inverse of indexing
// `codepoints()`; the way to build non-ASCII text from a numeric scalar.
pub function string_from_codepoint(cp: i32): string {
    var c: i32 = __utf8_sanitise(cp);
    var buf: u8[] = __alloc_u8(__utf8_encoded_len(c));
    buf = __utf8_put(buf, 0, c);
    return string_from_bytes(buf);
}

// `string_from_codepoints(cps)` — UTF-8 string for a codepoint array (each
// sanitised as in `string_from_codepoint`). Round-trips with `codepoints()`
// for well-formed input: `string_from_codepoints(s.codepoints())` re-encodes
// `s` (ill-formed runs collapse to U+FFFD). Two-pass exact-size buffer, no
// O(n²) concatenation.
pub function string_from_codepoints(cps: i32[]): string {
    var m: i32 = cps.len();
    var total: i32 = 0;
    var i: i32 = 0;
    while (i < m) {
        total = total + __utf8_encoded_len(__utf8_sanitise(cps[i]));
        i = i + 1;
    }
    var buf: u8[] = __alloc_u8(total);
    var pos: i32 = 0;
    i = 0;
    while (i < m) {
        var c: i32 = __utf8_sanitise(cps[i]);
        buf = __utf8_put(buf, pos, c);
        pos = pos + __utf8_encoded_len(c);
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `s.reverse_bytes()` — fresh string with the byte order
// reversed. NOT a Unicode-aware reverse — multibyte UTF-8
// sequences will scramble their internal byte order, producing
// invalid UTF-8. The name carries the warning. For pure-ASCII
// inputs (HTTP headers, hex / base64 / log lines, parser
// fragments) the operation is well-defined.
pub function (s: string) reverse_bytes(): string {
    var n: i32 = s.len();
    if (n == 0) { return ""; }
    var buf: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) {
        buf = buf.with(i, s[n - 1 - i] as u8);
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `s.count(sub)` — number of non-overlapping occurrences of
// sub in s. Empty needle returns 0 to avoid infinite-loop
// surprises; behaviour mirrors Rust str::matches().count().
pub function (s: string) count(sub: string): i32 {
    if (sub.len() == 0) { return 0; }
    var n: i32 = s.len();
    var subLen: i32 = sub.len();
    var c: i32 = 0;
    var i: i32 = 0;
    while (i + subLen <= n) {
        if (__substr_eq(s, i, sub, subLen)) {
            c = c + 1;
            i = i + subLen;
        } else {
            i = i + 1;
        }
    }
    return c;
}

// `s.count_byte(b)` — number of bytes equal to b. O(n)
// single-pass; cheaper than count(byte.to_ascii_string())
// when the needle is known to be a single byte.
pub function (s: string) count_byte(b: i32): i32 {
    var n: i32 = s.len();
    var c: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        if (s[i] == b) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// `s.replace_n(old, new, n)` — like replace() but caps at
// the first n occurrences. Useful when only the leading
// substitutions are interesting (e.g. unquoting the first
// few escapes, masking PII while keeping later context).
pub function (s: string) replace_n(old: string, new: string, n: i32): string {
    var sLen: i32 = s.len();
    var oLen: i32 = old.len();
    if (oLen == 0 || n <= 0) { return s; }
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    var done: i32 = 0;
    while (i + oLen <= sLen && done < n) {
        if (__substr_eq(s, i, old, oLen)) {
            out = out + s[start:i] + new;
            i = i + oLen;
            start = i;
            done = done + 1;
        } else {
            i = i + 1;
        }
    }
    return out + s[start:sLen];
}

// `s.remove_all(needle)` — replace every occurrence of
// needle with empty. Sugar for `replace(needle, "")`.
pub function (s: string) remove_all(needle: string): string {
    return s.replace(needle, "");
}

// `s.before(sep)` — substring before the first occurrence
// of sep. Returns s unchanged if sep not present, "" if
// s starts with sep. Doesn't include sep in the result.
pub function (s: string) before(sep: string): str {
    var idx: i32 = s.index_of(sep);
    if (idx < 0) { return s; }
    return s[0:idx];
}

// `s.after(sep)` — substring after the first occurrence
// of sep. Returns "" if sep not present, s unchanged if sep
// is empty. Doesn't include sep in the result.
pub function (s: string) after(sep: string): str {
    if (sep.len() == 0) { return s; }
    var idx: i32 = s.index_of(sep);
    if (idx < 0) { return ""; }
    return s[idx + sep.len():s.len()];
}

// `s.between(start, end)` — Some(substring) for the content
// between the first start and the first end AFTER that start.
// None if either marker is missing (or empty). Useful for
// extracting tag bodies, parenthesised content, brace-
// delimited fields.
pub function (s: string) between(start: string, end: string): Option[string] {
    if (start.len() == 0 || end.len() == 0) { return None; }
    var i: i32 = s.index_of(start);
    if (i < 0) { return None; }
    var begin: i32 = i + start.len();
    var n: i32 = s.len();
    var endLen: i32 = end.len();
    var j: i32 = begin;
    while (j + endLen <= n) {
        if (__substr_eq(s, j, end, endLen)) {
            return Some(s[begin:j].to_owned());
        }
        j = j + 1;
    }
    return None;
}

// `s.count_lines()` — number of lines in s. Empty string
// returns 0; lines are separated by '\n'. A trailing newline
// is NOT counted as an extra empty line (matches Go's
// bufio.Scanner ScanLines + lines() prelude function).
pub function (s: string) count_lines(): i32 {
    var n: i32 = s.len();
    if (n == 0) { return 0; }
    var c: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        if (s[i] == 10) { c = c + 1; }
        i = i + 1;
    }
    // No trailing newline → there's still a final line.
    if (s[n - 1] != 10) { c = c + 1; }
    return c;
}

// `s.repeat_with_sep(n, sep)` — like repeat() but with sep
// between every pair. `"x".repeat_with_sep(3, ", ")` →
// "x, x, x". n <= 0 returns empty.
pub function (s: string) repeat_with_sep(n: i32, sep: string): string {
    if (n <= 0) { return ""; }
    var sl: i32 = s.len();
    var pl: i32 = sep.len();
    // n copies of s + (n-1) separators — a known size, so fill one
    // buffer (O(total)) instead of the O(total²) `out = out + sep + s`.
    var total: i32 = sl * n + pl * (n - 1);
    if (total == 0) { return ""; }
    var buf: u8[] = __alloc_u8(total);
    var pos: i32 = 0;
    var k: i32 = 0;
    while (k < n) {
        if (k > 0) {
            var pj: i32 = 0;
            while (pj < pl) {
                buf = buf.with(pos, sep[pj] as u8);
                pos = pos + 1;
                pj = pj + 1;
            }
        }
        var j: i32 = 0;
        while (j < sl) {
            buf = buf.with(pos, s[j] as u8);
            pos = pos + 1;
            j = j + 1;
        }
        k = k + 1;
    }
    return string_from_bytes(buf);
}

// `s.replace(old, new)` — substitutes every
// non-overlapping occurrence of `old` with `new`.
// Empty `old` is a no-op (returns the source unchanged)
// to match the JS / Go conventions and avoid the
// "insert N copies" pathology.
//
// Two passes over a single exact-size buffer (O(n)) rather than the
// `out = out + s[start:i] + new` chain, which recopied the whole
// prefix on every match (O(n²) — the #4379 hot path). Pass 1 counts
// the non-overlapping matches to size the result exactly
// (n + matches·(len(new) − len(old))); pass 2 fills it.
pub function (s: string) replace(old: string, new: string): string {
    var n: i32 = s.len();
    var oLen: i32 = old.len();
    if (oLen == 0) { return s; }
    var matches: i32 = 0;
    var i: i32 = 0;
    while (i + oLen <= n) {
        if (__substr_eq(s, i, old, oLen)) {
            matches = matches + 1;
            i = i + oLen;
        } else {
            i = i + 1;
        }
    }
    if (matches == 0) { return s; }
    var nLen: i32 = new.len();
    var out_len: i32 = n + matches * (nLen - oLen);
    if (out_len == 0) { return ""; }
    var buf: u8[] = __alloc_u8(out_len);
    var pos: i32 = 0;
    i = 0;
    while (i + oLen <= n) {
        if (__substr_eq(s, i, old, oLen)) {
            var k: i32 = 0;
            while (k < nLen) {
                buf = buf.with(pos, new[k] as u8);
                pos = pos + 1;
                k = k + 1;
            }
            i = i + oLen;
        } else {
            buf = buf.with(pos, s[i] as u8);
            pos = pos + 1;
            i = i + 1;
        }
    }
    // Tail after the last position a match could start.
    while (i < n) {
        buf = buf.with(pos, s[i] as u8);
        pos = pos + 1;
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `(s: string) parse_bool()` — accepts the canonical
// truthy / falsy spellings: "true" / "1" → Some(true),
// "false" / "0" → Some(false). Anything else returns None
// (no implicit lowercasing — callers stop their own
// canonicalisation at the boundary). Empty string is None.
pub function (s: string) parse_bool(): Option[boolean] {
    if (s == "true" || s == "1") { return Some(true); }
    if (s == "false" || s == "0") { return Some(false); }
    return None;
}

// `(s: string) is_http_safe_method()` — true for GET / HEAD
// / OPTIONS / TRACE (RFC 9110 section 9.2.1). Safe methods
// don't mutate state; ETag caching / replay logic depends on
// the distinction.
pub function (s: string) is_http_safe_method(): boolean {
    return s == "GET" || s == "HEAD" || s == "OPTIONS" || s == "TRACE";
}

// `(s: string) is_http_idempotent_method()` — true for any
// safe method plus PUT / DELETE. Idempotent methods can be
// safely retried after a network error without doubling
// the effect.
pub function (s: string) is_http_idempotent_method(): boolean {
    if (s.is_http_safe_method()) { return true; }
    return s == "PUT" || s == "DELETE";
}

// `s.parse_int()` — decimal i32 parser. Optional leading `-`;
// rejects empty input, lone `-`, any non-digit character,
// embedded whitespace, and out-of-range values
// (`-2^31..=2^31-1`). Internal accumulator is i64 so the
// bound check is exact. Returns `None` on failure, `Some(v)`
// on success.
//
// Replaced the ~190-line wat helper that previously lived in
// `wasm.go`; the lang version compiles to roughly the same
// code via the IR.
pub function (s: string) parse_int(): Option[i32] {
    var n: i32 = s.len();
    if (n == 0) { return None; }

    var i: i32 = 0;
    var neg: boolean = false;
    if (s[0] == 45) {            // '-'
        if (n == 1) { return None; }
        neg = true;
        i = 1;
    }

    var acc: i64 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return None; }   // not 0..9
        acc = acc * 10 + ((b - 48) as i64);
        if (acc >= 4294967296) { return None; }   // > u32 max — never fits i32
        i = i + 1;
    }

    if (neg) {
        if (acc > 2147483648) { return None; }    // < i32 min
        var v: i64 = 0 - acc;
        return Some(v as i32);
    }
    if (acc > 2147483647) { return None; }        // > i32 max
    return Some(acc as i32);
}

// `s.parse_int_or(fallback)` — parse a decimal integer, returning
// `fallback` when `s` isn't a valid integer (the `parse_int` cases
// that yield `None`). Saves the `match parse_int { Some => v, None
// => default }` boilerplate at every CLI flag-operand site
// (`head -n N`, `seq STEP`, `fold -w N`, …).
pub function (s: string) parse_int_or(fallback: i32): i32 {
    match (s.parse_int()) {
        Some(v) => { return v; },
        None => { return fallback; },
    }
}

// `s.parse_hex_int()` / `s.parse_bin_int()` — sugar for
// parse_int_radix(s, 16) / parse_int_radix(s, 2).
pub function (s: string) parse_hex_int(): Option[i32] {
    return int.parse_int_radix(s, 16);
}

pub function (s: string) parse_bin_int(): Option[i32] {
    return int.parse_int_radix(s, 2);
}

// `s.parse_float()` — decimal f32 parser. Grammar:
//   [-]<digits>[.<digits>][(e|E)[+-]?<digits>]
// At least one of integer or fraction digits required;
// trailing garbage rejected. Mantissa accumulates into an
// i64 with a saturation cap at 1e15; beyond that, extra
// digits are skipped while `exp_adj` keeps the magnitude
// right. Final value = `(f32) mantissa * 10^exp_adj`,
// sign applied via `0.0 - v`.
pub function (s: string) parse_float(): Option[f32] {
    var n: i32 = s.len();
    if (n == 0) { return None; }

    var i: i32 = 0;
    var neg: boolean = false;
    if (s[0] == 45) {                       // '-'
        if (n == 1) { return None; }
        neg = true;
        i = 1;
    }

    var mantissa: i64 = 0;
    var exp_adj: i32 = 0;
    var saw_int: boolean = false;
    var saw_frac: boolean = false;
    // Single `b` reused across the integer / fraction /
    // exponent inner loops — declaring the same name in
    // multiple inner scopes triggers a duplicate-local
    // collision in the wasm emitter (which names locals by
    // their lang identifier).
    var b: i32 = 0;

    // Integer digits.
    while (i < n) {
        b = s[i];
        if (b < 48 || b > 57) { break; }
        if (mantissa < 1000000000000000) {
            mantissa = mantissa * 10 + ((b - 48) as i64);
        } else {
            exp_adj = exp_adj + 1;
        }
        saw_int = true;
        i = i + 1;
    }

    // Fraction part: `.` followed by digits.
    if (i < n && s[i] == 46) {              // '.'
        i = i + 1;
        while (i < n) {
            b = s[i];
            if (b < 48 || b > 57) { break; }
            if (mantissa < 1000000000000000) {
                mantissa = mantissa * 10 + ((b - 48) as i64);
                exp_adj = exp_adj - 1;
            }
            saw_frac = true;
            i = i + 1;
        }
    }

    if (!saw_int && !saw_frac) { return None; }

    // Exponent part.
    if (i < n && (s[i] == 101 || s[i] == 69)) {  // 'e' / 'E'
        i = i + 1;
        var exp_neg: boolean = false;
        if (i < n && s[i] == 43) { i = i + 1; }                          // '+'
        else if (i < n && s[i] == 45) { exp_neg = true; i = i + 1; }     // '-'
        var exp: i32 = 0;
        var saw_exp: boolean = false;
        while (i < n) {
            b = s[i];
            if (b < 48 || b > 57) { break; }
            if (exp < 1000) { exp = exp * 10 + (b - 48); }
            saw_exp = true;
            i = i + 1;
        }
        if (!saw_exp) { return None; }
        if (exp_neg) { exp_adj = exp_adj - exp; }
        else { exp_adj = exp_adj + exp; }
    }

    if (i < n) { return None; }   // trailing garbage

    // v = (f32) mantissa * 10^exp_adj
    var v: f32 = mantissa as f32;
    while (exp_adj > 0) { v = v * 10.0 as f32; exp_adj = exp_adj - 1; }
    while (exp_adj < 0) { v = v / 10.0 as f32; exp_adj = exp_adj + 1; }
    if (neg) { v = 0.0 as f32 - v; }
    return Some(v);
}

// `repeat_char(ch, n)` — fresh string of n copies of the byte
// `ch`. Faster than `(c).chr().repeat(n)` would be (no chr
// helper exists yet; this is the substitute). `n <= 0`
// returns empty.
pub function repeat_char(ch: i32, n: i32): string {
    if (n <= 0) { return ""; }
    var buf: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) {
        buf = buf.with(i, ch as u8);
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `__is_ascii_ws(b)` — true for SP / TAB / LF / CR / VT / FF
// byte values. Internal helper used by trim() / fields() /
// is_blank() and by std/i32's is_ascii_white_space method.
pub function __is_ascii_ws(b: i32): boolean {
    return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
}

// `s.replace_at(i, new)` — return a copy of s with the byte at
// index i replaced by the first byte of `new`. If new is empty,
// the byte at i is dropped. Out-of-range i (negative or >=
// len(s)) is a no-op and returns s unchanged.
pub function (s: string) replace_at(i: i32, new: string): string {
    var n: i32 = s.len();
    if (i < 0 || i >= n) { return s; }
    if (new.len() == 0) {
        return s[0:i] + s[i + 1:n];
    }
    return s[0:i] + new[0:1] + s[i + 1:n];
}

// `s.without_byte(b)` — copy of s with every byte equal to b
// removed. ASCII-level; for multi-byte sequences use
// `replace_byte` or `replace(old, new)`.
pub function (s: string) without_byte(b: i32): string {
    var n: i32 = s.len();
    if (n == 0) { return s; }
    var buf: u8[] = __alloc_u8(n);
    var pos: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        if (s[i] != b) {
            buf = buf.with(pos, s[i] as u8);
            pos = pos + 1;
        }
        i = i + 1;
    }
    var out: u8[] = __alloc_u8(pos);
    var k: i32 = 0;
    while (k < pos) {
        out = out.with(k, buf[k]);
        k = k + 1;
    }
    return string_from_bytes(out);
}

// `s.repeat_to(target)` — concatenate copies of s until the
// result reaches at least `target` bytes, then truncate at the
// last full copy that fits. Empty s or target <= 0 → "". The
// truncate-not-overrun shape matches a common "fill to width
// without exceeding" pattern.
pub function (s: string) repeat_to(target: i32): string {
    var sLen: i32 = s.len();
    if (sLen == 0 || target <= 0) { return ""; }
    var copies: i32 = target / sLen;
    return s.repeat(copies);
}
