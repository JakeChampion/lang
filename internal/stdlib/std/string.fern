// END GENERATED EISEL-LEMIRE TABLE

// floor(log2(10^q)) + 63, the magic-multiply approximation, exact over
// q in [-342, 308].
function _el_log2_pow10(q: i32): i32 {
  return (217706 * q >> 16) + 63;
}

// _el_compute returns the binary64 bits of w * 10^q: the 11-bit exponent field
// above the 52-bit stored mantissa.
function _el_compute(w: u64, q: i32): u64 {
  if (w == 0 as u64 || q < 0 - 342) {  // zero
    return 0 as u64;
  }
  if (q > 308) {  // +Inf
    return 9218868437227405312 as u64;
  }

  // The 128-bit product of the normalised significand with 5^q, taking the
  // low table word only when the leading bits are too close to call (the low
  // 9 bits all set).
  let lz: i32 = __clz64(w);
  let x: u64 = w << lz as u64;
  let at: i32 = (q + 342) * 2;
  let hi: u64 = __mulhi_u64(x, EL_POW5[at]);
  let lo: u64 = x * EL_POW5[at];
  if ((hi & 511 as u64) == 511 as u64) {
    let carry: u64 = __mulhi_u64(x, EL_POW5[at + 1]);
    lo = lo + carry;
    if (carry > lo) {
      hi = hi + 1 as u64;
    }
  }
  let upperbit: i32 = (hi >> 63 as u64) as i32;
  let shift: i32 = upperbit + 9;  // upperbit + 64 - 52 - 3
  let mant: u64 = hi >> shift as u64;
  let pow2: i32 = _el_log2_pow10(q) + upperbit - lz + 1023;

  if (pow2 <= 0) {
    // Subnormal, or below the smallest one.
    if (1 - pow2 >= 64) {
      return 0 as u64;
    }
    mant = mant >> (1 - pow2) as u64;
    mant = mant + (mant & 1 as u64);
    // A carry into bit 52 is the exponent field's 1: rounding up lifted the
    // value into the normal range.
    return mant >> 1 as u64;
  }

  // A tie can only occur where 5^q fits in one 64-bit word; there `lo <= 1`
  // means the bits dropped by the shift were all zero, so the value sits
  // exactly on a midpoint and round-half-to-even applies.
  if (lo <= 1 as u64 && q >= 0 - 4 && q <= 23 && (mant & 3 as u64) == 1 as u64) {
    if (mant << shift as u64 == hi) {
      mant = mant - (mant & 1 as u64);
    }
  }
  mant = mant + (mant & 1 as u64);
  mant = mant >> 1 as u64;
  if (mant >= 9007199254740992 as u64) {  // carried out of 53 bits
    mant = 4503599627370496 as u64;
    pow2 = pow2 + 1;
  }
  if (pow2 >= 2047) {  // overflowed to +Inf
    return 9218868437227405312 as u64;
  }
  return pow2 as u64 << 52 as u64 | mant & 4503599627370495 as u64;
}

// _el_parse is the fast path for `dig * 10^k`, with `dig` already stripped of
// leading and trailing zeros. Returns the bits when the answer is proven
// exact, or -1 when the caller must use __decimal_to_f64.
function _el_parse(dig: string, k: i32): i64 {
  let nd: i32 = dig.len();
  if (nd == 0) {  // value is zero
    return 0;
  }
  let take: i32 = nd;
  if (take > 19) {
    take = 19;
  }
  let w: u64 = 0 as u64;
  let i: i32 = 0;
  while (i < take) {
    w = w * (10 as u64) + (dig[i] as i32 - 48) as u64;
    i = i + 1;
  }
  // Dropped digits only shift the exponent; they never change `w`.
  let q: i32 = k + (nd - take);
  let r: u64 = _el_compute(w, q);
  // Truncated: the true significand lies in (w, w+1). If both ends give the
  // same double, every value between them does too.
  if (nd > take && _el_compute(w + 1 as u64, q) != r) {
    return 0 - 1;
  }
  return r as i64;
}

// `s.parse_float()` — decimal f64 parser (f64 is the language's
// primary float, #5363). Grammar:
//   [-]<digits>[.<digits>][(e|E)[+-]?<digits>]
// At least one of integer or fraction digits required; trailing
// garbage rejected. The result is the correctly-rounded
// (round-half-to-even) nearest f64 — bit-exact with strconv (#5566).
//
// Up to 19 significant digits are gathered into a u64 as they are scanned
// and go straight to Eisel-Lemire, allocating nothing. A number with a
// nonzero digit past the 19th takes `__parse_float_exact`.
pub function (s: string) parse_float(): Option[f64] {
  let n: i32 = s.len();
  let i: i32 = 0;
  let neg: boolean = false;
  if (n > 0 && s[0] == 45) {  // '-'
    neg = true;
    i = 1;
  }
  // w holds the significant digits read so far, kept of them; a digit past
  // the 19th only moves the exponent (shift), unless it is nonzero (lost).
  let w: u64 = 0 as u64;
  let kept: i32 = 0;
  let shift: i32 = 0;
  let lost: boolean = false;
  let digits: i32 = 0;
  let fraclen: i32 = 0;
  let b: i32 = 0;
  let in_frac: boolean = false;
  while (i < n) {
    b = s[i] as i32;
    if (b == 46 && !in_frac) {  // '.'
      in_frac = true;
      i = i + 1;
      continue;
    }
    if (b < 48 || b > 57) {
      break;
    }
    digits = digits + 1;
    if (in_frac) {
      fraclen = fraclen + 1;
    }
    if (kept < 19) {
      if (kept > 0 || b != 48) {
        w = w * (10 as u64) + (b - 48) as u64;
        kept = kept + 1;
      }
    } else {
      shift = shift + 1;
      lost = lost || b != 48;
    }
    i = i + 1;
  }
  if (digits == 0) {
    return None;
  }
  let eexp: i32 = 0;
  if (i < n && (s[i] == 101 || s[i] == 69)) {  // 'e' / 'E'
    i = i + 1;
    let exp_neg: boolean = false;
    if (i < n && (s[i] == 43 || s[i] == 45)) {
      exp_neg = s[i] == 45;
      i = i + 1;
    }
    let exp_start: i32 = i;
    while (i < n) {
      b = s[i] as i32;
      if (b < 48 || b > 57) {
        break;
      }
      if (eexp < 1000000) {
        eexp = eexp * 10 + (b - 48);
      }
      i = i + 1;
    }
    if (i == exp_start) {
      return None;
    }
    if (exp_neg) {
      eexp = 0 - eexp;
    }
  }
  if (i < n) {  // trailing garbage
    return None;
  }
  if (lost) {
    return __parse_float_exact(s);
  }
  let v: f64 = 0.0;
  if (kept > 0) {
    // Trailing zeros go to the exponent, giving Eisel-Lemire the same
    // (w, q) as the exact path's stripped digits.
    let q: i32 = eexp - fraclen + shift;
    while (w % (10 as u64) == 0 as u64) {
      w = w / (10 as u64);
      q = q + 1;
    }
    v = f64_from_bits(_el_compute(w, q) as i64);
  }
  if (neg) {
    v = 0.0 - v;
  }
  return Some(v);
}

// __parse_float_exact is parse_float for a number with more than 19
// significant digits: every digit goes into a decimal string, which
// Eisel-Lemire decides when it can and `__decimal_to_f64` otherwise.
function __parse_float_exact(s: string): Option[f64] {
  let n: i32 = s.len();
  if (n == 0) {
    return None;
  }

  let i: i32 = 0;
  let neg: boolean = false;
  if (s[0] == 45) {  // '-'
    if (n == 1) {
      return None;
    }
    neg = true;
    i = 1;
  }

  // Collect every integer + fraction digit into one buffer; the base-10
  // exponent tracks the decimal point and the literal exponent.
  let db: u8[] = [];
  let fraclen: i32 = 0;
  let saw_int: boolean = false;
  let saw_frac: boolean = false;
  // Single `b` reused across the integer / fraction / exponent inner
  // loops — declaring the same name in multiple inner scopes triggers a
  // duplicate-local collision in the wasm emitter.
  let b: i32 = 0;

  while (i < n) {
    b = s[i] as i32;
    if (b < 48 || b > 57) {
      break;
    }
    db = db.append(b as u8);
    saw_int = true;
    i = i + 1;
  }

  if (i < n && s[i] == 46) {  // '.'
    i = i + 1;
    while (i < n) {
      b = s[i] as i32;
      if (b < 48 || b > 57) {
        break;
      }
      db = db.append(b as u8);
      fraclen = fraclen + 1;
      saw_frac = true;
      i = i + 1;
    }
  }

  if (!saw_int && !saw_frac) {
    return None;
  }

  let eexp: i32 = 0;
  if (i < n && (s[i] == 101 || s[i] == 69)) {  // 'e' / 'E'
    i = i + 1;
    let exp_neg: boolean = false;
    if (i < n && s[i] == 43) {  // '+'
      i = i + 1;
    } else if (i < n && s[i] == 45) {  // '-'
      exp_neg = true;
      i = i + 1;
    }
    let exp: i32 = 0;
    let saw_exp: boolean = false;
    while (i < n) {
      b = s[i] as i32;
      if (b < 48 || b > 57) {
        break;
      }
      if (exp < 1000000) {
        exp = exp * 10 + (b - 48);
      }
      saw_exp = true;
      i = i + 1;
    }
    if (!saw_exp) {
      return None;
    }
    if (exp_neg) {
      eexp = 0 - exp;
    } else {
      eexp = exp;
    }
  }

  if (i < n) {  // trailing garbage
    return None;
  }

  // value = (db as integer) * 10^(eexp - fraclen). Strip leading zeros
  // (no value change) and trailing zeros (each bumps the exponent) so
  // the bignum stays small and `dig` is canonical.
  let m: i32 = db.len();
  let lo: i32 = 0;
  while (lo < m && db[lo] == 48) {
    lo = lo + 1;
  }
  let hi: i32 = m - 1;
  while (hi >= lo && db[hi] == 48) {
    hi = hi - 1;
  }
  let k: i32 = eexp - fraclen + (m - 1 - hi);
  let dig: string = "";
  if (hi >= lo) {
    let out: u8[] = [];
    let j: i32 = lo;
    while (j <= hi) {
      out = out.append(db[j]);
      j = j + 1;
    }
    dig = string_from_bytes_unchecked(out);
  }

  // Eisel-Lemire decides almost every input with one 128-bit multiply;
  // __decimal_to_f64 is the exact fallback for the rest.
  let bits: i64 = _el_parse(dig, k);
  let v: f64 = 0.0;
  if (bits >= 0) {
    v = f64_from_bits(bits);
  } else {
    v = __decimal_to_f64(dig, k);
  }
  if (neg) {
    v = 0.0 - v;
  }
  return Some(v);
}

// `repeat_char(ch, n)` repeats a Unicode scalar n times. Nonpositive n
// returns empty. Use a byte array when the repeated value is a raw byte.
pub function repeat_char(ch: char, n: i32): string {
  if (n <= 0) {
    return "";
  }
  return string_from_codepoint(ch).repeat(n);
}

// `__is_ascii_ws(b)` — true for SP / TAB / LF / CR / VT / FF
// byte values. Internal helper used by trim() / fields() /
// is_blank() and by std/i32's is_ascii_white_space method.
pub function __is_ascii_ws(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

// `s.replace_at(i, new)` replaces the scalar at byte offset i with the first
// scalar of new, or removes it when new is empty. An out-of-range offset or
// an offset inside a scalar leaves s unchanged.
pub function (s: string) replace_at(i: i32, new: string): string {
  let n: i32 = s.len();
  if (i < 0 || i >= n) {
    return s;
  }
  if (__floor_boundary(s, i) != i) {
    return s;
  }
  let end: i32 = i + __utf8_step(s, i, n);
  if (new.len() == 0) {
    return slice_unchecked(s, 0, i) + slice_unchecked(s, end, n);
  }
  let width: i32 = __utf8_step(new, 0, new.len());
  return slice_unchecked(s, 0, i) + slice_unchecked(new, 0, width) + slice_unchecked(s, end, n);
}

// `s.without_byte(b)` returns owned bytes with every byte equal to b removed.
// Use replace(old, "") or without_chars(set) for text.
pub function (s: string) without_byte(b: u8): u8[] {
  let n: i32 = s.len();
  let buf: u8[] = __alloc_u8(n);
  let pos: i32 = 0;
  let i: i32 = 0;
  while (i < n) {
    if (s[i] as i32 != b as i32) {
      buf = buf.with(pos, s[i] as u8);
      pos = pos + 1;
    }
    i = i + 1;
  }
  let out: u8[] = __alloc_u8(pos);
  let k: i32 = 0;
  while (k < pos) {
    out = out.with(k, buf[k]);
    k = k + 1;
  }
  return out;
}

// `s.repeat_to(target)` — concatenate copies of s until the
// result reaches at least `target` bytes, then truncate at the
// last full copy that fits. Empty s or target <= 0 → "". The
// truncate-not-overrun shape matches a common "fill to width
// without exceeding" pattern.
pub function (s: string) repeat_to(target: i32): string {
  let sLen: i32 = s.len();
  if (sLen == 0 || target <= 0) {
    return "";
  }
  let copies: i32 = target / sLen;
  return s.repeat(copies);
}
