// END GENERATED EISEL-LEMIRE TABLE

// _el_dig decodes one table character to its 6-bit value. The alphabet is 64
// printable ASCII characters in two contiguous spans, '0'..'[' (48..91) and
// ']'..'p' (93..112); it skips '\' so no character needs escaping.
function _el_dig(c: i32): u64 {
    if (c < 92) { return (c - 48) as u64; }
    return (c - 49) as u64;
}

// _el_word decodes the 64-bit word starting at `at`: 11 characters, most
// significant base-64 digit first.
function _el_word(s: string, at: i32): u64 {
    var v: u64 = 0 as u64;
    var i: i32 = 0;
    while (i < 11) {
        v = v * (64 as u64) + _el_dig(s[at + i] as i32);
        i = i + 1;
    }
    return v;
}

// _el_mul64 is the 64x64 -> 128 widening multiply, returned as (high, low),
// assembled from four 32x32 -> 64 partial products.
function _el_mul64(x: u64, y: u64): (u64, u64) {
    var m: u64 = 4294967295 as u64;
    var sh: u64 = 32 as u64;
    var a: u64 = x >> sh; var b: u64 = x & m;
    var c: u64 = y >> sh; var d: u64 = y & m;
    var bd: u64 = b * d; var ad: u64 = a * d; var bc: u64 = b * c;
    var mid: u64 = (bd >> sh) + (ad & m) + (bc & m);
    var hi: u64 = a * c + (mid >> sh) + (ad >> sh) + (bc >> sh);
    return (hi, ((mid & m) << sh) | (bd & m));
}

// _el_clz64 counts leading zero bits. `x` is never zero at the call site.
function _el_clz64(x: u64): i32 {
    var n: i32 = 0;
    var v: u64 = x;
    if (v >> (32 as u64) == (0 as u64)) { n = n + 32; v = v << (32 as u64); }
    if (v >> (48 as u64) == (0 as u64)) { n = n + 16; v = v << (16 as u64); }
    if (v >> (56 as u64) == (0 as u64)) { n = n + 8;  v = v << (8 as u64); }
    if (v >> (60 as u64) == (0 as u64)) { n = n + 4;  v = v << (4 as u64); }
    if (v >> (62 as u64) == (0 as u64)) { n = n + 2;  v = v << (2 as u64); }
    if (v >> (63 as u64) == (0 as u64)) { n = n + 1; }
    return n;
}

// floor(log2(10^q)) + 63, the magic-multiply approximation, exact over
// q in [-342, 308].
function _el_log2_pow10(q: i32): i32 { return ((217706 * q) >> 16) + 63; }

// _el_mul_pow5 is the 128-bit product of the normalised significand with the
// power of five for `q`, taking a second multiplication only when the leading
// bits are too close to call (the low 9 bits all set).
function _el_mul_pow5(q: i32, w: u64): (u64, u64) {
    var tbl: string = _el_pow5();
    var at: i32 = (q + 342) * 22;
    var phi: u64 = _el_word(tbl, at);
    var r: (u64, u64) = _el_mul64(w, phi);
    var hi: u64 = r.0;
    var lo: u64 = r.1;
    if ((hi & (511 as u64)) == (511 as u64)) {
        var r2: (u64, u64) = _el_mul64(w, _el_word(tbl, at + 11));
        lo = lo + r2.0;
        if (r2.0 > lo) { hi = hi + (1 as u64); }
    }
    return (hi, lo);
}

// _el_compute returns (mantissa, biased exponent) for w * 10^q as a binary64:
// the 52-bit stored mantissa and the 11-bit exponent field, ready to pack.
function _el_compute(w: u64, q: i32): (u64, i32) {
    if (w == (0 as u64) || q < 0 - 342) { return (0 as u64, 0); }        // zero
    if (q > 308) { return (0 as u64, 2047); }                            // +Inf

    var lz: i32 = _el_clz64(w);
    var p: (u64, u64) = _el_mul_pow5(q, w << (lz as u64));
    var hi: u64 = p.0;
    var lo: u64 = p.1;
    var upperbit: i32 = (hi >> (63 as u64)) as i32;
    var shift: i32 = upperbit + 9;                  // upperbit + 64 - 52 - 3
    var mant: u64 = hi >> (shift as u64);
    var pow2: i32 = _el_log2_pow10(q) + upperbit - lz + 1023;

    if (pow2 <= 0) {
        // Subnormal, or below the smallest one.
        if (1 - pow2 >= 64) { return (0 as u64, 0); }
        mant = mant >> ((1 - pow2) as u64);
        mant = mant + (mant & (1 as u64));
        mant = mant >> (1 as u64);
        // Rounding up can lift the value back into the normal range, so the
        // exponent field is decided only after rounding.
        if (mant >= (4503599627370496 as u64)) { return (mant & (4503599627370495 as u64), 1); }
        return (mant, 0);
    }

    // A tie can only occur where 5^q fits in one 64-bit word; there `lo <= 1`
    // means the bits dropped by the shift were all zero, so the value sits
    // exactly on a midpoint and round-half-to-even applies.
    if (lo <= (1 as u64) && q >= 0 - 4 && q <= 23 && (mant & (3 as u64)) == (1 as u64)) {
        if ((mant << (shift as u64)) == hi) { mant = mant - (mant & (1 as u64)); }
    }
    mant = mant + (mant & (1 as u64));
    mant = mant >> (1 as u64);
    if (mant >= (9007199254740992 as u64)) {        // carried out of 53 bits
        mant = 4503599627370496 as u64;
        pow2 = pow2 + 1;
    }
    mant = mant & (4503599627370495 as u64);        // drop the implicit bit
    if (pow2 >= 2047) { return (0 as u64, 2047); }  // overflowed to +Inf
    return (mant, pow2);
}

// _el_parse is the fast path for `dig * 10^k`, with `dig` already stripped of
// leading and trailing zeros. Returns (bits, true) when the answer is proven
// exact, or (0, false) when the caller must use __decimal_to_f64.
function _el_parse(dig: string, k: i32): (i64, boolean) {
    var nd: i32 = dig.len();
    if (nd == 0) { return (0, true); }               // value is zero
    var take: i32 = nd; if (take > 19) { take = 19; }
    var w: u64 = 0 as u64;
    var i: i32 = 0;
    while (i < take) {
        w = w * (10 as u64) + ((dig[i] as i32) - 48) as u64;
        i = i + 1;
    }
    // Dropped digits only shift the exponent; they never change `w`.
    var q: i32 = k + (nd - take);

    var r: (u64, i32) = _el_compute(w, q);
    if (nd > take) {
        // Truncated: the true significand lies in (w, w+1). If both ends give
        // the same double, every value between them does too.
        var r2: (u64, i32) = _el_compute(w + (1 as u64), q);
        if (r.0 != r2.0 || r.1 != r2.1) { return (0, false); }
    }
    return (((r.1 as i64) << 52) | (r.0 as i64), true);
}

// `s.parse_float()` — decimal f64 parser (f64 is the language's
// primary float, #5363). Grammar:
//   [-]<digits>[.<digits>][(e|E)[+-]?<digits>]
// At least one of integer or fraction digits required; trailing
// garbage rejected. The significant digits and base-10 exponent go to
// Eisel-Lemire (`_el_parse`), falling back to the exact `__decimal_to_f64`
// on the rare input it cannot decide. Either way the result is the
// correctly-rounded (round-half-to-even) nearest f64 — bit-exact with
// strconv (#5566).
pub function (s: string) parse_float(): Option[f64] {
    var n: i32 = s.len();
    if (n == 0) { return None; }

    var i: i32 = 0;
    var neg: boolean = false;
    if (s[0] == 45) {                       // '-'
        if (n == 1) { return None; }
        neg = true;
        i = 1;
    }

    // Collect every integer + fraction digit into one buffer; the base-10
    // exponent tracks the decimal point and the literal exponent.
    var db: u8[] = [];
    var fraclen: i32 = 0;
    var saw_int: boolean = false;
    var saw_frac: boolean = false;
    // Single `b` reused across the integer / fraction / exponent inner
    // loops — declaring the same name in multiple inner scopes triggers a
    // duplicate-local collision in the wasm emitter.
    var b: i32 = 0;

    while (i < n) {
        b = s[i] as i32;
        if (b < 48 || b > 57) { break; }
        db = db.append(b as u8);
        saw_int = true;
        i = i + 1;
    }

    if (i < n && s[i] == 46) {              // '.'
        i = i + 1;
        while (i < n) {
            b = s[i] as i32;
            if (b < 48 || b > 57) { break; }
            db = db.append(b as u8);
            fraclen = fraclen + 1;
            saw_frac = true;
            i = i + 1;
        }
    }

    if (!saw_int && !saw_frac) { return None; }

    var eexp: i32 = 0;
    if (i < n && (s[i] == 101 || s[i] == 69)) {  // 'e' / 'E'
        i = i + 1;
        var exp_neg: boolean = false;
        if (i < n && s[i] == 43) { i = i + 1; }                          // '+'
        else if (i < n && s[i] == 45) { exp_neg = true; i = i + 1; }     // '-'
        var exp: i32 = 0;
        var saw_exp: boolean = false;
        while (i < n) {
            b = s[i] as i32;
            if (b < 48 || b > 57) { break; }
            if (exp < 1000000) { exp = exp * 10 + (b - 48); }
            saw_exp = true;
            i = i + 1;
        }
        if (!saw_exp) { return None; }
        if (exp_neg) { eexp = 0 - exp; }
        else { eexp = exp; }
    }

    if (i < n) { return None; }   // trailing garbage

    // value = (db as integer) * 10^(eexp - fraclen). Strip leading zeros
    // (no value change) and trailing zeros (each bumps the exponent) so
    // the bignum stays small and `dig` is canonical.
    var m: i32 = db.len();
    var lo: i32 = 0;
    while (lo < m && db[lo] == 48) { lo = lo + 1; }
    var hi: i32 = m - 1;
    while (hi >= lo && db[hi] == 48) { hi = hi - 1; }
    var k: i32 = eexp - fraclen + (m - 1 - hi);
    var dig: string = "";
    if (hi >= lo) {
        var out: u8[] = [];
        var j: i32 = lo;
        while (j <= hi) { out = out.append(db[j]); j = j + 1; }
        dig = string_from_bytes_unchecked(out);
    }

    // Eisel-Lemire decides almost every input with one 128-bit multiply;
    // __decimal_to_f64 is the exact fallback for the rest.
    var fast: (i64, boolean) = _el_parse(dig, k);
    var v: f64 = 0.0;
    if (fast.1) { v = f64_from_bits(fast.0); }
    else { v = __decimal_to_f64(dig, k); }
    if (neg) { v = 0.0 - v; }
    return Some(v);
}

// `repeat_char(ch, n)` — fresh string of n copies of the byte
// `ch`. Faster than `(c).chr().repeat(n)` would be (no chr
// helper exists yet; this is the substitute). `n <= 0`
// returns empty.
pub function repeat_char(ch: i32, n: i32): string {
    if (n <= 0) { return ""; }
    var buf: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) {
        buf = buf.with(i, ch as u8);
        i = i + 1;
    }
    return string_from_bytes_unchecked(buf);
}

// `__is_ascii_ws(b)` — true for SP / TAB / LF / CR / VT / FF
// byte values. Internal helper used by trim() / fields() /
// is_blank() and by std/i32's is_ascii_white_space method.
pub function __is_ascii_ws(b: i32): boolean {
    return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
}

// `s.replace_at(i, new)` — return a copy of s with the byte at
// index i replaced by the first byte of `new`. If new is empty,
// the byte at i is dropped. Out-of-range i (negative or >=
// len(s)) is a no-op and returns s unchanged.
pub function (s: string) replace_at(i: i32, new: string): string {
    var n: i32 = s.len();
    if (i < 0 || i >= n) { return s; }
    if (new.len() == 0) {
        return s[0:i] + s[i + 1:n];
    }
    return s[0:i] + new[0:1] + s[i + 1:n];
}

// `s.without_byte(b)` — copy of s with every byte equal to b
// removed. ASCII-level; for multi-byte sequences use
// `replace_byte` or `replace(old, new)`.
pub function (s: string) without_byte(b: i32): string {
    var n: i32 = s.len();
    if (n == 0) { return s; }
    var buf: u8[] = __alloc_u8(n);
    var pos: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        if ((s[i] as i32) != b) {
            buf = buf.with(pos, s[i] as u8);
            pos = pos + 1;
        }
        i = i + 1;
    }
    var out: u8[] = __alloc_u8(pos);
    var k: i32 = 0;
    while (k < pos) {
        out = out.with(k, buf[k]);
        k = k + 1;
    }
    return string_from_bytes_unchecked(out);
}

// `s.repeat_to(target)` — concatenate copies of s until the
// result reaches at least `target` bytes, then truncate at the
// last full copy that fits. Empty s or target <= 0 → "". The
// truncate-not-overrun shape matches a common "fill to width
// without exceeding" pattern.
pub function (s: string) repeat_to(target: i32): string {
    var sLen: i32 = s.len();
    if (sLen == 0 || target <= 0) { return ""; }
    var copies: i32 = target / sLen;
    return s.repeat(copies);
}
