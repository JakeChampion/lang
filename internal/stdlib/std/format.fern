// std/format — human-readable formatting helpers.
//
// `format(fmt, args)` — runtime template substitution with `{}`
// placeholders and Rust-style `{:fill|align|width.precision}`
// format specs. `format_bytes(n)` / `format_duration_ms(ms)` —
// pre-canned shapes for byte sizes and elapsed durations.
//
// No prelude: callers now `import "std/format";` explicitly
// (docs/PRELUDE-TO-MODULES.md, Phase 5).

// std/format's bodies dispatch (i32) `.abs()` (for negative
// sign handling) and (i32) `.to_string()` (in format_bytes /
// format_duration_ms). Declare std/i32 so those methods
// register under no-prelude.
import "std/i32";

// `format(fmt, args)` — runtime template substitution. Walks
// fmt byte-by-byte, replacing each `{}` / `{:spec}` placeholder
// with the next element of args. Extra args (more args than
// placeholders) are silently dropped; missing args (more
// placeholders than args) emit the placeholder unchanged.
// Mirrors Python's `str.format()` / Rust's `format!()` minimal
// subset.
//
// Format specs (the bit after the `:`) follow Rust's
// `[[fill]align][sign]['0'][width][.precision]` grammar, applied
// to the already-stringified arg:
//   - align: `<` left, `>` right, `^` center (default left).
//   - fill: any char immediately before an align char, e.g.
//     `{:*>8}` pads with `*`. Defaults to a space.
//   - sign: `+` forces a leading `+` on a value that looks like a
//     non-negative number (first byte a digit); `-` is the default
//     no-op. A value that already carries a `-`/`+` is left as-is,
//     and a non-numeric value never gets a sign — so `{:+}` of "42"
//     is "+42", of "-42" stays "-42", of "ok" stays "ok".
//   - `0`: sign-aware zero-padding. A leading `0` before the width
//     digits pads with `0` instead of the fill char, inserting the
//     zeros *after* any leading sign and counting the sign toward
//     the width — so `{:05}` of "-42" is "-0042" and `{:+06}` of
//     "42" is "+00042". The `0` flag overrides fill/align (matching
//     Rust), so `{:<05}` of "42" is still "00042".
//   - width: minimum field width; the value is padded (never
//     truncated) up to it.
//   - precision: `.N` truncates the string to at most N bytes
//     (Rust's string-precision semantics), applied before
//     padding — so `{:>8.3}` of "hello" is "     hel".
// A spec whose content doesn't start with `:` (e.g. `{abc}`) is
// not a placeholder and renders literally, so JSON-ish braces
// pass through untouched.
//
// Use cases the f-string sugar doesn't cover:
//   - Dynamic templates (read from a config file, locale
//     table, error catalogue, etc.).
//   - Programs that build their own diagnostic strings —
//     a checker emitting "expected {}, got {}" where the
//     template lives in a const-table rather than at every
//     call site.
//   - Column-aligned CLI / table output via width + fill.
//
// Caller pre-stringifies args (`to_string()` for i32 / i64 /
// f32 / f64 / boolean; `to_string_prec()` for fixed-precision
// floats). A generic-`Display` overload story would need trait
// dispatch which lang doesn't have yet; the string[] signature
// keeps the type story trivial.
pub function format(fmt: string, args: string[]): string {
    var n: i32 = fmt.len();
    // Accumulate into a growable u8[] and materialise once (#4379): the old
    // `out = out + …` appended each literal byte / spec result onto an immutable
    // string, recopying the whole growing result every step — O(output²) on the
    // hot formatting path. `out` is a LOCAL, so `out = out.append(byte)` grows
    // the buffer in place (amortized O(1), the rc-gated self-push); the byte
    // copies are inlined rather than routed through a helper precisely so they
    // stay on the local (a borrowed-param `buf.append` would copy the whole
    // buffer per call, reintroducing the quadratic). Byte indexing (`fmt[i]`)
    // and single-byte appends preserve the byte-for-byte (UTF-8-agnostic)
    // behaviour of the old 1-byte `fmt[i:i+1]` slices.
    var out: u8[] = [];
    var i: i32 = 0;
    var argi: i32 = 0;
    while (i < n) {
        // Escaped braces: `{{` -> literal `{`, `}}` -> literal `}` (the
        // Python str.format() / Rust format!() convention this mirrors). Checked
        // before the `{}` placeholder so `{{}}` renders the literal "{}" rather
        // than consuming an arg, and `{{{}}}` renders "{<arg>}".
        if (i + 1 < n && fmt[i] == 123 && fmt[i + 1] == 123) {
            out = out.append(123 as u8);   // '{'
            i = i + 2;
        } else if (i + 1 < n && fmt[i] == 125 && fmt[i + 1] == 125) {
            out = out.append(125 as u8);   // '}'
            i = i + 2;
        } else if (fmt[i] == 123) {
            // Opening brace: scan for the matching `}` and decide whether the
            // run is a placeholder. The content is a placeholder spec only when
            // it is empty (`{}`) or starts with `:` (`{:>8}`); anything else
            // (`{abc}`, JSON `{"k":1}`) renders literally and consumes no arg.
            var j: i32 = i + 1;
            while (j < n && fmt[j] != 125) { j = j + 1; }
            var isPlaceholder: boolean = false;
            var spec: str = "";
            if (j < n) {
                spec = fmt[i + 1:j];
                if (spec.len() == 0) { isPlaceholder = true; }
                else if (spec[0] == 58) { isPlaceholder = true; }
            }
            if (isPlaceholder) {
                if (argi < args.len()) {
                    var piece: string = __format_apply_spec(args[argi], spec);
                    var pl: i32 = piece.len();
                    var pk: i32 = 0;
                    while (pk < pl) { out = out.append(piece[pk] as u8); pk = pk + 1; }
                    argi = argi + 1;
                } else {
                    // Missing arg — emit the placeholder verbatim so callers
                    // can spot the underflow at runtime.
                    out = out.append(123 as u8);   // '{'
                    var sl: i32 = spec.len();
                    var sk: i32 = 0;
                    while (sk < sl) { out = out.append(spec[sk] as u8); sk = sk + 1; }
                    out = out.append(125 as u8);   // '}'
                }
                i = j + 1;
            } else {
                out = out.append(fmt[i] as u8);
                i = i + 1;
            }
        } else {
            out = out.append(fmt[i] as u8);
            i = i + 1;
        }
    }
    return string_from_bytes(out);
}

// __format_apply_spec applies a `:`-prefixed format spec to an
// already-stringified value. `spec` is either "" (plain `{}`,
// returned unchanged) or starts with ':' followed by the
// `[[fill]align][sign]['0'][width][.precision]` grammar. Precision
// truncates first, then width pads — matching Rust's ordering.
function __format_apply_spec(s: string, spec: string): string {
    if (spec.len() == 0) { return s; }
    var m: i32 = spec.len();
    var p: i32 = 1; // skip the leading ':'
    // [fill]align — a fill char only counts when an align char (`<>^`)
    // follows it; a bare align char takes the default space fill.
    var fill: str = " ";
    var align: i32 = 1; // 1=left, 2=right, 3=center; strings default left.
    if (p + 1 < m && __is_align(spec[p + 1])) {
        fill = spec[p:p + 1];
        align = __align_code(spec[p + 1]);
        p = p + 2;
    } else if (p < m && __is_align(spec[p])) {
        align = __align_code(spec[p]);
        p = p + 1;
    }
    // sign — `+` forces a leading `+` on non-negative numbers; `-`
    // is the default and a no-op. Consumed here so it precedes the
    // `0` flag and width, per Rust's `[sign]['0'][width]` order.
    var plus: boolean = false;
    if (p < m && spec[p] == 43) { plus = true; p = p + 1; }      // '+'
    else if (p < m && spec[p] == 45) { p = p + 1; }              // '-'
    // `0` flag — a leading `0` before the width digits selects
    // sign-aware zero-padding (overriding fill/align). The flag is
    // consumed here; any further digits are the width.
    var zero: boolean = false;
    if (p < m && spec[p] == 48) { zero = true; p = p + 1; }      // '0'
    // width — run of decimal digits.
    var width: i32 = 0;
    while (p < m && spec[p] >= 48 && spec[p] <= 57) {
        width = width * 10 + (spec[p] - 48);
        p = p + 1;
    }
    // .precision — truncate the value to at most `prec` bytes.
    var val: string = s;
    if (p < m && spec[p] == 46) {
        p = p + 1;
        var prec: i32 = 0;
        while (p < m && spec[p] >= 48 && spec[p] <= 57) {
            prec = prec * 10 + (spec[p] - 48);
            p = p + 1;
        }
        if (val.len() > prec) { val = val[0:prec].to_owned(); }
    }
    // sign flag — prefix `+` on a value that looks like a non-negative
    // number (first byte a digit). A value already carrying `-`/`+`,
    // or a non-numeric one, is left untouched.
    if (plus && val.len() > 0 && val[0] >= 48 && val[0] <= 57) {
        val = "+" + val;
    }
    // width padding — never truncates.
    var vlen: i32 = val.len();
    if (vlen >= width) { return val; }
    var pad: i32 = width - vlen;
    // zero-pad — sign-aware: zeros go after a leading sign char, and
    // the sign counts toward the width. Overrides fill/align.
    if (zero) {
        if (val.len() > 0 && (val[0] == 45 || val[0] == 43)) {
            return val[0:1] + __repeat_char("0", pad) + val[1:val.len()];
        }
        return __repeat_char("0", pad) + val;
    }
    if (align == 2) {
        return __repeat_char(fill, pad) + val;
    }
    if (align == 3) {
        var left: i32 = pad / 2;
        return __repeat_char(fill, left) + val + __repeat_char(fill, pad - left);
    }
    return val + __repeat_char(fill, pad);
}

function __is_align(c: i32): boolean {
    return c == 60 || c == 62 || c == 94; // '<' '>' '^'
}

function __align_code(c: i32): i32 {
    if (c == 60) { return 1; } // '<' left
    if (c == 62) { return 2; } // '>' right
    return 3;                  // '^' center
}

function __repeat_char(s: string, count: i32): string {
    if (count <= 0) { return ""; }
    var sl: i32 = s.len();
    if (sl == 0) { return ""; }
    // Fill one exact-size (sl·count) buffer instead of `out = out + s`,
    // which recopied the growing prefix on every step (O((sl·count)²) — #4379).
    // Same two-pass idiom as std/string's `repeat`; keeps every padded/aligned
    // format spec off the quadratic path.
    var buf: u8[] = __alloc_u8(sl * count);
    var pos: i32 = 0;
    var k: i32 = 0;
    while (k < count) {
        var j: i32 = 0;
        while (j < sl) {
            buf = buf.with(pos, s[j] as u8);
            pos = pos + 1;
            j = j + 1;
        }
        k = k + 1;
    }
    return string_from_bytes(buf);
}

// `format_bytes(n)` — render an i32 byte count as "N B" /
// "N KiB" / "N MiB" / "N GiB" using binary (1024-based)
// prefixes. Integer truncation only — for "1.5 KiB" the
// caller can divide by 1024 themselves and apply
// to_string_padded. Negative input is rendered with a
// leading "-" before the unit ("-512 B"). i32 caps the
// representable range at ~2 GiB which covers the common
// CLI / log use case; callers needing larger sizes can
// drop down to manual i64 div + to_string.
pub function format_bytes(n: i32): string {
    var neg: boolean = (n < 0);
    var mag: i32 = n;
    if (neg) { mag = n.abs(); }
    var sign: string = "";
    if (neg) { sign = "-"; }
    if (mag < 1024) {
        return sign + mag.to_string() + " B";
    }
    if (mag < 1024 * 1024) {
        return sign + (mag / 1024).to_string() + " KiB";
    }
    if (mag < 1024 * 1024 * 1024) {
        return sign + (mag / (1024 * 1024)).to_string() + " MiB";
    }
    return sign + (mag / (1024 * 1024 * 1024)).to_string() + " GiB";
}

// `format_duration_ms(ms)` — human-readable duration like
// "1h 23m 45s" / "500ms". Components are emitted only when
// non-zero, separated by spaces; "0" alone returns "0ms".
// Negative ms gets a leading "-" before the magnitude.
pub function format_duration_ms(ms: i32): string {
    if (ms == 0) { return "0ms"; }
    var neg: boolean = (ms < 0);
    var mag: i32 = ms;
    if (neg) { mag = ms.abs(); }
    var sign: string = "";
    if (neg) { sign = "-"; }
    var h: i32 = mag / 3600000;
    var rem: i32 = mag - h * 3600000;
    var m: i32 = rem / 60000;
    rem = rem - m * 60000;
    var s: i32 = rem / 1000;
    var msPart: i32 = rem - s * 1000;
    var out: string = "";
    if (h > 0) { out = out + h.to_string() + "h"; }
    if (m > 0) {
        if (out.len() > 0) { out = out + " "; }
        out = out + m.to_string() + "m";
    }
    if (s > 0) {
        if (out.len() > 0) { out = out + " "; }
        out = out + s.to_string() + "s";
    }
    if (msPart > 0) {
        if (out.len() > 0) { out = out + " "; }
        out = out + msPart.to_string() + "ms";
    }
    return sign + out;
}

// `parse_duration_ms(s)` — the inverse of `format_duration_ms`: parse a
// duration string into milliseconds. The input is a sequence of
// `<integer><unit>` parts (optionally space-separated), with units
// `ms` / `s` / `m` / `h` / `d`; e.g. `"500ms"`, `"1h30m"`, `"1h 30m"`,
// `"2d12h"`. Returns `None` on empty input, a missing/unknown unit, or a
// part with no number. The `i64` result holds durations far beyond the
// i32 that `format_duration_ms` takes.
pub function parse_duration_ms(s: string): Option[i64] {
    var n: i32 = s.len();
    var i: i32 = 0;
    var total: i64 = 0;
    var saw: boolean = false;
    while (i < n) {
        if (s[i] == 32) { i = i + 1; continue; }   // skip spaces
        var start: i32 = i;
        var num: i64 = 0;
        while (i < n && s[i] >= 48 && s[i] <= 57) {
            num = num * (10 as i64) + ((s[i] - 48) as i64);
            i = i + 1;
        }
        if (i == start) { return None; }            // expected a number
        var unit_ms: i64 = 0;
        if (i + 1 < n && s[i] == 109 && s[i + 1] == 115) {   // "ms"
            unit_ms = 1;
            i = i + 2;
        } else if (i < n && s[i] == 115) {                   // "s"
            unit_ms = 1000;
            i = i + 1;
        } else if (i < n && s[i] == 109) {                   // "m"
            unit_ms = 60000;
            i = i + 1;
        } else if (i < n && s[i] == 104) {                   // "h"
            unit_ms = 3600000;
            i = i + 1;
        } else if (i < n && s[i] == 100) {                   // "d"
            unit_ms = 86400000;
            i = i + 1;
        } else {
            return None;                                     // missing/unknown unit
        }
        total = total + num * unit_ms;
        saw = true;
    }
    if (!saw) { return None; }
    return Some(total);
}
