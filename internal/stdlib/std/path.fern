// std/path — POSIX path manipulation (string-level, no FS
// interaction).
//
// POSIX separator (`/`) only; Windows paths aren't a target
// right now (lang's stated platforms are Linux + macOS +
// wasi-edge). Matches Go `path/filepath` (Unix mode) and Zig
// `std.fs.path` minimally.
//
// Functions:
//   path_join(parts)    — joins parts with single `/` between,
//                         collapses double separators.
//   path_parent(p)      — leading-everything before the last
//                         `/`; "" for paths with no separator.
//   path_file_name(p)   — last component.
//   path_extension(p)   — substring after the LAST `.` of the
//                         last component, or "" if none. A
//                         leading-dot file (`.bashrc`) has no
//                         extension.
//   path_clean(p)       — lexically normalise a path: collapse
//                         duplicate `/`, drop `.` elements, and
//                         resolve `..` against the preceding
//                         element (Go `path.Clean`, Unix).
//
// Migrated from the former auto-injected prelude per
// docs/PRELUDE-TO-MODULES.md.

import "std/string";

pub function path_join(parts: string[]): string {
    var n: i32 = parts.len();
    if (n == 0) { return ""; }
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var p: string = parts[i];
        if (p.len() == 0) {
            i = i + 1;
        } else {
            if (out.len() == 0) {
                out = p;
            } else {
                // Strip a trailing `/` from out (unless out is
                // just "/", which is the root path and must be
                // preserved as a separator-sentinel).
                while (out.len() > 1 && out[out.len() - 1] == 47) {
                    out = out[0:out.len() - 1].to_owned();
                }
                // Strip any leading `/`s from p.
                var start: i32 = 0;
                while (start < p.len() && p[start] == 47) {
                    start = start + 1;
                }
                var rest: str = p[start:p.len()];
                if (out[out.len() - 1] == 47) {
                    out = out + rest;
                } else {
                    out = out + "/" + rest;
                }
            }
            i = i + 1;
        }
    }
    return out;
}

pub function path_parent(p: string): str {
    var n: i32 = p.len();
    if (n == 0) { return ""; }
    // Walk back from the end skipping a trailing `/`, find the
    // last separator, and return everything before it.
    var i: i32 = n - 1;
    // Special case: a single "/" parents to itself.
    if (n == 1 && p[0] == 47) { return "/"; }
    // Trim trailing slashes for the search.
    while (i > 0 && p[i] == 47) { i = i - 1; }
    while (i >= 0 && p[i] != 47) { i = i - 1; }
    if (i < 0) { return ""; }
    if (i == 0) { return "/"; }
    return p[0:i];
}

pub function path_file_name(p: string): str {
    var n: i32 = p.len();
    if (n == 0) { return ""; }
    // Trim trailing slashes — "a/b/" → "b".
    var end: i32 = n;
    while (end > 0 && p[end - 1] == 47) { end = end - 1; }
    if (end == 0) { return ""; }
    var i: i32 = end - 1;
    while (i >= 0 && p[i] != 47) { i = i - 1; }
    return p[i + 1:end];
}

pub function path_extension(p: string): str {
    var name: str = path_file_name(p);
    var n: i32 = name.len();
    if (n == 0) { return ""; }
    var i: i32 = n - 1;
    while (i > 0 && name[i] != 46) { i = i - 1; }
    // Hidden files (leading dot, no other dot) have no
    // extension: `.bashrc` → "", not "bashrc".
    if (i <= 0) { return ""; }
    return name[i + 1:n];
}

// path_clean lexically normalises `p` (no FS access), matching Go
// `path.Clean` in Unix mode. It applies, purely on the string:
//   - collapse runs of `/` into a single separator;
//   - drop `.` (current-dir) elements;
//   - resolve each `..` (parent-dir) against the preceding non-`..`
//     element, popping it — but a `..` that would climb above the
//     root of a ROOTED path is dropped (can't go above `/`), while a
//     leading `..` in a RELATIVE path is kept (it can climb).
// The result keeps a leading `/` iff `p` was rooted, ends in `/` only
// when it is the bare root, and is never empty: an empty input or a
// path that cleans away entirely (e.g. "a/..", "./") returns ".".
// seg_pop returns a fresh array with the last element of `xs` removed
// (path_clean's `..` resolution). A rebuild-by-append, mirroring
// std/array's `take` idiom — array slice-assignment yields a distinct
// slice type, and std/path keeps zero module dependencies.
function seg_pop(xs: string[]): string[] {
    var out: string[] = [];
    var last: i32 = xs.len() - 1;
    var i: i32 = 0;
    while (i < last) { out = out.append(xs[i]); i = i + 1; }
    return out;
}

pub function path_clean(p: string): string {
    var n: i32 = p.len();
    if (n == 0) { return "."; }
    var rooted: boolean = p[0] == 47; // leading '/'
    // Walk the segments, maintaining a stack. `.` is skipped; `..`
    // pops a real preceding element or (relative only) is pushed.
    var segs: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        // Skip separator run.
        while (i < n && p[i] == 47) { i = i + 1; }
        if (i >= n) { i = n; }
        else {
            var start: i32 = i;
            while (i < n && p[i] != 47) { i = i + 1; }
            var seg: str = p[start:i];
            if (seg == ".") {
                // current dir — drop
            } else if (seg == "..") {
                var slen: i32 = segs.len();
                if (slen > 0 && segs[slen - 1] != "..") {
                    segs = seg_pop(segs); // pop the preceding element
                } else if (!rooted) {
                    segs = segs.append(".."); // relative path may climb
                }
                // rooted with nothing to pop: drop (can't pass root)
            } else {
                segs = segs.append(seg);
            }
        }
    }
    // Re-join the surviving segments with single separators.
    var joined: string = "";
    var k: i32 = 0;
    while (k < segs.len()) {
        if (k > 0) { joined = joined + "/"; }
        joined = joined + segs[k];
        k = k + 1;
    }
    if (rooted) { return "/" + joined; } // "/"+"" = "/" (bare root)
    if (joined.len() == 0) { return "."; }
    return joined;
}
