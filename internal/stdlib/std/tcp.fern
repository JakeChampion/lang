// std/tcp — HTTP/1.1 accept loop + handler-friendly env helper.
//
// `tcp_serve(port, handler)` runs an HTTP/1.1 accept loop on
// `port`, calling `handler(req, plat)` once per accepted
// connection. The `plat: Platform` capability bag is the seam
// where future host-side effects (fetch / kv / secrets / log /
// now) will be plumbed per docs/PLATFORM-RESEARCH.md Rec §1;
// for Phase 1 it carries a single `version: i32` placeholder
// and handler code typically ignores it.
// Returns -errno when the listener can't be bound (e.g.
// EADDRINUSE); on success the loop runs indefinitely until
// the host kills the process (no clean-shutdown channel
// exposed yet).
//
// The loop is a reactor (#9853): one readiness set from the Driver seam
// (`async.real_driver()`: epoll, kqueue or wasi pollables) watches the
// listener and every open connection, so many slow clients are read
// side by side and a request is answered as soon as its bytes are in.
// Per-connection lifecycle:
//   1. accept when the listener is readable, switch the connection to
//      non-blocking and watch it for reads; its read deadline (default
//      10 s; `tcp_serve_deadline` / `ServeOptions.recv_deadline`) is the
//      slow-loris guard: a connection past it is closed without a
//      response, and the wait's timeout is the earliest one due.
//   2. when it is readable, tcp_recv_into one 4 KiB buffer until -EAGAIN,
//      appending to the connection's request bytes (headers must fit in
//      8 KiB, the body in 1 MiB, the parser's caps).
//   3. http_parse_request_bytes — return None ⇒ keep reading, or on EOF close
//      the socket without a response (HTTP/1.1 §10 explicitly allows
//      server-side reset on malformed input).
//   4. handler(req) returns the HttpResponse.
//   5. http_serialize_response → tcp_send; what the kernel does not take
//      stays with the connection, watched for writability until it
//      drains → unwatch → tcp_close.
//
// The native targets wire this through the Fern-bodied __fern_tcp_* and
// __fern_reactor_* helpers over the syscall floor. The wasm side gates
// tcp_* on wasi:sockets at module instantiation; CLI-mode programs that
// call tcp_serve need a host-pre-opened socket (`wasmtime run -S tcp=y`).
//
// `__port_from_env(name, fallback)` is the convenience helper
// the auto-`main`-from-`handle()` synthesis uses so handler-
// shaped programs can be tuned via `PORT=N ./bin` without a
// manual main().
//
// No prelude: these are in scope only after a program
// declares `import "std/tcp";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

import "std/async";
import "std/http";
import "std/time";
// core/int — int_to_string for the supervisor's worker-death log
// lines (the raw exit code, straight to stderr).
import "core/int";

// __recv_deadline_default() — default per-request read deadline for the
// serve loops (10 s): the whole request (headers + body) must arrive
// within this window or the connection is closed without a response.
// This is the slow-loris guard — without it one client trickling bytes
// pins the single-threaded accept loop forever. `tcp_serve_deadline`
// takes a caller-chosen value.
function __recv_deadline_default(): Duration {
    return time.duration_seconds(10 as i64);
}

pub function tcp_serve(port: i32, handler: (HttpRequest, Platform) => HttpResponse): i32 {
    return tcp_serve_opts(port, serve_options(), handler);
}

// ServeOptions — what a serve loop asks of its listener and of each
// connection: the accept queue depth, whether other listeners may share
// the port (`SO_REUSEPORT`, the kernel balancing accepted connections
// across them; ignored on wasm, where a port is one socket's), and the
// per-request read deadline `tcp_serve_deadline` describes.
pub struct ServeOptions {
    backlog: i32,
    reuse_port: boolean,
    recv_deadline: Duration,
}

// serve_options() — what `tcp_serve` uses: a backlog of 128, the port held
// by one listener, and the 10 s read deadline.
pub function serve_options(): ServeOptions {
    return ServeOptions { backlog: 128, reuse_port: false, recv_deadline: __recv_deadline_default() };
}

// tcp_serve_opts(port, opts, handler) — `tcp_serve` with the listener and
// the read deadline chosen by the caller.
pub function tcp_serve_opts(port: i32, opts: ServeOptions, handler: (HttpRequest, Platform) => HttpResponse): i32 {
    var listener: i32 = tcp_listen_with(__every_v4(), port, opts.backlog, opts.reuse_port);
    if (listener < 0) {
        return listener;
    }
    return __serve_loop(listener, handler, opts.recv_deadline);
}

// tcp_serve_deadline(port, handler, recv_deadline) — `tcp_serve`
// with an explicit per-request read deadline. A client that hasn't
// delivered a complete request within the window is disconnected
// without a response and the loop moves on.
pub function tcp_serve_deadline(port: i32, handler: (HttpRequest, Platform) => HttpResponse, recv_deadline: Duration): i32 {
    return tcp_serve_opts(port, ServeOptions { ...serve_options(), recv_deadline: recv_deadline }, handler);
}

// tcp_serve_with(port, init, handler) — serve with a caller-owned
// state value threaded through the request chain. `handler` takes the
// state alongside the request and returns the state the NEXT request
// will see, paired with the response to send:
//
//     function handle(hits: Map[string, i32], req: HttpRequest,
//                     plat: Platform): (Map[string, i32], HttpResponse) {
//         var n: i32 = hits.get_or(req.path, 0) + 1;
//         return (hits.insert(req.path, n),
//                 http.http_response_ok(int.int_to_string(n)));
//     }
//     var init: Map[string, i32] = map_new(8);
//     tcp.tcp_serve_with(8080, init, handle);
//
// `init` needs the annotated local when its value comes from a
// context-typed builtin like `map_new`: inline, `S` binds from the
// unsettled argument before the handler can pin it down.
//
// The state lives in the accept loop's own frame, which is what makes
// it process-lifetime: Fern has no module-level mutable state, and the
// one alternative — a closure-captured `Cell[T]` — is restricted to
// cycle-free scalars and strings (E057), so it holds a counter but not
// a table. Threading has no such limit: `S` is any type.
//
// Not available under `tcp_serve_supervised`: a worker death resets
// the loop frame, so threaded state would silently revert to `init` on
// every refork. State that must outlive a crash belongs in a store the
// handler reaches through `plat`.
pub function tcp_serve_with[S](port: i32, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse)): i32 {
    return tcp_serve_with_opts(port, serve_options(), init, handler);
}

// tcp_serve_with_opts(port, opts, init, handler) — `tcp_serve_with` with
// the listener and the read deadline chosen by the caller.
pub function tcp_serve_with_opts[S](port: i32, opts: ServeOptions, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse)): i32 {
    var listener: i32 = tcp_listen_with(__every_v4(), port, opts.backlog, opts.reuse_port);
    if (listener < 0) {
        return listener;
    }
    return __serve_loop_with(listener, init, handler, opts.recv_deadline);
}

// tcp_serve_with_deadline(port, init, handler, recv_deadline) —
// `tcp_serve_with` with an explicit per-request read deadline, the same
// slow-loris guard `tcp_serve_deadline` applies.
pub function tcp_serve_with_deadline[S](port: i32, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse), recv_deadline: Duration): i32 {
    return tcp_serve_with_opts(port, ServeOptions { ...serve_options(), recv_deadline: recv_deadline }, init, handler);
}

// tcp_recv_deadline(fd, max, deadline) — recv up to `max` bytes,
// waiting at most `deadline` for the socket to become readable.
// Returns `Some(chunk)` — the raw bytes, `u8[]`, empty at EOF — when the
// read completed in time, `None` when the deadline passed first. This is
// the recv-with-deadline primitive the serve loop and std/fetch's
// deadline variants are built on. Socket bytes are arbitrary, so they
// stay `u8[]` rather than `string` (D9, docs/STRINGS-SOTA.md).
//
// Portability: the wait is the same poll shape `async.with_deadline`
// uses — native poll(2) honors the millisecond timeout directly (the
// appended timer token is -1, ignored); wasm `poll` ignores its timeout
// argument, so a real timer pollable in the set fires at the deadline.
// On interp, `poll` is a stub that returns -1 IMMEDIATELY, which is
// distinguished from a native timeout (which only reports -1 after
// waiting the window out) by elapsed time: an instant -1 means
// readiness is unavailable here, and the call degrades to a plain
// blocking recv — preserving interp behavior at the cost of the
// deadline.
pub function tcp_recv_deadline(fd: i32, max: i32, deadline: Duration): Option[u8[]] {
    var wait_ms: i32 = deadline.as_millis() as i32;
    if (wait_ms < 1) { wait_ms = 1; }
    var ns_per_ms: i64 = 1000000;
    var start_ns: i64 = monotonic_ns();
    var tok: i32 = tcp_pollable(fd);
    var timer: i32 = wasm_timer_pollable((wait_ms as i64) * ns_per_ms);
    var pollset: i32[] = [tok, timer];
    var ready: i32 = poll(pollset, wait_ms);
    var dtimer: i32 = wasm_pollable_drop(timer);
    var dtok: i32 = wasm_pollable_drop(tok);
    if (ready == 0) {
        return Some(tcp_recv(fd, max));
    }
    if (ready == 1) {
        // The timer pollable fired first (wasm) — deadline.
        return None;
    }
    // ready < 0: a native poll(2) only reports this after the wait
    // elapsed (timeout); an instant -1 is the interp stub (or EINTR /
    // a poll error), where blocking recv preserves the old behavior.
    var waited_ns: i64 = monotonic_ns() - start_ns;
    if (waited_ns * 2i64 >= (wait_ms as i64) * ns_per_ms) {
        return None;
    }
    return Some(tcp_recv(fd, max));
}

// __eagain() — EAGAIN as this target numbers it: what a non-blocking read
// answers while nothing is queued. wasm's reads never block and use the
// same answer.
// 0.0.0.0: the serve loops listen on every IPv4 interface.
function __every_v4(): u8[] {
    return [0u8, 0u8, 0u8, 0u8];
}

function __eagain(): i32 {
    if (target_os() == "darwin") { return 35; }
    if (target_os() == "wasi") { return 6; }
    return 11;
}

// __recv_scratch() — the loop's one read buffer, filled per readable
// connection and copied out; owned by the loop, never by a request.
function __recv_scratch(): u8[] {
    var buf: u8[] = [];
    var i: i32 = 0;
    while (i < 4096) {
        buf = buf.append(0 as u8);
        i = i + 1;
    }
    return buf;
}

// __Conns — the open connections of a serve loop, by position: the
// descriptor, the request bytes read so far, the response bytes the
// kernel has not taken yet ("" while the request is being read), and the
// monotonic time its deadline falls due (the read deadline, then the
// same span again for the write).
struct __Conns { fds: i32[], bufs: u8[][], pending: string[], deadlines: i64[] }

function __conns_index(c: __Conns, fd: i32): i32 {
    var i: i32 = 0;
    while (i < c.fds.len()) {
        if (c.fds[i] == fd) { return i; }
        i = i + 1;
    }
    return -1;
}

function __conns_add(c: __Conns, fd: i32, deadline: i64): __Conns {
    var empty: u8[] = [];
    return __Conns { fds: c.fds.append(fd), bufs: c.bufs.append(empty), pending: c.pending.append(""), deadlines: c.deadlines.append(deadline) };
}

function __conns_remove(c: __Conns, at: i32): __Conns {
    var fds: i32[] = [];
    var bufs: u8[][] = [];
    var pending: string[] = [];
    var deadlines: i64[] = [];
    var i: i32 = 0;
    while (i < c.fds.len()) {
        if (i != at) {
            fds = fds.append(c.fds[i]);
            bufs = bufs.append(c.bufs[i]);
            pending = pending.append(c.pending[i]);
            deadlines = deadlines.append(c.deadlines[i]);
        }
        i = i + 1;
    }
    return __Conns { fds: fds, bufs: bufs, pending: pending, deadlines: deadlines };
}

// __conns_timeout(c, now) — the wait's timeout: the milliseconds until the
// earliest read deadline (0 once one is due), or -1 with nothing open.
function __conns_timeout(c: __Conns, now: i64): i32 {
    var best: i64 = -1 as i64;
    for d in c.deadlines {
        if (best < (0 as i64) || d < best) { best = d; }
    }
    if (best < (0 as i64)) { return -1; }
    if (best <= now) { return 0; }
    var ms: i64 = (best - now + (999999 as i64)) / 1000000;
    if (ms > (2147483647 as i64)) { return 2147483647; }
    return ms as i32;
}

// __serve_accept(drv, listener, c, deadline) — one accepted connection,
// non-blocking and watched for reads; a refused watch closes it again.
// wasm has no non-blocking mode to switch on and its reads never block.
function __serve_accept[D: async.Driver](drv: D, listener: i32, c: __Conns, recv_deadline: Duration): __Conns {
    var fd: i32 = tcp_accept(listener);
    if (fd < 0) { return c; }
    tcp_socket_ctl(fd, 3, 1);
    if (drv.watch(fd, 1) < 0) {
        tcp_close(fd);
        return c;
    }
    return __conns_add(c, fd, monotonic_ns() + recv_deadline.as_nanos());
}

// __serve_close(drv, c, at) — the connection at `at` unwatched, closed
// and forgotten.
function __serve_close[D: async.Driver](drv: D, c: __Conns, at: i32): __Conns {
    drv.unwatch(c.fds[at]);
    tcp_close(c.fds[at]);
    return __conns_remove(c, at);
}

// __serve_read(c, at, scratch) — the readable connection at `at` read
// until nothing is queued: `(conns, done, request)`, where `done` says
// the connection is finished (a complete request to answer, EOF, an
// error, or the size cap) and `request` is the complete request when
// there is one.
function __serve_read(c: __Conns, at: i32, scratch: u8[]): (__Conns, boolean, Option[HttpRequest]) {
    var buf: u8[] = c.bufs[at];
    while (true) {
        var n: i32 = tcp_recv_into(c.fds[at], scratch);
        if (n == 0 - __eagain()) {
            return (__Conns { ...c, bufs: c.bufs.with(at, buf) }, false, None);
        }
        if (n <= 0) {
            return (c, true, None);
        }
        buf = buf.concat(scratch.take(n));
        // Hard cap to keep slow / hostile clients from pinning
        // unbounded memory. Headers must fit in the first 8 KiB; body
        // capped at 1 MiB. Matches the parser's internal caps.
        if (buf.len() > 8192 + 1048576) {
            return (c, true, None);
        }
        match (http.http_parse_request_bytes(buf)) {
            Some(parsed) => { return (c, true, Some(parsed)); },
            None => {
                // Still partial, or definitively malformed: more bytes
                // decide, the deadline or the cap ends it.
            }
        }
    }
    return (c, true, None);
}

// __serve_send(drv, c, at, payload, deadline) — the response written to
// the connection at `at`: `(conns, done)`, done when the kernel took it
// all or refused it. A short write keeps the rest as the connection's
// pending bytes, watches it for writability instead of reads and gives
// it `deadline` to drain; the loop finishes the write on later waits.
function __serve_send[D: async.Driver](drv: D, c: __Conns, at: i32, payload: string, deadline: Duration): (__Conns, boolean) {
    var n: i32 = tcp_send(c.fds[at], payload);
    if (n >= payload.len()) { return (c, true); }
    if (n < 0 && n != 0 - __eagain()) { return (c, true); }
    var rest: string = payload;
    if (n > 0) { rest = slice_unchecked(payload, n, payload.len()).to_owned(); }
    drv.watch(c.fds[at], 2);
    return (__Conns { ...c, pending: c.pending.with(at, rest), deadlines: c.deadlines.with(at, monotonic_ns() + deadline.as_nanos()) }, false);
}

// __serve_expire(drv, c, now) — every connection whose deadline is due
// closed, without a response or with the rest of one unsent.
function __serve_expire[D: async.Driver](drv: D, c: __Conns, now: i64): __Conns {
    var i: i32 = 0;
    while (i < c.fds.len()) {
        if (c.deadlines[i] <= now) {
            c = __serve_close(drv, c, i);
        } else {
            i = i + 1;
        }
    }
    return c;
}

// __host_platform — the bag the accept loops hand every handler: the host
// mode, a sink nothing writes to, and the worker's reactor as its handle,
// 0 where the target has none, as a bag from `platform_new` carries.
// Recording is a MockPlatform's job; it builds a bag over its own cell
// (std/mock_platform). Built once per loop rather than per request, since
// no request can change it.
function __host_platform(reactor: i32): Platform {
    var handle: i32 = reactor;
    if (handle < 0) { handle = 0; }
    return Platform { version: 2, mode: 0, sink: cell_new(""), handle: handle };
}

// __serve_loop — the HTTP/1.1 reactor loop factored out of `tcp_serve`
// so `tcp_serve_supervised` can run the same loop against a listener fd
// it does NOT create: the supervising parent owns the listening socket
// (created before the first fork, inherited by every worker), so the
// kernel backlog — and any pending connections in it — survives a worker
// death. Loops forever under normal operation; the i32 return only
// materialises for the type system (no clean-shutdown channel exposed
// yet), except that a listener the reactor cannot watch returns its
// -errno like a failed bind. `recv_deadline` bounds each connection's
// request read (see `tcp_serve_deadline`).
function __serve_loop(listener: i32, handler: (HttpRequest, Platform) => HttpResponse, recv_deadline: Duration): i32 {
    var drv: async.RealDriver = async.real_driver();
    var watched: i32 = drv.watch(listener, 1);
    if (watched < 0) { return watched; }
    var plat: Platform = __host_platform(drv.handle());
    var conns: __Conns = __Conns { fds: [], bufs: [], pending: [], deadlines: [] };
    var scratch: u8[] = __recv_scratch();
    while (true) {
        var events: i32[] = drv.wait(64, __conns_timeout(conns, monotonic_ns()));
        var k: i32 = 0;
        while (k + 1 < events.len()) {
            var fd: i32 = events[k];
            k = k + 2;
            if (fd == listener) {
                conns = __serve_accept(drv, listener, conns, recv_deadline);
                continue;
            }
            var at: i32 = __conns_index(conns, fd);
            if (at < 0) { continue; }
            if (conns.pending[at].len() > 0) {
                var sent: (__Conns, boolean) = __serve_send(drv, conns, at, conns.pending[at], recv_deadline);
                conns = sent.0;
                if (sent.1) { conns = __serve_close(drv, conns, at); }
                continue;
            }
            var read: (__Conns, boolean, Option[HttpRequest]) = __serve_read(conns, at, scratch);
            conns = read.0;
            var done: boolean = read.1;
            match (read.2) {
                Some(req) => {
                    var resp: HttpResponse = handler(req, plat);
                    var sent: (__Conns, boolean) = __serve_send(drv, conns, at, http.http_serialize_response(resp), recv_deadline);
                    conns = sent.0;
                    done = sent.1;
                },
                None => {}
            }
            if (done) { conns = __serve_close(drv, conns, at); }
        }
        conns = __serve_expire(drv, conns, monotonic_ns());
    }
    // A bounded loop (the census fixtures) hands the listener back with
    // nothing watching it: on wasm a socket still subscribed cannot close.
    drv.unwatch(listener);
    drv.close();
    return 0;
}

// __serve_loop_with — `__serve_loop` threading a caller-owned state
// value through the handler chain. The state lives in the loop frame,
// so it is process-lifetime without any language-level global: each
// request sees the value the previous one returned.
function __serve_loop_with[S](listener: i32, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse), recv_deadline: Duration): i32 {
    var st: S = init;
    var drv: async.RealDriver = async.real_driver();
    var watched: i32 = drv.watch(listener, 1);
    if (watched < 0) { return watched; }
    var plat: Platform = __host_platform(drv.handle());
    var conns: __Conns = __Conns { fds: [], bufs: [], pending: [], deadlines: [] };
    var scratch: u8[] = __recv_scratch();
    while (true) {
        var events: i32[] = drv.wait(64, __conns_timeout(conns, monotonic_ns()));
        var k: i32 = 0;
        while (k + 1 < events.len()) {
            var fd: i32 = events[k];
            k = k + 2;
            if (fd == listener) {
                conns = __serve_accept(drv, listener, conns, recv_deadline);
                continue;
            }
            var at: i32 = __conns_index(conns, fd);
            if (at < 0) { continue; }
            if (conns.pending[at].len() > 0) {
                var sent: (__Conns, boolean) = __serve_send(drv, conns, at, conns.pending[at], recv_deadline);
                conns = sent.0;
                if (sent.1) { conns = __serve_close(drv, conns, at); }
                continue;
            }
            var read: (__Conns, boolean, Option[HttpRequest]) = __serve_read(conns, at, scratch);
            conns = read.0;
            var done: boolean = read.1;
            match (read.2) {
                Some(req) => {
                    var next: (S, HttpResponse) = handler(st, req, plat);
                    st = next.0;
                    var sent: (__Conns, boolean) = __serve_send(drv, conns, at, http.http_serialize_response(next.1), recv_deadline);
                    conns = sent.0;
                    done = sent.1;
                },
                None => {}
            }
            if (done) { conns = __serve_close(drv, conns, at); }
        }
        conns = __serve_expire(drv, conns, monotonic_ns());
    }
    // A bounded loop (the census fixtures) hands the listener back with
    // nothing watching it: on wasm a socket still subscribed cannot close.
    drv.unwatch(listener);
    drv.close();
    return 0;
}

// tcp_serve_supervised(port, handler) — crash-only supervised
// serving (docs/CRASH-ONLY-SERVE.md, plan item D2'). Same
// signature as `tcp_serve`, different failure scope: the accept
// loop runs in a forked WORKER process while the parent does
// nothing but supervise — `proc_waitpid` on the worker, log the
// death to stderr (the raw exit code: 134 = trap, 137 = arena
// exhaustion, 101 = todo, 1 = assert), and refork. A handler
// trap kills one worker's in-flight connections, not the
// service: the parent-owned listener keeps its backlog, and the
// next worker inherits the same fd. A refork also resets the
// worker heap, reclaiming the cycle-leak class RC cannot collect.
//
// Restart policy (TigerStyle — bounded everything):
//   - backoff 100ms doubling to a 5s cap between reforks;
//     a worker that lived >= 100ms resets the backoff.
//   - 8 CONSECUTIVE deaths within 100ms of spawn is a crash
//     loop (the handler traps on startup / first request):
//     give up and return the last worker's exit code — an
//     operator problem, not a retry problem.
//
// Where fork doesn't exist, degrade instead of failing:
// `proc_fork() == -38` (ENOSYS — the interpreter's Go runtime
// is threaded and cannot bare-fork; ditto any future fork-less
// target) logs one line and serves single-process via the same
// accept loop, so the function stays runnable under `-interp`.
// Other fork/waitpid failures (-errno) return the errno like
// `tcp_serve` returns a failed bind.
pub function tcp_serve_supervised(port: i32, handler: (HttpRequest, Platform) => HttpResponse): i32 {
    // Listener FIRST, in the parent — the whole design hinges on
    // workers inheriting this fd rather than owning it.
    var opts: ServeOptions = serve_options();
    var listener: i32 = tcp_listen_with(__every_v4(), port, opts.backlog, opts.reuse_port);
    if (listener < 0) {
        return listener;
    }
    var backoff_ms: i64 = 100 as i64;
    var fast_deaths: i32 = 0;
    while (true) {
        var spawned_at: i64 = now_unix_ms();
        var pid: i32 = proc_fork();
        if (pid == -38) {
            // ENOSYS: no fork on this host. Graceful degradation.
            eprint("tcp_serve_supervised: supervision unavailable; serving single-process");
            return __serve_loop(listener, handler, __recv_deadline_default());
        }
        if (pid < 0) {
            return pid;
        }
        if (pid == 0) {
            // Worker child: run the accept loop against the
            // inherited listener. It never returns under normal
            // operation; if it somehow does, exit with its code
            // rather than falling into a second supervision loop.
            var rc: i32 = __serve_loop(listener, handler, __recv_deadline_default());
            exit(rc);
            return rc;
        }
        // Parent: supervise.
        var code: i32 = proc_waitpid(pid);
        if (code < 0) {
            return code;
        }
        eprint("tcp_serve_supervised: worker died with exit code " + int.int_to_string(code) + "; restarting");
        var lived_ms: i64 = now_unix_ms() - spawned_at;
        if (lived_ms < (100 as i64)) {
            fast_deaths = fast_deaths + 1;
            if (fast_deaths >= 8) {
                eprint("tcp_serve_supervised: giving up after 8 consecutive fast worker deaths");
                return code;
            }
        } else {
            fast_deaths = 0;
            backoff_ms = 100 as i64;
        }
        sleep_ms(backoff_ms);
        backoff_ms = backoff_ms * (2 as i64);
        if (backoff_ms > (5000 as i64)) {
            backoff_ms = 5000 as i64;
        }
    }
    return 0;
}

// Pull a port number out of an env var. Returns the parsed
// integer on success, -1 on missing / malformed / out-of-
// range. Used by the auto-`main()`-from-`handle()` synthesis
// so handler-shaped programs can be tuned via `PORT=N ./bin`
// without writing a manual main().
//
// Inline i32-only digit accumulation rather than std/string's
// `s.parse_int()` (which uses i64 for overflow safety and would
// pull that module in just for a port number). The result is
// bounded to a valid TCP port (0..65535), so i32 suffices.
function __port_from_env(name: string, fallback: i32): i32 {
    match (env(name)) {
        Some(s) => {
            var n: i32 = 0;
            var i: i32 = 0;
            while (i < s.len()) {
                var b: i32 = s[i] as i32;
                if (b < 48 || b > 57) { return fallback; }
                n = n * 10 + (b - 48);
                if (n > 65535) { return fallback; }
                i = i + 1;
            }
            if (i == 0) { return fallback; }
            return n;
        },
        None => {
            return fallback;
        }
    }
}
