// std/tcp — HTTP/1.1 accept loop + handler-friendly env helper.
//
// `tcp_serve(port, handler)` runs an HTTP/1.1 accept loop on
// `port`, calling `handler(req, plat)` once per accepted
// connection. The `plat: Platform` capability bag is the seam
// where future host-side effects (fetch / kv / secrets / log /
// now) will be plumbed per docs/PLATFORM-RESEARCH.md Rec §1;
// for Phase 1 it carries a single `version: i32` placeholder
// and handler code typically ignores it.
// Returns -errno when the listener can't be bound (e.g.
// EADDRINUSE); on success the loop runs indefinitely until
// the host kills the process (no clean-shutdown channel
// exposed yet).
//
// Per-connection lifecycle:
//   1. tcp_recv up to 8192 bytes (matches http_parse_request's
//      header-size cap) plus body bytes via a follow-up recv
//      loop driven by Content-Length — the whole read bounded
//      by a per-request deadline (default 10 s; see
//      `tcp_serve_deadline` / `tcp_recv_deadline`) so a
//      slow-loris client can't pin the accept loop.
//   2. http_parse_request — return None ⇒ close the socket
//      without a response (HTTP/1.1 §10 explicitly allows
//      server-side reset on malformed input).
//   3. handler(req) returns the HttpResponse.
//   4. http_serialize_response → tcp_send → tcp_close.
//
// arm64 wires this through real Linux sockets via the
// existing __fern_tcp_* syscall helpers. The wasm side gates
// tcp_* on wasi:sockets at module instantiation; CLI-mode
// programs that call tcp_serve need a host-pre-opened socket
// (`wasmtime run -S tcp=y`).
//
// `__port_from_env(name, fallback)` is the convenience helper
// the auto-`main`-from-`handle()` synthesis uses so handler-
// shaped programs can be tuned via `PORT=N ./bin` without a
// manual main().
//
// No prelude: these are in scope only after a program
// declares `import "std/tcp";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

import "std/http";
// core/int — int_to_string for the supervisor's worker-death log
// lines (the raw exit code, straight to stderr).
import "core/int";

// __recv_deadline_default() — default per-request read deadline for the
// serve loops (10 s): the whole request (headers + body) must arrive
// within this window or the connection is closed without a response.
// This is the slow-loris guard — without it one client trickling bytes
// pins the single-threaded accept loop forever. `tcp_serve_deadline`
// takes a caller-chosen value.
function __recv_deadline_default(): i32 {
    return 10000;
}

pub function tcp_serve(port: i32, handler: (HttpRequest, Platform) => HttpResponse): i32 {
    return tcp_serve_deadline(port, handler, __recv_deadline_default());
}

// tcp_serve_deadline(port, handler, recv_deadline_ms) — `tcp_serve`
// with an explicit per-request read deadline (milliseconds). A client
// that hasn't delivered a complete request within the window is
// disconnected without a response and the loop moves on.
pub function tcp_serve_deadline(port: i32, handler: (HttpRequest, Platform) => HttpResponse, recv_deadline_ms: i32): i32 {
    var listener: i32 = tcp_listen(port);
    if (listener < 0) {
        return listener;
    }
    return __serve_loop(listener, handler, recv_deadline_ms);
}

// tcp_serve_with(port, init, handler) — serve with a caller-owned
// state value threaded through the request chain. `handler` takes the
// state alongside the request and returns the state the NEXT request
// will see, paired with the response to send:
//
//     function handle(hits: Map[string, i32], req: HttpRequest,
//                     plat: Platform): (Map[string, i32], HttpResponse) {
//         var n: i32 = hits.get_or(req.path, 0) + 1;
//         return (hits.insert(req.path, n),
//                 http.http_response_ok(int.int_to_string(n)));
//     }
//     var init: Map[string, i32] = map_new(8);
//     tcp.tcp_serve_with(8080, init, handle);
//
// `init` needs the annotated local when its value comes from a
// context-typed builtin like `map_new`: inline, `S` binds from the
// unsettled argument before the handler can pin it down.
//
// The state lives in the accept loop's own frame, which is what makes
// it process-lifetime: Fern has no module-level mutable state, and the
// one alternative — a closure-captured `Cell[T]` — is restricted to
// cycle-free scalars and strings (E057), so it holds a counter but not
// a table. Threading has no such limit: `S` is any type.
//
// Not available under `tcp_serve_supervised`: a worker death resets
// the loop frame, so threaded state would silently revert to `init` on
// every refork. State that must outlive a crash belongs in a store the
// handler reaches through `plat`.
pub function tcp_serve_with[S](port: i32, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse)): i32 {
    return tcp_serve_with_deadline(port, init, handler, __recv_deadline_default());
}

// tcp_serve_with_deadline(port, init, handler, recv_deadline_ms) —
// `tcp_serve_with` with an explicit per-request read deadline, the same
// slow-loris guard `tcp_serve_deadline` applies.
pub function tcp_serve_with_deadline[S](port: i32, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse), recv_deadline_ms: i32): i32 {
    var listener: i32 = tcp_listen(port);
    if (listener < 0) {
        return listener;
    }
    return __serve_loop_with(listener, init, handler, recv_deadline_ms);
}

// tcp_recv_deadline(fd, max, deadline_ms) — recv up to `max` bytes,
// waiting at most `deadline_ms` for the socket to become readable.
// Returns `Some(chunk)` — the raw bytes, `u8[]`, empty at EOF — when the
// read completed in time, `None` when the deadline passed first. This is
// the recv-with-deadline primitive the serve loop and std/fetch's
// deadline variants are built on. Socket bytes are arbitrary, so they
// stay `u8[]` rather than `string` (D9, docs/STRINGS-SOTA.md).
//
// Portability: the wait is the same poll shape `async.with_deadline`
// uses — native poll(2) honors the millisecond timeout directly (the
// appended timer token is -1, ignored); wasm `poll` ignores its timeout
// argument, so a real timer pollable in the set fires at the deadline.
// On interp, `poll` is a stub that returns -1 IMMEDIATELY, which is
// distinguished from a native timeout (which only reports -1 after
// waiting the window out) by elapsed time: an instant -1 means
// readiness is unavailable here, and the call degrades to a plain
// blocking recv — preserving interp behavior at the cost of the
// deadline.
pub function tcp_recv_deadline(fd: i32, max: i32, deadline_ms: i32): Option[u8[]] {
    var wait_ms: i32 = deadline_ms;
    if (wait_ms < 1) { wait_ms = 1; }
    var ns_per_ms: i64 = 1000000;
    var start_ns: i64 = monotonic_ns();
    var tok: i32 = tcp_pollable(fd);
    var timer: i32 = wasm_timer_pollable((wait_ms as i64) * ns_per_ms);
    var pollset: i32[] = [tok, timer];
    var ready: i32 = poll(pollset, wait_ms);
    var dtimer: i32 = wasm_pollable_drop(timer);
    var dtok: i32 = wasm_pollable_drop(tok);
    if (ready == 0) {
        return Some(tcp_recv(fd, max));
    }
    if (ready == 1) {
        // The timer pollable fired first (wasm) — deadline.
        return None;
    }
    // ready < 0: a native poll(2) only reports this after the wait
    // elapsed (timeout); an instant -1 is the interp stub (or EINTR /
    // a poll error), where blocking recv preserves the old behavior.
    var waited_ns: i64 = monotonic_ns() - start_ns;
    if (waited_ns * 2 >= (wait_ms as i64) * ns_per_ms) {
        return None;
    }
    return Some(tcp_recv(fd, max));
}

// __read_request(fd, recv_deadline_ms) — drain one connection up to the
// first parse-success. `None` means no complete request arrived (EOF,
// the read deadline elapsed, or the size cap was hit); the caller closes
// the socket without a response, which HTTP/1.1 §10 allows on malformed
// input.
//
// Per-request allocations (recv buffers, the parsed HttpRequest) are
// reclaimed by reference counting as their last references drop at the
// end of the caller's iteration. Note: RC cannot collect reference
// cycles, so a handler that builds a cycle per request leaks until
// process exit (see docs/CYCLE-COLLECTION-ANALYSIS.md).
function __read_request(fd: i32, recv_deadline_ms: i32): Option[HttpRequest] {
    var buf: string = "";
    var read_start_ns: i64 = monotonic_ns();
    var deadline_ns: i64 = (recv_deadline_ms as i64) * 1000000;
    while (true) {
        // Per-request read deadline (slow-loris guard): the whole
        // request must arrive within `recv_deadline_ms` or the
        // connection is dropped without a response.
        var remaining_ms: i32 = ((deadline_ns - (monotonic_ns() - read_start_ns)) / 1000000) as i32;
        if (remaining_ms <= 0) {
            return None;
        }
        var chunk: u8[] = [];
        var timed_out: boolean = false;
        match (tcp_recv_deadline(fd, 4096, remaining_ms)) {
            Some(c) => { chunk = c; },
            None => { timed_out = true; },
        }
        if (timed_out) {
            return None;
        }
        if (chunk.len() == 0) {
            // EOF before request complete.
            return None;
        }
        // The one remaining wire-bytes-to-string bridge: the request
        // buffer is text-typed only because `http_parse_request` and
        // `HttpRequest.body` still are. Bridging per CHUNK rather than
        // per parse attempt keeps the accumulation a single memcpy of
        // the growing buffer, as it was when tcp_recv returned a
        // string. Retired when the HTTP message layer goes byte-based
        // (#5714).
        buf = buf + string_from_bytes_unchecked(chunk);
        // Hard cap to keep slow / hostile clients from pinning
        // unbounded memory. Headers must fit in the first 8 KiB; body
        // capped at 1 MiB. Matches http_parse_request's internal caps.
        if (buf.len() > 8192 + 1048576) {
            return None;
        }
        match (http.http_parse_request(buf)) {
            Some(parsed) => {
                return Some(parsed);
            },
            None => {
                // Either still partial — keep recv'ing — or
                // definitively malformed. In either case the next
                // iteration recv's more bytes; the cap above is what
                // ends a request that never completes.
            }
        }
    }
    return None;
}

// __host_platform — the bag the accept loops hand every handler: the host
// mode, and a sink nothing writes to. Recording is a MockPlatform's job; it
// builds a bag over its own cell (std/mock_platform). Built once per loop
// rather than per request, since no request can change it.
function __host_platform(): Platform {
    return Platform { version: 1, mode: 0, sink: cell_new("") };
}

// __serve_loop — the HTTP/1.1 accept loop factored out of
// `tcp_serve` so `tcp_serve_supervised` can run the same loop
// against a listener fd it does NOT create: the supervising
// parent owns the listening socket (created before the first
// fork, inherited by every worker), so the kernel backlog —
// and any pending connections in it — survives a worker death.
// Loops forever under normal operation; the i32 return only
// materialises for the type system (no clean-shutdown channel
// exposed yet). `recv_deadline_ms` bounds each connection's
// request read (see `tcp_serve_deadline`).
function __serve_loop(listener: i32, handler: (HttpRequest, Platform) => HttpResponse, recv_deadline_ms: i32): i32 {
    var plat: Platform = __host_platform();
    while (true) {
        var fd: i32 = tcp_accept(listener);
        if (fd < 0) {
            // Transient accept failure (EINTR-style) — keep
            // looping. Permanent failures (listener closed by
            // the kernel, FD exhaustion) will repeat the same
            // -errno on every iteration; that's operator-
            // action territory and the lang-side response is
            // the same as success here.
            continue;
        }
        match (__read_request(fd, recv_deadline_ms)) {
            Some(req) => {
                var resp: HttpResponse = handler(req, plat);
                tcp_send(fd, http.http_serialize_response(resp));
            },
            None => {}
        }
        tcp_close(fd);
    }
    return 0;
}

// __serve_loop_with — `__serve_loop` threading a caller-owned state
// value through the handler chain. The state lives in the loop frame,
// so it is process-lifetime without any language-level global: each
// request sees the value the previous one returned.
function __serve_loop_with[S](listener: i32, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse), recv_deadline_ms: i32): i32 {
    var st: S = init;
    var plat: Platform = __host_platform();
    while (true) {
        var fd: i32 = tcp_accept(listener);
        if (fd < 0) {
            continue;
        }
        match (__read_request(fd, recv_deadline_ms)) {
            Some(req) => {
                var next: (S, HttpResponse) = handler(st, req, plat);
                st = next.0;
                tcp_send(fd, http.http_serialize_response(next.1));
            },
            None => {}
        }
        tcp_close(fd);
    }
    return 0;
}

// tcp_serve_supervised(port, handler) — crash-only supervised
// serving (docs/CRASH-ONLY-SERVE.md, plan item D2'). Same
// signature as `tcp_serve`, different blast radius: the accept
// loop runs in a forked WORKER process while the parent does
// nothing but supervise — `proc_waitpid` on the worker, log the
// death to stderr (the raw exit code: 134 = trap, 137 = arena
// exhaustion, 101 = todo, 1 = assert), and refork. A handler
// trap kills one worker's in-flight connections, not the
// service: the parent-owned listener keeps its backlog, and the
// next worker inherits the same fd. A refork also resets the
// worker heap, reclaiming the cycle-leak class RC cannot collect.
//
// Restart policy (TigerStyle — bounded everything):
//   - backoff 100ms doubling to a 5s cap between reforks;
//     a worker that lived >= 100ms resets the backoff.
//   - 8 CONSECUTIVE deaths within 100ms of spawn is a crash
//     loop (the handler traps on startup / first request):
//     give up and return the last worker's exit code — an
//     operator problem, not a retry problem.
//
// Where fork doesn't exist, degrade instead of failing:
// `proc_fork() == -38` (ENOSYS — the interpreter's Go runtime
// is threaded and cannot bare-fork; ditto any future fork-less
// target) logs one line and serves single-process via the same
// accept loop, so the function stays runnable under `-interp`.
// Other fork/waitpid failures (-errno) return the errno like
// `tcp_serve` returns a failed bind.
pub function tcp_serve_supervised(port: i32, handler: (HttpRequest, Platform) => HttpResponse): i32 {
    // Listener FIRST, in the parent — the whole design hinges on
    // workers inheriting this fd rather than owning it.
    var listener: i32 = tcp_listen(port);
    if (listener < 0) {
        return listener;
    }
    var backoff_ms: i64 = 100 as i64;
    var fast_deaths: i32 = 0;
    while (true) {
        var spawned_at: i64 = now_unix_ms();
        var pid: i32 = proc_fork();
        if (pid == -38) {
            // ENOSYS: no fork on this host. Graceful degradation.
            eprint("tcp_serve_supervised: supervision unavailable; serving single-process");
            return __serve_loop(listener, handler, __recv_deadline_default());
        }
        if (pid < 0) {
            return pid;
        }
        if (pid == 0) {
            // Worker child: run the accept loop against the
            // inherited listener. It never returns under normal
            // operation; if it somehow does, exit with its code
            // rather than falling into a second supervision loop.
            var rc: i32 = __serve_loop(listener, handler, __recv_deadline_default());
            exit(rc);
            return rc;
        }
        // Parent: supervise.
        var code: i32 = proc_waitpid(pid);
        if (code < 0) {
            return code;
        }
        eprint("tcp_serve_supervised: worker died with exit code " + int.int_to_string(code) + "; restarting");
        var lived_ms: i64 = now_unix_ms() - spawned_at;
        if (lived_ms < (100 as i64)) {
            fast_deaths = fast_deaths + 1;
            if (fast_deaths >= 8) {
                eprint("tcp_serve_supervised: giving up after 8 consecutive fast worker deaths");
                return code;
            }
        } else {
            fast_deaths = 0;
            backoff_ms = 100 as i64;
        }
        sleep_ms(backoff_ms);
        backoff_ms = backoff_ms * (2 as i64);
        if (backoff_ms > (5000 as i64)) {
            backoff_ms = 5000 as i64;
        }
    }
    return 0;
}

// Pull a port number out of an env var. Returns the parsed
// integer on success, -1 on missing / malformed / out-of-
// range. Used by the auto-`main()`-from-`handle()` synthesis
// so handler-shaped programs can be tuned via `PORT=N ./bin`
// without writing a manual main().
//
// Inline i32-only digit accumulation rather than std/string's
// `s.parse_int()` (which uses i64 for overflow safety and would
// pull that module in just for a port number). The result is
// bounded to a valid TCP port (0..65535), so i32 suffices.
function __port_from_env(name: string, fallback: i32): i32 {
    match (env(name)) {
        Some(s) => {
            var n: i32 = 0;
            var i: i32 = 0;
            while (i < s.len()) {
                var b: i32 = s[i] as i32;
                if (b < 48 || b > 57) { return fallback; }
                n = n * 10 + (b - 48);
                if (n > 65535) { return fallback; }
                i = i + 1;
            }
            if (i == 0) { return fallback; }
            return n;
        },
        None => {
            return fallback;
        }
    }
}
