// std/tcp — HTTP/1.1 accept loop + handler-friendly env helper.
//
// `tcp_serve(port, handler)` runs an HTTP/1.1 accept loop on
// `port`, calling `handler(req, plat)` once per request. The
// `plat: Platform` capability bag is the seam
// where future host-side effects (fetch / kv / secrets / log /
// now) will be plumbed per docs/PLATFORM-RESEARCH.md Rec §1;
// for Phase 1 it carries a single `version: i32` placeholder
// and handler code typically ignores it.
// Returns -errno when the listener can't be bound (e.g.
// EADDRINUSE); on success the loop runs indefinitely until
// the host kills the process (no clean-shutdown channel
// exposed yet).
//
// The loop is a reactor (#9853): one readiness set from the Driver seam
// (`async.real_driver()`: epoll, kqueue or wasi pollables) watches the
// listener and every open connection, so many slow clients are read
// side by side and a request is answered as soon as its bytes are in.
// Per-connection lifecycle:
//   1. accept when the listener is readable, switch the connection to
//      non-blocking and watch it for reads; its read deadline (default
//      10 s; `tcp_serve_deadline` / `ServeOptions.recv_deadline`) is the
//      slow-loris guard: a connection past it is closed without a
//      response, and the wait's timeout is the earliest one due. Once
//      the header block is in, the body extends the deadline by what it
//      has delivered: after a grace (5 s) it may take as long as its
//      bytes buy at the minimum rate (240 bytes per second), so a large
//      upload that keeps flowing outlasts the deadline and a trickle
//      does not. At `max_connections` open the listener is left
//      unwatched, so further connections wait in the accept queue until
//      one closes.
//   2. when it is readable, tcp_recv_into one 4 KiB buffer until -EAGAIN,
//      appending to the connection's request bytes (at most the parser's
//      header and body caps unread).
//   3. http_parse_request_framed — Incomplete ⇒ keep reading (on EOF, close);
//      Continue ⇒ send `100 Continue` once (RFC 9110 §10.1.1) and keep
//      reading; Malformed(status) ⇒ answer with that status (400, 413,
//      414, 417, 431 or 501), an empty body and `Connection: close`, then close; a
//      malformed request behind an answered one gets no answer, since
//      that answer already said close (RFC 9112 §9.6).
//   4. handler(req) returns the HttpResponse.
//   5. http_serialize_response_to → tcp_send, with a `Date` the loop
//      formats once per second (RFC 9110 §6.6.1) unless the handler set
//      one, and no body on a response to HEAD or a 1xx, 204 or 304;
//      what the kernel does not take stays with the connection, watched
//      for writability until it drains.
//   6. a connection persists across requests (RFC 9112 §9.3: HTTP/1.1
//      unless `Connection: close`, HTTP/1.0 only with `Connection:
//      keep-alive`) until the keep-alive idle span passes with no request
//      or it has answered `keep_alive_requests`; the request's bytes are
//      dropped from its buffer, so requests pipelined behind them are
//      answered from the same readable event → unwatch → tcp_close.
//   7. SIGTERM, a readiness event on the reactor, starts the shutdown:
//      the loop keeps accepting for `shutdown_grace` (whoever routes to
//      it removes it in parallel), answers 503 on `readiness_path`,
//      then closes the listener, stops keep-alive (every response says
//      close), closes the connections with nothing in flight, and gives
//      the rest `drain_deadline` from the signal to finish before
//      closing them too; it returns 0 once every connection is gone,
//      1 when it cut one off. A listener the process was started with
//      (`LISTEN_FDS`, descriptor 3) is served instead of a fresh one.
//
// The native targets wire this through the Fern-bodied __fern_tcp_* and
// __fern_reactor_* helpers over the syscall floor. The wasm side gates
// tcp_* on wasi:sockets at module instantiation; CLI-mode programs that
// call tcp_serve need a host-pre-opened socket (`wasmtime run -S tcp=y`).
//
// `__port_from_env(name, fallback)` is the convenience helper
// the auto-`main`-from-`handle()` synthesis uses so handler-
// shaped programs can be tuned via `PORT=N ./bin` without a
// manual main().
//
// No prelude: these are in scope only after a program
// declares `import "std/tcp";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

import "std/async";
import "std/http";
import "std/time";
// core/int — int_to_string for the supervisor's worker-death log
// lines (the raw exit code, straight to stderr).
import "core/int";

// __recv_deadline_default() — default per-request read deadline for the
// serve loops (10 s): the whole request (headers + body) must arrive
// within this window or the connection is closed without a response.
// This is the slow-loris guard — without it one client trickling bytes
// pins the single-threaded accept loop forever. `tcp_serve_deadline`
// takes a caller-chosen value.
function __recv_deadline_default(): Duration {
    return time.duration_seconds(10 as i64);
}

pub function tcp_serve(port: i32, handler: (HttpRequest, Platform) => HttpResponse): i32 {
    return tcp_serve_opts(port, serve_options(), handler);
}

// ServeOptions — what a serve loop asks of its listener and of each
// connection: the accept queue depth, whether other listeners may share
// the port (`SO_REUSEPORT`, the kernel balancing accepted connections
// across them; ignored on wasm, where a port is one socket's), the
// per-request read deadline `tcp_serve_deadline` describes, the least
// rate at which a request body must keep arriving once its header block
// is in and a response must be drained at (bytes per second, judged
// after the grace: the body may take as long as its bytes buy at that
// rate, beyond the read deadline, and a response being drained as long
// as the bytes the peer has taken buy), how
// long an idle persistent connection is kept waiting for its next
// request, how many requests one connection may carry before its
// response says `Connection: close`, how many connections the loop
// holds open at once (past it, the listener is not read and connections
// wait in its accept queue until one closes), how many of them one
// client may hold (by the peer's address key, `net.peer_key`, counted by
// this loop alone; a connection past it is closed as it is accepted; 0
// for no cap), how many workers
// `tcp_serve_supervised_opts` forks, each running its own loop over the
// one listener (below 1: one per processing unit the process may use,
// what `cpu_count()` answers), and the shutdown a
// SIGTERM starts (`__serve_stopping`): how long the loop keeps accepting
// after the signal, since whoever routes to it removes it in parallel,
// the path it answers 503 from the signal on (a readiness probe; "" for
// none), and how long the requests in flight get to finish once the
// listener is closed before the loop gives up on them.
pub struct ServeOptions {
    backlog: i32,
    reuse_port: boolean,
    recv_deadline: Duration,
    min_data_rate: i32,
    data_rate_grace: Duration,
    keep_alive_idle: Duration,
    keep_alive_requests: i32,
    max_connections: i32,
    max_connections_per_ip: i32,
    workers: i32,
    shutdown_grace: Duration,
    readiness_path: string,
    drain_deadline: Duration,
}

// serve_options() — what `tcp_serve` uses: a backlog of 128, the port held
// by one listener, the 10 s read deadline, a 130 s keep-alive idle span,
// 1000 requests per connection, 1024 connections open and 100 of them per
// client, and a worker per processing unit.
pub function serve_options(): ServeOptions {
    return ServeOptions { backlog: 128, reuse_port: false, recv_deadline: __recv_deadline_default(), min_data_rate: 240, data_rate_grace: time.duration_seconds(5 as i64), keep_alive_idle: time.duration_seconds(130 as i64), keep_alive_requests: 1000, max_connections: 1024, max_connections_per_ip: 100, workers: 0, shutdown_grace: time.duration_seconds(2 as i64), readiness_path: "", drain_deadline: time.duration_seconds(30 as i64) };
}

// tcp_serve_opts(port, opts, handler) — `tcp_serve` with the listener and
// the read deadline chosen by the caller.
pub function tcp_serve_opts(port: i32, opts: ServeOptions, handler: (HttpRequest, Platform) => HttpResponse): i32 {
    return tcp_serve_shutdown(port, opts, handler, (reason: string): void => {});
}

// tcp_serve_shutdown(port, opts, handler, shutdown) — `tcp_serve_opts`
// with a hook the loop calls once it has stopped, before returning: with
// "sigterm" when every request in flight was answered after SIGTERM, or
// "drain-deadline" when one was cut off at the drain deadline.
pub function tcp_serve_shutdown(port: i32, opts: ServeOptions, handler: (HttpRequest, Platform) => HttpResponse, shutdown: (string) => void): i32 {
    var listener: i32 = __serve_listener(port, opts);
    if (listener < 0) {
        return listener;
    }
    return __serve_loop(listener, handler, opts, shutdown);
}

// __serve_listener(port, opts) — the listener a serve loop runs over: the
// one the process was started with when `LISTEN_FDS` says it has one
// (descriptor 3, the systemd convention, which is also how a restarted
// server takes over a socket without a gap), else a fresh one on `port`.
function __serve_listener(port: i32, opts: ServeOptions): i32 {
    var listener: i32 = __listener_of(port, opts);
    // Non-blocking: a wake-up over a listener workers share can reach
    // more than one of them, and the one that finds nothing to accept
    // must return to its wait rather than block in accept until the next
    // connection, deaf to SIGTERM.
    if (listener >= 0) { tcp_socket_ctl(listener, 3, 1); }
    return listener;
}

// __listener_of(port, opts) — the listener handed in through LISTEN_FDS,
// or a fresh one on `port`.
function __listener_of(port: i32, opts: ServeOptions): i32 {
    match (env("LISTEN_FDS")) {
        Some(n) => {
            match (int.parse_int_radix(n, 10)) {
                Some(count) => { if (count >= 1) { return 3; } },
                None => { }
            }
        },
        None => { }
    }
    return tcp_listen_with(__every_v4(), port, opts.backlog, opts.reuse_port);
}

// tcp_serve_deadline(port, handler, recv_deadline) — `tcp_serve`
// with an explicit per-request read deadline. A client that hasn't
// delivered a complete request within the window is disconnected
// without a response and the loop moves on.
pub function tcp_serve_deadline(port: i32, handler: (HttpRequest, Platform) => HttpResponse, recv_deadline: Duration): i32 {
    return tcp_serve_opts(port, ServeOptions { ...serve_options(), recv_deadline: recv_deadline }, handler);
}

// tcp_serve_with(port, init, handler) — serve with a caller-owned
// state value threaded through the request chain. `handler` takes the
// state alongside the request and returns the state the NEXT request
// will see, paired with the response to send:
//
//     function handle(hits: Map[string, i32], req: HttpRequest,
//                     plat: Platform): (Map[string, i32], HttpResponse) {
//         var n: i32 = hits.get_or(req.path, 0) + 1;
//         return (hits.insert(req.path, n),
//                 http.http_response_ok(int.int_to_string(n)));
//     }
//     var init: Map[string, i32] = map_new(8);
//     tcp.tcp_serve_with(8080, init, handle);
//
// `init` needs the annotated local when its value comes from a
// context-typed builtin like `map_new`: inline, `S` binds from the
// unsettled argument before the handler can pin it down.
//
// The state lives in the accept loop's own frame, which is what makes
// it process-lifetime: Fern has no module-level mutable state, and the
// one alternative — a closure-captured `Cell[T]` — is restricted to
// cycle-free scalars and strings (E057), so it holds a counter but not
// a table. Threading has no such limit: `S` is any type.
//
// Not available under `tcp_serve_supervised`: a worker death resets
// the loop frame, so threaded state would silently revert to `init` on
// every refork. State that must outlive a crash belongs in a store the
// handler reaches through `plat`.
pub function tcp_serve_with[S](port: i32, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse)): i32 {
    return tcp_serve_with_opts(port, serve_options(), init, handler);
}

// tcp_serve_with_opts(port, opts, init, handler) — `tcp_serve_with` with
// the listener and the read deadline chosen by the caller.
pub function tcp_serve_with_opts[S](port: i32, opts: ServeOptions, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse)): i32 {
    return tcp_serve_with_shutdown(port, opts, init, handler, (reason: string, state: S): void => {});
}

// tcp_serve_with_shutdown(port, opts, init, handler, shutdown) —
// `tcp_serve_with_opts` with a hook the loop calls once it has stopped,
// before returning, with the reason `tcp_serve_shutdown` gives and the
// state as the last request left it: where a counter is flushed or a
// store is closed.
pub function tcp_serve_with_shutdown[S](port: i32, opts: ServeOptions, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse), shutdown: (string, S) => void): i32 {
    var listener: i32 = __serve_listener(port, opts);
    if (listener < 0) {
        return listener;
    }
    return __serve_loop_with(listener, init, handler, opts, shutdown);
}

// tcp_serve_with_deadline(port, init, handler, recv_deadline) —
// `tcp_serve_with` with an explicit per-request read deadline, the same
// slow-loris guard `tcp_serve_deadline` applies.
pub function tcp_serve_with_deadline[S](port: i32, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse), recv_deadline: Duration): i32 {
    return tcp_serve_with_opts(port, ServeOptions { ...serve_options(), recv_deadline: recv_deadline }, init, handler);
}

// tcp_recv_deadline(fd, max, deadline) — recv up to `max` bytes,
// waiting at most `deadline` for the socket to become readable.
// Returns `Some(chunk)` — the raw bytes, `u8[]`, empty at EOF — when the
// read completed in time, `None` when the deadline passed first. This is
// the recv-with-deadline primitive the serve loop and std/fetch's
// deadline variants are built on. Socket bytes are arbitrary, so they
// stay `u8[]` rather than `string` (D9, docs/STRINGS-SOTA.md).
//
// Portability: the wait is the same poll shape `async.with_deadline`
// uses — native poll(2) honors the millisecond timeout directly (the
// appended timer token is -1, ignored); wasm `poll` ignores its timeout
// argument, so a real timer pollable in the set fires at the deadline.
// On interp, `poll` is a stub that returns -1 IMMEDIATELY, which is
// distinguished from a native timeout (which only reports -1 after
// waiting the window out) by elapsed time: an instant -1 means
// readiness is unavailable here, and the call degrades to a plain
// blocking recv — preserving interp behavior at the cost of the
// deadline.
pub function tcp_recv_deadline(fd: i32, max: i32, deadline: Duration): Option[u8[]] {
    var wait_ms: i32 = deadline.as_millis() as i32;
    if (wait_ms < 1) { wait_ms = 1; }
    var ns_per_ms: i64 = 1000000;
    var start_ns: i64 = monotonic_ns();
    var tok: i32 = tcp_pollable(fd);
    var timer: i32 = wasm_timer_pollable((wait_ms as i64) * ns_per_ms);
    var pollset: i32[] = [tok, timer];
    var ready: i32 = poll(pollset, wait_ms);
    var dtimer: i32 = wasm_pollable_drop(timer);
    var dtok: i32 = wasm_pollable_drop(tok);
    if (ready == 0) {
        return Some(tcp_recv(fd, max));
    }
    if (ready == 1) {
        // The timer pollable fired first (wasm) — deadline.
        return None;
    }
    // ready < 0: a native poll(2) only reports this after the wait
    // elapsed (timeout); an instant -1 is the interp stub (or EINTR /
    // a poll error), where blocking recv preserves the old behavior.
    var waited_ns: i64 = monotonic_ns() - start_ns;
    if (waited_ns * 2i64 >= (wait_ms as i64) * ns_per_ms) {
        return None;
    }
    return Some(tcp_recv(fd, max));
}

// __eagain() — EAGAIN as this target numbers it: what a non-blocking read
// answers while nothing is queued. wasm's reads never block and use the
// same answer.
// 0.0.0.0: the serve loops listen on every IPv4 interface.
function __every_v4(): u8[] {
    return [0u8, 0u8, 0u8, 0u8];
}

function __eagain(): i32 {
    if (target_os() == "darwin") { return 35; }
    if (target_os() == "wasi") { return 6; }
    return 11;
}

// __recv_scratch() — the loop's one read buffer, filled per readable
// connection and copied out; owned by the loop, never by a request.
function __recv_scratch(): u8[] {
    var buf: u8[] = [];
    var i: i32 = 0;
    while (i < 4096) {
        buf = buf.append(0 as u8);
        i = i + 1;
    }
    return buf;
}

// __Conns — the open connections of a serve loop, by position: the
// descriptor, the request bytes read and not yet answered, how many of
// them the requests answered in the current event occupied (0 between
// events: the answered bytes are dropped once per event, not per
// request), the response bytes the kernel has not taken yet ("" while a
// request is being read), the monotonic time its deadline falls due (the
// read deadline, the same span again for a write, the keep-alive idle
// span between requests), whether the connection persists once the
// response in flight is sent, how many requests it has answered, and
// whether a complete request is still buffered because the event's
// burst ended before it (answered on the next wait, which returns at
// once), whether the request being read has had its `100 Continue`, and
// the data-rate clock: the monotonic time the request's header block
// was found complete (-1 while it is being read or nothing is) and how
// many bytes the buffer held then, so the bytes since are the body's;
// or, once a response is being drained, the time of its first short
// write and how many bytes were pending then; and the peer's address key
// (`tcp_socket_ctl` op 7; 0 when the host will not say), by which the
// per-client cap counts.
struct __Conns { fds: i32[], bufs: u8[][], offs: i32[], pending: string[], deadlines: i64[], keep: boolean[], served: i32[], backlog: boolean[], continued: boolean[], rate_since: i64[], rate_base: i32[], peers: i32[] }

// __Clock — the `Date` every response carries (RFC 9110 §6.6.1),
// formatted once per second: the wall-clock second it was formatted for,
// and the IMF-fixdate text.
struct __Clock { sec: i64, date: string }

// __clock_tick(clk) — the clock brought to the current second, the date
// reformatted only when the second has changed. Read once per wait, so
// the responses of one event share it.
function __clock_tick(clk: __Clock): __Clock {
    var sec: i64 = now_unix_ms() / 1000;
    if (sec == clk.sec && clk.date.len() > 0) { return clk; }
    return __Clock { sec: sec, date: time.instant_from_unix(sec).format_http_date() };
}

// __serve_wire(method, resp, keep_alive, clk) — the response bytes the
// loop sends: the handler's `Date` when it set one, the clock's
// otherwise, and no body where the request's method or the status says
// none (`http_serialize_response_to`).
function __serve_wire(method: string, resp: HttpResponse, keep_alive: boolean, clk: __Clock): string {
    if (resp.headers.get_all("date").len() > 0) { return http.http_serialize_response_to(method, resp, keep_alive); }
    var dated: HttpResponse = resp.with_header("Date", clk.date);
    return http.http_serialize_response_to(method, dated, keep_alive);
}

function __conns_index(c: __Conns, fd: i32): i32 {
    var i: i32 = 0;
    while (i < c.fds.len()) {
        if (c.fds[i] == fd) { return i; }
        i = i + 1;
    }
    return -1;
}

function __conns_add(c: __Conns, fd: i32, deadline: i64, peer: i32): __Conns {
    var empty: u8[] = [];
    return __Conns { fds: c.fds.append(fd), bufs: c.bufs.append(empty), offs: c.offs.append(0), pending: c.pending.append(""), deadlines: c.deadlines.append(deadline), keep: c.keep.append(false), served: c.served.append(0), backlog: c.backlog.append(false), continued: c.continued.append(false), rate_since: c.rate_since.append(0 - (1 as i64)), rate_base: c.rate_base.append(0), peers: c.peers.append(peer) };
}

// __conns_from_peer(c, peer) — how many open connections the peer holds.
function __conns_from_peer(c: __Conns, peer: i32): i32 {
    var n: i32 = 0;
    for p in c.peers {
        if (p == peer) { n = n + 1; }
    }
    return n;
}

function __conns_remove(c: __Conns, at: i32): __Conns {
    var fds: i32[] = [];
    var bufs: u8[][] = [];
    var offs: i32[] = [];
    var pending: string[] = [];
    var deadlines: i64[] = [];
    var keep: boolean[] = [];
    var served: i32[] = [];
    var backlog: boolean[] = [];
    var continued: boolean[] = [];
    var rate_since: i64[] = [];
    var rate_base: i32[] = [];
    var peers: i32[] = [];
    var i: i32 = 0;
    while (i < c.fds.len()) {
        if (i != at) {
            fds = fds.append(c.fds[i]);
            bufs = bufs.append(c.bufs[i]);
            offs = offs.append(c.offs[i]);
            pending = pending.append(c.pending[i]);
            deadlines = deadlines.append(c.deadlines[i]);
            keep = keep.append(c.keep[i]);
            served = served.append(c.served[i]);
            backlog = backlog.append(c.backlog[i]);
            continued = continued.append(c.continued[i]);
            rate_since = rate_since.append(c.rate_since[i]);
            rate_base = rate_base.append(c.rate_base[i]);
            peers = peers.append(c.peers[i]);
        }
        i = i + 1;
    }
    return __Conns { fds: fds, bufs: bufs, offs: offs, pending: pending, deadlines: deadlines, keep: keep, served: served, backlog: backlog, continued: continued, rate_since: rate_since, rate_base: rate_base, peers: peers };
}

// __conns_timeout(c, now) — the wait's timeout: the milliseconds until the
// earliest read deadline (0 once one is due, or while a connection has a
// request its event's burst left unanswered), or -1 with nothing open.
function __conns_timeout(c: __Conns, now: i64): i32 {
    for b in c.backlog {
        if (b) { return 0; }
    }
    var best: i64 = -1 as i64;
    for d in c.deadlines {
        if (best < (0 as i64) || d < best) { best = d; }
    }
    if (best < (0 as i64)) { return -1; }
    if (best <= now) { return 0; }
    var ms: i64 = (best - now + (999999 as i64)) / 1000000;
    if (ms > (2147483647 as i64)) { return 2147483647; }
    return ms as i32;
}

// __serve_accept(drv, listener, c, opts) — one accepted connection,
// non-blocking and watched for reads; a refused watch closes it again,
// and so does a peer already holding `max_connections_per_ip` of them.
// wasm has no non-blocking mode to switch on and its reads never block.
function __serve_accept[D: async.Driver](drv: D, listener: i32, c: __Conns, opts: ServeOptions): __Conns {
    var fd: i32 = tcp_accept(listener);
    if (fd < 0) { return c; }
    var peer: i32 = 0;
    if (opts.max_connections_per_ip > 0) {
        peer = tcp_socket_ctl(fd, 7, 0);
        if (peer != 0 && __conns_from_peer(c, peer) >= opts.max_connections_per_ip) {
            tcp_close(fd);
            return c;
        }
    }
    tcp_socket_ctl(fd, 3, 1);
    if (drv.watch(fd, 1) < 0) {
        tcp_close(fd);
        return c;
    }
    return __conns_add(c, fd, monotonic_ns() + opts.recv_deadline.as_nanos(), peer);
}

// __serve_close(drv, c, at) — the connection at `at` unwatched, closed
// and forgotten.
function __serve_close[D: async.Driver](drv: D, c: __Conns, at: i32): __Conns {
    drv.unwatch(c.fds[at]);
    tcp_close(c.fds[at]);
    return __conns_remove(c, at);
}

// __serve_read(c, at, scratch, opts) — the readable connection at `at`
// read until nothing is queued: `(conns, done)`, where `done` says the
// peer is finished (EOF, an error, or the size cap) and what it sent is
// what the buffer holds. The first bytes of a request start its read
// deadline, replacing the keep-alive idle span an answered connection
// was waiting under, and the body's clock keeps the deadline no earlier
// than what the body has delivered buys (`__body_deadline`).
function __serve_read(c: __Conns, at: i32, scratch: u8[], opts: ServeOptions): (__Conns, boolean) {
    var buf: u8[] = c.bufs[at];
    var was_idle: boolean = buf.len() == 0;
    while (true) {
        var n: i32 = tcp_recv_into(c.fds[at], scratch);
        if (n == 0 - __eagain()) {
            var deadline: i64 = c.deadlines[at];
            if (was_idle && buf.len() > 0) { deadline = monotonic_ns() + opts.recv_deadline.as_nanos(); }
            c = __Conns { ...c, bufs: c.bufs.with(at, buf), deadlines: c.deadlines.with(at, deadline) };
            return (__body_deadline(c, at, opts, monotonic_ns()), false);
        }
        if (n <= 0) {
            return (__Conns { ...c, bufs: c.bufs.with(at, buf) }, true);
        }
        buf = buf.concat(scratch.take(n));
        // A connection holds at most the parser's largest request unread;
        // past that the peer is treated as finished: what is complete is
        // answered, then the connection is closed.
        if (buf.len() > http.http_request_bytes_cap()) {
            return (__Conns { ...c, bufs: c.bufs.with(at, buf) }, true);
        }
    }
    return (c, true);
}

// __bytes_from(buf, from) — buf[from, len) as a fresh array: the bytes
// behind an answered request, the next pipelined request's or nothing.
function __bytes_from(buf: u8[], from: i32): u8[] {
    var n: i32 = buf.len() - from;
    if (n < 0) { n = 0; }
    var out: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) {
        out = out.with(i, buf[from + i]);
        i = i + 1;
    }
    return out;
}

// __tail_persists(tail, eof) — whether the connection outlives the
// response being decided, given the framing of the bytes behind the
// answered request: a malformed tail ends it, so the response says
// `close` and the close follows it; once the peer has finished sending,
// only another complete request keeps it open, so the last response on a
// half-closed connection says `close` too.
function __tail_persists(tail: http.HttpFraming, eof: boolean): boolean {
    match (tail) {
        http.Framed(_) => { return true; },
        http.Incomplete => { return !eof; },
        http.Continue => { return !eof; },
        http.Malformed(_) => { return false; }
    }
    return false;
}

// __serve_took(c, at, f, opts, eof) — the request behind the answered
// bytes consumed: the offset moved past it, the served count up, and
// whether the connection persists after this response decided (the
// request's own say, the per-connection request cap, and what the bytes
// behind it hold, per `__tail_persists`, and never once the loop is
// stopping): `(conns, keep_alive, tail)`, with `tail` the one parse of
// the bytes behind the request, which the response and the next turn of
// the loop read rather than parse again.
function __serve_took(c: __Conns, at: i32, f: http.HttpFramed, opts: ServeOptions, eof: boolean, stop: __Stop): (__Conns, boolean, http.HttpFraming) {
    var served: i32 = c.served[at] + 1;
    var keep: boolean = f.keep_alive && served < opts.keep_alive_requests && !__serve_stopping(stop);
    c = __Conns { ...c, offs: c.offs.with(at, c.offs[at] + f.len), served: c.served.with(at, served), backlog: c.backlog.with(at, false), continued: c.continued.with(at, false) };
    var tail: http.HttpFraming = http.http_parse_request_framed_from(c.bufs[at], c.offs[at]);
    if (keep) { keep = __tail_persists(tail, eof); }
    return (__Conns { ...c, keep: c.keep.with(at, keep) }, keep, tail);
}

// __serve_compact(c, at) — the bytes the event's answered requests
// occupied dropped, once, when the event is done with the connection.
function __serve_compact(c: __Conns, at: i32): __Conns {
    if (c.offs[at] == 0) { return c; }
    return __Conns { ...c, bufs: c.bufs.with(at, __bytes_from(c.bufs[at], c.offs[at])), offs: c.offs.with(at, 0) };
}

// __pipeline_burst() — how many pipelined requests one readiness event
// answers before the loop returns to the wait, so one connection's
// pipeline cannot hold every other client off the reactor. What is left
// is the connection's backlog, answered on the next wait.
function __pipeline_burst(): i32 {
    return 32;
}

// __serve_next(c, at, opts) — an answered connection with nothing left
// to answer, and the deadline it waits under: the idle span once its
// buffer is empty, the read deadline while a partial request holds
// bytes in it. The deadline bounds the wait for the peer, not the
// handlers run before it, so a partial request's clock starts here
// rather than at its first byte, which may have arrived a burst ago;
// the body's clock starts over with it.
function __serve_next(c: __Conns, at: i32, opts: ServeOptions): __Conns {
    var now: i64 = monotonic_ns();
    var span: Duration = opts.keep_alive_idle;
    if (c.bufs[at].len() > c.offs[at]) { span = opts.recv_deadline; }
    c = __Conns { ...c, deadlines: c.deadlines.with(at, now + span.as_nanos()), rate_since: c.rate_since.with(at, 0 - (1 as i64)) };
    return __body_deadline(c, at, opts, now);
}

// __body_deadline(c, at, opts, now) — the connection's deadline held no
// earlier than its body has earned: the body's clock starts when the
// request's header block is found complete, and from then the request
// may take the grace plus what its bytes since buy at the minimum rate.
// A body that keeps flowing outlasts the read deadline; one that stalls
// or trickles does not.
function __body_deadline(c: __Conns, at: i32, opts: ServeOptions, now: i64): __Conns {
    var since: i64 = c.rate_since[at];
    var base: i32 = c.rate_base[at];
    var buf: u8[] = c.bufs[at];
    if (since < (0 as i64)) {
        if (buf.len() <= c.offs[at] || !http.http_header_block_complete(buf, c.offs[at])) { return c; }
        since = now;
        base = buf.len();
    }
    var earned: i64 = since + opts.data_rate_grace.as_nanos();
    if (opts.min_data_rate > 0) { earned = earned + ((buf.len() - base) as i64) * (1000000000 as i64) / (opts.min_data_rate as i64); }
    var deadline: i64 = c.deadlines[at];
    if (earned > deadline) { deadline = earned; }
    return __Conns { ...c, deadlines: c.deadlines.with(at, deadline), rate_since: c.rate_since.with(at, since), rate_base: c.rate_base.with(at, base) };
}

// __serve_ready(drv, c, at, opts, tail) — a persisting connection whose
// response has gone out whole, given the framing of what it has buffered:
// `(conns, more)`, `more` when a complete request is buffered, for the
// loop to answer now; a connection with a request to answer is not
// waiting on the peer, so its deadline is left alone. Less than a request
// waits under `__serve_next`'s deadline, and a malformed one is refused
// now: no bytes could complete it.
function __serve_ready[D: async.Driver](drv: D, c: __Conns, at: i32, opts: ServeOptions, tail: http.HttpFraming, clk: __Clock): (__Conns, boolean) {
    match (tail) {
        http.Framed(_) => { return (c, true); },
        http.Incomplete => { return (__serve_next(c, at, opts), false); },
        http.Continue => { return (__serve_continue(drv, c, at, opts), false); },
        http.Malformed(status) => { return (__serve_refuse(drv, c, at, status, opts, clk), false); }
    }
    return (c, false);
}

// __serve_continue(drv, c, at, opts) — a request whose header block asks
// for `100 Continue` before its body is sent (RFC 9110 §10.1.1): the
// interim response, once per request, then the wait for the body under
// `__serve_next`'s deadline. A short write leaves the rest pending, to be
// finished by a later wait, and the connection is kept for the request
// it is still reading; a refused write closes it.
function __serve_continue[D: async.Driver](drv: D, c: __Conns, at: i32, opts: ServeOptions): __Conns {
    if (c.continued[at]) { return __serve_next(c, at, opts); }
    c = __Conns { ...c, continued: c.continued.with(at, true), keep: c.keep.with(at, true) };
    var sent: (__Conns, __Sent) = __serve_send(drv, c, at, "HTTP/1.1 100 Continue\r\n\r\n", opts);
    match (sent.1) {
        Partial => { return sent.0; },
        Failed => { return __serve_close(drv, sent.0, at); },
        Whole => { return __serve_next(sent.0, at, opts); }
    }
    return sent.0;
}

// __serve_refuse(drv, c, at, status, opts) — the loop's own answer to a
// malformed request: `status` with an empty body and `Connection:
// close`, then the close. A short write leaves the rest pending, to be
// finished by a later wait, which closes the connection once it has gone
// out; a refused write closes it now.
function __serve_refuse[D: async.Driver](drv: D, c: __Conns, at: i32, status: i32, opts: ServeOptions, clk: __Clock): __Conns {
    var wire: string = __serve_wire("GET", http.http_response_text(status, ""), false, clk);
    var sent: (__Conns, __Sent) = __serve_send(drv, __Conns { ...c, keep: c.keep.with(at, false) }, at, wire, opts);
    match (sent.1) {
        Partial => { return sent.0; },
        Failed => { return __serve_close(drv, sent.0, at); },
        Whole => { return __serve_close(drv, sent.0, at); }
    }
    return sent.0;
}

// __serve_respond(drv, c, at, wire, opts, answered, tail) — the response
// sent and the connection's next state, given the framing of the bytes
// behind the answered request: `(conns, more)`, where `more` says the
// connection persists with its next request already buffered, so the
// loop answers it now. A short write leaves the rest pending, to be
// finished by a later wait (`__serve_drain`); a write the kernel refuses
// closes the connection; a finished write closes a connection that does
// not persist; and the `answered`th response of one event ends the
// event's burst, leaving a request still buffered as the connection's
// backlog.
function __serve_respond[D: async.Driver](drv: D, c: __Conns, at: i32, wire: string, opts: ServeOptions, answered: i32, tail: http.HttpFraming, clk: __Clock): (__Conns, boolean) {
    var sent: (__Conns, __Sent) = __serve_send(drv, c, at, wire, opts);
    c = sent.0;
    match (sent.1) {
        Partial => { return (c, false); },
        Failed => { return (__serve_close(drv, c, at), false); },
        Whole => { }
    }
    if (!c.keep[at]) { return (__serve_close(drv, c, at), false); }
    var ready: (__Conns, boolean) = __serve_ready(drv, c, at, opts, tail, clk);
    c = ready.0;
    if (!ready.1) { return (c, false); }
    if (answered >= __pipeline_burst()) {
        return (__Conns { ...c, backlog: c.backlog.with(at, true) }, false);
    }
    return (c, true);
}

// __serve_drain(drv, c, at, opts) — a writable connection with a response
// still pending: the rest written, and `(conns, at, false)` once it has
// gone out whole on a persisting connection with a request buffered
// behind it, watched for reads again; `(conns, -1, false)` while it is
// still draining, when the connection waits for its next request, or
// when it is closed (the write failed, the connection does not persist,
// or the reactor refused to watch it again).
function __serve_drain[D: async.Driver](drv: D, c: __Conns, at: i32, opts: ServeOptions, clk: __Clock): (__Conns, i32, boolean) {
    var sent: (__Conns, __Sent) = __serve_send(drv, c, at, c.pending[at], opts);
    c = sent.0;
    match (sent.1) {
        Partial => { return (c, -1, false); },
        Failed => { return (__serve_close(drv, c, at), -1, false); },
        Whole => { }
    }
    if (!c.keep[at]) { return (__serve_close(drv, c, at), -1, false); }
    if (drv.watch(c.fds[at], 1) < 0) { return (__serve_close(drv, c, at), -1, false); }
    var tail: http.HttpFraming = http.http_parse_request_framed_from(c.bufs[at], c.offs[at]);
    var ready: (__Conns, boolean) = __serve_ready(drv, __Conns { ...c, pending: c.pending.with(at, "") }, at, opts, tail, clk);
    if (!ready.1) { return (ready.0, -1, false); }
    return (ready.0, at, false);
}

// __serve_eof(drv, c, at) — the peer has finished sending: a response
// still draining goes out and then closes the connection; anything else
// closes it now.
function __serve_eof[D: async.Driver](drv: D, c: __Conns, at: i32): __Conns {
    if (c.pending[at].len() > 0) { return __Conns { ...c, keep: c.keep.with(at, false) }; }
    return __serve_close(drv, c, at);
}

// __serve_event(drv, c, fd, scratch, opts) — one readiness event on the
// connection `fd`, brought to where its buffered requests can be answered:
// `(conns, at, eof)`, with `at` the connection's position, or -1 when this
// event ends with nothing to answer (an unknown descriptor, a response still
// draining, a connection closed once it drained), and `eof` when the peer
// has finished sending.
function __serve_event[D: async.Driver](drv: D, c: __Conns, fd: i32, scratch: u8[], opts: ServeOptions, clk: __Clock): (__Conns, i32, boolean) {
    var at: i32 = __conns_index(c, fd);
    if (at < 0) { return (c, -1, false); }
    if (c.pending[at].len() > 0) { return __serve_drain(drv, c, at, opts, clk); }
    var read: (__Conns, boolean) = __serve_read(c, at, scratch, opts);
    return (read.0, at, read.1);
}

// __serve_finish(drv, c, fd, eof) — after an event's requests are answered:
// the answered bytes dropped, and a peer that has finished sending
// closed, once anything still draining has gone out. A connection whose
// burst left a request buffered is not closed yet: the backlog answers
// it on the next wait, whose read sees the end of stream again.
function __serve_finish[D: async.Driver](drv: D, c: __Conns, fd: i32, eof: boolean): __Conns {
    var at: i32 = __conns_index(c, fd);
    if (at < 0) { return c; }
    c = __serve_compact(c, at);
    if (!eof || c.backlog[at]) { return c; }
    return __serve_eof(drv, c, at);
}

// __with_backlog(c, events) — the wait's events with one more for every
// connection whose burst left a request buffered and that the wait did
// not report itself, so the loop answers the backlog on this pass
// without the peer having to send anything, and once per pass.
function __with_backlog(c: __Conns, events: i32[]): i32[] {
    var reported: i32 = events.len();
    var i: i32 = 0;
    while (i < c.fds.len()) {
        if (c.backlog[i] && !__reported(events, reported, c.fds[i])) { events = events.append(c.fds[i]).append(0); }
        i = i + 1;
    }
    return events;
}

// __reported(events, n, fd) — whether `fd` is among the first `n` entries
// of the wait's (fd, readiness) pairs.
function __reported(events: i32[], n: i32, fd: i32): boolean {
    var k: i32 = 0;
    while (k + 1 < n) {
        if (events[k] == fd) { return true; }
        k = k + 2;
    }
    return false;
}

// __Sent — how far a write got: the kernel took it all, keeps the rest
// as the connection's pending bytes, or refused it.
enum __Sent { Whole, Partial, Failed }

// __serve_send(drv, c, at, payload, opts) — the response written to
// the connection at `at`: `(conns, sent)`. A short write keeps the rest
// as the connection's pending bytes, watches it for writability instead
// of reads and gives it what `__drain_deadline` allows; the loop
// finishes the write on later waits. A write the kernel refuses (the
// peer is gone) leaves the connection to the caller to close.
function __serve_send[D: async.Driver](drv: D, c: __Conns, at: i32, payload: string, opts: ServeOptions): (__Conns, __Sent) {
    var n: i32 = tcp_send(c.fds[at], payload);
    if (n >= payload.len()) { return (c, Whole); }
    if (n < 0 && n != 0 - __eagain()) { return (c, Failed); }
    var rest: string = payload;
    if (n > 0) { rest = slice_unchecked(payload, n, payload.len()).to_owned(); }
    drv.watch(c.fds[at], 2);
    var first: boolean = c.pending[at].len() == 0;
    return (__drain_deadline(__Conns { ...c, pending: c.pending.with(at, rest) }, at, opts, first), Partial);
}

// __drain_deadline(c, at, opts, first) — the deadline of a response being
// drained: its clock starts at the first short write, with the bytes the
// peer had not taken then (pending here, plus what the socket holds
// unacknowledged) as its base, and from then the peer may take the grace
// plus what the bytes it has taken since buy at the minimum rate, so a
// peer that stops reading is cut off after the grace and one that keeps
// reading above the rate never is. The loop re-reads this at the
// deadline (`__serve_expire`), since the socket reports the peer's
// progress without a readiness event. Without a rate, the read deadline
// from each write. Where the socket cannot report its queue (wasm), the
// bytes the loop has handed it are the progress.
function __drain_deadline(c: __Conns, at: i32, opts: ServeOptions, first: boolean): __Conns {
    var now: i64 = monotonic_ns();
    var since: i64 = c.rate_since[at];
    var base: i32 = c.rate_base[at];
    var queued: i32 = tcp_socket_ctl(c.fds[at], 6, 0);
    if (queued < 0) { queued = 0; }
    var outstanding: i32 = c.pending[at].len() + queued;
    if (first) {
        since = now;
        base = outstanding;
    }
    var deadline: i64 = now + opts.recv_deadline.as_nanos();
    if (opts.min_data_rate > 0) {
        deadline = since + opts.data_rate_grace.as_nanos() + ((base - outstanding) as i64) * (1000000000 as i64) / (opts.min_data_rate as i64);
    }
    return __Conns { ...c, deadlines: c.deadlines.with(at, deadline), rate_since: c.rate_since.with(at, since), rate_base: c.rate_base.with(at, base) };
}

// __listener_interest(opts) — how a loop watches its listener: for reads,
// and exclusively when other workers watch the same listener, so a
// connection wakes one of them rather than all.
function __listener_interest(opts: ServeOptions): i32 {
    if (opts.workers > 1) { return 5; }
    return 1;
}

// __stop_begin(stop) — the shutdown started by SIGTERM (reported as -15),
// once: a second signal changes nothing.
function __stop_begin(stop: __Stop): __Stop {
    if (__serve_stopping(stop)) { return stop; }
    return __Stop { ...stop, at: monotonic_ns() };
}

// __serve_pass_end(drv, listener, c, opts, stop, accepting) — what one
// pass of the loop does after its events: connections past their
// deadline are closed, the listener is gated by the connection cap
// (until a shutdown, which owns the listener from then), and the
// shutdown takes its next step. `(conns, stop, accepting, done)`.
function __serve_pass_end[D: async.Driver](drv: D, listener: i32, c: __Conns, opts: ServeOptions, stop: __Stop, accepting: boolean): (__Conns, __Stop, boolean, boolean) {
    var now: i64 = monotonic_ns();
    c = __serve_expire(drv, c, opts, now);
    if (!__serve_stopping(stop)) { accepting = __serve_gate(drv, listener, c, opts, accepting); }
    return __serve_stop_step(drv, listener, c, opts, stop, accepting, now);
}

// __Stop — where a loop is in its shutdown: the monotonic time SIGTERM
// arrived (-1 before it), whether the listener has been closed since,
// and whether a connection was cut off with a request in flight.
struct __Stop { at: i64, closed: boolean, aborted: boolean }

function __stop_none(): __Stop {
    return __Stop { at: 0 - (1 as i64), closed: false, aborted: false };
}

// __serve_stopping(stop) — whether SIGTERM has arrived.
function __serve_stopping(stop: __Stop): boolean {
    return stop.at >= (0 as i64);
}

// __stop_timeout(stop, opts, now, timeout) — the wait's timeout brought
// forward to the next step of a shutdown: the end of the accept grace,
// then the drain deadline.
function __stop_timeout(stop: __Stop, opts: ServeOptions, now: i64, timeout: i32): i32 {
    if (!__serve_stopping(stop)) { return timeout; }
    var due: i64 = stop.at + opts.shutdown_grace.as_nanos();
    if (stop.closed) { due = stop.at + opts.drain_deadline.as_nanos(); }
    var ms: i64 = (due - now + (999999 as i64)) / 1000000;
    if (ms < (0 as i64)) { ms = 0 as i64; }
    if (timeout >= 0 && (timeout as i64) < ms) { return timeout; }
    if (ms > (2147483647 as i64)) { return 2147483647; }
    return ms as i32;
}

// __serve_stop_step(drv, listener, c, opts, stop, accepting, now) — the
// shutdown's next step, once per pass: past the accept grace the
// listener is closed and every connection with nothing in flight (an
// empty buffer and nothing to write) is closed too; past the drain
// deadline the rest are closed and the loop remembers it cut them off.
// `(conns, stop, accepting, done)`, `done` once the listener is closed
// and no connection remains.
function __serve_stop_step[D: async.Driver](drv: D, listener: i32, c: __Conns, opts: ServeOptions, stop: __Stop, accepting: boolean, now: i64): (__Conns, __Stop, boolean, boolean) {
    if (!__serve_stopping(stop)) { return (c, stop, accepting, false); }
    if (!stop.closed) {
        if (now < stop.at + opts.shutdown_grace.as_nanos()) { return (c, stop, accepting, false); }
        if (accepting) { drv.unwatch(listener); }
        tcp_close(listener);
        stop = __Stop { ...stop, closed: true };
        accepting = false;
    }
    var swept: (__Conns, __Stop) = __stop_sweep(drv, c, stop, now >= stop.at + opts.drain_deadline.as_nanos());
    return (swept.0, swept.1, accepting, swept.0.fds.len() == 0);
}

// __stop_sweep(drv, c, stop, past_drain) — the connections with nothing
// in flight closed, and past the drain deadline every connection, the
// shutdown remembering the ones it cut off.
function __stop_sweep[D: async.Driver](drv: D, c: __Conns, stop: __Stop, past_drain: boolean): (__Conns, __Stop) {
    var i: i32 = 0;
    while (i < c.fds.len()) {
        var idle: boolean = c.bufs[i].len() == 0 && c.pending[i].len() == 0 && !c.backlog[i];
        if (idle || past_drain) {
            if (!idle) { stop = __Stop { ...stop, aborted: true }; }
            c = __serve_close(drv, c, i);
        } else {
            i = i + 1;
        }
    }
    return (c, stop);
}

// __stop_code(stop) — what a finished shutdown exits with: 0 when every
// request in flight was answered, 1 when one was cut off at the drain
// deadline.
function __stop_code(stop: __Stop): i32 {
    if (stop.aborted) { return 1; }
    return 0;
}

// __stop_reason(stop) — what a finished shutdown tells the program's
// `shutdown` hook: "sigterm" when every request in flight was answered,
// "drain-deadline" when one was cut off.
function __stop_reason(stop: __Stop): string {
    if (stop.aborted) { return "drain-deadline"; }
    return "sigterm";
}

// __serve_not_ready(f, opts, stop) — whether the request is the
// readiness probe of a loop that is stopping, to be answered 503 by the
// loop itself so whoever routes to it stops.
function __serve_not_ready(f: http.HttpFramed, opts: ServeOptions, stop: __Stop): boolean {
    return __serve_stopping(stop) && opts.readiness_path.len() > 0 && f.request.path == opts.readiness_path;
}

// __serve_gate(drv, listener, c, opts, accepting) — whether the listener
// is watched after this pass: unwatched once `max_connections` are open,
// so the accept queue holds the rest, and watched again once one has
// closed. A watch the reactor refuses leaves the listener unwatched
// until the next pass tries again.
function __serve_gate[D: async.Driver](drv: D, listener: i32, c: __Conns, opts: ServeOptions, accepting: boolean): boolean {
    var full: boolean = c.fds.len() >= opts.max_connections;
    if (accepting && full) {
        drv.unwatch(listener);
        return false;
    }
    if (!accepting && !full) { return drv.watch(listener, __listener_interest(opts)) >= 0; }
    return accepting;
}

// __serve_expire(drv, c, opts, now) — every connection whose deadline is
// due closed, without a response or with the rest of one unsent; one
// still draining a response has its deadline re-read first, since the
// peer's progress shows in the socket's queue and not only in a
// readiness event. A connection whose backlog holds a request is not
// waiting on the peer: its deadline is stale from the read that filled
// the backlog, and it stays open for the next wait to answer it.
function __serve_expire[D: async.Driver](drv: D, c: __Conns, opts: ServeOptions, now: i64): __Conns {
    var i: i32 = 0;
    while (i < c.fds.len()) {
        if (c.deadlines[i] <= now && !c.backlog[i] && c.pending[i].len() > 0) { c = __drain_deadline(c, i, opts, false); }
        if (c.deadlines[i] <= now && !c.backlog[i]) {
            c = __serve_close(drv, c, i);
        } else {
            i = i + 1;
        }
    }
    return c;
}

// __host_platform — the bag the accept loops hand every handler: the host
// mode, a sink nothing writes to, and the worker's reactor as its handle,
// 0 where the target has none, as a bag from `platform_new` carries.
// Recording is a MockPlatform's job; it builds a bag over its own cell
// (std/mock_platform). Built once per loop rather than per request, since
// no request can change it.
function __host_platform(reactor: i32): Platform {
    var handle: i32 = reactor;
    if (handle < 0) { handle = 0; }
    return Platform { version: 2, mode: 0, sink: cell_new(""), handle: handle };
}

// __serve_loop — the HTTP/1.1 reactor loop factored out of `tcp_serve`
// so `tcp_serve_supervised` can run the same loop against a listener fd
// it does NOT create: the supervising parent owns the listening socket
// (created before the first fork, inherited by every worker), so the
// kernel backlog — and any pending connections in it — survives a worker
// death. Loops forever under normal operation; the i32 return only
// materialises for the type system (no clean-shutdown channel exposed
// yet), except that a listener the reactor cannot watch returns its
// -errno like a failed bind. `opts` bounds each connection's request
// read (see `tcp_serve_deadline`) and its persistence.
function __serve_loop(listener: i32, handler: (HttpRequest, Platform) => HttpResponse, opts: ServeOptions, on_stop: (string) => void): i32 {
    var drv: async.RealDriver = async.real_driver();
    var watched: i32 = drv.watch(listener, __listener_interest(opts));
    if (watched < 0) { return watched; }
    var accepting: boolean = true;
    var stop: __Stop = __stop_none();
    drv.watch_signal(15);
    var plat: Platform = __host_platform(drv.handle());
    var conns: __Conns = __Conns { fds: [], bufs: [], offs: [], pending: [], deadlines: [], keep: [], served: [], backlog: [], continued: [], rate_since: [], rate_base: [], peers: [] };
    var scratch: u8[] = __recv_scratch();
    var clk: __Clock = __Clock { sec: 0 as i64, date: "" };
    while (true) {
        var events: i32[] = __with_backlog(conns, drv.wait(64, __stop_timeout(stop, opts, monotonic_ns(), __conns_timeout(conns, monotonic_ns()))));
        clk = __clock_tick(clk);
        var k: i32 = 0;
        while (k + 1 < events.len()) {
            var fd: i32 = events[k];
            k = k + 2;
            if (fd == 0 - 15) {
                stop = __stop_begin(stop);
                continue;
            }
            if (fd == listener) {
                conns = __serve_accept(drv, listener, conns, opts);
                continue;
            }
            var ev: (__Conns, i32, boolean) = __serve_event(drv, conns, fd, scratch, opts, clk);
            conns = ev.0;
            var at: i32 = ev.1;
            if (at < 0) { continue; }
            var more: boolean = true;
            var count: i32 = 0;
            var framing: http.HttpFraming = http.http_parse_request_framed_from(conns.bufs[at], conns.offs[at]);
            while (more) {
                var next: http.HttpFraming = http.Incomplete;
                match (framing) {
                    http.Framed(f) => {
                        var took: (__Conns, boolean, http.HttpFraming) = __serve_took(conns, at, f, opts, ev.2, stop);
                        conns = took.0;
                        count = count + 1;
                        var resp: HttpResponse = http.http_response_text(503, "");
                        if (!__serve_not_ready(f, opts, stop)) { resp = handler(f.request, plat); }
                        var answered: (__Conns, boolean) = __serve_respond(drv, conns, at, __serve_wire(f.request.method, resp, took.1, clk), opts, count, took.2, clk);
                        conns = answered.0;
                        more = answered.1;
                        next = took.2;
                    },
                    http.Incomplete => { more = false; },
                    http.Continue => {
                        conns = __serve_continue(drv, conns, at, opts);
                        more = false;
                    },
                    http.Malformed(status) => {
                        conns = __serve_refuse(drv, conns, at, status, opts, clk);
                        more = false;
                    }
                }
                framing = next;
            }
            conns = __serve_finish(drv, conns, fd, ev.2);
        }
        var ended: (__Conns, __Stop, boolean, boolean) = __serve_pass_end(drv, listener, conns, opts, stop, accepting);
        conns = ended.0;
        stop = ended.1;
        accepting = ended.2;
        if (ended.3) {
            drv.close();
            on_stop(__stop_reason(stop));
            return __stop_code(stop);
        }
    }
    // A bounded loop (the census fixtures) hands the listener back with
    // nothing watching it: on wasm a socket still subscribed cannot close.
    if (accepting) { drv.unwatch(listener); }
    drv.close();
    return 0;
}

// __serve_loop_with — `__serve_loop` threading a caller-owned state
// value through the handler chain. The state lives in the loop frame,
// so it is process-lifetime without any language-level global: each
// request sees the value the previous one returned.
function __serve_loop_with[S](listener: i32, init: S, handler: (S, HttpRequest, Platform) => (S, HttpResponse), opts: ServeOptions, on_stop: (string, S) => void): i32 {
    var st: S = init;
    var drv: async.RealDriver = async.real_driver();
    var watched: i32 = drv.watch(listener, __listener_interest(opts));
    if (watched < 0) { return watched; }
    var accepting: boolean = true;
    var stop: __Stop = __stop_none();
    drv.watch_signal(15);
    var plat: Platform = __host_platform(drv.handle());
    var conns: __Conns = __Conns { fds: [], bufs: [], offs: [], pending: [], deadlines: [], keep: [], served: [], backlog: [], continued: [], rate_since: [], rate_base: [], peers: [] };
    var scratch: u8[] = __recv_scratch();
    var clk: __Clock = __Clock { sec: 0 as i64, date: "" };
    while (true) {
        var events: i32[] = __with_backlog(conns, drv.wait(64, __stop_timeout(stop, opts, monotonic_ns(), __conns_timeout(conns, monotonic_ns()))));
        clk = __clock_tick(clk);
        var k: i32 = 0;
        while (k + 1 < events.len()) {
            var fd: i32 = events[k];
            k = k + 2;
            if (fd == 0 - 15) {
                stop = __stop_begin(stop);
                continue;
            }
            if (fd == listener) {
                conns = __serve_accept(drv, listener, conns, opts);
                continue;
            }
            var ev: (__Conns, i32, boolean) = __serve_event(drv, conns, fd, scratch, opts, clk);
            conns = ev.0;
            var at: i32 = ev.1;
            if (at < 0) { continue; }
            var more: boolean = true;
            var count: i32 = 0;
            var framing: http.HttpFraming = http.http_parse_request_framed_from(conns.bufs[at], conns.offs[at]);
            while (more) {
                var next: http.HttpFraming = http.Incomplete;
                match (framing) {
                    http.Framed(f) => {
                        var took: (__Conns, boolean, http.HttpFraming) = __serve_took(conns, at, f, opts, ev.2, stop);
                        conns = took.0;
                        count = count + 1;
                        var stepped: (S, HttpResponse) = (st, http.http_response_text(503, ""));
                        if (!__serve_not_ready(f, opts, stop)) { stepped = handler(st, f.request, plat); }
                        st = stepped.0;
                        var answered: (__Conns, boolean) = __serve_respond(drv, conns, at, __serve_wire(f.request.method, stepped.1, took.1, clk), opts, count, took.2, clk);
                        conns = answered.0;
                        more = answered.1;
                        next = took.2;
                    },
                    http.Incomplete => { more = false; },
                    http.Continue => {
                        conns = __serve_continue(drv, conns, at, opts);
                        more = false;
                    },
                    http.Malformed(status) => {
                        conns = __serve_refuse(drv, conns, at, status, opts, clk);
                        more = false;
                    }
                }
                framing = next;
            }
            conns = __serve_finish(drv, conns, fd, ev.2);
        }
        var ended: (__Conns, __Stop, boolean, boolean) = __serve_pass_end(drv, listener, conns, opts, stop, accepting);
        conns = ended.0;
        stop = ended.1;
        accepting = ended.2;
        if (ended.3) {
            drv.close();
            on_stop(__stop_reason(stop), st);
            return __stop_code(stop);
        }
    }
    // A bounded loop (the census fixtures) hands the listener back with
    // nothing watching it: on wasm a socket still subscribed cannot close.
    if (accepting) { drv.unwatch(listener); }
    drv.close();
    return 0;
}

// tcp_serve_supervised(port, handler) — `tcp_serve` under a supervising
// parent (docs/CRASH-ONLY-SERVE.md): the listener is made here, before
// the first fork, and every worker inherits it, so pending connections
// survive a worker's death; a worker that dies is logged and forked
// again under a bounded backoff, and eight deaths within 100 ms of
// their forks in a row give up with the last exit code. Serves
// single-process where there is no fork (the interpreter).
pub function tcp_serve_supervised(port: i32, handler: (HttpRequest, Platform) => HttpResponse): i32 {
    return tcp_serve_supervised_opts(port, serve_options(), handler);
}

// tcp_serve_supervised_opts(port, opts, handler) — `tcp_serve_supervised`
// with `ServeOptions`: `opts.workers` workers are forked (below 1: one
// per processing unit), each running its own loop over the one
// listener, watched exclusively so a connection wakes one of them;
// whichever dies is replaced, the backoff
// and the fast-death count shared among them. SIGTERM is forwarded to
// every worker and the supervisor waits for them, exiting with the
// worst code they answered (1 when one cut a request off).
pub function tcp_serve_supervised_opts(port: i32, opts: ServeOptions, handler: (HttpRequest, Platform) => HttpResponse): i32 {
    // Listener FIRST, in the parent — the whole design hinges on
    // workers inheriting this fd rather than owning it.
    var listener: i32 = __serve_listener(port, opts);
    if (listener < 0) {
        return listener;
    }
    var workers: i32 = opts.workers;
    if (workers < 1) { workers = cpu_count(); }
    if (workers < 1) { workers = 1; }
    var resolved: ServeOptions = ServeOptions { ...opts, workers: workers };
    var sup: __Supervisor = __Supervisor { pids: [], spawned: [], backoff_ms: 100 as i64, fast_deaths: 0, stopping: false, worst: 0 };
    var drv: async.RealDriver = async.real_driver();
    var chld: i32 = drv.watch_signal(17);
    if (chld < 0) { return chld; }
    drv.watch_signal(15);
    while (true) {
        while (!sup.stopping && sup.pids.len() < workers) {
            var forked: (__Supervisor, i32) = __supervisor_fork(drv, listener, handler, resolved, sup);
            sup = forked.0;
            if (forked.1 != 0 - 1) { return forked.1; }
        }
        if (sup.stopping && sup.pids.len() == 0) {
            drv.close();
            return sup.worst;
        }
        // Parent: supervise. A child's death and SIGTERM both arrive as
        // readiness events; a death is reaped by probing every worker.
        var events: i32[] = drv.wait(8, -1);
        var k: i32 = 0;
        while (k + 1 < events.len()) {
            var fd: i32 = events[k];
            k = k + 2;
            if (fd == 0 - 15) { sup = __supervisor_stop(sup); }
            if (fd == 0 - 17) { sup = __supervisor_reap(sup); }
        }
        if (sup.gave_up()) { return sup.worst; }
    }
    return 0;
}

// __supervisor_fork(drv, listener, handler, opts, sup) — one more worker
// forked and recorded: `(sup, -1)`, or `(sup, code)` for the supervisor
// to return with: a fork the host refuses, or the loop's own result
// where there is no fork at all (ENOSYS: the interpreter), which serves
// single-process instead. The child runs the loop over the inherited
// listener and exits with its code rather than returning into a second
// supervision loop; the reactor is the parent's, shared across the fork,
// so the child only closes its copy, since an unwatch would take the
// parent's signals out of the set the parent waits on.
function __supervisor_fork(drv: async.RealDriver, listener: i32, handler: (HttpRequest, Platform) => HttpResponse, opts: ServeOptions, sup: __Supervisor): (__Supervisor, i32) {
    var pid: i32 = proc_fork();
    if (pid == -38) {
        eprint("tcp_serve_supervised: supervision unavailable; serving single-process");
        drv.unwatch_signal(17);
        drv.unwatch_signal(15);
        drv.close();
        return (sup, __serve_loop(listener, handler, ServeOptions { ...opts, workers: 1 }, (reason: string): void => {}));
    }
    if (pid < 0) { return (sup, pid); }
    if (pid == 0) {
        drv.close();
        exit(__serve_loop(listener, handler, opts, (reason: string): void => {}));
        return (sup, 0);
    }
    return (__Supervisor { ...sup, pids: sup.pids.append(pid), spawned: sup.spawned.append(now_unix_ms()) }, 0 - 1);
}

// __Supervisor — the supervisor's workers (pids, and when each was
// forked), its refork backoff and consecutive fast-death count, whether
// SIGTERM has been forwarded, and the worst exit code a worker has
// answered since.
struct __Supervisor { pids: i32[], spawned: i64[], backoff_ms: i64, fast_deaths: i32, stopping: boolean, worst: i32 }

// `.gave_up()` — eight consecutive fast deaths: the supervisor exits with
// the last one's code rather than spinning.
function (s: __Supervisor) gave_up(): boolean {
    return s.fast_deaths >= 8;
}

// __supervisor_stop(sup) — SIGTERM forwarded to every worker, each of
// which drains and exits; nothing is forked again.
function __supervisor_stop(sup: __Supervisor): __Supervisor {
    if (sup.stopping) { return sup; }
    for pid in sup.pids {
        match (signal_send(pid, 15)) { Ok(_) => { }, Err(_) => { } }
    }
    return __Supervisor { ...sup, stopping: true };
}

// __supervisor_reap(sup) — every worker that has exited reaped: a death
// while serving is logged with the raw exit code (134 = trap, 137 =
// arena exhaustion, 101 = todo, 1 = assert) and counted against the
// backoff, which is slept here before the loop forks its replacement; a
// death after SIGTERM is the worker's shutdown, and its code is kept.
function __supervisor_reap(sup: __Supervisor): __Supervisor {
    var i: i32 = 0;
    while (i < sup.pids.len()) {
        var code: i32 = proc_waitpid_nohang(sup.pids[i]);
        if (code == 0 - 1) {
            i = i + 1;
            continue;
        }
        if (code < 0) { code = 0 - code; }
        var lived_ms: i64 = now_unix_ms() - sup.spawned[i];
        sup = __Supervisor { ...sup, pids: __without_index_i32(sup.pids, i), spawned: __without_index_i64(sup.spawned, i) };
        if (sup.stopping) {
            if (code > sup.worst) { sup = __Supervisor { ...sup, worst: code }; }
            continue;
        }
        eprint("tcp_serve_supervised: worker died with exit code " + int.int_to_string(code) + "; restarting");
        sup = __Supervisor { ...sup, worst: code };
        if (lived_ms < (100 as i64)) {
            sup = __Supervisor { ...sup, fast_deaths: sup.fast_deaths + 1 };
            if (sup.gave_up()) {
                eprint("tcp_serve_supervised: giving up after 8 consecutive fast worker deaths");
                return sup;
            }
        } else {
            sup = __Supervisor { ...sup, fast_deaths: 0, backoff_ms: 100 as i64 };
        }
        sleep_ms(sup.backoff_ms);
        var next: i64 = sup.backoff_ms * (2 as i64);
        if (next > (5000 as i64)) { next = 5000 as i64; }
        sup = __Supervisor { ...sup, backoff_ms: next };
    }
    return sup;
}

function __without_index_i32(xs: i32[], at: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < xs.len()) {
        if (i != at) { out = out.append(xs[i]); }
        i = i + 1;
    }
    return out;
}

function __without_index_i64(xs: i64[], at: i32): i64[] {
    var out: i64[] = [];
    var i: i32 = 0;
    while (i < xs.len()) {
        if (i != at) { out = out.append(xs[i]); }
        i = i + 1;
    }
    return out;
}

// Pull a port number out of an env var. Returns the parsed
// integer on success, -1 on missing / malformed / out-of-
// range. Used by the auto-`main()`-from-`handle()` synthesis
// so handler-shaped programs can be tuned via `PORT=N ./bin`
// without writing a manual main().
//
// Inline i32-only digit accumulation rather than std/string's
// `s.parse_int()` (which uses i64 for overflow safety and would
// pull that module in just for a port number). The result is
// bounded to a valid TCP port (0..65535), so i32 suffices.
function __port_from_env(name: string, fallback: i32): i32 {
    match (env(name)) {
        Some(s) => {
            var n: i32 = 0;
            var i: i32 = 0;
            while (i < s.len()) {
                var b: i32 = s[i] as i32;
                if (b < 48 || b > 57) { return fallback; }
                n = n * 10 + (b - 48);
                if (n > 65535) { return fallback; }
                i = i + 1;
            }
            if (i == 0) { return fallback; }
            return n;
        },
        None => {
            return fallback;
        }
    }
}
