// This module reads and writes CSV fields, records, and documents under RFC 4180.

import "std/string";

pub function csv_escape(s: string): string {
  if (!s.contains(",") && !s.contains("\"")
    && !s.contains("\n") && !s.contains("\r")) {
    return s;
  }
  return "\"" + s.replace("\"", "\"\"") + "\"";
}

pub function csv_join(arr: string[]): string {
  let n: i32 = arr.len();
  if (n == 0) {
    return "";
  }
  let total: i32 = 0;
  let i: i32 = 0;
  while (i < n) {
    if (i > 0) {
      total = total + 1;
    }
    total = total + csv_escape(arr[i]).len();
    i = i + 1;
  }
  let buf: u8[] = __alloc_u8(total);
  let pos: i32 = 0;
  i = 0;
  while (i < n) {
    if (i > 0) {
      buf = buf.with(pos, 44 as u8);
      pos = pos + 1;
    }
    let f: string = csv_escape(arr[i]);
    let fl: i32 = f.len();
    let j: i32 = 0;
    while (j < fl) {
      buf = buf.with(pos, f[j] as u8);
      pos = pos + 1;
      j = j + 1;
    }
    i = i + 1;
  }
  return string_from_bytes_unchecked(buf);
}

pub function csv_parse_line(s: string): string[] {
  let out: string[] = [];
  let n: i32 = s.len();
  let i: i32 = 0;
  let field: u8[] = [];
  let in_quotes: boolean = false;
  while (i < n) {
    let c: i32 = s[i] as i32;
    if (in_quotes) {
      if (c == 34) {
        if (i + 1 < n && s[i + 1] == 34) {
          field = field.append(34 as u8);
          i = i + 2;
        } else {
          in_quotes = false;
          i = i + 1;
        }
      } else {
        field = field.append(s[i] as u8);
        i = i + 1;
      }
    } else {
      if (c == 44) {
        out = out.append(string_from_bytes_unchecked(field));
        field = [];
        i = i + 1;
      } else if (c == 34 && field.len() == 0) {
        in_quotes = true;
        i = i + 1;
      } else {
        field = field.append(s[i] as u8);
        i = i + 1;
      }
    }
  }
  return out.append(string_from_bytes_unchecked(field));
}

pub function csv_parse(s: string): string[][] {
  let rows: string[][] = [];
  let record: string[] = [];
  let field: u8[] = [];
  let in_quotes: boolean = false;
  let seen: boolean = false;
  let n: i32 = s.len();
  let i: i32 = 0;
  while (i < n) {
    let c: i32 = s[i] as i32;
    if (in_quotes) {
      if (c == 34) {
        if (i + 1 < n && s[i + 1] == 34) {
          field = field.append(34 as u8);
          i = i + 2;
        } else {
          in_quotes = false;
          i = i + 1;
        }
      } else {
        field = field.append(s[i] as u8);
        i = i + 1;
      }
    } else if (c == 34 && field.len() == 0) {
      in_quotes = true;
      seen = true;
      i = i + 1;
    } else if (c == 44) {
      record = record.append(string_from_bytes_unchecked(field));
      field = [];
      seen = true;
      i = i + 1;
    } else if (c == 10) {
      record = record.append(string_from_bytes_unchecked(field));
      field = [];
      rows = rows.append(record);
      record = [];
      seen = false;
      i = i + 1;
    } else if (c == 13) {
      record = record.append(string_from_bytes_unchecked(field));
      field = [];
      rows = rows.append(record);
      record = [];
      seen = false;
      if (i + 1 < n && s[i + 1] == 10) {
        i = i + 2;
      } else {
        i = i + 1;
      }
    } else {
      field = field.append(s[i] as u8);
      seen = true;
      i = i + 1;
    }
  }
  if (seen || field.len() > 0 || record.len() > 0) {
    record = record.append(string_from_bytes_unchecked(field));
    rows = rows.append(record);
  }
  return rows;
}

pub function csv_serialize(rows: string[][]): string {
  let lines: string[] = [];
  for row in rows {
    lines = lines.append(csv_join(row));
  }
  return lines.join("\r\n");
}
