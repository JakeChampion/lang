// std/csv — CSV escape / join / single-line parse (RFC 4180).
//
// `csv_escape(s)` quotes fields containing comma / quote /
// newline. `csv_join(arr)` joins after escaping each field.
// `csv_parse_line(s)` parses ONE CSV record (no embedded
// newline support — multi-line records left for a richer
// follow-up).
//
// No prelude: these are in scope only after a program
// declares `import "std/csv";` (docs/PRELUDE-TO-MODULES.md,
// Phase 5).

// Dispatches (string) `.index_of()` / `.replace()` on field
// contents — declare std/string so the receiver methods register
// under no-prelude.
import "std/string";

// === CSV escape / join ===
//
// `csv_escape(s)` — return a CSV field per RFC 4180. Fields
// containing comma / double-quote / newline get wrapped in
// "..." with interior quotes doubled. Other inputs pass
// through unchanged.
// `csv_join(arr)` — join with "," after escaping each field.
pub function csv_escape(s: string): string {
    if (s.index_of(",") < 0 && s.index_of("\"") < 0 &&
        s.index_of("\n") < 0 && s.index_of("\r") < 0) {
        return s;
    }
    return "\"" + s.replace("\"", "\"\"") + "\"";
}

pub function csv_join(arr: string[]): string {
    var n: i32 = arr.len();
    if (n == 0) { return ""; }
    // Two-pass exact-size buffer (#4379): the naive `out = out + csv_escape(…)`
    // recopied the whole growing record on every field — O(total²). csv_escape
    // is a pure O(len) transform, so a sizing pass that escapes once per field
    // (plus the `,` separators) stays O(total) overall, then a fill pass
    // re-escapes into one __alloc_u8 buffer. Byte-for-byte identical output.
    var total: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        if (i > 0) { total = total + 1; }       // ","
        total = total + csv_escape(arr[i]).len();
        i = i + 1;
    }
    var buf: u8[] = __alloc_u8(total);
    var pos: i32 = 0;
    i = 0;
    while (i < n) {
        if (i > 0) { buf = buf.with(pos, 44 as u8); pos = pos + 1; }   // ','
        var f: string = csv_escape(arr[i]);
        var fl: i32 = f.len();
        var j: i32 = 0;
        while (j < fl) { buf = buf.with(pos, f[j] as u8); pos = pos + 1; j = j + 1; }
        i = i + 1;
    }
    return string_from_bytes_unchecked(buf);
}

// `csv_parse_line(s)` — RFC 4180 parser for a single line.
// Splits on `,`, but a field wrapped in `"..."` may contain
// commas / newlines, and `""` inside a quoted field decodes
// to a single `"`. Returns the field list with quotes
// stripped + escapes unescaped. Newlines in the input
// terminate the line — parsing a multi-line CSV requires
// pre-splitting on \n EXCEPT inside quoted fields, which
// is a more complex parser left for a follow-up. For the
// common single-line case (CSV header / a single record)
// this helper covers the surface.
pub function csv_parse_line(s: string): string[] {
    var out: string[] = [];
    var n: i32 = s.len();
    var i: i32 = 0;
    // Build each field in a growable u8[] rather than `field = field + s[i:i+1]`
    // (#4379): the char-at-a-time concat recopied the whole growing field on
    // every byte -- O(field²). A local u8[] append grows in place (amortized
    // O(1)); string_from_bytes_unchecked materialises the field when it terminates. Byte
    // indexing keeps the UTF-8-agnostic behaviour of the old 1-byte slices.
    var field: u8[] = [];
    var in_quotes: boolean = false;
    while (i < n) {
        var c: i32 = s[i] as i32;
        if (in_quotes) {
            if (c == 34) {
                // Doubled quote → literal "
                if (i + 1 < n && s[i + 1] == 34) {
                    field = field.append(34 as u8);
                    i = i + 2;
                } else {
                    in_quotes = false;
                    i = i + 1;
                }
            } else {
                field = field.append(s[i] as u8);
                i = i + 1;
            }
        } else {
            if (c == 44) {
                out = out.append(string_from_bytes_unchecked(field));
                field = [];
                i = i + 1;
            } else if (c == 34 && field.len() == 0) {
                in_quotes = true;
                i = i + 1;
            } else {
                field = field.append(s[i] as u8);
                i = i + 1;
            }
        }
    }
    return out.append(string_from_bytes_unchecked(field));
}

// `csv_parse(s)` — a full RFC 4180 document parser: `s` may hold many
// records separated by `\n` or `\r\n`, and a field wrapped in `"..."`
// may contain commas AND newlines (a doubled `""` inside decodes to a
// literal `"`). Returns one `string[]` of fields per record. Unlike
// `csv_parse_line`, quote state is carried across line breaks, so a
// newline inside a quoted field does not end the record.
//
// A trailing record terminator does not yield a spurious empty final
// record (`"a\nb\n"` → 2 records, not 3); an empty input yields no
// records. Quotes are only special at the start of a field, matching
// `csv_parse_line`.
pub function csv_parse(s: string): string[][] {
    var rows: string[][] = [];
    var record: string[] = [];
    var field: u8[] = [];
    var in_quotes: boolean = false;
    var seen: boolean = false;   // consumed any content for the pending record
    var n: i32 = s.len();
    var i: i32 = 0;
    while (i < n) {
        var c: i32 = s[i] as i32;
        if (in_quotes) {
            if (c == 34) {
                if (i + 1 < n && s[i + 1] == 34) {
                    field = field.append(34 as u8);
                    i = i + 2;
                } else {
                    in_quotes = false;
                    i = i + 1;
                }
            } else {
                field = field.append(s[i] as u8);
                i = i + 1;
            }
        } else if (c == 34 && field.len() == 0) {
            in_quotes = true;
            seen = true;
            i = i + 1;
        } else if (c == 44) {
            record = record.append(string_from_bytes_unchecked(field));
            field = [];
            seen = true;
            i = i + 1;
        } else if (c == 10) {
            // `\n` ends the record.
            record = record.append(string_from_bytes_unchecked(field));
            field = [];
            rows = rows.append(record);
            record = [];
            seen = false;
            i = i + 1;
        } else if (c == 13) {
            // `\r` ends the record too; swallow a following `\n` (CRLF).
            record = record.append(string_from_bytes_unchecked(field));
            field = [];
            rows = rows.append(record);
            record = [];
            seen = false;
            if (i + 1 < n && s[i + 1] == 10) { i = i + 2; } else { i = i + 1; }
        } else {
            field = field.append(s[i] as u8);
            seen = true;
            i = i + 1;
        }
    }
    // Flush the final record unless the input ended exactly on a record
    // boundary (nothing pending after the last terminator).
    if (seen || field.len() > 0 || record.len() > 0) {
        record = record.append(string_from_bytes_unchecked(field));
        rows = rows.append(record);
    }
    return rows;
}

// `csv_serialize(rows)` — the inverse of `csv_parse`: escape + join each
// record's fields (via `csv_join`) and join the records with CRLF
// (`\r\n`, the RFC 4180 record separator). `csv_parse(csv_serialize(rs))`
// round-trips `rs`.
pub function csv_serialize(rows: string[][]): string {
    var lines: string[] = [];
    for row in rows {
        lines = lines.append(csv_join(row));
    }
    return lines.join("\r\n");
}
