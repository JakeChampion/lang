// std/ndarray — a multidimensional array as a counted handle over flat
// storage: shape, strides and offset, with the structural operations as
// metadata (#9734, phase 3 of #9727).
//
//   import "std/ndarray";
//   var a: ndarray.NdArray[i64] = ndarray.from_flat(xs, [64, 64]);
//   var t: ndarray.NdArray[i64] = a.transpose();   // no element moves
//   t.get([3, 5]) == a.get([5, 3]);
//   var r: ndarray.NdArray[i64] = t.reshape([4096]); // copies: t is not row-major
//
// # The representation
//
//   NdArray { data, shape, strides, offset }
//
// `data` is the flat storage, an ordinary owned `T[]`; `shape` the extent
// of each axis; `strides` the distance in ELEMENTS between neighbours
// along each axis (negative after `reverse`); `offset` the element
// `data[offset]` that index `[0, 0, …]` reads. Element `idx` lives at
// `offset + sum(idx[k] * strides[k])`.
//
// The handle is a value that OWNS a count on `data` — it is not a `[T]`
// view. docs/ARRAY-SHAPES.md says why: a structural result is stored and
// returned, and Fern's views are non-escaping by decision
// (docs/STR-VIEW-CONTRACT.md §5), so the thing that shares storage has to
// hold a reference the reuse guards can count.
//
// # Views and copies
//
// `transpose`, `permute`, `reverse`, `slice`, `select` and `broadcast_to`
// change only the metadata: they allocate a handle and two small index
// arrays, never an element. `reshape` is metadata when the handle is row-major and a copy
// otherwise; `packed` and `to_flat` copy exactly when the handle is not
// packed. That is the whole materialization rule, and
// internal/e2e/ndarray_test.go holds each operation to it with the
// allocation counters.
//
// # Elementwise, and along an axis
//
// `map` and `zip_with` are elementwise over the reading order and produce
// a packed handle; `zip_with` takes two handles whose shapes broadcast.
// `fold_all` folds the reading order; `reduce_axis` folds along one axis
// and drops it, `scan_axis` keeps it as the running prefix. Every fold is
// in increasing index order, which is what lets a float reduction along
// an axis mean one thing on every backend (docs/ARRAY-ALGEBRA.md §3).
//
// # Products
//
// `outer(b, f)` is `f` over every pair, as a handle of shape
// `a.shape() ++ b.shape()`: two broadcast views and one `zip_with`, so one
// buffer. `inner(b, init, mul, add)` contracts the LAST axis of `a`
// against the FIRST axis of `b` — the dot product of two vectors, the
// matrix product of two matrices, a matrix times a vector — as a handle
// of shape `a.shape()[:-1] ++ b.shape()[1:]`, each element the fold of
// `mul` over the contracted axis in increasing index order. The two
// contracted extents must be equal. The native compiler recognizes both
// by identity (docs/ARRAY-SHAPES.md §6) and `fern -array-report` names
// each site; the lowering is still the scalar loop below.
//
// # By rank
//
// `map_rank(k, f)` applies `f` to every rank-`k` CELL: the shape splits at
// `rank - k` into a leading FRAME and the cell, and the result is
// `frame ++ f's result shape`. Cells are views, so nothing is copied on
// the way in, and every cell result must have the same shape. With no
// cells the result is the empty handle of shape `frame`, since `f` never
// ran to say what a cell result looks like.
//
// # Broadcasting
//
// Two shapes broadcast when, aligned at their LAST axes, every pair of
// extents is equal or one of them is 1; the shorter shape is padded with
// leading 1s. The result takes the larger extent at each axis. A rank-0
// handle therefore broadcasts against anything, and a row `[n]` against
// a matrix `[m, n]`. `broadcast_to` is metadata: a stretched axis gets
// stride 0, so the one element is read `n` times and nothing is copied.
//
// # Errors
//
// A shape that does not fit its storage, an axis or index out of range,
// a permutation that is not one, or two shapes that do not broadcast aborts
// the program with the bounds rule's status (docs/ARRAY-BOUNDS.md, exit
// 134): a derived shape that is wrong is a bug, and docs/ARRAY-ALGEBRA.md
// §4 makes it an error rather than a truncation.

// The handle. Construct one through `from_flat`; every field is an
// implementation detail.
pub struct NdArray[T] { data: T[], shape: i32[], strides: i32[], offset: i32 }

// A precondition failed: the same trap an out-of-range index takes.
function shape_error(): void {
    exit(134);
}

// A shape is a list of non-negative extents whose product fits an i32,
// since that product is an index into storage; anything else aborts.
function check_shape(shape: i32[]): void {
    var n: i32 = 1;
    var k: i32 = 0;
    while (k < shape.len()) {
        if (shape[k] < 0) { shape_error(); }
        if (shape[k] != 0 && n > 2147483647 / shape[k]) { shape_error(); }
        n = n * shape[k];
        k = k + 1;
    }
}

// The element count a shape describes; 1 for the rank-0 shape.
function count_of(shape: i32[]): i32 {
    check_shape(shape);
    var n: i32 = 1;
    var k: i32 = 0;
    while (k < shape.len()) {
        n = n * shape[k];
        k = k + 1;
    }
    return n;
}

// Row-major strides: the last axis is contiguous.
function row_major(shape: i32[]): i32[] {
    var out: i32[] = [];
    var k: i32 = 0;
    while (k < shape.len()) {
        out = out.append(0);
        k = k + 1;
    }
    var s: i32 = 1;
    k = shape.len() - 1;
    while (k >= 0) {
        out = out.with(k, s);
        s = s * shape[k];
        k = k - 1;
    }
    return out;
}

// `from_flat(data, shape)` — the array whose row-major reading is `data`.
// `data` is shared, not copied. The shape must account for every element
// of `data`; `[]` is a rank-0 scalar over a one-element `data`.
pub function from_flat[T](data: T[], shape: i32[]): NdArray[T] {
    if (count_of(shape) != data.len()) { shape_error(); }
    return NdArray { data: data, shape: shape, strides: row_major(shape), offset: 0 };
}

pub function (a: NdArray[T]) shape(): i32[] {
    return a.shape;
}

pub function (a: NdArray[T]) strides(): i32[] {
    return a.strides;
}

pub function (a: NdArray[T]) rank(): i32 {
    return a.shape.len();
}

// The element count.
pub function (a: NdArray[T]) len(): i32 {
    return count_of(a.shape);
}

// `is_row_major()` — the strides are the row-major ones for the shape,
// so `reshape` needs no copy. An axis of extent 1 has no neighbour along
// it and its stride does not count.
pub function (a: NdArray[T]) is_row_major(): boolean {
    var rm: i32[] = row_major(a.shape);
    var k: i32 = 0;
    while (k < a.shape.len()) {
        if (a.shape[k] != 1 && a.strides[k] != rm[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// `is_packed()` — row-major from element 0 with nothing else in the
// storage: `data` IS the row-major reading, so `to_flat` needs no copy.
pub function (a: NdArray[T]) is_packed(): boolean {
    return a.is_row_major() && a.offset == 0 && a.data.len() == a.len();
}

// The storage index of `idx`, checking the rank and every bound.
function addr[T](a: NdArray[T], idx: i32[]): i32 {
    if (idx.len() != a.shape.len()) { shape_error(); }
    var at: i32 = a.offset;
    var k: i32 = 0;
    while (k < idx.len()) {
        if (idx[k] < 0 || idx[k] >= a.shape[k]) { shape_error(); }
        at = at + idx[k] * a.strides[k];
        k = k + 1;
    }
    return at;
}

// `get(idx)` — the element at a full index. A rank-0 array is read with
// `get([])`.
pub function (a: NdArray[T]) get(idx: i32[]): T {
    return a.data[addr(a, idx)];
}

function check_axis[T](a: NdArray[T], axis: i32): void {
    if (axis < 0 || axis >= a.shape.len()) { shape_error(); }
}

// `transpose()` — the axes in reverse order. Metadata only.
pub function (a: NdArray[T]) transpose(): NdArray[T] {
    var axes: i32[] = [];
    var k: i32 = a.shape.len() - 1;
    while (k >= 0) {
        axes = axes.append(k);
        k = k - 1;
    }
    return a.permute(axes);
}

// `permute(axes)` — axis `k` of the result is axis `axes[k]` of `a`.
// `axes` must be a permutation of `0 .. rank - 1`. Metadata only.
pub function (a: NdArray[T]) permute(axes: i32[]): NdArray[T] {
    if (axes.len() != a.shape.len()) { shape_error(); }
    var seen: boolean[] = [];
    var shape: i32[] = [];
    var strides: i32[] = [];
    var k: i32 = 0;
    while (k < axes.len()) {
        seen = seen.append(false);
        k = k + 1;
    }
    k = 0;
    while (k < axes.len()) {
        check_axis(a, axes[k]);
        if (seen[axes[k]]) { shape_error(); }
        seen = seen.with(axes[k], true);
        shape = shape.append(a.shape[axes[k]]);
        strides = strides.append(a.strides[axes[k]]);
        k = k + 1;
    }
    return NdArray { data: a.data, shape: shape, strides: strides, offset: a.offset };
}

// `reverse(axis)` — the elements along `axis` in the opposite order: the
// stride flips sign and the offset moves to the old last element.
// Metadata only.
pub function (a: NdArray[T]) reverse(axis: i32): NdArray[T] {
    check_axis(a, axis);
    var n: i32 = a.shape[axis];
    var s: i32 = a.strides[axis];
    var offset: i32 = a.offset;
    if (n > 0) { offset = offset + (n - 1) * s; }
    return NdArray { data: a.data, shape: a.shape, strides: a.strides.with(axis, 0 - s), offset: offset };
}

// `slice(axis, lo, hi)` — the half-open range `[lo, hi)` along `axis`,
// with `0 <= lo <= hi <= extent`; the other axes are unchanged. Metadata
// only.
pub function (a: NdArray[T]) slice(axis: i32, lo: i32, hi: i32): NdArray[T] {
    check_axis(a, axis);
    if (lo < 0 || lo > hi || hi > a.shape[axis]) { shape_error(); }
    var offset: i32 = a.offset + lo * a.strides[axis];
    return NdArray { data: a.data, shape: a.shape.with(axis, hi - lo), strides: a.strides, offset: offset };
}

// `select(axis, i)` — the partial index: position `i` along `axis`, as an
// array of one rank less. Metadata only.
pub function (a: NdArray[T]) select(axis: i32, i: i32): NdArray[T] {
    check_axis(a, axis);
    if (i < 0 || i >= a.shape[axis]) { shape_error(); }
    var shape: i32[] = [];
    var strides: i32[] = [];
    var k: i32 = 0;
    while (k < a.shape.len()) {
        if (k != axis) {
            shape = shape.append(a.shape[k]);
            strides = strides.append(a.strides[k]);
        }
        k = k + 1;
    }
    return NdArray { data: a.data, shape: shape, strides: strides, offset: a.offset + i * a.strides[axis] };
}

// `reshape(shape)` — the same elements, in row-major reading order, under
// a shape of the same count. Metadata when `a.is_row_major()`; otherwise
// the elements are copied into packed storage first, which is the one
// structural operation whose cost depends on what came before it — ask
// `is_row_major()` when that matters.
pub function (a: NdArray[T]) reshape(shape: i32[]): NdArray[T] {
    if (count_of(shape) != a.len()) { shape_error(); }
    if (a.is_row_major()) {
        return NdArray { data: a.data, shape: shape, strides: row_major(shape), offset: a.offset };
    }
    return from_flat(copy_flat(a), shape);
}

// `packed()` — `a` itself when it is packed, otherwise a fresh packed
// copy with the same shape.
pub function (a: NdArray[T]) packed(): NdArray[T] {
    if (a.is_packed()) { return a; }
    return from_flat(copy_flat(a), a.shape);
}

// `to_flat()` — the elements in row-major reading order: the storage
// itself when `a` is packed, otherwise a fresh copy.
pub function (a: NdArray[T]) to_flat(): T[] {
    if (a.is_packed()) { return a.data; }
    return copy_flat(a);
}

// ---- elementwise, and along an axis ----------------------------------------

// The storage index of an in-range `idx`: the walkers below hand it one
// from the odometer, so nothing is checked again.
function addr_of[T](a: NdArray[T], idx: i32[]): i32 {
    var at: i32 = a.offset;
    var k: i32 = 0;
    while (k < idx.len()) {
        at = at + idx[k] * a.strides[k];
        k = k + 1;
    }
    return at;
}

function zeros(rank: i32): i32[] {
    var idx: i32[] = [];
    var k: i32 = 0;
    while (k < rank) {
        idx = idx.append(0);
        k = k + 1;
    }
    return idx;
}

// `map(f)` — `f` applied to every element, in reading order, as a packed
// handle of the same shape. One buffer is allocated.
pub function (a: NdArray[T]) map[T, U](f: (T) => U): NdArray[U] {
    if (a.is_packed()) { return from_flat(packed_map(a.data, f), a.shape); }
    var out: U[] = [];
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        out = out.append(f(a.data[addr_of(a, idx)]));
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return from_flat(out, a.shape);
}

// A packed handle's `data` IS the reading order (§2), so the odometer has
// nothing to compute: element `i` of the walk is `data[i]`. Measured at 2.97x
// on a 20,000-element f64 handle — 23 ns per element of `addr_of` and `bump`
// that a packed walk does not owe, and that is the whole cost for every
// shape the scale kernel of #9735 cannot take.
function packed_map[T, U](data: T[], f: (T) => U): U[] {
    var out: U[] = [];
    var n: i32 = data.len();
    var i: i32 = 0;
    while (i < n) {
        out = out.append(f(data[i]));
        i = i + 1;
    }
    return out;
}

function same_shape(x: i32[], y: i32[]): boolean {
    if (x.len() != y.len()) { return false; }
    var k: i32 = 0;
    while (k < x.len()) {
        if (x[k] != y[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// `broadcast_shape(x, y)` — the shape two shapes broadcast to, aligned
// at their last axes: each pair of extents must be equal or one of them
// 1, and the result takes the larger. Two shapes that do not broadcast
// abort: both are derived, and docs/ARRAY-ALGEBRA.md §4 rules that out
// as an error rather than a truncation.
pub function broadcast_shape(x: i32[], y: i32[]): i32[] {
    check_shape(x);
    check_shape(y);
    var rank: i32 = x.len();
    if (y.len() > rank) { rank = y.len(); }
    var out: i32[] = zeros(rank);
    var k: i32 = 0;
    while (k < rank) {
        var ex: i32 = 1;
        var ey: i32 = 1;
        if (k >= rank - x.len()) { ex = x[k - (rank - x.len())]; }
        if (k >= rank - y.len()) { ey = y[k - (rank - y.len())]; }
        if (ex == ey || ey == 1) {
            out = out.with(k, ex);
        } else if (ex == 1) {
            out = out.with(k, ey);
        } else {
            shape_error();
        }
        k = k + 1;
    }
    check_shape(out);
    return out;
}

// `broadcast_to(shape)` — `a` read as a handle of `shape`, which must be
// what `a.shape()` broadcasts to: every axis of `a` matches the trailing
// axis of `shape` it aligns with or has extent 1. A stretched axis gets
// stride 0, so the same element is read along it. Metadata only.
pub function (a: NdArray[T]) broadcast_to(shape: i32[]): NdArray[T] {
    check_shape(shape);
    var pad: i32 = shape.len() - a.shape.len();
    if (pad < 0) { shape_error(); }
    var strides: i32[] = zeros(shape.len());
    var k: i32 = 0;
    while (k < a.shape.len()) {
        if (a.shape[k] == shape[pad + k]) {
            strides = strides.with(pad + k, a.strides[k]);
        } else if (a.shape[k] != 1) {
            shape_error();
        }
        k = k + 1;
    }
    return NdArray { data: a.data, shape: shape, strides: strides, offset: a.offset };
}

// `zip_with(b, f)` — `f` over corresponding elements of two handles
// whose shapes broadcast, as a packed handle of the broadcast shape.
// Two shapes that do not broadcast abort.
pub function (a: NdArray[T]) zip_with[T, U, V](b: NdArray[U], f: (T, U) => V): NdArray[V] {
    var shape: i32[] = broadcast_shape(a.shape, b.shape);
    var x: NdArray[T] = a;
    var y: NdArray[U] = b;
    if (!same_shape(a.shape, shape)) { x = a.broadcast_to(shape); }
    if (!same_shape(b.shape, shape)) { y = b.broadcast_to(shape); }
    if (x.is_packed() && y.is_packed()) { return from_flat(packed_zip(x.data, y.data, f), shape); }
    var out: V[] = [];
    var n: i32 = count_of(shape);
    var idx: i32[] = zeros(shape.len());
    var i: i32 = 0;
    while (i < n) {
        out = out.append(f(x.data[addr_of(x, idx)], y.data[addr_of(y, idx)]));
        idx = bump(idx, shape);
        i = i + 1;
    }
    return from_flat(out, shape);
}

// Both operands packed means each `data` IS the reading order (§2), so the
// odometer has nothing to compute: element `i` pairs `x[i]` with `y[i]`. The
// gate is asked AFTER the broadcast step, which is sufficient on its own: a
// broadcast that would change the reading order gives an axis of extent above
// 1 a stride of 0 and so fails `is_packed`, while one that only prepends
// extent-1 axes keeps it and leaves the order alone.
function packed_zip[T, U, V](x: T[], y: U[], f: (T, U) => V): V[] {
    var out: V[] = [];
    var n: i32 = x.len();
    var i: i32 = 0;
    while (i < n) {
        out = out.append(f(x[i], y[i]));
        i = i + 1;
    }
    return out;
}

// `outer(b, f)` — `f` over every pair of elements, as a packed handle of
// shape `a.shape() ++ b.shape()`: element `[i.., j..]` is
// `f(a.get(i..), b.get(j..))`. Each operand is read through a broadcast
// view, so one buffer is allocated.
pub function (a: NdArray[T]) outer[T, U, V](b: NdArray[U], f: (T, U) => V): NdArray[V] {
    var ra: i32 = a.shape.len();
    var rb: i32 = b.shape.len();
    var shape: i32[] = join(a.shape, b.shape);
    check_shape(shape);
    var x: NdArray[T] = NdArray { data: a.data, shape: join(a.shape, ones(rb)), strides: join(a.strides, zeros(rb)), offset: a.offset };
    var y: NdArray[U] = NdArray { data: b.data, shape: join(ones(ra), b.shape), strides: join(zeros(ra), b.strides), offset: b.offset };
    return x.zip_with(y, f);
}

// `x` followed by `y`.
function join(x: i32[], y: i32[]): i32[] {
    var out: i32[] = [];
    var k: i32 = 0;
    while (k < x.len()) {
        out = out.append(x[k]);
        k = k + 1;
    }
    k = 0;
    while (k < y.len()) {
        out = out.append(y[k]);
        k = k + 1;
    }
    return out;
}

function ones(rank: i32): i32[] {
    var out: i32[] = [];
    var k: i32 = 0;
    while (k < rank) {
        out = out.append(1);
        k = k + 1;
    }
    return out;
}

// The storage index of the leading `count` positions of `idx` read
// against `a`'s axes from `from`.
function base_of[T](a: NdArray[T], idx: i32[], idx_from: i32, axis_from: i32, count: i32): i32 {
    var at: i32 = a.offset;
    var k: i32 = 0;
    while (k < count) {
        at = at + idx[idx_from + k] * a.strides[axis_from + k];
        k = k + 1;
    }
    return at;
}

// `inner(b, init, mul, add)` — the last axis of `a` contracted against
// the first axis of `b`: a packed handle of shape
// `a.shape()[:-1] ++ b.shape()[1:]` whose every element is
// `add` folded from `init` over `mul(a[.., k], b[k, ..])` in increasing
// `k`. The dot product of two vectors is a rank-0 handle; two matrices
// give their product; a matrix and a vector give a vector. Both operands
// must have rank at least 1 and the two contracted extents must be
// equal; anything else aborts.
pub function (a: NdArray[T]) inner[T, A](b: NdArray[T], init: A, mul: (T, T) => A, add: (A, A) => A): NdArray[A] {
    var ra: i32 = a.shape.len();
    var rb: i32 = b.shape.len();
    if (ra < 1 || rb < 1 || a.shape[ra - 1] != b.shape[0]) { shape_error(); }
    var n: i32 = a.shape[ra - 1];
    var sa: i32 = a.strides[ra - 1];
    var sb: i32 = b.strides[0];
    var shape: i32[] = join(drop_axis(a.shape, ra - 1), drop_axis(b.shape, 0));
    var out: A[] = [];
    var total: i32 = count_of(shape);
    var idx: i32[] = zeros(shape.len());
    var i: i32 = 0;
    while (i < total) {
        var pa: i32 = base_of(a, idx, 0, 0, ra - 1);
        var pb: i32 = base_of(b, idx, ra - 1, 1, rb - 1);
        var acc: A = init;
        var k: i32 = 0;
        while (k < n) {
            acc = add(acc, mul(a.data[pa + k * sa], b.data[pb + k * sb]));
            k = k + 1;
        }
        out = out.append(acc);
        idx = bump(idx, shape);
        i = i + 1;
    }
    return from_flat(out, shape);
}

// `fold_all(init, f)` — every element folded in reading order.
pub function (a: NdArray[T]) fold_all[T, A](init: A, f: (A, T) => A): A {
    if (a.is_packed()) { return packed_fold(a.data, init, f); }
    var acc: A = init;
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        acc = f(acc, a.data[addr_of(a, idx)]);
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return acc;
}

// The packed walk for `fold_all`, in the same reading order the odometer
// would have produced — which is what keeps AA-02 (§7's "every fold is in
// increasing index order") true of both arms.
function packed_fold[T, A](data: T[], init: A, f: (A, T) => A): A {
    var acc: A = init;
    var n: i32 = data.len();
    var i: i32 = 0;
    while (i < n) {
        acc = f(acc, data[i]);
        i = i + 1;
    }
    return acc;
}

// The shape with `axis` removed.
function drop_axis(shape: i32[], axis: i32): i32[] {
    var out: i32[] = [];
    var k: i32 = 0;
    while (k < shape.len()) {
        if (k != axis) { out = out.append(shape[k]); }
        k = k + 1;
    }
    return out;
}

// The lane a full index belongs to: its row-major position in the shape
// with `axis` removed. Every element of one lane differs only along
// `axis`, so a fold per lane is a fold along the axis.
function lane_of(idx: i32[], axis: i32, lane_strides: i32[]): i32 {
    var lane: i32 = 0;
    var k: i32 = 0;
    var j: i32 = 0;
    while (k < idx.len()) {
        if (k != axis) {
            lane = lane + idx[k] * lane_strides[j];
            j = j + 1;
        }
        k = k + 1;
    }
    return lane;
}

// One accumulator per lane, all `init`.
function lanes[A](count: i32, init: A): A[] {
    var accs: A[] = [];
    var i: i32 = 0;
    while (i < count) {
        accs = accs.append(init);
        i = i + 1;
    }
    return accs;
}

// The axis's own row-major stride, and the number of lanes ahead of it:
// the product of the extents after `axis`, and the product of those before.
function extent_after(shape: i32[], axis: i32): i32 {
    var s: i32 = 1;
    var k: i32 = axis + 1;
    while (k < shape.len()) {
        s = s * shape[k];
        k = k + 1;
    }
    return s;
}

function extent_before(shape: i32[], axis: i32): i32 {
    var s: i32 = 1;
    var k: i32 = 0;
    while (k < axis) {
        s = s * shape[k];
        k = k + 1;
    }
    return s;
}

// The packed walks for the two axis folds. A packed handle's `data` IS the
// reading order (§2), so three counters enumerate it directly — `h` over the
// axes before `axis`, `t` along it, `l` over those after — with the storage
// index advancing by one each step. The lane is `h * inner + l`, which is the
// row-major position in the shape with `axis` dropped, so neither `addr_of`
// nor `lane_of` nor `bump` is needed. `t` still increases for a fixed lane,
// which is what keeps §7's increasing index order along the axis true here.
function packed_reduce[T, A](data: T[], outer: i32, extent: i32, inner: i32, init: A, f: (A, T) => A): A[] {
    var accs: A[] = lanes(outer * inner, init);
    var i: i32 = 0;
    var h: i32 = 0;
    while (h < outer) {
        var base: i32 = h * inner;
        var t: i32 = 0;
        while (t < extent) {
            var l: i32 = 0;
            while (l < inner) {
                var lane: i32 = base + l;
                accs = accs.with(lane, f(accs[lane], data[i]));
                i = i + 1;
                l = l + 1;
            }
            t = t + 1;
        }
        h = h + 1;
    }
    return accs;
}

function packed_scan[T, A](data: T[], outer: i32, extent: i32, inner: i32, init: A, f: (A, T) => A): A[] {
    var accs: A[] = lanes(outer * inner, init);
    var out: A[] = [];
    var i: i32 = 0;
    var h: i32 = 0;
    while (h < outer) {
        var base: i32 = h * inner;
        var t: i32 = 0;
        while (t < extent) {
            var l: i32 = 0;
            while (l < inner) {
                var lane: i32 = base + l;
                var acc: A = f(accs[lane], data[i]);
                accs = accs.with(lane, acc);
                out = out.append(acc);
                i = i + 1;
                l = l + 1;
            }
            t = t + 1;
        }
        h = h + 1;
    }
    return out;
}

// `reduce_axis(axis, init, f)` — the fold along `axis`, in increasing
// index order, as a packed handle of one rank less: a rank-1 handle
// reduces to a rank-0 one. Every lane is folded in one reading-order
// walk, which visits each lane's elements in axis order.
pub function (a: NdArray[T]) reduce_axis[T, A](axis: i32, init: A, f: (A, T) => A): NdArray[A] {
    check_axis(a, axis);
    var rshape: i32[] = drop_axis(a.shape, axis);
    var lane_strides: i32[] = row_major(rshape);
    if (a.is_packed()) {
        return from_flat(packed_reduce(a.data, extent_before(a.shape, axis), a.shape[axis],
            extent_after(a.shape, axis), init, f), rshape);
    }
    var accs: A[] = lanes(count_of(rshape), init);
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        var lane: i32 = lane_of(idx, axis, lane_strides);
        accs = accs.with(lane, f(accs[lane], a.data[addr_of(a, idx)]));
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return from_flat(accs, rshape);
}

// `scan_axis(axis, init, f)` — the running fold along `axis`, in
// increasing index order, as a packed handle of the same shape: element
// `i` along the axis holds the fold of elements `0 .. i`.
pub function (a: NdArray[T]) scan_axis[T, A](axis: i32, init: A, f: (A, T) => A): NdArray[A] {
    check_axis(a, axis);
    var rshape: i32[] = drop_axis(a.shape, axis);
    var lane_strides: i32[] = row_major(rshape);
    if (a.is_packed()) {
        return from_flat(packed_scan(a.data, extent_before(a.shape, axis), a.shape[axis],
            extent_after(a.shape, axis), init, f), a.shape);
    }
    var accs: A[] = lanes(count_of(rshape), init);
    var out: A[] = [];
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        var lane: i32 = lane_of(idx, axis, lane_strides);
        var acc: A = f(accs[lane], a.data[addr_of(a, idx)]);
        accs = accs.with(lane, acc);
        out = out.append(acc);
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return from_flat(out, a.shape);
}

// `map_rank(k, f)` — `f` applied to every rank-`k` CELL of `a`. The shape
// splits at `rank - k`: the leading axes are the FRAME, the trailing `k`
// are the cell, and the result is the cells' results reassembled under
// `frame ++ f's result shape`. APL's rank operator, without the glyph
// (#9735 step 5).
//
// `k == rank` is one cell, the whole handle; `k == 0` makes every element
// its own rank-0 cell, which is `map` with the element boxed. Neither is
// special-cased — they fall out of the split.
//
// Each cell is a VIEW, peeled by selecting the frame's leading axis once
// per frame axis, so no element is copied on the way in. What `f` returns
// is read in row-major order, so a cell result that is not packed costs
// its own copy and nothing else does.
//
// Every cell's result must have the SAME shape — the frame cannot be
// joined to a ragged set of cells — and one that differs from the first
// aborts, per the error rule above.
//
// With NO cells, some frame extent being 0, `f` never runs and there is
// no cell result shape to learn, so the result is the empty handle of
// shape `frame` rather than of `frame ++ something`. That is the one
// place the result's RANK depends on the input's extents rather than on
// its shape alone.
pub function (a: NdArray[T]) map_rank[T, U](k: i32, f: (NdArray[T]) => NdArray[U]): NdArray[U] {
    if (k < 0 || k > a.shape.len()) { shape_error(); }
    var fr: i32 = a.shape.len() - k;
    var frame: i32[] = [];
    var j: i32 = 0;
    while (j < fr) {
        frame = frame.append(a.shape[j]);
        j = j + 1;
    }
    var cells: i32 = count_of(frame);
    var out: U[] = [];
    var cshape: i32[] = [];
    var idx: i32[] = zeros(fr);
    // A packed handle's cells are contiguous runs in reading order, so the
    // cell at frame index `i` is this handle with its offset moved to
    // `i * csize` — the same shape and strides every time. Building those
    // once and varying only the offset replaces a chain of `fr` selects,
    // each of which allocated a fresh shape and strides pair.
    //
    // The strides are SLICED from `a`, not recomputed as the row-major ones
    // for the cell shape: `is_row_major` skips extent-1 axes, so a packed
    // handle may carry a non-canonical stride on one (reverse of an extent-1
    // axis leaves it packed). No element read steps along such an axis, but
    // `strides()` is public, and the chain this replaces exposed `a`'s value.
    var packed: boolean = a.is_packed();
    var cshape_in: i32[] = [];
    var cstrides: i32[] = [];
    var q: i32 = fr;
    while (q < a.shape.len()) {
        cshape_in = cshape_in.append(a.shape[q]);
        cstrides = cstrides.append(a.strides[q]);
        q = q + 1;
    }
    var csize: i32 = count_of(cshape_in);
    var i: i32 = 0;
    while (i < cells) {
        // Selecting axis 0 drops it, so `fr` selections leave the rank-k
        // cell at this frame index.
        var cell: NdArray[T] = a;
        if (packed) {
            cell = NdArray { data: a.data, shape: cshape_in, strides: cstrides, offset: i * csize };
        } else {
            var d: i32 = 0;
            while (d < fr) {
                cell = cell.select(0, idx[d]);
                d = d + 1;
            }
            idx = bump(idx, frame);
        }
        var r: NdArray[U] = f(cell);
        if (i == 0) {
            cshape = r.shape();
        } else {
            if (!same_shape(r.shape(), cshape)) { shape_error(); }
        }
        var flat: U[] = r.to_flat();
        var m: i32 = 0;
        while (m < flat.len()) {
            out = out.append(flat[m]);
            m = m + 1;
        }
        i = i + 1;
    }
    return from_flat(out, join(frame, cshape));
}

// The row-major reading of `a`, walked with an odometer over the shape.
function copy_flat[T](a: NdArray[T]): T[] {
    var out: T[] = [];
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        out = out.append(a.data[addr_of(a, idx)]);
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return out;
}

// The next index in row-major order: the last axis moves fastest. `idx`
// is consumed so the writes land in place; borrowed, every step would
// copy it.
function bump(own idx: i32[], shape: i32[]): i32[] {
    var k: i32 = shape.len() - 1;
    while (k >= 0) {
        if (idx[k] + 1 < shape[k]) { return idx.with(k, idx[k] + 1); }
        idx = idx.with(k, 0);
        k = k - 1;
    }
    return idx;
}
