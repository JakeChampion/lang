// std/ndarray — a multidimensional array as a counted handle over flat
// storage: shape, strides and offset, with the structural operations as
// metadata (#9734, phase 3 of #9727).
//
//   import "std/ndarray";
//   var a: ndarray.NdArray[i64] = ndarray.from_flat(xs, [64, 64]);
//   var t: ndarray.NdArray[i64] = a.transpose();   // no element moves
//   t.get([3, 5]) == a.get([5, 3]);
//   var r: ndarray.NdArray[i64] = t.reshape([4096]); // copies: t is not row-major
//
// # The representation
//
//   NdArray { data, shape, strides, offset }
//
// `data` is the flat storage, an ordinary owned `T[]`; `shape` the extent
// of each axis; `strides` the distance in ELEMENTS between neighbours
// along each axis (negative after `reverse`); `offset` the element
// `data[offset]` that index `[0, 0, …]` reads. Element `idx` lives at
// `offset + sum(idx[k] * strides[k])`.
//
// The handle is a value that OWNS a count on `data` — it is not a `[T]`
// view. docs/ARRAY-SHAPES.md says why: a structural result is stored and
// returned, and Fern's views are non-escaping by decision
// (docs/STR-VIEW-CONTRACT.md §5), so the thing that shares storage has to
// hold a reference the reuse guards can count.
//
// # Views and copies
//
// `transpose`, `permute`, `reverse`, `slice`, `select` and `broadcast_to`
// change only the metadata: they allocate a handle and two small index
// arrays, never an element. `reshape` is metadata when the handle is row-major and a copy
// otherwise; `packed` and `to_flat` copy exactly when the handle is not
// packed. That is the whole materialization rule, and
// internal/e2e/ndarray_test.go holds each operation to it with the
// allocation counters.
//
// # Elementwise, and along an axis
//
// `map` and `zip_with` are elementwise over the reading order and produce
// a packed handle; `zip_with` takes two handles whose shapes broadcast.
// `fold_all` folds the reading order; `reduce_axis` folds along one axis
// and drops it, `scan_axis` keeps it as the running prefix. Every fold is
// in increasing index order, which is what lets a float reduction along
// an axis mean one thing on every backend (docs/ARRAY-ALGEBRA.md §3).
//
// # Broadcasting
//
// Two shapes broadcast when, aligned at their LAST axes, every pair of
// extents is equal or one of them is 1; the shorter shape is padded with
// leading 1s. The result takes the larger extent at each axis. A rank-0
// handle therefore broadcasts against anything, and a row `[n]` against
// a matrix `[m, n]`. `broadcast_to` is metadata: a stretched axis gets
// stride 0, so the one element is read `n` times and nothing is copied.
//
// # Errors
//
// A shape that does not fit its storage, an axis or index out of range,
// a permutation that is not one, or two shapes that do not broadcast aborts
// the program with the bounds rule's status (docs/ARRAY-BOUNDS.md, exit
// 134): a derived shape that is wrong is a bug, and docs/ARRAY-ALGEBRA.md
// §4 makes it an error rather than a truncation.

// The handle. Construct one through `from_flat`; every field is an
// implementation detail.
pub struct NdArray[T] { data: T[], shape: i32[], strides: i32[], offset: i32 }

// A precondition failed: the same trap an out-of-range index takes.
function shape_error(): void {
    exit(134);
}

// A shape is a list of non-negative extents whose product fits an i32,
// since that product is an index into storage; anything else aborts.
function check_shape(shape: i32[]): void {
    var n: i32 = 1;
    var k: i32 = 0;
    while (k < shape.len()) {
        if (shape[k] < 0) { shape_error(); }
        if (shape[k] != 0 && n > 2147483647 / shape[k]) { shape_error(); }
        n = n * shape[k];
        k = k + 1;
    }
}

// The element count a shape describes; 1 for the rank-0 shape.
function count_of(shape: i32[]): i32 {
    check_shape(shape);
    var n: i32 = 1;
    var k: i32 = 0;
    while (k < shape.len()) {
        n = n * shape[k];
        k = k + 1;
    }
    return n;
}

// Row-major strides: the last axis is contiguous.
function row_major(shape: i32[]): i32[] {
    var out: i32[] = [];
    var k: i32 = 0;
    while (k < shape.len()) {
        out = out.append(0);
        k = k + 1;
    }
    var s: i32 = 1;
    k = shape.len() - 1;
    while (k >= 0) {
        out = out.with(k, s);
        s = s * shape[k];
        k = k - 1;
    }
    return out;
}

// `from_flat(data, shape)` — the array whose row-major reading is `data`.
// `data` is shared, not copied. The shape must account for every element
// of `data`; `[]` is a rank-0 scalar over a one-element `data`.
pub function from_flat[T](data: T[], shape: i32[]): NdArray[T] {
    if (count_of(shape) != data.len()) { shape_error(); }
    return NdArray { data: data, shape: shape, strides: row_major(shape), offset: 0 };
}

pub function (a: NdArray[T]) shape(): i32[] {
    return a.shape;
}

pub function (a: NdArray[T]) strides(): i32[] {
    return a.strides;
}

pub function (a: NdArray[T]) rank(): i32 {
    return a.shape.len();
}

// The element count.
pub function (a: NdArray[T]) len(): i32 {
    return count_of(a.shape);
}

// `is_row_major()` — the strides are the row-major ones for the shape,
// so `reshape` needs no copy. An axis of extent 1 has no neighbour along
// it and its stride does not count.
pub function (a: NdArray[T]) is_row_major(): boolean {
    var rm: i32[] = row_major(a.shape);
    var k: i32 = 0;
    while (k < a.shape.len()) {
        if (a.shape[k] != 1 && a.strides[k] != rm[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// `is_packed()` — row-major from element 0 with nothing else in the
// storage: `data` IS the row-major reading, so `to_flat` needs no copy.
pub function (a: NdArray[T]) is_packed(): boolean {
    return a.is_row_major() && a.offset == 0 && a.data.len() == a.len();
}

// The storage index of `idx`, checking the rank and every bound.
function addr[T](a: NdArray[T], idx: i32[]): i32 {
    if (idx.len() != a.shape.len()) { shape_error(); }
    var at: i32 = a.offset;
    var k: i32 = 0;
    while (k < idx.len()) {
        if (idx[k] < 0 || idx[k] >= a.shape[k]) { shape_error(); }
        at = at + idx[k] * a.strides[k];
        k = k + 1;
    }
    return at;
}

// `get(idx)` — the element at a full index. A rank-0 array is read with
// `get([])`.
pub function (a: NdArray[T]) get(idx: i32[]): T {
    return a.data[addr(a, idx)];
}

function check_axis[T](a: NdArray[T], axis: i32): void {
    if (axis < 0 || axis >= a.shape.len()) { shape_error(); }
}

// `transpose()` — the axes in reverse order. Metadata only.
pub function (a: NdArray[T]) transpose(): NdArray[T] {
    var axes: i32[] = [];
    var k: i32 = a.shape.len() - 1;
    while (k >= 0) {
        axes = axes.append(k);
        k = k - 1;
    }
    return a.permute(axes);
}

// `permute(axes)` — axis `k` of the result is axis `axes[k]` of `a`.
// `axes` must be a permutation of `0 .. rank - 1`. Metadata only.
pub function (a: NdArray[T]) permute(axes: i32[]): NdArray[T] {
    if (axes.len() != a.shape.len()) { shape_error(); }
    var seen: boolean[] = [];
    var shape: i32[] = [];
    var strides: i32[] = [];
    var k: i32 = 0;
    while (k < axes.len()) {
        seen = seen.append(false);
        k = k + 1;
    }
    k = 0;
    while (k < axes.len()) {
        check_axis(a, axes[k]);
        if (seen[axes[k]]) { shape_error(); }
        seen = seen.with(axes[k], true);
        shape = shape.append(a.shape[axes[k]]);
        strides = strides.append(a.strides[axes[k]]);
        k = k + 1;
    }
    return NdArray { data: a.data, shape: shape, strides: strides, offset: a.offset };
}

// `reverse(axis)` — the elements along `axis` in the opposite order: the
// stride flips sign and the offset moves to the old last element.
// Metadata only.
pub function (a: NdArray[T]) reverse(axis: i32): NdArray[T] {
    check_axis(a, axis);
    var n: i32 = a.shape[axis];
    var s: i32 = a.strides[axis];
    var offset: i32 = a.offset;
    if (n > 0) { offset = offset + (n - 1) * s; }
    return NdArray { data: a.data, shape: a.shape, strides: a.strides.with(axis, 0 - s), offset: offset };
}

// `slice(axis, lo, hi)` — the half-open range `[lo, hi)` along `axis`,
// with `0 <= lo <= hi <= extent`; the other axes are unchanged. Metadata
// only.
pub function (a: NdArray[T]) slice(axis: i32, lo: i32, hi: i32): NdArray[T] {
    check_axis(a, axis);
    if (lo < 0 || lo > hi || hi > a.shape[axis]) { shape_error(); }
    var offset: i32 = a.offset + lo * a.strides[axis];
    return NdArray { data: a.data, shape: a.shape.with(axis, hi - lo), strides: a.strides, offset: offset };
}

// `select(axis, i)` — the partial index: position `i` along `axis`, as an
// array of one rank less. Metadata only.
pub function (a: NdArray[T]) select(axis: i32, i: i32): NdArray[T] {
    check_axis(a, axis);
    if (i < 0 || i >= a.shape[axis]) { shape_error(); }
    var shape: i32[] = [];
    var strides: i32[] = [];
    var k: i32 = 0;
    while (k < a.shape.len()) {
        if (k != axis) {
            shape = shape.append(a.shape[k]);
            strides = strides.append(a.strides[k]);
        }
        k = k + 1;
    }
    return NdArray { data: a.data, shape: shape, strides: strides, offset: a.offset + i * a.strides[axis] };
}

// `reshape(shape)` — the same elements, in row-major reading order, under
// a shape of the same count. Metadata when `a.is_row_major()`; otherwise
// the elements are copied into packed storage first, which is the one
// structural operation whose cost depends on what came before it — ask
// `is_row_major()` when that matters.
pub function (a: NdArray[T]) reshape(shape: i32[]): NdArray[T] {
    if (count_of(shape) != a.len()) { shape_error(); }
    if (a.is_row_major()) {
        return NdArray { data: a.data, shape: shape, strides: row_major(shape), offset: a.offset };
    }
    return from_flat(copy_flat(a), shape);
}

// `packed()` — `a` itself when it is packed, otherwise a fresh packed
// copy with the same shape.
pub function (a: NdArray[T]) packed(): NdArray[T] {
    if (a.is_packed()) { return a; }
    return from_flat(copy_flat(a), a.shape);
}

// `to_flat()` — the elements in row-major reading order: the storage
// itself when `a` is packed, otherwise a fresh copy.
pub function (a: NdArray[T]) to_flat(): T[] {
    if (a.is_packed()) { return a.data; }
    return copy_flat(a);
}

// ---- elementwise, and along an axis ----------------------------------------

// The storage index of an in-range `idx`: the walkers below hand it one
// from the odometer, so nothing is checked again.
function addr_of[T](a: NdArray[T], idx: i32[]): i32 {
    var at: i32 = a.offset;
    var k: i32 = 0;
    while (k < idx.len()) {
        at = at + idx[k] * a.strides[k];
        k = k + 1;
    }
    return at;
}

function zeros(rank: i32): i32[] {
    var idx: i32[] = [];
    var k: i32 = 0;
    while (k < rank) {
        idx = idx.append(0);
        k = k + 1;
    }
    return idx;
}

// `map(f)` — `f` applied to every element, in reading order, as a packed
// handle of the same shape. One buffer is allocated.
pub function (a: NdArray[T]) map[T, U](f: (T) => U): NdArray[U] {
    var out: U[] = [];
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        out = out.append(f(a.data[addr_of(a, idx)]));
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return from_flat(out, a.shape);
}

function same_shape(x: i32[], y: i32[]): boolean {
    if (x.len() != y.len()) { return false; }
    var k: i32 = 0;
    while (k < x.len()) {
        if (x[k] != y[k]) { return false; }
        k = k + 1;
    }
    return true;
}

// `broadcast_shape(x, y)` — the shape two shapes broadcast to, aligned
// at their last axes: each pair of extents must be equal or one of them
// 1, and the result takes the larger. Two shapes that do not broadcast
// abort: both are derived, and docs/ARRAY-ALGEBRA.md §4 rules that out
// as an error rather than a truncation.
pub function broadcast_shape(x: i32[], y: i32[]): i32[] {
    check_shape(x);
    check_shape(y);
    var rank: i32 = x.len();
    if (y.len() > rank) { rank = y.len(); }
    var out: i32[] = zeros(rank);
    var k: i32 = 0;
    while (k < rank) {
        var ex: i32 = 1;
        var ey: i32 = 1;
        if (k >= rank - x.len()) { ex = x[k - (rank - x.len())]; }
        if (k >= rank - y.len()) { ey = y[k - (rank - y.len())]; }
        if (ex == ey || ey == 1) {
            out = out.with(k, ex);
        } else if (ex == 1) {
            out = out.with(k, ey);
        } else {
            shape_error();
        }
        k = k + 1;
    }
    check_shape(out);
    return out;
}

// `broadcast_to(shape)` — `a` read as a handle of `shape`, which must be
// what `a.shape()` broadcasts to: every axis of `a` matches the trailing
// axis of `shape` it aligns with or has extent 1. A stretched axis gets
// stride 0, so the same element is read along it. Metadata only.
pub function (a: NdArray[T]) broadcast_to(shape: i32[]): NdArray[T] {
    check_shape(shape);
    var pad: i32 = shape.len() - a.shape.len();
    if (pad < 0) { shape_error(); }
    var strides: i32[] = zeros(shape.len());
    var k: i32 = 0;
    while (k < a.shape.len()) {
        if (a.shape[k] == shape[pad + k]) {
            strides = strides.with(pad + k, a.strides[k]);
        } else if (a.shape[k] != 1) {
            shape_error();
        }
        k = k + 1;
    }
    return NdArray { data: a.data, shape: shape, strides: strides, offset: a.offset };
}

// `zip_with(b, f)` — `f` over corresponding elements of two handles
// whose shapes broadcast, as a packed handle of the broadcast shape.
// Two shapes that do not broadcast abort.
pub function (a: NdArray[T]) zip_with[T, U, V](b: NdArray[U], f: (T, U) => V): NdArray[V] {
    var shape: i32[] = broadcast_shape(a.shape, b.shape);
    var x: NdArray[T] = a;
    var y: NdArray[U] = b;
    if (!same_shape(a.shape, shape)) { x = a.broadcast_to(shape); }
    if (!same_shape(b.shape, shape)) { y = b.broadcast_to(shape); }
    var out: V[] = [];
    var n: i32 = count_of(shape);
    var idx: i32[] = zeros(shape.len());
    var i: i32 = 0;
    while (i < n) {
        out = out.append(f(x.data[addr_of(x, idx)], y.data[addr_of(y, idx)]));
        idx = bump(idx, shape);
        i = i + 1;
    }
    return from_flat(out, shape);
}

// `fold_all(init, f)` — every element folded in reading order.
pub function (a: NdArray[T]) fold_all[T, A](init: A, f: (A, T) => A): A {
    var acc: A = init;
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        acc = f(acc, a.data[addr_of(a, idx)]);
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return acc;
}

// The shape with `axis` removed.
function drop_axis(shape: i32[], axis: i32): i32[] {
    var out: i32[] = [];
    var k: i32 = 0;
    while (k < shape.len()) {
        if (k != axis) { out = out.append(shape[k]); }
        k = k + 1;
    }
    return out;
}

// The lane a full index belongs to: its row-major position in the shape
// with `axis` removed. Every element of one lane differs only along
// `axis`, so a fold per lane is a fold along the axis.
function lane_of(idx: i32[], axis: i32, lane_strides: i32[]): i32 {
    var lane: i32 = 0;
    var k: i32 = 0;
    var j: i32 = 0;
    while (k < idx.len()) {
        if (k != axis) {
            lane = lane + idx[k] * lane_strides[j];
            j = j + 1;
        }
        k = k + 1;
    }
    return lane;
}

// One accumulator per lane, all `init`.
function lanes[A](count: i32, init: A): A[] {
    var accs: A[] = [];
    var i: i32 = 0;
    while (i < count) {
        accs = accs.append(init);
        i = i + 1;
    }
    return accs;
}

// `reduce_axis(axis, init, f)` — the fold along `axis`, in increasing
// index order, as a packed handle of one rank less: a rank-1 handle
// reduces to a rank-0 one. Every lane is folded in one reading-order
// walk, which visits each lane's elements in axis order.
pub function (a: NdArray[T]) reduce_axis[T, A](axis: i32, init: A, f: (A, T) => A): NdArray[A] {
    check_axis(a, axis);
    var rshape: i32[] = drop_axis(a.shape, axis);
    var lane_strides: i32[] = row_major(rshape);
    var accs: A[] = lanes(count_of(rshape), init);
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        var lane: i32 = lane_of(idx, axis, lane_strides);
        accs = accs.with(lane, f(accs[lane], a.data[addr_of(a, idx)]));
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return from_flat(accs, rshape);
}

// `scan_axis(axis, init, f)` — the running fold along `axis`, in
// increasing index order, as a packed handle of the same shape: element
// `i` along the axis holds the fold of elements `0 .. i`.
pub function (a: NdArray[T]) scan_axis[T, A](axis: i32, init: A, f: (A, T) => A): NdArray[A] {
    check_axis(a, axis);
    var rshape: i32[] = drop_axis(a.shape, axis);
    var lane_strides: i32[] = row_major(rshape);
    var accs: A[] = lanes(count_of(rshape), init);
    var out: A[] = [];
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        var lane: i32 = lane_of(idx, axis, lane_strides);
        var acc: A = f(accs[lane], a.data[addr_of(a, idx)]);
        accs = accs.with(lane, acc);
        out = out.append(acc);
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return from_flat(out, a.shape);
}

// The row-major reading of `a`, walked with an odometer over the shape.
function copy_flat[T](a: NdArray[T]): T[] {
    var out: T[] = [];
    var n: i32 = a.len();
    var idx: i32[] = zeros(a.shape.len());
    var i: i32 = 0;
    while (i < n) {
        out = out.append(a.data[addr_of(a, idx)]);
        idx = bump(idx, a.shape);
        i = i + 1;
    }
    return out;
}

// The next index in row-major order: the last axis moves fastest. `idx`
// is consumed so the writes land in place; borrowed, every step would
// copy it. Each write is the self-reassign `idx = idx.with(..)` rather
// than a `return idx.with(..)`: with a second `.with` on the receiver in
// another branch the return form copies (#9844).
function bump(own idx: i32[], shape: i32[]): i32[] {
    var k: i32 = shape.len() - 1;
    while (k >= 0) {
        if (idx[k] + 1 < shape[k]) {
            idx = idx.with(k, idx[k] + 1);
            return idx;
        }
        idx = idx.with(k, 0);
        k = k - 1;
    }
    return idx;
}
