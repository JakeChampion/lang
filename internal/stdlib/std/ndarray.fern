// This module provides multidimensional arrays with flat storage.

pub struct NdArray[T] { data: T[], shape: i32[], strides: i32[], offset: i32 }

function shape_error(): void {
  exit(134);
}

function check_shape(shape: i32[]): void {
  let n: i32 = 1;
  let k: i32 = 0;
  while (k < shape.len()) {
    if (shape[k] < 0) {
      shape_error();
    }
    if (shape[k] != 0 && n > 2147483647 / shape[k]) {
      shape_error();
    }
    n = n * shape[k];
    k = k + 1;
  }
}

function count_of(shape: i32[]): i32 {
  check_shape(shape);
  let n: i32 = 1;
  let k: i32 = 0;
  while (k < shape.len()) {
    n = n * shape[k];
    k = k + 1;
  }
  return n;
}

function row_major(shape: i32[]): i32[] {
  let out: i32[] = [];
  let k: i32 = 0;
  while (k < shape.len()) {
    out = out.append(0);
    k = k + 1;
  }
  let s: i32 = 1;
  k = shape.len() - 1;
  while (k >= 0) {
    out = out.with(k, s);
    s = s * shape[k];
    k = k - 1;
  }
  return out;
}

pub function from_flat[T](data: T[], shape: i32[]): NdArray[T] {
  if (count_of(shape) != data.len()) {
    shape_error();
  }
  return NdArray { data: data, shape: shape, strides: row_major(shape), offset: 0 };
}

pub function (a: NdArray[T]) shape(): i32[] {
  return a.shape;
}

pub function (a: NdArray[T]) strides(): i32[] {
  return a.strides;
}

pub function (a: NdArray[T]) rank(): i32 {
  return a.shape.len();
}

pub function (a: NdArray[T]) len(): i32 {
  return count_of(a.shape);
}

pub function (a: NdArray[T]) is_row_major(): boolean {
  let rm: i32[] = row_major(a.shape);
  let k: i32 = 0;
  while (k < a.shape.len()) {
    if (a.shape[k] != 1 && a.strides[k] != rm[k]) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

pub function (a: NdArray[T]) is_packed(): boolean {
  return a.is_row_major() && a.offset == 0 && a.data.len() == a.len();
}

function addr[T](a: NdArray[T], idx: i32[]): i32 {
  if (idx.len() != a.shape.len()) {
    return -1;
  }
  let at: i32 = a.offset;
  let k: i32 = 0;
  while (k < idx.len()) {
    if (idx[k] < 0 || idx[k] >= a.shape[k]) {
      return -1;
    }
    at = at + idx[k] * a.strides[k];
    k = k + 1;
  }
  return at;
}

pub function (a: NdArray[T]) get(idx: i32[]): Option[T] {
  let at: i32 = addr(a, idx);
  if (at < 0) {
    return None;
  }
  return Some(a.data[at]);
}

pub function (a: NdArray[T]) get_unchecked(idx: i32[]): T {
  let at: i32 = addr(a, idx);
  if (at < 0) {
    shape_error();
  }
  return a.data[at];
}

function check_axis[T](a: NdArray[T], axis: i32): void {
  if (axis < 0 || axis >= a.shape.len()) {
    shape_error();
  }
}

pub function (a: NdArray[T]) transpose(): NdArray[T] {
  let axes: i32[] = [];
  let k: i32 = a.shape.len() - 1;
  while (k >= 0) {
    axes = axes.append(k);
    k = k - 1;
  }
  return a.permute(axes);
}

pub function (a: NdArray[T]) permute(axes: i32[]): NdArray[T] {
  if (axes.len() != a.shape.len()) {
    shape_error();
  }
  let seen: boolean[] = [];
  let shape: i32[] = [];
  let strides: i32[] = [];
  let k: i32 = 0;
  while (k < axes.len()) {
    seen = seen.append(false);
    k = k + 1;
  }
  k = 0;
  while (k < axes.len()) {
    check_axis(a, axes[k]);
    if (seen[axes[k]]) {
      shape_error();
    }
    seen = seen.with(axes[k], true);
    shape = shape.append(a.shape[axes[k]]);
    strides = strides.append(a.strides[axes[k]]);
    k = k + 1;
  }
  return NdArray { data: a.data, shape: shape, strides: strides, offset: a.offset };
}

pub function (a: NdArray[T]) reverse(axis: i32): NdArray[T] {
  check_axis(a, axis);
  let n: i32 = a.shape[axis];
  let s: i32 = a.strides[axis];
  let offset: i32 = a.offset;
  if (n > 0) {
    offset = offset + (n - 1) * s;
  }
  return NdArray { data: a.data, shape: a.shape, strides: a.strides.with(axis, 0 - s), offset: offset };
}

pub function (a: NdArray[T]) slice(axis: i32, lo: i32, hi: i32): NdArray[T] {
  check_axis(a, axis);
  if (lo < 0 || lo > hi || hi > a.shape[axis]) {
    shape_error();
  }
  let offset: i32 = a.offset + lo * a.strides[axis];
  return NdArray { data: a.data, shape: a.shape.with(axis, hi - lo), strides: a.strides, offset: offset };
}

pub function (a: NdArray[T]) select(axis: i32, i: i32): NdArray[T] {
  check_axis(a, axis);
  if (i < 0 || i >= a.shape[axis]) {
    shape_error();
  }
  let shape: i32[] = [];
  let strides: i32[] = [];
  let k: i32 = 0;
  while (k < a.shape.len()) {
    if (k != axis) {
      shape = shape.append(a.shape[k]);
      strides = strides.append(a.strides[k]);
    }
    k = k + 1;
  }
  return NdArray { data: a.data, shape: shape, strides: strides, offset: a.offset + i * a.strides[axis] };
}

pub function (a: NdArray[T]) reshape(shape: i32[]): NdArray[T] {
  if (count_of(shape) != a.len()) {
    shape_error();
  }
  if (a.is_row_major()) {
    return NdArray { data: a.data, shape: shape, strides: row_major(shape), offset: a.offset };
  }
  return from_flat(copy_flat(a), shape);
}

pub function (a: NdArray[T]) packed(): NdArray[T] {
  if (a.is_packed()) {
    return a;
  }
  return from_flat(copy_flat(a), a.shape);
}

pub function (a: NdArray[T]) to_flat(): T[] {
  if (a.is_packed()) {
    return a.data;
  }
  return copy_flat(a);
}

function addr_of[T](a: NdArray[T], idx: i32[]): i32 {
  let at: i32 = a.offset;
  let k: i32 = 0;
  while (k < idx.len()) {
    at = at + idx[k] * a.strides[k];
    k = k + 1;
  }
  return at;
}

function zeros(rank: i32): i32[] {
  let idx: i32[] = [];
  let k: i32 = 0;
  while (k < rank) {
    idx = idx.append(0);
    k = k + 1;
  }
  return idx;
}

pub function (a: NdArray[T]) map[T, U](f: (T) => U): NdArray[U] {
  if (a.is_packed()) {
    return from_flat(packed_map(a.data, f), a.shape);
  }
  let out: U[] = [];
  let n: i32 = a.len();
  let idx: i32[] = zeros(a.shape.len());
  let i: i32 = 0;
  while (i < n) {
    out = out.append(f(a.data[addr_of(a, idx)]));
    idx = bump(idx, a.shape);
    i = i + 1;
  }
  return from_flat(out, a.shape);
}

function packed_map[T, U](data: T[], f: (T) => U): U[] {
  let out: U[] = [];
  let n: i32 = data.len();
  let i: i32 = 0;
  while (i < n) {
    out = out.append(f(data[i]));
    i = i + 1;
  }
  return out;
}

function same_shape(x: i32[], y: i32[]): boolean {
  if (x.len() != y.len()) {
    return false;
  }
  let k: i32 = 0;
  while (k < x.len()) {
    if (x[k] != y[k]) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

pub function broadcast_shape(x: i32[], y: i32[]): i32[] {
  check_shape(x);
  check_shape(y);
  let rank: i32 = x.len();
  if (y.len() > rank) {
    rank = y.len();
  }
  let out: i32[] = zeros(rank);
  let k: i32 = 0;
  while (k < rank) {
    let ex: i32 = 1;
    let ey: i32 = 1;
    if (k >= rank - x.len()) {
      ex = x[k - (rank - x.len())];
    }
    if (k >= rank - y.len()) {
      ey = y[k - (rank - y.len())];
    }
    if (ex == ey || ey == 1) {
      out = out.with(k, ex);
    } else if (ex == 1) {
      out = out.with(k, ey);
    } else {
      shape_error();
    }
    k = k + 1;
  }
  check_shape(out);
  return out;
}

pub function (a: NdArray[T]) broadcast_to(shape: i32[]): NdArray[T] {
  check_shape(shape);
  let pad: i32 = shape.len() - a.shape.len();
  if (pad < 0) {
    shape_error();
  }
  let strides: i32[] = zeros(shape.len());
  let k: i32 = 0;
  while (k < a.shape.len()) {
    if (a.shape[k] == shape[pad + k]) {
      strides = strides.with(pad + k, a.strides[k]);
    } else if (a.shape[k] != 1) {
      shape_error();
    }
    k = k + 1;
  }
  return NdArray { data: a.data, shape: shape, strides: strides, offset: a.offset };
}

pub function (a: NdArray[T]) zip_with[T, U, V](b: NdArray[U], f: (T, U) => V): NdArray[V] {
  let shape: i32[] = broadcast_shape(a.shape, b.shape);
  let x: NdArray[T] = a;
  let y: NdArray[U] = b;
  if (!same_shape(a.shape, shape)) {
    x = a.broadcast_to(shape);
  }
  if (!same_shape(b.shape, shape)) {
    y = b.broadcast_to(shape);
  }
  if (x.is_packed() && y.is_packed()) {
    return from_flat(packed_zip(x.data, y.data, f), shape);
  }
  let out: V[] = [];
  let n: i32 = count_of(shape);
  let idx: i32[] = zeros(shape.len());
  let i: i32 = 0;
  while (i < n) {
    out = out.append(f(x.data[addr_of(x, idx)], y.data[addr_of(y, idx)]));
    idx = bump(idx, shape);
    i = i + 1;
  }
  return from_flat(out, shape);
}

function packed_zip[T, U, V](x: T[], y: U[], f: (T, U) => V): V[] {
  let out: V[] = [];
  let n: i32 = x.len();
  let i: i32 = 0;
  while (i < n) {
    out = out.append(f(x[i], y[i]));
    i = i + 1;
  }
  return out;
}

pub function (a: NdArray[T]) outer[T, U, V](b: NdArray[U], f: (T, U) => V): NdArray[V] {
  let shape: i32[] = join(a.shape, b.shape);
  check_shape(shape);
  if (a.is_packed() && b.is_packed()) {
    return packed_outer(a.data, b.data, shape, f);
  }
  let ra: i32 = a.shape.len();
  let rb: i32 = b.shape.len();
  let x: NdArray[T] = NdArray { data: a.data, shape: join(a.shape, ones(rb)), strides: join(a.strides, zeros(rb)), offset: a.offset };
  let y: NdArray[U] = NdArray { data: b.data, shape: join(ones(ra), b.shape), strides: join(zeros(ra), b.strides), offset: b.offset };
  return x.zip_with(y, f);
}

function packed_outer[T, U, V](a: T[], b: U[], shape: i32[], f: (T, U) => V): NdArray[V] {
  let out: V[] = [];
  if (b.len() == 0) {
    return from_flat(out, shape);
  }
  let i: i32 = 0;
  while (i < a.len()) {
    let j: i32 = 0;
    while (j < b.len()) {
      out = out.append(f(a[i], b[j]));
      j = j + 1;
    }
    i = i + 1;
  }
  return from_flat(out, shape);
}

function join(x: i32[], y: i32[]): i32[] {
  let out: i32[] = [];
  let k: i32 = 0;
  while (k < x.len()) {
    out = out.append(x[k]);
    k = k + 1;
  }
  k = 0;
  while (k < y.len()) {
    out = out.append(y[k]);
    k = k + 1;
  }
  return out;
}

function ones(rank: i32): i32[] {
  let out: i32[] = [];
  let k: i32 = 0;
  while (k < rank) {
    out = out.append(1);
    k = k + 1;
  }
  return out;
}

function base_of[T](a: NdArray[T], idx: i32[], idx_from: i32, axis_from: i32, count: i32): i32 {
  let at: i32 = a.offset;
  let k: i32 = 0;
  while (k < count) {
    at = at + idx[idx_from + k] * a.strides[axis_from + k];
    k = k + 1;
  }
  return at;
}

pub function (a: NdArray[T]) inner[T, A](b: NdArray[T], init: A, mul: (T, T) => A, add: (A, A) => A): NdArray[A] {
  let ra: i32 = a.shape.len();
  let rb: i32 = b.shape.len();
  let shape: i32[] = inner_shape(a.shape, b.shape);
  let n: i32 = a.shape[ra - 1];
  let sa: i32 = a.strides[ra - 1];
  let sb: i32 = b.strides[0];
  let out: A[] = [];
  let total: i32 = count_of(shape);
  if (total == 0) {
    return from_flat(out, shape);
  }
  if (a.is_packed() && b.is_packed()) {
    return from_flat(packed_inner(a.data, b.data, extent_before(a.shape, ra - 1), n, extent_after(b.shape, 0), init, mul, add), shape);
  }
  let idx: i32[] = zeros(shape.len());
  let i: i32 = 0;
  while (i < total) {
    let pa: i32 = base_of(a, idx, 0, 0, ra - 1);
    let pb: i32 = base_of(b, idx, ra - 1, 1, rb - 1);
    let acc: A = init;
    let k: i32 = 0;
    while (k < n) {
      acc = add(acc, mul(a.data[pa + k * sa], b.data[pb + k * sb]));
      k = k + 1;
    }
    out = out.append(acc);
    idx = bump(idx, shape);
    i = i + 1;
  }
  return from_flat(out, shape);
}

function inner_shape(a: i32[], b: i32[]): i32[] {
  if (a.len() < 1 || b.len() < 1 || a[a.len() - 1] != b[0]) {
    shape_error();
  }
  return join(drop_axis(a, a.len() - 1), drop_axis(b, 0));
}

function inner_kernel(a: NdArray[f64], b: NdArray[f64], init: f64): NdArray[f64] {
  let shape: i32[] = inner_shape(a.shape, b.shape);
  let total: i32 = count_of(shape);
  if (total == 0) {
    return from_flat([], shape);
  }
  let last: i32 = a.shape.len() - 1;
  let data: f64[] = __inner_mul_add_f64(a.data, b.data, extent_before(a.shape, last), a.shape[last], extent_after(b.shape, 0), init);
  return from_flat(data, shape);
}

function packed_inner[T, A](xs: T[], ys: T[], rows: i32, extent: i32, columns: i32, init: A, mul: (T, T) => A, add: (A, A) => A): A[] {
  let out: A[] = [];
  let i: i32 = 0;
  while (i < rows) {
    let j: i32 = 0;
    while (j < columns) {
      let acc: A = init;
      let k: i32 = 0;
      while (k < extent) {
        acc = add(acc, mul(xs[i * extent + k], ys[k * columns + j]));
        k = k + 1;
      }
      out = out.append(acc);
      j = j + 1;
    }
    i = i + 1;
  }
  return out;
}

pub function (a: NdArray[T]) fold_all[T, A](init: A, f: (A, T) => A): A {
  if (a.is_packed()) {
    return packed_fold(a.data, init, f);
  }
  let acc: A = init;
  let n: i32 = a.len();
  let idx: i32[] = zeros(a.shape.len());
  let i: i32 = 0;
  while (i < n) {
    acc = f(acc, a.data[addr_of(a, idx)]);
    idx = bump(idx, a.shape);
    i = i + 1;
  }
  return acc;
}

function packed_fold[T, A](data: T[], init: A, f: (A, T) => A): A {
  let acc: A = init;
  let n: i32 = data.len();
  let i: i32 = 0;
  while (i < n) {
    acc = f(acc, data[i]);
    i = i + 1;
  }
  return acc;
}

function drop_axis(shape: i32[], axis: i32): i32[] {
  let out: i32[] = [];
  let k: i32 = 0;
  while (k < shape.len()) {
    if (k != axis) {
      out = out.append(shape[k]);
    }
    k = k + 1;
  }
  return out;
}

function lane_of(idx: i32[], axis: i32, lane_strides: i32[]): i32 {
  let lane: i32 = 0;
  let k: i32 = 0;
  let j: i32 = 0;
  while (k < idx.len()) {
    if (k != axis) {
      lane = lane + idx[k] * lane_strides[j];
      j = j + 1;
    }
    k = k + 1;
  }
  return lane;
}

function lanes[A](count: i32, init: A): A[] {
  let accs: A[] = [];
  let i: i32 = 0;
  while (i < count) {
    accs = accs.append(init);
    i = i + 1;
  }
  return accs;
}

function extent_after(shape: i32[], axis: i32): i32 {
  let s: i32 = 1;
  let k: i32 = axis + 1;
  while (k < shape.len()) {
    s = s * shape[k];
    k = k + 1;
  }
  return s;
}

function extent_before(shape: i32[], axis: i32): i32 {
  let s: i32 = 1;
  let k: i32 = 0;
  while (k < axis) {
    s = s * shape[k];
    k = k + 1;
  }
  return s;
}

function packed_reduce[T, A](data: T[], outer: i32, extent: i32, inner: i32, init: A, f: (A, T) => A): A[] {
  let accs: A[] = lanes(outer * inner, init);
  let i: i32 = 0;
  let h: i32 = 0;
  while (h < outer) {
    let base: i32 = h * inner;
    let t: i32 = 0;
    while (t < extent) {
      let l: i32 = 0;
      while (l < inner) {
        let lane: i32 = base + l;
        accs = accs.with(lane, f(accs[lane], data[i]));
        i = i + 1;
        l = l + 1;
      }
      t = t + 1;
    }
    h = h + 1;
  }
  return accs;
}

function packed_scan[T, A](data: T[], outer: i32, extent: i32, inner: i32, init: A, f: (A, T) => A): A[] {
  let accs: A[] = lanes(outer * inner, init);
  let out: A[] = [];
  let i: i32 = 0;
  let h: i32 = 0;
  while (h < outer) {
    let base: i32 = h * inner;
    let t: i32 = 0;
    while (t < extent) {
      let l: i32 = 0;
      while (l < inner) {
        let lane: i32 = base + l;
        let acc: A = f(accs[lane], data[i]);
        accs = accs.with(lane, acc);
        out = out.append(acc);
        i = i + 1;
        l = l + 1;
      }
      t = t + 1;
    }
    h = h + 1;
  }
  return out;
}

pub function (a: NdArray[T]) reduce_axis[T, A](axis: i32, init: A, f: (A, T) => A): NdArray[A] {
  check_axis(a, axis);
  let rshape: i32[] = drop_axis(a.shape, axis);
  let lane_strides: i32[] = row_major(rshape);
  if (a.is_packed()) {
    return from_flat(
      packed_reduce(
        a.data, extent_before(a.shape, axis), a.shape[axis],
        extent_after(a.shape, axis), init, f,
      ),
      rshape,
    );
  }
  let accs: A[] = lanes(count_of(rshape), init);
  let n: i32 = a.len();
  let idx: i32[] = zeros(a.shape.len());
  let i: i32 = 0;
  while (i < n) {
    let lane: i32 = lane_of(idx, axis, lane_strides);
    accs = accs.with(lane, f(accs[lane], a.data[addr_of(a, idx)]));
    idx = bump(idx, a.shape);
    i = i + 1;
  }
  return from_flat(accs, rshape);
}

pub function (a: NdArray[T]) scan_axis[T, A](axis: i32, init: A, f: (A, T) => A): NdArray[A] {
  check_axis(a, axis);
  let rshape: i32[] = drop_axis(a.shape, axis);
  let lane_strides: i32[] = row_major(rshape);
  if (a.is_packed()) {
    return from_flat(
      packed_scan(
        a.data, extent_before(a.shape, axis), a.shape[axis],
        extent_after(a.shape, axis), init, f,
      ),
      a.shape,
    );
  }
  let accs: A[] = lanes(count_of(rshape), init);
  let out: A[] = [];
  let n: i32 = a.len();
  let idx: i32[] = zeros(a.shape.len());
  let i: i32 = 0;
  while (i < n) {
    let lane: i32 = lane_of(idx, axis, lane_strides);
    let acc: A = f(accs[lane], a.data[addr_of(a, idx)]);
    accs = accs.with(lane, acc);
    out = out.append(acc);
    idx = bump(idx, a.shape);
    i = i + 1;
  }
  return from_flat(out, a.shape);
}

pub function (a: NdArray[T]) map_rank[T, U](k: i32, f: (NdArray[T]) => NdArray[U]): NdArray[U] {
  if (k < 0 || k > a.shape.len()) {
    shape_error();
  }
  let fr: i32 = a.shape.len() - k;
  let frame: i32[] = [];
  let j: i32 = 0;
  while (j < fr) {
    frame = frame.append(a.shape[j]);
    j = j + 1;
  }
  let cells: i32 = count_of(frame);
  let out: U[] = [];
  let cshape: i32[] = [];
  let idx: i32[] = zeros(fr);
  let packed: boolean = a.is_packed();
  let cshape_in: i32[] = [];
  let cstrides: i32[] = [];
  let q: i32 = fr;
  while (q < a.shape.len()) {
    cshape_in = cshape_in.append(a.shape[q]);
    cstrides = cstrides.append(a.strides[q]);
    q = q + 1;
  }
  let csize: i32 = count_of(cshape_in);
  let i: i32 = 0;
  while (i < cells) {
    let cell: NdArray[T] = a;
    if (packed) {
      cell = NdArray { data: a.data, shape: cshape_in, strides: cstrides, offset: i * csize };
    } else {
      let d: i32 = 0;
      while (d < fr) {
        cell = cell.select(0, idx[d]);
        d = d + 1;
      }
      idx = bump(idx, frame);
    }
    let r: NdArray[U] = f(cell);
    if (i == 0) {
      cshape = r.shape();
    } else {
      if (!same_shape(r.shape(), cshape)) {
        shape_error();
      }
    }
    let flat: U[] = r.to_flat();
    let m: i32 = 0;
    while (m < flat.len()) {
      out = out.append(flat[m]);
      m = m + 1;
    }
    i = i + 1;
  }
  return from_flat(out, join(frame, cshape));
}

function copy_flat[T](a: NdArray[T]): T[] {
  let out: T[] = [];
  let n: i32 = a.len();
  let idx: i32[] = zeros(a.shape.len());
  let i: i32 = 0;
  while (i < n) {
    out = out.append(a.data[addr_of(a, idx)]);
    idx = bump(idx, a.shape);
    i = i + 1;
  }
  return out;
}

function bump(own idx: i32[], shape: i32[]): i32[] {
  let k: i32 = shape.len() - 1;
  while (k >= 0) {
    if (idx[k] + 1 < shape[k]) {
      return idx.with(k, idx[k] + 1);
    }
    idx = idx.with(k, 0);
    k = k - 1;
  }
  return idx;
}
