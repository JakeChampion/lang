// #6049, cause 2 (fixed by #6120, `LocalInfo.borrowed_arr`): a match-arm ARRAY
// payload binder is BORROWED from the enum box, so it must not enter the
// function-exit dec-sweep.
//
// `Seq(xs)` marks its slot is_arr so `xs[i]` / `xs.len()` resolve, and the
// sweep is is_arr-gated — a param escapes it by slot index, a binder cannot.
// So every call that matched a `Seq` released the buffer the box owns, and
// re-matching one node freed the tree under itself. `closure` is std/regex's
// `__rx_closure` reduced: `+` and `*` re-match the SAME node once per text
// position, which is why only quantified patterns (`^(ab)+$` over "ababab")
// crashed while a single pass looked fine. The per-iteration allocation is what
// makes a released cell visible rather than merely dangling.
//
// #6120 pins this on x86-64 (TestSelfHostEnumPayloadBorrowIRX86_64). The defect
// is in irlower, which all three self-host backends share, so this fixture
// carries the same shape onto the wasm and arm64 legs as well.

enum N { Chr(i32), Seq(N[]), Plus(N) }

function closure(inner: N, reps: i32): i32 {
    var acc: i32 = 0;
    var i: i32 = 0;
    while (i < reps) {
        var got: i32[] = [];
        got = got.append(sum(inner));
        acc = acc + got[0];
        i = i + 1;
    }
    return acc;
}

function sum(n: N): i32 {
    match (n) {
        Chr(c) => { return c; },
        Seq(xs) => { var s: i32 = 0; var k: i32 = 0; while (k < xs.len()) { s = s + sum(xs[k]); k = k + 1; } return s; },
        Plus(inner) => { return closure(inner, 8); }
    }
}

function main(): i32 {
    var items: N[] = [];
    items = items.append(Chr(1));
    items = items.append(Chr(2));
    var t: N = Plus(Seq(items));
    // 8 passes over Seq(1, 2) = 8 * 3 = 24.
    return sum(t);
}
