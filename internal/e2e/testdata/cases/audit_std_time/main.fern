import "core/int";
import "std/time";

// Audit fixture: std/time calendar helpers across every native backend.

function main(): i32 {
    if (!time.is_leap_year(2024)) { print("FAIL leap-2024"); return 11; }
    if (time.is_leap_year(2023)) { print("FAIL leap-2023"); return 12; }
    if (time.days_in_month(2024, 2) != 29) { print("FAIL feb-2024"); return 13; }
    if (time.days_in_month(2023, 2) != 28) { print("FAIL feb-2023"); return 14; }
    var d: Date = time.date_make(2024, 3, 14);
    if (d.format_iso() != "2024-03-14") { print("FAIL iso"); return 15; }
    print("OK");
    return 0;
}
