import "std/string";
import "std/i32";

// Property-based audit for std/string transforms.
//
// Deterministic LCG => identical inputs on every backend. Full byte
// range, lengths 0..47.
//
// Properties:
//   reverse_bytes . reverse_bytes == id   (involution)
//   to_lower . to_lower == to_lower       (idempotence)
//   to_upper . to_upper == to_upper       (idempotence)
//   len is preserved by all three transforms

function lcg_next(state: i32): i32 {
    return ((state * 1103515245) + 12345) & 2147483647;
}

function gen_bytes(seed: i32, n: i32): u8[] {
    var buf: u8[] = __alloc_u8(n);
    var state: i32 = seed;
    var i: i32 = 0;
    while (i < n) {
        state = lcg_next(state);
        buf = buf.with(i, ((state / 7) % 256) as u8);
        i = i + 1;
    }
    return buf;
}

function main(): i32 {
    var state: i32 = 1985229328;
    var trial: i32 = 0;
    while (trial < 300) {
        state = lcg_next(state);
        var n: i32 = state % 48;
        var s: string = string_from_bytes(gen_bytes(state, n));

        if (s.reverse_bytes().reverse_bytes() != s) {
            print("reverse_bytes involution FAILED at trial " + trial.to_string());
            return 1;
        }
        if (s.reverse_bytes().len() != s.len()) {
            print("reverse_bytes length FAILED at trial " + trial.to_string());
            return 1;
        }

        var lo: string = s.to_lower();
        if (lo.to_lower() != lo) {
            print("to_lower idempotence FAILED at trial " + trial.to_string());
            return 1;
        }
        if (lo.len() != s.len()) {
            print("to_lower length FAILED at trial " + trial.to_string());
            return 1;
        }

        var up: string = s.to_upper();
        if (up.to_upper() != up) {
            print("to_upper idempotence FAILED at trial " + trial.to_string());
            return 1;
        }
        if (up.len() != s.len()) {
            print("to_upper length FAILED at trial " + trial.to_string());
            return 1;
        }
        trial = trial + 1;
    }
    print("OK");
    return 0;
}
