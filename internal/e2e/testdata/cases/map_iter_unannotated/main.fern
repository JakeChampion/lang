// An UNANNOTATED `var it = m.iter()` types the slot as MapIter[K, V] from
// the receiver's map type. The annotation used to be load-bearing on the
// self-host IR path: without it the slot stayed untyped and the first
// `it.has_next()` bailed the whole module — at any value type, an i32-keyed
// i32-valued map included, with `.value()` never called.
import "core/map";

function main(): i32 {
    var m: Map[i32, i32] = map_new(8);
    m = m.insert(1, 10);
    m = m.insert(2, 20);

    // No `: MapIter[i32, i32]` here — that is the point of the fixture.
    var it = m.iter();
    var total: i32 = 0;
    var seen: i32 = 0;
    while (it.has_next()) {
        total = total + it.value();
        seen = seen + it.key();
        it.advance();
    }
    if (total != 30) { return 1; }
    if (seen != 3) { return 2; }

    // Same over a string-keyed, string-valued map: the recovered K and V
    // both have to survive, since key()/value() dispatch on them.
    var s: Map[string, string] = map_new(4);
    s = s.insert("a", "xy");
    var it2 = s.iter();
    var chars: i32 = 0;
    while (it2.has_next()) {
        chars = chars + it2.key().len() + it2.value().len();
        it2.advance();
    }
    if (chars != 3) { return 3; }

    return 42;
}
