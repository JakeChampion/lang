import "std/string";
// Exercises the Err arm of a Result and string-equality on the
// error payload.
function parse_positive(s: string): Result[i32, string] {
    match (s.trim().parse_int()) {
        Some(n) => {
            if (n < 0) { return Err("negative"); }
            return Ok(n);
        },
        None => { return Err("not a number"); }
    }
}

function main(): i32 {
    match (parse_positive("nope")) {
        Ok(_) => { return 1; },
        Err(msg) => {
            if (msg == "not a number") { return 42; }
            return 2;
        }
    }
}
