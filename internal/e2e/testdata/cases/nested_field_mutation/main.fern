// Rejection fixture: assignment through a nested struct field path
// (`o.inner.x = v`) is a FieldAccess target and is banned (E048).
struct Inner { x: i32 }
struct Outer { inner: Inner }

function main(): i32 {
    var o: Outer = Outer { inner: Inner { x: 0 } };
    o.inner.x = 42;
    return o.inner.x;
}
