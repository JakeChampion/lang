import "core/int";
import "std/url";
import "std/i32";

function main(): i32 {
    // round-trip percent-encoding.
    var enc: string = url.url_encode("a b/c?x=1");
    print(enc);
    print(url.url_decode(enc));
    // unreserved stays as-is; reserved bytes are %-escaped uppercase.
    print(url.url_encode("Hello-World_1.2~"));
    // decode leaves an invalid escape literal.
    print(url.url_decode("100%zz"));
    // url_parse decomposes into the Url struct (Option payload via match).
    match (url.url_parse("http://h.com:8080/p?q#f")) {
        Some(u) => { print(u.scheme + " " + u.host + " " + u.port.to_string() + " " + u.path + " " + u.query + " " + u.fragment); },
        None => { print("parse-none"); },
    }
    // empty input -> None.
    match (url.url_parse("")) {
        Some(u) => { print("unexpected"); },
        None => { print("empty-none"); },
    }
    return 0;
}
