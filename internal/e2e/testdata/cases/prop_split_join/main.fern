import "std/string";
import "std/array";
import "std/i32";

// Property-based audit for std/string.split + std/array.join.
//
// Deterministic LCG => identical inputs on every backend.
//
// Property: join(split(s, sep), sep) == s for every generated s and a
// single-byte separator. This holds unconditionally (split/join are
// inverse for a fixed separator), so it covers empty fields, leading /
// trailing / consecutive separators — all the edge cases a hand-picked
// example tends to miss. Exercises string building heavily.

function lcg_next(state: i32): i32 {
    return ((state * 1103515245) + 12345) & 2147483647;
}

// alphabet incl. the separator ',' so splits actually happen, plus a/b/c
function pick_char(r: i32): i32 {
    var k: i32 = r % 4;
    if (k == 0) { return 44; }   // ,  (the separator)
    if (k == 1) { return 97; }   // a
    if (k == 2) { return 98; }   // b
    return 99;                   // c
}

function gen(seed: i32, n: i32): string {
    var buf: u8[] = __alloc_u8(n);
    var state: i32 = seed;
    var i: i32 = 0;
    while (i < n) {
        state = lcg_next(state);
        buf = buf.with(i, pick_char(state / 7) as u8);
        i = i + 1;
    }
    return string_from_bytes(buf);
}

function main(): i32 {
    var state: i32 = 24681012;
    var trial: i32 = 0;
    while (trial < 300) {
        state = lcg_next(state);
        var n: i32 = state % 24;
        var s: string = gen(state, n);

        if (s.split(",").join(",") != s) {
            print("split/join roundtrip FAILED at trial " + trial.to_string() + ": [" + s + "]");
            return 1;
        }
        trial = trial + 1;
    }
    print("OK");
    return 0;
}
