// A mutually-recursive type: a binary tree where interior nodes hold
// further Trees. The leaves are bound to Tree-typed locals so they
// widen to the union before going into Node's fields. 40 + 2 = 42.
struct Leaf { v: i32 }
struct Node { left: Tree, right: Tree }
type Tree = Leaf | Node;

function tree_sum(t: Tree): i32 {
    match (t) {
        Leaf(l) => { return l.v; },
        Node(n) => { return tree_sum(n.left) + tree_sum(n.right); }
    }
}

function main(): i32 {
    var l: Tree = Leaf { v: 40 };
    var r: Tree = Leaf { v: 2 };
    var t: Tree = Node { left: l, right: r };
    return tree_sum(t);
}
