// Regression for the consumed-param entry-inc gate: an ARRAY-BEARING
// cursor struct (Par-shaped — the self-host parser's) threaded through
// `(value, cursor)` tuple returns. The param is consumed-promoted (it
// is reassigned) but borrow-taint keeps it out of freeEligible; the
// entry inc used to be freeEligible-gated too, so the reassignment's
// unconditional overwrite dec stole the caller's count on every call,
// and the caller's destructure-temp deep drop then freed a cursor box
// that live bindings still referenced (dec-after-free → freelist
// corruption; the self-host modload fixpoint crashed in __fern_alloc).
struct Tok { k: i32 }
struct Par { toks: Tok[], pos: i32 }

function (p: Par) advance(): Par {
    return Par { toks: p.toks, pos: p.pos + 1 };
}

function parse_one(p: Par): (i32, Par) {
    p = p.advance();
    if (p.pos % 3 == 0) { return (2, p); }
    p = p.advance();
    return (1, p);
}

function parse_many(p: Par): (i32, Par) {
    var n = 0;
    var guard = 0;
    while (guard < 200) {
        var (s, p2) = parse_one(p);
        p = p2;
        n = n + s;
        guard = guard + 1;
    }
    return (n, p);
}

function main(): i32 {
    var t0: Tok[] = [Tok { k: 1 }, Tok { k: 2 }];
    var total = 0;
    var r = 0;
    while (r < 30) {
        var (n, pf) = parse_many(Par { toks: t0, pos: 0 });
        total = total + n + pf.pos % 7;
        r = r + 1;
    }
    return (total / 30) % 256 + __rc_underflow_count();
}
