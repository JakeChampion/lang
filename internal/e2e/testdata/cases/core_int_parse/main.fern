import "core/int";

// Exercises core/int's radix parse direction (parse_int_radix / __radix_digit)
// plus int_to_string_radix across all four native backends. FEATURE-AUDIT
// core/int row (parse direction; to_string routes raw-memory builtins).
function main(): i32 {
    match (int.parse_int_radix("ff", 16)) { Some(v) => { print(int.int_to_string(v)); }, None => { print("none"); }, }
    match (int.parse_int_radix("-42", 10)) { Some(v) => { print(int.int_to_string(v)); }, None => { print("none"); }, }
    match (int.parse_int_radix("101", 2)) { Some(v) => { print(int.int_to_string(v)); }, None => { print("none"); }, }
    match (int.parse_int_radix("zz", 36)) { Some(v) => { print(int.int_to_string(v)); }, None => { print("none"); }, }
    match (int.parse_int_radix("12x", 10)) { Some(v) => { print("ok"); }, None => { print("none"); }, }
    match (int.parse_int_radix("", 10)) { Some(v) => { print("ok"); }, None => { print("none"); }, }
    print(int.int_to_string_radix(255, 16));
    return 0;
}
