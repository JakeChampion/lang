import "std/json";
// std/json from the prelude (bare names): parse an object and read
// two integer fields. 40 + 2 = 42.
function main(): i32 {
    match (json.json_parse("{\"a\": 40, \"b\": 2}")) {
        Some(v) => {
            var a: i32 = 0;
            var b: i32 = 0;
            match (json.json_get_i32(v, "a")) {
                Some(x) => { a = x; },
                None => { return 1; }
            }
            match (json.json_get_i32(v, "b")) {
                Some(x) => { b = x; },
                None => { return 2; }
            }
            return a + b;
        },
        None => { return 3; }
    }
}
