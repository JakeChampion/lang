// Element-polymorphic methods: an owned-array (`T[]`) or slice (`[T]`)
// receiver binds the element type variable, inferred from the receiver
// at the call site — so one method body works for `i32[]`, `string[]`,
// etc. Combined with generic-enum methods this makes Option-style
// combinators and closure-taking collection methods writable.
function (xs: T[]) first(): T { return xs[0]; }
function (xs: [T]) head(): T { return xs[0]; }
function (xs: T[]) count_where(pred: (T) => boolean): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < xs.len()) { if (pred(xs[i])) { n = n + 1; } i = i + 1; }
    return n;
}
function is_pos(x: i32): boolean { return x > 0; }

enum Opt[T] { Nil, Has(T) }
function (o: Opt[T]) unwrap_or(d: T): T { match (o) { Has(x) => { return x; }, Nil => { return d; } } }

function main(): i32 {
    var a: i32[] = [3, 0 - 2, 5];
    var sl: [i32] = a[0:3];
    var some: Opt[i32] = Has(9);
    var none: Opt[i32] = Nil;
    return a.first()                  // 3
         + sl.head()                  // 3
         + a.count_where(is_pos)      // 3,5 -> 2
         + some.unwrap_or(0)          // 9
         + none.unwrap_or(7);         // 7  -> 24
}
