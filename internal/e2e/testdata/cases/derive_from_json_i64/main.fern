// `from_json` over i64 fields (#2695 follow-up): 64-bit-wide integer fields
// extract through json.json_get_i64, so large values (timestamps, ids beyond
// i32) round-trip. Returns 42 on a correct round-trip including values above
// the i32 range.
import "std/json";
@derive(json.Json) struct Event { id: i64, name: string, ts: i64 }
function main(): i32 {
    var e: Event = Event { id: 9000000000, name: "boot", ts: 1717000000000 };
    match (Event.from_json(e.to_json())) {
        Ok(e2) => {
            if (e2.id == 9000000000 && e2.ts == 1717000000000 && e2.name == "boot") { return 42; }
            return 1;
        },
        Err(er) => { return 2; },
    }
}
