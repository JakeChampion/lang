// Named arguments: `f(b = 2, a = 1)` binds by parameter name and reorders to
// positional order; they compose with default values and with leading
// positional arguments. `main` returns a pass-count (within an exit code).
function rgb(r: i32, g: i32, b: i32): i32 { return r * 100 + g * 10 + b; }
function listen(port: i32, host: i32 = 7, backlog: i32 = 9): i32 { return port * 100 + host * 10 + backlog; }

function main(): i32 {
    var ok: i32 = 0;
    if (rgb(1, g = 2, b = 3) == 123) { ok = ok + 1; }    // positional + named
    if (rgb(b = 3, r = 1, g = 2) == 123) { ok = ok + 1; } // all named, reordered
    if (listen(1) == 179) { ok = ok + 1; }                // both defaults
    if (listen(1, backlog = 5) == 175) { ok = ok + 1; }   // named skips a default
    if (listen(1, host = 2) == 129) { ok = ok + 1; }      // named middle, default tail
    return ok;                                             // 5
}
