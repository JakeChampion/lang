import "std/base64";
import "std/hex";
import "std/i32";

// Property-based round-trip audit for std/base64 and std/hex.
//
// A deterministic LCG drives the input generation so every backend
// (interp / x86-64 / arm64 / wasm) exercises the exact same swarm of
// inputs and any disagreement is a real cross-backend bug, not noise.
// Inputs deliberately include the full 0..255 byte range (embedded
// NULs and high bytes) and lengths 0..47, since codec byte handling
// is exactly where backend string/byte divergence tends to hide.
//
// Property: decode(encode(s)) == s for every generated s.

function lcg_next(state: i32): i32 {
    return ((state * 1103515245) + 12345) & 2147483647;
}

function gen_bytes(seed: i32, n: i32): u8[] {
    var buf: u8[] = __alloc_u8(n);
    var state: i32 = seed;
    var i: i32 = 0;
    while (i < n) {
        state = lcg_next(state);
        buf = buf.with(i, ((state / 7) % 256) as u8);
        i = i + 1;
    }
    return buf;
}

function main(): i32 {
    var state: i32 = 19088743;
    var trial: i32 = 0;
    while (trial < 300) {
        state = lcg_next(state);
        var n: i32 = state % 48;
        var s: string = string_from_bytes_unchecked(gen_bytes(state, n));

        if (string_from_bytes_unchecked(base64.base64_decode(base64.base64_encode(s))) != s) {
            print("base64 roundtrip FAILED at trial " + trial.to_string());
            return 1;
        }
        if (string_from_bytes_unchecked(hex.hex_decode(hex.hex_encode(s))) != s) {
            print("hex roundtrip FAILED at trial " + trial.to_string());
            return 1;
        }
        trial = trial + 1;
    }
    print("OK");
    return 0;
}
