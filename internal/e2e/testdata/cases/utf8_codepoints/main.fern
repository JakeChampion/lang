// std/string UTF-8 codepoint layer (#4416 ROADMAP #6): codepoints() /
// codepoint_count() decode UTF-8 to Unicode scalar values; string_from_codepoint
// / string_from_codepoints re-encode. Ill-formed input substitutes U+FFFD.
// Exercised on every backend (interp oracle + x86-64 / arm64 / wasm) — the
// decode/encode is pure byte + i32 arithmetic over the raw-memory intrinsics,
// so it must agree everywhere.
import "std/string";

function main(): i32 {
    // ASCII decodes 1:1 with the byte view.
    var a: i32[] = "abc".codepoints();
    if (a.len() != 3 || a[0] != 97 || a[1] != 98 || a[2] != 99) { print("ascii FAILED"); return 1; }
    if ("abc".codepoint_count() != 3) { print("ascii count FAILED"); return 1; }

    // 2-byte é (U+00E9), 3-byte € (U+20AC), 4-byte 😀 (U+1F600).
    var e: i32[] = "é".codepoints();
    if (e.len() != 1 || e[0] != 233) { print("2-byte FAILED"); return 1; }
    var eu: i32[] = "€".codepoints();
    if (eu.len() != 1 || eu[0] != 8364) { print("3-byte FAILED"); return 1; }
    var g: i32[] = "😀".codepoints();
    if (g.len() != 1 || g[0] != 128512) { print("4-byte FAILED"); return 1; }

    // Mixed: byte len 10, codepoint count 5, decoded values in order.
    var mix: string = "a€b😀c";
    if (mix.len() != 10) { print("mixed bytelen FAILED"); return 1; }
    if (mix.codepoint_count() != 5) { print("mixed count FAILED"); return 1; }
    var mc: i32[] = mix.codepoints();
    if (mc.len() != 5 || mc[0] != 97 || mc[1] != 8364 || mc[2] != 98 || mc[3] != 128512 || mc[4] != 99) {
        print("mixed decode FAILED"); return 1;
    }

    // Encode: single scalar and array; round-trip the mixed string.
    if (string.string_from_codepoint(128512) != "😀") { print("encode one FAILED"); return 1; }
    if (string.string_from_codepoints([104, 233, 108, 108, 111]) != "héllo") { print("encode arr FAILED"); return 1; }
    if (string.string_from_codepoints(mix.codepoints()) != mix) { print("roundtrip FAILED"); return 1; }

    // count == codepoints().len() on non-trivial input (the shared __utf8_step).
    if (mix.codepoint_count() != mix.codepoints().len()) { print("count/len mismatch FAILED"); return 1; }

    // Ill-formed bytes substitute exactly one U+FFFD and resume.
    var bad: i32[] = string_from_bytes([255 as u8, 66 as u8]).codepoints();   // invalid lead, then 'B'
    if (bad.len() != 2 || bad[0] != 65533 || bad[1] != 66) { print("bad-lead FAILED"); return 1; }
    var trunc: i32[] = string_from_bytes([226 as u8]).codepoints();           // truncated 3-byte lead
    if (trunc.len() != 1 || trunc[0] != 65533) { print("truncated FAILED"); return 1; }
    var stray: i32[] = string_from_bytes([65 as u8, 191 as u8, 66 as u8]).codepoints(); // 'A', stray cont, 'B'
    if (stray.len() != 3 || stray[0] != 65 || stray[1] != 65533 || stray[2] != 66) { print("stray-cont FAILED"); return 1; }

    // Surrogates and out-of-range sanitise to U+FFFD on encode.
    if (string.string_from_codepoint(55296) != string.string_from_codepoint(65533)) { print("surrogate FAILED"); return 1; }
    if (string.string_from_codepoint(1114112) != string.string_from_codepoint(65533)) { print("oor FAILED"); return 1; }

    // Empty string: no codepoints.
    if ("".codepoints().len() != 0 || "".codepoint_count() != 0) { print("empty FAILED"); return 1; }

    print("OK");
    return 0;
}
