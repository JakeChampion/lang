// A `type T = A | B` union over struct variants, dispatched by match.
struct Add { l: i32, r: i32 }
struct Lit { v: i32 }
type Expr = Add | Lit;

function eval(e: Expr): i32 {
    match (e) {
        Add(a) => { return a.l + a.r; },
        Lit(l) => { return l.v; }
    }
}

function main(): i32 {
    var e: Expr = Add { l: 40, r: 2 };
    return eval(e);
}
