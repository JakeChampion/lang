import "std/i32";
import "std/string";
import "core/cmp";

struct Holder { b: u8[] }

function recv_wrapped(fd: i32, buf: u8[]): i32 {
  return recv_inner(fd, buf);
}

function recv_inner(fd: i32, into: u8[]): i32 {
  return tcp_recv_into(fd, into);
}

function recv_via_local(fd: i32, b: u8[]): i32 {
  let x: u8[] = b;
  return tcp_recv_into(fd, x);
}

function recv_twice(c: i32, s: i32, buf: u8[]): i32 {
  let sent: i32 = tcp_send_bytes(c, "1".bytes());
  let a: i32 = tcp_recv_into(s, buf);
  sent = sent + tcp_send_bytes(c, "2".bytes());
  return sent + a + tcp_recv_into(s, buf);
}

function rebinds(buf: u8[]): i32 {
  buf = [9u8, 9u8];
  return buf.len();
}

function text(b: u8[], n: i32): string {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

function main(): i32 {
  let lo: u8[] = [127u8, 0u8, 0u8, 1u8];
  let ls: i32 = tcp_listen_with(lo, 0, 16, false);
  let c: i32 = tcp_connect_with(lo, tcp_local_port(ls), false);
  let s: i32 = tcp_accept(ls);

  let buf: u8[] = __alloc_u8(8);
  print(f"send: {tcp_send_bytes(c, "direct".bytes())}");
  let n: i32 = tcp_recv_into(s, buf);
  print("direct: " + text(buf, n));
  print(f"send: {tcp_send_bytes(c, "wrapped".bytes())}");
  n = recv_wrapped(s, buf);
  print("wrapped: " + text(buf, n));
  print(f"rebinds: {rebinds(buf)} kept: {buf[0]}");
  print(f"send: {tcp_send_bytes(c, "x".bytes())}");
  n = tcp_recv_into(s, buf);
  print(f"after one byte: {text(buf, n)} {buf[1]}");
  print(f"twice: {recv_twice(c, s, buf)} {text(buf, 1)}");

  let mine: u8[] = __alloc_u8(4);
  let alias: u8[] = mine;
  let h: Holder = Holder { b: mine };
  let nest: u8[][] = [mine];
  let view: [u8] = mine[1:4];
  let read = () => mine[0];
  print(f"send: {tcp_send_bytes(c, "AB".bytes())}");
  n = tcp_recv_into(s, mine);
  print(f"into the variable: {n} alias {alias[0]} field {h.b[0]} element {nest[0][0]} view {view[0]} closure {read()}");
  print(f"send: {tcp_send_bytes(c, "C".bytes())}");
  n = tcp_recv_into(s, alias);
  print(f"into an alias: {n} mine {mine[0]} field {h.b[0]} element {nest[0][0]}");
  print(f"send: {tcp_send_bytes(c, "D".bytes())}");
  n = tcp_recv_into(s, nest[0]);
  print(f"into an element: {n} mine {mine[0]} alias {alias[0]} field {h.b[0]}");
  print(f"send: {tcp_send_bytes(c, "E".bytes())}");
  n = tcp_recv_into(s, h.b);
  print(f"into a field: {n} mine {mine[0]} alias {alias[0]} element {nest[0][0]}");
  print(f"send: {tcp_send_bytes(c, "F".bytes())}");
  n = recv_via_local(s, alias);
  print(f"through a callee's local: {n} mine {mine[0]} field {h.b[0]} closure {read()}");

  alias = alias.with(1, 7u8);
  print(f"send: {tcp_send_bytes(c, "G".bytes())}");
  n = tcp_recv_into(s, mine);
  print(f"after .with: {n} mine {mine[0]},{mine[1]} alias {alias[0]},{alias[1]} field {h.b[0]},{h.b[1]}");
  let grown: u8[] = mine.append(0u8);
  print(f"send: {tcp_send_bytes(c, "H".bytes())}");
  n = tcp_recv_into(s, grown);
  print(f"into an appended copy: {n} mine {mine[0]} grown {grown[0]} len {grown.len()}");

  print(f"close: {tcp_close(c)} {tcp_close(s)} {tcp_close(ls)}");
  return 0;
}
