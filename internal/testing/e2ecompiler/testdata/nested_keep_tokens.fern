import "std/i32";
import "std/result";

struct Decoder { bytes: u8[], last: i32 }

struct Conn { decoder: Decoder, payload: u8[], a0: i32[], a1: i32[], a2: i32[], a3: i32[], a4: i32[], last_stream: i32, n0: i32, n1: i32, n2: i32, n3: i32, n4: i32, n5: i32, n6: i32, n7: i32, n8: i32, n9: i32, n10: i32, n11: i32, n12: i32, n13: i32, n14: i32, n15: i32, n16: i32 }

struct Run { conn: Conn, out: u8[], events: i32[] }

@noinline
function start(decoder: Decoder, stream: i32): Decoder {
  return Decoder { ...decoder, last: stream };
}

@noinline
function step_a(own run: Run, stream: i32): Run {
  let out: u8[] = run.out;
  let events: i32[] = run.events;
  let conn: Conn = run.conn;
  conn = Conn { ...conn, last_stream: stream, decoder: start(conn.decoder, stream) };
  return Run { conn: conn, out: out, events: events };
}

@noinline
function step_c(own run: Run, stream: i32): Run {
  return Run { ...run, conn: Conn { ...run.conn, last_stream: stream, decoder: start(run.conn.decoder, stream) } };
}

@noinline
function step_h(own run: Run, stream: i32): Run {
  let conn: Conn = run.conn;
  let decoder: Decoder = start(conn.decoder, stream);
  return Run { ...run, conn: Conn { ...conn, last_stream: stream, decoder: decoder } };
}

@noinline
function step_p(own run: Run, stream: i32): Run {
  let conn: Conn = run.conn;
  let decoder: Decoder = start(conn.decoder, stream);
  let i: i32 = 0;
  while (i < 3) {
    decoder = start(decoder, stream + i);
    i = i + 1;
  }
  return Run { ...run, conn: Conn { ...conn, last_stream: stream, decoder: decoder } };
}

@noinline
function step_d(own run: Run, stream: i32): Run {
  let conn: Conn = run.conn;
  let decoder: Decoder = start(conn.decoder, stream);
  let i: i32 = 0;
  while (i < 1 + stream % 3) {
    decoder = start(decoder, stream + i);
    i = i + 1;
  }
  return Run { ...run, conn: Conn { ...conn, last_stream: stream, decoder: decoder } };
}

@noinline
function step_b(own run: Run, stream: i32): Run {
  let out: u8[] = run.out;
  let events: i32[] = run.events;
  let conn: Conn = run.conn;
  let decoder: Decoder = conn.decoder;
  decoder = start(decoder, stream);
  conn = Conn { ...conn, last_stream: stream, decoder: decoder };
  return Run { conn: conn, out: out, events: events };
}

@noinline
function step_s(own run: Run, stream: i32): Run {
  let out: u8[] = run.out;
  let events: i32[] = run.events;
  let conn: Conn = run.conn;
  conn = Conn { ...conn, last_stream: stream };
  return Run { conn: conn, out: out, events: events };
}

function main(): i32 {
  let av = args();
  if (av.len() != 4) {
    return 1;
  }
  let mode = av[1];
  let steps = i32.parse_i32(av[2]).unwrap_or(0);
  let shared = av[3] == "shared";
  if (steps <= 0 || steps > 100000) {
    return 2;
  }
  if (mode != "a" && mode != "b" && mode != "c" && mode != "h" && mode != "p" && mode != "d" && mode != "s") {
    return 3;
  }
  let run: Run = Run { conn: Conn { decoder: Decoder { bytes: [1u8, 2u8], last: 0 }, payload: [3u8, 4u8], a0: [10], a1: [11], a2: [12], a3: [13], a4: [14], last_stream: 0, n0: 0, n1: 1, n2: 2, n3: 3, n4: 4, n5: 5, n6: 6, n7: 7, n8: 8, n9: 9, n10: 10, n11: 11, n12: 12, n13: 13, n14: 14, n15: 15, n16: 16 }, out: [5u8], events: [6] };
  let before = __heap_alloc_count();
  for i in 0..steps {
    let old_stream = run.conn.last_stream;
    let old_decoder = run.conn.decoder.last;
    let held: Run[] = [];
    if (shared) {
      held = [run];
    }
    if (mode == "a") {
      run = step_a(run, i);
    } else if (mode == "b") {
      run = step_b(run, i);
    } else if (mode == "c") {
      run = step_c(run, i);
    } else if (mode == "h") {
      run = step_h(run, i);
    } else if (mode == "s") {
      run = step_s(run, i);
    } else if (mode == "p") {
      run = step_p(run, i);
    } else {
      run = step_d(run, i);
    }
    if (shared && (held[0].conn.last_stream != old_stream || held[0].conn.decoder.last != old_decoder
      || held[0].conn.decoder.bytes[0] != 1u8 || held[0].conn.payload[1] != 4u8
      || held[0].conn.a0[0] != 10 || held[0].conn.a4[0] != 14 || held[0].conn.n16 != 16
      || held[0].out[0] != 5u8 || held[0].events[0] != 6)) {
      return 5;
    }
  }
  let allocated = __heap_alloc_count() - before;
  let expected_decoder = steps - 1;
  if (mode == "s") {
    expected_decoder = 0;
  }
  if (mode == "p") {
    expected_decoder = expected_decoder + 2;
  }
  if (mode == "d") {
    expected_decoder = expected_decoder + (steps - 1) % 3;
  }
  if (run.conn.last_stream != steps - 1 || run.conn.decoder.last != expected_decoder
    || run.conn.a0[0] != 10 || run.conn.a1[0] != 11 || run.conn.a2[0] != 12
    || run.conn.a3[0] != 13 || run.conn.a4[0] != 14 || run.conn.n16 != 16
    || run.conn.decoder.bytes[0] != 1u8 || run.conn.payload[1] != 4u8 || run.out[0] != 5u8 || run.events[0] != 6) {
    return 4;
  }
  print("mode=" + mode + " steps=" + steps.to_string() + " allocations=" + allocated.to_string());
  return 0;
}
