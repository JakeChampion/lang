// A value match that names a variant in two arms, with the literals of its
// payload, after an early return.
function of_result(r: Result[boolean, string], n: i32): i32 {
  if (n == 7) {
    return 0;
  }
  return match (r) {
    Err(_) => 1,
    Ok(true) => 2,
    Ok(false) => 3,
  };
}

function of_option(r: Option[boolean], n: i32): i32 {
  if (n == 7) {
    return 0;
  }
  return match (r) {
    Some(true) => 2,
    None => 1,
    Some(false) => 3,
  };
}

// The exit code is 84: the digits 2, 3, 1 and 0 in base 3, for each match.
// wasmtime takes exit codes below 126 only.
function main(): i32 {
  let a = of_result(Ok(true), 1) * 27 + of_result(Ok(false), 1) * 9 + of_result(Err("x"), 1) * 3 + of_result(Ok(true), 7);
  let b = of_option(Some(true), 1) * 27 + of_option(Some(false), 1) * 9 + of_option(None, 1) * 3 + of_option(None, 7);
  return if (a == b) { a } else { 0 };
}
