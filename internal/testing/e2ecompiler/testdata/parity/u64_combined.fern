// Combined (#2904 repro): unsigned compare + logical shift + unsigned div in
// one program, summed as 1 + 10 + 100 = 111.
function main(): i32 {
    let one: u64 = 1 as u64;
    let big: u64 = one << 63;
    let r: i32 = 0;
    if (big > one) { r = r + 1; }
    let sh: u64 = big >> 62;
    if (sh == (2 as u64)) { r = r + 10; }
    let q: u64 = big / (2 as u64);
    if (q == (one << 62)) { r = r + 100; }
    return r;
}
