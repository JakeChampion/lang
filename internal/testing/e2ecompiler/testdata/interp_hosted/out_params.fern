


import "std/i32";

function recv_wrapped(fd: i32, buf: u8[]): i32 {
  return recv_inner(fd, buf);
}

function recv_inner(fd: i32, into: u8[]): i32 {
  return tcp_recv_into(fd, into);
}



function recv_twice(c: i32, s: i32, buf: u8[]): i32 {
  let sent: i32 = tcp_send_bytes(c, "1".bytes());
  let a: i32 = tcp_recv_into(s, buf);
  sent = sent + tcp_send_bytes(c, "2".bytes());
  return sent + a + tcp_recv_into(s, buf);
}

function rebinds(buf: u8[]): i32 {
  buf = [9u8, 9u8];
  return buf.len();
}

function text(b: u8[], n: i32): string {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

function main(): i32 {
  let lo: u8[] = [127u8, 0u8, 0u8, 1u8];
  let ls: i32 = tcp_listen_with(lo, 0, 16, false);
  let c: i32 = tcp_connect_with(lo, tcp_local_port(ls), false);
  let s: i32 = tcp_accept(ls);
  let buf: u8[] = __alloc_u8(8);
  print(f"send: {tcp_send_bytes(c, "direct".bytes())}");
  let n: i32 = tcp_recv_into(s, buf);
  print("direct: " + text(buf, n));
  print(f"send: {tcp_send_bytes(c, "wrapped".bytes())}");
  let m: i32 = recv_wrapped(s, buf);
  print("wrapped: " + text(buf, m));
  print(f"rebinds: {rebinds(buf)} kept: {buf[0]}");
  print(f"send: {tcp_send_bytes(c, "x".bytes())}");
  let k: i32 = tcp_recv_into(s, buf);
  print(f"after one byte: {text(buf, k)} {buf[1]}");
  print(f"twice: {recv_twice(c, s, buf)} {text(buf, 1)}");
  let r: i32 = reactor_new();
  print(f"watch: {reactor_ctl(r, 1, s, 1)}");
  print(f"send: {tcp_send_bytes(c, "ready".bytes())}");
  let events: i32[] = [0, 0, 0, 0];
  let got: i32 = reactor_wait(r, events, 1000);
  print(f"reactor_wait: {got} readiness {events[1]} fd matches {events[0] == s}");
  print(f"close: {tcp_close(c)} {tcp_close(s)} {tcp_close(ls)} {reactor_ctl(r, 3, 0, 0)}");
  let u: i32 = udp_bind(lo, 0);
  print(f"udp_sendto: {udp_sendto(u, lo, tcp_local_port(u), "dgram")}");
  let dbuf: u8[] = __alloc_u8(16);
  let from: u8[] = __alloc_u8(19);
  let dn: i32 = udp_recvfrom(u, dbuf, from);
  print(f"udp_recvfrom: {text(dbuf, dn)} family {from[0]} addr {from[1]}.{from[2]}.{from[3]}.{from[4]}");
  print(f"udp close: {tcp_close(u)}");
  return 0;
}
