struct Holder { buffers: u8[][] }

struct Datagram { data: u8[], from: u8[] }

function main(): i32 {
  unsafe {
    let address: u8[] = [127u8, 0u8, 0u8, 1u8];
    let listener: i32 = tcp_listen_with(address, 0, 16, false);
    assert(listener >= 0);
    let sender: i32 = tcp_connect_with(address, tcp_local_port(listener), false);
    assert(sender >= 0);
    let receiver: i32 = tcp_accept(listener);
    assert(receiver >= 0);
    let values: u8[] = __alloc_u8(4);
    let slot: Cell[u8[]] = cell_new(values);
    let captured: u8[] = values;
    let read = (): u8 => captured[0];
    assert(tcp_send_bytes(sender, [65u8]) == 1);
    assert(tcp_recv_into(receiver, values) == 1);
    assert(slot.get()[0] == 65u8 && captured[0] == 65u8 && read() == 65u8);
    assert(tcp_send_bytes(sender, [66u8]) == 1);
    assert(tcp_recv_into(receiver, slot.get()) == 1);
    assert(values[0] == 66u8 && read() == 66u8);
    let holder: Cell[Holder] = cell_new(Holder { buffers: [values] });
    assert(tcp_send_bytes(sender, [67u8]) == 1);
    assert(tcp_recv_into(receiver, holder.get().buffers[0]) == 1);
    assert(values[0] == 67u8 && slot.get()[0] == 67u8 && read() == 67u8);
    captured = __alloc_u8(2);
    slot.set(captured);
    assert(read() == 0u8 && values[0] == 67u8);
    assert(tcp_send_bytes(sender, [68u8]) == 1);
    assert(tcp_recv_into(receiver, slot.get()) == 1);
    assert(read() == 68u8 && captured[0] == 68u8 && values[0] == 67u8);
    assert(tcp_close(sender) == 0 && tcp_close(receiver) == 0 && tcp_close(listener) == 0);

    let udp: i32 = udp_bind(address, 0);
    assert(udp >= 0);
    let data: u8[] = __alloc_u8(4);
    let from: u8[] = __alloc_u8(19);
    let datagram: Cell[Datagram] = cell_new(Datagram { data: data, from: from });
    let current: u8[] = data;
    let read_udp = (): u8 => current[0];
    assert(udp_sendto(udp, address, tcp_local_port(udp), "A") == 1);
    assert(udp_recvfrom(udp, datagram.get().data, datagram.get().from) == 1);
    assert(data[0] == 65u8 && read_udp() == 65u8 && from[0] == 4u8 && from[1] == 127u8);
    assert(udp_sendto(udp, address, tcp_local_port(udp), "B") == 1);
    assert(udp_recvfrom(udp, data, from) == 1);
    assert(datagram.get().data[0] == 66u8 && datagram.get().from[1] == 127u8);
    current = __alloc_u8(4);
    datagram.set(Datagram { data: current, from: from });
    assert(udp_sendto(udp, address, tcp_local_port(udp), "C") == 1);
    assert(udp_recvfrom(udp, datagram.get().data, datagram.get().from) == 1);
    assert(read_udp() == 67u8 && current[0] == 67u8 && data[0] == 66u8);
    assert(tcp_close(udp) == 0);
    print("managed interpreter socket identity pass");
    return 0;
  }
}
