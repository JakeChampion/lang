struct Holder { values: u8[], nested: u8[][] }

function main(): i32 {
  unsafe {
    let values: u8[] = [1u8, 2u8, 3u8, 4u8];
    let view: [u8] = values[1:3];
    let slot: Cell[u8[]] = cell_new(values);
    __arr_set_len(values, 2);
    assert(slot.get().len() == 2);
    __arr_set_len(slot.get(), 3);
    assert(values.len() == 3);
    let holder: Cell[Holder] = cell_new(Holder { values: values, nested: [values] });
    __arr_set_len(holder.get().values, 4);
    assert(values.len() == 4 && slot.get().len() == 4);
    assert(holder.get().nested[0].len() == 4 && holder.get().nested[0][2] == 3u8);
    let captured: u8[] = values;
    let read = (): i32 => captured.len();
    __arr_set_len(captured, 1);
    assert(read() == 1 && captured.len() == 1);
    assert(view.len() == 2 && view[1] == 3u8);
    captured = [9u8, 8u8];
    assert(read() == 2 && values.len() == 1);
    __arr_set_len(captured, 1);
    assert(read() == 1 && captured[0] == 9u8);
    print("managed interpreter array identity pass");
    return 0;
  }
}
