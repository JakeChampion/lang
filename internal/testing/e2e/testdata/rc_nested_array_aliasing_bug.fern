







































struct BodyLine { text: string, line: i32 }
struct ChunkDef { name: string, body: BodyLine[] }
struct ExOk { lines: string[] }
struct ExErr { msg: string, line: i32 }
type Res = ExOk | ExErr;

function split_lines(src: string): string[] {
    let out: string[] = []; let n: i32 = src.len(); let start: i32 = 0; let i: i32 = 0;
    while (i < n) { if (src[i] == 10) { out = out.append(slice_unchecked(src, start, i) + ""); start = i + 1; } i = i + 1; }
    if (start < n) { out = out.append(slice_unchecked(src, start, n) + ""); }
    return out;
}
function trim(s: string): string {
    let a: i32 = 0; let b: i32 = s.len();
    while (a < b && (s[a] == 32 || s[a] == 9)) { a = a + 1; }
    while (b > a && (s[b-1] == 32 || s[b-1] == 9)) { b = b - 1; }
    return slice_unchecked(s, a, b) + "";
}
function leading_ws(s: string): string {
    let i: i32 = 0; let n: i32 = s.len();
    while (i < n && (s[i] == 32 || s[i] == 9)) { i = i + 1; }
    return slice_unchecked(s, 0, i) + "";
}
function is_header(t: string): boolean { return t.len() >= 3 && slice_unchecked(t, 0, 2) == "<<" && slice_unchecked(t, t.len()-3, t.len()) == ">>="; }
function header_name(t: string): string { return trim(slice_unchecked(t, 2, t.len() - 3)); }
function is_ref(t: string): boolean { return t.len() > 4 && slice_unchecked(t, 0, 2) == "<<" && slice_unchecked(t, t.len()-2, t.len()) == ">>"; }
function ref_name(t: string): string { return trim(slice_unchecked(t, 2, t.len() - 2)); }
function header_index(body: BodyLine[]): i32 {
    let i: i32 = 0;
    while (i < body.len()) { let t: string = trim(body[i].text); if (t.len() == 0) { i = i + 1; } else { if (is_header(t)) { return i; } return 0 - 1; } }
    return 0 - 1;
}
function parse_defs(src: string): ChunkDef[] {
    let defs: ChunkDef[] = []; let lines: string[] = split_lines(src); let n: i32 = lines.len(); let i: i32 = 0;
    while (i < n) {
        if (lines[i].len() >= 3 && slice_unchecked(lines[i], 0, 3) == "```") {
            let body: BodyLine[] = []; let i2: i32 = i + 1;
            while (i2 < n && !(lines[i2].len() >= 3 && slice_unchecked(lines[i2], 0, 3) == "```")) { body = body.append(BodyLine { text: lines[i2], line: i2 + 1 }); i2 = i2 + 1; }
            let hidx: i32 = header_index(body);
            if (hidx >= 0) {
                let name: string = header_name(trim(body[hidx].text));
                let def_body: BodyLine[] = []; let k: i32 = hidx + 1;
                while (k < body.len()) { def_body = def_body.append(body[k]); k = k + 1; }
                defs = defs.append(ChunkDef { name: name, body: def_body });
            }
            if (i2 < n) { i = i2 + 1; } else { i = i2; }
        } else { i = i + 1; }
    }
    return defs;
}
function chunk_defined(defs: ChunkDef[], name: string): boolean { let i: i32 = 0; while (i < defs.len()) { if (defs[i].name == name) { return true; } i = i + 1; } return false; }
function stack_has(stack: string[], name: string): boolean { let i: i32 = 0; while (i < stack.len()) { if (stack[i] == name) { return true; } i = i + 1; } return false; }
function expand(defs: ChunkDef[], name: string, indent: string, active: string[]): Res {
    if (stack_has(active, name)) { return ExErr { msg: "cyc", line: 0 }; }
    let active2: string[] = active.append(name); let out: string[] = []; let i: i32 = 0;
    while (i < defs.len()) {
        if (defs[i].name == name) {
            let body: BodyLine[] = defs[i].body; let j: i32 = 0;
            while (j < body.len()) {
                let bl: BodyLine = body[j]; let t: string = trim(bl.text);
                if (is_ref(t)) {
                    let rn: string = ref_name(t); if (!chunk_defined(defs, rn)) { return ExErr { msg: "undef", line: bl.line }; }
                    let sub: Res = expand(defs, rn, indent + leading_ws(bl.text), active2);
                    match (sub) { ExOk(o) => { let k: i32 = 0; while (k < o.lines.len()) { out = out.append(o.lines[k]); k = k + 1; } }, _ => { return sub; } }
                } else { out = out.append(indent + bl.text); }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return ExOk { lines: out };
}
function main(): i32 {
    let d: ChunkDef[] = parse_defs("```\n<<*>>=\nfn main() {}\n```\n");
    let e: string[] = [];
    let r: Res = expand(d, "*", "", e);
    match (r) { ExOk(o) => { return o.lines[0].len(); }, _ => { return 88; } }
}
