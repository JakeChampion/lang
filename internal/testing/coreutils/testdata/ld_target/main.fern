



import "../../../../../coreutils/lib/ld" as ld;

function mant(): i32 {
    return ld.format().mant;
}

function emax(): i32 {
    return ld.format().emax;
}

function explicit_bit(): i32 {
    if (ld.format().explicit_bit) {
        return 1;
    }
    return 0;
}

function main(): i32 {
    return mant() + emax() + explicit_bit();
}
