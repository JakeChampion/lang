// The native runtime helpers that are written in Fern (#8038). Each function
// here is emitted under its own name as a runtime symbol by every native
// backend, so a helper is one source lowered per target rather than a
// hand-written twin per backend. Bodies bottom out in the provided-callee
// floor (`__load_u8`, `__load_i64`, ...) and never in an operation that would
// lower to a call of the helper being defined.

// wasi:sockets error-code discriminants to Preview 1 errnos. Keep in sync
// with internal/strerror.WasiSocketErrorCodes; its parity test checks all rows.
function __fern_wasi_socket_errno(code: i32): i32 {
    if (code == 0) { return 29; }
    if (code == 1) { return 2; }
    if (code == 2) { return 58; }
    if (code == 3) { return 28; }
    if (code == 4) { return 48; }
    if (code == 5) { return 73; }
    if (code == 6) { return 7; }
    if (code == 7) { return 28; }
    if (code == 8) { return 6; }
    if (code == 9) { return 28; }
    if (code == 10) { return 33; }
    if (code == 11) { return 4; }
    if (code == 12) { return 3; }
    if (code == 13) { return 23; }
    if (code == 14) { return 14; }
    if (code == 15) { return 15; }
    if (code == 16) { return 13; }
    if (code == 17) { return 35; }
    if (code == 18) { return 44; }
    if (code == 19) { return 6; }
    if (code == 20) { return 29; }
    return 29;
}

// __fern_utf8_valid(data, len) is 1 when the `len` bytes at `data` are
// well-formed UTF-8 and 0 otherwise. It accepts exactly what
// std/utf8.is_valid_utf8 accepts: a stray continuation, an overlong 2-, 3- or
// 4-byte form, a surrogate (U+D800..U+DFFF), a lead above 0xF4 and a
// sequence truncated by the end of the buffer all reject. Byte-range
// formulation, no codepoint assembly; a run of ASCII is skipped eight bytes at
// a time.
function __fern_utf8_valid(data: usize, len: usize): i32 {
    var p: usize = data;
    var end: usize = data + len;
    // Every byte's top bit: a word with no bit of this set is all ASCII.
    var mask: u64 = 9259542123273814144 as u64;
    while (p < end) {
        if (end - p >= 8) {
            if (((__load_i64(p) as u64) & mask) == (0 as u64)) {
                p = p + 8;
                continue;
            }
        }
        var b: i32 = __load_u8(p);
        if (b < 128) {
            p = p + 1;
            continue;
        }
        // 0x80..0xBF is a continuation with no lead; 0xC0 / 0xC1 are overlong.
        if (b < 194) { return 0; }
        if (b < 224) {
            // 0xC2..0xDF: one continuation.
            if (p + 2 > end) { return 0; }
            if ((__load_u8(p + 1) & 192) != 128) { return 0; }
            p = p + 2;
            continue;
        }
        if (b < 240) {
            // 0xE0..0xEF: two continuations. The first one's range carries
            // the E0 overlong floor and the ED surrogate ceiling.
            if (p + 3 > end) { return 0; }
            var c1: i32 = __load_u8(p + 1);
            if ((c1 & 192) != 128) { return 0; }
            if ((__load_u8(p + 2) & 192) != 128) { return 0; }
            if (b == 224 && c1 < 160) { return 0; }
            if (b == 237 && c1 >= 160) { return 0; }
            p = p + 3;
            continue;
        }
        // 0xF0..0xF4: three continuations. The first one's range carries the
        // F0 overlong floor and the F4 ceiling at U+10FFFF.
        if (b > 244) { return 0; }
        if (p + 4 > end) { return 0; }
        var d1: i32 = __load_u8(p + 1);
        if ((d1 & 192) != 128) { return 0; }
        if ((__load_u8(p + 2) & 192) != 128) { return 0; }
        if ((__load_u8(p + 3) & 192) != 128) { return 0; }
        if (b == 240 && d1 < 144) { return 0; }
        if (b == 244 && d1 >= 144) { return 0; }
        p = p + 4;
    }
    return 1;
}

// The socket floor (#9853): one body per helper over `__syscall3`, with the
// syscall numbers and the sockaddr layout keyed by target. Each answers a
// descriptor or the kernel's -errno, as the builtins it backs always have.

function __sys_socket(): i32 {
    if (target_arch() == "x86-64") { return 41; }
    if (target_os() == "darwin") { return 97; }
    return 198;
}
function __sys_bind(): i32 {
    if (target_arch() == "x86-64") { return 49; }
    if (target_os() == "darwin") { return 104; }
    return 200;
}
function __sys_listen(): i32 {
    if (target_arch() == "x86-64") { return 50; }
    if (target_os() == "darwin") { return 106; }
    return 201;
}
function __sys_accept(): i32 {
    if (target_arch() == "x86-64") { return 43; }
    if (target_os() == "darwin") { return 30; }
    return 202;
}
function __sys_connect(): i32 {
    if (target_arch() == "x86-64") { return 42; }
    if (target_os() == "darwin") { return 98; }
    return 203;
}
function __sys_getsockname(): i32 {
    if (target_arch() == "x86-64") { return 51; }
    if (target_os() == "darwin") { return 32; }
    return 204;
}
function __sys_close(): i32 {
    if (target_arch() == "x86-64") { return 3; }
    if (target_os() == "darwin") { return 6; }
    return 57;
}

// A sockaddr_in in a fresh 16-byte block: Darwin leads with sin_len and a
// one-byte family, Linux with a two-byte family; then the port in network
// order, the address as its packed network-order bytes, and eight zero bytes.
function __sockaddr_in(port: i32, host_be: i32): usize {
    var sa: usize = __alloc(16);
    if (target_os() == "darwin") {
        __store_u8(sa, 16);
        __store_u8(sa + 1, 2);
    } else {
        __store_u8(sa, 2);
        __store_u8(sa + 1, 0);
    }
    __store_u8(sa + 2, (port >> 8) & 255);
    __store_u8(sa + 3, port & 255);
    __store_u8(sa + 4, host_be & 255);
    __store_u8(sa + 5, (host_be >> 8) & 255);
    __store_u8(sa + 6, (host_be >> 16) & 255);
    __store_u8(sa + 7, (host_be >> 24) & 255);
    var z: usize = 8;
    while (z < 16) {
        __store_u8(sa + z, 0);
        z = z + 1;
    }
    return sa;
}

// __fern_tcp_listen(port) is a socket listening on 0.0.0.0:port with a
// backlog of 128, or the -errno of the step that failed with the socket
// closed again.
function __fern_tcp_listen(port: i32): i32 {
    var fd: i64 = __syscall3(__sys_socket(), 2, 1, 0);
    if (fd < 0) { return fd as i32; }
    var sa: usize = __sockaddr_in(port, 0);
    var r: i64 = __syscall3(__sys_bind(), fd, sa as i64, 16);
    if (r >= 0) { r = __syscall3(__sys_listen(), fd, 128, 0); }
    __free(sa, 16);
    if (r < 0) {
        __syscall3(__sys_close(), fd, 0, 0);
        return r as i32;
    }
    return fd as i32;
}

// __fern_tcp_connect(host_be, port) is a socket connected to the IPv4
// address packed in network order, or -errno with the socket closed again.
function __fern_tcp_connect(host_be: i32, port: i32): i32 {
    var fd: i64 = __syscall3(__sys_socket(), 2, 1, 0);
    if (fd < 0) { return fd as i32; }
    var sa: usize = __sockaddr_in(port, host_be);
    var r: i64 = __syscall3(__sys_connect(), fd, sa as i64, 16);
    __free(sa, 16);
    if (r < 0) {
        __syscall3(__sys_close(), fd, 0, 0);
        return r as i32;
    }
    return fd as i32;
}

function __fern_tcp_accept(fd: i32): i32 {
    return __syscall3(__sys_accept(), fd as i64, 0, 0) as i32;
}

function __fern_tcp_close(fd: i32): i32 {
    return __syscall3(__sys_close(), fd as i64, 0, 0) as i32;
}

// A native pollable is the descriptor itself.
function __fern_tcp_pollable(fd: i32): i32 {
    return fd;
}

// __fern_tcp_local_port(fd) reads the bound port back through getsockname:
// the two network-order bytes at offset 2 of the address, which sit there on
// Darwin too, since sin_len displaces the family and not the port. The
// socklen_t the call reads and writes follows the address in the same block.
function __fern_tcp_local_port(fd: i32): i32 {
    var sa: usize = __alloc(20);
    __store_i32(sa + 16, 16);
    var r: i64 = __syscall3(__sys_getsockname(), fd as i64, sa as i64, (sa + 16) as i64);
    var port: i32 = (__load_u8(sa + 2) << 8) | __load_u8(sa + 3);
    __free(sa, 20);
    if (r < 0) { return r as i32; }
    return port;
}
