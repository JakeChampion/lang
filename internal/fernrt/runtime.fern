function __fern_tcp_pollable(fd: i32): i32 {
    return fd;
}

// The reactor floor (#9853): a readiness set that outlives one wait, epoll
// on Linux and kqueue on Darwin. `reactor_new()` is the set's descriptor,
// `reactor_ctl(r, op, fd, arg)` changes it (op 1 watches fd for the
// interest in arg, 1 readable and 2 writable, op 2 stops watching it, op 3
// closes the set) and `reactor_wait(r, events, timeout_ms)` fills `events`
