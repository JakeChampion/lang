    if (target_arch() == "x86-64") { return 291; }
    return 20;
}
function __sys_epoll_ctl(): i32 {
    if (target_arch() == "x86-64") { return 233; }
    return 21;
}
function __sys_epoll_pwait(): i32 {
    if (target_arch() == "x86-64") { return 281; }
    return 22;
}
function __sys_kqueue(): i32 { return 362; }
function __sys_kevent(): i32 { return 363; }
function __sys_rt_sigaction(): i32 {
    if (target_arch() == "x86-64") { return 13; }
    if (target_os() == "darwin") { return 46; }
    return 134;
}
function __sys_rt_sigprocmask(): i32 {
    if (target_arch() == "x86-64") { return 14; }
    if (target_os() == "darwin") { return 48; }
    return 135;
}
function __sys_signalfd4(): i32 {
    if (target_arch() == "x86-64") { return 289; }
    return 74;
}

// struct epoll_event is packed on x86-64 (12 bytes, data at 4) and
// naturally aligned on arm64 (16 bytes, data at 8).
function __epoll_event_size(): i32 {
    if (target_arch() == "x86-64") { return 12; }
    return 16;
}
function __epoll_data_at(): i32 {
    if (target_arch() == "x86-64") { return 4; }
    return 8;
