    __store_u8(p + 8, filter & 255);
    __store_u8(p + 9, (filter >> 8) & 255);
    __store_u8(p + 10, flags & 255);
    __store_u8(p + 11, (flags >> 8) & 255);
    __store_i32(p + 12, 0);
    __store_i32(p + 16, 0);
    __store_i32(p + 20, 0);
    __store_i32(p + 24, 0);
    __store_i32(p + 28, 0);
    return 0;
