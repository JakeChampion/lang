    if (fd < 0) { return fd as i32; }
    var r: i32 = __connect_v4(fd, host_be, port) as i32;
    if (r >= 0) { r = __send_str(fd as i32, data, 0 as usize, 0); }
    __syscall3(__sys_close(), fd, 0, 0);
    return r;
}
