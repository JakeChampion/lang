// chcon's context arithmetic, `coreutils/lib/selinux.fern`'s merge_context,
// over inputs no machine without SELinux can reach through chcon itself:
// internal/coreutils/selinux_merge_test.go runs this and compares each line.
import "../../../../coreutils/lib/selinux" as selinux;

function show(ctx: string, comps: string[], set: boolean[]): void {
  match (selinux.merge_context(ctx, comps, set)) {
    Ok(c) => {
      print("ok " + c);
    },
    Err(msgs) => {
      for m in msgs {
        print("err " + m);
      }
    }
  }
}

function main(): i32 {
  let none: string[] = ["", "", "", ""];
  show("u:r:t:s0", ["x", "", "", ""], [true, false, false, false]);
  show("u:r:t", ["", "", "", "s0:c1"], [false, false, false, true]);
  show("u:r:t:s0:c0.c1023", ["", "", "y_t", ""], [false, false, true, false]);
  show("u:r:t:s0", none, [false, false, false, false]);
  show("u:r", ["x", "", "", ""], [true, false, false, false]);
  show("u:r:t:a:b:c:d", ["x", "", "", ""], [true, false, false, false]);
  show("u r:r:t", ["x", "", "", ""], [true, false, false, false]);
  show("u:r:t", ["a:b", "", "", ""], [true, false, false, false]);
  show("u:r:t", ["", "", "", "s0 c1"], [false, false, false, true]);
  show("u:r:t", ["", "a b", "c:d", ""], [false, true, true, false]);
  show("u:r:t:s0", ["", "", "", ""], [true, false, false, false]);
  return 0;
}
