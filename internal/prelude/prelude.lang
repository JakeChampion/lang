// === Range generators ===
//
// `range(start, end)` — i32[] of [start, end). Empty if
// start >= end. Standard half-open range.
// `range_step(start, end, step)` — same as range but with
// arbitrary positive step. Step <= 0 returns empty (no
// reverse ranges — use a manual while loop for that).

function range(start: i32, end: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = start;
    while (i < end) {
        out = out.push(i);
        i = i + 1;
    }
    return out;
}

function range_step(start: i32, end: i32, step: i32): i32[] {
    var out: i32[] = [];
    if (step <= 0) { return out; }
    var i: i32 = start;
    while (i < end) {
        out = out.push(i);
        i = i + step;
    }
    return out;
}


