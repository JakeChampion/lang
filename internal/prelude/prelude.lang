// Auto-injected standard library. See internal/prelude/prelude.go
// for the rationale; in short, helpers here go through the IR like
// any user code, so they get peephole / dce / inline optimisation
// and drop into every backend without backend-specific shims.
//
// User code can shadow / override anything in this file by
// declaring a same-named function — useful for testing or for
// callers that need different semantics (eg a stricter
// `s.parse_int()` that errors on whitespace).
//
// stdlib imports here are auto-followed by `injectPrelude` (see
// `internal/checker/checker.go`). Methods migrated out of the
// prelude into `std/…` modules during the prelude-to-modules
// migration (docs/PRELUDE-TO-MODULES.md) come back in this way
// so existing programs keep working without changes. The
// `injectPrelude` path dedupes against `ast.Program.LoadedStdlibPaths`
// so a user program that explicitly `import`s the same stdlib
// module via modload doesn't get a "method redeclared" error.
import "std/i32";
import "std/i64";
import "std/u32";
import "std/u64";
import "std/string";
import "std/array";




// `repeat_char(ch, n)` — fresh string of n copies of the byte
// `ch`. Faster than `(c).chr().repeat(n)` would be (no chr
// helper exists yet; this is the substitute). `n <= 0`
// returns empty.
function repeat_char(ch: i32, n: i32): string {
    if (n <= 0) { return ""; }
    var buf: u8[] = __alloc_u8(n);
    var i: i32 = 0;
    while (i < n) {
        buf[i] = ch as u8;
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// `http_status_text(code)` — IANA reason phrase for the
// common HTTP status codes (RFC 9110). Returns "" for
// unknown codes — callers should fall back to a generic
// phrase rather than emitting nothing.
function http_status_text(code: i32): string {
    if (code == 200) { return "OK"; }
    if (code == 201) { return "Created"; }
    if (code == 204) { return "No Content"; }
    if (code == 301) { return "Moved Permanently"; }
    if (code == 302) { return "Found"; }
    if (code == 304) { return "Not Modified"; }
    if (code == 307) { return "Temporary Redirect"; }
    if (code == 308) { return "Permanent Redirect"; }
    if (code == 400) { return "Bad Request"; }
    if (code == 401) { return "Unauthorized"; }
    if (code == 403) { return "Forbidden"; }
    if (code == 404) { return "Not Found"; }
    if (code == 405) { return "Method Not Allowed"; }
    if (code == 408) { return "Request Timeout"; }
    if (code == 409) { return "Conflict"; }
    if (code == 410) { return "Gone"; }
    if (code == 413) { return "Payload Too Large"; }
    if (code == 415) { return "Unsupported Media Type"; }
    if (code == 418) { return "I'm a teapot"; }
    if (code == 422) { return "Unprocessable Entity"; }
    if (code == 429) { return "Too Many Requests"; }
    if (code == 500) { return "Internal Server Error"; }
    if (code == 501) { return "Not Implemented"; }
    if (code == 502) { return "Bad Gateway"; }
    if (code == 503) { return "Service Unavailable"; }
    if (code == 504) { return "Gateway Timeout"; }
    return "";
}

// `is_valid_http_status(code)` — true if code is in the RFC
// 9110 range of [100, 599]. The full HTTP status range is
// 100..999 by the BNF but only the first three centuries
// have semantic meaning; servers shouldn't emit codes
// outside [100, 599].
function is_valid_http_status(code: i32): boolean {
    return code >= 100 && code <= 599;
}

// `http_response_ok(body)` — 200 OK with the given body.
// `http_response_text(status, body)` — explicit status code.
// `http_response_not_found()` — common 404 builder.
// Saves the `HttpResponse { status: 200, body: ... }` boiler-
// plate at every handler call site.
function http_response_ok(body: string): HttpResponse {
    return HttpResponse { status: 200, body: body };
}

function http_response_text(status: i32, body: string): HttpResponse {
    return HttpResponse { status: status, body: body };
}

function http_response_not_found(): HttpResponse {
    return HttpResponse { status: 404, body: "Not Found" };
}

// `http_response_bad_request(body)` — 400 with the given
// body. Common shape for validation-failure responses.
function http_response_bad_request(body: string): HttpResponse {
    return HttpResponse { status: 400, body: body };
}

// `http_response_internal_error(body)` — 500. The default
// body shape for unhandled / unexpected exceptions in a
// handler.
function http_response_internal_error(body: string): HttpResponse {
    return HttpResponse { status: 500, body: body };
}

// `http_response_redirect(location)` — 302 Found with the
// redirect target in the body. Callers that serialize the
// response can copy `body` into a `Location:` header.
// Convention placeholder until HTTP headers are first-class.
function http_response_redirect(location: string): HttpResponse {
    return HttpResponse { status: 302, body: location };
}

// `http_response_no_content()` — 204 No Content, empty
// body. The standard "I handled it, nothing to say"
// response for DELETE / PUT / etc.
function http_response_no_content(): HttpResponse {
    return HttpResponse { status: 204, body: "" };
}

// `http_path_segments(path)` — split an HTTP path into
// non-empty components. Drops the leading "/" and any
// double slashes; query string (`?...`) is also stripped.
// Useful for simple routing — `/api/users/42` → `["api",
// "users", "42"]`.
function http_path_segments(path: string): string[] {
    var n: i32 = len(path);
    // Strip query string.
    var q: i32 = path.index_of("?");
    if (q >= 0) { n = q; }
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        while (i < n && path[i] == 47) { i = i + 1; }   // skip /
        if (i >= n) { return out; }
        var start: i32 = i;
        while (i < n && path[i] != 47) { i = i + 1; }
        out = out.push(path[start:i]);
    }
    return out;
}

// `http_url_path_only(path)` — strip the query string
// (everything from the first `?` onward). Returns path
// unchanged when there's no query. Companion to
// http_path_segments when callers want the bare path
// without splitting.
function http_url_path_only(path: string): string {
    var q: i32 = path.index_of("?");
    if (q < 0) { return path; }
    return path[0:q];
}

// `http_user_agent_is_bot(ua)` — heuristic bot detection
// via the User-Agent string. Checks for common bot tokens
// ("bot", "crawler", "spider", "slurp") case-insensitively.
// False negatives are common (sophisticated bots forge UAs);
// false positives possible (a browser called "BotSimulator").
// Use as a hint, not a security control.
function http_user_agent_is_bot(ua: string): boolean {
    if (ua.contains_ci("bot")) { return true; }
    if (ua.contains_ci("crawler")) { return true; }
    if (ua.contains_ci("spider")) { return true; }
    if (ua.contains_ci("slurp")) { return true; }
    return false;
}

// === Random integer in range ===
//
// `random_int(lo, hi)` — random i32 in [lo, hi). Returns `lo`
// when hi <= lo (empty range fallback). Pulls 3 bytes from
// random_bytes (kernel CSPRNG on natives, wasi_random on
// wasm), combines into a 24-bit value, and modulo-maps to
// the range width. 24 bits caps the maximum bias-free range
// at ~16M which covers the common short-range use cases
// (port pick, ID generation, jitter). Stays at 24 bits
// rather than 32 because the natives' u32 modulo path goes
// signed when the high bit is set — a real codegen bug, but
// 24-bit randomness sidesteps it.
function random_int(lo: i32, hi: i32): i32 {
    if (hi <= lo) { return lo; }
    var b: string = random_bytes(3);
    var u: u32 = ((b[0] as u32) << (16 as u32)) |
                 ((b[1] as u32) << (8 as u32)) |
                 (b[2] as u32);
    var range: u32 = (hi - lo) as u32;
    return lo + ((u % range) as i32);
}

// === Human-readable byte size ===
//
// `format_bytes(n)` — render an i32 byte count as "N B" /
// "N KiB" / "N MiB" / "N GiB" using binary (1024-based)
// prefixes. Integer truncation only — for "1.5 KiB" the
// caller can divide by 1024 themselves and apply
// to_string_padded. Negative input is rendered with a
// leading "-" before the unit ("-512 B"). i32 caps the
// representable range at ~2 GiB which covers the common
// CLI / log use case; callers needing larger sizes can
// drop down to manual i64 div + to_string.
function format_bytes(n: i32): string {
    var neg: boolean = (n < 0);
    var mag: i32 = n;
    if (neg) { mag = n.abs(); }
    var sign: string = "";
    if (neg) { sign = "-"; }
    if (mag < 1024) {
        return sign + mag.to_string() + " B";
    }
    if (mag < 1024 * 1024) {
        return sign + (mag / 1024).to_string() + " KiB";
    }
    if (mag < 1024 * 1024 * 1024) {
        return sign + (mag / (1024 * 1024)).to_string() + " MiB";
    }
    return sign + (mag / (1024 * 1024 * 1024)).to_string() + " GiB";
}

// `format_duration_ms(ms)` — human-readable duration like
// "1h 23m 45s" / "500ms". Components are emitted only when
// non-zero, separated by spaces; "0" alone returns "0ms".
// Negative ms gets a leading "-" before the magnitude.
function format_duration_ms(ms: i32): string {
    if (ms == 0) { return "0ms"; }
    var neg: boolean = (ms < 0);
    var mag: i32 = ms;
    if (neg) { mag = ms.abs(); }
    var sign: string = "";
    if (neg) { sign = "-"; }
    var h: i32 = mag / 3600000;
    var rem: i32 = mag - h * 3600000;
    var m: i32 = rem / 60000;
    rem = rem - m * 60000;
    var s: i32 = rem / 1000;
    var msPart: i32 = rem - s * 1000;
    var out: string = "";
    if (h > 0) { out = out + h.to_string() + "h"; }
    if (m > 0) {
        if (len(out) > 0) { out = out + " "; }
        out = out + m.to_string() + "m";
    }
    if (s > 0) {
        if (len(out) > 0) { out = out + " "; }
        out = out + s.to_string() + "s";
    }
    if (msPart > 0) {
        if (len(out) > 0) { out = out + " "; }
        out = out + msPart.to_string() + "ms";
    }
    return sign + out;
}

// === CSV escape / join ===
//
// `csv_escape(s)` — return a CSV field per RFC 4180. Fields
// containing comma / double-quote / newline get wrapped in
// "..." with interior quotes doubled. Other inputs pass
// through unchanged.
// `csv_join(arr)` — join with "," after escaping each field.
function csv_escape(s: string): string {
    if (s.index_of(",") < 0 && s.index_of("\"") < 0 &&
        s.index_of("\n") < 0 && s.index_of("\r") < 0) {
        return s;
    }
    return "\"" + s.replace("\"", "\"\"") + "\"";
}

function csv_join(arr: string[]): string {
    var n: i32 = len(arr);
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        if (i > 0) { out = out + ","; }
        out = out + csv_escape(arr[i]);
        i = i + 1;
    }
    return out;
}

// `csv_parse_line(s)` — RFC 4180 parser for a single line.
// Splits on `,`, but a field wrapped in `"..."` may contain
// commas / newlines, and `""` inside a quoted field decodes
// to a single `"`. Returns the field list with quotes
// stripped + escapes unescaped. Newlines in the input
// terminate the line — parsing a multi-line CSV requires
// pre-splitting on \n EXCEPT inside quoted fields, which
// is a more complex parser left for a follow-up. For the
// common single-line case (CSV header / a single record)
// this helper covers the surface.
function csv_parse_line(s: string): string[] {
    var out: string[] = [];
    var n: i32 = len(s);
    var i: i32 = 0;
    var field: string = "";
    var in_quotes: boolean = false;
    while (i < n) {
        var c: i32 = s[i];
        if (in_quotes) {
            if (c == 34) {
                // Doubled quote → literal "
                if (i + 1 < n && s[i + 1] == 34) {
                    field = field + "\"";
                    i = i + 2;
                } else {
                    in_quotes = false;
                    i = i + 1;
                }
            } else {
                field = field + s[i:i + 1];
                i = i + 1;
            }
        } else {
            if (c == 44) {
                out = out.push(field);
                field = "";
                i = i + 1;
            } else if (c == 34 && len(field) == 0) {
                in_quotes = true;
                i = i + 1;
            } else {
                field = field + s[i:i + 1];
                i = i + 1;
            }
        }
    }
    return out.push(field);
}

// `http_header_value(headers, key)` — Option[string] for the
// value of a case-insensitive header lookup. Headers are
// expected to be the raw HTTP header block separated by
// CRLF, key:value pairs. Trim whitespace around the value.
// Returns the FIRST matching header; for multi-valued
// headers callers need a richer parser.
function http_header_value(headers: string, key: string): Option[string] {
    var lines: string[] = headers.split("\r\n");
    var n: i32 = len(lines);
    var i: i32 = 0;
    while (i < n) {
        match (lines[i].split_once(":")) {
            Some(p) => {
                if (p.0.eq_ignore_ascii_case(key)) {
                    return Some(p.1.trim());
                }
            },
            None => { },
        }
        i = i + 1;
    }
    return None;
}

// === Logging convenience ===
//
// Three thin wrappers around eprint with a level prefix.
// The output goes to stderr so it interleaves with diagnostic
// output rather than the program's actual output stream.
// Format: "[LEVEL] msg\n".
function log_info(msg: string) {
    eprint("[INFO] " + msg);
}

function log_warn(msg: string) {
    eprint("[WARN] " + msg);
}

function log_error(msg: string) {
    eprint("[ERROR] " + msg);
}


// `s.trim()` — strip leading + trailing ASCII whitespace
// (SP, TAB, LF, CR, VT, FF). UTF-8 multibyte sequences
// pass through unchanged because their leading bytes are
// all >= 0x80, none of which are whitespace. Returns a
// fresh slice via the `s[a:b]` lowering.

function __is_ascii_ws(b: i32): boolean {
    return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
}

// i32 / byte (i32) receiver methods migrated out into
// `std/i32` — see the `import "std/i32";` at the top of
// this file. `injectPrelude` follows that import and brings
// every `pub` method back into universal-visibility scope
// so existing programs that call `.abs()` / `.clamp(…)` /
// `.is_digit()` / etc. continue to work unchanged.
//
// === i64 power / gcd / lcm (parity with i32) ===


// === Range generators ===
//
// `range(start, end)` — i32[] of [start, end). Empty if
// start >= end. Standard half-open range.
// `range_step(start, end, step)` — same as range but with
// arbitrary positive step. Step <= 0 returns empty (no
// reverse ranges — use a manual while loop for that).

function range(start: i32, end: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = start;
    while (i < end) {
        out = out.push(i);
        i = i + 1;
    }
    return out;
}

function range_step(start: i32, end: i32, step: i32): i32[] {
    var out: i32[] = [];
    if (step <= 0) { return out; }
    var i: i32 = start;
    while (i < end) {
        out = out.push(i);
        i = i + step;
    }
    return out;
}


// === i64 / u32 / u64 scalar methods ===
//
// Same shape as the i32 helpers above. i64.abs wraps on
// i64::MIN since lang has no i128 to widen into — matches
// Rust wrapping_abs. u32 / u64 have no abs (always non-
// negative). All four numeric widths now have min / max /
// clamp.




// === Numeric range constants ===
//
// Function-style accessors for the width boundaries. Plain
// constants would be cleaner but lang doesn't have a const
// declaration syntax yet; these constant-functions inline at
// the call site via the IR's constant-folding pass.
function i32_max(): i32 { return 2147483647; }
function i32_min(): i32 { return 0 - 2147483647 - 1; }
function i64_max(): i64 { return 9223372036854775807; }
function i64_min(): i64 { return (0 as i64) - 9223372036854775807 - (1 as i64); }


// `sort_i32_asc(arr)` — return a fresh ascending-sorted
// copy of `arr`. Insertion-sort: O(n²) worst case, but
// for the compiler's small-list use cases (sorted field
// offsets, declaration orders, capacity hints) it's fine
// and avoids the closure-arg infrastructure a generic
// `sort_by[T](arr: T[], cmp: (T, T) => i32)` would need.
// `sort_i32_desc` flips the comparison direction.
//
// Free function rather than a method: lang's receiver
// syntax only accepts struct, enum, or built-in types —
// not array types. A future PR can add array-method
// dispatch and re-spell these as `arr.sort_asc()`.
//
// Functional shape (returns a new array) matches the rest
// of the prelude's array conventions (`arr.push` returns a
// new array); the input is not mutated.

function sort_i32_asc(arr: i32[]): i32[] {
    var n: i32 = len(arr);
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.push(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && out[j] > key) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        k = k + 1;
    }
    return out;
}

function sort_i32_desc(arr: i32[]): i32[] {
    var n: i32 = len(arr);
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.push(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: i32 = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && out[j] < key) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        k = k + 1;
    }
    return out;
}

// `string_cmp(a, b)` — lexicographic byte-order comparator.
// Returns -1 / 0 / 1. Lang's `<` / `>` operators only work
// on numerics; string-array sort needs a dedicated three-way
// comparator. Compares byte-by-byte up to the shorter
// length, then breaks ties on length (shorter < longer).
function string_cmp(a: string, b: string): i32 {
    var n: i32 = len(a);
    var m: i32 = len(b);
    var min: i32 = n;
    if (m < n) { min = m; }
    var i: i32 = 0;
    while (i < min) {
        if (a[i] < b[i]) { return 0 - 1; }
        if (a[i] > b[i]) { return 1; }
        i = i + 1;
    }
    if (n < m) { return 0 - 1; }
    if (n > m) { return 1; }
    return 0;
}

// `sort_strings_asc(arr)` / `sort_strings_desc(arr)` —
// lexicographic byte-order sort of a string array. Insertion
// sort like the i32 helpers; O(n²) worst case fine for the
// small-list use cases (config keys, sorted output for
// stable tests, alphabetised CLI flags).
function sort_strings_asc(arr: string[]): string[] {
    var n: i32 = len(arr);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.push(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: string = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && string_cmp(out[j], key) > 0) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        k = k + 1;
    }
    return out;
}

function sort_strings_desc(arr: string[]): string[] {
    var n: i32 = len(arr);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.push(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: string = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && string_cmp(out[j], key) < 0) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        k = k + 1;
    }
    return out;
}

// `string_cmp_ci(a, b)` — same as string_cmp but ASCII case-
// folded per byte. Useful as the ordering for case-insensitive
// sort.
function string_cmp_ci(a: string, b: string): i32 {
    var n: i32 = len(a);
    var m: i32 = len(b);
    var min: i32 = n;
    if (m < n) { min = m; }
    var i: i32 = 0;
    while (i < min) {
        var ca: i32 = a[i].to_lower();
        var cb: i32 = b[i].to_lower();
        if (ca < cb) { return 0 - 1; }
        if (ca > cb) { return 1; }
        i = i + 1;
    }
    if (n < m) { return 0 - 1; }
    if (n > m) { return 1; }
    return 0;
}

// `sort_strings_asc_ci(arr)` — case-insensitive ascending
// sort. Useful for user-facing alphabetical listings where
// case shouldn't fragment the ordering.
function sort_strings_asc_ci(arr: string[]): string[] {
    var n: i32 = len(arr);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) {
        out = out.push(arr[i]);
        i = i + 1;
    }
    var k: i32 = 1;
    while (k < n) {
        var key: string = out[k];
        var j: i32 = k - 1;
        while (j >= 0 && string_cmp_ci(out[j], key) > 0) {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        k = k + 1;
    }
    return out;
}






// `format(fmt, args)` — runtime template substitution. Walks
// fmt byte-by-byte, replacing each `{}` placeholder with the
// next element of args. Extra args (more args than `{}`s) are
// silently dropped; missing args (more `{}`s than args) emit
// the placeholder unchanged. Mirrors Python's `str.format()` /
// Rust's `format!()` minimal subset.
//
// Use cases the f-string sugar doesn't cover:
//   - Dynamic templates (read from a config file, locale
//     table, error catalogue, etc.).
//   - Programs that build their own diagnostic strings —
//     a checker emitting "expected {}, got {}" where the
//     template lives in a const-table rather than at every
//     call site.
//
// Caller pre-stringifies args (`to_string()` for i32 / i64 /
// f32 / f64 / boolean). A typed-overload story would need
// trait dispatch which lang doesn't have yet; the string[]
// signature keeps the type story trivial.
function format(fmt: string, args: string[]): string {
    var n: i32 = len(fmt);
    var out: string = "";
    var i: i32 = 0;
    var argi: i32 = 0;
    while (i < n) {
        if (i + 1 < n && fmt[i] == 123 && fmt[i + 1] == 125) {
            if (argi < len(args)) {
                out = out + args[argi];
                argi = argi + 1;
            } else {
                // Missing arg — emit the literal "{}" so callers
                // can spot the underflow at runtime.
                out = out + "{}";
            }
            i = i + 2;
        } else {
            out = out + fmt[i:i + 1];
            i = i + 1;
        }
    }
    return out;
}


// === Array append ===
//
// `arr.push(v)` is lowered inline by the IR — see
// `emitArrayPush` in `internal/ir/ir.go`. The previous shape
// here was 5 nearly-identical lang-prelude functions
// (`__array_append_string` / `_i64` / `_f64` / `_u8` / `_u16`),
// one per stride class, each ~12 lines of raw-memory pokes;
// the IR now emits the same shape directly (alloc + memcpy +
// width-correct tail store) parameterised over stride. One
// codepath instead of one-per-stride; new array methods
// (concat, reverse, ...) drop in as IR helpers without
// touching the prelude.

// === Decimal int-to-string formatter ===
//
// `int_to_string(n)` — signed-i32 → ASCII decimal. Test
// harness drives it through the `_start` wrapper to print
// `main()`'s return value; user code calls it directly via
// the same name. Pairs with `__int_to_string_u64` below
// for the wider-integer method wrappers.
//
// Algorithm: a 16-byte scratch buffer holds digits written
// backwards from the high end (so the final order comes
// out left-to-right via a single trailing memcpy). The
// negation `n = 0 - n` is unsigned-safe for INT_MIN
// because we then read the result as u32 for the divmod
// chain, and -INT_MIN's unsigned value is exactly
// `2^31`.
function int_to_string(n: i32): string {
    var scratch: u8[] = __alloc_u8(16);
    var scratch_ptr: i32 = scratch as i32;
    var end: i32 = 16;
    var neg: boolean = false;
    if (n < 0) {
        neg = true;
        n = 0 - n;
    }
    var u: u32 = n as u32;
    if (u == (0 as u32)) {
        end = end - 1;
        scratch[end] = 48 as u8;
    } else {
        while (u != (0 as u32)) {
            end = end - 1;
            scratch[end] = (((u % (10 as u32)) as i32) + 48) as u8;
            u = u / (10 as u32);
        }
    }
    if (neg) {
        end = end - 1;
        scratch[end] = 45 as u8;
    }
    var n_bytes: i32 = 16 - end;
    var buf: u8[] = __alloc_u8(n_bytes);
    __memcpy(buf as i32, scratch_ptr + end, n_bytes);
    return string_from_bytes(buf);
}

// `__int_to_string_u64(mag, neg)` — the i64 / u64 cousin.
// `mag` carries the absolute value; `neg` is the sign flag
// (set for the i64-min path where the wrapped subtraction
// produces a u64 magnitude that's exact). Used by the
// method-syntax wrappers `(i64).to_string()` /
// `(u64).to_string()` and their i32 / u32 counterparts that
// promote first.
function __int_to_string_u64(mag: i64, neg: i32): string {
    var scratch: u8[] = __alloc_u8(24);
    var scratch_ptr: i32 = scratch as i32;
    var end: i32 = 24;
    if (mag == (0 as i64)) {
        end = end - 1;
        scratch[end] = 48 as u8;
    } else {
        while (mag != (0 as i64)) {
            end = end - 1;
            scratch[end] = ((((mag as u64) % (10 as u64)) as i32) + 48) as u8;
            mag = ((mag as u64) / (10 as u64)) as i64;
        }
    }
    if (neg != 0) {
        end = end - 1;
        scratch[end] = 45 as u8;
    }
    var n_bytes: i32 = 24 - end;
    var buf: u8[] = __alloc_u8(n_bytes);
    __memcpy(buf as i32, scratch_ptr + end, n_bytes);
    return string_from_bytes(buf);
}






// `pack_rgb(r, g, b)` — pack three 0..255 components into
// a 24-bit i32. Inverse of (n).to_rgb_hex()'s shifts. Each
// component is masked to its low 8 bits; values outside
// 0..255 silently wrap. Pairs with to_rgb_hex for the
// "construct then format" colour pipeline.
function pack_rgb(r: i32, g: i32, b: i32): i32 {
    return ((r & 255) << 16) | ((g & 255) << 8) | (b & 255);
}


// === Radix integer parse / format ===
//
// `parse_int_radix(s, base)` / `int_to_string_radix(n, base)`
// — companions to the decimal-only `parse_int` / `int_to_string`.
// Supported bases: 2..36 (digits 0-9 then a-z, ignoring case).
// Out-of-range base or a malformed digit returns None / a best-
// effort string respectively.
//
// Use cases the decimal helpers don't cover: hex addressing,
// binary debug dumps, octal permissions, base-36 short IDs.
// Matches Rust i32::from_str_radix / i32::to_string_radix and
// Go strconv.ParseInt / strconv.FormatInt minimal subset.

function __radix_digit(c: i32): i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }     // 0-9 → 0-9
    if (c >= 97 && c <= 122) { return c - 87; }     // a-z → 10-35
    if (c >= 65 && c <= 90)  { return c - 55; }     // A-Z → 10-35
    return 0 - 1;
}

function __radix_char(d: i32): i32 {
    if (d < 10) { return d + 48; }                   // 0-9
    return d + 87;                                    // a-z (lowercase)
}

function parse_int_radix(s: string, base: i32): Option[i32] {
    if (base < 2 || base > 36) { return None; }
    var n: i32 = len(s);
    if (n == 0) { return None; }
    var neg: boolean = false;
    var i: i32 = 0;
    if (s[0] == 45) {           // '-'
        neg = true;
        i = 1;
    } else if (s[0] == 43) {    // '+'
        i = 1;
    }
    if (i >= n) { return None; }    // sign without digits
    var v: i32 = 0;
    while (i < n) {
        var d: i32 = __radix_digit(s[i]);
        if (d < 0 || d >= base) { return None; }
        v = v * base + d;
        i = i + 1;
    }
    if (neg) { v = 0 - v; }
    return Some(v);
}

function int_to_string_radix(n: i32, base: i32): string {
    if (base < 2 || base > 36) { return ""; }
    if (n == 0) { return "0"; }
    var neg: boolean = (n < 0);
    // Use i64 magnitude so INT_MIN's negation doesn't overflow.
    var mag: i64 = n as i64;
    if (neg) { mag = 0 - mag; }
    // Worst case is 32 binary digits + sign = 33; allocate slack.
    var digits: u8[] = __alloc_u8(33);
    var k: i32 = 0;
    var b64: i64 = base as i64;
    while (mag > (0 as i64)) {
        var d: i32 = (mag % b64) as i32;
        digits[k] = __radix_char(d) as u8;
        k = k + 1;
        mag = mag / b64;
    }
    var out_len: i32 = k;
    if (neg) { out_len = k + 1; }
    var buf: u8[] = __alloc_u8(out_len);
    var bi: i32 = 0;
    if (neg) {
        buf[0] = 45 as u8;        // '-'
        bi = 1;
    }
    var j: i32 = k - 1;
    while (j >= 0) {
        buf[bi] = digits[j];
        bi = bi + 1;
        j = j - 1;
    }
    return string_from_bytes(buf);
}

// === Base64 (RFC 4648, standard alphabet) ===
//
// `base64_encode(s)` / `base64_decode(s)` — round-trip
// content-preserving on raw bytes. Encode emits `=` padding
// to align to a 4-character group. Decode terminates at
// the first non-base64 character (so trailing `=` padding
// works without special handling), preserving the bytes
// successfully decoded up to that point.

function __b64_alphabet(v: i32): i32 {
    if (v < 26)  { return v + 65; }     // A-Z (0..25 → 65..90)
    if (v < 52)  { return v + 71; }     // a-z (26..51 → 97..122)
    if (v < 62)  { return v - 4; }      // 0-9 (52..61 → 48..57)
    if (v == 62) { return 43; }         // '+'
    return 47;                          // '/'
}

function __b64_decode_char(c: i32): i32 {
    if (c >= 65 && c < 91)  { return c - 65; }     // A-Z
    if (c >= 97 && c < 123) { return c - 71; }     // a-z
    if (c >= 48 && c < 58)  { return c + 4; }      // 0-9 (48..57 → 52..61)
    if (c == 43) { return 62; }                    // '+'
    if (c == 47) { return 63; }                    // '/'
    return 0 - 1;
}

function base64_encode(s: string): string {
    var n: i32 = len(s);
    if (n == 0) { return ""; }
    var out_len: i32 = ((n + 2) / 3) * 4;
    var buf: u8[] = __alloc_u8(out_len);
    var i: i32 = 0;
    var j: i32 = 0;
    // Single shared `b0` / `b1` / `b2` declarations so the
    // wasm emitter (which names locals by lang identifier)
    // doesn't trip on duplicate declarations across the
    // sibling 3-byte / 1-byte / 2-byte branches.
    var b0: i32 = 0;
    var b1: i32 = 0;
    var b2: i32 = 0;
    while (i + 3 <= n) {
        b0 = s[i];
        b1 = s[i + 1];
        b2 = s[i + 2];
        buf[j]     = __b64_alphabet(b0 >> 2) as u8;
        buf[j + 1] = __b64_alphabet(((b0 & 3) << 4) | (b1 >> 4)) as u8;
        buf[j + 2] = __b64_alphabet(((b1 & 15) << 2) | (b2 >> 6)) as u8;
        buf[j + 3] = __b64_alphabet(b2 & 63) as u8;
        i = i + 3;
        j = j + 4;
    }
    var rem: i32 = n - i;
    if (rem == 1) {
        b0 = s[i];
        buf[j]     = __b64_alphabet(b0 >> 2) as u8;
        buf[j + 1] = __b64_alphabet((b0 & 3) << 4) as u8;
        buf[j + 2] = 61 as u8;                      // '='
        buf[j + 3] = 61 as u8;
    } else if (rem == 2) {
        b0 = s[i];
        b1 = s[i + 1];
        buf[j]     = __b64_alphabet(b0 >> 2) as u8;
        buf[j + 1] = __b64_alphabet(((b0 & 3) << 4) | (b1 >> 4)) as u8;
        buf[j + 2] = __b64_alphabet((b1 & 15) << 2) as u8;
        buf[j + 3] = 61 as u8;
    }
    return string_from_bytes(buf);
}

function base64_decode(s: string): string {
    var sLen: i32 = len(s);
    // Walk forward to count consecutive valid base64 chars;
    // first non-base64 (eg `=` padding) terminates the input.
    var n: i32 = 0;
    while (n < sLen) {
        if (__b64_decode_char(s[n]) < 0) { break; }
        n = n + 1;
    }
    if (n == 0) { return ""; }
    var out_len: i32 = (n * 3) / 4;
    if (out_len == 0) { return ""; }
    var buf: u8[] = __alloc_u8(out_len);
    var i: i32 = 0;
    var j: i32 = 0;
    var acc: i32 = 0;       // 6-bit-shift accumulator
    var bits: i32 = 0;      // bits currently held in acc
    while (i < n) {
        acc = (acc << 6) | __b64_decode_char(s[i]);
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            buf[j] = ((acc >> bits) & 255) as u8;
            j = j + 1;
        }
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// === Hex (lowercase) ===
//
// `hex_encode(s)` / `hex_decode(s)` — round-trip
// content-preserving on raw bytes. Encode emits lowercase
// `0-9a-f`. Decode accepts both cases; terminates at the
// first non-hex character or at an odd-length tail without
// raising — partial inputs round-trip cleanly. Companion
// to base64 with no `=` padding.

function __hex_lower_char(d: i32): i32 {
    if (d < 10) { return d + 48; }      // '0' + d
    return d + 87;                       // 'a' - 10 + d
}

function __hex_value(c: i32): i32 {
    if (c >= 48 && c < 58)  { return c - 48; }      // 0-9
    if (c >= 97 && c < 103) { return c - 87; }      // a-f
    if (c >= 65 && c < 71)  { return c - 55; }      // A-F
    return 0 - 1;
}

function hex_encode(s: string): string {
    var n: i32 = len(s);
    if (n == 0) { return ""; }
    var buf: u8[] = __alloc_u8(n * 2);
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        buf[i * 2]     = __hex_lower_char((b >> 4) & 15) as u8;
        buf[i * 2 + 1] = __hex_lower_char(b & 15) as u8;
        i = i + 1;
    }
    return string_from_bytes(buf);
}

function hex_decode(s: string): string {
    var sLen: i32 = len(s);
    // Walk forward to count consecutive valid hex chars;
    // first non-hex (or odd-length tail) terminates.
    var n: i32 = 0;
    while (n < sLen) {
        if (__hex_value(s[n]) < 0) { break; }
        n = n + 1;
    }
    var pairs: i32 = n / 2;
    if (pairs == 0) { return ""; }
    var buf: u8[] = __alloc_u8(pairs);
    var i: i32 = 0;
    while (i < pairs) {
        var hi: i32 = __hex_value(s[i * 2]);
        var lo: i32 = __hex_value(s[i * 2 + 1]);
        buf[i] = ((hi << 4) | lo) as u8;
        i = i + 1;
    }
    return string_from_bytes(buf);
}

// === URL percent-encoding (RFC 3986) ===
//
// `url_encode(s)` / `url_decode(s)` — public stdlib pair.
// `+` is left alone for both directions; callers handling
// `application/x-www-form-urlencoded` pre-process.

function __url_unreserved(b: i32): boolean {
    if (b >= 65 && b <= 90)  { return true; }   // A-Z
    if (b >= 97 && b <= 122) { return true; }   // a-z
    if (b >= 48 && b <= 57)  { return true; }   // 0-9
    if (b == 45 || b == 46 || b == 95 || b == 126) { return true; }
    return false;
}

function __url_hex_char(d: i32): i32 {
    if (d < 10) { return d + 48; }   // '0' + d
    return d + 55;                    // 'A' - 10 + d
}

function __url_hex_val(c: i32): i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }   // 0-9
    if (c >= 97 && c <= 102) { return c - 87; }   // a-f -> 10..15
    if (c >= 65 && c <= 70)  { return c - 55; }   // A-F -> 10..15
    return -1;
}

function url_encode(s: string): string {
    var n: i32 = len(s);
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (__url_unreserved(b)) {
            out = out + s[i:i+1];
        } else {
            var hi: i32 = (b >> 4) & 15;
            var lo: i32 = b & 15;
            // Explicit `as u8` keeps the array literal's
            // element type uniform across re-checks (the
            // monomorph pass re-runs the checker, which
            // doesn't re-apply the destination-context
            // coercion to function-call results).
            var trip: u8[] = [
                37 as u8,
                __url_hex_char(hi) as u8,
                __url_hex_char(lo) as u8
            ];
            out = out + string_from_bytes(trip);
        }
        i = i + 1;
    }
    return out;
}

function url_decode(s: string): string {
    var n: i32 = len(s);
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        var emit: string = s[i:i+1];
        var consumed: i32 = 1;
        if (b == 37 && i + 2 < n) {           // '%'
            var h1: i32 = __url_hex_val(s[i+1]);
            var h2: i32 = __url_hex_val(s[i+2]);
            if (h1 >= 0 && h2 >= 0) {
                var byte: u8[] = [((h1 << 4) | h2) as u8];
                emit = string_from_bytes(byte);
                consumed = 3;
            }
        }
        out = out + emit;
        i = i + consumed;
    }
    return out;
}



// === Float-to-string formatting ===
//
// `f32.to_string()` / `f64.to_string()`. Up to 7 fractional
// digits for f32, 15 for f64 (matching IEEE 754 single /
// double precision); trailing zeros trimmed and the decimal
// point is dropped if the fraction is zero. NaN gets the
// canonical "NaN"; ±Inf get "Inf" / "-Inf". Detection of Inf
// is approximate — the threshold check (`n > 1e300`) covers
// every practically-encountered case but isn't bit-exact
// against `f64.const inf`.

function __float_to_string(n: f64, k: i32): string {
    if (n != n) { return "NaN"; }
    var out: string = "";
    if (n < 0.0) {
        out = "-";
        n = 0.0 - n;
    }
    // Inf detection without a literal `inf` constant: for
    // any finite non-zero f64, `n * 2.0` is strictly larger
    // than `n`. For ±Inf, `Inf * 2.0 == Inf`. We've already
    // extracted the sign and ruled out NaN, so `n` here is
    // either zero, finite-positive, or +Inf.
    if (n != 0.0 && n * 2.0 == n) { return out + "Inf"; }
    // Integer part.
    var intPart: i64 = n as i64;
    out = out + intPart.to_string();
    // Fraction part.
    var frac: f64 = n - (intPart as f64);
    if (frac < 0.0) { frac = 0.0 - frac; }   // guard against `(intPart as f64)` rounding above n
    // mult = 10^k.
    var mult: f64 = 1.0;
    var i: i32 = 0;
    while (i < k) { mult = mult * 10.0; i = i + 1; }
    var fracInt: i64 = (frac * mult) as i64;
    // Find the effective number of digits by trimming
    // trailing zeros from fracInt.
    var effective: i32 = k;
    var tmp: i64 = fracInt;
    while (effective > 0 && (tmp % 10) == 0) {
        tmp = tmp / 10;
        effective = effective - 1;
    }
    if (effective == 0) { return out; }
    // Pad fracInt's decimal repr to k digits with leading
    // zeros, then truncate to `effective`.
    var fracStr: string = fracInt.to_string();
    while (len(fracStr) < k) { fracStr = "0" + fracStr; }
    return out + "." + fracStr[0:effective];
}

function (n: f32) to_string(): string {
    return __float_to_string(n as f64, 7);
}

function (n: f64) to_string(): string {
    return __float_to_string(n, 15);
}

// === stdin convenience ===
//
// `read_all_stdin()` — read until EOF and return the result
// as a single string. Loops `Reader.read_chunk(4096)` until
// None. Counterpart to `read_file(path)` for the
// "$ tool < input.txt" / "$ cat in | tool" CLI shape; saves
// callers from rolling the same loop every time.
function read_all_stdin(): string {
    var r: Reader = stdin();
    var out: string = "";
    while (true) {
        match (r.read_chunk(4096)) {
            Some(chunk) => { out = out + chunk; },
            None => {
                r.close();
                return out;
            },
        }
    }
    return out;
}

// === Path manipulation (string-level, POSIX) ===
//
// Pure string ops — no FS interaction. POSIX separator (`/`)
// only; Windows paths aren't a target right now (lang's stated
// platforms are Linux + macOS + wasi-edge). Matches Go
// `path/filepath` (Unix mode) and Zig `std.fs.path` minimally.
//
// Functions:
//   path_join(parts)    — joins parts with single `/` between,
//                         collapses double separators.
//   path_parent(p)      — leading-everything before the last
//                         `/`; "" for paths with no separator.
//   path_file_name(p)   — last component.
//   path_extension(p)   — substring after the LAST `.` of the
//                         last component, or "" if none. A
//                         leading-dot file (`.bashrc`) has no
//                         extension.

function path_join(parts: string[]): string {
    var n: i32 = len(parts);
    if (n == 0) { return ""; }
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var p: string = parts[i];
        if (len(p) == 0) {
            i = i + 1;
        } else {
            if (len(out) == 0) {
                out = p;
            } else {
                // Strip a trailing `/` from out (unless out is
                // just "/", which is the root path and must be
                // preserved as a separator-sentinel).
                while (len(out) > 1 && out[len(out) - 1] == 47) {
                    out = out[0:len(out) - 1];
                }
                // Strip any leading `/`s from p.
                var start: i32 = 0;
                while (start < len(p) && p[start] == 47) {
                    start = start + 1;
                }
                var rest: string = p[start:len(p)];
                if (out[len(out) - 1] == 47) {
                    out = out + rest;
                } else {
                    out = out + "/" + rest;
                }
            }
            i = i + 1;
        }
    }
    return out;
}

function path_parent(p: string): string {
    var n: i32 = len(p);
    if (n == 0) { return ""; }
    // Walk back from the end skipping a trailing `/`, find the
    // last separator, and return everything before it.
    var i: i32 = n - 1;
    // Special case: a single "/" parents to itself.
    if (n == 1 && p[0] == 47) { return "/"; }
    // Trim trailing slashes for the search.
    while (i > 0 && p[i] == 47) { i = i - 1; }
    while (i >= 0 && p[i] != 47) { i = i - 1; }
    if (i < 0) { return ""; }
    if (i == 0) { return "/"; }
    return p[0:i];
}

function path_file_name(p: string): string {
    var n: i32 = len(p);
    if (n == 0) { return ""; }
    // Trim trailing slashes — "a/b/" → "b".
    var end: i32 = n;
    while (end > 0 && p[end - 1] == 47) { end = end - 1; }
    if (end == 0) { return ""; }
    var i: i32 = end - 1;
    while (i >= 0 && p[i] != 47) { i = i - 1; }
    return p[i + 1:end];
}

function path_extension(p: string): string {
    var name: string = path_file_name(p);
    var n: i32 = len(name);
    if (n == 0) { return ""; }
    var i: i32 = n - 1;
    while (i > 0 && name[i] != 46) { i = i - 1; }
    // Hidden files (leading dot, no other dot) have no
    // extension: `.bashrc` → "", not "bashrc".
    if (i <= 0) { return ""; }
    return name[i + 1:n];
}

// === URL parsing ===
//
// `url_parse(s)` decomposes an absolute or relative URL into
// the auto-injected `Url` struct. Returns `Option[Url]`;
// `None` only on completely empty input — best-effort parse
// otherwise with empty strings for missing sections and
// `port = 0` when unspecified or unparseable. No %-decoding;
// `query` and `fragment` are returned raw.

function url_parse(s: string): Option[Url] {
    var n: i32 = len(s);
    if (n == 0) { return None; }

    var u: Url = Url {
        scheme: "",
        host: "",
        port: 0,
        path: "",
        query: "",
        fragment: ""
    };

    // Find scheme: look for ":" followed by "//".
    var scheme_end: i32 = -1;
    var i: i32 = 0;
    while (i + 2 < n) {
        if (s[i] == 58 && s[i+1] == 47 && s[i+2] == 47) {
            if (i > 0) { scheme_end = i; }
            break;
        }
        i = i + 1;
    }

    var rest_start: i32 = 0;
    if (scheme_end >= 0) {
        u.scheme = s[0:scheme_end];
        rest_start = scheme_end + 3;
    }

    // Find fragment '#' from rest_start onwards.
    var frag_start: i32 = n;
    i = rest_start;
    while (i < n) {
        if (s[i] == 35) { frag_start = i; break; }   // '#'
        i = i + 1;
    }
    if (frag_start < n) {
        u.fragment = s[frag_start+1:n];
    }

    // Find query '?' in [rest_start, frag_start).
    var query_start: i32 = frag_start;
    i = rest_start;
    while (i < frag_start) {
        if (s[i] == 63) { query_start = i; break; }   // '?'
        i = i + 1;
    }
    if (query_start < frag_start) {
        u.query = s[query_start+1:frag_start];
    }

    // Find authority end. With a scheme, scan for the first
    // '/' in [rest_start, query_start). Without a scheme the
    // whole [rest_start, ...] is the path, so authority_end
    // collapses to rest_start.
    var authority_end: i32 = query_start;
    if (scheme_end >= 0) {
        i = rest_start;
        while (i < query_start) {
            if (s[i] == 47) { authority_end = i; break; }   // '/'
            i = i + 1;
        }
    } else {
        authority_end = rest_start;
    }

    // Authority — split host:port.
    if (rest_start < authority_end) {
        var colon: i32 = authority_end;
        i = rest_start;
        while (i < authority_end) {
            if (s[i] == 58) { colon = i; break; }   // ':'
            i = i + 1;
        }
        if (colon < authority_end) {
            u.host = s[rest_start:colon];
            // Port: digits only, max 65535. Any non-digit or
            // out-of-range value zeroes the port.
            var port: i32 = 0;
            i = colon + 1;
            while (i < authority_end) {
                var b: i32 = s[i];
                if (b < 48 || b > 57) { port = 0; break; }
                port = port * 10 + (b - 48);
                if (port > 65535) { port = 0; break; }
                i = i + 1;
            }
            u.port = port;
        } else {
            u.host = s[rest_start:authority_end];
        }
    }

    // Path: [authority_end, query_start).
    if (authority_end < query_start) {
        u.path = s[authority_end:query_start];
    }

    return Some(u);
}

// === Query string parsing ===
//
// `query_parse(s)` splits a URL-encoded query string into a
// `Map[string, string[]]`. Pairs separated by `&`; within a
// pair, `=` separates key from value. Both halves are
// `url_decode`'d. Duplicate keys all preserved — values for
// the same key collect into a `string[]` in insertion order.
// A pair without `=` records the key with a single-element
// empty-string array. Empty input yields an empty map.
// Trailing `&` is ignored.

function query_parse(s: string): Map[string, string[]] {
    var m: Map[string, string[]] = map_new(8);
    var n: i32 = len(s);
    if (n == 0) { return m; }

    var pair_start: i32 = 0;
    var i: i32 = 0;
    // Walk one past the end so a final pair without a
    // trailing `&` still gets processed via the `i == n`
    // sentinel.
    while (i <= n) {
        var sep: boolean = false;
        if (i == n) { sep = true; }
        else if (s[i] == 38) { sep = true; }   // '&'
        if (sep) {
            var pair_len: i32 = i - pair_start;
            if (pair_len > 0) {
                __query_pair(m, s, pair_start, i);
            }
            pair_start = i + 1;
        }
        i = i + 1;
    }
    return m;
}

function __query_pair(m: Map[string, string[]], s: string, start: i32, end: i32) {
    // Find '=' in [start, end).
    var eq: i32 = -1;
    var j: i32 = start;
    while (j < end) {
        if (s[j] == 61) { eq = j; break; }   // '='
        j = j + 1;
    }
    var key: string = "";
    var val: string = "";
    if (eq >= 0) {
        key = url_decode(s[start:eq]);
        val = url_decode(s[eq+1:end]);
    } else {
        key = url_decode(s[start:end]);
    }
    // Append-or-create: probe the map; on hit, copy + append;
    // else create a one-element array.
    match (m.get(key)) {
        Some(existing) => {
            m.set(key, existing.push(val));
        },
        None => {
            var arr: string[] = [val];
            m.set(key, arr);
        }
    }
}

// === JSON encoding ===
//
// `json_encode(v)` walks the auto-injected `JsonValue` tree
// and produces the canonical JSON text. Strings are escape-
// encoded; arrays / objects recurse. Numbers emit their
// payload string verbatim — the responsibility for valid
// numeric formatting sits with the caller.

function __json_hex_lower(d: i32): i32 {
    if (d < 10) { return d + 48; }   // '0' + d
    return d + 87;                    // 'a' - 10 + d
}

function __json_escape(s: string): string {
    var out: string = "";
    var n: i32 = len(s);
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 34) { out = out + "\\\""; }
        else if (b == 92) { out = out + "\\\\"; }
        else if (b == 10) { out = out + "\\n"; }
        else if (b == 13) { out = out + "\\r"; }
        else if (b == 9) { out = out + "\\t"; }
        else if (b < 32) {
            // \u00XX with lowercase hex.
            var hi: i32 = (b >> 4) & 15;
            var lo: i32 = b & 15;
            var trip: u8[] = [
                92 as u8,
                117 as u8,
                48 as u8,
                48 as u8,
                __json_hex_lower(hi) as u8,
                __json_hex_lower(lo) as u8
            ];
            out = out + string_from_bytes(trip);
        } else {
            out = out + s[i:i+1];
        }
        i = i + 1;
    }
    return out;
}

function json_encode(v: JsonValue): string {
    // Single shared `out` and `i` across match arms — the
    // wasm emitter names locals by lang identifier, so
    // re-declaring `var out` in nested scopes collides
    // (same footgun parse_float hit).
    var out: string = "";
    var i: i32 = 0;
    match (v) {
        JNull => { return "null"; },
        JBool(b) => {
            if (b) { return "true"; }
            return "false";
        },
        JNumber(s) => { return s; },
        JString(s) => {
            return "\"" + __json_escape(s) + "\"";
        },
        JArray(arr) => {
            out = "[";
            var n: i32 = len(arr);
            while (i < n) {
                if (i > 0) { out = out + ","; }
                out = out + json_encode(arr[i]);
                i = i + 1;
            }
            return out + "]";
        },
        JObject(m) => {
            out = "{";
            var first: boolean = true;
            var iter: MapIter[string, JsonValue] = m.iter();
            while (iter.has_next()) {
                if (!first) { out = out + ","; }
                first = false;
                out = out + "\"" + __json_escape(iter.key()) + "\":";
                out = out + json_encode(iter.value());
                iter.advance();
            }
            return out + "}";
        }
    }
}

// === JSON parsing ===
//
// `json_parse(s)` is the inverse of `json_encode`. Returns
// `Option[JsonValue]`; `None` on any malformed input.
// Recursive descent over a `__JsonParser` state struct
// (s + pos + error). Numbers are stored verbatim as
// `JNumber`'s string payload. String escapes are decoded
// (`\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`,
// `\uXXXX` for BMP code points). Surrogate pairs aren't
// combined yet.

struct __JsonParser {
    s: string,
    pos: i32,
    error: i32,
}

function __json_p_skip_ws(p: __JsonParser) {
    var n: i32 = len(p.s);
    while (p.pos < n) {
        var b: i32 = p.s[p.pos];
        if (b != 32 && b != 9 && b != 10 && b != 13) { break; }
        p.pos = p.pos + 1;
    }
}

function __json_p_byte(p: __JsonParser): i32 {
    if (p.pos >= len(p.s)) { return 0; }
    return p.s[p.pos];
}

function __json_hex_value(c: i32): i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70)  { return c - 55; }
    return -1;
}

function __json_p_number(p: __JsonParser): JsonValue {
    var start: i32 = p.pos;
    var n: i32 = len(p.s);
    var b: i32 = 0;
    // Optional '-'
    if (__json_p_byte(p) == 45) { p.pos = p.pos + 1; }
    // At least one digit.
    b = __json_p_byte(p);
    if (b < 48 || b > 57) { p.error = 1; return JNull; }
    // Integer digits.
    while (p.pos < n) {
        b = p.s[p.pos];
        if (b < 48 || b > 57) { break; }
        p.pos = p.pos + 1;
    }
    // Optional '.<digits>'.
    if (__json_p_byte(p) == 46) {
        p.pos = p.pos + 1;
        while (p.pos < n) {
            b = p.s[p.pos];
            if (b < 48 || b > 57) { break; }
            p.pos = p.pos + 1;
        }
    }
    // Optional [eE][+-]?<digits>.
    b = __json_p_byte(p);
    if (b == 101 || b == 69) {
        p.pos = p.pos + 1;
        b = __json_p_byte(p);
        if (b == 43 || b == 45) { p.pos = p.pos + 1; }
        while (p.pos < n) {
            b = p.s[p.pos];
            if (b < 48 || b > 57) { break; }
            p.pos = p.pos + 1;
        }
    }
    return JNumber(p.s[start:p.pos]);
}

// __json_emit_codepoint encodes a single Unicode scalar value
// as the matching UTF-8 byte sequence (1-4 bytes) and appends
// it to `out`. Supports the full Unicode range up to
// U+10FFFF; the caller is expected to have resolved any
// surrogate pairs into a single code point already.
function __json_emit_codepoint(out: string, cp: i32): string {
    if (cp < 128) {
        var ub1: u8[] = [cp as u8];
        return out + string_from_bytes(ub1);
    }
    if (cp < 2048) {
        var ub2: u8[] = [
            ((cp >> 6) | 192) as u8,
            ((cp & 63) | 128) as u8
        ];
        return out + string_from_bytes(ub2);
    }
    if (cp < 65536) {
        var ub3: u8[] = [
            ((cp >> 12) | 224) as u8,
            (((cp >> 6) & 63) | 128) as u8,
            ((cp & 63) | 128) as u8
        ];
        return out + string_from_bytes(ub3);
    }
    var ub4: u8[] = [
        ((cp >> 18) | 240) as u8,
        (((cp >> 12) & 63) | 128) as u8,
        (((cp >> 6) & 63) | 128) as u8,
        ((cp & 63) | 128) as u8
    ];
    return out + string_from_bytes(ub4);
}

// __json_p_uhex parses 4 hex digits at p.pos (without
// consuming the leading `\u`) and returns the decoded value.
// Sets p.error and returns 0 on any non-hex digit or
// past-end-of-input. Does NOT consume the hex digits past
// what it reads — it advances p.pos by 4 on success.
function __json_p_uhex(p: __JsonParser): i32 {
    if (p.pos + 4 > len(p.s)) { p.error = 1; return 0; }
    var u: i32 = 0;
    var i: i32 = 0;
    while (i < 4) {
        var hv: i32 = __json_hex_value(p.s[p.pos]);
        if (hv < 0) { p.error = 1; return 0; }
        u = (u << 4) | hv;
        p.pos = p.pos + 1;
        i = i + 1;
    }
    return u;
}

function __json_p_string(p: __JsonParser): string {
    if (__json_p_byte(p) != 34) { p.error = 1; return ""; }
    p.pos = p.pos + 1;
    var out: string = "";
    var n: i32 = len(p.s);
    var b: i32 = 0;
    while (true) {
        b = __json_p_byte(p);
        if (b == 0) { p.error = 1; return ""; }
        if (b == 34) { p.pos = p.pos + 1; return out; }
        if (b == 92) {                                  // '\\'
            p.pos = p.pos + 1;
            var esc: i32 = __json_p_byte(p);
            if (esc == 0) { p.error = 1; return ""; }
            if (esc == 117) {                           // 'u' — \uXXXX
                p.pos = p.pos + 1;
                var u: i32 = __json_p_uhex(p);
                if (p.error != 0) { return ""; }
                // High surrogate (D800..DBFF): combine with
                // the following low surrogate (DC00..DFFF) to
                // form a single astral code point. Lone or
                // mismatched surrogates fall back to U+FFFD
                // (REPLACEMENT CHARACTER) — matches Go's
                // encoding/json + most strict UTF-8 emitters.
                if (u >= 55296 && u <= 56319) {
                    if (p.pos + 6 > n
                        || p.s[p.pos] != 92
                        || p.s[p.pos+1] != 117) {
                        out = __json_emit_codepoint(out, 65533);
                    } else {
                        p.pos = p.pos + 2;
                        var low: i32 = __json_p_uhex(p);
                        if (p.error != 0) { return ""; }
                        if (low < 56320 || low > 57343) {
                            out = __json_emit_codepoint(out, 65533);
                            out = __json_emit_codepoint(out, low);
                        } else {
                            var cp: i32 = 65536
                                + ((u - 55296) << 10)
                                + (low - 56320);
                            out = __json_emit_codepoint(out, cp);
                        }
                    }
                } else if (u >= 56320 && u <= 57343) {
                    out = __json_emit_codepoint(out, 65533);
                } else {
                    out = __json_emit_codepoint(out, u);
                }
            } else {
                var ch: i32 = -1;
                if (esc == 34 || esc == 92 || esc == 47) { ch = esc; }
                else if (esc == 110) { ch = 10; }
                else if (esc == 114) { ch = 13; }
                else if (esc == 116) { ch = 9; }
                else if (esc == 98)  { ch = 8; }
                else if (esc == 102) { ch = 12; }
                else { p.error = 1; return ""; }
                var sb: u8[] = [ch as u8];
                out = out + string_from_bytes(sb);
                p.pos = p.pos + 1;
            }
        } else {
            out = out + p.s[p.pos:p.pos+1];
            p.pos = p.pos + 1;
        }
    }
    return "";   // unreachable
}

function __json_p_array(p: __JsonParser): JsonValue {
    p.pos = p.pos + 1;                                  // consume '['
    __json_p_skip_ws(p);
    if (__json_p_byte(p) == 93) {                       // ']'
        p.pos = p.pos + 1;
        var empty: JsonValue[] = [];
        return JArray(empty);
    }
    var arr: JsonValue[] = [];
    while (true) {
        var elem: JsonValue = __json_p_value(p);
        if (p.error != 0) { return JNull; }
        arr = arr.push(elem);
        __json_p_skip_ws(p);
        var b: i32 = __json_p_byte(p);
        if (b == 44) {                                  // ','
            p.pos = p.pos + 1;
            __json_p_skip_ws(p);
            continue;
        }
        if (b == 93) {                                  // ']'
            p.pos = p.pos + 1;
            return JArray(arr);
        }
        p.error = 1;
        return JNull;
    }
    return JNull;   // unreachable
}

function __json_p_object(p: __JsonParser): JsonValue {
    p.pos = p.pos + 1;                                  // consume '{'
    __json_p_skip_ws(p);
    var m: Map[string, JsonValue] = map_new(8);
    if (__json_p_byte(p) == 125) {                      // '}'
        p.pos = p.pos + 1;
        return JObject(m);
    }
    while (true) {
        var key: string = __json_p_string(p);
        if (p.error != 0) { return JNull; }
        __json_p_skip_ws(p);
        if (__json_p_byte(p) != 58) {                   // ':'
            p.error = 1; return JNull;
        }
        p.pos = p.pos + 1;
        var val: JsonValue = __json_p_value(p);
        if (p.error != 0) { return JNull; }
        m.set(key, val);
        __json_p_skip_ws(p);
        var b: i32 = __json_p_byte(p);
        if (b == 44) {                                  // ','
            p.pos = p.pos + 1;
            __json_p_skip_ws(p);
            continue;
        }
        if (b == 125) {                                 // '}'
            p.pos = p.pos + 1;
            return JObject(m);
        }
        p.error = 1;
        return JNull;
    }
    return JNull;   // unreachable
}

function __json_p_value(p: __JsonParser): JsonValue {
    __json_p_skip_ws(p);
    var b: i32 = __json_p_byte(p);
    if (b == 0) { p.error = 1; return JNull; }
    if (b == 110) {                                     // 'n' — null
        if (p.pos + 4 > len(p.s)) { p.error = 1; return JNull; }
        if (p.s[p.pos+1] != 117 || p.s[p.pos+2] != 108 || p.s[p.pos+3] != 108) {
            p.error = 1; return JNull;
        }
        p.pos = p.pos + 4;
        return JNull;
    }
    if (b == 116) {                                     // 't' — true
        if (p.pos + 4 > len(p.s)) { p.error = 1; return JNull; }
        if (p.s[p.pos+1] != 114 || p.s[p.pos+2] != 117 || p.s[p.pos+3] != 101) {
            p.error = 1; return JNull;
        }
        p.pos = p.pos + 4;
        return JBool(true);
    }
    if (b == 102) {                                     // 'f' — false
        if (p.pos + 5 > len(p.s)) { p.error = 1; return JNull; }
        if (p.s[p.pos+1] != 97 || p.s[p.pos+2] != 108 ||
            p.s[p.pos+3] != 115 || p.s[p.pos+4] != 101) {
            p.error = 1; return JNull;
        }
        p.pos = p.pos + 5;
        return JBool(false);
    }
    if (b == 34) {                                      // '"' — string
        var s: string = __json_p_string(p);
        if (p.error != 0) { return JNull; }
        return JString(s);
    }
    if (b == 91)  { return __json_p_array(p); }         // '['
    if (b == 123) { return __json_p_object(p); }        // '{'
    if (b == 45 || (b >= 48 && b <= 57)) {              // '-' or digit
        return __json_p_number(p);
    }
    p.error = 1;
    return JNull;
}

function json_parse(s: string): Option[JsonValue] {
    var p: __JsonParser = __JsonParser { s: s, pos: 0, error: 0 };
    var v: JsonValue = __json_p_value(p);
    __json_p_skip_ws(p);
    if (p.error != 0 || p.pos < len(p.s)) { return None; }
    return Some(v);
}


// === Generic Map[K, V] runtime ===
//
// Auto-injected `Map` (a single-field i32-wrapper struct
// holding a kv-buffer pointer) plus its IndexMap-shaped
// open-addressing core. The wat shims `__memcpy`, `__memset`,
// `__alloc`, `__load_i32`, `__store_i32`, plus the slice /
// struct ↔ i32 escape-hatch casts let the runtime live in
// lang without sacrificing the byte-level layout the
// existing test suite already pins down.
//
// Lang-side: declarations use `i32` for K / V because the
// language doesn't yet have generic methods. The checker
// keeps its existing generic FuncSigs registrations
// (`(Map[K,V], K, V) → void` etc.) and the IR rewrites
// `__method_Map_*` / `map_new` calls to these `_impl`
// counterparts at codegen time — same shape as the
// `__array_append_jsonvalue → __array_append_string` alias
// in internal/codegen/wasm/wasm_ir.go.
//
// kv buffer layout (Map's `data` field points here):
//
//   +0   cap     : i32 — bucket count, power-of-2, ≥ 4
//   +4   len     : i32 — live entry count
//   +8   keyKind : i32 — 0 = i32-sized scalar, 1 = string
//   +12  valKind : i32 — 0 = i32-scalar, 1 = pointer-shaped
//   +16  buckets : i32[cap]            (-1 empty, -2 tombstone)
//   +16+cap*4  entries : (k,v)[cap]    per-entry stride = 2 * __ptr_width()
//                                      (8 on wasm32, 16 on arm64)
//
// Entry slots use `__store_ptr` / `__load_ptr` so heap-address
// keys/values (string pointers on arm64-darwin's high heap)
// round-trip without truncation. i32-sized K/V keep working
// because arm64 LDR Wn zero-extends and STR Xn writes the same
// low-32 bits; on wasm32 the slot stays 4 bytes (`__store_ptr`
// is a 4-byte i32.store), no regression in buffer size.
//
// Total: 16 + cap * (4 + 2 * __ptr_width()) bytes.

function __map_pow2_ceil(n: i32): i32 {
    if (n <= 4) { return 4; }
    var p: i32 = 4;
    while (p < n) {
        if (p >= 1073741824) { return p; }   // saturate at 2^30
        p = p << 1;
    }
    return p;
}

// Hash function:
//   keyKind 0 (i32-sized scalar): Wang's integer mix.
//   keyKind 1 (string)          : FNV-1a 32-bit over the bytes.
// Both produce a 32-bit hash that callers mask down to
// `cap - 1` (cap is power-of-2). The unsigned shifts go
// through `as u32` because the lang's `>>` defaults to
// `i32.shr_s` on i32 operands.
// __map_hash hashes a Map key. The param stays `i32` (not
// `usize`) deliberately: the IR uses cell-pointer boxing
// for wide-scalar K (i64 / u64 / f64) so the pointer that
// arrives here always fits in 32 bits on the cell-pointer
// path. For native scalar K (i32 / u32) the value fits
// trivially. The string path casts back via `k as string`,
// which on natives is a no-op pointer reinterpret —
// truncation isn't an issue when the prelude itself ALSO
// runs with i32-sized pointer locals on the call chain
// (see the rest of the Map runtime above for the usize
// migration that started with map_new_impl).
//
// Keeping the param as i32 lets the wide-scalar Map tests
// continue to pass (the i32-narrow at the call boundary
// gives kBits the right bits whether k arrived through a
// usize-typed __map_lookup call or via the older i32 path).
// A future PR can flip this when the wide-scalar K path
// gets its own dedicated hash entrypoint.
function __map_hash(k: i32, keyKind: i32): i32 {
    var h: i32 = 0;
    if (keyKind == 0) {
        h = k ^ 61;
        h = h ^ (((h as u32) >> (16 as u32)) as i32);
        h = h + (h << 3);
        h = h ^ (((h as u32) >> (4 as u32)) as i32);
        h = h * 668265261;                      // 0x27d4eb2d
        h = h ^ (((h as u32) >> (15 as u32)) as i32);
        return h;
    }
    h = 0 - 2128831035;                         // 0x811c9dc5 sign-flipped
    var s: string = k as string;
    var sLen: i32 = len(s);
    var i: i32 = 0;
    while (i < sLen) {
        h = h ^ s[i];
        h = h * 16777619;                       // 0x01000193
        i = i + 1;
    }
    return h;
}

function map_new_impl(cap_hint: i32, keyKind: i32, valKind: i32): usize {
    var cap: i32 = __map_pow2_ceil(cap_hint);
    var entryStride: i32 = 2 * __ptr_width();
    var buf: usize = __alloc(16 + cap * (4 + entryStride));
    __store_i32(buf,      cap);
    __store_i32(buf + 4,  0);
    __store_i32(buf + 8,  keyKind);
    __store_i32(buf + 12, valKind);
    __memset(buf + 16, 255, cap * 4);            // buckets → all -1
    // Map handle is a heap-allocated pointer cell. 8 bytes
    // accommodates a 64-bit `buf` pointer on arm64; wasm32
    // only needs 4 but the extra padding is cheap and keeps
    // the handle layout uniform across targets. Using
    // `__store_ptr` / `__load_ptr` (pointer-width helpers)
    // lets backends pick the right STR/LDR width. The handle
    // pointer itself rides through `usize` end-to-end so
    // arm64-darwin's >4 GiB heap addresses survive the
    // round-trip through every Map helper below.
    var m: usize = __alloc(8);
    __store_ptr(m, buf);
    return m;
}

function __map_len_impl(m: usize): i32 {
    var buf: usize = __load_ptr(m);
    return __load_i32(buf + 4);
}

// __map_lookup returns the entry index of the matching key,
// or -1 if not present. Linear probing over the bucket array,
// skipping tombstones (which keep probing valid past
// deletions).
function __map_lookup(m: usize, k: usize): i32 {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var keyKind: i32 = __load_i32(buf + 8);
    var mask: i32 = cap - 1;
    var entryStride: i32 = 2 * __ptr_width();
    var entriesBase: usize = buf + 16 + cap * 4;
    var bucket: i32 = __map_hash(k, keyKind) & mask;
    while (true) {
        var b: i32 = __load_i32(buf + 16 + bucket * 4);
        if (b == 0 - 1) { return 0 - 1; }
        if (b != 0 - 2) {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            var eq: boolean = false;
            if (keyKind == 0) {
                eq = entryK == k;
            } else {
                eq = (entryK as string) == (k as string);
            }
            if (eq) { return b; }
        }
        bucket = (bucket + 1) & mask;
    }
    return 0 - 1;       // unreachable
}

function __map_has_impl(m: usize, k: usize): boolean {
    return __map_lookup(m, k) != (0 - 1);
}

function __map_get_impl(m: usize, k: usize): Option[usize] {
    var idx: i32 = __map_lookup(m, k);
    if (idx == 0 - 1) { return None; }
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    return Some(__load_ptr(entriesBase + idx * entryStride + ptrW));
}

function __map_get_or_impl(m: usize, k: usize, fallback: usize): usize {
    var idx: i32 = __map_lookup(m, k);
    if (idx == 0 - 1) { return fallback; }
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    return __load_ptr(entriesBase + idx * entryStride + ptrW);
}

// __map_grow doubles the kv buffer's capacity and re-hashes
// every existing entry into the new bucket array. Updates
// the wrapper's data ptr in place; returns the new buffer
// for the inline caller. The bump allocator can't reclaim
// the old buffer; that pays back when the arena resets at
// scope exit.
function __map_grow(m: usize): usize {
    var oldBuf: usize = __load_ptr(m);
    var oldCap: i32 = __load_i32(oldBuf);
    var oldLen: i32 = __load_i32(oldBuf + 4);
    var oldKK:  i32 = __load_i32(oldBuf + 8);
    var oldVK:  i32 = __load_i32(oldBuf + 12);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var oldEntries: usize = oldBuf + 16 + oldCap * 4;
    var newCap: i32 = 4;
    if (oldCap != 0) { newCap = oldCap << 1; }
    var newMask: i32 = newCap - 1;
    var newBuf: usize = __alloc(16 + newCap * (4 + entryStride));
    __store_i32(newBuf,      newCap);
    __store_i32(newBuf + 4,  oldLen);
    __store_i32(newBuf + 8,  oldKK);
    __store_i32(newBuf + 12, oldVK);
    __memset(newBuf + 16, 255, newCap * 4);      // empty buckets
    var newEntries: usize = newBuf + 16 + newCap * 4;
    var i: i32 = 0;
    while (i < oldLen) {
        var key: usize = __load_ptr(oldEntries + i * entryStride);
        var val: usize = __load_ptr(oldEntries + i * entryStride + ptrW);
        __store_ptr(newEntries + i * entryStride,        key);
        __store_ptr(newEntries + i * entryStride + ptrW, val);
        var bucket: i32 = __map_hash(key, oldKK) & newMask;
        while (true) {
            var b: i32 = __load_i32(newBuf + 16 + bucket * 4);
            if (b == 0 - 1) {
                __store_i32(newBuf + 16 + bucket * 4, i);
                break;
            }
            bucket = (bucket + 1) & newMask;
        }
        i = i + 1;
    }
    __store_ptr(m, newBuf);
    return newBuf;
}

function __map_set_impl(m: usize, k: usize, v: usize) {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    // 75% load factor: trigger when (len + 1) * 4 >= cap * 3.
    if ((len_ + 1) * 4 >= cap * 3) {
        __map_grow(m);
        buf = __load_ptr(m);
        cap = __load_i32(buf);
        len_ = __load_i32(buf + 4);
    }
    var keyKind: i32 = __load_i32(buf + 8);
    var mask: i32 = cap - 1;
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var bucket: i32 = __map_hash(k, keyKind) & mask;
    var insertSlot: i32 = 0 - 1;
    var done: boolean = false;
    while (!done) {
        var b: i32 = __load_i32(buf + 16 + bucket * 4);
        if (b == 0 - 1) {
            if (insertSlot == 0 - 1) { insertSlot = bucket; }
            done = true;
        } else if (b == 0 - 2) {
            if (insertSlot == 0 - 1) { insertSlot = bucket; }
            bucket = (bucket + 1) & mask;
        } else {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            var eq: boolean = false;
            if (keyKind == 0) {
                eq = entryK == k;
            } else {
                eq = (entryK as string) == (k as string);
            }
            if (eq) {
                __store_ptr(entriesBase + b * entryStride + ptrW, v);
                return;
            }
            bucket = (bucket + 1) & mask;
        }
    }
    // Append entry at index = len.
    __store_ptr(entriesBase + len_ * entryStride,        k);
    __store_ptr(entriesBase + len_ * entryStride + ptrW, v);
    __store_i32(buf + 16 + insertSlot * 4, len_);
    __store_i32(buf + 4, len_ + 1);
}

// Snapshot a column (keys or values) into a freshly-allocated
// length-prefixed array. `kvOffset` selects the column within
// each entry; `destStride` is the byte stride of the result
// array's element type (4 for i32-sized, ptr-width for
// pointer-shaped). Insertion order preserved up to any
// deletions (swap-with-last reorders past the deleted slot).
//
// Two-mode dispatch on destStride: i32-stride uses i32 loads/
// stores (low 32 bits of the entry slot, which IS the value
// when K/V is i32); pointer-stride uses __load_ptr / __store_
// ptr so the full heap address survives on arm64.
function __map_column(m: usize, kvOffset: i32, destStride: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var entryStride: i32 = 2 * __ptr_width();
    var entriesBase: usize = buf + 16 + cap * 4;
    // Header layout: length prefix lives at `data - 4` so
    // `len(arr)` works on the returned data pointer. When
    // destStride > 4 (pointer-stride arrays on arm64) the
    // first element must be stride-aligned, so the header
    // grows to destStride bytes with the length packed into
    // the last 4 of them.
    var hdr: i32 = 4;
    if (destStride > 4) { hdr = destStride; }
    var arr: usize = __alloc(hdr + len_ * destStride);
    __store_i32(arr + hdr - 4, len_);
    var i: i32 = 0;
    while (i < len_) {
        if (destStride == 4) {
            var v32: i32 = __load_i32(entriesBase + i * entryStride + kvOffset);
            __store_i32(arr + hdr + i * 4, v32);
        } else {
            var vp: usize = __load_ptr(entriesBase + i * entryStride + kvOffset);
            __store_ptr(arr + hdr + i * destStride, vp);
        }
        i = i + 1;
    }
    return arr + hdr;
}

function __map_keys_impl(m: usize): usize {
    var buf: usize = __load_ptr(m);
    var keyKind: i32 = __load_i32(buf + 8);
    if (keyKind == 1) {
        return __map_string_column(m, 0);
    }
    return __map_column(m, 0, 4);
}

function __map_values_impl(m: usize): usize {
    var buf: usize = __load_ptr(m);
    var valKind: i32 = __load_i32(buf + 12);
    var ptrW: i32 = __ptr_width();
    if (valKind == 1) {
        return __map_string_column(m, ptrW);
    }
    return __map_column(m, ptrW, 4);
}

// __map_string_column builds a fresh `string[]` snapshot of
// the Map's K or V column. Each entry slot holds a cell-
// pointer (Map K/V boxing); we deref each one via the
// `cellPtr as string` cast (which emits OpLoad{WidthString}
// on two-word targets and is a no-op on legacy native single-
// pointer-string targets) and push the resulting string into
// a growing `string[]`. Per-element stride is whatever the
// IR computes for `string[]` on this target (8 bytes on
// wasm32, 16 on flipped arm64, 8 on legacy native).
function __map_string_column(m: usize, kvOffset: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var out: string[] = [];
    var i: i32 = 0;
    while (i < len_) {
        var cellPtr: usize = __load_ptr(entriesBase + i * entryStride + kvOffset);
        var s: string = cellPtr as string;
        out = out.push(s);
        i = i + 1;
    }
    return out as usize;
}

function __map_delete_impl(m: usize, k: usize): boolean {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var keyKind: i32 = __load_i32(buf + 8);
    var mask: i32 = cap - 1;
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var bucket: i32 = __map_hash(k, keyKind) & mask;
    var foundBucket: i32 = 0 - 1;
    var idx: i32 = 0;
    while (true) {
        var b: i32 = __load_i32(buf + 16 + bucket * 4);
        if (b == 0 - 1) { break; }
        if (b != 0 - 2) {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            var eq: boolean = false;
            if (keyKind == 0) {
                eq = entryK == k;
            } else {
                eq = (entryK as string) == (k as string);
            }
            if (eq) {
                foundBucket = bucket;
                idx = b;
                break;
            }
        }
        bucket = (bucket + 1) & mask;
    }
    if (foundBucket == 0 - 1) { return false; }
    // Tombstone the bucket so subsequent probes skip past it.
    __store_i32(buf + 16 + foundBucket * 4, 0 - 2);
    var last: i32 = len_ - 1;
    if (idx != last) {
        // Swap-with-last in the entries array, then patch the
        // moved entry's bucket pointer to its new index. The
        // last entry is alive (about to be removed) so the
        // probe will hit it.
        var lastKey: usize = __load_ptr(entriesBase + last * entryStride);
        var lastBucket: i32 = __map_hash(lastKey, keyKind) & mask;
        while (__load_i32(buf + 16 + lastBucket * 4) != last) {
            lastBucket = (lastBucket + 1) & mask;
        }
        var lastVal: usize = __load_ptr(entriesBase + last * entryStride + ptrW);
        __store_ptr(entriesBase + idx * entryStride,        lastKey);
        __store_ptr(entriesBase + idx * entryStride + ptrW, lastVal);
        __store_i32(buf + 16 + lastBucket * 4, idx);
    }
    __store_i32(buf + 4, last);
    return true;
}

function __map_clear_impl(m: usize) {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    __store_i32(buf + 4, 0);
    __memset(buf + 16, 255, cap * 4);
}

// MapIter is a 16-byte heap object: [buf:8][cursor:4][pad:4].
// The cursor lives at offset +8 (not +4) so the layout is the
// same on wasm32 (where __store_ptr is 4 bytes and the high 4
// bytes of the buf slot are wasted padding) and arm64 (where
// __store_ptr is the full 8-byte STR). Same idea as the Map
// handle: pick a layout that fits the widest pointer and pad
// on narrow targets.
function __map_iter_impl(m: usize): usize {
    var it: usize = __alloc(16);
    __store_ptr(it,     __load_ptr(m));     // data ptr
    __store_i32(it + 8, 0);                  // cursor
    return it;
}

function __mapiter_has_next_impl(it: usize): boolean {
    var buf: usize = __load_ptr(it);
    var i: i32 = __load_i32(it + 8);
    return i < __load_i32(buf + 4);
}

// Shared address arithmetic for MapIter.key() / .value().
function __mapiter_entry_addr(it: usize): usize {
    var buf: usize = __load_ptr(it);
    var cap: i32 = __load_i32(buf);
    var i: i32 = __load_i32(it + 8);
    var entryStride: i32 = 2 * __ptr_width();
    return buf + 16 + cap * 4 + i * entryStride;
}

function __mapiter_key_impl(it: usize): usize {
    return __load_ptr(__mapiter_entry_addr(it));
}

function __mapiter_value_impl(it: usize): usize {
    return __load_ptr(__mapiter_entry_addr(it) + __ptr_width());
}

function __mapiter_advance_impl(it: usize) {
    __store_i32(it + 8, __load_i32(it + 8) + 1);
}

// === HTTP/1.1 parser + serializer ===
//
// Pure-string helpers for parsing an HTTP/1.1 request and
// serializing an HttpResponse. Stacked on top of the existing
// `tcp_listen / tcp_accept / tcp_recv / tcp_send / tcp_close`
// socket primitives so user code can write a manual server
// loop today (a `tcp_serve(port, handler)` convenience wrapper
// + auto-`main()`-from-`handle()` synthesis ship in follow-up
// PRs):
//
//   function main(): i32 {
//     var listener: i32 = tcp_listen(8080);
//     while (true) {
//       var fd: i32 = tcp_accept(listener);
//       var buf: string = tcp_recv(fd, 8192);
//       match (http_parse_request(buf)) {
//         Some(req) => {
//           var resp: HttpResponse = handle(req);
//           tcp_send(fd, http_serialize_response(resp));
//         },
//         None => { /* malformed — close without response */ }
//       }
//       tcp_close(fd);
//     }
//     return 0;
//   }
//
// Scope: HTTP/1.1 only, Content-Length-delimited bodies, no
// chunked transfer encoding, no persistent connections (every
// response advertises `Connection: close`), max 8 KiB headers,
// max 1 MiB body. Sufficient for CLI tools and edge handlers;
// the bigger story (keep-alive, TE chunked, TLS) waits on a
// richer lang shape.

// HTTP method + path string from a request line. Uses
// fixed indices into the line so the caller doesn't have
// to allocate two extra strings. Returns None on malformed
// input (no spaces, missing version).
function __http_parse_request_line(line: string): Option[HttpRequest] {
    var sp1: i32 = line.index_of(" ");
    if (sp1 < 0) {
        return None;
    }
    var sp2: i32 = line[sp1 + 1:len(line)].index_of(" ");
    if (sp2 < 0) {
        return None;
    }
    var method: string = line[0:sp1];
    var path: string = line[sp1 + 1:sp1 + 1 + sp2];
    return Some(HttpRequest { method: method, path: path, body: "" });
}

// Pull the integer Content-Length value out of a header
// block. Case-insensitive header name (HTTP/1.1 §3.2 says
// names are case-insensitive). Returns 0 when absent — every
// HTTP/1.1 method except CONNECT treats absent Content-Length
// + Connection: close as "no body", which is what we want.
//
// Uses a small i32-only parse so the helper compiles for
// arm64 (whose backend doesn't yet implement i64 ops). The
// 1 MiB body cap upstream means values that would overflow
// i32 are filtered out at the body-read step regardless.
function __http_content_length(headers: string): i32 {
    var lower: string = headers.to_lower();
    var key: string = "content-length:";
    var idx: i32 = lower.index_of(key);
    if (idx < 0) {
        return 0;
    }
    var rest: string = headers[idx + len(key):len(headers)];
    var nl: i32 = rest.index_of("\r\n");
    if (nl < 0) {
        nl = len(rest);
    }
    var value: string = rest[0:nl].trim();
    var acc: i32 = 0;
    var i: i32 = 0;
    while (i < len(value)) {
        var b: i32 = value[i];
        if (b < 48 || b > 57) {
            return 0;
        }
        acc = acc * 10 + (b - 48);
        if (acc < 0) {
            // i32 overflow; clamp to 0 so the request reads
            // no body and the client gets a fast reject.
            return 0;
        }
        i = i + 1;
    }
    return acc;
}

// `http_parse_request(buf)` parses a full HTTP/1.1 request
// out of a buffer the caller has already read from the wire.
// Caller is responsible for accumulating bytes via
// `tcp_recv` until the buffer holds at least the header block
// (terminated by `\r\n\r\n`) plus Content-Length bytes of
// body — the parser returns None on a partial buffer rather
// than blocking, so callers driving the read loop can keep
// recv'ing until parse succeeds (or a hard cap fires).
//
// Caps: headers must fit in the first 8 KiB, body capped at
// 1 MiB. Both surface as None so the caller can close the
// socket without a response (HTTP/1.1 §10 allows server-
// side reset on malformed input).
function http_parse_request(buf: string): Option[HttpRequest] {
    if (len(buf) > 8192 + 1048576) {
        return None;
    }
    var headers_end: i32 = buf.index_of("\r\n\r\n");
    if (headers_end < 0) {
        return None;
    }
    if (headers_end > 8192) {
        return None;
    }
    var headers_len: i32 = headers_end + 4;
    var content_length: i32 = __http_content_length(buf[0:headers_end]);
    if (content_length > 1048576) {
        return None;
    }
    if (headers_len + content_length > len(buf)) {
        // Caller hasn't read the full body yet.
        return None;
    }
    var first_crlf: i32 = buf.index_of("\r\n");
    if (first_crlf < 0) {
        return None;
    }
    match (__http_parse_request_line(buf[0:first_crlf])) {
        Some(req) => {
            var body: string = "";
            if (content_length > 0) {
                body = buf[headers_len:headers_len + content_length];
            }
            return Some(HttpRequest {
                method: req.method,
                path: req.path,
                body: body
            });
        },
        None => {
            return None;
        }
    }
}

// Standard HTTP/1.1 reason-phrase mapping for the few
// status codes a typical handler returns. Falls back to
// "Status" for unrecognised codes — the kernel doesn't care,
// browsers display the status code as-is.
function __http_reason(code: i32): string {
    if (code == 200) { return "OK"; }
    if (code == 201) { return "Created"; }
    if (code == 204) { return "No Content"; }
    if (code == 301) { return "Moved Permanently"; }
    if (code == 302) { return "Found"; }
    if (code == 304) { return "Not Modified"; }
    if (code == 400) { return "Bad Request"; }
    if (code == 401) { return "Unauthorized"; }
    if (code == 403) { return "Forbidden"; }
    if (code == 404) { return "Not Found"; }
    if (code == 405) { return "Method Not Allowed"; }
    if (code == 500) { return "Internal Server Error"; }
    if (code == 503) { return "Service Unavailable"; }
    return "Status";
}

// `http_serialize_response(resp)` builds the wire-format
// response from an HttpResponse. Always advertises
// `Connection: close` so the client's `read()` returns the
// EOF that tells it the response is complete after the
// caller's `tcp_send` finishes the write. No keep-alive, no
// chunked TE.
function http_serialize_response(resp: HttpResponse): string {
    var status_line: string = "HTTP/1.1 " + int_to_string(resp.status)
        + " " + __http_reason(resp.status) + "\r\n";
    var headers: string = "Content-Length: " + int_to_string(len(resp.body)) + "\r\n"
        + "Connection: close\r\n"
        + "\r\n";
    return status_line + headers + resp.body;
}

// === HTTP/1.1 accept loop ===
//
// `tcp_serve(port, handler)` runs an HTTP/1.1 accept loop on
// `port`, calling `handler(req)` once per accepted connection.
// Returns -errno when the listener can't be bound (e.g.
// EADDRINUSE); on success the loop runs indefinitely until
// the host kills the process (no clean-shutdown channel
// exposed yet).
//
// Per-connection lifecycle:
//   1. tcp_recv up to 8192 bytes (matches __http_parse_request's
//      header-size cap) plus body bytes via a follow-up recv
//      loop driven by Content-Length.
//   2. http_parse_request — return None ⇒ close the socket
//      without a response (HTTP/1.1 §10 explicitly allows
//      server-side reset on malformed input).
//   3. handler(req) returns the HttpResponse.
//   4. http_serialize_response → tcp_send → tcp_close.
//
// arm64 wires this through real Linux sockets via the
// existing __lang_tcp_* syscall helpers. The wasm side gates
// tcp_* on wasi:sockets at module instantiation; CLI-mode
// programs that call tcp_serve need a host-pre-opened socket
// (`wasmtime run -S tcp=y`).
function tcp_serve(port: i32, handler: (HttpRequest) => HttpResponse): i32 {
    var listener: i32 = tcp_listen(port);
    if (listener < 0) {
        return listener;
    }
    while (true) {
        var fd: i32 = tcp_accept(listener);
        if (fd < 0) {
            // Transient accept failure (EINTR-style) — keep
            // looping. Permanent failures (listener closed by
            // the kernel, FD exhaustion) will repeat the same
            // -errno on every iteration; that's operator-
            // action territory and the lang-side response is
            // the same as success here.
            continue;
        }
        // Per-request arena scope. Snapshot the bump cursor
        // before any request-shaped allocation (recv buffers,
        // parsed HttpRequest, handler-built HttpResponse,
        // serialized wire bytes) and rewind it after tcp_close
        // — every byte allocated during this iteration is
        // reclaimed before the next `tcp_accept`. state{}
        // allocations sit below this save point (state init
        // runs before main, so its cursor is in the
        // pre-arena region) and survive the rewind.
        // Matches the wasi-http `__http_entry` wrapper shape,
        // closing the parity gap between native arm64 and
        // wasm-http handler runtimes.
        var saved: i32 = arena_save();
        // Drain the connection into a single buffer up to the
        // first parse-success. The parser returns None when
        // the buffer is too short (header block not yet
        // terminated by \r\n\r\n, or fewer than Content-Length
        // body bytes), so we keep recv'ing until either parse
        // succeeds or we hit a hard cap / EOF.
        var buf: string = "";
        var have_request: boolean = false;
        var req: HttpRequest = HttpRequest { method: "", path: "", body: "" };
        while (true) {
            var chunk: string = tcp_recv(fd, 4096);
            if (len(chunk) == 0) {
                // EOF before request complete.
                break;
            }
            buf = buf + chunk;
            // Hard cap to keep slow / hostile clients from
            // pinning unbounded memory. Headers must fit in
            // the first 8 KiB; body capped at 1 MiB. Matches
            // http_parse_request's internal caps.
            if (len(buf) > 8192 + 1048576) {
                break;
            }
            match (http_parse_request(buf)) {
                Some(parsed) => {
                    req = parsed;
                    have_request = true;
                },
                None => {
                    // Either still partial — keep recv'ing —
                    // or definitively malformed. In either
                    // case the next iteration will recv more
                    // bytes; if we've already exceeded the
                    // header cap above we've already broken
                    // out.
                }
            }
            if (have_request) {
                break;
            }
        }
        if (have_request) {
            var resp: HttpResponse = handler(req);
            var wire: string = http_serialize_response(resp);
            tcp_send(fd, wire);
        }
        tcp_close(fd);
        arena_restore(saved);
    }
    return 0;
}

// Pull a port number out of an env var. Returns the parsed
// integer on success, -1 on missing / malformed / out-of-
// range. Used by the auto-`main()`-from-`handle()` synthesis
// so handler-shaped programs can be tuned via `PORT=N ./bin`
// without writing a manual main().
//
// Inline i32-only digit accumulation — the prelude's
// `s.parse_int()` uses i64 for overflow safety, which arm64
// can't lower yet. Since the result is bounded to a valid
// TCP port (0..65535), the i32 max is unreachable.
function __port_from_env(name: string, fallback: i32): i32 {
    match (env(name)) {
        Some(s) => {
            var n: i32 = 0;
            var i: i32 = 0;
            while (i < len(s)) {
                var b: i32 = s[i];
                if (b < 48 || b > 57) { return fallback; }
                n = n * 10 + (b - 48);
                if (n > 65535) { return fallback; }
                i = i + 1;
            }
            if (i == 0) { return fallback; }
            return n;
        },
        None => {
            return fallback;
        }
    }
}
