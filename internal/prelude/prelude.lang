// === Numeric range constants ===
//
// Function-style accessors for the width boundaries. Plain
// constants would be cleaner but lang doesn't have a const
// declaration syntax yet; these constant-functions inline at
// the call site via the IR's constant-folding pass.
function i32_max(): i32 { return 2147483647; }
function i32_min(): i32 { return 0 - 2147483647 - 1; }
function i64_max(): i64 { return 9223372036854775807; }
function i64_min(): i64 { return (0 as i64) - 9223372036854775807 - (1 as i64); }










