// Auto-injected standard library. See internal/prelude/prelude.go
// for the rationale; in short, helpers here go through the IR like
// any user code, so they get peephole / dce / inline optimisation
// and drop into every backend without backend-specific shims.
//
// User code can shadow / override anything in this file by
// declaring a same-named function — useful for testing or for
// callers that need different semantics (eg a stricter
// `s.parse_int()` that errors on whitespace).

// `s.is_empty()` is a length-zero shorthand. The IR's len fold
// resolves `len(s)` to a single i32.load at compile time when
// `s` is statically known to be a string, so this typically
// folds to one i32.eqz at the call site.
function (s: string) is_empty(): boolean {
    return len(s) == 0;
}

// `s.repeat(n)` — `n` copies of s concatenated. `n <= 0`
// returns empty; `n == 1` returns a fresh independent copy
// of s (the `+` lowering allocates). Quadratic on large n
// because each `+` allocates a fresh buffer; if a benchmark
// shows that's a real bottleneck, drop to a single-pass
// memcpy via a `__memcpy` shim.
function (s: string) repeat(n: i32): string {
    if (n <= 0) { return ""; }
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        out = out + s;
        i = i + 1;
    }
    return out;
}

// `s.parse_int()` — decimal i32 parser. Optional leading `-`;
// rejects empty input, lone `-`, any non-digit character,
// embedded whitespace, and out-of-range values
// (`-2^31..=2^31-1`). Internal accumulator is i64 so the
// bound check is exact. Returns `None` on failure, `Some(v)`
// on success.
//
// Replaced the ~190-line wat helper that previously lived in
// `wasm.go`; the lang version compiles to roughly the same
// code via the IR.
function (s: string) parse_int(): Option[i32] {
    var n: i32 = len(s);
    if (n == 0) { return None; }

    var i: i32 = 0;
    var neg: boolean = false;
    if (s[0] == 45) {            // '-'
        if (n == 1) { return None; }
        neg = true;
        i = 1;
    }

    var acc: i64 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return None; }   // not 0..9
        acc = acc * 10 + ((b - 48) as i64);
        if (acc >= 4294967296) { return None; }   // > u32 max — never fits i32
        i = i + 1;
    }

    if (neg) {
        if (acc > 2147483648) { return None; }    // < i32 min
        var v: i64 = 0 - acc;
        return Some(v as i32);
    }
    if (acc > 2147483647) { return None; }        // > i32 max
    return Some(acc as i32);
}
