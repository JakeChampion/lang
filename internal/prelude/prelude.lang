// === Decimal int-to-string formatter ===
//
// `int_to_string(n)` — signed-i32 → ASCII decimal. Test
// harness drives it through the `_start` wrapper to print
// `main()`'s return value; user code calls it directly via
// the same name. Pairs with `__int_to_string_u64` below
// for the wider-integer method wrappers.
//
// Algorithm: a 16-byte scratch buffer holds digits written
// backwards from the high end (so the final order comes
// out left-to-right via a single trailing memcpy). The
// negation `n = 0 - n` is unsigned-safe for INT_MIN
// because we then read the result as u32 for the divmod
// chain, and -INT_MIN's unsigned value is exactly
// `2^31`.
function int_to_string(n: i32): string {
    var scratch: u8[] = __alloc_u8(16);
    var scratch_ptr: i32 = scratch as i32;
    var end: i32 = 16;
    var neg: boolean = false;
    if (n < 0) {
        neg = true;
        n = 0 - n;
    }
    var u: u32 = n as u32;
    if (u == (0 as u32)) {
        end = end - 1;
        scratch[end] = 48 as u8;
    } else {
        while (u != (0 as u32)) {
            end = end - 1;
            scratch[end] = (((u % (10 as u32)) as i32) + 48) as u8;
            u = u / (10 as u32);
        }
    }
    if (neg) {
        end = end - 1;
        scratch[end] = 45 as u8;
    }
    var n_bytes: i32 = 16 - end;
    var buf: u8[] = __alloc_u8(n_bytes);
    __memcpy(buf as i32, scratch_ptr + end, n_bytes);
    return string_from_bytes(buf);
}

// `__int_to_string_u64(mag, neg)` — the i64 / u64 cousin.
// `mag` carries the absolute value; `neg` is the sign flag
// (set for the i64-min path where the wrapped subtraction
// produces a u64 magnitude that's exact). Used by the
// method-syntax wrappers `(i64).to_string()` /
// `(u64).to_string()` and their i32 / u32 counterparts that
// promote first.
function __int_to_string_u64(mag: i64, neg: i32): string {
    var scratch: u8[] = __alloc_u8(24);
    var scratch_ptr: i32 = scratch as i32;
    var end: i32 = 24;
    if (mag == (0 as i64)) {
        end = end - 1;
        scratch[end] = 48 as u8;
    } else {
        while (mag != (0 as i64)) {
            end = end - 1;
            scratch[end] = ((((mag as u64) % (10 as u64)) as i32) + 48) as u8;
            mag = ((mag as u64) / (10 as u64)) as i64;
        }
    }
    if (neg != 0) {
        end = end - 1;
        scratch[end] = 45 as u8;
    }
    var n_bytes: i32 = 24 - end;
    var buf: u8[] = __alloc_u8(n_bytes);
    __memcpy(buf as i32, scratch_ptr + end, n_bytes);
    return string_from_bytes(buf);
}






// `pack_rgb(r, g, b)` — pack three 0..255 components into
// a 24-bit i32. Inverse of (n).to_rgb_hex()'s shifts. Each
// component is masked to its low 8 bits; values outside
// 0..255 silently wrap. Pairs with to_rgb_hex for the
// "construct then format" colour pipeline.
function pack_rgb(r: i32, g: i32, b: i32): i32 {
    return ((r & 255) << 16) | ((g & 255) << 8) | (b & 255);
}


// === Radix integer parse / format ===
//
// `parse_int_radix(s, base)` / `int_to_string_radix(n, base)`
// — companions to the decimal-only `parse_int` / `int_to_string`.
// Supported bases: 2..36 (digits 0-9 then a-z, ignoring case).
// Out-of-range base or a malformed digit returns None / a best-
// effort string respectively.
//
// Use cases the decimal helpers don't cover: hex addressing,
// binary debug dumps, octal permissions, base-36 short IDs.
// Matches Rust i32::from_str_radix / i32::to_string_radix and
// Go strconv.ParseInt / strconv.FormatInt minimal subset.

function __radix_digit(c: i32): i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }     // 0-9 → 0-9
    if (c >= 97 && c <= 122) { return c - 87; }     // a-z → 10-35
    if (c >= 65 && c <= 90)  { return c - 55; }     // A-Z → 10-35
    return 0 - 1;
}

function __radix_char(d: i32): i32 {
    if (d < 10) { return d + 48; }                   // 0-9
    return d + 87;                                    // a-z (lowercase)
}

function parse_int_radix(s: string, base: i32): Option[i32] {
    if (base < 2 || base > 36) { return None; }
    var n: i32 = len(s);
    if (n == 0) { return None; }
    var neg: boolean = false;
    var i: i32 = 0;
    if (s[0] == 45) {           // '-'
        neg = true;
        i = 1;
    } else if (s[0] == 43) {    // '+'
        i = 1;
    }
    if (i >= n) { return None; }    // sign without digits
    var v: i32 = 0;
    while (i < n) {
        var d: i32 = __radix_digit(s[i]);
        if (d < 0 || d >= base) { return None; }
        v = v * base + d;
        i = i + 1;
    }
    if (neg) { v = 0 - v; }
    return Some(v);
}

function int_to_string_radix(n: i32, base: i32): string {
    if (base < 2 || base > 36) { return ""; }
    if (n == 0) { return "0"; }
    var neg: boolean = (n < 0);
    // Use i64 magnitude so INT_MIN's negation doesn't overflow.
    var mag: i64 = n as i64;
    if (neg) { mag = 0 - mag; }
    // Worst case is 32 binary digits + sign = 33; allocate slack.
    var digits: u8[] = __alloc_u8(33);
    var k: i32 = 0;
    var b64: i64 = base as i64;
    while (mag > (0 as i64)) {
        var d: i32 = (mag % b64) as i32;
        digits[k] = __radix_char(d) as u8;
        k = k + 1;
        mag = mag / b64;
    }
    var out_len: i32 = k;
    if (neg) { out_len = k + 1; }
    var buf: u8[] = __alloc_u8(out_len);
    var bi: i32 = 0;
    if (neg) {
        buf[0] = 45 as u8;        // '-'
        bi = 1;
    }
    var j: i32 = k - 1;
    while (j >= 0) {
        buf[bi] = digits[j];
        bi = bi + 1;
        j = j - 1;
    }
    return string_from_bytes(buf);
}




// === Float-to-string formatting ===
//
// `f32.to_string()` / `f64.to_string()`. Up to 7 fractional
// digits for f32, 15 for f64 (matching IEEE 754 single /
// double precision); trailing zeros trimmed and the decimal
// point is dropped if the fraction is zero. NaN gets the
// canonical "NaN"; ±Inf get "Inf" / "-Inf". Detection of Inf
// is approximate — the threshold check (`n > 1e300`) covers
// every practically-encountered case but isn't bit-exact
// against `f64.const inf`.

function __float_to_string(n: f64, k: i32): string {
    if (n != n) { return "NaN"; }
    var out: string = "";
    if (n < 0.0) {
        out = "-";
        n = 0.0 - n;
    }
    // Inf detection without a literal `inf` constant: for
    // any finite non-zero f64, `n * 2.0` is strictly larger
    // than `n`. For ±Inf, `Inf * 2.0 == Inf`. We've already
    // extracted the sign and ruled out NaN, so `n` here is
    // either zero, finite-positive, or +Inf.
    if (n != 0.0 && n * 2.0 == n) { return out + "Inf"; }
    // Integer part.
    var intPart: i64 = n as i64;
    out = out + intPart.to_string();
    // Fraction part.
    var frac: f64 = n - (intPart as f64);
    if (frac < 0.0) { frac = 0.0 - frac; }   // guard against `(intPart as f64)` rounding above n
    // mult = 10^k.
    var mult: f64 = 1.0;
    var i: i32 = 0;
    while (i < k) { mult = mult * 10.0; i = i + 1; }
    var fracInt: i64 = (frac * mult) as i64;
    // Find the effective number of digits by trimming
    // trailing zeros from fracInt.
    var effective: i32 = k;
    var tmp: i64 = fracInt;
    while (effective > 0 && (tmp % 10) == 0) {
        tmp = tmp / 10;
        effective = effective - 1;
    }
    if (effective == 0) { return out; }
    // Pad fracInt's decimal repr to k digits with leading
    // zeros, then truncate to `effective`.
    var fracStr: string = fracInt.to_string();
    while (len(fracStr) < k) { fracStr = "0" + fracStr; }
    return out + "." + fracStr[0:effective];
}

function (n: f32) to_string(): string {
    return __float_to_string(n as f64, 7);
}

function (n: f64) to_string(): string {
    return __float_to_string(n, 15);
}







// === Generic Map[K, V] runtime ===
//
// Auto-injected `Map` (a single-field i32-wrapper struct
// holding a kv-buffer pointer) plus its IndexMap-shaped
// open-addressing core. The wat shims `__memcpy`, `__memset`,
// `__alloc`, `__load_i32`, `__store_i32`, plus the slice /
// struct ↔ i32 escape-hatch casts let the runtime live in
// lang without sacrificing the byte-level layout the
// existing test suite already pins down.
//
// Lang-side: declarations use `i32` for K / V because the
// language doesn't yet have generic methods. The checker
// keeps its existing generic FuncSigs registrations
// (`(Map[K,V], K, V) → void` etc.) and the IR rewrites
// `__method_Map_*` / `map_new` calls to these `_impl`
// counterparts at codegen time — same shape as the
// `__array_append_jsonvalue → __array_append_string` alias
// in internal/codegen/wasm/wasm_ir.go.
//
// kv buffer layout (Map's `data` field points here):
//
//   +0   cap     : i32 — bucket count, power-of-2, ≥ 4
//   +4   len     : i32 — live entry count
//   +8   keyKind : i32 — 0 = i32-sized scalar, 1 = string
//   +12  valKind : i32 — 0 = i32-scalar, 1 = pointer-shaped
//   +16  buckets : i32[cap]            (-1 empty, -2 tombstone)
//   +16+cap*4  entries : (k,v)[cap]    per-entry stride = 2 * __ptr_width()
//                                      (8 on wasm32, 16 on arm64)
//
// Entry slots use `__store_ptr` / `__load_ptr` so heap-address
// keys/values (string pointers on arm64-darwin's high heap)
// round-trip without truncation. i32-sized K/V keep working
// because arm64 LDR Wn zero-extends and STR Xn writes the same
// low-32 bits; on wasm32 the slot stays 4 bytes (`__store_ptr`
// is a 4-byte i32.store), no regression in buffer size.
//
// Total: 16 + cap * (4 + 2 * __ptr_width()) bytes.

function __map_pow2_ceil(n: i32): i32 {
    if (n <= 4) { return 4; }
    var p: i32 = 4;
    while (p < n) {
        if (p >= 1073741824) { return p; }   // saturate at 2^30
        p = p << 1;
    }
    return p;
}

// Hash function:
//   keyKind 0 (i32-sized scalar): Wang's integer mix.
//   keyKind 1 (string)          : FNV-1a 32-bit over the bytes.
// Both produce a 32-bit hash that callers mask down to
// `cap - 1` (cap is power-of-2). The unsigned shifts go
// through `as u32` because the lang's `>>` defaults to
// `i32.shr_s` on i32 operands.
// __map_hash hashes a Map key. The param stays `i32` (not
// `usize`) deliberately: the IR uses cell-pointer boxing
// for wide-scalar K (i64 / u64 / f64) so the pointer that
// arrives here always fits in 32 bits on the cell-pointer
// path. For native scalar K (i32 / u32) the value fits
// trivially. The string path casts back via `k as string`,
// which on natives is a no-op pointer reinterpret —
// truncation isn't an issue when the prelude itself ALSO
// runs with i32-sized pointer locals on the call chain
// (see the rest of the Map runtime above for the usize
// migration that started with map_new_impl).
//
// Keeping the param as i32 lets the wide-scalar Map tests
// continue to pass (the i32-narrow at the call boundary
// gives kBits the right bits whether k arrived through a
// usize-typed __map_lookup call or via the older i32 path).
// A future PR can flip this when the wide-scalar K path
// gets its own dedicated hash entrypoint.
function __map_hash(k: i32, keyKind: i32): i32 {
    var h: i32 = 0;
    if (keyKind == 0) {
        h = k ^ 61;
        h = h ^ (((h as u32) >> (16 as u32)) as i32);
        h = h + (h << 3);
        h = h ^ (((h as u32) >> (4 as u32)) as i32);
        h = h * 668265261;                      // 0x27d4eb2d
        h = h ^ (((h as u32) >> (15 as u32)) as i32);
        return h;
    }
    h = 0 - 2128831035;                         // 0x811c9dc5 sign-flipped
    var s: string = k as string;
    var sLen: i32 = len(s);
    var i: i32 = 0;
    while (i < sLen) {
        h = h ^ s[i];
        h = h * 16777619;                       // 0x01000193
        i = i + 1;
    }
    return h;
}

function map_new_impl(cap_hint: i32, keyKind: i32, valKind: i32): usize {
    var cap: i32 = __map_pow2_ceil(cap_hint);
    var entryStride: i32 = 2 * __ptr_width();
    var buf: usize = __alloc(16 + cap * (4 + entryStride));
    __store_i32(buf,      cap);
    __store_i32(buf + 4,  0);
    __store_i32(buf + 8,  keyKind);
    __store_i32(buf + 12, valKind);
    __memset(buf + 16, 255, cap * 4);            // buckets → all -1
    // Map handle is a heap-allocated pointer cell. 8 bytes
    // accommodates a 64-bit `buf` pointer on arm64; wasm32
    // only needs 4 but the extra padding is cheap and keeps
    // the handle layout uniform across targets. Using
    // `__store_ptr` / `__load_ptr` (pointer-width helpers)
    // lets backends pick the right STR/LDR width. The handle
    // pointer itself rides through `usize` end-to-end so
    // arm64-darwin's >4 GiB heap addresses survive the
    // round-trip through every Map helper below.
    var m: usize = __alloc(8);
    __store_ptr(m, buf);
    return m;
}

function __map_len_impl(m: usize): i32 {
    var buf: usize = __load_ptr(m);
    return __load_i32(buf + 4);
}

// __map_lookup returns the entry index of the matching key,
// or -1 if not present. Linear probing over the bucket array,
// skipping tombstones (which keep probing valid past
// deletions).
function __map_lookup(m: usize, k: usize): i32 {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var keyKind: i32 = __load_i32(buf + 8);
    var mask: i32 = cap - 1;
    var entryStride: i32 = 2 * __ptr_width();
    var entriesBase: usize = buf + 16 + cap * 4;
    var bucket: i32 = __map_hash(k, keyKind) & mask;
    while (true) {
        var b: i32 = __load_i32(buf + 16 + bucket * 4);
        if (b == 0 - 1) { return 0 - 1; }
        if (b != 0 - 2) {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            var eq: boolean = false;
            if (keyKind == 0) {
                eq = entryK == k;
            } else {
                eq = (entryK as string) == (k as string);
            }
            if (eq) { return b; }
        }
        bucket = (bucket + 1) & mask;
    }
    return 0 - 1;       // unreachable
}

function __map_has_impl(m: usize, k: usize): boolean {
    return __map_lookup(m, k) != (0 - 1);
}

function __map_get_impl(m: usize, k: usize): Option[usize] {
    var idx: i32 = __map_lookup(m, k);
    if (idx == 0 - 1) { return None; }
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    return Some(__load_ptr(entriesBase + idx * entryStride + ptrW));
}

function __map_get_or_impl(m: usize, k: usize, fallback: usize): usize {
    var idx: i32 = __map_lookup(m, k);
    if (idx == 0 - 1) { return fallback; }
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    return __load_ptr(entriesBase + idx * entryStride + ptrW);
}

// __map_grow doubles the kv buffer's capacity and re-hashes
// every existing entry into the new bucket array. Updates
// the wrapper's data ptr in place; returns the new buffer
// for the inline caller. The bump allocator can't reclaim
// the old buffer; that pays back when the arena resets at
// scope exit.
function __map_grow(m: usize): usize {
    var oldBuf: usize = __load_ptr(m);
    var oldCap: i32 = __load_i32(oldBuf);
    var oldLen: i32 = __load_i32(oldBuf + 4);
    var oldKK:  i32 = __load_i32(oldBuf + 8);
    var oldVK:  i32 = __load_i32(oldBuf + 12);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var oldEntries: usize = oldBuf + 16 + oldCap * 4;
    var newCap: i32 = 4;
    if (oldCap != 0) { newCap = oldCap << 1; }
    var newMask: i32 = newCap - 1;
    var newBuf: usize = __alloc(16 + newCap * (4 + entryStride));
    __store_i32(newBuf,      newCap);
    __store_i32(newBuf + 4,  oldLen);
    __store_i32(newBuf + 8,  oldKK);
    __store_i32(newBuf + 12, oldVK);
    __memset(newBuf + 16, 255, newCap * 4);      // empty buckets
    var newEntries: usize = newBuf + 16 + newCap * 4;
    var i: i32 = 0;
    while (i < oldLen) {
        var key: usize = __load_ptr(oldEntries + i * entryStride);
        var val: usize = __load_ptr(oldEntries + i * entryStride + ptrW);
        __store_ptr(newEntries + i * entryStride,        key);
        __store_ptr(newEntries + i * entryStride + ptrW, val);
        var bucket: i32 = __map_hash(key, oldKK) & newMask;
        while (true) {
            var b: i32 = __load_i32(newBuf + 16 + bucket * 4);
            if (b == 0 - 1) {
                __store_i32(newBuf + 16 + bucket * 4, i);
                break;
            }
            bucket = (bucket + 1) & newMask;
        }
        i = i + 1;
    }
    __store_ptr(m, newBuf);
    return newBuf;
}

function __map_set_impl(m: usize, k: usize, v: usize) {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    // 75% load factor: trigger when (len + 1) * 4 >= cap * 3.
    if ((len_ + 1) * 4 >= cap * 3) {
        __map_grow(m);
        buf = __load_ptr(m);
        cap = __load_i32(buf);
        len_ = __load_i32(buf + 4);
    }
    var keyKind: i32 = __load_i32(buf + 8);
    var mask: i32 = cap - 1;
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var bucket: i32 = __map_hash(k, keyKind) & mask;
    var insertSlot: i32 = 0 - 1;
    var done: boolean = false;
    while (!done) {
        var b: i32 = __load_i32(buf + 16 + bucket * 4);
        if (b == 0 - 1) {
            if (insertSlot == 0 - 1) { insertSlot = bucket; }
            done = true;
        } else if (b == 0 - 2) {
            if (insertSlot == 0 - 1) { insertSlot = bucket; }
            bucket = (bucket + 1) & mask;
        } else {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            var eq: boolean = false;
            if (keyKind == 0) {
                eq = entryK == k;
            } else {
                eq = (entryK as string) == (k as string);
            }
            if (eq) {
                __store_ptr(entriesBase + b * entryStride + ptrW, v);
                return;
            }
            bucket = (bucket + 1) & mask;
        }
    }
    // Append entry at index = len.
    __store_ptr(entriesBase + len_ * entryStride,        k);
    __store_ptr(entriesBase + len_ * entryStride + ptrW, v);
    __store_i32(buf + 16 + insertSlot * 4, len_);
    __store_i32(buf + 4, len_ + 1);
}

// Snapshot a column (keys or values) into a freshly-allocated
// length-prefixed array. `kvOffset` selects the column within
// each entry; `destStride` is the byte stride of the result
// array's element type (4 for i32-sized, ptr-width for
// pointer-shaped). Insertion order preserved up to any
// deletions (swap-with-last reorders past the deleted slot).
//
// Two-mode dispatch on destStride: i32-stride uses i32 loads/
// stores (low 32 bits of the entry slot, which IS the value
// when K/V is i32); pointer-stride uses __load_ptr / __store_
// ptr so the full heap address survives on arm64.
function __map_column(m: usize, kvOffset: i32, destStride: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var entryStride: i32 = 2 * __ptr_width();
    var entriesBase: usize = buf + 16 + cap * 4;
    // Header layout: length prefix lives at `data - 4` so
    // `len(arr)` works on the returned data pointer. When
    // destStride > 4 (pointer-stride arrays on arm64) the
    // first element must be stride-aligned, so the header
    // grows to destStride bytes with the length packed into
    // the last 4 of them.
    var hdr: i32 = 4;
    if (destStride > 4) { hdr = destStride; }
    var arr: usize = __alloc(hdr + len_ * destStride);
    __store_i32(arr + hdr - 4, len_);
    var i: i32 = 0;
    while (i < len_) {
        if (destStride == 4) {
            var v32: i32 = __load_i32(entriesBase + i * entryStride + kvOffset);
            __store_i32(arr + hdr + i * 4, v32);
        } else {
            var vp: usize = __load_ptr(entriesBase + i * entryStride + kvOffset);
            __store_ptr(arr + hdr + i * destStride, vp);
        }
        i = i + 1;
    }
    return arr + hdr;
}

function __map_keys_impl(m: usize): usize {
    var buf: usize = __load_ptr(m);
    var keyKind: i32 = __load_i32(buf + 8);
    if (keyKind == 1) {
        return __map_string_column(m, 0);
    }
    return __map_column(m, 0, 4);
}

function __map_values_impl(m: usize): usize {
    var buf: usize = __load_ptr(m);
    var valKind: i32 = __load_i32(buf + 12);
    var ptrW: i32 = __ptr_width();
    if (valKind == 1) {
        return __map_string_column(m, ptrW);
    }
    return __map_column(m, ptrW, 4);
}

// __map_string_column builds a fresh `string[]` snapshot of
// the Map's K or V column. Each entry slot holds a cell-
// pointer (Map K/V boxing); we deref each one via the
// `cellPtr as string` cast (which emits OpLoad{WidthString}
// on two-word targets and is a no-op on legacy native single-
// pointer-string targets) and push the resulting string into
// a growing `string[]`. Per-element stride is whatever the
// IR computes for `string[]` on this target (8 bytes on
// wasm32, 16 on flipped arm64, 8 on legacy native).
function __map_string_column(m: usize, kvOffset: i32): usize {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var out: string[] = [];
    var i: i32 = 0;
    while (i < len_) {
        var cellPtr: usize = __load_ptr(entriesBase + i * entryStride + kvOffset);
        var s: string = cellPtr as string;
        out = out.push(s);
        i = i + 1;
    }
    return out as usize;
}

function __map_delete_impl(m: usize, k: usize): boolean {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    var len_: i32 = __load_i32(buf + 4);
    var keyKind: i32 = __load_i32(buf + 8);
    var mask: i32 = cap - 1;
    var ptrW: i32 = __ptr_width();
    var entryStride: i32 = 2 * ptrW;
    var entriesBase: usize = buf + 16 + cap * 4;
    var bucket: i32 = __map_hash(k, keyKind) & mask;
    var foundBucket: i32 = 0 - 1;
    var idx: i32 = 0;
    while (true) {
        var b: i32 = __load_i32(buf + 16 + bucket * 4);
        if (b == 0 - 1) { break; }
        if (b != 0 - 2) {
            var entryK: usize = __load_ptr(entriesBase + b * entryStride);
            var eq: boolean = false;
            if (keyKind == 0) {
                eq = entryK == k;
            } else {
                eq = (entryK as string) == (k as string);
            }
            if (eq) {
                foundBucket = bucket;
                idx = b;
                break;
            }
        }
        bucket = (bucket + 1) & mask;
    }
    if (foundBucket == 0 - 1) { return false; }
    // Tombstone the bucket so subsequent probes skip past it.
    __store_i32(buf + 16 + foundBucket * 4, 0 - 2);
    var last: i32 = len_ - 1;
    if (idx != last) {
        // Swap-with-last in the entries array, then patch the
        // moved entry's bucket pointer to its new index. The
        // last entry is alive (about to be removed) so the
        // probe will hit it.
        var lastKey: usize = __load_ptr(entriesBase + last * entryStride);
        var lastBucket: i32 = __map_hash(lastKey, keyKind) & mask;
        while (__load_i32(buf + 16 + lastBucket * 4) != last) {
            lastBucket = (lastBucket + 1) & mask;
        }
        var lastVal: usize = __load_ptr(entriesBase + last * entryStride + ptrW);
        __store_ptr(entriesBase + idx * entryStride,        lastKey);
        __store_ptr(entriesBase + idx * entryStride + ptrW, lastVal);
        __store_i32(buf + 16 + lastBucket * 4, idx);
    }
    __store_i32(buf + 4, last);
    return true;
}

function __map_clear_impl(m: usize) {
    var buf: usize = __load_ptr(m);
    var cap: i32 = __load_i32(buf);
    __store_i32(buf + 4, 0);
    __memset(buf + 16, 255, cap * 4);
}

// MapIter is a 16-byte heap object: [buf:8][cursor:4][pad:4].
// The cursor lives at offset +8 (not +4) so the layout is the
// same on wasm32 (where __store_ptr is 4 bytes and the high 4
// bytes of the buf slot are wasted padding) and arm64 (where
// __store_ptr is the full 8-byte STR). Same idea as the Map
// handle: pick a layout that fits the widest pointer and pad
// on narrow targets.
function __map_iter_impl(m: usize): usize {
    var it: usize = __alloc(16);
    __store_ptr(it,     __load_ptr(m));     // data ptr
    __store_i32(it + 8, 0);                  // cursor
    return it;
}

function __mapiter_has_next_impl(it: usize): boolean {
    var buf: usize = __load_ptr(it);
    var i: i32 = __load_i32(it + 8);
    return i < __load_i32(buf + 4);
}

// Shared address arithmetic for MapIter.key() / .value().
function __mapiter_entry_addr(it: usize): usize {
    var buf: usize = __load_ptr(it);
    var cap: i32 = __load_i32(buf);
    var i: i32 = __load_i32(it + 8);
    var entryStride: i32 = 2 * __ptr_width();
    return buf + 16 + cap * 4 + i * entryStride;
}

function __mapiter_key_impl(it: usize): usize {
    return __load_ptr(__mapiter_entry_addr(it));
}

function __mapiter_value_impl(it: usize): usize {
    return __load_ptr(__mapiter_entry_addr(it) + __ptr_width());
}

function __mapiter_advance_impl(it: usize) {
    __store_i32(it + 8, __load_i32(it + 8) + 1);
}



// === HTTP/1.1 accept loop ===
//
// `tcp_serve(port, handler)` runs an HTTP/1.1 accept loop on
// `port`, calling `handler(req)` once per accepted connection.
// Returns -errno when the listener can't be bound (e.g.
// EADDRINUSE); on success the loop runs indefinitely until
// the host kills the process (no clean-shutdown channel
// exposed yet).
//
// Per-connection lifecycle:
//   1. tcp_recv up to 8192 bytes (matches __http_parse_request's
//      header-size cap) plus body bytes via a follow-up recv
//      loop driven by Content-Length.
//   2. http_parse_request — return None ⇒ close the socket
//      without a response (HTTP/1.1 §10 explicitly allows
//      server-side reset on malformed input).
//   3. handler(req) returns the HttpResponse.
//   4. http_serialize_response → tcp_send → tcp_close.
//
// arm64 wires this through real Linux sockets via the
// existing __lang_tcp_* syscall helpers. The wasm side gates
// tcp_* on wasi:sockets at module instantiation; CLI-mode
// programs that call tcp_serve need a host-pre-opened socket
// (`wasmtime run -S tcp=y`).
function tcp_serve(port: i32, handler: (HttpRequest) => HttpResponse): i32 {
    var listener: i32 = tcp_listen(port);
    if (listener < 0) {
        return listener;
    }
    while (true) {
        var fd: i32 = tcp_accept(listener);
        if (fd < 0) {
            // Transient accept failure (EINTR-style) — keep
            // looping. Permanent failures (listener closed by
            // the kernel, FD exhaustion) will repeat the same
            // -errno on every iteration; that's operator-
            // action territory and the lang-side response is
            // the same as success here.
            continue;
        }
        // Per-request arena scope. Snapshot the bump cursor
        // before any request-shaped allocation (recv buffers,
        // parsed HttpRequest, handler-built HttpResponse,
        // serialized wire bytes) and rewind it after tcp_close
        // — every byte allocated during this iteration is
        // reclaimed before the next `tcp_accept`. state{}
        // allocations sit below this save point (state init
        // runs before main, so its cursor is in the
        // pre-arena region) and survive the rewind.
        // Matches the wasi-http `__http_entry` wrapper shape,
        // closing the parity gap between native arm64 and
        // wasm-http handler runtimes.
        var saved: i32 = arena_save();
        // Drain the connection into a single buffer up to the
        // first parse-success. The parser returns None when
        // the buffer is too short (header block not yet
        // terminated by \r\n\r\n, or fewer than Content-Length
        // body bytes), so we keep recv'ing until either parse
        // succeeds or we hit a hard cap / EOF.
        var buf: string = "";
        var have_request: boolean = false;
        var req: HttpRequest = HttpRequest { method: "", path: "", body: "" };
        while (true) {
            var chunk: string = tcp_recv(fd, 4096);
            if (len(chunk) == 0) {
                // EOF before request complete.
                break;
            }
            buf = buf + chunk;
            // Hard cap to keep slow / hostile clients from
            // pinning unbounded memory. Headers must fit in
            // the first 8 KiB; body capped at 1 MiB. Matches
            // http_parse_request's internal caps.
            if (len(buf) > 8192 + 1048576) {
                break;
            }
            match (http_parse_request(buf)) {
                Some(parsed) => {
                    req = parsed;
                    have_request = true;
                },
                None => {
                    // Either still partial — keep recv'ing —
                    // or definitively malformed. In either
                    // case the next iteration will recv more
                    // bytes; if we've already exceeded the
                    // header cap above we've already broken
                    // out.
                }
            }
            if (have_request) {
                break;
            }
        }
        if (have_request) {
            var resp: HttpResponse = handler(req);
            var wire: string = http_serialize_response(resp);
            tcp_send(fd, wire);
        }
        tcp_close(fd);
        arena_restore(saved);
    }
    return 0;
}

// Pull a port number out of an env var. Returns the parsed
// integer on success, -1 on missing / malformed / out-of-
// range. Used by the auto-`main()`-from-`handle()` synthesis
// so handler-shaped programs can be tuned via `PORT=N ./bin`
// without writing a manual main().
//
// Inline i32-only digit accumulation — the prelude's
// `s.parse_int()` uses i64 for overflow safety, which arm64
// can't lower yet. Since the result is bounded to a valid
// TCP port (0..65535), the i32 max is unreachable.
function __port_from_env(name: string, fallback: i32): i32 {
    match (env(name)) {
        Some(s) => {
            var n: i32 = 0;
            var i: i32 = 0;
            while (i < len(s)) {
                var b: i32 = s[i];
                if (b < 48 || b > 57) { return fallback; }
                n = n * 10 + (b - 48);
                if (n > 65535) { return fallback; }
                i = i + 1;
            }
            if (i == 0) { return fallback; }
            return n;
        },
        None => {
            return fallback;
        }
    }
}
