// Auto-injected standard library. See internal/prelude/prelude.go
// for the rationale; in short, helpers here go through the IR like
// any user code, so they get peephole / dce / inline optimisation
// and drop into every backend without backend-specific shims.
//
// User code can shadow / override anything in this file by
// declaring a same-named function — useful for testing or for
// callers that need different semantics (eg a stricter
// `s.parse_int()` that errors on whitespace).

// `s.is_empty()` is a length-zero shorthand. The IR's len fold
// resolves `len(s)` to a single i32.load at compile time when
// `s` is statically known to be a string, so this typically
// folds to one i32.eqz at the call site.
function (s: string) is_empty(): boolean {
    return len(s) == 0;
}

// `s.repeat(n)` — `n` copies of s concatenated. `n <= 0`
// returns empty; `n == 1` returns a fresh independent copy
// of s (the `+` lowering allocates). Quadratic on large n
// because each `+` allocates a fresh buffer; if a benchmark
// shows that's a real bottleneck, drop to a single-pass
// memcpy via a `__memcpy` shim.
function (s: string) repeat(n: i32): string {
    if (n <= 0) { return ""; }
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        out = out + s;
        i = i + 1;
    }
    return out;
}

// === URL percent-encoding (RFC 3986) ===
//
// `url_encode(s)` / `url_decode(s)` — public stdlib pair.
// `+` is left alone for both directions; callers handling
// `application/x-www-form-urlencoded` pre-process.

function __url_unreserved(b: i32): boolean {
    if (b >= 65 && b <= 90)  { return true; }   // A-Z
    if (b >= 97 && b <= 122) { return true; }   // a-z
    if (b >= 48 && b <= 57)  { return true; }   // 0-9
    if (b == 45 || b == 46 || b == 95 || b == 126) { return true; }
    return false;
}

function __url_hex_char(d: i32): i32 {
    if (d < 10) { return d + 48; }   // '0' + d
    return d + 55;                    // 'A' - 10 + d
}

function __url_hex_val(c: i32): i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }   // 0-9
    if (c >= 97 && c <= 102) { return c - 87; }   // a-f -> 10..15
    if (c >= 65 && c <= 70)  { return c - 55; }   // A-F -> 10..15
    return -1;
}

function url_encode(s: string): string {
    var n: i32 = len(s);
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (__url_unreserved(b)) {
            out = out + s[i:i+1];
        } else {
            var hi: i32 = (b >> 4) & 15;
            var lo: i32 = b & 15;
            // Explicit `as u8` keeps the array literal's
            // element type uniform across re-checks (the
            // monomorph pass re-runs the checker, which
            // doesn't re-apply the destination-context
            // coercion to function-call results).
            var trip: u8[] = [
                37 as u8,
                __url_hex_char(hi) as u8,
                __url_hex_char(lo) as u8
            ];
            out = out + string_from_bytes(trip);
        }
        i = i + 1;
    }
    return out;
}

function url_decode(s: string): string {
    var n: i32 = len(s);
    var out: string = "";
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        var emit: string = s[i:i+1];
        var consumed: i32 = 1;
        if (b == 37 && i + 2 < n) {           // '%'
            var h1: i32 = __url_hex_val(s[i+1]);
            var h2: i32 = __url_hex_val(s[i+2]);
            if (h1 >= 0 && h2 >= 0) {
                var byte: u8[] = [((h1 << 4) | h2) as u8];
                emit = string_from_bytes(byte);
                consumed = 3;
            }
        }
        out = out + emit;
        i = i + consumed;
    }
    return out;
}

// `s.parse_int()` — decimal i32 parser. Optional leading `-`;
// rejects empty input, lone `-`, any non-digit character,
// embedded whitespace, and out-of-range values
// (`-2^31..=2^31-1`). Internal accumulator is i64 so the
// bound check is exact. Returns `None` on failure, `Some(v)`
// on success.
//
// Replaced the ~190-line wat helper that previously lived in
// `wasm.go`; the lang version compiles to roughly the same
// code via the IR.
function (s: string) parse_int(): Option[i32] {
    var n: i32 = len(s);
    if (n == 0) { return None; }

    var i: i32 = 0;
    var neg: boolean = false;
    if (s[0] == 45) {            // '-'
        if (n == 1) { return None; }
        neg = true;
        i = 1;
    }

    var acc: i64 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return None; }   // not 0..9
        acc = acc * 10 + ((b - 48) as i64);
        if (acc >= 4294967296) { return None; }   // > u32 max — never fits i32
        i = i + 1;
    }

    if (neg) {
        if (acc > 2147483648) { return None; }    // < i32 min
        var v: i64 = 0 - acc;
        return Some(v as i32);
    }
    if (acc > 2147483647) { return None; }        // > i32 max
    return Some(acc as i32);
}

// `s.parse_float()` — decimal f32 parser. Grammar:
//   [-]<digits>[.<digits>][(e|E)[+-]?<digits>]
// At least one of integer or fraction digits required;
// trailing garbage rejected. Mantissa accumulates into an
// i64 with a saturation cap at 1e15; beyond that, extra
// digits are skipped while `exp_adj` keeps the magnitude
// right. Final value = `(f32) mantissa * 10^exp_adj`,
// sign applied via `0.0 - v`.
function (s: string) parse_float(): Option[f32] {
    var n: i32 = len(s);
    if (n == 0) { return None; }

    var i: i32 = 0;
    var neg: boolean = false;
    if (s[0] == 45) {                       // '-'
        if (n == 1) { return None; }
        neg = true;
        i = 1;
    }

    var mantissa: i64 = 0;
    var exp_adj: i32 = 0;
    var saw_int: boolean = false;
    var saw_frac: boolean = false;
    // Single `b` reused across the integer / fraction /
    // exponent inner loops — declaring the same name in
    // multiple inner scopes triggers a duplicate-local
    // collision in the wasm emitter (which names locals by
    // their lang identifier).
    var b: i32 = 0;

    // Integer digits.
    while (i < n) {
        b = s[i];
        if (b < 48 || b > 57) { break; }
        if (mantissa < 1000000000000000) {
            mantissa = mantissa * 10 + ((b - 48) as i64);
        } else {
            exp_adj = exp_adj + 1;
        }
        saw_int = true;
        i = i + 1;
    }

    // Fraction part: `.` followed by digits.
    if (i < n && s[i] == 46) {              // '.'
        i = i + 1;
        while (i < n) {
            b = s[i];
            if (b < 48 || b > 57) { break; }
            if (mantissa < 1000000000000000) {
                mantissa = mantissa * 10 + ((b - 48) as i64);
                exp_adj = exp_adj - 1;
            }
            saw_frac = true;
            i = i + 1;
        }
    }

    if (!saw_int && !saw_frac) { return None; }

    // Exponent part.
    if (i < n && (s[i] == 101 || s[i] == 69)) {  // 'e' / 'E'
        i = i + 1;
        var exp_neg: boolean = false;
        if (i < n && s[i] == 43) { i = i + 1; }                          // '+'
        else if (i < n && s[i] == 45) { exp_neg = true; i = i + 1; }     // '-'
        var exp: i32 = 0;
        var saw_exp: boolean = false;
        while (i < n) {
            b = s[i];
            if (b < 48 || b > 57) { break; }
            if (exp < 1000) { exp = exp * 10 + (b - 48); }
            saw_exp = true;
            i = i + 1;
        }
        if (!saw_exp) { return None; }
        if (exp_neg) { exp_adj = exp_adj - exp; }
        else { exp_adj = exp_adj + exp; }
    }

    if (i < n) { return None; }   // trailing garbage

    // v = (f32) mantissa * 10^exp_adj
    var v: f32 = mantissa as f32;
    while (exp_adj > 0) { v = v * 10.0 as f32; exp_adj = exp_adj - 1; }
    while (exp_adj < 0) { v = v / 10.0 as f32; exp_adj = exp_adj + 1; }
    if (neg) { v = 0.0 as f32 - v; }
    return Some(v);
}

// === Float-to-string formatting ===
//
// `f32.to_string()` / `f64.to_string()`. Up to 7 fractional
// digits for f32, 15 for f64 (matching IEEE 754 single /
// double precision); trailing zeros trimmed and the decimal
// point is dropped if the fraction is zero. NaN gets the
// canonical "NaN"; ±Inf get "Inf" / "-Inf". Detection of Inf
// is approximate — the threshold check (`n > 1e300`) covers
// every practically-encountered case but isn't bit-exact
// against `f64.const inf`.

function __float_to_string(n: f64, k: i32): string {
    if (n != n) { return "NaN"; }
    var out: string = "";
    if (n < 0.0) {
        out = "-";
        n = 0.0 - n;
    }
    // Inf detection without a literal `inf` constant: for
    // any finite non-zero f64, `n * 2.0` is strictly larger
    // than `n`. For ±Inf, `Inf * 2.0 == Inf`. We've already
    // extracted the sign and ruled out NaN, so `n` here is
    // either zero, finite-positive, or +Inf.
    if (n != 0.0 && n * 2.0 == n) { return out + "Inf"; }
    // Integer part.
    var intPart: i64 = n as i64;
    out = out + intPart.to_string();
    // Fraction part.
    var frac: f64 = n - (intPart as f64);
    if (frac < 0.0) { frac = 0.0 - frac; }   // guard against `(intPart as f64)` rounding above n
    // mult = 10^k.
    var mult: f64 = 1.0;
    var i: i32 = 0;
    while (i < k) { mult = mult * 10.0; i = i + 1; }
    var fracInt: i64 = (frac * mult) as i64;
    // Find the effective number of digits by trimming
    // trailing zeros from fracInt.
    var effective: i32 = k;
    var tmp: i64 = fracInt;
    while (effective > 0 && (tmp % 10) == 0) {
        tmp = tmp / 10;
        effective = effective - 1;
    }
    if (effective == 0) { return out; }
    // Pad fracInt's decimal repr to k digits with leading
    // zeros, then truncate to `effective`.
    var fracStr: string = fracInt.to_string();
    while (len(fracStr) < k) { fracStr = "0" + fracStr; }
    return out + "." + fracStr[0:effective];
}

function (n: f32) to_string(): string {
    return __float_to_string(n as f64, 7);
}

function (n: f64) to_string(): string {
    return __float_to_string(n, 15);
}

// === URL parsing ===
//
// `url_parse(s)` decomposes an absolute or relative URL into
// the auto-injected `Url` struct. Returns `Option[Url]`;
// `None` only on completely empty input — best-effort parse
// otherwise with empty strings for missing sections and
// `port = 0` when unspecified or unparseable. No %-decoding;
// `query` and `fragment` are returned raw.

function url_parse(s: string): Option[Url] {
    var n: i32 = len(s);
    if (n == 0) { return None; }

    var u: Url = Url {
        scheme: "",
        host: "",
        port: 0,
        path: "",
        query: "",
        fragment: ""
    };

    // Find scheme: look for ":" followed by "//".
    var scheme_end: i32 = -1;
    var i: i32 = 0;
    while (i + 2 < n) {
        if (s[i] == 58 && s[i+1] == 47 && s[i+2] == 47) {
            if (i > 0) { scheme_end = i; }
            break;
        }
        i = i + 1;
    }

    var rest_start: i32 = 0;
    if (scheme_end >= 0) {
        u.scheme = s[0:scheme_end];
        rest_start = scheme_end + 3;
    }

    // Find fragment '#' from rest_start onwards.
    var frag_start: i32 = n;
    i = rest_start;
    while (i < n) {
        if (s[i] == 35) { frag_start = i; break; }   // '#'
        i = i + 1;
    }
    if (frag_start < n) {
        u.fragment = s[frag_start+1:n];
    }

    // Find query '?' in [rest_start, frag_start).
    var query_start: i32 = frag_start;
    i = rest_start;
    while (i < frag_start) {
        if (s[i] == 63) { query_start = i; break; }   // '?'
        i = i + 1;
    }
    if (query_start < frag_start) {
        u.query = s[query_start+1:frag_start];
    }

    // Find authority end. With a scheme, scan for the first
    // '/' in [rest_start, query_start). Without a scheme the
    // whole [rest_start, ...] is the path, so authority_end
    // collapses to rest_start.
    var authority_end: i32 = query_start;
    if (scheme_end >= 0) {
        i = rest_start;
        while (i < query_start) {
            if (s[i] == 47) { authority_end = i; break; }   // '/'
            i = i + 1;
        }
    } else {
        authority_end = rest_start;
    }

    // Authority — split host:port.
    if (rest_start < authority_end) {
        var colon: i32 = authority_end;
        i = rest_start;
        while (i < authority_end) {
            if (s[i] == 58) { colon = i; break; }   // ':'
            i = i + 1;
        }
        if (colon < authority_end) {
            u.host = s[rest_start:colon];
            // Port: digits only, max 65535. Any non-digit or
            // out-of-range value zeroes the port.
            var port: i32 = 0;
            i = colon + 1;
            while (i < authority_end) {
                var b: i32 = s[i];
                if (b < 48 || b > 57) { port = 0; break; }
                port = port * 10 + (b - 48);
                if (port > 65535) { port = 0; break; }
                i = i + 1;
            }
            u.port = port;
        } else {
            u.host = s[rest_start:authority_end];
        }
    }

    // Path: [authority_end, query_start).
    if (authority_end < query_start) {
        u.path = s[authority_end:query_start];
    }

    return Some(u);
}

// === Query string parsing ===
//
// `query_parse(s)` splits a URL-encoded query string into a
// `Map[string, string[]]`. Pairs separated by `&`; within a
// pair, `=` separates key from value. Both halves are
// `url_decode`'d. Duplicate keys all preserved — values for
// the same key collect into a `string[]` in insertion order.
// A pair without `=` records the key with a single-element
// empty-string array. Empty input yields an empty map.
// Trailing `&` is ignored.

function query_parse(s: string): Map[string, string[]] {
    var m: Map[string, string[]] = map_new(8);
    var n: i32 = len(s);
    if (n == 0) { return m; }

    var pair_start: i32 = 0;
    var i: i32 = 0;
    // Walk one past the end so a final pair without a
    // trailing `&` still gets processed via the `i == n`
    // sentinel.
    while (i <= n) {
        var sep: boolean = false;
        if (i == n) { sep = true; }
        else if (s[i] == 38) { sep = true; }   // '&'
        if (sep) {
            var pair_len: i32 = i - pair_start;
            if (pair_len > 0) {
                __query_pair(m, s, pair_start, i);
            }
            pair_start = i + 1;
        }
        i = i + 1;
    }
    return m;
}

function __query_pair(m: Map[string, string[]], s: string, start: i32, end: i32) {
    // Find '=' in [start, end).
    var eq: i32 = -1;
    var j: i32 = start;
    while (j < end) {
        if (s[j] == 61) { eq = j; break; }   // '='
        j = j + 1;
    }
    var key: string = "";
    var val: string = "";
    if (eq >= 0) {
        key = url_decode(s[start:eq]);
        val = url_decode(s[eq+1:end]);
    } else {
        key = url_decode(s[start:end]);
    }
    // Append-or-create: probe the map; on hit, copy + append;
    // else create a one-element array.
    match (m.get(key)) {
        Some(existing) => {
            m.set(key, __array_append_string(existing, val));
        },
        None => {
            var arr: string[] = [val];
            m.set(key, arr);
        }
    }
}

// === JSON encoding ===
//
// `json_encode(v)` walks the auto-injected `JsonValue` tree
// and produces the canonical JSON text. Strings are escape-
// encoded; arrays / objects recurse. Numbers emit their
// payload string verbatim — the responsibility for valid
// numeric formatting sits with the caller.

function __json_hex_lower(d: i32): i32 {
    if (d < 10) { return d + 48; }   // '0' + d
    return d + 87;                    // 'a' - 10 + d
}

function __json_escape(s: string): string {
    var out: string = "";
    var n: i32 = len(s);
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 34) { out = out + "\\\""; }
        else if (b == 92) { out = out + "\\\\"; }
        else if (b == 10) { out = out + "\\n"; }
        else if (b == 13) { out = out + "\\r"; }
        else if (b == 9) { out = out + "\\t"; }
        else if (b < 32) {
            // \u00XX with lowercase hex.
            var hi: i32 = (b >> 4) & 15;
            var lo: i32 = b & 15;
            var trip: u8[] = [
                92 as u8,
                117 as u8,
                48 as u8,
                48 as u8,
                __json_hex_lower(hi) as u8,
                __json_hex_lower(lo) as u8
            ];
            out = out + string_from_bytes(trip);
        } else {
            out = out + s[i:i+1];
        }
        i = i + 1;
    }
    return out;
}

function json_encode(v: JsonValue): string {
    // Single shared `out` and `i` across match arms — the
    // wasm emitter names locals by lang identifier, so
    // re-declaring `var out` in nested scopes collides
    // (same footgun parse_float hit).
    var out: string = "";
    var i: i32 = 0;
    match (v) {
        JNull => { return "null"; },
        JBool(b) => {
            if (b) { return "true"; }
            return "false";
        },
        JNumber(s) => { return s; },
        JString(s) => {
            return "\"" + __json_escape(s) + "\"";
        },
        JArray(arr) => {
            out = "[";
            var n: i32 = len(arr);
            while (i < n) {
                if (i > 0) { out = out + ","; }
                out = out + json_encode(arr[i]);
                i = i + 1;
            }
            return out + "]";
        },
        JObject(m) => {
            out = "{";
            var first: boolean = true;
            var iter: MapIter[string, JsonValue] = m.iter();
            while (iter.has_next()) {
                if (!first) { out = out + ","; }
                first = false;
                out = out + "\"" + __json_escape(iter.key()) + "\":";
                out = out + json_encode(iter.value());
                iter.advance();
            }
            return out + "}";
        }
    }
}

// === JSON parsing ===
//
// `json_parse(s)` is the inverse of `json_encode`. Returns
// `Option[JsonValue]`; `None` on any malformed input.
// Recursive descent over a `__JsonParser` state struct
// (s + pos + error). Numbers are stored verbatim as
// `JNumber`'s string payload. String escapes are decoded
// (`\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`,
// `\uXXXX` for BMP code points). Surrogate pairs aren't
// combined yet.

struct __JsonParser {
    s: string,
    pos: i32,
    error: i32,
}

function __json_p_skip_ws(p: __JsonParser) {
    var n: i32 = len(p.s);
    while (p.pos < n) {
        var b: i32 = p.s[p.pos];
        if (b != 32 && b != 9 && b != 10 && b != 13) { break; }
        p.pos = p.pos + 1;
    }
}

function __json_p_byte(p: __JsonParser): i32 {
    if (p.pos >= len(p.s)) { return 0; }
    return p.s[p.pos];
}

function __json_hex_value(c: i32): i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70)  { return c - 55; }
    return -1;
}

function __json_p_number(p: __JsonParser): JsonValue {
    var start: i32 = p.pos;
    var n: i32 = len(p.s);
    var b: i32 = 0;
    // Optional '-'
    if (__json_p_byte(p) == 45) { p.pos = p.pos + 1; }
    // At least one digit.
    b = __json_p_byte(p);
    if (b < 48 || b > 57) { p.error = 1; return JNull; }
    // Integer digits.
    while (p.pos < n) {
        b = p.s[p.pos];
        if (b < 48 || b > 57) { break; }
        p.pos = p.pos + 1;
    }
    // Optional '.<digits>'.
    if (__json_p_byte(p) == 46) {
        p.pos = p.pos + 1;
        while (p.pos < n) {
            b = p.s[p.pos];
            if (b < 48 || b > 57) { break; }
            p.pos = p.pos + 1;
        }
    }
    // Optional [eE][+-]?<digits>.
    b = __json_p_byte(p);
    if (b == 101 || b == 69) {
        p.pos = p.pos + 1;
        b = __json_p_byte(p);
        if (b == 43 || b == 45) { p.pos = p.pos + 1; }
        while (p.pos < n) {
            b = p.s[p.pos];
            if (b < 48 || b > 57) { break; }
            p.pos = p.pos + 1;
        }
    }
    return JNumber(p.s[start:p.pos]);
}

// __json_emit_codepoint encodes a single Unicode scalar value
// as the matching UTF-8 byte sequence (1-4 bytes) and appends
// it to `out`. Supports the full Unicode range up to
// U+10FFFF; the caller is expected to have resolved any
// surrogate pairs into a single code point already.
function __json_emit_codepoint(out: string, cp: i32): string {
    if (cp < 128) {
        var ub1: u8[] = [cp as u8];
        return out + string_from_bytes(ub1);
    }
    if (cp < 2048) {
        var ub2: u8[] = [
            ((cp >> 6) | 192) as u8,
            ((cp & 63) | 128) as u8
        ];
        return out + string_from_bytes(ub2);
    }
    if (cp < 65536) {
        var ub3: u8[] = [
            ((cp >> 12) | 224) as u8,
            (((cp >> 6) & 63) | 128) as u8,
            ((cp & 63) | 128) as u8
        ];
        return out + string_from_bytes(ub3);
    }
    var ub4: u8[] = [
        ((cp >> 18) | 240) as u8,
        (((cp >> 12) & 63) | 128) as u8,
        (((cp >> 6) & 63) | 128) as u8,
        ((cp & 63) | 128) as u8
    ];
    return out + string_from_bytes(ub4);
}

// __json_p_uhex parses 4 hex digits at p.pos (without
// consuming the leading `\u`) and returns the decoded value.
// Sets p.error and returns 0 on any non-hex digit or
// past-end-of-input. Does NOT consume the hex digits past
// what it reads — it advances p.pos by 4 on success.
function __json_p_uhex(p: __JsonParser): i32 {
    if (p.pos + 4 > len(p.s)) { p.error = 1; return 0; }
    var u: i32 = 0;
    var i: i32 = 0;
    while (i < 4) {
        var hv: i32 = __json_hex_value(p.s[p.pos]);
        if (hv < 0) { p.error = 1; return 0; }
        u = (u << 4) | hv;
        p.pos = p.pos + 1;
        i = i + 1;
    }
    return u;
}

function __json_p_string(p: __JsonParser): string {
    if (__json_p_byte(p) != 34) { p.error = 1; return ""; }
    p.pos = p.pos + 1;
    var out: string = "";
    var n: i32 = len(p.s);
    var b: i32 = 0;
    while (true) {
        b = __json_p_byte(p);
        if (b == 0) { p.error = 1; return ""; }
        if (b == 34) { p.pos = p.pos + 1; return out; }
        if (b == 92) {                                  // '\\'
            p.pos = p.pos + 1;
            var esc: i32 = __json_p_byte(p);
            if (esc == 0) { p.error = 1; return ""; }
            if (esc == 117) {                           // 'u' — \uXXXX
                p.pos = p.pos + 1;
                var u: i32 = __json_p_uhex(p);
                if (p.error != 0) { return ""; }
                // High surrogate (D800..DBFF): combine with
                // the following low surrogate (DC00..DFFF) to
                // form a single astral code point. Lone or
                // mismatched surrogates fall back to U+FFFD
                // (REPLACEMENT CHARACTER) — matches Go's
                // encoding/json + most strict UTF-8 emitters.
                if (u >= 55296 && u <= 56319) {
                    if (p.pos + 6 > n
                        || p.s[p.pos] != 92
                        || p.s[p.pos+1] != 117) {
                        out = __json_emit_codepoint(out, 65533);
                    } else {
                        p.pos = p.pos + 2;
                        var low: i32 = __json_p_uhex(p);
                        if (p.error != 0) { return ""; }
                        if (low < 56320 || low > 57343) {
                            out = __json_emit_codepoint(out, 65533);
                            out = __json_emit_codepoint(out, low);
                        } else {
                            var cp: i32 = 65536
                                + ((u - 55296) << 10)
                                + (low - 56320);
                            out = __json_emit_codepoint(out, cp);
                        }
                    }
                } else if (u >= 56320 && u <= 57343) {
                    out = __json_emit_codepoint(out, 65533);
                } else {
                    out = __json_emit_codepoint(out, u);
                }
            } else {
                var ch: i32 = -1;
                if (esc == 34 || esc == 92 || esc == 47) { ch = esc; }
                else if (esc == 110) { ch = 10; }
                else if (esc == 114) { ch = 13; }
                else if (esc == 116) { ch = 9; }
                else if (esc == 98)  { ch = 8; }
                else if (esc == 102) { ch = 12; }
                else { p.error = 1; return ""; }
                var sb: u8[] = [ch as u8];
                out = out + string_from_bytes(sb);
                p.pos = p.pos + 1;
            }
        } else {
            out = out + p.s[p.pos:p.pos+1];
            p.pos = p.pos + 1;
        }
    }
    return "";   // unreachable
}

function __json_p_array(p: __JsonParser): JsonValue {
    p.pos = p.pos + 1;                                  // consume '['
    __json_p_skip_ws(p);
    if (__json_p_byte(p) == 93) {                       // ']'
        p.pos = p.pos + 1;
        var empty: JsonValue[] = [];
        return JArray(empty);
    }
    var arr: JsonValue[] = [];
    while (true) {
        var elem: JsonValue = __json_p_value(p);
        if (p.error != 0) { return JNull; }
        arr = __array_append_jsonvalue(arr, elem);
        __json_p_skip_ws(p);
        var b: i32 = __json_p_byte(p);
        if (b == 44) {                                  // ','
            p.pos = p.pos + 1;
            __json_p_skip_ws(p);
            continue;
        }
        if (b == 93) {                                  // ']'
            p.pos = p.pos + 1;
            return JArray(arr);
        }
        p.error = 1;
        return JNull;
    }
    return JNull;   // unreachable
}

function __json_p_object(p: __JsonParser): JsonValue {
    p.pos = p.pos + 1;                                  // consume '{'
    __json_p_skip_ws(p);
    var m: Map[string, JsonValue] = map_new(8);
    if (__json_p_byte(p) == 125) {                      // '}'
        p.pos = p.pos + 1;
        return JObject(m);
    }
    while (true) {
        var key: string = __json_p_string(p);
        if (p.error != 0) { return JNull; }
        __json_p_skip_ws(p);
        if (__json_p_byte(p) != 58) {                   // ':'
            p.error = 1; return JNull;
        }
        p.pos = p.pos + 1;
        var val: JsonValue = __json_p_value(p);
        if (p.error != 0) { return JNull; }
        m.set(key, val);
        __json_p_skip_ws(p);
        var b: i32 = __json_p_byte(p);
        if (b == 44) {                                  // ','
            p.pos = p.pos + 1;
            __json_p_skip_ws(p);
            continue;
        }
        if (b == 125) {                                 // '}'
            p.pos = p.pos + 1;
            return JObject(m);
        }
        p.error = 1;
        return JNull;
    }
    return JNull;   // unreachable
}

function __json_p_value(p: __JsonParser): JsonValue {
    __json_p_skip_ws(p);
    var b: i32 = __json_p_byte(p);
    if (b == 0) { p.error = 1; return JNull; }
    if (b == 110) {                                     // 'n' — null
        if (p.pos + 4 > len(p.s)) { p.error = 1; return JNull; }
        if (p.s[p.pos+1] != 117 || p.s[p.pos+2] != 108 || p.s[p.pos+3] != 108) {
            p.error = 1; return JNull;
        }
        p.pos = p.pos + 4;
        return JNull;
    }
    if (b == 116) {                                     // 't' — true
        if (p.pos + 4 > len(p.s)) { p.error = 1; return JNull; }
        if (p.s[p.pos+1] != 114 || p.s[p.pos+2] != 117 || p.s[p.pos+3] != 101) {
            p.error = 1; return JNull;
        }
        p.pos = p.pos + 4;
        return JBool(true);
    }
    if (b == 102) {                                     // 'f' — false
        if (p.pos + 5 > len(p.s)) { p.error = 1; return JNull; }
        if (p.s[p.pos+1] != 97 || p.s[p.pos+2] != 108 ||
            p.s[p.pos+3] != 115 || p.s[p.pos+4] != 101) {
            p.error = 1; return JNull;
        }
        p.pos = p.pos + 5;
        return JBool(false);
    }
    if (b == 34) {                                      // '"' — string
        var s: string = __json_p_string(p);
        if (p.error != 0) { return JNull; }
        return JString(s);
    }
    if (b == 91)  { return __json_p_array(p); }         // '['
    if (b == 123) { return __json_p_object(p); }        // '{'
    if (b == 45 || (b >= 48 && b <= 57)) {              // '-' or digit
        return __json_p_number(p);
    }
    p.error = 1;
    return JNull;
}

function json_parse(s: string): Option[JsonValue] {
    var p: __JsonParser = __JsonParser { s: s, pos: 0, error: 0 };
    var v: JsonValue = __json_p_value(p);
    __json_p_skip_ws(p);
    if (p.error != 0 || p.pos < len(p.s)) { return None; }
    return Some(v);
}
