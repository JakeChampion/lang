import "std/string";
import "../coreutils/lib/gnu";

const OPT_PRINT_BYTES: i32 = 1;

const OPT_IGNORE: i32 = 2;

const OPT_VERBOSE: i32 = 3;

const OPT_BYTES: i32 = 4;

const OPT_QUIET: i32 = 5;

const OPT_PRINT_CHARS: i32 = 6;

const EXIT_DIFFER: i32 = 1;

const EXIT_TROUBLE: i32 = 2;

const CHUNK: i32 = 65536;

const OFF_MAX: u64 = 9223372036854775807;

function help_text(): string {
  let p = gnu.prog();
  let out = "Usage: " + p + " [OPTION]... FILE1 [FILE2 [SKIP1 [SKIP2]]]\n";
  out += "Compare two files byte by byte.\n";
  out += "\n";
  out += "The optional SKIP1 and SKIP2 specify the number of bytes to skip\n";
  out += "at the beginning of each file (zero by default).\n";
  out += "\n";
  out += "Mandatory arguments to long options are mandatory for short options too.\n";
  out += "  -b, --print-bytes          print differing bytes\n";
  out += "  -i, --ignore-initial=SKIP         skip first SKIP bytes of both inputs\n";
  out += "  -i, --ignore-initial=SKIP1:SKIP2  skip first SKIP1 bytes of FILE1 and\n";
  out += "                                      first SKIP2 bytes of FILE2\n";
  out += "  -l, --verbose              output byte numbers and differing byte values\n";
  out += "  -n, --bytes=LIMIT          compare at most LIMIT bytes\n";
  out += "  -s, --quiet, --silent      suppress all normal output\n";
  out += "      --help                 display this help and exit\n";
  out += "  -v, --version              output version information and exit\n";
  out += "\n";
  out += "SKIP values may be followed by the following multiplicative suffixes:\n";
  out += "kB 1000, K 1024, MB 1,000,000, M 1,048,576,\n";
  out += "GB 1,000,000,000, G 1,073,741,824, and so on for T, P, E, Z, Y.\n";
  out += "\n";
  out += "If a FILE is '-' or missing, read standard input.\n";
  out += "Exit status is 0 if inputs are the same, 1 if different, 2 if trouble.\n";
  return out;
}

struct Cfg { print_bytes: boolean, verbose: boolean, quiet: boolean, limit: u64, skip: u64[] }

function usage_error(msg: string): void {
  gnu.error(msg);
  gnu.try_help_in("diffutils", EXIT_TROUBLE);
}

// A number with an optional suffix, as xstrtoumax reads it with the suffixes
// "kKMGTPEZY0": base 0, then k or K for 1024 (1000 when "B" follows, 1024
// when "iB" follows), M, G, and so on. It gives the value and the index after
// it. A negative index means the text is not a number.
function parse_size(s: string, from: i32): (u64, i32) {
  let i = from;
  while (i < s.len() && gnu.is_blank(s[i] as i32)) {
    i += 1;
  }
  if (i < s.len() && s[i] == b'+') {
    i += 1;
  }
  let digits = parse_digits(s, i);
  let value = digits.0;
  let end = digits.1;
  if (end < 0) {
    return (0 as u64, -1);
  }
  if (end == i) {
    if (end >= s.len() || suffix_power(s[end]) < 0) {
      return (0 as u64, -1);
    }
    value = 1 as u64;
  }
  if (end < s.len() && suffix_power(s[end]) >= 0) {
    return scale(s, end, value);
  }
  return (value, end);
}

// The digits at `i`, with a 0x prefix for hexadecimal and a leading 0 for
// octal. The index is -1 on overflow.
function parse_digits(s: string, i: i32): (u64, i32) {
  let base = 10 as u64;
  let j = i;
  if (j + 1 < s.len() && s[j] == b'0' && (s[j + 1] == b'x' || s[j + 1] == b'X') && j + 2 < s.len() && digit_value(s[j + 2], 16 as u64) >= 0) {
    base = 16 as u64;
    j += 2;
  } else if (j < s.len() && s[j] == b'0') {
    base = 8 as u64;
  }
  let value = 0 as u64;
  while (j < s.len() && digit_value(s[j], base) >= 0) {
    let d = digit_value(s[j], base) as u64;
    if (value > (18446744073709551615 as u64 - d) / base) {
      return (0 as u64, -1);
    }
    value = value * base + d;
    j += 1;
  }
  return (value, j);
}

function digit_value(c: u8, base: u64): i32 {
  let v = -1;
  if (c >= b'0' && c <= b'9') {
    v = (c - b'0') as i32;
  } else if (c >= b'a' && c <= b'f') {
    v = (c - b'a') as i32 + 10;
  } else if (c >= b'A' && c <= b'F') {
    v = (c - b'A') as i32 + 10;
  }
  if (v as u64 >= base) {
    return -1;
  }
  return v;
}

function suffix_power(c: u8): i32 {
  return match (c) {
    b'k' => 1,
    b'K' => 1,
    b'M' => 2,
    b'G' => 3,
    b'T' => 4,
    b'P' => 5,
    b'E' => 6,
    b'Z' => 7,
    b'Y' => 8,
    _ => -1,
  };
}

function scale(s: string, at: i32, value: u64): (u64, i32) {
  let base = 1024 as u64;
  let end = at + 1;
  if (end < s.len() && s[end] == b'B') {
    base = 1000 as u64;
    end += 1;
  } else if (end + 1 < s.len() && s[end] == b'i' && s[end + 1] == b'B') {
    end += 2;
  }
  let v = value;
  for _ in 0..suffix_power(s[at]) {
    if (v > 18446744073709551615 as u64 / base) {
      return (0 as u64, -1);
    }
    v = v * base;
  }
  return (v, end);
}

// specify_ignore_initial: the skip of file `f` becomes the larger of its
// value and the number at `from`, which ends at `stop` or at the end.
function specify_skip(cfg: Cfg, f: i32, s: string, from: i32, stop: u8): (Cfg, i32) {
  let r = parse_size(s, from);
  let ok = r.1 >= 0 && r.0 <= OFF_MAX && (r.1 == s.len() || stop != 0 as u8 && s[r.1] == stop);
  if (!ok) {
    usage_error("invalid --ignore-initial value '" + slice_unchecked(s, from, s.len()) + "'");
  }
  let skip = cfg.skip;
  if (skip[f] < r.0) {
    skip = skip.with(f, r.0);
  }
  return (Cfg { ...cfg, skip: skip }, r.1);
}

function ignore_option(cfg: Cfg, v: string): Cfg {
  let first = specify_skip(cfg, 0, v, 0, b':');
  let c = first.0;
  if (first.1 < v.len()) {
    return specify_skip(c, 1, v, first.1 + 1, 0 as u8).0;
  }
  if (c.skip[1] < c.skip[0]) {
    return Cfg { ...c, skip: c.skip.with(1, c.skip[0]) };
  }
  return c;
}

function bytes_option(cfg: Cfg, v: string): Cfg {
  let r = parse_size(v, 0);
  if (r.1 != v.len()) {
    usage_error("invalid --bytes value '" + v + "'");
  }
  return Cfg { ...cfg, limit: r.0 };
}

function parse(argv: string[]): (Cfg, string[]) {
  let opts: gnu.Opt[] = [
    gnu.flag("b", "print-bytes", OPT_PRINT_BYTES), gnu.flag("c", "print-chars", OPT_PRINT_CHARS), gnu.valued("i", "ignore-initial", OPT_IGNORE),
    gnu.flag("l", "verbose", OPT_VERBOSE), gnu.valued("n", "bytes", OPT_BYTES), gnu.flag("s", "quiet", OPT_QUIET),
    gnu.flag("", "silent", OPT_QUIET), gnu.flag("v", "", gnu.version_id()),
  ];
  let skip: u64[] = [0 as u64, 0 as u64];
  let cfg = Cfg { print_bytes: false, verbose: false, quiet: false, limit: 18446744073709551615 as u64, skip: skip };
  let g = gnu.getopt_new(argv, opts, "cmp", help_text(), EXIT_TROUBLE).in_package("diffutils");
  while (true) {
    let r: (Option[gnu.OptMatch], gnu.Getopt) = g.next();
    g = r.1;
    let Some(m) = r.0 else {
      break;
    };
    cfg = apply(cfg, m);
  }
  if (cfg.verbose && cfg.quiet) {
    usage_error("options -l and -s are incompatible");
  }
  return (cfg, g.operands());
}

function apply(cfg: Cfg, m: gnu.OptMatch): Cfg {
  if (m.id == OPT_PRINT_BYTES || m.id == OPT_PRINT_CHARS) {
    return Cfg { ...cfg, print_bytes: true };
  }
  if (m.id == OPT_IGNORE) {
    return ignore_option(cfg, m.value);
  }
  if (m.id == OPT_VERBOSE) {
    return Cfg { ...cfg, verbose: true };
  }
  if (m.id == OPT_BYTES) {
    return bytes_option(cfg, m.value);
  }
  return Cfg { ...cfg, quiet: true };
}

// One input: its name, its reader, its buffered bytes and the read position.
struct Input { name: string, r: Reader, buf: u8[], pos: i32, eof: boolean }

function trouble(cfg: Cfg, msg: string): void {
  if (!cfg.quiet) {
    gnu.error(msg);
  }
  exit(EXIT_TROUBLE);
}

function open_input(cfg: Cfg, name: string): Input {
  let empty: u8[] = [];
  if (name == "-") {
    return Input { name: name, r: stdin(), buf: empty, pos: 0, eof: false };
  }
  match (open_reader(name)) {
    Ok(r) => {
      return Input { name: name, r: r, buf: empty, pos: 0, eof: false };
    },
    Err(e) => {
      trouble(cfg, name + ": " + gnu.io_error_text(e));
      return Input { name: name, r: stdin(), buf: empty, pos: 0, eof: true };
    }
  }
}

function fill(cfg: Cfg, inp: Input): Input {
  if (inp.eof || inp.pos < inp.buf.len()) {
    return inp;
  }
  match (inp.r.read_chunk_bytes(CHUNK)) {
    Ok(chunk) => {
      return Input { ...inp, buf: chunk, pos: 0, eof: chunk.len() == 0 };
    },
    Err(e) => {
      trouble(cfg, inp.name + ": " + gnu.io_error_text(e));
      return inp;
    }
  }
}

// skip_input drops the first `n` bytes: a seek on a regular file, else reads.
function skip_input(cfg: Cfg, inp: Input, n: u64, st: Option[FileStat]): Input {
  if (n == 0 as u64) {
    return inp;
  }
  if let Some(info) = st {
    if (info.is_file) {
      match (inp.r.seek(n as i64, 1)) {
        Ok(_) => {
          return inp;
        },
        Err(_) => {}
      }
    }
  }
  let left = n;
  let i = inp;
  while (left > 0 as u64) {
    i = fill(cfg, i);
    if (i.eof) {
      return i;
    }
    let have = (i.buf.len() - i.pos) as u64;
    let take = if (have < left) { have } else { left };
    i = Input { ...i, pos: i.pos + take as i32 };
    left -= take;
  }
  return i;
}

function input_stat(inp: Input): Option[FileStat] {
  return match (inp.r.stat()) {
    Ok(st) => Some(st),
    Err(_) => None,
  };
}

// The width of the byte numbers of -l: the digits of the largest offset that
// the comparison can reach.
function offset_width(cfg: Cfg, stats: Option[FileStat][]): i32 {
  let max = if (cfg.limit <= OFF_MAX) { cfg.limit as i64 } else { OFF_MAX as i64 };
  for f in 0..2 {
    if let Some(st) = stats[f] {
      if (st.is_file) {
        let left = st.size - cfg.skip[f] as i64;
        if (left < max) {
          max = left;
        }
      }
    }
  }
  let width = 1;
  while (max / (10 as i64) != 0 as i64) {
    max = max / (10 as i64);
    width += 1;
  }
  return width;
}

struct Run { inputs: Input[], at: u64, lines: u64, last: u8, differ: boolean, out: usize }

function run_output_flush(cfg: Cfg, run: Run, force: boolean): Run {
  if (!force && buf_len(run.out) < CHUNK) {
    return run;
  }
  let text = buf_take_bytes(run.out);
  if let Err(e) = stdout().write_bytes(text) {
    trouble(Cfg { ...cfg, quiet: false }, "standard output: " + gnu.io_error_text(e));
  }
  return run;
}

function visible(c: u8): string {
  let v = c as i32;
  let out = "";
  if (v >= 128) {
    out = "M-";
    v -= 128;
  }
  if (v < 32) {
    return out + "^" + char_text(v + 64);
  }
  if (v == 127) {
    return out + "^?";
  }
  return out + char_text(v);
}

function char_text(v: i32): string {
  return unsafe { string_from_bytes_unchecked([v as u8]) };
}

function octal3(c: u8): string {
  let v = c as i32;
  let s = "";
  while (v > 0) {
    s = char_text(48 + v % 8) + s;
    v /= 8;
  }
  if (s.len() == 0) {
    s = "0";
  }
  return " ".repeat(3 - s.len()) + s;
}

function pad_left(s: string, width: i32): string {
  if (s.len() >= width) {
    return s;
  }
  return " ".repeat(width - s.len()) + s;
}

function pad_right(s: string, width: i32): string {
  if (s.len() >= width) {
    return s;
  }
  return s + " ".repeat(width - s.len());
}

// report gives the first difference, at byte `at` of line `line`.
function report(cfg: Cfg, run: Run, a: u8, b: u8, at: u64, line: u64): void {
  if (cfg.quiet) {
    exit(EXIT_DIFFER);
  }
  let names = run.inputs[0].name + " " + run.inputs[1].name;
  let text = names + " differ: char " + f"{at}" + ", line " + f"{line}" + "\n";
  if (cfg.print_bytes) {
    text = names + " differ: byte " + f"{at}" + ", line " + f"{line}" + " is " + octal3(a) + " " + visible(a) + " " + octal3(b) + " " + visible(b) + "\n";
  }
  buf_push(run.out, text);
  run_output_flush(cfg, run, true);
  exit(EXIT_DIFFER);
}

function verbose_line(cfg: Cfg, run: Run, width: i32, a: u8, b: u8, at: u64): Run {
  let line = pad_left(f"{at}", width) + " " + octal3(a);
  if (cfg.print_bytes) {
    line = line + " " + pad_right(visible(a), 4) + " " + octal3(b) + " " + visible(b) + "\n";
  } else {
    line = line + " " + octal3(b) + "\n";
  }
  buf_push(run.out, line);
  return run_output_flush(cfg, run, false);
}

// The number of newlines in buf[lo..hi].
function newlines(buf: u8[], lo: i32, hi: i32): u64 {
  if (lo == 0 && hi == buf.len()) {
    return __count_byte_bytes(buf, 10) as u64;
  }
  let count = 0 as u64;
  let at = __memchr_bytes(buf, 10, lo);
  while (at >= 0 && at < hi) {
    count += 1 as u64;
    at = __memchr_bytes(buf, 10, at + 1);
  }
  return count;
}

// compare_span compares `n` bytes of the two buffers. It reports the first
// difference, or with -l lists each one.
function compare_span(cfg: Cfg, run: Run, width: i32, n: i32): Run {
  let a = run.inputs[0];
  let b = run.inputs[1];
  let done = 0;
  while (done < n) {
    let k = __mismatch_bytes(a.buf, a.pos + done, b.buf, b.pos + done, n - done);
    if (k >= n - done) {
      break;
    }
    let off = done + k;
    let ca = a.buf[a.pos + off];
    let cb = b.buf[b.pos + off];
    if (!cfg.verbose) {
      let lines = run.lines + newlines(a.buf, a.pos, a.pos + off);
      report(cfg, run, ca, cb, run.at + off as u64 + 1 as u64, lines + 1 as u64);
    }
    run = verbose_line(cfg, Run { ...run, differ: true }, width, ca, cb, run.at + off as u64 + 1 as u64);
    done = off + 1;
  }
  let lines = run.lines;
  if (!cfg.verbose) {
    lines += newlines(a.buf, a.pos, a.pos + n);
  }
  let last = if (n > 0) { a.buf[a.pos + n - 1] } else { run.last };
  let inputs: Input[] = [Input { ...a, pos: a.pos + n }, Input { ...b, pos: b.pos + n }];
  return Run { ...run, inputs: inputs, at: run.at + n as u64, lines: lines, last: last };
}

// at_eof reports the input that ended first. Both ending together is equal.
function at_eof(cfg: Cfg, run: Run): i32 {
  let a = run.inputs[0];
  let b = run.inputs[1];
  let status = if (run.differ) { EXIT_DIFFER } else { 0 };
  run_output_flush(cfg, run, true);
  buf_free(run.out);
  if (a.eof && b.eof) {
    return status;
  }
  if (!cfg.quiet) {
    let name = if (a.eof) { a.name } else { b.name };
    if (run.at == 0 as u64) {
      gnu.error("EOF on " + name + " which is empty");
    } else if (cfg.verbose) {
      gnu.error("EOF on " + name + " after byte " + f"{run.at}");
    } else if (run.last == b'\n') {
      gnu.error("EOF on " + name + " after byte " + f"{run.at}" + ", line " + f"{run.lines}");
    } else {
      gnu.error("EOF on " + name + " after byte " + f"{run.at}" + ", in line " + f"{run.lines + 1 as u64}");
    }
  }
  return EXIT_DIFFER;
}

function compare(cfg: Cfg, inputs: Input[], width: i32): i32 {
  let run = Run { inputs: inputs, at: 0 as u64, lines: 0 as u64, last: 0 as u8, differ: false, out: buf_new(CHUNK) };
  while (run.at < cfg.limit) {
    let a = fill(cfg, run.inputs[0]);
    let b = fill(cfg, run.inputs[1]);
    run = Run { ...run, inputs: [a, b] };
    if (a.eof || b.eof) {
      return at_eof(cfg, run);
    }
    let n = a.buf.len() - a.pos;
    if (b.buf.len() - b.pos < n) {
      n = b.buf.len() - b.pos;
    }
    let left = cfg.limit - run.at;
    if (left < n as u64) {
      n = left as i32;
    }
    run = compare_span(cfg, run, width, n);
  }
  run_output_flush(cfg, run, true);
  buf_free(run.out);
  return if (run.differ) { EXIT_DIFFER } else { 0 };
}

function same_file(s0: Option[FileStat], s1: Option[FileStat]): boolean {
  let Some(a) = s0 else {
    return false;
  };
  let Some(b) = s1 else {
    return false;
  };
  return a.dev == b.dev && a.ino == b.ino;
}

function main(): i32 {
  let argv = args();
  let parsed = parse(argv);
  let cfg = parsed.0;
  let ops = parsed.1;
  if (ops.len() == 0) {
    usage_error("missing operand after '" + argv[argv.len() - 1] + "'");
  }
  let names: string[] = [ops[0], if (ops.len() > 1) { ops[1] } else { "-" }];
  for k in 2..ops.len() {
    if (k >= 4) {
      usage_error("extra operand '" + ops[k] + "'");
    }
    cfg = specify_skip(cfg, k - 2, ops[k], 0, 0 as u8).0;
  }
  let inputs: Input[] = [open_input(cfg, names[0]), open_input(cfg, names[1])];
  let stats: Option[FileStat][] = [input_stat(inputs[0]), input_stat(inputs[1])];
  if (same_file(stats[0], stats[1]) && cfg.skip[0] == cfg.skip[1]) {
    return 0;
  }
  let width = if (cfg.verbose) { offset_width(cfg, stats) } else { 1 };
  inputs = [skip_input(cfg, inputs[0], cfg.skip[0], stats[0]), skip_input(cfg, inputs[1], cfg.skip[1], stats[1])];
  return compare(cfg, inputs, width);
}
