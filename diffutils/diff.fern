const EXIT_DIFFER: i32 = 1;

const EXIT_TROUBLE: i32 = 2;

const STYLE_NONE: i32 = 0;

const STYLE_NORMAL: i32 = 1;

const STYLE_CONTEXT: i32 = 2;

const STYLE_UNIFIED: i32 = 3;

const STYLE_ED: i32 = 4;

const STYLE_FORWARD_ED: i32 = 5;

const STYLE_RCS: i32 = 6;

const STYLE_IFDEF: i32 = 7;

const STYLE_SDIFF: i32 = 8;

const WS_NONE: i32 = 0;

const WS_TAB: i32 = 1;

const WS_TRAILING: i32 = 2;

const WS_CHANGE: i32 = 4;

const WS_ALL: i32 = 5;

const OPT_NORMAL: i32 = 1;

const OPT_BRIEF: i32 = 2;

const OPT_IDENTICAL: i32 = 3;

const OPT_C: i32 = 4;

const OPT_CONTEXT: i32 = 5;

const OPT_U: i32 = 6;

const OPT_UNIFIED: i32 = 7;

const OPT_LABEL: i32 = 8;

const OPT_RECURSIVE: i32 = 9;

const OPT_NEW_FILE: i32 = 10;

const OPT_UNIDIRECTIONAL: i32 = 11;

const OPT_IGNORE_CASE: i32 = 12;

const OPT_SPACE_CHANGE: i32 = 13;

const OPT_ALL_SPACE: i32 = 14;

const OPT_BLANK_LINES: i32 = 15;

const OPT_TEXT: i32 = 16;

const OPT_MINIMAL: i32 = 17;

const OPT_HORIZON: i32 = 18;

const OPT_SPEED: i32 = 19;

const OPT_NO_EFFECT: i32 = 20;

const OPT_ED: i32 = 30;

const OPT_FORWARD_ED: i32 = 31;

const OPT_RCS: i32 = 32;

const OPT_SIDE_BY_SIDE: i32 = 33;

const OPT_WIDTH: i32 = 34;

const OPT_LEFT_COLUMN: i32 = 35;

const OPT_SUPPRESS_COMMON: i32 = 36;

const OPT_IFDEF: i32 = 37;

// The group formats are OPT_GROUP_FORMAT + a group kind, and the line formats
// OPT_LINE_FORMAT + a line kind. OPT_LINE_FORMAT + 3 sets all three.
const OPT_GROUP_FORMAT: i32 = 40;

const OPT_LINE_FORMAT: i32 = 44;

const OPT_SHOW_C_FUNCTION: i32 = 48;

const OPT_SHOW_FUNCTION: i32 = 49;

const OPT_EXPAND_TABS: i32 = 50;

const OPT_INITIAL_TAB: i32 = 51;

const OPT_TABSIZE: i32 = 52;

