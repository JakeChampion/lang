{
  "name": "fern-vscode",
  "displayName": "Fern",
  "description": "Language Server + syntax highlighting for the Fern language.",
  "version": "0.1.0",
  "publisher": "jakechampion",
  "engines": {
    "vscode": "^1.86.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JakeChampion/lang.git",
    "directory": "editors/vscode"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:fern"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fern",
        "aliases": [
          "Fern"
        ],
        "extensions": [
          ".fern"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fern",
        "scopeName": "source.fern",
        "path": "./syntaxes/fern.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Fern",
      "properties": {
        "fern.serverPath": {
          "type": "string",
          "default": "fern-lsp",
          "description": "Path to the fern-lsp binary. Resolved against $PATH when unqualified."
        },
        "fern.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP traffic between the extension and fern-lsp."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.86.0",
    "typescript": "^5.4.0"
  }
}
