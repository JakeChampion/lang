{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "fern",
  "scopeName": "source.fern",
  "fileTypes": ["fern"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fern",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fern",
          "begin": "f?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fern",
              "match": "\\\\(?:u\\{[0-9a-fA-F]{1,6}\\}|x[0-9a-fA-F]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.fern",
          "match": "b?'(?:\\\\u\\{[0-9a-fA-F]{1,6}\\}|\\\\x[0-9a-fA-F]{2}|\\\\.|[^'\\\\])'"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fern",
          "match": "\\b(if|else|while|for|loop|break|continue|return|match|when|default|defer|errdefer)\\b"
        },
        {
          "name": "storage.type.fern",
          "match": "\\b(function|struct|enum|type|trait|impl|dyn|const|import|pub|let|use|as)\\b"
        },
        {
          "name": "storage.modifier.fern",
          "match": "\\b(fip|fbip|async)\\b(?=(?:\\s+(?:fip|fbip|async))*\\s+function\\b)"
        },
        {
          "name": "constant.language.fern",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.fern",
          "match": "\\b(i32|i64|u8|u32|u64|usize|f32|f64|boolean|void|string)\\b"
        },
        {
          "name": "entity.name.type.fern",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fern",
          "match": "\\b(0[xX][0-9a-fA-F](_?[0-9a-fA-F])*|0[oO][0-7](_?[0-7])*|0[bB][01](_?[01])*|[0-9](_?[0-9])*(\\.[0-9](_?[0-9])*)?([eE][+-]?[0-9](_?[0-9])*)?)(i32|i64|u8|u32|u64|usize|f32|f64)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fern",
          "match": "(==|!=|<=|>=|<<=|>>=|<<\\?|>>\\?|&&|\\|\\||<<|>>|\\|>|=>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\+\\||-\\||\\*\\||\\+\\?|-\\?|\\*\\?|/\\?|%\\?|[+\\-*/%&|^!<>=])"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.fern",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
