{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "lang",
  "scopeName": "source.lang",
  "fileTypes": ["lang"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lang",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lang",
          "begin": "f?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lang",
          "match": "\\b(if|else|while|for|break|continue|return|match|when|switch|case|default|defer|arena)\\b"
        },
        {
          "name": "storage.type.lang",
          "match": "\\b(function|struct|enum|type|const|import|pub|var|let|use|as)\\b"
        },
        {
          "name": "constant.language.lang",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.lang",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|usize|f32|f64|boolean|void|string)\\b"
        },
        {
          "name": "entity.name.type.lang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lang",
          "match": "\\b[0-9]+(\\.[0-9]+)?(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lang",
          "match": "(==|!=|<=|>=|<<=|>>=|&&|\\|\\||<<|>>|\\|>|=>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[+\\-*/%&|^!<>=])"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.lang",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
