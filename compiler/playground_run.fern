import "./asm_arm64_ir";
import "./asm_ir";
import "./asmcore";
import "./checker";
import "./constfold";
import "./emitforms";
import "./fern";
import "./flatten";
import "./interp";
import "./ircore";
import "./lexer";
import "./modloader";
import "./parser";
import "./platforms";
import "./semarrayreport";
import "./semlower";
import "./treeshake";
import "./util";
import "./wasm_ir";
import "./watbin";
import "./wit_compose";
import "std/io";

function main(): i32 {
  return util.rc_underflow_guard("playground_run", run());
}

function embedded_stdlib(): modloader.Overlay {
  return modloader.embedded_sources(__fern_assets(), true);
}

function embedded_stdlib_files(root: string): modloader.Buffers {
  let b: modloader.Buffers = modloader.no_buffers();
  for a in __fern_assets() {
    b = modloader.Buffers { paths: b.paths.append(root + "/" + a.0), srcs: b.srcs.append(a.1 + "") };
  }
  return b;
}

const LSP_FLAG: string = "-lsp";

const LSP_STDLIB_ROOT: string = "/stdlib";

const CHECK_FLAG: string = "-check";

const INTERP_FLAG: string = "-interp";

const TARGET_FLAG: string = "-target";

const EMIT_FLAG: string = "-emit";

function report_diags(diags: util.Diag[], files: string[]): boolean {
  for d in util.sorted_by(diags, util.diag_after) {
    let tag: string = "";
    if (d.code.len() > 0) {
      tag = "error[" + d.code + "]: ";
    }
    if (d.line > 0) {
      eprint(util.pos_str("", files, d.line, d.col) + ": " + tag + d.message);
    } else {
      eprint(tag + d.message);
    }
  }
  return diags.len() > 0;
}

function check(merged: parser.Module, files: string[], target: string, target_given: boolean): i32 {
  if (report_diags(asmcore.parse_errors_before_check(merged), files)) {
    return 1;
  }
  let diags: util.Diag[] = checker.check_module(merged).diags;
  if (target_given) {
    diags = util.append_diags(diags, fern.capability_diags(merged, target));
  }
  if (report_diags(util.append_diags(diags, fern.ambient_diags(merged)), files)) {
    return 1;
  }
  return 0;
}

function interpret(merged: parser.Module): i32 {
  let v: interp.Value = interp.eval_module(merged);
  let (is_status, status) = interp.exit_status(v);
  if (is_status) {
    return status;
  }
  match (v) {
    interp.VErr(e) => {
      if (e.abort) {
        eprint(e.msg);
        return 134;
      }
      eprint("fern: interp: " + e.msg);
      return 254;
    },
    _ => {
      return 254;
    }
  }
}

struct Argv { check: boolean, interp: boolean, lsp: boolean, target: string, target_given: boolean, form: string }

function parse_argv(av: string[]): Argv {
  let o: Argv = Argv { check: false, interp: false, lsp: false, target: "wasm32-wasi", target_given: false, form: "" };
  let ai: i32 = 0;
  while (ai < av.len()) {
    let a: string = av[ai];
    if (a == CHECK_FLAG) {
      o = Argv { ...o, check: true };
    }
    if (a == INTERP_FLAG) {
      o = Argv { ...o, interp: true };
    }
    if (a == LSP_FLAG) {
      o = Argv { ...o, lsp: true };
    }
    if ((a == TARGET_FLAG || a == EMIT_FLAG) && ai + 1 < av.len()) {
      if (a == TARGET_FLAG) {
        o = Argv { ...o, target: av[ai + 1], target_given: true };
      } else {
        o = Argv { ...o, form: av[ai + 1] };
      }
      ai = ai + 1;
    }
    ai = ai + 1;
  }
  return o;
}

function run(): i32 {
  let o: Argv = parse_argv(args());
  let target: string = o.target;
  let bad_target: string = fern.target_refusal(target);
  if (bad_target.len() > 0) {
    eprint(bad_target);
    return 2;
  }
  if (o.lsp) {
    return fern.serve_lsp_in_memory(LSP_STDLIB_ROOT, embedded_stdlib_files(LSP_STDLIB_ROOT), target, o.target_given);
  }
  let bad_emit: string = fern.emit_refusal(target, o.form);
  if (bad_emit.len() > 0) {
    eprint(bad_emit);
    return 2;
  }
  let form: string = fern.core_form(o.form);
  if (form.len() == 0 && platforms.for_target(target).isa != "wasm32") {
    form = "asm";
  }
  let src: string = "";
  match (io.read_all_stdin()) {
    Ok(text) => {
      src = text;
    },
    Err(_) => {
      eprint("fern: cannot read UTF-8 stdin");
      return 1;
    }
  }
  let entry: parser.Module = parser.parse_module(lexer.tokenize(emitforms.entry_source(src, target)));
  let handle: util.Diag = emitforms.http_entry_refused(entry, target);
  if (handle.message.len() > 0) {
    if (handle.line > 0) {
      eprint(util.pos_str("stdin", [], handle.line, handle.col) + ": error[" + handle.code + "]: " + handle.message);
    } else {
      eprint(handle.message);
    }
    return 1;
  }

  let ov: modloader.Overlay = embedded_stdlib();
  let g: modloader.Graph = modloader.load_graph(ov, "stdin", entry, "");
  entry = g.entry;
  let loaded: flatten.LoadedModule[] = g.loaded;
  let files: string[] = g.files;
  let missing: string[] = g.missing;
  if (modloader.report_unresolved(missing, "playground")) {
    return 1;
  }

  let merged: parser.Module = flatten.bundle(entry, loaded, target);
  merged = parser.fill_default_args_module(merged);
  merged = parser.resolve_variant_fields_module(merged);

  if (o.check) {
    return check(merged, files, target, o.target_given);
  }
  if (o.interp) {
    let checked: i32 = check(merged, files, target, false);
    if (checked != 0) {
      return checked;
    }
    return interpret(merged);
  }
  return emit(merged, files, target, form);
}

function emit(merged: parser.Module, files: string[], target: string, form: string): i32 {
  if (report_diags(asmcore.parse_errors(merged), files)) {
    return 1;
  }
  if (report_diags(checker.build_gate_diags(merged), files)) {
    return 1;
  }
  let errs: util.Diag[] = asmcore.check_call_arity(parser.fill_default_args_module(merged));
  errs = util.append_diags(errs, asmcore.check_map_new_chain(merged));
  errs = util.append_diags(errs, asmcore.check_undefined_calls(merged));
  if (report_diags(errs, files)) {
    return 1;
  }
  let desc: platforms.Descriptor = platforms.for_target(target);
  merged = constfold.fold_target_name(merged, desc.environment, desc.isa);
  merged = constfold.prune_literal_branches(merged);
  if (report_diags(fern.capability_diags(merged, target), files)) {
    return 1;
  }
  if (report_diags(fern.ambient_diags(merged), files)) {
    return 1;
  }
  merged = constfold.fold_module(merged);
  merged = checker.annotate_module(merged);
  merged = treeshake.treeshake(merged);
  let no_backend: string = fern.backend_refusal(target);
  if (no_backend.len() > 0) {
    eprint(no_backend);
    return 2;
  }

  let typed: parser.Module = parser.module_with_builtins_typed(merged);
  let full: parser.Module = parser.erase_view_module(typed);
  let sub: ircore.Sub = semlower.target_substitution(typed, target, semlower.build_opts(false, false, true, semarrayreport.off()));
  if (report_diags(sub.refused, files)) {
    return 1;
  }
  let out: string = "";
  if (target == "x86-64-linux") {
    out = asm_ir.emit_module_or_error_sub(full, sub, 0 as usize);
  } else if (target == "arm64-linux" || target == "arm64-android") {
    out = asm_arm64_ir.emit_module_or_error_sub(full, false, sub, 0 as usize);
  } else if (target == "arm64-darwin") {
    out = asm_arm64_ir.darwinize(asm_arm64_ir.emit_module_or_error_sub(full, true, sub, 0 as usize));
  } else if (target == "wasm32-wasi-http") {
    if (form == "asm") {
      out = emitforms.wasm_http_core(full, sub);
    } else if (form == "core-module") {
      let hwat: string = emitforms.wasm_http_core(full, sub);
      if (hwat.len() == 0) {
        return 2;
      }
      out = string_from_bytes_unchecked(util.to_u8(watbin.wat_to_binary(hwat)));
    } else {
      let hc: wit_compose.Composed = emitforms.wasm_http_component(full, sub);
      if (hc.bytes.len() == 0) {
        if (hc.refused.len() > 0) {
          eprint(emitforms.http_refused(hc.refused));
        }
        return 2;
      }
      out = string_from_bytes_unchecked(util.to_u8(hc.bytes));
    }
  } else if (form == "asm") {
    out = wasm_ir.emit_module_mode_or_error_sub(full, false, false, sub);
  } else if (form == "core-module") {
    out = string_from_bytes_unchecked(util.to_u8(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error_sub(full, false, false, sub))));
  } else {
    let comp: wit_compose.Composed = emitforms.wasm_component(full, sub);
    if (comp.bytes.len() == 0) {
      if (comp.refused.len() > 0) {
        eprint(comp.refused);
      }
      return 2;
    }
    out = string_from_bytes_unchecked(util.to_u8(comp.bytes));
  }
  if (out.len() == 0) {
    return 2;
  }
  write(out);
  return 0;
}
