// compiler/playground_run.fern — the compiler as a service: source
// on stdin, a wasm module on stdout, and no filesystem underneath (#6643).
//
// This is the driver the browser playground needs and `fern.fern` is not.
// `fern.fern` is a CLI — it takes argv paths, reads them, and writes an
// executable — while a playground has one program in memory and nowhere to put
// a file. `wasm_ir_run.fern` has the right SHAPE (stdin in, module out) and
// resolves nothing: it warns about every import and carries on.
//
// What makes the difference is where `std/…` comes from. Native serves the
// stdlib out of `go:embed`; the self-host CLI reads it from a root named on the
// command line, which a wasm-hosted compiler does not have. So this driver
// carries the stdlib as `-embed` assets and hands them to the module loader as
// an overlay, consulted ahead of disk:
//
//     fern -target wasm32-wasi -emit core-module -embed internal/stdlib \
//         -o playground.wasm compiler/playground_run.fern internal/stdlib
//
// `internal/stdlib` appears twice and means two different things. As `-embed`
// it is the stdlib this driver will carry AT RUNTIME. As the trailing
// positional it is the stdlib root resolving THIS FILE's own `import "std/io"`
// at build time. Dropping either one produces a driver that builds and then
// cannot resolve, or one that cannot build at all.
//
// The overlay is sealed, so a miss is an error rather than a disk read. That is
// the property that makes this safe to run against untrusted source: there is
// no path from an import to the host filesystem, and `read_file` on a wasm
// module with no preopens would fail anyway — sealed makes it fail with a
// diagnostic naming the import instead of a silently-skipped module.

import "./asm_arm64_ir";
import "./asm_ir";
import "./asmcore";
import "./checker";
import "./constfold";
import "./emitforms";
import "./fern";
import "./flatten";
import "./interp";
import "./ircore";
import "./lexer";
import "./modloader";
import "./parser";
import "./platforms";
import "./semlower";
import "./treeshake";
import "./util";
import "./wasm_ir";
import "./watbin";
import "./wit_compose";
import "std/io";

// main wraps `run` in the shared rc-over-release guard — see
// util.rc_underflow_guard. Every self-host driver run self-checks its own heap
// accounting; a corrupted freelist is otherwise silent (#6021).
function main(): i32 {
  return util.rc_underflow_guard("playground_run", run());
}

// STDLIB_EXT is the suffix an embedded module name carries and an import path
// does not.
const STDLIB_EXT: string = ".fern";

// embedded_stdlib turns the `-embed` bundle into the module loader's overlay.
//
// Asset names arrive as paths relative to the embed root with the extension
// intact — `std/io.fern` — and imports are written `std/io`, so the extension
// comes off and nothing else is rewritten. That is exact rather than
// approximate because no module under `internal/stdlib` imports a sibling
// relatively: every one of them spells it package-root-relative (`import
// "std/string"`, `import "core/int"`), which is the same key the overlay is
// built with.
//
// Non-`.fern` assets are skipped. They are not modules, and an embed root can
// legitimately hold other things.
function embedded_stdlib(): modloader.Overlay {
  let paths: string[] = [];
  let srcs: string[] = [];
  for a in __fern_assets() {
    let name: string = a.0;
    if (name.len() > STDLIB_EXT.len()
      && slice_unchecked(name, name.len() - STDLIB_EXT.len(), name.len()) == STDLIB_EXT) {
      paths = paths.append(slice_unchecked(name, 0, name.len() - STDLIB_EXT.len()) + "");
      srcs = srcs.append(a.1 + "");
    }
  }
  return modloader.Overlay { paths: paths, srcs: srcs, sealed: true, files: modloader.no_buffers() };
}

// embedded_stdlib_files is the `-embed` bundle as the files of a stdlib root
// at `root`, which is how the language server reads it.
function embedded_stdlib_files(root: string): modloader.Buffers {
  let b: modloader.Buffers = modloader.no_buffers();
  for a in __fern_assets() {
    b = modloader.Buffers { paths: b.paths.append(root + "/" + a.0), srcs: b.srcs.append(a.1 + "") };
  }
  return b;
}

// LSP_FLAG runs `fern -lsp`'s language server on stdin and stdout. A browser
// host feeds stdin as one buffer, so a page replays a whole session — open
// the document, ask, shut down — per question it has.
const LSP_FLAG: string = "-lsp";

// LSP_STDLIB_ROOT is where the language server's stdlib lives: a directory no
// host has, so a path under it is only ever an embedded file.
const LSP_STDLIB_ROOT: string = "/stdlib";

// CHECK_FLAG selects the diagnostics-only mode. A playground wants the errors
// as the user types, long before anything is worth compiling, and running the
// whole emit path to get them means paying for a module nobody will run.
const CHECK_FLAG: string = "-check";

// INTERP_FLAG selects the evaluator. The playground's output pane needs a
// program's OUTPUT, which compiling to wasm does not give the page directly —
// and interp_run.fern cannot serve it, because it has no module loader: a
// program that prints a number imports std/i32 for `to_string`, and that
// import is exactly what interp_run drops. The overlay this driver already
// carries is the answer, so interpret lives here.
const INTERP_FLAG: string = "-interp";

// TARGET_FLAG names the machine, as the CLI's `-target` does, from the same
// platforms table: `wasm32-wasi` is the default. A freestanding target is
// check-only here as it is there.
const TARGET_FLAG: string = "-target";

// EMIT_FLAG selects the output form with the CLI's vocabulary (fern.emit_refusal).
// The default is what the CLI writes for the target: a wasm target's component,
// and a native target's assembly text, since stdout is where the CLI puts it
// and nothing links here. `asm` is the emitter's text (WAT on wasm), and
// `core-module` (or `command-module` on wasm32-wasi) the core module a
// preview-1 host runs.
const EMIT_FLAG: string = "-emit";

// report_diags prints `line:col: error[E0XX]: message` for each diagnostic,
// with the module's path ahead of it for an imported module (util.pos_str), and
// reports whether any were printed. An empty code renders without the
// `error[…]` segment — some diagnostics are uncoded, and parity is on the text
// native actually prints — and a zero line drops the position prefix, which the
// checker still leaves on some paths.
function report_diags(diags: util.Diag[], files: string[]): boolean {
  for d in diags {
    let tag: string = "";
    if (d.code.len() > 0) {
      tag = "error[" + d.code + "]: ";
    }
    if (d.line > 0) {
      eprint(util.pos_str("", files, d.line, d.col) + ": " + tag + d.message);
    } else {
      eprint(tag + d.message);
    }
  }
  return diags.len() > 0;
}

// check reports type errors and emits nothing. The parser's sentinels are
// reported first, then the declaration gate, each alone: the permissive parser
// leaves an empty name where a keyword was written and then parses the body as
// top-level statements, so the checker downstream of it reports a cascade that
// all points away from the cause.
//
// The verdict is the DIAGNOSTICS, not ModuleTypes.all_well_typed. While the
// checker port is partial (#9053) that flag goes false for a program it merely
// cannot model — measured on `import "std/string"; function main(): i32 {
// return 12; }`, which yields all_well_typed = false and an empty diag list.
// Gating on it would fail almost every program that touches the stdlib, with
// nothing printed to act on. Reporting what the checker can actually name means
// this under-reports where the port is incomplete rather than rejecting valid
// programs, which is the right side to err on for an editor-facing check.
//
// With a `-target`, the CLI's target gate (E066) reports beside the checker,
// and the handler gate (E080) always does, as `fern -check` reports them.
function check(merged: parser.Module, files: string[], target: string, target_given: boolean): i32 {
  if (report_diags(asmcore.parse_unknown_errors_module(merged), files)) {
    return 1;
  }
  if (report_diags(asmcore.check_decl_names(merged), files)) {
    return 1;
  }
  let diags: util.Diag[] = checker.check_module(merged).diags;
  if (target_given) {
    diags = util.append_diags(diags, fern.capability_diags(merged, target));
  }
  if (report_diags(util.append_diags(diags, fern.ambient_diags(merged)), files)) {
    return 1;
  }
  return 0;
}

// interpret evaluates the bundle and reports the program's own exit code, the
// same mapping fern.fern uses: an i32 result is the code, a boolean is 1/0,
// the program's own abort (an index out of range) is 1 with its message, and
// anything else is 254, which is outside the range a Fern `main` can
// return and so cannot be confused with one. The evaluator's own error says
// why it stopped, on stderr, where the page shows it: a silent 254 is an
// empty output pane.
//
// The program's output has already gone to stdout/stderr by the time this
// returns: interp.eval_module runs the builtins as it goes.
function interpret(merged: parser.Module): i32 {
  match (interp.eval_module(merged)) {
    interp.VInt(i) => {
      return i.v;
    },
    interp.VBool(b) => {
      if (b.v) {
        return 1;
      }
      return 0;
    },
    interp.VErr(e) => {
      if (e.abort) {
        eprint(e.msg);
        return 1;
      }
      eprint("fern: interp: " + e.msg);
      return 254;
    },
    _ => {
      return 254;
    }
  }
}

// Argv is the driver's mode, read from its arguments: which of `-check`,
// `-interp` and `-lsp` was given, the `-target` and whether one was named, and
// the `-emit` form ("" when none was).
struct Argv { check: boolean, interp: boolean, lsp: boolean, target: string, target_given: boolean, form: string }

function parse_argv(av: string[]): Argv {
  let o: Argv = Argv { check: false, interp: false, lsp: false, target: "wasm32-wasi", target_given: false, form: "" };
  let ai: i32 = 0;
  while (ai < av.len()) {
    let a: string = av[ai];
    if (a == CHECK_FLAG) {
      o = Argv { ...o, check: true };
    }
    if (a == INTERP_FLAG) {
      o = Argv { ...o, interp: true };
    }
    if (a == LSP_FLAG) {
      o = Argv { ...o, lsp: true };
    }
    if ((a == TARGET_FLAG || a == EMIT_FLAG) && ai + 1 < av.len()) {
      if (a == TARGET_FLAG) {
        o = Argv { ...o, target: av[ai + 1], target_given: true };
      } else {
        o = Argv { ...o, form: av[ai + 1] };
      }
      ai = ai + 1;
    }
    ai = ai + 1;
  }
  return o;
}

function run(): i32 {
  let o: Argv = parse_argv(args());
  let target: string = o.target;
  let bad_target: string = fern.target_refusal(target);
  if (bad_target.len() > 0) {
    eprint(bad_target);
    return 2;
  }
  if (o.lsp) {
    return fern.serve_lsp_in_memory(LSP_STDLIB_ROOT, embedded_stdlib_files(LSP_STDLIB_ROOT), target, o.target_given);
  }
  let bad_emit: string = fern.emit_refusal(target, o.form);
  if (bad_emit.len() > 0) {
    eprint(bad_emit);
    return 2;
  }
  let form: string = fern.core_form(o.form);
  if (form.len() == 0 && platforms.for_target(target).isa != "wasm32") {
    form = "asm";
  }
  let src: string = "";
  match (io.read_all_stdin()) {
    Ok(text) => {
      src = text;
    },
    Err(_) => {
      eprint("fern: cannot read UTF-8 stdin");
      return 1;
    }
  }
  let entry: parser.Module = parser.parse_module(lexer.tokenize(emitforms.entry_source(src, target)));
  let missing_handle: string = emitforms.http_entry_refused(entry, target, "stdin");
  if (missing_handle.len() > 0) {
    eprint(missing_handle);
    return 1;
  }

  // The entry came from stdin, so it is named `stdin` and has no directory.
  // With a sealed overlay that is inert: nothing below resolve_module ever sees
  // the empty root.
  let ov: modloader.Overlay = embedded_stdlib();
  let g: modloader.Graph = modloader.load_graph(ov, "stdin", entry, "");
  entry = g.entry;
  let loaded: flatten.LoadedModule[] = g.loaded;
  let files: string[] = g.files;
  let missing: string[] = g.missing;
  if (modloader.report_unresolved(missing, "playground")) {
    return 1;
  }

  let merged: parser.Module = flatten.bundle(entry, loaded, target);
  merged = parser.fill_default_args_module(merged);
  merged = parser.resolve_variant_fields_module(merged);

  if (o.check) {
    return check(merged, files, target, o.target_given);
  }
  // Ahead of the emit gates below: those reject shapes the wasm EMITTER
  // would miscompile, and the evaluator does not emit. A program the
  // interpreter can run is worth running even where the backend would
  // decline it. It is checked first, as `fern -interp` is, so a type error
  // reads as a diagnostic rather than an evaluator failure mid-run.
  if (o.interp) {
    let checked: i32 = check(merged, files, target, false);
    if (checked != 0) {
      return checked;
    }
    return interpret(merged);
  }
  return emit(merged, files, target, form);
}

// emit writes the program in `form`: "asm" for the emitter's text,
// "core-module" for a wasm core module, and "" for a wasm target's component.
// The pipeline is the CLI's, so the bytes are the ones `fern -target <t>`
// writes for the same program.
function emit(merged: parser.Module, files: string[], target: string, form: string): i32 {
  // The same gates wasm_ir_run puts ahead of emit: each rejects a shape the
  // emitter would otherwise miscompile rather than refuse.
  if (report_diags(asmcore.parse_unknown_errors_module(merged), files)) {
    return 1;
  }
  let errs: util.Diag[] = asmcore.check_call_arity(parser.fill_default_args_module(merged));
  errs = util.append_diags(errs, asmcore.check_map_new_chain(merged));
  errs = util.append_diags(errs, asmcore.check_undefined_calls(merged));
  errs = util.append_diags(errs, asmcore.check_decl_names(merged));
  if (errs.len() > 0) {
    eprint(util.format_diags_in(errs, files));
    return 1;
  }
  // The target's name folded and its untaken branches pruned, then the
  // target gate (E066) and the handler gate (E080), all where the CLI runs
  // them, so the browser refuses what `fern -target <t>` refuses.
  let desc: platforms.Descriptor = platforms.for_target(target);
  merged = constfold.fold_target_name(merged, desc.environment, desc.isa);
  merged = constfold.prune_literal_branches(merged);
  if (report_diags(fern.capability_diags(merged, target), files)) {
    return 1;
  }
  if (report_diags(fern.ambient_diags(merged), files)) {
    return 1;
  }
  // Tree-shaking is required here rather than an optimisation: the
  // overlay hands the loader every stdlib module the program's imports reach,
  // and without the shake the emitted module carries all of them. It runs on
  // the annotated module, as in fern.fern: the checker's Display rewrite
  // (`print(q)` to `q.to_string()`, docs/TRAITS.md §3a) is what roots the
  // method the shake would otherwise drop.
  merged = constfold.fold_module(merged);
  merged = checker.annotate_module(merged);
  merged = treeshake.treeshake(merged);
  let no_backend: string = fern.backend_refusal(target);
  if (no_backend.len() > 0) {
    eprint(no_backend);
    return 2;
  }

  let typed: parser.Module = parser.module_with_builtins_typed(merged);
  let full: parser.Module = parser.erase_view_module(typed);
  let sub: ircore.Sub = semlower.target_substitution(typed, target, semlower.build_opts(false, false, true));
  let out: string = "";
  if (target == "x86-64-linux") {
    out = asm_ir.emit_module_or_error_sub(full, sub, 0 as usize);
  } else if (target == "arm64-linux" || target == "arm64-android") {
    out = asm_arm64_ir.emit_module_or_error_sub(full, false, sub, 0 as usize);
  } else if (target == "arm64-darwin") {
    out = asm_arm64_ir.darwinize(asm_arm64_ir.emit_module_or_error_sub(full, true, sub, 0 as usize));
  } else if (target == "wasm32-wasi-http") {
    if (form == "asm") {
      out = emitforms.wasm_http_core(full, sub);
    } else if (form == "core-module") {
      let hwat: string = emitforms.wasm_http_core(full, sub);
      if (hwat.len() == 0) {
        return 2;
      }
      out = string_from_bytes_unchecked(util.to_u8(watbin.wat_to_binary(hwat)));
    } else {
      let hc: wit_compose.Composed = emitforms.wasm_http_component(full, sub);
      if (hc.bytes.len() == 0) {
        if (hc.refused.len() > 0) {
          eprint(emitforms.http_refused(hc.refused));
        }
        return 2;
      }
      out = string_from_bytes_unchecked(util.to_u8(hc.bytes));
    }
  } else if (form == "asm") {
    out = wasm_ir.emit_module_mode_or_error_sub(full, false, false, sub);
  } else if (form == "core-module") {
    out = string_from_bytes_unchecked(util.to_u8(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error_sub(full, false, false, sub))));
  } else {
    let comp: wit_compose.Composed = emitforms.wasm_component(full, sub);
    if (comp.bytes.len() == 0) {
      if (comp.refused.len() > 0) {
        eprint(comp.refused);
      }
      return 2;
    }
    out = string_from_bytes_unchecked(util.to_u8(comp.bytes));
  }
  if (out.len() == 0) {
    return 2;
  }
  write(out);
  return 0;
}
