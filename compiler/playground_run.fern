import "./asm_arm64_ir";
import "./asm_ir";
import "./asmcore";
import "./checker";
import "./constfold";
import "./emitforms";
import "./fern";
import "./flatten";
import "./interp";
import "./ircore";
import "./lexer";
import "./modloader";
import "./parser";
import "./platforms";
import "./semarrayreport";
import "./semlower";
import "./treeshake";
import "./util";
import "./wasm_ir";
import "./watbin";
import "./wit_compose";
import "std/i32";
import "std/io";
import "std/utf8";

function main(): i32 {
  return util.rc_underflow_guard("playground_run", run());
}

function embedded_stdlib(): modloader.Overlay {
  return modloader.embedded_sources(__fern_assets(), true);
}

function embedded_stdlib_files(root: string): modloader.Buffers {
  let b = modloader.no_buffers();
  for a in __fern_assets() {
    b = modloader.Buffers { paths: b.paths.append(root + "/" + a.0), srcs: b.srcs.append(a.1 + "") };
  }
  return b;
}

const LSP_FLAG: string = "-lsp";

const LSP_STDLIB_ROOT: string = "/stdlib";

const CHECK_FLAG: string = "-check";

const INTERP_FLAG: string = "-interp";

const TARGET_FLAG: string = "-target";

const EMIT_FLAG: string = "-emit";

// The program source is the first N bytes of stdin, and the rest of stdin is the program's own input.
const SOURCE_BYTES_FLAG: string = "-source-bytes";

// The interpreted program's argv[0]. The arguments after `--` follow it.
const PROGRAM_NAME: string = "main";

function report_diags(diags: util.Diag[], files: string[]): boolean {
  for d in util.sorted_by(diags, util.diag_after) {
    let tag = "";
    if (d.code.len() > 0) {
      tag = "error[" + d.code + "]: ";
    }
    if (d.line > 0) {
      eprint(util.pos_str("", files, d.line, d.col) + ": " + tag + d.message);
    } else {
      eprint(tag + d.message);
    }
  }
  return diags.len() > 0;
}

function check(merged: parser.Module, files: string[], target: string, target_given: boolean): i32 {
  if (report_diags(asmcore.parse_errors_before_check(merged), files)) {
    return 1;
  }
  let diags = checker.check_module(merged).diags;
  if (target_given) {
    diags = util.append_diags(diags, fern.capability_diags(merged, target));
  }
  if (report_diags(util.append_diags(diags, fern.annotated_diags(merged)), files)) {
    return 1;
  }
  return 0;
}

function interpret(merged: parser.Module, prog_args: string[]): i32 {
  let argv: string[] = [PROGRAM_NAME];
  for a in prog_args {
    argv = argv.append(a);
  }
  let v = interp.eval_module_argv(merged, argv);
  let (is_status, status) = interp.exit_status(v);
  if (is_status) {
    return status;
  }
  match (v) {
    interp.VErr(e) => {
      if (e.abort) {
        eprint(e.msg);
        return 134;
      }
      eprint("fern: interp: " + e.msg);
      return 254;
    },
    _ => {
      return 254;
    }
  }
}

// source_bytes is ALL_OF_STDIN, BAD_BYTE_COUNT, or the length of the source.
struct Argv { check: boolean, interp: boolean, lsp: boolean, target: string, target_given: boolean, form: string, source_bytes: i32, prog_args: string[] }

const ALL_OF_STDIN: i32 = -1;

const BAD_BYTE_COUNT: i32 = -2;

function parse_argv(av: string[]): Argv {
  let o = Argv { check: false, interp: false, lsp: false, target: "wasm32-wasi", target_given: false, form: "", source_bytes: ALL_OF_STDIN, prog_args: [] };
  let ai = 1;
  while (ai < av.len()) {
    let a = av[ai];
    if (a == "--") {
      return Argv { ...o, prog_args: args_after(av, ai) };
    }
    if (takes_value(a) && ai + 1 < av.len()) {
      o = with_value(o, a, av[ai + 1]);
      ai += 1;
    } else {
      o = with_switch(o, a);
    }
    ai += 1;
  }
  return o;
}

function args_after(av: string[], at: i32): string[] {
  let rest: string[] = [];
  for i in at + 1..av.len() {
    rest = rest.append(av[i]);
  }
  return rest;
}

function takes_value(flag: string): boolean {
  return flag == TARGET_FLAG || flag == EMIT_FLAG || flag == SOURCE_BYTES_FLAG;
}

function with_value(o: Argv, flag: string, v: string): Argv {
  if (flag == TARGET_FLAG) {
    return Argv { ...o, target: v, target_given: true };
  }
  if (flag == EMIT_FLAG) {
    return Argv { ...o, form: v };
  }
  return Argv { ...o, source_bytes: byte_count(v) };
}

function with_switch(o: Argv, flag: string): Argv {
  if (flag == CHECK_FLAG) {
    return Argv { ...o, check: true };
  }
  if (flag == INTERP_FLAG) {
    return Argv { ...o, interp: true };
  }
  if (flag == LSP_FLAG) {
    return Argv { ...o, lsp: true };
  }
  return o;
}

function byte_count(v: string): i32 {
  match (i32.parse_i32(v)) {
    Ok(n) => {
      return if (n >= 0) { n } else { BAD_BYTE_COUNT };
    },
    Err(_) => {
      return BAD_BYTE_COUNT;
    }
  }
}

// The source text: all of stdin, or its first n bytes. The bytes after them stay on stdin for the
// interpreted program.
function read_source(n: i32): Result[string, string] {
  if (n == BAD_BYTE_COUNT) {
    return Err(SOURCE_BYTES_FLAG + " needs a byte count of zero or more");
  }
  let bytes = if (n == ALL_OF_STDIN) { read_all_stdin() } else { read_stdin_bytes(n) };
  match (bytes) {
    Ok(got) => {
      match (utf8.from_bytes(got)) {
        Ok(text) => {
          return Ok(text);
        },
        Err(_) => {
          return Err("the source on stdin is not UTF-8");
        }
      }
    },
    Err(why) => {
      return Err(why);
    }
  }
}

function read_all_stdin(): Result[u8[], string] {
  match (io.read_all_stdin_bytes()) {
    Ok(all) => {
      return Ok(all);
    },
    Err(_) => {
      return Err("cannot read stdin");
    }
  }
}

// A chunk read never returns more bytes than it asks for.
function read_stdin_bytes(n: i32): Result[u8[], string] {
  let r = stdin();
  let got: u8[] = [];
  while (got.len() < n) {
    match (r.read_chunk_bytes(n - got.len())) {
      Ok(chunk) => {
        if (chunk.len() == 0) {
          return Err("stdin ended before " + SOURCE_BYTES_FLAG + " " + n.to_string() + " bytes of source");
        }
        for b in chunk {
          got = got.append(b);
        }
      },
      Err(_) => {
        return Err("cannot read stdin");
      }
    }
  }
  return Ok(got);
}

function run(): i32 {
  let o = parse_argv(args());
  let target = o.target;
  let bad_target = fern.target_refusal(target);
  if (bad_target.len() > 0) {
    eprint(bad_target);
    return 2;
  }
  if (o.lsp) {
    return fern.serve_lsp_in_memory(LSP_STDLIB_ROOT, embedded_stdlib_files(LSP_STDLIB_ROOT), target, o.target_given);
  }
  let bad_emit = fern.emit_refusal(target, o.form);
  if (bad_emit.len() > 0) {
    eprint(bad_emit);
    return 2;
  }
  let form = fern.core_form(o.form);
  if (form.len() == 0 && platforms.for_target(target).isa != "wasm32") {
    form = "asm";
  }
  let src = "";
  match (read_source(o.source_bytes)) {
    Ok(text) => {
      src = text;
    },
    Err(why) => {
      eprint("fern: " + why);
      return 1;
    }
  }
  let entry = emitforms.entry_module(parser.parse_module(lexer.tokenize(src)), target);
  let handle = emitforms.http_entry_refused(entry, target);
  if (handle.message.len() > 0) {
    if (handle.line > 0) {
      eprint(util.pos_str("stdin", [], handle.line, handle.col) + ": error[" + handle.code + "]: " + handle.message);
    } else {
      eprint(handle.message);
    }
    return 1;
  }

  let ov = embedded_stdlib();
  let g = modloader.load_graph(ov, "stdin", entry, "");
  entry = g.entry;
  let loaded = g.loaded;
  let files = g.files;
  let missing = g.missing;
  if (modloader.report_unresolved(missing, "playground")) {
    return 1;
  }
  if (report_diags(asmcore.imported_parse_errors(flatten.modules(loaded)), files)) {
    return 1;
  }

  let merged = modloader.bundle(ov, "stdin", entry, loaded, target, "");
  merged = parser.fill_default_args_module(merged);
  merged = parser.resolve_variant_fields_module(merged);

  if (o.check) {
    return check(merged, files, target, o.target_given);
  }
  if (o.interp) {
    let checked = check(merged, files, target, false);
    if (checked != 0) {
      return checked;
    }
    return interpret(merged, o.prog_args);
  }
  return emit(merged, files, target, form);
}

function native_output(full: parser.Module, sub: ircore.Sub, target: string): string {
  if (platforms.for_target(target).isa == "x86-64") {
    return asm_ir.emit_module_or_error_sub(full, sub, 0 as usize);
  }
  if (target == "arm64-darwin") {
    return asm_arm64_ir.darwinize(asm_arm64_ir.emit_module_or_error_sub(full, true, sub, 0 as usize));
  }
  return asm_arm64_ir.emit_module_or_error_sub(full, false, sub, 0 as usize);
}

function emit(merged: parser.Module, files: string[], target: string, form: string): i32 {
  if (report_diags(asmcore.parse_errors(merged), files)) {
    return 1;
  }
  let checked = checker.build_gate_with_file(merged, "");
  if (report_diags(checked.diags, files)) {
    return 1;
  }
  merged = checked.typed;
  let errs = asmcore.check_call_arity(parser.fill_default_args_module(merged));
  errs = util.append_diags(errs, asmcore.check_map_new_chain(merged));
  errs = util.append_diags(errs, asmcore.check_undefined_calls(merged));
  if (report_diags(errs, files)) {
    return 1;
  }
  let desc = platforms.for_target(target);
  merged = constfold.fold_target_name(merged, desc.environment, desc.isa);
  merged = constfold.prune_literal_branches(merged);
  let roots: string[] = [];
  if (fern.is_freestanding(target)) {
    let (exported, names, bad) = fern.freestanding_roots(merged, "");
    if (bad.len() > 0) {
      eprint("fern: " + bad);
      return 2;
    }
    merged = fern.provider_entries(exported, target);
    roots = names;
  }
  if (report_diags(fern.capability_diags(merged, target), files)) {
    return 1;
  }
  if (report_diags(fern.annotated_diags(merged), files)) {
    return 1;
  }
  merged = constfold.fold_module(merged);
  merged = treeshake.treeshake(merged);

  let typed = parser.module_with_builtins_typed(merged);
  let full = parser.erase_view_module(typed);
  let sub = ircore.Sub { ...semlower.target_substitution(typed, target, semlower.build_opts(false, false, true, semarrayreport.off())), switches: asmcore.Switches { ...asmcore.env_switches(), target: target } };
  if (report_diags(sub.refused, files)) {
    return 1;
  }
  let out = "";
  if (desc.isa == "x86-64" || desc.isa == "arm64") {
    out = native_output(full, sub, target);
  } else if (target == "wasm32-wasi-http") {
    if (form == "asm") {
      out = emitforms.wasm_http_core(full, sub);
    } else if (form == "core-module") {
      let hwat = emitforms.wasm_http_core(full, sub);
      if (hwat.len() == 0) {
        return 2;
      }
      unsafe {
        out = string_from_bytes_unchecked(util.to_u8(emitforms.stamped_core(watbin.wat_to_binary(hwat), sub.switches)));
      }
    } else {
      let hc = emitforms.wasm_http_component(full, sub);
      if (hc.bytes.len() == 0) {
        if (hc.refused.len() > 0) {
          eprint(emitforms.http_refused(hc.refused));
        }
        return 2;
      }
      unsafe {
        out = string_from_bytes_unchecked(util.to_u8(hc.bytes));
      }
    }
  } else if (form == "asm") {
    out = wasm_ir.emit_module_mode_or_error_sub(full, false, false, sub);
  } else if (form == "core-module") {
    unsafe {
      out = string_from_bytes_unchecked(util.to_u8(emitforms.stamped_core(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error_sub(full, false, false, sub)), sub.switches)));
    }
  } else {
    let comp = emitforms.wasm_component(full, sub);
    if (comp.bytes.len() == 0) {
      if (comp.refused.len() > 0) {
        eprint(comp.refused);
      }
      return 2;
    }
    unsafe {
      out = string_from_bytes_unchecked(util.to_u8(comp.bytes));
    }
  }
  if (out.len() == 0) {
    return 2;
  }
  if (fern.is_freestanding(target)) {
    out = fern.freestanding_exports(merged, roots, desc.isa == "arm64") + out;
  }
  write(out);
  return 0;
}
