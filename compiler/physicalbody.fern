import "./irtables";
import "./ssasem";
import "./semrecords";
import "./typeinfo";
import "./rccertify";
import "./semscalarreturn";
import "./sempair";

pub struct Metadata { contracts: ssasem.Contract[], records: semrecords.Records, enums: semrecords.Enum[], finalizers: ssasem.Finalizer[] }

pub struct Helper { ty: typeinfo.Type, children_only: boolean }

pub struct Origin { producer: i32, symbol: string, helper: Option[Helper] }

pub struct Origins { producers: Metadata[], declarations: Origin[], extra: Origin[] }

pub struct Collection { producers: Metadata[], rows: Origin[] }

pub struct Selected { producers: Metadata[], origin: Origin }

pub function select(collection: Collection, i: i32): Selected {
  return Selected { producers: collection.producers, origin: origin_at(collection.rows, i) };
}

pub function collection(lowered: Lowered): Collection {
  return Collection { producers: [metadata(lowered)], rows: lowered_origins(lowered, 0) };
}

pub function no_collection(): Collection {
  return Collection { producers: [], rows: [] };
}

pub function origin_at(rows: Origin[], i: i32): Origin {
  if (i >= 0 && i < rows.len()) {
    return rows[i];
  }
  return Origin { producer: -1, symbol: "", helper: None };
}

pub function no_origins(): Origins {
  return Origins { producers: [], declarations: [], extra: [] };
}

pub function named_origins(names: string[], producer: i32): Origin[] {
  let out: Origin[] = [];
  for name in names {
    out = out.append(Origin { producer: producer, symbol: name, helper: None });
  }
  return out;
}

pub function select_origins(rows: Origin[], indices: i32[]): Origin[] {
  let out: Origin[] = [];
  for i in indices {
    out = out.append(rows[i]);
  }
  return out;
}

pub struct Lowered {
  bodies: irtables.LowerResult[],
  declarations: string[],
  helper_types: Option[Helper][],
  contracts: ssasem.Contract[],
  records: semrecords.Records,
  enums: semrecords.Enum[],
  finalizers: ssasem.Finalizer[],
}

pub function empty(): Lowered {
  return Lowered { bodies: [], declarations: [], helper_types: [], contracts: [], records: semrecords.no_records(), enums: [], finalizers: [] };
}

pub function metadata(lowered: Lowered): Metadata {
  return Metadata { contracts: lowered.contracts, records: lowered.records, enums: lowered.enums, finalizers: lowered.finalizers };
}

pub function lowered_origins(lowered: Lowered, producer: i32): Origin[] {
  let out: Origin[] = [];
  let i: i32 = 0;
  for body in lowered.bodies {
    let symbol: string = if (i < lowered.declarations.len()) { lowered.declarations[i] } else { body.name };
    let helper: Option[Helper] = if (i < lowered.helper_types.len()) { lowered.helper_types[i] } else { None };
    out = out.append(Origin { producer: producer, symbol: symbol, helper: helper });
    i = i + 1;
  }
  return out;
}

pub function abis(c: Collection): rccertify.Abis {
  let names: string[] = [];
  let modes: i32[][] = [];
  let results: boolean[] = [];
  let firsts: boolean[] = [];
  let seconds: i32[] = [];
  let splits: i32[][] = [];
  let words: boolean[] = [];
  for m in c.producers {
    for k in m.contracts {
      names = names.append(k.name);
      modes = modes.append(k.modes);
      results = results.append(ssasem.reference(k.result));
      firsts = firsts.append(pair_first(k.result));
      seconds = seconds.append(pair_second(m.enums, k.result));
      splits = splits.append([split_word(m, k.result, 0), split_word(m, k.result, 1)]);
      words = words.append(ssasem.is_usize(k.result));
    }
  }
  return rccertify.abis_of(names, modes, results, firsts, seconds, splits, words);
}

// The variants whose pair word `slot` holds a unit when the variant returns
// in three words, a two-word payload split across both pair words.
function split_word(m: Metadata, t: typeinfo.Type, slot: i32): i32 {
  let at: i32 = semrecords.find_enum(m.enums, t);
  if (at < 0 || semscalarreturn.variant_in_lanes(m.enums[at])) {
    return 0;
  }
  let mask: i32 = 0;
  let tag: i32 = 0;
  for v in m.enums[at].variants {
    let held: boolean = false;
    if (v.fields.len() == 1) {
      let parts: typeinfo.Type[] = sempair.split_parts(m.records, m.finalizers, v.fields[0].ty);
      if (parts.len() == 2) {
        held = ssasem.reference(parts[slot]);
      } else {
        held = slot == 0 && ssasem.reference(v.fields[0].ty);
      }
    }
    if (held && tag >= 31) {
      return 0 - 2;
    }
    if (held) {
      mask = mask | 1 << tag;
    }
    tag = tag + 1;
  }
  return mask;
}

function pair_first(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements.len() == 2 && ssasem.reference(tup.elements[0]);
  }
  return false;
}

function pair_second(enums: semrecords.Enum[], t: typeinfo.Type): i32 {
  if (ssasem.is_wide(t)) {
    return 0;
  }
  if let typeinfo.TypeTuple(tup) = t {
    if (tup.elements.len() == 2 && ssasem.reference(tup.elements[1])) {
      return -1;
    }
    return 0;
  }
  let at: i32 = semrecords.find_enum(enums, t);
  if (at < 0) {
    return -2;
  }
  if (semscalarreturn.variant_in_lanes(enums[at])) {
    return 0;
  }
  let mask: i32 = 0;
  let tag: i32 = 0;
  for v in enums[at].variants {
    if (v.fields.len() == 1 && ssasem.reference(v.fields[0].ty)) {
      if (tag >= 31) {
        return -2;
      }
      mask = mask | 1 << tag;
    }
    tag = tag + 1;
  }
  return mask;
}
