// Physical bodies and the selected metadata from the same lowering invocation.
// This carrier is not an ownership certificate or a final-emission collection.
import "./irtables";
import "./ssasem";
import "./semrecords";

// Selected facts from one producer, without retaining its input body graphs.
pub struct Metadata { contracts: ssasem.Contract[], records: semrecords.Records, enums: semrecords.Enum[], finalizers: ssasem.Finalizer[] }

// The selected symbol may differ from a method body's bare name.
// An origin identifies metadata; it does not approve the body's effects.
pub struct Origin { producer: i32, symbol: string }

pub struct Origins { producers: Metadata[], declarations: Origin[], extra: Origin[] }

// Rows follow an actual emit cache. A negative producer means no metadata
// was supplied; it must never resolve to a producer or approve a body.
pub struct Collection { producers: Metadata[], rows: Origin[] }

// One row selected in the same branch as the body that will be emitted.
pub struct Selected { producers: Metadata[], origin: Origin }

pub function select(collection: Collection, i: i32): Selected {
  return Selected { producers: collection.producers, origin: origin_at(collection.rows, i) };
}

pub function collection(lowered: Lowered): Collection {
  return Collection { producers: [metadata(lowered)], rows: lowered_origins(lowered, 0) };
}

pub function no_collection(): Collection {
  return Collection { producers: [], rows: [] };
}

pub function origin_at(rows: Origin[], i: i32): Origin {
  if (i >= 0 && i < rows.len()) {
    return rows[i];
  }
  return Origin { producer: -1, symbol: "" };
}

pub function no_origins(): Origins {
  return Origins { producers: [], declarations: [], extra: [] };
}

pub function named_origins(names: string[], producer: i32): Origin[] {
  let out: Origin[] = [];
  for name in names {
    out = out.append(Origin { producer: producer, symbol: name });
  }
  return out;
}

pub function select_origins(rows: Origin[], indices: i32[]): Origin[] {
  let out: Origin[] = [];
  for i in indices {
    out = out.append(rows[i]);
  }
  return out;
}

pub struct Lowered {
  bodies: irtables.LowerResult[],
  // Selected declaration symbols in body order; helpers follow this prefix.
  // Method bodies retain their bare names; these symbols include the receiver.
  declarations: string[],
  contracts: ssasem.Contract[],
  records: semrecords.Records,
  enums: semrecords.Enum[],
  finalizers: ssasem.Finalizer[],
}

pub function empty(): Lowered {
  return Lowered { bodies: [], declarations: [], contracts: [], records: semrecords.no_records(), enums: [], finalizers: [] };
}

pub function metadata(lowered: Lowered): Metadata {
  return Metadata { contracts: lowered.contracts, records: lowered.records, enums: lowered.enums, finalizers: lowered.finalizers };
}

pub function lowered_origins(lowered: Lowered, producer: i32): Origin[] {
  let out: Origin[] = [];
  let i: i32 = 0;
  for body in lowered.bodies {
    let symbol: string = if (i < lowered.declarations.len()) { lowered.declarations[i] } else { body.name };
    out = out.append(Origin { producer: producer, symbol: symbol });
    i = i + 1;
  }
  return out;
}
