import "./ssastringstate" as machine;
import "./ssacondition" as condition;
import "./ssacapacityisa" as isa;
import "./ssastringvalue" as value;
import "./ssacapacitymachine" as capacity;
import "./ssalargepushwidemachine" as large;

function base_at(grown: boolean): i32 {
  return if (grown) { -16 } else { -8 };
}

function base_cell(grown: boolean): i32 {
  return if (grown) { 22 } else { 0 };
}

function initial(r: value.Interval, register_entry: boolean, grown: boolean): machine.State {
  let regs: machine.Word[] = [];
  let i = 0;
  while (i < 16) {
    regs = regs.append(if (i == 4) { machine.identity(3, 0) } else { machine.identity(2, i) });
    i += 1;
  }
  if (register_entry) {
    regs = regs.with(0, machine.identity(6, 0));
  }
  let length = if (grown) { machine.identity(5, 4) } else { machine.numeric(r, value.length(r)) };
  let shape = if (grown) { 1196576599 } else { 1934589965 };
  let cells = [machine.numeric_half(value.number(r, 1 as i64)), machine.numeric_half(value.number(r, shape as i64)), machine.token(5, 2, 0), machine.token(5, 3, 0), length.low, length.high];
  for i in 6..16 {
    cells = cells.append(machine.token(5, i, 0));
  }
  cells = cells.append(machine.token(4, 0, 0)).append(machine.token(4, 0, 1));
  let argument = if (register_entry) { machine.identity(5, 18) } else { machine.identity(6, 0) };
  cells = cells.append(argument.low).append(argument.high).append(machine.token(8, 0, 0)).append(machine.token(8, 0, 1));
  if (grown) {
    let held = machine.numeric(r, value.words(r));
    cells = cells.append(held.low).append(held.high);
  }
  return machine.State { regs: regs, cells: cells, flags: condition.unknown_flags(), ok: true, zeros: 0, links: 0, slots: 0, call_return: -1, grown: grown, family: 0, buffer_links: 0, buffer_slots: 0 };
}

function simple_address(w: machine.Word, offset: i32, width: i32, grown: boolean): i32 {
  let at = w.low.identity as i64 + offset as i64;
  if (grown && machine.pointer(w, 6) && machine.extent(at, -16, -8, width)) {
    return 22 + (at as i32 + 16) / 4;
  }
  if (machine.pointer(w, 3) && machine.extent(at, -40, 16, width)) {
    return 6 + (at as i32 + 40) / 4;
  }
  if (machine.pointer(w, 6) && machine.extent(at, -8, 0, width)) {
    return (at as i32 + 8) / 4;
  }
  if (machine.pointer(w, 6) && machine.extent(at, 8, 16, width)) {
    return 2 + at as i32 / 4;
  }
  return -1;
}

function address(s: machine.State, r: value.Interval, op: isa.Op): i32 {
  if (op.base < 0) {
    return -1;
  }
  let w = s.regs[op.base];
  if (op.index < 0) {
    return simple_address(w, op.offset, op.width, s.grown);
  }
  if (!machine.same_word(w, machine.identity(7, 0)) || op.scale != 8 || !machine.extent(op.offset as i64, 0, 8, op.width)) {
    return -1;
  }
  if (value.expected_class(r, !s.grown) != -3) {
    return -1;
  }
  return if (machine.same_word(s.regs[op.index], machine.numeric(r, value.expected_small(r, !s.grown)))) { 20 + op.offset / 4 } else { -1 };
}

function heap_store(s: machine.State, r: value.Interval, at: i32, width: i32, w: machine.Word): machine.State {
  if (at == 0 && width == 32 && s.zeros == 0 && s.links == 0 && machine.same_half(w.low, machine.zero(r))) {
    return machine.put(machine.State { ...s, zeros: 1 }, at, width, w);
  }
  return link_store(s, at, width, w);
}

function link_store(s: machine.State, at: i32, width: i32, w: machine.Word): machine.State {
  if (s.zeros != 1 || width != 64) {
    return machine.State { ...s, ok: false };
  }
  if (at == base_cell(s.grown) && s.links == 0 && machine.same_word(w, machine.identity(8, 0))) {
    return machine.put(machine.State { ...s, links: 1 }, at, width, w);
  }
  if (at == 20 && s.slots == 0 && machine.same_word(w, machine.identity(6, base_at(s.grown)))) {
    return machine.put(machine.State { ...s, slots: 1 }, at, width, w);
  }
  return machine.State { ...s, ok: false };
}

function stack_step(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  if (!machine.pointer(s.regs[4], 3)) {
    return machine.State { ...s, ok: false };
  }
  let sp = s.regs[4].low.identity;
  if (op.kind == 6) {
    let saved = s.regs[op.source];
    let at = simple_address(s.regs[4], -8, 64, false);
    return machine.write(machine.store(s, r, at, 64, saved, heap_store), 4, machine.identity(3, sp - 8));
  }
  if (op.destination == 4) {
    return machine.State { ...s, ok: false };
  }
  let loaded = machine.read(s, r, simple_address(s.regs[4], 0, 64, false), 64);
  return machine.write(machine.write(s, 4, machine.identity(3, sp + 8)), op.destination, loaded);
}

function pointer_lea(s: machine.State, op: isa.Op): machine.State {
  let w = s.regs[op.base];
  let at = w.low.identity as i64 + op.offset as i64;
  if (machine.pointer(w, 6) && at >= base_at(s.grown) as i64 && at <= 16 as i64) {
    return machine.write(s, op.destination, machine.identity(6, at as i32));
  }
  if (machine.pointer(w, 3) && at >= -(40 as i64) && at <= 8 as i64) {
    return machine.write(s, op.destination, machine.identity(3, at as i32));
  }
  return machine.State { ...s, ok: false };
}

function comparison(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  let w = s.regs[op.source];
  if (op.width == 64 && machine.same_word(w, machine.identity(6, 0)) && op.immediate == 65536) {
    return machine.State { ...s, flags: condition.Flags { order: condition.Comparison { less: 0, equal: -1, less_equal: -1 }, signed: condition.unknown_order(), sign: -1 } };
  }
  let v = machine.number(r, w, op.width);
  if (!value.valid(r, v) || op.immediate < 0) {
    return machine.State { ...s, flags: condition.unknown_flags() };
  }
  let order = value.compare(r, v, op.immediate as i64);
  let signed = if (machine.positive_signed(r, v, op.width)) { order } else { condition.unknown_order() };
  return machine.State { ...s, flags: condition.Flags { order: order, signed: signed, sign: signed.less } };
}

function test(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  let v = machine.number(r, s.regs[op.source], op.width);
  if (!machine.positive_signed(r, v, op.width)) {
    return machine.State { ...s, flags: condition.unknown_flags() };
  }
  let cmp = value.compare(r, v, 0 as i64);
  return machine.State { ...s, flags: condition.Flags { order: condition.Comparison { less: 0, equal: cmp.equal, less_equal: cmp.equal }, signed: cmp, sign: 0 } };
}

function words(r: value.Interval, grown: boolean): value.Value {
  return if (grown) { value.words(r) } else { value.add(r, value.words(r), 3 as i64) };
}

function bytes(r: value.Interval, grown: boolean): value.Value {
  return value.times_eight(r, words(r, grown));
}

function dependency_call(s: machine.State, r: value.Interval, pc: i32, op: isa.Op): machine.State {
  if (s.call_return >= 0 || s.links != 0 || s.slots != 0) {
    return machine.State { ...s, ok: false };
  }
  return if (op.symbol == "__fern_capw") { capacity_call(s, r, pc) } else { large_call(s, r, pc, op) };
}

function capacity_call(s: machine.State, r: value.Interval, pc: i32): machine.State {
  if (value.expected_class(r, !s.grown) != -3 || !machine.same_word(s.regs[4], machine.identity(3, -8)) || !machine.same_word(machine.read(s, r, 14, 64), machine.numeric(r, words(r, s.grown)))) {
    return machine.State { ...s, ok: false };
  }
  let next = pc + 1;
  let called = machine.put(s, 12, 64, machine.identity(9, next));
  called = machine.put(called, 10, 64, s.regs[0]);
  called = machine.put(called, 8, 64, s.regs[1]);
  called = machine.put(called, 6, 64, s.regs[2]);
  called = machine.put(called, 14, 64, machine.numeric(r, value.expected_small(r, !s.grown)));
  return machine.State { ...called, call_return: next, flags: condition.unknown_flags() };
}

function large_call(s: machine.State, r: value.Interval, pc: i32, op: isa.Op): machine.State {
  if (op.symbol != "__fern_large_push" || !machine.same_word(s.regs[4], machine.identity(3, 0)) || !machine.same_word(s.regs[8], machine.identity(6, base_at(s.grown))) || !machine.same_word(s.regs[6], machine.numeric(r, bytes(r, s.grown)))) {
    return machine.State { ...s, ok: false };
  }
  let class = value.expected_class(r, !s.grown);
  if (class == -3 || class == -1) {
    return machine.State { ...s, ok: false };
  }
  let called = machine.put(s, 14, 64, machine.identity(9, pc + 1));
  if (class >= 0) {
    let old = machine.read(s, r, 20, 64);
    called = machine.put(called, base_cell(s.grown), 64, old);
    called = machine.put(called, 20, 64, machine.identity(6, base_at(s.grown)));
    called = machine.write(called, 0, machine.numeric(r, value.number(r, class as i64)));
    called = machine.write(machine.write(called, 1, old), 2, machine.identity(10, 0));
    called = machine.State { ...called, links: 1, slots: 1 };
  }
  return machine.State { ...called, call_return: pc + 1, flags: condition.unknown_flags() };
}

function expected_register(r: value.Interval, reg: i32, grown: boolean): machine.Word {
  let class = value.expected_class(r, !grown);
  if (class == -3) {
    return small_register(r, reg, grown);
  }
  return match (reg) {
    0 => if (class >= 0) { machine.numeric(r, value.number(r, class as i64)) } else { machine.identity(6, 0) },
    1 => if (class >= 0) { machine.identity(8, 0) } else { machine.identity(6, base_at(grown)) },
    2 => if (class >= 0) { machine.identity(10, 0) } else { machine.numeric(r, words(r, grown)) },
    _ => large_register(r, reg, grown),
  };
}

function large_register(r: value.Interval, reg: i32, grown: boolean): machine.Word {
  if (reg == 6) {
    return machine.numeric(r, bytes(r, grown));
  }
  if (reg == 8) {
    return machine.identity(6, base_at(grown));
  }
  return if (reg == 4) { machine.identity(3, 0) } else { machine.identity(2, reg) };
}

function small_register(r: value.Interval, reg: i32, grown: boolean): machine.Word {
  return match (reg) {
    0 => machine.identity(6, 0),
    1 => machine.identity(6, base_at(grown)),
    2 => machine.numeric(r, value.expected_small(r, !grown)),
    4 => machine.identity(3, 0),
    6 => machine.identity(8, 0),
    8 => machine.identity(7, 0),
    _ => machine.identity(2, reg),
  };
}

function expected_scratch(s: machine.State, r: value.Interval): machine.Half[] {
  let expected = initial(r, false, s.grown);
  if (value.expected_class(r, !s.grown) != -3) {
    return machine.put(expected, 14, 64, machine.identity(9, s.call_return)).cells;
  }
  if (big(r, s.grown)) {
    expected = machine.put(expected, 6, 64, machine.numeric(r, words(r, s.grown)));
    expected = machine.put(expected, 8, 64, machine.identity(6, base_at(s.grown)));
    expected = machine.put(expected, 10, 64, machine.identity(6, 0));
    expected = machine.put(expected, 12, 64, machine.identity(9, s.call_return));
    expected = machine.put(expected, 14, 64, machine.numeric(r, value.expected_small(r, !s.grown)));
  }
  return expected.cells;
}

function big(r: value.Interval, grown: boolean): boolean {
  return r.low + (if (grown) { 0 } else { 3 }) as i64 > 256 as i64;
}

function final_registers(s: machine.State, r: value.Interval): boolean {
  for i in 0..16 {
    if (!machine.same_word(s.regs[i], expected_register(r, i, s.grown))) {
      return false;
    }
  }
  return true;
}

function final_counts(s: machine.State, r: value.Interval): boolean {
  let recycled = if (value.expected_class(r, !s.grown) == -2) { 0 } else { 1 };
  return s.zeros == 1 && s.links == recycled && s.slots == recycled && big(r, s.grown) == s.call_return >= 0;
}

function finished(s: machine.State, r: value.Interval, register_entry: boolean): boolean {
  let class = value.expected_class(r, !s.grown);
  let recycled = if (class == -2) { 0 } else { 1 };
  if (!final_counts(s, r) || !final_registers(s, r)) {
    return false;
  }
  let expected = machine.put(initial(r, register_entry, s.grown), 0, 32, machine.numeric(r, value.number(r, 0 as i64)));
  if (recycled == 1) {
    expected = machine.put(expected, base_cell(s.grown), 64, machine.identity(8, 0));
    expected = machine.put(expected, 20, 64, machine.identity(6, base_at(s.grown)));
  }
  let scratch = expected_scratch(s, r);
  for i in 0..s.cells.len() {
    let wanted = if (i >= 6 && i < 16) { scratch[i] } else { expected.cells[i] };
    if (!machine.same_half(s.cells[i], wanted)) {
      return false;
    }
  }
  return true;
}

function unguarded(s: machine.State, original: machine.State, r: value.Interval): machine.State {
  let regs = s.regs;
  let i = 0;
  while (i < regs.len()) {
    if (!machine.same_word(regs[i], original.regs[i])) {
      if (i == 0 || machine.same_word(expected_register(r, i, s.grown), machine.identity(2, i))) {
        return machine.State { ...s, ok: false };
      }
      regs = regs.with(i, original.regs[i]);
    }
    i += 1;
  }
  for i in 0..s.cells.len() {
    if (!machine.same_half(s.cells[i], original.cells[i])) {
      return machine.State { ...s, ok: false };
    }
  }
  return machine.State { ...s, regs: regs, flags: condition.unknown_flags(), ok: s.ok && s.zeros == 0 && s.links == 0 && s.slots == 0 && s.call_return == -1 };
}

function reject_heap_operation(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  return machine.State { ...s, ok: false };
}

function path(p: isa.ArrayProgram, r: value.Interval, register_entry: boolean, grown: boolean): boolean {
  let ops = machine.Instructions { address: address, heap_store: heap_store, stack_step: stack_step, pointer_lea: pointer_lea, comparison: comparison, test: test, dependency_call: dependency_call, heap_operation: reject_heap_operation };
  return machine.path(p, r, register_entry, initial(r, register_entry, grown), unguarded, ops, finished);
}

pub function check(output: string): boolean {
  let p = isa.string_program(output);
  if (p.error != "" || p.register_entry < 0 || p.unguarded_entry < 0 || !capacity.check(output) || !large.check(output)) {
    return false;
  }
  for r in value.intervals(true) {
    if (!path(p, r, false, false) || !path(p, r, true, false)) {
      return false;
    }
  }
  for r in value.intervals(false) {
    if (!path(p, r, false, true) || !path(p, r, true, true)) {
      return false;
    }
  }
  return true;
}
