import "./util";
import "./ssa";

// A cons-tail loop builds its result from the front. Each turn fills the
// hole of the turn before it with a new box. The first fill has no hole: it
// gives the result. So each fill tested that the hole is null.
//
// `cells` gives the loop a cell in the frame for the result. The hole starts
// at the address of the cell, so each fill is one store with no test. A
// return of the result reads the cell.

// A fill. test, empty, store and join are block positions: test ends in the
// null test of the hole, empty is its null side, store holds the store to
// the hole, and join takes the result of the fill in the phi `result`. That
// phi takes the stored value from the null side and `carrier`, the result
// before the fill, from the other side.
// arms holds each block between the test and the join.
struct Fill { test: i32, empty: i32, store: i32, join: i32, result: i32, carrier: i32, arms: i32[] }

// hole is the phi of the hole and head the position of its block. offset is
// the offset of each store. web holds each phi that carries the result.
// starts says that a return can read the result before a fill.
struct Loop { hole: i32, head: i32, offset: i32, fills: Fill[], web: i32[], starts: boolean }

function no_loop(): Loop {
  return Loop { hole: -1, head: -1, offset: 0, fills: [], web: [], starts: false };
}

pub function cells(f: ssa.SFunc): ssa.SFunc {
  let g = f;
  for number in 0..4 {
    let site = find_loop(g);
    if (site.hole < 0) {
      return g;
    }
    g = ssa.prune_dead(with_cell(g, site, number));
  }
  return g;
}

function is_zero(defs: ssa.SInst[], v: i32): boolean {
  return v >= 0 && v < defs.len() && defs[v].kind_tag == ssa.CONST_INT && defs[v].imm == 0 && defs[v].str == "";
}

// Whether a phi of f takes a null and is the base of a store. A function
// with no such phi has no hole, and the answer costs two arrays.
function may_fill(f: ssa.SFunc): boolean {
  let stores = false;
  let phis = false;
  for b in f.blocks {
    for ins in b.insts {
      stores = stores || ins.kind_tag == ssa.ST_AT && ins.args.len() == 2 && ins.str == "";
      phis = phis || ins.kind_tag == ssa.PHI;
    }
  }
  if (!stores || !phis) {
    return false;
  }
  let zeros = __alloc_bool(f.nvals);
  let bases = __alloc_bool(f.nvals);
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssa.CONST_INT && ins.imm == 0 && ins.str == "" && ins.result >= 0) {
        zeros = zeros.with(ins.result, true);
      }
      if (ins.kind_tag == ssa.ST_AT && ins.args.len() == 2 && ins.str == "" && ins.args[0] >= 0) {
        bases = bases.with(ins.args[0], true);
      }
    }
  }
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag != ssa.PHI || ins.result < 0 || !bases[ins.result]) {
        continue;
      }
      for a in ins.args {
        if (a >= 0 && zeros[a]) {
          return true;
        }
      }
    }
  }
  return false;
}

function find_loop(f: ssa.SFunc): Loop {
  if (!may_fill(f)) {
    return no_loop();
  }
  let defs = ssa.inst_defs(f);
  let at = ssa.block_positions(f);
  let uses = ssa.use_counts(f);
  for head in 0..f.blocks.len() {
    for ins in f.blocks[head].insts {
      if (ins.kind_tag != ssa.PHI || !starts_null(defs, ins)) {
        continue;
      }
      let site = hole_loop(f, at, defs, uses, head, ins.result);
      if (site.hole >= 0) {
        return site;
      }
    }
  }
  return no_loop();
}

function starts_null(defs: ssa.SInst[], phi: ssa.SInst): boolean {
  for a in phi.args {
    if (is_zero(defs, a)) {
      return true;
    }
  }
  return false;
}

// The loop of the hole h, when each use of h is the null test of a fill or
// its store, and the results of the fills go only to each other and to a
// return.
function hole_loop(f: ssa.SFunc, at: i32[], defs: ssa.SInst[], uses: i32[], head: i32, h: i32): Loop {
  let none = no_loop();
  let fills: Fill[] = [];
  let stores = 0;
  let offset = -1;
  for bi in 0..f.blocks.len() {
    let b = f.blocks[bi];
    for ins in b.insts {
      if (ins.result == h || util.index_of_i32(ins.args, h) < 0) {
        continue;
      }
      if (ins.kind_tag == ssa.ST_AT && ins.args.len() == 2 && ins.args[0] == h && ins.args[1] != h && ins.str == "") {
        if (offset >= 0 && ins.imm != offset || ins.imm < 0 || ins.imm >= 4096) {
          return none;
        }
        offset = ins.imm;
        stores += 1;
        continue;
      }
      let fill = fill_at(f, at, defs, uses, bi, ins, h);
      if (fill.test < 0) {
        return none;
      }
      fills = fills.append(fill);
    }
    if (b.term.kind_tag == ssa.TERM_RET && b.term.value == h) {
      return none;
    }
  }
  if (fills.len() == 0 || stores != fills.len()) {
    return none;
  }
  for fill in fills {
    if (f.blocks[fill.store].insts[0].imm != offset) {
      return none;
    }
  }
  let web = result_web(f, defs, fills);
  if (web.len() == 0 || !edges_agree(f, at, defs, head, h, fills, web)) {
    return none;
  }
  return Loop { hole: h, head: head, offset: offset, fills: fills, web: web, starts: returns_carrier(f, fills, web) };
}

// The fill that the compare `ins` of the block at bi decides: the block ends
// in a branch on `h == 0`, its null side is empty, its other side stores to
// h, and both sides jump to a join whose one phi takes the stored value from
// the null side.
function fill_at(f: ssa.SFunc, at: i32[], defs: ssa.SInst[], uses: i32[], bi: i32, ins: ssa.SInst, h: i32): Fill {
  let none = Fill { test: -1, empty: -1, store: -1, join: -1, result: -1, carrier: -1, arms: [] };
  let b = f.blocks[bi];
  if (ins.kind_tag != ssa.BINARY || ins.str != "eq" || ins.args.len() != 2 || ins.args[0] != h || !is_zero(defs, ins.args[1])) {
    return none;
  }
  if (b.term.kind_tag != ssa.TERM_BRIF || b.term.cond != ins.result || uses[ins.result] != 1 || b.term.t == b.term.f) {
    return none;
  }
  let e = ssa.position_of(at, b.term.t);
  let s = ssa.position_of(at, b.term.f);
  if (e < 0 || s < 0) {
    return none;
  }
  let eb = f.blocks[e];
  let sb = f.blocks[s];
  if (eb.preds.len() != 1 || eb.insts.len() != 0 || eb.term.kind_tag != ssa.TERM_BR) {
    return none;
  }
  if (sb.preds.len() != 1 || sb.insts.len() != 1 || sb.term.kind_tag != ssa.TERM_BR) {
    return none;
  }
  let st = sb.insts[0];
  if (st.kind_tag != ssa.ST_AT || st.args.len() != 2 || st.args[0] != h) {
    return none;
  }
  let arms = passed_on(f, at, [e], e);
  let last_empty = f.blocks[arms[arms.len() - 1]];
  arms = passed_on(f, at, arms.append(s), s);
  let last_store = f.blocks[arms[arms.len() - 1]];
  let j = ssa.position_of(at, last_empty.term.target);
  if (j < 0 || last_store.term.target != last_empty.term.target || f.blocks[j].preds.len() != 2 || util.index_of_i32(arms, j) >= 0) {
    return none;
  }
  let jb = f.blocks[j];
  let es = ssa.pred_slot(jb, last_empty.id);
  let ss = ssa.pred_slot(jb, last_store.id);
  if (es < 0 || ss < 0 || es == ss) {
    return none;
  }
  let result = -1;
  let carrier = -1;
  for phi in jb.insts {
    if (phi.kind_tag != ssa.PHI) {
      continue;
    }
    if (result >= 0 || phi.args[es] != st.args[1] || phi.args[ss] == st.args[1]) {
      return none;
    }
    result = phi.result;
    carrier = phi.args[ss];
  }
  if (result < 0) {
    return none;
  }
  return Fill { test: bi, empty: e, store: s, join: j, result: result, carrier: carrier, arms: arms };
}

// `arms` with each empty block that only passes the jump of the block at
// `from` on: it has one predecessor and no instruction.
function passed_on(f: ssa.SFunc, at: i32[], own arms: i32[], from: i32): i32[] {
  let p = from;
  while (arms.len() < 16) {
    let t = ssa.position_of(at, f.blocks[p].term.target);
    if (t < 0 || f.blocks[p].term.kind_tag != ssa.TERM_BR) {
      return arms;
    }
    let b = f.blocks[t];
    if (b.preds.len() != 1 || b.insts.len() != 0 || b.term.kind_tag != ssa.TERM_BR || util.index_of_i32(arms, t) >= 0) {
      return arms;
    }
    arms = arms.append(t);
    p = t;
  }
  return arms;
}

function is_result(fills: Fill[], v: i32): boolean {
  for fill in fills {
    if (fill.result == v) {
      return true;
    }
  }
  return false;
}

// The results of the fills and each phi that carries one of them. Empty when
// a carrier is not a phi, or when something other than a phi of the web or a
// return reads a value of the web.
function result_web(f: ssa.SFunc, defs: ssa.SInst[], fills: Fill[]): i32[] {
  let web: i32[] = [];
  for fill in fills {
    web = web.append(fill.result);
  }
  for fill in fills {
    if (!is_zero(defs, fill.carrier) && util.index_of_i32(web, fill.carrier) < 0) {
      web = web.append(fill.carrier);
    }
  }
  let k = fills.len();
  while (k < web.len()) {
    let phi = defs[web[k]];
    if (phi.kind_tag != ssa.PHI || web.len() > 64) {
      return [];
    }
    for a in phi.args {
      if (a >= 0 && !is_zero(defs, a) && util.index_of_i32(web, a) < 0) {
        web = web.append(a);
      }
    }
    k += 1;
  }
  for b in f.blocks {
    for ins in b.insts {
      for a in ins.args {
        if (util.index_of_i32(web, a) >= 0 && (ins.kind_tag != ssa.PHI || util.index_of_i32(web, ins.result) < 0)) {
          return [];
        }
      }
    }
    if (b.term.kind_tag == ssa.TERM_BRIF && util.index_of_i32(web, b.term.cond) >= 0) {
      return [];
    }
  }
  return web;
}

// Each edge that gives the hole a null gives each carrier in the block of the
// hole a null too, and no such edge comes from an arm of a fill.
function edges_agree(f: ssa.SFunc, at: i32[], defs: ssa.SInst[], head: i32, h: i32, fills: Fill[], web: i32[]): boolean {
  let hb = f.blocks[head];
  let hole = defs[h];
  for s in 0..hb.preds.len() {
    let null = is_zero(defs, hole.args[s]);
    let p = ssa.position_of(at, hb.preds[s]);
    if (p < 0) {
      return false;
    }
    for fill in fills {
      if (null && util.index_of_i32(fill.arms, p) >= 0) {
        return false;
      }
    }
    for ins in hb.insts {
      if (ins.kind_tag == ssa.PHI && util.index_of_i32(web, ins.result) >= 0 && is_zero(defs, ins.args[s]) != null) {
        return false;
      }
    }
  }
  return true;
}

// Whether a return gives a carrier and not the result of a fill. The cell
// then gets a null where the hole starts.
function returns_carrier(f: ssa.SFunc, fills: Fill[], web: i32[]): boolean {
  for b in f.blocks {
    if (b.term.kind_tag == ssa.TERM_RET && util.index_of_i32(web, b.term.value) >= 0 && !is_result(fills, b.term.value)) {
      return true;
    }
  }
  return false;
}

function with_cell(f: ssa.SFunc, site: Loop, number: i32): ssa.SFunc {
  let defs = ssa.inst_defs(f);
  let at = ssa.block_positions(f);
  let gone = __alloc_bool(f.blocks.len());
  let filled = util.minus_ones(f.blocks.len());
  let joined = util.minus_ones(f.blocks.len());
  for k in 0..site.fills.len() {
    let fill = site.fills[k];
    for arm in fill.arms {
      gone = gone.with(arm, true);
    }
    filled = filled.with(fill.test, k);
    joined = joined.with(fill.join, k);
  }
  let head = f.blocks[site.head];
  let hole = defs[site.hole];
  let nvals = f.nvals;
  let starts = util.minus_ones(head.preds.len());
  let blocks: ssa.SBlock[] = [];
  for bi in 0..f.blocks.len() {
    if (gone[bi]) {
      continue;
    }
    let b = f.blocks[bi];
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      if (ins.kind_tag == ssa.PHI && util.index_of_i32(site.web, ins.result) >= 0) {
        continue;
      }
      insts = insts.append(ins);
    }
    let term = b.term;
    let preds = b.preds;
    if (filled[bi] >= 0) {
      let fill = site.fills[filled[bi]];
      insts = insts.append(f.blocks[fill.store].insts[0]);
      term = ssa.t_br(f.blocks[fill.join].id);
    }
    if (joined[bi] >= 0) {
      preds = [f.blocks[site.fills[joined[bi]].test].id];
    }
    for s in 0..head.preds.len() {
      if (head.preds[s] == b.id && is_zero(defs, hole.args[s])) {
        insts = insts.append(ssa.frame_cell(nvals, number, site.offset));
        starts = starts.with(s, nvals);
        nvals += 1;
        if (site.starts) {
          insts = insts.append(ssa.SInst { kind_tag: ssa.CONST_INT, result: nvals, args: [], imm: 0, str: "" });
          insts = insts.append(ssa.SInst { kind_tag: ssa.ST_AT, result: nvals + 1, args: [nvals - 1, nvals], imm: site.offset, str: "" });
          nvals += 2;
        }
      }
    }
    if (term.kind_tag == ssa.TERM_RET && util.index_of_i32(site.web, term.value) >= 0) {
      insts = insts.append(ssa.frame_cell(nvals, number, site.offset));
      insts = insts.append(ssa.SInst { kind_tag: ssa.LD_AT, result: nvals + 1, args: [nvals], imm: site.offset, str: "" });
      term = ssa.STerm { ...term, value: nvals + 1 };
      nvals += 2;
    }
    blocks = blocks.append(ssa.SBlock { id: b.id, insts: insts, term: term, preds: preds });
  }
  let out: ssa.SBlock[] = [];
  for b in blocks {
    if (b.id != head.id) {
      out = out.append(b);
      continue;
    }
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      if (ins.result != site.hole) {
        insts = insts.append(ins);
        continue;
      }
      let args = ins.args;
      for s in 0..args.len() {
        if (starts[s] >= 0) {
          args = args.with(s, starts[s]);
        }
      }
      insts = insts.append(ssa.SInst { ...ins, args: args });
    }
    out = out.append(ssa.SBlock { ...b, insts: insts });
  }
  return ssa.SFunc { ...f, nvals: nvals, blocks: out };
}
