// The signatures of the builtin functions. The checker types a builtin call
// from its row, and the monomorphiser reads the result type from it.

import "./util";
import "./sysreg";
import "std/string";

// One row for each builtin, sorted by name: the name, the parameter types
// and the result type.
pub function builtin_sigs(): string[] {
  return [
    "__c_call0(usize): usize",
    "__c_call0_f32(usize): f32",
    "__c_call0_f64(usize): f64",
    "__c_call1(usize, usize): usize",
