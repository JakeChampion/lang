// The row of builtin `name`, or "" when no builtin has that name.
pub function builtin_row(name: string): string {
  let rows = builtin_sigs();
  let head = name + "(";
  let lo = 0;
  let hi = rows.len();
  while (lo < hi) {
    let mid: i32 = (lo + hi) / 2;
    if (util.str_less(rows[mid], head)) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  if (lo < rows.len() && rows[lo].starts_with(head)) {
    return rows[lo];
  }
  return "";
}

// The result type of builtin `name`, as its row spells it, or "".
pub function builtin_result(name: string): string {
  let row = builtin_row(name);
  if (row.len() == 0) {
    return "";
  }
  let close = util.index_of_sub(row, "): ");
  if (close < 0) {
    return "";
  }
  return slice_unchecked(row, close + 3, row.len()).to_owned();
}

// An intrinsic that reaches a device or raw memory: an MMIO, raw memory or
// port access, __fence, or a privileged op. No pass removes, merges or moves
// one.
pub function device_intrinsic(name: string): boolean {
  return access_width(name) > 0 || port_intrinsic(name) || name == "__fence" || privileged_intrinsic(name);
}

// A port access: __port_in8 to __port_in32 read a port, and __port_out8 to
// __port_out32 write one. Only x86-64 has an I/O port space.
pub function port_intrinsic(name: string): boolean {
  return util.has_str(["__port_in8", "__port_in16", "__port_in32", "__port_out8", "__port_out16", "__port_out32"], name);
}

// A privileged op that only a kernel environment grants. __hvc and __smc call
// the hypervisor and the secure monitor in the SMC calling convention.
// __boot_info gives the address that the loader passed to the reset entry.
// __sysreg_read and __sysreg_write access a system register. The cache ops act
// on the line that holds an address, and the TLB ops drop the translation of an
// address or of every address. The IRQ ops mask and unmask interrupts, wait
// for one with interrupts masked, and give the address of the IRQ region.
// __user_run runs the user context of a trap frame until it traps.
// __cache_sync_code makes instruction fetch see the code written to a line.
// The atomic ops access the 64-bit word at an address: an acquire load, a
// release store, and a sequentially consistent fetch-and-add and
// compare-and-swap, which give the old value. __secondary_entry gives the
// address where PSCI CPU_ON starts another core.
pub function privileged_intrinsic(name: string): boolean {
  return util.has_str(["__wfi", "__hvc", "__smc", "__boot_info", "__cache_clean", "__cache_flush", "__tlb_flush", "__tlb_flush_all", "__breakpoint", "__irq_mask", "__irq_unmask", "__irq_wait", "__irq_pending", "__user_run", "__cache_sync_code", "__atomic_load_acquire", "__atomic_store_release", "__atomic_fetch_add", "__atomic_cas", "__secondary_entry"], name) || sysreg.intrinsic(name);
}

// The bit width of an MMIO intrinsic, such as 32 for __mmio_load32, or 0 for any
// other name.
pub function mmio_width(name: string): i32 {
  if (!name.starts_with("__mmio_")) {
    return 0;
  }
  if (name == "__mmio_load8" || name == "__mmio_store8") {
    return 8;
  }
  if (name == "__mmio_load16" || name == "__mmio_store16") {
    return 16;
  }
  if (name == "__mmio_load32" || name == "__mmio_store32") {
    return 32;
  }
  if (name == "__mmio_load64" || name == "__mmio_store64") {
    return 64;
  }
  return 0;
}

// The bit width of a raw memory intrinsic, such as 32 for __mem_load32, or 0
// for any other name. The family reads and writes memory at a raw address,
// which only a kernel or a driver owns, so the `privileged` capability gates
// it (E066).
pub function mem_width(name: string): i32 {
  if (!name.starts_with("__mem_")) {
    return 0;
  }
  if (name == "__mem_load8" || name == "__mem_store8") {
    return 8;
  }
  if (name == "__mem_load16" || name == "__mem_store16") {
    return 16;
  }
  if (name == "__mem_load32" || name == "__mem_store32") {
    return 32;
  }
  if (name == "__mem_load64" || name == "__mem_store64") {
    return 64;
  }
  return 0;
}

// The bit width of an MMIO or raw memory access, or 0 for any other name.
pub function access_width(name: string): i32 {
  let w = mmio_width(name);
  if (w > 0) {
    return w;
  }
  return mem_width(name);
}

// Whether an MMIO or raw memory access is a store.
pub function access_store(name: string): boolean {
  return name.starts_with("__mmio_store") || name.starts_with("__mem_store");
}

// A task intrinsic, which lowers to a call of the runtime's `__fern_task_*`
// function of the same name.
pub function task_intrinsic(name: string): boolean {
  return util.has_str(["__task_cancelled", "__task_cur", "__task_enter", "__task_fd_gen", "__task_free", "__task_inline", "__task_leave", "__task_new", "__task_park", "__task_park_until", "__task_set_cancelled", "__task_set_ready", "__task_timeout", "__task_until", "__task_wait"], name);
}
