// The lexer's self-checks. Each check is a std/test case. A failed case
// names the condition that did not hold.

import "../lexer";
import "../util";
import "std/unicode";
import "std/utf8";
import "std/test";

function test_mixed(): test.TestOutcome {
  let src = "let x: i32 = 42i64; // a comment\nreturn x + 1.5f64;\n";
  let toks = lexer.tokenize(src);

  if (toks.len() != 13) {
    return test.fail("toks.len() != 13");
  }

  match (toks[0]) {
    lexer.TokKeyword(t) => {
      if (t.name != "let") {
        return test.fail("t.name != \"let\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[0]");
    }
  }
  match (toks[1]) {
    lexer.TokIdent(t) => {
      if (t.name != "x") {
        return test.fail("t.name != \"x\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[1]");
    }
  }
  match (toks[2]) {
    lexer.TokPunct(t) => {
      if (t.text != ":") {
        return test.fail("t.text != \":\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[2]");
    }
  }
  match (toks[3]) {
    lexer.TokKeyword(t) => {
      if (t.name != "i32") {
        return test.fail("t.name != \"i32\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[3]");
    }
  }
  match (toks[4]) {
    lexer.TokPunct(t) => {
      if (t.text != "=") {
        return test.fail("t.text != \"=\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[4]");
    }
  }
  match (toks[5]) {
    lexer.TokNumber(t) => {
      if (t.text != "42") {
        return test.fail("t.text != \"42\"");
      }
      if (t.suffix() != "i64") {
        return test.fail("t.suffix() != \"i64\"");
      }
      if (t.is_float()) {
        return test.fail("t.is_float()");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[5]");
    }
  }
  match (toks[6]) {
    lexer.TokPunct(t) => {
      if (t.text != ";") {
        return test.fail("t.text != \";\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[6]");
    }
  }
  match (toks[7]) {
    lexer.TokKeyword(t) => {
      if (t.name != "return") {
        return test.fail("t.name != \"return\"");
      }
      if (t.line != 2) {
        return test.fail("t.line != 2");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[7]");
    }
  }
  match (toks[8]) {
    lexer.TokIdent(t) => {
      if (t.name != "x") {
        return test.fail("t.name != \"x\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[8]");
    }
  }
  match (toks[9]) {
    lexer.TokPunct(t) => {
      if (t.text != "+") {
        return test.fail("t.text != \"+\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[9]");
    }
  }
  match (toks[10]) {
    lexer.TokNumber(t) => {
      if (t.text != "1.5") {
        return test.fail("t.text != \"1.5\"");
      }
      if (t.suffix() != "f64") {
        return test.fail("t.suffix() != \"f64\"");
      }
      if (!t.is_float()) {
        return test.fail("!t.is_float()");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[10]");
    }
  }
  match (toks[11]) {
    lexer.TokPunct(t) => {
      if (t.text != ";") {
        return test.fail("t.text != \";\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[11]");
    }
  }
  match (toks[12]) {
    lexer.TokEof(_) => {
      return test.pass();
    },
    _ => {
      return test.fail("unexpected variant of toks[12]");
    }
  }
}

function test_hex(): test.TestOutcome {
  let toks = lexer.tokenize("0x2A 0xff 0X0 0xDEADBEEF 0x10u8");
  if (toks.len() != 6) {
    return test.fail("toks.len() != 6");
  }
  match (toks[0]) {
    lexer.TokNumber(t) => {
      if (t.text != "0x2A") {
        return test.fail("t.text != \"0x2A\"");
      }
      if (t.is_float()) {
        return test.fail("t.is_float()");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[0]");
    }
  }
  match (toks[1]) {
    lexer.TokNumber(t) => {
      if (t.text != "0xff") {
        return test.fail("t.text != \"0xff\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[1]");
    }
  }
  match (toks[2]) {
    lexer.TokNumber(t) => {
      if (t.text != "0X0") {
        return test.fail("t.text != \"0X0\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[2]");
    }
  }
  match (toks[3]) {
    lexer.TokNumber(t) => {
      if (t.text != "0xDEADBEEF") {
        return test.fail("t.text != \"0xDEADBEEF\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[3]");
    }
  }
  match (toks[4]) {
    lexer.TokNumber(t) => {
      if (t.text != "0x10") {
        return test.fail("t.text != \"0x10\"");
      }
      if (t.suffix() != "u8") {
        return test.fail("t.suffix() != \"u8\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[4]");
    }
  }
  match (toks[5]) {
    lexer.TokEof(_) => {
      return test.pass();
    },
    _ => {
      return test.fail("unexpected variant of toks[5]");
    }
  }
}

function test_scientific(): test.TestOutcome {
  let toks = lexer.tokenize("1e3 1.5e10 1.5E3 2.0e-2 6.022e+23");
  if (toks.len() != 6) {
    return test.fail("toks.len() != 6");
  }
  match (toks[0]) {
    lexer.TokNumber(t) => {
      if (t.text != "1e3") {
        return test.fail("t.text != \"1e3\"");
      }
      if (!t.is_float()) {
        return test.fail("!t.is_float()");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[0]");
    }
  }
  match (toks[1]) {
    lexer.TokNumber(t) => {
      if (t.text != "1.5e10") {
        return test.fail("t.text != \"1.5e10\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[1]");
    }
  }
  match (toks[2]) {
    lexer.TokNumber(t) => {
      if (t.text != "1.5E3") {
        return test.fail("t.text != \"1.5E3\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[2]");
    }
  }
  match (toks[3]) {
    lexer.TokNumber(t) => {
      if (t.text != "2.0e-2") {
        return test.fail("t.text != \"2.0e-2\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[3]");
    }
  }
  match (toks[4]) {
    lexer.TokNumber(t) => {
      if (t.text != "6.022e+23") {
        return test.fail("t.text != \"6.022e+23\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[4]");
    }
  }
  return test.pass();
}

function test_bare_e(): test.TestOutcome {
  let toks = lexer.tokenize("1e foo");
  if (toks.len() != 4) {
    return test.fail("toks.len() != 4");
  }
  match (toks[0]) {
    lexer.TokNumber(t) => {
      if (t.text != "1") {
        return test.fail("t.text != \"1\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[0]");
    }
  }
  match (toks[1]) {
    lexer.TokIdent(t) => {
      if (t.name != "e") {
        return test.fail("t.name != \"e\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[1]");
    }
  }
  match (toks[2]) {
    lexer.TokIdent(t) => {
      if (t.name != "foo") {
        return test.fail("t.name != \"foo\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[2]");
    }
  }
  return test.pass();
}

function test_chained_tuple(): test.TestOutcome {
  let toks = lexer.tokenize("t.1.0");
  if (toks.len() != 6) {
    return test.fail("toks.len() != 6");
  }
  match (toks[0]) {
    lexer.TokIdent(t) => {
      if (t.name != "t") {
        return test.fail("t.name != \"t\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[0]");
    }
  }
  match (toks[1]) {
    lexer.TokPunct(t) => {
      if (t.text != ".") {
        return test.fail("t.text != \".\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[1]");
    }
  }
  match (toks[2]) {
    lexer.TokNumber(t) => {
      if (t.text != "1") {
        return test.fail("t.text != \"1\"");
      }
      if (t.is_float()) {
        return test.fail("t.is_float()");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[2]");
    }
  }
  match (toks[3]) {
    lexer.TokPunct(t) => {
      if (t.text != ".") {
        return test.fail("t.text != \".\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[3]");
    }
  }
  match (toks[4]) {
    lexer.TokNumber(t) => {
      if (t.text != "0") {
        return test.fail("t.text != \"0\"");
      }
      if (t.is_float()) {
        return test.fail("t.is_float()");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[4]");
    }
  }
  return test.pass();
}

function test_float_after_nondot(): test.TestOutcome {
  let toks = lexer.tokenize("let f = 1.5;");
  let floats = 0;
  for i in 0..toks.len() {
    match (toks[i]) {
      lexer.TokNumber(t) => {
        if (t.is_float()) {
          floats += 1;
        }
      },
      _ => {}
    }
  }
  if (floats != 1) {
    return test.fail("floats != 1");
  }
  return test.pass();
}

function test_suffix_errors(): test.TestOutcome {
  if (!lexer.has_error(lexer.tokenize("42i33"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"42i33\"))");
  }
  if (!lexer.has_error(lexer.tokenize("42i"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"42i\"))");
  }
  if (!lexer.has_error(lexer.tokenize("1.5i32"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"1.5i32\"))");
  }
  if (lexer.has_error(lexer.tokenize("42i64"))) {
    return test.fail("lexer.has_error(lexer.tokenize(\"42i64\"))");
  }
  if (lexer.has_error(lexer.tokenize("7u8"))) {
    return test.fail("lexer.has_error(lexer.tokenize(\"7u8\"))");
  }
  if (lexer.has_error(lexer.tokenize("42f32"))) {
    return test.fail("lexer.has_error(lexer.tokenize(\"42f32\"))");
  }
  if (lexer.has_error(lexer.tokenize("1.5f64"))) {
    return test.fail("lexer.has_error(lexer.tokenize(\"1.5f64\"))");
  }
  return test.pass();
}

function test_hex_needs_digits(): test.TestOutcome {
  if (!lexer.has_error(lexer.tokenize("0x"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"0x\"))");
  }
  if (lexer.has_error(lexer.tokenize("0x1"))) {
    return test.fail("lexer.has_error(lexer.tokenize(\"0x1\"))");
  }
  return test.pass();
}

function test_string_errors(): test.TestOutcome {
  if (!lexer.has_error(lexer.tokenize("\"oops"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"\\\"oops\"))");
  }
  if (!lexer.has_error(lexer.tokenize("\"a\\zb\""))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"\\\"a\\\\zb\\\"\"))");
  }
  if (!lexer.has_error(lexer.tokenize("\"with\nnewline\""))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"\\\"with\\nnewline\\\"\"))");
  }
  if (lexer.has_error(lexer.tokenize("\"ok\""))) {
    return test.fail("lexer.has_error(lexer.tokenize(\"\\\"ok\\\"\"))");
  }
  return test.pass();
}

function lex_error_is(src: string, msg: string, code: string): boolean {
  let toks = lexer.tokenize(src);
  if let lexer.TokError(e) = toks[toks.len() - 1] {
    return e.msg == msg && e.code == code;
  }
  return false;
}

function test_unknown_char(): test.TestOutcome {
  if (!lex_error_is("$", "unexpected character '$'", "P001")) {
    return test.fail("!lex_error_is(\"$\", \"unexpected character '$'\", \"P001\")");
  }
  if (lexer.has_error(lexer.tokenize("@"))) {
    return test.fail("lexer.has_error(lexer.tokenize(\"@\"))");
  }
  if (!lex_error_is("a # b", "unexpected character '#'", "P001")) {
    return test.fail("!lex_error_is(\"a # b\", \"unexpected character '#'\", \"P001\")");
  }
  if (!lex_error_is("`", "unexpected character '`'", "P001")) {
    return test.fail("!lex_error_is(\"`\", \"unexpected character '`'\", \"P001\")");
  }
  if (lexer.has_error(lexer.tokenize("~x"))) {
    return test.fail("lexer.has_error(lexer.tokenize(\"~x\"))");
  }
  if (!lex_error_is("\\", "unexpected character '\\\\'", "P001")) {
    return test.fail("!lex_error_is(\"\\\\\", \"unexpected character '\\\\\\\\'\", \"P001\")");
  }
  if (!lex_error_is("x §", "unexpected character '§'", "P001")) {
    return test.fail("!lex_error_is(\"x §\", \"unexpected character '§'\", \"P001\")");
  }
  if (!lex_error_is("\x01", "unexpected character '\\x01'", "P001")) {
    return test.fail("!lex_error_is(\"\\x01\", \"unexpected character '\\\\x01'\", \"P001\")");
  }
  let invalid = "";
  unsafe {
    invalid = string_from_bytes_unchecked([97 as u8, 32 as u8, 255 as u8]);
  }
  if (!lex_error_is(invalid, "invalid UTF-8 byte 0xFF", "P001")) {
    return test.fail("!lex_error_is(invalid, \"invalid UTF-8 byte 0xFF\", \"P001\")");
  }
  if (!lex_error_is("é", "identifiers must be ASCII; found 'é'", "P001")) {
    return test.fail("!lex_error_is(\"é\", \"identifiers must be ASCII; found 'é'\", \"P001\")");
  }
  if (!lex_error_is("١", "identifiers must be ASCII; found '١'", "P001")) {
    return test.fail("!lex_error_is(\"١\", \"identifiers must be ASCII; found '١'\", \"P001\")");
  }
  if (!lex_error_is("42i33", "unknown numeric suffix \"i33\" on \"42\"", "P002")) {
    return test.fail("!lex_error_is(\"42i33\", \"unknown numeric suffix \\\"i33\\\" on \\\"42\\\"\", \"P002\")");
  }
  if (!lex_error_is("1.5i32", "integer suffix \"i32\" on float literal \"1.5\"", "P002")) {
    return test.fail("!lex_error_is(\"1.5i32\", \"integer suffix \\\"i32\\\" on float literal \\\"1.5\\\"\", \"P002\")");
  }
  if (!lex_error_is("0o19", "invalid digit '9' in a 0o literal", "P002")) {
    return test.fail("!lex_error_is(\"0o19\", \"invalid digit '9' in a 0o literal\", \"P002\")");
  }
  if (!lex_error_is("\"a\\qb\"", "unknown escape \\q in string literal", "P001")) {
    return test.fail("!lex_error_is(\"\\\"a\\\\qb\\\"\", \"unknown escape \\\\q in string literal\", \"P001\")");
  }
  if (!lex_error_is("f\"a\\qb\"", "unknown escape \\q in f-string literal", "P001")) {
    return test.fail("!lex_error_is(\"f\\\"a\\\\qb\\\"\", \"unknown escape \\\\q in f-string literal\", \"P001\")");
  }
  if (!lex_error_is("'\\xFF'", "\\xFF is above ASCII in a character literal; write \\u{FF} for the scalar", "P001")) {
    return test.fail("!lex_error_is(\"'\\\\xFF'\", \"\\\\xFF is above ASCII in a character literal; write \\\\u{FF} for the scalar\", \"P001\")");
  }
  if (!lex_error_is("\"\\xff\"", "\\xFF is above ASCII in a string literal; write \\u{FF} for the scalar", "P001")) {
    return test.fail("!lex_error_is(\"\\\"\\\\xff\\\"\", \"\\\\xFF is above ASCII in a string literal; write \\\\u{FF} for the scalar\", \"P001\")");
  }
  if (!lex_error_is("f\"\\x80{x}\"", "\\x80 is above ASCII in an f-string literal; write \\u{80} for the scalar", "P001")) {
    return test.fail("!lex_error_is(\"f\\\"\\\\x80{x}\\\"\", \"\\\\x80 is above ASCII in an f-string literal; write \\\\u{80} for the scalar\", \"P001\")");
  }
  if (!lex_error_is("\"\\u{D800}\"", "\\u{D800} is a surrogate, not a Unicode scalar value", "P001")) {
    return test.fail("!lex_error_is(\"\\\"\\\\u{D800}\\\"\", \"\\\\u{D800} is a surrogate, not a Unicode scalar value\", \"P001\")");
  }
  if (!lex_error_is("\"\\u{110000}\"", "\\u{110000} is above the maximum Unicode scalar 10FFFF", "P001")) {
    return test.fail("!lex_error_is(\"\\\"\\\\u{110000}\\\"\", \"\\\\u{110000} is above the maximum Unicode scalar 10FFFF\", \"P001\")");
  }
  if (!lex_error_is("f\"\\u{1F600\"", "unterminated \\u{...} escape", "P001")) {
    return test.fail("!lex_error_is(\"f\\\"\\\\u{1F600\\\"\", \"unterminated \\\\u{...} escape\", \"P001\")");
  }
  if (!lex_error_is("'\\q'", "unknown escape \\q in character literal", "P001")) {
    return test.fail("!lex_error_is(\"'\\\\q'\", \"unknown escape \\\\q in character literal\", \"P001\")");
  }
  return test.pass();
}

function string_is(src: string, want: string): boolean {
  let t = lexer.tokenize(src);
  if (t.len() != 2) {
    return false;
  }
  if let lexer.TokString(x) = t[0] {
    return x.value == want;
  }
  return false;
}

function test_string_escapes(): test.TestOutcome {
  if (!string_is("\"a\\x41\\x7f\"", "aA\x7f")) {
    return test.fail("!string_is(\"\\\"a\\\\x41\\\\x7f\\\"\", \"aA\\x7f\")");
  }
  if (!string_is("\"\\0\\'\\\"\\\\\"", "\x00'\"\\")) {
    return test.fail("!string_is(\"\\\"\\\\0\\\\'\\\\\\\"\\\\\\\\\\\"\", \"\\x00'\\\"\\\\\")");
  }
  let top = "";
  unsafe {
    top = string_from_bytes_unchecked([244 as u8, 143 as u8, 191 as u8, 191 as u8]);
  }
  if (!string_is("\"\\u{41}\\u{e9}\\u{20AC}\\u{1F600}\\u{10FFFF}\"", "Aé€😀" + top)) {
    return test.fail("!string_is(\"\\\"\\\\u{41}\\\\u{e9}\\\\u{20AC}\\\\u{1F600}\\\\u{10FFFF}\\\"\", \"Aé€😀\" + top)");
  }
  let edges = "";
  unsafe {
    edges = string_from_bytes_unchecked([237 as u8, 159 as u8, 191 as u8, 238 as u8, 128 as u8, 128 as u8]);
  }
  if (!string_is("\"\\u{D7FF}\\u{E000}\"", edges)) {
    return test.fail("!string_is(\"\\\"\\\\u{D7FF}\\\\u{E000}\\\"\", edges)");
  }
  let ft = lexer.tokenize("f\"\\u{1F600}{x}\\u{7B}\"");
  if let lexer.TokFString(f) = ft[0] {
    if (f.parts.len() != 3 || f.parts[0].lit != "😀" || f.parts[1].expr != "x" || f.parts[2].lit != "{") {
      return test.fail("f.parts.len() != 3 || f.parts[0].lit != \"😀\" || f.parts[1].expr != \"x\" || f.parts[2].lit != \"{\"");
    }
  } else {
    return test.fail("ft[0] is not an f-string token");
  }
  return test.pass();
}

function check_quoted(src: string, want_text: string, want_suffix: string): boolean {
  let t = lexer.tokenize(src);
  if (t.len() != 2) {
    return false;
  }
  match (t[0]) {
    lexer.TokNumber(n) => {
      return n.text == want_text && n.suffix() == want_suffix
        && n.raw == src && !n.is_float();
    },
    _ => {
      return false;
    }
  }
}

function test_quoted_literals(): test.TestOutcome {
  if (!check_quoted("'x'", "120", "char")) {
    return test.fail("!check_quoted(\"'x'\", \"120\", \"char\")");
  }
  if (!check_quoted("'['", "91", "char")) {
    return test.fail("!check_quoted(\"'['\", \"91\", \"char\")");
  }
  if (!check_quoted("'\\n'", "10", "char")) {
    return test.fail("!check_quoted(\"'\\\\n'\", \"10\", \"char\")");
  }
  if (!check_quoted("'\\0'", "0", "char")) {
    return test.fail("!check_quoted(\"'\\\\0'\", \"0\", \"char\")");
  }
  if (!check_quoted("'\\''", "39", "char")) {
    return test.fail("!check_quoted(\"'\\\\''\", \"39\", \"char\")");
  }
  if (!check_quoted("'\\\\'", "92", "char")) {
    return test.fail("!check_quoted(\"'\\\\\\\\'\", \"92\", \"char\")");
  }
  if (!check_quoted("'\\x7F'", "127", "char")) {
    return test.fail("!check_quoted(\"'\\\\x7F'\", \"127\", \"char\")");
  }
  if (!check_quoted("'\\u{41}'", "65", "char")) {
    return test.fail("!check_quoted(\"'\\\\u{41}'\", \"65\", \"char\")");
  }
  if (!check_quoted("'\\u{1F600}'", "128512", "char")) {
    return test.fail("!check_quoted(\"'\\\\u{1F600}'\", \"128512\", \"char\")");
  }
  if (!check_quoted("'\\u{10FFFF}'", "1114111", "char")) {
    return test.fail("!check_quoted(\"'\\\\u{10FFFF}'\", \"1114111\", \"char\")");
  }
  if (!check_quoted("'😀'", "128512", "char")) {
    return test.fail("!check_quoted(\"'😀'\", \"128512\", \"char\")");
  }
  if (!check_quoted("'é'", "233", "char")) {
    return test.fail("!check_quoted(\"'é'\", \"233\", \"char\")");
  }
  if (!check_quoted("b'x'", "120", "u8")) {
    return test.fail("!check_quoted(\"b'x'\", \"120\", \"u8\")");
  }
  if (!check_quoted("b'['", "91", "u8")) {
    return test.fail("!check_quoted(\"b'['\", \"91\", \"u8\")");
  }
  if (!check_quoted("b'\\n'", "10", "u8")) {
    return test.fail("!check_quoted(\"b'\\\\n'\", \"10\", \"u8\")");
  }
  if (!check_quoted("b'\\xFF'", "255", "u8")) {
    return test.fail("!check_quoted(\"b'\\\\xFF'\", \"255\", \"u8\")");
  }

  if (!lexer.has_error(lexer.tokenize("''"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"''\"))");
  }
  if (!lexer.has_error(lexer.tokenize("b''"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"b''\"))");
  }
  if (!lexer.has_error(lexer.tokenize("'ab'"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"'ab'\"))");
  }
  if (!lexer.has_error(lexer.tokenize("b'ab'"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"b'ab'\"))");
  }
  if (!lexer.has_error(lexer.tokenize("'a"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"'a\"))");
  }
  if (!lexer.has_error(lexer.tokenize("b'é'"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"b'é'\"))");
  }
  if (!lexer.has_error(lexer.tokenize("b'\\u{41}'"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"b'\\\\u{41}'\"))");
  }
  if (!lexer.has_error(lexer.tokenize("'\\u{D800}'"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"'\\\\u{D800}'\"))");
  }
  if (!lexer.has_error(lexer.tokenize("'\\u{110000}'"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"'\\\\u{110000}'\"))");
  }
  if (!lexer.has_error(lexer.tokenize("'\\xFF'"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"'\\\\xFF'\"))");
  }
  if (!lexer.has_error(lexer.tokenize("'\\q'"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"'\\\\q'\"))");
  }
  if (!lexer.has_error(lexer.tokenize("'\n'"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"'\\n'\"))");
  }

  let idt = lexer.tokenize("b bytes");
  match (idt[0]) {
    lexer.TokIdent(x) => {
      if (x.name != "b") {
        return test.fail("x.name != \"b\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of idt[0]");
    }
  }
  match (idt[1]) {
    lexer.TokIdent(x) => {
      if (x.name != "bytes") {
        return test.fail("x.name != \"bytes\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of idt[1]");
    }
  }
  return test.pass();
}

function check_part(p: lexer.FStringPart, want_expr: boolean, want_text: string, want_line: i32, want_col: i32): boolean {
  if (p.is_expr != want_expr) {
    return false;
  }
  if (p.line != want_line || p.col != want_col) {
    return false;
  }
  if (want_expr) {
    return p.expr == want_text;
  }
  return p.lit == want_text;
}

function test_fstring(): test.TestOutcome {
  let t0 = lexer.tokenize("f\"\"");
  if (t0.len() != 2) {
    return test.fail("t0.len() != 2");
  }
  match (t0[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 0) {
        return test.fail("f.parts.len() != 0");
      }
    },
    _ => {
      return test.fail("unexpected variant of t0[0]");
    }
  }
  let t1 = lexer.tokenize("f\"plain\"");
  match (t1[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 1) {
        return test.fail("f.parts.len() != 1");
      }
      if (!check_part(f.parts[0], false, "plain", 0, 0)) {
        return test.fail("!check_part(f.parts[0], false, \"plain\", 0, 0)");
      }
    },
    _ => {
      return test.fail("unexpected variant of t1[0]");
    }
  }
  let t2 = lexer.tokenize("f\"a{x}b\"");
  match (t2[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 3) {
        return test.fail("f.parts.len() != 3");
      }
      if (!check_part(f.parts[0], false, "a", 0, 0)) {
        return test.fail("!check_part(f.parts[0], false, \"a\", 0, 0)");
      }
      if (!check_part(f.parts[1], true, "x", 1, 5)) {
        return test.fail("!check_part(f.parts[1], true, \"x\", 1, 5)");
      }
      if (!check_part(f.parts[2], false, "b", 0, 0)) {
        return test.fail("!check_part(f.parts[2], false, \"b\", 0, 0)");
      }
    },
    _ => {
      return test.fail("unexpected variant of t2[0]");
    }
  }
  let t3 = lexer.tokenize("f\"{{lit}}\"");
  match (t3[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 1) {
        return test.fail("f.parts.len() != 1");
      }
      if (!check_part(f.parts[0], false, "{lit}", 0, 0)) {
        return test.fail("!check_part(f.parts[0], false, \"{lit}\", 0, 0)");
      }
    },
    _ => {
      return test.fail("unexpected variant of t3[0]");
    }
  }
  let t4 = lexer.tokenize("f\"k={\"x\"}\"");
  match (t4[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 2) {
        return test.fail("f.parts.len() != 2");
      }
      if (!check_part(f.parts[0], false, "k=", 0, 0)) {
        return test.fail("!check_part(f.parts[0], false, \"k=\", 0, 0)");
      }
      if (!check_part(f.parts[1], true, "\"x\"", 1, 6)) {
        return test.fail("!check_part(f.parts[1], true, \"\\\"x\\\"\", 1, 6)");
      }
    },
    _ => {
      return test.fail("unexpected variant of t4[0]");
    }
  }
  let t5 = lexer.tokenize("f\"sum {a + b}\"");
  match (t5[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 2) {
        return test.fail("f.parts.len() != 2");
      }
      if (!check_part(f.parts[0], false, "sum ", 0, 0)) {
        return test.fail("!check_part(f.parts[0], false, \"sum \", 0, 0)");
      }
      if (!check_part(f.parts[1], true, "a + b", 1, 8)) {
        return test.fail("!check_part(f.parts[1], true, \"a + b\", 1, 8)");
      }
    },
    _ => {
      return test.fail("unexpected variant of t5[0]");
    }
  }
  let t6 = lexer.tokenize("f\"hi\\nthere\"");
  match (t6[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 1) {
        return test.fail("f.parts.len() != 1");
      }
      if (!check_part(f.parts[0], false, "hi\nthere", 0, 0)) {
        return test.fail("!check_part(f.parts[0], false, \"hi\\nthere\", 0, 0)");
      }
    },
    _ => {
      return test.fail("unexpected variant of t6[0]");
    }
  }
  if (!lexer.has_error(lexer.tokenize("f\"unterminated"))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"f\\\"unterminated\"))");
  }
  if (!lexer.has_error(lexer.tokenize("f\"with\nnewline\""))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"f\\\"with\\nnewline\\\"\"))");
  }
  if (!lexer.has_error(lexer.tokenize("f\"bare}brace\""))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"f\\\"bare}brace\\\"\"))");
  }
  if (!lexer.has_error(lexer.tokenize("f\"empty{}\""))) {
    return test.fail("!lexer.has_error(lexer.tokenize(\"f\\\"empty{}\\\"\"))");
  }
  return test.pass();
}

function test_fstring_positions(): test.TestOutcome {
  let t = lexer.tokenize("let s = f\"a{aaa} b{bbb}\";");
  match (t[3]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 4) {
        return test.fail("f.parts.len() != 4");
      }
      if (!check_part(f.parts[1], true, "aaa", 1, 13)) {
        return test.fail("!check_part(f.parts[1], true, \"aaa\", 1, 13)");
      }
      if (!check_part(f.parts[3], true, "bbb", 1, 20)) {
        return test.fail("!check_part(f.parts[3], true, \"bbb\", 1, 20)");
      }
    },
    _ => {
      return test.fail("unexpected variant of t[3]");
    }
  }
  match (lexer.tokenize("let a = 1;\nlet s = f\"x{yy}\";")[8]) {
    lexer.TokFString(f) => {
      if (!check_part(f.parts[1], true, "yy", 2, 13)) {
        return test.fail("!check_part(f.parts[1], true, \"yy\", 2, 13)");
      }
    },
    _ => {
      return test.fail("unexpected variant of lexer.tokenize(\"let a = 1;\\nlet s = f\\\"x{yy}\\\";\")[8]");
    }
  }
  let sub = lexer.rebase_tokens(lexer.tokenize("a\nb"), 4, 10);
  match (sub[0]) {
    lexer.TokIdent(x) => {
      if (x.line != 4 || x.col != 10) {
        return test.fail("x.line != 4 || x.col != 10");
      }
    },
    _ => {
      return test.fail("unexpected variant of sub[0]");
    }
  }
  match (sub[1]) {
    lexer.TokIdent(x) => {
      if (x.line != 5 || x.col != 1) {
        return test.fail("x.line != 5 || x.col != 1");
      }
    },
    _ => {
      return test.fail("unexpected variant of sub[1]");
    }
  }
  return test.pass();
}

function check_comment(c: lexer.Comment, line: i32, col: i32, text: string): boolean {
  return c.line == line && c.col == col && c.text == text;
}

function test_comments(): test.TestOutcome {
  let src = "// leading\nlet u: string = \"http://x//y\"; // trailing\nlet n: i32 = 1;\n//: last\n";
  let r = lexer.tokenize_full(src);
  if (r.comments.len() != 3) {
    return test.fail("r.comments.len() != 3");
  }
  if (!check_comment(r.comments[0], 1, 1, " leading")) {
    return test.fail("!check_comment(r.comments[0], 1, 1, \" leading\")");
  }
  if (!check_comment(r.comments[1], 2, 32, " trailing")) {
    return test.fail("!check_comment(r.comments[1], 2, 32, \" trailing\")");
  }
  if (!check_comment(r.comments[2], 4, 1, ": last")) {
    return test.fail("!check_comment(r.comments[2], 4, 1, \": last\")");
  }
  if (r.tokens.len() != lexer.tokenize(src).len()) {
    return test.fail("r.tokens.len() != lexer.tokenize(src).len()");
  }
  if (lexer.tokenize_full("let x: i32 = 1;\n").comments.len() != 0) {
    return test.fail("lexer.tokenize_full(\"let x: i32 = 1;\\n\").comments.len() != 0");
  }
  if (lexer.tokenize_full("// kept\nlet s: string = \"oops\n").comments.len() != 1) {
    return test.fail("lexer.tokenize_full(\"// kept\\nlet s: string = \\\"oops\\n\").comments.len() != 1");
  }
  let tail = lexer.tokenize_full("let x: i32 = 1; // tail");
  if (tail.comments.len() != 1 || !check_comment(tail.comments[0], 1, 17, " tail")) {
    return test.fail("tail.comments.len() != 1 || !check_comment(tail.comments[0], 1, 17, \" tail\")");
  }
  return test.pass();
}

function test_multibyte(): test.TestOutcome {
  let src = "let s: string = \"héllo wörld\"; s <<= 1; // cömment é\nlet f = f\"pré {s} pöst\";\n";
  let r = lexer.tokenize_full(src);
  let toks = r.tokens;
  if (toks.len() != 17) {
    return test.fail("toks.len() != 17");
  }
  match (toks[5]) {
    lexer.TokString(t) => {
      if (t.value != "héllo wörld") {
        return test.fail("t.value != \"héllo wörld\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[5]");
    }
  }
  match (toks[8]) {
    lexer.TokPunct(t) => {
      if (t.text != "<<=") {
        return test.fail("t.text != \"<<=\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[8]");
    }
  }
  match (toks[14]) {
    lexer.TokFString(t) => {
      if (t.parts.len() != 3) {
        return test.fail("t.parts.len() != 3");
      }
      if (t.parts[0].lit != "pré ") {
        return test.fail("t.parts[0].lit != \"pré \"");
      }
      if (t.parts[1].expr != "s") {
        return test.fail("t.parts[1].expr != \"s\"");
      }
      if (t.parts[2].lit != " pöst") {
        return test.fail("t.parts[2].lit != \" pöst\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of toks[14]");
    }
  }
  if (r.comments.len() != 1) {
    return test.fail("r.comments.len() != 1");
  }
  if (r.comments[0].text != " cömment é") {
    return test.fail("r.comments[0].text != \" cömment é\"");
  }
  let t2 = lexer.tokenize("a<é");
  if (t2.len() != 3) {
    return test.fail("t2.len() != 3");
  }
  match (t2[1]) {
    lexer.TokPunct(t) => {
      if (t.text != "<") {
        return test.fail("t.text != \"<\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of t2[1]");
    }
  }
  match (t2[2]) {
    lexer.TokError(t) => {
      if (t.msg != "identifiers must be ASCII; found 'é'") {
        return test.fail("t.msg != \"identifiers must be ASCII; found 'é'\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of t2[2]");
    }
  }
  return test.pass();
}

function test_numeric_flags(): test.TestOutcome {
  let src = "1 1i32 2i64 3u8 4u32 5u64 6usize 7f32 8f64 'A' b'A' 18446744073709551615u64 340282366920938463463374607431768211455";
  let suffixes: string[] = ["", "i32", "i64", "u8", "u32", "u64", "usize", "f32", "f64", "char", "u8", "u64", ""];
  let toks = lexer.rebase_tokens(lexer.tokenize(src), 4, 10);
  if (toks.len() != suffixes.len() + 1) {
    return test.fail("toks.len() != suffixes.len() + 1");
  }
  for i in 0..suffixes.len() {
    match (toks[i]) {
      lexer.TokNumber(t) => {
        if (t.suffix() != suffixes[i] || t.is_float() != (i == 7 || i == 8) || t.line != 4 || t.col < 10) {
          return test.fail("t.suffix() != suffixes[i] || t.is_float() != (i == 7 || i == 8) || t.line != 4 || t.col < 10");
        }
        if (i == 11 && t.text != "18446744073709551615" || i == 12 && t.text != "340282366920938463463374607431768211455") {
          return test.fail("i == 11 && t.text != \"18446744073709551615\" || i == 12 && t.text != \"340282366920938463463374607431768211455\"");
        }
      },
      _ => {
        return test.fail("unexpected variant of toks[i]");
      }
    }
  }
  return test.pass();
}

function test_string_scan_boundaries(): test.TestOutcome {
  let text = "";
  let prefix = "";
  for n in 0..81 {
    let src = prefix + "\"" + text + "é\\n\\\"\\u{1F600}" + text + "\";";
    let toks = lexer.tokenize(src);
    if (toks.len() != 3) {
      return test.fail("toks.len() != 3");
    }
    match (toks[0]) {
      lexer.TokString(t) => {
        if (t.value != text + "é\n\"😀" + text || t.line != 1 || t.col != n + 1) {
          return test.fail("t.value != text + \"é\\n\\\"😀\" + text || t.line != 1 || t.col != n + 1");
        }
      },
      _ => {
        return test.fail("unexpected variant of toks[0]");
      }
    }
    match (toks[1]) {
      lexer.TokPunct(t) => {
        if (t.text != ";" || t.col != src.len()) {
          return test.fail("t.text != \";\" || t.col != src.len()");
        }
      },
      _ => {
        return test.fail("unexpected variant of toks[1]");
      }
    }
    if (!lexer.has_error(lexer.tokenize("\"" + text + "\n"))) {
      return test.fail("!lexer.has_error(lexer.tokenize(\"\\\"\" + text + \"\\n\"))");
    }
    if (!lexer.has_error(lexer.tokenize("\"" + text))) {
      return test.fail("!lexer.has_error(lexer.tokenize(\"\\\"\" + text))");
    }
    text += "x";
    prefix += " ";
  }
  return test.pass();
}

function test_source_decoding(): test.TestOutcome {
  match (lexer.decode_source([47 as u8, 47 as u8, 10 as u8, 32 as u8, 255 as u8])) {
    Ok(_) => {
      return test.fail("unexpected variant of lexer.decode_source([47 as u8, 47 as u8, 10 as u8, 32 as u8, 255 as u8])");
    },
    Err(e) => {
      if (e.line != 2 || e.col != 2 || e.code != "P001" || e.msg != "invalid UTF-8 byte 0xFF") {
        return test.fail("e.line != 2 || e.col != 2 || e.code != \"P001\" || e.msg != \"invalid UTF-8 byte 0xFF\"");
      }
    }
  }
  match (lexer.decode_source([195 as u8, 169 as u8])) {
    Ok(text) => {
      if (text != "é") {
        return test.fail("text != \"é\"");
      }
    },
    Err(_) => {
      return test.fail("unexpected variant of lexer.decode_source([195 as u8, 169 as u8])");
    }
  }
  return test.pass();
}

function main(): i32 {
  let r = test.new("lexer");
  r = r.it("numeric flags", test_numeric_flags);
  r = r.it("string scan boundaries", test_string_scan_boundaries);
  r = r.it("mixed", test_mixed);
  r = r.it("hex", test_hex);
  r = r.it("scientific", test_scientific);
  r = r.it("bare e", test_bare_e);
  r = r.it("chained tuple", test_chained_tuple);
  r = r.it("float after nondot", test_float_after_nondot);
  r = r.it("suffix errors", test_suffix_errors);
  r = r.it("hex needs digits", test_hex_needs_digits);
  r = r.it("string errors", test_string_errors);
  r = r.it("unknown char", test_unknown_char);
  r = r.it("quoted literals", test_quoted_literals);
  r = r.it("string escapes", test_string_escapes);
  r = r.it("fstring", test_fstring);
  r = r.it("fstring positions", test_fstring_positions);
  r = r.it("comments", test_comments);
  r = r.it("multibyte", test_multibyte);
  r = r.it("source decoding", test_source_decoding);
  return r.finish();
}
