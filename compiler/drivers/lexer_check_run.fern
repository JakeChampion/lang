// The lexer's self-checks. Each check returns 0, or the number of the
// assertion that failed.

import "../lexer";
import "../util";
import "std/unicode";
import "std/utf8";

function test_mixed(): i32 {
  let src = "let x: i32 = 42i64; // a comment\nreturn x + 1.5f64;\n";
  let toks = lexer.tokenize(src);

  if (toks.len() != 13) {
    return 1;
  }

  match (toks[0]) {
    lexer.TokKeyword(t) => {
      if (t.name != "let") {
        return 100;
      }
    },
    _ => {
      return 101;
    }
  }
  match (toks[1]) {
    lexer.TokIdent(t) => {
      if (t.name != "x") {
        return 200;
      }
    },
    _ => {
      return 201;
    }
  }
  match (toks[2]) {
    lexer.TokPunct(t) => {
      if (t.text != ":") {
        return 300;
      }
    },
    _ => {
      return 301;
    }
  }
  match (toks[3]) {
    lexer.TokKeyword(t) => {
      if (t.name != "i32") {
        return 400;
      }
    },
    _ => {
      return 401;
    }
  }
  match (toks[4]) {
    lexer.TokPunct(t) => {
      if (t.text != "=") {
        return 500;
      }
    },
    _ => {
      return 501;
    }
  }
  match (toks[5]) {
    lexer.TokNumber(t) => {
      if (t.text != "42") {
        return 600;
      }
      if (t.suffix() != "i64") {
        return 601;
      }
      if (t.is_float()) {
        return 602;
      }
    },
    _ => {
      return 603;
    }
  }
  match (toks[6]) {
    lexer.TokPunct(t) => {
      if (t.text != ";") {
        return 700;
      }
    },
    _ => {
      return 701;
    }
  }
  match (toks[7]) {
    lexer.TokKeyword(t) => {
      if (t.name != "return") {
        return 800;
      }
      if (t.line != 2) {
        return 801;
      }
    },
    _ => {
      return 802;
    }
  }
  match (toks[8]) {
    lexer.TokIdent(t) => {
      if (t.name != "x") {
        return 900;
      }
    },
    _ => {
      return 901;
    }
  }
  match (toks[9]) {
    lexer.TokPunct(t) => {
      if (t.text != "+") {
        return 1000;
      }
    },
    _ => {
      return 1001;
    }
  }
  match (toks[10]) {
    lexer.TokNumber(t) => {
      if (t.text != "1.5") {
        return 1100;
      }
      if (t.suffix() != "f64") {
        return 1101;
      }
      if (!t.is_float()) {
        return 1102;
      }
    },
    _ => {
      return 1103;
    }
  }
  match (toks[11]) {
    lexer.TokPunct(t) => {
      if (t.text != ";") {
        return 1200;
      }
    },
    _ => {
      return 1201;
    }
  }
  match (toks[12]) {
    lexer.TokEof(_) => {
      return 0;
    },
    _ => {
      return 1300;
    }
  }
}

function test_hex(): i32 {
  let toks = lexer.tokenize("0x2A 0xff 0X0 0xDEADBEEF 0x10u8");
  if (toks.len() != 6) {
    return 1400;
  }
  match (toks[0]) {
    lexer.TokNumber(t) => {
      if (t.text != "0x2A") {
        return 1401;
      }
      if (t.is_float()) {
        return 1402;
      }
    },
    _ => {
      return 1403;
    }
  }
  match (toks[1]) {
    lexer.TokNumber(t) => {
      if (t.text != "0xff") {
        return 1404;
      }
    },
    _ => {
      return 1405;
    }
  }
  match (toks[2]) {
    lexer.TokNumber(t) => {
      if (t.text != "0X0") {
        return 1406;
      }
    },
    _ => {
      return 1407;
    }
  }
  match (toks[3]) {
    lexer.TokNumber(t) => {
      if (t.text != "0xDEADBEEF") {
        return 1408;
      }
    },
    _ => {
      return 1409;
    }
  }
  match (toks[4]) {
    lexer.TokNumber(t) => {
      if (t.text != "0x10") {
        return 1410;
      }
      if (t.suffix() != "u8") {
        return 1411;
      }
    },
    _ => {
      return 1412;
    }
  }
  match (toks[5]) {
    lexer.TokEof(_) => {
      return 0;
    },
    _ => {
      return 1413;
    }
  }
}

function test_scientific(): i32 {
  let toks = lexer.tokenize("1e3 1.5e10 1.5E3 2.0e-2 6.022e+23");
  if (toks.len() != 6) {
    return 1500;
  }
  match (toks[0]) {
    lexer.TokNumber(t) => {
      if (t.text != "1e3") {
        return 1501;
      }
      if (!t.is_float()) {
        return 1502;
      }
    },
    _ => {
      return 1503;
    }
  }
  match (toks[1]) {
    lexer.TokNumber(t) => {
      if (t.text != "1.5e10") {
        return 1504;
      }
    },
    _ => {
      return 1505;
    }
  }
  match (toks[2]) {
    lexer.TokNumber(t) => {
      if (t.text != "1.5E3") {
        return 1506;
      }
    },
    _ => {
      return 1507;
    }
  }
  match (toks[3]) {
    lexer.TokNumber(t) => {
      if (t.text != "2.0e-2") {
        return 1508;
      }
    },
    _ => {
      return 1509;
    }
  }
  match (toks[4]) {
    lexer.TokNumber(t) => {
      if (t.text != "6.022e+23") {
        return 1510;
      }
    },
    _ => {
      return 1511;
    }
  }
  return 0;
}

function test_bare_e(): i32 {
  let toks = lexer.tokenize("1e foo");
  if (toks.len() != 4) {
    return 1550;
  }
  match (toks[0]) {
    lexer.TokNumber(t) => {
      if (t.text != "1") {
        return 1551;
      }
    },
    _ => {
      return 1552;
    }
  }
  match (toks[1]) {
    lexer.TokIdent(t) => {
      if (t.name != "e") {
        return 1553;
      }
    },
    _ => {
      return 1554;
    }
  }
  match (toks[2]) {
    lexer.TokIdent(t) => {
      if (t.name != "foo") {
        return 1555;
      }
    },
    _ => {
      return 1556;
    }
  }
  return 0;
}

function test_chained_tuple(): i32 {
  let toks = lexer.tokenize("t.1.0");
  if (toks.len() != 6) {
    return 1600;
  }
  match (toks[0]) {
    lexer.TokIdent(t) => {
      if (t.name != "t") {
        return 1601;
      }
    },
    _ => {
      return 1602;
    }
  }
  match (toks[1]) {
    lexer.TokPunct(t) => {
      if (t.text != ".") {
        return 1603;
      }
    },
    _ => {
      return 1604;
    }
  }
  match (toks[2]) {
    lexer.TokNumber(t) => {
      if (t.text != "1") {
        return 1605;
      }
      if (t.is_float()) {
        return 1606;
      }
    },
    _ => {
      return 1607;
    }
  }
  match (toks[3]) {
    lexer.TokPunct(t) => {
      if (t.text != ".") {
        return 1608;
      }
    },
    _ => {
      return 1609;
    }
  }
  match (toks[4]) {
    lexer.TokNumber(t) => {
      if (t.text != "0") {
        return 1610;
      }
      if (t.is_float()) {
        return 1611;
      }
    },
    _ => {
      return 1612;
    }
  }
  return 0;
}

function test_float_after_nondot(): i32 {
  let toks = lexer.tokenize("let f = 1.5;");
  let floats = 0;
  let i = 0;
  while (i < toks.len()) {
    match (toks[i]) {
      lexer.TokNumber(t) => {
        if (t.is_float()) {
          floats += 1;
        }
      },
      _ => {}
    }
    i += 1;
  }
  if (floats != 1) {
    return 1650;
  }
  return 0;
}

function test_suffix_errors(): i32 {
  if (!lexer.has_error(lexer.tokenize("42i33"))) {
    return 1700;
  }
  if (!lexer.has_error(lexer.tokenize("42i"))) {
    return 1701;
  }
  if (!lexer.has_error(lexer.tokenize("1.5i32"))) {
    return 1702;
  }
  if (lexer.has_error(lexer.tokenize("42i64"))) {
    return 1703;
  }
  if (lexer.has_error(lexer.tokenize("7u8"))) {
    return 1704;
  }
  if (lexer.has_error(lexer.tokenize("42f32"))) {
    return 1705;
  }
  if (lexer.has_error(lexer.tokenize("1.5f64"))) {
    return 1706;
  }
  return 0;
}

function test_hex_needs_digits(): i32 {
  if (!lexer.has_error(lexer.tokenize("0x"))) {
    return 1800;
  }
  if (lexer.has_error(lexer.tokenize("0x1"))) {
    return 1801;
  }
  return 0;
}

function test_string_errors(): i32 {
  if (!lexer.has_error(lexer.tokenize("\"oops"))) {
    return 1850;
  }
  if (!lexer.has_error(lexer.tokenize("\"a\\zb\""))) {
    return 1851;
  }
  if (!lexer.has_error(lexer.tokenize("\"with\nnewline\""))) {
    return 1852;
  }
  if (lexer.has_error(lexer.tokenize("\"ok\""))) {
    return 1853;
  }
  return 0;
}

function lex_error_is(src: string, msg: string, code: string): boolean {
  let toks = lexer.tokenize(src);
  if let lexer.TokError(e) = toks[toks.len() - 1] {
    return e.msg == msg && e.code == code;
  }
  return false;
}

function test_unknown_char(): i32 {
  if (!lex_error_is("$", "unexpected character '$'", "P001")) {
    return 1900;
  }
  if (lexer.has_error(lexer.tokenize("@"))) {
    return 1901;
  }
  if (!lex_error_is("a # b", "unexpected character '#'", "P001")) {
    return 1902;
  }
  if (!lex_error_is("`", "unexpected character '`'", "P001")) {
    return 1903;
  }
  if (lexer.has_error(lexer.tokenize("~x"))) {
    return 1904;
  }
  if (!lex_error_is("\\", "unexpected character '\\\\'", "P001")) {
    return 1905;
  }
  if (!lex_error_is("x §", "unexpected character '§'", "P001")) {
    return 1906;
  }
  if (!lex_error_is("\x01", "unexpected character '\\x01'", "P001")) {
    return 1907;
  }
  let invalid = "";
  unsafe {
    invalid = string_from_bytes_unchecked([97 as u8, 32 as u8, 255 as u8]);
  }
  if (!lex_error_is(invalid, "invalid UTF-8 byte 0xFF", "P001")) {
    return 1908;
  }
  if (!lex_error_is("é", "identifiers must be ASCII; found 'é'", "P001")) {
    return 2230;
  }
  if (!lex_error_is("١", "identifiers must be ASCII; found '١'", "P001")) {
    return 2231;
  }
  if (!lex_error_is("42i33", "unknown numeric suffix \"i33\" on \"42\"", "P002")) {
    return 1909;
  }
  if (!lex_error_is("1.5i32", "integer suffix \"i32\" on float literal \"1.5\"", "P002")) {
    return 1910;
  }
  if (!lex_error_is("0o19", "invalid digit '9' in a 0o literal", "P002")) {
    return 1911;
  }
  if (!lex_error_is("\"a\\qb\"", "unknown escape \\q in string literal", "P001")) {
    return 1912;
  }
  if (!lex_error_is("f\"a\\qb\"", "unknown escape \\q in f-string literal", "P001")) {
    return 1913;
  }
  if (!lex_error_is("'\\xFF'", "\\xFF is above ASCII in a character literal; write \\u{FF} for the scalar", "P001")) {
    return 1914;
  }
  if (!lex_error_is("\"\\xff\"", "\\xFF is above ASCII in a string literal; write \\u{FF} for the scalar", "P001")) {
    return 1915;
  }
  if (!lex_error_is("f\"\\x80{x}\"", "\\x80 is above ASCII in an f-string literal; write \\u{80} for the scalar", "P001")) {
    return 1916;
  }
  if (!lex_error_is("\"\\u{D800}\"", "\\u{D800} is a surrogate, not a Unicode scalar value", "P001")) {
    return 1917;
  }
  if (!lex_error_is("\"\\u{110000}\"", "\\u{110000} is above the maximum Unicode scalar 10FFFF", "P001")) {
    return 1918;
  }
  if (!lex_error_is("f\"\\u{1F600\"", "unterminated \\u{...} escape", "P001")) {
    return 1919;
  }
  if (!lex_error_is("'\\q'", "unknown escape \\q in character literal", "P001")) {
    return 1920;
  }
  return 0;
}

function string_is(src: string, want: string): boolean {
  let t = lexer.tokenize(src);
  if (t.len() != 2) {
    return false;
  }
  if let lexer.TokString(x) = t[0] {
    return x.value == want;
  }
  return false;
}

function test_string_escapes(): i32 {
  if (!string_is("\"a\\x41\\x7f\"", "aA\x7f")) {
    return 1930;
  }
  if (!string_is("\"\\0\\'\\\"\\\\\"", "\x00'\"\\")) {
    return 1931;
  }
  let top = "";
  unsafe {
    top = string_from_bytes_unchecked([244 as u8, 143 as u8, 191 as u8, 191 as u8]);
  }
  if (!string_is("\"\\u{41}\\u{e9}\\u{20AC}\\u{1F600}\\u{10FFFF}\"", "Aé€😀" + top)) {
    return 1932;
  }
  let edges = "";
  unsafe {
    edges = string_from_bytes_unchecked([237 as u8, 159 as u8, 191 as u8, 238 as u8, 128 as u8, 128 as u8]);
  }
  if (!string_is("\"\\u{D7FF}\\u{E000}\"", edges)) {
    return 1933;
  }
  let ft = lexer.tokenize("f\"\\u{1F600}{x}\\u{7B}\"");
  if let lexer.TokFString(f) = ft[0] {
    if (f.parts.len() != 3 || f.parts[0].lit != "😀" || f.parts[1].expr != "x" || f.parts[2].lit != "{") {
      return 1934;
    }
  } else {
    return 1935;
  }
  return 0;
}

function check_quoted(src: string, want_text: string, want_suffix: string): boolean {
  let t = lexer.tokenize(src);
  if (t.len() != 2) {
    return false;
  }
  match (t[0]) {
    lexer.TokNumber(n) => {
      return n.text == want_text && n.suffix() == want_suffix
        && n.raw == src && !n.is_float();
    },
    _ => {
      return false;
    }
  }
}

function test_quoted_literals(): i32 {
  if (!check_quoted("'x'", "120", "char")) {
    return 1950;
  }
  if (!check_quoted("'['", "91", "char")) {
    return 1951;
  }
  if (!check_quoted("'\\n'", "10", "char")) {
    return 1952;
  }
  if (!check_quoted("'\\0'", "0", "char")) {
    return 1953;
  }
  if (!check_quoted("'\\''", "39", "char")) {
    return 1954;
  }
  if (!check_quoted("'\\\\'", "92", "char")) {
    return 1955;
  }
  if (!check_quoted("'\\x7F'", "127", "char")) {
    return 1956;
  }
  if (!check_quoted("'\\u{41}'", "65", "char")) {
    return 1957;
  }
  if (!check_quoted("'\\u{1F600}'", "128512", "char")) {
    return 1958;
  }
  if (!check_quoted("'\\u{10FFFF}'", "1114111", "char")) {
    return 1959;
  }
  if (!check_quoted("'😀'", "128512", "char")) {
    return 1960;
  }
  if (!check_quoted("'é'", "233", "char")) {
    return 1961;
  }
  if (!check_quoted("b'x'", "120", "u8")) {
    return 1962;
  }
  if (!check_quoted("b'['", "91", "u8")) {
    return 1963;
  }
  if (!check_quoted("b'\\n'", "10", "u8")) {
    return 1964;
  }
  if (!check_quoted("b'\\xFF'", "255", "u8")) {
    return 1965;
  }

  if (!lexer.has_error(lexer.tokenize("''"))) {
    return 1970;
  }
  if (!lexer.has_error(lexer.tokenize("b''"))) {
    return 1971;
  }
  if (!lexer.has_error(lexer.tokenize("'ab'"))) {
    return 1972;
  }
  if (!lexer.has_error(lexer.tokenize("b'ab'"))) {
    return 1973;
  }
  if (!lexer.has_error(lexer.tokenize("'a"))) {
    return 1974;
  }
  if (!lexer.has_error(lexer.tokenize("b'é'"))) {
    return 1975;
  }
  if (!lexer.has_error(lexer.tokenize("b'\\u{41}'"))) {
    return 1976;
  }
  if (!lexer.has_error(lexer.tokenize("'\\u{D800}'"))) {
    return 1977;
  }
  if (!lexer.has_error(lexer.tokenize("'\\u{110000}'"))) {
    return 1978;
  }
  if (!lexer.has_error(lexer.tokenize("'\\xFF'"))) {
    return 1979;
  }
  if (!lexer.has_error(lexer.tokenize("'\\q'"))) {
    return 1980;
  }
  if (!lexer.has_error(lexer.tokenize("'\n'"))) {
    return 1981;
  }

  let idt = lexer.tokenize("b bytes");
  match (idt[0]) {
    lexer.TokIdent(x) => {
      if (x.name != "b") {
        return 1990;
      }
    },
    _ => {
      return 1991;
    }
  }
  match (idt[1]) {
    lexer.TokIdent(x) => {
      if (x.name != "bytes") {
        return 1992;
      }
    },
    _ => {
      return 1993;
    }
  }
  return 0;
}

function check_part(p: lexer.FStringPart, want_expr: boolean, want_text: string, want_line: i32, want_col: i32): boolean {
  if (p.is_expr != want_expr) {
    return false;
  }
  if (p.line != want_line || p.col != want_col) {
    return false;
  }
  if (want_expr) {
    return p.expr == want_text;
  }
  return p.lit == want_text;
}

function test_fstring(): i32 {
  let t0 = lexer.tokenize("f\"\"");
  if (t0.len() != 2) {
    return 2000;
  }
  match (t0[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 0) {
        return 2001;
      }
    },
    _ => {
      return 2002;
    }
  }
  let t1 = lexer.tokenize("f\"plain\"");
  match (t1[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 1) {
        return 2010;
      }
      if (!check_part(f.parts[0], false, "plain", 0, 0)) {
        return 2011;
      }
    },
    _ => {
      return 2012;
    }
  }
  let t2 = lexer.tokenize("f\"a{x}b\"");
  match (t2[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 3) {
        return 2020;
      }
      if (!check_part(f.parts[0], false, "a", 0, 0)) {
        return 2021;
      }
      if (!check_part(f.parts[1], true, "x", 1, 5)) {
        return 2022;
      }
      if (!check_part(f.parts[2], false, "b", 0, 0)) {
        return 2023;
      }
    },
    _ => {
      return 2024;
    }
  }
  let t3 = lexer.tokenize("f\"{{lit}}\"");
  match (t3[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 1) {
        return 2030;
      }
      if (!check_part(f.parts[0], false, "{lit}", 0, 0)) {
        return 2031;
      }
    },
    _ => {
      return 2032;
    }
  }
  let t4 = lexer.tokenize("f\"k={\"x\"}\"");
  match (t4[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 2) {
        return 2040;
      }
      if (!check_part(f.parts[0], false, "k=", 0, 0)) {
        return 2041;
      }
      if (!check_part(f.parts[1], true, "\"x\"", 1, 6)) {
        return 2042;
      }
    },
    _ => {
      return 2043;
    }
  }
  let t5 = lexer.tokenize("f\"sum {a + b}\"");
  match (t5[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 2) {
        return 2050;
      }
      if (!check_part(f.parts[0], false, "sum ", 0, 0)) {
        return 2051;
      }
      if (!check_part(f.parts[1], true, "a + b", 1, 8)) {
        return 2052;
      }
    },
    _ => {
      return 2053;
    }
  }
  let t6 = lexer.tokenize("f\"hi\\nthere\"");
  match (t6[0]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 1) {
        return 2060;
      }
      if (!check_part(f.parts[0], false, "hi\nthere", 0, 0)) {
        return 2061;
      }
    },
    _ => {
      return 2062;
    }
  }
  if (!lexer.has_error(lexer.tokenize("f\"unterminated"))) {
    return 2070;
  }
  if (!lexer.has_error(lexer.tokenize("f\"with\nnewline\""))) {
    return 2071;
  }
  if (!lexer.has_error(lexer.tokenize("f\"bare}brace\""))) {
    return 2072;
  }
  if (!lexer.has_error(lexer.tokenize("f\"empty{}\""))) {
    return 2073;
  }
  return 0;
}

function test_fstring_positions(): i32 {
  let t = lexer.tokenize("let s = f\"a{aaa} b{bbb}\";");
  match (t[3]) {
    lexer.TokFString(f) => {
      if (f.parts.len() != 4) {
        return 2080;
      }
      if (!check_part(f.parts[1], true, "aaa", 1, 13)) {
        return 2081;
      }
      if (!check_part(f.parts[3], true, "bbb", 1, 20)) {
        return 2082;
      }
    },
    _ => {
      return 2083;
    }
  }
  match (lexer.tokenize("let a = 1;\nlet s = f\"x{yy}\";")[8]) {
    lexer.TokFString(f) => {
      if (!check_part(f.parts[1], true, "yy", 2, 13)) {
        return 2090;
      }
    },
    _ => {
      return 2091;
    }
  }
  let sub = lexer.rebase_tokens(lexer.tokenize("a\nb"), 4, 10);
  match (sub[0]) {
    lexer.TokIdent(x) => {
      if (x.line != 4 || x.col != 10) {
        return 2092;
      }
    },
    _ => {
      return 2093;
    }
  }
  match (sub[1]) {
    lexer.TokIdent(x) => {
      if (x.line != 5 || x.col != 1) {
        return 2094;
      }
    },
    _ => {
      return 2095;
    }
  }
  return 0;
}

function check_comment(c: lexer.Comment, line: i32, col: i32, text: string): boolean {
  return c.line == line && c.col == col && c.text == text;
}

function test_comments(): i32 {
  let src = "// leading\nlet u: string = \"http://x//y\"; // trailing\nlet n: i32 = 1;\n//: last\n";
  let r = lexer.tokenize_full(src);
  if (r.comments.len() != 3) {
    return 2100;
  }
  if (!check_comment(r.comments[0], 1, 1, " leading")) {
    return 2101;
  }
  if (!check_comment(r.comments[1], 2, 32, " trailing")) {
    return 2102;
  }
  if (!check_comment(r.comments[2], 4, 1, ": last")) {
    return 2103;
  }
  if (r.tokens.len() != lexer.tokenize(src).len()) {
    return 2104;
  }
  if (lexer.tokenize_full("let x: i32 = 1;\n").comments.len() != 0) {
    return 2105;
  }
  if (lexer.tokenize_full("// kept\nlet s: string = \"oops\n").comments.len() != 1) {
    return 2106;
  }
  let tail = lexer.tokenize_full("let x: i32 = 1; // tail");
  if (tail.comments.len() != 1 || !check_comment(tail.comments[0], 1, 17, " tail")) {
    return 2107;
  }
  return 0;
}

function test_multibyte(): i32 {
  let src = "let s: string = \"héllo wörld\"; s <<= 1; // cömment é\nlet f = f\"pré {s} pöst\";\n";
  let r = lexer.tokenize_full(src);
  let toks = r.tokens;
  if (toks.len() != 17) {
    return 2200;
  }
  match (toks[5]) {
    lexer.TokString(t) => {
      if (t.value != "héllo wörld") {
        return 2201;
      }
    },
    _ => {
      return 2202;
    }
  }
  match (toks[8]) {
    lexer.TokPunct(t) => {
      if (t.text != "<<=") {
        return 2203;
      }
    },
    _ => {
      return 2204;
    }
  }
  match (toks[14]) {
    lexer.TokFString(t) => {
      if (t.parts.len() != 3) {
        return 2205;
      }
      if (t.parts[0].lit != "pré ") {
        return 2206;
      }
      if (t.parts[1].expr != "s") {
        return 2207;
      }
      if (t.parts[2].lit != " pöst") {
        return 2208;
      }
    },
    _ => {
      return 2209;
    }
  }
  if (r.comments.len() != 1) {
    return 2210;
  }
  if (r.comments[0].text != " cömment é") {
    return 2211;
  }
  let t2 = lexer.tokenize("a<é");
  if (t2.len() != 3) {
    return 2212;
  }
  match (t2[1]) {
    lexer.TokPunct(t) => {
      if (t.text != "<") {
        return 2213;
      }
    },
    _ => {
      return 2214;
    }
  }
  match (t2[2]) {
    lexer.TokError(t) => {
      if (t.msg != "identifiers must be ASCII; found 'é'") {
        return 2215;
      }
    },
    _ => {
      return 2216;
    }
  }
  return 0;
}

function test_numeric_flags(): i32 {
  let src = "1 1i32 2i64 3u8 4u32 5u64 6usize 7f32 8f64 'A' b'A' 18446744073709551615u64 340282366920938463463374607431768211455";
  let suffixes: string[] = ["", "i32", "i64", "u8", "u32", "u64", "usize", "f32", "f64", "char", "u8", "u64", ""];
  let toks = lexer.rebase_tokens(lexer.tokenize(src), 4, 10);
  if (toks.len() != suffixes.len() + 1) {
    return 2247;
  }
  for i in 0..suffixes.len() {
    match (toks[i]) {
      lexer.TokNumber(t) => {
        if (t.suffix() != suffixes[i] || t.is_float() != (i == 7 || i == 8) || t.line != 4 || t.col < 10) {
          return 2248;
        }
        if (i == 11 && t.text != "18446744073709551615" || i == 12 && t.text != "340282366920938463463374607431768211455") {
          return 2250;
        }
      },
      _ => {
        return 2249;
      }
    }
  }
  return 0;
}

function test_string_scan_boundaries(): i32 {
  let text = "";
  let prefix = "";
  for n in 0..81 {
    let src = prefix + "\"" + text + "é\\n\\\"\\u{1F600}" + text + "\";";
    let toks = lexer.tokenize(src);
    if (toks.len() != 3) {
      return 2240;
    }
    match (toks[0]) {
      lexer.TokString(t) => {
        if (t.value != text + "é\n\"😀" + text || t.line != 1 || t.col != n + 1) {
          return 2241;
        }
      },
      _ => {
        return 2242;
      }
    }
    match (toks[1]) {
      lexer.TokPunct(t) => {
        if (t.text != ";" || t.col != src.len()) {
          return 2243;
        }
      },
      _ => {
        return 2244;
      }
    }
    if (!lexer.has_error(lexer.tokenize("\"" + text + "\n"))) {
      return 2245;
    }
    if (!lexer.has_error(lexer.tokenize("\"" + text))) {
      return 2246;
    }
    text += "x";
    prefix += " ";
  }
  return 0;
}

function test_source_decoding(): i32 {
  match (lexer.decode_source([47 as u8, 47 as u8, 10 as u8, 32 as u8, 255 as u8])) {
    Ok(_) => {
      return 2232;
    },
    Err(e) => {
      if (e.line != 2 || e.col != 2 || e.code != "P001" || e.msg != "invalid UTF-8 byte 0xFF") {
        return 2233;
      }
    }
  }
  match (lexer.decode_source([195 as u8, 169 as u8])) {
    Ok(text) => {
      if (text != "é") {
        return 2234;
      }
    },
    Err(_) => {
      return 2235;
    }
  }
  return 0;
}

function main(): i32 {
  let c = 0;
  c = test_numeric_flags();
  if (c != 0) {
    return c;
  }
  c = test_string_scan_boundaries();
  if (c != 0) {
    return c;
  }
  c = test_mixed();
  if (c != 0) {
    return c;
  }
  c = test_hex();
  if (c != 0) {
    return c;
  }
  c = test_scientific();
  if (c != 0) {
    return c;
  }
  c = test_bare_e();
  if (c != 0) {
    return c;
  }
  c = test_chained_tuple();
  if (c != 0) {
    return c;
  }
  c = test_float_after_nondot();
  if (c != 0) {
    return c;
  }
  c = test_suffix_errors();
  if (c != 0) {
    return c;
  }
  c = test_hex_needs_digits();
  if (c != 0) {
    return c;
  }
  c = test_string_errors();
  if (c != 0) {
    return c;
  }
  c = test_unknown_char();
  if (c != 0) {
    return c;
  }
  c = test_quoted_literals();
  if (c != 0) {
    return c;
  }
  c = test_string_escapes();
  if (c != 0) {
    return c;
  }
  c = test_fstring();
  if (c != 0) {
    return c;
  }
  c = test_fstring_positions();
  if (c != 0) {
    return c;
  }
  c = test_comments();
  if (c != 0) {
    return c;
  }
  c = test_multibyte();
  if (c != 0) {
    return c;
  }
  return test_source_decoding();
}
