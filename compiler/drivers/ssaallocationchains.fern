import "../ssaallocationchain" as chain;
import "../ssaallocatormachine" as initialized;
import "../ssaallocatorfirstmachine" as first;
import "../ssaarrayboxmachine" as box;
import "../ssaconstructormachine" as constructor;
import "../ssacredittext" as retained;
import "../ssaprepare";
import "std/string";

function require(ok: boolean, group: string): void {
  if (!ok) {
    print("allocation chain controls failed: " + group);
    exit(180);
  }
}

function change(s: string, from: string, to: string): string {
  require(s.contains(from), "mutation present " + from);
  return s.split(from).join(to);
}

function dependency(output: ssaprepare.Output, from: string, to: string): void {
  let changed = ssaprepare.Output { ...output, text: change(output.text, from, to) };
  require(box.check(changed.text) && constructor.check(changed, "parent"), "conditional callers still pass " + from);
  require(!chain.allocator(changed.text) && !chain.array_box(changed.text) && !chain.record(changed, "parent"), "composed dependency refuses " + from);
}

function allocator_paths(output: ssaprepare.Output): void {
  dependency(output, "__fern_alloc:", "__absent_alloc:");
  dependency(output, "popq (%rdi)", "popq (%rax)");
  dependency(output, "movq %rdi, __fern_heap_ptr(%rip)", "movq %rax, __fern_heap_ptr(%rip)");
  dependency(output, "movl $9, %eax", "movl $8, %eax");
  dependency(output, "movq %rcx, __fern_heap_end(%rip)", "movq %rax, __fern_heap_end(%rip)");
  let bad_first = change(output.text, "movl $9, %eax", "movl $8, %eax");
  require(initialized.check(bad_first) && !first.check(bad_first), "initialized alone cannot certify first mapping");
  let bad_fast = change(output.text, "popq (%rdi)", "popq (%rax)");
  require(first.check(bad_fast) && !initialized.check(bad_fast), "first mapping alone cannot certify free list");
}

function coherent(output: ssaprepare.Output, from: string, to: string): ssaprepare.Output {
  let row = retained.resolve(output, "parent").rows[0];
  let assembly = change(row.assembly, from, to);
  return ssaprepare.Output { text: change(output.text, row.assembly, assembly), bodies: [ssaprepare.Emitted { ...row, assembly: assembly }] };
}

function frames(output: ssaprepare.Output): void {
  // The machine derives d=-24, -32 and -40 from instructions, not metadata.
  // The corresponding proof floors are -128, -136 and -144, not a fixed -64.
  for amount in ["8", "16"] {
    let changed = coherent(output, "call __fern_arr_box", "subq $" + amount + ", %rsp\ncall __fern_arr_box\nmovq -16(%rsp), %rdi\naddq $" + amount + ", %rsp");
    require(chain.record(changed, "parent"), "derived alternate frame " + amount);
  }
  let outside = coherent(output, "call __fern_arr_box", "subq $24, %rsp\ncall __fern_arr_box\naddq $24, %rsp");
  require(!chain.record(outside, "parent"), "outside derived frame bound");
  let stale = coherent(output, "call __fern_arr_box", "movq %rbx, -32(%rsp)\ncall __fern_arr_box\nmovq -32(%rsp), %rbx");
  require(!chain.record(stale, "parent"), "extra permission does not preserve allocator scratch");
  let current = coherent(output, "call __fern_arr_box", "call __fern_arr_box\nmovq %rbx, -32(%rsp)\nmovq -32(%rsp), %rbx");
  require(chain.record(current, "parent"), "current scratch rewrite");
}

function caller_dependencies(output: ssaprepare.Output): void {
  let bad_box = change(output.text, "addq $3, %rdi", "addq $2, %rdi");
  require(chain.allocator(bad_box) && !chain.array_box(bad_box), "allocator cannot certify helper request");
  require(!chain.record(ssaprepare.Output { ...output, text: bad_box }, "parent"), "constructor binds helper");
  let bad_store = coherent(output, "movq %rsi, 0(%rax)", "");
  require(chain.array_box(bad_store.text) && !chain.record(bad_store, "parent"), "helper cannot certify constructor store");
  require(!chain.record(ssaprepare.Output { ...output, bodies: [] }, "parent"), "same retained graph required");
  let bad_shape = change(output.text, ".ascii \"Parent\"", ".ascii \"Other\"");
  require(chain.array_box(bad_shape) && !chain.record(ssaprepare.Output { ...output, text: bad_shape }, "parent"), "same selected shape required");
  require(!chain.allocator(output.text + "\n.text\n__fern_alloc:\nret\n"), "unique dependency namespace");
}

pub function run(output: ssaprepare.Output): void {
  require(chain.allocator(output.text) && chain.array_box(output.text) && chain.record(output, "parent"), "actual complete output");
  allocator_paths(output);
  frames(output);
  caller_dependencies(output);
  let equivalent = change(output.text, "xorl %r9d, %r9d", "movq $0, %r9");
  require(chain.record(ssaprepare.Output { ...output, text: equivalent }, "parent"), "equivalent syscall argument");
  require(chain.record(ssaprepare.Output { ...output, text: change(output.text, "\n", "\r\n") }, "parent"), "CRLF");
}
