// compiler/interp_run.fern — stdin-driven driver for
// interp.fern's tree-walking evaluator. Reads Fern source from
// stdin, runs lexer + parser + interp.eval_module, and exits
// with the status main's result maps to (interp.exit_status), or
// 254 if the program failed. Companion to asm_run.fern
// (#672+); used by the cross-validation test to assert
// interp / vm / asm all agree on the same source.

import "../lexer";
import "../parser";
import "./rundriver";
import "../interp";

function main(): i32 {
  let mod: parser.Module = rundriver.parse_stdin("interp_run");
  let (is_status, status) = interp.exit_status(interp.eval_module(mod));
  if (is_status) {
    return status;
  }
  return 254;
}
