import "../checker";
import "../typeinfo";
import "../util";

function callable_shape(t: typeinfo.Type): string {
  match (t) {
    typeinfo.TypeFunc(f) => {
      return "fn<" + callable_shape(f.ret_type) + ">";
    },
    typeinfo.TypeArray(a) => {
      return "array<" + callable_shape(a.elem) + ">";
    },
    _ => {
      return checker.type_debug(t);
    }
  }
  return "";
}

function main(): i32 {
  let structs: checker.StructSig[] = [
    checker.StructSig { name: "Foo", field_names: [], field_types: [], type_params: [], field_type_names: [], variant_field_names: [], derives: [], enum_owner: "", opaque: false, module: "" },
    checker.StructSig { name: "Bar", field_names: [], field_types: [], type_params: [], field_type_names: [], variant_field_names: [], derives: [], enum_owner: "", opaque: false, module: "" },
  ];
  let unions: checker.UnionSig[] = [
    checker.UnionSig { name: "Shape", variants: [], is_try: false, is_enum: true, module: "", type_params: [], instance: "", visible_from: [] },
  ];
  let corpus: string[] = [
    "i32", "i64", "u32", "u64", "bool", "boolean", "string", "f64", "f32",
    "Foo", "Bar", "Shape", "Baz",
    "i32[]", "string[]", "Foo[]", "Shape[]", "i32[][]", "Foo[][]",
    "(i32, string)", "(Foo, Shape)", "(i32, string, boolean)", "(string, (i32, boolean))",
    "(i32)", "()",
    "Map[string, i32]", "Map[i32, Foo]", "Map[string, Map[i32, string]]",
    "Map[string, Foo[]]", "Map[Foo, Shape]", "Map[string]",
    "Map[string, i32][]", "(i32, string)[]",
    "Option[i32]", "Vec[T]", "Foo[T]",
    "Bogus[]", "mod.Thing", "",
  ];
  let out: string = "";
  let i: i32 = 0;
  while (i < corpus.len()) {
    let t: typeinfo.Type = checker.type_from_name_with_structs_unions(corpus[i], structs, unions);
    out = out + corpus[i] + " => " + checker.type_debug(t) + "\n";
    i = i + 1;
  }
  let callables: string[] = [
    "() => i32[]", "((i32) => string[][])", "((i32) => string)[]",
    "((((i32) => string[][])))", "() => () => i32[]",
    "() => (() => i32[])[]", "fn",
  ];
  for spelling in callables {
    let resolved: typeinfo.Type = checker.type_from_name_with_structs_unions(spelling, structs, unions);
    out = out + "callable " + spelling + " => " + callable_shape(resolved) + "\n";
  }
  write(out);
  return 0;
}
