import "../asmcore";
import "../asm_ir";
import "../asm_arm64_ir";
import "../ir";
import "../ircore";
import "../irtables";
import "../irverifygate";
import "../rccertify";
import "../parser";
import "../physicalbody";
import "../ssaprepare";
import "../util";
import "./ssaretainedprogram" as retained;
import "./ssaretainedproof" as proof;
import "./ssaretainedwrapper" as wrapper;
import "./ssaretainedentry" as entry;
import "./ssaretainedruntime" as runtimeproof;
import "./ssaretainedallocation" as allocation;
import "./ssaretainedsites" as sites;
import "./ssaretainedrecursive" as recursive;
import "./ssadecrementcounts" as decrementcounts;
import "./ssadecrementmemories" as decrementmemories;
import "./ssacapacityvalues" as capacityvalues;
import "./ssalargepushpartitions" as largepushpartitions;
import "./ssalargepushvalues" as largepushvalues;
import "./ssalargearrayvalues" as largearrayvalues;
import "./ssaretainedtext" as retainedtext;
import "./ssaconstructorisas" as constructorisas;
import "./ssasmallcallerflows" as smallcallerflows;

function require(ok: boolean, code: i32): void {
  if (!ok) {
    exit(code);
  }
}

function count(rows: ssaprepare.Emitted[], name: string): i32 {
  let n = 0;
  for row in rows {
    if (row.label_name == name) {
      n = n + 1;
    }
  }
  return n;
}

function find(rows: ssaprepare.Emitted[], name: string): i32 {
  let i = 0;
  for row in rows {
    if (row.label_name == name) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

function selection(g: ircore.Gated, arm: boolean): void {
  let changed = irtables.LowerResult { ...g.cache[0], ops: [ir.op_const_i32(37), ir.op_return()] };
  let tail = irtables.LowerResult { ...changed, name: "retained_tail" };
  let loser = irtables.LowerResult { ...tail, ops: [ir.op_const_i32(99), ir.op_return()] };
  let cache = g.cache.with(0, changed).append(tail).append(loser);
  let physical = physicalbody.Collection { ...g.physical, rows: g.physical.rows.append(physicalbody.Origin { producer: 0, symbol: "tail-first", helper: None }).append(physicalbody.Origin { producer: 0, symbol: "tail-loser", helper: None }) };
  let off = retained.emit(g, cache, physical, arm, false, false, 0, 1);
  let on = retained.emit(g, cache, physical, arm, true, false, 0, 1);
  require(off.bodies.len() == 0 && off.text == on.text, 10);
  require(on.bodies.len() == 2 && count(on.bodies, "first") == 1 && count(on.bodies, "retained_tail") == 1, 11);
  require(on.bodies[0].body.lowered.ops[0].i32_imm == 37, 12);
  require(on.bodies[1].body.lowered.ops[0].i32_imm == 37 && on.bodies[1].body.selected.origin.symbol == "tail-first", 13);
  require(on.bodies[0].body.selected.origin.symbol == g.physical.rows[0].symbol, 14);
  require(on.bodies[0].context.architecture == (if (arm) { "arm64" } else { "x86-64" }), 15);
  require(irtables.sig_reg_has_exact(on.bodies[0].context.reg_entries, "first"), 16);
  let next = retained.emit(g, cache, physical, arm, true, false, 1, 2);
  require(count(next.bodies, "first") == 0 && count(next.bodies, "second") == 1 && count(next.bodies, "retained_tail") == 1, 17);
  let skipped = cache.with(0, irtables.LowerResult { ...changed, superseded: true });
  let none = retained.emit(g, skipped, physical, arm, true, false, 0, 1);
  require(none.bodies.len() == 1 && none.bodies[0].label_name == "retained_tail", 18);
  let unknown = retained.emit(g, cache, physicalbody.no_collection(), arm, true, false, 0, 1);
  require(unknown.bodies[0].body.selected.origin.producer < 0, 19);
}

function settled(g: ircore.Gated, arm: boolean): void {
  let off = retained.emit(g, g.cache, g.physical, arm, false, true, 0, -1);
  let on = retained.emit(g, g.cache, g.physical, arm, true, true, 0, -1);
  require(off.bodies.len() == 0 && off.text == on.text, 20);
  runtimeproof.run(on.text, arm);
  sites.output(on);
  require(count(on.bodies, "__fern_str_cmp") == 1 && count(on.bodies, "first") == 1, 21);
  let at = find(on.bodies, "__fern_str_cmp");
  require(at >= 0, 22);
  let row = on.bodies[at];
  require(util.has_str(row.context.needed, "heap"), 23);
  require(row.body.selected.origin.symbol == "__fern_str_cmp" && row.body.selected.producers.len() == 1, 24);
  require(row.body.selected.producers[0].contracts.len() != g.physical.producers[0].contracts.len(), 25);
  for body in on.bodies {
    require(count(on.bodies, body.label_name) == 1, 26);
    entry.consistent(body);
    allocation.consistent(body);
  }
}

function direct(g: ircore.Gated): void {
  let base = asmcore.new_state();
  base = asmcore.EmitState { ...base, struct_decls: g.stab, rt_lower: retained.runtime, retain_prepared: true, rc_free_debug: true };
  let out = asm_arm64_ir.emit_body(g.im, base, false, g.cache, g.physical);
  require(base.prepared.len() == 0 && out.prepared.len() == 3, 30);
  require(out.native_sites.len() == 0 && !out.retain_sites && out.capture == base.capture, 164);
  require(out.prepared[0].context.rc_free_debug && !out.prepared[0].context.records, 31);
  allocation.consistent(out.prepared[0]);
  let disabled = asm_arm64_ir.emit_body(g.im, asmcore.EmitState { ...base, retain_prepared: false }, false, g.cache, g.physical);
  require(disabled.prepared.len() == 0, 32);
  base.release();
}

function discarded_trial(): void {
  let base = asmcore.new_state();
  base = asmcore.EmitState { ...base, rt_lower: retained.runtime, retain_prepared: true, needed: ["str_cmp"], sanitize: false, leak_check: false, rc_free_debug: false };
  let trial = asm_arm64_ir.emit_ir_runtime(base, false);
  let at = find(trial.prepared, "__fern_str_cmp");
  require(at >= 0 && !util.has_str(trial.prepared[at].context.needed, "heap"), 35);
  require(util.has_str(trial.needed, "heap") && base.prepared.len() == 0, 36);
  require(base.native_sites.len() == 0 && trial.native_sites.len() == 0 && !trial.retain_sites, 165);
  base.release();
}

function renamed(g: ircore.Gated): void {
  let base = asmcore.new_state();
  base = asmcore.EmitState { ...base, retain_prepared: true, reg_entries: irtables.sig_reg_of(["Token.first"]) };
  let gate = irverifygate.gate_unreported(irtables.fn_sig_index(g.im.funcs), base.kinds.pops, rccertify.no_abis());
  let fd = parser.FuncDecl { ...g.im.funcs[0], receiver_type: "Token" };
  let out = asm_arm64_ir.emit_function_via_ir_pre(g.cache[0], physicalbody.select(g.physical, 0), asmcore.no_prelift(), fd, base, gate);
  require(out.prepared.len() == 1 && out.prepared[0].label_name == "Token.first", 37);
  require(out.prepared[0].body.lowered.name == g.cache[0].name && out.prepared[0].body.formed.f.name == "Token.first", 38);
  require(irtables.sig_reg_has_exact(out.prepared[0].context.reg_entries, "Token.first"), 39);
  base.release();
}

function debug_body(g: ircore.Gated, arm: boolean, var_rows: boolean): void {
  let recs = buf_new(4096);
  let r = irtables.LowerResult { ...g.cache[0], n_locals: 1, ops: [ir.op_const_i32(43), ir.op_store_local(0), ir.op_load_local(0), ir.op_return()], dbg_slots: [0], dbg_names: ["observed"], dbg_types: ["i32"] };
  let rows: ssaprepare.Emitted[] = [];
  if (arm) {
    let s = asmcore.new_state();
    s = asmcore.EmitState { ...s, recs: recs, retain_prepared: true, var_rows: var_rows };
    let gate = irverifygate.gate_unreported(irtables.fn_sig_index(g.im.funcs), s.kinds.pops, rccertify.no_abis());
    let out = asm_arm64_ir.emit_function_via_ir_pre(r, physicalbody.select(g.physical, 0), asmcore.no_prelift(), g.im.funcs[0], s, gate);
    rows = out.prepared;
    s.release();
  } else {
    let sw = asmcore.Switches { ...asmcore.env_switches(), var_rows: var_rows };
    let out = asm_ir.emit_module_ir_unit_prepared(g.im, false, false, "", [], g.im.funcs, g.stab, 0, 1, g.cache.with(0, r), g.physical, retained.runtime, recs, sw, true);
    rows = out.bodies;
  }
  require(rows.len() == 1 && rows[0].context.records, 40);
  if (var_rows) {
    require(rows[0].body.seen_vals.len() > 0 && rows[0].body.seen_slots.len() > 0, 41);
  } else {
    require(rows[0].body.seen_vals.len() == 0 && rows[0].body.seen_slots.len() == 0, 44);
  }
  require(rows[0].body.lowered.dbg_names[0] == "observed" && rows[0].body.lowered.ops[0].i32_imm == 43, 42);
  allocation.consistent(rows[0]);
  let code = buf_take(recs);
  require(code.len() > 0, 43);
  buf_free(recs);
}

function main(): i32 {
  constructorisas.run();
  retainedtext.run();
  smallcallerflows.run();
  let mod = retained.module();
  if (asmcore.refuse_parse_errors([mod])) {
    return 1;
  }
  let g = retained.program(mod);
  require(g.ok && g.im.funcs.len() == 3 && g.cache.len() == 3, 1);
  let fresh = asmcore.new_state();
  require(!fresh.retain_prepared, 2);
  fresh.release();
  selection(g, false);
  selection(g, true);
  settled(g, false);
  settled(g, true);
  direct(g);
  discarded_trial();
  renamed(g);
  debug_body(g, false, true);
  debug_body(g, true, true);
  debug_body(g, false, false);
  debug_body(g, true, false);
  let needs = asm_ir.module_runtime_needs(g.im, g.im.funcs, g.stab, g.cache, g.physical);
  require(needs.len() == 0, 33);
  let after = retained.emit(g, g.cache, g.physical, false, true, false, 0, 1);
  require(after.bodies.len() == 1 && after.bodies[0].label_name == "first", 34);
  wrapper.run(false);
  wrapper.run(true);
  proof.run(false);
  proof.run(true);
  entry.run();
  runtimeproof.debug(g, false);
  runtimeproof.debug(g, true);
  allocation.run(g, false);
  allocation.run(g, true);
  recursive.run(false);
  recursive.run(true);
  decrementcounts.run();
  decrementmemories.run();
  capacityvalues.run();
  largepushpartitions.run();
  largepushvalues.run();
  largearrayvalues.run();
  print("retained native body controls passed");
  return 0;
}
