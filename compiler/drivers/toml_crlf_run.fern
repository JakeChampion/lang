import "../fern_toml";
import "../util";

function render_manifest(label: string, src: string): string {
  let m = fern_toml.parse(src);
  let out = label + " name=" + m.name + "\n";
  out = out + label + " deps=" + util.i32_to_string(m.deps.len()) + "\n";
  for i in 0..m.deps.len() {
    out = out + label + " dep " + m.deps[i].name + " kind=" + m.deps[i].kind + " version=" + m.deps[i].version + " path=" + m.deps[i].path + "\n";
  }
  for j in 0..m.members.len() {
    out = out + label + " member " + m.members[j] + "\n";
  }
  return out;
}

function render_lock(label: string, src: string): string {
  let es: fern_toml.LockEntry[] = match (fern_toml.parse_lock(src)) { Ok(lock) => lock.entries, Err(message) => { return label + " error " + message + "\n"; } };
  let out = label + " entries=" + util.i32_to_string(es.len()) + "\n";
  for i in 0..es.len() {
    out = out + label + " entry " + es[i].name + " version=" + es[i].version + " path=" + es[i].path + " hash=" + es[i].hash + "\n";
  }
  return out;
}

function crlf(s: string): string {
  return s.replace("\n", "\r\n");
}

function main(): i32 {
  let manifest: string = "[package]\n"
    + "name = \"acme\"  # the package\n"
    + "\n"
    + "# a comment line\n"
    + "[dependencies]  # what it needs\n"
    + "dbl = { path = \"../dbl\" }  # beside us\n"
    + "shout = \"1.2.3\"\n"
    + "\n"
    + "[workspace]\n"
    + "members = [\"a\", \"b#c\"]  # two\n";
  let lock: string = "[[package]]\n"
    + "name = \"dbl\"\n"
    + "version = \"1.0.0\"  # pinned\n"
    + "path = \"../dbl\"\n"
    + "\n"
    + "[[package]]\n"
    + "name = \"shout\"\n"
    + "version = \"1.2.3\"\n"
    + "hash = \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n";

  let out = "";
  out += render_manifest("LF  ", manifest);
  out += render_manifest("CRLF", crlf(manifest));
  out += render_lock("LF  ", lock);
  out += render_lock("CRLF", crlf(lock));
  write(out);
  return 0;
}
