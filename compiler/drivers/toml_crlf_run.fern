import "../fern_toml";
import "../util";

function render_manifest(label: string, src: string): string {
  let m: fern_toml.Manifest = fern_toml.parse(src);
  let out: string = label + " name=" + m.name + "\n";
  out = out + label + " deps=" + util.i32_to_string(m.deps.len()) + "\n";
  let i: i32 = 0;
  while (i < m.deps.len()) {
    out = out + label + " dep " + m.deps[i].name + " kind=" + m.deps[i].kind + " version=" + m.deps[i].version + " path=" + m.deps[i].path + "\n";
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < m.members.len()) {
    out = out + label + " member " + m.members[j] + "\n";
    j = j + 1;
  }
  return out;
}

function render_lock(label: string, src: string): string {
  let lr: fern_toml.LockResult = fern_toml.parse_lock(src);
  if (lr.err.len() > 0) {
    return label + " error " + lr.err + "\n";
  }
  let es: fern_toml.LockEntry[] = lr.entries;
  let out: string = label + " entries=" + util.i32_to_string(es.len()) + "\n";
  let i: i32 = 0;
  while (i < es.len()) {
    out = out + label + " entry " + es[i].name + " version=" + es[i].version + " path=" + es[i].path + " hash=" + es[i].hash + "\n";
    i = i + 1;
  }
  return out;
}

function crlf(s: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'\n') {
      out = out + "\r\n";
    } else {
      out = out + slice_unchecked(s, i, i + 1);
    }
    i = i + 1;
  }
  return out;
}

function main(): i32 {
  let manifest: string = "[package]\n"
    + "name = \"acme\"  # the package\n"
    + "\n"
    + "# a comment line\n"
    + "[dependencies]  # what it needs\n"
    + "dbl = { path = \"../dbl\" }  # beside us\n"
    + "shout = \"1.2.3\"\n"
    + "\n"
    + "[workspace]\n"
    + "members = [\"a\", \"b#c\"]  # two\n";
  let lock: string = "[[package]]\n"
    + "name = \"dbl\"\n"
    + "version = \"1.0.0\"  # pinned\n"
    + "path = \"../dbl\"\n"
    + "\n"
    + "[[package]]\n"
    + "name = \"shout\"\n"
    + "version = \"1.2.3\"\n"
    + "hash = \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n";

  let out: string = "";
  out = out + render_manifest("LF  ", manifest);
  out = out + render_manifest("CRLF", crlf(manifest));
  out = out + render_lock("LF  ", lock);
  out = out + render_lock("CRLF", crlf(lock));
  write(out);
  return 0;
}
