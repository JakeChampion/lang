import "../coverreport";
import "../lexer";
import "../lint";
import "../modloader";
import "../parser";
import "../util";
import "std/string";

function fern_files(dir: string): string[] {
  let out: string[] = [];
  if let Ok(names) = read_dir(dir) {
    for n in names {
      let p = dir + "/" + n;
      if (util.is_dir(p)) {
        for f in fern_files(p) {
          out = out.append(f);
        }
      } else if (n.ends_with(".fern") || n.ends_with(".fern.md")) {
        if (n.ends_with(".fern.md") && util.has_str(names, slice_unchecked(n, 0, n.len() - 3).to_owned())) {
          continue;
        }
        out = out.append(p);
      }
    }
  }
  return out;
}

function main(): i32 {
  let av = args();
  let cfg = lint.default_config();
  let no_cover: coverreport.File[] = [];
  let out = "";
  let i = 1;
  while (i < av.len()) {
    let worst = 0;
    let worst_name = "";
    let excess = 0;
    let problems = "";
    for f in fern_files(av[i]) {
      let source = modloader.read_module(modloader.no_buffers(), util.without_fern_ext(f) + ".fern");
      if (!source.ok) {
        eprint(source.err_path + ": " + source.err);
        return 1;
      }
      let src = source.src;
      let lx = lexer.tokenize_full(src);
      let m = parser.parse_module(lx.tokens);
      for fd in lint.lint_file(cfg, f, src, m, lx.comments, no_cover) {
        if (fd.rule == lint.COMPLEXITY) {
          excess = excess + fd.value - cfg.max;
        } else {
          problems = problems + "directive " + f + ":" + util.i32_to_string(fd.line) + ": " + fd.msg + "\n";
        }
      }
      for fd in m.funcs {
        if (lint.scored(m, fd)) {
          let s = lint.score(fd);
          if (s > worst) {
            worst = s;
            worst_name = lint.display_name(fd);
          }
        }
      }
    }
    out = out + "tree " + av[i] + " worst " + worst_name + " " + util.i32_to_string(worst) + " excess " + util.i32_to_string(excess) + "\n" + problems;
    i += 1;
  }
  write(out);
  return 0;
}
