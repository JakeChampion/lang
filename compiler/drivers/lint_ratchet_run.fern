// compiler/drivers/lint_ratchet_run.fern — the measurements the repository's
// complexity ratchet holds each first-party tree to
// (internal/testing/e2ecompiler/self_host_lint_ratchet_test.go). For each
// directory argument it prints
//
//     tree DIR worst NAME SCORE excess N
//
// where SCORE is the highest complexity any function reaches, suppressed ones
// included, and N the summed distance over the default limit of the
// unsuppressed functions above it; then one `directive FILE:LINE: MESSAGE`
// line per malformed `fern-lint:` comment.

import "../coverreport";
import "../lexer";
import "../lint";
import "../parser";
import "../util";

function fern_files(dir: string): string[] {
  let out: string[] = [];
  if let Ok(names) = read_dir(dir) {
    for n in names {
      let p: string = dir + "/" + n;
      if (util.is_dir(p)) {
        for f in fern_files(p) {
          out = out.append(f);
        }
      } else if (util.str_has_suffix(n, ".fern")) {
        out = out.append(p);
      }
    }
  }
  return out;
}

function main(): i32 {
  let av: string[] = args();
  let cfg: lint.Config = lint.default_config();
  let no_cover: coverreport.File[] = [];
  let out: string = "";
  let i: i32 = 1;
  while (i < av.len()) {
    let worst: i32 = 0;
    let worst_name: string = "";
    let excess: i32 = 0;
    let problems: string = "";
    for f in fern_files(av[i]) {
      if let Ok(src) = read_file(f) {
        let lx: lexer.LexResult = lexer.tokenize_full(src);
        let m: parser.Module = parser.parse_module(lx.tokens);
        for fd in lint.lint_file(cfg, f, src, m, lx.comments, no_cover) {
          if (fd.rule == lint.COMPLEXITY) {
            excess = excess + fd.value - cfg.max;
          } else {
            problems = problems + "directive " + f + ":" + util.i32_to_string(fd.line) + ": " + fd.msg + "\n";
          }
        }
        for fd in m.funcs {
          if (lint.scored(m, fd)) {
            let s: i32 = lint.score(fd);
            if (s > worst) {
              worst = s;
              worst_name = lint.display_name(fd);
            }
          }
        }
      }
    }
    out = out + "tree " + av[i] + " worst " + worst_name + " " + util.i32_to_string(worst) + " excess " + util.i32_to_string(excess) + "\n" + problems;
    i = i + 1;
  }
  write(out);
  return 0;
}
