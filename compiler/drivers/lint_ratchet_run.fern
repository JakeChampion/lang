import "../coverreport";
import "../lexer";
import "../lint";
import "../modloader";
import "../parser";
import "../util";

function fern_files(dir: string): string[] {
  let out: string[] = [];
  if let Ok(names) = read_dir(dir) {
    for n in names {
      let p: string = dir + "/" + n;
      if (util.is_dir(p)) {
        for f in fern_files(p) {
          out = out.append(f);
        }
      } else if (util.str_has_suffix(n, ".fern") || util.str_has_suffix(n, ".fern.md")) {
        if (util.str_has_suffix(n, ".fern.md") && util.has_str(names, slice_unchecked(n, 0, n.len() - 3) + "")) {
          continue;
        }
        out = out.append(p);
      }
    }
  }
  return out;
}

function main(): i32 {
  let av: string[] = args();
  let cfg: lint.Config = lint.default_config();
  let no_cover: coverreport.File[] = [];
  let out: string = "";
  let i: i32 = 1;
  while (i < av.len()) {
    let worst: i32 = 0;
    let worst_name: string = "";
    let excess: i32 = 0;
    let problems: string = "";
    for f in fern_files(av[i]) {
      let source: modloader.Resolved = modloader.read_module(modloader.no_buffers(), util.without_fern_ext(f) + ".fern");
      if (!source.ok) {
        eprint(source.err_path + ": " + source.err);
        return 1;
      }
      let src: string = source.src;
      let lx: lexer.LexResult = lexer.tokenize_full(src);
      let m: parser.Module = parser.parse_module(lx.tokens);
      for fd in lint.lint_file(cfg, f, src, m, lx.comments, no_cover) {
        if (fd.rule == lint.COMPLEXITY) {
          excess = excess + fd.value - cfg.max;
        } else {
          problems = problems + "directive " + f + ":" + util.i32_to_string(fd.line) + ": " + fd.msg + "\n";
        }
      }
      for fd in m.funcs {
        if (lint.scored(m, fd)) {
          let s: i32 = lint.score(fd);
          if (s > worst) {
            worst = s;
            worst_name = lint.display_name(fd);
          }
        }
      }
    }
    out = out + "tree " + av[i] + " worst " + worst_name + " " + util.i32_to_string(worst) + " excess " + util.i32_to_string(excess) + "\n" + problems;
    i = i + 1;
  }
  write(out);
  return 0;
}
