import "../ssadecrementcount" as count;
import "../ssadecrementmemory" as memory;

function require(ok: boolean): void {
  if (!ok) {
    print("decrement header effect controls failed");
    exit(198);
  }
}

function refused(m: memory.Memory): void {
  require(!memory.valid(m) && !memory.finished(m));
  require(!count.valid(memory.load(m, -8, 4)));
  let repaired = memory.store(m, -8, 4, count.decrement(count.original(true)));
  require(!memory.valid(repaired) && !memory.finished(repaired));
}

function addresses(m: memory.Memory, value: count.Value): void {
  let offsets: i32[] = [-2147483648, -16, -12, -9, -7, -4, 0, 8, 2147483647];
  for offset in offsets {
    require(!count.valid(memory.load(m, offset, 4)));
    refused(memory.store(m, offset, 4, value));
  }
  let widths: i32[] = [-2147483648, -1, 0, 1, 2, 3, 5, 8, 16, 2147483647];
  for width in widths {
    require(!count.valid(memory.load(m, -8, width)));
    refused(memory.store(m, -8, width, value));
  }
}

pub function run(): void {
  let kept = memory.initial(false);
  let shared = memory.initial(true);
  require(memory.valid(kept) && memory.finished(kept));
  require(memory.valid(shared) && !memory.finished(shared));
  let old = memory.load(shared, -8, 4);
  let next = count.decrement(old);
  let changed = memory.store(shared, -8, 4, next);
  require(memory.valid(changed) && memory.finished(changed));
  let current = memory.load(changed, -8, 4);
  require(count.is_decremented(current) && !count.is_original(current));
  require(!count.valid(count.decrement(current)));
  // The count-two case now includes one, so CMP 1 has an unknown zero flag.
  require(count.compare(current, 1).zero == -1);
  require(count.is_original(memory.load(shared, -8, 4)));
  require(count.is_original(memory.load(kept, -8, 4)));
  refused(memory.store(changed, -8, 4, count.decrement(current)));
  refused(memory.store(changed, -8, 4, next));
  refused(memory.store(changed, -8, 4, old));
  refused(memory.store(shared, -8, 4, old));
  refused(memory.store(shared, -8, 4, count.original(false)));
  refused(memory.store(shared, -8, 4, count.Value { family: 2, delta: -2 }));
  refused(memory.store(shared, -8, 4, count.unknown()));
  refused(memory.store(kept, -8, 4, next));
  refused(memory.store(kept, -8, 4, count.original(false)));
  refused(memory.Memory { shared: false, stored: next });
  refused(memory.Memory { shared: true, stored: count.original(false) });
  refused(memory.Memory { shared: true, stored: count.Value { family: 2, delta: 1 } });
  addresses(shared, next);
  addresses(changed, next);
  addresses(kept, next);
}
