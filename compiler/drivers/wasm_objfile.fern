import "../util";
import "std/string";

pub struct UnitObj {
  strs: string[],
  caggs: string[],
  fns: string[],
  needs: string[],
  fn_sigs: string[],
  text: string,
}

pub struct MaybeUnit { found: boolean, obj: UnitObj }

pub function empty_unit(): UnitObj {
  return UnitObj { strs: [], caggs: [], fns: [], needs: [], fn_sigs: [], text: "" };
}

pub struct StrsAt { items: string[], pos: i32 }

pub struct IntsAt { items: i32[], pos: i32 }

function enc_strs(tag: string, xs: string[]): string {
  let out = tag + util.i32_to_string(xs.len()) + "\n";
  for i in 0..xs.len() {
    out = out + util.i32_to_string(xs[i].len()) + "\n" + xs[i];
  }
  return out;
}

pub function magic(): string {
  return "FERNWU4\n";
}

pub function is_current(s: string): boolean {
  if (s.len() < magic().len()) {
    return false;
  }
  return slice_unchecked(s, 0, magic().len()).to_owned() == magic();
}

pub function encode(u: UnitObj): string {
  return magic()
    + enc_strs("S", u.strs)
    + enc_strs("K", u.caggs)
    + enc_strs("F", u.fns)
    + enc_strs("N", u.needs)
    + enc_strs("A", u.fn_sigs)
    + "U" + util.i32_to_string(u.text.len()) + "\n" + u.text;
}

function scan_int(s: string, pos: i32): IntsAt {
  let p = pos;
  let v = 0;
  while (p < s.len() && s[p] != b'\n') {
    if (s[p] as i32 >= 48 && s[p] as i32 <= 57) {
      v = v * 10 + (s[p] as i32 - 48);
    }
    p += 1;
  }
  return IntsAt { items: [v], pos: p + 1 };
}

function dec_strs(s: string, pos: i32): StrsAt {
  let hdr = scan_int(s, pos);
  let n = hdr.items[0];
  let p = hdr.pos;
  let out: string[] = [];
  for i in 0..n {
    let lh = scan_int(s, p);
    let len = lh.items[0];
    out = out.append(slice_unchecked(s, lh.pos, lh.pos + len).to_owned());
    p = lh.pos + len;
  }
  return StrsAt { items: out, pos: p };
}

pub function decode(s: string): UnitObj {
  let p = magic().len();
  let st = dec_strs(s, p + 1);
  let kg = dec_strs(s, st.pos + 1);
  let fn = dec_strs(s, kg.pos + 1);
  let nd = dec_strs(s, fn.pos + 1);
  let ar = dec_strs(s, nd.pos + 1);
  let tl = scan_int(s, ar.pos + 1);
  return UnitObj {
    strs: st.items,
    caggs: kg.items,
    fns: fn.items,
    needs: nd.items,
    fn_sigs: ar.items,
    text: slice_unchecked(s, tl.pos, tl.pos + tl.items[0]).to_owned(),
  };
}
