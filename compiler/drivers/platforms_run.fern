import "../lexer";
import "../parser";
import "../platforms";
import "../util";

function violations(src: string, target: string): platforms.Violation[] {
  return platforms.enforce(parser.parse_module(lexer.tokenize(src)), target);
}

function count(src: string, target: string): i32 {
  return violations(src, target).len();
}

function reach_of(src: string): string[] {
  return platforms.reach(parser.parse_module(lexer.tokenize(src)));
}

function first_msg(src: string, target: string): string {
  let vs: platforms.Violation[] = violations(src, target);
  if (vs.len() == 0) {
    return "";
  }
  return platforms.violation_message(vs[0]);
}

function main(): i32 {
  let wasm: platforms.Descriptor = platforms.for_target("wasm32-wasi");
  if (!wasm.known) {
    return 1;
  }
  if (wasm.isa != "wasm32" || wasm.environment != "wasi") {
    return 2;
  }

  let x86: platforms.Descriptor = platforms.for_target("x86-64-linux");
  if (x86.isa != "x86-64" || x86.environment != "linux") {
    return 3;
  }

  if (platforms.for_target("vax-11").known) {
    return 4;
  }
  if (platforms.forbidden_gates("vax-11").len() != 0) {
    return 5;
  }

  if (!platforms.for_target("arm64-freestanding").known) {
    return 6;
  }
  if (platforms.for_target("arm64-freestanding").capabilities.len() != 0) {
    return 7;
  }
  if (platforms.emits_code("arm64-freestanding")) {
    return 8;
  }
  if (!platforms.emits_code("arm64-linux")) {
    return 9;
  }

  if (!platforms.has_capability("wasm32-wasi", "fs")) {
    return 10;
  }
  if (!platforms.has_capability("wasm32-wasi", "tcp")) {
    return 11;
  }
  if (platforms.has_capability("wasm32-wasi", "proc")) {
    return 12;
  }
  if (platforms.has_capability("wasm32-wasi", "arena")) {
    return 13;
  }
  if (!platforms.has_capability("x86-64-linux", "proc")) {
    return 14;
  }
  if (!platforms.has_capability("arm64-darwin", "arena")) {
    return 15;
  }
  if (!platforms.has_capability("x86-64-linux", "subprocess")) {
    return 16;
  }
  if (platforms.has_capability("wasm32-wasi", "subprocess")) {
    return 19;
  }
  if (!platforms.has_capability("x86-64-linux", "pollfd")) {
    return 80;
  }
  if (platforms.has_capability("wasm32-wasi", "pollfd")) {
    return 81;
  }
  if (!platforms.has_capability("x86-64-linux", "fsmode")) {
    return 82;
  }
  if (platforms.has_capability("wasm32-wasi", "fsmode")) {
    return 83;
  }
  if (!platforms.has_capability("x86-64-linux", "cabi")) {
    return 84;
  }
  if (platforms.has_capability("wasm32-wasi", "cabi")) {
    return 85;
  }
  if (platforms.has_capability("vax-11", "fs")) {
    return 17;
  }
  if (platforms.has_capability("wasm32-wasi", "telepathy")) {
    return 18;
  }

  if (platforms.gated_capability("read_file") != "fs") {
    return 20;
  }
  if (platforms.gated_capability("proc_fork") != "proc") {
    return 21;
  }
  if (platforms.gated_capability("__heap_mark") != "arena") {
    return 22;
  }
  if (platforms.gated_capability("timer_fd") != "pollfd") {
    return 86;
  }
  if (platforms.gated_capability("wasm_timer_pollable") != "pollable" || platforms.gated_capability("wasm_block") != "pollable") {
    return 87;
  }
  if (!platforms.has_capability("wasm32-wasi", "pollable") || !platforms.has_capability("wasm32-wasi-http", "pollable")) {
    return 90;
  }
  if (platforms.has_capability("x86-64-linux", "pollable") || platforms.has_capability("arm64-darwin", "pollable")) {
    return 91;
  }
  if (platforms.gated_capability("poll") != "now") {
    return 92;
  }
  if (platforms.gated_capability("write_file_exec") != "fsmode") {
    return 88;
  }
  if (platforms.gated_capability("__c_call2_f64") != "cabi") {
    return 89;
  }
  if (platforms.gated_capability("__heap_bump_bytes").len() != 0) {
    return 23;
  }
  if (!platforms.core_builtin("exit")) {
    return 24;
  }
  if (platforms.gated_capability("exit").len() != 0) {
    return 25;
  }
  let cores: string[] = platforms.core_builtins();
  let ci: i32 = 0;
  while (ci < cores.len()) {
    if (platforms.gated_capability(cores[ci]).len() != 0) {
      return 26;
    }
    ci = ci + 1;
  }
  let gates: platforms.Gate[] = platforms.gated_builtins();
  let gi: i32 = 0;
  while (gi < gates.len()) {
    if (gates[gi].builtin.len() == 0) {
      return 27;
    }
    if (platforms.targets_providing(gates[gi].capability).len() == 0) {
      return 28;
    }
    gi = gi + 1;
  }

  let forks: string = "function f(): i32 { return proc_fork(); }\nfunction main(): i32 { return f(); }\n";
  if (count(forks, "wasm32-wasi") != 1) {
    return 30;
  }
  if (count(forks, "x86-64-linux") != 0) {
    return 31;
  }
  let prints: string = "function main(): i32 { print(\"hi\"); return 0; }\n";
  if (count(forks, "arm64-freestanding") != 1) {
    return 32;
  }
  if (count(prints, "arm64-freestanding") != 1) {
    return 33;
  }
  if (count(prints, "x86-64-linux") != 0) {
    return 39;
  }
  if (count(forks, "vax-11") != 0) {
    return 34;
  }

  let spawns: string = "function main(): i32 { return subprocess(\"ls\"); }\n";
  if (count(spawns, "wasm32-wasi") != 1) {
    return 35;
  }
  if (count(spawns, "x86-64-linux") != 0) {
    return 36;
  }

  let twice: string = "function f(): i32 { let a: i32 = proc_fork(); return a + proc_fork(); }\n";
  if (count(twice, "wasm32-wasi") != 1) {
    return 37;
  }
  let two_fns: string = "function f(): i32 { return proc_fork(); }\nfunction g(): i32 { return proc_fork(); }\n";
  if (count(two_fns, "wasm32-wasi") != 2) {
    return 38;
  }

  let shadow: string = "function main(): i32 { let env: i32 = 3; return env; }\n";
  if (count(shadow, "wasm32-wasi") != 0) {
    return 40;
  }

  let method: string = "struct S { n: i32 }\nfunction (s: S) stat(): i32 { return s.n; }\nfunction main(): i32 { let s: S = S { n: 1 }; return s.stat(); }\n";
  if (count(method, "wasm32-wasi") != 0) {
    return 41;
  }

  let ungated: string = "function main(): i32 { return __heap_bump_bytes(); }\n";
  if (count(ungated, "wasm32-wasi") != 0) {
    return 42;
  }

  let in_lambda: string = "function main(): i32 { let f: fn(): i32 = (): i32 => { return proc_fork(); }; return f(); }\n";
  if (count(in_lambda, "wasm32-wasi") != 1) {
    return 50;
  }

  let nested: string = "function id(x: i32): i32 { return x; }\nfunction main(): i32 { if (id(proc_fork()) > 0) { return 1; } return 0; }\n";
  if (count(nested, "wasm32-wasi") != 1) {
    return 51;
  }

  let m: string = first_msg(forks, "wasm32-wasi");
  if (!util.contains(m, "target \"wasm32-wasi\" does not provide `proc`")) {
    return 60;
  }
  if (!util.contains(m, "required by `proc_fork`")) {
    return 61;
  }
  if (!util.contains(m, "targets providing it: [")) {
    return 62;
  }
  if (!util.contains(m, "x86-64-linux")) {
    return 63;
  }

  let ms: string = first_msg(spawns, "wasm32-wasi");
  if (!util.contains(ms, "does not provide `subprocess`")) {
    return 64;
  }
  if (!util.contains(ms, "arm64-darwin")) {
    return 65;
  }

  if (reach_of("function main(): i32 { return 1 + 2; }\n").len() != 0) {
    return 70;
  }

  let r1: string[] = reach_of(forks);
  if (r1.len() != 1 || r1[0] != "proc") {
    return 71;
  }

  let many: string = "function main(): i32 {\n"
    + "    let t: i64 = now_unix_ms();\n"
    + "    let p: i32 = proc_fork();\n"
    + "    let q: i32 = proc_fork();\n"
    + "    print(\"x\");\n"
    + "    return q + p;\n"
    + "}\n";
  let r2: string[] = reach_of(many);
  if (r2.len() != 3) {
    return 72;
  }
  if (r2[0] != "log" || r2[1] != "now" || r2[2] != "proc") {
    return 73;
  }

  if (count(forks, "x86-64-linux") != 0) {
    return 74;
  }
  if (reach_of(forks).len() != 1) {
    return 75;
  }

  if (reach_of("function main(): i32 { return __heap_bump_bytes(); }\n").len() != 0) {
    return 76;
  }

  write("platforms: every capability rule agrees\n");
  return 0;
}
