import "../lexer";
import "../ferndoc";
import "../util";

function c(line: i32, text: string): lexer.Comment {
  return lexer.Comment { line: line, col: 1, text: text, trailing: false };
}

function took(cs: lexer.Comment[], cursor: i32, decl_line: i32): string {
  return ferndoc.take_doc(cs, cursor, decl_line).doc;
}

function self_checks(): i32 {
  if (ferndoc.trim_space("  hi  ") != "hi") {
    return 1;
  }
  if (ferndoc.trim_space("\t\nhi\r\n") != "hi") {
    return 2;
  }
  if (ferndoc.trim_space("   ") != "") {
    return 3;
  }
  if (ferndoc.trim_space("") != "") {
    return 4;
  }
  if (ferndoc.trim_space("  a  b  ") != "a  b") {
    return 5;
  }

  let one: lexer.Comment[] = [c(4, " doc")];
  if (took(one, 0, 5) != "doc") {
    return 10;
  }
  if (took(one, 0, 6) != "") {
    return 11;
  }
  if (took(one, 0, 3) != "") {
    return 12;
  }
  if (took(one, 0, 4) != "") {
    return 13;
  }

  let run: lexer.Comment[] = [c(3, " first"), c(4, " second")];
  if (took(run, 0, 5) != "first\nsecond") {
    return 20;
  }
  let split: lexer.Comment[] = [c(2, " far"), c(4, " near")];
  if (took(split, 0, 5) != "near") {
    return 21;
  }
  if (ferndoc.take_doc(split, 0, 5).cursor != 2) {
    return 22;
  }
  if (took(split, 2, 9) != "") {
    return 23;
  }

  let two: lexer.Comment[] = [c(1, " a"), c(4, " b")];
  let t1: ferndoc.TakeResult = ferndoc.take_doc(two, 0, 2);
  if (t1.doc != "a" || t1.cursor != 1) {
    return 30;
  }
  let t2: ferndoc.TakeResult = ferndoc.take_doc(two, t1.cursor, 5);
  if (t2.doc != "b" || t2.cursor != 2) {
    return 31;
  }
  if (took(two, 2, 9) != "") {
    return 32;
  }
  if (took([], 0, 1) != "") {
    return 33;
  }

  if (took([c(1, " x")], 0, 1) != "") {
    return 34;
  }

  let hdr: lexer.Comment[] = [c(1, " Package foo."), c(2, " Second line.")];
  if (ferndoc.module_intro(hdr, 5) != "Package foo.\nSecond line.") {
    return 40;
  }
  if (ferndoc.module_intro(hdr, 3) != "") {
    return 41;
  }
  if (ferndoc.module_intro([c(2, " later")], 9) != "") {
    return 42;
  }
  if (ferndoc.module_intro([], 9) != "") {
    return 43;
  }
  if (ferndoc.module_intro(hdr, 0) != "Package foo.\nSecond line.") {
    return 44;
  }
  if (ferndoc.module_summary("std/csv — CSV escape / join (RFC 4180).\n\nMore.") != "CSV escape / join (RFC 4180).") {
    return 45;
  }
  if (ferndoc.module_summary("std/tz — the local time zone: a TZif file\n(RFC 8536). Second sentence.") != "The local time zone: a TZif file (RFC 8536).") {
    return 46;
  }
  if (ferndoc.module_summary("Arbitrary-precision integers.") != "Arbitrary-precision integers.") {
    return 47;
  }
  if (ferndoc.module_summary("std/f64 — f32 / f64 to-string formatting.") != "f32 / f64 to-string formatting.") {
    return 48;
  }
  if (ferndoc.module_summary("") != "") {
    return 49;
  }
  if (ferndoc.module_summary("Wrapped\nfirst line\n\nSecond paragraph.") != "Wrapped first line") {
    return 90;
  }
  if (ferndoc.module_summary("std/x — iOS-style toggles. Etc.") != "iOS-style toggles.") {
    return 91;
  }
  if (ferndoc.module_summary("x64 helpers.") != "x64 helpers.") {
    return 92;
  }

  let src: string = "// Header line.\n"
    + "\n"
    + "// Adds.\n"
    + "pub function add(a: i32, b: i32): i32 { return a + b; }\n"
    + "\n"
    + "// Private, and its doc goes nowhere.\n"
    + "function helper(): i32 { return 0; }\n"
    + "\n"
    + "// Detached.\n"
    + "\n"
    + "pub function bare(): i32 { return 1; }\n";
  let dm: ferndoc.DocModule = ferndoc.docs_of(src);
  if (dm.intro != "Header line.") {
    return 50;
  }
  if (dm.decls.len() != 2) {
    return 51;
  }
  if (dm.decls[0].name != "add" || dm.decls[0].doc != "Adds.") {
    return 52;
  }
  if (dm.decls[1].name != "bare" || dm.decls[1].doc != "") {
    return 53;
  }
  if (dm.decls[0].kind != "function") {
    return 54;
  }

  let src2: string = "// Point.\n"
    + "pub struct P { x: i32 }\n"
    + "\n"
    + "// Colour.\n"
    + "pub enum C { Red, Blue }\n"
    + "\n"
    + "// Maker.\n"
    + "pub function make(): i32 { return 0; }\n";
  let dm2: ferndoc.DocModule = ferndoc.docs_of(src2);
  if (dm2.intro != "") {
    return 60;
  }
  if (dm2.decls.len() != 3) {
    return 61;
  }
  if (dm2.decls[0].kind != "struct" || dm2.decls[0].name != "P") {
    return 62;
  }
  if (dm2.decls[0].doc != "Point.") {
    return 63;
  }
  if (dm2.decls[1].kind != "enum" || dm2.decls[1].name != "C") {
    return 64;
  }
  if (dm2.decls[1].doc != "Colour.") {
    return 65;
  }
  if (dm2.decls[2].kind != "function" || dm2.decls[2].name != "make") {
    return 66;
  }
  if (dm2.decls[2].doc != "Maker.") {
    return 67;
  }

  let src3: string = "// Hidden.\n"
    + "function priv(): i32 { return 0; }\n"
    + "// Also hidden.\n"
    + "pub function __internal(): i32 { return 0; }\n"
    + "// Shown.\n"
    + "pub function shown(): i32 { return 0; }\n";
  let dm3: ferndoc.DocModule = ferndoc.docs_of(src3);
  if (dm3.decls.len() != 1) {
    return 70;
  }
  if (dm3.decls[0].name != "shown" || dm3.decls[0].doc != "Shown.") {
    return 71;
  }

  let src4: string = "// Limit.\n"
    + "pub const MAX: i32 = 10;\n"
    + "// Zero.\n"
    + "pub function zero(): i32 { return 0; }\n"
    + "// Private, and skipped.\n"
    + "const HIDDEN: i32 = 1;\n";
  let dm4: ferndoc.DocModule = ferndoc.docs_of(src4);
  if (dm4.decls.len() != 2) {
    return 80;
  }
  if (dm4.decls[0].kind != "const" || dm4.decls[0].name != "MAX") {
    return 81;
  }
  if (dm4.decls[0].doc != "Limit.") {
    return 82;
  }
  if (dm4.decls[1].kind != "function" || dm4.decls[1].name != "zero") {
    return 83;
  }
  if (dm4.decls[1].doc != "Zero.") {
    return 84;
  }

  let src5: string = "// Kept.\n"
    + "pub const __RAW: i32 = 2;\n";
  let dm5: ferndoc.DocModule = ferndoc.docs_of(src5);
  if (dm5.decls.len() != 1) {
    return 85;
  }
  if (dm5.decls[0].kind != "const" || dm5.decls[0].name != "__RAW") {
    return 86;
  }

  let page: string = ferndoc.render_page("pub const A: i32 = 1;\npub const B = 2;\n", "std/x");
  if (!util.contains(page, "## `const A`\n\n```fern\npub const A: i32\n```\n")) {
    return 87;
  }
  if (!util.contains(page, "## `const B`\n\n```fern\npub const B\n```\n")) {
    return 88;
  }
  if (util.contains(page, "= 1")) {
    return 89;
  }

  return 0;
}

function main(): i32 {
  let rc: i32 = self_checks();
  if (rc != 0) {
    return rc;
  }
  print("ferndoc: association agrees");
  return 0;
}
