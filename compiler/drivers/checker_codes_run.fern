import "../lexer";
import "../parser";
import "./rundriver";
import "../checker";

function main(): i32 {
  let mod: parser.Module = rundriver.parse_stdin("checker_codes_run");
  let mt: checker.ModuleTypes = checker.check_module(mod);
  let i: i32 = 0;
  while (i < mt.diags.len()) {
    print(mt.diags[i].code + "\t" + mt.diags[i].message);
    i = i + 1;
  }
  if (mt.diags.len() > 0) {
    return 1;
  }
  return 0;
}
