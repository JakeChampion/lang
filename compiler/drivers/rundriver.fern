import "std/io";
import "../lexer";
import "../parser";

pub function parse_stdin(driver: string): parser.Module {
  let src: string = read_stdin(driver);
  let mod: parser.Module = parser.parse_module(lexer.tokenize(src));
  let _unresolved: boolean = parser.warn_unresolved_imports(mod, driver);
  return mod;
}

pub function read_stdin(driver: string): string {
  match (io.read_all_stdin()) {
    Ok(src) => {
      return src;
    },
    Err(_) => {
      eprint(driver + ": cannot read UTF-8 stdin");
      exit(1);
      return "";
    }
  }
}
