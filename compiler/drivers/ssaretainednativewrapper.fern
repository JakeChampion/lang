import "../asmcore";
import "../ir";
import "../ircore";
import "../irtables";
import "../physicalbody";
import "../semrecords";
import "../ssa";
import "../ssasem";
import "../ssaprepare";
import "../ssacreditbound" as bound;
import "../ssacreditemitted" as emitted;
import "../ssacreditselected" as selected;
import "../util";
import "./ssaretainedmutations" as mutations;

function require(ok: boolean, code: i32): void {
  if (!ok) {
    exit(code);
  }
}

pub function check(rows: ssaprepare.Emitted[], arch: string, ok: boolean): void {
  let p = emitted.check_wrapper_native(rows, "handoff", "replace", "__sem_drop_Parent", "__sem_release_Parent", ["require"], arch);
  if (p.ok != ok || p.function_name == "" || p.message == "") {
    print("native wrapper: " + p.function_name + ": " + p.message);
    exit(89);
  }
}

function wanted(name: string): boolean {
  return name == "handoff" || name == "replace" || name == "parent" || name == "require" || name == "__sem_release_Parent" || name == "__sem_drop_Parent";
}

function without(rows: ssaprepare.Emitted[], name: string): ssaprepare.Emitted[] {
  let out: ssaprepare.Emitted[] = [];
  for row in rows {
    if (row.label_name != name) {
      out = out.append(row);
    }
  }
  return out;
}

function metadata(row: ssaprepare.Emitted, m: physicalbody.Metadata): ssaprepare.Emitted {
  let s = physicalbody.Selected { producers: [m], origin: physicalbody.Origin { producer: 0, symbol: row.body.selected.origin.symbol, helper: None } };
  return ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, selected: s } };
}

function shortcut(rows: ssaprepare.Emitted[], row: ssaprepare.Emitted, arch: string): void {
  if (row.release_entry.unique_drop == "") {
    return;
  }
  let rest = without(rows, row.label_name);
  let other = "__sem_drop_Different";
  let lower = irtables.Lowered { ...row.body.lowered, ops: row.body.lowered.ops.with(4, ir.op_call_direct(other, 1)) };
  let context = ssaprepare.Context { ...row.context, reg_entries: irtables.sig_reg_of([asmcore.sanitize_label(other)]) };
  let entry = ircore.release_entry(lower, arch, context.rc_free_debug, context.reg_entries);
  require(entry.counted && entry.unique_drop == other, 90);
  check(rest.append(ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, lowered: lower }, context: context, release_entry: entry }), arch, false);
  context = ssaprepare.Context { ...row.context, reg_entries: irtables.sig_reg_of([]) };
  entry = ircore.release_entry(row.body.lowered, arch, context.rc_free_debug, context.reg_entries);
  check(rest.append(ssaprepare.Emitted { ...row, context: context, release_entry: entry }), arch, true);
}

function helper_schema(rows: ssaprepare.Emitted[], arch: string): void {
  let changed: ssaprepare.Emitted[] = [];
  for row in rows {
    if (row.label_name == "__sem_release_Parent" || row.label_name == "__sem_drop_Parent") {
      let m = selected.metadata(row);
      let records: semrecords.Record[] = [];
      for r in m.records.list {
        if (semrecords.name_of(r.ty) == "Leaf") {
          records = records.append(semrecords.Record { ...r, fields: [semrecords.Field { ...r.fields[0], name: "different" }] });
        } else {
          records = records.append(r);
        }
      }
      changed = changed.append(metadata(row, physicalbody.Metadata { ...m, records: semrecords.records_of(records) }));
    } else {
      changed = changed.append(row);
    }
  }
  let hits = 0;
  for row in rows {
    if (row.label_name == "replace") {
      let cs = selected.contracts(row);
      require(cs.len() == 1 && cs[0].params.len() == 2, 91);
      let pair = bound.release(changed, "__sem_release_Parent", "__sem_drop_Parent", arch, cs[0].params[0]);
      require(pair.error == "" && pair.rows.len() == 2, 92);
      hits += 1;
    }
  }
  require(hits == 1, 93);
  check(changed, arch, false);
}

function incoming_id(f: ssa.SFunc): i32 {
  for b in f.blocks {
    for op in b.insts {
      if (op.kind_tag == ssa.PARAM && op.imm == 1) {
        return op.result;
      }
    }
  }
  return -1;
}

function changed_instruction(row: ssaprepare.Emitted, block: i32, instruction: i32, op: ssa.SInst): ssaprepare.Emitted {
  let f = row.body.formed.f;
  let b = f.blocks[block];
  let next = ssa.SFunc { ...f, blocks: f.blocks.with(block, ssa.SBlock { ...b, insts: b.insts.with(instruction, op) }) };
  return ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, formed: ssa.Formed { ...row.body.formed, f: next } } };
}

function shape_header(op: ssa.SInst): boolean {
  return op.kind_tag == ssa.LD_AT && op.args.len() == 1 && op.imm == 0 && op.str == "";
}

function shape_comparison(op: ssa.SInst, header: i32): boolean {
  return op.kind_tag == ssa.BINARY && op.str == "eq" && op.args.len() == 2 && (op.args[0] == header || op.args[1] == header);
}

function header_checks(rows: ssaprepare.Emitted[], row: ssaprepare.Emitted, block: i32, instruction: i32, arch: string): void {
  let b = row.body.formed.f.blocks[block];
  let op = b.insts[instruction];
  let incoming = incoming_id(row.body.formed.f);
  require(incoming >= 0, 95);
  let rest = without(rows, row.label_name);
  for invalid in [ssa.SInst { ...op, args: [incoming] }, ssa.SInst { ...op, imm: 8 }] {
    check(rest.append(changed_instruction(row, block, instruction, invalid)), arch, false);
  }
  let comparisons = 0;
  let shape_constants = 0;
  let contracts = selected.contracts(row);
  let old_shape = semrecords.name_of(contracts[0].params[0]);
  for index in 0..b.insts.len() {
    let comparison = b.insts[index];
    if (shape_comparison(comparison, op.result)) {
      check(rest.append(changed_instruction(row, block, index, ssa.SInst { ...comparison, imm: 32 })), arch, false);
      comparisons += 1;
    }
    if (comparison.kind_tag == ssa.SHAPE_ADDR) {
      check(rest.append(changed_instruction(row, block, index, ssa.SInst { ...comparison, str: old_shape })), arch, false);
      shape_constants += 1;
    }
  }
  require(comparisons == 1 && shape_constants == 1, 96);
}

function allocation_flags(rows: ssaprepare.Emitted[], row: ssaprepare.Emitted, block: i32, instruction: i32, arch: string): void {
  let op = row.body.formed.f.blocks[block].insts[instruction];
  let rest = without(rows, row.label_name);
  check(rest.append(changed_instruction(row, block, instruction, ssa.SInst { ...op, imm: 0 })), arch, true);
  for invalid in [ssa.REUSE_NULL, 16] {
    check(rest.append(changed_instruction(row, block, instruction, ssa.SInst { ...op, imm: invalid })), arch, false);
  }
}

function shape_guards(rows: ssaprepare.Emitted[], row: ssaprepare.Emitted, arch: string): void {
  let f = row.body.formed.f;
  let headers = 0;
  let allocations = 0;
  for block in 0..f.blocks.len() {
    let b = f.blocks[block];
    for instruction in 0..b.insts.len() {
      if (shape_header(b.insts[instruction])) {
        header_checks(rows, row, block, instruction, arch);
        headers += 1;
      }
      let op = b.insts[instruction];
      if (ssa.reuse_alloc_call(op) && op.imm == ssa.REUSE_SPLIT) {
        allocation_flags(rows, row, block, instruction, arch);
        allocations += 1;
      }
    }
  }
  require(headers == 1 && allocations == 1, 97);
}

function boundary(rows: ssaprepare.Emitted[], row: ssaprepare.Emitted, arch: string): void {
  let rest = without(rows, row.label_name);
  check(rest, arch, false);
  check(rows.append(row), arch, false);
  check(rest.append(mutations.damaged(row)), arch, false);
  check(rest.append(ssaprepare.Emitted { ...row, release_entry: ssaprepare.ReleaseEntry { ...row.release_entry, counted: !row.release_entry.counted } }), arch, false);
  check(rest.append(ssaprepare.Emitted { ...row, release_entry: ssaprepare.ReleaseEntry { ...row.release_entry, unique_drop: "wrong" } }), arch, false);
  if (row.label_name != "require") {
    let m = selected.metadata(row);
    check(rest.append(metadata(row, physicalbody.Metadata { ...m, records: semrecords.no_records() })), arch, false);
    check(rest.append(metadata(row, physicalbody.Metadata { ...m, finalizers: [ssasem.Finalizer { receiver: "Leaf", symbol: "drop_leaf", writes: true }] })), arch, false);
  }
  if (row.label_name == "__sem_release_Parent") {
    check(rest.append(ssaprepare.Emitted { ...row, context: ssaprepare.Context { ...row.context, rc_free_debug: true } }), arch, false);
    shortcut(rows, row, arch);
  }
  if (row.label_name == "replace") {
    shape_guards(rows, row, arch);
  }
}

pub function run(rows: ssaprepare.Emitted[], arch: string): void {
  check(rows, arch, true);
  check([], arch, false);
  check(rows, "wasm32-wasi", false);
  let own: ssaprepare.Emitted[] = [];
  for row in rows {
    if (wanted(row.label_name)) {
      boundary(rows, row, arch);
      let m = selected.metadata(row);
      let separate = metadata(row, physicalbody.Metadata { ...m, contracts: selected.contracts(row) });
      own = util.append_all([separate], own);
    }
  }
  require(own.len() == 6, 94);
  check(own, arch, true);
  helper_schema(own, arch);
}
