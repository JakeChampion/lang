import "../ssadecrementtext" as text;
import "std/string";

function require(ok: boolean, group: string): void {
  if (!ok) {
    print("release storage controls failed: " + group);
    exit(180);
  }
}

function change(s: string, from: string, to: string): string {
  let parts = s.split(from);
  require(parts.len() > 1, "mutation present: " + from);
  return parts.join(to);
}

function mutation(s: string, from: string, to: string, expected: boolean): void {
  require(text.release_storage(change(s, from, to)) == expected, from + " -> " + to);
}

function fixture(): string {
  return ".bss\n.align 8\n__fern_heap_base: .quad 0\n.align 8\n.globl __fern_heap_end\n__fern_heap_end: .quad 0\n.align 8\n__fern_freelist: .skip 524288\n.align 8\n__fern_large_freelist: .skip 360\n";
}

function extents(s: string): void {
  for tail in [".skip 524287", ".skip 0", ".skip 4294967296", ".skip 9999999999", ".skip -1", ".quad 0", ".zero 1", "", ".align 8"] {
    mutation(s, "__fern_freelist: .skip 524288", "__fern_freelist: " + tail, false);
  }
  for tail in [".zero 524288", ".skip 524288,0", ".skip 524296", ".skip 999999999"] {
    mutation(s, "__fern_freelist: .skip 524288", "__fern_freelist: " + tail, true);
  }
  mutation(s, "__fern_large_freelist: .skip 360", "__fern_large_freelist: .skip 359", false);
  mutation(s, "__fern_large_freelist: .skip 360", "__fern_large_freelist: .zero 360", true);
  for name in ["__fern_heap_base", "__fern_heap_end"] {
    for tail in [".long 0", ".byte 0", ".skip 7", ".quad 1", ".quad 0,0", ".skip 8,0,0", ".skip 8,1"] {
      mutation(s, name + ": .quad 0", name + ": " + tail, false);
    }
    mutation(s, name + ": .quad 0", name + ": .zero 8", true);
    mutation(s, name + ": .quad 0", name + ": .skip 16,0", true);
  }
}

function alignments(s: string): void {
  for line in ["", ".align 0", ".align 1", ".align 4", ".align 24", ".align 8,0", ".align 4294967296", ".align 8\n.byte 0", ".align 8\nother: .quad 0", ".align 8\n.text", ".align 8\n.section .rodata"] {
    mutation(s, ".align 8", line, false);
  }
  for line in [".align 16", ".align 32", ".align 64", ".align 0008"] {
    mutation(s, ".align 8", line, true);
  }
  mutation(s, ".globl __fern_heap_end", ".globl __fern_heap_end\n.globl __fern_heap_end", true);
  mutation(s, ".globl __fern_heap_end", ".globl __fern_heap_base", false);
  mutation(s, ".globl __fern_heap_end", ".globl __fern_heap_end\n.byte 0", false);
  mutation(s, ".globl __fern_heap_end", "alias: .globl __fern_heap_end", false);
}

function namespace(s: string): void {
  for name in ["__fern_heap_base", "__fern_heap_end", "__fern_freelist", "__fern_large_freelist"] {
    mutation(s, name + ":", "missing_" + name + ":", false);
    require(!text.release_storage(s + ".text\n" + name + ":\nret\n"), "duplicate executable: " + name);
    require(!text.release_storage(s + ".data\n" + name + ": .quad 0\n"), "duplicate data: " + name);
    require(!text.release_storage(".set alias, " + name + "\n" + s), "symbol alias");
  }
  for before in ["alias:\n", "alias: .skip 0\n", "alias: .zero 000\n", "alias: .skip 4294967296\n", "alias = __fern_freelist\n"] {
    mutation(s, ".align 8", before + ".align 8", false);
  }
  require(text.release_storage(".bss\nneighbor: .byte 0\n" + s), "distinct neighbor allocation");
  mutation(s, ".align 8", "neighbor: .byte 0\n.align 8", false);
  require(!text.release_storage(".bss\nneighbor: .byte 0\n" + s + "neighbor: .quad 0\n"), "duplicate unrelated writable definition");
  require(!text.release_storage(".bss\nneighbor: .byte 0\n" + s + ".text\nneighbor:\nret\n"), "writable and executable name collision");
  mutation(s, ".align 8", ".byte 0\n.align 8", true);
  mutation(s, ".bss", ".data", true);
  mutation(s, ".bss", ".section .rodata", false);
  mutation(s, ".bss", ".text", false);
  mutation(s, "\n", "\r\n\t", true);
  require(!text.release_storage(".data\n.quad -1\n" + s), "signed static data remains outside scanner scope");
  require(!text.release_storage(".data\nstatic_label:\n.quad 0\n" + s), "bare static label remains outside scope");
}

pub function run(output: string): void {
  require(text.release_storage(output), "actual complete output");
  mutation(output, "__fern_large_freelist: .skip 20480", "__fern_large_freelist: .skip 360", true);
  mutation(output, "__fern_large_freelist: .skip 20480", "__fern_large_freelist: .skip 359", false);
  mutation(output, "__fern_freelist: .skip 524288", "__fern_freelist: .skip 524280", false);
  let s = fixture();
  require(text.release_storage(s), "declarations alone are data, not effect proof");
  require(!text.release_storage(""), "empty input");
  extents(s);
  alignments(s);
  namespace(s);
  require(text.counter_storage(output), "old counter API unchanged");
  require(!text.counter_storage(change(output, ".align 8", ".align 16")), "old exact counter alignment policy retained");
}
