import "../ir";
import "../util";

function render(ops: ir.Op[]): string {
  let s: string = "";
  let i: i32 = 0;
  while (i < ops.len()) {
    if (i > 0) {
      s = s + " ; ";
    }
    s = s + ir.render_op(ops[i]);
    i = i + 1;
  }
  return s;
}

function bool_word(b: boolean): string {
  if (b) {
    return "true";
  }
  return "false";
}

function optimize(ops: ir.Op[]): ir.Op[] {
  return ir.optimize_ops(ops, 0, 4).ops;
}

function base(): ir.Op {
  return ir.op_load_local(0);
}

function case_bin(label: string, k: i32, kind: string, width: i32): string {
  let ops: ir.Op[] = [base(), ir.op_const_i32(k), ir.op_bin(kind, width, false)];
  return label + ": " + render(ir.reduce_strength(ops)) + "\n";
}

function main(): i32 {
  let out: string = "";

  out = out + case_bin("mul_1", 1, "mul", 0);
  out = out + case_bin("mul_0", 0, "mul", 0);
  out = out + case_bin("mul_8", 8, "mul", 0);
  out = out + case_bin("mul_2", 2, "mul", 0);
  out = out + case_bin("mul_3", 3, "mul", 0);
  out = out + case_bin("mul_neg8", 0 - 8, "mul", 0);

  out = out + case_bin("add_0", 0, "add", 0);
  out = out + case_bin("sub_0", 0, "sub", 0);
  out = out + case_bin("or_0", 0, "or", 0);
  out = out + case_bin("xor_0", 0, "xor", 0);
  out = out + case_bin("shl_0", 0, "shl", 0);
  out = out + case_bin("shr_s_0", 0, "shr_s", 0);
  out = out + case_bin("shr_u_0", 0, "shr_u", 0);
  out = out + case_bin("add_1", 1, "add", 0);

  out = out + case_bin("and_0", 0, "and", 0);
  out = out + case_bin("and_neg1", 0 - 1, "and", 0);
  out = out + case_bin("and_7", 7, "and", 0);

  out = out + case_bin("div_s_1", 1, "div_s", 0);
  out = out + case_bin("div_s_8", 8, "div_s", 0);
  out = out + case_bin("div_u_1", 1, "div_u", 0);
  out = out + case_bin("div_u_8", 8, "div_u", 0);
  out = out + case_bin("div_u_6", 6, "div_u", 0);
  out = out + case_bin("rem_s_1", 1, "rem_s", 0);
  out = out + case_bin("rem_s_8", 8, "rem_s", 0);
  out = out + case_bin("rem_u_1", 1, "rem_u", 0);
  out = out + case_bin("rem_u_8", 8, "rem_u", 0);
  out = out + case_bin("rem_u_6", 6, "rem_u", 0);

  out = out + case_bin("mul_8_w64", 8, "mul", 64);
  out = out + case_bin("add_0_w64", 0, "add", 64);

  let textdec: ir.Op[] = [base(), ir.op_const_i32_text("8"), ir.op_bin("mul", 0, false)];
  out = out + "mul_text_8: " + render(ir.reduce_strength(textdec)) + "\n";
  let texthex: ir.Op[] = [base(), ir.op_const_i32_text("0x10"), ir.op_bin("mul", 0, false)];
  out = out + "mul_text_hex: " + render(ir.reduce_strength(texthex)) + "\n";

  let chain: ir.Op[] = [
    base(), ir.op_const_i32(4), ir.op_bin("mul", 0, false),
    ir.op_const_i32(2), ir.op_bin("mul", 0, false),
  ];
  out = out + "chain: " + render(ir.reduce_strength(chain)) + "\n";

  let fold_then: ir.Op[] = [
    base(), ir.op_const_i32(2), ir.op_const_i32(2),
    ir.op_bin("add", 0, false), ir.op_bin("mul", 0, false),
  ];
  out = out + "fold_then_strength: " + render(optimize(fold_then)) + "\n";

  let strength_then: ir.Op[] = [
    base(), ir.op_const_i32(0), ir.op_bin("mul", 0, false),
    ir.op_const_i32(5), ir.op_bin("add", 0, false),
  ];
  let once: ir.Op[] = optimize(strength_then);
  out = out + "strength_then_fold: " + render(once) + "\n";

  let twice: ir.Op[] = optimize(once);
  let stable: i32 = 0;
  if (render(twice) == render(once)) {
    stable = 1;
  }
  out = out + "idempotent=" + util.i32_to_string(stable) + "\n";

  let arm: ir.Op[] = [ir.op_block(0), ir.op_const_i32(1), ir.op_return(), ir.op_br(1), ir.op_end()];
  out = out + "dce_arm: " + render(ir.eliminate_dead_code(arm)) + "\n";

  let afterbr: ir.Op[] = [
    ir.op_block(0), ir.op_br(0), ir.op_const_i32(1), ir.op_drop(), ir.op_end(),
    ir.op_const_i32(2), ir.op_drop(),
  ];
  out = out + "dce_after_br: " + render(ir.eliminate_dead_code(afterbr)) + "\n";

  let afterbrif: ir.Op[] = [ir.op_block(0), ir.op_brif(0), ir.op_const_i32(1), ir.op_drop(), ir.op_end()];
  out = out + "dce_after_brif: " + render(ir.eliminate_dead_code(afterbrif)) + "\n";

  let arms: ir.Op[] = [
    ir.op_if(0), ir.op_return(), ir.op_const_i32(1), ir.op_drop(),
    ir.op_else(), ir.op_const_i32(2), ir.op_drop(), ir.op_end(),
  ];
  out = out + "dce_else_revives: " + render(ir.eliminate_dead_code(arms)) + "\n";

  let nested: ir.Op[] = [
    ir.op_const_i32(1), ir.op_return(),
    ir.op_block(0), ir.op_const_i32(2), ir.op_drop(), ir.op_end(),
    ir.op_const_i32(3), ir.op_drop(),
  ];
  out = out + "dce_nested_dead: " + render(ir.eliminate_dead_code(nested)) + "\n";

  let ex: ir.Op[] = [ir.op_const_i32(3), ir.op_exit(), ir.op_drop(), ir.op_const_i32(0), ir.op_return()];
  out = out + "dce_exit_kept: " + render(ir.eliminate_dead_code(ex)) + "\n";

  let live: ir.Op[] = [ir.op_load_local(0), ir.op_const_i32(1), ir.op_bin("add", 0, false), ir.op_return()];
  out = out + "dce_live: " + render(ir.eliminate_dead_code(live)) + "\n";

  let dce_once: ir.Op[] = ir.eliminate_dead_code(arm);
  let dce_twice: ir.Op[] = ir.eliminate_dead_code(dce_once);
  let dce_stable: i32 = 0;
  if (render(dce_twice) == render(dce_once)) {
    dce_stable = 1;
  }
  out = out + "dce_idempotent=" + util.i32_to_string(dce_stable) + "\n";

  let both: ir.Op[] = [
    ir.op_const_i32(2), ir.op_const_i32(2), ir.op_bin("add", 0, false),
    ir.op_return(), ir.op_const_i32(9), ir.op_drop(),
  ];
  out = out + "dce_in_optimize: " + render(optimize(both)) + "\n";

  let tee_hit: ir.Op[] = [ir.op_const_i32(5), ir.op_store_local(0), ir.op_load_local(0), ir.op_return()];
  out = out + "tee_fused: " + render(ir.fuse_tee(tee_hit)) + "\n";

  let tee_slot: ir.Op[] = [ir.op_const_i32(5), ir.op_store_local(0), ir.op_load_local(1)];
  out = out + "tee_other_slot: " + render(ir.fuse_tee(tee_slot)) + "\n";

  let tee_gap: ir.Op[] = [ir.op_const_i32(5), ir.op_store_local(0), ir.op_const_i32(1), ir.op_drop(), ir.op_load_local(0)];
  out = out + "tee_gap: " + render(ir.fuse_tee(tee_gap)) + "\n";

  let tee_rev: ir.Op[] = [ir.op_load_local(0), ir.op_store_local(0)];
  out = out + "tee_reversed: " + render(ir.fuse_tee(tee_rev)) + "\n";

  let tee_two: ir.Op[] = [ir.op_store_local(0), ir.op_load_local(0), ir.op_store_local(1), ir.op_load_local(1)];
  out = out + "tee_two: " + render(ir.fuse_tee(tee_two)) + "\n";

  let tee_once: ir.Op[] = ir.fuse_tee(tee_hit);
  let tee_stable: i32 = 0;
  if (render(ir.fuse_tee(tee_once)) == render(tee_once)) {
    tee_stable = 1;
  }
  out = out + "tee_idempotent=" + util.i32_to_string(tee_stable) + "\n";

  let tee_opt: ir.Op[] = [ir.op_const_i32(4), ir.op_store_local(0), ir.op_load_local(0), ir.op_return()];
  out = out + "tee_in_optimize: " + render(optimize(tee_opt)) + "\n";

  let cp_dead: ir.Op[] = [ir.op_const_i32(7), ir.op_tee_local(0), ir.op_const_i32(2), ir.op_bin("mul", 0, false)];
  out = out + "cp_dead_tee: " + render(ir.propagate_copies(cp_dead)) + "\n";

  let cp_read: ir.Op[] = [ir.op_const_i32(7), ir.op_tee_local(0), ir.op_load_local(0), ir.op_bin("add", 0, false)];
  out = out + "cp_live_read: " + render(ir.propagate_copies(cp_read)) + "\n";

  let cp_store: ir.Op[] = [ir.op_const_i32(7), ir.op_tee_local(0), ir.op_const_i32(1), ir.op_store_local(0)];
  out = out + "cp_live_store: " + render(ir.propagate_copies(cp_store)) + "\n";

  let cp_two: ir.Op[] = [ir.op_const_i32(7), ir.op_tee_local(0), ir.op_const_i32(8), ir.op_tee_local(0)];
  out = out + "cp_two_tees: " + render(ir.propagate_copies(cp_two)) + "\n";

  let cp_st: ir.Op[] = [ir.op_const_i32(7), ir.op_store_local(3)];
  out = out + "cp_store_kept: " + render(ir.propagate_copies(cp_st)) + "\n";

  let cp_pipeline: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_load_local(0),
    ir.op_const_i32(2), ir.op_bin("mul", 0, false), ir.op_return(),
  ];
  out = out + "cp_pipeline: " + render(optimize(cp_pipeline)) + "\n";

  let kp_far: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_call_direct("side", 0), ir.op_drop(),
    ir.op_load_local(0), ir.op_const_i32(3), ir.op_bin("add", 0, false),
  ];
  out = out + "kp_far: " + render(ir.const_propagate(kp_far)) + "\n";

  let kp_cf: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_const_i32(1), ir.op_if(0), ir.op_end(),
    ir.op_load_local(0),
  ];
  out = out + "kp_if_untouched: " + render(ir.const_propagate(kp_cf)) + "\n";

  let kp_if_w: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_const_i32(1), ir.op_if(0),
    ir.op_call_direct("side", 0), ir.op_store_local(0), ir.op_end(),
    ir.op_load_local(0),
  ];
  out = out + "kp_if_written: " + render(ir.const_propagate(kp_if_w)) + "\n";

  let kp_else_w: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_const_i32(1), ir.op_if(0),
    ir.op_load_local(0), ir.op_drop(), ir.op_else(),
    ir.op_call_direct("side", 0), ir.op_store_local(0), ir.op_end(),
    ir.op_load_local(0),
  ];
  out = out + "kp_else_written: " + render(ir.const_propagate(kp_else_w)) + "\n";

  let kp_blk: ir.Op[] = [
    ir.op_block(0), ir.op_const_i32(7), ir.op_store_local(0), ir.op_end(),
    ir.op_load_local(0),
  ];
  out = out + "kp_block_straight: " + render(ir.const_propagate(kp_blk)) + "\n";

  let kp_blk_br: ir.Op[] = [
    ir.op_block(0), ir.op_const_i32(1), ir.op_brif(0),
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_end(),
    ir.op_load_local(0),
  ];
  out = out + "kp_block_branched: " + render(ir.const_propagate(kp_blk_br)) + "\n";

  let kp_loop: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_loop(0),
    ir.op_load_local(0), ir.op_drop(), ir.op_end(),
    ir.op_load_local(0),
  ];
  out = out + "kp_loop_invariant: " + render(ir.const_propagate(kp_loop)) + "\n";

  let kp_loop_w: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_loop(0),
    ir.op_load_local(0), ir.op_drop(),
    ir.op_call_direct("side", 0), ir.op_store_local(0), ir.op_end(),
    ir.op_load_local(0),
  ];
  out = out + "kp_loop_written: " + render(ir.const_propagate(kp_loop_w)) + "\n";

  let kp_deep: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_const_i32(1), ir.op_if(0),
    ir.op_block(0), ir.op_load_local(0), ir.op_const_i32(3),
    ir.op_bin("add", 0, false), ir.op_drop(), ir.op_end(), ir.op_end(),
    ir.op_return(),
  ];
  out = out + "kp_nested: " + render(ir.const_propagate(kp_deep)) + "\n";

  let kp_kill: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_call_direct("side", 0),
    ir.op_store_local(0), ir.op_load_local(0),
  ];
  out = out + "kp_killed: " + render(ir.const_propagate(kp_kill)) + "\n";

  let kp_text: ir.Op[] = [
    ir.op_const_i32_text("7"), ir.op_store_local(0), ir.op_call_direct("side", 0),
    ir.op_drop(), ir.op_load_local(0),
  ];
  out = out + "kp_text: " + render(ir.const_propagate(kp_text)) + "\n";

  let kp_hex: ir.Op[] = [
    ir.op_const_i32_text("0x10"), ir.op_store_local(0), ir.op_call_direct("side", 0),
    ir.op_drop(), ir.op_load_local(0),
  ];
  out = out + "kp_hex_refused: " + render(ir.const_propagate(kp_hex)) + "\n";

  let kp_chain: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_load_local(0),
    ir.op_store_local(1), ir.op_load_local(1), ir.op_return(),
  ];
  out = out + "kp_chain: " + render(ir.const_propagate(kp_chain)) + "\n";

  let kp_view: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(1), ir.op_str_slice_frame(1),
    ir.op_drop(), ir.op_load_local(1),
  ];
  out = out + "kp_frame_write: " + render(ir.const_propagate(kp_view)) + "\n";
  let kp_heap: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(1), ir.op_str_slice(),
    ir.op_drop(), ir.op_load_local(1),
  ];
  out = out + "kp_heap_slice_kept: " + render(ir.const_propagate(kp_heap)) + "\n";

  let kp_view_loop: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(1), ir.op_loop(0),
    ir.op_load_local(1), ir.op_drop(), ir.op_str_slice_frame(1),
    ir.op_drop(), ir.op_end(), ir.op_load_local(1),
  ];
  out = out + "kp_frame_write_in_loop: " + render(ir.const_propagate(kp_view_loop)) + "\n";

  let kp_once: ir.Op[] = ir.const_propagate(kp_deep);
  let kp_stable: i32 = 0;
  if (render(ir.const_propagate(kp_once)) == render(kp_once)) {
    kp_stable = 1;
  }
  out = out + "kp_idempotent=" + util.i32_to_string(kp_stable) + "\n";

  let kp_opt: ir.Op[] = [
    ir.op_const_i32(7), ir.op_store_local(0), ir.op_const_i32(1), ir.op_if(0),
    ir.op_load_local(0), ir.op_const_i32(3), ir.op_bin("add", 0, false),
    ir.op_drop(), ir.op_end(), ir.op_return(),
  ];
  out = out + "kp_in_optimize: " + render(optimize(kp_opt)) + "\n";

  let nf_zero: ir.Op[] = [ir.op_const_i32(0), ir.op_bin("not", 0, false)];
  out = out + "nf_zero: " + render(ir.fold_const_binaries(nf_zero)) + "\n";
  let nf_nonzero: ir.Op[] = [ir.op_const_i32(7), ir.op_bin("not", 0, false)];
  out = out + "nf_nonzero: " + render(ir.fold_const_binaries(nf_nonzero)) + "\n";

  let nf_text: ir.Op[] = [ir.op_const_i32_text("0"), ir.op_bin("not", 0, false)];
  out = out + "nf_text: " + render(ir.fold_const_binaries(nf_text)) + "\n";
  let nf_hex: ir.Op[] = [ir.op_const_i32_text("0x10"), ir.op_bin("not", 0, false)];
  out = out + "nf_hex_refused: " + render(ir.fold_const_binaries(nf_hex)) + "\n";

  let nf_opaque: ir.Op[] = [ir.op_load_local(0), ir.op_bin("not", 0, false)];
  out = out + "nf_opaque_refused: " + render(ir.fold_const_binaries(nf_opaque)) + "\n";

  let nf_while: ir.Op[] = [ir.op_const_i32(1), ir.op_bin("not", 0, false), ir.op_brif(1)];
  out = out + "nf_while_true_test_gone: " + render(ir.fold_const_binaries(nf_while)) + "\n";

  let nf_tail: ir.Op[] = [ir.op_load_local(0), ir.op_drop(), ir.op_const_i32(0), ir.op_bin("not", 0, false)];
  out = out + "nf_at_tail: " + render(ir.fold_const_binaries(nf_tail)) + "\n";

  let pi_true: ir.Op[] = [
    ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(7), ir.op_drop(),
    ir.op_else(), ir.op_const_i32(8), ir.op_drop(), ir.op_end(), ir.op_return(),
  ];
  out = out + "pi_true_arm: " + render(ir.fold_const_binaries(pi_true)) + "\n";
  let pi_false: ir.Op[] = [
    ir.op_const_i32(0), ir.op_if(0), ir.op_const_i32(7), ir.op_drop(),
    ir.op_else(), ir.op_const_i32(8), ir.op_drop(), ir.op_end(), ir.op_return(),
  ];
  out = out + "pi_false_arm: " + render(ir.fold_const_binaries(pi_false)) + "\n";

  let pi_none: ir.Op[] = [
    ir.op_const_i32(0), ir.op_if(0), ir.op_const_i32(7), ir.op_drop(),
    ir.op_end(), ir.op_return(),
  ];
  out = out + "pi_false_no_else: " + render(ir.fold_const_binaries(pi_none)) + "\n";

  let pi_esc: ir.Op[] = [
    ir.op_block(0), ir.op_const_i32(1), ir.op_if(0),
    ir.op_br(1), ir.op_end(), ir.op_end(), ir.op_return(),
  ];
  out = out + "pi_escaping_wrapped: " + render(ir.fold_const_binaries(pi_esc)) + "\n";

  let pi_local: ir.Op[] = [
    ir.op_const_i32(1), ir.op_if(0), ir.op_block(0), ir.op_const_i32(1),
    ir.op_brif(0), ir.op_end(), ir.op_end(), ir.op_return(),
  ];
  out = out + "pi_local_branch_bare: " + render(ir.fold_const_binaries(pi_local)) + "\n";

  let pi_hex: ir.Op[] = [
    ir.op_const_i32_text("0x10"), ir.op_if(0), ir.op_const_i32(7),
    ir.op_drop(), ir.op_end(),
  ];
  out = out + "pi_hex_refused: " + render(ir.fold_const_binaries(pi_hex)) + "\n";
  let pi_typed: ir.Op[] = [ir.op_const_i32(1), ir.op_if(1), ir.op_const_i32(7), ir.op_end()];
  out = out + "pi_typed_refused: " + render(ir.fold_const_binaries(pi_typed)) + "\n";

  let pi_open: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(7), ir.op_drop()];
  out = out + "pi_unclosed_refused: " + render(ir.fold_const_binaries(pi_open)) + "\n";

  let pb_zero: ir.Op[] = [
    ir.op_block(0), ir.op_const_i32(0), ir.op_brif(0),
    ir.op_const_i32(7), ir.op_drop(), ir.op_end(),
  ];
  out = out + "pb_zero_dropped: " + render(ir.fold_const_binaries(pb_zero)) + "\n";
  let pb_one: ir.Op[] = [
    ir.op_block(0), ir.op_const_i32(1), ir.op_brif(0),
    ir.op_const_i32(7), ir.op_drop(), ir.op_end(),
  ];
  out = out + "pb_one_becomes_br: " + render(ir.fold_const_binaries(pb_one)) + "\n";

  let pi_nest: ir.Op[] = [
    ir.op_const_i32(1), ir.op_if(0),
    ir.op_const_i32(0), ir.op_if(0), ir.op_const_i32(7), ir.op_drop(),
    ir.op_else(), ir.op_const_i32(2), ir.op_const_i32(3),
    ir.op_bin("add", 0, false), ir.op_drop(), ir.op_end(),
    ir.op_end(), ir.op_return(),
  ];
  out = out + "pi_nested_cascade: " + render(ir.fold_const_binaries(pi_nest)) + "\n";

  let pi_once: ir.Op[] = ir.fold_const_binaries(pi_nest);
  let pi_stable: i32 = 0;
  if (render(ir.fold_const_binaries(pi_once)) == render(pi_once)) {
    pi_stable = 1;
  }
  out = out + "pi_idempotent=" + util.i32_to_string(pi_stable) + "\n";
  let pw_loop: ir.Op[] = [
    ir.op_loop(0), ir.op_const_i32(1), ir.op_bin("not", 0, false),
    ir.op_brif(1), ir.op_const_i32(7), ir.op_drop(), ir.op_br(0),
    ir.op_end(), ir.op_return(),
  ];
  out = out + "pw_while_true_in_optimize: " + render(optimize(pw_loop)) + "\n";

  let wc_nested: ir.Op[] = [
    ir.op_const_i32(1), ir.op_const_i32(2), ir.op_const_i32(3),
    ir.op_bin("mul", 0, false), ir.op_int_cast("i32"),
    ir.op_bin("add", 0, false), ir.op_int_cast("i32"),
  ];
  out = out + "wc_nested: " + render(ir.fold_const_binaries(wc_nested)) + "\n";

  let wc_u8: ir.Op[] = [ir.op_const_i32(300), ir.op_int_cast("u8")];
  out = out + "wc_u8_masks: " + render(ir.fold_const_binaries(wc_u8)) + "\n";

  let wc_u32: ir.Op[] = [ir.op_const_i32(9), ir.op_int_cast("u32")];
  out = out + "wc_u32: " + render(ir.fold_const_binaries(wc_u32)) + "\n";
  let wc_u32_neg: ir.Op[] = [ir.op_const_i32(0 - 1), ir.op_int_cast("u32")];
  out = out + "wc_u32_neg_refused: " + render(ir.fold_const_binaries(wc_u32_neg)) + "\n";
  let wc_wrap: ir.Op[] = [ir.op_const_i32(9), ir.op_u32_wrap()];
  out = out + "wc_u32_wrap: " + render(ir.fold_const_binaries(wc_wrap)) + "\n";
  let wc_wrap_neg: ir.Op[] = [ir.op_const_i32(0 - 1), ir.op_u32_wrap()];
  out = out + "wc_u32_wrap_neg_refused: " + render(ir.fold_const_binaries(wc_wrap_neg)) + "\n";

  let wc_ext: ir.Op[] = [ir.op_const_i32(9), ir.op_int_extend(false)];
  out = out + "wc_int_extend: " + render(ir.fold_const_binaries(wc_ext)) + "\n";
  let wc_narrow: ir.Op[] = [ir.op_const_i32(9), ir.op_int_wrap(false)];
  out = out + "wc_int_wrap_refused: " + render(ir.fold_const_binaries(wc_narrow)) + "\n";

  let wc_hex: ir.Op[] = [ir.op_const_i32_text("0x10"), ir.op_int_cast("i32")];
  out = out + "wc_hex_refused: " + render(ir.fold_const_binaries(wc_hex)) + "\n";

  let wc_opaque: ir.Op[] = [ir.op_load_local(0), ir.op_int_cast("i32")];
  out = out + "wc_opaque_refused: " + render(ir.fold_const_binaries(wc_opaque)) + "\n";

  let zg_body: ir.Op[] = [
    ir.op_load_local(1), ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_if(0), ir.op_load_local(1), ir.op_call_direct("__fern_arr_dec", 1),
    ir.op_drop(), ir.op_end(), ir.op_return(),
  ];
  out = out + "zg_fires: " + render(ir.prune_zero_slot_guards(zg_body, 0)) + "\n";

  out = out + "zg_param_refused: " + render(ir.prune_zero_slot_guards(zg_body, 2)) + "\n";

  let zg_loop: ir.Op[] = [
    ir.op_loop(0), ir.op_load_local(1),
    ir.op_call_direct("__fern_rc_is_unique", 1), ir.op_if(0),
    ir.op_end(), ir.op_br(0), ir.op_end(),
  ];
  out = out + "zg_in_loop_refused: " + render(ir.prune_zero_slot_guards(zg_loop, 0)) + "\n";
  let zg_past_loop: ir.Op[] = [
    ir.op_loop(0), ir.op_br(0), ir.op_end(), ir.op_load_local(1),
    ir.op_call_direct("__fern_rc_is_unique", 1),
  ];
  out = out + "zg_past_loop_fires: " + render(ir.prune_zero_slot_guards(zg_past_loop, 0)) + "\n";

  let zg_written: ir.Op[] = [
    ir.op_call_direct("mk", 0), ir.op_store_local(1),
    ir.op_load_local(1), ir.op_call_direct("__fern_rc_is_unique", 1),
  ];
  out = out + "zg_written_refused: " + render(ir.prune_zero_slot_guards(zg_written, 0)) + "\n";
  let zg_late: ir.Op[] = [
    ir.op_load_local(1), ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_if(0), ir.op_end(), ir.op_call_direct("mk", 0),
    ir.op_store_local(1),
  ];
  out = out + "zg_late_write_fires: " + render(ir.prune_zero_slot_guards(zg_late, 0)) + "\n";

  let zg_rezero: ir.Op[] = [
    ir.op_const_i32(0), ir.op_store_local(1), ir.op_load_local(1),
    ir.op_call_direct("__fern_rc_is_unique", 1),
  ];
  out = out + "zg_rezero_fires: " + render(ir.prune_zero_slot_guards(zg_rezero, 0)) + "\n";

  let zg_frame: ir.Op[] = [
    ir.op_str_slice_frame(1), ir.op_drop(), ir.op_load_local(1),
    ir.op_call_direct("__fern_rc_is_unique", 1),
  ];
  out = out + "zg_frame_write_refused: " + render(ir.prune_zero_slot_guards(zg_frame, 0)) + "\n";

  out = out + "zg_in_optimize: " + render(optimize(zg_body)) + "\n";

  let zg_once: ir.Op[] = ir.prune_zero_slot_guards(zg_body, 0);
  let zg_stable: i32 = 0;
  if (render(ir.prune_zero_slot_guards(zg_once, 0)) == render(zg_once)) {
    zg_stable = 1;
  }
  out = out + "zg_idempotent=" + util.i32_to_string(zg_stable) + "\n";

  let f64_neg: ir.Op[] = [ir.op_const_i64_text("0"), ir.op_const_i64_text("3"), ir.op_bin("sub", 64, false)];
  out = out + "f64_neg: " + render(ir.fold_const_binaries(f64_neg)) + "\n";
  let f64_mul: ir.Op[] = [ir.op_const_i64_text("4294967296"), ir.op_const_i64_text("4294967296"), ir.op_bin("mul", 64, false)];
  out = out + "f64_mul_wraps: " + render(ir.fold_const_binaries(f64_mul)) + "\n";
  let f64_cmp: ir.Op[] = [ir.op_const_i64_text("5000000000"), ir.op_const_i64_text("7"), ir.op_bin("gt_s", 64, false)];
  out = out + "f64_cmp: " + render(ir.fold_const_binaries(f64_cmp)) + "\n";
  let f64_div0: ir.Op[] = [ir.op_const_i64_text("7"), ir.op_const_i64_text("0"), ir.op_bin("div_s", 64, false)];
  out = out + "f64_div_zero_refused: " + render(ir.fold_const_binaries(f64_div0)) + "\n";
  let f64_min: ir.Op[] = [ir.op_const_i64_text("-9223372036854775808"), ir.op_const_i64_text("-1"), ir.op_bin("div_s", 64, false)];
  out = out + "f64_min_div_refused: " + render(ir.fold_const_binaries(f64_min)) + "\n";
  let f64_minr: ir.Op[] = [ir.op_const_i64_text("-9223372036854775808"), ir.op_const_i64_text("-1"), ir.op_bin("rem_s", 64, false)];
  out = out + "f64_min_rem: " + render(ir.fold_const_binaries(f64_minr)) + "\n";
  let f64_uns: ir.Op[] = [ir.op_const_i64_text("-8"), ir.op_const_i64_text("1"), ir.op_bin("shr_s", 64, true)];
  out = out + "f64_unsigned_refused: " + render(ir.fold_const_binaries(f64_uns)) + "\n";
  let f64_hex: ir.Op[] = [ir.op_const_i64_text("0x10"), ir.op_const_i64_text("1"), ir.op_bin("add", 64, false)];
  out = out + "f64_hex_refused: " + render(ir.fold_const_binaries(f64_hex)) + "\n";
  let f64_ext: ir.Op[] = [ir.op_const_i32(-1), ir.op_int_extend(false)];
  out = out + "f64_extend_s: " + render(ir.fold_const_binaries(f64_ext)) + "\n";
  let f64_extu: ir.Op[] = [ir.op_const_i32(-1), ir.op_int_extend(true)];
  out = out + "f64_extend_u: " + render(ir.fold_const_binaries(f64_extu)) + "\n";
  let f64_extp: ir.Op[] = [ir.op_const_i32(100), ir.op_int_extend_ptr()];
  out = out + "f64_extend_ptr_refused: " + render(ir.fold_const_binaries(f64_extp)) + "\n";
  let f64_wrap: ir.Op[] = [ir.op_const_i64_text("4294967297"), ir.op_int_wrap(false)];
  out = out + "f64_wrap: " + render(ir.fold_const_binaries(f64_wrap)) + "\n";
  let f64_wrapu: ir.Op[] = [ir.op_const_i64_text("3000000000"), ir.op_int_wrap(true)];
  out = out + "f64_wrap_u32_high_refused: " + render(ir.fold_const_binaries(f64_wrapu)) + "\n";
  let f64_wrapu_lo: ir.Op[] = [ir.op_const_i64_text("7"), ir.op_int_wrap(true)];
  out = out + "f64_wrap_u32: " + render(ir.fold_const_binaries(f64_wrapu_lo)) + "\n";

  let mds: i32[] = [3, 7, -7, 97, 4093, -4093, 641, 1000000, 715827883, -1234567, 10, 100, 2147483647, -2147483647, 5, -5];
  let mi: i32 = 0;
  while (mi < mds.len()) {
    let ms: ir.MagicS = ir.derive_magic_s(mds[mi] as i64, 32);
    out = out + "magic_s " + util.i32_to_string(mds[mi]) + ": m=" + util.i64_to_string(ms.m)
      + " s=" + util.i32_to_string(ms.s) + " add=" + bool_word(ms.add) + " sub=" + bool_word(ms.sub) + "\n";
    mi = mi + 1;
  }
  let mus: u32[] = [3u32, 7u32, 97u32, 641u32, 1000000u32, 2147483649u32, 2863311531u32, 4294967291u32, 4294967295u32, 10u32, 100u32, 5u32, 4093u32];
  mi = 0;
  while (mi < mus.len()) {
    let mu: ir.MagicU = ir.derive_magic_u(mus[mi] as u64, 32);
    out = out + "magic_u " + util.i64_to_string(mus[mi] as i64) + ": m=" + util.i64_to_string(mu.m as i64)
      + " s=" + util.i32_to_string(mu.s) + " add=" + bool_word(mu.add) + "\n";
    mi = mi + 1;
  }
  let mds64: i64[] = [3i64, 7i64, -7i64, 10i64, 100i64, 641i64, -1000000007i64, 1000000000000i64, 6148914691236517205i64, -6148914691236517205i64, 9223372036854775807i64, -9223372036854775807i64];
  mi = 0;
  while (mi < mds64.len()) {
    let ms64: ir.MagicS = ir.derive_magic_s(mds64[mi], 64);
    out = out + "magic_s64 " + util.i64_to_string(mds64[mi]) + ": m=" + util.i64_to_string(ms64.m)
      + " s=" + util.i32_to_string(ms64.s) + " add=" + bool_word(ms64.add) + " sub=" + bool_word(ms64.sub) + "\n";
    mi = mi + 1;
  }
  let mus64: u64[] = [3u64, 7u64, 10u64, 100u64, 641u64, 1000000007u64, 9223372036854775809u64, 12297829382473034411u64, 18446744073709551557u64, 18446744073709551615u64];
  mi = 0;
  while (mi < mus64.len()) {
    let mu64: ir.MagicU = ir.derive_magic_u(mus64[mi], 64);
    out = out + "magic_u64 " + util.i64_to_string(mus64[mi] as i64) + ": m=" + util.i64_to_string(mu64.m as i64)
      + " s=" + util.i32_to_string(mu64.s) + " add=" + bool_word(mu64.add) + "\n";
    mi = mi + 1;
  }

  let texts: string[] = ["0", "7", "-7", "007", "-0", "", "-", "0x10", "7u8", "+5", "2147483647", "2147483648", "-2147483648", "-2147483649", "4294967296", "9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "99999999999999999999"];
  let ti: i32 = 0;
  while (ti < texts.len()) {
    let t: string = texts[ti];
    let r32: boolean = ir.const_i32_readable(ir.op_const_i32_text(t));
    let r64: boolean = ir.const_i64_readable(ir.op_const_i64_text(t));
    let a32: boolean = r32 == (util.i32_to_string(util.digits_to_i32(t)) == t);
    let a64: boolean = r64 == (util.i64_to_string(util.digits_to_i64(t)) == t);
    out = out + "readable " + t + ": i32=" + bool_word(r32) + " i64=" + bool_word(r64) + " agree=" + bool_word(a32 && a64) + "\n";
    ti = ti + 1;
  }

  let ds_const: ir.Op[] = [ir.op_const_i32(7), ir.op_store_local(1), ir.op_const_i32(0), ir.op_return()];
  out = out + "ds_const: " + render(ir.eliminate_dead_stores(ds_const)) + "\n";
  let ds_loaded: ir.Op[] = [ir.op_const_i32(7), ir.op_store_local(1), ir.op_load_local(1), ir.op_return()];
  out = out + "ds_loaded: " + render(ir.eliminate_dead_stores(ds_loaded)) + "\n";
  let ds_effect: ir.Op[] = [ir.op_call_direct("side", 0), ir.op_store_local(1), ir.op_const_i32(0), ir.op_return()];
  out = out + "ds_effect: " + render(ir.eliminate_dead_stores(ds_effect)) + "\n";
  let ds_tee: ir.Op[] = [ir.op_load_local(0), ir.op_tee_local(1), ir.op_return()];
  out = out + "ds_tee: " + render(ir.eliminate_dead_stores(ds_tee)) + "\n";
  let ds_chain: ir.Op[] = [ir.op_const_i32(1), ir.op_store_local(1), ir.op_const_i32(2), ir.op_store_local(2), ir.op_load_local(1), ir.op_load_local(2), ir.op_drop(), ir.op_drop(), ir.op_const_i32(0), ir.op_return()];
  out = out + "ds_chain: " + render(ir.eliminate_dead_stores(ds_chain)) + "\n";
  let ds_not_top: ir.Op[] = [ir.op_load_local(0), ir.op_const_i32(1), ir.op_bin("add", 0, false), ir.op_drop(), ir.op_const_i32(0), ir.op_return()];
  out = out + "ds_not_top: " + render(ir.eliminate_dead_stores(ds_not_top)) + "\n";
  let ds_scope: ir.Op[] = [ir.op_const_i32(1), ir.op_block(0), ir.op_drop(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
  out = out + "ds_scope: " + render(ir.eliminate_dead_stores(ds_scope)) + "\n";
  let ds_frame: ir.Op[] = [ir.op_const_i32(5), ir.op_store_local(2), ir.op_load_local(0), ir.op_const_i32(0), ir.op_const_i32(1), ir.op_str_slice_frame(2), ir.op_return()];
  out = out + "ds_frame: " + render(ir.eliminate_dead_stores(ds_frame)) + "\n";
  let ds_dyn: ir.Op[] = [ir.op_load_local(0), ir.op_store_local(2), ir.op_const_i32(9), ir.op_store_local(3), ir.op_dyn_dispatch(["A.f"], 2, 2), ir.op_return()];
  out = out + "ds_dyn: " + render(ir.eliminate_dead_stores(ds_dyn)) + "\n";
  let ds_copies: ir.Op[] = [ir.op_const_i32(7), ir.op_store_local(0), ir.op_load_local(0), ir.op_store_local(1), ir.op_load_local(1), ir.op_store_local(2), ir.op_const_i32(0), ir.op_return()];
  out = out + "ds_copies: " + render(ir.eliminate_dead_stores(ds_copies)) + "\n";
  let ds_read_again: ir.Op[] = [ir.op_const_i32(7), ir.op_store_local(0), ir.op_load_local(0), ir.op_store_local(1), ir.op_load_local(0), ir.op_return()];
  out = out + "ds_read_again: " + render(ir.eliminate_dead_stores(ds_read_again)) + "\n";

  write(out);

  return 1 - stable;
}
