import "../fern_toml";
import "../docsummary";
import "../util";

function dep_after(a: fern_toml.Dep, b: fern_toml.Dep): boolean {
  return util.str_less(b.name, a.name);
}

function str_after(a: string, b: string): boolean {
  return util.str_less(b, a);
}

function data(m: fern_toml.Manifest): string {
  let out: string = "ok " + docsummary.quote(m.name) + "|" + docsummary.quote(m.lib) + "|" + docsummary.quote(m.index);
  for d in util.sorted_by(m.deps, dep_after) {
    let governed: string = "false";
    if (d.governed) {
      governed = "true";
    }
    out = out + "|dep " + docsummary.quote(d.name) + "|" + d.kind + "|" + docsummary.quote(d.path)
      + "|" + docsummary.quote(d.url) + "|" + docsummary.quote(d.hash) + "|" + docsummary.quote(d.version)
      + "|" + governed + "|" + util.i32_to_string(d.line);
    for cap in d.caps {
      out = out + "|cap " + docsummary.quote(cap);
    }
  }
  for member in m.members {
    out = out + "|member " + docsummary.quote(member);
  }
  let excludes: string[] = [];
  let i: i32 = 0;
  while (i < m.excl_pkg.len()) {
    excludes = excludes.append(docsummary.quote(m.excl_pkg[i]) + "=" + docsummary.quote(m.excl_ver[i]));
    i = i + 1;
  }
  for row in util.sorted_by(excludes, str_after) {
    out = out + "|exclude " + row;
  }
  return out;
}

function verdict(path: string): string {
  match (read_file(path)) {
    Ok(src) => {
      let m: fern_toml.Manifest = fern_toml.parse(src);
      if (m.err.len() > 0) {
        return "err " + fern_toml.diagnostic("", m);
      }
      return data(m);
    },
    Err(e) => {
      return "unreadable " + path;
    }
  }
  return "";
}

function main(): i32 {
  let av: string[] = args();
  let out: string = "";
  let i: i32 = 1;
  while (i < av.len()) {
    out = out + verdict(av[i]) + "\n";
    i = i + 1;
  }
  write(out);
  return 0;
}
