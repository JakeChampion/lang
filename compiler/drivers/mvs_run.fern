import "../mvs";
import "../fern_toml";
import "../util";

struct Outcome {
  text: string,
  err: string,
}

function resolve_with(roots: mvs.Req[], bans: mvs.Ban[], ix: mvs.Index, dpkg: string[], dver: string[], ddep: string[], dmin: string[]): Outcome {
  let st: mvs.State = mvs.begin(roots, bans, ix);
  while (st.err.len() == 0 && !mvs.done(st)) {
    let deps: mvs.Req[] = [];
    let i: i32 = 0;
    while (i < dpkg.len()) {
      if (dpkg[i] == st.need_pkg && dver[i] == st.need_ver) {
        deps = deps.append(mvs.Req { pkg: ddep[i], min: dmin[i] });
      }
      i = i + 1;
    }
    st = mvs.supply(st, deps);
  }
  if (st.err.len() > 0) {
    return Outcome { text: "", err: st.err };
  }
  let out: string = "";
  let sel: mvs.Sel[] = mvs.selected(st);
  let k: i32 = 0;
  while (k < sel.len()) {
    if (k > 0) {
      out = out + "; ";
    }
    out = out + sel[k].name + " " + sel[k].ver;
    k = k + 1;
  }
  return Outcome { text: out, err: "" };
}

function no_edges(): string[] {
  let e: string[] = [];
  return e;
}

function no_bans(): mvs.Ban[] {
  let e: mvs.Ban[] = [];
  return e;
}

function req(pkg: string, min: string): mvs.Req {
  return mvs.Req { pkg: pkg, min: min };
}

function hex64(): string {
  return "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
}

function index_hash_err(hash: string): string {
  return mvs.parse_index("[evil]\n\"1.0.0\" = { url = \"https://example.invalid/x.tar.gz\", hash = \""
    + hash + "\" }\n").err;
}

function lock_hash_err(hash: string): string {
  return fern_toml.parse_lock("[[package]]\nname = \"evil\"\nversion = \"1.0.0\"\n"
    + "url = \"https://example.invalid/x.tar.gz\"\nhash = \"" + hash + "\"\n").err;
}

function bad_hash(hash: string): string {
  return "must be `sha256:` + 64 lowercase hex digits of the archive bytes, got \"" + hash + "\"";
}

function check(code: i32, what: string, got: string, want: string): i32 {
  if (got == want) {
    return 0;
  }
  write("mvs_run: " + what + "\n  got:  " + got + "\n  want: " + want + "\n");
  return code;
}

function main(): i32 {
  let rc: i32 = check(
    1, "1.2.0 vs 1.10.0",
    util.i32_to_string(mvs.version_cmp(mvs.parse_version("1.2.0"), mvs.parse_version("1.10.0"))), "-1",
  );
  if (rc != 0) {
    return rc;
  }
  rc = check(
    2, "2.0.0 vs 1.9.9",
    util.i32_to_string(mvs.version_cmp(mvs.parse_version("2.0.0"), mvs.parse_version("1.9.9"))), "1",
  );
  if (rc != 0) {
    return rc;
  }
  rc = check(
    3, "1.0.0 vs 1.0.0",
    util.i32_to_string(mvs.version_cmp(mvs.parse_version("1.0.0"), mvs.parse_version("1.0.0"))), "0",
  );
  if (rc != 0) {
    return rc;
  }
  if (mvs.parse_version("1.2").ok) {
    return 4;
  }
  rc = check(
    5, "two-part version error", mvs.version_error("1.2"),
    "invalid version \"1.2\" (want MAJOR.MINOR.PATCH)",
  );
  if (rc != 0) {
    return rc;
  }
  rc = check(6, "non-numeric version error", mvs.version_error("1.x.0"), "invalid version \"1.x.0\"");
  if (rc != 0) {
    return rc;
  }

  let ix1: mvs.Index = mvs.parse_index("# registry\n[foo]\n\"1.0.0\" = { path = \"../foo-1.0.0\" }\n\"1.2.0\" = { url = \"https://x/foo.tar.gz\", hash = \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" }  # newest\n[bar]  # a second package\n\"2.1.0\" = { path = \"bar\" }\n");
  rc = check(7, "index parse", ix1.err, "");
  if (rc != 0) {
    return rc;
  }
  let foovers: string[] = mvs.index_versions(ix1, "foo");
  rc = check(8, "foo versions", util.i32_to_string(foovers.len()) + " " + foovers[0] + " " + foovers[1], "2 1.0.0 1.2.0");
  if (rc != 0) {
    return rc;
  }
  ix1 = mvs.with_dir(ix1, "/pkgs/reg");
  let s120: mvs.Source = mvs.index_source(ix1, "foo", "1.2.0");
  rc = check(9, "foo 1.2.0 source", s120.url + " " + s120.hash, "https://x/foo.tar.gz sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
  if (rc != 0) {
    return rc;
  }
  rc = check(10, "foo 1.0.0 path", mvs.index_source(ix1, "foo", "1.0.0").path, "/pkgs/foo-1.0.0");
  if (rc != 0) {
    return rc;
  }
  rc = check(11, "bar 2.1.0 path", mvs.index_source(ix1, "bar", "2.1.0").path, "/pkgs/reg/bar");
  if (rc != 0) {
    return rc;
  }
  rc = check(
    12, "malformed source", mvs.parse_index("[foo]\n\"1.0.0\" = { }\n").err,
    "line 2: 1.0.0: a version needs `path` or `url`+`hash`",
  );
  if (rc != 0) {
    return rc;
  }
  rc = check(
    13, "entry outside a section", mvs.parse_index("\"1.0.0\" = { path = \"x\" }\n").err,
    "line 1: version entry outside a [package] section",
  );
  if (rc != 0) {
    return rc;
  }

  let ix2: mvs.Index = mvs.parse_index("[foo]\n\"1.0.0\" = { path = \"foo1\" }\n\"1.1.0\" = { path = \"foo11\" }\n[bar]\n\"1.0.0\" = { path = \"bar1\" }\n\"2.0.0\" = { path = \"bar2\" }\n");
  let roots2: mvs.Req[] = [req("foo", "1.1.0"), req("bar", "1.0.0")];
  let o2: Outcome = resolve_with(roots2, no_bans(), ix2, ["foo"], ["1.1.0"], ["bar"], ["2.0.0"]);
  rc = check(14, "max of mins", o2.err + o2.text, "bar 2.0.0; foo 1.1.0");
  if (rc != 0) {
    return rc;
  }

  let ix3: mvs.Index = mvs.parse_index("[a]\n\"1.0.0\" = { path = \"a\" }\n[b]\n\"1.0.0\" = { path = \"b\" }\n[c]\n\"1.0.0\" = { path = \"c1\" }\n\"1.5.0\" = { path = \"c15\" }\n\"2.0.0\" = { path = \"c2\" }\n");
  let roots3: mvs.Req[] = [req("a", "1.0.0"), req("b", "1.0.0")];
  let o3: Outcome = resolve_with(roots3, no_bans(), ix3, ["a", "b"], ["1.0.0", "1.0.0"], ["c", "c"], ["1.5.0", "2.0.0"]);
  rc = check(15, "diamond", o3.err + o3.text, "a 1.0.0; b 1.0.0; c 2.0.0");
  if (rc != 0) {
    return rc;
  }

  let ix4: mvs.Index = mvs.parse_index("[foo]\n\"1.0.0\" = { path = \"foo\" }\n");
  let roots4: mvs.Req[] = [req("foo", "1.2.0")];
  let o4: Outcome = resolve_with(roots4, no_bans(), ix4, no_edges(), no_edges(), no_edges(), no_edges());
  rc = check(
    16, "absent version", o4.err,
    "dependency \"foo\" has no version 1.2.0 in the index (available: 1.0.0)",
  );
  if (rc != 0) {
    return rc;
  }
  let ix5: mvs.Index = mvs.parse_index("[foo]\n\"1.0.0\" = { path = \"foo\" }\n");
  let roots5: mvs.Req[] = [req("foo", "1.0.0")];
  let o5: Outcome = resolve_with(roots5, no_bans(), ix5, ["foo"], ["1.0.0"], ["ghost"], ["1.0.0"]);
  rc = check(
    17, "unknown transitive dep", o5.err,
    "via foo@1.0.0: dependency \"ghost\" has no version 1.0.0 in the index (available: none)",
  );
  if (rc != 0) {
    return rc;
  }

  let ix6: mvs.Index = mvs.parse_index("[foo]\n\"1.0.0\" = { path = \"foo1\" }\n[bar]\n\"1.9.0\" = { path = \"bar19\" }\n\"1.9.1\" = { path = \"bar191\" }\n\"2.0.0\" = { path = \"bar2\" }\n");
  let bans6: mvs.Ban[] = [mvs.Ban { pkg: "bar", ver: "1.9.0" }, mvs.Ban { pkg: "bar", ver: "1.9.1" }];
  let roots6: mvs.Req[] = [req("foo", "1.0.0")];
  let o6: Outcome = resolve_with(roots6, bans6, ix6, ["foo"], ["1.0.0"], ["bar"], ["1.9.0"]);
  rc = check(18, "exclude rounds up", o6.err + o6.text, "bar 2.0.0; foo 1.0.0");
  if (rc != 0) {
    return rc;
  }
  let bans7: mvs.Ban[] = [mvs.Ban { pkg: "foo", ver: "1.0.0" }];
  let o7: Outcome = resolve_with(roots5, bans7, ix5, no_edges(), no_edges(), no_edges(), no_edges());
  rc = check(
    19, "exclude with no higher version", o7.err,
    "dependency \"foo\": version 1.0.0 is excluded by the top-level manifest and the index has no higher non-excluded version (available: 1.0.0)",
  );
  if (rc != 0) {
    return rc;
  }
  let ix8: mvs.Index = mvs.parse_index("[foo]\n\"1.0.0\" = { path = \"foo1\" }\n\"1.1.0\" = { path = \"foo11\" }\n");
  let bans8: mvs.Ban[] = [mvs.Ban { pkg: "foo", ver: "1.0.0" }];
  let roots8: mvs.Req[] = [req("foo", "1.1.0")];
  let o8: Outcome = resolve_with(roots8, bans8, ix8, no_edges(), no_edges(), no_edges(), no_edges());
  rc = check(20, "unrelated exclude", o8.err + o8.text, "foo 1.1.0");
  if (rc != 0) {
    return rc;
  }

  let lsel: mvs.Sel[] = [
    mvs.Sel { name: "bar", ver: "2.0.0", src: mvs.Source { path: "/pkgs/bar", url: "", hash: "" } },
    mvs.Sel { name: "foo", ver: "1.2.0", src: mvs.Source { path: "", url: "https://x/foo.tar.gz", hash: "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
  ];
  rc = check(
    21, "lock text", mvs.lock_text(lsel),
    "# generated by `fern -resolve`; do not edit by hand\n"
      + "\n[[package]]\nname = \"bar\"\nversion = \"2.0.0\"\npath = \"/pkgs/bar\"\n"
      + "\n[[package]]\nname = \"foo\"\nversion = \"1.2.0\"\nurl = \"https://x/foo.tar.gz\"\nhash = \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n",
  );
  if (rc != 0) {
    return rc;
  }

  rc = check(22, "join ..", mvs.join_path("/a/b/c", "../d"), "/a/b/d");
  if (rc != 0) {
    return rc;
  }
  rc = check(23, "join .", mvs.join_path("/a/b", "./d/./e"), "/a/b/d/e");
  if (rc != 0) {
    return rc;
  }
  rc = check(24, "join above root", mvs.join_path("/", "../x"), "/x");
  if (rc != 0) {
    return rc;
  }
  rc = check(25, "join relative", mvs.join_path("a/b", "../../c"), "c");
  if (rc != 0) {
    return rc;
  }

  let bad: string[] = [
    "sha256:../../../../etc/fern-pkgs/evil",
    "sha256:/tmp/evil",
    "sha256:not-a-hash",
    "sha256:abc",
    "sha256:" + hex64() + "a",
    "sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "blake3:" + hex64(),
    hex64(),
  ];
  let bi: i32 = 0;
  while (bi < bad.len()) {
    rc = check(
      26, "index rejects " + bad[bi], index_hash_err(bad[bi]),
      "line 2: 1.0.0: hash " + bad_hash(bad[bi]),
    );
    if (rc != 0) {
      return rc;
    }
    rc = check(
      27, "lock rejects " + bad[bi], lock_hash_err(bad[bi]),
      "fern.lock line 5: hash " + bad_hash(bad[bi]),
    );
    if (rc != 0) {
      return rc;
    }
    bi = bi + 1;
  }
  rc = check(
    28, "traversal message", lock_hash_err("sha256:../../outside/evil"),
    "fern.lock line 5: hash must be `sha256:` + 64 lowercase hex digits of the archive bytes, got \"sha256:../../outside/evil\"",
  );
  if (rc != 0) {
    return rc;
  }
  let okix: mvs.Index = mvs.parse_index("[evil]\n\"1.0.0\" = { url = \"https://example.invalid/x.tar.gz\", hash = \"sha256:"
    + hex64() + "\" }\n");
  rc = check(29, "index accepts a valid hash", okix.err, "");
  if (rc != 0) {
    return rc;
  }
  let oksrc: mvs.Source = mvs.index_source(okix, "evil", "1.0.0");
  rc = check(
    30, "valid index hash reaches the source", oksrc.url + " " + oksrc.hash,
    "https://example.invalid/x.tar.gz sha256:" + hex64(),
  );
  if (rc != 0) {
    return rc;
  }
  let oklock: fern_toml.LockResult = fern_toml.parse_lock("[[package]]\nname = \"evil\"\nversion = \"1.0.0\"\n"
    + "url = \"https://example.invalid/x.tar.gz\"\nhash = \"sha256:" + hex64() + "\"\n");
  rc = check(31, "lock accepts a valid hash", oklock.err, "");
  if (rc != 0) {
    return rc;
  }
  let lockhash: string = "none";
  match (fern_toml.lock_hash_of(oklock.entries, "evil")) {
    Some(h) => {
      lockhash = h;
    },
    None => {}
  }
  rc = check(32, "valid lock hash reaches the entry", lockhash, "sha256:" + hex64());
  if (rc != 0) {
    return rc;
  }

  write("mvs: every resolution rule agrees with native\n");
  return 0;
}
