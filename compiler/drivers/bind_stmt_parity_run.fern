import "../ast";
import "../checker";
import "../parser";
import "./rundriver";
import "../util";

function scope_diff(want: checker.Scope, got: checker.Scope): string {
  if (want.names.len() != got.names.len()) {
    return "check_stmt bound " + util.i32_to_string(want.names.len()) + " name(s), bind_stmt " + util.i32_to_string(got.names.len());
  }
  if (want.types.len() != got.types.len()) {
    return "check_stmt bound " + util.i32_to_string(want.types.len()) + " type(s), bind_stmt " + util.i32_to_string(got.types.len());
  }
  if (want.loop_depth != got.loop_depth) {
    return "check_stmt left loop_depth " + util.i32_to_string(want.loop_depth) + ", bind_stmt " + util.i32_to_string(got.loop_depth);
  }
  for i in 0..want.names.len() {
    if (want.names[i] != got.names[i]) {
      return "binding " + util.i32_to_string(i) + " is `" + want.names[i] + "` under check_stmt and `" + got.names[i] + "` under bind_stmt";
    }
    if (checker.type_debug(want.types[i]) != checker.type_debug(got.types[i])) {
      return "binding `" + want.names[i] + "` is " + checker.type_debug(want.types[i]) + " under check_stmt and " + checker.type_debug(got.types[i]) + " under bind_stmt";
    }
  }
  return "";
}

function form_of(st: ast.Stmt): string {
  match (st) {
    ast.StmtVar(_) => {
      return "StmtVar";
    },
    ast.StmtReturn(_) => {
      return "StmtReturn";
    },
    ast.StmtExpr(_) => {
      return "StmtExpr";
    },
    ast.StmtIf(_) => {
      return "StmtIf";
    },
    ast.StmtWhile(_) => {
      return "StmtWhile";
    },
    ast.StmtAssign(_) => {
      return "StmtAssign";
    },
    ast.StmtMatch(_) => {
      return "StmtMatch";
    },
    ast.StmtFor(_) => {
      return "StmtFor";
    },
    ast.StmtBreak(_) => {
      return "StmtBreak";
    },
    ast.StmtContinue(_) => {
      return "StmtContinue";
    },
    ast.StmtUnknown(_) => {
      return "StmtUnknown";
    },
    ast.StmtDefer(_) => {
      return "StmtDefer";
    }
  }
  return "StmtUnrecognised";
}

struct Walked { diffs: string[], compared: i32, forms: string[] }

function walk(body: ast.Stmt[], s: checker.Scope, where: string, acc: Walked): Walked {
  let out = acc;
  let cur = s;
  for st in body {
    match (st) {
      ast.StmtIf(f) => {
        out = walk(f.then_body, cur, where, out);
        out = walk(f.else_body, cur, where, out);
      },
      ast.StmtWhile(w) => {
        out = walk(w.body, cur, where, out);
      },
      ast.StmtFor(fr) => {
        out = walk(fr.body, cur, where, out);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = walk(arm.body, cur, where, out);
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        out = walk(one, cur, where, out);
      },
      _ => {}
    }
    let want = checker.check_stmt(st, cur).scope;
    let diff = scope_diff(want, checker.bind_stmt(st, cur));
    let found = out.diffs;
    if (diff.len() > 0) {
      found = found.append(where + ": " + diff);
    }
    let seen = out.forms;
    let form = form_of(st);
    if (!util.has_str(seen, form)) {
      seen = seen.append(form);
    }
    out = Walked { diffs: found, compared: out.compared + 1, forms: seen };
    cur = want;
  }
  return out;
}

function main(): i32 {
  let mod = rundriver.parse_stdin("bind_stmt_parity_run");
  let scopes = checker.module_scopes(mod);
  let acc = Walked { diffs: [], compared: 0, forms: [] };
  for i in 0..mod.funcs.len() {
    acc = walk(mod.funcs[i].body, scopes[i], "function " + mod.funcs[i].name, acc);
  }
  acc = walk(mod.top_stmts, scopes[mod.funcs.len()], "top level", acc);
  for j in 0..acc.diffs.len() {
    print(acc.diffs[j]);
  }
  print("# compared " + util.i32_to_string(acc.compared));
  let forms = "";
  for k in 0..acc.forms.len() {
    if (k > 0) {
      forms += ",";
    }
    forms += acc.forms[k];
  }
  print("# forms " + forms);
  if (acc.diffs.len() > 0) {
    return 1;
  }
  return 0;
}
