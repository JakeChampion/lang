import "../lexer";
import "../parser";
import "./rundriver";
import "../wasm_ir";
import "../asmcore";
import "../semlower";

function main(): i32 {
  let decide: boolean = false;
  let reactor: boolean = false;
  let av: string[] = args();
  let ai: i32 = 1;
  while (ai < av.len()) {
    if (av[ai] == "-decide") {
      decide = true;
    }
    if (av[ai] == "-reactor") {
      reactor = true;
    }
    ai = ai + 1;
  }
  let mod: parser.Module = rundriver.parse_stdin("wasm_runio_run");
  if (asmcore.refuse_parse_errors([mod])) {
    return 1;
  }
  let d: semlower.Driven = semlower.driven(mod, "wasm32-wasi");
  if (decide) {
    let plm: parser.Module = wasm_ir.route_normalized(d.full);
    if (wasm_ir.ir_route_ok(plm, true, true, d.sub)) {
      print("ir\n");
    } else {
      print("refused\n");
    }
    return 0;
  }
  write(wasm_ir.emit_module_mode_or_error_sub(d.full, true, !reactor || wasm_ir.component_needs_host(d.full, d.sub.switches), d.sub));
  return 0;
}
