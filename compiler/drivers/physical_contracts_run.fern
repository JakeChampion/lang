import "../lexer";
import "../parser";
import "../semlower";
import "../ircore";
import "../ssasem";
import "../typeinfo";

function require(ok: boolean, id: i32): void {
  if (!ok) {
    exit(id);
  }
}

function nominal(t: typeinfo.Type, name: string): boolean {
  if let typeinfo.TypeStruct(s) = t {
    return s.name == name && s.args.len() == 0;
  }
  return false;
}

function row(sub: ircore.Sub, name: string): ssasem.Contract {
  let found: ssasem.Contract[] = [];
  for c in sub.physical_contracts {
    if (c.name == name) {
      found = found.append(c);
    }
  }
  require(found.len() == 1, 1);
  return found[0];
}

function check(sub: ircore.Sub): void {
  let take = row(sub, "extract");
  require(take.params.len() == 1 && take.modes.len() == 1 && take.modes[0] == 3, 2);
  require(nominal(take.params[0], "Parent") && nominal(take.result, "Leaf"), 3);
  let replacement = row(sub, "replace");
  require(replacement.params.len() == 2 && replacement.modes.len() == 2, 4);
  // The child is consuming in the chosen ABI despite lacking source `own`.
  require(replacement.modes[0] == 3 && replacement.modes[1] == 3, 5);
  require(nominal(replacement.params[0], "Parent") && nominal(replacement.params[1], "Leaf") && nominal(replacement.result, "Parent"), 6);
  let read = row(sub, "read");
  require(read.params.len() == 1 && read.modes.len() == 1 && read.modes[0] == 2, 7);
  if let typeinfo.TypeI32(n) = read.result {
    require(n.width == 32 && !n.unsigned && !n.is_char && !n.polymorphic, 8);
  } else {
    exit(9);
  }
  let boxed = row(sub, "read_box");
  require(boxed.params.len() == 1 && boxed.modes.len() == 1 && boxed.modes[0] == 2, 10);
  if let typeinfo.TypeStruct(b) = boxed.params[0] {
    // The checked module has already specialized this nominal declaration.
    // Preserve its actual clone identity, not the source template spelling.
    require(b.name == "Box__i64" && b.args.len() == 0, 11);
    if let typeinfo.TypeI32(n) = boxed.result {
      require(n.width == 64 && !n.unsigned, 12);
    } else {
      exit(13);
    }
  } else {
    exit(14);
  }
}

function main(): i32 {
  require(ircore.no_sub().physical_contracts.len() == 0, 15);
  let source = "struct Leaf { n: i32 }\nstruct Parent { child: Leaf }\nstruct Box[T] { value: T }\n@noinline\nfunction extract(own p: Parent): Leaf { return p.child; }\n@noinline\nfunction replace(own p: Parent, child: Leaf): Parent { return Parent { ...p, child: child }; }\n@noinline\nfunction read(p: Parent): i32 { return p.child.n; }\n@noinline\nfunction read_box(p: Box[i64]): i64 { return p.value; }\nfunction main(): i32 { let p = Parent { child: Leaf { n: 7 } }; let b = Box[i64] { value: 9 }; return read(replace(p, extract(p))) + (read_box(b) as i32); }\n";
  for target in ["arm64-darwin", "x86-64-linux", "wasm32-wasi"] {
    let driven = semlower.driven(parser.parse_module(lexer.tokenize(source)), target);
    check(driven.sub);
    let changed = ircore.Sub { ...driven.sub, contracts: ["not a typed signature"] };
    check(changed);
    check(driven.sub);
    require(driven.sub.contracts.len() > 1 && changed.contracts.len() == 1 && changed.contracts[0] == "not a typed signature", 16);
  }
  print("selected physical contracts: exact typed ABI preserved");
  return 0;
}
