import "../util";
import "../parser";
import "./rundriver";
import "../ir";
import "../irtables";
import "../ircore";
import "../semlower";
import "../asm_ir";
import "../asm_arm64_ir";
import "../wasm_ir";
import "../asmcore";

struct Rebuilt { cache: irtables.LowerResult[], i64s: i32, f64s: i32, value_f64s: i32 }

function rebuild(cache: irtables.LowerResult[]): Rebuilt {
  let out: irtables.LowerResult[] = [];
  let n64: i32 = 0;
  let nf: i32 = 0;
  let nvf: i32 = 0;
  for r in cache {
    let ops: ir.Op[] = [];
    for o in r.ops {
      let no: ir.Op = o;
      if (o.kind_tag == ir.kind_id("const_i64") && o.str.len() > 0) {
        no = ir.Op { ...ir.op_const_i64(util.lit_to_i64(o.str)), decl: o.decl };
        n64 = n64 + 1;
      } else if (o.kind_tag == ir.kind_id("const_f64") && o.str.len() > 0) {
        no = ir.Op { ...ir.op_const_f64(f64_from_bits(util.parse_f64_bits(o.str))), decl: o.decl };
        nf = nf + 1;
      } else if (o.kind_tag == ir.kind_id("const_f64")) {
        nvf = nvf + 1;
      }
      ops = ops.append(no);
    }
    out = out.append(irtables.LowerResult { ...r, ops: ops });
  }
  return Rebuilt { cache: out, i64s: n64, f64s: nf, value_f64s: nvf };
}

function rebuilt(sub: ircore.Sub): ircore.Sub {
  let rb: Rebuilt = rebuild(sub.bodies);
  let rx: Rebuilt = rebuild(sub.extra);
  eprint("rebuilt i64=" + util.i32_to_string(rb.i64s + rx.i64s) + " f64=" + util.i32_to_string(rb.f64s + rx.f64s) + " value-f64=" + util.i32_to_string(rb.value_f64s + rx.value_f64s));
  return ircore.Sub { ...sub, bodies: rb.cache, extra: rx.cache };
}

function bits_round_trip(): boolean {
  let pats: i64[] = [0x7ff8000000000123i64, 0i64 - 0x0007fffffffffffdi64, 0x7ff0000000000000i64, 0i64 - 0x0010000000000000i64, 0i64 - 0x7fffffffffffffffi64 - 1i64, 1i64];
  for b in pats {
    if (ir.const_f64_bits(ir.op_const_f64(f64_from_bits(b))) != b) {
      return false;
    }
  }
  return ir.const_i64_text(ir.op_const_i64(0i64 - 0x7fffffffffffffffi64 - 1i64)) == "-9223372036854775808";
}

function main(): i32 {
  if (!bits_round_trip()) {
    eprint("ir_const_numeric_run: a numeric constant did not keep its bits");
    return 3;
  }
  let av: string[] = args();
  let target: string = "x86-64-linux";
  if (av.len() > 2 && av[1] == "-target") {
    target = av[2];
  }
  let mod: parser.Module = rundriver.parse_stdin("ir_const_numeric_run");
  if (asmcore.refuse_parse_errors([mod])) {
    return 1;
  }
  let d: semlower.Driven = semlower.driven(mod, target);
  let sub: ircore.Sub = rebuilt(d.sub);
  if (target == "wasm32-wasi") {
    write(wasm_ir.emit_module_mode_or_error_sub(d.full, false, false, sub));
  } else if (target == "arm64-linux") {
    write(asm_arm64_ir.emit_module_or_error_sub(d.full, false, sub, 0 as usize));
  } else {
    write(asm_ir.emit_module_or_error_sub(d.full, sub, 0 as usize));
  }
  return 0;
}
