import "../parser";
import "./rundriver";
import "../util";
import "../asmcore";
import "../platforms";
import "../wasm_ir";
import "../semlower";

function main(): i32 {
  return util.rc_underflow_guard("wasm_ir_run", run());
}

function run(): i32 {
  let mod: parser.Module = rundriver.parse_stdin("wasm_ir_run");
  if (asmcore.refuse_parse_errors([mod])) {
    return 1;
  }
  let arity_errs: util.Diag[] = asmcore.check_call_arity(parser.fill_default_args_module(mod));
  arity_errs = util.append_diags(arity_errs, asmcore.check_map_new_chain(mod));
  arity_errs = util.append_diags(arity_errs, asmcore.check_undefined_calls(mod));
  if (arity_errs.len() > 0) {
    eprint(util.format_diags(arity_errs));
    return 1;
  }
  let denied: util.Diag[] = [];
  for v in platforms.enforce(mod, "wasm32-wasi") {
    denied = denied.append(platforms.violation_diag(v));
  }
  if (denied.len() > 0) {
    eprint(util.format_diags(denied));
    return 1;
  }
  let d: semlower.Driven = semlower.driven(mod, "wasm32-wasi");
  write(wasm_ir.emit_module_mode_or_error_sub(d.full, false, false, d.sub));
  return 0;
}
