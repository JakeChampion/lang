import "../ssa";
import "../util";

function inst(kind: i32, v: i32, args: i32[], str: string): ssa.SInst {
  return ssa.SInst { kind_tag: kind, result: v, args: args, imm: 0, str: str };
}

function jump(to: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: to, t: 0, f: 0, value: 0 };
}

function branch(cond: i32, t: i32, f: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function ret(v: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: v };
}

// A counter that a wrap keeps in range, read after the loop through an
// extension, and a parameter read through one.
function counted(): ssa.SFunc {
  let b0: ssa.SBlock = ssa.SBlock { id: 0, insts: [inst(6, 0, [], ""), inst(1, 1, [], "")], term: jump(1), preds: [] };
  let b1: ssa.SBlock = ssa.SBlock { id: 1, insts: [inst(8, 2, [1, 4], ""), inst(9, 5, [2, 0], "lt_s")], term: branch(5, 2, 3), preds: [0, 2] };
  let b2: ssa.SBlock = ssa.SBlock { id: 2, insts: [inst(9, 3, [2, 0], "add"), inst(10, 4, [3], "int_wrap")], term: jump(1), preds: [1] };
  let tail: ssa.SInst[] = [inst(10, 6, [2], "int_extend"), inst(10, 7, [0], "int_extend"), inst(9, 8, [6, 7], "add"), inst(9, 9, [8, 1], "and"), inst(10, 10, [9], "int_cast:u8")];
  let b3: ssa.SBlock = ssa.SBlock { id: 3, insts: tail, term: ret(10), preds: [1] };
  return ssa.SFunc { name: "counted", nparams: 1, nvals: 11, blocks: [b0, b1, b2, b3], entry: 0, takes_env: false };
}

function konst(v: i32, c: i32): ssa.SInst {
  return ssa.SInst { kind_tag: 1, result: v, args: [], imm: c, str: "" };
}

// A u32 shifted right by 17 and by 24, a parameter shifted without a u32
// wrap, and a u32 shifted by 32, each read through an extension.
function shifted(): ssa.SFunc {
  let insts: ssa.SInst[] = [
    inst(6, 0, [], ""), konst(1, 17), inst(10, 2, [0], "u32_wrap"),
    inst(9, 3, [2, 1], "shr_u"), inst(10, 4, [3], "int_cast:i32"),
    konst(5, 24), inst(9, 6, [2, 5], "shr_u"), inst(10, 7, [6], "int_cast:u8"),
    inst(9, 8, [0, 1], "shr_u"), inst(10, 9, [8], "int_cast:i32"),
    konst(10, 32), inst(9, 11, [2, 10], "shr_u"), inst(10, 12, [11], "int_cast:i32"),
    inst(9, 13, [4, 7], "add"), inst(9, 14, [13, 9], "add"), inst(9, 15, [14, 12], "add"),
  ];
  let b0: ssa.SBlock = ssa.SBlock { id: 0, insts: insts, term: ret(15), preds: [] };
  return ssa.SFunc { name: "shifted", nparams: 1, nvals: 16, blocks: [b0], entry: 0, takes_env: false };
}

// A sum read only as an index, a difference read as an index and as a value,
// and a product read by a raw load, each through an i32 cast.
function indexed(): ssa.SFunc {
  let insts: ssa.SInst[] = [
    inst(6, 0, [], ""), inst(6, 1, [], ""), inst(6, 2, [], ""),
    inst(9, 3, [1, 2], "add"), inst(10, 4, [3], "int_cast:i32"), inst(42, 5, [0, 4], "u8"),
    inst(9, 6, [1, 2], "sub"), inst(10, 7, [6], "int_cast:i32"), inst(42, 8, [0, 7], "u8"),
    inst(9, 9, [8, 7], "add"), inst(9, 10, [5, 9], "add"),
    inst(9, 11, [1, 2], "mul"), inst(10, 12, [11], "int_cast:i32"), inst(54, 13, [0, 12], ""),
    inst(9, 14, [10, 13], "add"),
  ];
  let b0: ssa.SBlock = ssa.SBlock { id: 0, insts: insts, term: ret(14), preds: [] };
  return ssa.SFunc { name: "indexed", nparams: 3, nvals: 15, blocks: [b0], entry: 0, takes_env: false };
}

// A counter that counts down while it is greater than zero, or while it is
// less than zero, and wraps each step.
function counted_down(test: string): ssa.SFunc {
  let b0: ssa.SBlock = ssa.SBlock { id: 0, insts: [inst(6, 0, [], ""), konst(1, 1), konst(2, 0)], term: jump(1), preds: [] };
  let b1: ssa.SBlock = ssa.SBlock { id: 1, insts: [inst(8, 3, [0, 5], ""), inst(9, 6, [3, 2], test)], term: branch(6, 2, 3), preds: [0, 2] };
  let b2: ssa.SBlock = ssa.SBlock { id: 2, insts: [inst(9, 4, [3, 1], "sub"), inst(10, 5, [4], "int_wrap")], term: jump(1), preds: [1] };
  let b3: ssa.SBlock = ssa.SBlock { id: 3, insts: [], term: ret(3), preds: [1] };
  return ssa.SFunc { name: "counted_down", nparams: 1, nvals: 7, blocks: [b0, b1, b2, b3], entry: 0, takes_env: false };
}

// A count taken on a constant null, one given back on it, one given back on
// a parameter, and one on the null whose result is read.
function counted_nulls(): ssa.SFunc {
  let insts: ssa.SInst[] = [
    inst(6, 0, [], ""), konst(1, 0),
    inst(11, 2, [1], "__fern_rc_inc"), inst(11, 3, [1], "__fern_rc_dec"),
    inst(11, 4, [0], "__fern_rc_dec"), inst(11, 5, [1], "__fern_rc_dec"),
    inst(9, 6, [5, 0], "add"),
  ];
  let b0: ssa.SBlock = ssa.SBlock { id: 0, insts: insts, term: ret(6), preds: [] };
  return ssa.SFunc { name: "counted_nulls", nparams: 1, nvals: 7, blocks: [b0], entry: 0, takes_env: false };
}

function has(f: ssa.SFunc, v: i32): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.result == v) {
        return true;
      }
    }
  }
  return false;
}

function check(ok: boolean, what: string, failures: i32): i32 {
  if (ok) {
    return failures;
  }
  print("FAIL " + what);
  return failures + 1;
}

function main(): i32 {
  let failures: i32 = 0;
  let folded: ssa.Formed = ssa.fold_extensions(counted());
  let g: ssa.SFunc = folded.f;
  failures = check(!has(g, 6) && folded.repl[6] == 2, "an extension of a phi of wrapped values goes", failures);
  failures = check(has(g, 4), "the wrap of a sum stays", failures);
  failures = check(has(g, 7), "an extension of a parameter stays", failures);
  failures = check(!has(g, 10) && g.blocks[3].term.value == 9, "a byte cast of an and with a byte constant goes", failures);
  failures = check(g.blocks[3].insts[1].result == 8 && g.blocks[3].insts[1].args[0] == 2, "a read of a dropped extension reads its operand", failures);
  let narrow: ssa.SFunc = ssa.fold_extensions(shifted()).f;
  failures = check(!has(narrow, 4), "an i32 cast of a u32 shifted right by 17 goes", failures);
  failures = check(!has(narrow, 7), "a byte cast of a u32 shifted right by 24 goes", failures);
  failures = check(has(narrow, 9), "an i32 cast of a shifted parameter stays", failures);
  failures = check(has(narrow, 12), "an i32 cast of a u32 shifted by 32 stays", failures);
  let zx: ssa.SFunc = ssa.zero_extended_indices(indexed());
  let uses: i32[] = ssa.use_counts(zx);
  failures = check(zx.blocks[0].insts[4].str == "u32_wrap", "an i32 cast read only as an index zero-extends", failures);
  failures = check(zx.blocks[0].insts[7].str == "int_cast:i32", "an i32 cast read as a value stays signed", failures);
  failures = check(ssa.low_word_pair(zx.blocks[0], 3, uses), "a sum and its zero-extension pair", failures);
  failures = check(!ssa.low_word_pair(zx.blocks[0], 6, uses), "a difference and a sign extension do not pair", failures);
  failures = check(zx.blocks[0].insts[12].str == "int_cast:i32", "an i32 cast read by a raw load stays signed", failures);
  let down: ssa.Formed = ssa.drop_low_wraps(counted_down("gt_s"));
  failures = check(down.repl.len() > 5 && down.repl[5] == 4, "the wrap of a decrement below a greater-than test goes", failures);
  let under: ssa.Formed = ssa.drop_low_wraps(counted_down("lt_s"));
  failures = check(under.repl.len() == 0 || under.repl[5] == 5, "the wrap of a decrement below a less-than test stays", failures);
  let w: i32[] = ssa.block_loop_weights(counted());
  failures = check(w[0] == 1 && w[1] == 8 && w[2] == 8 && w[3] == 1, "a loop weighs 8", failures);
  let f: ssa.SFunc = counted();
  let b1: ssa.SBlock = ssa.SBlock { ...f.blocks[1], insts: [inst(8, 2, [1, 4, 4], ""), inst(9, 5, [2, 0], "lt_s")], preds: [0, 2, 3] };
  let b3: ssa.SBlock = ssa.SBlock { ...f.blocks[3], term: branch(9, 1, 4) };
  let b4: ssa.SBlock = ssa.SBlock { id: 4, insts: [], term: ret(9), preds: [3] };
  let twice: ssa.SFunc = ssa.SFunc { ...f, blocks: [f.blocks[0], b1, f.blocks[2], b3, b4] };
  let tw: i32[] = ssa.block_loop_weights(twice);
  failures = check(tw[1] == 8 && tw[2] == 8 && tw[3] == 8 && tw[4] == 1, "a loop with two back edges weighs 8", failures);
  let nulls: ssa.SFunc = ssa.drop_null_counts(counted_nulls());
  failures = check(!has(nulls, 2), "a count taken on a constant null goes", failures);
  failures = check(!has(nulls, 3), "a count given back on a constant null goes", failures);
  failures = check(has(nulls, 4), "a count given back on a parameter stays", failures);
  failures = check(has(nulls, 5) && has(nulls, 6) && nulls.nvals == 7, "a count on a null whose result is read stays", failures);
  print("failures=" + util.i32_to_string(failures));
  return failures;
}
