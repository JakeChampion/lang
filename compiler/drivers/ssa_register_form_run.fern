import "../ir";
import "../ssa";
import "../util";

function inst(kind: i32, v: i32, args: i32[], str: string): ssa.SInst {
  return ssa.SInst { ir_kind: if (kind == ssa.BINARY) { ir.kind_id(str) } else { 0 }, kind_tag: kind, result: v, args: args, imm: 0, str: str };
}

function jump(to: i32): ssa.STerm {
  return ssa.STerm { kind_tag: ssa.TERM_BR, cond: 0, target: to, t: 0, f: 0, value: 0 };
}

function branch(cond: i32, t: i32, f: i32): ssa.STerm {
  return ssa.STerm { kind_tag: ssa.TERM_BRIF, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function ret(v: i32): ssa.STerm {
  return ssa.STerm { kind_tag: ssa.TERM_RET, cond: 0, target: 0, t: 0, f: 0, value: v };
}

// A counter that a wrap keeps in range, read after the loop through an
// extension, and a parameter read through one.
function counted(): ssa.SFunc {
  let b0 = ssa.SBlock { id: 0, insts: [inst(ssa.PARAM, 0, [], ""), inst(ssa.CONST_INT, 1, [], "")], term: jump(1), preds: [] };
  let b1 = ssa.SBlock { id: 1, insts: [inst(ssa.PHI, 2, [1, 4], ""), inst(ssa.BINARY, 5, [2, 0], "lt_s")], term: branch(5, 2, 3), preds: [0, 2] };
  let b2 = ssa.SBlock { id: 2, insts: [inst(ssa.BINARY, 3, [2, 0], "add"), inst(ssa.UNARY, 4, [3], "int_wrap")], term: jump(1), preds: [1] };
  let tail: ssa.SInst[] = [inst(ssa.UNARY, 6, [2], "int_extend"), inst(ssa.UNARY, 7, [0], "int_extend"), inst(ssa.BINARY, 8, [6, 7], "add"), inst(ssa.BINARY, 9, [8, 1], "and"), inst(ssa.UNARY, 10, [9], "int_cast:u8")];
  let b3 = ssa.SBlock { id: 3, insts: tail, term: ret(10), preds: [1] };
  return ssa.SFunc { name: "counted", nparams: 1, nvals: 11, blocks: [b0, b1, b2, b3], entry: 0, takes_env: false };
}

function konst(v: i32, c: i32): ssa.SInst {
  return ssa.SInst { ir_kind: 0, kind_tag: ssa.CONST_INT, result: v, args: [], imm: c, str: "" };
}

// Blocks 3 and 4 each end two loops. Block 3 also branches to itself.
function shared_latches(): ssa.SFunc {
  let blocks: ssa.SBlock[] = [
    ssa.SBlock { id: 6, insts: [inst(ssa.PARAM, 0, [], "")], term: jump(0), preds: [] },
    ssa.SBlock { id: 0, insts: [], term: branch(0, 1, 5), preds: [6, 4] },
    ssa.SBlock { id: 1, insts: [], term: jump(2), preds: [0, 4] },
    ssa.SBlock { id: 2, insts: [], term: branch(0, 3, 4), preds: [1, 3] },
    ssa.SBlock { id: 3, insts: [], term: branch(0, 2, 3), preds: [2, 3] },
    ssa.SBlock { id: 4, insts: [], term: branch(0, 0, 1), preds: [2] },
    ssa.SBlock { id: 5, insts: [], term: ret(0), preds: [0] },
  ];
  return ssa.SFunc { name: "shared_latches", nparams: 1, nvals: 1, blocks: blocks, entry: 6, takes_env: false };
}

// A u32 shifted right by 17 and by 24, a parameter shifted without a u32
// wrap, and a u32 shifted by 32, each read through an extension.
function shifted(): ssa.SFunc {
  let insts: ssa.SInst[] = [
    inst(ssa.PARAM, 0, [], ""), konst(1, 17), inst(ssa.UNARY, 2, [0], "u32_wrap"),
    inst(ssa.BINARY, 3, [2, 1], "shr_u"), inst(ssa.UNARY, 4, [3], "int_cast:i32"),
    konst(5, 24), inst(ssa.BINARY, 6, [2, 5], "shr_u"), inst(ssa.UNARY, 7, [6], "int_cast:u8"),
    inst(ssa.BINARY, 8, [0, 1], "shr_u"), inst(ssa.UNARY, 9, [8], "int_cast:i32"),
    konst(10, 32), inst(ssa.BINARY, 11, [2, 10], "shr_u"), inst(ssa.UNARY, 12, [11], "int_cast:i32"),
    inst(ssa.BINARY, 13, [4, 7], "add"), inst(ssa.BINARY, 14, [13, 9], "add"), inst(ssa.BINARY, 15, [14, 12], "add"),
  ];
  let b0 = ssa.SBlock { id: 0, insts: insts, term: ret(15), preds: [] };
  return ssa.SFunc { name: "shifted", nparams: 1, nvals: 16, blocks: [b0], entry: 0, takes_env: false };
}

// A sum read only as an index, a difference read as an index and as a value,
// and a product read by a raw load, each through an i32 cast.
function indexed(): ssa.SFunc {
  let insts: ssa.SInst[] = [
    inst(ssa.PARAM, 0, [], ""), inst(ssa.PARAM, 1, [], ""), inst(ssa.PARAM, 2, [], ""),
    inst(ssa.BINARY, 3, [1, 2], "add"), inst(ssa.UNARY, 4, [3], "int_cast:i32"), inst(ssa.ARR_AT, 5, [0, 4], "u8"),
    inst(ssa.BINARY, 6, [1, 2], "sub"), inst(ssa.UNARY, 7, [6], "int_cast:i32"), inst(ssa.ARR_AT, 8, [0, 7], "u8"),
    inst(ssa.BINARY, 9, [8, 7], "add"), inst(ssa.BINARY, 10, [5, 9], "add"),
    inst(ssa.BINARY, 11, [1, 2], "mul"), inst(ssa.UNARY, 12, [11], "int_cast:i32"), inst(ssa.LD_SUM, 13, [0, 12], ""),
    inst(ssa.BINARY, 14, [10, 13], "add"),
  ];
  let b0 = ssa.SBlock { id: 0, insts: insts, term: ret(14), preds: [] };
  return ssa.SFunc { name: "indexed", nparams: 3, nvals: 15, blocks: [b0], entry: 0, takes_env: false };
}

// A counter that counts down while it is greater than zero, or while it is
// less than zero, and wraps each step.
function counted_down(test: string): ssa.SFunc {
  let b0 = ssa.SBlock { id: 0, insts: [inst(ssa.PARAM, 0, [], ""), konst(1, 1), konst(2, 0)], term: jump(1), preds: [] };
  let b1 = ssa.SBlock { id: 1, insts: [inst(ssa.PHI, 3, [0, 5], ""), inst(ssa.BINARY, 6, [3, 2], test)], term: branch(6, 2, 3), preds: [0, 2] };
  let b2 = ssa.SBlock { id: 2, insts: [inst(ssa.BINARY, 4, [3, 1], "sub"), inst(ssa.UNARY, 5, [4], "int_wrap")], term: jump(1), preds: [1] };
  let b3 = ssa.SBlock { id: 3, insts: [], term: ret(3), preds: [1] };
  return ssa.SFunc { name: "counted_down", nparams: 1, nvals: 7, blocks: [b0, b1, b2, b3], entry: 0, takes_env: false };
}

// The low byte of the first parameter is the result. The function calls
// `callee` with the first parameter plus one, wrapped to 32 bits. With
// `wide`, the function also returns the first parameter.
function stepped(callee: string, wide: boolean): ssa.SFunc {
  let insts: ssa.SInst[] = [
    inst(ssa.PARAM, 0, [], ""), ssa.SInst { ...inst(ssa.PARAM, 1, [], ""), imm: 1 }, konst(2, 255), inst(ssa.BINARY, 3, [0, 2], "and"),
    konst(4, 1), inst(ssa.BINARY, 5, [0, 4], "add"), inst(ssa.UNARY, 6, [5], "int_cast:i32"),
  ];
  let b0 = ssa.SBlock { id: 0, insts: insts, term: branch(1, 1, 2), preds: [] };
  let b1 = ssa.SBlock { id: 1, insts: [], term: ret(if (wide) { 0 } else { 3 }), preds: [0] };
  let b2 = ssa.SBlock { id: 2, insts: [inst(ssa.CALL, 7, [6, 1], callee)], term: ret(7), preds: [0] };
  return ssa.SFunc { name: "stepped", nparams: 2, nvals: 8, blocks: [b0, b1, b2], entry: 0, takes_env: false };
}

// A count taken on a constant null, one given back on it, one given back on
// a parameter, and one on the null whose result is read.
function counted_nulls(): ssa.SFunc {
  let insts: ssa.SInst[] = [
    inst(ssa.PARAM, 0, [], ""), konst(1, 0),
    inst(ssa.CALL, 2, [1], "__fern_rc_inc"), inst(ssa.CALL, 3, [1], "__fern_rc_dec"),
    inst(ssa.CALL, 4, [0], "__fern_rc_dec"), inst(ssa.CALL, 5, [1], "__fern_rc_dec"),
    inst(ssa.BINARY, 6, [5, 0], "add"),
  ];
  let b0 = ssa.SBlock { id: 0, insts: insts, term: ret(6), preds: [] };
  return ssa.SFunc { name: "counted_nulls", nparams: 1, nvals: 7, blocks: [b0], entry: 0, takes_env: false };
}

function has(f: ssa.SFunc, v: i32): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.result == v) {
        return true;
      }
    }
  }
  return false;
}

function check(ok: boolean, what: string, failures: i32): i32 {
  if (ok) {
    return failures;
  }
  print("FAIL " + what);
  return failures + 1;
}

function main(): i32 {
  let failures = 0;
  let folded = ssa.fold_extensions(counted());
  let g = folded.f;
  failures = check(!has(g, 6) && folded.repl[6] == 2, "an extension of a phi of wrapped values goes", failures);
  failures = check(has(g, 4), "the wrap of a sum stays", failures);
  failures = check(has(g, 7), "an extension of a parameter stays", failures);
  failures = check(!has(g, 10) && g.blocks[3].term.value == 9, "a byte cast of an and with a byte constant goes", failures);
  failures = check(g.blocks[3].insts[1].result == 8 && g.blocks[3].insts[1].args[0] == 2, "a read of a dropped extension reads its operand", failures);
  let narrow = ssa.fold_extensions(shifted()).f;
  failures = check(!has(narrow, 4), "an i32 cast of a u32 shifted right by 17 goes", failures);
  failures = check(!has(narrow, 7), "a byte cast of a u32 shifted right by 24 goes", failures);
  failures = check(has(narrow, 9), "an i32 cast of a shifted parameter stays", failures);
  failures = check(has(narrow, 12), "an i32 cast of a u32 shifted by 32 stays", failures);
  let zx = ssa.zero_extended_indices(indexed());
  let uses = ssa.use_counts(zx);
  failures = check(zx.blocks[0].insts[4].str == "u32_wrap", "an i32 cast read only as an index zero-extends", failures);
  failures = check(zx.blocks[0].insts[7].str == "int_cast:i32", "an i32 cast read as a value stays signed", failures);
  failures = check(ssa.low_word_pair(zx.blocks[0], 3, uses), "a sum and its zero-extension pair", failures);
  failures = check(!ssa.low_word_pair(zx.blocks[0], 6, uses), "a difference and a sign extension do not pair", failures);
  failures = check(zx.blocks[0].insts[12].str == "int_cast:i32", "an i32 cast read by a raw load stays signed", failures);
  let down = ssa.drop_low_wraps(counted_down("gt_s"));
  failures = check(down.repl.len() > 5 && down.repl[5] == 4, "the wrap of a decrement below a greater-than test goes", failures);
  let under = ssa.drop_low_wraps(counted_down("lt_s"));
  failures = check(under.repl.len() == 0 || under.repl[5] == 5, "the wrap of a decrement below a less-than test stays", failures);
  let own_step = ssa.drop_low_wraps(stepped("stepped", false));
  failures = check(own_step.repl.len() > 6 && own_step.repl[6] == 5, "a call of the function itself reads the low byte of its argument, so the wrap goes", failures);
  let other_step = ssa.drop_low_wraps(stepped("other", false));
  failures = check(other_step.repl.len() == 0 || other_step.repl[6] == 6, "a call of another function reads each bit of its argument", failures);
  let wide_step = ssa.drop_low_wraps(stepped("stepped", true));
  failures = check(wide_step.repl.len() == 0 || wide_step.repl[6] == 6, "a parameter that the function returns needs each bit of the argument", failures);
  let w = ssa.block_loop_weights(counted());
  failures = check(w[0] == 1 && w[1] == 8 && w[2] == 8 && w[3] == 1, "a loop weighs 8", failures);
  let f = counted();
  let b1 = ssa.SBlock { ...f.blocks[1], insts: [inst(ssa.PHI, 2, [1, 4, 4], ""), inst(ssa.BINARY, 5, [2, 0], "lt_s")], preds: [0, 2, 3] };
  let b3 = ssa.SBlock { ...f.blocks[3], term: branch(9, 1, 4) };
  let b4 = ssa.SBlock { id: 4, insts: [], term: ret(9), preds: [3] };
  let twice = ssa.SFunc { ...f, blocks: [f.blocks[0], b1, f.blocks[2], b3, b4] };
  let tw = ssa.block_loop_weights(twice);
  failures = check(tw[1] == 8 && tw[2] == 8 && tw[3] == 8 && tw[4] == 1, "a loop with two back edges weighs 8", failures);
  let nested = ssa.block_loop_weights(shared_latches());
  failures = check(nested[0] == 1 && nested[1] == 8 && nested[2] == 64 && nested[3] == 512 && nested[4] == 512 && nested[5] == 64 && nested[6] == 1, "shared latches end all their loops after the block", failures);
  let nulls = ssa.form(counted_nulls()).f;
  failures = check(!has(nulls, 2), "a count taken on a constant null goes", failures);
  failures = check(!has(nulls, 3), "a count given back on a constant null goes", failures);
  failures = check(has(nulls, 4), "a count given back on a parameter stays", failures);
  failures = check(has(nulls, 5) && has(nulls, 6) && nulls.nvals == 7, "a count on a null whose result is read stays", failures);
  print("failures=" + util.i32_to_string(failures));
  return failures;
}
