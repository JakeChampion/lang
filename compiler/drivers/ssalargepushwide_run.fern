import "../ssalargepushwideranges" as ranges;
import "../ssalargepushwidevalue" as value;
import "./ssalargepushpartitions" as legacy_ranges;
import "./ssalargepushwidecases" as reference;
import "std/i32";
import "std/i64";

struct Reference { low: i64, high: i64, index: i32, rounded: i64 }

struct WordReference { number: i64, low: i64, high: i64 }

function require(ok: boolean, group: string): void {
  if (!ok) {
    eprint("wide large-push arithmetic controls failed: " + group);
    exit(180);
  }
}

function constant(r: ranges.Interval, v: value.Value, n: i64): boolean {
  return value.valid(r, v) && v.factor == 0 && v.offset == n;
}

