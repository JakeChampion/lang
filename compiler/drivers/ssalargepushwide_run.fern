function partitions(): void {
  let actual = ranges.intervals();
  let expected = references();
  let bins = ranges.capacities();
  require(actual.len() == 77 && expected.len() == 77 && bins.len() == 61, "wide coverage counts");
  let next = 0 as i64;
  let index = 0;
  for row in expected {
    let r = actual[index];
    require(r.low == row.low && r.high == row.high && r.low == next, "reference partition " + index.to_string());
    require(ranges.valid(r) && ranges.expected_class(r) == row.index && ranges.rounded(r) == row.rounded, "reference class " + index.to_string());
    require(bins[row.index] == row.rounded, "ordered capacity");
    next = r.high + 1 as i64;
    index = index + 1;
  }
  require(next == 17179869185 as i64, "complete integer input domain");
  let all = ranges.Interval { low: 0, high: 17179869184 };
  require(ranges.valid(all) && ranges.expected_class(all) == -1 && ranges.rounded(all) == -(1 as i64), "mixed facts remain unknown");
  require(!ranges.valid(ranges.Interval { low: 0, high: 17179869185 }), "domain upper bound");
  require(!ranges.valid(ranges.Interval { low: -1, high: 0 }) && !ranges.valid(ranges.Interval { low: 2, high: 1 }), "invalid interval");
}

function word_references(): WordReference[] {
  return [
    WordReference { number: -34359738367, low: 1, high: 4294967288 },
    WordReference { number: -4294967297, low: 4294967295, high: 4294967294 },
    WordReference { number: -4294967296, low: 0, high: 4294967295 },
    WordReference { number: -1, low: 4294967295, high: 4294967295 },
    WordReference { number: 0, low: 0, high: 0 },
    WordReference { number: 1, low: 1, high: 0 },
    WordReference { number: 4294967295, low: 4294967295, high: 0 },
    WordReference { number: 4294967296, low: 0, high: 1 },
    WordReference { number: 17179869184, low: 0, high: 4 },
    WordReference { number: 34359738367, low: 4294967295, high: 7 },
  ];
}

function words(): void {
  let r = ranges.Interval { low: 0, high: 0 };
  for row in word_references() {
    let v = value.number(r, row.number);
    let low = value.zero32(r, v);
    let high = value.high32(r, v);
    require(constant(r, low, row.low) && constant(r, high, row.high), "signed floor word projection");
    require(constant(r, value.join32(r, low, high), row.number), "signed word reconstruction");
  }
  r = ranges.Interval { low: 4294967296, high: 4294967396 };
  let v = value.original(r);
  let low = value.zero32(r, v);
  let high = value.high32(r, v);
  require(low.factor == 1 && low.offset == -(4294967296 as i64) && constant(r, high, 1 as i64), "affine high word");
  let joined = value.join32(r, low, high);
  require(joined.factor == 1 && joined.offset == 0 as i64, "affine word reconstruction");
  r = ranges.Interval { low: 4294967295, high: 4294967296 };
  require(!value.valid(r, value.zero32(r, value.original(r))) && !value.valid(r, value.high32(r, value.original(r))), "word crossing remains unknown");
}

function arithmetic(): void {
  let r = ranges.Interval { low: 3758096385, high: 4294967295 };
  let v = value.original(r);
  let sum = value.add(r, v, 536870911 as i64);
  let rounded = value.mask(r, sum, value.number(r, -(536870912 as i64)));
  require(constant(r, rounded, 4294967296 as i64), "wide rounding boundary");
  require(value.bit_scan(r, rounded) == 32 && value.power(34) == 17179869184 as i64, "wide highest bit");
  require(value.power(-1) == 0 as i64 && value.power(35) == 0 as i64, "power bounds");
  r = ranges.Interval { low: 0, high: 17179869184 };
  v = value.original(r);
  let c = value.compare(r, v, 17179869184 as i64);
  require(c.less == -1 && c.equal == -1 && c.less_equal == 1, "whole-domain comparison");
  require(!value.valid(r, value.Value { factor: 2, offset: 0 as i64 }), "invalid factor");
  require(!value.valid(r, value.number(r, 34359738368 as i64)), "constant bound");
  require(!value.valid(r, value.Value { factor: 1, offset: 34359738367 as i64 }), "endpoint bound");
  require(!value.valid(r, value.negate(r, v)), "unsupported affine negation");
  r = ranges.Interval { low: 0, high: 0 };
  require(!value.valid(r, value.add(r, value.number(r, 34359738367 as i64), 1 as i64)), "addition bound");
  require(!value.valid(r, value.join32(r, value.number(r, 0 as i64), value.number(r, 8 as i64))), "join bound");
}

function value_fact(row: reference.Case, r: ranges.Interval, v: value.Value, other: value.Value): value.Value {
  if (row.op == 3) {
    return value.number(r, row.scalar);
  }
  if (row.op == 4) {
    return value.original(r);
  }
  if (row.op == 6) {
    return value.add(r, v, row.scalar);
  }
  if (row.op == 7) {
    return value.negate(r, v);
  }
  if (row.op == 8) {
    return value.zero32(r, v);
  }
  if (row.op == 9) {
    return value.high32(r, v);
  }
  if (row.op == 10) {
    return value.join32(r, v, other);
  }
  if (row.op == 13) {
    return value.mask(r, v, other);
  }
  require(false, "unknown value operation");
  return value.unknown();
}

function scalar_fact(row: reference.Case, r: ranges.Interval, v: value.Value): i64 {
  if (row.op == 0) {
    return if (ranges.valid(r)) { 1 as i64 } else { 0 as i64 };
  }
  if (row.op == 1) {
    return ranges.expected_class(r) as i64;
  }
  if (row.op == 2) {
    return ranges.rounded(r);
  }
  if (row.op == 5) {
    return if (value.valid(r, v)) { 1 as i64 } else { 0 as i64 };
  }
  if (row.op == 11) {
    return value.power(row.scalar as i32);
  }
  if (row.op == 12) {
    return value.bit_scan(r, v) as i64;
  }
  require(false, "unknown scalar operation");
  return 0 as i64;
}

function value_operation(op: i32): boolean {
  return op == 3 || op == 4 || op == 6 || op == 7 || op == 8 || op == 9 || op == 10 || op == 13;
}

function reference_case(row: reference.Case): void {
  let r = ranges.Interval { low: row.low, high: row.high };
  let v = value.Value { factor: row.factor, offset: row.offset };
  let other = value.Value { factor: row.other_factor, offset: row.other_offset };
  let name = "reference case " + row.id.to_string() + " op " + row.op.to_string();
  if (row.op == 14) {
    let c = value.compare(r, v, row.scalar);
    require(c.less == row.less && c.equal == row.equal && c.less_equal == row.less_equal, name + " comparison");
  } else if (value_operation(row.op)) {
    let actual = value_fact(row, r, v, other);
    require(actual.factor == row.expected_factor && actual.offset == row.expected_offset, name + " expected " + row.expected_factor.to_string() + ":" + row.expected_offset.to_string() + " got " + actual.factor.to_string() + ":" + actual.offset.to_string());
  } else {
    let actual = scalar_fact(row, r, v);
    require(actual == row.expected_scalar, name + " expected " + row.expected_scalar.to_string() + " got " + actual.to_string());
  }
}

function reference_cases(): void {
  let rows = reference.rows();
  require(rows.len() == reference.count() && rows.len() == 4474, "fixed independent reference coverage");
  let next = 0;
  for row in rows {
    require(row.id == next, "reference ordinal");
    reference_case(row);
    next = next + 1;
  }
  require(next == 4474, "complete reference execution");
}

function main(): i32 {
  legacy_ranges.run();
  partitions();
  words();
  arithmetic();
  reference_cases();
  print("wide large-push arithmetic controls passed");
  return 0;
}
