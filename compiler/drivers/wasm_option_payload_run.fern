import "../wasm_ir";

function show(s: string): string {
  if (s.len() == 0) {
    return "<empty>";
  }

  return s;
}

function main(): i32 {
  let corpus: string[] = [
    "Option[i32]", "Option[u32]", "Option[string]", "Option[Foo]",
    "Option[Map[a, b]]", "Option[(string, string)]", "Option[i32][]",
    "Option[]", "Option",
    "Result[i32, u32]", "Result[string, IoError]", "Result[i32]",
    "Result[Map[a, b], i32]", "Result[i32, u32][]", "Result[i32, u32, x]",
    "Result",
    "i32", "string", "Foo", "u8[]", "", "Map[string, i32]",
  ];
  let out = "";
  for i in 0..corpus.len() {
    let t = corpus[i];
    let opt = wasm_ir.parse_option_payload(t);
    let err = wasm_ir.parse_result_err_payload(t);
    out = out + show(t) + " opt=" + show(opt) + " err=" + show(err) + "\n";
  }
  write(out);
  return 0;
}
