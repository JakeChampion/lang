import "../asmcore";
import "../asm_ir";
import "../asm_arm64_ir";
import "../lexer";
import "../parser";
import "../semlower";
import "../ssaprepare";
import "../ssacreditemitted" as emitted;
import "../ssacreditselected" as selected;
import "../physicalbody";
import "../ssasem";
import "../semrecords";
import "../ssa";
import "../util";
import "./ssaretainedmutations" as mutations;

function require(ok: boolean, code: i32): void {
  if (!ok) {
    exit(code);
  }
}

function source(exiting: boolean): string {
  let assertion = if (exiting) { "if (!ok) { exit(code); }" } else { "if (ok) { return; } return;" };
  return "struct Leaf { n: i32 } struct Parent { left: Leaf, right: Leaf } struct Other { first: Leaf, second: Leaf } "
    + "@noinline function require(ok: boolean, code: i32): void { " + assertion + " } "
    + "@noinline function parent(left: Leaf, right: Leaf): Parent { return Parent { left: left, right: right }; } "
    + "@noinline function replace(own p: Parent, child: Leaf): Other { let n = p.left.n + p.right.n; require(n > 0, 1); return Other { first: child, second: child }; } "
    + "@noinline function handoff(flag: boolean, left: Leaf, right: Leaf, incoming: Leaf): Other { let p = if (flag) { parent(left, right) } else { parent(right, left) }; return replace(p, incoming); } "
    + "function main(): i32 { let c: Leaf = Leaf { n: 7 }; let p = handoff(true,c,c,c); return p.first.n - 7; }";
}

function emit(arm: boolean, exiting: boolean, debug: boolean): ssaprepare.Emitted[] {
  return emit_source(arm, source(exiting), debug);
}

function emit_source(arm: boolean, src: string, debug: boolean): ssaprepare.Emitted[] {
  let mod = parser.parse_module(lexer.tokenize(src));
  require(!asmcore.refuse_parse_unknowns([mod]) && !asmcore.refuse_decl_names([mod]), 61);
  let g = semlower.program(semlower.driven(mod, "x86-64-linux"));
  require(g.ok, 62);
  let sw = asmcore.Switches { backtrace: false, sanitize: debug };
  if (arm) {
    return asm_arm64_ir.emit_module_ir_unit_arm64_prepared(g.im, false, false, "", [], g.im.funcs, g.stab, 0, -1, g.cache, g.physical, semlower.runtime_lowering, sw, true).bodies;
  }
  return asm_ir.emit_module_ir_unit_prepared(g.im, false, false, "", [], g.im.funcs, g.stab, 0, -1, g.cache, g.physical, semlower.runtime_lowering, 0 as usize, sw, true).bodies;
}

function check(rows: ssaprepare.Emitted[], architecture: string, ok: boolean): void {
  let p = emitted.check_wrapper(rows, "handoff", "replace", "__sem_drop_Parent", "__sem_release_Parent", ["require"], architecture);
  if (p.ok != ok || p.function_name == "" || p.message == "") {
    print(p.function_name + ": " + p.message);
    exit(63);
  }
}

function wanted(): string[] {
  return ["handoff", "replace", "parent", "__sem_drop_Parent", "__sem_release_Parent", "require"];
}

function without(rows: ssaprepare.Emitted[], name: string): ssaprepare.Emitted[] {
  let out: ssaprepare.Emitted[] = [];
  for row in rows {
    if (row.label_name != name) {
      out = out.append(row);
    }
  }
  return out;
}

function metadata(row: ssaprepare.Emitted, m: physicalbody.Metadata): ssaprepare.Emitted {
  let s = physicalbody.Selected { producers: [m], origin: physicalbody.Origin { producer: 0, symbol: row.body.selected.origin.symbol } };
  return ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, selected: s } };
}

function boundaries(rows: ssaprepare.Emitted[], architecture: string): void {
  let hits = 0;
  for row in rows {
    if (util.has_str(wanted(), row.label_name)) {
      hits = hits + 1;
      let rest = without(rows, row.label_name);
      check(rest, architecture, false);
      check(rows.append(row), architecture, false);
      check(rest.append(mutations.damaged(row)), architecture, false);
      let f = row.body.formed.f;
      let bad = [ssa.SFunc { ...f, takes_env: true }, ssa.SFunc { ...f, nparams: f.nparams + 1 }];
      for changed in bad {
        check(rest.append(ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, formed: ssa.Formed { ...row.body.formed, f: changed } } }), architecture, false);
      }
      check(rest.append(ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, selected: physicalbody.Selected { producers: [], origin: physicalbody.Origin { producer: -1, symbol: "" } } } }), architecture, false);
      check(rest.append(ssaprepare.Emitted { ...row, context: ssaprepare.Context { ...row.context, architecture: "wasm32-wasi" } }), architecture, false);
    }
  }
  require(hits == wanted().len(), 64);
}

function schemas(rows: ssaprepare.Emitted[], architecture: string): void {
  for row in rows {
    if (util.has_str(wanted(), row.label_name) && row.label_name != "require") {
      let m = selected.metadata(row);
      let rest = without(rows, row.label_name);
      check(rest.append(metadata(row, physicalbody.Metadata { ...m, records: semrecords.no_records() })), architecture, false);
      let recs: semrecords.Record[] = [];
      let duplicate = m.records.list;
      for r in m.records.list {
        if (semrecords.name_of(r.ty) == "Leaf") {
          duplicate = duplicate.append(r);
          // Same nominal type and capacity, different ordered scalar schema.
          recs = recs.append(semrecords.Record { ...r, fields: [semrecords.Field { ...r.fields[0], name: "wrong" }] });
        } else {
          recs = recs.append(r);
        }
      }
      check(rest.append(metadata(row, physicalbody.Metadata { ...m, records: semrecords.records_of(recs) })), architecture, false);
      check(rest.append(metadata(row, physicalbody.Metadata { ...m, records: semrecords.records_of(duplicate) })), architecture, false);
      check(rest.append(metadata(row, physicalbody.Metadata { ...m, finalizers: [ssasem.Finalizer { receiver: "Leaf", symbol: "finalize" }] })), architecture, false);
    }
  }
}

function own_stores(rows: ssaprepare.Emitted[], architecture: string): void {
  let separate: ssaprepare.Emitted[] = [];
  for row in rows {
    if (util.has_str(wanted(), row.label_name)) {
      let m = selected.metadata(row);
      let cs = selected.contracts(row);
      let own = metadata(row, physicalbody.Metadata { ...m, contracts: cs });
      separate = separate.append(own);
      if (util.has_str(["handoff", "replace", "parent", "require"], row.label_name)) {
        let rest = without(rows, row.label_name);
        check(rest.append(metadata(row, physicalbody.Metadata { ...m, contracts: [] })), architecture, false);
        check(rest.append(metadata(row, physicalbody.Metadata { ...m, contracts: cs.append(cs[0]) })), architecture, false);
        check(rest.append(metadata(row, physicalbody.Metadata { ...m, contracts: [ssasem.Contract { ...cs[0], modes: [] }] })), architecture, false);
      }
    }
  }
  // Every row has its own single-entry store at local index zero and only its
  // own declaration ABI. Neither the wrapper nor consumer can supply the rest.
  check(separate, architecture, true);
  let reversed: ssaprepare.Emitted[] = [];
  for row in separate {
    reversed = util.append_all([row], reversed);
  }
  check(reversed, architecture, true);
  schemas(separate, architecture);
}

pub function run(arm: boolean): void {
  let architecture = if (arm) { "arm64" } else { "x86-64" };
  let rows = emit(arm, false, true);
  check(rows, architecture, true);
  check([], architecture, false);
  check(rows, "wasm32-wasi", false);
  boundaries(rows, architecture);
  own_stores(rows, architecture);
  independent_producer(rows, arm, architecture);
  let renamed = mutations.renamed(rows, wanted());
  let proof = emitted.check_wrapper(renamed, "bound_handoff", "bound_replace", "bound___sem_drop_Parent", "bound___sem_release_Parent", ["bound_require"], architecture);
  require(proof.ok, 65);
  let normal = emitted.check_wrapper(emit(arm, false, false), "handoff", "replace", "__sem_drop_Parent", "__sem_release_Parent", ["require"], architecture);
  require(!normal.ok && normal.message == "__sem_release_Parent: unproved native release entry effects", 66);
  check(emit(arm, true, true), architecture, false);
}

function independent_producer(rows: ssaprepare.Emitted[], arm: boolean, architecture: string): void {
  for wide in [false, true] {
    let src = "struct Leaf { n: " + (if (wide) { "i64" } else { "i32" }) + " } struct Parent { left: Leaf, right: Leaf } struct Unrelated { flag: boolean } "
      + "@noinline function parent(left: Leaf, right: Leaf): Parent { return Parent { left: left, right: right }; } function main(): i32 { return 0; }";
    let independent = emit_source(arm, src, true);
    let hits = 0;
    for row in independent {
      if (row.label_name == "parent") {
        hits = hits + 1;
        require(row.body.selected.origin.producer == 0, 68);
        // Same symbols, field names, capacity and untyped stores. A different
        // scalar width in an independently lowered child must still refuse.
        check(without(rows, "parent").append(row), architecture, !wide);
      }
    }
    require(hits == 1, 69);
  }
}
