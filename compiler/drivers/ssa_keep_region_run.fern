import "../ssakeepregion";
import "../ssaunits";

function rows(): ssaunits.Keeps {
  return ssaunits.Keeps {
    donors: [10, 11, 12, 13], slots: [[true], [], [], [true]],
    values: [[20], [], [], [24]], late: [[20], [], [], []],
    moved: [[21], [22], [23], []], freed: [[true], [true], [], [false]],
    start: [0, 1, 3, 8], taken: [2, 4, 6, 8], built: [7, 0 - 1, 0 - 1, 9], lives: [false, false, true, false],
  };
}

function matches(w: ssakeepregion.Witness, row: i32, slot: i32, tested: boolean): boolean {
  return w.ok && w.why == "" && w.row == row && w.slot == slot && w.tested == tested;
}

function region_dimensions(b: ssakeepregion.Bound): i32 {
  if (!b.ok || b.region.transient != 1000 || b.region.keep_count != 3 || b.region.scratch_start != 1004) {
    return 1;
  }
  return 0;
}

function assigned_slots(b: ssakeepregion.Bound, block: i32): boolean {
  return matches(ssakeepregion.at(b, block, 0), 0, 1001, false)
    && matches(ssakeepregion.at(b, block, 1), 1, 1002, false)
    && matches(ssakeepregion.at(b, block, 2), 2, 1003, true)
    && matches(ssakeepregion.at(b, block, 3), 3, 1001, false);
}

function value_slots(b: ssakeepregion.Bound, block: i32): boolean {
  return matches(ssakeepregion.for_value(b, block, 4, 20), 0, 1001, false)
    && matches(ssakeepregion.for_value(b, block, 4, 21), 0, 1001, false)
    && matches(ssakeepregion.for_value(b, block, 4, 22), 1, 1002, false)
    && matches(ssakeepregion.for_value(b, block, 4, 23), 2, 1003, true)
    && matches(ssakeepregion.for_value(b, block, 8, 24), 3, 1001, false);
}

function donor_slots(b: ssakeepregion.Bound, block: i32): boolean {
  return matches(ssakeepregion.for_donor(b, block, 7, 10), 0, 1001, false)
    && matches(ssakeepregion.for_donor(b, block, 4, 11), 1, 1002, false)
    && matches(ssakeepregion.for_donor(b, block, 6, 12), 2, 1003, true);
}

function block_witnesses(b: ssakeepregion.Bound): i32 {
  for block in [0, 2] {
    if (!assigned_slots(b, block)) {
      return 2;
    }
    if (!value_slots(b, block)) {
      return 3;
    }
    if (!donor_slots(b, block)) {
      return 4;
    }
  }
  return 0;
}

function live_query_bounds(b: ssakeepregion.Bound): i32 {
  if (ssakeepregion.for_value(b, 0, 0, 22).ok || ssakeepregion.for_value(b, 0, 5, 22).ok
    || ssakeepregion.for_value(b, 0, 7, 23).ok || ssakeepregion.for_donor(b, 0, 8, 10).ok
    || ssakeepregion.for_donor(b, 1, 4, 10).ok || ssakeepregion.for_value(b, 0, 4, 99).ok) {
    return 5;
  }
  return 0;
}

function invalid_queries(b: ssakeepregion.Bound): i32 {
  if (ssakeepregion.at(b, 0 - 1, 0).ok || ssakeepregion.at(b, 3, 0).ok
    || ssakeepregion.at(b, 0, 0 - 1).ok || ssakeepregion.at(b, 0, 4).ok
    || ssakeepregion.for_value(b, 0, 0 - 1, 20).ok || ssakeepregion.for_donor(b, 0, 2, 0 - 1).ok) {
    return 6;
  }
  return 0;
}

function rejected_rows(k: ssaunits.Keeps): i32 {
  if (ssakeepregion.bind([ssaunits.Keeps { ...k, start: [0] }], 0).ok
    || ssakeepregion.bind([ssaunits.Keeps { ...k, donors: [0 - 1, 11, 12, 13] }], 0).ok
    || ssakeepregion.bind([ssaunits.Keeps { ...k, taken: [0 - 1, 4, 6, 8] }], 0).ok
    || ssakeepregion.bind([ssaunits.Keeps { ...k, built: [1, 0 - 1, 0 - 1, 9] }], 0).ok
    || ssakeepregion.bind([ssaunits.Keeps { ...k, lives: [true, false, true, false] }], 0).ok) {
    return 7;
  }
  if (ssakeepregion.bind([ssaunits.Keeps { ...k, donors: [10, 10, 12, 13] }], 0).ok
    || ssakeepregion.bind([ssaunits.Keeps { ...k, moved: [[21], [21], [23], []] }], 0).ok
    || ssakeepregion.bind([ssaunits.Keeps { ...k, moved: [[21], [20], [23], []] }], 0).ok
    || ssakeepregion.bind([ssaunits.Keeps { ...k, values: [[20], [], [], [0 - 1]] }], 0).ok) {
    return 8;
  }
  return 0;
}

function repeated_identity(k: ssaunits.Keeps): i32 {
  // A repeated identity in a disjoint interval selects the row at that instruction.
  let repeated: ssaunits.Keeps = ssaunits.Keeps { ...k, donors: [10, 11, 12, 10], values: [[20], [], [], [20]] };
  let separate: ssakeepregion.Bound = ssakeepregion.bind([repeated], 1000);
  if (!separate.ok || !matches(ssakeepregion.for_donor(separate, 0, 9, 10), 3, 1001, false)
    || !matches(ssakeepregion.for_value(separate, 0, 9, 20), 3, 1001, false)) {
    return 9;
  }
  return 0;
}

function invalid_boundary(k: ssaunits.Keeps): i32 {
  let invalid: ssakeepregion.Bound = ssakeepregion.bind([k], 2147483646);
  if (invalid.ok || ssakeepregion.at(invalid, 0, 0).ok || ssakeepregion.for_value(invalid, 0, 4, 20).ok) {
    return 10;
  }
  return 0;
}

function nested_donor(k: ssaunits.Keeps): i32 {
  // A child is a retained field of its parent and a donor for a different witness.
  let nested = ssakeepregion.bind([ssaunits.Keeps { ...k, donors: [10, 20, 12, 13] }], 1000);
  if (!nested.ok || !matches(ssakeepregion.for_value(nested, 0, 4, 20), 0, 1001, false)
    || !matches(ssakeepregion.for_donor(nested, 0, 4, 20), 1, 1002, false)
    || ssakeepregion.value_row(nested, 0, 4, 20) != 0
    || ssakeepregion.value_row(nested, 0, 7, 22) != 0 - 1) {
    return 11;
  }
  return 0;
}

function main(): i32 {
  let k: ssaunits.Keeps = rows();
  let b: ssakeepregion.Bound = ssakeepregion.bind([k, ssaunits.no_keeps(), k], 1000);
  let code: i32 = region_dimensions(b);
  if (code != 0) {
    return code;
  }
  code = block_witnesses(b);
  if (code != 0) {
    return code;
  }
  code = live_query_bounds(b);
  if (code != 0) {
    return code;
  }
  code = invalid_queries(b);
  if (code != 0) {
    return code;
  }
  code = rejected_rows(k);
  if (code != 0) {
    return code;
  }
  code = repeated_identity(k);
  if (code != 0) {
    return code;
  }
  code = invalid_boundary(k);
  if (code != 0) {
    return code;
  }
  return nested_donor(k);
}
