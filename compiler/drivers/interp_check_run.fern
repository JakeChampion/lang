// The interpreter's self-checks. Each check is a std/test case. A failed
// case names the condition that did not hold.

import "../aborts";
import "../aesref";
import "../ast";
import "../astwalk";
import "../builtinsigs";
import "../checker";
import "../interp";
import "../interpheap";
import "../lexer";
import "../lexical";
import "../parser";
import "../platforms";
import "../typeinfo";
import "../util";
import "std/f64";
import "std/rand";
import "std/string";
import "std/utf8";
import "std/test";

function eval_program(prog: ast.Stmt[]): interp.Value {
  let heap = interpheap.create();
  let env = interp.new_env(heap);
  for i in 0..prog.len() {
    env = interp.cellify_captures(env, prog[i], prog);
    let r = interp.eval_stmt(prog[i], env);
    env = r.env;
    if (r.sig != 0) {
      return r.ret;
    }
  }
  return interp.v_err("program reached end without `return`");
}

function run_source(src: string): interp.Value {
  let toks = lexer.tokenize(src);
  let stmts = parser.parse_program(toks);
  return eval_program(stmts);
}

function run_module(src: string): interp.Value {
  let toks = lexer.tokenize(src);
  let mod = parser.parse_module(toks);
  return interp.eval_module(mod);
}

function main(): i32 {
  let r = test.new("interp");
  r = r.it("arithmetic and idents", check_arithmetic_and_idents);
  r = r.it("conditionals and assignment", check_conditionals_and_assignment);
  r = r.it("while loops", check_while_loops);
  r = r.it("functions and recursion", check_functions_and_recursion);
  r = r.it("arrays", check_arrays);
  r = r.it("string indexing", check_string_indexing);
  r = r.it("slicing", check_slicing);
  r = r.it("compound assignment", check_compound_assignment);
  r = r.it("structs and fields", check_structs_and_fields);
  r = r.it("match statements", check_match_statements);
  r = r.it("receiver methods", check_receiver_methods);
  r = r.it("floats", check_floats);
  r = r.it("for in loops", check_for_in_loops);
  r = r.it("tuples", check_tuples);
  r = r.it("break and continue", check_break_and_continue);
  r = r.it("primitive receivers", check_primitive_receivers);
  r = r.it("structural equality", check_structural_equality);
  r = r.it("union receiver method", check_union_receiver_method);
  r = r.it("lambdas and closures", check_lambdas_and_closures);
  r = r.it("maps", check_maps);
  r = r.it("numeric widths", check_numeric_widths);
  r = r.it("string ordering", check_string_ordering);
  return r.finish();
}

function check_string_ordering(): test.TestOutcome {
  let r = run_source("let n = 0; if (\"apple\" < \"pear\") { n = n + 1; } if (\"b\" <= \"b\") { n = n + 2; } if (\"ab\" > \"a\") { n = n + 4; } if (\"a\" >= \"b\") { n = n + 8; } return n;");
  match (r) {
    interp.VInt(i) => {
      if (i.v != 7) {
        return test.fail("i.v != 7");
      }
    },
    _ => {
      return test.fail("unexpected variant of r");
    }
  }
  return test.pass();
}

function check_arithmetic_and_idents(): test.TestOutcome {
  let r1 = run_source("let x = 1 + 2 * 3; let y = (1 + 2) * 3; return x + y;");
  match (r1) {
    interp.VInt(i) => {
      if (i.v != 16) {
        return test.fail("i.v != 16");
      }
    },
    _ => {
      return test.fail("unexpected variant of r1");
    }
  }

  let r2: interp.Value = run_source("let a = \"hi \" + \"there\"; return 0 - 1;");
  match (r2) {
    interp.VInt(i) => {
      if (i.v != -1) {
        return test.fail("i.v != -1");
      }
    },
    _ => {
      return test.fail("unexpected variant of r2");
    }
  }

  let r3 = run_source("let b = 5 < 10; let c = b && (1 == 1); return 42;");
  match (r3) {
    interp.VInt(i) => {
      if (i.v != 42) {
        return test.fail("i.v != 42");
      }
    },
    _ => {
      return test.fail("unexpected variant of r3");
    }
  }

  let r4: interp.Value = run_source("let n = 0 - 5; return n;");
  match (r4) {
    interp.VInt(i) => {
      if (i.v != -5) {
        return test.fail("i.v != -5");
      }
    },
    _ => {
      return test.fail("unexpected variant of r4");
    }
  }

  let r5 = run_source("return 20 / 4;");
  match (r5) {
    interp.VInt(i) => {
      if (i.v != 5) {
        return test.fail("i.v != 5");
      }
    },
    _ => {
      return test.fail("unexpected variant of r5");
    }
  }

  let r6 = run_source("return 1 / 0;");
  match (r6) {
    interp.VInt(i) => {
      if (i.v != 0) {
        return test.fail("i.v != 0");
      }
    },
    _ => {
      return test.fail("unexpected variant of r6");
    }
  }
  let r6b = run_source("return 7 % 0;");
  match (r6b) {
    interp.VInt(i) => {
      if (i.v != 7) {
        return test.fail("i.v != 7");
      }
    },
    _ => {
      return test.fail("unexpected variant of r6b");
    }
  }

  let r7 = run_source("return missing;");
  match (r7) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r7");
    }
  }

  return test.pass();
}

function check_conditionals_and_assignment(): test.TestOutcome {
  let r8 = run_source("let x = 5; if (x < 10) { return 1; } else { return 2; }");
  match (r8) {
    interp.VInt(i) => {
      if (i.v != 1) {
        return test.fail("i.v != 1");
      }
    },
    _ => {
      return test.fail("unexpected variant of r8");
    }
  }

  let r9 = run_source("let x = 20; if (x < 10) { return 1; } else { return 2; }");
  match (r9) {
    interp.VInt(i) => {
      if (i.v != 2) {
        return test.fail("i.v != 2");
      }
    },
    _ => {
      return test.fail("unexpected variant of r9");
    }
  }

  let r10 = run_source("if (false) { return 7; } return 11;");
  match (r10) {
    interp.VInt(i) => {
      if (i.v != 11) {
        return test.fail("i.v != 11");
      }
    },
    _ => {
      return test.fail("unexpected variant of r10");
    }
  }

  let r11 = run_source("let k = 2; if (k == 1) { return 10; } else if (k == 2) { return 20; } else { return 30; }");
  match (r11) {
    interp.VInt(i) => {
      if (i.v != 20) {
        return test.fail("i.v != 20");
      }
    },
    _ => {
      return test.fail("unexpected variant of r11");
    }
  }

  let r12 = run_source("let n = 1; n = 7; return n;");
  match (r12) {
    interp.VInt(i) => {
      if (i.v != 7) {
        return test.fail("i.v != 7");
      }
    },
    _ => {
      return test.fail("unexpected variant of r12");
    }
  }

  return test.pass();
}

function check_while_loops(): test.TestOutcome {
  let r13: interp.Value = run_source(
    "let i = 1; let s = 0; while (i <= 5) { s = s + i; i = i + 1; } return s;",
  );
  match (r13) {
    interp.VInt(i) => {
      if (i.v != 15) {
        return test.fail("i.v != 15");
      }
    },
    _ => {
      return test.fail("unexpected variant of r13");
    }
  }

  let r14: interp.Value = run_source(
    "let i = 0; while (i < 10) { if (i == 3) { return i; } i = i + 1; } return 0 - 1;",
  );
  match (r14) {
    interp.VInt(i) => {
      if (i.v != 3) {
        return test.fail("i.v != 3");
      }
    },
    _ => {
      return test.fail("unexpected variant of r14");
    }
  }

  let r15 = run_source("let x = 5; while (false) { x = 99; } return x;");
  match (r15) {
    interp.VInt(i) => {
      if (i.v != 5) {
        return test.fail("i.v != 5");
      }
    },
    _ => {
      return test.fail("unexpected variant of r15");
    }
  }

  return test.pass();
}

function check_functions_and_recursion(): test.TestOutcome {
  let r16: interp.Value = run_module(
    "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }",
  );
  match (r16) {
    interp.VInt(i) => {
      if (i.v != 5) {
        return test.fail("i.v != 5");
      }
    },
    _ => {
      return test.fail("unexpected variant of r16");
    }
  }

  let r17: interp.Value = run_module(
    "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } function main(): i32 { return fact(5); }",
  );
  match (r17) {
    interp.VInt(i) => {
      if (i.v != 120) {
        return test.fail("i.v != 120");
      }
    },
    _ => {
      return test.fail("unexpected variant of r17");
    }
  }

  let r18: interp.Value = run_module(
    "function is_even(n: i32): i32 { if (n == 0) { return 1; } return is_odd(n - 1); }"
      + " function is_odd(n: i32): i32 { if (n == 0) { return 0; } return is_even(n - 1); }"
      + " function main(): i32 { return is_even(4); }",
  );
  match (r18) {
    interp.VInt(i) => {
      if (i.v != 1) {
        return test.fail("i.v != 1");
      }
    },
    _ => {
      return test.fail("unexpected variant of r18");
    }
  }

  let r19: interp.Value = run_module(
    "function main(): i32 { return missing(1); }",
  );
  match (r19) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r19");
    }
  }

  let r20: interp.Value = run_module(
    "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1); }",
  );
  match (r20) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r20");
    }
  }

  return test.pass();
}

function check_arrays(): test.TestOutcome {
  let r21: interp.Value = run_source(
    "let a = [10, 20, 30]; return a[2];",
  );
  match (r21) {
    interp.VInt(i) => {
      if (i.v != 30) {
        return test.fail("i.v != 30");
      }
    },
    _ => {
      return test.fail("unexpected variant of r21");
    }
  }

  let r22 = run_source("let a = [1, 2, 3, 4]; return a.len();");
  match (r22) {
    interp.VInt(i) => {
      if (i.v != 4) {
        return test.fail("i.v != 4");
      }
    },
    _ => {
      return test.fail("unexpected variant of r22");
    }
  }

  let r23: interp.Value = run_source(
    "let a = [3, 5, 7, 9]; let i = 0; let s = 0; while (i < a.len()) { s = s + a[i]; i = i + 1; } return s;",
  );
  match (r23) {
    interp.VInt(i) => {
      if (i.v != 24) {
        return test.fail("i.v != 24");
      }
    },
    _ => {
      return test.fail("unexpected variant of r23");
    }
  }

  let r24 = run_source("let a = [1, 2]; return a[5];");
  match (r24) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r24");
    }
  }

  let r25 = run_source("let a = []; return a.len();");
  match (r25) {
    interp.VInt(i) => {
      if (i.v != 0) {
        return test.fail("i.v != 0");
      }
    },
    _ => {
      return test.fail("unexpected variant of r25");
    }
  }

  return test.pass();
}

