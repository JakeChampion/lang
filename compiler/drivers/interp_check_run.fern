function check_break_and_continue(): test.TestOutcome {
  let src66 = "function main(): i32 { let i: i32 = 0; let s: i32 = 0; while (i < 10) { if (i == 3) { break; } s = s + i; i = i + 1; } return s; }";
  let r66 = run_module(src66);
  match (r66) {
    interp.VInt(i) => {
      if (i.v != 3) {
        return test.fail("i.v != 3");
      }
    },
    _ => {
      return test.fail("unexpected variant of r66");
    }
  }

  let src67 = "function main(): i32 { let i: i32 = 0; let s: i32 = 0; while (i < 5) { if (i % 2 == 1) { i = i + 1; continue; } s = s + i; i = i + 1; } return s; }";
  let r67 = run_module(src67);
  match (r67) {
    interp.VInt(i) => {
      if (i.v != 6) {
        return test.fail("i.v != 6");
      }
    },
    _ => {
      return test.fail("unexpected variant of r67");
    }
  }

  let src68 = "function main(): i32 { let s: i32 = 0; for n in [1, 2, 10, 20] { if (n > 5) { break; } s = s + n; } return s; }";
  let r68 = run_module(src68);
  match (r68) {
    interp.VInt(i) => {
      if (i.v != 3) {
        return test.fail("i.v != 3");
      }
    },
    _ => {
      return test.fail("unexpected variant of r68");
    }
  }

  let src69 = "function main(): i32 { let s: i32 = 0; for n in [1, 2, 3, 4, 5] { if (n == 3) { continue; } s = s + n; } return s; }";
  let r69 = run_module(src69);
  match (r69) {
    interp.VInt(i) => {
      if (i.v != 12) {
        return test.fail("i.v != 12");
      }
    },
    _ => {
      return test.fail("unexpected variant of r69");
    }
  }

  return test.pass();
}

