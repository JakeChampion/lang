}

function check_match_statements(): test.TestOutcome {
  let src39: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 5 }; match (c) { Circle(x) => { return x.r; }, _ => { return -1; } } return -2; }";
  let r39 = run_module(src39);
  match (r39) {
    interp.VInt(i) => {
      if (i.v != 5) {
        return test.fail("i.v != 5");
      }
    },
    _ => {
      return test.fail("unexpected variant of r39");
    }
  }

  let src40: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { let q = Square { s: 7 }; match (q) { Circle(_) => { return 1; }, Square(sq) => { return sq.s; }, _ => { return -1; } } return -2; }";
  let r40 = run_module(src40);
  match (r40) {
    interp.VInt(i) => {
      if (i.v != 7) {
        return test.fail("i.v != 7");
      }
    },
    _ => {
      return test.fail("unexpected variant of r40");
    }
  }

  let src41: string = "struct Circle { r: i32 } struct Square { s: i32 } struct Triangle { b: i32 } function main(): i32 { let t = Triangle { b: 3 }; match (t) { Circle(_) => { return 1; }, Square(_) => { return 2; }, _ => { return 99; } } return -1; }";
  let r41 = run_module(src41);
  match (r41) {
    interp.VInt(i) => {
      if (i.v != 99) {
        return test.fail("i.v != 99");
      }
    },
    _ => {
      return test.fail("unexpected variant of r41");
    }
  }

  let src42: string = "struct Empty { } function main(): i32 { let e = Empty { }; match (e) { Empty => { return 42; }, _ => { return -1; } } return -2; }";
  let r42 = run_module(src42);
  match (r42) {
    interp.VInt(i) => {
      if (i.v != 42) {
        return test.fail("i.v != 42");
      }
    },
    _ => {
      return test.fail("unexpected variant of r42");
    }
  }

  let src43: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Square(_) => { return 2; } } return -1; }";
  let r43 = run_module(src43);
  match (r43) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r43");
    }
  }

  let src44: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 8 }; let n: i32 = 0; match (c) { Circle(x) => { n = x.r; }, _ => { n = -1; } } return n; }";
  let r44 = run_module(src44);
  match (r44) {
    interp.VInt(i) => {
      if (i.v != 8) {
        return test.fail("i.v != 8");
      }
    },
    _ => {
      return test.fail("unexpected variant of r44");
    }
  }

  let src45: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Circle(x) => { }, _ => { } } let x: i32 = 77; return x; }";
  let r45 = run_module(src45);
  match (r45) {
    interp.VInt(i) => {
      if (i.v != 77) {
        return test.fail("i.v != 77");
      }
    },
    _ => {
      return test.fail("unexpected variant of r45");
    }
  }

  return test.pass();
}

function check_receiver_methods(): test.TestOutcome {
  let src46: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function main(): i32 { let k = Circle { r: 5 }; return k.area(); }";
  let r46 = run_module(src46);
  match (r46) {
    interp.VInt(i) => {
      if (i.v != 25) {
        return test.fail("i.v != 25");
      }
    },
    _ => {
      return test.fail("unexpected variant of r46");
    }
  }

  let src47: string = "struct Box { v: i32 } function (b: Box) scale(n: i32): i32 { return b.v * n; } function main(): i32 { let x = Box { v: 4 }; return x.scale(3); }";
  let r47 = run_module(src47);
  match (r47) {
    interp.VInt(i) => {
      if (i.v != 12) {
        return test.fail("i.v != 12");
      }
    },
    _ => {
      return test.fail("unexpected variant of r47");
    }
  }

  let src48: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function area(): i32 { return 100; } function main(): i32 { let k = Circle { r: 5 }; let m: i32 = area(); let n: i32 = k.area(); return m + n; }";
  let r48 = run_module(src48);
  match (r48) {
    interp.VInt(i) => {
      if (i.v != 125) {
        return test.fail("i.v != 125");
      }
    },
    _ => {
      return test.fail("unexpected variant of r48");
    }
  }

  let src49: string = "struct Circle { r: i32 } struct Square { s: i32 } function (c: Circle) area(): i32 { return c.r; } function main(): i32 { let sq = Square { s: 7 }; return sq.area(); }";
  let r49 = run_module(src49);
  match (r49) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r49");
    }
  }

  return test.pass();
}

function check_floats(): test.TestOutcome {
  let r50 = run_source("return 3.14;");
  match (r50) {
    interp.VFloat(f) => {
      if (f.v < 3.13 || f.v > 3.15) {
        return test.fail("f.v < 3.13 || f.v > 3.15");
      }
    },
    _ => {
      return test.fail("unexpected variant of r50");
    }
  }

  let r51 = run_source("return 1.5 + 2.5;");
  match (r51) {
    interp.VFloat(f) => {
      if (f.v < 3.99 || f.v > 4.01) {
        return test.fail("f.v < 3.99 || f.v > 4.01");
      }
    },
    _ => {
      return test.fail("unexpected variant of r51");
    }
  }

  let r52 = run_source("return 2.5 * 4.0;");
  match (r52) {
    interp.VFloat(f) => {
      if (f.v < 9.99 || f.v > 10.01) {
        return test.fail("f.v < 9.99 || f.v > 10.01");
      }
    },
    _ => {
      return test.fail("unexpected variant of r52");
    }
  }

  let r53 = run_source("return 3.14 > 3.0;");
  match (r53) {
    interp.VBool(b) => {
      if (!b.v) {
        return test.fail("!b.v");
      }
    },
    _ => {
      return test.fail("unexpected variant of r53");
    }
  }

  let r54 = run_source("return 1.5 == 1.5;");
  match (r54) {
    interp.VBool(b) => {
      if (!b.v) {
        return test.fail("!b.v");
      }
    },
    _ => {
      return test.fail("unexpected variant of r54");
    }
  }

  let r55 = run_source("return 1 + 2.5;");
  match (r55) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r55");
    }
  }

  let r55b = run_source("return 2.5 + 1;");
  match (r55b) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r55b");
    }
  }

  let r55c = run_source("let f: f64 = 1.5; return f + 1 / 2;");
  match (r55c) {
    interp.VFloat(f) => {
      if (f.v < 1.99 || f.v > 2.01) {
        return test.fail("f.v < 1.99 || f.v > 2.01");
      }
    },
    _ => {
      return test.fail("unexpected variant of r55c");
    }
  }

  let r56 = run_source("return 10.0 / 4.0;");
  match (r56) {
    interp.VFloat(f) => {
      if (f.v < 2.49 || f.v > 2.51) {
        return test.fail("f.v < 2.49 || f.v > 2.51");
      }
    },
    _ => {
      return test.fail("unexpected variant of r56");
    }
  }

  let r57 = run_source("return 0.0 - 3.5;");
  match (r57) {
    interp.VFloat(f) => {
      if (f.v > 0.0 - 3.49 || f.v < 0.0 - 3.51) {
        return test.fail("f.v > 0.0 - 3.49 || f.v < 0.0 - 3.51");
      }
    },
    _ => {
      return test.fail("unexpected variant of r57");
    }
  }

  return test.pass();
}

function check_for_in_loops(): test.TestOutcome {
  let src58 = "function main(): i32 { let arr = [1, 2, 3]; let s: i32 = 0; for n in arr { s = s + n; } return s; }";
  let r58 = run_module(src58);
  match (r58) {
    interp.VInt(i) => {
      if (i.v != 6) {
        return test.fail("i.v != 6");
      }
    },
    _ => {
      return test.fail("unexpected variant of r58");
    }
  }

  let src59: string = "function main(): i32 { for n in [10, 20, 30] { return n; } return 0 - 1; }";
  let r59 = run_module(src59);
  match (r59) {
    interp.VInt(i) => {
      if (i.v != 10) {
        return test.fail("i.v != 10");
      }
    },
    _ => {
      return test.fail("unexpected variant of r59");
    }
  }

  let src60 = "function main(): i32 { for n in 7 { } return 0; }";
  let r60 = run_module(src60);
  match (r60) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r60");
    }
  }
  return check_for_in_subjects();
}

function check_for_in_subjects(): test.TestOutcome {
  let srcs: string[] = [
    "function main(): i32 { let n: i32 = 0; for b in \"ab\" { n = n + (b as i32); } return n; }",
    "function main(): i32 { let m = map_new(); m = m.insert(\"a\", 1); m = m.insert(\"bc\", 2); let n: i32 = 0; for (k, v) in m { n = n + k.len() * 10 + v; } return n; }",
    "function main(): i32 { let n: i32 = 0; for (a, b) in [(1, 2), (3, 4)] { n = n + a * b; } return n; }",
    "struct Cd { n: i32 }\nfunction (c: Cd) next(): Option[(i32, Cd)] { if (c.n == 0) { return None; } return Some((c.n, Cd { n: c.n - 1 })); }\nfunction main(): i32 { let n: i32 = 0; let c: Cd = Cd { n: 4 }; for v in c { if (v == 2) { continue; } n = n + v; } return n; }",
    "struct Cd { n: i32 }\nstruct Box { n: i32 }\nfunction (c: Cd) next(): Option[(i32, Cd)] { if (c.n == 0) { return None; } return Some((c.n, Cd { n: c.n - 1 })); }\nfunction (b: Box) iter(): Cd { return Cd { n: b.n }; }\nfunction main(): i32 { let n: i32 = 0; let b: Box = Box { n: 3 }; for v in b { n = n + v; } return n; }",
  ];
  let wants: i32[] = [195, 33, 14, 8, 6];
  for i in 0..srcs.len() {
    let r = run_module(srcs[i]);
    let interp.VInt(got) = r else {
      return test.fail(f"source {i} does not give an integer");
    };
    if (got.v != wants[i]) {
      return test.assert_eq(got.v, wants[i]);
    }
  }
  return test.pass();
}

