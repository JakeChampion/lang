function check_match_statements(): i32 {
  let src39: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 5 }; match (c) { Circle(x) => { return x.r; }, _ => { return -1; } } return -2; }";
  let r39 = run_module(src39);
  match (r39) {
    interp.VInt(i) => {
      if (i.v != 5) {
        return 390;
      }
    },
    _ => {
      return 391;
    }
  }

  let src40: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { let q = Square { s: 7 }; match (q) { Circle(_) => { return 1; }, Square(sq) => { return sq.s; }, _ => { return -1; } } return -2; }";
  let r40 = run_module(src40);
  match (r40) {
    interp.VInt(i) => {
      if (i.v != 7) {
        return 400;
      }
    },
    _ => {
      return 401;
    }
  }

  let src41: string = "struct Circle { r: i32 } struct Square { s: i32 } struct Triangle { b: i32 } function main(): i32 { let t = Triangle { b: 3 }; match (t) { Circle(_) => { return 1; }, Square(_) => { return 2; }, _ => { return 99; } } return -1; }";
  let r41 = run_module(src41);
  match (r41) {
    interp.VInt(i) => {
      if (i.v != 99) {
        return 410;
      }
    },
    _ => {
      return 411;
    }
  }

  let src42: string = "struct Empty { } function main(): i32 { let e = Empty { }; match (e) { Empty => { return 42; }, _ => { return -1; } } return -2; }";
  let r42 = run_module(src42);
  match (r42) {
    interp.VInt(i) => {
      if (i.v != 42) {
        return 420;
      }
    },
    _ => {
      return 421;
    }
  }

  let src43: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Square(_) => { return 2; } } return -1; }";
  let r43 = run_module(src43);
  match (r43) {
    interp.VErr(_) => {},
    _ => {
      return 430;
    }
  }

  let src44: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 8 }; let n: i32 = 0; match (c) { Circle(x) => { n = x.r; }, _ => { n = -1; } } return n; }";
  let r44 = run_module(src44);
  match (r44) {
    interp.VInt(i) => {
      if (i.v != 8) {
        return 440;
      }
    },
    _ => {
      return 441;
    }
  }

  let src45: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Circle(x) => { }, _ => { } } let x: i32 = 77; return x; }";
  let r45 = run_module(src45);
  match (r45) {
    interp.VInt(i) => {
      if (i.v != 77) {
        return 450;
      }
    },
    _ => {
      return 451;
    }
  }

  return 0;
}

