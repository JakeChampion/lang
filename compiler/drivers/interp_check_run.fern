  );
  match (r13) {
    interp.VInt(i) => {
      if (i.v != 15) {
        return 130;
      }
    },
    _ => {
      return 131;
    }
  }

  let r14: interp.Value = run_source(
    "let i = 0; while (i < 10) { if (i == 3) { return i; } i = i + 1; } return 0 - 1;",
  );
  match (r14) {
    interp.VInt(i) => {
      if (i.v != 3) {
        return 140;
      }
    },
    _ => {
      return 141;
