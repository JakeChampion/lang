function check_slicing(): test.TestOutcome {
  let r29 = run_source("let s = \"hello\"; return s[1:4];");
  match (r29) {
    interp.VStruct(sv29) => {
      if (sv29.type_name != "Some") {
        return test.fail("sv29.type_name != \"Some\"");
      }
      match (sv29.field_values[0]) {
        interp.VString(s29) => {
          if (s29.v != "ell") {
            return test.fail("s29.v != \"ell\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of sv29.field_values[0]");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of r29");
    }
  }

  let r30 = run_source("let s = \"hello\"; return slice_unchecked(s, 1, 4)[1];");
  match (r30) {
    interp.VInt(i) => {
      if (i.v != 108) {
        return test.fail("i.v != 108");
      }
    },
    _ => {
      return test.fail("unexpected variant of r30");
    }
  }

  let r31 = run_source("let a = [10, 20, 30, 40, 50]; let b = a[1:4]; return b[0];");
  match (r31) {
    interp.VInt(i) => {
      if (i.v != 20) {
        return test.fail("i.v != 20");
      }
    },
    _ => {
      return test.fail("unexpected variant of r31");
    }
  }

  let r32 = run_source("let s = \"hi\"; return s[0:99];");
  match (r32) {
    interp.VStruct(sv32) => {
      if (sv32.type_name != "None") {
        return test.fail("sv32.type_name != \"None\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of r32");
    }
  }

  let r32b = run_source("let s = \"héllo\"; return s[0:2];");
  match (r32b) {
    interp.VStruct(sv32b) => {
      if (sv32b.type_name != "None") {
        return test.fail("sv32b.type_name != \"None\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of r32b");
    }
  }

  let r32u = run_source("let s = \"hi\"; return slice_unchecked(s, 0, 99).len();");
  match (r32u) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r32u");
    }
  }

  return test.pass();
}

