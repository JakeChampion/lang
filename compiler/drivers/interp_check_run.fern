  let r33: interp.Value = run_source(
    "let i = 1; let s = 0; while (i <= 10) { s += i; i += 1; } return s;",
  );
  match (r33) {
    interp.VInt(i) => {
      if (i.v != 55) {
        return test.fail("i.v != 55");
      }
    },
    _ => {
      return test.fail("unexpected variant of r33");
    }
  }

  let r34 = run_source("let x = 1; x *= 2; x *= 3; return x;");
  match (r34) {
    interp.VInt(i) => {
      if (i.v != 6) {
        return test.fail("i.v != 6");
      }
    },
    _ => {
      return test.fail("unexpected variant of r34");
    }
  }

  return test.pass();
}

