  let r15 = run_source("let x = 5; while (false) { x = 99; } return x;");
  match (r15) {
    interp.VInt(i) => {
      if (i.v != 5) {
        return 150;
      }
    },
    _ => {
      return 151;
    }
  }

  return 0;
}

function check_functions_and_recursion(): i32 {
  let r16: interp.Value = run_module(
    "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }",
  );
  match (r16) {
    interp.VInt(i) => {
      if (i.v != 5) {
        return 160;
      }
    },
    _ => {
      return 161;
    }
  }

  let r17: interp.Value = run_module(
    "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } function main(): i32 { return fact(5); }",
  );
  match (r17) {
    interp.VInt(i) => {
      if (i.v != 120) {
        return 170;
      }
    },
    _ => {
      return 171;
    }
  }

  let r18: interp.Value = run_module(
    "function is_even(n: i32): i32 { if (n == 0) { return 1; } return is_odd(n - 1); }"
      + " function is_odd(n: i32): i32 { if (n == 0) { return 0; } return is_even(n - 1); }"
      + " function main(): i32 { return is_even(4); }",
  );
  match (r18) {
    interp.VInt(i) => {
      if (i.v != 1) {
        return 180;
      }
    },
    _ => {
      return 181;
    }
  }

  let r19: interp.Value = run_module(
    "function main(): i32 { return missing(1); }",
  );
  match (r19) {
    interp.VErr(_) => {},
    _ => {
      return 190;
    }
  }

  let r20: interp.Value = run_module(
    "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1); }",
  );
  match (r20) {
    interp.VErr(_) => {},
    _ => {
      return 200;
    }
  }

  return 0;
}

