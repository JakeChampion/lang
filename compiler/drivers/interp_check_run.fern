  let src91 = "function main(): i32 { let a: f32 = 16777216.0 as f32; let b = a + (1.0 as f32); if ((b as f64) > 16777215.5 && (b as f64) < 16777216.5) { return 1; } return 0; }";
  let r91 = run_module(src91);
