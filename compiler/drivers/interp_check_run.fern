function check_maps(): test.TestOutcome {
  let src84: string = "function main(): i32 { let m = map_new(); m = m.insert(\"a\", 1); m = m.insert(\"b\", 2); let got: i32 = m.get_or(\"a\", 0 - 1); return got; }";
  let r84 = run_module(src84);
  match (r84) {
    interp.VInt(i) => {
      if (i.v != 1) {
        return test.fail("i.v != 1");
      }
    },
    _ => {
      return test.fail("unexpected variant of r84");
    }
  }

  let src85 = "function main(): i32 { let m = map_new(); m = m.insert(\"a\", 1); return m.get_or(\"missing\", 99); }";
  let r85 = run_module(src85);
  match (r85) {
    interp.VInt(i) => {
      if (i.v != 99) {
        return test.fail("i.v != 99");
      }
    },
    _ => {
      return test.fail("unexpected variant of r85");
    }
  }

  let src86 = "function main(): i32 { let m = map_new(); m = m.insert(\"a\", 1); m = m.insert(\"b\", 2); m = m.insert(\"c\", 3); return m.len(); }";
  let r86 = run_module(src86);
  match (r86) {
    interp.VInt(i) => {
      if (i.v != 3) {
        return test.fail("i.v != 3");
      }
    },
    _ => {
      return test.fail("unexpected variant of r86");
    }
  }

  let src87 = "function main(): i32 { let m = map_new(); m = m.insert(\"k\", 1); m = m.insert(\"k\", 99); return m.get_or(\"k\", 0); }";
  let r87 = run_module(src87);
  match (r87) {
    interp.VInt(i) => {
      if (i.v != 99) {
        return test.fail("i.v != 99");
      }
    },
    _ => {
      return test.fail("unexpected variant of r87");
    }
  }

  let mainSrc88 = "function main(): i32 { return parser.parse_module(); }";
  let modSrc88 = "pub function parse_module(): i32 { return 42; }";
  let mainMod88 = parser.parse_module(lexer.tokenize(mainSrc88));
  let pMod88 = parser.parse_module(lexer.tokenize(modSrc88));
  let merged88 = parser.merge_module_prefixed(mainMod88, pMod88, "parser");
  let r88 = interp.eval_module(merged88);
  match (r88) {
    interp.VInt(i) => {
      if (i.v != 42) {
        return test.fail("i.v != 42");
      }
    },
    _ => {
      return test.fail("unexpected variant of r88");
    }
  }

  return test.pass();
}

