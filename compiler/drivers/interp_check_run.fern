  let r26 = run_source("let s = \"hello\"; return s[0];");
  match (r26) {
    interp.VInt(i) => {
      if (i.v != 104) {
        return test.fail("i.v != 104");
      }
    },
    _ => {
      return test.fail("unexpected variant of r26");
    }
  }

  let r27 = run_source("let s = \"ABC\"; return s[0] + s[1] + s[2];");
  match (r27) {
    interp.VInt(i) => {
      if (i.v != 198) {
        return test.fail("i.v != 198");
      }
    },
    _ => {
      return test.fail("unexpected variant of r27");
    }
  }

  let r28 = run_source("let s = \"hi\"; return s[5];");
  match (r28) {
    interp.VErr(_) => {},
    _ => {
      return test.fail("unexpected variant of r28");
