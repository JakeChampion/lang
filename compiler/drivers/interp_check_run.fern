// The interpreter's self-checks. Each check returns 0, or the number of
// the assertion that failed.

import "../aborts";
import "../aesref";
import "../ast";
import "../astwalk";
import "../builtinsigs";
import "../checker";
import "../interp";
import "../interpheap";
import "../lexer";
import "../lexical";
import "../parser";
import "../platforms";
import "../typeinfo";
import "../util";
import "std/f64";
import "std/rand";
import "std/string";
import "std/utf8";

function eval_program(prog: ast.Stmt[]): interp.Value {
  let heap = interpheap.create();
  let env = interp.new_env(heap);
  let preassigned = interp.body_assign_names(prog, []);
  for i in 0..prog.len() {
    env = interp.cellify_captures(env, prog[i], preassigned);
    let r = interp.eval_stmt(prog[i], env);
    env = r.env;
    if (r.sig != 0) {
      return r.ret;
    }
  }
  return interp.v_err("program reached end without `return`");
}

function run_source(src: string): interp.Value {
  let toks = lexer.tokenize(src);
  let stmts = parser.parse_program(toks);
  return eval_program(stmts);
}

function run_module(src: string): interp.Value {
  let toks = lexer.tokenize(src);
  let mod = parser.parse_module(toks);
  return interp.eval_module(mod);
}

function main(): i32 {
  let rc = check_arithmetic_and_idents();
  if (rc != 0) {
    return rc;
  }
  rc = check_conditionals_and_assignment();
  if (rc != 0) {
    return rc;
  }
  rc = check_while_loops();
  if (rc != 0) {
    return rc;
  }
  rc = check_functions_and_recursion();
  if (rc != 0) {
    return rc;
  }
  rc = check_arrays();
  if (rc != 0) {
    return rc;
  }
  rc = check_string_indexing();
  if (rc != 0) {
    return rc;
  }
  rc = check_slicing();
  if (rc != 0) {
    return rc;
  }
  rc = check_compound_assignment();
  if (rc != 0) {
    return rc;
  }
  rc = check_structs_and_fields();
  if (rc != 0) {
    return rc;
  }
  rc = check_match_statements();
  if (rc != 0) {
    return rc;
  }
  rc = check_receiver_methods();
  if (rc != 0) {
    return rc;
  }
  rc = check_floats();
  if (rc != 0) {
    return rc;
  }
  rc = check_for_in_loops();
  if (rc != 0) {
    return rc;
  }
  rc = check_tuples();
  if (rc != 0) {
    return rc;
  }
  rc = check_break_and_continue();
  if (rc != 0) {
    return rc;
  }
  rc = check_primitive_receivers();
  if (rc != 0) {
    return rc;
  }
  rc = check_structural_equality();
  if (rc != 0) {
    return rc;
  }
  rc = check_union_receiver_method();
  if (rc != 0) {
    return rc;
  }
  rc = check_lambdas_and_closures();
  if (rc != 0) {
    return rc;
  }
  rc = check_maps();
  if (rc != 0) {
    return rc;
  }
  rc = check_numeric_widths();
  if (rc != 0) {
    return rc;
  }
  return check_string_ordering();
}

function check_string_ordering(): i32 {
  let r = run_source("let n = 0; if (\"apple\" < \"pear\") { n = n + 1; } if (\"b\" <= \"b\") { n = n + 2; } if (\"ab\" > \"a\") { n = n + 4; } if (\"a\" >= \"b\") { n = n + 8; } return n;");
  match (r) {
    interp.VInt(i) => {
      if (i.v != 7) {
        return 940;
      }
    },
    _ => {
      return 941;
    }
  }
  return 0;
}

function check_arithmetic_and_idents(): i32 {
  let r1 = run_source("let x = 1 + 2 * 3; let y = (1 + 2) * 3; return x + y;");
  match (r1) {
    interp.VInt(i) => {
      if (i.v != 16) {
        return 10;
      }
    },
    _ => {
      return 11;
    }
  }

  let r2: interp.Value = run_source("let a = \"hi \" + \"there\"; return 0 - 1;");
  match (r2) {
    interp.VInt(i) => {
      if (i.v != -1) {
        return 20;
      }
    },
    _ => {
      return 21;
    }
  }

  let r3 = run_source("let b = 5 < 10; let c = b && (1 == 1); return 42;");
  match (r3) {
    interp.VInt(i) => {
      if (i.v != 42) {
        return 30;
      }
    },
    _ => {
      return 31;
    }
  }

  let r4: interp.Value = run_source("let n = 0 - 5; return n;");
  match (r4) {
    interp.VInt(i) => {
      if (i.v != -5) {
        return 40;
      }
    },
    _ => {
      return 41;
    }
  }

  let r5 = run_source("return 20 / 4;");
  match (r5) {
    interp.VInt(i) => {
      if (i.v != 5) {
        return 50;
      }
    },
    _ => {
      return 51;
    }
  }

  let r6 = run_source("return 1 / 0;");
  match (r6) {
    interp.VInt(i) => {
      if (i.v != 0) {
        return 60;
      }
    },
    _ => {
      return 61;
    }
  }
  let r6b = run_source("return 7 % 0;");
  match (r6b) {
    interp.VInt(i) => {
      if (i.v != 7) {
        return 62;
      }
    },
    _ => {
      return 63;
    }
  }

  let r7 = run_source("return missing;");
  match (r7) {
    interp.VErr(_) => {},
    _ => {
      return 70;
    }
  }

  return 0;
}

