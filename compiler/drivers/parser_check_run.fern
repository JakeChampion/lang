  let srcRV = "struct K { v: i32 } struct Box[T] { x: T } function (b: Box[K]) key(): K { return b.x; } function (b: Box[U]) val(): U { return b.x; }";
  let modRV = parser.parse_module(lexer.tokenize(srcRV));
