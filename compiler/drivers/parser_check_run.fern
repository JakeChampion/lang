// The parser's self-checks. Each check is a std/test case. A failed case
// names the condition that did not hold.

import "../ast";
import "../astwalk";
import "../builtinsigs";
import "../lexer";
import "../parser";
import "../typeinfo";
import "../util";
import "std/envflag";
import "std/string";
import "std/test";

function main(): i32 {
  let r = test.new("parser");
  r = r.it("operator precedence", check_operator_precedence);
  r = r.it("if and while", check_if_and_while);
  r = r.it("compound assignment", check_compound_assignment);
  r = r.it("slice expressions", check_slice_expressions);
  r = r.it("module functions", check_module_functions);
  r = r.it("struct declarations", check_struct_declarations);
  r = r.it("struct literals", check_struct_literals);
  r = r.it("type aliases", check_type_aliases);
  r = r.it("match statements", check_match_statements);
  r = r.it("var annotations", check_var_annotations);
  r = r.it("receiver methods", check_receiver_methods);
  r = r.it("imports", check_imports);
  r = r.it("for in loops", check_for_in_loops);
  r = r.it("tuples", check_tuples);
  r = r.it("break and continue", check_break_and_continue);
  r = r.it("generics", check_generics);
  r = r.it("lambdas", check_lambdas);
  r = r.it("fstrings", check_fstrings);
  r = r.it("qualified names", check_qualified_names);
  r = r.it("struct patterns", check_struct_patterns);
  return r.finish();
}

function check_operator_precedence(): test.TestOutcome {
  let src = "let x = 1 + 2 * 3; let y = (1 + 2) * 3; return x + y;";
  let toks = lexer.tokenize(src);
  let prog = parser.parse_program(toks);
  if (prog.len() != 3) {
    return test.fail("prog.len() != 3");
  }

  match (prog[0]) {
    ast.StmtVar(s0) => {
      if (s0.name != "x") {
        return test.fail("s0.name != \"x\"");
      }
      match (s0.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return test.fail("b.op != \"+\"");
          }
          match (b.right) {
            ast.ExprBinary(rb) => {
              if (rb.op != "*") {
                return test.fail("rb.op != \"*\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of b.right");
            }
          }
          match (b.left) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return test.fail("n.text != \"1\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of b.left");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of s0.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of prog[0]");
    }
  }

  match (prog[1]) {
    ast.StmtVar(s1) => {
      if (s1.name != "y") {
        return test.fail("s1.name != \"y\"");
      }
      match (s1.init) {
        ast.ExprBinary(b) => {
          if (b.op != "*") {
            return test.fail("b.op != \"*\"");
          }
          match (b.left) {
            ast.ExprBinary(lb) => {
              if (lb.op != "+") {
                return test.fail("lb.op != \"+\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of b.left");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of s1.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of prog[1]");
    }
  }

  match (prog[2]) {
    ast.StmtReturn(s2) => {
      match (s2.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return test.fail("b.op != \"+\"");
          }
          match (b.left) {
            ast.ExprIdent(id) => {
              if (id.name != "x") {
                return test.fail("id.name != \"x\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of b.left");
            }
          }
          match (b.right) {
            ast.ExprIdent(id) => {
              if (id.name != "y") {
                return test.fail("id.name != \"y\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of b.right");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of s2.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of prog[2]");
    }
  }

  return test.pass();
}

function check_if_and_while(): test.TestOutcome {
  let src2 = "if (x < 0) { let a = 1; } else { let b = 2; }";
  let prog2 = parser.parse_program(lexer.tokenize(src2));
  if (prog2.len() != 1) {
    return test.fail("prog2.len() != 1");
  }
  match (prog2[0]) {
    ast.StmtIf(ifs) => {
      match (ifs.cond) {
        ast.ExprBinary(b) => {
          if (b.op != "<") {
            return test.fail("b.op != \"<\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of ifs.cond");
        }
      }
      if (ifs.then_body.len() != 1) {
        return test.fail("ifs.then_body.len() != 1");
      }
      if (ifs.else_body.len() != 1) {
        return test.fail("ifs.else_body.len() != 1");
      }
    },
    _ => {
      return test.fail("unexpected variant of prog2[0]");
    }
  }

  let src3 = "if (true) { return 1; }";
  let prog3 = parser.parse_program(lexer.tokenize(src3));
  match (prog3[0]) {
    ast.StmtIf(ifs) => {
      if (ifs.else_body.len() != 0) {
        return test.fail("ifs.else_body.len() != 0");
      }
    },
    _ => {
      return test.fail("unexpected variant of prog3[0]");
    }
  }

  let src4 = "while (i < 5) { i = i + 1; }";
  let prog4 = parser.parse_program(lexer.tokenize(src4));
  if (prog4.len() != 1) {
    return test.fail("prog4.len() != 1");
  }
  match (prog4[0]) {
    ast.StmtWhile(w) => {
      match (w.cond) {
        ast.ExprBinary(b) => {
          if (b.op != "<") {
            return test.fail("b.op != \"<\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of w.cond");
        }
      }
      if (w.body.len() != 1) {
        return test.fail("w.body.len() != 1");
      }
      match (w.body[0]) {
        ast.StmtAssign(a) => {
          if (a.target != "i") {
            return test.fail("a.target != \"i\"");
          }
          match (a.value) {
            ast.ExprBinary(b) => {
              if (b.op != "+") {
                return test.fail("b.op != \"+\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of a.value");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of w.body[0]");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of prog4[0]");
    }
  }

  return test.pass();
}

function check_compound_assignment(): test.TestOutcome {
  let srcC = "x += 1;";
  let progC = parser.parse_program(lexer.tokenize(srcC));
  if (progC.len() != 1) {
    return test.fail("progC.len() != 1");
  }
  match (progC[0]) {
    ast.StmtAssign(a) => {
      if (a.target != "x") {
        return test.fail("a.target != \"x\"");
      }
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return test.fail("b.op != \"+\"");
          }
          match (b.left) {
            ast.ExprIdent(id) => {
              if (id.name != "x") {
                return test.fail("id.name != \"x\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of b.left");
            }
          }
          match (b.right) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return test.fail("n.text != \"1\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of b.right");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of a.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progC[0]");
    }
  }

  let srcD = "s *= 2;";
  match (parser.parse_program(lexer.tokenize(srcD))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "*") {
            return test.fail("b.op != \"*\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of a.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of parser.parse_program(lexer.tokenize(srcD))[0]");
    }
  }

  let srcBwAnd = "m &= 6;";
  match (parser.parse_program(lexer.tokenize(srcBwAnd))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "&") {
            return test.fail("b.op != \"&\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of a.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of parser.parse_program(lexer.tokenize(srcBwAnd))[0]");
    }
  }
  let srcBwShl = "f <<= 3;";
  match (parser.parse_program(lexer.tokenize(srcBwShl))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "<<") {
            return test.fail("b.op != \"<<\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of a.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of parser.parse_program(lexer.tokenize(srcBwShl))[0]");
    }
  }

  return test.pass();
}

function check_slice_expressions(): test.TestOutcome {
  let srcS = "let t = s[1:4]; return 0;";
  let progS = parser.parse_program(lexer.tokenize(srcS));
  match (progS[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprSlice(sl) => {
          match (sl.start) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return test.fail("n.text != \"1\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of sl.start");
            }
          }
          match (sl.end) {
            ast.ExprNumber(n) => {
              if (n.text != "4") {
                return test.fail("n.text != \"4\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of sl.end");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progS[0]");
    }
  }

  let srcOS = "let t = s[1:]; return 0;";
  let progOS = parser.parse_program(lexer.tokenize(srcOS));
  match (progOS[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprSlice(sl) => {
          if (!sl.open_end) {
            return test.fail("!sl.open_end");
          }
          match (sl.start) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return test.fail("n.text != \"1\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of sl.start");
            }
          }
          match (sl.array) {
            ast.ExprIdent(id) => {
              if (id.name != "s") {
                return test.fail("id.name != \"s\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of sl.array");
            }
          }
          match (sl.end) {
            ast.ExprCall(_) => {
              return test.fail("unexpected variant of sl.end");
            },
            _ => {}
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progOS[0]");
    }
  }

  return test.pass();
}

function check_module_functions(): test.TestOutcome {
  let src5 = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
  let mod = parser.parse_module(lexer.tokenize(src5));
  if (mod.funcs.len() != 2) {
    return test.fail("mod.funcs.len() != 2");
  }
  if (mod.top_stmts.len() != 0) {
    return test.fail("mod.top_stmts.len() != 0");
  }
  if (mod.funcs[0].name != "add") {
    return test.fail("mod.funcs[0].name != \"add\"");
  }
  if (mod.funcs[0].params.len() != 2) {
    return test.fail("mod.funcs[0].params.len() != 2");
  }
  if (mod.funcs[0].params[0].name != "x") {
    return test.fail("mod.funcs[0].params[0].name != \"x\"");
  }
  if (mod.funcs[0].params[0].type_name != "i32") {
    return test.fail("mod.funcs[0].params[0].type_name != \"i32\"");
  }
  if (mod.funcs[0].ret_type != "i32") {
    return test.fail("mod.funcs[0].ret_type != \"i32\"");
  }
  if (mod.funcs[0].body.len() != 1) {
    return test.fail("mod.funcs[0].body.len() != 1");
  }
  if (mod.funcs[1].name != "main") {
    return test.fail("mod.funcs[1].name != \"main\"");
  }
  if (mod.funcs[1].params.len() != 0) {
    return test.fail("mod.funcs[1].params.len() != 0");
  }
  if (mod.funcs[1].ret_type != "i32") {
    return test.fail("mod.funcs[1].ret_type != \"i32\"");
  }

  return test.pass();
}

function check_struct_declarations(): test.TestOutcome {
  let srcSt = "struct Point { x: i32, y: i32 } struct Empty { } function main(): i32 { return 0; }";
  let modSt = parser.parse_module(lexer.tokenize(srcSt));
  if (modSt.structs.len() != 2) {
    return test.fail("modSt.structs.len() != 2");
  }
  if (modSt.structs[0].name != "Point") {
    return test.fail("modSt.structs[0].name != \"Point\"");
  }
  if (modSt.structs[0].fields.len() != 2) {
    return test.fail("modSt.structs[0].fields.len() != 2");
  }
  if (modSt.structs[0].fields[0].name != "x") {
    return test.fail("modSt.structs[0].fields[0].name != \"x\"");
  }
  if (modSt.structs[0].fields[0].type_name != "i32") {
    return test.fail("modSt.structs[0].fields[0].type_name != \"i32\"");
  }
  if (modSt.structs[0].fields[1].name != "y") {
    return test.fail("modSt.structs[0].fields[1].name != \"y\"");
  }
  if (modSt.structs[1].name != "Empty") {
    return test.fail("modSt.structs[1].name != \"Empty\"");
  }
  if (modSt.structs[1].fields.len() != 0) {
    return test.fail("modSt.structs[1].fields.len() != 0");
  }
  if (modSt.funcs.len() != 1) {
    return test.fail("modSt.funcs.len() != 1");
  }
  if (modSt.funcs[0].name != "main") {
    return test.fail("modSt.funcs[0].name != \"main\"");
  }

  let srcTc = "struct Tc { a: i32, b: i32, } function main(): i32 { return 0; }";
  let modTc = parser.parse_module(lexer.tokenize(srcTc));
  if (modTc.structs.len() != 1) {
    return test.fail("modTc.structs.len() != 1");
  }
  if (modTc.structs[0].fields.len() != 2) {
    return test.fail("modTc.structs[0].fields.len() != 2");
  }
  if (modTc.structs[0].fields[1].name != "b") {
    return test.fail("modTc.structs[0].fields[1].name != \"b\"");
  }

  return test.pass();
}

function check_struct_literals(): test.TestOutcome {
  let srcL: string = "let p = Point { x: 3, y: 4 }; return 0;";
  let progL = parser.parse_program(lexer.tokenize(srcL));
  match (progL[0]) {
    ast.StmtVar(v) => {
      if (v.name != "p") {
        return test.fail("v.name != \"p\"");
      }
      match (v.init) {
        ast.ExprStructLit(sl) => {
          if (sl.type_name != "Point") {
            return test.fail("sl.type_name != \"Point\"");
          }
          if (sl.field_names.len() != 2) {
            return test.fail("sl.field_names.len() != 2");
          }
          if (sl.field_names[0] != "x") {
            return test.fail("sl.field_names[0] != \"x\"");
          }
          if (sl.field_names[1] != "y") {
            return test.fail("sl.field_names[1] != \"y\"");
          }
          match (sl.field_values[0]) {
            ast.ExprNumber(n) => {
              if (n.text != "3") {
                return test.fail("n.text != \"3\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of sl.field_values[0]");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progL[0]");
    }
  }

  let srcF = "return p.x;";
  let progF = parser.parse_program(lexer.tokenize(srcF));
  match (progF[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "x") {
            return test.fail("fa.field != \"x\"");
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "p") {
                return test.fail("id.name != \"p\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of fa.obj");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of r.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progF[0]");
    }
  }

  let srcCh = "return Point { x: 1, y: 2 }.x;";
  let progCh = parser.parse_program(lexer.tokenize(srcCh));
  match (progCh[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "x") {
            return test.fail("fa.field != \"x\"");
          }
          match (fa.obj) {
            ast.ExprStructLit(sl) => {
              if (sl.type_name != "Point") {
                return test.fail("sl.type_name != \"Point\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of fa.obj");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of r.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progCh[0]");
    }
  }

  return test.pass();
}

function check_type_aliases(): test.TestOutcome {
  let srcTy = "pub type Shape = Circle | Square | Triangle; pub type Cell = Empty | Wall; struct Circle { r: i32 } function main(): i32 { return 0; }";
  let modTy = parser.parse_module(lexer.tokenize(srcTy));
  if (modTy.aliases.len() != 2) {
    return test.fail("modTy.aliases.len() != 2");
  }
  if (modTy.aliases[0].name != "Shape") {
    return test.fail("modTy.aliases[0].name != \"Shape\"");
  }
  if (modTy.aliases[0].variants.len() != 3) {
    return test.fail("modTy.aliases[0].variants.len() != 3");
  }
  if (modTy.aliases[0].variants[0] != "Circle") {
    return test.fail("modTy.aliases[0].variants[0] != \"Circle\"");
  }
  if (modTy.aliases[0].variants[1] != "Square") {
    return test.fail("modTy.aliases[0].variants[1] != \"Square\"");
  }
  if (modTy.aliases[0].variants[2] != "Triangle") {
    return test.fail("modTy.aliases[0].variants[2] != \"Triangle\"");
  }
  if (modTy.aliases[1].name != "Cell") {
    return test.fail("modTy.aliases[1].name != \"Cell\"");
  }
  if (modTy.aliases[1].variants.len() != 2) {
    return test.fail("modTy.aliases[1].variants.len() != 2");
  }
  if (modTy.aliases[1].variants[0] != "Empty") {
    return test.fail("modTy.aliases[1].variants[0] != \"Empty\"");
  }
  if (modTy.aliases[1].variants[1] != "Wall") {
    return test.fail("modTy.aliases[1].variants[1] != \"Wall\"");
  }
  if (modTy.structs.len() != 1) {
    return test.fail("modTy.structs.len() != 1");
  }
  if (modTy.structs[0].name != "Circle") {
    return test.fail("modTy.structs[0].name != \"Circle\"");
  }
  if (modTy.funcs.len() != 1) {
    return test.fail("modTy.funcs.len() != 1");
  }
  if (modTy.funcs[0].name != "main") {
    return test.fail("modTy.funcs[0].name != \"main\"");
  }
  let srcGen = "struct Leaf[T] { v: T } struct Lit { v: i32 } type Tree[T] = Leaf[T] | Lit; type Slot = Leaf[i32] | Lit; function main(): i32 { return 0; }";
  let modGen = parser.parse_module(lexer.tokenize(srcGen));
  if (modGen.aliases.len() != 0 || modGen.enums.len() != 2) {
    return test.fail("modGen.aliases.len() != 0 || modGen.enums.len() != 2");
  }
  if (modGen.enums[0].name != "Tree" || modGen.enums[0].type_params.len() != 1 || modGen.enums[0].type_params[0] != "0_T") {
    return test.fail("modGen.enums[0].name != \"Tree\" || modGen.enums[0].type_params.len() != 1 || modGen.enums[0].type_params[0] != \"0_T\"");
  }
  if (modGen.enums[0].variant_names.len() != 2 || modGen.enums[0].variant_names[0] != "Leaf" || modGen.enums[0].variant_names[1] != "Lit") {
    return test.fail("modGen.enums[0].variant_names.len() != 2 || modGen.enums[0].variant_names[0] != \"Leaf\" || modGen.enums[0].variant_names[1] != \"Lit\"");
  }
  let leaf_payload = "";
  let lit_payload = "";
  let slot_payload = "";
  for sd in modGen.structs {
    if (sd.enum_owner == "Tree" && sd.name == "Leaf") {
      leaf_payload = sd.fields[0].type_name;
    }
    if (sd.enum_owner == "Tree" && sd.name == "Lit") {
      lit_payload = sd.fields[0].type_name;
    }
    if (sd.enum_owner == "Slot" && sd.name == "Leaf") {
      slot_payload = sd.fields[0].type_name;
    }
  }
  if (leaf_payload != "Leaf[0_T]" || lit_payload != "Lit" || slot_payload != "Leaf[i32]") {
    return test.fail("leaf_payload != \"Leaf[0_T]\" || lit_payload != \"Lit\" || slot_payload != \"Leaf[i32]\"");
  }
  if (modGen.enums[1].name != "Slot" || modGen.enums[1].type_params.len() != 0) {
    return test.fail("modGen.enums[1].name != \"Slot\" || modGen.enums[1].type_params.len() != 0");
  }
  let fmtGen = parser.parse_module_verbatim(lexer.tokenize(srcGen)).pmod;
  if (fmtGen.aliases.len() != 2 || fmtGen.enums.len() != 0) {
    return test.fail("fmtGen.aliases.len() != 2 || fmtGen.enums.len() != 0");
  }
  if (fmtGen.aliases[0].type_params.len() != 1 || fmtGen.aliases[0].type_params[0] != "T") {
    return test.fail("fmtGen.aliases[0].type_params.len() != 1 || fmtGen.aliases[0].type_params[0] != \"T\"");
  }
  if (fmtGen.aliases[0].variant_args.len() != 2 || fmtGen.aliases[0].variant_args[0] != "T" || fmtGen.aliases[0].variant_args[1] != "") {
    return test.fail("fmtGen.aliases[0].variant_args.len() != 2 || fmtGen.aliases[0].variant_args[0] != \"T\" || fmtGen.aliases[0].variant_args[1] != \"\"");
  }
  if (fmtGen.aliases[1].variant_args[0] != "i32") {
    return test.fail("fmtGen.aliases[1].variant_args[0] != \"i32\"");
  }
  let srcBad = "struct Leaf[T] { v: T } struct Lit { v: i32 } type Tree = Leaf | Lit; function main(): i32 { return 0; }";
  let modBad = parser.parse_module(lexer.tokenize(srcBad));
  if (modBad.aliases.len() != 1 || modBad.enums.len() != 0) {
    return test.fail("modBad.aliases.len() != 1 || modBad.enums.len() != 0");
  }

  let srcTy2 = "type Id = Inner;";
  let modTy2 = parser.parse_module(lexer.tokenize(srcTy2));
  if (modTy2.aliases.len() != 1) {
    return test.fail("modTy2.aliases.len() != 1");
  }
  if (modTy2.aliases[0].name != "Id") {
    return test.fail("modTy2.aliases[0].name != \"Id\"");
  }
  if (modTy2.aliases[0].variants.len() != 1) {
    return test.fail("modTy2.aliases[0].variants.len() != 1");
  }
  if (modTy2.aliases[0].variants[0] != "Inner") {
    return test.fail("modTy2.aliases[0].variants[0] != \"Inner\"");
  }

  return test.pass();
}

function check_match_statements(): test.TestOutcome {
  let srcMa = "match (e) { Circle(c) => { return 1; }, Square(_) => { return 2; }, _ => { return 3; } }";
  let progMa = parser.parse_program(lexer.tokenize(srcMa));
  if (progMa.len() != 1) {
    return test.fail("progMa.len() != 1");
  }
  match (progMa[0]) {
    ast.StmtMatch(m) => {
      match (m.scrutinee) {
        ast.ExprIdent(id) => {
          if (id.name != "e") {
            return test.fail("id.name != \"e\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of m.scrutinee");
        }
      }
      if (m.arms.len() != 3) {
        return test.fail("m.arms.len() != 3");
      }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Circle") {
            return test.fail("pv.type_name != \"Circle\"");
          }
          if (pv.binding != "c") {
            return test.fail("pv.binding != \"c\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of m.arms[0].pattern");
        }
      }
      if (m.arms[0].body.len() != 1) {
        return test.fail("m.arms[0].body.len() != 1");
      }
      match (m.arms[1].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Square") {
            return test.fail("pv.type_name != \"Square\"");
          }
          if (pv.binding != "_") {
            return test.fail("pv.binding != \"_\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of m.arms[1].pattern");
        }
      }
      match (m.arms[2].pattern) {
        ast.PatWildcard(_) => {},
        _ => {
          return test.fail("unexpected variant of m.arms[2].pattern");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progMa[0]");
    }
  }

  let srcMb = "match (x) { Foo => { return 1; }, _ => { return 0; } }";
  let progMb = parser.parse_program(lexer.tokenize(srcMb));
  match (progMb[0]) {
    ast.StmtMatch(m) => {
      if (m.arms.len() != 2) {
        return test.fail("m.arms.len() != 2");
      }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Foo") {
            return test.fail("pv.type_name != \"Foo\"");
          }
          if (pv.binding != "") {
            return test.fail("pv.binding != \"\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of m.arms[0].pattern");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progMb[0]");
    }
  }

  return test.pass();
}

