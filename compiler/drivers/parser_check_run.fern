  match (progFor[0]) {
    ast.StmtFor(fs) => {
      if (fs.var_name != "x") {
        return test.fail("fs.var_name != \"x\"");
      }
      match (fs.iter) {
        ast.ExprIdent(id) => {
          if (id.name != "arr") {
            return test.fail("id.name != \"arr\"");
