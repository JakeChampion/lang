// The parser's self-checks. Each check returns 0, or the number of the
// assertion that failed.

import "../ast";
import "../astwalk";
import "../builtinsigs";
import "../lexer";
import "../parser";
import "../typeinfo";
import "../util";
import "std/envflag";
import "std/string";

function main(): i32 {
  let rc = check_operator_precedence();
  if (rc != 0) {
    return rc;
  }
  rc = check_if_and_while();
  if (rc != 0) {
    return rc;
  }
  rc = check_compound_assignment();
  if (rc != 0) {
    return rc;
  }
  rc = check_slice_expressions();
  if (rc != 0) {
    return rc;
  }
  rc = check_module_functions();
  if (rc != 0) {
    return rc;
  }
  rc = check_struct_declarations();
  if (rc != 0) {
    return rc;
  }
  rc = check_struct_literals();
  if (rc != 0) {
    return rc;
  }
  rc = check_type_aliases();
  if (rc != 0) {
    return rc;
  }
  rc = check_match_statements();
  if (rc != 0) {
    return rc;
  }
  rc = check_var_annotations();
  if (rc != 0) {
    return rc;
  }
  rc = check_receiver_methods();
  if (rc != 0) {
    return rc;
  }
  rc = check_imports();
  if (rc != 0) {
    return rc;
  }
  rc = check_for_in_loops();
  if (rc != 0) {
    return rc;
  }
  rc = check_tuples();
  if (rc != 0) {
    return rc;
  }
  rc = check_break_and_continue();
  if (rc != 0) {
    return rc;
  }
  rc = check_generics();
  if (rc != 0) {
    return rc;
  }
  rc = check_lambdas();
  if (rc != 0) {
    return rc;
  }
  rc = check_fstrings();
  if (rc != 0) {
    return rc;
  }
  rc = check_qualified_names();
  if (rc != 0) {
    return rc;
  }
  rc = check_struct_patterns();
  if (rc != 0) {
    return rc;
  }

  return 0;
}

function check_operator_precedence(): i32 {
  let src = "let x = 1 + 2 * 3; let y = (1 + 2) * 3; return x + y;";
  let toks = lexer.tokenize(src);
  let prog = parser.parse_program(toks);
  if (prog.len() != 3) {
    return 1;
  }

  match (prog[0]) {
    ast.StmtVar(s0) => {
      if (s0.name != "x") {
        return 100;
      }
      match (s0.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 101;
          }
          match (b.right) {
            ast.ExprBinary(rb) => {
              if (rb.op != "*") {
                return 102;
              }
            },
            _ => {
              return 103;
            }
          }
          match (b.left) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 104;
              }
            },
            _ => {
              return 105;
            }
          }
        },
        _ => {
          return 106;
        }
      }
    },
    _ => {
      return 107;
    }
  }

  match (prog[1]) {
    ast.StmtVar(s1) => {
      if (s1.name != "y") {
        return 200;
      }
      match (s1.init) {
        ast.ExprBinary(b) => {
          if (b.op != "*") {
            return 201;
          }
          match (b.left) {
            ast.ExprBinary(lb) => {
              if (lb.op != "+") {
                return 202;
              }
            },
            _ => {
              return 203;
            }
          }
        },
        _ => {
          return 204;
        }
      }
    },
    _ => {
      return 205;
    }
  }

  match (prog[2]) {
    ast.StmtReturn(s2) => {
      match (s2.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 300;
          }
          match (b.left) {
            ast.ExprIdent(id) => {
              if (id.name != "x") {
                return 301;
              }
            },
            _ => {
              return 302;
            }
          }
          match (b.right) {
            ast.ExprIdent(id) => {
              if (id.name != "y") {
                return 303;
              }
            },
            _ => {
              return 304;
            }
          }
        },
        _ => {
          return 305;
        }
      }
    },
    _ => {
      return 306;
    }
  }

  return 0;
}

function check_if_and_while(): i32 {
  let src2 = "if (x < 0) { let a = 1; } else { let b = 2; }";
  let prog2 = parser.parse_program(lexer.tokenize(src2));
  if (prog2.len() != 1) {
    return 400;
  }
  match (prog2[0]) {
    ast.StmtIf(ifs) => {
      match (ifs.cond) {
        ast.ExprBinary(b) => {
          if (b.op != "<") {
            return 401;
          }
        },
        _ => {
          return 402;
        }
      }
      if (ifs.then_body.len() != 1) {
        return 403;
      }
      if (ifs.else_body.len() != 1) {
        return 404;
      }
    },
    _ => {
      return 405;
    }
  }

  let src3 = "if (true) { return 1; }";
  let prog3 = parser.parse_program(lexer.tokenize(src3));
  match (prog3[0]) {
    ast.StmtIf(ifs) => {
      if (ifs.else_body.len() != 0) {
        return 500;
      }
    },
    _ => {
      return 501;
    }
  }

  let src4 = "while (i < 5) { i = i + 1; }";
  let prog4 = parser.parse_program(lexer.tokenize(src4));
  if (prog4.len() != 1) {
    return 600;
  }
  match (prog4[0]) {
    ast.StmtWhile(w) => {
      match (w.cond) {
        ast.ExprBinary(b) => {
          if (b.op != "<") {
            return 601;
          }
        },
        _ => {
          return 602;
        }
      }
      if (w.body.len() != 1) {
        return 603;
      }
      match (w.body[0]) {
        ast.StmtAssign(a) => {
          if (a.target != "i") {
            return 604;
          }
          match (a.value) {
            ast.ExprBinary(b) => {
              if (b.op != "+") {
                return 605;
              }
            },
            _ => {
              return 606;
            }
          }
        },
        _ => {
          return 607;
        }
      }
    },
    _ => {
      return 608;
    }
  }

  return 0;
}

function check_compound_assignment(): i32 {
  let srcC = "x += 1;";
  let progC = parser.parse_program(lexer.tokenize(srcC));
  if (progC.len() != 1) {
    return 700;
  }
  match (progC[0]) {
    ast.StmtAssign(a) => {
      if (a.target != "x") {
        return 701;
      }
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 702;
          }
          match (b.left) {
            ast.ExprIdent(id) => {
              if (id.name != "x") {
                return 703;
              }
            },
            _ => {
              return 704;
            }
          }
          match (b.right) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 705;
              }
            },
            _ => {
              return 706;
            }
          }
        },
        _ => {
          return 707;
        }
      }
    },
    _ => {
      return 708;
    }
  }

  let srcD = "s *= 2;";
  match (parser.parse_program(lexer.tokenize(srcD))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "*") {
            return 720;
          }
        },
        _ => {
          return 721;
        }
      }
    },
    _ => {
      return 722;
    }
  }

  let srcBwAnd = "m &= 6;";
  match (parser.parse_program(lexer.tokenize(srcBwAnd))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "&") {
            return 730;
          }
        },
        _ => {
          return 731;
        }
      }
    },
    _ => {
      return 732;
    }
  }
  let srcBwShl = "f <<= 3;";
  match (parser.parse_program(lexer.tokenize(srcBwShl))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "<<") {
            return 733;
          }
        },
        _ => {
          return 734;
        }
      }
    },
    _ => {
      return 735;
    }
  }

  return 0;
}

function check_slice_expressions(): i32 {
  let srcS = "let t = s[1:4]; return 0;";
  let progS = parser.parse_program(lexer.tokenize(srcS));
  match (progS[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprSlice(sl) => {
          match (sl.start) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 650;
              }
            },
            _ => {
              return 651;
            }
          }
          match (sl.end) {
            ast.ExprNumber(n) => {
              if (n.text != "4") {
                return 652;
              }
            },
            _ => {
              return 653;
            }
          }
        },
        _ => {
          return 654;
        }
      }
    },
    _ => {
      return 655;
    }
  }

  let srcOS = "let t = s[1:]; return 0;";
  let progOS = parser.parse_program(lexer.tokenize(srcOS));
  match (progOS[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprSlice(sl) => {
          if (!sl.open_end) {
            return 658;
          }
          match (sl.start) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 656;
              }
            },
            _ => {
              return 657;
            }
          }
          match (sl.array) {
            ast.ExprIdent(id) => {
              if (id.name != "s") {
                return 660;
              }
            },
            _ => {
              return 661;
            }
          }
          match (sl.end) {
            ast.ExprCall(_) => {
              return 663;
            },
            _ => {}
          }
        },
        _ => {
          return 664;
        }
      }
    },
    _ => {
      return 665;
    }
  }

  return 0;
}

function check_module_functions(): i32 {
  let src5 = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
  let mod = parser.parse_module(lexer.tokenize(src5));
  if (mod.funcs.len() != 2) {
    return 700;
  }
  if (mod.top_stmts.len() != 0) {
    return 701;
  }
  if (mod.funcs[0].name != "add") {
    return 702;
  }
  if (mod.funcs[0].params.len() != 2) {
    return 703;
  }
  if (mod.funcs[0].params[0].name != "x") {
    return 704;
  }
  if (mod.funcs[0].params[0].type_name != "i32") {
    return 705;
  }
  if (mod.funcs[0].ret_type != "i32") {
    return 706;
  }
  if (mod.funcs[0].body.len() != 1) {
    return 707;
  }
  if (mod.funcs[1].name != "main") {
    return 708;
  }
  if (mod.funcs[1].params.len() != 0) {
    return 709;
  }
  if (mod.funcs[1].ret_type != "i32") {
    return 710;
  }

  return 0;
}

function check_struct_declarations(): i32 {
  let srcSt = "struct Point { x: i32, y: i32 } struct Empty { } function main(): i32 { return 0; }";
  let modSt = parser.parse_module(lexer.tokenize(srcSt));
  if (modSt.structs.len() != 2) {
    return 720;
  }
  if (modSt.structs[0].name != "Point") {
    return 721;
  }
  if (modSt.structs[0].fields.len() != 2) {
    return 722;
  }
  if (modSt.structs[0].fields[0].name != "x") {
    return 723;
  }
  if (modSt.structs[0].fields[0].type_name != "i32") {
    return 724;
  }
  if (modSt.structs[0].fields[1].name != "y") {
    return 725;
  }
  if (modSt.structs[1].name != "Empty") {
    return 726;
  }
  if (modSt.structs[1].fields.len() != 0) {
    return 727;
  }
  if (modSt.funcs.len() != 1) {
    return 728;
  }
  if (modSt.funcs[0].name != "main") {
    return 729;
  }

  let srcTc = "struct Tc { a: i32, b: i32, } function main(): i32 { return 0; }";
  let modTc = parser.parse_module(lexer.tokenize(srcTc));
  if (modTc.structs.len() != 1) {
    return 730;
  }
  if (modTc.structs[0].fields.len() != 2) {
    return 731;
  }
  if (modTc.structs[0].fields[1].name != "b") {
    return 732;
  }

  return 0;
}

function check_struct_literals(): i32 {
  let srcL: string = "let p = Point { x: 3, y: 4 }; return 0;";
  let progL = parser.parse_program(lexer.tokenize(srcL));
  match (progL[0]) {
    ast.StmtVar(v) => {
      if (v.name != "p") {
        return 800;
      }
      match (v.init) {
        ast.ExprStructLit(sl) => {
          if (sl.type_name != "Point") {
            return 801;
          }
          if (sl.field_names.len() != 2) {
            return 802;
          }
          if (sl.field_names[0] != "x") {
            return 803;
          }
          if (sl.field_names[1] != "y") {
            return 804;
          }
          match (sl.field_values[0]) {
            ast.ExprNumber(n) => {
              if (n.text != "3") {
                return 805;
              }
            },
            _ => {
              return 806;
            }
          }
        },
        _ => {
          return 807;
        }
      }
    },
    _ => {
      return 808;
    }
  }

  let srcF = "return p.x;";
  let progF = parser.parse_program(lexer.tokenize(srcF));
  match (progF[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "x") {
            return 810;
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "p") {
                return 811;
              }
            },
            _ => {
              return 812;
            }
          }
        },
        _ => {
          return 813;
        }
      }
    },
    _ => {
      return 814;
    }
  }

  let srcCh = "return Point { x: 1, y: 2 }.x;";
  let progCh = parser.parse_program(lexer.tokenize(srcCh));
  match (progCh[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "x") {
            return 820;
          }
          match (fa.obj) {
            ast.ExprStructLit(sl) => {
              if (sl.type_name != "Point") {
                return 821;
              }
            },
            _ => {
              return 822;
            }
          }
        },
        _ => {
          return 823;
        }
      }
    },
    _ => {
      return 824;
    }
  }

  return 0;
}

function check_type_aliases(): i32 {
  let srcTy = "pub type Shape = Circle | Square | Triangle; pub type Cell = Empty | Wall; struct Circle { r: i32 } function main(): i32 { return 0; }";
  let modTy = parser.parse_module(lexer.tokenize(srcTy));
  if (modTy.aliases.len() != 2) {
    return 830;
  }
  if (modTy.aliases[0].name != "Shape") {
    return 831;
  }
  if (modTy.aliases[0].variants.len() != 3) {
    return 832;
  }
  if (modTy.aliases[0].variants[0] != "Circle") {
    return 833;
  }
  if (modTy.aliases[0].variants[1] != "Square") {
    return 834;
  }
  if (modTy.aliases[0].variants[2] != "Triangle") {
    return 835;
  }
  if (modTy.aliases[1].name != "Cell") {
    return 836;
  }
  if (modTy.aliases[1].variants.len() != 2) {
    return 837;
  }
  if (modTy.aliases[1].variants[0] != "Empty") {
    return 838;
  }
  if (modTy.aliases[1].variants[1] != "Wall") {
    return 839;
  }
  if (modTy.structs.len() != 1) {
    return 840;
  }
  if (modTy.structs[0].name != "Circle") {
    return 841;
  }
  if (modTy.funcs.len() != 1) {
    return 842;
  }
  if (modTy.funcs[0].name != "main") {
    return 843;
  }
  let srcGen = "struct Leaf[T] { v: T } struct Lit { v: i32 } type Tree[T] = Leaf[T] | Lit; type Slot = Leaf[i32] | Lit; function main(): i32 { return 0; }";
  let modGen = parser.parse_module(lexer.tokenize(srcGen));
  if (modGen.aliases.len() != 0 || modGen.enums.len() != 2) {
    return 844;
  }
  if (modGen.enums[0].name != "Tree" || modGen.enums[0].type_params.len() != 1 || modGen.enums[0].type_params[0] != "0_T") {
    return 845;
  }
  if (modGen.enums[0].variant_names.len() != 2 || modGen.enums[0].variant_names[0] != "Leaf" || modGen.enums[0].variant_names[1] != "Lit") {
    return 846;
  }
  let leaf_payload = "";
  let lit_payload = "";
  let slot_payload = "";
  for sd in modGen.structs {
    if (sd.enum_owner == "Tree" && sd.name == "Leaf") {
      leaf_payload = sd.fields[0].type_name;
    }
    if (sd.enum_owner == "Tree" && sd.name == "Lit") {
      lit_payload = sd.fields[0].type_name;
    }
    if (sd.enum_owner == "Slot" && sd.name == "Leaf") {
      slot_payload = sd.fields[0].type_name;
    }
  }
  if (leaf_payload != "Leaf[0_T]" || lit_payload != "Lit" || slot_payload != "Leaf[i32]") {
    return 847;
  }
  if (modGen.enums[1].name != "Slot" || modGen.enums[1].type_params.len() != 0) {
    return 848;
  }
  let fmtGen = parser.parse_module_verbatim(lexer.tokenize(srcGen)).pmod;
  if (fmtGen.aliases.len() != 2 || fmtGen.enums.len() != 0) {
    return 849;
  }
  if (fmtGen.aliases[0].type_params.len() != 1 || fmtGen.aliases[0].type_params[0] != "T") {
    return 850;
  }
  if (fmtGen.aliases[0].variant_args.len() != 2 || fmtGen.aliases[0].variant_args[0] != "T" || fmtGen.aliases[0].variant_args[1] != "") {
    return 851;
  }
  if (fmtGen.aliases[1].variant_args[0] != "i32") {
    return 852;
  }
  let srcBad = "struct Leaf[T] { v: T } struct Lit { v: i32 } type Tree = Leaf | Lit; function main(): i32 { return 0; }";
  let modBad = parser.parse_module(lexer.tokenize(srcBad));
  if (modBad.aliases.len() != 1 || modBad.enums.len() != 0) {
    return 853;
  }

  let srcTy2 = "type Id = Inner;";
  let modTy2 = parser.parse_module(lexer.tokenize(srcTy2));
  if (modTy2.aliases.len() != 1) {
    return 850;
  }
  if (modTy2.aliases[0].name != "Id") {
    return 851;
  }
  if (modTy2.aliases[0].variants.len() != 1) {
    return 852;
  }
  if (modTy2.aliases[0].variants[0] != "Inner") {
    return 853;
  }

  return 0;
}

function check_match_statements(): i32 {
  let srcMa = "match (e) { Circle(c) => { return 1; }, Square(_) => { return 2; }, _ => { return 3; } }";
  let progMa = parser.parse_program(lexer.tokenize(srcMa));
  if (progMa.len() != 1) {
    return 900;
  }
  match (progMa[0]) {
    ast.StmtMatch(m) => {
      match (m.scrutinee) {
        ast.ExprIdent(id) => {
          if (id.name != "e") {
            return 901;
          }
        },
        _ => {
          return 902;
        }
      }
      if (m.arms.len() != 3) {
        return 903;
      }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Circle") {
            return 904;
          }
          if (pv.binding != "c") {
            return 905;
          }
        },
        _ => {
          return 906;
        }
      }
      if (m.arms[0].body.len() != 1) {
        return 907;
      }
      match (m.arms[1].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Square") {
            return 908;
          }
          if (pv.binding != "_") {
            return 909;
          }
        },
        _ => {
          return 910;
        }
      }
      match (m.arms[2].pattern) {
        ast.PatWildcard(_) => {},
        _ => {
          return 911;
        }
      }
    },
    _ => {
      return 912;
    }
  }

  let srcMb = "match (x) { Foo => { return 1; }, _ => { return 0; } }";
  let progMb = parser.parse_program(lexer.tokenize(srcMb));
  match (progMb[0]) {
    ast.StmtMatch(m) => {
      if (m.arms.len() != 2) {
        return 920;
      }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Foo") {
            return 921;
          }
          if (pv.binding != "") {
            return 922;
          }
        },
        _ => {
          return 923;
        }
      }
    },
    _ => {
      return 924;
    }
  }

  return 0;
}

function check_var_annotations(): i32 {
  let srcTV = "let sh: Shape = c; return 0;";
  let progTV = parser.parse_program(lexer.tokenize(srcTV));
  match (progTV[0]) {
    ast.StmtVar(v) => {
      if (v.name != "sh") {
        return 930;
      }
      if (v.type_name != "Shape") {
        return 931;
      }
    },
    _ => {
      return 932;
    }
  }

  let srcTI = "let n: i32 = 7; return 0;";
  let progTI = parser.parse_program(lexer.tokenize(srcTI));
  match (progTI[0]) {
    ast.StmtVar(v) => {
      if (v.name != "n") {
        return 940;
      }
      if (v.type_name != "i32") {
        return 941;
      }
    },
