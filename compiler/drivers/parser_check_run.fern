function check_fstrings(): i32 {
  let srcFs = "return f\"x={x}\";";
  let progFs = parser.parse_program(lexer.tokenize(srcFs));
  match (progFs[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 1100;
          }
          match (b.left) {
            ast.ExprString(s) => {
              if (s.value != "x=") {
                return 1101;
              }
            },
            _ => {
              return 1102;
            }
          }
          match (b.right) {
            ast.ExprCall(call) => {
              match (call.callee) {
                ast.ExprFieldAccess(fa) => {
                  if (fa.field != "to_string") {
                    return 1103;
                  }
                  match (fa.obj) {
                    ast.ExprIdent(id) => {
                      if (id.name != "x") {
                        return 1104;
                      }
                    },
                    _ => {
                      return 1105;
                    }
                  }
                },
                _ => {
                  return 1106;
                }
              }
            },
            _ => {
              return 1107;
            }
          }
        },
        _ => {
          return 1108;
        }
      }
    },
    _ => {
      return 1109;
    }
  }

  match (parser.parse_program(lexer.tokenize("return f\"\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprString(s) => {
          if (s.value != "") {
            return 1110;
          }
        },
        _ => {
          return 1111;
        }
      }
    },
    _ => {
      return 1112;
    }
  }

  match (parser.parse_program(lexer.tokenize("return f\"hi\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprString(s) => {
          if (s.value != "hi") {
            return 1113;
          }
        },
        _ => {
          return 1114;
        }
      }
    },
    _ => {
      return 1115;
    }
  }

  match (parser.parse_program(lexer.tokenize("return f\"{x} {x y} {x)}\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprUnknown(u) => {
          if (u.kind != "f-string interpolation: unexpected trailing tokens after expression") {
            return 1116;
          }
          if (u.line != 1 || u.col != 17) {
            return 1117;
          }
        },
        _ => {
          return 1118;
        }
      }
    },
    _ => {
      return 1119;
    }
  }

  match (parser.parse_program(lexer.tokenize("return f\"{x + @} {x y}\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprBinary(b) => {
          if (!parser.holds_sentinel(b.right)) {
            return 1127;
          }
        },
        _ => {
          return 1128;
        }
      }
    },
    _ => {
      return 1129;
    }
  }

  return 0;
}

