function check_fstrings(): test.TestOutcome {
  let srcFs = "return f\"x={x}\";";
  let progFs = parser.parse_program(lexer.tokenize(srcFs));
  match (progFs[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return test.fail("b.op != \"+\"");
          }
          match (b.left) {
            ast.ExprString(s) => {
              if (s.value != "x=") {
                return test.fail("s.value != \"x=\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of b.left");
            }
          }
          match (b.right) {
            ast.ExprCall(call) => {
              match (call.callee) {
                ast.ExprFieldAccess(fa) => {
                  if (fa.field != "to_string") {
                    return test.fail("fa.field != \"to_string\"");
                  }
                  match (fa.obj) {
                    ast.ExprIdent(id) => {
                      if (id.name != "x") {
                        return test.fail("id.name != \"x\"");
                      }
                    },
                    _ => {
                      return test.fail("unexpected variant of fa.obj");
                    }
                  }
                },
                _ => {
                  return test.fail("unexpected variant of call.callee");
                }
              }
            },
            _ => {
              return test.fail("unexpected variant of b.right");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of r.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progFs[0]");
    }
  }

  match (parser.parse_program(lexer.tokenize("return f\"\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprString(s) => {
          if (s.value != "") {
            return test.fail("s.value != \"\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of r.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of parser.parse_program(lexer.tokenize(\"return f\\\"\\\";\"))[0]");
    }
  }

  match (parser.parse_program(lexer.tokenize("return f\"hi\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprString(s) => {
          if (s.value != "hi") {
            return test.fail("s.value != \"hi\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of r.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of parser.parse_program(lexer.tokenize(\"return f\\\"hi\\\";\"))[0]");
    }
  }

  match (parser.parse_program(lexer.tokenize("return f\"{x} {x y} {x)}\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprUnknown(u) => {
          if (u.kind != "f-string interpolation: unexpected trailing tokens after expression") {
            return test.fail("u.kind != \"f-string interpolation: unexpected trailing tokens after expression\"");
          }
          if (u.line != 1 || u.col != 17) {
            return test.fail("u.line != 1 || u.col != 17");
          }
        },
        _ => {
          return test.fail("unexpected variant of r.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of parser.parse_program(lexer.tokenize(\"return f\\\"{x} {x y} {x)}\\\";\"))[0]");
    }
  }

  match (parser.parse_program(lexer.tokenize("return f\"{x + @} {x y}\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprBinary(b) => {
          if (!parser.holds_sentinel(b.right)) {
            return test.fail("!parser.holds_sentinel(b.right)");
          }
        },
        _ => {
          return test.fail("unexpected variant of r.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of parser.parse_program(lexer.tokenize(\"return f\\\"{x + @} {x y}\\\";\"))[0]");
    }
  }

  return test.pass();
}

function check_qualified_names(): test.TestOutcome {
  let srcQ = "struct Par { toks: lexer.Token[], cur: parser.Node, n: i32 } function main(): i32 { return 0; }";
  let modQ = parser.parse_module(lexer.tokenize(srcQ));
  if (modQ.structs.len() != 1) {
    return test.fail("modQ.structs.len() != 1");
  }
  if (modQ.structs[0].name != "Par") {
    return test.fail("modQ.structs[0].name != \"Par\"");
  }
  if (modQ.structs[0].fields.len() != 3) {
    return test.fail("modQ.structs[0].fields.len() != 3");
  }
  if (modQ.structs[0].fields[0].type_name != "lexer.Token[]") {
    return test.fail("modQ.structs[0].fields[0].type_name != \"lexer.Token[]\"");
  }
  if (modQ.structs[0].fields[1].type_name != "parser.Node") {
    return test.fail("modQ.structs[0].fields[1].type_name != \"parser.Node\"");
  }
  if (modQ.structs[0].fields[2].type_name != "i32") {
    return test.fail("modQ.structs[0].fields[2].type_name != \"i32\"");
  }
  if (modQ.funcs.len() != 1) {
    return test.fail("modQ.funcs.len() != 1");
  }

  let srcQ2 = "function f(t: lexer.Token): lexer.Token { return t; }";
  let modQ2 = parser.parse_module(lexer.tokenize(srcQ2));
  if (modQ2.funcs.len() != 1) {
    return test.fail("modQ2.funcs.len() != 1");
  }
  if (modQ2.funcs[0].params.len() != 1) {
    return test.fail("modQ2.funcs[0].params.len() != 1");
  }
  if (modQ2.funcs[0].params[0].type_name != "lexer.Token") {
    return test.fail("modQ2.funcs[0].params[0].type_name != \"lexer.Token\"");
  }
  if (modQ2.funcs[0].ret_type != "lexer.Token") {
    return test.fail("modQ2.funcs[0].ret_type != \"lexer.Token\"");
  }

  let srcM = "match (t) { lexer.TokNumber(n) => { x = 1; }, _ => { x = 0; } }";
  let progM = parser.parse_program(lexer.tokenize(srcM));
  if (progM.len() != 1) {
    return test.fail("progM.len() != 1");
  }
  match (progM[0]) {
    ast.StmtMatch(m) => {
      if (m.arms.len() != 2) {
        return test.fail("m.arms.len() != 2");
      }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "lexer.TokNumber") {
            return test.fail("pv.type_name != \"lexer.TokNumber\"");
          }
          if (pv.binding != "n") {
            return test.fail("pv.binding != \"n\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of m.arms[0].pattern");
        }
      }
      match (m.arms[1].pattern) {
        ast.PatWildcard(_) => {},
        _ => {
          return test.fail("unexpected variant of m.arms[1].pattern");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progM[0]");
    }
  }

  return test.pass();
}

function check_struct_patterns(): test.TestOutcome {
  let srcSP = "function f(Point { x, y }: Point): i32 { return x * 10 + y; }";
  let modSP = parser.parse_module(lexer.tokenize(srcSP));
  if (modSP.funcs.len() != 1) {
    return test.fail("modSP.funcs.len() != 1");
  }
  if (modSP.funcs[0].name != "f") {
    return test.fail("modSP.funcs[0].name != \"f\"");
  }
  if (modSP.funcs[0].ret_type != "i32") {
    return test.fail("modSP.funcs[0].ret_type != \"i32\"");
  }
  if (modSP.funcs[0].params.len() != 1) {
    return test.fail("modSP.funcs[0].params.len() != 1");
  }
  let spHolder = modSP.funcs[0].params[0].name;
  if (spHolder.len() < 9 || !spHolder.starts_with("__ptuple_")) {
    return test.fail("spHolder.len() < 9 || !spHolder.starts_with(\"__ptuple_\")");
  }
  if (modSP.funcs[0].params[0].type_name != "Point") {
    return test.fail("modSP.funcs[0].params[0].type_name != \"Point\"");
  }
  if (modSP.funcs[0].body.len() != 2) {
    return test.fail("modSP.funcs[0].body.len() != 2");
  }
  match (modSP.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "x,y") {
        return test.fail("v.name != \"x,y\"");
      }
      if (v.type_name != "@pp;@sd:Point:x,y") {
        return test.fail("v.type_name != \"@pp;@sd:Point:x,y\"");
      }
      match (v.init) {
        ast.ExprIdent(id) => {
          if (id.name != spHolder) {
            return test.fail("id.name != spHolder");
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of modSP.funcs[0].body[0]");
    }
  }

  let srcSPR = "function g(Point { x: a, y }: Point): i32 { return a; }";
  let modSPR = parser.parse_module(lexer.tokenize(srcSPR));
  if (modSPR.funcs.len() != 1) {
    return test.fail("modSPR.funcs.len() != 1");
  }
  match (modSPR.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "a,y") {
        return test.fail("v.name != \"a,y\"");
      }
      if (v.type_name != "@pp;@sd:Point:x,y") {
        return test.fail("v.type_name != \"@pp;@sd:Point:x,y\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of modSPR.funcs[0].body[0]");
    }
  }

  let srcSPA = "function h(w @ Point { x, y }: Point): i32 { return w.x + x + y; }";
  let modSPA = parser.parse_module(lexer.tokenize(srcSPA));
  if (modSPA.funcs.len() != 1) {
    return test.fail("modSPA.funcs.len() != 1");
  }
  if (modSPA.funcs[0].params.len() != 1) {
    return test.fail("modSPA.funcs[0].params.len() != 1");
  }
  if (modSPA.funcs[0].params[0].name != "w") {
    return test.fail("modSPA.funcs[0].params[0].name != \"w\"");
  }
  match (modSPA.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.type_name != "@pp;@sd:Point:x,y") {
        return test.fail("v.type_name != \"@pp;@sd:Point:x,y\"");
      }
      match (v.init) {
        ast.ExprIdent(id) => {
          if (id.name != "w") {
            return test.fail("id.name != \"w\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of modSPA.funcs[0].body[0]");
    }
  }

  let srcSPL = "function main(): i32 { let f = (Point { x, y }: Point): i32 => { return x * 10 + y; }; let g = (Point { x, y }: Point) => x + y; return 0; }";
  let modSPL = parser.parse_module(lexer.tokenize(srcSPL));
  if (modSPL.funcs.len() != 1) {
    return test.fail("modSPL.funcs.len() != 1");
  }
  if (modSPL.funcs[0].body.len() != 3) {
    return test.fail("modSPL.funcs[0].body.len() != 3");
  }
  match (modSPL.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 1) {
            return test.fail("lm.params.len() != 1");
          }
          if (lm.ret_type != "i32") {
            return test.fail("lm.ret_type != \"i32\"");
          }
          if (lm.body.len() != 2) {
            return test.fail("lm.body.len() != 2");
          }
          match (lm.body[0]) {
            ast.StmtVar(dv) => {
              if (dv.name != "x,y") {
                return test.fail("dv.name != \"x,y\"");
              }
              if (dv.type_name != "@pp;@sd:Point:x,y") {
                return test.fail("dv.type_name != \"@pp;@sd:Point:x,y\"");
              }
              match (dv.init) {
                ast.ExprIdent(id) => {
                  if (id.name != lm.params[0].name) {
                    return test.fail("id.name != lm.params[0].name");
                  }
                },
                _ => {
                  return test.fail("unexpected variant of dv.init");
                }
              }
            },
            _ => {
              return test.fail("unexpected variant of lm.body[0]");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of modSPL.funcs[0].body[0]");
    }
  }
  match (modSPL.funcs[0].body[1]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 1) {
            return test.fail("lm.params.len() != 1");
          }
          if (lm.body.len() != 2) {
            return test.fail("lm.body.len() != 2");
          }
          match (lm.body[0]) {
            ast.StmtVar(dv) => {
              if (dv.type_name != "@pp;@sd:Point:x,y") {
                return test.fail("dv.type_name != \"@pp;@sd:Point:x,y\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of lm.body[0]");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of modSPL.funcs[0].body[1]");
    }
  }

  let srcSPN = "let q = (Point { x: 1, y: 2 });";
  let progSPN = parser.parse_program(lexer.tokenize(srcSPN));
  if (progSPN.len() != 1) {
    return test.fail("progSPN.len() != 1");
  }
  match (progSPN[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprStructLit(_) => {},
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progSPN[0]");
    }
  }

  return test.pass();
}
