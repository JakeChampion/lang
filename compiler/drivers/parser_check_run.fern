        },
        _ => {
          return test.fail("unexpected variant of fs.iter");
        }
      }
      if (fs.body.len() != 1) {
        return test.fail("fs.body.len() != 1");
      }
    },
    _ => {
      return test.fail("unexpected variant of progFor[0]");
