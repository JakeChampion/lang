            return test.fail("a.elements.len() != 3");
          }
        },
        _ => {
          return test.fail("unexpected variant of fs.iter");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progFor2[0]");
    }
  }

  return test.pass();
}

function check_tuples(): test.TestOutcome {
  let srcTu = "let t = (1, 2, 3); return 0;";
  let progTu = parser.parse_program(lexer.tokenize(srcTu));
  match (progTu[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprTuple(t) => {
          if (t.elements.len() != 3) {
            return test.fail("t.elements.len() != 3");
          }
          match (t.elements[0]) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return test.fail("n.text != \"1\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of t.elements[0]");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progTu[0]");
    }
  }

  let srcGr = "let g = (1 + 2); return 0;";
  let progGr = parser.parse_program(lexer.tokenize(srcGr));
  match (progGr[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return test.fail("b.op != \"+\"");
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progGr[0]");
    }
  }

  let srcTH = "let t = (1, \"hi\"); return 0;";
  let progTH = parser.parse_program(lexer.tokenize(srcTH));
  match (progTH[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprTuple(t) => {
          if (t.elements.len() != 2) {
            return test.fail("t.elements.len() != 2");
          }
          match (t.elements[1]) {
            ast.ExprString(s) => {
              if (s.value != "hi") {
                return test.fail("s.value != \"hi\"");
              }
            },
            _ => {
              return test.fail("unexpected variant of t.elements[1]");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of v.init");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progTH[0]");
    }
  }

  let srcTp = "return (10, 20, 30).1;";
  let progTp = parser.parse_program(lexer.tokenize(srcTp));
  match (progTp[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "1") {
            return test.fail("fa.field != \"1\"");
          }
          match (fa.obj) {
            ast.ExprTuple(t) => {
              if (t.elements.len() != 3) {
                return test.fail("t.elements.len() != 3");
              }
            },
            _ => {
              return test.fail("unexpected variant of fa.obj");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of r.value");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progTp[0]");
    }
  }

  return test.pass();
}

function check_break_and_continue(): test.TestOutcome {
  let srcBC = "while (true) { if (x > 10) { break; } if (x < 0) { continue; } }";
  let progBC = parser.parse_program(lexer.tokenize(srcBC));
  if (progBC.len() != 1) {
    return test.fail("progBC.len() != 1");
  }
  match (progBC[0]) {
    ast.StmtWhile(w) => {
      if (w.body.len() != 2) {
        return test.fail("w.body.len() != 2");
      }
      match (w.body[0]) {
        ast.StmtIf(ifs) => {
          match (ifs.then_body[0]) {
            ast.StmtBreak(_) => {},
            _ => {
              return test.fail("unexpected variant of ifs.then_body[0]");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of w.body[0]");
        }
      }
      match (w.body[1]) {
        ast.StmtIf(ifs) => {
          match (ifs.then_body[0]) {
            ast.StmtContinue(_) => {},
            _ => {
              return test.fail("unexpected variant of ifs.then_body[0]");
            }
          }
        },
        _ => {
          return test.fail("unexpected variant of w.body[1]");
        }
      }
    },
    _ => {
      return test.fail("unexpected variant of progBC[0]");
    }
  }

  return test.pass();
}

function check_generics(): test.TestOutcome {
  let srcGT = "function lookup(m: Map[string, i32], k: string): i32 { return 0; }";
  let modGT = parser.parse_module(lexer.tokenize(srcGT));
  if (modGT.funcs.len() != 1) {
    return test.fail("modGT.funcs.len() != 1");
  }
  if (modGT.funcs[0].params[0].type_name != "Map[string, i32]") {
    return test.fail("modGT.funcs[0].params[0].type_name != \"Map[string, i32]\"");
  }
  if (modGT.funcs[0].params[1].type_name != "string") {
    return test.fail("modGT.funcs[0].params[1].type_name != \"string\"");
  }

  let srcGR = "function fresh(): Map[string, i32] { return null; }";
  let modGR = parser.parse_module(lexer.tokenize(srcGR));
  if (modGR.funcs[0].ret_type != "Map[string, i32]") {
    return test.fail("modGR.funcs[0].ret_type != \"Map[string, i32]\"");
  }

  let srcGS = "struct Cache { entries: Map[string, i32] } function main(): i32 { return 0; }";
  let modGS = parser.parse_module(lexer.tokenize(srcGS));
  if (modGS.structs.len() != 1) {
    return test.fail("modGS.structs.len() != 1");
  }
  if (modGS.structs[0].fields[0].type_name != "Map[string, i32]") {
    return test.fail("modGS.structs[0].fields[0].type_name != \"Map[string, i32]\"");
  }

  let srcBT = "function same[T: Eq + Display](a: T, b: T): i32 { return 0; }";
  let modBT = parser.parse_module(lexer.tokenize(srcBT));
  if (modBT.funcs[0].type_params.len() != 1) {
    return test.fail("modBT.funcs[0].type_params.len() != 1");
  }
  if (modBT.funcs[0].type_params[0] != "0_T") {
    return test.fail("modBT.funcs[0].type_params[0] != \"0_T\"");
  }
  if (modBT.funcs[0].params[0].type_name != "0_T") {
    return test.fail("modBT.funcs[0].params[0].type_name != \"0_T\"");
  }
  if (parser.parse_module_verbatim(lexer.tokenize(srcBT)).pmod.funcs[0].params[0].type_name != "T") {
    return test.fail("parser.parse_module_verbatim(lexer.tokenize(srcBT)).pmod.funcs[0].params[0].type_name != \"T\"");
  }
  let srcRV = "struct K { v: i32 } struct Box[T] { x: T } function (b: Box[K]) key(): K { return b.x; } function (b: Box[U]) val(): U { return b.x; }";
  let modRV = parser.parse_module(lexer.tokenize(srcRV));
  if (modRV.funcs[0].receiver_type != "Box[K]") {
    return test.fail("modRV.funcs[0].receiver_type != \"Box[K]\"");
  }
  if (modRV.funcs[1].receiver_type != "Box[0_U]" || modRV.funcs[1].ret_type != "0_U") {
    return test.fail("modRV.funcs[1].receiver_type != \"Box[0_U]\" || modRV.funcs[1].ret_type != \"0_U\"");
  }
  let srcUT = "function id[T](x: T): T { return x; }";
  let modUT = parser.parse_module(lexer.tokenize(srcUT));
  if (modUT.funcs[0].type_params.len() != 0) {
    return test.fail("modUT.funcs[0].type_params.len() != 0");
  }

  let mainSrc = "import \"./greet\"; function main(): i32 { return hello(); }";
  let greetSrc = "pub function hello(): i32 { return 42; }";
  let mainMod = parser.parse_module(lexer.tokenize(mainSrc));
  let greetMod = parser.parse_module(lexer.tokenize(greetSrc));
  let merged = parser.merge_module(mainMod, greetMod);
  if (merged.funcs.len() != 2) {
    return test.fail("merged.funcs.len() != 2");
  }
  if (merged.funcs[0].name != "main") {
    return test.fail("merged.funcs[0].name != \"main\"");
  }
  if (merged.funcs[1].name != "hello") {
    return test.fail("merged.funcs[1].name != \"hello\"");
  }
  if (merged.imports.len() != 1) {
    return test.fail("merged.imports.len() != 1");
  }

  let pSrc = "pub function parse_module(): i32 { return 1; } pub struct Token { v: i32 }";
  let pMod = parser.parse_module(lexer.tokenize(pSrc));
  let withImp = parser.merge_module_prefixed(mainMod, pMod, "parser");
  if (withImp.funcs.len() != 2) {
    return test.fail("withImp.funcs.len() != 2");
  }
  if (withImp.funcs[1].name != "parser.parse_module") {
    return test.fail("withImp.funcs[1].name != \"parser.parse_module\"");
  }
  if (withImp.structs.len() != 1) {
    return test.fail("withImp.structs.len() != 1");
  }
  if (withImp.structs[0].name != "parser.Token") {
    return test.fail("withImp.structs[0].name != \"parser.Token\"");
  }

  let srcGV = "let m: Map[string, i32] = a; return 0;";
  let progGV = parser.parse_program(lexer.tokenize(srcGV));
  match (progGV[0]) {
    ast.StmtVar(v) => {
      if (v.type_name != "Map[string, i32]") {
        return test.fail("v.type_name != \"Map[string, i32]\"");
      }
    },
    _ => {
      return test.fail("unexpected variant of progGV[0]");
    }
  }

  return test.pass();
}

