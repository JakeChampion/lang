import "../ssafusedstringmachine" as machine;
import "../ssainlineuniqueisa" as registers;
import "std/string";

function require(ok: boolean, group: string): void {
  if (!ok) {
    print("fused-string machine controls failed: " + group);
    exit(180);
  }
}

function change(s: string, from: string, to: string): string {
  let outer = s.split("__fn___fern_str_free:\n");
  require(outer.len() == 2, "unique string fixture");
  let next = outer[1].split("__fn___fern_str_view_free:\n");
  require(next.len() == 2, "following helper fixture");
  let parts = next[0].split(from);
  require(parts.len() > 1, "mutation present: " + from);
  return outer[0] + "__fn___fern_str_free:\n" + parts.join(to) + "__fn___fern_str_view_free:\n" + next[1];
}

function mutation(s: string, from: string, to: string, expected: boolean): void {
  require(machine.check(change(s, from, to)) == expected, from + " -> " + to);
}

function arithmetic(s: string): void {
  for line in ["movl 8(%rax), %edx", "movq (%rax), %rdx", "movq 12(%rax), %rdx"] {
    mutation(s, "movq 8(%rax), %rdx", line, false);
  }
  mutation(s, "addq $7, %rdx", "addl $7, %edx", false);
  mutation(s, "addq $7, %rdx", "addq $6, %rdx", false);
  mutation(s, "addq $7, %rdx", "addq $8, %rdx", false);
  mutation(s, "shrq $3, %rdx", "shrl $3, %edx", false);
  mutation(s, "shrq $3, %rdx", "shrq $2, %rdx", false);
  mutation(s, "shrq $3, %rdx", "shrq $67, %rdx", true);
  mutation(s, "shrq $3, %rdx", "shrq $64, %rdx\nshrq $3, %rdx", true);
  mutation(s, "addq $3, %rdx", "addq $2, %rdx", false);
  mutation(s, "addq $3, %rdx", "addl $3, %edx", false);
  mutation(s, "addq $3, %rdx", "addq $3, %rdx\nmovl %edx, %edx", false);
  mutation(s, "leaq 0(,%rdx,8), %rsi", "leaq 0(,%rdx,4), %rsi", false);
  mutation(s, "leaq 0(,%rdx,8), %rsi", "leaq 8(,%rdx,8), %rsi", false);
  mutation(s, "leaq 0(,%rdx,8), %rsi", "leaq 0(,%rdx,8), %rsi\nmovl %esi, %esi", false);
  mutation(s, "cmpq $65536, %rdx", "cmpl $65536, %edx", false);
  mutation(s, "cmpq $65536, %rdx", "cmpq $65537, %rdx", false);
  mutation(s, "cmpq $256, %rdx", "cmpq $257, %rdx", false);
  mutation(s, "jae .Lstrfree_fused_large", "jnb .Lstrfree_fused_large", true);
  mutation(s, "jae .Lstrfree_fused_large", "ja .Lstrfree_fused_large", false);
  mutation(s, "jae .Lstrfree_fused_large", "jo .Lstrfree_fused_large", false);
  mutation(s, "jae .Lstrfree_fused_large", "shrq $64, %rdx\njae .Lstrfree_fused_large", true);
  mutation(s, "jae .Lstrfree_fused_large", "addq $0, %rdx\njae .Lstrfree_fused_large", false);
}

function memory(s: string): void {
  let zero = "movl $0, -8(%rax)";
  for line in ["", "movq $0, -8(%rax)", "movl $1, -8(%rax)", "movl $0, -4(%rax)", "movl $0, -12(%rax)", zero + "\n" + zero] {
    mutation(s, zero, line, false);
  }
  mutation(s, "leaq -8(%rax), %rcx", "leaq -16(%rax), %rcx", false);
  let link = "movq %rsi, (%rcx)";
  for line in ["", "movl %esi, (%rcx)", "movq %rax, (%rcx)", "movq %rsi, 4(%rcx)", link + "\n" + link, link + "\n" + zero] {
    mutation(s, link, line, false);
  }
  let slot = "movq %rcx, (%r8,%rdx,8)";
  for line in ["", "movl %ecx, (%r8,%rdx,8)", "movq %rax, (%r8,%rdx,8)", "movq %rcx, 8(%r8,%rdx,8)", slot + "\n" + slot] {
    mutation(s, slot, line, false);
  }
  mutation(s, link + "\n    " + slot, slot + "\n" + link, true);
  mutation(s, slot, slot + "\nmovq (%rcx), %rsi", true);
  mutation(s, slot, slot + "\nmovq (%r8,%rdx,8), %rsi", false);
  mutation(s, "movq (%r8,%rdx,8), %rsi", "movq (%rcx), %rsi", false);
  mutation(s, "leaq __fern_freelist(%rip), %r8", "leaq __fern_large_freelist(%rip), %r8", false);
}

function calls(s: string): void {
  for line in ["", "call __fern_large_push", "call __other", "call __fern_capw\ncall __fern_capw", "movq %rax, (%rsp)\ncall __fern_capw"] {
    mutation(s, "call __fern_capw", line, false);
  }
  for line in ["", "call __fern_capw", "call __other", "call __fern_large_push\ncall __fern_large_push", "pushq %rax\ncall __fern_large_push\npopq %rax", "movq %rax, (%rsp)\ncall __fern_large_push"] {
    mutation(s, "call __fern_large_push", line, false);
  }
  for offset in ["-32", "-28", "-24", "-20", "-16", "-12", "-8", "-4", "0", "4"] {
    mutation(s, "call __fern_capw", "call __fern_capw\nmovl $7, " + offset + "(%rsp)", false);
  }
  mutation(s, "call __fern_large_push", "call __fern_large_push\nmovq %rax, -8(%rsp)", false);
  mutation(s, "call __fern_large_push", "call __fern_large_push\nje .Lstrfree_ret", false);
  mutation(s, "call __fern_capw", "call __fern_capw\nje .Lstrfree_ret", false);
  for pair in [["movq %rcx, (%r8)", ""], ["subq $72, %rdx", "subq $71, %rdx"], ["movq %rax, 32(%rsp)", "movq %rax, 24(%rsp)"]] {
    let parts = s.split(pair[0]);
    require(parts.len() > 1, "dependency mutation present: " + pair[0]);
    require(!machine.check(parts.join(pair[1])), "dependency " + pair[0]);
  }
  let argument = s.split("movq %rax, 32(%rsp)");
  require(argument.len() > 1, "capacity argument store present");
  require(machine.check(argument.join("movl %eax, 32(%rsp)")), "capacity store preserves known zero high half");
}

function identities(s: string): void {
  let regs = registers.registers(false, 64);
  let words = registers.registers(false, 32);
  let i = 0;
  while (i < regs.len()) {
    mutation(s, "    ret\n", "movq " + regs[i] + ", " + regs[i] + "\nret\n", true);
    mutation(s, "    ret\n", "movl " + words[i] + ", " + words[i] + "\nret\n", false);
    mutation(s, "    ret\n", "movq " + regs[(i + 1) % regs.len()] + ", " + regs[i] + "\nret\n", false);
    i = i + 1;
  }
  mutation(s, "movl -8(%rax), %ecx", "movq %rbx, %rcx\nmovq %rcx, %rbx\nmovl -8(%rax), %ecx", true);
  mutation(s, "movl -8(%rax), %ecx", "movl %ebx, %ecx\nmovq %rcx, %rbx\nmovl -8(%rax), %ecx", false);
  mutation(s, "movq 8(%rsp), %rax", "movq (%rsp), %rax", false);
  mutation(s, "    ret\n", "movq 8(%rsp), %rax\nret\n", false);
  mutation(s, "    ret\n", "ret $8\n", false);
}

pub function run(output: string): void {
  require(machine.check(output), "actual complete output, both entries, all intervals");
  arithmetic(output);
  memory(output);
  calls(output);
  identities(output);
  mutation(output, "cmpl $1934589965, %edx", "cmpl $1112494674, %edx", false);
  mutation(output, "testb $1, %al", "testb $1, %bl", false);
  mutation(output, "    ret\n", "unknown_instruction\nret\n", false);
  mutation(output, "    ret\n", "jmp .Lstrfree_ret\n", false);
  require(!machine.check(".set alias, __fern_capw\n" + output), "closed namespace");
  require(!machine.check(".text\n__fn___fern_str_free:\n__fn___fern_str_free.r:\nret\n"), "missing dependencies and effects");
}
