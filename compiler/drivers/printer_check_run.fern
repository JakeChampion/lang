// The printer's round-trip and diff self-checks. Each check returns 0, or
// the number of the assertion that failed.

import "../ast";
import "../lexer";
import "../parser";
import "../printer";
import "../util";
import "core/map";
import "std/string";

function roundtrip_verbatim(src: string): parser.Module {
  let mod = parser.parse_module_verbatim(lexer.tokenize(src)).pmod;
  return parser.parse_module_verbatim(lexer.tokenize(printer.print_module(mod))).pmod;
}

function roundtrip_module(src: string): parser.Module {
  let toks = lexer.tokenize(src);
  let mod = parser.parse_module(toks);
  let emitted = printer.print_module(mod);
  let toks2 = lexer.tokenize(emitted);
  return parser.parse_module(toks2);
}

function main(): i32 {
  let rc = check_expressions_and_control_flow();
  if (rc != 0) {
    return rc;
  }
  rc = check_checked_casts();
  if (rc != 0) {
    return rc;
  }
  rc = check_string_and_slice_literals();
  if (rc != 0) {
    return rc;
  }
  rc = check_structs_and_aliases();
  if (rc != 0) {
    return rc;
  }
  rc = check_match_statements();
  if (rc != 0) {
    return rc;
  }
  rc = check_annotations_and_receivers();
  if (rc != 0) {
    return rc;
  }
  rc = check_imports();
  if (rc != 0) {
    return rc;
  }
  rc = check_loops_and_tuples();
  if (rc != 0) {
    return rc;
  }
  rc = check_lambdas();
  if (rc != 0) {
    return rc;
  }
  rc = check_qualified_names_and_externs();
  if (rc != 0) {
    return rc;
  }
  rc = check_declaration_modifiers();
  if (rc != 0) {
    return rc;
  }
  rc = check_enums();
  if (rc != 0) {
    return rc;
  }
  rc = check_record_patterns();
  if (rc != 0) {
    return rc;
  }
  rc = check_const_and_for_sugar();
  if (rc != 0) {
    return rc;
  }
  rc = check_visibility_and_destructuring();
  if (rc != 0) {
    return rc;
  }
  rc = check_traits_and_impls();
  if (rc != 0) {
    return rc;
  }

  return 0;
}

function check_expressions_and_control_flow(): i32 {
  let toks1 = lexer.tokenize("let a = 1 + 2 * 3; return a;");
  let mod1 = parser.parse_module(toks1);
  let s1 = printer.print_module(mod1);
  let rt1 = parser.parse_module(lexer.tokenize(s1));
  if (rt1.top_stmts.len() != 2) {
    return 10;
  }
  match (rt1.top_stmts[0]) {
    ast.StmtVar(v) => {
      if (v.name != "a") {
        return 11;
      }
      match (v.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 12;
          }
        },
        _ => {
          return 13;
        }
      }
    },
    _ => {
      return 14;
    }
  }

  let src2 = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
  let rt2 = roundtrip_module(src2);
  if (rt2.funcs.len() != 2) {
    return 20;
  }
  if (rt2.funcs[0].name != "add") {
    return 21;
  }
  if (rt2.funcs[0].params.len() != 2) {
    return 22;
  }
  if (rt2.funcs[0].params[0].type_name != "i32") {
    return 23;
  }
  if (rt2.funcs[1].name != "main") {
    return 24;
  }

  let src3 = "let x = 5; if (x < 10) { x = x + 1; } else { x = 0; } return x;";
  let rt3 = roundtrip_module(src3);
  if (rt3.top_stmts.len() != 3) {
    return 30;
  }
  match (rt3.top_stmts[1]) {
    ast.StmtIf(ifs) => {
      if (ifs.then_body.len() != 1) {
        return 31;
      }
      if (ifs.else_body.len() != 1) {
        return 32;
      }
    },
    _ => {
      return 33;
    }
  }

  let src4 = "let a = [3, 5, 7]; let i = 0; let s = 0; while (i < a.len()) { s = s + a[i]; i = i + 1; } return s;";
  let rt4 = roundtrip_module(src4);
  if (rt4.top_stmts.len() != 5) {
    return 40;
  }
  match (rt4.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprArray(a) => {
          if (a.elements.len() != 3) {
            return 41;
          }
        },
        _ => {
          return 42;
        }
      }
    },
    _ => {
      return 43;
    }
  }
  match (rt4.top_stmts[3]) {
    ast.StmtWhile(w) => {
      if (w.body.len() != 2) {
        return 44;
      }
    },
    _ => {
      return 45;
    }
  }

  return 0;
}

function check_string_and_slice_literals(): i32 {
  let src5 = "let s = \"hello\\nworld\"; return 0;";
  let rt5 = roundtrip_module(src5);
  match (rt5.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprString(_) => {},
        _ => {
          return 50;
        }
      }
    },
    _ => {
      return 51;
    }
  }

  let src6 = "let s = \"hello\"; let t = s[1:4]; return 0;";
  let rt6 = roundtrip_module(src6);
  match (rt6.top_stmts[1]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprSlice(_) => {},
        _ => {
          return 60;
        }
      }
    },
    _ => {
      return 61;
    }
  }

  let srcOB = "function f(s: string): string { return s[1:] + s[:3] + s[:] + s[1:3]; }";
  let outOB = printer.print_module(parser.parse_module(lexer.tokenize(srcOB)));
  if (!util.contains(outOB, "s[1:]")) {
    return 62;
  }
  if (!util.contains(outOB, "s[:3]")) {
    return 63;
  }
  if (!util.contains(outOB, "s[:]")) {
    return 64;
  }
  if (!util.contains(outOB, "s[1:3]")) {
    return 65;
  }
  if (util.contains(outOB, "s[1:0]")) {
    return 66;
  }
  if (util.contains(outOB, "s[0:")) {
    return 67;
  }

  return 0;
}

function check_structs_and_aliases(): i32 {
  let src7: string = "struct Point { x: i32, y: i32 } function main(): i32 { let p = Point { x: 3, y: 4 }; return p.x; }";
  let rt7 = roundtrip_module(src7);
  if (rt7.structs.len() != 1) {
    return 70;
  }
  if (rt7.structs[0].name != "Point") {
    return 71;
  }
  if (rt7.structs[0].fields.len() != 2) {
    return 72;
  }
  if (rt7.funcs.len() != 1) {
    return 73;
  }

  let src8 = "struct Circle { r: i32 } struct Square { s: i32 } type Shape = Circle | Square; function main(): i32 { return 0; }";
  let rt8 = roundtrip_module(src8);
  if (rt8.aliases.len() != 1) {
    return 80;
  }
  if (rt8.aliases[0].name != "Shape") {
    return 81;
  }
  if (rt8.aliases[0].variants.len() != 2) {
    return 82;
  }
  let src8g = "struct Leaf[T] { v: T } struct Lit { v: i32 } pub type Tree[T, U] = Leaf[T] | Lit | Leaf[Leaf[U]]; function main(): i32 { return 0; }";
  let rt8g = roundtrip_verbatim(src8g);
  if (rt8g.aliases.len() != 1 || rt8g.aliases[0].type_params.len() != 2 || rt8g.aliases[0].type_params[1] != "U") {
    return 83;
  }
  if (rt8g.aliases[0].variant_args.len() != 3 || rt8g.aliases[0].variant_args[0] != "T" || rt8g.aliases[0].variant_args[1] != "" || rt8g.aliases[0].variant_args[2] != "Leaf[U]") {
    return 84;
  }

  return 0;
}

function check_match_statements(): i32 {
  let src9 = "let x = 0; match (x) { Foo(f) => { return 1; }, _ => { return 0; } }";
  let rt9 = roundtrip_module(src9);
  if (rt9.top_stmts.len() != 2) {
    return 90;
  }
  match (rt9.top_stmts[1]) {
    ast.StmtMatch(m) => {
      if (m.arms.len() != 2) {
        return 91;
      }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Foo") {
            return 92;
          }
          if (pv.binding != "f") {
            return 93;
          }
        },
        _ => {
          return 94;
        }
      }
    },
    _ => {
      return 95;
    }
  }

  return 0;
}

function check_annotations_and_receivers(): i32 {
  let srcA = "let n: i32 = 7; let sh: Shape = c; return n;";
  let rtA = roundtrip_module(srcA);
  match (rtA.top_stmts[0]) {
    ast.StmtVar(v) => {
      if (v.type_name != "i32") {
        return 100;
      }
    },
    _ => {
      return 101;
    }
  }
  match (rtA.top_stmts[1]) {
    ast.StmtVar(v) => {
      if (v.type_name != "Shape") {
        return 102;
      }
    },
    _ => {
      return 103;
    }
  }

  let srcB = "function (p: Par) advance(): Par { return p; } function main(): i32 { return 0; }";
  let rtB = roundtrip_module(srcB);
  if (rtB.funcs.len() != 2) {
    return 110;
  }
  if (rtB.funcs[0].name != "advance") {
    return 111;
  }
  if (rtB.funcs[0].receiver_name != "p") {
    return 112;
  }
  if (rtB.funcs[0].receiver_type != "Par") {
    return 113;
  }
  if (rtB.funcs[1].receiver_name != "") {
    return 114;
  }

  return 0;
}

function check_imports(): i32 {
  let srcC = "import \"./lexer\"; import \"./parser\"; function main(): i32 { return 0; }";
  let rtC = roundtrip_module(srcC);
  if (rtC.imports.len() != 2) {
    return 120;
  }
  if (rtC.imports[0].path != "./lexer") {
    return 121;
  }
  if (rtC.imports[1].path != "./parser") {
    return 122;
  }
  if (rtC.funcs.len() != 1) {
    return 123;
  }

  return 0;
}

function check_loops_and_tuples(): i32 {
  let srcD = "for n in [1, 2, 3] { if (n == 2) { break; } if (n == 1) { continue; } }";
  let rtD = roundtrip_module(srcD);
  if (rtD.top_stmts.len() != 1) {
    return 130;
  }
  match (rtD.top_stmts[0]) {
    ast.StmtFor(f) => {
      if (f.var_name != "n") {
        return 131;
      }
      if (f.body.len() != 2) {
        return 132;
      }
      match (f.body[0]) {
        ast.StmtIf(ifs) => {
          match (ifs.then_body[0]) {
            ast.StmtBreak(_) => {},
            _ => {
              return 133;
            }
          }
        },
        _ => {
          return 134;
        }
      }
      match (f.body[1]) {
        ast.StmtIf(ifs) => {
          match (ifs.then_body[0]) {
            ast.StmtContinue(_) => {},
            _ => {
              return 135;
            }
          }
        },
        _ => {
          return 136;
        }
      }
    },
    _ => {
      return 137;
    }
  }

  let srcE = "let t = (10, 20, 30); let x = t.0; return x;";
  let rtE = roundtrip_module(srcE);
  if (rtE.top_stmts.len() != 3) {
    return 140;
  }
  match (rtE.top_stmts[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprTuple(t) => {
          if (t.elements.len() != 3) {
            return 141;
          }
        },
        _ => {
          return 142;
        }
      }
    },
    _ => {
      return 143;
    }
  }
  match (rtE.top_stmts[1]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "0") {
            return 144;
          }
        },
        _ => {
          return 145;
        }
      }
    },
    _ => {
      return 146;
    }
  }

  return 0;
}

function check_lambdas(): i32 {
  let srcF = "function main(): i32 { let f = (x: i32): i32 => { return x + 1; }; return f(41); }";
  let rtF = roundtrip_module(srcF);
  if (rtF.funcs.len() != 1) {
    return 150;
  }
  if (rtF.funcs[0].body.len() != 2) {
    return 151;
  }
  match (rtF.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "f") {
        return 152;
      }
      match (v.init) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 1) {
            return 153;
          }
          if (lm.params[0].name != "x") {
            return 154;
          }
          if (lm.params[0].type_name != "i32") {
            return 155;
          }
          if (lm.ret_type != "i32") {
            return 156;
          }
          if (lm.body.len() != 1) {
            return 157;
          }
        },
        _ => {
          return 158;
        }
      }
    },
    _ => {
      return 159;
    }
  }

  let srcG = "function main(): i32 { return (): i32 => { return 7; }(); }";
  let rtG = roundtrip_module(srcG);
  match (rtG.funcs[0].body[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprCall(cc) => {
          match (cc.callee) {
            ast.ExprLambda(_) => {},
            _ => {
              return 161;
            }
          }
        },
        _ => {
          return 162;
        }
      }
    },
    _ => {
      return 163;
    }
  }

  let srcR = "function main(): i32 { let g = (): (string, i32) => { return (\"ab\", 7); }; let h = (p: i32): (i32) => i32 => (q: i32) => p + q; return 0; }";
  let pfR = parser.parse_module_verbatim(lexer.tokenize(srcR));
  let outR = printer.format_module(pfR.pmod, pfR.ptraits, pfR.pimpls, pfR.pflines, [], []);
  if (!util.contains(outR, "let g = (): (string, i32) => (\"ab\", 7);")) {
    return 371;
  }
  if (!util.contains(outR, "let h = (p: i32): ((i32) => i32) => (q: i32) => p + q;")) {
    return 372;
  }
  let pfR2 = parser.parse_module_verbatim(lexer.tokenize(outR));
  if (printer.format_module(pfR2.pmod, pfR2.ptraits, pfR2.pimpls, pfR2.pflines, [], []) != outR) {
    return 373;
  }
  match (pfR2.pmod.funcs[0].body[0]) {
    ast.StmtVar(vr) => {
      match (vr.init) {
        ast.ExprLambda(lr) => {
          if (lr.ret_type != "(string, i32)") {
            return 374;
          }
        },
        _ => {
          return 375;
        }
      }
    },
    _ => {
      return 376;
    }
  }

  return 0;
}

function check_qualified_names_and_externs(): i32 {
  let srcH = "function main(): i32 { return parser.parse_module(42); }";
  let rtH = roundtrip_module(srcH);
  match (rtH.funcs[0].body[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprCall(cc) => {
          match (cc.callee) {
            ast.ExprFieldAccess(fa) => {
              if (fa.field != "parse_module") {
                return 171;
              }
              match (fa.obj) {
                ast.ExprIdent(id) => {
                  if (id.name != "parser") {
                    return 172;
                  }
                },
                _ => {
                  return 173;
                }
              }
            },
            _ => {
              return 174;
            }
          }
        },
        _ => {
          return 175;
        }
      }
    },
    _ => {
      return 176;
    }
  }

  let srcI = "@import(\"wasi:random/random@0.2.0\", \"get-random-u64\")\nfunction random_u64(): u64; function main(): i32 { return 0; }";
  let modI = parser.parse_module(lexer.tokenize(srcI));
  if (modI.funcs.len() != 2) {
    return 180;
  }
  if (modI.funcs[0].name != "random_u64") {
    return 181;
  }
  if (modI.funcs[0].import_iface != "wasi:random/random@0.2.0") {
    return 182;
  }
  if (modI.funcs[0].import_wit != "get-random-u64") {
    return 183;
  }
  if (modI.funcs[0].body.len() != 0) {
    return 184;
  }
  if (modI.funcs[1].import_iface.len() != 0) {
    return 185;
  }
  let rtI = roundtrip_module(srcI);
  if (rtI.funcs.len() != 2) {
    return 186;
  }
  if (rtI.funcs[0].import_iface != "wasi:random/random@0.2.0") {
    return 187;
  }
  if (rtI.funcs[0].import_wit != "get-random-u64") {
    return 188;
  }
  if (rtI.funcs[0].body.len() != 0) {
    return 189;
  }

  return 0;
}

function check_declaration_modifiers(): i32 {
  let srcM = "fip function pure_add(a: i32, b: i32): i32 { return a + b; } function main(): i32 { return pure_add(1, 2); }";
  let rtM = roundtrip_module(srcM);
  if (rtM.funcs.len() != 2) {
    return 190;
  }
  if (rtM.funcs[0].name != "pure_add") {
    return 191;
  }
  if (!rtM.funcs[0].fip) {
    return 192;
  }
  if (rtM.funcs[0].fbip || rtM.funcs[0].fip_allowance != 0) {
    return 164;
  }
  if (rtM.funcs[1].fip) {
    return 193;
  }

  let srcFB = "fbip function keep(a: i32): i32 { return a; } function main(): i32 { return keep(1); }";
  let rtFB = roundtrip_module(srcFB);
  if (rtFB.funcs.len() != 2) {
    return 165;
  }
  if (!rtFB.funcs[0].fbip || rtFB.funcs[0].fip) {
    return 166;
  }
  if (rtFB.funcs[0].fip_allowance != 0) {
    return 167;
  }

  let srcFG = "fbip(2) function graded(a: i32): i32 { return a; } fip(1) function g1(a: i32): i32 { return a; } function main(): i32 { return graded(1) + g1(2); }";
  let rtFG = roundtrip_module(srcFG);
  if (rtFG.funcs.len() != 3) {
    return 168;
  }
  if (!rtFG.funcs[0].fbip || rtFG.funcs[0].fip_allowance != 2) {
    return 169;
  }
  if (!rtFG.funcs[1].fip || rtFG.funcs[1].fbip || rtFG.funcs[1].fip_allowance != 1) {
    return 170;
  }

  let srcMC: string = "@must_consume\nstruct Res { code: i32 } function main(): i32 { let r: Res = Res { code: 7 }; return r.code; }";
  let rtMC = roundtrip_module(srcMC);
  if (rtMC.structs.len() != 1) {
    return 194;
  }
  if (!rtMC.structs[0].must_consume) {
    return 195;
  }

  let srcDrv: string = "@derive(Eq)\nstruct Pt { x: i32 } function main(): i32 { let p: Pt = Pt { x: 1 }; return p.x; }";
  let modDrv = parser.parse_module(lexer.tokenize(srcDrv));
  let rtDrv = roundtrip_module(srcDrv);
  if (rtDrv.structs.len() != 1) {
    return 196;
  }
  if (rtDrv.structs[0].derives.len() != 1) {
    return 197;
  }
  if (rtDrv.structs[0].derives[0] != "Eq") {
    return 198;
  }
  if (rtDrv.funcs.len() != modDrv.funcs.len()) {
    return 199;
  }

  let srcJ = "async function work(): i32 { return 7; } function main(): i32 { return work(); }";
  let modJ = parser.parse_module(lexer.tokenize(srcJ));
  if (modJ.funcs.len() != 2) {
    return 200;
  }
  if (!modJ.funcs[0].async) {
    return 201;
  }
  if (modJ.funcs[1].async) {
    return 202;
  }
  let rtJ = roundtrip_module(srcJ);
  if (rtJ.funcs.len() != 2) {
    return 203;
  }
  if (!rtJ.funcs[0].async) {
    return 204;
  }
  if (rtJ.funcs[1].async) {
    return 205;
  }
  let rtK = roundtrip_module("pub async function w(): i32 { return 1; }");
  if (rtK.funcs.len() != 1) {
    return 206;
  }
  if (!rtK.funcs[0].async) {
    return 207;
  }
  let rtL = roundtrip_module("function main(): i32 { let async: i32 = 3; return async + 4; }");
  if (rtL.funcs.len() != 1) {
    return 208;
  }
  if (rtL.funcs[0].async) {
    return 209;
  }

  return 0;
}

function check_enums(): i32 {
  let srcEnum = "@derive(Eq)\nenum Color { Red, Green(i32) } function main(): i32 { let c: Color = Red; return 0; }";
  let modEnum = parser.parse_module(lexer.tokenize(srcEnum));
  let rtEnum = roundtrip_module(srcEnum);
  if (rtEnum.enums.len() != 1) {
    return 210;
  }
  if (rtEnum.enums[0].name != "Color") {
    return 211;
  }
  if (rtEnum.enums[0].variant_names.len() != 2) {
    return 212;
  }
  if (rtEnum.enums[0].variant_names[0] != "Red") {
    return 213;
  }
  if (rtEnum.enums[0].variant_names[1] != "Green") {
    return 214;
  }
  let rgi = printer.variant_decl_index(rtEnum.structs, "Color", "Green");
  if (rgi < 0) {
    return 215;
  }
  if (rtEnum.structs[rgi].fields.len() != 1) {
    return 216;
  }
  if (rtEnum.structs[rgi].fields[0].type_name != "i32") {
    return 217;
  }
  let rri = printer.variant_decl_index(rtEnum.structs, "Color", "Red");
  if (rri < 0) {
    return 218;
  }
  if (rtEnum.structs[rri].fields.len() != 0) {
    return 219;
  }
  let esi = 0;
  while (esi < rtEnum.structs.len()) {
    if (rtEnum.structs[esi].enum_owner.len() == 0) {
      return 220;
    }
    esi += 1;
  }
  if (rtEnum.structs[rgi].derives.len() != 1) {
    return 221;
  }
  if (rtEnum.structs[rgi].derives[0] != "Eq") {
    return 222;
  }
  if (rtEnum.funcs.len() != modEnum.funcs.len()) {
    return 223;
  }

  let srcEG = "@must_consume\nenum Slot[T] { Full(T), Empty } function main(): i32 { return 0; }";
  let modEG = parser.parse_module(lexer.tokenize(srcEG));
  let rtEG = roundtrip_module(srcEG);
  if (rtEG.enums.len() != 1) {
    return 224;
  }
  if (!rtEG.enums[0].must_consume) {
    return 225;
  }
  if (rtEG.enums[0].type_params.len() != 1) {
    return 226;
  }
  if (rtEG.enums[0].type_params[0] != modEG.enums[0].type_params[0]) {
    return 227;
  }
  let fgi = printer.variant_decl_index(rtEG.structs, "Slot", "Full");
  if (fgi < 0) {
    return 228;
  }
  if (rtEG.structs[fgi].fields[0].type_name != modEG.enums[0].type_params[0]) {
    return 229;
  }
  if (!util.contains(printer.print_module(modEG), "enum Slot[T] { Full(T), Empty }")) {
    return 274;
  }

  let srcEM = "enum Pair { Two(i32, string), Neither } function main(): i32 { return 0; }";
  let rtEM = roundtrip_module(srcEM);
  let tpi = printer.variant_decl_index(rtEM.structs, "Pair", "Two");
  if (tpi < 0) {
    return 230;
  }
  if (rtEM.structs[tpi].fields.len() != 2) {
    return 231;
  }
  if (rtEM.structs[tpi].fields[0].type_name != "i32") {
    return 232;
  }
  if (rtEM.structs[tpi].fields[1].type_name != "string") {
    return 233;
  }

  let srcER = "enum Shape { Rect { w: i32, h: string }, Unit } function main(): i32 { return 0; }";
  let rtER = roundtrip_module(srcER);
  let rcvi = printer.variant_decl_index(rtER.structs, "Shape", "Rect");
  if (rcvi < 0) {
    return 234;
  }
  if (rtER.structs[rcvi].variant_field_names.len() != 2) {
    return 235;
  }
  if (rtER.structs[rcvi].variant_field_names[0] != "w") {
    return 236;
  }
  if (rtER.structs[rcvi].variant_field_names[1] != "h") {
    return 237;
  }
  if (rtER.structs[rcvi].fields.len() != 2) {
    return 238;
  }
  if (rtER.structs[rcvi].fields[0].name != "__ev") {
    return 239;
  }
  if (rtER.structs[rcvi].fields[1].name != "__ev1") {
    return 240;
  }
  if (rtER.structs[rcvi].fields[1].type_name != "string") {
    return 241;
  }
  let uri = printer.variant_decl_index(rtER.structs, "Shape", "Unit");
  if (uri < 0) {
    return 242;
  }
  if (rtER.structs[uri].variant_field_names.len() != 0) {
    return 243;
  }

  let srcPB = "enum Pair { Two(i32, i32) } function f(p: Pair): i32 { match (p) { Two(a, b) => { return a + b; }, } return 0; } function main(): i32 { return 0; }";
  let rtPB = roundtrip_module(srcPB);
  if (rtPB.funcs.len() < 1) {
    return 244;
  }
  match (rtPB.funcs[0].body[0]) {
    ast.StmtMatch(m) => {
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.binding != "a") {
            return 245;
          }
          if (pv.extra_bindings.len() != 1) {
            return 246;
          }
          if (pv.extra_bindings[0] != "b") {
            return 247;
          }
        },
        _ => {
          return 248;
        }
      }
    },
    _ => {
      return 249;
    }
  }

  return 0;
}

function check_record_patterns(): i32 {
  let src = "function f(s: Shape): i32 { match (s) { Rect { h: hh, .. } => { return hh; }, Circle { .. } => { return 0; } } return 0; } function main(): i32 { return 0; }";
  let rt = roundtrip_module(src);
  if (rt.funcs.len() < 1) {
    return 377;
  }
  if let ast.StmtMatch(m) = rt.funcs[0].body[0] {
    if (m.arms.len() != 2) {
      return 378;
    }
    if let ast.PatVariant(rect) = m.arms[0].pattern {
      if (rect.field_names.len() != 1 || rect.field_names[0] != "h" || rect.binding != "hh" || !rect.rest_written) {
        return 379;
      }
    } else {
      return 380;
    }
    if let ast.PatVariant(circle) = m.arms[1].pattern {
      if (circle.field_names.len() != 0 || !circle.rest_written) {
        return 381;
      }
    } else {
      return 382;
    }
    return 0;
  }
  return 383;
}

function check_const_and_for_sugar(): i32 {
  let srcConst = "const LIMIT: i32 = 41; function main(): i32 { return LIMIT + 1; }";
  let rtConst = roundtrip_module(srcConst);
  if (rtConst.funcs.len() != 2) {
    return 250;
  }
  let limit_i: i32 = -1;
  let ci = 0;
  while (ci < rtConst.funcs.len()) {
    if (rtConst.funcs[ci].name == "LIMIT") {
      limit_i = ci;
    }
    ci += 1;
  }
  if (limit_i < 0) {
    return 251;
  }
  if (!rtConst.funcs[limit_i].is_const) {
    return 252;
  }
  if (rtConst.funcs[limit_i].ret_type != "i32") {
    return 253;
  }
  let rtFn = roundtrip_module("function LIMIT(): i32 { return 41; }");
  if (rtFn.funcs.len() != 1) {
    return 254;
  }
  if (rtFn.funcs[0].is_const) {
    return 255;
  }

  let srcCFor = "function main(): i32 { let s: i32 = 0; for (let i: i32 = 0; i < 3; i = i + 1) { s = s + i; } return s; }";
  let outCFor = printer.print_module(parser.parse_module(lexer.tokenize(srcCFor)));
  if (!util.contains(outCFor, "for (let i: i32 = 0; i < 3; i = i + 1) {")) {
    return 260;
  }
  if (util.contains(outCFor, "__forc_")) {
    return 261;
  }
  let rtCFor = roundtrip_module(srcCFor);
  if (rtCFor.funcs.len() != 1) {
    return 262;
  }
  match (rtCFor.funcs[0].body[1]) {
    ast.StmtIf(cf) => {
      match (printer.as_c_for(cf)) {
        Some(_) => {},
        None => {
          return 263;
        }
      }
    },
    _ => {
      return 264;
    }
  }

  let outBare: string = printer.print_module(parser.parse_module(lexer.tokenize(
    "function main(): i32 { let i: i32 = 0; for (; i < 3; ) { i = i + 1; } return i; }",
  )));
  if (!util.contains(outBare, "for (; i < 3; ) {")) {
    return 265;
  }

  let outRange: string = printer.print_module(parser.parse_module(lexer.tokenize(
    "function main(): i32 { let t: i32 = 0; for i in 0..4 { t = t + i; } for j in 0..=4 { t = t + j; } return t; }",
  )));
  if (!util.contains(outRange, "for i in 0..4 {")) {
    return 266;
  }
  if (!util.contains(outRange, "for j in 0..=4 {")) {
    return 267;
  }
  if (util.contains(outRange, "__range")) {
    return 268;
  }

  let outMap: string = printer.print_module(parser.parse_module(lexer.tokenize(
    "function f(m: map[string, i32]): i32 { let t: i32 = 0; for (k, v) in m { t = t + v; } return t; }",
  )));
  if (!util.contains(outMap, "for (k, v) in m {")) {
    return 269;
  }

  let srcLabels = "function main(): i32 { let t: i32 = 0; outer: while (t < 10) { inner: for (let i: i32 = 0; i < 3; i = i + 1) { if (i == 2) { continue outer; } break inner; } t = t + 1; } return t; }";
  let outLabels = printer.print_module(parser.parse_module(lexer.tokenize(srcLabels)));
  if (!util.contains(outLabels, "outer: while (t < 10) {")) {
    return 270;
  }
  if (!util.contains(outLabels, "inner: for (let i: i32 = 0; i < 3; i = i + 1) {")) {
    return 271;
  }
  if (!util.contains(outLabels, "continue outer;")) {
    return 272;
  }
  if (!util.contains(outLabels, "break inner;")) {
    return 273;
  }

  return 0;
}

function check_visibility_and_destructuring(): i32 {
  let srcVis = "pub struct A { x: i32 } struct B { y: i32 } pub enum C { P } enum D { Q } pub type E = A | B; type F = A | B; function main(): i32 { return 0; }";
  let rtVis = roundtrip_module(srcVis);
  if (!rtVis.structs[struct_index(rtVis.structs, "A")].is_pub) {
    return 280;
  }
  if (rtVis.structs[struct_index(rtVis.structs, "B")].is_pub) {
    return 281;
  }
  if (!rtVis.enums[printer.enum_index(rtVis.enums, "C")].is_pub) {
    return 282;
  }
  if (rtVis.enums[printer.enum_index(rtVis.enums, "D")].is_pub) {
    return 283;
  }
  if (rtVis.aliases.len() != 2) {
    return 284;
  }
  if (!rtVis.aliases[0].is_pub) {
    return 285;
  }
  if (rtVis.aliases[1].is_pub) {
    return 286;
  }

  let srcTd = "function pair(): (i32, i32) { return (1, 2); } function main(): i32 { let (a, b) = pair(); return a + b; }";
  let rtTd = roundtrip_module(srcTd);
  let mti = func_index(rtTd.funcs, "main");
  if (mti < 0) {
    return 287;
  }
  if (rtTd.funcs[mti].body.len() != 2) {
    return 288;
  }
  match (rtTd.funcs[mti].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "a,b") {
        return 289;
      }
      if (v.type_name.len() != 0) {
        return 290;
      }
    },
    _ => {
      return 291;
    }
  }
  let srcSd: string = "struct P { x: i32, y: i32 } function main(): i32 { let P { x, y: bb } = P { x: 1, y: 2 }; return x + bb; }";
  let rtSd = roundtrip_module(srcSd);
  let msi = func_index(rtSd.funcs, "main");
  if (msi < 0) {
    return 292;
  }
  match (rtSd.funcs[msi].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "x,bb") {
        return 293;
      }
      if (v.type_name != "@sd:P:x,y") {
        return 294;
      }
    },
    _ => {
      return 295;
    }
  }

  let srcMt = "enum Opt[T] { Some(T), None } pub function (o: Opt[T]) map[U](f: (T) => U): Opt[U] { return None; } function main(): i32 { return 0; }";
  let rtMt = roundtrip_module(srcMt);
  let mmi = func_index(rtMt.funcs, "map");
  if (mmi < 0) {
    return 296;
  }
  if (rtMt.funcs[mmi].receiver_name != "o") {
    return 297;
  }
  if (rtMt.funcs[mmi].all_type_params.len() != 1) {
    return 298;
  }

  return 0;
}

function check_traits_and_impls(): i32 {
  let srcTr = "pub trait Greet[T]: Display { function hi(self: Self, x: T): string; function loud(self: Self, x: T): string { return self.hi(x); } } function main(): i32 { return 0; }";
  let pfTr = parser.parse_module_verbatim(lexer.tokenize(srcTr));
  let outTr = printer.format_module(pfTr.pmod, pfTr.ptraits, pfTr.pimpls, pfTr.pflines, [], []);
  let rtTr = parser.parse_module_verbatim(lexer.tokenize(outTr));
  if (rtTr.ptraits.len() != 1) {
    return 299;
  }
  if (rtTr.ptraits[0].name != "Greet") {
    return 300;
  }
  if (!rtTr.ptraits[0].is_pub) {
    return 301;
  }
  if (rtTr.ptraits[0].type_params.len() != 1) {
    return 302;
  }
  if (rtTr.ptraits[0].type_params[0] != "T") {
    return 303;
  }
  if (rtTr.ptraits[0].supertraits.len() != 1) {
    return 304;
  }
  if (rtTr.ptraits[0].supertraits[0] != "Display") {
    return 305;
  }
  if (rtTr.ptraits[0].methods.len() != 2) {
    return 306;
  }
  if (rtTr.ptraits[0].methods[0].name != "hi") {
    return 307;
  }
  if (rtTr.ptraits[0].methods[0].body.len() != 0) {
    return 308;
  }
  if (rtTr.ptraits[0].methods[1].name != "loud") {
    return 309;
  }
  if (rtTr.ptraits[0].methods[1].body.len() == 0) {
    return 310;
  }
  let pfQ: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
    "import \"core/cmp\"; pub trait Sortable: cmp.Ord {} function main(): i32 { return 0; }",
  ));
  if (pfQ.ptraits.len() != 1) {
    return 311;
  }
  if (pfQ.ptraits[0].supertraits.len() != 1) {
    return 312;
  }
  if (pfQ.ptraits[0].supertraits[0] != "cmp.Ord") {
    return 313;
  }
  if (!util.contains(printer.format_module(pfQ.pmod, pfQ.ptraits, pfQ.pimpls, pfQ.pflines, [], []), "pub trait Sortable: cmp.Ord {}")) {
    return 314;
  }

  let srcIm = "trait Display { function to_string(self: Self): string; } impl Display for i32 {} impl Display for boolean { function to_string(self: Self): string { return \"t\"; } } function main(): i32 { return 0; }";
  let pfIm = parser.parse_module_verbatim(lexer.tokenize(srcIm));
  if (pfIm.pimpls.len() != 2) {
    return 315;
  }
  if (pfIm.pimpls[0].trait_ref != "Display") {
    return 316;
  }
  if (pfIm.pimpls[0].type_ref != "i32") {
    return 317;
  }
  if (pfIm.pimpls[0].methods.len() != 0) {
    return 318;
  }
  if (pfIm.pimpls[1].methods.len() != 1) {
    return 319;
  }
  if (func_index(pfIm.pmod.funcs, "to_string") >= 0) {
    return 320;
  }
  let outIm = printer.format_module(pfIm.pmod, pfIm.ptraits, pfIm.pimpls, pfIm.pflines, [], []);
  if (!util.contains(outIm, "impl Display for i32 {}")) {
    return 321;
  }
  if (!util.contains(outIm, "function to_string(self: Self): string {")) {
    return 322;
  }
  let rtIm = parser.parse_module_verbatim(lexer.tokenize(outIm));
  if (rtIm.pimpls.len() != 2) {
    return 323;
  }

  let pfPa: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
    "import \"core/cmp\"; struct Box[T] { item: T } impl[T: cmp.Eq] cmp.Eq for Box[T] { function eq(self: Self, other: Self): boolean { return true; } } function main(): i32 { return 0; }",
  ));
  if (pfPa.pimpls.len() != 1) {
    return 328;
  }
  let outPa = printer.format_module(pfPa.pmod, pfPa.ptraits, pfPa.pimpls, pfPa.pflines, [], []);
  if (!util.contains(outPa, "impl[T: cmp.Eq] cmp.Eq for Box[T] {")) {
    return 329;
  }
  if (!util.contains(outPa, "function eq(self: Self, other: Self): boolean {")) {
    return 330;
  }

  let pfOor: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
    "function main(): i32 { let x: f64 = 1e309; return 0; }",
  ));
  let outOor = printer.format_module(pfOor.pmod, pfOor.ptraits, pfOor.pimpls, pfOor.pflines, [], []);
  if (!util.contains(outOor, "let x: f64 = 1e309;")) {
    return 331;
  }

  if (printer.quote_string("héllo\nwörld") != "\"héllo\\nwörld\"") {
    return 340;
  }
  if (printer.escape_fstring_lit("pré{x}é") != "pré{{x}}é") {
    return 341;
  }

  if (printer.quote_string("a\x00b\x1fc\x7fd") != "\"a\\x00b\\x1fc\\x7fd\"") {
    return 342;
  }
  if (printer.escape_fstring_lit("a\x00b") != "a\\x00b") {
    return 343;
  }
  if (printer.quote_string("\x07é😀") != "\"\\x07é😀\"") {
    return 347;
  }
  if (printer.escape_fstring_lit("é{😀") != "é{{😀") {
    return 348;
  }
  let srcMb = "function main(): i32 { let s: string = \"héllo\"; let f: string = f\"pré {s}\"; return 0; }";
  let pfMb = parser.parse_module_verbatim(lexer.tokenize(srcMb));
  let outMb = printer.format_module(pfMb.pmod, pfMb.ptraits, pfMb.pimpls, pfMb.pflines, [], []);
  let rtMb = parser.parse_module(lexer.tokenize(outMb));
  if (rtMb.funcs.len() != 1) {
    return 342;
  }
  if (!util.contains(outMb, "\"héllo\"")) {
    return 343;
  }
  if (!util.contains(outMb, "f\"pré {s}\"")) {
    return 344;
  }
  let dl = printer.diff_split_lines("é\nü");
  if (dl.len() != 2) {
    return 345;
  }
  if (dl[0] != "é\n" || dl[1] != "ü") {
    return 346;
  }

  let dcode = diff_selftest();
  if (dcode != 0) {
    return dcode;
  }

  return 0;
}

function struct_index(structs: parser.StructDecl[], name: string): i32 {
  let i = 0;
  while (i < structs.len()) {
    if (structs[i].name == name && structs[i].enum_owner.len() == 0) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function func_index(funcs: parser.FuncDecl[], name: string): i32 {
  let i = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function diff_replay(sc: printer.DiffScript, keep: i32): string {
  let out = "";
  let i = 0;
  while (i < sc.kinds.len()) {
    if (sc.kinds[i] == 0 || sc.kinds[i] == keep) {
      out += sc.lines[i];
    }
    i += 1;
  }
  return out;
}

function diff_edits(sc: printer.DiffScript): i32 {
  let n = 0;
  let i = 0;
  while (i < sc.kinds.len()) {
    if (sc.kinds[i] != 0) {
      n += 1;
    }
    i += 1;
  }
  return n;
}

function diff_lcs_edits(a: string[], b: string[]): i32 {
  let m = a.len();
  let n = b.len();
  let prev: i32[] = [];
  let cur: i32[] = [];
  let z = 0;
  while (z <= n) {
    prev = prev.append(0);
    cur = cur.append(0);
    z += 1;
  }
  let i = m - 1;
  while (i >= 0) {
    prev = cur;
    let j = n - 1;
    while (j >= 0) {
      if (a[i] == b[j]) {
        cur = cur.with(j, prev[j + 1] + 1);
      } else if (prev[j] >= cur[j + 1]) {
        cur = cur.with(j, prev[j]);
      } else {
        cur = cur.with(j, cur[j + 1]);
      }
      j -= 1;
    }
    i -= 1;
  }
  return m + n - 2 * cur[0];
}

function diff_rand(s: i64): i64 {
  return s * 48271i64 % 2147483647i64;
}

function diff_lines_from(seed: i64, n: i32, alphabet: i32): string[] {
  let vocab: string[] = ["a\n", "b\n", "c\n", "d\n", "e\n"];
  let out: string[] = [];
  let s = seed;
  let i = 0;
  while (i < n) {
    s = diff_rand(s);
    out = out.append(vocab[(s % (alphabet as i64)) as i32]);
    i += 1;
  }
  return out;
}

function diff_selftest(): i32 {
  let s: i64 = 12345i64;
  let iter = 0;
  while (iter < 300) {
    s = diff_rand(s);
    let alphabet = 2 + (s % 4i64) as i32;
    s = diff_rand(s);
    let na = (s % 14i64) as i32;
    s = diff_rand(s);
    let nb = (s % 14i64) as i32;
    s = diff_rand(s);
    let a = diff_lines_from(s, na, alphabet);
    s = diff_rand(s);
    let b = diff_lines_from(s, nb, alphabet);
    let sc = printer.diff_edit_script(a, b);
    if (diff_replay(sc, 1) != util.str_join_chunks(a)) {
      return 350;
    }
    if (diff_replay(sc, 2) != util.str_join_chunks(b)) {
      return 351;
    }
    if (diff_edits(sc) != diff_lcs_edits(a, b)) {
      return 352;
    }
    iter += 1;
  }

  let la = diff_lines_from(777i64, 400, 3);
  let lb = diff_lines_from(999i64, 400, 3);
  let lsc = printer.diff_edit_script(la, lb);
  if (diff_replay(lsc, 1) != util.str_join_chunks(la)) {
    return 353;
  }
  if (diff_replay(lsc, 2) != util.str_join_chunks(lb)) {
    return 354;
  }
  if (diff_edits(lsc) != diff_lcs_edits(la, lb)) {
    return 355;
  }

  let pa = printer.diff_split_lines("one\ntwo\nthree\nfour\nfive\n");
  let pb = printer.diff_split_lines("one\ntwo\nTHREE\nfour\nfive\n");
  let psc = printer.diff_edit_script(pa, pb);
  if (diff_edits(psc) != 2) {
    return 356;
  }
  if (diff_replay(psc, 1) != "one\ntwo\nthree\nfour\nfive\n") {
    return 357;
  }
  if (diff_replay(psc, 2) != "one\ntwo\nTHREE\nfour\nfive\n") {
    return 358;
  }

  let ud = printer.unified_diff("one\ntwo\nthree\nfour\nfive\n", "one\ntwo\nTHREE\nfour\nfive\n", "x.fern", "x.fern");
  if (ud != "--- x.fern\n+++ x.fern\n@@ -1,5 +1,5 @@\n one\n two\n-three\n+THREE\n four\n five\n") {
    return 359;
  }
  if (printer.unified_diff("a\n", "a\n", "x", "y") != "") {
    return 360;
  }
  return 0;
}

function check_checked_casts(): i32 {
  for src in ["let x = value as? u8;", "let x = (value + 1) as? u8;", "let x = (value as i64) as? u32;", "let x = (value as? ByteStream)?;"] {
    let m = parser.parse_module(lexer.tokenize(src));
    let printed = printer.print_module(m);
    if (!util.contains(printed, " as? ")) {
      return 361;
    }
    let again = parser.parse_module(lexer.tokenize(printed));
    if (again.top_stmts.len() != 1 || printer.print_module(again) != printed) {
      return 362;
    }
  }
  return 0;
}
