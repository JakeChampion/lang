import "../ir";
import "../irverify";
import "../irverifystack";
import "../irfipverify";
import "./irverifyprovided";
import "../irverifyrc";
import "../irverifygate";
import "../ssa_lift";
import "../rccertify";
import "../util";

function no_sigs(): irverify.NameIndex {
  return irverify.sig_index([]);
}

function count_problems(ops: ir.Op[], n_params: i32, n_locals: i32): i32 {
  return irverify.verify_fn("f", ops, n_params, n_locals, no_sigs()).len();
}

function first_msg(ops: ir.Op[], n_params: i32, n_locals: i32): string {
  let ps = irverify.verify_fn("f", ops, n_params, n_locals, no_sigs());
  if (ps.len() == 0) {
    return "";
  }
  return irverify.problem_str(ps[0]);
}

function sp_count(ops: ir.Op[]): i32 {
  return irverifystack.verify_stack_fn("f", ops, ir.pops_by_kind()).problems.len();
}

function sp_msg(ops: ir.Op[]): string {
  let r = irverifystack.verify_stack_fn("f", ops, ir.pops_by_kind());
  if (r.problems.len() == 0) {
    return "";
  }
  return irverify.problem_str(r.problems[0]);
}

function sp_bail(ops: ir.Op[]): string {
  return irverifystack.verify_stack_fn("f", ops, ir.pops_by_kind()).bail;
}

function stack_checks(): i32 {
  if (sp_count([ir.op_const_i32(1), ir.op_return()]) != 0) {
    return 70;
  }
  if (sp_count([ir.op_const_i32(1), ir.op_drop()]) != 0) {
    return 71;
  }
  if (sp_count([]) != 0) {
    return 72;
  }

  let dangling: ir.Op[] = [ir.op_const_i32(1)];
  if (sp_count(dangling) != 1) {
    return 73;
  }
  if (!util.contains(sp_msg(dangling), "falls off its end holding 1 operand slot")) {
    return 74;
  }

  let starved: ir.Op[] = [ir.op_bin("add", 0, false), ir.op_return()];
  if (sp_count(starved) != 1) {
    return 75;
  }
  if (!util.contains(sp_msg(starved), "operand stack underflow - needs 2 operand slot(s)")) {
    return 76;
  }
  if (sp_count([ir.op_drop()]) != 1) {
    return 77;
  }

  if (sp_count([ir.op_const_i32(1), ir.op_block(0), ir.op_drop(), ir.op_end(), ir.op_return()]) != 1) {
    return 78;
  }

  let leaky_if: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(2), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
  if (sp_count(leaky_if) != 1) {
    return 80;
  }
  if (!util.contains(sp_msg(leaky_if), "the if opened at op 1 leaves 1 operand slot(s), but it is void")) {
    return 81;
  }

  let leaky_then: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(2), ir.op_else(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
  if (sp_count(leaky_then) != 1) {
    return 82;
  }
  if (!util.contains(sp_msg(leaky_then), "the then-arm leaves 1 operand slot(s)")) {
    return 83;
  }

  let balanced_if: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(2), ir.op_drop(), ir.op_else(), ir.op_const_i32(3), ir.op_drop(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
  if (sp_count(balanced_if) != 0) {
    return 84;
  }
  let wloop: ir.Op[] = [ir.op_block(0), ir.op_loop(0), ir.op_const_i32(1), ir.op_brif(1), ir.op_br(0), ir.op_end(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
  if (sp_count(wloop) != 0) {
    return 85;
  }

  if (sp_count([ir.op_block(0), ir.op_br(0), ir.op_bin("add", 0, false), ir.op_end(), ir.op_const_i32(0), ir.op_return()]) != 0) {
    return 86;
  }
  if (sp_count([ir.op_const_i32(1), ir.op_return(), ir.op_drop()]) != 0) {
    return 87;
  }

  if (sp_count([ir.op_br(0)]) != 1) {
    return 88;
  }
  if (!util.contains(sp_msg([ir.op_br(0)]), "branch to the function body needs 1 operand slot")) {
    return 89;
  }
  if (sp_count([ir.op_const_i32(0), ir.op_br(0)]) != 0) {
    return 90;
  }

  if (sp_count([ir.op_const_i32(0), ir.op_const_i32(0), ir.op_const_i32(0), ir.op_arr_set(32)]) != 0) {
    return 91;
  }
  if (sp_count([ir.op_const_i32(0), ir.op_const_i32(0), ir.op_struct_set(0, 0)]) != 0) {
    return 92;
  }
  if (sp_count([ir.op_const_i32(0), ir.op_const_i32(0), ir.op_store_i32(), ir.op_drop()]) != 0) {
    return 93;
  }
  if (sp_count([ir.op_const_i32(1), ir.op_const_func(0, "f"), ir.op_call_indirect(1), ir.op_return()]) != 0) {
    return 95;
  }
  if (sp_count([ir.op_const_func(0, "f"), ir.op_call_indirect(1), ir.op_return()]) != 1) {
    return 96;
  }

  let loaded: ir.Op[] = [ir.op_const_i32(0), ir.op_load_u16(), ir.op_return()];
  if (sp_bail(loaded).len() != 0 || sp_count(loaded) != 0) {
    return 107;
  }
  let no_address: ir.Op[] = [ir.op_load_u16(), ir.op_return()];
  if (sp_bail(no_address).len() != 0 || sp_count(no_address) != 1) {
    return 108;
  }
  if (!util.contains(sp_msg(no_address), "operand stack underflow - needs 1 operand slot(s), but the enclosing scope holds 0")) {
    return 109;
  }

  let unmodelled: ir.Op[] = [ir.op_store(32)];
  if (sp_bail(unmodelled) != "unmodelled op store") {
    return 100;
  }
  if (sp_count(unmodelled) != 0) {
    return 101;
  }

  if (!util.contains(sp_bail([ir.op_block(1), ir.op_end()]), "non-void block type 1")) {
    return 102;
  }

  if (sp_bail([ir.op_end()]) != "end with no open scope") {
    return 103;
  }
  if (sp_bail([ir.op_block(0), ir.op_else(), ir.op_end()]) != "malformed else") {
    return 104;
  }
  if (sp_bail([ir.op_block(0), ir.op_br(9), ir.op_end()]) != "branch depth has no target") {
    return 105;
  }

  if (sp_bail([ir.op_const_i32(1), ir.op_return()]).len() != 0) {
    return 106;
  }

  let cov = irverifystack.coverage_new();
  cov = irverifystack.coverage_add(cov, "a", "");
  cov = irverifystack.coverage_add(cov, "b", "unmodelled op store");
  cov = irverifystack.coverage_add(cov, "c", "unmodelled op store");
  if (cov.funcs != 3 || cov.modelled != 1) {
    return 110;
  }
  if (cov.skipped_fns.len() != 2 || cov.skipped_fns[0] != "b") {
    return 111;
  }
  if (!util.contains(irverifystack.coverage_str(cov), "modelled 1/3")) {
    return 112;
  }
  if (!util.contains(irverifystack.coverage_str(cov), "skipped 2: unmodelled op store")) {
    return 113;
  }
  return 0;
}

function fip_claim(kw: string, allowance: i32): irfipverify.FipClaim {
  return irfipverify.FipClaim { fn_name: "f", is_fip: kw == "fip", is_fbip: kw == "fbip", allowance: allowance };
}

function fip_problems(kw: string, allowance: i32, ops: ir.Op[]): i32 {
  return irfipverify.verify_fip_fn(fip_claim(kw, allowance), ops).problems.len();
}

function fip_msg(kw: string, allowance: i32, ops: ir.Op[]): string {
  let r = irfipverify.verify_fip_fn(fip_claim(kw, allowance), ops);
  if (r.problems.len() == 0) {
    return "";
  }
  return irverify.problem_str(r.problems[0]);
}

function fip_checks(): i32 {
  let fresh_struct: ir.Op[] = [ir.op_const_i32(1), ir.op_const_i32(2), ir.op_struct_make("P", 2, -1)];
  let paired_struct: ir.Op[] = [ir.op_const_i32(0), ir.op_const_i32(3), ir.op_call_direct("__fern_alloc_reuse", 2)];

  if (fip_problems("fbip", 0, fresh_struct) != 1) {
    return 120;
  }
  if (fip_problems("fbip", 1, fresh_struct) != 0) {
    return 121;
  }
  if (fip_problems("fip", 0, fresh_struct) != 1) {
    return 122;
  }
  if (fip_problems("fip", 1, fresh_struct) != 0) {
    return 123;
  }

  if (fip_problems("", 0, fresh_struct) != 0) {
    return 124;
  }

  if (fip_problems("fbip", 0, paired_struct) != 0) {
    return 125;
  }
  let pr = irfipverify.verify_fip_fn(fip_claim("fbip", 0), paired_struct);
  if (pr.paired != 1 || pr.fresh != 0) {
    return 126;
  }
  if (irfipverify.verify_fip_fn(fip_claim("fbip", 0), [ir.op_call_direct("__fern_rc_dec", 1)]).paired != 0) {
    return 127;
  }

  if (fip_problems("fbip", 0, [ir.op_struct_make("P", 2, -1)]) != 1) {
    return 130;
  }
  if (fip_problems("fbip", 0, [ir.op_tuple_make(2)]) != 1) {
    return 132;
  }
  if (fip_problems("fbip", 0, [ir.op_arr_make(3, 32)]) != 1) {
    return 133;
  }
  if (fip_problems("fbip", 0, [ir.op_opt_make(1)]) != 1) {
    return 134;
  }
  if (fip_problems("fbip", 0, [ir.op_str_concat()]) != 1) {
    return 135;
  }
  if (fip_problems("fbip", 0, [ir.op_alloc()]) != 1) {
    return 136;
  }

  if (fip_problems("fip", 0, [ir.op_const_struct("P", 2, "1,2")]) != 0) {
    return 137;
  }
  if (fip_problems("fip", 0, [ir.op_heap_bump_bytes()]) != 0) {
    return 138;
  }
  if (fip_problems("fip", 0, [ir.op_struct_get(0, 0), ir.op_const_i32(1)]) != 0) {
    return 139;
  }

  let mixed: ir.Op[] = [ir.op_struct_make("P", 2, -1), ir.op_call_direct("__fern_alloc_reuse", 2), ir.op_tuple_make(2)];
  let mr = irfipverify.verify_fip_fn(fip_claim("fbip", 2), mixed);
  if (mr.fresh != 2 || mr.paired != 1) {
    return 140;
  }
  if (mr.problems.len() != 0) {
    return 141;
  }

  let over = irfipverify.verify_fip_fn(fip_claim("fbip", 0), mixed);
  if (over.problems.len() != 1) {
    return 150;
  }
  let m = irverify.problem_str(over.problems[0]);
  if (!util.contains(m, "`fbip` function \"f\" allocates: 2 un-reused allocation site(s)")) {
    return 151;
  }
  if (!util.contains(m, "allowance of 0")) {
    return 152;
  }
  if (!util.contains(m, "struct/enum construction \"P\" at op 0")) {
    return 153;
  }
  if (!util.contains(m, "tuple literal at op 2")) {
    return 154;
  }
  if (!util.contains(fip_msg("fip", 0, mixed), "`fip` function")) {
    return 155;
  }

  if (!util.contains(fip_msg("fip", 0, fresh_struct), "grade the claim (`fip(n)`)")) {
    return 156;
  }
  if (util.contains(fip_msg("fip", 0, fresh_struct), "checker/IR drift")) {
    return 161;
  }
  if (!util.contains(fip_msg("fip", 1, mixed), "grade the claim (`fip(n)`)")) {
    return 157;
  }
  if (!util.contains(fip_msg("fbip", 0, fresh_struct), "grade the claim (`fbip(n)`)")) {
    return 158;
  }

  if (over.problems[0].op >= 0) {
    return 159;
  }
  if (!util.contains(m, "f: `fbip` function")) {
    return 160;
  }
  return 0;
}

function pv_count(ops: ir.Op[], declared: string[]): i32 {
  return irverifyprovided.verify_provided_fn("f", ops, irverify.name_index(declared)).problems.len();
}

function pv_msg(ops: ir.Op[], declared: string[]): string {
  let r = irverifyprovided.verify_provided_fn("f", ops, irverify.name_index(declared));
  if (r.problems.len() == 0) {
    return "";
  }
  return irverify.problem_str(r.problems[0]);
}

function provided_checks(): i32 {
  let none: string[] = [];
  let decl: string[] = ["main", "helper"];

  if (pv_count([ir.op_call_direct("nope", 1)], decl) != 1) {
    return 70;
  }
  if (!util.contains(
    pv_msg([ir.op_call_direct("nope", 1)], decl),
    "calls nope, which the program does not declare and no backend provides",
  )) {
    return 71;
  }
  if (!util.contains(
    pv_msg([ir.op_load_local(0), ir.op_call_direct("nope", 1)], decl),
    "f: op 1 (call_direct):",
  )) {
    return 72;
  }

  if (pv_count([ir.op_call_direct("helper", 1)], decl) != 0) {
    return 73;
  }
  if (pv_count([ir.op_call_direct("__fern_rc_dec", 1), ir.op_call_direct("__fern_alloc_size_abort", 0)], none) != 0) {
    return 74;
  }
  if (pv_count([ir.op_call_direct("__fern_arr_str_join", 2)], none) != 0) {
    return 75;
  }
  let task_ops: ir.Op[] = [ir.op_call_direct("__fern_task_new", 0), ir.op_call_direct("__fern_task_free", 1), ir.op_call_direct("__fern_task_cur", 0), ir.op_call_direct("__fern_task_enter", 2), ir.op_call_direct("__fern_task_leave", 0), ir.op_call_direct("__fern_task_park", 2), ir.op_call_direct("__fern_task_park_until", 2), ir.op_call_direct("__fern_task_wait", 1), ir.op_call_direct("__fern_task_timeout", 1), ir.op_call_direct("__fern_task_until", 1), ir.op_call_direct("__fern_task_gen", 1), ir.op_call_direct("__fern_task_set_ready", 2), ir.op_call_direct("__fern_task_set_cancelled", 1), ir.op_call_direct("__fern_task_cancelled", 0), ir.op_call_direct("__fern_task_mode", 0), ir.op_call_direct("__fern_task_reserve", 1), ir.op_call_direct("__fern_task_take", 1), ir.op_call_direct("__fern_task_pop_w", 0)];
  if (pv_count(task_ops, none) != 0) {
    return 109;
  }
  if (pv_count([ir.op_call_direct("__fern_task_push_f32", 1), ir.op_call_direct("__fern_task_pop_w_typo", 0)], none) != 2) {
    return 110;
  }
  if (pv_count([ir.op_call_direct("__sem_drop_Holder", 1)], none) != 0) {
    return 76;
  }
  if (pv_count([ir.op_call_direct("__sem_release_Box", 1)], none) != 0) {
    return 77;
  }
  if (pv_count([ir.op_call_direct("__c_call0", 1)], none) != 0) {
    return 78;
  }
  if (pv_count([ir.op_call_direct("__c_call4_f64", 5)], none) != 0) {
    return 79;
  }
  if (pv_count([ir.op_call_direct("__c_call5", 1)], none) != 1) {
    return 80;
  }
  if (pv_count([ir.op_call_direct("__c_call0_f16", 1)], none) != 1) {
    return 81;
  }
  if (pv_count([ir.op_call_direct("__sem_drop_", 1)], none) != 1) {
    return 82;
  }
  if (pv_count([ir.op_call_direct("__fern_rc_de", 1), ir.op_call_direct("__fern_alloc_size_abort_typo", 0)], none) != 2) {
    return 83;
  }

  if (pv_count([ir.op_call_direct("", 1)], none) != 0) {
    return 84;
  }
  if (pv_count([ir.op_call_indirect(2)], none) != 0) {
    return 85;
  }

  let mixed: ir.Op[] = [ir.op_call_direct("helper", 1), ir.op_call_direct("__fern_rc_inc", 1), ir.op_call_direct("nope", 0)];
  let mr = irverifyprovided.verify_provided_fn("f", mixed, irverify.name_index(decl));
  if (mr.calls != 3) {
    return 86;
  }
  if (mr.problems.len() != 1) {
    return 87;
  }

  let big: string[] = [];
  for i in 0..3000 {
    big = big.append("fn_" + util.i32_to_string(i));
  }
  let ix = irverify.name_index(big);
  if (!irverify.index_has(ix, "fn_0")) {
    return 88;
  }
  if (!irverify.index_has(ix, "fn_1499")) {
    return 89;
  }
  if (!irverify.index_has(ix, "fn_2999")) {
    return 90;
  }
  if (irverify.index_has(ix, "fn_3000")) {
    return 91;
  }
  if (irverify.index_has(ix, "")) {
    return 92;
  }
  let placed = 0;
  for pj in 0..big.len() {
    if (irverify.index_has(ix, big[pj])) {
      placed += 1;
    }
  }
  if (placed != 3000) {
    return 93;
  }
  if (irverify.index_has(irverify.name_index(none), "x")) {
    return 94;
  }

  let dsigs: irverify.FnSig[] = [
    irverify.FnSig { name: "dup", n_params: 2 },
    irverify.FnSig { name: "other", n_params: 1 },
    irverify.FnSig { name: "dup", n_params: 7 },
  ];
  let dix = irverify.sig_index(dsigs);
  if (irverify.index_params(dix, "dup") != 2) {
    return 97;
  }
  if (irverify.index_params(dix, "other") != 1) {
    return 98;
  }
  if (irverify.index_params(dix, "absent") != -1) {
    return 99;
  }
  let mix = irverify.name_index(["solo"]);
  if (!irverify.index_has(mix, "solo")) {
    return 107;
  }
  if (irverify.index_params(mix, "solo") != -1) {
    return 108;
  }

  let inv = irverifyprovided.provided_names();
  if (inv.len() < 30) {
    return 95;
  }
  for vi in 0..inv.len() {
    if (!irverifyprovided.is_provided(inv[vi])) {
      return 96;
    }
  }
  return 0;
}

function gate_checks(): i32 {
  let clean: ir.Op[] = [ir.op_const_i32(1), ir.op_return()];
  if (irverifygate.verify_problems("f", clean, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis())).len() != 0) {
    return 170;
  }

  let bad_slot: ir.Op[] = [ir.op_load_local(5), ir.op_return()];
  if (irverifygate.verify_problems("f", bad_slot, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis())).len() != 1) {
    return 171;
  }
  if (!util.contains(
    irverify.problem_str(irverifygate.verify_problems("f", bad_slot, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis()))[0]),
    "is outside the frame",
  )) {
    return 172;
  }

  let underflow: ir.Op[] = [ir.op_const_i32(1), ir.op_bin("add", 0, false), ir.op_return()];
  if (irverifygate.verify_problems("f", underflow, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis())).len() != 1) {
    return 173;
  }
  if (!util.contains(
    irverify.problem_str(irverifygate.verify_problems("f", underflow, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis()))[0]),
    "operand stack underflow",
  )) {
    return 174;
  }

  let both: ir.Op[] = [ir.op_load_local(5), ir.op_bin("add", 0, false), ir.op_return()];
  let bps = irverifygate.verify_problems("f", both, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis()));
  if (bps.len() != 2) {
    return 175;
  }
  if (!util.contains(irverify.problem_str(bps[0]), "is outside the frame")) {
    return 176;
  }
  if (!util.contains(irverify.problem_str(bps[1]), "operand stack underflow")) {
    return 177;
  }

  let sigs = irverify.sig_index([irverify.FnSig { name: "takes2", n_params: 2 }]);
  let arity: ir.Op[] = [ir.op_call_direct("takes2", 0), ir.op_return()];
  let aps = irverifygate.verify_problems("f", arity, 0, 1, irverifygate.gate(sigs, ssa_lift.kind_table(), rccertify.no_abis()));
  if (aps.len() != 1) {
    return 178;
  }
  if (!util.contains(irverify.problem_str(aps[0]), "calls takes2 with 0 args")) {
    return 179;
  }
  if (irverifygate.verify_problems("f", arity, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis())).len() != 0) {
    return 180;
  }

  let unmodelled: ir.Op[] = [ir.op_const_i32(0), ir.op_const_i32(1), ir.op_store(32), ir.op_const_i32(0), ir.op_return()];
  let ups = irverifygate.verify_problems("f", unmodelled, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis()));
  if (ups.len() != 1) {
    return 181;
  }
  if (!util.contains(irverify.problem_str(ups[0]), "cannot model this body: unmodelled op store")) {
    return 182;
  }

  let no_target: ir.Op[] = [ir.op_br(3)];
  let nps = irverifygate.verify_problems("f", no_target, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis()));
  if (nps.len() != 1) {
    return 183;
  }
  if (util.contains(irverify.problem_str(nps[0]), "cannot model")) {
    return 184;
  }
  return width_checks();
}

function width_checks(): i32 {
  let widths: i32[] = [8, 16, 32, 64, ir.width_ptr()];
  for w in widths {
    let ok: ir.Op[] = [ir.op_load_local(0), ir.op_load_local(1), ir.op_arr_get(w), ir.op_return()];
    if (count_problems(ok, 2, 2) != 0) {
      return 185;
    }
  }
  let bools: ir.Op[] = [ir.op_load_local(0), ir.op_alloc_slots(1), ir.op_return()];
  if (count_problems(bools, 1, 1) != 0) {
    return 186;
  }
  let words: ir.Op[] = [ir.op_load_local(0), ir.op_alloc_u8(), ir.op_return()];
  if (count_problems(words, 1, 1) != 0) {
    return 187;
  }
  let odd: ir.Op[] = [ir.op_load_local(0), ir.op_load_local(1), ir.op_arr_get(7), ir.op_return()];
  if (count_problems(odd, 2, 2) != 1) {
    return 188;
  }
  if (!util.contains(first_msg(odd, 2, 2), "op 2 (arr_get): element width 7 is not 8, 16, 32, 64 or the pointer width")) {
    return 189;
  }
  let zero: ir.Op[] = [ir.op_load_local(0), ir.op_arr_slice(0), ir.op_return()];
  if (count_problems(zero, 1, 1) != 1) {
    return 235;
  }
  let gate_odd = irverifygate.verify_problems("f", odd, 2, 2, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis()));
  if (gate_odd.len() != 1 || !util.contains(irverify.problem_str(gate_odd[0]), "element width 7")) {
    return 236;
  }
  return int_width_checks();
}

function bin_ops(kind: string, w: i32): ir.Op[] {
  return [ir.op_load_local(0), ir.op_load_local(1), ir.op_bin(kind, w, false), ir.op_return()];
}

function bits_ops(o: ir.Op): ir.Op[] {
  return [ir.op_load_local(0), o, ir.op_return()];
}

function int_width_checks(): i32 {
  let widths: i32[] = [0, 32, 64, ir.width_ptr()];
  let kinds: string[] = ["add", "shr_u", "lt_s", "ge_u", "mulhi_u"];
  for k in kinds {
    for w in widths {
      if (count_problems(bin_ops(k, w), 2, 2) != 0) {
        return 237;
      }
    }
  }
  for w in [32, 64] {
    for o in [ir.op_clz(w), ir.op_ctz(w), ir.op_popcount(w), ir.op_bswap(w)] {
      if (count_problems(bits_ops(o), 1, 1) != 0) {
        return 238;
      }
    }
  }
  if (!util.contains(first_msg(bin_ops("add", 16), 2, 2), "op 2 (add): width 16 is not 0, 32, 64 or the pointer width")) {
    return 239;
  }
  if (count_problems(bin_ops("eq", 128), 2, 2) != 1) {
    return 240;
  }
  if (!util.contains(first_msg(bits_ops(ir.op_clz(16)), 1, 1), "op 1 (clz): width 16 is not 32 or 64")) {
    return 241;
  }
  if (count_problems(bits_ops(ir.op_popcount(ir.width_ptr())), 1, 1) != 1 || count_problems(bits_ops(ir.op_bswap(0)), 1, 1) != 1) {
    return 242;
  }
  return conv_width_checks();
}

function conv_width_checks(): i32 {
  let p = ir.width_ptr();
  let good: ir.Op[] = [
    ir.op_int_extend(false), ir.op_int_extend(true), ir.op_int_extend_ptr(), ir.op_int_wrap(false), ir.op_int_wrap_ptr(),
    ir.op_int_to_f64(32, false), ir.op_int_to_f64(64, true), ir.op_ptr_to_f64(), ir.op_f64_to_i32(), ir.op_f64_to_u32(),
    ir.op_f64_to_i64(), ir.op_f64_to_u64(), ir.op_f64_to_ptr(), ir.op_int_cast("u8"), ir.op_u32_wrap(),
  ];
  for o in good {
    if (count_problems(bits_ops(o), 1, 1) != 0) {
      return 243;
    }
  }
  if (!util.contains(first_msg(bits_ops(ir.Op { ...ir.op_int_extend(false), width: 32 }), 1, 1), "op 1 (int_extend): width 32 is not 64 or the pointer width")) {
    return 244;
  }
  if (!util.contains(first_msg(bits_ops(ir.Op { ...ir.op_int_wrap(false), width: 64 }), 1, 1), "op 1 (int_wrap): width 64 is not 0 or the pointer width")) {
    return 245;
  }
  if (!util.contains(first_msg(bits_ops(ir.op_int_to_f64(16, false)), 1, 1), "op 1 (i32_to_f64): width 16 is not 0, 32, 64 or the pointer width")) {
    return 246;
  }
  if (count_problems(bits_ops(ir.Op { ...ir.op_f64_to_i64(), width: 32 }), 1, 1) != 1) {
    return 247;
  }
  if (!util.contains(first_msg(bits_ops(ir.Op { ...ir.op_f64_to_i32(), width: p }), 1, 1), "op 1 (f64_to_i32): width -1 is not 0")) {
    return 248;
  }
  if (count_problems(bits_ops(ir.Op { ...ir.op_int_cast("u16"), width: 16 }), 1, 1) != 1 || count_problems(bits_ops(ir.Op { ...ir.op_u32_wrap(), width: 32 }), 1, 1) != 1) {
    return 249;
  }
  return mem_width_checks();
}

function mem_width_checks(): i32 {
  let loads: ir.Op[] = [ir.op_load_u16(), ir.op_load_i32(), ir.op_load_i64(), ir.op_load_ptr(), ir.op_raw_load8(), ir.op_raw_load_ptr()];
  for w in [8, 16, 32, 64] {
    loads = loads.append(ir.op_mmio_load(w));
  }
  for o in loads {
    if (count_problems(bits_ops(o), 1, 1) != 0) {
      return 250;
    }
  }
  let stores: ir.Op[] = [ir.op_store_i32(), ir.op_store_i64(), ir.op_store_ptr(), ir.op_raw_store8(), ir.op_raw_store_ptr()];
  for w in [8, 16, 32, 64] {
    stores = stores.append(ir.op_mmio_store(w));
  }
  for o in stores {
    if (count_problems(store_ops(o), 2, 2) != 0) {
      return 251;
    }
  }
  if (!util.contains(first_msg(bits_ops(ir.op_load(32)), 1, 1), "op 1 (load): width 32 is not 16")) {
    return 252;
  }
  if (!util.contains(first_msg(bits_ops(ir.op_mmio_load(0)), 1, 1), "op 1 (mmio_load): width 0 is not 8, 16, 32 or 64")) {
    return 253;
  }
  if (count_problems(store_ops(ir.op_mmio_store(ir.width_ptr())), 2, 2) != 1) {
    return 254;
  }
  if (!util.contains(first_msg(bits_ops(ir.Op { ...ir.op_load_i64(), width: 64 }), 1, 1), "op 1 (load_i64): width 64 is not 0")) {
    return 255;
  }
  if (count_problems(store_ops(ir.Op { ...ir.op_raw_store8(), width: 8 }), 2, 2) != 1) {
    return 162;
  }
  return lane_width_checks();
}

function lane_ops(o: ir.Op): ir.Op[] {
  return [ir.op_load_local(0), ir.op_load_local(1), o, ir.op_return()];
}

function lane_width_checks(): i32 {
  let good: ir.Op[] = [
    ir.op_lane("vadd", 32), ir.op_lane("vadd", 64), ir.op_lane_at("vextract", 32, 3), ir.op_lane_at("vreplace", 64, 1),
    ir.op_lane("vand", 8), ir.op_lane("vselect", 64), ir.op_lane("vget", 32), ir.op_lane("vset", 64),
    ir.Op { ...ir.op_lane("vget", 8), unsigned: true }, ir.op_lane("viadd", 8), ir.op_lane("vimul", 16),
    ir.op_lane_at("viextractu", 8, 15), ir.op_lane_at("vireplace", 32, 3), ir.op_lane("viwidenlos", 16),
    ir.op_lane("vinarrowu", 32), ir.op_lane("viswizzle", 8), ir.op_lane("vpack", 32), ir.op_lane("vload_f32", 64),
    ir.op_lane_at("vpermute", 32, 7), ir.op_lane_at("vpermute", 64, 3), ir.op_lane_at("vextract_bits", 64, 1),
    ir.op_lane("vsplat", 32), ir.op_lane("vbitmask", 64), ir.op_lane("vor", 8), ir.op_lane("viwidenhiu", 16),
    ir.op_lane("vinarrows", 16), ir.op_lane_at("viextracts", 32, 3),
  ];
  for o in good {
    if (count_problems(lane_ops(o), 2, 2) != 0) {
      return 163;
    }
  }
  let bad: ir.Op[] = [
    ir.op_lane("vadd", 16), ir.op_lane("vget", 8), ir.op_lane("vset", 16), ir.op_lane("vand", 0),
    ir.op_lane("viadd", 64), ir.op_lane("viwidenlou", 32), ir.op_lane("vinarrows", 8), ir.op_lane("viswizzle", 16),
    ir.op_lane("vpack", 64), ir.op_lane("vload_f32", 32), ir.op_lane_at("vextract", 64, 2),
    ir.op_lane_at("viextracts", 16, 8), ir.op_lane_at("vireplace", 8, -1), ir.op_lane_at("vpermute", 64, 4),
    ir.op_lane_at("vpermute", 32, 8),
  ];
  for o in bad {
    if (count_problems(lane_ops(o), 2, 2) != 1) {
      return 164;
    }
  }
  if (!util.contains(first_msg(lane_ops(ir.op_lane("vget", 16)), 2, 2), "op 2 (vget): lane width 16 is not 32 or 64")) {
    return 165;
  }
  if (!util.contains(first_msg(lane_ops(ir.op_lane("viadd", 64)), 2, 2), "op 2 (viadd): lane width 64 is not 8, 16 or 32")) {
    return 166;
  }
  if (!util.contains(first_msg(lane_ops(ir.op_lane_at("vextract", 64, 2)), 2, 2), "op 2 (vextract): lane 2 is outside the 2 lanes of width 64")) {
    return 167;
  }
  if (!util.contains(first_msg(lane_ops(ir.op_lane_at("vpermute", 64, 4)), 2, 2), "op 2 (vpermute): permute mode 4 is not 0 to 3")) {
    return 168;
  }
  return 0;
}

function store_ops(o: ir.Op): ir.Op[] {
  return [ir.op_load_local(0), ir.op_load_local(1), o, ir.op_return()];
}

function refuse_probe(): i32 {
  let malformed: ir.Op[] = [ir.op_load_local(5), ir.op_return()];
  irverifygate.verify_or_refuse("probe", malformed, 0, 1, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis()));
  print("irverifygate: inert (FERN_IR_VERIFY=0)");
  return 0;
}

function raw_op(kind: string): ir.Op {
  return ir.Op { source: 0, decl: -1, kind_tag: ir.kind_id(kind), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

function selfhost_reuse(gate: i32, token: i32): ir.Op[] {
  return [
    ir.op_load_local(gate),
    ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_tee_local(3),
    ir.op_if(0),
    ir.op_load_local(token),
    ir.op_store_local(4),
    ir.op_else(),
    ir.op_const_i32(0),
    ir.op_store_local(4),
    ir.op_end(),
    ir.op_load_local(4),
    ir.op_const_i32(3),
    ir.op_call_direct("__fern_alloc_reuse", 2),
  ];
}

// selfhost_reuse(1, 1) with local clear set to zero before the reuse call.
function cleared_reuse(clear: i32): ir.Op[] {
  return [
    ir.op_load_local(1),
    ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_tee_local(3),
    ir.op_if(0),
    ir.op_load_local(1),
    ir.op_store_local(4),
    ir.op_else(),
    ir.op_const_i32(0),
    ir.op_store_local(4),
    ir.op_end(),
    ir.op_const_i32(0),
    ir.op_store_local(clear),
    ir.op_load_local(4),
    ir.op_const_i32(3),
    ir.op_call_direct("__fern_alloc_reuse", 2),
  ];
}

function keep_reuse(gate: i32, token: i32, dec: i32): ir.Op[] {
  return [
    ir.op_load_local(gate),
    ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_if(0),
    ir.op_load_local(token),
    ir.op_store_local(4),
    ir.op_else(),
    ir.op_const_i32(0),
    ir.op_store_local(4),
    ir.op_end(),
    ir.op_load_local(4),
    ir.op_const_i32(0),
    ir.op_bin("eq", 0, false),
    ir.op_if(0),
    ir.op_load_local(4),
    ir.op_record_slots(2),
    ir.op_call_direct("__fern_alloc_reuse", 2),
    ir.op_store_local(5),
    ir.op_load_local(5),
    ir.op_struct_set_shape("P", 2),
    ir.op_drop(),
    ir.op_load_local(5),
    ir.op_load_local(gate),
    ir.op_struct_get(1, 0),
    ir.op_call_direct("__fern_rc_inc", 1),
    ir.op_struct_set(1, 0),
    ir.op_else(),
    ir.op_load_local(4),
    ir.op_store_local(5),
    ir.op_end(),
    ir.op_load_local(4),
    ir.op_const_i32(0),
    ir.op_bin("ne", 0, false),
    ir.op_if(0),
    ir.op_else(),
    ir.op_load_local(dec),
    ir.op_call_direct("__sem_release_P", 1),
    ir.op_drop(),
    ir.op_end(),
    ir.op_const_i32(0),
    ir.op_store_local(gate),
  ];
}

function rc_flow_matches(ops: ir.Op[], problems: i32): boolean {
  let r = irverifyrc.verify_rc_fn("flow", ops);
  return r.sites == 2 && r.checked == 2 && r.problems.len() == problems;
}

function rc_branch_paths(): i32 {
  let skipped = concat_ops([ir.op_block(0)], selfhost_reuse(1, 1));
  skipped = concat_ops(skipped, [ir.op_br(0)]);
  skipped = concat_ops(skipped, selfhost_reuse(1, 1));
  skipped = concat_ops(skipped, [ir.op_end()]);
  if (!rc_flow_matches(skipped, 0)) {
    return 224;
  }
  let conditional = concat_ops([ir.op_block(0)], selfhost_reuse(1, 1));
  conditional = concat_ops(conditional, [ir.op_const_i32(1), ir.op_brif(0)]);
  conditional = concat_ops(conditional, selfhost_reuse(1, 1));
  conditional = concat_ops(conditional, [ir.op_end()]);
  if (!rc_flow_matches(conditional, 1)) {
    return 225;
  }

  let nested = concat_ops([ir.op_block(0), ir.op_block(0)], selfhost_reuse(1, 1));
  let outer = concat_ops(nested, [ir.op_br(1), ir.op_end()]);
  outer = concat_ops(outer, selfhost_reuse(1, 1));
  outer = concat_ops(outer, [ir.op_end()]);
  if (!rc_flow_matches(outer, 0)) {
    return 226;
  }
  nested = concat_ops(nested, [ir.op_br(0), ir.op_end()]);
  nested = concat_ops(nested, selfhost_reuse(1, 1));
  nested = concat_ops(nested, [ir.op_end()]);
  if (!rc_flow_matches(nested, 1)) {
    return 227;
  }

  let partial = concat_ops(selfhost_reuse(1, 1), [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(0), ir.op_store_local(1), ir.op_end()]);
  partial = concat_ops(partial, selfhost_reuse(1, 1));
  if (!rc_flow_matches(partial, 1)) {
    return 228;
  }
  let both = concat_ops(selfhost_reuse(1, 1), [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(0), ir.op_store_local(1), ir.op_else(), ir.op_const_i32(0), ir.op_tee_local(1), ir.op_drop(), ir.op_end()]);
  both = concat_ops(both, selfhost_reuse(1, 1));
  if (!rc_flow_matches(both, 0)) {
    return 229;
  }

  let cycling = concat_ops([ir.op_block(0), ir.op_loop(0)], selfhost_reuse(1, 1));
  let forever = concat_ops(cycling, [ir.op_br(0), ir.op_end(), ir.op_end()]);
  forever = concat_ops(forever, selfhost_reuse(1, 1));
  if (!rc_flow_matches(forever, 0)) {
    return 230;
  }
  cycling = concat_ops(cycling, [ir.op_const_i32(1), ir.op_brif(1), ir.op_br(0), ir.op_end(), ir.op_end()]);
  cycling = concat_ops(cycling, selfhost_reuse(1, 1));
  if (!rc_flow_matches(cycling, 1)) {
    return 231;
  }

  let returned = concat_ops(selfhost_reuse(1, 1), [ir.op_br(0)]);
  returned = concat_ops(returned, selfhost_reuse(1, 1));
  if (!rc_flow_matches(returned, 0)) {
    return 232;
  }
  return 0;
}

function native_reuse(gate: i32, token: i32, dec: i32): ir.Op[] {
  return [
    ir.op_load_local(gate),
    ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_store_local(3),
    ir.op_load_local(3),
    ir.op_if(0),
    ir.op_load_local(token),
    ir.op_const_i32(8),
    raw_op("sub"),
    ir.op_store_local(4),
    ir.op_else(),
    ir.op_load_local(dec),
    ir.op_call_direct("__fern_rc_dec", 1),
    ir.op_drop(),
    ir.op_const_i32(0),
    ir.op_store_local(4),
    ir.op_end(),
    ir.op_const_i32(0),
    ir.op_store_local(gate),
    ir.op_load_local(4),
    ir.op_const_i32(24),
    ir.op_const_i32(24),
    ir.op_call_direct("__alloc_reuse", 3),
  ];
}

function concat_ops(a: ir.Op[], b: ir.Op[]): ir.Op[] {
  let out = a;
  for i in 0..b.len() {
    out = out.append(b[i]);
  }
  return out;
}

function rc_only_skip(ops: ir.Op[], why: string): boolean {
  let r = irverifyrc.verify_rc_fn("f", ops);
  if (r.problems.len() != 0 || r.sites != 1 || r.checked != 0) {
    return false;
  }
  if (r.skips.len() != 1) {
    return false;
  }
  return r.skips[0] == why;
}

function rc_checks(): i32 {
  let sh = irverifyrc.verify_rc_fn("f", selfhost_reuse(1, 1));
  if (sh.problems.len() != 0) {
    return 190;
  }
  if (sh.sites != 1 || sh.checked != 1) {
    return 191;
  }

  let na = irverifyrc.verify_rc_fn("f", native_reuse(1, 1, 1));
  if (na.problems.len() != 0) {
    return 192;
  }
  if (na.sites != 1 || na.checked != 1) {
    return 193;
  }

  let t1 = irverifyrc.verify_rc_fn("f", selfhost_reuse(1, 2));
  if (t1.checked != 1) {
    return 194;
  }
  if (t1.problems.len() != 1) {
    return 195;
  }
  if (!util.contains(t1.problems[0].msg, "never proved unique")) {
    return 196;
  }

  let t2 = irverifyrc.verify_rc_fn("f", native_reuse(1, 2, 1));
  if (t2.problems.len() != 1) {
    return 197;
  }
  if (!util.contains(t2.problems[0].msg, "never proved unique")) {
    return 198;
  }

  let d1 = irverifyrc.verify_rc_fn("f", native_reuse(1, 1, 2));
  if (d1.checked != 1) {
    return 199;
  }
  if (d1.problems.len() != 1) {
    return 200;
  }
  if (!util.contains(d1.problems[0].msg, "leaks on the decline path")) {
    return 201;
  }

  let no_gate = selfhost_reuse(1, 1).with(1, ir.op_drop());
  if (!rc_only_skip(no_gate, "no uniqueness gate before the token select")) {
    return 202;
  }

  let no_else: ir.Op[] = [
    ir.op_load_local(1),
    ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_tee_local(3),
    ir.op_if(0),
    ir.op_load_local(1),
    ir.op_store_local(4),
    ir.op_end(),
    ir.op_load_local(4),
    ir.op_const_i32(3),
    ir.op_call_direct("__fern_alloc_reuse", 2),
  ];
  if (!rc_only_skip(no_else, "token select has no decline arm")) {
    return 203;
  }

  let const_token = selfhost_reuse(1, 1).with(10, ir.op_const_i32(0));
  if (!rc_only_skip(const_token, "token argument is not a local load")) {
    return 204;
  }

  let cond_not_local = native_reuse(1, 1, 1).with(3, ir.op_const_i32(1));
  if (!rc_only_skip(cond_not_local, "token select is not conditioned on a local")) {
    return 205;
  }

  if (sh.checked != 1) {
    return 206;
  }

  let plain: ir.Op[] = [ir.op_load_local(1), ir.op_call_direct("__fern_rc_inc", 1), ir.op_drop()];
  let pr = irverifyrc.verify_rc_fn("f", plain);
  if (pr.problems.len() != 0 || pr.sites != 0) {
    return 207;
  }

  let gp = irverifygate.verify_problems("f", selfhost_reuse(1, 2), 0, 8, irverifygate.gate(no_sigs(), ssa_lift.kind_table(), rccertify.no_abis()));
  let seen = false;
  for gi in 0..gp.len() {
    if (util.contains(gp[gi].msg, "never proved unique")) {
      seen = true;
    }
  }
  if (!seen) {
    return 208;
  }

  let twice = concat_ops(selfhost_reuse(1, 1), selfhost_reuse(1, 1));
  let tw = irverifyrc.verify_rc_fn("f", twice);
  if (tw.sites != 2 || tw.checked != 2) {
    return 211;
  }
  if (tw.problems.len() != 1) {
    return 212;
  }
  if (!util.contains(tw.problems[0].msg, "one allocation handed to two recipients")) {
    return 213;
  }

  let arms = concat_ops([ir.op_const_i32(1), ir.op_if(0)], selfhost_reuse(1, 1));
  arms = concat_ops(arms, [ir.op_else()]);
  arms = concat_ops(arms, selfhost_reuse(1, 1));
  arms = concat_ops(arms, [ir.op_end()]);
  let ar = irverifyrc.verify_rc_fn("f", arms);
  if (ar.checked != 2) {
    return 214;
  }
  if (ar.problems.len() != 0) {
    return 215;
  }

  let rebound = concat_ops(selfhost_reuse(1, 1), [ir.op_const_i32(0), ir.op_store_local(1)]);
  rebound = concat_ops(rebound, selfhost_reuse(1, 1));
  let rb = irverifyrc.verify_rc_fn("f", rebound);
  if (rb.checked != 2 || rb.problems.len() != 0) {
    return 216;
  }

  let distinct = concat_ops(selfhost_reuse(1, 1), selfhost_reuse(2, 2));
  let di = irverifyrc.verify_rc_fn("f", distinct);
  if (di.checked != 2 || di.problems.len() != 0) {
    return 217;
  }

  let stopped = concat_ops(selfhost_reuse(1, 1), [ir.op_return()]);
  stopped = concat_ops(stopped, selfhost_reuse(1, 1));
  let sr = irverifyrc.verify_rc_fn("f", stopped);
  if (sr.checked != 2 || sr.problems.len() != 0) {
    return 221;
  }
  let conditional = concat_ops(selfhost_reuse(1, 1), [ir.op_const_i32(1), ir.op_if(0), ir.op_return(), ir.op_end()]);
  conditional = concat_ops(conditional, selfhost_reuse(1, 1));
  let cr = irverifyrc.verify_rc_fn("f", conditional);
  if (cr.checked != 2 || cr.problems.len() != 1) {
    return 222;
  }
  let unknown = concat_ops(selfhost_reuse(1, 1), [raw_op("not_an_op_kind")]);
  unknown = concat_ops(unknown, selfhost_reuse(1, 1));
  let ur = irverifyrc.verify_rc_fn("f", unknown);
  if (ur.checked != 2 || ur.problems.len() != 1) {
    return 223;
  }
  let lc = irverifyrc.verify_rc_fn("f", concat_ops(cleared_reuse(1), selfhost_reuse(1, 1)));
  if (lc.checked != 2 || lc.problems.len() != 0) {
    return 233;
  }
  let oc = irverifyrc.verify_rc_fn("f", concat_ops(cleared_reuse(5), selfhost_reuse(1, 1)));
  if (oc.checked != 2 || oc.problems.len() != 1) {
    return 234;
  }

  let kc = irverifyrc.verify_rc_fn("f", keep_reuse(1, 1, 1));
  if (kc.checked != 1 || kc.problems.len() != 0) {
    return 218;
  }
  let kt = irverifyrc.verify_rc_fn("f", keep_reuse(1, 2, 1));
  if (kt.checked != 1 || kt.problems.len() != 1 || !util.contains(kt.problems[0].msg, "never proved unique")) {
    return 219;
  }
  let kd = irverifyrc.verify_rc_fn("f", keep_reuse(1, 1, 2));
  if (kd.checked != 1 || kd.problems.len() != 1 || !util.contains(kd.problems[0].msg, "leaks on the decline path")) {
    return 220;
  }

  let branch_paths = rc_branch_paths();
  if (branch_paths != 0) {
    return branch_paths;
  }
  if (!util.contains(irverifyrc.rc_coverage_str(sh), "reuse sites modelled 1/1")) {
    return 209;
  }
  let skipped = irverifyrc.verify_rc_fn("f", no_gate);
  if (!util.contains(irverifyrc.rc_coverage_str(skipped), "skipped 1: no uniqueness gate")) {
    return 210;
  }

  return 0;
}

function main(): i32 {
  let av = args();
  for ai in 0..av.len() {
    if (av[ai] == "-refuse") {
      return refuse_probe();
    }
  }

  let in_range: ir.Op[] = [ir.op_load_local(0), ir.op_store_local(2), ir.op_tee_local(1)];
  if (count_problems(in_range, 1, 3) != 0) {
    return 1;
  }

  let past_end: ir.Op[] = [ir.op_load_local(3)];
  if (count_problems(past_end, 1, 3) != 1) {
    return 2;
  }

  let negative_idx: ir.Op[] = [ir.op_store_local(-1)];
  if (count_problems(negative_idx, 1, 3) != 1) {
    return 3;
  }

  let m1 = first_msg(past_end, 1, 3);
  if (!util.contains(m1, "local index 3 is outside the frame")) {
    return 4;
  }
  if (!util.contains(m1, "1 params + 2 locals = 3 slots")) {
    return 5;
  }

  if (count_problems([ir.op_load_local(0)], 0, 0) != 1) {
    return 6;
  }

  let balanced: ir.Op[] = [ir.op_block(0), ir.op_end()];
  if (count_problems(balanced, 0, 1) != 0) {
    return 10;
  }

  let if_else: ir.Op[] = [ir.op_if(0), ir.op_else(), ir.op_end()];
  if (count_problems(if_else, 0, 1) != 0) {
    return 11;
  }

  let nested: ir.Op[] = [ir.op_block(0), ir.op_loop(0), ir.op_if(0), ir.op_else(), ir.op_end(), ir.op_end(), ir.op_end()];
  if (count_problems(nested, 0, 1) != 0) {
    return 12;
  }

  let unclosed: ir.Op[] = [ir.op_block(0)];
  if (count_problems(unclosed, 0, 1) != 1) {
    return 13;
  }
  if (!util.contains(first_msg(unclosed, 0, 1), "scope is never closed")) {
    return 14;
  }

  if (count_problems([ir.op_block(0), ir.op_loop(0)], 0, 1) != 2) {
    return 15;
  }

  let extra_end: ir.Op[] = [ir.op_end()];
  if (count_problems(extra_end, 0, 1) != 1) {
    return 16;
  }
  if (!util.contains(first_msg(extra_end, 0, 1), "end with no open scope")) {
    return 17;
  }

  let else_on_block: ir.Op[] = [ir.op_block(0), ir.op_else(), ir.op_end()];
  if (count_problems(else_on_block, 0, 1) != 1) {
    return 18;
  }
  if (!util.contains(first_msg(else_on_block, 0, 1), "else closes a block")) {
    return 19;
  }

  let double_else: ir.Op[] = [ir.op_if(0), ir.op_else(), ir.op_else(), ir.op_end()];
  if (count_problems(double_else, 0, 1) != 1) {
    return 20;
  }
  if (!util.contains(first_msg(double_else, 0, 1), "second else")) {
    return 21;
  }

  if (count_problems([ir.op_else()], 0, 1) != 1) {
    return 22;
  }

  let br0: ir.Op[] = [ir.op_block(0), ir.op_br(0), ir.op_end()];
  if (count_problems(br0, 0, 1) != 0) {
    return 30;
  }

  let br1: ir.Op[] = [ir.op_block(0), ir.op_br(1), ir.op_end()];
  if (count_problems(br1, 0, 1) != 0) {
    return 31;
  }

  let br2: ir.Op[] = [ir.op_block(0), ir.op_br(2), ir.op_end()];
  if (count_problems(br2, 0, 1) != 1) {
    return 32;
  }
  if (!util.contains(first_msg(br2, 0, 1), "branch depth 2 has no target")) {
    return 33;
  }

  if (count_problems([ir.op_block(0), ir.op_brif(1), ir.op_end()], 0, 1) != 0) {
    return 34;
  }
  if (count_problems([ir.op_block(0), ir.op_brif(2), ir.op_end()], 0, 1) != 1) {
    return 35;
  }

  if (count_problems([ir.op_br(0)], 0, 1) != 0) {
    return 36;
  }
  if (count_problems([ir.op_br(1)], 0, 1) != 1) {
    return 37;
  }

  if (count_problems([ir.op_block(0), ir.op_br(-1), ir.op_end()], 0, 1) != 1) {
    return 38;
  }

  let sigs: irverify.NameIndex = irverify.sig_index([
    irverify.FnSig { name: "takes2", n_params: 2 },
    irverify.FnSig { name: "takes0", n_params: 0 },
  ]);

  let call_ok: ir.Op[] = [ir.op_call_direct("takes2", 2)];
  if (irverify.verify_fn("f", call_ok, 0, 1, sigs).len() != 0) {
    return 40;
  }

  let call_short: ir.Op[] = [ir.op_call_direct("takes2", 1)];
  let short_ps = irverify.verify_fn("f", call_short, 0, 1, sigs);
  if (short_ps.len() != 1) {
    return 41;
  }
  if (!util.contains(irverify.problem_str(short_ps[0]), "calls takes2 with 1 args, but it declares 2")) {
    return 39;
  }

  let call_bad: ir.Op[] = [ir.op_call_direct("takes2", 0)];
  let bad_ps = irverify.verify_fn("f", call_bad, 0, 1, sigs);
  if (bad_ps.len() != 1) {
    return 42;
  }
  if (!util.contains(irverify.problem_str(bad_ps[0]), "calls takes2 with 0 args, but it declares 2")) {
    return 43;
  }

  if (irverify.verify_fn("f", [ir.op_call_direct("takes2", 3)], 0, 1, sigs).len() != 1) {
    return 44;
  }

  if (irverify.verify_fn("f", [ir.op_call_direct("__fern_rc_inc", 1)], 0, 1, sigs).len() != 0) {
    return 45;
  }
  if (irverify.verify_fn("f", [ir.op_call_direct("print", 1)], 0, 1, sigs).len() != 0) {
    return 46;
  }

  if (count_problems([ir.op_call_direct("takes2", 99)], 0, 1) != 0) {
    return 47;
  }

  if (count_problems([ir.op_call_direct("anything", -1)], 0, 1) != 1) {
    return 48;
  }

  if (count_problems([ir.op_call_direct("", 1)], 0, 1) != 1) {
    return 49;
  }

  if (count_problems([ir.op_call_indirect(2)], 0, 1) != 0) {
    return 50;
  }
  if (count_problems([ir.op_call_indirect(-1)], 0, 1) != 1) {
    return 51;
  }

  let many: ir.Op[] = [ir.op_load_local(9), ir.op_end(), ir.op_br(4)];
  let mp = irverify.verify_fn("g", many, 0, 1, no_sigs());
  if (mp.len() != 3) {
    return 60;
  }
  if (mp[0].op != 0 || mp[1].op != 1 || mp[2].op != 2) {
    return 61;
  }
  if (mp[0].fn_name != "g") {
    return 62;
  }

  if (!util.contains(irverify.problem_str(mp[0]), "g: op 0 (load_local):")) {
    return 63;
  }

  if (!util.contains(irverify.format_problems(mp, 2), "... and 1 more")) {
    return 64;
  }
  if (util.contains(irverify.format_problems(mp, 10), "more")) {
    return 65;
  }

  if (irverify.format_problems(irverify.verify_fn("f", balanced, 0, 1, no_sigs()), 10).len() != 0) {
    return 66;
  }

  let sc = stack_checks();
  if (sc != 0) {
    return sc;
  }

  let fc = fip_checks();
  if (fc != 0) {
    return fc;
  }

  let pc = provided_checks();
  if (pc != 0) {
    return pc;
  }

  let gc = gate_checks();
  if (gc != 0) {
    return gc;
  }

  let rc = rc_checks();
  if (rc != 0) {
    return rc;
  }

  print("irverify: all structural checks agree");
  print("irverifystack: all stack checks agree");
  print("irfipverify: all allocation-budget checks agree");
  print("irverifyprovided: all callee-resolution checks agree");
  print("irverifyrc: all reuse-donor checks agree");
  print("irverifygate: compile-path gate agrees");
  return 0;
}
