import "../ir";
import "../irverify";
import "../irverifystack";
import "../irfipverify";
import "./irverifyprovided";
import "../irverifyrc";
import "../irverifygate";
import "../rccertify";
import "../util";

function no_sigs(): irverify.NameIndex {
  return irverify.sig_index([]);
}

function count_problems(ops: ir.Op[], n_params: i32, n_locals: i32): i32 {
  return irverify.verify_fn("f", ops, n_params, n_locals, no_sigs()).len();
}

function first_msg(ops: ir.Op[], n_params: i32, n_locals: i32): string {
  let ps: irverify.Problem[] = irverify.verify_fn("f", ops, n_params, n_locals, no_sigs());
  if (ps.len() == 0) {
    return "";
  }
  return irverify.problem_str(ps[0]);
}

function sp_count(ops: ir.Op[]): i32 {
  return irverifystack.verify_stack_fn("f", ops, ir.pops_by_kind()).problems.len();
}

function sp_msg(ops: ir.Op[]): string {
  let r: irverifystack.StackResult = irverifystack.verify_stack_fn("f", ops, ir.pops_by_kind());
  if (r.problems.len() == 0) {
    return "";
  }
  return irverify.problem_str(r.problems[0]);
}

function sp_bail(ops: ir.Op[]): string {
  return irverifystack.verify_stack_fn("f", ops, ir.pops_by_kind()).bail;
}

function stack_checks(): i32 {
  if (sp_count([ir.op_const_i32(1), ir.op_return()]) != 0) {
    return 70;
  }
  if (sp_count([ir.op_const_i32(1), ir.op_drop()]) != 0) {
    return 71;
  }
  if (sp_count([]) != 0) {
    return 72;
  }

  let dangling: ir.Op[] = [ir.op_const_i32(1)];
  if (sp_count(dangling) != 1) {
    return 73;
  }
  if (!util.contains(sp_msg(dangling), "falls off its end holding 1 operand slot")) {
    return 74;
  }

  let starved: ir.Op[] = [ir.op_bin("add", 0, false), ir.op_return()];
  if (sp_count(starved) != 1) {
    return 75;
  }
  if (!util.contains(sp_msg(starved), "operand stack underflow - needs 2 operand slot(s)")) {
    return 76;
  }
  if (sp_count([ir.op_drop()]) != 1) {
    return 77;
  }

  if (sp_count([ir.op_const_i32(1), ir.op_block(0), ir.op_drop(), ir.op_end(), ir.op_return()]) != 1) {
    return 78;
  }

  let leaky_if: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(2), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
  if (sp_count(leaky_if) != 1) {
    return 80;
  }
  if (!util.contains(sp_msg(leaky_if), "the if opened at op 1 leaves 1 operand slot(s), but it is void")) {
    return 81;
  }

  let leaky_then: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(2), ir.op_else(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
  if (sp_count(leaky_then) != 1) {
    return 82;
  }
  if (!util.contains(sp_msg(leaky_then), "the then-arm leaves 1 operand slot(s)")) {
    return 83;
  }

  let balanced_if: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(2), ir.op_drop(), ir.op_else(), ir.op_const_i32(3), ir.op_drop(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
  if (sp_count(balanced_if) != 0) {
    return 84;
  }
  let wloop: ir.Op[] = [ir.op_block(0), ir.op_loop(0), ir.op_const_i32(1), ir.op_brif(1), ir.op_br(0), ir.op_end(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
  if (sp_count(wloop) != 0) {
    return 85;
  }

  if (sp_count([ir.op_block(0), ir.op_br(0), ir.op_bin("add", 0, false), ir.op_end(), ir.op_const_i32(0), ir.op_return()]) != 0) {
    return 86;
  }
  if (sp_count([ir.op_const_i32(1), ir.op_return(), ir.op_drop()]) != 0) {
    return 87;
  }

  if (sp_count([ir.op_br(0)]) != 1) {
    return 88;
  }
  if (!util.contains(sp_msg([ir.op_br(0)]), "branch to the function body needs 1 operand slot")) {
    return 89;
  }
  if (sp_count([ir.op_const_i32(0), ir.op_br(0)]) != 0) {
    return 90;
  }

  if (sp_count([ir.op_const_i32(0), ir.op_const_i32(0), ir.op_const_i32(0), ir.op_arr_set(32)]) != 0) {
    return 91;
  }
  if (sp_count([ir.op_const_i32(0), ir.op_const_i32(0), ir.op_struct_set(0, 0)]) != 0) {
    return 92;
  }
  if (sp_count([ir.op_const_i32(0), ir.op_const_i32(0), ir.op_store_i32(), ir.op_drop()]) != 0) {
    return 93;
  }
  if (sp_count([ir.op_const_i32(1), ir.op_const_func(0, "f"), ir.op_call_indirect(1), ir.op_return()]) != 0) {
    return 95;
  }
  if (sp_count([ir.op_const_func(0, "f"), ir.op_call_indirect(1), ir.op_return()]) != 1) {
    return 96;
  }

  let unmodelled: ir.Op[] = [ir.op_load(32)];
  if (sp_bail(unmodelled) != "unmodelled op load") {
    return 100;
  }
  if (sp_count(unmodelled) != 0) {
    return 101;
  }

  if (!util.contains(sp_bail([ir.op_block(1), ir.op_end()]), "non-void block type 1")) {
    return 102;
  }

  if (sp_bail([ir.op_end()]) != "end with no open scope") {
    return 103;
  }
  if (sp_bail([ir.op_block(0), ir.op_else(), ir.op_end()]) != "malformed else") {
    return 104;
  }
  if (sp_bail([ir.op_block(0), ir.op_br(9), ir.op_end()]) != "branch depth has no target") {
    return 105;
  }

  if (sp_bail([ir.op_const_i32(1), ir.op_return()]).len() != 0) {
    return 106;
  }

  let cov: irverifystack.Coverage = irverifystack.coverage_new();
  cov = irverifystack.coverage_add(cov, "a", "");
  cov = irverifystack.coverage_add(cov, "b", "unmodelled op load");
  cov = irverifystack.coverage_add(cov, "c", "unmodelled op load");
  if (cov.funcs != 3 || cov.modelled != 1) {
    return 110;
  }
  if (cov.skipped_fns.len() != 2 || cov.skipped_fns[0] != "b") {
    return 111;
  }
  if (!util.contains(irverifystack.coverage_str(cov), "modelled 1/3")) {
    return 112;
  }
  if (!util.contains(irverifystack.coverage_str(cov), "skipped 2: unmodelled op load")) {
    return 113;
  }
  return 0;
}

function fip_claim(kw: string, allowance: i32): irfipverify.FipClaim {
  return irfipverify.FipClaim { fn_name: "f", is_fip: kw == "fip", is_fbip: kw == "fbip", allowance: allowance };
}

function fip_problems(kw: string, allowance: i32, ops: ir.Op[]): i32 {
  return irfipverify.verify_fip_fn(fip_claim(kw, allowance), ops).problems.len();
}

function fip_msg(kw: string, allowance: i32, ops: ir.Op[]): string {
  let r: irfipverify.FipResult = irfipverify.verify_fip_fn(fip_claim(kw, allowance), ops);
  if (r.problems.len() == 0) {
    return "";
  }
  return irverify.problem_str(r.problems[0]);
}

function fip_checks(): i32 {
  let fresh_struct: ir.Op[] = [ir.op_const_i32(1), ir.op_const_i32(2), ir.op_struct_make("P", 2, 0 - 1)];
  let paired_struct: ir.Op[] = [ir.op_const_i32(0), ir.op_const_i32(3), ir.op_call_direct("__fern_alloc_reuse", 2)];

  if (fip_problems("fbip", 0, fresh_struct) != 1) {
    return 120;
  }
  if (fip_problems("fbip", 1, fresh_struct) != 0) {
    return 121;
  }
  if (fip_problems("fip", 0, fresh_struct) != 1) {
    return 122;
  }
  if (fip_problems("fip", 1, fresh_struct) != 0) {
    return 123;
  }

  if (fip_problems("", 0, fresh_struct) != 0) {
    return 124;
  }

  if (fip_problems("fbip", 0, paired_struct) != 0) {
    return 125;
  }
  let pr: irfipverify.FipResult = irfipverify.verify_fip_fn(fip_claim("fbip", 0), paired_struct);
  if (pr.paired != 1 || pr.fresh != 0) {
    return 126;
  }
  if (irfipverify.verify_fip_fn(fip_claim("fbip", 0), [ir.op_call_direct("__fern_rc_dec", 1)]).paired != 0) {
    return 127;
  }

  if (fip_problems("fbip", 0, [ir.op_struct_make("P", 2, 0 - 1)]) != 1) {
    return 130;
  }
  if (fip_problems("fbip", 0, [ir.op_tuple_make(2)]) != 1) {
    return 132;
  }
  if (fip_problems("fbip", 0, [ir.op_arr_make(3, 32)]) != 1) {
    return 133;
  }
  if (fip_problems("fbip", 0, [ir.op_opt_make(1)]) != 1) {
    return 134;
  }
  if (fip_problems("fbip", 0, [ir.op_str_concat()]) != 1) {
    return 135;
  }
  if (fip_problems("fbip", 0, [ir.op_alloc()]) != 1) {
    return 136;
  }

  if (fip_problems("fip", 0, [ir.op_const_struct("P", 2, "1,2")]) != 0) {
    return 137;
  }
  if (fip_problems("fip", 0, [ir.op_heap_bump_bytes()]) != 0) {
    return 138;
  }
  if (fip_problems("fip", 0, [ir.op_struct_get(0, 0), ir.op_const_i32(1)]) != 0) {
    return 139;
  }

  let mixed: ir.Op[] = [ir.op_struct_make("P", 2, 0 - 1), ir.op_call_direct("__fern_alloc_reuse", 2), ir.op_tuple_make(2)];
  let mr: irfipverify.FipResult = irfipverify.verify_fip_fn(fip_claim("fbip", 2), mixed);
  if (mr.fresh != 2 || mr.paired != 1) {
    return 140;
  }
  if (mr.problems.len() != 0) {
    return 141;
  }

  let over: irfipverify.FipResult = irfipverify.verify_fip_fn(fip_claim("fbip", 0), mixed);
  if (over.problems.len() != 1) {
    return 150;
  }
  let m: string = irverify.problem_str(over.problems[0]);
  if (!util.contains(m, "`fbip` function \"f\" allocates: 2 un-reused allocation site(s)")) {
    return 151;
  }
  if (!util.contains(m, "allowance of 0")) {
    return 152;
  }
  if (!util.contains(m, "struct/enum construction \"P\" at op 0")) {
    return 153;
  }
  if (!util.contains(m, "tuple literal at op 2")) {
    return 154;
  }
  if (!util.contains(fip_msg("fip", 0, mixed), "`fip` function")) {
    return 155;
  }

  if (!util.contains(fip_msg("fip", 0, fresh_struct), "grade the claim (`fip(n)`)")) {
    return 156;
  }
  if (util.contains(fip_msg("fip", 0, fresh_struct), "checker/IR drift")) {
    return 161;
  }
  if (!util.contains(fip_msg("fip", 1, mixed), "grade the claim (`fip(n)`)")) {
    return 157;
  }
  if (!util.contains(fip_msg("fbip", 0, fresh_struct), "grade the claim (`fbip(n)`)")) {
    return 158;
  }

  if (over.problems[0].op >= 0) {
    return 159;
  }
  if (!util.contains(m, "f: `fbip` function")) {
    return 160;
  }
  return 0;
}

function pv_count(ops: ir.Op[], declared: string[]): i32 {
  return irverifyprovided.verify_provided_fn("f", ops, irverify.name_index(declared)).problems.len();
}

function pv_msg(ops: ir.Op[], declared: string[]): string {
  let r: irverifyprovided.ProvidedResult = irverifyprovided.verify_provided_fn("f", ops, irverify.name_index(declared));
  if (r.problems.len() == 0) {
    return "";
  }
  return irverify.problem_str(r.problems[0]);
}

function provided_checks(): i32 {
  let none: string[] = [];
  let decl: string[] = ["main", "helper"];

  if (pv_count([ir.op_call_direct("nope", 1)], decl) != 1) {
    return 70;
  }
  if (!util.contains(
    pv_msg([ir.op_call_direct("nope", 1)], decl),
    "calls nope, which the program does not declare and no backend provides",
  )) {
    return 71;
  }
  if (!util.contains(
    pv_msg([ir.op_load_local(0), ir.op_call_direct("nope", 1)], decl),
    "f: op 1 (call_direct):",
  )) {
    return 72;
  }

  if (pv_count([ir.op_call_direct("helper", 1)], decl) != 0) {
    return 73;
  }
  if (pv_count([ir.op_call_direct("__fern_rc_dec", 1)], none) != 0) {
    return 74;
  }
  if (pv_count([ir.op_call_direct("__fern_arr_str_join", 2)], none) != 0) {
    return 75;
  }
  let task_ops: ir.Op[] = [ir.op_call_direct("__fern_task_new", 0), ir.op_call_direct("__fern_task_free", 1), ir.op_call_direct("__fern_task_cur", 0), ir.op_call_direct("__fern_task_enter", 2), ir.op_call_direct("__fern_task_leave", 0), ir.op_call_direct("__fern_task_park", 2), ir.op_call_direct("__fern_task_wait", 1), ir.op_call_direct("__fern_task_timeout", 1), ir.op_call_direct("__fern_task_set_ready", 2), ir.op_call_direct("__fern_task_set_cancelled", 1), ir.op_call_direct("__fern_task_cancelled", 0), ir.op_call_direct("__fern_task_mode", 0), ir.op_call_direct("__fern_task_reserve", 1), ir.op_call_direct("__fern_task_take", 1), ir.op_call_direct("__fern_task_pop_w", 0)];
  if (pv_count(task_ops, none) != 0) {
    return 109;
  }
  if (pv_count([ir.op_call_direct("__fern_task_push_f32", 1), ir.op_call_direct("__fern_task_pop_w_typo", 0)], none) != 2) {
    return 110;
  }
  if (pv_count([ir.op_call_direct("__sem_drop_Holder", 1)], none) != 0) {
    return 76;
  }
  if (pv_count([ir.op_call_direct("__sem_release_Box", 1)], none) != 0) {
    return 77;
  }
  if (pv_count([ir.op_call_direct("__c_call0", 1)], none) != 0) {
    return 78;
  }
  if (pv_count([ir.op_call_direct("__c_call4_f64", 5)], none) != 0) {
    return 79;
  }
  if (pv_count([ir.op_call_direct("__c_call5", 1)], none) != 1) {
    return 80;
  }
  if (pv_count([ir.op_call_direct("__c_call0_f16", 1)], none) != 1) {
    return 81;
  }
  if (pv_count([ir.op_call_direct("__sem_drop_", 1)], none) != 1) {
    return 82;
  }
  if (pv_count([ir.op_call_direct("__fern_rc_de", 1)], none) != 1) {
    return 83;
  }

  if (pv_count([ir.op_call_direct("", 1)], none) != 0) {
    return 84;
  }
  if (pv_count([ir.op_call_indirect(2)], none) != 0) {
    return 85;
  }

  let mixed: ir.Op[] = [ir.op_call_direct("helper", 1), ir.op_call_direct("__fern_rc_inc", 1), ir.op_call_direct("nope", 0)];
  let mr: irverifyprovided.ProvidedResult = irverifyprovided.verify_provided_fn("f", mixed, irverify.name_index(decl));
  if (mr.calls != 3) {
    return 86;
  }
  if (mr.problems.len() != 1) {
    return 87;
  }

  let big: string[] = [];
  let i: i32 = 0;
  while (i < 3000) {
    big = big.append("fn_" + util.i32_to_string(i));
    i = i + 1;
  }
  let ix: irverify.NameIndex = irverify.name_index(big);
  if (!irverify.index_has(ix, "fn_0")) {
    return 88;
  }
  if (!irverify.index_has(ix, "fn_1499")) {
    return 89;
  }
  if (!irverify.index_has(ix, "fn_2999")) {
    return 90;
  }
  if (irverify.index_has(ix, "fn_3000")) {
    return 91;
  }
  if (irverify.index_has(ix, "")) {
    return 92;
  }
  let placed: i32 = 0;
  let pj: i32 = 0;
  while (pj < big.len()) {
    if (irverify.index_has(ix, big[pj])) {
      placed = placed + 1;
    }
    pj = pj + 1;
  }
  if (placed != 3000) {
    return 93;
  }
  if (irverify.index_has(irverify.name_index(none), "x")) {
    return 94;
  }

  let dsigs: irverify.FnSig[] = [
    irverify.FnSig { name: "dup", n_params: 2 },
    irverify.FnSig { name: "other", n_params: 1 },
    irverify.FnSig { name: "dup", n_params: 7 },
  ];
  let dix: irverify.NameIndex = irverify.sig_index(dsigs);
  if (irverify.index_params(dix, "dup") != 2) {
    return 97;
  }
  if (irverify.index_params(dix, "other") != 1) {
    return 98;
  }
  if (irverify.index_params(dix, "absent") != 0 - 1) {
    return 99;
  }
  let mix: irverify.NameIndex = irverify.name_index(["solo"]);
  if (!irverify.index_has(mix, "solo")) {
    return 107;
  }
  if (irverify.index_params(mix, "solo") != 0 - 1) {
    return 108;
  }

  let inv: string[] = irverifyprovided.provided_names();
  if (inv.len() < 30) {
    return 95;
  }
  let vi: i32 = 0;
  while (vi < inv.len()) {
    if (!irverifyprovided.is_provided(inv[vi])) {
      return 96;
    }
    vi = vi + 1;
  }
  return 0;
}

function gate_checks(): i32 {
  let clean: ir.Op[] = [ir.op_const_i32(1), ir.op_return()];
  if (irverifygate.verify_problems("f", clean, 0, 1, irverifygate.gate(no_sigs(), ir.pops_by_kind(), rccertify.no_abis())).len() != 0) {
    return 170;
  }

  let bad_slot: ir.Op[] = [ir.op_load_local(5), ir.op_return()];
  if (irverifygate.verify_problems("f", bad_slot, 0, 1, irverifygate.gate(no_sigs(), ir.pops_by_kind(), rccertify.no_abis())).len() != 1) {
    return 171;
  }
  if (!util.contains(
    irverify.problem_str(irverifygate.verify_problems("f", bad_slot, 0, 1, irverifygate.gate(no_sigs(), ir.pops_by_kind(), rccertify.no_abis()))[0]),
    "is outside the frame",
  )) {
    return 172;
  }

  let underflow: ir.Op[] = [ir.op_const_i32(1), ir.op_bin("add", 0, false), ir.op_return()];
  if (irverifygate.verify_problems("f", underflow, 0, 1, irverifygate.gate(no_sigs(), ir.pops_by_kind(), rccertify.no_abis())).len() != 1) {
    return 173;
  }
  if (!util.contains(
    irverify.problem_str(irverifygate.verify_problems("f", underflow, 0, 1, irverifygate.gate(no_sigs(), ir.pops_by_kind(), rccertify.no_abis()))[0]),
    "operand stack underflow",
  )) {
    return 174;
  }

  let both: ir.Op[] = [ir.op_load_local(5), ir.op_bin("add", 0, false), ir.op_return()];
  let bps: irverify.Problem[] = irverifygate.verify_problems("f", both, 0, 1, irverifygate.gate(no_sigs(), ir.pops_by_kind(), rccertify.no_abis()));
  if (bps.len() != 2) {
    return 175;
  }
  if (!util.contains(irverify.problem_str(bps[0]), "is outside the frame")) {
    return 176;
  }
  if (!util.contains(irverify.problem_str(bps[1]), "operand stack underflow")) {
    return 177;
  }

  let sigs: irverify.NameIndex = irverify.sig_index([irverify.FnSig { name: "takes2", n_params: 2 }]);
  let arity: ir.Op[] = [ir.op_call_direct("takes2", 0), ir.op_return()];
  let aps: irverify.Problem[] = irverifygate.verify_problems("f", arity, 0, 1, irverifygate.gate(sigs, ir.pops_by_kind(), rccertify.no_abis()));
  if (aps.len() != 1) {
    return 178;
  }
  if (!util.contains(irverify.problem_str(aps[0]), "calls takes2 with 0 args")) {
    return 179;
  }
  if (irverifygate.verify_problems("f", arity, 0, 1, irverifygate.gate(no_sigs(), ir.pops_by_kind(), rccertify.no_abis())).len() != 0) {
    return 180;
  }
  return 0;
}

function refuse_probe(): i32 {
  let malformed: ir.Op[] = [ir.op_load_local(5), ir.op_return()];
  irverifygate.verify_or_refuse("probe", malformed, 0, 1, irverifygate.gate(no_sigs(), ir.pops_by_kind(), rccertify.no_abis()));
  print("irverifygate: inert (FERN_IR_VERIFY=0)");
  return 0;
}

function raw_op(kind: string): ir.Op {
  return ir.Op { source: 0, decl: 0 - 1, kind_tag: ir.kind_id(kind), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

function selfhost_reuse(gate: i32, token: i32): ir.Op[] {
  return [
    ir.op_load_local(gate),
    ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_tee_local(3),
    ir.op_if(0),
    ir.op_load_local(token),
    ir.op_store_local(4),
    ir.op_else(),
    ir.op_const_i32(0),
    ir.op_store_local(4),
    ir.op_end(),
    ir.op_load_local(4),
    ir.op_const_i32(3),
    ir.op_call_direct("__fern_alloc_reuse", 2),
  ];
}

function keep_reuse(gate: i32, token: i32, dec: i32): ir.Op[] {
  return [
    ir.op_load_local(gate),
    ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_if(0),
    ir.op_load_local(token),
    ir.op_store_local(4),
    ir.op_else(),
    ir.op_const_i32(0),
    ir.op_store_local(4),
    ir.op_end(),
    ir.op_load_local(4),
    ir.op_const_i32(0),
    ir.op_bin("eq", 0, false),
    ir.op_if(0),
    ir.op_load_local(4),
    ir.op_const_i32(3),
    ir.op_call_direct("__fern_alloc_reuse", 2),
    ir.op_store_local(5),
    ir.op_load_local(5),
    ir.op_struct_set_shape("P"),
    ir.op_drop(),
    ir.op_load_local(5),
    ir.op_load_local(gate),
    ir.op_struct_get(1, 0),
    ir.op_call_direct("__fern_rc_inc", 1),
    ir.op_struct_set(1, 0),
    ir.op_else(),
    ir.op_load_local(4),
    ir.op_store_local(5),
    ir.op_end(),
    ir.op_load_local(4),
    ir.op_const_i32(0),
    ir.op_bin("ne", 0, false),
    ir.op_if(0),
    ir.op_else(),
    ir.op_load_local(dec),
    ir.op_call_direct("__sem_release_P", 1),
    ir.op_drop(),
    ir.op_end(),
    ir.op_const_i32(0),
    ir.op_store_local(gate),
  ];
}

function rc_flow_matches(ops: ir.Op[], problems: i32): boolean {
  let r: irverifyrc.RcResult = irverifyrc.verify_rc_fn("flow", ops);
  return r.sites == 2 && r.checked == 2 && r.problems.len() == problems;
}

function rc_branch_paths(): i32 {
  let skipped: ir.Op[] = concat_ops([ir.op_block(0)], selfhost_reuse(1, 1));
  skipped = concat_ops(skipped, [ir.op_br(0)]);
  skipped = concat_ops(skipped, selfhost_reuse(1, 1));
  skipped = concat_ops(skipped, [ir.op_end()]);
  if (!rc_flow_matches(skipped, 0)) {
    return 224;
  }
  let conditional: ir.Op[] = concat_ops([ir.op_block(0)], selfhost_reuse(1, 1));
  conditional = concat_ops(conditional, [ir.op_const_i32(1), ir.op_brif(0)]);
  conditional = concat_ops(conditional, selfhost_reuse(1, 1));
  conditional = concat_ops(conditional, [ir.op_end()]);
  if (!rc_flow_matches(conditional, 1)) {
    return 225;
  }

  let nested: ir.Op[] = concat_ops([ir.op_block(0), ir.op_block(0)], selfhost_reuse(1, 1));
  let outer: ir.Op[] = concat_ops(nested, [ir.op_br(1), ir.op_end()]);
  outer = concat_ops(outer, selfhost_reuse(1, 1));
  outer = concat_ops(outer, [ir.op_end()]);
  if (!rc_flow_matches(outer, 0)) {
    return 226;
  }
  nested = concat_ops(nested, [ir.op_br(0), ir.op_end()]);
  nested = concat_ops(nested, selfhost_reuse(1, 1));
  nested = concat_ops(nested, [ir.op_end()]);
  if (!rc_flow_matches(nested, 1)) {
    return 227;
  }

  let partial: ir.Op[] = concat_ops(selfhost_reuse(1, 1), [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(0), ir.op_store_local(1), ir.op_end()]);
  partial = concat_ops(partial, selfhost_reuse(1, 1));
  if (!rc_flow_matches(partial, 1)) {
    return 228;
  }
  let both: ir.Op[] = concat_ops(selfhost_reuse(1, 1), [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(0), ir.op_store_local(1), ir.op_else(), ir.op_const_i32(0), ir.op_tee_local(1), ir.op_drop(), ir.op_end()]);
  both = concat_ops(both, selfhost_reuse(1, 1));
  if (!rc_flow_matches(both, 0)) {
    return 229;
  }

  let cycling: ir.Op[] = concat_ops([ir.op_block(0), ir.op_loop(0)], selfhost_reuse(1, 1));
  let forever: ir.Op[] = concat_ops(cycling, [ir.op_br(0), ir.op_end(), ir.op_end()]);
  forever = concat_ops(forever, selfhost_reuse(1, 1));
  if (!rc_flow_matches(forever, 0)) {
    return 230;
  }
  cycling = concat_ops(cycling, [ir.op_const_i32(1), ir.op_brif(1), ir.op_br(0), ir.op_end(), ir.op_end()]);
  cycling = concat_ops(cycling, selfhost_reuse(1, 1));
  if (!rc_flow_matches(cycling, 1)) {
    return 231;
  }

  let returned: ir.Op[] = concat_ops(selfhost_reuse(1, 1), [ir.op_br(0)]);
  returned = concat_ops(returned, selfhost_reuse(1, 1));
  if (!rc_flow_matches(returned, 0)) {
    return 232;
  }
  return 0;
}

function native_reuse(gate: i32, token: i32, dec: i32): ir.Op[] {
  return [
    ir.op_load_local(gate),
    ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_store_local(3),
    ir.op_load_local(3),
    ir.op_if(0),
    ir.op_load_local(token),
    ir.op_const_i32(8),
    raw_op("sub"),
    ir.op_store_local(4),
    ir.op_else(),
    ir.op_load_local(dec),
    ir.op_call_direct("__fern_rc_dec", 1),
    ir.op_drop(),
    ir.op_const_i32(0),
    ir.op_store_local(4),
    ir.op_end(),
    ir.op_const_i32(0),
    ir.op_store_local(gate),
    ir.op_load_local(4),
    ir.op_const_i32(24),
    ir.op_const_i32(24),
    ir.op_call_direct("__alloc_reuse", 3),
  ];
}

function concat_ops(a: ir.Op[], b: ir.Op[]): ir.Op[] {
  let out: ir.Op[] = a;
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

function rc_only_skip(ops: ir.Op[], why: string): boolean {
  let r: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", ops);
  if (r.problems.len() != 0 || r.sites != 1 || r.checked != 0) {
    return false;
  }
  if (r.skips.len() != 1) {
    return false;
  }
  return r.skips[0] == why;
}

function rc_checks(): i32 {
  let sh: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", selfhost_reuse(1, 1));
  if (sh.problems.len() != 0) {
    return 190;
  }
  if (sh.sites != 1 || sh.checked != 1) {
    return 191;
  }

  let na: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", native_reuse(1, 1, 1));
  if (na.problems.len() != 0) {
    return 192;
  }
  if (na.sites != 1 || na.checked != 1) {
    return 193;
  }

  let t1: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", selfhost_reuse(1, 2));
  if (t1.checked != 1) {
    return 194;
  }
  if (t1.problems.len() != 1) {
    return 195;
  }
  if (!util.contains(t1.problems[0].msg, "never proved unique")) {
    return 196;
  }

  let t2: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", native_reuse(1, 2, 1));
  if (t2.problems.len() != 1) {
    return 197;
  }
  if (!util.contains(t2.problems[0].msg, "never proved unique")) {
    return 198;
  }

  let d1: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", native_reuse(1, 1, 2));
  if (d1.checked != 1) {
    return 199;
  }
  if (d1.problems.len() != 1) {
    return 200;
  }
  if (!util.contains(d1.problems[0].msg, "leaks on the decline path")) {
    return 201;
  }

  let no_gate: ir.Op[] = selfhost_reuse(1, 1).with(1, ir.op_drop());
  if (!rc_only_skip(no_gate, "no uniqueness gate before the token select")) {
    return 202;
  }

  let no_else: ir.Op[] = [
    ir.op_load_local(1),
    ir.op_call_direct("__fern_rc_is_unique", 1),
    ir.op_tee_local(3),
    ir.op_if(0),
    ir.op_load_local(1),
    ir.op_store_local(4),
    ir.op_end(),
    ir.op_load_local(4),
    ir.op_const_i32(3),
    ir.op_call_direct("__fern_alloc_reuse", 2),
  ];
  if (!rc_only_skip(no_else, "token select has no decline arm")) {
    return 203;
  }

  let const_token: ir.Op[] = selfhost_reuse(1, 1).with(10, ir.op_const_i32(0));
  if (!rc_only_skip(const_token, "token argument is not a local load")) {
    return 204;
  }

  let cond_not_local: ir.Op[] = native_reuse(1, 1, 1).with(3, ir.op_const_i32(1));
  if (!rc_only_skip(cond_not_local, "token select is not conditioned on a local")) {
    return 205;
  }

  if (sh.checked != 1) {
    return 206;
  }

  let plain: ir.Op[] = [ir.op_load_local(1), ir.op_call_direct("__fern_rc_inc", 1), ir.op_drop()];
  let pr: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", plain);
  if (pr.problems.len() != 0 || pr.sites != 0) {
    return 207;
  }

  let gp: irverify.Problem[] = irverifygate.verify_problems("f", selfhost_reuse(1, 2), 0, 8, irverifygate.gate(no_sigs(), ir.pops_by_kind(), rccertify.no_abis()));
  let seen: boolean = false;
  let gi: i32 = 0;
  while (gi < gp.len()) {
    if (util.contains(gp[gi].msg, "never proved unique")) {
      seen = true;
    }
    gi = gi + 1;
  }
  if (!seen) {
    return 208;
  }

  let twice: ir.Op[] = concat_ops(selfhost_reuse(1, 1), selfhost_reuse(1, 1));
  let tw: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", twice);
  if (tw.sites != 2 || tw.checked != 2) {
    return 211;
  }
  if (tw.problems.len() != 1) {
    return 212;
  }
  if (!util.contains(tw.problems[0].msg, "one allocation handed to two recipients")) {
    return 213;
  }

  let arms: ir.Op[] = concat_ops([ir.op_const_i32(1), ir.op_if(0)], selfhost_reuse(1, 1));
  arms = concat_ops(arms, [ir.op_else()]);
  arms = concat_ops(arms, selfhost_reuse(1, 1));
  arms = concat_ops(arms, [ir.op_end()]);
  let ar: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", arms);
  if (ar.checked != 2) {
    return 214;
  }
  if (ar.problems.len() != 0) {
    return 215;
  }

  let rebound: ir.Op[] = concat_ops(selfhost_reuse(1, 1), [ir.op_const_i32(0), ir.op_store_local(1)]);
  rebound = concat_ops(rebound, selfhost_reuse(1, 1));
  let rb: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", rebound);
  if (rb.checked != 2 || rb.problems.len() != 0) {
    return 216;
  }

  let distinct: ir.Op[] = concat_ops(selfhost_reuse(1, 1), selfhost_reuse(2, 2));
  let di: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", distinct);
  if (di.checked != 2 || di.problems.len() != 0) {
    return 217;
  }

  let stopped: ir.Op[] = concat_ops(selfhost_reuse(1, 1), [ir.op_return()]);
  stopped = concat_ops(stopped, selfhost_reuse(1, 1));
  let sr: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", stopped);
  if (sr.checked != 2 || sr.problems.len() != 0) {
    return 221;
  }
  let conditional: ir.Op[] = concat_ops(selfhost_reuse(1, 1), [ir.op_const_i32(1), ir.op_if(0), ir.op_return(), ir.op_end()]);
  conditional = concat_ops(conditional, selfhost_reuse(1, 1));
  let cr: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", conditional);
  if (cr.checked != 2 || cr.problems.len() != 1) {
    return 222;
  }
  let unknown: ir.Op[] = concat_ops(selfhost_reuse(1, 1), [raw_op("not_an_op_kind")]);
  unknown = concat_ops(unknown, selfhost_reuse(1, 1));
  let ur: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", unknown);
  if (ur.checked != 2 || ur.problems.len() != 1) {
    return 223;
  }

  let kc: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", keep_reuse(1, 1, 1));
  if (kc.checked != 1 || kc.problems.len() != 0) {
    return 218;
  }
  let kt: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", keep_reuse(1, 2, 1));
  if (kt.checked != 1 || kt.problems.len() != 1 || !util.contains(kt.problems[0].msg, "never proved unique")) {
    return 219;
  }
  let kd: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", keep_reuse(1, 1, 2));
  if (kd.checked != 1 || kd.problems.len() != 1 || !util.contains(kd.problems[0].msg, "leaks on the decline path")) {
    return 220;
  }

  let branch_paths: i32 = rc_branch_paths();
  if (branch_paths != 0) {
    return branch_paths;
  }
  if (!util.contains(irverifyrc.rc_coverage_str(sh), "reuse sites modelled 1/1")) {
    return 209;
  }
  let skipped: irverifyrc.RcResult = irverifyrc.verify_rc_fn("f", no_gate);
  if (!util.contains(irverifyrc.rc_coverage_str(skipped), "skipped 1: no uniqueness gate")) {
    return 210;
  }

  return 0;
}

function main(): i32 {
  let av: string[] = args();
  let ai: i32 = 0;
  while (ai < av.len()) {
    if (av[ai] == "-refuse") {
      return refuse_probe();
    }
    ai = ai + 1;
  }

  let in_range: ir.Op[] = [ir.op_load_local(0), ir.op_store_local(2), ir.op_tee_local(1)];
  if (count_problems(in_range, 1, 3) != 0) {
    return 1;
  }

  let past_end: ir.Op[] = [ir.op_load_local(3)];
  if (count_problems(past_end, 1, 3) != 1) {
    return 2;
  }

  let negative_idx: ir.Op[] = [ir.op_store_local(0 - 1)];
  if (count_problems(negative_idx, 1, 3) != 1) {
    return 3;
  }

  let m1: string = first_msg(past_end, 1, 3);
  if (!util.contains(m1, "local index 3 is outside the frame")) {
    return 4;
  }
  if (!util.contains(m1, "1 params + 2 locals = 3 slots")) {
    return 5;
  }

  if (count_problems([ir.op_load_local(0)], 0, 0) != 1) {
    return 6;
  }

  let balanced: ir.Op[] = [ir.op_block(0), ir.op_end()];
  if (count_problems(balanced, 0, 1) != 0) {
    return 10;
  }

  let if_else: ir.Op[] = [ir.op_if(0), ir.op_else(), ir.op_end()];
  if (count_problems(if_else, 0, 1) != 0) {
    return 11;
  }

  let nested: ir.Op[] = [ir.op_block(0), ir.op_loop(0), ir.op_if(0), ir.op_else(), ir.op_end(), ir.op_end(), ir.op_end()];
  if (count_problems(nested, 0, 1) != 0) {
    return 12;
  }

  let unclosed: ir.Op[] = [ir.op_block(0)];
  if (count_problems(unclosed, 0, 1) != 1) {
    return 13;
  }
  if (!util.contains(first_msg(unclosed, 0, 1), "scope is never closed")) {
    return 14;
  }

  if (count_problems([ir.op_block(0), ir.op_loop(0)], 0, 1) != 2) {
    return 15;
  }

  let extra_end: ir.Op[] = [ir.op_end()];
  if (count_problems(extra_end, 0, 1) != 1) {
    return 16;
  }
  if (!util.contains(first_msg(extra_end, 0, 1), "end with no open scope")) {
    return 17;
  }

  let else_on_block: ir.Op[] = [ir.op_block(0), ir.op_else(), ir.op_end()];
  if (count_problems(else_on_block, 0, 1) != 1) {
    return 18;
  }
  if (!util.contains(first_msg(else_on_block, 0, 1), "else closes a block")) {
    return 19;
  }

  let double_else: ir.Op[] = [ir.op_if(0), ir.op_else(), ir.op_else(), ir.op_end()];
  if (count_problems(double_else, 0, 1) != 1) {
    return 20;
  }
  if (!util.contains(first_msg(double_else, 0, 1), "second else")) {
    return 21;
  }

  if (count_problems([ir.op_else()], 0, 1) != 1) {
    return 22;
  }

  let br0: ir.Op[] = [ir.op_block(0), ir.op_br(0), ir.op_end()];
  if (count_problems(br0, 0, 1) != 0) {
    return 30;
  }

  let br1: ir.Op[] = [ir.op_block(0), ir.op_br(1), ir.op_end()];
  if (count_problems(br1, 0, 1) != 0) {
    return 31;
  }

  let br2: ir.Op[] = [ir.op_block(0), ir.op_br(2), ir.op_end()];
  if (count_problems(br2, 0, 1) != 1) {
    return 32;
  }
  if (!util.contains(first_msg(br2, 0, 1), "branch depth 2 has no target")) {
    return 33;
  }

  if (count_problems([ir.op_block(0), ir.op_brif(1), ir.op_end()], 0, 1) != 0) {
    return 34;
  }
  if (count_problems([ir.op_block(0), ir.op_brif(2), ir.op_end()], 0, 1) != 1) {
    return 35;
  }

  if (count_problems([ir.op_br(0)], 0, 1) != 0) {
    return 36;
  }
  if (count_problems([ir.op_br(1)], 0, 1) != 1) {
    return 37;
  }

  if (count_problems([ir.op_block(0), ir.op_br(0 - 1), ir.op_end()], 0, 1) != 1) {
    return 38;
  }

  let sigs: irverify.NameIndex = irverify.sig_index([
    irverify.FnSig { name: "takes2", n_params: 2 },
    irverify.FnSig { name: "takes0", n_params: 0 },
  ]);

  let call_ok: ir.Op[] = [ir.op_call_direct("takes2", 2)];
  if (irverify.verify_fn("f", call_ok, 0, 1, sigs).len() != 0) {
    return 40;
  }

  let call_env: ir.Op[] = [ir.op_call_direct("takes2", 1)];
  if (irverify.verify_fn("f", call_env, 0, 1, sigs).len() != 0) {
    return 41;
  }

  let call_bad: ir.Op[] = [ir.op_call_direct("takes2", 0)];
  let bad_ps: irverify.Problem[] = irverify.verify_fn("f", call_bad, 0, 1, sigs);
  if (bad_ps.len() != 1) {
    return 42;
  }
  if (!util.contains(irverify.problem_str(bad_ps[0]), "calls takes2 with 0 args, but it declares 2")) {
    return 43;
  }

  if (irverify.verify_fn("f", [ir.op_call_direct("takes2", 3)], 0, 1, sigs).len() != 1) {
    return 44;
  }

  if (irverify.verify_fn("f", [ir.op_call_direct("__fern_rc_inc", 1)], 0, 1, sigs).len() != 0) {
    return 45;
  }
  if (irverify.verify_fn("f", [ir.op_call_direct("print", 1)], 0, 1, sigs).len() != 0) {
    return 46;
  }

  if (count_problems([ir.op_call_direct("takes2", 99)], 0, 1) != 0) {
    return 47;
  }

  if (count_problems([ir.op_call_direct("anything", 0 - 1)], 0, 1) != 1) {
    return 48;
  }

  if (count_problems([ir.op_call_direct("", 1)], 0, 1) != 1) {
    return 49;
  }

  if (count_problems([ir.op_call_indirect(2)], 0, 1) != 0) {
    return 50;
  }
  if (count_problems([ir.op_call_indirect(0 - 1)], 0, 1) != 1) {
    return 51;
  }

  let many: ir.Op[] = [ir.op_load_local(9), ir.op_end(), ir.op_br(4)];
  let mp: irverify.Problem[] = irverify.verify_fn("g", many, 0, 1, no_sigs());
  if (mp.len() != 3) {
    return 60;
  }
  if (mp[0].op != 0 || mp[1].op != 1 || mp[2].op != 2) {
    return 61;
  }
  if (mp[0].fn_name != "g") {
    return 62;
  }

  if (!util.contains(irverify.problem_str(mp[0]), "g: op 0 (load_local):")) {
    return 63;
  }

  if (!util.contains(irverify.format_problems(mp, 2), "... and 1 more")) {
    return 64;
  }
  if (util.contains(irverify.format_problems(mp, 10), "more")) {
    return 65;
  }

  if (irverify.format_problems(irverify.verify_fn("f", balanced, 0, 1, no_sigs()), 10).len() != 0) {
    return 66;
  }

  let sc: i32 = stack_checks();
  if (sc != 0) {
    return sc;
  }

  let fc: i32 = fip_checks();
  if (fc != 0) {
    return fc;
  }

  let pc: i32 = provided_checks();
  if (pc != 0) {
    return pc;
  }

  let gc: i32 = gate_checks();
  if (gc != 0) {
    return gc;
  }

  let rc: i32 = rc_checks();
  if (rc != 0) {
    return rc;
  }

  print("irverify: all structural checks agree");
  print("irverifystack: all stack checks agree");
  print("irfipverify: all allocation-budget checks agree");
  print("irverifyprovided: all callee-resolution checks agree");
  print("irverifyrc: all reuse-donor checks agree");
  print("irverifygate: compile-path gate agrees");
  return 0;
}
