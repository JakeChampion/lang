import "../irtables";
import "../util";
import "std/string";

function ref_trim(s: string): string {
  let a = 0;
  let b = s.len();
  while (a < b && s[a] == b' ') {
    a += 1;
  }
  while (b > a && s[b - 1] == b' ') {
    b -= 1;
  }
  return slice_unchecked(s, a, b).to_owned();
}

function ref_elem_tag(t: string, n: i32): string {
  let len = t.len();
  if (len < 3 || slice_unchecked(t, 0, 1) != "(" || slice_unchecked(t, len - 1, len) != ")") {
    return "";
  }
  let inner = slice_unchecked(t, 1, len - 1);
  let depth = 0;
  let start = 0;
  let idx = 0;
  for i in 0..=inner.len() {
    if (i == inner.len() || depth == 0 && inner[i] == b',') {
      if (idx == n) {
        return ref_trim(slice_unchecked(inner, start, i));
      }
      idx += 1;
      start = i + 1;
    } else {
      let ch = inner[i] as i32;
      if (ch == 91 || ch == 40) {
        depth += 1;
      } else if (ch == 93 || ch == 41) {
        depth -= 1;
      }
    }
  }
  return "";
}

function show(s: string): string {
  if (s.len() == 0) {
    return "<empty>";
  }

  return s;
}

function main(): i32 {
  let corpus: string[] = [
    "(i32, i32)", "(i32, string, boolean)", "(Map[a, b], i32)",
    "((a, b), c)", "(i32[], string)", "(Option[i32], Result[i32, u32])",
    "(x)", "(i32, i32)[]", "()", "i32", "Map[a, b]", "Option[i32]", "",
    "(a, (b, c), d)",
  ];
  let out = "";
  let bad = 0;
  for i in 0..corpus.len() {
    let t = corpus[i];
    for n in -1..=4 {
      let real = irtables.tuple_type_elem_tag(t, n);
      let ref = ref_elem_tag(t, n);
      let mark = "ok  ";
      if (real != ref) {
        mark = "BAD ";
        bad += 1;
      }
      out = out + mark + show(t) + "[" + util.i32_to_string(n) + "]=" + show(real) + "\n";
    }
  }
  out = out + "mismatches=" + util.i32_to_string(bad) + "\n";
  write(out);
  return bad;
}
