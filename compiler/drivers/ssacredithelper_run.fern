import "../lexer";
import "../parser";
import "../semlower";
import "../irtables";
import "../ir";
import "../ssa";
import "../ssa_lift";
import "../ssacredithelper" as proof;

function require(ok: boolean, id: i32): void {
  if (!ok) {
    exit(id);
  }
}

function lift(r: irtables.LowerResult): ssa.SFunc {
  require(r.ok, 1);
  let lifted = ssa_lift.lift_from_ir_prod(ssa_lift.kind_table(), r.name, r.n_params, r.n_locals, r.ops, false);
  if (!lifted.ok) {
    print(lifted.bail);
    exit(2);
  }
  return lifted.func;
}

function expect(p: proof.Proof, ok: boolean, name: string, id: i32): void {
  if (p.ok != ok || p.function_name != name || p.message == "") {
    print(p.function_name + ": " + p.message);
    exit(id);
  }
}

function rename_call(r: irtables.LowerResult, from: string, to: string): irtables.LowerResult {
  let ops: ir.Op[] = [];
  let hits: i32 = 0;
  for op in r.ops {
    if (op.kind_tag == ir.kind_id("call_direct") && op.str == from) {
      ops = ops.append(ir.op_call_direct(to, op.i32_imm));
      hits = hits + 1;
    } else {
      ops = ops.append(op);
    }
  }
  require(hits == 1, 3);
  return irtables.LowerResult { ...r, ops: ops };
}

function duplicate_call(r: irtables.LowerResult, name: string): irtables.LowerResult {
  let ops: ir.Op[] = [];
  let hits: i32 = 0;
  for op in r.ops {
    if (op.kind_tag == ir.kind_id("call_direct") && op.str == name) {
      // Leave the original argument on the stack while releasing the same
      // subject again through another actual emitted call sequence.
      ops = ops.append(ir.op_load_local(0)).append(ir.op_call_direct(name, 1)).append(ir.op_drop());
      hits = hits + 1;
    }
    ops = ops.append(op);
  }
  require(hits == 1, 4);
  return irtables.LowerResult { ...r, ops: ops };
}

function target_checks(target: string): void {
  let source = "struct Leaf { n: i32 }\nstruct Parent { child: Leaf }\n@noinline\nfunction extract(own p: Parent): Leaf { return p.child; }\nfunction main(): i32 { let p = Parent { child: Leaf { n: 7 } }; return extract(p).n; }\n";
  let driven = semlower.driven(parser.parse_module(lexer.tokenize(source)), target);
  let drops: irtables.LowerResult[] = [];
  let releases: irtables.LowerResult[] = [];
  for body in driven.sub.extra {
    if (body.name == "__sem_drop_Parent") {
      drops = drops.append(body);
    }
    if (body.name == "__sem_release_Parent") {
      releases = releases.append(body);
    }
  }
  require(drops.len() == 1 && releases.len() == 1, 5);
  let drop = drops[0];
  let release = releases[0];
  let d = lift(drop);
  let r = lift(release);
  let layout = proof.FlatChild { offset: 8 };
  expect(proof.drop_body(d, layout), true, d.name, 10);
  expect(proof.release_body(r, d, layout), true, r.name, 11);
  // Mutate actual normal lowering output, then use the production physical
  // lift. No synthetic helper name is accepted without proving its body.
  let missing = lift(rename_call(drop, "__fern_rc_dec", "__fern_rc_is_unique"));
  expect(proof.release_body(r, missing, layout), false, d.name, 12);
  let wrong_slot: ir.Op[] = [];
  let fields: i32 = 0;
  for op in drop.ops {
    if (op.kind_tag == ir.kind_id("struct_get")) {
      wrong_slot = wrong_slot.append(ir.Op { ...op, i32_imm: 1 });
      fields = fields + 1;
    } else {
      wrong_slot = wrong_slot.append(op);
    }
  }
  require(fields == 1, 13);
  expect(proof.drop_body(lift(irtables.LowerResult { ...drop, ops: wrong_slot }), layout), false, d.name, 14);
  expect(proof.release_body(lift(rename_call(release, drop.name, "__fern_rc_is_unique")), d, layout), false, r.name, 15);
  expect(proof.release_body(lift(duplicate_call(release, drop.name)), d, layout), false, r.name, 16);
  expect(proof.release_body(lift(duplicate_call(release, "__fern_rc_dec")), d, layout), false, r.name, 17);
  expect(proof.release_body(lift(rename_call(release, "__fern_rc_is_unique", "__fern_rc_inc")), d, layout), false, r.name, 18);
  let reversed: ssa.SBlock[] = [];
  for b in r.blocks {
    if (b.id == r.entry) {
      reversed = reversed.append(ssa.SBlock { ...b, term: ssa.STerm { ...b.term, t: b.term.f, f: b.term.t } });
    } else {
      reversed = reversed.append(b);
    }
  }
  expect(proof.release_body(ssa.SFunc { ...r, blocks: reversed }, d, layout), false, r.name, 19);
  expect(proof.release_body(r, d, proof.FlatChild { offset: 16 }), false, d.name, 20);
  expect(proof.release_body(r, d, proof.FlatChild { offset: 0 }), false, d.name, 21);
  // Names and block storage order are not the proof. Value flow and edges are.
  let renamed = lift(rename_call(release, drop.name, "audited_child_drop"));
  expect(proof.release_body(renamed, ssa.SFunc { ...d, name: "audited_child_drop" }, layout), true, r.name, 22);
  let reordered: ssa.SBlock[] = [];
  let i: i32 = r.blocks.len();
  while (i > 0) {
    i = i - 1;
    reordered = reordered.append(r.blocks[i]);
  }
  expect(proof.release_body(ssa.SFunc { ...r, blocks: reordered }, d, layout), true, r.name, 23);
  let wrong_subject: ssa.SBlock[] = [];
  for b in r.blocks {
    let ops: ssa.SInst[] = [];
    for op in b.insts {
      if (op.kind_tag == 11 && op.str == "__fern_rc_dec") {
        ops = ops.append(ssa.SInst { ...op, args: [op.result] });
      } else {
        ops = ops.append(op);
      }
    }
    wrong_subject = wrong_subject.append(ssa.SBlock { ...b, insts: ops });
  }
  expect(proof.release_body(ssa.SFunc { ...r, blocks: wrong_subject }, d, layout), false, r.name, 24);
  let duplicate_values = d.blocks[0].insts;
  duplicate_values = duplicate_values.with(3, ssa.SInst { ...duplicate_values[3], result: duplicate_values[2].result });
  let malformed = ssa.SFunc { ...d, blocks: [ssa.SBlock { ...d.blocks[0], insts: duplicate_values }] };
  expect(proof.release_body(r, malformed, layout), false, d.name, 25);
}

function many_expect(p: proof.Proof, ok: boolean, name: string, why: string, id: i32): void {
  expect(p, ok, name, id);
  require(p.message == why, id);
}

function many_checks(target: string): void {
  // The scalar between reference fields must not be treated as a child slot.
  let source = "struct Leaf { n: i32 }\nstruct Parent { left: Leaf, marker: i32, right: Leaf }\n@noinline\nfunction extract(own p: Parent): Leaf { return p.left; }\nfunction main(): i32 { let p = Parent { left: Leaf { n: 7 }, marker: 9, right: Leaf { n: 8 } }; return extract(p).n; }\n";
  let driven = semlower.driven(parser.parse_module(lexer.tokenize(source)), target);
  let drops: irtables.LowerResult[] = [];
  let releases: irtables.LowerResult[] = [];
  for body in driven.sub.extra {
    if (body.name == "__sem_drop_Parent") {
      drops = drops.append(body);
    }
    if (body.name == "__sem_release_Parent") {
      releases = releases.append(body);
    }
  }
  require(drops.len() == 1 && releases.len() == 1, 30);
  let drop = drops[0];
  let d = lift(drop);
  let r = lift(releases[0]);
  let layout = proof.FlatChildren { offsets: [8, 24] };
  many_expect(proof.drop_body_many(d, layout), true, d.name, "proved flat-child drop body", 31);
  many_expect(proof.release_body_many(r, d, layout), true, r.name, "proved conditional parent release body", 32);
  // Layout order and instruction storage order do not change the set of
  // obligations. Every slot still needs its own release even if children alias.
  expect(proof.drop_body_many(d, proof.FlatChildren { offsets: [24, 8] }), true, d.name, 33);
  let b = d.blocks[0];
  let ops = b.insts;
  require(ops.len() == 7, 34);
  let swapped = [ops[0], ops[1], ops[4], ops[5], ops[2], ops[3], ops[6]];
  expect(proof.release_body_many(r, ssa.SFunc { ...d, blocks: [ssa.SBlock { ...b, insts: swapped }] }, layout), true, r.name, 35);
  let layouts: proof.FlatChildren[] = [
    proof.FlatChildren { offsets: [] }, proof.FlatChildren { offsets: [8, 8] },
    proof.FlatChildren { offsets: [0, 24] }, proof.FlatChildren { offsets: [8, 23] },
  ];
  for bad in layouts {
    many_expect(proof.release_body_many(r, d, bad), false, d.name, "unsupported child layout", 36);
  }
  many_expect(proof.drop_body_many(d, proof.FlatChildren { offsets: [8] }), false, d.name, "unsupported drop effects", 37);
  many_expect(proof.drop_body_many(d, proof.FlatChildren { offsets: [8, 16] }), false, d.name, "child slot mismatch", 38);
  // Change actual emitted helper operations before the production lift.
  let mutation: i32 = 0;
  while (mutation < 5) {
    let changed: ir.Op[] = [];
    let calls: i32 = 0;
    let fields: i32 = 0;
    for op in drop.ops {
      if (op.kind_tag == ir.kind_id("call_direct") && op.str == "__fern_rc_dec") {
        calls = calls + 1;
        if (calls == 2 && mutation == 0) {
          changed = changed.append(ir.op_call_direct("__fern_rc_is_unique", 1));
        } else {
          if (calls == 2 && mutation == 1) {
            changed = changed.append(ir.op_load_local(1)).append(ir.op_call_direct("__fern_rc_dec", 1)).append(ir.op_drop());
          }
          changed = changed.append(op);
        }
      } else {
        if (op.kind_tag == ir.kind_id("struct_get")) {
          fields = fields + 1;
          if (fields == 2 && mutation >= 2) {
            let field: i32 = 0;
            if (mutation == 3) {
              field = 1;
            }
            if (mutation == 4) {
              field = 3;
            }
            changed = changed.append(ir.Op { ...op, i32_imm: field });
          } else {
            changed = changed.append(op);
          }
        } else {
          changed = changed.append(op);
        }
      }
    }
    require(calls == 2 && fields == 2, 39);
    let why = "child slot mismatch";
    if (mutation == 0) {
      why = "child release mismatch";
    }
    if (mutation == 1) {
      why = "unsupported drop effects";
    }
    many_expect(proof.release_body_many(r, lift(irtables.LowerResult { ...drop, ops: changed }), layout), false, d.name, why, 40 + mutation);
    mutation = mutation + 1;
  }
  let wrong_child = ops.with(5, ssa.SInst { ...ops[5], args: [ops[2].result] });
  many_expect(proof.drop_body_many(ssa.SFunc { ...d, blocks: [ssa.SBlock { ...b, insts: wrong_child }] }, layout), false, d.name, "child release mismatch", 45);
  let missing = [ops[0], ops[1], ops[2], ops[3], ops[6]];
  many_expect(proof.drop_body_many(ssa.SFunc { ...d, blocks: [ssa.SBlock { ...b, insts: missing }] }, layout), false, d.name, "unsupported drop effects", 46);
  // The old boundary cannot silently expand to cover the extra child.
  expect(proof.drop_body(d, proof.FlatChild { offset: 8 }), false, d.name, 47);
  expect(proof.release_body_many(r, d, layout), true, r.name, 48);
}

function main(): i32 {
  target_checks("arm64-darwin");
  target_checks("x86-64-linux");
  target_checks("wasm32-wasi");
  many_checks("arm64-darwin");
  many_checks("x86-64-linux");
  many_checks("wasm32-wasi");
  print("physical containment helper proofs: all controls agree");
  return 0;
}
