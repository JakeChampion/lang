import "../ssalargepushranges" as ranges;
import "../ssalargepushvalue" as value;

function require(ok: boolean, group: string): void {
  if (!ok) {
    print("large-push arithmetic controls failed: " + group);
    // All nonzero native statuses are occupied; the printed case identifies
    // this shared status, including on targets with collapsed exit codes.
    exit(180);
  }
}

function constant(r: ranges.Interval, v: value.Value, n: i64): boolean {
  return value.valid(r, v) && v.factor == 0 && v.offset == n;
}

function invalid_values(): void {
  let r = ranges.Interval { low: 0, high: 1073741824 };
  let bad: value.Value[] = [value.unknown(), value.Value { factor: 2, offset: 0 as i64 }, value.Value { factor: 0, offset: 4294967296 as i64 }, value.Value { factor: 0, offset: -(9223372036854775807 as i64) }, value.Value { factor: 1, offset: 4294967295 as i64 }];
  for v in bad {
    require(!value.valid(r, v), "invalid expression");
    require(!value.valid(r, value.add(r, v, 0 as i64)) && !value.valid(r, value.negate(r, v)), "invalid arithmetic");
    require(!value.valid(r, value.zero32(r, v)) && value.bit_scan(r, v) == -1, "invalid width and BSR");
    require(!value.valid(r, value.mask(r, v, value.number(r, -(8 as i64)))), "invalid mask operand");
    let c = value.compare(r, v, 0 as i64);
    require(c.less == -1 && c.equal == -1 && c.less_equal == -1, "invalid comparison");
  }
}

function bounds(): void {
  let bad: ranges.Interval[] = [ranges.Interval { low: -1, high: 0 }, ranges.Interval { low: 2, high: 1 }, ranges.Interval { low: 0, high: 1073741825 }, ranges.Interval { low: -2147483648, high: 2147483647 }];
  for r in bad {
    require(!value.valid(r, value.original(r)) && !value.valid(r, value.number(r, 0 as i64)), "invalid interval");
  }
  let r = ranges.Interval { low: 0, high: 1073741824 };
  let n = value.original(r);
  require(value.valid(r, n) && n.factor == 1 && n.offset == 0 as i64, "whole recycled domain");
  require(!value.valid(r, value.negate(r, n)), "unsupported affine negation");
  require(!value.valid(r, value.add(r, n, 4294967295 as i64)), "upper bound");
  require(!value.valid(r, value.add(r, n, -(9223372036854775807 as i64))), "extreme delta");
  require(!value.valid(r, value.add(r, value.number(r, -(4294967295 as i64)), -(1 as i64))), "lower bound");
  require(value.bit_scan(r, n) == -1 && value.bit_scan(r, value.number(r, -(1 as i64))) == -1, "nonpositive BSR");
  require(value.bit_scan(r, value.number(r, 4294967295 as i64)) == 31, "highest bounded bit");
  require(value.power(-1) == 0 as i64 && value.power(32) == 0 as i64 && value.power(31) == 2147483648 as i64, "power bounds");
}

function widths(): void {
  let r = ranges.Interval { low: 0, high: 1073741824 };
  let n = value.original(r);
  let v = value.zero32(r, n);
  require(v.factor == 1 && v.offset == 0 as i64, "positive zero extension");
  require(constant(r, value.zero32(r, value.number(r, -(1 as i64))), 4294967295 as i64), "negative zero extension");
  require(constant(r, value.zero32(r, value.number(r, -(4294967295 as i64))), 1 as i64), "low word boundary");
  v = value.zero32(r, value.add(r, n, -(1073741825 as i64)));
  require(value.valid(r, v) && v.factor == 1 && v.offset == 3221225471 as i64, "negative affine extension");
  require(!value.valid(r, value.zero32(r, value.add(r, n, -(1 as i64)))), "crossing zero refuses");
}

function predicates(): void {
  let r = ranges.Interval { low: 0, high: 1073741824 };
  let n = value.original(r);
  let c = value.compare(r, n, 1073741824 as i64);
  require(c.less == -1 && c.equal == -1 && c.less_equal == 1, "correlated maximum");
  c = value.compare(r, n, 0 as i64);
  require(c.less == 0 && c.equal == -1 && c.less_equal == -1, "correlated minimum");
  constant_predicates(r, n);
}

function constant_predicates(r: ranges.Interval, n: value.Value): void {
  let c = value.compare(r, n, 1073741825 as i64);
  require(c.less == 1 && c.equal == 0 && c.less_equal == 1, "upper exterior");
  c = value.compare(r, n, -(1 as i64));
  require(c.less == 0 && c.equal == 0 && c.less_equal == 0, "lower exterior");
  c = value.compare(r, value.number(r, 0 as i64), 0 as i64);
  require(c.less == 0 && c.equal == 1 && c.less_equal == 1, "constant equality");
}

function masks(): void {
  let r = ranges.Interval { low: 524289, high: 655360 };
  let sum = value.add(r, value.original(r), 131071 as i64);
  let m = value.number(r, -(131072 as i64));
  require(constant(r, value.mask(r, sum, m), 655360 as i64), "whole interval rounding");
  for n in [0, 1, -3, -131071, -131073] {
    require(!value.valid(r, value.mask(r, sum, value.number(r, n as i64))), "non-power mask");
  }
  require(!value.valid(r, value.mask(r, value.original(r), m)), "varying quotient");
  require(!value.valid(r, value.mask(r, value.number(r, -(1 as i64)), m)), "negative operand");
  require(!value.valid(r, value.mask(r, sum, value.original(r))), "nonconstant mask");
  let cross = ranges.Interval { low: 1048575, high: 1048576 };
  require(value.bit_scan(cross, value.original(cross)) == -1, "highest-bit crossing");
}

// Derive the actual arithmetic expression, then compare against the ordered
// bin and ceiling-division specifications. Expected class is never an input.
function row(r: ranges.Interval): void {
  let n = value.original(r);
  let clamp = value.compare(r, n, 524288 as i64);
  require(clamp.less == 0 || clamp.less == 1, "determinate clamp predicate");
  let x = if (clamp.less == 1) { value.number(r, 524288 as i64) } else { n };
  let bit = value.bit_scan(r, x);
  require(bit >= 19 && bit <= 30, "initial highest bit");
  let step = value.number(r, value.power(bit - 2));
  let sum = value.add(r, x, step.offset - 1 as i64);
  let rounded = value.mask(r, sum, value.negate(r, step));
  require(constant(r, rounded, ranges.rounded(r)), "independent ceiling division");
  bit = value.bit_scan(r, rounded);
  require(bit >= 19 && bit <= 30, "rounded highest bit");
  let quotient = rounded.offset / value.power(bit - 2);
  let actual = quotient + (bit - 2) as i64 * (4 as i64) - 72 as i64;
  require(actual == ranges.expected_class(r) as i64 && actual >= 0 as i64 && actual < 45 as i64, "independent ordered bin");
}

pub function audit(limit: i32): void {
  let rows = ranges.intervals();
  require(rows.len() == 57 && limit >= 1 && limit <= rows.len(), "audit bound");
  let index = 0;
  for r in rows {
    if (index < limit) {
      row(r);
    }
    index = index + 1;
  }
}

pub function run(): void {
  invalid_values();
  bounds();
  widths();
  predicates();
  masks();
  audit(57);
}
