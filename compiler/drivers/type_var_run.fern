import "../checker";
import "../typeinfo";

function flag(b: boolean): string {
  if (b) {
    return "yes";
  }
  return "no";
}

function row(label: string, t: typeinfo.Type): string {
  return label
    + ": unknown=" + flag(checker.is_unknown(t))
    + " name=" + checker.tvar_name(t)
    + " reason=" + checker.unknown_reason(t)
    + " label=" + checker.type_label(t) + "\n";
}

function main(): i32 {
  let out = "";
  out += row("declared", typeinfo.TypeVar { name: "0_T", declared: true });
  out += row("unresolved", typeinfo.TypeVar { name: "0_Elem", declared: false });
  out += row("not a variable spelling", typeinfo.TypeVar { name: "widget", declared: false });
  out += row("unchecked", typeinfo.unchecked());
  out += row("erased", typeinfo.TypeErased { name: "T" });
  out += row("i32", typeinfo.t_i32());
  write(out);
  return 0;
}
