import "../lexer";
import "../parser";
import "../semlower";
import "../ircore";
import "../irtables";
import "../ir";
import "../ssasem";
import "../semrecords";
import "../ssacreditabi" as abi;
import "../ssacredithelper" as helper;
import "../util";
import "./ssacreditfinal" as final_binding;
import "./ssacreditruntime" as runtime_binding;
import "./ssacreditprovenance" as provenance;
import "./ssacreditorigins" as origins;
import "./ssacreditunits" as units;

function require(ok: boolean, code: i32): void {
  if (!ok) {
    exit(code);
  }
}

function source(generic: boolean, exiting: boolean): string {
  let leaf = if (generic) { "struct Leaf[T] { n: T }\n" } else { "struct Leaf { n: i32 }\n" };
  let child = if (generic) { "Leaf[i32]" } else { "Leaf" };
  let assertion = if (exiting) { "if (!ok) { exit(code); }" } else { "if (ok) { return; } return;" };
  return leaf + "struct Parent { left: " + child + ", right: " + child + " }\nstruct Other { first: " + child + ", second: " + child + " }\n"
    + "@noinline\nfunction require(ok: boolean, code: i32): void { " + assertion + " }\n"
    + "@noinline\nfunction parent(left: " + child + ", right: " + child + "): Parent { return Parent { left: left, right: right }; }\n"
    + "@noinline\nfunction replace(own p: Parent, child: " + child + "): Other { let n = p.left.n + p.right.n; require(n > 0, 1); return Other { first: child, second: child }; }\n"
    + "@noinline\nfunction handoff(flag: boolean, left: " + child + ", right: " + child + ", incoming: " + child + "): Other { let p = if (flag) { parent(left, right) } else { parent(right, left) }; return replace(p, incoming); }\n"
    + "function main(): i32 { let c: " + child + " = Leaf { n: 7 }; let p = handoff(true,c,c,c); return p.first.n - 7; }\n";
}

function expect(p: helper.Proof, name: string, why: string): void {
  let ok = why == "proved checked storage wrapper continuation";
  if (p.ok != ok || p.function_name != name || p.message != why) {
    print(p.function_name + ": " + p.message + " expected " + name + ": " + why);
    exit(91);
  }
}

function check(sub: ircore.Sub, name: string, why: string): void {
  expect(abi.check_wrapper(sub, "handoff", "replace", "__sem_drop_Parent", "__sem_release_Parent", ["require"]), name, why);
}

function contracts_except(sub: ircore.Sub, name: string): ssasem.Contract[] {
  let rows: ssasem.Contract[] = [];
  for c in sub.physical_contracts {
    if (c.name != name) {
      rows = rows.append(c);
    }
  }
  return rows;
}

function assertion_contracts(sub: ircore.Sub): void {
  let found: i32 = 0;
  for c in sub.physical_contracts {
    if (c.name == "require") {
      found = found + 1;
      let rows = contracts_except(sub, c.name);
      for copies in [rows, rows.append(c).append(c)] {
        check(ircore.Sub { ...sub, physical_contracts: copies }, "replace", "require: missing or ambiguous assertion ABI");
      }
      let mode_sets: i32[][] = [[], [1, 3], [3, 1]];
      for modes in mode_sets {
        check(ircore.Sub { ...sub, physical_contracts: rows.append(ssasem.Contract { ...c, modes: modes }) }, "replace", "require: assertion requires two scalar parameters");
      }
      check(ircore.Sub { ...sub, physical_contracts: rows.append(ssasem.Contract { ...c, params: [c.params[1], c.params[0]] }) }, "replace", "require: assertion requires boolean, concrete signed i32 and void result");
      check(ircore.Sub { ...sub, physical_contracts: rows.append(ssasem.Contract { ...c, result: c.params[0] }) }, "replace", "require: assertion requires boolean, concrete signed i32 and void result");
    }
  }
  require(found == 1, 92);
}

function body_controls(sub: ircore.Sub, name: string): void {
  let found: i32 = 0;
  for b in util.append_all(sub.bodies, sub.extra) {
    if (b.name == name) {
      found = found + 1;
      let rows: irtables.LowerResult[] = [];
      for other in util.append_all(sub.bodies, sub.extra) {
        if (other.name != name) {
          rows = rows.append(other);
        }
      }
      let missing = if (name == "require") { "require: missing or ambiguous assertion body" } else { "missing or ambiguous physical binding" };
      check(ircore.Sub { ...sub, bodies: rows, extra: [] }, "replace", missing);
      check(ircore.Sub { ...sub, bodies: rows.append(b), extra: [b] }, "replace", missing);
      let unproduced = if (name == "require") { missing } else { "unproduced physical binding" };
      check(ircore.Sub { ...sub, bodies: rows.append(irtables.LowerResult { ...b, ok: false }), extra: [] }, "replace", unproduced);
      if (name == "require") {
        check(ircore.Sub { ...sub, bodies: rows.append(irtables.LowerResult { ...b, n_params: 1 }), extra: [] }, "replace", "require: invalid scalar helper boundary");
      }
    }
  }
  require(found == 1, 93);
}

function metadata_controls(sub: ircore.Sub): void {
  for c in sub.physical_contracts {
    let rows = contracts_except(sub, c.name);
    if (c.name == "handoff") {
      check(ircore.Sub { ...sub, physical_contracts: rows.append(ssasem.Contract { ...c, modes: [1, 3, 3, 2] }) }, "handoff", "incoming wrapper requires scalar and three consuming parameters");
    }
    if (c.name == "replace") {
      check(ircore.Sub { ...sub, physical_contracts: rows.append(ssasem.Contract { ...c, result: c.params[0] }) }, "handoff", "incoming consumer ABI differs from wrapper");
    }
    if (c.name == "parent") {
      check(ircore.Sub { ...sub, physical_contracts: rows }, "handoff", "missing or ambiguous origin callee ABI");
    }
  }
  check(ircore.Sub { ...sub, physical_finalizers: [ssasem.Finalizer { receiver: "Parent", symbol: "finalize" }] }, "handoff", "unsupported incoming parent type or finalizer");
  for r in sub.physical_records.list {
    if (semrecords.name_of(r.ty) == "Other") {
      check(ircore.Sub { ...sub, physical_records: semrecords.records_of(sub.physical_records.list.append(r)) }, "handoff", "missing or ambiguous incoming parent or result schema");
    }
  }
}

function renamed(name: string): string {
  return if (util.has_str(["handoff", "replace", "parent", "require", "__sem_drop_Parent", "__sem_release_Parent"], name)) { "bound_" + name } else { name };
}

function changed_body(b: irtables.LowerResult, rename: boolean): irtables.LowerResult {
  let ops: ir.Op[] = [];
  for op in b.ops {
    if (!rename && b.name == "require" && op.kind_tag == ir.kind_id("return")) {
      ops = ops.append(ir.op_call_direct("unknown_effect", 0)).append(ir.op_drop());
    }
    ops = ops.append(if (rename && op.kind_tag == ir.kind_id("call_direct")) { ir.Op { ...op, str: renamed(op.str) } } else { op });
  }
  return irtables.LowerResult { ...b, name: if (rename) { renamed(b.name) } else { b.name }, ops: ops };
}

function changed(sub: ircore.Sub, rename: boolean): ircore.Sub {
  let rows: irtables.LowerResult[] = [];
  for b in util.append_all(sub.bodies, sub.extra) {
    rows = rows.append(changed_body(b, rename));
  }
  let contracts: ssasem.Contract[] = [];
  for c in sub.physical_contracts {
    contracts = contracts.append(ssasem.Contract { ...c, name: if (rename) { renamed(c.name) } else { c.name } });
  }
  return ircore.Sub { ...sub, bodies: rows, extra: [], physical_contracts: contracts };
}

function bad_return(sub: ircore.Sub, local: i32): ircore.Sub {
  let rows: irtables.LowerResult[] = [];
  for b in util.append_all(sub.bodies, sub.extra) {
    let ops: ir.Op[] = [];
    for op in b.ops {
      if (b.name == "handoff" && op.kind_tag == ir.kind_id("return")) {
        ops = ops.append(ir.op_drop()).append(ir.op_load_local(local));
      }
      ops = ops.append(op);
    }
    rows = rows.append(irtables.LowerResult { ...b, ops: ops });
  }
  return ircore.Sub { ...sub, bodies: rows, extra: [] };
}

function continuation_controls(sub: ircore.Sub): void {
  for local in [0, 1, 2, 3] {
    let wrong = bad_return(sub, local);
    // Invocation success deliberately leaves the wrapper return unproved.
    let invocation = abi.check_storage(wrong, "handoff", "replace", "__sem_drop_Parent", "__sem_release_Parent", ["require"]);
    require(invocation.ok && invocation.function_name == "replace", 94);
    check(wrong, "handoff", "continuation must return owned consumer result");
  }
  for name in ["handoff", "replace", "parent"] {
    let rows: irtables.LowerResult[] = [];
    for b in util.append_all(sub.bodies, sub.extra) {
      if (b.name != name) {
        rows = rows.append(b);
      }
    }
    let why = if (name == "parent") { "origin callee proof refused: missing or ambiguous producer body" } else { "missing, ambiguous or mismatched incoming body" };
    check(ircore.Sub { ...sub, bodies: rows, extra: [] }, "handoff", why);
  }
}

function target_checks(target: string): void {
  for generic in [false, true] {
    let original = semlower.driven(parser.parse_module(lexer.tokenize(source(generic, true))), target).sub;
    check(original, "replace", "scalar call may exit with unproved caller obligations");
    // A separate coherent source graph supplies the non-exiting positive case.
    let sub = semlower.driven(parser.parse_module(lexer.tokenize(source(generic, false))), target).sub;
    check(sub, "handoff", "proved checked storage wrapper continuation");
    final_binding.run(source(generic, false), target, false);
    final_binding.run(source(generic, true), target, true);
    continuation_controls(sub);
    assertion_contracts(sub);
    for name in ["require", "__sem_drop_Parent", "__sem_release_Parent"] {
      body_controls(sub, name);
    }
    metadata_controls(sub);
    check(changed(sub, false), "replace", "require: unsupported scalar helper effect");
    expect(abi.check_wrapper(changed(sub, true), "bound_handoff", "bound_replace", "bound___sem_drop_Parent", "bound___sem_release_Parent", ["bound_require"]), "bound_handoff", "proved checked storage wrapper continuation");
    expect(abi.check_wrapper(sub, "handoff", "replace", "__sem_drop_Parent", "__sem_release_Parent", ["require", "require"]), "replace", "ambiguous scalar call binding");
    check(original, "replace", "scalar call may exit with unproved caller obligations");
    check(sub, "handoff", "proved checked storage wrapper continuation");
  }
}

function main(): i32 {
  provenance.run();
  origins.run();
  units.run();
  runtime_binding.run(source(false, false), false);
  runtime_binding.run(source(false, true), true);
  target_checks("arm64-darwin");
  target_checks("x86-64-linux");
  target_checks("wasm32-wasi");
  print("typed wrapper continuation controls passed");
  return 0;
}
