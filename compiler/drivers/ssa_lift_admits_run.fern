import "../ir";
import "../ssa_lift";
import "../util";

function main(): i32 {
  let id = 1;
  let registered = 0;
  let declined = 0;
  let out = "";
  let kt = ssa_lift.kind_table();
  while (id < 1024) {
    let k = ir.kind_name(id);
    if (k != "invalid") {
      registered += 1;
      let o = ir.Op { source: 0, decl: -1, kind_tag: id, i32_imm: 0, i64_imm: 0i64, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
      if (!ssa_lift.admits(kt, o)) {
        declined += 1;
        out = out + k + " pops=" + util.i32_to_string(ir.op_pops(o)) + " pushes=" + util.i32_to_string(ir.op_pushes(o)) + "\n";
      } else if (ir.op_pops(o) < 0) {
        out = out + "unmodelled " + k + "\n";
      } else if (id >= 412 && id <= 414 || id >= 491 && id <= 497) {
        out = out + "admitted " + k + " pops=" + util.i32_to_string(ir.op_pops(o)) + " pushes=" + util.i32_to_string(ir.op_pushes(o)) + "\n";
      }
    }
    id += 1;
  }
  write(out + "registered=" + util.i32_to_string(registered) + " declined=" + util.i32_to_string(declined) + "\n");
  return 0;
}
