// compiler/ssa_lift_admits_run.fern — the production lift's
// admission census. It walks every registered IR op kind and prints the ones
// ssa_lift.admits declines, with the stack effect ir.op_pops / ir.op_pushes
// give the kind, then the registered and declined counts.
//
// The companion Go test (internal/testing/e2ecompiler/self_host_ssa_lift_admits_test.go)
// pins the report: a kind added to the registry reaches the register path
// through the stack machine's arm for it unless its stack effect is unknown,
// so a new line here is a kind whose pop count op_pops does not model. The
// three kinds it lists are the ones no lowering produces. A kind the lift
// admits by name while op_pops does not model it is printed first, as
// `unmodelled`: the passes that read stack effects (the suspension pass's
// segments) refuse such an op, so the list stays empty.

import "../ir";
import "../ssa_lift";
import "../util";

function main(): i32 {
  let id: i32 = 1;
  let registered: i32 = 0;
  let declined: i32 = 0;
  let out: string = "";
  while (id < 1024) {
    let k: string = ir.kind_name(id);
    if (k != "invalid") {
      registered = registered + 1;
      let o: ir.Op = ir.Op { decl: 0 - 1, kind_tag: id, i32_imm: 0, i64_imm: 0i64, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
      if (!ssa_lift.admits(o)) {
        declined = declined + 1;
        out = out + k + " pops=" + util.i32_to_string(ir.op_pops(o)) + " pushes=" + util.i32_to_string(ir.op_pushes(o)) + "\n";
      } else if (ir.op_pops(o) < 0) {
        out = out + "unmodelled " + k + "\n";
      }
    }
    id = id + 1;
  }
  write(out + "registered=" + util.i32_to_string(registered) + " declined=" + util.i32_to_string(declined) + "\n");
  return 0;
}
