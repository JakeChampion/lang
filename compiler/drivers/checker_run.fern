import "../lexer";
import "../parser";
import "./rundriver";
import "../checker";
import "../util";

function main(): i32 {
  let mod: parser.Module = rundriver.parse_stdin("checker_run");
  let mt: checker.ModuleTypes = checker.check_module(mod);
  if (mt.all_well_typed) {
    return 0;
  }
  eprint(util.format_diags(mt.diags));
  return 1;
}
