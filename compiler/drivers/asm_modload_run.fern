function verify_provided_module(merged: parser.Module, target: string): i32 {
  let d = semlower.driven(merged, target);
  let names: string[] = [];
  let bodies: ir.Op[][] = [];
  let declared: string[] = [];
  let im = ircore.with_records(parser.infer_ret_types_module(ircore.script_normalized(ircore.sub_lifted(d.sub, d.full))), d.sub);
  let i = 0;
  while (i < im.funcs.len()) {
    declared = declared.append(parser.decl_key(im.funcs[i]));
    let r = ircore.produced(d.sub.bodies, i, im.funcs[i]);
    if (!r.superseded) {
      names = names.append(parser.decl_key(im.funcs[i]));
      bodies = bodies.append(r.ops);
    }
    i += 1;
  }
  for x in d.sub.extra {
    declared = declared.append(x.name);
    if (x.ok) {
      names = names.append(x.name);
      bodies = bodies.append(x.ops);
    }
  }
  let ix = irverify.name_index(declared);
  let probs: irverify.Problem[] = [];
  let calls = 0;
  let cov = irverifystack.coverage_new();
  let pops = ir.pops_by_kind();
  let k = 0;
  while (k < names.len()) {
    let r = irverifyprovided.verify_provided_fn(names[k], bodies[k], ix);
    calls += r.calls;
    for p in r.problems {
      probs = probs.append(p);
    }
    cov = irverifystack.coverage_add(cov, names[k], irverifystack.verify_stack_fn(names[k], bodies[k], pops).bail);
    k += 1;
  }
  let checked = names.len();
  let tally: string = "checked " + util.i32_to_string(checked) + " functions, "
    + util.i32_to_string(calls) + " direct calls";
  let stack = "irverifystack: " + irverifystack.coverage_str(cov) + "\n";
  if (probs.len() == 0) {
    write("irverifyprovided: clean (" + tally + ")\n" + stack);
    return 0;
  }
  write("irverifyprovided: " + util.i32_to_string(probs.len()) + " problem(s) (" + tally + ")"
    + irverify.format_problems(probs, 20) + "\n" + stack);
  return 1;
}

function provided_audit(): i32 {
  let names = irverifyprovided.provided_names();
  let runtime = rtmodule.load("x86-64-linux", asmcore.task_runtime_roots());
  let runtime_names: string[] = [];
  for fd in runtime.funcs {
    runtime_names = runtime_names.append(fd.name);
  }
  let bad: string[] = [];
  let i = 0;
  while (i < names.len()) {
    if (!ircore.is_fern_helper(names[i]) && !util.has_str(runtime_names, names[i])) {
      bad = bad.append(names[i]);
    }
    i += 1;
  }
  if (bad.len() == 0) {
    write("provided-audit: all " + util.i32_to_string(names.len())
      + " inventory entries are emitted by the backend\n");
    return 0;
  }
  let out: string = "provided-audit: " + util.i32_to_string(bad.len())
    + " inventory entrie(s) no backend emits:";
  let j = 0;
  while (j < bad.len()) {
    out = out + "\n    " + bad[j];
    j += 1;
  }
  write(out + "\n");
  return 1;
}

struct View {
  u: ircore.Units,
  all_funcs: parser.FuncDecl[],
  stab: irtables.StructTab,
  contracts: string[],
  rt: (parser.Module) => physicalbody.Lowered,
  refused: util.Diag[],
}

function per_module_view(entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], parts: flatten.PerModule[], target: string): View {
  let d = semlower.driven(treeshake.without_extern_callers(merged_program(entry_path, entry, loaded, target)), target);
  let g = semlower.program(d);
  let raw: parser.Module[] = [];
  let entry_at = 0;
  let k = 0;
  while (k < parts.len()) {
    raw = raw.append(parts[k].mod);
    if (parts[k].is_entry) {
      entry_at = k;
    }
    k += 1;
  }
  return View { u: ircore.split_units(g, raw, entry_at), all_funcs: g.im.funcs, stab: g.stab, contracts: d.sub.contracts, rt: d.sub.rt_lower, refused: d.sub.refused };
}

function merged_program(entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], target: string): parser.Module {
  let merged = modloader.bundle(modloader.no_overlay(), entry_path, entry, loaded, target, "");
  let md = platforms.for_target(target);
  merged = constfold.fold_target_name(merged, md.environment, md.isa);
  return constfold.prune_literal_branches(merged);
}

// Annotated before the shake, as fern.fern does: the display desugar of
// `print(x)` reaches a primitive's `to_string` only through the annotation.
function merged_emitted(merged: parser.Module): parser.Module {
  let errs = asmcore.check_undefined_calls(merged);
  if (errs.len() > 0) {
    eprint(util.format_diags(errs));
    exit(1);
  }
  return treeshake.treeshake(checker.annotate_module(merged));
}

function view_keys(v: View, cache_dir: string): ircore.UnitKeys {
  if (cache_dir.len() == 0) {
    return ircore.no_unit_keys();
  }
  return ircore.unit_keys(v.u, v.stab, v.contracts);
}

function emit_unit(v: View, idx: i32, is_entry: boolean, ns: string, extra: string[], lo: i32, hi: i32, target: string): string {
  ircore.refuse_claims(v.refused);
  if (target == "arm64-linux") {
    return asm_arm64_ir.emit_module_ir_unit_arm64_flat(v.u.mods[idx], is_entry, true, ns, extra, v.all_funcs, v.stab, lo, hi, v.u.caches[idx], v.u.physical[idx], v.rt, asmcore.env_switches());
  }
  return asm_ir.emit_module_ir_unit_flat(v.u.mods[idx], is_entry, true, ns, extra, v.all_funcs, v.stab, lo, hi, v.u.caches[idx], v.u.physical[idx], v.rt, 0 as usize, asmcore.env_switches());
}

function unit_cache_file(cache_dir: string, parts: flatten.PerModule[], v: View, keys: ircore.UnitKeys, src_hash: string, midx: i32, extra: string[], wlo: i32, whi: i32): string {
  if (cache_dir.len() == 0 || src_hash.len() == 0) {
    return "";
  }
  let key = ircore.unit_cache_key(parts, v.u, keys, midx, src_hash, extra, wlo, whi);
  if (key.len() == 0) {
    return "";
  }
  let shard_tag = "";
  if (wlo > 0) {
    shard_tag = "_s" + util.i32_to_string(wlo);
  }
  return cache_dir + "/" + parts[midx].ns + shard_tag + "__" + util.hash_key(key) + ".s";
}

function emit_unit_to_file(out_dir: string, unit_spec: string, v: View, parts: flatten.PerModule[], midx: i32, needs: string[], target: string, cachefile: string): boolean {
  let wlo = nth_field_i32(unit_spec, 1);
  let whi = nth_field_i32(unit_spec, 2);
  let is_entry = parts[midx].is_entry;
  let extra: string[] = [];
  if (is_entry) {
    extra = needs;
  }
  let shard_ns = parts[midx].ns;
  if (wlo > 0) {
    shard_ns = shard_ns + "_s" + util.i32_to_string(wlo);
  }
  let outpath = out_dir + "/" + unit_file_name(unit_spec);
  if (cachefile.len() > 0) {
    match (read_file(cachefile)) {
      Ok(cached) => {
        eprint("cache-hit " + shard_ns);
        match (write_file(outpath, cached)) {
          Err(cwerr) => {
            eprint("per-module: unit write failed: " + outpath);
            return false;
          },
          Ok(_) => {}
        }
        return true;
      },
      Err(e_ch) => {}
    }
  }
  let unit = emit_unit(v, midx, is_entry, shard_ns, extra, wlo, whi, target);
  match (write_file(outpath, unit)) {
    Err(werr) => {
      eprint("per-module: unit write failed: " + outpath);
      return false;
    },
    Ok(_) => {}
  }
  if (cachefile.len() > 0) {
    eprint("cache-miss " + shard_ns);
    match (write_file(cachefile, unit)) {
      Err(cerr) => {
        eprint("per-module: cache write failed for " + shard_ns);
      },
      Ok(_) => {}
    }
  }
  return true;
}

function spawn_batch(self_exe: string, entry_path: string, tmp: string, lo: i32, hi: i32, target: string, cache_dir: string): i32 {
  let pid = proc_fork();
  if (pid < 0) {
    return -1;
  }
  if (pid == 0) {
    let argv: string[] = [
      entry_path, "-per-module-emit-all", "-out-dir", tmp,
      "-unit-range", util.i32_to_string(lo) + ":" + util.i32_to_string(hi),
      "-target", target,
    ];
    if (cache_dir.len() > 0) {
      argv = argv.append("-cache-dir");
      argv = argv.append(cache_dir);
    }
    let rc = proc_exec(self_exe, argv);
    exit(127);
  }
  return proc_waitpid(pid);
}

function emit_per_module_spawned(entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], target: string, func_budget: i32, batch: i32, self_exe: string, cache_dir: string): i32 {
  if (self_exe.len() == 0) {
    return 1;
  }
  let parts = flatten.bundle_per_module(entry, loaded, target);
  let units = flat_unit_list(entry_path, parts, per_module_view(entry_path, entry, loaded, parts, target).u.mods, func_budget);
  if (units.len() == 0) {
    return 1;
  }
  let tmp = "";
  match (temp_dir("fern-pm")) {
    Ok(td) => {
      tmp = td;
    },
    Err(e_td) => {
      eprint("per-module spawned: could not create a unit directory");
      return 1;
    }
  }
  let lo = 0;
  while (lo < units.len()) {
    let hi = lo + batch;
    if (hi > units.len()) {
      hi = units.len();
    }
    let rc = spawn_batch(self_exe, entry_path, tmp, lo, hi, target, cache_dir);
    if (rc != 0) {
      eprint("per-module spawned: unit batch " + util.i32_to_string(lo) + ":" + util.i32_to_string(hi) + " failed (exit " + util.i32_to_string(rc) + "), falling back to the merged IR emit");
      let ce1 = 0;
      match (remove_dir_all(tmp)) {
        Err(rr1) => {
          ce1 = 1;
        },
        Ok(_) => {}
      }
      return 1;
    }
    lo = hi;
  }
  let vi = 0;
  while (vi < units.len()) {
    let vpath = tmp + "/" + unit_file_name(units[vi]);
    let present = false;
    match (stat(vpath)) {
      Ok(st) => {
        present = true;
      },
      Err(e_st) => {}
    }
    if (!present) {
      eprint("per-module spawned: missing emitted unit " + vpath);
      let ce2 = 0;
      match (remove_dir_all(tmp)) {
        Err(rr2) => {
          ce2 = 1;
        },
        Ok(_) => {}
      }
      return 1;
    }
    vi += 1;
  }
  let seen: string[] = [];
  let ri = 0;
  while (ri < units.len()) {
    let rpath = tmp + "/" + unit_file_name(units[ri]);
    let read_ok = false;
    match (read_file(rpath)) {
      Ok(text) => {
        let h = buf_new(text.len());
        seen = asmcore.dedupe_weak_into(text, seen, h);
        write(buf_take(h));
        buf_free(h);
        read_ok = true;
      },
      Err(e_ru) => {}
    }
    if (!read_ok) {
      eprint("per-module spawned: unit vanished mid-stream: " + rpath);
      let ce3 = 0;
      match (remove_dir_all(tmp)) {
        Err(rr3) => {
          ce3 = 1;
        },
        Ok(_) => {}
      }
      return 2;
    }
    ri += 1;
  }
  let ce4 = 0;
  match (remove_dir_all(tmp)) {
    Err(rr4) => {
      ce4 = 1;
    },
    Ok(_) => {}
  }
  return 0;
}

function nth_field_i32(s: string, n: i32): i32 {
  let i = 0;
  let f = 0;
  while (f < n && i < s.len()) {
    if (s[i] == b':') {
      f += 1;
    }
    i += 1;
  }
  return util.digits_to_i32(slice_unchecked(s, i, s.len()) + "");
}

function flat_unit_list(entry_path: string, parts: flatten.PerModule[], infmods: parser.Module[], func_budget: i32): string[] {
  let units: string[] = [];
  let idx = 0;
  while (idx < parts.len()) {
    let fcount = infmods[idx].funcs.len();
    let sbytes = 0;
    match (modloader.module_src(modloader.no_overlay(), entry_path, parts, idx)) {
      Some(fsrc) => {
        sbytes = fsrc.len();
      },
      None => {}
    }
    let window = emit_window_size(fcount, sbytes, func_budget);
    if (parts[idx].is_entry && fcount > window) {
      window = fcount;
    }
    let wlo = 0;
    let more = true;
    while (more) {
      let whi = wlo + window;
      if (whi > fcount) {
        whi = fcount;
      }
      units = units.append(util.i32_to_string(idx) + ":" + util.i32_to_string(wlo) + ":" + util.i32_to_string(whi));
      wlo += window;
      if (wlo >= fcount) {
        more = false;
      }
    }
    idx += 1;
  }
  return units;
}

function unit_file_name(unit: string): string {
  let idx = nth_field_i32(unit, 0);
  let wlo = nth_field_i32(unit, 1);
  let tag = "";
  if (wlo > 0) {
    tag = "_s" + util.i32_to_string(wlo);
  }
  return "unit_" + util.i32_to_string(idx) + tag + ".s";
}

function emit_window_size(funcs: i32, bytes: i32, func_budget: i32): i32 {
  let byte_budget = 300000;
  let nwin = (funcs + func_budget - 1) / func_budget;
  let bybytes = (bytes + byte_budget - 1) / byte_budget;
  if (bybytes > nwin) {
    nwin = bybytes;
  }
  if (nwin < 1) {
    nwin = 1;
  }
  let window = (funcs + nwin - 1) / nwin;
  if (window < 1) {
    window = 1;
  }
  return window;
}

function run_per_module(entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], pm_mode: string, pm_index: i32, pm_extra: string[], cache_dir: string, pm_lo: i32, pm_hi: i32, target: string, out_dir: string, func_budget: i32, unit_lo: i32, unit_hi: i32): i32 {
  let parts = flatten.bundle_per_module(entry, loaded, target);
  if (pm_mode == "count") {
    print(util.i32_to_string(parts.len()) + "\n");
    return 0;
  }
  let v = per_module_view(entry_path, entry, loaded, parts, target);
  let infmods = v.u.mods;
  if (pm_mode == "func-counts" || pm_mode == "shape") {
    let fci = 0;
    while (fci < infmods.len()) {
      let line = util.i32_to_string(infmods[fci].funcs.len());
      if (pm_mode == "shape") {
        line = parts[fci].ns + "|" + line;
      }
      print(line + "\n");
      fci += 1;
    }
    return 0;
  }
  if (pm_mode == "emit-all") {
    let needs = ircore.all_runtime_need_roots();
    let units = flat_unit_list(entry_path, parts, infmods, func_budget);
    let srchashes: string[] = [];
    let keys_ea = view_keys(v, cache_dir);
    if (cache_dir.len() > 0) {
      let chi = 0;
      while (chi < parts.len()) {
        srchashes = srchashes.append(modloader.module_src_hash(modloader.no_overlay(), entry_path, parts, chi));
        chi += 1;
      }
    }
    let uidx = 0;
    while (uidx < units.len()) {
      if (uidx < unit_lo || uidx >= unit_hi) {
        uidx += 1;
        continue;
      }
      let idx = nth_field_i32(units[uidx], 0);
      let uextra: string[] = [];
      if (parts[idx].is_entry) {
        uextra = needs;
      }
      let usrc = "";
      if (srchashes.len() > 0) {
        usrc = srchashes[idx];
      }
      let ucache = unit_cache_file(cache_dir, parts, v, keys_ea, usrc, idx, uextra, nth_field_i32(units[uidx], 1), nth_field_i32(units[uidx], 2));
      if (!emit_unit_to_file(out_dir, units[uidx], v, parts, idx, needs, target, ucache)) {
        return 1;
      }
      uidx += 1;
    }
    return 0;
  }
  let sighashes: string[] = [];
  if (pm_mode == "manifest" || pm_mode == "emit" && cache_dir.len() > 0) {
    let shi = 0;
    while (shi < parts.len()) {
      sighashes = sighashes.append(util.hash_key(modloader.module_sig_string(infmods[shi])));
      shi += 1;
    }
  }
  if (pm_mode == "manifest") {
    let mi = 0;
    while (mi < parts.len()) {
      let src_hash = modloader.module_src_hash(modloader.no_overlay(), entry_path, parts, mi);
      print(parts[mi].ns + "|" + src_hash + "|" + sighashes[mi] + "|" + modloader.module_dep_ns(parts, infmods, mi) + "\n");
      mi += 1;
    }
    return 0;
  }
  if (pm_mode == "needs") {
    let needs = ircore.all_runtime_need_roots();
    let no = 0;
    while (no < needs.len()) {
      print(needs[no] + "\n");
      no += 1;
    }
    return 0;
  }
  if (pm_index < 0 || pm_index >= parts.len()) {
    eprint("per-module: emit index out of range");
    return 1;
  }
  let extra: string[] = [];
  if (parts[pm_index].is_entry) {
    extra = pm_extra;
    if (pm_lo > 0 || pm_hi >= 0 && pm_hi < infmods[pm_index].funcs.len()) {
      eprint("per-module: the entry is emitted whole, not in a -func-range window");
      return 1;
    }
  }
  let cachefile = "";
  if (cache_dir.len() > 0) {
    let src_hash = modloader.module_src_hash(modloader.no_overlay(), entry_path, parts, pm_index);
    cachefile = unit_cache_file(cache_dir, parts, v, view_keys(v, cache_dir), src_hash, pm_index, extra, pm_lo, pm_hi);
    if (cachefile.len() > 0) {
      match (read_file(cachefile)) {
        Ok(cached) => {
          eprint("cache-hit " + parts[pm_index].ns);
          write(cached);
          return 0;
        },
        Err(e) => {}
      }
    }
  }
  let shard_ns = parts[pm_index].ns;
  if (pm_lo > 0) {
    shard_ns = shard_ns + "_s" + util.i32_to_string(pm_lo);
  }
  let unit = emit_unit(v, pm_index, parts[pm_index].is_entry, shard_ns, extra, pm_lo, pm_hi, target);
  write(unit);
  if (cachefile.len() > 0) {
    eprint("cache-miss " + parts[pm_index].ns);
    match (write_file(cachefile, unit)) {
      Err(werr) => {
        eprint("per-module: cache write failed for " + parts[pm_index].ns);
      },
      Ok(_) => {}
    }
  }
  return 0;
}

function fold_target_calls(entry: parser.Module, loaded: flatten.LoadedModule[], target: string): (parser.Module, flatten.LoadedModule[]) {
  let d = platforms.for_target(target);
  let e2 = constfold.fold_target_name(entry, d.environment, d.isa);
  let out: flatten.LoadedModule[] = [];
  for lm in loaded {
    out = out.append(flatten.LoadedModule { name: lm.name, ident: lm.ident, mod: constfold.fold_target_name(lm.mod, d.environment, d.isa) });
  }
  return (e2, out);
}

function main(): i32 {
  let a = args();
  let probe = false;
  let vprovided = false;
  let paudit = false;
  let entry_path = "";
  let pm_mode = "";
  let pm_index: i32 = -1;
  let pm_extra: string[] = [];
  let cache_dir = "";
  let pm_lo = 0;
  let pm_hi: i32 = -1;
  let target = "x86-64-linux";
  let out_dir = "";
  let func_budget = 100;
  let unit_lo = 0;
  let unit_hi = 2000000000;
  let unit_batch = 64;
  let force_spawned = false;
  let ai = 1;
  while (ai < a.len()) {
    if (a[ai] == "-ir-probe") {
      probe = true;
    } else if (a[ai] == "-verifyprovided") {
      vprovided = true;
    } else if (a[ai] == "-provided-audit") {
      paudit = true;
    } else if (a[ai] == "-per-module-count") {
      pm_mode = "count";
    } else if (a[ai] == "-per-module-needs") {
      pm_mode = "needs";
    } else if (a[ai] == "-per-module-func-counts") {
      pm_mode = "func-counts";
    } else if (a[ai] == "-per-module-shape") {
      pm_mode = "shape";
    } else if (a[ai] == "-per-module-manifest") {
      pm_mode = "manifest";
    } else if (a[ai] == "-per-module-emit" && ai + 1 < a.len()) {
      pm_mode = "emit";
      pm_index = util.digits_to_i32(a[ai + 1]);
      ai += 1;
    } else if (a[ai] == "-per-module-emit-all") {
      pm_mode = "emit-all";
    } else if (a[ai] == "-unit-batch" && ai + 1 < a.len()) {
      unit_batch = util.digits_to_i32(a[ai + 1]);
      ai += 1;
    } else if (a[ai] == "-spawned") {
      force_spawned = true;
    } else if (a[ai] == "-out-dir" && ai + 1 < a.len()) {
      out_dir = a[ai + 1];
      ai += 1;
    } else if (a[ai] == "-func-budget" && ai + 1 < a.len()) {
      func_budget = util.digits_to_i32(a[ai + 1]);
      ai += 1;
    } else if (a[ai] == "-unit-range" && ai + 1 < a.len()) {
      let urng = a[ai + 1];
      let uci = 0;
      while (uci < urng.len() && urng[uci] != b':') {
        uci += 1;
      }
      unit_lo = util.digits_to_i32(urng);
      if (uci + 1 <= urng.len()) {
        unit_hi = util.digits_to_i32(slice_unchecked(urng, uci + 1, urng.len()));
      }
      ai += 1;
    } else if (a[ai] == "-extra-need" && ai + 1 < a.len()) {
      pm_extra = pm_extra.append(a[ai + 1]);
      ai += 1;
    } else if (a[ai] == "-cache-dir" && ai + 1 < a.len()) {
      cache_dir = a[ai + 1];
      ai += 1;
    } else if (a[ai] == "-target" && ai + 1 < a.len()) {
      target = a[ai + 1];
      ai += 1;
    } else if (a[ai] == "-func-range" && ai + 1 < a.len()) {
      let rng = a[ai + 1];
      let ci = 0;
      while (ci < rng.len() && rng[ci] != b':') {
        ci += 1;
      }
      pm_lo = util.digits_to_i32(rng);
      if (ci + 1 <= rng.len()) {
        pm_hi = util.digits_to_i32(slice_unchecked(rng, ci + 1, rng.len()));
      }
      ai += 1;
    } else if (entry_path == "") {
      entry_path = a[ai];
    }
    ai += 1;
  }
  if (target != "x86-64-linux" && target != "arm64-linux") {
    eprint("asm_modload_run: unknown -target: " + target + " (want x86-64-linux, arm64-linux)");
    return 2;
  }
  if (paudit) {
    return provided_audit();
  }
  if (entry_path == "") {
    eprint("usage: asm_modload_run <entry.fern> [-verifyprovided | -provided-audit | -ir-probe | -per-module-count | -per-module-needs | -per-module-func-counts | -per-module-shape | -per-module-manifest | -per-module-emit N [-func-range LO:HI] | -per-module-emit-all -out-dir DIR [-func-budget N] [-unit-range LO:HI]] [-cache-dir DIR]");
    return 2;
  }
  match (read_file(entry_path)) {
    Ok(src) => {
      let entry = parser.parse_module(lexer.tokenize(src));
      let g = modloader.load_graph(modloader.no_overlay(), entry_path, entry, "");
      entry = g.entry;
      let imported = g.loaded;
      let missing = g.missing;
      if (modloader.report_unresolved(missing, "asm_modload_run")) {
        return 1;
      }
      let loaded = imported;
      let (fentry, floaded) = fold_target_calls(entry, loaded, target);
      entry = fentry;
      loaded = floaded;
      let parsed: parser.Module[] = [entry];
      for lm in loaded {
        parsed = parsed.append(lm.mod);
      }
      if (asmcore.refuse_parse_errors(parsed)) {
        return 1;
      }
      if (pm_mode.len() > 0) {
        return run_per_module(entry_path, entry, loaded, pm_mode, pm_index, pm_extra, cache_dir, pm_lo, pm_hi, target, out_dir, func_budget, unit_lo, unit_hi);
      }
      let merged = merged_program(entry_path, entry, loaded, target);
      if (vprovided) {
        return verify_provided_module(merged, target);
      }
      if (probe) {
        write(semlower.verdict_text(semlower.verdict(merged, target)));
        return 0;
      }
      if (force_spawned) {
        let src = emit_per_module_spawned(entry_path, entry, loaded, target, func_budget, unit_batch, a[0], cache_dir);
        if (src == 0) {
          return 0;
        }
        if (src == 2) {
          eprint("asm_modload_run: spawned per-module emit failed after writing output");
          return 1;
        }
      }
      if (target == "arm64-linux") {
        let d64 = semlower.driven_shaken(merged_emitted(merged), target);
        write(asm_arm64_ir.emit_module_or_error_sub(d64.full, false, d64.sub, 0 as usize));
        return 0;
      }
      let d = semlower.driven_shaken(merged_emitted(merged), target);
      write(asm_ir.emit_module_or_error_sub(d.full, d.sub, 0 as usize));
      return 0;
    },
    Err(e) => {
      eprint("asm_modload_run: could not read entry file");
      return 1;
    }
  }
  return 3;
}
