import "../lexer";
import "../parser";
import "../caps";
import "../util";

function parse(src: string): parser.Module {
  let mod: parser.Module = parser.parse_module(lexer.tokenize(src));
  let funcs: parser.FuncDecl[] = [];
  for f in mod.funcs {
    funcs = funcs.append(parser.FuncDecl { ...f, module: util.mangled_module(f.name) });
  }
  return parser.Module { ...mod, funcs: funcs };
}

function app_pkgs(governed: boolean, grants: string[]): caps.Pkg[] {
  let none: string[] = [];
  return [
    caps.Pkg { module: "", dir: "app", name: "app", root: true, governed: false, grants: none },
    caps.Pkg { module: "helper", dir: "helper", name: "helper", root: false, governed: governed, grants: grants },
  ];
}

function row_caps(rows: caps.Row[], pkg: string): string {
  let i: i32 = 0;
  while (i < rows.len()) {
    if (rows[i].pkg == pkg) {
      let out: string = "";
      let u: i32 = 0;
      while (u < rows[i].uses.len()) {
        if (u > 0) {
          out = out + ",";
        }
        out = out + rows[i].uses[u].capability;
        u = u + 1;
      }
      if (out.len() == 0) {
        return "-";
      }
      return out;
    }
    i = i + 1;
  }
  return "";
}

function main(): i32 {
  let bs: caps.BuiltinCap[] = caps.builtin_caps();
  let vocab: string[] = caps.capabilities();
  let i: i32 = 0;
  while (i < bs.len()) {
    if (!util.has_str(vocab, bs[i].capability)) {
      return 1;
    }
    i = i + 1;
  }
  let v: i32 = 1;
  while (v < vocab.len()) {
    if (!util.str_less(vocab[v - 1], vocab[v])) {
      return 2;
    }
    v = v + 1;
  }
  let ung: string[] = caps.ungated();
  let u2: i32 = 0;
  while (u2 < ung.len()) {
    if (caps.capability_of(ung[u2]).len() > 0) {
      return 3;
    }
    u2 = u2 + 1;
  }
  let fu: i32 = 0;
  let fung: string[] = caps.frontend_ungated();
  while (fu < fung.len()) {
    if (caps.capability_of(fung[fu]).len() > 0) {
      return 4;
    }
    if (util.has_str(ung, fung[fu])) {
      return 5;
    }
    fu = fu + 1;
  }
  let d1: i32 = 0;
  while (d1 < bs.len()) {
    let d2: i32 = d1 + 1;
    while (d2 < bs.len()) {
      if (bs[d1].builtin == bs[d2].builtin) {
        return 6;
      }
      d2 = d2 + 1;
    }
    d1 = d1 + 1;
  }

  let reg: string[] = parser.builtin_function_names();
  let r: i32 = 0;
  while (r < reg.len()) {
    if (!caps.classified(reg[r])) {
      eprint("caps: unclassified builtin: " + reg[r]);
      return 7;
    }
    r = r + 1;
  }
  let fe: i32 = 0;
  while (fe < fung.len()) {
    if (!util.has_str(reg, fung[fe])) {
      return 8;
    }
    fe = fe + 1;
  }

  let two: parser.Module = parse("function main(): i32 { helper__save(\"x\"); return 0; }\n"
    + "function helper__save(s: string): void { write_file(\"/tmp/x\", s); }\n");
  let granted: caps.Row[] = caps.analyze(two, app_pkgs(true, ["fs"]));
  if (granted.len() != 2) {
    return 10;
  }
  if (row_caps(granted, "app") != "fs") {
    return 11;
  }
  if (row_caps(granted, "helper") != "fs") {
    return 12;
  }
  if (caps.format_rows(granted) != "app  fs  (example: main → helper__save → write_file)\n"
    + "helper  fs  (example: helper__save → write_file)\n") {
    return 13;
  }

  let dead: parser.Module = parse("function main(): i32 { return 0; }\n"
    + "function helper__unused(): void { tcp_close(0); }\n");
  if (row_caps(caps.analyze(dead, app_pkgs(true, ["net"])), "helper") != "net") {
    return 14;
  }
  if (row_caps(caps.analyze(dead, app_pkgs(true, ["net"])), "app") != "-") {
    return 15;
  }

  let thru: parser.Module = parse("function main(): i32 { helper__get(); return 0; }\n"
    + "function helper__get(): void { fetch__send(); }\n"
    + "function fetch__send(): void { tcp_close(0); }\n");
  let trows: caps.Row[] = caps.analyze(thru, app_pkgs(true, ["net"]));
  if (trows.len() != 2) {
    return 16;
  }
  if (row_caps(trows, "helper") != "net") {
    return 17;
  }
  if (row_caps(trows, "fetch") != "") {
    return 18;
  }

  let meth: parser.Module = parse("struct Client { id: i32 }\n"
    + "function main(): i32 { let c: Client = Client { id: 1 }; helper__use(c); return 0; }\n"
    + "function helper__use(c: Client): void { c.save(); }\n"
    + "function (c: Client) save(): void { write_file(\"/tmp/x\", \"y\"); }\n");
  if (row_caps(caps.analyze(meth, app_pkgs(true, ["fs"])), "helper") != "fs") {
    return 19;
  }
  let shadow: parser.Module = parse("struct Sb { n: i32 }\n"
    + "function main(): i32 { return 0; }\n"
    + "function helper__probe(s: Sb): void { s.stat(); }\n"
    + "function (s: Sb) stat(): void { }\n");
  if (row_caps(caps.analyze(shadow, app_pkgs(true, ["fs"])), "helper") != "-") {
    return 20;
  }

  if (caps.enforce(granted, app_pkgs(true, ["fs"])).len() != 0) {
    return 30;
  }

  let over: caps.Row[] = caps.analyze(two, app_pkgs(true, ["net"]));
  let errs: caps.Violation[] = caps.enforce(over, app_pkgs(true, ["net"]));
  if (errs.len() != 1) {
    return 31;
  }
  if (!errs[0].governed) {
    return 32;
  }
  if (errs[0].pkg != "helper" || errs[0].capability != "fs") {
    return 33;
  }
  if (caps.violation_message(errs[0]) != "package \"helper\" reaches 'fs' (write_file) without a capability grant: helper__save → write_file; add \"fs\" to its capabilities in fern.toml or remove the call") {
    return 34;
  }

  let warns: caps.Violation[] = caps.enforce(caps.analyze(two, app_pkgs(false, [])), app_pkgs(false, []));
  if (warns.len() != 1) {
    return 35;
  }
  if (warns[0].governed) {
    return 36;
  }
  if (caps.violation_message(warns[0]) != "package \"helper\" reaches 'fs' (write_file) but no capabilities key governs it: helper__save → write_file; add capabilities = [...] to its dependency entry in fern.toml (ungoverned packages will become errors once default-deny lands)") {
    return 37;
  }

  let denied: caps.Violation[] = caps.enforce(caps.analyze(two, app_pkgs(true, [])), app_pkgs(true, []));
  if (denied.len() != 1 || !denied[0].governed) {
    return 38;
  }

  let rootonly: parser.Module = parse("function main(): i32 { write_file(\"/tmp/x\", \"y\"); tcp_close(0); return 0; }\n");
  let rp: caps.Pkg[] = app_pkgs(true, []);
  if (caps.enforce(caps.analyze(rootonly, rp), rp).len() != 0) {
    return 39;
  }
  if (caps.enforceable(rootonly, rp)) {
    return 40;
  }
  if (!caps.enforceable(two, rp)) {
    return 41;
  }

  print("caps: every package-capability rule agrees\n");
  return 0;
}
