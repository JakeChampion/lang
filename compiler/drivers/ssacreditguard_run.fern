import "../ssacreditguard" as guard;

function must(r: Result[guard.Built, guard.BuildError]): guard.Built {
  return match (r) { Ok(value) => value, Err(error) => { print(error.message); exit(1); } };
}

function is_failed(r: Result[guard.Built, guard.BuildError]): boolean {
  return match (r) { Ok(_) => false, Err(_) => true };
}

function require(ok: boolean, id: i32): void {
  if (!ok) {
    exit(id);
  }
}

function is_value(r: Option[i32], expected: i32): boolean {
  return match (r) { Some(value) => value == expected, None => false };
}

function is_absent(r: Option[i32]): boolean {
  return match (r) { Some(_) => false, None => true };
}

function main(): i32 {
  let p = must(guard.predicate(guard.empty(), 17));
  let q = must(guard.predicate(p.arena, 3));
  let r = must(guard.predicate(q.arena, 2147483647));
  let one = guard.constant(r.arena, 1);
  let zero = guard.constant(one.arena, 0);
  let pq = must(guard.combine(zero.arena, 0, p.id, q.id));
  let sum = must(guard.combine(pq.arena, 0, pq.id, r.id));
  let qr = must(guard.combine(sum.arena, 0, q.id, r.id));
  let associated = must(guard.combine(qr.arena, 0, p.id, qr.id));
  require(associated.id == sum.id, 2);
  let diff = must(guard.combine(associated.arena, 1, p.id, q.id));
  let eq = must(guard.combine(diff.arena, 2, p.id, q.id));
  let less = must(guard.combine(eq.arena, 3, p.id, q.id));
  let mask: i32 = 0;
  while (mask < 8) {
    let pv: i32 = mask & 1;
    let qv: i32 = mask >> 1 & 1;
    let rv: i32 = mask >> 2 & 1;
    let values: boolean[] = [pv != 0, qv != 0, rv != 0];
    let total = guard.evaluate(less.arena, sum.id, [17, 3, 2147483647], values);
    let delta = guard.evaluate(less.arena, diff.id, [17, 3, 2147483647], values);
    let equal = guard.evaluate(less.arena, eq.id, [17, 3, 2147483647], values);
    let lt = guard.evaluate(less.arena, less.id, [17, 3, 2147483647], values);
    require(is_value(total, pv + qv + rv), 3);
    require(is_value(delta, pv - qv), 4);
    require(match (equal) { Some(value) => value == 1 == (pv == qv), None => false }, 5);
    require(match (lt) { Some(value) => value == 1 == pv < qv, None => false }, 6);
    mask = mask + 1;
  }
  let shared = must(guard.combine(less.arena, 1, one.id, p.id));
  let acquired = must(guard.combine(shared.arena, 0, p.id, shared.id));
  require(guard.is_constant(acquired.arena, acquired.id, 1), 7);
  require(!guard.is_constant(acquired.arena, p.id, 1), 8);
  require(!guard.is_constant(acquired.arena, shared.id, 1), 9);
  let wrong = must(guard.combine(acquired.arena, 0, p.id, q.id));
  require(!guard.is_constant(wrong.arena, wrong.id, 1), 10);
  let doubled = must(guard.combine(wrong.arena, 0, acquired.id, shared.id));
  require(!guard.is_constant(doubled.arena, doubled.id, 1), 11);
  let consumed = must(guard.combine(doubled.arena, 1, acquired.id, one.id));
  require(guard.is_constant(consumed.arena, consumed.id, 0), 12);
  let extra_drop = must(guard.combine(consumed.arena, 1, consumed.id, p.id));
  let negative = must(guard.combine(extra_drop.arena, 3, extra_drop.id, zero.id));
  require(negative.id == p.id, 13);
  let repeated = must(guard.combine(negative.arena, 0, p.id, shared.id));
  require(repeated.id == acquired.id && guard.node_count(repeated.arena) == guard.node_count(negative.arena), 14);
  let original = guard.evaluate(p.arena, p.id, [17], [true]);
  require(is_value(original, 1) && guard.node_count(p.arena) == 3, 15);
  require(is_absent(guard.evaluate(p.arena, p.id, [], [])), 16);
  require(is_absent(guard.evaluate(p.arena, p.id, [17, 17], [true, false])), 17);
  require(is_absent(guard.evaluate(p.arena, 99, [17], [true])), 18);
  require(is_failed(guard.predicate(p.arena, -1)), 19);
  require(is_failed(guard.combine(p.arena, 5, 0, 1)), 20);
  require(is_failed(guard.combine(p.arena, 0, -1, 1)), 21);
  let max = guard.constant(repeated.arena, 2147483647);
  require(is_failed(guard.combine(max.arena, 0, max.id, one.id)), 22);
  let min = guard.constant(max.arena, -2147483648);
  require(is_failed(guard.combine(min.arena, 1, min.id, one.id)), 23);
  let extremes = must(guard.select(min.arena, p.id, max.id, min.id));
  let nested = must(guard.select(extremes.arena, q.id, extremes.id, diff.id));
  let feasible = must(guard.combine(nested.arena, 4, p.id, q.id));
  let obligation = must(guard.combine(feasible.arena, 4, feasible.id, shared.id));
  require(guard.is_constant(obligation.arena, obligation.id, 0), 24);
  let wrong_obligation = must(guard.combine(obligation.arena, 4, feasible.id, one.id));
  require(!guard.is_constant(wrong_obligation.arena, wrong_obligation.id, 0), 25);
  let equal_branches = must(guard.select(wrong_obligation.arena, r.id, nested.id, nested.id));
  require(equal_branches.id == nested.id, 26);
  let joined = must(guard.select(equal_branches.arena, p.id, p.id, shared.id));
  require(guard.is_constant(joined.arena, joined.id, 1), 27);
  let false_path = must(guard.combine(joined.arena, 4, p.id, shared.id));
  let unreachable = must(guard.combine(false_path.arena, 4, false_path.id, min.id));
  require(guard.is_constant(unreachable.arena, unreachable.id, 0), 28);
  let two = guard.constant(unreachable.arena, 2);
  let invalid_mask = must(guard.select(two.arena, r.id, two.id, zero.id));
  require(is_failed(guard.combine(invalid_mask.arena, 4, invalid_mask.id, zero.id)), 29);
  require(is_failed(guard.select(invalid_mask.arena, invalid_mask.id, one.id, one.id)), 30);
  require(is_failed(guard.select(invalid_mask.arena, p.id, -1, zero.id)), 31);
  require(is_failed(guard.select(invalid_mask.arena, zero.id, one.id, -1)), 32);
  let negative_mask = guard.constant(invalid_mask.arena, -1);
  require(is_failed(guard.combine(negative_mask.arena, 4, negative_mask.id, zero.id)), 33);
  mask = 0;
  while (mask < 8) {
    let pv: i32 = mask & 1;
    let qv: i32 = mask >> 1 & 1;
    let rv: i32 = mask >> 2 & 1;
    let values: boolean[] = [pv != 0, qv != 0, rv != 0];
    let expected: i32 = -2147483648;
    if (pv != 0) {
      expected = 2147483647;
    }
    let extreme_value = guard.evaluate(negative_mask.arena, extremes.id, [17, 3, 2147483647], values);
    require(is_value(extreme_value, expected), 34);
    if (qv == 0) {
      expected = pv - qv;
    }
    let nested_value = guard.evaluate(negative_mask.arena, nested.id, [17, 3, 2147483647], values);
    let feasible_value = guard.evaluate(negative_mask.arena, feasible.id, [17, 3, 2147483647], values);
    require(is_value(nested_value, expected), 35);
    require(is_value(feasible_value, pv * qv), 36);
    mask = mask + 1;
  }
  require(is_absent(guard.evaluate(guard.empty(), 0, [], [])), 37);
  require(is_absent(guard.evaluate(negative_mask.arena, -1, [], [])), 38);
  require(is_absent(guard.evaluate(negative_mask.arena, p.id, [17], [true, false])), 39);
  require(is_absent(guard.evaluate(negative_mask.arena, zero.id, [-1], [false])), 40);
  require(is_value(guard.evaluate(negative_mask.arena, zero.id, [], []), 0), 41);
  require(is_value(guard.evaluate(negative_mask.arena, min.id, [], []), -2147483648), 42);
  require(is_value(guard.evaluate(negative_mask.arena, max.id, [], []), 2147483647), 43);
  require(is_value(guard.evaluate(negative_mask.arena, zero.id, [99], [true]), 0), 44);
  let partial_three = guard.constant(guard.empty(), 3);
  let partial_one = guard.constant(partial_three.arena, 1);
  let partial_max = guard.constant(partial_one.arena, 2147483647);
  let partial_pred = must(guard.predicate(partial_max.arena, 7));
  let partial_decision = must(guard.select(partial_pred.arena, partial_pred.id, partial_max.id, partial_three.id));
  let before_nodes = guard.node_count(partial_decision.arena);
  let before_memo = partial_decision.arena.memo.len();
  let error: guard.BuildError = match (guard.combine(partial_decision.arena, 0, partial_decision.id, partial_one.id)) { Ok(_) => { exit(45); }, Err(value) => value };
  require(error.message == "guarded credit overflow" && guard.node_count(error.arena) == before_nodes + 1 && error.arena.memo.len() == before_memo + 1, 46);
  require(guard.node_count(partial_decision.arena) == before_nodes && partial_decision.arena.memo.len() == before_memo, 47);
  let recovered = must(guard.combine(error.arena, 0, partial_three.id, partial_one.id));
  require(is_value(guard.evaluate(recovered.arena, recovered.id, [], []), 4), 48);
  print("guarded credit algebra: all controls agree");
  return 0;
}
