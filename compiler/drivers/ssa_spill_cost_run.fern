import "../ssa";
import "../ssafixed";
import "../util";

function inst(kind: i32, v: i32, args: i32[]): ssa.SInst {
  return ssa.SInst { kind_tag: kind, result: v, args: args, imm: 7, str: "clz" };
}

function probe(reads: i32): ssa.Alloc {
  return probe_costs(reads, false, false);
}

function probe_costs(reads: i32, folded: boolean, rhs: boolean): ssa.Alloc {
  let ops: ssa.SInst[] = [inst(1, 0, []), inst(1, 1, []), inst(1, 2, []), inst(1, 3, []), inst(10, 4, [1])];
  for i in 5..100 {
    if (i < 5 + reads) {
      if (rhs) {
        ops = ops.append(ssa.SInst { kind_tag: ssa.BINARY, result: i, args: [2, 0], imm: 0, str: "add" });
      } else {
        ops = ops.append(inst(10, i, [0]));
      }
    } else {
      ops = ops.append(inst(1, i, []));
    }
  }
  let f = ssa.SFunc { name: "spill", nparams: 0, nvals: 100, entry: 0, takes_env: false, blocks: [ssa.SBlock { id: 0, insts: ops, preds: [], term: ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: 0 } }] };
  let no_home: boolean[] = [false, false];
  for i in 2..100 {
    no_home = no_home.append(true);
  }
  if (folded) {
    return ssa.regalloc_linear_fixed_costs(f, 1, 0, -1, false, no_home, [], [], 0, 0, ssafixed.none(), [], [], [], ssa.SpillCosts { fold_alu_rhs: true });
  }
  return ssa.regalloc_linear(f, 1, 0, -1, false, no_home, [], [], 0, 0);
}

function main(): i32 {
  let failures = 0;
  let hot = probe(9);
  if (hot.reg_of[0] < 0 || hot.reg_of[1] >= 0) {
    failures += 1;
  }
  let cold = probe(1);
  if (cold.reg_of[0] >= 0 || cold.reg_of[1] < 0) {
    failures += 1;
  }
  let folded_hot = probe_costs(9, true, false);
  if (folded_hot.reg_of[0] < 0 || folded_hot.reg_of[1] >= 0) {
    failures += 1;
  }
  let folded_cold = probe_costs(1, true, false);
  if (folded_cold.reg_of[0] >= 0 || folded_cold.reg_of[1] < 0) {
    failures += 1;
  }
  let plain_rhs = probe_costs(9, false, true);
  if (plain_rhs.reg_of[0] < 0 || plain_rhs.reg_of[1] >= 0) {
    failures += 1;
  }
  let folded_rhs = probe_costs(9, true, true);
  if (folded_rhs.reg_of[0] >= 0 || folded_rhs.reg_of[1] < 0) {
    failures += 1;
  }
  print("failures=" + util.i32_to_string(failures));
  return failures;
}
