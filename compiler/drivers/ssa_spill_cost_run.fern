import "../ir";
import "../ssa";
import "../ssafixed";
import "../util";

function inst(kind: i32, v: i32, args: i32[]): ssa.SInst {
  return ssa.SInst { ir_kind: 0, kind_tag: kind, result: v, args: args, imm: 7, str: "clz" };
}

function probe(reads: i32): ssa.Alloc {
  return probe_costs(reads, false, false, []);
}

function probe_func(reads: i32, rhs: boolean): ssa.SFunc {
  let ops: ssa.SInst[] = [inst(ssa.CONST_INT, 0, []), inst(ssa.CONST_INT, 1, []), inst(ssa.CONST_INT, 2, []), inst(ssa.CONST_INT, 3, []), inst(ssa.UNARY, 4, [1])];
  for i in 5..100 {
    if (i < 5 + reads) {
      if (rhs) {
        ops = ops.append(ssa.binary_inst(i, [2, 0], 0, ir.K_ADD));
      } else {
        ops = ops.append(inst(ssa.UNARY, i, [0]));
      }
    } else {
      ops = ops.append(inst(ssa.CONST_INT, i, []));
    }
  }
  return ssa.SFunc { name: "spill", nparams: 0, nvals: 100, entry: 0, takes_env: false, blocks: [ssa.SBlock { id: 0, insts: ops, preds: [], term: ssa.STerm { kind_tag: ssa.TERM_RET, cond: 0, target: 0, t: 0, f: 0, value: 0 } }] };
}

// spilled names the values of an earlier allocation in frame slots.
function probe_costs(reads: i32, folded: boolean, rhs: boolean, spilled: boolean[]): ssa.Alloc {
  let f = probe_func(reads, rhs);
  let no_home: boolean[] = [false, false];
  for i in 2..100 {
    no_home = no_home.append(true);
  }
  if (folded) {
    return ssa.regalloc_linear_fixed_costs(f, 1, 0, -1, false, no_home, [], [], 0, 0, ssafixed.none(), [], [], [], [], ssa.SpillCosts { fold_alu_rhs: true, two_address: false, spilled: spilled, stack_params: -1 });
  }
  return ssa.regalloc_linear(f, 1, 0, -1, false, no_home, [], [], 0, 0);
}

// Neither a loop bound in a slot nor a register index needs a move for cmp.
function compare_cost(regs: i32[]): i32 {
  let term = ssa.STerm { kind_tag: ssa.TERM_BRIF, cond: 2, target: 0, t: 1, f: 2, value: -1 };
  let ret = ssa.STerm { ...term, kind_tag: ssa.TERM_RET, value: -1 };
  let end = ssa.SBlock { id: 1, insts: [], preds: [0], term: ret };
  let entry = ssa.SBlock { id: 0, insts: [ssa.binary_inst(2, [0, 1], 0, ir.K_LT_S)], preds: [], term: term };
  let f = ssa.SFunc { name: "cmp", nparams: 2, nvals: 3, entry: 0, takes_env: false, blocks: [entry, end, ssa.SBlock { ...end, id: 2 }] };
  return ssa.spill_cost(f, regs, ssa.SpillCosts { fold_alu_rhs: true, two_address: true, spilled: ssa.slotted_values(regs), stack_params: -1 });
}

function ret_of(v: i32): ssa.STerm {
  return ssa.STerm { kind_tag: ssa.TERM_RET, cond: 0, target: 0, t: 0, f: 0, value: v };
}

// Value 0 is read only as a factor of a product and its high half, and value 1
// by one plain read. With one register, the factor takes the slot when the
// reads of a product cost nothing.
function factor_probe(fold: boolean): ssa.Alloc {
  let ops: ssa.SInst[] = [inst(ssa.CONST_INT, 0, []), inst(ssa.CONST_INT, 1, []), inst(ssa.UNARY, 2, [1])];
  for i in 0..4 {
    ops = ops.append(ssa.binary_inst(3 + 2 * i, [0, 0], 64, ir.K_MUL)).append(ssa.binary_inst(4 + 2 * i, [0, 0], 64, ir.K_MULHI_U));
  }
  ops = ops.append(inst(ssa.UNARY, 11, [1])).append(inst(ssa.UNARY, 12, [0]));
  let f = ssa.SFunc { name: "factor", nparams: 0, nvals: 13, entry: 0, takes_env: false, blocks: [ssa.SBlock { id: 0, insts: ops, preds: [], term: ret_of(12) }] };
  let no_home: boolean[] = [false, false];
  for i in 2..13 {
    no_home = no_home.append(true);
  }
  return ssa.regalloc_linear_fixed_costs(f, 1, 0, -1, false, no_home, [], [], 0, 0, ssafixed.none(), [], [], [], [], ssa.SpillCosts { fold_alu_rhs: fold, two_address: false, spilled: [], stack_params: -1 });
}

// Parameter 1 is read once, as the right operand of an add. When it arrives
// on the stack, it keeps no register and takes the last slot.
function stack_probe(stack_params: i32): ssa.Alloc {
  let ops: ssa.SInst[] = [ssa.SInst { ir_kind: 0, kind_tag: ssa.PARAM, result: 0, args: [], imm: 0, str: "" }, ssa.SInst { ir_kind: 0, kind_tag: ssa.PARAM, result: 1, args: [], imm: 1, str: "" }, inst(ssa.UNARY, 2, [0]), inst(ssa.UNARY, 3, [0]), ssa.binary_inst(4, [0, 1], 0, ir.K_ADD), ssa.binary_inst(5, [4, 2], 0, ir.K_MUL), ssa.binary_inst(6, [5, 3], 0, ir.K_MUL)];
  let f = ssa.SFunc { name: "stack", nparams: 2, nvals: 7, entry: 0, takes_env: false, blocks: [ssa.SBlock { id: 0, insts: ops, preds: [], term: ret_of(6) }] };
  return ssa.regalloc_linear_fixed_costs(f, 4, 0, -1, false, [], [], [], 0, 0, ssafixed.none(), [], [], [], [], ssa.SpillCosts { fold_alu_rhs: true, two_address: false, spilled: [], stack_params: stack_params });
}

function main(): i32 {
  let failures = 0;
  let hot = probe(9);
  if (hot.reg_of[0] < 0 || hot.reg_of[1] >= 0) {
    failures += 1;
  }
  let cold = probe(1);
  if (cold.reg_of[0] >= 0 || cold.reg_of[1] < 0) {
    failures += 1;
  }
  let folded_hot = probe_costs(9, true, false, []);
  if (folded_hot.reg_of[0] < 0 || folded_hot.reg_of[1] >= 0) {
    failures += 1;
  }
  let folded_cold = probe_costs(1, true, false, []);
  if (folded_cold.reg_of[0] >= 0 || folded_cold.reg_of[1] < 0) {
    failures += 1;
  }
  let plain_rhs = probe_costs(9, false, true, []);
  if (plain_rhs.reg_of[0] < 0 || plain_rhs.reg_of[1] >= 0) {
    failures += 1;
  }
  let folded_rhs = probe_costs(9, true, true, []);
  if (folded_rhs.reg_of[0] >= 0 || folded_rhs.reg_of[1] < 0) {
    failures += 1;
  }
  // A folded read beside a left operand in a frame slot costs a load, so the
  // right operand of those reads keeps its register.
  let lhs_slot = __alloc_bool(100).with(2, true);
  let unfolded = probe_costs(9, true, true, lhs_slot);
  if (unfolded.reg_of[0] < 0 || unfolded.reg_of[1] >= 0) {
    failures += 1;
  }
  if (ssa.unfolded_reads(probe_func(9, true), lhs_slot.with(0, true)) != 9 || ssa.unfolded_reads(probe_func(9, true), lhs_slot) != 0) {
    failures += 1;
  }
  // A factor of a product costs nothing in a slot, and a stack parameter
  // with no other cost takes the last slot.
  let factor_slot = factor_probe(true).reg_of[0] < 0 && factor_probe(true).reg_of[1] >= 0 && factor_probe(false).reg_of[0] >= 0;
  let on_stack = stack_probe(1);
  let stack_slot = on_stack.reg_of[0] >= 0 && on_stack.reg_of[1] == -1 - ssa.spill_count(on_stack.reg_of) && stack_probe(-1).reg_of[1] >= 0;
  if (compare_cost([-2, 0, -1]) != 0 || compare_cost([0, -2, -1]) != 0 || compare_cost([-2, -3, -1]) != 1 || !factor_slot || !stack_slot) {
    failures += 1;
  }
  print("failures=" + util.i32_to_string(failures));
  return failures;
}
