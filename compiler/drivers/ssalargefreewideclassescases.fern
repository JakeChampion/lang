function check(cases: Case[]): boolean {
  for c in cases {
    let actual = classes.result(c.mode, c.low, c.high, c.minimum, c.maximum);
    if (actual.len() != c.expected.len()) {
      return false;
    }
    for at in 0..actual.len() {
      if (actual[at] != c.expected[at]) {
        return false;
      }
    }
  }
  return true;
}

