import "../asmcore";
import "../asm_ir";
import "../asm_arm64_ir";
import "../lexer";
import "../parser";
import "../semlower";
import "../ssaprepare";
import "../util";
import "../typeinfo";
import "../semtypes";
import "../ssacreditbound" as bound;
import "../ssacreditselected" as selected;
import "../ssauniquecaller" as caller;
import "../ssauniquemeaning" as meaning;
import "../ssauniqueunit" as unit;

function require(ok: boolean, code: i32): void {
  if (!ok) {
    exit(code);
  }
}

function find(rows: ssaprepare.Emitted[], name: string): i32 {
  let at = -1;
  let i = 0;
  for row in rows {
    if (row.label_name == name) {
      require(at < 0, 201);
      at = i;
    }
    i += 1;
  }
  require(at >= 0, 202);
  return at;
}

// The kind of the instruction that defines `v`, or -1.
function kind_of(row: ssaprepare.Emitted, v: i32): i32 {
  for block in row.body.formed.f.blocks {
    for ins in block.insts {
      if (ins.result == v) {
        return ins.kind_tag;
      }
    }
  }
  return -1;
}

// Whether `v` is a link loaded from a node, or a cell of the drop stack: a
// load, or a phi of loads, of other such phis, of the node of the call and of
// the integer that a link local holds before the first load.
function loaded_value(row: ssaprepare.Emitted, v: i32): boolean {
  let loaded = false;
  for at in reached(row, v, []) {
    let kind = kind_of(row, at);
    if (kind == 40) {
      loaded = true;
    } else if (kind != 8 && kind != 1 && !(kind == 6 && at < row.body.formed.f.nparams)) {
      return false;
    }
  }
  return loaded;
}

// `v` and each value that a phi among them reads.
function reached(row: ssaprepare.Emitted, v: i32, seen: i32[]): i32[] {
  if (util.index_of_i32(seen, v) >= 0) {
    return seen;
  }
  let out = seen.append(v);
  if (kind_of(row, v) == 8) {
    for a in phi_args(row, v) {
      out = reached(row, a, out);
    }
  }
  return out;
}

function phi_args(row: ssaprepare.Emitted, v: i32): i32[] {
  for block in row.body.formed.f.blocks {
    for ins in block.insts {
      if (ins.result == v) {
        return ins.args;
      }
    }
  }
  return [];
}

function loaded_link(row: ssaprepare.Emitted): void {
  let calls = 0;
  for block in row.body.formed.f.blocks {
    for op in block.insts {
      if (op.kind_tag == 11 && op.str == "__fern_rc_is_unique") {
        require(op.args.len() == 1, 203);
        require(loaded_value(row, op.args[0]), 204);
        calls += 1;
      }
    }
  }
  require(calls > 0 && row.sites.len() > 0, 205);
}

function refusals(out: ssaprepare.Output, name: string): void {
  let drop = out.bodies[find(out.bodies, "__sem_drop_" + name)];
  let release = out.bodies[find(out.bodies, "__sem_release_" + name)];
  let arch = drop.context.architecture;
  let described = 0;
  for row in [drop, release] {
    if let Some(helper) = row.body.selected.origin.helper {
      require(semtypes.equal(helper.ty, typeinfo.TypeUnion { name: name, args: [] }), 215);
      require(helper.children_only == (row.label_name == drop.label_name), 216);
      described += 1;
    }
  }
  require(described == 2, 217);
  require(selected.metadata(drop).enums.len() > 0 && selected.contracts(drop).len() == 0, 206);
  require(bound.resolve(out.bodies, drop.label_name, arch).error == "", 207);
  loaded_link(drop);
  require(!meaning.check(drop.body.formed.f).ok, 208);
  require(!caller.check_body(drop.assembly, arch, drop.body.formed.f).ok, 209);
  require(!caller.check_selected(out.bodies, drop.label_name, arch).ok, 210);
  require(!caller.check_selected_lines(drop.assembly.split("\n"), out.bodies, drop.label_name, arch).ok, 211);
  require(release.release_entry.counted && bound.resolve(out.bodies, release.label_name, arch).error == "unproved native release entry effects", 212);
  require(!caller.check_selected(out.bodies, release.label_name, arch).ok, 213);
  require(!unit.check_selected_collection(out.text, arch, out.bodies).ok, 214);
  require(bound.release_selected(out.bodies, release.label_name, drop.label_name, arch).error != "", 224);
}

function program(source: string, name: string, arm: boolean): void {
  let target = if (arm) { "arm64-darwin" } else { "x86-64-linux" };
  let g = semlower.program(semlower.driven(parser.parse_module(lexer.tokenize(source)), target));
  let sw = asmcore.Switches { backtrace: false, sanitize: false, sandbox: false, cover: false, symbols: false, optimize: false, leak_check: false, rc_free_debug: false, var_rows: false, shared: false, size: false, harden: false, heap_limit: 0i64, quarantine: asmcore.quarantine_default(), cpu_limit: 0i64, pie: false, profile: "", target: "", line_maps: [], ram_base: 0i64, ram_size: 0i64, interrupts: [], early: "", secondary: "", user_mode: false };
  let out = if (arm) { asm_arm64_ir.emit_module_ir_unit_arm64_prepared(g.im, false, false, "", [], g.im.funcs, g.stab, 0, -1, g.cache, g.physical, semlower.runtime_module_lowering, sw, true) } else { asm_ir.emit_module_ir_unit_prepared(g.im, false, false, "", [], g.im.funcs, g.stab, 0, -1, g.cache, g.physical, semlower.runtime_module_lowering, 0 as usize, sw, true) };
  refusals(out, name);
}

pub function run(arm: boolean): void {
  program("enum List { Cons(string, List), Nil } @noinline function discard(own xs: List): i32 { return 0; } function main(): i32 { return discard(Cons(\"one\", Cons(\"two\", Nil))); }", "List", arm);
  program("enum Tree { Branch(Tree, string, Tree), Leaf(string), Empty } @noinline function discard(own tree: Tree): i32 { return 0; } function main(): i32 { return discard(Branch(Leaf(\"left\"), \"node\", Leaf(\"right\"))); }", "Tree", arm);
}
