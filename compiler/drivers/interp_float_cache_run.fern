import "../ast";
import "../parser";
import "./rundriver";
import "../interp";

function main(): i32 {
  let mod = rundriver.parse_stdin("interp_float_cache_run");
  if (mod.top_stmts.len() != 1) {
    return 1;
  }
  if let ast.StmtReturn(ret) = mod.top_stmts[0] {
    if let ast.ExprNumber(number) = ret.value {
      if (number.bits == 0i64) {
        return 2;
      }
      // Keep the parsed bits, but replace the text with a different value.
      let zero = if (number.is_float) { "0.0" } else { "0" };
      let changed: ast.Expr = ast.ExprNumber { ...number, text: zero, raw: zero };
      let probe = parser.Module { ...mod, top_stmts: [ast.StmtReturn { ...ret, value: changed }] };
      let expected = number.bits;
      for i in 0..16 {
        match (interp.eval_module(probe)) {
          interp.VFloat(value) => {
            if (!number.is_float || f64_bits(value.v) != expected) {
              return 3;
            }
          },
          interp.VInt(value) => {
            if (number.is_float || value.v as i64 != expected) {
              return 3;
            }
          },
          _ => {
            return 4;
          }
        }
      }
      return 7;
    }
  }
  return 5;
}
