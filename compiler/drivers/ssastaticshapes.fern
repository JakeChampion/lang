import "../ssadecrementtext" as text;
import "../ssaprepare";
import "std/string";

function require(ok: boolean, group: string): void {
  if (!ok) {
    print("static shape byte controls failed: " + group);
    exit(180);
  }
}

function fixture(declaration: string): string {
  return ".text\n__fn_example:\nret\n.section .rodata\n" + declaration + "\n";
}

function bytes(s: string): u8[] {
  let result: u8[] = [];
  for c in s {
    result = result.append(c);
  }
  return result;
}

function check(output: string, symbol: string, expected: u8[], group: string): void {
  let literal = text.readonly_ascii(output, symbol);
  require(literal.error == "", group + ": " + literal.error);
  require(literal.bytes.len() == expected.len(), group + " length");
  let at = 0;
  for c in expected {
    require(literal.bytes[at] == c, group + " byte " + at.to_string());
    at = at + 1;
  }
}

function refuse(output: string, symbol: string, group: string): void {
  let literal = text.readonly_ascii(output, symbol);
  require(literal.error != "" && literal.bytes.len() == 0, group);
}

function octal(n: i32): string {
  return "\\" + (n / 64).to_string() + (n / 8 % 8).to_string() + (n % 8).to_string();
}

function octets(): void {
  let n = 0;
  let combined = "";
  let expected: u8[] = [];
  while (n < 256) {
    let escaped = octal(n);
    check(fixture(".S0: .ascii \"" + escaped + "\""), ".S0", [n as u8], "octet " + n.to_string());
    combined = combined + escaped;
    expected = expected.append(n as u8);
    n = n + 1;
  }
  check(fixture(".S0: .ascii \"" + combined + "\""), ".S0", expected, "all octets");
  // A fourth octal digit is a separate literal byte in this assembler grammar.
  check(fixture(".S0: .ascii \"\\0000\\3777\""), ".S0", [0 as u8, b'0', 255 as u8, b'7'], "bounded octal width");
}

function spelling(): void {
  check(fixture(".S0: .ascii \"\""), ".S0", [], "empty declaration");
  check(fixture(".S0: .ascii \"a\\n\\r\\t\\\"\\\\z\""), ".S0", bytes("a\n\r\t\"\\z"), "named escapes");
  let printable = "";
  let n = 32;
  while (n < 127) {
    if (n != 34 && n != 92) {
      printable = printable + string_from_bytes_unchecked([n as u8]);
    }
    n = n + 1;
  }
  check(fixture(".S0: .ascii \"" + printable + "\""), ".S0", bytes(printable), "printable ASCII including syntax characters");
  for arg in ["\"\\0\"", "\"\\00\"", "\"\\400\"", "\"\\777\"", "\"\\078\"", "\"\\x41\"", "\"\\u0041\"", "\"\\a\"", "\"\\b\"", "\"\\f\"", "\"\\v\"", "\"\\q\"", "\"\\'\"", "\"x\" \"y\"", "\"x\",\"y\"", "\"x\"#tail", "\"x\";ret", "\"unterminated", "plain", "\"é\""] {
    refuse(fixture(".S0: .ascii " + arg), ".S0", "unsupported spelling " + arg);
  }
  refuse(fixture(".S0: .ascii \"" + string_from_bytes_unchecked([127 as u8]) + "\""), ".S0", "DEL byte");
}

function definitions(): void {
  let good = fixture(".S0: .ascii \"Parent\"");
  check(good, ".S0", bytes("Parent"), "inline definition");
  check(fixture(".S0:\n# comment\n\t.ascii \"Parent\""), ".S0", bytes("Parent"), "bare contiguous definition");
  check(good.split("\n").join("\r\n\t"), ".S0", bytes("Parent"), "CRLF indentation");
  check(good + ".byte 0\n", ".S0", bytes("Parent"), "only selected declaration extent");
  for section in [".data", ".bss", ".text"] {
    refuse(good.split(".section .rodata").join(section), ".S0", "wrong section " + section);
  }
  for tail in ["", ".asciz \"Parent\"", ".quad 0", ".align 8\n.ascii \"Parent\"", ".globl .S0\n.ascii \"Parent\"", "other:\n.ascii \"Parent\"", ".data\n.section .rodata\n.ascii \"Parent\""] {
    refuse(fixture(".S0:\n" + tail), ".S0", "noncontiguous or wrong declaration " + tail);
  }
  for suffix in [".S0: .ascii \"Other\"\n", ".text\n.S0:\nret\n", "other: .ascii \"x\"\nother: .ascii \"y\"\n", ".weak .S0\n", ".set other, .S0\n", ".include \"other.s\"\n"] {
    refuse(good + suffix, ".S0", "closed namespace " + suffix);
  }
  for symbol in ["", "absent", "1numeric", "a:b", "a b", "a\n"] {
    refuse(good, symbol, "invalid or absent symbol " + symbol);
  }
}

pub function run(output: ssaprepare.Output): void {
  check(output.text, ".S0", bytes("Parent"), "actual primary constructor shape");
  let changed = output.text.split(".ascii \"Parent\"").join(".ascii \"Other\"");
  require(changed != output.text, "actual declaration mutation present");
  check(changed, ".S0", bytes("Other"), "changed bytes remain data");
  // No selected ABI, constructor use or allocator dependency is proved here.
  require(!output.text.contains("\n__fern_arr_box:\n"), "fixture has no linked allocator");
  octets();
  spelling();
  definitions();
  require(text.dependency(output.text, "__fern_arr_box").error != "", "old dependency policy");
}
