import "../ir";
import "../ssa";
import "../util";

function unary(kind: i32, name: string): ssa.SInst {
  return ssa.SInst { ir_kind: kind, kind_tag: ssa.UNARY, result: 1, args: [0], imm: 0, str: name };
}

function rotate_operands_match(): boolean {
  for width in [32, 64] {
    for count in 0..width {
      let op = unary(ir.K_ROTR, "rotr:" + util.i32_to_string(width) + ":" + util.i32_to_string(count));
      if (ssa.rotr_count(op) != count || ssa.rotr_width(op) != width) {
        return false;
      }
    }
  }
  for name in ["rotr:16:1", "rotr:32:", "rotr:64:x", "rotr:32:-1", "rotr:32:32", "rotr:64:64", "rotr:32:4294967296"] {
    if (ssa.rotr_count(unary(ir.K_ROTR, name)) >= 0) {
      return false;
    }
  }
  return ssa.rotr_count(unary(0, "rotr:32:7")) < 0 && ssa.lifted_kind(ssa.UNARY, "rotr:32:7") == ir.K_ROTR;
}

function unary_loads_match(): boolean {
  let wide = unary(ssa.lifted_kind(ssa.UNARY, "load_i32"), "load_i32");
  let half = unary(ssa.lifted_kind(ssa.UNARY, "load_u16"), "load_u16");
  return ssa.is_unary_load(wide) && wide.ir_kind == ir.K_LOAD_I32 && ssa.is_unary_load(half) && half.ir_kind == ir.K_LOAD
    && !ssa.is_unary_load(unary(0, "load_i32"));
}

// A lifted binary op holds its kind in `ir_kind` only, and the printer shows
// the kind name and the payload. A semantic op keeps its operator.
function lifted_binary_holds_no_name(): boolean {
  let add = ssa.binary_inst(2, [0, 1], 64, ir.K_ADD);
  let named = ssa.lifted_inst(ssa.BINARY, 3, [0, 1], 64, "eq");
  let semantic = ssa.lifted_inst(ssa.BINARY, 4, [0, 1], 0, "+");
  let lane = ssa.SInst { ir_kind: ir.K_VREPLACE, kind_tag: ssa.BINARY, result: 5, args: [0, 1], imm: 0, str: ":3" };
  let f = ssa.SFunc { name: "f", nparams: 0, nvals: 6, blocks: [ssa.SBlock { id: 0, preds: [], insts: [add, named, semantic, lane], term: ssa.t_ret(2) }], entry: 0, takes_env: false };
  let text = ssa.print_func(f);
  return add.str == "" && named.str == "" && named.ir_kind == ir.K_EQ && semantic.str == "+" && semantic.ir_kind == 0
    && util.index_of_sub(text, "v2 = binary add v0 v1") >= 0 && util.index_of_sub(text, "v3 = binary eq v0 v1") >= 0
    && util.index_of_sub(text, "v4 = binary + v0 v1") >= 0 && util.index_of_sub(text, "v5 = binary vreplace:3 v0 v1") >= 0;
}

function main(): i32 {
  let n = ssa.kind_count();

  let failures = 0;
  let ok = 0;
  let retired = 0;
  for id in 1..=n {
    let name = ssa.kind_name(id);
    let back = ssa.kind_id(name);
    if (ssa.kind_retired(id)) {
      if (name == "invalid") {
        retired += 1;
      } else {
        failures += 1;
      }
    } else if (name == "invalid" || back != id) {
      failures += 1;
    } else {
      ok += 1;
    }
  }

  let out = "";
  out = out + "kind_count=" + util.i32_to_string(n) + "\n";
  out = out + "bijection_ok=" + util.i32_to_string(ok) + "\n";
  out = out + "bijection_failures=" + util.i32_to_string(failures) + "\n";
  out = out + "retired=" + util.i32_to_string(retired) + "\n";

  out = out + "unknown_id=" + util.i32_to_string(ssa.kind_id("not_an_ssa_kind")) + "\n";
  out = out + "id0=" + ssa.kind_name(0) + "\n";
  out = out + "oob=" + ssa.kind_name(n + 1) + "\n";

  out = out + "const_int=" + util.i32_to_string(ssa.kind_id("const_int")) + "\n";
  out = out + "binary=" + util.i32_to_string(ssa.kind_id("binary")) + "\n";
  out = out + "phi=" + util.i32_to_string(ssa.kind_id("phi")) + "\n";
  out = out + "store_elem=" + util.i32_to_string(ssa.kind_id("store_elem")) + "\n";
  out = out + "write_file=" + util.i32_to_string(ssa.kind_id("write_file")) + "\n";
  out = out + "select=" + util.i32_to_string(ssa.kind_id("select")) + "\n";
  out = out + "carry=" + util.i32_to_string(ssa.kind_id("carry")) + "\n";

  for id in [ssa.BUF_NEW, ssa.BUF_PUSH, ssa.BUF_PUSH_RANGE, ssa.BUF_PUSH_BYTE, ssa.BUF_LEN, ssa.BUF_TAKE, ssa.BUF_FREE] {
    out += "buffer_kind=" + ssa.kind_name(id) + "\n";
  }
  out = out + "bound_kind=" + ssa.kind_name(ssa.BOUND) + "\n";

  let tn = ssa.term_count();
  let tfailures = 0;
  let tok = 0;
  for tid in 1..=tn {
    let tname = ssa.term_name(tid);
    let tback = ssa.term_id(tname);
    if (tname == "" || tback != tid) {
      tfailures += 1;
    } else {
      tok += 1;
    }
  }
  out = out + "term_count=" + util.i32_to_string(tn) + "\n";
  out = out + "term_bijection_ok=" + util.i32_to_string(tok) + "\n";
  out = out + "term_bijection_failures=" + util.i32_to_string(tfailures) + "\n";
  out = out + "term_none_id=" + util.i32_to_string(ssa.term_id("")) + "\n";
  let tnone = ssa.term_name(0);
  out = out + "term_none_name_len=" + util.i32_to_string(tnone.len()) + "\n";
  out = out + "ret=" + util.i32_to_string(ssa.term_id("ret")) + "\n";
  out = out + "brif=" + util.i32_to_string(ssa.term_id("brif")) + "\n";
  out = out + "unreachable=" + util.i32_to_string(ssa.term_id("unreachable")) + "\n";

  let semantic_count = ssa.semantic_kind_count();
  for sid in 1..semantic_count + 1 {
    out = out + "semantic" + util.i32_to_string(sid) + "=" + ssa.kind_name(-sid) + "\n";
  }
  out = out + "semantic_count=" + util.i32_to_string(semantic_count) + "\n";

  write(out);

  if (!rotate_operands_match()) {
    print("rotate operand mismatch");
    return 1;
  }
  if (!unary_loads_match()) {
    print("unary load kind mismatch");
    return 1;
  }
  if (!lifted_binary_holds_no_name()) {
    print("lifted binary op holds a name");
    return 1;
  }
  return failures + tfailures;
}
