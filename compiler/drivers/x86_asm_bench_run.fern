import "std/io";
import "../x86_native";

function main(): i32 {
  let av = args();
  let dump = false;
  let dump_eh = false;
  let i = 0;
  while (i < av.len()) {
    if (av[i] == "-bytes") {
      dump = true;
    }
    if (av[i] == "-ehframe") {
      dump_eh = true;
    }
    i += 1;
  }
  let src = "";
  match (io.read_all_stdin()) {
    Ok(text) => {
      src = text;
    },
    Err(_) => {
      eprint("x86 assembler: cannot read UTF-8 stdin");
      return 1;
    }
  }
  let a = x86_native.x86_gas_assemble(src);
  let code = x86_native.x86_code_len(a);
  print("text=" + code.to_string() + " rodata=" + a.rodata.len().to_string()
    + " ro=" + (a.text.len() - code).to_string()
    + " bump=" + __heap_bump_bytes().to_string() + "\n");
  if (a.unknown.len() > 0) {
    let u = 0;
    while (u < a.unknown.len()) {
      print("unknown=" + a.unknown[u]);
      u += 1;
    }
  }
  if (dump) {
    let b = 0;
    while (b < code) {
      print("byte " + b.to_string() + " " + (a.text[b] as i32).to_string());
      b += 1;
    }
  }
  if (dump_eh) {
    let eh = x86_native.x86_eh_frame(a, 4194304 as i64, 4194560 as i64);
    let e = 0;
    while (e < eh.len()) {
      print("eh " + e.to_string() + " " + eh[e].to_string());
      e += 1;
    }
    let hdr = x86_native.x86_eh_frame_hdr(a, 4194304 as i64, 4194560 as i64, 4194432 as i64);
    e = 0;
    while (e < hdr.len()) {
      print("hdr " + e.to_string() + " " + hdr[e].to_string());
      e += 1;
    }
    let dbg = x86_native.x86_debug_frame(a, 4194304 as i64);
    e = 0;
    while (e < dbg.len()) {
      print("dbg " + e.to_string() + " " + dbg[e].to_string());
      e += 1;
    }
  }
  return 0;
}
