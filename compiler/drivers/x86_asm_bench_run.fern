// compiler/x86_asm_bench_run.fern — harness for the in-process
// x86-64 assembler, the x86 twin of arm64_asm_bench_run.fern. Reads GAS
// (AT&T) text on stdin, runs the whole assemble path (parse/emit + label
// resolve) and prints the section sizes.
//
// With `-bytes` it also dumps each assembled .text byte, one per line,
// after the summary — making the assembler's ENCODINGS comparable against
// GNU as ground truth on identical input with no wasm pipeline and no
// execution (see internal/testing/e2ecompiler/self_host_x86_extops_gas_test.go).
// x86 instructions are variable-length, so the dump is a byte stream the
// test walks case by case rather than fixed words.
import "std/io";
import "../x86_native";

function main(): i32 {
  let av: string[] = args();
  let dump: boolean = false;
  let dump_eh: boolean = false;
  let i: i32 = 0;
  while (i < av.len()) {
    if (av[i] == "-bytes") {
      dump = true;
    }
    if (av[i] == "-ehframe") {
      dump_eh = true;
    }
    i = i + 1;
  }
  let src: string = "";
  match (io.read_all_stdin()) {
    Ok(text) => {
      src = text;
    },
    Err(_) => {
      eprint("x86 assembler: cannot read UTF-8 stdin");
      return 1;
    }
  }
  let a: x86_native.X86Asm = x86_native.x86_gas_assemble(src);
  print("text=" + a.text.len().to_string() + " rodata=" + a.rodata.len().to_string()
    + " bump=" + __heap_bump_bytes().to_string() + "\n");
  if (a.unknown.len() > 0) {
    let u: i32 = 0;
    while (u < a.unknown.len()) {
      print("unknown=" + a.unknown[u]);
      u = u + 1;
    }
  }
  if (dump) {
    let b: i32 = 0;
    while (b < a.text.len()) {
      print("byte " + b.to_string() + " " + (a.text[b] as i32).to_string());
      b = b + 1;
    }
  }
  // With `-ehframe`, the .eh_frame, .eh_frame_hdr and .debug_frame the
  // program's `.cfi_*` directives render, at the fixed addresses the differential renders the
  // native ones at: .text 0x400000, .eh_frame_hdr 0x400080, .eh_frame
  // 0x400100.
  if (dump_eh) {
    let eh: i32[] = x86_native.x86_eh_frame(a, 4194304 as i64, 4194560 as i64);
    let e: i32 = 0;
    while (e < eh.len()) {
      print("eh " + e.to_string() + " " + eh[e].to_string());
      e = e + 1;
    }
    let hdr: i32[] = x86_native.x86_eh_frame_hdr(a, 4194304 as i64, 4194560 as i64, 4194432 as i64);
    e = 0;
    while (e < hdr.len()) {
      print("hdr " + e.to_string() + " " + hdr[e].to_string());
      e = e + 1;
    }
    let dbg: i32[] = x86_native.x86_debug_frame(a, 4194304 as i64);
    e = 0;
    while (e < dbg.len()) {
      print("dbg " + e.to_string() + " " + dbg[e].to_string());
      e = e + 1;
    }
  }
  return 0;
}
