import "../lexer";
import "../parser";
import "../flatten";
import "../checker";
import "../modloader";

function main(): i32 {
  let a = args();
  if (a.len() < 2) {
    eprint("usage: checker_modload_run <entry.fern>");
    return 2;
  }
  let entry_path = a[1];
  match (read_file(entry_path)) {
    Ok(src) => {
      let entry = parser.parse_module(lexer.tokenize(src));
      let g = modloader.load_graph(modloader.no_overlay(), entry_path, entry, "");
      entry = g.entry;
      let loaded = g.loaded;
      let missing = g.missing;
      if (modloader.report_unresolved(missing, "checker_modload_run")) {
        return 2;
      }
      let merged = modloader.bundle(modloader.no_overlay(), entry_path, entry, loaded, "", "");
      let mt = checker.check_module(merged);
      for j in 0..mt.diags.len() {
        print(mt.diags[j].code + "\t" + mt.diags[j].message);
      }
      if (mt.diags.len() > 0) {
        return 1;
      }
      return 0;
    },
    Err(e) => {
      eprint("checker_modload_run: could not read entry file");
      return 1;
    }
  }
  return 3;
}
