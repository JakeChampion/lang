// compiler/checker_modload_run.fern — import-driven checker
// driver. The file-based successor to checker_codes_bundle_run.fern: where
// that reads a `///MODULE`-marked bundle off stdin, this takes an ENTRY
// file path on argv, resolves its imports off disk (the shared
// ./modloader), merges them with flatten.bundle, runs the self-hosted type
// checker over the merged module, and prints the diagnostic CODE of every
// diagnostic, one per line; an uncoded one (the const-grammar rule) prints as
// a tab and its message. Exits 1 when any diagnostic was emitted, else 0.
//
//     $ checker_modload_run path/to/main.fern
//
// Module resolution + builtin merging are shared with asm_modload_run via
// ./modloader, so this driver differs only in running check_module instead
// of emitting asm. Uses only features the self-hosted emitter supports
// (args, read_file → Result, match).

import "../lexer";
import "../parser";
import "../flatten";
import "../checker";
import "../modloader";

function main(): i32 {
  let a: string[] = args();
  if (a.len() < 2) {
    eprint("usage: checker_modload_run <entry.fern>");
    return 2;
  }
  let entry_path: string = a[1];
  match (read_file(entry_path)) {
    Ok(src) => {
      let entry: parser.Module = parser.parse_module(lexer.tokenize(src));
      let g: modloader.Graph = modloader.load_graph(modloader.no_overlay(), entry_path, entry, "");
      entry = g.entry;
      let loaded: flatten.LoadedModule[] = g.loaded;
      let missing: string[] = g.missing;
      if (modloader.report_unresolved(missing, "checker_modload_run")) {
        return 2;
      }
      let merged: parser.Module = flatten.bundle(entry, loaded, "");
      // NB: no merge_builtins here — the checker knows the built-in
      // types itself (is_builtin_variant / built-in enum table), and
      // injecting real JsonValue/IoError decls would be flagged as
      // E010 "reserved built-in name redeclared". (The asm driver
      // merges them because the EMITTER needs their field layout.)
      let mt: checker.ModuleTypes = checker.check_module(merged);
      let j: i32 = 0;
      while (j < mt.diags.len()) {
        if (mt.diags[j].code.len() > 0) {
          print(mt.diags[j].code);
        } else {
          print("\t" + mt.diags[j].message);
        }
        j = j + 1;
      }
      if (mt.diags.len() > 0) {
        return 1;
      }
      return 0;
    },
    Err(e) => {
      eprint("checker_modload_run: could not read entry file");
      return 1;
    }
  }
  return 3;
}
