// Mutation support only: preserve physical operand relationships while moving
// the first call's result close enough to i32 max to catch result+credit offsets.
import "../ssa";

function id(value: i32, size: i32, pivot: i32): i32 {
  if (value < 0 || value >= size) {
    return value;
  }
  let offset = if (value >= pivot) { value - pivot } else { value + size - pivot };
  return 2147483646 - offset * 17;
}

pub function rename(f: ssa.SFunc): ssa.SFunc {
  let pivot: i32 = -1;
  for b in f.blocks {
    for op in b.insts {
      if (pivot < 0 && op.kind_tag == 11) {
        pivot = op.result;
      }
    }
  }
  if (pivot < 0) {
    pivot = 0;
  }
  let blocks: ssa.SBlock[] = [];
  for b in f.blocks {
    let insts: ssa.SInst[] = [];
    for op in b.insts {
      let args: i32[] = [];
      for arg in op.args {
        args = args.append(id(arg, f.nvals, pivot));
      }
      insts = insts.append(ssa.SInst { ...op, result: id(op.result, f.nvals, pivot), args: args });
    }
    let term = b.term;
    if (term.kind_tag == 1) {
      term = ssa.STerm { ...term, value: id(term.value, f.nvals, pivot) };
    }
    if (term.kind_tag == 3) {
      term = ssa.STerm { ...term, cond: id(term.cond, f.nvals, pivot) };
    }
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts, term: term });
  }
  return ssa.SFunc { ...f, blocks: blocks, nvals: 2147483647 };
}

// Zero is a hole after rename, even though it remains within the value extent.
pub function hole(f: ssa.SFunc, mode: i32): ssa.SFunc {
  let blocks: ssa.SBlock[] = [];
  for b in f.blocks {
    let insts: ssa.SInst[] = [];
    for op in b.insts {
      let corrupt = mode == 0 && op.kind_tag == 11 || mode == 1 && op.kind_tag == 8;
      insts = insts.append(if (corrupt) { ssa.SInst { ...op, args: op.args.with(0, 0) } } else { op });
    }
    let term = if (mode == 2 && b.term.kind_tag == 1) { ssa.STerm { ...b.term, value: 0 } } else { b.term };
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts, term: term });
  }
  return ssa.SFunc { ...f, blocks: blocks };
}
