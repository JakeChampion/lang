import "../ssaboxroutines" as routines;
import "../ssadecrementtext" as text;
import "../ssafreelinks" as links;
import "std/string";

// Controls of the abstraction of the free list links in ssafreelinks: each
// decode and encode in the real output collapses, and a sequence that is not
// the decode or the encode of one block, or whose flags a later line reads,
// stays as it is, so the model refuses it.

function require(ok: boolean, group: string): void {
  if (!ok) {
    eprint("free link controls failed: " + group);
    exit(180);
  }
}

function change(s: string, from: string, to: string): string {
  require(s.contains(from), "mutation present " + from);
  return s.split(from).join(to);
}

pub function run(output: string): void {
  let plain = links.plain_text(output);
  require(output.contains("xorq __fern_link_key(%rip), %rdx") && !plain.contains("xorq __fern_link_key(%rip)"), "each decode and encode collapses");
  require(links.plain_text(plain) == plain, "the collapse is idempotent");
  require(routines.allocation(output) && routines.release(output), "the routines pass through the collapse");
  // The key of another block.
  require(!routines.allocation(change(output, "xorq (%rax), %rdx", "xorq (%rcx), %rdx")), "a decode with the key of another block");
  // A line between the decode and the store of its link.
  require(!routines.allocation(change(output, ".Lrecbox_link:\n", ".Lrecbox_link:\n    addq $8, %rdx\n")), "a decode changed before its store");
  // A line that reads the flags that the decode wrote.
  require(!routines.allocation(change(output, ".Lrecbox_link:\n    movq %rdx, (%rcx)\n    popq %rdx\n", ".Lrecbox_link:\n    movq %rdx, (%rcx)\n    popq %rdx\n    jb .Lrecbox_hdr\n")), "a read of the flags of a decode");
  // An encode whose link is not stored into its block.
  require(!routines.release(change(output, "xorq %r9, %rdi\n    popq %r9\n    movq %rdi, (%rdx)", "xorq %r9, %rdi\n    popq %r9\n    movq %rdi, 8(%rdx)")), "an encode stored elsewhere");
  require(!routines.release(change(output, "movq %rdx, %r9\n    shrq $12, %r9", "movq %rax, %r9\n    shrq $12, %r9")), "an encode with the key of another block");
}

function same(a: text.Body, b: text.Body, entry: string): void {
  require(a.error == "" && b.error == "" && a.lines.join("\n") == b.lines.join("\n") && a.register_entry == b.register_entry && a.unguarded_entry == b.unguarded_entry, "the models read " + entry + " alike in the real and the plain text");
}

// The models read each routine of the runtime alike in the real output and
// in its plain text, so a control on the plain text holds for the real output.
pub function same_routines(output: string): void {
  let plain = links.plain_text(output);
  for entry in ["__fn___fern_arr_dec", "__fn___fern_str_free"] {
    same(text.select(output, entry), text.select(plain, entry), entry);
  }
  for entry in ["__fern_capw", "__fern_large_push"] {
    same(text.dependency(output, entry), text.dependency(plain, entry), entry);
  }
  for entry in ["__fern_alloc", "__fern_arr_box", "__fern_rec_box", "__fn___fern_box_dec"] {
    same(text.box_routine(output, entry), text.box_routine(plain, entry), entry);
  }
}
