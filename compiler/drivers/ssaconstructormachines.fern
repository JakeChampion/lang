import "../asmcore";
import "../asm_ir";
import "../lexer";
import "../parser";
import "../semlower";
import "../ssaprepare";
import "../ssaconstructormachine" as machine;
import "../ssaconstructorbound" as boundary;
import "../ssacredittext" as retained;
import "../ssainlineuniqueisa" as registers;
import "./ssaallocationchains" as chains;
import "./ssasmallheaps" as heaps;
import "./ssaboxroutinecontrols" as routines;
import "../util";
import "std/string";

function require(ok: boolean, group: string): void {
  if (!ok) {
    eprint("constructor machine controls failed: " + group);
    exit(180);
  }
}

function change(s: string, from: string, to: string): string {
  require(s.contains(from), "mutation present " + from);
  return s.split(from).join(to);
}

function emit(single: boolean, runtime: boolean): ssaprepare.Output {
  let record = if (single) { "struct Parent { only: i32 } @noinline function parent(value: i32): Parent { return Parent { only: value }; }" } else { "struct Parent { left: i32, right: i32 } @noinline function parent(left: i32, right: i32): Parent { return Parent { left: left, right: right }; }" };
  let m = parser.parse_module(lexer.tokenize(record + " function main(): i32 { return 0; }"));
  require(!asmcore.refuse_parse_errors([m]), "parsed");
  let g = semlower.program(semlower.driven(m, "x86-64-linux"));
  let sw = asmcore.Switches { backtrace: false, sanitize: false, sandbox: false, cover: false, symbols: false, optimize: false, leak_check: false, rc_free_debug: false, var_rows: false, shared: false, size: false, harden: false, heap_limit: 0i64, quarantine: asmcore.quarantine_default(), cpu_limit: 0i64, pie: false, profile: "", target: "", line_maps: [], ram_base: 0i64, ram_size: 0i64, interrupts: [], early: "", secondary: "", user_mode: false };
  return asm_ir.emit_module_ir_unit_prepared(g.im, runtime, false, "", [], g.im.funcs, g.stab, 0, -1, g.cache, g.physical, semlower.runtime_module_lowering, 0 as usize, sw, true);
}

// The line of the constructor that calls the routine of its box.
function box_call(output: ssaprepare.Output): string {
  for raw in output.text.split("\n") {
    let line = raw.trim();
    if (line.starts_with("call __fern_rec_box")) {
      return line;
    }
  }
  return "";
}

function coherent(output: ssaprepare.Output, from: string, to: string): ssaprepare.Output {
  let bound = retained.resolve(output, "parent");
  require(bound.error == "", "base binding");
  let row = bound.rows[0];
  let assembly = change(row.assembly, from, to);
  return ssaprepare.Output { text: change(output.text, row.assembly, assembly), bodies: [ssaprepare.Emitted { ...row, assembly: assembly }] };
}

function altered(output: ssaprepare.Output, from: string, to: string, expected: boolean): void {
  require(machine.check(coherent(output, from, to), "parent") == expected, from + " -> " + to);
}

function boundary_only(output: ssaprepare.Output, capacity: string): void {
  let froms = [box_call(output), field_store(output.text, "0")];
  let tos = ["unknown_instruction", ""];
  let i = 0;
  for from in froms {
    let changed = coherent(output, from, tos[i]);
    require(boundary.resolve(changed, "parent").error == "", "boundary remains data");
    require(!machine.check(changed, "parent"), "machine rejects boundary-only positive");
    i += 1;
  }
}

// The store of the field at offset `at` of the box of `parent`.
function field_store(text: string, at: string): string {
  for raw in text.split("\n") {
    let line = raw.trim();
    if (line.starts_with("movq %") && line.ends_with(", " + at + "(%rax)")) {
      return line;
    }
  }
  return "";
}

// The register that a field store reads.
function stored_reg(store: string): string {
  return slice_unchecked(store, 5, util.index_of_sub(store, ",")).to_owned();
}

// The low 32 bits of a 64-bit register.
function low_half(reg: string): string {
  if (reg.len() == 4 && reg[1] == b'r' && reg[2] >= b'0' && reg[2] <= b'9') {
    return reg + "d";
  }
  if (reg.len() == 4 && reg[1] == b'r') {
    return "%e" + slice_unchecked(reg, 2, 4).to_owned();
  }
  return reg + "d";
}

// The store of the shape tag in the header of the box of `parent`.
function tag_store(text: string): string {
  for raw in text.split("\n") {
    let line = raw.trim();
    if (line.starts_with("movl $") && line.ends_with(", -4(%rax)")) {
      return line;
    }
  }
  return "";
}

function stores(output: ssaprepare.Output, single: boolean): void {
  let tag = tag_store(output.text);
  let value = slice_unchecked(tag, 5, tag.len() - 10).to_owned();
  let first = field_store(output.text, "0");
  let left = stored_reg(first);
  let stores = [tag, first];
  if (!single) {
    stores = stores.append(field_store(output.text, "8"));
  }
  for store in stores {
    altered(output, store, "", false);
    altered(output, store, store + "\n" + store, false);
  }
  for to in ["movl " + value + ", 0(%rax)", "movl " + value + ", -8(%rax)", "movq " + value + ", -4(%rax)", "movl %eax, -4(%rax)", "movl " + value + ", 4(%rax)"] {
    altered(output, tag, to, false);
  }
  for to in ["movq %rax, 0(%rax)", "movl " + low_half(left) + ", 0(%rax)", "movq " + left + ", 4(%rax)", "movq " + left + ", 16(%rax)"] {
    altered(output, first, to, false);
  }
  altered(output, tag, tag + "\nmovl -4(%rax), %esi", true);
  altered(output, tag, tag + "\nmovq 0(%rax), %rbx", false);
  altered(output, first, "movq 0(%rax), " + left + "\n" + first, false);
  altered(output, first, first + "\nmovq 0(%rax), " + left, true);
  if (!single) {
    let second = field_store(output.text, "8");
    altered(output, first, "movq " + stored_reg(second) + ", 0(%rax)", false);
    altered(output, second, "movq " + left + ", 8(%rax)", false);
  }
}

function frame(output: ssaprepare.Output, single: boolean): void {
  for from in ["pushq %rcx", "leaq 8(%rsp), %rsp"] {
    altered(output, from, "", false);
  }
  altered(output, "leaq 8(%rsp), %rsp", "addq $8, %rsp", true);
  altered(output, "leaq 8(%rsp), %rsp", "popq %rcx", true);
  altered(output, "leaq 8(%rsp), %rsp", "leaq 16(%rsp), %rsp", false);
  for to in ["movq $0, (%rsp)\nret", "movq $0, 8(%rsp)\nret", "movq -64(%rsp), %rbx\nret", "ret $8", "unknown_instruction\nret"] {
    altered(output, "ret\n", to + "\n", false);
  }
  altered(output, box_call(output), box_call(output) + "\nmovq -24(%rsp), %rbx", false);
  let left = stored_reg(field_store(output.text, "0"));
  altered(output, "movq %rax, " + left, "movl %eax, " + low_half(left), false);
  altered(output, "movq 8(%rsp), %rax", "movq 16(%rsp), %rax", false);
  if (!single) {
    altered(output, "movq 16(%rsp), %rsi", "movq 8(%rsp), %rsi", false);
  }
}

function identities(output: ssaprepare.Output): void {
  let wide = registers.registers(false, 64);
  let narrow = registers.registers(false, 32);
  let i = 0;
  for reg in wide {
    altered(output, "ret\n", "movq " + reg + ", " + reg + "\nret\n", true);
    altered(output, "ret\n", "movl " + narrow[i] + ", " + narrow[i] + "\nret\n", util.index_of_i32([1, 2, 6, 7, 8, 9, 10, 11], i) >= 0);
    i += 1;
  }
}

function dependency_frame(output: ssaprepare.Output): void {
  altered(output, box_call(output), "subq $8, %rsp\n" + box_call(output) + "\naddq $8, %rsp", true);
  altered(output, box_call(output), "subq $8, %rsp\n" + box_call(output) + "\nmovq -16(%rsp), %rdi\naddq $8, %rsp", false);
  altered(output, box_call(output), "subq $40, %rsp\n" + box_call(output) + "\naddq $40, %rsp", false);
  altered(output, box_call(output), "movq %rbx, -32(%rsp)\n" + box_call(output) + "\nmovq -32(%rsp), %rbx", false);
  altered(output, box_call(output), box_call(output) + "\nmovq %rbx, -32(%rsp)\nmovq -32(%rsp), %rbx", true);
  altered(output, box_call(output), box_call(output) + "\nmovq -16(%rsp), %rdi", false);
  altered(output, box_call(output), box_call(output) + "\nmovq -8(%rsp), %rbx", false);
  altered(output, box_call(output), box_call(output) + "\nmovq -16(%rsp), %rbx", false);
  require(machine.check(ssaprepare.Output { ...output, text: change(output.text, "__fern_alloc:", "__unproved_allocator:") }, "parent"), "allocator contract is conditional");
  require(!machine.check(ssaprepare.Output { ...output, text: output.text + "\n.text\n__fern_rec_box:\nret\n" }, "parent"), "duplicate helper");
  let row = retained.resolve(output, "parent").rows[0];
  let allocation = ssaprepare.Allocation { ...row.allocation, saved: [], frame_bytes: 2147483647, save_bytes: -1, framed: !row.allocation.framed };
  require(machine.check(ssaprepare.Output { ...output, bodies: [ssaprepare.Emitted { ...row, allocation: allocation }] }, "parent"), "derive frame without emitter metadata");
  require(machine.check(ssaprepare.Output { ...output, text: change(output.text, "\n", "\r\n") }, "parent"), "CRLF");
}

// The general routine takes the number of words in %rdi. A call of it with
// that number still makes the box, and a call with another number does not.
function general(output: ssaprepare.Output, capacity: string): void {
  altered(output, box_call(output), "movq $" + capacity + ", %rdi\ncall __fern_rec_box", true);
  altered(output, box_call(output), "movl $" + capacity + ", %edi\ncall __fern_rec_box", true);
  for n in ["0", "3", "4", "-1"] {
    altered(output, box_call(output), "movq $" + n + ", %rdi\ncall __fern_rec_box", false);
  }
  altered(output, box_call(output), "call __fern_rec_box", false);
  altered(output, box_call(output), box_call(output) + "\nmovq %rdi, 0(%rax)", false);
}

function control(output: ssaprepare.Output, capacity: string): void {
  for to in ["", box_call(output) + "\n" + box_call(output), "call __fern_alloc", "call absent"] {
    altered(output, box_call(output), to, false);
  }
  for n in ["0", "3", "4", "256"] {
    altered(output, box_call(output), "call __fern_rec_box_" + n, false);
  }
  general(output, capacity);
  altered(output, box_call(output), "jmp .Lmachine_forward\n.Lmachine_forward:\n" + box_call(output), true);
  altered(output, box_call(output), ".Lmachine_cycle:\njmp .Lmachine_cycle\n" + box_call(output), false);
  altered(output, box_call(output), "jne .Lmachine_forward\n.Lmachine_forward:\n" + box_call(output), false);
  altered(output, box_call(output), "jmp absent\n" + box_call(output), false);
  require(!machine.check(ssaprepare.Output { ...output, text: change(output.text, "__fern_rec_box:", "__fern_missing_box:") }, "parent"), "missing same-output helper");
  let routine = slice_unchecked(box_call(output), 5, box_call(output).len()).to_owned();
  require(!machine.check(ssaprepare.Output { ...output, text: change(output.text, routine + ":", "__fern_missing_box:") }, "parent"), "missing routine of the size");
  for line in ["movl $" + capacity + ", 4(%rax)", "jmp __fern_rec_box\n", "leaq " + util.i32_to_string(8 * (util.digits_to_i32(capacity) + 1)) + "(%rax), %rdi"] {
    require(!machine.check(ssaprepare.Output { ...output, text: change(output.text, line, "nop\n") }, "parent"), "routine of the size changed: " + line);
  }
  require(!machine.check(ssaprepare.Output { ...output, text: change(output.text, "leaq 24(,%rdi,8), %rdi", "leaq 16(,%rdi,8), %rdi") }, "parent"), "wrong helper request");
  altered(output, tag_store(output.text), tag_store(output.text) + "\nmovl $2, -4(%rax)", false);
  require(!machine.check(ssaprepare.Output { ...output, bodies: [] }, "parent"), "missing retained graph");
}

pub function run(): void {
  for single in [true, false] {
    let output = emit(single, true);
    require(machine.check(output, "parent"), "actual complete constructor");
    chains.run(output);
    heaps.run(output);
    routines.run(output);
    let capacity = if (single) { "1" } else { "2" };
    boundary_only(output, capacity);
    stores(output, single);
    frame(output, single);
    identities(output);
    dependency_frame(output);
    control(output, capacity);
    let missing = emit(single, false);
    require(boundary.resolve(missing, "parent").error == "" && !machine.check(missing, "parent"), "unit without runtime remains boundary-only");
  }
}
