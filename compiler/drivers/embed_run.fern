import "../ast";
import "../embed";
import "../lexer";
import "../parser";
import "../util";

function tree(): string {
  let dir: string = "";
  match (temp_dir("fern-embed-run")) {
    Ok(d) => {
      dir = d;
    },
    Err(e) => {
      return "";
    }
  }
  match (create_dir_all(dir + "/sub")) {
    Ok(u) => {},
    Err(e) => {
      return "";
    }
  }
  match (write_file(dir + "/z.txt", "ZZZ")) {
    Ok(u) => {},
    Err(e) => {
      return "";
    }
  }
  match (write_file(dir + "/a.txt", "AAA")) {
    Ok(u) => {},
    Err(e) => {
      return "";
    }
  }
  match (write_file(dir + "/sub/b.txt", "BB")) {
    Ok(u) => {},
    Err(e) => {
      return "";
    }
  }
  match (write_file_bytes(dir + "/blob.bin", blob())) {
    Ok(u) => {},
    Err(e) => {
      return "";
    }
  }
  return dir;
}

function blob(): u8[] {
  return [65u8, 0u8, 66u8, 255u8, 67u8];
}

function bytes_are(bs: u8[], want: u8[]): boolean {
  if (bs.len() != want.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < bs.len()) {
    if (bs[i] != want[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function bytes_of(e: ast.Expr): string {
  let out: string = "";
  match (e) {
    ast.ExprBytes(bs) => {
      for b in bs.value {
        if (out.len() > 0) {
          out = out + ",";
        }
        out = out + util.i32_to_string(b as i32);
      }
    },
    _ => {}
  }
  return out;
}

function var_init_of(mod: parser.Module): ast.Expr {
  for fd in mod.funcs {
    if (fd.name != "main") {
      continue;
    }
    for st in fd.body {
      match (st) {
        ast.StmtVar(v) => {
          return v.init;
        },
        _ => {}
      }
    }
  }
  return ast.ExprUnknown { kind: "none", line: 0, col: 0 };
}

function folded_init(src: string, a: embed.Assets): (ast.Expr, string[]) {
  let mod: parser.Module = parser.parse_module(lexer.tokenize(src));
  let folded: embed.Folded = embed.fold_assets(mod, a);
  let msgs: string[] = [];
  for d in folded.errs {
    msgs = msgs.append(d.code + " " + util.i32_to_string(d.line) + ":" + util.i32_to_string(d.col) + ": " + d.message);
  }
  return (var_init_of(folded.module), msgs);
}

function str_of(e: ast.Expr): string {
  match (e) {
    ast.ExprString(s) => {
      return s.value;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function main(): i32 {
  let dir: string = tree();
  if (dir.len() == 0) {
    return 10;
  }
  let lr: embed.LoadResult = embed.load(dir);
  if (lr.err.len() != 0) {
    return 11;
  }
  let a: embed.Assets = lr.assets;
  if (!a.present) {
    return 12;
  }
  if (a.root != dir) {
    return 13;
  }

  if (a.names.len() != 4) {
    return 14;
  }
  if (a.names[0] != "a.txt") {
    return 15;
  }
  if (a.names[1] != "blob.bin") {
    return 16;
  }
  if (a.names[2] != "sub/b.txt") {
    return 17;
  }
  if (a.names[3] != "z.txt") {
    return 18;
  }
  if (!bytes_are(a.contents[0], "AAA".bytes())) {
    return 19;
  }
  if (!bytes_are(a.contents[2], "BB".bytes())) {
    return 20;
  }
  if (!bytes_are(a.contents[3], "ZZZ".bytes())) {
    return 21;
  }

  if (!bytes_are(a.contents[1], blob())) {
    return 22;
  }

  if (embed.lookup(a, "sub/b.txt") != 2) {
    return 25;
  }
  if (embed.lookup(a, "nope") != -1) {
    return 26;
  }

  if (embed.load(dir + "/not-here").err.len() == 0) {
    return 27;
  }

  let empty_dir: string = dir + "/empty";
  match (create_dir_all(empty_dir)) {
    Ok(u) => {},
    Err(e) => {
      return 28;
    }
  }
  let er: embed.LoadResult = embed.load(empty_dir);
  if (er.err.len() != 0) {
    return 29;
  }
  if (!er.assets.present) {
    return 30;
  }
  if (er.assets.names.len() != 0) {
    return 31;
  }
  if (embed.format_available(er.assets) != "no assets were embedded") {
    return 32;
  }

  if (embed.format_available(a) != "embedded assets: a.txt, blob.bin, sub/b.txt, z.txt") {
    return 33;
  }
  if (embed.suggest(a, "sub/b.tx") != "sub/b.txt") {
    return 34;
  }
  if (embed.suggest(a, "totally-unrelated-xyzzy") != "") {
    return 35;
  }
  if (embed.suggest(a, "a.txt") != "a.txt") {
    return 36;
  }

  let one: string = "function main(): i32 { let s: string = __fern_asset(\"a.txt\"); return s.len(); }\n";
  let (e1, err1) = folded_init(one, a);
  if (err1.len() != 0) {
    return 40;
  }
  if (str_of(e1) != "AAA") {
    return 41;
  }

  let nested: string = "function main(): i32 { let s: string = __fern_asset(\"a.txt\") + __fern_asset(\"sub/b.txt\"); return s.len(); }\n";
  let (e2, err2) = folded_init(nested, a);
  if (err2.len() != 0) {
    return 42;
  }
  match (e2) {
    ast.ExprBinary(b) => {
      if (str_of(b.left) != "AAA") {
        return 43;
      }
      if (str_of(b.right) != "BB") {
        return 44;
      }
    },
    _ => {
      return 45;
    }
  }

  let (e3, err3) = folded_init(one, embed.no_assets());
  if (err3.len() != 1) {
    return 50;
  }
  if (!util.str_has_prefix(err3[0], "E094 1:") || !util.contains(err3[0], "no assets were embedded")) {
    return 51;
  }

  let missing: string = "function main(): i32 { let s: string = __fern_asset(\"a.tx\"); return 0; }\n";
  let (e4, err4) = folded_init(missing, a);
  if (err4.len() != 1) {
    return 52;
  }
  if (!util.contains(err4[0], "did you mean \"a.txt\"?")) {
    return 53;
  }

  let far: string = "function main(): i32 { let s: string = __fern_asset(\"totally-unrelated-xyzzy\"); return 0; }\n";
  let (e5, err5) = folded_init(far, a);
  if (err5.len() != 1) {
    return 54;
  }
  if (!util.contains(err5[0], "embedded assets: a.txt")) {
    return 55;
  }
  if (util.contains(err5[0], "did you mean")) {
    return 56;
  }

  let arity: string = "function main(): i32 { let s: string = __fern_asset(\"a.txt\", \"b\"); return 0; }\n";
  let (e6, err6) = folded_init(arity, a);
  if (err6.len() != 1) {
    return 57;
  }
  if (!util.contains(err6[0], "takes exactly one argument, got 2")) {
    return 58;
  }

  let computed: string = "function main(): i32 { let n: string = \"a.txt\"; let s: string = __fern_asset(n); return 0; }\n";
  let (e7, err7) = folded_init(computed, a);
  if (err7.len() != 1) {
    return 59;
  }
  if (!util.contains(err7[0], "the name cannot be computed")) {
    return 60;
  }

  let inner: string = "function main(): i32 { let s: string = __fern_asset(__fern_asset(\"a.txt\")); return 0; }\n";
  let (e13, err13) = folded_init(inner, a);
  if (err13.len() != 1) {
    return 62;
  }
  if (!util.contains(err13[0], "the name cannot be computed")) {
    return 63;
  }

  let two_bad: string = "function main(): i32 { let s: string = __fern_asset(\"nope1\") + __fern_asset(\"nope2\"); return 0; }\n";
  let (e8, err8) = folded_init(two_bad, a);
  if (err8.len() != 2) {
    return 61;
  }

  let text_of_blob: string = "function main(): i32 { let s: string = __fern_asset(\"blob.bin\"); return 0; }\n";
  let (e14, err14) = folded_init(text_of_blob, a);
  if (err14.len() != 1) {
    return 64;
  }
  if (!util.contains(err14[0], "\"blob.bin\"") || !util.contains(err14[0], "is not valid UTF-8")) {
    return 65;
  }

  let bytes_one: string = "function main(): i32 { let b: u8[] = __fern_asset_bytes(\"blob.bin\"); return 0; }\n";
  let (e15, err15) = folded_init(bytes_one, a);
  if (err15.len() != 0) {
    return 66;
  }
  if (bytes_of(e15) != "65,0,66,255,67") {
    return 67;
  }
  let bytes_text: string = "function main(): i32 { let b: u8[] = __fern_asset_bytes(\"sub/b.txt\"); return 0; }\n";
  let (e16, err16) = folded_init(bytes_text, a);
  if (err16.len() != 0 || bytes_of(e16) != "66,66") {
    return 68;
  }
  let bytes_arity: string = "function main(): i32 { let b: u8[] = __fern_asset_bytes(); return 0; }\n";
  let (e17, err17) = folded_init(bytes_arity, a);
  if (err17.len() != 1 || !util.contains(err17[0], "__fern_asset_bytes takes exactly one argument, got 0")) {
    return 69;
  }

  let all: string = "function main(): i32 { let xs = __fern_assets(); return xs.len(); }\n";
  let (e18, err18) = folded_init(all, a);
  if (err18.len() != 1 || !util.contains(err18[0], "\"blob.bin\"")) {
    return 86;
  }
  let all_bytes: string = "function main(): i32 { let xs = __fern_assets_bytes(); return xs.len(); }\n";
  let (e9, err9) = folded_init(all_bytes, a);
  if (err9.len() != 0) {
    return 70;
  }
  match (e9) {
    ast.ExprArray(arr) => {
      if (arr.elem_ty != "(string, u8[])") {
        return 71;
      }
      if (arr.elements.len() != 4) {
        return 72;
      }
      match (arr.elements[2]) {
        ast.ExprTuple(t) => {
          if (t.elements.len() != 2) {
            return 73;
          }
          if (str_of(t.elements[0]) != "sub/b.txt") {
            return 74;
          }
          if (bytes_of(t.elements[1]) != "66,66") {
            return 75;
          }
        },
        _ => {
          return 76;
        }
      }
    },
    _ => {
      return 77;
    }
  }

  let text_lr: embed.LoadResult = embed.load(dir + "/sub");
  let (e19, err19) = folded_init(all, text_lr.assets);
  if (text_lr.err.len() != 0 || err19.len() != 0) {
    return 87;
  }
  match (e19) {
    ast.ExprArray(arr3) => {
      if (arr3.elem_ty != "(string, string)" || arr3.elements.len() != 1) {
        return 88;
      }
    },
    _ => {
      return 89;
    }
  }

  let (e10, err10) = folded_init(all, er.assets);
  if (err10.len() != 0) {
    return 78;
  }
  match (e10) {
    ast.ExprArray(arr2) => {
      if (arr2.elements.len() != 0) {
        return 79;
      }
      if (arr2.elem_ty != "(string, string)") {
        return 80;
      }
    },
    _ => {
      return 81;
    }
  }

  let (e11, err11) = folded_init(all, embed.no_assets());
  if (err11.len() != 1) {
    return 82;
  }
  if (!util.contains(err11[0], "no assets were embedded")) {
    return 83;
  }

  let all_arity: string = "function main(): i32 { let xs = __fern_assets(\"a.txt\"); return 0; }\n";
  let (e12, err12) = folded_init(all_arity, a);
  if (err12.len() != 1) {
    return 84;
  }
  if (!util.contains(err12[0], "takes no arguments, got 1")) {
    return 85;
  }

  match (remove_dir_all(dir)) {
    Ok(u) => {},
    Err(e) => {}
  }
  write("embed: bundle and substitution agree\n");
  return 0;
}
