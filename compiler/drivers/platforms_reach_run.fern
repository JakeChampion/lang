// compiler/platforms_reach_run.fern — import-driven driver for the
// DERIVED host-capability reach of a program (platforms.reach, #6633 item 3).
//
//     $ platforms_reach_run path/to/main.fern
//     fs
//     stdin
//
// One capability per line, sorted; no output at all for a program that
// touches no host. Exit 0 unless the entry file cannot be read.
//
// Same modload shape as checker_modload_run: resolve the entry's imports off
// disk, merge with flatten.bundle, scan the merged module. Two differences,
// both deliberate:
//
//   - **No tree-shake.** Enforcement asks "may this target build this
//     artifact?", so it runs on the shaken module. Reach asks "what can this
//     CODE touch?", which is a property of the module rather than of one
//     program that imports it — shaking first would answer for the entry's
//     call graph and classify every unused module as core-safe.
//   - **No target.** A capability is either reached or not; which targets
//     grant it is the enforcement half's question.
//
// The Go-side gate (internal/testing/e2ecompiler/self_host_std_partition_test.go)
// runs this over every `std/` module and requires the same answer as native's
// platforms.Reach over the same module — the partition in
// internal/pkg/platforms/std_partition_test.go, derived twice.

import "../lexer";
import "../parser";
import "../flatten";
import "../modloader";
import "../platforms";

function main(): i32 {
  let a: string[] = args();
  if (a.len() < 2) {
    eprint("usage: platforms_reach_run <entry.fern>");
    return 2;
  }
  let entry_path: string = a[1];
  match (read_file(entry_path)) {
    Ok(src) => {
      let entry: parser.Module = parser.parse_module(lexer.tokenize(src));
      let g: modloader.Graph = modloader.load_graph(modloader.no_overlay(), entry_path, entry, "");
      entry = g.entry;
      let loaded: flatten.LoadedModule[] = g.loaded;
      let missing: string[] = g.missing;
      if (modloader.report_unresolved(missing, "platforms_reach_run")) {
        return 1;
      }
      let merged: parser.Module = flatten.bundle(entry, loaded, "");
      let caps: string[] = platforms.reach(merged);
      let i: i32 = 0;
      while (i < caps.len()) {
        print(caps[i]);
        i = i + 1;
      }
      return 0;
    },
    Err(e) => {
      eprint("platforms_reach_run: could not read entry file");
      return 1;
    }
  }
  return 3;
}
