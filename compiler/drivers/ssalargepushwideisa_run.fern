import "../asmcore";
import "../ssacapacityisa" as legacy;
import "../ssalargepushwideisa" as wide;
import "../ssainlineuniqueisa" as registers;
import "../ssadecrementtext" as text;
import "./ssaretainedprogram" as retained;
import "./ssalargepushwideisacases" as reference;
import "std/i64";
import "std/i32";

function require(ok: boolean, group: string): void {
  if (!ok) {
    print("wide large-push decoder controls failed: " + group);
    exit(180);
  }
}

function envelope(body: string): string {
  return ".text\n__fern_large_push:\n" + body + "\n__fern_capw:\nret\n";
}

function sample(line: string): wide.WideOp {
  let p = wide.large_program(envelope(line + "\nret"));
  require(p.error == "" && p.ops.len() == 2 && p.ops[1].instruction.kind == 18, "sample " + line);
  return p.ops[0];
}

function rejected(body: string): void {
  let p = wide.large_program(envelope(body));
  require(p.error != "" && p.ops.len() == 0, "rejected " + body);
}

function literals(): void {
  let values: i64[] = [-(9223372036854775807 as i64) - 1 as i64, -(9223372036854775807 as i64), -(34359738367 as i64), -(17179869184 as i64), -(4294967296 as i64), -(2147483648 as i64), -(1 as i64), 0 as i64, 1 as i64, 2147483647 as i64, 2147483648 as i64, 4294967295 as i64, 4294967296 as i64, 17179869184 as i64, 34359738367 as i64, 9223372036854775807 as i64];
  let regs = registers.registers(false, 64);
  for at in 0..regs.len() {
    for value in values {
      let op = sample("movabs $" + value.to_string() + ", " + regs[at]);
      require(op.instruction.kind == 41 && op.instruction.width == 64 && op.instruction.source == -1 && op.instruction.destination == at, "wide destination");
      require(op.immediate == value && op.instruction.immediate == 0, "exact signed wide literal");
    }
  }
  for spelling in ["", "-", "+1", "00", "01", "-0", "-01", "0x1", "0X1", "1_0", "1e0", "1.0", " 1", "9223372036854775808", "-9223372036854775809", "18446744073709551615", "symbol", "1+1"] {
    rejected("movabs $" + spelling + ", %rax\nret");
  }
  for operand in ["%eax", "%r8d", "%xmm0", "%rip", "%r16", "rax", "(%rax)"] {
    rejected("movabs $17179869184, " + operand + "\nret");
  }
}

function comparisons(): void {
  for width in [32, 64] {
    let regs = registers.registers(false, width);
    let name = if (width == 64) { "cmpq" } else { "cmpl" };
    for source in 0..regs.len() {
      for destination in 0..regs.len() {
        let op = sample(name + " " + regs[source] + ", " + regs[destination]);
        require(op.instruction.kind == 28 && op.instruction.width == width && op.instruction.source == source && op.instruction.destination == destination, "register comparison order");
        require(op.immediate == 0 as i64, "comparison immediate");
      }
    }
  }
  for line in ["cmpq %eax, %rsi", "cmpq %rax, %esi", "cmpl %rax, %esi", "cmpl %eax, %rsi", "cmpq (%rax), %rsi", "cmpq %rax, (%rsi)", "cmpb %al, %cl", "cmpq %rax", "cmpq %rax, %rsi, %rdx"] {
    rejected(line + "\nret");
  }
}

function boundaries(): void {
  rejected("movabs $1, %rax\nunknown_instruction\nret");
  rejected("unknown_instruction\nmovabs $1, %rax\nret");
  rejected("movabs $1, %rax\nja .Lmissing\nret");
  rejected("ja __fern_alloc_size_abort.c\nret");
  rejected("jmp __fern_large_push\nret");
  rejected(".Lduplicate:\nret\n.Lduplicate:\nret");
  rejected("movabs $1, %rax\ncall __fern_alloc\nret");
  rejected("movabsq $1, %rax\nret");
  let prefix = ".text\n__fern_large_push:\n";
  for output in [".set alias, __fern_large_push\n" + prefix + "ret\n", prefix + "ret\n.data\n__fern_large_push: .quad 0\n", prefix + "jmp .Loutside\n__other:\n.Loutside:\nret\n"] {
    let p = wide.large_program(output);
    require(p.error != "" && p.ops.len() == 0, "namespace isolation");
  }
  let cycle = wide.large_program(envelope(".Lcycle:\njmp .Lcycle"));
  require(cycle.error == "" && cycle.ops.len() == 2 && cycle.ops[0].instruction.kind == 1 && cycle.ops[1].instruction.target == 0, "cycles remain data");
  let empty = wide.large_program(prefix + "__next:\nret\n");
  require(empty.error == "" && empty.ops.len() == 0, "empty remains data");
}

function old_interfaces(): void {
  for line in ["movabs $17179869184, %rax", "cmpq %rax, %rsi"] {
    let p = legacy.large_program(envelope(line + "\nret"));
    require(p.error == "" && p.ops.len() == 2 && p.ops[0].kind == 0, "old instruction subset");
  }
  let old = legacy.large_program(envelope("cmpq $0x40000000, %rsi\nret"));
  let current = wide.large_program(envelope("cmpq $0x40000000, %rsi\nret"));
  require(old.error == "" && old.ops[0].kind == 16 && old.ops[0].immediate == 1073741824, "old i32 literal");
  require(current.error == "" && current.ops[0].instruction.kind == 16 && current.ops[0].immediate == 1073741824 as i64, "shared old literal decode");
  let old_bad = legacy.large_program(envelope("cmpq $2147483648, %rsi\nret"));
  require(old_bad.error == "" && old_bad.ops[0].kind == 0, "old literal bound unchanged");
}

function owned_results(): void {
  let input = envelope("movabs $17179869184, %rax\ncmpq %rax, %rsi\nret");
  let alias = input;
  let p = wide.large_program(input);
  require(p.error == "" && p.ops.len() == 3, "owned source");
  let changed = p.ops.with(0, wide.WideOp { ...p.ops[0], immediate: 0 as i64 });
  let q = wide.large_program(envelope("movabs $7, %r15\nret"));
  require(alias == input && changed[0].immediate == 0 as i64 && p.ops[0].immediate == 17179869184 as i64 && q.ops[0].immediate == 7 as i64, "owned result isolation");
  let spaced = sample("movabs\t$17179869184 ,\t%rax");
  require(spaced.immediate == 17179869184 as i64 && spaced.instruction.destination == 0, "operand whitespace");
}

function actual(): void {
  let mod = retained.module();
  require(!asmcore.refuse_parse_errors([mod]), "retained source parse");
  let g = retained.program(mod);
  let output = retained.emit(g, g.cache, g.physical, false, true, true, 0, -1).text;
  let body = text.dependency(output, "__fern_large_push");
  let p = wide.large_program(output);
  let kinds = [41, 28, 17, 2, 16, 17, 5, 1, 8, 9, 5, 13, 15, 12, 11, 8, 9, 2, 14, 20, 10, 9, 2, 19, 3, 4, 4, 1, 18];
  require(body.error == "" && p.error == "" && p.ops.len() == 29 && p.ops.len() == body.lines.len(), "actual emission coverage");
  for at in 0..p.ops.len() {
    let op = p.ops[at].instruction;
    require(op.kind == kinds[at], "actual instruction " + at.to_string());
    if (op.kind == 17) {
      require(op.target >= 0 && op.target < p.ops.len() && p.ops[op.target].instruction.kind == 1 && body.lines[at].ends_with(body.lines[op.target].split(":")[0]), "actual branch identity");
    }
  }
  require(p.ops[0].immediate == 17179869184 as i64 && p.ops[0].instruction.destination == 0, "actual full immediate");
  require(p.ops[1].instruction.width == 64 && p.ops[1].instruction.source == 0 && p.ops[1].instruction.destination == 6, "actual guard operands");
  require(p.ops[2].instruction.target == 27 && p.ops[5].instruction.target == 7, "actual guard targets");
  require(p.ops[23].instruction.symbol == "__fern_large_freelist" && p.ops[24].instruction.base == 2 && p.ops[24].instruction.index == 0 && p.ops[24].instruction.scale == 8 && p.ops[26].instruction.source == 8, "actual freelist operands");
}

function exact_op(actual: wide.WideOp, expected: reference.ExpectedOp): boolean {
  let op = actual.instruction;
  return op.kind == expected.kind && op.width == expected.width && op.source == expected.source && op.destination == expected.destination && op.base == expected.base && op.index == expected.index && op.scale == expected.scale && op.offset == expected.offset && op.immediate == expected.narrow_immediate && actual.immediate == expected.immediate && op.condition == expected.condition && op.target == expected.target && op.symbol == expected.symbol;
}

function reference_cases(): void {
  let rows = reference.rows();
  require(rows.len() == reference.count(), "complete independent reference count");
  for at in 0..rows.len() {
    let row = rows[at];
    require(row.id == at, "independent reference ordinal");
    let p = wide.large_program(row.source);
    require(p.error == "" == row.ok && p.ops.len() == row.ops.len(), "reference status or length " + at.to_string());
    for index in 0..p.ops.len() {
      require(exact_op(p.ops[index], row.ops[index]), "reference operation " + at.to_string() + "/" + index.to_string());
    }
  }
}

function main(): i32 {
  literals();
  comparisons();
  boundaries();
  old_interfaces();
  owned_results();
  actual();
  reference_cases();
  print("wide large-push decoder controls passed");
  return 0;
}
