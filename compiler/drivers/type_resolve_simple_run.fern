import "../checker";
import "../typeinfo";
import "../util";

function main(): i32 {
  let structs: checker.StructSig[] = [
    checker.StructSig { name: "Foo", field_names: [], field_types: [], type_params: [], field_type_names: [], variant_field_names: [], derives: [], enum_owner: "", opaque: false, module: "" },
    checker.StructSig { name: "Bar", field_names: [], field_types: [], type_params: [], field_type_names: [], variant_field_names: [], derives: [], enum_owner: "", opaque: false, module: "" },
  ];
  let snames: string[] = ["Foo", "Bar"];
  let unames: string[] = ["Shape"];
  let corpus: string[] = [
    "i32", "i64", "u32", "u64", "bool", "boolean", "string", "f64", "f32",
    "Foo", "Bar", "Shape", "Baz",
    "i32[]", "string[]", "Foo[]", "Shape[]", "i32[][]", "Foo[][]", "Bar[][][]",
    "(i32, string)", "Map[string, i32]", "Option[i32]", "Vec[T]",
    "(i32, string)[]", "Map[string, i32][]", "Bogus[]",
    "mod.Thing", "",
  ];
  let out: string = "";
  let i: i32 = 0;
  while (i < corpus.len()) {
    let n: string = corpus[i];
    let a: typeinfo.Type = checker.type_from_name_with_structs(n, structs);
    let b: typeinfo.Type = checker.type_from_name_with_struct_names(n, snames);
    let c: typeinfo.Type = checker.type_from_name_with_names_and_unions(n, snames, unames);
    out = out + n + " => structs=" + checker.type_debug(a)
      + " names=" + checker.type_debug(b)
      + " names+unions=" + checker.type_debug(c) + "\n";
    i = i + 1;
  }
  write(out);
  return 0;
}
