import "../ir";
import "../irverify";
import "../util";

pub function provided_names(): string[] {
  return [
    "__fern_oob_abort",
    "__fern_slice_abort",
    "__fern_rc_inc",
    "__fern_rc_dec",
    "__fern_rc_is_unique",
    "__fern_arr_inc_elems",
    "__fern_arr_own_elems",
    "__fern_str_own",
    "__fern_str_borrow",
    "__fern_str_grow",
    "__fern_str_grow_range",
    "__fern_str_grow_fresh",
    "__fern_str_grow_fresh_range",
    "__fern_task_new",
    "__fern_task_free",
    "__fern_task_cur",
    "__fern_task_enter",
    "__fern_task_leave",
    "__fern_task_park",
    "__fern_task_wait",
    "__fern_task_timeout",
    "__fern_task_set_ready",
    "__fern_task_set_cancelled",
    "__fern_task_cancelled",
    "__fern_task_mode",
    "__fern_task_reserve",
    "__fern_task_take",
    "__fern_task_pop_w",
    "__fern_rc_underflow_get",
    "__fern_account_entry",
    "__fern_arr_share_inc",
    "__fern_arr_share_dec",
    "__fern_str_free",
    "__fern_str_view_free",
    "__fern_str_arr_free",
    "__fern_alloc_reuse",
    "__fern_i32_to_string",
    "__fern_u32_to_string",
    "__fern_i64_to_string",
    "__fern_u64_to_string",
    "__fern_arr_str_join",
    "__fern_arr_concat",
    "__fern_bytes_owned",
    "__fern_bytes_range",
    "__fern_bytes_into",
    "__fern_bytes_append_range",
    "__fern_bytes_write_range",
    "__fern_bytes_append_back",
  ];
}

pub function is_generated_helper(name: string): boolean {
  if (name.len() > 11 && slice_unchecked(name, 0, 11) == "__sem_drop_") {
    return true;
  }
  return name.len() > 14 && slice_unchecked(name, 0, 14) == "__sem_release_";
}

pub function is_c_call_shim(name: string): boolean {
  if (name.len() < 9) {
    return false;
  }
  if (slice_unchecked(name, 0, 8) != "__c_call") {
    return false;
  }
  let d: str = slice_unchecked(name, 8, 9);
  if (d != "0" && d != "1" && d != "2" && d != "3" && d != "4") {
    return false;
  }
  let rest: str = slice_unchecked(name, 9, name.len());
  return rest == "" || rest == "_f32" || rest == "_f64";
}

pub function is_provided(name: string): boolean {
  if (is_generated_helper(name)) {
    return true;
  }
  if (is_c_call_shim(name)) {
    return true;
  }
  return util.has_str(provided_names(), name);
}

pub struct ProvidedResult { problems: irverify.Problem[], calls: i32 }

pub function verify_provided_fn(fn_name: string, ops: ir.Op[], declared: irverify.NameIndex): ProvidedResult {
  let out: irverify.Problem[] = [];
  let calls: i32 = 0;
  let k_calld: i32 = ir.kind_id("call_direct");
  let i: i32 = 0;
  while (i < ops.len()) {
    if (ops[i].kind_tag == k_calld && ops[i].str.len() > 0) {
      calls = calls + 1;
      if (!irverify.index_has(declared, ops[i].str) && !is_provided(ops[i].str)) {
        out = out.append(irverify.Problem {
          fn_name: fn_name, op: i, kind: "call_direct",
          msg: "calls " + ops[i].str
            + ", which the program does not declare and no backend provides",
        });
      }
    }
    i = i + 1;
  }
  return ProvidedResult { problems: out, calls: calls };
}
