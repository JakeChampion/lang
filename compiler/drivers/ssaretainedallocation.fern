import "../asmcore";
import "../asm_ir";
import "../asm_arm64_ir";
import "../ir";
import "../ircore";
import "../irtables";
import "../semlower";
import "../ssa";
import "../ssaprepare";
import "../util";
import "std/string";
import "./ssaretainedsites" as sites;
import "./ssaretainedinline" as inlineproof;
import "./ssauniquecaller" as callerproof;
import "./ssauniqueunit" as unitproof;
import "./ssauniquephi" as phiproof;
import "./ssauniquecollection" as collectionproof;
import "./ssaretainedalignment" as alignmentproof;
import "../lexer";
import "../parser";

function require(ok: boolean, code: i32): void {
  if (!ok) {
    exit(code);
  }
}

pub function consistent(row: ssaprepare.Emitted): void {
  let a = row.allocation;
  let f = row.body.formed.f;
  require(a.alloc.reg_of.len() == f.nvals && a.imm.is_imm.len() == f.nvals, 110);
  require(a.alloc.def_pos.len() == f.nvals && a.alloc.hi.len() == f.nvals, 111);
  require(a.fusions.len() == f.blocks.len(), 112);
  require(a.frame_bytes >= ssa.spill_count(a.alloc.reg_of) * 8 && (a.framed || a.frame_bytes == 0), 113);
  let arm = row.context.architecture == "arm64";
  require(a.save_bytes == (if (arm) { (a.saved.len() + 1) / 2 * 16 } else { a.saved.len() * 8 }), 114);
  require(!arm || a.framed == row.assembly.contains("    stp x29, x30, [sp, #-16]!\n"), 115);
  unfused(a.fusions);
  sites.consistent(row);
}

function unfused(fusions: ssaprepare.Fusion[]): void {
  for fu in fusions {
    if (fu.n == 0) {
      require(fu.tag == 0 && !fu.inverted && fu.a == 0 && fu.b == 0 && !fu.unique && !fu.aligned, 127);
    }
  }
}

function emit(g: ircore.Gated, r: irtables.LowerResult, arm: boolean, retain: boolean): ssaprepare.Output {
  let sw = asmcore.Switches { backtrace: false, sanitize: false, var_rows: false };
  let cache = g.cache.with(0, r);
  if (arm) {
    return asm_arm64_ir.emit_module_ir_unit_arm64_prepared(g.im, false, false, "", [], g.im.funcs, g.stab, 0, 1, cache, g.physical, semlower.runtime_lowering, sw, retain);
  }
  return asm_ir.emit_module_ir_unit_prepared(g.im, false, false, "", [], g.im.funcs, g.stab, 0, 1, cache, g.physical, semlower.runtime_lowering, 0 as usize, sw, retain);
}

function checked(g: ircore.Gated, r: irtables.LowerResult, arm: boolean): ssaprepare.Output {
  let off = emit(g, r, arm, false);
  let on = emit(g, r, arm, true);
  require(off.bodies.len() == 0 && on.bodies.len() == 1 && off.text == on.text, 116);
  consistent(on.bodies[0]);
  sites.output(on);
  require(!on.text.contains(".ssa_epilogue"), 117);
  let framed = on.bodies[0].allocation.framed;
  require(arm || framed == on.text.contains("movq %rsp, %rbp"), 118);
  return on;
}

function frame_matches(text: string, bytes: i32): boolean {
  return text.contains("    subq $" + util.i32_to_string(bytes) + ", %rsp\n");
}

function spill_frame(out: ssaprepare.Output, arm: boolean): void {
  if (arm) {
    return;
  }
  let a = out.bodies[0].allocation;
  let raw = ssa.spill_count(a.alloc.reg_of) * 8;
  let padded = (raw + a.save_bytes + 15) / 16 * 16 - a.save_bytes;
  require(a.frame_bytes == padded && frame_matches(out.text, a.frame_bytes), 128);
  require(!frame_matches(out.text, a.frame_bytes + 8) && !frame_matches(out.text, a.frame_bytes - 8), 129);
  if (raw != padded) {
    require(!frame_matches(out.text, raw), 130);
  }
}

function spills(g: ircore.Gated, arm: boolean, params: i32): void {
  let ops = [ir.op_load_local(0)];
  let i = 1;
  while (i < params) {
    ops = ops.append(ir.op_load_local(i)).append(ir.op_bin("add", 64, false));
    i = i + 1;
  }
  let r = irtables.LowerResult { ...g.cache[0], n_params: params, n_locals: params, ops: ops.append(ir.op_return()) };
  let out = checked(g, r, arm);
  spill_frame(out, arm);
  let a = out.bodies[0].allocation;
  require(a.framed && ssa.spill_count(a.alloc.reg_of) > 0 && a.saved.len() > 0, 119);
  for home in a.alloc.reg_of {
    if (home < -1) {
      let offset = 0 - 8 * (ssa.spill_slot(home) + 1) - a.save_bytes;
      let address = if (arm) { "[sp, #" + util.i32_to_string(a.frame_bytes + a.save_bytes + offset) + "]" } else { util.i32_to_string(offset) + "(%rbp)" };
      require(out.text.contains(address), 120);
    }
  }
}

function uniqueness(g: ircore.Gated, arm: boolean, fused: boolean, inverted: boolean, aligned: boolean): ssaprepare.Output {
  let call = ir.op_call_direct("__fern_rc_is_unique", 1);
  call = ir.Op { ...call, i64_imm: if (aligned) { 4i64 } else { 0i64 } };
  let ops = [ir.op_load_local(0), call];
  if (inverted) {
    ops = ops.append(ir.op_bin("not", 32, false));
  }
  if (fused) {
    ops = util.append_all(ops, [ir.op_if(0), ir.op_const_i32(7), ir.op_return(), ir.op_else(), ir.op_const_i32(9), ir.op_return(), ir.op_end()]);
  } else {
    ops = ops.append(ir.op_return());
  }
  let r = irtables.LowerResult { ...g.cache[0], n_params: 1, n_locals: 1, ops: ops };
  let out = checked(g, r, arm);
  fusion(out, fused, inverted, aligned);
  sites.unique(out.bodies[0], fused, inverted, aligned);
  inlineproof.run(out.bodies[0], true);
  callerproof.run(out.bodies[0], aligned);
  unitproof.run(out, aligned);
  return out;
}

function selected_uniqueness(arm: boolean): void {
  for parameter in ["i32[]", "string", "str"] {
    selected_parameter(arm, parameter);
  }
}

function selected_parameter(arm: boolean, parameter: string): void {
  // Keep actual selected type/mode metadata from this producer. Replace only
  // its physical body with the same controlled uniqueness cases used above.
  let mod = parser.parse_module(lexer.tokenize("function first(xs: " + parameter + "): i32 { return 0; } function main(): i32 { return 0; }"));
  let g = semlower.program(semlower.driven(mod, "x86-64-linux"));
  require(g.ok, 139);
  for fused in [false, true] {
    for inverted in [false, true] {
      let out = uniqueness(g, arm, fused, inverted, true);
      alignmentproof.run(out.bodies[0]);
      alignmentproof.final_output(out);
    }
  }
}

function phi_join(g: ircore.Gated, arm: boolean, inverted: boolean): void {
  let ops = [ir.op_load_local(0), ir.op_call_direct("__fern_rc_is_unique", 1)];
  if (inverted) {
    ops = ops.append(ir.op_bin("not", 32, false));
  }
  ops = util.append_all(ops, [ir.op_if(0), ir.op_const_i32(7), ir.op_store_local(1), ir.op_else(), ir.op_const_i32(9), ir.op_store_local(1), ir.op_end(), ir.op_load_local(1), ir.op_return()]);
  let r = irtables.LowerResult { ...g.cache[0], n_params: 1, n_locals: 2, ops: ops };
  phiproof.run(checked(g, r, arm));
}

function fusion(out: ssaprepare.Output, fused: boolean, inverted: boolean, aligned: boolean): void {
  let row = out.bodies[0];
  let count = 0;
  let bi = 0;
  for fu in row.allocation.fusions {
    if (fu.unique) {
      count = count + 1;
      require(fu.inverted == inverted && fu.aligned == aligned && fu.n == (if (inverted) { 2 } else { 1 }), 121);
      let blk = row.body.formed.f.blocks[bi];
      let ins = blk.insts[blk.insts.len() - fu.n];
      require(ins.str == "__fern_rc_is_unique" && ins.args[0] == fu.a, 122);
      require(fu.tag == ir.kind_id("eq") && fu.b == 0, 131);
      require(out.text.contains(".Lssa_first_uq" + util.i32_to_string(blk.id)), 123);
    }
    bi = bi + 1;
  }
  require(count == (if (fused) { 1 } else { 0 }), 124);
  require(fused || out.text.contains(".Lssa_first_rcuniq"), 125);
}

function comparison(g: ircore.Gated, arm: boolean, mode: i32): void {
  let left = if (mode == 2) { ir.op_const_i32(13) } else { ir.op_load_local(0) };
  let right = if (mode == 1) { ir.op_const_i32(13) } else { ir.op_load_local(1) };
  let ops = [left, right, ir.op_bin("gt_s", 64, false)];
  if (mode == 1) {
    ops = ops.append(ir.op_bin("not", 32, false));
  }
  ops = util.append_all(ops, [ir.op_if(0), ir.op_const_i32(7), ir.op_return(), ir.op_else(), ir.op_const_i32(9), ir.op_return(), ir.op_end()]);
  let out = checked(g, irtables.LowerResult { ...g.cache[0], n_params: 2, n_locals: 2, ops: ops }, arm);
  compare_fusion(out.bodies[0], mode);
}

function compare_fusion(row: ssaprepare.Emitted, mode: i32): void {
  let count = 0;
  let bi = 0;
  for fu in row.allocation.fusions {
    if (fu.n > 0) {
      count = count + 1;
      let blk = row.body.formed.f.blocks[bi];
      compare_operands(blk, fu, mode);
      require(row.allocation.imm.is_imm[fu.b] == (mode != 0) && !row.allocation.imm.is_imm[fu.a], 136);
      require(mode == 0 || row.allocation.imm.value[fu.b] == 13i64, 137);
    }
    bi = bi + 1;
  }
  require(count == 1, 138);
}

function compare_operands(blk: ssa.SBlock, fu: ssaprepare.Fusion, mode: i32): void {
  require(!fu.unique && !fu.aligned && fu.inverted == (mode == 1) && fu.n == (if (mode == 1) { 2 } else { 1 }), 132);
  let cmp = blk.insts[blk.insts.len() - fu.n];
  require(cmp.kind_tag == 9 && cmp.str == "gt_s", 133);
  require(fu.tag == ir.kind_id(if (mode == 2) { "lt_s" } else { "gt_s" }), 134);
  let first = if (mode == 2) { 1 } else { 0 };
  require(fu.a == cmp.args[first] && fu.b == cmp.args[1 - first], 135);
}

function unique_pressure(g: ircore.Gated, arm: boolean): void {
  let ops: ir.Op[] = [];
  let i = 0;
  while (i < 25) {
    ops = util.append_all(ops, [ir.op_load_local(i), ir.op_call_direct("__fern_rc_is_unique", 1), ir.op_store_local(25 + i)]);
    i = i + 1;
  }
  ops = ops.append(ir.op_const_i32(0));
  i = 0;
  while (i < 50) {
    ops = util.append_all(ops, [ir.op_load_local(i), ir.op_bin("add", 64, false)]);
    i = i + 1;
  }
  let r = irtables.LowerResult { ...g.cache[0], n_params: 25, n_locals: 50, ops: ops.append(ir.op_return()) };
  let row = checked(g, r, arm).bodies[0];
  sites.pressure(row);
  inlineproof.run(row, false);
}

function rotated(g: ircore.Gated, arm: boolean): void {
  let ops = [
    ir.op_block(0), ir.op_loop(0), ir.op_load_local(0), ir.op_call_direct("__fern_rc_is_unique", 1), ir.op_bin("not", 32, false), ir.op_brif(1),
    ir.op_load_local(0), ir.op_const_i32(8), ir.op_bin("add", 64, false), ir.op_store_local(0), ir.op_br(0), ir.op_end(), ir.op_end(), ir.op_const_i32(9), ir.op_return(),
  ];
  let out = checked(g, irtables.LowerResult { ...g.cache[0], n_params: 1, n_locals: 1, ops: ops }, arm);
  sites.rotated(out.bodies[0]);
  inlineproof.run(out.bodies[0], false);
}

pub function run(g: ircore.Gated, arm: boolean): void {
  selected_uniqueness(arm);
  collectionproof.run(g, arm);
  phi_join(g, arm, false);
  phi_join(g, arm, true);
  let leaf = checked(g, g.cache[0], arm);
  require(!leaf.bodies[0].allocation.framed, 126);
  spills(g, arm, 24);
  spills(g, arm, 25);
  uniqueness(g, arm, false, false, false);
  uniqueness(g, arm, false, true, false);
  uniqueness(g, arm, true, false, false);
  uniqueness(g, arm, true, true, false);
  uniqueness(g, arm, true, true, true);
  comparison(g, arm, 0);
  comparison(g, arm, 1);
  comparison(g, arm, 2);
  rotated(g, arm);
  unique_pressure(g, arm);
}
