import "std/i64";
import "std/io";
import "../arm64_native";

function main(): i32 {
  let av = args();
  let dump = false;
  let dump_data = false;
  let dump_eh = false;
  let dump_eh_darwin = false;
  let i = 0;
  while (i < av.len()) {
    if (av[i] == "-words") {
      dump = true;
    }
    if (av[i] == "-data") {
      dump_data = true;
    }
    if (av[i] == "-ehframe") {
      dump_eh = true;
    }
    if (av[i] == "-ehframe-darwin") {
      dump_eh_darwin = true;
    }
    i += 1;
  }
  let src = "";
  match (io.read_all_stdin()) {
    Ok(text) => {
      src = text;
    },
    Err(_) => {
      eprint("arm64 assembler: cannot read UTF-8 stdin");
      return 1;
    }
  }
  let p = arm64_native.arm64_gas_program(src);
  let pa = p.asm;
  let tv = arm64_native.macho_text_vaddr(pa.text.len(), 0, p.data.len(), p.bss_size);
  let dv = arm64_native.macho_data_vaddr(pa.text.len(), 0, p.data.len(), p.bss_size);
  p = arm64_native.arm64_gas_link(p, tv, dv);
  let pa2 = p.asm;
  let code = arm64_native.arm64_code_len(p);
  print("text=" + code.to_string() + " data=" + p.data.len().to_string()
    + " bump=" + __heap_bump_bytes().to_string() + " ro=" + (pa2.text.len() - code).to_string() + "\n");
  if (p.unknown.len() > 0) {
    let u = 0;
    while (u < p.unknown.len()) {
      print("unknown=" + p.unknown[u]);
      u += 1;
    }
  }
  if (dump) {
    let b = 0;
    while (b + 3 < code) {
      let w: i64 = pa2.text[b] as i64 | pa2.text[b + 1] as i64 << 8
        | pa2.text[b + 2] as i64 << 16 | pa2.text[b + 3] as i64 << 24;
      print("word " + (b / 4).to_string() + " " + w.to_string());
      b += 4;
    }
  }
  if (dump_data) {
    let d = 0;
    while (d < p.data.len()) {
      print("data " + d.to_string() + " " + p.data[d].to_string());
      d += 1;
    }
  }
  if (dump_eh) {
    let eh = arm64_native.arm64_eh_frame(p, 4194304 as i64, 4194560 as i64);
    let e = 0;
    while (e < eh.len()) {
      print("eh " + e.to_string() + " " + eh[e].to_string());
      e += 1;
    }
    let hdr = arm64_native.arm64_eh_frame_hdr(p, 4194304 as i64, 4194560 as i64, 4194432 as i64);
    e = 0;
    while (e < hdr.len()) {
      print("hdr " + e.to_string() + " " + hdr[e].to_string());
      e += 1;
    }
    let dbg = arm64_native.arm64_debug_frame(p, 4194304 as i64);
    e = 0;
    while (e < dbg.len()) {
      print("dbg " + e.to_string() + " " + dbg[e].to_string());
      e += 1;
    }
  }
  if (dump_eh_darwin) {
    let deh = arm64_native.arm64_eh_frame_darwin(p, 4194304 as i64, 4194560 as i64);
    let de = 0;
    while (de < deh.len()) {
      print("eh " + de.to_string() + " " + deh[de].to_string());
      de += 1;
    }
  }
  return 0;
}
