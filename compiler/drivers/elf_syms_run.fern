import "../elf";
import "../util";

function x86_exit7(): i32[] {
  return [184, 60, 0, 0, 0, 191, 7, 0, 0, 0, 15, 5];
}

function hex_nibble(v: i32): string {
  if (v == 0) {
    return "0";
  }
  if (v == 1) {
    return "1";
  }
  if (v == 2) {
    return "2";
  }
  if (v == 3) {
    return "3";
  }
  if (v == 4) {
    return "4";
  }
  if (v == 5) {
    return "5";
  }
  if (v == 6) {
    return "6";
  }
  if (v == 7) {
    return "7";
  }
  if (v == 8) {
    return "8";
  }
  if (v == 9) {
    return "9";
  }
  if (v == 10) {
    return "a";
  }
  if (v == 11) {
    return "b";
  }
  if (v == 12) {
    return "c";
  }
  if (v == 13) {
    return "d";
  }
  if (v == 14) {
    return "e";
  }
  return "f";
}

function to_hex(b: i32[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < b.len()) {
    out = out + hex_nibble(b[i] >> 4 & 15) + hex_nibble(b[i] & 15);
    i = i + 1;
  }
  return out;
}

function le16_at(b: i32[], off: i32): i32 {
  return b[off] | b[off + 1] << 8;
}

function le32_at(b: i32[], off: i32): i32 {
  return b[off] | b[off + 1] << 8 | b[off + 2] << 16 | b[off + 3] << 24;
}

function bytes_equal(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function main(): i32 {
  let text: i32[] = x86_exit7();
  let no_names: string[] = [];
  let no_offs: i32[] = [];

  let plain: i32[] = elf.elf_cat_u8([], elf.elf_static_executable_bss_x86_wx_at(util.to_u8(text), [], 0, 0));
  let plain_syms: i32[] = elf.elf_append_debug(plain, elf.elf_text_vaddr_wx(false), elf.elf_wx_text_off(false), text.len(), no_names, no_offs, no_offs, "p.fern", "/work", no_names, no_offs, no_offs, no_offs, no_offs, no_offs, no_offs, elf.no_var_ranges());
  if (!bytes_equal(plain, plain_syms)) {
    return 1;
  }

  if (le16_at(plain, 60) != 0) {
    return 2;
  }
  if (le16_at(plain, 58) != 0) {
    return 3;
  }

  let names: string[] = ["_start", "helper"];
  let offs: i32[] = [0, 5];
  let sizes: i32[] = [5, 7];
  let img: i32[] = elf.elf_append_debug(plain, elf.elf_text_vaddr_wx(false), elf.elf_wx_text_off(false), text.len(), names, offs, sizes, "p.fern", "/work", no_names, no_offs, no_offs, no_offs, no_offs, no_offs, no_offs, elf.no_var_ranges());

  if (le32_at(img, 40) == 0) {
    return 10;
  }
  if (le16_at(img, 58) != elf.elf_sh_size()) {
    return 11;
  }
  if (le16_at(img, 60) != 7) {
    return 12;
  }
  if (le16_at(img, 62) != 4) {
    return 13;
  }

  if (le16_at(img, 56) != le16_at(plain, 56)) {
    return 14;
  }
  if (le32_at(img, 32) != 64) {
    return 15;
  }

  if (img.len() <= plain.len()) {
    return 16;
  }

  let sh_off: i32 = le32_at(img, 40);
  let s1: i32 = sh_off + elf.elf_sh_size();
  if (le32_at(img, s1 + 4) != 1) {
    return 20;
  }
  if (le32_at(img, s1 + 8) != 6) {
    return 21;
  }
  if (le32_at(img, s1 + 32) != text.len()) {
    return 22;
  }

  let s2: i32 = sh_off + 2 * elf.elf_sh_size();
  if (le32_at(img, s2 + 4) != 2) {
    return 23;
  }
  if (le32_at(img, s2 + 40) != 3) {
    return 24;
  }
  if (le32_at(img, s2 + 44) != 1) {
    return 25;
  }
  if (le32_at(img, s2 + 56) != elf.elf_sym_size()) {
    return 26;
  }
  if (le32_at(img, s2 + 32) != 3 * elf.elf_sym_size()) {
    return 27;
  }

  let s5: i32 = sh_off + 5 * elf.elf_sh_size();
  if (le32_at(img, s5 + 4) != 1 || le32_at(img, s5 + 8) != 0) {
    return 50;
  }
  let s6: i32 = sh_off + 6 * elf.elf_sh_size();
  if (le32_at(img, s6 + 4) != 1 || le32_at(img, s6 + 8) != 0) {
    return 51;
  }
  let info_off: i32 = le32_at(img, s6 + 24);
  let info_size: i32 = le32_at(img, s6 + 32);
  if (le32_at(img, info_off) != info_size - 4) {
    return 52;
  }
  if (le16_at(img, info_off + 4) != 4 || img[info_off + 10] != 8) {
    return 53;
  }

  let symtab_off: i32 = le32_at(img, s2 + 24);
  if (le32_at(img, symtab_off) != 0) {
    return 30;
  }
  if (le32_at(img, symtab_off + 8) != 0) {
    return 31;
  }

  let e1: i32 = symtab_off + elf.elf_sym_size();
  if (img[e1 + 4] != 18) {
    return 32;
  }
  if (le16_at(img, e1 + 6) != 1) {
    return 33;
  }
  if (le32_at(img, e1 + 8) != elf.elf_text_vaddr_wx(false)) {
    return 34;
  }

  let e2: i32 = symtab_off + 2 * elf.elf_sym_size();
  if (le32_at(img, e2 + 8) != elf.elf_text_vaddr_wx(false) + 5) {
    return 35;
  }
  if (le32_at(img, e2) <= le32_at(img, e1)) {
    return 36;
  }

  if (le32_at(img, e1 + 16) != 5) {
    return 37;
  }
  if (le32_at(img, e2 + 16) != 7) {
    return 38;
  }

  let ln: string[] = ["main", ".Lloop", "", "helper", "msg", "helper.r"];
  let lo: i32[] = [16, 20, 24, 4, 0, 8];
  let ls: i32[] = [0, 0, 0, 0, 1, 0];
  let got: string[] = elf.elf_func_sym_names(ln, lo, ls, 0, 32);
  if (got.len() != 2) {
    return 40;
  }
  if (got[0] != "helper") {
    return 41;
  }
  if (got[1] != "main") {
    return 42;
  }

  let go2: i32[] = elf.elf_func_sym_offs(ln, lo, ls, 0, 32);
  if (go2[0] != 4 || go2[1] != 16) {
    return 43;
  }

  let gs: i32[] = elf.elf_func_sym_sizes(ln, lo, ls, 0, 32);
  if (gs[0] != 12) {
    return 44;
  }
  if (gs[1] != 16) {
    return 45;
  }

  if (elf.elf_func_sym_names(ln, lo, ls, 0 - 1, 32).len() != 3) {
    return 46;
  }

  print(to_hex(img));
  return 0;
}
