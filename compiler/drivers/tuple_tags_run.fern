import "../asmcore";
import "../util";

function split_line(tt: string): string {
  let r: asmcore.TwoTags = asmcore.split_tuple_ret(tt);
  return "split(" + tt + ") = {" + asmcore.ty_tag(r.a) + ", " + asmcore.ty_tag(r.b) + "}";
}

function at_line(tt: string, idx: i32): string {
  return "at(" + tt + "," + util.i32_to_string(idx) + ") = " + asmcore.ty_tag(asmcore.tuple_ret_tag_at(tt, idx));
}

function main(): i32 {
  let out: string = "";
  out = out + split_line("(i32, string)") + "\n";
  out = out + split_line("(string, i32)") + "\n";
  out = out + split_line("(Map[string, i32], Err)") + "\n";
  out = out + split_line("(i32, Option[string])") + "\n";
  out = out + split_line("(string, (i32, bool))") + "\n";
  out = out + split_line("i32") + "\n";
  out = out + split_line("(i32)") + "\n";
  out = out + split_line("") + "\n";
  out = out + split_line("(i32, string, bool)") + "\n";
  out = out + at_line("(i32, string, bool)", 0) + "\n";
  out = out + at_line("(i32, string, bool)", 1) + "\n";
  out = out + at_line("(i32, string, bool)", 2) + "\n";
  out = out + at_line("(i32, string, bool)", 3) + "\n";
  out = out + at_line("(Map[a, b], Option[i32])", 0) + "\n";
  out = out + at_line("(Map[a, b], Option[i32])", 1) + "\n";
  out = out + at_line("(string)", 0) + "\n";
  out = out + at_line("(string)", 1) + "\n";
  out = out + at_line("i32", 0) + "\n";
  write(out);
  return 0;
}
