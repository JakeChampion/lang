import "../checker";
import "../util";

function main(): i32 {
  let corpus: string[] = [
    "Box[i32]", "Map[K, V]", "Triple[a, b, c]",
    "Pair[Map[a, b], c]", "Wrap[(a, b)]", "Nest[Box[Box[i32]]]",
    "Foo", "i32", "(a, b)", "(Map[a, b], c)",
    "Box[i32][]", "i32[]", "Foo[]", "Map[K, V][]", "",
  ];
  let out: string = "";
  let i: i32 = 0;
  while (i < corpus.len()) {
    let t: string = corpus[i];
    let label: string = t;
    if (label.len() == 0) {
      label = "<empty>";
    }
    out = out + label + " -> " + util.i32_to_string(checker.count_type_args(t)) + "\n";
    i = i + 1;
  }
  write(out);
  return 0;
}
