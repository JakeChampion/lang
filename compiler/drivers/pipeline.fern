import "../ast";
import "../lexer";
import "../parser";
import "../constfold";
import "../checker";
import "../interp";

function run_pipeline(src: string): interp.Value {
  let toks = lexer.tokenize(src);
  let mod = parser.parse_module(toks);
  let folded = constfold.fold_module(mod);
  let mt = checker.check_module(folded);
  if (!mt.all_well_typed) {
    return interp.VErr { msg: "pipeline: program does not type-check", abort: false };
  }
  return interp.eval_module(folded);
}

function main(): i32 {
  let src: string = "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); }"
    + " function main(): i32 { let c = 2 + 3; return fact(c); }";
  let r1 = run_pipeline(src);
  match (r1) {
    interp.VInt(i) => {
      if (i.v != 120) {
        return 10;
      }
    },
    interp.VErr(e) => {
      return 11;
    },
    _ => {
      return 12;
    }
  }

  let toks2 = lexer.tokenize(src);
  let mod2 = parser.parse_module(toks2);
  let folded2 = constfold.fold_module(mod2);
  if (folded2.funcs.len() != 2) {
    return 20;
  }
  match (folded2.funcs[1].body[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprNumber(n) => {
          if (n.text != "5") {
            return 21;
          }
        },
        _ => {
          return 22;
        }
      }
    },
    _ => {
      return 23;
    }
  }

  let bad = "function f(): i32 { return \"oops\"; } function main(): i32 { return f() + 1; }";
  let r3 = run_pipeline(bad);
  match (r3) {
    interp.VErr(_) => {},
    _ => {
      return 30;
    }
  }

  let arr_src: string = "function main(): i32 {"
    + " let a = [3, 5, 7, 9];"
    + " let i = 0; let s = 0;"
    + " while (i < a.len()) { s = s + a[i]; i = i + 1; }"
    + " return s; }";
  let r4 = run_pipeline(arr_src);
  match (r4) {
    interp.VInt(i) => {
      if (i.v != 24) {
        return 40;
      }
    },
    _ => {
      return 41;
    }
  }

  let top_src = "let x = 7; let y = 11; return x + y;";
  let r5 = run_pipeline(top_src);
  match (r5) {
    interp.VInt(i) => {
      if (i.v != 18) {
        return 50;
      }
    },
    _ => {
      return 51;
    }
  }

  return 0;
}
