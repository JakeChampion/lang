import "../ir";
import "../util";
import "../wasmlocals";

function render(ops: ir.Op[]): string {
  let s: string = "";
  let i: i32 = 0;
  while (i < ops.len()) {
    if (i > 0) {
      s = s + " ; ";
    }
    s = s + ir.render_op(ops[i]);
    if (ops[i].kind_tag == ir.kind_id("dyn_dispatch")) {
      s = s + " from " + util.i32_to_string(ops[i].i32_imm);
    }
    i = i + 1;
  }
  return s;
}

function list(xs: i32[]): string {
  let s: string = "[";
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i > 0) {
      s = s + " ";
    }
    s = s + util.i32_to_string(xs[i]);
    i = i + 1;
  }
  return s + "]";
}

function show(name: string, ops: ir.Op[], n_params: i32, n_locals: i32, i64_slots: i32[], f64_slots: i32[]): string {
  let f: wasmlocals.Frame = wasmlocals.coalesce(ops, n_params, n_locals, i64_slots, f64_slots, []);
  return name + ": " + render(f.ops) + " | n_locals=" + util.i32_to_string(f.n_locals)
    + " i64=" + list(f.i64_slots) + " f64=" + list(f.f64_slots) + "\n";
}

function cat(a: ir.Op[], b: ir.Op[]): ir.Op[] {
  let out: ir.Op[] = a;
  for o in b {
    out = out.append(o);
  }
  return out;
}

function ld(slot: i32): ir.Op {
  return ir.op_load_local(slot);
}

function st(slot: i32): ir.Op {
  return ir.op_store_local(slot);
}

function k(v: i32): ir.Op {
  return ir.op_const_i32(v);
}

function add(): ir.Op {
  return ir.op_bin("add", 0, false);
}

function main(): i32 {
  let out: string = "";

  let temps: ir.Op[] = [k(1), st(1), ld(1), st(0), k(2), st(2), ld(2), st(0), k(3), st(3), ld(3), ld(0), add(), ir.op_return()];
  out = out + show("straight_line", temps, 1, 6, [], []);

  let zero: ir.Op[] = [k(1), st(1), ld(1), ir.op_drop(), ld(2), k(5), add(), st(2), ld(2), ir.op_return()];
  out = out + show("read_before_store", zero, 0, 3, [], []);

  let cond: ir.Op[] = [k(1), st(1), ld(1), ir.op_if(0), k(7), st(2), ir.op_end(), ld(2), ir.op_return()];
  out = out + show("store_in_if_read_after", cond, 0, 3, [], []);

  let body: ir.Op[] = [ld(1), k(1), add(), st(2), ld(2), ir.op_drop(), k(0), ir.op_brif(0)];
  let looped: ir.Op[] = cat(cat([k(4), st(1), ir.op_block(0), ir.op_loop(0)], body), [ir.op_end(), ir.op_end(), k(9), st(3), ld(3), ir.op_return()]);
  out = out + show("live_around_back_edge", looped, 0, 4, [], []);

  let fresh: ir.Op[] = [ir.op_block(0), ir.op_loop(0), k(1), st(1), ld(1), ir.op_drop(), k(2), st(2), ld(2), ir.op_brif(0), ir.op_end(), ir.op_end(), k(0), ir.op_return()];
  out = out + show("stored_each_iteration", fresh, 0, 3, [], []);

  let typed: ir.Op[] = [k(1), st(1), ld(1), ir.op_drop(), k(2), st(2), ld(2), ir.op_drop(), k(3), st(3), ld(3), ir.op_drop(), k(4), st(4), ld(4), ir.op_return()];
  out = out + show("types_apart", typed, 0, 5, [2], [3]);

  let dispatch: ir.Op[] = [k(1), st(1), ld(1), st(0), k(5), st(3), k(6), st(4), ir.op_dyn_dispatch(["Sq.area"], 3, 2), st(2), ld(2), ir.op_return()];
  out = out + show("dyn_dispatch_run", dispatch, 1, 5, [], []);

  print(out);
  return 0;
}
