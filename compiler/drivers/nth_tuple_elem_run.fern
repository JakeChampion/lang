import "../wasm_ir";
import "../util";

function show(s: string): string {
  if (s.len() == 0) {
    return "<empty>";
  }

  return s;
}

function main(): i32 {
  let corpus: string[] = [
    "(i32, i32)", "(i32, u32, string)", "(Map[K, V], c)",
    "((a, b), c)", "(Option[i32], Result[i32, u32])", "(x)",
    "(i32, i32)[]", "i32", "Map[a, b]", "", "(a, (b, c), d)",
  ];
  let out = "";
  for i in 0..corpus.len() {
    let t = corpus[i];
    let label = t;
    if (label.len() == 0) {
      label = "<empty>";
    }
    for n in 0..=3 {
      out = out + label + "[" + util.i32_to_string(n) + "]=" + show(wasm_ir.nth_tuple_type_elem(t, n)) + "\n";
    }
  }
  write(out);
  return 0;
}
