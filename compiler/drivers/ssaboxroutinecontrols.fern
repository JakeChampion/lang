import "../ssaboxroutines" as routines;
import "../ssaprepare";
import "std/string";

function require(ok: boolean, group: string): void {
  if (!ok) {
    eprint("box routine controls failed: " + group);
    exit(180);
  }
}

function change(s: string, from: string, to: string): string {
  require(s.contains(from), "mutation present " + from);
  return s.split(from).join(to);
}

function allocation(text: string): void {
  let froms = ["cmpq $65535, %rdi", "ja .Lrecbox_wide", ".Lrecbox_wide:\n    subq $1, %rdi", "pushq %rdi\n    subq $2, %rdi", "jae .Lrecbox_sized", "xorl %edi, %edi\n.Lrecbox_sized:", "popq %rdi\n    subq $8, %rax", "movl $1, -8(%rax)\n    movl %edi, -4(%rax)", "movl $1, -8(%rax)\n    movl %edi, -4(%rax)", "movl $1, -8(%rax)\n    movl %edi, -4(%rax)", "cmpq $253, %rax\n    ja .Lrecbox_far", "leaq __fern_freelist+8(%rip), %rcx", "leaq (%rcx,%rdi,8), %rcx", "jz .Lrecbox_bump", "popq (%rcx)", "movl $1, (%rax)\n    movl %edi, 4(%rax)", "movl $1, (%rax)\n    movl %edi, 4(%rax)", "leaq 8(%rax,%rdi,8), %rcx", "cmpw %ax, %cx\n    jb .Lrecbox_slow", "ja .Lrecbox_slow"];
  let tos = ["cmpq $65536, %rdi", "jae .Lrecbox_wide", ".Lrecbox_wide:\n    subq $2, %rdi", "pushq %rdi\n    subq $1, %rdi", "jbe .Lrecbox_sized", "movl $1, %edi\n.Lrecbox_sized:", "popq %rdi\n    subq $16, %rax", "movl $2, -8(%rax)\n    movl %edi, -4(%rax)", "movl $1, -8(%rax)\n    movl %edi, -8(%rax)", "movl %edi, -4(%rax)", "cmpq $254, %rax\n    ja .Lrecbox_far", "leaq __fern_freelist(%rip), %rcx", "leaq (%rcx,%rdi,4), %rcx", "jnz .Lrecbox_bump", "popq %rdx", "movl $2, (%rax)\n    movl %edi, 4(%rax)", "movl $1, (%rax)\n    movl %edi, (%rax)", "leaq (%rax,%rdi,8), %rcx", "cmpw %ax, %cx\n    ja .Lrecbox_slow", "jb .Lrecbox_slow"];
  let i = 0;
  for from in froms {
    require(!routines.allocation(change(text, from, tos[i])), from + " -> " + tos[i]);
    i += 1;
  }
}

function release(text: string): void {
  let froms = ["movzwl -4(%rax), %ecx", "testl %ecx, %ecx\n    jz __fn___fern_arr_dec.u", "cmpl $1, -8(%rax)\n    jne __fn___fern_arr_dec.u", "cmpl $1, -8(%rax)\n    jne __fn___fern_arr_dec.u", "subq $2, %rcx\n    jae .Lboxdec_cap", "subq $2, %rcx\n    jae .Lboxdec_cap", "movq %rcx, -8(%rax)\n    movq $1, (%rax)", "movq %rcx, -8(%rax)\n    movq $1, (%rax)", "movq $1, (%rax)\n    addq $8, %rax", "jb .Lboxdec_ret", "addq $8, %rax\n    jmp __fn___fern_arr_dec.u", "cmpq $253, %rdx\n    ja .Lboxdec_far", "leaq -8(%rax), %rdx", "leaq __fern_freelist+8(%rip), %r8", "movq %rdi, (%rdx)", "movq %rdx, (%r8,%rcx,8)"];
  let tos = ["movl -4(%rax), %ecx", "testl %ecx, %ecx\n    jnz __fn___fern_arr_dec.u", "cmpl $2, -8(%rax)\n    jne __fn___fern_arr_dec.u", "cmpl $1, -8(%rax)\n    je __fn___fern_arr_dec.u", "subq $1, %rcx\n    jae .Lboxdec_cap", "subq $2, %rcx\n    jb .Lboxdec_cap", "movq %rcx, -8(%rax)\n    movq $2, (%rax)", "movl %ecx, -8(%rax)\n    movq $1, (%rax)", "movq $1, (%rax)\n    addq $16, %rax", "jb __fn___fern_arr_dec.u", "addq $8, %rax\n    jmp __fn___fern_arr_dec.r", "cmpq $255, %rdx\n    ja .Lboxdec_far", "leaq -16(%rax), %rdx", "leaq __fern_freelist(%rip), %r8", "movq %rdi, 8(%rdx)", "movq %rax, (%r8,%rcx,8)"];
  let i = 0;
  for from in froms {
    require(!routines.release(change(text, from, tos[i])), from + " -> " + tos[i]);
    i += 1;
  }
}

pub function run(output: ssaprepare.Output): void {
  require(routines.allocation(output.text) && routines.release(output.text), "actual routines");
  allocation(output.text);
  release(output.text);
}
