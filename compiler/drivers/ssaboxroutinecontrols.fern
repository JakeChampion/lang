import "../ssaboxroutines" as routines;
import "../ssaprepare";
import "std/string";

function require(ok: boolean, group: string): void {
  if (!ok) {
    eprint("box routine controls failed: " + group);
    exit(180);
  }
}

function change(s: string, from: string, to: string): string {
  require(s.contains(from), "mutation present " + from);
  return s.split(from).join(to);
}

function allocation(text: string): void {
  let froms = ["cmpq $2, %rdi\n    jb .Lrecbox_unit", "jb .Lrecbox_unit", "pushq %rdi\n    subq $2, %rdi", "popq %rdi\n    subq $8, %rax", "movl $1, -8(%rax)\n    movl %edi, -4(%rax)", "movl $1, -8(%rax)\n    movl %edi, -4(%rax)", "movl $1, -8(%rax)\n    movl %edi, -4(%rax)", ".Lrecbox_unit:\n    subq $1, %rdi"];
  let tos = ["cmpq $1, %rdi\n    jb .Lrecbox_unit", "jbe .Lrecbox_unit", "pushq %rdi\n    subq $1, %rdi", "popq %rdi\n    subq $16, %rax", "movl $2, -8(%rax)\n    movl %edi, -4(%rax)", "movl $1, -8(%rax)\n    movl %edi, -8(%rax)", "movl %edi, -4(%rax)", ".Lrecbox_unit:\n    subq $2, %rdi"];
  let i = 0;
  for from in froms {
    require(!routines.allocation(change(text, from, tos[i])), from + " -> " + tos[i]);
    i += 1;
  }
}

function release(text: string): void {
  let froms = ["cmpl $0, -4(%rax)\n    je __fn___fern_arr_dec.u", "cmpl $1, -8(%rax)\n    jne __fn___fern_arr_dec.u", "cmpl $1, -8(%rax)\n    jne __fn___fern_arr_dec.u", "movl -4(%rax), %ecx\n    subq $2, %rcx", "movq %rcx, -8(%rax)\n    movq $1, (%rax)", "movq %rcx, -8(%rax)\n    movq $1, (%rax)", "movq $1, (%rax)\n    addq $8, %rax", "jb .Lboxdec_ret", "addq $8, %rax\n    jmp __fn___fern_arr_dec.u"];
  let tos = ["cmpl $1, -4(%rax)\n    je __fn___fern_arr_dec.u", "cmpl $2, -8(%rax)\n    jne __fn___fern_arr_dec.u", "cmpl $1, -8(%rax)\n    je __fn___fern_arr_dec.u", "movl -4(%rax), %ecx\n    subq $1, %rcx", "movq %rcx, -8(%rax)\n    movq $2, (%rax)", "movl %ecx, -8(%rax)\n    movq $1, (%rax)", "movq $1, (%rax)\n    addq $16, %rax", "jb __fn___fern_arr_dec.u", "addq $8, %rax\n    jmp __fn___fern_arr_dec.r"];
  let i = 0;
  for from in froms {
    require(!routines.release(change(text, from, tos[i])), from + " -> " + tos[i]);
    i += 1;
  }
}

pub function run(output: ssaprepare.Output): void {
  require(routines.allocation(output.text) && routines.release(output.text), "actual routines");
  allocation(output.text);
  release(output.text);
}
