import "../ssauniquecaller" as caller;
import "../ssacreditselected" as selected;
import "../ssaprepare";
import "../physicalbody";
import "../ssasem";
import "../typeinfo";
import "../semtypes";
import "../semrecords";
import "../ssauniqueunit" as unit;
import "../ssa";
import "./ssauniqueselectedunit" as finalproof;
import "./ssauniqueunion" as unionproof;
import "std/string";

function require(ok: boolean): void {
  if (!ok) {
    exit(192);
  }
}

pub function final_output(out: ssaprepare.Output): void {
  finalproof.run(out);
}

pub function record_output(out: ssaprepare.Output): void {
  let row = out.bodies[0];
  let arch = row.context.architecture;
  require(caller.check_selected(out.bodies, row.label_name, arch).ok);
  require(caller.check_selected_lines(row.assembly.split("\n"), out.bodies, row.label_name, arch).ok);
  if (out.bodies.len() == 1) {
    finalproof.run(out);
  } else {
    // Generated drop/release bodies need their own effect proof. Certifying
    // the selected leaf cannot certify this larger final output.
    require(!unit.check_selected_collection(out.text, arch, out.bodies).ok);
  }
}

function check(row: ssaprepare.Emitted, expected: boolean): void {
  let p = caller.check_selected([row], row.label_name, row.context.architecture);
  if (p.ok != expected) {
    print(if (expected) { "expected admission" } else { "expected refusal" });
    print(row.assembly);
    print(p.message);
    exit(193);
  }
  require(p.function_name == row.label_name && (p.ok || p.message != ""));
}

function contracts(row: ssaprepare.Emitted, cs: ssasem.Contract[]): ssaprepare.Emitted {
  let m = selected.metadata(row);
  let origin = physicalbody.Origin { producer: 0, symbol: row.body.selected.origin.symbol, helper: None };
  let s = physicalbody.Selected { producers: [physicalbody.Metadata { ...m, contracts: cs }], origin: origin };
  return ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, selected: s } };
}

function text(row: ssaprepare.Emitted, old: string, replacement: string): ssaprepare.Emitted {
  let parts = row.assembly.split(old);
  if (parts.len() <= 1) {
    print("missing mutation input: " + old);
    print(row.assembly);
  }
  require(parts.len() > 1);
  let out = parts[0];
  let i = 1;
  while (i < parts.len()) {
    out = out + replacement + parts[i];
    i = i + 1;
  }
  return ssaprepare.Emitted { ...row, assembly: out };
}

function signatures(row: ssaprepare.Emitted): void {
  let cs = selected.contracts(row);
  require(cs.len() == 1);
  let c = cs[0];
  let byte = typeinfo.TypeI32 { is_char: false, width: 8, unsigned: true, polymorphic: false };
  check(contracts(row, []), false);
  check(contracts(row, [c, c]), false);
  check(contracts(row, [ssasem.Contract { ...c, modes: [] }]), false);
  for mode in [1, 3, -1] {
    check(contracts(row, [ssasem.Contract { ...c, modes: [mode] }]), false);
  }
  let bad_types: typeinfo.Type[] = [c.result, typeinfo.TypeString { tag: -1 }, typeinfo.TypeString { tag: 2 }, typeinfo.TypeArray { elem: byte, view: true }, typeinfo.TypeArray { elem: typeinfo.TypeUnknown { reason: "unresolved" }, view: false }];
  for t in bad_types {
    check(contracts(row, [ssasem.Contract { ...c, params: [t] }]), false);
  }
  check(contracts(row, [ssasem.Contract { ...c, params: [] }]), false);
  check(contracts(row, [ssasem.Contract { ...c, params: [c.params[0], c.params[0]] }]), false);
  check(contracts(row, [ssasem.Contract { ...c, result: c.params[0] }]), false);
  check(contracts(row, [ssasem.Contract { ...c, name: "other" }]), false);
  // Coherently supplied ABI alternatives are inputs, not authenticated types.
  // string and str both use bit-clear box handles. Only conversion to [u8]
  // adds the descriptor tag refused above; owned byte arrays remain bit-clear.
  let good_types: typeinfo.Type[] = [typeinfo.TypeString { tag: 0 }, typeinfo.TypeString { tag: 1 }, typeinfo.TypeArray { elem: byte, view: false }];
  for t in good_types {
    check(contracts(row, [ssasem.Contract { ...c, params: [t] }]), true);
  }
  containers(row, c);
}

function containers(row: ssaprepare.Emitted, c: ssasem.Contract): void {
  let unknown: typeinfo.Type = typeinfo.TypeUnknown { reason: "unresolved container" };
  let scalar = c.result;
  let byte: typeinfo.Type = typeinfo.TypeI32 { is_char: false, width: 8, unsigned: true, polymorphic: false };
  let view: typeinfo.Type = typeinfo.TypeArray { elem: byte, view: true };
  let bad_types: typeinfo.Type[] = [
    typeinfo.TypeTuple { elements: [] },
    typeinfo.TypeTuple { elements: [scalar] },
    typeinfo.TypeTuple { elements: [scalar, unknown] },
    typeinfo.TypeMap { key: unknown, value: scalar },
    typeinfo.TypeMap { key: scalar, value: unknown },
    typeinfo.TypeMap { key: scalar, value: typeinfo.TypeTuple { elements: [scalar] } },
    typeinfo.TypeTuple { elements: [scalar, typeinfo.TypeMap { key: unknown, value: scalar }] },
    typeinfo.TypeStruct { name: "Record", args: [] },
    typeinfo.TypeHandle { resource: "file", borrowed: false },
  ];
  for t in bad_types {
    check(contracts(row, [ssasem.Contract { ...c, params: [t] }]), false);
  }
  let good_types: typeinfo.Type[] = [
    typeinfo.TypeTuple { elements: [scalar, view] },
    typeinfo.TypeMap { key: scalar, value: view },
    typeinfo.TypeTuple { elements: [scalar, typeinfo.TypeMap { key: scalar, value: view }] },
  ];
  for t in good_types {
    check(contracts(row, [ssasem.Contract { ...c, params: [t] }]), true);
  }
}

function metadata(row: ssaprepare.Emitted, m: physicalbody.Metadata): ssaprepare.Emitted {
  let selected = physicalbody.Selected { producers: [m], origin: physicalbody.Origin { producer: 0, symbol: row.body.selected.origin.symbol, helper: None } };
  return ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, selected: selected } };
}

function record_schema(row: ssaprepare.Emitted, c: ssasem.Contract, record: semrecords.Record): void {
  let m = selected.metadata(row);
  let fields = record.fields;
  require(fields.len() > 0);
  check(metadata(row, physicalbody.Metadata { ...m, records: semrecords.no_records() }), false);
  // Deliberately inconsistent metadata: a stale name index must not rescue
  // missing schemas. Admission derives facts from the actual record list.
  check(metadata(row, physicalbody.Metadata { ...m, records: semrecords.Records { ...m.records, list: [] } }), false);
  check(metadata(row, physicalbody.Metadata { ...m, records: semrecords.records_of([record, record]) }), false);
  let unknown: typeinfo.Type = typeinfo.TypeUnknown { reason: "unresolved field" };
  let malformed = [
    semrecords.Record { ...record, fields: [semrecords.Field { name: "", ty: c.result }] },
    semrecords.Record { ...record, fields: [semrecords.Field { ...fields[0], ty: unknown }] },
    semrecords.Record { ...record, fields: [fields[0], fields[0]] },
  ];
  for r in malformed {
    check(metadata(row, physicalbody.Metadata { ...m, records: semrecords.records_of([r]) }), false);
  }
  let byte: typeinfo.Type = typeinfo.TypeI32 { is_char: false, width: 8, unsigned: true, polymorphic: false };
  let view: typeinfo.Type = typeinfo.TypeArray { elem: byte, view: true };
  let outer_boxes = [
    semrecords.Record { ...record, fields: [] },
    semrecords.Record { ...record, fields: [semrecords.Field { ...fields[0], ty: view }], views: true },
  ];
  for r in outer_boxes {
    check(metadata(row, physicalbody.Metadata { ...m, records: semrecords.records_of([r]) }), true);
  }
  // A scalar descriptor or closure environment cannot become an ordinary box
  // merely because a caller supplies a matching schema.
  for name in ["Reader", "Writer", "Dir", "__env$first"] {
    let t: typeinfo.Type = typeinfo.TypeStruct { name: name, args: [] };
    let r = semrecords.Record { ...record, ty: t };
    let changed = contracts(row, [ssasem.Contract { ...c, params: [t] }]);
    let own_metadata = selected.metadata(changed);
    check(metadata(changed, physicalbody.Metadata { ...own_metadata, records: semrecords.records_of([r]) }), false);
  }
  let other: typeinfo.Type = typeinfo.TypeStruct { name: "Different", args: [] };
  check(metadata(row, physicalbody.Metadata { ...m, records: semrecords.records_of([semrecords.Record { ...record, ty: other }]) }), false);
  record_producer(row, record);
}

function record_producer(row: ssaprepare.Emitted, record: semrecords.Record): void {
  let m = selected.metadata(row);
  let empty = physicalbody.Metadata { ...m, records: semrecords.no_records() };
  let own_selection = physicalbody.Selected { ...row.body.selected, producers: [empty, m], origin: physicalbody.Origin { producer: 0, symbol: row.body.selected.origin.symbol, helper: None } };
  check(ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, selected: own_selection } }, false);
  let correct = physicalbody.Selected { ...own_selection, origin: physicalbody.Origin { ...own_selection.origin, producer: 1 } };
  check(ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, selected: correct } }, true);
  if let typeinfo.TypeStruct(s) = record.ty {
    // Finalizers are not invoked by this borrowed uniqueness-only leaf.
    check(metadata(row, physicalbody.Metadata { ...m, finalizers: [ssasem.Finalizer { receiver: s.name, symbol: "destroy" }] }), true);
    if (s.args.len() > 0) {
      let wrong = semrecords.Record { ...record, ty: typeinfo.TypeStruct { ...s, args: [] } };
      check(metadata(row, physicalbody.Metadata { ...m, records: semrecords.records_of([wrong]) }), false);
    }
  }
}

function records(row: ssaprepare.Emitted): void {
  let cs = selected.contracts(row);
  let c = cs[0];
  if let typeinfo.TypeStruct(_) = c.params[0] {
    let hits = 0;
    for r in selected.metadata(row).records.list {
      if (semtypes.equal(r.ty, c.params[0])) {
        hits = hits + 1;
        record_schema(row, c, r);
      }
    }
    require(hits == 1);
  }
}

function boundaries(row: ssaprepare.Emitted): void {
  let name = row.label_name;
  let arch = row.context.architecture;
  require(!caller.check_selected([], name, arch).ok);
  require(!caller.check_selected([row, row], name, arch).ok);
  require(!caller.check_selected([row], name, "wasi").ok);
  require(!caller.check_selected([row], name, if (arch == "arm64") { "x86-64" } else { "arm64" }).ok);
  let s = row.body.selected;
  for index in [-1, s.producers.len(), 2147483647] {
    let changed = physicalbody.Selected { ...s, origin: physicalbody.Origin { ...s.origin, producer: index } };
    check(ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, selected: changed } }, false);
  }
  let f = row.body.formed.f;
  let changed_functions = [ssa.SFunc { ...f, name: "other" }, ssa.SFunc { ...f, nparams: 2 }, ssa.SFunc { ...f, takes_env: true }];
  for changed in changed_functions {
    check(ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, formed: ssa.Formed { ...row.body.formed, f: changed } } }, false);
  }
}

function annotations(row: ssaprepare.Emitted): void {
  let f = row.body.formed.f;
  let blocks = f.blocks;
  let hits = 0;
  let i = 0;
  for block in f.blocks {
    let ops = block.insts;
    let j = 0;
    for op in ops {
      if (op.kind_tag == 11 && op.str == "__fern_rc_is_unique") {
        require(op.imm == 4);
        ops = ops.with(j, ssa.SInst { ...op, imm: 0 });
        hits = hits + 1;
      }
      j = j + 1;
    }
    blocks = blocks.with(i, ssa.SBlock { ...block, insts: ops });
    i = i + 1;
  }
  require(hits == 1);
  let changed = ssa.SFunc { ...f, blocks: blocks };
  let zero = ssaprepare.Emitted { ...row, body: ssaprepare.Body { ...row.body, formed: ssa.Formed { ...row.body.formed, f: changed } } };
  check(zero, true);
  require(!caller.check_body(zero.assembly, zero.context.architecture, changed).ok);
}

function tag_guard(row: ssaprepare.Emitted, arm: boolean): string {
  if (arm) {
    for line in row.assembly.split("\n") {
      if (line.starts_with("    tbnz x0, #0, ")) {
        return line + "\n";
      }
    }
    return "    tst x0, #1\n";
  }
  return "    testb $1, %al\n";
}

pub function run(row: ssaprepare.Emitted): void {
  check(row, true);
  require(!caller.check_body(row.assembly, row.context.architecture, row.body.formed.f).ok);
  signatures(row);
  records(row);
  unionproof.run(row);
  boundaries(row);
  annotations(row);
  let arm = row.context.architecture == "arm64";
  let load = if (arm) { "    ldr x0, [sp, #0]\n" } else { "    movq 8(%rsp), %rax\n" };
  check(text(row, load, ""), false);
  check(text(row, "__fn_" + row.label_name + ".r:\n", "__fn_" + row.label_name + ".r:\n    " + (if (arm) { "mov x0, #0" } else { "movq $0, %rax" }) + "\n"), false);
  check(text(row, "    ret\n", ""), false);
  // Omitting view normalization does not permit removing either safety guard.
  check(text(row, tag_guard(row, arm), ""), false);
  let floor = if (arm) { "    cmp x0, #16, lsl #12\n" } else { "    cmpq $0x10000, %rax\n" };
  check(text(row, floor, ""), false);
  check(ssaprepare.Emitted { ...row, assembly: row.assembly + ".set hidden, 0\n" }, false);
}
