import "std/io";
import "../util";
import "../lexer";
import "../parser";
import "../flatten";
import "../modloader";
import "../constfold";
import "../platforms";
import "../irtables";
import "../lift";
import "../semsource";
import "../ssaunits";
import "../ssarc";
import "../suspend";

struct Hist { keys: string[], counts: i32[] }

function hist_bump(h: Hist, k: string): Hist {
  let i: i32 = 0;
  while (i < h.keys.len()) {
    if (h.keys[i] == k) {
      return Hist { keys: h.keys, counts: h.counts.with(i, h.counts[i] + 1) };
    }
    i = i + 1;
  }
  return Hist { keys: h.keys.append(k), counts: h.counts.append(1) };
}

function hist_print(label: string, h: Hist): void {
  print(label);
  let order: i32[] = [];
  let used: boolean[] = [];
  let i: i32 = 0;
  while (i < h.keys.len()) {
    used = used.append(false);
    i = i + 1;
  }
  let n: i32 = 0;
  while (n < h.keys.len()) {
    let best: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < h.keys.len()) {
      if (!used[j]) {
        if (best < 0 || h.counts[j] > h.counts[best]) {
          best = j;
        }
      }
      j = j + 1;
    }
    used = used.with(best, true);
    order = order.append(best);
    n = n + 1;
  }
  for k in order {
    print("  " + util.i32_to_string(h.counts[k]) + "  " + h.keys[k]);
  }
}

function leaf(why: string): string {
  let tag: string = "call target was refused: ";
  let out: string = why;
  while (out.len() > tag.len()) {
    let head: string = slice_unchecked(out, 0, tag.len()).to_owned();
    if (head != tag) {
      return out;
    }
    out = slice_unchecked(out, tag.len(), out.len()).to_owned();
  }
  return out;
}

struct Stage { planned: boolean, lowered: boolean, plan_why: string, rc_why: string }

function stage_of(p: semsource.Produced, tab: irtables.StructTab): Stage {
  let plan: ssaunits.Plan = ssaunits.plan(p.func, p.modes, ssaunits.no_view());
  if (!plan.ok) {
    return Stage { planned: false, lowered: false, plan_why: plan.why, rc_why: "" };
  }
  let no_names: string[] = [];
  let lr: irtables.LowerResult = ssarc.lower(p.func, p.modes, plan, tab, ssaunits.no_grows(), util.name_index(no_names), ssaunits.no_view(), suspend.none());
  if (!lr.ok) {
    return Stage { planned: true, lowered: false, plan_why: "", rc_why: lr.why };
  }
  return Stage { planned: true, lowered: true, plan_why: "", rc_why: "" };
}

function template_stage(key: string, instances: semsource.Produced[], stages: Stage[]): Stage {
  let out: Stage = Stage { planned: true, lowered: true, plan_why: "", rc_why: "" };
  let i: i32 = 0;
  while (i < instances.len()) {
    if (instances[i].key == key) {
      if (!stages[i].planned) {
        return stages[i];
      }
      if (!stages[i].lowered) {
        out = stages[i];
      }
    }
    i = i + 1;
  }
  return out;
}

function listed_leaf(): string {
  match (env("FERN_CENSUS_LIST")) {
    Some(v) => {
      return v;
    },
    None => {
      return "";
    }
  }
  return "";
}

function measured_build(merged: parser.Module): semsource.Built {
  let built: semsource.Built = semsource.build_module(merged);
  let widened: semsource.Built = semsource.with_inferred_modes(built);
  if (!semsource.any_row_changed(semsource.changed_rows(built, widened))) {
    return built;
  }
  return widened;
}

function report(merged: parser.Module, tab: irtables.StructTab): void {
  let listed: string = listed_leaf();
  let built: semsource.Built = measured_build(merged);
  let total: i32 = built.decls.len();
  let n_produced: i32 = 0;
  let n_planned: i32 = 0;
  let n_lowered: i32 = 0;
  let n_instances: i32 = 0;
  let n_bodyless: i32 = 0;
  let n_spliced: i32 = 0;
  let refusals: Hist = Hist { keys: [], counts: [] };
  let leaves: Hist = Hist { keys: [], counts: [] };
  let plan_why: Hist = Hist { keys: [], counts: [] };
  let rc_why: Hist = Hist { keys: [], counts: [] };
  let stages: Stage[] = [];
  for inst in built.instances {
    let st: Stage = Stage { planned: false, lowered: false, plan_why: "", rc_why: "" };
    if (inst.ok) {
      n_instances = n_instances + 1;
      st = stage_of(inst, tab);
    }
    stages = stages.append(st);
  }
  let i: i32 = 0;
  while (i < built.decls.len()) {
    let p: semsource.Produced = built.decls[i];
    if (p.bodyless) {
      n_bodyless = n_bodyless + 1;
    } else if (p.dropped) {
      n_spliced = n_spliced + 1;
    } else if (!p.ok) {
      refusals = hist_bump(refusals, p.why);
      leaves = hist_bump(leaves, leaf(p.why));
      if (listed != "" && leaf(p.why) == listed) {
        print("  refused " + merged.funcs[i].name + ": " + p.why);
      }
    } else {
      n_produced = n_produced + 1;
      let st: Stage = Stage { planned: false, lowered: false, plan_why: "", rc_why: "" };
      if (p.template) {
        st = template_stage(p.key, built.instances, stages);
      } else {
        st = stage_of(p, tab);
      }
      if (!st.planned) {
        plan_why = hist_bump(plan_why, st.plan_why);
      } else {
        n_planned = n_planned + 1;
        if (!st.lowered) {
          rc_why = hist_bump(rc_why, st.rc_why);
        } else {
          n_lowered = n_lowered + 1;
        }
      }
    }
    i = i + 1;
  }
  print("functions      " + util.i32_to_string(total));
  print("bodyless       " + util.i32_to_string(n_bodyless));
  print("spliced        " + util.i32_to_string(n_spliced));
  print("measured       " + util.i32_to_string(total - n_bodyless - n_spliced));
  print("produced       " + util.i32_to_string(n_produced));
  print("planned        " + util.i32_to_string(n_planned));
  print("lowered        " + util.i32_to_string(n_lowered));
  print("instances      " + util.i32_to_string(built.instances.len()) + " requested, " + util.i32_to_string(n_instances) + " produced");
  hist_print("-- leaf refusals --", leaves);
  hist_print("-- plan refusals --", plan_why);
  hist_print("-- rc refusals --", rc_why);
}

const STDLIB_EXT: string = ".fern";

function embedded_stdlib(): modloader.Overlay {
  let paths: string[] = [];
  let srcs: string[] = [];
  for a in __fern_assets() {
    let name: string = a.0;
    if (name.len() > STDLIB_EXT.len()
      && slice_unchecked(name, name.len() - STDLIB_EXT.len(), name.len()) == STDLIB_EXT) {
      paths = paths.append(slice_unchecked(name, 0, name.len() - STDLIB_EXT.len()) + "");
      srcs = srcs.append(a.1 + "");
    }
  }
  return modloader.Overlay { ...modloader.no_overlay(), paths: paths, srcs: srcs };
}

function main(): i32 {
  let av: string[] = args();
  if (av.len() < 2) {
    eprint("usage: semsource_census_run <entry.fern>");
    return 2;
  }
  let entry_path: string = av[1];
  let dir: string = modloader.dirname(entry_path);
  match (read_file(entry_path)) {
    Ok(src) => {
      let entry: parser.Module = parser.parse_module(lexer.tokenize(src));
      let g: modloader.Graph = modloader.load_graph(embedded_stdlib(), entry_path, entry, "");
      entry = g.entry;
      let loaded: flatten.LoadedModule[] = g.loaded;
      let missing: string[] = g.missing;
      if (modloader.report_unresolved(missing, "semsource_census_run")) {
        return 2;
      }
      let merged: parser.Module = flatten.bundle(entry, loaded, "arm64-linux");
      merged = modloader.merge_builtins(dir, merged);
      let desc: platforms.Descriptor = platforms.for_target("arm64-linux");
      merged = constfold.fold_target_name(merged, desc.environment, desc.isa);
      merged = parser.module_with_builtins_typed(merged);
      merged = lift.lift_lambdas_typed(merged);
      let tab: irtables.StructTab = irtables.struct_tab(parser.erase_view_structs(merged.structs));

      report(merged, tab);
      return 0;
    },
    Err(_) => {
      eprint("cannot read entry");
      return 2;
    }
  }
  return 0;
}
