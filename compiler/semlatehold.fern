import "./ssa";
import "./ssadeps";
import "./ssalive";
import "./ssasem";
import "./sourcepos";
import "./typeinfo";

// A read off a value that a later call consumes, and that is used past the
// call, holds its own count from the read on. When the call is on one arm
// only, every other arm pays a retain and a release for nothing. This pass
// reads the value again just before the call, from the value the call
// consumes, and points the uses that the call dominates at the new read. The
// first read is then a borrow, and the plan holds the new read at the call.

pub struct Late { f: ssasem.Func, reread: i32 }

// A candidate: the call at insts[at] of blocks[block] consumes chain[0], and
// chain[1..] are the reads from it down to the value used past the call.
struct Cand { block: i32, at: i32, chain: i32[] }

// joined marks a value a phi takes: a phi needs its count on every arm, so
// the read off it holds its count from the read on in any case.
struct Graph { defs: i32[], def_block: i32[], joined: boolean[], dom: ssadeps.Dom, live: ssalive.Flow }

pub function reread_before_spends(f: ssasem.Func): Late {
  let g: ssa.SFunc = f.graph;
  let gr: Graph = graph_of(g);
  if (!gr.live.ok) {
    return Late { f: f, reread: 0 };
  }
  let cands: Cand[] = candidates(f, gr);
  while (cands.len() > 0) {
    let out: ssasem.Func = applied(f, gr, cands);
    let bad: i32 = first_still_live(out, cands);
    if (bad < 0) {
      return Late { f: out, reread: cands.len() };
    }
    cands = without(cands, bad);
  }
  return Late { f: f, reread: 0 };
}

function graph_of(g: ssa.SFunc): Graph {
  let defs: i32[] = minus_ones(g.nvals);
  let def_block: i32[] = minus_ones(g.nvals);
  let joined: boolean[] = __alloc_bool(g.nvals);
  for bi in 0..g.blocks.len() {
    let b: ssa.SBlock = g.blocks[bi];
    for k in 0..b.insts.len() {
      let ins: ssa.SInst = b.insts[k];
      if (ins.result >= 0 && ins.result < g.nvals) {
        defs = defs.with(ins.result, k);
        def_block = def_block.with(ins.result, bi);
      }
      if (ins.kind_tag == 8) {
        joined = marked(joined, ins.args);
      }
    }
  }
  return Graph { defs: defs, def_block: def_block, joined: joined, dom: ssadeps.dominates(g), live: ssalive.compute_checked(g, no_chains(g.nvals)) };
}

function marked(own flags: boolean[], vs: i32[]): boolean[] {
  for v in vs {
    if (v >= 0 && v < flags.len()) {
      flags = flags.with(v, true);
    }
  }
  return flags;
}

function candidates(f: ssasem.Func, gr: Graph): Cand[] {
  let out: Cand[] = [];
  let below: i32[][] = reads_below(f, gr);
  let taken: boolean[] = __alloc_bool(f.graph.nvals);
  for bi in 0..f.graph.blocks.len() {
    let b: ssa.SBlock = f.graph.blocks[bi];
    for k in 0..b.insts.len() {
      for r in spent_args(f, b.insts[k]) {
        for v in below[r] {
          if (!taken[v] && !block_named(out, bi) && late_read(f, gr, bi, k, v)) {
            out = out.append(Cand { block: bi, at: k, chain: chain_of(f, gr, r, v) });
            taken = taken.with(v, true);
          }
        }
      }
    }
  }
  return out;
}

// reads_below lists, for each value, the counted reads at most four reads
// down from it.
function reads_below(f: ssasem.Func, gr: Graph): i32[][] {
  let out: i32[][] = no_chains(f.graph.nvals);
  for v in 0..f.graph.nvals {
    let x: i32 = v;
    let depth: i32 = 0;
    while (depth < 4 && x >= 0 && counted_read(f, gr, x)) {
      x = def(f, gr, x).args[0];
      if (x >= 0 && x < out.len()) {
        out = out.with(x, out[x].append(v));
      }
      depth = depth + 1;
    }
  }
  return out;
}

// block_named says block bi already has a candidate.
function block_named(cands: Cand[], bi: i32): boolean {
  for c in cands {
    if (c.block == bi) {
      return true;
    }
  }
  return false;
}

// The arguments a call consumes, by its callee's contract.
function spent_args(f: ssasem.Func, ins: ssa.SInst): i32[] {
  let out: i32[] = [];
  if (ins.kind_tag != ssasem.call()) {
    return out;
  }
  let c: i32 = ssasem.find_contract_in(f.calls, ins.str);
  if (c < 0) {
    return out;
  }
  for k in 0..ins.args.len() {
    if (k < f.calls[c].modes.len() && f.calls[c].modes[k] == ssasem.counted_mode() && ins.args[k] >= 0) {
      out = out.append(ins.args[k]);
    }
  }
  return out;
}

// Whether v, a read off a value the call at insts[k] of blocks[bi]
// consumes, is made in a block above the call's own and is live past it.
function late_read(f: ssasem.Func, gr: Graph, bi: i32, k: i32, v: i32): boolean {
  let vb: i32 = gr.def_block[v];
  if (vb < 0 || vb == bi || !ssadeps.dom_holds(gr.dom, bi, vb) || gr.joined[v]) {
    return false;
  }
  return ssalive.live_out_has(gr.live, bi, v) || used_after(f.graph.blocks[bi], k, v);
}

function counted_read(f: ssasem.Func, gr: Graph, v: i32): boolean {
  if (gr.def_block[v] < 0) {
    return false;
  }
  let d: ssa.SInst = def(f, gr, v);
  let kind: boolean = d.kind_tag == ssasem.record_get() && d.args.len() == 1 || d.kind_tag == ssasem.tuple_get() && d.args.len() == 1 || d.kind_tag == ssasem.array_get() && d.args.len() == 2;
  return kind && ssasem.reference(f.values[v]) && !ssasem.is_view(f.values[v]);
}

function def(f: ssasem.Func, gr: Graph, v: i32): ssa.SInst {
  return f.graph.blocks[gr.def_block[v]].insts[gr.defs[v]];
}

// chain_of lists r, then each read from r down to v.
function chain_of(f: ssasem.Func, gr: Graph, r: i32, v: i32): i32[] {
  let up: i32[] = [];
  let x: i32 = v;
  while (x != r) {
    up = up.append(x);
    x = def(f, gr, x).args[0];
  }
  let out: i32[] = [r];
  let i: i32 = up.len() - 1;
  while (i >= 0) {
    out = out.append(up[i]);
    i = i - 1;
  }
  return out;
}

function used_after(b: ssa.SBlock, k: i32, v: i32): boolean {
  for j in k + 1..b.insts.len() {
    if (has(b.insts[j].args, v)) {
      return true;
    }
  }
  return term_reads(b.term, v);
}

function term_reads(t: ssa.STerm, v: i32): boolean {
  return t.kind_tag == 1 && t.value == v || t.kind_tag == 3 && t.cond == v;
}

// applied re-reads each candidate's chain before its call and renames the
// uses its call dominates.
function applied(f: ssasem.Func, gr: Graph, cands: Cand[]): ssasem.Func {
  let values: typeinfo.Type[] = f.values;
  let fresh: i32[] = minus_ones(f.graph.nvals);
  let blocks: ssa.SBlock[] = f.graph.blocks;
  for c in cands {
    let pre: ssa.SInst[] = [];
    let prev: i32 = c.chain[0];
    for i in 1..c.chain.len() {
      let d: ssa.SInst = def(f, gr, c.chain[i]);
      let nv: i32 = values.len();
      values = values.append(f.values[c.chain[i]]);
      pre = pre.append(ssa.SInst { ...d, result: nv, args: d.args.with(0, prev) });
      prev = nv;
    }
    fresh = fresh.with(c.chain[c.chain.len() - 1], prev);
    blocks = blocks.with(c.block, ssa.SBlock { ...blocks[c.block], insts: inserted(blocks[c.block].insts, c.at, pre) });
  }
  let renamed: ssa.SBlock[] = renamed_blocks(f.graph, gr, cands, blocks, fresh);
  let graph: ssa.SFunc = ssa.SFunc { ...f.graph, blocks: renamed, nvals: values.len() };
  return ssasem.Func { ...f, values: values, graph: graph, source_positions: padded(f.source_positions, values.len()) };
}

// inserted puts pre before insts[at]. A block holds at most one candidate.
function inserted(insts: ssa.SInst[], at: i32, pre: ssa.SInst[]): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  for k in 0..insts.len() {
    if (k == at) {
      for p in pre {
        out = out.append(p);
      }
    }
    out = out.append(insts[k]);
  }
  return out;
}

function renamed_blocks(g: ssa.SFunc, gr: Graph, cands: Cand[], blocks: ssa.SBlock[], fresh: i32[]): ssa.SBlock[] {
  let out: ssa.SBlock[] = blocks;
  for bi in 0..blocks.len() {
    let b: ssa.SBlock = blocks[bi];
    let insts: ssa.SInst[] = [];
    let k: i32 = 0;
    for ins in b.insts {
      let at: i32 = original_at(cands, bi, k);
      if (at >= 0 && ins.kind_tag == 8) {
        insts = insts.append(ssa.SInst { ...ins, args: renamed_phi_args(g, gr, cands, fresh, b, ins.args) });
      } else if (at >= 0) {
        insts = insts.append(ssa.SInst { ...ins, args: renamed_args(gr, cands, fresh, bi, at, ins.args) });
      } else {
        insts = insts.append(ins);
      }
      k = k + 1;
    }
    let t: ssa.STerm = b.term;
    let big: i32 = 1 << 30;
    t = ssa.STerm { ...t, value: renamed(gr, cands, fresh, bi, big, t.value), cond: renamed(gr, cands, fresh, bi, big, t.cond) };
    out = out.with(bi, ssa.SBlock { ...b, insts: insts, term: t });
  }
  return out;
}

// original_at maps position k of the edited block bi back to the position in
// the original block, or -1 for an inserted read.
function original_at(cands: Cand[], bi: i32, k: i32): i32 {
  for c in cands {
    if (c.block == bi) {
      let n: i32 = c.chain.len() - 1;
      if (k < c.at) {
        return k;
      }
      if (k < c.at + n) {
        return 0 - 1;
      }
      return k - n;
    }
  }
  return k;
}

function renamed_args(gr: Graph, cands: Cand[], fresh: i32[], bi: i32, at: i32, args: i32[]): i32[] {
  let out: i32[] = args;
  for i in 0..args.len() {
    out = out.with(i, renamed(gr, cands, fresh, bi, at, args[i]));
  }
  return out;
}

function renamed_phi_args(g: ssa.SFunc, gr: Graph, cands: Cand[], fresh: i32[], b: ssa.SBlock, args: i32[]): i32[] {
  let pos: i32[] = ssa.block_positions(g);
  let out: i32[] = args;
  for i in 0..args.len() {
    if (i < b.preds.len()) {
      out = out.with(i, renamed(gr, cands, fresh, pos[b.preds[i]], 1 << 30, args[i]));
    }
  }
  return out;
}

// renamed gives the re-read for a use of v at position at of block bi when
// the call that re-reads v dominates that use.
function renamed(gr: Graph, cands: Cand[], fresh: i32[], bi: i32, at: i32, v: i32): i32 {
  if (v < 0 || v >= fresh.len() || fresh[v] < 0) {
    return v;
  }
  for c in cands {
    if (c.chain[c.chain.len() - 1] == v && (bi == c.block && at > c.at || bi != c.block && ssadeps.dom_holds(gr.dom, bi, c.block))) {
      return fresh[v];
    }
  }
  return v;
}

// first_still_live is the first candidate whose value is still live past its
// call, which a use that the call does not dominate makes so, or -1.
function first_still_live(f: ssasem.Func, cands: Cand[]): i32 {
  let live: ssalive.Flow = ssalive.compute_checked(f.graph, no_chains(f.graph.nvals));
  if (!live.ok) {
    return 0;
  }
  for i in 0..cands.len() {
    let c: Cand = cands[i];
    let v: i32 = c.chain[c.chain.len() - 1];
    let call_at: i32 = c.at + c.chain.len() - 1;
    if (ssalive.live_out_has(live, c.block, v) || used_after(f.graph.blocks[c.block], call_at, v)) {
      return i;
    }
  }
  return 0 - 1;
}

function without(cands: Cand[], i: i32): Cand[] {
  let out: Cand[] = [];
  for j in 0..cands.len() {
    if (j != i) {
      out = out.append(cands[j]);
    }
  }
  return out;
}

function has(xs: i32[], v: i32): boolean {
  for x in xs {
    if (x == v) {
      return true;
    }
  }
  return false;
}

function minus_ones(n: i32): i32[] {
  let out: i32[] = __alloc_i32(n);
  for i in 0..n {
    out = out.with(i, 0 - 1);
  }
  return out;
}

function no_chains(n: i32): i32[][] {
  let out: i32[][] = [];
  for i in 0..n {
    out = out.append([]);
  }
  return out;
}

function padded(source: sourcepos.SourceInfo, n: i32): sourcepos.SourceInfo {
  if (source.entry.line == 0) {
    return source;
  }
  let values = source.values;
  while (values.len() < n) {
    values = values.append(sourcepos.SourcePos { line: 0, col: "0" });
  }
  return sourcepos.SourceInfo { ...source, values: values };
}
