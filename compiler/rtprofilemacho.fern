// Mach-O profiler symbol lookup over the running image's mapped segments.
// The native writer sorts nlist_64 text symbols by address; no file I/O or
// allocation is needed at exit, and ASLR is derived from the runtime header.
pub function source(): string {
  return "function __fern_profile_macho_u32(p: usize): usize {\n  return (__load_i32(p) as u32) as usize;\n}\n"
    + "function __fern_profile_macho_tag(p: usize, text: string): boolean {\n  if (text.len() > 16) { return false; }\n  let i: i32 = 0;\n  while (i < text.len()) {\n    if (__load_u8(p + (i as usize)) != __load_u8(__raw_data(text) + (i as usize))) { return false; }\n    i = i + 1;\n  }\n  if (text.len() == 16) { return true; }\n  return __load_u8(p + (text.len() as usize)) == 0;\n}\n"
    + "function __fern_profile_macho_command(im: usize, size: usize, kind: usize, name: string): usize {\n  if (im == 0 || size < 32) { return 0; }\n  if (__fern_profile_macho_u32(im) != (4277009103u64 as usize)) { return 0; }\n  let bytes: usize = __fern_profile_macho_u32(im + 20);\n  let count: usize = __fern_profile_macho_u32(im + 16);\n  if (bytes > size - 32 || count > bytes / 8) { return 0; }\n  let at: usize = 32;\n  let end: usize = 32 + bytes;\n  let i: usize = 0;\n  while (i < count) {\n    if (at > end || end - at < 8) { return 0; }\n    let command: usize = im + at;\n    let len: usize = __fern_profile_macho_u32(command + 4);\n    if (len < 8 || len > end - at) { return 0; }\n    if (__fern_profile_macho_u32(command) == kind) {\n      if (name.len() == 0) { return command; }\n      if (len >= 24 && __fern_profile_macho_tag(command + 8, name)) { return command; }\n    }\n    at = at + len;\n    i = i + 1;\n  }\n  return 0;\n}\n"
    + "function __fern_profile_macho_image_size(im: usize): usize {\n  // The native writer maps at least one 16 KiB __TEXT page containing its\n  // load commands. This bootstrap read is only for our running executable.\n  let text: usize = __fern_profile_macho_command(im, 16384, 25, \"__TEXT\");\n  if (text == 0 || __fern_profile_macho_u32(text + 4) < 72) { return 0; }\n  let base: usize = __load_i64(text + 24) as usize;\n  let extent: usize = base;\n  let count: usize = __fern_profile_macho_u32(im + 16);\n  let end: usize = 32 + __fern_profile_macho_u32(im + 20);\n  let at: usize = 32;\n  let i: usize = 0;\n  while (i < count) {\n    if (at > end || end - at < 8) { return 0; }\n    let command: usize = im + at;\n    let len: usize = __fern_profile_macho_u32(command + 4);\n    if (len < 8 || len > end - at) { return 0; }\n    if (__fern_profile_macho_u32(command) == 25 && len >= 72) {\n      let addr: usize = __load_i64(command + 24) as usize;\n      let bytes: usize = __load_i64(command + 32) as usize;\n      if (addr >= base && bytes > 0) {\n        let limit: usize = addr + bytes;\n        if (limit < addr) { return 0; }\n        if (limit > extent) { extent = limit; }\n      }\n    }\n    at = at + len;\n    i = i + 1;\n  }\n  return extent - base;\n}\n"
    + "function __fern_profile_name(pc: usize, im: usize, size: usize): usize {\n  let text: usize = __fern_profile_macho_command(im, size, 25, \"__TEXT\");\n  let link: usize = __fern_profile_macho_command(im, size, 25, \"__LINKEDIT\");\n  let symbols: usize = __fern_profile_macho_command(im, size, 2, \"\");\n  if (text == 0 || link == 0 || symbols == 0) { return 0; }\n  if (__fern_profile_macho_u32(text + 4) < 152 || __fern_profile_macho_u32(link + 4) < 72 || __fern_profile_macho_u32(symbols + 4) < 24) { return 0; }\n  if (__fern_profile_macho_u32(text + 64) < 1 || !__fern_profile_macho_tag(text + 72, \"__text\")) { return 0; }\n  let base: usize = __load_i64(text + 24) as usize;\n  let start: usize = __load_i64(text + 104) as usize;\n  let length: usize = __load_i64(text + 112) as usize;\n  let address: usize = pc - (im - base);\n  if (address < start || address - start >= length) { return 0; }\n  let link_addr: usize = __load_i64(link + 24) as usize;\n  let link_vm: usize = __load_i64(link + 32) as usize;\n  let link_off: usize = __load_i64(link + 40) as usize;\n  let link_size: usize = __load_i64(link + 48) as usize;\n  if (link_addr < base || link_size > link_vm) { return 0; }\n  let link_at: usize = link_addr - base;\n  if (link_at > size || link_size > size - link_at) { return 0; }\n  let sym_off: usize = __fern_profile_macho_u32(symbols + 8);\n  let count: usize = __fern_profile_macho_u32(symbols + 12);\n  let str_off: usize = __fern_profile_macho_u32(symbols + 16);\n  let str_size: usize = __fern_profile_macho_u32(symbols + 20);\n  if (sym_off < link_off || str_off < link_off) { return 0; }\n  let sym_at: usize = sym_off - link_off;\n  let str_at: usize = str_off - link_off;\n  if (sym_at > link_size || count > (link_size - sym_at) / 16) { return 0; }\n  if (str_at > link_size || str_size > link_size - str_at) { return 0; }\n  let table: usize = im + link_at + sym_at;\n  // macho_sym_order sorts native text symbols by address, then by name.\n  let lo: usize = 0;\n  let hi: usize = count;\n  while (lo < hi) {\n    let mid: usize = lo + (hi - lo) / 2;\n    let value: usize = __load_i64(table + mid * 16 + 8) as usize;\n    if (value <= address) { lo = mid + 1; } else { hi = mid; }\n  }\n  if (lo == 0) { return 0; }\n  let symbol: usize = table + (lo - 1) * 16;\n  if ((__load_u8(symbol + 4) & 238) != 14 || __load_u8(symbol + 5) != 1) { return 0; }\n  let name: usize = __fern_profile_macho_u32(symbol);\n  if (name == 0 || name >= str_size) { return 0; }\n  let strings: usize = im + link_at + str_at;\n  let p: usize = strings + name;\n  let q: usize = p;\n  while (q < strings + str_size && __load_u8(q) != 0) { q = q + 1; }\n  if (q == strings + str_size || q == p) { return 0; }\n  return p;\n}\n";
}
