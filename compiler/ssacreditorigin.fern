// Independent capacity origin for straight-line record constructors.
// Caller binds the selected ABI and ordered layout: one parameter per field,
// scalar parameters or consuming references as marked below. No production gate.
import "./ssa";
import "./ssacredithelper" as helper;
import "./util";

pub struct Origin { proof: helper.Proof, words: i32 }

function refused(f: ssa.SFunc, why: string): Origin {
  return Origin { proof: helper.Proof { ok: false, function_name: f.name, message: why }, words: 0 };
}

// Success proves one fresh returned allocation of exactly words slots, with its
// shape and all fields initialized. Reference arguments may alias: each has its
// own incoming credit. This does not prove any arbitrary caller's input capacity.
pub function producer(f: ssa.SFunc, shape: string, references: boolean[]): Origin {
  if (f.name == "" || util.str_has_prefix(f.name, "__fern_") || shape == "" || references.len() < 1 || references.len() > 2 || f.nparams != references.len() || f.takes_env || f.blocks.len() != 1) {
    return refused(f, "unsupported allocation producer boundary");
  }
  let b = f.blocks[0];
  if (b.id < 0 || b.id != f.entry || b.preds.len() != 0 || b.term.kind_tag != 1 || f.nvals < f.nparams || f.nvals > b.insts.len()) {
    return refused(f, "unsupported allocation producer graph");
  }
  // Undefined=-1, scalar literal=0, fresh allocation=1, shape address=2,
  // parameter identities=3+i. Store results remain unreadable.
  let values: i32[] = [];
  let defined: boolean[] = [];
  let i: i32 = 0;
  while (i < f.nvals) {
    values = values.append(-1);
    defined = defined.append(false);
    i = i + 1;
  }
  let params: boolean[] = [];
  let fields: boolean[] = [];
  let credits: i32[] = [];
  for ref in references {
    params = params.append(false);
    fields = fields.append(false);
    credits = credits.append(if (ref) { 1 } else { 0 });
  }
  let words = references.len() + 1;
  let allocated = false;
  let shaped = false;
  for op in b.insts {
    if (op.result < 0 || op.result >= f.nvals || defined[op.result]) {
      return refused(f, "invalid allocation producer definition");
    }
    // Read before defining the result, so self references cannot gain availability.
    for arg in op.args {
      if (arg < 0 || arg >= values.len() || values[arg] < 0) {
        return refused(f, "unavailable allocation producer operand");
      }
    }
    defined = defined.with(op.result, true);
    let kind: i32 = -1;
    if (op.kind_tag == 6 && op.args.len() == 0 && op.str == "") {
      if (op.imm < 0 || op.imm >= params.len() || params[op.imm]) {
        return refused(f, "invalid allocation producer parameter");
      }
      params = params.with(op.imm, true);
      kind = op.imm + 3;
    } else if (op.kind_tag == 1 && op.args.len() == 0 && op.str == "") {
      kind = 0;
    } else if (op.kind_tag == 7 && op.args.len() == 1 && op.imm == 0 && op.str == "") {
      kind = values[op.args[0]];
    } else if (op.kind_tag == 48 && op.args.len() == 0 && op.str == "") {
      if (allocated || op.imm != words) {
        return refused(f, "invalid allocation producer capacity or multiplicity");
      }
      allocated = true;
      kind = 1;
    } else if (op.kind_tag == 46 && op.args.len() == 0 && op.imm == 0 && op.str == shape) {
      kind = 2;
    } else if (op.kind_tag == 41 && op.args.len() == 2 && op.str == "" && values[op.args[0]] == 1) {
      let source = values[op.args[1]];
      if (op.imm == 0 && source == 2 && !shaped) {
        shaped = true;
      } else {
        // Check the bounded offset before division or indexing, including extremes.
        if (op.imm < 8 || op.imm > references.len() * 8 || op.imm % 8 != 0) {
          return refused(f, "invalid allocation producer initialization");
        }
        let slot = op.imm / 8 - 1;
        if (fields[slot] || source != slot + 3) {
          return refused(f, "invalid allocation producer initialization");
        }
        if (references[slot]) {
          if (credits[slot] != 1) {
            return refused(f, "invalid allocation producer credit transfer");
          }
          credits = credits.with(slot, 0);
        }
        fields = fields.with(slot, true);
      }
    } else {
      return refused(f, "unsupported allocation producer effect");
    }
    values = values.with(op.result, kind);
  }
  if (!allocated || !shaped) {
    return refused(f, "incomplete allocation producer initialization");
  }
  i = 0;
  while (i < fields.len()) {
    if (!params[i] || !fields[i] || credits[i] != 0) {
      return refused(f, "incomplete allocation producer initialization");
    }
    i = i + 1;
  }
  if (b.term.value < 0 || b.term.value >= values.len() || values[b.term.value] != 1) {
    return refused(f, "fresh allocation producer return required");
  }
  return Origin { proof: helper.Proof { ok: true, function_name: f.name, message: "proved initialized allocation origin" }, words: words };
}
