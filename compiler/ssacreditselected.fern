// Metadata obligations for the scoped retained wrapper. Each row owns its
// producer store; equal local indices never imply equal layouts.
// Keep predicates/offsets aligned with ssacreditabi: scalar, ordinary,
// signed_code/assertion_signature_error, incoming_modes, incoming_schema_index
// and replacement_scalar_fields; this adapter reads each row's own metadata.
import "./physicalbody";
import "./ssaprepare";
import "./ssasem";
import "./semtypes";
import "./semrecords";
import "./typeinfo";
import "./ssacreditreuse" as reuse;

pub function metadata(row: ssaprepare.Emitted): physicalbody.Metadata {
  let selected = row.body.selected;
  return selected.producers[selected.origin.producer];
}

pub function contracts(row: ssaprepare.Emitted): ssasem.Contract[] {
  let found: ssasem.Contract[] = [];
  for c in metadata(row).contracts {
    if (c.name == row.body.selected.origin.symbol) {
      found = found.append(c);
    }
  }
  return found;
}

function scalar(t: typeinfo.Type): boolean {
  if (!semtypes.concrete(t, false)) {
    return false;
  }
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  if let typeinfo.TypeFloat(_) = t {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  return false;
}

function ordinary(m: physicalbody.Metadata, t: typeinfo.Type): boolean {
  if (!semtypes.concrete(t, false) || semtypes.is_env(t)) {
    return false;
  }
  if let typeinfo.TypeStruct(s) = t {
    return ssasem.finalizer_index(m.finalizers, s.name) < 0;
  }
  return false;
}

function index(m: physicalbody.Metadata, t: typeinfo.Type): i32 {
  let found: i32 = -1;
  let i: i32 = 0;
  for r in m.records.list {
    if (semtypes.equal(r.ty, t)) {
      if (found >= 0) {
        return -1;
      }
      found = i;
    }
    i = i + 1;
  }
  return found;
}

// At depth zero only a flat scalar record is supported. The bound prevents
// recursive schemas from turning metadata comparison into an unbounded walk.
pub function compatible(a: physicalbody.Metadata, b: physicalbody.Metadata, t: typeinfo.Type, depth: i32): boolean {
  if (!ordinary(a, t) || !ordinary(b, t) || depth < 0 || depth > 1) {
    return false;
  }
  let ai = index(a, t);
  let bi = index(b, t);
  if (ai < 0 || bi < 0) {
    return false;
  }
  let x = a.records.list[ai];
  let y = b.records.list[bi];
  if (x.views || x.nests_func || y.views || y.nests_func || x.fields.len() != y.fields.len()) {
    return false;
  }
  return compatible_fields(a, b, x.fields, y.fields, depth);
}

function compatible_fields(a: physicalbody.Metadata, b: physicalbody.Metadata, fields: semrecords.Field[], others: semrecords.Field[], depth: i32): boolean {
  let i: i32 = 0;
  for field in fields {
    let other = others[i];
    if (field.name != other.name || !semtypes.equal(field.ty, other.ty)) {
      return false;
    }
    if (!scalar(field.ty) && !compatible(a, b, field.ty, depth - 1)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function wrapper_modes(c: ssasem.Contract): boolean {
  return c.params.len() == 4 && c.modes.len() == 4 && c.modes[0] == 1 && c.modes[1] == 3 && c.modes[2] == 3 && c.modes[3] == 3;
}

pub function wrapper(m: physicalbody.Metadata, c: ssasem.Contract): boolean {
  if (!wrapper_modes(c)) {
    return false;
  }
  let boolean_param = false;
  if let typeinfo.TypeBool(_) = c.params[0] {
    boolean_param = true;
  }
  return boolean_param && semtypes.equal(c.params[1], c.params[2]) && semtypes.equal(c.params[1], c.params[3]) && compatible(m, m, c.params[1], 0) && ordinary(m, c.result);
}

function pair(m: physicalbody.Metadata, t: typeinfo.Type, child: typeinfo.Type): boolean {
  if (!compatible(m, m, t, 1)) {
    return false;
  }
  let r = m.records.list[index(m, t)];
  return r.fields.len() == 2 && semtypes.equal(r.fields[0].ty, child) && semtypes.equal(r.fields[1].ty, child);
}

pub function consumer(w: physicalbody.Metadata, c: ssasem.Contract, m: physicalbody.Metadata, d: ssasem.Contract): boolean {
  if (d.params.len() != 2 || d.modes.len() != 2 || d.modes[0] != 3 || d.modes[1] != 3 || !semtypes.equal(d.params[1], c.params[3]) || !semtypes.equal(d.result, c.result)) {
    return false;
  }
  return compatible(w, m, d.params[1], 0) && compatible(w, m, d.result, 1) && pair(m, d.params[0], d.params[1]) && pair(m, d.result, d.params[1]);
}

pub function producer(m: physicalbody.Metadata, p: ssasem.Contract, consumer_metadata: physicalbody.Metadata, d: ssasem.Contract): boolean {
  if (p.params.len() != 2 || p.modes.len() != 2 || p.modes[0] != 3 || p.modes[1] != 3 || !semtypes.equal(p.params[0], d.params[1]) || !semtypes.equal(p.params[1], d.params[1]) || !semtypes.equal(p.result, d.params[0])) {
    return false;
  }
  return compatible(m, consumer_metadata, p.result, 1) && compatible(m, consumer_metadata, p.params[0], 0);
}

pub function assertion(c: ssasem.Contract): boolean {
  if (c.params.len() != 2 || c.modes.len() != 2 || c.modes[0] != 1 || c.modes[1] != 1) {
    return false;
  }
  let boolean_param = false;
  let void_result = false;
  if let typeinfo.TypeBool(_) = c.params[0] {
    boolean_param = true;
  }
  if let typeinfo.TypeVoid(_) = c.result {
    void_result = true;
  }
  return boolean_param && signed_code(c.params[1]) && void_result;
}

function signed_code(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.width == 32 && !i.unsigned && !i.is_char && !i.polymorphic;
  }
  return false;
}

pub function fields(m: physicalbody.Metadata, d: ssasem.Contract): reuse.ScalarField[] {
  let result: reuse.ScalarField[] = [];
  let r = m.records.list[index(m, d.params[1])];
  let i: i32 = 0;
  for field in r.fields {
    if (i > 268435454) {
      return [];
    }
    if let typeinfo.TypeI32(n) = field.ty {
      if (n.width == 32 && !n.unsigned && !n.is_char && !n.polymorphic) {
        for root in [3, 4, 5] {
          result = result.append(reuse.ScalarField { root: root, offset: (i + 1) * 8 });
        }
      }
    }
    i = i + 1;
  }
  return result;
}
