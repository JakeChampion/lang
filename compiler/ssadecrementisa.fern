// Independent normal-x86 decrement instruction syntax. This program is data,
// not an effect certificate. A semantic checker must call program on its own
// complete text, refuse reachable kind 0 instructions and prove every path.
import "./ssadecrementtext" as text;
import "./ssainlineuniqueisa" as registers;
import "./ssaproofnames" as names;
import "./util";
import "std/string";

// kind: 0 unsupported, 1 label, 2 register move, 3 load, 4 store,
// 5 self TEST32, 6 TEST8 bit zero, 7 CMP32 immediate, 8 CMP64 floor,
// 9 SUB32 one, 10 branch, 11 plain RET, 12 exact underflow-counter INC32.
// Width is in bits. Register numbers
// use the independent ISA table; offsets are signed byte displacements.
pub struct Op { kind: i32, width: i32, source: i32, destination: i32, base: i32, offset: i32, immediate: i32, condition: string, target: i32 }

pub struct Program { ops: Op[], register_entry: i32, error: string }

struct Address { base: i32, offset: i32 }

function empty(kind: i32): Op {
  return Op { kind: kind, width: 0, source: -1, destination: -1, base: -1, offset: 0, immediate: 0, condition: "", target: -1 };
}

function address(s: string): Address {
  let at = s.index_of("(");
  if (at < 0 || !s.ends_with(")")) {
    return Address { base: -1, offset: 0 };
  }
  let displacement = slice_unchecked(s, 0, at) + "";
  let base = slice_unchecked(s, at + 1, s.len() - 1) + "";
  let reg = registers.reg(base, false, 64);
  if (reg < 0 || displacement != "" && !util.is_decimal_i32(displacement)) {
    return Address { base: -1, offset: 0 };
  }
  return Address { base: reg, offset: if (displacement == "") { 0 } else { util.digits_to_i32(displacement) } };
}

function move(name: string, a: string, b: string): Op {
  let width = if (name == "movq") { 64 } else { if (name == "movl") { 32 } else { 0 } };
  if (width == 0) {
    return empty(0);
  }
  let src = registers.reg(a, false, width);
  let dst = registers.reg(b, false, width);
  let from = address(a);
  let to = address(b);
  if (src >= 0 && dst >= 0) {
    return Op { ...empty(2), width: width, source: src, destination: dst };
  }
  if (from.base >= 0 && dst >= 0) {
    return Op { ...empty(3), width: width, destination: dst, base: from.base, offset: from.offset };
  }
  if (src >= 0 && to.base >= 0) {
    return Op { ...empty(4), width: width, source: src, base: to.base, offset: to.offset };
  }
  return empty(0);
}

function pointer_flags(name: string, a: string, b: string): Op {
  if (name == "testb" && a == "$1" && registers.reg(b, false, 8) >= 0) {
    return Op { ...empty(6), width: 8, source: registers.reg(b, false, 8), immediate: 1 };
  }
  if (name == "cmpq" && (a == "$0x10000" || a == "$65536") && registers.reg(b, false, 64) >= 0) {
    return Op { ...empty(8), width: 64, source: registers.reg(b, false, 64), immediate: 65536 };
  }
  return empty(0);
}

function flags(name: string, a: string, b: string): Op {
  let reg = registers.reg(b, false, 32);
  if (reg < 0) {
    return pointer_flags(name, a, b);
  }
  if (name == "testl" && a == b) {
    return Op { ...empty(5), width: 32, source: reg };
  }
  if (name == "subl" && a == "$1") {
    return Op { ...empty(9), width: 32, source: reg, destination: reg, immediate: 1 };
  }
  if (name == "cmpl" && a.starts_with("$")) {
    let literal = slice_unchecked(a, 1, a.len()) + "";
    if (util.is_decimal_i32(literal)) {
      return Op { ...empty(7), width: 32, source: reg, immediate: util.digits_to_i32(literal) };
    }
  }
  return pointer_flags(name, a, b);
}

function branch(name: string): boolean {
  for candidate in ["jmp", "je", "jz", "jne", "jnz", "js", "jns", "jb", "jc", "jnae", "jae", "jnb", "jnc", "jl", "jnge", "jge", "jnl", "jg", "jnle", "jle", "jng", "jo", "jno"] {
    if (name == candidate) {
      return true;
    }
  }
  return false;
}

function split_at(line: string): i32 {
  let at = 0;
  while (at < line.len()) {
    if (line[at] == b' ' || line[at] == b'\t') {
      return at;
    }
    at = at + 1;
  }
  return -1;
}

function label(line: string): string {
  return if (line.ends_with(":")) { slice_unchecked(line, 0, line.len() - 1) + "" } else { "" };
}

function decode(line: string, labels: names.Names): Op {
  if (label(line) != "") {
    return empty(1);
  }
  if (line == "ret") {
    return empty(11);
  }
  let at = split_at(line);
  if (at < 0) {
    return empty(0);
  }
  let name = slice_unchecked(line, 0, at) + "";
  let rest = util.trim(slice_unchecked(line, at + 1, line.len()) + "");
  if (name == "incl" && rest == "__fern_rc_underflow(%rip)") {
    return Op { ...empty(12), width: 32 };
  }
  if (branch(name)) {
    return Op { ...empty(10), condition: name, target: names.unique_position(labels, rest) };
  }
  // The admitted addressing form has only displacement(base). Commas in
  // indexed addressing therefore make an unsupported instruction, not a
  // partially decoded load with the index silently discarded.
  let args = rest.split(",");
  if (args.len() != 2) {
    return empty(0);
  }
  let a = util.trim(args[0]);
  let b = util.trim(args[1]);
  let moved = move(name, a, b);
  return if (moved.kind > 0) { moved } else { flags(name, a, b) };
}

function failure(error: string): Program {
  return Program { ops: [], register_entry: -1, error: error };
}

// Instruction positions correspond exactly to selected lines, including
// labels. Branches resolve once through a bounded index of this same body.
// Unsupported operations remain kind 0, even in zero/one/free paths. Empty
// error means only selection and branch binding succeeded, never execution.
pub function program(output: string, entry: string): Program {
  let body = text.select(output, entry);
  if (body.error != "") {
    return failure(body.error);
  }
  let definitions: string[] = [];
  for line in body.lines {
    definitions = definitions.append(label(line));
  }
  let labels = names.index(definitions);
  let ops: Op[] = [];
  for line in body.lines {
    let op = decode(line, labels);
    if (op.kind == 10 && op.target < 0) {
      return failure("decrement branch target outside selected body");
    }
    ops = ops.append(op);
  }
  return Program { ops: ops, register_entry: body.register_entry, error: "" };
}
