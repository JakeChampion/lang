// Register arithmetic, instruction dispatch and control flow for both string release proofs.
import "./ssareleasestate" as shared;
pub use "./ssareleasestate".{Word, State, initial, identity, numeric_half, same_word, write, pointer, extent, put};
import "./ssaaffinehalf" as half;
pub use "./ssaaffinehalf".{Half, token, same_half};
import "./ssacondition" as condition;
import "./ssacapacityisa" as isa;
import "./ssastringvalue" as value;

pub function zero(r: value.Interval): half.Half {
  return shared.numeric_half(value.number(r, 0 as i64));
}

pub function numeric(r: value.Interval, v: value.Value): shared.Word {
  if (!value.valid(r, v)) {
    return shared.identity(0, 0);
  }
  let lo = value.lower(r, v);
  let hi = value.upper(r, v);
  let high = if (lo.high == hi.high) { shared.numeric_half(value.number(r, hi.high)) } else { half.Half { kind: 1, identity: 0, part: 1, number: v } };
  return shared.from_halves(shared.numeric_half(v), high);
}

pub function number(r: value.Interval, w: shared.Word, width: i32): value.Value {
  if (w.low.kind != 1 || w.low.part != 0 || !value.valid(r, w.low.number)) {
    return value.unknown();
  }
  if (width == 32) {
    return value.zero32(r, w.low.number);
  }
  return if (shared.same_word(w, numeric(r, w.low.number))) { w.low.number } else { value.unknown() };
}

pub function narrowed(r: value.Interval, w: shared.Word, width: i32): shared.Word {
  return if (width == 32) { shared.from_halves(w.low, zero(r)) } else { w };
}

pub function read(s: shared.State, r: value.Interval, at: i32, width: i32): shared.Word {
  return shared.read(s, at, width, zero(r));
}

pub function arithmetic(s: shared.State, r: value.Interval, op: isa.Op): shared.State {
  let a = number(r, s.regs[op.destination], op.width);
  let b = if (op.source < 0) { value.number(r, op.immediate as i64) } else { number(r, s.regs[op.source], op.width) };
  if (!value.valid(r, b) || b.factor != 0 || b.residue != 0) {
    return shared.State { ...s, ok: false };
  }
  let v = value.add(r, a, if (op.kind == 9) { -b.offset } else { b.offset });
  let result = if (op.width == 32) { value.zero32(r, v) } else { v };
  return shared.write(shared.State { ...s, flags: condition.unknown_flags() }, op.destination, numeric(r, result));
}

pub function positive_signed(r: value.Interval, v: value.Value, width: i32): boolean {
  let high = value.upper(r, v);
  if (!high.valid) {
    return false;
  }
  return if (width == 32) { high.high == 0 && high.low <= 2147483647 as i64 } else { high.high <= 2147483647 as i64 };
}

pub function byte_test(s: shared.State, op: isa.Op): shared.State {
  let w = s.regs[op.source];
  if (!shared.pointer(w, 6) || op.immediate > 7) {
    return shared.State { ...s, flags: condition.unknown_flags() };
  }
  let low = (w.low.identity % 8 + 8) % 8;
  let eq = if ((low & op.immediate) == 0) { 1 } else { 0 };
  let cmp = condition.Comparison { less: 0, equal: eq, less_equal: eq };
  return shared.State { ...s, flags: condition.Flags { order: cmp, signed: cmp, sign: 0 } };
}

pub function shift(s: shared.State, r: value.Interval, op: isa.Op): shared.State {
  let count = op.immediate % op.width;
  if (count == 0) {
    return shared.write(s, op.destination, narrowed(r, s.regs[op.destination], op.width));
  }
  if (op.width != 64 || count != 3) {
    return shared.State { ...s, ok: false };
  }
  return shared.write(shared.State { ...s, flags: condition.unknown_flags() }, op.destination, numeric(r, value.shift_three(r, number(r, s.regs[op.destination], 64))));
}

pub struct Instructions {
  address: (shared.State, value.Interval, isa.Op) => i32,
  heap_store: (shared.State, value.Interval, i32, i32, shared.Word) => shared.State,
  stack_step: (shared.State, value.Interval, isa.Op) => shared.State,
  pointer_lea: (shared.State, isa.Op) => shared.State,
  comparison: (shared.State, value.Interval, isa.Op) => shared.State,
  test: (shared.State, value.Interval, isa.Op) => shared.State,
  dependency_call: (shared.State, value.Interval, i32, isa.Op) => shared.State,
  heap_operation: (shared.State, value.Interval, isa.Op) => shared.State,
}

pub function store(s: shared.State, r: value.Interval, at: i32, width: i32, w: shared.Word, heap_store: (shared.State, value.Interval, i32, i32, shared.Word) => shared.State): shared.State {
  if (at >= 6 && at + width / 32 <= 16) {
    return shared.put(s, at, width, w);
  }
  return heap_store(s, r, at, width, w);
}

function movement(s: shared.State, r: value.Interval, op: isa.Op, ops: Instructions): shared.State {
  return match (op.kind) {
    2 => shared.write(s, op.destination, narrowed(r, s.regs[op.source], op.width)),
    3 => shared.write(s, op.destination, read(s, r, ops.address(s, r, op), op.width)),
    4 => store(s, r, ops.address(s, r, op), op.width, s.regs[op.source], ops.heap_store),
    5 => shared.write(s, op.destination, narrowed(r, numeric(r, value.number(r, op.immediate as i64)), op.width)),
    _ => ops.stack_step(s, r, op),
  };
}

function lea(s: shared.State, r: value.Interval, op: isa.Op, ops: Instructions): shared.State {
  if (op.base < 0 && op.index >= 0 && op.scale == 8) {
    return shared.write(s, op.destination, numeric(r, value.add(r, value.times_eight(r, number(r, s.regs[op.index], 64)), op.offset as i64)));
  }
  if (op.base < 0 || op.index >= 0) {
    return shared.State { ...s, ok: false };
  }
  return ops.pointer_lea(s, op);
}

function extended(s: shared.State, r: value.Interval, pc: i32, op: isa.Op, ops: Instructions): shared.State {
  if (op.kind == 19 && op.symbol == "__fern_freelist" && op.width == 64) {
    return shared.write(s, op.destination, shared.identity(7, 0));
  }
  if (op.kind == 22) {
    return store(s, r, ops.address(s, r, op), op.width, numeric(r, value.number(r, op.immediate as i64)), ops.heap_store);
  }
  if (op.kind == 23 || op.kind == 27) {
    return ops.test(s, r, op);
  }
  if (op.kind == 26) {
    return byte_test(s, op);
  }
  if (op.kind == 21) {
    return shift(s, r, op);
  }
  if (op.kind == 25) {
    return ops.dependency_call(s, r, pc, op);
  }
  return shared.State { ...s, ok: false };
}

function step(s: shared.State, r: value.Interval, pc: i32, op: isa.Op, ops: Instructions): shared.State {
  if (op.kind == 1) {
    return s;
  }
  if (op.kind >= 2 && op.kind <= 7) {
    return movement(s, r, op, ops);
  }
  if (op.kind == 9 || op.kind == 10) {
    return arithmetic(s, r, op);
  }
  if (op.kind == 15) {
    return lea(s, r, op, ops);
  }
  if (op.kind == 16) {
    return ops.comparison(s, r, op);
  }
  if (op.kind >= 28 && op.kind <= 30) {
    return ops.heap_operation(s, r, op);
  }
  return extended(s, r, pc, op, ops);
}

function in_program(p: isa.ArrayProgram, pc: i32): boolean {
  return pc >= 0 && pc < p.ops.len();
}

// Both string representations follow the same control flow; their entry, instruction
// and return checks decide which changes to registers and storage are permitted.
pub function path(p: isa.ArrayProgram, r: value.Interval, register_entry: boolean, s: shared.State, unguarded: (shared.State, shared.State, value.Interval) => shared.State, ops: Instructions, finished: (shared.State, value.Interval, boolean) => boolean): boolean {
  let original = s;
  let visited: boolean[] = [];
  for op in p.ops {
    visited = visited.append(false);
  }
  let pc = if (register_entry) { p.register_entry } else { 0 };
  while (in_program(p, pc)) {
    if (visited[pc]) {
      return false;
    }
    visited = visited.with(pc, true);
    if (register_entry && pc == p.unguarded_entry) {
      s = unguarded(s, original, r);
    }
    let op = p.ops[pc];
    if (op.kind == 18) {
      return s.ok && (!register_entry || visited[p.unguarded_entry]) && finished(s, r, register_entry);
    }
    if (op.kind == 17) {
      let taken = condition.branch(s.flags, op.condition);
      if (taken < 0) {
        return false;
      }
      pc = if (taken == 1) { op.target } else { pc + 1 };
    } else {
      s = step(s, r, pc, op, ops);
      if (!s.ok) {
        return false;
      }
      pc += 1;
    }
  }
  return false;
}
