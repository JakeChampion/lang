import "./ssaboxstate" as machine;
import "./ssamachineword" as machineword;
import "./asmcore";
import "./ssacapacityisa" as isa;
import "./ssaboxroutines" as recbox;
import "./ssaconstructorbound" as boundary;
import "./ssaprepare";

function initial_register(words: i32, register_entry: boolean, i: i32): machineword.Word {
  if (register_entry && i == 0) {
    return machineword.token(9, 0);
  }
  if (register_entry && i == 6 && words == 2) {
    return machineword.token(9, 1);
  }
  return if (i == 4) { machineword.token(2, 0) } else { machineword.token(1, i as i64) };
}

function initial_word(words: i32, register_entry: boolean, i: i32): machineword.Word {
  if (i == 16 || i == 17) {
    return machineword.token(4, 0);
  }
  if (!register_entry && i >= 18 && i < 18 + words * 2) {
    return machineword.token(9, ((i - 18) / 2) as i64);
  }
  return if (i < 22) { machineword.token(5, (i / 2) as i64) } else { machineword.token(6, ((i - 22) / 2) as i64) };
}

function initial(words: i32, register_entry: boolean): machine.State {
  let regs: machineword.Word[] = [];
  let memory: machineword.Half[] = [];
  let writes: i32[] = [];
  let i = 0;
  while (i < 16) {
    regs = regs.append(initial_register(words, register_entry, i));
    i += 1;
  }
  i = 0;
  while (i < 22 + (words + 1) * 2) {
    let w = initial_word(words, register_entry, i);
    memory = memory.append(if (i % 2 == 0) { w.low } else { w.high });
    writes = writes.append(0);
    i += 1;
  }
  return machine.initial_state(regs, memory, writes);
}

function pointer(w: machineword.Word): boolean {
  return (w.low.kind == 2 || w.low.kind == 3) && machineword.equal(w, machineword.token(w.low.kind, w.low.identity));
}

function add(s: machine.State, op: isa.Op): machine.State {
  let w = s.regs[op.destination];
  let delta = if (op.kind == 9) { -(op.immediate as i64) } else { op.immediate as i64 };
  if (op.source >= 0) {
    return machine.State { ...s, ok: false };
  }
  if (pointer(w) && op.width == 64 && delta >= -64 && delta <= 64) {
    let next = w.low.identity + delta;
    return if (next >= -64 && next <= 64) { machine.write(s, op.destination, machine.displaced(w, delta)) } else { machine.State { ...s, ok: false } };
  }
  return machine.numeric_add(s, op.destination, w, delta);
}

function cell(s: machine.State, base: machineword.Word, offset: i32, width: i32): i32 {
  return machine.cell(s, base, offset, width, pointer, cell_extent);
}

function cell_extent(s: machine.State, kind: i32, at: i64, bytes: i32): i32 {
  if (kind == 2 && at >= -64 && at + bytes <= 24) {
    return ((at + 64) / 4) as i32;
  }
  if (kind == 3 && s.calls == 1 && at >= 0 && at + bytes <= ((s.cells.len() - 22) * 4) as i64) {
    return 22 + (at / 4) as i32;
  }
  return -1;
}

function writable(s: machine.State, at: i32): boolean {
  return at >= 0 && at < 16 || s.calls == 1 && at >= 23 && at < s.cells.len();
}

function store_at(s: machine.State, at: i32, width: i32, w: machineword.Word): machine.State {
  return machine.store_at(s, at, width, w, writable, 23);
}

function load_at(s: machine.State, at: i32, width: i32, reg: i32): machine.State {
  if (at < 0 || s.cells[at].kind == 11 || width == 64 && s.cells[at + 1].kind == 11) {
    return machine.State { ...s, ok: false };
  }
  return machine.write(s, reg, machine.load(s, at, width));
}

function stack_step(s: machine.State, op: isa.Op): machine.State {
  let sp = s.regs[4];
  if (!pointer(sp) || sp.low.kind != 2) {
    return machine.State { ...s, ok: false };
  }
  if (op.kind == 6) {
    let next = machine.displaced(sp, -8);
    let stored = store_at(s, cell(s, next, 0, 64), 64, s.regs[op.source]);
    return machine.write(stored, 4, next);
  }
  let advanced = machine.write(s, 4, machine.displaced(sp, 8));
  return load_at(advanced, cell(s, sp, 0, 64), 64, op.destination);
}

// The call gives a box of `words` words with a header of one word below it:
// a count of 1 in the low half and the number of words in the high half. The
// body then stores the tag of the shape over that high half. The helper
// leaves the return address below the stack pointer. The words below it are
// not known: a push of %rcx or of %rdi. __fern_rec_box takes the number of
// words in %rdi and keeps it. The routine of the size takes no argument, and
// %rdi is not known after it.
function allocation(s: machine.State, words: i32, sized: boolean, pc: i32, op: isa.Op): machine.State {
  let named = sized && op.symbol == asmcore.sized_rec_box(words);
  if (s.calls != 0 || !named && (op.symbol != "__fern_rec_box" || !machineword.equal(s.regs[7], machineword.number(words as i64)))) {
    return machine.State { ...s, ok: false };
  }
  let sp = s.regs[4];
  if (!pointer(sp) || sp.low.kind != 2 || sp.low.identity < -40 || sp.low.identity > 0 || sp.low.identity % 8 != 0) {
    return machine.State { ...s, ok: false };
  }
  let called = store_at(s, cell(s, sp, -8, 64), 64, machineword.token(8, (pc + 1) as i64));
  called = store_at(called, cell(called, sp, -16, 64), 64, machineword.token(11, 0));
  let made = machine.write(machine.State { ...called, cells: helper_memory(called.cells, sp, words), calls: 1 }, 0, machineword.token(3, 8));
  return if (named) { machine.write(made, 7, machineword.token(11, 7)) } else { made };
}

function helper_memory(memory: machineword.Half[], sp: machineword.Word, words: i32): machineword.Half[] {
  let i = 0;
  while (i < (sp.low.identity + 48) as i32 / 4) {
    memory = memory.with(i, machineword.half(11, i as i64, false));
    i += 1;
  }
  return memory.with(22, machineword.number(1).low).with(23, machineword.number(words as i64).low);
}

function lea(s: machine.State, op: isa.Op): machine.State {
  let w = s.regs[op.base];
  if (op.index >= 0 || !pointer(w) || op.offset < -64 || op.offset > 64) {
    return machine.State { ...s, ok: false };
  }
  let next = w.low.identity + op.offset as i64;
  return if (next >= -64 && next <= 64) { machine.write(s, op.destination, machine.displaced(w, op.offset as i64)) } else { machine.State { ...s, ok: false } };
}

function simple(s: machine.State, op: isa.Op): machine.State {
  if (op.kind == 1 || op.kind == 31) {
    return s;
  }
  if (op.kind == 2) {
    return machine.write(s, op.destination, machineword.narrowed(s.regs[op.source], op.width));
  }
  if (op.kind == 5) {
    return machine.write(s, op.destination, machineword.narrowed(machineword.number(op.immediate as i64), op.width));
  }
  if (op.kind == 6 || op.kind == 7) {
    return stack_step(s, op);
  }
  return machine.State { ...s, ok: false };
}

function step(s: machine.State, words: i32, sized: boolean, pc: i32, op: isa.Op): machine.State {
  if (op.kind == 3 || op.kind == 4 || op.kind == 22) {
    return machine.memory_step(s, op, cell, load_at, store_at);
  }
  if (op.kind == 9 || op.kind == 10) {
    return add(s, op);
  }
  if (op.kind == 15) {
    return lea(s, op);
  }
  return if (op.kind == 25) { allocation(s, words, sized, pc, op) } else { simple(s, op) };
}

function expected_memory(original: machine.State, tag: i64, i: i32): machineword.Half {
  if (i < 22) {
    return original.cells[i];
  }
  if (i < 24) {
    return if (i == 22) { machineword.number(1).low } else { machineword.number(tag).low };
  }
  let w = machineword.token(9, ((i - 24) / 2) as i64);
  return if (i % 2 == 0) { w.low } else { w.high };
}

// At the return, %rax holds the box and each register that a call keeps has
// its value at the entry. A caller does not read the other registers.
function finished(s: machine.State, words: i32, tag: i64, register_entry: boolean): boolean {
  if (s.calls != 1 || !s.ok) {
    return false;
  }
  let original = initial(words, register_entry);
  if (!machineword.equal(s.regs[0], machineword.token(3, 8))) {
    return false;
  }
  for i in [3, 4, 5, 12, 13, 14, 15] {
    if (!machineword.equal(s.regs[i], original.regs[i])) {
      return false;
    }
  }
  return finished_memory(s, original, tag);
}

function finished_memory(s: machine.State, original: machine.State, tag: i64): boolean {
  for i in 16..s.cells.len() {
    if (!machineword.same(s.cells[i], expected_memory(original, tag, i))) {
      return false;
    }
    if (i >= 23 && s.writes[i] != 1) {
      return false;
    }
  }
  return true;
}

function path(p: isa.ArrayProgram, words: i32, sized: boolean, tag: i64, register_entry: boolean): boolean {
  let s = initial(words, register_entry);
  let visited: boolean[] = [];
  for op in p.ops {
    visited = visited.append(false);
  }
  let pc = if (register_entry) { p.register_entry } else { 0 };
  while (pc >= 0 && pc < p.ops.len()) {
    if (visited[pc]) {
      return false;
    }
    visited = visited.with(pc, true);
    let op = p.ops[pc];
    if (op.kind == 18) {
      return finished(s, words, tag, register_entry);
    }
    if (op.kind == 17) {
      if (op.condition != "jmp") {
        return false;
      }
      pc = op.target;
    } else {
      s = step(s, words, sized, pc, op);
      if (!s.ok) {
        return false;
      }
      pc += 1;
    }
  }
  return false;
}

pub function check(output: ssaprepare.Output, name: string): boolean {
  let bound = boundary.resolve(output, name);
  if (bound.error != "" || !recbox.allocation(output.text)) {
    return false;
  }
  let p = isa.constructor_program(output.text, "__fn_" + asmcore.sanitize_label(name));
  let sized = recbox.sized_allocation(output.text, bound.words);
  return p.error == "" && path(p, bound.words, sized, bound.tag, false) && path(p, bound.words, sized, bound.tag, true);
}
