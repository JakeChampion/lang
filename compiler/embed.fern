import "./ast";
import "./astwalk";
import "./parser";
import "./util";
import "std/utf8";

pub struct Assets { root: string, names: string[], contents: u8[][], present: boolean }

pub function no_assets(): Assets {
  return Assets { root: "", names: [], contents: [], present: false };
}

pub struct LoadResult { assets: Assets, err: string }

const ENTRY_OTHER: i32 = 0;

const ENTRY_DIR: i32 = 1;

const ENTRY_FILE: i32 = 2;

pub function load(dir: string): LoadResult {
  let root_dir: boolean = false;
  match (stat(dir)) {
    Ok(st) => {
      root_dir = st.is_dir;
    },
    Err(e) => {}
  }
  if (!root_dir) {
    return LoadResult { assets: no_assets(), err: "-embed " + dir + ": not a directory" };
  }
  let names: string[] = [];
  let contents: u8[][] = [];
  let rels: string[] = [""];
  let ri: i32 = 0;
  while (ri < rels.len()) {
    let rel: string = rels[ri];
    ri = ri + 1;
    let sdir: string = dir;
    if (rel.len() > 0) {
      sdir = dir + "/" + rel;
    }
    let entries: string[] = [];
    let listed: boolean = false;
    match (read_dir(sdir)) {
      Ok(ns) => {
        entries = ns;
        listed = true;
      },
      Err(e) => {}
    }
    if (!listed) {
      continue;
    }
    let i: i32 = 0;
    while (i < entries.len()) {
      let name: string = entries[i];
      i = i + 1;
      let child_rel: string = name + "";
      if (rel.len() > 0) {
        child_rel = rel + "/" + name;
      }
      let child: string = dir + "/" + child_rel;
      let kind: i32 = classify(child);
      if (kind == ENTRY_DIR) {
        rels = rels.append(child_rel + "");
        continue;
      }
      if (kind != ENTRY_FILE) {
        continue;
      }
      if (!utf8.is_valid_utf8(child_rel)) {
        return LoadResult { assets: no_assets(), err: "-embed " + dir + ": file name \"" + utf8.from_bytes_lossy(child_rel.bytes()) + "\" is not valid UTF-8" };
      }
      let body: u8[] = [];
      let read_ok: boolean = false;
      match (read_file_bytes(child)) {
        Ok(bs) => {
          body = bs;
          read_ok = true;
        },
        Err(e) => {}
      }
      if (!read_ok) {
        return LoadResult { assets: no_assets(), err: "-embed " + dir + ": cannot read " + child_rel };
      }
      names = names.append(child_rel + "");
      contents = contents.append(body);
    }
  }
  let (sn, sc) = sort_pairs(names, contents);
  return LoadResult { assets: Assets { root: dir, names: sn, contents: sc, present: true }, err: "" };
}

function classify(path: string): i32 {
  match (lstat(path)) {
    Ok(st) => {
      if (st.is_dir) {
        return ENTRY_DIR;
      }
      if (st.is_file) {
        return ENTRY_FILE;
      }
      return ENTRY_OTHER;
    },
    Err(e) => {
      return ENTRY_OTHER;
    }
  }
  return ENTRY_OTHER;
}

function sort_pairs(names: string[], contents: u8[][]): (string[], u8[][]) {
  let on: string[] = [];
  let oc: u8[][] = [];
  let i: i32 = 0;
  while (i < names.len()) {
    let pos: i32 = 0;
    while (pos < on.len() && util.str_less(on[pos], names[i])) {
      pos = pos + 1;
    }
    let nn: string[] = [];
    let nc: u8[][] = [];
    let j: i32 = 0;
    while (j < pos) {
      nn = nn.append(on[j]);
      nc = nc.append(oc[j]);
      j = j + 1;
    }
    nn = nn.append(names[i]);
    nc = nc.append(contents[i]);
    while (j < on.len()) {
      nn = nn.append(on[j]);
      nc = nc.append(oc[j]);
      j = j + 1;
    }
    on = nn;
    oc = nc;
    i = i + 1;
  }
  return (on, oc);
}

pub function lookup(a: Assets, name: string): i32 {
  return util.index_of_str(a.names, name);
}

function common_affix(a: string, b: string): i32 {
  let n: i32 = a.len();
  if (b.len() < n) {
    n = b.len();
  }
  let pre: i32 = 0;
  while (pre < n && a[pre] == b[pre]) {
    pre = pre + 1;
  }
  let suf: i32 = 0;
  while (suf < n && a[a.len() - 1 - suf] == b[b.len() - 1 - suf]) {
    suf = suf + 1;
  }
  if (suf > pre) {
    return suf;
  }
  return pre;
}

pub function suggest(a: Assets, want: string): string {
  let best: string = "";
  let best_score: i32 = 0;
  let i: i32 = 0;
  while (i < a.names.len()) {
    let score: i32 = common_affix(a.names[i], want);
    if (score > best_score) {
      best_score = score;
      best = a.names[i];
    }
    i = i + 1;
  }
  if (best_score * 3 < want.len()) {
    return "";
  }
  return best;
}

pub function format_available(a: Assets): string {
  if (a.names.len() == 0) {
    return "no assets were embedded";
  }
  let shown: i32 = a.names.len();
  if (shown > 10) {
    shown = 10;
  }
  let out: string = "embedded assets: ";
  let i: i32 = 0;
  while (i < shown) {
    if (i > 0) {
      out = out + ", ";
    }
    out = out + a.names[i];
    i = i + 1;
  }
  if (a.names.len() > shown) {
    out = out + " (and " + util.i32_to_string(a.names.len() - shown) + " more)";
  }
  return out;
}

const ASSET_ONE: string = "__fern_asset";

const ASSET_ONE_BYTES: string = "__fern_asset_bytes";

const ASSET_ALL: string = "__fern_assets";

const ASSET_ALL_BYTES: string = "__fern_assets_bytes";

pub struct Folded { module: parser.Module, errs: string[] }

struct FoldAcc { assets: Assets, errs: string[] }

pub function fold_assets(mod: parser.Module, assets: Assets): Folded {
  let acc: FoldAcc = FoldAcc { assets: assets, errs: [] };
  let funcs: parser.FuncDecl[] = [];
  for fd in mod.funcs {
    let (body, a2) = astwalk.map_stmts_acc(fd.body, acc, fa_keep_stmt, fa_expr);
    acc = a2;
    funcs = funcs.append(parser.FuncDecl { ...fd, body: body });
  }
  let (tops, a3) = astwalk.map_stmts_acc(mod.top_stmts, acc, fa_keep_stmt, fa_expr);
  acc = a3;
  return Folded { module: parser.Module { ...mod, funcs: funcs, top_stmts: tops }, errs: acc.errs };
}

function fa_keep_stmt(s: ast.Stmt, a: FoldAcc): (ast.Stmt, FoldAcc, boolean) {
  return (s, a, false);
}

function fa_expr(e: ast.Expr, a: FoldAcc): (ast.Expr, FoldAcc, boolean) {
  match (e) {
    ast.ExprCall(c) => {
      let name: string = callee_ident(c.callee);
      if (name == ASSET_ALL || name == ASSET_ALL_BYTES) {
        return resolve_all(c, a, name);
      }
      if (name == ASSET_ONE || name == ASSET_ONE_BYTES) {
        return resolve_one(c, a, name);
      }
      return (e, a, false);
    },
    _ => {
      return (e, a, false);
    }
  }
  return (e, a, false);
}

function callee_ident(callee: ast.Expr): string {
  match (callee) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function at(line: i32, col: i32): string {
  return util.i32_to_string(line) + ":" + util.i32_to_string(col) + ": ";
}

function fail(c: ast.ExprCall, a: FoldAcc, msg: string): (ast.Expr, FoldAcc, boolean) {
  return (ast.ExprCall { ...c }, FoldAcc { ...a, errs: a.errs.append(msg) }, true);
}

function is_bytes_form(name: string): boolean {
  return name == ASSET_ONE_BYTES || name == ASSET_ALL_BYTES;
}

struct Content { lit: ast.Expr, err: string }

function content(c: ast.ExprCall, a: Assets, idx: i32, name: string): Content {
  let bs: u8[] = a.contents[idx];
  if (is_bytes_form(name)) {
    return Content { lit: bytes_literal(bs, c.line, c.col), err: "" };
  }
  match (utf8.from_bytes(bs)) {
    Some(text) => {
      return Content { lit: ast.ExprString { value: text, line: c.line, col: c.col }, err: "" };
    },
    None => {}
  }
  let msg: string = at(c.line, c.col) + name + ": embedded asset \"" + a.names[idx] + "\" under " + a.root;
  return Content { lit: ast.ExprCall { ...c }, err: msg + " is not valid UTF-8 — read it as u8[] with " + name + "_bytes" };
}

function bytes_literal(bs: u8[], line: i32, col: i32): ast.Expr {
  return ast.ExprBytes { value: bs, line: line, col: col };
}

function resolve_one(c: ast.ExprCall, a: FoldAcc, name: string): (ast.Expr, FoldAcc, boolean) {
  if (c.args.len() != 1) {
    return fail(c, a, at(c.line, c.col) + name + " takes exactly one argument, got " + util.i32_to_string(c.args.len()));
  }
  let lit: string = "";
  let is_lit: boolean = false;
  match (c.args[0]) {
    ast.ExprString(s) => {
      lit = s.value;
      is_lit = true;
    },
    _ => {}
  }
  if (!is_lit) {
    return fail(c, a, at(c.line, c.col) + name + " needs a string literal — assets are resolved at compile time, so the name cannot be computed");
  }
  if (!a.assets.present) {
    return fail(c, a, at(c.line, c.col) + name + "(\"" + lit + "\") but no assets were embedded — pass -embed DIR to the compiler");
  }
  let idx: i32 = lookup(a.assets, lit);
  if (idx < 0) {
    let msg: string = at(c.line, c.col) + "no embedded asset \"" + lit + "\" under " + a.assets.root;
    let did: string = suggest(a.assets, lit);
    if (did.len() > 0) {
      return fail(c, a, msg + "; did you mean \"" + did + "\"?");
    }
    return fail(c, a, msg + " (" + format_available(a.assets) + ")");
  }
  let got: Content = content(c, a.assets, idx, name);
  if (got.err.len() > 0) {
    return fail(c, a, got.err);
  }
  return (got.lit, a, true);
}

function resolve_all(c: ast.ExprCall, a: FoldAcc, name: string): (ast.Expr, FoldAcc, boolean) {
  if (c.args.len() != 0) {
    return fail(c, a, at(c.line, c.col) + name + " takes no arguments, got " + util.i32_to_string(c.args.len()));
  }
  if (!a.assets.present) {
    return fail(c, a, at(c.line, c.col) + name + "() but no assets were embedded — pass -embed DIR to the compiler");
  }
  let elems: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < a.assets.names.len()) {
    let got: Content = content(c, a.assets, i, name);
    if (got.err.len() > 0) {
      return fail(c, a, got.err);
    }
    let pair: ast.Expr[] = [];
    pair = pair.append(ast.ExprString { value: a.assets.names[i], line: c.line, col: c.col });
    pair = pair.append(got.lit);
    elems = elems.append(ast.ExprTuple { elements: pair, line: c.line, col: c.col });
    i = i + 1;
  }
  let elem_ty: string = "(string, string)";
  if (is_bytes_form(name)) {
    elem_ty = "(string, u8[])";
  }
  return (ast.ExprArray { elements: elems, elem_ty: elem_ty, line: c.line, col: c.col }, a, true);
}
