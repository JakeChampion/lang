import "./ssastringstate" as machine;
import "./ssacondition" as condition;
import "./ssacapacityisa" as isa;
import "./ssastringvalue" as value;
import "./ssacapacitymachine" as capacity;
import "./ssalargepushwidemachine" as large;

function initial(r: value.Interval, register_entry: boolean, family: i32): machine.State {
  let regs: machine.Word[] = [];
  let i = 0;
  while (i < 16) {
    regs = regs.append(if (i == 4) { machine.identity(3, 0) } else { machine.identity(2, i) });
    i += 1;
  }
  if (register_entry) {
    regs = regs.with(0, machine.identity(6, 0));
  }
  let length = family_length(r, family);
  let cells = [machine.numeric_half(value.number(r, 1 as i64)), machine.token(15, 0, 0), machine.token(11, 0, 0), machine.token(11, 0, 1), length.low, length.high];
  for i in 6..16 {
    cells = cells.append(machine.token(5, i, 0));
  }
  cells = cells.append(machine.token(4, 0, 0)).append(machine.token(4, 0, 1));
  let argument = if (register_entry) { machine.identity(5, 18) } else { machine.identity(6, 0) };
  cells = cells.append(argument.low).append(argument.high).append(machine.token(8, 0, 0)).append(machine.token(8, 0, 1));
  cells = cells.append(machine.token(8, 1, 0)).append(machine.token(8, 1, 1));
  cells = cells.append(machine.token(5, 24, 0)).append(machine.token(5, 24, 1));
  cells = cells.append(machine.token(12, 0, 0)).append(machine.token(12, 0, 1));
  cells = cells.append(machine.token(13, 0, 0)).append(machine.token(13, 0, 1));
  return machine.State { regs: regs, cells: cells, flags: condition.unknown_flags(), ok: true, zeros: 0, links: 0, slots: 0, call_return: -1, grown: false, family: family, buffer_links: 0, buffer_slots: 0 };
}

function simple_address(w: machine.Word, offset: i32, width: i32): i32 {
  let at = w.low.identity as i64 + offset as i64;
  if (machine.pointer(w, 3) && machine.extent(at, -40, 16, width)) {
    return 6 + (at as i32 + 40) / 4;
  }
  if (machine.pointer(w, 6) && machine.extent(at, -8, 16, width)) {
    return (at as i32 + 8) / 4;
  }
  if (machine.pointer(w, 7) && machine.extent(at, 24, 32, width)) {
    return 20 + (at as i32 - 24) / 4;
  }
  return -1;
}

function address(s: machine.State, r: value.Interval, op: isa.Op): i32 {
  if (op.base < 0) {
    return -1;
  }
  let w = s.regs[op.base];
  if (op.index < 0) {
    if (s.family == 4 && machine.same_word(w, machine.identity(11, 0)) && machine.extent(op.offset as i64, 0, 8, op.width)) {
      return 24 + op.offset / 4;
    }
    return simple_address(w, op.offset, op.width);
  }
  return indexed_slot(s, r, op, w);
}

function indexed_slot(s: machine.State, r: value.Interval, op: isa.Op, w: machine.Word): i32 {
  if (s.family != 4 || !machine.same_word(w, machine.identity(7, 0)) || op.scale != 8 || !machine.extent(op.offset as i64, 0, 8, op.width)) {
    return -1;
  }
  if (value.expected_class(r, false) != -3) {
    return -1;
  }
  return if (machine.same_word(s.regs[op.index], machine.numeric(r, value.expected_small(r, false)))) { buffer_slot(r) + op.offset / 4 } else { -1 };
}

function store(s: machine.State, r: value.Interval, at: i32, width: i32, w: machine.Word): machine.State {
  if (at >= 6 && at + width / 32 <= 16) {
    return machine.put(s, at, width, w);
  }
  return heap_store(s, r, at, width, w);
}

function heap_store(s: machine.State, r: value.Interval, at: i32, width: i32, w: machine.Word): machine.State {
  if (at == 0 && width == 32 && s.zeros == 0 && s.links == 0 && buffer_done(s, r) && machine.same_half(w.low, machine.zero(r))) {
    return machine.put(machine.State { ...s, zeros: 1 }, at, width, w);
  }
  if (width != 64) {
    return machine.State { ...s, ok: false };
  }
  return if (s.zeros == 1) { link_store(s, r, at, w) } else { buffer_store(s, r, at, w) };
}

function buffer_store(s: machine.State, r: value.Interval, at: i32, w: machine.Word): machine.State {
  if (s.family != 4 || value.expected_class(r, false) != -3) {
    return machine.State { ...s, ok: false };
  }
  if (at == 24 && s.buffer_links == 0 && machine.same_word(w, buffer_head(r))) {
    return machine.put(machine.State { ...s, buffer_links: 1 }, at, 64, w);
  }
  if (at == buffer_slot(r) && s.buffer_slots == 0 && machine.same_word(w, machine.identity(11, 0))) {
    return machine.put(machine.State { ...s, buffer_slots: 1 }, at, 64, w);
  }
  return machine.State { ...s, ok: false };
}

function link_store(s: machine.State, r: value.Interval, at: i32, w: machine.Word): machine.State {
  if (at == 0 && s.links == 0 && machine.same_word(w, box_head(s, r))) {
    return machine.put(machine.State { ...s, links: 1 }, at, 64, w);
  }
  if (at == 20 && s.slots == 0 && machine.same_word(w, machine.identity(6, -8))) {
    return machine.put(machine.State { ...s, slots: 1 }, at, 64, w);
  }
  return machine.State { ...s, ok: false };
}

function stack_step(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  if (!machine.pointer(s.regs[4], 3)) {
    return machine.State { ...s, ok: false };
  }
  let sp = s.regs[4].low.identity;
  if (op.kind == 6) {
    let saved = s.regs[op.source];
    let at = simple_address(s.regs[4], -8, 64);
    return machine.write(store(s, r, at, 64, saved), 4, machine.identity(3, sp - 8));
  }
  if (op.destination == 4) {
    return machine.State { ...s, ok: false };
  }
  let loaded = machine.read(s, r, simple_address(s.regs[4], 0, 64), 64);
  return machine.write(machine.write(s, 4, machine.identity(3, sp + 8)), op.destination, loaded);
}

function movement(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  return match (op.kind) {
    2 => machine.write(s, op.destination, machine.narrowed(r, s.regs[op.source], op.width)),
    3 => machine.write(s, op.destination, machine.read(s, r, address(s, r, op), op.width)),
    4 => store(s, r, address(s, r, op), op.width, s.regs[op.source]),
    5 => machine.write(s, op.destination, machine.narrowed(r, machine.numeric(r, value.number(r, op.immediate as i64)), op.width)),
    _ => stack_step(s, r, op),
  };
}

function lea(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  if (op.base < 0 && op.index >= 0 && op.scale == 8) {
    return machine.write(s, op.destination, machine.numeric(r, value.add(r, value.times_eight(r, machine.number(r, s.regs[op.index], 64)), op.offset as i64)));
  }
  if (op.base < 0 || op.index >= 0) {
    return machine.State { ...s, ok: false };
  }
  return pointer_lea(s, op);
}

function pointer_lea(s: machine.State, op: isa.Op): machine.State {
  let w = s.regs[op.base];
  let at = w.low.identity as i64 + op.offset as i64;
  if (machine.pointer(w, 6) && at >= -(8 as i64) && at <= 16 as i64) {
    return machine.write(s, op.destination, machine.identity(6, at as i32));
  }
  if (machine.pointer(w, 3) && at >= -(40 as i64) && at <= 8 as i64) {
    return machine.write(s, op.destination, machine.identity(3, at as i32));
  }
  return machine.State { ...s, ok: false };
}

function comparison(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  let w = s.regs[op.source];
  if (machine.same_half(w.low, machine.token(15, 0, 0))) {
    return machine.State { ...s, flags: shape_comparison(r, w, op) };
  }
  if (op.width == 64 && machine.same_word(w, machine.identity(6, 0)) && op.immediate == 65536) {
    return machine.State { ...s, flags: condition.Flags { order: condition.Comparison { less: 0, equal: -1, less_equal: -1 }, signed: condition.unknown_order(), sign: -1 } };
  }
  let v = machine.number(r, w, op.width);
  if (!value.valid(r, v) || op.immediate < 0) {
    return machine.State { ...s, flags: condition.unknown_flags() };
  }
  let order = value.compare(r, v, op.immediate as i64);
  let signed = if (machine.positive_signed(r, v, op.width)) { order } else { condition.unknown_order() };
  return machine.State { ...s, flags: condition.Flags { order: order, signed: signed, sign: signed.less } };
}

function shape_comparison(r: value.Interval, w: machine.Word, op: isa.Op): condition.Flags {
  if (op.width != 32 && !machine.same_half(w.high, machine.zero(r))) {
    return condition.unknown_flags();
  }
  if (op.immediate != 1112494674 && op.immediate != 1934589965 && op.immediate != 1196576599) {
    return condition.unknown_flags();
  }
  let different = condition.Comparison { less: -1, equal: 0, less_equal: -1 };
  return condition.Flags { order: different, signed: different, sign: -1 };
}

function test(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  let input = s.regs[op.source];
  if (op.width == 64 && machine.same_word(input, machine.identity(14, 0))) {
    return machine.State { ...s, flags: condition.Flags { order: condition.Comparison { less: 0, equal: 0, less_equal: 0 }, signed: condition.Comparison { less: 1, equal: 0, less_equal: 1 }, sign: 1 } };
  }
  let v = machine.number(r, input, op.width);
  if (!machine.positive_signed(r, v, op.width)) {
    return machine.State { ...s, flags: condition.unknown_flags() };
  }
  let cmp = value.compare(r, v, 0 as i64);
  return machine.State { ...s, flags: condition.Flags { order: condition.Comparison { less: 0, equal: cmp.equal, less_equal: cmp.equal }, signed: cmp, sign: 0 } };
}

function words(r: value.Interval): value.Value {
  return value.words(r);
}

function bytes(r: value.Interval): value.Value {
  return value.times_eight(r, words(r));
}

function dependency_call(s: machine.State, r: value.Interval, pc: i32, op: isa.Op): machine.State {
  if (s.family != 4 || s.call_return >= 0 || s.zeros != 0 || s.buffer_links != 0 || s.buffer_slots != 0) {
    return machine.State { ...s, ok: false };
  }
  return if (op.symbol == "__fern_capw") { capacity_call(s, r, pc) } else { large_call(s, r, pc, op) };
}

function capacity_call(s: machine.State, r: value.Interval, pc: i32): machine.State {
  if (value.expected_class(r, false) != -3 || !machine.same_word(s.regs[4], machine.identity(3, -8)) || !machine.same_word(machine.read(s, r, 14, 64), machine.numeric(r, words(r)))) {
    return machine.State { ...s, ok: false };
  }
  let next = pc + 1;
  let called = machine.put(s, 12, 64, machine.identity(9, next));
  called = machine.put(called, 10, 64, s.regs[0]);
  called = machine.put(called, 8, 64, s.regs[1]);
  called = machine.put(called, 6, 64, s.regs[2]);
  called = machine.put(called, 14, 64, machine.numeric(r, value.expected_small(r, false)));
  return machine.State { ...called, call_return: next, flags: condition.unknown_flags() };
}

function large_call(s: machine.State, r: value.Interval, pc: i32, op: isa.Op): machine.State {
  if (op.symbol != "__fern_large_push" || !machine.same_word(s.regs[4], machine.identity(3, -8)) || !machine.same_word(s.regs[8], machine.identity(11, 0)) || !machine.same_word(s.regs[6], machine.numeric(r, bytes(r)))) {
    return machine.State { ...s, ok: false };
  }
  let class = value.expected_class(r, false);
  if (class == -3 || class == -1) {
    return machine.State { ...s, ok: false };
  }
  let called = machine.put(s, 12, 64, machine.identity(9, pc + 1));
  if (class >= 0) {
    let old = machine.read(s, r, 22, 64);
    called = machine.put(called, 24, 64, old);
    called = machine.put(called, 22, 64, machine.identity(11, 0));
    called = machine.write(called, 0, machine.numeric(r, value.number(r, class as i64)));
    called = machine.write(machine.write(called, 1, old), 2, machine.identity(10, 0));
    called = machine.State { ...called, buffer_links: 1, buffer_slots: 1 };
  }
  return machine.State { ...called, call_return: pc + 1, flags: condition.unknown_flags() };
}

function extended(s: machine.State, r: value.Interval, pc: i32, op: isa.Op): machine.State {
  if (op.kind == 19 && op.symbol == "__fern_freelist" && op.width == 64) {
    return machine.write(s, op.destination, machine.identity(7, 0));
  }
  if (op.kind == 22) {
    return store(s, r, address(s, r, op), op.width, machine.numeric(r, value.number(r, op.immediate as i64)));
  }
  if (op.kind == 23 || op.kind == 27) {
    return test(s, r, op);
  }
  if (op.kind == 26) {
    return machine.byte_test(s, op);
  }
  if (op.kind == 21) {
    return machine.shift(s, r, op);
  }
  if (op.kind == 25) {
    return dependency_call(s, r, pc, op);
  }
  return machine.State { ...s, ok: false };
}

function step(s: machine.State, r: value.Interval, pc: i32, op: isa.Op): machine.State {
  if (op.kind == 1) {
    return s;
  }
  if (op.kind >= 2 && op.kind <= 7) {
    return movement(s, r, op);
  }
  if (op.kind == 9 || op.kind == 10) {
    return machine.arithmetic(s, r, op);
  }
  if (op.kind == 15) {
    return lea(s, r, op);
  }
  if (op.kind == 16) {
    return comparison(s, r, op);
  }
  if (op.kind >= 28 && op.kind <= 30) {
    return heap_operation(s, r, op);
  }
  return extended(s, r, pc, op);
}

function expected_register(s: machine.State, r: value.Interval, reg: i32): machine.Word {
  return match (reg) {
    0 => machine.identity(6, 0),
    1 => if (s.family == 4 && value.expected_class(r, false) >= 0) { machine.identity(8, 1) } else { machine.identity(11, 0) },
    2 => machine.identity(6, -8),
    4 => machine.identity(3, 0),
    6 => box_head(s, r),
    8 => machine.identity(7, 0),
    _ => machine.identity(2, reg),
  };
}

function expected_scratch(s: machine.State, r: value.Interval): machine.Half[] {
  let expected = initial(r, false, s.family);
  if (s.family != 4 || r.high <= 256 as i64) {
    return expected.cells;
  }
  expected = machine.put(expected, 12, 64, machine.identity(9, s.call_return));
  if (value.expected_class(r, false) != -3) {
    return machine.put(expected, 14, 64, machine.identity(6, 0)).cells;
  }
  expected = machine.put(expected, 6, 64, machine.numeric(r, words(r)));
  expected = machine.put(expected, 8, 64, machine.identity(11, 0));
  expected = machine.put(expected, 10, 64, machine.identity(6, 0));
  return machine.put(expected, 14, 64, machine.numeric(r, value.expected_small(r, false))).cells;
}

function final_registers(s: machine.State, r: value.Interval): boolean {
  for i in 0..16 {
    if (!machine.same_word(s.regs[i], expected_register(s, r, i))) {
      return false;
    }
  }
  return true;
}

function final_counts(s: machine.State, r: value.Interval): boolean {
  let called = s.family == 4 && r.low > 256 as i64;
  return s.zeros == 1 && s.links == 1 && s.slots == 1 && buffer_done(s, r) && called == s.call_return >= 0;
}

function expected_memory(s: machine.State, r: value.Interval, register_entry: boolean): machine.State {
  let expected = initial(r, register_entry, s.family);
  expected = machine.put(expected, 0, 64, box_head(s, r));
  if (s.family == 4 && value.expected_class(r, false) != -2) {
    expected = machine.put(expected, 24, 64, buffer_head(r));
    expected = machine.put(expected, buffer_slot(r), 64, machine.identity(11, 0));
  }
  return machine.put(expected, 20, 64, machine.identity(6, -8));
}

function finished(s: machine.State, r: value.Interval, register_entry: boolean): boolean {
  if (!final_counts(s, r) || !final_registers(s, r)) {
    return false;
  }
  let expected = expected_memory(s, r, register_entry);
  let scratch = expected_scratch(s, r);
  for i in 0..30 {
    let wanted = if (i >= 6 && i < 16) { scratch[i] } else { expected.cells[i] };
    if (!machine.same_half(s.cells[i], wanted)) {
      return false;
    }
  }
  return true;
}

function unguarded(s: machine.State, original: machine.State, r: value.Interval): machine.State {
  let regs = s.regs;
  let i = 0;
  while (i < regs.len()) {
    if (!machine.same_word(regs[i], original.regs[i])) {
      if (i == 0 || machine.same_word(expected_register(s, r, i), machine.identity(2, i))) {
        return machine.State { ...s, ok: false };
      }
      regs = regs.with(i, original.regs[i]);
    }
    i += 1;
  }
  for i in 0..s.cells.len() {
    if (!machine.same_half(s.cells[i], original.cells[i])) {
      return machine.State { ...s, ok: false };
    }
  }
  return machine.State { ...s, regs: regs, flags: condition.unknown_flags(), ok: s.ok && s.zeros == 0 && s.links == 0 && s.slots == 0 && s.call_return == -1 && s.buffer_links == 0 && s.buffer_slots == 0 };
}

function path(p: isa.ArrayProgram, r: value.Interval, register_entry: boolean, family: i32): boolean {
  return machine.path(p, r, register_entry, initial(r, register_entry, family), unguarded, step, finished);
}

pub function check(output: string): boolean {
  let p = isa.string_program(output);
  if (p.error != "" || p.register_entry < 0 || p.unguarded_entry < 0 || !capacity.check(output) || !large.check(output)) {
    return false;
  }
  let fixed = value.Interval { low: 1 as i64, high: 1 as i64, min_residue: 0, max_residue: 7 };
  for family in 0..4 {
    if (!both_entries(p, fixed, family)) {
      return false;
    }
  }
  for r in value.intervals(false) {
    if (!positive_interval(p, r)) {
      return false;
    }
  }
  return true;
}

function both_entries(p: isa.ArrayProgram, r: value.Interval, family: i32): boolean {
  return path(p, r, false, family) && path(p, r, true, family);
}

function positive_interval(p: isa.ArrayProgram, r: value.Interval): boolean {
  if (r.low > 3 as i64 || r.high < 3 as i64) {
    return both_entries(p, r, 4);
  }
  return both_entries(p, value.Interval { ...r, high: 2 as i64 }, 4) && both_entries(p, value.Interval { ...r, low: 3 as i64, high: 3 as i64 }, 4) && both_entries(p, value.Interval { ...r, low: 4 as i64 }, 4);
}

function family_length(r: value.Interval, family: i32): machine.Word {
  if (family == 4) {
    return machine.numeric(r, value.length(r));
  }
  if (family == 2) {
    return machine.numeric(r, value.number(r, 0 as i64));
  }
  return if (family == 3) { machine.identity(14, 0) } else { machine.identity(5, 4) };
}

function shared_slot(r: value.Interval): boolean {
  return r.low == 3 as i64 && r.high == 3 as i64;
}

function buffer_slot(r: value.Interval): i32 {
  return if (shared_slot(r)) { 20 } else { 22 };
}

function buffer_head(r: value.Interval): machine.Word {
  return machine.identity(8, if (shared_slot(r)) { 0 } else { 1 });
}

function box_head(s: machine.State, r: value.Interval): machine.Word {
  return if (s.family == 4 && shared_slot(r)) { machine.identity(11, 0) } else { machine.identity(8, 0) };
}

function buffer_done(s: machine.State, r: value.Interval): boolean {
  let recycled = if (s.family == 4 && value.expected_class(r, false) != -2) { 1 } else { 0 };
  return s.buffer_links == recycled && s.buffer_slots == recycled;
}

function heap_operation(s: machine.State, r: value.Interval, op: isa.Op): machine.State {
  if (op.kind == 29) {
    let at = if (op.symbol == "__fern_heap_base") { 26 } else { 28 };
    return machine.write(s, op.destination, machine.read(s, r, at, op.width));
  }
  let left = if (op.kind == 28) { s.regs[op.destination] } else { s.regs[op.source] };
  let right = if (op.kind == 28) { s.regs[op.source] } else { machine.identity(if (op.symbol == "__fern_heap_base") { 12 } else { 13 }, 0) };
  if (op.width != 64 || !machine.same_word(left, machine.identity(11, 0))) {
    return machine.State { ...s, flags: condition.unknown_flags() };
  }
  return heap_comparison(s, right);
}

function heap_comparison(s: machine.State, right: machine.Word): machine.State {
  let less = -1;
  if (machine.same_word(right, machine.identity(12, 0))) {
    less = if (s.family == 0) { 1 } else { 0 };
  }
  if (machine.same_word(right, machine.identity(13, 0))) {
    less = if (s.family == 1) { 0 } else { 1 };
  }
  return machine.State { ...s, flags: condition.Flags { order: condition.Comparison { less: less, equal: -1, less_equal: -1 }, signed: condition.unknown_order(), sign: -1 } };
}
