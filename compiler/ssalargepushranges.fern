import "core/cmp";

pub struct Interval { low: i32, high: i32 }

pub function valid(r: Interval): boolean {
  return r.low >= 0 && r.low <= r.high && r.high <= 1073741824;
}

pub function capacities(): i32[] {
  let result: i32[] = [];
  let quarter = 131072;
  for index in 0..45 {
    result = result.append((4 + index % 4) * quarter);
    if (index % 4 == 3) {
      quarter *= 2;
    }
  }
  return result;
}

function class_at(n: i32, bins: i32[]): i32 {
  for at in 0..bins.len() {
    if (n <= bins[at]) {
      return at;
    }
  }
  return -1;
}

pub function expected_class(r: Interval): i32 {
  if (!valid(r)) {
    return -1;
  }
  let bins = capacities();
  let low = class_at(r.low, bins);
  return if (low == class_at(r.high, bins)) { low } else { -1 };
}

pub function intervals(): Interval[] {
  let result: Interval[] = [];
  let low = 0;
  for cap in capacities() {
    let cut = 524288 as i64;
    while (cut <= cap as i64) {
      if (cut > low as i64) {
        result = result.append(Interval { low: low, high: cut as i32 - 1 });
        low = cut as i32;
      }
      cut *= 2 as i64;
    }
    result = result.append(Interval { low: low, high: cap });
    low = cap + 1;
  }
  return result;
}

function highest(n: i64): i32 {
  let rest = n;
  let bit = -1;
  while (rest > 0) {
    rest /= 2 as i64;
    bit += 1;
  }
  return bit;
}

pub function rounded(r: Interval): i64 {
  if (!valid(r)) {
    return -(1 as i64);
  }
  let low = cmp.max(r.low, 524288) as i64;
  let high = cmp.max(r.high, 524288) as i64;
  let bit = highest(low);
  if (bit != highest(high)) {
    return -(1 as i64);
  }
  let quantum = 131072 as i64;
  for at in 19..bit {
    quantum *= 2 as i64;
  }
  let a = ((low - 1 as i64) / quantum + 1 as i64) * quantum;
  let b = ((high - 1 as i64) / quantum + 1 as i64) * quantum;
  return if (a == b) { a } else { -(1 as i64) };
}
