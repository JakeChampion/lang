import "./util";
import "./docsummary";

pub struct Version { major: i64, minor: i64, patch: i64 }

pub function parse(text: string): Result[Version, string] {
  let parts: string[] = util.split_char(text, b'.');
  if (parts.len() != 3) {
    return Err(invalid_version(text) + " (want MAJOR.MINOR.PATCH)");
  }
  let values: i64[] = [];
  for part in parts {
    if (!util.is_all_digits(part)) {
      return Err(invalid_version(text));
    }
    let at = 0;
    while (at + 1 < part.len() && part[at] == b'0') {
      at = at + 1;
    }
    let digits = slice_unchecked(part, at, part.len()) + "";
    if (!util.is_decimal_i64(digits)) {
      return Err(invalid_version(text));
    }
    values = values.append(util.digits_to_i64(digits));
  }
  return Ok(Version { major: values[0], minor: values[1], patch: values[2] });
}

function invalid_version(text: string): string {
  return "invalid version " + docsummary.quote(text);
}

pub function format(value: Version): string {
  return util.i64_to_string(value.major) + "." + util.i64_to_string(value.minor) + "." + util.i64_to_string(value.patch);
}

pub function compare(a: Version, b: Version): i32 {
  if (a.major != b.major) {
    return if (a.major < b.major) { -1 } else { 1 };
  }
  if (a.minor != b.minor) {
    return if (a.minor < b.minor) { -1 } else { 1 };
  }
  if (a.patch != b.patch) {
    return if (a.patch < b.patch) { -1 } else { 1 };
  }
  return 0;
}
