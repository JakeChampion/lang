// Independent effect proof for the scalar assertion helper used by a donor.
// Caller proves two scalar ABI parameters. A normal return is zero and has no
// heap effects. Runtime exit is an explicit non-returning outcome, not a claim
// that live heap obligations were discharged. No helper-name trust or calls.
import "./ssa";
import "./ssacredithelper" as helper;
import "./util";

function refused(f: ssa.SFunc, why: string): helper.Proof {
  return helper.Proof { ok: false, function_name: f.name, message: why };
}

function at(f: ssa.SFunc, id: i32): i32 {
  let i: i32 = 0;
  for b in f.blocks {
    if (b.id == id) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

function edge(t: ssa.STerm, id: i32): boolean {
  return t.kind_tag == 2 && t.target == id || t.kind_tag == 3 && (t.t == id || t.f == id);
}

function input_error(f: ssa.SFunc): string {
  let count: i32 = 0;
  for b in f.blocks {
    count = count + b.insts.len();
  }
  if (f.name == "" || util.str_has_prefix(f.name, "__fern_") || f.nparams != 2 || f.takes_env || f.nvals < 2 || f.nvals > count || at(f, f.entry) < 0) {
    return "invalid scalar helper boundary";
  }
  let blocks: i32[] = [];
  let values: i32[] = [];
  let params: i32[] = [];
  for b in f.blocks {
    if (b.id < 0 || util.index_of_i32(blocks, b.id) >= 0 || b.id == f.entry && b.preds.len() != 0 || b.id != f.entry && b.preds.len() == 0) {
      return "invalid scalar helper block";
    }
    blocks = blocks.append(b.id);
    let body = false;
    for op in b.insts {
      if (op.result < 0 || op.result >= f.nvals || util.index_of_i32(values, op.result) >= 0) {
        return "invalid scalar helper definition";
      }
      values = values.append(op.result);
      if (op.kind_tag == 6) {
        if (b.id != f.entry || op.imm < 0 || op.imm > 1 || util.index_of_i32(params, op.imm) >= 0) {
          return "invalid scalar helper parameter";
        }
        params = params.append(op.imm);
      }
      if (op.kind_tag == 8) {
        if (body || b.preds.len() == 0 || op.args.len() != b.preds.len() || op.imm != 0 || op.str != "") {
          return "invalid scalar helper phi";
        }
      } else {
        body = true;
      }
    }
    let seen: i32[] = [];
    for p in b.preds {
      let pi = at(f, p);
      if (pi < 0 || util.index_of_i32(seen, p) >= 0 || !edge(f.blocks[pi].term, b.id)) {
        return "invalid scalar helper predecessor";
      }
      seen = seen.append(p);
    }
    if (b.term.kind_tag < 1 || b.term.kind_tag > 3 || b.term.kind_tag == 3 && b.term.t == b.term.f) {
      return "invalid scalar helper terminator";
    }
    let targets: i32[] = [];
    if (b.term.kind_tag == 2) {
      targets = [b.term.target];
    } else if (b.term.kind_tag == 3) {
      targets = [b.term.t, b.term.f];
    }
    for t in targets {
      let ti = at(f, t);
      if (ti < 0 || util.index_of_i32(f.blocks[ti].preds, b.id) < 0) {
        return "invalid scalar helper successor";
      }
    }
  }
  if (params.len() != 2) {
    return "scalar helper parameter count";
  }
  return "";
}

function readable(row: i32[], id: i32): boolean {
  return id >= 0 && id < row.len() && row[id] >= 0;
}

// Values are unavailable (-1), unknown scalar (0), or proven zero (1).
// Unknown is never a fabricated constant or a heap/reference identity.
// Both branches are checked, including conservative continuation after exit.
// This extra continuation cannot hide a heap effect or forge a zero return.
pub function zero_or_exit(f: ssa.SFunc): helper.Proof {
  let error = input_error(f);
  if (error != "") {
    return refused(f, error);
  }
  let empty: i32[] = [];
  let i: i32 = 0;
  while (i < f.nvals) {
    empty = empty.append(-1);
    i = i + 1;
  }
  let rows: i32[][] = [];
  let done: boolean[] = [];
  for b in f.blocks {
    rows = rows.append(empty);
    done = done.append(false);
  }
  let remaining = f.blocks.len();
  while (remaining > 0) {
    let chosen: i32 = -1;
    i = 0;
    for b in f.blocks {
      let ready = !done[i];
      for p in b.preds {
        if (!done[at(f, p)]) {
          ready = false;
        }
      }
      if (ready && chosen < 0) {
        chosen = i;
      }
      i = i + 1;
    }
    if (chosen < 0) {
      return refused(f, "unsupported scalar helper cycle");
    }
    let b = f.blocks[chosen];
    let row = empty;
    if (b.preds.len() > 0) {
      row = rows[at(f, b.preds[0])];
      for p in b.preds {
        let other = rows[at(f, p)];
        i = 0;
        while (i < f.nvals) {
          let value: i32 = -1;
          if (row[i] >= 0 && other[i] >= 0) {
            value = 0;
            if (row[i] == 1 && other[i] == 1) {
              value = 1;
            }
          }
          row = row.with(i, value);
          i = i + 1;
        }
      }
    }
    for op in b.insts {
      let value: i32 = 0;
      if (op.kind_tag == 8) {
        value = 1;
        i = 0;
        for p in b.preds {
          let previous = rows[at(f, p)];
          let arg = op.args[i];
          if (!readable(previous, arg)) {
            return refused(f, "unavailable scalar phi operand");
          }
          if (previous[arg] != 1) {
            value = 0;
          }
          i = i + 1;
        }
      } else {
        for arg in op.args {
          if (!readable(row, arg)) {
            return refused(f, "unavailable scalar helper operand");
          }
        }
        if (op.kind_tag == 6 && op.args.len() == 0 && op.str == "") {
          value = 0;
        } else if (op.kind_tag == 1 && op.args.len() == 0 && op.str == "") {
          if (op.imm == 0) {
            value = 1;
          }
        } else if (op.kind_tag == 7 && op.args.len() == 1 && op.imm == 0 && op.str == "") {
          value = row[op.args[0]];
        } else if (op.kind_tag == 50 && op.str == "exit" && op.args.len() == 1 && op.imm == 0) {
          value = 0;
        } else {
          return refused(f, "unsupported scalar helper effect");
        }
      }
      row = row.with(op.result, value);
    }
    if (b.term.kind_tag == 1) {
      if (!readable(row, b.term.value) || row[b.term.value] != 1) {
        return refused(f, "scalar helper return not proven zero");
      }
    } else if (b.term.kind_tag == 3 && !readable(row, b.term.cond)) {
      return refused(f, "unavailable scalar helper condition");
    }
    rows = rows.with(chosen, row);
    done = done.with(chosen, true);
    remaining = remaining - 1;
  }
  return helper.Proof { ok: true, function_name: f.name, message: "proved scalar zero-or-exit effects" };
}

// Two fixed ABI input cases, first parameter false/true; the second parameter
// remains unknown. These are conservative possible outcomes, not assertion
// truth or a claim that the caller's credits are discharged on process exit.
pub struct Outcomes { proof: helper.Proof, returns: boolean[], exits: boolean[] }

struct Number { known: boolean, value: i32 }

function follows(f: ssa.SFunc, rows: Number[][], live: boolean[], from: i32, to: i32): boolean {
  let index = at(f, from);
  if (!live[index]) {
    return false;
  }
  let term = f.blocks[index].term;
  if (term.kind_tag == 2) {
    return term.target == to;
  }
  if (term.kind_tag == 3) {
    let condition = rows[index][term.cond];
    return term.t == to && (!condition.known || condition.value != 0) || term.f == to && (!condition.known || condition.value == 0);
  }
  return false;
}

function joined_number(a: Number, b: Number): Number {
  if (a.known && b.known && a.value == b.value) {
    return a;
  }
  return Number { known: false, value: 0 };
}

pub function outcomes(f: ssa.SFunc): Outcomes {
  let proof = zero_or_exit(f);
  let result = Outcomes { proof: proof, returns: [false, false], exits: [false, false] };
  if (!proof.ok) {
    return result;
  }
  let unknown = Number { known: false, value: 0 };
  let empty: Number[] = [];
  let i: i32 = 0;
  while (i < f.nvals) {
    empty = empty.append(unknown);
    i = i + 1;
  }
  // Fixed two-case specialization, with joins over unknown branches. No CFG
  // path enumeration. The full effect/SSA proof above checks even dead code.
  for input in [0, 1] {
    let rows: Number[][] = [];
    let live: boolean[] = [];
    let done: boolean[] = [];
    for b in f.blocks {
      rows = rows.append(empty);
      live = live.append(false);
      done = done.append(false);
    }
    let remaining = f.blocks.len();
    while (remaining > 0) {
      let chosen: i32 = -1;
      i = 0;
      for b in f.blocks {
        let ready = !done[i];
        for p in b.preds {
          if (!done[at(f, p)]) {
            ready = false;
          }
        }
        if (ready && chosen < 0) {
          chosen = i;
        }
        i = i + 1;
      }
      if (chosen < 0) {
        return Outcomes { ...result, proof: refused(f, "unsupported scalar helper cycle") };
      }
      let b = f.blocks[chosen];
      let row = empty;
      let active = b.id == f.entry;
      for p in b.preds {
        if (follows(f, rows, live, p, b.id)) {
          let previous = rows[at(f, p)];
          if (!active) {
            row = previous;
          } else {
            i = 0;
            while (i < f.nvals) {
              row = row.with(i, joined_number(row[i], previous[i]));
              i = i + 1;
            }
          }
          active = true;
        }
      }
      for op in b.insts {
        if (active) {
          let value = unknown;
          if (op.kind_tag == 8) {
            let first = true;
            i = 0;
            for p in b.preds {
              if (follows(f, rows, live, p, b.id)) {
                let previous = rows[at(f, p)][op.args[i]];
                if (first) {
                  value = previous;
                } else {
                  value = joined_number(value, previous);
                }
                first = false;
              }
              i = i + 1;
            }
          } else if (op.kind_tag == 6 && op.imm == 0) {
            value = Number { known: true, value: input };
          } else if (op.kind_tag == 1) {
            value = Number { known: true, value: op.imm };
          } else if (op.kind_tag == 7) {
            value = row[op.args[0]];
          } else if (op.kind_tag == 50) {
            result = Outcomes { ...result, exits: result.exits.with(input, true) };
            active = false;
          }
          row = row.with(op.result, value);
        }
      }
      if (active && b.term.kind_tag == 1) {
        result = Outcomes { ...result, returns: result.returns.with(input, true) };
      }
      rows = rows.with(chosen, row);
      live = live.with(chosen, active);
      done = done.with(chosen, true);
      remaining = remaining - 1;
    }
  }
  return result;
}
