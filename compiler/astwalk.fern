import "./ast";
import "./util";

pub function fold_expr[T](e: ast.Expr, own acc: T, visit: (ast.Expr, own T) => T): T {
  return fold_expr_pruned(e, acc, visit, descend_all);
}

pub function fold_stmt[T](st: ast.Stmt, own acc: T, visit: (ast.Expr, own T) => T): T {
  return fold_stmt_pruned(st, acc, visit, descend_all);
}

pub function descend_all(e: ast.Expr): boolean {
  return true;
}

pub function fold_expr_pruned[T](e: ast.Expr, own acc: T, visit: (ast.Expr, own T) => T, descend: (ast.Expr) => boolean): T {
  return fold_expr_nodes(e, acc, (st: ast.Stmt, own a: T) => a, visit, descend);
}

pub function fold_stmt_pruned[T](st: ast.Stmt, own acc: T, visit: (ast.Expr, own T) => T, descend: (ast.Expr) => boolean): T {
  return fold_stmt_nodes(st, acc, (s: ast.Stmt, own a: T) => a, visit, descend);
}

pub function fold_expr_nodes[T](e: ast.Expr, own acc: T, visit_stmt: (ast.Stmt, own T) => T, visit_expr: (ast.Expr, own T) => T, descend: (ast.Expr) => boolean): T {
  acc = visit_expr(e, acc);
  if (!descend(e)) {
    return acc;
  }
  match (e) {
    ast.ExprBytes(_) => {
      return acc;
    },
    ast.ExprIdent(_) => {
      return acc;
    },
    ast.ExprNumber(_) => {
      return acc;
    },
    ast.ExprString(_) => {
      return acc;
    },
    ast.ExprBool(_) => {
      return acc;
    },
    ast.ExprBinary(b) => {
      acc = fold_expr_nodes(b.left, acc, visit_stmt, visit_expr, descend);
      return fold_expr_nodes(b.right, acc, visit_stmt, visit_expr, descend);
    },
    ast.ExprUnary(u) => {
      return fold_expr_nodes(u.operand, acc, visit_stmt, visit_expr, descend);
    },
    ast.ExprCall(c) => {
      acc = fold_expr_nodes(c.callee, acc, visit_stmt, visit_expr, descend);
      for arg in c.args {
        acc = fold_expr_nodes(arg, acc, visit_stmt, visit_expr, descend);
      }
      return acc;
    },
    ast.ExprArray(a) => {
      for el in a.elements {
        acc = fold_expr_nodes(el, acc, visit_stmt, visit_expr, descend);
      }
      return acc;
    },
    ast.ExprMapLit(ml) => {
      let i: i32 = 0;
      while (i < ml.keys.len()) {
        acc = fold_expr_nodes(ml.keys[i], acc, visit_stmt, visit_expr, descend);
        acc = fold_expr_nodes(ml.vals[i], acc, visit_stmt, visit_expr, descend);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprFString(fs) => {
      let i: i32 = 0;
      while (i < fs.exprs.len()) {
        if (fs.is_expr[i]) {
          acc = fold_expr_nodes(fs.exprs[i], acc, visit_stmt, visit_expr, descend);
        }
        i = i + 1;
      }
      return acc;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        acc = fold_expr_nodes(el, acc, visit_stmt, visit_expr, descend);
      }
      return acc;
    },
    ast.ExprIndex(x) => {
      acc = fold_expr_nodes(x.array, acc, visit_stmt, visit_expr, descend);
      return fold_expr_nodes(x.index, acc, visit_stmt, visit_expr, descend);
    },
    ast.ExprSlice(sl) => {
      acc = fold_expr_nodes(sl.array, acc, visit_stmt, visit_expr, descend);
      acc = fold_expr_nodes(sl.start, acc, visit_stmt, visit_expr, descend);
      return fold_expr_nodes(sl.end, acc, visit_stmt, visit_expr, descend);
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        acc = fold_expr_nodes(sl.base, acc, visit_stmt, visit_expr, descend);
      }
      for field_value in sl.field_values {
        acc = fold_expr_nodes(field_value, acc, visit_stmt, visit_expr, descend);
      }
      return acc;
    },
    ast.ExprFieldAccess(fa) => {
      return fold_expr_nodes(fa.obj, acc, visit_stmt, visit_expr, descend);
    },
    ast.ExprLambda(lm) => {
      for body_st in lm.body {
        acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
      }
      return acc;
    },
    ast.ExprUnknown(_) => {
      return acc;
    },
    ast.ExprZero(_) => {
      return acc;
    }
  }
  return acc;
}

pub function fold_stmt_nodes[T](st: ast.Stmt, own acc: T, visit_stmt: (ast.Stmt, own T) => T, visit_expr: (ast.Expr, own T) => T, descend: (ast.Expr) => boolean): T {
  acc = visit_stmt(st, acc);
  match (st) {
    ast.StmtDefer(d) => {
      return fold_stmt_nodes(d.action, acc, visit_stmt, visit_expr, descend);
    },
    ast.StmtVar(v) => {
      return fold_expr_nodes(v.init, acc, visit_stmt, visit_expr, descend);
    },
    ast.StmtReturn(r) => {
      return fold_expr_nodes(r.value, acc, visit_stmt, visit_expr, descend);
    },
    ast.StmtExpr(e) => {
      return fold_expr_nodes(e.value, acc, visit_stmt, visit_expr, descend);
    },
    ast.StmtIf(i) => {
      acc = fold_expr_nodes(i.cond, acc, visit_stmt, visit_expr, descend);
      for body_st in i.then_body {
        acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
      }
      for body_st in i.else_body {
        acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
      }
      return acc;
    },
    ast.StmtWhile(w) => {
      acc = fold_expr_nodes(w.cond, acc, visit_stmt, visit_expr, descend);
      for body_st in w.body {
        acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
      }
      return acc;
    },
    ast.StmtAssign(a) => {
      return fold_expr_nodes(a.value, acc, visit_stmt, visit_expr, descend);
    },
    ast.StmtMatch(m) => {
      acc = fold_expr_nodes(m.scrutinee, acc, visit_stmt, visit_expr, descend);
      for arm in m.arms {
        if (arm.has_guard) {
          acc = fold_expr_nodes(arm.guard, acc, visit_stmt, visit_expr, descend);
        }
        for body_st in arm.body {
          acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
        }
      }
      return acc;
    },
    ast.StmtFor(f) => {
      acc = fold_expr_nodes(f.iter, acc, visit_stmt, visit_expr, descend);
      for body_st in f.body {
        acc = fold_stmt_nodes(body_st, acc, visit_stmt, visit_expr, descend);
      }
      return acc;
    },
    ast.StmtBreak(_) => {
      return acc;
    },
    ast.StmtContinue(_) => {
      return acc;
    },
    ast.StmtUnknown(_) => {
      return acc;
    }
  }
  return acc;
}

pub function fold_stmt_spine[T](st: ast.Stmt, own acc: T, visit: (ast.Stmt, own T) => T): T {
  acc = visit(st, acc);
  match (st) {
    ast.StmtDefer(d) => {
      return fold_stmt_spine(d.action, acc, visit);
    },
    ast.StmtIf(i) => {
      for body_st in i.then_body {
        acc = fold_stmt_spine(body_st, acc, visit);
      }
      for body_st in i.else_body {
        acc = fold_stmt_spine(body_st, acc, visit);
      }
      return acc;
    },
    ast.StmtWhile(w) => {
      for body_st in w.body {
        acc = fold_stmt_spine(body_st, acc, visit);
      }
      return acc;
    },
    ast.StmtFor(f) => {
      for body_st in f.body {
        acc = fold_stmt_spine(body_st, acc, visit);
      }
      return acc;
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        for body_st in arm.body {
          acc = fold_stmt_spine(body_st, acc, visit);
        }
      }
      return acc;
    },
    ast.StmtVar(_) => {
      return acc;
    },
    ast.StmtReturn(_) => {
      return acc;
    },
    ast.StmtExpr(_) => {
      return acc;
    },
    ast.StmtAssign(_) => {
      return acc;
    },
    ast.StmtBreak(_) => {
      return acc;
    },
    ast.StmtContinue(_) => {
      return acc;
    },
    ast.StmtUnknown(_) => {
      return acc;
    }
  }
  return acc;
}

pub function fold_stmt_own[T](st: ast.Stmt, own acc: T, visit: (ast.Expr, own T) => T): T {
  return fold_stmt_own_pruned(st, acc, visit, descend_all);
}

pub function fold_stmt_own_pruned[T](st: ast.Stmt, own acc: T, visit: (ast.Expr, own T) => T, descend: (ast.Expr) => boolean): T {
  match (st) {
    ast.StmtVar(v) => {
      return fold_expr_pruned(v.init, acc, visit, descend);
    },
    ast.StmtAssign(a) => {
      return fold_expr_pruned(a.value, acc, visit, descend);
    },
    ast.StmtReturn(r) => {
      return fold_expr_pruned(r.value, acc, visit, descend);
    },
    ast.StmtExpr(e) => {
      return fold_expr_pruned(e.value, acc, visit, descend);
    },
    ast.StmtIf(i) => {
      return fold_expr_pruned(i.cond, acc, visit, descend);
    },
    ast.StmtWhile(w) => {
      return fold_expr_pruned(w.cond, acc, visit, descend);
    },
    ast.StmtFor(f) => {
      return fold_expr_pruned(f.iter, acc, visit, descend);
    },
    ast.StmtMatch(m) => {
      acc = fold_expr_pruned(m.scrutinee, acc, visit, descend);
      for arm in m.arms {
        if (arm.has_guard) {
          acc = fold_expr_pruned(arm.guard, acc, visit, descend);
        }
      }
      return acc;
    },
    ast.StmtDefer(_) => {
      return acc;
    },
    ast.StmtBreak(_) => {
      return acc;
    },
    ast.StmtContinue(_) => {
      return acc;
    },
    ast.StmtUnknown(_) => {
      return acc;
    }
  }
  return acc;
}

pub function map_expr(e: ast.Expr, visit: (ast.Expr) => ast.Expr): ast.Expr {
  match (e) {
    ast.ExprBytes(_) => {
      return visit(e);
    },
    ast.ExprNumber(_) => {
      return visit(e);
    },
    ast.ExprIdent(_) => {
      return visit(e);
    },
    ast.ExprString(_) => {
      return visit(e);
    },
    ast.ExprBool(_) => {
      return visit(e);
    },
    ast.ExprUnknown(_) => {
      return visit(e);
    },
    ast.ExprZero(_) => {
      return visit(e);
    },
    ast.ExprBinary(b) => {
      return visit(ast.ExprBinary { ...b, left: map_expr(b.left, visit), right: map_expr(b.right, visit) });
    },
    ast.ExprUnary(u) => {
      return visit(ast.ExprUnary { ...u, operand: map_expr(u.operand, visit) });
    },
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      for arg in c.args {
        args = args.append(map_expr(arg, visit));
      }
      return visit(ast.ExprCall { ...c, callee: map_expr(c.callee, visit), args: args });
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      for el in a.elements {
        els = els.append(map_expr(el, visit));
      }
      return visit(ast.ExprArray { ...a, elements: els });
    },
    ast.ExprTuple(t) => {
      let tel: ast.Expr[] = [];
      for el in t.elements {
        tel = tel.append(map_expr(el, visit));
      }
      return visit(ast.ExprTuple { ...t, elements: tel });
    },
    ast.ExprIndex(ix) => {
      return visit(ast.ExprIndex { ...ix, array: map_expr(ix.array, visit), index: map_expr(ix.index, visit) });
    },
    ast.ExprSlice(sl) => {
      return visit(ast.ExprSlice { ...sl, array: map_expr(sl.array, visit), start: map_expr(sl.start, visit), end: map_expr(sl.end, visit) });
    },
    ast.ExprStructLit(st) => {
      let fv: ast.Expr[] = [];
      for field_value in st.field_values {
        fv = fv.append(map_expr(field_value, visit));
      }
      let nb: ast.Expr = st.base;
      if (st.has_base) {
        nb = map_expr(st.base, visit);
      }
      return visit(ast.ExprStructLit { ...st, field_values: fv, base: nb });
    },
    ast.ExprFieldAccess(fa) => {
      return visit(ast.ExprFieldAccess { ...fa, obj: map_expr(fa.obj, visit) });
    },
    ast.ExprLambda(lm) => {
      return visit(ast.ExprLambda { ...lm, body: map_stmts(lm.body, visit) });
    },
    ast.ExprMapLit(ml) => {
      let ks: ast.Expr[] = [];
      let vs: ast.Expr[] = [];
      for key in ml.keys {
        ks = ks.append(map_expr(key, visit));
      }
      for val in ml.vals {
        vs = vs.append(map_expr(val, visit));
      }
      return visit(ast.ExprMapLit { ...ml, keys: ks, vals: vs });
    },
    ast.ExprFString(fs) => {
      let xs: ast.Expr[] = [];
      let q: i32 = 0;
      while (q < fs.exprs.len()) {
        if (fs.is_expr[q]) {
          xs = xs.append(map_expr(fs.exprs[q], visit));
        } else {
          xs = xs.append(fs.exprs[q]);
        }
        q = q + 1;
      }
      return visit(ast.ExprFString { ...fs, exprs: xs });
    }
  }
  return visit(e);
}

pub function map_stmt(st: ast.Stmt, visit: (ast.Expr) => ast.Expr): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { ...v, init: map_expr(v.init, visit) };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: map_expr(r.value, visit) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: map_expr(x.value, visit) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: map_expr(a.value, visit) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: map_expr(f.cond, visit), then_body: map_stmts(f.then_body, visit), else_body: map_stmts(f.else_body, visit) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, cond: map_expr(w.cond, visit), body: map_stmts(w.body, visit) };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { ...fo, iter: map_expr(fo.iter, visit), body: map_stmts(fo.body, visit) };
    },
    ast.StmtMatch(mt) => {
      let arms: ast.MatchArm[] = [];
      for arm in mt.arms {
        let g: ast.Expr = arm.guard;
        if (arm.has_guard) {
          g = map_expr(arm.guard, visit);
        }
        arms = arms.append(ast.MatchArm { ...arm, body: map_stmts(arm.body, visit), guard: g });
      }
      return ast.StmtMatch { ...mt, scrutinee: map_expr(mt.scrutinee, visit), arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: map_stmt(d.action, visit) };
    },
    ast.StmtBreak(_) => {
      return st;
    },
    ast.StmtContinue(_) => {
      return st;
    },
    ast.StmtUnknown(_) => {
      return st;
    }
  }
  return st;
}

pub function map_stmts(stmts: ast.Stmt[], visit: (ast.Expr) => ast.Expr): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for stmt in stmts {
    out = out.append(map_stmt(stmt, visit));
  }
  return out;
}

pub function map_expr_acc[T](e: ast.Expr, acc: T, visit_stmt: (ast.Stmt, T) => (ast.Stmt, T, boolean), visit: (ast.Expr, T) => (ast.Expr, T, boolean)): (ast.Expr, T, boolean) {
  let (ve, va, vh) = visit(e, acc);
  if (vh) {
    return (ve, va, true);
  }
  let a: T = va;
  let out: ast.Expr = e;
  let changed: boolean = false;
  match (e) {
    ast.ExprBinary(b) => {
      let (le, la, lh) = map_expr_acc(b.left, a, visit_stmt, visit);
      let (re, ra, rh) = map_expr_acc(b.right, la, visit_stmt, visit);
      a = ra;
      changed = lh || rh;
      if (changed) {
        out = ast.ExprBinary { ...b, left: le, right: re };
      }
    },
    ast.ExprUnary(u) => {
      let (oe, oa, oh) = map_expr_acc(u.operand, a, visit_stmt, visit);
      a = oa;
      changed = oh;
      if (changed) {
        out = ast.ExprUnary { ...u, operand: oe };
      }
    },
    ast.ExprCall(c) => {
      let (args, aa, ah) = map_exprs_acc(c.args, a, visit_stmt, visit);
      let (ce, ca, ch) = map_expr_acc(c.callee, aa, visit_stmt, visit);
      a = ca;
      changed = ah || ch;
      if (changed) {
        out = ast.ExprCall { ...c, callee: ce, args: args };
      }
    },
    ast.ExprArray(arr) => {
      let (els, ea, eh) = map_exprs_acc(arr.elements, a, visit_stmt, visit);
      a = ea;
      changed = eh;
      if (changed) {
        out = ast.ExprArray { ...arr, elements: els };
      }
    },
    ast.ExprTuple(t) => {
      let (tel, ta, th) = map_exprs_acc(t.elements, a, visit_stmt, visit);
      a = ta;
      changed = th;
      if (changed) {
        out = ast.ExprTuple { ...t, elements: tel };
      }
    },
    ast.ExprIndex(ix) => {
      let (xe, xa, xh) = map_expr_acc(ix.array, a, visit_stmt, visit);
      let (ie, ia, ih) = map_expr_acc(ix.index, xa, visit_stmt, visit);
      a = ia;
      changed = xh || ih;
      if (changed) {
        out = ast.ExprIndex { ...ix, array: xe, index: ie };
      }
    },
    ast.ExprSlice(sl) => {
      let (xe, xa, xh) = map_expr_acc(sl.array, a, visit_stmt, visit);
      let (se, sa, sh) = map_expr_acc(sl.start, xa, visit_stmt, visit);
      let (ne, na, nh) = map_expr_acc(sl.end, sa, visit_stmt, visit);
      a = na;
      changed = xh || sh || nh;
      if (changed) {
        out = ast.ExprSlice { ...sl, array: xe, start: se, end: ne };
      }
    },
    ast.ExprStructLit(sl) => {
      let (fv, fa, fh) = map_exprs_acc(sl.field_values, a, visit_stmt, visit);
      a = fa;
      changed = fh;
      let nb: ast.Expr = sl.base;
      if (sl.has_base) {
        let (be, ba, bh) = map_expr_acc(sl.base, a, visit_stmt, visit);
        a = ba;
        nb = be;
        changed = changed || bh;
      }
      if (changed) {
        out = ast.ExprStructLit { ...sl, field_values: fv, base: nb };
      }
    },
    ast.ExprFieldAccess(fa) => {
      let (oe, oa, oh) = map_expr_acc(fa.obj, a, visit_stmt, visit);
      a = oa;
      changed = oh;
      if (changed) {
        out = ast.ExprFieldAccess { ...fa, obj: oe };
      }
    },
    ast.ExprLambda(lm) => {
      let (bs, ba, bh) = map_stmts_acc_changed(lm.body, a, visit_stmt, visit);
      a = ba;
      changed = bh;
      if (changed) {
        out = ast.ExprLambda { ...lm, body: bs };
      }
    },
    ast.ExprMapLit(ml) => {
      let ks: ast.Expr[] = [];
      let vs: ast.Expr[] = [];
      let q: i32 = 0;
      while (q < ml.keys.len()) {
        let (ke, ka, kh) = map_expr_acc(ml.keys[q], a, visit_stmt, visit);
        let (ue, ua, uh) = map_expr_acc(ml.vals[q], ka, visit_stmt, visit);
        a = ua;
        ks = ks.append(ke);
        vs = vs.append(ue);
        changed = changed || kh || uh;
        q = q + 1;
      }
      if (changed) {
        out = ast.ExprMapLit { ...ml, keys: ks, vals: vs };
      }
    },
    ast.ExprFString(fs) => {
      let xs: ast.Expr[] = [];
      let q: i32 = 0;
      while (q < fs.exprs.len()) {
        if (fs.is_expr[q]) {
          let (pe, pa, ph) = map_expr_acc(fs.exprs[q], a, visit_stmt, visit);
          a = pa;
          xs = xs.append(pe);
          changed = changed || ph;
        } else {
          xs = xs.append(fs.exprs[q]);
        }
        q = q + 1;
      }
      if (changed) {
        out = ast.ExprFString { ...fs, exprs: xs };
      }
    },
    _ => {}
  }
  return (out, a, changed);
}

function map_exprs_acc[T](es: ast.Expr[], acc: T, visit_stmt: (ast.Stmt, T) => (ast.Stmt, T, boolean), visit: (ast.Expr, T) => (ast.Expr, T, boolean)): (ast.Expr[], T, boolean) {
  let out: ast.Expr[] = [];
  let changed: boolean = false;
  let i: i32 = 0;
  while (i < es.len()) {
    let (ne, na, nh) = map_expr_acc(es[i], acc, visit_stmt, visit);
    acc = na;
    if (nh && !changed) {
      changed = true;
      let j: i32 = 0;
      while (j < i) {
        out = out.append(es[j]);
        j = j + 1;
      }
    }
    if (changed) {
      out = out.append(ne);
    }
    i = i + 1;
  }
  if (!changed) {
    return (es, acc, false);
  }
  return (out, acc, true);
}

pub function map_stmt_acc[T](st: ast.Stmt, acc: T, visit_stmt: (ast.Stmt, T) => (ast.Stmt, T, boolean), visit: (ast.Expr, T) => (ast.Expr, T, boolean)): (ast.Stmt, T, boolean) {
  let (vs, va, vh) = visit_stmt(st, acc);
  if (vh) {
    return (vs, va, true);
  }
  let a: T = va;
  let out: ast.Stmt = st;
  let changed: boolean = false;
  match (st) {
    ast.StmtVar(v) => {
      let (ie, ia, ih) = map_expr_acc(v.init, a, visit_stmt, visit);
      a = ia;
      changed = ih;
      if (changed) {
        out = ast.StmtVar { ...v, init: ie };
      }
    },
    ast.StmtReturn(rt) => {
      let (ve, vla, vlh) = map_expr_acc(rt.value, a, visit_stmt, visit);
      a = vla;
      changed = vlh;
      if (changed) {
        out = ast.StmtReturn { ...rt, value: ve };
      }
    },
    ast.StmtExpr(x) => {
      let (ve, vla, vlh) = map_expr_acc(x.value, a, visit_stmt, visit);
      a = vla;
      changed = vlh;
      if (changed) {
        out = ast.StmtExpr { ...x, value: ve };
      }
    },
    ast.StmtAssign(asg) => {
      let (ve, vla, vlh) = map_expr_acc(asg.value, a, visit_stmt, visit);
      a = vla;
      changed = vlh;
      if (changed) {
        out = ast.StmtAssign { ...asg, value: ve };
      }
    },
    ast.StmtIf(f) => {
      let (ce, ca, ch) = map_expr_acc(f.cond, a, visit_stmt, visit);
      let (tb, ta, th) = map_stmts_acc_changed(f.then_body, ca, visit_stmt, visit);
      let (eb, ea, eh) = map_stmts_acc_changed(f.else_body, ta, visit_stmt, visit);
      a = ea;
      changed = ch || th || eh;
      if (changed) {
        out = ast.StmtIf { ...f, cond: ce, then_body: tb, else_body: eb };
      }
    },
    ast.StmtWhile(w) => {
      let (ce, ca, ch) = map_expr_acc(w.cond, a, visit_stmt, visit);
      let (wb, wa, wh) = map_stmts_acc_changed(w.body, ca, visit_stmt, visit);
      a = wa;
      changed = ch || wh;
      if (changed) {
        out = ast.StmtWhile { ...w, cond: ce, body: wb };
      }
    },
    ast.StmtFor(fo) => {
      let (ie, ia, ih) = map_expr_acc(fo.iter, a, visit_stmt, visit);
      let (fb, fba, fbh) = map_stmts_acc_changed(fo.body, ia, visit_stmt, visit);
      a = fba;
      changed = ih || fbh;
      if (changed) {
        out = ast.StmtFor { ...fo, iter: ie, body: fb };
      }
    },
    ast.StmtMatch(mt) => {
      let (se, sa, sh) = map_expr_acc(mt.scrutinee, a, visit_stmt, visit);
      a = sa;
      changed = sh;
      let arms: ast.MatchArm[] = [];
      for arm in mt.arms {
        let g: ast.Expr = arm.guard;
        if (arm.has_guard) {
          let (ge, ga, gh) = map_expr_acc(arm.guard, a, visit_stmt, visit);
          a = ga;
          g = ge;
          changed = changed || gh;
        }
        let (ab, aa, abh) = map_stmts_acc_changed(arm.body, a, visit_stmt, visit);
        a = aa;
        changed = changed || abh;
        arms = arms.append(ast.MatchArm { ...arm, body: ab, guard: g });
      }
      if (changed) {
        out = ast.StmtMatch { ...mt, scrutinee: se, arms: arms };
      }
    },
    ast.StmtDefer(d) => {
      let (de, da, dh) = map_stmt_acc(d.action, a, visit_stmt, visit);
      a = da;
      changed = dh;
      if (changed) {
        out = ast.StmtDefer { ...d, action: de };
      }
    },
    _ => {}
  }
  return (out, a, changed);
}

pub function map_stmts_acc[T](stmts: ast.Stmt[], acc: T, visit_stmt: (ast.Stmt, T) => (ast.Stmt, T, boolean), visit: (ast.Expr, T) => (ast.Expr, T, boolean)): (ast.Stmt[], T) {
  let (out, a, changed) = map_stmts_acc_changed(stmts, acc, visit_stmt, visit);
  return (out, a);
}

function map_stmts_acc_changed[T](stmts: ast.Stmt[], acc: T, visit_stmt: (ast.Stmt, T) => (ast.Stmt, T, boolean), visit: (ast.Expr, T) => (ast.Expr, T, boolean)): (ast.Stmt[], T, boolean) {
  let out: ast.Stmt[] = [];
  let changed: boolean = false;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let (ns, na, nh) = map_stmt_acc(stmts[i], acc, visit_stmt, visit);
    acc = na;
    if (nh && !changed) {
      changed = true;
      let j: i32 = 0;
      while (j < i) {
        out = out.append(stmts[j]);
        j = j + 1;
      }
    }
    if (changed) {
      out = out.append(ns);
    }
    i = i + 1;
  }
  if (!changed) {
    return (stmts, acc, false);
  }
  return (out, acc, true);
}

pub function splice_stmts(stmts: ast.Stmt[], visit: (ast.Stmt) => ast.Stmt[]): ast.Stmt[] {
  return splice_stmts_with_lambda(stmts, visit, (lm: ast.ExprLambda) => lm);
}

pub function splice_stmts_with_lambda(stmts: ast.Stmt[], visit: (ast.Stmt) => ast.Stmt[], finish_lambda: (ast.ExprLambda) => ast.ExprLambda): ast.Stmt[] {
  let mapped: ast.Stmt[] = map_stmts(stmts, (x: ast.Expr): ast.Expr => {
    match (x) {
      ast.ExprLambda(lm) => {
        return finish_lambda(ast.ExprLambda { ...lm, body: splice_own(lm.body, visit) });
      },
      _ => {
        return x;
      }
    }
    return x;
  });
  return splice_own(mapped, visit);
}

function splice_own(stmts: ast.Stmt[], visit: (ast.Stmt) => ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for stmt in stmts {
    let repl: ast.Stmt[] = visit(splice_own_children(stmt, visit));
    for r in repl {
      out = out.append(r);
    }
  }
  return out;
}

function splice_own_children(st: ast.Stmt, visit: (ast.Stmt) => ast.Stmt[]): ast.Stmt {
  match (st) {
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, then_body: splice_own(f.then_body, visit), else_body: splice_own(f.else_body, visit) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, body: splice_own(w.body, visit) };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { ...fo, body: splice_own(fo.body, visit) };
    },
    ast.StmtMatch(mt) => {
      let arms: ast.MatchArm[] = [];
      for arm in mt.arms {
        arms = arms.append(ast.MatchArm { ...arm, body: splice_own(arm.body, visit) });
      }
      return ast.StmtMatch { ...mt, arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: splice_own_children(d.action, visit) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function ident_of(e: ast.Expr, own acc: string[]): string[] {
  match (e) {
    ast.ExprIdent(id) => {
      return acc.append(id.name);
    },
    ast.ExprLambda(lm) => {
      return collect_lambda_idents(lm, acc);
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

pub function not_lambda(e: ast.Expr): boolean {
  match (e) {
    ast.ExprLambda(_) => {
      return false;
    },
    _ => {
      return true;
    }
  }
  return true;
}

pub function collect_idents_expr(e: ast.Expr, own acc: string[]): string[] {
  return fold_expr_pruned(e, acc, ident_of, not_lambda);
}

function scoped_reads(e: ast.Expr, bound: string[], acc: string[], reads: (ast.Expr, own string[]) => string[]): string[] {
  for name in reads(e, []) {
    if (!util.has_str(bound, name)) {
      acc = acc.append(name);
    }
  }
  return acc;
}

function scoped_stmt_reads(st: ast.Stmt, bound: string[], acc: string[], reads: (ast.Expr, own string[]) => string[]): string[] {
  match (st) {
    ast.StmtVar(v) => {
      let init_bound: string[] = bound;
      if (ast.var_binds_itself(v)) {
        init_bound = append_bound_name(init_bound, v.name);
      }
      return scoped_reads(v.init, init_bound, acc, reads);
    },
    ast.StmtExpr(e) => {
      return scoped_reads(e.value, bound, acc, reads);
    },
    ast.StmtReturn(r) => {
      return scoped_reads(r.value, bound, acc, reads);
    },
    ast.StmtAssign(a) => {
      if (!util.has_str(bound, a.target)) {
        acc = acc.append(a.target);
      }
      return scoped_reads(a.value, bound, acc, reads);
    },
    ast.StmtIf(f) => {
      acc = scoped_reads(f.cond, bound, acc, reads);
      let (then_reads, then_bound) = scoped_stmts_reads(f.then_body, bound, acc, reads);
      let (else_reads, else_bound) = scoped_stmts_reads(f.else_body, bound, then_reads, reads);
      return else_reads;
    },
    ast.StmtWhile(w) => {
      acc = scoped_reads(w.cond, bound, acc, reads);
      let (used, inner_bound) = scoped_stmts_reads(w.body, bound, acc, reads);
      return used;
    },
    ast.StmtFor(f) => {
      acc = scoped_reads(f.iter, bound, acc, reads);
      let loop_bound: string[] = [];
      loop_bound = util.append_all(loop_bound, bound);
      loop_bound = append_bound_name(loop_bound, f.var_name);
      let (used, inner_bound) = scoped_stmts_reads(f.body, loop_bound, acc, reads);
      return used;
    },
    ast.StmtMatch(m) => {
      acc = scoped_reads(m.scrutinee, bound, acc, reads);
      for arm in m.arms {
        let arm_bound: string[] = [];
        arm_bound = util.append_all(arm_bound, bound);
        arm_bound = pattern_binders(arm.pattern, arm_bound);
        if (arm.has_guard) {
          acc = scoped_reads(arm.guard, arm_bound, acc, reads);
        }
        let (used, inner_bound) = scoped_stmts_reads(arm.body, arm_bound, acc, reads);
        acc = used;
      }
      return acc;
    },
    ast.StmtDefer(d) => {
      return scoped_stmt_reads(d.action, bound, acc, reads);
    },
    ast.StmtBreak(_) => {
      return acc;
    },
    ast.StmtContinue(_) => {
      return acc;
    },
    ast.StmtUnknown(_) => {
      return acc;
    }
  }
  return acc;
}

function scoped_stmts_reads(body: ast.Stmt[], bound: string[], acc: string[], reads: (ast.Expr, own string[]) => string[]): (string[], string[]) {
  for st in body {
    acc = scoped_stmt_reads(st, bound, acc, reads);
    if let ast.StmtVar(v) = st {
      bound = append_bound_name(bound, v.name);
    }
  }
  return (acc, bound);
}

pub function collect_lambda_idents(lm: ast.ExprLambda, own acc: string[]): string[] {
  let bound: string[] = [];
  for param in lm.params {
    bound = append_bound_name(bound, param.name);
  }
  let (used, final_bound) = scoped_stmts_reads(lm.body, bound, acc, collect_idents_expr);
  return used;
}

pub function collect_free_idents(params: string[], body: ast.Stmt[], own acc: string[]): string[] {
  let bound: string[] = [];
  for p in params {
    bound = append_bound_name(bound, p);
  }
  let (used, final_bound) = scoped_stmts_reads(body, bound, acc, collect_idents_expr);
  return used;
}

pub function subst_ident_expr(e: ast.Expr, from: string, to: string): ast.Expr {
  function subst_one(x: ast.Expr): ast.Expr {
    match (x) {
      ast.ExprIdent(id) => {
        if (id.name == from) {
          return ast.ExprIdent { ...id, name: to };
        }
        return x;
      },
      _ => {
        return x;
      }
    }
    return x;
  }
  return map_expr(e, subst_one);
}

function assign_target_of(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtAssign(a) => {
      return acc.append(a.target);
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

pub function collect_idents_stmt(st: ast.Stmt, own acc: string[]): string[] {
  return fold_stmt_nodes(st, acc, assign_target_of, ident_of, not_lambda);
}

pub function count_ident_expr(e: ast.Expr, name: string): i32 {
  function at_expr(node: ast.Expr, own n: i32): i32 {
    for id in ident_of(node, []) {
      if (id == name) {
        n = n + 1;
      }
    }
    return n;
  }
  return fold_expr_pruned(e, 0i32, at_expr, not_lambda);
}

pub function count_ident_stmts(stmts: ast.Stmt[], name: string): i32 {
  function at_stmt(st: ast.Stmt, own n: i32): i32 {
    for id in assign_target_of(st, []) {
      if (id == name) {
        n = n + 1;
      }
    }
    return n;
  }
  function at_expr(e: ast.Expr, own n: i32): i32 {
    for id in ident_of(e, []) {
      if (id == name) {
        n = n + 1;
      }
    }
    return n;
  }
  let count: i32 = 0;
  for st in stmts {
    count = fold_stmt_nodes(st, count, at_stmt, at_expr, not_lambda);
  }
  return count;
}

pub function append_bound_name(own acc: string[], name: string): string[] {
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= name.len()) {
    if (i == name.len() || name[i] == b',' && depth == 0) {
      let piece: string = slice_unchecked(name, start, i) + "";
      if (util.is_tuple_type_name(piece)) {
        acc = append_bound_name(acc, slice_unchecked(piece, 1, piece.len() - 1) + "");
      } else if (piece.len() > 0 && piece != "_") {
        acc = acc.append(piece);
      }
      start = i + 1;
    } else if (name[i] == b'(') {
      depth = depth + 1;
    } else if (name[i] == b')') {
      depth = depth - 1;
    }
    i = i + 1;
  }
  return acc;
}

pub struct CallSite { name: string, line: i32, col: i32, method: boolean }

function call_site_of(e: ast.Expr, want: util.NameIndex, own acc: CallSite[]): CallSite[] {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          if (want.has(id.name)) {
            return acc.append(CallSite { name: id.name, line: c.line, col: c.col, method: false });
          }
          return acc;
        },
        ast.ExprFieldAccess(fa) => {
          if (want.has(fa.field)) {
            return acc.append(CallSite { name: fa.field, line: c.line, col: c.col, method: true });
          }
          return acc;
        },
        _ => {
          return acc;
        }
      }
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

pub function collect_calls_stmt(st: ast.Stmt, want: util.NameIndex, own acc: CallSite[]): CallSite[] {
  function visit(e: ast.Expr, own a: CallSite[]): CallSite[] {
    return call_site_of(e, want, a);
  }
  return fold_stmt(st, acc, visit);
}

pub function pattern_binders(p: ast.Pattern, own acc: string[]): string[] {
  match (p) {
    ast.PatVariant(pv) => {
      if (pv.binding.len() > 0) {
        acc = acc.append(pv.binding);
      }
      if (pv.at_binding.len() > 0) {
        acc = acc.append(pv.at_binding);
      }
      for eb in pv.extra_bindings {
        if (eb.len() > 0) {
          acc = acc.append(eb);
        }
      }
      for tb in pv.tup_binds {
        if (tb.len() > 0) {
          acc = acc.append(tb);
        }
      }
      for sub in pv.nested {
        acc = pattern_binders(sub, acc);
      }
      for tp in pv.tup_pats {
        acc = pattern_binders(tp, acc);
      }
      return acc;
    },
    ast.PatWildcard(_) => {
      return acc;
    }
  }
  return acc;
}

pub function binders_of(st: ast.Stmt, own acc: string[]): string[] {
  match (st) {
    ast.StmtVar(v) => {
      return append_bound_name(acc, v.name);
    },
    ast.StmtFor(f) => {
      return append_bound_name(acc, f.var_name);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        acc = pattern_binders(arm.pattern, acc);
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

pub function collect_bound_stmt(st: ast.Stmt, own acc: string[]): string[] {
  return fold_stmt_spine(st, acc, binders_of);
}

pub function collect_bound_stmts(stmts: ast.Stmt[], acc: string[]): string[] {
  for stmt in stmts {
    acc = collect_bound_stmt(stmt, acc);
  }
  return acc;
}

pub struct QualRef { qual: string, name: string, line: i32, col: i32 }

function qualref_of(e: ast.Expr, quals: string[], acc: QualRef[]): QualRef[] {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(id) => {
          if (util.has_str(quals, id.name)) {
            return acc.append(QualRef { qual: id.name, name: fa.field, line: fa.line, col: fa.col });
          }
        },
        _ => {}
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

pub function collect_qualrefs_stmt(st: ast.Stmt, quals: string[], own acc: QualRef[]): QualRef[] {
  function visit(n: ast.Expr, own a: QualRef[]): QualRef[] {
    return qualref_of(n, quals, a);
  }
  return fold_stmt(st, acc, visit);
}

pub struct ConstSubst { names: string[], values: ast.Expr[], bound: string[], types: string[], enums: string[], enum_assoc: string[] }

pub function substitute_consts(stmts: ast.Stmt[], bound: string[], names: string[], values: ast.Expr[]): ast.Stmt[] {
  if (names.len() == 0) {
    return stmts;
  }
  return cs_body(stmts, ConstSubst { names: names, values: values, bound: bound, types: [], enums: [], enum_assoc: [] });
}

pub function substitute_consts_expr(e: ast.Expr, names: string[], values: ast.Expr[]): ast.Expr {
  if (names.len() == 0) {
    return e;
  }
  return cs_expr(e, ConstSubst { names: names, values: values, bound: [], types: [], enums: [], enum_assoc: [] });
}

pub function rewrite_assoc_const_reads(stmts: ast.Stmt[], bound: string[], types: string[], enums: string[], enum_assoc: string[]): ast.Stmt[] {
  if (types.len() == 0) {
    return stmts;
  }
  return cs_body(stmts, ConstSubst { names: [], values: [], bound: bound, types: types, enums: enums, enum_assoc: enum_assoc });
}

function cs_bind(c: ConstSubst, packed: string): ConstSubst {
  let bound: string[] = c.bound;
  for name in append_bound_name([], packed) {
    bound = bound.append(name);
  }
  return ConstSubst { ...c, bound: bound };
}

function cs_expr(e: ast.Expr, c: ConstSubst): ast.Expr {
  let (out, tail, handled) = map_expr_acc(e, c, cs_stmt_at, cs_expr_at);
  return out;
}

function cs_body(stmts: ast.Stmt[], c: ConstSubst): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur: ConstSubst = c;
  for st in stmts {
    let (next, tail, handled) = map_stmt_acc(st, cur, cs_stmt_at, cs_expr_at);
    out = out.append(next);
    cur = tail;
  }
  return out;
}

function cs_expr_at(e: ast.Expr, c: ConstSubst): (ast.Expr, ConstSubst, boolean) {
  match (e) {
    ast.ExprIdent(i) => {
      if (!util.has_str(c.bound, i.name)) {
        let k: i32 = util.index_of_str(c.names, i.name);
        if (k >= 0) {
          return (placed_at(c.values[k], i.line, i.col), c, true);
        }
      }
      return (e, c, true);
    },
    ast.ExprLambda(lm) => {
      let inner: ConstSubst = c;
      for p in lm.params {
        inner = cs_bind(inner, p.name);
      }
      return (ast.ExprLambda { ...lm, body: cs_body(lm.body, inner) }, c, true);
    },
    ast.ExprCall(call) => {
      return cs_call_at(e, call, c);
    },
    ast.ExprFieldAccess(fa) => {
      return cs_field_read_at(e, fa, c);
    },
    _ => {
      return (e, c, false);
    }
  }
  return (e, c, false);
}

function cs_call_at(e: ast.Expr, call: ast.ExprCall, c: ConstSubst): (ast.Expr, ConstSubst, boolean) {
  if let ast.ExprFieldAccess(cfa) = call.callee {
    let args: ast.Expr[] = [];
    for a in call.args {
      args = args.append(cs_expr(a, c));
    }
    return (ast.ExprCall { ...call, callee: ast.ExprFieldAccess { ...cfa, obj: cs_expr(cfa.obj, c) }, args: args }, c, true);
  }
  return (e, c, false);
}

function cs_field_read_at(e: ast.Expr, fa: ast.ExprFieldAccess, c: ConstSubst): (ast.Expr, ConstSubst, boolean) {
  if (c.types.len() == 0) {
    return (e, c, false);
  }
  if let ast.ExprIdent(oid) = fa.obj {
    if (util.has_str(c.bound, oid.name) || !util.has_str(c.types, oid.name)) {
      return (e, c, false);
    }
    if (util.has_str(c.enums, oid.name) && !util.has_str(c.enum_assoc, oid.name + "." + fa.field)) {
      return (e, c, false);
    }
    return (ast.ExprCall { callee: ast.ExprFieldAccess { ...fa, const_read: true }, args: [], line: fa.line, col: fa.col, type_args: [], ty: "" }, c, true);
  }
  return (e, c, false);
}

function placed_at(e: ast.Expr, line: i32, col: i32): ast.Expr {
  match (e) {
    ast.ExprNumber(n) => {
      return ast.ExprNumber { ...n, line: line, col: col };
    },
    ast.ExprString(sv) => {
      return ast.ExprString { ...sv, line: line, col: col };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { ...u, operand: placed_at(u.operand, line, col), line: line, col: col };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { ...b, left: placed_at(b.left, line, col), right: placed_at(b.right, line, col), line: line, col: col };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function cs_stmt_at(st: ast.Stmt, c: ConstSubst): (ast.Stmt, ConstSubst, boolean) {
  match (st) {
    ast.StmtVar(v) => {
      let before: ConstSubst = c;
      if (ast.var_binds_itself(v)) {
        before = cs_bind(before, v.name);
      }
      return (ast.StmtVar { ...v, init: cs_expr(v.init, before) }, cs_bind(c, v.name), true);
    },
    ast.StmtIf(f) => {
      return (ast.StmtIf { ...f, cond: cs_expr(f.cond, c), then_body: cs_body(f.then_body, c), else_body: cs_body(f.else_body, c) }, c, true);
    },
    ast.StmtWhile(w) => {
      return (ast.StmtWhile { ...w, cond: cs_expr(w.cond, c), body: cs_body(w.body, c) }, c, true);
    },
    ast.StmtFor(f) => {
      return (ast.StmtFor { ...f, iter: cs_expr(f.iter, c), body: cs_body(f.body, cs_bind(c, f.var_name)) }, c, true);
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      for arm in m.arms {
        let inner: ConstSubst = c;
        for n in pattern_binders(arm.pattern, []) {
          inner = cs_bind(inner, n);
        }
        let guard: ast.Expr = arm.guard;
        if (arm.has_guard) {
          guard = cs_expr(guard, inner);
        }
        arms = arms.append(ast.MatchArm { ...arm, guard: guard, body: cs_body(arm.body, inner) });
      }
      return (ast.StmtMatch { ...m, scrutinee: cs_expr(m.scrutinee, c), arms: arms }, c, true);
    },
    ast.StmtDefer(d) => {
      let (action, tail, handled) = map_stmt_acc(d.action, c, cs_stmt_at, cs_expr_at);
      return (ast.StmtDefer { ...d, action: action }, c, true);
    },
    _ => {
      return (st, c, false);
    }
  }
  return (st, c, false);
}
