import "./ssa";
import "./ssasem";
import "./typeinfo";
import "./util";

pub struct Escapes { name: string, bits: boolean[], lends: boolean, cycle: i32, quiet: boolean[] }

pub struct Index { head: i32[], next: i32[] }

pub function index(rows: Escapes[]): Index {
  let nb: i32 = rows.len() * 2 + 1;
  let head: i32[] = util.minus_ones(nb);
  let next: i32[] = util.minus_ones(rows.len());
  let k: i32 = rows.len() - 1;
  while (k >= 0) {
    let b: i32 = util.hash_bucket(rows[k].name, nb);
    next = next.with(k, head[b]);
    head = head.with(b, k);
    k = k - 1;
  }
  return Index { head: head, next: next };
}

pub function find(rows: Escapes[], ix: Index, name: string): i32 {
  let i: i32 = ix.head[util.hash_bucket(name, ix.head.len())];
  while (i >= 0) {
    if (rows[i].name == name) {
      return i;
    }
    i = ix.next[i];
  }
  return 0 - 1;
}

pub function consumed_at(rows: Escapes[], row: i32, at: i32): boolean {
  if (row < 0) {
    return true;
  }
  if (at < 0 || at >= rows[row].bits.len()) {
    return true;
  }
  return rows[row].bits[at];
}

pub function address_taken(f: ssasem.Func, seen: string[]): string[] {
  let out: string[] = seen;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.closure_new() && ins.str != "") {
        out = out.append(ins.str);
      }
    }
  }
  return out;
}

function all_true(n: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(true);
    i = i + 1;
  }
  return out;
}

function builds_out(kind: i32): boolean {
  return constructs_container(kind) || kind == ssasem.cell_set()
    || kind == ssasem.map_insert() || kind == ssasem.hole_fill();
}

function constructs_container(kind: i32): boolean {
  return kind == ssasem.array_new() || kind == ssasem.bytes_new() || kind == ssasem.tuple_new()
    || kind == ssasem.record_new() || kind == ssasem.variant_new() || kind == ssasem.closure_new()
    || kind == ssasem.cell_new() || kind == ssasem.dyn_box();
}

function stores_after_receiver(kind: i32): boolean {
  return kind == ssasem.append() || kind == ssasem.with();
}

function carry(own out: boolean[], a: ssasem.Analysis, v: i32): boolean[] {
  if (v < 0 || v >= out.len()) {
    return out;
  }
  out = out.with(v, true);
  for dep in a.dependencies[v] {
    if (dep >= 0 && dep < out.len()) {
      out = out.with(dep, true);
    }
  }
  return out;
}

function same_cycle(rows: Escapes[], caller: i32, callee: i32): boolean {
  return caller >= 0 && callee >= 0 && rows[caller].cycle >= 0 && rows[caller].cycle == rows[callee].cycle;
}

function quiet_slot(rows: Escapes[], row: i32, slot: i32): boolean {
  return slot >= 0 && slot < rows[row].quiet.len() && rows[row].quiet[slot];
}

pub function cycles(succ: i32[][]): i32[] {
  let n: i32 = succ.len();
  let order: i32[] = [];
  let low: i32[] = [];
  let on: boolean[] = [];
  let comp: i32[] = [];
  let stack: i32[] = [];
  let work: i32[] = [];
  let edge: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    order = order.append(0 - 1);
    low = low.append(0);
    on = on.append(false);
    comp = comp.append(0 - 1);
    stack = stack.append(0);
    work = work.append(0);
    edge = edge.append(0);
    i = i + 1;
  }
  let slen: i32 = 0;
  let wlen: i32 = 0;
  let counter: i32 = 0;
  let ncomp: i32 = 0;
  let s: i32 = 0;
  while (s < n) {
    if (order[s] < 0) {
      order = order.with(s, counter);
      low = low.with(s, counter);
      counter = counter + 1;
      stack = stack.with(slen, s);
      slen = slen + 1;
      on = on.with(s, true);
      work = work.with(0, s);
      edge = edge.with(0, 0);
      wlen = 1;
      while (wlen > 0) {
        let top: i32 = wlen - 1;
        let v: i32 = work[top];
        let e: i32 = edge[top];
        if (e < succ[v].len()) {
          edge = edge.with(top, e + 1);
          let w: i32 = succ[v][e];
          if (order[w] < 0) {
            order = order.with(w, counter);
            low = low.with(w, counter);
            counter = counter + 1;
            stack = stack.with(slen, w);
            slen = slen + 1;
            on = on.with(w, true);
            work = work.with(wlen, w);
            edge = edge.with(wlen, 0);
            wlen = wlen + 1;
          } else if (on[w] && order[w] < low[v]) {
            low = low.with(v, order[w]);
          }
        } else {
          wlen = top;
          if (top > 0 && low[v] < low[work[top - 1]]) {
            low = low.with(work[top - 1], low[v]);
          }
          if (low[v] == order[v]) {
            let first: i32 = slen - 1;
            while (stack[first] != v) {
              first = first - 1;
            }
            let cyclic: boolean = slen - first > 1 || util.index_of_i32(succ[v], v) >= 0;
            let k: i32 = first;
            while (k < slen) {
              on = on.with(stack[k], false);
              if (cyclic) {
                comp = comp.with(stack[k], ncomp);
              }
              k = k + 1;
            }
            if (cyclic) {
              ncomp = ncomp + 1;
            }
            slen = first;
          }
        }
      }
    }
    s = s + 1;
  }
  return comp;
}

function call_carried(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst, rows: Escapes[], ix: Index, fr: Frame): boolean[] {
  if (ssasem.is_dyn_call(ins.str)) {
    return out;
  }
  let row: i32 = find(rows, ix, ins.str);
  let cycle: boolean = same_cycle(rows, fr.me, row);
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let unchanged: boolean = ins.str == f.graph.name && unchanged_slot(fr, ins.args[i], i) || cycle && quiet_slot(rows, row, i);
    if (!unchanged && ssasem.reference(f.values[ins.args[i]]) && consumed_at(rows, row, i)) {
      out = carry(out, a, ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

function unchanged_slot(fr: Frame, value: i32, slot: i32): boolean {
  return value == slot || value >= 0 && value < fr.forwards.len() && fr.forwards[value] == slot;
}

struct Frame { me: i32, forwards: i32[] }

function forwarded(f: ssasem.Func): i32[] {
  let out: i32[] = util.minus_ones(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (slot_phi(ins) && ins.str == f.graph.name && ins.result >= 0 && ins.result < out.len() && only_forwards(ins)) {
        out = out.with(ins.result, ins.imm);
      }
    }
  }
  return out;
}

function only_forwards(ins: ssa.SInst): boolean {
  for arg in ins.args {
    if (arg != ins.result && arg != ins.imm) {
      return false;
    }
  }
  return true;
}

function indirect_carried(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst): boolean[] {
  let callee: typeinfo.Type = f.values[ins.args[0]];
  let i: i32 = 1;
  while (i < ins.args.len()) {
    if (ssasem.func_param_own(callee, i - 1) && ssasem.reference(f.values[ins.args[i]])) {
      out = carry(out, a, ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

function slot_carried(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst, rows: Escapes[], ix: Index, fr: Frame): boolean[] {
  let row: i32 = find(rows, ix, ins.str);
  if (same_cycle(rows, fr.me, row) && quiet_slot(rows, row, ins.imm) || !consumed_at(rows, row, ins.imm)) {
    return out;
  }
  let i: i32 = 1;
  while (i < ins.args.len()) {
    if (ins.args[i] != ins.result && ssasem.reference(f.values[ins.args[i]])) {
      out = carry(out, a, ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

function slot_phi(ins: ssa.SInst): boolean {
  return ins.kind_tag == 8 && ins.str != "";
}

function continued(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis): boolean[] {
  let phis: ssa.SInst[] = [];
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 8) {
        phis = phis.append(ins);
      }
    }
  }
  let changed: boolean = phis.len() > 0;
  while (changed) {
    changed = false;
    for ins in phis {
      if (!out[ins.result]) {
        continue;
      }
      let n: i32 = ins.args.len();
      if (slot_phi(ins)) {
        n = 1;
      }
      let i: i32 = 0;
      while (i < n) {
        let arg: i32 = ins.args[i];
        if (arg >= 0 && arg < out.len() && !out[arg] && ssasem.reference(f.values[arg])) {
          out = carry(out, a, arg);
          changed = true;
        }
        i = i + 1;
      }
    }
  }
  return out;
}

function instruction_carried(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst, rows: Escapes[], ix: Index, fr: Frame): boolean[] {
  if (ins.kind_tag == ssasem.call()) {
    return call_carried(out, f, a, ins, rows, ix, fr);
  }
  if (slot_phi(ins)) {
    return slot_carried(out, f, a, ins, rows, ix, fr);
  }
  if (ins.kind_tag == ssasem.call_value()) {
    return indirect_carried(out, f, a, ins);
  }
  if (ssasem.update_base(ins) >= 0) {
    out = carry(out, a, ssasem.update_base(ins));
  }
  if (builds_out(ins.kind_tag)) {
    for arg in ins.args {
      if (ssasem.reference(f.values[arg])) {
        out = carry(out, a, arg);
      }
    }
    return out;
  }
  if (stores_after_receiver(ins.kind_tag)) {
    let i: i32 = 1;
    while (i < ins.args.len()) {
      if (ssasem.reference(f.values[ins.args[i]])) {
        out = carry(out, a, ins.args[i]);
      }
      i = i + 1;
    }
  }
  return out;
}

function lent_values(own out: boolean[], f: ssasem.Func, a: ssasem.Analysis, ins: ssa.SInst, rows: Escapes[], ix: Index): boolean[] {
  let at: i32 = find(rows, ix, ins.str);
  if (at >= 0 && !rows[at].lends) {
    return out;
  }
  let i: i32 = 0;
  while (i < ins.args.len()) {
    if (ssasem.reference(f.values[ins.args[i]]) && !consumed_at(rows, at, i)) {
      out = carry(out, a, ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

function lent_out(f: ssasem.Func, a: ssasem.Analysis, rows: Escapes[], ix: Index): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call()) {
        out = lent_values(out, f, a, ins, rows, ix);
      }
    }
  }
  return out;
}

pub function lends(f: ssasem.Func, a: ssasem.Analysis, rows: Escapes[], ix: Index): boolean {
  if (!a.ok) {
    return true;
  }
  let lent: boolean[] = lent_out(f, a, rows, ix);
  let i: i32 = 0;
  while (i < f.params.len() && i < lent.len()) {
    if (lent[i]) {
      return true;
    }
    i = i + 1;
  }
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1 && b.term.value >= 0 && ssasem.is_view(f.values[b.term.value])) {
      return true;
    }
  }
  return false;
}

function carried_values(f: ssasem.Func, a: ssasem.Analysis, rows: Escapes[], ix: Index): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let fr: Frame = Frame { me: find(rows, ix, f.graph.name), forwards: [] };
  for b in f.graph.blocks {
    for ins in b.insts {
      if (fr.forwards.len() == 0 && ins.kind_tag == ssasem.call() && ins.str == f.graph.name) {
        fr = Frame { ...fr, forwards: forwarded(f) };
      }
      out = instruction_carried(out, f, a, ins, rows, ix, fr);
    }
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      out = out.with(b.term.value, true);
    }
  }
  return continued(out, f, a);
}

pub function escaping(f: ssasem.Func, a: ssasem.Analysis, rows: Escapes[], ix: Index): boolean[] {
  if (!a.ok) {
    return all_true(f.params.len());
  }
  let carried: boolean[] = carried_values(f, a, rows, ix);
  let lent: boolean[] = lent_out(f, a, rows, ix);
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < f.params.len()) {
    out = out.append(i < carried.len() && carried[i] && !(i < lent.len() && lent[i]));
    i = i + 1;
  }
  return out;
}
