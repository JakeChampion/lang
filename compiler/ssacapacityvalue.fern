import "./ssaaffinevalue" as affine;
pub use "./ssaaffinevalue".{Value, unknown};
import "./ssacondition" as condition;
pub use "./ssacondition".{Comparison};
import "core/cmp";

pub struct Interval { low: i32, high: i32 }

pub function valid_interval(r: Interval): boolean {
  return r.low >= 1 && r.low <= r.high && r.high <= 65535;
}

function bounded(n: i64): boolean {
  return n >= -(4294967295 as i64) && n <= 4294967295 as i64;
}

function endpoint(v: affine.Value, n: i32): i64 {
  return v.factor as i64 * (n as i64) + v.offset;
}

pub function valid(r: Interval, v: affine.Value): boolean {
  if (!valid_interval(r) || v.factor != 0 && v.factor != 1 || !bounded(v.offset)) {
    return false;
  }
  return bounded(endpoint(v, r.low)) && bounded(endpoint(v, r.high));
}

function checked(r: Interval, v: affine.Value): affine.Value {
  return if (valid(r, v)) { v } else { affine.unknown() };
}

pub function number(r: Interval, n: i64): affine.Value {
  return checked(r, affine.Value { factor: 0, offset: n });
}

pub function original(r: Interval): affine.Value {
  return checked(r, affine.Value { factor: 1, offset: 0 as i64 });
}

pub function add(r: Interval, v: affine.Value, delta: i64): affine.Value {
  if (!valid(r, v) || !bounded(delta)) {
    return affine.unknown();
  }
  return checked(r, affine.Value { factor: v.factor, offset: v.offset + delta });
}

pub function negate(r: Interval, v: affine.Value): affine.Value {
  if (!valid(r, v) || v.factor != 0) {
    return affine.unknown();
  }
  return number(r, -v.offset);
}

pub function zero32(r: Interval, v: affine.Value): affine.Value {
  if (!valid(r, v)) {
    return affine.unknown();
  }
  if (endpoint(v, r.low) >= 0) {
    return v;
  }
  if (endpoint(v, r.high) < 0) {
    return checked(r, affine.Value { factor: v.factor, offset: v.offset + 4294967296 as i64 });
  }
  return affine.unknown();
}

pub function power(bit: i32): i64 {
  if (bit < 0 || bit > 31) {
    return 0 as i64;
  }
  let result = 1 as i64;
  for at in 0..bit {
    result *= 2 as i64;
  }
  return result;
}

function highest(n: i64): i32 {
  let rest = n;
  let bit = -1;
  while (rest > 0) {
    rest /= 2 as i64;
    bit += 1;
  }
  return bit;
}

pub function bit_scan(r: Interval, v: affine.Value): i32 {
  if (!valid(r, v) || endpoint(v, r.low) <= 0) {
    return -1;
  }
  let bit = highest(endpoint(v, r.low));
  return if (bit == highest(endpoint(v, r.high))) { bit } else { -1 };
}

pub function mask(r: Interval, v: affine.Value, m: affine.Value): affine.Value {
  if (!valid(r, v) || !valid(r, m) || m.factor != 0 || m.offset >= 0) {
    return affine.unknown();
  }
  let step = -m.offset;
  if (power(highest(step)) != step || endpoint(v, r.low) < 0) {
    return affine.unknown();
  }
  let low = endpoint(v, r.low) / step;
  let high = endpoint(v, r.high) / step;
  return if (low == high) { number(r, low * step) } else { affine.unknown() };
}

pub function compare(r: Interval, v: affine.Value, n: i64): condition.Comparison {
  if (!valid(r, v) || !bounded(n)) {
    return condition.unknown_order();
  }
  return condition.compare_interval(endpoint(v, r.low), endpoint(v, r.high), n);
}

pub function intervals(): Interval[] {
  let result = [Interval { low: 1, high: 256 }];
  for bit in 8..16 {
    let step = power(bit - 2) as i32;
    let low = power(bit) as i32;
    let high = power(bit + 1) as i32 - 1;
    low = cmp.max(low, 257);
    while (low <= high) {
      let rounded = ((low - 1) / step + 1) * step;
      let end = cmp.min(rounded, high);
      result = result.append(Interval { low: low, high: end });
      low = end + 1;
    }
  }
  return result;
}

pub function expected(r: Interval): affine.Value {
  if (!valid_interval(r)) {
    return affine.unknown();
  }
  if (r.high <= 256) {
    return original(r);
  }
  let bit = bit_scan(r, original(r));
  if (r.low <= 256 || bit < 8) {
    return affine.unknown();
  }
  let step = power(bit - 2);
  let low = ((r.low as i64 - 1 as i64) / step + 1 as i64) * step;
  let high = ((r.high as i64 - 1 as i64) / step + 1 as i64) * step;
  if (low != high) {
    return affine.unknown();
  }
  return number(r, cmp.min(low, 65535 as i64));
}
