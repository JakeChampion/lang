// Register and memory facts for allocation, capacity, and release proofs.
import "./ssacondition" as condition;
import "./ssaaffinevalue" as affine;
import "./ssaaffinehalf" as half;

pub struct Word { low: half.Half, high: half.Half, full: affine.Value }

pub struct State { regs: Word[], cells: half.Half[], flags: condition.Flags, ok: boolean, zeros: i32, links: i32, slots: i32, call_return: i32, grown: boolean, family: i32, buffer_links: i32, buffer_slots: i32, oversized: boolean, block_writes: i32, slot_writes: i32, writes: i32[], zero: i32, carry: i32, sign: i32, overflow: i32, bounded: boolean, choice: i32, mappings: i32, advised: boolean, calls: i32, successor: i32 }

pub function initial(regs: Word[], cells: half.Half[], grown: boolean, family: i32): State {
  return State { regs: regs, cells: cells, flags: condition.unknown_flags(), ok: true, zeros: 0, links: 0, slots: 0, call_return: -1, grown: grown, family: family, buffer_links: 0, buffer_slots: 0, oversized: false, block_writes: 0, slot_writes: 0, writes: [], zero: -1, carry: -1, sign: -1, overflow: -1, bounded: false, choice: 0, mappings: 0, advised: false, calls: 0, successor: -1 };
}

pub function from_halves(low: half.Half, high: half.Half): Word {
  return Word { low: low, high: high, full: affine.unknown() };
}

pub function identity(kind: i32, id: i32): Word {
  return from_halves(half.token(kind, id, 0), half.token(kind, id, 1));
}

pub function numeric_half(v: affine.Value): half.Half {
  return half.Half { kind: 1, identity: 0, part: 0, number: v };
}

pub function same_word(a: Word, b: Word): boolean {
  return half.same_half(a.low, b.low) && half.same_half(a.high, b.high) && a.full.factor == b.full.factor && a.full.offset == b.full.offset && a.full.residue == b.full.residue;
}

pub function write(s: State, reg: i32, w: Word): State {
  return State { ...s, regs: s.regs.with(reg, w), ok: s.ok && w.low.kind != 0 && w.high.kind != 0 };
}

pub function pointer(w: Word, kind: i32): boolean {
  return w.low.kind == kind && same_word(w, identity(kind, w.low.identity as i32));
}

pub function extent(at: i64, low: i32, high: i32, width: i32): boolean {
  return (width == 32 || width == 64) && at >= low as i64 && at + (width / 8) as i64 <= high as i64 && at % (4 as i64) == 0;
}

pub function read(s: State, at: i32, width: i32, zero: half.Half): Word {
  if (at < 0) {
    return identity(0, 0);
  }
  return from_halves(s.cells[at], if (width == 64) { s.cells[at + 1] } else { zero });
}

pub function put(s: State, at: i32, width: i32, w: Word): State {
  let cells = s.cells.with(at, w.low);
  if (width == 64) {
    cells = cells.with(at + 1, w.high);
  }
  return State { ...s, cells: cells };
}

pub function with_order(s: State, order: condition.Comparison): State {
  return State { ...s, flags: condition.Flags { ...s.flags, order: order } };
}
