import "./ir";
import "./ssa";
import "./util";

pub struct ReturnPos { block: i32, line: i32, col: string }

pub struct Lifted { func: ssa.SFunc, seen_vals: i32[], seen_slots: i32[], source_returns: ReturnPos[], source_values: i64[] }

function splice(insts: ssa.SInst[], more: ssa.SInst[]): ssa.SInst[] {
  for x in more {
    insts = insts.append(x);
  }
  return insts;
}

function drop_last(a: i32[]): i32[] {
  let out: i32[] = [];
  let i = 0;
  while (i < a.len() - 1) {
    out = out.append(a[i]);
    i += 1;
  }
  return out;
}

function drop_last2(a: i32[]): i32[] {
  let out: i32[] = [];
  let i = 0;
  while (i < a.len() - 2) {
    out = out.append(a[i]);
    i += 1;
  }
  return out;
}

function put_at(own xs: i32[], d: i32, v: i32): i32[] {
  if (d < xs.len()) {
    return xs.with(d, v);
  }
  return xs.append(v);
}

function scope_edges(link: i32[], last: i32): i32[] {
  let n = 0;
  let e = last;
  while (e >= 0) {
    n += 1;
    e = link[e];
  }
  let out = __alloc_i32(n);
  e = last;
  while (e >= 0) {
    n -= 1;
    out = out.with(n, e);
    e = link[e];
  }
  return out;
}

function put_at_s(own xs: string[], d: i32, v: string): string[] {
  if (d < xs.len()) {
    return xs.with(d, v);
  }
  return xs.append(v);
}

struct LiftVals { nvals: i32, stack: i32[], insts: ssa.SInst[], ok: boolean }

function bin_sym(k: string): string {
  if (k == "add") {
    return "+";
  }
  if (k == "sub") {
    return "-";
  }
  if (k == "mul") {
    return "*";
  }
  if (k == "div_s") {
    return "/";
  }
  if (k == "div_u") {
    return "/";
  }
  if (k == "rem_s") {
    return "%";
  }
  if (k == "rem_u") {
    return "%";
  }
  if (k == "eq") {
    return "==";
  }
  if (k == "ne") {
    return "!=";
  }
  if (k == "lt_s") {
    return "<";
  }
  if (k == "lt_u") {
    return "<";
  }
  if (k == "le_s") {
    return "<=";
  }
  if (k == "le_u") {
    return "<=";
  }
  if (k == "gt_s") {
    return ">";
  }
  if (k == "gt_u") {
    return ">";
  }
  if (k == "ge_s") {
    return ">=";
  }
  if (k == "ge_u") {
    return ">=";
  }
  if (k == "and") {
    return "&";
  }
  if (k == "or") {
    return "|";
  }
  if (k == "xor") {
    return "^";
  }
  if (k == "shl") {
    return "<<";
  }
  if (k == "shr_s") {
    return ">>";
  }
  if (k == "shr_u") {
    return ">>";
  }
  if (k == "mulhi_u") {
    return "*hi";
  }
  if (k == "mulhi_s") {
    return "*hs";
  }
  return "";
}

function drop_n(a: i32[], n: i32): i32[] {
  let out: i32[] = [];
  let i = 0;
  while (i < a.len() - n) {
    out = out.append(a[i]);
    i += 1;
  }
  return out;
}

function fbin_sym(k: string): string {
  if (k == "fadd") {
    return "+";
  }
  if (k == "fsub") {
    return "-";
  }
  if (k == "fmul") {
    return "*";
  }
  if (k == "fdiv") {
    return "/";
  }
  if (k == "feq") {
    return "==";
  }
  if (k == "fne") {
    return "!=";
  }
  if (k == "flt") {
    return "<";
  }
  if (k == "fle") {
    return "<=";
  }
  if (k == "fgt") {
    return ">";
  }
  if (k == "fge") {
    return ">=";
  }
  return "";
}

pub function admits(kt: KindTable, op: ir.Op): boolean {
  return op.kind_tag >= 0 && op.kind_tag < kt.classes.len() && (kt.classes[op.kind_tag] & 1) != 0 || flat_arm_op(op);
}

function flat_name(k: string, op: ir.Op): string {
  if (k == "scale_f64" && op.i32_imm == 1) {
    return "scale_f64_in_place";
  }
  return k;
}

function flat_arm_op(op: ir.Op): boolean {
  if (op.kind_tag == ir.K_DYN_DISPATCH) {
    return false;
  }
  return ir.op_pops(op) >= 0 && ir.op_pushes(op) == 1;
}

pub struct KindTable { names: string[], classes: i32[], argc: i32[], host: boolean[], pops: i32[] }

pub function kind_table(): KindTable {
  let facts = kind_facts();
  let names: string[] = [];
  let classes: i32[] = [];
  let argc: i32[] = [];
  let host: boolean[] = [];
  let id = 0;
  while (id < 1024) {
    let k = ir.kind_name(id);
    let at = facts.ix.find(k);
    let listed = 0;
    let n = 0;
    let h = false;
    if (at >= 0) {
      listed = facts.bits[at];
      n = facts.argc[at];
      h = facts.host[at];
    }
    let bin = bin_sym(k) != "";
    let mem = (listed & 2) != 0 || n > 0 || h;
    let flt = (listed & 4) != 0 || fbin_sym(k) != "";
    let c = listed & 16;
    if (bin || (listed & 17) != 0 || mem || flt) {
      c += 1;
    }
    if (mem) {
      c += 2;
    }
    if (flt) {
      c += 4;
    }
    if (bin) {
      c += 8;
    }
    names = names.append(k);
    classes = classes.append(c);
    argc = argc.append(n);
    host = host.append(h);
    id += 1;
  }
  return KindTable { names: names, classes: classes, argc: argc, host: host, pops: ir.pops_by_kind() };
}

struct KindFacts { ix: util.NameIndex, bits: i32[], argc: i32[], host: boolean[] }

function kind_facts(): KindFacts {
  let spine: string[] = [
    "const_i32", "const_i32_text", "const_i64",
    "int_extend", "int_wrap", "int_cast", "u32_wrap", "not",
    "load_local", "store_local", "tee_local", "drop", "return",
    "block", "loop", "if", "else", "end", "br", "brif", "call_direct", "dyn_dispatch",
  ];
  let mem: string[] = [
    "struct_get", "struct_set", "tuple_set", "arr_len", "str_len", "str_data", "tuple_get", "opt_tag", "opt_payload", "opt_set_payload",
    "arr_get", "arr_set", "str_index", "const_func", "const_str", "variant_is", "struct_set_shape",
    "struct_make", "arr_make", "tuple_make", "opt_make", "str_slice",
    "raw_load_ptr", "raw_store_ptr", "raw_load8", "raw_store8", "const_struct", "call_indirect",
  ];
  let two: string[] = ["str_concat", "str_eq", "str_cmp", "arr_push", "arr_push_owned", "arr_push_i64", "arr_push_f64", "arr_push_owned_i64", "arr_push_owned_f64"];
  let one: string[] = [
    "str_from_bytes", "alloc", "alloc_u8", "raw_alloc", "print_str", "eprint_str",
    "read_file", "read_file_bytes", "remove_dir_all", "remove_file", "create_dir_all",
    "read_dir", "read_dir_all", "read_dir_ino", "read_dir_ino_all", "env", "stat", "lstat", "putchar", "temp_dir", "reader_close",
  ];
  let three: string[] = ["arr_slice", "subprocess", "str_from_bytes_range"];
  let two_io: string[] = ["write_file", "write_file_bytes", "write_file_exec", "read_chunk", "read_chunk_bytes", "write_bytes", "write_some_bytes", "writer_write"];
  let host: string[] = [
    "syscall3", "syscall4", "syscall5", "syscall6", "exit", "raw_string",
    "raw_scratch", "raw_environ", "raw_splice_pipe", "raw_cover", "line", "raw_task_state", "raw_vdso", "raw_addr", "monotonic_ns", "now_unix_ms",
    "load_i32", "load_i64", "load_ptr", "store_i32", "store_i64", "store_ptr", "raw_arr_box",
    "map_new", "args", "map_hash_seed", "arr_push_shared_bytes", "arr_push_shared_count",
    "clz", "ctz", "popcount", "bswap", "mmio_load", "mmio_store", "fence", "wfi", "hvc", "smc", "port_in", "port_out",
  ];
  let f64_un: string[] = [
    "const_f64", "fsqrt", "ffloor", "fceil", "ftrunc", "fabs", "fround", "fneg",
    "i32_to_f64", "f64_to_i32", "f64_to_i64", "f32_bits", "f32_from_bits", "f64_bits", "f64_from_bits",
  ];
  let f = KindFacts { ix: util.name_index([]), bits: [], argc: [], host: [] };
  f = listed(f, spine, 1, 0, false);
  f = listed(f, mem, 2, 0, false);
  f = listed(f, two, 0, 2, false);
  f = listed(f, one, 0, 1, false);
  f = listed(f, three, 0, 3, false);
  f = listed(f, two_io, 0, 2, false);
  f = listed(f, host, 0, 0, true);
  f = listed(f, f64_un, 4, 0, false);
  return listed(f, ir.lane_kind_names(), 16, 0, false);
}

function listed(own f: KindFacts, names: string[], bit: i32, argc: i32, host: boolean): KindFacts {
  for n in names {
    let at = f.ix.find(n);
    if (at < 0) {
      f = KindFacts { ix: f.ix.added(n), bits: f.bits.append(bit), argc: f.argc.append(argc), host: f.host.append(host) };
    } else {
      let a = f.argc[at];
      if (a == 0) {
        a = argc;
      }
      f = KindFacts { ...f, bits: f.bits.with(at, f.bits[at] | bit), argc: f.argc.with(at, a), host: f.host.with(at, f.host[at] || host) };
    }
  }
  return f;
}

pub function lift_from_ir_prod(kt: KindTable, name: string, nparams: i32, nslots: i32, ops: ir.Op[], track_slots: boolean): Result[Lifted, string] {
  return lift_impl(kt, name, nparams, nslots, ops, track_slots);
}

pub function lift_with_lanes(kt: KindTable, name: string, nparams: i32, nslots: i32, ops: ir.Op[], track_slots: boolean, lane_slots: i32[]): Result[Lifted, string] {
  let l: Lifted = match (lift_impl(kt, name, nparams, nslots, ops, track_slots)) { Ok(lifted) => lifted, Err(message) => { return Err(message); } };
  if (lane_slots.len() == 0 || l.func.blocks.len() == 0) {
    return Ok(l);
  }
  let entry = l.func.blocks[0];
  let insts: ssa.SInst[] = [];
  for ins in entry.insts {
    if (ins.kind_tag == 6 && util.index_of_i32(lane_slots, ins.imm) >= 0) {
      ins = ssa.SInst { ...ins, str: ssa.lane_param_mark() };
    }
    insts = insts.append(ins);
  }
  let blocks = l.func.blocks.with(0, ssa.SBlock { ...entry, insts: insts });
  return Ok(Lifted { ...l, func: ssa.SFunc { ...l.func, blocks: blocks } });
}

function lift_lane_prod(k: string, op: ir.Op, nvals: i32, stack: i32[], insts: ssa.SInst[]): LiftVals {
  let argc = ir.op_pops(op);
  if (stack.len() < argc) {
    return LiftVals { nvals: nvals, stack: stack, insts: insts, ok: false };
  }
  let args: i32[] = [];
  let i = stack.len() - argc;
  while (i < stack.len()) {
    args = args.append(stack[i]);
    i += 1;
  }
  stack = drop_n(stack, argc);
  let what = k;
  if (k == "vextract" || k == "vreplace") {
    what = k + ":" + util.i32_to_string(op.i32_imm);
  }
  let kind = 10;
  if (ir.lane_writes(op.kind_tag)) {
    kind = 62;
  } else if (argc == 2) {
    kind = 9;
  } else if (argc == 3) {
    kind = 61;
  }
  let v = nvals;
  nvals += 1;
  insts = insts.append(ssa.SInst { kind_tag: kind, result: v, args: args, imm: op.width, str: what });
  if (!ir.lane_writes(op.kind_tag)) {
    stack = stack.append(v);
  }
  return LiftVals { nvals: nvals, stack: stack, insts: insts, ok: true };
}

function lift_float_prod(k: string, op: ir.Op, nvals: i32, stack: i32[], insts: ssa.SInst[]): LiftVals {
  let argc = 1;
  if (fbin_sym(k) != "") {
    argc = 2;
  }
  if (stack.len() < argc) {
    return LiftVals { nvals: nvals, stack: stack, insts: insts, ok: false };
  }
  let args: i32[] = [];
  let i = stack.len() - argc;
  while (i < stack.len()) {
    args = args.append(stack[i]);
    i += 1;
  }
  stack = drop_n(stack, argc);
  let v = nvals;
  nvals += 1;
  if (fbin_sym(k) != "") {
    insts = insts.append(ssa.SInst { kind_tag: 9, result: v, args: args, imm: 64, str: k });
  } else {
    let what = k;
    if (k == "i32_to_f64") {
      let w = register_width(op.width);
      if (w == 0) {
        w = 32;
      }
      what = k + ":" + util.i32_to_string(w);
    }
    let flag = 0;
    if (op.unsigned) {
      flag = 1;
    }
    insts = insts.append(ssa.SInst { kind_tag: 10, result: v, args: args, imm: flag, str: what });
  }
  stack = stack.append(v);
  return LiftVals { nvals: nvals, stack: stack, insts: insts, ok: true };
}

// A device op is a host call named dev_ and its kind, so no pass removes, merges
// or moves it. An MMIO access adds its width after a colon.
function lift_device(k: string, op: ir.Op, lv: LiftVals): LiftVals {
  let name = "dev_" + k;
  if (op.width > 0) {
    name = name + ":" + util.i32_to_string(op.width);
  }
  return lift_pop_push(lv, ir.op_pops(op), 50, 0, name);
}

function lift_prod_host(k: string, op: ir.Op, lv: LiftVals): LiftVals {
  if (k == "line") {
    return lift_line(op, lv);
  }
  if (k == "clz" || k == "ctz" || k == "popcount" || k == "bswap") {
    return lift_pop_push(lv, 1, 10, 0, k + ":" + util.i32_to_string(op.width));
  }
  if (k == "map_new") {
    return lift_pop_push(lv, 1, 50, 0, k);
  }
  if (ir.is_device_kind(op.kind_tag)) {
    return lift_device(k, op, lv);
  }
  if (k == "args" || k == "map_hash_seed") {
    return lift_pop_push(lv, 0, 50, 0, k);
  }
  if (k == "arr_push_shared_bytes") {
    return lift_pop_push(lv, 0, 58, 1, "__fern_arr_push_copied");
  }
  if (k == "arr_push_shared_count") {
    return lift_pop_push(lv, 0, 58, 1, "__fern_arr_push_shared");
  }
  if (k == "load_i64" || k == "load_ptr") {
    return lift_pop_push(lv, 1, 40, 0, "");
  }
  if (k == "load_i32") {
    return lift_pop_push(lv, 1, 10, 0, k);
  }
  if (k == "store_i64" || k == "store_ptr" || k == "store_i32") {
    let stored = lift_store(lv, 41, 0);
    if (!stored.ok) {
      return stored;
    }
    if (k == "store_i32") {
      let last = stored.insts.len() - 1;
      stored = LiftVals { ...stored, insts: stored.insts.with(last, ssa.SInst { ...stored.insts[last], str: "i32" }) };
    }
    return lift_pop_push(stored, 0, 1, 0, "");
  }
  if (k == "raw_arr_box") {
    return lift_pop_push(lv, 1, 50, 0, k);
  }
  if (k == "syscall3") {
    return lift_pop_push(lv, 4, 50, 0, k);
  }
  if (k == "syscall4") {
    return lift_pop_push(lv, 5, 50, 0, k);
  }
  if (k == "syscall5") {
    return lift_pop_push(lv, 6, 50, 0, k);
  }
  if (k == "syscall6") {
    return lift_pop_push(lv, 7, 50, 0, k);
  }
  if (k == "raw_string") {
    if (op.i32_imm > 0) {
      return lift_pop_push(lv, 2, 51, 2, "");
    }
    return lift_pop_push(lv, 2, 50, 0, k);
  }
  if (k == "exit") {
    return lift_pop_push(lv, 1, 50, 0, k);
  }
  if (k == "raw_scratch") {
    return lift_pop_push(lv, 1, 58, 0, "__fern_scratch");
  }
  if (k == "raw_environ") {
    return lift_pop_push(lv, 0, 58, 1, "__fern_envp");
  }
  if (k == "raw_splice_pipe") {
    return lift_pop_push(lv, 0, 58, 0, "__fern_splice_pipe");
  }
  if (k == "raw_cover") {
    return lift_pop_push(lv, 0, 58, 0, "__fern_cov_counters");
  }
  if (k == "raw_task_state") {
    return lift_pop_push(lv, 0, 58, 0, "__fern_task_state");
  }
  if (k == "raw_vdso") {
    return lift_pop_push(lv, 0, 58, 0, "__fern_vdso");
  }
  if (k == "raw_addr") {
    return lift_pop_push(lv, 2, 9, 64, "add");
  }
  return lift_pop_push(lv, 0, 49, counted_bit(op), k);
}

function counted_bit(op: ir.Op): i32 {
  if (ir.is_counted(op)) {
    return 2;
  }
  return 0;
}

function packed_suffix(op: ir.Op): string {
  if (op.kind_tag == 171 && op.i32_imm != 0) {
    return "_bytes";
  }
  if (ir.is_packed(op)) {
    return "_u8";
  }
  return "";
}

function counted_mark(op: ir.Op): string {
  if (ir.is_counted(op)) {
    return "rc";
  }
  return "";
}

function packed_mark(op: ir.Op): string {
  if (ir.is_packed(op)) {
    return "u8";
  }
  return "";
}

function mark_packed(lv: LiftVals, op: ir.Op): LiftVals {
  if (!lv.ok || !ir.is_packed(op)) {
    return lv;
  }
  let last = lv.insts.len() - 1;
  return LiftVals { ...lv, insts: lv.insts.with(last, ssa.SInst { ...lv.insts[last], str: "u8" }) };
}

function unique_push(k: string, op: ir.Op): i32 {
  if (util.str_has_prefix(k, "arr_push_owned") && op.i32_imm == 1) {
    return 1;
  }
  return 0;
}

function prod_call_kind(k: string): i32 {
  if (k == "alloc" || k == "alloc_u8" || k == "raw_alloc" || util.str_has_prefix(k, "arr_push")) {
    return 50;
  }
  return 49;
}

function ld_off(k: string, op: ir.Op): i32 {
  if (k == "struct_get") {
    return (op.i32_imm + 1) * 8;
  }
  if (k == "arr_len" || k == "str_data" || k == "opt_tag") {
    return 0;
  }
  if (k == "str_len" || k == "opt_payload") {
    return 8;
  }
  if (k == "tuple_get") {
    return op.i32_imm * 8;
  }
  return -1;
}

function lift_prod_mem(kt: KindTable, tag: i32, k: string, op: ir.Op, nvals: i32, stack: i32[], cur_insts: ssa.SInst[]): LiftVals {
  let lv = LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: true };
  if (kt.host[tag]) {
    return lift_prod_host(k, op, lv);
  }
  if (util.str_has_prefix(k, "raw_store") || k == "struct_set" || k == "tuple_set" || k == "arr_set" || k == "opt_set_payload") {
    return lift_prod_store(k, op, lv);
  }
  if (k == "variant_is") {
    return lift_variant_is_prod(op, lv);
  }
  if (k == "struct_set_shape") {
    return lift_struct_set_shape_prod(op, lv);
  }
  if (k == "str_slice") {
    return lift_pop_push(lv, 3, 51, view_in_frame(op), "");
  }
  if (k == "call_indirect") {
    return lift_call_indirect_prod(op, lv);
  }
  if (kt.argc[tag] > 0) {
    return lift_pop_push(lv, kt.argc[tag], prod_call_kind(k), unique_push(k, op) + counted_bit(op), k + packed_suffix(op));
  }
  if let Some(made) = lift_prod_make(k, op, lv) {
    return made;
  }
  return lift_prod_read(k, op, lv);
}

function lift_call_indirect_prod(op: ir.Op, lv: LiftVals): LiftVals {
  let argc = op.i32_imm;
  if (lv.stack.len() < argc + 1) {
    return LiftVals { ...lv, ok: false };
  }
  let target = lv.stack[lv.stack.len() - 1];
  let args: i32[] = [target];
  let d = argc;
  while (d >= 1) {
    args = args.append(lv.stack[lv.stack.len() - 1 - d]);
    d -= 1;
  }
  let stack = lv.stack;
  let e = 0;
  while (e <= argc) {
    stack = drop_last(stack);
    e += 1;
  }
  let v = lv.nvals;
  let insts = lv.insts.append(ssa.SInst { kind_tag: 56, result: v, args: args, imm: op.i64_imm as i32, str: "" });
  return LiftVals { nvals: v + 1, stack: stack.append(v), insts: insts, ok: true };
}

function lift_prod_store(k: string, op: ir.Op, lv: LiftVals): LiftVals {
  if (k == "struct_set") {
    return lift_store(lv, 41, (op.i32_imm + 1) * 8);
  }
  if (k == "tuple_set") {
    return lift_store(lv, 41, op.i32_imm * 8);
  }
  if (k == "opt_set_payload") {
    return lift_store(lv, 41, 8);
  }
  if (k == "arr_set") {
    return mark_packed(lift_store(lv, 43, op.i32_imm), op);
  }
  if (k == "raw_store_ptr") {
    return lift_store_keep(lv, 53);
  }
  return lift_store_keep(lv, 55);
}

function lift_prod_make(k: string, op: ir.Op, lv: LiftVals): Option[LiftVals] {
  if (k == "struct_make") {
    return Some(lift_box_make(op.i32_imm + 1, op.i32_imm, 8, op.str, lv));
  }
  if (k == "arr_make" && op.i32_imm == 0) {
    return Some(lift_empty_arr(lv));
  }
  if (k == "arr_make" && ir.is_packed(op)) {
    return Some(lift_packed_make(op.i32_imm, lv));
  }
  if (k == "arr_make") {
    return Some(lift_box_make(op.i32_imm, op.i32_imm, 8, "", lv));
  }
  if (k == "tuple_make") {
    return Some(lift_box_make(op.i32_imm, op.i32_imm, 0, "", lv));
  }
  if (k == "opt_make") {
    return Some(lift_opt_make_prod(op.i32_imm, lv));
  }
  return None;
}

function view_in_frame(op: ir.Op): i32 {
  if (op.i32_imm > 0) {
    return 1;
  }
  return 0;
}

function lift_store_keep(lv: LiftVals, kind: i32): LiftVals {
  if (lv.stack.len() < 3) {
    return LiftVals { ...lv, ok: false };
  }
  let val = lv.stack[lv.stack.len() - 1];
  let stored = lift_store(lv, kind, 0);
  if (!stored.ok) {
    return stored;
  }
  return LiftVals { ...stored, stack: stored.stack.append(val) };
}

function lift_prod_read(k: string, op: ir.Op, lv: LiftVals): LiftVals {
  if (ld_off(k, op) >= 0) {
    return lift_pop_push(lv, 1, 40, ld_off(k, op), counted_mark(op));
  }
  if (k == "raw_load_ptr") {
    return lift_pop_push(lv, 2, 52, 0, "");
  }
  if (k == "raw_load8") {
    return lift_pop_push(lv, 2, 54, 0, "");
  }
  if (k == "arr_get") {
    return lift_pop_push(lv, 2, 42, op.i32_imm, packed_mark(op) + counted_mark(op));
  }
  if (k == "str_index") {
    return lift_pop_push(lv, 2, 44, op.i32_imm, "");
  }
  if (k == "const_func") {
    return lift_pop_push(lv, 0, 45, op.i32_imm, op.str);
  }
  if (k == "const_struct") {
    return lift_pop_push(lv, 0, 57, 0, op.str);
  }
  return lift_pop_push(lv, 0, 47, 0, op.str);
}

function lift_pop_push(lv: LiftVals, npop: i32, kind: i32, imm: i32, str: string): LiftVals {
  if (lv.stack.len() < npop) {
    return LiftVals { ...lv, ok: false };
  }
  let args: i32[] = [];
  let d = npop - 1;
  while (d >= 0) {
    args = args.append(lv.stack[lv.stack.len() - 1 - d]);
    d -= 1;
  }
  let stack = lv.stack;
  let e = 0;
  while (e < npop) {
    stack = drop_last(stack);
    e += 1;
  }
  let v = lv.nvals;
  let insts = lv.insts.append(ssa.SInst { kind_tag: kind, result: v, args: args, imm: imm, str: str });
  return LiftVals { nvals: v + 1, stack: stack.append(v), insts: insts, ok: true };
}

function lift_line(op: ir.Op, lv: LiftVals): LiftVals {
  let pushed = lift_pop_push(lv, 0, 35, op.i32_imm, util.i64_to_string(op.i64_imm));
  if (!pushed.ok) {
    return pushed;
  }
  return LiftVals { ...pushed, stack: drop_last(pushed.stack) };
}

function lift_store(lv: LiftVals, kind: i32, imm: i32): LiftVals {
  let npop = 2;
  if (kind == 43 || kind == 53 || kind == 55) {
    npop = 3;
  }
  let pushed = lift_pop_push(lv, npop, kind, imm, "");
  if (!pushed.ok) {
    return pushed;
  }
  return LiftVals { ...pushed, stack: drop_last(pushed.stack) };
}

function lift_struct_set_shape_prod(op: ir.Op, lv: LiftVals): LiftVals {
  if (lv.stack.len() < 1) {
    return LiftVals { ...lv, ok: false };
  }
  let box = lv.stack[lv.stack.len() - 1];
  let shape = lift_pop_push(lv, 0, 46, 0, op.str);
  if (!shape.ok) {
    return shape;
  }
  let stored = lift_store(shape, 41, 0);
  if (!stored.ok) {
    return stored;
  }
  return LiftVals { ...stored, stack: stored.stack.append(box) };
}

function lift_variant_is_prod(op: ir.Op, lv: LiftVals): LiftVals {
  let tag = lift_pop_push(lv, 1, 40, 0, "");
  if (!tag.ok) {
    return tag;
  }
  let shape = lift_pop_push(tag, 0, 46, 0, op.str);
  return lift_pop_push(shape, 2, 9, 0, "eq");
}

function lift_box_make(cap: i32, n: i32, first: i32, shape: string, lv: LiftVals): LiftVals {
  if (lv.stack.len() < n) {
    return LiftVals { ...lv, ok: false };
  }
  let elems: i32[] = [];
  let d = n - 1;
  while (d >= 0) {
    elems = elems.append(lv.stack[lv.stack.len() - 1 - d]);
    d -= 1;
  }
  let stack = lv.stack;
  let e = 0;
  while (e < n) {
    stack = drop_last(stack);
    e += 1;
  }
  let nvals = lv.nvals;
  let box = nvals;
  nvals += 1;
  let insts = lv.insts.append(ssa.SInst { kind_tag: 48, result: box, args: [], imm: cap, str: "" });
  if (shape.len() > 0) {
    let sh = nvals;
    nvals += 1;
    insts = insts.append(ssa.SInst { kind_tag: 46, result: sh, args: [], imm: 0, str: shape });
    insts = insts.append(ssa.SInst { kind_tag: 41, result: nvals, args: [box, sh], imm: 0, str: "" });
    nvals += 1;
  }
  let i = 0;
  while (i < n) {
    insts = insts.append(ssa.SInst { kind_tag: 41, result: nvals, args: [box, elems[i]], imm: first + i * 8, str: "" });
    nvals += 1;
    i += 1;
  }
  return LiftVals { nvals: nvals, stack: stack.append(box), insts: insts, ok: true };
}

function lift_packed_make(n: i32, lv: LiftVals): LiftVals {
  if (lv.stack.len() < n) {
    return LiftVals { ...lv, ok: false };
  }
  let elems: i32[] = [];
  let d = n - 1;
  while (d >= 0) {
    elems = elems.append(lv.stack[lv.stack.len() - 1 - d]);
    d -= 1;
  }
  let stack = lv.stack;
  let e = 0;
  while (e < n) {
    stack = drop_last(stack);
    e += 1;
  }
  let box = lv.nvals;
  let len = box + 1;
  let insts = lv.insts.append(ssa.SInst { kind_tag: 48, result: box, args: [], imm: (n + 7) / 8, str: "" });
  insts = insts.append(ssa.SInst { kind_tag: 1, result: len, args: [], imm: n, str: "" });
  insts = insts.append(ssa.SInst { kind_tag: 41, result: len + 1, args: [box, len], imm: 0, str: "" });
  let nvals = len + 2;
  let i = 0;
  while (i < n) {
    insts = insts.append(ssa.SInst { kind_tag: 41, result: nvals, args: [box, elems[i]], imm: 8 + i, str: "u8" });
    nvals += 1;
    i += 1;
  }
  return LiftVals { nvals: nvals, stack: stack.append(box), insts: insts, ok: true };
}

function lift_empty_arr(lv: LiftVals): LiftVals {
  let box = lv.nvals;
  let zero = box + 1;
  let insts = lv.insts.append(ssa.SInst { kind_tag: 48, result: box, args: [], imm: 4, str: "" });
  insts = insts.append(ssa.SInst { kind_tag: 1, result: zero, args: [], imm: 0, str: "" });
  insts = insts.append(ssa.SInst { kind_tag: 41, result: zero + 1, args: [box, zero], imm: 0, str: "" });
  return LiftVals { nvals: zero + 2, stack: lv.stack.append(box), insts: insts, ok: true };
}

function lift_opt_make_prod(tag: i32, lv: LiftVals): LiftVals {
  let stack = lv.stack;
  if (stack.len() < 1) {
    return LiftVals { ...lv, ok: false };
  }
  let payload = stack[stack.len() - 1];
  stack = drop_last(stack);
  let nvals = lv.nvals;
  let box = nvals;
  nvals += 1;
  let insts = lv.insts.append(ssa.SInst { kind_tag: 48, result: box, args: [], imm: 2, str: "" });
  let tv = nvals;
  nvals += 1;
  insts = insts.append(ssa.SInst { kind_tag: 1, result: tv, args: [], imm: tag, str: "" });
  insts = insts.append(ssa.SInst { kind_tag: 41, result: nvals, args: [box, tv], imm: 0, str: "" });
  nvals += 1;
  insts = insts.append(ssa.SInst { kind_tag: 41, result: nvals, args: [box, payload], imm: 8, str: "" });
  nvals += 1;
  return LiftVals { nvals: nvals, stack: stack.append(box), insts: insts, ok: true };
}

function lift_int_narrow_prod(k: string, op: ir.Op, nvals: i32, stack: i32[], cur_insts: ssa.SInst[], ok: boolean): LiftVals {
  if (stack.len() < 1) {
    return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: false };
  }
  if ((k == "int_extend" || k == "int_wrap") && op.width == ir.width_ptr()) {
    return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: ok };
  }
  let a = stack[stack.len() - 1];
  stack = drop_last(stack);
  let what = k;
  if (k == "int_cast") {
    what = "int_cast:" + op.str;
  }
  let flag = 0;
  if (op.unsigned) {
    flag = 1;
  }
  let v = nvals;
  nvals += 1;
  cur_insts = cur_insts.append(ssa.SInst { kind_tag: 10, result: v, args: [a], imm: flag, str: what });
  stack = stack.append(v);
  return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: ok };
}

function register_width(width: i32): i32 {
  if (width == ir.width_ptr()) {
    return 64;
  }
  return width;
}

function lift_const_text_prod(k: string, op: ir.Op, nvals: i32, stack: i32[], cur_insts: ssa.SInst[]): LiftVals {
  let width = 0;
  if (k == "const_i64" || op.width == ir.width_ptr()) {
    width = 64;
  }
  let v = nvals;
  nvals += 1;
  let text = op.str;
  if (k == "const_i64") {
    text = ir.const_i64_text(op);
  }
  cur_insts = cur_insts.append(ssa.SInst { kind_tag: 3, result: v, args: [], imm: width, str: text });
  stack = stack.append(v);
  return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: true };
}

function tracked(xs: i32[], on: boolean, x: i32): i32[] {
  if (!on) {
    return xs;
  }
  return xs.append(x);
}

function lift_impl(kt: KindTable, name: string, nparams: i32, nslots: i32, ops: ir.Op[], track_slots: boolean): Result[Lifted, string] {
  let nvals = 0;
  let seen_vals: i32[] = [];
  let seen_slots: i32[] = [];
  let source_returns: ReturnPos[] = [];
  let source_values: i64[] = [];
  let next_blk = 0;
  let bail = "";

  let blocks: ssa.SBlock[] = [];
  let cur_id = next_blk;
  next_blk += 1;
  let cur_insts: ssa.SInst[] = [];
  let cur_preds: i32[] = [];
  let cur_term = STerm_none();
  let cur_dead = false;

  let stack: i32[] = [];
  let slots: i32[] = [];
  let ok = true;

  let p = 0;
  while (p < nparams) {
    let pv = nvals;
    nvals += 1;
    cur_insts = cur_insts.append(ssa.SInst { kind_tag: 6, result: pv, args: [], imm: p, str: "" });
    slots = slots.append(pv);
    p += 1;
  }
  while (slots.len() < nslots) {
    let zv = nvals;
    nvals += 1;
    cur_insts = cur_insts.append(ssa.SInst { kind_tag: 1, result: zv, args: [], imm: 0, str: "" });
    slots = slots.append(zv);
  }

  let sc_kind: string[] = [];
  let sc_target: i32[] = [];
  let sc_else: i32[] = [];
  let sc_seen_else: i32[] = [];
  let sc_then_blk: i32[] = [];
  let sc_then_reaches: i32[] = [];
  let sc_parent: i32[] = [];
  let sc_edge_last: i32[] = [];
  let sc_blk_from: i32[] = [];
  let sc_dl_from: i32[] = [];
  let sc_tl_from: i32[] = [];
  let sc_lp_from: i32[] = [];
  let sc_op: i32[] = [];
  let sc_n = 0;
  let sc_outer_loop: i32 = -1;

  let slot_mark = filled(nslots, -1);
  let slot_pos = filled(nslots, -1);
  let matb: i32[] = [];
  let dl_slot: i32[] = [];
  let dl_old: i32[] = [];
  let dl_prev: i32[] = [];
  let dl_n = 0;
  let tl_slot: i32[] = [];
  let tl_val: i32[] = [];
  let tl_old: i32[] = [];
  let tl_prev: i32[] = [];
  let tl_n = 0;
  let lp_slot: i32[] = [];
  let lp_phi: i32[] = [];
  let lp_pre: i32[] = [];
  let lp_n = 0;

  let edge_link: i32[] = [];
  let edge_block: i32[] = [];
  let edge_from: i32[] = [];
  let ep_slot: i32[] = [];
  let ep_val: i32[] = [];

  let t_block = ir.K_BLOCK;
  let t_br = ir.K_BR;
  let t_brif = ir.K_BRIF;
  let t_call_direct = ir.K_CALL_DIRECT;
  let t_const_f64 = ir.K_CONST_F64;
  let t_const_i32 = ir.K_CONST_I32;
  let t_ptr_width = ir.K_PTR_WIDTH;
  let t_const_i32_text = ir.K_CONST_I32_TEXT;
  let t_const_i64 = ir.K_CONST_I64;
  let t_drop = ir.K_DROP;
  let t_dyn_dispatch = ir.K_DYN_DISPATCH;
  let t_else = ir.K_ELSE;
  let t_end = ir.K_END;
  let t_if = ir.K_IF;
  let t_int_cast = ir.K_INT_CAST;
  let t_int_extend = ir.K_INT_EXTEND;
  let t_int_wrap = ir.K_INT_WRAP;
  let t_load_local = ir.K_LOAD_LOCAL;
  let t_loop = ir.K_LOOP;
  let t_not = ir.K_NOT;
  let t_return = ir.K_RETURN;
  let t_store_local = ir.K_STORE_LOCAL;
  let t_tee_local = ir.K_TEE_LOCAL;
  let t_u32_wrap = ir.K_U32_WRAP;
  let scan_tags: i32[] = [t_block, t_loop, t_if, t_end, t_store_local, t_tee_local];
  let last_read = last_reads(ops, nslots, t_load_local, t_dyn_dispatch);
  let i = 0;
  while (i < ops.len() && ok) {
    let op = ops[i];
    let tag = op.kind_tag;
    if (tag < 0 || tag >= kt.names.len()) {
      ok = false;
      bail = "invalid#" + util.i32_to_string(tag);
      i += 1;
      continue;
    }
    let k = kt.names[tag];
    let cls = kt.classes[tag];

    if (cur_term.kind_tag != 0 && tag != t_else && tag != t_end) {
      i += 1;
      continue;
    }

    let old_vals = nvals;
    if (tag == t_ptr_width) {
      let pv = nvals;
      nvals += 1;
      cur_insts = cur_insts.append(ssa.SInst { kind_tag: 1, result: pv, args: [], imm: 8, str: "" });
      stack = stack.append(pv);
    } else if ((cls & 1) == 0 && flat_arm_op(op)) {
      let lv = lift_pop_push(LiftVals { nvals: nvals, stack: stack, insts: [], ok: true }, ir.op_pops_by(kt.pops, op), 59, i, flat_name(k, op));
      nvals = lv.nvals;
      stack = lv.stack;
      cur_insts = splice(cur_insts, lv.insts);
      ok = lv.ok;
    } else if ((cls & 1) == 0) {
      ok = false;
    } else if (tag == t_const_i32_text || tag == t_const_i64) {
      let lv = lift_const_text_prod(k, op, nvals, stack, []);
      nvals = lv.nvals;
      stack = lv.stack;
      cur_insts = splice(cur_insts, lv.insts);
    } else if (tag == t_int_extend || tag == t_int_wrap || tag == t_int_cast || tag == t_u32_wrap) {
      let lv = lift_int_narrow_prod(k, op, nvals, stack, [], ok);
      nvals = lv.nvals;
      stack = lv.stack;
      cur_insts = splice(cur_insts, lv.insts);
      ok = lv.ok;
    } else if ((cls & 2) != 0) {
      let lv = lift_prod_mem(kt, tag, k, op, nvals, stack, []);
      nvals = lv.nvals;
      stack = lv.stack;
      cur_insts = splice(cur_insts, lv.insts);
      ok = lv.ok;
    } else if ((cls & 16) != 0) {
      let lv = lift_lane_prod(k, op, nvals, stack, []);
      nvals = lv.nvals;
      stack = lv.stack;
      cur_insts = splice(cur_insts, lv.insts);
      ok = lv.ok;
    } else if (tag != t_const_f64 && (cls & 4) != 0) {
      let lv = lift_float_prod(k, op, nvals, stack, []);
      nvals = lv.nvals;
      stack = lv.stack;
      cur_insts = splice(cur_insts, lv.insts);
      ok = lv.ok;
    } else if (tag == t_const_i32) {
      let v = nvals;
      nvals += 1;
      cur_insts = cur_insts.append(ssa.SInst { kind_tag: 1, result: v, args: [], imm: op.i32_imm, str: "" });
      stack = stack.append(v);
    } else if (tag == t_const_f64) {
      let fcv = nvals;
      nvals += 1;
      cur_insts = cur_insts.append(ssa.SInst { kind_tag: 4, result: fcv, args: [], imm: 0, str: util.i64_to_string(ir.const_f64_bits(op)) });
      stack = stack.append(fcv);
    } else if (tag == t_load_local) {
      if (op.i32_imm < 0 || op.i32_imm >= slots.len()) {
        ok = false;
      } else {
        stack = stack.append(slots[op.i32_imm]);
        seen_vals = tracked(seen_vals, track_slots, slots[op.i32_imm]);
        seen_slots = tracked(seen_slots, track_slots, op.i32_imm);
      }
    } else if (tag == t_store_local || tag == t_tee_local) {
      if (stack.len() < 1) {
        ok = false;
      } else {
        let sv = stack[stack.len() - 1];
        if (tag == t_store_local) {
          stack = drop_last(stack);
        }
        let ss = op.i32_imm;
        if (sc_n > 0 && slot_mark[ss] < sc_n - 1) {
          dl_slot = put_at(dl_slot, dl_n, ss);
          dl_old = put_at(dl_old, dl_n, slots[ss]);
          dl_prev = put_at(dl_prev, dl_n, slot_mark[ss]);
          dl_n += 1;
          slot_mark = slot_mark.with(ss, sc_n - 1);
        }
        slots = slots.with(ss, sv);
        seen_vals = tracked(seen_vals, track_slots, sv);
        seen_slots = tracked(seen_slots, track_slots, ss);
      }
    } else if ((cls & 8) != 0) {
      if (stack.len() < 2) {
        ok = false;
      } else {
        let r = stack[stack.len() - 1];
        let l = stack[stack.len() - 2];
        stack = drop_last2(stack);
        let bv = nvals;
        nvals += 1;
        cur_insts = cur_insts.append(ssa.SInst { kind_tag: 9, result: bv, args: [l, r], imm: register_width(op.width), str: k });
        stack = stack.append(bv);
      }
    } else if (tag == t_not) {
      if (stack.len() < 1) {
        ok = false;
      } else {
        let x = stack[stack.len() - 1];
        stack = drop_last(stack);
        let nv = nvals;
        nvals += 1;
        cur_insts = cur_insts.append(ssa.SInst { kind_tag: 10, result: nv, args: [x], imm: 0, str: "!" });
        stack = stack.append(nv);
      }
    } else if (tag == t_call_direct) {
      let lv = lift_call_direct(op, nvals, stack, [], ok);
      nvals = lv.nvals;
      stack = lv.stack;
      cur_insts = splice(cur_insts, lv.insts);
      ok = lv.ok;
    } else if (tag == t_dyn_dispatch) {
      let dargs: i32[] = [];
      let dk = 0;
      while (dk < op.width) {
        if (op.i32_imm + dk < 0 || op.i32_imm + dk >= slots.len()) {
          ok = false;
        } else {
          dargs = dargs.append(slots[op.i32_imm + dk]);
        }
        dk += 1;
      }
      let dv = nvals;
      nvals += 1;
      cur_insts = cur_insts.append(ssa.SInst { kind_tag: 60, result: dv, args: dargs, imm: i, str: op.str });
      stack = stack.append(dv);
    } else if (tag == t_drop) {
      if (stack.len() < 1) {
        ok = false;
      } else {
        stack = drop_last(stack);
      }
    } else if (tag == t_return) {
      if (stack.len() < 1) {
        ok = false;
      } else {
        let rv = stack[stack.len() - 1];
        stack = drop_last(stack);
        cur_term = STerm_ret(rv);
        if (op.source > 0) {
          source_returns = source_returns.append(ReturnPos { block: cur_id, line: (op.source >> 32) as i32, col: util.i64_to_string(op.source & 4294967295i64) });
        }
      }
    } else if (tag == t_if) {
      if (op.i32_imm != 0) {
        ok = false;
      } else if (stack.len() < 1) {
        ok = false;
      } else {
        let cond = stack[stack.len() - 1];
        stack = drop_last(stack);
        let then_id = next_blk;
        next_blk += 1;
        let else_id = next_blk;
        next_blk += 1;
        let merge_id = next_blk;
        next_blk += 1;
        let parent_id = cur_id;
        cur_term = STerm_brif(cond, then_id, else_id);
        blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
        sc_kind = put_at_s(sc_kind, sc_n, "if");
        sc_op = put_at(sc_op, sc_n, i);
        sc_target = put_at(sc_target, sc_n, merge_id);
        sc_else = put_at(sc_else, sc_n, else_id);
        sc_seen_else = put_at(sc_seen_else, sc_n, 0);
        sc_then_blk = put_at(sc_then_blk, sc_n, -1);
        sc_then_reaches = put_at(sc_then_reaches, sc_n, 0);
        sc_parent = put_at(sc_parent, sc_n, parent_id);
        sc_edge_last = put_at(sc_edge_last, sc_n, -1);
        sc_blk_from = put_at(sc_blk_from, sc_n, 0);
        sc_dl_from = put_at(sc_dl_from, sc_n, dl_n);
        sc_tl_from = put_at(sc_tl_from, sc_n, tl_n);
        sc_lp_from = put_at(sc_lp_from, sc_n, lp_n);
        sc_n += 1;
        cur_id = then_id;
        cur_insts = [];
        cur_preds = [parent_id];
        cur_term = STerm_none();
        cur_dead = false;
      }
    } else if (tag == t_else) {
      let top = sc_n - 1;
      if (top < 0 || sc_kind[top] != "if" || sc_seen_else[top] == 1) {
        ok = false;
      } else {
        let merge_id2 = sc_target[top];
        let reaches = 0;
        if (cur_term.kind_tag == 0 && !cur_dead) {
          reaches = 1;
        }
        if (reaches == 1) {
          cur_term = STerm_br(merge_id2);
        }
        sc_then_blk = sc_then_blk.with(top, cur_id);
        sc_then_reaches = sc_then_reaches.with(top, reaches);
        let je = sc_dl_from[top];
        while (je < dl_n) {
          let se = dl_slot[je];
          tl_slot = put_at(tl_slot, tl_n, se);
          tl_val = put_at(tl_val, tl_n, slots[se]);
          tl_old = put_at(tl_old, tl_n, dl_old[je]);
          tl_prev = put_at(tl_prev, tl_n, dl_prev[je]);
          tl_n += 1;
          slot_mark = slot_mark.with(se, dl_prev[je]);
          slots = slots.with(se, dl_old[je]);
          je += 1;
        }
        dl_n = sc_dl_from[top];
        if (!cur_dead) {
          blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
        }
        sc_seen_else = sc_seen_else.with(top, 1);
        cur_id = sc_else[top];
        cur_insts = [];
        cur_preds = [sc_parent[top]];
        cur_term = STerm_none();
        cur_dead = false;
      }
    } else if (tag == t_block) {
      let exit_id = next_blk;
      next_blk += 1;
      sc_kind = put_at_s(sc_kind, sc_n, "block");
      sc_op = put_at(sc_op, sc_n, i);
      sc_target = put_at(sc_target, sc_n, exit_id);
      sc_else = put_at(sc_else, sc_n, 0);
      sc_seen_else = put_at(sc_seen_else, sc_n, 0);
      sc_then_blk = put_at(sc_then_blk, sc_n, 0);
      sc_then_reaches = put_at(sc_then_reaches, sc_n, 0);
      sc_parent = put_at(sc_parent, sc_n, 0);
      sc_edge_last = put_at(sc_edge_last, sc_n, -1);
      sc_blk_from = put_at(sc_blk_from, sc_n, 0);
      sc_dl_from = put_at(sc_dl_from, sc_n, dl_n);
      sc_tl_from = put_at(sc_tl_from, sc_n, tl_n);
      sc_lp_from = put_at(sc_lp_from, sc_n, lp_n);
      sc_n += 1;
    } else if (tag == t_loop) {
      let hdr_id = next_blk;
      next_blk += 1;
      let entry_blk = cur_id;
      cur_term = STerm_br(hdr_id);
      blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
      edge_link = edge_link.append(-1);
      edge_block = edge_block.append(entry_blk);
      edge_from = edge_from.append(ep_slot.len());
      let wl = loop_writes(ops, i, nslots, scan_tags);
      let lp_from_l = lp_n;
      let hdr_insts: ssa.SInst[] = [];
      for hs in wl {
        let ph = nvals;
        nvals += 1;
        hdr_insts = hdr_insts.append(ssa.SInst { kind_tag: 8, result: ph, args: [], imm: 0, str: "" });
        lp_slot = put_at(lp_slot, lp_n, hs);
        lp_phi = put_at(lp_phi, lp_n, ph);
        lp_pre = put_at(lp_pre, lp_n, slots[hs]);
        lp_n += 1;
        if (sc_n > 0 && slot_mark[hs] < sc_n - 1) {
          dl_slot = put_at(dl_slot, dl_n, hs);
          dl_old = put_at(dl_old, dl_n, slots[hs]);
          dl_prev = put_at(dl_prev, dl_n, slot_mark[hs]);
          dl_n += 1;
          slot_mark = slot_mark.with(hs, sc_n - 1);
        }
        slots = slots.with(hs, ph);
      }
      sc_kind = put_at_s(sc_kind, sc_n, "loop");
      sc_op = put_at(sc_op, sc_n, i);
      if (sc_outer_loop < 0) {
        sc_outer_loop = sc_n;
      }
      sc_target = put_at(sc_target, sc_n, hdr_id);
      sc_else = put_at(sc_else, sc_n, 0);
      sc_seen_else = put_at(sc_seen_else, sc_n, 0);
      sc_then_blk = put_at(sc_then_blk, sc_n, 0);
      sc_then_reaches = put_at(sc_then_reaches, sc_n, 0);
      sc_parent = put_at(sc_parent, sc_n, entry_blk);
      sc_edge_last = put_at(sc_edge_last, sc_n, edge_link.len() - 1);
      sc_blk_from = put_at(sc_blk_from, sc_n, blocks.len());
      sc_dl_from = put_at(sc_dl_from, sc_n, dl_n);
      sc_tl_from = put_at(sc_tl_from, sc_n, tl_n);
      sc_lp_from = put_at(sc_lp_from, sc_n, lp_from_l);
      sc_n += 1;
      cur_id = hdr_id;
      cur_insts = hdr_insts;
      cur_preds = [entry_blk];
      cur_term = STerm_none();
      cur_dead = false;
    } else if (tag == t_br || tag == t_brif) {
      let depth = op.i32_imm;
      let pos = sc_n - 1 - depth;
      if (pos < 0 || pos >= sc_n) {
        ok = false;
      } else {
        let cond_b = 0;
        let ok_b = true;
        if (tag == t_brif) {
          if (stack.len() < 1) {
            ok_b = false;
          } else {
            cond_b = stack[stack.len() - 1];
            stack = drop_last(stack);
          }
        }
        if (!ok_b) {
          ok = false;
        } else {
          let tgt = sc_target[pos];
          let obid = cur_id;
          edge_link = edge_link.append(sc_edge_last[pos]);
          sc_edge_last = sc_edge_last.with(pos, edge_link.len() - 1);
          edge_block = edge_block.append(obid);
          edge_from = edge_from.append(ep_slot.len());
          let jv = sc_dl_from[pos];
          while (jv < dl_n) {
            let ev = slots[dl_slot[jv]];
            if (ev != dl_old[jv]) {
              ep_slot = ep_slot.append(dl_slot[jv]);
              ep_val = ep_val.append(ev);
            }
            jv += 1;
          }
          if (tag == t_br) {
            cur_term = STerm_br(tgt);
            blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
            cur_id = next_blk;
            next_blk += 1;
            cur_insts = [];
            cur_preds = [];
            cur_term = STerm_none();
            cur_dead = true;
          } else {
            let ftid = next_blk;
            next_blk += 1;
            cur_term = STerm_brif(cond_b, tgt, ftid);
            blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
            cur_id = ftid;
            cur_insts = [];
            cur_preds = [obid];
            cur_term = STerm_none();
            cur_dead = false;
          }
        }
      }
    } else if (tag == t_end) {
      let t2 = sc_n - 1;
      if (t2 < 0) {
        ok = false;
      } else if (sc_kind[t2] == "if") {
        let merge3 = sc_target[t2];
        let parent3 = sc_parent[t2];
        let dfrom = sc_dl_from[t2];
        if (sc_seen_else[t2] == 0) {
          let else_id_a = sc_else[t2];
          let t_reaches = 0;
          if (cur_term.kind_tag == 0 && !cur_dead) {
            t_reaches = 1;
          }
          let then_blk = cur_id;
          if (t_reaches == 1) {
            cur_term = STerm_br(merge3);
          }
          if (!cur_dead) {
            blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
          }
          blocks = blocks.append(ssa.SBlock { id: else_id_a, insts: [], term: STerm_br(merge3), preds: [parent3] });
          let preds_a: i32[] = [];
          if (t_reaches == 1) {
            preds_a = preds_a.append(then_blk);
          }
          preds_a = preds_a.append(else_id_a);
          cur_id = merge3;
          cur_insts = [];
          cur_preds = preds_a;
          cur_term = STerm_none();
          cur_dead = false;
          let lo_a = nslots;
          let hi_a: i32 = -1;
          let ja = dfrom;
          while (ja < dl_n) {
            let sa = dl_slot[ja];
            slot_pos = slot_pos.with(sa, ja);
            if (sa < lo_a) {
              lo_a = sa;
            }
            if (sa > hi_a) {
              hi_a = sa;
            }
            ja += 1;
          }
          let s2 = lo_a;
          while (s2 <= hi_a) {
            if (slot_pos[s2] >= 0) {
              let snapv = dl_old[slot_pos[s2]];
              if (t_reaches == 1) {
                let tv2 = slots[s2];
                if (tv2 != snapv) {
                  let ph2a = nvals;
                  nvals += 1;
                  cur_insts = cur_insts.append(ssa.SInst { kind_tag: 8, result: ph2a, args: [tv2, snapv], imm: 0, str: "" });
                  slots = slots.with(s2, ph2a);
                }
              } else {
                slots = slots.with(s2, snapv);
              }
              slot_pos = slot_pos.with(s2, -1);
            }
            s2 += 1;
          }
        } else {
          let e_reaches = 0;
          if (cur_term.kind_tag == 0 && !cur_dead) {
            e_reaches = 1;
          }
          let else_blk = cur_id;
          if (e_reaches == 1) {
            cur_term = STerm_br(merge3);
          }
          if (!cur_dead) {
            blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
          }
          let then_blk2 = sc_then_blk[t2];
          let then_reaches2 = sc_then_reaches[t2];
          let preds_b: i32[] = [];
          if (then_reaches2 == 1) {
            preds_b = preds_b.append(then_blk2);
          }
          if (e_reaches == 1) {
            preds_b = preds_b.append(else_blk);
          }
          cur_id = merge3;
          cur_insts = [];
          cur_preds = preds_b;
          cur_term = STerm_none();
          cur_dead = preds_b.len() == 0;
          let tfrom = sc_tl_from[t2];
          let lo_b = nslots;
          let hi_b: i32 = -1;
          let jt = tfrom;
          while (jt < tl_n) {
            let sb0 = tl_slot[jt];
            slot_pos = slot_pos.with(sb0, jt);
            if (sb0 < lo_b) {
              lo_b = sb0;
            }
            if (sb0 > hi_b) {
              hi_b = sb0;
            }
            jt += 1;
          }
          let jb = dfrom;
          while (jb < dl_n) {
            let sb = dl_slot[jb];
            if (slot_pos[sb] < 0) {
              slot_pos = slot_pos.with(sb, tl_n + jb);
            }
            if (sb < lo_b) {
              lo_b = sb;
            }
            if (sb > hi_b) {
              hi_b = sb;
            }
            jb += 1;
          }
          let s3 = lo_b;
          while (s3 <= hi_b) {
            let pb = slot_pos[s3];
            if (pb >= 0) {
              let tvv = 0;
              if (pb < tl_n) {
                tvv = tl_val[pb];
              } else {
                tvv = dl_old[pb - tl_n];
              }
              let evv = slots[s3];
              if (then_reaches2 == 1 && e_reaches == 1) {
                if (tvv != evv) {
                  let ph3 = nvals;
                  nvals += 1;
                  cur_insts = cur_insts.append(ssa.SInst { kind_tag: 8, result: ph3, args: [tvv, evv], imm: 0, str: "" });
                  slots = slots.with(s3, ph3);
                } else {
                  slots = slots.with(s3, tvv);
                }
              } else if (then_reaches2 == 1) {
                slots = slots.with(s3, tvv);
              } else if (e_reaches == 1) {
                slots = slots.with(s3, evv);
              } else {
                slots = slots.with(s3, tvv);
              }
              slot_pos = slot_pos.with(s3, -1);
            }
            s3 += 1;
          }
        }
        let hq = read_horizon(sc_outer_loop, sc_op, t2, i);
        let wq = dfrom;
        let jq = dfrom;
        while (jq < dl_n) {
          let sq = dl_slot[jq];
          if (t2 > 0 && dl_prev[jq] < t2 - 1 && last_read[sq] >= hq) {
            if (wq != jq) {
              dl_slot = dl_slot.with(wq, sq);
              dl_old = dl_old.with(wq, dl_old[jq]);
              dl_prev = dl_prev.with(wq, dl_prev[jq]);
            }
            wq += 1;
          }
          slot_mark = slot_mark.with(sq, t2 - 1);
          jq += 1;
        }
        dl_n = wq;
        let jt2 = sc_tl_from[t2];
        while (jt2 < tl_n) {
          let st = tl_slot[jt2];
          if (t2 > 0 && slot_mark[st] < t2 - 1 && last_read[st] >= hq) {
            dl_slot = put_at(dl_slot, dl_n, st);
            dl_old = put_at(dl_old, dl_n, tl_old[jt2]);
            dl_prev = put_at(dl_prev, dl_n, tl_prev[jt2]);
            dl_n += 1;
            slot_mark = slot_mark.with(st, t2 - 1);
          }
          jt2 += 1;
        }
        tl_n = sc_tl_from[t2];
        sc_n -= 1;
      } else if (sc_kind[t2] == "loop") {
        let lf = loop_fall(cur_dead, cur_term, cur_id, next_blk);
        next_blk = lf.next_blk;
        if (lf.falls) {
          cur_term = STerm_br(lf.cont);
        }
        blocks = loop_tail_appended(blocks, cur_dead, cur_id, cur_insts, cur_term, cur_preds);
        let hid = sc_target[t2];
        let eidx = scope_edges(edge_link, sc_edge_last[t2]);
        let lpreds: i32[] = [];
        let q = 0;
        while (q < eidx.len()) {
          lpreds = lpreds.append(edge_block[eidx[q]]);
          q += 1;
        }
        let lfrom = sc_lp_from[t2];
        let nw = lp_n - lfrom;
        let nback = eidx.len() - 1;
        let mat: i32[] = [];
        let r0 = 0;
        while (r0 < nw) {
          slot_pos = slot_pos.with(lp_slot[lfrom + r0], r0);
          let q0 = 0;
          while (q0 < nback) {
            mat = mat.append(lp_phi[lfrom + r0]);
            q0 += 1;
          }
          r0 += 1;
        }
        let q1 = 1;
        while (q1 < eidx.len()) {
          let e1 = eidx[q1];
          let pj = edge_from[e1];
          let pend = edge_end(edge_from, e1, ep_slot.len());
          while (pj < pend) {
            let rr = slot_pos[ep_slot[pj]];
            if (rr >= 0) {
              mat = mat.with(rr * nback + q1 - 1, ep_val[pj]);
            }
            pj += 1;
          }
          q1 += 1;
        }
        let bi = sc_blk_from[t2];
        while (bi < blocks.len() && blocks[bi].id != hid) {
          bi += 1;
        }
        if (bi < blocks.len()) {
          let b = blocks[bi];
          let ni: ssa.SInst[] = [];
          let ii = 0;
          while (ii < b.insts.len()) {
            let inst = b.insts[ii];
            if (ii < nw && inst.kind_tag == 8 && lp_phi[lfrom + ii] == inst.result) {
              let pargs: i32[] = [lp_pre[lfrom + ii]];
              let qq = 0;
              while (qq < nback) {
                pargs = pargs.append(mat[ii * nback + qq]);
                qq += 1;
              }
              ni = ni.append(ssa.SInst { kind_tag: 8, result: inst.result, args: pargs, imm: 0, str: "" });
            } else {
              ni = ni.append(inst);
            }
            ii += 1;
          }
          blocks = blocks.with(bi, ssa.SBlock { id: b.id, insts: ni, term: b.term, preds: lpreds });
        }
        cur_dead = true;
        if (lf.falls) {
          cur_preds = [lf.tail];
          cur_id = lf.cont;
          cur_insts = [];
          cur_term = STerm_none();
          cur_dead = false;
        } else {
          cur_id = next_blk;
          next_blk += 1;
          cur_insts = [];
          cur_preds = [];
          cur_term = STerm_none();
          let jr = sc_dl_from[t2];
          while (jr < dl_n) {
            let rr2 = slot_pos[dl_slot[jr]];
            if (rr2 >= 0) {
              slots = slots.with(dl_slot[jr], lp_phi[lfrom + rr2]);
            }
            jr += 1;
          }
        }
        r0 = 0;
        while (r0 < nw) {
          slot_pos = slot_pos.with(lp_slot[lfrom + r0], -1);
          r0 += 1;
        }
        lp_n = lfrom;
        let hl = read_horizon(sc_outer_loop, sc_op, t2, i);
        let wl2 = sc_dl_from[t2];
        let jl = wl2;
        while (jl < dl_n) {
          let sl = dl_slot[jl];
          if (t2 > 0 && dl_prev[jl] < t2 - 1 && last_read[sl] >= hl) {
            if (wl2 != jl) {
              dl_slot = dl_slot.with(wl2, sl);
              dl_old = dl_old.with(wl2, dl_old[jl]);
              dl_prev = dl_prev.with(wl2, dl_prev[jl]);
            }
            wl2 += 1;
          }
          slot_mark = slot_mark.with(sl, t2 - 1);
          jl += 1;
        }
        dl_n = wl2;
        sc_n -= 1;
        if (sc_outer_loop == t2) {
          sc_outer_loop = -1;
        }
      } else {
        let eid = sc_target[t2];
        let bidx = scope_edges(edge_link, sc_edge_last[t2]);
        let falls_through = !cur_dead && cur_term.kind_tag == 0;
        let fcur = cur_id;
        if (!cur_dead) {
          if (falls_through) {
            cur_term = STerm_br(eid);
          }
          blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
        }
        let bpreds: i32[] = [];
        let qb = 0;
        while (qb < bidx.len()) {
          bpreds = bpreds.append(edge_block[bidx[qb]]);
          qb += 1;
        }
        if (falls_through) {
          bpreds = bpreds.append(fcur);
        }
        let eo_insts: ssa.SInst[] = [];
        let dfrom_b = sc_dl_from[t2];
        if (bidx.len() > 0) {
          let nb = dl_n - dfrom_b;
          let ne = bidx.len();
          while (matb.len() < nb * ne) {
            matb = matb.append(0);
          }
          let rb = 0;
          while (rb < nb) {
            slot_pos = slot_pos.with(dl_slot[dfrom_b + rb], rb);
            let ob = dl_old[dfrom_b + rb];
            let cell = rb * ne;
            let stop = cell + ne;
            while (cell < stop) {
              matb = matb.with(cell, ob);
              cell += 1;
            }
            rb += 1;
          }
          let qb1 = 0;
          while (qb1 < ne) {
            let eb = bidx[qb1];
            let pjb = edge_from[eb];
            let pendb = edge_end(edge_from, eb, ep_slot.len());
            while (pjb < pendb) {
              let rrb = slot_pos[ep_slot[pjb]];
              if (rrb >= 0) {
                matb = matb.with(rrb * ne + qb1, ep_val[pjb]);
              }
              pjb += 1;
            }
            qb1 += 1;
          }
          let ph_row: i32[] = [];
          let ph_lo = nslots;
          let ph_hi: i32 = -1;
          rb = 0;
          while (rb < nb) {
            let es = dl_slot[dfrom_b + rb];
            let first = matb[rb * ne];
            let alleq = !falls_through || slots[es] == first;
            let qv = 1;
            while (alleq && qv < ne) {
              if (matb[rb * ne + qv] != first) {
                alleq = false;
              }
              qv += 1;
            }
            if (alleq) {
              slots = slots.with(es, first);
              slot_pos = slot_pos.with(es, -1);
            } else {
              ph_row = ph_row.append(rb);
              if (es < ph_lo) {
                ph_lo = es;
              }
              if (es > ph_hi) {
                ph_hi = es;
              }
            }
            rb += 1;
          }
          let np = ph_row.len();
          if (np > 1 && ph_hi - ph_lo + 1 <= np * np) {
            ph_row = [];
            let ps = ph_lo;
            while (ps <= ph_hi) {
              if (slot_pos[ps] >= 0) {
                ph_row = ph_row.append(slot_pos[ps]);
              }
              ps += 1;
            }
          } else {
            let pi = 1;
            while (pi < np) {
              let moving = ph_row[pi];
              let at = pi;
              while (at > 0 && dl_slot[dfrom_b + ph_row[at - 1]] > dl_slot[dfrom_b + moving]) {
                ph_row = ph_row.with(at, ph_row[at - 1]);
                at -= 1;
              }
              ph_row = ph_row.with(at, moving);
              pi += 1;
            }
          }
          let pk = 0;
          while (pk < ph_row.len()) {
            let row = ph_row[pk];
            let es = dl_slot[dfrom_b + row];
            slot_pos = slot_pos.with(es, -1);
            let vals: i32[] = [];
            let qe = 0;
            while (qe < ne) {
              vals = vals.append(matb[row * ne + qe]);
              qe += 1;
            }
            if (falls_through) {
              vals = vals.append(slots[es]);
            }
            let phe = nvals;
            nvals += 1;
            eo_insts = eo_insts.append(ssa.SInst { kind_tag: 8, result: phe, args: vals, imm: 0, str: "" });
            slots = slots.with(es, phe);
            pk += 1;
          }
        }
        cur_id = eid;
        cur_insts = eo_insts;
        cur_preds = bpreds;
        cur_term = STerm_none();
        cur_dead = bpreds.len() == 0;
        let hb = read_horizon(sc_outer_loop, sc_op, t2, i);
        let wb = dfrom_b;
        let jf = dfrom_b;
        while (jf < dl_n) {
          let sf = dl_slot[jf];
          if (t2 > 0 && dl_prev[jf] < t2 - 1 && last_read[sf] >= hb) {
            if (wb != jf) {
              dl_slot = dl_slot.with(wb, sf);
              dl_old = dl_old.with(wb, dl_old[jf]);
              dl_prev = dl_prev.with(wb, dl_prev[jf]);
            }
            wb += 1;
          }
          slot_mark = slot_mark.with(sf, t2 - 1);
          jf += 1;
        }
        dl_n = wb;
        sc_n -= 1;
      }
    } else {
      ok = false;
    }
    if (op.source > 0) {
      source_values = located_values(source_values, old_vals, nvals, op.source);
    }
    if (!ok && bail == "") {
      bail = k;
      if (k == "invalid") {
        bail = bail + "#" + util.i32_to_string(op.kind_tag);
      }
    }
    i += 1;
  }

  if (ok && sc_n != 0) {
    ok = false;

    bail = "unbalanced-scope";
  }

  if (ok) {
    if (cur_term.kind_tag == 0 && stack.len() >= 1) {
      cur_term = STerm_ret(stack[stack.len() - 1]);
    } else if (cur_term.kind_tag == 0 && !cur_dead) {
      let dz = nvals;
      nvals += 1;
      cur_insts = cur_insts.append(ssa.SInst { kind_tag: 1, result: dz, args: [], imm: 0, str: "" });
      cur_term = STerm_ret(dz);
    }
    if (cur_term.kind_tag != 0 || cur_insts.len() > 0 || cur_id == 0) {
      blocks = blocks.append(ssa.SBlock { id: cur_id, insts: cur_insts, term: cur_term, preds: cur_preds });
    }
  }

  if (!ok) {
    return Err(bail);
  }
  let f = ssa.SFunc { name: name, nparams: nparams, nvals: nvals, blocks: blocks, entry: 0, takes_env: false };
  return Ok(Lifted { func: f, seen_vals: seen_vals, seen_slots: seen_slots, source_returns: source_returns, source_values: source_values });
}

function filled(n: i32, v: i32): i32[] {
  let out: i32[] = [];
  while (out.len() < n) {
    out = out.append(v);
  }
  return out;
}

function edge_end(edge_from: i32[], e: i32, total: i32): i32 {
  if (e + 1 < edge_from.len()) {
    return edge_from[e + 1];
  }
  return total;
}

function last_reads(ops: ir.Op[], nslots: i32, t_load: i32, t_dyn: i32): i32[] {
  let out = filled(nslots, -1);
  let i = 0;
  while (i < ops.len()) {
    let o = ops[i];
    let n = 0;
    if (o.kind_tag == t_load) {
      n = 1;
    } else if (o.kind_tag == t_dyn) {
      n = o.width;
    }
    let k = 0;
    while (k < n) {
      if (o.i32_imm + k >= 0 && o.i32_imm + k < nslots) {
        out = out.with(o.i32_imm + k, i);
      }
      k += 1;
    }
    i += 1;
  }
  return out;
}

function read_horizon(outer_loop: i32, opened: i32[], t2: i32, at: i32): i32 {
  if (outer_loop >= 0 && outer_loop < t2) {
    return opened[outer_loop];
  }
  return at;
}

function loop_writes(ops: ir.Op[], at: i32, nslots: i32, tags: i32[]): i32[] {
  let raw: i32[] = [];
  let lo = nslots;
  let hi: i32 = -1;
  let depth = 0;
  let j = at + 1;
  while (j < ops.len()) {
    let tg = ops[j].kind_tag;
    if (tg == tags[3]) {
      if (depth == 0) {
        break;
      }
      depth -= 1;
    } else if (tg == tags[0] || tg == tags[1] || tg == tags[2]) {
      depth += 1;
    } else if (tg == tags[4] || tg == tags[5]) {
      let sl = ops[j].i32_imm;
      if (sl >= 0 && sl < nslots) {
        raw = raw.append(sl);
        if (sl < lo) {
          lo = sl;
        }
        if (sl > hi) {
          hi = sl;
        }
      }
    }
    j += 1;
  }
  let out: i32[] = [];
  if (hi < lo) {
    return out;
  }
  let seen = __alloc_i32(hi - lo + 1);
  for sv in raw {
    seen = seen.with(sv - lo, 1);
  }
  let s = 0;
  while (s < seen.len()) {
    if (seen[s] == 1) {
      out = out.append(lo + s);
    }
    s += 1;
  }
  return out;
}

// The task's mode is word 6 of __fern_task_state, so the check is one load,
// not a call. The load is marked for rccertify.resumes.
function lift_task_mode(nvals: i32, stack: i32[], cur_insts: ssa.SInst[], ok: boolean): LiftVals {
  let none: i32[] = [];
  let insts = cur_insts.append(ssa.SInst { kind_tag: 58, result: nvals, args: none, imm: 0, str: "__fern_task_state" });
  insts = insts.append(ssa.SInst { kind_tag: 1, result: nvals + 1, args: none, imm: 6, str: "" });
  insts = insts.append(ssa.SInst { kind_tag: 52, result: nvals + 2, args: [nvals, nvals + 1], imm: 0, str: "task_mode" });
  return LiftVals { nvals: nvals + 3, stack: stack.append(nvals + 2), insts: insts, ok: ok };
}

struct LoopFall { falls: boolean, tail: i32, cont: i32, next_blk: i32 }

function loop_fall(dead: boolean, term: ssa.STerm, id: i32, next_blk: i32): LoopFall {
  if (dead || term.kind_tag != 0) {
    return LoopFall { falls: false, tail: id, cont: 0 - 1, next_blk: next_blk };
  }
  return LoopFall { falls: true, tail: id, cont: next_blk, next_blk: next_blk + 1 };
}

function loop_tail_appended(blocks: ssa.SBlock[], dead: boolean, id: i32, insts: ssa.SInst[], term: ssa.STerm, preds: i32[]): ssa.SBlock[] {
  if (dead || term.kind_tag == 0) {
    return blocks;
  }
  return blocks.append(ssa.SBlock { id: id, insts: insts, term: term, preds: preds });
}

function lift_call_direct(op: ir.Op, nvals: i32, stack: i32[], cur_insts: ssa.SInst[], ok: boolean): LiftVals {
  let argc = op.i32_imm;
  if (argc == 0 && op.str == "__fern_task_mode") {
    return lift_task_mode(nvals, stack, cur_insts, ok);
  }
  if (stack.len() < argc) {
    ok = false;
  } else {
    let cargs: i32[] = [];
    let d = argc - 1;
    while (d >= 0) {
      cargs = cargs.append(stack[stack.len() - 1 - d]);
      d -= 1;
    }
    let e = 0;
    while (e < argc) {
      stack = drop_last(stack);
      e += 1;
    }
    let pv = nvals;
    nvals += 1;
    cur_insts = cur_insts.append(ssa.SInst { kind_tag: 11, result: pv, args: cargs, imm: call_mark(op), str: op.str });
    stack = stack.append(pv);
  }

  return LiftVals { nvals: nvals, stack: stack, insts: cur_insts, ok: ok };
}

function call_mark(op: ir.Op): i32 {
  if (op.i64_imm == 4 && (op.str == "__fern_rc_inc" || op.str == "__fern_rc_is_unique")) {
    return 4;
  }
  if (ir.is_sole(op) && op.str == "__fern_rc_dec") {
    return 5;
  }
  if (ir.is_shell(op)) {
    return 2;
  }
  if (ir.is_counted(op)) {
    return 1;
  }
  if (ir.is_lent(op)) {
    return 3;
  }
  if (ir.is_lane_call(op)) {
    return 6;
  }
  return 0;
}

function STerm_ret(value: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: value };
}

function STerm_br(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function STerm_brif(cond: i32, t: i32, f: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function STerm_none(): ssa.STerm {
  return ssa.STerm { kind_tag: 0, cond: 0, target: 0, t: 0, f: 0, value: 0 };
}

function located_values(own values: i64[], begin: i32, end: i32, pos: i64): i64[] {
  while (values.len() < begin) {
    values = values.append(0i64);
  }
  while (values.len() < end) {
    values = values.append(pos);
  }
  return values;
}
