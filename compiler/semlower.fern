// The production consumer for the typed semantic pipeline.
//
// `semsource` produces an `ssasem.Func` from checked syntax and the checker's
// types, `ssaunits` plans its counted units, and `ssarc` lowers both to the
// stack IR the backends already emit (docs/SELFHOST-SEMANTIC-SOURCE.md). Until
// now the only thing that ran that chain over a whole module was a test driver;
// this is where a whole-program emit path asks for it.
//
// The substitution is whole: every declaration produced, and the emit reads
// the produced bodies (`ircore.gate`). A refusal fails the compile with exit
// 3, after a line naming each one.
//
// The result is handed to the emit path as a VALUE (`ircore.Sub`) rather than
// produced inside it, so that only a driver that wants the path links the
// pipeline behind it. Linking it everywhere cost the eight backend-carrying
// drivers 6.7-10.2% of their bytes for a flag they never read.
import "./asmcore";
import "./caps";
import "./ircore";
import "./checker";
import "./constfold";
import "./lexer";
import "./irtables";
import "./physicalbody";
import "./lift";
import "./parser";
import "./platforms";
import "./semsource";
import "./ssasem";
import "./ssarc";
import "./ssaunits";
import "./suspend";
import "./semtypes";
import "./semrecords";
import "./typeinfo";
import "./util";
import "./semarrayreport";
import "./semndprune";

// Every body the substitution is considering, declarations first (aligned with
// mod.funcs) and then the instances the declarations asked for. `n1` is the
// symbol a body defines and `n2` the receiver-qualified spelling a method's
// call op names instead; `keep` is whether the body is emitted.
struct Rows {
  body: irtables.LowerResult[],
  n1: string[],
  n2: string[],
  keep: boolean[],
  grows: ssaunits.GrowTable,
  // The rows whose result is a sole box (`ssaunits.fresh_rows`).
  fresh: ssaunits.FreshRows,
  // The rows that reach no observable effect (`pure_rows`).
  pure: util.NameIndex,
  susp: suspend.Set,
  // Each row's unit plan, kept so the plan under the inferred modes can take
  // it back for a row the ownership inference did not move (#9969).
  plans: ssaunits.Plan[],
  // Why each row is not emitted, "" where nothing refused it (`refusal`).
  why: string[],
}

// sem_report_on reports whether FERN_SEM_IR_REPORT asks for the per-module
// tally. Nothing about the emitted program changes with it.
pub function sem_report_on(): boolean {
  match (env("FERN_SEM_IR_REPORT")) {
    Some(v) => {
      return v.len() > 0;
    },
    None => {
      return false;
    }
  }
}

// sem_reuse_on reports whether the lowering under the inferred modes keeps the
// declared plan and body of each row the inference did not move, instead of
// planning and lowering every row under the inferred modes (#9969).
//
// `FERN_SEM_REUSE=` (set but empty) is the off column. It is what
// TestSelfHostInferredReuseIsIdentical compares the reuse against, and the
// reason the reuse can be held to byte equality rather than argued for — a
// fast path with no slow path to check is a fast path nothing checks.
function sem_reuse_on(): boolean {
  match (env("FERN_SEM_REUSE")) {
    Some(v) => {
      return v.len() > 0;
    },
    None => {
      return true;
    }
  }
}

// report names a refusal on stderr: the detail of the error the refusal
// fails the compile with.
function report(what: string, why: string): i32 {
  eprint("FERN_SEM_IR: " + what + ": " + why);
  return 0;
}

// tally reports what was produced; only FERN_SEM_IR_REPORT prints it.
function tally(what: string, why: string): i32 {
  if (sem_report_on()) {
    eprint("FERN_SEM_IR: " + what + ": " + why);
  }
  return 0;
}

// declined is the cache entry for a function this boundary is not emitting.
// Nothing emits from it, so the partial-op shape ircore.lower_failed_refuse
// guards against cannot arise.
function declined(why: string): irtables.LowerResult {
  return irtables.LowerResult {
    ok: false, why: why, ops: [], n_locals: 0, n_params: 0,
    erased_wide: false, superseded: false, arr_slots: [], i64_slots: [], f64_slots: [], str_slots: [],
    name: "", result_kind: irtables.result_from_decl(), dbg_slots: [], dbg_names: [], dbg_types: [],
  };
}

// The entry for a declaration with no body of its own (an `@import` extern,
// or a template whose instances stand for it): no ops, and the emit skips it
// (irtables.LowerResult.superseded). The AST lowering of an erased template
// body would otherwise decline, on wasm, a module nothing in it calls that
// body from (#9838).
function superseded(): irtables.LowerResult {
  return irtables.LowerResult {
    ok: true, why: "", ops: [], n_locals: 0, n_params: 0,
    erased_wide: false, superseded: true, arr_slots: [], i64_slots: [], f64_slots: [], str_slots: [],
    name: "", result_kind: irtables.result_from_decl(), dbg_slots: [], dbg_names: [], dbg_types: [],
  };
}

// produced_plan plans one function's units. A refusal at either stage yields a
// plan that is not ok.
function produced_plan(p: semsource.Produced, view: ssaunits.SchemaView): ssaunits.Plan {
  // A template's erased body is not a body this boundary has: its instances
  // are separate symbols of their own.
  if (p.template) {
    return ssaunits.refused("generic template");
  }
  if (p.dropped) {
    return ssaunits.refused("spliced into every caller");
  }
  if (!p.ok) {
    return ssaunits.refused(p.why);
  }
  return plan_of(p, view);
}

// refusal is why a row's body is not emitted, or "" where nothing refused it:
// the body was produced, a template's instances stand for it, or it is an
// `@import` extern.
function refusal(p: semsource.Produced, body: irtables.LowerResult): string {
  if (body.ok || p.bodyless || p.dropped) {
    return "";
  }
  if (p.template) {
    if (p.ok) {
      return "";
    }
    return p.why;
  }
  return body.why;
}

// A produced function is planned over the analysis it carries when the
// anchoring verified the graph the planner sees; one whose graph a rewrite
// moved since carries none and is analysed here.
function plan_of(p: semsource.Produced, view: ssaunits.SchemaView): ssaunits.Plan {
  match (p.analysis) {
    Some(a) => {
      return ssaunits.plan_analyzed(p.func, p.modes, a, view);
    },
    None => {
      return ssaunits.plan(p.func, p.modes, view);
    }
  }
}

// produced_body lowers a planned function. Every plan is made before any body
// is lowered, because a caller's bracket reads its callees' plans (`grows`).
function produced_body(p: semsource.Produced, plan: ssaunits.Plan, structs: irtables.StructTab, grows: ssaunits.GrowTable, pure: util.NameIndex, view: ssaunits.SchemaView, susp: suspend.Set): irtables.LowerResult {
  if (!plan.ok) {
    return declined(plan.why);
  }
  let r: irtables.LowerResult = ssarc.lower(p.func, p.modes, plan, structs, grows, pure, view, susp);
  if (!r.ok) {
    return declined(r.why);
  }
  return r;
}

// report_rows names every refused row on stderr (`report`).
function report_rows(r: Rows, prefix: string): i32 {
  let i: i32 = 0;
  while (i < r.why.len()) {
    if (r.why[i].len() > 0) {
      report(prefix + r.n1[i], r.why[i]);
    }
    i = i + 1;
  }
  return 0;
}

// The produced body at row `i`: a declaration first, then an instance.
function produced_at(built: semsource.Built, mod: parser.Module, i: i32): semsource.Produced {
  if (i < mod.funcs.len()) {
    return built.decls[i];
  }
  return built.instances[i - mod.funcs.len()];
}

// No rows to take back: what makes `rows_planned` plan every row.
function no_reuse(): Rows {
  let no_names: string[] = [];
  return Rows { body: [], n1: [], n2: [], keep: [], grows: ssaunits.no_grows(), fresh: ssaunits.no_fresh(), pure: util.name_index(no_names), susp: suspend.none(), plans: [], why: [] };
}

// Whether row `i`'s plan can be taken from `prev` unchanged. `changed` is
// `semsource.changed_rows` over the two module productions, in this same
// order, so a plan is reusable exactly where the inference moved neither the
// row's own modes nor a contract it calls. An empty `prev` reuses nothing.
function plan_reusable(prev: Rows, changed: boolean[], i: i32): boolean {
  if (i >= prev.plans.len() || i >= changed.len()) {
    return false;
  }
  return !changed[i];
}

// A module's rows planned, with no body lowered yet: every plan, then the
// callee table the brackets read. `views` is each row's schema view.
struct Planned { r: Rows, views: ssaunits.SchemaView[] }

// rows_planned plans every row and records the symbols each defines. `prev` /
// `changed` let the plan under the inferred modes take back the plan of a row
// the inference did not move: a plan is a function of its row's graph and
// modes alone.
function rows_planned(mod: parser.Module, built: semsource.Built, prev: Rows, changed: boolean[]): Planned {
  let r: Rows = no_reuse();
  let keys: string[] = [];
  let funcs: ssasem.Func[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: parser.FuncDecl = mod.funcs[i];
    keys = keys.append(parser.decl_key(fd));
    funcs = funcs.append(built.decls[i].func);
    r = Rows { ...r, n1: r.n1.append(fd.name), n2: r.n2.append(parser.decl_key(fd)) };
    i = i + 1;
  }
  let at: i32 = mod.funcs.len();
  for p in built.instances {
    // A refused instance has no graph to name it; its symbol is the one requested.
    let name: string = built.names[at];
    keys = keys.append(name);
    funcs = funcs.append(p.func);
    r = Rows { ...r, n1: r.n1.append(name), n2: r.n2.append("") };
    at = at + 1;
  }
  let views: ssaunits.SchemaView[] = ssarc.schema_views(funcs);
  let plans: ssaunits.Plan[] = [];
  i = 0;
  while (i < funcs.len()) {
    plans = plans.append(base_plan(prev, changed, i, produced_at(built, mod, i), views[i]));
    i = i + 1;
  }
  let fresh: ssaunits.FreshRows = ssaunits.fresh_rows(keys, funcs, plans);
  i = 0;
  while (i < funcs.len()) {
    plans = plans.with(i, ssaunits.with_fresh(plans[i], funcs[i], fresh));
    i = i + 1;
  }
  r = Rows { ...r, grows: ssaunits.grow_table(keys, funcs, plans), fresh: fresh, pure: pure_rows(keys, funcs), susp: suspend.classify(keys, funcs), plans: plans };
  return Planned { r: r, views: views };
}

// Row `i`'s plan: `prev`'s where the inference moved neither the row nor a
// contract it calls, planned afresh otherwise.
function base_plan(prev: Rows, changed: boolean[], i: i32, p: semsource.Produced, view: ssaunits.SchemaView): ssaunits.Plan {
  if (plan_reusable(prev, changed, i)) {
    return prev.plans[i];
  }
  return produced_plan(p, view);
}

// The rows whose body under the inferred plans `inferred` differs from the
// body under `prev`'s: those the inference moved, and those naming a callee
// whose grow mask or freshness it moved. A body reads the module's grow table
// and fresh rows only through the callees it names (`ssarc.bracketed`,
// `ssaunits.with_fresh`), and a moved row can change either for every caller.
function relowered(built: semsource.Built, mod: parser.Module, inferred: Planned, prev: Rows, changed: boolean[]): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < inferred.r.plans.len()) {
    let p: semsource.Produced = produced_at(built, mod, i);
    let callees: string[] = ssasem.called_names(p.func);
    out = out.append(!plan_reusable(prev, changed, i) || !ssaunits.grow_rows_agree(prev.grows, inferred.r.grows, callees) || !ssaunits.fresh_rows_agree(prev.fresh, inferred.r.fresh, callees));
    i = i + 1;
  }
  return out;
}

// rows_lowered lowers every row's body once: under `b`'s plans, from `b_built`,
// where `take_b` says so, and under `a`'s from `a_built` everywhere else.
function rows_lowered(mod: parser.Module, structs: irtables.StructTab, a_built: semsource.Built, a: Planned, b_built: semsource.Built, b: Planned, take_b: boolean[]): Rows {
  let r: Rows = b.r;
  let i: i32 = 0;
  while (i < b.r.plans.len()) {
    let p: semsource.Produced = produced_at(a_built, mod, i);
    let pl: Planned = a;
    if (i < take_b.len() && take_b[i]) {
      p = produced_at(b_built, mod, i);
      pl = b;
    }
    let body: irtables.LowerResult = produced_body(p, pl.r.plans[i], structs, pl.r.grows, pl.r.pure, pl.views[i], pl.r.susp);
    r = Rows { ...r, body: r.body.append(body), keep: r.keep.append(body.ok), why: r.why.append(refusal(p, body)) };
    i = i + 1;
  }
  return r;
}

// The rows that reach no observable effect, by transitive closure over the
// direct calls — native's effectfulFuncs. An effect is a call to a builtin in
// either of caps' tables, gated or ungated, a call through a value, or a call
// to a name that is neither a row nor a compiler helper (`__`). The in-place
// map is the only reader (ssarc.in_place_maps), so a module with no `map`
// call to admit is answered with no rows at all.
function pure_rows(keys: string[], funcs: ssasem.Func[]): util.NameIndex {
  let none: string[] = [];
  if (!any_map_call(funcs)) {
    return util.name_index(none);
  }
  let rows: util.NameIndex = util.name_index(keys);
  let effects: util.NameIndex = util.name_index(effect_builtins());
  let bad: boolean[] = [];
  let callers: i32[][] = [];
  while (bad.len() < keys.len()) {
    bad = bad.append(false);
    callers = callers.append([]);
  }
  let i: i32 = 0;
  while (i < funcs.len()) {
    for b in funcs[i].graph.blocks {
      for ins in b.insts {
        let callee: i32 = 0 - 1;
        if (ins.kind_tag == ssasem.call_value() || ins.kind_tag == ssasem.call() && ssasem.is_dyn_call(ins.str)) {
          bad = bad.with(i, true);
        } else if (ins.kind_tag == ssasem.call()) {
          callee = rows.find(ins.str);
          if (effects.has(ins.str) && util.index_of_str(funcs[i].shadows, ins.str) < 0
            || callee < 0 && !util.str_has_prefix(ins.str, "__")) {
            bad = bad.with(i, true);
          }
        }
        if (callee >= 0) {
          callers = callers.with(callee, callers[callee].append(i));
        }
      }
    }
    i = i + 1;
  }
  return util.name_index(unmarked(keys, spread_marks(bad, callers)));
}

function any_map_call(funcs: ssasem.Func[]): boolean {
  for f in funcs {
    for b in f.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag == ssasem.call() && util.str_has_prefix(ins.str, "__arrm_map__")) {
          return true;
        }
      }
    }
  }
  return false;
}

function effect_builtins(): string[] {
  let out: string[] = util.append_all(caps.ungated(), caps.frontend_ungated());
  for c in caps.builtin_caps() {
    out = out.append(c.builtin);
  }
  return out;
}

// `seed` closed over `callers`: a row calling a marked row is marked.
function spread_marks(seed: boolean[], callers: i32[][]): boolean[] {
  let marks: boolean[] = seed;
  let work: i32[] = [];
  let i: i32 = 0;
  while (i < marks.len()) {
    if (marks[i]) {
      work = work.append(i);
    }
    i = i + 1;
  }
  let next: i32 = 0;
  while (next < work.len()) {
    for c in callers[work[next]] {
      if (!marks[c]) {
        marks = marks.with(c, true);
        work = work.append(c);
      }
    }
    next = next + 1;
  }
  return marks;
}

function unmarked(keys: string[], marks: boolean[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < keys.len()) {
    if (!marks[i]) {
      out = out.append(keys[i]);
    }
    i = i + 1;
  }
  return out;
}

// substitution produces every function this boundary admits and hands the
// result back as a value for the emit path to thread in (ircore.Sub). The
// caller normalises the module exactly as the emit path does, so the bodies
// line up with `mod.funcs` position for position.
struct Inference { built: semsource.Built, rows: Rows, records: parser.StructDecl[] }

// Whether the typed pipeline lowers EVERY body of this module, given whether
// each row's body (or plan) came through. A template's erased body is not one
// — its instances stand for it — and neither is a declaration with no body
// here.
function lowers_whole_module(built: semsource.Built, keep: boolean[]): boolean {
  let i: i32 = 0;
  while (i < keep.len()) {
    if (!keep[i]) {
      if (i >= built.decls.len()) {
        if (!built.instances[i - built.decls.len()].dropped) {
          return false;
        }
      } else if (!built.decls[i].template && !built.decls[i].bodyless && !built.decls[i].dropped) {
        return false;
      }
    }
    i = i + 1;
  }
  return true;
}

function plans_ok(plans: ssaunits.Plan[]): boolean[] {
  let out: boolean[] = [];
  for p in plans {
    out = out.append(p.ok);
  }
  return out;
}

// The ownership inference, run when the module plans whole under the modes it
// declared. Each row's body is lowered once: under the inferred modes where
// the inference moved the row or the grow mask of a callee it names, and under
// the declared modes elsewhere, where both give the same body. The result is
// checked whole — a mode can refuse a plan (`ssaunits.mode_error`) — and a
// module that does not lower whole under the inference is lowered under the
// modes it declared.
function inferred_rows(mod: parser.Module, built: semsource.Built, declared: Planned, structs: irtables.StructTab): Inference {
  let widened: semsource.Built = semsource.with_inferred_modes(built);
  let changed: boolean[] = semsource.changed_rows(built, widened);
  if (semsource.any_row_changed(changed)) {
    // `FERN_SEM_REUSE=` (set but empty) plans and lowers every row afresh.
    let prev: Rows = declared.r;
    if (!sem_reuse_on()) {
      prev = no_reuse();
    }
    let inferred: Planned = rows_planned(mod, widened, prev, changed);
    let r: Rows = rows_lowered(mod, structs, built, declared, widened, inferred, relowered(widened, mod, inferred, prev, changed));
    if (lowers_whole_module(widened, r.keep)) {
      return Inference { built: widened, rows: r, records: [] };
    }
  }
  return Inference { built: built, rows: rows_lowered(mod, structs, built, declared, built, declared, []), records: [] };
}

// The module built and lowered, under the inferred modes when it plans whole.
function produced_rows(mod: parser.Module, structs: irtables.StructTab, debug_lines: boolean): Inference {
  let built: semsource.Built = semsource.with_analyses(semsource.build_module_debug(mod, debug_lines));
  util.arr_push_cliff_report("sem:built", 0);
  let records: parser.StructDecl[] = instance_records(built);
  if (records.len() > 0) {
    structs = irtables.struct_tab(util.append_all(structs.decls, records));
  }
  let declared: Planned = rows_planned(mod, built, no_reuse(), []);
  let inf: Inference = Inference { built: built, rows: no_reuse(), records: records };
  if (lowers_whole_module(built, plans_ok(declared.r.plans))) {
    inf = Inference { ...inferred_rows(mod, built, declared, structs), records: records };
  } else {
    inf = Inference { ...inf, rows: rows_lowered(mod, structs, built, declared, built, declared, []) };
  }
  util.arr_push_cliff_report("sem:lowered", 0);
  return inf;
}

// instance_records declares each record a template's instance builds at its
// own binding (`Slot__0_T` at i32, from `Slot[T]` in a generic over T). A
// declaration is what a construction stores its fields through and what names
// its shape, and the AST tables hold only the one spelled at the variable.
// Named as ssarc.record_name names the record, appended after the module's
// own so every declaration index before them is unchanged.
function instance_records(built: semsource.Built): parser.StructDecl[] {
  let out: parser.StructDecl[] = [];
  let names: string[] = [];
  for p in util.append_all(built.decls, built.instances) {
    for rec in p.func.records.list {
      if let typeinfo.TypeStruct(r) = rec.ty {
        let name: string = ssasem.type_key(rec.ty);
        if (r.args.len() > 0 && !semtypes.is_env(rec.ty) && util.index_of_str(names, name) < 0) {
          names = names.append(name);
          let fields: parser.StructFieldDecl[] = [];
          for fl in rec.fields {
            fields = fields.append(parser.StructFieldDecl { name: fl.name, type_name: field_spelling(fl.ty), fn_ret: "", fn_param_types: "" });
          }
          out = out.append(parser.StructDecl { name: name, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: false, is_package: false });
        }
      }
    }
  }
  return util.append_all(out, instance_variants(built));
}

// A generic variant is materialized from its typed schema, like a record
// instance. Impossible variants have no runtime shape; they remain in the
// semantic table for identity and verification.
function instance_variants(built: semsource.Built): parser.StructDecl[] {
  let out: parser.StructDecl[] = [];
  let names: string[] = [];
  for p in util.append_all(built.decls, built.instances) {
    for e in p.func.enums {
      if (e.layout != semrecords.layout_variant()) {
        continue;
      }
      for v in e.variants {
        let name: string = ssasem.variant_key(e.ty, v.name);
        if (name == v.name || !semrecords.inhabited(v) || util.index_of_str(names, name) >= 0) {
          continue;
        }
        names = names.append(name);
        let fields: parser.StructFieldDecl[] = [];
        for fl in v.fields {
          fields = fields.append(parser.StructFieldDecl { name: fl.name, type_name: field_spelling(fl.ty), fn_ret: "", fn_param_types: "" });
        }
        out = out.append(parser.StructDecl { name: name, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: ssasem.type_key(e.ty), must_consume: false, variant_field_names: [], is_pub: false, is_package: false });
      }
    }
  }
  return out;
}

// A field's spelling as the AST tables read one: a view erased to `string`,
// a record by the name its declaration carries.
function field_spelling(t: typeinfo.Type): string {
  if (ssasem.is_view(t)) {
    return "string";
  }
  if let typeinfo.TypeStruct(_) = t {
    return ssasem.type_key(t);
  }
  if let typeinfo.TypeArray(a) = t {
    return field_spelling(a.elem) + "[]";
  }
  return typeinfo.spelling(t);
}

pub function substitution(mod: parser.Module, structs: irtables.StructTab, debug_lines: boolean): ircore.Sub {
  let inf: Inference = produced_rows(mod, structs, debug_lines);
  let built: semsource.Built = inf.built;
  let r: Rows = inf.rows;
  report_rows(r, "");
  let helpers: ssarc.Helpers = ssarc.no_helpers();
  let bodies: irtables.LowerResult[] = [];
  let n: i32 = 0;
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    if (built.decls[i].dropped) {
      bodies = bodies.append(superseded());
      n = n + 1;
    } else if (r.keep[i]) {
      helpers = ssarc.with_drop_helpers(helpers, built.decls[i].func);
      bodies = bodies.append(r.body[i]);
      n = n + 1;
    } else if (built.decls[i].template && (built.decls[i].ok || built.decls[i].bodyless)) {
      // A template's erased body is no body of this module's: its
      // produced instances stand for it, and one nothing instantiates
      // is called by nobody. Neither is a refusal.
      bodies = bodies.append(declined("generic template"));
      n = n + 1;
    } else if (built.decls[i].bodyless) {
      // An `@import` extern has no body: the bridge emits it from its
      // declaration. Not a refusal.
      bodies = bodies.append(superseded());
      n = n + 1;
    } else {
      bodies = bodies.append(declined(r.why[i]));
    }
    i = i + 1;
  }
  let instances: irtables.LowerResult[] = [];
  let unspliced: i32 = 0;
  let at: i32 = 0;
  while (at < built.instances.len()) {
    if (built.instances[at].dropped) {
      unspliced = unspliced + 1;
    } else if (r.keep[mod.funcs.len() + at]) {
      helpers = ssarc.with_drop_helpers(helpers, built.instances[at].func);
      instances = instances.append(r.body[mod.funcs.len() + at]);
    }
    at = at + 1;
  }
  util.arr_push_cliff_report("sem:substituted", 0);
  // A refused declaration or instance fails the compile.
  let refused_n: i32 = mod.funcs.len() - n + built.instances.len() - instances.len() - unspliced;
  if (refused_n > 0) {
    eprint("FERN_SEM_IR: the typed lowering refused " + util.i32_to_string(refused_n) + " declarations and instances; the FERN_SEM_IR lines above name each");
    exit(3);
  }
  array_storage_report(mod, built, r);
  tally("module", "produced " + util.i32_to_string(n) + " of "
    + util.i32_to_string(mod.funcs.len()) + " declarations and "
    + util.i32_to_string(instances.len()) + " of "
    + util.i32_to_string(built.instances.len()) + " instances");
  // A module produced whole calls no template's erased body: every caller
  // is produced and calls an instance.
  let i2: i32 = 0;
  while (i2 < mod.funcs.len()) {
    if (!bodies[i2].ok && built.decls[i2].template) {
      bodies = bodies.with(i2, superseded());
    }
    i2 = i2 + 1;
  }
  let keys: typeinfo.Type[] = [];
  for d in built.decls {
    keys = structural_keys(keys, d.func);
  }
  for p in built.instances {
    keys = structural_keys(keys, p.func);
  }
  if (keys.len() > 0) {
    helpers = ssarc.Helpers { ...helpers, rows: util.append_all(helpers.rows, runtime_bodies(key_helper_source(keys))) };
  }
  // The declaration-less bodies are merged by symbol here, where the rule
  // lives, so the emit path's tail is a plain append.
  let extra: irtables.LowerResult[] = ssarc.merge_helpers(instances, helpers.rows);
  let kept: semndprune.Result = semndprune.unused_adapter(mod, bodies, extra);
  return ircore.Sub { ...ircore.no_sub(), bodies: kept.bodies, extra: kept.extra, contracts: contract_rows(built.contracts, r), physical_contracts: built.contracts.list, physical_records: built.records, physical_finalizers: built.finalizers, records: inf.records };
}

// contract_rows spells what a caller's lowering reads of the functions it
// calls — each contract whole (its parameter types and modes and its result
// type, which inference can move without the declaration changing), the grow
// rows, the pure rows and the suspension classes — one row per fact, for
// ircore.unit_keys to fold into a per-module cache key.
// TestSelfHostContractRowsFoldEveryCalleeFact keeps it complete.
function contract_rows(cs: ssasem.Contracts, r: Rows): string[] {
  let out: string[] = [];
  for c in cs.list {
    let row: string = "C:" + c.name + "(";
    let j: i32 = 0;
    while (j < c.params.len() || j < c.modes.len()) {
      if (j > 0) {
        row = row + ",";
      }
      if (j < c.params.len()) {
        row = row + typeinfo.spelling(c.params[j]);
      }
      if (j < c.modes.len()) {
        row = row + " " + util.i32_to_string(c.modes[j]);
      }
      j = j + 1;
    }
    out = out.append(row + ")" + typeinfo.spelling(c.result));
  }
  for g in r.grows.rows {
    out = out.append("G:" + g.callee + "|" + util.i32_to_string(g.param) + "|" + util.i32_to_string(g.field));
  }
  for name in r.pure.names {
    out = out.append("P:" + name);
  }
  let k: i32 = 0;
  while (k < r.susp.rows.names.len()) {
    out = out.append("S:" + r.susp.rows.names[k] + "|" + r.susp.classes[k]);
    k = k + 1;
  }
  if (r.susp.indirect) {
    out = out.append("S:indirect");
  }
  return out;
}

function array_storage_report(mod: parser.Module, built: semsource.Built, r: Rows): i32 {
  if (!semarrayreport.enabled()) {
    return 0;
  }
  let sites: semarrayreport.Site[] = [];
  let scales: semarrayreport.Site[] = [];
  let i: i32 = 0;
  while (i < r.plans.len()) {
    if (r.keep[i]) {
      let p: semsource.Produced = produced_at(built, mod, i);
      sites = util.append_all(sites, ssarc.map_report(p.func, p.modes, r.plans[i], r.pure));
      scales = util.append_all(scales, ssarc.scale_report(p.func, r.plans[i]));
    }
    i = i + 1;
  }
  eprint(semarrayreport.render_kind("map storage", semarrayreport.storage_reasons(), sites));
  eprint(semarrayreport.render_kind("scale storage", semarrayreport.scale_storage_reasons(), scales));
  return 0;
}

// The structural key types the maps `f` holds name (#10020), each after the
// ones nested in it, added to `seen` once.
function structural_keys(seen: typeinfo.Type[], f: ssasem.Func): typeinfo.Type[] {
  let out: typeinfo.Type[] = seen;
  for t in f.values {
    if (ssasem.is_map(t) && ssasem.structural_map_key(ssasem.map_key(t))) {
      out = with_structural(out, ssasem.map_key(t));
    }
  }
  return out;
}

function with_structural(seen: typeinfo.Type[], k: typeinfo.Type): typeinfo.Type[] {
  if (!ssasem.structural_map_key(k)) {
    return seen;
  }
  let name: string = ssasem.keyed_map_key_name(k);
  for t in seen {
    if (ssasem.keyed_map_key_name(t) == name) {
      return seen;
    }
  }
  let out: typeinfo.Type[] = seen;
  if let typeinfo.TypeTuple(tup) = k {
    for e in tup.elements {
      out = with_structural(out, e);
    }
  }
  if let typeinfo.TypeArray(a) = k {
    out = with_structural(out, a.elem);
  }
  return out.append(k);
}

// The `K__eq` and `K__hash` of each structural key K, as the source a derived
// `eq` and `hash` would be: elements compared with `==`, or through their own
// helpers when structural, and hashed into `h * 31 + element` with a string
// folded byte by byte.
function key_helper_source(keys: typeinfo.Type[]): string {
  let src: string = "";
  for k in keys {
    let ty: string = typeinfo.spelling(k);
    src = src + "function " + ssasem.keyed_map_key_fn(k, "eq") + "(a: " + ty + ", b: " + ty + "): boolean { " + key_eq_body(k) + " }\n";
    src = src + "function " + ssasem.keyed_map_key_fn(k, "hash") + "(a: " + ty + "): i32 { let h: i32 = 17; " + key_hash_body(k) + " return h; }\n";
  }
  return src;
}

function key_eq_body(k: typeinfo.Type): string {
  if let typeinfo.TypeArray(arr) = k {
    return "if (a.len() != b.len()) { return false; } let i: i32 = 0; while (i < a.len()) { if (!("
      + element_eq(arr.elem, "a[i]", "b[i]") + ")) { return false; } i = i + 1; } return true;";
  }
  let out: string = "return true";
  if let typeinfo.TypeTuple(tup) = k {
    let i: i32 = 0;
    while (i < tup.elements.len()) {
      let at: string = "." + util.i32_to_string(i);
      out = out + " && " + element_eq(tup.elements[i], "a" + at, "b" + at);
      i = i + 1;
    }
  }
  return out + ";";
}

function element_eq(t: typeinfo.Type, x: string, y: string): string {
  if (ssasem.structural_map_key(t)) {
    return ssasem.keyed_map_key_fn(t, "eq") + "(" + x + ", " + y + ")";
  }
  return x + " == " + y;
}

function key_hash_body(k: typeinfo.Type): string {
  if let typeinfo.TypeArray(arr) = k {
    return "let i: i32 = 0; while (i < a.len()) { " + element_hash(arr.elem, "a[i]", "e") + " i = i + 1; }";
  }
  let out: string = "";
  if let typeinfo.TypeTuple(tup) = k {
    let i: i32 = 0;
    while (i < tup.elements.len()) {
      out = out + element_hash(tup.elements[i], "a." + util.i32_to_string(i), "e" + util.i32_to_string(i)) + " ";
      i = i + 1;
    }
  }
  return out;
}

// One element folded into `h`; `sfx` keeps a string's loop counter distinct.
function element_hash(t: typeinfo.Type, x: string, sfx: string): string {
  if (ssasem.structural_map_key(t)) {
    return "h = h * 31 + " + ssasem.keyed_map_key_fn(t, "hash") + "(" + x + ");";
  }
  if (ssasem.is_string(t)) {
    let j: string = "j" + sfx;
    return "h = h * 31; let " + j + ": i32 = 0; while (" + j + " < " + x + ".len()) { h = h * 31 + ("
      + x + "[" + j + "] as i32); " + j + " = " + j + " + 1; }";
  }
  if (ssasem.is_bool(t)) {
    return "h = h * 31; if (" + x + ") { h = h + 1; }";
  }
  return "h = h * 31 + (" + x + " as i32);";
}

// runtime_bodies is the typed lowering of a Fern-source runtime helper
// (asmcore.rt_src_*), one body per function the source defines and in its
// order. A refusal, including a source that does not type-check, exits 3.
pub function runtime_bodies(src: string): irtables.LowerResult[] {
  return runtime_lowering(src).bodies;
}

// The runtime callback carries bodies and selected facts from this invocation
// for a future physical proof. runtime_bodies is the bodies-only projection.
pub function runtime_lowering(src: string): physicalbody.Lowered {
  let parsed: parser.Module = parser.infer_ret_types_module(parser.parse_module(lexer.tokenize(src)));
  // The builtin enums' variants (IoError's NotFound, …), which a program's
  // module carries from module_with_builtins.
  let mod: parser.Module = parser.Module { ...parsed, structs: parser.inject_builtin_enums(parsed.structs) };
  let diags: util.Diag[] = checker.build_gate_diags(mod);
  if (diags.len() > 0) {
    return runtime_refused(first_name(mod), "does not type-check: " + diags[0].message);
  }
  let im: parser.Module = gated_module(checker.annotate_module(mod));
  let inf: Inference = produced_rows(im, irtables.struct_tab(parser.erase_view_structs(im.structs)), false);
  if (inf.built.instances.len() > 0) {
    return runtime_refused(first_name(im), "instantiates a generic");
  }
  let out: irtables.LowerResult[] = [];
  let helpers: ssarc.Helpers = ssarc.no_helpers();
  let i: i32 = 0;
  while (i < im.funcs.len()) {
    if (!inf.rows.keep[i]) {
      return runtime_refused(im.funcs[i].name, inf.rows.why[i]);
    }
    out = out.append(inf.rows.body[i]);
    helpers = ssarc.with_drop_helpers(helpers, inf.built.decls[i].func);
    i = i + 1;
  }
  // The drop helpers follow the bodies, deduplicated by symbol.
  let all: irtables.LowerResult[] = ssarc.merge_helpers(out, helpers.rows);
  for h in all {
    if (!h.ok) {
      return runtime_refused(h.name, h.why);
    }
  }
  let declarations: string[] = [];
  i = 0;
  for fd in im.funcs {
    tally("runtime " + fd.name, "produced");
    declarations = declarations.append(inf.built.names[i]);
    i = i + 1;
  }
  return physicalbody.Lowered { bodies: all, declarations: declarations, contracts: inf.built.contracts.list, records: inf.built.records, finalizers: inf.built.finalizers };
}

function runtime_refused(name: string, why: string): physicalbody.Lowered {
  report("runtime " + name, why);
  eprint("FERN_SEM_IR: the typed lowering refused runtime helper " + name);
  exit(3);
  return physicalbody.empty();
}

function first_name(mod: parser.Module): string {
  if (mod.funcs.len() == 0) {
    return "(empty source)";
  }
  return mod.funcs[0].name;
}

// The module an emit path gates and emits, so a caller can produce the
// substitution against the same normalisation and the same order. The x86-64
// and arm64 paths spell it this way; wasm lifts inside its own normalisation
// and takes the unlifted module (target_substitution).
pub function gated_module(mod: parser.Module): parser.Module {
  return parser.infer_ret_types_module(ircore.script_normalized(mod));
}

// Checking needs the same typed source anchors as production, before
// target folding or reachability pruning can discard an invalid body.
// This performs no RC lowering, register allocation or code generation.
pub function view_escape_diags(mod: parser.Module): util.Diag[] {
  let typed: parser.Module = parser.module_with_builtins_typed(checker.annotate_module(mod));
  let im: parser.Module = gated_module(ircore.lift_lambdas_typed(typed));
  return semsource.check_views(im);
}

// target_substitution produces the typed lowering of the checker-typed `typed`
// for whichever emit path `target` selects, against the normalisation that path
// gates on. The register backends take the lifted module back (Sub.lifted) so
// their emit entries read it erased rather than lifting again: lifting an
// already-lifted body renames its locals, so what was produced would not be the
// bodies the emit path lowers.
pub function target_substitution(typed: parser.Module, target: string, debug_lines: boolean): ircore.Sub {
  if (is_wasm(target)) {
    return substitution_of(wasm_gated(typed), false);
  }
  let lifted: parser.Module = ircore.lift_lambdas_typed(typed);
  return ircore.Sub { ...substitution_of(gated_module(lifted), debug_lines), lifted: lifted, has_lifted: true };
}

function is_wasm(target: string): boolean {
  return util.str_has_prefix(target, "wasm");
}

// The module the wasm emit path gates: it lifts inside its own normalisation,
// after the same map-to-kernel rewrite ircore's lift runs.
function wasm_gated(typed: parser.Module): parser.Module {
  return lift.lift_lambdas_typed(ircore.script_normalized(ircore.scale_f64_maps_module(typed)));
}

function substitution_of(im: parser.Module, debug_lines: boolean): ircore.Sub {
  let stab: irtables.StructTab = irtables.struct_tab(parser.erase_view_structs(im.structs));
  util.arr_push_cliff_report("sem:gated", 0);
  let sub: ircore.Sub = substitution(im, stab, debug_lines);
  return ircore.Sub { ...sub, rt_lower: runtime_lowering };
}

// Driven is what a driver hands an emit entry for a module it parsed without
// the CLI's front end: the module to emit and the typed lowering of it.
pub struct Driven { full: parser.Module, sub: ircore.Sub }

pub function driven(mod: parser.Module, target: string): Driven {
  return driven_annotated(checker.annotate_module(mod), target);
}

// driven_annotated is driven for a module the caller has already annotated.
// `target_os()` / `target_arch()` are folded to the target's names first, as
// the CLI folds them: no backend emits a body for either.
pub function driven_annotated(annotated: parser.Module, target: string): Driven {
  let typed: parser.Module = checked_typed(annotated, target);
  return Driven { full: parser.erase_view_module(typed), sub: ircore.Sub { ...target_substitution(typed, target, false), checked: true } };
}

function checked_typed(annotated: parser.Module, target: string): parser.Module {
  let t: Typed = typed_for(annotated, target);
  if (t.errs.len() > 0) {
    eprint(util.format_diags(t.errs));
    exit(1);
  }
  return t.mod;
}

// Typed is the module the typed lowering reads for a target, and the emit
// entry's diagnostics on it, which run before the lowering so a module they
// refuse gets its diagnostic rather than a lowering refusal.
struct Typed { mod: parser.Module, errs: util.Diag[] }

function typed_for(annotated: parser.Module, target: string): Typed {
  let desc: platforms.Descriptor = platforms.for_target(target);
  let folded: parser.Module = constfold.fold_target_name(annotated, desc.environment, desc.isa);
  let typed: parser.Module = parser.module_with_builtins_typed(folded);
  return Typed { mod: typed, errs: asmcore.entry_check_errors(checker.ensure_annotated(parser.erase_view_module(typed))) };
}

// Verdict is the typed lowering's answer for a program, without emitting it
// and without exiting: `ok` when the program passes the checks and every
// declaration and instance is produced. `errors` holds the diagnostics of a
// program that fails the checks, which then has no rows.
pub struct Verdict { ok: boolean, errors: util.Diag[], rows: VerdictRow[] }

// One declaration or instance. `state` is "produced", "refused" (with `why`),
// "template" for a generic whose instances stand for it, "extern" for an
// `@import` declaration, or "spliced" for one the inliner spliced away.
pub struct VerdictRow { name: string, state: string, why: string }

// verdict lowers `mod` as a driver that parsed it hands it to the emit
// (`driven`). A driver that holds a program to the checker's build gate first
// asks verdict_annotated after it, as its emit does.
pub function verdict(mod: parser.Module, target: string): Verdict {
  return verdict_annotated(checker.annotate_module(mod), target);
}

// verdict_ok runs the same checks and lowering as verdict without building
// declaration names and report rows for a caller that needs only the answer.
pub function verdict_ok(mod: parser.Module, target: string): boolean {
  let t: Typed = typed_for(checker.annotate_module(mod), target);
  if (t.errs.len() > 0) {
    return false;
  }
  let im: parser.Module = verdict_module(t.mod, target);
  let inf: Inference = produced_rows(im, irtables.struct_tab(parser.erase_view_structs(im.structs)), false);
  let i: i32 = 0;
  while (i < inf.rows.keep.len()) {
    if (!inf.rows.keep[i] && inf.rows.why[i].len() > 0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function verdict_module(mod: parser.Module, target: string): parser.Module {
  if (is_wasm(target)) {
    return wasm_gated(mod);
  }
  return gated_module(ircore.lift_lambdas_typed(mod));
}

// verdict_annotated is verdict for a module the caller already checked and
// annotated (`driven_annotated`).
pub function verdict_annotated(annotated: parser.Module, target: string): Verdict {
  let t: Typed = typed_for(annotated, target);
  if (t.errs.len() > 0) {
    return Verdict { ok: false, errors: t.errs, rows: [] };
  }
  let im: parser.Module = verdict_module(t.mod, target);
  let inf: Inference = produced_rows(im, irtables.struct_tab(parser.erase_view_structs(im.structs)), false);
  let rows: VerdictRow[] = [];
  let ok: boolean = true;
  let i: i32 = 0;
  while (i < inf.rows.keep.len()) {
    let row: VerdictRow = verdict_row(im, inf, i);
    if (row.state == "refused") {
      ok = false;
    }
    rows = rows.append(row);
    i = i + 1;
  }
  return Verdict { ok: ok, errors: [], rows: rows };
}

function verdict_row(im: parser.Module, inf: Inference, i: i32): VerdictRow {
  let name: string = inf.rows.n1[i];
  if (i < im.funcs.len()) {
    name = parser.decl_key(im.funcs[i]);
  }
  if (inf.rows.keep[i]) {
    return VerdictRow { name: name, state: "produced", why: "" };
  }
  if (inf.rows.why[i].len() > 0) {
    return VerdictRow { name: name, state: "refused", why: inf.rows.why[i] };
  }
  let p: semsource.Produced = produced_at(inf.built, im, i);
  if (p.bodyless) {
    return VerdictRow { name: name, state: "extern", why: "" };
  }
  if (p.dropped) {
    return VerdictRow { name: name, state: "spliced", why: "" };
  }
  return VerdictRow { name: name, state: "template", why: "" };
}

// verdict_text is a verdict as the drivers' `-ir-probe` prints it: the
// diagnostics of a program that fails the checks, then `<name>: ir` for each
// produced row, `<name>: refused: <why>` for each refused one, the state of
// the rest, and last the module's line, `module: IR` or `module: refused`.
pub function verdict_text(v: Verdict): string {
  let out: string = "";
  if (v.errors.len() > 0) {
    out = util.format_diags(v.errors);
    if (!util.str_has_suffix(out, "\n")) {
      out = out + "\n";
    }
  }
  for row in v.rows {
    if (row.state == "produced") {
      out = out + row.name + ": ir\n";
    } else if (row.state == "refused") {
      out = out + row.name + ": refused: " + row.why + "\n";
    } else {
      out = out + row.name + ": " + row.state + "\n";
    }
  }
  if (v.ok) {
    return out + "module: IR\n";
  }
  return out + "module: refused\n";
}

// program is the whole program a register backend's emit over `d` gates, which
// a per-module build cuts into units (ircore.split_units). A module the gate
// refuses is an error, as it is for the whole-module emit.
pub function program(d: Driven): ircore.Gated {
  let g: ircore.Gated = ircore.gate_program(ircore.sub_lifted(d.sub, checker.ensure_annotated(d.full)), d.sub);
  if (!g.ok) {
    ircore.eprint_ir_ineligible();
    exit(1);
  }
  return g;
}
