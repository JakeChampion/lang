import "./asmcore";
import "./caps";
import "./ircore";
import "./checker";
import "./constfold";
import "./lexer";
import "./irtables";
import "./physicalbody";
import "./lift";
import "./parser";
import "./platforms";
import "./semsource";
import "./ssa";
import "./ssasem";
import "./ssarc";
