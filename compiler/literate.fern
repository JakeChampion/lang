// compiler/literate.fern — the Knuth-style literate engine: a document's
// blocks, tangle, and the examples `-doctest` runs.
//
// A literate Fern program is a Markdown document whose `fern` code
// chunks (`<<name>>=`) are reassembled — *tangled* — from the root
// chunk `<<*>>` into a compilable program. Chunks resolve out of
// document order, same-name definitions concatenate, and a chunk
// reference's indentation is prepended to its expansion.
//
// The compiler tangles with it for `-tangle`, and to load a `.fern.md`
// entry or import (fern.fern entry_sources, modloader.read_module):
// tangling slots in ahead of `lexer.tokenize`, and the line map it
// returns moves a diagnostic back onto the document (util.doc_diag).
// The document's block model (`parse`) is what weave.fern renders. The Go
// front end keeps its own tangle in internal/tools/literate, for the
// oracle; the two tangle every document to the same bytes.
//
// Data model note: the document's chunk bodies are kept as a single
// FLAT array of tagged Piece lines (chunk name + text + line), not as
// an array of chunks each holding its own array of lines. The flat
// shape is both simpler — concatenation is just "every Piece with this
// chunk name, in document order" — and it avoids a reference-counting
// bug in the current native backends: the nested array-of-chunks model
// (each chunk holding a BodyLine[]) reproducibly segfaulted / returned
// corrupted >8-byte (heap) strings under x86-64 and arm64 codegen while
// the AST interpreter ran it correctly. The flat single-level array is
// robust on all three. The precise minimal trigger hasn't been pinned
// down (it needs expand's full shape — recursion + a union return over
// the nested arrays), so this is a deliberate workaround, not a fix;
// see the backend RC-Perceus path.
//
// `main()` runs assertions and returns 0 on success; a non-zero code
// identifies which one failed. A Go test compiles and runs this file on
// each target (TestSelfHostLiterate*).

// ─── byte classifiers ──────────────────────────────────────────────

function is_backtick(b: u8): boolean {
  return b == b'`';
}

// ─── small string helpers ──────────────────────────────────────────
// The self-hosted modules are deliberately import-free (cf. lexer.fern),
// so the handful of string utilities the engine needs are inlined here
// rather than pulled from std/string.

function starts_with(s: string, prefix: string): boolean {
  let pn: i32 = prefix.len();
  if (pn > s.len()) {
    return false;
  }
  return slice_unchecked(s, 0, pn) == prefix;
}

function ends_with(s: string, suffix: string): boolean {
  let sn: i32 = suffix.len();
  let n: i32 = s.len();
  if (sn > n) {
    return false;
  }
  return slice_unchecked(s, n - sn, n) == suffix;
}

// contains reports whether `sub` occurs anywhere in `s` (used to
// reject a `>>` inside a chunk name).
function contains(haystack: string, needle: string): boolean {
  return index_of_sub(haystack, needle) >= 0;
}

function index_of_sub(haystack: string, needle: string): i32 {
  let n: i32 = needle.len();
  if (n == 0) {
    return 0;
  }
  let last: i32 = haystack.len() - n;
  let first: i32 = needle[0] as i32;
  let i: i32 = __memchr(haystack, first, 0);
  while (i >= 0 && i <= last) {
    if (__mismatch(haystack, i, needle, 0, n) == n) {
      return i;
    }
    i = __memchr(haystack, first, i + 1);
  }
  return 0 - 1;
}

// trim strips leading and trailing horizontal whitespace.
pub function trim(s: string): string {
  let a: i32 = 0;
  let b: i32 = s.len();
  while (a < b && (s[a] == b' ' || s[a] == b'\t' || s[a] == b'\r')) {
    a = a + 1;
  }
  while (b > a && (s[b - 1] == b' ' || s[b - 1] == b'\t' || s[b - 1] == b'\r')) {
    b = b - 1;
  }
  return slice_unchecked(s, a, b) + "";
}

// leading_ws returns the run of leading spaces/tabs (the indentation
// prepended to a chunk reference's expansion).
pub function leading_ws(s: string): string {
  let k: i32 = 0;
  let n: i32 = s.len();
  while (k < n && (s[k] == b' ' || s[k] == b'\t')) {
    k = k + 1;
  }
  return slice_unchecked(s, 0, k) + "";
}

// split_lines splits on '\n', mirroring Go's strings.Split: a trailing
// newline yields a trailing empty line, so 1-based line numbers line up
// with the source.
pub function split_lines(src: string): string[] {
  let lines: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  let n: i32 = src.len();
  while (i < n) {
    if (src[i] == b'\n') {
      lines = lines.append(slice_unchecked(src, start, i) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  lines = lines.append(slice_unchecked(src, start, n) + "");
  return lines;
}

function join_lines(lines: string[]): string {
  let s: string = "";
  let i: i32 = 0;
  while (i < lines.len()) {
    if (i > 0) {
      s = s + "\n";
    }
    s = s + lines[i];
    i = i + 1;
  }
  return s;
}

// ─── fence + chunk-marker recognition ──────────────────────────────

// fence_open_len returns the length of the backtick run that opens a
// fenced code block (>= 3), or 0 if the line isn't a fence opener.
// Leading indentation is allowed.
function fence_open_len(line: string): i32 {
  let ws: string = leading_ws(line);
  let i: i32 = ws.len();
  let n: i32 = line.len();
  let count: i32 = 0;
  while (i < n && is_backtick(line[i])) {
    count = count + 1;
    i = i + 1;
  }
  if (count >= 3) {
    return count;
  }
  return 0;
}

// fence_lang returns the info-string language token of a fence opener
// (the first word after the backtick run).
function fence_lang(line: string): string {
  let ws: string = leading_ws(line);
  let i: i32 = ws.len();
  let n: i32 = line.len();
  while (i < n && is_backtick(line[i])) {
    i = i + 1;
  }
  let info: string = trim(slice_unchecked(line, i, n));
  let j: i32 = 0;
  let m: i32 = info.len();
  while (j < m && info[j] != b' ' && info[j] != b'\t') {
    j = j + 1;
  }
  return ascii_lower(slice_unchecked(info, 0, j) + "");
}

function ascii_lower(s: string): string {
  let buf: u8[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let c: u8 = s[i];
    if (c >= b'A' && c <= b'Z') {
      c = c + 32;
    }
    buf = buf.append(c);
    i = i + 1;
  }
  return string_from_bytes_unchecked(buf);
}

// fence_info returns the trimmed info string after a fence's backtick
// run — the language token plus any directives (`file=…`, `entry`).
function fence_info(line: string): string {
  let ws: string = leading_ws(line);
  let i: i32 = ws.len();
  let n: i32 = line.len();
  while (i < n && is_backtick(line[i])) {
    i = i + 1;
  }
  return trim(slice_unchecked(line, i, n));
}

// split_ws splits a string on runs of spaces/tabs into non-empty words.
function split_ws(s: string): string[] {
  let words: string[] = [];
  let n: i32 = s.len();
  let i: i32 = 0;
  while (i < n) {
    while (i < n && (s[i] == b' ' || s[i] == b'\t')) {
      i = i + 1;
    }
    let start: i32 = i;
    while (i < n && s[i] != b' ' && s[i] != b'\t') {
      i = i + 1;
    }
    if (i > start) {
      words = words.append(slice_unchecked(s, start, i) + "");
    }
  }
  return words;
}

// Directives is what a fence's info string declares past its language:
// `file=PATH` (a file root, `entry` marking the compile entry), `test` (an
// example `-doctest` runs) and its `name=NAME`. Quotes around a value are
// dropped.
struct Directives { file: string, name: string, entry: boolean, test: boolean }

function directives(line: string): Directives {
  let d: Directives = Directives { file: "", name: "", entry: false, test: false };
  for w in split_ws(fence_info(line)) {
    if (starts_with(w, "file=")) {
      d = Directives { ...d, file: trim_quotes(slice_unchecked(w, 5, w.len()) + "") };
    } else if (starts_with(w, "name=")) {
      d = Directives { ...d, name: trim_quotes(slice_unchecked(w, 5, w.len()) + "") };
    } else if (w == "entry") {
      d = Directives { ...d, entry: true };
    } else if (w == "test") {
      d = Directives { ...d, test: true };
    }
  }
  return d;
}

function trim_quotes(s: string): string {
  let a: i32 = 0;
  let b: i32 = s.len();
  while (a < b && s[a] == b'"') {
    a = a + 1;
  }
  while (b > a && s[b - 1] == b'"') {
    b = b - 1;
  }
  return slice_unchecked(s, a, b) + "";
}

// is_fence_close reports whether `line` closes a block opened with a
// run of `open_len` backticks — a line whose only content is a
// backtick run at least that long.
function is_fence_close(line: string, open_len: i32): boolean {
  let t: string = trim(line);
  let n: i32 = t.len();
  if (n < open_len) {
    return false;
  }
  let i: i32 = 0;
  while (i < n) {
    if (!is_backtick(t[i])) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// is_header reports whether a trimmed line is a chunk-definition
// header `<<NAME>>=` with a non-empty NAME free of `>>`.
function is_header(t: string): boolean {
  if (!starts_with(t, "<<") || !ends_with(t, ">>=")) {
    return false;
  }
  let inner: str = slice_unchecked(t, 2, t.len() - 3);
  if (contains(inner, ">>")) {
    return false;
  }
  return trim(inner).len() > 0;
}

function header_name(t: string): string {
  return trim(slice_unchecked(t, 2, t.len() - 3));
}

// is_ref reports whether a trimmed line is a chunk reference `<<NAME>>`.
// A header ends in `>>=` (not `>>`), so headers are excluded here.
pub function is_ref(t: string): boolean {
  if (!starts_with(t, "<<") || !ends_with(t, ">>")) {
    return false;
  }
  let inner: str = slice_unchecked(t, 2, t.len() - 2);
  if (inner.len() == 0) {
    return false;
  }
  if (contains(inner, "<<") || contains(inner, ">>")) {
    return false;
  }
  return true;
}

pub function ref_name(t: string): string {
  return trim(slice_unchecked(t, 2, t.len() - 2));
}

// de_escape strips the backslash from an escaped marker line — `\<<name>>`
// tangles to the literal `<<name>>` — keeping its indentation. Any other
// line is returned unchanged.
pub function de_escape(text: string): string {
  let ws: string = leading_ws(text);
  if (starts_with(slice_unchecked(text, ws.len(), text.len()) + "", "\\<<")) {
    return ws + slice_unchecked(text, ws.len() + 1, text.len());
  }
  return text;
}

// ─── document model ────────────────────────────────────────────────

// Piece is one physical body line of one chunk, tagged with the chunk
// it belongs to and its 1-based line number in the document. The whole
// document tangles down to a flat Piece[] in document order; a chunk's
// body is every Piece whose `chunk` matches, which makes same-name
// concatenation fall out for free.
pub struct Piece { chunk: string, text: string, line: i32 }

// ─── block model ───────────────────────────────────────────────────

// A document is a sequence of blocks: a run of prose up to the next fence,
// or one fenced block. A fence in another language is prose too.
pub const PROSE: i32 = 0;

// DISPLAY is a `fern` fence with no header and no directive: shown, never
// tangled.
pub const DISPLAY: i32 = 1;

pub const CHUNK: i32 = 2;

pub const FILE: i32 = 3;

pub const TEST: i32 = 4;

// Block is one block of a document: its kind; the chunk, file path or test
// name; its text, fences included; the document line it starts on; and for a
// CHUNK, FILE or TEST block, its body as `count` document lines from index
// `first` of Doc.lines — for a chunk, the lines after its header.
pub struct Block { kind: i32, name: string, raw: string, line: i32, is_entry: boolean, first: i32, count: i32 }

pub struct Doc { blocks: Block[], lines: string[] }

// header_index returns the offset of the `<<NAME>>=` header within the
// `count` lines from `first` (skipping leading blanks), or -1 when the first
// non-blank line isn't a header (a display-only block).
function header_index(lines: string[], first: i32, count: i32): i32 {
  let i: i32 = 0;
  while (i < count) {
    let t: string = trim(lines[first + i]);
    if (t.len() == 0) {
      i = i + 1;
    } else {
      if (is_header(t)) {
        return i;
      }
      return 0 - 1;
    }
  }
  return 0 - 1;
}

pub function join_range(lines: string[], from: i32, to: i32): string {
  let s: string = "";
  let i: i32 = from;
  while (i < to) {
    if (i > from) {
      s = s + "\n";
    }
    s = s + lines[i];
    i = i + 1;
  }
  return s;
}

// fence_block classifies the fenced block opening at line index `open`,
// whose body is the `count` lines after it.
function fence_block(lines: string[], open: i32, count: i32, raw: string): Block {
  let b: Block = Block { kind: PROSE, name: "", raw: raw, line: open + 1, is_entry: false, first: open + 1, count: count };
  if (fence_lang(lines[open]) != "fern") {
    return b;
  }
  let d: Directives = directives(lines[open]);
  if (d.file.len() > 0) {
    return Block { ...b, kind: FILE, name: d.file, is_entry: d.entry };
  }
  if (d.test) {
    return Block { ...b, kind: TEST, name: d.name };
  }
  let h: i32 = header_index(lines, open + 1, count);
  if (h < 0) {
    return Block { ...b, kind: DISPLAY };
  }
  return Block { ...b, kind: CHUNK, name: header_name(trim(lines[open + 1 + h])), first: open + 2 + h, count: count - h - 1 };
}

// parse splits a document into its blocks. A fence left open runs to the end
// of the document, less the empty line a final newline leaves.
pub function parse(src: string): Doc {
  let lines: string[] = split_lines(src);
  let n: i32 = lines.len();
  let ends_nl: boolean = n > 1 && lines[n - 1].len() == 0;
  let blocks: Block[] = [];
  let i: i32 = 0;
  while (i < n) {
    let start: i32 = i;
    let open_len: i32 = fence_open_len(lines[i]);
    if (open_len > 0) {
      i = i + 1;
      while (i < n && !is_fence_close(lines[i], open_len)) {
        i = i + 1;
      }
      let count: i32 = i - start - 1;
      if (i < n) {
        i = i + 1;
      } else if (ends_nl && count > 0) {
        count = count - 1;
      }
      blocks = blocks.append(fence_block(lines, start, count, join_range(lines, start, i)));
    } else {
      while (i < n && fence_open_len(lines[i]) == 0) {
        i = i + 1;
      }
      blocks = blocks.append(Block { kind: PROSE, name: "", raw: join_range(lines, start, i), line: start + 1, is_entry: false, first: 0, count: 0 });
    }
  }
  return Doc { blocks: blocks, lines: lines };
}

// pieces_of flattens a document's chunk definitions into Pieces.
function pieces_of(d: Doc): Piece[] {
  let pieces: Piece[] = [];
  for b in d.blocks {
    if (b.kind == CHUNK) {
      let k: i32 = b.first;
      while (k < b.first + b.count) {
        pieces = pieces.append(Piece { chunk: b.name, text: d.lines[k], line: k + 1 });
        k = k + 1;
      }
    }
  }
  return pieces;
}

// parse_pieces collects every chunk-body line as a tagged Piece. Prose,
// non-`fern` fences, display-only blocks, file roots and examples contribute
// nothing.
pub function parse_pieces(src: string): Piece[] {
  return pieces_of(parse(src));
}

// defined_chunks names every chunk in first-definition order.
pub function defined_chunks(d: Doc): string[] {
  let names: string[] = [];
  for b in d.blocks {
    if (b.kind == CHUNK && !stack_has(names, b.name)) {
      names = names.append(b.name);
    }
  }
  return names;
}

function chunk_defined(pieces: Piece[], name: string): boolean {
  let i: i32 = 0;
  while (i < pieces.len()) {
    if (pieces[i].chunk == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function stack_has(stack: string[], name: string): boolean {
  let i: i32 = 0;
  while (i < stack.len()) {
    if (stack[i] == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// header_line is the document line of chunk `name`'s first `<<name>>=`
// header: the line above its first body line.
function header_line(pieces: Piece[], name: string): i32 {
  let i: i32 = 0;
  while (i < pieces.len()) {
    if (pieces[i].chunk == name) {
      return pieces[i].line - 1;
    }
    i = i + 1;
  }
  return 1;
}

function undefined_ref(name: string): string {
  return "literate: reference to undefined chunk \"<<" + name + ">>\"";
}

// marker_col is the 1-based column of the `<<` a reference line opens with.
function marker_col(text: string): i32 {
  return leading_ws(text).len() + 1;
}

// ─── expansion ─────────────────────────────────────────────────────

// ExpandOk is an expansion: its lines, and for each the document line it
// came from (`lits`) and how many columns tangling moved it right
// (`shifts`) — the indentation prepended, less a stripped escape.
pub struct ExpandOk { lines: string[], lits: i32[], shifts: i32[] }

pub struct ExpandErr { msg: string, line: i32, col: i32 }

pub type ExpandResult = ExpandOk | ExpandErr;

function no_lines(): ExpandOk {
  return ExpandOk { lines: [], lits: [], shifts: [] };
}

// emit_line appends one literal body line, expanded under `indent`.
function emit_line(o: ExpandOk, indent: string, text: string, line: i32): ExpandOk {
  let de: string = de_escape(text);
  return ExpandOk { lines: o.lines.append(indent + de), lits: o.lits.append(line), shifts: o.shifts.append(indent.len() - (text.len() - de.len())) };
}

function append_lines(o: ExpandOk, more: ExpandOk): ExpandOk {
  let out: ExpandOk = o;
  let k: i32 = 0;
  while (k < more.lines.len()) {
    out = ExpandOk { lines: out.lines.append(more.lines[k]), lits: out.lits.append(more.lits[k]), shifts: out.shifts.append(more.shifts[k]) };
    k = k + 1;
  }
  return out;
}

// expand emits the expansion of chunk `name`, prefixing every line
// with `indent`. `active` is the set of chunks currently being
// expanded, for cycle detection.
function expand(pieces: Piece[], name: string, indent: string, active: string[]): ExpandResult {
  if (stack_has(active, name)) {
    return ExpandErr { msg: "literate: chunk \"<<" + name + ">>\" is defined in terms of itself (cyclic chunk reference)", line: header_line(pieces, name), col: 1 };
  }
  let active2: string[] = active.append(name);
  let out: ExpandOk = no_lines();
  let i: i32 = 0;
  while (i < pieces.len()) {
    if (pieces[i].chunk == name) {
      let text: string = pieces[i].text;
      let t: string = trim(text);
      if (is_ref(t)) {
        let rn: string = ref_name(t);
        if (!chunk_defined(pieces, rn)) {
          return ExpandErr { msg: undefined_ref(rn), line: pieces[i].line, col: marker_col(text) };
        }
        let sub: ExpandResult = expand(pieces, rn, indent + leading_ws(text), active2);
        match (sub) {
          ExpandOk(o) => {
            out = append_lines(out, o);
          },
          _ => {
            return sub;
          }
        }
      } else {
        out = emit_line(out, indent, text, pieces[i].line);
      }
    }
    i = i + 1;
  }
  return ExpandOk { lines: out.lines, lits: out.lits, shifts: out.shifts };
}

// ─── tangle ────────────────────────────────────────────────────────

// TangleOk is tangled source with its provenance: generated line k
// (1-based) came from document line lits[k-1], shifted shifts[k-1]
// columns right.
pub struct TangleOk { code: string, lits: i32[], shifts: i32[] }

pub struct TangleErr { msg: string, line: i32, col: i32 }

pub type TangleResult = TangleOk | TangleErr;

// tangle expands the root chunk `<<*>>` into compilable Fern source.
// Errors: no root chunk, reference to an undefined chunk, or a cyclic
// chunk reference.
pub function tangle(src: string): TangleResult {
  let pieces: Piece[] = parse_pieces(src);
  if (!chunk_defined(pieces, "*")) {
    return TangleErr { msg: "literate: no root chunk \"<<*>>\" defined (every literate program needs a `<<*>>=` block to tangle from)", line: 1, col: 1 };
  }
  let empty: string[] = [];
  let r: ExpandResult = expand(pieces, "*", "", empty);
  match (r) {
    ExpandOk(o) => {
      return TangleOk { code: join_lines(o.lines), lits: o.lits, shifts: o.shifts };
    },
    ExpandErr(e) => {
      return TangleErr { msg: e.msg, line: e.line, col: e.col };
    }
  }
}

// tangle_chunk expands ONE named chunk instead of the root — what
// `-chunk NAME` prints, for inspecting or extracting a single definition
// out of a document. Same expansion as `tangle`, so a chunk that
// references others pulls them in.
pub function tangle_chunk(src: string, name: string): TangleResult {
  let pieces: Piece[] = parse_pieces(src);
  if (!chunk_defined(pieces, name)) {
    return TangleErr { msg: "literate: no chunk \"<<" + name + ">>\" defined", line: 1, col: 1 };
  }
  let empty: string[] = [];
  let r: ExpandResult = expand(pieces, name, "", empty);
  match (r) {
    ExpandOk(o) => {
      return TangleOk { code: join_lines(o.lines), lits: o.lits, shifts: o.shifts };
    },
    ExpandErr(e) => {
      return TangleErr { msg: e.msg, line: e.line, col: e.col };
    }
  }
}

// unused_chunks names, in byte order, every chunk that neither the
// `<<*>>` root nor a `file=PATH` root reaches.
pub function unused_chunks(src: string): string[] {
  let pieces: Piece[] = parse_pieces(src);
  let todo: string[] = [];
  if (chunk_defined(pieces, "*")) {
    todo = todo.append("*");
  }
  let fp: FilePiece[] = parse_file_pieces(src);
  let i: i32 = 0;
  while (i < fp.len()) {
    if (is_ref(trim(fp[i].text))) {
      todo = todo.append(ref_name(trim(fp[i].text)));
    }
    i = i + 1;
  }
  let reached: string[] = [];
  let qi: i32 = 0;
  while (qi < todo.len()) {
    let n: string = todo[qi];
    qi = qi + 1;
    if (!stack_has(reached, n)) {
      reached = reached.append(n);
      let k: i32 = 0;
      while (k < pieces.len()) {
        if (pieces[k].chunk == n && is_ref(trim(pieces[k].text))) {
          todo = todo.append(ref_name(trim(pieces[k].text)));
        }
        k = k + 1;
      }
    }
  }
  let out: string[] = [];
  let j: i32 = 0;
  while (j < pieces.len()) {
    if (!stack_has(reached, pieces[j].chunk) && !stack_has(out, pieces[j].chunk)) {
      out = insert_sorted(out, pieces[j].chunk);
    }
    j = j + 1;
  }
  return out;
}

// insert_sorted inserts `s` into the byte-ordered `xs`.
pub function insert_sorted(xs: string[], s: string): string[] {
  let out: string[] = [];
  let placed: boolean = false;
  let i: i32 = 0;
  while (i < xs.len()) {
    if (!placed && bytes_less(s, xs[i])) {
      out = out.append(s);
      placed = true;
    }
    out = out.append(xs[i]);
    i = i + 1;
  }
  if (!placed) {
    out = out.append(s);
  }
  return out;
}

function bytes_less(a: string, b: string): boolean {
  let i: i32 = 0;
  while (i < a.len() && i < b.len()) {
    if (a[i] != b[i]) {
      return a[i] as i32 < b[i] as i32;
    }
    i = i + 1;
  }
  return a.len() < b.len();
}

// ─── multi-file tangle ─────────────────────────────────────────────
// A `file=PATH` fence is a *file-root*: its body becomes the module
// PATH (expanding `<<ref>>` chunks like the `<<*>>` root). One document
// can declare several, so a multi-module program is written as one
// document and partitioned into modules. This mirrors the Go engine's
// `TangleFiles` / `EntryFile` (internal/tools/literate/tanglefiles.go).

// FilePiece is one body line of a `file=PATH` block, tagged with its
// output path, document line, and whether the block was marked `entry`.
// Like Piece, the document flattens to a FilePiece[] so same-path
// concatenation is "every piece with this path".
pub struct FilePiece { path: string, text: string, line: i32, is_entry: boolean }

// parse_file_pieces collects every `file=PATH` block's body lines as
// tagged FilePieces. Non-`fern` and directive-less fences contribute
// nothing here (they go through parse_pieces as chunks / display-only).
pub function parse_file_pieces(src: string): FilePiece[] {
  let d: Doc = parse(src);
  let pieces: FilePiece[] = [];
  for b in d.blocks {
    if (b.kind == FILE) {
      pieces = append_body(pieces, d, b);
    }
  }
  return pieces;
}

// append_body appends block `b`'s body lines as FilePieces under its name.
function append_body(pieces: FilePiece[], d: Doc, b: Block): FilePiece[] {
  let out: FilePiece[] = pieces;
  let k: i32 = b.first;
  while (k < b.first + b.count) {
    out = out.append(FilePiece { path: b.name, text: d.lines[k], line: k + 1, is_entry: b.is_entry });
    k = k + 1;
  }
  return out;
}

// file_paths returns the distinct output paths in first-definition order.
function file_paths(fp: FilePiece[]): string[] {
  let paths: string[] = [];
  let i: i32 = 0;
  while (i < fp.len()) {
    if (!stack_has(paths, fp[i].path)) {
      paths = paths.append(fp[i].path);
    }
    i = i + 1;
  }
  return paths;
}

// fence_line is the document line of the fence opening `src`'s first
// `file=PATH` block.
pub function fence_line(src: string, path: string): i32 {
  for b in parse(src).blocks {
    if (b.kind == FILE && b.name == path) {
      return b.line;
    }
  }
  return 1;
}

// path_is_entry reports whether any block contributing to `path` carried
// the `entry` marker.
function path_is_entry(fp: FilePiece[], path: string): boolean {
  let i: i32 = 0;
  while (i < fp.len()) {
    if (fp[i].path == path && fp[i].is_entry) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// expand_file expands one file-root's body (the FilePieces for `path`),
// resolving `<<ref>>` lines into the shared chunk table just like the
// `<<*>>` root.
function expand_file(fp: FilePiece[], chunks: Piece[], path: string): ExpandResult {
  let out: ExpandOk = no_lines();
  let i: i32 = 0;
  while (i < fp.len()) {
    if (fp[i].path == path) {
      let text: string = fp[i].text;
      let t: string = trim(text);
      if (is_ref(t)) {
        let rn: string = ref_name(t);
        if (!chunk_defined(chunks, rn)) {
          return ExpandErr { msg: undefined_ref(rn), line: fp[i].line, col: marker_col(text) };
        }
        let empty: string[] = [];
        let sub: ExpandResult = expand(chunks, rn, leading_ws(text), empty);
        match (sub) {
          ExpandOk(o) => {
            out = append_lines(out, o);
          },
          _ => {
            return sub;
          }
        }
      } else {
        out = emit_line(out, "", text, fp[i].line);
      }
    }
    i = i + 1;
  }
  return ExpandOk { lines: out.lines, lits: out.lits, shifts: out.shifts };
}

// FileResult is one module a `file=PATH` document tangles to, with its
// provenance as TangleOk carries it.
pub struct FileResult { path: string, code: string, is_entry: boolean, lits: i32[], shifts: i32[] }

pub struct FileTangleOk { files: FileResult[] }

pub struct FileTangleErr { msg: string, line: i32, col: i32 }

pub type FileTangleResult = FileTangleOk | FileTangleErr;

// tangle_files expands every `file=PATH` root into its own module. Chunk
// definitions are shared across the whole document; each file-root pulls
// in whichever it references. Errors (undefined / cyclic chunk) carry the
// document line, exactly like single-file tangle.
pub function tangle_files(src: string): FileTangleResult {
  let chunks: Piece[] = parse_pieces(src);
  let fp: FilePiece[] = parse_file_pieces(src);
  let paths: string[] = file_paths(fp);
  if (paths.len() == 0) {
    return FileTangleErr { msg: "literate: no `file=PATH` blocks defined (a multi-file document needs at least one ```fern file=… root)", line: 1, col: 1 };
  }
  let results: FileResult[] = [];
  let i: i32 = 0;
  while (i < paths.len()) {
    let p: string = paths[i];
    let r: ExpandResult = expand_file(fp, chunks, p);
    match (r) {
      ExpandOk(o) => {
        results = results.append(FileResult { path: p, code: join_lines(o.lines), is_entry: path_is_entry(fp, p), lits: o.lits, shifts: o.shifts });
      },
      ExpandErr(e) => {
        return FileTangleErr { msg: e.msg, line: e.line, col: e.col };
      }
    }
    i = i + 1;
  }
  return FileTangleOk { files: results };
}

// ─── doctests ──────────────────────────────────────────────────────
// A ```fern test block is an example: tangled on its own, its `<<refs>>`
// expanded against the document's chunks, into a program `-doctest` runs.

// Doctest is one tangled example: its `name=` (empty when it has none), the
// line its fence opens on, and its code with the provenance TangleOk carries.
pub struct Doctest { name: string, line: i32, code: string, lits: i32[], shifts: i32[] }

pub struct DoctestsOk { tests: Doctest[] }

pub struct DoctestsErr { msg: string, line: i32, col: i32 }

pub type DoctestsResult = DoctestsOk | DoctestsErr;

pub function doctests(src: string): DoctestsResult {
  let d: Doc = parse(src);
  let chunks: Piece[] = pieces_of(d);
  let tests: Doctest[] = [];
  for b in d.blocks {
    if (b.kind == TEST) {
      let body: FilePiece[] = [];
      match (expand_file(append_body(body, d, b), chunks, b.name)) {
        ExpandOk(o) => {
          tests = tests.append(Doctest { name: b.name, line: b.line, code: join_lines(o.lines), lits: o.lits, shifts: o.shifts });
        },
        ExpandErr(e) => {
          return DoctestsErr { msg: e.msg, line: e.line, col: e.col };
        }
      }
    }
  }
  return DoctestsOk { tests: tests };
}

// entry_file picks the compile entry among tangled modules: the one file
// marked `entry`, the sole file, or else the unique module defining `main`.
// Returns "" when the choice is ambiguous.
pub function entry_file(files: FileResult[]): string {
  let marked: string[] = [];
  let i: i32 = 0;
  while (i < files.len()) {
    if (files[i].is_entry) {
      marked = marked.append(files[i].path);
    }
    i = i + 1;
  }
  if (marked.len() == 1) {
    return marked[0];
  }
  if (files.len() == 1) {
    return files[0].path;
  }
  let mains: string[] = [];
  let j: i32 = 0;
  while (j < files.len()) {
    if (defines_main(files[j].code)) {
      mains = mains.append(files[j].path);
    }
    j = j + 1;
  }
  if (mains.len() == 1) {
    return mains[0];
  }
  return "";
}

// defines_main reports whether a line of `code` declares a top-level
// `main`: `function main` or `fn main`, optionally `pub`, as the line's
// first words.
function defines_main(code: string): boolean {
  let lines: string[] = split_lines(code);
  let i: i32 = 0;
  while (i < lines.len()) {
    let w: string[] = split_ws(lines[i]);
    let k: i32 = 0;
    if (w.len() > 0 && w[0] == "pub") {
      k = 1;
    }
    if (w.len() > k + 1 && (w[k] == "function" || w[k] == "fn") && is_main_name(w[k + 1])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// is_main_name reports whether a word is `main` ending the name — `main`,
// `main()`, `main(): i32` — and not a longer name such as `mainloop`.
function is_main_name(word: string): boolean {
  if (!starts_with(word, "main")) {
    return false;
  }
  if (word.len() == 4) {
    return true;
  }
  let c: i32 = word[4] as i32;
  return !(c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 95);
}

// ─── self-test ─────────────────────────────────────────────────────
// main() asserts the engine against the same cases as the Go unit
// tests. Exit 0 = all passed; a non-zero code identifies the failure.

// tangle_code runs tangle and returns the code on success or "" on
// error (the success assertions compare against the expected code).
function tangle_code(src: string): string {
  let r: TangleResult = tangle(src);
  match (r) {
    TangleOk(o) => {
      return o.code;
    },
    TangleErr(e) => {
      return "";
    }
  }
}

function is_err(src: string): boolean {
  let r: TangleResult = tangle(src);
  match (r) {
    TangleOk(o) => {
      return false;
    },
    TangleErr(e) => {
      return true;
    }
  }
}

function err_line(src: string): i32 {
  let r: TangleResult = tangle(src);
  match (r) {
    TangleOk(o) => {
      return 0 - 1;
    },
    TangleErr(e) => {
      return e.line;
    }
  }
}

// tf_files runs tangle_files and returns the modules ([] on error).
function tf_files(src: string): FileResult[] {
  let r: FileTangleResult = tangle_files(src);
  match (r) {
    FileTangleOk(o) => {
      return o.files;
    },
    FileTangleErr(e) => {
      let empty: FileResult[] = [];
      return empty;
    }
  }
}

// tangled runs tangle and returns its result, empty on error.
function tangled(src: string): TangleOk {
  match (tangle(src)) {
    TangleOk(o) => {
      return TangleOk { code: o.code, lits: o.lits, shifts: o.shifts };
    },
    TangleErr(e) => {}
  }
  return TangleOk { code: "", lits: [], shifts: [] };
}

// lines_are reports whether a line map is exactly `want`.
function lines_are(got: i32[], want: i32[]): boolean {
  if (got.len() != want.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < got.len()) {
    if (got[i] != want[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// file_code returns the tangled code for `path` ("" if absent).
function file_code(files: FileResult[], path: string): string {
  let i: i32 = 0;
  while (i < files.len()) {
    if (files[i].path == path) {
      return files[i].code;
    }
    i = i + 1;
  }
  return "";
}

// check_chunks — Chunks: expansion, concatenation, indentation, display-only blocks and
// the three refusals.
function check_chunks(): i32 {
  // 1. Root chunk only.
  let s1: string = "# Title\n\nProse.\n\n```fern\n<<*>>=\nfn main() {}\n```\n";
  if (tangle_code(s1) != "fn main() {}") {
    return 1;
  }

  // 2. Out-of-order reference: the helper is defined *after* its use.
  let s2: string = "```fern\n<<*>>=\n<<greeting>>\ncall();\n```\n"
    + "\nDefined only now:\n\n"
    + "```fern\n<<greeting>>=\nfn greeting() {}\n```\n";
  if (tangle_code(s2) != "fn greeting() {}\ncall();") {
    return 2;
  }

  // 3. Same-name definitions concatenate in document order.
  let s3: string = "```fern\n<<*>>=\n<<body>>\n```\n"
    + "```fern\n<<body>>=\nline one\n```\n"
    + "```fern\n<<body>>=\nline two\n```\n";
  if (tangle_code(s3) != "line one\nline two") {
    return 3;
  }

  // 4. A reference's indentation is prepended to its expansion.
  let s4: string = "```fern\n<<*>>=\nfn main() {\n    <<body>>\n}\n```\n"
    + "```fern\n<<body>>=\nreturn 7;\n```\n";
  if (tangle_code(s4) != "fn main() {\n    return 7;\n}") {
    return 4;
  }

  // 5. A headerless `fern` block is display-only — never tangled.
  let s5: string = "```fern\nnot a chunk, illustrative only\n```\n"
    + "```fern\n<<*>>=\nfn main() {}\n```\n";
  if (tangle_code(s5) != "fn main() {}") {
    return 5;
  }
  if (contains(tangle_code(s5), "illustrative")) {
    return 6;
  }

  // 6. Missing root chunk is an error.
  if (!is_err("```fern\n<<helper>>=\nfn h() {}\n```\n")) {
    return 7;
  }

  // 7. Undefined reference is an error, reported at the ref's line.
  let s7: string = "```fern\n<<*>>=\n<<nope>>\n```\n";
  if (!is_err(s7)) {
    return 8;
  }
  if (err_line(s7) != 3) {
    return 9;
  }

  // 8. Cyclic chunk reference is an error.
  let s8: string = "```fern\n<<*>>=\n<<a>>\n```\n"
    + "```fern\n<<a>>=\n<<b>>\n```\n"
    + "```fern\n<<b>>=\n<<a>>\n```\n";
  if (!is_err(s8)) {
    return 10;
  }

  // 9. Longer fences (````) and a header after a blank line.
  let s9: string = "````fern\n\n<<*>>=\nfn main() {}\n````\n";
  if (tangle_code(s9) != "fn main() {}") {
    return 11;
  }
  return 0;
}

// check_files — File roots and the entry pick.
function check_files(): i32 {
  // 10. Multi-file: a `file=` document tangles to two modules, with a
  // chunk shared across them. The entry module references the helper.
  let m1: string = "```fern file=main.fern entry\nimport \"./u\";\n<<g>>\n```\n"
    + "```fern file=u.fern\n<<g>>\n```\n"
    + "```fern\n<<g>>=\npub fn g() {}\n```\n";
  let f1: FileResult[] = tf_files(m1);
  if (f1.len() != 2) {
    return 12;
  }
  if (file_code(f1, "main.fern") != "import \"./u\";\npub fn g() {}") {
    return 13;
  }
  if (file_code(f1, "u.fern") != "pub fn g() {}") {
    return 14;
  }
  if (entry_file(f1) != "main.fern") {
    return 15;
  }

  // 11. Same `file=PATH` repeated concatenates in document order.
  let m2: string = "```fern file=a.fern\nL1\n```\n"
    + "```fern file=a.fern\nL2\n```\n";
  let f2: FileResult[] = tf_files(m2);
  if (f2.len() != 1) {
    return 16;
  }
  if (file_code(f2, "a.fern") != "L1\nL2") {
    return 17;
  }

  // 12. A lone file needs no `entry` marker.
  let f3: FileResult[] = tf_files("```fern file=only.fern\nx\n```\n");
  if (entry_file(f3) != "only.fern") {
    return 18;
  }

  // 13. Ambiguous (two unmarked files, neither defines main) → "".
  let f4: FileResult[] = tf_files("```fern file=a.fern\nx\n```\n```fern file=b.fern\ny\n```\n");
  if (entry_file(f4) != "") {
    return 19;
  }

  // 14. None marked but exactly one defines main → that module.
  let m5: string = "```fern file=lib.fern\npub fn h() {}\n```\n"
    + "```fern file=app.fern\nfn main() {}\n```\n";
  if (entry_file(tf_files(m5)) != "app.fern") {
    return 20;
  }

  // 15. An undefined chunk referenced from a file-root is an error,
  // reported at the reference's document line.
  let r6: FileTangleResult = tangle_files("```fern file=m.fern\n<<nope>>\n```\n");
  match (r6) {
    FileTangleOk(o) => {
      return 21;
    },
    FileTangleErr(e) => {
      if (e.line != 2) {
        return 22;
      }
    }
  }
  return 0;
}

// check_maps — Line maps, escapes, the entry rule's edges and unused chunks.
function check_maps(): i32 {
  let s4: string = "```fern\n<<*>>=\nfn main() {\n    <<body>>\n}\n```\n"
    + "```fern\n<<body>>=\nreturn 7;\n```\n";
  let m1: string = "```fern file=main.fern entry\nimport \"./u\";\n<<g>>\n```\n"
    + "```fern file=u.fern\n<<g>>\n```\n"
    + "```fern\n<<g>>=\npub fn g() {}\n```\n";
  // 16. Each tangled line records its document line and the indentation
  // its reference prepended.
  let p4: TangleOk = tangled(s4);
  if (!lines_are(p4.lits, [3, 9, 5]) || !lines_are(p4.shifts, [0, 4, 0])) {
    return 23;
  }

  // 17. An escaped marker tangles to the literal marker, its column
  // shift reduced by the stripped backslash.
  let p17: TangleOk = tangled("```fern\n<<*>>=\n  \\<<x>>\n```\n");
  if (p17.code != "  <<x>>" || !lines_are(p17.lits, [3]) || !lines_are(p17.shifts, [0 - 1])) {
    return 24;
  }

  // 18. A file-root's lines, its own and a chunk's, map the same way.
  let pm: FileResult[] = tf_files(m1);
  if (pm.len() != 2 || pm[0].path != "main.fern" || !lines_are(pm[0].lits, [2, 10]) || !lines_are(pm[0].shifts, [0, 0])) {
    return 25;
  }

  // 19. Two files marked `entry` is no choice; the one defining main is.
  let m19: string = "```fern file=a.fern entry\npub fn h() {}\n```\n"
    + "```fern file=b.fern entry\npub function main(): i32 { return 0; }\n```\n";
  if (entry_file(tf_files(m19)) != "b.fern") {
    return 26;
  }

  // 20. A longer name beginning `main` does not declare main.
  let m20: string = "```fern file=a.fern\nfunction mainloop() {}\n```\n"
    + "```fern file=b.fern\n  fn main() {}\n```\n";
  if (entry_file(tf_files(m20)) != "b.fern") {
    return 27;
  }

  // 21. Chunks no root reaches, in byte order; one a file-root reaches and
  // one reached through another chunk are used.
  let m21: string = "```fern\n<<*>>=\n<<a>>\n```\n```fern\n<<a>>=\n<<b>>\n```\n```fern\n<<b>>=\nx\n```\n"
    + "```fern\n<<zed>>=\ny\n```\n```fern\n<<c>>=\nz\n```\n"
    + "```fern file=f.fern\n<<d>>\n```\n```fern\n<<d>>=\nw\n```\n";
  let un: string[] = unused_chunks(m21);
  if (un.len() != 2 || un[0] != "c" || un[1] != "zed") {
    return 28;
  }
  return 0;
}

// check_blocks — The block model: fence forms, examples and open fences.
function check_blocks(): i32 {
  // 22. The fence language is case-insensitive, and a quoted `file=` path
  // loses its quotes.
  if (tangle_code("```FERN\n<<*>>=\nx\n```\n") != "x") {
    return 29;
  }
  let f22: FileResult[] = tf_files("```fern file=\"q.fern\"\nx\n```\n");
  if (f22.len() != 1 || f22[0].path != "q.fern") {
    return 30;
  }

  // 23. An example or a file root that opens with a header is not a chunk.
  if (tangle_code("```fern test\n<<*>>=\nbad\n```\n```fern file=f.fern\n<<*>>=\nworse\n```\n```fern\n<<*>>=\ngood\n```\n") != "good") {
    return 31;
  }

  // 24. A fence left open at the end does not take the final newline's
  // empty line into its body.
  if (tangle_code("```fern\n<<*>>=\nx\n") != "x") {
    return 32;
  }

  // 25. Blocks: prose runs up to a fence, a fence in another language is
  // prose, and the text after the last fence is a block of its own.
  let d25: Doc = parse("# T\n\n```go\nx\n```\n```fern\nshow\n```\n");
  if (d25.blocks.len() != 4 || d25.blocks[0].raw != "# T\n" || d25.blocks[1].kind != PROSE || d25.blocks[1].raw != "```go\nx\n```"
    || d25.blocks[2].kind != DISPLAY || d25.blocks[2].line != 6 || d25.blocks[3].raw != "") {
    return 33;
  }

  return 0;
}

// check_doctests — examples tangled against the document's chunks.
function check_doctests(): i32 {
  // 26. Examples tangle on their own against the document's chunks.
  let s26: string = "```fern\n<<h>>=\nfn h() {}\n```\n```fern test name=\"adds\"\n<<h>>\nfn main() {}\n```\n```fern test\nfn main() {}\n```\n";
  match (doctests(s26)) {
    DoctestsOk(o) => {
      if (o.tests.len() != 2 || o.tests[0].name != "adds" || o.tests[0].code != "fn h() {}\nfn main() {}" || !lines_are(o.tests[0].lits, [3, 7])
        || o.tests[1].name != "" || o.tests[1].line != 9) {
        return 34;
      }
    },
    DoctestsErr(e) => {
      return 35;
    }
  }
  match (doctests("```fern test\n<<nope>>\n```\n")) {
    DoctestsOk(o) => {
      return 36;
    },
    DoctestsErr(e) => {
      if (e.line != 2 || e.col != 1) {
        return 37;
      }
    }
  }
  return 0;
}

function main(): i32 {
  let rc: i32 = check_chunks();
  if (rc == 0) {
    rc = check_files();
  }
  if (rc == 0) {
    rc = check_maps();
  }
  if (rc == 0) {
    rc = check_blocks();
  }
  if (rc == 0) {
    rc = check_doctests();
  }
  return rc;
}
