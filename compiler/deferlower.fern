import "./parser";
import "./ast";
import "./astwalk";
import "./util";

struct DeferAcc { stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[] }

function dl_stmts_have_defer(stmts: ast.Stmt[]): boolean {
  for i in 0..stmts.len() {
    if (dl_stmt_has_defer(stmts[i])) {
      return true;
    }
  }
  return false;
}

function dl_stmts_have_defer_deep(stmts: ast.Stmt[]): boolean {
  function vs(st: ast.Stmt, own hit: boolean): boolean {
    if (hit) {
      return true;
    }
    match (st) {
      ast.StmtDefer(_) => {
        return true;
      },
      _ => {
        return false;
      }
    }
  }
  function ve(e: ast.Expr, own hit: boolean): boolean {
    return hit;
  }
  let hit = false;
  for st in stmts {
    hit = astwalk.fold_stmt_nodes(st, hit, vs, ve, astwalk.descend_all);
  }
  return hit;
}

function dl_stmt_has_defer(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtDefer(_) => {
      return true;
    },
    ast.StmtVar(v) => {
      return dl_expr_has_defer(v.init);
    },
    ast.StmtReturn(r) => {
      return dl_expr_has_defer(r.value);
    },
    ast.StmtExpr(x) => {
      return dl_expr_has_defer(x.value);
    },
    ast.StmtAssign(a) => {
      return dl_expr_has_defer(a.value);
    },
    ast.StmtIf(f) => {
      return dl_expr_has_defer(f.cond) || dl_stmts_have_defer(f.then_body) || dl_stmts_have_defer(f.else_body);
    },
    ast.StmtWhile(w) => {
      return dl_expr_has_defer(w.cond) || dl_stmts_have_defer(w.body);
    },
    ast.StmtFor(fr) => {
      return dl_expr_has_defer(fr.iter) || dl_stmts_have_defer(fr.body);
    },
    ast.StmtMatch(m) => {
      if (dl_expr_has_defer(m.scrutinee)) {
        return true;
      }
      for i in 0..m.arms.len() {
        if (dl_expr_has_defer(m.arms[i].guard)) {
          return true;
        }
        if (dl_stmts_have_defer(m.arms[i].body)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
}

function dl_exprs_have_defer(es: ast.Expr[]): boolean {
  for i in 0..es.len() {
    if (dl_expr_has_defer(es[i])) {
      return true;
    }
  }
  return false;
}

function dl_expr_has_defer(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (parser.is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            return dl_stmts_have_defer(l.body);
          },
          _ => {}
        }
      }
      if (dl_expr_has_defer(c.callee)) {
        return true;
      }
      return dl_exprs_have_defer(c.args);
    },
    ast.ExprBinary(b) => {
      return dl_expr_has_defer(b.left) || dl_expr_has_defer(b.right);
    },
    ast.ExprUnary(u) => {
      return dl_expr_has_defer(u.operand);
    },
    ast.ExprArray(a) => {
      return dl_exprs_have_defer(a.elements);
    },
    ast.ExprTuple(t) => {
      return dl_exprs_have_defer(t.elements);
    },
    ast.ExprIndex(x) => {
      return dl_expr_has_defer(x.array) || dl_expr_has_defer(x.index);
    },
    ast.ExprSlice(sl) => {
      return dl_expr_has_defer(sl.array) || dl_expr_has_defer(sl.start) || dl_expr_has_defer(sl.end);
    },
    ast.ExprStructLit(s) => {
      return dl_expr_has_defer(s.base) || dl_exprs_have_defer(s.field_values);
    },
    ast.ExprFieldAccess(fa) => {
      return dl_expr_has_defer(fa.obj);
    },
    ast.ExprMapLit(m) => {
      return dl_exprs_have_defer(m.keys) || dl_exprs_have_defer(m.vals);
    },
    ast.ExprFString(f) => {
      return dl_exprs_have_defer(f.exprs);
    },
    _ => {
      return false;
    }
  }
}

function dl_while(w: ast.StmtWhile, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtWhile { cond: w.cond, body: body, label: w.label, line: w.line, is_loop: w.is_loop };
}

function dl_for(fr: ast.StmtFor, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: body, label: fr.label, line: fr.line, col: fr.col, destr: fr.destr };
}

function dl_iter_cleanup(actions: ast.Stmt[], flags: i32[], start: i32, end: i32): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i = end - 1;
  while (i >= start) {
    let name = "__dfa" + util.i32_to_string(i);
    let body1: ast.Stmt[] = [];
    if (flags[i] == 0) {
      body1 = body1.append(actions[i]);
    }
    body1 = body1.append(parser.s_assign(name, parser.e_bool(false)));
    let noelse: ast.Stmt[] = [];
    out = out.append(parser.s_if(parser.e_ident(name), body1, noelse));
    i -= 1;
  }
  return out;
}

struct DeferEdges { stmts: ast.Stmt[], armed: i32 }

pub function defer_flag(name: string): i32 {
  if (name.len() < 6 || !name.starts_with("__dfa")) {
    return -1;
  }
  let digits = slice_unchecked(name, 5, name.len()).to_owned();
  if (!util.is_all_digits(digits)) {
    return -1;
  }
  return util.digits_to_i32(digits);
}

pub function defer_armed(a: ast.StmtAssign): i32 {
  if let ast.ExprBool(b) = a.value {
    if (b.value) {
      return defer_flag(a.target);
    }
  }
  return -1;
}

struct DeferEdgeExpr { expr: ast.Expr, armed: i32 }

function dl_edges_expr(e: ast.Expr, actions: ast.Stmt[], flags: i32[], start: i32, armed0: i32, label: string, own_level: boolean): DeferEdgeExpr {
  match (e) {
    ast.ExprCall(c) => {
      if (parser.is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            let vb = dl_expand_loop_edges(l.body, actions, flags, start, armed0, label, own_level);
            return DeferEdgeExpr { expr: parser.dl_vb_rebuild(c, vb.stmts), armed: vb.armed };
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  let kids = parser.dl_expr_kids(e);
  if (kids.len() == 0) {
    return DeferEdgeExpr { expr: e, armed: armed0 };
  }
  let out: ast.Expr[] = [];
  let armed = armed0;
  for i in 0..kids.len() {
    let r = dl_edges_expr(kids[i], actions, flags, start, armed, label, own_level);
    out = out.append(r.expr);
    armed = r.armed;
  }
  return DeferEdgeExpr { expr: parser.dl_expr_with_kids(e, out), armed: armed };
}

function dl_expand_loop_edges(stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[], start: i32, armed0: i32, label: string, own_level: boolean): DeferEdges {
  let out: ast.Stmt[] = [];
  let armed = armed0;
  for i in 0..stmts.len() {
    match (stmts[i]) {
      ast.StmtAssign(a) => {
        let ave = dl_edges_expr(a.value, actions, flags, start, armed, label, own_level);
        armed = ave.armed;
        let ast = ast.StmtAssign { ...a, value: ave.expr };
        let ax = defer_armed(ast);
        if (ax >= armed) {
          armed = ax + 1;
        }
        out = out.append(ast);
      },
      ast.StmtVar(v) => {
        let vve = dl_edges_expr(v.init, actions, flags, start, armed, label, own_level);
        armed = vve.armed;
        out = out.append(ast.StmtVar { name: v.name, type_name: v.type_name, init: vve.expr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types, destr: v.destr, header: v.header });
      },
      ast.StmtExpr(x) => {
        let xve = dl_edges_expr(x.value, actions, flags, start, armed, label, own_level);
        armed = xve.armed;
        out = out.append(ast.StmtExpr { ...x, value: xve.expr });
      },
      ast.StmtReturn(r) => {
        let rve = dl_edges_expr(r.value, actions, flags, start, armed, label, own_level);
        armed = rve.armed;
        out = out.append(ast.StmtReturn { value: rve.expr, line: r.line, col: r.col });
      },
      ast.StmtBreak(b) => {
        if (own_level && b.label.len() == 0 || label.len() > 0 && b.label == label) {
          let cb = dl_iter_cleanup(actions, flags, start, armed);
          for kb in 0..cb.len() {
            out = out.append(cb[kb]);
          }
        }
        out = out.append(stmts[i]);
      },
      ast.StmtContinue(c) => {
        if (own_level && c.label.len() == 0 || label.len() > 0 && c.label == label) {
          let cc = dl_iter_cleanup(actions, flags, start, armed);
          for kc in 0..cc.len() {
            out = out.append(cc[kc]);
          }
        }
        out = out.append(stmts[i]);
      },
      ast.StmtIf(f) => {
        let ce = dl_edges_expr(f.cond, actions, flags, start, armed, label, own_level);
        armed = ce.armed;
        let tr = dl_expand_loop_edges(f.then_body, actions, flags, start, armed, label, own_level);
        let er = dl_expand_loop_edges(f.else_body, actions, flags, start, armed, label, own_level);
        if (tr.armed > armed) {
          armed = tr.armed;
        }
        if (er.armed > armed) {
          armed = er.armed;
        }
        out = out.append(parser.s_if(ce.expr, tr.stmts, er.stmts));
      },
      ast.StmtMatch(m) => {
        let se = dl_edges_expr(m.scrutinee, actions, flags, start, armed, label, own_level);
        armed = se.armed;
        let arms: ast.MatchArm[] = [];
        for ai in 0..m.arms.len() {
          let ge = dl_edges_expr(m.arms[ai].guard, actions, flags, start, armed, label, own_level);
          let ar = dl_expand_loop_edges(m.arms[ai].body, actions, flags, start, ge.armed, label, own_level);
          if (ar.armed > armed) {
            armed = ar.armed;
          }
          arms = arms.append(ast.MatchArm { pattern: m.arms[ai].pattern, body: ar.stmts, line: m.arms[ai].line, col: m.arms[ai].col, guard: ge.expr, has_guard: m.arms[ai].has_guard, alt_cont: false });
        }
        out = out.append(parser.s_match(se.expr, arms));
      },
      ast.StmtWhile(w) => {
        let wce = dl_edges_expr(w.cond, actions, flags, start, armed, label, own_level);
        armed = wce.armed;
        let wl = ast.StmtWhile { cond: wce.expr, body: w.body, label: w.label, line: w.line, is_loop: w.is_loop };
        let wr = dl_expand_loop_edges(w.body, actions, flags, start, armed, label, false);
        if (wr.armed > armed) {
          armed = wr.armed;
        }
        if (label.len() == 0) {
          out = out.append(dl_while(wl, w.body));
        } else {
          out = out.append(dl_while(wl, wr.stmts));
        }
      },
      ast.StmtFor(fr) => {
        let fie = dl_edges_expr(fr.iter, actions, flags, start, armed, label, own_level);
        armed = fie.armed;
        let fl = ast.StmtFor { var_name: fr.var_name, iter: fie.expr, body: fr.body, label: fr.label, line: fr.line, col: fr.col, destr: fr.destr };
        let fr2 = dl_expand_loop_edges(fr.body, actions, flags, start, armed, label, false);
        if (fr2.armed > armed) {
          armed = fr2.armed;
        }
        if (label.len() == 0) {
          out = out.append(dl_for(fl, fr.body));
        } else {
          out = out.append(dl_for(fl, fr2.stmts));
        }
      },
      _ => {
        out = out.append(stmts[i]);
      }
    }
  }
  return DeferEdges { stmts: out, armed: armed };
}

function dl_loop_body(body: ast.Stmt[], actions: ast.Stmt[], flags: i32[], start: i32, label: string): ast.Stmt[] {
  let end = actions.len();
  if (end <= start) {
    return body;
  }
  let r = dl_expand_loop_edges(body, actions, flags, start, start, label, true);
  let out = r.stmts;
  let cleanup = dl_iter_cleanup(actions, flags, start, end);
  for i in 0..cleanup.len() {
    out = out.append(cleanup[i]);
  }
  return out;
}

function dl_collect_stmts(stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[]): DeferAcc {
  let out: ast.Stmt[] = [];
  let acc = actions;
  let afl = flags;
  for i in 0..stmts.len() {
    let r = dl_collect_stmt(stmts[i], acc, afl);
    for j in 0..r.stmts.len() {
      out = out.append(r.stmts[j]);
    }
    acc = r.actions;
    afl = r.flags;
  }
  return DeferAcc { stmts: out, actions: acc, flags: afl };
}

struct DeferExprAcc { expr: ast.Expr, actions: ast.Stmt[], flags: i32[] }

function dl_collect_expr(e: ast.Expr, actions: ast.Stmt[], flags: i32[]): DeferExprAcc {
  match (e) {
    ast.ExprCall(c) => {
      if (parser.is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            let vb = dl_collect_stmts(l.body, actions, flags);
            return DeferExprAcc { expr: parser.dl_vb_rebuild(c, vb.stmts), actions: vb.actions, flags: vb.flags };
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  let kids = parser.dl_expr_kids(e);
  if (kids.len() == 0) {
    return DeferExprAcc { expr: e, actions: actions, flags: flags };
  }
  let out: ast.Expr[] = [];
  let acc = actions;
  let afl = flags;
  for i in 0..kids.len() {
    let r = dl_collect_expr(kids[i], acc, afl);
    out = out.append(r.expr);
    acc = r.actions;
    afl = r.flags;
  }
  return DeferExprAcc { expr: parser.dl_expr_with_kids(e, out), actions: acc, flags: afl };
}

function dl_collect_stmt(st: ast.Stmt, actions: ast.Stmt[], flags: i32[]): DeferAcc {
  match (st) {
    ast.StmtDefer(d) => {
      let setflag = parser.s_assign("__dfa" + util.i32_to_string(actions.len()), parser.e_bool(true));
      let one: ast.Stmt[] = [setflag];
      return DeferAcc { stmts: one, actions: actions.append(d.action), flags: flags.append(d.on_error) };
    },
    ast.StmtVar(v) => {
      let ir = dl_collect_expr(v.init, actions, flags);
      let one: ast.Stmt[] = [ast.StmtVar { name: v.name, type_name: v.type_name, init: ir.expr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types, destr: v.destr, header: v.header }];
      return DeferAcc { stmts: one, actions: ir.actions, flags: ir.flags };
    },
    ast.StmtReturn(r) => {
      let vr = dl_collect_expr(r.value, actions, flags);
      let one: ast.Stmt[] = [ast.StmtReturn { value: vr.expr, line: r.line, col: r.col }];
      return DeferAcc { stmts: one, actions: vr.actions, flags: vr.flags };
    },
    ast.StmtExpr(x) => {
      let xr = dl_collect_expr(x.value, actions, flags);
      let one: ast.Stmt[] = [ast.StmtExpr { ...x, value: xr.expr }];
      return DeferAcc { stmts: one, actions: xr.actions, flags: xr.flags };
    },
    ast.StmtAssign(a) => {
      let ar = dl_collect_expr(a.value, actions, flags);
      let one: ast.Stmt[] = [ast.StmtAssign { ...a, value: ar.expr }];
      return DeferAcc { stmts: one, actions: ar.actions, flags: ar.flags };
    },
    ast.StmtIf(f) => {
      let cr = dl_collect_expr(f.cond, actions, flags);
      let tr = dl_collect_stmts(f.then_body, cr.actions, cr.flags);
      let er = dl_collect_stmts(f.else_body, tr.actions, tr.flags);
      let one: ast.Stmt[] = [parser.s_if(cr.expr, tr.stmts, er.stmts)];
      return DeferAcc { stmts: one, actions: er.actions, flags: er.flags };
    },
    ast.StmtWhile(w) => {
      let cw = dl_collect_expr(w.cond, actions, flags);
      let wstart = cw.actions.len();
      let br = dl_collect_stmts(w.body, cw.actions, cw.flags);
      let wl = ast.StmtWhile { cond: cw.expr, body: w.body, label: w.label, line: w.line, is_loop: w.is_loop };
      let one: ast.Stmt[] = [dl_while(wl, dl_loop_body(br.stmts, br.actions, br.flags, wstart, w.label))];
      return DeferAcc { stmts: one, actions: br.actions, flags: br.flags };
    },
    ast.StmtFor(fr) => {
      let itr = dl_collect_expr(fr.iter, actions, flags);
      let fstart = itr.actions.len();
      let br = dl_collect_stmts(fr.body, itr.actions, itr.flags);
      let fl = ast.StmtFor { var_name: fr.var_name, iter: itr.expr, body: fr.body, label: fr.label, line: fr.line, col: fr.col, destr: fr.destr };
      let one: ast.Stmt[] = [dl_for(fl, dl_loop_body(br.stmts, br.actions, br.flags, fstart, fr.label))];
      return DeferAcc { stmts: one, actions: br.actions, flags: br.flags };
    },
    ast.StmtMatch(m) => {
      let sr = dl_collect_expr(m.scrutinee, actions, flags);
      let arms: ast.MatchArm[] = [];
      let acc = sr.actions;
      let afl = sr.flags;
      for i in 0..m.arms.len() {
        let gr = dl_collect_expr(m.arms[i].guard, acc, afl);
        let ar = dl_collect_stmts(m.arms[i].body, gr.actions, gr.flags);
        arms = arms.append(ast.MatchArm { pattern: m.arms[i].pattern, body: ar.stmts, line: m.arms[i].line, col: m.arms[i].col, guard: gr.expr, has_guard: m.arms[i].has_guard, alt_cont: false });
        acc = ar.actions;
        afl = ar.flags;
      }
      let one: ast.Stmt[] = [parser.s_match(sr.expr, arms)];
      return DeferAcc { stmts: one, actions: acc, flags: afl };
    },
    _ => {
      let one: ast.Stmt[] = [st];
      return DeferAcc { stmts: one, actions: actions, flags: flags };
    }
  }
}

function dl_cleanup_kind(actions: ast.Stmt[], flags: i32[], want: i32, end: i32): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i = end - 1;
  while (i >= 0) {
    if (flags[i] == want) {
      let body1: ast.Stmt[] = [actions[i]];
      let noelse: ast.Stmt[] = [];
      out = out.append(parser.s_if(parser.e_ident("__dfa" + util.i32_to_string(i)), body1, noelse));
    }
    i -= 1;
  }
  return out;
}

function dl_is_err_value(e: ast.Expr): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == "None";
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return cid.name == "Err";
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

function dl_expand_returns(stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let at = armed;
  for st in stmts {
    out = util.append_all(out, dl_expand_return_stmt(st, actions, flags, at));
    at = dl_armed_after(st, at);
  }
  return out;
}

function dl_armed_after(st: ast.Stmt, armed: i32): i32 {
  return astwalk.fold_stmt_nodes(st, armed, dl_arm_stmt, dl_arm_expr, dl_arm_descend);
}

function dl_armed_after_expr(e: ast.Expr, armed: i32): i32 {
  return astwalk.fold_expr_nodes(e, armed, dl_arm_stmt, dl_arm_expr, dl_arm_descend);
}

function dl_arm_stmt(st: ast.Stmt, own acc: i32): i32 {
  if let ast.StmtAssign(a) = st {
    let ax = defer_armed(a);
    if (ax >= acc) {
      return ax + 1;
    }
  }
  return acc;
}

function dl_arm_expr(e: ast.Expr, own acc: i32): i32 {
  return acc;
}

function dl_arm_descend(e: ast.Expr): boolean {
  if let ast.ExprLambda(l) = e {
    return parser.is_value_block_origin(l.origin);
  }
  return true;
}

// The body of a value block. Its last statement gives the value of the
// block, so a `return` there does not leave the function.
function dl_expand_returns_vb(body: ast.Stmt[], actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt[] {
  if (body.len() == 0) {
    return body;
  }
  let out: ast.Stmt[] = [];
  let at = armed;
  for i in 0..body.len() - 1 {
    out = util.append_all(out, dl_expand_return_stmt(body[i], actions, flags, at));
    at = dl_armed_after(body[i], at);
  }
  return out.append(dl_vb_value_stmt(body[body.len() - 1], actions, flags, at));
}

// The statement that gives the value of a value block. For an `if` or a
// `match`, each branch is a value block in its turn.
function dl_vb_value_stmt(st: ast.Stmt, actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt {
  match (st) {
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: dl_return_expr(r.value, actions, flags, armed) };
    },
    ast.StmtIf(f) => {
      let at = dl_armed_after_expr(f.cond, armed);
      return ast.StmtIf { ...f, cond: dl_return_expr(f.cond, actions, flags, armed), then_body: dl_expand_returns_vb(f.then_body, actions, flags, at), else_body: dl_expand_returns_vb(f.else_body, actions, flags, at) };
    },
    ast.StmtMatch(m) => {
      let at = dl_armed_after_expr(m.scrutinee, armed);
      let arms: ast.MatchArm[] = [];
      for a in m.arms {
        let body_at = dl_armed_after_expr(a.guard, at);
        arms = arms.append(ast.MatchArm { ...a, body: dl_expand_returns_vb(a.body, actions, flags, body_at), guard: dl_return_expr(a.guard, actions, flags, at) });
      }
      return ast.StmtMatch { ...m, scrutinee: dl_return_expr(m.scrutinee, actions, flags, armed), arms: arms };
    },
    _ => {
      return st;
    }
  }
}

function dl_return_expr(e: ast.Expr, actions: ast.Stmt[], flags: i32[], armed: i32): ast.Expr {
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      if let ast.ExprLambda(l) = c.callee {
        return parser.dl_vb_rebuild(c, dl_expand_returns_vb(l.body, actions, flags, armed));
      }
    }
  }
  let kids = parser.dl_expr_kids(e);
  if (kids.len() == 0) {
    return e;
  }
  let out: ast.Expr[] = [];
  let at = armed;
  for k in kids {
    out = out.append(dl_return_expr(k, actions, flags, at));
    at = dl_armed_after_expr(k, at);
  }
  return parser.dl_expr_with_kids(e, out);
}

function dl_expand_return(r: ast.StmtReturn, actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt[] {
  let rv = dl_return_expr(r.value, actions, flags, armed);
  let at = dl_armed_after_expr(r.value, armed);
  let isvoid = false;
  if let ast.ExprUnknown(_) = rv {
    isvoid = true;
  }
  let out: ast.Stmt[] = [];
  if (!isvoid) {
    out = out.append(parser.s_assign("__defret", rv));
  }
  out = util.append_all(out, dl_cleanup_kind(actions, flags, 0, at));
  if (!isvoid && dl_is_err_value(rv)) {
    out = util.append_all(out, dl_cleanup_kind(actions, flags, 1, at));
  }
  if (isvoid) {
    return out.append(parser.s_return(rv));
  }
  return out.append(parser.s_return(parser.e_ident("__defret")));
}

function dl_expand_return_match(m: ast.StmtMatch, actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt {
  let at = dl_armed_after_expr(m.scrutinee, armed);
  let arms: ast.MatchArm[] = [];
  for a in m.arms {
    let body_at = dl_armed_after_expr(a.guard, at);
    arms = arms.append(ast.MatchArm { pattern: a.pattern, body: dl_expand_returns(a.body, actions, flags, body_at), line: a.line, col: a.col, guard: dl_return_expr(a.guard, actions, flags, at), has_guard: a.has_guard, alt_cont: false });
  }
  return parser.s_match(dl_return_expr(m.scrutinee, actions, flags, armed), arms);
}

function dl_expand_return_stmt(st: ast.Stmt, actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt[] {
  match (st) {
    ast.StmtReturn(r) => {
      return dl_expand_return(r, actions, flags, armed);
    },
    ast.StmtVar(v) => {
      let one: ast.Stmt[] = [ast.StmtVar { name: v.name, type_name: v.type_name, init: dl_return_expr(v.init, actions, flags, armed), line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types, destr: v.destr, header: v.header }];
      return one;
    },
    ast.StmtExpr(x) => {
      let one: ast.Stmt[] = [ast.StmtExpr { ...x, value: dl_return_expr(x.value, actions, flags, armed) }];
      return one;
    },
    ast.StmtAssign(a) => {
      let one: ast.Stmt[] = [ast.StmtAssign { ...a, value: dl_return_expr(a.value, actions, flags, armed) }];
      return one;
    },
    ast.StmtIf(f) => {
      let at = dl_armed_after_expr(f.cond, armed);
      let one: ast.Stmt[] = [parser.s_if(dl_return_expr(f.cond, actions, flags, armed), dl_expand_returns(f.then_body, actions, flags, at), dl_expand_returns(f.else_body, actions, flags, at))];
      return one;
    },
    ast.StmtWhile(w) => {
      let wl = ast.StmtWhile { cond: dl_return_expr(w.cond, actions, flags, armed), body: w.body, label: w.label, line: w.line, is_loop: w.is_loop };
      let one: ast.Stmt[] = [dl_while(wl, dl_expand_returns(w.body, actions, flags, dl_armed_after_expr(w.cond, armed)))];
      return one;
    },
    ast.StmtFor(fr) => {
      let fl = ast.StmtFor { var_name: fr.var_name, iter: dl_return_expr(fr.iter, actions, flags, armed), body: fr.body, label: fr.label, line: fr.line, col: fr.col, destr: fr.destr };
      let one: ast.Stmt[] = [dl_for(fl, dl_expand_returns(fr.body, actions, flags, dl_armed_after_expr(fr.iter, armed)))];
      return one;
    },
    ast.StmtMatch(m) => {
      let one: ast.Stmt[] = [dl_expand_return_match(m, actions, flags, armed)];
      return one;
    },
    _ => {
      let one: ast.Stmt[] = [st];
      return one;
    }
  }
}

struct DeferHoist { stmts: ast.Stmt[], decls: ast.Stmt[] }

struct DeferHoistExpr { expr: ast.Expr, decls: ast.Stmt[] }

function dl_zeroable(t: string): boolean {
  return t.len() > 0;
}

function dl_zero_of(t: string): ast.Expr {
  return ast.ExprZero { type_name: t, line: 0, col: 0 };
}

function dl_add_name(own acc: string[], name: string): string[] {
  if (name.len() == 0 || util.has_str(acc, name)) {
    return acc;
  }
  return acc.append(name);
}

function dl_name_stmt(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtAssign(a) = st {
    return dl_add_name(acc, a.target);
  }
  return acc;
}

function dl_name_expr(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprIdent(id) = e {
    return dl_add_name(acc, id.name);
  }
  return acc;
}

function dl_action_names(actions: ast.Stmt[]): string[] {
  let acc: string[] = [];
  for a in actions {
    acc = astwalk.fold_stmt_nodes(a, acc, dl_name_stmt, dl_name_expr, astwalk.descend_all);
  }
  return acc;
}

function dl_hoist_stmts(stmts: ast.Stmt[], want: string[], nested: boolean): DeferHoist {
  let out: ast.Stmt[] = [];
  let decls: ast.Stmt[] = [];
  for st in stmts {
    let r = dl_hoist_stmt(st, want, nested);
    out = util.append_all(out, r.stmts);
    decls = util.append_all(decls, r.decls);
  }
  return DeferHoist { stmts: out, decls: decls };
}

function dl_hoist_var(v: ast.StmtVar, want: string[], nested: boolean): DeferHoist {
  let ir = dl_hoist_expr(v.init, want);
  if (!nested || !util.has_str(want, v.name) || !dl_zeroable(v.type_name)) {
    let kept: ast.Stmt[] = [ast.StmtVar { ...v, init: ir.expr }];
    return DeferHoist { stmts: kept, decls: ir.decls };
  }
  let lifted: ast.Stmt[] = [parser.s_var(v.name, v.type_name, dl_zero_of(v.type_name))];
  let one: ast.Stmt[] = [parser.s_assign_at(v.name, ir.expr, v.line, v.col, v.line, v.col)];
  return DeferHoist { stmts: one, decls: util.append_all(lifted, ir.decls) };
}

function dl_hoist_stmt(st: ast.Stmt, want: string[], nested: boolean): DeferHoist {
  match (st) {
    ast.StmtVar(v) => {
      return dl_hoist_var(v, want, nested);
    },
    ast.StmtIf(f) => {
      let cr = dl_hoist_expr(f.cond, want);
      let tr = dl_hoist_stmts(f.then_body, want, true);
      let er = dl_hoist_stmts(f.else_body, want, true);
      let one: ast.Stmt[] = [parser.s_if(cr.expr, tr.stmts, er.stmts)];
      return DeferHoist { stmts: one, decls: util.append_all(util.append_all(cr.decls, tr.decls), er.decls) };
    },
    ast.StmtWhile(w) => {
      let cw = dl_hoist_expr(w.cond, want);
      let br = dl_hoist_stmts(w.body, want, true);
      let one: ast.Stmt[] = [dl_while(ast.StmtWhile { ...w, cond: cw.expr }, br.stmts)];
      return DeferHoist { stmts: one, decls: util.append_all(cw.decls, br.decls) };
    },
    ast.StmtFor(fr) => {
      let itr = dl_hoist_expr(fr.iter, want);
      let br = dl_hoist_stmts(fr.body, want, true);
      let one: ast.Stmt[] = [dl_for(ast.StmtFor { ...fr, iter: itr.expr }, br.stmts)];
      return DeferHoist { stmts: one, decls: util.append_all(itr.decls, br.decls) };
    },
    ast.StmtMatch(m) => {
      return dl_hoist_match(m, want);
    },
    ast.StmtReturn(r) => {
      let vr = dl_hoist_expr(r.value, want);
      let one: ast.Stmt[] = [ast.StmtReturn { ...r, value: vr.expr }];
      return DeferHoist { stmts: one, decls: vr.decls };
    },
    ast.StmtExpr(x) => {
      let xr = dl_hoist_expr(x.value, want);
      let one: ast.Stmt[] = [ast.StmtExpr { ...x, value: xr.expr }];
      return DeferHoist { stmts: one, decls: xr.decls };
    },
    ast.StmtAssign(a) => {
      let ar = dl_hoist_expr(a.value, want);
      let one: ast.Stmt[] = [ast.StmtAssign { ...a, value: ar.expr }];
      return DeferHoist { stmts: one, decls: ar.decls };
    },
    ast.StmtBreak(_) => {},
    ast.StmtContinue(_) => {},
    ast.StmtUnknown(_) => {},
    ast.StmtDefer(_) => {}
  }
  let same: ast.Stmt[] = [st];
  let none: ast.Stmt[] = [];
  return DeferHoist { stmts: same, decls: none };
}

function dl_hoist_match(m: ast.StmtMatch, want: string[]): DeferHoist {
  let sr = dl_hoist_expr(m.scrutinee, want);
  let decls = sr.decls;
  let arms: ast.MatchArm[] = [];
  for a in m.arms {
    let gr = dl_hoist_expr(a.guard, want);
    let ar = dl_hoist_stmts(a.body, want, true);
    arms = arms.append(ast.MatchArm { ...a, guard: gr.expr, body: ar.stmts });
    decls = util.append_all(util.append_all(decls, gr.decls), ar.decls);
  }
  let one: ast.Stmt[] = [parser.s_match(sr.expr, arms)];
  return DeferHoist { stmts: one, decls: decls };
}

function dl_hoist_expr(e: ast.Expr, want: string[]): DeferHoistExpr {
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c)) {
      if let ast.ExprLambda(l) = c.callee {
        let vb = dl_hoist_stmts(l.body, want, true);
        return DeferHoistExpr { expr: parser.dl_vb_rebuild(c, vb.stmts), decls: vb.decls };
      }
    }
  }
  let kids = parser.dl_expr_kids(e);
  let none: ast.Stmt[] = [];
  if (kids.len() == 0) {
    return DeferHoistExpr { expr: e, decls: none };
  }
  let out: ast.Expr[] = [];
  let decls = none;
  for k in kids {
    let r = dl_hoist_expr(k, want);
    out = out.append(r.expr);
    decls = util.append_all(decls, r.decls);
  }
  return DeferHoistExpr { expr: parser.dl_expr_with_kids(e, out), decls: decls };
}

function dl_defret_decl(ret: string, fn_ret: string, fn_param_types: string): ast.Stmt {
  if (!dl_zeroable(ret)) {
    return parser.s_var("__defret", "", parser.e_number("0", "", false));
  }
  return ast.StmtVar { name: "__defret", type_name: ret, init: dl_zero_of(ret), line: 0, col: 0, fn_ret: fn_ret, fn_param_types: fn_param_types, destr: ast.no_destr(), header: false };
}

function dl_hoistable(want: string[], src: ast.Stmt[], params: string[]): string[] {
  let bound: string[] = [];
  for p in params {
    bound = astwalk.append_bound_name(bound, p);
  }
  for st in src {
    bound = astwalk.fold_stmt_nodes(st, bound, astwalk.binders_of, astwalk.keep_names, astwalk.descend_all);
  }
  let out: string[] = [];
  for w in want {
    if (util.count_str(bound, w) < 2) {
      out = out.append(w);
    }
  }
  return out;
}

function dl_hoist_scope(src: ast.Stmt[], params: string[]): ast.Stmt[] {
  let empty: ast.Stmt[] = [];
  let emptyf: i32[] = [];
  let probe = dl_collect_stmts(src, empty, emptyf);
  if (probe.actions.len() == 0) {
    return src;
  }
  let want = dl_hoistable(dl_action_names(probe.actions), src, params);
  if (want.len() == 0) {
    return src;
  }
  let h = dl_hoist_stmts(src, want, false);
  if (h.decls.len() == 0) {
    return src;
  }
  return util.append_all(h.decls, h.stmts);
}

pub function lower_defers_func(fn: parser.FuncDecl): parser.FuncDecl {
  if (!dl_stmts_have_defer_deep(fn.body)) {
    return fn;
  }
  let pnames: string[] = [];
  for p in fn.params {
    pnames = pnames.append(p.name);
  }
  if (fn.receiver_name.len() > 0) {
    pnames = pnames.append(fn.receiver_name);
  }
  return parser.FuncDecl { ...fn, body: lower_defers_body(fn.body, pnames, fn.ret_type, fn.ret_fn_ret, fn.ret_fn_param_types) };
}

function lower_defers_body(body0: ast.Stmt[], params: string[], ret: string, fn_ret: string, fn_param_types: string): ast.Stmt[] {
  let src = dl_lower_lambda_bodies(body0);
  if (!dl_stmts_have_defer(src)) {
    return src;
  }
  src = dl_hoist_scope(src, params);
  let empty: ast.Stmt[] = [];
  let emptyf: i32[] = [];
  let cr = dl_collect_stmts(src, empty, emptyf);
  if (cr.actions.len() == 0) {
    return src;
  }
  let cleanup = dl_cleanup_kind(cr.actions, cr.flags, 0, cr.actions.len());
  let cleanup_err = dl_cleanup_kind(cr.actions, cr.flags, 1, cr.actions.len());
  let expanded = dl_expand_returns(cr.stmts, cr.actions, cr.flags, 0);
  let body: ast.Stmt[] = [];
  if (ret != "void") {
    body = body.append(dl_defret_decl(ret, fn_ret, fn_param_types));
  }
  for i in 0..cr.actions.len() {
    body = body.append(parser.s_var("__dfa" + util.i32_to_string(i), "boolean", parser.e_bool(false)));
  }
  body = body.append(parser.s_var(parser.DFA_TRYALL, "boolean", parser.e_bool(false)));
  body = body.append(parser.s_var(parser.DFA_TRYERR, "boolean", parser.e_bool(false)));
  for k in 0..expanded.len() {
    body = body.append(expanded[k]);
  }
  for c in 0..cleanup.len() {
    body = body.append(cleanup[c]);
  }
  let noelse: ast.Stmt[] = [];
  body = body.append(parser.s_if(parser.e_ident(parser.DFA_TRYALL), cleanup, noelse));
  body = body.append(parser.s_if(parser.e_ident(parser.DFA_TRYERR), cleanup_err, noelse));
  return body;
}

// The statements that lower_defers_body puts after a body for a `?` that
// leaves it: the actions of the deferred statements, each behind its flag.
pub function try_cleanup(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in body {
    if let ast.StmtIf(f) = st {
      if let ast.ExprIdent(id) = f.cond {
        if (id.name == parser.DFA_TRYALL || id.name == parser.DFA_TRYERR) {
          for c in f.then_body {
            out = out.append(c);
          }
        }
      }
    }
  }
  return out;
}

function dl_lower_lambda_bodies(stmts: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for i in 0..stmts.len() {
    out = out.append(dl_ll_stmt(stmts[i]));
  }
  return out;
}

function dl_ll_stmt(st: ast.Stmt): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { ...v, init: dl_ll_expr(v.init) };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: dl_ll_expr(r.value) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: dl_ll_expr(x.value) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: dl_ll_expr(a.value) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: dl_ll_expr(f.cond), then_body: dl_lower_lambda_bodies(f.then_body), else_body: dl_lower_lambda_bodies(f.else_body) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, cond: dl_ll_expr(w.cond), body: dl_lower_lambda_bodies(w.body) };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { ...fo, iter: dl_ll_expr(fo.iter), body: dl_lower_lambda_bodies(fo.body) };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      for i in 0..m.arms.len() {
        let g = m.arms[i].guard;
        if (m.arms[i].has_guard) {
          g = dl_ll_expr(m.arms[i].guard);
        }
        arms = arms.append(ast.MatchArm { ...m.arms[i], body: dl_lower_lambda_bodies(m.arms[i].body), guard: g });
      }
      return ast.StmtMatch { ...m, scrutinee: dl_ll_expr(m.scrutinee), arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: dl_ll_stmt(d.action) };
    },
    _ => {
      return st;
    }
  }
}

function dl_ll_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, body: lower_defers_body(lm.body, parser.param_names(lm.params), lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types) };
    },
    ast.ExprCall(c) => {
      if (parser.is_value_block(c)) {
        return parser.dl_vb_rebuild(c, dl_lower_lambda_bodies(parser.vb_body(c)));
      }
      if (dl_is_source_iife(c)) {
        match (c.callee) {
          ast.ExprLambda(lm) => {
            if (dl_stmts_have_defer(lm.body)) {
              let scoped: ast.Expr = ast.ExprLambda { ...lm, origin: parser.ORIGIN_IIFE_SCOPED, body: lower_defers_body(lm.body, parser.param_names(lm.params), lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types) };
              return ast.ExprCall { ...c, callee: scoped };
            }
          },
          _ => {}
        }
      }
      return dl_ll_expr_kids(e);
    },
    _ => {
      return dl_ll_expr_kids(e);
    }
  }
}

function dl_is_source_iife(c: ast.ExprCall): boolean {
  if (c.args.len() != 0) {
    return false;
  }
  match (c.callee) {
    ast.ExprLambda(lm) => {
      if (lm.params.len() != 0) {
        return false;
      }
      return !parser.is_value_block_origin(lm.origin);
    },
    _ => {
      return false;
    }
  }
}

function dl_ll_expr_kids(e: ast.Expr): ast.Expr {
  return parser.map_expr_kids(e, dl_ll_expr);
}

pub function lower_defers_module(mod: parser.Module): parser.Module {
  let funcs: parser.FuncDecl[] = [];
  for i in 0..mod.funcs.len() {
    funcs = funcs.append(lower_defers_func(mod.funcs[i]));
  }
  return parser.Module { ...mod, funcs: funcs };
}
