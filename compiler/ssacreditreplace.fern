// Independent fresh-parent replacement fragment. No production compile gate.
// The caller establishes consuming Parent/Child ABI modes, a nominal two-word
// Parent containing exactly one flat Child, and no finalizers on either type.
import "./ssa";
import "./ssacredithelper" as helper;
import "./util";

function refused(f: ssa.SFunc, why: string): helper.Proof {
  return helper.Proof { ok: false, function_name: f.name, message: why };
}

// The incoming child's local credit is independent of the old parent's slot
// credit, including when the two refer to the same allocation. This fragment
// never reads that slot or assumes that the old parent is runtime-unique.
pub function check(f: ssa.SFunc, drop: ssa.SFunc, release: ssa.SFunc, shape_name: string): helper.Proof {
  if (shape_name == "" || f.name == "" || util.str_has_prefix(f.name, "__fern_") || f.name == drop.name || f.name == release.name) {
    return refused(f, "invalid replacement identity");
  }
  let summary = helper.release_body(release, drop, helper.FlatChild { offset: 8 });
  if (!summary.ok) {
    return summary;
  }
  if (f.nparams != 2 || f.takes_env || f.blocks.len() != 1) {
    return refused(f, "unsupported replacement boundary");
  }
  let b = f.blocks[0];
  if (b.id < 0 || b.id != f.entry || b.preds.len() != 0 || b.term.kind_tag != 1 || f.nvals < 2 || f.nvals > b.insts.len()) {
    return refused(f, "unsupported replacement graph");
  }
  // Value kinds: undefined=-1, scalar=0, old parent=1, incoming child=2,
  // fresh parent=3, exact shape address=4. A store has no readable result.
  let values: i32[] = [];
  let defined: boolean[] = [];
  let i: i32 = 0;
  while (i < f.nvals) {
    values = values.append(-1);
    defined = defined.append(false);
    i = i + 1;
  }
  let parent_param = false;
  let child_param = false;
  let old_credit: i32 = 1;
  let child_credit: i32 = 1;
  let allocated = false;
  let shape_set = false;
  let child_set = false;
  for op in b.insts {
    if (op.result < 0 || op.result >= f.nvals || defined[op.result]) {
      return refused(f, "invalid replacement value identity");
    }
    defined = defined.with(op.result, true);
    for arg in op.args {
      if (arg < 0 || arg >= values.len() || values[arg] < 0) {
        return refused(f, "undefined replacement operand");
      }
      if (values[arg] == 1 && old_credit == 0) {
        return refused(f, "old parent used after release");
      }
      if (values[arg] == 2 && child_credit == 0 && !child_set) {
        return refused(f, "child used after final credit");
      }
    }
    let kind: i32 = -1;
    if (op.kind_tag == 6 && op.args.len() == 0 && op.str == "") {
      if (op.imm == 0 && !parent_param) {
        parent_param = true;
        kind = 1;
      } else if (op.imm == 1 && !child_param) {
        child_param = true;
        kind = 2;
      } else {
        return refused(f, "invalid replacement parameter");
      }
    } else if (op.kind_tag == 1 && op.args.len() == 0 && op.str == "") {
      kind = 0;
    } else if (op.kind_tag == 7 && op.args.len() == 1 && op.imm == 0 && op.str == "") {
      kind = values[op.args[0]];
    } else if (op.kind_tag == 48 && op.args.len() == 0 && op.imm == 2 && op.str == "") {
      if (allocated) {
        return refused(f, "extra parent allocation");
      }
      allocated = true;
      kind = 3;
    } else if (op.kind_tag == 46 && op.args.len() == 0 && op.imm == 0 && op.str == shape_name) {
      kind = 4;
    } else if (op.kind_tag == 41 && op.args.len() == 2 && op.str == "" && values[op.args[0]] == 3) {
      let source = values[op.args[1]];
      if (op.imm == 0 && source == 4 && !shape_set) {
        shape_set = true;
      } else if (op.imm == 8 && source == 2 && !child_set && child_credit > 0) {
        child_set = true;
        child_credit = child_credit - 1;
      } else {
        return refused(f, "invalid or duplicate parent initialization");
      }
    } else if (op.kind_tag == 11 && op.args.len() == 1) {
      let subject = values[op.args[0]];
      if (op.str == release.name && subject == 1 && op.imm == 0) {
        old_credit = old_credit - 1;
      } else if (op.str == "__fern_rc_inc" && subject == 2 && (op.imm == 0 || op.imm == 4)) {
        child_credit = child_credit + 1;
        kind = 2;
      } else if (op.str == "__fern_rc_dec" && subject == 2 && op.imm == 0 && child_credit > 0) {
        child_credit = child_credit - 1;
        kind = 2;
      } else {
        return refused(f, "unsupported call or child release without local credit");
      }
    } else {
      return refused(f, "unsupported replacement operation");
    }
    values = values.with(op.result, kind);
  }
  if (!parent_param || !child_param || !allocated || !shape_set || !child_set) {
    return refused(f, "incomplete parent construction");
  }
  if (b.term.value < 0 || b.term.value >= values.len() || values[b.term.value] != 3) {
    return refused(f, "owned fresh parent result required");
  }
  if (old_credit != 0 || child_credit != 0) {
    return refused(f, "unconsumed replacement credit");
  }
  return helper.Proof { ok: true, function_name: f.name, message: "proved fresh flat-child replacement" };
}
