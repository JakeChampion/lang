// Scoped caller origin proof. Caller binds Boolean/consume Child/consume Child
// -> Parent and each producer's consume Child/consume Child -> Parent ABI, with
// the same ordered two-flat-reference layout and no finalizers or views.
import "./ssa";
import "./ssacreditorigin" as origin;
import "./ssacredithelper" as helper;
import "./util";
import "./ssacreditflowgraph" as flow_graph;

function refused(f: ssa.SFunc, why: string): origin.Origin {
  return origin.Origin { proof: helper.Proof { ok: false, function_name: f.name, message: why }, words: 0 };
}

// Kind -1 unavailable, 0 exact scalar, 1 reference. Reference identities name
// credit obligations, not unequal runtime pointers. Roots 0/1 are incoming
// independent child credits; each call result has its own fresh storage root.
struct Value { kind: i32, identity: i32, words: i32 }

// Two fixed Boolean ABI cases. Admitted branches must remain exact Booleans;
// no unknown-as-zero, path enumeration, numeric/reference conversion or loops.
pub function caller(f: ssa.SFunc, producers: ssa.SFunc[], shape: string): origin.Origin {
  if (producers.len() == 0) {
    return refused(f, "caller origin producer binding");
  }
  let names: string[] = [];
  for p in producers {
    for name in names {
      if (name == p.name) {
        return refused(f, "caller origin producer binding");
      }
    }
    names = names.append(p.name);
    let checked = origin.producer(p, shape, [true, true]);
    if (!checked.proof.ok || checked.words != 3) {
      return refused(f, "unproved caller allocation producer");
    }
  }
  let checked = flow_graph.check(f, producers, 3);
  if (checked.error != "") {
    return refused(f, checked.error);
  }
  let empty: Value[] = [];
  let credits: i32[] = [1, 1];
  let i: i32 = 0;
  while (i < checked.values.len()) {
    empty = empty.append(Value { kind: -1, identity: 0, words: 0 });
    credits = credits.append(0);
    i = i + 1;
  }
  for input in [0, 1] {
    let rows: Value[][] = [];
    let balances: i32[][] = [];
    let destinations: i32[] = [];
    for b in f.blocks {
      rows = rows.append(empty);
      balances = balances.append(credits);
      destinations = destinations.append(-1);
    }
    let returned = false;
    for index in checked.order {
      let b = f.blocks[index];
      let row = empty;
      let balance = credits;
      let previous: i32 = -1;
      let active = b.id == f.entry;
      for p in b.preds {
        let pi = flow_graph.block_index(f, p);
        if (destinations[pi] == b.id) {
          // With exact deterministic branches each ABI case has one feasible
          // predecessor. Refuse rather than approximate a broader domain.
          if (active) {
            return refused(f, "ambiguous caller origin flow");
          }
          active = true;
          previous = pi;
          row = rows[pi];
          balance = balances[pi];
        }
      }
      if (active) {
        for op in b.insts {
          let value = Value { kind: 0, identity: 0, words: 0 };
          if (op.kind_tag == 8) {
            let pos = util.index_of_i32(b.preds, f.blocks[previous].id);
            // Read the immutable predecessor snapshot, not earlier phi results.
            value = rows[previous][util.index_of_i32(checked.values, op.args[pos])];
          } else if (op.kind_tag == 6) {
            if (op.imm == 0) {
              value = Value { ...value, identity: input };
            } else {
              value = Value { kind: 1, identity: op.imm - 1, words: 0 };
            }
          } else if (op.kind_tag == 1) {
            value = Value { ...value, identity: op.imm };
          } else if (op.kind_tag == 7) {
            value = row[util.index_of_i32(checked.values, op.args[0])];
          } else if (op.kind_tag == 11) {
            for arg in op.args {
              let child = row[util.index_of_i32(checked.values, arg)];
              if (child.kind != 1 || child.identity < 0 || child.identity > 1 || child.words != 0 || balance[child.identity] != 1) {
                return refused(f, "invalid caller origin credit transfer");
              }
              balance = balance.with(child.identity, 0);
            }
            let root = util.index_of_i32(checked.values, op.result) + 2;
            if (balance[root] != 0) {
              return refused(f, "duplicate caller allocation credit");
            }
            balance = balance.with(root, 1);
            value = Value { kind: 1, identity: root, words: 3 };
          }
          row = row.with(util.index_of_i32(checked.values, op.result), value);
        }
        if (b.term.kind_tag == 1) {
          let result = row[util.index_of_i32(checked.values, b.term.value)];
          if (result.kind != 1 || result.identity < 2 || result.words != 3 || balance[result.identity] != 1) {
            return refused(f, "owned caller allocation return required");
          }
          balance = balance.with(result.identity, 0);
          for credit in balance {
            if (credit != 0) {
              return refused(f, "leftover caller origin credits");
            }
          }
          returned = true;
        } else if (b.term.kind_tag == 2) {
          destinations = destinations.with(index, b.term.target);
        } else {
          let condition = row[util.index_of_i32(checked.values, b.term.cond)];
          if (condition.kind != 0 || condition.identity < 0 || condition.identity > 1) {
            return refused(f, "exact caller Boolean required");
          }
          destinations = destinations.with(index, if (condition.identity == 1) { b.term.t } else { b.term.f });
        }
        rows = rows.with(index, row);
        balances = balances.with(index, balance);
      }
    }
    if (!returned) {
      return refused(f, "caller allocation return missing");
    }
  }
  return origin.Origin { proof: helper.Proof { ok: true, function_name: f.name, message: "proved caller allocation origin" }, words: 3 };
}
