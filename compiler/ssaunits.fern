// Abstract counted-unit planning and independent replay before physical RC.
import "./ssa";
import "./ssasem";
import "./ssadeps";
import "./ssalive";
import "./semrecords";
import "./semtypes";
import "./typeinfo";
import "./util";

pub function value_mode(): i32 {
  return ssasem.value_mode();
}

pub function borrow_mode(): i32 {
  return ssasem.borrow_mode();
}

pub function counted_mode(): i32 {
  return ssasem.counted_mode();
}

pub function retain_unit(): i32 {
  return 1;
}

pub function move_unit(): i32 {
  return 2;
}

// A steal takes the unit from the record the value projects: at run time,
// when the record has no other holder, the field is nulled and its unit goes
// to the callee; otherwise the supply retains as any other. Chosen only where
// the record is this frame's own and read no further through that field
// (projection_root), so the null is seen by nothing but the record's own
// release, which skips it.
pub function steal_unit(): i32 {
  return 3;
}

pub function entry_point(): i32 {
  return 0 - 1;
}

pub function return_point(): i32 {
  return 0 - 2;
}

pub function edge_point(): i32 {
  return 0 - 3;
}

pub struct Supply { value: i32, slot: i32, mode: i32 }

// point is an instruction position, or entry/return/edge. target is a block
// id only for edges and -1 otherwise. All acquisitions execute before moves,
// the semantic operation then creates its result, and drops execute last.
//
// `hand_roots` / `hand_fields`, one per operand of a direct call: the record
// whose field the operand projects, or the parameter itself, when this frame
// reads it no further after the call (projection_root) and so hands the
// buffer on without a bracket; -1 otherwise. `hand_fields` is the field's
// index, or -1 for a parameter's own buffer — an array's, or a whole record
// parameter's, whose every field the callee may grow is handed with it.
pub struct Step { block: i32, point: i32, target: i32, supplies: Supply[], drops: i32[], hand_roots: i32[], hand_fields: i32[] }

// `grows` names, at an append's, a with's or a string append's result, the
// record value whose field buffer the operation may grow or write IN PLACE
// (field_grow_root), or -1; `grow_fields` holds that field's index at the same
// position.
// `held` marks an element read that takes a unit of its own at the read
// (held_elements); the physical lowering retains what it read.
// `literal` marks the values that can only hold a string literal (`literals`).
// `defs` is the definitions table (`definitions`) of the function the plan was
// planned from, indexed by value; a verifier checking another function
// derives its own.
// `fresh_seeded` says `unique_receivers` counted a fresh row's result
// (`with_fresh`), so a plan reused under another module's rows is proved again.
pub struct Plan { ok: boolean, why: string, steps: Step[], owned: boolean[], literal: boolean[], grows: i32[], grow_fields: i32[], takes: i32[], held: boolean[], payloads: boolean[], kept: boolean[], entry_kept: boolean[], frame_views: boolean[], constants: string[], text_lens: i32[], analysis: ssasem.Analysis, defs: ssa.SInst[], modes: i32[], unit_analysis: ssasem.Analysis, unique_receivers: boolean[], fresh_seeded: boolean, checked_writes: boolean[] }

struct Ledger { ok: boolean, why: string, bits: boolean[] }

// A callee parameter whose buffer the callee may grow in place: `field` is the
// index of a record parameter's array field, or -1 for an array parameter's
// own buffer. A caller still reading such an argument after the call holds a
// second count on the buffer across it, so the callee's push takes the copy
// (#4873, #8785).
pub struct GrowRow { callee: string, param: i32, field: i32 }

// GrowTable is the module's rows with a name index over their callees kept
// beside them, one entry per row in order, so a body's bracket asks about a
// callee along its chain rather than across the table.
pub struct GrowTable { rows: GrowRow[], by_callee: util.NameIndex }

pub function no_grows(): GrowTable {
  let no_names: string[] = [];
  return GrowTable { rows: [], by_callee: util.name_index(no_names) };
}

pub function grow_fields_of(t: GrowTable, callee: string, param: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = t.by_callee.chain(callee);
  while (i >= 0) {
    let row: GrowRow = t.rows[i];
    if (row.callee == callee && row.param == param && row.field >= 0) {
      out = out.append(row.field);
    }
    i = t.by_callee.next[i];
  }
  return out;
}

// Whether the callee may grow the array at `param` in place.
pub function grows_buffer(t: GrowTable, callee: string, param: i32): boolean {
  return has_row_at(t.rows, t.by_callee, callee, param, 0 - 1);
}

function has_row(rows: GrowRow[], callee: string, param: i32, field: i32): boolean {
  for row in rows {
    if (row.callee == callee && row.param == param && row.field == field) {
      return true;
    }
  }
  return false;
}

// Whether two grow tables say the same thing about `callees`.
//
// A body reads this table only through `grow_fields_of` and `grows_buffer` in
// `ssarc.bracketed`, keyed by the name each call instruction names — so two
// tables that agree on the callees one body names produce that body
// identically, however much they differ elsewhere. That is what lets a second
// lowering keep a body the inference did not move.
pub function grow_rows_agree(a: GrowTable, b: GrowTable, callees: string[]): boolean {
  for callee in callees {
    if (!rows_within(a, b, callee) || !rows_within(b, a, callee)) {
      return false;
    }
  }
  return true;
}

// rows_within reports whether every row of `a` for `callee` is in `b`.
function rows_within(a: GrowTable, b: GrowTable, callee: string): boolean {
  let i: i32 = a.by_callee.chain(callee);
  while (i >= 0) {
    let row: GrowRow = a.rows[i];
    if (row.callee == callee && !has_row_at(b.rows, b.by_callee, callee, row.param, row.field)) {
      return false;
    }
    i = a.by_callee.next[i];
  }
  return true;
}

function with_row(rows: GrowRow[], callee: string, param: i32, field: i32): GrowRow[] {
  if (has_row(rows, callee, param, field)) {
    return rows;
  }
  return rows.append(GrowRow { callee: callee, param: param, field: field });
}

// has_row_at is has_row over a table with a name index kept beside it, one
// entry per row in order: the callee's chain, ascending.
function has_row_at(rows: GrowRow[], ix: util.NameIndex, callee: string, param: i32, field: i32): boolean {
  let i: i32 = ix.chain(callee);
  while (i >= 0) {
    if (rows[i].callee == callee && rows[i].param == param && rows[i].field == field) {
      return true;
    }
    i = ix.next[i];
  }
  return false;
}

// The rows this function's plan contributes, given the rows `table` already
// holds for its callees: one per borrowed parameter position an admitted
// in-place grow or write reaches, directly through an append or a with of its
// own, through an append whose receiver a phi, an earlier append or a call
// carries from the parameter (ssarc's links grow those in place), or through a
// buffer it hands on unbracketed to a callee whose row says that position may
// grow — the parameter itself, or a value dying at the call that the same
// carriers lead back to it. A with on a buffer the plan did not admit copies,
// so it contributes no row. An owned parameter needs no caller bracket — its caller moved the
// unit in, or retained and so made the record's own count answer "shared".
pub function grow_rows(callee: string, f: ssasem.Func, p: Plan, table: GrowRow[], tix: util.NameIndex): GrowRow[] {
  let out: GrowRow[] = [];
  let defs: ssa.SInst[] = p.defs;
  let at: i32[] = ssa.block_positions(f.graph);
  let seen: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) {
        continue;
      }
      let root: i32 = ins.args[0];
      let field: i32 = 0 - 1;
      if (p.grows[ins.result] >= 0) {
        root = p.grows[ins.result];
        field = p.grow_fields[ins.result];
      } else if (ins.kind_tag == ssasem.with()) {
        continue;
      }
      if (field < 0) {
        let carried: Carried = carried_params(f, defs, root, seen);
        seen = carried.seen;
        for param in carried.params {
          if (!p.owned[param]) {
            out = with_row(out, callee, defs[param].imm, 0 - 1);
          }
        }
        continue;
      }
      if (defs[root].kind_tag != 6 || p.owned[root]) {
        continue;
      }
      out = with_row(out, callee, defs[root].imm, field);
    }
  }
  let partial: GrowTable = GrowTable { rows: table, by_callee: tix };
  for s in p.steps {
    if (s.point < 0) {
      continue;
    }
    let ins: ssa.SInst = f.graph.blocks[at[s.block]].insts[s.point];
    out = dying_lent_rows(callee, f, p, defs, s, ins, table, tix, out);
    let i: i32 = 0;
    while (i < s.hand_roots.len()) {
      let root: i32 = s.hand_roots[i];
      if (root >= 0 && defs[root].kind_tag == 6 && !p.owned[root]) {
        if (is_record(f.values[root]) && s.hand_fields[i] < 0) {
          // A whole record handed on: every field the callee may
          // grow, this parameter may grow.
          for field in grow_fields_of(partial, ins.str, i) {
            out = with_row(out, callee, defs[root].imm, field);
          }
        } else if (has_row_at(table, tix, ins.str, i, 0 - 1)) {
          out = with_row(out, callee, defs[root].imm, s.hand_fields[i]);
        }
      }
      i = i + 1;
    }
  }
  return out;
}

// The rows of a direct call's array operands that die at it, at the positions
// the callee may grow: the box they carry from a parameter is lent on with
// nothing in this frame reading it again.
function dying_lent_rows(callee: string, f: ssasem.Func, p: Plan, defs: ssa.SInst[], s: Step, ins: ssa.SInst, table: GrowRow[], tix: util.NameIndex, own out: GrowRow[]): GrowRow[] {
  if (ins.kind_tag != ssasem.call()) {
    return out;
  }
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let v: i32 = ins.args[i];
    if (v >= f.graph.nparams && is_array(f.values[v]) && occurrences(s.drops, v) > 0 && has_row_at(table, tix, ins.str, i, 0 - 1)) {
      let carried: Carried = carried_params(f, defs, v, __alloc_bool(f.graph.nvals));
      for param in carried.params {
        if (!p.owned[param]) {
          out = with_row(out, callee, defs[param].imm, 0 - 1);
        }
      }
    }
    i = i + 1;
  }
  return out;
}

struct Carried { params: i32[], seen: boolean[] }

// The parameters whose box `v` may be, through phis, the receivers of
// appends and the array operands of calls. `seen` is a clear nvals-long
// scratch set, handed back clear.
function carried_params(f: ssasem.Func, defs: ssa.SInst[], v: i32, own seen: boolean[]): Carried {
  let out: i32[] = [];
  let work: i32[] = [v];
  let k: i32 = 0;
  while (k < work.len()) {
    let w: i32 = work[k];
    k = k + 1;
    if (w < 0 || seen[w]) {
      continue;
    }
    seen = seen.with(w, true);
    let d: ssa.SInst = defs[w];
    if (d.kind_tag == 6) {
      out = out.append(w);
    } else if (d.kind_tag == ssasem.append()) {
      work = work.append(d.args[0]);
    } else if (d.kind_tag == 8) {
      for a in d.args {
        work = work.append(a);
      }
    } else if (d.kind_tag == ssasem.call()) {
      for a in d.args {
        if (is_array(f.values[a])) {
          work = work.append(a);
        }
      }
    }
  }
  let c: i32 = 0;
  while (c < work.len()) {
    if (work[c] >= 0) {
      seen = seen.with(work[c], false);
    }
    c = c + 1;
  }
  return Carried { params: out, seen: seen };
}

// Every produced body's rows, closed over the buffers handed on: a row only
// ever gains, so the rounds converge. A plan reads the table only through the
// rows filed under the callees its steps name, and each row is filed under the
// key of the plan that produced it, so a plan is evaluated again only once a
// callee of its has gained a row; until then it would hand back rows the
// table already holds.
pub function grow_table(keys: string[], funcs: ssasem.Func[], plans: Plan[]): GrowTable {
  let table: GrowRow[] = [];
  let no_names: string[] = [];
  // tix indexes `table` by callee, one entry per row in order.
  let tix: util.NameIndex = util.name_index(no_names);
  let kix: util.NameIndex = util.name_index(keys);
  let callers: i32[][] = plan_callers(kix, funcs, plans);
  let dirty: boolean[] = [];
  while (dirty.len() < plans.len()) {
    dirty = dirty.append(true);
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < plans.len()) {
      if (plans[i].ok && dirty[i]) {
        dirty = dirty.with(i, false);
        for row in grow_rows(keys[i], funcs[i], plans[i], table, tix) {
          if (!has_row_at(table, tix, row.callee, row.param, row.field)) {
            table = table.append(row);
            tix = tix.added(row.callee);
            changed = true;
            let at: i32 = kix.find(row.callee);
            if (at >= 0) {
              for c in callers[at] {
                dirty = dirty.with(c, true);
              }
            }
          }
        }
      }
      i = i + 1;
    }
  }
  return GrowTable { rows: table, by_callee: tix };
}

// plan_callers[j] lists the plans whose steps name the plan first keyed
// keys[j] (kix), each once.
function plan_callers(kix: util.NameIndex, funcs: ssasem.Func[], plans: Plan[]): i32[][] {
  let out: i32[][] = [];
  while (out.len() < plans.len()) {
    out = out.append([]);
  }
  let i: i32 = 0;
  while (i < plans.len()) {
    if (plans[i].ok) {
      let at: i32[] = ssa.block_positions(funcs[i].graph);
      for s in plans[i].steps {
        if (s.point >= 0) {
          let j: i32 = kix.find(funcs[i].graph.blocks[at[s.block]].insts[s.point].str);
          if (j >= 0 && (out[j].len() == 0 || out[j][out[j].len() - 1] != i)) {
            out = out.with(j, out[j].append(i));
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function bad(why: string): Plan {
  return Plan { ok: false, why: why, steps: [], owned: [], literal: [], grows: [], grow_fields: [], takes: [], held: [], payloads: [], kept: [], entry_kept: [], frame_views: [], constants: [], text_lens: [], analysis: ssasem.refused_analysis(why), defs: [], modes: [], unit_analysis: ssasem.refused_analysis(why), unique_receivers: [], fresh_seeded: false, checked_writes: [] };
}

pub function refused(why: string): Plan {
  return bad(why);
}

function rejected(why: string): Ledger {
  return Ledger { ok: false, why: why, bits: [] };
}

function step(block: i32, point: i32, target: i32): Step {
  return Step { block: block, point: point, target: target, supplies: [], drops: [], hand_roots: [], hand_fields: [] };
}

function successors(b: ssa.SBlock): i32[] {
  if (b.term.kind_tag == 2) {
    return [b.term.target];
  }
  if (b.term.kind_tag == 3) {
    if (b.term.t == b.term.f) {
      return [b.term.t];
    }
    return [b.term.t, b.term.f];
  }
  return [];
}

// The types that carry no unit at all: the scalars, and a handle, which is
// its descriptor.
function unit_free(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  if let typeinfo.TypeFloat(_) = t {
    return true;
  }
  if let typeinfo.TypeVoid(_) = t {
    return true;
  }
  return semtypes.is_handle(t);
}

function supported(t: typeinfo.Type, f: ssasem.Func): boolean {
  return unit_shape(t, f, true);
}

pub function has_nominal(t: typeinfo.Type, f: ssasem.Func): boolean {
  if let typeinfo.TypeStruct(_) = t {
    return semrecords.find(f.records, t) >= 0;
  }
  return semrecords.find_enum(f.enums, t) >= 0;
}

// nominal admits a struct or union type: with `lookup`, when f's table holds
// it. A schema entry's field is admitted without: the analysis a plan is
// formed from refuses a table whose fields name a type it lacks
// (semrecords.verify).
pub function nominal(t: typeinfo.Type, f: ssasem.Func, lookup: boolean): boolean {
  return !lookup || has_nominal(t, f);
}

// unit_shape: whether `t` is a value this pass plans.
function unit_shape(t: typeinfo.Type, f: ssasem.Func, lookup: boolean): boolean {
  if (unit_free(t)) {
    return true;
  }
  if let typeinfo.TypeString(_) = t {
    return true;
  }
  if let typeinfo.TypeFunc(_) = t {
    return true;
  }
  if let typeinfo.TypeDyn(_) = t {
    return true;
  }
  // A map cursor holds a unit of its map.
  if (semtypes.is_map_iter(t)) {
    return unit_shape(semtypes.map_iter_map(t), f, lookup);
  }
  if let typeinfo.TypeArray(a) = t {
    return unit_shape(a.elem, f, lookup);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (!unit_shape(e, f, lookup)) {
        return false;
      }
    }
    return true;
  }
  // A cell holds one unit of its own and one slot; no declaration names it.
  if (semtypes.is_cell(t)) {
    return unit_shape(semtypes.cell_elem(t), f, lookup);
  }
  // A map holds one unit of its own and one of every key in its column, and
  // one of every value when that column is counted; only the shapes whose
  // release does that are admitted, and a column of boxes only when the box
  // itself is a value this pass plans.
  if (ssasem.is_map(t)) {
    if (!ssasem.is_supported_map(t)) {
      return false;
    }
    if (ssasem.keyed_map_key(ssasem.map_key(t)) && !unit_shape(ssasem.map_key(t), f, lookup)) {
      return false;
    }
    return !ssasem.boxed_map_value(ssasem.map_value(t)) || unit_shape(ssasem.map_value(t), f, lookup);
  }
  if let typeinfo.TypeStruct(_) = t {
    return nominal(t, f, lookup);
  }
  if let typeinfo.TypeUnion(_) = t {
    return nominal(t, f, lookup);
  }
  return false;
}

function mode_error(params: typeinfo.Type[], modes: i32[]): string {
  let i: i32 = 0;
  while (i < modes.len()) {
    if (ssasem.reference(params[i])) {
      if (modes[i] != borrow_mode() && modes[i] != counted_mode()) {
        return "reference parameter mode";
      }
    } else if (modes[i] != value_mode()) {
      return "scalar parameter mode";
    }
    i = i + 1;
  }
  return "";
}

// A callee's contract is held to the same representation and mode rules as
// this function's own parameters: its counted result is a fresh unit here.
function call_contract_error(c: ssasem.Contract, f: ssasem.Func): string {
  for t in c.params {
    if (!supported(t, f)) {
      return "unsupported counted-unit call parameter";
    }
  }
  if (!supported(c.result, f)) {
    return "unsupported counted-unit call result";
  }
  return mode_error(c.params, c.modes);
}

// A SchemaView is a function's schema tables already checked: per record,
// then per enum, in table order, whether all its fields are admitted as a unit
// (`*_unit`) and as a physical walk (`*_walk`).
// ssarc.schema_views forms each distinct entry's once per module. An empty
// view, which no_view is, leaves every entry to be checked here.
pub struct SchemaView { rec_unit: boolean[], rec_walk: boolean[], enum_unit: boolean[], enum_walk: boolean[] }

pub function no_view(): SchemaView {
  let none: boolean[] = [];
  return SchemaView { rec_unit: none, rec_walk: none, enum_unit: none, enum_walk: none };
}

// view_fits: `v` was formed for this very table.
pub function view_fits(v: SchemaView, f: ssasem.Func): boolean {
  return v.rec_unit.len() == f.records.list.len() && v.enum_unit.len() == f.enums.len();
}

pub function record_unit(r: semrecords.Record, f: ssasem.Func): boolean {
  for field in r.fields {
    if (!unit_shape(field.ty, f, false)) {
      return false;
    }
  }
  return true;
}

pub function enum_unit(e: semrecords.Enum, f: ssasem.Func): boolean {
  for vr in e.variants {
    // An impossible variant carries no runtime units. Keep its schema and
    // ordinal, but never admit its absent payload as an ordinary value.
    if (!semrecords.inhabited(vr)) {
      continue;
    }
    for field in vr.fields {
      if (!unit_shape(field.ty, f, false)) {
        return false;
      }
    }
  }
  return true;
}

// Check the finite schema tables, not recursive nominal field expansion.
function schema_fields_error(f: ssasem.Func, view: SchemaView): string {
  let fits: boolean = view_fits(view, f);
  let i: i32 = 0;
  while (i < f.records.list.len()) {
    let ok: boolean = false;
    if (fits) {
      ok = view.rec_unit[i];
    } else {
      ok = record_unit(f.records.list[i], f);
    }
    if (!ok) {
      return "unsupported counted record field";
    }
    i = i + 1;
  }
  i = 0;
  while (i < f.enums.len()) {
    let ok: boolean = false;
    if (fits) {
      ok = view.enum_unit[i];
    } else {
      ok = enum_unit(f.enums[i], f);
    }
    if (!ok) {
      return "unsupported counted variant field";
    }
    i = i + 1;
  }
  return "";
}

// A closure is dispatched through with no declaration in hand, so the units its
// arguments carry are read off the function TYPE the box hands out. A counted
// parameter is a CONSUMING slot and the type spells one with `own`: what
// ssasem.closure_type builds from these same modes is what every call through
// the box is checked against, so the two sides cannot disagree.
//
// The environment parameter is the box, which is lent like any other receiver
// and never appears in the type the box hands out, so a counted one there would
// be a promise nothing can state.
function closure_body_error(f: ssasem.Func, ins: ssa.SInst): string {
  let c: ssasem.Contract = f.calls[ssasem.find_contract_in(f.calls, ins.str)];
  if (c.modes.len() > 0 && c.modes[0] == counted_mode()) {
    return "function value consumes its environment";
  }
  return "";
}

function function_ops_error(f: ssasem.Func): string {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.closure_new()) {
        let why: string = closure_body_error(f, ins);
        if (why != "") {
          return why;
        }
      }
    }
  }
  return "";
}

function contract_error(f: ssasem.Func, modes: i32[], view: SchemaView): string {
  if (modes.len() != f.params.len()) {
    return "parameter mode dimensions";
  }
  for t in f.values {
    if (!supported(t, f)) {
      return "unsupported counted-unit type";
    }
  }
  if (!supported(f.result, f)) {
    return "unsupported counted-unit result";
  }
  let why: string = schema_fields_error(f, view);
  if (why != "") {
    return why;
  }
  for c in f.calls {
    why = call_contract_error(c, f);
    if (why != "") {
      return why;
    }
  }
  why = function_ops_error(f);
  if (why != "") {
    return why;
  }
  return mode_error(f.params, modes);
}

// A construction, a closure box, a call result, a phi, a string constant and a
// binary operator's result are fresh; only a reference-typed one is a unit of
// this function's own (a string concatenation), so a scalar operator's result
// is never owned. A projection or a copy borrows its source.
// A closure box is a construction too: it owns one unit per reference capture,
// released when the box is. So is a cell, over its one element; a read of a
// cell hands out a unit of the element rather than borrowing the slot.
function construction(kind: i32): boolean {
  return kind == ssasem.array_new() || kind == ssasem.array_reserve() || kind == ssasem.tuple_new() || kind == ssasem.record_new() || kind == ssasem.variant_new() || kind == ssasem.dyn_box()
    || kind == ssasem.closure_new() || kind == ssasem.cell_new() || kind == ssasem.map_new()
    || kind == ssasem.map_cleared();
}

// The operand types a construction takes a unit of: every reference, without
// exception. A closure box used to BORROW a captured function value, secured
// by requiring the capture to be a borrowed parameter so its owner outlived
// the box. That rule could not describe a box that escapes: a local function
// value captured into a returned box is owned by a frame that is going away,
// and the box never took it, so nobody freed it (#9637). The box owns it now,
// and its release walks the field (ssarc.walked) — which a frame that never
// built the box can do, because `semsource.env_rows` pairs every environment
// a value of that type could carry with the type itself, and the whole module
// contract table is what it reads.
//
// No `kind`: there is no construction with an exception any more.
function taken(t: typeinfo.Type): boolean {
  return ssasem.reference(t);
}

// A zero is a unit this frame holds, not one it allocated: at a reference type
// it is the null word, so the release it owes is the null guard every drop
// helper carries, and the replacement the declaration site assigns drops
// exactly that nothing. It is deliberately NOT a `construction` — no box was
// made, so nothing may take a field out of one.
//
// A string literal (kind 5) is not a unit either: its static box carries the
// immortal count on every backend, so it is never released, and a consumer
// that takes one is handed it with no retain (`literal`).
function fresh_unit(kind: i32): boolean {
  return kind == 8 || kind == 9 || kind == ssasem.append_range() || kind == ssasem.zero() || construction(kind) || hands_out(kind);
}

// The operations whose result is a unit handed to this function: a call's
// result, a rebuilt container, a view's box, a cell's element, a map read,
// which retains what it answers because the value may come from the column or
// from the caller's default, a column snapshot, which semsource admits only
// where the runtime hands back a copy the frame owns whole, a delete,
// whose tuple is fresh and holds the map the receiver handed over, and a hole
// fill, which hands back the chain it was given or the value it stored.
function hands_out(kind: i32): boolean {
  return kind == ssasem.call() || kind == ssasem.call_value() || kind == ssasem.closure_new()
    || kind == ssasem.append() || kind == ssasem.with() || kind == ssasem.slice() || kind == ssasem.cell_get()
    || kind == ssasem.map_insert() || kind == ssasem.map_get_or() || kind == ssasem.map_get()
    || kind == ssasem.map_keys() || kind == ssasem.map_values() || kind == ssasem.map_delete()
    || kind == ssasem.str_bytes() || kind == ssasem.str_byte_view() || kind == ssasem.arr_join() || kind == ssasem.arr_slice()
    || kind == ssasem.map_iter() || kind == ssasem.hole_fill();
}

// A phi is a literal too when every operand is: assumed of every phi, then
// withdrawn from each one with another operand, to a fixpoint, so a loop
// phi that only ever carries literals keeps the mark.
function literals(f: ssasem.Func): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 5 || ins.kind_tag == 8) {
        out = out.with(ins.result, true);
      }
    }
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag != 8 || !out[ins.result]) {
          continue;
        }
        let lit: boolean = true;
        for a in ins.args {
          if (a < 0 || !out[a]) {
            lit = false;
          }
        }
        if (!lit) {
          out = out.with(ins.result, false);
          changed = true;
        }
      }
    }
  }
  return out;
}

function owned_values(f: ssasem.Func, modes: i32[], defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      let owns: boolean = false;
      if (ins.kind_tag == 6) {
        owns = modes[ins.imm] == counted_mode();
      }
      if (ins.kind_tag != 8 && fresh_unit(ins.kind_tag)) {
        owns = ssasem.reference(f.values[ins.result]);
      }
      out = out.with(ins.result, owns);
    }
  }
  return phi_ownership(f, out, defs);
}

// A phi owns a unit unless every operand is lent whole: a borrowed parameter,
// a string literal, another phi that is, or a projection of one of those. Such
// a phi holds nothing its edges could supply -- asking them retains a view
// with a no-op and releases it with a free (#9802), and retains a counted box
// for nothing. A projection of a lent value is a part of a box its holder
// keeps alive for the whole call, so it lends on the same terms; the loop a
// self tail call becomes (`ssasem.tail_recursion`) rebinds every parameter to
// such a projection. Any other operand makes the phi owned: a projection of
// an owned record is anchored to its root, and the retain the edge supplies
// is what keeps the child alive past the root's release. To a fixpoint, since
// ownership reaches a phi through a phi, and through a projection of one.
function phi_ownership(f: ssasem.Func, owned: boolean[], defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = owned;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag != 8 || !ssasem.reference(f.values[ins.result])) {
        continue;
      }
      let lent: boolean = true;
      for a in ins.args {
        if (a < 0) {
          continue;
        }
        let r: i32 = lent_root(f, defs, a);
        if (defs[r].kind_tag == 8 || defs[r].kind_tag == 5) {
          continue;
        }
        if (defs[r].kind_tag == 6 && !out[r]) {
          continue;
        }
        lent = false;
      }
      if (!lent) {
        out = out.with(ins.result, true);
      }
    }
  }
  let grown: boolean = true;
  while (grown) {
    grown = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag != 8 || out[ins.result] || !ssasem.reference(f.values[ins.result])) {
          continue;
        }
        for a in ins.args {
          if (a >= 0 && out[lent_root(f, defs, a)]) {
            out = out.with(ins.result, true);
            grown = true;
          }
        }
      }
    }
  }
  return out;
}

// The value `v` is a part of, through every projection of a plain reference
// it was read by: a record field, a variant payload or member, a tuple
// element or an array element. A view holder and a map stop the walk, as
// they stop the tail-call rewrite (`ssasem.crosses_jump`): a view's box has
// no count to lend, and a map read answers a unit of its own.
function lent_root(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  let at: i32 = v;
  while (part_read(defs[at].kind_tag) && defs[at].args.len() > 0) {
    let t: typeinfo.Type = f.values[at];
    if (!ssasem.reference(t) || ssasem.holds_view(f, t) || ssasem.is_map(t)) {
      return at;
    }
    at = defs[at].args[0];
  }
  return at;
}

function part_read(kind: i32): boolean {
  return kind == ssasem.variant_get() || kind == ssasem.variant_as() || kind == ssasem.record_get()
    || kind == ssasem.tuple_get() || kind == ssasem.array_get();
}

// A view is lent, never retained: its box carries the immortal sentinel
// rather than a count, so the retain the runtime would emit is a no-op while
// the release that balances it frees the box (#9802). A supply that MOVES a
// view is fine, the one unit changes hands; one that retains it, because the
// value stays live past the step, would give back a unit nothing took: a
// phi merging a live view with a fresh one released the live one from
// under its holder. `ssarc`'s #9328 note is the same asymmetry at the call
// bracket, which it restricts to arrays.
//
// A string retagged as a view is the string's own counted box, so retaining
// it retains the string, which `__fern_str_view_free` then releases as one.
// A literal's retain is never emitted (ssarc.supplies), so it lends nothing.
function view_retain_error(f: ssasem.Func, steps: Step[], literal: boolean[], defs: ssa.SInst[]): string {
  for s in steps {
    for item in s.supplies {
      if (item.mode == retain_unit() && ssasem.is_view(f.values[item.value]) && !retagged_string(f, defs, item.value) && !literal[item.value]) {
        return "a view is lent, never retained";
      }
    }
  }
  return "";
}

function retagged_string(f: ssasem.Func, defs: ssa.SInst[], v: i32): boolean {
  let d: ssa.SInst = defs[v];
  return d.kind_tag == ssasem.str_as() && d.args.len() == 1 && !ssasem.is_view(f.values[d.args[0]]);
}

// use_ids lists `value` and the values it depends on, each once; none for
// no value.
function use_ids(value: i32, deps: i32[][]): i32[] {
  if (value < 0) {
    return [];
  }
  let ids: i32[] = [value];
  for dep in deps[value] {
    if (!has_id(ids, dep)) {
      ids = ids.append(dep);
    }
  }
  return ids;
}

// A construction takes one unit per reference operand, function values
// included: the closure box that used to borrow its captures of that type now
// owns them (#9637). A call takes one per counted parameter; a borrowed parameter
// only reads the caller's unit. An append or a with takes one for its
// receiver, which a receiver this function does not own reaches by retaining;
// a cell write takes one for the element it stores and reads the cell. A map
// insert takes one for the receiver it hands back and one for the key its
// column holds until the map is released, and one for the value when that
// column is counted too. A delete takes one for the receiver it hands back
// inside its tuple and only COMPARES the key, whose unit stays with the
// caller. A hole fill takes the chain's and the stored value's, and reads the
// hole's address. A string append takes one for its left operand, whose
// buffer it may grow in place (`string_append`).
function operation_supplies(f: ssasem.Func, ins: ssa.SInst): Supply[] {
  let out: Supply[] = [];
  let counted: boolean[] = [];
  if (ins.kind_tag == ssasem.call()) {
    counted = call_supplied(f, ins);
  } else if (ins.kind_tag == ssasem.call_value()) {
    counted = call_value_supplied(f, ins);
  } else if (ins.kind_tag == ssasem.cell_set()) {
    counted = [false, ssasem.reference(f.values[ins.args[1]])];
  } else if (ins.kind_tag == ssasem.map_insert()) {
    counted = [true, ssasem.reference(f.values[ins.args[1]]), ssasem.reference(f.values[ins.args[2]])];
  } else if (ins.kind_tag == ssasem.map_delete()) {
    counted = [true, false];
  } else if (ins.kind_tag == ssasem.append()) {
    counted = [true, ssasem.reference(f.values[ins.args[1]])];
  } else if (ins.kind_tag == ssasem.with()) {
    counted = [true, false, ssasem.reference(f.values[ins.args[2]])];
  } else if (ins.kind_tag == ssasem.hole_fill()) {
    counted = [true, false, true];
  } else if (ins.kind_tag == ssasem.map_iter()) {
    counted = [true];
  } else if (string_append(f, ins)) {
    counted = [true, false];
  } else if (construction(ins.kind_tag)) {
    for arg in ins.args {
      counted = counted.append(taken(f.values[arg]));
    }
  }
  let i: i32 = 0;
  while (i < counted.len()) {
    if (counted[i]) {
      out = out.append(Supply { value: ins.args[i], slot: i, mode: 0 });
    }
    i = i + 1;
  }
  return out;
}

// A `+` on a counted string: the runtime appends onto the left operand's
// buffer when the frame hands it the only unit and its block has room, so the
// operand is taken rather than lent. A view has no unit to hand over, and a
// range append's left operand is always counted (ssasem.append_range).
pub function string_append(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag == ssasem.append_range()) {
    return true;
  }
  return ins.kind_tag == 9 && ins.str == "+" && ssasem.is_string(f.values[ins.args[0]]);
}

// The operands a call lends rather than counts. The callee reads them for the
// whole call, and it may release a unit it is handed before it does.
function lent_operands(f: ssasem.Func, ins: ssa.SInst): i32[] {
  let out: i32[] = [];
  if (ins.kind_tag != ssasem.call() && ins.kind_tag != ssasem.call_value()) {
    return out;
  }
  let counted: Supply[] = operation_supplies(f, ins);
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let slot_counted: boolean = false;
    for got in counted {
      if (got.slot == i) {
        slot_counted = true;
      }
    }
    if (!slot_counted && ins.args[i] >= 0) {
      out = out.append(ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

// What a call's lent operands borrow from: none of it may move into the call
// (#10832).
function lent_owners(f: ssasem.Func, ins: ssa.SInst, deps: i32[][]): i32[] {
  let out: i32[] = [];
  for v in lent_operands(f, ins) {
    for dep in deps[v] {
      if (dep != v && !has_id(out, dep)) {
        out = out.append(dep);
      }
    }
  }
  return out;
}

// An indirect call LENDS every reference it is handed except at a slot the
// function type spells CONSUMING, `own T`. The callee box itself (operand 0)
// is lent like any other.
function call_value_supplied(f: ssasem.Func, ins: ssa.SInst): boolean[] {
  let out: boolean[] = [false];
  let callee: typeinfo.Type = f.values[ins.args[0]];
  let params: typeinfo.Type[] = ssasem.func_params(callee);
  let i: i32 = 0;
  while (i < params.len()) {
    out = out.append(ssasem.func_param_own(callee, i) && ssasem.reference(f.values[ins.args[i + 1]]));
    i = i + 1;
  }
  return out;
}

function call_supplied(f: ssasem.Func, ins: ssa.SInst): boolean[] {
  let c: ssasem.Contract = f.calls[ssasem.find_contract_in(f.calls, ins.str)];
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < ins.args.len()) {
    out = out.append(c.modes[i] == counted_mode() && ssasem.reference(f.values[ins.args[i]]));
    i = i + 1;
  }
  return out;
}

// The callee's declared mode at each operand of a direct call, for a caller
// deciding which arguments its bracket covers. `call_supplied` reads the same
// contract for the ledger; this is the whole row rather than the counted half.
pub function callee_modes(f: ssasem.Func, ins: ssa.SInst): i32[] {
  let at: i32 = ssasem.find_contract_in(f.calls, ins.str);
  if (at < 0) {
    return [];
  }
  return f.calls[at].modes;
}

// An unreachable end (kind 4) supplies nothing and, like a return, releases
// every unit the frame still holds at its step.
function return_supplies(f: ssasem.Func, b: ssa.SBlock): Supply[] {
  if (b.term.kind_tag == 1 && b.term.value >= 0 && ssasem.reference(f.values[b.term.value])) {
    return [Supply { value: b.term.value, slot: 0, mode: 0 }];
  }
  return [];
}

// The edge from b into the block at position si.
function edge_supplies(f: ssasem.Func, b: ssa.SBlock, si: i32, owned: boolean[]): Supply[] {
  let succ: ssa.SBlock = f.graph.blocks[si];
  let pi: i32 = 0;
  while (succ.preds[pi] != b.id) {
    pi = pi + 1;
  }
  let out: Supply[] = [];
  let i: i32 = 0;
  for ins in succ.insts {
    if (ins.kind_tag == 8 && owned[ins.result]) {
      out = out.append(Supply { value: ins.args[pi], slot: i, mode: 0 });
    }
    i = i + 1;
  }
  return out;
}

function definitions(f: ssasem.Func): ssa.SInst[] {
  let none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let out: ssa.SInst[] = [];
  let i: i32 = 0;
  while (i < f.graph.nvals) {
    out = out.append(none);
    i = i + 1;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.result < out.len()) {
        out = out.with(ins.result, ins);
      }
    }
  }
  return out;
}

// Per slice result: whether its view box may live in the frame that made it.
// Every use has to read the bytes and be done with the box within the one
// instruction — a comparison or concatenation, a length, a byte, a further
// window, or a borrowed argument to a callee that does not keep it. A callee
// whose result borrows the argument also keeps its descriptor, as recorded by
// the typed result anchors. A phi, a store, a return or anything else keeps
// the box past the instruction, and a phi is also the only way an earlier
// iteration's box could still be read when the site runs again.
function frame_views(f: ssasem.Func, defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.slice()) {
        out = out.with(ins.result, true);
      }
    }
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      let i: i32 = 0;
      while (i < ins.args.len()) {
        let view: i32 = lent_view(defs, ins.args[i]);
        if (view >= 0) {
          let handed: boolean = ins.kind_tag == ssasem.call() && util.index_of_i32(ssasem.anchor_params(f.anchors, ins.str), i) >= 0;
          if (handed || !reads_view(ins, i, view != ins.args[i])) {
            out = out.with(view, false);
          }
        }
        i = i + 1;
      }
    }
    if (b.term.kind_tag == 1) {
      let ret: i32 = lent_view(defs, b.term.value);
      if (ret >= 0) {
        out = out.with(ret, false);
      }
    }
  }
  return out;
}

// Per value, the byte length of the string literal it is, or -1.
function text_lens(f: ssasem.Func): i32[] {
  let out: i32[] = [];
  while (out.len() < f.graph.nvals) {
    out = out.append(0 - 1);
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 5 && ins.result >= 0) {
        out = out.with(ins.result, ins.str.len());
      }
    }
  }
  return out;
}

// Per record, variant or array construction whose every field or element is a
// narrow scalar constant: "|" and its words, which is a static box's whole
// content; "" for any other value. An empty array literal is one whatever its
// element type. A field or element may also hold another such box, as the
// word `@<value>`, or a string literal's static box, as `$<value>`. A static
// box's rc is immortal, so its releases and uniqueness tests leave it alone.
//
// A field's box can be defined in a block visited after the field's, so a pass
// that left a field waiting on one is repeated once it has placed anything.
function constants(f: ssasem.Func, defs: ssa.SInst[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < f.graph.nvals) {
    out = out.append("");
    i = i + 1;
  }
  let raw: boolean[] = __alloc_bool(f.graph.nvals);
  for v in raw_reached(f, defs) {
    raw = raw.with(v, true);
  }
  let again: boolean = true;
  while (again) {
    let placed: boolean = false;
    let waiting: boolean = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        let built: Construction = placeable(f, raw, out, ins);
        if (built.ok) {
          let w: BoxWords = box_words(f, defs, raw, out, ins, built.fields);
          waiting = waiting || w.waiting;
          if (w.text != "") {
            out = out.with(ins.result, w.text);
            placed = true;
          }
        }
      }
    }
    again = placed && waiting;
  }
  return out;
}

// A construction `constants` has not placed and may: not handed to the raw
// floor, and with no finalizer to run.
function placeable(f: ssasem.Func, raw: boolean[], out: string[], ins: ssa.SInst): Construction {
  let built: Construction = built_fields(f, ins);
  if (!built.ok || built.fields.len() != ins.args.len() || raw[ins.result] || out[ins.result] != "") {
    return Construction { ...built, ok: false };
  }
  if (ssasem.finalizer_of(f, f.values[ins.result]) != "") {
    return Construction { ...built, ok: false };
  }
  return built;
}

// One construction's static words, "" when a field is not constant, and
// whether a field is a box this pass has not placed yet.
struct BoxWords { text: string, waiting: boolean }

function box_words(f: ssasem.Func, defs: ssa.SInst[], raw: boolean[], out: string[], ins: ssa.SInst, fields: semrecords.Field[]): BoxWords {
  let words: string = "|";
  let j: i32 = 0;
  while (j < fields.len()) {
    let w: string = constant_word(defs, ins.args[j], fields[j].ty);
    if (w == "") {
      w = literal_word(defs, ins.args[j]);
    }
    if (w == "") {
      let at: i32 = placed_box(f, defs, raw, ins.args[j]);
      if (at < 0 || out[at] == "") {
        return BoxWords { text: "", waiting: at >= 0 };
      }
      w = "@" + util.i32_to_string(at);
    }
    if (w == "") {
      return BoxWords { text: "", waiting: false };
    }
    if (j > 0) {
      words = words + ",";
    }
    words = words + w;
    j = j + 1;
  }
  return BoxWords { text: words, waiting: false };
}

// A string literal's static box, as `$<value>`, read through copies; "" for
// anything else.
function literal_word(defs: ssa.SInst[], v: i32): string {
  if (v < 0) {
    return "";
  }
  let d: ssa.SInst = defs[v];
  let hops: i32 = 0;
  while (d.kind_tag == 7 && d.args.len() == 1 && d.args[0] >= 0 && hops < 16) {
    d = defs[d.args[0]];
    hops = hops + 1;
  }
  if (d.kind_tag != 5 || d.result < 0) {
    return "";
  }
  return "$" + util.i32_to_string(d.result);
}

// The construction a field's value is, read through copies, when it is one
// `constants` could place; -1 otherwise.
function placed_box(f: ssasem.Func, defs: ssa.SInst[], raw: boolean[], v: i32): i32 {
  if (v < 0) {
    return 0 - 1;
  }
  let d: ssa.SInst = defs[v];
  let hops: i32 = 0;
  while (d.kind_tag == 7 && d.args.len() == 1 && d.args[0] >= 0 && hops < 16) {
    d = defs[d.args[0]];
    hops = hops + 1;
  }
  if (d.result < 0 || raw[d.result] || !built_fields(f, d).ok) {
    return 0 - 1;
  }
  return d.result;
}

// The values whose storage this body hands to the raw floor: an array cast to
// its data pointer, or given to `__arr_set_len` or `__raw_arr_ptr`, traced back
// through copies and phis. The floor writes that storage without a count, so a
// literal reaching it is built fresh rather than shared.
function raw_reached(f: ssasem.Func, defs: ssa.SInst[]): i32[] {
  let work: i32[] = [];
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.args.len() == 0) {
        continue;
      }
      let raw: boolean = ins.kind_tag == ssasem.cast() && is_array(f.values[ins.args[0]]);
      raw = raw || ins.kind_tag == ssasem.call() && (ins.str == "__arr_set_len" || ins.str == "__raw_arr_ptr");
      if (raw) {
        work = work.append(ins.args[0]);
      }
    }
  }
  let seen: boolean[] = __alloc_bool(f.graph.nvals);
  let out: i32[] = [];
  let at: i32 = 0;
  while (at < work.len()) {
    let v: i32 = work[at];
    at = at + 1;
    if (v < 0 || v >= seen.len() || seen[v]) {
      continue;
    }
    seen = seen.with(v, true);
    out = out.append(v);
    let d: ssa.SInst = defs[v];
    if (d.kind_tag == 7 || d.kind_tag == 8) {
      for a in d.args {
        work = work.append(a);
      }
    }
  }
  return out;
}

// The declared fields a record or boxed-variant construction fills, one per
// element for an array literal; not ok for anything else, an Option or Result
// among them, whose box is a tag and a payload rather than a shape and fields.
// A closure's environment is a record only to the lowering, so it is not one
// here.
struct Construction { ok: boolean, fields: semrecords.Field[] }

function built_fields(f: ssasem.Func, ins: ssa.SInst): Construction {
  let none: semrecords.Field[] = [];
  let t: typeinfo.Type = f.values[ins.result];
  if (ins.kind_tag == ssasem.array_new()) {
    if let typeinfo.TypeArray(a) = t {
      let elems: semrecords.Field[] = [];
      while (elems.len() < ins.args.len()) {
        elems = elems.append(semrecords.Field { name: "", ty: a.elem });
      }
      return Construction { ok: true, fields: elems };
    }
  }
  if (ins.kind_tag == ssasem.record_new() && !semtypes.is_env(t)) {
    let at: i32 = semrecords.find(f.records, t);
    if (at >= 0) {
      return Construction { ok: true, fields: f.records.list[at].fields };
    }
  }
  if (ins.kind_tag == ssasem.variant_new()) {
    let e: i32 = semrecords.find_enum(f.enums, t);
    if (e >= 0 && f.enums[e].layout == semrecords.layout_variant()) {
      for v in f.enums[e].variants {
        if (v.name == ins.str) {
          return Construction { ok: true, fields: v.fields };
        }
      }
    }
  }
  return Construction { ok: false, fields: none };
}

// A field's static word, or "" when the value is not a constant this can
// place. A u32 literal carries its text rather than an immediate, as
// `ssarc.constant` reads it. A copy reads through to what it copies, which is
// how a spliced accessor's constant arrives.
function constant_word(defs: ssa.SInst[], v: i32, t: typeinfo.Type): string {
  if (!narrow_scalar(t)) {
    return "";
  }
  let d: ssa.SInst = defs[v];
  let hops: i32 = 0;
  while (d.kind_tag == 7 && d.args.len() == 1 && d.args[0] >= 0 && hops < 16) {
    d = defs[d.args[0]];
    hops = hops + 1;
  }
  if (d.kind_tag == 1 && d.str != "") {
    return small_decimal(d.str);
  }
  if (d.kind_tag == 1 || d.kind_tag == 2) {
    return util.i32_to_string(d.imm);
  }
  if (d.str != "-" || !ssasem.is_i32(t)) {
    return "";
  }
  return negated_word(defs, d);
}

// A negative i32 literal is `0 - k` in source, which arrives as that
// subtraction or, once the front end has folded it, as a negation; negating a
// non-negative i32 cannot wrap.
function negated_word(defs: ssa.SInst[], d: ssa.SInst): string {
  let k: ssa.SInst = defs[d.args[d.args.len() - 1]];
  if (k.kind_tag != 1 || k.imm < 0) {
    return "";
  }
  if (d.kind_tag == 10) {
    return util.i32_to_string(0 - k.imm);
  }
  let zero: ssa.SInst = defs[d.args[0]];
  if (d.kind_tag != 9 || zero.kind_tag != 1 || zero.imm != 0) {
    return "";
  }
  return util.i32_to_string(0 - k.imm);
}

// A literal carried as its source text (an unsigned one), admitted only when
// it is plain decimal below 2^31, where its word reads the same at any width.
function small_decimal(text: string): string {
  if (text.len() == 0 || text.len() > 9) {
    return "";
  }
  let i: i32 = 0;
  while (i < text.len()) {
    if (text[i] < b'0' || text[i] > b'9') {
      return "";
    }
    i = i + 1;
  }
  return text;
}

function narrow_scalar(t: typeinfo.Type): boolean {
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  return ssasem.is_i32(t) || ssasem.is_u32(t) || ssasem.is_u8(t) || ssasem.is_char(t);
}

// The slice a value is, directly or retagged as a borrowed string; -1 when it
// is neither.
function lent_view(defs: ssa.SInst[], v: i32): i32 {
  if (v < 0 || v >= defs.len()) {
    return 0 - 1;
  }
  let d: ssa.SInst = defs[v];
  if (d.kind_tag == ssasem.slice()) {
    return v;
  }
  if (d.kind_tag == ssasem.str_as() && d.args.len() == 1 && d.args[0] >= 0 && defs[d.args[0]].kind_tag == ssasem.slice()) {
    return d.args[0];
  }
  return 0 - 1;
}

function reads_view(ins: ssa.SInst, at: i32, lent: boolean): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 9 || k == ssasem.append_range() || k == ssasem.length() || k == ssasem.str_index() || k == ssasem.str_bytes()) {
    return true;
  }
  if (k == ssasem.slice()) {
    return at == 0;
  }
  if (k == ssasem.str_as()) {
    return !lent;
  }
  return k == ssasem.call() && lent;
}

function is_record(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

// A value reached through another: a copy, a projection, or a retag.
function projection(kind: i32): boolean {
  return kind == 7 || kind == ssasem.array_get() || kind == ssasem.tuple_get() || kind == ssasem.record_get()
    || kind == ssasem.variant_get() || kind == ssasem.variant_up() || kind == ssasem.variant_as()
    || kind == ssasem.slice() || kind == ssasem.arr_slice() || kind == ssasem.str_as() || kind == ssasem.array_lend() || kind == ssasem.str_byte_view() || kind == ssasem.dyn_up() || kind == ssasem.dyn_as();
}

// Whether reading `arg` reads `w`: the value itself, or one anchored to it.
function reads(a: ssasem.Analysis, arg: i32, w: i32): boolean {
  if (arg < 0) {
    return false;
  }
  if (arg == w) {
    return true;
  }
  for dep in a.dependencies[arg] {
    if (dep == w) {
      return true;
    }
  }
  return false;
}

// Whether `w` is read after position `pos` of block `bi`: by a later
// instruction, by the terminator, or on the way out of the block.
function used_after(f: ssasem.Func, a: ssasem.Analysis, bi: i32, pos: i32, w: i32): boolean {
  let b: ssa.SBlock = f.graph.blocks[bi];
  if (ssalive.live_out_has(a.flow, bi, w)) {
    return true;
  }
  let i: i32 = pos + 1;
  while (i < b.insts.len()) {
    for arg in b.insts[i].args {
      if (reads(a, arg, w)) {
        return true;
      }
    }
    i = i + 1;
  }
  if (b.term.kind_tag == 1 && reads(a, b.term.value, w)) {
    return true;
  }
  if (b.term.kind_tag == 3 && reads(a, b.term.cond, w)) {
    return true;
  }
  return false;
}

// The projection of `root` that `w` reaches it through: `w` itself when its
// parent is the root, else the chain element just before the root. -1 when a
// value on the chain is anchored to more than one, since the chain then names
// no one path.
function first_hop(a: ssasem.Analysis, w: i32, root: i32): i32 {
  if (a.parents[w].len() > 1) {
    return 0 - 1;
  }
  let prev: i32 = w;
  for dep in a.dependencies[w] {
    if (dep == root) {
      return prev;
    }
    if (a.parents[dep].len() > 1) {
      return 0 - 1;
    }
    prev = dep;
  }
  return 0 - 1;
}

function other_field_get(ins: ssa.SInst, root: i32, field: i32): boolean {
  return ins.kind_tag == ssasem.record_get() && ins.args[0] == root && ins.imm != field;
}

// The record whose field the projection `v` names, when this frame reads
// that field no further after the instruction at (`bi`, `pos`), or -1. The
// record is one this frame holds as a parameter or owns outright, and after
// the instruction it is read only through projections of its OTHER fields —
// the functional update `R { ...r, xs: f(r.xs) }` — with nothing anchored to
// the projected field, and nothing anchored to the record any other way,
// still live. A later block may read the record only through its other
// fields too (`named_after`), so a loop that reaches the same record again is
// refused; a loop-carried record is a fresh phi each round.
//
// What this proves is that THIS frame never reads the field again, so the
// buffer may be grown in place by the instruction, or by a callee it is
// handed to without a bracket. Whether another holder reads it is answered at
// run time — the record's own count, when it is shared — and by the
// caller-side bracket (`grow_rows`) for the frame that lent the record and
// still reads it.
function projection_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, v: i32): i32 {
  let none: i32 = 0 - 1;
  let get: ssa.SInst = defs[v];
  if (get.kind_tag != ssasem.record_get()) {
    return none;
  }
  let root: i32 = get.args[0];
  if (!is_record(f.values[root]) || semtypes.is_env(f.values[root])) {
    return none;
  }
  if (defs[root].kind_tag != 6 && !owned[root]) {
    return none;
  }
  if (projection(defs[root].kind_tag)) {
    return none;
  }
  let b: ssa.SBlock = f.graph.blocks[bi];
  if (ssalive.live_out_has(a.flow, bi, root) && named_after(f, a.flow, bi, root, get)) {
    return none;
  }
  let i: i32 = pos + 1;
  while (i < b.insts.len()) {
    let later: ssa.SInst = b.insts[i];
    if (ssa.reads_value(later, root) && !other_field_get(later, root, get.imm)) {
      return none;
    }
    i = i + 1;
  }
  if (b.term.kind_tag == 1 && b.term.value == root) {
    return none;
  }
  // The instruction's own other operands read the record as the callee or
  // the op sees it, after the field is taken or grown.
  for arg in b.insts[pos].args {
    if (arg != v && reaches_past_field(a, defs, root, get.imm, arg)) {
      return none;
    }
  }
  let w: i32 = 0;
  while (w < f.graph.nvals) {
    if (w != root && reaches_past_field(a, defs, root, get.imm, w) && used_after(f, a, bi, pos, w)) {
      return none;
    }
    w = w + 1;
  }
  return root;
}

// Whether `w` reaches the record `root` other than through a read of one of
// its fields other than `field`.
function reaches_past_field(a: ssasem.Analysis, defs: ssa.SInst[], root: i32, field: i32, w: i32): boolean {
  if (w == root) {
    return true;
  }
  if (!reads(a, w, root)) {
    return false;
  }
  let hop: i32 = first_hop(a, w, root);
  return hop < 0 || !other_field_get(defs[hop], root, field);
}

function other_tuple_get(ins: ssa.SInst, root: i32, field: i32): boolean {
  return ins.kind_tag == ssasem.tuple_get() && ins.args.len() == 1 && ins.args[0] == root && ins.imm != field;
}

// A source whose box this frame ALLOCATED, so nulling a slot in it is invisible
// to everyone else. The take nulls without asking, so this and
// `only_element_reads` are the whole of its safety: owning a unit is not
// enough, the box has to be the frame's alone.
//
// Only two kinds of instruction can define a TUPLE and qualify:
//
//   - a construction — `tuple_new` builds the box here, refcount 1;
//   - `map_delete`, whose result is the fresh two-word box the runtime
//     allocates to pair the map with whether the key was there.
//
// Everything else that can define a tuple hands back a box someone else still
// names, and is excluded:
//
//   - a counted PARAMETER. `own` transfers ONE unit, not exclusive ownership,
//     so the box may have other holders. `steal` next door admits a parameter
//     root only because it pays for it with a runtime `__fern_rc_is_unique`
//     test before nulling; the take does not test.
//   - `cell_get` and `map_get_or`, which RETAIN what they read (`cell_read`'s
//     and `map_op`'s `__fern_rc_inc`) — the cell and the map's value column
//     still hold the box, and a counted column may hold a tuple, so nulling
//     here would show up in every later read through the container.
//   - a CALL result, whose exclusivity this boundary cannot establish: a callee
//     may return a retained alias of something it goes on holding.
//   - a phi, because one of its incoming edges may be any of the above.
//
// The other `hands_out` operations answer an array, a map, an Option or a
// closure box and so can never be a take's source; naming them here would
// suggest a judgement about them that this predicate does not make.
function takeable_root(kind: i32): boolean {
  return construction(kind) || kind == ssasem.map_delete();
}

// The element index a tuple read at (`bi`, `pos`) TAKES rather than borrows,
// or -1. A projection borrows by default, so a consuming use of what it read
// owes a retain, which a take saves (#9555).
//
// It takes when the source is a unit of this frame's own, dies at this read,
// and is reached after it only through reads of its OTHER elements. The
// element's unit then becomes the frame's for nothing: the physical lowering
// nulls the slot, and the source's own drop — in this same step, since it dies
// here — walks past the null rather than releasing what the frame now holds.
//
// Same shape as `projection_root` above and the same reasoning, over a tuple
// rather than a record, and over the whole source rather than one field: a
// tuple has no functional-update form, so a later read through another element
// is the only way the source may still be mentioned.
function tuple_take_field(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
  let none: i32 = 0 - 1;
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (ins.kind_tag != ssasem.tuple_get()) {
    return none;
  }
  // This runs BEFORE the graph is verified, so a malformed instruction has
  // to answer "no take" rather than read past the end of its own operands.
  if (ins.args.len() != 1) {
    return none;
  }
  if (ins.result < 0 || ins.result >= f.graph.nvals) {
    return none;
  }
  let root: i32 = ins.args[0];
  if (root < 0 || root >= f.graph.nvals || root >= owned.len() || root >= defs.len()) {
    return none;
  }
  if (!ssasem.reference(f.values[ins.result])) {
    return none;
  }
  if (!owned[root] || !takeable_root(defs[root].kind_tag) || !only_element_reads(f, root)) {
    return none;
  }
  let b: ssa.SBlock = f.graph.blocks[bi];
  if (ssalive.live_out_has(a.flow, bi, root)) {
    return none;
  }
  let i: i32 = pos + 1;
  while (i < b.insts.len()) {
    let later: ssa.SInst = b.insts[i];
    if (ssa.reads_value(later, root) && !other_tuple_get(later, root, ins.imm)) {
      return none;
    }
    i = i + 1;
  }
  if (ssa.term_reads_value(b.term, root)) {
    return none;
  }
  let w: i32 = 0;
  while (w < f.graph.nvals) {
    if (w != root && w != ins.result && reads(a, w, root) && used_after(f, a, bi, pos, w)) {
      let hop: i32 = first_hop(a, w, root);
      if (hop != ins.result && (hop < 0 || !other_tuple_get(defs[hop], root, ins.imm))) {
        return none;
      }
    }
    w = w + 1;
  }
  return ins.imm;
}

// A box this frame built has a count of 1 only until something else is handed
// it: a container it is stored in, a call, a phi. Every use has to be an
// element read.
function only_element_reads(f: ssasem.Func, root: i32): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag != ssasem.tuple_get() && ssa.reads_value(ins, root)) {
        return false;
      }
    }
    if (ssa.term_reads_value(b.term, root)) {
      return false;
    }
  }
  return true;
}

// The element each tuple read takes, indexed by the read's result value, and
// -1 where it borrows. Computed before the step walk because the walk runs
// BACKWARDS: a taken element is a unit of the frame's own, and the consuming
// use that moves it is reached before the read that produced it.
function tuple_takes(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): i32[] {
  let out: i32[] = [];
  let vi: i32 = 0;
  while (vi < f.graph.nvals) {
    out = out.append(0 - 1);
    vi = vi + 1;
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let pos: i32 = 0;
    while (pos < f.graph.blocks[bi].insts.len()) {
      let field: i32 = tuple_take_field(f, a, owned, defs, bi, pos);
      if (field >= 0) {
        out = out.with(f.graph.blocks[bi].insts[pos].result, field);
      }

      pos = pos + 1;
    }
    bi = bi + 1;
  }
  return out;
}

// What a take changes about the plan's inputs, derived once so the planner and
// the independent replay below reach it the same way: the element becomes a
// unit of this frame's own, and it stops being ANCHORED to the tuple it came
// out of — the source is released in the same step, and leaving the dependency
// would read every later use of the element as a borrow outliving its
// container. A payload take says the same about an enum box's payload.
// `reflow` marks a take whose box is released alone (`shell_root`), or whose
// box was live out of the read's block only as the taken value's anchor: that
// box has to die at the read, which the flow derived before the take cannot say.
struct Units { owned: boolean[], parents: i32[][], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[], reflow: boolean }

// The payload takes are derived FIRST and folded into ownership before the
// other two run: a taken payload is a unit of this frame's own, and the tuple
// takes and the element holds both ask whether the value they read through is
// owned. Deriving them against the base instead reads a taken payload as a
// borrow, and an element read of one then pins the array it came out of
// rather than taking its own unit — which is the whole of what a hold exists
// to prevent (#9891).
function units_of(f: ssasem.Func, base: boolean[], a: ssasem.Analysis, defs: ssa.SInst[]): Units {
  let pt: PayloadTakes = payload_takes(f, a, base, defs);
  let payloads: boolean[] = pt.taken;
  let owned: boolean[] = base;
  let i: i32 = 0;
  while (i < payloads.len()) {
    if (payloads[i]) {
      owned = owned.with(i, true);
    }
    i = i + 1;
  }
  let takes: i32[] = tuple_takes(f, a, owned, defs);
  let held: boolean[] = held_elements(f, a, owned, defs);
  // A taken payload is a unit of its own at the read already, moved out of
  // the box or retained there by the lowering's uniqueness test
  // (ssarc.steal); the hold read it as still anchored to its array, and
  // would retain it a second time.
  i = 0;
  while (i < held.len()) {
    if (held[i] && payloads[i]) {
      held = held.with(i, false);
    }
    i = i + 1;
  }
  let parents: i32[][] = a.parents;
  let deps: i32[][] = a.dependencies;
  let reflow: boolean = pt.crossing;
  i = 0;
  while (i < takes.len()) {
    // A taken record field reflows, as a taken payload does: the values
    // read through it still chain to the record, which has to die at the
    // read. option_layout already admits a record (it is not an enum), so
    // the record_get test states that rather than widening the gate.
    if (payloads[i] && (defs[i].kind_tag == ssasem.record_get() || defs[i].kind_tag == ssasem.tuple_get() || option_layout(f, f.values[defs[i].args[0]]))) {
      reflow = true;
    }
    if (takes[i] >= 0 || held[i] || payloads[i]) {
      owned = owned.with(i, true);
      // A view's bytes are its source's, not the box's it came out of, so
      // a taken view stays anchored to what the box was.
      let up: i32[] = [];
      let chain: i32[] = [];
      if ((takes[i] >= 0 || payloads[i]) && ssasem.is_view(f.values[i])) {
        up = a.parents[defs[i].args[0]];
        chain = a.dependencies[defs[i].args[0]];
      }
      parents = parents.with(i, up);
      deps = deps.with(i, chain);
    }
    i = i + 1;
  }
  if (reflow) {
    deps = through_takes(parents, deps, takes, held, payloads);
  }
  return Units { owned: owned, parents: parents, deps: deps, takes: takes, held: held, payloads: payloads, reflow: reflow };
}

// A value read through one that became a unit of its own reaches the storage
// behind it only through that unit's new chain, so every chain stops at each
// such value and continues with its chain.
function through_takes(parents: i32[][], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[]): i32[][] {
  let out: i32[][] = deps;
  let w: i32 = 0;
  while (w < deps.len()) {
    out = out.with(w, reach_through(parents, deps, takes, held, payloads, w, []));
    w = w + 1;
  }
  return out;
}

function reach_through(parents: i32[][], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[], x: i32, own out: i32[]): i32[] {
  for p in parents[x] {
    if (util.index_of_i32(out, p) >= 0) {
      continue;
    }
    out = out.append(p);
    if (takes[p] >= 0 || held[p] || payloads[p]) {
      for e in deps[p] {
        if (util.index_of_i32(out, e) < 0) {
          out = out.append(e);
        }
      }
    } else {
      out = reach_through(parents, deps, takes, held, payloads, p, out);
    }
  }
  return out;
}

// The analysis the plan and its replay read once the takes and holds are in:
// the reads that became units of their own anchor nothing. A hold shortens a
// chain that is still live, so the flow is derived again over the new chains
// and the array a held read came from dies where its own uses end; a take's
// source dies at the read, so a take alone leaves the flow as it was.
function units_analysis(f: ssasem.Func, a: ssasem.Analysis, units: Units): ssasem.Analysis {
  let any: boolean = units.reflow;
  for h in units.held {
    if (h) {
      any = true;
    }
  }
  if (!any) {
    return ssasem.Analysis { ...a, parents: units.parents, dependencies: units.deps };
  }
  let flow: ssalive.Flow = ssadeps.analyze(f.graph, units.deps);
  return ssasem.Analysis { ...a, ok: flow.ok, why: flow.why, parents: units.parents, dependencies: units.deps, flow: flow };
}

// A read of an array element, a record field or a tuple element, of a type
// the frame can hold a unit of: a view is lent, never retained, and a scalar
// has no unit.
function retainable_read(f: ssasem.Func, defs: ssa.SInst[], w: i32): boolean {
  let k: i32 = defs[w].kind_tag;
  if (k != ssasem.array_get() && k != ssasem.record_get() && k != ssasem.tuple_get()) {
    return false;
  }
  let t: typeinfo.Type = f.values[w];
  return ssasem.reference(t) && !ssasem.is_view(t);
}

// The dependency chains read backwards: the values anchored to `v` are
// `at[start[v] .. start[v + 1])`, ascending. Built once per function, so a
// query for one source walks its anchored values rather than every value.
struct Anchored { start: i32[], at: i32[] }

function anchored_to(a: ssasem.Analysis, nvals: i32): Anchored {
  let count: i32[] = __alloc_i32(nvals + 1);
  // The chains run to the values the analysis saw; a refused analysis has
  // none.
  let known: i32 = a.dependencies.len();
  if (known > nvals) {
    known = nvals;
  }
  let w: i32 = 0;
  while (w < known) {
    for dep in a.dependencies[w] {
      if (dep >= 0 && dep < nvals) {
        count = count.with(dep, count[dep] + 1);
      }
    }
    w = w + 1;
  }
  let start: i32[] = [];
  let total: i32 = 0;
  let v: i32 = 0;
  while (v <= nvals) {
    start = start.append(total);
    if (v < nvals) {
      total = total + count[v];
    }
    v = v + 1;
  }
  let at: i32[] = __alloc_i32(total);
  let fill: i32[] = start;
  w = 0;
  while (w < known) {
    for dep in a.dependencies[w] {
      if (dep >= 0 && dep < nvals) {
        at = at.with(fill[dep], w);
        fill = fill.with(dep, fill[dep] + 1);
      }
    }
    w = w + 1;
  }
  return Anchored { start: start, at: at };
}

// The reads anchored to `s` that are still in hand once `s` is
// supplied: past the operation at (`bi`, `pos`), into block `si` when `s`
// goes out along an edge, or as an operand of that same operation (`args`)
// where `s` dies. A read handed to a call beside its own array would
// otherwise keep the array alive through the call as its anchor, so the
// array was retained for the call instead of moved into it, and every
// append the callee made copied the buffer. A read already `owned` took its
// slot (payload_root) and has its unit.
function outliving(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], anchored: Anchored, owned: boolean[], held: boolean[], s: i32, bi: i32, pos: i32, si: i32, args: i32[]): boolean[] {
  let out: boolean[] = held;
  let k: i32 = anchored.start[s];
  while (k < anchored.start[s + 1]) {
    let w: i32 = anchored.at[k];
    if (w != s && !out[w] && !owned[w] && retainable_read(f, defs, w)) {
      let live: boolean = false;
      if (si >= 0) {
        live = ssalive.live_in_has(a.flow, si, w);
      } else {
        live = used_after(f, a, bi, pos, w) || has_id(args, w) && !used_after(f, a, bi, pos, s);
      }
      if (live) {
        out = out.with(w, true);
      }
    }
    k = k + 1;
  }
  return out;
}

// A read of an element or a field still in hand when its array, record or
// tuple is consumed takes a unit of its own at the read: one that outlives
// the consuming use, or one handed to that use beside its source
// (`outliving`). Retained there, released when it dies, anchored to nothing.
// As a borrow it kept the source alive past the use, so a `.with`, an append
// or a call there retained the source instead of moving it, and the write
// copied the whole buffer (#9849, #11834). A read that dies before any such
// use stays a borrow and costs nothing.
function held_elements(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let anchored: Anchored = anchored_to(a, f.graph.nvals);
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    let pos: i32 = 0;
    while (pos < b.insts.len()) {
      let ins: ssa.SInst = b.insts[pos];
      if (ins.kind_tag != 6 && ins.kind_tag != 8) {
        let supplies: Supply[] = operation_supplies(f, ins);
        for got in supplies {
          if (owned[got.value]) {
            out = outliving(f, a, defs, anchored, owned, out, got.value, bi, pos, 0 - 1, ins.args);
          }
        }
      }
      pos = pos + 1;
    }
    let targets: i32[] = successors(b);
    for target in targets {
      let si: i32 = ssalive.position(a.flow, target);
      let along: Supply[] = edge_supplies(f, b, si, owned);
      for got in along {
        if (owned[got.value]) {
          out = outliving(f, a, defs, anchored, owned, out, got.value, bi, 0, si, []);
        }
      }
    }
    bi = bi + 1;
  }
  return out;
}

// A later read of a DIFFERENT payload slot of the same box: the box is
// mentioned again, but not through the slot a take has emptied.
function other_payload_get(ins: ssa.SInst, root: i32, slot: i32): boolean {
  return ins.kind_tag == ssasem.variant_get() && ins.args.len() == 1 && ins.args[0] == root && ins.imm != slot;
}

// The box whose slot the read at (`bi`, `pos`) may MOVE out of rather than
// borrow, or -1: an enum's payload named by a variant read, or an array, map
// or record held in a record's field, a tuple's element or an owned array's
// element (field_takeable). Same shape as
// `projection_root` above, over the one slot the read names: the box is a
// unit of this frame's own, no later block names it, and after the read it
// is reached only through reads of its OTHER slots (`needed_past`).
//
// The untested tuple take next door demands more of its source —
// `takeable_root`, a box this frame ALLOCATED — because it nulls without
// asking, and keeps the tuples that qualify for it. Here the physical
// lowering pays for a weaker source with a runtime uniqueness test on the box
// (`ssarc.steal`): a box somebody else also holds keeps its payload and the
// read retains, exactly as a borrow did. So what this predicate has to prove
// is only that THIS frame reads the slot no further.
//
// The builtin Option layout is refused: its box is a tag word and one payload
// word the physical lowering reads with `op_opt_payload`, which has no store
// form to null the slot with.
function payload_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
  let none: i32 = 0 - 1;
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  let field: boolean = ins.kind_tag == ssasem.record_get();
  let element: boolean = ins.kind_tag == ssasem.tuple_get();
  let slot: boolean = ins.kind_tag == ssasem.array_get();
  let arity: i32 = 1;
  if (slot) {
    arity = 2;
  }
  if (ins.kind_tag != ssasem.variant_get() && !field && !element && !slot || ins.args.len() != arity) {
    return none;
  }
  // This runs BEFORE the graph is verified, so a malformed instruction has
  // to answer "no take" rather than read past the end of its own operands.
  if (ins.result < 0 || ins.result >= f.graph.nvals) {
    return none;
  }
  let root: i32 = ins.args[0];
  if (root < 0 || root >= f.graph.nvals || root >= owned.len() || root >= defs.len()) {
    return none;
  }
  // A tuple this frame built is `tuple_take_field`'s, which nulls without
  // asking; this tested take is for one it was handed.
  if (element && takeable_root(defs[root].kind_tag)) {
    return none;
  }
  if (!slot_takeable(f, defs, f.values[ins.result], root, field, element, slot)) {
    return none;
  }
  if (!owned[root] || projection(defs[root].kind_tag) && !taken_read(defs[root].kind_tag)) {
    return none;
  }
  if (needed_past(f, a, defs, bi, ins, root)) {
    return none;
  }
  if (read_later_in_block(f, a, defs, bi, pos, root)) {
    return none;
  }
  return root;
}

// Whether the box `root` can give up the slot the read `got` names: a
// buffer, map or record field of a record, element of a tuple or element of
// an owned array, or a reference payload of a union. A view, or the builtin Option layout, needs a box nobody else sees.
function slot_takeable(f: ssasem.Func, defs: ssa.SInst[], got: typeinfo.Type, root: i32, field: boolean, element: boolean, slot: boolean): boolean {
  let box: typeinfo.Type = f.values[root];
  if (field) {
    return field_takeable(got) && is_record(box) && !semtypes.is_env(box);
  }
  if (element) {
    return field_takeable(got) && is_tuple(box);
  }
  if (slot) {
    return field_takeable(got) && is_array(box) && !ssasem.is_view(box);
  }
  if (!ssasem.reference(got) || !is_union(box)) {
    return false;
  }
  return !(ssasem.is_view(got) || option_layout(f, box)) || sole_box(f, defs, root, __alloc_bool(f.graph.nvals));
}

// Whether the rest of block bi, after the read at pos, reads `root` other than
// through another of its slots. An array's elements have no other slot a
// read can be proven to name, so the one read let through is the `with`
// that stores back at the element the take emptied — `xs.with(i, f(xs[i]))`
// — and only one: a second with from the same box would carry the hole.
function read_later_in_block(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], bi: i32, pos: i32, root: i32): boolean {
  let b: ssa.SBlock = f.graph.blocks[bi];
  let ins: ssa.SInst = b.insts[pos];
  let stores: i32 = 0;
  let i: i32 = pos + 1;
  while (i < b.insts.len()) {
    if (same_slot_with(b.insts[i], ins)) {
      stores = stores + 1;
      if (stores > 1) {
        return true;
      }
    } else if (ssa.reads_value(b.insts[i], root) && !other_slot_get(b.insts[i], ins)) {
      return true;
    }
    i = i + 1;
  }
  if (ssa.term_reads_value(b.term, root)) {
    return true;
  }
  return anchored_after(f, a, defs, bi, pos, root);
}

// A value used after pos in block bi reaches root other than through the read
// at pos or a read of another of root's slots. The values the rest of the
// block reads are enumerated from its instructions, each with the chain it
// reads through, rather than every value of the function asked whether the
// block reads it; what leaves the block is read off the live-out set.
function anchored_after(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], bi: i32, pos: i32, root: i32): boolean {
  let b: ssa.SBlock = f.graph.blocks[bi];
  let ins: ssa.SInst = b.insts[pos];
  for w in ssalive.live_out_ids(a.flow, bi) {
    if (reaches_root(a, defs, ins, root, w)) {
      return true;
    }
  }
  let i: i32 = pos + 1;
  while (i < b.insts.len()) {
    for arg in b.insts[i].args {
      if (read_reaches_root(a, defs, ins, root, arg)) {
        return true;
      }
    }
    i = i + 1;
  }
  if (b.term.kind_tag == 1 && read_reaches_root(a, defs, ins, root, b.term.value)) {
    return true;
  }
  return b.term.kind_tag == 3 && read_reaches_root(a, defs, ins, root, b.term.cond);
}

// Whether reading `arg` reads a value that reaches `root` other than through
// the take `ins`: `arg` itself or one it is anchored to.
function read_reaches_root(a: ssasem.Analysis, defs: ssa.SInst[], ins: ssa.SInst, root: i32, arg: i32): boolean {
  if (arg < 0) {
    return false;
  }
  if (reaches_root(a, defs, ins, root, arg)) {
    return true;
  }
  for dep in a.dependencies[arg] {
    if (reaches_root(a, defs, ins, root, dep)) {
      return true;
    }
  }
  return false;
}

// Whether `w`, read after the take `ins`, reaches `root` other than through
// the take or a read of another of root's slots.
function reaches_root(a: ssasem.Analysis, defs: ssa.SInst[], ins: ssa.SInst, root: i32, w: i32): boolean {
  if (w == root || w == ins.result || !reads(a, w, root)) {
    return false;
  }
  let hop: i32 = first_hop(a, w, root);
  return hop != ins.result && (hop < 0 || !other_slot_get(defs[hop], ins));
}

// Whether `root` is still needed after block `bi` other than through what the
// read `take` moves out of it: a block that can run later, `bi` itself again
// included, names it, or a live-out value is anchored to it other than through
// a read of another of its slots.
// The value taken keeps `root` live in the flow, which predates the take.
function needed_past(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], bi: i32, take: ssa.SInst, root: i32): boolean {
  if (!ssalive.live_out_has(a.flow, bi, root)) {
    return false;
  }
  return named_after(f, a.flow, bi, root, take) || reached_past_take(a, defs, bi, take, root);
}

// A block after bi reads v. The walk stops at the block defining v — a loop's
// header, for a phi — since past that definition v is a new value. A phi reads
// an operand only on its own incoming edge, so it counts where the walk enters
// its block by that edge: an arm that rebuilt v hands the join its new value,
// whatever the join takes from the arms that left v alone. A later read of
// another of v's slots is let through, as `reached_past_take` and
// `read_later_in_block` do: what keeps v live is then not the slot taken. A
// read of the taken slot itself still counts, so a take a loop would run again
// on the same box is refused. The walk keeps to v's live range: a block v is
// not live out of hands it to no successor, phi edges included, and a block v
// is not live into reads it nowhere.
function named_after(f: ssasem.Func, fl: ssalive.Flow, bi: i32, v: i32, take: ssa.SInst): boolean {
  let seen: boolean[] = __alloc_bool(f.graph.blocks.len());
  let work: i32[] = [bi];
  let next: i32 = 0;
  while (next < work.len()) {
    let at: i32 = work[next];
    next = next + 1;
    if (!ssalive.live_out_has(fl, at, v)) {
      continue;
    }
    let from: ssa.SBlock = f.graph.blocks[at];
    for id in successors(from) {
      let k: i32 = ssalive.position(fl, id);
      if (k >= 0) {
        let blk: ssa.SBlock = f.graph.blocks[k];
        if (phi_reads_on(blk, from.id, v)) {
          return true;
        }
        if (!seen[k]) {
          seen = seen.with(k, true);
          if (ssalive.live_in_has(fl, k, v) && !block_defines(blk, v)) {
            if (block_reads(blk, v, take)) {
              return true;
            }
            work = work.append(k);
          }
        }
      }
    }
  }
  return false;
}

function block_defines(blk: ssa.SBlock, v: i32): boolean {
  for ins in blk.insts {
    if (ins.result == v) {
      return true;
    }
  }
  return false;
}

// A phi of blk takes v on the edge from block `pred`.
function phi_reads_on(blk: ssa.SBlock, pred: i32, v: i32): boolean {
  for ins in blk.insts {
    if (ins.kind_tag == 8) {
      let i: i32 = 0;
      while (i < blk.preds.len() && i < ins.args.len()) {
        if (blk.preds[i] == pred && ins.args[i] == v) {
          return true;
        }
        i = i + 1;
      }
    }
  }
  return false;
}

// A non-phi instruction or the terminator of blk reads v other than through
// another of its slots; a phi's reads are `phi_reads_on`'s, edge by edge.
function block_reads(blk: ssa.SBlock, v: i32, take: ssa.SInst): boolean {
  for ins in blk.insts {
    if (ins.kind_tag != 8 && ssa.reads_value(ins, v) && !other_slot_get(ins, take)) {
      return true;
    }
  }
  return ssa.term_reads_value(blk.term, v);
}

// A value live out of bi reaches root other than through `take` or a read of
// another of root's slots.
function reached_past_take(a: ssasem.Analysis, defs: ssa.SInst[], bi: i32, take: ssa.SInst, root: i32): boolean {
  for w in ssalive.live_out_ids(a.flow, bi) {
    if (w != root && reads(a, w, root)) {
      let hop: i32 = first_hop(a, w, root);
      if (hop != take.result && (hop < 0 || !other_slot_get(defs[hop], take))) {
        return true;
      }
    }
  }
  return false;
}

// The with that stores back at the array element `take` read, by the same
// index value.
function same_slot_with(later: ssa.SInst, take: ssa.SInst): boolean {
  return take.kind_tag == ssasem.array_get() && later.kind_tag == ssasem.with() && later.args.len() == 3 && later.args[0] == take.args[0] && later.args[1] == take.args[1];
}

// A later read of the box `take` reads that names a DIFFERENT slot of it.
function other_slot_get(later: ssa.SInst, take: ssa.SInst): boolean {
  if (take.kind_tag == ssasem.record_get()) {
    return other_field_get(later, take.args[0], take.imm);
  }
  if (take.kind_tag == ssasem.tuple_get()) {
    return other_tuple_get(later, take.args[0], take.imm);
  }
  return other_payload_get(later, take.args[0], take.imm);
}

// A record field a take may move out: a buffer, a map or a record, whose slot
// is one word the take can null. A string may be a view or a literal at run
// time, and is left to the borrow.
function field_takeable(t: typeinfo.Type): boolean {
  if (ssasem.is_view(t) || ssasem.is_text(t)) {
    return false;
  }
  return is_array(t) || ssasem.is_map(t) || is_record(t) && !semtypes.is_env(t);
}

// A projection whose read may itself be a take, and so a unit of the frame's
// own that a nested read can take from in turn.
function taken_read(kind: i32): boolean {
  return kind == ssasem.record_get() || kind == ssasem.variant_get() || kind == ssasem.tuple_get();
}

// A box nobody but this frame's tag tests and payload reads ever sees: built
// here, or a phi of boxes that are, and never handed to anything else. Its
// count is 1 when its payload is read, so the read may take the payload with no
// runtime test — which a view needs, since the test's shared arm retains, and
// the builtin Option layout needs, since it has no store to null the slot with.
// The box's drop in that step then releases the box alone (`shell_root`).
function sole_box(f: ssasem.Func, defs: ssa.SInst[], v: i32, seen: boolean[]): boolean {
  if (v < 0 || v >= defs.len()) {
    return false;
  }
  if (seen[v]) {
    return true;
  }
  let d: ssa.SInst = defs[v];
  if (d.kind_tag != ssasem.variant_new() && d.kind_tag != 8) {
    return false;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      let reads: boolean = false;
      for a in ins.args {
        if (a == v) {
          reads = true;
        }
      }
      if (reads && ins.kind_tag != 8 && ins.kind_tag != ssasem.variant_is() && ins.kind_tag != ssasem.variant_get()) {
        return false;
      }
    }
    if (b.term.kind_tag == 1 && b.term.value == v) {
      return false;
    }
  }
  if (d.kind_tag == 8) {
    let next: boolean[] = seen.with(v, true);
    for a in d.args {
      if (!sole_box(f, defs, a, next)) {
        return false;
      }
    }
  }
  return true;
}

// The box whose drop at `ins` releases the box alone: the root of a payload
// take out of the builtin Option layout, whose slot the take cannot null, or -1.
pub function shell_root(f: ssasem.Func, p: Plan, ins: ssa.SInst): i32 {
  if (ins.kind_tag != ssasem.variant_get() || ins.result < 0 || ins.result >= p.payloads.len() || !p.payloads[ins.result]) {
    return 0 - 1;
  }
  if (!option_layout(f, f.values[ins.args[0]])) {
    return 0 - 1;
  }
  return ins.args[0];
}

function is_tuple(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  return false;
}

function is_union(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(_) = t {
    return true;
  }
  return false;
}

// True for the builtin Option/Result layout, and for a union whose schema this
// function does not carry — neither is a box a take may null a slot in.
function option_layout(f: ssasem.Func, t: typeinfo.Type): boolean {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return true;
  }
  return f.enums[at].layout == semrecords.layout_option();
}

// The variant and record reads that take their slot's unit, indexed by the
// read's result value. Computed before the step walk for the same reason the tuple
// takes are: the walk runs backwards, so the consuming use that moves the
// payload is reached before the read that produced it.
//
// To a fixpoint: a take makes its read a unit of the frame's own, which a read
// of one of ITS slots may take from in turn — `let ws = s.words; let xs =
// ws.xs;`.
//
// `crossing` is set when a take's box is live out of the read's block in the
// flow derived before the take — the taken value leaves the block, and the box
// stayed live only as its anchor — so the flow has to be derived again for the
// box to die at the read.
struct PayloadTakes { taken: boolean[], crossing: boolean }

function payload_takes(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): PayloadTakes {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let crossing: boolean = false;
  let own: boolean[] = owned;
  let grown: boolean = true;
  while (grown) {
    grown = false;
    let bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
      let pos: i32 = 0;
      while (pos < f.graph.blocks[bi].insts.len()) {
        let v: i32 = f.graph.blocks[bi].insts[pos].result;
        if (v >= 0 && v < out.len() && !out[v]) {
          let root: i32 = payload_root(f, a, own, defs, bi, pos);
          if (root >= 0) {
            out = out.with(v, true);
            own = own.with(v, true);
            crossing = crossing || ssalive.live_out_has(a.flow, bi, root);
            grown = true;
          }
        }
        pos = pos + 1;
      }
      bi = bi + 1;
    }
  }
  return PayloadTakes { taken: out, crossing: crossing };
}

// The record whose field buffer the append, with or string append at (`bi`,
// `pos`) may grow or write in place, or -1: `projection_root` of its receiver.
// A string append needs a record the frame owns: no caller brackets a text
// field it lends (grow_rows), so a borrowed record's string is never grown.
function field_grow_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (string_append(f, ins)) {
    let root: i32 = projection_root(f, a, owned, defs, bi, pos, ins.args[0]);
    if (root >= 0 && owned[root]) {
      return root;
    }
    return 0 - 1;
  }
  if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) {
    return 0 - 1;
  }
  return projection_root(f, a, owned, defs, bi, pos, ins.args[0]);
}

function is_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

pub function occurrences(xs: i32[], v: i32): i32 {
  let n: i32 = 0;
  for x in xs {
    if (x == v) {
      n = n + 1;
    }
  }
  return n;
}

// A direct call's counted slot fed by a projection of a record this frame
// owns and reads no further through that field takes the field's unit rather
// than a retained one (steal_unit): the callee then holds the buffer's only
// count and grows it in place. `Emit { ...e, r: emit(e.r, op) }` is the shape,
// and retaining there put a second count on every buffer the emit chain
// threads, so the callee's first append copied it. A field read that took its
// unit (payload_root) already owns it, and its record may be gone.
function steals(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, s: Step): Step {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (ins.kind_tag != ssasem.call()) {
    return s;
  }
  let out: Supply[] = s.supplies;
  let i: i32 = 0;
  while (i < out.len()) {
    let v: i32 = out[i].value;
    if (out[i].mode == retain_unit() && defs[v].kind_tag == ssasem.record_get() && !owned[v] && occurrences(ins.args, v) == 1) {
      let root: i32 = projection_root(f, a, owned, defs, bi, pos, v);
      if (root >= 0 && owned[root]) {
        out = out.with(i, Supply { ...out[i], mode: steal_unit() });
      }
    }
    i = i + 1;
  }
  return Step { ...s, supplies: out };
}

// The buffers a direct call at (`bi`, `pos`) is handed without a bracket:
// an array operand this frame reads no further, either a borrowed parameter
// of its own or a projection, not a take, whose record it reads no further
// through that field (projection_root); or a whole record parameter this frame reads no
// further, whose fields the callee grows under the record's own count. An
// operand named twice is bracketed, since a callee growing one name would
// move the other. The buffer's only later holder is then the callee's result
// — retained on identity, fresh on a realloc — and the record or the caller
// releases the old one.
function hands(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, s: Step): Step {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (ins.kind_tag != ssasem.call()) {
    return s;
  }
  let roots: i32[] = [];
  let fields: i32[] = [];
  for v in ins.args {
    let root: i32 = 0 - 1;
    let field: i32 = 0 - 1;
    let lent_param: boolean = defs[v].kind_tag == 6 && !owned[v] && occurrences(ins.args, v) == 1 && !used_after(f, a, bi, pos, v);
    if (is_array(f.values[v]) && !ssasem.is_text(f.values[v]) && occurrences(ins.args, v) == 1) {
      if (lent_param) {
        root = v;
      }
      if (defs[v].kind_tag == ssasem.record_get() && !owned[v]) {
        root = projection_root(f, a, owned, defs, bi, pos, v);
        if (root >= 0) {
          field = defs[v].imm;
        }
      }
    }
    if (is_record(f.values[v]) && !semtypes.is_env(f.values[v]) && lent_param) {
      root = v;
    }
    roots = roots.append(root);
    fields = fields.append(field);
  }
  return Step { ...s, hand_roots: roots, hand_fields: fields };
}

// choose_ids takes the dead values listed by id, each once, in any order: a
// dead owned supply moves its unit (the last one to name it), every other
// supply retains, and the other dead owned values drop, in ascending id order. A `pinned` value retains and
// drops after the operation instead of moving.
function choose_ids(s: Step, supplies: Supply[], dead: i32[], owned: boolean[], pinned: i32[]): Step {
  let moved: i32[] = [];
  let selected: Supply[] = supplies;
  let i: i32 = selected.len() - 1;
  while (i >= 0) {
    let item: Supply = selected[i];
    let mode: i32 = retain_unit();
    if (owned[item.value] && has_id(dead, item.value) && !has_id(moved, item.value) && !has_id(pinned, item.value)) {
      mode = move_unit();
      moved = moved.append(item.value);
    }
    selected = selected.with(i, Supply { ...item, mode: mode });
    i = i - 1;
  }
  let drops: i32[] = [];
  for v in dead {
    if (owned[v] && !has_id(moved, v)) {
      drops = insert_sorted(drops, v);
    }
  }
  return Step { ...s, supplies: selected, drops: drops };
}

function has_id(xs: i32[], v: i32): boolean {
  for x in xs {
    if (x == v) {
      return true;
    }
  }
  return false;
}

function insert_sorted(own xs: i32[], v: i32): i32[] {
  xs = xs.append(v);
  let i: i32 = xs.len() - 1;
  while (i > 0 && xs[i - 1] > v) {
    xs = xs.with(i, xs[i - 1]);
    i = i - 1;
  }
  return xs.with(i, v);
}

pub function plan(f: ssasem.Func, modes: i32[], view: SchemaView): Plan {
  return plan_analyzed(f, modes, ssasem.analyze(f), view);
}

// plan over an analysis the caller already holds of this very `f`.
pub function plan_analyzed(f: ssasem.Func, modes: i32[], semantic: ssasem.Analysis, view: SchemaView): Plan {
  if (!semantic.ok) {
    return bad(semantic.why);
  }
  let analysis: ssasem.Analysis = semantic;
  let why: string = contract_error(f, modes, view);
  if (why != "") {
    return bad(why);
  }
  let defs: ssa.SInst[] = definitions(f);
  let owned: boolean[] = owned_values(f, modes, defs);
  let reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
  let units: Units = units_of(f, owned, analysis, defs);
  owned = units.owned;
  let takes: i32[] = units.takes;
  analysis = units_analysis(f, analysis, units);
  if (!analysis.ok) {
    return bad(analysis.why);
  }
  let grows: i32[] = [];
  let grow_fields: i32[] = [];
  // Per append or with result: whether its receiver is read after it, by
  // this block or on the way out, directly or through a dependent.
  let kept: boolean[] = analysis.flow.none;
  // Per parameter: whether an edge carries it into a phi while it, or a
  // value depending on it, is still live in the target.
  let entry_kept: boolean[] = analysis.flow.none;
  let vi0: i32 = 0;
  while (vi0 < f.graph.nvals) {
    grows = grows.append(0 - 1);
    grow_fields = grow_fields.append(0 - 1);
    vi0 = vi0 + 1;
  }
  let steps: Step[] = [];
  // One row for every block: each block sets the values it marks live in
  // `touched`, and clears them again once its steps are chosen.
  let live: boolean[] = analysis.flow.none;
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    if (reachable[bi]) {
      let term_uses: i32[] = [];
      if (b.term.kind_tag == 1) {
        term_uses = use_ids(b.term.value, analysis.dependencies);
      }
      if (b.term.kind_tag == 3) {
        term_uses = use_ids(b.term.cond, analysis.dependencies);
      }
      let touched: i32[] = ssalive.live_out_ids(analysis.flow, bi);
      for v in term_uses {
        touched = touched.append(v);
      }
      for v in touched {
        live = live.with(v, true);
      }
      let pos: i32 = b.insts.len() - 1;
      while (pos >= 0) {
        let ins: ssa.SInst = b.insts[pos];
        if (ins.kind_tag != 6 && ins.kind_tag != 8) {
          let dead: i32[] = [];
          if ((ins.kind_tag == ssasem.append() || ins.kind_tag == ssasem.with()) && live[ins.args[0]]) {
            kept = kept.with(ins.result, true);
          }
          if (owned[ins.result] && !live[ins.result]) {
            dead = dead.append(ins.result);
          }
          live = live.with(ins.result, false);
          for arg in ins.args {
            if (arg >= 0) {
              if (!live[arg]) {
                dead = dead.append(arg);
                live = live.with(arg, true);
                touched = touched.append(arg);
              }
              for dep in analysis.dependencies[arg] {
                if (!live[dep]) {
                  dead = dead.append(dep);
                  live = live.with(dep, true);
                  touched = touched.append(dep);
                }
              }
            }
          }
          steps = steps.append(steals(f, analysis, owned, defs, bi, pos, hands(f, analysis, owned, defs, bi, pos, choose_ids(step(b.id, pos, 0 - 1), operation_supplies(f, ins), dead, owned, lent_owners(f, ins, analysis.dependencies)))));
          let root: i32 = field_grow_root(f, analysis, owned, defs, bi, pos);
          if (root >= 0) {
            grows = grows.with(ins.result, root);
            grow_fields = grow_fields.with(ins.result, defs[ins.args[0]].imm);
          }
        }
        pos = pos - 1;
      }
      let entry_dead: i32[] = [];
      for ins in b.insts {
        if ((ins.kind_tag == 6 || ins.kind_tag == 8) && owned[ins.result] && !live[ins.result]) {
          entry_dead = entry_dead.append(ins.result);
        }
      }
      for v in touched {
        live = live.with(v, false);
      }
      steps = steps.append(choose_ids(step(b.id, entry_point(), 0 - 1), [], entry_dead, owned, []));
      if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
        steps = steps.append(choose_ids(step(b.id, return_point(), 0 - 1), return_supplies(f, b), term_uses, owned, []));
      }
      for target in successors(b) {
        let si: i32 = ssalive.position(analysis.flow, target);
        entry_kept = entry_kept_of(f, analysis, b, si, entry_kept);
        let dead: i32[] = ssalive.out_not_in(analysis.flow, bi, si);
        steps = steps.append(choose_ids(step(b.id, edge_point(), target), edge_supplies(f, b, si, owned), dead, owned, []));
      }
    }
    bi = bi + 1;
  }
  let literal: boolean[] = literals(f);
  why = view_retain_error(f, steps, literal, defs);
  if (why != "") {
    return bad(why);
  }
  let consts: string[] = constants(f, defs);
  return Plan { ok: true, why: "", steps: steps, owned: owned, literal: literal, grows: grows, grow_fields: grow_fields, takes: takes, held: units.held, payloads: units.payloads, kept: kept, entry_kept: entry_kept, frame_views: frame_views(f, defs), constants: consts, text_lens: text_lens(f), analysis: semantic, defs: defs, modes: modes, unit_analysis: analysis, unique_receivers: unique_receivers(f, steps, consts, no_fresh()), fresh_seeded: false, checked_writes: checked_writes(f) };
}

// checked_writes marks, at a `with`'s result, a `with` whose index an element
// read earlier in the same block already checked against the same receiver.
function checked_writes(f: ssasem.Func): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    let i: i32 = 0;
    while (i < b.insts.len()) {
      let ins: ssa.SInst = b.insts[i];
      if (ins.kind_tag == ssasem.with() && read_before(b, i, ins.args[0], ins.args[1])) {
        out = out.with(ins.result, true);
      }
      i = i + 1;
    }
  }
  return out;
}

function read_before(b: ssa.SBlock, end: i32, arr: i32, index: i32): boolean {
  let j: i32 = 0;
  while (j < end) {
    let r: ssa.SInst = b.insts[j];
    if (r.kind_tag == ssasem.array_get() && r.args.len() == 2 && r.args[0] == arr && r.args[1] == index) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

// unique_receivers marks, at a `with`'s or an `append`'s result, one whose
// receiver needs no uniqueness test: the receiver is moved into it and is
// `sole`. `fresh` is the module's rows whose result is sole (`fresh_rows`).
function unique_receivers(f: ssasem.Func, steps: Step[], consts: string[], fresh: FreshRows): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let sole: boolean[] = sole_boxes(f, steps, consts, fresh, 0 - 1);
  let at: i32[] = ssa.block_positions(f.graph);
  for st in steps {
    if (st.point >= 0) {
      let ins: ssa.SInst = f.graph.blocks[at[st.block]].insts[st.point];
      if (box_update(ins) && sole[ins.args[0]] && moved_at(st, ins.args[0], 0)) {
        out = out.with(ins.result, true);
      }
    }
  }
  return out;
}

// FreshRows names the rows of a module whose result is a sole box: always
// where `through` is -1, and where it is a parameter's index, whenever the
// argument there arrives sole and moved, as an `append`'s receiver does.
// `through` follows `rows.names`.
pub struct FreshRows { rows: util.NameIndex, through: i32[] }

pub function no_fresh(): FreshRows {
  let none: string[] = [];
  return FreshRows { rows: util.name_index(none), through: [] };
}

// fresh_through is `name`'s entry in `fresh`, or -2 for a row it does not name.
function fresh_through(fresh: FreshRows, name: string): i32 {
  let i: i32 = fresh.rows.find(name);
  if (i < 0) {
    return 0 - 2;
  }
  return fresh.through[i];
}

// fresh_rows is the module's FreshRows. A row joins once its returns are sole
// with the rows already named as seeds, first with no assumption and then
// with one owned array parameter assumed sole, so a helper built on another
// joins a round later, and recursion, which never starts sole, adds nothing.
pub function fresh_rows(keys: string[], funcs: ssasem.Func[], plans: Plan[]): FreshRows {
  let fresh: FreshRows = no_fresh();
  let named: boolean[] = __alloc_bool(keys.len());
  let check: boolean[] = __alloc_bool(keys.len());
  let i: i32 = 0;
  while (i < keys.len()) {
    check = check.with(i, plans[i].ok && returns_arrays(funcs[i]));
    i = i + 1;
  }
  let grew: boolean = true;
  while (grew) {
    grew = false;
    let added: string[] = [];
    i = 0;
    while (i < keys.len()) {
      if (check[i] && !named[i]) {
        let through: i32 = sole_result(funcs[i], plans[i], fresh);
        if (through >= 0 - 1) {
          named = named.with(i, true);
          fresh = FreshRows { rows: fresh.rows.added(keys[i]), through: fresh.through.append(through) };
          added = added.append(keys[i]);
          grew = true;
        }
      }
      i = i + 1;
    }
    // A row can only join a later round through a call to one just named.
    let ix: util.NameIndex = util.name_index(added);
    i = 0;
    while (grew && i < keys.len()) {
      check = check.with(i, check[i] && !named[i] && calls_any(funcs[i], ix));
      i = i + 1;
    }
  }
  return fresh;
}

// sole_result is -1 when every return of `f`, which returns arrays, is sole,
// else the first owned array parameter whose arriving sole makes them so,
// else -2.
function sole_result(f: ssasem.Func, p: Plan, fresh: FreshRows): i32 {
  if (returns_sole(f, sole_boxes(f, p.steps, p.constants, fresh, 0 - 1))) {
    return 0 - 1;
  }
  let k: i32 = 0;
  while (k < f.graph.nparams) {
    if (is_array(f.values[k]) && p.modes[k] == counted_mode() && returns_sole(f, sole_boxes(f, p.steps, p.constants, fresh, k))) {
      return k;
    }
    k = k + 1;
  }
  return 0 - 2;
}

function returns_arrays(f: ssasem.Func): boolean {
  let returns: i32 = 0;
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1) {
      if (b.term.value < 0 || !is_array(f.values[b.term.value])) {
        return false;
      }
      returns = returns + 1;
    }
  }
  return returns > 0;
}

function returns_sole(f: ssasem.Func, sole: boolean[]): boolean {
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1 && !sole[b.term.value]) {
      return false;
    }
  }
  return true;
}

// with_fresh is `p` with its receivers proved again under the module's fresh
// rows, for a row that calls one or whose receivers counted one before.
pub function with_fresh(p: Plan, f: ssasem.Func, fresh: FreshRows): Plan {
  if (!p.ok) {
    return p;
  }
  let seeded: boolean = calls_any(f, fresh.rows);
  if (!seeded && !p.fresh_seeded) {
    return p;
  }
  return Plan { ...p, unique_receivers: unique_receivers(f, p.steps, p.constants, fresh), fresh_seeded: seeded };
}

function calls_any(f: ssasem.Func, names: util.NameIndex): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call() && names.has(ins.str)) {
        return true;
      }
    }
  }
  return false;
}

// Whether two FreshRows say the same thing about `callees`, the names one
// body calls: its receivers read them only through those.
pub function fresh_rows_agree(a: FreshRows, b: FreshRows, callees: string[]): boolean {
  for callee in callees {
    if (fresh_through(a, callee) != fresh_through(b, callee)) {
      return false;
    }
  }
  return true;
}

function box_update(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssasem.with() || ins.kind_tag == ssasem.append();
}

// moved_at says the step moves `v` into the operand at `slot`: its last use.
function moved_at(st: Step, v: i32, slot: i32): boolean {
  for supply in st.supplies {
    if (supply.slot == slot && supply.value == v) {
      return supply.mode == move_unit();
    }
  }
  return false;
}

// passed_slot is the operand whose box an operation hands on as its result
// when that operand arrives sole and moved: an `append`'s receiver, or a
// fresh row's owned parameter. -1 for any other operation.
function passed_slot(ins: ssa.SInst, fresh: FreshRows): i32 {
  if (ins.kind_tag == ssasem.append()) {
    return 0;
  }
  if (ins.kind_tag == ssasem.call() && fresh.through.len() > 0) {
    let through: i32 = fresh_through(fresh, ins.str);
    if (through >= 0) {
      return through;
    }
  }
  return 0 - 1;
}

// sole_boxes marks the values whose box no unit but the frame's own one ever
// holds. A box starts that way when a `with` hands it back, a fresh or empty
// array is made, or a fresh row returns it; an operation that passes a box on
// (`passed_slot`) keeps it when the box arrives sole and moved, and a phi
// keeps it when every operand does. It stops at any unit retained on it, and
// at any use that could hand it to another holder while the frame still reads
// it: everything but reading an element or the length, flowing into a phi
// that keeps it, being returned, and a use that moves it, which is its last.
// `seed` is a parameter to assume sole, or -1.
//
// An empty constant is shared, but no write lands in it: a `with` on it fails
// its bounds check, and a push onto it, having no room, copies.
function sole_boxes(f: ssasem.Func, steps: Step[], consts: string[], fresh: FreshRows, seed: i32): boolean[] {
  let sole: boolean[] = __alloc_bool(f.graph.nvals);
  if (seed >= 0) {
    sole = sole.with(seed, true);
  }
  // pass[v] is the operand slot the operation defining v hands its box on
  // from, or -1. The links are what the fixpoint below settles: a pass link
  // from operand to result, and a phi link between operand and phi.
  let pass: i32[] = util.minus_ones(f.graph.nvals);
  let links: SoleLinks = SoleLinks { from: [], to: [], phi: [] };
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result < 0) {
        continue;
      }
      let k: i32 = passed_slot(ins, fresh);
      if (k >= 0) {
        pass = pass.with(ins.result, k);
        links = SoleLinks { from: links.from.append(ins.args[k]), to: links.to.append(ins.result), phi: links.phi.append(false) };
      }
      if (ins.kind_tag == 8) {
        for a in ins.args {
          if (a >= 0) {
            links = SoleLinks { from: links.from.append(a), to: links.to.append(ins.result), phi: links.phi.append(true) };
          }
        }
      }
      if (ins.kind_tag == 8 || ins.kind_tag == ssasem.with() || k >= 0 || fresh_array(ins, consts, fresh)) {
        sole = sole.with(ins.result, true);
      }
    }
  }
  let at: i32[] = ssa.block_positions(f.graph);
  for st in steps {
    for supply in st.supplies {
      if (supply.value >= 0 && supply.mode != move_unit()) {
        sole = sole.with(supply.value, false);
      }
    }
    if (st.point >= 0) {
      let ins: ssa.SInst = f.graph.blocks[at[st.block]].insts[st.point];
      let i: i32 = 0;
      while (i < ins.args.len()) {
        let a: i32 = ins.args[i];
        let reads: boolean = i == 0 && (ins.kind_tag == ssasem.array_get() || ins.kind_tag == ssasem.length());
        if (a >= 0 && !reads && !moved_at(st, a, i)) {
          sole = sole.with(a, false);
        }
        i = i + 1;
      }
      if (ins.result >= 0 && pass[ins.result] >= 0 && !moved_at(st, ins.args[pass[ins.result]], pass[ins.result])) {
        sole = sole.with(ins.result, false);
      }
    }
  }
  return settled(sole, links);
}

struct SoleLinks { from: i32[], to: i32[], phi: boolean[] }

// settled clears, until nothing changes, a pass result whose operand is not
// sole, and both ends of a phi link that disagree.
function settled(own sole: boolean[], links: SoleLinks): boolean[] {
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < links.from.len()) {
      let a: i32 = links.from[i];
      let v: i32 = links.to[i];
      if (links.phi[i] && sole[a] != sole[v]) {
        sole = sole.with(a, false).with(v, false);
        changed = true;
      } else if (!links.phi[i] && sole[v] && !sole[a]) {
        sole = sole.with(v, false);
        changed = true;
      }
      i = i + 1;
    }
  }
  return sole;
}

// fresh_array is an array no other holder can have seen: a zero-filled or
// reserved allocation, a literal built at run time, an empty one, or a fresh
// row's result.
function fresh_array(ins: ssa.SInst, consts: string[], fresh: FreshRows): boolean {
  if (ins.kind_tag == ssasem.array_new()) {
    return ins.args.len() == 0 || consts[ins.result] == "";
  }
  if (ins.kind_tag == ssasem.call()) {
    return ins.str == "__alloc_i32" || ins.str == "__alloc_i64" || ins.str == "__alloc_bool" || ins.str == "__alloc_u8" || fresh_through(fresh, ins.str) == 0 - 1;
  }
  return ins.kind_tag == ssasem.array_reserve();
}

function entry_kept_of(f: ssasem.Func, a: ssasem.Analysis, b: ssa.SBlock, si: i32, own out: boolean[]): boolean[] {
  let succ: ssa.SBlock = f.graph.blocks[si];
  let pi: i32 = 0;
  while (succ.preds[pi] != b.id) {
    pi = pi + 1;
  }
  for ins in succ.insts {
    if (ins.kind_tag != 8) {
      continue;
    }
    let v: i32 = ins.args[pi];
    if (v >= 0 && v < f.graph.nparams && ssalive.live_in_has(a.flow, si, v)) {
      out = out.with(v, true);
    }
  }
  return out;
}

function read_error(state: boolean[], value: i32, owned: boolean[], deps: i32[][]): string {
  if (value < 0) {
    return "";
  }
  if (owned[value] && !state[value]) {
    return "read without counted unit";
  }
  for dep in deps[value] {
    if (owned[dep] && !state[dep]) {
      return "borrow outlives container unit";
    }
  }
  return "";
}

function invariant(f: ssasem.Func, bi: i32, owned: boolean[], flow: ssalive.Flow): boolean[] {
  let state: boolean[] = flow.none;
  for v in ssalive.live_in_ids(flow, bi) {
    if (owned[v]) {
      state = state.with(v, true);
    }
  }
  for ins in f.graph.blocks[bi].insts {
    if ((ins.kind_tag == 8 || ins.kind_tag == 6) && owned[ins.result]) {
      state = state.with(ins.result, true);
    }
  }
  return state;
}

// holds_invariant is same_bits(state, invariant(f, bi, owned, flow)) without
// building the invariant.
function holds_invariant(state: boolean[], f: ssasem.Func, bi: i32, owned: boolean[], flow: ssalive.Flow): boolean {
  let want: i32 = 0;
  for v in ssalive.live_in_ids(flow, bi) {
    if (owned[v]) {
      if (!state[v]) {
        return false;
      }
      want = want + 1;
    }
  }
  for ins in f.graph.blocks[bi].insts {
    if ((ins.kind_tag == 8 || ins.kind_tag == 6) && owned[ins.result] && !ssalive.live_in_has(flow, bi, ins.result)) {
      if (!state[ins.result]) {
        return false;
      }
      want = want + 1;
    }
  }
  let have: i32 = 0;
  for bit in state {
    if (bit) {
      have = have + 1;
    }
  }
  return have == want;
}

function same_bits(a: boolean[], b: boolean[]): boolean {
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// step_index lists, for each block id, the positions of the plan's steps at
// that block, so a lookup scans one block's steps rather than the whole plan.
pub function step_index(p: Plan): i32[][] {
  let top: i32 = 0 - 1;
  for s in p.steps {
    if (s.block > top) {
      top = s.block;
    }
  }
  let out: i32[][] = [];
  let i: i32 = 0;
  while (i <= top) {
    out = out.append([]);
    i = i + 1;
  }
  i = 0;
  while (i < p.steps.len()) {
    let b: i32 = p.steps[i].block;
    if (b >= 0) {
      out = out.with(b, out[b].append(i));
    }
    i = i + 1;
  }
  return out;
}

// step_at is the first step at (block, point, target), or -1.
pub function step_at(p: Plan, idx: i32[][], block: i32, point: i32, target: i32): i32 {
  if (block < 0 || block >= idx.len()) {
    return 0 - 1;
  }
  for i in idx[block] {
    if (p.steps[i].point == point && p.steps[i].target == target) {
      return i;
    }
  }
  return 0 - 1;
}

// find_step is the one step at (block, point, target), or -1 when there is
// none or more than one.
function find_step(p: Plan, idx: i32[][], block: i32, point: i32, target: i32): i32 {
  if (block < 0 || block >= idx.len()) {
    return 0 - 1;
  }
  let found: i32 = 0 - 1;
  for i in idx[block] {
    let s: Step = p.steps[i];
    if (s.point == point && s.target == target) {
      if (found >= 0) {
        return 0 - 1;
      }
      found = i;
    }
  }
  return found;
}

// Acquisitions observe the original state: a later move in the same step
// must not invalidate an earlier retain of the same value.
function supply_error(state: boolean[], supplies: Supply[], wanted: Supply[], owned: boolean[], deps: i32[][]): string {
  if (supplies.len() != wanted.len()) {
    return "unit supply arity";
  }
  let i: i32 = 0;
  while (i < wanted.len()) {
    let got: Supply = supplies[i];
    if (got.value != wanted[i].value || got.slot != wanted[i].slot) {
      return "unit supply identity or slot";
    }
    let why: string = read_error(state, got.value, owned, deps);
    if (why != "") {
      return why;
    }
    if (got.mode != retain_unit() && got.mode != move_unit() && got.mode != steal_unit()) {
      return "invalid unit supply mode";
    }
    i = i + 1;
  }
  return "";
}

// A step is checked on the row it reads and then applied to the row it
// owns: replay_error reports every rejection without writing, apply_step
// writes the moves, the result and the drops in place. The row flows between
// them as a plain value, never through a record field, which the owned
// parameter needs.
function replay_error(state: boolean[], s: Step, wanted: Supply[], result: i32, owned: boolean[], deps: i32[][]): string {
  let why: string = supply_error(state, s.supplies, wanted, owned, deps);
  if (why != "") {
    return why;
  }
  let cleared: i32[] = [];
  for got in s.supplies {
    if (got.mode == move_unit()) {
      if (!owned[got.value] || !state[got.value] || util.index_of_i32(cleared, got.value) >= 0) {
        return "move without counted unit";
      }
      cleared = cleared.append(got.value);
    }
  }
  let set_result: boolean = false;
  if (result >= 0 && owned[result]) {
    if (state[result] && util.index_of_i32(cleared, result) < 0) {
      return "result unit already present";
    }
    set_result = true;
  }
  let dropped: i32[] = [];
  for value in s.drops {
    if (value < 0 || value >= owned.len()) {
      return "drop value out of range";
    }
    let present: boolean = state[value] && util.index_of_i32(cleared, value) < 0 || set_result && value == result;
    if (!owned[value] || !present || util.index_of_i32(dropped, value) >= 0) {
      return "drop without counted unit";
    }
    dropped = dropped.append(value);
  }
  return "";
}

// apply_step is the row after a step replay_error accepted.
function apply_step(own state: boolean[], s: Step, result: i32, owned: boolean[]): boolean[] {
  for got in s.supplies {
    if (got.mode == move_unit()) {
      state = state.with(got.value, false);
    }
  }
  if (result >= 0 && owned[result]) {
    state = state.with(result, true);
  }
  for value in s.drops {
    state = state.with(value, false);
  }
  return state;
}

// copy_row is a fresh row with `state`'s bits. The receiver is lent, so the
// write reaches it by retaining and the runtime copies rather than mutates.
function copy_row(state: boolean[]): boolean[] {
  if (state.len() == 0) {
    return state;
  }
  return state.with(0, state[0]);
}

struct ReplayProgress { why: string, state: boolean[], count: i32 }

function progress_error(why: string): ReplayProgress {
  return ReplayProgress { why: why, state: [], count: 0 };
}

// verify_operations replays the entry step and then the block's operations
// over one row it owns, so each step writes the row in place.
function verify_operations(f: ssasem.Func, b: ssa.SBlock, p: Plan, idx: i32[][], own state: boolean[], owned: boolean[], deps: i32[][]): ReplayProgress {
  let at0: i32 = find_step(p, idx, b.id, entry_point(), 0 - 1);
  if (at0 < 0) {
    return progress_error("missing or duplicate entry step");
  }
  let entry_why: string = replay_error(state, p.steps[at0], [], 0 - 1, owned, deps);
  if (entry_why != "") {
    return progress_error(entry_why);
  }
  let next: boolean[] = apply_step(state, p.steps[at0], 0 - 1, owned);
  let count: i32 = 0;
  let pos: i32 = 0;
  for ins in b.insts {
    if (ins.kind_tag != 6 && ins.kind_tag != 8) {
      for arg in ins.args {
        let why: string = read_error(next, arg, owned, deps);
        if (why != "") {
          return progress_error(why);
        }
      }
      let at: i32 = find_step(p, idx, b.id, pos, 0 - 1);
      if (at < 0) {
        return progress_error("missing or duplicate operation step");
      }
      let lent: string = lent_error(next, p.steps[at], f, ins, owned, deps);
      if (lent != "") {
        return progress_error(lent);
      }
      let why: string = replay_error(next, p.steps[at], operation_supplies(f, ins), ins.result, owned, deps);
      if (why != "") {
        return progress_error(why);
      }
      next = apply_step(next, p.steps[at], ins.result, owned);
      count = count + 1;
    }
    pos = pos + 1;
  }
  return ReplayProgress { why: "", state: next, count: count };
}

// A call's lent operand borrows from units that must outlast the call's moves.
// The units the step's moves clear are listed rather than replayed into a
// copy of the row; a move the row cannot supply is move_supplies' rejection,
// reported by the replay that follows, not here.
function lent_error(state: boolean[], s: Step, f: ssasem.Func, ins: ssa.SInst, owned: boolean[], deps: i32[][]): string {
  let cleared: i32[] = [];
  for got in s.supplies {
    if (got.mode == move_unit()) {
      if (!owned[got.value] || !state[got.value] || util.index_of_i32(cleared, got.value) >= 0) {
        return "";
      }
      cleared = cleared.append(got.value);
    }
  }
  for v in lent_operands(f, ins) {
    for dep in deps[v] {
      if (dep != v && owned[dep] && (!state[dep] || util.index_of_i32(cleared, dep) >= 0)) {
        return "a lent call operand borrows from a unit moved into the call";
      }
    }
  }
  return "";
}

// step_clears: the step moves or drops `value`.
function step_clears(s: Step, value: i32): boolean {
  for got in s.supplies {
    if (got.mode == move_unit() && got.value == value) {
      return true;
    }
  }
  return util.index_of_i32(s.drops, value) >= 0;
}

// The return step is checked without applying it: a unit it leaves counted is
// one the row holds that it neither moves nor drops.
function verify_return(f: ssasem.Func, b: ssa.SBlock, p: Plan, idx: i32[][], state: boolean[], owned: boolean[], deps: i32[][]): string {
  if (b.term.kind_tag == 1) {
    let why: string = read_error(state, b.term.value, owned, deps);
    if (why != "") {
      return why;
    }
  }
  let at: i32 = find_step(p, idx, b.id, return_point(), 0 - 1);
  if (at < 0) {
    return "missing or duplicate return step";
  }
  let why: string = replay_error(state, p.steps[at], return_supplies(f, b), 0 - 1, owned, deps);
  if (why != "") {
    return why;
  }
  let v: i32 = 0;
  while (v < state.len()) {
    if (state[v] && !step_clears(p.steps[at], v)) {
      return "counted unit leaks at return";
    }
    v = v + 1;
  }
  return "";
}

function enter_phis(b: ssa.SBlock, own state: boolean[], owned: boolean[]): Ledger {
  for ins in b.insts {
    if (ins.kind_tag == 8 && owned[ins.result]) {
      if (state[ins.result]) {
        return rejected("phi unit already present");
      }
      state = state.with(ins.result, true);
    }
  }
  return Ledger { ok: true, why: "", bits: state };
}

function verify_edge(f: ssasem.Func, b: ssa.SBlock, target: i32, p: Plan, idx: i32[][], own state: boolean[], owned: boolean[], analysis: ssasem.Analysis): string {
  let at: i32 = find_step(p, idx, b.id, edge_point(), target);
  if (at < 0) {
    return "missing or duplicate edge step";
  }
  let si: i32 = ssalive.position(analysis.flow, target);
  let why: string = replay_error(state, p.steps[at], edge_supplies(f, b, si, owned), 0 - 1, owned, analysis.dependencies);
  if (why != "") {
    return why;
  }
  let left: boolean[] = apply_step(state, p.steps[at], 0 - 1, owned);
  let entered: Ledger = enter_phis(f.graph.blocks[si], left, owned);
  if (!entered.ok) {
    return entered.why;
  }
  if (!holds_invariant(entered.bits, f, si, owned, analysis.flow)) {
    return "edge unit invariant mismatch";
  }
  return "";
}

// BlockProgress is a block's verdict: its rejection, or the number of plan
// steps it accounted for.
struct BlockProgress { why: string, count: i32 }

// The row a block's operations leave is read by the return step, copied for
// the first of two successor edges and moved into the last edge.
function verify_block(f: ssasem.Func, bi: i32, p: Plan, idx: i32[][], owned: boolean[], analysis: ssasem.Analysis): BlockProgress {
  let b: ssa.SBlock = f.graph.blocks[bi];
  let entry_row: boolean[] = invariant(f, bi, owned, analysis.flow);
  let operations: ReplayProgress = verify_operations(f, b, p, idx, entry_row, owned, analysis.dependencies);
  if (operations.why != "") {
    return BlockProgress { why: operations.why, count: 0 };
  }
  let state: boolean[] = operations.state;
  let count: i32 = 1 + operations.count;
  if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
    let why: string = verify_return(f, b, p, idx, state, owned, analysis.dependencies);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
    count = count + 1;
  }
  if (b.term.kind_tag == 3) {
    let why: string = read_error(state, b.term.cond, owned, analysis.dependencies);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
  }
  let targets: i32[] = successors(b);
  if (targets.len() == 2) {
    let first: boolean[] = copy_row(state);
    let why: string = verify_edge(f, b, targets[0], p, idx, first, owned, analysis);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
    count = count + 1;
  }
  if (targets.len() > 0) {
    let why: string = verify_edge(f, b, targets[targets.len() - 1], p, idx, state, owned, analysis);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
    count = count + 1;
  }
  return BlockProgress { why: "", count: count };
}

function same_i32s(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function verify(f: ssasem.Func, modes: i32[], p: Plan): string {
  return verify_analyzed(f, modes, p, ssasem.analyze(f), true);
}

// verify_planned checks `p` against the analysis it was planned from, for a
// caller that lowers the very `f` it planned: analyze is a function of `f`
// alone, so a second run would only repeat the first, and so is the contract
// on the values, result, schema tables and calls, which the plan's ok is the
// answer to. The modes are this call's own input and are checked.
pub function verify_planned(f: ssasem.Func, modes: i32[], p: Plan): string {
  return verify_analyzed(f, modes, p, p.analysis, false);
}

// `whole` runs the contract check on `f` as the planner did and derives the
// definitions table from `f`, for a plan that may be checked against a
// function other than the one it was planned from.
function verify_analyzed(f: ssasem.Func, modes: i32[], p: Plan, semantic: ssasem.Analysis, whole: boolean): string {
  if (!p.ok || p.why != "") {
    return "missing successful unit plan";
  }
  let analysis: ssasem.Analysis = semantic;
  if (!analysis.ok) {
    return analysis.why;
  }
  let why: string = "";
  let defs: ssa.SInst[] = p.defs;
  if (whole) {
    why = contract_error(f, modes, no_view());
    defs = definitions(f);
  } else if (modes.len() != f.params.len()) {
    why = "parameter mode dimensions";
  } else {
    why = mode_error(f.params, modes);
  }
  if (why != "") {
    return why;
  }
  // The plan's units are a function of `f`, the modes and the analysis, so
  // for the function and modes it was planned with they are its own.
  let owned: boolean[] = p.owned;
  if (whole || !same_i32s(modes, p.modes)) {
    let units: Units = units_of(f, owned_values(f, modes, defs), analysis, defs);
    owned = units.owned;
    if (!same_i32s(units.takes, p.takes)) {
      return "tuple take disagrees with the plan";
    }
    if (!same_bits(units.held, p.held)) {
      return "element hold disagrees with the plan";
    }
    if (!same_bits(units.payloads, p.payloads)) {
      return "payload take disagrees with the plan";
    }
    analysis = units_analysis(f, analysis, units);
    if (!analysis.ok) {
      return analysis.why;
    }
  } else {
    analysis = p.unit_analysis;
  }
  let reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
  let idx: i32[][] = step_index(p);
  let count: i32 = 0;
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    if (reachable[bi]) {
      let done: BlockProgress = verify_block(f, bi, p, idx, owned, analysis);
      if (done.why != "") {
        return done.why;
      }
      count = count + done.count;
    }
    bi = bi + 1;
  }
  if (count != p.steps.len()) {
    return "extra unit plan steps";
  }
  return "";
}
