import "./ir";
import "./rtbytecopy";
import "./ssa";
import "./ssasem";
import "./ssadeps";
import "./ssalive";
import "./semrecords";
import "./semtypes";
import "./typeinfo";
import "./util";
import "./optbisect";
import "std/envflag";

pub function value_mode(): i32 {
  return ssasem.value_mode();
}

pub function borrow_mode(): i32 {
  return ssasem.borrow_mode();
}

pub function counted_mode(): i32 {
  return ssasem.counted_mode();
}

pub function retain_unit(): i32 {
  return 1;
}

pub function move_unit(): i32 {
  return 2;
}

pub function steal_unit(): i32 {
  return 3;
}

pub function entry_point(): i32 {
  return 0 - 1;
}

pub function return_point(): i32 {
  return 0 - 2;
}

pub function edge_point(): i32 {
  return 0 - 3;
}

pub struct Supply { value: i32, slot: i32, mode: i32 }

pub struct Step { block: i32, point: i32, target: i32, supplies: Supply[], drops: i32[], hand_roots: i32[], hand_fields: i32[] }

pub struct Plan { ok: boolean, why: string, steps: Step[], owned: boolean[], literal: boolean[], grows: i32[], grow_fields: i32[], takes: i32[], held: boolean[], payloads: boolean[], likely: boolean[], kept: boolean[], entry_kept: boolean[], frame_views: boolean[], constants: string[], text_lens: i32[], analysis: ssasem.Analysis, defs: ssa.SInst[], modes: i32[], unit_analysis: ssasem.Analysis, unique_receivers: boolean[], fresh_seeded: boolean, checked_writes: boolean[], links: i32[], reuse: Reuse }

struct Ledger { ok: boolean, why: string, bits: boolean[] }

pub struct GrowRow { callee: string, param: i32, field: i32 }

pub struct GrowTable { rows: GrowRow[], by_callee: util.NameIndex }

pub function no_grows(): GrowTable {
  let no_names: string[] = [];
  return GrowTable { rows: [], by_callee: util.name_index(no_names) };
}

pub function grow_fields_of(t: GrowTable, callee: string, param: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = t.by_callee.chain(callee);
  while (i >= 0) {
    let row: GrowRow = t.rows[i];
    if (row.callee == callee && row.param == param && row.field >= 0) {
      out = out.append(row.field);
    }
    i = t.by_callee.next[i];
  }
  return out;
}

pub function grows_buffer(t: GrowTable, callee: string, param: i32): boolean {
  return has_row_at(t.rows, t.by_callee, callee, param, 0 - 1);
}

function has_row(rows: GrowRow[], callee: string, param: i32, field: i32): boolean {
  for row in rows {
    if (row.callee == callee && row.param == param && row.field == field) {
      return true;
    }
  }
  return false;
}

pub function grow_rows_agree(a: GrowTable, b: GrowTable, callees: string[]): boolean {
  for callee in callees {
    if (!rows_within(a, b, callee) || !rows_within(b, a, callee)) {
      return false;
    }
  }
  return true;
}

function rows_within(a: GrowTable, b: GrowTable, callee: string): boolean {
  let i: i32 = a.by_callee.chain(callee);
  while (i >= 0) {
    let row: GrowRow = a.rows[i];
    if (row.callee == callee && !has_row_at(b.rows, b.by_callee, callee, row.param, row.field)) {
      return false;
    }
    i = a.by_callee.next[i];
  }
  return true;
}

function with_row(rows: GrowRow[], callee: string, param: i32, field: i32): GrowRow[] {
  if (has_row(rows, callee, param, field)) {
    return rows;
  }
  return rows.append(GrowRow { callee: callee, param: param, field: field });
}

function has_row_at(rows: GrowRow[], ix: util.NameIndex, callee: string, param: i32, field: i32): boolean {
  let i: i32 = ix.chain(callee);
  while (i >= 0) {
    if (rows[i].callee == callee && rows[i].param == param && rows[i].field == field) {
      return true;
    }
    i = ix.next[i];
  }
  return false;
}

pub function grow_rows(callee: string, f: ssasem.Func, p: Plan, table: GrowRow[], tix: util.NameIndex): GrowRow[] {
  let out: GrowRow[] = [];
  let defs: ssa.SInst[] = p.defs;
  let at: i32[] = ssa.block_positions(f.graph);
  let seen: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (!box_update(ins)) {
        continue;
      }
      let root: i32 = ins.args[0];
      let field: i32 = 0 - 1;
      if (p.grows[ins.result] >= 0) {
        root = p.grows[ins.result];
        field = p.grow_fields[ins.result];
      }
      if (field < 0) {
        let carried: Carried = carried_params(f, defs, root, seen);
        seen = carried.seen;
        for param in carried.params {
          if (!p.owned[param]) {
            out = with_row(out, callee, defs[param].imm, 0 - 1);
          }
        }
        continue;
      }
      if (defs[root].kind_tag != 6 || p.owned[root]) {
        continue;
      }
      out = with_row(out, callee, defs[root].imm, field);
    }
  }
  let partial: GrowTable = GrowTable { rows: table, by_callee: tix };
  for s in p.steps {
    if (s.point < 0) {
      continue;
    }
    let ins: ssa.SInst = f.graph.blocks[at[s.block]].insts[s.point];
    let scan: GrowScan = dying_lent_rows(callee, f, p, defs, s, ins, table, tix, GrowScan { rows: out, seen: seen });
    out = scan.rows;
    seen = scan.seen;
    let i: i32 = 0;
    while (i < s.hand_roots.len()) {
      let root: i32 = s.hand_roots[i];
      if (root >= 0 && defs[root].kind_tag == 6 && !p.owned[root]) {
        if (is_record(f.values[root]) && s.hand_fields[i] < 0) {
          for field in grow_fields_of(partial, ins.str, i) {
            out = with_row(out, callee, defs[root].imm, field);
          }
        } else if (has_row_at(table, tix, ins.str, i, 0 - 1)) {
          out = with_row(out, callee, defs[root].imm, s.hand_fields[i]);
        }
      }
      i = i + 1;
    }
  }
  return out;
}

struct GrowScan { rows: GrowRow[], seen: boolean[] }

function dying_lent_rows(callee: string, f: ssasem.Func, p: Plan, defs: ssa.SInst[], s: Step, ins: ssa.SInst, table: GrowRow[], tix: util.NameIndex, own scan: GrowScan): GrowScan {
  if (ins.kind_tag != ssasem.call()) {
    return scan;
  }
  let out: GrowRow[] = scan.rows;
  let seen: boolean[] = scan.seen;
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let v: i32 = ins.args[i];
    if (v >= f.graph.nparams && is_array(f.values[v]) && occurrences(s.drops, v) > 0 && has_row_at(table, tix, ins.str, i, 0 - 1)) {
      let carried: Carried = carried_params(f, defs, v, seen);
      seen = carried.seen;
      for param in carried.params {
        if (!p.owned[param]) {
          out = with_row(out, callee, defs[param].imm, 0 - 1);
        }
      }
    }
    i = i + 1;
  }
  return GrowScan { rows: out, seen: seen };
}

struct Carried { params: i32[], seen: boolean[] }

function carried_params(f: ssasem.Func, defs: ssa.SInst[], v: i32, own seen: boolean[]): Carried {
  let out: i32[] = [];
  let work: i32[] = [v];
  let k: i32 = 0;
  while (k < work.len()) {
    let w: i32 = work[k];
    k = k + 1;
    if (w < 0 || seen[w]) {
      continue;
    }
    seen = seen.with(w, true);
    let d: ssa.SInst = defs[w];
    if (d.kind_tag == 6) {
      out = out.append(w);
    } else if (box_update(d)) {
      work = work.append(d.args[0]);
    } else if (d.kind_tag == 8) {
      for a in d.args {
        work = work.append(a);
      }
    } else if (d.kind_tag == ssasem.call()) {
      for a in d.args {
        if (is_array(f.values[a])) {
          work = work.append(a);
        }
      }
    }
  }
  let c: i32 = 0;
  while (c < work.len()) {
    if (work[c] >= 0) {
      seen = seen.with(work[c], false);
    }
    c = c + 1;
  }
  return Carried { params: out, seen: seen };
}

pub function grow_table(keys: string[], funcs: ssasem.Func[], plans: Plan[]): GrowTable {
  let table: GrowRow[] = [];
  let no_names: string[] = [];
  let tix: util.NameIndex = util.name_index(no_names);
  let kix: util.NameIndex = util.name_index(keys);
  let callers: i32[][] = plan_callers(kix, funcs, plans);
  let dirty: boolean[] = [];
  while (dirty.len() < plans.len()) {
    dirty = dirty.append(true);
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < plans.len()) {
      if (plans[i].ok && dirty[i]) {
        dirty = dirty.with(i, false);
        for row in grow_rows(keys[i], funcs[i], plans[i], table, tix) {
          if (!has_row_at(table, tix, row.callee, row.param, row.field)) {
            table = table.append(row);
            tix = tix.added(row.callee);
            changed = true;
            let at: i32 = kix.find(row.callee);
            if (at >= 0) {
              for c in callers[at] {
                dirty = dirty.with(c, true);
              }
            }
          }
        }
      }
      i = i + 1;
    }
  }
  for row in dispatched_rows(funcs, plans, table, tix) {
    if (!has_row_at(table, tix, row.callee, row.param, row.field)) {
      table = table.append(row);
      tix = tix.added(row.callee);
    }
  }
  return GrowTable { rows: table, by_callee: tix };
}

pub function indirect_callee(): string {
  return "&";
}

pub function grow_callees(f: ssasem.Func): string[] {
  let out: string[] = ssasem.called_names(f);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call_value()) {
        return out.append(indirect_callee());
      }
    }
  }
  return out;
}

function dispatched_rows(funcs: ssasem.Func[], plans: Plan[], table: GrowRow[], tix: util.NameIndex): GrowRow[] {
  let out: GrowRow[] = [];
  let i: i32 = 0;
  while (i < plans.len()) {
    if (plans[i].ok) {
      for b in funcs[i].graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.closure_new()) {
            out = rows_as(out, table, tix, ins.str, indirect_callee(), 1);
          } else if (ins.kind_tag == ssasem.call() && ssasem.is_dyn_call(ins.str)) {
            for arm in ssasem.dyn_call_arms(ins.str) {
              out = rows_as(out, table, tix, arm, ins.str, 0);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function rows_as(own out: GrowRow[], table: GrowRow[], tix: util.NameIndex, body: string, name: string, first: i32): GrowRow[] {
  let k: i32 = tix.chain(body);
  while (k >= 0) {
    if (table[k].callee == body && table[k].param >= first) {
      out = with_row(out, name, table[k].param, 0 - 1);
    }
    k = tix.next[k];
  }
  return out;
}

function plan_callers(kix: util.NameIndex, funcs: ssasem.Func[], plans: Plan[]): i32[][] {
  let out: i32[][] = [];
  while (out.len() < plans.len()) {
    out = out.append([]);
  }
  let i: i32 = 0;
  while (i < plans.len()) {
    if (plans[i].ok) {
      let at: i32[] = ssa.block_positions(funcs[i].graph);
      for s in plans[i].steps {
        if (s.point >= 0) {
          let j: i32 = kix.find(funcs[i].graph.blocks[at[s.block]].insts[s.point].str);
          if (j >= 0 && (out[j].len() == 0 || out[j][out[j].len() - 1] != i)) {
            out = out.with(j, out[j].append(i));
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function bad(why: string): Plan {
  return Plan { ok: false, why: why, steps: [], owned: [], literal: [], grows: [], grow_fields: [], takes: [], held: [], payloads: [], likely: [], kept: [], entry_kept: [], frame_views: [], constants: [], text_lens: [], analysis: ssasem.refused_analysis(why), defs: [], modes: [], unit_analysis: ssasem.refused_analysis(why), unique_receivers: [], fresh_seeded: false, checked_writes: [], links: [], reuse: no_reuse() };
}

pub function refused(why: string): Plan {
  return bad(why);
}

function rejected(why: string): Ledger {
  return Ledger { ok: false, why: why, bits: [] };
}

function step(block: i32, point: i32, target: i32): Step {
  return Step { block: block, point: point, target: target, supplies: [], drops: [], hand_roots: [], hand_fields: [] };
}

function successors(b: ssa.SBlock): i32[] {
  if (b.term.kind_tag == 2) {
    return [b.term.target];
  }
  if (b.term.kind_tag == 3) {
    if (b.term.t == b.term.f) {
      return [b.term.t];
    }
    return [b.term.t, b.term.f];
  }
  return [];
}

function unit_free(t: typeinfo.Type): boolean {
  if (semtypes.is_never(t) || ssasem.is_lanes(t)) {
    return true;
  }
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  if let typeinfo.TypeFloat(_) = t {
    return true;
  }
  if let typeinfo.TypeVoid(_) = t {
    return true;
  }
  return semtypes.is_handle(t);
}

function supported(t: typeinfo.Type, f: ssasem.Func): boolean {
  return unit_shape(t, f, true);
}

pub function has_nominal(t: typeinfo.Type, f: ssasem.Func): boolean {
  if let typeinfo.TypeStruct(_) = t {
    return semrecords.find(f.records, t) >= 0;
  }
  return semrecords.find_enum(f.enums, t) >= 0;
}

pub function nominal(t: typeinfo.Type, f: ssasem.Func, lookup: boolean): boolean {
  return !lookup || has_nominal(t, f);
}

function unit_shape(t: typeinfo.Type, f: ssasem.Func, lookup: boolean): boolean {
  if (unit_free(t)) {
    return true;
  }
  if let typeinfo.TypeString(_) = t {
    return true;
  }
  if let typeinfo.TypeFunc(_) = t {
    return true;
  }
  if let typeinfo.TypeDyn(_) = t {
    return true;
  }

  if let typeinfo.TypeArray(a) = t {
    return unit_shape(a.elem, f, lookup);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (!unit_shape(e, f, lookup)) {
        return false;
      }
    }
    return true;
  }
  if (semtypes.is_cell(t)) {
    return unit_shape(semtypes.cell_elem(t), f, lookup);
  }
  if (ssasem.is_map(t)) {
    if (!ssasem.is_supported_map(t)) {
      return false;
    }
    if (ssasem.keyed_map_key(ssasem.map_key(t)) && !unit_shape(ssasem.map_key(t), f, lookup)) {
      return false;
    }
    return !ssasem.boxed_map_value(ssasem.map_value(t)) || unit_shape(ssasem.map_value(t), f, lookup);
  }
  if let typeinfo.TypeStruct(_) = t {
    return nominal(t, f, lookup);
  }
  if let typeinfo.TypeUnion(_) = t {
    return nominal(t, f, lookup);
  }
  return false;
}

function mode_error(params: typeinfo.Type[], modes: i32[]): string {
  let i: i32 = 0;
  while (i < modes.len()) {
    if (ssasem.reference(params[i])) {
      if (modes[i] != borrow_mode() && modes[i] != counted_mode()) {
        return "reference parameter mode";
      }
    } else if (modes[i] != value_mode()) {
      return "scalar parameter mode";
    }
    i = i + 1;
  }
  return "";
}

function call_contract_error(c: ssasem.Contract, f: ssasem.Func): string {
  for t in c.params {
    if (!supported(t, f)) {
      return "unsupported counted-unit call parameter";
    }
  }
  if (!supported(c.result, f)) {
    return "unsupported counted-unit call result";
  }
  return mode_error(c.params, c.modes);
}

pub struct SchemaView { rec_unit: boolean[], rec_walk: boolean[], enum_unit: boolean[], enum_walk: boolean[] }

pub function no_view(): SchemaView {
  let none: boolean[] = [];
  return SchemaView { rec_unit: none, rec_walk: none, enum_unit: none, enum_walk: none };
}

pub function view_fits(v: SchemaView, f: ssasem.Func): boolean {
  return v.rec_unit.len() == f.records.list.len() && v.enum_unit.len() == f.enums.len();
}

pub function record_unit(r: semrecords.Record, f: ssasem.Func): boolean {
  for field in r.fields {
    if (!unit_shape(field.ty, f, false)) {
      return false;
    }
  }
  return true;
}

pub function enum_unit(e: semrecords.Enum, f: ssasem.Func): boolean {
  for vr in e.variants {
    if (!semrecords.inhabited(vr)) {
      continue;
    }
    for field in vr.fields {
      if (!unit_shape(field.ty, f, false)) {
        return false;
      }
    }
  }
  return true;
}

function schema_fields_error(f: ssasem.Func, view: SchemaView): string {
  let fits: boolean = view_fits(view, f);
  let i: i32 = 0;
  while (i < f.records.list.len()) {
    let ok: boolean = false;
    if (fits) {
      ok = view.rec_unit[i];
    } else {
      ok = record_unit(f.records.list[i], f);
    }
    if (!ok) {
      return "unsupported counted record field";
    }
    i = i + 1;
  }
  i = 0;
  while (i < f.enums.len()) {
    let ok: boolean = false;
    if (fits) {
      ok = view.enum_unit[i];
    } else {
      ok = enum_unit(f.enums[i], f);
    }
    if (!ok) {
      return "unsupported counted variant field";
    }
    i = i + 1;
  }
  return "";
}

function closure_body_error(f: ssasem.Func, ins: ssa.SInst): string {
  let c: ssasem.Contract = f.calls[ssasem.find_contract_in(f.calls, ins.str)];
  if (c.modes.len() > 0 && c.modes[0] == counted_mode()) {
    return "function value consumes its environment";
  }
  return "";
}

function function_ops_error(f: ssasem.Func): string {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.closure_new()) {
        let why: string = closure_body_error(f, ins);
        if (why != "") {
          return why;
        }
      }
    }
  }
  return "";
}

function contract_error(f: ssasem.Func, modes: i32[], view: SchemaView): string {
  if (modes.len() != f.params.len()) {
    return "parameter mode dimensions";
  }
  for t in f.values {
    if (!supported(t, f)) {
      return "unsupported counted-unit type";
    }
  }
  if (!supported(f.result, f)) {
    return "unsupported counted-unit result";
  }
  let why: string = schema_fields_error(f, view);
  if (why != "") {
    return why;
  }
  for c in f.calls {
    why = call_contract_error(c, f);
    if (why != "") {
      return why;
    }
  }
  why = function_ops_error(f);
  if (why != "") {
    return why;
  }
  return mode_error(f.params, modes);
}

function construction(kind: i32): boolean {
  return kind == ssasem.array_new() || kind == ssasem.bytes_new() || kind == ssasem.array_reserve() || kind == ssasem.tuple_new() || kind == ssasem.record_new() || kind == ssasem.variant_new() || kind == ssasem.dyn_box()
    || kind == ssasem.closure_new() || kind == ssasem.cell_new() || kind == ssasem.map_new()
    || kind == ssasem.map_cleared();
}

function taken(t: typeinfo.Type): boolean {
  return ssasem.reference(t);
}

function fresh_unit(kind: i32): boolean {
  return kind == 8 || kind == 9 || kind == ssasem.append_range() || kind == ssasem.zero() || construction(kind) || hands_out(kind);
}

function hands_out(kind: i32): boolean {
  return kind == ssasem.call() || kind == ssasem.call_value() || kind == ssasem.closure_new()
    || kind == ssasem.append() || kind == ssasem.with() || kind == ssasem.slice() || kind == ssasem.cell_get()
    || kind == ssasem.map_insert() || kind == ssasem.map_get_or() || kind == ssasem.map_get()
    || kind == ssasem.map_keys() || kind == ssasem.map_values() || kind == ssasem.map_delete()
    || kind == ssasem.str_bytes() || kind == ssasem.str_byte_view() || ssasem.is_arr_helper_op(kind) || kind == ssasem.arr_slice()
    || kind == ssasem.hole_fill();
}

function literals(f: ssasem.Func): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 5 || ins.kind_tag == 8) {
        out = out.with(ins.result, true);
      }
    }
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag != 8 || !out[ins.result]) {
          continue;
        }
        let lit: boolean = true;
        for a in ins.args {
          if (a < 0 || !out[a]) {
            lit = false;
          }
        }
        if (!lit) {
          out = out.with(ins.result, false);
          changed = true;
        }
      }
    }
  }
  return out;
}

function owned_values(f: ssasem.Func, modes: i32[], defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      let owns: boolean = false;
      if (ins.kind_tag == 6) {
        owns = modes[ins.imm] == counted_mode();
      }
      if (ins.kind_tag != 8 && fresh_unit(ins.kind_tag)) {
        owns = ssasem.reference(f.values[ins.result]);
      }
      out = out.with(ins.result, owns);
    }
  }
  return phi_ownership(f, out, defs);
}

function phi_ownership(f: ssasem.Func, owned: boolean[], defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = owned;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag != 8 || !ssasem.reference(f.values[ins.result])) {
        continue;
      }
      let lent: boolean = true;
      for a in ins.args {
        if (a < 0) {
          continue;
        }
        let r: i32 = lent_root(f, defs, a);
        if (defs[r].kind_tag == 8 || defs[r].kind_tag == 5) {
          continue;
        }
        if (defs[r].kind_tag == 6 && !out[r]) {
          continue;
        }
        lent = false;
      }
      if (!lent) {
        out = out.with(ins.result, true);
      }
    }
  }
  let grown: boolean = true;
  while (grown) {
    grown = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag != 8 || out[ins.result] || !ssasem.reference(f.values[ins.result])) {
          continue;
        }
        for a in ins.args {
          if (a >= 0 && out[lent_root(f, defs, a)]) {
            out = out.with(ins.result, true);
            grown = true;
          }
        }
      }
    }
  }
  return out;
}

function lent_root(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  let at: i32 = v;
  while (part_read(defs[at].kind_tag) && defs[at].args.len() > 0) {
    let t: typeinfo.Type = f.values[at];
    if (!ssasem.reference(t) || ssasem.holds_view(f, t) || ssasem.is_map(t)) {
      return at;
    }
    at = defs[at].args[0];
  }
  return at;
}

function part_read(kind: i32): boolean {
  return kind == ssasem.variant_get() || kind == ssasem.variant_as() || kind == ssasem.record_get()
    || kind == ssasem.tuple_get() || kind == ssasem.array_get();
}

function view_retain_error(f: ssasem.Func, steps: Step[], literal: boolean[], defs: ssa.SInst[]): string {
  for s in steps {
    for item in s.supplies {
      if (item.mode == retain_unit() && ssasem.is_view(f.values[item.value]) && !retagged_string(f, defs, item.value) && !literal[item.value]) {
        return "a view is lent, never retained";
      }
    }
  }
  return "";
}

function retagged_string(f: ssasem.Func, defs: ssa.SInst[], v: i32): boolean {
  let d: ssa.SInst = defs[v];
  return d.kind_tag == ssasem.str_as() && d.args.len() == 1 && !ssasem.is_view(f.values[d.args[0]]);
}

function use_ids(value: i32, deps: i32[][]): i32[] {
  if (value < 0) {
    return [];
  }
  let ids: i32[] = [value];
  for dep in deps[value] {
    if (!has_id(ids, dep)) {
      ids = ids.append(dep);
    }
  }
  return ids;
}

function operation_supplies(f: ssasem.Func, ins: ssa.SInst): Supply[] {
  let out: Supply[] = [];
  let counted: boolean[] = [];
  if (ins.kind_tag == ssasem.call()) {
    counted = call_supplied(f, ins);
  } else if (ins.kind_tag == ssasem.call_value()) {
    counted = call_value_supplied(f, ins);
  } else if (ins.kind_tag == ssasem.cell_set()) {
    counted = [false, ssasem.reference(f.values[ins.args[1]])];
  } else if (ins.kind_tag == ssasem.map_insert()) {
    counted = [true, ssasem.reference(f.values[ins.args[1]]), ssasem.reference(f.values[ins.args[2]])];
  } else if (ins.kind_tag == ssasem.map_delete()) {
    counted = [true, false];
  } else if (ins.kind_tag == ssasem.append()) {
    counted = [true, ssasem.reference(f.values[ins.args[1]])];
  } else if (ins.kind_tag == ssasem.arr_concat()) {
    counted = [true, false];
  } else if (ins.kind_tag == ssasem.with()) {
    counted = [true, false, ssasem.reference(f.values[ins.args[2]])];
  } else if (ins.kind_tag == ssasem.hole_fill()) {
    counted = [true, false, true];
  } else if (string_append(f, ins)) {
    counted = [true, false];
  } else if (construction(ins.kind_tag)) {
    for arg in ins.args {
      counted = counted.append(taken(f.values[arg]));
    }
  }
  let i: i32 = 0;
  while (i < counted.len()) {
    if (counted[i]) {
      out = out.append(Supply { value: ins.args[i], slot: i, mode: 0 });
    }
    i = i + 1;
  }
  return out;
}

struct SupplyTable { from: i32[], rows: Supply[][] }

function supply_table(f: ssasem.Func): SupplyTable {
  let from: i32[] = [];
  let rows: Supply[][] = [];
  for b in f.graph.blocks {
    from = from.append(rows.len());
    for ins in b.insts {
      if (ins.kind_tag == 6 || ins.kind_tag == 8) {
        rows = rows.append([]);
      } else {
        rows = rows.append(operation_supplies(f, ins));
      }
    }
  }
  return SupplyTable { from: from, rows: rows };
}

function (t: SupplyTable) at(bi: i32, pos: i32): Supply[] {
  return t.rows[t.from[bi] + pos];
}

pub function string_append(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag == ssasem.append_range()) {
    return true;
  }
  return ins.kind_tag == 9 && ins.str == "+" && ssasem.is_string(f.values[ins.args[0]]);
}

function lent_operands(ins: ssa.SInst, counted: Supply[]): i32[] {
  let out: i32[] = [];
  if (ins.kind_tag != ssasem.call() && ins.kind_tag != ssasem.call_value()) {
    return out;
  }
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let slot_counted: boolean = false;
    for got in counted {
      if (got.slot == i) {
        slot_counted = true;
      }
    }
    if (!slot_counted && ins.args[i] >= 0) {
      out = out.append(ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

function lent_owners(ins: ssa.SInst, counted: Supply[], deps: i32[][]): i32[] {
  let out: i32[] = [];
  if (counted.len() == 0) {
    return out;
  }
  for v in lent_operands(ins, counted) {
    for supply in counted {
      if ((supply.value == v || has_id(deps[v], supply.value)) && !has_id(out, supply.value)) {
        out = out.append(supply.value);
      }
    }
  }
  return out;
}

function call_value_supplied(f: ssasem.Func, ins: ssa.SInst): boolean[] {
  let out: boolean[] = [false];
  let callee: typeinfo.Type = f.values[ins.args[0]];
  let params: typeinfo.Type[] = ssasem.func_params(callee);
  let i: i32 = 0;
  while (i < params.len()) {
    out = out.append(ssasem.func_param_own(callee, i) && ssasem.reference(f.values[ins.args[i + 1]]));
    i = i + 1;
  }
  return out;
}

function call_supplied(f: ssasem.Func, ins: ssa.SInst): boolean[] {
  let c: ssasem.Contract = f.calls[ssasem.find_contract_in(f.calls, ins.str)];
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < ins.args.len()) {
    out = out.append(c.modes[i] == counted_mode() && ssasem.reference(f.values[ins.args[i]]));
    i = i + 1;
  }
  return out;
}

pub function callee_modes(f: ssasem.Func, ins: ssa.SInst): i32[] {
  let at: i32 = ssasem.find_contract_in(f.calls, ins.str);
  if (at < 0) {
    return [];
  }
  return f.calls[at].modes;
}

function return_supplies(f: ssasem.Func, b: ssa.SBlock): Supply[] {
  if (b.term.kind_tag == 1 && b.term.value >= 0 && ssasem.reference(f.values[b.term.value])) {
    return [Supply { value: b.term.value, slot: 0, mode: 0 }];
  }
  return [];
}

function edge_supplies(f: ssasem.Func, b: ssa.SBlock, si: i32, owned: boolean[]): Supply[] {
  let succ: ssa.SBlock = f.graph.blocks[si];
  let pi: i32 = 0;
  while (succ.preds[pi] != b.id) {
    pi = pi + 1;
  }
  let out: Supply[] = [];
  let i: i32 = 0;
  for ins in succ.insts {
    if (ins.kind_tag == 8 && owned[ins.result]) {
      out = out.append(Supply { value: ins.args[pi], slot: i, mode: 0 });
    }
    i = i + 1;
  }
  return out;
}

function definitions(f: ssasem.Func): ssa.SInst[] {
  let none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let out: ssa.SInst[] = [];
  let i: i32 = 0;
  while (i < f.graph.nvals) {
    out = out.append(none);
    i = i + 1;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.result < out.len()) {
        out = out.with(ins.result, ins);
      }
    }
  }
  return out;
}

function frame_views(f: ssasem.Func, defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.slice() || byte_view_slice(f, ins)) {
        out = out.with(ins.result, true);
      }
    }
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      let i: i32 = 0;
      while (i < ins.args.len()) {
        let view: i32 = lent_view(f, defs, ins.args[i]);
        if (view >= 0) {
          let handed: boolean = ins.kind_tag == ssasem.call() && util.index_of_i32(ssasem.anchor_params(f.anchors, ins.str), i) >= 0;
          if (handed || !reads_view(f, ins, i, view != ins.args[i], defs[view].kind_tag == ssasem.arr_slice())) {
            out = out.with(view, false);
          }
        }
        i = i + 1;
      }
    }
    if (b.term.kind_tag == 1) {
      let ret: i32 = lent_view(f, defs, b.term.value);
      if (ret >= 0) {
        out = out.with(ret, false);
      }
    }
  }
  return out;
}

function byte_view_slice(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag != ssasem.arr_slice() || ins.result < 0 || ins.result >= f.values.len()) {
    return false;
  }
  if let typeinfo.TypeArray(a) = f.values[ins.result] {
    return a.view && ssasem.is_u8(a.elem);
  }
  return false;
}

function text_lens(f: ssasem.Func): i32[] {
  let out: i32[] = [];
  while (out.len() < f.graph.nvals) {
    out = out.append(0 - 1);
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 5 && ins.result >= 0) {
        out = out.with(ins.result, ins.str.len());
      }
    }
  }
  return out;
}

function constants(f: ssasem.Func, defs: ssa.SInst[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < f.graph.nvals) {
    out = out.append("");
    i = i + 1;
  }
  let raw: boolean[] = __alloc_bool(f.graph.nvals);
  for v in raw_reached(f, defs) {
    raw = raw.with(v, true);
  }
  let again: boolean = true;
  while (again) {
    let placed: boolean = false;
    let waiting: boolean = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        let built: Construction = placeable(f, raw, out, ins);
        if (built.ok) {
          let w: BoxWords = box_words(f, defs, raw, out, ins, built.fields);
          waiting = waiting || w.waiting;
          if (w.text != "") {
            out = out.with(ins.result, w.text);
            placed = true;
          }
        }
      }
    }
    again = placed && waiting;
  }
  return out;
}

function placeable(f: ssasem.Func, raw: boolean[], out: string[], ins: ssa.SInst): Construction {
  let built: Construction = built_fields(f, ins);
  if (!built.ok || built.fields.len() != ins.args.len() || raw[ins.result] || out[ins.result] != "") {
    return Construction { ...built, ok: false };
  }
  if (ssasem.has_finalizer(f, f.values[ins.result])) {
    return Construction { ...built, ok: false };
  }
  return built;
}

struct BoxWords { text: string, waiting: boolean }

function box_words(f: ssasem.Func, defs: ssa.SInst[], raw: boolean[], out: string[], ins: ssa.SInst, fields: semrecords.Field[]): BoxWords {
  if (ins.kind_tag == ssasem.bytes_new()) {
    return BoxWords { text: "|" + ins.str, waiting: false };
  }
  let words: string = "|";
  let j: i32 = 0;
  while (j < fields.len()) {
    let w: string = constant_word(f, defs, ins.args[j], fields[j].ty);
    if (w == "") {
      w = wide_word(f, defs, ins.args[j], fields[j].ty);
    }
    if (w == "") {
      w = literal_word(defs, ins.args[j]);
    }
    if (w == "") {
      w = option_word(f, defs, ins.args[j]);
    }
    if (w == "") {
      let at: i32 = placed_box(f, defs, raw, ins.args[j]);
      if (at < 0 || out[at] == "") {
        return BoxWords { text: "", waiting: at >= 0 };
      }
      w = "@" + util.i32_to_string(at);
    }
    if (w == "") {
      return BoxWords { text: "", waiting: false };
    }
    if (j > 0) {
      words = words + ",";
    }
    words = words + w;
    j = j + 1;
  }
  return BoxWords { text: words, waiting: false };
}

function literal_word(defs: ssa.SInst[], v: i32): string {
  if (v < 0) {
    return "";
  }
  let d: ssa.SInst = through_copies(defs, v);
  if (d.kind_tag != 5 || d.result < 0) {
    return "";
  }
  return "$" + util.i32_to_string(d.result);
}

function option_word(f: ssasem.Func, defs: ssa.SInst[], v: i32): string {
  if (v < 0) {
    return "";
  }
  let d: ssa.SInst = through_copies(defs, v);
  if (d.kind_tag != ssasem.variant_new() || d.args.len() != 0 || d.result < 0) {
    return "";
  }
  let e: i32 = semrecords.find_enum(f.enums, f.values[d.result]);
  if (e < 0 || f.enums[e].layout != semrecords.layout_option()) {
    return "";
  }
  return ir.const_option_ref(semrecords.find_variant(f.enums[e], d.str));
}

function placed_box(f: ssasem.Func, defs: ssa.SInst[], raw: boolean[], v: i32): i32 {
  if (v < 0) {
    return 0 - 1;
  }
  let d: ssa.SInst = through_copies(defs, v);
  if (d.result < 0 || raw[d.result] || !built_fields(f, d).ok) {
    return 0 - 1;
  }
  return d.result;
}

function raw_reached(f: ssasem.Func, defs: ssa.SInst[]): i32[] {
  let work: i32[] = [];
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.args.len() == 0) {
        continue;
      }
      let raw: boolean = ins.kind_tag == ssasem.cast() && is_array(f.values[ins.args[0]]);
      raw = raw || ins.kind_tag == ssasem.call() && (ins.str == "__arr_set_len" || ins.str == "__raw_arr_ptr");
      if (raw) {
        work = work.append(ins.args[0]);
      }
    }
  }
  let seen: boolean[] = __alloc_bool(f.graph.nvals);
  let out: i32[] = [];
  let at: i32 = 0;
  while (at < work.len()) {
    let v: i32 = work[at];
    at = at + 1;
    if (v < 0 || v >= seen.len() || seen[v]) {
      continue;
    }
    seen = seen.with(v, true);
    out = out.append(v);
    let d: ssa.SInst = defs[v];
    if (d.kind_tag == 7 || d.kind_tag == 8) {
      for a in d.args {
        work = work.append(a);
      }
    }
  }
  return out;
}

struct Construction { ok: boolean, fields: semrecords.Field[] }

function built_fields(f: ssasem.Func, ins: ssa.SInst): Construction {
  let none: semrecords.Field[] = [];
  let t: typeinfo.Type = f.values[ins.result];
  if (ins.kind_tag == ssasem.bytes_new()) {
    return Construction { ok: true, fields: none };
  }
  if (ins.kind_tag == ssasem.array_new()) {
    if let typeinfo.TypeArray(a) = t {
      let elems: semrecords.Field[] = [];
      while (elems.len() < ins.args.len()) {
        elems = elems.append(semrecords.Field { name: "", ty: a.elem });
      }
      return Construction { ok: true, fields: elems };
    }
  }
  if (ins.kind_tag == ssasem.record_new() && !semtypes.is_env(t)) {
    let at: i32 = semrecords.find(f.records, t);
    if (at >= 0) {
      return Construction { ok: true, fields: f.records.list[at].fields };
    }
  }
  if (ins.kind_tag == ssasem.variant_new()) {
    let e: i32 = semrecords.find_enum(f.enums, t);
    if (e >= 0 && f.enums[e].layout == semrecords.layout_variant()) {
      for v in f.enums[e].variants {
        if (v.name == ins.str) {
          return Construction { ok: true, fields: v.fields };
        }
      }
    }
  }
  return Construction { ok: false, fields: none };
}

function constant_word(f: ssasem.Func, defs: ssa.SInst[], v: i32, t: typeinfo.Type): string {
  if (!narrow_scalar(t)) {
    return "";
  }
  let d: ssa.SInst = through_copies(defs, v);
  let arg: i32 = constant_cast_arg(d);
  if (arg >= 0) {
    return cast_word(f, defs, arg, t);
  }
  if (d.kind_tag == 1 && d.str != "") {
    return small_decimal(d.str);
  }
  if (d.kind_tag == 1 || d.kind_tag == 2) {
    return util.i32_to_string(d.imm);
  }
  if (d.str != "-" || !ssasem.is_i32(t)) {
    return "";
  }
  return negated_word(defs, d);
}

function cast_word(f: ssasem.Func, defs: ssa.SInst[], v: i32, t: typeinfo.Type): string {
  if (!ssasem.is_u8(t) && !ssasem.is_i32(t) && !ssasem.is_u32(t)) {
    return "";
  }
  let src: ssa.SInst = through_copies(defs, v);
  if (!integer_literal(f, src)) {
    return "";
  }
  if (src.str != "") {
    return small_decimal(src.str);
  }
  if (src.imm < 0) {
    return "";
  }
  return util.i32_to_string(src.imm);
}

function constant_cast_arg(ins: ssa.SInst): i32 {
  if (ins.kind_tag == ssasem.cast() && ins.args.len() == 1 && ins.args[0] >= 0) {
    return ins.args[0];
  }
  return -1;
}

function integer_literal(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag != 1 || ins.result < 0 || ins.result >= f.values.len()) {
    return false;
  }
  let from: typeinfo.Type = f.values[ins.result];
  return ssasem.is_integer(from) || ssasem.is_char(from);
}

function wide_word(f: ssasem.Func, defs: ssa.SInst[], v: i32, t: typeinfo.Type): string {
  if (ssasem.is_float(t)) {
    match (float_constant_bits(f, defs, v, cell_new(32))) {
      Some(bits) => {
        return util.i64_to_string(bits);
      },
      None => {
        return "";
      }
    }
  }
  if (!ssasem.is_wide(t)) {
    return "";
  }
  let d: ssa.SInst = through_copies(defs, v);
  let neg: boolean = false;
  if (d.kind_tag == 10 && d.str == "-" && d.args.len() == 1 && d.args[0] >= 0) {
    neg = true;
    d = through_copies(defs, d.args[0]);
  }
  d = wide_literal(f, defs, d);
  if (d.kind_tag != 1) {
    return "";
  }
  let bits: i64 = d.imm as i64;
  if (d.str != "") {
    bits = util.lit_to_i64(d.str);
  }
  if (neg) {
    bits = 0 - bits;
  }
  return util.i64_to_string(bits);
}

function float_constant_bits(f: ssasem.Func, defs: ssa.SInst[], v: i32, budget: Cell[i32]): Option[i64] {
  if (budget.get() <= 0 || v < 0 || v >= defs.len()) {
    return None;
  }
  budget.set(budget.get() - 1);
  let d: ssa.SInst = through_copies(defs, v);
  if (d.result < 0 || !ssasem.is_float(f.values[d.result])) {
    return None;
  }
  let bits: i64 = 0;
  if (d.kind_tag == 1) {
    bits = util.parse_f64_bits(d.str);
  } else if (d.args.len() == 1 && (d.kind_tag == ssasem.cast() || d.kind_tag == 10 && d.str == "-")) {
    match (float_constant_bits(f, defs, d.args[0], budget)) {
      Some(value) => {
        bits = value;
      },
      None => {
        return None;
      }
    }
    if (d.kind_tag == 10) {
      bits = bits ^ 1i64 << 63i64;
    }
  } else if (d.kind_tag == 9 && d.args.len() == 2 && (d.str == "+" || d.str == "-" || d.str == "*" || d.str == "/")) {
    let left: i64 = 0;
    let right: i64 = 0;
    match (float_constant_bits(f, defs, d.args[0], budget)) {
      Some(value) => {
        left = value;
      },
      None => {
        return None;
      }
    }
    match (float_constant_bits(f, defs, d.args[1], budget)) {
      Some(value) => {
        right = value;
      },
      None => {
        return None;
      }
    }
    let a: f64 = f64_from_bits(left);
    let b: f64 = f64_from_bits(right);
    let value: f64 = 0.0;
    if (d.str == "+") {
      value = a + b;
    }
    if (d.str == "-") {
      value = a - b;
    }
    if (d.str == "*") {
      value = a * b;
    }
    if (d.str == "/") {
      value = a / b;
    }
    if (value != value) {
      return None;
    }
    bits = f64_bits(value);
  } else {
    return None;
  }
  if (ssasem.is_f32(f.values[d.result])) {
    bits = f64_bits((f64_from_bits(bits) as f32) as f64);
  }
  return Some(bits);
}

function wide_literal(f: ssasem.Func, defs: ssa.SInst[], d: ssa.SInst): ssa.SInst {
  let arg: i32 = constant_cast_arg(d);
  if (arg < 0) {
    return d;
  }
  let src: ssa.SInst = through_copies(defs, arg);
  if (integer_literal(f, src)) {
    return src;
  }
  return d;
}

function through_copies(defs: ssa.SInst[], v: i32): ssa.SInst {
  let d: ssa.SInst = defs[v];
  let hops: i32 = 0;
  while (d.kind_tag == 7 && d.args.len() == 1 && d.args[0] >= 0 && hops < 16) {
    d = defs[d.args[0]];
    hops = hops + 1;
  }
  return d;
}

function negated_word(defs: ssa.SInst[], d: ssa.SInst): string {
  let k: ssa.SInst = defs[d.args[d.args.len() - 1]];
  if (k.kind_tag != 1 || k.imm < 0) {
    return "";
  }
  if (d.kind_tag == 10) {
    return util.i32_to_string(0 - k.imm);
  }
  let zero: ssa.SInst = defs[d.args[0]];
  if (d.kind_tag != 9 || zero.kind_tag != 1 || zero.imm != 0) {
    return "";
  }
  return util.i32_to_string(0 - k.imm);
}

function small_decimal(text: string): string {
  if (text.len() == 0 || text.len() > 9) {
    return "";
  }
  let i: i32 = 0;
  while (i < text.len()) {
    if (text[i] < b'0' || text[i] > b'9') {
      return "";
    }
    i = i + 1;
  }
  return text;
}

function narrow_scalar(t: typeinfo.Type): boolean {
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  return ssasem.is_i32(t) || ssasem.is_u32(t) || ssasem.is_u8(t) || ssasem.is_char(t);
}

function lent_view(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  if (v < 0 || v >= defs.len()) {
    return 0 - 1;
  }
  let d: ssa.SInst = defs[v];
  if (d.kind_tag == ssasem.slice() || byte_view_slice(f, d)) {
    return v;
  }
  if (d.kind_tag == ssasem.str_as() && d.args.len() == 1 && d.args[0] >= 0 && defs[d.args[0]].kind_tag == ssasem.slice()) {
    return d.args[0];
  }
  return 0 - 1;
}

function reads_view(f: ssasem.Func, ins: ssa.SInst, at: i32, lent: boolean, byte: boolean): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 9 || k == ssasem.append_range() || k == ssasem.length() || k == ssasem.str_index() || k == ssasem.str_bytes()) {
    return true;
  }
  if (k == ssasem.slice()) {
    return at == 0;
  }
  if (k == ssasem.str_as()) {
    return !lent;
  }
  if (byte) {
    if (k == ssasem.array_get() || k == ssasem.arr_slice()) {
      return at == 0;
    }
    if (k == ssasem.call()) {
      let modes: i32[] = callee_modes(f, ins);
      return at < modes.len() && modes[at] == borrow_mode();
    }
    return false;
  }
  return k == ssasem.call() && lent;
}

function is_record(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

function projection(kind: i32): boolean {
  return kind == 7 || kind == ssasem.array_get() || kind == ssasem.tuple_get() || kind == ssasem.record_get()
    || kind == ssasem.variant_get() || kind == ssasem.variant_up() || kind == ssasem.variant_as()
    || kind == ssasem.slice() || kind == ssasem.arr_slice() || kind == ssasem.str_as() || kind == ssasem.array_lend() || kind == ssasem.str_byte_view() || kind == ssasem.dyn_up() || kind == ssasem.dyn_as();
}

function reads(a: ssasem.Analysis, arg: i32, w: i32): boolean {
  if (arg < 0) {
    return false;
  }
  if (arg == w) {
    return true;
  }
  for dep in a.dependencies[arg] {
    if (dep == w) {
      return true;
    }
  }
  return false;
}

function used_after(a: ssasem.Analysis, bi: i32, pos: i32, w: i32): boolean {
  if (ssalive.live_out_has(a.flow, bi, w) || ssasem.read_after(a.uses, bi, pos, w)) {
    return true;
  }
  let k: i32 = a.anchored.start[w];
  while (k < a.anchored.start[w + 1]) {
    if (ssasem.read_after(a.uses, bi, pos, a.anchored.at[k])) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function read_after_direct(a: ssasem.Analysis, direct: ssalive.Flow, bi: i32, pos: i32, v: i32): boolean {
  if (ssalive.live_out_has(direct, bi, v) || ssasem.read_after(a.uses, bi, pos, v)) {
    return true;
  }
  let k: i32 = a.anchored.start[v];
  while (k < a.anchored.start[v + 1]) {
    let w: i32 = a.anchored.at[k];
    if (has_id(a.parents[w], v) && ssasem.read_after(a.uses, bi, pos, w)) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function other_field_get(ins: ssa.SInst, root: i32, field: i32): boolean {
  return ins.kind_tag == ssasem.record_get() && ins.args[0] == root && ins.imm != field;
}

function projection_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, v: i32): i32 {
  let none: i32 = 0 - 1;
  let get: ssa.SInst = defs[v];
  if (get.kind_tag != ssasem.record_get()) {
    return none;
  }
  let root: i32 = get.args[0];
  if (!is_record(f.values[root]) || semtypes.is_env(f.values[root])) {
    return none;
  }
  if (defs[root].kind_tag != 6 && !owned[root]) {
    return none;
  }
  if (projection(defs[root].kind_tag)) {
    return none;
  }
  if (needed_past_slot(f, a, defs, bi, pos, get, false, true, false)) {
    return none;
  }
  return root;
}

function other_tuple_get(ins: ssa.SInst, root: i32, field: i32): boolean {
  return ins.kind_tag == ssasem.tuple_get() && ins.args.len() == 1 && ins.args[0] == root && ins.imm != field;
}

function takeable_root(kind: i32): boolean {
  return construction(kind);
}

function tuple_take_field(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
  let none: i32 = 0 - 1;
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (ins.kind_tag != ssasem.tuple_get()) {
    return none;
  }
  if (ins.args.len() != 1) {
    return none;
  }
  if (ins.result < 0 || ins.result >= f.graph.nvals) {
    return none;
  }
  let root: i32 = ins.args[0];
  if (root < 0 || root >= f.graph.nvals || root >= owned.len() || root >= defs.len()) {
    return none;
  }
  if (!ssasem.reference(f.values[ins.result])) {
    return none;
  }
  if (!owned[root] || !takeable_root(defs[root].kind_tag) || !ssasem.uses_only(a.uses, root, [ssasem.tuple_get()])) {
    return none;
  }
  if (needed_past_slot(f, a, defs, bi, pos, ins, true, false, true)) {
    return none;
  }
  return ins.imm;
}

function tuple_takes(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): i32[] {
  let out: i32[] = [];
  let vi: i32 = 0;
  while (vi < f.graph.nvals) {
    out = out.append(0 - 1);
    vi = vi + 1;
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let pos: i32 = 0;
    while (pos < f.graph.blocks[bi].insts.len()) {
      let field: i32 = tuple_take_field(f, a, owned, defs, bi, pos);
      if (field >= 0) {
        out = out.with(f.graph.blocks[bi].insts[pos].result, field);
      }

      pos = pos + 1;
    }
    bi = bi + 1;
  }
  return out;
}

struct Units { owned: boolean[], parents: i32[][], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[], reflow: boolean, likely: boolean[] }

function units_of(f: ssasem.Func, base: boolean[], a: ssasem.Analysis, defs: ssa.SInst[], sup: SupplyTable): Units {
  let pt: PayloadTakes = payload_takes(f, a, base, defs);
  let payloads: boolean[] = pt.taken;
  let likely: boolean[] = pt.likely;
  let owned: boolean[] = base;
  let i: i32 = 0;
  while (i < payloads.len()) {
    if (payloads[i]) {
      owned = owned.with(i, true);
    }
    i = i + 1;
  }
  let takes: i32[] = tuple_takes(f, a, owned, defs);
  let held: boolean[] = held_elements(f, a, owned, defs, sup);
  let asked: boolean[] = twin_holds(f, a, defs, owned, held);
  let past: PayloadTakes = takes_past_holds(f, a, owned, asked, defs);
  let added: boolean = false;
  let grew: boolean = true;
  while (grew) {
    grew = false;
    i = 0;
    while (i < past.taken.len()) {
      if (past.taken[i] && !payloads[i] && owned[defs[i].args[0]] && !slot_held(defs, asked, i)) {
        payloads = payloads.with(i, true);
        likely = likely.with(i, past.likely[i]);
        owned = owned.with(i, true);
        pt = PayloadTakes { ...pt, crossing: pt.crossing || past.crossing };
        added = true;
        grew = true;
      }
      i = i + 1;
    }
  }
  if (added) {
    held = either(asked, held_elements(f, a, owned, defs, sup));
  }
  i = 0;
  while (i < held.len()) {
    if (held[i] && (payloads[i] || takes[i] >= 0)) {
      held = held.with(i, false);
    }
    i = i + 1;
  }
  let parents: i32[][] = a.parents;
  let deps: i32[][] = a.dependencies;
  let reflow: boolean = pt.crossing;
  i = 0;
  while (i < takes.len()) {
    if (payloads[i] && (defs[i].kind_tag == ssasem.record_get() || defs[i].kind_tag == ssasem.tuple_get() || option_layout(f, f.values[defs[i].args[0]]))) {
      reflow = true;
    }
    if (takes[i] >= 0 || held[i] || payloads[i]) {
      owned = owned.with(i, true);
      let up: i32[] = [];
      let chain: i32[] = [];
      if ((takes[i] >= 0 || payloads[i]) && ssasem.is_view(f.values[i])) {
        up = a.parents[defs[i].args[0]];
        chain = a.dependencies[defs[i].args[0]];
      }
      parents = parents.with(i, up);
      deps = deps.with(i, chain);
    }
    i = i + 1;
  }
  if (reflow) {
    deps = through_takes(parents, deps, takes, held, payloads);
  }
  return Units { owned: owned, parents: parents, deps: deps, takes: takes, held: held, payloads: payloads, reflow: reflow, likely: likely };
}

function takes_past_holds(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], held: boolean[], defs: ssa.SInst[]): PayloadTakes {
  let none: PayloadTakes = PayloadTakes { taken: __alloc_bool(f.graph.nvals), crossing: false, likely: __alloc_bool(f.graph.nvals) };
  if (count_true(held) == 0) {
    return none;
  }
  let parents: i32[][] = a.parents;
  let deps: i32[][] = a.dependencies;
  let w: i32 = 0;
  while (w < held.len()) {
    if (held[w]) {
      parents = parents.with(w, []);
      deps = deps.with(w, []);
    }
    w = w + 1;
  }
  deps = through_takes(parents, deps, no_takes(f.graph.nvals), held, __alloc_bool(f.graph.nvals));
  let flow: ssalive.Flow = ssadeps.analyze(f.graph, deps);
  if (!flow.ok) {
    return none;
  }
  let cut: ssasem.Analysis = ssasem.Analysis { ...a, parents: parents, dependencies: deps, flow: flow, anchored: ssasem.anchored_of(deps, f.graph.nvals) };
  return payload_takes(f, cut, owned, defs);
}

function twin_holds(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], owned: boolean[], held: boolean[]): boolean[] {
  let out: boolean[] = held;
  let reads: i32[][] = field_reads(f, owned);
  let bare: ssalive.Flow = ssalive.compute_checked(f.graph, empty_chains(f.graph.nvals));
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let pos: i32 = 0;
    for ins in f.graph.blocks[bi].insts {
      if (ins.kind_tag == ssasem.record_get() && ins.args.len() == 1 && ins.result >= 0 && ins.args[0] < reads.len()) {
        for first in reads[ins.args[0]] {
          if (first != ins.result && defs[first].imm == ins.imm && defs[first].str == ins.str) {
            out = holds_off(f, a, defs, bare, first, ins.result, bi, pos, out);
          }
        }
      }
      pos = pos + 1;
    }
    bi = bi + 1;
  }
  return out;
}

function holds_off(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], bare: ssalive.Flow, first: i32, r: i32, bi: i32, pos: i32, own out: boolean[]): boolean[] {
  let k: i32 = a.anchored.start[first];
  while (k < a.anchored.start[first + 1]) {
    let w: i32 = a.anchored.at[k];
    if (w != r && !out[w] && retainable_read(f, defs, w) && (ssalive.live_out_has(bare, bi, w) || ssasem.read_after(a.uses, bi, pos, w))) {
      out = out.with(w, true);
    }
    k = k + 1;
  }
  return out;
}

function field_reads(f: ssasem.Func, owned: boolean[]): i32[][] {
  let out: i32[][] = empty_chains(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.record_get() && ins.args.len() == 1 && ins.result >= 0) {
        let root: i32 = ins.args[0];
        if (root >= 0 && root < out.len() && root < owned.len() && owned[root]) {
          out = out.with(root, out[root].append(ins.result));
        }
      }
    }
  }
  return out;
}

function empty_chains(n: i32): i32[][] {
  let out: i32[][] = [];
  while (out.len() < n) {
    out = out.append([]);
  }
  return out;
}

function either(a: boolean[], b: boolean[]): boolean[] {
  let out: boolean[] = a;
  let i: i32 = 0;
  while (i < b.len() && i < out.len()) {
    if (b[i]) {
      out = out.with(i, true);
    }
    i = i + 1;
  }
  return out;
}

function slot_held(defs: ssa.SInst[], held: boolean[], r: i32): boolean {
  let d: ssa.SInst = defs[r];
  let w: i32 = 0;
  while (w < held.len()) {
    let h: ssa.SInst = defs[w];
    if (held[w] && w != r && h.kind_tag == d.kind_tag && h.imm == d.imm && h.str == d.str && h.args.len() > 0 && h.args[0] == d.args[0]) {
      return true;
    }
    w = w + 1;
  }
  return false;
}

function no_takes(n: i32): i32[] {
  let out: i32[] = __alloc_i32(n);
  let i: i32 = 0;
  while (i < n) {
    out = out.with(i, 0 - 1);
    i = i + 1;
  }
  return out;
}

function through_takes(parents: i32[][], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[]): i32[][] {
  let out: i32[][] = deps;
  let w: i32 = 0;
  while (w < deps.len()) {
    out = out.with(w, reach_through(parents, deps, takes, held, payloads, w, []));
    w = w + 1;
  }
  return out;
}

function reach_through(parents: i32[][], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[], x: i32, own out: i32[]): i32[] {
  for p in parents[x] {
    if (util.index_of_i32(out, p) >= 0) {
      continue;
    }
    out = out.append(p);
    if (takes[p] >= 0 || held[p] || payloads[p]) {
      for e in deps[p] {
        if (util.index_of_i32(out, e) < 0) {
          out = out.append(e);
        }
      }
    } else {
      out = reach_through(parents, deps, takes, held, payloads, p, out);
    }
  }
  return out;
}

function units_analysis(f: ssasem.Func, a: ssasem.Analysis, units: Units): ssasem.Analysis {
  let any: boolean = units.reflow;
  for h in units.held {
    if (h) {
      any = true;
    }
  }
  if (!any) {
    return ssasem.Analysis { ...a, parents: units.parents, dependencies: units.deps, anchored: ssasem.anchored_of(units.deps, f.graph.nvals) };
  }
  let flow: ssalive.Flow = ssadeps.analyze(f.graph, units.deps);
  return ssasem.Analysis { ...a, ok: flow.ok, why: flow.why, parents: units.parents, dependencies: units.deps, flow: flow, anchored: ssasem.anchored_of(units.deps, f.graph.nvals) };
}

function retainable_read(f: ssasem.Func, defs: ssa.SInst[], w: i32): boolean {
  let k: i32 = defs[w].kind_tag;
  if (k != ssasem.array_get() && k != ssasem.record_get() && k != ssasem.tuple_get()) {
    return false;
  }
  let t: typeinfo.Type = f.values[w];
  return ssasem.reference(t) && !ssasem.is_view(t);
}

function outliving(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], owned: boolean[], held: boolean[], s: i32, bi: i32, pos: i32, si: i32, args: i32[]): i32[] {
  let out: i32[] = [];
  let k: i32 = a.anchored.start[s];
  while (k < a.anchored.start[s + 1]) {
    let w: i32 = a.anchored.at[k];
    if (w != s && !held[w] && !owned[w] && retainable_read(f, defs, w)) {
      let live: boolean = false;
      if (si >= 0) {
        live = ssalive.live_in_has(a.flow, si, w);
      } else {
        live = used_after(a, bi, pos, w) || has_id(args, w) && !used_after(a, bi, pos, s);
      }
      if (live) {
        out = out.append(w);
      }
    }
    k = k + 1;
  }
  return out;
}

function held_elements(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], sup: SupplyTable): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let direct: ssalive.Flow = ssalive.compute_checked(f.graph, a.parents);
  let bare: ssalive.Flow = ssalive.compute_checked(f.graph, empty_chains(f.graph.nvals));
  let consumed: boolean[] = consumed_values(f, owned, sup);
  let before: i32 = 0 - 1;
  let count: i32 = 0;
  while (count != before) {
    before = count;
    out = hold_pass(f, a, defs, Flows { direct: direct, bare: bare }, consumed, owned, out, sup);
    count = count_true(out);
  }
  return out;
}

struct Flows { direct: ssalive.Flow, bare: ssalive.Flow }

function hold_pass(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], flows: Flows, consumed: boolean[], owned: boolean[], own out: boolean[], sup: SupplyTable): boolean[] {
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    let pos: i32 = 0;
    while (pos < b.insts.len()) {
      let ins: ssa.SInst = b.insts[pos];
      if (ins.kind_tag != 6 && ins.kind_tag != 8) {
        out = hold_at(f, a, defs, flows, consumed, owned, out, ins, bi, pos, sup.at(bi, pos));
      }
      pos = pos + 1;
    }
    out = hold_along(f, a, defs, owned, out, b, bi);
    bi = bi + 1;
  }
  return out;
}

function hold_at(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], flows: Flows, consumed: boolean[], owned: boolean[], own out: boolean[], ins: ssa.SInst, bi: i32, pos: i32, supplies: Supply[]): boolean[] {
  for got in supplies {
    if (owned[got.value] || out[got.value]) {
      let past: i32[] = outliving(f, a, defs, owned, out, got.value, bi, pos, 0 - 1, ins.args);
      out = mark_all(out, past);
    }
  }
  let donor: i32 = ssasem.update_base(ins);
  if (donor >= 0 && donor < owned.len() && owned[donor]) {
    for w in outliving(f, a, defs, owned, out, donor, bi, pos, 0 - 1, []) {
      if (ssalive.live_out_has(flows.bare, bi, w) || ssasem.read_after(a.uses, bi, pos, w)) {
        out = out.with(w, true);
      }
    }
  }
  for v in dying_reads(f, a, flows.direct, owned, out, supplies, bi, pos) {
    if (v == donor) {
      continue;
    }
    for w in outliving(f, a, defs, owned, out, v, bi, pos, 0 - 1, []) {
      if (wanted(a.anchored, consumed, w)) {
        out = out.with(w, true);
      }
    }
  }
  return out;
}

function hold_along(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], owned: boolean[], own out: boolean[], b: ssa.SBlock, bi: i32): boolean[] {
  let targets: i32[] = successors(b);
  for target in targets {
    let si: i32 = ssalive.position(a.flow, target);
    let along: Supply[] = edge_supplies(f, b, si, owned);
    for got in along {
      if (owned[got.value] || out[got.value]) {
        let past: i32[] = outliving(f, a, defs, owned, out, got.value, bi, 0, si, []);
        out = mark_all(out, past);
      }
    }
  }
  return out;
}

function mark_all(own flags: boolean[], ids: i32[]): boolean[] {
  for id in ids {
    flags = flags.with(id, true);
  }
  return flags;
}

function count_true(flags: boolean[]): i32 {
  let n: i32 = 0;
  for flag in flags {
    if (flag) {
      n = n + 1;
    }
  }
  return n;
}

function dying_reads(f: ssasem.Func, a: ssasem.Analysis, direct: ssalive.Flow, owned: boolean[], held: boolean[], supplies: Supply[], bi: i32, pos: i32): i32[] {
  let out: i32[] = [];
  for u in f.graph.blocks[bi].insts[pos].args {
    if (u < 0) {
      continue;
    }
    for v in a.parents[u] {
      out = dying_read(a, direct, owned, held, supplies, bi, pos, v, out);
    }
    out = dying_read(a, direct, owned, held, supplies, bi, pos, u, out);
  }
  return out;
}

function dying_read(a: ssasem.Analysis, direct: ssalive.Flow, owned: boolean[], held: boolean[], supplies: Supply[], bi: i32, pos: i32, v: i32, own out: i32[]): i32[] {
  if (!(owned[v] || held[v]) || has_id(out, v) || supplied(supplies, v)) {
    return out;
  }
  if (!read_after_direct(a, direct, bi, pos, v)) {
    out = out.append(v);
  }
  return out;
}

function supplied(supplies: Supply[], v: i32): boolean {
  for got in supplies {
    if (got.value == v) {
      return true;
    }
  }
  return false;
}

function consumed_values(f: ssasem.Func, owned: boolean[], sup: SupplyTable): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let bi: i32 = 0;
  for b in f.graph.blocks {
    let pos: i32 = 0;
    for ins in b.insts {
      if (ins.kind_tag == 8) {
        if (owned[ins.result]) {
          out = mark_all(out, ins.args);
        }
      } else if (ins.kind_tag != 6) {
        for got in sup.at(bi, pos) {
          out = out.with(got.value, true);
        }
      }
      pos = pos + 1;
    }
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      out = out.with(b.term.value, true);
    }
    bi = bi + 1;
  }
  return out;
}

function wanted(anchored: ssasem.Anchored, consumed: boolean[], w: i32): boolean {
  if (consumed[w]) {
    return true;
  }
  let k: i32 = anchored.start[w];
  while (k < anchored.start[w + 1]) {
    if (consumed[anchored.at[k]]) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function other_payload_get(ins: ssa.SInst, root: i32, slot: i32): boolean {
  return ins.kind_tag == ssasem.variant_get() && ins.args.len() == 1 && ins.args[0] == root && ins.imm != slot;
}

function payload_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], spec: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
  let none: i32 = 0 - 1;
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  let field: boolean = ins.kind_tag == ssasem.record_get();
  let element: boolean = ins.kind_tag == ssasem.tuple_get();
  let slot: boolean = ins.kind_tag == ssasem.array_get();
  let arity: i32 = 1;
  if (slot) {
    arity = 2;
  }
  if (ins.kind_tag != ssasem.variant_get() && !field && !element && !slot || ins.args.len() != arity) {
    return none;
  }
  if (ins.result < 0 || ins.result >= f.graph.nvals) {
    return none;
  }
  let root: i32 = ins.args[0];
  if (root < 0 || root >= f.graph.nvals || root >= owned.len() || root >= defs.len()) {
    return none;
  }
  if (ins.kind_tag == ssasem.variant_get() && !spec[root] && member_union(f, f.values[root])) {
    return none;
  }
  if (element && takeable_root(defs[root].kind_tag)) {
    return none;
  }
  if (!slot_takeable(f, a, defs, f.values[ins.result], root, field, element, slot)) {
    return none;
  }
  if (!owned[root] || projection(defs[root].kind_tag) && !taken_root(defs[root].kind_tag)) {
    return none;
  }
  if (needed_past_slot(f, a, defs, bi, pos, ins, false, false, true)) {
    return none;
  }
  return root;
}

function slot_takeable(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], got: typeinfo.Type, root: i32, field: boolean, element: boolean, slot: boolean): boolean {
  let box: typeinfo.Type = f.values[root];
  if (field) {
    return field_takeable(got) && is_record(box) && !semtypes.is_env(box);
  }
  if (element) {
    return field_takeable(got) && is_tuple(box);
  }
  if (slot) {
    return field_takeable(got) && is_array(box) && !ssasem.is_view(box);
  }
  if (!ssasem.reference(got) || !is_union(box)) {
    return false;
  }
  return !(ssasem.is_view(got) || unknown_layout(f, box)) || sole_box(a, defs, root, __alloc_bool(f.graph.nvals));
}

function needed_past_slot(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], bi: i32, pos: i32, take: ssa.SInst, strict: boolean, own_root: boolean, through_take: boolean): boolean {
  let root: i32 = take.args[0];
  let b: ssa.SBlock = f.graph.blocks[bi];
  if (ssalive.live_out_has(a.flow, bi, root) && (strict || named_after(f, a, defs, bi, root, take))) {
    return true;
  }
  let stores: i32 = 0;
  let kept: i32[] = [];
  let u: i32 = ssasem.first_use_in(a.uses, root, bi);
  while (u < a.uses.start[root + 1] && a.uses.block[u] == bi) {
    if (a.uses.at[u] > pos) {
      if (a.uses.kinds[u] == ssasem.term_use()) {
        return true;
      }
      let later: ssa.SInst = b.insts[a.uses.at[u]];
      if (same_slot_with(defs, later, take)) {
        if (a.uses.slot[u] == 0) {
          stores = stores + 1;
          if (stores > 1) {
            return true;
          }
        }
      } else if (!other_slot_get(later, take)) {
        let through: i32[] = kept_store_back(a, defs, b, bi, later, a.uses.slot[u], take, 0);
        if (through.len() == 0) {
          return true;
        }
        stores = stores + 1;
        if (stores > 1) {
          return true;
        }
        kept = util.append_all(kept, through);
      }
    }
    u = u + 1;
  }
  if (own_root) {
    for arg in b.insts[pos].args {
      if (arg != take.result && (arg == root || reaches_root(a, defs, take, root, through_take, arg))) {
        return true;
      }
    }
  }
  let k: i32 = a.anchored.start[root];
  while (k < a.anchored.start[root + 1]) {
    let w: i32 = a.anchored.at[k];
    if (reaches_root(a, defs, take, root, through_take, w) && used_after(a, bi, pos, w) && reaches_past_kept(a, w, root, kept, __alloc_bool(a.parents.len()))) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function kept_store_back(a: ssasem.Analysis, defs: ssa.SInst[], b: ssa.SBlock, bi: i32, update: ssa.SInst, k: i32, take: ssa.SInst, depth: i32): i32[] {
  let none: i32[] = [];
  if (depth > 3 || update.kind_tag != ssasem.record_new() || ssasem.update_base(update) < 0 || take.kind_tag != ssasem.array_get()) {
    return none;
  }
  let rec: i32 = update.result;
  if (rec < 0 || ssalive.live_out_has(a.flow, bi, rec)) {
    return none;
  }
  let field: i32 = 0 - 1;
  let u: i32 = ssasem.first_use_in(a.uses, rec, bi);
  while (u < a.uses.start[rec + 1] && a.uses.block[u] == bi) {
    if (a.uses.kinds[u] == ssasem.term_use()) {
      return none;
    }
    let later: ssa.SInst = b.insts[a.uses.at[u]];
    if (later.kind_tag != ssasem.record_get() || later.args[0] != rec) {
      return none;
    }
    if (later.imm == k) {
      if (field >= 0) {
        return none;
      }
      field = later.result;
    }
    u = u + 1;
  }
  let rebuilt: i32 = 0 - 1;
  let at: i32 = 0;
  while (at < b.insts.len()) {
    if (ssasem.update_base(b.insts[at]) == rec) {
      if (rebuilt >= 0) {
        return none;
      }
      rebuilt = at;
    }
    at = at + 1;
  }
  if (field < 0 || rebuilt < 0 || ssalive.live_out_has(a.flow, bi, field)) {
    return none;
  }
  let final: ssa.SInst = b.insts[rebuilt];
  if (k >= final.args.len()) {
    return none;
  }
  let n: i32 = 0;
  let store: i32 = 0 - 1;
  u = ssasem.first_use_in(a.uses, field, bi);
  while (u < a.uses.start[field + 1] && a.uses.block[u] == bi) {
    n = n + 1;
    if (a.uses.kinds[u] == ssasem.term_use()) {
      return none;
    }
    let later: ssa.SInst = b.insts[a.uses.at[u]];
    if (a.uses.at[u] == rebuilt && final.args[k] == field) {
      let through: i32[] = kept_store_back(a, defs, b, bi, final, k, take, depth + 1);
      if (through.len() == 0) {
        return none;
      }
      return util.append_all([rec, field], through);
    }
    if (later.kind_tag == ssasem.with() && later.args.len() == 3 && a.uses.slot[u] == 0 && same_index(defs, later.args[1], take.args[1])) {
      store = later.result;
    }
    u = u + 1;
  }
  if (n != 1 || store < 0 || final.args[k] != store) {
    return none;
  }
  return [rec, field, store];
}

function reaches_past_kept(a: ssasem.Analysis, w: i32, root: i32, kept: i32[], seen: boolean[]): boolean {
  if (kept.len() == 0) {
    return true;
  }
  if (w == root) {
    return true;
  }
  if (w < 0 || w >= seen.len() || seen[w] || util.index_of_i32(kept, w) >= 0) {
    return false;
  }
  seen = seen.with(w, true);
  for p in a.parents[w] {
    if (reaches_past_kept(a, p, root, kept, seen)) {
      return true;
    }
  }
  return false;
}

function reaches_root(a: ssasem.Analysis, defs: ssa.SInst[], take: ssa.SInst, root: i32, through_take: boolean, w: i32): boolean {
  if (w < 0 || w == root || through_take && w == take.result) {
    return false;
  }
  let single: boolean = a.parents[w].len() <= 1;
  let prev: i32 = w;
  let hop: i32 = 0 - 1;
  let found: boolean = false;
  for dep in a.dependencies[w] {
    if (dep == root) {
      found = true;
      if (single) {
        hop = prev;
      }
      break;
    }
    if (a.parents[dep].len() > 1) {
      single = false;
    }
    prev = dep;
  }
  if (!found || through_take && hop == take.result) {
    return false;
  }
  return hop < 0 || !other_slot_get(defs[hop], take);
}

function named_after(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], bi: i32, v: i32, take: ssa.SInst): boolean {
  let seen: boolean[] = __alloc_bool(f.graph.blocks.len());
  let work: i32[] = [bi];
  let next: i32 = 0;
  while (next < work.len()) {
    let at: i32 = work[next];
    next = next + 1;
    if (!ssalive.live_out_has(a.flow, at, v)) {
      continue;
    }
    let from: ssa.SBlock = f.graph.blocks[at];
    for id in successors(from) {
      let k: i32 = ssalive.position(a.flow, id);
      if (k >= 0) {
        let blk: ssa.SBlock = f.graph.blocks[k];
        if (phi_reads_on(a.uses, blk, k, from.id, v)) {
          return true;
        }
        if (!seen[k]) {
          seen = seen.with(k, true);
          if (ssalive.live_in_has(a.flow, k, v) && !block_defines(blk, v)) {
            if (block_reads(a.uses, defs, blk, k, v, take)) {
              return true;
            }
            work = work.append(k);
          }
        }
      }
    }
  }
  return false;
}

function block_defines(blk: ssa.SBlock, v: i32): boolean {
  for ins in blk.insts {
    if (ins.result == v) {
      return true;
    }
  }
  return false;
}

function phi_reads_on(u: ssasem.Uses, blk: ssa.SBlock, k: i32, pred: i32, v: i32): boolean {
  let i: i32 = ssasem.first_use_in(u, v, k);
  while (i < u.start[v + 1] && u.block[i] == k) {
    if (u.kinds[i] == 8 && u.slot[i] < blk.preds.len() && blk.preds[u.slot[i]] == pred) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function block_reads(u: ssasem.Uses, defs: ssa.SInst[], blk: ssa.SBlock, k: i32, v: i32, take: ssa.SInst): boolean {
  let i: i32 = ssasem.first_use_in(u, v, k);
  while (i < u.start[v + 1] && u.block[i] == k) {
    if (u.kinds[i] == ssasem.term_use()) {
      return true;
    }
    if (u.kinds[i] != 8) {
      let later: ssa.SInst = blk.insts[u.at[i]];
      if (!other_slot_get(later, take) && !(u.slot[i] == 0 && same_slot_with(defs, later, take))) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

function same_slot_with(defs: ssa.SInst[], later: ssa.SInst, take: ssa.SInst): boolean {
  return take.kind_tag == ssasem.array_get() && later.kind_tag == ssasem.with() && later.args.len() == 3 && later.args[0] == take.args[0]
    && same_index(defs, later.args[1], take.args[1]);
}

function same_index(defs: ssa.SInst[], x: i32, y: i32): boolean {
  if (x == y) {
    return true;
  }
  if (x < 0 || y < 0 || x >= defs.len() || y >= defs.len()) {
    return false;
  }
  let a: ssa.SInst = defs[x];
  let b: ssa.SInst = defs[y];
  return a.kind_tag == 1 && b.kind_tag == 1 && a.imm == b.imm && a.str == b.str;
}

function other_slot_get(later: ssa.SInst, take: ssa.SInst): boolean {
  if (take.kind_tag == ssasem.record_get()) {
    return other_field_get(later, take.args[0], take.imm);
  }
  if (take.kind_tag == ssasem.tuple_get()) {
    return other_tuple_get(later, take.args[0], take.imm);
  }
  return other_payload_get(later, take.args[0], take.imm);
}

function field_takeable(t: typeinfo.Type): boolean {
  if (ssasem.is_view(t) || ssasem.is_text(t)) {
    return false;
  }
  return is_array(t) || ssasem.is_map(t) || is_record(t) && !semtypes.is_env(t) || is_union(t);
}

function taken_read(kind: i32): boolean {
  return kind == ssasem.record_get() || kind == ssasem.variant_get() || kind == ssasem.tuple_get();
}

function taken_root(kind: i32): boolean {
  return taken_read(kind) || kind == ssasem.array_get();
}

function sole_box(a: ssasem.Analysis, defs: ssa.SInst[], v: i32, seen: boolean[]): boolean {
  if (v < 0 || v >= defs.len()) {
    return false;
  }
  if (seen[v]) {
    return true;
  }
  let d: ssa.SInst = defs[v];
  if (d.kind_tag != ssasem.variant_new() && d.kind_tag != 8) {
    return false;
  }
  if (!ssasem.uses_only(a.uses, v, [8, ssasem.variant_is(), ssasem.variant_get()])) {
    return false;
  }
  if (d.kind_tag == 8) {
    let next: boolean[] = seen.with(v, true);
    for x in d.args {
      if (!sole_box(a, defs, x, next)) {
        return false;
      }
    }
  }
  return true;
}

pub function shell_root(f: ssasem.Func, p: Plan, ins: ssa.SInst): i32 {
  if (ins.kind_tag != ssasem.variant_get() || ins.result < 0 || ins.result >= p.payloads.len() || !p.payloads[ins.result]) {
    return 0 - 1;
  }
  let root: i32 = ins.args[0];
  if (!(ssasem.is_view(f.values[ins.result]) || unknown_layout(f, f.values[root])) || !sole_box(p.unit_analysis, p.defs, root, __alloc_bool(f.graph.nvals))) {
    return 0 - 1;
  }
  return root;
}

function is_tuple(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  return false;
}

function is_union(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(_) = t {
    return true;
  }
  return false;
}

function option_layout(f: ssasem.Func, t: typeinfo.Type): boolean {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return true;
  }
  return f.enums[at].layout == semrecords.layout_option();
}

function unknown_layout(f: ssasem.Func, t: typeinfo.Type): boolean {
  return semrecords.find_enum(f.enums, t) < 0;
}

struct PayloadTakes { taken: boolean[], crossing: boolean, likely: boolean[] }

function payload_takes(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): PayloadTakes {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let crossing: boolean = false;
  let own: boolean[] = owned;
  let spec: boolean[] = likely_unique(f, defs);
  let grown: boolean = true;
  while (grown) {
    grown = false;
    let bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
      let pos: i32 = 0;
      while (pos < f.graph.blocks[bi].insts.len()) {
        let v: i32 = f.graph.blocks[bi].insts[pos].result;
        if (v >= 0 && v < out.len() && !out[v]) {
          let root: i32 = payload_root(f, a, own, spec, defs, bi, pos);
          if (root >= 0) {
            out = out.with(v, true);
            own = own.with(v, true);
            spec = spec.with(v, true);
            crossing = crossing || ssalive.live_out_has(a.flow, bi, root);
            grown = true;
          }
        }
        pos = pos + 1;
      }
      bi = bi + 1;
    }
  }
  return PayloadTakes { taken: out, crossing: crossing, likely: spec };
}

function member_union(f: ssasem.Func, t: typeinfo.Type): boolean {
  let e: i32 = semrecords.find_enum(f.enums, t);
  return e >= 0 && f.enums[e].layout == semrecords.layout_member();
}

function likely_unique(f: ssasem.Func, defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      let k: i32 = ins.kind_tag;
      if (ins.result >= 0 && ins.result < out.len()) {
        let yes: boolean = k == 7 || k == 8;
        if (k == 6) {
          yes = ins.str == "own";
        } else if (!yes && k < 0) {
          yes = construction(k);
        }
        out = out.with(ins.result, yes);
      }
    }
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        if ((ins.kind_tag == 7 || ins.kind_tag == 8) && ins.result >= 0 && ins.result < out.len() && out[ins.result]) {
          for arg in ins.args {
            if (arg >= 0 && arg < out.len() && !out[arg] && out[ins.result]) {
              out = out.with(ins.result, false);
              changed = true;
            }
          }
        }
      }
    }
  }
  return out;
}

function field_grow_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (string_append(f, ins)) {
    let root: i32 = projection_root(f, a, owned, defs, bi, pos, ins.args[0]);
    if (root >= 0 && owned[root]) {
      return root;
    }
    return 0 - 1;
  }
  if (!box_update(ins)) {
    return 0 - 1;
  }
  return projection_root(f, a, owned, defs, bi, pos, ins.args[0]);
}

function is_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

pub function occurrences(xs: i32[], v: i32): i32 {
  let n: i32 = 0;
  for x in xs {
    if (x == v) {
      n = n + 1;
    }
  }
  return n;
}

function steals(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, s: Step): Step {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (ins.kind_tag != ssasem.call()) {
    return s;
  }
  let out: Supply[] = s.supplies;
  let i: i32 = 0;
  while (i < out.len()) {
    let v: i32 = out[i].value;
    if (out[i].mode == retain_unit() && defs[v].kind_tag == ssasem.record_get() && !owned[v] && occurrences(ins.args, v) == 1) {
      let root: i32 = projection_root(f, a, owned, defs, bi, pos, v);
      if (root >= 0 && owned[root]) {
        out = out.with(i, Supply { ...out[i], mode: steal_unit() });
      }
    }
    i = i + 1;
  }
  return Step { ...s, supplies: out };
}

function hands(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, s: Step): Step {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (ins.kind_tag != ssasem.call()) {
    return s;
  }
  let roots: i32[] = [];
  let fields: i32[] = [];
  for v in ins.args {
    let root: i32 = 0 - 1;
    let field: i32 = 0 - 1;
    let lent_param: boolean = defs[v].kind_tag == 6 && !owned[v] && occurrences(ins.args, v) == 1 && !used_after(a, bi, pos, v);
    if (is_array(f.values[v]) && !ssasem.is_text(f.values[v]) && occurrences(ins.args, v) == 1) {
      if (lent_param) {
        root = v;
      }
      if (defs[v].kind_tag == ssasem.record_get() && !owned[v]) {
        root = projection_root(f, a, owned, defs, bi, pos, v);
        if (root >= 0) {
          field = defs[v].imm;
        }
      }
    }
    if (is_record(f.values[v]) && !semtypes.is_env(f.values[v]) && lent_param) {
      root = v;
    }
    roots = roots.append(root);
    fields = fields.append(field);
  }
  return Step { ...s, hand_roots: roots, hand_fields: fields };
}

function choose_ids(s: Step, supplies: Supply[], dead: i32[], owned: boolean[], pinned: i32[]): Step {
  let moved: i32[] = [];
  let selected: Supply[] = supplies;
  let i: i32 = selected.len() - 1;
  while (i >= 0) {
    let item: Supply = selected[i];
    let mode: i32 = retain_unit();
    if (owned[item.value] && has_id(dead, item.value) && !has_id(moved, item.value) && !has_id(pinned, item.value)) {
      mode = move_unit();
      moved = moved.append(item.value);
    }
    selected = selected.with(i, Supply { ...item, mode: mode });
    i = i - 1;
  }
  let drops: i32[] = [];
  for v in dead {
    if (owned[v] && !has_id(moved, v)) {
      drops = insert_sorted(drops, v);
    }
  }
  return Step { ...s, supplies: selected, drops: drops };
}

function has_id(xs: i32[], v: i32): boolean {
  for x in xs {
    if (x == v) {
      return true;
    }
  }
  return false;
}

function insert_sorted(own xs: i32[], v: i32): i32[] {
  xs = xs.append(v);
  let i: i32 = xs.len() - 1;
  while (i > 0 && xs[i - 1] > v) {
    xs = xs.with(i, xs[i - 1]);
    i = i - 1;
  }
  return xs.with(i, v);
}

pub function plan(f: ssasem.Func, modes: i32[], view: SchemaView): Plan {
  return plan_analyzed(f, modes, ssasem.analyze(f), view);
}

pub function plan_analyzed(f: ssasem.Func, modes: i32[], semantic: ssasem.Analysis, view: SchemaView): Plan {
  if (!semantic.ok) {
    return bad(semantic.why);
  }
  let analysis: ssasem.Analysis = semantic;
  let why: string = contract_error(f, modes, view);
  if (why != "") {
    return bad(why);
  }
  let defs: ssa.SInst[] = definitions(f);
  let owned: boolean[] = owned_values(f, modes, defs);
  let reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
  let sup: SupplyTable = supply_table(f);
  let units: Units = units_of(f, owned, analysis, defs, sup);
  owned = units.owned;
  let takes: i32[] = units.takes;
  analysis = units_analysis(f, analysis, units);
  if (!analysis.ok) {
    return bad(analysis.why);
  }
  let grows: i32[] = [];
  let grow_fields: i32[] = [];
  let kept: boolean[] = analysis.flow.none;
  let entry_kept: boolean[] = analysis.flow.none;
  let vi0: i32 = 0;
  while (vi0 < f.graph.nvals) {
    grows = grows.append(0 - 1);
    grow_fields = grow_fields.append(0 - 1);
    vi0 = vi0 + 1;
  }
  let steps: Step[] = [];
  let live: boolean[] = analysis.flow.none;
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    if (reachable[bi]) {
      let term_uses: i32[] = [];
      if (b.term.kind_tag == 1) {
        term_uses = use_ids(b.term.value, analysis.dependencies);
      }
      if (b.term.kind_tag == 3) {
        term_uses = use_ids(b.term.cond, analysis.dependencies);
      }
      let touched: i32[] = ssalive.live_out_ids(analysis.flow, bi);
      for v in term_uses {
        touched = touched.append(v);
      }
      for v in touched {
        live = live.with(v, true);
      }
      let pos: i32 = b.insts.len() - 1;
      while (pos >= 0) {
        let ins: ssa.SInst = b.insts[pos];
        if (ins.kind_tag != 6 && ins.kind_tag != 8) {
          let dead: i32[] = [];
          if (box_update(ins) && live[ins.args[0]]) {
            kept = kept.with(ins.result, true);
          }
          if (owned[ins.result] && !live[ins.result]) {
            dead = dead.append(ins.result);
          }
          live = live.with(ins.result, false);
          for arg in ins.args {
            if (arg >= 0) {
              if (!live[arg]) {
                dead = dead.append(arg);
                live = live.with(arg, true);
                touched = touched.append(arg);
              }
              for dep in analysis.dependencies[arg] {
                if (!live[dep]) {
                  dead = dead.append(dep);
                  live = live.with(dep, true);
                  touched = touched.append(dep);
                }
              }
            }
          }
          let supplies: Supply[] = sup.at(bi, pos);
          steps = steps.append(steals(f, analysis, owned, defs, bi, pos, hands(f, analysis, owned, defs, bi, pos, choose_ids(step(b.id, pos, 0 - 1), supplies, dead, owned, lent_owners(ins, supplies, analysis.dependencies)))));
          let root: i32 = field_grow_root(f, analysis, owned, defs, bi, pos);
          if (root >= 0) {
            grows = grows.with(ins.result, root);
            grow_fields = grow_fields.with(ins.result, defs[ins.args[0]].imm);
          }
        }
        pos = pos - 1;
      }
      let entry_dead: i32[] = [];
      for ins in b.insts {
        if ((ins.kind_tag == 6 || ins.kind_tag == 8) && owned[ins.result] && !live[ins.result]) {
          entry_dead = entry_dead.append(ins.result);
        }
      }
      for v in touched {
        live = live.with(v, false);
      }
      steps = steps.append(choose_ids(step(b.id, entry_point(), 0 - 1), [], entry_dead, owned, []));
      if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
        steps = steps.append(choose_ids(step(b.id, return_point(), 0 - 1), return_supplies(f, b), term_uses, owned, []));
      }
      for target in successors(b) {
        let si: i32 = ssalive.position(analysis.flow, target);
        entry_kept = entry_kept_of(f, analysis, b, si, entry_kept);
        let dead: i32[] = ssalive.out_not_in(analysis.flow, bi, si);
        steps = steps.append(choose_ids(step(b.id, edge_point(), target), edge_supplies(f, b, si, owned), dead, owned, []));
      }
    }
    bi = bi + 1;
  }
  let literal: boolean[] = literals(f);
  why = view_retain_error(f, steps, literal, defs);
  if (why != "") {
    return bad(why);
  }
  let consts: string[] = constants(f, defs);
  return Plan { ok: true, why: "", steps: steps, owned: owned, literal: literal, grows: grows, grow_fields: grow_fields, takes: takes, held: units.held, payloads: units.payloads, likely: units.likely, kept: kept, entry_kept: entry_kept, frame_views: frame_views(f, defs), constants: consts, text_lens: text_lens(f), analysis: semantic, defs: defs, modes: modes, unit_analysis: analysis, unique_receivers: unique_receivers(f, steps, consts, no_fresh(), lent_withs(f, defs, owned, kept)), fresh_seeded: false, checked_writes: checked_writes(f), links: [], reuse: no_reuse() };
}

pub function without_constant_drops(p: Plan): Plan {
  let out: Step[] = [];
  for st in p.steps {
    let kept: i32[] = [];
    for d in st.drops {
      if (d < 0 || d >= p.constants.len() || p.constants[d] == "") {
        kept = kept.append(d);
      }
    }
    out = out.append(Step { ...st, drops: kept });
  }
  return Plan { ...p, steps: out };
}

function checked_writes(f: ssasem.Func): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    let i: i32 = 0;
    while (i < b.insts.len()) {
      let ins: ssa.SInst = b.insts[i];
      if (ins.kind_tag == ssasem.with() && read_before(b, i, ins.args[0], ins.args[1])) {
        out = out.with(ins.result, true);
      }
      i = i + 1;
    }
  }
  return out;
}

function read_before(b: ssa.SBlock, end: i32, arr: i32, index: i32): boolean {
  let j: i32 = 0;
  while (j < end) {
    let r: ssa.SInst = b.insts[j];
    if (r.kind_tag == ssasem.array_get() && r.args.len() == 2 && r.args[0] == arr && r.args[1] == index) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

function unique_receivers(f: ssasem.Func, steps: Step[], consts: string[], fresh: FreshRows, lent: boolean[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let sole: boolean[] = sole_boxes(f, steps, consts, fresh, 0 - 1, lent);
  let at: i32[] = ssa.block_positions(f.graph);
  for st in steps {
    if (st.point >= 0) {
      let ins: ssa.SInst = f.graph.blocks[at[st.block]].insts[st.point];
      if (box_update(ins) && sole[ins.args[0]] && moved_at(st, ins.args[0], 0)) {
        out = out.with(ins.result, true);
      }
    }
  }
  return out;
}

pub struct FreshRows { rows: util.NameIndex, through: i32[] }

pub function no_fresh(): FreshRows {
  let none: string[] = [];
  return FreshRows { rows: util.name_index(none), through: [] };
}

function fresh_through(fresh: FreshRows, name: string): i32 {
  let i: i32 = fresh.rows.find(name);
  if (i < 0) {
    return 0 - 2;
  }
  return fresh.through[i];
}

pub function fresh_rows(keys: string[], funcs: ssasem.Func[], plans: Plan[]): FreshRows {
  let fresh: FreshRows = no_fresh();
  let named: boolean[] = __alloc_bool(keys.len());
  let check: boolean[] = __alloc_bool(keys.len());
  let i: i32 = 0;
  while (i < keys.len()) {
    check = check.with(i, plans[i].ok && returns_arrays(funcs[i]));
    i = i + 1;
  }
  let grew: boolean = true;
  while (grew) {
    grew = false;
    let added: string[] = [];
    i = 0;
    while (i < keys.len()) {
      if (check[i] && !named[i]) {
        let through: i32 = sole_result(funcs[i], plans[i], fresh);
        if (through >= 0 - 1) {
          named = named.with(i, true);
          fresh = FreshRows { rows: fresh.rows.added(keys[i]), through: fresh.through.append(through) };
          added = added.append(keys[i]);
          grew = true;
        }
      }
      i = i + 1;
    }
    let ix: util.NameIndex = util.name_index(added);
    i = 0;
    while (grew && i < keys.len()) {
      check = check.with(i, check[i] && !named[i] && calls_any(funcs[i], ix));
      i = i + 1;
    }
  }
  return fresh;
}

function sole_result(f: ssasem.Func, p: Plan, fresh: FreshRows): i32 {
  let lent: boolean[] = lent_withs(f, p.defs, p.owned, p.kept);
  if (returns_sole(f, sole_boxes(f, p.steps, p.constants, fresh, 0 - 1, lent))) {
    return 0 - 1;
  }
  let k: i32 = 0;
  while (k < f.graph.nparams) {
    if (is_array(f.values[k]) && p.modes[k] == counted_mode() && returns_sole(f, sole_boxes(f, p.steps, p.constants, fresh, k, lent))) {
      return k;
    }
    k = k + 1;
  }
  return 0 - 2;
}

function returns_arrays(f: ssasem.Func): boolean {
  let returns: i32 = 0;
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1) {
      if (b.term.value < 0 || !is_array(f.values[b.term.value])) {
        return false;
      }
      returns = returns + 1;
    }
  }
  return returns > 0;
}

function returns_sole(f: ssasem.Func, sole: boolean[]): boolean {
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1 && !sole[b.term.value]) {
      return false;
    }
  }
  return true;
}

pub function with_fresh(p: Plan, f: ssasem.Func, fresh: FreshRows): Plan {
  if (!p.ok) {
    return p;
  }
  let seeded: boolean = calls_any(f, fresh.rows);
  if (!seeded && !p.fresh_seeded) {
    return p;
  }
  return Plan { ...p, unique_receivers: unique_receivers(f, p.steps, p.constants, fresh, lent_withs(f, p.defs, p.owned, p.kept)), fresh_seeded: seeded };
}

function calls_any(f: ssasem.Func, names: util.NameIndex): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call() && names.has(ins.str)) {
        return true;
      }
    }
  }
  return false;
}

pub function fresh_rows_agree(a: FreshRows, b: FreshRows, callees: string[]): boolean {
  for callee in callees {
    if (fresh_through(a, callee) != fresh_through(b, callee)) {
      return false;
    }
  }
  return true;
}

function box_update(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssasem.with() || ins.kind_tag == ssasem.append() || ins.kind_tag == ssasem.arr_concat();
}

function moved_at(st: Step, v: i32, slot: i32): boolean {
  for supply in st.supplies {
    if (supply.slot == slot && supply.value == v) {
      return supply.mode == move_unit();
    }
  }
  return false;
}

function passed_slot(ins: ssa.SInst, fresh: FreshRows): i32 {
  if (ins.kind_tag == ssasem.append() || ins.kind_tag == ssasem.arr_concat() || ins.kind_tag == ssasem.call() && rtbytecopy.is_helper(ins.str)) {
    return 0;
  }
  if (ins.kind_tag == ssasem.call() && fresh.through.len() > 0) {
    let through: i32 = fresh_through(fresh, ins.str);
    if (through >= 0) {
      return through;
    }
  }
  return 0 - 1;
}

function sole_boxes(f: ssasem.Func, steps: Step[], consts: string[], fresh: FreshRows, seed: i32, lent: boolean[]): boolean[] {
  let sole: boolean[] = __alloc_bool(f.graph.nvals);
  if (seed >= 0) {
    sole = sole.with(seed, true);
  }
  let pass: i32[] = util.minus_ones(f.graph.nvals);
  let links: SoleLinks = SoleLinks { from: [], to: [], phi: [] };
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result < 0) {
        continue;
      }
      let k: i32 = passed_slot(ins, fresh);
      if (k >= 0) {
        pass = pass.with(ins.result, k);
        links = SoleLinks { from: links.from.append(ins.args[k]), to: links.to.append(ins.result), phi: links.phi.append(false) };
      }
      if (ins.kind_tag == 8) {
        for a in ins.args {
          if (a >= 0) {
            links = SoleLinks { from: links.from.append(a), to: links.to.append(ins.result), phi: links.phi.append(true) };
          }
        }
      }
      if (ins.kind_tag == 8 || ins.kind_tag == ssasem.with() && !lent[ins.result] || k >= 0 || fresh_array(ins, consts, fresh)) {
        sole = sole.with(ins.result, true);
      }
    }
  }
  let at: i32[] = ssa.block_positions(f.graph);
  for st in steps {
    for supply in st.supplies {
      if (supply.value >= 0 && supply.mode != move_unit()) {
        sole = sole.with(supply.value, false);
      }
    }
    if (st.point >= 0) {
      let ins: ssa.SInst = f.graph.blocks[at[st.block]].insts[st.point];
      let i: i32 = 0;
      while (i < ins.args.len()) {
        let a: i32 = ins.args[i];
        let reads: boolean = i == 0 && (ins.kind_tag == ssasem.array_get() || ins.kind_tag == ssasem.length());
        if (a >= 0 && !reads && !moved_at(st, a, i)) {
          sole = sole.with(a, false);
        }
        i = i + 1;
      }
      if (ins.result >= 0 && pass[ins.result] >= 0 && !moved_at(st, ins.args[pass[ins.result]], pass[ins.result])) {
        sole = sole.with(ins.result, false);
      }
    }
  }
  return settled(sole, links);
}

struct SoleLinks { from: i32[], to: i32[], phi: boolean[] }

function lent_withs(f: ssasem.Func, defs: ssa.SInst[], owned: boolean[], kept: boolean[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let seen: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag != ssasem.with() || kept[ins.result]) {
        continue;
      }
      let carried: Carried = carried_params(f, defs, ins.args[0], seen);
      seen = carried.seen;
      for param in carried.params {
        if (!(param < owned.len() && owned[param])) {
          out = out.with(ins.result, true);
        }
      }
    }
  }
  return out;
}

function settled(own sole: boolean[], links: SoleLinks): boolean[] {
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < links.from.len()) {
      let a: i32 = links.from[i];
      let v: i32 = links.to[i];
      if (links.phi[i] && sole[a] != sole[v]) {
        sole = sole.with(a, false).with(v, false);
        changed = true;
      } else if (!links.phi[i] && sole[v] && !sole[a]) {
        sole = sole.with(v, false);
        changed = true;
      }
      i = i + 1;
    }
  }
  return sole;
}

function fresh_array(ins: ssa.SInst, consts: string[], fresh: FreshRows): boolean {
  if (ins.kind_tag == ssasem.bytes_new()) {
    return ins.imm == 0 || consts[ins.result] == "";
  }
  if (ins.kind_tag == ssasem.array_new()) {
    return ins.args.len() == 0 || consts[ins.result] == "";
  }
  if (ins.kind_tag == ssasem.call()) {
    return ins.str == "__alloc_i32" || ins.str == "__alloc_i64" || ins.str == "__alloc_bool" || ins.str == "__alloc_u8" || ssasem.fresh_result_builtin(ins.str) || fresh_through(fresh, ins.str) == 0 - 1;
  }
  return ins.kind_tag == ssasem.array_reserve();
}

function entry_kept_of(f: ssasem.Func, a: ssasem.Analysis, b: ssa.SBlock, si: i32, own out: boolean[]): boolean[] {
  let succ: ssa.SBlock = f.graph.blocks[si];
  let pi: i32 = 0;
  while (succ.preds[pi] != b.id) {
    pi = pi + 1;
  }
  for ins in succ.insts {
    if (ins.kind_tag != 8) {
      continue;
    }
    let v: i32 = ins.args[pi];
    if (v >= 0 && v < f.graph.nparams && ssalive.live_in_has(a.flow, si, v)) {
      out = out.with(v, true);
    }
  }
  return out;
}

function read_error(state: boolean[], value: i32, owned: boolean[], deps: i32[][]): string {
  if (value < 0) {
    return "";
  }
  if (owned[value] && !state[value]) {
    return "read without counted unit";
  }
  for dep in deps[value] {
    if (owned[dep] && !state[dep]) {
      return "borrow outlives container unit";
    }
  }
  return "";
}

function invariant(f: ssasem.Func, bi: i32, owned: boolean[], flow: ssalive.Flow): boolean[] {
  let state: boolean[] = flow.none;
  for v in ssalive.live_in_ids(flow, bi) {
    if (owned[v]) {
      state = state.with(v, true);
    }
  }
  for ins in f.graph.blocks[bi].insts {
    if ((ins.kind_tag == 8 || ins.kind_tag == 6) && owned[ins.result]) {
      state = state.with(ins.result, true);
    }
  }
  return state;
}

function holds_invariant(state: boolean[], f: ssasem.Func, bi: i32, owned: boolean[], flow: ssalive.Flow): boolean {
  let want: i32 = 0;
  for v in ssalive.live_in_ids(flow, bi) {
    if (owned[v]) {
      if (!state[v]) {
        return false;
      }
      want = want + 1;
    }
  }
  for ins in f.graph.blocks[bi].insts {
    if ((ins.kind_tag == 8 || ins.kind_tag == 6) && owned[ins.result] && !ssalive.live_in_has(flow, bi, ins.result)) {
      if (!state[ins.result]) {
        return false;
      }
      want = want + 1;
    }
  }
  let have: i32 = 0;
  for bit in state {
    if (bit) {
      have = have + 1;
    }
  }
  return have == want;
}

function same_bits(a: boolean[], b: boolean[]): boolean {
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function step_index(p: Plan): i32[][] {
  let by_block: i32[][] = steps_by_block(p);
  let out: i32[][] = [];
  for steps in by_block {
    out = out.append(block_step_row(p, steps));
  }
  return out;
}

function steps_by_block(p: Plan): i32[][] {
  let top: i32 = 0 - 1;
  for s in p.steps {
    if (s.block > top) {
      top = s.block;
    }
  }
  let count: i32[] = __alloc_i32(top + 1);
  for s in p.steps {
    if (s.block >= 0) {
      count = count.with(s.block, count[s.block] + 1);
    }
  }
  let out: i32[][] = [];
  let b: i32 = 0;
  while (b <= top) {
    out = out.append(__alloc_i32(count[b]));
    b = b + 1;
  }
  let fill: i32[] = __alloc_i32(top + 1);
  let i: i32 = 0;
  while (i < p.steps.len()) {
    b = p.steps[i].block;
    if (b >= 0) {
      let row: i32[] = out[b];
      out = out.with(b, []);
      out = out.with(b, row.with(fill[b], i));
      fill = fill.with(b, fill[b] + 1);
    }
    i = i + 1;
  }
  return out;
}

function tabled_step(s: Step): boolean {
  return s.target == 0 - 1 && s.point >= return_point();
}

function block_step_row(p: Plan, steps: i32[]): i32[] {
  let n: i32 = 0;
  for i in steps {
    if (tabled_step(p.steps[i]) && p.steps[i].point - return_point() >= n) {
      n = p.steps[i].point - return_point() + 1;
    }
  }
  let m: i32 = 0;
  for i in steps {
    if (!tabled_step(p.steps[i])) {
      m = m + 1;
    }
  }
  let row: i32[] = util.minus_ones(1 + n + m);
  row = row.with(0, n);
  let k: i32 = 1 + n;
  for i in steps {
    let s: Step = p.steps[i];
    if (!tabled_step(s)) {
      row = row.with(k, i);
      k = k + 1;
    } else if (row[1 + s.point - return_point()] < 0) {
      row = row.with(1 + s.point - return_point(), i);
    }
  }
  return row;
}

pub function step_at(p: Plan, idx: i32[][], block: i32, point: i32, target: i32): i32 {
  if (block < 0 || block >= idx.len()) {
    return 0 - 1;
  }
  let row: i32[] = idx[block];
  let n: i32 = row[0];
  if (target == 0 - 1 && point >= return_point()) {
    if (point - return_point() < n) {
      return row[1 + point - return_point()];
    }
    return 0 - 1;
  }
  let at: i32 = 1 + n;
  while (at < row.len()) {
    if (p.steps[row[at]].point == point && p.steps[row[at]].target == target) {
      return row[at];
    }
    at = at + 1;
  }
  return 0 - 1;
}

struct ReplayIndex { positions: i32[], offsets: i32[], slots: i32[] }

function replay_point(b: ssa.SBlock, point: i32, target: i32): i32 {
  if (target == 0 - 1) {
    if (point == entry_point()) {
      return 0;
    }
    if (point == return_point()) {
      return 1;
    }
    if (point >= 0 && point < b.insts.len()) {
      return point + 2;
    }
  }
  if (point == edge_point()) {
    let edge: i32 = b.insts.len() + 2;
    if (b.term.kind_tag == 2 && target == b.term.target) {
      return edge;
    }
    if (b.term.kind_tag == 3) {
      if (target == b.term.t) {
        return edge;
      }
      if (target == b.term.f) {
        return edge + 1;
      }
    }
  }
  return 0 - 1;
}

function replay_index(f: ssasem.Func, p: Plan, flow: ssalive.Flow): ReplayIndex {
  let offsets: i32[] = [];
  let slots: i32[] = [];
  for b in f.graph.blocks {
    offsets = offsets.append(slots.len());
    let n: i32 = b.insts.len() + 4;
    let i: i32 = 0;
    while (i < n) {
      slots = slots.append(0 - 1);
      i = i + 1;
    }
  }
  let i: i32 = 0;
  for s in p.steps {
    let bi: i32 = ssalive.position(flow, s.block);
    if (bi >= 0) {
      let point: i32 = replay_point(f.graph.blocks[bi], s.point, s.target);
      if (point >= 0) {
        let at: i32 = offsets[bi] + point;
        let value: i32 = 0 - 2;
        if (slots[at] == 0 - 1) {
          value = i;
        }
        slots = slots.with(at, value);
      }
    }
    i = i + 1;
  }
  return ReplayIndex { positions: flow.at, offsets: offsets, slots: slots };
}

function find_step(b: ssa.SBlock, idx: ReplayIndex, point: i32, target: i32): i32 {
  let at: i32 = replay_point(b, point, target);
  if (at < 0) {
    return 0 - 1;
  }
  return idx.slots[idx.offsets[idx.positions[b.id]] + at];
}

function supply_error(state: boolean[], supplies: Supply[], wanted: Supply[], owned: boolean[], deps: i32[][]): string {
  if (supplies.len() != wanted.len()) {
    return "unit supply arity";
  }
  let i: i32 = 0;
  while (i < wanted.len()) {
    let got: Supply = supplies[i];
    if (got.value != wanted[i].value || got.slot != wanted[i].slot) {
      return "unit supply identity or slot";
    }
    let why: string = read_error(state, got.value, owned, deps);
    if (why != "") {
      return why;
    }
    if (got.mode != retain_unit() && got.mode != move_unit() && got.mode != steal_unit()) {
      return "invalid unit supply mode";
    }
    i = i + 1;
  }
  return "";
}

function replay_error(state: boolean[], s: Step, wanted: Supply[], result: i32, owned: boolean[], deps: i32[][]): string {
  let why: string = supply_error(state, s.supplies, wanted, owned, deps);
  if (why != "") {
    return why;
  }
  let cleared: i32[] = [];
  for got in s.supplies {
    if (got.mode == move_unit()) {
      if (!owned[got.value] || !state[got.value] || util.index_of_i32(cleared, got.value) >= 0) {
        return "move without counted unit";
      }
      cleared = cleared.append(got.value);
    }
  }
  let set_result: boolean = false;
  if (result >= 0 && owned[result]) {
    if (state[result] && util.index_of_i32(cleared, result) < 0) {
      return "result unit already present";
    }
    set_result = true;
  }
  let dropped: i32[] = [];
  for value in s.drops {
    if (value < 0 || value >= owned.len()) {
      return "drop value out of range";
    }
    let present: boolean = state[value] && util.index_of_i32(cleared, value) < 0 || set_result && value == result;
    if (!owned[value] || !present || util.index_of_i32(dropped, value) >= 0) {
      return "drop without counted unit";
    }
    dropped = dropped.append(value);
  }
  return "";
}

function apply_step(own state: boolean[], s: Step, result: i32, owned: boolean[]): boolean[] {
  for got in s.supplies {
    if (got.mode == move_unit()) {
      state = state.with(got.value, false);
    }
  }
  if (result >= 0 && owned[result]) {
    state = state.with(result, true);
  }
  for value in s.drops {
    state = state.with(value, false);
  }
  return state;
}

function copy_row(state: boolean[]): boolean[] {
  if (state.len() == 0) {
    return state;
  }
  return state.with(0, state[0]);
}

struct ReplayProgress { why: string, state: boolean[], count: i32 }

function progress_error(why: string): ReplayProgress {
  return ReplayProgress { why: why, state: [], count: 0 };
}

function verify_operations(f: ssasem.Func, b: ssa.SBlock, p: Plan, idx: ReplayIndex, own state: boolean[], owned: boolean[], deps: i32[][]): ReplayProgress {
  let at0: i32 = find_step(b, idx, entry_point(), 0 - 1);
  if (at0 < 0) {
    return progress_error("missing or duplicate entry step");
  }
  let entry_why: string = replay_error(state, p.steps[at0], [], 0 - 1, owned, deps);
  if (entry_why != "") {
    return progress_error(entry_why);
  }
  let next: boolean[] = apply_step(state, p.steps[at0], 0 - 1, owned);
  let count: i32 = 0;
  let pos: i32 = 0;
  for ins in b.insts {
    if (ins.kind_tag != 6 && ins.kind_tag != 8) {
      for arg in ins.args {
        let why: string = read_error(next, arg, owned, deps);
        if (why != "") {
          return progress_error(why);
        }
      }
      let at: i32 = find_step(b, idx, pos, 0 - 1);
      if (at < 0) {
        return progress_error("missing or duplicate operation step");
      }
      let supplies: Supply[] = operation_supplies(f, ins);
      let lent: string = lent_error(next, p.steps[at], ins, supplies, owned, deps);
      if (lent != "") {
        return progress_error(lent);
      }
      let why: string = replay_error(next, p.steps[at], supplies, ins.result, owned, deps);
      if (why != "") {
        return progress_error(why);
      }
      next = apply_step(next, p.steps[at], ins.result, owned);
      count = count + 1;
    }
    pos = pos + 1;
  }
  return ReplayProgress { why: "", state: next, count: count };
}

function lent_error(state: boolean[], s: Step, ins: ssa.SInst, counted: Supply[], owned: boolean[], deps: i32[][]): string {
  if (s.supplies.len() != counted.len()) {
    return "";
  }
  let cleared: i32[] = [];
  for got in s.supplies {
    if (got.mode == move_unit()) {
      if (!owned[got.value] || !state[got.value] || util.index_of_i32(cleared, got.value) >= 0) {
        return "";
      }
      cleared = cleared.append(got.value);
    }
  }
  for v in lent_operands(ins, counted) {
    if (lent_cleared(v, state, owned, cleared)) {
      return "a lent call operand borrows from a unit moved into the call";
    }
    for dep in deps[v] {
      if (dep != v && lent_cleared(dep, state, owned, cleared)) {
        return "a lent call operand borrows from a unit moved into the call";
      }
    }
  }
  return "";
}

function lent_cleared(value: i32, state: boolean[], owned: boolean[], cleared: i32[]): boolean {
  return owned[value] && (!state[value] || has_id(cleared, value));
}

function step_clears(s: Step, value: i32): boolean {
  for got in s.supplies {
    if (got.mode == move_unit() && got.value == value) {
      return true;
    }
  }
  return util.index_of_i32(s.drops, value) >= 0;
}

function verify_return(f: ssasem.Func, b: ssa.SBlock, p: Plan, idx: ReplayIndex, state: boolean[], owned: boolean[], deps: i32[][]): string {
  if (b.term.kind_tag == 1) {
    let why: string = read_error(state, b.term.value, owned, deps);
    if (why != "") {
      return why;
    }
  }
  let at: i32 = find_step(b, idx, return_point(), 0 - 1);
  if (at < 0) {
    return "missing or duplicate return step";
  }
  let why: string = replay_error(state, p.steps[at], return_supplies(f, b), 0 - 1, owned, deps);
  if (why != "") {
    return why;
  }
  let v: i32 = 0;
  while (v < state.len()) {
    if (state[v] && !step_clears(p.steps[at], v)) {
      return "counted unit leaks at return";
    }
    v = v + 1;
  }
  return "";
}

function enter_phis(b: ssa.SBlock, own state: boolean[], owned: boolean[]): Ledger {
  for ins in b.insts {
    if (ins.kind_tag == 8 && owned[ins.result]) {
      if (state[ins.result]) {
        return rejected("phi unit already present");
      }
      state = state.with(ins.result, true);
    }
  }
  return Ledger { ok: true, why: "", bits: state };
}

function verify_edge(f: ssasem.Func, b: ssa.SBlock, target: i32, p: Plan, idx: ReplayIndex, own state: boolean[], owned: boolean[], analysis: ssasem.Analysis): string {
  let at: i32 = find_step(b, idx, edge_point(), target);
  if (at < 0) {
    return "missing or duplicate edge step";
  }
  let si: i32 = ssalive.position(analysis.flow, target);
  let why: string = replay_error(state, p.steps[at], edge_supplies(f, b, si, owned), 0 - 1, owned, analysis.dependencies);
  if (why != "") {
    return why;
  }
  let left: boolean[] = apply_step(state, p.steps[at], 0 - 1, owned);
  let entered: Ledger = enter_phis(f.graph.blocks[si], left, owned);
  if (!entered.ok) {
    return entered.why;
  }
  if (!holds_invariant(entered.bits, f, si, owned, analysis.flow)) {
    return "edge unit invariant mismatch";
  }
  return "";
}

struct BlockProgress { why: string, count: i32 }

function verify_block(f: ssasem.Func, bi: i32, p: Plan, idx: ReplayIndex, owned: boolean[], analysis: ssasem.Analysis): BlockProgress {
  let b: ssa.SBlock = f.graph.blocks[bi];
  let entry_row: boolean[] = invariant(f, bi, owned, analysis.flow);
  let operations: ReplayProgress = verify_operations(f, b, p, idx, entry_row, owned, analysis.dependencies);
  if (operations.why != "") {
    return BlockProgress { why: operations.why, count: 0 };
  }
  let state: boolean[] = operations.state;
  let count: i32 = 1 + operations.count;
  if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
    let why: string = verify_return(f, b, p, idx, state, owned, analysis.dependencies);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
    count = count + 1;
  }
  if (b.term.kind_tag == 3) {
    let why: string = read_error(state, b.term.cond, owned, analysis.dependencies);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
  }
  let targets: i32[] = successors(b);
  if (targets.len() == 2) {
    let first: boolean[] = copy_row(state);
    let why: string = verify_edge(f, b, targets[0], p, idx, first, owned, analysis);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
    count = count + 1;
  }
  if (targets.len() > 0) {
    let why: string = verify_edge(f, b, targets[targets.len() - 1], p, idx, state, owned, analysis);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
    count = count + 1;
  }
  return BlockProgress { why: "", count: count };
}

function same_i32s(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function verify(f: ssasem.Func, modes: i32[], p: Plan): string {
  return verify_analyzed(f, modes, p, ssasem.analyze(f), true);
}

pub function verify_planned(f: ssasem.Func, modes: i32[], p: Plan): string {
  return verify_analyzed(f, modes, p, p.analysis, false);
}

function verify_analyzed(f: ssasem.Func, modes: i32[], p: Plan, semantic: ssasem.Analysis, whole: boolean): string {
  if (!p.ok || p.why != "") {
    return "missing successful unit plan";
  }
  let analysis: ssasem.Analysis = semantic;
  if (!analysis.ok) {
    return analysis.why;
  }
  let why: string = "";
  let defs: ssa.SInst[] = p.defs;
  if (whole) {
    why = contract_error(f, modes, no_view());
    defs = definitions(f);
  } else if (modes.len() != f.params.len()) {
    why = "parameter mode dimensions";
  } else {
    why = mode_error(f.params, modes);
  }
  if (why != "") {
    return why;
  }
  let owned: boolean[] = p.owned;
  if (whole || !same_i32s(modes, p.modes)) {
    let units: Units = units_of(f, owned_values(f, modes, defs), analysis, defs, supply_table(f));
    owned = units.owned;
    if (!same_i32s(units.takes, p.takes)) {
      return "tuple take disagrees with the plan";
    }
    if (!same_bits(units.held, p.held)) {
      return "element hold disagrees with the plan";
    }
    if (!same_bits(units.payloads, p.payloads)) {
      return "payload take disagrees with the plan";
    }
    analysis = units_analysis(f, analysis, units);
    if (!analysis.ok) {
      return analysis.why;
    }
  } else {
    analysis = p.unit_analysis;
  }
  let reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
  let idx: ReplayIndex = replay_index(f, p, analysis.flow);
  let count: i32 = 0;
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    if (reachable[bi]) {
      let done: BlockProgress = verify_block(f, bi, p, idx, owned, analysis);
      if (done.why != "") {
        return done.why;
      }
      count = count + done.count;
    }
    bi = bi + 1;
  }
  if (count != p.steps.len()) {
    return "extra unit plan steps";
  }
  return verify_reuse(f, p, reachable);
}

pub struct Reuse { pairs: ReusePairs[], keeps: Keeps[], carry: Carry, reads: VariantReads, disabled: boolean }

pub function no_reuse(): Reuse {
  return Reuse { pairs: [], keeps: [], carry: no_carry(), reads: VariantReads { at: [], dom: ssadeps.Dom { pre: [], post: [], idom: [], by_clock: [] }, sites: [], names: [], shared: [] }, disabled: false };
}

pub function reuse_layer_disabled(name: string): boolean {
  return envflag.on("FERN_SELFHOST_NO_REUSE") || !optbisect.allowed("reuse", name);
}

pub function with_reuse(f: ssasem.Func, p: Plan, idx: i32[][], dom: ssadeps.Dom): Plan {
  if (p.reuse.pairs.len() == f.graph.blocks.len()) {
    return p;
  }
  let off: boolean = reuse_layer_disabled(f.graph.name);
  if (!p.ok) {
    return Plan { ...p, reuse: Reuse { ...p.reuse, disabled: off } };
  }
  let links: i32[] = links_of(f, p, idx);
  let vr: VariantReads = variant_reads(f, p, dom);
  let carry: Carry = carried_pairs(f, p, idx, links, off, vr);
  let uses: ssasem.Uses = p.analysis.uses;
  let pairs: ReusePairs[] = [];
  let keeps: Keeps[] = [];
  for b in f.graph.blocks {
    let pr: ReusePairs = reuse_pairs(f, p, idx, vr, b, off, carry);
    keeps = keeps.append(block_keeps(f, p, idx, b, pr, carry, links, uses));
    pairs = pairs.append(pr);
  }
  return Plan { ...p, links: links, reuse: Reuse { pairs: pairs, keeps: keeps, carry: carry, reads: vr, disabled: off } };
}

function static_box(p: Plan, d: i32): boolean {
  return d >= 0 && d < p.constants.len() && p.constants[d] != "";
}

function step_of(p: Plan, idx: i32[][], block: i32, point: i32, target: i32): Step {
  let i: i32 = step_at(p, idx, block, point, target);
  if (i >= 0) {
    return p.steps[i];
  }
  return Step { block: 0 - 1, point: point, target: 0 - 1, supplies: [], drops: [], hand_roots: [], hand_fields: [] };
}

function record_fields(t: typeinfo.Type, f: ssasem.Func): semrecords.Field[] {
  return f.records.list[semrecords.find(f.records, t)].fields;
}

function tuple_elements(t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements;
  }
  return [];
}

pub function payload_taken(f: ssasem.Func, p: Plan, ins: ssa.SInst): boolean {
  return ins.result < p.payloads.len() && p.payloads[ins.result] && shell_root(f, p, ins) < 0;
}

pub function deferred_retain(f: ssasem.Func, p: Plan, step: Step, ins: ssa.SInst): boolean {
  if (string_append(f, ins)) {
    return receiver_retained(step);
  }
  if (!box_update(ins)) {
    return false;
  }
  if (p.grows[ins.result] < 0 && ins.args[0] >= f.graph.nparams) {
    return false;
  }
  if (ins.args[0] < p.owned.len() && p.owned[ins.args[0]]) {
    return false;
  }
  if (p.grows[ins.result] < 0 && p.kept[ins.result]) {
    return false;
  }
  return receiver_retained(step);
}

pub function receiver_retained(step: Step): boolean {
  for supply in step.supplies {
    if (supply.slot == 0 && supply.mode == retain_unit()) {
      return true;
    }
  }
  return false;
}

pub struct ReusePairs { tokens: i32[], builds: i32[], selfs: i32[] }

function reuse_slots(t: typeinfo.Type, f: ssasem.Func): i32 {
  if (semtypes.is_env(t) || semtypes.is_cell(t)) {
    return 0 - 1;
  }
  if (ssasem.has_finalizer(f, t)) {
    return 0 - 1;
  }
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements.len();
  }
  if let typeinfo.TypeStruct(_) = t {
    if (semrecords.find(f.records, t) < 0) {
      return 0 - 1;
    }
    return record_fields(t, f).len() + 1;
  }
  if let typeinfo.TypeUnion(_) = t {
    return union_slots(t, f);
  }
  return 0 - 1;
}

function union_slots(t: typeinfo.Type, f: ssasem.Func): i32 {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return 0 - 1;
  }
  if (f.enums[at].layout == semrecords.layout_option()) {
    return 0 - 1;
  }
  let n: i32 = 0 - 1;
  for v in f.enums[at].variants {
    if (n < 0) {
      n = v.fields.len();
    } else if (n != v.fields.len()) {
      return 0 - 1;
    }
  }
  if (n < 0) {
    return 0 - 1;
  }
  return n + 1;
}

function variant_slots(t: typeinfo.Type, name: string, f: ssasem.Func): i32 {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0 || f.enums[at].layout == semrecords.layout_option()) {
    return 0 - 1;
  }
  let v: i32 = semrecords.find_variant(f.enums[at], name);
  if (v < 0) {
    return 0 - 1;
  }
  return f.enums[at].variants[v].fields.len() + 1;
}

function donor_slots(f: ssasem.Func, vr: VariantReads, b: ssa.SBlock, d: i32): i32 {
  let t: typeinfo.Type = f.values[d];
  let n: i32 = reuse_slots(t, f);
  if (n >= 0 || ssasem.has_finalizer(f, t)) {
    return n;
  }
  let name: string = known_variant(vr, b, d);
  if (name == "") {
    return 0 - 1;
  }
  return variant_slots(t, name, f);
}

pub function known_variant(vr: VariantReads, b: ssa.SBlock, d: i32): string {
  if (d < 0 || d >= vr.sites.len() || b.id < 0 || b.id >= vr.at.len() || vr.at[b.id] < 0) {
    return "";
  }
  if (d < vr.shared.len() && vr.shared[d]) {
    return "";
  }
  let bp: i32 = vr.at[b.id];
  let k: i32 = 0;
  while (k < vr.sites[d].len()) {
    if (vr.sites[d][k] == bp || ssadeps.dom_holds(vr.dom, bp, vr.sites[d][k])) {
      return vr.names[d][k];
    }
    k = k + 1;
  }
  return "";
}

pub struct VariantReads { at: i32[], dom: ssadeps.Dom, sites: i32[][], names: string[][], shared: boolean[] }

function variant_reads(f: ssasem.Func, p: Plan, dom: ssadeps.Dom): VariantReads {
  let sites: i32[][] = [];
  let names: string[][] = [];
  let shared: boolean[] = __alloc_bool(f.values.len());
  while (sites.len() < f.values.len()) {
    sites = sites.append([]);
    names = names.append([]);
  }
  let bi: i32 = 0;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.variant_get() && ins.args.len() == 1 && ins.args[0] >= 0 && ins.args[0] < sites.len()) {
        let v: i32 = ins.args[0];
        if (sites[v].len() == 0 && !(v < p.likely.len() && p.likely[v]) && !(v < p.payloads.len() && p.payloads[v]) && member_union(f, f.values[v])) {
          shared = shared.with(v, true);
        }
        sites = sites.with(v, sites[v].append(bi));
        names = names.with(v, names[v].append(ins.str));
      }
    }
    bi = bi + 1;
  }
  return VariantReads { at: ssa.block_positions(f.graph), dom: dom, sites: sites, names: names, shared: shared };
}

function recipient_slots(f: ssasem.Func, p: Plan, ins: ssa.SInst): i32 {
  if (p.constants[ins.result] != "") {
    return 0 - 1;
  }
  if (ins.kind_tag == ssasem.tuple_new()) {
    return tuple_elements(f.values[ins.result]).len();
  }
  if (ins.kind_tag == ssasem.record_new()) {
    return reuse_slots(f.values[ins.result], f);
  }
  if (ins.kind_tag == ssasem.variant_new()) {
    let n: i32 = union_slots(f.values[ins.result], f);
    if (n < 0) {
      n = variant_slots(f.values[ins.result], ins.str, f);
    }
    return n;
  }
  return 0 - 1;
}

struct Claims { counts: i32[], last: i32[] }

function block_claims(f: ssasem.Func, p: Plan, b: ssa.SBlock): Claims {
  let counts: i32[] = [];
  let last: i32[] = [];
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let c: i32 = recipient_slots(f, p, b.insts[pos]);
    if (c >= 0) {
      let at: i32 = util.index_of_i32(counts, c);
      if (at < 0) {
        counts = counts.append(c);
        last = last.append(pos);
      } else {
        last = last.with(at, pos);
      }
    }
    pos = pos + 1;
  }
  return Claims { counts: counts, last: last };
}

function claimed_after(c: Claims, slots: i32, pos: i32): boolean {
  let at: i32 = util.index_of_i32(c.counts, slots);
  return at >= 0 && c.last[at] > pos;
}

pub struct Carry { from: i32[], drop_at: i32[], held: i32[], to: i32[], build_at: i32[], donor: i32[], exit_from: i32[], exit_to: i32[], dropped: i32[], null_from: i32[], null_to: i32[], nulled: i32[] }

function no_carry(): Carry {
  return Carry { from: [], drop_at: [], held: [], to: [], build_at: [], donor: [], exit_from: [], exit_to: [], dropped: [], null_from: [], null_to: [], nulled: [] };
}

function first_claim_of(f: ssasem.Func, p: Plan, b: ssa.SBlock, slots: i32): i32 {
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let ins: ssa.SInst = b.insts[pos];
    if (ins.kind_tag != 6 && ins.kind_tag != 8 && recipient_slots(f, p, ins) == slots) {
      return pos;
    }
    pos = pos + 1;
  }
  return 0 - 1;
}

function last_claim(f: ssasem.Func, p: Plan, b: ssa.SBlock): i32 {
  let pos: i32 = b.insts.len() - 1;
  while (pos >= 0) {
    let ins: ssa.SInst = b.insts[pos];
    if (ins.kind_tag != 6 && ins.kind_tag != 8 && recipient_slots(f, p, ins) >= 0) {
      return pos;
    }
    pos = pos - 1;
  }
  return 0 - 1;
}

struct Routes { targets: i32[], ways: i32[][], nulls: i32[][] }

struct RouteGraph { at: i32[], claims: i32[][], dies: i32[][], reads: VariantReads }

function route_graph(f: ssasem.Func, p: Plan, dying: Dying[], vr: VariantReads): RouteGraph {
  let claims: i32[][] = [];
  let dies: i32[][] = [];
  let k: i32 = 0;
  while (k < f.graph.blocks.len()) {
    claims = claims.append(block_claims(f, p, f.graph.blocks[k]).counts);
    dies = dies.append(dying[k].values);
    k = k + 1;
  }
  return RouteGraph { at: vr.at, claims: claims, dies: dies, reads: vr };
}

function claims_slots(g: RouteGraph, k: i32, slots: i32): boolean {
  return util.index_of_i32(g.claims[k], slots) >= 0;
}

struct RouteMarks { seen: i32[], way: i32[], stamp: i32 }

struct Searched { routes: Routes, marks: RouteMarks }

struct Way { ok: boolean, blocks: i32[], nulls: i32[], marks: RouteMarks }

function route_marks(n: i32): RouteMarks {
  let seen: i32[] = [];
  let way: i32[] = [];
  while (seen.len() < n) {
    seen = seen.append(0);
    way = way.append(0);
  }
  return RouteMarks { seen: seen, way: way, stamp: 0 };
}

function carry_routes(f: ssasem.Func, g: RouteGraph, sources: i32[], own m: RouteMarks, slots: i32, d: i32): Searched {
  let ahead: i32 = m.stamp + 1;
  let seen: i32[] = m.seen;
  let way: i32[] = m.way;
  let builds: i32[] = [];
  let work: i32[] = [];
  for id in sources {
    for s in successors(f.graph.blocks[g.at[id]]) {
      work = work.append(s);
    }
  }
  let next: i32 = 0;
  while (next < work.len()) {
    let id: i32 = work[next];
    next = next + 1;
    let k: i32 = g.at[id];
    if (util.index_of_i32(sources, id) >= 0 || seen[k] == ahead) {
      continue;
    }
    seen = seen.with(k, ahead);
    if (claims_slots(g, k, slots)) {
      builds = builds.append(id);
    } else {
      for s in successors(f.graph.blocks[k]) {
        work = work.append(s);
      }
    }
  }
  m = RouteMarks { seen: seen, way: way, stamp: ahead };
  let found: Routes = Routes { targets: [], ways: [], nulls: [] };
  for target in builds {
    let w: Way = way_to(f, g, sources, m, ahead, target, slots, d);
    m = w.marks;
    if (w.ok) {
      found = Routes { targets: found.targets.append(target), ways: found.ways.append(w.blocks), nulls: found.nulls.append(w.nulls) };
    }
  }
  return Searched { routes: found, marks: m };
}

function way_to(f: ssasem.Func, g: RouteGraph, sources: i32[], own m: RouteMarks, ahead: i32, target: i32, slots: i32, d: i32): Way {
  let stamp: i32 = m.stamp + 1;
  let seen: i32[] = m.seen;
  let way: i32[] = m.way;
  let between: i32[] = [];
  let entry: Preds = split_preds(f, g, sources, target, slots, d);
  let work: i32[] = entry.carrying;
  let next: i32 = 0;
  while (next < work.len()) {
    let id: i32 = work[next];
    next = next + 1;
    let k: i32 = g.at[id];
    if (util.index_of_i32(sources, id) >= 0 || way[k] == stamp) {
      continue;
    }
    if (seen[k] != ahead || claims_slots(g, k, slots)) {
      return Way { ok: false, blocks: [], nulls: [], marks: RouteMarks { seen: seen, way: way, stamp: stamp } };
    }
    between = between.append(id);
    way = way.with(k, stamp);
    for pr in f.graph.blocks[k].preds {
      work = work.append(pr);
    }
  }
  return Way { ok: true, blocks: between, nulls: entry.nulls, marks: RouteMarks { seen: seen, way: way, stamp: stamp } };
}

struct Preds { carrying: i32[], nulls: i32[] }

function split_preds(f: ssasem.Func, g: RouteGraph, sources: i32[], target: i32, slots: i32, d: i32): Preds {
  let out: Preds = Preds { carrying: [], nulls: [] };
  for pr in f.graph.blocks[g.at[target]].preds {
    if (null_edge(f, g, sources, pr, slots, d)) {
      out = Preds { ...out, nulls: out.nulls.append(pr) };
    } else {
      out = Preds { ...out, carrying: out.carrying.append(pr) };
    }
  }
  return out;
}

function null_edge(f: ssasem.Func, g: RouteGraph, sources: i32[], id: i32, slots: i32, d: i32): boolean {
  let k: i32 = g.at[id];
  return util.index_of_i32(sources, id) < 0 && util.index_of_i32(g.dies[k], d) >= 0
    && donor_slots(f, g.reads, f.graph.blocks[k], d) != slots;
}

struct Dying { at: i32[], values: i32[] }

function dying_after_claims(p: Plan, idx: i32[][], links: i32[], b: ssa.SBlock, claim: i32): Dying {
  let out: Dying = Dying { at: [], values: [] };
  let pos: i32 = claim + 1;
  while (pos < b.insts.len()) {
    if (b.insts[pos].kind_tag != 6 && b.insts[pos].kind_tag != 8) {
      for d in step_of(p, idx, b.id, pos, 0 - 1).drops {
        if (d != b.insts[pos].result && (d >= links.len() || links[d] < 0) && !static_box(p, d)) {
          out = Dying { at: out.at.append(pos), values: out.values.append(d) };
        }
      }
    }
    pos = pos + 1;
  }
  return out;
}

struct Holds { blocks: i32[], at: i32[], slots: i32 }

function holds_of(f: ssasem.Func, vr: VariantReads, dying: Dying[], holding: boolean[], first: i32, d: i32, at0: i32, slots: i32): Holds {
  let h: Holds = Holds { blocks: [f.graph.blocks[first].id], at: [at0], slots: slots };
  let bj: i32 = first + 1;
  while (bj < dying.len()) {
    let j: i32 = util.index_of_i32(dying[bj].values, d);
    if (!holding[bj] && j >= 0 && can_hold(f.graph.blocks[bj]) && donor_slots(f, vr, f.graph.blocks[bj], d) == slots) {
      h = Holds { ...h, blocks: h.blocks.append(f.graph.blocks[bj].id), at: h.at.append(dying[bj].at[j]) };
    }
    bj = bj + 1;
  }
  return h;
}

function can_hold(b: ssa.SBlock): boolean {
  return successors(b).len() > 0;
}

function carried_pairs(f: ssasem.Func, p: Plan, idx: i32[][], links: i32[], off: boolean, vr: VariantReads): Carry {
  let c: Carry = no_carry();
  if (off) {
    return c;
  }
  let dying: Dying[] = [];
  let holding: boolean[] = [];
  for b in f.graph.blocks {
    dying = dying.append(dying_after_claims(p, idx, links, b, last_claim(f, p, b)));
    holding = holding.append(false);
  }
  let g: RouteGraph = route_graph(f, p, dying, vr);
  let marks: RouteMarks = route_marks(f.graph.blocks.len());
  let bi: i32 = 0;
  while (bi < dying.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    let tried: i32[] = [];
    let i: i32 = 0;
    while (!holding[bi] && can_hold(b) && i < dying[bi].values.len()) {
      let d: i32 = dying[bi].values[i];
      let slots: i32 = donor_slots(f, g.reads, b, d);
      if (slots >= 0) {
        let h: Holds = holds_of(f, g.reads, dying, holding, bi, d, dying[bi].at[i], slots);
        if (h.blocks.len() > 1 || util.index_of_i32(tried, slots) < 0) {
          tried = tried.append(slots);
          let found: Searched = carry_routes(f, g, h.blocks, marks, slots, d);
          marks = found.marks;
          let before: i32 = c.to.len();
          c = served_by(f, p, g, c, h, found.routes, d);
          if (c.to.len() > before) {
            for id in h.blocks {
              holding = holding.with(g.at[id], true);
            }
          }
        }
      }
      i = i + 1;
    }
    bi = bi + 1;
  }
  return c;
}

function served_by(f: ssasem.Func, p: Plan, g: RouteGraph, own c: Carry, h: Holds, r: Routes, d: i32): Carry {
  let targets: i32[] = [];
  let builds: i32[] = [];
  let inside: i32[] = [];
  let k: i32 = 0;
  while (k < r.targets.len()) {
    let to: ssa.SBlock = f.graph.blocks[g.at[r.targets[k]]];
    let at_build: i32 = first_claim_of(f, p, to, h.slots);
    if (util.index_of_i32(c.to, to.id) < 0 && util.index_of_i32(to.insts[at_build].args, d) < 0) {
      targets = targets.append(to.id);
      builds = builds.append(at_build);
      c = with_null_edges(c, r.nulls[k], to.id, d);
      for id in r.ways[k] {
        inside = inside.append(id);
      }
    }
    k = k + 1;
  }
  if (targets.len() == 0) {
    return c;
  }
  k = 0;
  while (k < targets.len()) {
    c = Carry { ...c, to: c.to.append(targets[k]), build_at: c.build_at.append(builds[k]), donor: c.donor.append(d) };
    k = k + 1;
  }
  k = 0;
  while (k < h.blocks.len()) {
    c = Carry { ...c, from: c.from.append(h.blocks[k]), drop_at: c.drop_at.append(h.at[k]), held: c.held.append(d) };
    k = k + 1;
  }
  let leaving: i32[] = h.blocks;
  for id in inside {
    if (util.index_of_i32(leaving, id) < 0) {
      leaving = leaving.append(id);
    }
  }
  for id in leaving {
    for s in successors(f.graph.blocks[g.at[id]]) {
      if (util.index_of_i32(targets, s) < 0 && util.index_of_i32(inside, s) < 0) {
        c = Carry { ...c, exit_from: c.exit_from.append(id), exit_to: c.exit_to.append(s), dropped: c.dropped.append(d) };
      }
    }
  }
  return c;
}

function with_null_edges(own c: Carry, from: i32[], to: i32, d: i32): Carry {
  for id in from {
    c = Carry { ...c, null_from: c.null_from.append(id), null_to: c.null_to.append(to), nulled: c.nulled.append(d) };
  }
  return c;
}

pub function carry_nulls(c: Carry, from: i32, to: i32): i32[] {
  let out: i32[] = [];
  let e: i32 = 0;
  while (e < c.null_from.len()) {
    if (c.null_from[e] == from && c.null_to[e] == to) {
      out = out.append(c.nulled[e]);
    }
    e = e + 1;
  }
  return out;
}

pub function carry_exits(c: Carry, from: i32, to: i32): i32[] {
  let out: i32[] = [];
  let e: i32 = 0;
  while (e < c.exit_from.len()) {
    if (c.exit_from[e] == from && c.exit_to[e] == to) {
      out = out.append(c.dropped[e]);
    }
    e = e + 1;
  }
  return out;
}

pub function carry_held_for(c: Carry, b: i32, pos: i32): boolean {
  let into: i32 = util.index_of_i32(c.to, b);
  return into >= 0 && c.build_at[into] == pos;
}

pub function carry_held(c: Carry, b: i32, pos: i32): i32 {
  let i: i32 = 0;
  while (i < c.from.len()) {
    if (c.from[i] == b && c.drop_at[i] == pos) {
      return c.held[i];
    }
    i = i + 1;
  }
  return 0 - 1;
}

function reuse_pairs(f: ssasem.Func, p: Plan, idx: i32[][], vr: VariantReads, b: ssa.SBlock, off: boolean, carry: Carry): ReusePairs {
  let into: i32 = util.index_of_i32(carry.to, b.id);
  let tokens: i32[] = [];
  let builds: i32[] = [];
  let selfs: i32[] = [];
  let claims_tab: Claims = block_claims(f, p, b);
  let pending: i32[] = [];
  let pending_at: i32[] = [];
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    tokens = tokens.append(0 - 1);
    builds = builds.append(0 - 1);
    selfs = selfs.append(0 - 1);
    let ins: ssa.SInst = b.insts[pos];
    if (into >= 0 && carry.build_at[into] == pos) {
      selfs = selfs.with(pos, carry.donor[into]);
    } else if (ins.kind_tag != 6 && ins.kind_tag != 8) {
      let step: Step = step_of(p, idx, b.id, pos, 0 - 1);
      let claims: i32 = recipient_slots(f, p, ins);
      if (off) {
        pending = [];
        pending_at = [];
      } else {
        let k: i32 = 0 - 1;
        if (claims >= 0) {
          k = held_for(f, vr, b, pending, ins, claims);
        }
        if (k >= 0) {
          builds = builds.with(pos, pending[k]);
          tokens = tokens.with(pending_at[k], pending[k]);
          pending = without_at(pending, k);
          pending_at = without_at(pending_at, k);
        } else if (claims >= 0) {
          for d in step.drops {
            if (selfs[pos] < 0 && d != ins.result && !static_box(p, d)
              && donor_slots(f, vr, b, d) == claims
              && util.index_of_i32(ins.args, d) < 0) {
              selfs = selfs.with(pos, d);
            }
          }
        }
        let taken: boolean = false;
        for d in step.drops {
          let sl: i32 = donor_slots(f, vr, b, d);
          if (!taken && d != selfs[pos] && d != ins.result && sl >= 0 && !static_box(p, d)
            && claimed_after(claims_tab, sl, pos) && util.index_of_i32(pending, d) < 0) {
            pending = pending.append(d);
            pending_at = pending_at.append(pos);
            taken = true;
          }
        }
      }
    }
    pos = pos + 1;
  }
  return ReusePairs { tokens: tokens, builds: builds, selfs: selfs };
}

function held_for(f: ssasem.Func, vr: VariantReads, b: ssa.SBlock, pending: i32[], ins: ssa.SInst, claims: i32): i32 {
  let k: i32 = 0;
  while (k < pending.len()) {
    if (donor_slots(f, vr, b, pending[k]) == claims && util.index_of_i32(ins.args, pending[k]) < 0) {
      return k;
    }
    k = k + 1;
  }
  return 0 - 1;
}

function without_at(xs: i32[], k: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i != k) {
      out = out.append(xs[i]);
    }
    i = i + 1;
  }
  return out;
}

pub struct Keeps { donors: i32[], slots: boolean[][], values: i32[][], late: i32[][], moved: i32[][], freed: boolean[][], start: i32[], taken: i32[], built: i32[] }

function keep_slots(f: ssasem.Func, p: Plan, idx: i32[][], b: ssa.SBlock, ins: ssa.SInst, built: i32, donor: i32, taken: i32, uses: ssasem.Uses): Keeps {
  let none: Keeps = no_keeps();
  if (!rebuilds(f, ins, donor)) {
    return none;
  }
  let slots: boolean[] = [];
  while (slots.len() < ins.args.len()) {
    slots = slots.append(false);
  }
  let freed: boolean[] = slots;
  let moved: i32[] = [];
  let first_moved: i32 = 0 - 1;
  let values: i32[] = [];
  let late: i32[] = [];
  let start: i32 = 0 - 1;
  let retained: i32[] = [];
  for supply in step_of(p, idx, b.id, built, 0 - 1).supplies {
    if (supply.mode == retain_unit()) {
      retained = retained.append(supply.value);
    }
  }
  let scalars: boolean = false;
  let pos: i32 = 0;
  while (pos <= taken) {
    let get: ssa.SInst = b.insts[pos];
    let read: boolean = rebuilt_read(f, ins, get, donor);
    let counted: boolean = read && ssasem.reference(f.values[get.result]);
    let kept: boolean = false;
    if (read && (!counted || payload_taken(f, p, get) != util.index_of_i32(retained, get.result) >= 0)) {
      let i: i32 = util.index_of_i32(ins.args, get.result);
      if (i == get.imm && !slots[i] && occurrences(ins.args, get.result) == 1) {
        kept = true;
        values = values.append(get.result);
        slots = slots.with(i, true);
        if (ssasem.use_count(uses, get.result) == 1 && !held_read(p, get)) {
          late = late.append(get.result);
        }
        if (!counted) {
          scalars = true;
        } else if (start < 0) {
          start = pos;
        }
      }
    }
    if (counted && !kept && payload_taken(f, p, get) && get.imm < freed.len() && slot_reads(b, donor, get.imm, built) == 1) {
      moved = moved.append(get.result);
      freed = freed.with(get.imm, true);
      if (first_moved < 0) {
        first_moved = pos;
      }
    }
    pos = pos + 1;
  }
  if (first_moved >= 0 && only_read(b, donor, first_moved, built) && (start < 0 || first_moved < start)) {
    start = first_moved;
  } else if (first_moved >= 0 && (start < 0 || first_moved < start)) {
    moved = [];
    freed = slots;
  }
  if (start < 0 && scalars) {
    start = taken;
  }
  if (start < 0) {
    return none;
  }
  return Keeps { donors: [donor], slots: [slots], values: [values], late: [late], moved: [moved], freed: [freed], start: [start], taken: [taken], built: [] };
}

pub function no_keeps(): Keeps {
  return Keeps { donors: [], slots: [], values: [], late: [], moved: [], freed: [], start: [], taken: [], built: [] };
}

function rebuilds(f: ssasem.Func, ins: ssa.SInst, donor: i32): boolean {
  if (ins.kind_tag == ssasem.record_new() && member_of(f, ins, donor) != "") {
    return true;
  }
  if (!semtypes.equal(f.values[ins.result], f.values[donor])) {
    return false;
  }
  if (ins.kind_tag == ssasem.record_new()) {
    return true;
  }
  let e: i32 = semrecords.find_enum(f.enums, f.values[donor]);
  return ins.kind_tag == ssasem.variant_new() && e >= 0 && f.enums[e].layout == semrecords.layout_variant();
}

function member_of(f: ssasem.Func, ins: ssa.SInst, donor: i32): string {
  let e: i32 = semrecords.find_enum(f.enums, f.values[donor]);
  if (e < 0 || f.enums[e].layout != semrecords.layout_member()) {
    return "";
  }
  if let typeinfo.TypeStruct(r) = f.values[ins.result] {
    if (r.args.len() == 0 && semrecords.find_variant(f.enums[e], r.name) >= 0) {
      return r.name;
    }
  }
  return "";
}

function rebuilt_read(f: ssasem.Func, ins: ssa.SInst, get: ssa.SInst, donor: i32): boolean {
  if (get.args.len() != 1 || get.args[0] != donor) {
    return false;
  }
  if (ins.kind_tag == ssasem.record_new()) {
    if (get.kind_tag == ssasem.variant_get()) {
      return get.str == member_of(f, ins, donor);
    }
    return get.kind_tag == ssasem.record_get();
  }
  return get.kind_tag == ssasem.variant_get() && get.str == ins.str;
}

function slot_reads(b: ssa.SBlock, v: i32, slot: i32, to: i32): i32 {
  let n: i32 = 0;
  let pos: i32 = 0;
  while (pos <= to && pos < b.insts.len()) {
    let ins: ssa.SInst = b.insts[pos];
    if (taken_read(ins.kind_tag) && ins.args.len() == 1 && ins.args[0] == v && ins.imm == slot) {
      n = n + 1;
    }
    pos = pos + 1;
  }
  return n;
}

function only_read(b: ssa.SBlock, v: i32, from: i32, to: i32): boolean {
  let pos: i32 = from;
  while (pos <= to && pos < b.insts.len()) {
    let ins: ssa.SInst = b.insts[pos];
    if (util.index_of_i32(ins.args, v) >= 0 && !taken_read(ins.kind_tag) && ins.kind_tag != ssasem.variant_is()) {
      return false;
    }
    pos = pos + 1;
  }
  return true;
}

function held_read(p: Plan, ins: ssa.SInst): boolean {
  return ins.result < p.takes.len() && p.takes[ins.result] >= 0
    || ins.result < p.held.len() && p.held[ins.result];
}

function token_busy(pairs: ReusePairs, from: i32, to: i32, own_build: i32): boolean {
  let pos: i32 = 0;
  while (pos < pairs.builds.len()) {
    if (pos != own_build) {
      if (pairs.selfs[pos] >= 0 && pos >= from && pos <= to) {
        return true;
      }
      if (pairs.builds[pos] >= 0 && pos >= from) {
        let t: i32 = util.index_of_i32(pairs.tokens, pairs.builds[pos]);
        if (t <= to) {
          return true;
        }
      }
    }
    pos = pos + 1;
  }
  return false;
}

function block_keeps(f: ssasem.Func, p: Plan, idx: i32[][], b: ssa.SBlock, pairs: ReusePairs, carry: Carry, links: i32[], uses: ssasem.Uses): Keeps {
  let out: Keeps = no_keeps();
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let donor: i32 = pairs.selfs[pos];
    let taken: i32 = pos;
    if (donor < 0 && pairs.builds[pos] >= 0) {
      donor = pairs.builds[pos];
      taken = util.index_of_i32(pairs.tokens, donor);
    }
    if (donor >= 0 && taken >= 0) {
      let k: Keeps = keep_slots(f, p, idx, b, b.insts[pos], pos, donor, taken, uses);
      if (k.donors.len() > 0 && !token_busy(pairs, k.start[0], pos, pos)) {
        out = Keeps {
          donors: out.donors.append(donor), slots: out.slots.append(k.slots[0]),
          values: out.values.append(k.values[0]), late: out.late.append(k.late[0]),
          moved: out.moved.append(k.moved[0]), freed: out.freed.append(k.freed[0]),
          start: out.start.append(k.start[0]), taken: out.taken.append(taken), built: out.built.append(pos),
        };
      }
    }
    pos = pos + 1;
  }
  return classified(f, p, idx, b, pairs, carry, links, out);
}

function classified(f: ssasem.Func, p: Plan, idx: i32[][], b: ssa.SBlock, pairs: ReusePairs, carry: Carry, links: i32[], own out: Keeps): Keeps {
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let dying: i32[] = step_of(p, idx, b.id, pos, 0 - 1).drops;
    if (pairs.tokens[pos] >= 0) {
      dying = dying.append(pairs.tokens[pos]);
    }
    if (carry_held(carry, b.id, pos) >= 0) {
      dying = dying.append(carry_held(carry, b.id, pos));
    }
    for d in dying {
      let start: i32 = first_classified_take(f, p, b, d, pos, links);
      if (start >= 0 && util.index_of_i32(out.donors, d) < 0 && util.index_of_i32(pairs.selfs, d) < 0
        && !token_busy(pairs, start, pos, util.index_of_i32(pairs.builds, d)) && !keep_overlaps(out, start, pos)) {
        let moved: i32[] = [];
        let freed: boolean[] = [];
        let n: i32 = donor_fields(f, b.insts[start], d);
        while (freed.len() < n) {
          freed = freed.append(false);
        }
        let i: i32 = start;
        while (i <= pos) {
          let get: ssa.SInst = b.insts[i];
          if (classified_take(f, p, get, d)) {
            moved = moved.append(get.result);
            freed = freed.with(get.imm, true);
          }
          i = i + 1;
        }
        out = Keeps {
          donors: out.donors.append(d), slots: out.slots.append([]), values: out.values.append([]), late: out.late.append([]),
          moved: out.moved.append(moved), freed: out.freed.append(freed),
          start: out.start.append(start), taken: out.taken.append(pos), built: out.built.append(0 - 1),
        };
      }
    }
    pos = pos + 1;
  }
  return out;
}

function first_classified_take(f: ssasem.Func, p: Plan, b: ssa.SBlock, d: i32, dies: i32, links: i32[]): i32 {
  if (d < 0 || d < links.len() && links[d] >= 0 || !ssasem.reference(f.values[d]) || ssasem.finalizer_of(f, f.values[d]) != "") {
    return 0 - 1;
  }
  let first: i32 = 0 - 1;
  let pos: i32 = 0;
  while (pos <= dies) {
    let ins: ssa.SInst = b.insts[pos];
    if (first < 0 && classified_take(f, p, ins, d)) {
      first = pos;
    }
    if (first >= 0 && util.index_of_i32(ins.args, d) >= 0) {
      let same: boolean = ins.kind_tag == ssasem.record_get() || ins.str == b.insts[first].str;
      let fits: boolean = classified_take(f, p, ins, d) && same && slot_reads(b, d, ins.imm, dies) == 1
        || ins.kind_tag == ssasem.variant_is() || taken_read(ins.kind_tag) && !(ins.result < p.payloads.len() && p.payloads[ins.result]);
      if (!fits || shell_root(f, p, ins) == d) {
        return 0 - 1;
      }
    }
    pos = pos + 1;
  }
  if (first >= 0 && donor_fields(f, b.insts[first], d) < 0) {
    return 0 - 1;
  }
  return first;
}

function classified_take(f: ssasem.Func, p: Plan, ins: ssa.SInst, d: i32): boolean {
  if (ins.args.len() != 1 || ins.args[0] != d || !payload_taken(f, p, ins) || !ssasem.reference(f.values[ins.result])) {
    return false;
  }
  if (ins.kind_tag == ssasem.record_get()) {
    return semrecords.find(f.records, f.values[d]) >= 0;
  }
  let e: i32 = semrecords.find_enum(f.enums, f.values[d]);
  return ins.kind_tag == ssasem.variant_get() && e >= 0 && f.enums[e].layout == semrecords.layout_variant();
}

function donor_fields(f: ssasem.Func, get: ssa.SInst, d: i32): i32 {
  if (get.kind_tag == ssasem.record_get()) {
    return record_fields(f.values[d], f).len();
  }
  let e: i32 = semrecords.find_enum(f.enums, f.values[d]);
  if (e < 0) {
    return 0 - 1;
  }
  let v: i32 = semrecords.find_variant(f.enums[e], get.str);
  if (v < 0) {
    return 0 - 1;
  }
  return f.enums[e].variants[v].fields.len();
}

function keep_overlaps(k: Keeps, from: i32, to: i32): boolean {
  let i: i32 = 0;
  while (i < k.donors.len()) {
    let end: i32 = k.built[i];
    if (end < 0) {
      end = k.taken[i];
    }
    if (k.start[i] <= to && from <= end) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function classified_at(k: Keeps, pos: i32): i32 {
  let i: i32 = 0;
  while (i < k.donors.len()) {
    if (k.built[i] < 0 && k.taken[i] == pos) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function kept_values(k: Keeps): i32[] {
  let out: i32[] = [];
  for vs in k.values {
    for v in vs {
      out = out.append(v);
    }
  }
  return out;
}

pub function token_kept(k: Keeps, pos: i32, donor: i32): boolean {
  let i: i32 = 0;
  while (i < k.taken.len()) {
    if (k.taken[i] == pos && k.built[i] != pos && k.donors[i] == donor) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function moved_values(k: Keeps): i32[] {
  let out: i32[] = [];
  for vs in k.moved {
    for v in vs {
      out = out.append(v);
    }
  }
  return out;
}

pub function late_values(k: Keeps): i32[] {
  let out: i32[] = [];
  for vs in k.late {
    for v in vs {
      out = out.append(v);
    }
  }
  return out;
}

function links_of(f: ssasem.Func, p: Plan, idx: i32[][]): i32[] {
  let top: i32 = 0 - 2;
  let state: i32[] = [];
  let v: i32 = 0;
  while (v < f.graph.nvals) {
    state = state.append(0 - 1);
    v = v + 1;
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    for ins in f.graph.blocks[bi].insts {
      if (link_kind(f, p, ins)) {
        state = state.with(ins.result, top);
      }
    }
    bi = bi + 1;
  }
  let roots: boolean[] = link_roots(f, p);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let next: i32[] = propagate(f, p, idx, state, roots);
    next = prune(f, p, next);
    v = 0;
    while (v < next.len()) {
      if (next[v] != state[v]) {
        changed = true;
      }
      v = v + 1;
    }
    state = next;
  }
  v = 0;
  while (v < state.len()) {
    if (state[v] == top) {
      state = state.with(v, 0 - 1);
    }
    v = v + 1;
  }
  return state;
}

function link_kind(f: ssasem.Func, p: Plan, ins: ssa.SInst): boolean {
  if (box_update(ins)) {
    return p.grows[ins.result] < 0;
  }
  if (ins.kind_tag == ssasem.call()) {
    return is_array_type(f.values[ins.result]) && !ssasem.is_dyn_call(ins.str);
  }
  return ins.kind_tag == 8 && is_array_type(f.values[ins.result]);
}

function is_array_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

function link_roots(f: ssasem.Func, p: Plan): boolean[] {
  let ok: boolean[] = [];
  let v: i32 = 0;
  while (v < f.graph.nparams) {
    ok = ok.append(is_array_type(f.values[v]) && !(v < p.owned.len() && p.owned[v]) && !p.entry_kept[v]);
    v = v + 1;
  }
  return ok;
}

function propagate(f: ssasem.Func, p: Plan, idx: i32[][], state: i32[], roots: boolean[]): i32[] {
  let top: i32 = 0 - 2;
  let out: i32[] = state;
  for b in f.graph.blocks {
    let pos: i32 = 0 - 1;
    for ins in b.insts {
      pos = pos + 1;
      if (state[ins.result] == 0 - 1) {
        continue;
      }
      let root: i32 = top;
      if (box_update(ins)) {
        root = input_root(f, state, roots, ins.args[0]);
        if (ins.args[0] < f.graph.nparams && !deferred_retain(f, p, step_of(p, idx, b.id, pos, 0 - 1), ins)) {
          root = 0 - 1;
        }
      } else if (ins.kind_tag == ssasem.call()) {
        root = call_root(f, step_of(p, idx, b.id, pos, 0 - 1), state, roots, ins);
      } else {
        for a in ins.args {
          let r0: i32 = input_root(f, state, roots, a);
          if (r0 == 0 - 1 || root >= 0 && r0 >= 0 && r0 != root) {
            root = 0 - 1;
          } else if (r0 >= 0 && root == top) {
            root = r0;
          }
        }
      }
      if (root != top || state[ins.result] == top) {
        out = out.with(ins.result, root);
      }
    }
  }
  return out;
}

function call_root(f: ssasem.Func, step: Step, state: i32[], roots: boolean[], ins: ssa.SInst): i32 {
  let modes: i32[] = callee_modes(f, ins);
  let root: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let r0: i32 = input_root(f, state, roots, ins.args[i]);
    if (r0 != 0 - 1) {
      if (root != 0 - 1 || !lent_last(f, step, modes, ins, i)) {
        return 0 - 1;
      }
      root = r0;
    }
    i = i + 1;
  }
  return root;
}

function lent_last(f: ssasem.Func, step: Step, modes: i32[], ins: ssa.SInst, i: i32): boolean {
  let a: i32 = ins.args[i];
  if (i >= modes.len() || modes[i] != borrow_mode() || occurrences(ins.args, a) != 1) {
    return false;
  }
  if (a < f.graph.nparams) {
    return i < step.hand_roots.len() && step.hand_roots[i] == a;
  }
  return util.index_of_i32(step.drops, a) >= 0;
}

function input_root(f: ssasem.Func, state: i32[], roots: boolean[], a: i32): i32 {
  if (a < 0) {
    return 0 - 1;
  }
  if (a < f.graph.nparams) {
    if (roots[a]) {
      return a;
    }
    return 0 - 1;
  }
  return state[a];
}

function prune(f: ssasem.Func, p: Plan, state: i32[]): i32[] {
  let out: i32[] = state;
  let at: i32[] = ssa.block_positions(f.graph);
  for step in p.steps {
    for h in step.hand_roots {
      out = unlink(out, h);
    }
    for supply in step.supplies {
      if (supply.value >= 0 && supply.value < state.len() && state[supply.value] != 0 - 1 && !linked_supply(f, p, at, state, step, supply)) {
        out = unlink(out, supply.value);
      }
    }
  }
  return out;
}

function unlink(own state: i32[], v: i32): i32[] {
  if (v < 0 || v >= state.len()) {
    return state;
  }
  return state.with(v, 0 - 1);
}

function linked_supply(f: ssasem.Func, p: Plan, at: i32[], state: i32[], step: Step, supply: Supply): boolean {
  if (supply.mode != move_unit()) {
    return false;
  }
  let b: ssa.SBlock = f.graph.blocks[at[step.block]];
  if (step.point == return_point()) {
    return b.term.kind_tag == 1 && b.term.value == supply.value;
  }
  if (step.point == edge_point()) {
    let dest: ssa.SBlock = f.graph.blocks[at[step.target]];
    if (supply.slot < 0 || supply.slot >= dest.insts.len()) {
      return false;
    }
    let phi: ssa.SInst = dest.insts[supply.slot];
    return phi.kind_tag == 8 && same_root(state[phi.result], state[supply.value]);
  }
  if (step.point < 0) {
    return false;
  }
  let ins: ssa.SInst = b.insts[step.point];
  return box_update(ins) && supply.slot == 0 && ins.args[0] == supply.value && p.grows[ins.result] < 0;
}

function same_root(a: i32, b: i32): boolean {
  if (a == 0 - 1 || b == 0 - 1) {
    return false;
  }
  return a == b || a == 0 - 2 || b == 0 - 2;
}

function verify_reuse(f: ssasem.Func, p: Plan, reachable: boolean[]): string {
  let idx: i32[][] = step_index(p);
  let r: Reuse = p.reuse;
  if (r.pairs.len() == 0 && r.keeps.len() == 0 && r.carry.from.len() == 0 && r.carry.to.len() == 0) {
    return "";
  }
  if (r.pairs.len() != f.graph.blocks.len() || r.keeps.len() != f.graph.blocks.len()) {
    return "reuse tables do not cover the blocks";
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    if (reachable[bi]) {
      let why: string = verify_block_tokens(f, p, idx, bi, r);
      if (why != "") {
        return why;
      }
    }
    bi = bi + 1;
  }
  return verify_carry(f, p, idx, r, reachable);
}

function verify_block_tokens(f: ssasem.Func, p: Plan, idx: i32[][], bi: i32, r: Reuse): string {
  let b: ssa.SBlock = f.graph.blocks[bi];
  let pr: ReusePairs = r.pairs[bi];
  if (pr.tokens.len() != b.insts.len() || pr.builds.len() != b.insts.len() || pr.selfs.len() != b.insts.len()) {
    return "reuse pairing rows do not cover the block";
  }
  let held: i32[] = [];
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let ins: ssa.SInst = b.insts[pos];
    if (ins.kind_tag == 6 || ins.kind_tag == 8) {
      if (pr.tokens[pos] >= 0 || pr.builds[pos] >= 0 || pr.selfs[pos] >= 0) {
        return "a token at a parameter or a phi";
      }
    } else {
      let step: Step = step_of(p, idx, b.id, pos, 0 - 1);
      if (pr.builds[pos] >= 0) {
        let k: i32 = util.index_of_i32(held, pr.builds[pos]);
        if (k < 0) {
          return "a construction spends a token it was not handed";
        }
        if (util.index_of_i32(ins.args, pr.builds[pos]) >= 0) {
          return "a construction reads the box it builds in";
        }
        held = without_at(held, k);
      }
      if (pr.selfs[pos] >= 0) {
        let d: i32 = pr.selfs[pos];
        if (pr.builds[pos] >= 0) {
          return "a construction spends two tokens";
        }
        let carried: boolean = carry_held_for(r.carry, b.id, pos);
        if (carried && r.carry.donor[util.index_of_i32(r.carry.to, b.id)] != d) {
          return "a construction spends a token other than the one carried to it";
        }
        if (!carried && (util.index_of_i32(step.drops, d) < 0 || static_box(p, d))) {
          return "a token is taken from a value not dying here";
        }
        if (util.index_of_i32(ins.args, d) >= 0 || d == ins.result) {
          return "a construction reads the box it builds in";
        }
      } else if (carry_held_for(r.carry, b.id, pos)) {
        return "a carried token reaches a construction that does not spend it";
      }
      if (pr.tokens[pos] >= 0) {
        if (util.index_of_i32(held, pr.tokens[pos]) >= 0 || pr.tokens[pos] == pr.selfs[pos]) {
          return "a token is taken twice";
        }
        if (util.index_of_i32(step.drops, pr.tokens[pos]) < 0 || static_box(p, pr.tokens[pos])) {
          return "a token is taken from a value not dying here";
        }
        held = held.append(pr.tokens[pos]);
      }
    }
    pos = pos + 1;
  }
  if (held.len() > 0) {
    return "a token taken in a block is spent by no construction in it";
  }
  return verify_keeps(pr, r.keeps[bi]);
}

function verify_keeps(pr: ReusePairs, k: Keeps): string {
  let i: i32 = 0;
  while (i < k.donors.len()) {
    let built: i32 = k.built[i];
    let taken: i32 = k.taken[i];
    if (built < 0) {
      if (taken < 0 || taken >= pr.selfs.len() || k.start[i] < 0 || k.start[i] > taken) {
        return "a classified donor's positions are outside its block";
      }
      if (token_busy(pr, k.start[i], taken, util.index_of_i32(pr.builds, k.donors[i]))) {
        return "a classified donor's token overlaps a pairing's";
      }
      i = i + 1;
      continue;
    }
    if (built >= pr.selfs.len() || taken < 0 || taken > built || k.start[i] < 0 || k.start[i] > built) {
      return "a kept donor's positions are outside its block";
    }
    let own: boolean = built == taken && pr.selfs[built] == k.donors[i];
    let earlier: boolean = taken < built && pr.tokens[taken] == k.donors[i] && pr.builds[built] == k.donors[i];
    if (!own && !earlier) {
      return "a kept donor is not its construction's token";
    }
    if (token_busy(pr, k.start[i], built, built)) {
      return "a kept donor's token overlaps another pairing's";
    }
    i = i + 1;
  }
  return "";
}

function with_token(own set: i32[], d: i32): i32[] {
  if (util.index_of_i32(set, d) >= 0) {
    return set;
  }
  return set.append(d);
}

function without_token(set: i32[], d: i32): i32[] {
  let out: i32[] = [];
  for x in set {
    if (x != d) {
      out = out.append(x);
    }
  }
  return out;
}

function same_tokens(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for x in a {
    if (util.index_of_i32(b, x) < 0) {
      return false;
    }
  }
  return true;
}

function tokens_out(c: Carry, b: ssa.SBlock, entry: i32[]): i32[] {
  let out: i32[] = entry;
  let i: i32 = 0;
  while (i < c.from.len()) {
    if (c.from[i] == b.id) {
      out = with_token(out, c.held[i]);
    }
    i = i + 1;
  }
  i = 0;
  while (i < c.to.len()) {
    if (c.to[i] == b.id) {
      out = without_token(out, c.donor[i]);
    }
    i = i + 1;
  }
  return out;
}

function tokens_over(c: Carry, from: i32, to: i32, out: i32[]): i32[] {
  let over: i32[] = out;
  for d in carry_exits(c, from, to) {
    over = without_token(over, d);
  }
  for d in carry_nulls(c, from, to) {
    over = with_token(over, d);
  }
  return over;
}

function verify_carry(f: ssasem.Func, p: Plan, idx: i32[][], r: Reuse, reachable: boolean[]): string {
  let c: Carry = r.carry;
  let at: i32[] = ssa.block_positions(f.graph);
  let i: i32 = 0;
  while (i < c.from.len()) {
    let k: i32 = at[c.from[i]];
    if (k < 0 || !reachable[k]) {
      return "a token is held in an unreachable block";
    }
    let b: ssa.SBlock = f.graph.blocks[k];
    if (successors(b).len() == 0) {
      return "a block that leaves the function holds a token";
    }
    if (util.index_of_i32(step_of(p, idx, b.id, c.drop_at[i], 0 - 1).drops, c.held[i]) < 0 || static_box(p, c.held[i])) {
      return "a carried token is taken from a value not dying there";
    }
    i = i + 1;
  }
  let entry: i32[][] = [];
  let known: boolean[] = [];
  for b in f.graph.blocks {
    entry = entry.append([]);
    known = known.append(false);
  }
  known = known.with(at[f.graph.entry], true);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let k: i32 = 0;
    while (k < f.graph.blocks.len()) {
      if (reachable[k] && known[k]) {
        let b: ssa.SBlock = f.graph.blocks[k];
        let why: string = spent_held(c, b, entry[k]);
        if (why != "") {
          return why;
        }
        let out: i32[] = tokens_out(c, b, entry[k]);
        let next: i32[] = successors(b);
        if (next.len() == 0 && out.len() > 0) {
          return "a carried token is held where the function leaves";
        }
        for s in next {
          for d in carry_exits(c, b.id, s) {
            if (util.index_of_i32(out, d) < 0) {
              return "an edge frees a token it does not hold";
            }
          }
          let over: i32[] = tokens_over(c, b.id, s, out);
          let sk: i32 = at[s];
          if (!known[sk]) {
            known = known.with(sk, true);
            entry = entry.with(sk, over);
            changed = true;
          } else if (!same_tokens(entry[sk], over)) {
            return "a carried token is held on one path into a block and not another";
          }
        }
      }
      k = k + 1;
    }
  }
  return "";
}

function spent_held(c: Carry, b: ssa.SBlock, entry: i32[]): string {
  let i: i32 = 0;
  while (i < c.to.len()) {
    if (c.to[i] == b.id && util.index_of_i32(entry, c.donor[i]) < 0) {
      return "a construction spends a carried token no path holds";
    }
    i = i + 1;
  }
  return "";
}
