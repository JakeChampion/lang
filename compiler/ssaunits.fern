// Abstract counted-unit planning and independent replay before physical RC.
import "./ir";
import "./ssa";
import "./ssasem";
import "./ssadeps";
import "./ssalive";
import "./semrecords";
import "./semtypes";
import "./typeinfo";
import "./util";
import "std/envflag";

pub function value_mode(): i32 {
  return ssasem.value_mode();
}

pub function borrow_mode(): i32 {
  return ssasem.borrow_mode();
}

pub function counted_mode(): i32 {
  return ssasem.counted_mode();
}

pub function retain_unit(): i32 {
  return 1;
}

pub function move_unit(): i32 {
  return 2;
}

// A steal takes the unit from the record the value projects: at run time,
// when the record has no other holder, the field is nulled and its unit goes
// to the callee; otherwise the supply retains as any other. Chosen only where
// the record is this frame's own and read no further through that field
// (projection_root), so the null is seen by nothing but the record's own
// release, which skips it.
pub function steal_unit(): i32 {
  return 3;
}

pub function entry_point(): i32 {
  return 0 - 1;
}

pub function return_point(): i32 {
  return 0 - 2;
}

pub function edge_point(): i32 {
  return 0 - 3;
}

pub struct Supply { value: i32, slot: i32, mode: i32 }

// point is an instruction position, or entry/return/edge. target is a block
// id only for edges and -1 otherwise. All acquisitions execute before moves,
// the semantic operation then creates its result, and drops execute last.
//
// `hand_roots` / `hand_fields`, one per operand of a direct call: the record
// whose field the operand projects, or the parameter itself, when this frame
// reads it no further after the call (projection_root) and so hands the
// buffer on without a bracket; -1 otherwise. `hand_fields` is the field's
// index, or -1 for a parameter's own buffer — an array's, or a whole record
// parameter's, whose every field the callee may grow is handed with it.
pub struct Step { block: i32, point: i32, target: i32, supplies: Supply[], drops: i32[], hand_roots: i32[], hand_fields: i32[] }

// `grows` names, at an append's, a with's or a string append's result, the
// record value whose field buffer the operation may grow or write IN PLACE
// (field_grow_root), or -1; `grow_fields` holds that field's index at the same
// position.
// `held` marks an element read that takes a unit of its own at the read
// (held_elements); the physical lowering retains what it read.
// `literal` marks the values that can only hold a string literal (`literals`).
// `defs` is the definitions table (`definitions`) of the function the plan was
// planned from, indexed by value; a verifier checking another function
// derives its own.
// `fresh_seeded` says `unique_receivers` counted a fresh row's result
// (`with_fresh`), so a plan reused under another module's rows is proved again.
pub struct Plan { ok: boolean, why: string, steps: Step[], owned: boolean[], literal: boolean[], grows: i32[], grow_fields: i32[], takes: i32[], held: boolean[], payloads: boolean[], likely: boolean[], kept: boolean[], entry_kept: boolean[], frame_views: boolean[], constants: string[], text_lens: i32[], analysis: ssasem.Analysis, defs: ssa.SInst[], modes: i32[], unit_analysis: ssasem.Analysis, unique_receivers: boolean[], fresh_seeded: boolean, checked_writes: boolean[], links: i32[], reuse: Reuse }

struct Ledger { ok: boolean, why: string, bits: boolean[] }

// A callee parameter whose buffer the callee may grow in place: `field` is the
// index of a record parameter's array field, or -1 for an array parameter's
// own buffer. A caller still reading such an argument after the call holds a
// second count on the buffer across it, so the callee's push takes the copy
// (#4873, #8785).
pub struct GrowRow { callee: string, param: i32, field: i32 }

// GrowTable is the module's rows with a name index over their callees kept
// beside them, one entry per row in order, so a body's bracket asks about a
// callee along its chain rather than across the table.
pub struct GrowTable { rows: GrowRow[], by_callee: util.NameIndex }

pub function no_grows(): GrowTable {
  let no_names: string[] = [];
  return GrowTable { rows: [], by_callee: util.name_index(no_names) };
}

pub function grow_fields_of(t: GrowTable, callee: string, param: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = t.by_callee.chain(callee);
  while (i >= 0) {
    let row: GrowRow = t.rows[i];
    if (row.callee == callee && row.param == param && row.field >= 0) {
      out = out.append(row.field);
    }
    i = t.by_callee.next[i];
  }
  return out;
}

// Whether the callee may grow the array at `param` in place.
pub function grows_buffer(t: GrowTable, callee: string, param: i32): boolean {
  return has_row_at(t.rows, t.by_callee, callee, param, 0 - 1);
}

function has_row(rows: GrowRow[], callee: string, param: i32, field: i32): boolean {
  for row in rows {
    if (row.callee == callee && row.param == param && row.field == field) {
      return true;
    }
  }
  return false;
}

// Whether two grow tables say the same thing about `callees`.
//
// A body reads this table only through `grow_fields_of` and `grows_buffer` in
// `ssarc.bracketed`, keyed by the name each call instruction names, or by
// `indirect_callee` for a call through a function value — so two
// tables that agree on the callees one body names produce that body
// identically, however much they differ elsewhere. That is what lets a second
// lowering keep a body the inference did not move.
pub function grow_rows_agree(a: GrowTable, b: GrowTable, callees: string[]): boolean {
  for callee in callees {
    if (!rows_within(a, b, callee) || !rows_within(b, a, callee)) {
      return false;
    }
  }
  return true;
}

// rows_within reports whether every row of `a` for `callee` is in `b`.
function rows_within(a: GrowTable, b: GrowTable, callee: string): boolean {
  let i: i32 = a.by_callee.chain(callee);
  while (i >= 0) {
    let row: GrowRow = a.rows[i];
    if (row.callee == callee && !has_row_at(b.rows, b.by_callee, callee, row.param, row.field)) {
      return false;
    }
    i = a.by_callee.next[i];
  }
  return true;
}

function with_row(rows: GrowRow[], callee: string, param: i32, field: i32): GrowRow[] {
  if (has_row(rows, callee, param, field)) {
    return rows;
  }
  return rows.append(GrowRow { callee: callee, param: param, field: field });
}

// has_row_at is has_row over a table with a name index kept beside it, one
// entry per row in order: the callee's chain, ascending.
function has_row_at(rows: GrowRow[], ix: util.NameIndex, callee: string, param: i32, field: i32): boolean {
  let i: i32 = ix.chain(callee);
  while (i >= 0) {
    if (rows[i].callee == callee && rows[i].param == param && rows[i].field == field) {
      return true;
    }
    i = ix.next[i];
  }
  return false;
}

// The rows this function's plan contributes, given the rows `table` already
// holds for its callees: one per borrowed parameter position an admitted
// in-place grow or write reaches, directly through an append or a with of its
// own, through an append or a with whose receiver a phi, an earlier update or
// a call carries from the parameter (ssarc's links write those in place), or through a
// buffer it hands on unbracketed to a callee whose row says that position may
// grow — the parameter itself, or a value dying at the call that the same
// carriers lead back to it. An owned parameter needs no caller bracket — its caller moved the
// unit in, or retained and so made the record's own count answer "shared".
pub function grow_rows(callee: string, f: ssasem.Func, p: Plan, table: GrowRow[], tix: util.NameIndex): GrowRow[] {
  let out: GrowRow[] = [];
  let defs: ssa.SInst[] = p.defs;
  let at: i32[] = ssa.block_positions(f.graph);
  let seen: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) {
        continue;
      }
      let root: i32 = ins.args[0];
      let field: i32 = 0 - 1;
      if (p.grows[ins.result] >= 0) {
        root = p.grows[ins.result];
        field = p.grow_fields[ins.result];
      }
      if (field < 0) {
        let carried: Carried = carried_params(f, defs, root, seen);
        seen = carried.seen;
        for param in carried.params {
          if (!p.owned[param]) {
            out = with_row(out, callee, defs[param].imm, 0 - 1);
          }
        }
        continue;
      }
      if (defs[root].kind_tag != 6 || p.owned[root]) {
        continue;
      }
      out = with_row(out, callee, defs[root].imm, field);
    }
  }
  let partial: GrowTable = GrowTable { rows: table, by_callee: tix };
  for s in p.steps {
    if (s.point < 0) {
      continue;
    }
    let ins: ssa.SInst = f.graph.blocks[at[s.block]].insts[s.point];
    let scan: GrowScan = dying_lent_rows(callee, f, p, defs, s, ins, table, tix, GrowScan { rows: out, seen: seen });
    out = scan.rows;
    seen = scan.seen;
    let i: i32 = 0;
    while (i < s.hand_roots.len()) {
      let root: i32 = s.hand_roots[i];
      if (root >= 0 && defs[root].kind_tag == 6 && !p.owned[root]) {
        if (is_record(f.values[root]) && s.hand_fields[i] < 0) {
          // A whole record handed on: every field the callee may
          // grow, this parameter may grow.
          for field in grow_fields_of(partial, ins.str, i) {
            out = with_row(out, callee, defs[root].imm, field);
          }
        } else if (has_row_at(table, tix, ins.str, i, 0 - 1)) {
          out = with_row(out, callee, defs[root].imm, s.hand_fields[i]);
        }
      }
      i = i + 1;
    }
  }
  return out;
}

// The rows found so far, and `carried_params`' scratch set.
struct GrowScan { rows: GrowRow[], seen: boolean[] }

// The rows of a direct call's array operands that die at it, at the positions
// the callee may grow: the box they carry from a parameter is lent on with
// nothing in this frame reading it again.
function dying_lent_rows(callee: string, f: ssasem.Func, p: Plan, defs: ssa.SInst[], s: Step, ins: ssa.SInst, table: GrowRow[], tix: util.NameIndex, own scan: GrowScan): GrowScan {
  if (ins.kind_tag != ssasem.call()) {
    return scan;
  }
  let out: GrowRow[] = scan.rows;
  let seen: boolean[] = scan.seen;
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let v: i32 = ins.args[i];
    if (v >= f.graph.nparams && is_array(f.values[v]) && occurrences(s.drops, v) > 0 && has_row_at(table, tix, ins.str, i, 0 - 1)) {
      let carried: Carried = carried_params(f, defs, v, seen);
      seen = carried.seen;
      for param in carried.params {
        if (!p.owned[param]) {
          out = with_row(out, callee, defs[param].imm, 0 - 1);
        }
      }
    }
    i = i + 1;
  }
  return GrowScan { rows: out, seen: seen };
}

struct Carried { params: i32[], seen: boolean[] }

// The parameters whose box `v` may be, through phis, the receivers of
// appends and the array operands of calls. `seen` is a clear nvals-long
// scratch set, handed back clear.
function carried_params(f: ssasem.Func, defs: ssa.SInst[], v: i32, own seen: boolean[]): Carried {
  let out: i32[] = [];
  let work: i32[] = [v];
  let k: i32 = 0;
  while (k < work.len()) {
    let w: i32 = work[k];
    k = k + 1;
    if (w < 0 || seen[w]) {
      continue;
    }
    seen = seen.with(w, true);
    let d: ssa.SInst = defs[w];
    if (d.kind_tag == 6) {
      out = out.append(w);
    } else if (box_update(d)) {
      work = work.append(d.args[0]);
    } else if (d.kind_tag == 8) {
      for a in d.args {
        work = work.append(a);
      }
    } else if (d.kind_tag == ssasem.call()) {
      for a in d.args {
        if (is_array(f.values[a])) {
          work = work.append(a);
        }
      }
    }
  }
  let c: i32 = 0;
  while (c < work.len()) {
    if (work[c] >= 0) {
      seen = seen.with(work[c], false);
    }
    c = c + 1;
  }
  return Carried { params: out, seen: seen };
}

// Every produced body's rows, closed over the buffers handed on: a row only
// ever gains, so the rounds converge. A plan reads the table only through the
// rows filed under the callees its steps name, and each row is filed under the
// key of the plan that produced it, so a plan is evaluated again only once a
// callee of its has gained a row; until then it would hand back rows the
// table already holds.
pub function grow_table(keys: string[], funcs: ssasem.Func[], plans: Plan[]): GrowTable {
  let table: GrowRow[] = [];
  let no_names: string[] = [];
  // tix indexes `table` by callee, one entry per row in order.
  let tix: util.NameIndex = util.name_index(no_names);
  let kix: util.NameIndex = util.name_index(keys);
  let callers: i32[][] = plan_callers(kix, funcs, plans);
  let dirty: boolean[] = [];
  while (dirty.len() < plans.len()) {
    dirty = dirty.append(true);
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < plans.len()) {
      if (plans[i].ok && dirty[i]) {
        dirty = dirty.with(i, false);
        for row in grow_rows(keys[i], funcs[i], plans[i], table, tix) {
          if (!has_row_at(table, tix, row.callee, row.param, row.field)) {
            table = table.append(row);
            tix = tix.added(row.callee);
            changed = true;
            let at: i32 = kix.find(row.callee);
            if (at >= 0) {
              for c in callers[at] {
                dirty = dirty.with(c, true);
              }
            }
          }
        }
      }
      i = i + 1;
    }
  }
  for row in dispatched_rows(funcs, plans, table, tix) {
    if (!has_row_at(table, tix, row.callee, row.param, row.field)) {
      table = table.append(row);
      tix = tix.added(row.callee);
    }
  }
  return GrowTable { rows: table, by_callee: tix };
}

// The callee under which the table holds the positions a call through a
// function value may grow. No function can take this name.
pub function indirect_callee(): string {
  return "&";
}

// The names a body reads the grow table under: its direct callees, and
// `indirect_callee` when it calls through a function value.
pub function grow_callees(f: ssasem.Func): string[] {
  let out: string[] = ssasem.called_names(f);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call_value()) {
        return out.append(indirect_callee());
      }
    }
  }
  return out;
}

// The rows of calls that name no body: a call through a function value may
// reach any closure body the module makes, and a dyn call any of its arms.
// A position some body may grow is a row of the call's own name, with no
// field, since `ssarc.dispatch_bracketed` holds the whole box: a field is
// grown only under its record's own count. A body's parameter p is the
// call's operand p either way, the environment and the receiver both being
// operand 0. Nothing in the fixpoint reads these rows, so they are made once
// it has settled.
function dispatched_rows(funcs: ssasem.Func[], plans: Plan[], table: GrowRow[], tix: util.NameIndex): GrowRow[] {
  let out: GrowRow[] = [];
  let i: i32 = 0;
  while (i < plans.len()) {
    if (plans[i].ok) {
      for b in funcs[i].graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.closure_new()) {
            out = rows_as(out, table, tix, ins.str, indirect_callee(), 1);
          } else if (ins.kind_tag == ssasem.call() && ssasem.is_dyn_call(ins.str)) {
            for arm in ssasem.dyn_call_arms(ins.str) {
              out = rows_as(out, table, tix, arm, ins.str, 0);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

// `body`'s rows at a parameter from `first` on, as rows of `name` with no
// field.
function rows_as(own out: GrowRow[], table: GrowRow[], tix: util.NameIndex, body: string, name: string, first: i32): GrowRow[] {
  let k: i32 = tix.chain(body);
  while (k >= 0) {
    if (table[k].callee == body && table[k].param >= first) {
      out = with_row(out, name, table[k].param, 0 - 1);
    }
    k = tix.next[k];
  }
  return out;
}

// plan_callers[j] lists the plans whose steps name the plan first keyed
// keys[j] (kix), each once.
function plan_callers(kix: util.NameIndex, funcs: ssasem.Func[], plans: Plan[]): i32[][] {
  let out: i32[][] = [];
  while (out.len() < plans.len()) {
    out = out.append([]);
  }
  let i: i32 = 0;
  while (i < plans.len()) {
    if (plans[i].ok) {
      let at: i32[] = ssa.block_positions(funcs[i].graph);
      for s in plans[i].steps {
        if (s.point >= 0) {
          let j: i32 = kix.find(funcs[i].graph.blocks[at[s.block]].insts[s.point].str);
          if (j >= 0 && (out[j].len() == 0 || out[j][out[j].len() - 1] != i)) {
            out = out.with(j, out[j].append(i));
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function bad(why: string): Plan {
  return Plan { ok: false, why: why, steps: [], owned: [], literal: [], grows: [], grow_fields: [], takes: [], held: [], payloads: [], likely: [], kept: [], entry_kept: [], frame_views: [], constants: [], text_lens: [], analysis: ssasem.refused_analysis(why), defs: [], modes: [], unit_analysis: ssasem.refused_analysis(why), unique_receivers: [], fresh_seeded: false, checked_writes: [], links: [], reuse: no_reuse() };
}

pub function refused(why: string): Plan {
  return bad(why);
}

function rejected(why: string): Ledger {
  return Ledger { ok: false, why: why, bits: [] };
}

function step(block: i32, point: i32, target: i32): Step {
  return Step { block: block, point: point, target: target, supplies: [], drops: [], hand_roots: [], hand_fields: [] };
}

function successors(b: ssa.SBlock): i32[] {
  if (b.term.kind_tag == 2) {
    return [b.term.target];
  }
  if (b.term.kind_tag == 3) {
    if (b.term.t == b.term.f) {
      return [b.term.t];
    }
    return [b.term.t, b.term.f];
  }
  return [];
}

// The types that carry no unit at all: the scalars, a handle, which is its
// descriptor, and never, which no value has (a `never[]` is always empty).
function unit_free(t: typeinfo.Type): boolean {
  if (semtypes.is_never(t)) {
    return true;
  }
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  if let typeinfo.TypeFloat(_) = t {
    return true;
  }
  if let typeinfo.TypeVoid(_) = t {
    return true;
  }
  return semtypes.is_handle(t);
}

function supported(t: typeinfo.Type, f: ssasem.Func): boolean {
  return unit_shape(t, f, true);
}

pub function has_nominal(t: typeinfo.Type, f: ssasem.Func): boolean {
  if let typeinfo.TypeStruct(_) = t {
    return semrecords.find(f.records, t) >= 0;
  }
  return semrecords.find_enum(f.enums, t) >= 0;
}

// nominal admits a struct or union type: with `lookup`, when f's table holds
// it. A schema entry's field is admitted without: the analysis a plan is
// formed from refuses a table whose fields name a type it lacks
// (semrecords.verify).
pub function nominal(t: typeinfo.Type, f: ssasem.Func, lookup: boolean): boolean {
  return !lookup || has_nominal(t, f);
}

// unit_shape: whether `t` is a value this pass plans.
function unit_shape(t: typeinfo.Type, f: ssasem.Func, lookup: boolean): boolean {
  if (unit_free(t)) {
    return true;
  }
  if let typeinfo.TypeString(_) = t {
    return true;
  }
  if let typeinfo.TypeFunc(_) = t {
    return true;
  }
  if let typeinfo.TypeDyn(_) = t {
    return true;
  }
  // A map cursor holds a unit of its map.
  if (semtypes.is_map_iter(t)) {
    return unit_shape(semtypes.map_iter_map(t), f, lookup);
  }
  if let typeinfo.TypeArray(a) = t {
    return unit_shape(a.elem, f, lookup);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (!unit_shape(e, f, lookup)) {
        return false;
      }
    }
    return true;
  }
  // A cell holds one unit of its own and one slot; no declaration names it.
  if (semtypes.is_cell(t)) {
    return unit_shape(semtypes.cell_elem(t), f, lookup);
  }
  // A map holds one unit of its own and one of every key in its column, and
  // one of every value when that column is counted; only the shapes whose
  // release does that are admitted, and a column of boxes only when the box
  // itself is a value this pass plans.
  if (ssasem.is_map(t)) {
    if (!ssasem.is_supported_map(t)) {
      return false;
    }
    if (ssasem.keyed_map_key(ssasem.map_key(t)) && !unit_shape(ssasem.map_key(t), f, lookup)) {
      return false;
    }
    return !ssasem.boxed_map_value(ssasem.map_value(t)) || unit_shape(ssasem.map_value(t), f, lookup);
  }
  if let typeinfo.TypeStruct(_) = t {
    return nominal(t, f, lookup);
  }
  if let typeinfo.TypeUnion(_) = t {
    return nominal(t, f, lookup);
  }
  return false;
}

function mode_error(params: typeinfo.Type[], modes: i32[]): string {
  let i: i32 = 0;
  while (i < modes.len()) {
    if (ssasem.reference(params[i])) {
      if (modes[i] != borrow_mode() && modes[i] != counted_mode()) {
        return "reference parameter mode";
      }
    } else if (modes[i] != value_mode()) {
      return "scalar parameter mode";
    }
    i = i + 1;
  }
  return "";
}

// A callee's contract is held to the same representation and mode rules as
// this function's own parameters: its counted result is a fresh unit here.
function call_contract_error(c: ssasem.Contract, f: ssasem.Func): string {
  for t in c.params {
    if (!supported(t, f)) {
      return "unsupported counted-unit call parameter";
    }
  }
  if (!supported(c.result, f)) {
    return "unsupported counted-unit call result";
  }
  return mode_error(c.params, c.modes);
}

// A SchemaView is a function's schema tables already checked: per record,
// then per enum, in table order, whether all its fields are admitted as a unit
// (`*_unit`) and as a physical walk (`*_walk`).
// ssarc.schema_views forms each distinct entry's once per module. An empty
// view, which no_view is, leaves every entry to be checked here.
pub struct SchemaView { rec_unit: boolean[], rec_walk: boolean[], enum_unit: boolean[], enum_walk: boolean[] }

pub function no_view(): SchemaView {
  let none: boolean[] = [];
  return SchemaView { rec_unit: none, rec_walk: none, enum_unit: none, enum_walk: none };
}

// view_fits: `v` was formed for this very table.
pub function view_fits(v: SchemaView, f: ssasem.Func): boolean {
  return v.rec_unit.len() == f.records.list.len() && v.enum_unit.len() == f.enums.len();
}

pub function record_unit(r: semrecords.Record, f: ssasem.Func): boolean {
  for field in r.fields {
    if (!unit_shape(field.ty, f, false)) {
      return false;
    }
  }
  return true;
}

pub function enum_unit(e: semrecords.Enum, f: ssasem.Func): boolean {
  for vr in e.variants {
    // An impossible variant carries no runtime units. Keep its schema and
    // ordinal, but never admit its absent payload as an ordinary value.
    if (!semrecords.inhabited(vr)) {
      continue;
    }
    for field in vr.fields {
      if (!unit_shape(field.ty, f, false)) {
        return false;
      }
    }
  }
  return true;
}

// Check the finite schema tables, not recursive nominal field expansion.
function schema_fields_error(f: ssasem.Func, view: SchemaView): string {
  let fits: boolean = view_fits(view, f);
  let i: i32 = 0;
  while (i < f.records.list.len()) {
    let ok: boolean = false;
    if (fits) {
      ok = view.rec_unit[i];
    } else {
      ok = record_unit(f.records.list[i], f);
    }
    if (!ok) {
      return "unsupported counted record field";
    }
    i = i + 1;
  }
  i = 0;
  while (i < f.enums.len()) {
    let ok: boolean = false;
    if (fits) {
      ok = view.enum_unit[i];
    } else {
      ok = enum_unit(f.enums[i], f);
    }
    if (!ok) {
      return "unsupported counted variant field";
    }
    i = i + 1;
  }
  return "";
}

// A closure is dispatched through with no declaration in hand, so the units its
// arguments carry are read off the function TYPE the box hands out. A counted
// parameter is a CONSUMING slot and the type spells one with `own`: what
// ssasem.closure_type builds from these same modes is what every call through
// the box is checked against, so the two sides cannot disagree.
//
// The environment parameter is the box, which is lent like any other receiver
// and never appears in the type the box hands out, so a counted one there would
// be a promise nothing can state.
function closure_body_error(f: ssasem.Func, ins: ssa.SInst): string {
  let c: ssasem.Contract = f.calls[ssasem.find_contract_in(f.calls, ins.str)];
  if (c.modes.len() > 0 && c.modes[0] == counted_mode()) {
    return "function value consumes its environment";
  }
  return "";
}

function function_ops_error(f: ssasem.Func): string {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.closure_new()) {
        let why: string = closure_body_error(f, ins);
        if (why != "") {
          return why;
        }
      }
    }
  }
  return "";
}

function contract_error(f: ssasem.Func, modes: i32[], view: SchemaView): string {
  if (modes.len() != f.params.len()) {
    return "parameter mode dimensions";
  }
  for t in f.values {
    if (!supported(t, f)) {
      return "unsupported counted-unit type";
    }
  }
  if (!supported(f.result, f)) {
    return "unsupported counted-unit result";
  }
  let why: string = schema_fields_error(f, view);
  if (why != "") {
    return why;
  }
  for c in f.calls {
    why = call_contract_error(c, f);
    if (why != "") {
      return why;
    }
  }
  why = function_ops_error(f);
  if (why != "") {
    return why;
  }
  return mode_error(f.params, modes);
}

// A construction, a closure box, a call result, a phi, a string constant and a
// binary operator's result are fresh; only a reference-typed one is a unit of
// this function's own (a string concatenation), so a scalar operator's result
// is never owned. A projection or a copy borrows its source.
// A closure box is a construction too: it owns one unit per reference capture,
// released when the box is. So is a cell, over its one element; a read of a
// cell hands out a unit of the element rather than borrowing the slot.
function construction(kind: i32): boolean {
  return kind == ssasem.array_new() || kind == ssasem.array_reserve() || kind == ssasem.tuple_new() || kind == ssasem.record_new() || kind == ssasem.variant_new() || kind == ssasem.dyn_box()
    || kind == ssasem.closure_new() || kind == ssasem.cell_new() || kind == ssasem.map_new()
    || kind == ssasem.map_cleared();
}

// The operand types a construction takes a unit of: every reference, without
// exception. A closure box used to BORROW a captured function value, secured
// by requiring the capture to be a borrowed parameter so its owner outlived
// the box. That rule could not describe a box that escapes: a local function
// value captured into a returned box is owned by a frame that is going away,
// and the box never took it, so nobody freed it (#9637). The box owns it now,
// and its release walks the field (ssarc.walked) — which a frame that never
// built the box can do, because `semsource.env_rows` pairs every environment
// a value of that type could carry with the type itself, and the whole module
// contract table is what it reads.
//
// No `kind`: there is no construction with an exception any more.
function taken(t: typeinfo.Type): boolean {
  return ssasem.reference(t);
}

// A zero is a unit this frame holds, not one it allocated: at a reference type
// it is the null word, so the release it owes is nothing (`ssarc.null_unit`
// emits none), and the replacement the declaration site assigns drops exactly
// that nothing. It is deliberately NOT a `construction` — no box was
// made, so nothing may take a field out of one.
//
// A string literal (kind 5) is not a unit either: its static box carries the
// immortal count on every backend, so it is never released, and a consumer
// that takes one is handed it with no retain (`literal`).
function fresh_unit(kind: i32): boolean {
  return kind == 8 || kind == 9 || kind == ssasem.append_range() || kind == ssasem.zero() || construction(kind) || hands_out(kind);
}

// The operations whose result is a unit handed to this function: a call's
// result, a rebuilt container, a view's box, a cell's element, a map read,
// which retains what it answers because the value may come from the column or
// from the caller's default, a column snapshot, which semsource admits only
// where the runtime hands back a copy the frame owns whole, a delete,
// whose tuple is fresh and holds the map the receiver handed over, and a hole
// fill, which hands back the chain it was given or the value it stored.
function hands_out(kind: i32): boolean {
  return kind == ssasem.call() || kind == ssasem.call_value() || kind == ssasem.closure_new()
    || kind == ssasem.append() || kind == ssasem.with() || kind == ssasem.slice() || kind == ssasem.cell_get()
    || kind == ssasem.map_insert() || kind == ssasem.map_get_or() || kind == ssasem.map_get()
    || kind == ssasem.map_keys() || kind == ssasem.map_values() || kind == ssasem.map_delete()
    || kind == ssasem.str_bytes() || kind == ssasem.str_byte_view() || ssasem.is_arr_helper_op(kind) || kind == ssasem.arr_slice()
    || kind == ssasem.map_iter() || kind == ssasem.hole_fill();
}

// A phi is a literal too when every operand is: assumed of every phi, then
// withdrawn from each one with another operand, to a fixpoint, so a loop
// phi that only ever carries literals keeps the mark.
function literals(f: ssasem.Func): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 5 || ins.kind_tag == 8) {
        out = out.with(ins.result, true);
      }
    }
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag != 8 || !out[ins.result]) {
          continue;
        }
        let lit: boolean = true;
        for a in ins.args {
          if (a < 0 || !out[a]) {
            lit = false;
          }
        }
        if (!lit) {
          out = out.with(ins.result, false);
          changed = true;
        }
      }
    }
  }
  return out;
}

function owned_values(f: ssasem.Func, modes: i32[], defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      let owns: boolean = false;
      if (ins.kind_tag == 6) {
        owns = modes[ins.imm] == counted_mode();
      }
      if (ins.kind_tag != 8 && fresh_unit(ins.kind_tag)) {
        owns = ssasem.reference(f.values[ins.result]);
      }
      out = out.with(ins.result, owns);
    }
  }
  return phi_ownership(f, out, defs);
}

// A phi owns a unit unless every operand is lent whole: a borrowed parameter,
// a string literal, another phi that is, or a projection of one of those. Such
// a phi holds nothing its edges could supply -- asking them retains a view
// with a no-op and releases it with a free (#9802), and retains a counted box
// for nothing. A projection of a lent value is a part of a box its holder
// keeps alive for the whole call, so it lends on the same terms; the loop a
// self tail call becomes (`ssasem.tail_recursion`) rebinds every parameter to
// such a projection. Any other operand makes the phi owned: a projection of
// an owned record is anchored to its root, and the retain the edge supplies
// is what keeps the child alive past the root's release. To a fixpoint, since
// ownership reaches a phi through a phi, and through a projection of one.
function phi_ownership(f: ssasem.Func, owned: boolean[], defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = owned;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag != 8 || !ssasem.reference(f.values[ins.result])) {
        continue;
      }
      let lent: boolean = true;
      for a in ins.args {
        if (a < 0) {
          continue;
        }
        let r: i32 = lent_root(f, defs, a);
        if (defs[r].kind_tag == 8 || defs[r].kind_tag == 5) {
          continue;
        }
        if (defs[r].kind_tag == 6 && !out[r]) {
          continue;
        }
        lent = false;
      }
      if (!lent) {
        out = out.with(ins.result, true);
      }
    }
  }
  let grown: boolean = true;
  while (grown) {
    grown = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag != 8 || out[ins.result] || !ssasem.reference(f.values[ins.result])) {
          continue;
        }
        for a in ins.args {
          if (a >= 0 && out[lent_root(f, defs, a)]) {
            out = out.with(ins.result, true);
            grown = true;
          }
        }
      }
    }
  }
  return out;
}

// The value `v` is a part of, through every projection of a plain reference
// it was read by: a record field, a variant payload or member, a tuple
// element or an array element. A view holder and a map stop the walk, as
// they stop the tail-call rewrite (`ssasem.crosses_jump`): a view's box has
// no count to lend, and a map read answers a unit of its own.
function lent_root(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  let at: i32 = v;
  while (part_read(defs[at].kind_tag) && defs[at].args.len() > 0) {
    let t: typeinfo.Type = f.values[at];
    if (!ssasem.reference(t) || ssasem.holds_view(f, t) || ssasem.is_map(t)) {
      return at;
    }
    at = defs[at].args[0];
  }
  return at;
}

function part_read(kind: i32): boolean {
  return kind == ssasem.variant_get() || kind == ssasem.variant_as() || kind == ssasem.record_get()
    || kind == ssasem.tuple_get() || kind == ssasem.array_get();
}

// A view is lent, never retained: its box carries the immortal sentinel
// rather than a count, so the retain the runtime would emit is a no-op while
// the release that balances it frees the box (#9802). A supply that MOVES a
// view is fine, the one unit changes hands; one that retains it, because the
// value stays live past the step, would give back a unit nothing took: a
// phi merging a live view with a fresh one released the live one from
// under its holder. `ssarc`'s #9328 note is the same asymmetry at the call
// bracket, which it restricts to arrays.
//
// A string retagged as a view is the string's own counted box, so retaining
// it retains the string, which `__fern_str_view_free` then releases as one.
// A literal's retain is never emitted (ssarc.supplies), so it lends nothing.
function view_retain_error(f: ssasem.Func, steps: Step[], literal: boolean[], defs: ssa.SInst[]): string {
  for s in steps {
    for item in s.supplies {
      if (item.mode == retain_unit() && ssasem.is_view(f.values[item.value]) && !retagged_string(f, defs, item.value) && !literal[item.value]) {
        return "a view is lent, never retained";
      }
    }
  }
  return "";
}

function retagged_string(f: ssasem.Func, defs: ssa.SInst[], v: i32): boolean {
  let d: ssa.SInst = defs[v];
  return d.kind_tag == ssasem.str_as() && d.args.len() == 1 && !ssasem.is_view(f.values[d.args[0]]);
}

// use_ids lists `value` and the values it depends on, each once; none for
// no value.
function use_ids(value: i32, deps: i32[][]): i32[] {
  if (value < 0) {
    return [];
  }
  let ids: i32[] = [value];
  for dep in deps[value] {
    if (!has_id(ids, dep)) {
      ids = ids.append(dep);
    }
  }
  return ids;
}

// A construction takes one unit per reference operand, function values
// included: the closure box that used to borrow its captures of that type now
// owns them (#9637). A call takes one per counted parameter; a borrowed parameter
// only reads the caller's unit. An append or a with takes one for its
// receiver, which a receiver this function does not own reaches by retaining;
// a cell write takes one for the element it stores and reads the cell. A map
// insert takes one for the receiver it hands back and one for the key its
// column holds until the map is released, and one for the value when that
// column is counted too. A delete takes one for the receiver it hands back
// inside its tuple and only COMPARES the key, whose unit stays with the
// caller. A hole fill takes the chain's and the stored value's, and reads the
// hole's address. A string append takes one for its left operand, whose
// buffer it may grow in place (`string_append`).
function operation_supplies(f: ssasem.Func, ins: ssa.SInst): Supply[] {
  let out: Supply[] = [];
  let counted: boolean[] = [];
  if (ins.kind_tag == ssasem.call()) {
    counted = call_supplied(f, ins);
  } else if (ins.kind_tag == ssasem.call_value()) {
    counted = call_value_supplied(f, ins);
  } else if (ins.kind_tag == ssasem.cell_set()) {
    counted = [false, ssasem.reference(f.values[ins.args[1]])];
  } else if (ins.kind_tag == ssasem.map_insert()) {
    counted = [true, ssasem.reference(f.values[ins.args[1]]), ssasem.reference(f.values[ins.args[2]])];
  } else if (ins.kind_tag == ssasem.map_delete()) {
    counted = [true, false];
  } else if (ins.kind_tag == ssasem.append()) {
    counted = [true, ssasem.reference(f.values[ins.args[1]])];
  } else if (ins.kind_tag == ssasem.with()) {
    counted = [true, false, ssasem.reference(f.values[ins.args[2]])];
  } else if (ins.kind_tag == ssasem.hole_fill()) {
    counted = [true, false, true];
  } else if (ins.kind_tag == ssasem.map_iter()) {
    counted = [true];
  } else if (string_append(f, ins)) {
    counted = [true, false];
  } else if (construction(ins.kind_tag)) {
    for arg in ins.args {
      counted = counted.append(taken(f.values[arg]));
    }
  }
  let i: i32 = 0;
  while (i < counted.len()) {
    if (counted[i]) {
      out = out.append(Supply { value: ins.args[i], slot: i, mode: 0 });
    }
    i = i + 1;
  }
  return out;
}

// The supplies of every operation of `f`, made once for the passes that read
// them: the operation at `pos` in block `bi` is rows[from[bi] + pos]. A
// parameter or a phi supplies nothing here.
struct SupplyTable { from: i32[], rows: Supply[][] }

function supply_table(f: ssasem.Func): SupplyTable {
  let from: i32[] = [];
  let rows: Supply[][] = [];
  for b in f.graph.blocks {
    from = from.append(rows.len());
    for ins in b.insts {
      if (ins.kind_tag == 6 || ins.kind_tag == 8) {
        rows = rows.append([]);
      } else {
        rows = rows.append(operation_supplies(f, ins));
      }
    }
  }
  return SupplyTable { from: from, rows: rows };
}

function (t: SupplyTable) at(bi: i32, pos: i32): Supply[] {
  return t.rows[t.from[bi] + pos];
}

// A `+` on a counted string: the runtime appends onto the left operand's
// buffer when the frame hands it the only unit and its block has room, so the
// operand is taken rather than lent. A view has no unit to hand over, and a
// range append's left operand is always counted (ssasem.append_range).
pub function string_append(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag == ssasem.append_range()) {
    return true;
  }
  return ins.kind_tag == 9 && ins.str == "+" && ssasem.is_string(f.values[ins.args[0]]);
}

// The operands a call lends rather than counts. The callee reads them for the
// whole call, and it may release a unit it is handed before it does.
function lent_operands(ins: ssa.SInst, counted: Supply[]): i32[] {
  let out: i32[] = [];
  if (ins.kind_tag != ssasem.call() && ins.kind_tag != ssasem.call_value()) {
    return out;
  }
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let slot_counted: boolean = false;
    for got in counted {
      if (got.slot == i) {
        slot_counted = true;
      }
    }
    if (!slot_counted && ins.args[i] >= 0) {
      out = out.append(ins.args[i]);
    }
    i = i + 1;
  }
  return out;
}

// What a call's lent operands borrow from: none of it may move into the call
// (#10832).
function lent_owners(ins: ssa.SInst, counted: Supply[], deps: i32[][]): i32[] {
  let out: i32[] = [];
  if (counted.len() == 0) {
    return out;
  }
  for v in lent_operands(ins, counted) {
    for supply in counted {
      if ((supply.value == v || has_id(deps[v], supply.value)) && !has_id(out, supply.value)) {
        out = out.append(supply.value);
      }
    }
  }
  return out;
}

// An indirect call LENDS every reference it is handed except at a slot the
// function type spells CONSUMING, `own T`. The callee box itself (operand 0)
// is lent like any other.
function call_value_supplied(f: ssasem.Func, ins: ssa.SInst): boolean[] {
  let out: boolean[] = [false];
  let callee: typeinfo.Type = f.values[ins.args[0]];
  let params: typeinfo.Type[] = ssasem.func_params(callee);
  let i: i32 = 0;
  while (i < params.len()) {
    out = out.append(ssasem.func_param_own(callee, i) && ssasem.reference(f.values[ins.args[i + 1]]));
    i = i + 1;
  }
  return out;
}

function call_supplied(f: ssasem.Func, ins: ssa.SInst): boolean[] {
  let c: ssasem.Contract = f.calls[ssasem.find_contract_in(f.calls, ins.str)];
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < ins.args.len()) {
    out = out.append(c.modes[i] == counted_mode() && ssasem.reference(f.values[ins.args[i]]));
    i = i + 1;
  }
  return out;
}

// The callee's declared mode at each operand of a direct call, for a caller
// deciding which arguments its bracket covers. `call_supplied` reads the same
// contract for the ledger; this is the whole row rather than the counted half.
pub function callee_modes(f: ssasem.Func, ins: ssa.SInst): i32[] {
  let at: i32 = ssasem.find_contract_in(f.calls, ins.str);
  if (at < 0) {
    return [];
  }
  return f.calls[at].modes;
}

// An unreachable end (kind 4) supplies nothing and, like a return, releases
// every unit the frame still holds at its step.
function return_supplies(f: ssasem.Func, b: ssa.SBlock): Supply[] {
  if (b.term.kind_tag == 1 && b.term.value >= 0 && ssasem.reference(f.values[b.term.value])) {
    return [Supply { value: b.term.value, slot: 0, mode: 0 }];
  }
  return [];
}

// The edge from b into the block at position si.
function edge_supplies(f: ssasem.Func, b: ssa.SBlock, si: i32, owned: boolean[]): Supply[] {
  let succ: ssa.SBlock = f.graph.blocks[si];
  let pi: i32 = 0;
  while (succ.preds[pi] != b.id) {
    pi = pi + 1;
  }
  let out: Supply[] = [];
  let i: i32 = 0;
  for ins in succ.insts {
    if (ins.kind_tag == 8 && owned[ins.result]) {
      out = out.append(Supply { value: ins.args[pi], slot: i, mode: 0 });
    }
    i = i + 1;
  }
  return out;
}

function definitions(f: ssasem.Func): ssa.SInst[] {
  let none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let out: ssa.SInst[] = [];
  let i: i32 = 0;
  while (i < f.graph.nvals) {
    out = out.append(none);
    i = i + 1;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.result < out.len()) {
        out = out.with(ins.result, ins);
      }
    }
  }
  return out;
}

// Per slice result, of a string or of a byte view's sub-range: whether its
// view box may live in the frame that made it. Every use has to read the
// bytes and be done with the box within the one instruction — a comparison
// or concatenation, a length, a byte, a further window, or a borrowed
// argument to a callee that does not keep it. A callee whose result borrows
// the argument also keeps its descriptor, as recorded by the typed result
// anchors. A phi, a store, a return or anything else keeps the box past the
// instruction, and a phi is also the only way an earlier iteration's box
// could still be read when the site runs again.
function frame_views(f: ssasem.Func, defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.slice() || byte_view_slice(f, ins)) {
        out = out.with(ins.result, true);
      }
    }
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      let i: i32 = 0;
      while (i < ins.args.len()) {
        let view: i32 = lent_view(f, defs, ins.args[i]);
        if (view >= 0) {
          let handed: boolean = ins.kind_tag == ssasem.call() && util.index_of_i32(ssasem.anchor_params(f.anchors, ins.str), i) >= 0;
          if (handed || !reads_view(f, ins, i, view != ins.args[i], defs[view].kind_tag == ssasem.arr_slice())) {
            out = out.with(view, false);
          }
        }
        i = i + 1;
      }
    }
    if (b.term.kind_tag == 1) {
      let ret: i32 = lent_view(f, defs, b.term.value);
      if (ret >= 0) {
        out = out.with(ret, false);
      }
    }
  }
  return out;
}

// A sub-range of a byte view or an owned `u8[]`, whose descriptor the
// lowering may build in the frame (ssabytes.slice_frame).
function byte_view_slice(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag != ssasem.arr_slice() || ins.result < 0 || ins.result >= f.values.len()) {
    return false;
  }
  if let typeinfo.TypeArray(a) = f.values[ins.result] {
    return a.view && ssasem.is_u8(a.elem);
  }
  return false;
}

// Per value, the byte length of the string literal it is, or -1.
function text_lens(f: ssasem.Func): i32[] {
  let out: i32[] = [];
  while (out.len() < f.graph.nvals) {
    out = out.append(0 - 1);
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 5 && ins.result >= 0) {
        out = out.with(ins.result, ins.str.len());
      }
    }
  }
  return out;
}

// Per record, variant or array construction whose every field or element is a
// scalar constant, a 64-bit integer or f64 constant among them: "|" and its
// words, which is a static box's whole content; "" for any other value. An
// empty array literal is one whatever its element type. A field or element may also hold another such box, as the
// word `@<value>`, a string literal's static box, as `$<value>`, or a
// payloadless Option or Result's, as its packing in braces. A static
// box's rc is immortal, so its releases and uniqueness tests leave it alone.
//
// A field's box can be defined in a block visited after the field's, so a pass
// that left a field waiting on one is repeated once it has placed anything.
function constants(f: ssasem.Func, defs: ssa.SInst[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < f.graph.nvals) {
    out = out.append("");
    i = i + 1;
  }
  let raw: boolean[] = __alloc_bool(f.graph.nvals);
  for v in raw_reached(f, defs) {
    raw = raw.with(v, true);
  }
  let again: boolean = true;
  while (again) {
    let placed: boolean = false;
    let waiting: boolean = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        let built: Construction = placeable(f, raw, out, ins);
        if (built.ok) {
          let w: BoxWords = box_words(f, defs, raw, out, ins, built.fields);
          waiting = waiting || w.waiting;
          if (w.text != "") {
            out = out.with(ins.result, w.text);
            placed = true;
          }
        }
      }
    }
    again = placed && waiting;
  }
  return out;
}

// A construction `constants` has not placed and may: not handed to the raw
// floor, and with no finalizer to run.
function placeable(f: ssasem.Func, raw: boolean[], out: string[], ins: ssa.SInst): Construction {
  let built: Construction = built_fields(f, ins);
  if (!built.ok || built.fields.len() != ins.args.len() || raw[ins.result] || out[ins.result] != "") {
    return Construction { ...built, ok: false };
  }
  if (ssasem.has_finalizer(f, f.values[ins.result])) {
    return Construction { ...built, ok: false };
  }
  return built;
}

// One construction's static words, "" when a field is not constant, and
// whether a field is a box this pass has not placed yet.
struct BoxWords { text: string, waiting: boolean }

function box_words(f: ssasem.Func, defs: ssa.SInst[], raw: boolean[], out: string[], ins: ssa.SInst, fields: semrecords.Field[]): BoxWords {
  let words: string = "|";
  let j: i32 = 0;
  while (j < fields.len()) {
    let w: string = constant_word(f, defs, ins.args[j], fields[j].ty);
    if (w == "") {
      w = wide_word(f, defs, ins.args[j], fields[j].ty);
    }
    if (w == "") {
      w = literal_word(defs, ins.args[j]);
    }
    if (w == "") {
      w = option_word(f, defs, ins.args[j]);
    }
    if (w == "") {
      let at: i32 = placed_box(f, defs, raw, ins.args[j]);
      if (at < 0 || out[at] == "") {
        return BoxWords { text: "", waiting: at >= 0 };
      }
      w = "@" + util.i32_to_string(at);
    }
    if (w == "") {
      return BoxWords { text: "", waiting: false };
    }
    if (j > 0) {
      words = words + ",";
    }
    words = words + w;
    j = j + 1;
  }
  return BoxWords { text: words, waiting: false };
}

// A string literal's static box, as `$<value>`, read through copies; "" for
// anything else.
function literal_word(defs: ssa.SInst[], v: i32): string {
  if (v < 0) {
    return "";
  }
  let d: ssa.SInst = through_copies(defs, v);
  if (d.kind_tag != 5 || d.result < 0) {
    return "";
  }
  return "$" + util.i32_to_string(d.result);
}

// A payloadless Option or Result's static block (ir.op_const_option), read
// through copies; "" for anything else.
function option_word(f: ssasem.Func, defs: ssa.SInst[], v: i32): string {
  if (v < 0) {
    return "";
  }
  let d: ssa.SInst = through_copies(defs, v);
  if (d.kind_tag != ssasem.variant_new() || d.args.len() != 0 || d.result < 0) {
    return "";
  }
  let e: i32 = semrecords.find_enum(f.enums, f.values[d.result]);
  if (e < 0 || f.enums[e].layout != semrecords.layout_option()) {
    return "";
  }
  return ir.const_option_ref(semrecords.find_variant(f.enums[e], d.str));
}

// The construction a field's value is, read through copies, when it is one
// `constants` could place; -1 otherwise.
function placed_box(f: ssasem.Func, defs: ssa.SInst[], raw: boolean[], v: i32): i32 {
  if (v < 0) {
    return 0 - 1;
  }
  let d: ssa.SInst = through_copies(defs, v);
  if (d.result < 0 || raw[d.result] || !built_fields(f, d).ok) {
    return 0 - 1;
  }
  return d.result;
}

// The values whose storage this body hands to the raw floor: an array cast to
// its data pointer, or given to `__arr_set_len` or `__raw_arr_ptr`, traced back
// through copies and phis. The floor writes that storage without a count, so a
// literal reaching it is built fresh rather than shared.
function raw_reached(f: ssasem.Func, defs: ssa.SInst[]): i32[] {
  let work: i32[] = [];
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.args.len() == 0) {
        continue;
      }
      let raw: boolean = ins.kind_tag == ssasem.cast() && is_array(f.values[ins.args[0]]);
      raw = raw || ins.kind_tag == ssasem.call() && (ins.str == "__arr_set_len" || ins.str == "__raw_arr_ptr");
      if (raw) {
        work = work.append(ins.args[0]);
      }
    }
  }
  let seen: boolean[] = __alloc_bool(f.graph.nvals);
  let out: i32[] = [];
  let at: i32 = 0;
  while (at < work.len()) {
    let v: i32 = work[at];
    at = at + 1;
    if (v < 0 || v >= seen.len() || seen[v]) {
      continue;
    }
    seen = seen.with(v, true);
    out = out.append(v);
    let d: ssa.SInst = defs[v];
    if (d.kind_tag == 7 || d.kind_tag == 8) {
      for a in d.args {
        work = work.append(a);
      }
    }
  }
  return out;
}

// The declared fields a record or boxed-variant construction fills, one per
// element for an array literal; not ok for anything else, an Option or Result
// among them, whose box is a tag and a payload rather than a shape and fields.
// A closure's environment is a record only to the lowering, so it is not one
// here.
struct Construction { ok: boolean, fields: semrecords.Field[] }

function built_fields(f: ssasem.Func, ins: ssa.SInst): Construction {
  let none: semrecords.Field[] = [];
  let t: typeinfo.Type = f.values[ins.result];
  if (ins.kind_tag == ssasem.array_new()) {
    if let typeinfo.TypeArray(a) = t {
      let elems: semrecords.Field[] = [];
      while (elems.len() < ins.args.len()) {
        elems = elems.append(semrecords.Field { name: "", ty: a.elem });
      }
      return Construction { ok: true, fields: elems };
    }
  }
  if (ins.kind_tag == ssasem.record_new() && !semtypes.is_env(t)) {
    let at: i32 = semrecords.find(f.records, t);
    if (at >= 0) {
      return Construction { ok: true, fields: f.records.list[at].fields };
    }
  }
  if (ins.kind_tag == ssasem.variant_new()) {
    let e: i32 = semrecords.find_enum(f.enums, t);
    if (e >= 0 && f.enums[e].layout == semrecords.layout_variant()) {
      for v in f.enums[e].variants {
        if (v.name == ins.str) {
          return Construction { ok: true, fields: v.fields };
        }
      }
    }
  }
  return Construction { ok: false, fields: none };
}

// A field's static word, or "" when the value is not a constant this can
// place. A u32 literal carries its text rather than an immediate, as
// `ssarc.constant` reads it. A copy reads through to what it copies, which is
// how a spliced accessor's constant arrives.
function constant_word(f: ssasem.Func, defs: ssa.SInst[], v: i32, t: typeinfo.Type): string {
  if (!narrow_scalar(t)) {
    return "";
  }
  let d: ssa.SInst = through_copies(defs, v);
  let arg: i32 = constant_cast_arg(d);
  if (arg >= 0) {
    return cast_word(f, defs, arg, t);
  }
  if (d.kind_tag == 1 && d.str != "") {
    return small_decimal(d.str);
  }
  if (d.kind_tag == 1 || d.kind_tag == 2) {
    return util.i32_to_string(d.imm);
  }
  if (d.str != "-" || !ssasem.is_i32(t)) {
    return "";
  }
  return negated_word(defs, d);
}

// A non-negative integer literal cast to u8, i32 or u32, `7 as u8`, is the
// literal; the checker has already refused one that does not fit (E047).
// A byte table is written with such casts, and placing it keeps it from
// being built on every evaluation.
function cast_word(f: ssasem.Func, defs: ssa.SInst[], v: i32, t: typeinfo.Type): string {
  if (!ssasem.is_u8(t) && !ssasem.is_i32(t) && !ssasem.is_u32(t)) {
    return "";
  }
  let src: ssa.SInst = through_copies(defs, v);
  if (!integer_literal(f, src)) {
    return "";
  }
  if (src.str != "") {
    return small_decimal(src.str);
  }
  if (src.imm < 0) {
    return "";
  }
  return util.i32_to_string(src.imm);
}

function constant_cast_arg(ins: ssa.SInst): i32 {
  if (ins.kind_tag == ssasem.cast() && ins.args.len() == 1 && ins.args[0] >= 0) {
    return ins.args[0];
  }
  return -1;
}

// Float literals also use kind 1, but their source text is not an integer
// conversion's value: an f32 may already have rounded it (16777217 ->
// 16777216). Only integer source values can reuse their literal spelling.
function integer_literal(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag != 1 || ins.result < 0 || ins.result >= f.values.len()) {
    return false;
  }
  let from: typeinfo.Type = f.values[ins.result];
  return ssasem.is_integer(from) || ssasem.is_char(from);
}

// A 64-bit field's or element's word: an i64 or u64 literal's value, or an f64
// literal's bit pattern, as signed decimal; a negation of one negated; "" for
// anything else. Every backend keeps a record's field and a wide array's
// element in an 8-byte slot, so the word is the slot's bytes on each.
function wide_word(f: ssasem.Func, defs: ssa.SInst[], v: i32, t: typeinfo.Type): string {
  let float: boolean = ssasem.is_f64(t);
  if (!float && !ssasem.is_wide(t)) {
    return "";
  }
  let d: ssa.SInst = through_copies(defs, v);
  let neg: boolean = false;
  if (d.kind_tag == 10 && d.str == "-" && d.args.len() == 1 && d.args[0] >= 0) {
    neg = true;
    d = through_copies(defs, d.args[0]);
  }
  if (!float) {
    d = wide_literal(f, defs, d);
  }
  if (d.kind_tag != 1) {
    return "";
  }
  let bits: i64 = d.imm as i64;
  if (float) {
    bits = util.parse_f64_bits(d.str);
  } else if (d.str != "") {
    bits = util.lit_to_i64(d.str);
  }
  if (neg && float) {
    bits = bits ^ 1i64 << 63i64;
  } else if (neg) {
    bits = 0 - bits;
  }
  return util.i64_to_string(bits);
}

// `wide_literal(f, defs, d)` — the integer literal under a cast to the wide
// type, `10i32 as i64`, which is the literal at that width (an unsuffixed
// one the typed lowering already ascribes); `d` itself for anything else,
// a cast of a computed value among them, which is no literal.
function wide_literal(f: ssasem.Func, defs: ssa.SInst[], d: ssa.SInst): ssa.SInst {
  let arg: i32 = constant_cast_arg(d);
  if (arg < 0) {
    return d;
  }
  let src: ssa.SInst = through_copies(defs, arg);
  if (integer_literal(f, src)) {
    return src;
  }
  return d;
}

function through_copies(defs: ssa.SInst[], v: i32): ssa.SInst {
  let d: ssa.SInst = defs[v];
  let hops: i32 = 0;
  while (d.kind_tag == 7 && d.args.len() == 1 && d.args[0] >= 0 && hops < 16) {
    d = defs[d.args[0]];
    hops = hops + 1;
  }
  return d;
}

// A negative i32 literal is `0 - k` in source, which arrives as that
// subtraction or, once the front end has folded it, as a negation; negating a
// non-negative i32 cannot wrap.
function negated_word(defs: ssa.SInst[], d: ssa.SInst): string {
  let k: ssa.SInst = defs[d.args[d.args.len() - 1]];
  if (k.kind_tag != 1 || k.imm < 0) {
    return "";
  }
  if (d.kind_tag == 10) {
    return util.i32_to_string(0 - k.imm);
  }
  let zero: ssa.SInst = defs[d.args[0]];
  if (d.kind_tag != 9 || zero.kind_tag != 1 || zero.imm != 0) {
    return "";
  }
  return util.i32_to_string(0 - k.imm);
}

// A literal carried as its source text (an unsigned one), admitted only when
// it is plain decimal below 2^31, where its word reads the same at any width.
function small_decimal(text: string): string {
  if (text.len() == 0 || text.len() > 9) {
    return "";
  }
  let i: i32 = 0;
  while (i < text.len()) {
    if (text[i] < b'0' || text[i] > b'9') {
      return "";
    }
    i = i + 1;
  }
  return text;
}

function narrow_scalar(t: typeinfo.Type): boolean {
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  return ssasem.is_i32(t) || ssasem.is_u32(t) || ssasem.is_u8(t) || ssasem.is_char(t);
}

// The slice a value is, directly or retagged as a borrowed string; -1 when it
// is neither.
function lent_view(f: ssasem.Func, defs: ssa.SInst[], v: i32): i32 {
  if (v < 0 || v >= defs.len()) {
    return 0 - 1;
  }
  let d: ssa.SInst = defs[v];
  if (d.kind_tag == ssasem.slice() || byte_view_slice(f, d)) {
    return v;
  }
  if (d.kind_tag == ssasem.str_as() && d.args.len() == 1 && d.args[0] >= 0 && defs[d.args[0]].kind_tag == ssasem.slice()) {
    return d.args[0];
  }
  return 0 - 1;
}

// Whether the use of the view at operand `at` of `ins` reads it within the
// instruction. A string slice reaches a callee only through the retag
// `semsource.lend` makes at a borrowed `str` parameter (`lent`); a byte view
// (`byte`) is a callee's parameter type as it is, so it is read where the
// callee's declared mode borrows it.
function reads_view(f: ssasem.Func, ins: ssa.SInst, at: i32, lent: boolean, byte: boolean): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 9 || k == ssasem.append_range() || k == ssasem.length() || k == ssasem.str_index() || k == ssasem.str_bytes()) {
    return true;
  }
  if (k == ssasem.slice()) {
    return at == 0;
  }
  if (k == ssasem.str_as()) {
    return !lent;
  }
  if (byte) {
    if (k == ssasem.array_get() || k == ssasem.arr_slice()) {
      return at == 0;
    }
    if (k == ssasem.call()) {
      let modes: i32[] = callee_modes(f, ins);
      return at < modes.len() && modes[at] == borrow_mode();
    }
    return false;
  }
  return k == ssasem.call() && lent;
}

function is_record(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

// A value reached through another: a copy, a projection, or a retag.
function projection(kind: i32): boolean {
  return kind == 7 || kind == ssasem.array_get() || kind == ssasem.tuple_get() || kind == ssasem.record_get()
    || kind == ssasem.variant_get() || kind == ssasem.variant_up() || kind == ssasem.variant_as()
    || kind == ssasem.slice() || kind == ssasem.arr_slice() || kind == ssasem.str_as() || kind == ssasem.array_lend() || kind == ssasem.str_byte_view() || kind == ssasem.dyn_up() || kind == ssasem.dyn_as();
}

// Whether reading `arg` reads `w`: the value itself, or one anchored to it.
function reads(a: ssasem.Analysis, arg: i32, w: i32): boolean {
  if (arg < 0) {
    return false;
  }
  if (arg == w) {
    return true;
  }
  for dep in a.dependencies[arg] {
    if (dep == w) {
      return true;
    }
  }
  return false;
}

// Whether `w` is read after position `pos` of block `bi`: by a later
// instruction, by the terminator, or on the way out of the block.
function used_after(a: ssasem.Analysis, bi: i32, pos: i32, w: i32): boolean {
  if (ssalive.live_out_has(a.flow, bi, w) || ssasem.read_after(a.uses, bi, pos, w)) {
    return true;
  }
  let k: i32 = a.anchored.start[w];
  while (k < a.anchored.start[w + 1]) {
    if (ssasem.read_after(a.uses, bi, pos, a.anchored.at[k])) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

// used_after over the DIRECT relation (`direct`, the flow over `a.parents`
// alone): whether `v`, or a projection of it, is read after `pos`. The two
// relations are the model's two questions: the anchored one asks whether the
// storage behind a value is still needed, the direct one whether the value
// itself is still in hand.
function read_after_direct(a: ssasem.Analysis, direct: ssalive.Flow, bi: i32, pos: i32, v: i32): boolean {
  if (ssalive.live_out_has(direct, bi, v) || ssasem.read_after(a.uses, bi, pos, v)) {
    return true;
  }
  let k: i32 = a.anchored.start[v];
  while (k < a.anchored.start[v + 1]) {
    let w: i32 = a.anchored.at[k];
    if (has_id(a.parents[w], v) && ssasem.read_after(a.uses, bi, pos, w)) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function other_field_get(ins: ssa.SInst, root: i32, field: i32): boolean {
  return ins.kind_tag == ssasem.record_get() && ins.args[0] == root && ins.imm != field;
}

// The record whose field the projection `v` names, when this frame reads
// that field no further after the instruction at (`bi`, `pos`), or -1. The
// record is one this frame holds as a parameter or owns outright, and after
// the instruction it is read only through projections of its OTHER fields —
// the functional update `R { ...r, xs: f(r.xs) }` — with nothing anchored to
// the projected field, and nothing anchored to the record any other way,
// still live. A later block may read the record only through its other
// fields too (`named_after`), so a loop that reaches the same record again is
// refused; a loop-carried record is a fresh phi each round.
//
// What this proves is that THIS frame never reads the field again, so the
// buffer may be grown in place by the instruction, or by a callee it is
// handed to without a bracket. Whether another holder reads it is answered at
// run time — the record's own count, when it is shared — and by the
// caller-side bracket (`grow_rows`) for the frame that lent the record and
// still reads it.
function projection_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, v: i32): i32 {
  let none: i32 = 0 - 1;
  let get: ssa.SInst = defs[v];
  if (get.kind_tag != ssasem.record_get()) {
    return none;
  }
  let root: i32 = get.args[0];
  if (!is_record(f.values[root]) || semtypes.is_env(f.values[root])) {
    return none;
  }
  if (defs[root].kind_tag != 6 && !owned[root]) {
    return none;
  }
  if (projection(defs[root].kind_tag)) {
    return none;
  }
  // The field is read at `get` and taken or grown HERE, at a later use: the
  // instruction's own other operands count (`own_root`), the record beside
  // its field being the record read whole, and so does the field value
  // itself used again later, since the slot is not moved out at the read.
  if (needed_past_slot(f, a, defs, bi, pos, get, false, true, false)) {
    return none;
  }
  return root;
}

function other_tuple_get(ins: ssa.SInst, root: i32, field: i32): boolean {
  return ins.kind_tag == ssasem.tuple_get() && ins.args.len() == 1 && ins.args[0] == root && ins.imm != field;
}

// A source whose box this frame ALLOCATED, so nulling a slot in it is invisible
// to everyone else. The take nulls without asking, so this and
// `only_element_reads` are the whole of its safety: owning a unit is not
// enough, the box has to be the frame's alone.
//
// Only two kinds of instruction can define a TUPLE and qualify:
//
//   - a construction — `tuple_new` builds the box here, refcount 1;
//   - `map_delete`, whose result is the fresh two-word box the runtime
//     allocates to pair the map with whether the key was there.
//
// Everything else that can define a tuple hands back a box someone else still
// names, and is excluded:
//
//   - a counted PARAMETER. `own` transfers ONE unit, not exclusive ownership,
//     so the box may have other holders. `steal` next door admits a parameter
//     root only because it pays for it with a runtime `__fern_rc_is_unique`
//     test before nulling; the take does not test.
//   - `cell_get` and `map_get_or`, which RETAIN what they read (`cell_read`'s
//     and `map_op`'s `__fern_rc_inc`) — the cell and the map's value column
//     still hold the box, and a counted column may hold a tuple, so nulling
//     here would show up in every later read through the container.
//   - a CALL result, whose exclusivity this boundary cannot establish: a callee
//     may return a retained alias of something it goes on holding.
//   - a phi, because one of its incoming edges may be any of the above.
//
// The other `hands_out` operations answer an array, a map, an Option or a
// closure box and so can never be a take's source; naming them here would
// suggest a judgement about them that this predicate does not make.
function takeable_root(kind: i32): boolean {
  return construction(kind) || kind == ssasem.map_delete();
}

// The element index a tuple read at (`bi`, `pos`) TAKES rather than borrows,
// or -1. A projection borrows by default, so a consuming use of what it read
// owes a retain, which a take saves (#9555).
//
// It takes when the source is a unit of this frame's own, dies at this read,
// and is reached after it only through reads of its OTHER elements. The
// element's unit then becomes the frame's for nothing: the physical lowering
// nulls the slot, and the source's own drop — in this same step, since it dies
// here — walks past the null rather than releasing what the frame now holds.
//
// Same shape as `projection_root` above and the same reasoning, over a tuple
// rather than a record, and over the whole source rather than one field: a
// tuple has no functional-update form, so a later read through another element
// is the only way the source may still be mentioned.
function tuple_take_field(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
  let none: i32 = 0 - 1;
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (ins.kind_tag != ssasem.tuple_get()) {
    return none;
  }
  // This runs BEFORE the graph is verified, so a malformed instruction has
  // to answer "no take" rather than read past the end of its own operands.
  if (ins.args.len() != 1) {
    return none;
  }
  if (ins.result < 0 || ins.result >= f.graph.nvals) {
    return none;
  }
  let root: i32 = ins.args[0];
  if (root < 0 || root >= f.graph.nvals || root >= owned.len() || root >= defs.len()) {
    return none;
  }
  if (!ssasem.reference(f.values[ins.result])) {
    return none;
  }
  // A box this frame built has a count of 1 only until something else is
  // handed it, so every use has to be an element read.
  if (!owned[root] || !takeable_root(defs[root].kind_tag) || !ssasem.uses_only(a.uses, root, [ssasem.tuple_get()])) {
    return none;
  }
  // The untested take: the tuple must die in this block, so any liveness out
  // of it refuses (`strict`); another element's read is let through.
  if (needed_past_slot(f, a, defs, bi, pos, ins, true, false, true)) {
    return none;
  }
  return ins.imm;
}

// The element each tuple read takes, indexed by the read's result value, and
// -1 where it borrows. Computed before the step walk because the walk runs
// BACKWARDS: a taken element is a unit of the frame's own, and the consuming
// use that moves it is reached before the read that produced it.
function tuple_takes(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): i32[] {
  let out: i32[] = [];
  let vi: i32 = 0;
  while (vi < f.graph.nvals) {
    out = out.append(0 - 1);
    vi = vi + 1;
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let pos: i32 = 0;
    while (pos < f.graph.blocks[bi].insts.len()) {
      let field: i32 = tuple_take_field(f, a, owned, defs, bi, pos);
      if (field >= 0) {
        out = out.with(f.graph.blocks[bi].insts[pos].result, field);
      }

      pos = pos + 1;
    }
    bi = bi + 1;
  }
  return out;
}

// What a take changes about the plan's inputs, derived once so the planner and
// the independent replay below reach it the same way: the element becomes a
// unit of this frame's own, and it stops being ANCHORED to the tuple it came
// out of — the source is released in the same step, and leaving the dependency
// would read every later use of the element as a borrow outliving its
// container. A payload take says the same about an enum box's payload.
// `reflow` marks a take whose box is released alone (`shell_root`), or whose
// box was live out of the read's block only as the taken value's anchor: that
// box has to die at the read, which the flow derived before the take cannot say.
struct Units { owned: boolean[], parents: i32[][], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[], reflow: boolean, likely: boolean[] }

// The payload takes are derived FIRST and folded into ownership before the
// other two run: a taken payload is a unit of this frame's own, and the tuple
// takes and the element holds both ask whether the value they read through is
// owned. Deriving them against the base instead reads a taken payload as a
// borrow, and an element read of one then pins the array it came out of
// rather than taking its own unit — which is the whole of what a hold exists
// to prevent (#9891).
function units_of(f: ssasem.Func, base: boolean[], a: ssasem.Analysis, defs: ssa.SInst[], sup: SupplyTable): Units {
  let pt: PayloadTakes = payload_takes(f, a, base, defs);
  let payloads: boolean[] = pt.taken;
  let likely: boolean[] = pt.likely;
  let owned: boolean[] = base;
  let i: i32 = 0;
  while (i < payloads.len()) {
    if (payloads[i]) {
      owned = owned.with(i, true);
    }
    i = i + 1;
  }
  let takes: i32[] = tuple_takes(f, a, owned, defs);
  let held: boolean[] = held_elements(f, a, owned, defs, sup);
  // A taken payload or tuple element is a unit of its own at the read
  // already, moved out of the box or retained there by the lowering's
  // uniqueness test (ssarc.steal); the hold read it as still anchored to its
  // source, and would retain it a second time.
  i = 0;
  while (i < held.len()) {
    if (held[i] && (payloads[i] || takes[i] >= 0)) {
      held = held.with(i, false);
    }
    i = i + 1;
  }
  let parents: i32[][] = a.parents;
  let deps: i32[][] = a.dependencies;
  let reflow: boolean = pt.crossing;
  i = 0;
  while (i < takes.len()) {
    // A taken record field reflows, as a taken payload does: the values
    // read through it still chain to the record, which has to die at the
    // read. option_layout already admits a record (it is not an enum), so
    // the record_get test states that rather than widening the gate.
    if (payloads[i] && (defs[i].kind_tag == ssasem.record_get() || defs[i].kind_tag == ssasem.tuple_get() || option_layout(f, f.values[defs[i].args[0]]))) {
      reflow = true;
    }
    if (takes[i] >= 0 || held[i] || payloads[i]) {
      owned = owned.with(i, true);
      // A view's bytes are its source's, not the box's it came out of, so
      // a taken view stays anchored to what the box was.
      let up: i32[] = [];
      let chain: i32[] = [];
      if ((takes[i] >= 0 || payloads[i]) && ssasem.is_view(f.values[i])) {
        up = a.parents[defs[i].args[0]];
        chain = a.dependencies[defs[i].args[0]];
      }
      parents = parents.with(i, up);
      deps = deps.with(i, chain);
    }
    i = i + 1;
  }
  if (reflow) {
    deps = through_takes(parents, deps, takes, held, payloads);
  }
  return Units { owned: owned, parents: parents, deps: deps, takes: takes, held: held, payloads: payloads, reflow: reflow, likely: likely };
}

// A value read through one that became a unit of its own reaches the storage
// behind it only through that unit's new chain, so every chain stops at each
// such value and continues with its chain.
function through_takes(parents: i32[][], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[]): i32[][] {
  let out: i32[][] = deps;
  let w: i32 = 0;
  while (w < deps.len()) {
    out = out.with(w, reach_through(parents, deps, takes, held, payloads, w, []));
    w = w + 1;
  }
  return out;
}

function reach_through(parents: i32[][], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[], x: i32, own out: i32[]): i32[] {
  for p in parents[x] {
    if (util.index_of_i32(out, p) >= 0) {
      continue;
    }
    out = out.append(p);
    if (takes[p] >= 0 || held[p] || payloads[p]) {
      for e in deps[p] {
        if (util.index_of_i32(out, e) < 0) {
          out = out.append(e);
        }
      }
    } else {
      out = reach_through(parents, deps, takes, held, payloads, p, out);
    }
  }
  return out;
}

// The analysis the plan and its replay read once the takes and holds are in:
// the reads that became units of their own anchor nothing. A hold shortens a
// chain that is still live, so the flow is derived again over the new chains
// and the array a held read came from dies where its own uses end; a take's
// source dies at the read, so a take alone leaves the flow as it was.
function units_analysis(f: ssasem.Func, a: ssasem.Analysis, units: Units): ssasem.Analysis {
  let any: boolean = units.reflow;
  for h in units.held {
    if (h) {
      any = true;
    }
  }
  if (!any) {
    return ssasem.Analysis { ...a, parents: units.parents, dependencies: units.deps, anchored: ssasem.anchored_of(units.deps, f.graph.nvals) };
  }
  let flow: ssalive.Flow = ssadeps.analyze(f.graph, units.deps);
  return ssasem.Analysis { ...a, ok: flow.ok, why: flow.why, parents: units.parents, dependencies: units.deps, flow: flow, anchored: ssasem.anchored_of(units.deps, f.graph.nvals) };
}

// A read of an array element, a record field or a tuple element, of a type
// the frame can hold a unit of: a view is lent, never retained, and a scalar
// has no unit.
function retainable_read(f: ssasem.Func, defs: ssa.SInst[], w: i32): boolean {
  let k: i32 = defs[w].kind_tag;
  if (k != ssasem.array_get() && k != ssasem.record_get() && k != ssasem.tuple_get()) {
    return false;
  }
  let t: typeinfo.Type = f.values[w];
  return ssasem.reference(t) && !ssasem.is_view(t);
}

// The reads anchored to `s` that are still in hand once `s` is
// supplied: past the operation at (`bi`, `pos`), into block `si` when `s`
// goes out along an edge, or as an operand of that same operation (`args`)
// where `s` dies. A read handed to a call beside its own array would
// otherwise keep the array alive through the call as its anchor, so the
// array was retained for the call instead of moved into it, and every
// append the callee made copied the buffer. A read already `owned` took its
// slot (payload_root) and has its unit.
function outliving(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], owned: boolean[], held: boolean[], s: i32, bi: i32, pos: i32, si: i32, args: i32[]): i32[] {
  let out: i32[] = [];
  let k: i32 = a.anchored.start[s];
  while (k < a.anchored.start[s + 1]) {
    let w: i32 = a.anchored.at[k];
    if (w != s && !held[w] && !owned[w] && retainable_read(f, defs, w)) {
      let live: boolean = false;
      if (si >= 0) {
        live = ssalive.live_in_has(a.flow, si, w);
      } else {
        live = used_after(a, bi, pos, w) || has_id(args, w) && !used_after(a, bi, pos, s);
      }
      if (live) {
        out = out.append(w);
      }
    }
    k = k + 1;
  }
  return out;
}

// A read of an element or a field still in hand when its array, record or
// tuple is consumed takes a unit of its own at the read: one that outlives
// the consuming use, or one handed to that use beside its source
// (`outliving`). Retained there, released when it dies, anchored to nothing.
// As a borrow it kept the source alive past the use, so a `.with`, an append
// or a call there retained the source instead of moving it, and the write
// copied the whole buffer (#9849, #11834). A read that dies before any such
// use stays a borrow and costs nothing.
//
// A read still in hand at its source's last read, where the source dies
// unconsumed, takes a unit there too when it, or a read anchored to it, is
// consumed later: as a borrow it kept the source alive to that use, so the
// use retained it instead of moving it, and every write past it copied
// (#11913). The source's last read is its own or one of its direct
// projections', so a field an update keeps, consumed by the construction the
// source donates its box to, is not in hand past it. A read only borrowed to
// its death leaves the source to die with it. A held read is a unit of its
// own, so what it is consumed beside is asked again until no read is added.
function held_elements(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], sup: SupplyTable): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let direct: ssalive.Flow = ssalive.compute_checked(f.graph, a.parents);
  let consumed: boolean[] = consumed_values(f, owned, sup);
  let before: i32 = 0 - 1;
  let count: i32 = 0;
  while (count != before) {
    before = count;
    out = hold_pass(f, a, defs, direct, consumed, owned, out, sup);
    count = count_true(out);
  }
  return out;
}

function hold_pass(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], direct: ssalive.Flow, consumed: boolean[], owned: boolean[], own out: boolean[], sup: SupplyTable): boolean[] {
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    let pos: i32 = 0;
    while (pos < b.insts.len()) {
      let ins: ssa.SInst = b.insts[pos];
      if (ins.kind_tag != 6 && ins.kind_tag != 8) {
        out = hold_at(f, a, defs, direct, consumed, owned, out, ins, bi, pos, sup.at(bi, pos));
      }
      pos = pos + 1;
    }
    out = hold_along(f, a, defs, owned, out, b, bi);
    bi = bi + 1;
  }
  return out;
}

// hold_pass at the instruction `ins`, `pos` in block `bi`.
function hold_at(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], direct: ssalive.Flow, consumed: boolean[], owned: boolean[], own out: boolean[], ins: ssa.SInst, bi: i32, pos: i32, supplies: Supply[]): boolean[] {
  for got in supplies {
    if (owned[got.value] || out[got.value]) {
      let past: i32[] = outliving(f, a, defs, owned, out, got.value, bi, pos, 0 - 1, ins.args);
      out = mark_all(out, past);
    }
  }
  for v in dying_reads(f, a, direct, owned, out, supplies, bi, pos) {
    for w in outliving(f, a, defs, owned, out, v, bi, pos, 0 - 1, []) {
      if (wanted(a.anchored, consumed, w)) {
        out = out.with(w, true);
      }
    }
  }
  return out;
}

// hold_pass along the edges out of block `b`, `bi`.
function hold_along(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], owned: boolean[], own out: boolean[], b: ssa.SBlock, bi: i32): boolean[] {
  let targets: i32[] = successors(b);
  for target in targets {
    let si: i32 = ssalive.position(a.flow, target);
    let along: Supply[] = edge_supplies(f, b, si, owned);
    for got in along {
      if (owned[got.value] || out[got.value]) {
        let past: i32[] = outliving(f, a, defs, owned, out, got.value, bi, 0, si, []);
        out = mark_all(out, past);
      }
    }
  }
  return out;
}

function mark_all(own flags: boolean[], ids: i32[]): boolean[] {
  for id in ids {
    flags = flags.with(id, true);
  }
  return flags;
}

function count_true(flags: boolean[]): i32 {
  let n: i32 = 0;
  for flag in flags {
    if (flag) {
      n = n + 1;
    }
  }
  return n;
}

// The owned sources the operation at (`bi`, `pos`) reads for the last time
// without consuming, itself or through a direct projection: no later
// operation of the block, no terminator and no successor reads them or a
// direct projection of them, whatever else still depends on them.
function dying_reads(f: ssasem.Func, a: ssasem.Analysis, direct: ssalive.Flow, owned: boolean[], held: boolean[], supplies: Supply[], bi: i32, pos: i32): i32[] {
  let out: i32[] = [];
  for u in f.graph.blocks[bi].insts[pos].args {
    if (u < 0) {
      continue;
    }
    for v in a.parents[u].append(u) {
      if (!(owned[v] || held[v]) || has_id(out, v) || supplied(supplies, v)) {
        continue;
      }
      if (!read_after_direct(a, direct, bi, pos, v)) {
        out = out.append(v);
      }
    }
  }
  return out;
}

function supplied(supplies: Supply[], v: i32): boolean {
  for got in supplies {
    if (got.value == v) {
      return true;
    }
  }
  return false;
}

// The values some operation consumes: a supply of an operation, of an owned
// phi along an edge, or of a return.
function consumed_values(f: ssasem.Func, owned: boolean[], sup: SupplyTable): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let bi: i32 = 0;
  for b in f.graph.blocks {
    let pos: i32 = 0;
    for ins in b.insts {
      if (ins.kind_tag == 8) {
        if (owned[ins.result]) {
          out = mark_all(out, ins.args);
        }
      } else if (ins.kind_tag != 6) {
        for got in sup.at(bi, pos) {
          out = out.with(got.value, true);
        }
      }
      pos = pos + 1;
    }
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      out = out.with(b.term.value, true);
    }
    bi = bi + 1;
  }
  return out;
}

// Whether `w` or a read anchored to it is consumed somewhere.
function wanted(anchored: ssasem.Anchored, consumed: boolean[], w: i32): boolean {
  if (consumed[w]) {
    return true;
  }
  let k: i32 = anchored.start[w];
  while (k < anchored.start[w + 1]) {
    if (consumed[anchored.at[k]]) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

// A later read of a DIFFERENT payload slot of the same box: the box is
// mentioned again, but not through the slot a take has emptied.
function other_payload_get(ins: ssa.SInst, root: i32, slot: i32): boolean {
  return ins.kind_tag == ssasem.variant_get() && ins.args.len() == 1 && ins.args[0] == root && ins.imm != slot;
}

// The box whose slot the read at (`bi`, `pos`) may MOVE out of rather than
// borrow, or -1: an enum's payload named by a variant read, or an array, map
// or record held in a record's field, a tuple's element or an owned array's
// element (field_takeable). Same shape as
// `projection_root` above, over the one slot the read names: the box is a
// unit of this frame's own, no later block names it, and after the read it
// is reached only through reads of its OTHER slots (`needed_past_slot`).
//
// The untested tuple take next door demands more of its source —
// `takeable_root`, a box this frame ALLOCATED — because it nulls without
// asking, and keeps the tuples that qualify for it. Here the physical
// lowering pays for a weaker source with a runtime uniqueness test on the box
// (`ssarc.steal`): a box somebody else also holds keeps its payload and the
// read retains, exactly as a borrow did. So what this predicate has to prove
// is only that THIS frame reads the slot no further. The builtin Option
// layout's slot is nulled with `op_opt_set_payload`.
function payload_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], spec: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
  let none: i32 = 0 - 1;
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  let field: boolean = ins.kind_tag == ssasem.record_get();
  let element: boolean = ins.kind_tag == ssasem.tuple_get();
  let slot: boolean = ins.kind_tag == ssasem.array_get();
  let arity: i32 = 1;
  if (slot) {
    arity = 2;
  }
  if (ins.kind_tag != ssasem.variant_get() && !field && !element && !slot || ins.args.len() != arity) {
    return none;
  }
  // This runs BEFORE the graph is verified, so a malformed instruction has
  // to answer "no take" rather than read past the end of its own operands.
  if (ins.result < 0 || ins.result >= f.graph.nvals) {
    return none;
  }
  let root: i32 = ins.args[0];
  if (root < 0 || root >= f.graph.nvals || root >= owned.len() || root >= defs.len()) {
    return none;
  }
  // A struct-union's members live in the arrays and records that hold a
  // program's tokens, nodes and types, so a member read out of one is shared
  // with its holder; its take would test the box and retain every time.
  if (ins.kind_tag == ssasem.variant_get() && !spec[root] && member_union(f, f.values[root])) {
    return none;
  }
  // A tuple this frame built is `tuple_take_field`'s, which nulls without
  // asking; this tested take is for one it was handed.
  if (element && takeable_root(defs[root].kind_tag)) {
    return none;
  }
  if (!slot_takeable(f, a, defs, f.values[ins.result], root, field, element, slot)) {
    return none;
  }
  if (!owned[root] || projection(defs[root].kind_tag) && !taken_root(defs[root].kind_tag)) {
    return none;
  }
  // Another slot's read is let through, and so is what the taken value
  // carries: the slot is moved out, not borrowed.
  if (needed_past_slot(f, a, defs, bi, pos, ins, false, false, true)) {
    return none;
  }
  return root;
}

// Whether the box `root` can give up the slot the read `got` names: a
// buffer, map or record field of a record, element of a tuple or element of
// an owned array, or a reference payload of a union. A view, or a union whose
// schema this function does not carry, needs a box nobody else sees.
function slot_takeable(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], got: typeinfo.Type, root: i32, field: boolean, element: boolean, slot: boolean): boolean {
  let box: typeinfo.Type = f.values[root];
  if (field) {
    return field_takeable(got) && is_record(box) && !semtypes.is_env(box);
  }
  if (element) {
    return field_takeable(got) && is_tuple(box);
  }
  if (slot) {
    return field_takeable(got) && is_array(box) && !ssasem.is_view(box);
  }
  if (!ssasem.reference(got) || !is_union(box)) {
    return false;
  }
  return !(ssasem.is_view(got) || unknown_layout(f, box)) || sole_box(a, defs, root, __alloc_bool(f.graph.nvals));
}

// Whether the box the read `take` reads from is still needed past position
// `pos` of block `bi` other than through the slot `take` names: a later read
// of it in the block, a value anchored to it that is used after `pos`, or a
// block that can run later naming it (`named_after`). A read of another of its slots is let
// through everywhere; so is a value that reaches it only through the taken
// value, when `through_take` is set, since the take moves that value out.
// `strict` refuses any liveness out of the block, a tuple take's rule.
// `own_root` counts the instruction's own operands too, the root among them:
// a call handed a record beside its field reads the record whole.
//
// The three takes and the field steal are this one question asked with
// different allowances; what each allows is stated at its call.
function needed_past_slot(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], bi: i32, pos: i32, take: ssa.SInst, strict: boolean, own_root: boolean, through_take: boolean): boolean {
  let root: i32 = take.args[0];
  let b: ssa.SBlock = f.graph.blocks[bi];
  if (ssalive.live_out_has(a.flow, bi, root) && (strict || named_after(f, a, defs, bi, root, take))) {
    return true;
  }
  let stores: i32 = 0;
  let u: i32 = a.uses.start[root];
  while (u < a.uses.start[root + 1]) {
    if (a.uses.block[u] == bi && a.uses.at[u] > pos) {
      if (a.uses.kinds[u] == ssasem.term_use()) {
        return true;
      }
      let later: ssa.SInst = b.insts[a.uses.at[u]];
      if (same_slot_with(defs, later, take)) {
        if (a.uses.slot[u] == 0) {
          stores = stores + 1;
          if (stores > 1) {
            return true;
          }
        }
      } else if (!other_slot_get(later, take)) {
        return true;
      }
    }
    u = u + 1;
  }
  if (own_root) {
    for arg in b.insts[pos].args {
      if (arg != take.result && (arg == root || reaches_root(a, defs, take, root, through_take, arg))) {
        return true;
      }
    }
  }
  let k: i32 = a.anchored.start[root];
  while (k < a.anchored.start[root + 1]) {
    let w: i32 = a.anchored.at[k];
    if (reaches_root(a, defs, take, root, through_take, w) && used_after(a, bi, pos, w)) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

// Whether `w` reaches `root` other than through the slot `take` names: it is
// anchored to the root, and its first hop towards it is neither a read of
// another slot nor, with `through_take`, the taken value itself.
//
// The first hop is the projection of `root` that `w` reaches it through: `w`
// itself when its parent is the root, else the chain element just before the
// root. There is none when a value on the chain up to the root is anchored to
// more than one, since the chain then names no one path. One pass over `w`'s
// chain finds both the root and the hop.
function reaches_root(a: ssasem.Analysis, defs: ssa.SInst[], take: ssa.SInst, root: i32, through_take: boolean, w: i32): boolean {
  if (w < 0 || w == root || through_take && w == take.result) {
    return false;
  }
  let single: boolean = a.parents[w].len() <= 1;
  let prev: i32 = w;
  let hop: i32 = 0 - 1;
  let found: boolean = false;
  for dep in a.dependencies[w] {
    if (dep == root) {
      found = true;
      if (single) {
        hop = prev;
      }
      break;
    }
    if (a.parents[dep].len() > 1) {
      single = false;
    }
    prev = dep;
  }
  if (!found || through_take && hop == take.result) {
    return false;
  }
  return hop < 0 || !other_slot_get(defs[hop], take);
}

// A block after bi reads v. The walk stops at the block defining v — a loop's
// header, for a phi — since past that definition v is a new value. A phi reads
// an operand only on its own incoming edge, so it counts where the walk enters
// its block by that edge: an arm that rebuilt v hands the join its new value,
// whatever the join takes from the arms that left v alone. A later read of
// another of v's slots is let through, as `needed_past_slot` lets it through
// within the block: what keeps v live is then not the slot taken. A
// read of the taken slot itself still counts, so a take a loop would run again
// on the same box is refused. The walk keeps to v's live range: a block v is
// not live out of hands it to no successor, phi edges included, and a block v
// is not live into reads it nowhere.
function named_after(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], bi: i32, v: i32, take: ssa.SInst): boolean {
  let seen: boolean[] = __alloc_bool(f.graph.blocks.len());
  let work: i32[] = [bi];
  let next: i32 = 0;
  while (next < work.len()) {
    let at: i32 = work[next];
    next = next + 1;
    if (!ssalive.live_out_has(a.flow, at, v)) {
      continue;
    }
    let from: ssa.SBlock = f.graph.blocks[at];
    for id in successors(from) {
      let k: i32 = ssalive.position(a.flow, id);
      if (k >= 0) {
        let blk: ssa.SBlock = f.graph.blocks[k];
        if (phi_reads_on(a.uses, blk, k, from.id, v)) {
          return true;
        }
        if (!seen[k]) {
          seen = seen.with(k, true);
          if (ssalive.live_in_has(a.flow, k, v) && !block_defines(blk, v)) {
            if (block_reads(a.uses, defs, blk, k, v, take)) {
              return true;
            }
            work = work.append(k);
          }
        }
      }
    }
  }
  return false;
}

function block_defines(blk: ssa.SBlock, v: i32): boolean {
  for ins in blk.insts {
    if (ins.result == v) {
      return true;
    }
  }
  return false;
}

// A phi of blk, the block at index `k`, takes v on the edge from block
// `pred`.
function phi_reads_on(u: ssasem.Uses, blk: ssa.SBlock, k: i32, pred: i32, v: i32): boolean {
  let i: i32 = u.start[v];
  while (i < u.start[v + 1]) {
    if (u.block[i] == k && u.kinds[i] == 8 && u.slot[i] < blk.preds.len() && blk.preds[u.slot[i]] == pred) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// A non-phi instruction or the terminator of blk, the block at index `k`,
// reads v other than through another of its slots, or through the with that
// stores back at the taken element; a phi's reads are `phi_reads_on`'s, edge
// by edge.
function block_reads(u: ssasem.Uses, defs: ssa.SInst[], blk: ssa.SBlock, k: i32, v: i32, take: ssa.SInst): boolean {
  let i: i32 = u.start[v];
  while (i < u.start[v + 1]) {
    if (u.block[i] == k) {
      if (u.kinds[i] == ssasem.term_use()) {
        return true;
      }
      if (u.kinds[i] != 8) {
        let later: ssa.SInst = blk.insts[u.at[i]];
        if (!other_slot_get(later, take) && !(u.slot[i] == 0 && same_slot_with(defs, later, take))) {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

// The with that stores back at the array element `take` read: the same
// index value, or the same literal, since a `slots[1]` and a `.with(1, x)`
// name their index with a literal each.
function same_slot_with(defs: ssa.SInst[], later: ssa.SInst, take: ssa.SInst): boolean {
  return take.kind_tag == ssasem.array_get() && later.kind_tag == ssasem.with() && later.args.len() == 3 && later.args[0] == take.args[0]
    && same_index(defs, later.args[1], take.args[1]);
}

function same_index(defs: ssa.SInst[], x: i32, y: i32): boolean {
  if (x == y) {
    return true;
  }
  if (x < 0 || y < 0 || x >= defs.len() || y >= defs.len()) {
    return false;
  }
  let a: ssa.SInst = defs[x];
  let b: ssa.SInst = defs[y];
  return a.kind_tag == 1 && b.kind_tag == 1 && a.imm == b.imm && a.str == b.str;
}

// A later read of the box `take` reads that names a DIFFERENT slot of it.
function other_slot_get(later: ssa.SInst, take: ssa.SInst): boolean {
  if (take.kind_tag == ssasem.record_get()) {
    return other_field_get(later, take.args[0], take.imm);
  }
  if (take.kind_tag == ssasem.tuple_get()) {
    return other_tuple_get(later, take.args[0], take.imm);
  }
  return other_payload_get(later, take.args[0], take.imm);
}

// A record field, tuple element or array element a take may move out: a
// buffer, a map, a record or a union, whose slot is one word the take can
// null. A string may be a view or a literal at run time, and is left to the
// borrow.
function field_takeable(t: typeinfo.Type): boolean {
  if (ssasem.is_view(t) || ssasem.is_text(t)) {
    return false;
  }
  return is_array(t) || ssasem.is_map(t) || is_record(t) && !semtypes.is_env(t) || is_union(t);
}

// A one-operand slot read that may itself be a take: a record field, a
// variant payload or a tuple element. The reuse tables read a donor's slot
// reads through it.
function taken_read(kind: i32): boolean {
  return kind == ssasem.record_get() || kind == ssasem.variant_get() || kind == ssasem.tuple_get();
}

// A projection whose read may be a take, and so a unit of the frame's own
// that a nested read can take from in turn: the slot reads, and an array
// element's.
function taken_root(kind: i32): boolean {
  return taken_read(kind) || kind == ssasem.array_get();
}

// A box nobody but this frame's tag tests and payload reads ever sees: built
// here, or a phi of boxes that are, and never handed to anything else. Its
// count is 1 when its payload is read, so the read may take the payload with no
// runtime test — which a view needs, since the test's shared arm retains, and
// a union whose schema this function does not carry, since its slot cannot be
// nulled. The box's drop in that step then releases the box alone
// (`shell_root`).
function sole_box(a: ssasem.Analysis, defs: ssa.SInst[], v: i32, seen: boolean[]): boolean {
  if (v < 0 || v >= defs.len()) {
    return false;
  }
  if (seen[v]) {
    return true;
  }
  let d: ssa.SInst = defs[v];
  if (d.kind_tag != ssasem.variant_new() && d.kind_tag != 8) {
    return false;
  }
  if (!ssasem.uses_only(a.uses, v, [8, ssasem.variant_is(), ssasem.variant_get()])) {
    return false;
  }
  if (d.kind_tag == 8) {
    let next: boolean[] = seen.with(v, true);
    for x in d.args {
      if (!sole_box(a, defs, x, next)) {
        return false;
      }
    }
  }
  return true;
}

// The box whose drop at `ins` releases the box alone: the root of an
// untested payload take, one out of a box nobody else sees (`sole_box`),
// which leaves the slot as it is, or -1. A tested take empties the slot
// (ssarc.steal), so its box is released whole.
pub function shell_root(f: ssasem.Func, p: Plan, ins: ssa.SInst): i32 {
  if (ins.kind_tag != ssasem.variant_get() || ins.result < 0 || ins.result >= p.payloads.len() || !p.payloads[ins.result]) {
    return 0 - 1;
  }
  let root: i32 = ins.args[0];
  if (!(ssasem.is_view(f.values[ins.result]) || unknown_layout(f, f.values[root])) || !sole_box(p.unit_analysis, p.defs, root, __alloc_bool(f.graph.nvals))) {
    return 0 - 1;
  }
  return root;
}

function is_tuple(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  return false;
}

function is_union(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(_) = t {
    return true;
  }
  return false;
}

// True for the builtin Option/Result layout, and for a union whose schema this
// function does not carry.
function option_layout(f: ssasem.Func, t: typeinfo.Type): boolean {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return true;
  }
  return f.enums[at].layout == semrecords.layout_option();
}

// A union whose schema this function does not carry: not a box a take may
// null a slot in.
function unknown_layout(f: ssasem.Func, t: typeinfo.Type): boolean {
  return semrecords.find_enum(f.enums, t) < 0;
}

// The variant and record reads that take their slot's unit, indexed by the
// read's result value. Computed before the step walk for the same reason the tuple
// takes are: the walk runs backwards, so the consuming use that moves the
// payload is reached before the read that produced it.
//
// To a fixpoint: a take makes its read a unit of the frame's own, which a read
// of one of ITS slots may take from in turn — `let ws = s.words; let xs =
// ws.xs;`.
//
// `crossing` is set when a take's box is live out of the read's block in the
// flow derived before the take — the taken value leaves the block, and the box
// stayed live only as its anchor — so the flow has to be derived again for the
// box to die at the read.
struct PayloadTakes { taken: boolean[], crossing: boolean, likely: boolean[] }

function payload_takes(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): PayloadTakes {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let crossing: boolean = false;
  let own: boolean[] = owned;
  let spec: boolean[] = likely_unique(f, defs);
  let grown: boolean = true;
  while (grown) {
    grown = false;
    let bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
      let pos: i32 = 0;
      while (pos < f.graph.blocks[bi].insts.len()) {
        let v: i32 = f.graph.blocks[bi].insts[pos].result;
        if (v >= 0 && v < out.len() && !out[v]) {
          let root: i32 = payload_root(f, a, own, spec, defs, bi, pos);
          if (root >= 0) {
            out = out.with(v, true);
            own = own.with(v, true);
            spec = spec.with(v, true);
            crossing = crossing || ssalive.live_out_has(a.flow, bi, root);
            grown = true;
          }
        }
        pos = pos + 1;
      }
      bi = bi + 1;
    }
  }
  return PayloadTakes { taken: out, crossing: crossing, likely: spec };
}

// Whether `t` is a struct-union: a union whose variants are its members' own
// boxes.
function member_union(f: ssasem.Func, t: typeinfo.Type): boolean {
  let e: i32 = semrecords.find_enum(f.enums, t);
  return e >= 0 && f.enums[e].layout == semrecords.layout_member();
}

// Whether each value's box is plausibly this frame's alone where it is read: a
// parameter declared `own`, whose callers hand over a fresh value, another
// owned one or a local at its last use (E051), a construction, or a phi or
// copy of such values alone. A projection read holds a retained reference
// out of a container that still holds its own, so its box is shared where it
// is read, until a payload take makes it the frame's; a call's result may be
// one the callee handed out of its own holder; and a parameter the ownership
// inference made owned is fed by whatever its callers last read, a retained
// field as often as not. A speculation on a box shared by construction — a
// payload take, a reuse pairing, an inline drop of a known variant — pays its
// uniqueness test and loses it every time, and carries the code of the arm it
// never takes: over the compiler's own sources that cost 2.4% of a compile.
function likely_unique(f: ssasem.Func, defs: ssa.SInst[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      let k: i32 = ins.kind_tag;
      if (ins.result >= 0 && ins.result < out.len()) {
        let yes: boolean = k == 7 || k == 8;
        if (k == 6) {
          yes = ins.str == "own";
        } else if (!yes && k < 0) {
          yes = construction(k);
        }
        out = out.with(ins.result, yes);
      }
    }
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        if ((ins.kind_tag == 7 || ins.kind_tag == 8) && ins.result >= 0 && ins.result < out.len() && out[ins.result]) {
          for arg in ins.args {
            if (arg >= 0 && arg < out.len() && !out[arg] && out[ins.result]) {
              out = out.with(ins.result, false);
              changed = true;
            }
          }
        }
      }
    }
  }
  return out;
}

// The record whose field buffer the append, with or string append at (`bi`,
// `pos`) may grow or write in place, or -1: `projection_root` of its receiver.
// A string append needs a record the frame owns: no caller brackets a text
// field it lends (grow_rows), so a borrowed record's string is never grown.
function field_grow_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (string_append(f, ins)) {
    let root: i32 = projection_root(f, a, owned, defs, bi, pos, ins.args[0]);
    if (root >= 0 && owned[root]) {
      return root;
    }
    return 0 - 1;
  }
  if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) {
    return 0 - 1;
  }
  return projection_root(f, a, owned, defs, bi, pos, ins.args[0]);
}

function is_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

pub function occurrences(xs: i32[], v: i32): i32 {
  let n: i32 = 0;
  for x in xs {
    if (x == v) {
      n = n + 1;
    }
  }
  return n;
}

// A direct call's counted slot fed by a projection of a record this frame
// owns and reads no further through that field takes the field's unit rather
// than a retained one (steal_unit): the callee then holds the buffer's only
// count and grows it in place. `Emit { ...e, r: emit(e.r, op) }` is the shape,
// and retaining there put a second count on every buffer the emit chain
// threads, so the callee's first append copied it. A field read that took its
// unit (payload_root) already owns it, and its record may be gone.
function steals(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, s: Step): Step {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (ins.kind_tag != ssasem.call()) {
    return s;
  }
  let out: Supply[] = s.supplies;
  let i: i32 = 0;
  while (i < out.len()) {
    let v: i32 = out[i].value;
    if (out[i].mode == retain_unit() && defs[v].kind_tag == ssasem.record_get() && !owned[v] && occurrences(ins.args, v) == 1) {
      let root: i32 = projection_root(f, a, owned, defs, bi, pos, v);
      if (root >= 0 && owned[root]) {
        out = out.with(i, Supply { ...out[i], mode: steal_unit() });
      }
    }
    i = i + 1;
  }
  return Step { ...s, supplies: out };
}

// The buffers a direct call at (`bi`, `pos`) is handed without a bracket:
// an array operand this frame reads no further, either a borrowed parameter
// of its own or a projection, not a take, whose record it reads no further
// through that field (projection_root); or a whole record parameter this frame reads no
// further, whose fields the callee grows under the record's own count. An
// operand named twice is bracketed, since a callee growing one name would
// move the other. The buffer's only later holder is then the callee's result
// — retained on identity, fresh on a realloc — and the record or the caller
// releases the old one.
function hands(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, s: Step): Step {
  let ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
  if (ins.kind_tag != ssasem.call()) {
    return s;
  }
  let roots: i32[] = [];
  let fields: i32[] = [];
  for v in ins.args {
    let root: i32 = 0 - 1;
    let field: i32 = 0 - 1;
    let lent_param: boolean = defs[v].kind_tag == 6 && !owned[v] && occurrences(ins.args, v) == 1 && !used_after(a, bi, pos, v);
    if (is_array(f.values[v]) && !ssasem.is_text(f.values[v]) && occurrences(ins.args, v) == 1) {
      if (lent_param) {
        root = v;
      }
      if (defs[v].kind_tag == ssasem.record_get() && !owned[v]) {
        root = projection_root(f, a, owned, defs, bi, pos, v);
        if (root >= 0) {
          field = defs[v].imm;
        }
      }
    }
    if (is_record(f.values[v]) && !semtypes.is_env(f.values[v]) && lent_param) {
      root = v;
    }
    roots = roots.append(root);
    fields = fields.append(field);
  }
  return Step { ...s, hand_roots: roots, hand_fields: fields };
}

// choose_ids takes the dead values listed by id, each once, in any order: a
// dead owned supply moves its unit (the last one to name it), every other
// supply retains, and the other dead owned values drop, in ascending id order. A `pinned` value retains and
// drops after the operation instead of moving.
function choose_ids(s: Step, supplies: Supply[], dead: i32[], owned: boolean[], pinned: i32[]): Step {
  let moved: i32[] = [];
  let selected: Supply[] = supplies;
  let i: i32 = selected.len() - 1;
  while (i >= 0) {
    let item: Supply = selected[i];
    let mode: i32 = retain_unit();
    if (owned[item.value] && has_id(dead, item.value) && !has_id(moved, item.value) && !has_id(pinned, item.value)) {
      mode = move_unit();
      moved = moved.append(item.value);
    }
    selected = selected.with(i, Supply { ...item, mode: mode });
    i = i - 1;
  }
  let drops: i32[] = [];
  for v in dead {
    if (owned[v] && !has_id(moved, v)) {
      drops = insert_sorted(drops, v);
    }
  }
  return Step { ...s, supplies: selected, drops: drops };
}

function has_id(xs: i32[], v: i32): boolean {
  for x in xs {
    if (x == v) {
      return true;
    }
  }
  return false;
}

function insert_sorted(own xs: i32[], v: i32): i32[] {
  xs = xs.append(v);
  let i: i32 = xs.len() - 1;
  while (i > 0 && xs[i - 1] > v) {
    xs = xs.with(i, xs[i - 1]);
    i = i - 1;
  }
  return xs.with(i, v);
}

pub function plan(f: ssasem.Func, modes: i32[], view: SchemaView): Plan {
  return plan_analyzed(f, modes, ssasem.analyze(f), view);
}

// plan over an analysis the caller already holds of this very `f`.
pub function plan_analyzed(f: ssasem.Func, modes: i32[], semantic: ssasem.Analysis, view: SchemaView): Plan {
  if (!semantic.ok) {
    return bad(semantic.why);
  }
  let analysis: ssasem.Analysis = semantic;
  let why: string = contract_error(f, modes, view);
  if (why != "") {
    return bad(why);
  }
  let defs: ssa.SInst[] = definitions(f);
  let owned: boolean[] = owned_values(f, modes, defs);
  let reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
  let sup: SupplyTable = supply_table(f);
  let units: Units = units_of(f, owned, analysis, defs, sup);
  owned = units.owned;
  let takes: i32[] = units.takes;
  analysis = units_analysis(f, analysis, units);
  if (!analysis.ok) {
    return bad(analysis.why);
  }
  let grows: i32[] = [];
  let grow_fields: i32[] = [];
  // Per append or with result: whether its receiver is read after it, by
  // this block or on the way out, directly or through a dependent.
  let kept: boolean[] = analysis.flow.none;
  // Per parameter: whether an edge carries it into a phi while it, or a
  // value depending on it, is still live in the target.
  let entry_kept: boolean[] = analysis.flow.none;
  let vi0: i32 = 0;
  while (vi0 < f.graph.nvals) {
    grows = grows.append(0 - 1);
    grow_fields = grow_fields.append(0 - 1);
    vi0 = vi0 + 1;
  }
  let steps: Step[] = [];
  // One row for every block: each block sets the values it marks live in
  // `touched`, and clears them again once its steps are chosen.
  let live: boolean[] = analysis.flow.none;
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    if (reachable[bi]) {
      let term_uses: i32[] = [];
      if (b.term.kind_tag == 1) {
        term_uses = use_ids(b.term.value, analysis.dependencies);
      }
      if (b.term.kind_tag == 3) {
        term_uses = use_ids(b.term.cond, analysis.dependencies);
      }
      let touched: i32[] = ssalive.live_out_ids(analysis.flow, bi);
      for v in term_uses {
        touched = touched.append(v);
      }
      for v in touched {
        live = live.with(v, true);
      }
      let pos: i32 = b.insts.len() - 1;
      while (pos >= 0) {
        let ins: ssa.SInst = b.insts[pos];
        if (ins.kind_tag != 6 && ins.kind_tag != 8) {
          let dead: i32[] = [];
          if ((ins.kind_tag == ssasem.append() || ins.kind_tag == ssasem.with()) && live[ins.args[0]]) {
            kept = kept.with(ins.result, true);
          }
          if (owned[ins.result] && !live[ins.result]) {
            dead = dead.append(ins.result);
          }
          live = live.with(ins.result, false);
          for arg in ins.args {
            if (arg >= 0) {
              if (!live[arg]) {
                dead = dead.append(arg);
                live = live.with(arg, true);
                touched = touched.append(arg);
              }
              for dep in analysis.dependencies[arg] {
                if (!live[dep]) {
                  dead = dead.append(dep);
                  live = live.with(dep, true);
                  touched = touched.append(dep);
                }
              }
            }
          }
          let supplies: Supply[] = sup.at(bi, pos);
          steps = steps.append(steals(f, analysis, owned, defs, bi, pos, hands(f, analysis, owned, defs, bi, pos, choose_ids(step(b.id, pos, 0 - 1), supplies, dead, owned, lent_owners(ins, supplies, analysis.dependencies)))));
          let root: i32 = field_grow_root(f, analysis, owned, defs, bi, pos);
          if (root >= 0) {
            grows = grows.with(ins.result, root);
            grow_fields = grow_fields.with(ins.result, defs[ins.args[0]].imm);
          }
        }
        pos = pos - 1;
      }
      let entry_dead: i32[] = [];
      for ins in b.insts {
        if ((ins.kind_tag == 6 || ins.kind_tag == 8) && owned[ins.result] && !live[ins.result]) {
          entry_dead = entry_dead.append(ins.result);
        }
      }
      for v in touched {
        live = live.with(v, false);
      }
      steps = steps.append(choose_ids(step(b.id, entry_point(), 0 - 1), [], entry_dead, owned, []));
      if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
        steps = steps.append(choose_ids(step(b.id, return_point(), 0 - 1), return_supplies(f, b), term_uses, owned, []));
      }
      for target in successors(b) {
        let si: i32 = ssalive.position(analysis.flow, target);
        entry_kept = entry_kept_of(f, analysis, b, si, entry_kept);
        let dead: i32[] = ssalive.out_not_in(analysis.flow, bi, si);
        steps = steps.append(choose_ids(step(b.id, edge_point(), target), edge_supplies(f, b, si, owned), dead, owned, []));
      }
    }
    bi = bi + 1;
  }
  let literal: boolean[] = literals(f);
  why = view_retain_error(f, steps, literal, defs);
  if (why != "") {
    return bad(why);
  }
  let consts: string[] = constants(f, defs);
  return Plan { ok: true, why: "", steps: steps, owned: owned, literal: literal, grows: grows, grow_fields: grow_fields, takes: takes, held: units.held, payloads: units.payloads, likely: units.likely, kept: kept, entry_kept: entry_kept, frame_views: frame_views(f, defs), constants: consts, text_lens: text_lens(f), analysis: semantic, defs: defs, modes: modes, unit_analysis: analysis, unique_receivers: unique_receivers(f, steps, consts, no_fresh(), lent_withs(f, defs, owned, kept)), fresh_seeded: false, checked_writes: checked_writes(f), links: [], reuse: no_reuse() };
}

// without_constant_drops is `p` less its drops of static boxes, whose count is
// immortal so that dropping one releases nothing. The ledger the verifier
// replays still holds those drops; only the lowering skips them.
pub function without_constant_drops(p: Plan): Plan {
  let out: Step[] = [];
  for st in p.steps {
    let kept: i32[] = [];
    for d in st.drops {
      if (d < 0 || d >= p.constants.len() || p.constants[d] == "") {
        kept = kept.append(d);
      }
    }
    out = out.append(Step { ...st, drops: kept });
  }
  return Plan { ...p, steps: out };
}

// checked_writes marks, at a `with`'s result, a `with` whose index an element
// read earlier in the same block already checked against the same receiver.
function checked_writes(f: ssasem.Func): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    let i: i32 = 0;
    while (i < b.insts.len()) {
      let ins: ssa.SInst = b.insts[i];
      if (ins.kind_tag == ssasem.with() && read_before(b, i, ins.args[0], ins.args[1])) {
        out = out.with(ins.result, true);
      }
      i = i + 1;
    }
  }
  return out;
}

function read_before(b: ssa.SBlock, end: i32, arr: i32, index: i32): boolean {
  let j: i32 = 0;
  while (j < end) {
    let r: ssa.SInst = b.insts[j];
    if (r.kind_tag == ssasem.array_get() && r.args.len() == 2 && r.args[0] == arr && r.args[1] == index) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

// unique_receivers marks, at a `with`'s or an `append`'s result, one whose
// receiver needs no uniqueness test: the receiver is moved into it and is
// `sole`. `fresh` is the module's rows whose result is sole (`fresh_rows`).
function unique_receivers(f: ssasem.Func, steps: Step[], consts: string[], fresh: FreshRows, lent: boolean[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let sole: boolean[] = sole_boxes(f, steps, consts, fresh, 0 - 1, lent);
  let at: i32[] = ssa.block_positions(f.graph);
  for st in steps {
    if (st.point >= 0) {
      let ins: ssa.SInst = f.graph.blocks[at[st.block]].insts[st.point];
      if (box_update(ins) && sole[ins.args[0]] && moved_at(st, ins.args[0], 0)) {
        out = out.with(ins.result, true);
      }
    }
  }
  return out;
}

// FreshRows names the rows of a module whose result is a sole box: always
// where `through` is -1, and where it is a parameter's index, whenever the
// argument there arrives sole and moved, as an `append`'s receiver does.
// `through` follows `rows.names`.
pub struct FreshRows { rows: util.NameIndex, through: i32[] }

pub function no_fresh(): FreshRows {
  let none: string[] = [];
  return FreshRows { rows: util.name_index(none), through: [] };
}

// fresh_through is `name`'s entry in `fresh`, or -2 for a row it does not name.
function fresh_through(fresh: FreshRows, name: string): i32 {
  let i: i32 = fresh.rows.find(name);
  if (i < 0) {
    return 0 - 2;
  }
  return fresh.through[i];
}

// fresh_rows is the module's FreshRows. A row joins once its returns are sole
// with the rows already named as seeds, first with no assumption and then
// with one owned array parameter assumed sole, so a helper built on another
// joins a round later, and recursion, which never starts sole, adds nothing.
pub function fresh_rows(keys: string[], funcs: ssasem.Func[], plans: Plan[]): FreshRows {
  let fresh: FreshRows = no_fresh();
  let named: boolean[] = __alloc_bool(keys.len());
  let check: boolean[] = __alloc_bool(keys.len());
  let i: i32 = 0;
  while (i < keys.len()) {
    check = check.with(i, plans[i].ok && returns_arrays(funcs[i]));
    i = i + 1;
  }
  let grew: boolean = true;
  while (grew) {
    grew = false;
    let added: string[] = [];
    i = 0;
    while (i < keys.len()) {
      if (check[i] && !named[i]) {
        let through: i32 = sole_result(funcs[i], plans[i], fresh);
        if (through >= 0 - 1) {
          named = named.with(i, true);
          fresh = FreshRows { rows: fresh.rows.added(keys[i]), through: fresh.through.append(through) };
          added = added.append(keys[i]);
          grew = true;
        }
      }
      i = i + 1;
    }
    // A row can only join a later round through a call to one just named.
    let ix: util.NameIndex = util.name_index(added);
    i = 0;
    while (grew && i < keys.len()) {
      check = check.with(i, check[i] && !named[i] && calls_any(funcs[i], ix));
      i = i + 1;
    }
  }
  return fresh;
}

// sole_result is -1 when every return of `f`, which returns arrays, is sole,
// else the first owned array parameter whose arriving sole makes them so,
// else -2.
function sole_result(f: ssasem.Func, p: Plan, fresh: FreshRows): i32 {
  let lent: boolean[] = lent_withs(f, p.defs, p.owned, p.kept);
  if (returns_sole(f, sole_boxes(f, p.steps, p.constants, fresh, 0 - 1, lent))) {
    return 0 - 1;
  }
  let k: i32 = 0;
  while (k < f.graph.nparams) {
    if (is_array(f.values[k]) && p.modes[k] == counted_mode() && returns_sole(f, sole_boxes(f, p.steps, p.constants, fresh, k, lent))) {
      return k;
    }
    k = k + 1;
  }
  return 0 - 2;
}

function returns_arrays(f: ssasem.Func): boolean {
  let returns: i32 = 0;
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1) {
      if (b.term.value < 0 || !is_array(f.values[b.term.value])) {
        return false;
      }
      returns = returns + 1;
    }
  }
  return returns > 0;
}

function returns_sole(f: ssasem.Func, sole: boolean[]): boolean {
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1 && !sole[b.term.value]) {
      return false;
    }
  }
  return true;
}

// with_fresh is `p` with its receivers proved again under the module's fresh
// rows, for a row that calls one or whose receivers counted one before.
pub function with_fresh(p: Plan, f: ssasem.Func, fresh: FreshRows): Plan {
  if (!p.ok) {
    return p;
  }
  let seeded: boolean = calls_any(f, fresh.rows);
  if (!seeded && !p.fresh_seeded) {
    return p;
  }
  return Plan { ...p, unique_receivers: unique_receivers(f, p.steps, p.constants, fresh, lent_withs(f, p.defs, p.owned, p.kept)), fresh_seeded: seeded };
}

function calls_any(f: ssasem.Func, names: util.NameIndex): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call() && names.has(ins.str)) {
        return true;
      }
    }
  }
  return false;
}

// Whether two FreshRows say the same thing about `callees`, the names one
// body calls: its receivers read them only through those.
pub function fresh_rows_agree(a: FreshRows, b: FreshRows, callees: string[]): boolean {
  for callee in callees {
    if (fresh_through(a, callee) != fresh_through(b, callee)) {
      return false;
    }
  }
  return true;
}

function box_update(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssasem.with() || ins.kind_tag == ssasem.append();
}

// moved_at says the step moves `v` into the operand at `slot`: its last use.
function moved_at(st: Step, v: i32, slot: i32): boolean {
  for supply in st.supplies {
    if (supply.slot == slot && supply.value == v) {
      return supply.mode == move_unit();
    }
  }
  return false;
}

// passed_slot is the operand whose box an operation hands on as its result
// when that operand arrives sole and moved: an `append`'s receiver, or a
// fresh row's owned parameter. -1 for any other operation.
function passed_slot(ins: ssa.SInst, fresh: FreshRows): i32 {
  if (ins.kind_tag == ssasem.append()) {
    return 0;
  }
  if (ins.kind_tag == ssasem.call() && fresh.through.len() > 0) {
    let through: i32 = fresh_through(fresh, ins.str);
    if (through >= 0) {
      return through;
    }
  }
  return 0 - 1;
}

// sole_boxes marks the values whose box no unit but the frame's own one ever
// holds. A box starts that way when a `with` not in `lent` hands it back, a fresh or empty
// array is made, or a fresh row returns it; an operation that passes a box on
// (`passed_slot`) keeps it when the box arrives sole and moved, and a phi
// keeps it when every operand does. It stops at any unit retained on it, and
// at any use that could hand it to another holder while the frame still reads
// it: everything but reading an element or the length, flowing into a phi
// that keeps it, being returned, and a use that moves it, which is its last.
// `seed` is a parameter to assume sole, or -1.
//
// An empty constant is shared, but no write lands in it: a `with` on it fails
// its bounds check, and a push onto it, having no room, copies.
function sole_boxes(f: ssasem.Func, steps: Step[], consts: string[], fresh: FreshRows, seed: i32, lent: boolean[]): boolean[] {
  let sole: boolean[] = __alloc_bool(f.graph.nvals);
  if (seed >= 0) {
    sole = sole.with(seed, true);
  }
  // pass[v] is the operand slot the operation defining v hands its box on
  // from, or -1. The links are what the fixpoint below settles: a pass link
  // from operand to result, and a phi link between operand and phi.
  let pass: i32[] = util.minus_ones(f.graph.nvals);
  let links: SoleLinks = SoleLinks { from: [], to: [], phi: [] };
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result < 0) {
        continue;
      }
      let k: i32 = passed_slot(ins, fresh);
      if (k >= 0) {
        pass = pass.with(ins.result, k);
        links = SoleLinks { from: links.from.append(ins.args[k]), to: links.to.append(ins.result), phi: links.phi.append(false) };
      }
      if (ins.kind_tag == 8) {
        for a in ins.args {
          if (a >= 0) {
            links = SoleLinks { from: links.from.append(a), to: links.to.append(ins.result), phi: links.phi.append(true) };
          }
        }
      }
      if (ins.kind_tag == 8 || ins.kind_tag == ssasem.with() && !lent[ins.result] || k >= 0 || fresh_array(ins, consts, fresh)) {
        sole = sole.with(ins.result, true);
      }
    }
  }
  let at: i32[] = ssa.block_positions(f.graph);
  for st in steps {
    for supply in st.supplies {
      if (supply.value >= 0 && supply.mode != move_unit()) {
        sole = sole.with(supply.value, false);
      }
    }
    if (st.point >= 0) {
      let ins: ssa.SInst = f.graph.blocks[at[st.block]].insts[st.point];
      let i: i32 = 0;
      while (i < ins.args.len()) {
        let a: i32 = ins.args[i];
        let reads: boolean = i == 0 && (ins.kind_tag == ssasem.array_get() || ins.kind_tag == ssasem.length());
        if (a >= 0 && !reads && !moved_at(st, a, i)) {
          sole = sole.with(a, false);
        }
        i = i + 1;
      }
      if (ins.result >= 0 && pass[ins.result] >= 0 && !moved_at(st, ins.args[pass[ins.result]], pass[ins.result])) {
        sole = sole.with(ins.result, false);
      }
    }
  }
  return settled(sole, links);
}

struct SoleLinks { from: i32[], to: i32[], phi: boolean[] }

// lent_withs marks the withs that may hand back a borrowed parameter's own
// box: the receiver is carried from one and the frame reads it no further, so
// the with may defer its retain and write in place (`deferred_retain`, and
// ssarc's links), leaving the box the caller's as well as the frame's.
function lent_withs(f: ssasem.Func, defs: ssa.SInst[], owned: boolean[], kept: boolean[]): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  let seen: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag != ssasem.with() || kept[ins.result]) {
        continue;
      }
      let carried: Carried = carried_params(f, defs, ins.args[0], seen);
      seen = carried.seen;
      for param in carried.params {
        if (!(param < owned.len() && owned[param])) {
          out = out.with(ins.result, true);
        }
      }
    }
  }
  return out;
}

// settled clears, until nothing changes, a pass result whose operand is not
// sole, and both ends of a phi link that disagree.
function settled(own sole: boolean[], links: SoleLinks): boolean[] {
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < links.from.len()) {
      let a: i32 = links.from[i];
      let v: i32 = links.to[i];
      if (links.phi[i] && sole[a] != sole[v]) {
        sole = sole.with(a, false).with(v, false);
        changed = true;
      } else if (!links.phi[i] && sole[v] && !sole[a]) {
        sole = sole.with(v, false);
        changed = true;
      }
      i = i + 1;
    }
  }
  return sole;
}

// fresh_array is an array no other holder can have seen: a zero-filled or
// reserved allocation, a literal built at run time, an empty one, or a fresh
// row's result.
function fresh_array(ins: ssa.SInst, consts: string[], fresh: FreshRows): boolean {
  if (ins.kind_tag == ssasem.array_new()) {
    return ins.args.len() == 0 || consts[ins.result] == "";
  }
  if (ins.kind_tag == ssasem.call()) {
    return ins.str == "__alloc_i32" || ins.str == "__alloc_i64" || ins.str == "__alloc_bool" || ins.str == "__alloc_u8" || fresh_through(fresh, ins.str) == 0 - 1;
  }
  return ins.kind_tag == ssasem.array_reserve();
}

function entry_kept_of(f: ssasem.Func, a: ssasem.Analysis, b: ssa.SBlock, si: i32, own out: boolean[]): boolean[] {
  let succ: ssa.SBlock = f.graph.blocks[si];
  let pi: i32 = 0;
  while (succ.preds[pi] != b.id) {
    pi = pi + 1;
  }
  for ins in succ.insts {
    if (ins.kind_tag != 8) {
      continue;
    }
    let v: i32 = ins.args[pi];
    if (v >= 0 && v < f.graph.nparams && ssalive.live_in_has(a.flow, si, v)) {
      out = out.with(v, true);
    }
  }
  return out;
}

function read_error(state: boolean[], value: i32, owned: boolean[], deps: i32[][]): string {
  if (value < 0) {
    return "";
  }
  if (owned[value] && !state[value]) {
    return "read without counted unit";
  }
  for dep in deps[value] {
    if (owned[dep] && !state[dep]) {
      return "borrow outlives container unit";
    }
  }
  return "";
}

function invariant(f: ssasem.Func, bi: i32, owned: boolean[], flow: ssalive.Flow): boolean[] {
  let state: boolean[] = flow.none;
  for v in ssalive.live_in_ids(flow, bi) {
    if (owned[v]) {
      state = state.with(v, true);
    }
  }
  for ins in f.graph.blocks[bi].insts {
    if ((ins.kind_tag == 8 || ins.kind_tag == 6) && owned[ins.result]) {
      state = state.with(ins.result, true);
    }
  }
  return state;
}

// holds_invariant is same_bits(state, invariant(f, bi, owned, flow)) without
// building the invariant.
function holds_invariant(state: boolean[], f: ssasem.Func, bi: i32, owned: boolean[], flow: ssalive.Flow): boolean {
  let want: i32 = 0;
  for v in ssalive.live_in_ids(flow, bi) {
    if (owned[v]) {
      if (!state[v]) {
        return false;
      }
      want = want + 1;
    }
  }
  for ins in f.graph.blocks[bi].insts {
    if ((ins.kind_tag == 8 || ins.kind_tag == 6) && owned[ins.result] && !ssalive.live_in_has(flow, bi, ins.result)) {
      if (!state[ins.result]) {
        return false;
      }
      want = want + 1;
    }
  }
  let have: i32 = 0;
  for bit in state {
    if (bit) {
      have = have + 1;
    }
  }
  return have == want;
}

function same_bits(a: boolean[], b: boolean[]): boolean {
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// step_index lists, for each block id, the positions of the plan's steps at
// that block, so a lookup scans one block's steps rather than the whole plan.
pub function step_index(p: Plan): i32[][] {
  let top: i32 = 0 - 1;
  for s in p.steps {
    if (s.block > top) {
      top = s.block;
    }
  }
  let out: i32[][] = [];
  let i: i32 = 0;
  while (i <= top) {
    out = out.append([]);
    i = i + 1;
  }
  i = 0;
  while (i < p.steps.len()) {
    let b: i32 = p.steps[i].block;
    if (b >= 0) {
      out = out.with(b, out[b].append(i));
    }
    i = i + 1;
  }
  return out;
}

// step_at is the first step at (block, point, target), or -1.
pub function step_at(p: Plan, idx: i32[][], block: i32, point: i32, target: i32): i32 {
  if (block < 0 || block >= idx.len()) {
    return 0 - 1;
  }
  for i in idx[block] {
    if (p.steps[i].point == point && p.steps[i].target == target) {
      return i;
    }
  }
  return 0 - 1;
}

// Replay slots are bounded by the graph, not by IDs supplied in a plan.
// Each block has entry, return, instruction and two successor slots. Missing
// slots are -1; duplicate slots stay -2 even after a third matching step.
struct ReplayIndex { positions: i32[], offsets: i32[], slots: i32[] }

function replay_point(b: ssa.SBlock, point: i32, target: i32): i32 {
  if (target == 0 - 1) {
    if (point == entry_point()) {
      return 0;
    }
    if (point == return_point()) {
      return 1;
    }
    if (point >= 0 && point < b.insts.len()) {
      return point + 2;
    }
  }
  if (point == edge_point()) {
    let edge: i32 = b.insts.len() + 2;
    if (b.term.kind_tag == 2 && target == b.term.target) {
      return edge;
    }
    if (b.term.kind_tag == 3) {
      if (target == b.term.t) {
        return edge;
      }
      if (target == b.term.f) {
        return edge + 1;
      }
    }
  }
  return 0 - 1;
}

function replay_index(f: ssasem.Func, p: Plan, flow: ssalive.Flow): ReplayIndex {
  let offsets: i32[] = [];
  let slots: i32[] = [];
  for b in f.graph.blocks {
    offsets = offsets.append(slots.len());
    let n: i32 = b.insts.len() + 4;
    let i: i32 = 0;
    while (i < n) {
      slots = slots.append(0 - 1);
      i = i + 1;
    }
  }
  let i: i32 = 0;
  for s in p.steps {
    let bi: i32 = ssalive.position(flow, s.block);
    if (bi >= 0) {
      let point: i32 = replay_point(f.graph.blocks[bi], s.point, s.target);
      if (point >= 0) {
        let at: i32 = offsets[bi] + point;
        let value: i32 = 0 - 2;
        if (slots[at] == 0 - 1) {
          value = i;
        }
        slots = slots.with(at, value);
      }
    }
    i = i + 1;
  }
  // Unrecognized steps remain in p.steps: the final accounted-step count
  // rejects them, including steps at parameters, phis or unreachable blocks.
  return ReplayIndex { positions: flow.at, offsets: offsets, slots: slots };
}

function find_step(b: ssa.SBlock, idx: ReplayIndex, point: i32, target: i32): i32 {
  let at: i32 = replay_point(b, point, target);
  if (at < 0) {
    return 0 - 1;
  }
  return idx.slots[idx.offsets[idx.positions[b.id]] + at];
}

// Acquisitions observe the original state: a later move in the same step
// must not invalidate an earlier retain of the same value.
function supply_error(state: boolean[], supplies: Supply[], wanted: Supply[], owned: boolean[], deps: i32[][]): string {
  if (supplies.len() != wanted.len()) {
    return "unit supply arity";
  }
  let i: i32 = 0;
  while (i < wanted.len()) {
    let got: Supply = supplies[i];
    if (got.value != wanted[i].value || got.slot != wanted[i].slot) {
      return "unit supply identity or slot";
    }
    let why: string = read_error(state, got.value, owned, deps);
    if (why != "") {
      return why;
    }
    if (got.mode != retain_unit() && got.mode != move_unit() && got.mode != steal_unit()) {
      return "invalid unit supply mode";
    }
    i = i + 1;
  }
  return "";
}

// A step is checked on the row it reads and then applied to the row it
// owns: replay_error reports every rejection without writing, apply_step
// writes the moves, the result and the drops in place. The row flows between
// them as a plain value, never through a record field, which the owned
// parameter needs.
function replay_error(state: boolean[], s: Step, wanted: Supply[], result: i32, owned: boolean[], deps: i32[][]): string {
  let why: string = supply_error(state, s.supplies, wanted, owned, deps);
  if (why != "") {
    return why;
  }
  let cleared: i32[] = [];
  for got in s.supplies {
    if (got.mode == move_unit()) {
      if (!owned[got.value] || !state[got.value] || util.index_of_i32(cleared, got.value) >= 0) {
        return "move without counted unit";
      }
      cleared = cleared.append(got.value);
    }
  }
  let set_result: boolean = false;
  if (result >= 0 && owned[result]) {
    if (state[result] && util.index_of_i32(cleared, result) < 0) {
      return "result unit already present";
    }
    set_result = true;
  }
  let dropped: i32[] = [];
  for value in s.drops {
    if (value < 0 || value >= owned.len()) {
      return "drop value out of range";
    }
    let present: boolean = state[value] && util.index_of_i32(cleared, value) < 0 || set_result && value == result;
    if (!owned[value] || !present || util.index_of_i32(dropped, value) >= 0) {
      return "drop without counted unit";
    }
    dropped = dropped.append(value);
  }
  return "";
}

// apply_step is the row after a step replay_error accepted.
function apply_step(own state: boolean[], s: Step, result: i32, owned: boolean[]): boolean[] {
  for got in s.supplies {
    if (got.mode == move_unit()) {
      state = state.with(got.value, false);
    }
  }
  if (result >= 0 && owned[result]) {
    state = state.with(result, true);
  }
  for value in s.drops {
    state = state.with(value, false);
  }
  return state;
}

// copy_row is a fresh row with `state`'s bits. The receiver is lent, so the
// write reaches it by retaining and the runtime copies rather than mutates.
function copy_row(state: boolean[]): boolean[] {
  if (state.len() == 0) {
    return state;
  }
  return state.with(0, state[0]);
}

struct ReplayProgress { why: string, state: boolean[], count: i32 }

function progress_error(why: string): ReplayProgress {
  return ReplayProgress { why: why, state: [], count: 0 };
}

// verify_operations replays the entry step and then the block's operations
// over one row it owns, so each step writes the row in place.
function verify_operations(f: ssasem.Func, b: ssa.SBlock, p: Plan, idx: ReplayIndex, own state: boolean[], owned: boolean[], deps: i32[][]): ReplayProgress {
  let at0: i32 = find_step(b, idx, entry_point(), 0 - 1);
  if (at0 < 0) {
    return progress_error("missing or duplicate entry step");
  }
  let entry_why: string = replay_error(state, p.steps[at0], [], 0 - 1, owned, deps);
  if (entry_why != "") {
    return progress_error(entry_why);
  }
  let next: boolean[] = apply_step(state, p.steps[at0], 0 - 1, owned);
  let count: i32 = 0;
  let pos: i32 = 0;
  for ins in b.insts {
    if (ins.kind_tag != 6 && ins.kind_tag != 8) {
      for arg in ins.args {
        let why: string = read_error(next, arg, owned, deps);
        if (why != "") {
          return progress_error(why);
        }
      }
      let at: i32 = find_step(b, idx, pos, 0 - 1);
      if (at < 0) {
        return progress_error("missing or duplicate operation step");
      }
      let supplies: Supply[] = operation_supplies(f, ins);
      let lent: string = lent_error(next, p.steps[at], ins, supplies, owned, deps);
      if (lent != "") {
        return progress_error(lent);
      }
      let why: string = replay_error(next, p.steps[at], supplies, ins.result, owned, deps);
      if (why != "") {
        return progress_error(why);
      }
      next = apply_step(next, p.steps[at], ins.result, owned);
      count = count + 1;
    }
    pos = pos + 1;
  }
  return ReplayProgress { why: "", state: next, count: count };
}

// A call's lent operand borrows from units that must outlast the call's moves.
// The units the step's moves clear are listed rather than replayed into a
// copy of the row; a move the row cannot supply is move_supplies' rejection,
// reported by the replay that follows, not here.
function lent_error(state: boolean[], s: Step, ins: ssa.SInst, counted: Supply[], owned: boolean[], deps: i32[][]): string {
  if (s.supplies.len() != counted.len()) {
    return "";
  }
  let cleared: i32[] = [];
  for got in s.supplies {
    if (got.mode == move_unit()) {
      if (!owned[got.value] || !state[got.value] || util.index_of_i32(cleared, got.value) >= 0) {
        return "";
      }
      cleared = cleared.append(got.value);
    }
  }
  for v in lent_operands(ins, counted) {
    if (lent_cleared(v, state, owned, cleared)) {
      return "a lent call operand borrows from a unit moved into the call";
    }
    for dep in deps[v] {
      if (dep != v && lent_cleared(dep, state, owned, cleared)) {
        return "a lent call operand borrows from a unit moved into the call";
      }
    }
  }
  return "";
}

function lent_cleared(value: i32, state: boolean[], owned: boolean[], cleared: i32[]): boolean {
  return owned[value] && (!state[value] || has_id(cleared, value));
}

// step_clears: the step moves or drops `value`.
function step_clears(s: Step, value: i32): boolean {
  for got in s.supplies {
    if (got.mode == move_unit() && got.value == value) {
      return true;
    }
  }
  return util.index_of_i32(s.drops, value) >= 0;
}

// The return step is checked without applying it: a unit it leaves counted is
// one the row holds that it neither moves nor drops.
function verify_return(f: ssasem.Func, b: ssa.SBlock, p: Plan, idx: ReplayIndex, state: boolean[], owned: boolean[], deps: i32[][]): string {
  if (b.term.kind_tag == 1) {
    let why: string = read_error(state, b.term.value, owned, deps);
    if (why != "") {
      return why;
    }
  }
  let at: i32 = find_step(b, idx, return_point(), 0 - 1);
  if (at < 0) {
    return "missing or duplicate return step";
  }
  let why: string = replay_error(state, p.steps[at], return_supplies(f, b), 0 - 1, owned, deps);
  if (why != "") {
    return why;
  }
  let v: i32 = 0;
  while (v < state.len()) {
    if (state[v] && !step_clears(p.steps[at], v)) {
      return "counted unit leaks at return";
    }
    v = v + 1;
  }
  return "";
}

function enter_phis(b: ssa.SBlock, own state: boolean[], owned: boolean[]): Ledger {
  for ins in b.insts {
    if (ins.kind_tag == 8 && owned[ins.result]) {
      if (state[ins.result]) {
        return rejected("phi unit already present");
      }
      state = state.with(ins.result, true);
    }
  }
  return Ledger { ok: true, why: "", bits: state };
}

function verify_edge(f: ssasem.Func, b: ssa.SBlock, target: i32, p: Plan, idx: ReplayIndex, own state: boolean[], owned: boolean[], analysis: ssasem.Analysis): string {
  let at: i32 = find_step(b, idx, edge_point(), target);
  if (at < 0) {
    return "missing or duplicate edge step";
  }
  let si: i32 = ssalive.position(analysis.flow, target);
  let why: string = replay_error(state, p.steps[at], edge_supplies(f, b, si, owned), 0 - 1, owned, analysis.dependencies);
  if (why != "") {
    return why;
  }
  let left: boolean[] = apply_step(state, p.steps[at], 0 - 1, owned);
  let entered: Ledger = enter_phis(f.graph.blocks[si], left, owned);
  if (!entered.ok) {
    return entered.why;
  }
  if (!holds_invariant(entered.bits, f, si, owned, analysis.flow)) {
    return "edge unit invariant mismatch";
  }
  return "";
}

// BlockProgress is a block's verdict: its rejection, or the number of plan
// steps it accounted for.
struct BlockProgress { why: string, count: i32 }

// The row a block's operations leave is read by the return step, copied for
// the first of two successor edges and moved into the last edge.
function verify_block(f: ssasem.Func, bi: i32, p: Plan, idx: ReplayIndex, owned: boolean[], analysis: ssasem.Analysis): BlockProgress {
  let b: ssa.SBlock = f.graph.blocks[bi];
  let entry_row: boolean[] = invariant(f, bi, owned, analysis.flow);
  let operations: ReplayProgress = verify_operations(f, b, p, idx, entry_row, owned, analysis.dependencies);
  if (operations.why != "") {
    return BlockProgress { why: operations.why, count: 0 };
  }
  let state: boolean[] = operations.state;
  let count: i32 = 1 + operations.count;
  if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
    let why: string = verify_return(f, b, p, idx, state, owned, analysis.dependencies);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
    count = count + 1;
  }
  if (b.term.kind_tag == 3) {
    let why: string = read_error(state, b.term.cond, owned, analysis.dependencies);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
  }
  let targets: i32[] = successors(b);
  if (targets.len() == 2) {
    let first: boolean[] = copy_row(state);
    let why: string = verify_edge(f, b, targets[0], p, idx, first, owned, analysis);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
    count = count + 1;
  }
  if (targets.len() > 0) {
    let why: string = verify_edge(f, b, targets[targets.len() - 1], p, idx, state, owned, analysis);
    if (why != "") {
      return BlockProgress { why: why, count: 0 };
    }
    count = count + 1;
  }
  return BlockProgress { why: "", count: count };
}

function same_i32s(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function verify(f: ssasem.Func, modes: i32[], p: Plan): string {
  return verify_analyzed(f, modes, p, ssasem.analyze(f), true);
}

// verify_planned checks `p` against the analysis it was planned from, for a
// caller that lowers the very `f` it planned: analyze is a function of `f`
// alone, so a second run would only repeat the first, and so is the contract
// on the values, result, schema tables and calls, which the plan's ok is the
// answer to. The modes are this call's own input and are checked.
pub function verify_planned(f: ssasem.Func, modes: i32[], p: Plan): string {
  return verify_analyzed(f, modes, p, p.analysis, false);
}

// `whole` runs the contract check on `f` as the planner did and derives the
// definitions table from `f`, for a plan that may be checked against a
// function other than the one it was planned from.
function verify_analyzed(f: ssasem.Func, modes: i32[], p: Plan, semantic: ssasem.Analysis, whole: boolean): string {
  if (!p.ok || p.why != "") {
    return "missing successful unit plan";
  }
  let analysis: ssasem.Analysis = semantic;
  if (!analysis.ok) {
    return analysis.why;
  }
  let why: string = "";
  let defs: ssa.SInst[] = p.defs;
  if (whole) {
    why = contract_error(f, modes, no_view());
    defs = definitions(f);
  } else if (modes.len() != f.params.len()) {
    why = "parameter mode dimensions";
  } else {
    why = mode_error(f.params, modes);
  }
  if (why != "") {
    return why;
  }
  // The plan's units are a function of `f`, the modes and the analysis, so
  // for the function and modes it was planned with they are its own.
  let owned: boolean[] = p.owned;
  if (whole || !same_i32s(modes, p.modes)) {
    let units: Units = units_of(f, owned_values(f, modes, defs), analysis, defs, supply_table(f));
    owned = units.owned;
    if (!same_i32s(units.takes, p.takes)) {
      return "tuple take disagrees with the plan";
    }
    if (!same_bits(units.held, p.held)) {
      return "element hold disagrees with the plan";
    }
    if (!same_bits(units.payloads, p.payloads)) {
      return "payload take disagrees with the plan";
    }
    analysis = units_analysis(f, analysis, units);
    if (!analysis.ok) {
      return analysis.why;
    }
  } else {
    analysis = p.unit_analysis;
  }
  let reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
  let idx: ReplayIndex = replay_index(f, p, analysis.flow);
  let count: i32 = 0;
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    if (reachable[bi]) {
      let done: BlockProgress = verify_block(f, bi, p, idx, owned, analysis);
      if (done.why != "") {
        return done.why;
      }
      count = count + done.count;
    }
    bi = bi + 1;
  }
  if (count != p.steps.len()) {
    return "extra unit plan steps";
  }
  return verify_reuse(f, p, reachable);
}

// ---- Reuse: the tokens of the plan ----------------------------------------
//
// A construction may build in the box of a value dying before it, when the
// box has the slot count the construction claims: the value's drop becomes
// a TOKEN the construction spends (`reuse_pairs`, within a block;
// `carried_pairs`, from a block to a construction in a later one), and a
// record update keeps in place the fields it reads back from its donor
// (`block_keeps`). The decisions are the plan's, read by `ssarc` and checked
// by the replay (`verify_reuse`); the lowering emits a token step as it is
// written here. `links` are the appends threaded through a borrowed
// parameter whose unit is encoded at run time (`links_of`); a link is never
// a donor, since its box may be the caller's.
pub struct Reuse { pairs: ReusePairs[], keeps: Keeps[], carry: Carry, reads: VariantReads }

pub function no_reuse(): Reuse {
  return Reuse { pairs: [], keeps: [], carry: no_carry(), reads: VariantReads { at: [], dom: ssadeps.Dom { pre: [], post: [], idom: [], by_clock: [] }, sites: [], names: [], shared: [] } };
}

// reuse_layer_disabled: the #4350 §6.5 differential switch. When
// FERN_SELFHOST_NO_REUSE is on in the compiler's environment no construction
// builds in a donor's box and no map is updated in place: donors take their
// normal drops and constructions allocate. Reuse on and off are
// observationally identical (self_host_reuse_differential_test.go); off
// trades only allocation count and peak heap.
pub function reuse_layer_disabled(): boolean {
  return envflag.on("FERN_SELFHOST_NO_REUSE");
}

// `p` with its links and reuse tables. A static box, whose drop the lowering
// skips, is never a donor (`static_box`). Made once the plan is final, at the
// lowering's entry, rather than for every plan ownership inference tries and
// discards; a plan that has them keeps them, so a table a test plants is the
// one the replay reads.
pub function with_reuse(f: ssasem.Func, p: Plan): Plan {
  if (!p.ok || p.reuse.pairs.len() == f.graph.blocks.len()) {
    return p;
  }
  let idx: i32[][] = step_index(p);
  let links: i32[] = links_of(f, p, idx);
  let off: boolean = reuse_layer_disabled();
  let vr: VariantReads = variant_reads(f, p);
  let carry: Carry = carried_pairs(f, p, idx, links, off, vr);
  let uses: ssasem.Uses = p.analysis.uses;
  let pairs: ReusePairs[] = [];
  let keeps: Keeps[] = [];
  for b in f.graph.blocks {
    let pr: ReusePairs = reuse_pairs(f, p, idx, vr, b, off, carry);
    keeps = keeps.append(block_keeps(f, p, idx, b, pr, carry, links, uses));
    pairs = pairs.append(pr);
  }
  return Plan { ...p, links: links, reuse: Reuse { pairs: pairs, keeps: keeps, carry: carry, reads: vr } };
}

// A value built as static data: its count is immortal and its box is nobody's
// to build in.
function static_box(p: Plan, d: i32): boolean {
  return d >= 0 && d < p.constants.len() && p.constants[d] != "";
}

function step_of(p: Plan, idx: i32[][], block: i32, point: i32, target: i32): Step {
  let i: i32 = step_at(p, idx, block, point, target);
  if (i >= 0) {
    return p.steps[i];
  }
  return Step { block: 0 - 1, point: point, target: 0 - 1, supplies: [], drops: [], hand_roots: [], hand_fields: [] };
}

function record_fields(t: typeinfo.Type, f: ssasem.Func): semrecords.Field[] {
  return f.records.list[semrecords.find(f.records, t)].fields;
}

function tuple_elements(t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements;
  }
  return [];
}

// A payload read the plan takes out of its box at the read, emptying the
// slot: not one through a shell, whose box is released whole.
pub function payload_taken(f: ssasem.Func, p: Plan, ins: ssa.SInst): boolean {
  return ins.result < p.payloads.len() && p.payloads[ins.result] && shell_root(f, p, ins) < 0;
}

// An in-place update whose receiver this frame does not own: its unit arrives
// as a RETAIN because the frame has to hold one while the operation runs, and
// emitting that retain BEFORE `__fern_rc_is_unique` makes the test answer for
// its own supply rather than for the box. It then says "shared" about a box
// nobody else holds, every push takes the un-share copy, and a loop appending
// through a borrowed parameter copies the whole buffer per element — 23 s and
// 8.9 GB for 40,000 pushes where the AST lowering takes 2 ms (#9365).
//
// A receiver the frame DOES own keeps its retain up front: there it is the
// same-frame bracket, held because the binding outlives the update and the
// copy is what keeps the old value whole.
//
// The cross-frame bracket is `bracketed`, and it is what makes deferring safe
// — so the deferral reaches exactly as far as that bracket does: a PARAMETER
// this frame borrows, which its caller either bracketed or is done reading,
// and a record FIELD the plan admitted (field_grow_root), where the
// bracket is on the field and the record's own count answers for any holder
// no caller names. The frame itself must be done reading the parameter too
// (`kept`): growing its box in place would change the value it reads next.
// Declining is enough because a borrowed parameter's unit is never moved:
// its retain stands through the push, which the rc test then reads as shared.
// An array reached any other way the frame does not own —
// an element of a borrowed array of arrays, say — has no bracket standing
// behind it, and growing it in place would rewrite what the container still
// holds. A with defers on the same terms, writing in place only when its
// count test finds the box sole and copying otherwise.
//
// A map mutation never defers. Its receiver's retain is what makes a map
// the frame still reads count as shared, and core/map's copy-on-write then
// copies: `let n = m.insert(k, v)` leaves `m` as it was, which is the value
// the checker's E055 promises for every collection operation.
//
// A string append defers every retain of its left operand: a string the
// frame still reads cannot grow in place, so it is lent to a plain
// concatenation, which takes nothing (`grow_or_concat`).
pub function deferred_retain(f: ssasem.Func, p: Plan, step: Step, ins: ssa.SInst): boolean {
  if (string_append(f, ins)) {
    return receiver_retained(step);
  }
  if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) {
    return false;
  }
  if (p.grows[ins.result] < 0 && ins.args[0] >= f.graph.nparams) {
    return false;
  }
  if (ins.args[0] < p.owned.len() && p.owned[ins.args[0]]) {
    return false;
  }
  if (p.grows[ins.result] < 0 && p.kept[ins.result]) {
    return false;
  }
  return receiver_retained(step);
}

pub function receiver_retained(step: Step): boolean {
  for supply in step.supplies {
    if (supply.slot == 0 && supply.mode == retain_unit()) {
      return true;
    }
  }
  return false;
}

// Where a block's constructions can build in a box already dying in it.
//
// Perceus places a drop at a value's last use, so the record a `with`-style
// update supersedes dies BEFORE the record replacing it is built. Reuse is the
// pairing of that drop with that later construction: instead of returning the
// box to the allocator and taking another of the same shape, the drop keeps it
// as a token and the construction builds in it. This is Koka's ParcReuse
// applied to the plan's dying set rather than to syntax.
//
// `tokens[i]` is the value whose drop at instruction i becomes a token, and
// `builds[i]` the token an instruction i construction builds in; -1 for
// neither. A token waits in its donor's own local, from the drop to the
// construction, which moves it into the frame's token slot just before it
// builds, so any number of tokens may be held at once.
//
// The donor and the recipient need not share a TYPE, and the pairing does not
// ask: a box is storage, and what separates two of them is the number of
// SLOTS. `reuse_slots` is that number, matched against what the construction
// claims. Measured over the compiler's own sources, pairing on shape alone —
// any dying record, union or tuple to any construction — admits 839 sites of
// which only 229 have counts the runtime can honour; pairing on the count
// admits 390, all of them spendable, once the donor is held for whichever
// construction claims it (`block_claims`, below) rather than taken first-come.
// `selfs[i]` is a value dying AT instruction i whose box that same
// instruction's construction builds in — the update chain's shape, where the
// box a `T { ...a, f: v }` supersedes dies as the update consumes it rather
// than at some earlier instruction. Its token is taken before the construction
// instead of after, which is the only thing that separates it from the pairing
// above; it is the same donor, the same runtime test and the same box.
//
// Measured over the compiler's own sources, 795 constructions have a
// matching-slot value dying at their own instruction, against 390 pairings
// from earlier drops. Most of them are the two native assemblers, which are
// nothing but update chains.
pub struct ReusePairs { tokens: i32[], builds: i32[], selfs: i32[] }

// The slots a value's box has, or -1 where this frame cannot say. This is the
// number `__fern_alloc_reuse` compares, and comparing it HERE is what makes a
// pairing worth emitting: the runtime's own test is sound either way, but the
// arm it takes when the counts disagree returns the donor block to its
// freelist and allocates anyway, so the pairing has bought a uniqueness test
// and a branch and changed nothing, at 25 lines of emitted text apiece.
// Measured over the compiler's own sources, 610 of 839 pairings admitted on
// shape alone were of that kind.
//
// A record's box is its shape word and one word per field, a tuple's one word
// per element and no shape word. An environment is excluded: its fields are
// addressed as array slots rather than struct ones, and its box is the
// closure's. So is an array: its cap is a CAPACITY rather than its length, so
// the slots the block has are not the slots its type names.
function reuse_slots(t: typeinfo.Type, f: ssasem.Func): i32 {
  if (semtypes.is_env(t) || semtypes.is_cell(t)) {
    return 0 - 1;
  }
  // A box handed on is not freed, and a finalizer is owed at the free.
  if (ssasem.has_finalizer(f, t)) {
    return 0 - 1;
  }
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements.len();
  }
  if let typeinfo.TypeStruct(_) = t {
    if (semrecords.find(f.records, t) < 0) {
      return 0 - 1;
    }
    return record_fields(t, f).len() + 1;
  }
  if let typeinfo.TypeUnion(_) = t {
    return union_slots(t, f);
  }
  return 0 - 1;
}

// A declared enum's box is the LIVE variant's, so its count is this frame's to
// know only where every variant agrees — native's own enum reuse asks the same
// question (`enum_all_variants_same_field_count`).
//
// A BUILTIN union's box has no count this boundary can state, and that is a
// target fact rather than a conservatism. One lowering feeds all three
// backends: the register ones build every Option/Result as `__fern_arr_box(2)`,
// while wasm sizes the box by the payload AT THE SITE — eight bytes for a
// narrow one and sixteen for an i64 or an f64 — so a `Result[i64, string]`
// box is two slots built as Ok and one built as Err. There is no single answer
// to give, and a wrong one is the pairing that emits its machinery and then
// declines.
function union_slots(t: typeinfo.Type, f: ssasem.Func): i32 {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return 0 - 1;
  }
  if (f.enums[at].layout == semrecords.layout_option()) {
    return 0 - 1;
  }
  let n: i32 = 0 - 1;
  for v in f.enums[at].variants {
    if (n < 0) {
      n = v.fields.len();
    } else if (n != v.fields.len()) {
      return 0 - 1;
    }
  }
  if (n < 0) {
    return 0 - 1;
  }
  return n + 1;
}

// The slots one variant of a declared enum, or one member of a struct-union,
// builds: its shape word and one per field, as `struct_make` allocates them.
// -1 for the builtin Option layout.
function variant_slots(t: typeinfo.Type, name: string, f: ssasem.Func): i32 {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0 || f.enums[at].layout == semrecords.layout_option()) {
    return 0 - 1;
  }
  let v: i32 = semrecords.find_variant(f.enums[at], name);
  if (v < 0) {
    return 0 - 1;
  }
  return f.enums[at].variants[v].fields.len() + 1;
}

// The slots a dying value's box has in block `b`. A declared enum whose
// variants disagree has no count of its own, but a payload read executes only
// where the tag test chose its variant, so a block a read dominates holds a
// box of that variant's count. That is the consuming match's shape: the arm
// takes the payloads, the scrutinee dies, and the arm's construction builds
// in its box. A nested pattern reads the payloads before its inner test and
// builds below it.
function donor_slots(f: ssasem.Func, vr: VariantReads, b: ssa.SBlock, d: i32): i32 {
  let t: typeinfo.Type = f.values[d];
  let n: i32 = reuse_slots(t, f);
  if (n >= 0 || ssasem.has_finalizer(f, t)) {
    return n;
  }
  let name: string = known_variant(vr, b, d);
  if (name == "") {
    return 0 - 1;
  }
  return variant_slots(t, name, f);
}

// The variant `d`'s box holds in block `b`, which a payload read of it in `b`
// or in a block dominating `b` names, or "".
pub function known_variant(vr: VariantReads, b: ssa.SBlock, d: i32): string {
  if (d < 0 || d >= vr.sites.len() || b.id < 0 || b.id >= vr.at.len() || vr.at[b.id] < 0) {
    return "";
  }
  if (d < vr.shared.len() && vr.shared[d]) {
    return "";
  }
  let bp: i32 = vr.at[b.id];
  let k: i32 = 0;
  while (k < vr.sites[d].len()) {
    if (vr.sites[d][k] == bp || ssadeps.dom_holds(vr.dom, bp, vr.sites[d][k])) {
      return vr.names[d][k];
    }
    k = k + 1;
  }
  return "";
}

// Where each value's payloads are read: the blocks' positions by id, the
// dominator tree, and per value the positions of the blocks reading one of
// its payloads and the variant each read names. `shared` marks a struct-union
// value whose box is shared where it is read (`likely_unique`): its variant is
// not reported, so nothing speculates on its box.
pub struct VariantReads { at: i32[], dom: ssadeps.Dom, sites: i32[][], names: string[][], shared: boolean[] }

function variant_reads(f: ssasem.Func, p: Plan): VariantReads {
  let sites: i32[][] = [];
  let names: string[][] = [];
  let shared: boolean[] = __alloc_bool(f.values.len());
  while (sites.len() < f.values.len()) {
    sites = sites.append([]);
    names = names.append([]);
  }
  let bi: i32 = 0;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.variant_get() && ins.args.len() == 1 && ins.args[0] >= 0 && ins.args[0] < sites.len()) {
        let v: i32 = ins.args[0];
        if (sites[v].len() == 0 && !(v < p.likely.len() && p.likely[v]) && !(v < p.payloads.len() && p.payloads[v]) && member_union(f, f.values[v])) {
          shared = shared.with(v, true);
        }
        sites = sites.with(v, sites[v].append(bi));
        names = names.with(v, names[v].append(ins.str));
      }
    }
    bi = bi + 1;
  }
  return VariantReads { at: ssa.block_positions(f.graph), dom: ssadeps.dominates(f.graph), sites: sites, names: names, shared: shared };
}

// The slots a construction claims, or -1 where it is not one a token can be
// spent at. An array construction is excluded for the reason a dying array is:
// what it asks the allocator for is a capacity.
function recipient_slots(f: ssasem.Func, p: Plan, ins: ssa.SInst): i32 {
  if (p.constants[ins.result] != "") {
    return 0 - 1;
  }
  if (ins.kind_tag == ssasem.tuple_new()) {
    return tuple_elements(f.values[ins.result]).len();
  }
  if (ins.kind_tag == ssasem.record_new()) {
    return reuse_slots(f.values[ins.result], f);
  }
  if (ins.kind_tag == ssasem.variant_new()) {
    let n: i32 = union_slots(f.values[ins.result], f);
    if (n < 0) {
      n = variant_slots(f.values[ins.result], ins.str, f);
    }
    return n;
  }
  return 0 - 1;
}

// The last position in the block at which a construction claims each slot
// count. A donor is worth holding while some construction still ahead of it
// claims the count its box has, which this answers in one lookup where a scan
// forward would cost a pass per candidate.
//
// Holding it for the NEXT construction alone is the version that looks right
// and is not: a donor the next one cannot take is dropped, and the one two
// instructions further down that could have taken it allocates. Measured over
// the compiler's own sources, that reading pairs 287 where this one pairs 390.
struct Claims { counts: i32[], last: i32[] }

function block_claims(f: ssasem.Func, p: Plan, b: ssa.SBlock): Claims {
  let counts: i32[] = [];
  let last: i32[] = [];
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let c: i32 = recipient_slots(f, p, b.insts[pos]);
    if (c >= 0) {
      let at: i32 = util.index_of_i32(counts, c);
      if (at < 0) {
        counts = counts.append(c);
        last = last.append(pos);
      } else {
        last = last.with(at, pos);
      }
    }
    pos = pos + 1;
  }
  return Claims { counts: counts, last: last };
}

function claimed_after(c: Claims, slots: i32, pos: i32): boolean {
  let at: i32 = util.index_of_i32(c.counts, slots);
  return at >= 0 && c.last[at] > pos;
}

// Donors handed to constructions in later blocks. A value dying in a block
// after the block's last construction may be held there instead of dropped,
// and become the token of the first construction claiming its slot count in a
// later block, as a value dying at a construction does. A carry is a donor
// value, the blocks holding it (`from`, at `drop_at`), the constructions it is
// handed to (`to`, at `build_at`), and the edges where it goes back instead
// (`exit_from` to `exit_to`, freeing `dropped`).
//
// The blocks between the holding blocks and a construction, its way, claim
// that count nowhere and are entered only from a holding block or a way, so
// a path entering a way carries the token a holding block took. A path
// leaves the ways at a construction, which spends the token, or at an edge to
// any other block, which frees it, and can enter them again only through a
// holding block. So one donor serves a construction in each arm of a branch,
// and a donor dying in each arm of a match serves one construction past
// their join.
//
// A holding block takes the donor's token where the donor dies
// (`hold_token`): the box with its children released when it is unique
// there, else null once the donor's unit is released. The token stays in the
// donor's own local until `build_at` moves it to the token slot or an exit
// edge frees it, so a pairing on the way, whose token is written and spent
// within its block, is unaffected. Taking the token at the death rather than
// at the construction is what keeps a shared donor from being held across
// the blocks between: its other holder's box would stay shared through them.
//
// A predecessor of the construction's block in which the donor dies as a box
// of another count is a null edge (`null_from` to `null_to`, for `nulled`):
// that block drops the donor where it dies and the edge zeroes its local, so
// the construction reads a null token on that path and the holding blocks'
// token on the others. So a donor dying in match arms of different counts
// still serves a construction past their join on the paths whose box fits.
pub struct Carry { from: i32[], drop_at: i32[], held: i32[], to: i32[], build_at: i32[], donor: i32[], exit_from: i32[], exit_to: i32[], dropped: i32[], null_from: i32[], null_to: i32[], nulled: i32[] }

function no_carry(): Carry {
  return Carry { from: [], drop_at: [], held: [], to: [], build_at: [], donor: [], exit_from: [], exit_to: [], dropped: [], null_from: [], null_to: [], nulled: [] };
}

// The first construction in `b` claiming `slots`, or -1.
function first_claim_of(f: ssasem.Func, p: Plan, b: ssa.SBlock, slots: i32): i32 {
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let ins: ssa.SInst = b.insts[pos];
    if (ins.kind_tag != 6 && ins.kind_tag != 8 && recipient_slots(f, p, ins) == slots) {
      return pos;
    }
    pos = pos + 1;
  }
  return 0 - 1;
}

function last_claim(f: ssasem.Func, p: Plan, b: ssa.SBlock): i32 {
  let pos: i32 = b.insts.len() - 1;
  while (pos >= 0) {
    let ins: ssa.SInst = b.insts[pos];
    if (ins.kind_tag != 6 && ins.kind_tag != 8 && recipient_slots(f, p, ins) >= 0) {
      return pos;
    }
    pos = pos - 1;
  }
  return 0 - 1;
}

// The constructions a box can be carried to from a set of holding blocks, by
// block id, the way to each, and the null edges into each: the predecessors
// of the construction's block in which the donor dies as a box of another
// count, so arrive with it dropped.
struct Routes { targets: i32[], ways: i32[][], nulls: i32[][] }

// The per-function facts every route search reads: each block's position by
// id, the slot counts its constructions claim, and the values dying in it
// after its last construction.
struct RouteGraph { at: i32[], claims: i32[][], dies: i32[][], reads: VariantReads }

function route_graph(f: ssasem.Func, p: Plan, dying: Dying[], vr: VariantReads): RouteGraph {
  let claims: i32[][] = [];
  let dies: i32[][] = [];
  let k: i32 = 0;
  while (k < f.graph.blocks.len()) {
    claims = claims.append(block_claims(f, p, f.graph.blocks[k]).counts);
    dies = dies.append(dying[k].values);
    k = k + 1;
  }
  return RouteGraph { at: vr.at, claims: claims, dies: dies, reads: vr };
}

// Whether the block at position `k` builds something claiming `slots`.
function claims_slots(g: RouteGraph, k: i32, slots: i32): boolean {
  return util.index_of_i32(g.claims[k], slots) >= 0;
}

// What the route searches of one function mark, by block position: `seen` the
// blocks ahead of a search's start, `way` the blocks between it and a target.
// A mark holds the stamp of the search that made it, and each search takes a
// fresh stamp, so none is cleared between searches.
struct RouteMarks { seen: i32[], way: i32[], stamp: i32 }

struct Searched { routes: Routes, marks: RouteMarks }

struct Way { ok: boolean, blocks: i32[], nulls: i32[], marks: RouteMarks }

function route_marks(n: i32): RouteMarks {
  let seen: i32[] = [];
  let way: i32[] = [];
  while (seen.len() < n) {
    seen = seen.append(0);
    way = way.append(0);
  }
  return RouteMarks { seen: seen, way: way, stamp: 0 };
}

// Where a box of `slots` held in `sources` can be carried: each block claiming
// that count first on some path out of the sources whose way is entered from
// nowhere else.
function carry_routes(f: ssasem.Func, g: RouteGraph, sources: i32[], own m: RouteMarks, slots: i32, d: i32): Searched {
  let ahead: i32 = m.stamp + 1;
  let seen: i32[] = m.seen;
  let way: i32[] = m.way;
  let builds: i32[] = [];
  let work: i32[] = [];
  for id in sources {
    for s in successors(f.graph.blocks[g.at[id]]) {
      work = work.append(s);
    }
  }
  let next: i32 = 0;
  while (next < work.len()) {
    let id: i32 = work[next];
    next = next + 1;
    let k: i32 = g.at[id];
    if (util.index_of_i32(sources, id) >= 0 || seen[k] == ahead) {
      continue;
    }
    seen = seen.with(k, ahead);
    if (claims_slots(g, k, slots)) {
      builds = builds.append(id);
    } else {
      for s in successors(f.graph.blocks[k]) {
        work = work.append(s);
      }
    }
  }
  m = RouteMarks { seen: seen, way: way, stamp: ahead };
  let found: Routes = Routes { targets: [], ways: [], nulls: [] };
  for target in builds {
    let w: Way = way_to(f, g, sources, m, ahead, target, slots, d);
    m = w.marks;
    if (w.ok) {
      found = Routes { targets: found.targets.append(target), ways: found.ways.append(w.blocks), nulls: found.nulls.append(w.nulls) };
    }
  }
  return Searched { routes: found, marks: m };
}

// The way to `target`, `ahead` being the stamp of the `seen` marks of the
// search from `sources`. The walk takes the predecessors of the target and of
// each block on the way, marked `way` at a fresh stamp. Each must be a source,
// on the way, or a block ahead claiming nothing of the count, which joins the
// way; any other enters the way from elsewhere. A predecessor of the target
// itself may instead be a null edge: a block where the donor dies as a box
// of another count, which drops it and arrives with its local null.
function way_to(f: ssasem.Func, g: RouteGraph, sources: i32[], own m: RouteMarks, ahead: i32, target: i32, slots: i32, d: i32): Way {
  let stamp: i32 = m.stamp + 1;
  let seen: i32[] = m.seen;
  let way: i32[] = m.way;
  let between: i32[] = [];
  let entry: Preds = split_preds(f, g, sources, target, slots, d);
  let work: i32[] = entry.carrying;
  let next: i32 = 0;
  while (next < work.len()) {
    let id: i32 = work[next];
    next = next + 1;
    let k: i32 = g.at[id];
    if (util.index_of_i32(sources, id) >= 0 || way[k] == stamp) {
      continue;
    }
    if (seen[k] != ahead || claims_slots(g, k, slots)) {
      return Way { ok: false, blocks: [], nulls: [], marks: RouteMarks { seen: seen, way: way, stamp: stamp } };
    }
    between = between.append(id);
    way = way.with(k, stamp);
    for pr in f.graph.blocks[k].preds {
      work = work.append(pr);
    }
  }
  return Way { ok: true, blocks: between, nulls: entry.nulls, marks: RouteMarks { seen: seen, way: way, stamp: stamp } };
}

// The target's predecessors, split into the null edges and the rest.
struct Preds { carrying: i32[], nulls: i32[] }

function split_preds(f: ssasem.Func, g: RouteGraph, sources: i32[], target: i32, slots: i32, d: i32): Preds {
  let out: Preds = Preds { carrying: [], nulls: [] };
  for pr in f.graph.blocks[g.at[target]].preds {
    if (null_edge(f, g, sources, pr, slots, d)) {
      out = Preds { ...out, nulls: out.nulls.append(pr) };
    } else {
      out = Preds { ...out, carrying: out.carrying.append(pr) };
    }
  }
  return out;
}

// Whether block `id` drops donor `d` as a box of a count other than `slots`
// after its last construction: not a holding block, and one whose edge into
// the construction's block brings no box.
function null_edge(f: ssasem.Func, g: RouteGraph, sources: i32[], id: i32, slots: i32, d: i32): boolean {
  let k: i32 = g.at[id];
  return util.index_of_i32(sources, id) < 0 && util.index_of_i32(g.dies[k], d) >= 0
    && donor_slots(f, g.reads, f.graph.blocks[k], d) != slots;
}

// The values that die after position `claim` of `b`, and where each dies, in
// order, leaving out the value the instruction there defines and one a link
// keeps: the donors a later block's construction could take.
struct Dying { at: i32[], values: i32[] }

function dying_after_claims(p: Plan, idx: i32[][], links: i32[], b: ssa.SBlock, claim: i32): Dying {
  let out: Dying = Dying { at: [], values: [] };
  let pos: i32 = claim + 1;
  while (pos < b.insts.len()) {
    if (b.insts[pos].kind_tag != 6 && b.insts[pos].kind_tag != 8) {
      for d in step_of(p, idx, b.id, pos, 0 - 1).drops {
        if (d != b.insts[pos].result && (d >= links.len() || links[d] < 0) && !static_box(p, d)) {
          out = Dying { at: out.at.append(pos), values: out.values.append(d) };
        }
      }
    }
    pos = pos + 1;
  }
  return out;
}

// The holding blocks of one carry: block `first` and every later block not yet
// holding a donor in which `d` dies after the last construction, as a box of
// the same count. A block that returns holds nothing: it has no edge to drop
// the box on.
struct Holds { blocks: i32[], at: i32[], slots: i32 }

function holds_of(f: ssasem.Func, vr: VariantReads, dying: Dying[], holding: boolean[], first: i32, d: i32, at0: i32, slots: i32): Holds {
  let h: Holds = Holds { blocks: [f.graph.blocks[first].id], at: [at0], slots: slots };
  let bj: i32 = first + 1;
  while (bj < dying.len()) {
    let j: i32 = util.index_of_i32(dying[bj].values, d);
    if (!holding[bj] && j >= 0 && can_hold(f.graph.blocks[bj]) && donor_slots(f, vr, f.graph.blocks[bj], d) == slots) {
      h = Holds { ...h, blocks: h.blocks.append(f.graph.blocks[bj].id), at: h.at.append(dying[bj].at[j]) };
    }
    bj = bj + 1;
  }
  return h;
}

function can_hold(b: ssa.SBlock): boolean {
  return successors(b).len() > 0;
}

function carried_pairs(f: ssasem.Func, p: Plan, idx: i32[][], links: i32[], off: boolean, vr: VariantReads): Carry {
  let c: Carry = no_carry();
  if (off) {
    return c;
  }
  let dying: Dying[] = [];
  let holding: boolean[] = [];
  for b in f.graph.blocks {
    dying = dying.append(dying_after_claims(p, idx, links, b, last_claim(f, p, b)));
    holding = holding.append(false);
  }
  let g: RouteGraph = route_graph(f, p, dying, vr);
  let marks: RouteMarks = route_marks(f.graph.blocks.len());
  let bi: i32 = 0;
  while (bi < dying.len()) {
    // One donor leaves a block. The first dying value whose count some
    // construction ahead claims goes; a count held in this block alone and
    // without a route is tried once.
    let b: ssa.SBlock = f.graph.blocks[bi];
    let tried: i32[] = [];
    let i: i32 = 0;
    while (!holding[bi] && can_hold(b) && i < dying[bi].values.len()) {
      let d: i32 = dying[bi].values[i];
      let slots: i32 = donor_slots(f, g.reads, b, d);
      if (slots >= 0) {
        let h: Holds = holds_of(f, g.reads, dying, holding, bi, d, dying[bi].at[i], slots);
        if (h.blocks.len() > 1 || util.index_of_i32(tried, slots) < 0) {
          tried = tried.append(slots);
          let found: Searched = carry_routes(f, g, h.blocks, marks, slots, d);
          marks = found.marks;
          let before: i32 = c.to.len();
          c = served_by(f, p, g, c, h, found.routes, d);
          if (c.to.len() > before) {
            for id in h.blocks {
              holding = holding.with(g.at[id], true);
            }
          }
        }
      }
      i = i + 1;
    }
    bi = bi + 1;
  }
  return c;
}

// `c` with donor `d` held in `h` and handed to each construction of `r` that
// does not read it and that no earlier carry serves; the rest are left, and
// any edge into one drops the donor. Nothing is added when no construction is.
function served_by(f: ssasem.Func, p: Plan, g: RouteGraph, own c: Carry, h: Holds, r: Routes, d: i32): Carry {
  let targets: i32[] = [];
  let builds: i32[] = [];
  let inside: i32[] = [];
  let k: i32 = 0;
  while (k < r.targets.len()) {
    let to: ssa.SBlock = f.graph.blocks[g.at[r.targets[k]]];
    let at_build: i32 = first_claim_of(f, p, to, h.slots);
    if (util.index_of_i32(c.to, to.id) < 0 && util.index_of_i32(to.insts[at_build].args, d) < 0) {
      targets = targets.append(to.id);
      builds = builds.append(at_build);
      c = with_null_edges(c, r.nulls[k], to.id, d);
      for id in r.ways[k] {
        inside = inside.append(id);
      }
    }
    k = k + 1;
  }
  if (targets.len() == 0) {
    return c;
  }
  k = 0;
  while (k < targets.len()) {
    c = Carry { ...c, to: c.to.append(targets[k]), build_at: c.build_at.append(builds[k]), donor: c.donor.append(d) };
    k = k + 1;
  }
  k = 0;
  while (k < h.blocks.len()) {
    c = Carry { ...c, from: c.from.append(h.blocks[k]), drop_at: c.drop_at.append(h.at[k]), held: c.held.append(d) };
    k = k + 1;
  }
  let leaving: i32[] = h.blocks;
  for id in inside {
    if (util.index_of_i32(leaving, id) < 0) {
      leaving = leaving.append(id);
    }
  }
  for id in leaving {
    for s in successors(f.graph.blocks[g.at[id]]) {
      if (util.index_of_i32(targets, s) < 0 && util.index_of_i32(inside, s) < 0) {
        c = Carry { ...c, exit_from: c.exit_from.append(id), exit_to: c.exit_to.append(s), dropped: c.dropped.append(d) };
      }
    }
  }
  return c;
}

function with_null_edges(own c: Carry, from: i32[], to: i32, d: i32): Carry {
  for id in from {
    c = Carry { ...c, null_from: c.null_from.append(id), null_to: c.null_to.append(to), nulled: c.nulled.append(d) };
  }
  return c;
}

// The donors arriving null over the edge from `from` to `to`: dropped in
// `from` as boxes of another count, their locals are zeroed on the edge so
// the construction's token test reads null rather than a freed box.
pub function carry_nulls(c: Carry, from: i32, to: i32): i32[] {
  let out: i32[] = [];
  let e: i32 = 0;
  while (e < c.null_from.len()) {
    if (c.null_from[e] == from && c.null_to[e] == to) {
      out = out.append(c.nulled[e]);
    }
    e = e + 1;
  }
  return out;
}

// The donors whose ways the edge from `from` to `to` leaves, their tokens
// freed there.
pub function carry_exits(c: Carry, from: i32, to: i32): i32[] {
  let out: i32[] = [];
  let e: i32 = 0;
  while (e < c.exit_from.len()) {
    if (c.exit_from[e] == from && c.exit_to[e] == to) {
      out = out.append(c.dropped[e]);
    }
    e = e + 1;
  }
  return out;
}

// Whether the construction at position `pos` of block `b` is one a carry
// hands its donor to.
pub function carry_held_for(c: Carry, b: i32, pos: i32): boolean {
  let into: i32 = util.index_of_i32(c.to, b);
  return into >= 0 && c.build_at[into] == pos;
}

// The donor held rather than dropped at position `pos` of block `b`, or -1.
pub function carry_held(c: Carry, b: i32, pos: i32): i32 {
  let i: i32 = 0;
  while (i < c.from.len()) {
    if (c.from[i] == b && c.drop_at[i] == pos) {
      return c.held[i];
    }
    i = i + 1;
  }
  return 0 - 1;
}

function reuse_pairs(f: ssasem.Func, p: Plan, idx: i32[][], vr: VariantReads, b: ssa.SBlock, off: boolean, carry: Carry): ReusePairs {
  let into: i32 = util.index_of_i32(carry.to, b.id);
  let tokens: i32[] = [];
  let builds: i32[] = [];
  let selfs: i32[] = [];
  let claims_tab: Claims = block_claims(f, p, b);
  // The donors held for a construction further down, each in its own local,
  // and where each died.
  let pending: i32[] = [];
  let pending_at: i32[] = [];
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    tokens = tokens.append(0 - 1);
    builds = builds.append(0 - 1);
    selfs = selfs.append(0 - 1);
    let ins: ssa.SInst = b.insts[pos];
    if (into >= 0 && carry.build_at[into] == pos) {
      selfs = selfs.with(pos, carry.donor[into]);
    } else if (ins.kind_tag != 6 && ins.kind_tag != 8) {
      let step: Step = step_of(p, idx, b.id, pos, 0 - 1);
      let claims: i32 = recipient_slots(f, p, ins);
      if (off) {
        pending = [];
        pending_at = [];
      } else {
        let k: i32 = 0 - 1;
        if (claims >= 0) {
          k = held_for(f, vr, b, pending, ins, claims);
        }
        if (k >= 0) {
          builds = builds.with(pos, pending[k]);
          tokens = tokens.with(pending_at[k], pending[k]);
          pending = without_at(pending, k);
          pending_at = without_at(pending_at, k);
        } else if (claims >= 0) {
          // Nothing earlier serves this construction, so the box it
          // supersedes may: a value dying HERE, of the count this
          // construction claims, that the construction does not read.
          // Not reading it is what makes it safe to hand on — the
          // projections that carried its fields over are earlier
          // instructions, and the plan has already proved it dead.
          //
          // `d != ins.result` excludes the degenerate donor: a
          // construction whose value is never read has its drop at its
          // own step, so the value dying here IS the result. Pairing it
          // with itself reads a token slot for a value that does not
          // exist yet, which always declines — and it costs the
          // module its last allocating op, so the heap runtime block
          // stopped being emitted and the link broke on an undefined
          // `__fn___fern_arr_dec`.
          for d in step.drops {
            if (selfs[pos] < 0 && d != ins.result && !static_box(p, d)
              && donor_slots(f, vr, b, d) == claims
              && util.index_of_i32(ins.args, d) < 0) {
              selfs = selfs.with(pos, d);
            }
          }
        }
        // A value dying here that this construction does not spend is
        // held for one further down claiming its count. One donor is
        // taken per position: `tokens` names one value there.
        let taken: boolean = false;
        for d in step.drops {
          let sl: i32 = donor_slots(f, vr, b, d);
          if (!taken && d != selfs[pos] && d != ins.result && sl >= 0 && !static_box(p, d)
            && claimed_after(claims_tab, sl, pos) && util.index_of_i32(pending, d) < 0) {
            pending = pending.append(d);
            pending_at = pending_at.append(pos);
            taken = true;
          }
        }
      }
    }
    pos = pos + 1;
  }
  return ReusePairs { tokens: tokens, builds: builds, selfs: selfs };
}

// The first held donor of `claims` slots that construction `ins` does not
// read, or -1.
function held_for(f: ssasem.Func, vr: VariantReads, b: ssa.SBlock, pending: i32[], ins: ssa.SInst, claims: i32): i32 {
  let k: i32 = 0;
  while (k < pending.len()) {
    if (donor_slots(f, vr, b, pending[k]) == claims && util.index_of_i32(ins.args, pending[k]) < 0) {
      return k;
    }
    k = k + 1;
  }
  return 0 - 1;
}

function without_at(xs: i32[], k: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i != k) {
      out = out.append(xs[i]);
    }
    i = i + 1;
  }
  return out;
}

// A construction that rebuilds its own donor keeps in place every field it
// reads from the donor's slot of the same index and takes a unit of, whether
// by a take at the read (took_payload) or a retain at the construction: when
// the donor is unique the field is already where the construction stores it,
// so the unit the donor holds is the construction's, and neither the take's
// null nor the retain nor the donor's release of that field is emitted. The
// donor's uniqueness is read ONCE, at the first such read, into the token slot,
// and the reads, the retains, the donor's release and the construction all
// follow that one answer: a donor read as shared there has its kept fields
// retained and is released whole, whatever its count says by the time it dies.
// A scalar field read from the same slot is kept too: it holds no unit, so
// only its store is skipped, and the uniqueness read waits for the donor's drop.
//
// The token slot is held from that first read to the construction, so a donor
// is kept only where no other pairing's token is live in between. `start` is
// the position of the first counted kept read or other take, else the
// donor's drop, and `taken` the donor's drop.
//
// A kept field the construction alone reads is not read at all while the
// donor is unique: its slot is already the construction's. `late` holds those
// values; the construction copies them from the donor, a counted one retained,
// under the token's null arm, where its box is fresh (reuse_construct).
//
// Any other take from the donor follows the same answer (`moved`, at the slots
// `freed` marks): the construction overwrites the slot, so a unique donor's
// child is the frame's with neither a null nor a second uniqueness read, and
// the donor's release walks past it. The donor is only read between the first
// such take and the construction, so nothing can raise its count while the
// answer stands.
//
// A declared enum's variant is rebuilt as a record is: its box is the record
// layout behind the variant's shape word, and a read naming the variant the
// construction builds says the donor holds that shape already.
pub struct Keeps { donors: i32[], slots: boolean[][], values: i32[][], late: i32[][], moved: i32[][], freed: boolean[][], start: i32[], taken: i32[], built: i32[] }

function keep_slots(f: ssasem.Func, p: Plan, idx: i32[][], b: ssa.SBlock, ins: ssa.SInst, built: i32, donor: i32, taken: i32, uses: ssasem.Uses): Keeps {
  let none: Keeps = no_keeps();
  if (!rebuilds(f, ins, donor)) {
    return none;
  }
  let slots: boolean[] = [];
  while (slots.len() < ins.args.len()) {
    slots = slots.append(false);
  }
  let freed: boolean[] = slots;
  let moved: i32[] = [];
  let first_moved: i32 = 0 - 1;
  let values: i32[] = [];
  let late: i32[] = [];
  let start: i32 = 0 - 1;
  let retained: i32[] = [];
  for supply in step_of(p, idx, b.id, built, 0 - 1).supplies {
    if (supply.mode == retain_unit()) {
      retained = retained.append(supply.value);
    }
  }
  let scalars: boolean = false;
  let pos: i32 = 0;
  while (pos <= taken) {
    let get: ssa.SInst = b.insts[pos];
    // A counted read keeps exactly one unit: one taken AND retained at the
    // construction holds two, and keeping in place stands in for one. A
    // scalar read has no unit and is kept as it stands.
    let read: boolean = rebuilt_read(f, ins, get, donor);
    let counted: boolean = read && ssasem.reference(f.values[get.result]);
    let kept: boolean = false;
    if (read && (!counted || payload_taken(f, p, get) != util.index_of_i32(retained, get.result) >= 0)) {
      let i: i32 = util.index_of_i32(ins.args, get.result);
      // Once: the donor's slot holds one unit, which a second operand
      // naming the same value would need a retain of its own for.
      if (i == get.imm && !slots[i] && occurrences(ins.args, get.result) == 1) {
        kept = true;
        values = values.append(get.result);
        slots = slots.with(i, true);
        if (ssasem.use_count(uses, get.result) == 1 && !held_read(p, get)) {
          late = late.append(get.result);
        }
        // Only a counted read needs the donor's uniqueness at the read.
        if (!counted) {
          scalars = true;
        } else if (start < 0) {
          start = pos;
        }
      }
    }
    if (counted && !kept && payload_taken(f, p, get) && get.imm < freed.len() && slot_reads(b, donor, get.imm, built) == 1) {
      moved = moved.append(get.result);
      freed = freed.with(get.imm, true);
      if (first_moved < 0) {
        first_moved = pos;
      }
    }
    pos = pos + 1;
  }
  if (first_moved >= 0 && only_read(b, donor, first_moved, built) && (start < 0 || first_moved < start)) {
    start = first_moved;
  } else if (first_moved >= 0 && (start < 0 || first_moved < start)) {
    moved = [];
    freed = slots;
  }
  if (start < 0 && scalars) {
    start = taken;
  }
  if (start < 0) {
    return none;
  }
  return Keeps { donors: [donor], slots: [slots], values: [values], late: [late], moved: [moved], freed: [freed], start: [start], taken: [taken], built: [] };
}

pub function no_keeps(): Keeps {
  return Keeps { donors: [], slots: [], values: [], late: [], moved: [], freed: [], start: [], taken: [], built: [] };
}

// A construction that can be built in its donor's box as it stands: a record
// of the donor's type, a variant of a declared enum, or a member of the
// struct-union the donor is.
function rebuilds(f: ssasem.Func, ins: ssa.SInst, donor: i32): boolean {
  if (ins.kind_tag == ssasem.record_new() && member_of(f, ins, donor) != "") {
    return true;
  }
  if (!semtypes.equal(f.values[ins.result], f.values[donor])) {
    return false;
  }
  if (ins.kind_tag == ssasem.record_new()) {
    return true;
  }
  let e: i32 = semrecords.find_enum(f.enums, f.values[donor]);
  return ins.kind_tag == ssasem.variant_new() && e >= 0 && f.enums[e].layout == semrecords.layout_variant();
}

// The member a record construction builds of the struct-union `donor` is, or
// "". A member's box is the union's, so the construction lays its fields out
// as a payload read of the union names them.
function member_of(f: ssasem.Func, ins: ssa.SInst, donor: i32): string {
  let e: i32 = semrecords.find_enum(f.enums, f.values[donor]);
  if (e < 0 || f.enums[e].layout != semrecords.layout_member()) {
    return "";
  }
  if let typeinfo.TypeStruct(r) = f.values[ins.result] {
    if (r.args.len() == 0 && semrecords.find_variant(f.enums[e], r.name) >= 0) {
      return r.name;
    }
  }
  return "";
}

// A read of one of the donor's fields as the construction lays them out.
function rebuilt_read(f: ssasem.Func, ins: ssa.SInst, get: ssa.SInst, donor: i32): boolean {
  if (get.args.len() != 1 || get.args[0] != donor) {
    return false;
  }
  if (ins.kind_tag == ssasem.record_new()) {
    if (get.kind_tag == ssasem.variant_get()) {
      return get.str == member_of(f, ins, donor);
    }
    return get.kind_tag == ssasem.record_get();
  }
  return get.kind_tag == ssasem.variant_get() && get.str == ins.str;
}

// The reads of `v`'s field `slot` in the block up to `to`.
function slot_reads(b: ssa.SBlock, v: i32, slot: i32, to: i32): i32 {
  let n: i32 = 0;
  let pos: i32 = 0;
  while (pos <= to && pos < b.insts.len()) {
    let ins: ssa.SInst = b.insts[pos];
    if (taken_read(ins.kind_tag) && ins.args.len() == 1 && ins.args[0] == v && ins.imm == slot) {
      n = n + 1;
    }
    pos = pos + 1;
  }
  return n;
}

// Whether every instruction from `from` to `to` that names `v` only reads it,
// so none takes a unit of its box.
function only_read(b: ssa.SBlock, v: i32, from: i32, to: i32): boolean {
  let pos: i32 = from;
  while (pos <= to && pos < b.insts.len()) {
    let ins: ssa.SInst = b.insts[pos];
    if (util.index_of_i32(ins.args, v) >= 0 && !taken_read(ins.kind_tag) && ins.kind_tag != ssasem.variant_is()) {
      return false;
    }
    pos = pos + 1;
  }
  return true;
}

// A read the plan gives an effect of its own at its position: a take that
// nulls a tuple slot, or a hold that retains the element.
function held_read(p: Plan, ins: ssa.SInst): boolean {
  return ins.result < p.takes.len() && p.takes[ins.result] >= 0
    || ins.result < p.held.len() && p.held[ins.result];
}

// Every pairing's token interval in the block: `from` where the token is taken,
// `to` where it is spent.
function token_busy(pairs: ReusePairs, from: i32, to: i32, own_build: i32): boolean {
  let pos: i32 = 0;
  while (pos < pairs.builds.len()) {
    if (pos != own_build) {
      if (pairs.selfs[pos] >= 0 && pos >= from && pos <= to) {
        return true;
      }
      if (pairs.builds[pos] >= 0 && pos >= from) {
        let t: i32 = util.index_of_i32(pairs.tokens, pairs.builds[pos]);
        if (t <= to) {
          return true;
        }
      }
    }
    pos = pos + 1;
  }
  return false;
}

function block_keeps(f: ssasem.Func, p: Plan, idx: i32[][], b: ssa.SBlock, pairs: ReusePairs, carry: Carry, links: i32[], uses: ssasem.Uses): Keeps {
  let out: Keeps = no_keeps();
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let donor: i32 = pairs.selfs[pos];
    let taken: i32 = pos;
    if (donor < 0 && pairs.builds[pos] >= 0) {
      donor = pairs.builds[pos];
      taken = util.index_of_i32(pairs.tokens, donor);
    }
    if (donor >= 0 && taken >= 0) {
      let k: Keeps = keep_slots(f, p, idx, b, b.insts[pos], pos, donor, taken, uses);
      if (k.donors.len() > 0 && !token_busy(pairs, k.start[0], pos, pos)) {
        out = Keeps {
          donors: out.donors.append(donor), slots: out.slots.append(k.slots[0]),
          values: out.values.append(k.values[0]), late: out.late.append(k.late[0]),
          moved: out.moved.append(k.moved[0]), freed: out.freed.append(k.freed[0]),
          start: out.start.append(k.start[0]), taken: out.taken.append(taken), built: out.built.append(pos),
        };
      }
    }
    pos = pos + 1;
  }
  return classified(f, p, idx, b, pairs, carry, links, out);
}

// A donor whose payload this block takes and which dies in the block, by its
// drop or as a token held for a construction, without a construction here
// that keeps its fields: its uniqueness is read once, at its first take, and
// the takes and its death follow that answer. A type with a finalizer is left
// to its drop helper, which runs it. It is a keep without a
// construction (`built` -1): a unique donor's taken slots are the frame's,
// and its death releases the other fields alone. One donor at a time holds
// the token slot, so a window that would overlap another is left as it was.
function classified(f: ssasem.Func, p: Plan, idx: i32[][], b: ssa.SBlock, pairs: ReusePairs, carry: Carry, links: i32[], own out: Keeps): Keeps {
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let dying: i32[] = step_of(p, idx, b.id, pos, 0 - 1).drops;
    if (pairs.tokens[pos] >= 0) {
      dying = dying.append(pairs.tokens[pos]);
    }
    if (carry_held(carry, b.id, pos) >= 0) {
      dying = dying.append(carry_held(carry, b.id, pos));
    }
    for d in dying {
      let start: i32 = first_classified_take(f, p, b, d, pos, links);
      if (start >= 0 && util.index_of_i32(out.donors, d) < 0 && util.index_of_i32(pairs.selfs, d) < 0
        && !token_busy(pairs, start, pos, util.index_of_i32(pairs.builds, d)) && !keep_overlaps(out, start, pos)) {
        let moved: i32[] = [];
        let freed: boolean[] = [];
        let n: i32 = donor_fields(f, b.insts[start], d);
        while (freed.len() < n) {
          freed = freed.append(false);
        }
        let i: i32 = start;
        while (i <= pos) {
          let get: ssa.SInst = b.insts[i];
          if (classified_take(f, p, get, d)) {
            moved = moved.append(get.result);
            freed = freed.with(get.imm, true);
          }
          i = i + 1;
        }
        out = Keeps {
          donors: out.donors.append(d), slots: out.slots.append([]), values: out.values.append([]), late: out.late.append([]),
          moved: out.moved.append(moved), freed: out.freed.append(freed),
          start: out.start.append(start), taken: out.taken.append(pos), built: out.built.append(0 - 1),
        };
      }
    }
    pos = pos + 1;
  }
  return out;
}

// The position of the donor's first payload take when every read of it from
// there to its death at `dies` is a take of one variant's slot, read once, or
// a test: else -1. A record donor's reads are its fields; an enum donor's
// name the variant whose fields its death walks.
function first_classified_take(f: ssasem.Func, p: Plan, b: ssa.SBlock, d: i32, dies: i32, links: i32[]): i32 {
  if (d < 0 || d < links.len() && links[d] >= 0 || !ssasem.reference(f.values[d]) || ssasem.finalizer_of(f, f.values[d]) != "") {
    return 0 - 1;
  }
  let first: i32 = 0 - 1;
  let pos: i32 = 0;
  while (pos <= dies) {
    let ins: ssa.SInst = b.insts[pos];
    if (first < 0 && classified_take(f, p, ins, d)) {
      first = pos;
    }
    if (first >= 0 && util.index_of_i32(ins.args, d) >= 0) {
      let same: boolean = ins.kind_tag == ssasem.record_get() || ins.str == b.insts[first].str;
      let fits: boolean = classified_take(f, p, ins, d) && same && slot_reads(b, d, ins.imm, dies) == 1
        || ins.kind_tag == ssasem.variant_is() || taken_read(ins.kind_tag) && !(ins.result < p.payloads.len() && p.payloads[ins.result]);
      if (!fits || shell_root(f, p, ins) == d) {
        return 0 - 1;
      }
    }
    pos = pos + 1;
  }
  if (first >= 0 && donor_fields(f, b.insts[first], d) < 0) {
    return 0 - 1;
  }
  return first;
}

// A payload take out of a record's field or a declared variant's slot.
function classified_take(f: ssasem.Func, p: Plan, ins: ssa.SInst, d: i32): boolean {
  if (ins.args.len() != 1 || ins.args[0] != d || !payload_taken(f, p, ins) || !ssasem.reference(f.values[ins.result])) {
    return false;
  }
  if (ins.kind_tag == ssasem.record_get()) {
    return semrecords.find(f.records, f.values[d]) >= 0;
  }
  let e: i32 = semrecords.find_enum(f.enums, f.values[d]);
  return ins.kind_tag == ssasem.variant_get() && e >= 0 && f.enums[e].layout == semrecords.layout_variant();
}

// The number of fields a donor read by `get` lays out, or -1.
function donor_fields(f: ssasem.Func, get: ssa.SInst, d: i32): i32 {
  if (get.kind_tag == ssasem.record_get()) {
    return record_fields(f.values[d], f).len();
  }
  let e: i32 = semrecords.find_enum(f.enums, f.values[d]);
  if (e < 0) {
    return 0 - 1;
  }
  let v: i32 = semrecords.find_variant(f.enums[e], get.str);
  if (v < 0) {
    return 0 - 1;
  }
  return f.enums[e].variants[v].fields.len();
}

function keep_overlaps(k: Keeps, from: i32, to: i32): boolean {
  let i: i32 = 0;
  while (i < k.donors.len()) {
    let end: i32 = k.built[i];
    if (end < 0) {
      end = k.taken[i];
    }
    if (k.start[i] <= to && from <= end) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// The keep with no construction whose donor dies at `pos`, or -1.
pub function classified_at(k: Keeps, pos: i32): i32 {
  let i: i32 = 0;
  while (i < k.donors.len()) {
    if (k.built[i] < 0 && k.taken[i] == pos) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function kept_values(k: Keeps): i32[] {
  let out: i32[] = [];
  for vs in k.values {
    for v in vs {
      out = out.append(v);
    }
  }
  return out;
}

// Whether a keep's donor dies at `pos` for a construction later in the block,
// its box released at that construction, or is classified there: either way
// its token is not taken as an ordinary one.
pub function token_kept(k: Keeps, pos: i32, donor: i32): boolean {
  let i: i32 = 0;
  while (i < k.taken.len()) {
    if (k.taken[i] == pos && k.built[i] != pos && k.donors[i] == donor) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function moved_values(k: Keeps): i32[] {
  let out: i32[] = [];
  for vs in k.moved {
    for v in vs {
      out = out.append(v);
    }
  }
  return out;
}

pub function late_values(k: Keeps): i32[] {
  let out: i32[] = [];
  for vs in k.late {
    for v in vs {
      out = out.append(v);
    }
  }
  return out;
}

// The links of a function, by value: the parameter each link's unit is owed
// on, -1 for a value that is not one. A link is an append or a with onto the
// parameter whose retain was deferred, one onto a link, a phi whose every input is
// the parameter or a link of it, which is how a loop carries one, or the
// result of a direct call lent the parameter or a link as the last reader of
// its box (`call_root`), `b = f(b, v)`.
//
// Every use of a link has to understand the encoding, so a candidate stays
// only while each supply naming it MOVES it into one of three places: the
// receiver of an append or a with, a link phi, or the return, which takes the unit that
// is owed. A read that takes no unit is fine, since the box is live either
// way, and so is a drop, which releases only a box of the frame's own
// (`drop_linked`). A loop's link reaches its phi by move only because
// `ssalive` counts a phi's inputs on the incoming edge rather than as uses in
// its block. A retain or a steal is not, and neither is a parameter the frame
// reads anywhere else: it is removed, and whatever depended on it goes with it
// on the next round.
function links_of(f: ssasem.Func, p: Plan, idx: i32[][]): i32[] {
  let top: i32 = 0 - 2;
  let state: i32[] = [];
  let v: i32 = 0;
  while (v < f.graph.nvals) {
    state = state.append(0 - 1);
    v = v + 1;
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    for ins in f.graph.blocks[bi].insts {
      if (link_kind(f, p, ins)) {
        state = state.with(ins.result, top);
      }
    }
    bi = bi + 1;
  }
  let roots: boolean[] = link_roots(f, p);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let next: i32[] = propagate(f, p, idx, state, roots);
    next = prune(f, p, next);
    v = 0;
    while (v < next.len()) {
      if (next[v] != state[v]) {
        changed = true;
      }
      v = v + 1;
    }
    state = next;
  }
  v = 0;
  while (v < state.len()) {
    if (state[v] == top) {
      state = state.with(v, 0 - 1);
    }
    v = v + 1;
  }
  return state;
}

function link_kind(f: ssasem.Func, p: Plan, ins: ssa.SInst): boolean {
  if (box_update(ins)) {
    return p.grows[ins.result] < 0;
  }
  if (ins.kind_tag == ssasem.call()) {
    return is_array_type(f.values[ins.result]) && !ssasem.is_dyn_call(ins.str);
  }
  return ins.kind_tag == 8 && is_array_type(f.values[ins.result]);
}

function is_array_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

// The parameters a link may be owed on: borrowed arrays the frame is done
// with wherever a link of theirs may grow the box. A deferred append already
// requires the parameter dead after it (`deferred_retain`), and a phi edge
// requires it dead in the loop it enters (`Plan.entry_kept`), so any read of
// it, a return of it included, happens before the box can grow.
function link_roots(f: ssasem.Func, p: Plan): boolean[] {
  let ok: boolean[] = [];
  let v: i32 = 0;
  while (v < f.graph.nparams) {
    ok = ok.append(is_array_type(f.values[v]) && !(v < p.owned.len() && p.owned[v]) && !p.entry_kept[v]);
    v = v + 1;
  }
  return ok;
}

// One round of the candidates' roots, read off their inputs. A root only
// descends: unknown, then a parameter, then none.
function propagate(f: ssasem.Func, p: Plan, idx: i32[][], state: i32[], roots: boolean[]): i32[] {
  let top: i32 = 0 - 2;
  let out: i32[] = state;
  for b in f.graph.blocks {
    let pos: i32 = 0 - 1;
    for ins in b.insts {
      pos = pos + 1;
      if (state[ins.result] == 0 - 1) {
        continue;
      }
      let root: i32 = top;
      if (box_update(ins)) {
        root = input_root(f, state, roots, ins.args[0]);
        // Straight onto the parameter, the update must be the deferred one.
        if (ins.args[0] < f.graph.nparams && !deferred_retain(f, p, step_of(p, idx, b.id, pos, 0 - 1), ins)) {
          root = 0 - 1;
        }
      } else if (ins.kind_tag == ssasem.call()) {
        root = call_root(f, step_of(p, idx, b.id, pos, 0 - 1), state, roots, ins);
      } else {
        for a in ins.args {
          let r0: i32 = input_root(f, state, roots, a);
          if (r0 == 0 - 1 || root >= 0 && r0 >= 0 && r0 != root) {
            root = 0 - 1;
          } else if (r0 >= 0 && root == top) {
            root = r0;
          }
        }
      }
      if (root != top || state[ins.result] == top) {
        out = out.with(ins.result, root);
      }
    }
  }
  return out;
}

// A call's result is a link of the one root among its operands, lent as the
// last reader of the box: the parameter handed on (hands) or a link
// dying at the call. The callee may grow that box in place, since nothing in
// this frame reads it again, and what comes back is either the same box, at
// the callee's retain, or one the frame holds a unit of.
function call_root(f: ssasem.Func, step: Step, state: i32[], roots: boolean[], ins: ssa.SInst): i32 {
  let modes: i32[] = callee_modes(f, ins);
  let root: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let r0: i32 = input_root(f, state, roots, ins.args[i]);
    if (r0 != 0 - 1) {
      if (root != 0 - 1 || !lent_last(f, step, modes, ins, i)) {
        return 0 - 1;
      }
      root = r0;
    }
    i = i + 1;
  }
  return root;
}

function lent_last(f: ssasem.Func, step: Step, modes: i32[], ins: ssa.SInst, i: i32): boolean {
  let a: i32 = ins.args[i];
  if (i >= modes.len() || modes[i] != borrow_mode() || occurrences(ins.args, a) != 1) {
    return false;
  }
  if (a < f.graph.nparams) {
    return i < step.hand_roots.len() && step.hand_roots[i] == a;
  }
  return util.index_of_i32(step.drops, a) >= 0;
}

function input_root(f: ssasem.Func, state: i32[], roots: boolean[], a: i32): i32 {
  if (a < 0) {
    return 0 - 1;
  }
  if (a < f.graph.nparams) {
    if (roots[a]) {
      return a;
    }
    return 0 - 1;
  }
  return state[a];
}

// Candidates with a use the encoding cannot reach, removed.
function prune(f: ssasem.Func, p: Plan, state: i32[]): i32[] {
  let out: i32[] = state;
  let at: i32[] = ssa.block_positions(f.graph);
  for step in p.steps {
    for h in step.hand_roots {
      out = unlink(out, h);
    }
    for supply in step.supplies {
      if (supply.value >= 0 && supply.value < state.len() && state[supply.value] != 0 - 1 && !linked_supply(f, p, at, state, step, supply)) {
        out = unlink(out, supply.value);
      }
    }
  }
  return out;
}

function unlink(own state: i32[], v: i32): i32[] {
  if (v < 0 || v >= state.len()) {
    return state;
  }
  return state.with(v, 0 - 1);
}

function linked_supply(f: ssasem.Func, p: Plan, at: i32[], state: i32[], step: Step, supply: Supply): boolean {
  if (supply.mode != move_unit()) {
    return false;
  }
  let b: ssa.SBlock = f.graph.blocks[at[step.block]];
  if (step.point == return_point()) {
    return b.term.kind_tag == 1 && b.term.value == supply.value;
  }
  if (step.point == edge_point()) {
    let dest: ssa.SBlock = f.graph.blocks[at[step.target]];
    if (supply.slot < 0 || supply.slot >= dest.insts.len()) {
      return false;
    }
    let phi: ssa.SInst = dest.insts[supply.slot];
    return phi.kind_tag == 8 && same_root(state[phi.result], state[supply.value]);
  }
  if (step.point < 0) {
    return false;
  }
  let ins: ssa.SInst = b.insts[step.point];
  return box_update(ins) && supply.slot == 0 && ins.args[0] == supply.value && p.grows[ins.result] < 0;
}

function same_root(a: i32, b: i32): boolean {
  if (a == 0 - 1 || b == 0 - 1) {
    return false;
  }
  return a == b || a == 0 - 2 || b == 0 - 2;
}

// ---- The replay of the tokens --------------------------------------------
//
// A token is a unit like any other: taken where its donor dies, spent by one
// construction, and on the paths that reach no construction freed on the edge
// that leaves. `verify_reuse` holds the plan's tables to that: a token is
// taken from a value the step drops and never while the block's one slot is
// held, a construction spends the token it was handed and reads nothing of
// the box it builds in, a kept donor is that construction's token, and a
// carried token is held on every path into a block or on none, spent where
// the carry says, freed where its way leaves, and held at no return.
function verify_reuse(f: ssasem.Func, p: Plan, reachable: boolean[]): string {
  let idx: i32[][] = step_index(p);
  let r: Reuse = p.reuse;
  // A plan whose tables are not made yet plans no token.
  if (r.pairs.len() == 0 && r.keeps.len() == 0 && r.carry.from.len() == 0 && r.carry.to.len() == 0) {
    return "";
  }
  if (r.pairs.len() != f.graph.blocks.len() || r.keeps.len() != f.graph.blocks.len()) {
    return "reuse tables do not cover the blocks";
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    if (reachable[bi]) {
      let why: string = verify_block_tokens(f, p, idx, bi, r);
      if (why != "") {
        return why;
      }
    }
    bi = bi + 1;
  }
  return verify_carry(f, p, idx, r, reachable);
}

// The pairings of one block, replayed over its one token slot.
function verify_block_tokens(f: ssasem.Func, p: Plan, idx: i32[][], bi: i32, r: Reuse): string {
  let b: ssa.SBlock = f.graph.blocks[bi];
  let pr: ReusePairs = r.pairs[bi];
  if (pr.tokens.len() != b.insts.len() || pr.builds.len() != b.insts.len() || pr.selfs.len() != b.insts.len()) {
    return "reuse pairing rows do not cover the block";
  }
  let held: i32[] = [];
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let ins: ssa.SInst = b.insts[pos];
    if (ins.kind_tag == 6 || ins.kind_tag == 8) {
      if (pr.tokens[pos] >= 0 || pr.builds[pos] >= 0 || pr.selfs[pos] >= 0) {
        return "a token at a parameter or a phi";
      }
    } else {
      let step: Step = step_of(p, idx, b.id, pos, 0 - 1);
      if (pr.builds[pos] >= 0) {
        let k: i32 = util.index_of_i32(held, pr.builds[pos]);
        if (k < 0) {
          return "a construction spends a token it was not handed";
        }
        if (util.index_of_i32(ins.args, pr.builds[pos]) >= 0) {
          return "a construction reads the box it builds in";
        }
        held = without_at(held, k);
      }
      if (pr.selfs[pos] >= 0) {
        let d: i32 = pr.selfs[pos];
        if (pr.builds[pos] >= 0) {
          return "a construction spends two tokens";
        }
        let carried: boolean = carry_held_for(r.carry, b.id, pos);
        if (carried && r.carry.donor[util.index_of_i32(r.carry.to, b.id)] != d) {
          return "a construction spends a token other than the one carried to it";
        }
        if (!carried && (util.index_of_i32(step.drops, d) < 0 || static_box(p, d))) {
          return "a token is taken from a value not dying here";
        }
        if (util.index_of_i32(ins.args, d) >= 0 || d == ins.result) {
          return "a construction reads the box it builds in";
        }
      } else if (carry_held_for(r.carry, b.id, pos)) {
        return "a carried token reaches a construction that does not spend it";
      }
      if (pr.tokens[pos] >= 0) {
        if (util.index_of_i32(held, pr.tokens[pos]) >= 0 || pr.tokens[pos] == pr.selfs[pos]) {
          return "a token is taken twice";
        }
        if (util.index_of_i32(step.drops, pr.tokens[pos]) < 0 || static_box(p, pr.tokens[pos])) {
          return "a token is taken from a value not dying here";
        }
        held = held.append(pr.tokens[pos]);
      }
    }
    pos = pos + 1;
  }
  if (held.len() > 0) {
    return "a token taken in a block is spent by no construction in it";
  }
  return verify_keeps(pr, r.keeps[bi]);
}

// A kept donor is the token of the construction that keeps its fields, and
// the slot it holds from its first kept read is no other pairing's.
function verify_keeps(pr: ReusePairs, k: Keeps): string {
  let i: i32 = 0;
  while (i < k.donors.len()) {
    let built: i32 = k.built[i];
    let taken: i32 = k.taken[i];
    if (built < 0) {
      if (taken < 0 || taken >= pr.selfs.len() || k.start[i] < 0 || k.start[i] > taken) {
        return "a classified donor's positions are outside its block";
      }
      if (token_busy(pr, k.start[i], taken, util.index_of_i32(pr.builds, k.donors[i]))) {
        return "a classified donor's token overlaps a pairing's";
      }
      i = i + 1;
      continue;
    }
    if (built >= pr.selfs.len() || taken < 0 || taken > built || k.start[i] < 0 || k.start[i] > built) {
      return "a kept donor's positions are outside its block";
    }
    let own: boolean = built == taken && pr.selfs[built] == k.donors[i];
    let earlier: boolean = taken < built && pr.tokens[taken] == k.donors[i] && pr.builds[built] == k.donors[i];
    if (!own && !earlier) {
      return "a kept donor is not its construction's token";
    }
    if (token_busy(pr, k.start[i], built, built)) {
      return "a kept donor's token overlaps another pairing's";
    }
    i = i + 1;
  }
  return "";
}

function with_token(own set: i32[], d: i32): i32[] {
  if (util.index_of_i32(set, d) >= 0) {
    return set;
  }
  return set.append(d);
}

function without_token(set: i32[], d: i32): i32[] {
  let out: i32[] = [];
  for x in set {
    if (x != d) {
      out = out.append(x);
    }
  }
  return out;
}

function same_tokens(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for x in a {
    if (util.index_of_i32(b, x) < 0) {
      return false;
    }
  }
  return true;
}

// The tokens held after block `k`'s instructions: those held at its entry,
// plus the donors it holds, less the one its construction spends.
function tokens_out(c: Carry, b: ssa.SBlock, entry: i32[]): i32[] {
  let out: i32[] = entry;
  let i: i32 = 0;
  while (i < c.from.len()) {
    if (c.from[i] == b.id) {
      out = with_token(out, c.held[i]);
    }
    i = i + 1;
  }
  i = 0;
  while (i < c.to.len()) {
    if (c.to[i] == b.id) {
      out = without_token(out, c.donor[i]);
    }
    i = i + 1;
  }
  return out;
}

// The tokens the edge from `from` to `to` delivers: those held at the end of
// `from` less the ones it frees, plus the ones that arrive null, which the
// construction ahead spends as a token all the same.
function tokens_over(c: Carry, from: i32, to: i32, out: i32[]): i32[] {
  let over: i32[] = out;
  for d in carry_exits(c, from, to) {
    over = without_token(over, d);
  }
  for d in carry_nulls(c, from, to) {
    over = with_token(over, d);
  }
  return over;
}

// The carries, replayed as a forward flow of the tokens held at each block's
// entry: every edge into a block delivers the same tokens, a block spends
// only a token it holds, frees only one it holds, and a block that leaves
// the function holds none.
function verify_carry(f: ssasem.Func, p: Plan, idx: i32[][], r: Reuse, reachable: boolean[]): string {
  let c: Carry = r.carry;
  let at: i32[] = ssa.block_positions(f.graph);
  let i: i32 = 0;
  while (i < c.from.len()) {
    let k: i32 = at[c.from[i]];
    if (k < 0 || !reachable[k]) {
      return "a token is held in an unreachable block";
    }
    let b: ssa.SBlock = f.graph.blocks[k];
    if (successors(b).len() == 0) {
      return "a block that leaves the function holds a token";
    }
    if (util.index_of_i32(step_of(p, idx, b.id, c.drop_at[i], 0 - 1).drops, c.held[i]) < 0 || static_box(p, c.held[i])) {
      return "a carried token is taken from a value not dying there";
    }
    i = i + 1;
  }
  let entry: i32[][] = [];
  let known: boolean[] = [];
  for b in f.graph.blocks {
    entry = entry.append([]);
    known = known.append(false);
  }
  known = known.with(at[f.graph.entry], true);
  // Each round marks the successors of the blocks entered so far, so the
  // rounds end once every reachable block has its entry.
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let k: i32 = 0;
    while (k < f.graph.blocks.len()) {
      if (reachable[k] && known[k]) {
        let b: ssa.SBlock = f.graph.blocks[k];
        let why: string = spent_held(c, b, entry[k]);
        if (why != "") {
          return why;
        }
        let out: i32[] = tokens_out(c, b, entry[k]);
        let next: i32[] = successors(b);
        if (next.len() == 0 && out.len() > 0) {
          return "a carried token is held where the function leaves";
        }
        for s in next {
          for d in carry_exits(c, b.id, s) {
            if (util.index_of_i32(out, d) < 0) {
              return "an edge frees a token it does not hold";
            }
          }
          let over: i32[] = tokens_over(c, b.id, s, out);
          let sk: i32 = at[s];
          if (!known[sk]) {
            known = known.with(sk, true);
            entry = entry.with(sk, over);
            changed = true;
          } else if (!same_tokens(entry[sk], over)) {
            return "a carried token is held on one path into a block and not another";
          }
        }
      }
      k = k + 1;
    }
  }
  return "";
}

// A block's construction spends a token it holds at entry.
function spent_held(c: Carry, b: ssa.SBlock, entry: i32[]): string {
  let i: i32 = 0;
  while (i < c.to.len()) {
    if (c.to[i] == b.id && util.index_of_i32(entry, c.donor[i]) < 0) {
      return "a construction spends a carried token no path holds";
    }
    i = i + 1;
  }
  return "";
}
