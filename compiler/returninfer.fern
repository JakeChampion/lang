import "./ast";
import "./parser";
import "std/string";

function irt_is_option(s: string): boolean {
  return s.len() >= 7 && s.starts_with("Option[");
}

function irt_unify(a: string, b: string): string {
  if (a == b) {
    return a;
  }
  if (irt_is_option(a) && b == "Option") {
    return a;
  }
  if (irt_is_option(b) && a == "Option") {
    return b;
  }
  return "";
}

function irt_collect_returns(stmts: ast.Stmt[], acc: ast.Expr[]): ast.Expr[] {
  let out = acc;
  for i in 0..stmts.len() {
    out = irt_collect_stmt(stmts[i], out);
  }
  return out;
}

function irt_collect_stmt(st: ast.Stmt, acc: ast.Expr[]): ast.Expr[] {
  match (st) {
    ast.StmtReturn(r) => {
      return acc.append(r.value);
    },
    ast.StmtIf(f) => {
      let a = irt_collect_returns(f.then_body, acc);
      return irt_collect_returns(f.else_body, a);
    },
    ast.StmtWhile(w) => {
      return irt_collect_returns(w.body, acc);
    },
    ast.StmtFor(fr) => {
      return irt_collect_returns(fr.body, acc);
    },
    ast.StmtMatch(m) => {
      let a = acc;
      for i in 0..m.arms.len() {
        a = irt_collect_returns(m.arms[i].body, a);
      }
      return a;
    },
    _ => {
      return acc;
    }
  }
}

function irt_payload_of(scrut_ty: string): string {
  if (irt_is_scalar_ty(scrut_ty)) {
    return scrut_ty;
  }
  let args = parser.type_args_of(scrut_ty);
  if (args.len() > 0) {
    return args[0];
  }
  return "";
}

function irt_is_scalar_ty(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u32" || t == "u64" || t == "u8" || t == "u16" || t == "i16"
    || t == "usize" || t == "f64" || t == "f32";
}

function irt_arm_bindings(stmts: ast.Stmt[], params: ast.ParamDecl[], funcs: parser.FuncDecl[], structs: parser.StructDecl[], acc: ast.ParamDecl[]): ast.ParamDecl[] {
  let out = acc;
  for i in 0..stmts.len() {
    match (stmts[i]) {
      ast.StmtMatch(m) => {
        let st = irt_payload_of(parser.irt_guess(m.scrutinee, params, funcs, structs));
        for a in 0..m.arms.len() {
          match (m.arms[a].pattern) {
            ast.PatVariant(pv) => {
              if (st.len() > 0 && pv.binding.len() > 0 && pv.binding != "_") {
                out = out.append(ast.ParamDecl { name: pv.binding, type_name: st, own: false, send: false, has_default: false, default_value: parser.e_unknown(""), fn_ret: "", fn_param_types: "", line: 0, col: 0 });
              }
            },
            _ => {}
          }
          out = irt_arm_bindings(m.arms[a].body, params, funcs, structs, out);
        }
      },
      ast.StmtIf(f) => {
        out = irt_arm_bindings(f.then_body, params, funcs, structs, out);
        out = irt_arm_bindings(f.else_body, params, funcs, structs, out);
      },
      ast.StmtWhile(w) => {
        out = irt_arm_bindings(w.body, params, funcs, structs, out);
      },
      ast.StmtFor(fr) => {
        out = irt_arm_bindings(fr.body, params, funcs, structs, out);
      },
      _ => {}
    }
  }
  return out;
}

function irt_infer_func(fd: parser.FuncDecl, funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string {
  let empty: ast.Expr[] = [];
  let rets = irt_collect_returns(fd.body, empty);
  if (rets.len() == 0) {
    return "";
  }
  let scope = irt_arm_bindings(fd.body, fd.params, funcs, structs, fd.params);
  let unified = "";
  for i in 0..rets.len() {
    let g = parser.irt_guess(rets[i], scope, funcs, structs);
    if (g == "") {
      return "";
    }
    if (unified == "") {
      unified = g;
    } else {
      unified = irt_unify(unified, g);
      if (unified == "") {
        return "";
      }
    }
  }
  return unified;
}

pub function infer_func_returns(mod: parser.Module, widen_lambdas: boolean): parser.FuncDecl[] {
  let funcs = mod.funcs;
  let changed = true;
  while (changed) {
    changed = false;
    for i in 0..funcs.len() {
      let fd = funcs[i];
      if (fd.body.len() == 0 || fd.receiver_type.len() > 0 || fd.all_type_params.len() > 0) {
        continue;
      }
      if (fd.ret_type != "" && !(widen_lambdas && fd.ret_type == "i32" && fd.name.len() > 6 && fd.name.starts_with("__lam_"))) {
        continue;
      }
      let inferred = irt_infer_func(fd, funcs, mod.structs);
      if (inferred != "" && (fd.ret_type == "" || inferred == "i64" || inferred == "u64" || inferred == "f64")) {
        funcs = funcs.with(i, parser.FuncDecl { ...fd, ret_type: inferred });
        changed = true;
      }
    }
  }
  return funcs;
}

pub function infer_ret_types_module(mod: parser.Module): parser.Module {
  return parser.Module { ...mod, funcs: infer_func_returns(mod, true) };
}
