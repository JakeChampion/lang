function derived_self_type(sd: StructDecl): string {
  return applied_type(sd.name, sd.type_params);
}

function applied_type(name: string, type_params: string[]): string {
  if (type_params.len() == 0) {
    return name;
  }
  let tps: string = "";
  let ti: i32 = 0;
  while (ti < type_params.len()) {
    if (ti > 0) {
      tps = tps + ", ";
    }
    tps = tps + type_params[ti];
    ti = ti + 1;
  }
  return name + "[" + tps + "]";
}

