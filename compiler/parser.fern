function add_builtin_struct2(structs: StructDecl[], name: string, f0: string, t0: string, f1: string, t1: string): StructDecl[] {
  if (struct_declared(structs, name)) {
    return structs;
  }
  let fields: StructFieldDecl[] = [];
  fields = fields.append(StructFieldDecl { name: f0, type_name: t0, fn_ret: "", fn_param_types: "" });
  fields = fields.append(StructFieldDecl { name: f1, type_name: t1, fn_ret: "", fn_param_types: "" });
  return structs.append(StructDecl { name: name, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
}

struct MEnv { mnames: string[], mtypes: string[] }

function (e: MEnv) ebind(n: string, t: string): MEnv {
  return MEnv { mnames: e.mnames.append(n), mtypes: e.mtypes.append(t) };
}

function (e: MEnv) elook(n: string): string {
  let i: i32 = e.mnames.len() - 1;
  while (i >= 0) {
    if (e.mnames[i] == n) {
      return e.mtypes[i];
    }
    i = i - 1;
  }
  return "";
}

struct Insts { inames: string[], itypes: string[], iargs: string[] }

function (a: Insts) ihas(n: string, t: string): boolean {
  let i: i32 = 0;
  while (i < a.inames.len()) {
    if (a.inames[i] == n && a.itypes[i] == t) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function (a: Insts) iadd(n: string, t: string): Insts {
  if (a.ihas(n, t)) {
    return a;
  }
  return Insts { inames: a.inames.append(n), itypes: a.itypes.append(t), iargs: a.iargs.append(t) };
}

function (a: Insts) iadd_arg(n: string, t: string, arg: string): Insts {
  if (a.ihas(n, t)) {
    return a;
  }
  return Insts { inames: a.inames.append(n), itypes: a.itypes.append(t), iargs: a.iargs.append(arg) };
}

struct RExpr { rexpr: ast.Expr, rins: Insts }

struct RStmtOne { rstmt: ast.Stmt, renv: MEnv, rins2: Insts }

struct RStmts { rstmts: ast.Stmt[], rins3: Insts }

pub struct MFns {
  decls: FuncDecl[],
  ghead: i32[],
  gnext: i32[],
  gname: string[],
  gat: i32[],
  pix: util.NameIndex,
  pat: i32[],
  smm: string[],
  array_concrete: i32[],
  structs: StructDecl[],
  snames: util.NameIndex,
  enums: EnumDecl[],
  impls: ImplInfo[],
  keep_vars: boolean,
  on_call: string[],
  renamed: string[],
  lane_bounds: string[],
}

function mfns_buckets(): i32 {
  return 257;
}

function struct_names(structs: StructDecl[]): string[] {
  let out: string[] = [];
  for sd in structs {
    out = out.append(sd.name);
  }
  return out;
}

pub function mfns_of(decls: FuncDecl[], structs: StructDecl[], enums: EnumDecl[], impls: ImplInfo[]): MFns {
  let ghead: i32[] = [];
  let b: i32 = 0;
  let nb: i32 = mfns_buckets();
  while (b < nb) {
    ghead = ghead.append(0 - 1);
    b = b + 1;
  }
  let gname: string[] = [];
  let gat: i32[] = [];
  let smm: string[] = [];
  let array_concrete: i32[] = [];
  let pnames: string[] = [];
  let pat: i32[] = [];
  let i: i32 = 0;
  while (i < decls.len()) {
    if (is_free_bg_template(decls[i])) {
      gname = gname.append(decls[i].name);
      gat = gat.append(i);
    }
    if (decls[i].receiver_name.len() == 0 && decls[i].receiver_type.len() == 0) {
      pnames = pnames.append(decls[i].name);
      pat = pat.append(i);
    }
    if (decls[i].name.len() > 6 && slice_unchecked(decls[i].name, 0, 6) == "__smm_") {
      smm = smm.append(decls[i].name);
    }
    if (is_concrete_array_fold(decls[i])) {
      array_concrete = array_concrete.append(i);
    }
    i = i + 1;
  }
  let gnext: i32[] = [];
  let j: i32 = 0;
  while (j < gname.len()) {
    gnext = gnext.append(0 - 1);
    j = j + 1;
  }
  let k: i32 = gname.len() - 1;
  while (k >= 0) {
    let bk: i32 = util.hash_bucket(gname[k], nb);
    gnext = gnext.with(k, ghead[bk]);
    ghead = ghead.with(bk, k);
    k = k - 1;
  }
  return MFns { decls: decls, ghead: ghead, gnext: gnext, gname: gname, gat: gat, pix: util.name_index(pnames), pat: pat, smm: smm, array_concrete: array_concrete, structs: structs, snames: util.name_index(struct_names(structs)), enums: enums, impls: impls, keep_vars: false, on_call: [], renamed: renamed_receivers(decls), lane_bounds: [] };
}

function renamed_receivers(decls: FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in decls {
    if (fd.receiver_type.len() > 0 && derive_simple_name(fd.name) != fd.name) {
      let base: string = util.base_type_name(fd.receiver_type);
      if (!util.has_str(out, base)) {
        out = out.append(base);
      }
    }
  }
  return out;
}

function bg_find(fns: MFns, name: string): i32 {
  let e: i32 = fns.ghead[util.hash_bucket(name, fns.ghead.len())];
  while (e >= 0) {
    if (fns.gname[e] == name) {
      return fns.gat[e];
    }
    e = fns.gnext[e];
  }
  return 0 - 1;
}

function tp_index(name: string, tparams: string[]): i32 {
  let i: i32 = 0;
  while (i < tparams.len()) {
    if (tparams[i] == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function elem_spelling(arr: string): string {
  let el: string = slice_unchecked(arr, 0, arr.len() - 2) + "";
  if (el.len() < 2 || el[0] != b'(' || el[el.len() - 1] != b')') {
    return el;
  }
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < el.len()) {
    if (el[i] == b'(') {
      depth = depth + 1;
    } else if (el[i] == b')') {
      depth = depth - 1;
      if (depth == 0 && i < el.len() - 1) {
        return el;
      }
    }
    i = i + 1;
  }
  let inner: string = slice_unchecked(el, 1, el.len() - 1) + "";
  if (parse_type_ref(inner).is_fn) {
    return inner;
  }
  return el;
}

function type_ends_arr(s: string): boolean {
  if (s.len() < 2) {
    return false;
  }
  return slice_unchecked(s, s.len() - 2, s.len()) == "[]";
}

function first_bracket(s: string): i32 {
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'[') {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function split_top_commas(s: string): string[] {
  let out: string[] = [];
  let depth: i32 = 0;
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'[' || s[i] == b'(') {
      depth = depth + 1;
    }
    if (s[i] == b']' || s[i] == b')') {
      depth = depth - 1;
    }
    if (depth == 0 && s[i] == b',') {
      out = out.append(slice_unchecked(s, start, i) + "");
      i = i + 1;
      if (i < s.len() && s[i] == b' ') {
        i = i + 1;
      }
      start = i;
      continue;
    }
    i = i + 1;
  }
  out = out.append(slice_unchecked(s, start, s.len()) + "");
  return out;
}

pub function std_qualifier(mod: Module, name: string): string {
  let want: string = "std/" + name;
  for imp in mod.imports {
    let p: string = util.without_fern_ext(imp.path);
    if (p == want || p.len() > want.len() + 1 && slice_unchecked(p, p.len() - want.len() - 1, p.len()) + "" == "/" + want) {
      if (imp.alias.len() > 0) {
        return imp.alias;
      }
      return name;
    }
  }
  return "";
}

pub function is_serve_config_type(t: string, qual: string): boolean {
  let s: string = strip_type_spaces(t);
  return s == "serve__Config" || qual.len() > 0 && s == qual + ".Config";
}

pub function init_return_kind(rt: string, qual: string): i32 {
  let s: string = strip_type_spaces(rt);
  if (s.len() == 0 || s == "void") {
    return 0;
  }
  if (is_serve_config_type(s, qual)) {
    return 2;
  }
  if (s.len() > 2 && s[0] == b'(' && s[s.len() - 1] == b')') {
    let parts: string[] = split_top_commas(slice_unchecked(s, 1, s.len() - 1) + "");
    if (parts.len() == 2 && is_serve_config_type(parts[0], qual)) {
      return 3;
    }
  }
  return 1;
}

function strip_type_spaces(t: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < t.len()) {
    if (t[i] != b' ') {
      out = out + slice_unchecked(t, i, i + 1);
    }
    i = i + 1;
  }
  return out;
}

pub struct TypeRef { base: string, args: TypeRef[], array_depth: i32, is_tuple: boolean, is_fn: boolean, is_view: boolean }

pub function elem_type_ref(t: TypeRef): TypeRef {
  return TypeRef { ...t, array_depth: t.array_depth - 1 };
}

pub function top_arrow_at(s: string): i32 {
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'[' || s[i] == b'(') {
      depth = depth + 1;
    }
    if (s[i] == b']' || s[i] == b')') {
      depth = depth - 1;
    }
    if (depth == 0 && s[i] == b'=' && i + 1 < s.len() && s[i + 1] == b'>') {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function plain_type_spelling(s: string): boolean {
  let i: i32 = 0;
  while (i < s.len()) {
    let c: u8 = s[i];
    if (c == b'[' || c == b'(' || c == b'=') {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function parse_type_ref(sin: string): TypeRef {
  if (plain_type_spelling(sin)) {
    return TypeRef { base: sin, args: [], array_depth: 0, is_tuple: false, is_fn: false, is_view: false };
  }
  let s: string = sin;
  let depth: i32 = 0;
  let arrow: i32 = top_arrow_at(s);
  if (arrow > 0) {
    let lhs: string = slice_unchecked(s, 0, arrow) + "";
    while (lhs.len() > 0 && lhs[lhs.len() - 1] == b' ') {
      lhs = slice_unchecked(lhs, 0, lhs.len() - 1) + "";
    }
    let rhs: string = slice_unchecked(s, arrow + 2, s.len()) + "";
    while (rhs.len() > 0 && rhs[0] == b' ') {
      rhs = slice_unchecked(rhs, 1, rhs.len()) + "";
    }
    if (lhs.len() >= 2 && lhs[0] == b'(' && lhs[lhs.len() - 1] == b')') {
      let pinner: string = slice_unchecked(lhs, 1, lhs.len() - 1) + "";
      let fargs: TypeRef[] = [];
      if (pinner.len() > 0) {
        let psegs: string[] = split_top_commas(pinner);
        let pi: i32 = 0;
        while (pi < psegs.len()) {
          fargs = fargs.append(parse_type_ref(fn_parameter_type(psegs[pi])));
          pi = pi + 1;
        }
      }
      fargs = fargs.append(parse_type_ref(rhs));
      return TypeRef { base: "", args: fargs, array_depth: 0, is_tuple: false, is_fn: true, is_view: false };
    }
  }
  while (s.len() >= 2 && s[s.len() - 2] == b'[' && s[s.len() - 1] == b']') {
    depth = depth + 1;
    s = slice_unchecked(s, 0, s.len() - 2) + "";
  }
  if (s.len() >= 2 && s[0] == b'[' && matching_bracket(s, 0) == s.len() - 1) {
    return TypeRef { base: "", args: [parse_type_ref(slice_unchecked(s, 1, s.len() - 1) + "")], array_depth: depth, is_tuple: false, is_fn: false, is_view: true };
  }
  if (s.len() >= 2 && s[0] == b'(' && s[s.len() - 1] == b')') {
    let tsegs: string[] = split_top_commas(slice_unchecked(s, 1, s.len() - 1));
    let targs: TypeRef[] = [];
    let ti: i32 = 0;
    while (ti < tsegs.len()) {
      targs = targs.append(parse_type_ref(tsegs[ti]));
      ti = ti + 1;
    }
    return TypeRef { base: "", args: targs, array_depth: depth, is_tuple: true, is_fn: false, is_view: false };
  }
  let lb: i32 = 0 - 1;
  let j: i32 = 0;
  while (j < s.len()) {
    if (s[j] == b'[') {
      lb = j;
      j = s.len();
    } else {
      j = j + 1;
    }
  }
  if (lb >= 0 && s.len() > 0 && s[s.len() - 1] == b']') {
    let gsegs: string[] = split_top_commas(slice_unchecked(s, lb + 1, s.len() - 1));
    let gargs: TypeRef[] = [];
    let gi: i32 = 0;
    while (gi < gsegs.len()) {
      gargs = gargs.append(parse_type_ref(gsegs[gi]));
      gi = gi + 1;
    }
    return TypeRef { base: slice_unchecked(s, 0, lb) + "", args: gargs, array_depth: depth, is_tuple: false, is_fn: false, is_view: false };
  }
  return TypeRef { base: s, args: [], array_depth: depth, is_tuple: false, is_fn: false, is_view: false };
}

function fn_parameter_type(spelling: string): string {
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < spelling.len()) {
    let c: u8 = spelling[i];
    if (c == b'(' || c == b'[') {
      depth = depth + 1;
    }
    if (c == b')' || c == b']') {
      depth = depth - 1;
    }
    if (c == b':' && depth == 0) {
      return util.trim(slice_unchecked(spelling, i + 1, spelling.len()) + "");
    }
    i = i + 1;
  }
  return spelling;
}

pub function ref_ungroup(r: TypeRef): TypeRef {
  let t: TypeRef = r;
  while (t.array_depth == 0 && t.is_tuple && t.args.len() == 1) {
    t = t.args[0];
  }
  return t;
}

pub function ref_is_fn_value(r: TypeRef): boolean {
  let f: TypeRef = ref_ungroup(r);
  return f.array_depth == 0 && f.is_fn;
}

pub function spelling_is_view(spelling: string): boolean {
  let r: TypeRef = parse_type_ref(spelling);
  return r.is_view && r.array_depth == 0;
}

pub function spelling_is_own(spelling: string): boolean {
  let t: string = util.trim(spelling);
  return t.len() > 4 && slice_unchecked(t, 0, 4) == "own ";
}

pub function spelling_without_own(spelling: string): string {
  let t: string = util.trim(spelling);
  if (!spelling_is_own(t)) {
    return t;
  }
  return util.trim(slice_unchecked(t, 4, t.len()) + "");
}

pub function ref_is_own(r: TypeRef): boolean {
  return !r.is_tuple && !r.is_fn && spelling_is_own(r.base);
}

pub function ref_without_own(r: TypeRef): TypeRef {
  if (!ref_is_own(r)) {
    return r;
  }
  return TypeRef { ...r, base: spelling_without_own(r.base) };
}

pub function ref_fn_result(r: TypeRef): TypeRef {
  let f: TypeRef = ref_ungroup(r);
  return f.args[f.args.len() - 1];
}

pub function ref_fn_param_spellings(r: TypeRef): string {
  let f: TypeRef = ref_ungroup(r);
  let out: string = "";
  let i: i32 = 0;
  while (i + 1 < f.args.len()) {
    if (i > 0) {
      out = out + ",";
    }
    out = out + render_type_ref(f.args[i]);
    i = i + 1;
  }
  return out;
}

pub function is_fn_contract_tag(tag: string): boolean {
  return tag == "fn" || tag == "fn[]" || tag == "[fn]";
}

pub function fn_tag_spelling(tag: string, ret: string, params: string): string {
  if (ret.len() == 0 || !is_fn_contract_tag(tag)) {
    return tag;
  }
  let list: string = "";
  if (params.len() > 0) {
    let segs: string[] = split_top_commas(params);
    let i: i32 = 0;
    while (i < segs.len()) {
      if (i > 0) {
        list = list + ", ";
      }
      list = list + util.trim(segs[i]);
      i = i + 1;
    }
  }
  let spelled: string = "(" + list + ") => " + ret;
  if (tag == "fn[]") {
    return "(" + spelled + ")[]";
  }
  if (tag == "[fn]") {
    return "[" + spelled + "]";
  }
  return spelled;
}

pub function is_coarse_fn_tag(s: string): boolean {
  let i: i32 = 2;
  if (s.len() >= 4 && slice_unchecked(s, 0, 4) == "[fn]") {
    i = 4;
  } else if (s.len() < 2 || slice_unchecked(s, 0, 2) != "fn") {
    return false;
  }
  while (i < s.len()) {
    if (i + 2 > s.len() || slice_unchecked(s, i, i + 2) != "[]") {
      return false;
    }
    i = i + 2;
  }
  return true;
}

function fn_spelling_params(t: string): string {
  let r: TypeRef = parse_type_ref(t);
  if (!ref_is_fn_value(r)) {
    return "";
  }
  return ref_fn_param_spellings(r);
}

pub function render_type_ref(t: TypeRef): string {
  let inner: string = "";
  if (t.is_fn) {
    inner = "(";
    let f: i32 = 0;
    while (f + 1 < t.args.len()) {
      if (f > 0) {
        inner = inner + ", ";
      }
      inner = inner + render_type_ref(t.args[f]);
      f = f + 1;
    }
    inner = inner + ") => " + render_type_ref(t.args[t.args.len() - 1]);
  } else if (t.is_tuple) {
    inner = "(";
    let i: i32 = 0;
    while (i < t.args.len()) {
      if (i > 0) {
        inner = inner + ", ";
      }
      inner = inner + render_type_ref(t.args[i]);
      i = i + 1;
    }
    inner = inner + ")";
  } else if (t.is_view) {
    inner = "[" + render_type_ref(t.args[0]) + "]";
  } else if (t.args.len() > 0) {
    inner = t.base + "[";
    let k: i32 = 0;
    while (k < t.args.len()) {
      if (k > 0) {
        inner = inner + ", ";
      }
      inner = inner + render_type_ref(t.args[k]);
      k = k + 1;
    }
    inner = inner + "]";
  } else {
    inner = t.base;
  }
  let d: i32 = 0;
  while (d < t.array_depth) {
    inner = inner + "[]";
    d = d + 1;
  }
  return inner;
}

function split_dunder(s: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i + 1 < s.len()) {
    if (slice_unchecked(s, i, i + 2) == "__") {
      out = out.append(slice_unchecked(s, start, i) + "");
      i = i + 2;
      start = i;
      continue;
    }
    i = i + 1;
  }
  out = out.append(slice_unchecked(s, start, s.len()) + "");
  return out;
}

function split_key(s: string, n: i32, structs: StructDecl[], enums: EnumDecl[]): string[] {
  if (n <= 1 && !util.str_has_prefix(s, "tup__")) {
    return [s];
  }
  let tokens: string[] = split_dunder(s);
  if (n > 1 && tokens.len() <= n) {
    return tokens;
  }
  let want: i32 = n;
  if (want < 1) {
    want = 1;
  }
  let g: Grouped = group_tokens(tokens, 0, want, tokens.len() - want, structs, enums);
  if (g.pieces.len() != want || g.at != tokens.len()) {
    if (n <= 1) {
      return [s];
    }
    return tokens;
  }
  return g.pieces;
}

struct Grouped { pieces: string[], at: i32 }

function group_tokens(tokens: string[], at0: i32, n: i32, spare0: i32, structs: StructDecl[], enums: EnumDecl[]): Grouped {
  let pieces: string[] = [];
  let at: i32 = at0;
  let spare: i32 = spare0;
  while (pieces.len() < n && at < tokens.len()) {
    let one: Grouped = take_piece(tokens, at, spare, structs, enums);
    spare = spare - (one.at - at - 1);
    pieces = pieces.append(one.pieces[0]);
    at = one.at;
  }
  return Grouped { pieces: pieces, at: at };
}

function take_piece(tokens: string[], at: i32, spare: i32, structs: StructDecl[], enums: EnumDecl[]): Grouped {
  if (tokens[at] == "tup") {
    let tup: Grouped = take_tuple(tokens, at, structs, enums);
    if (tup.at + 1 < tokens.len() && tokens[tup.at] == "fto") {
      let rest: i32 = spare - (tup.at + 1 - at);
      if (rest < 0) {
        rest = 0;
      }
      let ret: Grouped = take_piece(tokens, tup.at + 1, rest, structs, enums);
      return Grouped { pieces: [tup.pieces[0] + " => " + ret.pieces[0]], at: ret.at };
    }
    return tup;
  }
  let k: i32 = spare;
  while (k >= 0) {
    let end: i32 = at + k + 1;
    let cand: string = join_dunder(tokens, at, end);
    let params: i32 = declared_params(cand, structs, enums);
    if (params == 0) {
      return Grouped { pieces: [cand], at: end };
    }
    if (params > 0 && spare - k - params >= 0) {
      let args: Grouped = group_tokens(tokens, end, params, spare - k - params, structs, enums);
      if (args.pieces.len() == params) {
        return Grouped { pieces: [cand + "__" + join_dunder(args.pieces, 0, params)], at: args.at };
      }
    }
    k = k - 1;
  }
  return Grouped { pieces: [tokens[at]], at: at + 1 };
}

function take_tuple(tokens: string[], at: i32, structs: StructDecl[], enums: EnumDecl[]): Grouped {
  let close: i32 = at + 1;
  let depth: i32 = 1;
  while (close < tokens.len() && depth > 0) {
    if (tokens[close] == "tup") {
      depth = depth + 1;
    } else if (tokens[close] == "put") {
      depth = depth - 1;
    }
    if (depth > 0) {
      close = close + 1;
    }
  }
  let elems: string = "";
  let j: i32 = at + 1;
  while (j < close) {
    let e: Grouped = take_piece(tokens, j, close - j - 1, structs, enums);
    if (elems.len() > 0) {
      elems = elems + ", ";
    }
    elems = elems + e.pieces[0];
    j = e.at;
  }
  return Grouped { pieces: ["(" + elems + ")"], at: close + 1 };
}

function declared_params(name: string, structs: StructDecl[], enums: EnumDecl[]): i32 {
  for sd in structs {
    if (sd.name == name) {
      return sd.type_params.len();
    }
  }
  for ed in enums {
    if (ed.name == name) {
      return ed.type_params.len();
    }
  }
  return 0 - 1;
}

function join_dunder(xs: string[], from: i32, to: i32): string {
  let out: string = "";
  let i: i32 = from;
  while (i < to) {
    if (i > from) {
      out = out + "__";
    }
    out = out + xs[i];
    i = i + 1;
  }
  return out;
}

pub function sanitize_key(s: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < s.len()) {
    let ch: u8 = s[i];
    if (ch == b'[') {
      out = out + "__";
    } else if (ch == b'(') {
      out = out + "tup__";
    } else if (ch == b')') {
      out = out + "__put";
    } else if (ch == b'=' && i + 1 < s.len() && s[i + 1] == b'>') {
      out = out + "__fto__";
      i = i + 1;
    } else if (ch == b']') {} else if (ch == b',') {
      out = out + "__";
    } else if (ch == b';') {
      out = out + "__";
    } else if (ch == b' ') {} else {
      out = out + slice_unchecked(s, i, i + 1);
    }
    i = i + 1;
  }
  return out;
}

function spelling_mentions_tparam(name: string, tparams: string[]): boolean {
  if (name.len() == 0) {
    return false;
  }
  for v in collect_tvars(name, []) {
    if (tp_index(v, tparams) >= 0) {
      return true;
    }
  }
  return false;
}

function bind_unify(pattern: string, concrete: string, tparams: string[], binds: MEnv, funcs: MFns): MEnv {
  if (tp_index(pattern, tparams) >= 0) {
    if (binds.elook(pattern).len() == 0 && concrete.len() > 0) {
      return binds.ebind(pattern, concrete);
    }
    return binds;
  }
  if (type_ends_arr(pattern) && type_ends_arr(concrete)) {
    return bind_unify(slice_unchecked(pattern, 0, pattern.len() - 2), slice_unchecked(concrete, 0, concrete.len() - 2), tparams, binds, funcs);
  }
  if (spelling_is_view(pattern)) {
    let elem: string = array_method_element(concrete);
    if (elem.len() > 0) {
      return bind_unify(array_method_element(pattern), elem, tparams, binds, funcs);
    }
  }
  if (util.is_tuple_type_name(pattern) && slice_unchecked(pattern, pattern.len() - 1, pattern.len()) == ")"
    && util.is_tuple_type_name(concrete) && slice_unchecked(concrete, concrete.len() - 1, concrete.len()) == ")") {
    let tpparts: string[] = split_top_commas(slice_unchecked(pattern, 1, pattern.len() - 1));
    let tcparts: string[] = split_top_commas(slice_unchecked(concrete, 1, concrete.len() - 1));
    if (tpparts.len() == tcparts.len()) {
      let tb: MEnv = binds;
      let tj: i32 = 0;
      while (tj < tpparts.len()) {
        tb = bind_unify(tpparts[tj], tcparts[tj], tparams, tb, funcs);
        tj = tj + 1;
      }
      return tb;
    }
  }
  if (callable_ret_spelling(pattern).len() > 0 && callable_ret_spelling(concrete).len() > 0) {
    let fpp: string[] = callable_param_spellings(pattern);
    let fcp: string[] = callable_param_spellings(concrete);
    if (fpp.len() == fcp.len()) {
      let fb: MEnv = binds;
      let fj: i32 = 0;
      while (fj < fpp.len()) {
        fb = bind_unify(fpp[fj], fcp[fj], tparams, fb, funcs);
        fj = fj + 1;
      }
      return bind_unify(callable_ret_spelling(pattern), callable_ret_spelling(concrete), tparams, fb, funcs);
    }
  }
  let pb: i32 = first_bracket(pattern);
  let cb: i32 = first_bracket(concrete);
  if (pb > 0 && cb > 0 && slice_unchecked(pattern, pattern.len() - 1, pattern.len()) == "]" && slice_unchecked(concrete, concrete.len() - 1, concrete.len()) == "]") {
    if (slice_unchecked(pattern, 0, pb) == slice_unchecked(concrete, 0, cb)) {
      let pparts: string[] = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
      let cparts: string[] = split_top_commas(slice_unchecked(concrete, cb + 1, concrete.len() - 1));
      if (pparts.len() == cparts.len()) {
        let b: MEnv = binds;
        let j: i32 = 0;
        while (j < pparts.len()) {
          b = bind_unify(pparts[j], cparts[j], tparams, b, funcs);
          j = j + 1;
        }
        return b;
      }
    }
  }
  if (pb > 0 && slice_unchecked(pattern, pattern.len() - 1, pattern.len()) == "]" && cb < 0) {
    let pbase: str = slice_unchecked(pattern, 0, pb);
    let mpfx: string = pbase + "__";
    if (concrete.len() > mpfx.len() && util.str_has_prefix(concrete, mpfx)) {
      let pp: string[] = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
      let ckey: str = slice_unchecked(concrete, mpfx.len(), concrete.len());
      let cp: string[] = split_key(ckey + "", pp.len(), funcs.structs, funcs.enums);
      if (pp.len() == cp.len()) {
        let b2: MEnv = binds;
        let j2: i32 = 0;
        while (j2 < pp.len()) {
          b2 = bind_unify(pp[j2], cp[j2], tparams, b2, funcs);
          j2 = j2 + 1;
        }
        return b2;
      }
    }
  }
  return binds;
}

function lambda_ret_of(e: ast.Expr, env: MEnv, funcs: MFns): string {
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.ret_type.len() > 0) {
        return fn_tag_spelling(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types);
      }
      let lenv: MEnv = env;
      let pi: i32 = 0;
      while (pi < lm.params.len()) {
        lenv = lenv.ebind(lm.params[pi].name, lm.params[pi].type_name);
        pi = pi + 1;
      }
      let si: i32 = 0;
      while (si < lm.body.len()) {
        match (lm.body[si]) {
          ast.StmtReturn(r) => {
            return mono_infer(r.value, lenv, funcs);
          },
          _ => {}
        }
        si = si + 1;
      }
      return "";
    },
    ast.ExprIdent(fid) => {
      let et: string = env.elook(fid.name);
      if (et.len() > 0) {
        return me_fn_ret_spelling(et);
      }
      return func_ret_of(funcs.decls, fid.name);
    },
    ast.ExprCall(_) => {
      return callable_ret_spelling(fn_value_spelling(e, env, funcs));
    },
    ast.ExprFieldAccess(_) => {
      return callable_ret_spelling(fn_value_spelling(e, env, funcs));
    },
    _ => {
      return "";
    }
  }
  return "";
}

function infer_inst(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  if (fd.type_params.len() == 0) {
    return "";
  }
  return binds_to_key(fd.type_params, full_ret_binds(fd, args, env, funcs, fd.type_params));
}

function infer_folded_inst(fd: FuncDecl, args: ast.Expr[], type_args: string[], env: MEnv, funcs: MFns): string {
  if (fd.type_params.len() == 0) {
    return "";
  }
  let binds: MEnv = full_ret_binds(fd, args, env, funcs, fd.type_params);
  let skip: i32 = fd.type_params.len() - type_args.len();
  let j: i32 = 0;
  while (skip >= 0 && j < type_args.len()) {
    if (type_args[j].len() > 0) {
      binds = bind_unify(fd.type_params[skip + j], type_args[j], fd.type_params, binds, funcs);
    }
    j = j + 1;
  }
  return binds_to_key(fd.type_params, binds);
}

function explicit_inst_key(fd: FuncDecl, type_args: string[]): string {
  let written: string[] = fd.all_type_params;
  if (written.len() == 0) {
    written = fd.type_params;
  }
  if (fd.type_params.len() == 0 || type_args.len() != written.len()) {
    return "";
  }
  let key: string = "";
  let j: i32 = 0;
  while (j < fd.type_params.len()) {
    let at: i32 = util.index_of_str(written, fd.type_params[j]);
    if (at < 0 || type_args[at].len() == 0) {
      return "";
    }
    if (j > 0) {
      key = key + ";";
    }
    key = key + type_args[at];
    j = j + 1;
  }
  return key;
}

function key_parts(fd: FuncDecl, key: string): string[] {
  if (fd.type_params.len() == 1) {
    return [key];
  }
  return split_inst_key(key);
}

function binds_to_key(tparams: string[], binds: MEnv): string {
  let key: string = "";
  let j: i32 = 0;
  while (j < tparams.len()) {
    let b: string = binds.elook(tparams[j]);
    if (b.len() == 0) {
      return "";
    }
    if (j > 0) {
      key = key + ";";
    }
    key = key + b;
    j = j + 1;
  }
  return key;
}

function infer_inst_ret(fd: FuncDecl, args: ast.Expr[], expected_ret: string, env: MEnv, funcs: MFns): string {
  if (fd.type_params.len() == 0) {
    return "";
  }
  let binds: MEnv = full_ret_binds(fd, args, env, funcs, fd.type_params);
  if (expected_ret.len() > 0) {
    binds = bind_unify(fd.ret_type, expected_ret, fd.type_params, binds, funcs);
  }
  return binds_to_key(fd.type_params, binds);
}

function split_inst_key(s: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b';') {
      out = out.append(slice_unchecked(s, start, i) + "");
      i = i + 1;
      start = i;
      continue;
    }
    i = i + 1;
  }
  out = out.append(slice_unchecked(s, start, s.len()) + "");
  return out;
}

function tv_word_char(c: i32): boolean {
  return c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95;
}

pub function type_str_vars(ty: string, acc: string[]): string[] {
  let out: string[] = acc;
  let i: i32 = 0;
  let n: i32 = ty.len();
  while (i < n) {
    if (tv_word_char(ty[i] as i32)) {
      let start: i32 = i;
      while (i < n && tv_word_char(ty[i] as i32)) {
        i = i + 1;
      }
      let tok: string = slice_unchecked(ty, start, i) + "";
      if (looks_type_var(tok) && !util.has_str(out, tok)) {
        out = out.append(tok);
      }
    } else {
      i = i + 1;
    }
  }
  return out;
}

function lambda_param_types_of(e: ast.Expr, env: MEnv, funcs: MFns): string[] {
  let none: string[] = [];
  match (e) {
    ast.ExprLambda(lm) => {
      let out: string[] = [];
      let pi: i32 = 0;
      while (pi < lm.params.len()) {
        out = out.append(lm.params[pi].type_name);
        pi = pi + 1;
      }
      return out;
    },
    ast.ExprIdent(fid) => {
      let bt: string = env.elook(fid.name);
      if (bt.len() > 0) {
        let br: TypeRef = parse_type_ref(bt);
        if (!ref_is_fn_value(br)) {
          return none;
        }
        let bf: TypeRef = ref_ungroup(br);
        let bout: string[] = [];
        let bi: i32 = 0;
        while (bi + 1 < bf.args.len()) {
          bout = bout.append(render_type_ref(bf.args[bi]));
          bi = bi + 1;
        }
        return bout;
      }
      return func_param_types_of(funcs.decls, fid.name);
    },
    ast.ExprCall(_) => {
      return callable_param_spellings(fn_value_spelling(e, env, funcs));
    },
    ast.ExprFieldAccess(_) => {
      return callable_param_spellings(fn_value_spelling(e, env, funcs));
    },
    _ => {
      return none;
    }
  }
  return none;
}

function fn_value_spelling(e: ast.Expr, env: MEnv, funcs: MFns): string {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (env.elook(id.name).len() > 0) {
        return "";
      }
      for fd in funcs.decls {
        if (fd.name == id.name && fd.receiver_type.len() == 0 && fd.ret_type == "fn" && fd.ret_fn_ret.len() > 0
          && !spelling_mentions_tparam(fd.ret_fn_ret, fd.type_params) && !spelling_mentions_tparam(fd.ret_fn_param_types, fd.type_params)) {
          return "(" + fd.ret_fn_param_types + ") => " + fd.ret_fn_ret;
        }
      }
    }
  }
  if let ast.ExprFieldAccess(fa) = e {
    let owner: InstStruct = inst_struct(mono_infer(fa.obj, env, funcs), funcs);
    if (owner.at >= 0) {
      let sd: StructDecl = funcs.structs[owner.at];
      for f in sd.fields {
        if (f.name == fa.field && f.type_name == "fn" && f.fn_ret.len() > 0) {
          return "(" + subst_ty_join(split_top_commas(f.fn_param_types), ", ", sd.type_params, owner.cts) + ") => " + subst_ty(f.fn_ret, sd.type_params, owner.cts);
        }
      }
    }
  }
  return "";
}

function fn_value_inst_key(fd: FuncDecl, expected: string, funcs: MFns): string {
  let ret: string = callable_ret_spelling(expected);
  let ps: string[] = callable_param_spellings(expected);
  if (ret.len() == 0 || ps.len() != fd.params.len()) {
    return "";
  }
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  let i: i32 = 0;
  while (i < ps.len()) {
    if (type_str_vars(ps[i], []).len() == 0) {
      binds = bind_unify(param_spelling(fd.params[i]), ps[i], fd.type_params, binds, funcs);
    }
    i = i + 1;
  }
  let fret: string = fd.ret_type;
  if (fret == "fn") {
    fret = "(" + fd.ret_fn_param_types + ") => " + fd.ret_fn_ret;
  }
  if (type_str_vars(ret, []).len() == 0) {
    binds = bind_unify(fret, ret, fd.type_params, binds, funcs);
  }
  return binds_to_key(fd.type_params, binds);
}

function param_spelling(p: ast.ParamDecl): string {
  if (p.type_name == "fn") {
    return "(" + p.fn_param_types + ") => " + p.fn_ret;
  }
  return p.type_name;
}

function generic_fn_value_name(e: ast.Expr, env: MEnv, funcs: MFns): string {
  if let ast.ExprIdent(id) = e {
    if (env.elook(id.name).len() == 0 && bg_find(funcs, id.name) >= 0) {
      return id.name;
    }
  }
  if let ast.ExprFieldAccess(fa) = e {
    if let ast.ExprIdent(m) = fa.obj {
      if (bg_find(funcs, m.name + "." + fa.field) >= 0) {
        return m.name + "." + fa.field;
      }
    }
  }
  return "";
}

function mono_fn_value(e: ast.Expr, expected: string, env: MEnv, funcs: MFns, ins: Insts): RExpr {
  let name: string = generic_fn_value_name(e, env, funcs);
  if (name.len() == 0 || expected.len() == 0) {
    return RExpr { rexpr: e, rins: ins };
  }
  let key: string = fn_value_inst_key(funcs.decls[bg_find(funcs, name)], expected, funcs);
  if (key.len() == 0) {
    return RExpr { rexpr: e, rins: ins };
  }
  let cur: Insts = ins.iadd(name, key);
  if let ast.ExprIdent(id) = e {
    return RExpr { rexpr: ast.ExprIdent { ...id, name: name + "__" + sanitize_key(key) }, rins: cur };
  }
  if let ast.ExprFieldAccess(fa) = e {
    return RExpr { rexpr: ast.ExprFieldAccess { ...fa, field: fa.field + "__" + sanitize_key(key) }, rins: cur };
  }
  return RExpr { rexpr: e, rins: ins };
}

function call_param_spellings(c: ast.ExprCall, env: MEnv, funcs: MFns): string[] {
  let none: string[] = [];
  let name: string = "";
  if let ast.ExprIdent(cid) = c.callee {
    if (env.elook(cid.name).len() > 0) {
      return callable_param_spellings(env.elook(cid.name));
    }
    name = cid.name;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    if let ast.ExprIdent(m) = fa.obj {
      name = m.name + "." + fa.field;
    }
    if (!has_free_decl(funcs, name)) {
      return method_param_spellings(c, fa, env, funcs);
    }
  }
  if (name.len() == 0) {
    return none;
  }
  for fd in funcs.decls {
    if (fd.name == name && fd.receiver_type.len() == 0) {
      let out: string[] = [];
      for p in fd.params {
        out = out.append(subst_ty(param_spelling(p), fd.all_type_params, call_bound_vars(fd, c, env, funcs)));
      }
      return out;
    }
  }
  return none;
}

function call_bound_vars(fd: FuncDecl, c: ast.ExprCall, env: MEnv, funcs: MFns): string[] {
  let binds: MEnv = full_ret_binds(fd, c.args, env, funcs, fd.all_type_params);
  let cts: string[] = [];
  for v in fd.all_type_params {
    if (binds.elook(v).len() > 0) {
      cts = cts.append(binds.elook(v));
    } else {
      cts = cts.append(v);
    }
  }
  return cts;
}

function has_free_decl(funcs: MFns, name: string): boolean {
  for fd in funcs.decls {
    if (fd.name == name && fd.receiver_type.len() == 0) {
      return true;
    }
  }
  return false;
}

function method_param_spellings(c: ast.ExprCall, fa: ast.ExprFieldAccess, env: MEnv, funcs: MFns): string[] {
  let none: string[] = [];
  let rt: string = mono_infer(fa.obj, env, funcs);
  if (rt.len() == 0) {
    return none;
  }
  let base: string = strip_struct_base(rt);
  let rvars: string[] = [];
  let rcts: string[] = [];
  let owner: InstStruct = inst_struct(rt, funcs);
  if (owner.at >= 0) {
    base = funcs.structs[owner.at].name;
    rvars = funcs.structs[owner.at].type_params;
    rcts = owner.cts;
  }
  for fd in funcs.decls {
    if (fd.name == fa.field && fd.receiver_name.len() > 0 && strip_struct_base(fd.receiver_type) == base) {
      if (owner.at < 0) {
        rvars = type_str_vars(fd.receiver_type, []);
        let rb: MEnv = bind_unify(fd.receiver_type, rt, rvars, MEnv { mnames: [], mtypes: [] }, funcs);
        for v in rvars {
          if (rb.elook(v).len() == 0) {
            return none;
          }
          rcts = rcts.append(rb.elook(v));
        }
      }
      let out: string[] = [];
      for p in fd.params {
        out = out.append(subst_ty(subst_ty(param_spelling(p), rvars, rcts), fd.all_type_params, call_bound_vars(fd, c, env, funcs)));
      }
      return out;
    }
  }
  return none;
}

function mono_call_args(c: ast.ExprCall, env: MEnv, funcs: MFns, ins: Insts): (ast.Expr[], Insts) {
  let nargs: ast.Expr[] = [];
  let cur: Insts = ins;
  let pspell: string[] = [];
  if (call_args_want_expected(c, env, funcs)) {
    pspell = call_param_spellings(c, env, funcs);
  }
  let i: i32 = 0;
  while (i < c.args.len()) {
    let ra: RExpr = RExpr { rexpr: c.args[i], rins: cur };
    if (i < pspell.len() && arg_wants_expected(c.args[i], env, funcs) && (type_str_vars(pspell[i], []).len() == 0 || generic_fn_value_name(c.args[i], env, funcs).len() > 0)) {
      ra = mono_call_expected(c.args[i], pspell[i], env, funcs, cur);
    } else {
      ra = mono_expr(c.args[i], env, funcs, cur);
    }
    cur = ra.rins;
    nargs = nargs.append(ra.rexpr);
    i = i + 1;
  }
  return (nargs, cur);
}

function call_args_want_expected(c: ast.ExprCall, env: MEnv, funcs: MFns): boolean {
  for a in c.args {
    if (arg_wants_expected(a, env, funcs)) {
      return true;
    }
  }
  return false;
}

function arg_wants_expected(a: ast.Expr, env: MEnv, funcs: MFns): boolean {
  if (generic_fn_value_name(a, env, funcs).len() > 0) {
    return true;
  }
  if let ast.ExprCall(ac) = a {
    if let ast.ExprIdent(cid) = ac.callee {
      return env.elook(cid.name).len() == 0 && bg_find(funcs, cid.name) >= 0;
    }
    if let ast.ExprFieldAccess(fa) = ac.callee {
      if let ast.ExprIdent(m) = fa.obj {
        return bg_find(funcs, m.name + "." + fa.field) >= 0;
      }
    }
  }
  return false;
}

function callable_ret_spelling(t: string): string {
  if (t.len() == 0) {
    return "";
  }
  let r: TypeRef = parse_type_ref(t);
  if (!r.is_fn || r.args.len() == 0) {
    return "";
  }
  return render_type_ref(r.args[r.args.len() - 1]);
}

function callable_param_spellings(t: string): string[] {
  let none: string[] = [];
  if (t.len() == 0) {
    return none;
  }
  let r: TypeRef = parse_type_ref(t);
  if (!r.is_fn) {
    return none;
  }
  let out: string[] = [];
  let i: i32 = 0;
  while (i + 1 < r.args.len()) {
    out = out.append(render_type_ref(r.args[i]));
    i = i + 1;
  }
  return out;
}

function func_param_types_of(decls: FuncDecl[], name: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < decls.len()) {
    if (decls[i].name == name && decls[i].receiver_type.len() == 0) {
      let k: i32 = 0;
      while (k < decls[i].params.len()) {
        out = out.append(decls[i].params[k].type_name);
        k = k + 1;
      }
      return out;
    }
    i = i + 1;
  }
  return out;
}

function full_ret_binds(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns, vars: string[]): MEnv {
  let typed: MEnv = arg_binds(fd, args, env, funcs, vars, MEnv { mnames: [], mtypes: [] }, false);
  return arg_binds(fd, args, env, funcs, vars, bound_binds(fd, typed, funcs), true);
}

function bound_binds(fd: FuncDecl, binds: MEnv, funcs: MFns): MEnv {
  let ns: string[] = binds.mnames;
  let ts: string[] = binds.mtypes;
  let k: i32 = 0;
  while (k < fd.type_params.len() && k < fd.bound_traits.len()) {
    let subject: string = binds.elook(fd.type_params[k]);
    if (subject.len() > 0) {
      for entry in split_plus_bounds(fd.bound_traits[k]) {
        let (n2, t2) = bound_entry_substitutions(entry, subject, funcs.impls, ns, ts);
        ns = n2;
        ts = t2;
      }
    }
    k = k + 1;
  }
  return MEnv { mnames: ns, mtypes: ts };
}

function arg_binds(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns, vars: string[], seed: MEnv, literals: boolean): MEnv {
  let binds: MEnv = seed;
  let i: i32 = 0;
  while (i < fd.params.len()) {
    if (i < args.len() && int_literal_tree(args[i]) == literals) {
      let ct: string = mono_infer(args[i], env, funcs);
      let pattern: string = fd.params[i].type_name;
      if (pattern != "fn" && is_fn_contract_tag(pattern) && fd.params[i].fn_ret.len() > 0) {
        pattern = fn_tag_spelling(pattern, fd.params[i].fn_ret, fd.params[i].fn_param_types);
      }
      if (ct.len() > 0) {
        binds = bind_unify(pattern, ct, vars, binds, funcs);
      } else {
        binds = variant_arg_binds(fd.params[i].type_name, args[i], env, funcs, vars, binds);
      }
      if (fd.params[i].type_name == "fn" && spelling_mentions_tparam(fd.params[i].fn_ret, vars)) {
        let lr: string = lambda_ret_of(args[i], env, funcs);
        if (lr.len() > 0 && type_str_vars(lr, []).len() == 0) {
          binds = bind_unify(fd.params[i].fn_ret, lr, vars, binds, funcs);
        }
      }
      if (fd.params[i].type_name == "fn") {
        let fpts: string[] = split_top_commas(fd.params[i].fn_param_types);
        let lpts: string[] = lambda_param_types_of(args[i], env, funcs);
        let q: i32 = 0;
        while (q < fpts.len()) {
          if (q < lpts.len() && lpts[q].len() > 0 && spelling_mentions_tparam(fpts[q], vars) && type_str_vars(lpts[q], []).len() == 0) {
            binds = bind_unify(fpts[q], lpts[q], vars, binds, funcs);
          }
          q = q + 1;
        }
      }
    }
    i = i + 1;
  }
  return binds;
}

function variant_arg_binds(pattern: string, arg: ast.Expr, env: MEnv, funcs: MFns, vars: string[], binds: MEnv): MEnv {
  if let ast.ExprCall(c) = arg {
    let vname: string = ctor_variant_name(c.callee, funcs.enums, env, funcs);
    if (vname.len() > 0) {
      let owner: i32 = genum_owner_of_variant(funcs.enums, vname);
      if (owner < 0) {
        return builtin_variant_arg_binds(pattern, c, env, funcs, vars, binds);
      }
      let ed: EnumDecl = funcs.enums[owner];
      let own: MEnv = me_variant_binds(ed, vname, c.args, env, funcs.structs, funcs);
      if (str_list_contains(vars, pattern)) {
        let whole: string = bound_spelling(ed.name, ed.type_params, own);
        if (whole.len() == 0) {
          return binds;
        }
        return bind_unify(pattern, whole, vars, binds, funcs);
      }
      let pb: i32 = first_bracket(pattern);
      if (pb <= 0 || slice_unchecked(pattern, pattern.len() - 1, pattern.len()) != "]") {
        return binds;
      }
      if (slice_unchecked(pattern, 0, pb) != ed.name) {
        return binds;
      }
      let pargs: string[] = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
      if (pargs.len() != ed.type_params.len()) {
        return binds;
      }
      let out: MEnv = binds;
      let j: i32 = 0;
      while (j < pargs.len()) {
        let b: string = own.elook(ed.type_params[j]);
        if (b.len() > 0) {
          out = bind_unify(pargs[j], b, vars, out, funcs);
        }
        j = j + 1;
      }
      return out;
    }
  }
  return binds;
}

function builtin_variant_arg_binds(pattern: string, c: ast.ExprCall, env: MEnv, funcs: MFns, vars: string[], binds: MEnv): MEnv {
  if (c.args.len() != 1 || number_literal_tree(c.args[0])) {
    return binds;
  }
  let slot: i32 = 0 - 1;
  let base: string = "";
  if let ast.ExprIdent(cid) = c.callee {
    if (cid.name == "Some") {
      base = "Option";
      slot = 0;
    }
    if (cid.name == "Ok") {
      base = "Result";
      slot = 0;
    }
    if (cid.name == "Err") {
      base = "Result";
      slot = 1;
    }
  }
  let pb: i32 = first_bracket(pattern);
  if (slot < 0 || pb <= 0 || slice_unchecked(pattern, pattern.len() - 1, pattern.len()) != "]") {
    return binds;
  }
  if (slice_unchecked(pattern, 0, pb) != base) {
    return binds;
  }
  let pargs: string[] = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
  if (slot >= pargs.len()) {
    return binds;
  }
  let pt: string = mono_infer(c.args[0], env, funcs);
  if (pt.len() == 0) {
    return binds;
  }
  return bind_unify(strip_ws(pargs[slot]), pt, vars, binds, funcs);
}

function func_ret_of(funcs: FuncDecl[], name: string): string {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && funcs[i].receiver_type.len() == 0) {
      return funcs[i].ret_type;
    }
    i = i + 1;
  }
  return "";
}

function func_param_type_at(funcs: FuncDecl[], name: string, idx: i32): string {
  let at: i32 = free_decl_at(funcs, name);
  if (at < 0 || idx < 0 || idx >= funcs[at].params.len()) {
    return "";
  }
  return funcs[at].params[idx].type_name;
}

function me_method_arg_types(fa: ast.ExprFieldAccess, argc: i32, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: MFns, ins: Insts): string[] {
  let rty: string = me_scrutinee_type(fa.obj, env, enums, structs, funcs, ins);
  if (rty.len() == 0) {
    return [];
  }
  let kv: string[] = me_map_args(rty);
  if (kv.len() == 2) {
    if (fa.field == "insert" || fa.field == "set" || fa.field == "get_or") {
      return kv;
    }
    if (fa.field == "contains" || fa.field == "get" || fa.field == "remove") {
      return [kv[0]];
    }
  }
  let at: i32 = me_method_decl(funcs, rty, fa.field);
  if (at < 0) {
    return [];
  }
  let fd: FuncDecl = funcs.decls[at];
  let out: string[] = [];
  let i: i32 = 0;
  while (i < argc && i < fd.params.len()) {
    out = out.append(me_receiver_subst(fd, rty, fd.params[i].type_name, funcs));
    i = i + 1;
  }
  return out;
}

function me_method_ret_type(rty: string, name: string, funcs: MFns): string {
  let kv: string[] = me_map_args(rty);
  if (kv.len() == 2) {
    if (name == "insert" || name == "set" || name == "cleared" || name == "remove") {
      return rty;
    }
    if (name == "get_or") {
      return kv[1];
    }
    if (name == "get") {
      return "Option[" + kv[1] + "]";
    }
    if (name == "keys") {
      return kv[0] + "[]";
    }
    if (name == "values") {
      return kv[1] + "[]";
    }
  }
  let at: i32 = me_method_decl(funcs, rty, name);
  if (at < 0) {
    return "";
  }
  return me_receiver_subst(funcs.decls[at], rty, funcs.decls[at].ret_type, funcs);
}

function me_map_args(rty: string): string[] {
  let r: TypeRef = parse_type_ref(rty);
  if (r.base != "Map" || r.args.len() != 2 || r.array_depth != 0) {
    return [];
  }
  return [render_type_ref(r.args[0]), render_type_ref(r.args[1])];
}

function me_method_decl(funcs: MFns, rty: string, name: string): i32 {
  let rbase: string = strip_struct_base(rty);
  let i: i32 = 0;
  while (i < funcs.decls.len()) {
    if (funcs.decls[i].name == name && funcs.decls[i].receiver_type.len() > 0 && strip_struct_base(funcs.decls[i].receiver_type) == rbase) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function me_receiver_subst(fd: FuncDecl, rty: string, ty: string, funcs: MFns): string {
  let vars: string[] = fd.all_type_params;
  if (vars.len() == 0) {
    vars = struct_receiver_typevars(fd.receiver_type);
  }
  let binds: MEnv = bind_unify(fd.receiver_type, rty, vars, MEnv { mnames: [], mtypes: [] }, funcs);
  let tps: string[] = [];
  let cts: string[] = [];
  for tp in vars {
    let ct: string = binds.elook(tp);
    if (ct.len() > 0) {
      tps = tps.append(tp);
      cts = cts.append(ct);
    }
  }
  return subst_ty(ty, tps, cts);
}

function call_ret_type(funcs: MFns, name: string, args: ast.Expr[], env: MEnv): string {
  let fi: i32 = 0 - 1;
  let e: i32 = funcs.pix.chain(name);
  while (e >= 0) {
    if (funcs.pix.names[e] == name) {
      fi = funcs.pat[e];
    }
    e = funcs.pix.next[e];
  }
  if (fi < 0) {
    return "";
  }
  return decl_call_ret_type(funcs, funcs.decls[fi], args, env);
}

function decl_call_ret_type(funcs: MFns, fd: FuncDecl, args: ast.Expr[], env: MEnv): string {
  if (fd.type_params.len() == 0) {
    let evars: string[] = type_str_vars(fd.ret_type, []);
    if (evars.len() == 0) {
      return fd.ret_type;
    }
    return resolve_residual_ret(fd, args, env, funcs, fd.ret_type, evars);
  }
  let key: string = infer_inst(fd, args, env, funcs);
  if (key.len() == 0) {
    return "";
  }
  let cts: string[] = [key];
  if (fd.type_params.len() != 1) {
    cts = split_inst_key(key);
  }
  let rt: string = resolve_proj_in_type(subst_ty(fd.ret_type, fd.type_params, cts), funcs.impls);
  let rvars: string[] = type_str_vars(rt, []);
  if (rvars.len() > 0) {
    rt = resolve_residual_ret(fd, args, env, funcs, rt, rvars);
  }
  return rt;
}

function resolve_residual_ret(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns, rt0: string, rvars: string[]): string {
  let fb: MEnv = full_ret_binds(fd, args, env, funcs, rvars);
  let rcts: string[] = [];
  let vi: i32 = 0;
  while (vi < rvars.len()) {
    let bv: string = fb.elook(rvars[vi]);
    if (bv.len() == 0) {
      bv = rvars[vi];
    }
    rcts = rcts.append(bv);
    vi = vi + 1;
  }
  return subst_ty(rt0, rvars, rcts);
}

function assoc_ret_of(funcs: FuncDecl[], tyname: string, method: string): string {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == method && funcs[i].receiver_type == tyname) {
      return funcs[i].ret_type;
    }
    i = i + 1;
  }
  return "";
}

pub function is_hex_lit(text: string): boolean {
  return text.len() > 2 && text[0] as i32 == 48
    && (text[1] as i32 == 120 || text[1] as i32 == 88);
}

function lower_hex_byte(b: i32): i32 {
  if (b >= 65 && b <= 70) {
    return b + 32;
  }
  return b;
}

pub function magnitude_fits(text: string, start: i32, max: string): boolean {
  let i: i32 = start;
  while (i < text.len() && text[i] as i32 == 48) {
    i = i + 1;
  }
  let n: i32 = text.len() - i;
  if (n != max.len()) {
    return n < max.len();
  }
  let k: i32 = 0;
  while (k < n) {
    let tc: i32 = lower_hex_byte(text[i + k] as i32);
    let mc: i32 = max[k] as i32;
    if (tc != mc) {
      return tc < mc;
    }
    k = k + 1;
  }
  return true;
}

pub function literal_is_i64(text: string): boolean {
  let hex: boolean = is_hex_lit(text);
  let start: i32 = 0;
  if (hex) {
    start = 2;
  }
  let m: string = "2147483647";
  if (hex) {
    m = "7fffffff";
  }
  return !magnitude_fits(text, start, m);
}

pub function int_literal_tree(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return !n.is_float && n.suffix.len() == 0 && !is_unit_literal(n);
    },
    ast.ExprUnary(u) => {
      if (u.op == "-" || u.op == "+") {
        return int_literal_tree(u.operand);
      }
      return false;
    },
    ast.ExprBinary(b) => {
      return int_literal_op(b.op) && int_literal_tree(b.left) && int_literal_tree(b.right);
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function int_literal_op(op: string): boolean {
  return op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
    || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"
    || op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

pub function float_literal_tree(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return n.is_float && n.suffix.len() == 0;
    },
    ast.ExprUnary(u) => {
      return (u.op == "-" || u.op == "+") && float_literal_tree(u.operand);
    },
    ast.ExprBinary(b) => {
      if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
        return float_literal_tree(b.left) && float_literal_tree(b.right);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function number_literal_tree(e: ast.Expr): boolean {
  return int_literal_tree(e) || float_literal_tree(e);
}

pub function settle_int_tree(e: ast.Expr, tag: string): ast.Expr {
  match (e) {
    ast.ExprNumber(n) => {
      return ast.ExprNumber { ...n, suffix: tag, is_float: n.is_float || tag == "f32" || tag == "f64" };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { ...u, operand: settle_int_tree(u.operand, tag), ty: tag };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { ...b, left: settle_int_tree(b.left, tag), right: settle_int_tree(b.right, tag), ty: tag };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function recv_method_ret_of(cfa: ast.ExprFieldAccess, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  let rvt: string = mono_infer(cfa.obj, env, funcs);
  if (rvt.len() == 0) {
    return "";
  }
  let concrete: i32 = concrete_array_method_at(funcs, rvt, cfa.field);
  if (concrete >= 0) {
    let call_args: ast.Expr[] = [cfa.obj];
    for arg in args {
      call_args = call_args.append(arg);
    }
    return decl_call_ret_type(funcs, funcs.decls[concrete], call_args, env);
  }
  let mrt: string = assoc_ret_of(funcs.decls, rvt, cfa.field);
  if (mrt.len() == 0) {
    mrt = generic_recv_ret_of(funcs.decls, rvt, cfa.field);
  }
  if (mrt.len() == 0) {
    mrt = clone_recv_ret_of(funcs, rvt, cfa.field);
  }
  if (looks_type_var(mrt)) {
    return "";
  }
  return mrt;
}

function generic_recv_ret_of(funcs: FuncDecl[], tyname: string, method: string): string {
  let recv: TypeRef = parse_type_ref(tyname);
  if (recv.args.len() == 0) {
    return "";
  }
  let base: string = util.base_type_name(tyname);
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == method && funcs[i].receiver_type.len() > 0
      && util.base_type_name(funcs[i].receiver_type) == base) {
      let ns: string[] = [];
      let ts: string[] = [];
      let (n2, t2) = ref_bind(parse_type_ref(funcs[i].receiver_type), recv, [], ns, ts);
      if (n2.len() == 0) {
        return "";
      }
      return subst_ty(funcs[i].ret_type, n2, t2);
    }
    i = i + 1;
  }
  return "";
}

function clone_recv_ret_of(funcs: MFns, tyname: string, method: string): string {
  let generic: StructDecl[] = [];
  for sd in funcs.structs {
    if (sd.type_params.len() > 0) {
      generic = generic.append(sd);
    }
  }
  for sd in generic {
    if (is_clone_of(tyname, sd.name)) {
      let key: string = slice_unchecked(tyname, sd.name.len() + 2, tyname.len()) + "";
      let args: string[] = split_key(key, sd.type_params.len(), funcs.structs, funcs.enums);
      if (args.len() != sd.type_params.len()) {
        return "";
      }
      let spelled: string = sd.name + "[";
      let k: i32 = 0;
      while (k < args.len()) {
        if (k > 0) {
          spelled = spelled + ", ";
        }
        spelled = spelled + args[k];
        k = k + 1;
      }
      let ret: string = generic_recv_ret_of(funcs.decls, spelled + "]", method);
      if (ret.len() == 0) {
        return "";
      }
      return mg_ty(ret, generic, Insts { inames: [], itypes: [], iargs: [] }).ty;
    }
  }
  return "";
}

function fold_base(t: string, method: string, funcs: MFns): string {
  let g: string = generic_base(t, funcs);
  if (g.len() > 0 || first_bracket(t) >= 0 || t.len() == 0) {
    return g;
  }
  if (bg_find(funcs, smm_name(t, method)) >= 0) {
    return t;
  }
  return "";
}

function generic_base(t: string, funcs: MFns): string {
  if (first_bracket(t) > 0 && slice_unchecked(t, t.len() - 1, t.len()) == "]") {
    return strip_struct_base(t);
  }
  let owner: InstStruct = inst_struct(t, funcs);
  if (owner.at >= 0 && funcs.structs[owner.at].type_params.len() > 0) {
    return funcs.structs[owner.at].name;
  }
  return "";
}

function stamped_type(tag: string): string {
  if (tag == "i32" || tag == "i64" || tag == "u8" || tag == "u32" || tag == "u64" || tag == "usize"
    || tag == "f32" || tag == "f64" || tag == "string" || tag == "boolean") {
    return tag;
  }
  let elem: string = array_method_element(tag);
  if (elem.len() > 0 && stamped_type(elem).len() > 0) {
    return tag;
  }
  return "";
}

function mono_infer(e: ast.Expr, env: MEnv, funcs: MFns): string {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return "f64";
      }
      if (n.suffix.len() > 0) {
        return n.suffix;
      }
      if (literal_is_i64(n.text)) {
        return "i64";
      }
      return "i32";
    },
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprBool(_) => {
      return "boolean";
    },
    ast.ExprArray(a) => {
      if (a.elements.len() == 0) {
        return "";
      }
      let et: string = mono_infer(a.elements[0], env, funcs);
      if (et.len() == 0) {
        return "";
      }
      if (number_literal_tree(a.elements[0])) {
        for el in a.elements {
          if (!number_literal_tree(el)) {
            let st: string = mono_infer(el, env, funcs);
            if (is_scalar_ret_name(st) && st != "boolean") {
              return st + "[]";
            }
          }
        }
      }
      return et + "[]";
    },
    ast.ExprIdent(id) => {
      return env.elook(id.name);
    },
    ast.ExprSlice(sl) => {
      let source: string = mono_infer(sl.array, env, funcs);
      if (source == "string" || source == "str") {
        return "Option[str]";
      }
      let elem: string = array_method_element(source);
      if (elem.len() > 0) {
        return "[" + elem + "]";
      }
      return "";
    },
    ast.ExprLambda(lm) => {
      let lps: string = "";
      let li: i32 = 0;
      while (li < lm.params.len()) {
        if (lm.params[li].type_name.len() == 0) {
          return "";
        }
        if (li > 0) {
          lps = lps + ", ";
        }
        lps = lps + lm.params[li].type_name;
        li = li + 1;
      }
      let lret: string = lambda_ret_of(e, env, funcs);
      if (lret.len() == 0) {
        return "";
      }
      return "(" + lps + ") => " + lret;
    },
    ast.ExprBinary(b) => {
      if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "&&" || b.op == "||") {
        return "boolean";
      }
      return mono_infer(b.left, env, funcs);
    },
    ast.ExprUnary(u) => {
      if (u.op == "!") {
        return "boolean";
      }
      if (is_cast_op(u.op)) {
        return slice_unchecked(u.op, 3, u.op.len()) + "";
      }
      if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
        return "Option[" + slice_unchecked(u.op, 4, u.op.len()) + "]";
      }
      return mono_infer(u.operand, env, funcs);
    },
    ast.ExprStructLit(sl) => {
      return struct_lit_spelling(sl, env, funcs);
    },
    ast.ExprTuple(tu) => {
      let inner: string = "";
      let ti: i32 = 0;
      while (ti < tu.elements.len()) {
        let et: string = mono_infer(tu.elements[ti], env, funcs);
        if (et.len() == 0) {
          return "";
        }
        if (ti > 0) {
          inner = inner + ", ";
        }
        inner = inner + et;
        ti = ti + 1;
      }
      return "(" + inner + ")";
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (c.type_args.len() > 0) {
            let xbi: i32 = bg_find(funcs, cid.name);
            if (xbi >= 0) {
              let xkey: string = explicit_inst_key(funcs.decls[xbi], c.type_args);
              if (xkey.len() > 0) {
                return subst_ty(funcs.decls[xbi].ret_type, funcs.decls[xbi].type_params, key_parts(funcs.decls[xbi], xkey));
              }
            }
          }
          let crt: string = call_ret_type(funcs, cid.name, c.args, env);
          if (crt.len() == 0) {
            crt = func_ret_of(funcs.decls, cid.name);
          }
          if (crt.len() == 0) {
            crt = fn_spelling_ret(env.elook(cid.name));
          }
          if (crt.len() == 0 || hides_bare_var(crt, funcs)) {
            return stamped_type(c.ty);
          }
          return crt;
        },
        ast.ExprFieldAccess(cfa) => {
          if ((cfa.field == "to_string" || cfa.field == "to_debug") && c.args.len() == 0) {
            return "string";
          }
          if (cfa.field == "append" && c.args.len() == 1 || cfa.field == "with" && c.args.len() == 2) {
            let brt: string = mono_infer(cfa.obj, env, funcs);
            if (array_method_element(brt).len() > 0) {
              return brt;
            }
          }
          let amgi: i32 = bg_find(funcs, "__arrm_" + cfa.field);
          let vmgi: i32 = bg_find(funcs, "__viewm_" + cfa.field);
          if (amgi >= 0 || vmgi >= 0) {
            let recvt: string = mono_infer(cfa.obj, env, funcs);
            if (spelling_is_view(recvt)) {
              amgi = vmgi;
            }
            let el: string = array_method_element(recvt);
            if (amgi >= 0 && el.len() > 0) {
              let amrt: string = subst_ty(funcs.decls[amgi].ret_type, funcs.decls[amgi].type_params, [el + ""]);
              let amvars: string[] = type_str_vars(amrt, []);
              if (amvars.len() > 0) {
                let amargs: ast.Expr[] = [cfa.obj];
                let amk: i32 = 0;
                while (amk < c.args.len()) {
                  amargs = amargs.append(c.args[amk]);
                  amk = amk + 1;
                }
                amrt = resolve_residual_ret(funcs.decls[amgi], amargs, env, funcs, amrt, amvars);
              }
              return amrt;
            }
          }
          let mmrt: string = mapm_ret_of(cfa, c.args, env, funcs);
          if (mmrt.len() > 0) {
            return mmrt;
          }
          let srt: string = "";
          if (smm_any(funcs, cfa.field)) {
            srt = mono_infer(cfa.obj, env, funcs);
          }
          if (fold_base(srt, cfa.field, funcs).len() > 0) {
            let sgi: i32 = bg_find(funcs, smm_name(fold_base(srt, cfa.field, funcs), cfa.field));
            if (sgi >= 0) {
              let sargs: ast.Expr[] = [cfa.obj];
              let sk: i32 = 0;
              while (sk < c.args.len()) {
                sargs = sargs.append(c.args[sk]);
                sk = sk + 1;
              }
              let skey: string = infer_inst(funcs.decls[sgi], sargs, env, funcs);
              if (skey.len() > 0) {
                return subst_ty(funcs.decls[sgi].ret_type, funcs.decls[sgi].type_params, split_inst_key(skey));
              }
            }
          }
          let mrt: string = recv_method_ret_of(cfa, c.args, env, funcs);
          if (mrt.len() > 0) {
            return mrt;
          }
          match (cfa.obj) {
            ast.ExprIdent(oid) => {
              let qrt: string = call_ret_type(funcs, oid.name + "." + cfa.field, c.args, env);
              if (qrt.len() > 0) {
                return qrt;
              }
              let art: string = assoc_ret_of(funcs.decls, oid.name, cfa.field);
              if (art.len() > 0) {
                return art;
              }
            },
            _ => {}
          }
          return stamped_type(c.ty);
        },
        ast.ExprLambda(lm) => {
          if (!mono_ty_mentions_var(lm.ret_type)) {
            return lm.ret_type;
          }
          return "";
        },
        _ => {
          return stamped_type(c.ty);
        }
      }
      return "";
    },
    ast.ExprIndex(ix) => {
      let at: string = mono_infer(ix.array, env, funcs);
      let el: string = array_method_element(at);
      if (el.len() > 0) {
        if (hides_bare_var(el, funcs)) {
          return "";
        }
        return el;
      }
      return stamped_type(ix.ty);
    },
    ast.ExprFieldAccess(fa) => {
      let ot: string = mono_infer(fa.obj, env, funcs);
      if (ot.len() == 0) {
        return "";
      }
      if (util.is_all_digits(fa.field) && util.is_tuple_type_name(ot)) {
        let elems: string[] = split_top_commas(slice_unchecked(ot, 1, ot.len() - 1) + "");
        let k: i32 = util.digits_to_i32(fa.field);
        if (k >= elems.len() || hides_var(elems[k], funcs)) {
          return "";
        }
        return elems[k];
      }
      if (hides_var(ot, funcs)) {
        return "";
      }
      let ft: string = struct_field_ty_inst(ot, fa.field, funcs);
      if (hides_var(ft, funcs)) {
        return "";
      }
      return ft;
    },
    _ => {
      return "";
    }
  }
  return "";
}

function hides_var(t: string, funcs: MFns): boolean {
  return !funcs.keep_vars && mono_ty_mentions_var(t);
}

function hides_bare_var(t: string, funcs: MFns): boolean {
  return !funcs.keep_vars && looks_type_var(t);
}

function mono_expr(e: ast.Expr, env: MEnv, funcs: MFns, ins: Insts): RExpr {
  match (e) {
    ast.ExprBinary(b) => {
      let l: RExpr = mono_expr(b.left, env, funcs, ins);
      let r: RExpr = mono_expr(b.right, env, funcs, l.rins);
      return RExpr { rexpr: ast.ExprBinary { op: b.op, left: l.rexpr, right: r.rexpr, line: b.line, col: b.col, ty: b.ty }, rins: r.rins };
    },
    ast.ExprUnary(u) => {
      let o: RExpr = mono_expr(u.operand, env, funcs, ins);
      return RExpr { rexpr: ast.ExprUnary { op: u.op, operand: o.rexpr, line: u.line, col: u.col, ty: u.ty }, rins: o.rins };
    },
    ast.ExprCall(c) => {
      let (nargs, cur) = mono_call_args(c, env, funcs, ins);
      match (c.callee) {
        ast.ExprIdent(cid) => {
          let bi: i32 = bg_find(funcs, cid.name);
          if (bi >= 0) {
            let ct: string = explicit_inst_key(funcs.decls[bi], c.type_args);
            if (ct.len() == 0) {
              ct = infer_inst(funcs.decls[bi], c.args, env, funcs);
            }
            if (ct.len() > 0) {
              let mang: string = cid.name + "__" + sanitize_key(ct);
              cur = cur.iadd(cid.name, ct);
              return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: mang, line: cid.line, col: cid.col, ty: cid.ty }, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: cur };
            }
          }
        },
        ast.ExprFieldAccess(fac) => {
          match (fac.obj) {
            ast.ExprIdent(modid) => {
              let qn: string = modid.name + "." + fac.field;
              let bi2: i32 = bg_find(funcs, qn);
              if (bi2 >= 0) {
                let ct2: string = explicit_inst_key(funcs.decls[bi2], c.type_args);
                if (ct2.len() == 0) {
                  ct2 = infer_inst(funcs.decls[bi2], c.args, env, funcs);
                }
                if (ct2.len() > 0) {
                  cur = cur.iadd(qn, ct2);
                  return RExpr { rexpr: ast.ExprCall { callee: ast.ExprFieldAccess { ...fac, field: fac.field + "__" + sanitize_key(ct2) }, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: cur };
                }
              }
            },
            _ => {}
          }
          if (funcs.array_concrete.len() > 0) {
            let concrete: i32 = concrete_array_method_at(funcs, mono_infer(fac.obj, env, funcs), fac.field);
            if (concrete >= 0) {
              let receiver: RExpr = mono_expr(fac.obj, env, funcs, cur);
              let args: ast.Expr[] = [receiver.rexpr];
              for arg in nargs {
                args = args.append(arg);
              }
              let name: string = funcs.decls[concrete].name;
              let instances: Insts = receiver.rins;
              let bound: boolean = true;
              if (funcs.decls[concrete].type_params.len() > 0) {
                let raw: ast.Expr[] = [fac.obj];
                for arg in c.args {
                  raw = raw.append(arg);
                }
                let key: string = explicit_inst_key(funcs.decls[concrete], c.type_args);
                if (key.len() == 0) {
                  key = infer_inst(funcs.decls[concrete], raw, env, funcs);
                }
                if (key.len() > 0) {
                  instances = instances.iadd(name, key);
                  name = name + "__" + sanitize_key(key);
                } else {
                  bound = false;
                }
              }
              if (bound) {
                return RExpr { rexpr: ast.ExprCall { ...c, callee: ast.ExprIdent { name: name, line: fac.line, col: fac.col, ty: "" }, args: args }, rins: instances };
              }
            }
          }
          let amn: string = "__arrm_" + fac.field;
          let amg: i32 = bg_find(funcs, amn);
          let vmg: i32 = bg_find(funcs, "__viewm_" + fac.field);
          if (amg >= 0 || vmg >= 0) {
            let rty: string = mono_infer(fac.obj, env, funcs);
            if (spelling_is_view(rty)) {
              amn = "__viewm_" + fac.field;
              amg = vmg;
            }
            if (amg >= 0 && array_method_element(rty).len() > 0) {
              let raw: ast.Expr[] = [fac.obj];
              let rk: i32 = 0;
              while (rk < c.args.len()) {
                raw = raw.append(c.args[rk]);
                rk = rk + 1;
              }
              let ct3: string = infer_folded_inst(funcs.decls[amg], raw, c.type_args, env, funcs);
              if (ct3.len() > 0) {
                return folded_array_call(amn, ct3, c, fac, raw, env, funcs, ins);
              }
            }
          }
          let mmn: string = "__mapm_" + fac.field;
          let mmg: i32 = bg_find(funcs, mmn);
          if (mmg >= 0) {
            let mrty: string = mono_infer(fac.obj, env, funcs);
            if (mrty.len() >= 4 && slice_unchecked(mrty, 0, 4) == "Map[") {
              let mraw: ast.Expr[] = [fac.obj];
              let mrk: i32 = 0;
              while (mrk < c.args.len()) {
                mraw = mraw.append(c.args[mrk]);
                mrk = mrk + 1;
              }
              let mct: string = infer_folded_inst(funcs.decls[mmg], mraw, c.type_args, env, funcs);
              if (mct.len() > 0) {
                let mro: RExpr = mono_expr(fac.obj, env, funcs, cur);
                cur = mro.rins;
                let mfolded: ast.Expr[] = [mro.rexpr];
                let mfk: i32 = 0;
                while (mfk < nargs.len()) {
                  mfolded = mfolded.append(nargs[mfk]);
                  mfk = mfk + 1;
                }
                cur = cur.iadd(mmn, mct);
                return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: mmn + "__" + sanitize_key(mct), line: fac.line, col: fac.col, ty: "" }, args: mfolded, line: c.line, col: c.col, type_args: [], ty: c.ty }, rins: cur };
              }
            }
          }
          let srty: string = "";
          if (smm_any(funcs, fac.field)) {
            srty = mono_infer(fac.obj, env, funcs);
          }
          if (fold_base(srty, fac.field, funcs).len() > 0) {
            let smn: string = smm_name(fold_base(srty, fac.field, funcs), fac.field);
            let smg: i32 = bg_find(funcs, smn);
            if (smg >= 0) {
              let sraw: ast.Expr[] = [fac.obj];
              let srk: i32 = 0;
              while (srk < c.args.len()) {
                sraw = sraw.append(c.args[srk]);
                srk = srk + 1;
              }
              let sct: string = infer_folded_inst(funcs.decls[smg], sraw, c.type_args, env, funcs);
              if (sct.len() > 0) {
                let sro: RExpr = mono_expr(fac.obj, env, funcs, cur);
                cur = sro.rins;
                let sfolded: ast.Expr[] = [sro.rexpr];
                let sfk: i32 = 0;
                while (sfk < nargs.len()) {
                  sfolded = sfolded.append(nargs[sfk]);
                  sfk = sfk + 1;
                }
                cur = cur.iadd(smn, sct);
                return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: smn + "__" + sanitize_key(sct), line: fac.line, col: fac.col, ty: "" }, args: sfolded, line: c.line, col: c.col, type_args: [], ty: c.ty }, rins: cur };
              }
            }
          }
        },
        _ => {}
      }
      let rc: RExpr = mono_expr(c.callee, env, funcs, cur);
      return RExpr { rexpr: ast.ExprCall { callee: rc.rexpr, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: rc.rins };
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < a.elements.len()) {
        let re: RExpr = mono_expr(a.elements[i], env, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprArray { ...a, elements: els }, rins: cur };
    },
    ast.ExprTuple(t) => {
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < t.elements.len()) {
        let re: RExpr = mono_expr(t.elements[i], env, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprTuple { elements: els, line: t.line, col: t.col }, rins: cur };
    },
    ast.ExprIndex(ix) => {
      let ar: RExpr = mono_expr(ix.array, env, funcs, ins);
      let idx: RExpr = mono_expr(ix.index, env, funcs, ar.rins);
      return RExpr { rexpr: ast.ExprIndex { array: ar.rexpr, index: idx.rexpr, unchecked: false, ty: ix.ty, line: ix.line, col: ix.col }, rins: idx.rins };
    },
    ast.ExprSlice(sl) => {
      let ar: RExpr = mono_expr(sl.array, env, funcs, ins);
      let st: RExpr = mono_expr(sl.start, env, funcs, ar.rins);
      let en: RExpr = mono_expr(sl.end, env, funcs, st.rins);
      return RExpr { rexpr: ast.ExprSlice { ...sl, array: ar.rexpr, start: st.rexpr, end: en.rexpr }, rins: en.rins };
    },
    ast.ExprFieldAccess(fa) => {
      let o: RExpr = mono_expr(fa.obj, env, funcs, ins);
      return RExpr { rexpr: ast.ExprFieldAccess { ...fa, obj: o.rexpr }, rins: o.rins };
    },
    ast.ExprStructLit(s) => {
      let vals: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < s.field_values.len()) {
        let rv: RExpr = mono_call_expected(s.field_values[i], lit_field_spelling(funcs, s.type_name, s.written, s.field_names[i]), env, funcs, cur);
        cur = rv.rins;
        vals = vals.append(rv.rexpr);
        i = i + 1;
      }
      let rb: RExpr = mono_expr(s.base, env, funcs, cur);
      return RExpr { rexpr: ast.ExprStructLit { ...s, field_values: vals, base: rb.rexpr }, rins: rb.rins };
    },
    ast.ExprLambda(lm) => {
      let bodyr: RStmts = mono_stmts(lm.body, bind_params(env, lm.params), funcs, ins, "");
      return RExpr { rexpr: ast.ExprLambda { ...lm, body: bodyr.rstmts }, rins: bodyr.rins3 };
    },
    _ => {
      return RExpr { rexpr: e, rins: ins };
    }
  }
  return RExpr { rexpr: e, rins: ins };
}

function mono_call_expected(e: ast.Expr, expected: string, env: MEnv, funcs: MFns, ins: Insts): RExpr {
  if (generic_fn_value_name(e, env, funcs).len() > 0) {
    return mono_fn_value(e, expected, env, funcs, ins);
  }
  if (expected.len() > 0) {
    match (e) {
      ast.ExprCall(c) => {
        match (c.callee) {
          ast.ExprIdent(cid) => {
            let bi: i32 = bg_find(funcs, cid.name);
            if (bi >= 0) {
              let key: string = explicit_inst_key(funcs.decls[bi], c.type_args);
              if (key.len() == 0) {
                key = infer_inst_ret(funcs.decls[bi], c.args, expected, env, funcs);
              }
              if (key.len() > 0) {
                let (nargs, cur) = mono_call_args(c, env, funcs, ins);
                let mang: string = cid.name + "__" + sanitize_key(key);
                cur = cur.iadd(cid.name, key);
                return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: mang, line: cid.line, col: cid.col, ty: cid.ty }, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: cur };
              }
            }
          },
          ast.ExprFieldAccess(fac) => {
            match (fac.obj) {
              ast.ExprIdent(modid) => {
                let qn: string = modid.name + "." + fac.field;
                let bq: i32 = bg_find(funcs, qn);
                if (bq >= 0) {
                  let qkey: string = explicit_inst_key(funcs.decls[bq], c.type_args);
                  if (qkey.len() == 0) {
                    qkey = infer_inst_ret(funcs.decls[bq], c.args, expected, env, funcs);
                  }
                  if (qkey.len() > 0) {
                    let (qargs, qcur) = mono_call_args(c, env, funcs, ins);
                    qcur = qcur.iadd(qn, qkey);
                    return RExpr { rexpr: ast.ExprCall { callee: ast.ExprFieldAccess { ...fac, field: fac.field + "__" + sanitize_key(qkey) }, args: qargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: qcur };
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
  return mono_expr(e, env, funcs, ins);
}

function inserted_map(cfa: ast.ExprFieldAccess, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  let rt: string = mono_infer(cfa.obj, env, funcs);
  if (me_map_args(rt).len() == 2) {
    return rt;
  }
  if (!map_literal_chain(cfa.obj)) {
    return "";
  }
  let kt: string = mono_infer(args[0], env, funcs);
  let vt: string = mono_infer(args[1], env, funcs);
  if (kt.len() == 0 || vt.len() == 0) {
    return "";
  }
  return "Map[" + kt + ", " + vt + "]";
}

function map_literal_chain(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      return id.name == "map_new" || id.name == "__map_new_i32";
    }
    if let ast.ExprFieldAccess(fa) = c.callee {
      return fa.field == "insert" && map_literal_chain(fa.obj);
    }
  }
  return false;
}

function mapm_ret_of(cfa: ast.ExprFieldAccess, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  if (cfa.field == "insert" && args.len() == 2) {
    return inserted_map(cfa, args, env, funcs);
  }
  let gi: i32 = bg_find(funcs, "__mapm_" + cfa.field);
  let snapshot: boolean = args.len() == 0 && (cfa.field == "keys" || cfa.field == "values");
  if (gi < 0 && !snapshot) {
    return "";
  }
  let rt: string = mono_infer(cfa.obj, env, funcs);
  if (rt.len() < 4 || slice_unchecked(rt, 0, 4) != "Map[") {
    return "";
  }
  if (gi < 0) {
    let kv: string[] = type_args_of(rt);
    if (kv.len() != 2) {
      return "";
    }
    if (cfa.field == "keys") {
      return kv[0] + "[]";
    }
    return kv[1] + "[]";
  }
  let all: ast.Expr[] = [cfa.obj];
  for a in args {
    all = all.append(a);
  }
  let key: string = infer_inst(funcs.decls[gi], all, env, funcs);
  if (key.len() == 0) {
    return "";
  }
  return subst_ty(funcs.decls[gi].ret_type, funcs.decls[gi].type_params, split_inst_key(key));
}

function mono_ty_mentions_var(t: string): boolean {
  let none: string[] = [];
  return type_str_vars(t, none).len() > 0;
}

function mono_variant_payload_ty(sty: string, vname: string, fns: MFns): string {
  if (hides_var(sty, fns)) {
    return "";
  }
  let bare: string = pat_variant_bare(vname);
  let n: i32 = sty.len();
  if (n >= 8 && slice_unchecked(sty, 0, 7) == "Option[" && sty[n - 1] == b']') {
    if (bare == "Some") {
      return strip_ws(slice_unchecked(sty, 7, n - 1) + "");
    }
    return "";
  }
  if (n >= 8 && slice_unchecked(sty, 0, 7) == "Result[" && sty[n - 1] == b']') {
    let parts: string[] = split_top_commas(slice_unchecked(sty, 7, n - 1) + "");
    if (parts.len() != 2) {
      return "";
    }
    if (bare == "Ok") {
      return strip_ws(parts[0]);
    }
    if (bare == "Err") {
      return strip_ws(parts[1]);
    }
  }
  return "";
}

function mono_arm_env(env: MEnv, pat: ast.Pattern, sty: string, funcs: MFns): MEnv {
  let aenv: MEnv = env;
  match (pat) {
    ast.PatVariant(pv) => {
      let ftys: string[] = mono_variant_field_tys(sty, pv.type_name, funcs);
      if (pv.binding.len() > 0 && pv.binding != "_") {
        let bty: string = mono_variant_payload_ty(sty, pv.type_name, funcs);
        if (bty.len() == 0 && ftys.len() > 0) {
          bty = ftys[0];
        }
        aenv = aenv.ebind(pv.binding, bty);
      }
      let xbi: i32 = 0;
      while (xbi < pv.extra_bindings.len()) {
        if (pv.extra_bindings[xbi].len() > 0 && pv.extra_bindings[xbi] != "_") {
          let xty: string = "";
          if (xbi + 1 < ftys.len()) {
            xty = ftys[xbi + 1];
          }
          aenv = aenv.ebind(pv.extra_bindings[xbi], xty);
        }
        xbi = xbi + 1;
      }
      if (pv.at_binding.len() > 0) {
        let aty: string = sty;
        if (hides_var(aty, funcs)) {
          aty = "";
        }
        aenv = aenv.ebind(pv.at_binding, aty);
      }
    },
    _ => {}
  }
  return aenv;
}

function pat_variant_bare(vname: string): string {
  let bare: string = vname;
  let di: i32 = 0;
  while (di < vname.len()) {
    if (vname[di] == b'.') {
      bare = slice_unchecked(vname, di + 1, vname.len()) + "";
    }
    di = di + 1;
  }
  return bare;
}

function type_args_of(ty: string): string[] {
  let out: string[] = [];
  let lb: i32 = first_bracket(ty);
  if (lb <= 0 || slice_unchecked(ty, ty.len() - 1, ty.len()) != "]") {
    return out;
  }
  let parts: string[] = split_top_commas(slice_unchecked(ty, lb + 1, ty.len() - 1));
  let i: i32 = 0;
  while (i < parts.len()) {
    out = out.append(strip_ws(parts[i]));
    i = i + 1;
  }
  return out;
}

function mono_variant_field_tys(sty: string, vname: string, fns: MFns): string[] {
  let none: string[] = [];
  if (sty.len() == 0 || hides_var(sty, fns)) {
    return none;
  }
  let base: string = strip_struct_base(sty);
  let ei: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < fns.enums.len()) {
    if (fns.enums[i].name == base) {
      ei = i;
      i = fns.enums.len();
    } else {
      i = i + 1;
    }
  }
  if (ei < 0) {
    return none;
  }
  let ed: EnumDecl = fns.enums[ei];
  let cts: string[] = type_args_of(sty);
  if (cts.len() != ed.type_params.len()) {
    return none;
  }
  let vi: i32 = variant_struct_index(fns.structs, pat_variant_bare(vname), ed.name);
  if (vi < 0) {
    return none;
  }
  let fields: StructFieldDecl[] = fns.structs[vi].fields;
  let out: string[] = [];
  let fi: i32 = 0;
  while (fi < fields.len()) {
    out = out.append(subst_ty(fields[fi].type_name, ed.type_params, cts));
    fi = fi + 1;
  }
  return out;
}

function struct_field_ty_inst(ot: string, fname: string, funcs: MFns): string {
  let owner: InstStruct = inst_struct(ot, funcs);
  let structs: StructDecl[] = funcs.structs;
  if (owner.at < 0) {
    return "";
  }
  for f in structs[owner.at].fields {
    if (f.name == fname) {
      return subst_ty(field_spelling(f), structs[owner.at].type_params, owner.cts);
    }
  }
  return "";
}

function field_spelling(f: StructFieldDecl): string {
  if (f.type_name == "fn") {
    return "(" + f.fn_param_types + ") => " + f.fn_ret;
  }
  return f.type_name;
}

struct InstStruct { at: i32, cts: string[] }

function inst_struct(ot: string, funcs: MFns): InstStruct {
  let cts: string[] = type_args_of(ot);
  let si: i32 = first_struct_named(funcs, strip_struct_base(ot), false);
  if (first_bracket(ot) < 0) {
    let k: i32 = 1;
    while (k + 2 < ot.len() && si != 0) {
      if (ot[k] == b'_' && ot[k + 1] == b'_') {
        let gi: i32 = first_struct_named(funcs, slice_unchecked(ot, 0, k) + "", true);
        if (gi >= 0 && (si < 0 || gi < si)) {
          si = gi;
          cts = split_key(slice_unchecked(ot, k + 2, ot.len()) + "", funcs.structs[gi].type_params.len(), funcs.structs, funcs.enums);
        }
      }
      k = k + 1;
    }
  }
  if (si < 0 || cts.len() != funcs.structs[si].type_params.len()) {
    return InstStruct { at: 0 - 1, cts: [] };
  }
  return InstStruct { at: si, cts: cts };
}

function first_struct_named(funcs: MFns, name: string, generic: boolean): i32 {
  let i: i32 = funcs.snames.chain(name);
  while (i >= 0) {
    let sd: StructDecl = funcs.structs[i];
    if (funcs.snames.names[i] == name && sd.enum_owner.len() == 0 && (!generic || sd.type_params.len() > 0)) {
      return i;
    }
    i = funcs.snames.next[i];
  }
  return 0 - 1;
}

function menv_bind_destructure(env: MEnv, names: string, ty: string): MEnv {
  let parts: string[] = split_top_commas(names);
  if (parts.len() <= 1) {
    return env;
  }
  if (ty.len() < 2 || slice_unchecked(ty, 0, 1) != "(" || slice_unchecked(ty, ty.len() - 1, ty.len()) != ")") {
    return env;
  }
  let tys: string[] = split_top_commas(slice_unchecked(ty, 1, ty.len() - 1));
  if (tys.len() != parts.len()) {
    return env;
  }
  let e: MEnv = env;
  let i: i32 = 0;
  while (i < parts.len()) {
    let nm: string = strip_ws(parts[i]);
    let et: string = strip_ws(tys[i]);
    if (nm.len() > 1 && slice_unchecked(nm, 0, 1) == "(") {
      e = menv_bind_destructure(e, slice_unchecked(nm, 1, nm.len() - 1) + "", et);
    } else if (nm.len() > 0) {
      e = e.ebind(nm, et);
    }
    i = i + 1;
  }
  return e;
}

function for_elem_spelling(ity: string, names: string): string {
  let ety: string = "";
  let kv: string[] = me_map_args(ity);
  if (kv.len() == 2 && split_top_commas(names).len() == 2) {
    ety = "(" + kv[0] + ", " + kv[1] + ")";
  } else if (type_ends_arr(ity)) {
    ety = elem_spelling(ity);
  }
  if (mono_ty_mentions_var(ety)) {
    return "";
  }
  return ety;
}

function mono_stmt(st: ast.Stmt, env: MEnv, funcs: MFns, ins: Insts, ret_ty: string): RStmtOne {
  match (st) {
    ast.StmtVar(v) => {
      let iv: RExpr = mono_call_expected(v.init, fn_tag_spelling(v.type_name, v.fn_ret, v.fn_param_types), env, funcs, ins);
      let ty: string = fn_tag_spelling(v.type_name, v.fn_ret, v.fn_param_types);
      if (ty.len() == 0) {
        ty = mono_infer(v.init, env, funcs);
      }
      return RStmtOne { rstmt: ast.StmtVar { name: v.name, type_name: v.type_name, init: iv.rexpr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }, renv: menv_bind_destructure(env.ebind(v.name, ty), v.name, ty), rins2: iv.rins };
    },
    ast.StmtReturn(r) => {
      let rv: RExpr = mono_call_expected(r.value, ret_ty, env, funcs, ins);
      return RStmtOne { rstmt: ast.StmtReturn { value: rv.rexpr, line: r.line, col: r.col }, renv: env, rins2: rv.rins };
    },
    ast.StmtExpr(x) => {
      let xv: RExpr = mono_expr(x.value, env, funcs, ins);
      return RStmtOne { rstmt: ast.StmtExpr { value: xv.rexpr, line: 0 }, renv: env, rins2: xv.rins };
    },
    ast.StmtAssign(a) => {
      let av: RExpr = mono_call_expected(a.value, env.elook(a.target), env, funcs, ins);
      return RStmtOne { rstmt: ast.StmtAssign { target: a.target, value: av.rexpr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, renv: env, rins2: av.rins };
    },
    ast.StmtIf(f) => {
      let cv: RExpr = mono_expr(f.cond, env, funcs, ins);
      let tb: RStmts = mono_stmts(f.then_body, env, funcs, cv.rins, ret_ty);
      let eb: RStmts = mono_stmts(f.else_body, env, funcs, tb.rins3, ret_ty);
      return RStmtOne { rstmt: ast.StmtIf { cond: cv.rexpr, then_body: tb.rstmts, else_body: eb.rstmts, line: 0, else_chained: false, sugar: no_match_sugar(), origin: "" }, renv: env, rins2: eb.rins3 };
    },
    ast.StmtWhile(w) => {
      let cv: RExpr = mono_expr(w.cond, env, funcs, ins);
      let wb: RStmts = mono_stmts(w.body, env, funcs, cv.rins, ret_ty);
      return RStmtOne { rstmt: ast.StmtWhile { cond: cv.rexpr, body: wb.rstmts, label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo }, renv: env, rins2: wb.rins3 };
    },
    ast.StmtFor(fr) => {
      let it: RExpr = mono_expr(fr.iter, env, funcs, ins);
      let ety: string = for_elem_spelling(mono_infer(fr.iter, env, funcs), fr.var_name);
      let benv: MEnv = menv_bind_destructure(env.ebind(fr.var_name, ety), fr.var_name, ety);
      let fb: RStmts = mono_stmts(fr.body, benv, funcs, it.rins, ret_ty);
      return RStmtOne { rstmt: ast.StmtFor { var_name: fr.var_name, iter: it.rexpr, body: fb.rstmts, label: fr.label, line: fr.line, col: fr.col }, renv: env, rins2: fb.rins3 };
    },
    ast.StmtMatch(m) => {
      let sv: RExpr = mono_expr(m.scrutinee, env, funcs, ins);
      let sty: string = mono_infer(m.scrutinee, env, funcs);
      let arms: ast.MatchArm[] = [];
      let cur: Insts = sv.rins;
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let aenv: MEnv = mono_arm_env(env, m.arms[i].pattern, sty, funcs);
        let guard: ast.Expr = m.arms[i].guard;
        if (m.arms[i].has_guard) {
          let g: RExpr = mono_expr(guard, aenv, funcs, cur);
          guard = g.rexpr;
          cur = g.rins;
        }
        let ab: RStmts = mono_stmts(m.arms[i].body, aenv, funcs, cur, ret_ty);
        cur = ab.rins3;
        arms = arms.append(ast.MatchArm { pattern: m.arms[i].pattern, body: ab.rstmts, line: m.arms[i].line, col: m.arms[i].col, guard: guard, has_guard: m.arms[i].has_guard, alt_cont: false });
        i = i + 1;
      }
      return RStmtOne { rstmt: ast.StmtMatch { ...m, scrutinee: sv.rexpr, arms: arms }, renv: env, rins2: cur };
    },
    ast.StmtDefer(d) => {
      let act: RStmtOne = mono_stmt(d.action, env, funcs, ins, ret_ty);
      return RStmtOne { rstmt: ast.StmtDefer { ...d, action: act.rstmt }, renv: env, rins2: act.rins2 };
    },
    _ => {
      return RStmtOne { rstmt: st, renv: env, rins2: ins };
    }
  }
  return RStmtOne { rstmt: st, renv: env, rins2: ins };
}

function mono_stmts(stmts: ast.Stmt[], env: MEnv, funcs: MFns, ins: Insts, ret_ty: string): RStmts {
  let out: ast.Stmt[] = [];
  let e2: MEnv = env;
  let cur: Insts = ins;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let rs: RStmtOne = mono_stmt(stmts[i], e2, funcs, cur, ret_ty);
    out = out.append(rs.rstmt);
    e2 = rs.renv;
    cur = rs.rins2;
    i = i + 1;
  }
  return RStmts { rstmts: out, rins3: cur };
}

function env_from_params(params: ast.ParamDecl[]): MEnv {
  return bind_params(MEnv { mnames: [], mtypes: [] }, params);
}

function bind_params(env: MEnv, params: ast.ParamDecl[]): MEnv {
  let e: MEnv = env;
  let i: i32 = 0;
  while (i < params.len()) {
    let pt: string = params[i].type_name;
    if (is_fn_contract_tag(pt) && params[i].fn_ret.len() > 0) {
      pt = fn_tag_spelling(pt, params[i].fn_ret, params[i].fn_param_types);
    }
    e = e.ebind(params[i].name, pt);
    i = i + 1;
  }
  return e;
}

function env_from_decl(fd: FuncDecl): MEnv {
  let e: MEnv = env_from_params(fd.params);
  if (fd.receiver_name.len() == 0) {
    return e;
  }
  return e.ebind(fd.receiver_name, fd.receiver_type);
}

function subst_ty_list(list: string, tparams: string[], cts: string[]): string {
  if (list.len() == 0) {
    return "";
  }
  return subst_ty_join(split_top_commas(list), ",", tparams, cts);
}

function subst_ty_join(parts: string[], sep: string, tparams: string[], cts: string[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < parts.len()) {
    if (i > 0) {
      out = out + sep;
    }
    out = out + subst_ty(parts[i], tparams, cts);
    i = i + 1;
  }
  return out;
}

function subst_ty_each(tys: string[], tparams: string[], cts: string[]): string[] {
  let out: string[] = [];
  for t in tys {
    out = out.append(subst_ty(t, tparams, cts));
  }
  return out;
}

pub function subst_ty(name: string, tparams: string[], cts: string[]): string {
  let k: i32 = tp_index(name, tparams);
  if (k >= 0) {
    return cts[k];
  }
  if (name.len() > 4 && slice_unchecked(name, 0, 4) == "own ") {
    return "own " + subst_ty(slice_unchecked(name, 4, name.len()) + "", tparams, cts);
  }
  if (spelling_is_view(name)) {
    return "[" + subst_ty(slice_unchecked(name, 1, name.len() - 1) + "", tparams, cts) + "]";
  }
  if (type_ends_arr(name)) {
    return subst_ty(slice_unchecked(name, 0, name.len() - 2), tparams, cts) + "[]";
  }
  if (name.len() > 0 && name[0] == b'(' && util.contains(name, "=>")) {
    let fref: TypeRef = parse_type_ref(name);
    if (fref.is_fn) {
      let parts: string[] = [];
      let changed: boolean = false;
      for a in fref.args {
        let sp: string = render_type_ref(a);
        let sub: string = subst_ty(sp, tparams, cts);
        if (sub != sp) {
          changed = true;
        }
        parts = parts.append(sub);
      }
      if (!changed) {
        return name;
      }
      let out: string = "(";
      let i: i32 = 0;
      while (i + 1 < parts.len()) {
        if (i > 0) {
          out = out + ", ";
        }
        out = out + parts[i];
        i = i + 1;
      }
      return out + ") => " + parts[parts.len() - 1];
    }
  }
  if (util.is_tuple_type_name(name) && slice_unchecked(name, name.len() - 1, name.len()) == ")") {
    return "(" + subst_ty_join(split_top_commas(slice_unchecked(name, 1, name.len() - 1)), ", ", tparams, cts) + ")";
  }
  let lb: i32 = first_bracket(name);
  if (lb > 0 && slice_unchecked(name, name.len() - 1, name.len()) == "]") {
    return slice_unchecked(name, 0, lb) + "[" + subst_ty_join(split_top_commas(slice_unchecked(name, lb + 1, name.len() - 1)), ", ", tparams, cts) + "]";
  }
  let ps: i32 = name.len() - 1;
  while (ps > 0 && ident_byte(name[ps] as i32)) {
    ps = ps - 1;
  }
  if (ps > 1 && ps < name.len() - 1 && name[ps] == b':' && name[ps - 1] == b':') {
    return subst_ty(slice_unchecked(name, 0, ps - 1) + "", tparams, cts) + slice_unchecked(name, ps - 1, name.len());
  }
  return name;
}

function subst_expr(e: ast.Expr, tparams: string[], cts: string[]): ast.Expr {
  match (e) {
    ast.ExprIdent(id) => {
      let k: i32 = tp_index(id.name, tparams);
      if (k >= 0 && is_const_arg(cts[k])) {
        return e;
      }
      if (k >= 0) {
        return ast.ExprIdent { name: cts[k], line: id.line, col: id.col, ty: id.ty };
      }
      return e;
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, obj: subst_expr(fa.obj, tparams, cts) };
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
          match (cfa.obj) {
            ast.ExprIdent(oid) => {
              if (c.args.len() == 0) {
                let pk: i32 = tp_index(oid.name, tparams);
                if (pk >= 0) {
                  if (cfa.field == "default" && dv_is_scalar(cts[pk])) {
                    return dv_default_expr(cts[pk]);
                  }
                  if (cfa.field == "zero" && dv_is_num_scalar(cts[pk])) {
                    return dv_num_identity_expr(cts[pk], false);
                  }
                  if (cfa.field == "one" && dv_is_num_scalar(cts[pk])) {
                    return dv_num_identity_expr(cts[pk], true);
                  }
                }
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
      let na: ast.Expr[] = [];
      let ci: i32 = 0;
      while (ci < c.args.len()) {
        na = na.append(subst_expr(c.args[ci], tparams, cts));
        ci = ci + 1;
      }
      return ast.ExprCall { callee: subst_expr(c.callee, tparams, cts), args: na, line: c.line, col: c.col, type_args: subst_ty_each(c.type_args, tparams, cts), ty: c.ty };
    },
    ast.ExprStructLit(sl) => {
      let nv: ast.Expr[] = [];
      let si: i32 = 0;
      while (si < sl.field_values.len()) {
        nv = nv.append(subst_expr(sl.field_values[si], tparams, cts));
        si = si + 1;
      }
      let nb: ast.Expr = sl.base;
      if (sl.has_base) {
        nb = subst_expr(sl.base, tparams, cts);
      }
      return ast.ExprStructLit { ...sl, field_values: nv, base: nb, written: subst_ty(sl.written, tparams, cts) };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: subst_expr(b.left, tparams, cts), right: subst_expr(b.right, tparams, cts), line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: subst_expr(u.operand, tparams, cts), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { array: subst_expr(ix.array, tparams, cts), index: subst_expr(ix.index, tparams, cts), unchecked: ix.unchecked, ty: ix.ty, line: ix.line, col: ix.col };
    },
    ast.ExprSlice(sl2) => {
      return ast.ExprSlice { ...sl2, array: subst_expr(sl2.array, tparams, cts), start: subst_expr(sl2.start, tparams, cts), end: subst_expr(sl2.end, tparams, cts) };
    },
    ast.ExprArray(ar) => {
      let ne: ast.Expr[] = [];
      let ai: i32 = 0;
      while (ai < ar.elements.len()) {
        ne = ne.append(subst_expr(ar.elements[ai], tparams, cts));
        ai = ai + 1;
      }
      return ast.ExprArray { ...ar, elements: ne };
    },
    ast.ExprTuple(tp) => {
      let nt: ast.Expr[] = [];
      let ti: i32 = 0;
      while (ti < tp.elements.len()) {
        nt = nt.append(subst_expr(tp.elements[ti], tparams, cts));
        ti = ti + 1;
      }
      return ast.ExprTuple { ...tp, elements: nt };
    },
    ast.ExprLambda(lm) => {
      let lps: ast.ParamDecl[] = [];
      for lpd in lm.params {
        lps = lps.append(ast.ParamDecl { ...lpd, type_name: subst_ty(lpd.type_name, tparams, cts), fn_ret: subst_ty(lpd.fn_ret, tparams, cts), fn_param_types: subst_ty_list(lpd.fn_param_types, tparams, cts) });
      }
      return ast.ExprLambda { ...lm, params: lps, ret_type: subst_ty(lm.ret_type, tparams, cts), ret_fn_ret: subst_ty(lm.ret_fn_ret, tparams, cts), ret_fn_param_types: subst_ty_list(lm.ret_fn_param_types, tparams, cts), body: subst_stmts(lm.body, tparams, cts), captures: [], captures_known: false };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function subst_stmts(stmts: ast.Stmt[], tparams: string[], cts: string[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    let st: ast.Stmt = stmts[i];
    match (st) {
      ast.StmtVar(v) => {
        out = out.append(ast.StmtVar { name: v.name, type_name: subst_ty(v.type_name, tparams, cts), init: subst_expr(v.init, tparams, cts), line: v.line, col: v.col, fn_ret: subst_ty(v.fn_ret, tparams, cts), fn_param_types: subst_ty_list(v.fn_param_types, tparams, cts) });
      },
      ast.StmtReturn(r) => {
        out = out.append(ast.StmtReturn { value: subst_expr(r.value, tparams, cts), line: r.line, col: r.col });
      },
      ast.StmtExpr(x) => {
        out = out.append(ast.StmtExpr { value: subst_expr(x.value, tparams, cts), line: x.line });
      },
      ast.StmtAssign(a) => {
        out = out.append(ast.StmtAssign { target: a.target, value: subst_expr(a.value, tparams, cts), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col });
      },
      ast.StmtIf(f) => {
        out = out.append(ast.StmtIf { ...f, cond: subst_expr(f.cond, tparams, cts), then_body: subst_stmts(f.then_body, tparams, cts), else_body: subst_stmts(f.else_body, tparams, cts) });
      },
      ast.StmtWhile(w) => {
        out = out.append(ast.StmtWhile { cond: subst_expr(w.cond, tparams, cts), body: subst_stmts(w.body, tparams, cts), label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo });
      },
      ast.StmtFor(fr) => {
        out = out.append(ast.StmtFor { var_name: fr.var_name, iter: subst_expr(fr.iter, tparams, cts), body: subst_stmts(fr.body, tparams, cts), label: fr.label, line: fr.line, col: fr.col });
      },
      ast.StmtMatch(m) => {
        let arms: ast.MatchArm[] = [];
        let j: i32 = 0;
        while (j < m.arms.len()) {
          arms = arms.append(ast.MatchArm { pattern: m.arms[j].pattern, body: subst_stmts(m.arms[j].body, tparams, cts), line: m.arms[j].line, col: m.arms[j].col, guard: subst_expr(m.arms[j].guard, tparams, cts), has_guard: m.arms[j].has_guard, alt_cont: false });
          j = j + 1;
        }
        out = out.append(ast.StmtMatch { ...m, scrutinee: subst_expr(m.scrutinee, tparams, cts), arms: arms });
      },
      ast.StmtDefer(d) => {
        out = out.append(ast.StmtDefer { ...d, action: subst_stmts([d.action], tparams, cts)[0] });
      },
      _ => {
        out = out.append(st);
      }
    }
    i = i + 1;
  }
  return out;
}

function bound_substitutions(fd: FuncDecl, tparams: string[], cts: string[], impls: ImplInfo[]): (string[], string[]) {
  let ns: string[] = tparams;
  let ts: string[] = cts;
  let k: i32 = 0;
  while (k < tparams.len() && k < fd.bound_traits.len() && k < cts.len()) {
    for entry in split_plus_bounds(fd.bound_traits[k]) {
      let (n2, t2) = bound_entry_substitutions(entry, cts[k], impls, ns, ts);
      ns = n2;
      ts = t2;
    }
    k = k + 1;
  }
  return (ns, ts);
}

function bound_entry_substitutions(entry: string, concrete: string, impls: ImplInfo[], names: string[], types: string[]): (string[], string[]) {
  let bref: TypeRef = parse_type_ref(entry);
  if (bref.args.len() == 0) {
    return (names, types);
  }
  let tr_name: string = derive_simple_name(util.base_type_name(entry));
  let cref: TypeRef = parse_type_ref(concrete);
  for im in impls {
    if (im.trait_name != tr_name) {
      continue;
    }
    if (util.base_type_name(im.impl_type) != util.base_type_name(concrete)) {
      continue;
    }
    let iref: TypeRef = parse_type_ref(im.trait_ref);
    if (iref.args.len() != bref.args.len()) {
      continue;
    }
    let pn: string[] = [];
    let pt: string[] = [];
    let (pn2, pt2) = ref_bind(parse_type_ref(im.impl_type), cref, im.all_type_params, pn, pt);
    let ns: string[] = names;
    let ts: string[] = types;
    let j: i32 = 0;
    while (j < bref.args.len()) {
      let got: string = subst_ty(render_type_ref(iref.args[j]), pn2, pt2);
      let (n3, t3) = ref_bind(bref.args[j], parse_type_ref(got), [], ns, ts);
      ns = n3;
      ts = t3;
      j = j + 1;
    }
    return (ns, ts);
  }
  return (names, types);
}

function ref_bind(pattern: TypeRef, actual: TypeRef, vars: string[], names: string[], types: string[]): (string[], string[]) {
  let ns: string[] = names;
  let ts: string[] = types;
  if (pattern.array_depth > 0) {
    if (actual.array_depth != pattern.array_depth) {
      return (ns, ts);
    }
    return ref_bind(elem_type_ref(pattern), elem_type_ref(actual), vars, ns, ts);
  }
  if (pattern.args.len() == 0) {
    let leaf: string = pattern.base;
    let binds: boolean = util.index_of_str(vars, leaf) >= 0;
    if (vars.len() == 0) {
      binds = looks_type_var(leaf);
    }
    if (binds && tp_index(leaf, ns) < 0) {
      ns = ns.append(leaf);
      ts = ts.append(render_type_ref(actual));
    }
    return (ns, ts);
  }
  if (pattern.base != actual.base || pattern.args.len() != actual.args.len()) {
    return (ns, ts);
  }
  let i: i32 = 0;
  while (i < pattern.args.len()) {
    let (n2, t2) = ref_bind(pattern.args[i], actual.args[i], vars, ns, ts);
    ns = n2;
    ts = t2;
    i = i + 1;
  }
  return (ns, ts);
}

pub function split_plus_bounds(bound: string): string[] {
  let out: string[] = [];
  if (is_const_bound(bound)) {
    return out;
  }
  let start: i32 = 0;
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i <= bound.len()) {
    if (i < bound.len() && bound[i] == b'[') {
      depth = depth + 1;
    } else if (i < bound.len() && bound[i] == b']') {
      depth = depth - 1;
    }
    if (i == bound.len() || depth == 0 && bound[i] == b'+') {
      if (i > start) {
        out = out.append(slice_unchecked(bound, start, i) + "");
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

function clone_bg(fd: FuncDecl, key: string, impls: ImplInfo[], reqs: TraitReq[], funcs: MFns): FuncDecl {
  let tparams: string[] = fd.type_params;
  let cts: string[] = [key];
  if (tparams.len() != 1) {
    cts = split_inst_key(key);
  }
  let (btp, bct) = bound_substitutions(fd, tparams, cts, impls);
  let rewritten: FuncDecl = FuncDecl { ...fd, body: bound_rewritten(fd, cts, reqs, funcs) };
  return instantiate_func(rewritten, fd.name + "__" + sanitize_key(key), btp, bct, impls);
}

struct BoundUse { env: MEnv, funcs: MFns, ord: string[], eq: string[], routed: string[], bases: string[], traits: string[][], by_trait: boolean }

function bound_rewritten(fd: FuncDecl, cts: string[], reqs: TraitReq[], funcs: MFns): ast.Stmt[] {
  let ctx: BoundUse = bound_use(fd, cts, reqs, funcs);
  if (ctx.ord.len() == 0 && ctx.eq.len() == 0 && ctx.routed.len() == 0) {
    return fd.body;
  }
  let (out, after) = bc_body(fd.body, ctx);
  return out;
}

function bound_use(fd: FuncDecl, cts: string[], reqs: TraitReq[], funcs: MFns): BoundUse {
  let ord: string[] = [];
  let eq: string[] = [];
  let k: i32 = 0;
  while (k < fd.type_params.len() && k < fd.bound_traits.len() && k < cts.len()) {
    if (bound_supplies(reqs, fd.bound_traits[k], "cmp") && !native_order_agrees(cts[k])) {
      ord = ord.append(fd.type_params[k]);
    }
    if (bound_supplies(reqs, fd.bound_traits[k], "eq") && !native_eq_agrees(cts[k])) {
      eq = eq.append(fd.type_params[k]);
    }
    k = k + 1;
  }
  let (routed, bases, traits) = bound_routes(fd, cts, funcs);
  return BoundUse { env: env_from_decl(fd), funcs: MFns { ...funcs, keep_vars: true }, ord: ord, eq: eq, routed: routed, bases: bases, traits: traits, by_trait: false };
}

pub function route_bound_calls(fd: FuncDecl, cts: string[], reqs: TraitReq[], funcs: MFns): ast.Stmt[] {
  let ctx: BoundUse = BoundUse { ...bound_use(fd, cts, reqs, funcs), by_trait: true };
  if (ctx.ord.len() == 0 && ctx.eq.len() == 0 && ctx.routed.len() == 0) {
    return fd.body;
  }
  let (out, after) = bc_body(fd.body, ctx);
  return out;
}

function method_bound_rewritten(m: FuncDecl, tparams: string[], cts: string[], reqs: TraitReq[], funcs: MFns): ast.Stmt[] {
  let vars: string[] = [];
  let bounds: string[] = [];
  let at: string[] = [];
  let k: i32 = 0;
  while (k < m.type_params.len() && k < m.bound_traits.len()) {
    let i: i32 = util.index_of_str(tparams, m.type_params[k]);
    if (i >= 0 && i < cts.len()) {
      vars = vars.append(m.type_params[k]);
      bounds = bounds.append(m.bound_traits[k]);
      at = at.append(cts[i]);
    }
    k = k + 1;
  }
  return bound_rewritten(FuncDecl { ...m, type_params: vars, bound_traits: bounds }, at, reqs, funcs);
}

function bound_routes(fd: FuncDecl, cts: string[], funcs: MFns): (string[], string[], string[][]) {
  let routed: string[] = [];
  let bases: string[] = [];
  let traits: string[][] = [];
  let k: i32 = 0;
  while (k < fd.type_params.len() && k < fd.bound_traits.len() && k < cts.len()) {
    let base: string = util.base_type_name(cts[k]);
    if (fd.bound_traits[k].len() > 0 && util.has_str(funcs.renamed, base)) {
      routed = routed.append(fd.type_params[k]);
      bases = bases.append(base);
      traits = traits.append(split_plus_bounds(fd.bound_traits[k]));
    }
    k = k + 1;
  }
  return (routed, bases, traits);
}

function bound_method(ty: string, m: string, receiver: boolean, ctx: BoundUse): string {
  let k: i32 = util.index_of_str(ctx.routed, ty);
  if (k < 0) {
    return m;
  }
  let at: i32 = trait_provider_index(ctx.funcs.decls, ctx.bases[k], ctx.traits[k], m, receiver);
  if (at < 0) {
    return m;
  }
  let fd: FuncDecl = ctx.funcs.decls[at];
  if (ctx.by_trait && receiver && fd.impl_trait.len() > 0) {
    return fd.impl_trait + "." + derive_simple_name(fd.name);
  }
  return fd.name;
}

function bound_field(fa: ast.ExprFieldAccess, ctx: BoundUse): string {
  if let ast.ExprIdent(id) = fa.obj {
    if (!util.has_str(ctx.env.mnames, id.name)) {
      return bound_method(id.name, fa.field, false, ctx);
    }
  }
  return bound_method(mono_infer(fa.obj, ctx.env, ctx.funcs), fa.field, true, ctx);
}

function bound_supplies(reqs: TraitReq[], bound: string, method: string): boolean {
  for entry in split_plus_bounds(bound) {
    for ri in trait_closure(reqs, derive_simple_name(util.base_type_name(entry)), "") {
      if (str_list_contains(reqs[ri].methods, method) || str_list_contains(reqs[ri].provided, method)) {
        return true;
      }
    }
  }
  return false;
}

function native_order_agrees(t: string): boolean {
  return util.has_str(["i32", "i64", "u32", "u64", "u8", "usize", "f32", "f64", "string"], t);
}

function native_eq_agrees(t: string): boolean {
  return native_order_agrees(t) || t == "boolean" || t == "char";
}

function bc_body(stmts: ast.Stmt[], ctx: BoundUse): (ast.Stmt[], BoundUse) {
  let out: ast.Stmt[] = [];
  let cur: BoundUse = ctx;
  for stmt in stmts {
    let (ns, na, nh) = astwalk.map_stmt_acc(stmt, cur, bc_stmt, bc_expr);
    out = out.append(ns);
    cur = na;
  }
  return (out, ctx);
}

function bc_rewrite(e: ast.Expr, ctx: BoundUse): ast.Expr {
  let (out, a, h) = astwalk.map_expr_acc(e, ctx, bc_stmt, bc_expr);
  return out;
}

function bc_stmt(st: ast.Stmt, ctx: BoundUse): (ast.Stmt, BoundUse, boolean) {
  match (st) {
    ast.StmtVar(v) => {
      let ty: string = fn_tag_spelling(v.type_name, v.fn_ret, v.fn_param_types);
      if (ty.len() == 0) {
        ty = mono_infer(v.init, ctx.env, ctx.funcs);
      }
      let bound: MEnv = menv_bind_destructure(ctx.env.ebind(v.name, ty), v.name, ty);
      return (ast.StmtVar { ...v, init: bc_rewrite(v.init, ctx) }, BoundUse { ...ctx, env: bound }, true);
    },
    ast.StmtIf(f) => {
      let (tb, ta) = bc_body(f.then_body, ctx);
      let (eb, ea) = bc_body(f.else_body, ctx);
      return (ast.StmtIf { ...f, cond: bc_rewrite(f.cond, ctx), then_body: tb, else_body: eb }, ctx, true);
    },
    ast.StmtWhile(w) => {
      let (wb, wa) = bc_body(w.body, ctx);
      return (ast.StmtWhile { ...w, cond: bc_rewrite(w.cond, ctx), body: wb }, ctx, true);
    },
    ast.StmtFor(fr) => {
      let ety: string = "";
      let ity: string = mono_infer(fr.iter, ctx.env, ctx.funcs);
      if (type_ends_arr(ity)) {
        ety = elem_spelling(ity);
      }
      let (fb, fa) = bc_body(fr.body, BoundUse { ...ctx, env: ctx.env.ebind(fr.var_name, ety) });
      return (ast.StmtFor { ...fr, iter: bc_rewrite(fr.iter, ctx), body: fb }, ctx, true);
    },
    ast.StmtMatch(m) => {
      let sty: string = mono_infer(m.scrutinee, ctx.env, ctx.funcs);
      let arms: ast.MatchArm[] = [];
      for arm in m.arms {
        let actx: BoundUse = BoundUse { ...ctx, env: mono_arm_env(ctx.env, arm.pattern, sty, ctx.funcs) };
        let (ab, aa) = bc_body(arm.body, actx);
        let g: ast.Expr = arm.guard;
        if (arm.has_guard) {
          g = bc_rewrite(arm.guard, actx);
        }
        arms = arms.append(ast.MatchArm { ...arm, body: ab, guard: g });
      }
      return (ast.StmtMatch { ...m, scrutinee: bc_rewrite(m.scrutinee, ctx), arms: arms }, ctx, true);
    },
    _ => {
      return (st, ctx, false);
    }
  }
  return (st, ctx, false);
}

function bc_expr(e: ast.Expr, ctx: BoundUse): (ast.Expr, BoundUse, boolean) {
  match (e) {
    ast.ExprLambda(lm) => {
      let (lb, la) = bc_body(lm.body, BoundUse { ...ctx, env: bind_params(ctx.env, lm.params) });
      return (ast.ExprLambda { ...lm, body: lb }, ctx, true);
    },
    ast.ExprBinary(b) => {
      return (bc_binary(b, ctx), ctx, true);
    },
    ast.ExprCall(c) => {
      return (bc_call(c, ctx), ctx, true);
    },
    _ => {
      return (e, ctx, false);
    }
  }
  return (e, ctx, false);
}

function bc_binary(b: ast.ExprBinary, ctx: BoundUse): ast.Expr {
  let left: ast.Expr = bc_rewrite(b.left, ctx);
  let right: ast.Expr = bc_rewrite(b.right, ctx);
  let lt: string = mono_infer(b.left, ctx.env, ctx.funcs);
  if (lt.len() == 0) {
    lt = mono_infer(b.right, ctx.env, ctx.funcs);
  }
  if (util.has_str(["<", "<=", ">", ">="], b.op) && str_list_contains(ctx.ord, lt)) {
    let zero: ast.Expr = ast.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: b.line, col: b.col };
    return ast.ExprBinary { ...b, left: dv_call1(left, bound_method(lt, "cmp", true, ctx), right), right: zero };
  }
  if (b.op == "==" && str_list_contains(ctx.eq, lt)) {
    return dv_call1(left, bound_method(lt, "eq", true, ctx), right);
  }
  if (b.op == "!=" && str_list_contains(ctx.eq, lt)) {
    return ast.ExprUnary { op: "!", operand: dv_call1(left, bound_method(lt, "eq", true, ctx), right), line: b.line, col: b.col, ty: "" };
  }
  return ast.ExprBinary { ...b, left: left, right: right };
}

function bc_call(c: ast.ExprCall, ctx: BoundUse): ast.Expr {
  let args: ast.Expr[] = [];
  for a in c.args {
    args = args.append(bc_rewrite(a, ctx));
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    let field: string = fa.field;
    if (ctx.routed.len() > 0) {
      field = bound_field(fa, ctx);
    }
    let callee: ast.Expr = ast.ExprFieldAccess { ...fa, obj: bc_rewrite(fa.obj, ctx), field: field };
    return ast.ExprCall { ...c, callee: callee, args: args };
  }
  return ast.ExprCall { ...c, callee: bc_rewrite(c.callee, ctx), args: args };
}

pub function instantiate_func(fd: FuncDecl, name: string, tparams: string[], cts: string[], impls: ImplInfo[]): FuncDecl {
  let nparams: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < fd.params.len()) {
    nparams = nparams.append(ast.ParamDecl { name: fd.params[i].name, type_name: resolve_proj_in_type(subst_ty(fd.params[i].type_name, tparams, cts), impls), own: fd.params[i].own, has_default: fd.params[i].has_default, default_value: fd.params[i].default_value, fn_ret: subst_ty(fd.params[i].fn_ret, tparams, cts), fn_param_types: subst_ty_list(fd.params[i].fn_param_types, tparams, cts) });
    i = i + 1;
  }
  let notp: string[] = [];
  return FuncDecl {
    ...fd,
    name: name,
    receiver_name: "",
    receiver_type: "",
    type_params: notp,
    all_type_params: [],
    bound_traits: notp,
    params: nparams,
    ret_type: resolve_proj_in_type(subst_ty(fd.ret_type, tparams, cts), impls),
    ret_fn_ret: subst_ty(fd.ret_fn_ret, tparams, cts),
    ret_fn_param_types: subst_ty_list(fd.ret_fn_param_types, tparams, cts),
    body: const_reads(fd, subst_stmts(fd.body, tparams, cts), tparams, cts),
  };
}

function const_reads(fd: FuncDecl, body: ast.Stmt[], tparams: string[], cts: string[]): ast.Stmt[] {
  let vars: string[] = [];
  let lits: string[] = [];
  let i: i32 = 0;
  while (i < tparams.len() && i < cts.len()) {
    if (is_const_arg(cts[i])) {
      vars = vars.append(tparams[i]);
      lits = lits.append(cts[i]);
    }
    i = i + 1;
  }
  if (vars.len() == 0) {
    return body;
  }
  let values: string[] = [];
  for pd in fd.params {
    values = astwalk.append_bound_name(values, pd.name);
  }
  return tv_obj_body(body, TvScope { vars: vars, cts: lits, values: values, lits: true });
}

pub function looks_type_var(s: string): boolean {
  if (s.len() < 3 || s[0] != b'0' || s[1] != b'_' || s[2] >= b'0' && s[2] <= b'9') {
    return false;
  }
  let i: i32 = 2;
  while (i < s.len()) {
    if (!tv_word_char(s[i] as i32)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function array_method_element(spelling: string): string {
  if (type_ends_arr(spelling)) {
    return elem_spelling(spelling);
  }
  if (spelling_is_view(spelling)) {
    return render_type_ref(parse_type_ref(spelling).args[0]);
  }
  return "";
}

function is_concrete_array_method(fd: FuncDecl): boolean {
  let elem: string = array_method_element(fd.receiver_type);
  return fd.receiver_name.len() > 0 && elem.len() > 0
    && type_str_vars(elem, []).len() == 0;
}

pub function concrete_array_method_name(receiver: string, method: string): string {
  let elem: string = array_method_element(receiver);
  if (elem.len() == 0) {
    return "";
  }
  let prefix: string = "__carrm_";
  if (spelling_is_view(receiver)) {
    prefix = "__cviewm_";
  }
  return prefix + sanitize_key(elem) + "__" + method;
}

function is_concrete_array_fold(fd: FuncDecl): boolean {
  return fd.receiver_name.len() == 0
    && (util.str_has_prefix(fd.name, "__carrm_") || util.str_has_prefix(fd.name, "__cviewm_"));
}

function concrete_array_method_at(funcs: MFns, receiver: string, method: string): i32 {
  if (funcs.array_concrete.len() == 0) {
    return 0 - 1;
  }
  let name: string = concrete_array_method_name(receiver, method);
  for at in funcs.array_concrete {
    if (funcs.decls[at].name == name) {
      return at;
    }
  }
  return 0 - 1;
}

function is_generic_array_method(fd: FuncDecl): boolean {
  if (fd.receiver_name.len() == 0) {
    return false;
  }
  let elem: string = array_method_element(fd.receiver_type);
  if (!looks_type_var(elem)) {
    return false;
  }
  let k: i32 = 0;
  while (k < fd.type_params.len()) {
    if (fd.type_params[k] != elem) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

pub function register_array_method_generics(mod: Module): Module {
  let any_am: boolean = false;
  let ci: i32 = 0;
  while (ci < mod.funcs.len()) {
    if (is_generic_array_method(mod.funcs[ci]) || is_concrete_array_method(mod.funcs[ci])) {
      any_am = true;
    }
    ci = ci + 1;
  }
  if (!any_am) {
    return mod;
  }

  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (is_concrete_array_method(fd)) {
      let params: ast.ParamDecl[] = [ast.ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: fd.receiver_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
      for param in fd.params {
        params = params.append(param);
      }
      out = out.append(FuncDecl { ...fd, name: concrete_array_method_name(fd.receiver_type, fd.name), receiver_name: "", receiver_type: "", params: params });
    } else if (is_generic_array_method(fd)) {
      let elem: string = array_method_element(fd.receiver_type);
      let tps: string[] = [elem + ""];
      let prefix: string = "__arrm_";
      if (spelling_is_view(fd.receiver_type)) {
        prefix = "__viewm_";
      }
      let nparams: ast.ParamDecl[] = [ast.ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: fd.receiver_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
      let j: i32 = 0;
      while (j < fd.params.len()) {
        nparams = nparams.append(fd.params[j]);
        j = j + 1;
      }
      out = out.append(FuncDecl {
        stdlib: fd.stdlib, no_inline: false,
        name: prefix + fd.name,
        receiver_name: "", receiver_type: "", receiver_own: false,
        type_params: tps,
        params: nparams,
        ret_type: fd.ret_type,
        body: fd.body, line: fd.line, col: fd.col,
        import_iface: fd.import_iface, import_wit: fd.import_wit, all_type_params: tps, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
        is_pub: true,
        is_const: false, ret_fn_ret: fd.ret_fn_ret, ret_fn_param_types: fd.ret_fn_param_types, is_package: false, module: fd.module, impl_trait: fd.impl_trait, dyn_traits: fd.dyn_traits, streams: fd.streams,
      });
    } else {
      out = out.append(fd);
    }
    i = i + 1;
  }
  return Module { ...mod, funcs: out };
}

function map_receiver_typevars(recv: string): string[] {
  let none: string[] = [];
  if (recv.len() < 5 || slice_unchecked(recv, 0, 4) != "Map[" || slice_unchecked(recv, recv.len() - 1, recv.len()) != "]") {
    return none;
  }
  let parts: string[] = split_top_commas(slice_unchecked(recv, 4, recv.len() - 1));
  let out: string[] = [];
  let i: i32 = 0;
  while (i < parts.len()) {
    let tv: string = parts[i];
    if (!looks_type_var(tv)) {
      return none;
    }
    out = out.append(tv);
    i = i + 1;
  }
  return out;
}

function is_generic_map_method(fd: FuncDecl): boolean {
  if (fd.receiver_name.len() == 0) {
    return false;
  }
  let tvs: string[] = map_receiver_typevars(fd.receiver_type);
  if (tvs.len() == 0) {
    return false;
  }
  let k: i32 = 0;
  while (k < fd.type_params.len()) {
    if (!str_in(tvs, fd.type_params[k])) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

pub function register_map_method_generics(mod: Module): Module {
  let any_mm: boolean = false;
  let ci: i32 = 0;
  while (ci < mod.funcs.len()) {
    if (is_generic_map_method(mod.funcs[ci])) {
      any_mm = true;
    }
    ci = ci + 1;
  }
  if (!any_mm) {
    return mod;
  }

  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (is_generic_map_method(fd)) {
      let tps: string[] = map_receiver_typevars(fd.receiver_type);
      let nparams: ast.ParamDecl[] = [ast.ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: fd.receiver_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
      let j: i32 = 0;
      while (j < fd.params.len()) {
        nparams = nparams.append(fd.params[j]);
        j = j + 1;
      }
      out = out.append(FuncDecl {
        stdlib: fd.stdlib, no_inline: false,
        name: "__mapm_" + fd.name,
        receiver_name: "", receiver_type: "", receiver_own: false,
        type_params: tps,
        params: nparams,
        ret_type: fd.ret_type,
        body: fd.body, line: fd.line, col: fd.col,
        import_iface: fd.import_iface, import_wit: fd.import_wit, all_type_params: tps, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
        is_pub: true,
        is_const: false, ret_fn_ret: fd.ret_fn_ret, ret_fn_param_types: fd.ret_fn_param_types, is_package: false, module: fd.module, impl_trait: fd.impl_trait, dyn_traits: fd.dyn_traits, streams: fd.streams,
      });
    } else {
      out = out.append(fd);
    }
    i = i + 1;
  }
  return Module { ...mod, funcs: out };
}

function collect_tvars(name: string, acc: string[]): string[] {
  if (looks_type_var(name)) {
    if (str_in(acc, name)) {
      return acc;
    }
    return acc.append(name);
  }
  if (type_ends_arr(name)) {
    return collect_tvars(slice_unchecked(name, 0, name.len() - 2), acc);
  }
  if (util.is_tuple_type_name(name) && slice_unchecked(name, name.len() - 1, name.len()) == ")") {
    let tparts: string[] = split_top_commas(slice_unchecked(name, 1, name.len() - 1));
    let tcur: string[] = acc;
    let tj: i32 = 0;
    while (tj < tparts.len()) {
      tcur = collect_tvars(tparts[tj], tcur);
      tj = tj + 1;
    }
    return tcur;
  }
  let lb: i32 = first_bracket(name);
  if (lb > 0 && slice_unchecked(name, name.len() - 1, name.len()) == "]") {
    let parts: string[] = split_top_commas(slice_unchecked(name, lb + 1, name.len() - 1));
    let cur: string[] = acc;
    let j: i32 = 0;
    while (j < parts.len()) {
      cur = collect_tvars(parts[j], cur);
      j = j + 1;
    }
    return cur;
  }
  return acc;
}

pub function struct_receiver_typevars(recv: string): string[] {
  let none: string[] = [];
  let lb: i32 = first_bracket(recv);
  if (lb <= 0) {
    return none;
  }
  if (slice_unchecked(recv, recv.len() - 1, recv.len()) != "]") {
    return none;
  }
  let parts: string[] = split_top_commas(slice_unchecked(recv, lb + 1, recv.len() - 1));
  let out: string[] = [];
  let i: i32 = 0;
  while (i < parts.len()) {
    if (!looks_type_var(parts[i])) {
      return none;
    }
    out = out.append(parts[i]);
    i = i + 1;
  }
  return out;
}

function smm_own_typevars(fd: FuncDecl, recv_vars: string[]): string[] {
  let all: string[] = [];
  let i: i32 = 0;
  while (i < fd.params.len()) {
    all = collect_tvars(fd.params[i].type_name, all);
    all = collect_tvars(fd.params[i].fn_ret, all);
    i = i + 1;
  }
  all = collect_tvars(fd.ret_type, all);
  let own: string[] = [];
  let j: i32 = 0;
  while (j < all.len()) {
    if (!str_in(recv_vars, all[j])) {
      own = own.append(all[j]);
    }
    j = j + 1;
  }
  return own;
}

function is_generic_method_own_tps(fd: FuncDecl, structs: StructDecl[], enums: EnumDecl[]): boolean {
  if (fd.receiver_name.len() == 0) {
    return false;
  }
  let recv_vars: string[] = struct_receiver_typevars(fd.receiver_type);
  if (recv_vars.len() == 0) {
    return is_plain_method_tps(fd, structs, enums);
  }
  let base: string = strip_struct_base(fd.receiver_type);
  let si: i32 = 0;
  let found: boolean = false;
  while (si < structs.len()) {
    if (structs[si].name == base && structs[si].type_params.len() == recv_vars.len()) {
      found = true;
    }
    si = si + 1;
  }
  let ei: i32 = 0;
  while (ei < enums.len()) {
    if (enums[ei].name == base && enums[ei].type_params.len() == recv_vars.len()) {
      found = true;
    }
    ei = ei + 1;
  }
  if (!found) {
    return false;
  }
  let own: string[] = smm_own_typevars(fd, recv_vars);
  let k: i32 = 0;
  while (k < fd.type_params.len()) {
    let tp: string = fd.type_params[k];
    if (!str_in(recv_vars, tp) && !str_in(own, tp)) {
      return false;
    }
    k = k + 1;
  }
  return own.len() > 0;
}

function is_plain_method_tps(fd: FuncDecl, structs: StructDecl[], enums: EnumDecl[]): boolean {
  if (fd.type_params.len() == 0 || first_bracket(fd.receiver_type) >= 0) {
    return false;
  }
  if (!is_plain_decl(fd.receiver_type, structs, enums)) {
    return false;
  }
  let own: string[] = smm_own_typevars(fd, []);
  for tp in fd.type_params {
    if (!str_in(own, tp)) {
      return false;
    }
  }
  return true;
}

function is_plain_decl(name: string, structs: StructDecl[], enums: EnumDecl[]): boolean {
  for sd in structs {
    if (sd.name == name && sd.type_params.len() == 0) {
      return true;
    }
  }
  for ed in enums {
    if (ed.name == name && ed.type_params.len() == 0) {
      return true;
    }
  }
  return false;
}

function smm_name(base: string, method: string): string {
  return "__smm_" + base + "_" + method;
}

function smm_any(fns: MFns, field: string): boolean {
  let sfx: string = "_" + field;
  let i: i32 = 0;
  while (i < fns.smm.len()) {
    let n: string = fns.smm[i];
    if (n.len() > 6 + sfx.len() && slice_unchecked(n, n.len() - sfx.len(), n.len()) == sfx) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function register_struct_method_generics(mod: Module): Module {
  let any_sm: boolean = false;
  let ci: i32 = 0;
  while (ci < mod.funcs.len()) {
    if (is_generic_method_own_tps(mod.funcs[ci], mod.structs, mod.enums)) {
      any_sm = true;
    }
    ci = ci + 1;
  }
  if (!any_sm) {
    return mod;
  }

  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (is_generic_method_own_tps(fd, mod.structs, mod.enums)) {
      let recv_vars: string[] = struct_receiver_typevars(fd.receiver_type);
      let tps: string[] = recv_vars;
      let bnames: string[] = [];
      let bi2: i32 = 0;
      while (bi2 < recv_vars.len()) {
        bnames = bnames.append("");
        bi2 = bi2 + 1;
      }
      let own: string[] = smm_own_typevars(fd, recv_vars);
      let oi: i32 = 0;
      while (oi < own.len()) {
        tps = tps.append(own[oi]);
        bnames = bnames.append(declared_bound(fd, own[oi]));
        oi = oi + 1;
      }
      let nparams: ast.ParamDecl[] = [ast.ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: fd.receiver_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
      let j: i32 = 0;
      while (j < fd.params.len()) {
        nparams = nparams.append(fd.params[j]);
        j = j + 1;
      }
      out = out.append(FuncDecl {
        stdlib: fd.stdlib, no_inline: false,
        name: smm_name(strip_struct_base(fd.receiver_type), fd.name),
        receiver_name: "", receiver_type: "", receiver_own: false,
        type_params: tps,
        params: nparams,
        ret_type: fd.ret_type,
        body: fd.body, line: fd.line, col: fd.col,
        import_iface: fd.import_iface, import_wit: fd.import_wit, all_type_params: tps, bound_traits: bnames, fip: false, fbip: false, fip_allowance: 0, async: fd.async,
        is_pub: true,
        is_const: fd.is_const, ret_fn_ret: fd.ret_fn_ret, ret_fn_param_types: fd.ret_fn_param_types, is_package: false, module: fd.module, impl_trait: fd.impl_trait, dyn_traits: fd.dyn_traits, streams: fd.streams,
      });
    } else {
      out = out.append(fd);
    }
    i = i + 1;
  }
  return Module { ...mod, funcs: out };
}

function declared_bound(fd: FuncDecl, name: string): string {
  let at: i32 = util.index_of_str(fd.type_params, name);
  if (at < 0 || at >= fd.bound_traits.len()) {
    return "";
  }
  return fd.bound_traits[at];
}

function promote_erased_forwarders(funcs: FuncDecl[]): FuncDecl[] {
  let out: FuncDecl[] = funcs;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let gnames: string[] = [];
    let gi: i32 = 0;
    while (gi < out.len()) {
      if (out[gi].receiver_name.len() == 0 && out[gi].type_params.len() > 0) {
        gnames = gnames.append(out[gi].name);
      }
      gi = gi + 1;
    }
    let i: i32 = 0;
    while (i < out.len()) {
      let fd: FuncDecl = out[i];
      if (fd.receiver_type.len() == 0 && fd.receiver_name.len() == 0 && fd.all_type_params.len() > fd.type_params.len()) {
        let evars: string[] = erased_vars_of(fd);
        if (evars.len() > 0 && erased_vars_bindable(fd.params, evars)) {
          let scan: FwdScan = FwdScan { params: fd.params, evars: evars, gnames: gnames, hit: false };
          for st in fd.body {
            scan = astwalk.fold_stmt_nodes(st, scan, fwd_scan_stmt, fwd_scan_expr, astwalk.descend_all);
          }
          if (scan.hit) {
            let tps: string[] = fd.type_params;
            let bts: string[] = fd.bound_traits;
            for ev in evars {
              tps = tps.append(ev);
              bts = bts.append("");
            }
            out = out.with(i, FuncDecl { ...fd, type_params: tps, bound_traits: bts });
            changed = true;
          }
        }
      }
      i = i + 1;
    }
  }
  return out;
}

function promote_value_named(funcs: FuncDecl[], top_stmts: ast.Stmt[]): FuncDecl[] {
  let names: string[] = [];
  let at: i32[] = [];
  let gnames: string[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: FuncDecl = funcs[i];
    if (fd.receiver_type.len() == 0 && fd.receiver_name.len() == 0 && fd.all_type_params.len() > 0 && signature_vars_complete(fd)) {
      gnames = gnames.append(fd.name);
      if (fd.all_type_params.len() > fd.type_params.len()) {
        names = names.append(fd.name);
        at = at.append(i);
      }
    }
    i = i + 1;
  }
  if (gnames.len() == 0) {
    return funcs;
  }
  let scan: ValScan = ValScan { names: names, refs: __alloc_i32(names.len()), callee_refs: __alloc_i32(names.len()) };
  let enclosers: i32[] = [];
  let fi: i32 = 0;
  while (fi < funcs.len()) {
    let fd: FuncDecl = funcs[fi];
    for st in fd.body {
      scan = astwalk.fold_stmt_nodes(st, scan, val_scan_stmt, val_scan_expr, astwalk.descend_all);
    }
    if (fd.receiver_type.len() == 0 && fd.receiver_name.len() == 0 && fd.all_type_params.len() > fd.type_params.len() && body_names_value(fd.body, gnames)) {
      enclosers = enclosers.append(fi);
    }
    fi = fi + 1;
  }
  for st in top_stmts {
    scan = astwalk.fold_stmt_nodes(st, scan, val_scan_stmt, val_scan_expr, astwalk.descend_all);
  }
  let out: FuncDecl[] = funcs;
  let k: i32 = 0;
  while (k < names.len()) {
    if (scan.refs[k] > scan.callee_refs[k]) {
      out = out.with(at[k], promote_all_vars(funcs[at[k]]));
    }
    k = k + 1;
  }
  for ei in enclosers {
    out = out.with(ei, promote_all_vars(out[ei]));
  }
  return out;
}

function promote_all_vars(fd: FuncDecl): FuncDecl {
  let tps: string[] = fd.type_params;
  let bts: string[] = fd.bound_traits;
  for v in fd.all_type_params {
    if (!util.has_str(tps, v)) {
      tps = tps.append(v);
      bts = bts.append("");
    }
  }
  return FuncDecl { ...fd, type_params: tps, bound_traits: bts };
}

function body_names_value(body: ast.Stmt[], gnames: string[]): boolean {
  let scan: ValScan = ValScan { names: gnames, refs: __alloc_i32(gnames.len()), callee_refs: __alloc_i32(gnames.len()) };
  for st in body {
    scan = astwalk.fold_stmt_nodes(st, scan, val_scan_stmt, val_scan_expr, astwalk.descend_all);
  }
  let k: i32 = 0;
  while (k < gnames.len()) {
    if (scan.refs[k] > scan.callee_refs[k]) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function signature_vars_complete(fd: FuncDecl): boolean {
  let spelled: string[] = type_str_vars(fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types), []);
  for p in fd.params {
    spelled = type_str_vars(param_spelling(p), spelled);
  }
  for v in fd.all_type_params {
    if (!util.has_str(spelled, v)) {
      return false;
    }
  }
  return true;
}

struct ValScan { names: string[], refs: i32[], callee_refs: i32[] }

function val_scan_stmt(st: ast.Stmt, own acc: ValScan): ValScan {
  return acc;
}

function val_scan_expr(e: ast.Expr, own acc: ValScan): ValScan {
  match (e) {
    ast.ExprIdent(id) => {
      let k: i32 = util.index_of_str(acc.names, id.name);
      if (k >= 0) {
        return ValScan { ...acc, refs: acc.refs.with(k, acc.refs[k] + 1) };
      }
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(m) = fa.obj {
        let k: i32 = util.index_of_str(acc.names, m.name + "." + fa.field);
        if (k >= 0) {
          return ValScan { ...acc, refs: acc.refs.with(k, acc.refs[k] + 1) };
        }
      }
    },
    ast.ExprCall(c) => {
      let name: string = "";
      if let ast.ExprIdent(cid) = c.callee {
        name = cid.name;
      }
      if let ast.ExprFieldAccess(cfa) = c.callee {
        if let ast.ExprIdent(cm) = cfa.obj {
          name = cm.name + "." + cfa.field;
        }
      }
      let k: i32 = util.index_of_str(acc.names, name);
      if (k >= 0) {
        return ValScan { ...acc, callee_refs: acc.callee_refs.with(k, acc.callee_refs[k] + 1) };
      }
    },
    _ => {}
  }
  return acc;
}

struct FwdScan { params: ast.ParamDecl[], evars: string[], gnames: string[], hit: boolean }

function fwd_scan_stmt(st: ast.Stmt, own acc: FwdScan): FwdScan {
  return acc;
}

function fwd_scan_expr(e: ast.Expr, own acc: FwdScan): FwdScan {
  if (acc.hit) {
    return acc;
  }
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (!util.has_str(acc.gnames, cid.name)) {
            return acc;
          }
          for arg in c.args {
            match (arg) {
              ast.ExprIdent(aid) => {
                let pi: i32 = 0;
                while (pi < acc.params.len()) {
                  if (acc.params[pi].name == aid.name && carries_erased_var(acc.params[pi], acc.evars)) {
                    return FwdScan { ...acc, hit: true };
                  }
                  pi = pi + 1;
                }
              },
              _ => {}
            }
          }
          return acc;
        },
        _ => {
          return acc;
        }
      }
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function carries_erased_var(pd: ast.ParamDecl, evars: string[]): boolean {
  if (util.has_str(evars, pd.type_name)) {
    return true;
  }
  if (!is_fn_contract_tag(pd.type_name)) {
    return false;
  }
  for v in evars {
    if (type_mentions_var(pd.fn_ret, v) || type_mentions_var(pd.fn_param_types, v)) {
      return true;
    }
  }
  return false;
}

function erased_vars_of(fd: FuncDecl): string[] {
  let vs: string[] = type_str_vars(fd.ret_type, []);
  for pd in fd.params {
    vs = type_str_vars(pd.type_name, vs);
    if (is_fn_contract_tag(pd.type_name)) {
      vs = type_str_vars(pd.fn_param_types, type_str_vars(pd.fn_ret, vs));
    }
  }
  let out: string[] = [];
  for v in vs {
    if (!util.has_str(fd.type_params, v)) {
      out = out.append(v);
    }
  }
  return out;
}

function erased_vars_bindable(params: ast.ParamDecl[], vars: string[]): boolean {
  for v in vars {
    let ok: boolean = has_fn_param_arg_var(params, v) || has_fn_param_ret_var(params, v);
    for pd in params {
      if (token_at_paren_depth0(pd.type_name, v) || token_in_tuple_param(pd.type_name, v)) {
        ok = true;
      }
    }
    if (!ok) {
      return false;
    }
  }
  return true;
}

pub function monomorphize_all(mod: Module): Module {
  let candidates: string[] = [];
  for fd in mod.funcs {
    if (is_bg_template(fd) && fn_param_promoted(fd)) {
      candidates = candidates.append(fd.name);
    }
  }
  let erased: string[] = [];
  let out: Module = monomorphize_chain(mod, erased);
  let stranded: string[] = stranded_names(out, candidates, erased);
  while (stranded.len() > 0) {
    erased = util.append_all(erased, stranded);
    out = monomorphize_chain(mod, erased);
    stranded = stranded_names(out, candidates, erased);
  }
  return out;
}

function monomorphize_chain(mod: Module, erased: string[]): Module {
  return monomorphize_enum_structs(monomorphize_enums(monomorphize_structs(monomorphize_module(mod, erased))));
}

function stranded_names(mod: Module, candidates: string[], erased: string[]): string[] {
  let out: string[] = [];
  if (candidates.len() == 0) {
    return out;
  }
  let refs: string[] = astwalk.collect_free_idents([], mod.top_stmts, []);
  for fd in mod.funcs {
    let bound: string[] = hl_param_names(fd.params);
    if (fd.receiver_name.len() > 0) {
      bound = bound.append(fd.receiver_name);
    }
    refs = astwalk.collect_free_idents(bound, fd.body, refs);
  }
  let used: util.NameIndex = util.name_index(refs);
  for name in candidates {
    if (util.has_str(erased, name)) {
      continue;
    }
    if (used.find(name) >= 0) {
      out = out.append(name);
    }
  }
  return out;
}

function fn_param_promoted(fd: FuncDecl): boolean {
  for b in fd.bound_traits {
    if (b.len() > 0) {
      return false;
    }
  }
  for v in fd.type_params {
    let plain: boolean = false;
    for pd in fd.params {
      if (token_at_paren_depth0(pd.type_name, v) || token_in_tuple_param(pd.type_name, v)) {
        plain = true;
      }
    }
    if (plain || feeds_user_parametric(fd.ret_type, v) || feeds_map_typearg(fd.ret_type, v)) {
      continue;
    }
    if (has_fn_param_arg_var(fd.params, v) || has_fn_param_ret_var(fd.params, v)) {
      return true;
    }
  }
  return false;
}

function erase_promotions(funcs: FuncDecl[], erased: string[]): FuncDecl[] {
  if (erased.len() == 0) {
    return funcs;
  }
  let out: FuncDecl[] = [];
  for fd in funcs {
    if (util.has_str(erased, fd.name) && is_bg_template(fd)) {
      out = out.append(FuncDecl { ...fd, type_params: [], bound_traits: [] });
    } else {
      out = out.append(fd);
    }
  }
  return out;
}

function monomorphize_module(mod: Module, erased: string[]): Module {
  let funcs: FuncDecl[] = erase_promotions(promote_erased_forwarders(promote_value_named(mod.funcs, mod.top_stmts)), erased);
  let any_bg: boolean = false;
  let bi: i32 = 0;
  while (bi < funcs.len()) {
    if (funcs[bi].receiver_name.len() == 0 && funcs[bi].type_params.len() > 0 || is_concrete_array_fold(funcs[bi])) {
      any_bg = true;
    }
    bi = bi + 1;
  }
  if (!any_bg) {
    return Module { ...mod, funcs: funcs };
  }

  let ins: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let fns: MFns = MFns { ...mfns_of(funcs, mod.structs, mod.enums, mod.impls), lane_bounds: lane_bound_spellings(mod) };
  let menums: EnumDecl[] = me_mono_enums(mod);
  let rewritten: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: FuncDecl = funcs[i];
    if (cloned_per_instance(fd, mod.structs, menums)) {
      rewritten = rewritten.append(fd);
    } else {
      let env: MEnv = env_from_decl(fd);
      let rb: RStmts = mono_stmts(fd.body, env, fns, ins, fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types));
      ins = rb.rins3;
      rewritten = rewritten.append(FuncDecl { ...fd, body: rb.rstmts });
    }
    i = i + 1;
  }
  let topenv: MEnv = MEnv { mnames: [], mtypes: [] };
  let tr: RStmts = mono_stmts(mod.top_stmts, topenv, fns, ins, "");
  ins = tr.rins3;

  let done: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let wi: i32 = 0;
  while (wi < ins.inames.len()) {
    let nm: string = ins.inames[wi];
    let ct: string = ins.itypes[wi];
    if (done.ihas(nm, ct)) {
      wi = wi + 1;
      continue;
    }
    done = done.iadd(nm, ct);
    let gi: i32 = bg_find(fns, nm);
    if (gi >= 0) {
      let cl: FuncDecl = clone_bg(funcs[gi], ct, mod.impls, mod.trait_reqs, fns);
      let cenv: MEnv = env_from_params(cl.params);
      let crb: RStmts = mono_stmts(cl.body, cenv, fns, ins, fn_tag_spelling(cl.ret_type, cl.ret_fn_ret, cl.ret_fn_param_types));
      ins = crb.rins3;
      rewritten = rewritten.append(FuncDecl { ...cl, receiver_name: "", receiver_type: "", body: crb.rstmts });
    }
    wi = wi + 1;
  }

  return Module { ...mod, funcs: util.append_all(rewritten, lane_map_decls(done)), top_stmts: tr.rstmts };
}

function folded_array_call(amn: string, elem: string, c: ast.ExprCall, fac: ast.ExprFieldAccess, raw: ast.Expr[], env: MEnv, funcs: MFns, ins: Insts): RExpr {
  let lkey: string = lane_map_key(amn, elem, c, env, funcs);
  if (lkey.len() > 0) {
    let lr: RExpr = mono_expr(fac.obj, env, funcs, ins);
    let kernel: string = split_inst_key(lkey)[0];
    let lins: Insts = lr.rins.iadd("__lanes_map", lkey).iadd(kernel, lane_type_of(elem)).iadd(kernel, elem);
    return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: "__lanes_map__" + sanitize_key(lkey), line: fac.line, col: fac.col, ty: "" }, args: [lr.rexpr], line: c.line, col: c.col, type_args: [], ty: c.ty }, rins: lins };
  }
  let fcall = ast.ExprCall { callee: ast.ExprIdent { name: amn, line: fac.line, col: fac.col, ty: "" }, args: raw, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
  let (folded, fins) = mono_call_args(fcall, env, funcs, ins);
  return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: amn + "__" + sanitize_key(elem), line: fac.line, col: fac.col, ty: "" }, args: folded, line: c.line, col: c.col, type_args: [], ty: c.ty }, rins: fins.iadd(amn, elem) };
}

function lane_bound_spellings(mod: Module): string[] {
  let out: string[] = [];
  for im in mod.impls {
    if (im.impl_type != "f64x2" && im.impl_type != "f32x4") {
      continue;
    }
    if (im.trait_module.len() == 0) {
      out = out.append(im.impl_type + " " + im.trait_name);
    } else if (im.trait_module == "num" || im.trait_module == "simd") {
      let q: string = std_qualifier(mod, im.trait_module);
      if (q.len() > 0) {
        out = out.append(im.impl_type + " " + q + "." + im.trait_name);
      }
    }
  }
  return out;
}

function lane_map_key(amn: string, elem: string, c: ast.ExprCall, env: MEnv, funcs: MFns): string {
  if (amn != "__arrm_map" || c.args.len() != 1 || elem != "f64" && elem != "f32") {
    return "";
  }
  let ast.ExprIdent(kid) = c.args[0] else {
    return "";
  };
  let kn: string = generic_fn_value_name(c.args[0], env, funcs);
  if (kn.len() == 0 || kn != kid.name) {
    return "";
  }
  if (!lane_kernel(funcs.decls[bg_find(funcs, kn)], elem, funcs)) {
    return "";
  }
  return kn + ";" + elem;
}

function lane_type_of(elem: string): string {
  if (elem == "f32") {
    return "f32x4";
  }
  return "f64x2";
}

function lane_kernel(fd: FuncDecl, elem: string, funcs: MFns): boolean {
  if (fd.type_params.len() != 1 || fd.params.len() != 1 || fd.receiver_name.len() > 0) {
    return false;
  }
  let tp: string = fd.type_params[0];
  if (fd.params[0].type_name != tp || fd.ret_type != tp) {
    return false;
  }
  let lanes: string = lane_type_of(elem);
  if (fd.bound_traits.len() > 0 && fd.bound_traits[0].len() > 0) {
    for entry in split_plus_bounds(fd.bound_traits[0]) {
      if (!util.has_str(funcs.lane_bounds, lanes + " " + entry)) {
        return false;
      }
    }
  }
  return lane_fusable(fd.name, [elem, lanes], funcs, []);
}

function lane_fusable(name: string, types: string[], funcs: MFns, seen: string[]): boolean {
  let gi: i32 = bg_find(funcs, name);
  if (gi < 0 || util.has_str(seen, name)) {
    return true;
  }
  let reached: string[] = [];
  for st in funcs.decls[gi].body {
    reached = astwalk.fold_stmt(st, reached, lane_reach);
  }
  let next: string[] = seen.append(name);
  for r in reached {
    if (r.len() == 0) {
      return false;
    }
    if (util.str_has_prefix(r, "!")) {
      if (bg_find(funcs, slice_unchecked(r, 1, r.len()) + "") < 0) {
        return false;
      }
    } else if (util.str_has_prefix(r, "@")) {
      if (!std_methods(slice_unchecked(r, 1, r.len()) + "", types, funcs)) {
        return false;
      }
    } else if (!lane_fusable(r, types, funcs, next)) {
      return false;
    }
  }
  return true;
}

function lane_reach(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(f) = c.callee {
      return acc.append("!" + f.name);
    }
    if let ast.ExprFieldAccess(m) = c.callee {
      return acc.append("@" + m.field);
    }
    return acc.append("");
  }
  if let ast.ExprFieldAccess(fa) = e {
    if (fa.field == "lane" || fa.field == "LANES") {
      return acc.append("");
    }
    if let ast.ExprIdent(m) = fa.obj {
      return acc.append(m.name + "." + fa.field);
    }
  }
  if let ast.ExprIdent(id) = e {
    return acc.append(id.name);
  }
  return acc;
}

function std_methods(name: string, types: string[], funcs: MFns): boolean {
  for d in funcs.decls {
    if (d.name == name && util.has_str(types, d.receiver_type) && d.stdlib.len() == 0) {
      return false;
    }
  }
  return true;
}

function lane_map_decls(done: Insts): FuncDecl[] {
  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < done.inames.len()) {
    if (done.inames[i] == "__lanes_map") {
      out = out.append(lane_map_decl(done.itypes[i]));
    }
    i = i + 1;
  }
  return out;
}

function lane_map_decl(key: string): FuncDecl {
  let parts: string[] = split_inst_key(key);
  let kernel: string = parts[0];
  let elem: string = parts[1];
  let lanes: string = lane_type_of(elem);
  let width: string = "2";
  if (lanes == "f32x4") {
    width = "4";
  }
  let arr: string = elem + "[]";
  let out: ast.Expr = e_ident("out");
  let i: ast.Expr = e_ident("i");
  let len: ast.Expr = e_call(e_field_access(out, "len"), []);
  let lane_call: ast.Expr = e_call(e_ident(kernel + "__" + sanitize_key(lanes)), [e_call(e_ident("__" + lanes + "_load"), [out, i])]);
  let wide: ast.Stmt[] = [
    s_assign("out", e_call(e_ident("__" + lanes + "_with"), [out, i, lane_call])),
    s_assign("i", e_binary("+", i, e_number(width, "", false))),
  ];
  let one_call: ast.Expr = e_call(e_ident(kernel + "__" + sanitize_key(elem)), [e_index(out, i, 0, 0)]);
  let tail: ast.Stmt[] = [
    s_assign("out", e_call(e_field_access(out, "with"), [i, one_call])),
    s_assign("i", e_binary("+", i, e_number("1", "", false))),
  ];
  let body: ast.Stmt[] = [
    s_var("out", arr, e_ident("xs")),
    s_var("i", "i32", e_number("0", "", false)),
    s_while(e_binary("<=", e_binary("+", i, e_number(width, "", false)), len), wide),
    s_while(e_binary("<", i, len), tail),
    s_return(out),
  ];
  let param: ast.ParamDecl = ast.ParamDecl { name: "xs", type_name: arr, own: false, has_default: false, default_value: e_number("0", "", false), fn_ret: "", fn_param_types: "" };
  return FuncDecl { stdlib: "", no_inline: false, name: "__lanes_map__" + sanitize_key(key), receiver_name: "", receiver_type: "", receiver_own: false, type_params: [], params: [param], ret_type: arr, body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] };
}

function is_bg_template(fd: FuncDecl): boolean {
  return fd.receiver_name.len() == 0 && fd.type_params.len() > 0;
}

function is_free_bg_template(fd: FuncDecl): boolean {
  return is_bg_template(fd) && fd.receiver_type.len() == 0;
}

function cloned_per_instance(fd: FuncDecl, structs: StructDecl[], enums: EnumDecl[]): boolean {
  return is_bg_template(fd) || is_gstruct_method(fd, structs) || is_genum_method(fd, enums);
}

function is_genum_method(fd: FuncDecl, enums: EnumDecl[]): boolean {
  let gi: i32 = genum_index(enums, strip_struct_base(fd.receiver_type));
  return fd.receiver_type.len() > 0 && gi >= 0 && enums[gi].type_params.len() > 0;
}

function is_gstruct_method(fd: FuncDecl, structs: StructDecl[]): boolean {
  if (fd.receiver_type.len() == 0) {
    return false;
  }
  let base: string = strip_struct_base(fd.receiver_type);
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == base && structs[i].type_params.len() > 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function drop_bg_templates(funcs: FuncDecl[], keep: string[]): FuncDecl[] {
  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (!is_free_bg_template(funcs[i]) || str_in(keep, funcs[i].name)) {
      out = out.append(funcs[i]);
    }
    i = i + 1;
  }
  return out;
}

function has_func_named(a: FuncDecl[], b: FuncDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < b.len()) {
    if (b[j].name == name) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

struct TyIns { ty: string, mins: Insts }

struct FRes { ffn: FuncDecl, fins: Insts }

function gstruct_index(gstructs: StructDecl[], base: string): i32 {
  let i: i32 = 0;
  while (i < gstructs.len()) {
    if (gstructs[i].name == base) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function strip_struct_base(ty: string): string {
  let lb: i32 = first_bracket(ty);
  if (lb > 0) {
    return slice_unchecked(ty, 0, lb) + "";
  }
  return ty;
}

function mg_ty(ty: string, gstructs: StructDecl[], ins: Insts): TyIns {
  if (ty.len() > 4 && slice_unchecked(ty, 0, 4) == "own ") {
    let o: TyIns = mg_ty(slice_unchecked(ty, 4, ty.len()) + "", gstructs, ins);
    return TyIns { ty: "own " + o.ty, mins: o.mins };
  }
  if (type_ends_arr(ty)) {
    let r: TyIns = mg_ty(slice_unchecked(ty, 0, ty.len() - 2), gstructs, ins);
    return TyIns { ty: r.ty + "[]", mins: r.mins };
  }
  if (ty.len() > 0 && ty[0] == b'(' && util.contains(ty, "=>")) {
    let fref: TypeRef = parse_type_ref(ty);
    if (fref.is_fn) {
      let fcur: Insts = ins;
      let fout: string = "";
      let fchanged: boolean = false;
      let fi: i32 = 0;
      while (fi + 1 < fref.args.len()) {
        let psp: string = render_type_ref(fref.args[fi]);
        let pm: TyIns = mg_ty(psp, gstructs, fcur);
        fcur = pm.mins;
        if (pm.ty != psp) {
          fchanged = true;
        }
        if (fi > 0) {
          fout = fout + ", ";
        }
        fout = fout + pm.ty;
        fi = fi + 1;
      }
      let rsp: string = render_type_ref(fref.args[fref.args.len() - 1]);
      let rm: TyIns = mg_ty(rsp, gstructs, fcur);
      fcur = rm.mins;
      if (rm.ty != rsp) {
        fchanged = true;
      }
      if (!fchanged) {
        return TyIns { ty: ty, mins: fcur };
      }
      return TyIns { ty: "(" + fout + ") => " + rm.ty, mins: fcur };
    }
  }
  if (util.is_tuple_type_name(ty) && slice_unchecked(ty, ty.len() - 1, ty.len()) == ")") {
    let tps: string[] = split_top_commas(slice_unchecked(ty, 1, ty.len() - 1));
    let tcur: Insts = ins;
    let tnin2: string = "";
    let tk: i32 = 0;
    while (tk < tps.len()) {
      let tpr: TyIns = mg_ty(tps[tk], gstructs, tcur);
      tcur = tpr.mins;
      if (tk > 0) {
        tnin2 = tnin2 + ", ";
      }
      tnin2 = tnin2 + tpr.ty;
      tk = tk + 1;
    }
    return TyIns { ty: "(" + tnin2 + ")", mins: tcur };
  }
  let lb: i32 = first_bracket(ty);
  if (lb > 0 && slice_unchecked(ty, ty.len() - 1, ty.len()) == "]") {
    let base: str = slice_unchecked(ty, 0, lb);
    let inner: str = slice_unchecked(ty, lb + 1, ty.len() - 1);
    let parts: string[] = split_top_commas(inner);
    let gsi: i32 = gstruct_index(gstructs, base);
    if (gsi >= 0 && parts.len() == gstructs[gsi].type_params.len()) {
      let cur: Insts = ins;
      let key: string = "";
      let j: i32 = 0;
      while (j < parts.len()) {
        let pr: TyIns = mg_ty(parts[j], gstructs, cur);
        cur = pr.mins;
        if (j > 0) {
          key = key + "__";
        }
        key = key + pr.ty;
        j = j + 1;
      }
      cur = cur.iadd(base, key);
      return TyIns { ty: base + "__" + sanitize_key(key), mins: cur };
    }
    let cur2: Insts = ins;
    let ninner: string = "";
    let k: i32 = 0;
    while (k < parts.len()) {
      let pr2: TyIns = mg_ty(parts[k], gstructs, cur2);
      cur2 = pr2.mins;
      if (k > 0) {
        ninner = ninner + ", ";
      }
      ninner = ninner + pr2.ty;
      k = k + 1;
    }
    return TyIns { ty: base + "[" + ninner + "]", mins: cur2 };
  }
  return TyIns { ty: ty, mins: ins };
}

function mg_ty_list(list: string, gstructs: StructDecl[], ins: Insts): TyIns {
  if (list.len() == 0) {
    return TyIns { ty: "", mins: ins };
  }
  let parts: string[] = split_top_commas(list);
  let cur: Insts = ins;
  let out: string = "";
  let i: i32 = 0;
  while (i < parts.len()) {
    let r: TyIns = mg_ty(parts[i], gstructs, cur);
    cur = r.mins;
    if (i > 0) {
      out = out + ",";
    }
    out = out + r.ty;
    i = i + 1;
  }
  return TyIns { ty: out, mins: cur };
}

function to_concrete_struct_ty(ty: string, base: string, mang: string, gstructs: StructDecl[], ins: Insts): TyIns {
  return mg_ty(replace_ident(ty, base, mang, true), gstructs, ins);
}

function to_concrete_struct_ty_list(list: string, base: string, mang: string, gstructs: StructDecl[], ins: Insts): TyIns {
  if (list.len() == 0) {
    return TyIns { ty: "", mins: ins };
  }
  let parts: string[] = split_top_commas(list);
  let out: string = "";
  let cur: Insts = ins;
  let i: i32 = 0;
  while (i < parts.len()) {
    if (i > 0) {
      out = out + ",";
    }
    let r: TyIns = to_concrete_struct_ty(parts[i], base, mang, gstructs, cur);
    cur = r.mins;
    out = out + r.ty;
    i = i + 1;
  }
  return TyIns { ty: out, mins: cur };
}

function infer_lit_key(gd: StructDecl, fnames: string[], fvals: ast.Expr[], env: MEnv, funcs: MFns): string {
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  let fi: i32 = 0;
  while (fi < gd.fields.len()) {
    let fname: string = gd.fields[fi].name;
    let vi: i32 = 0;
    while (vi < fnames.len()) {
      if (fnames[vi] == fname) {
        let ct: string = mono_infer(fvals[vi], env, funcs);
        if (ct.len() > 0) {
          binds = bind_unify(field_spelling(gd.fields[fi]), ct, gd.type_params, binds, funcs);
        }
      }
      vi = vi + 1;
    }
    fi = fi + 1;
  }
  let key: string = "";
  let k: i32 = 0;
  while (k < gd.type_params.len()) {
    let b: string = binds.elook(gd.type_params[k]);
    if (b.len() == 0) {
      return "";
    }
    if (k > 0) {
      key = key + "__";
    }
    key = key + b;
    k = k + 1;
  }
  return key;
}

function on_call_request(fa: ast.ExprFieldAccess, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): Insts {
  if (funcs.on_call.len() == 0) {
    return ins;
  }
  let sfx: string = "." + fa.field;
  for name in funcs.on_call {
    if (util.str_has_suffix(name, sfx)) {
      let base: string = slice_unchecked(name, 0, name.len() - sfx.len()) + "";
      let rt: TyIns = mg_ty(mono_infer(fa.obj, env, funcs), gstructs, ins);
      if (is_clone_of(rt.ty, base)) {
        return rt.mins.iadd(name, slice_unchecked(rt.ty, base.len() + 2, rt.ty.len()) + "");
      }
    }
  }
  return ins;
}

function ms_expr(e: ast.Expr, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  match (e) {
    ast.ExprBinary(b) => {
      let l: RExpr = ms_expr(b.left, env, gstructs, funcs, ins);
      let r: RExpr = ms_expr(b.right, env, gstructs, funcs, l.rins);
      return RExpr { rexpr: ast.ExprBinary { op: b.op, left: l.rexpr, right: r.rexpr, line: b.line, col: b.col, ty: b.ty }, rins: r.rins };
    },
    ast.ExprUnary(u) => {
      let o: RExpr = ms_expr(u.operand, env, gstructs, funcs, ins);
      return RExpr { rexpr: ast.ExprUnary { op: u.op, operand: o.rexpr, line: u.line, col: u.col, ty: u.ty }, rins: o.rins };
    },
    ast.ExprCall(c) => {
      return ms_call(c, [], env, gstructs, funcs, ins);
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < a.elements.len()) {
        let re: RExpr = ms_expr(a.elements[i], env, gstructs, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprArray { ...a, elements: els }, rins: cur };
    },
    ast.ExprTuple(t) => {
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < t.elements.len()) {
        let re: RExpr = ms_expr(t.elements[i], env, gstructs, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprTuple { elements: els, line: t.line, col: t.col }, rins: cur };
    },
    ast.ExprIndex(ix) => {
      let ar: RExpr = ms_expr(ix.array, env, gstructs, funcs, ins);
      let idx: RExpr = ms_expr(ix.index, env, gstructs, funcs, ar.rins);
      return RExpr { rexpr: ast.ExprIndex { array: ar.rexpr, index: idx.rexpr, unchecked: false, ty: ix.ty, line: ix.line, col: ix.col }, rins: idx.rins };
    },
    ast.ExprSlice(sl) => {
      let ar: RExpr = ms_expr(sl.array, env, gstructs, funcs, ins);
      let st: RExpr = ms_expr(sl.start, env, gstructs, funcs, ar.rins);
      let en: RExpr = ms_expr(sl.end, env, gstructs, funcs, st.rins);
      return RExpr { rexpr: ast.ExprSlice { ...sl, array: ar.rexpr, start: st.rexpr, end: en.rexpr }, rins: en.rins };
    },
    ast.ExprFieldAccess(fa) => {
      let o: RExpr = ms_expr(fa.obj, env, gstructs, funcs, ins);
      return RExpr { rexpr: ast.ExprFieldAccess { ...fa, obj: o.rexpr }, rins: on_call_request(fa, env, gstructs, funcs, o.rins) };
    },
    ast.ExprIdent(id) => {
      if (first_bracket(id.name) > 0 && gstruct_index(gstructs, strip_struct_base(id.name)) >= 0) {
        let mt: TyIns = mg_ty(id.name, gstructs, ins);
        return RExpr { rexpr: ast.ExprIdent { ...id, name: mt.ty }, rins: mt.mins };
      }
      return RExpr { rexpr: e, rins: ins };
    },
    ast.ExprStructLit(s) => {
      return ms_struct_lit(s, "", env, gstructs, funcs, ins);
    },
    ast.ExprLambda(lm) => {
      return ms_lambda(lm, "", env, gstructs, funcs, ins);
    },
    _ => {
      return RExpr { rexpr: e, rins: ins };
    }
  }
  return RExpr { rexpr: e, rins: ins };
}

function ms_lambda(lm: ast.ExprLambda, dest: string, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  let rt: TyIns = mg_ty(lm.ret_type, gstructs, ins);
  let rdest: string = dest;
  if (rdest.len() == 0 && !mono_ty_mentions_var(lm.ret_type)) {
    rdest = rt.ty;
  }
  let bodyr: RStmts = ms_stmts(lm.body, env, gstructs, funcs, rt.mins, rdest);
  let nparams: ast.ParamDecl[] = [];
  let pcur: Insts = bodyr.rins3;
  let pi: i32 = 0;
  while (pi < lm.params.len()) {
    let pt: TyIns = mg_ty(lm.params[pi].type_name, gstructs, pcur);
    pcur = pt.mins;
    let pr: TyIns = mg_ty(lm.params[pi].fn_ret, gstructs, pcur);
    pcur = pr.mins;
    let pl: TyIns = mg_ty_list(lm.params[pi].fn_param_types, gstructs, pcur);
    pcur = pl.mins;
    nparams = nparams.append(ast.ParamDecl { ...lm.params[pi], type_name: pt.ty, fn_ret: pr.ty, fn_param_types: pl.ty });
    pi = pi + 1;
  }
  let lrr: TyIns = mg_ty(lm.ret_fn_ret, gstructs, pcur);
  pcur = lrr.mins;
  let lrl: TyIns = mg_ty_list(lm.ret_fn_param_types, gstructs, pcur);
  pcur = lrl.mins;
  for cap in lm.captures {
    pcur = mg_ty(typeinfo.spelling(cap.ty), gstructs, pcur).mins;
  }
  function struct_clone(t: typeinfo.Type): string {
    if let typeinfo.TypeStruct(_) = t {
      let sp: string = typeinfo.spelling(t);
      let m: string = mg_ty(sp, gstructs, pcur).ty;
      if (m != sp) {
        return m;
      }
    }
    return "";
  }
  let caps: ast.TypedBinding[] = [];
  for cap in lm.captures {
    caps = caps.append(ast.TypedBinding { name: cap.name, ty: typeinfo.renamed_nominals(cap.ty, struct_clone) });
  }
  return RExpr { rexpr: ast.ExprLambda { ...lm, params: nparams, ret_type: rt.ty, ret_fn_ret: lrr.ty, ret_fn_param_types: lrl.ty, body: bodyr.rstmts, use_infer: false, captures: caps }, rins: pcur };
}

function ms_struct_lit(s: ast.ExprStructLit, dest: string, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  let cur: Insts = ins;
  let lit_dest: string = dest;
  if (s.written.len() > 0 && !mono_ty_mentions_var(s.written)) {
    let wm: TyIns = mg_ty(s.written, gstructs, cur);
    cur = wm.mins;
    lit_dest = wm.ty;
  }
  if (lit_dest.len() == 0 && s.has_base) {
    let bm: TyIns = mg_ty(mono_infer(s.base, env, funcs), gstructs, cur);
    cur = bm.mins;
    lit_dest = bm.ty;
  }
  let vals: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < s.field_values.len()) {
    let fdest: string = "";
    let fty: string = lit_field_decl_type(funcs.structs, s.type_name, s.field_names[i]);
    if (fty.len() > 0 && !mono_ty_mentions_var(fty)) {
      let fm: TyIns = mg_ty(fty, gstructs, cur);
      cur = fm.mins;
      fdest = fm.ty;
    }
    let rv: RExpr = ms_expr_to(s.field_values[i], fdest, env, gstructs, funcs, cur);
    cur = rv.rins;
    vals = vals.append(rv.rexpr);
    i = i + 1;
  }
  let rb: RExpr = ms_expr(s.base, env, gstructs, funcs, cur);
  cur = rb.rins;
  let tn: string = s.type_name;
  let gi: i32 = gstruct_index(gstructs, s.type_name);
  if (gi >= 0 && is_clone_of(lit_dest, s.type_name)) {
    tn = lit_dest;
  } else if (gi >= 0) {
    let key: string = infer_lit_key(gstructs[gi], s.field_names, vals, env, funcs);
    if (key.len() > 0) {
      tn = s.type_name + "__" + sanitize_key(key);
      cur = cur.iadd(s.type_name, key);
    }
  }
  let written: string = s.written;
  if (tn != s.type_name) {
    written = "";
  }
  return RExpr { rexpr: ast.ExprStructLit { ...s, type_name: tn, field_values: vals, base: rb.rexpr, written: written }, rins: cur };
}

function lit_field_decl_type(structs: StructDecl[], name: string, field: string): string {
  for sd in structs {
    if (sd.name == name && sd.type_params.len() == 0) {
      for f in sd.fields {
        if (f.name == field) {
          return f.type_name;
        }
      }
      return "";
    }
  }
  return "";
}

function is_clone_of(mangled: string, base: string): boolean {
  let pfx: string = base + "__";
  return mangled.len() > pfx.len() && util.str_has_prefix(mangled, pfx);
}

function ms_expr_to(e: ast.Expr, dest: string, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  if (dest.len() == 0) {
    return ms_expr(e, env, gstructs, funcs, ins);
  }
  if let ast.ExprStructLit(s) = e {
    return ms_struct_lit(s, dest, env, gstructs, funcs, ins);
  }
  if let ast.ExprCall(c) = e {
    return ms_call_to(c, dest, env, gstructs, funcs, ins);
  }
  if let ast.ExprArray(a) = e {
    if (type_ends_arr(dest)) {
      let el: string = slice_unchecked(dest, 0, dest.len() - 2) + "";
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      for x in a.elements {
        let re: RExpr = ms_expr_to(x, array_element_expected(x, el), env, gstructs, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
      }
      return RExpr { rexpr: ast.ExprArray { ...a, elements: els }, rins: cur };
    }
  }
  return ms_expr(e, env, gstructs, funcs, ins);
}

function array_element_expected(e: ast.Expr, expected: string): string {
  if (expected.len() > 0 && expected[0] == b'(' && parse_type_ref(expected).is_tuple) {
    if let ast.ExprCall(c) = e {
      if (is_value_block(c)) {
        return "";
      }
    }
  }
  return expected;
}

function ms_call_to(c: ast.ExprCall, dest: string, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  if let ast.ExprLambda(lm) = c.callee {
    if (c.args.len() == 0 && lm.params.len() == 0) {
      let rl: RExpr = ms_lambda(lm, dest, env, gstructs, funcs, ins);
      return RExpr { rexpr: ast.ExprCall { ...c, callee: rl.rexpr }, rins: rl.rins };
    }
  }
  let pd: (string[], Insts) = variant_call_dests(c, dest, env, gstructs, funcs, ins);
  return ms_call(c, pd.0, env, gstructs, funcs, pd.1);
}

function variant_call_dests(c: ast.ExprCall, dest: string, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): (string[], Insts) {
  let none: string[] = [];
  if let ast.ExprIdent(cid) = c.callee {
    if (env.elook(cid.name).len() == 0) {
      return variant_payload_dests(cid.name, dest, c.args.len(), gstructs, funcs, ins);
    }
  }
  return (none, ins);
}

function variant_payload_dests(name: string, dest: string, argc: i32, gstructs: StructDecl[], funcs: MFns, ins: Insts): (string[], Insts) {
  let none: string[] = [];
  let spelled: string[] = variant_payload_spellings(name, dest, funcs);
  if (spelled.len() == 0 || spelled.len() != argc) {
    return (none, ins);
  }
  let out: string[] = [];
  let cur: Insts = ins;
  for t in spelled {
    if (mono_ty_mentions_var(t)) {
      return (none, ins);
    }
    let m: TyIns = mg_ty(t, gstructs, cur);
    cur = m.mins;
    out = out.append(m.ty);
  }
  return (out, cur);
}

function variant_payload_spellings(name: string, dest: string, funcs: MFns): string[] {
  let base: string = strip_struct_base(dest);
  let args: string[] = type_args_of(dest);
  if (base == "Result" && args.len() == 2) {
    if (name == "Ok") {
      return [args[0]];
    }
    if (name == "Err") {
      return [args[1]];
    }
    return [];
  }
  if (base == "Option" && args.len() == 1 && name == "Some") {
    return [args[0]];
  }
  return mono_variant_field_tys(dest, name, funcs);
}

function ms_call(c: ast.ExprCall, arg_dests: string[], env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  let rc: RExpr = ms_expr(c.callee, env, gstructs, funcs, ins);
  let cur: Insts = rc.rins;
  let fname: string = "";
  if let ast.ExprIdent(cid) = c.callee {
    if (env.elook(cid.name).len() == 0) {
      fname = cid.name;
    }
  }
  let mdecl: i32 = method_decl_at(c.callee, env, funcs);
  let elem_dest: string = "";
  let elem_at: i32 = 0 - 1;
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (fa.field == "append" || fa.field == "with") {
      let rt: string = mono_infer(fa.obj, env, funcs);
      if (type_ends_arr(rt)) {
        let el: string = slice_unchecked(rt, 0, rt.len() - 2) + "";
        if (!mono_ty_mentions_var(el)) {
          let em: TyIns = mg_ty(el, gstructs, cur);
          cur = em.mins;
          elem_dest = em.ty;
          elem_at = 0;
          if (fa.field == "with") {
            elem_at = 1;
          }
        }
      }
    }
  }
  let nargs: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < c.args.len()) {
    let dest: string = "";
    let pty: string = "";
    if (fname.len() > 0) {
      pty = func_param_type_at(funcs.decls, fname, i);
    } else if (mdecl >= 0 && i < funcs.decls[mdecl].params.len()) {
      pty = funcs.decls[mdecl].params[i].type_name;
    }
    if (pty.len() > 0 && !mono_ty_mentions_var(pty)) {
      let pm: TyIns = mg_ty(pty, gstructs, cur);
      cur = pm.mins;
      dest = pm.ty;
    }
    if (i == elem_at) {
      dest = elem_dest;
    }
    if (i < arg_dests.len() && arg_dests[i].len() > 0) {
      dest = arg_dests[i];
    }
    let ra: RExpr = ms_expr_to(c.args[i], dest, env, gstructs, funcs, cur);
    cur = ra.rins;
    nargs = nargs.append(ra.rexpr);
    i = i + 1;
  }
  let targs: string[] = [];
  for ta in c.type_args {
    if (ta.len() > 0 && !mono_ty_mentions_var(ta)) {
      let tm: TyIns = mg_ty(ta, gstructs, cur);
      cur = tm.mins;
      targs = targs.append(tm.ty);
    } else {
      targs = targs.append(ta);
    }
  }
  return RExpr { rexpr: ast.ExprCall { callee: rc.rexpr, args: nargs, line: c.line, col: c.col, type_args: targs, ty: c.ty }, rins: cur };
}

function method_decl_at(callee: ast.Expr, env: MEnv, funcs: MFns): i32 {
  if let ast.ExprFieldAccess(fa) = callee {
    let rt: string = mono_infer(fa.obj, env, funcs);
    if (rt.len() == 0) {
      return 0 - 1;
    }
    let i: i32 = 0;
    while (i < funcs.decls.len()) {
      let d: FuncDecl = funcs.decls[i];
      if (d.name == fa.field && d.receiver_name.len() > 0 && d.receiver_type == rt && d.all_type_params.len() == 0) {
        return i;
      }
      i = i + 1;
    }
  }
  return 0 - 1;
}

function retype_assoc_ctor(init: ast.Expr, dest: string, gstructs: StructDecl[], funcs: MFns): ast.Expr {
  let base: string = assoc_call_base(init);
  if (base.len() > 0 && gstruct_index(gstructs, base) >= 0) {
    return retype_assoc_call(init, base, dest, funcs);
  }
  return init;
}

function retype_enum_assoc(init: ast.Expr, dest: string, enums: EnumDecl[], funcs: MFns): ast.Expr {
  let base: string = assoc_call_base(init);
  if (base.len() > 0 && genum_index(enums, base) >= 0) {
    return retype_assoc_call(init, base, dest, funcs);
  }
  return init;
}

function assoc_call_base(e: ast.Expr): string {
  if let ast.ExprCall(c) = e {
    if let ast.ExprFieldAccess(fa) = c.callee {
      if let ast.ExprIdent(oid) = fa.obj {
        return oid.name;
      }
    }
  }
  return "";
}

function retype_assoc_call(init: ast.Expr, base: string, dest: string, funcs: MFns): ast.Expr {
  if let ast.ExprCall(c) = init {
    if let ast.ExprFieldAccess(fa) = c.callee {
      let concrete: string = assoc_ctor_concrete(base, fa.field, dest, funcs);
      if let ast.ExprIdent(oid) = fa.obj {
        if (concrete.len() > base.len() + 2 && util.str_has_prefix(concrete, base + "__")) {
          let obj: ast.Expr = ast.ExprIdent { ...oid, name: concrete, ty: "" };
          return ast.ExprCall { ...c, callee: ast.ExprFieldAccess { ...fa, obj: obj } };
        }
      }
    }
  }
  return init;
}

function assoc_ctor_concrete(base: string, method: string, dest: string, funcs: MFns): string {
  let ret: string = "";
  for fd in funcs.decls {
    if (fd.name == method && fd.receiver_name.len() == 0 && strip_struct_base(fd.receiver_type) == base) {
      ret = fd.ret_type;
    }
  }
  if (ret.len() == 0 || strip_struct_base(ret) == base) {
    return dest;
  }
  let binds: MEnv = bind_unify(drop_type_args(ret, base), dest, [base], MEnv { mnames: [], mtypes: [] }, funcs);
  return binds.elook(base);
}

function drop_type_args(ty: string, name: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < ty.len()) {
    let at_name: boolean = i + name.len() <= ty.len() && slice_unchecked(ty, i, i + name.len()) == name
      && (i == 0 || !ident_byte(ty[i - 1] as i32));
    if (at_name && i + name.len() < ty.len() && ty[i + name.len()] == b'[') {
      out = out + name;
      let depth: i32 = 0;
      let j: i32 = i + name.len();
      while (j < ty.len()) {
        if (ty[j] == b'[') {
          depth = depth + 1;
        } else if (ty[j] == b']') {
          depth = depth - 1;
          if (depth == 0) {
            break;
          }
        }
        j = j + 1;
      }
      i = j + 1;
    } else {
      out = out + slice_unchecked(ty, i, i + 1);
      i = i + 1;
    }
  }
  return out;
}

function ms_var_ty(ann: string, init: ast.Expr, ninit: ast.Expr, env: MEnv, gstructs: StructDecl[], funcs: MFns): string {
  if (ann.len() > 0) {
    return ann;
  }
  match (init) {
    ast.ExprStructLit(sl) => {
      if (gstruct_index(gstructs, sl.type_name) < 0) {
        return "";
      }
      match (ninit) {
        ast.ExprStructLit(nsl) => {
          if (nsl.type_name != sl.type_name) {
            return nsl.type_name;
          }
        },
        _ => {}
      }
      return "";
    },
    _ => {}
  }
  if (number_literal_tree(init)) {
    return "";
  }
  let t: string = mono_infer(ninit, env, funcs);
  if (t.len() == 0) {
    if let ast.ExprCall(sc) = ninit {
      let scn: string = "";
      match (sc.callee) {
        ast.ExprIdent(sid) => {
          scn = sid.name;
        },
        ast.ExprFieldAccess(sfa) => {
          scn = sfa.field;
        },
        _ => {}
      }
      if (sc.args.len() == 1 && scn == "Some") {
        let pt: string = mono_infer(sc.args[0], env, funcs);
        if (pt.len() > 0 && !number_literal_tree(sc.args[0])) {
          t = "Option[" + pt + "]";
        }
      } else if (!any_number_literal(sc.args)) {
        t = variant_ctor_spelling(sc.callee, sc.args, env, funcs);
      }
    }
  }
  if (ms_concrete_ty(t, gstructs, funcs)) {
    return t;
  }
  return "";
}

function any_number_literal(es: ast.Expr[]): boolean {
  let i: i32 = 0;
  while (i < es.len()) {
    if (number_literal_tree(es[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function ms_concrete_ty(t: string, gstructs: StructDecl[], funcs: MFns): boolean {
  if (t.len() == 0 || mono_ty_mentions_var(t)) {
    return false;
  }
  let i: i32 = 0;
  let n: i32 = t.len();
  while (i < n) {
    if (tv_word_char(t[i] as i32)) {
      let start: i32 = i;
      while (i < n && tv_word_char(t[i] as i32)) {
        i = i + 1;
      }
      let tok: string = slice_unchecked(t, start, i) + "";
      if (gstruct_index(gstructs, tok) >= 0 && (i >= n || t[i] != b'[')) {
        return false;
      }
    } else {
      i = i + 1;
    }
  }
  return true;
}

function ms_elem_ty(t: string, gstructs: StructDecl[], funcs: MFns): string {
  if (!type_ends_arr(t)) {
    return "";
  }
  let el: string = elem_spelling(t);
  if (ms_concrete_ty(el, gstructs, funcs)) {
    return el;
  }
  return "";
}

// A destructure marker retains its field list and identifies the concrete struct clone.
function mg_var_type(v: ast.StmtVar, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): TyIns {
  if (!is_struct_destr_marker(v.type_name)) {
    return mg_ty(v.type_name, gstructs, ins);
  }
  let start: i32 = util.index_of_sub(v.type_name, "@sd:") + 4;
  let tail: string = slice_unchecked(v.type_name, start, v.type_name.len()) + "";
  let colon: i32 = util.index_of_sub(tail, ":");
  if (colon < 0) {
    return TyIns { ty: v.type_name, mins: ins };
  }
  let head: string = slice_unchecked(tail, 0, colon) + "";
  let init: string = mono_infer(v.init, env, funcs);
  if (gstruct_index(gstructs, head) < 0 || parse_type_ref(init).base != head) {
    return TyIns { ty: v.type_name, mins: ins };
  }
  let named: TyIns = mg_ty(init, gstructs, ins);
  return TyIns { ty: slice_unchecked(v.type_name, 0, start) + named.ty + slice_unchecked(tail, colon, tail.len()), mins: named.mins };
}

function ms_stmt(st: ast.Stmt, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts, ret_ty: string): RStmtOne {
  match (st) {
    ast.StmtVar(v) => {
      let ta: TyIns = mg_var_type(v, env, gstructs, funcs, ins);
      let iv: RExpr = ms_expr_to(v.init, ta.ty, env, gstructs, funcs, ta.mins);
      let ninit: ast.Expr = retype_assoc_ctor(iv.rexpr, ta.ty, gstructs, funcs);
      let vr: TyIns = mg_ty(v.fn_ret, gstructs, iv.rins);
      let vl: TyIns = mg_ty_list(v.fn_param_types, gstructs, vr.mins);
      return RStmtOne { rstmt: ast.StmtVar { name: v.name, type_name: ta.ty, init: ninit, line: v.line, col: v.col, fn_ret: vr.ty, fn_param_types: vl.ty }, renv: env.ebind(v.name, ms_var_ty(ta.ty, v.init, ninit, env, gstructs, funcs)), rins2: vl.mins };
    },
    ast.StmtReturn(r) => {
      let rv: RExpr = ms_expr_to(r.value, ret_ty, env, gstructs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtReturn { value: retype_assoc_ctor(rv.rexpr, ret_ty, gstructs, funcs), line: r.line, col: r.col }, renv: env, rins2: rv.rins };
    },
    ast.StmtExpr(x) => {
      let xv: RExpr = ms_expr(x.value, env, gstructs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtExpr { value: xv.rexpr, line: 0 }, renv: env, rins2: xv.rins };
    },
    ast.StmtAssign(a) => {
      let dest: string = env.elook(a.target);
      let av: RExpr = ms_expr_to(a.value, dest, env, gstructs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtAssign { target: a.target, value: retype_assoc_ctor(av.rexpr, dest, gstructs, funcs), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, renv: env, rins2: av.rins };
    },
    ast.StmtIf(f) => {
      let cv: RExpr = ms_expr(f.cond, env, gstructs, funcs, ins);
      let tb: RStmts = ms_stmts(f.then_body, env, gstructs, funcs, cv.rins, ret_ty);
      let eb: RStmts = ms_stmts(f.else_body, env, gstructs, funcs, tb.rins3, ret_ty);
      return RStmtOne { rstmt: ast.StmtIf { cond: cv.rexpr, then_body: tb.rstmts, else_body: eb.rstmts, line: 0, else_chained: false, sugar: no_match_sugar(), origin: "" }, renv: env, rins2: eb.rins3 };
    },
    ast.StmtWhile(w) => {
      let cv: RExpr = ms_expr(w.cond, env, gstructs, funcs, ins);
      let wb: RStmts = ms_stmts(w.body, env, gstructs, funcs, cv.rins, ret_ty);
      return RStmtOne { rstmt: ast.StmtWhile { cond: cv.rexpr, body: wb.rstmts, label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo }, renv: env, rins2: wb.rins3 };
    },
    ast.StmtFor(fr) => {
      let it: RExpr = ms_expr(fr.iter, env, gstructs, funcs, ins);
      let benv: MEnv = env.ebind(fr.var_name, ms_elem_ty(mono_infer(it.rexpr, env, funcs), gstructs, funcs));
      let fb: RStmts = ms_stmts(fr.body, benv, gstructs, funcs, it.rins, ret_ty);
      return RStmtOne { rstmt: ast.StmtFor { var_name: fr.var_name, iter: it.rexpr, body: fb.rstmts, label: fr.label, line: fr.line, col: fr.col }, renv: env, rins2: fb.rins3 };
    },
    ast.StmtMatch(m) => {
      let sv: RExpr = ms_expr(m.scrutinee, env, gstructs, funcs, ins);
      let arms: ast.MatchArm[] = [];
      let cur: Insts = sv.rins;
      let i: i32 = 0;
      let sty: string = mono_infer(sv.rexpr, env, funcs);
      while (i < m.arms.len()) {
        let aenv: MEnv = mono_arm_env(env, m.arms[i].pattern, sty, funcs);
        let guard: ast.Expr = m.arms[i].guard;
        if (m.arms[i].has_guard) {
          let g: RExpr = ms_expr(guard, aenv, gstructs, funcs, cur);
          guard = g.rexpr;
          cur = g.rins;
        }
        let ab: RStmts = ms_stmts(m.arms[i].body, aenv, gstructs, funcs, cur, ret_ty);
        cur = ab.rins3;
        arms = arms.append(ast.MatchArm { pattern: m.arms[i].pattern, body: ab.rstmts, line: m.arms[i].line, col: m.arms[i].col, guard: guard, has_guard: m.arms[i].has_guard, alt_cont: false });
        i = i + 1;
      }
      return RStmtOne { rstmt: ast.StmtMatch { ...m, scrutinee: sv.rexpr, arms: arms }, renv: env, rins2: cur };
    },
    ast.StmtDefer(d) => {
      let act: RStmtOne = ms_stmt(d.action, env, gstructs, funcs, ins, ret_ty);
      return RStmtOne { rstmt: ast.StmtDefer { ...d, action: act.rstmt }, renv: env, rins2: act.rins2 };
    },
    _ => {
      return RStmtOne { rstmt: st, renv: env, rins2: ins };
    }
  }
  return RStmtOne { rstmt: st, renv: env, rins2: ins };
}

function ms_stmts(stmts: ast.Stmt[], env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts, ret_ty: string): RStmts {
  let out: ast.Stmt[] = [];
  let e2: MEnv = env;
  let cur: Insts = ins;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let rs: RStmtOne = ms_stmt(stmts[i], e2, gstructs, funcs, cur, ret_ty);
    out = out.append(rs.rstmt);
    e2 = rs.renv;
    cur = rs.rins2;
    i = i + 1;
  }
  return RStmts { rstmts: out, rins3: cur };
}

function ms_func(fn: FuncDecl, gstructs: StructDecl[], funcs: MFns, ins: Insts): FRes {
  let cur: Insts = ins;
  let nparams: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < fn.params.len()) {
    let pt: TyIns = mg_ty(fn.params[i].type_name, gstructs, cur);
    cur = pt.mins;
    let pr: TyIns = mg_ty(fn.params[i].fn_ret, gstructs, cur);
    cur = pr.mins;
    let pl: TyIns = mg_ty_list(fn.params[i].fn_param_types, gstructs, cur);
    cur = pl.mins;
    nparams = nparams.append(ast.ParamDecl { ...fn.params[i], type_name: pt.ty, fn_ret: pr.ty, fn_param_types: pl.ty });
    i = i + 1;
  }
  let rt: TyIns = mg_ty(fn.ret_type, gstructs, cur);
  cur = rt.mins;
  let rfr: TyIns = mg_ty(fn.ret_fn_ret, gstructs, rt.mins);
  cur = rfr.mins;
  let rfl: TyIns = mg_ty_list(fn.ret_fn_param_types, gstructs, cur);
  cur = rfl.mins;
  let rcv: TyIns = mg_ty(fn.receiver_type, gstructs, cur);
  cur = rcv.mins;
  let br: RStmts = ms_stmts(fn.body, env_from_decl(fn), gstructs, funcs, cur, rt.ty);
  cur = br.rins3;
  return FRes {
    ffn: FuncDecl { ...fn, receiver_type: rcv.ty, params: nparams, ret_type: rt.ty, ret_fn_ret: rfr.ty, ret_fn_param_types: rfl.ty, body: br.rstmts },
    fins: cur,
  };
}

function clone_struct_method(m: FuncDecl, base: string, key: string, gstructs: StructDecl[], mod: Module, funcs: MFns, ins: Insts): FRes {
  let gsi: i32 = gstruct_index(gstructs, base);
  let tparams: string[] = m.type_params;
  if (gsi >= 0) {
    tparams = gstructs[gsi].type_params;
  }
  let cts: string[] = split_key(key, tparams.len(), mod.structs, mod.enums);
  let spelled: string[] = struct_receiver_typevars(m.receiver_type);
  if (spelled.len() == cts.len()) {
    tparams = spelled;
  }
  let mang: string = base + "__" + sanitize_key(key);
  let bsegs: string[] = split_dunder(base);
  let bare_base: string = bsegs[bsegs.len() - 1];
  let cur: Insts = ins;
  let nparams: ast.ParamDecl[] = [];
  for p in m.params {
    let pt: TyIns = to_concrete_struct_ty(subst_ty(replace_struct_ident(p.type_name, bare_base, base), tparams, cts), base, mang, gstructs, cur);
    let pr: TyIns = to_concrete_struct_ty(subst_ty(p.fn_ret, tparams, cts), base, mang, gstructs, pt.mins);
    let pl: TyIns = to_concrete_struct_ty_list(subst_ty_list(p.fn_param_types, tparams, cts), base, mang, gstructs, pr.mins);
    cur = pl.mins;
    nparams = nparams.append(ast.ParamDecl { ...p, type_name: pt.ty, fn_ret: pr.ty, fn_param_types: pl.ty });
  }
  let rt: TyIns = to_concrete_struct_ty(subst_ty(replace_struct_ident(m.ret_type, bare_base, base), tparams, cts), base, mang, gstructs, cur);
  let rr: TyIns = to_concrete_struct_ty(subst_ty(m.ret_fn_ret, tparams, cts), base, mang, gstructs, rt.mins);
  let rl: TyIns = to_concrete_struct_ty_list(subst_ty_list(m.ret_fn_param_types, tparams, cts), base, mang, gstructs, rr.mins);
  let notp: string[] = [];
  return FRes {
    ffn: FuncDecl { ...m, receiver_type: mang, type_params: notp, all_type_params: [], params: nparams, ret_type: rt.ty, ret_fn_ret: rr.ty, ret_fn_param_types: rl.ty, body: subst_stmts(method_bound_rewritten(m, tparams, cts, mod.trait_reqs, funcs), tparams, cts), bound_traits: [] },
    fins: rl.mins,
  };
}

pub function monomorphize_structs(mod: Module): Module {
  return ms_module(mod);
}

pub function monomorphize_enum_structs(mod: Module): Module {
  return ms_module(mod);
}

function ms_deferred_enums(mod: Module, gstructs: StructDecl[]): string[] {
  let out: string[] = [];
  for sd in mod.structs {
    if (sd.enum_owner.len() == 0 || genum_index(mod.enums, sd.enum_owner) < 0 || str_in(out, sd.enum_owner)) {
      continue;
    }
    if (mod.enums[genum_index(mod.enums, sd.enum_owner)].type_params.len() == 0) {
      continue;
    }
    for f in sd.fields {
      if (ms_names_gstruct(f.type_name, gstructs) || ms_names_gstruct(f.fn_ret, gstructs) || ms_names_gstruct(f.fn_param_types, gstructs)) {
        out = out.append(sd.enum_owner);
        break;
      }
    }
  }
  let generics: string[] = [];
  for g in mod.funcs {
    if (g.receiver_type.len() == 0 && g.type_params.len() > 0) {
      generics = generics.append(g.name);
    }
  }
  for fd in mod.funcs {
    let owner: string = strip_struct_base(fd.receiver_type);
    if (fd.receiver_type.len() == 0 || genum_index(mod.enums, owner) < 0 || str_in(out, owner)) {
      continue;
    }
    if (mod.enums[genum_index(mod.enums, owner)].type_params.len() == 0) {
      continue;
    }
    if (ms_fn_names_gstruct(fd, gstructs) || ms_callees_name_gstruct(fd, mod.funcs, generics, gstructs)) {
      out = out.append(owner);
    }
  }
  return out;
}

function ms_enum_clone_ty(ty: string, enums: EnumDecl[]): string {
  let insts: Insts = me_collect_anno(ty, enums, Insts { inames: [], itypes: [], iargs: [] });
  if (insts.inames.len() == 0) {
    return ty;
  }
  let k: i32 = 0;
  while (k < insts.inames.len()) {
    if (!enum_clone_exists(enums, insts.inames[k] + "__" + insts.itypes[k])) {
      return ty;
    }
    k = k + 1;
  }
  return me_rewrite_ty(ty, enums);
}

function enum_clone_exists(enums: EnumDecl[], name: string): boolean {
  for ed in enums {
    if (ed.name == name && ed.type_params.len() == 0) {
      return true;
    }
  }
  return false;
}

function ms_fn_names_gstruct(fd: FuncDecl, gstructs: StructDecl[]): boolean {
  let names: boolean = ms_names_gstruct(fd.ret_type, gstructs) || ms_names_gstruct(fd.ret_fn_ret, gstructs);
  for p in fd.params {
    if (ms_names_gstruct(p.type_name, gstructs) || ms_names_gstruct(p.fn_ret, gstructs)) {
      names = true;
    }
  }
  let u: MsNames = MsNames { gstructs: gstructs, hit: names };
  for st in fd.body {
    u = astwalk.fold_stmt_nodes(st, u, ms_names_stmt, ms_names_expr, astwalk.descend_all);
  }
  return u.hit;
}

function ms_callees_name_gstruct(fd: FuncDecl, funcs: FuncDecl[], generics: string[], gstructs: StructDecl[]): boolean {
  let refs: BgRefs = bg_refs_body(fd.body, BgRefs { names: generics, hit: [] });
  let i: i32 = 0;
  while (i < refs.hit.len()) {
    for g in funcs {
      if (g.name == refs.hit[i] && g.receiver_type.len() == 0 && g.type_params.len() > 0) {
        if (ms_fn_names_gstruct(g, gstructs)) {
          return true;
        }
        refs = bg_refs_body(g.body, refs);
      }
    }
    i = i + 1;
  }
  return false;
}

struct MsNames { gstructs: StructDecl[], hit: boolean }

function ms_names_stmt(st: ast.Stmt, own u: MsNames): MsNames {
  if let ast.StmtVar(v) = st {
    if (ms_names_gstruct(v.type_name, u.gstructs) || ms_names_gstruct(v.fn_ret, u.gstructs)) {
      return MsNames { ...u, hit: true };
    }
  }
  return u;
}

function ms_names_expr(e: ast.Expr, own u: MsNames): MsNames {
  match (e) {
    ast.ExprStructLit(sl) => {
      if (gstruct_index(u.gstructs, strip_struct_base(sl.type_name)) >= 0) {
        return MsNames { ...u, hit: true };
      }
    },
    ast.ExprLambda(lm) => {
      for p in lm.params {
        if (ms_names_gstruct(p.type_name, u.gstructs)) {
          return MsNames { ...u, hit: true };
        }
      }
      if (ms_names_gstruct(lm.ret_type, u.gstructs)) {
        return MsNames { ...u, hit: true };
      }
    },
    _ => {}
  }
  return u;
}

function ms_names_gstruct(ty: string, gstructs: StructDecl[]): boolean {
  if (ty.len() == 0) {
    return false;
  }
  return mg_ty_list(ty, gstructs, Insts { inames: [], itypes: [], iargs: [] }).mins.inames.len() > 0;
}

function ms_deferred_owner(sd_owner: string, receiver_type: string, deferred: string[]): boolean {
  if (sd_owner.len() > 0) {
    return str_in(deferred, sd_owner);
  }
  return receiver_type.len() > 0 && str_in(deferred, strip_struct_base(receiver_type));
}

function plain_struct_named(structs: StructDecl[], name: string): boolean {
  for sd in structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return true;
    }
  }
  return false;
}

function ms_clone_method(mm: FuncDecl, key: string, gstructs: StructDecl[], mod: Module, sfns: MFns, ins: Insts): FRes {
  let cr: FRes = clone_struct_method(mm, strip_struct_base(mm.receiver_type), key, gstructs, mod, sfns, ins);
  let clm: FuncDecl = cr.ffn;
  let menv: MEnv = env_from_decl(clm);
  let mr: RStmts = mono_stmts(clm.body, menv, sfns, cr.fins, fn_tag_spelling(clm.ret_type, clm.ret_fn_ret, clm.ret_fn_param_types));
  let br2: RStmts = ms_stmts(mr.rstmts, menv, gstructs, sfns, mr.rins3, clm.ret_type);
  return FRes { ffn: FuncDecl { ...clm, body: br2.rstmts }, fins: br2.rins3 };
}

function wrapping_methods(funcs: FuncDecl[], gstructs: StructDecl[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    let base: string = strip_struct_base(fd.receiver_type);
    if (fd.receiver_type.len() > 0 && gstruct_index(gstructs, base) >= 0 && wraps(parse_type_ref(fd.ret_type), fd.receiver_type, gstructs)) {
      out = out.append(base + "." + fd.name);
    }
  }
  return out;
}

function wraps(t: TypeRef, recv: string, gstructs: StructDecl[]): boolean {
  let generic: boolean = !t.is_tuple && !t.is_fn && gstruct_index(gstructs, t.base) >= 0;
  for a in t.args {
    if (generic && util.contains(render_type_ref(a), recv) || wraps(a, recv, gstructs)) {
      return true;
    }
  }
  return false;
}

function on_call_template(funcs: FuncDecl[], name: string): FuncDecl {
  let at: i32 = 0;
  while (strip_struct_base(funcs[at].receiver_type) + "." + funcs[at].name != name) {
    at = at + 1;
  }
  return funcs[at];
}

struct MsClones { fns: FuncDecl[], ins: Insts }

function ms_clone_methods(fns: FuncDecl[], mod: Module, base: string, key: string, gstructs: StructDecl[], sfns: MFns, ins: Insts): MsClones {
  let out: MsClones = MsClones { fns: fns, ins: ins };
  for mm in mod.funcs {
    if (mm.receiver_type.len() > 0 && strip_struct_base(mm.receiver_type) == base && util.index_of_str(sfns.on_call, base + "." + mm.name) < 0) {
      let cm: FRes = ms_clone_method(mm, key, gstructs, mod, sfns, out.ins);
      out = MsClones { fns: out.fns.append(cm.ffn), ins: cm.fins };
    }
  }
  return out;
}

function ms_module(mod: Module): Module {
  let gstructs: StructDecl[] = [];
  let gi: i32 = 0;
  while (gi < mod.structs.len()) {
    if (mod.structs[gi].type_params.len() > 0) {
      gstructs = gstructs.append(mod.structs[gi]);
    }
    gi = gi + 1;
  }
  let enum_refs: string[] = genum_bg_refs(mod.funcs, mod.enums);
  if (gstructs.len() == 0) {
    return Module { ...mod, funcs: drop_bg_templates(mod.funcs, enum_refs) };
  }
  let deferred: string[] = ms_deferred_enums(mod, gstructs);
  let keep: boolean = deferred.len() > 0;

  let ins: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let sfns: MFns = MFns { ...mfns_of(mod.funcs, mod.structs, mod.enums, mod.impls), on_call: wrapping_methods(mod.funcs, gstructs) };

  let nstructs: StructDecl[] = [];
  let si: i32 = 0;
  while (si < mod.structs.len()) {
    let sd: StructDecl = mod.structs[si];
    if (keep && (sd.type_params.len() > 0 || ms_deferred_owner(sd.enum_owner, "", deferred))) {
      nstructs = nstructs.append(sd);
    } else if (sd.type_params.len() == 0) {
      let nf: StructFieldDecl[] = [];
      let fj: i32 = 0;
      while (fj < sd.fields.len()) {
        let ft: TyIns = mg_ty(sd.fields[fj].type_name, gstructs, ins);
        let ffr: TyIns = mg_ty(sd.fields[fj].fn_ret, gstructs, ft.mins);
        let ffl: TyIns = mg_ty_list(sd.fields[fj].fn_param_types, gstructs, ffr.mins);
        ins = ffl.mins;
        nf = nf.append(StructFieldDecl { name: sd.fields[fj].name, type_name: ft.ty, fn_ret: ffr.ty, fn_param_types: ffl.ty });
        fj = fj + 1;
      }
      nstructs = nstructs.append(StructDecl { name: sd.name, fields: nf, type_params: [], derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume, variant_field_names: sd.variant_field_names, is_pub: sd.is_pub, is_package: false, opaque: sd.opaque, module: sd.module });
    }
    si = si + 1;
  }

  let nfuncs: FuncDecl[] = [];
  let fi2: i32 = 0;
  while (fi2 < mod.funcs.len()) {
    let fn: FuncDecl = mod.funcs[fi2];
    let rbase: string = strip_struct_base(fn.receiver_type);
    if (keep && (gstruct_index(gstructs, rbase) >= 0 || is_bg_template(fn) || ms_deferred_owner("", fn.receiver_type, deferred))) {
      nfuncs = nfuncs.append(fn);
    } else if (fn.receiver_type.len() > 0 && gstruct_index(gstructs, rbase) >= 0) {} else if (is_free_bg_template(fn)) {} else {
      let fr: FRes = ms_func(fn, gstructs, sfns, ins);
      ins = fr.fins;
      nfuncs = nfuncs.append(fr.ffn);
    }
    fi2 = fi2 + 1;
  }

  nfuncs = util.append_all(nfuncs, enum_bg_templates(mod.funcs, enum_refs, keep));
  let topenv: MEnv = MEnv { mnames: [], mtypes: [] };
  let tr: RStmts = ms_stmts(mod.top_stmts, topenv, gstructs, sfns, ins, "");
  ins = tr.rins3;

  let done: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let wi: i32 = 0;
  while (wi < ins.inames.len()) {
    let base: string = ins.inames[wi];
    let key: string = ins.itypes[wi];
    if (done.ihas(base, key)) {
      wi = wi + 1;
      continue;
    }
    done = done.iadd(base, key);
    if (util.index_of_str(sfns.on_call, base) >= 0) {
      let cm: FRes = ms_clone_method(on_call_template(mod.funcs, base), key, gstructs, mod, sfns, ins);
      ins = cm.fins;
      nfuncs = nfuncs.append(cm.ffn);
      wi = wi + 1;
      continue;
    }
    let idx: i32 = gstruct_index(gstructs, base);
    if (idx < 0) {
      let bgi: i32 = bg_find(sfns, base);
      if (bgi >= 0 && !has_func_named(mod.funcs, nfuncs, base + "__" + sanitize_key(key))) {
        let bcl: FuncDecl = clone_bg(sfns.decls[bgi], key, mod.impls, mod.trait_reqs, sfns);
        let bcr: RStmts = mono_stmts(bcl.body, env_from_params(bcl.params), sfns, ins, fn_tag_spelling(bcl.ret_type, bcl.ret_fn_ret, bcl.ret_fn_param_types));
        ins = bcr.rins3;
        let bfr: FRes = ms_func(FuncDecl { ...bcl, body: bcr.rstmts }, gstructs, sfns, ins);
        ins = bfr.fins;
        nfuncs = nfuncs.append(bfr.ffn);
      }
    }
    if (idx >= 0 && plain_struct_named(mod.structs, base + "__" + sanitize_key(key))) {
      idx = 0 - 1;
    }
    if (idx >= 0) {
      let gd: StructDecl = gstructs[idx];
      let cts: string[] = split_key(key, gd.type_params.len(), mod.structs, mod.enums);
      let mang: string = base + "__" + sanitize_key(key);
      let cf: StructFieldDecl[] = [];
      let cfi: i32 = 0;
      while (cfi < gd.fields.len()) {
        let subbed: string = ms_enum_clone_ty(subst_ty(gd.fields[cfi].type_name, gd.type_params, cts), mod.enums);
        let ft2: TyIns = mg_ty(subbed, gstructs, ins);
        let gfr: TyIns = mg_ty(ms_enum_clone_ty(subst_ty(gd.fields[cfi].fn_ret, gd.type_params, cts), mod.enums), gstructs, ft2.mins);
        let gfl: TyIns = mg_ty_list(ms_enum_clone_ty(subst_ty_list(gd.fields[cfi].fn_param_types, gd.type_params, cts), mod.enums), gstructs, gfr.mins);
        ins = gfl.mins;
        cf = cf.append(StructFieldDecl { name: gd.fields[cfi].name, type_name: ft2.ty, fn_ret: gfr.ty, fn_param_types: gfl.ty });
        cfi = cfi + 1;
      }
      nstructs = nstructs.append(StructDecl { name: mang, fields: cf, type_params: [], derives: gd.derives, line: gd.line, col: gd.col, enum_owner: gd.enum_owner, must_consume: gd.must_consume, variant_field_names: gd.variant_field_names, is_pub: true, is_package: false, opaque: gd.opaque, module: gd.module });
      let cms: MsClones = ms_clone_methods(nfuncs, mod, base, key, gstructs, sfns, ins);
      ins = cms.ins;
      nfuncs = cms.fns;
    }
    wi = wi + 1;
  }

  return Module { ...mod, funcs: nfuncs, structs: nstructs, top_stmts: tr.rstmts };
}

function genum_index(enums: EnumDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < enums.len()) {
    if (enums[i].name == name && enums[i].type_params.len() > 0) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function genum_owner_of_variant(enums: EnumDecl[], vname: string): i32 {
  let i: i32 = 0;
  while (i < enums.len()) {
    if (enums[i].type_params.len() > 0) {
      let vn: string[] = enums[i].variant_names;
      let j: i32 = 0;
      while (j < vn.len()) {
        if (vn[j] == vname) {
          return i;
        }
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

function is_simple_key(key: string): boolean {
  if (key.len() == 0) {
    return false;
  }
  if (util.contains(key, "[")) {
    return false;
  }
  if (util.contains(key, " ")) {
    return false;
  }
  if (util.contains(key, "(")) {
    return false;
  }
  return true;
}

function genum_single_arg(ty: string): string {
  let lb: i32 = first_bracket(ty);
  if (lb <= 0) {
    return "";
  }
  if (slice_unchecked(ty, ty.len() - 1, ty.len()) != "]") {
    return "";
  }
  let parts: string[] = split_top_commas(slice_unchecked(ty, lb + 1, ty.len() - 1));
  if (parts.len() != 1) {
    return "";
  }
  return parts[0];
}

function genum_key_from_anno(ty: string, base: string, enums: EnumDecl[]): string {
  let lb: i32 = first_bracket(ty);
  if (lb <= 0) {
    return "";
  }
  if (slice_unchecked(ty, ty.len() - 1, ty.len()) != "]") {
    return "";
  }
  if (slice_unchecked(ty, 0, lb) != base) {
    return "";
  }
  let parts: string[] = split_top_commas(slice_unchecked(ty, lb + 1, ty.len() - 1));
  let gei: i32 = genum_index(enums, base);
  if (gei >= 0 && parts.len() != enums[gei].type_params.len()) {
    return "";
  }
  for p in parts {
    if (mono_ty_mentions_var(p)) {
      return "";
    }
  }
  if (parts.len() == 1) {
    return ge_targ_mangle(parts[0], enums);
  }
  let key: string = "";
  let j: i32 = 0;
  while (j < parts.len()) {
    if (j > 0) {
      key = key + "__";
    }
    let p: string = parts[j];
    if (first_bracket(p) >= 0) {
      return "";
    }
    if (util.contains(p, " ")) {
      return "";
    }
    if (util.contains(p, "(")) {
      return "";
    }
    key = key + p;
    j = j + 1;
  }
  return key;
}

struct GEInst { ok: boolean, base: string, key: string, mang: string }

function ge_inst_of(ty: string, enums: EnumDecl[]): GEInst {
  let lb: i32 = first_bracket(ty);
  if (lb <= 0) {
    return GEInst { ok: false, base: "", key: "", mang: "" };
  }
  if (slice_unchecked(ty, ty.len() - 1, ty.len()) != "]") {
    return GEInst { ok: false, base: "", key: "", mang: "" };
  }
  let base: str = slice_unchecked(ty, 0, lb);
  if (genum_index(enums, base) < 0) {
    return GEInst { ok: false, base: "", key: "", mang: "" };
  }
  let key: string = genum_key_from_anno(ty, base, enums);
  if (key.len() == 0) {
    return GEInst { ok: false, base: "", key: "", mang: "" };
  }
  return GEInst { ok: true, base: base + "", key: key, mang: base + "__" + key };
}

function fn_key_sanitize(s: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    let alnum: boolean = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95;
    if (alnum) {
      out = out + slice_unchecked(s, i, i + 1);
    } else {
      out = out + "_";
    }
    i = i + 1;
  }
  return out;
}

function pk_is_fn_spelling(t: string): boolean {
  let n: i32 = t.len();
  if (n < 5) {
    return false;
  }
  if (t[0] != b'(') {
    return false;
  }
  let depth: i32 = 0;
  let i: i32 = 0;
  let close: i32 = 0 - 1;
  while (i < n) {
    let ch: i32 = t[i] as i32;
    if (ch == 40 || ch == 91) {
      depth = depth + 1;
    } else if (ch == 41 || ch == 93) {
      depth = depth - 1;
      if (depth == 0 && ch == 41) {
        close = i;
        i = n;
      }
    }
    i = i + 1;
  }
  if (close < 0) {
    return false;
  }
  let j: i32 = close + 1;
  while (j < n && t[j] == b' ') {
    j = j + 1;
  }
  if (j + 1 >= n) {
    return false;
  }
  return t[j] == b'=' && t[j + 1] == b'>';
}

function fn_spelling_ret(t: string): string {
  if (!pk_is_fn_spelling(t)) {
    return "";
  }
  let n: i32 = t.len();
  let depth: i32 = 0;
  let i: i32 = 0;
  let close: i32 = 0 - 1;
  while (i < n) {
    let ch: i32 = t[i] as i32;
    if (ch == 40 || ch == 91) {
      depth = depth + 1;
    } else if (ch == 41 || ch == 93) {
      depth = depth - 1;
      if (depth == 0 && ch == 41) {
        close = i;
        i = n;
      }
    }
    i = i + 1;
  }
  let j: i32 = close + 1;
  while (j < n && t[j] == b' ') {
    j = j + 1;
  }
  j = j + 2;
  while (j < n && t[j] == b' ') {
    j = j + 1;
  }
  return slice_unchecked(t, j, n) + "";
}

function ge_targ_mangle(arg: string, enums: EnumDecl[]): string {
  if (arg.len() == 0) {
    return "";
  }
  if (pk_is_fn_spelling(arg)) {
    return fn_key_sanitize(arg);
  }
  if (type_ends_arr(arg)) {
    let elem: string = ge_targ_mangle(slice_unchecked(arg, 0, arg.len() - 2) + "", enums);
    if (elem.len() == 0) {
      return "";
    }
    return elem + "_arr";
  }
  if (arg[0] == b'(') {
    return ge_tuple_mangle(arg);
  }
  let lb: i32 = first_bracket(arg);
  if (lb < 0) {
    if (util.contains(arg, " ")) {
      return "";
    }
    if (util.contains(arg, "(")) {
      return "";
    }
    return arg;
  }
  let gi: GEInst = ge_inst_of(arg, enums);
  if (gi.ok) {
    return gi.mang;
  }
  return "";
}

function keyed_by_mangle(t: string): boolean {
  return t.len() > 0 && (t[0] == b'(' || type_ends_arr(t));
}

function ge_tuple_mangle(arg: string): string {
  if (arg.len() < 2 || arg[0] != b'(' || arg[arg.len() - 1] != b')') {
    return "";
  }
  let parts: string[] = split_top_commas(slice_unchecked(arg, 1, arg.len() - 1));
  if (parts.len() < 2) {
    return "";
  }
  let out: string = "tup";
  for p in parts {
    let m: string = ge_tuple_elem_mangle(p);
    if (m.len() == 0) {
      return "";
    }
    out = out + "_" + m;
  }
  return out;
}

function ge_tuple_elem_mangle(e: string): string {
  if (type_ends_arr(e)) {
    let m: string = ge_tuple_elem_mangle(slice_unchecked(e, 0, e.len() - 2) + "");
    if (m.len() == 0) {
      return "";
    }
    return m + "_arr";
  }
  if (e.len() > 0 && e[0] == b'(') {
    return ge_tuple_mangle(e);
  }
  if (e.len() == 0 || first_bracket(e) >= 0 || util.contains(e, " ")) {
    return "";
  }
  return e;
}

function me_ref_spelling(t: TypeRef): string {
  return spelling_without_own(render_type_ref(TypeRef { ...t, array_depth: 0 }));
}

function me_rewrite_ty(ty: string, enums: EnumDecl[]): string {
  if (ty.len() == 0) {
    return ty;
  }
  let t: TypeRef = parse_type_ref(ty);
  let out: string = render_type_ref(me_rewrite_ref(t, enums));
  if (out == render_type_ref(t)) {
    return ty;
  }
  return out;
}

function me_rewrite_ref(t: TypeRef, enums: EnumDecl[]): TypeRef {
  let gi: GEInst = ge_inst_of(me_ref_spelling(t), enums);
  if (gi.ok) {
    let base: string = gi.mang;
    if (spelling_is_own(t.base)) {
      base = "own " + base;
    }
    return TypeRef { base: base, args: [], array_depth: t.array_depth, is_tuple: false, is_fn: false, is_view: false };
  }
  let args: TypeRef[] = [];
  for a in t.args {
    args = args.append(me_rewrite_ref(a, enums));
  }
  return TypeRef { ...t, args: args };
}

function me_rewrite_list(list: string, enums: EnumDecl[]): string {
  if (list.len() == 0) {
    return list;
  }
  let out: string = "";
  let changed: boolean = false;
  for seg in split_top_commas(list) {
    let r: string = me_rewrite_ty(seg, enums);
    if (r != seg) {
      changed = true;
    }
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + r;
  }
  if (!changed) {
    return list;
  }
  return out;
}

struct MeSlot { ty: string, fn_ret: string, fn_params: string }

function me_rewrite_slot(ty: string, fn_ret: string, fn_params: string, enums: EnumDecl[]): MeSlot {
  return MeSlot { ty: me_rewrite_ty(ty, enums), fn_ret: me_rewrite_ty(fn_ret, enums), fn_params: me_rewrite_list(fn_params, enums) };
}

function me_collect_anno(ty: string, enums: EnumDecl[], ins: Insts): Insts {
  if (ty.len() == 0) {
    return ins;
  }
  return me_collect_ref(parse_type_ref(ty), enums, ins);
}

function me_collect_ref(t: TypeRef, enums: EnumDecl[], ins: Insts): Insts {
  let spelled: string = me_ref_spelling(t);
  let gi: GEInst = ge_inst_of(spelled, enums);
  let cur: Insts = ins;
  if (gi.ok) {
    cur = cur.iadd_arg(gi.base, gi.key, genum_single_arg(spelled));
  }
  for a in t.args {
    cur = me_collect_ref(a, enums, cur);
  }
  return cur;
}

function me_collect_slot(ty: string, fn_ret: string, fn_params: string, enums: EnumDecl[], ins: Insts): Insts {
  let cur: Insts = me_collect_anno(ty, enums, me_collect_anno(fn_ret, enums, ins));
  if (fn_params.len() == 0) {
    return cur;
  }
  for seg in split_top_commas(fn_params) {
    cur = me_collect_anno(seg, enums, cur);
  }
  return cur;
}

function variant_struct_index(structs: StructDecl[], vname: string, owner: string): i32 {
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == vname && structs[i].enum_owner == owner) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function me_infer_variant_key(ed: EnumDecl, vname: string, args: ast.Expr[], expected: string, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: MFns): string {
  let fromAnno: string = genum_key_from_anno(expected, ed.name, enums);
  if (fromAnno.len() > 0) {
    return fromAnno;
  }
  if (variant_struct_index(structs, vname, ed.name) < 0) {
    return "";
  }
  let binds: MEnv = me_variant_binds(ed, vname, args, env, structs, funcs);
  let key: string = "";
  let j: i32 = 0;
  while (j < ed.type_params.len()) {
    let b: string = binds.elook(ed.type_params[j]);
    if (b.len() == 0 || mono_ty_mentions_var(b)) {
      return "";
    }
    if (j > 0) {
      key = key + "__";
    }
    key = key + b;
    j = j + 1;
  }
  if (ed.type_params.len() == 1 && keyed_by_mangle(key)) {
    return ge_targ_mangle(key, enums);
  }
  if (!is_simple_key(key)) {
    return "";
  }
  return key;
}

function me_variant_binds(ed: EnumDecl, vname: string, args: ast.Expr[], env: MEnv, structs: StructDecl[], funcs: MFns): MEnv {
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  let vidx: i32 = variant_struct_index(structs, vname, ed.name);
  if (vidx < 0) {
    return binds;
  }
  let fields: StructFieldDecl[] = structs[vidx].fields;
  let fi: i32 = 0;
  while (fi < fields.len() && fi < args.len()) {
    let at: string = mono_infer(args[fi], env, funcs);
    if (at.len() > 0) {
      binds = bind_unify(fields[fi].type_name, at, ed.type_params, binds, funcs);
    }
    fi = fi + 1;
  }
  return binds;
}

function struct_lit_spelling(sl: ast.ExprStructLit, env: MEnv, funcs: MFns): string {
  let si: i32 = gstruct_index(funcs.structs, sl.type_name);
  if (si < 0 || funcs.structs[si].type_params.len() == 0 || funcs.structs[si].enum_owner.len() > 0) {
    return sl.type_name;
  }
  let sd: StructDecl = funcs.structs[si];
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  let k: i32 = 0;
  while (k < sl.field_names.len() && k < sl.field_values.len()) {
    for f in sd.fields {
      if (f.name == sl.field_names[k]) {
        let at: string = mono_infer(sl.field_values[k], env, funcs);
        if (at.len() > 0) {
          binds = bind_unify(field_spelling(f), at, sd.type_params, binds, funcs);
        }
      }
    }
    k = k + 1;
  }
  let whole: string = bound_spelling(sd.name, sd.type_params, binds);
  if (whole.len() == 0) {
    return sl.type_name;
  }
  return whole;
}

function ctor_variant_name(callee: ast.Expr, enums: EnumDecl[], env: MEnv, funcs: MFns): string {
  match (callee) {
    ast.ExprIdent(cid) => {
      if (str_list_contains(env.mnames, cid.name)) {
        return "";
      }
      if (genum_owner_of_variant(enums, cid.name) >= 0 || cid.name == "Some" || cid.name == "Ok" || cid.name == "Err") {
        if (fda_known_func(cid.name, funcs.decls)) {
          return "";
        }
      }
      return cid.name;
    },
    ast.ExprFieldAccess(cfa) => {
      if let ast.ExprIdent(oid) = cfa.obj {
        if (!str_list_contains(env.mnames, oid.name) && genum_index(enums, oid.name) >= 0) {
          return cfa.field;
        }
      }
    },
    _ => {}
  }
  return "";
}

function bound_spelling(name: string, tparams: string[], binds: MEnv): string {
  let out: string = name + "[";
  let j: i32 = 0;
  while (j < tparams.len()) {
    let b: string = binds.elook(tparams[j]);
    if (b.len() == 0) {
      return "";
    }
    if (j > 0) {
      out = out + ", ";
    }
    out = out + b;
    j = j + 1;
  }
  return out + "]";
}

function variant_ctor_spelling(callee: ast.Expr, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  let vname: string = ctor_variant_name(callee, funcs.enums, env, funcs);
  if (vname.len() == 0) {
    return "";
  }
  let owner: i32 = genum_owner_of_variant(funcs.enums, vname);
  if (owner < 0) {
    return "";
  }
  let ed: EnumDecl = funcs.enums[owner];
  return bound_spelling(ed.name, ed.type_params, me_variant_binds(ed, vname, args, env, funcs.structs, funcs));
}

function me_variant_bound(ed: EnumDecl, vname: string, args: ast.Expr[], env: MEnv, structs: StructDecl[], funcs: MFns): string {
  if (ed.type_params.len() != 1) {
    return "";
  }
  return me_variant_binds(ed, vname, args, env, structs, funcs).elook(ed.type_params[0]);
}

function me_variant_field_expectations(ed: EnumDecl, vname: string, expected: string, key: string, carg: string, structs: StructDecl[], enums: EnumDecl[]): string[] {
  let none: string[] = [];
  let cts: string[] = type_args_of(expected);
  if (cts.len() != ed.type_params.len() || strip_struct_base(expected) != ed.name) {
    cts = [carg];
    if (ed.type_params.len() != 1) {
      cts = split_key(key, ed.type_params.len(), structs, enums);
    }
  }
  if (cts.len() != ed.type_params.len()) {
    return none;
  }
  let vidx: i32 = variant_struct_index(structs, vname, ed.name);
  if (vidx < 0) {
    return none;
  }
  let fields: StructFieldDecl[] = structs[vidx].fields;
  let out: string[] = [];
  let fi: i32 = 0;
  while (fi < fields.len()) {
    out = out.append(subst_ty(fields[fi].type_name, ed.type_params, cts));
    fi = fi + 1;
  }
  return out;
}

function me_env_from_params(params: ast.ParamDecl[]): MEnv {
  let e: MEnv = MEnv { mnames: [], mtypes: [] };
  let i: i32 = 0;
  while (i < params.len()) {
    let pt: string = params[i].type_name;
    if (pt == "fn" && params[i].fn_ret.len() > 0) {
      pt = fn_tag_spelling(pt, params[i].fn_ret, params[i].fn_param_types);
    }
    e = e.ebind(params[i].name, pt);
    i = i + 1;
  }
  return e;
}

function me_call_arg_types(funcs: MFns, fname: string, args: ast.Expr[], env: MEnv, expected: string, ins: Insts): string[] {
  let at: i32 = 0 - 1;
  if (fname == "Some" && strip_struct_base(expected) == "Option" || fname == "Ok" && strip_struct_base(expected) == "Result") {
    at = 0;
  } else if (fname == "Err" && strip_struct_base(expected) == "Result") {
    at = 1;
  }
  let targs: string[] = type_args_of(expected);
  if (at >= 0 && at < targs.len()) {
    return [targs[at]];
  }
  let d: i32 = me_call_decl_at(funcs, fname, ins);
  if (d < 0) {
    return [];
  }
  let fd: FuncDecl = funcs.decls[d];
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  if (fd.type_params.len() > 0) {
    binds = full_ret_binds(fd, args, env, funcs, fd.type_params);
  }
  let out: string[] = [];
  for p in fd.params {
    out = out.append(subst_ty(p.type_name, binds.mnames, binds.mtypes));
  }
  return out;
}

function me_call_decl_at(funcs: MFns, fname: string, ins: Insts): i32 {
  return free_decl_at(funcs.decls, me_called_name(funcs, fname, ins));
}

function me_called_name(funcs: MFns, fname: string, ins: Insts): string {
  if (free_decl_at(funcs.decls, fname) >= 0 || util.index_of_sub(fname, "__") <= 0) {
    return fname;
  }
  let k: i32 = 0;
  while (k < ins.inames.len()) {
    if (ins.inames[k] + "__" + sanitize_key(ins.itypes[k]) == fname) {
      return ins.inames[k];
    }
    k = k + 1;
  }
  return fname;
}

function free_decl_at(funcs: FuncDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && funcs[i].receiver_type.len() == 0) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function me_ident(id: ast.ExprIdent, expected: string, env: MEnv, enums: EnumDecl[], funcs: MFns, ins: Insts): RExpr {
  if (first_bracket(id.name) > 0 && genum_index(enums, strip_struct_base(id.name)) >= 0) {
    return RExpr { rexpr: ast.ExprIdent { ...id, name: me_rewrite_ty(id.name, enums) }, rins: me_collect_anno(id.name, enums, ins) };
  }
  let owner: i32 = genum_owner_of_variant(enums, id.name);
  if (owner >= 0 && !str_list_contains(env.mnames, id.name) && !fda_known_func(id.name, funcs.decls)) {
    let key: string = genum_key_from_anno(expected, enums[owner].name, enums);
    if (key.len() > 0) {
      let nins: Insts = ins.iadd_arg(enums[owner].name, key, genum_single_arg(expected));
      return RExpr { rexpr: ast.ExprIdent { name: id.name + "__" + key, line: id.line, col: id.col, ty: id.ty }, rins: nins };
    }
  }
  return RExpr { rexpr: ast.ExprIdent { ...id }, rins: ins };
}

function me_block_at(c: ast.ExprCall, expected: string, enums: EnumDecl[]): ast.Expr {
  if let ast.ExprLambda(lm) = c.callee {
    if (is_value_block(c) && me_rewrite_ty(expected, enums) != expected) {
      return ast.ExprLambda { ...lm, ret_type: expected, ret_fn_ret: "", ret_fn_param_types: "" };
    }
  }
  return c.callee;
}

function me_expr(e: ast.Expr, expected: string, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  match (e) {
    ast.ExprBinary(b) => {
      let l: RExpr = me_expr(b.left, "", env, enums, structs, funcs, ins);
      let r: RExpr = me_expr(b.right, "", env, enums, structs, funcs, l.rins);
      return RExpr { rexpr: ast.ExprBinary { op: b.op, left: l.rexpr, right: r.rexpr, line: b.line, col: b.col, ty: b.ty }, rins: r.rins };
    },
    ast.ExprUnary(u) => {
      let o: RExpr = me_expr(u.operand, "", env, enums, structs, funcs, ins);
      return RExpr { rexpr: ast.ExprUnary { op: u.op, operand: o.rexpr, line: u.line, col: u.col, ty: u.ty }, rins: o.rins };
    },
    ast.ExprCall(c) => {
      let vname: string = ctor_variant_name(c.callee, enums, env, funcs);
      let owner: i32 = 0 - 1;
      if (vname.len() > 0) {
        owner = genum_owner_of_variant(enums, vname);
      }
      let key: string = "";
      let carg: string = "";
      let fexps: string[] = [];
      if (owner >= 0) {
        key = me_infer_variant_key(enums[owner], vname, c.args, expected, env, enums, structs, funcs);
        if (key.len() > 0) {
          carg = genum_single_arg(expected);
          if (carg.len() == 0) {
            let bound: string = me_variant_bound(enums[owner], vname, c.args, env, structs, funcs);
            if (keyed_by_mangle(bound)) {
              carg = bound;
            }
          }
          if (carg.len() == 0) {
            carg = key;
          }
          fexps = me_variant_field_expectations(enums[owner], vname, expected, key, carg, structs, enums);
        }
      }
      let mexps: string[] = [];
      if (owner < 0) {
        if let ast.ExprIdent(cid) = c.callee {
          if (!str_list_contains(env.mnames, cid.name)) {
            mexps = me_call_arg_types(funcs, cid.name, c.args, env, expected, ins);
          }
        }
        if let ast.ExprFieldAccess(cfa) = c.callee {
          mexps = me_method_arg_types(cfa, c.args.len(), env, enums, structs, funcs, ins);
        }
      }
      let nargs: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < c.args.len()) {
        let ae: string = "";
        if (i < fexps.len()) {
          ae = fexps[i];
        } else if (i < mexps.len()) {
          ae = mexps[i];
        }
        let ra: RExpr = me_expr(c.args[i], ae, env, enums, structs, funcs, cur);
        cur = ra.rins;
        nargs = nargs.append(ra.rexpr);
        i = i + 1;
      }
      if (key.len() > 0) {
        cur = cur.iadd_arg(enums[owner].name, key, carg);
        let mv: string = vname + "__" + key;
        return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: mv, line: c.line, col: c.col, ty: "" }, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: cur };
      }
      let rc: RExpr = me_expr(me_block_at(c, expected, enums), "", env, enums, structs, funcs, cur);
      let targs: string[] = [];
      cur = rc.rins;
      for ta in c.type_args {
        cur = me_collect_anno(ta, enums, cur);
        targs = targs.append(me_rewrite_ty(ta, enums));
      }
      return RExpr { rexpr: ast.ExprCall { callee: rc.rexpr, args: nargs, line: c.line, col: c.col, type_args: targs, ty: c.ty }, rins: cur };
    },
    ast.ExprIdent(id) => {
      return me_ident(id, expected, env, enums, funcs, ins);
    },
    ast.ExprArray(a) => {
      let elexp: string = "";
      if (type_ends_arr(expected)) {
        elexp = slice_unchecked(expected, 0, expected.len() - 2) + "";
      }
      let nels: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < a.elements.len()) {
        let re: RExpr = me_expr(a.elements[i], array_element_expected(a.elements[i], elexp), env, enums, structs, funcs, cur);
        cur = re.rins;
        nels = nels.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprArray { ...a, elements: nels }, rins: cur };
    },
    ast.ExprTuple(t) => {
      let nels: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < t.elements.len()) {
        let re: RExpr = me_expr(t.elements[i], "", env, enums, structs, funcs, cur);
        cur = re.rins;
        nels = nels.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprTuple { elements: nels, line: t.line, col: t.col }, rins: cur };
    },
    ast.ExprIndex(ix) => {
      let ar: RExpr = me_expr(ix.array, "", env, enums, structs, funcs, ins);
      let ir: RExpr = me_expr(ix.index, "", env, enums, structs, funcs, ar.rins);
      return RExpr { rexpr: ast.ExprIndex { array: ar.rexpr, index: ir.rexpr, unchecked: false, ty: ix.ty, line: ix.line, col: ix.col }, rins: ir.rins };
    },
    ast.ExprSlice(sl) => {
      let ar: RExpr = me_expr(sl.array, "", env, enums, structs, funcs, ins);
      let st: RExpr = me_expr(sl.start, "", env, enums, structs, funcs, ar.rins);
      let en: RExpr = me_expr(sl.end, "", env, enums, structs, funcs, st.rins);
      return RExpr { rexpr: ast.ExprSlice { ...sl, array: ar.rexpr, start: st.rexpr, end: en.rexpr }, rins: en.rins };
    },
    ast.ExprStructLit(s) => {
      let nvals: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < s.field_values.len()) {
        let fexp: string = me_field_type_of(structs, s.type_name, s.field_names[i]);
        let rv: RExpr = me_expr(s.field_values[i], fexp, env, enums, structs, funcs, cur);
        cur = rv.rins;
        nvals = nvals.append(rv.rexpr);
        i = i + 1;
      }
      let rb: RExpr = me_expr(s.base, "", env, enums, structs, funcs, cur);
      return RExpr { rexpr: ast.ExprStructLit { ...s, field_values: nvals, base: rb.rexpr }, rins: rb.rins };
    },
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          if (!str_list_contains(env.mnames, oid.name) && genum_index(enums, oid.name) >= 0) {
            let owner: i32 = genum_owner_of_variant(enums, fa.field);
            if (owner >= 0) {
              let key: string = genum_key_from_anno(expected, enums[owner].name, enums);
              if (key.len() > 0) {
                let nins: Insts = ins.iadd_arg(enums[owner].name, key, genum_single_arg(expected));
                return RExpr { rexpr: ast.ExprIdent { name: fa.field + "__" + key, line: fa.line, col: fa.col, ty: "" }, rins: nins };
              }
            }
          }
        },
        _ => {}
      }
      let ob: RExpr = me_expr(fa.obj, "", env, enums, structs, funcs, ins);
      return RExpr { rexpr: ast.ExprFieldAccess { ...fa, obj: ob.rexpr }, rins: ob.rins };
    },
    ast.ExprLambda(lm) => {
      let lb: RStmts = me_stmts(lm.body, bind_params(env, lm.params), lm.ret_type, enums, structs, funcs, ins);
      let lins: Insts = me_collect_slot(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types, enums, lb.rins3);
      for lp in lm.params {
        lins = me_collect_slot(lp.type_name, lp.fn_ret, lp.fn_param_types, enums, lins);
      }
      let lret: MeSlot = me_rewrite_slot(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types, enums);
      function enum_clone(t: typeinfo.Type): string {
        if let typeinfo.TypeUnion(_) = t {
          let sp: string = typeinfo.spelling(t);
          let m: string = me_rewrite_ty(sp, enums);
          if (m != sp) {
            return m;
          }
        }
        return "";
      }
      let caps: ast.TypedBinding[] = [];
      for cap in lm.captures {
        lins = me_collect_anno(typeinfo.spelling(cap.ty), enums, lins);
        caps = caps.append(ast.TypedBinding { name: cap.name, ty: typeinfo.renamed_nominals(cap.ty, enum_clone) });
      }
      return RExpr { rexpr: ast.ExprLambda { ...lm, params: me_rewrite_params(lm.params, enums), ret_type: lret.ty, ret_fn_ret: lret.fn_ret, ret_fn_param_types: lret.fn_params, body: lb.rstmts, captures: caps }, rins: lins };
    },
    _ => {
      return RExpr { rexpr: e, rins: ins };
    }
  }
  return RExpr { rexpr: e, rins: ins };
}

function me_rewrite_arm_pattern(pat: ast.Pattern, ed: EnumDecl, key: string): ast.Pattern {
  match (pat) {
    ast.PatVariant(pv) => {
      let simple: string = pv.type_name;
      let k: i32 = 0;
      while (k < pv.type_name.len()) {
        if (pv.type_name[k] == b'.') {
          simple = slice_unchecked(pv.type_name, k + 1, pv.type_name.len()) + "";
        }
        k = k + 1;
      }
      let vn: string[] = ed.variant_names;
      let j: i32 = 0;
      while (j < vn.len()) {
        if (vn[j] == simple) {
          return ast.PatVariant { ...pv, type_name: simple + "__" + key };
        }
        j = j + 1;
      }
      return pat;
    },
    _ => {
      return pat;
    }
  }
  return pat;
}

function me_field_type_of(structs: StructDecl[], sname: string, fname: string): string {
  let base: string = strip_struct_base(sname);
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == base) {
      let fs: StructFieldDecl[] = structs[i].fields;
      let j: i32 = 0;
      while (j < fs.len()) {
        if (fs[j].name == fname) {
          let targs: string[] = type_args_of(sname);
          if (structs[i].type_params.len() > 0 && targs.len() == structs[i].type_params.len()) {
            return subst_ty(fs[j].type_name, structs[i].type_params, targs);
          }
          return fs[j].type_name;
        }
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return "";
}

function me_field_spelling_of(funcs: MFns, sname: string, fname: string): string {
  let base: string = strip_struct_base(sname);
  let i: i32 = funcs.snames.chain(base);
  while (i >= 0) {
    if (funcs.structs[i].name == base) {
      for f in funcs.structs[i].fields {
        if (f.name == fname) {
          return fn_tag_spelling(f.type_name, f.fn_ret, f.fn_param_types);
        }
      }
    }
    i = funcs.snames.next[i];
  }
  return "";
}

function lit_field_spelling(funcs: MFns, sname: string, written: string, fname: string): string {
  let spelling: string = me_field_spelling_of(funcs, sname, fname);
  if (spelling.len() == 0) {
    return spelling;
  }
  let base: string = strip_struct_base(sname);
  let args: string[] = type_args_of(written);
  let i: i32 = funcs.snames.chain(base);
  while (i >= 0) {
    let sd: StructDecl = funcs.structs[i];
    if (sd.name == base) {
      if (sd.type_params.len() > 0 && args.len() == sd.type_params.len()) {
        spelling = subst_ty(spelling, sd.type_params, args);
      }
      break;
    }
    i = funcs.snames.next[i];
  }
  if (type_str_vars(spelling, []).len() > 0) {
    return "";
  }
  return spelling;
}

function me_fn_ret_spelling(t: string): string {
  let last: i32 = 0 - 1;
  let i: i32 = 0;
  while (i + 4 <= t.len()) {
    if (slice_unchecked(t, i, i + 4) == " => ") {
      last = i;
    }
    i = i + 1;
  }
  if (last < 0) {
    return "";
  }
  return slice_unchecked(t, last + 4, t.len()) + "";
}

function me_tuple_elem_type(ty: string, field: string): string {
  if (ty.len() < 2 || ty[0] != b'(') {
    return "";
  }
  if (field.len() == 0) {
    return "";
  }
  let idx: i32 = 0;
  let fi: i32 = 0;
  while (fi < field.len()) {
    if (field[fi] < b'0' || field[fi] > b'9') {
      return "";
    }
    idx = idx * 10 + (field[fi] as i32 - 48);
    fi = fi + 1;
  }
  let inner: string = slice_unchecked(ty, 1, ty.len() - 1) + "";
  let depth: i32 = 0;
  let start: i32 = 0;
  let cur: i32 = 0;
  let i: i32 = 0;
  while (i <= inner.len()) {
    if (i == inner.len() || inner[i] == b',' && depth == 0) {
      if (cur == idx) {
        let seg: string = slice_unchecked(inner, start, i) + "";
        let s2: i32 = 0;
        while (s2 < seg.len() && seg[s2] == b' ') {
          s2 = s2 + 1;
        }
        return slice_unchecked(seg, s2, seg.len()) + "";
      }
      cur = cur + 1;
      start = i + 1;
    } else {
      if (inner[i] == b'[' || inner[i] == b'(') {
        depth = depth + 1;
      }
      if (inner[i] == b']' || inner[i] == b')') {
        depth = depth - 1;
      }
    }
    i = i + 1;
  }
  return "";
}

function me_scrutinee_type(e: ast.Expr, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: MFns, ins: Insts): string {
  match (e) {
    ast.ExprIdent(id) => {
      return env.elook(id.name);
    },
    ast.ExprStructLit(s) => {
      return s.type_name;
    },
    ast.ExprCall(c) => {
      let vgn: string = ctor_variant_name(c.callee, enums, env, funcs);
      let vgo: i32 = 0 - 1;
      if (vgn.len() > 0) {
        vgo = genum_owner_of_variant(enums, vgn);
      }
      if (vgo >= 0 && me_infer_variant_key(enums[vgo], vgn, c.args, "", env, enums, structs, funcs).len() > 0) {
        return bound_spelling(enums[vgo].name, enums[vgo].type_params, me_variant_binds(enums[vgo], vgn, c.args, env, structs, funcs));
      }
      match (c.callee) {
        ast.ExprIdent(cid) => {
          let fr: string = me_fn_ret_spelling(env.elook(cid.name));
          if (fr.len() > 0) {
            return fr;
          }
          let crt: string = call_ret_type(funcs, me_called_name(funcs, cid.name, ins), c.args, env);
          if (crt.len() > 0) {
            return crt;
          }
          return func_ret_of(funcs.decls, cid.name);
        },
        ast.ExprFieldAccess(cfa) => {
          let rt: string = me_scrutinee_type(cfa.obj, env, enums, structs, funcs, ins);
          if (rt.len() > 0) {
            return me_method_ret_type(rt, cfa.field, funcs);
          }
          return "";
        },
        ast.ExprLambda(lm) => {
          return lm.ret_type;
        },
        _ => {
          return "";
        }
      }
      return "";
    },
    ast.ExprIndex(ix) => {
      let at: string = me_scrutinee_type(ix.array, env, enums, structs, funcs, ins);
      if (type_ends_arr(at)) {
        return slice_unchecked(at, 0, at.len() - 2) + "";
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      let ot: string = me_scrutinee_type(fa.obj, env, enums, structs, funcs, ins);
      if (ot.len() == 0) {
        return "";
      }
      let te: string = me_tuple_elem_type(ot, fa.field);
      if (te.len() > 0) {
        return te;
      }
      return me_field_type_of(structs, ot, fa.field);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function me_bind_pat_vars(pat: ast.Pattern, ed: EnumDecl, cts: string[], structs: StructDecl[], env: MEnv): MEnv {
  match (pat) {
    ast.PatVariant(pv) => {
      let simple: string = pv.type_name;
      let k: i32 = 0;
      while (k < pv.type_name.len()) {
        if (pv.type_name[k] == b'.') {
          simple = slice_unchecked(pv.type_name, k + 1, pv.type_name.len()) + "";
        }
        k = k + 1;
      }
      let vidx: i32 = variant_struct_index(structs, simple, ed.name);
      if (vidx < 0) {
        return env;
      }
      let fs: StructFieldDecl[] = structs[vidx].fields;
      let names: string[] = [];
      if (pv.binding.len() > 0) {
        names = names.append(pv.binding);
      }
      let bi: i32 = 0;
      while (bi < pv.extra_bindings.len()) {
        if (pv.extra_bindings[bi].len() > 0) {
          names = names.append(pv.extra_bindings[bi]);
        }
        bi = bi + 1;
      }
      let e: MEnv = env;
      let ni: i32 = 0;
      while (ni < names.len() && ni < fs.len()) {
        if (fs[ni].type_name == "fn" && fs[ni].fn_ret.len() > 0) {
          e = e.ebind(names[ni], "fn => " + subst_ty(fs[ni].fn_ret, ed.type_params, cts));
        } else {
          e = e.ebind(names[ni], subst_ty(fs[ni].type_name, ed.type_params, cts));
        }
        ni = ni + 1;
      }
      return e;
    },
    _ => {
      return env;
    }
  }
  return env;
}

function me_stmt(st: ast.Stmt, env: MEnv, ret_ty: string, enums: EnumDecl[], structs: StructDecl[], funcs: MFns, ins: Insts): RStmtOne {
  match (st) {
    ast.StmtVar(v) => {
      let iv: RExpr = me_expr(v.init, v.type_name, env, enums, structs, funcs, ins);
      let cins: Insts = me_collect_slot(v.type_name, v.fn_ret, v.fn_param_types, enums, iv.rins);
      let nslot: MeSlot = me_rewrite_slot(v.type_name, v.fn_ret, v.fn_param_types, enums);
      let vty: string = v.type_name;
      if (vty == "fn") {
        match (v.init) {
          ast.ExprLambda(lm) => {
            if (lm.ret_type.len() > 0) {
              let lfs: string = "";
              let lfok: boolean = true;
              let lfi: i32 = 0;
              while (lfi < lm.params.len()) {
                if (lm.params[lfi].type_name.len() == 0) {
                  lfok = false;
                }
                if (lfi > 0) {
                  lfs = lfs + ", ";
                }
                lfs = lfs + lm.params[lfi].type_name;
                lfi = lfi + 1;
              }
              if (lfok) {
                vty = "(" + lfs + ") => " + lm.ret_type;
              } else {
                vty = "fn => " + lm.ret_type;
              }
            }
          },
          _ => {}
        }
      }
      if (vty.len() == 0) {
        vty = me_scrutinee_type(v.init, env, enums, structs, funcs, ins);
      }
      let ninit: ast.Expr = retype_enum_assoc(iv.rexpr, nslot.ty, enums, funcs);
      return RStmtOne { rstmt: ast.StmtVar { name: v.name, type_name: nslot.ty, init: ninit, line: v.line, col: v.col, fn_ret: nslot.fn_ret, fn_param_types: nslot.fn_params }, renv: me_bind_var(env, v, vty, enums, structs, funcs, ins), rins2: cins };
    },
    ast.StmtReturn(r) => {
      let rv: RExpr = me_expr(r.value, ret_ty, env, enums, structs, funcs, ins);
      let rval: ast.Expr = retype_enum_assoc(rv.rexpr, me_rewrite_ty(ret_ty, enums), enums, funcs);
      return RStmtOne { rstmt: ast.StmtReturn { value: rval, line: r.line, col: r.col }, renv: env, rins2: rv.rins };
    },
    ast.StmtExpr(x) => {
      let xv: RExpr = me_expr(x.value, "", env, enums, structs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtExpr { value: xv.rexpr, line: 0 }, renv: env, rins2: xv.rins };
    },
    ast.StmtAssign(a) => {
      let dest: string = env.elook(a.target);
      let av: RExpr = me_expr(a.value, dest, env, enums, structs, funcs, ins);
      let aval: ast.Expr = retype_enum_assoc(av.rexpr, me_rewrite_ty(dest, enums), enums, funcs);
      return RStmtOne { rstmt: ast.StmtAssign { target: a.target, value: aval, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, renv: env, rins2: av.rins };
    },
    ast.StmtIf(f) => {
      let cv: RExpr = me_expr(f.cond, "", env, enums, structs, funcs, ins);
      let tb: RStmts = me_stmts(f.then_body, env, ret_ty, enums, structs, funcs, cv.rins);
      let eb: RStmts = me_stmts(f.else_body, env, ret_ty, enums, structs, funcs, tb.rins3);
      return RStmtOne { rstmt: ast.StmtIf { cond: cv.rexpr, then_body: tb.rstmts, else_body: eb.rstmts, line: 0, else_chained: false, sugar: no_match_sugar(), origin: "" }, renv: env, rins2: eb.rins3 };
    },
    ast.StmtWhile(w) => {
      let cv: RExpr = me_expr(w.cond, "", env, enums, structs, funcs, ins);
      let wb: RStmts = me_stmts(w.body, env, ret_ty, enums, structs, funcs, cv.rins);
      return RStmtOne { rstmt: ast.StmtWhile { cond: cv.rexpr, body: wb.rstmts, label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo }, renv: env, rins2: wb.rins3 };
    },
    ast.StmtFor(fr) => {
      let it: RExpr = me_expr(fr.iter, "", env, enums, structs, funcs, ins);
      let itty: string = me_scrutinee_type(fr.iter, env, enums, structs, funcs, ins);
      let elty: string = "";
      if (type_ends_arr(itty)) {
        elty = slice_unchecked(itty, 0, itty.len() - 2) + "";
      }
      let benv: MEnv = env.ebind(fr.var_name, elty);
      let fb: RStmts = me_stmts(fr.body, benv, ret_ty, enums, structs, funcs, it.rins);
      return RStmtOne { rstmt: ast.StmtFor { var_name: fr.var_name, iter: it.rexpr, body: fb.rstmts, label: fr.label, line: fr.line, col: fr.col }, renv: env, rins2: fb.rins3 };
    },
    ast.StmtMatch(m) => {
      let sv: RExpr = me_expr(m.scrutinee, "", env, enums, structs, funcs, ins);
      let cur: Insts = sv.rins;
      let sty: string = me_scrutinee_type(m.scrutinee, env, enums, structs, funcs, ins);
      let gi: GEInst = ge_inst_of(sty, enums);
      let arms: ast.MatchArm[] = [];
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let npat: ast.Pattern = m.arms[i].pattern;
        let armenv: MEnv = mono_arm_env(env, m.arms[i].pattern, sty, funcs);
        if (gi.ok) {
          let gidx: i32 = genum_index(enums, gi.base);
          if (gidx >= 0) {
            npat = me_rewrite_arm_pattern(m.arms[i].pattern, enums[gidx], gi.key);
            cur = cur.iadd_arg(gi.base, gi.key, genum_single_arg(sty));
            let cts: string[] = type_args_of(sty);
            if (cts.len() == enums[gidx].type_params.len()) {
              armenv = me_bind_pat_vars(m.arms[i].pattern, enums[gidx], cts, structs, armenv);
            }
          }
        }
        let gv: RExpr = me_expr(m.arms[i].guard, "", armenv, enums, structs, funcs, cur);
        cur = gv.rins;
        let ab: RStmts = me_stmts(m.arms[i].body, armenv, ret_ty, enums, structs, funcs, cur);
        cur = ab.rins3;
        arms = arms.append(ast.MatchArm { pattern: npat, body: ab.rstmts, line: m.arms[i].line, col: m.arms[i].col, guard: gv.rexpr, has_guard: m.arms[i].has_guard, alt_cont: false });
        i = i + 1;
      }
      return RStmtOne { rstmt: ast.StmtMatch { ...m, scrutinee: sv.rexpr, arms: arms }, renv: env, rins2: cur };
    },
    ast.StmtDefer(d) => {
      let act: RStmtOne = me_stmt(d.action, env, ret_ty, enums, structs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtDefer { ...d, action: act.rstmt }, renv: env, rins2: act.rins2 };
    },
    _ => {
      return RStmtOne { rstmt: st, renv: env, rins2: ins };
    }
  }
  return RStmtOne { rstmt: st, renv: env, rins2: ins };
}

function me_bind_var(env: MEnv, v: ast.StmtVar, vty: string, enums: EnumDecl[], structs: StructDecl[], funcs: MFns, ins: Insts): MEnv {
  let names: string[] = split_top_commas(v.name);
  if (names.len() < 2) {
    return env.ebind(v.name, vty);
  }
  let tty: string = me_scrutinee_type(v.init, env, enums, structs, funcs, ins);
  let out: MEnv = env;
  let i: i32 = 0;
  while (i < names.len()) {
    if (names[i].len() > 0 && names[i][0] != b'(') {
      out = out.ebind(names[i], me_tuple_elem_type(tty, util.i32_to_string(i)));
    }
    i = i + 1;
  }
  return out;
}

function me_stmts(stmts: ast.Stmt[], env: MEnv, ret_ty: string, enums: EnumDecl[], structs: StructDecl[], funcs: MFns, ins: Insts): RStmts {
  let out: ast.Stmt[] = [];
  let e2: MEnv = env;
  let cur: Insts = ins;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let rs: RStmtOne = me_stmt(stmts[i], e2, ret_ty, enums, structs, funcs, cur);
    out = out.append(rs.rstmt);
    e2 = rs.renv;
    cur = rs.rins2;
    i = i + 1;
  }
  return RStmts { rstmts: out, rins3: cur };
}

function me_rewrite_params(params: ast.ParamDecl[], enums: EnumDecl[]): ast.ParamDecl[] {
  let out: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < params.len()) {
    let p: ast.ParamDecl = params[i];
    let slot: MeSlot = me_rewrite_slot(p.type_name, p.fn_ret, p.fn_param_types, enums);
    out = out.append(ast.ParamDecl { ...p, type_name: slot.ty, fn_ret: slot.fn_ret, fn_param_types: slot.fn_params });
    i = i + 1;
  }
  return out;
}

function clone_enum_method(m: FuncDecl, ed: EnumDecl, cts: string[], mname: string, mod: Module, efns: MFns, ins: Insts): FRes {
  let tps: string[] = struct_receiver_typevars(m.receiver_type);
  if (tps.len() != cts.len()) {
    tps = ed.type_params;
  }
  let recv: string = ed.name + "[";
  let ci: i32 = 0;
  while (ci < cts.len()) {
    if (ci > 0) {
      recv = recv + ", ";
    }
    recv = recv + cts[ci];
    ci = ci + 1;
  }
  recv = recv + "]";
  let cur: Insts = ins;
  let nparams: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < m.params.len()) {
    let p: ast.ParamDecl = m.params[i];
    let pt: string = enum_self_ty(subst_ty(p.type_name, tps, cts), ed.name, recv);
    let pr: string = enum_self_ty(subst_ty(p.fn_ret, tps, cts), ed.name, recv);
    let pps: string = subst_ty_list(p.fn_param_types, tps, cts);
    cur = me_collect_slot(pt, pr, pps, mod.enums, cur);
    nparams = nparams.append(ast.ParamDecl { ...p, type_name: pt, fn_ret: pr, fn_param_types: pps });
    i = i + 1;
  }
  let rt: string = enum_self_ty(subst_ty(m.ret_type, tps, cts), ed.name, recv);
  cur = me_collect_anno(rt, mod.enums, cur);
  let rfr: string = enum_self_ty(subst_ty(m.ret_fn_ret, tps, cts), ed.name, recv);
  let rfps: string = subst_ty_list(m.ret_fn_param_types, tps, cts);
  cur = me_collect_slot("", rfr, rfps, mod.enums, cur);
  let env: MEnv = me_env_from_params(nparams);
  if (m.receiver_name.len() > 0) {
    env = env.ebind(m.receiver_name, recv);
  }
  let menv: MEnv = env_from_params(nparams);
  if (m.receiver_name.len() > 0) {
    menv = menv.ebind(m.receiver_name, recv);
  }
  let mb: RStmts = mono_stmts(subst_stmts(method_bound_rewritten(m, tps, cts, mod.trait_reqs, efns), tps, cts), menv, efns, cur, fn_tag_spelling(rt, rfr, rfps));
  let rb: RStmts = me_stmts(mb.rstmts, env, rt, mod.enums, mod.structs, efns, mb.rins3);
  let notp: string[] = [];
  let fn: FuncDecl = FuncDecl {
    ...m, receiver_type: mname, type_params: notp, all_type_params: [], bound_traits: [],
    params: me_rewrite_params(nparams, mod.enums),
    ret_type: me_rewrite_ty(rt, mod.enums),
    ret_fn_ret: me_rewrite_ty(rfr, mod.enums),
    ret_fn_param_types: me_rewrite_list(rfps, mod.enums),
    body: rb.rstmts,
  };
  return FRes { ffn: fn, fins: rb.rins3 };
}

function genum_bg_refs(funcs: FuncDecl[], enums: EnumDecl[]): string[] {
  let names: string[] = [];
  for fd in funcs {
    if (is_free_bg_template(fd)) {
      names = names.append(fd.name);
    }
  }
  let refs: BgRefs = BgRefs { names: names, hit: [] };
  for fd in funcs {
    if (is_genum_method(fd, enums)) {
      refs = bg_refs_body(fd.body, refs);
    }
  }
  let i: i32 = 0;
  while (i < refs.hit.len()) {
    for fd in funcs {
      if (fd.name == refs.hit[i] && is_free_bg_template(fd)) {
        refs = bg_refs_body(fd.body, refs);
      }
    }
    i = i + 1;
  }
  return refs.hit;
}

function enum_bg_templates(funcs: FuncDecl[], refs: string[], keep: boolean): FuncDecl[] {
  if (keep) {
    return [];
  }
  let out: FuncDecl[] = [];
  for fd in funcs {
    if (is_free_bg_template(fd) && str_in(refs, fd.name)) {
      out = out.append(fd);
    }
  }
  return out;
}

struct BgRefs { names: string[], hit: string[] }

function bg_refs_body(body: ast.Stmt[], own r: BgRefs): BgRefs {
  for st in body {
    r = astwalk.fold_stmt_nodes(st, r, bg_refs_stmt, bg_refs_expr, astwalk.descend_all);
  }
  return r;
}

function bg_refs_stmt(st: ast.Stmt, own r: BgRefs): BgRefs {
  return r;
}

function bg_refs_expr(e: ast.Expr, own r: BgRefs): BgRefs {
  if let ast.ExprIdent(id) = e {
    return bg_ref_hit(r, id.name);
  }
  if let ast.ExprFieldAccess(fa) = e {
    for n in r.names {
      if (folds_method(n, fa.field)) {
        r = bg_ref_hit(r, n);
      }
    }
  }
  return r;
}

function bg_ref_hit(own r: BgRefs, name: string): BgRefs {
  if (str_in(r.names, name) && !str_in(r.hit, name)) {
    return BgRefs { ...r, hit: r.hit.append(name) };
  }
  return r;
}

function folds_method(name: string, verb: string): boolean {
  if (name == "__arrm_" + verb || name == "__viewm_" + verb || name == "__mapm_" + verb) {
    return true;
  }
  let sfx: string = "_" + verb;
  return util.str_has_prefix(name, "__smm_") && name.len() > sfx.len() && slice_unchecked(name, name.len() - sfx.len(), name.len()) == sfx;
}

struct BgStep { funcs: FuncDecl[], ins: Insts }

function me_bg_step(gidx: i32, base: string, key: string, mod: Module, efns: MFns, st: BgStep): BgStep {
  let at: i32 = bg_find(efns, base);
  if (gidx >= 0 || at < 0 || has_func_named(mod.funcs, st.funcs, base + "__" + sanitize_key(key))) {
    return st;
  }
  let bc: FRes = me_clone_bg(efns.decls[at], key, mod, efns, st.ins);
  return BgStep { funcs: st.funcs.append(bc.ffn), ins: bc.fins };
}

function me_clone_bg(fd: FuncDecl, key: string, mod: Module, efns: MFns, ins: Insts): FRes {
  let cl: FuncDecl = clone_bg(fd, key, mod.impls, mod.trait_reqs, efns);
  let ret: string = fn_tag_spelling(cl.ret_type, cl.ret_fn_ret, cl.ret_fn_param_types);
  let mb: RStmts = mono_stmts(cl.body, env_from_params(cl.params), efns, ins, ret);
  let rb: RStmts = me_stmts(mb.rstmts, me_env_from_params(cl.params), cl.ret_type, mod.enums, mod.structs, efns, mb.rins3);
  let cur: Insts = me_collect_anno(cl.ret_type, mod.enums, rb.rins3);
  for p in cl.params {
    cur = me_collect_slot(p.type_name, p.fn_ret, p.fn_param_types, mod.enums, cur);
  }
  let fslot: MeSlot = me_rewrite_slot(cl.ret_type, cl.ret_fn_ret, cl.ret_fn_param_types, mod.enums);
  let fn: FuncDecl = FuncDecl {
    ...cl, receiver_name: "", receiver_type: "", params: me_rewrite_params(cl.params, mod.enums),
    ret_type: fslot.ty, ret_fn_ret: fslot.fn_ret, ret_fn_param_types: fslot.fn_params, body: rb.rstmts,
  };
  return FRes { ffn: fn, fins: cur };
}

function enum_self_ty(ty: string, name: string, recv: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < ty.len()) {
    let end: i32 = i + name.len();
    let bare: boolean = end <= ty.len() && slice_unchecked(ty, i, end) == name && (i == 0 || !ident_byte(ty[i - 1] as i32))
      && (end == ty.len() || !ident_byte(ty[end] as i32) && ty[end] != b'[');
    if (bare) {
      out = out + recv;
      i = end;
    } else {
      out = out + slice_unchecked(ty, i, i + 1);
      i = i + 1;
    }
  }
  return out;
}

function enum_method_template(m: FuncDecl, ed: EnumDecl): FuncDecl {
  if (m.receiver_type != ed.name || ed.type_params.len() == 0) {
    return m;
  }
  let recv: string = ed.name + "[" + subst_ty_join(ed.type_params, ",", [], []) + "]";
  let params: ast.ParamDecl[] = [];
  for p in m.params {
    params = params.append(ast.ParamDecl { ...p, type_name: enum_self_ty(p.type_name, ed.name, recv) });
  }
  return FuncDecl { ...m, receiver_type: recv, params: params, ret_type: enum_self_ty(m.ret_type, ed.name, recv), all_type_params: ed.type_params };
}

struct MeUses { enums: EnumDecl[], bases: string[] }

function me_use_spelling(ty: string, own u: MeUses): MeUses {
  if (ty.len() == 0) {
    return u;
  }
  return me_use_ref(parse_type_ref(ty), u);
}

function me_use_ref(r: TypeRef, own u: MeUses): MeUses {
  if (!r.is_tuple && !r.is_fn && r.args.len() > 0) {
    let t: string = me_ref_spelling(r);
    let base: string = slice_unchecked(t, 0, first_bracket(t)) + "";
    if (genum_index(u.enums, base) >= 0 && !str_in(u.bases, base) && !mono_ty_mentions_var(t) && genum_key_from_anno(t, base, u.enums).len() == 0) {
      u = MeUses { ...u, bases: u.bases.append(base) };
    }
  }
  for a in r.args {
    u = me_use_ref(a, u);
  }
  return u;
}

function me_use_list(list: string, own u: MeUses): MeUses {
  if (list.len() == 0) {
    return u;
  }
  for seg in split_top_commas(list) {
    u = me_use_spelling(spelling_without_own(seg), u);
  }
  return u;
}

function me_use_slot(ty: string, fn_ret: string, fn_params: string, own u: MeUses): MeUses {
  u = me_use_spelling(ty, u);
  u = me_use_spelling(fn_ret, u);
  return me_use_list(fn_params, u);
}

function me_use_stmt(st: ast.Stmt, own u: MeUses): MeUses {
  if let ast.StmtVar(v) = st {
    return me_use_slot(v.type_name, v.fn_ret, v.fn_param_types, u);
  }
  return u;
}

function me_use_expr(e: ast.Expr, own u: MeUses): MeUses {
  if let ast.ExprLambda(lm) = e {
    for p in lm.params {
      u = me_use_slot(p.type_name, p.fn_ret, p.fn_param_types, u);
    }
    return me_use_slot(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types, u);
  }
  return u;
}

function me_unkeyable_bases(mod: Module): string[] {
  let u: MeUses = MeUses { enums: mod.enums, bases: [] };
  for fd in mod.funcs {
    for p in fd.params {
      u = me_use_slot(p.type_name, p.fn_ret, p.fn_param_types, u);
    }
    u = me_use_slot(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types, u);
    for st in fd.body {
      u = astwalk.fold_stmt_nodes(st, u, me_use_stmt, me_use_expr, astwalk.descend_all);
    }
  }
  for st in mod.top_stmts {
    u = astwalk.fold_stmt_nodes(st, u, me_use_stmt, me_use_expr, astwalk.descend_all);
  }
  for sd in mod.structs {
    for f in sd.fields {
      u = me_use_slot(f.type_name, f.fn_ret, f.fn_param_types, u);
    }
  }
  return u.bases;
}

function me_mono_enums(mod: Module): EnumDecl[] {
  let unkeyable: string[] = me_unkeyable_bases(mod);
  let out: EnumDecl[] = [];
  for ed in mod.enums {
    if (!str_in(unkeyable, ed.name)) {
      out = out.append(ed);
    }
  }
  return out;
}

pub function monomorphize_enums(mod: Module): Module {
  let menums: EnumDecl[] = me_mono_enums(mod);
  let any: boolean = false;
  let ei: i32 = 0;
  while (ei < menums.len()) {
    if (menums[ei].type_params.len() > 0) {
      any = true;
    }
    ei = ei + 1;
  }
  if (!any) {
    return mod;
  }
  let mmod: Module = Module { ...mod, enums: menums };

  let ins: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let efns: MFns = mfns_of(mod.funcs, mod.structs, menums, mod.impls);

  let nfuncs: FuncDecl[] = [];
  let held: FuncDecl[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let fn: FuncDecl = mod.funcs[fi];
    let owner: string = "";
    if (fn.receiver_type.len() > 0 && genum_index(menums, strip_struct_base(fn.receiver_type)) >= 0) {
      owner = strip_struct_base(fn.receiver_type);
    }
    let env: MEnv = me_env_from_params(fn.params);
    if (fn.receiver_name.len() > 0) {
      env = env.ebind(fn.receiver_name, fn.receiver_type);
    }
    let rb: RStmts = me_stmts(fn.body, env, fn.ret_type, menums, mod.structs, efns, ins);
    ins = rb.rins3;
    ins = me_collect_slot(fn.ret_type, fn.ret_fn_ret, fn.ret_fn_param_types, menums, ins);
    for fp in fn.params {
      ins = me_collect_slot(fp.type_name, fp.fn_ret, fp.fn_param_types, menums, ins);
    }
    let fret: MeSlot = me_rewrite_slot(fn.ret_type, fn.ret_fn_ret, fn.ret_fn_param_types, menums);
    let rfn: FuncDecl = FuncDecl {
      ...fn,
      params: me_rewrite_params(fn.params, menums),
      ret_type: fret.ty, ret_fn_ret: fret.fn_ret, ret_fn_param_types: fret.fn_params, body: rb.rstmts,
    };
    if (owner.len() > 0) {
      held = held.append(enum_method_template(rfn, menums[genum_index(menums, owner)]));
    } else {
      nfuncs = nfuncs.append(rfn);
    }
    fi = fi + 1;
  }
  let topenv: MEnv = MEnv { mnames: [], mtypes: [] };
  let tr: RStmts = me_stmts(mod.top_stmts, topenv, "", menums, mod.structs, efns, ins);
  ins = tr.rins3;

  let sfi: i32 = 0;
  while (sfi < mod.structs.len()) {
    let sfd: StructFieldDecl[] = mod.structs[sfi].fields;
    let sfj: i32 = 0;
    while (sfj < sfd.len()) {
      ins = me_collect_slot(sfd[sfj].type_name, sfd[sfj].fn_ret, sfd[sfj].fn_param_types, menums, ins);
      sfj = sfj + 1;
    }
    sfi = sfi + 1;
  }

  let cl_enums: EnumDecl[] = [];
  let cl_structs: StructDecl[] = [];
  let instantiated: string[] = [];
  let wi: i32 = 0;
  while (wi < ins.inames.len()) {
    let base: string = ins.inames[wi];
    let key: string = ins.itypes[wi];
    let gidx: i32 = genum_index(menums, base);
    let step: BgStep = me_bg_step(gidx, base, key, mmod, efns, BgStep { funcs: nfuncs, ins: ins });
    nfuncs = step.funcs;
    ins = step.ins;
    if (gidx >= 0) {
      let ed: EnumDecl = menums[gidx];
      let cts: string[] = [ins.iargs[wi]];
      if (ed.type_params.len() != 1) {
        cts = split_key(key, ed.type_params.len(), mod.structs, menums);
      }
      let mname: string = base + "__" + key;
      let nvn: string[] = [];
      let vi2: i32 = 0;
      while (vi2 < ed.variant_names.len()) {
        let vn0: string = ed.variant_names[vi2];
        nvn = nvn.append(vn0 + "__" + key);
        let vidx: i32 = variant_struct_index(mod.structs, vn0, base);
        if (vidx >= 0) {
          let vs: StructDecl = mod.structs[vidx];
          let nf: StructFieldDecl[] = [];
          let fj2: i32 = 0;
          while (fj2 < vs.fields.len()) {
            let subbed: string = subst_ty(vs.fields[fj2].type_name, ed.type_params, cts);
            ins = me_collect_anno(subbed, menums, ins);
            let sub_ret: string = subst_ty(vs.fields[fj2].fn_ret, ed.type_params, cts);
            ins = me_collect_anno(sub_ret, menums, ins);
            let f_ty: string = me_rewrite_ty(subbed, menums);
            let f_ret: string = me_rewrite_ty(sub_ret, menums);
            let f_ptys: string = "";
            let pts: string[] = [];
            if (vs.fields[fj2].fn_param_types.len() > 0) {
              pts = split_top_commas(vs.fields[fj2].fn_param_types);
            }
            for pt0 in pts {
              let pt: string = subst_ty(pt0, ed.type_params, cts);
              ins = me_collect_anno(pt, menums, ins);
              if (f_ptys.len() > 0) {
                f_ptys = f_ptys + ",";
              }
              f_ptys = f_ptys + me_rewrite_ty(pt, menums);
            }
            if (pk_is_fn_spelling(f_ty)) {
              f_ret = me_rewrite_ty(fn_spelling_ret(f_ty), menums);
              ins = me_collect_anno(f_ret, menums, ins);
              f_ptys = fn_spelling_params(f_ty);
              f_ty = "fn";
            }
            nf = nf.append(StructFieldDecl { name: vs.fields[fj2].name, type_name: f_ty, fn_ret: f_ret, fn_param_types: f_ptys });
            fj2 = fj2 + 1;
          }
          cl_structs = cl_structs.append(StructDecl { name: vn0 + "__" + key, fields: nf, type_params: [], derives: vs.derives, line: vs.line, col: vs.col, enum_owner: mname, must_consume: vs.must_consume, variant_field_names: vs.variant_field_names, is_pub: true, is_package: false, opaque: vs.opaque, module: vs.module });
        }
        vi2 = vi2 + 1;
      }
      cl_enums = cl_enums.append(EnumDecl { name: mname, variant_names: nvn, type_params: [], line: ed.line, col: ed.col, must_consume: ed.must_consume, try_marker: ed.try_marker, is_pub: true, is_package: false, module: ed.module, instance: ed.name + "[" + subst_ty_join(cts, ",", [], []) + "]", visible_from: ed.visible_from });
      let mi: i32 = 0;
      while (mi < mod.funcs.len()) {
        let mm: FuncDecl = mod.funcs[mi];
        if (mm.receiver_type.len() > 0 && strip_struct_base(mm.receiver_type) == base) {
          let cm: FRes = clone_enum_method(mm, ed, cts, mname, mmod, efns, ins);
          ins = cm.fins;
          nfuncs = nfuncs.append(cm.ffn);
        }
        mi = mi + 1;
      }
      if (!str_in(instantiated, base)) {
        instantiated = instantiated.append(base);
      }
    }
    wi = wi + 1;
  }

  let out_enums: EnumDecl[] = [];
  let oei: i32 = 0;
  while (oei < mod.enums.len()) {
    out_enums = out_enums.append(mod.enums[oei]);
    oei = oei + 1;
  }
  let k2: i32 = 0;
  while (k2 < cl_enums.len()) {
    out_enums = out_enums.append(cl_enums[k2]);
    k2 = k2 + 1;
  }

  let out_structs: StructDecl[] = [];
  let osi: i32 = 0;
  while (osi < mod.structs.len()) {
    let sd: StructDecl = mod.structs[osi];
    if (sd.enum_owner.len() > 0 && str_in(instantiated, sd.enum_owner)) {
      out_structs = out_structs.append(sd);
    }
    if (sd.enum_owner.len() == 0 || !str_in(instantiated, sd.enum_owner)) {
      let rf: StructFieldDecl[] = [];
      let rfj: i32 = 0;
      while (rfj < sd.fields.len()) {
        let fslot: MeSlot = me_rewrite_slot(sd.fields[rfj].type_name, sd.fields[rfj].fn_ret, sd.fields[rfj].fn_param_types, menums);
        rf = rf.append(StructFieldDecl { name: sd.fields[rfj].name, type_name: fslot.ty, fn_ret: fslot.fn_ret, fn_param_types: fslot.fn_params });
        rfj = rfj + 1;
      }
      out_structs = out_structs.append(StructDecl { name: sd.name, fields: rf, type_params: sd.type_params, derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume, variant_field_names: sd.variant_field_names, is_pub: sd.is_pub, is_package: false, opaque: sd.opaque, module: sd.module });
    }
    osi = osi + 1;
  }
  let k3: i32 = 0;
  while (k3 < cl_structs.len()) {
    out_structs = out_structs.append(cl_structs[k3]);
    k3 = k3 + 1;
  }
  let hi: i32 = 0;
  while (hi < held.len()) {
    nfuncs = nfuncs.append(held[hi]);
    hi = hi + 1;
  }

  return Module { ...mod, funcs: nfuncs, structs: out_structs, top_stmts: tr.rstmts, enums: out_enums };
}

function str_in(xs: string[], s: string): boolean {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == s) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function dl_itoa(n: i32): string {
  if (n == 0) {
    return "0";
  }
  let digits: string = "0123456789";
  let s: string = "";
  let x: i32 = n;
  while (x > 0) {
    let d: i32 = x % 10;
    s = slice_unchecked(digits, d, d + 1) + s;
    x = x / 10;
  }
  return s;
}

struct DeferAcc { stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[] }

pub function is_value_local_name(name: string): boolean {
  let n: i32 = name.len();
  if (n < 6 || slice_unchecked(name, n - 2, n) != "_r") {
    return false;
  }
  let head: str = slice_unchecked(name, 0, 4);
  return head == "__tm" || head == "__sm" || head == "__nt" || head == "__na";
}

pub function is_value_block(c: ast.ExprCall): boolean {
  if (c.args.len() != 0) {
    return false;
  }
  match (c.callee) {
    ast.ExprLambda(l) => {
      if (l.params.len() != 0) {
        return false;
      }
      return is_value_block_origin(l.origin);
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function mkclo_body(name: string): string {
  let marker: string = "__mkclo$";
  if (name.len() <= marker.len() || slice_unchecked(name, 0, marker.len()) != marker) {
    return "";
  }
  return slice_unchecked(name, marker.len(), name.len()) + "";
}

pub function is_written_lambda_origin(origin: string): boolean {
  return origin.len() == 0 || origin == ast.ORIGIN_NESTED_FN || origin == ORIGIN_USE;
}

pub function is_value_block_origin(origin: string): boolean {
  if (origin == ORIGIN_BLOCK) {
    return true;
  }
  if (origin == ORIGIN_MATCH_EXPR) {
    return true;
  }
  if (origin == ORIGIN_IF_EXPR) {
    return true;
  }
  if (origin == ORIGIN_ARR_COMP) {
    return true;
  }
  if (origin == ORIGIN_MAP_COMP) {
    return true;
  }
  return false;
}

function dl_vb_rebuild(c: ast.ExprCall, body: ast.Stmt[]): ast.Expr {
  match (c.callee) {
    ast.ExprLambda(l) => {
      let lam: ast.Expr = ast.ExprLambda { ...l, body: body };
      return ast.ExprCall { callee: lam, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    _ => {
      return ast.ExprCall { callee: c.callee, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    }
  }
  return e_unknown("value block");
}

function dl_expr_kids(e: ast.Expr): ast.Expr[] {
  match (e) {
    ast.ExprBinary(b) => {
      return [b.left, b.right];
    },
    ast.ExprUnary(u) => {
      return [u.operand];
    },
    ast.ExprCall(c) => {
      let out: ast.Expr[] = [c.callee];
      let i: i32 = 0;
      while (i < c.args.len()) {
        out = out.append(c.args[i]);
        i = i + 1;
      }
      return out;
    },
    ast.ExprArray(a) => {
      return a.elements;
    },
    ast.ExprTuple(t) => {
      return t.elements;
    },
    ast.ExprIndex(x) => {
      return [x.array, x.index];
    },
    ast.ExprSlice(sl) => {
      return [sl.array, sl.start, sl.end];
    },
    ast.ExprStructLit(s) => {
      let out: ast.Expr[] = [s.base];
      let i: i32 = 0;
      while (i < s.field_values.len()) {
        out = out.append(s.field_values[i]);
        i = i + 1;
      }
      return out;
    },
    ast.ExprFieldAccess(fa) => {
      return [fa.obj];
    },
    ast.ExprMapLit(m) => {
      let out: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < m.keys.len()) {
        out = out.append(m.keys[i]);
        i = i + 1;
      }
      let j: i32 = 0;
      while (j < m.vals.len()) {
        out = out.append(m.vals[j]);
        j = j + 1;
      }
      return out;
    },
    ast.ExprFString(f) => {
      return f.exprs;
    },
    _ => {
      let none: ast.Expr[] = [];
      return none;
    }
  }
  let none2: ast.Expr[] = [];
  return none2;
}

function dl_stmts_have_defer(stmts: ast.Stmt[]): boolean {
  let i: i32 = 0;
  while (i < stmts.len()) {
    if (dl_stmt_has_defer(stmts[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function dl_stmts_have_defer_deep(stmts: ast.Stmt[]): boolean {
  function vs(st: ast.Stmt, own hit: boolean): boolean {
    if (hit) {
      return true;
    }
    match (st) {
      ast.StmtDefer(_) => {
        return true;
      },
      _ => {
        return false;
      }
    }
    return false;
  }
  function ve(e: ast.Expr, own hit: boolean): boolean {
    return hit;
  }
  let hit: boolean = false;
  for st in stmts {
    hit = astwalk.fold_stmt_nodes(st, hit, vs, ve, astwalk.descend_all);
  }
  return hit;
}

function dl_stmt_has_defer(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtDefer(_) => {
      return true;
    },
    ast.StmtVar(v) => {
      return dl_expr_has_defer(v.init);
    },
    ast.StmtReturn(r) => {
      return dl_expr_has_defer(r.value);
    },
    ast.StmtExpr(x) => {
      return dl_expr_has_defer(x.value);
    },
    ast.StmtAssign(a) => {
      return dl_expr_has_defer(a.value);
    },
    ast.StmtIf(f) => {
      return dl_expr_has_defer(f.cond) || dl_stmts_have_defer(f.then_body) || dl_stmts_have_defer(f.else_body);
    },
    ast.StmtWhile(w) => {
      return dl_expr_has_defer(w.cond) || dl_stmts_have_defer(w.body);
    },
    ast.StmtFor(fr) => {
      return dl_expr_has_defer(fr.iter) || dl_stmts_have_defer(fr.body);
    },
    ast.StmtMatch(m) => {
      if (dl_expr_has_defer(m.scrutinee)) {
        return true;
      }
      let i: i32 = 0;
      while (i < m.arms.len()) {
        if (dl_expr_has_defer(m.arms[i].guard)) {
          return true;
        }
        if (dl_stmts_have_defer(m.arms[i].body)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function dl_exprs_have_defer(es: ast.Expr[]): boolean {
  let i: i32 = 0;
  while (i < es.len()) {
    if (dl_expr_has_defer(es[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function dl_expr_has_defer(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            return dl_stmts_have_defer(l.body);
          },
          _ => {}
        }
      }
      if (dl_expr_has_defer(c.callee)) {
        return true;
      }
      return dl_exprs_have_defer(c.args);
    },
    ast.ExprBinary(b) => {
      return dl_expr_has_defer(b.left) || dl_expr_has_defer(b.right);
    },
    ast.ExprUnary(u) => {
      return dl_expr_has_defer(u.operand);
    },
    ast.ExprArray(a) => {
      return dl_exprs_have_defer(a.elements);
    },
    ast.ExprTuple(t) => {
      return dl_exprs_have_defer(t.elements);
    },
    ast.ExprIndex(x) => {
      return dl_expr_has_defer(x.array) || dl_expr_has_defer(x.index);
    },
    ast.ExprSlice(sl) => {
      return dl_expr_has_defer(sl.array) || dl_expr_has_defer(sl.start) || dl_expr_has_defer(sl.end);
    },
    ast.ExprStructLit(s) => {
      return dl_expr_has_defer(s.base) || dl_exprs_have_defer(s.field_values);
    },
    ast.ExprFieldAccess(fa) => {
      return dl_expr_has_defer(fa.obj);
    },
    ast.ExprMapLit(m) => {
      return dl_exprs_have_defer(m.keys) || dl_exprs_have_defer(m.vals);
    },
    ast.ExprFString(f) => {
      return dl_exprs_have_defer(f.exprs);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function dl_expr_with_kids(e: ast.Expr, kids: ast.Expr[]): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: kids[0], right: kids[1], line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: kids[0], line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      let i: i32 = 1;
      while (i < kids.len()) {
        args = args.append(kids[i]);
        i = i + 1;
      }
      return ast.ExprCall { callee: kids[0], args: args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      return ast.ExprArray { ...a, elements: kids };
    },
    ast.ExprTuple(t) => {
      return ast.ExprTuple { elements: kids, line: t.line, col: t.col };
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex { array: kids[0], index: kids[1], unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: kids[0], start: kids[1], end: kids[2] };
    },
    ast.ExprStructLit(s) => {
      let vals: ast.Expr[] = [];
      let i: i32 = 1;
      while (i < kids.len()) {
        vals = vals.append(kids[i]);
        i = i + 1;
      }
      return ast.ExprStructLit { ...s, field_values: vals, base: kids[0] };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, obj: kids[0] };
    },
    ast.ExprMapLit(m) => {
      let ks: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < m.keys.len()) {
        ks = ks.append(kids[i]);
        i = i + 1;
      }
      let vs: ast.Expr[] = [];
      let j: i32 = m.keys.len();
      while (j < kids.len()) {
        vs = vs.append(kids[j]);
        j = j + 1;
      }
      return ast.ExprMapLit { keys: ks, vals: vs, line: m.line, col: m.col };
    },
    ast.ExprFString(f) => {
      return ast.ExprFString { lits: f.lits, exprs: kids, is_expr: f.is_expr, line: f.line, col: f.col };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function map_expr_kids(e: ast.Expr, f: (ast.Expr) => ast.Expr): ast.Expr {
  let kids: ast.Expr[] = dl_expr_kids(e);
  if (kids.len() == 0) {
    return e;
  }
  let nk: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < kids.len()) {
    nk = nk.append(f(kids[i]));
    i = i + 1;
  }
  return dl_expr_with_kids(e, nk);
}

function dl_while(w: ast.StmtWhile, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtWhile { cond: w.cond, body: body, label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
}

function dl_for(fr: ast.StmtFor, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: body, label: fr.label, line: fr.line, col: fr.col };
}

function dl_iter_cleanup(actions: ast.Stmt[], flags: i32[], start: i32, end: i32): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = end - 1;
  while (i >= start) {
    let name: string = "__dfa" + dl_itoa(i);
    let body1: ast.Stmt[] = [];
    if (flags[i] == 0) {
      body1 = body1.append(actions[i]);
    }
    body1 = body1.append(s_assign(name, e_bool(false)));
    let noelse: ast.Stmt[] = [];
    out = out.append(s_if(e_ident(name), body1, noelse));
    i = i - 1;
  }
  return out;
}

struct DeferEdges { stmts: ast.Stmt[], armed: i32 }

pub function defer_flag(name: string): i32 {
  if (name.len() < 6 || slice_unchecked(name, 0, 5) != "__dfa") {
    return 0 - 1;
  }
  let digits: string = slice_unchecked(name, 5, name.len()) + "";
  if (!util.is_all_digits(digits)) {
    return 0 - 1;
  }
  return util.digits_to_i32(digits);
}

pub function defer_armed(a: ast.StmtAssign): i32 {
  if let ast.ExprBool(b) = a.value {
    if (b.value) {
      return defer_flag(a.target);
    }
  }
  return 0 - 1;
}

struct DeferEdgeExpr { expr: ast.Expr, armed: i32 }

function dl_edges_expr(e: ast.Expr, actions: ast.Stmt[], flags: i32[], start: i32, armed0: i32, label: string, own_level: boolean): DeferEdgeExpr {
  match (e) {
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            let vb: DeferEdges = dl_expand_loop_edges(l.body, actions, flags, start, armed0, label, own_level);
            return DeferEdgeExpr { expr: dl_vb_rebuild(c, vb.stmts), armed: vb.armed };
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  let kids: ast.Expr[] = dl_expr_kids(e);
  if (kids.len() == 0) {
    return DeferEdgeExpr { expr: e, armed: armed0 };
  }
  let out: ast.Expr[] = [];
  let armed: i32 = armed0;
  let i: i32 = 0;
  while (i < kids.len()) {
    let r: DeferEdgeExpr = dl_edges_expr(kids[i], actions, flags, start, armed, label, own_level);
    out = out.append(r.expr);
    armed = r.armed;
    i = i + 1;
  }
  return DeferEdgeExpr { expr: dl_expr_with_kids(e, out), armed: armed };
}

function dl_expand_loop_edges(stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[], start: i32, armed0: i32, label: string, own_level: boolean): DeferEdges {
  let out: ast.Stmt[] = [];
  let armed: i32 = armed0;
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtAssign(a) => {
        let ave: DeferEdgeExpr = dl_edges_expr(a.value, actions, flags, start, armed, label, own_level);
        armed = ave.armed;
        let ast: ast.StmtAssign = ast.StmtAssign { target: a.target, value: ave.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
        let ax: i32 = defer_armed(ast);
        if (ax >= armed) {
          armed = ax + 1;
        }
        out = out.append(ast);
      },
      ast.StmtVar(v) => {
        let vve: DeferEdgeExpr = dl_edges_expr(v.init, actions, flags, start, armed, label, own_level);
        armed = vve.armed;
        out = out.append(ast.StmtVar { name: v.name, type_name: v.type_name, init: vve.expr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types });
      },
      ast.StmtExpr(x) => {
        let xve: DeferEdgeExpr = dl_edges_expr(x.value, actions, flags, start, armed, label, own_level);
        armed = xve.armed;
        out = out.append(ast.StmtExpr { value: xve.expr, line: x.line });
      },
      ast.StmtReturn(r) => {
        let rve: DeferEdgeExpr = dl_edges_expr(r.value, actions, flags, start, armed, label, own_level);
        armed = rve.armed;
        out = out.append(ast.StmtReturn { value: rve.expr, line: r.line, col: r.col });
      },
      ast.StmtBreak(b) => {
        if (own_level && b.label.len() == 0 || label.len() > 0 && b.label == label) {
          let cb: ast.Stmt[] = dl_iter_cleanup(actions, flags, start, armed);
          let kb: i32 = 0;
          while (kb < cb.len()) {
            out = out.append(cb[kb]);
            kb = kb + 1;
          }
        }
        out = out.append(stmts[i]);
      },
      ast.StmtContinue(c) => {
        if (own_level && c.label.len() == 0 || label.len() > 0 && c.label == label) {
          let cc: ast.Stmt[] = dl_iter_cleanup(actions, flags, start, armed);
          let kc: i32 = 0;
          while (kc < cc.len()) {
            out = out.append(cc[kc]);
            kc = kc + 1;
          }
        }
        out = out.append(stmts[i]);
      },
      ast.StmtIf(f) => {
        let ce: DeferEdgeExpr = dl_edges_expr(f.cond, actions, flags, start, armed, label, own_level);
        armed = ce.armed;
        let tr: DeferEdges = dl_expand_loop_edges(f.then_body, actions, flags, start, armed, label, own_level);
        let er: DeferEdges = dl_expand_loop_edges(f.else_body, actions, flags, start, armed, label, own_level);
        if (tr.armed > armed) {
          armed = tr.armed;
        }
        if (er.armed > armed) {
          armed = er.armed;
        }
        out = out.append(s_if(ce.expr, tr.stmts, er.stmts));
      },
      ast.StmtMatch(m) => {
        let se: DeferEdgeExpr = dl_edges_expr(m.scrutinee, actions, flags, start, armed, label, own_level);
        armed = se.armed;
        let arms: ast.MatchArm[] = [];
        let ai: i32 = 0;
        while (ai < m.arms.len()) {
          let ge: DeferEdgeExpr = dl_edges_expr(m.arms[ai].guard, actions, flags, start, armed, label, own_level);
          let ar: DeferEdges = dl_expand_loop_edges(m.arms[ai].body, actions, flags, start, ge.armed, label, own_level);
          if (ar.armed > armed) {
            armed = ar.armed;
          }
          arms = arms.append(ast.MatchArm { pattern: m.arms[ai].pattern, body: ar.stmts, line: m.arms[ai].line, col: m.arms[ai].col, guard: ge.expr, has_guard: m.arms[ai].has_guard, alt_cont: false });
          ai = ai + 1;
        }
        out = out.append(s_match(se.expr, arms));
      },
      ast.StmtWhile(w) => {
        let wce: DeferEdgeExpr = dl_edges_expr(w.cond, actions, flags, start, armed, label, own_level);
        armed = wce.armed;
        let wl: ast.StmtWhile = ast.StmtWhile { cond: wce.expr, body: w.body, label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
        let wr: DeferEdges = dl_expand_loop_edges(w.body, actions, flags, start, armed, label, false);
        if (wr.armed > armed) {
          armed = wr.armed;
        }
        if (label.len() == 0) {
          out = out.append(dl_while(wl, w.body));
        } else {
          out = out.append(dl_while(wl, wr.stmts));
        }
      },
      ast.StmtFor(fr) => {
        let fie: DeferEdgeExpr = dl_edges_expr(fr.iter, actions, flags, start, armed, label, own_level);
        armed = fie.armed;
        let fl: ast.StmtFor = ast.StmtFor { var_name: fr.var_name, iter: fie.expr, body: fr.body, label: fr.label, line: fr.line, col: fr.col };
        let fr2: DeferEdges = dl_expand_loop_edges(fr.body, actions, flags, start, armed, label, false);
        if (fr2.armed > armed) {
          armed = fr2.armed;
        }
        if (label.len() == 0) {
          out = out.append(dl_for(fl, fr.body));
        } else {
          out = out.append(dl_for(fl, fr2.stmts));
        }
      },
      _ => {
        out = out.append(stmts[i]);
      }
    }
    i = i + 1;
  }
  return DeferEdges { stmts: out, armed: armed };
}

function dl_loop_body(body: ast.Stmt[], actions: ast.Stmt[], flags: i32[], start: i32, label: string): ast.Stmt[] {
  let end: i32 = actions.len();
  if (end <= start) {
    return body;
  }
  let r: DeferEdges = dl_expand_loop_edges(body, actions, flags, start, start, label, true);
  let out: ast.Stmt[] = r.stmts;
  let cleanup: ast.Stmt[] = dl_iter_cleanup(actions, flags, start, end);
  let i: i32 = 0;
  while (i < cleanup.len()) {
    out = out.append(cleanup[i]);
    i = i + 1;
  }
  return out;
}

function dl_collect_stmts(stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[]): DeferAcc {
  let out: ast.Stmt[] = [];
  let acc: ast.Stmt[] = actions;
  let afl: i32[] = flags;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let r: DeferAcc = dl_collect_stmt(stmts[i], acc, afl);
    let j: i32 = 0;
    while (j < r.stmts.len()) {
      out = out.append(r.stmts[j]);
      j = j + 1;
    }
    acc = r.actions;
    afl = r.flags;
    i = i + 1;
  }
  return DeferAcc { stmts: out, actions: acc, flags: afl };
}

struct DeferExprAcc { expr: ast.Expr, actions: ast.Stmt[], flags: i32[] }

function dl_collect_expr(e: ast.Expr, actions: ast.Stmt[], flags: i32[]): DeferExprAcc {
  match (e) {
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            let vb: DeferAcc = dl_collect_stmts(l.body, actions, flags);
            return DeferExprAcc { expr: dl_vb_rebuild(c, vb.stmts), actions: vb.actions, flags: vb.flags };
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  let kids: ast.Expr[] = dl_expr_kids(e);
  if (kids.len() == 0) {
    return DeferExprAcc { expr: e, actions: actions, flags: flags };
  }
  let out: ast.Expr[] = [];
  let acc: ast.Stmt[] = actions;
  let afl: i32[] = flags;
  let i: i32 = 0;
  while (i < kids.len()) {
    let r: DeferExprAcc = dl_collect_expr(kids[i], acc, afl);
    out = out.append(r.expr);
    acc = r.actions;
    afl = r.flags;
    i = i + 1;
  }
  return DeferExprAcc { expr: dl_expr_with_kids(e, out), actions: acc, flags: afl };
}

function dl_collect_stmt(st: ast.Stmt, actions: ast.Stmt[], flags: i32[]): DeferAcc {
  match (st) {
    ast.StmtDefer(d) => {
      let setflag: ast.Stmt = s_assign("__dfa" + dl_itoa(actions.len()), e_bool(true));
      let one: ast.Stmt[] = [setflag];
      return DeferAcc { stmts: one, actions: actions.append(d.action), flags: flags.append(d.on_error) };
    },
    ast.StmtVar(v) => {
      let ir: DeferExprAcc = dl_collect_expr(v.init, actions, flags);
      let one: ast.Stmt[] = [ast.StmtVar { name: v.name, type_name: v.type_name, init: ir.expr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }];
      return DeferAcc { stmts: one, actions: ir.actions, flags: ir.flags };
    },
    ast.StmtReturn(r) => {
      let vr: DeferExprAcc = dl_collect_expr(r.value, actions, flags);
      let one: ast.Stmt[] = [ast.StmtReturn { value: vr.expr, line: r.line, col: r.col }];
      return DeferAcc { stmts: one, actions: vr.actions, flags: vr.flags };
    },
    ast.StmtExpr(x) => {
      let xr: DeferExprAcc = dl_collect_expr(x.value, actions, flags);
      let one: ast.Stmt[] = [ast.StmtExpr { value: xr.expr, line: x.line }];
      return DeferAcc { stmts: one, actions: xr.actions, flags: xr.flags };
    },
    ast.StmtAssign(a) => {
      let ar: DeferExprAcc = dl_collect_expr(a.value, actions, flags);
      let one: ast.Stmt[] = [ast.StmtAssign { target: a.target, value: ar.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }];
      return DeferAcc { stmts: one, actions: ar.actions, flags: ar.flags };
    },
    ast.StmtIf(f) => {
      let cr: DeferExprAcc = dl_collect_expr(f.cond, actions, flags);
      let tr: DeferAcc = dl_collect_stmts(f.then_body, cr.actions, cr.flags);
      let er: DeferAcc = dl_collect_stmts(f.else_body, tr.actions, tr.flags);
      let one: ast.Stmt[] = [s_if(cr.expr, tr.stmts, er.stmts)];
      return DeferAcc { stmts: one, actions: er.actions, flags: er.flags };
    },
    ast.StmtWhile(w) => {
      let cw: DeferExprAcc = dl_collect_expr(w.cond, actions, flags);
      let wstart: i32 = cw.actions.len();
      let br: DeferAcc = dl_collect_stmts(w.body, cw.actions, cw.flags);
      let wl: ast.StmtWhile = ast.StmtWhile { cond: cw.expr, body: w.body, label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
      let one: ast.Stmt[] = [dl_while(wl, dl_loop_body(br.stmts, br.actions, br.flags, wstart, w.label))];
      return DeferAcc { stmts: one, actions: br.actions, flags: br.flags };
    },
    ast.StmtFor(fr) => {
      let itr: DeferExprAcc = dl_collect_expr(fr.iter, actions, flags);
      let fstart: i32 = itr.actions.len();
      let br: DeferAcc = dl_collect_stmts(fr.body, itr.actions, itr.flags);
      let fl: ast.StmtFor = ast.StmtFor { var_name: fr.var_name, iter: itr.expr, body: fr.body, label: fr.label, line: fr.line, col: fr.col };
      let one: ast.Stmt[] = [dl_for(fl, dl_loop_body(br.stmts, br.actions, br.flags, fstart, fr.label))];
      return DeferAcc { stmts: one, actions: br.actions, flags: br.flags };
    },
    ast.StmtMatch(m) => {
      let sr: DeferExprAcc = dl_collect_expr(m.scrutinee, actions, flags);
      let arms: ast.MatchArm[] = [];
      let acc: ast.Stmt[] = sr.actions;
      let afl: i32[] = sr.flags;
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let gr: DeferExprAcc = dl_collect_expr(m.arms[i].guard, acc, afl);
        let ar: DeferAcc = dl_collect_stmts(m.arms[i].body, gr.actions, gr.flags);
        arms = arms.append(ast.MatchArm { pattern: m.arms[i].pattern, body: ar.stmts, line: m.arms[i].line, col: m.arms[i].col, guard: gr.expr, has_guard: m.arms[i].has_guard, alt_cont: false });
        acc = ar.actions;
        afl = ar.flags;
        i = i + 1;
      }
      let one: ast.Stmt[] = [s_match(sr.expr, arms)];
      return DeferAcc { stmts: one, actions: acc, flags: afl };
    },
    _ => {
      let one: ast.Stmt[] = [st];
      return DeferAcc { stmts: one, actions: actions, flags: flags };
    }
  }
}

function dl_cleanup_kind(actions: ast.Stmt[], flags: i32[], want: i32, end: i32): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = end - 1;
  while (i >= 0) {
    if (flags[i] == want) {
      let body1: ast.Stmt[] = [actions[i]];
      let noelse: ast.Stmt[] = [];
      out = out.append(s_if(e_ident("__dfa" + dl_itoa(i)), body1, noelse));
    }
    i = i - 1;
  }
  return out;
}

function dl_is_err_value(e: ast.Expr): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == "None";
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return cid.name == "Err";
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

function dl_expand_returns(stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let at: i32 = armed;
  for st in stmts {
    out = util.append_all(out, dl_expand_return_stmt(st, actions, flags, at));
    at = dl_armed_after(st, at);
  }
  return out;
}

function dl_armed_after(st: ast.Stmt, armed: i32): i32 {
  return astwalk.fold_stmt_nodes(st, armed, dl_arm_stmt, dl_arm_expr, dl_arm_descend);
}

function dl_armed_after_expr(e: ast.Expr, armed: i32): i32 {
  return astwalk.fold_expr_nodes(e, armed, dl_arm_stmt, dl_arm_expr, dl_arm_descend);
}

function dl_arm_stmt(st: ast.Stmt, own acc: i32): i32 {
  if let ast.StmtAssign(a) = st {
    let ax: i32 = defer_armed(a);
    if (ax >= acc) {
      return ax + 1;
    }
  }
  return acc;
}

function dl_arm_expr(e: ast.Expr, own acc: i32): i32 {
  return acc;
}

function dl_arm_descend(e: ast.Expr): boolean {
  if let ast.ExprLambda(l) = e {
    return is_value_block_origin(l.origin);
  }
  return true;
}

function dl_expand_returns_vb(body: ast.Stmt[], actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt[] {
  if (body.len() == 0) {
    return body;
  }
  let lead: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < body.len() - 1) {
    lead = lead.append(body[i]);
    i = i + 1;
  }
  return dl_expand_returns(lead, actions, flags, armed).append(body[body.len() - 1]);
}

function dl_return_expr(e: ast.Expr, actions: ast.Stmt[], flags: i32[], armed: i32): ast.Expr {
  if let ast.ExprCall(c) = e {
    if (is_value_block(c)) {
      if let ast.ExprLambda(l) = c.callee {
        return dl_vb_rebuild(c, dl_expand_returns_vb(l.body, actions, flags, armed));
      }
    }
  }
  let kids: ast.Expr[] = dl_expr_kids(e);
  if (kids.len() == 0) {
    return e;
  }
  let out: ast.Expr[] = [];
  let at: i32 = armed;
  for k in kids {
    out = out.append(dl_return_expr(k, actions, flags, at));
    at = dl_armed_after_expr(k, at);
  }
  return dl_expr_with_kids(e, out);
}

function dl_expand_return(r: ast.StmtReturn, actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt[] {
  let rv: ast.Expr = dl_return_expr(r.value, actions, flags, armed);
  let at: i32 = dl_armed_after_expr(r.value, armed);
  let isvoid: boolean = false;
  if let ast.ExprUnknown(_) = rv {
    isvoid = true;
  }
  let out: ast.Stmt[] = [];
  if (!isvoid) {
    out = out.append(s_assign("__defret", rv));
  }
  out = util.append_all(out, dl_cleanup_kind(actions, flags, 0, at));
  if (!isvoid && dl_is_err_value(rv)) {
    out = util.append_all(out, dl_cleanup_kind(actions, flags, 1, at));
  }
  if (isvoid) {
    return out.append(s_return(rv));
  }
  return out.append(s_return(e_ident("__defret")));
}

function dl_expand_return_match(m: ast.StmtMatch, actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt {
  let at: i32 = dl_armed_after_expr(m.scrutinee, armed);
  let arms: ast.MatchArm[] = [];
  for a in m.arms {
    let body_at: i32 = dl_armed_after_expr(a.guard, at);
    arms = arms.append(ast.MatchArm { pattern: a.pattern, body: dl_expand_returns(a.body, actions, flags, body_at), line: a.line, col: a.col, guard: dl_return_expr(a.guard, actions, flags, at), has_guard: a.has_guard, alt_cont: false });
  }
  return s_match(dl_return_expr(m.scrutinee, actions, flags, armed), arms);
}

function dl_expand_return_stmt(st: ast.Stmt, actions: ast.Stmt[], flags: i32[], armed: i32): ast.Stmt[] {
  match (st) {
    ast.StmtReturn(r) => {
      return dl_expand_return(r, actions, flags, armed);
    },
    ast.StmtVar(v) => {
      let one: ast.Stmt[] = [ast.StmtVar { name: v.name, type_name: v.type_name, init: dl_return_expr(v.init, actions, flags, armed), line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }];
      return one;
    },
    ast.StmtExpr(x) => {
      let one: ast.Stmt[] = [ast.StmtExpr { value: dl_return_expr(x.value, actions, flags, armed), line: x.line }];
      return one;
    },
    ast.StmtAssign(a) => {
      let one: ast.Stmt[] = [ast.StmtAssign { target: a.target, value: dl_return_expr(a.value, actions, flags, armed), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }];
      return one;
    },
    ast.StmtIf(f) => {
      let at: i32 = dl_armed_after_expr(f.cond, armed);
      let one: ast.Stmt[] = [s_if(dl_return_expr(f.cond, actions, flags, armed), dl_expand_returns(f.then_body, actions, flags, at), dl_expand_returns(f.else_body, actions, flags, at))];
      return one;
    },
    ast.StmtWhile(w) => {
      let wl: ast.StmtWhile = ast.StmtWhile { cond: dl_return_expr(w.cond, actions, flags, armed), body: w.body, label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
      let one: ast.Stmt[] = [dl_while(wl, dl_expand_returns(w.body, actions, flags, dl_armed_after_expr(w.cond, armed)))];
      return one;
    },
    ast.StmtFor(fr) => {
      let fl: ast.StmtFor = ast.StmtFor { var_name: fr.var_name, iter: dl_return_expr(fr.iter, actions, flags, armed), body: fr.body, label: fr.label, line: fr.line, col: fr.col };
      let one: ast.Stmt[] = [dl_for(fl, dl_expand_returns(fr.body, actions, flags, dl_armed_after_expr(fr.iter, armed)))];
      return one;
    },
    ast.StmtMatch(m) => {
      let one: ast.Stmt[] = [dl_expand_return_match(m, actions, flags, armed)];
      return one;
    },
    _ => {
      let one: ast.Stmt[] = [st];
      return one;
    }
  }
}

pub struct CapLift { name: string, caps: string[] }

function hl_no_lifts(): CapLift[] {
  let e: CapLift[] = [];

  return e;
}

function hl_append_lifts(a: CapLift[], b: CapLift[]): CapLift[] {
  let out: CapLift[] = a;
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

function hl_param_names(params: ast.ParamDecl[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < params.len()) {
    out = out.append(params[i].name);
    i = i + 1;
  }
  return out;
}

function hl_append_str(a: string[], b: string[]): string[] {
  let out: string[] = a;
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

function hl_collect_var_names(stmts: ast.Stmt[]): string[] {
  function vs(st: ast.Stmt, own acc: string[]): string[] {
    match (st) {
      ast.StmtVar(v) => {
        return acc.append(v.name);
      },
      _ => {
        return acc;
      }
    }
    return acc;
  }
  let out: string[] = [];
  for st in stmts {
    out = astwalk.fold_stmt_spine(st, out, vs);
  }
  return out;
}

pub struct NestedFn { name: string, lam: ast.ExprLambda, refs: string[] }

function hl_add_nested_fn(st: ast.Stmt, own acc: NestedFn[]): NestedFn[] {
  if let ast.StmtVar(v) = st {
    if let ast.ExprLambda(lam) = v.init {
      if (ast.var_binds_itself(v)) {
        return acc.append(NestedFn { name: v.name, lam: lam, refs: [] });
      }
    }
  }
  return acc;
}

function hl_link(found: NestedFn[]): NestedFn[] {
  let out: NestedFn[] = [];
  for sb in found {
    let refs: string[] = [];
    for other in found {
      if (!util.has_str(refs, other.name) && stmts_mention(sb.lam.body, other.name)) {
        refs = refs.append(other.name);
      }
    }
    out = out.append(NestedFn { ...sb, refs: refs });
  }
  return out;
}

pub function nested_fns(stmts: ast.Stmt[]): NestedFn[] {
  let found: NestedFn[] = [];
  for st in stmts {
    found = hl_add_nested_fn(st, found);
  }
  return hl_link(found);
}

function hl_refs(sibs: NestedFn[], name: string): string[] {
  for sb in sibs {
    if (sb.name == name) {
      return sb.refs;
    }
  }
  let none: string[] = [];
  return none;
}

function hl_reach(sibs: NestedFn[], from: string): string[] {
  let seen: string[] = hl_refs(sibs, from);
  let i: i32 = 0;
  while (i < seen.len()) {
    for r in hl_refs(sibs, seen[i]) {
      if (!util.has_str(seen, r)) {
        seen = seen.append(r);
      }
    }
    i = i + 1;
  }
  return seen;
}

pub function nested_fn_cycle(sibs: NestedFn[], name: string): string[] {
  let out: string[] = [];
  let reach: string[] = hl_reach(sibs, name);
  if (!util.has_str(reach, name)) {
    return out;
  }
  for sb in sibs {
    if (sb.name == name || util.has_str(reach, sb.name) && util.has_str(hl_reach(sibs, sb.name), name)) {
      out = out.append(sb.name);
    }
  }
  return out;
}

function hl_has_rec_local(stmts: ast.Stmt[]): boolean {
  if (hl_list_has_cycle(stmts)) {
    return true;
  }
  function vs(st: ast.Stmt, own hit: boolean): boolean {
    return hit || hl_owned_lists_have_cycle(st);
  }
  for st in stmts {
    if (astwalk.fold_stmt_spine(st, false, vs)) {
      return true;
    }
  }
  return false;
}

function hl_owned_lists_have_cycle(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtVar(v) => {
      if let ast.ExprLambda(lam) = v.init {
        return hl_has_rec_local(lam.body);
      }
      return false;
    },
    ast.StmtIf(f) => {
      return hl_list_has_cycle(f.then_body) || hl_list_has_cycle(f.else_body);
    },
    ast.StmtWhile(w) => {
      return hl_list_has_cycle(w.body);
    },
    ast.StmtFor(fr) => {
      return hl_list_has_cycle(fr.body);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        if (hl_list_has_cycle(arm.body)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function hl_list_has_cycle(stmts: ast.Stmt[]): boolean {
  let sibs: NestedFn[] = nested_fns(stmts);
  for sb in sibs {
    if (nested_fn_cycle(sibs, sb.name).len() > 0) {
      return true;
    }
  }
  return false;
}

function hl_capture_list(lam: ast.ExprLambda, lifted: string[], enclosing: string[]): string[] {
  let shadow: string[] = hl_param_names(lam.params);
  shadow = hl_append_str(shadow, hl_collect_var_names(lam.body));
  let caps: string[] = [];
  let i: i32 = 0;
  while (i < enclosing.len()) {
    let e: string = enclosing[i];
    if (!util.has_str(lifted, e) && !util.has_str(shadow, e) && !util.has_str(caps, e)) {
      if (stmts_mention(lam.body, e)) {
        caps = caps.append(e);
      }
    }
    i = i + 1;
  }
  return caps;
}

function hl_cycle_captures(sibs: NestedFn[], cycle: string[], enclosing: string[]): string[] {
  let caps: string[] = [];
  for sb in sibs {
    if (util.has_str(cycle, sb.name)) {
      for c in hl_capture_list(sb.lam, cycle, enclosing) {
        if (!util.has_str(caps, c)) {
          caps = caps.append(c);
        }
      }
    }
  }
  return caps;
}

function rw_call_of(x: ast.Expr, fname: string, caps: string[]): ast.Expr {
  match (x) {
    ast.ExprCall(c) => {
      let is_target: boolean = false;
      match (c.callee) {
        ast.ExprIdent(id) => {
          if (id.name == fname) {
            is_target = true;
          }
        },
        _ => {}
      }
      if (!is_target) {
        return x;
      }
      let new_args: ast.Expr[] = c.args;
      for cp in caps {
        new_args = new_args.append(e_ident(cp));
      }
      return ast.ExprCall { ...c, args: new_args };
    },
    _ => {
      return x;
    }
  }
  return x;
}

function rw_call_stmts(stmts: ast.Stmt[], fname: string, caps: string[]): ast.Stmt[] {
  function rw(x: ast.Expr): ast.Expr {
    return rw_call_of(x, fname, caps);
  }
  return astwalk.map_stmts(stmts, rw);
}

struct HlScope { names: string[], env: MEnv, fns: MFns }

function hl_lambda_scope(sc: HlScope, lam: ast.ExprLambda): HlScope {
  let names: string[] = hl_append_str(hl_append_str(sc.names, hl_param_names(lam.params)), hl_collect_var_names(lam.body));
  let pe: MEnv = me_env_from_params(lam.params);
  let env: MEnv = MEnv { mnames: hl_append_str(sc.env.mnames, pe.mnames), mtypes: hl_append_str(sc.env.mtypes, pe.mtypes) };
  return HlScope { ...sc, names: names, env: env };
}

function hl_var_type(v: ast.StmtVar, sc: HlScope): string {
  if (v.type_name.len() > 0) {
    return v.type_name;
  }
  return mono_infer(v.init, sc.env, sc.fns);
}

function hl_cap_type(sc: HlScope, name: string): string {
  let t: string = sc.env.elook(name);
  if (t == "fn" || util.contains(t, "=>")) {
    return "";
  }
  return t;
}

function hl_rewrite_match(m: ast.StmtMatch, sc: HlScope, hoisted: FuncDecl[]): (ast.Stmt[], FuncDecl[], CapLift[]) {
  let arms: ast.MatchArm[] = [];
  let acc: FuncDecl[] = hoisted;
  let acc_lifts: CapLift[] = hl_no_lifts();
  let a: i32 = 0;
  while (a < m.arms.len()) {
    let (ar_stmts, ar_hoisted, ar_lifts) = hl_rewrite(m.arms[a].body, sc, acc);
    acc = ar_hoisted;
    acc_lifts = hl_append_lifts(acc_lifts, ar_lifts);
    arms = arms.append(ast.MatchArm { pattern: m.arms[a].pattern, body: ar_stmts, line: m.arms[a].line, col: m.arms[a].col, guard: m.arms[a].guard, has_guard: m.arms[a].has_guard, alt_cont: false });
    a = a + 1;
  }
  return ([s_match_at(m.scrutinee, arms, m.line, m.col)], acc, acc_lifts);
}

function hl_rewrite(stmts: ast.Stmt[], outer: HlScope, hoisted: FuncDecl[]): (ast.Stmt[], FuncDecl[], CapLift[]) {
  if (!hl_has_rec_local(stmts)) {
    return (stmts, hoisted, hl_no_lifts());
  }
  let out: ast.Stmt[] = [];
  let acc: FuncDecl[] = hoisted;
  let acc_lifts: CapLift[] = hl_no_lifts();
  let sc: HlScope = outer;
  let sibs: NestedFn[] = nested_fns(stmts);
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtVar(v) => {
        let did_lift: boolean = false;
        match (v.init) {
          ast.ExprLambda(lam) => {
            let cycle: string[] = nested_fn_cycle(sibs, v.name);
            if (cycle.len() > 0) {
              did_lift = true;
              let caps: string[] = hl_cycle_captures(sibs, cycle, sc.names);
              let own_names: string[] = hl_append_str(hl_param_names(lam.params), hl_collect_var_names(lam.body));
              let fwd: string[] = [];
              let new_params: ast.ParamDecl[] = lam.params;
              let ci: i32 = 0;
              while (ci < caps.len()) {
                let pname: string = caps[ci];
                if (util.has_str(own_names, pname)) {
                  pname = "__cap_" + pname;
                }
                fwd = fwd.append(pname);
                new_params = new_params.append(ast.ParamDecl { name: pname, type_name: hl_cap_type(sc, caps[ci]), own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" });
                ci = ci + 1;
              }
              let inner_encl: string[] = hl_param_names(new_params);
              inner_encl = hl_append_str(inner_encl, hl_collect_var_names(lam.body));
              let inner: HlScope = HlScope { ...sc, names: inner_encl, env: me_env_from_params(new_params) };
              let (ir_stmts, ir_hoisted, ir_lifts) = hl_rewrite(lam.body, inner, acc);
              acc = ir_hoisted;
              acc_lifts = hl_append_lifts(acc_lifts, ir_lifts);
              let lifted_body: ast.Stmt[] = ir_stmts;
              if (caps.len() > 0) {
                for member in cycle {
                  lifted_body = rw_call_stmts(lifted_body, member, fwd);
                }
              }
              let notp: string[] = [];
              acc = acc.append(FuncDecl {
                stdlib: "", no_inline: false,
                name: v.name, receiver_name: "", receiver_type: "", receiver_own: false,
                type_params: notp, params: new_params, ret_type: lam.ret_type,
                body: lifted_body, line: v.line, col: v.col,
                import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
                is_pub: true,
                is_const: false, ret_fn_ret: lam.ret_fn_ret, ret_fn_param_types: lam.ret_fn_param_types, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [],
              });
              if (caps.len() > 0) {
                acc_lifts = acc_lifts.append(CapLift { name: v.name, caps: caps });
              }
            }
          },
          _ => {}
        }
        if (!did_lift) {
          let kept: ast.Stmt = stmts[i];
          if let ast.ExprLambda(lam) = v.init {
            let (lb_stmts, lb_hoisted, lb_lifts) = hl_rewrite(lam.body, hl_lambda_scope(sc, lam), acc);
            if (lb_hoisted.len() > acc.len()) {
              kept = ast.StmtVar { ...v, init: ast.ExprLambda { ...lam, body: lb_stmts } };
            }
            acc = lb_hoisted;
            acc_lifts = hl_append_lifts(acc_lifts, lb_lifts);
          }
          sc = HlScope { ...sc, env: sc.env.ebind(v.name, hl_var_type(v, sc)) };
          out = out.append(kept);
        }
      },
      ast.StmtIf(f) => {
        let (tr_stmts, tr_hoisted, tr_lifts) = hl_rewrite(f.then_body, sc, acc);
        acc = tr_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, tr_lifts);
        let (er_stmts, er_hoisted, er_lifts) = hl_rewrite(f.else_body, sc, acc);
        acc = er_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, er_lifts);
        out = out.append(s_if(f.cond, tr_stmts, er_stmts));
      },
      ast.StmtWhile(w) => {
        let (wr_stmts, wr_hoisted, wr_lifts) = hl_rewrite(w.body, sc, acc);
        acc = wr_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, wr_lifts);
        out = out.append(s_while(w.cond, wr_stmts));
      },
      ast.StmtFor(fr) => {
        let (fr2_stmts, fr2_hoisted, fr2_lifts) = hl_rewrite(fr.body, sc, acc);
        acc = fr2_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, fr2_lifts);
        out = out.append(s_for(fr.var_name, fr.iter, fr2_stmts));
      },
      ast.StmtMatch(m) => {
        let (mr_stmts, mr_hoisted, mr_lifts) = hl_rewrite_match(m, sc, acc);
        acc = mr_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, mr_lifts);
        let km: i32 = 0;
        while (km < mr_stmts.len()) {
          out = out.append(mr_stmts[km]);
          km = km + 1;
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        let (dr_stmts, dr_hoisted, dr_lifts) = hl_rewrite(one, sc, acc);
        acc = dr_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, dr_lifts);
        if (dr_stmts.len() >= 1) {
          out = out.append(s_defer(dr_stmts[0]));
        }
      },
      _ => {
        out = out.append(stmts[i]);
      }
    }
    i = i + 1;
  }
  return (out, acc, acc_lifts);
}

function hl_apply_lifts(stmts: ast.Stmt[], lifts: CapLift[]): ast.Stmt[] {
  let out: ast.Stmt[] = stmts;
  let i: i32 = 0;
  while (i < lifts.len()) {
    if (lifts[i].caps.len() > 0) {
      out = rw_call_stmts(out, lifts[i].name, lifts[i].caps);
    }
    i = i + 1;
  }
  return out;
}

pub function hoist_local_funcs_module(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let hoisted: FuncDecl[] = [];
  let fns: MFns = mfns_of(mod.funcs, mod.structs, mod.enums, mod.impls);
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fn: FuncDecl = mod.funcs[i];
    let encl: string[] = hl_param_names(fn.params);
    encl = hl_append_str(encl, hl_collect_var_names(fn.body));
    let env: MEnv = me_env_from_params(fn.params);
    if (fn.receiver_name.len() > 0) {
      env = env.ebind(fn.receiver_name, fn.receiver_type);
    }
    let (r_stmts, r_hoisted, r_lifts) = hl_rewrite(fn.body, HlScope { names: encl, env: env, fns: fns }, hoisted);
    let h: i32 = hoisted.len();
    hoisted = r_hoisted;
    while (h < hoisted.len()) {
      hoisted = hoisted.with(h, FuncDecl { ...hoisted[h], module: fn.module });
      h = h + 1;
    }
    let fn_body: ast.Stmt[] = hl_apply_lifts(r_stmts, r_lifts);
    funcs = funcs.append(FuncDecl { ...fn, body: fn_body });
    i = i + 1;
  }
  let tencl: string[] = hl_collect_var_names(mod.top_stmts);
  let tenv: MEnv = MEnv { mnames: [], mtypes: [] };
  let (tr_stmts, tr_hoisted, tr_lifts) = hl_rewrite(mod.top_stmts, HlScope { names: tencl, env: tenv, fns: fns }, hoisted);
  hoisted = tr_hoisted;
  let top_body: ast.Stmt[] = hl_apply_lifts(tr_stmts, tr_lifts);
  let j: i32 = 0;
  while (j < hoisted.len()) {
    funcs = funcs.append(hoisted[j]);
    j = j + 1;
  }
  return Module { ...mod, funcs: funcs, top_stmts: top_body };
}

struct DeferHoist { stmts: ast.Stmt[], decls: ast.Stmt[] }

struct DeferHoistExpr { expr: ast.Expr, decls: ast.Stmt[] }

function dl_zeroable(t: string): boolean {
  return t.len() > 0 && !is_destr_marker(t);
}

function dl_zero_of(t: string): ast.Expr {
  return ast.ExprZero { type_name: t, line: 0, col: 0 };
}

function dl_add_name(own acc: string[], name: string): string[] {
  if (name.len() == 0 || util.has_str(acc, name)) {
    return acc;
  }
  return acc.append(name);
}

function dl_name_stmt(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtAssign(a) = st {
    return dl_add_name(acc, a.target);
  }
  return acc;
}

function dl_name_expr(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprIdent(id) = e {
    return dl_add_name(acc, id.name);
  }
  return acc;
}

function dl_name_descend(e: ast.Expr): boolean {
  return true;
}

function dl_action_names(actions: ast.Stmt[]): string[] {
  let acc: string[] = [];
  for a in actions {
    acc = astwalk.fold_stmt_nodes(a, acc, dl_name_stmt, dl_name_expr, dl_name_descend);
  }
  return acc;
}

function dl_hoist_stmts(stmts: ast.Stmt[], want: string[], nested: boolean): DeferHoist {
  let out: ast.Stmt[] = [];
  let decls: ast.Stmt[] = [];
  for st in stmts {
    let r: DeferHoist = dl_hoist_stmt(st, want, nested);
    out = util.append_all(out, r.stmts);
    decls = util.append_all(decls, r.decls);
  }
  return DeferHoist { stmts: out, decls: decls };
}

function dl_hoist_var(v: ast.StmtVar, want: string[], nested: boolean): DeferHoist {
  let ir: DeferHoistExpr = dl_hoist_expr(v.init, want);
  if (!nested || !util.has_str(want, v.name) || !dl_zeroable(v.type_name)) {
    let kept: ast.Stmt[] = [ast.StmtVar { ...v, init: ir.expr }];
    return DeferHoist { stmts: kept, decls: ir.decls };
  }
  let lifted: ast.Stmt[] = [s_var(v.name, v.type_name, dl_zero_of(v.type_name))];
  let one: ast.Stmt[] = [s_assign_at(v.name, ir.expr, v.line, v.col, v.line, v.col)];
  return DeferHoist { stmts: one, decls: util.append_all(lifted, ir.decls) };
}

function dl_hoist_stmt(st: ast.Stmt, want: string[], nested: boolean): DeferHoist {
  match (st) {
    ast.StmtVar(v) => {
      return dl_hoist_var(v, want, nested);
    },
    ast.StmtIf(f) => {
      let cr: DeferHoistExpr = dl_hoist_expr(f.cond, want);
      let tr: DeferHoist = dl_hoist_stmts(f.then_body, want, true);
      let er: DeferHoist = dl_hoist_stmts(f.else_body, want, true);
      let one: ast.Stmt[] = [s_if(cr.expr, tr.stmts, er.stmts)];
      return DeferHoist { stmts: one, decls: util.append_all(util.append_all(cr.decls, tr.decls), er.decls) };
    },
    ast.StmtWhile(w) => {
      let cw: DeferHoistExpr = dl_hoist_expr(w.cond, want);
      let br: DeferHoist = dl_hoist_stmts(w.body, want, true);
      let one: ast.Stmt[] = [dl_while(ast.StmtWhile { ...w, cond: cw.expr }, br.stmts)];
      return DeferHoist { stmts: one, decls: util.append_all(cw.decls, br.decls) };
    },
    ast.StmtFor(fr) => {
      let itr: DeferHoistExpr = dl_hoist_expr(fr.iter, want);
      let br: DeferHoist = dl_hoist_stmts(fr.body, want, true);
      let one: ast.Stmt[] = [dl_for(ast.StmtFor { ...fr, iter: itr.expr }, br.stmts)];
      return DeferHoist { stmts: one, decls: util.append_all(itr.decls, br.decls) };
    },
    ast.StmtMatch(m) => {
      return dl_hoist_match(m, want);
    },
    ast.StmtReturn(r) => {
      let vr: DeferHoistExpr = dl_hoist_expr(r.value, want);
      let one: ast.Stmt[] = [ast.StmtReturn { ...r, value: vr.expr }];
      return DeferHoist { stmts: one, decls: vr.decls };
    },
    ast.StmtExpr(x) => {
      let xr: DeferHoistExpr = dl_hoist_expr(x.value, want);
      let one: ast.Stmt[] = [ast.StmtExpr { ...x, value: xr.expr }];
      return DeferHoist { stmts: one, decls: xr.decls };
    },
    ast.StmtAssign(a) => {
      let ar: DeferHoistExpr = dl_hoist_expr(a.value, want);
      let one: ast.Stmt[] = [ast.StmtAssign { ...a, value: ar.expr }];
      return DeferHoist { stmts: one, decls: ar.decls };
    },
    ast.StmtBreak(_) => {},
    ast.StmtContinue(_) => {},
    ast.StmtUnknown(_) => {},
    ast.StmtDefer(_) => {}
  }
  let same: ast.Stmt[] = [st];
  let none: ast.Stmt[] = [];
  return DeferHoist { stmts: same, decls: none };
}

function dl_hoist_match(m: ast.StmtMatch, want: string[]): DeferHoist {
  let sr: DeferHoistExpr = dl_hoist_expr(m.scrutinee, want);
  let decls: ast.Stmt[] = sr.decls;
  let arms: ast.MatchArm[] = [];
  for a in m.arms {
    let gr: DeferHoistExpr = dl_hoist_expr(a.guard, want);
    let ar: DeferHoist = dl_hoist_stmts(a.body, want, true);
    arms = arms.append(ast.MatchArm { ...a, guard: gr.expr, body: ar.stmts });
    decls = util.append_all(util.append_all(decls, gr.decls), ar.decls);
  }
  let one: ast.Stmt[] = [s_match(sr.expr, arms)];
  return DeferHoist { stmts: one, decls: decls };
}

function dl_hoist_expr(e: ast.Expr, want: string[]): DeferHoistExpr {
  if let ast.ExprCall(c) = e {
    if (is_value_block(c)) {
      if let ast.ExprLambda(l) = c.callee {
        let vb: DeferHoist = dl_hoist_stmts(l.body, want, true);
        return DeferHoistExpr { expr: dl_vb_rebuild(c, vb.stmts), decls: vb.decls };
      }
    }
  }
  let kids: ast.Expr[] = dl_expr_kids(e);
  let none: ast.Stmt[] = [];
  if (kids.len() == 0) {
    return DeferHoistExpr { expr: e, decls: none };
  }
  let out: ast.Expr[] = [];
  let decls: ast.Stmt[] = none;
  for k in kids {
    let r: DeferHoistExpr = dl_hoist_expr(k, want);
    out = out.append(r.expr);
    decls = util.append_all(decls, r.decls);
  }
  return DeferHoistExpr { expr: dl_expr_with_kids(e, out), decls: decls };
}

function dl_defret_decl(ret: string, fn_ret: string, fn_param_types: string): ast.Stmt {
  if (!dl_zeroable(ret)) {
    return s_var("__defret", "", e_number("0", "", false));
  }
  return ast.StmtVar { name: "__defret", type_name: ret, init: dl_zero_of(ret), line: 0, col: 0, fn_ret: fn_ret, fn_param_types: fn_param_types };
}

function dl_param_names(params: ast.ParamDecl[]): string[] {
  let out: string[] = [];
  for p in params {
    out = out.append(p.name);
  }
  return out;
}

function dl_count_str(xs: string[], name: string): i32 {
  let n: i32 = 0;
  for x in xs {
    if (x == name) {
      n = n + 1;
    }
  }
  return n;
}

function dl_name_keep(e: ast.Expr, own acc: string[]): string[] {
  return acc;
}

function dl_hoistable(want: string[], src: ast.Stmt[], params: string[]): string[] {
  let bound: string[] = [];
  for p in params {
    bound = astwalk.append_bound_name(bound, p);
  }
  for st in src {
    bound = astwalk.fold_stmt_nodes(st, bound, astwalk.binders_of, dl_name_keep, dl_name_descend);
  }
  let out: string[] = [];
  for w in want {
    if (dl_count_str(bound, w) < 2) {
      out = out.append(w);
    }
  }
  return out;
}

function dl_hoist_scope(src: ast.Stmt[], params: string[]): ast.Stmt[] {
  let empty: ast.Stmt[] = [];
  let emptyf: i32[] = [];
  let probe: DeferAcc = dl_collect_stmts(src, empty, emptyf);
  if (probe.actions.len() == 0) {
    return src;
  }
  let want: string[] = dl_hoistable(dl_action_names(probe.actions), src, params);
  if (want.len() == 0) {
    return src;
  }
  let h: DeferHoist = dl_hoist_stmts(src, want, false);
  if (h.decls.len() == 0) {
    return src;
  }
  return util.append_all(h.decls, h.stmts);
}

pub function lower_defers_func(fn: FuncDecl): FuncDecl {
  if (!dl_stmts_have_defer_deep(fn.body)) {
    return fn;
  }
  let pnames: string[] = [];
  for p in fn.params {
    pnames = pnames.append(p.name);
  }
  if (fn.receiver_name.len() > 0) {
    pnames = pnames.append(fn.receiver_name);
  }
  return FuncDecl { ...fn, body: lower_defers_body(fn.body, pnames, fn.ret_type, fn.ret_fn_ret, fn.ret_fn_param_types) };
}

function lower_defers_body(body0: ast.Stmt[], params: string[], ret: string, fn_ret: string, fn_param_types: string): ast.Stmt[] {
  let src: ast.Stmt[] = dl_lower_lambda_bodies(body0);
  if (!dl_stmts_have_defer(src)) {
    return src;
  }
  src = dl_hoist_scope(src, params);
  let empty: ast.Stmt[] = [];
  let emptyf: i32[] = [];
  let cr: DeferAcc = dl_collect_stmts(src, empty, emptyf);
  if (cr.actions.len() == 0) {
    return src;
  }
  let cleanup: ast.Stmt[] = dl_cleanup_kind(cr.actions, cr.flags, 0, cr.actions.len());
  let cleanup_err: ast.Stmt[] = dl_cleanup_kind(cr.actions, cr.flags, 1, cr.actions.len());
  let expanded: ast.Stmt[] = dl_expand_returns(cr.stmts, cr.actions, cr.flags, 0);
  let body: ast.Stmt[] = [];
  if (ret != "void") {
    body = body.append(dl_defret_decl(ret, fn_ret, fn_param_types));
  }
  let i: i32 = 0;
  while (i < cr.actions.len()) {
    body = body.append(s_var("__dfa" + dl_itoa(i), "boolean", e_bool(false)));
    i = i + 1;
  }
  body = body.append(s_var(DFA_TRYALL, "boolean", e_bool(false)));
  body = body.append(s_var(DFA_TRYERR, "boolean", e_bool(false)));
  let k: i32 = 0;
  while (k < expanded.len()) {
    body = body.append(expanded[k]);
    k = k + 1;
  }
  let c: i32 = 0;
  while (c < cleanup.len()) {
    body = body.append(cleanup[c]);
    c = c + 1;
  }
  let noelse: ast.Stmt[] = [];
  body = body.append(s_if(e_ident(DFA_TRYALL), cleanup, noelse));
  body = body.append(s_if(e_ident(DFA_TRYERR), cleanup_err, noelse));
  return body;
}

function dl_lower_lambda_bodies(stmts: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(dl_ll_stmt(stmts[i]));
    i = i + 1;
  }
  return out;
}

function dl_ll_stmt(st: ast.Stmt): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { ...v, init: dl_ll_expr(v.init) };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: dl_ll_expr(r.value) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: dl_ll_expr(x.value) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: dl_ll_expr(a.value) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: dl_ll_expr(f.cond), then_body: dl_lower_lambda_bodies(f.then_body), else_body: dl_lower_lambda_bodies(f.else_body) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, cond: dl_ll_expr(w.cond), body: dl_lower_lambda_bodies(w.body) };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { ...fo, iter: dl_ll_expr(fo.iter), body: dl_lower_lambda_bodies(fo.body) };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let g: ast.Expr = m.arms[i].guard;
        if (m.arms[i].has_guard) {
          g = dl_ll_expr(m.arms[i].guard);
        }
        arms = arms.append(ast.MatchArm { ...m.arms[i], body: dl_lower_lambda_bodies(m.arms[i].body), guard: g });
        i = i + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: dl_ll_expr(m.scrutinee), arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: dl_ll_stmt(d.action) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function dl_ll_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, body: lower_defers_body(lm.body, dl_param_names(lm.params), lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types) };
    },
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        return dl_vb_rebuild(c, dl_lower_lambda_bodies(vb_body(c)));
      }
      if (dl_is_source_iife(c)) {
        match (c.callee) {
          ast.ExprLambda(lm) => {
            if (dl_stmts_have_defer(lm.body)) {
              let scoped: ast.Expr = ast.ExprLambda { ...lm, origin: ORIGIN_IIFE_SCOPED, body: lower_defers_body(lm.body, dl_param_names(lm.params), lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types) };
              return ast.ExprCall { ...c, callee: scoped };
            }
          },
          _ => {}
        }
      }
      return dl_ll_expr_kids(e);
    },
    _ => {
      return dl_ll_expr_kids(e);
    }
  }
  return e;
}

function dl_is_source_iife(c: ast.ExprCall): boolean {
  if (c.args.len() != 0) {
    return false;
  }
  match (c.callee) {
    ast.ExprLambda(lm) => {
      if (lm.params.len() != 0) {
        return false;
      }
      return !is_value_block_origin(lm.origin);
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function vb_body(c: ast.ExprCall): ast.Stmt[] {
  match (c.callee) {
    ast.ExprLambda(l) => {
      return l.body;
    },
    _ => {
      let none: ast.Stmt[] = [];
      return none;
    }
  }
  let none2: ast.Stmt[] = [];
  return none2;
}

function dl_ll_expr_kids(e: ast.Expr): ast.Expr {
  return map_expr_kids(e, dl_ll_expr);
}

pub function lower_defers_module(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    funcs = funcs.append(lower_defers_func(mod.funcs[i]));
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs };
}

function resource_drop_fn_name(res: string): string {
  return "__resource_drop_" + res;
}

function handle_resource_of(type_name: string, resources: ResourceDecl[]): string {
  if (type_name.len() >= 4 && slice_unchecked(type_name, 0, 4) == "own ") {
    return slice_unchecked(type_name, 4, type_name.len()) + "";
  }
  for rd in resources {
    if (rd.name == type_name) {
      return type_name;
    }
  }
  return "";
}

pub function is_reserved_enum_name(name: string): boolean {
  return name == "Option" || name == "Result" || name == "IoError" || name == "Body";
}

pub function reserved_enum_tparams(name: string): string[] {
  if (name == "Option") {
    return ["T"];
  }
  if (name == "Result") {
    return ["T", "E"];
  }
  let none: string[] = [];
  return none;
}

pub function is_reserved_struct_name(name: string): boolean {
  if (name.len() == 0 || name[0] < b'A' || name[0] > b'Z') {
    return false;
  }
  let reserved: string[] = [
    "BodySource", "BytesWriter", "Cell", "ChunkProducer", "Date", "DateTime", "Dir", "DirEntry", "Duration", "FileStat",
    "FsStat", "HeaderMap", "HttpRequest", "HttpResponse", "Instant", "Map",
    "MapIter", "MountEntry", "Pipe", "ProcessResult",
    "Reader", "Span", "Stream", "Time", "TimeZone", "Url", "WinSize", "Writer",
    "Zoned",
  ];
  return util.index_of_str(reserved, name) >= 0;
}

pub function reserved_struct_tparams(name: string): string[] {
  if (name == "Cell") {
    return ["T"];
  }
  if (name == "Map") {
    return ["K", "V"];
  }
  if (name == "MapIter") {
    return ["K", "V"];
  }
  let none: string[] = [];
  return none;
}

function user_struct_tparams(mod: Module, name: string): (boolean, string[]) {
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return (true, sd.type_params);
    }
  }
  let none: string[] = [];
  return (false, none);
}

pub function union_alias_errors(mod: Module, al: TypeAlias): string[] {
  let out: string[] = [];
  let (named_struct, _) = user_struct_tparams(mod, al.name);
  if (named_struct || is_reserved_struct_name(al.name)) {
    return out.append("union \"" + al.name + "\" collides with a struct of the same name");
  }
  let seen: string[] = [];
  let mi: i32 = 0;
  while (mi < al.variants.len()) {
    let m: string = al.variants[mi];
    let given: i32 = alias_member_arity(al, mi);
    mi = mi + 1;
    if (util.has_str(seen, m)) {
      out = out.append("duplicate member \"" + m + "\" in union " + al.name);
      continue;
    }
    seen = seen.append(m);
    let (found, tps) = user_struct_tparams(mod, m);
    if (!found && is_reserved_struct_name(m)) {
      found = true;
      tps = reserved_struct_tparams(m);
    }
    if (!found) {
      out = out.append("union " + al.name + " member \"" + m + "\" does not name a struct in scope");
    } else if (tps.len() == 0 && given > 0) {
      out = out.append("union " + al.name + " member \"" + m + "\" is not generic but was given " + util.i32_to_string(given) + " type argument(s)");
    } else if (tps.len() != given) {
      let params: string = "";
      for tp in tps {
        if (params.len() > 0) {
          params = params + ", ";
        }
        params = params + tp;
      }
      out = out.append("union " + al.name + " member \"" + m + "\" takes " + util.i32_to_string(tps.len()) + " type argument(s), got " + util.i32_to_string(given) + "; a generic struct member needs them supplied (e.g. `type " + al.name + "[" + params + "] = " + m + "[" + params + "] | …`)");
    }
  }
  return out;
}

function alias_member_arity(al: TypeAlias, i: i32): i32 {
  if (i >= al.variant_args.len() || al.variant_args[i].len() == 0) {
    return 0;
  }
  return split_top_commas(al.variant_args[i]).len();
}

pub function desugar_union_aliases(mod: Module): Module {
  let aliases: TypeAlias[] = [];
  let enums: EnumDecl[] = mod.enums;
  let structs: StructDecl[] = mod.structs;
  let i: i32 = 0;
  while (i < mod.aliases.len()) {
    let al: TypeAlias = mod.aliases[i];
    if (!alias_spells_args(al) || !alias_registers(mod, i)) {
      aliases = aliases.append(al);
      i = i + 1;
      continue;
    }
    let vi: i32 = 0;
    while (vi < al.variants.len()) {
      let member: string = al.variants[vi];
      let payload: string = member;
      if (vi < al.variant_args.len() && al.variant_args[vi].len() > 0) {
        payload = member + "[" + al.variant_args[vi] + "]";
      }
      structs = structs.append(StructDecl { name: member, fields: [StructFieldDecl { name: "__ev", type_name: payload, fn_ret: "", fn_param_types: "" }], type_params: [], derives: [], line: 0, col: 0, enum_owner: al.name, must_consume: false, variant_field_names: [], is_pub: true, is_package: false, opaque: false, module: "" });
      vi = vi + 1;
    }
    enums = enums.append(EnumDecl { name: al.name, variant_names: al.variants, type_params: al.type_params, line: al.line, col: al.col, must_consume: false, try_marker: false, is_pub: al.is_pub, is_package: al.is_package, module: al.module, instance: "", visible_from: [] });
    i = i + 1;
  }
  return Module { ...mod, aliases: aliases, structs: structs, enums: enums };
}

function alias_spells_args(al: TypeAlias): boolean {
  if (al.type_params.len() > 0) {
    return true;
  }
  for a in al.variant_args {
    if (a.len() > 0) {
      return true;
    }
  }
  return false;
}

pub function alias_redeclares_enum(mod: Module, idx: i32): boolean {
  let al: TypeAlias = mod.aliases[idx];
  if (union_alias_errors(mod, al).len() > 0) {
    return false;
  }
  if (is_reserved_enum_name(al.name)) {
    return true;
  }
  for ed in mod.enums {
    if (ed.name == al.name) {
      return true;
    }
  }
  let j: i32 = 0;
  while (j < idx) {
    if (mod.aliases[j].name == al.name && alias_registers(mod, j)) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

pub function alias_registers(mod: Module, idx: i32): boolean {
  return union_alias_errors(mod, mod.aliases[idx]).len() == 0 && !alias_redeclares_enum(mod, idx);
}

pub function resource_collision(mod: Module, idx: i32): string {
  let name: string = mod.resources[idx].name;
  let j: i32 = 0;
  while (j < idx) {
    if (mod.resources[j].name == name) {
      return "resource";
    }
    j = j + 1;
  }
  if (is_reserved_struct_name(name)) {
    return "struct";
  }
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return "struct";
    }
  }
  if (is_reserved_enum_name(name)) {
    return "enum";
  }
  for ed in mod.enums {
    if (ed.name == name) {
      return "enum";
    }
  }
  let ai: i32 = 0;
  while (ai < mod.aliases.len()) {
    if (mod.aliases[ai].name == name && alias_registers(mod, ai)) {
      return "enum";
    }
    ai = ai + 1;
  }
  return "";
}

pub function registered_resources(mod: Module): ResourceDecl[] {
  let out: ResourceDecl[] = [];
  let i: i32 = 0;
  while (i < mod.resources.len()) {
    if (resource_collision(mod, i).len() == 0) {
      out = out.append(mod.resources[i]);
    }
    i = i + 1;
  }
  return out;
}

function resource_binding_iface(resources: ResourceDecl[], name: string): string {
  let i: i32 = 0;
  while (i < resources.len()) {
    if (resources[i].name == name) {
      return resources[i].iface;
    }
    i = i + 1;
  }
  return "";
}

function resource_binding_wit(resources: ResourceDecl[], name: string): string {
  let i: i32 = 0;
  while (i < resources.len()) {
    if (resources[i].name == name) {
      return resources[i].wit;
    }
    i = i + 1;
  }
  return "";
}

function callee_param_is_borrow(funcs: FuncDecl[], fname: string, pos: i32): boolean {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == fname) {
      if (pos < funcs[i].params.len()) {
        let tn: string = funcs[i].params[pos].type_name;
        return tn.len() >= 7 && slice_unchecked(tn, 0, 7) == "borrow ";
      }
      return false;
    }
    i = i + 1;
  }
  return false;
}

function moves_net_of(e: ast.Expr, funcs: FuncDecl[], name: string, acc: i32): i32 {
  match (e) {
    ast.ExprIdent(id) => {
      if (id.name == name) {
        return acc + 1;
      }
      return acc;
    },
    ast.ExprCall(c) => {
      let cname: string = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          cname = cid.name;
        },
        _ => {}
      }
      if (cname.len() == 0) {
        return acc;
      }
      let i: i32 = 0;
      while (i < c.args.len()) {
        match (c.args[i]) {
          ast.ExprIdent(aid) => {
            if (aid.name == name && callee_param_is_borrow(funcs, cname, i)) {
              acc = acc - 1;
            }
          },
          _ => {}
        }
        i = i + 1;
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function moves_target_of(st: ast.Stmt, name: string, acc: i32): i32 {
  match (st) {
    ast.StmtAssign(a) => {
      if (a.target == name) {
        return acc + 1;
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function stmts_move_handle(stmts: ast.Stmt[], funcs: FuncDecl[], name: string): boolean {
  function ve(e: ast.Expr, own acc: i32): i32 {
    return moves_net_of(e, funcs, name, acc);
  }
  function vs(st: ast.Stmt, own acc: i32): i32 {
    return moves_target_of(st, name, acc);
  }
  let net: i32 = 0;
  for st in stmts {
    net = astwalk.fold_stmt_nodes(st, net, vs, ve, astwalk.descend_all);
  }
  return net > 0;
}

function kept_handle_res(v: ast.StmtVar, body: ast.Stmt[], resources: ResourceDecl[], funcs: FuncDecl[]): string {
  let res: string = handle_resource_of(v.type_name, resources);
  if (res.len() == 0) {
    return "";
  }
  if (resource_binding_iface(resources, res).len() == 0) {
    return "";
  }
  if (stmts_move_handle(body, funcs, v.name)) {
    return "";
  }
  return res;
}

function insert_drop_defers(stmts: ast.Stmt[], body: ast.Stmt[], resources: ResourceDecl[], funcs: FuncDecl[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    let s: ast.Stmt = stmts[i];
    let ns: ast.Stmt = s;
    match (s) {
      ast.StmtIf(f) => {
        ns = ast.StmtIf { ...f, then_body: insert_drop_defers(f.then_body, body, resources, funcs), else_body: insert_drop_defers(f.else_body, body, resources, funcs) };
      },
      ast.StmtWhile(w) => {
        ns = ast.StmtWhile { ...w, body: insert_drop_defers(w.body, body, resources, funcs) };
      },
      ast.StmtFor(fr) => {
        ns = ast.StmtFor { ...fr, body: insert_drop_defers(fr.body, body, resources, funcs) };
      },
      ast.StmtMatch(m) => {
        let arms: ast.MatchArm[] = [];
        let k: i32 = 0;
        while (k < m.arms.len()) {
          arms = arms.append(ast.MatchArm { ...m.arms[k], body: insert_drop_defers(m.arms[k].body, body, resources, funcs) });
          k = k + 1;
        }
        ns = ast.StmtMatch { ...m, arms: arms };
      },
      _ => {}
    }
    out = out.append(ns);
    match (s) {
      ast.StmtVar(v) => {
        let res: string = kept_handle_res(v, body, resources, funcs);
        if (res.len() > 0) {
          out = out.append(s_defer(s_expr(e_call(e_ident(resource_drop_fn_name(res)), [e_ident(v.name)]))));
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

function collect_dropped_resources(stmts: ast.Stmt[], body: ast.Stmt[], resources: ResourceDecl[], funcs: FuncDecl[], res_acc: string[]): string[] {
  let res_out: string[] = res_acc;
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtVar(v) => {
        let res: string = kept_handle_res(v, body, resources, funcs);
        if (res.len() > 0 && !util.has_str(res_out, res)) {
          res_out = res_out.append(res);
        }
      },
      ast.StmtIf(f) => {
        res_out = collect_dropped_resources(f.then_body, body, resources, funcs, res_out);
        res_out = collect_dropped_resources(f.else_body, body, resources, funcs, res_out);
      },
      ast.StmtWhile(w) => {
        res_out = collect_dropped_resources(w.body, body, resources, funcs, res_out);
      },
      ast.StmtFor(fr) => {
        res_out = collect_dropped_resources(fr.body, body, resources, funcs, res_out);
      },
      ast.StmtMatch(m) => {
        let k: i32 = 0;
        while (k < m.arms.len()) {
          res_out = collect_dropped_resources(m.arms[k].body, body, resources, funcs, res_out);
          k = k + 1;
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return res_out;
}

pub function lower_defers_prepass_module(mod: Module): Module {
  let funcs: FuncDecl[] = mod.funcs;
  let pass: i32 = 0;
  while (pass < 3) {
    let pi: i32 = 0;
    while (pi < funcs.len()) {
      let pfd: FuncDecl = funcs[pi];
      if (pfd.ret_type == "" && pfd.body.len() > 0 && pfd.receiver_type.len() == 0 && pfd.all_type_params.len() == 0) {
        let inferred: string = irt_infer_func(pfd, funcs, mod.structs);
        if (inferred != "") {
          funcs = irt_set_ret(funcs, pi, inferred);
        }
      }
      pi = pi + 1;
    }
    pass = pass + 1;
  }
  let resources: ResourceDecl[] = registered_resources(mod);
  let has_res: boolean = resources.len() > 0;
  let out_funcs: FuncDecl[] = [];
  let needed: string[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let f: FuncDecl = funcs[i];
    if (!has_res || f.import_iface.len() > 0) {
      out_funcs = out_funcs.append(f);
      i = i + 1;
      continue;
    }
    needed = collect_dropped_resources(f.body, f.body, resources, funcs, needed);
    let nbody: ast.Stmt[] = insert_drop_defers(f.body, f.body, resources, funcs);
    out_funcs = out_funcs.append(FuncDecl { ...f, body: nbody });
    i = i + 1;
  }
  let no_tp: string[] = [];
  let no_body: ast.Stmt[] = [];
  let k: i32 = 0;
  while (k < needed.len()) {
    let rn: string = needed[k];
    let iface2: string = resource_binding_iface(resources, rn);
    let wit2: string = resource_binding_wit(resources, rn);
    let hp: ast.ParamDecl[] = [ast.ParamDecl { name: "h", type_name: "own " + rn, own: true, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
    out_funcs = out_funcs.append(lower_defers_func(FuncDecl {
      stdlib: "", no_inline: false,
      name: resource_drop_fn_name(rn), receiver_name: "", receiver_type: "", receiver_own: false,
      type_params: no_tp, params: hp, ret_type: "void", body: no_body,
      line: 0, col: 0, import_iface: iface2, import_wit: "[resource-drop]" + wit2, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
      is_pub: true,
      is_const: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [],
    }));
    k = k + 1;
  }
  return Module { ...mod, funcs: out_funcs };
}

function iter_range_args(iter: ast.Expr): ast.Expr[] {
  if (range_call_name(iter) == "") {
    return [];
  }
  if let ast.ExprCall(c) = iter {
    return c.args;
  }
  return [];
}

function range_call_name(iter: ast.Expr): string {
  if let ast.ExprCall(c) = iter {
    if (c.args.len() != 2) {
      return "";
    }
    if let ast.ExprIdent(id) = c.callee {
      if (id.name == "__range" || id.name == "__range_incl") {
        return id.name;
      }
    }
  }
  return "";
}

function range_bound_type(bounds: ast.Expr[]): string {
  for bound in bounds {
    let t: string = literal_suffix_of(bound);
    if (t.len() > 0) {
      return t;
    }
  }
  return "i32";
}

function literal_suffix_of(e: ast.Expr): string {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float || n.suffix == "char") {
        return "";
      }
      return n.suffix;
    },
    ast.ExprUnary(u) => {
      if (u.op == "-" || u.op == "+") {
        return literal_suffix_of(u.operand);
      }
      return "";
    },
    ast.ExprBinary(b) => {
      if (b.op != "+" && b.op != "-" && b.op != "*" && b.op != "/" && b.op != "%") {
        return "";
      }
      let l: string = literal_suffix_of(b.left);
      if (l.len() > 0) {
        return l;
      }
      return literal_suffix_of(b.right);
    },
    _ => {
      return "";
    }
  }
  return "";
}

function inclusive_range_loop(fr: ast.StmtFor, dbody: ast.Stmt[], ivar: ast.Stmt, hivar: ast.Stmt, hi_name: string): ast.Stmt[] {
  let v: string = fr.var_name;
  let go_name: string = "$go_" + v;
  let one: ast.Expr = e_number("1", "", false);
  let govar: ast.Stmt = s_var(go_name, "boolean", e_binary("<=", e_ident(v), e_ident(hi_name)));
  let back: ast.Stmt = s_assign(v, e_binary("-", e_ident(v), one));
  let incr: ast.Stmt = s_assign(v, e_binary("+", e_ident(v), one));
  let last: ast.Stmt = s_assign(go_name, e_binary("!=", e_ident(v), e_ident(hi_name)));
  let wbody: ast.Stmt[] = [incr, last];
  for st in dbody {
    wbody = wbody.append(st);
  }
  return [ivar, hivar, govar, back, with_loop_label(s_while(e_ident(go_name), wbody), fr.label)];
}

function dr_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, body: desugar_ranges_block(lm.body) };
    },
    _ => {
      return dr_expr_kids(e);
    }
  }
  return e;
}

function dr_expr_kids(e: ast.Expr): ast.Expr {
  return map_expr_kids(e, dr_expr);
}

pub function desugar_ranges_block(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < body.len()) {
    let r: ast.Stmt[] = desugar_ranges_one(body[i]);
    let j: i32 = 0;
    while (j < r.len()) {
      out = out.append(r[j]);
      j = j + 1;
    }
    i = i + 1;
  }
  return out;
}

function desugar_ranges_one(st: ast.Stmt): ast.Stmt[] {
  match (st) {
    ast.StmtFor(fr) => {
      let dbody: ast.Stmt[] = desugar_ranges_block(fr.body);
      let rargs: ast.Expr[] = iter_range_args(fr.iter);
      if (rargs.len() == 2) {
        let hi_name: string = "$hi_" + fr.var_name;
        let rty: string = range_bound_type(rargs);
        let hivar: ast.Stmt = s_var(hi_name, rty, rargs[1]);
        if (range_call_name(fr.iter) == "__range_incl") {
          return inclusive_range_loop(fr, dbody, s_var(fr.var_name, rty, rargs[0]), hivar, hi_name);
        }
        let ivar: ast.Stmt = s_var(fr.var_name, rty, e_binary("-", rargs[0], e_number("1", "", false)));
        let incr: ast.Stmt = s_assign(fr.var_name, e_binary("+", e_ident(fr.var_name), e_number("1", "", false)));
        let brk: ast.Stmt = s_if(e_binary(">=", e_ident(fr.var_name), e_ident(hi_name)), [s_break()], []);
        let wbody: ast.Stmt[] = [incr, brk];
        let k: i32 = 0;
        while (k < dbody.len()) {
          wbody = wbody.append(dbody[k]);
          k = k + 1;
        }
        return [ivar, hivar, with_loop_label(s_while(e_bool(true), wbody), fr.label)];
      }
      return [ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: dbody, label: fr.label, line: fr.line, col: fr.col }];
    },
    ast.StmtIf(f) => {
      return [ast.StmtIf { ...f, cond: f.cond, then_body: desugar_ranges_block(f.then_body), else_body: desugar_ranges_block(f.else_body) }];
    },
    ast.StmtWhile(w) => {
      return [ast.StmtWhile { cond: w.cond, body: desugar_ranges_block(w.body), label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo }];
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let a: i32 = 0;
      while (a < m.arms.len()) {
        arms = arms.append(ast.MatchArm { pattern: m.arms[a].pattern, body: desugar_ranges_block(m.arms[a].body), line: m.arms[a].line, col: m.arms[a].col, guard: m.arms[a].guard, has_guard: m.arms[a].has_guard, alt_cont: false });
        a = a + 1;
      }
      return [ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: arms }];
    },
    ast.StmtDefer(d) => {
      return [ast.StmtDefer { action: desugar_ranges_one(d.action)[0], on_error: d.on_error, line: d.line }];
    },
    ast.StmtVar(v) => {
      return [ast.StmtVar { ...v, init: dr_expr(v.init) }];
    },
    ast.StmtReturn(r2) => {
      return [ast.StmtReturn { ...r2, value: dr_expr(r2.value) }];
    },
    ast.StmtExpr(x) => {
      return [ast.StmtExpr { ...x, value: dr_expr(x.value) }];
    },
    ast.StmtAssign(a) => {
      return [ast.StmtAssign { ...a, value: dr_expr(a.value) }];
    },
    _ => {
      return [st];
    }
  }
  return [st];
}

pub function desugar_ranges_func(fd: FuncDecl): FuncDecl {
  return FuncDecl { ...fd, body: desugar_ranges_body(fd.body) };
}

function desugar_ranges_body(body: ast.Stmt[]): ast.Stmt[] {
  if (!has_range_for(body)) {
    return body;
  }
  return desugar_ranges_block(body);
}

function has_range_for(stmts: ast.Stmt[]): boolean {
  let found: boolean = false;
  for st in stmts {
    found = astwalk.fold_stmt_nodes(st, found, range_for_at, keep_flag, astwalk.descend_all);
  }
  return found;
}

function range_for_at(st: ast.Stmt, own acc: boolean): boolean {
  if let ast.StmtFor(fr) = st {
    return acc || range_call_name(fr.iter) != "";
  }
  return acc;
}

pub function iterator_loop(fr: ast.StmtFor, subject: ast.Expr, col: i32): ast.Stmt {
  let at: string = util.i32_to_string(fr.line) + "_" + util.i32_to_string(col);
  let it: string = "$it_" + at;
  let step: string = "$at_" + at;
  let body: ast.Stmt[] = [s_assign(it, e_field_access(e_ident(step), "1"))];
  if (fr.var_name != "_") {
    body = body.append(s_var(fr.var_name, "", e_field_access(e_ident(step), "0")));
  }
  for st in fr.body {
    body = body.append(st);
  }
  let arms: ast.MatchArm[] = [
    ast.MatchArm { pattern: p_variant("Some", step), body: body, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false },
    ast.MatchArm { pattern: p_variant("None", ""), body: [s_break()], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false },
  ];
  let pull: ast.Stmt = s_match(e_call(e_field_access(e_ident(it), "next"), []), arms);
  let walk: ast.Stmt = ast.StmtWhile { cond: e_bool(true), body: [pull], label: fr.label, line: fr.line, is_loop: false, todo: false };
  return s_block([s_var(it, "", subject), walk]);
}

pub function desugar_ranges_module(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    funcs = funcs.append(desugar_ranges_func(mod.funcs[i]));
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs, top_stmts: desugar_ranges_block(mod.top_stmts) };
}

function variant_field_names_of(structs: StructDecl[], name: string): string[] {
  let bare: string = name;
  let c: i32 = 0;
  while (c < name.len()) {
    if (name[c] == b'.') {
      bare = slice_unchecked(name, c + 1, name.len()) + "";
    }
    c = c + 1;
  }
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == name || structs[i].name == bare) {
      if (structs[i].variant_field_names.len() > 0) {
        return structs[i].variant_field_names;
      }
    }
    i = i + 1;
  }
  let empty: string[] = [];
  return empty;
}

pub function is_record_pattern(pv: ast.PatVariant): boolean {
  return pv.field_names.len() > 0 || pv.rest_written;
}

pub function record_pattern_settles(decl_names: string[], pv: ast.PatVariant): boolean {
  if (decl_names.len() == 0) {
    return false;
  }
  let named: i32 = 0;
  for decl in decl_names {
    let hits: i32 = 0;
    for f in pv.field_names {
      if (f == decl) {
        hits = hits + 1;
      }
    }
    if (hits > 1) {
      return false;
    }
    named = named + hits;
  }
  return named == pv.field_names.len() && (pv.rest_written || named == decl_names.len());
}

pub function rebind_record_positional(pv: ast.PatVariant, decl_names: string[]): ast.PatVariant {
  let slots: string[] = [];
  let nested: ast.Pattern[] = [];
  for decl in decl_names {
    let q: i32 = util.index_of_str(pv.field_names, decl);
    let slot: string = "_";
    let sub: ast.Pattern = p_wildcard();
    if (q >= 0) {
      slot = payload_binder(pv, q);
      if (q < pv.nested.len()) {
        sub = pv.nested[q];
      }
    }
    slots = slots.append(slot);
    nested = nested.append(sub);
  }
  if (pv.nested.len() == 0) {
    nested = [];
  }
  let (binding, extra) = split_payload_slots(slots);
  let no_names: string[] = [];
  return ast.PatVariant { ...pv, binding: binding, extra_bindings: extra, nested: nested, field_names: no_names, rest_written: false };
}

pub function resolve_record_pattern(pv: ast.PatVariant, decl_names: string[]): ast.PatVariant {
  if (!is_record_pattern(pv) || !record_pattern_settles(decl_names, pv)) {
    return pv;
  }
  return rebind_record_positional(pv, decl_names);
}

function rvf_pattern(pat: ast.Pattern, structs: StructDecl[]): ast.Pattern {
  match (pat) {
    ast.PatVariant(pv) => {
      let np: ast.PatVariant = resolve_record_pattern(pv, variant_field_names_of(structs, pv.type_name));
      return ast.PatVariant { ...np, nested: rvf_patterns(np.nested, structs), tup_pats: rvf_patterns(np.tup_pats, structs) };
    },
    _ => {
      return pat;
    }
  }
  return pat;
}

function rvf_patterns(pats: ast.Pattern[], structs: StructDecl[]): ast.Pattern[] {
  let out: ast.Pattern[] = [];
  for pat in pats {
    out = out.append(rvf_pattern(pat, structs));
  }
  return out;
}

function rvf_sugar(sg: ast.MatchSugar, structs: StructDecl[]): ast.MatchSugar {
  let arms: ast.MatchArm[] = [];
  for a in sg.arms {
    arms = arms.append(ast.MatchArm { ...a, pattern: rvf_pattern(a.pattern, structs) });
  }
  let tup: ast.TupArm[] = [];
  for t in sg.tup {
    tup = tup.append(ast.TupArm { ...t, elem_pats: rvf_patterns(t.elem_pats, structs) });
  }
  let strct: ast.StructArm[] = [];
  for st in sg.strct {
    strct = strct.append(ast.StructArm { ...st, field_pats: rvf_patterns(st.field_pats, structs) });
  }
  return ast.MatchSugar { ...sg, arms: arms, tup: tup, strct: strct };
}

function rvf_expr(e: ast.Expr, structs: StructDecl[]): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: rvf_expr(b.left, structs), right: rvf_expr(b.right, structs), line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: rvf_expr(u.operand, structs), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < c.args.len()) {
        args = args.append(rvf_expr(c.args[i], structs));
        i = i + 1;
      }
      return ast.ExprCall { callee: rvf_expr(c.callee, structs), args: args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      let j: i32 = 0;
      while (j < a.elements.len()) {
        els = els.append(rvf_expr(a.elements[j], structs));
        j = j + 1;
      }
      return ast.ExprArray { ...a, elements: els };
    },
    ast.ExprTuple(t) => {
      let tels: ast.Expr[] = [];
      let k: i32 = 0;
      while (k < t.elements.len()) {
        tels = tels.append(rvf_expr(t.elements[k], structs));
        k = k + 1;
      }
      return ast.ExprTuple { elements: tels, line: t.line, col: t.col };
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex { array: rvf_expr(x.array, structs), index: rvf_expr(x.index, structs), unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: rvf_expr(sl.array, structs), start: rvf_expr(sl.start, structs), end: rvf_expr(sl.end, structs) };
    },
    ast.ExprStructLit(st) => {
      let vals: ast.Expr[] = [];
      let v: i32 = 0;
      while (v < st.field_values.len()) {
        vals = vals.append(rvf_expr(st.field_values[v], structs));
        v = v + 1;
      }
      let nbase: ast.Expr = st.base;
      if (st.has_base) {
        nbase = rvf_expr(st.base, structs);
      }
      return ast.ExprStructLit { ...st, field_values: vals, base: nbase };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, obj: rvf_expr(fa.obj, structs) };
    },
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, body: rvf_block(lm.body, structs) };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function rvf_stmt(st: ast.Stmt, structs: StructDecl[]): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { name: v.name, type_name: v.type_name, init: rvf_expr(v.init, structs), line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: rvf_expr(r.value, structs), line: r.line, col: r.col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: rvf_expr(x.value, structs), line: x.line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: rvf_expr(f.cond, structs), then_body: rvf_block(f.then_body, structs), else_body: rvf_block(f.else_body, structs), sugar: rvf_sugar(f.sugar, structs) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: rvf_expr(w.cond, structs), body: rvf_block(w.body, structs), label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { target: a.target, value: rvf_expr(a.value, structs), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: rvf_expr(fr.iter, structs), body: rvf_block(fr.body, structs), label: fr.label, line: fr.line, col: fr.col };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: rvf_stmt(d.action, structs), on_error: d.on_error, line: d.line };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let a: i32 = 0;
      while (a < m.arms.len()) {
        arms = arms.append(ast.MatchArm { pattern: rvf_pattern(m.arms[a].pattern, structs), body: rvf_block(m.arms[a].body, structs), line: m.arms[a].line, col: m.arms[a].col, guard: rvf_expr(m.arms[a].guard, structs), has_guard: m.arms[a].has_guard, alt_cont: false });
        a = a + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: rvf_expr(m.scrutinee, structs), arms: arms };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function rvf_block(stmts: ast.Stmt[], structs: StructDecl[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(rvf_stmt(stmts[i], structs));
    i = i + 1;
  }
  return out;
}

pub function resolve_variant_fields_module(mod: Module): Module {
  let any: boolean = false;
  let s: i32 = 0;
  while (s < mod.structs.len()) {
    if (mod.structs[s].variant_field_names.len() > 0) {
      any = true;
    }
    s = s + 1;
  }
  if (!any) {
    return mod;
  }
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    funcs = funcs.append(FuncDecl { ...fd, body: rvf_block(fd.body, mod.structs) });
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs, top_stmts: rvf_block(mod.top_stmts, mod.structs) };
}

pub function desugar_prepass_module(raw: Module): Module {
  let mod: Module = retag_type_arg_indexes(raw);
  let need_fda: boolean = module_has_default_params(mod) || module_has_named_args(mod);
  let none: string[] = [];
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    let body: ast.Stmt[] = fd.body;
    if (has_labeled_jump(body)) {
      body = resolve_labels_block(body, none);
    }
    if (need_fda) {
      let (filled, diags) = fda_stmts(body, fd.params, mod.funcs);
      body = filled;
    }
    body = desugar_ranges_body(body);
    funcs = funcs.append(FuncDecl { ...fd, body: body });
    i = i + 1;
  }
  let tops: ast.Stmt[] = resolve_labels_block(mod.top_stmts, none);
  if (need_fda) {
    let no_params: ast.ParamDecl[] = [];
    let (filled, diags) = fda_stmts(tops, no_params, mod.funcs);
    tops = filled;
  }
  tops = desugar_ranges_block(tops);
  return Module { ...mod, funcs: funcs, top_stmts: tops };
}

function module_has_default_params(mod: Module): boolean {
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let ps: ast.ParamDecl[] = mod.funcs[fi].params;
    let pi: i32 = 0;
    while (pi < ps.len()) {
      if (ps[pi].has_default) {
        return true;
      }
      pi = pi + 1;
    }
    fi = fi + 1;
  }
  return false;
}

function fda_lookup_params(name: string, funcs: FuncDecl[]): ast.ParamDecl[] {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].receiver_type.len() == 0 && funcs[i].name == name) {
      return funcs[i].params;
    }
    i = i + 1;
  }
  let none: ast.ParamDecl[] = [];
  return none;
}

function fda_is_named_marker(e: ast.Expr): boolean {
  match (e) {
    ast.ExprBinary(b) => {
      return b.op == "__named_arg";
    },
    _ => {
      return false;
    }
  }
  return false;
}

function fda_marker_name(e: ast.Expr): string {
  match (e) {
    ast.ExprBinary(b) => {
      match (b.left) {
        ast.ExprIdent(id) => {
          return id.name;
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
  return "";
}

function fda_marker_value(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return b.right;
    },
    _ => {
      return e;
    }
  }
  return e;
}

function fda_args_have_named(args: ast.Expr[]): boolean {
  let i: i32 = 0;
  while (i < args.len()) {
    if (fda_is_named_marker(args[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function fda_named_lookup(names: string[], vals: ast.Expr[], want: string): i32 {
  let i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == want) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function fda_resolve_named(params: ast.ParamDecl[], args: ast.Expr[]): ast.Expr[] {
  let posvals: ast.Expr[] = [];
  let nnames: string[] = [];
  let nvals: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < args.len()) {
    if (fda_is_named_marker(args[i])) {
      nnames = nnames.append(fda_marker_name(args[i]));
      nvals = nvals.append(fda_marker_value(args[i]));
    } else {
      posvals = posvals.append(args[i]);
    }
    i = i + 1;
  }
  let out: ast.Expr[] = [];
  let pi: i32 = 0;
  while (pi < params.len()) {
    if (pi < posvals.len()) {
      out = out.append(posvals[pi]);
    } else {
      let ni: i32 = fda_named_lookup(nnames, nvals, params[pi].name);
      if (ni >= 0) {
        out = out.append(nvals[ni]);
      } else {
        out = out.append(params[pi].default_value);
      }
    }
    pi = pi + 1;
  }
  let j: i32 = params.len();
  while (j < posvals.len()) {
    out = out.append(posvals[j]);
    j = j + 1;
  }
  return out;
}

function fda_named_count_of(e: ast.Expr, own acc: i32): i32 {
  if (fda_is_named_marker(e)) {
    return acc + 1;
  }
  return acc;
}

function stmts_have_named(stmts: ast.Stmt[]): boolean {
  let n: i32 = 0;
  for st in stmts {
    n = astwalk.fold_stmt(st, n, fda_named_count_of);
  }
  return n > 0;
}

function module_has_named_args(mod: Module): boolean {
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    if (stmts_have_named(mod.funcs[fi].body)) {
      return true;
    }
    fi = fi + 1;
  }
  return stmts_have_named(mod.top_stmts);
}

function fda_call_of(c: ast.ExprCall, funcs: FuncDecl[]): ast.Expr {
  let new_args: ast.Expr[] = c.args;
  match (c.callee) {
    ast.ExprIdent(id) => {
      let params: ast.ParamDecl[] = fda_lookup_params(id.name, funcs);
      if (fda_args_have_named(new_args)) {
        new_args = fda_resolve_named(params, new_args);
      } else if (params.len() > new_args.len()) {
        let ok: boolean = true;
        let k: i32 = new_args.len();
        while (k < params.len()) {
          if (!params[k].has_default) {
            ok = false;
          }
          k = k + 1;
        }
        if (ok) {
          let j: i32 = new_args.len();
          while (j < params.len()) {
            new_args = new_args.append(params[j].default_value);
            j = j + 1;
          }
        }
      }
    },
    _ => {}
  }
  return ast.ExprCall { ...c, args: new_args };
}

struct FdaWalk { funcs: FuncDecl[], local: string[], diags: util.Diag[] }

function fda_bind(w: FdaWalk, packed: string): FdaWalk {
  let local: string[] = w.local;
  for name in astwalk.append_bound_name([], packed) {
    local = local.append(name);
  }
  return FdaWalk { ...w, local: local };
}

function fda_bind_params(w: FdaWalk, ps: ast.ParamDecl[]): FdaWalk {
  for p in ps {
    w = fda_bind(w, p.name);
  }
  return w;
}

function fda_leave(inner: FdaWalk, outer: FdaWalk): FdaWalk {
  return FdaWalk { ...inner, local: outer.local };
}

function fda_expr(e: ast.Expr, w: FdaWalk): (ast.Expr, FdaWalk) {
  let (out, tail, handled) = astwalk.map_expr_acc(e, w, fda_stmt_at, fda_expr_at);
  return (out, tail);
}

function fda_body(stmts: ast.Stmt[], w: FdaWalk): (ast.Stmt[], FdaWalk) {
  return astwalk.map_stmts_acc(stmts, w, fda_stmt_at, fda_expr_at);
}

function fda_call(c: ast.ExprCall, w: FdaWalk): (ast.Expr, FdaWalk) {
  if (fda_args_have_named(c.args)) {
    let (code, msg) = fda_call_error(c, w.funcs, w.local);
    if (code.len() > 0) {
      return (c, FdaWalk { ...w, diags: w.diags.append(util.Diag { related: [], length: 0, code: code, message: msg, line: c.line, col: c.col, fix: None }) });
    }
  }
  if let ast.ExprIdent(id) = c.callee {
    if (util.has_str(w.local, id.name)) {
      return (c, w);
    }
  }
  return (fda_call_of(c, w.funcs), w);
}

function fda_expr_at(e: ast.Expr, w: FdaWalk): (ast.Expr, FdaWalk, boolean) {
  match (e) {
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      for arg in c.args {
        let (na, aw) = fda_expr(arg, w);
        args = args.append(na);
        w = aw;
      }
      let (callee, cw) = fda_expr(c.callee, w);
      let (out, tail) = fda_call(ast.ExprCall { ...c, callee: callee, args: args }, cw);
      return (out, tail, true);
    },
    ast.ExprLambda(lm) => {
      let (bs, tail) = fda_body(lm.body, fda_bind_params(w, lm.params));
      return (ast.ExprLambda { ...lm, body: bs }, fda_leave(tail, w), true);
    },
    _ => {
      return (e, w, false);
    }
  }
  return (e, w, false);
}

function fda_stmt_at(st: ast.Stmt, w: FdaWalk): (ast.Stmt, FdaWalk, boolean) {
  match (st) {
    ast.StmtVar(v) => {
      let recursive: boolean = ast.var_binds_itself(v);
      let before: FdaWalk = w;
      if (recursive) {
        before = fda_bind(w, v.name);
      }
      let (init, tail) = fda_expr(v.init, before);
      if (!recursive) {
        tail = fda_bind(tail, v.name);
      }
      return (ast.StmtVar { ...v, init: init }, tail, true);
    },
    ast.StmtIf(f) => {
      let (cond, cw) = fda_expr(f.cond, w);
      let (tb, tw) = fda_body(f.then_body, cw);
      let (eb, ew) = fda_body(f.else_body, fda_leave(tw, cw));
      return (ast.StmtIf { ...f, cond: cond, then_body: tb, else_body: eb }, fda_leave(ew, w), true);
    },
    ast.StmtWhile(wh) => {
      let (cond, cw) = fda_expr(wh.cond, w);
      let (bs, tail) = fda_body(wh.body, cw);
      return (ast.StmtWhile { ...wh, cond: cond, body: bs }, fda_leave(tail, w), true);
    },
    ast.StmtFor(f) => {
      let (iter, iw) = fda_expr(f.iter, w);
      let (bs, tail) = fda_body(f.body, fda_bind(iw, f.var_name));
      return (ast.StmtFor { ...f, iter: iter, body: bs }, fda_leave(tail, w), true);
    },
    ast.StmtMatch(m) => {
      let (scrutinee, cur) = fda_expr(m.scrutinee, w);
      let arms: ast.MatchArm[] = [];
      for arm in m.arms {
        let inner: FdaWalk = cur;
        for n in astwalk.pattern_binders(arm.pattern, []) {
          inner = fda_bind(inner, n);
        }
        let guard: ast.Expr = arm.guard;
        if (arm.has_guard) {
          let (g, gw) = fda_expr(guard, inner);
          guard = g;
          inner = gw;
        }
        let (bs, tail) = fda_body(arm.body, inner);
        arms = arms.append(ast.MatchArm { ...arm, guard: guard, body: bs });
        cur = fda_leave(tail, cur);
      }
      return (ast.StmtMatch { ...m, scrutinee: scrutinee, arms: arms }, cur, true);
    },
    ast.StmtDefer(d) => {
      let (action, tail, handled) = astwalk.map_stmt_acc(d.action, w, fda_stmt_at, fda_expr_at);
      return (ast.StmtDefer { ...d, action: action }, fda_leave(tail, w), true);
    },
    _ => {
      return (st, w, false);
    }
  }
  return (st, w, false);
}

function fda_stmts(stmts: ast.Stmt[], params: ast.ParamDecl[], funcs: FuncDecl[]): (ast.Stmt[], util.Diag[]) {
  let none: util.Diag[] = [];
  let scope: string[] = [];
  let w: FdaWalk = fda_bind_params(FdaWalk { funcs: funcs, local: scope, diags: none }, params);
  let (out, tail) = fda_body(stmts, w);
  return (out, tail.diags);
}

pub function default_nonconst_reason(e: ast.Expr): (string, boolean) {
  match (e) {
    ast.ExprBytes(_) => {
      return ("is an array literal", true);
    },
    ast.ExprNumber(n) => {
      return ("", false);
    },
    ast.ExprString(st) => {
      return ("", false);
    },
    ast.ExprBool(b) => {
      return ("", false);
    },
    ast.ExprIdent(id) => {
      return ("reads \"" + id.name + "\"", true);
    },
    ast.ExprUnary(u) => {
      if (is_cast_op(u.op)) {
        return ("is a cast", true);
      }
      return default_nonconst_reason(u.operand);
    },
    ast.ExprBinary(b) => {
      let (lwhy, lbad) = default_nonconst_reason(b.left);
      if (lbad) {
        return (lwhy, true);
      }
      return default_nonconst_reason(b.right);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          return ("calls \"" + id.name + "\"", true);
        },
        _ => {
          return ("is a call", true);
        }
      }
      return ("is a call", true);
    },
    ast.ExprFieldAccess(fa) => {
      return ("is a field access", true);
    },
    ast.ExprIndex(ix) => {
      return ("is an index", true);
    },
    ast.ExprLambda(lm) => {
      return ("is a lambda", true);
    },
    ast.ExprStructLit(sl) => {
      return ("is a struct literal", true);
    },
    ast.ExprArray(al) => {
      return ("is an array literal", true);
    },
    ast.ExprTuple(tl) => {
      return ("is a tuple literal", true);
    },
    ast.ExprSlice(sl) => {
      return ("is not a constant expression", true);
    },
    ast.ExprMapLit(ml) => {
      return ("is not a constant expression", true);
    },
    ast.ExprFString(fs) => {
      return ("is not a constant expression", true);
    },
    ast.ExprUnknown(uk) => {
      return ("", false);
    },
    ast.ExprZero(_) => {
      return ("", false);
    }
  }
  return ("is not a constant expression", true);
}

function fda_const_value(name: string, funcs: FuncDecl[]): (ast.Expr, boolean) {
  for fd in funcs {
    if (fd.is_const && fd.receiver_type.len() == 0 && fd.name == name && fd.body.len() == 1) {
      match (fd.body[0]) {
        ast.StmtReturn(r) => {
          return (r.value, true);
        },
        _ => {}
      }
    }
  }
  return (ast.ExprBool { value: false, line: 0, col: 0 }, false);
}

function fda_fold_consts(e: ast.Expr, funcs: FuncDecl[], depth: i32): ast.Expr {
  if (depth > 16) {
    return e;
  }
  match (e) {
    ast.ExprIdent(id) => {
      let (v, ok) = fda_const_value(id.name, funcs);
      if (ok) {
        return fda_fold_consts(v, funcs, depth + 1);
      }
      return e;
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { ...u, operand: fda_fold_consts(u.operand, funcs, depth) };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { ...b, left: fda_fold_consts(b.left, funcs, depth), right: fda_fold_consts(b.right, funcs, depth) };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function fda_fold_default_consts(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    let params: ast.ParamDecl[] = [];
    for param in fd.params {
      if (param.has_default) {
        params = params.append(ast.ParamDecl { ...param, default_value: fda_fold_consts(param.default_value, mod.funcs, 0) });
      } else {
        params = params.append(param);
      }
    }
    funcs = funcs.append(FuncDecl { ...fd, params: params });
  }
  return Module { ...mod, funcs: funcs };
}

function fda_decl_diags(mod: Module): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    for param in fd.params {
      if (param.has_default) {
        let (why, bad) = default_nonconst_reason(param.default_value);
        if (bad) {
          out = out.append(util.Diag { related: [], length: 0, code: "E076", message: "default value for parameter \"" + param.name + "\" " + why + ": a default must be a constant expression, because it is evaluated at each call site rather than inside " + fd.name, line: ast.expr_line(param.default_value), col: ast.expr_col(param.default_value), fix: None });
        }
      }
    }
  }
  return out;
}

function fda_known_func(name: string, funcs: FuncDecl[]): boolean {
  for fd in funcs {
    if (fd.receiver_type.len() == 0 && fd.name == name) {
      return true;
    }
  }
  return false;
}

function fda_param_index(params: ast.ParamDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < params.len()) {
    if (params[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function fda_call_error(c: ast.ExprCall, funcs: FuncDecl[], local: string[]): (string, string) {
  let callee: string = "";
  match (c.callee) {
    ast.ExprIdent(id) => {
      callee = id.name;
    },
    _ => {
      return ("E077", "named arguments are only supported on direct calls to named functions");
    }
  }
  if (util.has_str(local, callee) || !fda_known_func(callee, funcs)) {
    return ("E077", "named arguments are not supported for call to \"" + callee + "\"");
  }
  let params: ast.ParamDecl[] = fda_lookup_params(callee, funcs);
  let filled: boolean[] = [];
  let k: i32 = 0;
  while (k < params.len()) {
    filled = filled.append(false);
    k = k + 1;
  }
  let pos: i32 = 0;
  let seen_named: boolean = false;
  let i: i32 = 0;
  while (i < c.args.len()) {
    if (fda_is_named_marker(c.args[i])) {
      seen_named = true;
      let name: string = fda_marker_name(c.args[i]);
      let idx: i32 = fda_param_index(params, name);
      if (idx < 0) {
        return ("E077", "\"" + callee + "\" has no parameter named \"" + name + "\"");
      }
      if (filled[idx]) {
        return ("E077", "duplicate argument for parameter \"" + name + "\"");
      }
      filled = filled.with(idx, true);
    } else {
      if (seen_named) {
        return ("E077", "positional argument after named argument");
      }
      if (pos >= params.len()) {
        return ("E004", "function \"" + callee + "\" takes at most " + util.i32_to_string(params.len()) + " arguments but was given more");
      }
      filled = filled.with(pos, true);
      pos = pos + 1;
    }
    i = i + 1;
  }
  let pi: i32 = 0;
  while (pi < params.len()) {
    if (!filled[pi] && !params[pi].has_default) {
      return ("E004", "missing argument for parameter \"" + params[pi].name + "\" of \"" + callee + "\"");
    }
    pi = pi + 1;
  }
  return ("", "");
}

pub function fill_default_args_with_diags(raw: Module): (Module, util.Diag[]) {
  let none: util.Diag[] = [];
  raw = retag_type_arg_indexes(raw);
  if (!module_has_default_params(raw)) {
    if (!module_has_named_args(raw)) {
      return (raw, none);
    }
    return fda_fill(raw);
  }
  let mod: Module = fda_fold_default_consts(raw);
  let decl_diags: util.Diag[] = fda_decl_diags(mod);
  if (decl_diags.len() > 0) {
    return (raw, decl_diags);
  }
  return fda_fill(mod);
}

function retag_type_arg_indexes(mod: Module): Module {
  let generics: string[] = [];
  let types: string[] = [];
  for fd in mod.funcs {
    if (fd.all_type_params.len() > 0 && fd.receiver_type.len() == 0) {
      generics = generics.append(fd.name);
    }
  }
  let const_firsts: string[] = const_first_generics(mod.funcs);
  if (generics.len() == 0) {
    return mod;
  }
  let any_site: boolean = rta_has_index_call(mod.top_stmts);
  for fd in mod.funcs {
    if (!any_site && rta_has_index_call(fd.body)) {
      any_site = true;
    }
  }
  if (!any_site) {
    return mod;
  }
  for sd in mod.structs {
    types = types.append(sd.name);
  }
  for ed in mod.enums {
    types = types.append(ed.name);
  }
  for rd in mod.resources {
    types = types.append(rd.name);
  }
  let consts: string[] = [];
  for fd in mod.funcs {
    if (fd.is_const && fd.receiver_type.len() == 0) {
      consts = consts.append(fd.name);
    }
  }
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    if (!rta_has_index_call(fd.body)) {
      funcs = funcs.append(fd);
      continue;
    }
    let shadow: string[] = astwalk.collect_bound_stmts(fd.body, consts);
    for pd in fd.params {
      shadow = shadow.append(pd.name);
    }
    let ftypes: string[] = types;
    if (fd.all_type_params.len() > 0 || fd.type_params.len() > 0) {
      ftypes = util.append_all(util.append_all(ftypes, fd.all_type_params), fd.type_params);
      for pd in fd.params {
        ftypes = rta_type_names(pd.type_name, ftypes);
      }
      ftypes = rta_type_names(fd.ret_type, ftypes);
      ftypes = rta_type_names(fd.receiver_type, ftypes);
    }
    function rw(x: ast.Expr): ast.Expr {
      return rta_call_of(x, generics, const_firsts, ftypes, shadow);
    }
    funcs = funcs.append(FuncDecl { ...fd, body: astwalk.map_stmts(fd.body, rw) });
  }
  if (!rta_has_index_call(mod.top_stmts)) {
    return Module { ...mod, funcs: funcs };
  }
  let top_shadow: string[] = astwalk.collect_bound_stmts(mod.top_stmts, consts);
  function top_rw(x: ast.Expr): ast.Expr {
    return rta_call_of(x, generics, const_firsts, types, top_shadow);
  }
  return Module { ...mod, funcs: funcs, top_stmts: astwalk.map_stmts(mod.top_stmts, top_rw) };
}

function rta_has_index_call(stmts: ast.Stmt[]): boolean {
  let found: boolean = false;
  for st in stmts {
    found = astwalk.fold_stmt_nodes(st, found, rta_skip_stmt, rta_index_call_of, astwalk.descend_all);
  }
  return found;
}

function rta_skip_stmt(st: ast.Stmt, own acc: boolean): boolean {
  return acc;
}

function rta_index_call_of(e: ast.Expr, own acc: boolean): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIndex(_) = c.callee {
      return true;
    }
  }
  return acc;
}

function rta_type_names(ty: string, acc: string[]): string[] {
  let start: i32 = 0 - 1;
  let i: i32 = 0;
  while (i <= ty.len()) {
    let word: boolean = i < ty.len() && lexer.is_alnum(ty[i] as i32);
    if (word && start < 0) {
      start = i;
    }
    if (!word && start >= 0) {
      acc = acc.append(slice_unchecked(ty, start, i) + "");
      start = 0 - 1;
    }
    i = i + 1;
  }
  return acc;
}

function rta_call_of(x: ast.Expr, generics: string[], const_firsts: string[], types: string[], shadow: string[]): ast.Expr {
  if let ast.ExprCall(c) = x {
    if (c.type_args.len() > 0) {
      return x;
    }
    if let ast.ExprIndex(ix) = c.callee {
      let fname: string = rta_callee_name(ix.array, shadow);
      let targ: string = rta_type_spelling(ix.index, types, shadow);
      if (targ.len() == 0 && fname.len() > 0 && util.has_str(const_firsts, fname)) {
        return ast.ExprCall { ...c, callee: ix.array, type_args: [const_bracket_spelling(ix.index)] };
      }
      if (targ.len() > 0 && fname.len() > 0 && util.has_str(generics, fname)) {
        return ast.ExprCall { ...c, callee: ix.array, type_args: [targ] };
      }
    }
  }
  return x;
}

function const_first_generics(funcs: FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    if (fd.all_type_params.len() > 0 && fd.receiver_type.len() == 0 && is_const_tparam(fd, fd.all_type_params[0])) {
      out = out.append(fd.name);
    }
  }
  return out;
}

pub function is_const_tparam(fd: FuncDecl, name: string): boolean {
  let i: i32 = util.index_of_str(fd.type_params, name);
  return i >= 0 && i < fd.bound_traits.len() && is_const_bound(fd.bound_traits[i]);
}

pub function is_const_arg(spelling: string): boolean {
  if (spelling.len() == 0) {
    return false;
  }
  for ch in spelling {
    if (ch < b'0' || ch > b'9') {
      return false;
    }
  }
  return true;
}

pub function const_arg_text(text: string): string {
  let hex: boolean = text.len() > 2 && text[0] == b'0' && (text[1] == b'x' || text[1] == b'X');
  let at: i32 = 0;
  if (hex) {
    at = 2;
  }
  while (at + 1 < text.len() && text[at] == b'0') {
    at = at + 1;
  }
  if (!hex) {
    return slice_unchecked(text, at, text.len()) + "";
  }
  if (text.len() - at > 15) {
    return "99999999999";
  }
  return util.i64_to_string(util.lit_to_i64(text));
}

pub function const_arg_fits(spelling: string): boolean {
  return spelling.len() <= 10 && util.lit_to_i64(spelling) <= 2147483647;
}

function const_bracket_spelling(e: ast.Expr): string {
  if let ast.ExprNumber(n) = e {
    if (!n.is_float && n.suffix.len() == 0) {
      return const_arg_text(n.text);
    }
  }
  if let ast.ExprIdent(id) = e {
    return id.name;
  }
  return "";
}

function rta_type_spelling(e: ast.Expr, types: string[], shadow: string[]): string {
  if let ast.ExprIdent(id) = e {
    if (util.has_str(types, id.name) && !util.has_str(shadow, id.name)) {
      return id.name;
    }
    return "";
  }
  if let ast.ExprIndex(ix) = e {
    let head: string = rta_type_spelling(ix.array, types, shadow);
    let arg: string = rta_type_spelling(ix.index, types, shadow);
    if (head.len() > 0 && arg.len() > 0) {
      return head + "[" + arg + "]";
    }
  }
  return "";
}

function rta_callee_name(callee: ast.Expr, shadow: string[]): string {
  if let ast.ExprIdent(fid) = callee {
    if (util.has_str(shadow, fid.name)) {
      return "";
    }
    return fid.name;
  }
  if let ast.ExprFieldAccess(fa) = callee {
    if let ast.ExprIdent(mid) = fa.obj {
      if (util.has_str(shadow, mid.name)) {
        return "";
      }
      return mid.name + "." + fa.field;
    }
  }
  return "";
}

function fda_fill(mod: Module): (Module, util.Diag[]) {
  let funcs: FuncDecl[] = [];
  let diags: util.Diag[] = [];
  for fd in mod.funcs {
    let (body, fdiags) = fda_stmts(fd.body, fd.params, mod.funcs);
    funcs = funcs.append(FuncDecl { ...fd, body: body });
    diags = util.append_diags(diags, fdiags);
  }
  let no_params: ast.ParamDecl[] = [];
  let (tops, tdiags) = fda_stmts(mod.top_stmts, no_params, mod.funcs);
  return (Module { ...mod, funcs: funcs, top_stmts: tops }, util.append_diags(diags, tdiags));
}

pub function lower_stream_signatures(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  for f in mod.funcs {
    if (f.async && f.import_iface.len() > 0) {
      funcs = funcs.append(lower_stream_signature(f));
    } else {
      funcs = funcs.append(f);
    }
  }
  return Module { ...mod, funcs: funcs };
}

function lower_stream_signature(f: FuncDecl): FuncDecl {
  let slots: i32[] = [];
  let ret: string = f.ret_type;
  if (stream_elem(ret).len() > 0) {
    ret = stream_elem(ret) + "[]";
    slots = slots.append(0 - 1);
  }
  let params: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < f.params.len()) {
    let p: ast.ParamDecl = f.params[i];
    if (stream_elem(p.type_name).len() > 0) {
      p = ast.ParamDecl { ...p, type_name: stream_elem(p.type_name) + "[]" };
      slots = slots.append(i);
    }
    params = params.append(p);
    i = i + 1;
  }
  return FuncDecl { ...f, ret_type: ret, params: params, streams: slots };
}

pub function stream_elem(t: string): string {
  let pre: string = "Stream[";
  if (t.len() <= pre.len() + 1 || slice_unchecked(t, 0, pre.len()) != pre || t[t.len() - 1] != b']') {
    return "";
  }
  let bytes: u8[] = [];
  let i: i32 = pre.len();
  while (i < t.len() - 1) {
    bytes = bytes.append(t[i]);
    i = i + 1;
  }
  return string_from_bytes_unchecked(bytes);
}

pub function fill_default_args_module(mod: Module): Module {
  let (filled, diags) = fill_default_args_with_diags(mod);
  return filled;
}

function irt_param_type(params: ast.ParamDecl[], name: string): string {
  let i: i32 = 0;
  while (i < params.len()) {
    if (params[i].name == name) {
      return params[i].type_name;
    }
    i = i + 1;
  }
  return "";
}

function irt_func_ret(funcs: FuncDecl[], name: string): string {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_type.len() == 0) {
      return funcs[i].ret_type;
    }
    i = i + 1;
  }
  return "";
}

function stamp_lambda_ret(e: ast.Expr, fn_ret: string): ast.Expr {
  if (fn_ret.len() == 0) {
    return e;
  }
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.ret_type.len() > 0) {
        return e;
      }
      return ast.ExprLambda { ...lm, ret_type: fn_ret };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function stamp_value_block_ret(e: ast.Expr, decl_ty: string): ast.Expr {
  if (decl_ty.len() > 2 && slice_unchecked(decl_ty, decl_ty.len() - 2, decl_ty.len()) == "[]") {
    let elem_ty: string = slice_unchecked(decl_ty, 0, decl_ty.len() - 2) + "";
    match (e) {
      ast.ExprArray(al) => {
        let nels: ast.Expr[] = [];
        let ai: i32 = 0;
        while (ai < al.elements.len()) {
          nels = nels.append(stamp_value_block_ret(al.elements[ai], array_element_expected(al.elements[ai], elem_ty)));
          ai = ai + 1;
        }
        return ast.ExprArray { ...al, elements: nels };
      },
      _ => {
        return e;
      }
    }
  }
  if (decl_ty.len() == 0 || is_coarse_fn_tag(decl_ty) || collect_tvars(decl_ty, []).len() > 0) {
    return e;
  }
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return e;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 0 || lm.ret_type == decl_ty || is_written_lambda_origin(lm.origin)) {
            return e;
          }
          let nl: ast.Expr = ast.ExprLambda { ...lm, ret_type: decl_ty };
          return ast.ExprCall { callee: nl, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
        },
        _ => {
          return e;
        }
      }
    },
    _ => {
      return e;
    }
  }
  return e;
}

function irt_method_ret(funcs: FuncDecl[], recv_type: string, name: string): string {
  let base: string = recv_type;
  let b: i32 = 0;
  while (b < base.len()) {
    if (base[b] == b'[') {
      base = slice_unchecked(base, 0, b) + "";
      b = base.len();
    }
    b = b + 1;
  }
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_type.len() > 0) {
      let rb: string = funcs[i].receiver_type;
      let r2: i32 = 0;
      while (r2 < rb.len()) {
        if (rb[r2] == b'[') {
          rb = slice_unchecked(rb, 0, r2) + "";
          r2 = rb.len();
        }
        r2 = r2 + 1;
      }
      if (rb == base) {
        return funcs[i].ret_type;
      }
    }
    i = i + 1;
  }
  return "";
}

function irt_is_cmp(op: string): boolean {
  return op == "<" || op == "<=" || op == ">" || op == ">="
    || op == "==" || op == "!=" || op == "&&" || op == "||";
}

function irt_is_option(s: string): boolean {
  return s.len() >= 7 && slice_unchecked(s, 0, 7) == "Option[";
}

function irt_guess(e: ast.Expr, params: ast.ParamDecl[], funcs: FuncDecl[], structs: StructDecl[]): string {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return "f64";
      }
      if (n.suffix.len() > 0) {
        return n.suffix;
      }
      if (literal_is_i64(n.text)) {
        return "i64";
      }
      return "i32";
    },
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprBool(_) => {
      return "boolean";
    },
    ast.ExprIdent(id) => {
      return irt_param_type(params, id.name);
    },
    ast.ExprBinary(b) => {
      if (irt_is_cmp(b.op)) {
        return "boolean";
      }
      return irt_guess(b.left, params, funcs, structs);
    },
    ast.ExprStructLit(s) => {
      return s.type_name;
    },
    ast.ExprArray(al) => {
      if (al.elements.len() == 0) {
        return "";
      }
      let el: string = irt_guess(al.elements[0], params, funcs, structs);
      if (el == "") {
        return "";
      }
      return el + "[]";
    },
    ast.ExprTuple(tl) => {
      let parts: string = "";
      let ti: i32 = 0;
      while (ti < tl.elements.len()) {
        let tt: string = irt_guess(tl.elements[ti], params, funcs, structs);
        if (tt == "") {
          return "";
        }
        if (ti > 0) {
          parts = parts + ", ";
        }
        parts = parts + tt;
        ti = ti + 1;
      }
      return "(" + parts + ")";
    },
    ast.ExprIndex(ix) => {
      let at: string = irt_guess(ix.array, params, funcs, structs);
      if (at.len() >= 3 && slice_unchecked(at, at.len() - 2, at.len()) == "[]") {
        return slice_unchecked(at, 0, at.len() - 2) + "";
      }
      if (at.len() >= 3 && at[0] == b'[' && at[at.len() - 1] == b']') {
        return slice_unchecked(at, 1, at.len() - 1) + "";
      }
      return "";
    },
    ast.ExprSlice(sl) => {
      let st2: string = irt_guess(sl.array, params, funcs, structs);
      if (st2.len() >= 3 && slice_unchecked(st2, st2.len() - 2, st2.len()) == "[]") {
        return "[" + slice_unchecked(st2, 0, st2.len() - 2) + "]";
      }
      if (st2.len() >= 3 && st2[0] == b'[' && st2[st2.len() - 1] == b']') {
        return st2;
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      let ot: string = irt_guess(fa.obj, params, funcs, structs);
      if (ot.len() == 0) {
        return "";
      }
      let tel: string = me_tuple_elem_type(ot, fa.field);
      if (tel.len() > 0) {
        return tel;
      }
      return me_field_type_of(structs, ot, fa.field);
    },
    ast.ExprUnary(u) => {
      if (u.op == "!") {
        return "boolean";
      }
      if (u.op == "-" || u.op == "+") {
        return irt_guess(u.operand, params, funcs, structs);
      }
      if (u.op == "as_f64" || u.op == "as_float") {
        return "f64";
      }
      if (u.op == "as_f32") {
        return "f32";
      }
      if (u.op == "as_i32") {
        return "i32";
      }
      if (u.op == "as_i64") {
        return "i64";
      }
      if (u.op == "as_u8") {
        return "u8";
      }
      if (u.op == "as_u32") {
        return "u32";
      }
      if (u.op == "as_u64") {
        return "u64";
      }
      return "";
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (cid.name == "Some") {
            if (c.args.len() == 1) {
              let inner: string = irt_guess(c.args[0], params, funcs, structs);
              if (inner != "") {
                return "Option[" + inner + "]";
              }
            }
            return "Option";
          }
          if (cid.name == "None") {
            return "Option";
          }
          if (cid.name == "Ok" || cid.name == "Err") {
            return "";
          }
          let pth: i32 = irt_passthrough_arg_index(funcs, cid.name);
          if (pth >= 0 && pth < c.args.len()) {
            return irt_guess(c.args[pth], params, funcs, structs);
          }
          return irt_func_ret(funcs, cid.name);
        },
        ast.ExprFieldAccess(mfa) => {
          let rt2: string = irt_guess(mfa.obj, params, funcs, structs);
          if (rt2.len() == 0) {
            return "";
          }
          return irt_method_ret(funcs, rt2, mfa.field);
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
}

function irt_passthrough_arg_index(funcs: FuncDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_type.len() == 0 && funcs[i].all_type_params.len() > 0) {
      let p: i32 = 0;
      while (p < funcs[i].params.len()) {
        if (funcs[i].params[p].type_name.len() > 0 && funcs[i].params[p].type_name == funcs[i].ret_type) {
          return p;
        }
        p = p + 1;
      }
      return 0 - 1;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function irt_unify(a: string, b: string): string {
  if (a == b) {
    return a;
  }
  if (irt_is_option(a) && b == "Option") {
    return a;
  }
  if (irt_is_option(b) && a == "Option") {
    return b;
  }
  return "";
}

function irt_collect_returns(stmts: ast.Stmt[], acc: ast.Expr[]): ast.Expr[] {
  let out: ast.Expr[] = acc;
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = irt_collect_stmt(stmts[i], out);
    i = i + 1;
  }
  return out;
}

function irt_collect_stmt(st: ast.Stmt, acc: ast.Expr[]): ast.Expr[] {
  match (st) {
    ast.StmtReturn(r) => {
      return acc.append(r.value);
    },
    ast.StmtIf(f) => {
      let a: ast.Expr[] = irt_collect_returns(f.then_body, acc);
      return irt_collect_returns(f.else_body, a);
    },
    ast.StmtWhile(w) => {
      return irt_collect_returns(w.body, acc);
    },
    ast.StmtFor(fr) => {
      return irt_collect_returns(fr.body, acc);
    },
    ast.StmtMatch(m) => {
      let a: ast.Expr[] = acc;
      let i: i32 = 0;
      while (i < m.arms.len()) {
        a = irt_collect_returns(m.arms[i].body, a);
        i = i + 1;
      }
      return a;
    },
    _ => {
      return acc;
    }
  }
}

function irt_payload_of(scrut_ty: string): string {
  if (scrut_ty.len() == 0) {
    return "";
  }
  let b: i32 = 0;
  while (b < scrut_ty.len()) {
    if (scrut_ty[b] == b'[') {
      let inner: string = slice_unchecked(scrut_ty, b + 1, scrut_ty.len() - 1) + "";
      let c: i32 = 0;
      while (c < inner.len()) {
        if (inner[c] == b',') {
          return slice_unchecked(inner, 0, c) + "";
        }
        c = c + 1;
      }
      return inner;
    }
    b = b + 1;
  }
  if (irt_is_scalar_ty(scrut_ty)) {
    return scrut_ty;
  }
  return "";
}

function irt_is_scalar_ty(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u32" || t == "u64" || t == "u8"
    || t == "usize" || t == "f64" || t == "f32";
}

function irt_arm_bindings(stmts: ast.Stmt[], params: ast.ParamDecl[], funcs: FuncDecl[], structs: StructDecl[], acc: ast.ParamDecl[]): ast.ParamDecl[] {
  let out: ast.ParamDecl[] = acc;
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtMatch(m) => {
        let st: string = irt_payload_of(irt_guess(m.scrutinee, params, funcs, structs));
        let a: i32 = 0;
        while (a < m.arms.len()) {
          match (m.arms[a].pattern) {
            ast.PatVariant(pv) => {
              if (st.len() > 0 && pv.binding.len() > 0 && pv.binding != "_") {
                out = out.append(ast.ParamDecl { name: pv.binding, type_name: st, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" });
              }
            },
            _ => {}
          }
          out = irt_arm_bindings(m.arms[a].body, params, funcs, structs, out);
          a = a + 1;
        }
      },
      ast.StmtIf(f) => {
        out = irt_arm_bindings(f.then_body, params, funcs, structs, out);
        out = irt_arm_bindings(f.else_body, params, funcs, structs, out);
      },
      ast.StmtWhile(w) => {
        out = irt_arm_bindings(w.body, params, funcs, structs, out);
      },
      ast.StmtFor(fr) => {
        out = irt_arm_bindings(fr.body, params, funcs, structs, out);
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

function irt_infer_func(fd: FuncDecl, funcs: FuncDecl[], structs: StructDecl[]): string {
  let empty: ast.Expr[] = [];
  let rets: ast.Expr[] = irt_collect_returns(fd.body, empty);
  if (rets.len() == 0) {
    return "";
  }
  let scope: ast.ParamDecl[] = irt_arm_bindings(fd.body, fd.params, funcs, structs, fd.params);
  let unified: string = "";
  let i: i32 = 0;
  while (i < rets.len()) {
    let g: string = irt_guess(rets[i], scope, funcs, structs);
    if (g == "") {
      return "";
    }
    if (unified == "") {
      unified = g;
    } else {
      unified = irt_unify(unified, g);
      if (unified == "") {
        return "";
      }
    }
    i = i + 1;
  }
  return unified;
}

function irt_set_ret(funcs: FuncDecl[], idx: i32, rt: string): FuncDecl[] {
  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (i == idx) {
      let f: FuncDecl = funcs[i];
      out = out.append(FuncDecl { ...f, ret_type: rt });
    } else {
      out = out.append(funcs[i]);
    }
    i = i + 1;
  }
  return out;
}

pub function infer_ret_types_module(mod: Module): Module {
  let funcs: FuncDecl[] = mod.funcs;
  let pass: i32 = 0;
  while (pass < 3) {
    let i: i32 = 0;
    while (i < funcs.len()) {
      let fd: FuncDecl = funcs[i];
      if (fd.ret_type == "" && fd.body.len() > 0 && fd.receiver_type.len() == 0 && fd.all_type_params.len() == 0) {
        let inferred: string = irt_infer_func(fd, funcs, mod.structs);
        if (inferred != "") {
          funcs = irt_set_ret(funcs, i, inferred);
        }
      } else if (fd.ret_type == "i32" && fd.body.len() > 0 && fd.receiver_type.len() == 0
        && fd.all_type_params.len() == 0 && fd.name.len() > 6 && slice_unchecked(fd.name, 0, 6) == "__lam_") {
        let winf: string = irt_infer_func(fd, funcs, mod.structs);
        if (winf == "i64" || winf == "u64" || winf == "f64") {
          funcs = irt_set_ret(funcs, i, winf);
        }
      }
      i = i + 1;
    }
    pass = pass + 1;
  }
  return Module { ...mod, funcs: funcs };
}

struct LenLoopMatch { ok: boolean, idx: string, arr: string, root: string, bound: string }

struct LenPath { path: string, root: string }

pub function elide_len_bounded_body(stmts: ast.Stmt[]): ast.Stmt[] {
  let lowered: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    lowered = lowered.append(elb_recurse_stmt(stmts[i]));
    i = i + 1;
  }
  let out: ast.Stmt[] = [];
  let p: i32 = 0;
  while (p < lowered.len()) {
    let st: ast.Stmt = lowered[p];
    match (st) {
      ast.StmtWhile(w) => {
        st = elb_try_while(w, lowered, p);
      },
      _ => {}
    }
    out = out.append(st);
    p = p + 1;
  }
  return out;
}

function elb_recurse_stmt(st: ast.Stmt): ast.Stmt {
  match (st) {
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: f.cond, then_body: elide_len_bounded_body(f.then_body), else_body: elide_len_bounded_body(f.else_body) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: elide_len_bounded_body(w.body), label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: elide_len_bounded_body(fr.body), label: fr.label, line: fr.line, col: fr.col };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let arm: ast.MatchArm = m.arms[i];
        arms = arms.append(ast.MatchArm { ...arm, body: elide_len_bounded_body(arm.body) });
        i = i + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: elb_recurse_stmt(d.action), on_error: d.on_error, line: d.line };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function elb_try_while(w: ast.StmtWhile, stmts: ast.Stmt[], p: i32): ast.Stmt {
  let same: ast.Stmt = ast.StmtWhile { cond: w.cond, body: w.body, label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
  let m: LenLoopMatch = elb_loop_match(w.cond);
  if (!m.ok) {
    return same;
  }
  let lp: LenPath = LenPath { path: m.arr, root: m.root };
  if (m.bound != "") {
    lp = elb_len_local(stmts, p, m.bound);
    if (lp.path == "" || elb_assigns_stmts(w.body, m.bound) || elb_binds_stmts(w.body, m.bound)) {
      return same;
    }
  }
  if (lp.root == m.idx || elb_assigns_stmts(w.body, lp.root)) {
    return same;
  }
  if (elb_binds_stmts(w.body, m.idx) || elb_binds_stmts(w.body, lp.root)) {
    return same;
  }
  if (!elb_idx_monotonic_stmts(w.body, m.idx)) {
    return same;
  }
  if (!elb_starts_nonneg(stmts, p, m.idx)) {
    return same;
  }
  let nb: ast.Stmt[] = [];
  let i: i32 = 0;
  let stop: boolean = false;
  while (i < w.body.len()) {
    let st: ast.Stmt = w.body[i];
    if (!stop && elb_assigns_stmt(st, m.idx)) {
      stop = true;
    }
    if (!stop) {
      st = elb_mark_stmt(st, m.idx, lp.path);
    }
    nb = nb.append(st);
    i = i + 1;
  }
  let cond: ast.Expr = elb_mark_cond(w.cond, m, lp.path).e;
  return ast.StmtWhile { cond: cond, body: nb, label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
}

function elb_loop_match(cond: ast.Expr): LenLoopMatch {
  match (cond) {
    ast.ExprBinary(b) => {
      if (b.op == "&&") {
        let l: LenLoopMatch = elb_loop_match(b.left);
        if (l.ok) {
          return l;
        }
        return elb_loop_match(b.right);
      }
      if (b.op == "<") {
        match (b.left) {
          ast.ExprIdent(li) => {
            let lp: LenPath = elb_len_path(b.right);
            if (lp.path != "") {
              return LenLoopMatch { ok: true, idx: li.name, arr: lp.path, root: lp.root, bound: "" };
            }
            match (b.right) {
              ast.ExprIdent(ni) => {
                if (ni.name != li.name) {
                  return LenLoopMatch { ok: true, idx: li.name, arr: "", root: "", bound: ni.name };
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  return LenLoopMatch { ok: false, idx: "", arr: "", root: "", bound: "" };
}

function elb_len_path(e: ast.Expr): LenPath {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field == "len" && c.args.len() == 0) {
            return LenPath { path: elb_path(fa.obj), root: elb_path_root(fa.obj) };
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return LenPath { path: "", root: "" };
}

function elb_path(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    ast.ExprFieldAccess(fa) => {
      let base: string = elb_path(fa.obj);
      if (base != "") {
        return base + "." + fa.field;
      }
    },
    _ => {}
  }
  return "";
}

function elb_path_root(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    ast.ExprFieldAccess(fa) => {
      return elb_path_root(fa.obj);
    },
    _ => {}
  }
  return "";
}

function elb_len_local(stmts: ast.Stmt[], p: i32, n: string): LenPath {
  let none: LenPath = LenPath { path: "", root: "" };
  let q: i32 = p - 1;
  while (q >= 0) {
    match (stmts[q]) {
      ast.StmtVar(v) => {
        if (v.name == n) {
          let lp: LenPath = elb_len_path(v.init);
          if (lp.path == "") {
            return none;
          }
          let k: i32 = q + 1;
          while (k < p) {
            if (elb_assigns_stmt(stmts[k], n) || elb_assigns_stmt(stmts[k], lp.root) || elb_binds_stmts([stmts[k]], lp.root)) {
              return none;
            }
            k = k + 1;
          }
          return lp;
        }
      },
      _ => {}
    }
    q = q - 1;
  }
  return none;
}

function elb_starts_nonneg(stmts: ast.Stmt[], p: i32, idx: string): boolean {
  let q: i32 = p - 1;
  while (q >= 0) {
    let st: ast.Stmt = stmts[q];
    match (st) {
      ast.StmtVar(v) => {
        if (v.name == idx) {
          return elb_is_nonneg_int(v.init);
        }
      },
      ast.StmtAssign(a) => {
        if (a.target == idx) {
          return elb_is_nonneg_int(a.value);
        }
      },
      _ => {}
    }
    if (elb_assigns_stmt(st, idx) || elb_binds_stmts([st], idx)) {
      return false;
    }
    q = q - 1;
  }
  return false;
}

function elb_is_nonneg_int(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return false;
      }
      if (n.text.len() == 0) {
        return false;
      }
      let c0: i32 = n.text[0] as i32;
      return c0 >= 48 && c0 <= 57;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function elb_assigns_stmt(st: ast.Stmt, name: string): boolean {
  function vs(s: ast.Stmt, own hit: boolean): boolean {
    if (hit) {
      return true;
    }
    match (s) {
      ast.StmtAssign(a) => {
        return a.target == name;
      },
      _ => {
        return false;
      }
    }
    return false;
  }
  return astwalk.fold_stmt_spine(st, false, vs);
}

function elb_assigns_stmts(stmts: ast.Stmt[], name: string): boolean {
  for st in stmts {
    if (elb_assigns_stmt(st, name)) {
      return true;
    }
  }
  return false;
}

function elb_binds_stmts(stmts: ast.Stmt[], name: string): boolean {
  return util.has_str(astwalk.collect_bound_stmts(stmts, []), name);
}

function elb_idx_monotonic_stmts(stmts: ast.Stmt[], idx: string): boolean {
  function vs(s: ast.Stmt, own ok: boolean): boolean {
    if (!ok) {
      return false;
    }
    match (s) {
      ast.StmtAssign(a) => {
        if (a.target == idx) {
          return elb_is_monotonic_incr(a.value, idx);
        }
        return true;
      },
      _ => {
        return true;
      }
    }
    return true;
  }
  let ok: boolean = true;
  for st in stmts {
    ok = astwalk.fold_stmt_spine(st, ok, vs);
  }
  return ok;
}

function elb_is_monotonic_incr(v: ast.Expr, idx: string): boolean {
  match (v) {
    ast.ExprBinary(b) => {
      if (b.op == "+") {
        match (b.left) {
          ast.ExprIdent(li) => {
            if (li.name == idx) {
              return elb_is_nonneg_int(b.right);
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  return false;
}

function elb_mark_stmts(stmts: ast.Stmt[], idx: string, arr: string): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(elb_mark_stmt(stmts[i], idx, arr));
    i = i + 1;
  }
  return out;
}

function elb_mark_stmt(st: ast.Stmt, idx: string, arr: string): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { name: v.name, type_name: v.type_name, init: elb_mark_expr(v.init, idx, arr), line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: elb_mark_expr(r.value, idx, arr), line: r.line, col: r.col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: elb_mark_expr(x.value, idx, arr), line: x.line };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { target: a.target, value: elb_mark_expr(a.value, idx, arr), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: elb_mark_expr(f.cond, idx, arr), then_body: elb_mark_stmts(f.then_body, idx, arr), else_body: elb_mark_stmts(f.else_body, idx, arr) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: elb_mark_expr(w.cond, idx, arr), body: elb_mark_stmts(w.body, idx, arr), label: w.label, line: w.line, is_loop: w.is_loop, todo: w.todo };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: elb_mark_expr(fr.iter, idx, arr), body: elb_mark_stmts(fr.body, idx, arr), label: fr.label, line: fr.line, col: fr.col };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let arm: ast.MatchArm = m.arms[i];
        arms = arms.append(ast.MatchArm { ...arm, body: elb_mark_stmts(arm.body, idx, arr), guard: elb_mark_expr(arm.guard, idx, arr) });
        i = i + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: elb_mark_expr(m.scrutinee, idx, arr), arms: arms };
    },
    _ => {
      return st;
    }
  }
  return st;
}

struct CondMark { e: ast.Expr, past: boolean }

function elb_mark_cond(c: ast.Expr, m: LenLoopMatch, arr: string): CondMark {
  match (c) {
    ast.ExprBinary(b) => {
      if (b.op == "&&") {
        let l: CondMark = elb_mark_cond(b.left, m, arr);
        if (l.past) {
          return CondMark { e: ast.ExprBinary { op: b.op, left: l.e, right: elb_mark_expr(b.right, m.idx, arr), line: b.line, col: b.col, ty: b.ty }, past: true };
        }
        let r: CondMark = elb_mark_cond(b.right, m, arr);
        return CondMark { e: ast.ExprBinary { op: b.op, left: b.left, right: r.e, line: b.line, col: b.col, ty: b.ty }, past: r.past };
      }
    },
    _ => {}
  }
  let g: LenLoopMatch = elb_loop_match(c);
  return CondMark { e: c, past: g.ok && g.idx == m.idx && g.arr == m.arr && g.bound == m.bound };
}

function elb_mark_expr(e: ast.Expr, idx: string, arr: string): ast.Expr {
  match (e) {
    ast.ExprIndex(ix) => {
      let mark: boolean = ix.unchecked;
      match (ix.index) {
        ast.ExprIdent(iid) => {
          if (iid.name == idx && elb_path(ix.array) == arr) {
            mark = true;
          }
        },
        _ => {}
      }
      return ast.ExprIndex { array: elb_mark_expr(ix.array, idx, arr), index: elb_mark_expr(ix.index, idx, arr), unchecked: mark, ty: ix.ty, line: ix.line, col: ix.col };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: elb_mark_expr(b.left, idx, arr), right: elb_mark_expr(b.right, idx, arr), line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: elb_mark_expr(u.operand, idx, arr), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprCall(c) => {
      let na: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < c.args.len()) {
        na = na.append(elb_mark_expr(c.args[i], idx, arr));
        i = i + 1;
      }
      return ast.ExprCall { callee: elb_mark_expr(c.callee, idx, arr), args: na, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      let ne: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < a.elements.len()) {
        ne = ne.append(elb_mark_expr(a.elements[i], idx, arr));
        i = i + 1;
      }
      return ast.ExprArray { ...a, elements: ne };
    },
    ast.ExprTuple(t) => {
      let ne: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < t.elements.len()) {
        ne = ne.append(elb_mark_expr(t.elements[i], idx, arr));
        i = i + 1;
      }
      return ast.ExprTuple { elements: ne, line: t.line, col: t.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: elb_mark_expr(sl.array, idx, arr), start: elb_mark_expr(sl.start, idx, arr), end: elb_mark_expr(sl.end, idx, arr) };
    },
    ast.ExprStructLit(sl) => {
      let nv: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < sl.field_values.len()) {
        nv = nv.append(elb_mark_expr(sl.field_values[i], idx, arr));
        i = i + 1;
      }
      let nbase: ast.Expr = sl.base;
      if (sl.has_base) {
        nbase = elb_mark_expr(sl.base, idx, arr);
      }
      return ast.ExprStructLit { ...sl, field_values: nv, base: nbase };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, obj: elb_mark_expr(fa.obj, idx, arr) };
    },
    _ => {
      return e;
    }
  }
  return e;
}

pub function erase_view_spelling(ty: string): string {
  return fold_view_spelling(erase_str_names(ty));
}

function view_opens_at(ty: string, i: i32): boolean {
  if (i + 1 < ty.len() && ty[i + 1] == b']') {
    return false;
  }
  if (i == 0) {
    return true;
  }
  let prev: u8 = ty[i - 1];
  return prev == b'(' || prev == b'[' || prev == b',' || prev == b' ';
}

function fold_view_spelling(ty: string): string {
  let i: i32 = 0;
  while (i < ty.len()) {
    if (ty[i] == b'[' && view_opens_at(ty, i)) {
      let close: i32 = matching_bracket(ty, i);
      if (close < 0) {
        return ty;
      }
      let inner: string = fold_view_spelling(slice_unchecked(ty, i + 1, close) + "");
      return slice_unchecked(ty, 0, i) + inner + "[]" + fold_view_spelling(slice_unchecked(ty, close + 1, ty.len()) + "");
    }
    i = i + 1;
  }
  return ty;
}

function erase_str_names(ty: string): string {
  let out: string = "";
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < ty.len()) {
    if (!ident_byte(ty[i] as i32)) {
      i = i + 1;
      continue;
    }
    let j: i32 = i;
    while (j < ty.len() && ident_byte(ty[j] as i32)) {
      j = j + 1;
    }
    let qualified: boolean = i > 0 && (ty[i - 1] == b'.' || ty[i - 1] == b':') || j < ty.len() && (ty[j] == b'.' || ty[j] == b':');
    if (j - i == 3 && !qualified && slice_unchecked(ty, i, j) == "str") {
      out = out + slice_unchecked(ty, start, i) + "string";
      start = j;
    }
    i = j;
  }
  if (start == 0) {
    return ty;
  }
  return out + slice_unchecked(ty, start, ty.len());
}

pub function receiver_base(receiver: string): string {
  return util.base_type_name(erase_view_spelling(receiver));
}

pub function decl_key(fd: FuncDecl): string {
  if (fd.receiver_type.len() == 0) {
    return fd.name;
  }
  return receiver_base(fd.receiver_type) + "." + fd.name;
}

pub function receiver_namespace(receiver: string): string {
  let r: TypeRef = parse_type_ref(receiver);
  if (r.array_depth > 0) {
    return "Array";
  }
  if (r.is_view) {
    return "slice";
  }
  return receiver_base(receiver);
}

function erase_view_list(tys: string[]): string[] {
  let out: string[] = [];
  for t in tys {
    out = out.append(erase_view_spelling(t));
  }
  return out;
}

function erase_view_params(ps: ast.ParamDecl[]): ast.ParamDecl[] {
  let out: ast.ParamDecl[] = [];
  for p in ps {
    out = out.append(ast.ParamDecl { ...p, type_name: erase_view_spelling(p.type_name), fn_ret: erase_view_spelling(p.fn_ret), fn_param_types: erase_view_spelling(p.fn_param_types) });
  }
  return out;
}

function erase_view_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprCall(c) => {
      return ast.ExprCall { ...c, type_args: erase_view_list(c.type_args), ty: erase_view_spelling(c.ty) };
    },
    ast.ExprArray(a) => {
      return ast.ExprArray { ...a, elem_ty: erase_view_spelling(a.elem_ty) };
    },
    ast.ExprStructLit(sl) => {
      return ast.ExprStructLit { ...sl, type_name: erase_view_spelling(sl.type_name), written: erase_view_spelling(sl.written) };
    },
    ast.ExprZero(z) => {
      return ast.ExprZero { ...z, type_name: erase_view_spelling(z.type_name) };
    },
    ast.ExprUnary(u) => {
      let op: string = u.op;
      if (op.len() > 3 && slice_unchecked(op, 0, 3) == "as ") {
        op = erase_view_spelling(op);
      }
      return ast.ExprUnary { ...u, op: op, ty: erase_view_spelling(u.ty) };
    },
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, params: erase_view_params(lm.params), ret_type: erase_view_spelling(lm.ret_type), ret_fn_ret: erase_view_spelling(lm.ret_fn_ret), ret_fn_param_types: erase_view_spelling(lm.ret_fn_param_types) };
    },
    ast.ExprIdent(id) => {
      return ast.ExprIdent { ...id, ty: erase_view_spelling(id.ty) };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { ...b, ty: erase_view_spelling(b.ty) };
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { ...ix, ty: erase_view_spelling(ix.ty) };
    },
    ast.ExprSlice(sl2) => {
      return ast.ExprSlice { ...sl2, ty: erase_view_spelling(sl2.ty) };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, ty: erase_view_spelling(fa.ty) };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function erase_view_stmt(st: ast.Stmt): ast.Stmt[] {
  if let ast.StmtVar(v) = st {
    return [ast.StmtVar { ...v, type_name: erase_view_spelling(v.type_name), fn_ret: erase_view_spelling(v.fn_ret), fn_param_types: erase_view_spelling(v.fn_param_types) }];
  }
  return [st];
}

function spells_view(ty: string): boolean {
  let i: i32 = 0;
  let n: i32 = ty.len();
  while (i < n) {
    let b: u8 = ty[i];
    if (b == b'[' && view_opens_at(ty, i)) {
      return true;
    }
    if (b == b's' && i + 2 < n && ty[i + 1] == b't' && ty[i + 2] == b'r'
      && (i == 0 || !ident_byte(ty[i - 1] as i32)) && (i + 3 == n || !ident_byte(ty[i + 3] as i32))) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function spells_view_any(tys: string[]): boolean {
  for t in tys {
    if (spells_view(t)) {
      return true;
    }
  }
  return false;
}

function spells_view_params(ps: ast.ParamDecl[]): boolean {
  for p in ps {
    if (spells_view(p.type_name) || spells_view(p.fn_ret) || spells_view(p.fn_param_types)) {
      return true;
    }
  }
  return false;
}

function spells_view_stmt(st: ast.Stmt, own found: boolean): boolean {
  if (found) {
    return true;
  }
  if let ast.StmtVar(v) = st {
    return spells_view(v.type_name) || spells_view(v.fn_ret) || spells_view(v.fn_param_types);
  }
  return false;
}

function spells_view_expr(e: ast.Expr, own found: boolean): boolean {
  if (found) {
    return true;
  }
  match (e) {
    ast.ExprCall(c) => {
      return spells_view_any(c.type_args) || spells_view(c.ty);
    },
    ast.ExprArray(a) => {
      return spells_view(a.elem_ty);
    },
    ast.ExprStructLit(sl) => {
      return spells_view(sl.type_name) || spells_view(sl.written);
    },
    ast.ExprZero(z) => {
      return spells_view(z.type_name);
    },
    ast.ExprUnary(u) => {
      return u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as " && spells_view(u.op) || spells_view(u.ty);
    },
    ast.ExprLambda(lm) => {
      return spells_view_params(lm.params) || spells_view(lm.ret_type) || spells_view(lm.ret_fn_ret) || spells_view(lm.ret_fn_param_types);
    },
    ast.ExprIdent(id) => {
      return spells_view(id.ty);
    },
    ast.ExprBinary(b) => {
      return spells_view(b.ty);
    },
    ast.ExprIndex(ix) => {
      return spells_view(ix.ty);
    },
    ast.ExprSlice(sl2) => {
      return spells_view(sl2.ty);
    },
    ast.ExprFieldAccess(fa) => {
      return spells_view(fa.ty);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function erase_view_body(body: ast.Stmt[]): ast.Stmt[] {
  let found: boolean = false;
  for st in body {
    found = astwalk.fold_stmt_nodes(st, found, spells_view_stmt, spells_view_expr, astwalk.descend_all);
  }
  if (!found) {
    return body;
  }
  return astwalk.splice_stmts(astwalk.map_stmts(body, erase_view_expr), erase_view_stmt);
}

function erase_view_funcs(fds: FuncDecl[]): FuncDecl[] {
  let out: FuncDecl[] = [];
  for fd in fds {
    out = out.append(FuncDecl { ...fd, receiver_type: erase_view_spelling(fd.receiver_type), params: erase_view_params(fd.params), ret_type: erase_view_spelling(fd.ret_type), ret_fn_ret: erase_view_spelling(fd.ret_fn_ret), ret_fn_param_types: erase_view_spelling(fd.ret_fn_param_types), body: erase_view_body(fd.body) });
  }
  return out;
}

pub function erase_view_structs(sds: StructDecl[]): StructDecl[] {
  let out: StructDecl[] = [];
  for sd in sds {
    out = out.append(erase_view_struct(sd));
  }
  return out;
}

function erase_view_struct(sd: StructDecl): StructDecl {
  let fields: StructFieldDecl[] = [];
  for f in sd.fields {
    fields = fields.append(StructFieldDecl { ...f, type_name: erase_view_spelling(f.type_name), fn_ret: erase_view_spelling(f.fn_ret), fn_param_types: erase_view_spelling(f.fn_param_types) });
  }
  return StructDecl { ...sd, fields: fields };
}

pub function erase_view_module(mod: Module): Module {
  let structs: StructDecl[] = erase_view_structs(mod.structs);
  let aliases: TypeAlias[] = [];
  for al in mod.aliases {
    aliases = aliases.append(TypeAlias { ...al, variants: erase_view_list(al.variants), variant_args: erase_view_list(al.variant_args) });
  }
  let impls: ImplInfo[] = [];
  for im in mod.impls {
    impls = impls.append(ImplInfo { ...im, impl_type: erase_view_spelling(im.impl_type), trait_spelling: erase_view_spelling(im.trait_spelling), trait_ref: erase_view_spelling(im.trait_ref), assoc_values: erase_view_list(im.assoc_values) });
  }
  let reqs: TraitReq[] = [];
  for tr in mod.trait_reqs {
    reqs = reqs.append(TraitReq { ...tr, req_sigs: erase_view_funcs(tr.req_sigs), assoc_sigs: erase_view_funcs(tr.assoc_sigs), default_sigs: erase_view_funcs(tr.default_sigs) });
  }
  let tdecls: TraitDecl[] = [];
  for td in mod.trait_decls {
    tdecls = tdecls.append(TraitDecl { ...td, methods: erase_view_funcs(td.methods) });
  }
  return Module { ...mod, funcs: erase_view_funcs(mod.funcs), structs: structs, aliases: aliases, top_stmts: erase_view_body(mod.top_stmts), impls: impls, trait_reqs: reqs, trait_decls: tdecls };
}

pub function module_with_builtins(mod: Module): Module {
  return erase_view_module(module_with_builtins_typed(mod));
}

pub function module_with_builtins_typed(mod: Module): Module {
  let mono: Module = monomorphize_all(register_struct_method_generics(register_map_method_generics(register_array_method_generics(lower_defers_prepass_module(hoist_local_funcs_module(desugar_prepass_module(mod)))))));
  return Module { ...mono, structs: inject_builtin_enums(mono.structs) };
}

function tvar_spelling(name: string): string {
  if (looks_type_var(name)) {
    return name;
  }
  return "0_" + name;
}

pub function desugar_trait_params(mod: Module, traits: string[], spelled: boolean): Module {
  if (traits.len() == 0) {
    return mod;
  }
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(desugar_fn_trait_params(fd, traits, spelled));
  }
  return Module { ...mod, funcs: funcs };
}

function desugar_fn_trait_params(fd: FuncDecl, traits: string[], spelled: boolean): FuncDecl {
  if (fd.impl_trait.len() > 0) {
    return fd;
  }
  let params: ast.ParamDecl[] = [];
  let type_params: string[] = fd.type_params;
  let bound_traits: string[] = fd.bound_traits;
  let all_type_params: string[] = fd.all_type_params;
  for p in fd.params {
    let tr: TypeRef = parse_type_ref(p.type_name);
    if (tr.array_depth > 0 || tr.is_tuple || tr.is_fn || tr.is_view || !str_list_contains(traits, tr.base) || str_list_contains(all_type_params, tr.base)) {
      params = params.append(p);
      continue;
    }
    let tp: string = fresh_trait_param("T_" + p.name, all_type_params, spelled);
    type_params = type_params.append(tp);
    bound_traits = bound_traits.append(p.type_name);
    all_type_params = all_type_params.append(tp);
    params = params.append(ast.ParamDecl { ...p, type_name: tp });
  }
  return FuncDecl { ...fd, params: params, type_params: type_params, bound_traits: bound_traits, all_type_params: all_type_params };
}

pub function is_platform_param(fd: FuncDecl, i: i32, qual: string): boolean {
  let t: string = fd.params[i].type_name;
  for name in ["Host", "Platform"] {
    if (t == "platform__" + name || t == "platform." + name || qual.len() > 0 && t == qual + "." + name) {
      return true;
    }
  }
  let k: i32 = util.index_of_str(fd.type_params, t);
  if (k < 0 || k >= fd.bound_traits.len()) {
    return false;
  }
  for b in split_plus_bounds(fd.bound_traits[k]) {
    if (trait_simple_name(b) == "Platform") {
      return true;
    }
  }
  return false;
}

pub function trait_simple_name(b: string): string {
  let base: string = util.base_type_name(b);
  let i: i32 = base.len();
  while (i > 0) {
    if (base[i - 1] == b'.') {
      return slice_unchecked(base, i, base.len()) + "";
    }
    if (i >= 2 && base[i - 1] == b'_' && base[i - 2] == b'_') {
      return slice_unchecked(base, i, base.len()) + "";
    }
    i = i - 1;
  }
  return base;
}

pub function trait_decl_names(traits: TraitDecl[]): string[] {
  let out: string[] = [];
  for t in traits {
    out = out.append(t.name);
  }
  return out;
}

function fresh_trait_param(want: string, taken: string[], spelled: boolean): string {
  let name: string = want;
  let n: i32 = 1;
  while (str_list_contains(taken, name) || str_list_contains(taken, "0_" + name)) {
    name = want + util.i32_to_string(n);
    n = n + 1;
  }
  if (spelled) {
    return "0_" + name;
  }
  return name;
}

function rename_type_vars_module(mod: Module): Module {
  return respell_type_vars_module(mod, false);
}

pub function written_type_vars_module(mod: Module): Module {
  return respell_type_vars_module(mod, true);
}

function respell_type_vars_module(mod: Module, written: boolean): Module {
  let mvals: string[] = module_value_names(mod);
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    let fvars: string[] = fn_type_vars(fd, mod, written);
    funcs = funcs.append(rename_fn_type_vars(fd, fvars, tvar_respellings(fvars, written), mvals));
  }
  let structs: StructDecl[] = [];
  for sd in mod.structs {
    let svars: string[] = sd.type_params;
    if (sd.enum_owner.len() > 0) {
      svars = decl_type_params(sd.enum_owner, mod);
    }
    structs = structs.append(rename_struct_type_vars(sd, svars, tvar_respellings(svars, written)));
  }
  let enums: EnumDecl[] = [];
  for ed in mod.enums {
    enums = enums.append(EnumDecl { ...ed, type_params: tvar_respellings(ed.type_params, written) });
  }
  let impls: ImplInfo[] = [];
  for im in mod.impls {
    let none: string[] = [];
    let ivars: string[] = add_tvars(add_tvars(none, im.all_type_params), im.type_params);
    impls = impls.append(rename_impl_type_vars(im, ivars, tvar_respellings(ivars, written)));
  }
  let traits: TraitDecl[] = [];
  for td in mod.trait_decls {
    let methods: FuncDecl[] = [];
    for m in td.methods {
      let mvars: string[] = add_tvars(fn_type_vars(m, mod, written), td.type_params);
      methods = methods.append(rename_fn_type_vars(m, mvars, tvar_respellings(mvars, written), mvals));
    }
    traits = traits.append(TraitDecl { ...td, type_params: tvar_respellings(td.type_params, written), methods: methods });
  }
  return Module { ...mod, funcs: funcs, structs: structs, enums: enums, impls: impls, trait_decls: traits };
}

function module_value_names(mod: Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    if (fd.receiver_type.len() == 0) {
      out = out.append(fd.name);
    }
  }
  for sd in mod.structs {
    out = out.append(sd.name);
  }
  for ed in mod.enums {
    out = out.append(ed.name);
  }
  for al in mod.aliases {
    out = out.append(al.name);
  }
  return out;
}

function tvar_respellings(vars: string[], written: boolean): string[] {
  let out: string[] = [];
  for v in vars {
    if (!written) {
      out = out.append(tvar_spelling(v));
    } else if (looks_type_var(v)) {
      out = out.append(slice_unchecked(v, 2, v.len()) + "");
    } else {
      out = out.append(v);
    }
  }
  return out;
}

function add_tvars(acc: string[], vars: string[]): string[] {
  let out: string[] = acc;
  for v in vars {
    if (!str_in(out, v)) {
      out = out.append(v);
    }
  }
  return out;
}

function decl_type_params(name: string, mod: Module): string[] {
  for ed in mod.enums {
    if (ed.name == name) {
      return ed.type_params;
    }
  }
  for sd in mod.structs {
    if (sd.name == name) {
      return sd.type_params;
    }
  }
  let none: string[] = [];
  return none;
}

function fn_type_vars(fd: FuncDecl, mod: Module, respelled: boolean): string[] {
  let none: string[] = [];
  let vars: string[] = [];
  for v in add_tvars(add_tvars(none, fd.all_type_params), fd.type_params) {
    if (!is_const_tparam(fd, v)) {
      vars = vars.append(v);
    }
  }
  if (fd.receiver_type.len() == 0) {
    return vars;
  }
  if (first_bracket(fd.receiver_type) < 0) {
    vars = add_tvars(vars, decl_type_params(fd.receiver_type, mod));
  }
  if (respelled) {
    return type_str_vars(fd.receiver_type, vars);
  }
  return add_tvars(vars, receiver_type_vars(parse_type_ref(fd.receiver_type), mod));
}

function receiver_type_vars(r: TypeRef, mod: Module): string[] {
  let out: string[] = [];
  if (r.args.len() == 0 && !r.is_tuple && !r.is_fn) {
    let leaf: string = r.base;
    let letter: boolean = leaf.len() == 1 && leaf[0] >= b'A' && leaf[0] <= b'Z';
    if (letter && !names_module_type(leaf, mod)) {
      out = out.append(leaf);
    }
    return out;
  }
  for a in r.args {
    out = add_tvars(out, receiver_type_vars(a, mod));
  }
  return out;
}

function names_module_type(name: string, mod: Module): boolean {
  for sd in mod.structs {
    if (sd.name == name) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == name) {
      return true;
    }
  }
  for al in mod.aliases {
    if (al.name == name) {
      return true;
    }
  }
  return false;
}

function rename_ty_list(list: string[], vars: string[], cts: string[]): string[] {
  let out: string[] = [];
  for t in list {
    out = out.append(subst_ty(t, vars, cts));
  }
  return out;
}

function rename_bounds(bounds: string[], vars: string[], cts: string[]): string[] {
  let out: string[] = [];
  for b in bounds {
    if (is_const_bound(b)) {
      out = out.append(b);
      continue;
    }
    let joined: string = "";
    for entry in split_plus_bounds(b) {
      if (joined.len() > 0) {
        joined = joined + "+";
      }
      joined = joined + subst_ty(entry, vars, cts);
    }
    out = out.append(joined);
  }
  return out;
}

function rename_param_type_vars(pd: ast.ParamDecl, vars: string[], cts: string[]): ast.ParamDecl {
  let dv: ast.Expr = pd.default_value;
  if (pd.has_default) {
    dv = astwalk.map_expr(dv, (e: ast.Expr): ast.Expr => rename_tv_expr(e, vars, cts));
  }
  return ast.ParamDecl { ...pd, type_name: subst_ty(pd.type_name, vars, cts), fn_ret: subst_ty(pd.fn_ret, vars, cts), fn_param_types: subst_ty_list(pd.fn_param_types, vars, cts), default_value: dv };
}

function rename_fn_type_vars(fd: FuncDecl, vars: string[], cts: string[], mvals: string[]): FuncDecl {
  if (vars.len() == 0) {
    return fd;
  }
  let values: string[] = [];
  for v in vars {
    if (str_in(mvals, v)) {
      values = values.append(v);
    }
  }
  if (fd.receiver_name.len() > 0) {
    values = values.append(fd.receiver_name);
  }
  for pd in fd.params {
    values = astwalk.append_bound_name(values, pd.name);
  }
  let sc: TvScope = TvScope { vars: vars, cts: cts, values: values, lits: false };
  let params: ast.ParamDecl[] = [];
  for pd in fd.params {
    let rp: ast.ParamDecl = rename_param_type_vars(pd, vars, cts);
    if (rp.has_default) {
      rp = ast.ParamDecl { ...rp, default_value: tv_obj_in(rp.default_value, sc) };
    }
    params = params.append(rp);
  }
  return FuncDecl {
    ...fd, receiver_type: subst_ty(fd.receiver_type, vars, cts), type_params: rename_ty_list(fd.type_params, vars, cts),
    all_type_params: rename_ty_list(fd.all_type_params, vars, cts), bound_traits: rename_bounds(fd.bound_traits, vars, cts), params: params,
    ret_type: subst_ty(fd.ret_type, vars, cts), ret_fn_ret: subst_ty(fd.ret_fn_ret, vars, cts), ret_fn_param_types: subst_ty_list(fd.ret_fn_param_types, vars, cts),
    body: tv_obj_body(rename_tv_stmts(fd.body, vars, cts), sc),
  };
}

function rename_struct_type_vars(sd: StructDecl, vars: string[], cts: string[]): StructDecl {
  if (vars.len() == 0) {
    return sd;
  }
  let fields: StructFieldDecl[] = [];
  for f in sd.fields {
    fields = fields.append(StructFieldDecl { ...f, type_name: subst_ty(f.type_name, vars, cts), fn_ret: subst_ty(f.fn_ret, vars, cts), fn_param_types: subst_ty_list(f.fn_param_types, vars, cts) });
  }
  return StructDecl { ...sd, fields: fields, type_params: rename_ty_list(sd.type_params, vars, cts) };
}

function rename_impl_type_vars(im: ImplInfo, vars: string[], cts: string[]): ImplInfo {
  if (vars.len() == 0) {
    return im;
  }
  return ImplInfo {
    ...im, impl_type: subst_ty(im.impl_type, vars, cts), type_params: rename_ty_list(im.type_params, vars, cts),
    all_type_params: rename_ty_list(im.all_type_params, vars, cts), bounds: rename_bounds(im.bounds, vars, cts),
    trait_ref: subst_ty(im.trait_ref, vars, cts), assoc_values: rename_ty_list(im.assoc_values, vars, cts),
  };
}

function rename_tv_stmts(stmts: ast.Stmt[], vars: string[], cts: string[]): ast.Stmt[] {
  return rename_tv_annots(astwalk.map_stmts(stmts, (e: ast.Expr): ast.Expr => rename_tv_expr(e, vars, cts)), vars, cts);
}

function rename_tv_expr(e: ast.Expr, vars: string[], cts: string[]): ast.Expr {
  match (e) {
    ast.ExprIdent(id) => {
      return ast.ExprIdent { ...id, ty: subst_ty(id.ty, vars, cts) };
    },
    ast.ExprCall(c) => {
      return ast.ExprCall { ...c, type_args: rename_ty_list(c.type_args, vars, cts), ty: subst_ty(c.ty, vars, cts) };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { ...b, ty: subst_ty(b.ty, vars, cts) };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { ...u, ty: subst_ty(u.ty, vars, cts) };
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { ...ix, ty: subst_ty(ix.ty, vars, cts) };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, ty: subst_ty(sl.ty, vars, cts) };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, ty: subst_ty(fa.ty, vars, cts) };
    },
    ast.ExprArray(ar) => {
      return ast.ExprArray { ...ar, elem_ty: subst_ty(ar.elem_ty, vars, cts) };
    },
    ast.ExprZero(z) => {
      return ast.ExprZero { ...z, type_name: subst_ty(z.type_name, vars, cts) };
    },
    ast.ExprStructLit(sl) => {
      return ast.ExprStructLit { ...sl, type_name: subst_ty(sl.type_name, vars, cts), written: subst_ty(sl.written, vars, cts) };
    },
    ast.ExprLambda(lm) => {
      let lps: ast.ParamDecl[] = [];
      for lpd in lm.params {
        lps = lps.append(rename_param_type_vars(lpd, vars, cts));
      }
      return ast.ExprLambda {
        ...lm, params: lps, ret_type: subst_ty(lm.ret_type, vars, cts), ret_fn_ret: subst_ty(lm.ret_fn_ret, vars, cts),
        ret_fn_param_types: subst_ty_list(lm.ret_fn_param_types, vars, cts), body: rename_tv_annots(lm.body, vars, cts),
      };
    },
    _ => {
      return e;
    }
  }
  return e;
}

struct TvScope { vars: string[], cts: string[], values: string[], lits: boolean }

function tv_shadow(sc: TvScope, names: string[]): TvScope {
  let values: string[] = sc.values;
  for n in names {
    values = values.append(n);
  }
  return TvScope { ...sc, values: values };
}

function tv_obj_body(stmts: ast.Stmt[], sc: TvScope): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur: TvScope = sc;
  for st in stmts {
    let (ns, na, nh) = astwalk.map_stmt_acc(st, cur, tv_obj_stmt, tv_obj_expr);
    out = out.append(ns);
    if let ast.StmtVar(v) = st {
      cur = tv_shadow(cur, astwalk.append_bound_name([], v.name));
    }
  }
  return out;
}

function tv_obj_in(e: ast.Expr, sc: TvScope): ast.Expr {
  let (out, a, h) = astwalk.map_expr_acc(e, sc, tv_obj_stmt, tv_obj_expr);
  return out;
}

function tv_obj_ident(e: ast.Expr, sc: TvScope): ast.Expr {
  if let ast.ExprIdent(id) = e {
    let k: i32 = tp_index(id.name, sc.vars);
    if (k >= 0 && !str_in(sc.values, id.name) && sc.lits) {
      return ast.ExprNumber { text: sc.cts[k], suffix: "", raw: "", is_float: false, line: id.line, col: id.col };
    }
    if (k >= 0 && !str_in(sc.values, id.name)) {
      return ast.ExprIdent { ...id, name: sc.cts[k] };
    }
  }
  return e;
}

function tv_obj_expr(e: ast.Expr, sc: TvScope): (ast.Expr, TvScope, boolean) {
  match (e) {
    ast.ExprIdent(_) => {
      if (sc.lits) {
        return (tv_obj_ident(e, sc), sc, true);
      }
      return (e, sc, false);
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(_) = fa.obj {
        return (ast.ExprFieldAccess { ...fa, obj: tv_obj_ident(fa.obj, sc) }, sc, true);
      }
      return (e, sc, false);
    },
    ast.ExprIndex(ix) => {
      if let ast.ExprIdent(_) = ix.index {
        return (ast.ExprIndex { ...ix, array: tv_obj_in(ix.array, sc), index: tv_obj_ident(ix.index, sc) }, sc, true);
      }
      return (e, sc, false);
    },
    ast.ExprLambda(lm) => {
      let names: string[] = [];
      for lp in lm.params {
        names = astwalk.append_bound_name(names, lp.name);
      }
      return (ast.ExprLambda { ...lm, body: tv_obj_body(lm.body, tv_shadow(sc, names)) }, sc, true);
    },
    _ => {
      return (e, sc, false);
    }
  }
  return (e, sc, false);
}

function tv_obj_stmt(st: ast.Stmt, sc: TvScope): (ast.Stmt, TvScope, boolean) {
  match (st) {
    ast.StmtIf(f) => {
      return (ast.StmtIf { ...f, cond: tv_obj_in(f.cond, sc), then_body: tv_obj_body(f.then_body, sc), else_body: tv_obj_body(f.else_body, sc) }, sc, true);
    },
    ast.StmtWhile(w) => {
      return (ast.StmtWhile { ...w, cond: tv_obj_in(w.cond, sc), body: tv_obj_body(w.body, sc) }, sc, true);
    },
    ast.StmtFor(fo) => {
      return (ast.StmtFor { ...fo, iter: tv_obj_in(fo.iter, sc), body: tv_obj_body(fo.body, tv_shadow(sc, astwalk.append_bound_name([], fo.var_name))) }, sc, true);
    },
    ast.StmtMatch(mt) => {
      let arms: ast.MatchArm[] = [];
      for arm in mt.arms {
        let asc: TvScope = tv_shadow(sc, astwalk.pattern_binders(arm.pattern, []));
        let g: ast.Expr = arm.guard;
        if (arm.has_guard) {
          g = tv_obj_in(arm.guard, asc);
        }
        arms = arms.append(ast.MatchArm { ...arm, guard: g, body: tv_obj_body(arm.body, asc) });
      }
      return (ast.StmtMatch { ...mt, scrutinee: tv_obj_in(mt.scrutinee, sc), arms: arms }, sc, true);
    },
    _ => {
      return (st, sc, false);
    }
  }
  return (st, sc, false);
}

function rename_tv_annots(stmts: ast.Stmt[], vars: string[], cts: string[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in stmts {
    out = out.append(rename_tv_annot(st, vars, cts));
  }
  return out;
}

function rename_tv_annot(st: ast.Stmt, vars: string[], cts: string[]): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      if (is_destr_marker(v.type_name)) {
        return st;
      }
      return ast.StmtVar { ...v, type_name: subst_ty(v.type_name, vars, cts), fn_ret: subst_ty(v.fn_ret, vars, cts), fn_param_types: subst_ty_list(v.fn_param_types, vars, cts) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, then_body: rename_tv_annots(f.then_body, vars, cts), else_body: rename_tv_annots(f.else_body, vars, cts) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, body: rename_tv_annots(w.body, vars, cts) };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { ...fo, body: rename_tv_annots(fo.body, vars, cts) };
    },
    ast.StmtMatch(mt) => {
      let arms: ast.MatchArm[] = [];
      for arm in mt.arms {
        arms = arms.append(ast.MatchArm { ...arm, body: rename_tv_annots(arm.body, vars, cts) });
      }
      return ast.StmtMatch { ...mt, arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: rename_tv_annot(d.action, vars, cts) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

pub struct TraitDefault { trait_name: string, trait_params: string[], method: FuncDecl }

pub struct ImplInfo { trait_name: string, impl_type: string, type_params: string[], all_type_params: string[], bounds: string[], method_names: string[], trait_spelling: string, trait_ref: string, assoc_names: string[], assoc_values: string[], trait_module: string, module: string, line: i32, col: i32 }

pub function impl_trait_key(im: ImplInfo): string {
  if (im.trait_module.len() == 0) {
    return im.trait_name;
  }
  return im.trait_module + "." + im.trait_name;
}

struct MethodClaim { fn: FuncDecl, keys: string[], traits: string[] }

function claim_method_name(fd0: FuncDecl, tname: string, keys: string[], traits: string[]): MethodClaim {
  if (fd0.receiver_type.len() == 0) {
    return MethodClaim { fn: fd0, keys: keys, traits: traits };
  }
  let fd: FuncDecl = FuncDecl { ...fd0, impl_trait: tname };
  let base: string = util.base_type_name(fd.receiver_type);
  let key: string = base + "." + fd.name;
  let at: i32 = util.index_of_str(keys, key);
  if (at < 0) {
    return MethodClaim { fn: fd, keys: keys.append(key), traits: traits.append(tname) };
  }
  if (tname.len() == 0 || traits[at] == tname) {
    return MethodClaim { fn: fd, keys: keys, traits: traits };
  }
  let renamed: string = tname + "." + fd.name;
  let rkey: string = base + "." + renamed;
  if (util.index_of_str(keys, rkey) >= 0) {
    return MethodClaim { fn: fd, keys: keys, traits: traits };
  }
  let renamed_fd: FuncDecl = FuncDecl { ...fd, name: renamed };
  return MethodClaim { fn: renamed_fd, keys: keys.append(rkey), traits: traits.append(tname) };
}

pub function resolve_dyn_traits(mod: Module): Module {
  let bases: string[] = [];
  let served: string[][] = [];
  for fd in mod.funcs {
    let own: string[] = [];
    let base: string = "";
    if (fd.receiver_type.len() > 0 && !ends_with_array_brackets(fd.receiver_type)) {
      base = receiver_base(fd.receiver_type);
      if (fd.impl_trait.len() > 0) {
        own = own.append(fd.impl_trait);
      }
    }
    bases = bases.append(base);
    served = served.append(own);
  }
  let ix: util.NameIndex = util.name_index(bases);
  for im in mod.impls {
    if (im.trait_name.len() > 0 && !ends_with_array_brackets(im.impl_type)) {
      let bn: string = receiver_base(im.impl_type);
      for ri in trait_closure(mod.trait_reqs, im.trait_name, im.trait_module) {
        let req: TraitReq = mod.trait_reqs[ri];
        for m in req.provided {
          let at: i32 = answering_method(mod.funcs, ix, bn, m, req.trait_name);
          if (at >= 0 && !str_list_contains(served[at], im.trait_name)) {
            served = served.with(at, served[at].append(im.trait_name));
          }
        }
      }
    }
  }
  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (fd.dyn_traits.len() > 0 || served[i].len() > 0) {
      fd = FuncDecl { ...fd, dyn_traits: served[i], streams: [] };
    }
    out = out.append(fd);
    i = i + 1;
  }
  return Module { ...mod, funcs: out };
}

function ends_with_array_brackets(t: string): boolean {
  let n: i32 = t.len();
  return n >= 2 && slice_unchecked(t, n - 2, n) == "[]";
}

function answering_method(funcs: FuncDecl[], ix: util.NameIndex, bn: string, m: string, tn: string): i32 {
  let inherent: i32 = 0 - 1;
  let i: i32 = ix.chain(bn);
  while (i >= 0) {
    if (ix.names[i] == bn && derive_simple_name(funcs[i].name) == m) {
      if (funcs[i].impl_trait == tn) {
        return i;
      }
      if (funcs[i].impl_trait.len() == 0 && inherent < 0) {
        inherent = i;
      }
    }
    i = ix.next[i];
  }
  return inherent;
}

function trait_closure(reqs: TraitReq[], tn: string, module: string): i32[] {
  let out: i32[] = [];
  let first: i32 = trait_req_index(reqs, tn, module);
  if (first >= 0) {
    out = out.append(first);
  }
  let k: i32 = 0;
  while (k < out.len()) {
    let r: TraitReq = reqs[out[k]];
    for sup in r.supertraits {
      let at: i32 = trait_req_index(reqs, util.base_type_name(sup), r.module);
      if (at >= 0 && util.index_of_i32(out, at) < 0) {
        out = out.append(at);
      }
    }
    k = k + 1;
  }
  return out;
}

function trait_req_index(reqs: TraitReq[], tn: string, module: string): i32 {
  let any: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < reqs.len()) {
    if (reqs[i].trait_name == tn) {
      if (reqs[i].module == module) {
        return i;
      }
      if (any < 0) {
        any = i;
      }
    }
    i = i + 1;
  }
  return any;
}

pub function dyn_trait_set(ty: string): string[] {
  let out: string[] = [];
  if (ty.len() <= 4 || slice_unchecked(ty, 0, 4) != "dyn ") {
    return out;
  }
  for piece in split_plus_bounds(slice_unchecked(ty, 4, ty.len()) + "") {
    let part: string = util.trim(piece);
    if (part.len() > 0) {
      out = out.append(part);
    }
  }
  return out;
}

pub function dyn_arm_matches(fd: FuncDecl, traits: string[], method: string): boolean {
  return fd.receiver_name.len() > 0 && answers_traits(fd, traits, method);
}

function answers_traits(fd: FuncDecl, traits: string[], method: string): boolean {
  if (traits.len() == 0) {
    return fd.name == method;
  }
  if (derive_simple_name(fd.name) != method) {
    return false;
  }
  for t in traits {
    if (str_list_contains(fd.dyn_traits, derive_simple_name(util.base_type_name(t)))) {
      return true;
    }
  }
  return false;
}

pub function dyn_provider_name(funcs: FuncDecl[], recv_type: string, traits: string[], method: string): string {
  return trait_provider_name(funcs, recv_type, traits, method, true);
}

function trait_provider_name(funcs: FuncDecl[], recv_type: string, traits: string[], method: string, receiver: boolean): string {
  let at: i32 = trait_provider_index(funcs, recv_type, traits, method, receiver);
  if (at < 0) {
    return method;
  }
  return funcs[at].name;
}

function trait_provider_index(funcs: FuncDecl[], recv_type: string, traits: string[], method: string, receiver: boolean): i32 {
  if (recv_type.len() == 0) {
    return -1;
  }
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: FuncDecl = funcs[i];
    if (util.base_type_name(fd.receiver_type) == recv_type
      && fd.receiver_name.len() > 0 == receiver
      && answers_traits(fd, traits, method)) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

pub function route_inherited_defaults(mod: Module): Module {
  let funcs: FuncDecl[] = mod.funcs;
  let mf: MFns = MFns { ...mfns_of(mod.funcs, mod.structs, mod.enums, mod.impls), keep_vars: true };
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: FuncDecl = funcs[i];
    if (fd.impl_trait.len() > 0 && is_inherited_default(mod.impls, mod.trait_reqs, fd)) {
      let base: string = util.base_type_name(fd.receiver_type);
      let ctx: BoundUse = BoundUse { env: env_from_decl(fd), funcs: mf, ord: [], eq: [], routed: [fd.receiver_type], bases: [base], traits: [[fd.impl_trait]], by_trait: false };
      let (body, after) = bc_body(fd.body, ctx);
      funcs = funcs.with(i, FuncDecl { ...fd, body: body });
    }
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs };
}

pub function is_inherited_default(impls: ImplInfo[], reqs: TraitReq[], fd: FuncDecl): boolean {
  let base: string = util.base_type_name(fd.receiver_type);
  let name: string = derive_simple_name(fd.name);
  for im in impls {
    if (im.trait_name == fd.impl_trait && util.base_type_name(im.impl_type) == base) {
      if (str_list_contains(im.method_names, name)) {
        return false;
      }
      for tr in reqs {
        if (tr.trait_name == fd.impl_trait) {
          for ds in tr.default_sigs {
            if (ds.name == name) {
              return true;
            }
          }
        }
      }
      return false;
    }
  }
  return false;
}

function str_list_contains(xs: string[], want: string): boolean {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == want) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function derive_simple_name(name: string): string {
  let last_dot: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < name.len()) {
    if (name[i] == b'.') {
      last_dot = i;
    }
    i = i + 1;
  }
  if (last_dot >= 0) {
    return slice_unchecked(name, last_dot + 1, name.len()) + "";
  }
  return name;
}

function dv_self_field(f: string): ast.Expr {
  return e_field_access(e_ident("self"), f);
}

function dv_other_field(f: string): ast.Expr {
  return e_field_access(e_ident("other"), f);
}

function dv_call0(recv: ast.Expr, m: string): ast.Expr {
  let noargs: ast.Expr[] = [];
  return e_call(e_field_access(recv, m), noargs);
}

function dv_call1(recv: ast.Expr, m: string, arg: ast.Expr): ast.Expr {
  let args: ast.Expr[] = [arg];
  return e_call(e_field_access(recv, m), args);
}

function synth_struct_display(sd: StructDecl): FuncDecl {
  let expr: ast.Expr = e_string(sd.name + " {");
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let sep: string = " ";
    if (i > 0) {
      sep = ", ";
    }
    expr = e_binary("+", expr, e_string(sep + sd.fields[i].name + ": "));
    expr = e_binary("+", expr, dv_call0(dv_self_field(sd.fields[i].name), "to_string"));
    i = i + 1;
  }
  if (sd.fields.len() == 0) {
    expr = e_binary("+", expr, e_string("}"));
  } else {
    expr = e_binary("+", expr, e_string(" }"));
  }
  let body: ast.Stmt[] = [s_return(expr)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "to_string", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Display", dyn_traits: [], streams: [] };
}

function dv_is_debug_scalar(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64"
    || t == "f32" || t == "f64" || t == "boolean";
}

function dv_debug_render(value: ast.Expr, t: string): ast.Expr {
  if (t == "string") {
    return e_binary("+", e_binary("+", e_string("\""), value), e_string("\""));
  }
  if (dv_is_debug_scalar(t)) {
    return dv_call0(value, "to_string");
  }
  return dv_call0(value, "to_debug");
}

function synth_struct_debug(sd: StructDecl): FuncDecl {
  let expr: ast.Expr = e_string(sd.name + " {");
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let sep: string = " ";
    if (i > 0) {
      sep = ", ";
    }
    expr = e_binary("+", expr, e_string(sep + sd.fields[i].name + ": "));
    expr = e_binary("+", expr, dv_debug_render(dv_self_field(sd.fields[i].name), sd.fields[i].type_name));
    i = i + 1;
  }
  if (sd.fields.len() == 0) {
    expr = e_binary("+", expr, e_string("}"));
  } else {
    expr = e_binary("+", expr, e_string(" }"));
  }
  let body: ast.Stmt[] = [s_return(expr)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "to_debug", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Debug", dyn_traits: [], streams: [] };
}

function synth_struct_eq(sd: StructDecl): FuncDecl {
  let expr: ast.Expr = e_bool(true);
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let cm: ast.Expr = dv_eq_expr(sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dv_other_field(sd.fields[i].name));
    if (i == 0) {
      expr = cm;
    } else {
      expr = e_binary("&&", expr, cm);
    }
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_return(expr)];
  let notp: string[] = [];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "other", type_name: sd.name, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
  return FuncDecl { stdlib: "", no_inline: false, name: "eq", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: params, ret_type: "boolean", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Eq", dyn_traits: [], streams: [] };
}

function synth_struct_ord(sd: StructDecl): FuncDecl {
  let stmts: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let vn: string = "__c" + dl_itoa(i);
    let cs: ast.Stmt[] = dv_cmp_stmts(vn, sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dv_other_field(sd.fields[i].name));
    let k: i32 = 0;
    while (k < cs.len()) {
      stmts = stmts.append(cs[k]);
      k = k + 1;
    }
    let cond: ast.Expr = e_binary("!=", e_ident(vn), e_number("0", "", false));
    let thenb: ast.Stmt[] = [s_return(e_ident(vn))];
    let elseb: ast.Stmt[] = [];
    stmts = stmts.append(s_if(cond, thenb, elseb));
    i = i + 1;
  }
  stmts = stmts.append(s_return(e_number("0", "", false)));
  let notp: string[] = [];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "other", type_name: sd.name, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
