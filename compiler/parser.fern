function e_struct_lit(type_name: string, field_names: string[], field_lines: i32[], field_cols: i32[], field_values: ast.Expr[], line: i32, col: i32): ast.Expr {
  return ast.ExprStructLit { type_name: type_name, field_names: field_names, field_lines: field_lines, field_cols: field_cols, field_values: field_values, has_base: false, base: e_unknown("no-base"), line: line, col: col, written: "" };
}

function e_struct_update(type_name: string, field_names: string[], field_lines: i32[], field_cols: i32[], field_values: ast.Expr[], base: ast.Expr, line: i32, col: i32): ast.Expr {
