      // `{`, so struct-literal parsing must be suppressed while reading
      // it (native sets p.noStructLit here) — otherwise a bare-ident
      // source whose then-block starts with `}`, `...`, or `IDENT :`
      // (e.g. a labeled loop) is swallowed as `ident { … }` (#4339
      // item 4). Same save/restore shape as the for-in iterable.
      let il_saved: boolean = p.no_struct;
      let (ilscrut_expr, ilscrut_p) = parse_expr(p.with_no_struct(true));
      p = ilscrut_p.with_no_struct(il_saved);
      let (ilthen_body, ilthen_p) = parse_block_or_stmt(p);
      p = ilthen_p;
      let ilelse: ast.Stmt[] = [];
      if (p.peek_keyword() == "else") {
        p = p.advance();
        let (ileb_body, ileb_p) = parse_block_or_stmt(p);
        p = ileb_p;
        ilelse = ileb_body;
      }
      let ilarms: ast.MatchArm[] = [];
      let ilwritten: ast.MatchArm[] = [];
      let ilpi: i32 = 0;
      while (ilpi < ilpats.len()) {
        ilwritten = ilwritten.append(ast.MatchArm { pattern: ilpats[ilpi], body: ilthen_body, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
        let (fi_pat, fi_g, fi_hg) = fold_lit_cond(ilpats[ilpi], e_bool(true), false);
        ilarms = ilarms.append(ast.MatchArm { pattern: fi_pat, body: ilthen_body, line: 0, col: 0, guard: fi_g, has_guard: fi_hg, alt_cont: false });
        ilpi = ilpi + 1;
      }
      let ilwild: ast.MatchArm = ast.MatchArm { pattern: p_wildcard(), body: ilelse, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false };
      ilarms = ilarms.append(ilwild);
      ilwritten = ilwritten.append(ilwild);
      // A nested head (`if let Some(Ok(n)) = e`) flattens the same way a
      // match arm does; the wildcard arm above is the outer fallthrough
      // desugar_nested_arms copies into the inner match, so a payload
      // matching no inner pattern runs the else rather than falling off
      // a non-exhaustive inner match.
      // A head with payload sub-patterns takes the flag chain, so a
      // multi-slot head (`if let P(Ok2(a), Ok2(b)) = v`) and an
      // or-pattern whose alternatives nest both work; the merge read
      // only the first slot. The origin tag keeps `-fmt` reprinting the
      // `if let` rather than the chain.
      if (arms_take_flag_chain(ilarms)) {
        return (with_sugar_origin(build_nested_arm_match(ilscrut_expr, ilarms, ilwritten, il_line, il_col), "if_let"), p);
      }
      ilarms = desugar_nested_arms(ilarms, 0, "");
      let ilsugar: ast.MatchArm[] = [];
      if (arms_have_written_form(ilwritten)) {
        ilsugar = ilwritten;
      }
      return (s_match_origin_sugared(ilscrut_expr, ilarms, ilsugar, il_line, il_col, "if_let"), p);
    }
    if (p.peek_punct() != "(") {
      return (s_unknown(p, "missing ( in if"), p);
    }
    p = p.advance();
    let (c_expr, c_p) = parse_expr(p);
    p = c_p;
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
    let (then_blk_body, then_blk_p) = parse_block_or_stmt(p);
    p = then_blk_p;
    let else_body: ast.Stmt[] = [];
    // Whether the else was WRITTEN as a chain. `else if` and
    // `else { if … }` produce the same one-element else_body, so the
    // printer cannot tell them apart without this (#6779).
    let else_chained: boolean = false;
    if (p.peek_keyword() == "else") {
      p = p.advance();
      // `else if` — wrap as a nested StmtIf in the else
      // branch so an else-chain reads as one shape.
      if (p.peek_keyword() == "if") {
        let (nested_stmt, nested_p) = parse_stmt(p);
        p = nested_p;
        else_body = else_body.append(nested_stmt);
        else_chained = true;
      } else {
        let (else_blk_body, else_blk_p) = parse_block_or_stmt(p);
        p = else_blk_p;
        else_body = else_blk_body;
      }
    }
    return (s_if_chained(c_expr, then_blk_body, else_body, else_chained), p);
  }
  if (kw == "while") {
    p = p.advance();
    if (p.peek_punct() != "(") {
      return (s_unknown(p, "missing ( in while"), p);
    }
    p = p.advance();
    let (wc_expr, wc_p) = parse_expr(p);
    p = wc_p;
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
    let (wb_body, wb_p) = parse_block_or_stmt(p);
    p = wb_p;
    return (with_loop_label(s_while(wc_expr, wb_body), loop_label), p);
  }
  if (kw == "loop") {
    let (lr_stmt, lr_p) = parse_loop_stmt(p);
    return (with_loop_label(lr_stmt, loop_label), lr_p);
  }
  if (kw == "for") {
    let (fr0_stmt, fr0_p) = parse_for_stmt(p);
    return (with_loop_label(fr0_stmt, loop_label), fr0_p);
  }
  // `let` introduces every binding: a plain name, a tuple or struct
  // destructure, or the refutable `let Pat(..) = E else { .. }`
  // (let-else), which desugars the rest of the enclosing block into
  // the success arm of a statement-match.
  if (kw == "let") {
    let vline: i32 = p.peek_line();
    let vcol: i32 = p.peek_col();
    p = p.advance();
    // `w @ <pattern>` names the whole value beside the pattern, the same
    // binding a destructured parameter takes. Consumed here so the tuple
    // and struct heads below read exactly as they do without one; a
    // REFUTABLE head past the `@` is not claimed by at_pattern_head and
    // stays with the let-else path, where the miss has somewhere to go.
    let at_bind: string = "";
    if (p.peek_punct_at(1) == "@" && at_pattern_head(p)) {
      at_bind = p.peek_ident();
      p = p.advance();
      p = p.advance();
    }
    // `let (x, y, …) = E` / `let (x, y, …) = E` — tuple destructuring of
    // ANY arity. The names are encoded comma-joined ("x,y,z"); the emitter
    // splits them and binds from the tuple's element slots.
    if (p.peek_punct() == "(") {
      let (tdnames, tdcount, tdok, tdp) = parse_destructure_names(p);
      p = tdp;
      if (!tdok || tdcount < 2) {
        return (s_unknown(p, "a tuple destructuring pattern binds names, not literals"), p);
      }
      if (p.peek_punct() == "=") {
        p = p.advance();
      }
      let (tdinit_expr, tdinit_p) = parse_expr(p);
      p = tdinit_p;
      if (p.peek_punct() == ";") {
        p = p.advance();
      }
      return (s_var_at(tdnames, destr_marker(at_bind, false, ""), tdinit_expr, vline, vcol), p);
    }
    // `let 3 = n else { … };` — a LITERAL or RANGE head, including
    // `|` alternatives (`let 1 | 2 = n else …`). A binding needs a name,
    // so a literal here is unambiguously a let-else pattern; it still
    // parses speculatively, because only the `else` past the initializer
    // makes it one, and without it the head must reach the
    // missing-var-name error below rather than a half-consumed cursor.
    //
    // Same shape as the variant-pattern let-else: the rest of the
    // enclosing block is the success arm, so the `else` block is the only
    // other arm, and build_literal_match lowers the pair.
    if (p.peek_is_pat_literal() || p.peek_at_literal()) {
      let (lel_at, lel_atp) = take_at_binding(p);
      let (lel_lits, lel_his, lel_hrs, lel_incs, lel_p) = parse_lit_alts(lel_atp);
      if (lel_p.peek_punct() == "=") {
        lel_p = lel_p.advance();
        let (lel_init, lel_ip) = parse_expr(lel_p);
        lel_p = lel_ip;
        if (lel_p.peek_keyword() == "else") {
          p = lel_p.advance();  // consume `else`
          let (lel_else, lel_ep) = parse_block(p);
          p = lel_ep;
          if (p.peek_punct() == ";") {
            p = p.advance();
          }
          let lel_rest: ast.Stmt[] = [];
          while (p.peek_punct() != "}" && !p.at_end()) {
            let (lel_rs, lel_rp) = parse_stmt(p);
            if (lel_rp.pos == p.pos) {
              p = p.advance();
              continue;
            }
            p = lel_rp;
            lel_rest = lel_rest.append(lel_rs);
          }
          let lel_arms: ast.LitArm[] = [];
          let lel_i: i32 = 0;
          while (lel_i < lel_lits.len()) {
            lel_arms = lel_arms.append(ast.LitArm { is_wild: false, lit: lel_lits[lel_i], guard: e_bool(true), has_guard: false, body: lel_rest, line: vline, col: vcol, range_hi: lel_his[lel_i], has_range: lel_hrs[lel_i], range_inclusive: lel_incs[lel_i], alt_cont: lel_i > 0, at_binding: lel_at });
            lel_i = lel_i + 1;
          }
          lel_arms = lel_arms.append(ast.LitArm { is_wild: true, lit: e_bool(true), guard: e_bool(true), has_guard: false, body: lel_else, line: vline, col: vcol, range_hi: e_bool(true), has_range: false, range_inclusive: false, alt_cont: false, at_binding: "" });
          return (with_sugar_origin(build_literal_match(lel_init, lel_arms, vline, vcol), "let_else"), p);
        }
      }
    }
    let name: string = p.peek_ident();
    if (name.len() == 0) {
      return (s_unknown(p, "missing binding name"), p);
    }
    // The cursor still ON the head, for the let-else pattern parse below —
    // parse_pattern wants to read the name itself.
    let le_pat_start: Par = p;
    p = p.advance();
    // Struct destructure `let Point { x, y } = E;` / `let Point { … } = E;`
    // — `name` is the struct type, the `{` opens the field pattern. A
    // record-form variant is spelled the same way here, but native rejects
    // `let Rect { w, h } = E else …` at parse time, so it stays a struct
    // destructure (and the same rejection) rather than becoming self-host-
    // only surface. `if let` accepts the record form on both, via
    // parse_pattern.
    if (p.peek_punct() == "{") {
      return parse_struct_destructure(p, name, at_bind, vline, vcol);
    }
    // `let PAT = E else { … }` with a pattern-shaped head takes the shared
    // grammar: parse_pattern gives it nested payloads, `@` bindings and
    // or-patterns, the same forms `if let` and the match arms accept.
    //
    // A head spelled `NAME(`, `NAME@`, `NAME|` or `NAME.` (a qualified
    // variant, `Color.Red(n)`) is never a plain binding, but only an
    // `else` makes it a let-else, and that keyword sits past the
    // initializer. Par is a value, so the whole head is parsed
    // speculatively and thrown away when no `else` follows, leaving the
    // original cursor to the paths below.
    if (p.peek_punct() == "(" || p.peek_punct() == "@" || p.peek_punct() == "|" || p.at_path_sep()) {
      let (lsp_pat, lsp_p) = parse_pattern(le_pat_start);
      let lsp_pats: ast.Pattern[] = [lsp_pat];
      while (lsp_p.peek_punct() == "|") {
        lsp_p = lsp_p.advance();
        let (lsp_alt, lsp_ap) = parse_pattern(lsp_p);
        lsp_p = lsp_ap;
        lsp_pats = lsp_pats.append(lsp_alt);
      }
      if (lsp_p.peek_punct() == "=") {
        lsp_p = lsp_p.advance();
        let (lsp_init, lsp_ip) = parse_expr(lsp_p);
        lsp_p = lsp_ip;
        if (lsp_p.peek_keyword() == "else") {
          p = lsp_p.advance();  // consume `else`
          let (lsp_else, lsp_ep) = parse_block(p);
          p = lsp_ep;
          if (p.peek_punct() == ";") {
            p = p.advance();
          }
          // The rest of the enclosing block is the success arm, so
          // the bindings stay live for it — see the note on the
          // single-binding path below.
          let lsp_rest: ast.Stmt[] = [];
          while (p.peek_punct() != "}" && !p.at_end()) {
            let (lsp_rs, lsp_rp) = parse_stmt(p);
            if (lsp_rp.pos == p.pos) {
              p = p.advance();
              continue;
            }
            p = lsp_rp;
            lsp_rest = lsp_rest.append(lsp_rs);
          }
          let lsp_arms: ast.MatchArm[] = [];
          let lsp_written: ast.MatchArm[] = [];
          let lsp_i: i32 = 0;
          while (lsp_i < lsp_pats.len()) {
            lsp_written = lsp_written.append(ast.MatchArm { pattern: lsp_pats[lsp_i], body: lsp_rest, line: vline, col: vcol, guard: e_bool(true), has_guard: false, alt_cont: lsp_i > 0 });
            let (fl_pat, fl_g, fl_hg) = fold_lit_cond(lsp_pats[lsp_i], e_bool(true), false);
            lsp_arms = lsp_arms.append(ast.MatchArm { pattern: fl_pat, body: lsp_rest, line: vline, col: vcol, guard: fl_g, has_guard: fl_hg, alt_cont: false });
            lsp_i = lsp_i + 1;
          }
          let lsp_wild: ast.MatchArm = ast.MatchArm { pattern: p_wildcard(), body: lsp_else, line: vline, col: vcol, guard: e_bool(true), has_guard: false, alt_cont: false };
          lsp_arms = lsp_arms.append(lsp_wild);
          lsp_written = lsp_written.append(lsp_wild);
          // A head with payload sub-patterns takes the flag chain —
          // see the `if let` site. The success arm is the rest of the
          // enclosing block either way, so the bindings stay live for
          // it.
          if (arms_take_flag_chain(lsp_arms)) {
            return (with_sugar_origin(build_nested_arm_match(lsp_init, lsp_arms, lsp_written, vline, vcol), "let_else"), p);
          }
          lsp_arms = desugar_nested_arms(lsp_arms, 0, "");
          // A nested payload (`let Wrap(A(v)) = w else …`) leaves the
          // synthesised `__nest` temp as the arm's only pattern, so
          // without the written form `-fmt` wrote that name into the
          // user's source — the #7059 fault, at the site it had not
          // reached yet.
          let lsp_sugar: ast.MatchArm[] = [];
          if (arms_have_written_form(lsp_written)) {
            lsp_sugar = lsp_written;
          }
          return (s_match_origin_sugared(lsp_init, lsp_arms, lsp_sugar, vline, vcol, "let_else"), p);
        }
      }
    }
    // let-else payload bindings: `let Variant(b1, b2, …) = E else { … }`.
    // The first binding is `le_binding`; any further ones go to
    // `le_extra` (matching parse_pattern's PatVariant shape, so the
    // checker can flag a payload-arity mismatch via E015).
    let le_binding: string = "";
    let le_extra: string[] = [];
    if (p.peek_punct() == "(") {
      p = p.advance();
      let ben: i32 = 0;
      while (p.peek_punct() != ")" && !p.at_end()) {
        let bind_inner: string = p.peek_ident();
        if (bind_inner.len() > 0) {
          if (ben == 0) {
            le_binding = bind_inner;
          } else {
            le_extra = le_extra.append(bind_inner);
          }
          ben = ben + 1;
          p = p.advance();
        } else {
          p = p.advance();
        }
        if (p.peek_punct() == ",") {
          p = p.advance();
        }
      }
      if (p.peek_punct() == ")") {
        p = p.advance();
      }
    }
    // Optional `: Type` — capture the type name string so
    // the checker can resolve it. Full type syntax (arrays
    // / generics) is still a later milestone; for now just
    // the bare leading token.
    let type_name: string = "";
    // The declared fn type's RETURN spelling, kept past the annotation block
    // so a lambda init can be stamped with it below. "" when the binding has
    // no annotation or the annotation is not a fn type.
    let v_fn_ret: string = "";
    // The exact parameter contract accompanies the coarse declaration tag.
    let v_fn_ptys: string = "";
    if (p.peek_punct() == ":") {
      p = p.advance();
      let (vtr, vtr_p) = parse_decl_type(p);
      p = vtr_p;
      type_name = vtr.name;
      v_fn_ret = vtr.fn_ret;
      v_fn_ptys = vtr.fn_params;
    }
    if (p.peek_punct() != "=") {
      return (s_unknown(p, "missing = in let"), p);
    }
    p = p.advance();
    // The source expr is followed by either `;` (plain binding) or
    // the `else` keyword (let-else) — never directly by `{`, so no
    // struct-literal suppression is needed here.
    // A `Map[K, V]` annotation outranks the key-kind guess parse_map_lit
    // would otherwise bake into the literal's constructor (#6207).
    let (init_expr, init_p) = parse_expr(p.with_map_kind(map_ann_key_kind(type_name)));
    p = init_p.with_map_kind(0 - 1);
    // let-else: `let Variant(b..) = E else { divergent };`. The
    // rest of the enclosing block becomes the success arm body;
    // the else block becomes the wildcard arm. Reuses the
    // statement-match machinery — no new AST node:
    //   match (E) { Variant(b..) => { <rest of block> },
    //               _ => { divergent } }
    // The success bindings are live for the rest of the block
    // (they live inside the arm), and the else branch is expected
    // to diverge (return / break / continue) — the Go checker
    // enforces that (E022); via the desugar a non-diverging else
    // simply falls through to the end of the block.
    if (p.peek_keyword() == "else") {
      p = p.advance();  // consume `else`
      let (le_else_body, le_else_p) = parse_block(p);
      p = le_else_p;
      if (p.peek_punct() == ";") {
        p = p.advance();
      }
      // Consume the rest of the enclosing block as the success
      // body, mirroring parse_block's loop (incl. its
      // progress guard so a malformed statement can't spin).
      let rest: ast.Stmt[] = [];
      while (p.peek_punct() != "}" && !p.at_end()) {
        let (rr_stmt, rr_p) = parse_stmt(p);
        if (rr_p.pos == p.pos) {
          p = p.advance();
          continue;
        }
        p = rr_p;
        rest = rest.append(rr_stmt);
      }
      let le_no_nested: ast.Pattern[] = [];
      let no_tup_kinds: i32[] = [];
      let no_tup_binds: string[] = [];
      let no_tup_lits: ast.Expr[] = [];
      let no_tup_pats: ast.Pattern[] = [];
      let le_pat: ast.Pattern = ast.PatVariant { type_name: name, binding: le_binding, extra_bindings: le_extra, nested: le_no_nested, at_binding: "", field_names: [], lit_cond: e_bool(true), has_lit_cond: false, tup_kinds: no_tup_kinds, tup_binds: no_tup_binds, tup_lits: no_tup_lits, tup_pats: no_tup_pats };
      let le_arms: ast.MatchArm[] = [];
      le_arms = le_arms.append(ast.MatchArm { pattern: le_pat, body: rest, line: vline, col: vcol, guard: e_bool(true), has_guard: false, alt_cont: false });
      le_arms = le_arms.append(ast.MatchArm { pattern: p_wildcard(), body: le_else_body, line: vline, col: vcol, guard: e_bool(true), has_guard: false, alt_cont: false });
      return (s_match_origin(init_expr, le_arms, vline, vcol, "let_else"), p);
    }
    if (p.peek_punct() == ";") {
      p = p.advance();
    }
    // `let f: () => f64 = () => <body>;` — the binding already states the
    // lambda's return type, so stamp it rather than leaving irt_guess to
    // reconstruct it from the body. Inference can only answer for the
    // expression forms it has arms for; a builtin-method body
    // (`m.get_or(k, 0.0)`) is unanswerable there without absorbing the whole
    // builtin surface. The annotation outranks the inference.
    init_expr = stamp_lambda_ret(init_expr, v_fn_ret);
    init_expr = stamp_value_block_ret(init_expr, type_name);
    return (ast.StmtVar { name: discard_name(name, vline, vcol, 0), type_name: type_name, init: init_expr, line: vline, col: vcol, fn_ret: v_fn_ret, fn_param_types: v_fn_ptys }, p);
  }
  if (kw == "return") {
    let rline: i32 = p.peek_line();
    let rcol: i32 = p.peek_col();
    p = p.advance();
    let (val_expr, val_p) = parse_expr(p);
    p = val_p;
    if (p.peek_punct() == ";") {
      p = p.advance();
    }
    return (s_return_at(val_expr, rline, rcol), p);
  }
  if (kw == "break") {
    // E011 is reported at the `break` keyword (Go's `Break{P}`).
    let bkline: i32 = p.peek_line();
    let bkcol: i32 = p.peek_col();
    p = p.advance();
    // Optional target label: `break outer;`. resolve_labels turns it into a
    // relative loop depth in the tag. Only treat a trailing ident as the label
    // when it is immediately followed by `;` — otherwise a `break` with no
    // trailing semicolon followed by an identifier-led statement would wrongly
    // swallow that statement's leading ident.
    let blbl: string = "";
    let bid: string = p.peek_ident();
    if (bid.len() > 0 && p.advance().peek_punct() == ";") {
      blbl = bid;
      p = p.advance();
    }
    if (p.peek_punct() == ";") {
      p = p.advance();
    }
    return (ast.StmtBreak { tag: 0, line: bkline, col: bkcol, label: blbl }, p);
  }
  if (kw == "continue") {
    // E011 is reported at the `continue` keyword (Go's `Continue{P}`).
    let ckline: i32 = p.peek_line();
    let ckcol: i32 = p.peek_col();
    p = p.advance();
    // Optional target label: `continue outer;` (only when followed by `;`; see
    // the break case for why).
    let clbl: string = "";
    let cid: string = p.peek_ident();
    if (cid.len() > 0 && p.advance().peek_punct() == ";") {
      clbl = cid;
      p = p.advance();
    }
    if (p.peek_punct() == ";") {
      p = p.advance();
    }
    return (ast.StmtContinue { tag: 0, line: ckline, col: ckcol, label: clbl }, p);
  }
  // Expression statement — or (compound) assignment if `=`,
  // `+=`, `-=`, `*=`, `/=`, `%=`, `&=`, `|=`, `^=`, `<<=`, `>>=`
  // follows. The parser doesn't accept any of these as binary
  // operators (none of them are in the precedence table), so
  // parse_expr stops at the ident; we peek for the assign-op
  // here and either build a plain StmtAssign or desugar a
  // compound to
  //   StmtAssign { target, ExprBinary(<op>, ExprIdent(target), rhs) }
  // so the rest of the pipeline sees only plain assigns. The
  // bitwise / shift compound set (`&= |= ^= <<= >>=`) mirrors
  // the native parser's compoundOps map exactly, so both
  // front-ends desugar the same operators to the same binary op.
  //
  // Only bare-ident targets are supported in this cut — full
  // lvalue syntax (field / index / tuple) is a later
  // milestone.
  let (e_expr, e_p) = parse_expr(p);
  p = e_p;
  // Capture the assign-op position — the Go checker reports an
  // assignment type error (E003) at the `=` token, not the lvalue.
  let aline: i32 = p.peek_line();
  let acol: i32 = p.peek_col();
  let assign_op: string = p.peek_punct();
  let is_assign: boolean = assign_op == "=";
  let is_compound: boolean = is_compound_assign_op(assign_op);
  if (is_assign || is_compound) {
    p = p.advance();  // consume the assign-op token
    let (av_expr, av_p) = parse_expr(p);
    p = av_p;
    // Chained assignment `x = y = e` (plain `=`, bare-ident targets):
    // native assignment is a right-recursive expression, so the value
    // flows to every target. parse_expr stopped at the inner `=`, so
    // av_expr is the next target. Collect the ident chain + final value
    // and emit the equivalent right-to-left assigns (`y = e; x = y;` —
    // e is evaluated exactly once) in a scoped block. Without this the
    // trailing `= e` was left as junk and only the first link ran, a
    // silent wrong result (#4339 item 1). Index / field middle targets
    // fall through to the single-assign path unchanged (as before).
    if (is_assign && p.peek_punct() == "=") {
      match (e_expr) {
        ast.ExprIdent(id0) => {
          let chain: string[] = [];
          let okchain: boolean = true;
          let moretgt: boolean = true;
          while (moretgt && okchain) {
            match (av_expr) {
              ast.ExprIdent(idn) => {
                chain = chain.append(idn.name);
                p = p.advance();  // consume the `=`
                let (nx_expr, nx_p) = parse_expr(p);
                p = nx_p;
                av_expr = nx_expr;
                av_p = nx_p;
                moretgt = p.peek_punct() == "=";
              },
              _ => {
                okchain = false;
              }
            }
          }
          if (okchain && chain.len() > 0) {
            if (p.peek_punct() == ";") {
              p = p.advance();
            }
            let stmts: ast.Stmt[] = [];
            // innermost target gets the final value, then each
            // earlier target copies from the one to its right.
            stmts = stmts.append(s_assign(chain[chain.len() - 1], av_expr));
            let ci: i32 = chain.len() - 1;
            while (ci > 0) {
              stmts = stmts.append(s_assign(chain[ci - 1], e_ident(chain[ci])));
              ci = ci - 1;
            }
            stmts = stmts.append(s_assign(id0.name, e_ident(chain[0])));
            return (s_if_tagged(stmts, "chain_assign"), p);
          }
        },
        _ => {}
      }
    }
    if (p.peek_punct() == ";") {
      p = p.advance();
    }
    let rhs: ast.Expr = av_expr;
    // Dispatch on the lvalue shape: bare ident → StmtAssign;
    // `arr[idx]` → desugar to the builtin __set_index(arr, idx,
    // value) (an expression statement) so no new Stmt node is
    // needed. Compound `arr[idx] += y` reads the element back (see
    // the ExprIndex arm below); field compounds work the same way.
    match (e_expr) {
      ast.ExprIdent(id) => {
        let rhs2: ast.Expr = rhs;
        if (is_compound) {
          // `x += y` desugars to `x = x + y`. Strip the
          // trailing `=` off the op to recover the operator.
          let op: str = slice_unchecked(assign_op, 0, assign_op.len() - 1);
          rhs2 = e_binary(op, e_ident(id.name), rhs);
        }
        return (s_assign_at(id.name, rhs2, aline, acol, id.line, id.col), p);
      },
      ast.ExprIndex(ix) => {
        // `arr[idx] = rhs` → __set_index(arr, idx, rhs). A compound
        // `arr[idx] += y` reads the element back: rhs becomes
        // `arr[idx] <op> y`.
        let irhs: ast.Expr = rhs;
        if (is_compound) {
          let iop: str = slice_unchecked(assign_op, 0, assign_op.len() - 1);
          irhs = e_binary(iop, e_index(ix.array, ix.index, ix.line, ix.col), rhs);
        }
        let sargs: ast.Expr[] = [];
        sargs = sargs.append(ix.array);
        sargs = sargs.append(ix.index);
        sargs = sargs.append(irhs);
        return (s_expr(e_call(e_ident("__set_index"), sargs)), p);
      },
      ast.ExprFieldAccess(fa) => {
        // `obj.field = rhs` → __set_field(obj, "field", rhs)
        // (an expression statement; the emitter shape-dispatches
        // to the field's slot). Compound forms desugar to a read
        // of the same field (re-evaluates obj — fine for the
        // simple lvalues that use this).
        let frhs: ast.Expr = rhs;
        if (is_compound) {
          let fop: str = slice_unchecked(assign_op, 0, assign_op.len() - 1);
          frhs = e_binary(fop, e_field_access(fa.obj, fa.field), rhs);
        }
        let fargs: ast.Expr[] = [];
        fargs = fargs.append(fa.obj);
        // Carry the field-access dot position on the field-name
        // string so the checker can report E048 (assign to an
        // immutable field) at the dot, matching the Go checker's
        // FieldAccess position. Codegen ignores the position.
        fargs = fargs.append(e_string_at(fa.field, fa.line, fa.col));
        fargs = fargs.append(frhs);
        return (s_expr(e_call(e_ident("__set_field"), fargs)), p);
      },
      _ => {
        return (s_unknown(p, "lhs of assign must be ident, index, or field"), p);
      }
    }
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (s_expr(e_expr), p);
}

pub function parse_program(toks: lexer.Token[]): ast.Stmt[] {
  let p: Par = Par { toks: toks, pos: 0, no_struct: false, map_kind: 0 - 1, structnames: scan_struct_names(toks), verbatim: false, depth: 0, type_errs: [], todos: [] };
  let out: ast.Stmt[] = [];
  while (!p.at_end()) {
    let (r_stmt, r_p) = parse_stmt(p);
    p = r_p;
    out = out.append(r_stmt);
  }
  return out;
}

// parse_type_name reads a (possibly generic) type spelling and
// returns it as a single concatenated string. Recognises:
//   * `Name`                     — `Map` or `i32`
//   * `Name[T1, T2, …]`          — `Map[string, i32]`
// Nested generics (`Map[Map[…], …]`) aren't unrolled; the
// inner `[…]` substring is captured verbatim by counting the
// matching `]`. Returns (name, fn_ret, par) — empty name means
// the parser saw nothing useful. fn_ret is, for a closure type
// `(T) => R` coarsened to the flat tag "fn", the spelling of R when
// fn_ret_admitted keeps it; empty otherwise.

// consume_array_suffix swallows trailing `[]` suffix(es) after a type and
// appends them to `name`. Needed for the parenthesized type forms — a
// tuple `(i32, i32)[]` or function `(() => i32)[]` array — whose `[]`
// would otherwise be left on the cursor, breaking the surrounding `let`
// decl (the binding's local then never gets declared).
// is_struct_ret_name reports whether `n` is a plausible bare struct/enum type
// name to record as a fn-value's return type (#3640) — a non-empty plain
// identifier that isn't a primitive / built-in tag. Over-recording is harmless
// (the downstream field lookup just fails to resolve and bails as before); this
// only filters the obvious non-structs so the registry stays clean.
// is_scalar_ret_name reports whether `n` names a scalar the fn-return carrier
// keeps for lambda-return stamping. Deliberately NOT is_struct_ret_name's
// complement: only these exact spellings qualify, so an unknown name still
// falls through as before.
function is_scalar_ret_name(n: string): boolean {
  return n == "i32" || n == "i64" || n == "u8" || n == "u32" || n == "u64"
    || n == "f32" || n == "f64" || n == "boolean";
}

pub function is_struct_ret_name(n: string): boolean {
  if (n.len() == 0) {
    return false;
  }
  // Reject anything carrying array / generic / tuple / qualified syntax — a
  // bare struct name has none of these.
  let i: i32 = 0;
  while (i < n.len()) {
    let c: i32 = n[i] as i32;
    if (c == 91 || c == 93 || c == 40 || c == 41 || c == 44 || c == 46 || c == 32) {
      return false;
    }
    i = i + 1;
  }
  if (n == "i32" || n == "i64" || n == "u8" || n == "u32" || n == "u64"
    || n == "f32" || n == "f64" || n == "string" || n == "boolean" || n == "void"
    || n == "fn" || n == "unknown" || n == "any") {
    return false;
  }
  return true;
}

// is_nominal_ret_name reports whether `n` is a (possibly GENERIC) nominal type
// spelling — a named struct or enum, bare (`Fut`) or instantiated (`Fut[T]`,
// `Future[i32]`, `Map[K, V]`), optionally qualified (`mod.Fut[i32]`). Unlike
// is_struct_ret_name it tolerates the `[...]` generic-arg brackets and a `.`
// qualifier; it still rejects a tuple/fn spelling and the primitives. Used to
// retain an enum-variant fn payload's return type (`(i32) => Fut[T]`) so the
// monomorphiser can recover a nested `match (cont(tok))`'s instantiation (#4722).
function is_nominal_ret_name(n: string): boolean {
  if (n.len() == 0) {
    return false;
  }
  // Base = the spelling up to the first generic-arg bracket. A tuple/fn base
  // (opens with `(`) disqualifies.
  let base: string = n;
  let bi: i32 = 0;
  while (bi < n.len()) {
    if (n[bi] == b'[') {
      base = slice_unchecked(n, 0, bi) + "";
      bi = n.len();
    } else {
      bi = bi + 1;
    }
  }
  if (base.len() == 0) {
    return false;
  }
  if (base[0] == b'(') {  // tuple / fn spelling
    return false;
  }
  if (base == "i32" || base == "i64" || base == "u8" || base == "u32" || base == "u64"
    || base == "f32" || base == "f64" || base == "string" || base == "boolean" || base == "void"
    || base == "fn" || base == "unknown" || base == "any") {
    return false;
  }
  return true;
}

// ret_spelling_is_array reports whether a return-type spelling names an array.
// A `[T]` view counts: it is indexed and iterated as the array it lowers to.
function ret_spelling_is_array(name: string): boolean {
  return type_ends_arr(name) || spelling_is_view(name);
}

// fn_ret_admitted is the single rule for which RESULT spellings a fn type keeps
// in its `fn_ret` sidecar.
//
// Struct and nominal-enum returns let a fn value resolve `g().field` and let
// monomorphize rewrite a nested `match (cont(tok))` (#3640, #4722). `string`
// lets a chained string op on an fn-FIELD call result dispatch as a string
// (#5306 gap 2). A scalar lets a lambda bound to the type be stamped with its
// declared return instead of re-inferring it from the body. Tuple and array
// results let the checker resolve a call through the fn value to a real type
// (#5986).
function fn_ret_admitted(rr_name: string): string {
  if (ret_spelling_is_array(rr_name)) {
    return rr_name;
  }
  if (is_struct_ret_name(rr_name)) {
    return rr_name;
  }
  if (is_nominal_ret_name(rr_name)) {
    return rr_name;
  }
  if (rr_name == "string") {
    return "string";
  }
  if (is_scalar_ret_name(rr_name)) {
    return rr_name;
  }
  if (util.is_tuple_type_name(rr_name)) {
    return rr_name;
  }
  return "";
}

// at_unit_type reports whether the cursor sits on the unit type `()`. Native's
// type parser resolves the empty parens to the void type and its printer writes
// `void`, so the self-host records the same name rather than the written parens
// (#8759). `() => R` is a function type with an empty parameter list, not the
// unit, and is left for the collectors that build a fn-type spelling.
function at_unit_type(p: Par): boolean {
  return p.peek_punct() == "(" && p.peek_punct_at(1) == ")" && p.peek_punct_at(2) != "=>";
}

function consume_array_suffix(p: Par, name: string): (string, string, Par) {
  while (p.peek_punct() == "[") {
    p = p.advance();
    if (p.peek_punct() == "]") {
      p = p.advance();
      name = name + "[]";
    }
  }
  return (name, "", p);
}

function parse_type_dyn(p: Par): (string, string, Par) {
  p = p.advance();  // consume `dyn`
  let (dinner_name, dinner_fn_ret, dinner_p) = parse_type_name(p);
  p = dinner_p;
  let dynname: string = dinner_name;
  // Collect any `+ Trait` continuations (multi-trait `dyn A + B`).
  while (p.peek_punct() == "+") {
    p = p.advance();  // consume `+`
    let (dmore_name, dmore_fn_ret, dmore_p) = parse_type_name(p);
    p = dmore_p;
    if (dmore_name.len() == 0) {
      // Trailing / empty `+` — no trait name followed it.
      return ("", "", p);
    }
    dynname = dynname + " + " + dmore_name;
  }
  return ("dyn " + dynname, "", p);
}

function parse_type_handle(p: Par, base: string): (string, string, Par) {
  // WIT resource-handle type `own R` / `borrow R` (P5 —
  // docs/WIT-BRING-YOUR-OWN.md). Preserved as "own <R>" / "borrow <R>"
  // (mirroring `dyn <trait>`): it lowers to i32 everywhere (a handle is an
  // opaque scalar — see wat_extern_valtype and the local/param valtype
  // defaults), and the spelling lets lower_defers_prepass_module find owned
  // handles and tell own from borrow for its move analysis.
  p = p.advance();  // consume `own` / `borrow`
  let (hinner_name, hinner_fn_ret, hinner_p) = parse_type_name(p);
  return (base + " " + hinner_name, "", hinner_p);
}

// parse_type_punct_led handles the type forms that do not start with an
// identifier: the tuple / parenthesised group `(…)` and the borrowed view
// `[T]`. Both exist here because leaving their leading punct on the cursor
// spins the surrounding decl loop until the process is OOM-killed.
// parse_type_paren handles the parenthesised forms: a tuple type
// `(T1, T2, …)`, which the self-host stores coarsely as "tuple", and a
// parenthesised single trait object `(dyn T)` / `(dyn A + B)`, where the
// parens are redundant grouping that has to be unwrapped rather than folded
// into the name.
function parse_type_paren(p: Par): (string, string, Par) {
  return parse_type_paren_arrow(p, true);
}

// parse_type_name_reserving_arrow is parse_type_name with the top-level
// function-type arrow left for the caller: `(string, i32)` stops at the `=>`
// instead of reading it as the arrow of a function type. An arrow lambda's
// return annotation is the one position that needs it, because the lambda's
// own arrow follows the annotation (#8743). Only the parenthesised head is
// ambiguous — every other type form ends before a `=>` — so anything else
// delegates unchanged.
function parse_type_name_reserving_arrow(p: Par): (string, string, Par) {
  if (p.peek_punct() != "(") {
    return parse_type_name(p);
  }
  return parse_type_paren_arrow(p, false);
}

function parse_type_paren_arrow(p: Par, top_arrow: boolean): (string, string, Par) {
  // The unit type `()`, folded to `void` before the collect loop can record
  // its parens as a spelling.
  if (at_unit_type(p)) {
    let up: Par = p.advance();
    up = up.advance();
    return consume_array_suffix(up, "void");
  }
  // A parenthesized SINGLE trait-object type — `(dyn T)`,
  // `(dyn A + B)`, optionally arrayed `(dyn T)[]`. The parens are
  // redundant grouping (source needs them so a trailing `[]` binds to
  // the whole `dyn T`, not to a trait generic-arg). Unwrap to the
  // paren-free `dyn T` / `dyn T[]` spelling the `dyn` branch above
  // produces — otherwise the tuple char-collect loop below keeps the
  // parens (`(dyn Shape)`) and every `type_name[0:4] == "dyn "` consumer
  // misses, so a `(dyn Trait)[]` PARAM's element dispatch declines the
  // IR path (#5203). A genuine tuple whose first element is `dyn`
  // (`(dyn A, i32)`) is NOT a single-type wrap: the `)`-follows check
  // fails and the untouched cursor runs the unchanged tuple path.
  let dpa: Par = p.advance();  // peek past `(`
  if (dpa.peek_keyword() == "dyn") {
    let (dpw_name, dpw_fn_ret, dpw_p) = parse_type_name(dpa);
    if (dpw_p.peek_punct() == ")") {
      // `(dyn T) => R` is a FUNCTION type whose PARAMETER is a
      // trait object, not a grouped trait-object array — the arrow
      // follows the parens. Leave it to the char-collect + `=> R`
      // path below (which coarsens it to "fn"); only unwrap a
      // genuine `(dyn T)` / `(dyn T)[]`. Without this guard the
      // arrow + return type are dropped and `(dyn T) => R` params
      // fail to parse (#5267 regressed this shape).
      let dpw_after: Par = dpw_p.advance();  // past `)`
      if (!top_arrow || dpw_after.peek_punct() != "=>") {
        return consume_array_suffix(dpw_after, dpw_name);
      }
    }
  }
  let tbuf: string = "";
  let td: i32 = 0;
  let is_fn: boolean = false;
  let top_comma: boolean = false;
  let tprev_word: boolean = false;
  let tprev_dyn: boolean = false;
  // telem_empty: no type has been read since the last `(` or `,`, so a `,`
  // here leaves an element empty, which native refuses; so does a `)` after a
  // `,`. A `)` right after `(` is a function type's empty parameter list.
  let telem_empty: boolean = true;
  let telem_after_comma: boolean = false;
  while (!p.at_end()) {
    let tpk: string = p.peek_punct();
    // A unit ELEMENT of a tuple type — `((), i32)`. The head `()` never
    // reaches here (folded above), so this is always a nested one.
    if (at_unit_type(p)) {
      tbuf = tbuf + "void";
      p = p.advance();
      p = p.advance();
      tprev_word = false;
      tprev_dyn = false;
      telem_empty = false;
      continue;
    }
    if (tpk == "(") {
      td = td + 1;
      telem_empty = true;
      telem_after_comma = false;
      tbuf = tbuf + "(";
      p = p.advance();
      tprev_word = false;
      tprev_dyn = false;
      continue;
    }
    if (tpk == ")") {
      if (telem_empty && telem_after_comma) {
        p = p.expected_type();
      }
      telem_empty = false;
      td = td - 1;
      tbuf = tbuf + ")";
      p = p.advance();
      tprev_word = false;
      tprev_dyn = false;
      if (td == 0) {
        break;
      }
      continue;
    }
    if (tpk == ",") {
      if (telem_empty) {
        p = p.expected_type();
      }
      telem_empty = true;
      telem_after_comma = true;
      if (td == 1) {
        top_comma = true;
      }
      tbuf = tbuf + ", ";
      p = p.advance();
      tprev_word = false;
      tprev_dyn = false;
      continue;
    }
    // A `=>` *inside* the parens with NO depth-1 comma means the
    // parens wrap a whole function type (`(() => i32)`), not a
    // tuple — coarse it to "fn" (a closure box). With a depth-1
    // comma the parens are a TUPLE whose elements include fn
    // types (`((i32) => i32, i32)`), and each such ELEMENT keeps
    // its signature: the result type is what lets the checker type
    // `t.N()` (#7961). (The `(T,…) => R` form, with `=>` *after*
    // the parens, is handled below.)
    if (tpk == "=>") {
      is_fn = true;
      // Both paths spell the arrow the way render_type_ref does, so a
      // reconstructed tuple spelling is canonical: parse_type_ref /
      // render_type_ref round-trip it, which is what lets a fn-typed
      // ELEMENT keep its signature instead of collapsing to the coarse
      // tag (#7961).
      tbuf = tbuf + " => ";
      p = p.advance();
      tprev_word = false;
      tprev_dyn = false;
      telem_empty = true;
      continue;
    }
    // Multi-trait object `dyn A + B` as a tuple element — join with ` + `
    // to match parse_type_dyn, whose spelling the checker compares against
    // a value's traits string exactly.
    if (tpk == "+") {
      tbuf = tbuf + " + ";
      p = p.advance();
      tprev_word = false;
      tprev_dyn = false;
      telem_empty = true;
      continue;
    }
    if (tpk.len() > 0) {
      tbuf = tbuf + tpk;
      p = p.advance();
      tprev_word = false;
      tprev_dyn = false;
      telem_empty = false;
      continue;
    }
    let tseg: string = p.peek_ident();
    if (tseg.len() == 0) {
      tseg = p.peek_keyword();
    }
    if (tseg.len() == 0) {
      p = p.expected_type().advance();
      continue;
    }
    // Two adjacent word tokens have no separator of their own, so
    // `dyn Speak` would collect as `dynSpeak`. `-fmt` reinserts the space
    // everywhere; the compile parse reinserts it only after `dyn`, because
    // every consumer matches on that prefix and a mashed element resolves
    // to no type at all, slipping past every checker rule that would have
    // judged it (#10085). Other adjacent words keep the mashed spelling
    // the consumers were written against.
    if (tprev_word && (p.verbatim || tprev_dyn)) {
      tbuf = tbuf + " ";
    }
    tbuf = tbuf + tseg;
    tprev_word = true;
    tprev_dyn = tseg == "dyn";
    telem_empty = false;
    p = p.advance();
  }
  // Parenthesized function type `(… => …)` → coarse "fn", plus any
  // trailing `[]` (an array of closures). Only when there is no
  // depth-1 comma: with one, the parens are a tuple and the arrow
  // belongs to an ELEMENT (unless a `=> R` follows the parens —
  // the fn-taking-a-tuple-param form the next branch handles).
  if (is_fn && !top_comma && !(top_arrow && p.peek_punct() == "=>")) {
    // `-fmt` keeps the parenthesised signature: `fn[]` names neither
    // what the element takes nor what it returns, and the parens are
    // essential — `(string) => string[]` re-parses as ONE function
    // returning `string[]`, so `((string) => string)[]` must keep them.
    if (p.verbatim) {
      return consume_array_suffix(p, tbuf);
    }
    // The coarse tag drops the signature, so recover the RESULT spelling
    // from the reconstructed inner text and keep it in the fn_ret sidecar
    // — the same channel the unparenthesised `(T,…) => R` branch fills.
    // This is the ONLY way an array of functions is spelled, so without it
    // `(() => f64)[]` records nothing about its element (#5986).
    let (gname, gunused, gp) = consume_array_suffix(p, "fn");
    let gref: TypeRef = parse_type_ref(tbuf);
    if (!ref_is_fn_value(gref)) {
      return (gname, "", gp);
    }
    let gres: string = render_type_ref(ref_fn_result(gref));
    return (gname, fn_ret_admitted(gres), gp);
  }
  // Function type `(T1, …) => R`. After the balanced param
  // parens, a `=>` introduces the return type. Consume it
  // and the return-type spelling, returning a coarse "fn"
  // tag (the self-host stores types coarsely; the only thing
  // the emitter needs is that a value of this type is a
  // closure box). Without consuming `=> R` the arrow + return
  // type are left on the cursor and the decl loop spins (OOM).
  if (top_arrow && p.peek_punct() == "=>") {
    p = p.advance();  // consume `=>`
    let (rr_name, rr_fn_ret, rr_p) = parse_type_name(p);
    p = rr_p;
    // `(…) => R` — coarse "fn"; a trailing `[]` makes it an
    // array of closures.
    let (fnr_name, fnr_fn_ret, fnr_p) = consume_array_suffix(p, "fn");
    let fn_ret_ty: string = fn_ret_admitted(rr_name);
    // `-fmt` keeps the declared signature instead of the flat tag:
    // `fn` names neither what the callback takes nor what it
    // returns, so a reformatted `cmp: (T, T) => i32` would lose
    // both (#6773). `fnr_name` is "fn" plus any trailing `[]`, and
    // native prints an array-of-closures as `(T) => R[]` — so the
    // suffix goes on the end here too.
    if (p.verbatim) {
      return (tbuf + " => " + rr_name + slice_unchecked(fnr_name, 2, fnr_name.len()), fn_ret_ty, fnr_p);
    }
    return (fnr_name, fn_ret_ty, fnr_p);
  }
  // Tuple type — return the reconstructed precise spelling
  // (e.g. "(string, TestRunner)") so tuple-destructure
  // bindings can recover each element's type. ret_tag_of
  // still maps the whole "(…)" to "unknown", so this is a
  // strict superset of the old coarse "tuple" placeholder. A
  // trailing `[]` makes it an array of tuples. An fn-typed
  // ELEMENT keeps its full signature — the arrow is what says
  // "function value" and the result type is what lets the
  // checker type a call through it (#7961). Consumers ask
  // parser.ref_is_fn_value rather than matching a spelling.
  // With no depth-1 comma the parens hold ONE element, which makes them
  // redundant grouping rather than a tuple — no one-element tuple type
  // exists, and native's type parser resolves `(i32)` to `i32` the same way.
  if (!top_comma) {
    return consume_array_suffix(p, unwrap_grouping_parens(tbuf));
  }
  return consume_array_suffix(p, tbuf);
}

// unwrap_grouping_parens strips redundant grouping parens from a type spelling.
// The caller has established the parens hold one non-fn element; the unit `()`
// is folded to `void` before it can reach here.
function unwrap_grouping_parens(s: string): string {
  let t: string = s;
  while (t.len() > 2 && t[0] == b'(' && t[t.len() - 1] == b')') {
    t = slice_unchecked(t, 1, t.len() - 1) + "";
  }
  return t;
}

// matching_bracket returns the index of the `]` matching the `[` at `start`,
// or -1 when unbalanced.
function matching_bracket(s: string, start: i32): i32 {
  let depth: i32 = 0;
  let i: i32 = start;
  while (i < s.len()) {
    if (s[i] == b'[') {
      depth = depth + 1;
    } else if (s[i] == b']') {
      depth = depth - 1;
      if (depth == 0) {
        return i;
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

// matching_close returns the index of the `)` matching the `(` at `start`,
// or -1 when unbalanced.
function matching_close(s: string, start: i32): i32 {
  let depth: i32 = 0;
  let i: i32 = start;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c == b'(' as i32) {
      depth = depth + 1;
    } else if (c == b')' as i32) {
      depth = depth - 1;
      if (depth == 0) {
        return i;
      }
    }
    i = i + 1;
  }
  return -1;
}

// group_has_top_comma reports whether the paren group s[start..close) holds a
// comma at its own top level — the group is a TUPLE type, whose parens are
// syntax rather than grouping.
function group_has_top_comma(s: string, start: i32, close: i32): boolean {
  if (close <= start + 1) {
    return false;
  }
  let depth: i32 = 0;
  let i: i32 = start + 1;
  while (i < close) {
    let c: i32 = s[i] as i32;
    if (c == b'(' as i32 || c == b'[' as i32) {
      depth = depth + 1;
    } else if (c == b')' as i32 || c == b']' as i32) {
      depth = depth - 1;
    } else if (c == b',' as i32 && depth == 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// group_inner_is_fn reports whether the paren group s[start..close) holds a
// function type at its top level (a top-level `=>`). Only its grouping keeps
// a fn value whole when a trailing `[]` arrays the closure: stripped, the
// suffix would array the function's RESULT rather than the closure itself.
function group_inner_is_fn(s: string, start: i32, close: i32): boolean {
  let depth: i32 = 0;
  let i: i32 = start + 1;
  while (i < close - 1) {
    let c: i32 = s[i] as i32;
    if (c == b'(' as i32 || c == b'[' as i32) {
      depth = depth + 1;
    } else if (c == b')' as i32 || c == b']' as i32) {
      depth = depth - 1;
    } else if (c == b'=' as i32 && s[i + 1] == b'>' && depth == 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// rest_starts_with_arrow reports whether the text after a group's `)` begins
// its function-type arrow — a paren group immediately followed by `=>` is the
// function's PARAMETER list, whose parens are syntax rather than grouping.
function rest_starts_with_arrow(s: string, from: i32): boolean {
  let i: i32 = from;
  while (i < s.len() && s[i] == b' ') {
    i = i + 1;
  }
  return i + 1 < s.len() && s[i] == b'=' && s[i + 1] == b'>';
}

// rest_starts_with_array_suffix reports whether the text after a group's `)`
// begins the empty-bracket array suffix `[]`.
function rest_starts_with_array_suffix(s: string, from: i32): boolean {
  return from + 1 < s.len() && s[from] == b'[' && s[from + 1] == b']';
}

// canonicalise_type_args rebuilds a collected generic-argument list with the
// redundant grouping parens removed at every depth, matching native's type
// parser, which resolves `(i32)` to `i32` wherever it occurs (#8800): the
// list `(i32), i32` writes `i32, i32`, a nested `Option[(i32)]` writes
// `Option[i32]`, and `((i32) => i32)` writes `(i32) => i32`. The parens are
// essential — and kept — when the group is a tuple (a top-level comma), a
// function parameter list (a `=>` follows its `)`), or an array-of-closure
// whose suffix a kept group stops splitting.
function canonicalise_type_args(s: string): string {
  let i: i32 = 0;
  while (i < s.len() && s[i] != b'(') {
    i = i + 1;
  }
  if (i >= s.len()) {
    return s;
  }
  let head: string = slice_unchecked(s, 0, i) + "";
  let close: i32 = matching_close(s, i);
  if (close < 0) {
    return s;
  }
  let inner: string = slice_unchecked(s, i + 1, close) + "";
  let rest_from: i32 = close + 1;
  let group_is_tuple: boolean = group_has_top_comma(s, i, close);
  let group_is_fn_param: boolean = rest_starts_with_arrow(s, rest_from);
  let group_is_fn_arr: boolean = !group_is_fn_param && group_inner_is_fn(s, i, close) && rest_starts_with_array_suffix(s, rest_from);
  if (group_is_tuple || group_is_fn_param || group_is_fn_arr) {
    return head + "(" + canonicalise_type_args(inner) + ")" + canonicalise_type_args(slice_unchecked(s, rest_from, s.len()) + "");
  }
  return head + canonicalise_type_args(inner) + canonicalise_type_args(slice_unchecked(s, rest_from, s.len()) + "");
}

function parse_type_punct_led(p: Par): (string, string, Par) {
  // Tuple type `(T1, T2, …)`. The self-host stores types
  // coarsely, so consume the balanced parens and return a
  // placeholder "tuple" rather than the precise shape. Without
  // this the leading `(` is left on the cursor and the decl
  // loop spins (OOM). std/string's split_at / split_once use
  // `(string, string)` and `Option[(string, string)]`.
  if (p.peek_punct() == "(") {
    return parse_type_paren(p);
  }
  // Prefix-bracket type `[T]`: a borrowed view, kept as written so the
  // checker can tell it from an owned `T[]` anywhere inside a type. The
  // lowering folds it to the array it lowers to (erase_view_spelling).
  if (p.peek_punct() == "[") {
    p = p.advance();  // consume `[`
    let (bracketed_name, bracketed_fn_ret, bracketed_p) = parse_type_name(p);
    p = bracketed_p;
    if (p.peek_punct() == "]") {
      p = p.advance();
    }
    let (suffixed, sp) = parse_array_suffixes(p, "[" + bracketed_name + "]");
    return (suffixed, "", sp);
  }
  return ("", "", p.expected_type());
}

// parse_type_ident_led handles the identifier-led forms: a qualified
// `pkg.Name`, generic args, and the trailing array suffixes.
function parse_type_ident_led(p: Par, base: string): (string, string, Par) {
  p = p.advance();
  // Qualified type name: `pkg.Name` (e.g. `lexer.Token`). Consume
  // the `.ident` suffix chain so cross-module type references in
  // struct fields / params / return types parse cleanly. Without
  // this the `.` is left on the cursor and the surrounding field /
  // decl loop can't make progress — it spins, allocating until the
  // process is OOM-killed. parser.fern itself is full of
  // `lexer.Token` field / param types, so this is required for the
  // self-host parser to parse its own source.
  while (p.at_path_sep()) {
    // The separator is KEPT: in type position `.` and `::` are not
    // interchangeable. `mod.Type` is a module qualifier, stripped to the
    // bare name downstream; `Base::Name` is an associated-type projection
    // (`Self::Item`) the checker resolves against the impl's binding.
    // See docs/ASSOCIATED-TYPES.md.
    let sep: string = p.peek_punct();
    p = p.advance();
    let seg0: string = p.peek_ident();
    if (seg0.len() == 0) {
      seg0 = p.peek_keyword();
    }
    if (seg0.len() == 0) {
      break;
    }
    base = base + sep + seg0;
    p = p.advance();
  }
  if (p.peek_punct() != "[") {
    return (base, "", p);
  }
  // Consume `[T1, T2, …]` by tracking bracket depth so nested
  // generics survive verbatim. Token text reconstructed from
  // the same peek_* family — type-name args are restricted
  // to idents / keywords / `,` / `[` / `]`.
  p = p.advance();  // consume opening `[`
  let inner: string = "";
  let depth: i32 = 1;
  // Two ident/keyword tokens are only ever adjacent inside a generic arg
  // for a `dyn Trait` object type (`Result[i32, dyn Error]`). Every other
  // separator (`,` `[` `(` …) inserts its own delimiter, but two bare
  // idents have none — so reinsert the space to keep the canonical
  // `"dyn Error"` spelling. Without it the payload type is stored as
  // `"dynError"` and the dyn-dispatch guard (`rty[0:4] == "dyn "`) misses.
  let prev_ident: boolean = false;
  while (depth > 0 && !p.at_end()) {
    let pk: string = p.peek_punct();
    if (pk == "[") {
      depth = depth + 1;
      inner = inner + "[";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == "]") {
      depth = depth - 1;
      if (depth == 0) {
        break;
      }
      inner = inner + "]";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == ",") {
      inner = inner + ", ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    // Multi-trait object `dyn A + B` nested in a generic arg — match the
    // top-level `parse_type` spelling (` + ` joined) so the dyn payload
    // type round-trips identically.
    if (pk == "+") {
      inner = inner + " + ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    // The unit type as a generic ARGUMENT — `Result[(), E]`, `Option[()]`.
    // Folded to `void` here too: this collector reads the brackets a token
    // at a time and never calls back into the type parser.
    if (at_unit_type(p)) {
      inner = inner + "void";
      p = p.advance();
      p = p.advance();
      prev_ident = false;
      continue;
    }
    // Tuple types nested inside a generic arg, e.g.
    // `Option[(string, string)]` — pass parens through verbatim.
    if (pk == "(") {
      inner = inner + "(";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    if (pk == ")") {
      inner = inner + ")";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    // FN-typed generic arg, e.g. `Option[() => i32]`, `Map[i32, (A) => B]`,
    // `Result[(i32) => i32, E]` — pass the `=>` arrow through verbatim (joined
    // with surrounding spaces) so the fn-type spelling round-trips inside the
    // brackets. Without this the loop breaks on `=>`, truncating the type to
    // `Option[()]` and leaving `=> i32` on the cursor — which then corrupts the
    // enclosing decl body into a StmtUnknown.
    if (pk == "=>") {
      inner = inner + " => ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    // An associated-type PIN inside a dyn bracket — `dyn Holder[Item = i32]`.
    // Without this the loop breaks on the `=`, truncating the type and
    // spilling `= i32]` onto the cursor. Matched after `=>`, which the
    // lexer emits as one token. See docs/ASSOCIATED-TYPES.md.
    if (pk == "=") {
      inner = inner + " = ";
      p = p.advance();
      prev_ident = false;
      continue;
    }
    // A module-QUALIFIED generic arg, e.g. `Map[string, peg.Pattern]`. The
    // loop used to break on the `.`, truncating the type to `Map[string,
    // peg]` and leaving `.Pattern]` on the cursor — which corrupted the
    // whole `let` into a StmtUnknown, and `-fmt` wrote that back as
    // `/*unknown-stmt:missing = in let*/`.
    // `::` rides the same path: an associated-type projection nested in a
    // generic arg (`Option[Self::Item]`) is collected verbatim, and the
    // checker resolves it once the impl's binding is known.
    if (pk == "." || pk == "::") {
      inner = inner + pk;
      p = p.advance();
      prev_ident = false;
      continue;
    }
    let seg: string = p.peek_ident();
    if (seg.len() == 0) {
      seg = p.peek_keyword();
    }
    if (seg.len() == 0) {
      break;
    }
    if (prev_ident) {
      inner = inner + " ";
    }
    inner = inner + seg;
    p = p.advance();
    prev_ident = true;
  }
  if (p.peek_punct() == "]") {
    p = p.advance();
  }
  let nm: string = base + "[" + canonicalise_type_args(inner) + "]";
  // An associated-type projection on a GENERIC base — `Box[i32]::Ok`. The
  // bare-base form is taken by the path-sep loop above, which runs before
  // the bracket group and so never sees this one. Only `::` qualifies: a
  // `.` after a complete type is not a projection in this grammar.
  while (p.peek_punct() == "::") {
    let pp: Par = p.advance();
    let pseg: string = pp.peek_ident();
    if (pseg.len() == 0) {
      pseg = pp.peek_keyword();
    }
    if (pseg.len() == 0) {
      break;
    }
    nm = nm + "::" + pseg;
    p = pp.advance();
  }
  // Trailing array suffixes for nested array types: `i32[][]`,
  // `T[][][]`, `Map[K, V][]`, etc. After a complete type a `[` is only
  // ever an (empty) array suffix in this grammar, so consume each
  // `[]` pair and append it. Without this the second `[]` is left on
  // the cursor and the surrounding decl misaligns (the `let` binding
  // gets dropped). The base case `T[]` already returned above.
  let (suffixed, sp) = parse_array_suffixes(p, nm);
  return (suffixed, "", sp);
}

// parse_array_suffixes folds the `[]` pairs after a complete type onto `nm`:
// `i32[][]`, `Map[K, V][]`, `[u8][]`. After a complete type a `[` is only ever
// an empty array suffix in this grammar.
function parse_array_suffixes(p: Par, nm: string): (string, Par) {
  let out: string = nm;
  while (p.peek_punct() == "[") {
    if (p.peek_punct_at(1) != "]") {
      break;
    }
    p = p.advance().advance();
    out = out + "[]";
  }
  return (out, p);
}

// parse_type_name is the depth-guarded face of parse_type_name_nested: see MAX_NEST_DEPTH.
function parse_type_name(p: Par): (string, string, Par) {
  if (p.too_deep()) {
    return ("", "", p.bail());
  }
  let (g0, g1, gq) = parse_type_name_nested(p.with_depth(p.depth + 1));
  return (g0, g1, gq.with_depth(p.depth));
}

struct DeclType { name: string, fn_ret: string, fn_params: string }

// Keep the legacy declaration tag and its exact callable contract together.
function parse_decl_type(p: Par): (DeclType, Par) {
  let (name, fn_ret, end) = parse_type_name(p);
  let out: DeclType = DeclType { name: name, fn_ret: fn_ret, fn_params: "" };
  if (p.verbatim || !is_fn_contract_tag(name)) {
    return (out, end);
  }
  let (written, wr_ret, wr_end) = parse_type_name(Par { ...p, verbatim: true });
  let ref: TypeRef = fn_ref_of(name, written);
  if (!ref_is_fn_value(ref)) {
    return (out, end);
  }
  let result: string = render_type_ref(ref_fn_result(ref));
  return (DeclType {
    name: name, fn_ret: result,
    fn_params: ref_fn_param_spellings(ref),
  }, end);
}

// fn_ref_of is the callable a coarsened tag stands for, read back out of the
// annotation's VERBATIM spelling. parse_type_name flattens `(i32) => i32` to
// "fn", and this is what parse_decl_type and the lambda annotation both recover
// it with, so a declaration and a lambda agree on the contract by construction.
function fn_ref_of(name: string, written: string): TypeRef {
  let ref: TypeRef = ref_ungroup(parse_type_ref(written));
  if (name == "fn[]" && ref.array_depth == 1) {
    ref = ref_ungroup(elem_type_ref(ref));
  }
  if (name == "[fn]" && ref.is_view) {
    ref = ref_ungroup(ref.args[0]);
  }
  return ref;
}

// fn_contract_of is the #5986 sidecar pair for a tag, or two empty strings when
// the tag is not callable.
function fn_contract_of(name: string, written: string): (string, string) {
  if (!is_fn_contract_tag(name)) {
    return ("", "");
  }
  let ref: TypeRef = fn_ref_of(name, written);
  if (!ref_is_fn_value(ref)) {
    return ("", "");
  }
  return (render_type_ref(ref_fn_result(ref)), ref_fn_param_spellings(ref));
}

function parse_type_name_nested(p: Par): (string, string, Par) {
  let base: string = p.peek_ident();
  if (base.len() == 0) {
    base = p.peek_keyword();
  }
  if (base == "dyn") {
    return parse_type_dyn(p);
  }
  if (base == "own" || base == "borrow") {
    return parse_type_handle(p, base);
  }
  if (base.len() == 0) {
    return parse_type_punct_led(p);
  }
  return parse_type_ident_led(p, base);
}

// at_pattern_head reports whether the cursor opens a destructuring pattern
// rather than a plain identifier binding. Two heads say so — `(` for a tuple
// pattern and `Ident {` for a struct one — either optionally preceded by
// `Ident @` naming the whole value.
//
// This is the ONE lookahead every irrefutable binding site asks, so a pattern
// head admitted at one is admitted at all of them: a `let`
// destructure, a destructuring parameter, and a `for` header. Nothing else at
// those sites can look like this — a plain `let name` declaration is followed
// by `:`, `=` or `;`, a plain parameter by `:` (or `own name :`), and
// `for x in xs` by `in`. A REFUTABLE head — `Ident (`, `Ident .` or a literal
// — is deliberately not claimed: it belongs to `let … else`, which has a miss
// branch to run. Mirrors the native parser's atPatternHead.
function at_pattern_head(p: Par): boolean {
  let i: i32 = 0;
  if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@") {
    i = 2;
  }
  if (p.peek_punct_at(i) == "(") {
    return true;
  }
  return p.peek_ident_at(i).len() > 0 && p.peek_punct_at(i + 1) == "{";
}

// DestrMarker is what a destructure StmtVar's marker channel carries beside
// its comma-joined bindings: the `@` binding naming the WHOLE value, whether
// the pattern wrote a trailing `..`, and the struct form's
// `@sd:<Struct>:<fields>` tag (empty for the tuple form).
//
// Encoded into the channel rather than given StmtVar fields of their own
// because every stage already reads it to tell the destructure forms apart —
// and the alternative is three more fields on 66 literals that none of them
// would read.
pub struct DestrMarker { at: string, rest_written: boolean, tag: string }

// destr_marker writes the channel; destr_marker_split reads it back. One
// function owns the spelling at each end, so no caller peels a component.
pub function destr_marker(at: string, rest_written: boolean, tag: string): string {
  let out: string = tag;
  if (rest_written) {
    out = "@rest;" + out;
  }
  if (at.len() > 0) {
    out = "@at:" + at + ";" + out;
  }
  return out;
}

// pp_marker tags a destructure StmtVar as the PRELUDE a destructuring
// PARAMETER was lowered to, rather than a destructure the programmer wrote —
// the leading component of the marker channel, ahead of any `@at:` / `@rest;`
// / `@sd:`.
//
// The printer reverses that lowering, spelling the parameter as its pattern
// and dropping the prelude. Nothing else in the statement distinguishes the
// two: a hand-written `let P { x, y } = p;` whose `p` is a parameter has the
// same binding list, the same marker and the same holder initialiser, so
// without this tag the body's own destructure was folded into the signature.
pub function pp_marker(rest: string): string {
  return "@pp;" + rest;
}

// is_param_prelude_marker reports whether the channel carries that tag.
pub function is_param_prelude_marker(type_name: string): boolean {
  return util.str_has_prefix(type_name, "@pp;");
}

// strip_pp_marker drops a leading `@pp;`, leaving the rest of the channel.
pub function strip_pp_marker(marker: string): string {
  if (!util.str_has_prefix(marker, "@pp;")) {
    return marker;
  }
  return slice_unchecked(marker, 4, marker.len()) + "";
}

// A leading `@pp;` is transparent here, so every other reader of the channel
// is unaffected by the tag.
pub function destr_marker_split(marker0: string): DestrMarker {
  let at: string = "";
  let m: string = strip_pp_marker(marker0);
  if (util.str_has_prefix(m, "@at:")) {
    let i: i32 = 4;
    while (i < m.len()) {
      if (m[i] == b';') {
        at = slice_unchecked(m, 4, i) + "";
        m = slice_unchecked(m, i + 1, m.len()) + "";
        break;
      }
      i = i + 1;
    }
  }
  let rest_written: boolean = false;
  if (util.str_has_prefix(m, "@rest;")) {
    rest_written = true;
    m = slice_unchecked(m, 6, m.len()) + "";
  }
  return DestrMarker { at: at, rest_written: rest_written, tag: m };
}

// is_struct_destr_marker reports whether the channel carries the struct form's
// `@sd:` tag. `is_destr_marker` is the same question for either form, asked
// where the channel would otherwise be read as a `: Type` annotation.
pub function is_struct_destr_marker(type_name: string): boolean {
  return util.str_has_prefix(destr_marker_split(type_name).tag, "@sd:");
}

pub function is_destr_marker(type_name: string): boolean {
  return util.str_has_prefix(type_name, "@pp;")
    || util.str_has_prefix(type_name, "@at:")
    || util.str_has_prefix(type_name, "@rest;")
    || util.str_has_prefix(type_name, "@sd:");
}

// parse_pattern_param consumes a destructuring parameter — `(a, b): (T, U)`
// or `Point { x, y }: Point`, either optionally preceded by a `w @` binder —
// with the cursor on the head of the pattern. Desugared exactly like the
// native parser's parseParamPattern: the param becomes a holder of the
// annotated type, and the returned ParamDestr carries the binding list the
// caller prepends to the freshly-parsed body as an ordinary destructure
// statement, so the whole feature uses the existing destructure lowering.
// The holder is named by the `@` binder when one is written, else a synthetic
// `__ptuple_<line>_<col>` uniqued by source position — the same name native
// mints, so the two compilers stay in step.
//
// Empty ParamDestr.names signals a parse problem (a malformed binding list, a
// tuple with fewer than 2 positions, or a missing `:`); callers degrade the
// same way they do for parse_param's empty-name result.
function parse_pattern_param(p: Par): (ast.ParamDecl, ParamDestr, Par) {
  let tline: i32 = p.peek_line();
  let tcol: i32 = p.peek_col();
  let bad_param: ast.ParamDecl = ast.ParamDecl { name: "", type_name: "", own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" };
  let bad: ParamDestr = ParamDestr { names: "", marker: "", synth: "", line: tline, col: tcol };
  // `w @ <pattern>` names the whole value; the binder becomes the holder, so
  // the body reads the argument under the name the source gave it.
  let holder: string = "";
  if (p.peek_ident().len() > 0 && p.peek_punct_at(1) == "@") {
    holder = p.peek_ident();
    p = p.advance();
    p = p.advance();
  }
  let names: string = "";
  let marker: string = "";
  if (p.peek_punct() == "(") {
    // The binding list is the same production a `let` destructure takes, so a
    // nested position works here too — `((a, b), c): ((i32, i32), i32)`.
    let (tnames, names_count, names_ok, names_p) = parse_destructure_names(p);
    p = names_p;
    // At least 2 positions (no-singleton-tuples rule).
    if (!names_ok || names_count < 2) {
      return (bad_param, bad, p);
    }
    names = tnames;
  } else {
    let struct_name: string = p.peek_ident();
    if (struct_name.len() == 0 || p.peek_punct_at(1) != "{") {
      return (bad_param, bad, p);
    }
    p = p.advance();
    let (binds, fields, fields_rest, fields_ok, fields_p) = parse_struct_pattern_fields(p);
    p = fields_p;
    // A struct pattern that binds nothing (`P { }`, `P { .. }`) leaves the
    // parameter unusable; native rejects it for the same reason.
    if (!fields_ok || binds.len() == 0) {
      return (bad_param, bad, p);
    }
    names = binds;
    marker = destr_marker("", fields_rest, "@sd:" + struct_name + ":" + fields);
  }
  // The annotation is required — the holder needs a type.
  if (p.peek_punct() != ":") {
    return (bad_param, bad, p);
  }
  p = p.advance();
  let (tr, tr_p) = parse_decl_type(p);
  p = tr_p;
  // A destructured parameter can't carry a default value.
  if (p.peek_punct() == "=") {
    return (bad_param, bad, p);
  }
  if (holder.len() == 0) {
    holder = "__ptuple_" + util.i32_to_string(tline) + "_" + util.i32_to_string(tcol);
  }
  return (ast.ParamDecl { name: holder, type_name: tr.name, own: false, has_default: false, default_value: e_unknown(""), fn_ret: tr.fn_ret, fn_param_types: tr.fn_params }, ParamDestr { names: names, marker: marker, synth: holder, line: tline, col: tcol }, p);
}

// prepend_param_destrs splices the desugared `let (a, b) = <holder>;` /
// `let P { x, y } = <holder>;` destructures for any destructuring parameters
// at the front of a freshly-parsed body, in parameter order.
function prepend_param_destrs(body: ast.Stmt[], destrs: ParamDestr[]): ast.Stmt[] {
  if (destrs.len() == 0) {
    return body;
  }
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < destrs.len()) {
    let d: ParamDestr = destrs[i];
    out = out.append(s_var_at(d.names, pp_marker(d.marker), e_ident_at(d.synth, d.line, d.col), d.line, d.col));
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < body.len()) {
    out = out.append(body[j]);
    j = j + 1;
  }
  return out;
}

// parse_param reads one `[own] NAME: TYPE [= DEFAULT]` parameter; `nth` is its
// position in the list, which is what tells two discarded parameters apart.
function parse_param(p: Par, nth: i32): (ast.ParamDecl, Par) {
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return (ast.ParamDecl { name: "", type_name: "", own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }, p);
  }
  // `own NAME: TYPE` — the affine-ownership modifier (move-checked by
  // the checker's E050/E051). `own` is a plain ident to the lexer, so it
  // only counts as the modifier when another ident (the real name)
  // follows; a parameter literally named `own` (no name after) is left
  // as-is.
  let is_own: boolean = false;
  if (name == "own") {
    let probe: Par = p.advance();
    if (probe.peek_ident().len() > 0) {
      is_own = true;
      p = probe;
      name = p.peek_ident();
    }
  }
  name = discard_name(name, p.peek_line(), p.peek_col(), nth);
  p = p.advance();
  if (p.peek_punct() != ":") {
    return (ast.ParamDecl { name: name, type_name: "", own: is_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }, p);
  }
  p = p.advance();
  let (tr, tr_p) = parse_decl_type(p);
  p = tr_p;
  // Optional default value: `function f(a: i32, b: i32 = 128)`.
  // fill_default_args_module fills it at call sites that omit the argument.
  let has_def: boolean = false;
  let def_val: ast.Expr = e_unknown("");
  if (p.peek_punct() == "=") {
    p = p.advance();
    let (de_expr, de_p) = parse_expr(p);
    p = de_p;
    has_def = true;
    def_val = de_expr;
  }
  return (ast.ParamDecl { name: name, type_name: tr.name, own: is_own, has_default: has_def, default_value: def_val, fn_ret: tr.fn_ret, fn_param_types: tr.fn_params }, p);
}

// parse_func_decl consumes `function name(params): ret_type { body }`
// starting from the `function` keyword. Errors leave the parser at
// the offending token; the surrounding parse_module loop turns the
// result into a degenerate FuncDecl with empty name on failure so
// the caller can spot it.

// TpList is one generic type-parameter list: the names in source order and,
// parallel to them, each one's `+`-joined trait bound ("" when unbounded).
struct TpList { tnames: string[], tbounds: string[] }

// parse_type_param_list consumes `[T]` / `[T: Bound, U]` when the cursor sits
// on `[`, else returns an empty list with the cursor untouched. The list
// follows the name; a METHOD may also write it before its receiver, and the
// printer normalises that spelling to the post-name form.
function parse_type_param_list(p: Par): (TpList, Par) {
  let names: string[] = [];
  let bounds: string[] = [];
  if (p.peek_punct() != "[") {
    return (TpList { tnames: names, tbounds: bounds }, p);
  }
  p = p.advance();
  while (!p.at_end()) {
    if (p.peek_punct() == "]") {
      break;
    }
    let tpname: string = p.peek_ident();
    if (tpname.len() == 0) {
      p = p.advance();
      continue;
    }
    p = p.advance();
    let this_bounds: string = "";
    if (p.peek_punct() == ":") {
      p = p.advance();
      // Consume `Trait (+ Trait)*`, each possibly `mod.Trait` and
      // each possibly carrying generic args (`Iterator[i32]`).
      // Accumulate the trait name(s) into this_bounds (a `+`-joined
      // list, each AS WRITTEN) so the checker can test conformance of
      // the call-site type argument (#4842) and recover a type variable
      // the bound alone mentions. A reader wanting the erased
      // monomorphisation key takes the base name of each entry.
      let go: boolean = true;
      while (go && !p.at_end()) {
        let tname: string = "";
        if (p.peek_ident().len() > 0) {
          tname = p.peek_ident();
          p = p.advance();
        }
        if (p.at_path_sep()) {
          p = p.advance();
          if (p.peek_ident().len() > 0) {
            tname = tname + "." + p.peek_ident();
            p = p.advance();
          }
        }
        // A parametrised-trait bound (`T: Iterator[i32]`) carries a
        // bracketed type-arg list after the trait name — consume the
        // balanced `[ … ]` (possibly nested) so the bound parses and
        // the function stays on the monomorphisation / IR path rather
        // than mis-parsing at the `[` and bailing.
        if (p.peek_punct() == "[") {
          let depth: i32 = 0;
          let bgo: boolean = true;
          let bargs: string = "";
          while (bgo && !p.at_end()) {
            let bpk: string = p.peek_punct();
            if (bpk == "[") {
              depth = depth + 1;
              bargs = bargs + "[";
              p = p.advance();
            } else if (bpk == "]") {
              depth = depth - 1;
              bargs = bargs + "]";
              p = p.advance();
              if (depth == 0) {
                bgo = false;
              }
            } else if (bpk == ",") {
              bargs = bargs + ", ";
              p = p.advance();
            } else {
              let bseg: string = p.peek_ident();
              if (bseg.len() == 0) {
                bseg = p.peek_keyword();
              }
              bargs = bargs + bseg;
              p = p.advance();
            }
          }
          tname = tname + bargs;
        }
        if (tname.len() > 0) {
          if (this_bounds.len() > 0) {
            this_bounds = this_bounds + "+";
          }
          this_bounds = this_bounds + tname;
        }
        if (p.peek_punct() == "+") {
          p = p.advance();
        } else {
          go = false;
        }
      }
    }
    names = names.append(tpname);
    bounds = bounds.append(this_bounds);
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == "]") {
    p = p.advance();
  }
  return (TpList { tnames: names, tbounds: bounds }, p);
}

function parse_func_decl(p: Par): (FuncDecl, Par) {
  // Caller has already peeked the `function` keyword. Consume.
  let fline: i32 = p.peek_line();
  let fcol: i32 = p.peek_col();
  p = p.advance();
  let empty_params: ast.ParamDecl[] = [];
  let empty_body: ast.Stmt[] = [];
  // Bounded type-parameter names collected from a `[T: Bound]` list
  // (empty for non-generic / unbounded-generic functions). Drives
  // monomorphisation — see FuncDecl.type_params.
  let bounded_tps: string[] = [];
  // Parallel to bounded_tps: the trait bound(s) on each collected type
  // param (a `+`-joined trait-name list; "" for a promoted unbounded
  // param). Feeds FuncDecl.bound_traits for the checker's E021 call-site
  // conformance check (#4842).
  let bound_names: string[] = [];
  // Unbounded type params, collected during the header parse and TARGETED-
  // promoted after the signature is known: an unbounded `T` is promoted to
  // the monomorphiser (so its instantiations clone) ONLY when it feeds a
  // parametric type — appearing as a type-ARGUMENT inside brackets
  // (`ArrayIter[T]`, `Option[T]`) in a param or return type. A purely-opaque
  // `T` / `T[]` (uniform 8-byte ABI) or one that surfaces only in a trait
  // bound (`count[T, I: Iterator[T]]`, where the param is `it: I`) stays
  // erased — promoting it would add an unbindable key component and inflate
  // the 512-function IR budget on the bootstrap self-compiles.
  let unbounded_tps: string[] = [];
  // Every written type parameter, bounded and unbounded, in source order.
  // Bounded names drive the monomorphiser; the whole list is what a call's
  // written type arguments bind to (E040, #9976).
  let all_tps: string[] = [];
  // A METHOD's type parameters are written BEFORE its receiver clause
  // (`function [U] (o: Option[T]) map(…)`) — the receiver's own variables
  // come from the receiver type, so a method's own cannot follow the name
  // without ambiguity. That is the spelling native's formatter emits, so a
  // stdlib formatted by `fern -fmt` has to parse here too.
  let (pre_tps, pre_p) = parse_type_param_list(p);
  p = pre_p;
  let tpi1: i32 = 0;
  while (tpi1 < pre_tps.tnames.len()) {
    all_tps = all_tps.append(pre_tps.tnames[tpi1]);
    if (p.verbatim || pre_tps.tbounds[tpi1].len() > 0) {
      bounded_tps = bounded_tps.append(pre_tps.tnames[tpi1]);
      bound_names = bound_names.append(pre_tps.tbounds[tpi1]);
    } else {
      unbounded_tps = unbounded_tps.append(pre_tps.tnames[tpi1]);
    }
    tpi1 = tpi1 + 1;
  }
  // Optional receiver clause: `function (recv: RecvType) name(…)`.
  // Distinguished from the param list by appearing before the
  // method name. A `(` immediately after `function` triggers
  // receiver-mode parsing.
  let receiver_name: string = "";
  let receiver_type: string = "";
  let receiver_own: boolean = false;
  if (p.peek_punct() == "(") {
    p = p.advance();
    receiver_name = p.peek_ident();
    // `function (own s: T) name(…)`: `own` is the modifier only when another
    // ident follows, so a receiver literally named `own` still parses.
    if (receiver_name == "own") {
      let rprobe: Par = p.advance();
      if (rprobe.peek_ident().len() > 0) {
        p = rprobe;
        receiver_name = p.peek_ident();
        receiver_own = true;
      }
    }
    if (receiver_name.len() > 0) {
      p = p.advance();
      if (p.peek_punct() == ":") {
        p = p.advance();
        let (rtr_name, rtr_fn_ret, rtr_p) = parse_type_name(p);
        p = rtr_p;
        receiver_type = rtr_name;
      }
    }
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
  }
  let name: string = p.peek_member_name();
  if (name.len() == 0) {
    return (FuncDecl { stdlib: "", no_inline: false, name: "", receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: [], bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
  }
  p = p.advance();
  // Generic type parameters written AFTER the name (`name[T: Bound, U]`).
  let (post_tps, post_p) = parse_type_param_list(p);
  p = post_p;
  let tpi0: i32 = 0;
  while (tpi0 < post_tps.tnames.len()) {
    all_tps = all_tps.append(post_tps.tnames[tpi0]);
    // type_params carries only the BOUNDED ones — the unbounded ones are
    // erased and the monomorphiser has no use for their names, so they are
    // dropped. `-fmt` keeps the whole list in source order instead: a
    // formatted `function each[T, U](…)` that loses `[T, U]` leaves every
    // T and U in the signature unbound (#6773).
    if (p.verbatim || post_tps.tbounds[tpi0].len() > 0) {
      bounded_tps = bounded_tps.append(post_tps.tnames[tpi0]);
      bound_names = bound_names.append(post_tps.tbounds[tpi0]);
    } else {
      unbounded_tps = unbounded_tps.append(post_tps.tnames[tpi0]);
    }
    tpi0 = tpi0 + 1;
  }
  if (p.peek_punct() != "(") {
    return (FuncDecl { stdlib: "", no_inline: false, name: name, receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: all_tps, bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
  }
  p = p.advance();
  let params: ast.ParamDecl[] = [];
  // Destructuring params: the desugars, prepended to the body (as
  // destructure statements) after parse_block below.
  let pd: ParamDestr[] = [];
  if (p.peek_punct() != ")") {
    while (true) {
      if (at_pattern_head(p)) {
        let (tpr_param, tpr_destr, tpr_p) = parse_pattern_param(p);
        p = tpr_p;
        if (tpr_destr.names.len() == 0) {
          return (FuncDecl { stdlib: "", no_inline: false, name: "", receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: [], bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
        }
        params = params.append(tpr_param);
        pd = pd.append(tpr_destr);
        if (p.peek_punct() == ",") {
          p = p.advance();
          if (p.peek_punct() == ")") {
            break;
          }
          continue;
        }
        break;
      }
      let (pr_param, pr_p) = parse_param(p, params.len());
      p = pr_p;
      params = params.append(pr_param);
      // Trailing comma before `)` — see the note in the arrow-lambda
      // parameter loop (#6354).
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == ")") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == ")") {
    p = p.advance();
  }
  let ret_type: string = "";
  // The returned fn value's own signature, for the two FuncDecl sidecars.
  let fn_ret_fn_ret: string = "";
  let fn_ret_fn_ptys: string = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    let (fr, fr_tr_p) = parse_decl_type(p);
    p = fr_tr_p;
    ret_type = fr.name;
    fn_ret_fn_ret = fr.fn_ret;
    fn_ret_fn_ptys = fr.fn_params;
  }
  // Targeted promotion: promote an unbounded type param only when BOTH
  //   (a) it feeds a parametric type — appears as a bracketed type-argument
  //       (`ArrayIter[T]`) in a param or the return type, so a struct/enum
  //       clone needs its concrete value; AND
  //   (b) it is bindable from a param — appears as a standalone token at
  //       paren-depth 0 in some param type (`xs: T[]`, `b: Box[T]`), the
  //       positions `bind_unify` actually unifies. A `T` reachable only via
  //       the RETURN (`find[T, I](…): Option[T]`) or inside a function-type /
  //       tuple param (`(T) => boolean`) is not bindable by THIS test, so
  //       promoting it here would mint an incomplete instantiation key and
  //       the call site would fail to resolve. `of[T](xs: T[]): ArrayIter[T]`
  //       satisfies both; `nth` / `count` satisfy neither and stay erased.
  //       Clause (c-fn) below reaches the function-type param case, reading
  //       the sidecars this test cannot see and binding through infer_inst's
  //       own fn-param clauses — so `find` promotes there, not here.
  // The DECLARED bounds, before this loop appends promoted vars to the same
  // list: a declaration carrying one is cloned whatever happens here, which
  // is what clause (c-fn) below keys on.
  let declared_bound: boolean = bounded_tps.len() > 0;
  let ui: i32 = 0;
  while (ui < unbounded_tps.len()) {
    let un: string = unbounded_tps[ui];
    // (a) feeds: a user-parametric type-arg (struct/enum clone needs it) OR a
    //     Map[...] key/value position. The Map case is the IR-codegen sibling
    //     of the struct-clone case: a generic body's map ops read the concrete
    //     key-kind off the param/return type, so an erased `Map[K, V]` would
    //     default to string-key dispatch and miscompile an i32-keyed map
    //     (`from[K, V](pairs: (K, V)[]): Map[K, V]`). #map-generic.
    let feeds: boolean = feeds_user_parametric(ret_type, un) || feeds_map_typearg(ret_type, un);
    let bindable: boolean = false;
    let pj: i32 = 0;
    while (pj < params.len()) {
      if (feeds_user_parametric(params[pj].type_name, un) || feeds_map_typearg(params[pj].type_name, un)) {
        feeds = true;
      }
      // (b) bindable: a standalone token at paren-depth 0, OR inside a tuple /
      //     tuple-array param — bind_unify now destructures `(K, V)` parens,
      //     so a `(K, V)[]` param recovers both vars from the call's argument.
      if (token_at_paren_depth0(params[pj].type_name, un) || token_in_tuple_param(params[pj].type_name, un)) {
        bindable = true;
      }
      pj = pj + 1;
    }
    // (b′) return-bindable: a param reachable only through the RETURN's
    // user-parametric / Map position (`mk[T](): Box[T]`, `set_new[T]():
    // Set[T]`) is bindable from the call-site ANNOTATION via infer_inst_ret's
    // return-type-directed instantiation (mono_var_init) — the annotated-var
    // context a no-argument generic CONSTRUCTOR is always used in. Without
    // promotion its erased body's generic struct literal (`Box { xs: [] }`)
    // can't lower, so the whole module bails (std/set's set_new → segfault). Builtin returns (Option[T] / Result[T,E]) are erased-safe
    // and stay unpromoted: feeds_user_parametric excludes their bases, so a
    // `find[T,I](): Option[T]` — bindable from NO call site — is untouched.
    let ret_bindable: boolean = feeds_user_parametric(ret_type, un) || feeds_map_typearg(ret_type, un);
    let promote: boolean = feeds && (bindable || ret_bindable);
    // (c) wide-container promotion: an erased fn that takes a BARE-SCALAR
    // param (`x: T`, which carries a wide i64/f64 value) and RETURNS a
    // BUILTIN container of it (`Option[T]` / `T[]` / `Result[T, …]`) is
    // erased-safe on the register backends but NOT on wasm — the container's
    // box LAYOUT shifts with payload width (an Option is 8B/@4 for i32 but
    // 16B/@8 for i64/f64; an array stride is 4 vs 8), so a wide value returned
    // in an erased container can't be read back unambiguously. Monomorphising
    // to a CONCRETE container (`some1__i64(x: i64): Option[i64]`) makes every
    // backend lower it via the existing container path, so the wasm module no
    // longer bails. The bare-scalar-param gate excludes `map`/`filter`
    // (ARRAY params — the wide value is behind an i32 array pointer, never trips
    // the erased-wide gate, and promoting them would over-monomorphise the
    // stdlib). `x: T` is bindable from the call arg, so the clone's T resolves.
    //
    // Guarded to SINGLE-type-param functions (`all_tps.len() == 1`): promoting
    // ONE var of a multi-param generic leaves the sibling erased in the clone
    // (`scan[T, A](xs: T[], init: A, f: (A, T) => A): A[]` — promoting A binds
    // A but keeps T erased, a malformed `scan__i32` with `xs: T[]` that
    // crashes). A single-param fn has no sibling to strand, so the clone is
    // fully concrete. Most multi-param container generics stay erased (e.g.
    // scan's `A[]` return); the one exception is the two-let Result[T, E] shape,
    // now closed by clause (c′) below (it promotes BOTH vars, so nothing is
    // stranded).
    if (all_tps.len() == 1 && has_bare_scalar_param(params, un) && feeds_wide_container(ret_type, un)) {
      promote = true;
    }
    // (c-arr) the ARRAY-param sibling: `reverse[T](xs: T[]): T[]`. The note
    // above excluded these on the grounds that a wide value "is behind an i32
    // array pointer, never trips the erased-wide gate" — half of which was
    // wrong. Nothing wide is passed by value, so the gate never fired, but
    // the ELEMENT width is erased too, and on wasm32 the callee then copies
    // an 8-byte-element array at a 4-byte stride: silently wrong values
    // (#6238). Promoting clones the generic per concrete element type, which
    // gives the copy a real stride.
    //
    // The trigger is ANY mention of the var in the return, not a list of
    // container spellings. That started as `feeds_wide_container`, then grew a
    // bare-typevar case for #6273 — and the spelling after that,
    // `pair_of[T](xs: T[]): (T, T)`, was wrong again, as was the `(i32, T)[]`
    // of `array.enumerate`. Every one of them is the same defect with a
    // different return type, so the condition asks the question that actually
    // matters: does the CALL SITE have to know what came back?
    //
    // On wasm the reason is the erased element stride. On the REGISTER
    // backends — where the 8-byte slot makes the stride harmless — the reason
    // is the result type: an erased `T` result reaches a `.len()` as an ARRAY
    // receiver, so `first_of(strs).len()` loads offset 0 (the array length)
    // instead of offset 8 (the string length) and yields 0; f64 and i64 go
    // wrong for the mirror-image reason. Nothing wide is passed by value in
    // either case, so the erased-wide gate never fires and the module lowers
    // silently. The clone is what gives the call site a concrete result.
    //
    // FREE FUNCTIONS ONLY, and that guard is doing the same job as
    // `all_tps.len() == 1`. A METHOD's receiver carries its own type var,
    // which is not in `type_params` and so is not counted — so
    // `pub function (xs: T[]) zip[U](other: U[]): (T, U)[]` reads as a
    // single-var generic while `T` is right there in the return. Promoting
    // `U` alone strands `T` erased in the clone, the malformed-clone hazard
    // the count guard exists to prevent, and `a.zip(b)` fell off the IR path
    // entirely. Free functions have no receiver var to strand.
    if (receiver_type.len() == 0 && all_tps.len() == 1 && has_bare_array_param(params, un) && type_mentions_var(ret_type, un)) {
      promote = true;
    }
    // (c′) genuinely two-typevar Result[T, E] with a bare-scalar param — the
    // `okg[T, E](x: T): Result[T, E]` shape clause (c) leaves open. Promoting
    // ONLY the wide param strands the other var erased on the Err arm
    // (`Result[i64, E]`), reintroducing the wasm box-width ambiguity, so BOTH
    // vars of the pair are promoted (this clause is var-independent, so it fires
    // for each). T binds from the bare-scalar arg; the return-only E binds from
    // the call-site annotation via infer_inst_ret (bind_unify of `Result[T, E]`
    // against the expected `Result[i64, string]`). The fully-concrete clone
    // (`okg__i64_string(x: i64): Result[i64, string]`) lowers on the wasm IR
    // path where the erased two-var Result cannot. Like the return-only
    // constructor promotion (clause b′), an UNANNOTATED `okg(5)` leaves E unbound
    // and the dropped template becomes an undefined reference — the same accepted
    // constraint. No compiler/stdlib generic matches this shape, so the bootstrap
    // is untouched (byte-identity holds with nothing to monomorphise).
    if (all_tps.len() == 2 && result_two_bare_vars(ret_type, unbounded_tps) && has_any_bare_scalar_param(params, unbounded_tps)) {
      promote = true;
    }
    // (c'') a single-typevar fn with a bare-scalar param whose RETURN is fully
    // CONCRETE — `eqf[T](a: T, b: T): boolean`. The value never leaves through
    // the type variable, so neither the widening path nor clause (c) covers it:
    // the widening path requires the return to BE the let (a pass-through) or a
    // bare tuple of it, and feeds_wide_container requires the return to CONTAIN
    // it.
    //
    // Left erased, this is a SILENT MISCOMPILE on wasm, not a bail. An erased
    // param is typed i32 there, so an i64 argument crosses the boundary as a box
    // POINTER and a body that USES the value compares/operates on the pointer:
    // `eqf(x, y)` with two equal i64s returns false, because the two boxes are
    // distinct. (The register backends are unaffected — their erased slots are
    // 8 bytes, so the same body emits a `cmpq` and is correct.) Widening the
    // params cannot fix it: the body's operation is width-SENSITIVE, which is
    // exactly why erased_passthrough_safe excludes bodies that use the var.
    // Monomorphising to `eqf__i64(a: i64, b: i64): boolean` gives the body a
    // concrete width and the wasm IR path lowers it correctly.
    //
    // NOTHING in the stdlib or the compiler matches this shape (a scan of every
    // `function f[T](… : T …): <concrete>` found zero), so the bootstrap
    // monomorphises nothing new and byte-identity holds — the same argument
    // clause (c') rests on. The `all_tps.len() == 1` guard carries the same
    // no-stranded-sibling rationale as clause (c).
    // Not guarded to ONE type var, unlike clause (c). The stranded-sibling
    // hazard clause (c) guards against is a var that survives ERASED in the
    // clone; here every var is required to be bound by a bare-scalar param
    // (all_bare_scalar_bound) and none appears in the return, so promoting the
    // set leaves nothing behind — `both[T, U](a: T, b: U): boolean` clones as
    // `both__i64_i64`, fully concrete. Without the multi-var case the same
    // silent miscompile survives one variable further out.
    if (has_bare_scalar_param(params, un) && !ret_mentions_any(ret_type, unbounded_tps)
      && all_bare_scalar_bound(params, unbounded_tps)) {
      promote = true;
    }
    // (c-fn) the FN-PARAM sibling of (c) and (c-arr). `filter[T, I:
    // Iterator[T]](it: I, keep: (T) => boolean): T[]` reaches T in no
    // parameter type of its own — `it: I` binds I, and T lives inside
    // `keep`'s ARGUMENT, which token_at_paren_depth0 deliberately does not
    // reach. The DECLARED bound on I makes the clone happen regardless, so
    // T survives erased in it: the malformed stranded-sibling clone clause
    // (c) guards against, arrived at from the other direction. The residual
    // T then reads as pointer-shaped, and on wasm32 the funcref type a
    // call_indirect dispatches through says i32 while the call pushes an
    // f64 — a module wasmtime rejects (#9488).
    //
    // Keyed on a DECLARED bound rather than `all_tps.len() == 1`: that bound
    // is what makes the clone happen, and a declared-bounded sibling is
    // substituted either way, so it is never the sibling this strands. The
    // erased ones must ALL be reachable through a fn param, so promoting
    // the set leaves nothing behind — the same argument clause (c′) makes.
    // `map[T, U, I: Iterator[T]]` needs exactly that: T from the lambda's
    // argument, U from its result. The bindings come from infer_inst's two
    // fn-param clauses, which are what make a promoted let resolvable.
    if (declared_bound && all_fn_param_bound(params, unbounded_tps)) {
      promote = true;
    }
    if (promote) {
      bounded_tps = bounded_tps.append(un);
      bound_names = bound_names.append("");
    }
    ui = ui + 1;
  }
  // A body-less function (`function f(): T;`) is an extern import
  // declaration — the caller's `@import` attribute supplies its WIT binding.
  // Otherwise parse the block body.
  if (p.peek_punct() == ";") {
    p = p.advance();
    // A body-less decl is an `@import` signature — a destructured
    // param has nothing to bind into, so degrade to the empty-name
    // FuncDecl the caller treats as a parse failure.
    if (pd.len() > 0) {
      return (FuncDecl { stdlib: "", no_inline: false, name: "", receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: empty_params, ret_type: "", body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: [], bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
    }
    return (FuncDecl { stdlib: "", no_inline: false, name: name, receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: params, ret_type: ret_type, body: empty_body, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: all_tps, bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: fn_ret_fn_ret, ret_fn_param_types: fn_ret_fn_ptys, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
  }
  let (blk_body, blk_p) = parse_block(p);
  p = blk_p;
  let fbody: ast.Stmt[] = prepend_param_destrs(blk_body, pd);
  // (d) threaded-accumulator promotion, the one clause that needs the BODY: a
  // bare-let param (`acc: T`) the body REASSIGNS (`acc = visit(st, acc)`) is a
  // value the frame rebinds without knowing its type, so the lowering cannot
  // tell an array it must release from a scalar it must not — the walker
  // frames every accumulator threads through (`fold_stmt_nodes[T]`) orphaned
  // one buffer per grow that way. Cloning per instantiation gives the rebind
  // a concrete type; the bare param binds T from the call argument. Free
  // functions only, for the same no-stranded-sibling reason as clause (c).
  //
  // A `let a: T` local is the same blindness one binding over, and the two
  // travel together through mutually recursive walkers (`map_stmt_acc` binds
  // `let a: T`, `map_stmts_acc` reassigns `acc`): a promoted callee's template
  // is dropped, so an erased caller of it would dangle. Hence the clause fires
  // on either binding, and promotes EVERY still-erased var of the function at
  // once — only when each is bindable from a param (the clause-(b) test), so
  // the clone is fully concrete and the call site can resolve it.
  // (e) the BODY sibling of clause (a): a body that spells a user generic type
  // at one of the function's erased vars (`let c: Slot[T]`, `Slot[T] { … }`,
  // a lambda's `(b: Box[T])`) has the front end clone that struct at the var
  // itself, `Slot__0_T`, whose fields keep the var. The AST lowering's erased
  // slot cannot say how wide a field is (the typed lowering declares one
  // record per binding, semlower.instance_records). Cloning the function per
  // binding clones the struct with it. Same all-bindable guard as (d).
  if (receiver_type.len() == 0 && (body_binds_bare_var(fbody, params, unbounded_tps, bounded_tps)
    || body_feeds_user_parametric(fbody, erased_only(unbounded_tps, bounded_tps)))) {
    let all_bindable: boolean = true;
    let di: i32 = 0;
    while (di < unbounded_tps.len()) {
      let dn: string = unbounded_tps[di];
      if (util.index_of_str(bounded_tps, dn) < 0) {
        let dbind: boolean = false;
        let dpj: i32 = 0;
        while (dpj < params.len()) {
          if (token_at_paren_depth0(params[dpj].type_name, dn) || token_in_tuple_param(params[dpj].type_name, dn)) {
            dbind = true;
          }
          dpj = dpj + 1;
        }
        // A var only a fn-typed param carries binds through infer_inst's
        // fn-param clauses, from the lambda or function passed for it.
        if (has_fn_param_arg_var(params, dn) || has_fn_param_ret_var(params, dn)) {
          dbind = true;
        }
        if (!dbind) {
          all_bindable = false;
        }
      }
      di = di + 1;
    }
    if (all_bindable) {
      let dk: i32 = 0;
      while (dk < unbounded_tps.len()) {
        if (util.index_of_str(bounded_tps, unbounded_tps[dk]) < 0) {
          bounded_tps = bounded_tps.append(unbounded_tps[dk]);
          bound_names = bound_names.append("");
        }
        dk = dk + 1;
      }
    }
  }
  return (FuncDecl { stdlib: "", no_inline: false, name: name, receiver_name: receiver_name, receiver_type: receiver_type, receiver_own: receiver_own, type_params: bounded_tps, params: params, ret_type: ret_type, body: fbody, line: fline, col: fcol, import_iface: "", import_wit: "", all_type_params: all_tps, bound_traits: bound_names, fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: false, ret_fn_ret: fn_ret_fn_ret, ret_fn_param_types: fn_ret_fn_ptys, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
}

function parse_struct_field(p: Par): (StructFieldDecl, Par) {
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return (StructFieldDecl { name: "", type_name: "", fn_ret: "", fn_param_types: "" }, p);
  }
  p = p.advance();
  if (p.peek_punct() != ":") {
    return (StructFieldDecl { name: name, type_name: "", fn_ret: "", fn_param_types: "" }, p);
  }
  p = p.advance();
  return parse_field_type(p, name);
}

// Struct and enum payload fields preserve the same callable declaration data.
function parse_field_type(p: Par, name: string): (StructFieldDecl, Par) {
  let (ty, end) = parse_decl_type(p);
  return (StructFieldDecl { name: name, type_name: ty.name, fn_ret: ty.fn_ret, fn_param_types: ty.fn_params }, end);
}

// parse_decl_tparams reads a declaration's optional type-parameter list
// (`[T, U]`) after its name, consuming the brackets; the names are the
// bracket's top-level identifiers.
function parse_decl_tparams(p: Par): (string[], Par) {
  let tparams: string[] = [];
  if (p.peek_punct() != "[") {
    return (tparams, p);
  }
  p = p.advance();  // consume `[`
  let gd: i32 = 1;
  while (!p.at_end() && gd > 0) {
    let gpk: string = p.peek_punct();
    if (gpk == "[") {
      gd = gd + 1;
      p = p.advance();
      continue;
    }
    if (gpk == "]") {
      gd = gd - 1;
      p = p.advance();
      continue;
    }
    if (gd == 1) {
      let tpn: string = p.peek_ident();
      if (tpn.len() > 0) {
        tparams = tparams.append(tpn);
      }
    }
    p = p.advance();
  }
  return (tparams, p);
}

// parse_struct_decl consumes `struct Name { field, field, … }`
// starting from the `struct` keyword. Fields may be separated
// by `,` or terminated without one (last field's trailing `,`
// is optional). Errors leave the parser at the offending token;
// surrounding parse_module recovers via the StructDecl with
// empty name.

// The i32[] result is the source line of each field, for the formatter
// (FieldLines). Empty on every early return, since a decl the parser could not
// read has no fields to place comments against.
function parse_struct_decl(p: Par): (StructDecl, i32[], Par) {
  let sline: i32 = p.peek_line();
  let scol: i32 = p.peek_col();
  let flines: i32[] = [];
  p = p.advance();  // consume `struct`
  let name: string = p.peek_ident();
  let notp0: string[] = [];
  if (name.len() == 0) {
    let empty: StructFieldDecl[] = [];
    return (StructDecl { name: "", fields: empty, type_params: notp0, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false }, flines, p);
  }
  p = p.advance();
  // Optional generic type parameters: `struct Box[T] { … }`. Captured
  // so the monomorphiser can clone a concrete struct per instantiation
  // (the field layout is uniform, but the per-instantiation field
  // TYPES drive primitive/string method dispatch).
  let (tparams, tp_p) = parse_decl_tparams(p);
  p = tp_p;
  if (p.peek_punct() != "{") {
    let empty: StructFieldDecl[] = [];
    return (StructDecl { name: name, fields: empty, type_params: tparams, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false }, flines, p);
  }
  p = p.advance();
  let fields: StructFieldDecl[] = [];
  if (p.peek_punct() != "}") {
    while (true) {
      let fline: i32 = p.peek_line();
      let (fr_field, fr_p) = parse_struct_field(p);
      p = fr_p;
      fields = fields.append(fr_field);
      flines = flines.append(fline);
      // A trailing comma before `}` must not start another (empty-named)
      // field — mirrors the struct-literal parser and the Go parser.
      if (p.peek_punct() == ",") {
        p = p.advance();
        if (p.peek_punct() == "}") {
          break;
        }
        continue;
      }
      break;
    }
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (StructDecl { name: name, fields: fields, type_params: tparams, derives: [], line: sline, col: scol, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false }, flines, p);
}

// parse_type_alias consumes `type Name[T, …] = V1[T] | V2 | … ;` starting
// from the `type` keyword. Empty variant lists (`type X = ;`)
// produce an alias with no variants — the checker rejects them,
// but parsing stays lenient so error recovery proceeds. The
// trailing semicolon is consumed if present.

function parse_type_alias(p: Par): (TypeAlias, Par) {
  // E016 (alias name collides with a struct/enum) is reported at the
  // `type` keyword.
  let taline: i32 = p.peek_line();
  let tacol: i32 = p.peek_col();
  p = p.advance();  // consume `type`
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return (TypeAlias { name: "", variants: [], variant_args: [], variant_lines: [], type_params: [], line: taline, col: tacol, is_pub: true, is_package: false, module: "" }, p);
  }
  p = p.advance();
  let (tparams, tp_p) = parse_decl_tparams(p);
  p = tp_p;
  if (p.peek_punct() != "=") {
    return (TypeAlias { name: name, variants: [], variant_args: [], variant_lines: [], type_params: tparams, line: taline, col: tacol, is_pub: true, is_package: false, module: "" }, p);
  }
  p = p.advance();  // consume `=`
  let variants: string[] = [];
  let vargs: string[] = [];
  let vlines: i32[] = [];
  while (p.peek_ident().len() > 0) {
    vlines = vlines.append(p.peek_line());
    // A member is a type spelling: its base names the struct, and its
    // arguments, if any, are kept as written.
    let (dt, dt_p) = parse_decl_type(p);
    p = dt_p;
    let r: TypeRef = parse_type_ref(dt.name);
    variants = variants.append(r.base);
    vargs = vargs.append(type_ref_args_spelling(r));
    if (p.peek_punct() == "|") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (TypeAlias { name: name, variants: variants, variant_args: vargs, variant_lines: vlines, type_params: tparams, line: taline, col: tacol, is_pub: true, is_package: false, module: "" }, p);
}

// type_ref_args_spelling is a type reference's argument list as one
// spelling (`Map[K, V]` gives "K, V"), "" when it has none.
function type_ref_args_spelling(r: TypeRef): string {
  let out: string = "";
  for a in r.args {
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + me_ref_spelling(a);
  }
  return out;
}

// parse_enum_decl consumes a Rust-style `enum Name { V1, V2(T), V3 { f: U }, … }`
// starting from the `enum` keyword. Each variant is lowered to a
// StructDecl: a payload-bearing variant `V2(T)` becomes a struct with
// a single marker field `__ev` of the payload type; a no-payload
// variant `V1` becomes a zero-field struct; a record-form variant
// `V3 { f: U }` uses the same positional `__ev` markers and records the
// written names in variant_field_names. The marker field is how
// the emitter tells an enum variant (bind the payload at offset 8)
// from a `type X = A|B` union member (bind the whole struct). Only the
// first payload of a multi-payload variant is bound; extras are
// consumed. The enum's own name isn't recorded — variant names are
// global, as with the existing union machinery.

function parse_enum_decl(p: Par): (string, StructDecl[], string[], i32[], Par) {
  p = p.advance();  // consume `enum`
  let out: StructDecl[] = [];
  let vlines: i32[] = [];
  let name: string = p.peek_ident();
  if (name.len() == 0) {
    return ("", out, [], vlines, p);
  }
  p = p.advance();
  // Optional generic type parameters: `enum Opt[T] { … }`. Captured so the
  // monomorphiser can clone a concrete enum per instantiation (the variant
  // payload TYPES are substituted, like a generic struct's fields). Mirrors
  // the `struct Box[T]` parse above.
  let (tparams, tp_p) = parse_decl_tparams(p);
  p = tp_p;
  if (p.peek_punct() != "{") {
    return (name, out, tparams, vlines, p);
  }
  p = p.advance();
  while (p.peek_punct() != "}" && !p.at_end()) {
    let vline: i32 = p.peek_line();
    let vname: string = p.peek_ident();
    if (vname.len() == 0) {
      break;
    }
    p = p.advance();
    let fields: StructFieldDecl[] = [];
    let vfnames: string[] = [];
    if (p.peek_punct() == "{") {
      // Record-form variant `V { f: T, g: U }`. The payload fields keep the
      // positional `__ev` / `__ev<k>` marker names, so the layout and every
      // downstream `__ev` test match the positional form exactly; the written
      // names are also recorded in variant_field_names for the checker, the
      // printer, and the named-pattern resolution.
      p = p.advance();
      let rnum: i32 = 0;
      while (p.peek_punct() != "}" && !p.at_end()) {
        let rfname: string = p.peek_ident();
        if (rfname.len() == 0) {
          break;
        }
        p = p.advance();
        if (p.peek_punct() == ":") {
          p = p.advance();
        }
        let mark: string = "__ev";
        if (rnum > 0) {
          mark = "__ev" + dl_itoa(rnum);
        }
        let (rf, rf_p) = parse_field_type(p, mark);
        p = rf_p;
        fields = fields.append(rf);
        vfnames = vfnames.append(rfname);
        rnum = rnum + 1;
        if (p.peek_punct() == ",") {
          p = p.advance();
          continue;
        }
        break;
      }
      if (p.peek_punct() == "}") {
        p = p.advance();
      }
    } else if (p.peek_punct() == "(") {
      p = p.advance();
      let (tr, tr_p) = parse_field_type(p, "__ev");
      p = tr_p;
      // A multi-payload variant `V(A, B, …)` keeps every payload as a field
      // `__ev`, `__ev1`, `__ev2`, … (the first stays `__ev` so the existing
      // "is this a payloaded variant?" checks that look for `__ev` still
      // fire). Codegen indexes them by position.
      fields = fields.append(tr);
      let pnum: i32 = 1;
      while (p.peek_punct() == ",") {
        p = p.advance();
        let (tr2, tr2_p) = parse_field_type(p, "__ev" + dl_itoa(pnum));
        p = tr2_p;
        fields = fields.append(tr2);
        pnum = pnum + 1;
      }
      if (p.peek_punct() == ")") {
        p = p.advance();
      }
    }
    out = out.append(StructDecl { name: vname, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: name, must_consume: false, variant_field_names: vfnames, is_pub: true, is_package: false });
    vlines = vlines.append(vline);
    if (p.peek_punct() == ",") {
      p = p.advance();
      continue;
    }
    break;
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  return (name, out, tparams, vlines, p);
}

// parse_import consumes `import "path";` starting from the
// `import` keyword. The path string is captured verbatim; the
// trailing semicolon is consumed when present. A missing path is
// reported, the rest of the declaration is skipped, and the caller
// records no import for it.

function parse_import(p: Par): (Import, ast.Stmt[], Par) {
  let imp_line: i32 = p.peek_line();
  p = p.advance();  // consume `import`
  let path: string = "";
  let bad: ast.Stmt[] = [];
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokString(s) => {
      path = s.value;
      p = p.advance();
    },
    _ => {
      bad = bad.append(decl_sentinel(p, "malformed import: its path could not be read"));
      return (Import { path: "", is_reexport: false, reexport_names: [], alias: "", line: imp_line, resolved: "" }, bad, sync_to_top_level(p));
    }
  }
  // Optional `as <ident>` alias clause (`import "std/io_buffered" as io`): the
  // alias becomes the qualifier for `io.foo` references; flatten maps it back to
  // the module's mangle prefix (basename). An alias equal to the basename is the
  // common, redundant form. `as` is a keyword (peek_keyword, like the cast `x as
  // T`), so it never collides with an identifier.
  let alias: string = "";
  if (p.peek_keyword() == "as") {
    p = p.advance();  // consume `as`
    alias = p.peek_ident();
    if (alias.len() > 0) {
      p = p.advance();
    } else {
      bad = bad.append(decl_sentinel(p, "malformed import alias: its name could not be read (a keyword such as `type` or `match` cannot be a name)"));
    }
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (Import { path: path, is_reexport: false, reexport_names: [], alias: alias, line: imp_line, resolved: "" }, bad, p);
}

// parse_pubuse consumes `use "path".{name1, name2, …};` (cursor on the
// `use` keyword; a leading `pub` is stripped by the caller). It returns
// an Import flagged `is_reexport` carrying the re-exported names, so the
// loader pulls in the target module and the bundler can redirect a
// consumer's `facade.name` to the target's mangled symbol. A missing path
// is reported, the rest of the declaration is skipped, and the caller
// records no import for it.
function parse_pubuse(p: Par): (Import, ast.Stmt[], Par) {
  let pu_line: i32 = p.peek_line();
  p = p.advance();  // consume `use`
  let path: string = "";
  let bad: ast.Stmt[] = [];
  let t: lexer.Token = p.peek();
  match (t) {
    lexer.TokString(s) => {
      path = s.value;
      p = p.advance();
    },
    _ => {
      bad = bad.append(decl_sentinel(p, "malformed re-export: its path could not be read"));
      return (Import { path: "", is_reexport: true, reexport_names: [], alias: "", line: pu_line, resolved: "" }, bad, sync_to_top_level(p));
    }
  }
  if (p.at_path_sep()) {
    p = p.advance();
  }
  let names: string[] = [];
  if (p.peek_punct() == "{") {
    p = p.advance();
    while (!p.at_end() && p.peek_punct() != "}") {
      let nm: string = p.peek_ident();
      if (nm.len() > 0) {
        names = names.append(nm);
        p = p.advance();
      }
      if (p.peek_punct() == ",") {
        p = p.advance();
        continue;
      }
      if (p.peek_punct() == "}") {
        continue;
      }
      // Unexpected token: report it, then step past it to avoid spinning.
      if (nm.len() == 0) {
        bad = bad.append(decl_sentinel(p, "malformed re-export: a name in the list could not be read (a keyword such as `type` or `match` cannot be a name)"));
        p = p.advance();
      }
    }
    if (p.peek_punct() == "}") {
      p = p.advance();
    }
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (Import { path: path, is_reexport: true, reexport_names: names, alias: "", line: pu_line, resolved: "" }, bad, p);
}

// parse_const_decl consumes `const NAME[: T] = EXPR;` (cursor on the
// `const` keyword) and returns it as a zero-arg FuncDecl returning
// EXPR — so the rest of the pipeline + the emitter reuse the existing
// function machinery, and a bare `NAME` reference becomes a call.
function parse_const_decl(p: Par): (FuncDecl, Par) {
  // The const's own position and an is_const marker are stored on the desugared
  // FuncDecl. Both are needed downstream: printer.print_module skips decls
  // with no source position (that is how `@derive`'s synthesised methods stay
  // out of the output), and without the marker a const is indistinguishable
  // from a hand-written zero-arg function — the two have identical AST shape,
  // so a printer guessing from shape would rewrite real functions into
  // consts.
  let cline: i32 = p.peek_line();
  let ccol: i32 = p.peek_col();
  p = p.advance();  // consume `const`
  // An identifier or nothing: check_decl_names refuses a nameless const.
  let name: string = p.peek_ident();
  if (name.len() > 0) {
    p = p.advance();
  }
  let ty: string = "";
  if (p.peek_punct() == ":") {
    p = p.advance();
    let (tr_name, tr_fn_ret, tr_p) = parse_type_name(p);
    p = tr_p;
    ty = tr_name;
  }
  if (p.peek_punct() == "=") {
    p = p.advance();
  }
  let (er_expr, er_p) = parse_expr(p);
  p = er_p;
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  let body: ast.Stmt[] = [];
  body = body.append(s_return(er_expr));
  let noparams: ast.ParamDecl[] = [];
  let notp: string[] = [];
  return (FuncDecl { stdlib: "", no_inline: false, name: name, receiver_name: "", receiver_type: "", receiver_own: false, type_params: notp, params: noparams, ret_type: ty, body: body, line: cline, col: ccol, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: true, is_pub: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [] }, p);
}

// struct_declared reports whether `structs` already contains a struct
// (or synthesized enum variant) with the given name.
function struct_declared(structs: StructDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// A name the module already uses for an ENUM is taken too: an enum desugars to
// its variant structs, which carry the owner's name rather than declaring one,
// so struct_declared alone does not see it and a builtin struct of that name
// would shadow the enum at every annotation.
function name_declared(structs: StructDecl[], name: string): boolean {
  if (struct_declared(structs, name)) {
    return true;
  }
  for sd in structs {
    if (sd.enum_owner == name) {
      return true;
    }
  }
  return false;
}

// add_builtin_variant appends a synthesized enum-variant struct (a
// payload variant carries the marker field "__ev"; a no-payload variant
// has zero fields — same lowering as parse_enum_decl) unless a struct of
// that name is already declared.
function add_builtin_variant(acc: StructDecl[], name: string, payload_type: string, enum_name: string): StructDecl[] {
  if (struct_declared(acc, name)) {
    return acc;
  }
  let fields: StructFieldDecl[] = [];
  if (payload_type.len() > 0) {
    fields = fields.append(StructFieldDecl { name: "__ev", type_name: payload_type, fn_ret: "", fn_param_types: "" });
  }
  return acc.append(StructDecl { name: name, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: enum_name, must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
}

// builtin_function_names is the set of compiler builtins callable without a
// declaration — the front-end's intrinsics + lowered runtime helpers. It lives
// here, in the front end, because TWO consumers read it: the checker's
// undefined-callee rule (checker.is_resolvable_callee, E001) and the emitters'
// pre-codegen undefined-call gate (asmcore.check_undefined_calls). A single
// list means a new builtin is registered once instead of being remembered in
// two places — the drift that made a whitelist look unassemblable (#5644).
// Runtime intrinsics are all `__`-prefixed and handled by the callers' prefix
// test; this is the user-facing / lowered-helper set, a superset of the Go
// checker's FuncSigs builtins. Over-inclusion is safe for both consumers (it
// only suppresses a diagnostic), so the list errs toward completeness.
pub function builtin_function_names(): string[] {
  return [
    // I/O + process + environment
    "print", "write", "eprint", "putchar",
    "exit", "args", "set_args", "env", "config_get", "subprocess",
    // Crash-only supervision (docs/CRASH-ONLY-SERVE.md D2'): fork the
    // process / exec into another program / reap a child. std/serve's
    // supervise is the stdlib caller of the first and last;
    // asm_modload_run's batched per-module orchestrator uses all three.
    "proc_fork", "proc_waitpid", "proc_waitpid_nohang", "proc_exec",
    // The raw wait status, for the core-dump bit the decode drops.
    "proc_waitpid_status",
    // exec with BOTH vectors given verbatim: argv[0] as typed rather
    // than the resolved path, and an environment the caller built
    // rather than its own (#9090).
    "proc_exec_as",
    // chdir(2), the move getcwd only ever reported, and the mask and
    // read side of the signal dispositions (#9090).
    "chdir", "signal_mask", "signal_disposition",
    // chroot(2) and the write side of the credential getters:
    // setgroups, then setgid, then setuid, the order they must be
    // called in (#9678).
    "chroot", "setuid", "setgid", "setgroups",
    // Liveness of one pid — kill(pid, 0), the zero signal that runs
    // every check kill(2) makes and delivers nothing (#8767).
    "process_alive",
    // The whole of kill(2): deliver `sig` to `pid`, or to the process
    // group a non-positive `pid` names.
    "signal_send",
    // setpgid(2): put `pid` in the process group `pgid`. Both zeroes
    // carry the syscall's own meanings, so `set_process_group(0, 0)` is
    // a process moving into a fresh group of its own.
    "set_process_group",
    // This process's scheduling priority, read and written. The number
    // is the NICE value: -20 is the most favourable and 19 the least.
    "priority", "set_priority",
    // stdin / readers
    "stdin", "stdout", "stderr", "isatty", "read_line",
    // the two halves of the compile target's name, literals once compiled
    "target_os", "target_arch",
    "open_reader", "open_writer", "open_appender", "open_exclusive",
    "open_reader_with", "open_writer_with",
    // filesystem
    "read_file", "read_file_bytes", "write_file", "write_file_bytes", "write_file_exec", "read_dir", "read_dir_all", "read_dir_ino", "remove_dir_all", "remove_file",
    "create_dir_all", "stat", "lstat", "access", "temp_dir",
    // the FILESYSTEM a path resolves on, where stat describes one entry
    "statfs",
    // the single-step directory and link primitives, each one syscall
    // with nothing folded away
    "create_dir", "remove_dir", "create_link", "create_symlink", "read_link", "umask", "rename",
    // the rename the kernel conditions: refuse an existing destination, or swap
    "rename_noreplace", "rename_exchange",
    // an entry's extended attribute, following a final symlink or not
    "getxattr", "getxattr_bytes", "lgetxattr", "lgetxattr_bytes",
    // create or replace one
    "setxattr", "setxattr_bytes", "lsetxattr", "lsetxattr_bytes",
    // the metadata writes on an entry that already exists: its permission
    // bits (with and without following a final symlink) and its two
    // timestamps
    "chmod", "chmod_at", "set_file_times",
    // and its LENGTH — truncate(2), which shrinks a file or extends it
    // with a hole
    "truncate",
    // sync(2): write-back of every dirty buffer on the machine. The
    // per-handle forms are methods on Reader / Writer, not free builtins.
    "sync",
    // the entries that are neither a file nor a directory: a FIFO, and a
    // character or block device node
    "mknod",
    // how wide the terminal on the other end of a descriptor is, and its
    // LINE SETTINGS, read and written — the kernel's own words, because
    // `stty -g` prints them and reads them back (#9356)
    "window_size", "set_window_size", "termios_get", "termios_set",
    // who an entry BELONGS to — fchownat(2), with -1 for either id
    // leaving that half alone, which is how `chgrp` is this with the
    // uid omitted
    "chown_at",
    // the process's own effective ids, which `test -O` / `-G` compare a
    // file's owner against, and the machine's node name
    "geteuid", "getegid", "hostname",
    // The REAL ids and the supplementary group set, which `id -r` /
    // `id -G` ask for, plus the whole environment as a list.
    "getuid", "getgid", "getgroups", "environ",
    // the kernel's utsname record, the working directory and how many
    // processing units the process may use
    "uname_field", "getcwd", "cpu_count",
    // The kernel-enforced ceiling on this process's open descriptors,
    // which `ulimit -n` prints (#8819).
    "rlimit_nofile",
    // Making this process unable to dump core, before it re-raises a
    // fatal signal (#11765).
    "disable_core_dumps",
    // signal dispositions — SIG_IGN / SIG_DFL for one signal, and the
    // flag-raising catch a program polls
    "signal_ignore", "signal_default", "signal_catch", "signal_taken", "signal_catch_interrupting",
    "signal_raise",
    // clocks + randomness + sleep + reactor readiness
    "now_unix_ms", "now_ns", "monotonic_ns", "sleep_ms", "sleep_ns", "random_bytes",
    "random_i32", "poll", "timer_fd", "wasm_timer_pollable",
    // the wall clock's resolution, and setting it
    "clock_resolution", "clock_set",
    "wasm_pollable_drop", "wasm_block", "wasm_poll",
    // maps + string builder + bytes.
    "map_new", "__map_new_i32", "strbuf_append", "strbuf_reset",
    "strbuf_take", "string_from_bytes_unchecked", "string_from_bytes_range_unchecked", "slice_unchecked",
    // the capacity-carrying string builder (#8773): a handle is the
    // address of its own control block, so any number are live at once.
    "buf_new", "buf_push", "buf_push_range", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded", "buf_push_bytes_mapped", "buf_push_bytes_filtered", "buf_push_bytes_expanded", "buf_push_byte", "buf_push_u64", "buf_len",
    "buf_take", "buf_take_bytes", "buf_push_bytes_range", "buf_clear", "buf_free",
    // Cell[T] constructor (docs/CELL-TYPE-PLAN.md): cell_new(v) is a
    // front-end builtin (like map_new); get/set are method calls, not
    // bare names, so only the constructor needs the E001 suppression.
    "cell_new",
    // float / int bit reinterprets
    "f64_bits", "f64_from_bits", "f32_bits", "f32_from_bits",
    // networking
    "tcp_listen", "tcp_accept", "tcp_local_port", "tcp_recv", "tcp_send", "tcp_send_bytes", "tcp_close",
    "udp_send", "tcp_connect", "tcp_pollable", "tcp_listen_with", "tcp_socket_ctl",
    "udp_bind", "udp_connect", "udp_sendto", "udp_recvfrom", "tcp_connect_with", "unix_listen", "unix_connect",
    "udp_send_bytes", "udp_sendto_bytes",
    "reactor_new", "reactor_ctl", "reactor_wait", "tcp_recv_into", "tcp_sendfile", "tcp_send_buf",
  ];
}

pub function is_builtin_function(name: string): boolean {
  return util.index_of_str(builtin_function_names(), name) >= 0;
}

// inject_builtin_enums adds the variant structs for the enums the
// reference front-end auto-injects — JsonValue and IoError — unless the
// program already declares them. This is the self-host analogue of the
// checker's builtinEnumDecls: it lets programs use `std/json`
// (JString(x), match … JObject(m) …) and IoError without a local enum
// declaration. Option / Result are handled separately (Some/Ok/None/Err
// are special-cased in the emitter).
pub function inject_builtin_enums(structs: StructDecl[]): StructDecl[] {
  structs = add_builtin_variant(structs, "JNull", "", "JsonValue");
  structs = add_builtin_variant(structs, "JBool", "boolean", "JsonValue");
  structs = add_builtin_variant(structs, "JNumber", "string", "JsonValue");
  structs = add_builtin_variant(structs, "JString", "string", "JsonValue");
  structs = add_builtin_variant(structs, "JArray", "JsonValue[]", "JsonValue");
  structs = add_builtin_variant(structs, "JObject", "Map[string, JsonValue]", "JsonValue");
  structs = add_builtin_variant(structs, "NotFound", "string", "IoError");
  structs = add_builtin_variant(structs, "PermissionDenied", "string", "IoError");
  structs = add_builtin_variant(structs, "AlreadyExists", "string", "IoError");
  structs = add_builtin_variant(structs, "InvalidUtf8", "string", "IoError");
  structs = add_builtin_variant(structs, "Interrupted", "", "IoError");
  structs = add_builtin_variant(structs, "Unsupported", "", "IoError");
  structs = add_builtin_variant(structs, "BodyText", "string", "Body");
  structs = add_builtin_variant(structs, "BodyBytes", "u8[]", "Body");
  structs = add_builtin_variant(structs, "BodyStream", "Stream", "Body");
  structs = add_builtin_variant(structs, "BodyFile", "string", "Body");
  structs = add_builtin_variant(structs, "BodyChunks", "ChunkProducer", "Body");
  // Other carries THREE payloads (path, message, Linux errno) — open-coded
  // because add_builtin_variant takes one payload. Field naming matches the
  // user-enum desugar: `__ev`, `__ev1`, `__ev2`.
  if (!name_declared(structs, "Other")) {
    let otf: StructFieldDecl[] = [];
    otf = otf.append(StructFieldDecl { name: "__ev", type_name: "string", fn_ret: "", fn_param_types: "" });
    otf = otf.append(StructFieldDecl { name: "__ev1", type_name: "string", fn_ret: "", fn_param_types: "" });
    otf = otf.append(StructFieldDecl { name: "__ev2", type_name: "i32", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "Other", fields: otf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "IoError", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // FileStat: the builtin struct returned by stat(path). Injected so
  // the emitter knows its field layout ([shape, then one 8-byte slot
  // per field in declaration order]) — the __fern_stat runtime helper
  // builds a struct whose shape pointer is the interned "FileStat"
  // name, matching the arm that field access emits. The field list
  // mirrors native's checker declaration entry for entry, which
  // TestSelfHostBuiltinStructsMatchChecker pins.
  if (!name_declared(structs, "FileStat")) {
    let fsf: StructFieldDecl[] = [];
    fsf = fsf.append(StructFieldDecl { name: "is_file", type_name: "boolean", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "is_dir", type_name: "boolean", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "size", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "mode", type_name: "u32", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "nlink", type_name: "u32", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "uid", type_name: "u32", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "gid", type_name: "u32", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "dev", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "rdev", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "ino", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "blksize", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "blocks", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "atime", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "atime_nsec", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "mtime", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "mtime_nsec", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "ctime", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "ctime_nsec", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "btime", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fsf = fsf.append(StructFieldDecl { name: "btime_nsec", type_name: "i64", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "FileStat", fields: fsf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // DirEntry: one element of read_dir_ino(path)'s list — the name and the
  // inode number from the same directory record. Same injection pattern and
  // the same reason as FileStat: __fern_read_dir_ino builds structs whose
  // shape pointer is the interned "DirEntry" name.
  if (!name_declared(structs, "DirEntry")) {
    let def: StructFieldDecl[] = [];
    def = def.append(StructFieldDecl { name: "name", type_name: "string", fn_ret: "", fn_param_types: "" });
    def = def.append(StructFieldDecl { name: "ino", type_name: "i64", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "DirEntry", fields: def, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // FsStat: the builtin struct returned by statfs(path) — the filesystem's
  // own geometry and length limits, where FileStat above describes one entry
  // on it. Same injection pattern and the same reason: __fern_statfs builds a
  // struct whose shape pointer is the interned "FsStat" name, and the emitter
  // resolves field access and reference ownership from this declaration.
  if (!name_declared(structs, "FsStat")) {
    let fvf: StructFieldDecl[] = [];
    fvf = fvf.append(StructFieldDecl { name: "block_size", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "blocks", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "blocks_free", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "blocks_avail", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "files", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "files_free", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "name_max", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "path_max", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "fs_type", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "fsid", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "frag_size", type_name: "i64", fn_ret: "", fn_param_types: "" });
    fvf = fvf.append(StructFieldDecl { name: "fs_type_name", type_name: "string", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "FsStat", fields: fvf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // WinSize: the builtin struct returned by window_size(fd) — how many rows
  // and columns the terminal on the other end of it has. Same injection
  // pattern and the same reason as FsStat above.
  if (!name_declared(structs, "WinSize")) {
    let wsf: StructFieldDecl[] = [];
    wsf = wsf.append(StructFieldDecl { name: "rows", type_name: "i64", fn_ret: "", fn_param_types: "" });
    wsf = wsf.append(StructFieldDecl { name: "cols", type_name: "i64", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "WinSize", fields: wsf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // ProcessResult — returned by `subprocess(cmd, args, stdin)`.
  // Same injection pattern as FileStat: the __fern_subprocess
  // runtime helper builds a struct whose shape pointer is the
  // interned "ProcessResult" name, and the emitter resolves
  // `r.stdout` / `r.stderr` / `r.exit_code` to slot offsets from
  // this decl.
  if (!name_declared(structs, "ProcessResult")) {
    let prf: StructFieldDecl[] = [];
    prf = prf.append(StructFieldDecl { name: "stdout", type_name: "string", fn_ret: "", fn_param_types: "" });
    prf = prf.append(StructFieldDecl { name: "stderr", type_name: "string", fn_ret: "", fn_param_types: "" });
    prf = prf.append(StructFieldDecl { name: "exit_code", type_name: "i32", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "ProcessResult", fields: prf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // std/headers' HeaderMap + std/http's HttpRequest / HttpResponse
  // are constructed via record literals (e.g. `HeaderMap { names: …,
  // values: … }`) but the stdlib files don't carry an explicit
  // `struct` declaration — the Go-side checker infers the shape
  // from usage, but the self-host's shape-pointer dispatch needs
  // the declaration to resolve field offsets. Adding the decls to
  // the stdlib files would tip the Go checker into "treat methods
  // as fields" mode (so e.g. `h.get_all(…)` no longer resolves to
  // the receiver method). Inject them at the self-host's table
  // instead so the Go side stays untouched.
  if (!name_declared(structs, "HeaderMap")) {
    let hmf: StructFieldDecl[] = [];
    hmf = hmf.append(StructFieldDecl { name: "names", type_name: "string[]", fn_ret: "", fn_param_types: "" });
    hmf = hmf.append(StructFieldDecl { name: "values", type_name: "string[]", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "HeaderMap", fields: hmf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // Stream backs HttpRequest.body, so it has to be in this table for
  // `req.body.data` to resolve its inner field: without it `body` has no
  // struct shape here and the chained access bails out of the IR path.
  structs = add_builtin_stream(structs);
  // ChunkProducer is what a `BodyChunks` carries, so it has to be here for
  // `resp.body`'s payload to resolve its `next` field.
  if (!name_declared(structs, "ChunkProducer")) {
    let cpf: StructFieldDecl[] = [];
    cpf = cpf.append(StructFieldDecl { name: "next", type_name: "fn", fn_ret: "Option[u8[]]", fn_param_types: "i32" });
    structs = structs.append(StructDecl { name: "ChunkProducer", fields: cpf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  if (!name_declared(structs, "HttpRequest")) {
    let hrf: StructFieldDecl[] = [];
    hrf = hrf.append(StructFieldDecl { name: "method", type_name: "string", fn_ret: "", fn_param_types: "" });
    hrf = hrf.append(StructFieldDecl { name: "path", type_name: "string", fn_ret: "", fn_param_types: "" });
    hrf = hrf.append(StructFieldDecl { name: "body", type_name: "Stream", fn_ret: "", fn_param_types: "" });
    hrf = hrf.append(StructFieldDecl { name: "headers", type_name: "HeaderMap", fn_ret: "", fn_param_types: "" });
    hrf = hrf.append(StructFieldDecl { name: "trailers", type_name: "HeaderMap", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "HttpRequest", fields: hrf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  if (!name_declared(structs, "HttpResponse")) {
    let hsf: StructFieldDecl[] = [];
    hsf = hsf.append(StructFieldDecl { name: "status", type_name: "i32", fn_ret: "", fn_param_types: "" });
    hsf = hsf.append(StructFieldDecl { name: "body", type_name: "Body", fn_ret: "", fn_param_types: "" });
    hsf = hsf.append(StructFieldDecl { name: "headers", type_name: "HeaderMap", fn_ret: "", fn_param_types: "" });
    hsf = hsf.append(StructFieldDecl { name: "trailers", type_name: "HeaderMap", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "HttpResponse", fields: hsf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // std/time's seven date/time types are compiler built-ins (registered in
  // the Go checker, not `struct`-declared in std/time), so the self-host's
  // shape-pointer dispatch + field-offset resolution need their layouts here
  // — the same pattern as FileStat / HeaderMap above. Field lists mirror
  // internal/check/checker/checker.go's registration exactly. All are leaf-safe
  // (scalar / string / nested leaf-safe struct fields), so their constructors
  // (date_make / span_days / …) and field reads lower on the IR path.
  structs = add_builtin_struct2(structs, "Instant", "sec", "i64", "nsec", "i32");
  structs = add_builtin_struct2(structs, "Duration", "sec", "i64", "nsec", "i32");
  structs = add_builtin_struct2(structs, "TimeZone", "name", "string", "offset_seconds", "i32");
  structs = add_builtin_struct2(structs, "DateTime", "date", "Date", "time", "Time");
  structs = add_builtin_struct2(structs, "Zoned", "instant", "Instant", "zone", "TimeZone");
  if (!name_declared(structs, "Date")) {
    let df: StructFieldDecl[] = [];
    df = df.append(StructFieldDecl { name: "year", type_name: "i32", fn_ret: "", fn_param_types: "" });
    df = df.append(StructFieldDecl { name: "month", type_name: "i32", fn_ret: "", fn_param_types: "" });
    df = df.append(StructFieldDecl { name: "day", type_name: "i32", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "Date", fields: df, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  if (!name_declared(structs, "Time")) {
    let tf: StructFieldDecl[] = [];
    tf = tf.append(StructFieldDecl { name: "hour", type_name: "i32", fn_ret: "", fn_param_types: "" });
    tf = tf.append(StructFieldDecl { name: "minute", type_name: "i32", fn_ret: "", fn_param_types: "" });
    tf = tf.append(StructFieldDecl { name: "second", type_name: "i32", fn_ret: "", fn_param_types: "" });
    tf = tf.append(StructFieldDecl { name: "nsec", type_name: "i32", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "Time", fields: tf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  if (!name_declared(structs, "Span")) {
    let spf: StructFieldDecl[] = [];
    spf = spf.append(StructFieldDecl { name: "years", type_name: "i32", fn_ret: "", fn_param_types: "" });
    spf = spf.append(StructFieldDecl { name: "months", type_name: "i32", fn_ret: "", fn_param_types: "" });
    spf = spf.append(StructFieldDecl { name: "weeks", type_name: "i32", fn_ret: "", fn_param_types: "" });
    spf = spf.append(StructFieldDecl { name: "days", type_name: "i32", fn_ret: "", fn_param_types: "" });
    spf = spf.append(StructFieldDecl { name: "hours", type_name: "i32", fn_ret: "", fn_param_types: "" });
    spf = spf.append(StructFieldDecl { name: "minutes", type_name: "i32", fn_ret: "", fn_param_types: "" });
    spf = spf.append(StructFieldDecl { name: "seconds", type_name: "i32", fn_ret: "", fn_param_types: "" });
    spf = spf.append(StructFieldDecl { name: "nanos", type_name: "i32", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "Span", fields: spf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // std/io_buffered + std/stream built-ins (registered in the Go checker,
  // not `struct`-declared in source) — same injection pattern as the time
  // types. Field lists mirror checker.go exactly:
  //   Stream       { data: u8[], pos: i32, source: Option[BodySource] }
  //   BytesWriter  { data: u8[] }                 — in-memory write buffer
  // Both carry a sub-word (u8[]) array field, leak-safe
  // (is_leaksafe_array_field), so their constructors / methods lower on the
  // IR path.
  structs = add_builtin_stream(structs);
  if (!name_declared(structs, "ChunkProducer")) {
    let cpf: StructFieldDecl[] = [];
    cpf = cpf.append(StructFieldDecl { name: "next", type_name: "fn", fn_ret: "Option[u8[]]", fn_param_types: "i32" });
    structs = structs.append(StructDecl { name: "ChunkProducer", fields: cpf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  if (!name_declared(structs, "BytesWriter")) {
    let bwf: StructFieldDecl[] = [];
    bwf = bwf.append(StructFieldDecl { name: "data", type_name: "u8[]", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "BytesWriter", fields: bwf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  // std/url's Url is a compiler built-in (registered in the Go checker, not
  // `struct`-declared in std/url), so the IR path needs its layout to lower
  // `Url { … }` construction / field reads — the same pattern as Stream /
  // BytesWriter / the time types. Fields mirror internal/check/checker/checker.go
  // exactly; all scalar/string, so leaf-safe (url_parse's Url-spread builder
  // and `Option[Url]` return lower).
  if (!name_declared(structs, "Url")) {
    let urlf: StructFieldDecl[] = [];
    urlf = urlf.append(StructFieldDecl { name: "scheme", type_name: "string", fn_ret: "", fn_param_types: "" });
    urlf = urlf.append(StructFieldDecl { name: "host", type_name: "string", fn_ret: "", fn_param_types: "" });
    urlf = urlf.append(StructFieldDecl { name: "port", type_name: "i32", fn_ret: "", fn_param_types: "" });
    urlf = urlf.append(StructFieldDecl { name: "path", type_name: "string", fn_ret: "", fn_param_types: "" });
    urlf = urlf.append(StructFieldDecl { name: "query", type_name: "string", fn_ret: "", fn_param_types: "" });
    urlf = urlf.append(StructFieldDecl { name: "fragment", type_name: "string", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "Url", fields: urlf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  return structs;
}

// add_builtin_struct2 injects a 2-field built-in struct (guarded by name) —
// the common shape for the injected time types (sec/nsec, name/offset, …).
// add_builtin_stream declares Stream and the BodySource a lazy one pulls
// from, as checker.go's builtinStructDecls does: `Stream { data: u8[], pos:
// i32, source: Option[BodySource] }` and `BodySource { next: () =>
// Option[u8[]], fault: Cell[i32] }`.
function add_builtin_stream(structs: StructDecl[]): StructDecl[] {
  if (!name_declared(structs, "BodySource")) {
    let bsf: StructFieldDecl[] = [];
    bsf = bsf.append(StructFieldDecl { name: "next", type_name: "fn", fn_ret: "Option[u8[]]", fn_param_types: "" });
    bsf = bsf.append(StructFieldDecl { name: "fault", type_name: "Cell[i32]", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "BodySource", fields: bsf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  if (!name_declared(structs, "Stream")) {
    let stf: StructFieldDecl[] = [];
    stf = stf.append(StructFieldDecl { name: "data", type_name: "u8[]", fn_ret: "", fn_param_types: "" });
    stf = stf.append(StructFieldDecl { name: "pos", type_name: "i32", fn_ret: "", fn_param_types: "" });
    stf = stf.append(StructFieldDecl { name: "source", type_name: "Option[BodySource]", fn_ret: "", fn_param_types: "" });
    structs = structs.append(StructDecl { name: "Stream", fields: stf, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
  }
  return structs;
}

function add_builtin_struct2(structs: StructDecl[], name: string, f0: string, t0: string, f1: string, t1: string): StructDecl[] {
  if (struct_declared(structs, name)) {
    return structs;
  }
  let fields: StructFieldDecl[] = [];
  fields = fields.append(StructFieldDecl { name: f0, type_name: t0, fn_ret: "", fn_param_types: "" });
  fields = fields.append(StructFieldDecl { name: f1, type_name: t1, fn_ret: "", fn_param_types: "" });
  return structs.append(StructDecl { name: name, fields: fields, type_params: [], derives: [], line: 0, col: 0, enum_owner: "", must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
}

// module_with_builtins returns `mod` with the auto-injected builtin
// enum variants (JsonValue / IoError) merged into its struct table.
// Compilation drivers call this before emit; emit_module itself stays
// pure so the asm self-test (which calls emit_module directly and is
// compiled to native code) doesn't carry the injection path.
// ---------------------------------------------------------------
// Monomorphisation of trait-bounded generics.
//
// The self-host erases unbounded generics (uniform 8-byte ABI) and
// dispatches `obj.method()` dynamically by a shape pointer read off the
// receiver — which heap values carry but unboxed primitives do not. A
// BOUNDED generic (`f[T: Eq](a: T, …)`) calls trait methods on a
// `T`-typed value, so when T is a primitive the dynamic dispatch reads
// garbage and crashes. The fix: clone the bounded generic per concrete
// call-site type so the receiver's STATIC type is concrete and routes
// through the emitter's working static-primitive dispatch. No emitter
// change is needed (see docs/TRAITS.md §7a).
//
// monomorphize_module (called by module_with_builtins) walks every
// non-generic body + the top stmts, rewrites each call to a bounded
// generic `f(args)` to a mangled `f__<concretetype>(args)` (concrete
// type inferred from the argument bound to the type variable), collects
// the needed instantiations, then clones each bounded generic per
// instantiation with the type variable substituted. A worklist handles
// clones that themselves call bounded generics.

// MEnv is a tiny var-name -> type-name environment for inference.
struct MEnv { mnames: string[], mtypes: string[] }

function (e: MEnv) ebind(n: string, t: string): MEnv {
  return MEnv { mnames: e.mnames.append(n), mtypes: e.mtypes.append(t) };
}

function (e: MEnv) elook(n: string): string {
  let i: i32 = e.mnames.len() - 1;
  while (i >= 0) {
    if (e.mnames[i] == n) {
      return e.mtypes[i];
    }
    i = i - 1;
  }
  return "";
}

// Insts accumulates the unique (bounded-generic name, concrete type)
// instantiations discovered while rewriting call sites.
// Insts records generic instantiations as three parallel arrays: the base
// name, the mangled `__`-key (used to build clone symbol names), and `iargs`
// — the ORIGINAL single-type-arg spelling for a single-param enum. iargs
// exists because a fn or tuple arg mangles LOSSILY (`(i32) => i32` →
// sanitized `_i32_____i32`, `(i32, i32)` → `tup_i32_i32`), so phase-2 field
// substitution can't recover the real field type from the key alone; it reads
// iargs instead. For a nominal /
// nested-enum key, iargs carries the original spelling too, but `me_rewrite_ty`
// re-derives the identical mangled field type either way (`Opt[i32]` → `Opt__i32`
// == the key), so those stay byte-identical. Non-enum callers use the default
// `iadd` (iargs = the key), which phase-2 enum cloning never reads.
struct Insts { inames: string[], itypes: string[], iargs: string[] }

function (a: Insts) ihas(n: string, t: string): boolean {
  let i: i32 = 0;
  while (i < a.inames.len()) {
    if (a.inames[i] == n && a.itypes[i] == t) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function (a: Insts) iadd(n: string, t: string): Insts {
  if (a.ihas(n, t)) {
    return a;
  }
  return Insts { inames: a.inames.append(n), itypes: a.itypes.append(t), iargs: a.iargs.append(t) };
}

// iadd_arg records an instantiation together with the original single-arg
// spelling `arg` (phase-2 field substitution reads it for a fn- or
// tuple-keyed clone).
// Enum-collection sites use this; the default `iadd` sets iargs = key.
function (a: Insts) iadd_arg(n: string, t: string, arg: string): Insts {
  if (a.ihas(n, t)) {
    return a;
  }
  return Insts { inames: a.inames.append(n), itypes: a.itypes.append(t), iargs: a.iargs.append(arg) };
}

struct RExpr { rexpr: ast.Expr, rins: Insts }

struct RStmtOne { rstmt: ast.Stmt, renv: MEnv, rins2: Insts }

struct RStmts { rstmts: ast.Stmt[], rins3: Insts }

// MFns is the monomorphiser's view of the module's function table: the decls
// themselves, plus the two lookups the rewrite consults per expression.
//
// `bg_find` answers only for BOUNDED-GENERIC free functions and `smm_any` only
// for `__smm_`-folded struct-method generics — between them a few dozen decls
// out of a whole-compiler module's ~4,600 — yet both used to scan all 4,600,
// once per call expression and once per field access. That was 39 of 626
// profile samples of a self-compile, the third cost after the append ratchet
// and string compare (docs/PERFORMANCE-AUDIT-2026-08.md §4d.7). Indexing the
// QUALIFYING decls alone makes the common answer, a miss, one hash and an
// empty bucket.
//
// The index travels WITH the decls rather than beside them so the two cannot
// be built from different arrays. Mirrors lift.MFuncs, which does the same
// for the closure-lift pass.
pub struct MFns {
  decls: FuncDecl[],
  // Chained hash index over the generic free functions. ghead[b] is the first
  // entry in bucket b (-1 when empty) and gnext chains within a bucket in
  // ASCENDING entry order, so a chain walk answers with the same decl the
  // linear scan reached first. gname[e] / gat[e] are the entry's name and its
  // position in `decls`.
  ghead: i32[],
  gnext: i32[],
  gname: string[],
  gat: i32[],
  // The `__smm_<Base>_<field>` fold names. A handful per module, and the test
  // is a SUFFIX match rather than equality, so this one stays a scan.
  smm: string[],
  // Concrete array/view folds, indexed separately from generic templates.
  array_concrete: i32[],
  // The module's struct decls, so a struct-literal FIELD VALUE can be
  // rewritten against the field's declared type. It travels here for the same
  // reason the index does: built from one array, it cannot disagree with the
  // decls it is read beside.
  structs: StructDecl[],
  // The module's enum decls, so a `match` arm's payload bindings can be
  // typed from the variant's declared fields with the enum's type params
  // substituted from the scrutinee's spelling.
  enums: EnumDecl[],
  // The module's impls, so a generic's return type spelled through a
  // projection on a type parameter (`H::Item`) resolves once substituted.
  impls: ImplInfo[],
}

// mfns_buckets is the bucket count of the generic index. Prime, and far larger
// than the ~170 generic free functions a whole-compiler module declares, so the
// chains are almost all length 0 or 1.
function mfns_buckets(): i32 {
  return 257;
}

// mfns_of builds the index. Chains are laid down by walking the qualifying
// entries BACKWARD and pushing each onto the front of its bucket, which leaves
// every chain ascending without a per-bucket tail.
//
// The decls array must not be rebound while the index is live. All three
// monomorphise passes build it once from a field they never reassign — the
// clones they produce accumulate in a separate list — so an entry position
// means the same thing for the whole pass.
pub function mfns_of(decls: FuncDecl[], structs: StructDecl[], enums: EnumDecl[], impls: ImplInfo[]): MFns {
  let ghead: i32[] = [];
  let b: i32 = 0;
  let nb: i32 = mfns_buckets();
  while (b < nb) {
    ghead = ghead.append(0 - 1);
    b = b + 1;
  }
  let gname: string[] = [];
  let gat: i32[] = [];
  let smm: string[] = [];
  let array_concrete: i32[] = [];
  let i: i32 = 0;
  while (i < decls.len()) {
    if (decls[i].type_params.len() > 0 && decls[i].receiver_name.len() == 0) {
      gname = gname.append(decls[i].name);
      gat = gat.append(i);
    }
    if (decls[i].name.len() > 6 && slice_unchecked(decls[i].name, 0, 6) == "__smm_") {
      smm = smm.append(decls[i].name);
    }
    if (is_concrete_array_fold(decls[i])) {
      array_concrete = array_concrete.append(i);
    }
    i = i + 1;
  }
  let gnext: i32[] = [];
  let j: i32 = 0;
  while (j < gname.len()) {
    gnext = gnext.append(0 - 1);
    j = j + 1;
  }
  let k: i32 = gname.len() - 1;
  while (k >= 0) {
    let bk: i32 = util.hash_bucket(gname[k], nb);
    gnext = gnext.with(k, ghead[bk]);
    ghead = ghead.with(bk, k);
    k = k - 1;
  }
  return MFns { decls: decls, ghead: ghead, gnext: gnext, gname: gname, gat: gat, smm: smm, array_concrete: array_concrete, structs: structs, enums: enums, impls: impls };
}

// bg_find returns the position in `fns.decls` of the bounded-generic function
// named `name` (type_params non-empty, plain function), or -1.
function bg_find(fns: MFns, name: string): i32 {
  let e: i32 = fns.ghead[util.hash_bucket(name, fns.ghead.len())];
  while (e >= 0) {
    if (fns.gname[e] == name) {
      return fns.gat[e];
    }
    e = fns.gnext[e];
  }
  return 0 - 1;
}

// tp_index returns the position of `name` in `tparams`, or -1.
function tp_index(name: string, tparams: string[]): i32 {
  let i: i32 = 0;
  while (i < tparams.len()) {
    if (tparams[i] == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// type_ends_arr reports whether a type string ends with the `[]`
// array suffix.
// elem_spelling is the element of an array spelling `t[]`. A callable
// element loses the group fn_tag_spelling wraps it in: `(() => T)[]` is an
// array of `() => T`, not of a one-tuple.
pub function elem_spelling(arr: string): string {
  let el: string = slice_unchecked(arr, 0, arr.len() - 2) + "";
  if (el.len() < 2 || el[0] != b'(' || el[el.len() - 1] != b')') {
    return el;
  }
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < el.len()) {
    if (el[i] == b'(') {
      depth = depth + 1;
    } else if (el[i] == b')') {
      depth = depth - 1;
      if (depth == 0 && i < el.len() - 1) {
        return el;
      }
    }
    i = i + 1;
  }
  let inner: string = slice_unchecked(el, 1, el.len() - 1) + "";
  if (parse_type_ref(inner).is_fn) {
    return inner;
  }
  return el;
}

function type_ends_arr(s: string): boolean {
  if (s.len() < 2) {
    return false;
  }
  return slice_unchecked(s, s.len() - 2, s.len()) == "[]";
}

// first_bracket returns the index of the first `[` in `s`, or -1.
function first_bracket(s: string): i32 {
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'[') {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// split_top_commas splits a generic-arg inner string (e.g. `K, V` or
// `string, Map[a, b]`) on top-level commas, tracking `[]`/`()` depth so a
// comma nested inside `Map[...]` or a tuple doesn't split early. A comma's
// single following space (the canonical `, ` spelling) is consumed when
// present, but a BARE `,` splits too: the lowering's compact tuple element tags
// (`(clo,i32)`) join without the space,
// and requiring it made parse_type_ref read `(clo,i32)` as a ONE-element
// tuple — so tuple_type_elem_tag returned "clo,i32", the `t.K.N(args)` /
// `arr[i].N(args)` closure-element dispatch missed its "clo" tag, and the
// call fell through to bogus method dispatch (`i32.0`), bailing the module.
pub function split_top_commas(s: string): string[] {
  let out: string[] = [];
  let depth: i32 = 0;
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'[' || s[i] == b'(') {
      depth = depth + 1;
    }
    if (s[i] == b']' || s[i] == b')') {
      depth = depth - 1;
    }
    if (depth == 0 && s[i] == b',') {
      out = out.append(slice_unchecked(s, start, i) + "");
      i = i + 1;
      if (i < s.len() && s[i] == b' ') {
        i = i + 1;
      }
      start = i;
      continue;
    }
    i = i + 1;
  }
  out = out.append(slice_unchecked(s, start, s.len()) + "");
  return out;
}

// std_qualifier is the name `mod` refers to `std/<name>` by: the import's
// alias, else `name`; "" when it does not import the module.
pub function std_qualifier(mod: Module, name: string): string {
  let want: string = "std/" + name;
  for imp in mod.imports {
    let p: string = imp.path;
    if (p == want || p.len() > want.len() + 1 && slice_unchecked(p, p.len() - want.len() - 1, p.len()) + "" == "/" + want) {
      if (imp.alias.len() > 0) {
        return imp.alias;
      }
      return name;
    }
  }
  return "";
}

// is_serve_config_type reports whether the type text is std/serve's
// `Config`: qualified as the entry imports the module (`qual`, from
// `std_qualifier`), or mangled once the bundle has run (`serve__Config`).
pub function is_serve_config_type(t: string, qual: string): boolean {
  let s: string = strip_type_spaces(t);
  return s == "serve__Config" || qual.len() > 0 && s == qual + ".Config";
}

// init_return_kind classifies what a handler program's `init` answers, by
// its return type text: 0 nothing, 1 a state for the handler to carry, 2
// the serve config, 3 the serve config beside a state (`(serve.Config, S)`).
// `qual` is what the program imports std/serve as.
pub function init_return_kind(rt: string, qual: string): i32 {
  let s: string = strip_type_spaces(rt);
  if (s.len() == 0 || s == "void") {
    return 0;
  }
  if (is_serve_config_type(s, qual)) {
    return 2;
  }
  if (s.len() > 2 && s[0] == b'(' && s[s.len() - 1] == b')') {
    let parts: string[] = split_top_commas(slice_unchecked(s, 1, s.len() - 1) + "");
    if (parts.len() == 2 && is_serve_config_type(parts[0], qual)) {
      return 3;
    }
  }
  return 1;
}

function strip_type_spaces(t: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < t.len()) {
    if (t[i] != b' ') {
      out = out + slice_unchecked(t, i, i + 1);
    }
    i = i + 1;
  }
  return out;
}

// ---------------------------------------------------------------------------
// Structured type references (SH-021, foundation slice — unblocks #4394 lever 1).
//
// Types are carried through the self-host compiler as flat STRINGS ("i32",
// "Map[string, i32]", "Option[(string, string)]", "i32[]", …) that a dozen
// downstream sites re-decode by hand — depth-tracking byte scans keyed on exact
// separators ("[", "]", "(", ", "), off-by-one bracket arithmetic, and unsound
// "names never contain X" assumptions (asmcore ty_from_name / split_tuple_ret /
// tuple_ret_tag_at, checker's six type_from_name* resolvers, wasm). Each is a
// fresh chance to mis-read a nested generic or tuple.
//
// TypeRef is the structured form those scans should target instead: parse the
// string ONCE into a tree, then pattern-match on it. This slice adds the type
// plus the canonical parse/render pair (round-trip: render_type_ref(parse_type_ref
// s) == s for every canonical type spelling); later slices retarget each
// byte-scanning consumer onto parse_type_ref, and eventually the parser produces
// TypeRef directly so the string becomes render output rather than the source of
// truth. See docs/SELF-HOST-AUDIT.md T2.
//
//   base        — the head name: "i32" / "Foo" / "mod.Bar" for a scalar or named
//                 type; the constructor ("Map" / "Option" / "Result" / …) for a
//                 generic; "" for a tuple.
//   args        — the generic arguments ("Map[K, V]" → [K, V]) or the tuple
//                 element types ("(a, b)" → [a, b]); empty for a plain name.
//   array_depth — the number of trailing "[]" suffixes ("i32[][]" → 2), applied
//                 outside base/args so "(a, b)[]" and "Map[i32][]" round-trip.
//   is_tuple    — true for "(…)" tuples (base is "", args are the elements),
//                 distinguishing them from a "Name[…]" generic at render time.
//   is_view     — true for a "[T]" view (base is "", args is the one element).
//
// `dyn`/`own`/`borrow` handles are coarsed to opaque spellings ("dyn Shape",
// "own R") by parse_type_name, so TypeRef treats them as opaque named bases (a
// trailing "[]" still peels off, e.g. "dyn Shape[]"); it is not a source-syntax
// type parser.
// TypeRef is a decoded type spelling. `is_tuple` and `is_fn` are mutually
// exclusive shapes over the same `args` list: a tuple's args are its elements,
// a function's are its parameters followed by its RESULT as the last entry (so
// `() => P` carries one arg and `(A, B) => C` carries three).
pub struct TypeRef { base: string, args: TypeRef[], array_depth: i32, is_tuple: boolean, is_fn: boolean, is_view: boolean }

// elem_type_ref peels one array level off `t` — the element type of `T[]`.
// Every consumer that recurses through an array suffix needs it, and each one
// used to re-spell the whole struct literal, so a new field meant editing eight
// copies of the same line.
pub function elem_type_ref(t: TypeRef): TypeRef {
  return TypeRef { ...t, array_depth: t.array_depth - 1 };
}

// top_arrow_at returns the index of the FIRST top-level `=>` in `s`, or -1.
// Depth-tracked like split_top_commas, so the arrow inside a parameter's own
// function type (`(() => T) => U`) does not split the outer one.
pub function top_arrow_at(s: string): i32 {
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b'[' || s[i] == b'(') {
      depth = depth + 1;
    }
    if (s[i] == b']' || s[i] == b')') {
      depth = depth - 1;
    }
    if (depth == 0 && s[i] == b'=' && i + 1 < s.len() && s[i + 1] == b'>') {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// plain_type_spelling: no bracket, paren or arrow, so every branch of
// parse_type_ref below falls through to the plain named type.
function plain_type_spelling(s: string): boolean {
  let i: i32 = 0;
  while (i < s.len()) {
    let c: u8 = s[i];
    if (c == b'[' || c == b'(' || c == b'=') {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// parse_type_ref decodes a canonical type spelling into a TypeRef tree. It is the
// single place the "[]" / "(…)" / "Name[…]" / ", " grammar is scanned; every
// other decoder should call this rather than re-implement the depth tracking.
pub function parse_type_ref(sin: string): TypeRef {
  if (plain_type_spelling(sin)) {
    return TypeRef { base: sin, args: [], array_depth: 0, is_tuple: false, is_fn: false, is_view: false };
  }
  let s: string = sin;
  let depth: i32 = 0;
  // Function "(P, Q) => R": base "", args are the parameters with the RESULT
  // last. Checked before the tuple branch because the parameter list opens
  // with "(" too — `(i32) => i32` would otherwise be read as a malformed
  // tuple, and `(A) => (B)` as a well-formed but wrong one.
  let arrow: i32 = top_arrow_at(s);
  if (arrow > 0) {
    let lhs: string = slice_unchecked(s, 0, arrow) + "";
    while (lhs.len() > 0 && lhs[lhs.len() - 1] == b' ') {
      lhs = slice_unchecked(lhs, 0, lhs.len() - 1) + "";
    }
    let rhs: string = slice_unchecked(s, arrow + 2, s.len()) + "";
    while (rhs.len() > 0 && rhs[0] == b' ') {
      rhs = slice_unchecked(rhs, 1, rhs.len()) + "";
    }
    if (lhs.len() >= 2 && lhs[0] == b'(' && lhs[lhs.len() - 1] == b')') {
      let pinner: string = slice_unchecked(lhs, 1, lhs.len() - 1) + "";
      let fargs: TypeRef[] = [];
      // `()` is zero parameters; split_top_commas would report one empty.
      if (pinner.len() > 0) {
        let psegs: string[] = split_top_commas(pinner);
        let pi: i32 = 0;
        while (pi < psegs.len()) {
          fargs = fargs.append(parse_type_ref(fn_parameter_type(psegs[pi])));
          pi = pi + 1;
        }
      }
      fargs = fargs.append(parse_type_ref(rhs));
      return TypeRef { base: "", args: fargs, array_depth: 0, is_tuple: false, is_fn: true, is_view: false };
    }
  }
  // Only peel array suffixes after ruling out an outer arrow. In
  // `(T) => U[]` the suffix belongs to the result; in `((T) => U)[]`
  // it belongs to the grouped function value.
  while (s.len() >= 2 && s[s.len() - 2] == b'[' && s[s.len() - 1] == b']') {
    depth = depth + 1;
    s = slice_unchecked(s, 0, s.len() - 2) + "";
  }
  // View "[T]": the prefix bracket closes at the end and wraps the element.
  if (s.len() >= 2 && s[0] == b'[' && matching_bracket(s, 0) == s.len() - 1) {
    return TypeRef { base: "", args: [parse_type_ref(slice_unchecked(s, 1, s.len() - 1) + "")], array_depth: depth, is_tuple: false, is_fn: false, is_view: true };
  }
  // Tuple "(…)": base "", args are the (recursively parsed) elements.
  if (s.len() >= 2 && s[0] == b'(' && s[s.len() - 1] == b')') {
    let tsegs: string[] = split_top_commas(slice_unchecked(s, 1, s.len() - 1));
    let targs: TypeRef[] = [];
    let ti: i32 = 0;
    while (ti < tsegs.len()) {
      targs = targs.append(parse_type_ref(tsegs[ti]));
      ti = ti + 1;
    }
    return TypeRef { base: "", args: targs, array_depth: depth, is_tuple: true, is_fn: false, is_view: false };
  }
  // Generic "Name[…]": base is the head before the first top-level "[", args
  // are the bracketed, comma-split arguments. (After the array peel above the
  // last char is the generic's own "]".)
  let lb: i32 = 0 - 1;
  let j: i32 = 0;
  while (j < s.len()) {
    if (s[j] == b'[') {
      lb = j;
      j = s.len();
    } else {
      j = j + 1;
    }
  }
  if (lb >= 0 && s.len() > 0 && s[s.len() - 1] == b']') {
    let gsegs: string[] = split_top_commas(slice_unchecked(s, lb + 1, s.len() - 1));
    let gargs: TypeRef[] = [];
    let gi: i32 = 0;
    while (gi < gsegs.len()) {
      gargs = gargs.append(parse_type_ref(gsegs[gi]));
      gi = gi + 1;
    }
    return TypeRef { base: slice_unchecked(s, 0, lb) + "", args: gargs, array_depth: depth, is_tuple: false, is_fn: false, is_view: false };
  }
  // Plain scalar / named type (incl. opaque "dyn …" / "own …" spellings).
  return TypeRef { base: s, args: [], array_depth: depth, is_tuple: false, is_fn: false, is_view: false };
}

// Parameter names are syntax, not part of the callable type.
function fn_parameter_type(spelling: string): string {
  let depth: i32 = 0;
  let i: i32 = 0;
  while (i < spelling.len()) {
    let c: u8 = spelling[i];
    if (c == b'(' || c == b'[') {
      depth = depth + 1;
    }
    if (c == b')' || c == b']') {
      depth = depth - 1;
    }
    if (c == b':' && depth == 0) {
      return util.trim(slice_unchecked(spelling, i + 1, spelling.len()) + "");
    }
    i = i + 1;
  }
  return spelling;
}

// Strip only grouping parentheses, never an array or a real tuple.
pub function ref_ungroup(r: TypeRef): TypeRef {
  let t: TypeRef = r;
  while (t.array_depth == 0 && t.is_tuple && t.args.len() == 1) {
    t = t.args[0];
  }
  return t;
}

// ref_is_fn_value reports whether `r` names a FUNCTION value: the arrow form
// itself, or the parenthesised grouping of one, which parse_type_ref models as
// a one-element tuple (Fern has no singleton tuples, so there is nothing else
// `(X)` can be). Both spellings occur as a tuple ELEMENT — `((i32) => i32, i32)`
// gives the bare form, `((() => i32), i32)` the grouped one — and the grouping
// parens are NOT redundant to unwrap: `((string) => string)[]` is an array of
// functions while `(string) => string[]` is one function returning an array, so
// they are kept and every consumer asks this instead of matching a spelling.
//
// An array of functions is an ARRAY, not a function, so a suffix disqualifies.
pub function ref_is_fn_value(r: TypeRef): boolean {
  let f: TypeRef = ref_ungroup(r);
  return f.array_depth == 0 && f.is_fn;
}

// spelling_is_view reports whether a type spelling is itself a `[T]` view, as
// opposed to an array of views or a view nested in another type.
pub function spelling_is_view(spelling: string): boolean {
  let r: TypeRef = parse_type_ref(spelling);
  return r.is_view && r.array_depth == 0;
}

// A parameter spelling may carry the CONSUMING marker `own T`: the callee
// releases what it is handed there. It is carried in the spelling because that is
// where a declaration's parameter types are recorded, and parse_type_ref keeps
// it in the base of the leaf it opens.
pub function spelling_is_own(spelling: string): boolean {
  let t: string = util.trim(spelling);
  return t.len() > 4 && slice_unchecked(t, 0, 4) == "own ";
}

pub function spelling_without_own(spelling: string): string {
  let t: string = util.trim(spelling);
  if (!spelling_is_own(t)) {
    return t;
  }
  return util.trim(slice_unchecked(t, 4, t.len()) + "");
}

// ref_is_own / ref_without_own read the same marker off a parsed reference.
// The marker sits on the base name, so a leaf and an array of one — `own T`,
// `own string[]` — both carry it; `own (i32) => i32` is not a spelling this
// grammar admits, so a fn and a tuple answer false on their own account.
pub function ref_is_own(r: TypeRef): boolean {
  return !r.is_tuple && !r.is_fn && spelling_is_own(r.base);
}

pub function ref_without_own(r: TypeRef): TypeRef {
  if (!ref_is_own(r)) {
    return r;
  }
  return TypeRef { ...r, base: spelling_without_own(r.base) };
}

// ref_fn_result returns the RESULT type of a fn `r` — parse_type_ref puts the
// parameters and the result in `args` with the result last. Only meaningful
// when ref_is_fn_value(r); the caller checks that first.
pub function ref_fn_result(r: TypeRef): TypeRef {
  let f: TypeRef = ref_ungroup(r);
  return f.args[f.args.len() - 1];
}

// ref_fn_param_spellings returns the comma-joined PARAMETER spellings of a fn
// `r` — parse_type_ref puts the parameters and the result in `args` with the
// result last, so this is everything but that. The sibling of ref_fn_result,
// and empty for a known zero-parameter function. Only meaningful when
// ref_is_fn_value(r); the caller checks first.
pub function ref_fn_param_spellings(r: TypeRef): string {
  let f: TypeRef = ref_ungroup(r);
  let out: string = "";
  let i: i32 = 0;
  while (i + 1 < f.args.len()) {
    if (i > 0) {
      out = out + ",";
    }
    out = out + render_type_ref(f.args[i]);
    i = i + 1;
  }
  return out;
}

// is_fn_contract_tag reports whether a coarse callable tag is one whose
// contract parse_decl_type keeps in the result and parameter sidecars: a
// function, an array of them, or a view of them.
pub function is_fn_contract_tag(tag: string): boolean {
  return tag == "fn" || tag == "fn[]" || tag == "[fn]";
}

// fn_tag_spelling rebuilds the callable spelling that parse_decl_type splits
// into a coarse tag (is_fn_contract_tag) and its result and parameter sidecars
// — the inverse of that split, for a reader that wants the declared SHAPE
// rather than the tag. A tag with no recorded result vouches for no signature,
// so it stays itself.
pub function fn_tag_spelling(tag: string, ret: string, params: string): string {
  if (ret.len() == 0 || !is_fn_contract_tag(tag)) {
    return tag;
  }
  let list: string = "";
  if (params.len() > 0) {
    let segs: string[] = split_top_commas(params);
    let i: i32 = 0;
    while (i < segs.len()) {
      if (i > 0) {
        list = list + ", ";
      }
      list = list + util.trim(segs[i]);
      i = i + 1;
    }
  }
  let spelled: string = "(" + list + ") => " + ret;
  if (tag == "fn[]") {
    return "(" + spelled + ")[]";
  }
  if (tag == "[fn]") {
    return "[" + spelled + "]";
  }
  return spelled;
}

// is_coarse_fn_tag reports whether `s` is the callable TAG parse_type_name
// produces rather than a spelling — "fn" or the view "[fn]", with one "[]" per
// array dimension. fn_tag_spelling rebuilds only the shallowest forms and
// returns every deeper tag unchanged, so the shape is what decides this, not the
// strings it happens to rewrite.
pub function is_coarse_fn_tag(s: string): boolean {
  let i: i32 = 2;
  if (s.len() >= 4 && slice_unchecked(s, 0, 4) == "[fn]") {
    i = 4;
  } else if (s.len() < 2 || slice_unchecked(s, 0, 2) != "fn") {
    return false;
  }
  while (i < s.len()) {
    if (i + 2 > s.len() || slice_unchecked(s, i, i + 2) != "[]") {
      return false;
    }
    i = i + 2;
  }
  return true;
}

// fn_spelling_params is ref_fn_param_spellings asked of a fn SPELLING — the
// parameter half of what fn_spelling_ret returns for the result.
function fn_spelling_params(t: string): string {
  let r: TypeRef = parse_type_ref(t);
  if (!ref_is_fn_value(r)) {
    return "";
  }
  return ref_fn_param_spellings(r);
}

// render_type_ref is the inverse of parse_type_ref: it reproduces the canonical
// spelling, so render_type_ref(parse_type_ref(s)) == s for every canonical s.
pub function render_type_ref(t: TypeRef): string {
  let inner: string = "";
  if (t.is_fn) {
    // args are the parameters plus the result last, so the parameter list
    // is everything but the final entry.
    inner = "(";
    let f: i32 = 0;
    while (f + 1 < t.args.len()) {
      if (f > 0) {
        inner = inner + ", ";
      }
      inner = inner + render_type_ref(t.args[f]);
      f = f + 1;
    }
    inner = inner + ") => " + render_type_ref(t.args[t.args.len() - 1]);
  } else if (t.is_tuple) {
    inner = "(";
    let i: i32 = 0;
    while (i < t.args.len()) {
      if (i > 0) {
        inner = inner + ", ";
      }
      inner = inner + render_type_ref(t.args[i]);
      i = i + 1;
    }
    inner = inner + ")";
  } else if (t.is_view) {
    inner = "[" + render_type_ref(t.args[0]) + "]";
  } else if (t.args.len() > 0) {
    inner = t.base + "[";
    let k: i32 = 0;
    while (k < t.args.len()) {
      if (k > 0) {
        inner = inner + ", ";
      }
      inner = inner + render_type_ref(t.args[k]);
      k = k + 1;
    }
    inner = inner + "]";
  } else {
    inner = t.base;
  }
  let d: i32 = 0;
  while (d < t.array_depth) {
    inner = inner + "[]";
    d = d + 1;
  }
  return inner;
}

// split_dunder splits a `__`-joined string into its tokens. A type name can
// hold `__` itself, so an instantiation key is split by `split_key`, which
// regroups the tokens.
function split_dunder(s: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i + 1 < s.len()) {
    if (slice_unchecked(s, i, i + 2) == "__") {
      out = out.append(slice_unchecked(s, start, i) + "");
      i = i + 2;
      start = i;
      continue;
    }
    i = i + 1;
  }
  out = out.append(slice_unchecked(s, start, s.len()) + "");
  return out;
}

// split_key splits a joined instantiation key into `n` per-parameter pieces.
// `__` is the joiner, but a piece can hold `__` of its own: a module-qualified
// type (`idle__Idle3`) or a nested clone (`Box__i32`). So a run of tokens is
// one piece where it names a declared struct or enum, taking that type's own
// arguments with it where it is generic, and every other token is a piece by
// itself. A key whose tokens already number `n` splits as `split_dunder` does.
function split_key(s: string, n: i32, structs: StructDecl[], enums: EnumDecl[]): string[] {
  if (n <= 1) {
    return [s];
  }
  let tokens: string[] = split_dunder(s);
  if (tokens.len() <= n) {
    return tokens;
  }
  let g: Grouped = group_tokens(tokens, 0, n, tokens.len() - n, structs, enums);
  if (g.pieces.len() != n || g.at != tokens.len()) {
    return tokens;
  }
  return g.pieces;
}

// The pieces grouped so far and the token the next one starts at.
struct Grouped { pieces: string[], at: i32 }

// `n` pieces from tokens[at..], with `spare` tokens to spend beyond one per
// piece.
function group_tokens(tokens: string[], at0: i32, n: i32, spare0: i32, structs: StructDecl[], enums: EnumDecl[]): Grouped {
  let pieces: string[] = [];
  let at: i32 = at0;
  let spare: i32 = spare0;
  while (pieces.len() < n && at < tokens.len()) {
    let one: Grouped = take_piece(tokens, at, spare, structs, enums);
    spare = spare - (one.at - at - 1);
    pieces = pieces.append(one.pieces[0]);
    at = one.at;
  }
  return Grouped { pieces: pieces, at: at };
}

// One piece from tokens[at..]: the longest run of up to `spare` tokens past
// the first that names a declared struct or enum, with that type's arguments
// grouped after it where it is generic; else the one token.
function take_piece(tokens: string[], at: i32, spare: i32, structs: StructDecl[], enums: EnumDecl[]): Grouped {
  let k: i32 = spare;
  while (k >= 0) {
    let end: i32 = at + k + 1;
    let cand: string = join_dunder(tokens, at, end);
    let params: i32 = declared_params(cand, structs, enums);
    if (params == 0) {
      return Grouped { pieces: [cand], at: end };
    }
    if (params > 0 && spare - k - params >= 0) {
      let args: Grouped = group_tokens(tokens, end, params, spare - k - params, structs, enums);
      if (args.pieces.len() == params) {
        return Grouped { pieces: [cand + "__" + join_dunder(args.pieces, 0, params)], at: args.at };
      }
    }
    k = k - 1;
  }
  return Grouped { pieces: [tokens[at]], at: at + 1 };
}

// How many type parameters the declared struct or enum `name` takes, or -1
// when nothing declares it.
function declared_params(name: string, structs: StructDecl[], enums: EnumDecl[]): i32 {
  for sd in structs {
    if (sd.name == name) {
      return sd.type_params.len();
    }
  }
  for ed in enums {
    if (ed.name == name) {
      return ed.type_params.len();
    }
  }
  return 0 - 1;
}

function join_dunder(xs: string[], from: i32, to: i32): string {
  let out: string = "";
  let i: i32 = from;
  while (i < to) {
    if (i > from) {
      out = out + "__";
    }
    out = out + xs[i];
    i = i + 1;
  }
  return out;
}

// sanitize_key turns a (possibly composite) instantiation key into a symbol-
// safe mangled suffix: a generic-enum type argument carries brackets / commas
// (`Box[Opt[i32]]`'s key is `Opt[i32]`), which can't appear in a struct clone's
// name. Rewrite `[` and `,` to the `__` separator and drop `]` / spaces, so
// `Opt[i32]` → `Opt__i32` and `Pair[i32, string]` → `Pair__i32__string`. A key
// that is already bracket-free (every existing case — a primitive, a bare
// struct, or a nested struct clone like `Box__i32`) passes through unchanged, so
// this is a no-op on the pre-existing instantiations and only reshapes the
// generic-struct-of-generic-enum combo (#3694). The raw bracketed key is kept
// for field-type SUBSTITUTION (so the enum pass still sees `Opt[i32]` to clone);
// only the emitted NAME is sanitized.
pub function sanitize_key(s: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < s.len()) {
    let ch: u8 = s[i];
    if (ch == b'[') {
      out = out + "__";
    } else if (ch == b']') {} else if (ch == b',') {
      out = out + "__";
    } else if (ch == b';') {  // the multi-param key separator
      out = out + "__";
    } else if (ch == b' ') {} else {
      out = out + slice_unchecked(s, i, i + 1);
    }
    i = i + 1;
  }
  return out;
}

// bind_unify matches a parameter-type pattern against the argument's
// inferred concrete type, recording a binding for each type variable it
// pins down. Handles a bare variable (`T` ⊢ i32), an array element
// (`T[]` vs `i32[]` ⊢ T=i32), and a same-base composite of equal arity
// (`Map[K, V]` vs `Map[i32, string]` ⊢ K=i32, V=string). First binding
// for a variable wins (so a later opaque argument can't clobber it).
// Whether a type SPELLING mentions any of `tparams`. The structural form of
// `tp_index`, which answers only for a spelling that IS one of them.
function spelling_mentions_tparam(name: string, tparams: string[]): boolean {
  if (name.len() == 0) {
    return false;
  }
  for v in collect_tvars(name, []) {
    if (tp_index(v, tparams) >= 0) {
      return true;
    }
  }
  return false;
}

function bind_unify(pattern: string, concrete: string, tparams: string[], binds: MEnv, funcs: MFns): MEnv {
  if (tp_index(pattern, tparams) >= 0) {
    if (binds.elook(pattern).len() == 0 && concrete.len() > 0) {
      return binds.ebind(pattern, concrete);
    }
    return binds;
  }
  if (type_ends_arr(pattern) && type_ends_arr(concrete)) {
    return bind_unify(slice_unchecked(pattern, 0, pattern.len() - 2), slice_unchecked(concrete, 0, concrete.len() - 2), tparams, binds, funcs);
  }
  if (spelling_is_view(pattern)) {
    let elem: string = array_method_element(concrete);
    if (elem.len() > 0) {
      return bind_unify(array_method_element(pattern), elem, tparams, binds, funcs);
    }
  }
  // Tuple pattern `(K, V)` vs `(i32, i32)` — destructure the parens and unify
  // pairwise, so a tuple (or tuple-array, via the array case above) parameter
  // recovers its element type vars. first_bracket only finds `[`, so without
  // this a tuple param's vars never bind (`from[K,V](pairs: (K,V)[])`).
  if (util.is_tuple_type_name(pattern) && slice_unchecked(pattern, pattern.len() - 1, pattern.len()) == ")"
    && util.is_tuple_type_name(concrete) && slice_unchecked(concrete, concrete.len() - 1, concrete.len()) == ")") {
    let tpparts: string[] = split_top_commas(slice_unchecked(pattern, 1, pattern.len() - 1));
    let tcparts: string[] = split_top_commas(slice_unchecked(concrete, 1, concrete.len() - 1));
    if (tpparts.len() == tcparts.len()) {
      let tb: MEnv = binds;
      let tj: i32 = 0;
      while (tj < tpparts.len()) {
        tb = bind_unify(tpparts[tj], tcparts[tj], tparams, tb, funcs);
        tj = tj + 1;
      }
      return tb;
    }
  }
  // Callable pattern `(A) => R` vs `(Sq) => i32`: parameters pairwise, then
  // the result, so a function-typed parameter's variables bind from a
  // function value passed for it.
  if (callable_ret_spelling(pattern).len() > 0 && callable_ret_spelling(concrete).len() > 0) {
    let fpp: string[] = callable_param_spellings(pattern);
    let fcp: string[] = callable_param_spellings(concrete);
    if (fpp.len() == fcp.len()) {
      let fb: MEnv = binds;
      let fj: i32 = 0;
      while (fj < fpp.len()) {
        fb = bind_unify(fpp[fj], fcp[fj], tparams, fb, funcs);
        fj = fj + 1;
      }
      return bind_unify(callable_ret_spelling(pattern), callable_ret_spelling(concrete), tparams, fb, funcs);
    }
  }
  let pb: i32 = first_bracket(pattern);
  let cb: i32 = first_bracket(concrete);
  if (pb > 0 && cb > 0 && slice_unchecked(pattern, pattern.len() - 1, pattern.len()) == "]" && slice_unchecked(concrete, concrete.len() - 1, concrete.len()) == "]") {
    if (slice_unchecked(pattern, 0, pb) == slice_unchecked(concrete, 0, cb)) {
      let pparts: string[] = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
      let cparts: string[] = split_top_commas(slice_unchecked(concrete, cb + 1, concrete.len() - 1));
      if (pparts.len() == cparts.len()) {
        let b: MEnv = binds;
        let j: i32 = 0;
        while (j < pparts.len()) {
          b = bind_unify(pparts[j], cparts[j], tparams, b, funcs);
          j = j + 1;
        }
        return b;
      }
    }
  }
  // The pattern is a generic instantiation (`Box[U]`) but the concrete is its
  // already-MANGLED clone name (`Box__i32`) — a nested generic value whose
  // literal was rewritten before this key inference (a generic struct/enum
  // field of another generic struct). Recover the concrete's type args from
  // the `__`-mangled key and unify, one piece per pattern argument
  // (split_key).
  if (pb > 0 && slice_unchecked(pattern, pattern.len() - 1, pattern.len()) == "]" && cb < 0) {
    let pbase: str = slice_unchecked(pattern, 0, pb);
    let mpfx: string = pbase + "__";
    if (concrete.len() > mpfx.len() && util.str_has_prefix(concrete, mpfx)) {
      let pp: string[] = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
      let ckey: str = slice_unchecked(concrete, mpfx.len(), concrete.len());
      let cp: string[] = split_key(ckey + "", pp.len(), funcs.structs, funcs.enums);
      if (pp.len() == cp.len()) {
        let b2: MEnv = binds;
        let j2: i32 = 0;
        while (j2 < pp.len()) {
          b2 = bind_unify(pp[j2], cp[j2], tparams, b2, funcs);
          j2 = j2 + 1;
        }
        return b2;
      }
    }
  }
  return binds;
}

// lambda_ret_of returns the concrete return type of a fn-valued ARGUMENT —
// what lets a type parameter that appears ONLY in a fn-param's return
// position (`key: (T) => K`) be bound from the closure passed for it.
// The coarse "fn" tag on the param carries no args, so bind_unify over
// the param's type_name never sees `K`; the return spelling is recovered
// here instead. Prefers the lambda's explicit `: R` annotation; for an
// arrow / `use_infer` lambda with no annotation, infers R from the first
// `return` in the body, typed under an env extended with the lambda's
// own (declared) params. "" for a non-lambda arg or an unknown body type
// — the call then stays generic exactly as before.
function lambda_ret_of(e: ast.Expr, env: MEnv, funcs: MFns): string {
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.ret_type.len() > 0) {
        return fn_tag_spelling(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types);
      }
      let lenv: MEnv = env;
      let pi: i32 = 0;
      while (pi < lm.params.len()) {
        lenv = lenv.ebind(lm.params[pi].name, lm.params[pi].type_name);
        pi = pi + 1;
      }
      let si: i32 = 0;
      while (si < lm.body.len()) {
        match (lm.body[si]) {
          ast.StmtReturn(r) => {
            return mono_infer(r.value, lenv, funcs);
          },
          _ => {}
        }
        si = si + 1;
      }
      return "";
    },
    ast.ExprIdent(fid) => {
      // A bare function NAME passed for a fn param (`b.map(dbl)`): its
      // declared return type binds the var the closure's return position
      // carries, exactly as a lambda's does. Without this a method type
      // param reachable only through `f: (T) => U` stays unbound and the
      // call keeps the un-instantiated template. A name the env already
      // binds is a LOCAL holding a closure, not a reference to the
      // like-named top-level function: a fn PARAM carries its return type
      // in the "fn => <ret>" encoding (env_from_params); any other local
      // says nothing about the value and stays unknown.
      let et: string = env.elook(fid.name);
      if (et.len() > 0) {
        return me_fn_ret_spelling(et);
      }
      return func_ret_of(funcs.decls, fid.name);
    },
    ast.ExprCall(_) => {
      // A call returning a function, or a function-typed field: the
      // declaration spells the value's signature in its sidecars.
      return callable_ret_spelling(fn_value_spelling(e, env, funcs));
    },
    ast.ExprFieldAccess(_) => {
      return callable_ret_spelling(fn_value_spelling(e, env, funcs));
    },
    _ => {
      return "";
    }
  }
  return "";
}

// infer_inst infers the concrete instantiation of `fd`'s type
// parameters from a call's arguments and returns them joined by `__` in
// declaration order (e.g. `i32`, or `i32__string` for `Map[K, V]`).
// Every argument contributes its bindings (so `assert_eq(x.to_upper(), "Y")`
// still resolves via the literal second argument when the first is opaque, and
// `Map[K, V]` recovers both K and V from a single map argument) —
// full_ret_binds is where they are collected. Returns "" if any type parameter
// is left unbound: the key is "", and the call stays the generic template.
function infer_inst(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  if (fd.type_params.len() == 0) {
    return "";
  }
  return binds_to_key(fd.type_params, full_ret_binds(fd, args, env, funcs, fd.type_params));
}

// infer_folded_inst is infer_inst for a method folded into a free generic,
// its receiver at argument 0: a written list names the method's own type
// parameters, which follow the receiver's, so it binds the trailing ones.
function infer_folded_inst(fd: FuncDecl, args: ast.Expr[], type_args: string[], env: MEnv, funcs: MFns): string {
  if (fd.type_params.len() == 0) {
    return "";
  }
  let binds: MEnv = full_ret_binds(fd, args, env, funcs, fd.type_params);
  let skip: i32 = fd.type_params.len() - type_args.len();
  let j: i32 = 0;
  while (skip >= 0 && j < type_args.len()) {
    if (type_args[j].len() > 0) {
      binds = bind_unify(fd.type_params[skip + j], type_args[j], fd.type_params, binds, funcs);
    }
    j = j + 1;
  }
  return binds_to_key(fd.type_params, binds);
}

// explicit_inst_key is the instantiation a call spells itself (`f[i32](x)`),
// keyed as infer_inst keys one, or "" when the call writes none or not one
// per type parameter. It is read before the arguments and the destination
// are: a type parameter that appears only in the result, or one forwarded
// from the caller's own (`decode[T](s)` in a generic body, substituted by
// the clone), binds from nothing else.
function explicit_inst_key(fd: FuncDecl, type_args: string[]): string {
  if (fd.type_params.len() == 0 || type_args.len() != fd.type_params.len()) {
    return "";
  }
  let key: string = "";
  let j: i32 = 0;
  while (j < type_args.len()) {
    if (type_args[j].len() == 0) {
      return "";
    }
    if (j > 0) {
      key = key + ";";
    }
    key = key + type_args[j];
    j = j + 1;
  }
  return key;
}

// key_parts splits an instantiation key for `fd` the way clone_bg does: a
// single type parameter's key is the one type verbatim.
function key_parts(fd: FuncDecl, key: string): string[] {
  if (fd.type_params.len() == 1) {
    return [key];
  }
  return split_inst_key(key);
}

// binds_to_key joins a resolved binding env into the ';'-separated
// instantiation key infer_inst returns, or "" if any type param is unbound.
function binds_to_key(tparams: string[], binds: MEnv): string {
  let key: string = "";
  let j: i32 = 0;
  while (j < tparams.len()) {
    let b: string = binds.elook(tparams[j]);
    if (b.len() == 0) {
      return "";
    }
    // Join multi-param instantiation keys with ';' (a char that never
    // appears in a type name) rather than '__': a per-param value can
    // itself be a module-mangled type (`iter__ArrayIter[i32]`) whose
    // embedded '__' would make split_dunder split the key into the wrong
    // arity (the documented multi-param limitation). split_inst_key splits
    // on ';' so each value stays intact; sanitize_key maps ';' -> '__' so
    // the emitted clone NAME is unchanged for the simple multi-param case.
    if (j > 0) {
      key = key + ";";
    }
    key = key + b;
    j = j + 1;
  }
  return key;
}

// infer_inst_ret is infer_inst PLUS return-type-directed instantiation: it
// also binds any type param left unbound by the arguments from `expected_ret`
// unified against `fd.ret_type`. This is what instantiates a no-argument
// generic constructor from its call-site annotation — `let b: Box[i32] =
// mk()` binds mk[T]()'s `T` (which appears ONLY in the `Box[T]` return) from
// the `Box[i32]` annotation. Without it such a call stays the un-monomorphised
// template (T unbound), whose `Box { xs: [] }` can't lower, so the module
// bails (std/set's `set_new` → segfault). Returns "" when
// still incomplete (the call then stays generic, as before).
function infer_inst_ret(fd: FuncDecl, args: ast.Expr[], expected_ret: string, env: MEnv, funcs: MFns): string {
  if (fd.type_params.len() == 0) {
    return "";
  }
  let binds: MEnv = full_ret_binds(fd, args, env, funcs, fd.type_params);
  if (expected_ret.len() > 0) {
    binds = bind_unify(fd.ret_type, expected_ret, fd.type_params, binds, funcs);
  }
  return binds_to_key(fd.type_params, binds);
}

// split_inst_key splits a multi-param instantiation key (joined by infer_inst
// with ';') back into its per-param concrete types, preserving any '__' inside
// a single module-mangled value. The ';'-free single-param key is handled by
// the callers' `[key]` fast path (never reaches here).
function split_inst_key(s: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == b';') {
      out = out.append(slice_unchecked(s, start, i) + "");
      i = i + 1;
      start = i;
      continue;
    }
    i = i + 1;
  }
  out = out.append(slice_unchecked(s, start, s.len()) + "");
  return out;
}

// tv_word_char reports whether `c` continues a type-name token (a letter,
// digit or `_`) — the token boundary type_str_vars scans on.
function tv_word_char(c: i32): boolean {
  return c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95;
}

// type_str_vars collects the type variables appearing in a coarse type
// spelling, appended to `acc` (deduped): each maximal `[A-Za-z0-9_]` run
// looks_type_var accepts, so it finds `T` in `T[]` and both `K` and `V` in
// `Map[K, V]`.
function type_str_vars(ty: string, acc: string[]): string[] {
  let out: string[] = acc;
  let i: i32 = 0;
  let n: i32 = ty.len();
  while (i < n) {
    if (tv_word_char(ty[i] as i32)) {
      let start: i32 = i;
      while (i < n && tv_word_char(ty[i] as i32)) {
        i = i + 1;
      }
      let tok: string = slice_unchecked(ty, start, i) + "";
      if (looks_type_var(tok) && !util.has_str(out, tok)) {
        out = out.append(tok);
      }
    } else {
      i = i + 1;
    }
  }
  return out;
}

// full_ret_binds unifies EVERY param of `fd` against its argument to bind
// the type vars in `vars` — bounded AND unbounded alike. call_ret_type
// uses it to recover an unbounded element param that survives the
// bounded-only substitution (the `T` in `sort_key[T, K: Ord](xs, key):
// T[]`, erased from fd.type_params). A fn-param's own return var is
// bound from the lambda argument's return type (mirroring infer_inst).
// lambda_param_types_of returns the DECLARED parameter types of a fn-typed
// argument — a lambda's own annotations, or a bare function NAME's declared
// params. The argument-position sibling of lambda_ret_of: `keep: (T) => boolean`
// puts T in the closure's PARAMETER, which the coarse "fn" type_name tag drops
// just as it drops the return. A name the env already binds is a LOCAL holding
// a closure, not the like-named top-level function, so it says nothing here —
// the same exclusion lambda_ret_of makes.
function lambda_param_types_of(e: ast.Expr, env: MEnv, funcs: MFns): string[] {
  let none: string[] = [];
  match (e) {
    ast.ExprLambda(lm) => {
      let out: string[] = [];
      let pi: i32 = 0;
      while (pi < lm.params.len()) {
        out = out.append(lm.params[pi].type_name);
        pi = pi + 1;
      }
      return out;
    },
    ast.ExprIdent(fid) => {
      let bt: string = env.elook(fid.name);
      if (bt.len() > 0) {
        // A callable spelling records its parameters; the coarse
        // "fn => <ret>" a fn PARAM carries records only its result.
        let br: TypeRef = parse_type_ref(bt);
        if (!ref_is_fn_value(br)) {
          return none;
        }
        let bf: TypeRef = ref_ungroup(br);
        let bout: string[] = [];
        let bi: i32 = 0;
        while (bi + 1 < bf.args.len()) {
          bout = bout.append(render_type_ref(bf.args[bi]));
          bi = bi + 1;
        }
        return bout;
      }
      return func_param_types_of(funcs.decls, fid.name);
    },
    ast.ExprCall(_) => {
      return callable_param_spellings(fn_value_spelling(e, env, funcs));
    },
    ast.ExprFieldAccess(_) => {
      return callable_param_spellings(fn_value_spelling(e, env, funcs));
    },
    _ => {
      return none;
    }
  }
  return none;
}

// fn_value_spelling is the callable spelling `(P, …) => R` of a function value
// a call to a top-level function returns, or a function-typed struct field
// holds, read off the declaration's sidecars; "" for anything else.
function fn_value_spelling(e: ast.Expr, env: MEnv, funcs: MFns): string {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (env.elook(id.name).len() > 0) {
        return "";
      }
      for fd in funcs.decls {
        // A generic callee's signature is spelled in its own variables,
        // which would key the clone on a bare var.
        if (fd.name == id.name && fd.receiver_type.len() == 0 && fd.ret_type == "fn" && fd.ret_fn_ret.len() > 0
          && !spelling_mentions_tparam(fd.ret_fn_ret, fd.type_params) && !spelling_mentions_tparam(fd.ret_fn_param_types, fd.type_params)) {
          return "(" + fd.ret_fn_param_types + ") => " + fd.ret_fn_ret;
        }
      }
    }
  }
  if let ast.ExprFieldAccess(fa) = e {
    let owner: InstStruct = inst_struct(mono_infer(fa.obj, env, funcs), funcs.structs, funcs.enums);
    if (owner.at >= 0) {
      let sd: StructDecl = funcs.structs[owner.at];
      for f in sd.fields {
        if (f.name == fa.field && f.type_name == "fn" && f.fn_ret.len() > 0) {
          return "(" + subst_ty_join(split_top_commas(f.fn_param_types), ", ", sd.type_params, owner.cts) + ") => " + subst_ty(f.fn_ret, sd.type_params, owner.cts);
        }
      }
    }
  }
  return "";
}

// fn_value_inst_key keys the instantiation of the generic `fd` named as a
// value where the callable spelling `expected` (`(A, …) => R`) is wanted: each
// parameter unified against its counterpart and the result against `R`. ""
// when that leaves a type parameter unbound, or `expected` is no callable.
function fn_value_inst_key(fd: FuncDecl, expected: string, funcs: MFns): string {
  let ret: string = callable_ret_spelling(expected);
  let ps: string[] = callable_param_spellings(expected);
  if (ret.len() == 0 || ps.len() != fd.params.len()) {
    return "";
  }
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  let i: i32 = 0;
  while (i < ps.len()) {
    binds = bind_unify(param_spelling(fd.params[i]), ps[i], fd.type_params, binds, funcs);
    i = i + 1;
  }
  let fret: string = fd.ret_type;
  if (fret == "fn") {
    fret = "(" + fd.ret_fn_param_types + ") => " + fd.ret_fn_ret;
  }
  binds = bind_unify(fret, ret, fd.type_params, binds, funcs);
  let key: string = binds_to_key(fd.type_params, binds);
  // A binding to a type variable is the enclosing template's, not a type:
  // its clone's body comes back here with the variable substituted.
  for part in split_inst_key(key) {
    if (type_str_vars(part, []).len() > 0) {
      return "";
    }
  }
  return key;
}

// param_spelling is a parameter's full type spelling: a function-typed one's
// `fn` tag expanded from its sidecars.
function param_spelling(p: ast.ParamDecl): string {
  if (p.type_name == "fn") {
    return "(" + p.fn_param_types + ") => " + p.fn_ret;
  }
  return p.type_name;
}

// generic_fn_value_name is the name a bounded generic function is named by
// when `e` names one as a value (`f`, or `mod.f`), else "".
function generic_fn_value_name(e: ast.Expr, env: MEnv, funcs: MFns): string {
  if let ast.ExprIdent(id) = e {
    if (env.elook(id.name).len() == 0 && bg_find(funcs, id.name) >= 0) {
      return id.name;
    }
  }
  if let ast.ExprFieldAccess(fa) = e {
    if let ast.ExprIdent(m) = fa.obj {
      if (bg_find(funcs, m.name + "." + fa.field) >= 0) {
        return m.name + "." + fa.field;
      }
    }
  }
  return "";
}

// mono_fn_value names the clone of the generic function `e` names as a value,
// keyed by the callable spelling `expected` it is wanted at; `e` unchanged
// when that does not determine the clone. The checker accepts only the
// references the expected type determines (E040 otherwise).
function mono_fn_value(e: ast.Expr, expected: string, env: MEnv, funcs: MFns, ins: Insts): RExpr {
  let name: string = generic_fn_value_name(e, env, funcs);
  if (name.len() == 0 || expected.len() == 0) {
    return RExpr { rexpr: e, rins: ins };
  }
  let key: string = fn_value_inst_key(funcs.decls[bg_find(funcs, name)], expected, funcs);
  if (key.len() == 0) {
    return RExpr { rexpr: e, rins: ins };
  }
  let cur: Insts = ins.iadd(name, key);
  if let ast.ExprIdent(id) = e {
    return RExpr { rexpr: ast.ExprIdent { ...id, name: name + "__" + sanitize_key(key) }, rins: cur };
  }
  if let ast.ExprFieldAccess(fa) = e {
    return RExpr { rexpr: ast.ExprFieldAccess { ...fa, field: fa.field + "__" + sanitize_key(key) }, rins: cur };
  }
  return RExpr { rexpr: e, rins: ins };
}

// call_param_spellings is the parameter spellings of the top-level function a
// call names, with a generic callee's own type parameters substituted from
// the call; empty for any other callee.
function call_param_spellings(c: ast.ExprCall, env: MEnv, funcs: MFns): string[] {
  let none: string[] = [];
  let name: string = "";
  if let ast.ExprIdent(cid) = c.callee {
    if (env.elook(cid.name).len() > 0) {
      return callable_param_spellings(env.elook(cid.name));
    }
    name = cid.name;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    if let ast.ExprIdent(m) = fa.obj {
      name = m.name + "." + fa.field;
    }
  }
  if (name.len() == 0) {
    return none;
  }
  for fd in funcs.decls {
    if (fd.name == name && fd.receiver_type.len() == 0) {
      // The callee's type variables, bounded or erased, as its other
      // arguments bind them; one left unbound stays itself, and a clone
      // keyed on it is refused below.
      let binds: MEnv = full_ret_binds(fd, c.args, env, funcs, fd.all_type_params);
      let cts: string[] = [];
      for v in fd.all_type_params {
        if (binds.elook(v).len() > 0) {
          cts = cts.append(binds.elook(v));
        } else {
          cts = cts.append(v);
        }
      }
      let out: string[] = [];
      for p in fd.params {
        out = out.append(subst_ty(param_spelling(p), fd.all_type_params, cts));
      }
      return out;
    }
  }
  return none;
}

// mono_call_args rewrites a call's arguments, cloning a generic function named
// as a value at the callable spelling its parameter wants.
function mono_call_args(c: ast.ExprCall, env: MEnv, funcs: MFns, ins: Insts): (ast.Expr[], Insts) {
  let nargs: ast.Expr[] = [];
  let cur: Insts = ins;
  let pspell: string[] = [];
  if (call_names_fn_value(c, env, funcs)) {
    pspell = call_param_spellings(c, env, funcs);
  }
  let i: i32 = 0;
  while (i < c.args.len()) {
    let ra: RExpr = mono_expr(c.args[i], env, funcs, cur);
    if (i < pspell.len() && generic_fn_value_name(c.args[i], env, funcs).len() > 0) {
      ra = mono_fn_value(c.args[i], pspell[i], env, funcs, cur);
    }
    cur = ra.rins;
    nargs = nargs.append(ra.rexpr);
    i = i + 1;
  }
  return (nargs, cur);
}

// call_names_fn_value reports whether any argument names a generic function
// as a value, the only case call_param_spellings is needed for.
function call_names_fn_value(c: ast.ExprCall, env: MEnv, funcs: MFns): boolean {
  for a in c.args {
    if (generic_fn_value_name(a, env, funcs).len() > 0) {
      return true;
    }
  }
  return false;
}

// callable_ret_spelling is the result of a callable spelling.
function callable_ret_spelling(t: string): string {
  if (t.len() == 0) {
    return "";
  }
  let r: TypeRef = parse_type_ref(t);
  if (!r.is_fn || r.args.len() == 0) {
    return "";
  }
  return render_type_ref(r.args[r.args.len() - 1]);
}

// callable_param_spellings is the parameter list of a callable spelling.
function callable_param_spellings(t: string): string[] {
  let none: string[] = [];
  if (t.len() == 0) {
    return none;
  }
  let r: TypeRef = parse_type_ref(t);
  if (!r.is_fn) {
    return none;
  }
  let out: string[] = [];
  let i: i32 = 0;
  while (i + 1 < r.args.len()) {
    out = out.append(render_type_ref(r.args[i]));
    i = i + 1;
  }
  return out;
}

// func_param_types_of reads a top-level function's declared parameter types.
function func_param_types_of(decls: FuncDecl[], name: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < decls.len()) {
    if (decls[i].name == name && decls[i].receiver_type.len() == 0) {
      let k: i32 = 0;
      while (k < decls[i].params.len()) {
        out = out.append(decls[i].params[k].type_name);
        k = k + 1;
      }
      return out;
    }
    i = i + 1;
  }
  return out;
}

// full_ret_binds unifies each argument against the parameter it is passed to,
// recording what that pins down about `vars`. Every caller of the generic
// instantiation machinery binds through this one loop: infer_inst keys a call
// from it, infer_inst_ret adds the call-site annotation on top, and the
// residual-substitution pass asks it directly.
//
// Three things contribute, and a type param can be reachable through only one
// of them:
//
//   - the parameter's own type (`xs: T[]` against an `i32[]` argument);
//   - a fn-param's RESULT (`key: (T) => K`), read off the closure argument;
//   - a fn-param's ARGUMENT positions (`keep: (T) => boolean`) —
//     `filter[T, I: Iterator[T]]` reaches T only there, so without this clause
//     T survived as a residual and a downstream generic monomorphised at the
//     type PARAMETER itself (`unknown symbol T.cmp`).
//
// Both fn-param clauses gate on the variable being MENTIONED by the spelling,
// not on it being the whole of it: `map_rank[T, U](f: (NdArray[T]) => NdArray[U])`
// carries each inside a bracketed spelling, and bind_unify descends into one
// (#9927).
function full_ret_binds(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns, vars: string[]): MEnv {
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  let i: i32 = 0;
  while (i < fd.params.len()) {
    if (i < args.len()) {
      let ct: string = mono_infer(args[i], env, funcs);
      // An array or view of callables unifies as its spelling, so the
      // variables in the callables' signature bind from the argument's.
      let pattern: string = fd.params[i].type_name;
      if (pattern != "fn" && is_fn_contract_tag(pattern) && fd.params[i].fn_ret.len() > 0) {
        pattern = fn_tag_spelling(pattern, fd.params[i].fn_ret, fd.params[i].fn_param_types);
      }
      if (ct.len() > 0) {
        binds = bind_unify(pattern, ct, vars, binds, funcs);
      } else {
        binds = variant_arg_binds(fd.params[i].type_name, args[i], env, funcs, vars, binds);
      }
      // A generic function named as the argument answers its own template's
      // spellings, whose variables pin nothing of this call's.
      if (fd.params[i].type_name == "fn" && spelling_mentions_tparam(fd.params[i].fn_ret, vars)) {
        let lr: string = lambda_ret_of(args[i], env, funcs);
        if (lr.len() > 0 && type_str_vars(lr, []).len() == 0) {
          binds = bind_unify(fd.params[i].fn_ret, lr, vars, binds, funcs);
        }
      }
      if (fd.params[i].type_name == "fn") {
        let fpts: string[] = split_top_commas(fd.params[i].fn_param_types);
        let lpts: string[] = lambda_param_types_of(args[i], env, funcs);
        let q: i32 = 0;
        while (q < fpts.len()) {
          if (q < lpts.len() && lpts[q].len() > 0 && spelling_mentions_tparam(fpts[q], vars) && type_str_vars(lpts[q], []).len() == 0) {
            binds = bind_unify(fpts[q], lpts[q], vars, binds, funcs);
          }
          q = q + 1;
        }
      }
    }
    i = i + 1;
  }
  return binds;
}

// variant_arg_binds binds the variables a parameter pins through a variant
// construction argument `V(payload)` of the generic enum Base. The payload's
// inferred types bind the enum's own variables through the variant's field
// types. A `Base[..]` parameter carries each so bound over to its argument in
// the same position; a bare type-variable parameter (`a: C`) binds to the
// whole `Base[..]` once every enum variable is bound. mono_infer has no type
// for a bare construction, so this is the one way `pair(Full(9))` settles a
// variable only the payload names.
function variant_arg_binds(pattern: string, arg: ast.Expr, env: MEnv, funcs: MFns, vars: string[], binds: MEnv): MEnv {
  if let ast.ExprCall(c) = arg {
    let vname: string = ctor_variant_name(c.callee, funcs.enums, env, funcs);
    if (vname.len() > 0) {
      let owner: i32 = genum_owner_of_variant(funcs.enums, vname);
      if (owner < 0) {
        return builtin_variant_arg_binds(pattern, c, env, funcs, vars, binds);
      }
      let ed: EnumDecl = funcs.enums[owner];
      let own: MEnv = me_variant_binds(ed, vname, c.args, env, funcs.structs, funcs);
      if (str_list_contains(vars, pattern)) {
        let whole: string = bound_spelling(ed.name, ed.type_params, own);
        if (whole.len() == 0) {
          return binds;
        }
        return bind_unify(pattern, whole, vars, binds, funcs);
      }
      let pb: i32 = first_bracket(pattern);
      if (pb <= 0 || slice_unchecked(pattern, pattern.len() - 1, pattern.len()) != "]") {
        return binds;
      }
      if (slice_unchecked(pattern, 0, pb) != ed.name) {
        return binds;
      }
      let pargs: string[] = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
      if (pargs.len() != ed.type_params.len()) {
        return binds;
      }
      let out: MEnv = binds;
      let j: i32 = 0;
      while (j < pargs.len()) {
        let b: string = own.elook(ed.type_params[j]);
        if (b.len() > 0) {
          out = bind_unify(pargs[j], b, vars, out, funcs);
        }
        j = j + 1;
      }
      return out;
    }
  }
  return binds;
}

// builtin_variant_arg_binds is variant_arg_binds for the builtin `Some`, `Ok`
// and `Err`: the payload binds the matching argument of an `Option[..]` or
// `Result[..]` parameter, and the other half stays for another argument. A
// number literal payload binds nothing, as its width is the parameter's to
// decide.
function builtin_variant_arg_binds(pattern: string, c: ast.ExprCall, env: MEnv, funcs: MFns, vars: string[], binds: MEnv): MEnv {
  if (c.args.len() != 1 || number_literal_tree(c.args[0])) {
    return binds;
  }
  let slot: i32 = 0 - 1;
  let base: string = "";
  if let ast.ExprIdent(cid) = c.callee {
    if (cid.name == "Some") {
      base = "Option";
      slot = 0;
    }
    if (cid.name == "Ok") {
      base = "Result";
      slot = 0;
    }
    if (cid.name == "Err") {
      base = "Result";
      slot = 1;
    }
  }
  let pb: i32 = first_bracket(pattern);
  if (slot < 0 || pb <= 0 || slice_unchecked(pattern, pattern.len() - 1, pattern.len()) != "]") {
    return binds;
  }
  if (slice_unchecked(pattern, 0, pb) != base) {
    return binds;
  }
  let pargs: string[] = split_top_commas(slice_unchecked(pattern, pb + 1, pattern.len() - 1));
  if (slot >= pargs.len()) {
    return binds;
  }
  let pt: string = mono_infer(c.args[0], env, funcs);
  if (pt.len() == 0) {
    return binds;
  }
  return bind_unify(strip_ws(pargs[slot]), pt, vars, binds, funcs);
}

// func_ret_of returns the return type of a plain function by name.
function func_ret_of(funcs: FuncDecl[], name: string): string {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && funcs[i].receiver_type.len() == 0) {
      return funcs[i].ret_type;
    }
    i = i + 1;
  }
  return "";
}

// func_param_type_at returns the declared type spelling of parameter `idx`
// of the receiver-less function named `name`, or "" (name not found, or idx
// out of range). The generic-enum monomorphiser uses it to pin a bare
// unit-variant call argument (`get(Non)`) from the callee's parameter type —
// the call-site analogue of the `let o: Opt[i32] = Non` annotation.
function func_param_type_at(funcs: FuncDecl[], name: string, idx: i32): string {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_name.len() == 0 && funcs[i].receiver_type.len() == 0) {
      if (idx >= 0 && idx < funcs[i].params.len()) {
        return funcs[i].params[idx].type_name;
      }
      return "";
    }
    i = i + 1;
  }
  return "";
}

function call_ret_type(funcs: MFns, name: string, args: ast.Expr[], env: MEnv): string {
  let fi: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < funcs.decls.len()) {
    if (funcs.decls[i].name == name && funcs.decls[i].receiver_name.len() == 0 && funcs.decls[i].receiver_type.len() == 0) {
      fi = i;
    }
    i = i + 1;
  }
  if (fi < 0) {
    return "";
  }
  return decl_call_ret_type(funcs, funcs.decls[fi], args, env);
}

function decl_call_ret_type(funcs: MFns, fd: FuncDecl, args: ast.Expr[], env: MEnv): string {
  // A generic whose type params were ALL erased — every one unbounded —
  // still carries them in its RETURN type: `pick2[T](keep: (T) => boolean):
  // T[]` reaches here with type_params empty and ret_type "T[]". Handing
  // that back verbatim gives the caller an unresolved element type, and a
  // downstream generic then monomorphises at the type PARAMETER itself
  // (`unknown symbol T.cmp`). Route it through the same residual resolution
  // the PARTIALLY-erased case below already uses; only a genuinely
  // var-free return type takes the fast path.
  if (fd.type_params.len() == 0) {
    let evars: string[] = type_str_vars(fd.ret_type, []);
    if (evars.len() == 0) {
      return fd.ret_type;
    }
    return resolve_residual_ret(fd, args, env, funcs, fd.ret_type, evars);
  }
  let key: string = infer_inst(fd, args, env, funcs);
  if (key.len() == 0) {
    return "";
  }
  let cts: string[] = [key];
  if (fd.type_params.len() != 1) {
    cts = split_inst_key(key);
  }
  let rt: string = resolve_proj_in_type(subst_ty(fd.ret_type, fd.type_params, cts), funcs.impls);
  // The bounded-only substitution above can leave an UNBOUNDED type
  // param in the return type — `sort_key[T, K: Ord](xs, key): T[]`
  // erases T from fd.type_params, so `T[]` survives with T unresolved,
  // and a caller (`let out = sort_key(strs, key)`) then can't recover
  // the element type for dispatch. Bind any residual var from the full
  // param unification and substitute.
  let rvars: string[] = type_str_vars(rt, []);
  if (rvars.len() > 0) {
    rt = resolve_residual_ret(fd, args, env, funcs, rt, rvars);
  }
  return rt;
}

// resolve_residual_ret substitutes the residual type VARS left in a call's
// return type by unifying the whole parameter list against the arguments.
// Shared by the two ways a var survives to the return: the PARTIALLY-erased
// generic (`sort_key[T, K: Ord]`, where the bounded-only substitution leaves T)
// and the FULLY-erased one (`pick2[T]`, where type_params is empty but the
// return type still names T). An unbindable var is left as itself, exactly as
// before.
function resolve_residual_ret(fd: FuncDecl, args: ast.Expr[], env: MEnv, funcs: MFns, rt0: string, rvars: string[]): string {
  let fb: MEnv = full_ret_binds(fd, args, env, funcs, rvars);
  let rcts: string[] = [];
  let vi: i32 = 0;
  while (vi < rvars.len()) {
    let bv: string = fb.elook(rvars[vi]);
    if (bv.len() == 0) {
      bv = rvars[vi];
    }
    rcts = rcts.append(bv);
    vi = vi + 1;
  }
  return subst_ty(rt0, rvars, rcts);
}

// assoc_ret_of returns the return type of the associated function (or method)
// `<tyname>.<method>` — a receiver-LESS impl method keyed by its receiver type,
// like a derived `default()`. Lets mono_infer type an associated call
// `Inner.default()` so a generic constructor body `Box { v: Inner.default() }`
// infers its instantiation key (Box[Inner]) from the field value.
function assoc_ret_of(funcs: FuncDecl[], tyname: string, method: string): string {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == method && funcs[i].receiver_type == tyname) {
      return funcs[i].ret_type;
    }
    i = i + 1;
  }
  return "";
}

// is_hex_lit reports whether an integer literal's spelling is a `0x` numeral.
pub function is_hex_lit(text: string): boolean {
  return text.len() > 2 && text[0] as i32 == 48
    && (text[1] as i32 == 120 || text[1] as i32 == 88);
}

// lower_hex_byte folds an ASCII hex digit to lower case; any other byte is
// returned unchanged. Equal-length hex numerals compare lexicographically the
// same as numerically, but only when both are written in the same case.
function lower_hex_byte(b: i32): i32 {
  if (b >= 65 && b <= 70) {
    return b + 32;
  }
  return b;
}

// magnitude_fits compares the literal's digits — from `start`, leading zeros
// skipped, hex letters lower-cased — against `max`, written in the same base.
// Equal-length numerals compare lexicographically the same as numerically, so
// the bound is a character compare. The checker shares this predicate when
// range-checking a literal against its contextual type.
pub function magnitude_fits(text: string, start: i32, max: string): boolean {
  let i: i32 = start;
  while (i < text.len() && text[i] as i32 == 48) {
    i = i + 1;
  }
  let n: i32 = text.len() - i;
  if (n != max.len()) {
    return n < max.len();
  }
  let k: i32 = 0;
  while (k < n) {
    let tc: i32 = lower_hex_byte(text[i + k] as i32);
    let mc: i32 = max[k] as i32;
    if (tc != mc) {
      return tc < mc;
    }
    k = k + 1;
  }
  return true;
}

// literal_is_i64 reports whether a non-negative integer literal text is too big
// for i32 (so it is an i64 value). Magnitude is measured against i32-max in the
// literal's OWN base — "7fffffff" for a `0x` numeral with the prefix stripped,
// "2147483647" for decimal — rather than by digit count, which read a wide hex
// literal like `0xFFFFFFFF` (10 characters) as fitting i32. Negative literals
// are unary minus over a positive literal. semsource reads the same rule through
// the module boundary (it imports parser), so the two sides stay in agreement.
pub function literal_is_i64(text: string): boolean {
  let hex: boolean = is_hex_lit(text);
  let start: i32 = 0;
  if (hex) {
    start = 2;
  }
  let m: string = "2147483647";
  if (hex) {
    m = "7fffffff";
  }
  return !magnitude_fits(text, start, m);
}

// Unsuffixed integer trees can take a contextual type without changing
// explicitly typed operands. Shared by the checker and unannotated IR drivers.
pub function int_literal_tree(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return !n.is_float && n.suffix.len() == 0 && !is_unit_literal(n);
    },
    ast.ExprUnary(u) => {
      if (u.op == "-" || u.op == "+") {
        return int_literal_tree(u.operand);
      }
      return false;
    },
    ast.ExprBinary(b) => {
      if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%"
        || b.op == "&" || b.op == "|" || b.op == "^" || b.op == "<<" || b.op == ">>"
        || b.op == "+|" || b.op == "-|" || b.op == "*|" || b.op == "<<|") {
        return int_literal_tree(b.left) && int_literal_tree(b.right);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// float_literal_tree: is `e` built from unsuffixed float literals only?
pub function float_literal_tree(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return n.is_float && n.suffix.len() == 0;
    },
    ast.ExprUnary(u) => {
      return (u.op == "-" || u.op == "+") && float_literal_tree(u.operand);
    },
    ast.ExprBinary(b) => {
      if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
        return float_literal_tree(b.left) && float_literal_tree(b.right);
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// number_literal_tree: an unsuffixed integer or float literal tree, whose type
// its destination or a concrete sibling settles.
pub function number_literal_tree(e: ast.Expr): boolean {
  return int_literal_tree(e) || float_literal_tree(e);
}

// Settle only a tree accepted by int_literal_tree. This is a compile-only
// copy: source formatting never reads the suffixes introduced here.
pub function settle_int_tree(e: ast.Expr, tag: string): ast.Expr {
  match (e) {
    ast.ExprNumber(n) => {
      return ast.ExprNumber { ...n, suffix: tag };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { ...u, operand: settle_int_tree(u.operand, tag), ty: tag };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { ...b, left: settle_int_tree(b.left, tag), right: settle_int_tree(b.right, tag), ty: tag };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// recv_method_ret_of is the declared return type of a receiver method call
// `recv.m(args)` whose receiver type the walk knows. A generic receiver's
// method returns its type variable, which names nothing concrete.
function recv_method_ret_of(cfa: ast.ExprFieldAccess, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  let rvt: string = mono_infer(cfa.obj, env, funcs);
  if (rvt.len() == 0) {
    return "";
  }
  let concrete: i32 = concrete_array_method_at(funcs, rvt, cfa.field);
  if (concrete >= 0) {
    let call_args: ast.Expr[] = [cfa.obj];
    for arg in args {
      call_args = call_args.append(arg);
    }
    return decl_call_ret_type(funcs, funcs.decls[concrete], call_args, env);
  }
  let mrt: string = assoc_ret_of(funcs.decls, rvt, cfa.field);
  if (mrt.len() == 0) {
    mrt = generic_recv_ret_of(funcs.decls, rvt, cfa.field);
  }
  if (looks_type_var(mrt)) {
    return "";
  }
  return mrt;
}

// The same return, for a receiver whose INSTANTIATION the declaration does not
// spell. `assoc_ret_of` compares the receiver spelling exactly, so a method
// declared `(a: NdArray[T]) transpose(): NdArray[T]` matches no `NdArray[i32]`
// receiver at all — and this pass runs before struct monomorphisation, so the
// concrete method does not exist yet either. Matching on the base and carrying
// the receiver's own arguments into the return is what a CHAINED call needs:
// `a.transpose()` is `NdArray[i32]`, and only that concrete form can key the
// `__smm_` fold a method with its own type params was hoisted into. Left as
// `NdArray[T]` the fold's key never resolved, the call kept a method spelling
// whose declaration had been dropped, and the module failed to build (#9927).
function generic_recv_ret_of(funcs: FuncDecl[], tyname: string, method: string): string {
  let recv: TypeRef = parse_type_ref(tyname);
  if (recv.args.len() == 0) {
    return "";
  }
  let base: string = util.base_type_name(tyname);
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == method && funcs[i].receiver_type.len() > 0
      && util.base_type_name(funcs[i].receiver_type) == base) {
      let ns: string[] = [];
      let ts: string[] = [];
      let (n2, t2) = ref_bind(parse_type_ref(funcs[i].receiver_type), recv, [], ns, ts);
      if (n2.len() == 0) {
        return "";
      }
      return subst_ty(funcs[i].ret_type, n2, t2);
    }
    i = i + 1;
  }
  return "";
}

// stamped_scalar reads the checker's tag off a call the walk could not type
// (docs/TYPED-IR-REWRITE.md), admitted only at a scalar or string, where the
// tag and the declared spelling coincide. Empty in an unannotated driver.
function stamped_scalar(tag: string): string {
  if (tag == "i32" || tag == "i64" || tag == "u8" || tag == "u32" || tag == "u64" || tag == "usize"
    || tag == "f32" || tag == "f64" || tag == "string" || tag == "boolean") {
    return tag;
  }
  return "";
}

// mono_infer computes a coarse type-name for an expression, enough to pick
// the right clone. Unknown shapes return "", leaving the call generic.
function mono_infer(e: ast.Expr, env: MEnv, funcs: MFns): string {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return "f64";
      }
      if (n.suffix.len() > 0) {
        return n.suffix;
      }
      // A bare integer literal whose value exceeds i32-max is unambiguously
      // an i64 value (the same magnitude rule infer_expr_width lowers it by),
      // so a generic instantiation binds `T = i64`, not i32 — otherwise
      // `some1(5000000000)` (an erased `some1[T](x: T): Option[T]`) would
      // clone `some1__i32` and truncate the wide value.
      if (literal_is_i64(n.text)) {
        return "i64";
      }
      return "i32";
    },
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprBool(_) => {
      return "boolean";
    },
    ast.ExprArray(a) => {
      // Array literal `[e0, …]`: the type is the element type
      // plus `[]`, so a `T[]` parameter can recover the element. An
      // unsuffixed numeric literal takes the type of a concrete numeric
      // sibling, as the checker joins it: `[2.0, nan32()]` is an f32[].
      if (a.elements.len() == 0) {
        return "";
      }
      let et: string = mono_infer(a.elements[0], env, funcs);
      if (et.len() == 0) {
        return "";
      }
      if (number_literal_tree(a.elements[0])) {
        for el in a.elements {
          if (!number_literal_tree(el)) {
            let st: string = mono_infer(el, env, funcs);
            if (is_scalar_ret_name(st) && st != "boolean") {
              return st + "[]";
            }
          }
        }
      }
      return et + "[]";
    },
    ast.ExprIdent(id) => {
      return env.elook(id.name);
    },
    ast.ExprSlice(sl) => {
      let source: string = mono_infer(sl.array, env, funcs);
      if (source == "string" || source == "str") {
        return "Option[str]";
      }
      let elem: string = array_method_element(source);
      if (elem.len() > 0) {
        return "[" + elem + "]";
      }
      return "";
    },
    ast.ExprLambda(lm) => {
      // A local bound to a lambda carries the lambda's declared shape, so a
      // generic taking it as a fn argument can still read its parameters —
      // `let keep = (x: f64): boolean => …; filter(it, keep)`. Without it the
      // local types to nothing and a promoted var reachable only through that
      // parameter never binds.
      let lps: string = "";
      let li: i32 = 0;
      while (li < lm.params.len()) {
        if (lm.params[li].type_name.len() == 0) {
          return "";
        }
        if (li > 0) {
          lps = lps + ", ";
        }
        lps = lps + lm.params[li].type_name;
        li = li + 1;
      }
      let lret: string = lambda_ret_of(e, env, funcs);
      if (lret.len() == 0) {
        return "";
      }
      return "(" + lps + ") => " + lret;
    },
    ast.ExprBinary(b) => {
      if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "&&" || b.op == "||") {
        return "boolean";
      }
      return mono_infer(b.left, env, funcs);
    },
    ast.ExprUnary(u) => {
      if (u.op == "!") {
        return "boolean";
      }
      // An `as <type>` cast (op "as_<type>") evaluates to its TARGET type,
      // not the operand's. Without this a `3 as i64` argument inferred the
      // operand's "i32", so a bounded-generic `assert_eq((x).min(y), 3 as
      // i64)` bound `T = i32` and the i64-valued clone failed to lower
      // (#3457: i64/u64 `.min`/`.max`/`.abs`/`.clamp` + i64 array reductions).
      if (is_cast_op(u.op)) {
        return slice_unchecked(u.op, 3, u.op.len()) + "";
      }
      return mono_infer(u.operand, env, funcs);
    },
    ast.ExprStructLit(sl) => {
      return struct_lit_spelling(sl, env, funcs);
    },
    ast.ExprTuple(tu) => {
      // A tuple literal `(e0, e1, …)` → `(T0, T1, …)`, so a `(K, V)[]`
      // parameter (via the ExprArray case) recovers its element vars
      // through bind_unify's tuple destructure. Any unknown element makes
      // the whole tuple unknown (return "") — the call then stays generic.
      let inner: string = "";
      let ti: i32 = 0;
      while (ti < tu.elements.len()) {
        let et: string = mono_infer(tu.elements[ti], env, funcs);
        if (et.len() == 0) {
          return "";
        }
        if (ti > 0) {
          inner = inner + ", ";
        }
        inner = inner + et;
        ti = ti + 1;
      }
      return "(" + inner + ")";
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (c.type_args.len() > 0) {
            let xbi: i32 = bg_find(funcs, cid.name);
            if (xbi >= 0) {
              let xkey: string = explicit_inst_key(funcs.decls[xbi], c.type_args);
              if (xkey.len() > 0) {
                return subst_ty(funcs.decls[xbi].ret_type, funcs.decls[xbi].type_params, key_parts(funcs.decls[xbi], xkey));
              }
            }
          }
          let crt: string = call_ret_type(funcs, cid.name, c.args, env);
          if (crt.len() == 0) {
            crt = func_ret_of(funcs.decls, cid.name);
          }
          // This builtin has no FuncDecl to read. Keep its declared
          // owned byte-array result for generic receiver selection.
          if (crt.len() == 0 && cid.name == "buf_take_bytes" && c.args.len() == 1) {
            return "u8[]";
          }
          // A bare type variable as the inferred call type — `A` from a
          // generic whose return type IS an UNBOUNDED type param
          // (`fold[T, A, I]: A`): `A` is erased from `type_params`, so
          // call_ret_type's subst never replaces it (and a fully
          // unbounded `gfold[T, A]: A` has empty `type_params`, so its
          // raw `A` ret_type is returned verbatim). That bare `A` then
          // flows into any bounded generic it's passed to
          // (`let s = iter.fold(..); assert_eq(s, 6)`), keying a
          // spurious clone `assert_eq__A` whose `A.eq` / `A.to_string`
          // can't resolve — bailing the module. A
          // bare type variable is never a usable concrete type, so
          // report "unknown" (the other, concrete-literal arg still
          // binds the call at `i32`).
          if (looks_type_var(crt) || crt.len() == 0) {
            return stamped_scalar(c.ty);
          }
          return crt;
        },
        ast.ExprFieldAccess(cfa) => {
          // A `.to_string()` / `.to_debug()` method call yields a string
          // regardless of the receiver type. Inferring it lets a bounded
          // generic call like `assert_eq(x.to_string(), y.to_string())`
          // bind its `T = string` from a computed (non-literal) argument
          // — without it, neither arg infers a type, the call stays the
          // uninstantiated template, and the whole module bails
          // (#3457: the std/u32 wrapping test's
          // `rotr_roundtrip` asserts two computed `.to_string()`s).
          if ((cfa.field == "to_string" || cfa.field == "to_debug") && c.args.len() == 0) {
            return "string";
          }
          // The builtin has no function declaration for return-type lookup.
          // Preserve its borrowed view when inferring a following method.
          if (cfa.field == "as_bytes" && c.args.len() == 0) {
            let source: string = mono_infer(cfa.obj, env, funcs);
            if (source == "string" || source == "str") {
              return "[u8]";
            }
          }
          // Generic array method `recv.m(args)` whose receiver is an
          // array — folded to `__arrm_m[T]` by
          // register_array_method_generics. Infer the receiver's element
          // type and substitute it into the method's return type, so a
          // CHAINED call (`a.concat(b).concat(c)`) recovers the inner
          // result type and the outer call rewrites onto the IR path too.
          let amgi: i32 = bg_find(funcs, "__arrm_" + cfa.field);
          let vmgi: i32 = bg_find(funcs, "__viewm_" + cfa.field);
          if (amgi >= 0 || vmgi >= 0) {
            let recvt: string = mono_infer(cfa.obj, env, funcs);
            if (spelling_is_view(recvt)) {
              amgi = vmgi;
            }
            let el: string = array_method_element(recvt);
            if (amgi >= 0 && el.len() > 0) {
              let amrt: string = subst_ty(funcs.decls[amgi].ret_type, funcs.decls[amgi].type_params, [el + ""]);
              // `type_params` carries only the BOUNDED receiver var, so a
              // method with an unbounded param of its own — `map[U]`,
              // whose return is `U[]` — leaves U residual and the
              // substitution above hands back a type VARIABLE spelled
              // like a type. A chained `reduce` then instantiates at `U`
              // and its match binding lowers as the wrong slot kind
              // (#9743). Same residual, and the same repair, as
              // call_ret_type's.
              let amvars: string[] = type_str_vars(amrt, []);
              if (amvars.len() > 0) {
                let amargs: ast.Expr[] = [cfa.obj];
                let amk: i32 = 0;
                while (amk < c.args.len()) {
                  amargs = amargs.append(c.args[amk]);
                  amk = amk + 1;
                }
                amrt = resolve_residual_ret(funcs.decls[amgi], amargs, env, funcs, amrt, amvars);
              }
              return amrt;
            }
          }
          let mmrt: string = mapm_ret_of(cfa, c.args, env, funcs);
          if (mmrt.len() > 0) {
            return mmrt;
          }
          // Generic-struct method with its own type params — folded to
          // `__smm_<Base>_m` by register_struct_method_generics. Infer
          // its result by instantiating the fold from the receiver +
          // arguments, so a CHAINED or unannotated call still types.
          let srt: string = "";
          if (smm_any(funcs, cfa.field)) {
            srt = mono_infer(cfa.obj, env, funcs);
          }
          if (first_bracket(srt) > 0 && slice_unchecked(srt, srt.len() - 1, srt.len()) == "]") {
            let sgi: i32 = bg_find(funcs, smm_name(strip_struct_base(srt), cfa.field));
            if (sgi >= 0) {
              let sargs: ast.Expr[] = [cfa.obj];
              let sk: i32 = 0;
              while (sk < c.args.len()) {
                sargs = sargs.append(c.args[sk]);
                sk = sk + 1;
              }
              let skey: string = infer_inst(funcs.decls[sgi], sargs, env, funcs);
              if (skey.len() > 0) {
                return subst_ty(funcs.decls[sgi].ret_type, funcs.decls[sgi].type_params, split_inst_key(skey));
              }
            }
          }
          let mrt: string = recv_method_ret_of(cfa, c.args, env, funcs);
          if (mrt.len() > 0) {
            return mrt;
          }
          // Associated call `Type.method()` (e.g. `Inner.default()`):
          // the object is a bare type name, so infer the method's
          // return type — lets a generic constructor body infer its
          // instantiation key from a defaulted field value.
          match (cfa.obj) {
            ast.ExprIdent(oid) => {
              let qrt: string = call_ret_type(funcs, oid.name + "." + cfa.field, c.args, env);
              if (qrt.len() > 0) {
                return qrt;
              }
              let art: string = assoc_ret_of(funcs.decls, oid.name, cfa.field);
              if (art.len() > 0) {
                return art;
              }
            },
            _ => {}
          }
          return stamped_scalar(c.ty);
        },
        ast.ExprLambda(lm) => {
          // Value blocks carry the checker's result, including view receivers.
          if (!mono_ty_mentions_var(lm.ret_type)) {
            return lm.ret_type;
          }
          return "";
        },
        _ => {
          return stamped_scalar(c.ty);
        }
      }
      return "";
    },
    ast.ExprIndex(ix) => {
      // `a[i]` on an array or view has its container's element type.
      // Without this arm mono_infer fell through to "" for an
      // array-element read, so a call like `f(a[i], a[j])` could not bind `f`'s
      // type parameter at all: the call stayed generic, the un-monomorphised
      // symbol survived to the IR eligibility gate, and the gate rejected the
      // CALLER as ineligible — a hard compile error since the AST emitters
      // were deleted (#6189).
      //
      // Read exactly one container layer, preserving nested views. String
      // indices and unknown containers stay unknown here instead of binding
      // a generic to a truncated type spelling.
      //
      // The element type is also rejected when it is itself a bare type
      // variable — indexing a `T[]` inside a generic yields `T`, which is not
      // a usable concrete type. Reporting it would key a clone named after the
      // variable (`assert_eq__T`), whose body then calls `T.eq`: an unknown
      // symbol, so the eligibility gate rejects the caller and the module
      // fails to compile. Same reasoning as the `looks_type_var(crt)` guard on
      // an inferred call return above.
      let at: string = mono_infer(ix.array, env, funcs);
      let el: string = array_method_element(at);
      if (el.len() > 0) {
        if (looks_type_var(el)) {
          return "";
        }
        return el;
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      // `s.f` on a struct value: the field's declared type, instantiated
      // from the value's type (`sp.lt` on `sp: Split[string, i32]` is
      // `Tree[string, i32]`). A field that still mentions a type variable
      // is unknown, for the same reason as the index arm's element guard.
      let ot: string = mono_infer(fa.obj, env, funcs);
      if (ot.len() == 0) {
        return "";
      }
      // A tuple index reads that element of a tuple-typed value
      // (#10683). Only the element read may not mention a type
      // variable: an erased, unbounded `S` beside it in
      // `(S, Result[i32, E])` is no reason to leave the call generic.
      if (util.is_all_digits(fa.field) && util.is_tuple_type_name(ot)) {
        let elems: string[] = split_top_commas(slice_unchecked(ot, 1, ot.len() - 1) + "");
        let k: i32 = util.digits_to_i32(fa.field);
        if (k >= elems.len() || mono_ty_mentions_var(elems[k])) {
          return "";
        }
        return elems[k];
      }
      if (mono_ty_mentions_var(ot)) {
        return "";
      }
      let ft: string = struct_field_ty_inst(ot, fa.field, funcs.structs, funcs.enums);
      if (mono_ty_mentions_var(ft)) {
        return "";
      }
      return ft;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// mono_expr rebuilds `e`, rewriting any call to a bounded generic into
// its mangled clone name and recording the instantiation.
function mono_expr(e: ast.Expr, env: MEnv, funcs: MFns, ins: Insts): RExpr {
  match (e) {
    ast.ExprBinary(b) => {
      let l: RExpr = mono_expr(b.left, env, funcs, ins);
      let r: RExpr = mono_expr(b.right, env, funcs, l.rins);
      return RExpr { rexpr: ast.ExprBinary { op: b.op, left: l.rexpr, right: r.rexpr, line: b.line, col: b.col, ty: b.ty }, rins: r.rins };
    },
    ast.ExprUnary(u) => {
      let o: RExpr = mono_expr(u.operand, env, funcs, ins);
      return RExpr { rexpr: ast.ExprUnary { op: u.op, operand: o.rexpr, line: u.line, col: u.col, ty: u.ty }, rins: o.rins };
    },
    ast.ExprCall(c) => {
      let (nargs, cur) = mono_call_args(c, env, funcs, ins);
      match (c.callee) {
        ast.ExprIdent(cid) => {
          let bi: i32 = bg_find(funcs, cid.name);
          if (bi >= 0) {
            let ct: string = explicit_inst_key(funcs.decls[bi], c.type_args);
            if (ct.len() == 0) {
              ct = infer_inst(funcs.decls[bi], c.args, env, funcs);
            }
            if (ct.len() > 0) {
              // The clone NAME must be symbol-safe: a key that is a
              // generic-struct instantiation (`iter__ArrayIter[i32]`,
              // from an Iterator-bounded reducer over `iter.of(xs)`)
              // carries brackets that GAS rejects in a label. Sanitise
              // the name (`[`/`,` -> `__`); keep the RAW key in the
              // worklist so clone_bg's body type-substitution and the
              // struct pass's mg_ty still see `iter__ArrayIter[i32]`.
              let mang: string = cid.name + "__" + sanitize_key(ct);
              cur = cur.iadd(cid.name, ct);
              return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: mang, line: cid.line, col: cid.col, ty: cid.ty }, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: cur };
            }
          }
        },
        ast.ExprFieldAccess(fac) => {
          // Module-qualified call `mod.f(args)`: the merged
          // module names the function `mod.f`. Match the
          // bounded-generic registry on that dotted name and
          // rewrite the field to the mangled clone suffix so
          // the emitter resolves `mod.f__<type>`.
          match (fac.obj) {
            ast.ExprIdent(modid) => {
              let qn: string = modid.name + "." + fac.field;
              let bi2: i32 = bg_find(funcs, qn);
              if (bi2 >= 0) {
                let ct2: string = explicit_inst_key(funcs.decls[bi2], c.type_args);
                if (ct2.len() == 0) {
                  ct2 = infer_inst(funcs.decls[bi2], c.args, env, funcs);
                }
                if (ct2.len() > 0) {
                  cur = cur.iadd(qn, ct2);
                  return RExpr { rexpr: ast.ExprCall { callee: ast.ExprFieldAccess { obj: fac.obj, field: fac.field + "__" + sanitize_key(ct2), line: fac.line, col: fac.col, ty: fac.ty }, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: cur };
                }
              }
            },
            _ => {}
          }
          // Fold concrete receivers before erasure can merge their namespaces.
          if (funcs.array_concrete.len() > 0) {
            let concrete: i32 = concrete_array_method_at(funcs, mono_infer(fac.obj, env, funcs), fac.field);
            if (concrete >= 0) {
              let receiver: RExpr = mono_expr(fac.obj, env, funcs, cur);
              let args: ast.Expr[] = [receiver.rexpr];
              for arg in nargs {
                args = args.append(arg);
              }
              let name: string = funcs.decls[concrete].name;
              let instances: Insts = receiver.rins;
              let bound: boolean = true;
              if (funcs.decls[concrete].type_params.len() > 0) {
                // Infer from the original arguments: a nested generic call
                // already rewritten in nargs names a clone outside decls.
                let raw: ast.Expr[] = [fac.obj];
                for arg in c.args {
                  raw = raw.append(arg);
                }
                let key: string = explicit_inst_key(funcs.decls[concrete], c.type_args);
                if (key.len() == 0) {
                  key = infer_inst(funcs.decls[concrete], raw, env, funcs);
                }
                if (key.len() > 0) {
                  instances = instances.iadd(name, key);
                  name = name + "__" + sanitize_key(key);
                } else {
                  // The bare template is dropped before lowering, so a call
                  // naming it would have no target: the call stays on its
                  // receiver for the dispatch to refuse by the written name.
                  bound = false;
                }
              }
              if (bound) {
                return RExpr { rexpr: ast.ExprCall { ...c, callee: ast.ExprIdent { name: name, line: fac.line, col: fac.col, ty: "" }, args: args }, rins: instances };
              }
            }
          }
          // Value-receiver generic array method `recv.m(args)` —
          // m was folded to a bounded free generic `__arrm_m[T]`
          // by register_array_method_generics. When recv is
          // array-typed, fold it into arg0 and emit a free call
          // the worklist instantiates to `__arrm_m__<elem>`.
          // Checked after the module-qualified case so a real
          // `mod.f(args)` still wins.
          let amn: string = "__arrm_" + fac.field;
          let amg: i32 = bg_find(funcs, amn);
          let vmg: i32 = bg_find(funcs, "__viewm_" + fac.field);
          if (amg >= 0 || vmg >= 0) {
            let rty: string = mono_infer(fac.obj, env, funcs);
            if (spelling_is_view(rty)) {
              amn = "__viewm_" + fac.field;
              amg = vmg;
            }
            if (amg >= 0 && array_method_element(rty).len() > 0) {
              let raw: ast.Expr[] = [fac.obj];
              let rk: i32 = 0;
              while (rk < c.args.len()) {
                raw = raw.append(c.args[rk]);
                rk = rk + 1;
              }
              let ct3: string = infer_folded_inst(funcs.decls[amg], raw, c.type_args, env, funcs);
              if (ct3.len() > 0) {
                let ro: RExpr = mono_expr(fac.obj, env, funcs, cur);
                cur = ro.rins;
                let folded: ast.Expr[] = [ro.rexpr];
                let fk: i32 = 0;
                while (fk < nargs.len()) {
                  folded = folded.append(nargs[fk]);
                  fk = fk + 1;
                }
                cur = cur.iadd(amn, ct3);
                return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: amn + "__" + sanitize_key(ct3), line: fac.line, col: fac.col, ty: "" }, args: folded, line: c.line, col: c.col, type_args: [], ty: c.ty }, rins: cur };
              }
            }
          }
          // Value-receiver generic MAP method `recv.verb(args)` — verb
          // was folded to `__mapm_verb[K, V]` by
          // register_map_method_generics. When recv is map-typed, fold
          // it into arg0 and emit a free call the worklist instantiates
          // to `__mapm_verb__<K>;<V>`. The Map sibling of the array arm
          // above; checked after it so a `T[]` receiver still wins.
          let mmn: string = "__mapm_" + fac.field;
          let mmg: i32 = bg_find(funcs, mmn);
          if (mmg >= 0) {
            let mrty: string = mono_infer(fac.obj, env, funcs);
            if (mrty.len() >= 4 && slice_unchecked(mrty, 0, 4) == "Map[") {
              let mraw: ast.Expr[] = [fac.obj];
              let mrk: i32 = 0;
              while (mrk < c.args.len()) {
                mraw = mraw.append(c.args[mrk]);
                mrk = mrk + 1;
              }
              let mct: string = infer_folded_inst(funcs.decls[mmg], mraw, c.type_args, env, funcs);
              if (mct.len() > 0) {
                let mro: RExpr = mono_expr(fac.obj, env, funcs, cur);
                cur = mro.rins;
                let mfolded: ast.Expr[] = [mro.rexpr];
                let mfk: i32 = 0;
                while (mfk < nargs.len()) {
                  mfolded = mfolded.append(nargs[mfk]);
                  mfk = mfk + 1;
                }
                cur = cur.iadd(mmn, mct);
                return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: mmn + "__" + sanitize_key(mct), line: fac.line, col: fac.col, ty: "" }, args: mfolded, line: c.line, col: c.col, type_args: [], ty: c.ty }, rins: cur };
              }
            }
          }
          // Generic-STRUCT method with its own type params `recv.m(args)`
          // — folded to `__smm_<Base>_m[<recv vars>, <own vars>]` by
          // register_struct_method_generics. The receiver pins the
          // struct's vars and the arguments pin the method's own, so
          // folding the receiver into arg0 gives the worklist a fully
          // concrete key. Struct mono runs AFTER this pass, so the
          // receiver still reads as the generic `Box[i32]` spelling here.
          let srty: string = "";
          if (smm_any(funcs, fac.field)) {
            srty = mono_infer(fac.obj, env, funcs);
          }
          if (first_bracket(srty) > 0 && slice_unchecked(srty, srty.len() - 1, srty.len()) == "]") {
            let smn: string = smm_name(strip_struct_base(srty), fac.field);
            let smg: i32 = bg_find(funcs, smn);
            if (smg >= 0) {
              let sraw: ast.Expr[] = [fac.obj];
              let srk: i32 = 0;
              while (srk < c.args.len()) {
                sraw = sraw.append(c.args[srk]);
                srk = srk + 1;
              }
              let sct: string = infer_folded_inst(funcs.decls[smg], sraw, c.type_args, env, funcs);
              if (sct.len() > 0) {
                let sro: RExpr = mono_expr(fac.obj, env, funcs, cur);
                cur = sro.rins;
                let sfolded: ast.Expr[] = [sro.rexpr];
                let sfk: i32 = 0;
                while (sfk < nargs.len()) {
                  sfolded = sfolded.append(nargs[sfk]);
                  sfk = sfk + 1;
                }
                cur = cur.iadd(smn, sct);
                return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: smn + "__" + sanitize_key(sct), line: fac.line, col: fac.col, ty: "" }, args: sfolded, line: c.line, col: c.col, type_args: [], ty: c.ty }, rins: cur };
              }
            }
          }
        },
        _ => {}
      }
      let rc: RExpr = mono_expr(c.callee, env, funcs, cur);
      return RExpr { rexpr: ast.ExprCall { callee: rc.rexpr, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: rc.rins };
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < a.elements.len()) {
        let re: RExpr = mono_expr(a.elements[i], env, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprArray { ...a, elements: els }, rins: cur };
    },
    ast.ExprTuple(t) => {
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < t.elements.len()) {
        let re: RExpr = mono_expr(t.elements[i], env, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprTuple { elements: els, line: t.line, col: t.col }, rins: cur };
    },
    ast.ExprIndex(ix) => {
      let ar: RExpr = mono_expr(ix.array, env, funcs, ins);
      let idx: RExpr = mono_expr(ix.index, env, funcs, ar.rins);
      // `ty` PROPAGATES where `unchecked` is dropped, and the asymmetry is
      // deliberate: dropping the bounds-elide mark is conservative (the
      // clone keeps its bounds check), but dropping the typed-IR tag is
      // NOT — the lowering then falls back to a structural walk
      // that misses exactly the shapes the tag exists to cover, and the
      // clone lowers an f64 element as a 4-byte i32 read. The tag stays
      // valid across cloning because annotation runs on the ERASED form,
      // so a bare type parameter stamps "" and only concrete tags survive
      // to be copied — the same reason subst_expr already carries it.
      return RExpr { rexpr: ast.ExprIndex { array: ar.rexpr, index: idx.rexpr, unchecked: false, ty: ix.ty, line: ix.line, col: ix.col }, rins: idx.rins };
    },
    ast.ExprSlice(sl) => {
      let ar: RExpr = mono_expr(sl.array, env, funcs, ins);
      let st: RExpr = mono_expr(sl.start, env, funcs, ar.rins);
      let en: RExpr = mono_expr(sl.end, env, funcs, st.rins);
      return RExpr { rexpr: ast.ExprSlice { ...sl, array: ar.rexpr, start: st.rexpr, end: en.rexpr }, rins: en.rins };
    },
    ast.ExprFieldAccess(fa) => {
      let o: RExpr = mono_expr(fa.obj, env, funcs, ins);
      return RExpr { rexpr: ast.ExprFieldAccess { obj: o.rexpr, field: fa.field, line: fa.line, col: fa.col, ty: fa.ty }, rins: o.rins };
    },
    ast.ExprStructLit(s) => {
      let vals: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < s.field_values.len()) {
        // Route the field value through the expected-type path with the
        // field's DECLARED type, the way a `let x: T = call()` binding and
        // a `return call()` already do. A generic call here whose args do
        // not pin T — `parser.Module { structs: util.append_all(
        // merged.structs, bmod.structs), … }` — otherwise stayed the
        // un-instantiated template and mangled to a name nothing defines
        // (#7773). The generic-ENUM walk (me_expr) has always passed
        // me_field_type_of here; this is the function-generic twin.
        let rv: RExpr = mono_call_expected(
          s.field_values[i],
          me_field_spelling_of(funcs.structs, s.type_name, s.field_names[i]), env, funcs, cur,
        );
        cur = rv.rins;
        vals = vals.append(rv.rexpr);
        i = i + 1;
      }
      let rb: RExpr = mono_expr(s.base, env, funcs, cur);
      return RExpr { rexpr: ast.ExprStructLit { type_name: s.type_name, field_names: s.field_names, field_values: vals, has_base: s.has_base, base: rb.rexpr, line: s.line, col: s.col, written: s.written }, rins: rb.rins };
    },
    ast.ExprLambda(lm) => {
      let bodyr: RStmts = mono_stmts(lm.body, bind_params(env, lm.params), funcs, ins, "");
      return RExpr { rexpr: ast.ExprLambda { ...lm, body: bodyr.rstmts }, rins: bodyr.rins3 };
    },
    _ => {
      return RExpr { rexpr: e, rins: ins };
    }
  }
  return RExpr { rexpr: e, rins: ins };
}

// mono_stmt rebuilds a statement, threading the inference env (only
// StmtVar extends it) and the instantiation accumulator.
// mono_call_expected rewrites an expression in a position with a known EXPECTED
// type (`expected`), applying return-type-directed instantiation when it is a
// bounded-generic call: `let b: Box[i32] = mk()` / `function two(): Box[i32] {
// return mk(); }` bind mk's type params from the `Box[i32]` expected type (via
// infer_inst_ret) so a no-argument constructor monomorphises instead of staying
// a template. (A return-only type param is now promoted, so the template is
// DROPPED — an unresolved call site would be an undefined reference, not merely
// a refused lowering, which is why every expected-type position must resolve it.)
// Falls through to plain mono_expr when there is no expected type, the callee
// isn't a bounded generic, or the instantiation still can't be resolved — a
// strict superset of mono_expr for this position.
function mono_call_expected(e: ast.Expr, expected: string, env: MEnv, funcs: MFns, ins: Insts): RExpr {
  if (generic_fn_value_name(e, env, funcs).len() > 0) {
    return mono_fn_value(e, expected, env, funcs, ins);
  }
  if (expected.len() > 0) {
    match (e) {
      ast.ExprCall(c) => {
        match (c.callee) {
          ast.ExprIdent(cid) => {
            let bi: i32 = bg_find(funcs, cid.name);
            if (bi >= 0) {
              let key: string = explicit_inst_key(funcs.decls[bi], c.type_args);
              if (key.len() == 0) {
                key = infer_inst_ret(funcs.decls[bi], c.args, expected, env, funcs);
              }
              if (key.len() > 0) {
                let (nargs, cur) = mono_call_args(c, env, funcs, ins);
                let mang: string = cid.name + "__" + sanitize_key(key);
                cur = cur.iadd(cid.name, key);
                return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: mang, line: cid.line, col: cid.col, ty: cid.ty }, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: cur };
              }
            }
          },
          ast.ExprFieldAccess(fac) => {
            // The MODULE-QUALIFIED twin, `mod.f(args)`. mono_expr's own
            // qualified arm infers from the ARGUMENTS alone, so a call
            // whose args do not pin T — `util.append_all(merged.structs,
            // bmod.structs)`, both field reads — stayed the generic
            // template there and mangled to a `util__append_all` no
            // instantiation defines. Without this arm the expected type
            // was never consulted for a qualified callee, so an
            // expected-type position could not resolve it either and the
            // module bailed on a dangling call (#7773).
            match (fac.obj) {
              ast.ExprIdent(modid) => {
                let qn: string = modid.name + "." + fac.field;
                let bq: i32 = bg_find(funcs, qn);
                if (bq >= 0) {
                  let qkey: string = explicit_inst_key(funcs.decls[bq], c.type_args);
                  if (qkey.len() == 0) {
                    qkey = infer_inst_ret(funcs.decls[bq], c.args, expected, env, funcs);
                  }
                  if (qkey.len() > 0) {
                    let (qargs, qcur) = mono_call_args(c, env, funcs, ins);
                    qcur = qcur.iadd(qn, qkey);
                    return RExpr { rexpr: ast.ExprCall { callee: ast.ExprFieldAccess { obj: fac.obj, field: fac.field + "__" + sanitize_key(qkey), line: fac.line, col: fac.col, ty: fac.ty }, args: qargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: qcur };
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
  return mono_expr(e, env, funcs, ins);
}

// mapm_ret_of infers a map method call's result type: the builtin snapshots
// `keys()` / `values()`, or a `__mapm_<verb>[K, V]` fold instantiated from the
// receiver and arguments the way mono_expr folds the call. "" when the
// receiver is not a map or the verb is neither, so a chained
// `m.keys().sum()` finds `.sum()`'s array receiver.
function mapm_ret_of(cfa: ast.ExprFieldAccess, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  let gi: i32 = bg_find(funcs, "__mapm_" + cfa.field);
  let snapshot: boolean = args.len() == 0 && (cfa.field == "keys" || cfa.field == "values");
  if (gi < 0 && !snapshot) {
    return "";
  }
  let rt: string = mono_infer(cfa.obj, env, funcs);
  if (rt.len() < 4 || slice_unchecked(rt, 0, 4) != "Map[") {
    return "";
  }
  if (gi < 0) {
    let kv: string[] = type_args_of(rt);
    if (kv.len() != 2) {
      return "";
    }
    if (cfa.field == "keys") {
      return kv[0] + "[]";
    }
    return kv[1] + "[]";
  }
  let all: ast.Expr[] = [cfa.obj];
  for a in args {
    all = all.append(a);
  }
  let key: string = infer_inst(funcs.decls[gi], all, env, funcs);
  if (key.len() == 0) {
    return "";
  }
  return subst_ty(funcs.decls[gi].ret_type, funcs.decls[gi].type_params, split_inst_key(key));
}

// mono_ty_mentions_var reports whether a type spelling contains a type
// variable ("T", "Option[T]", "T[]", "(T, i32)"). A payload carrying one is not
// a usable concrete type: binding it would key a clone named after the
// variable (`assert_eq__T`) whose trait calls can't resolve, bailing the module.
function mono_ty_mentions_var(t: string): boolean {
  let none: string[] = [];
  return type_str_vars(t, none).len() > 0;
}

// mono_variant_payload_ty: the type a match arm's payload binding carries when
// the scrutinee's inferred type `sty` is `Option[T]` / `Result[T, E]` — T for
// Some/Ok, E for Err. "" (unknown) for any other scrutinee or variant, and for
// a payload that still mentions a type variable. A qualified pattern
// (`Result.Ok`) is stripped to its bare variant name first.
function mono_variant_payload_ty(sty: string, vname: string, fns: MFns): string {
  if (mono_ty_mentions_var(sty)) {
    return "";
  }
  let bare: string = pat_variant_bare(vname);
  let n: i32 = sty.len();
  if (n >= 8 && slice_unchecked(sty, 0, 7) == "Option[" && sty[n - 1] == b']') {
    if (bare == "Some") {
      return strip_ws(slice_unchecked(sty, 7, n - 1) + "");
    }
    return "";
  }
  if (n >= 8 && slice_unchecked(sty, 0, 7) == "Result[" && sty[n - 1] == b']') {
    let parts: string[] = split_top_commas(slice_unchecked(sty, 7, n - 1) + "");
    if (parts.len() != 2) {
      return "";
    }
    if (bare == "Ok") {
      return strip_ws(parts[0]);
    }
    if (bare == "Err") {
      return strip_ws(parts[1]);
    }
  }
  return "";
}

// mono_arm_env: the env a match arm's body sees over a scrutinee of inferred
// type `sty`. An Option/Result scrutinee's Some/Ok payload carries T, Err
// carries E; a user enum's variant binds each payload from the variant's
// declared fields; any other payload binds unknown so it still SHADOWS an
// outer local of the same name.
function mono_arm_env(env: MEnv, pat: ast.Pattern, sty: string, funcs: MFns): MEnv {
  let aenv: MEnv = env;
  match (pat) {
    ast.PatVariant(pv) => {
      let ftys: string[] = mono_variant_field_tys(sty, pv.type_name, funcs);
      if (pv.binding.len() > 0 && pv.binding != "_") {
        let bty: string = mono_variant_payload_ty(sty, pv.type_name, funcs);
        if (bty.len() == 0 && ftys.len() > 0) {
          bty = ftys[0];
        }
        aenv = aenv.ebind(pv.binding, bty);
      }
      let xbi: i32 = 0;
      while (xbi < pv.extra_bindings.len()) {
        if (pv.extra_bindings[xbi].len() > 0 && pv.extra_bindings[xbi] != "_") {
          let xty: string = "";
          if (xbi + 1 < ftys.len()) {
            xty = ftys[xbi + 1];
          }
          aenv = aenv.ebind(pv.extra_bindings[xbi], xty);
        }
        xbi = xbi + 1;
      }
      if (pv.at_binding.len() > 0) {
        let aty: string = sty;
        if (mono_ty_mentions_var(aty)) {
          aty = "";
        }
        aenv = aenv.ebind(pv.at_binding, aty);
      }
    },
    _ => {}
  }
  return aenv;
}

// pat_variant_bare strips a qualified pattern name (`Result.Ok`, `m.Tree.Node`)
// to its bare variant name.
function pat_variant_bare(vname: string): string {
  let bare: string = vname;
  let di: i32 = 0;
  while (di < vname.len()) {
    if (vname[di] == b'.') {
      bare = slice_unchecked(vname, di + 1, vname.len()) + "";
    }
    di = di + 1;
  }
  return bare;
}

// type_args_of splits the top-level type arguments out of a `Base[a, b]`
// spelling (whitespace stripped); empty for a spelling with no brackets.
function type_args_of(ty: string): string[] {
  let out: string[] = [];
  let lb: i32 = first_bracket(ty);
  if (lb <= 0 || slice_unchecked(ty, ty.len() - 1, ty.len()) != "]") {
    return out;
  }
  let parts: string[] = split_top_commas(slice_unchecked(ty, lb + 1, ty.len() - 1));
  let i: i32 = 0;
  while (i < parts.len()) {
    out = out.append(strip_ws(parts[i]));
    i = i + 1;
  }
  return out;
}

// mono_variant_field_tys: the payload types, in declaration order, that a
// match arm's bindings carry when the scrutinee's inferred type `sty` names a
// user enum — a generic instantiation (`Tree[string, i32]` binds `Node(l, k,
// v, r, s)` as Tree[string, i32] / string / i32 / …) or a plain enum. Empty
// when the scrutinee is unknown, still mentions a type variable, or is not an
// enum that owns `vname`.
function mono_variant_field_tys(sty: string, vname: string, fns: MFns): string[] {
  let none: string[] = [];
  if (sty.len() == 0 || mono_ty_mentions_var(sty)) {
    return none;
  }
  let base: string = strip_struct_base(sty);
  let ei: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < fns.enums.len()) {
    if (fns.enums[i].name == base) {
      ei = i;
      i = fns.enums.len();
    } else {
      i = i + 1;
    }
  }
  if (ei < 0) {
    return none;
  }
  let ed: EnumDecl = fns.enums[ei];
  let cts: string[] = type_args_of(sty);
  if (cts.len() != ed.type_params.len()) {
    return none;
  }
  let vi: i32 = variant_struct_index(fns.structs, pat_variant_bare(vname), ed.name);
  if (vi < 0) {
    return none;
  }
  let fields: StructFieldDecl[] = fns.structs[vi].fields;
  let out: string[] = [];
  let fi: i32 = 0;
  while (fi < fields.len()) {
    out = out.append(subst_ty(fields[fi].type_name, ed.type_params, cts));
    fi = fi + 1;
  }
  return out;
}

// struct_field_ty_inst: the declared type of field `fname` on a value whose
// inferred type `ot` names a struct, with a generic struct's params
// substituted from the spelling (`Split[string, i32]`) or, once the struct
// pass has renamed the value, from its mangled clone name
// (`Split__string__i32`). "" when the struct or field is unknown.
function struct_field_ty_inst(ot: string, fname: string, structs: StructDecl[], enums: EnumDecl[]): string {
  let owner: InstStruct = inst_struct(ot, structs, enums);
  if (owner.at < 0) {
    return "";
  }
  for f in structs[owner.at].fields {
    if (f.name == fname) {
      return subst_ty(f.type_name, structs[owner.at].type_params, owner.cts);
    }
  }
  return "";
}

// The declaration an instantiated struct spelling names (`Box[i32]`, or the
// clone's `Box__i32`) and the types its parameters take there; `at` is -1
// when no declaration matches with that many arguments.
struct InstStruct { at: i32, cts: string[] }

function inst_struct(ot: string, structs: StructDecl[], enums: EnumDecl[]): InstStruct {
  let base: string = strip_struct_base(ot);
  let cts: string[] = type_args_of(ot);
  let si: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < structs.len() && si < 0) {
    if (structs[i].enum_owner.len() == 0) {
      if (structs[i].name == base) {
        si = i;
      } else if (structs[i].type_params.len() > 0 && first_bracket(ot) < 0) {
        let pfx: string = structs[i].name + "__";
        if (ot.len() > pfx.len() && util.str_has_prefix(ot, pfx)) {
          let rest: string = slice_unchecked(ot, pfx.len(), ot.len()) + "";
          cts = split_key(rest, structs[i].type_params.len(), structs, enums);
          si = i;
        }
      }
    }
    i = i + 1;
  }
  if (si < 0 || cts.len() != structs[si].type_params.len()) {
    return InstStruct { at: 0 - 1, cts: [] };
  }
  return InstStruct { at: si, cts: cts };
}

// menv_bind_destructure binds each binder of a comma-joined destructure spelling
// to the matching element of tuple type `ty` — nested groups `(b, c)` recurse
// into the element's own tuple type. A single name, or a shape mismatch, binds
// nothing beyond what the caller already did.
function menv_bind_destructure(env: MEnv, names: string, ty: string): MEnv {
  let parts: string[] = split_top_commas(names);
  if (parts.len() <= 1) {
    return env;
  }
  if (ty.len() < 2 || slice_unchecked(ty, 0, 1) != "(" || slice_unchecked(ty, ty.len() - 1, ty.len()) != ")") {
    return env;
  }
  let tys: string[] = split_top_commas(slice_unchecked(ty, 1, ty.len() - 1));
  if (tys.len() != parts.len()) {
    return env;
  }
  let e: MEnv = env;
  let i: i32 = 0;
  while (i < parts.len()) {
    let nm: string = strip_ws(parts[i]);
    let et: string = strip_ws(tys[i]);
    if (nm.len() > 1 && slice_unchecked(nm, 0, 1) == "(") {
      e = menv_bind_destructure(e, slice_unchecked(nm, 1, nm.len() - 1) + "", et);
    } else if (nm.len() > 0) {
      e = e.ebind(nm, et);
    }
    i = i + 1;
  }
  return e;
}

function mono_stmt(st: ast.Stmt, env: MEnv, funcs: MFns, ins: Insts, ret_ty: string): RStmtOne {
  match (st) {
    ast.StmtVar(v) => {
      let iv: RExpr = mono_call_expected(v.init, fn_tag_spelling(v.type_name, v.fn_ret, v.fn_param_types), env, funcs, ins);
      // A fn-typed local carries its shape, not the coarse tag: a generic
      // taking it as a fn argument reads its parameters from the env.
      let ty: string = fn_tag_spelling(v.type_name, v.fn_ret, v.fn_param_types);
      if (ty.len() == 0) {
        ty = mono_infer(v.init, env, funcs);
      }
      // A tuple destructure (`let (ns, na, nh) = f(…)`) carries its
      // binders comma-joined in the name; type each from the matching
      // element of the init's tuple type, so a later call taking one of
      // them (`map_stmts_acc(body, na, …)`) can still bind its instantiation.
      return RStmtOne { rstmt: ast.StmtVar { name: v.name, type_name: v.type_name, init: iv.rexpr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }, renv: menv_bind_destructure(env.ebind(v.name, ty), v.name, ty), rins2: iv.rins };
    },
    ast.StmtReturn(r) => {
      // A `return mk()` binds a bounded-generic constructor's type params
      // from the enclosing function's declared return type — the return-
      // position sibling of the StmtVar annotation above.
      let rv: RExpr = mono_call_expected(r.value, ret_ty, env, funcs, ins);
      return RStmtOne { rstmt: ast.StmtReturn { value: rv.rexpr, line: r.line, col: r.col }, renv: env, rins2: rv.rins };
    },
    ast.StmtExpr(x) => {
      let xv: RExpr = mono_expr(x.value, env, funcs, ins);
      return RStmtOne { rstmt: ast.StmtExpr { value: xv.rexpr, line: 0 }, renv: env, rins2: xv.rins };
    },
    ast.StmtAssign(a) => {
      let av: RExpr = mono_expr(a.value, env, funcs, ins);
      return RStmtOne { rstmt: ast.StmtAssign { target: a.target, value: av.rexpr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, renv: env, rins2: av.rins };
    },
    ast.StmtIf(f) => {
      let cv: RExpr = mono_expr(f.cond, env, funcs, ins);
      let tb: RStmts = mono_stmts(f.then_body, env, funcs, cv.rins, ret_ty);
      let eb: RStmts = mono_stmts(f.else_body, env, funcs, tb.rins3, ret_ty);
      return RStmtOne { rstmt: ast.StmtIf { cond: cv.rexpr, then_body: tb.rstmts, else_body: eb.rstmts, line: 0, else_chained: false, sugar: no_match_sugar(), origin: "" }, renv: env, rins2: eb.rins3 };
    },
    ast.StmtWhile(w) => {
      let cv: RExpr = mono_expr(w.cond, env, funcs, ins);
      let wb: RStmts = mono_stmts(w.body, env, funcs, cv.rins, ret_ty);
      return RStmtOne { rstmt: ast.StmtWhile { cond: cv.rexpr, body: wb.rstmts, label: w.label, line: w.line, is_loop: w.is_loop }, renv: env, rins2: wb.rins3 };
    },
    ast.StmtFor(fr) => {
      let it: RExpr = mono_expr(fr.iter, env, funcs, ins);
      // The loop var carries the array's element type; anything else
      // (a range, a map, an unknown) binds unknown, which still SHADOWS
      // an outer local of the same name.
      let ety: string = "";
      let ity: string = mono_infer(fr.iter, env, funcs);
      if (type_ends_arr(ity)) {
        ety = elem_spelling(ity);
        if (mono_ty_mentions_var(ety)) {
          ety = "";
        }
      }
      let benv: MEnv = env.ebind(fr.var_name, ety);
      let fb: RStmts = mono_stmts(fr.body, benv, funcs, it.rins, ret_ty);
      return RStmtOne { rstmt: ast.StmtFor { var_name: fr.var_name, iter: it.rexpr, body: fb.rstmts, label: fr.label, line: fr.line }, renv: env, rins2: fb.rins3 };
    },
    ast.StmtMatch(m) => {
      let sv: RExpr = mono_expr(m.scrutinee, env, funcs, ins);
      // The arm-body env binds the pattern's payload names: an
      // Option/Result scrutinee's Some/Ok payload carries T, Err
      // carries E; a user enum's variant binds each payload from the
      // variant's declared fields; any other payload binds unknown so
      // it still SHADOWS an outer local of the same name.
      let sty: string = mono_infer(m.scrutinee, env, funcs);
      let arms: ast.MatchArm[] = [];
      let cur: Insts = sv.rins;
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let ab: RStmts = mono_stmts(m.arms[i].body, mono_arm_env(env, m.arms[i].pattern, sty, funcs), funcs, cur, ret_ty);
        cur = ab.rins3;
        arms = arms.append(ast.MatchArm { pattern: m.arms[i].pattern, body: ab.rstmts, line: m.arms[i].line, col: m.arms[i].col, guard: m.arms[i].guard, has_guard: m.arms[i].has_guard, alt_cont: false });
        i = i + 1;
      }
      return RStmtOne { rstmt: ast.StmtMatch { ...m, scrutinee: sv.rexpr, arms: arms }, renv: env, rins2: cur };
    },
    _ => {
      return RStmtOne { rstmt: st, renv: env, rins2: ins };
    }
  }
  return RStmtOne { rstmt: st, renv: env, rins2: ins };
}

// mono_stmts walks a statement list, threading the (block-local) env. `ret_ty`
// is the enclosing function's declared return type, used by StmtReturn to bind
// a `return <generic constructor>()` from it; "" at top-level / in a lambda.
function mono_stmts(stmts: ast.Stmt[], env: MEnv, funcs: MFns, ins: Insts, ret_ty: string): RStmts {
  let out: ast.Stmt[] = [];
  let e2: MEnv = env;
  let cur: Insts = ins;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let rs: RStmtOne = mono_stmt(stmts[i], e2, funcs, cur, ret_ty);
    out = out.append(rs.rstmt);
    e2 = rs.renv;
    cur = rs.rins2;
    i = i + 1;
  }
  return RStmts { rstmts: out, rins3: cur };
}

// env_from_params seeds an MEnv with a function's parameter types. A fn-typed
// param coarsens to "fn", "fn[]" or "[fn]" with its signature held in the
// fn_ret / fn_param_types sidecars; the env holds the spelling rebuilt from
// them, so lambda_ret_of can bind a callee's return-position type var from a
// fn PARAM passed on (`map_values(f)` calling `__om_map_values(t, f)` with
// `f: (V) => W`), and an array of callables passed on binds the callee's
// variable the same way (`drive(start(entries))` with
// `entries: (() => T)[]`).
function env_from_params(params: ast.ParamDecl[]): MEnv {
  return bind_params(MEnv { mnames: [], mtypes: [] }, params);
}

// bind_params is env_from_params on top of an enclosing env: a lambda's
// parameters shadow what its body can otherwise see.
function bind_params(env: MEnv, params: ast.ParamDecl[]): MEnv {
  let e: MEnv = env;
  let i: i32 = 0;
  while (i < params.len()) {
    let pt: string = params[i].type_name;
    if (is_fn_contract_tag(pt) && params[i].fn_ret.len() > 0) {
      pt = fn_tag_spelling(pt, params[i].fn_ret, params[i].fn_param_types);
    }
    e = e.ebind(params[i].name, pt);
    i = i + 1;
  }
  return e;
}

// env_from_decl is env_from_params plus the RECEIVER a method reads by name.
// A body says `self.items.to_json()`, and with `self` unbound mono_infer
// answers "" for it, so mono_expr's `__arrm_` fold never fires and the call
// survives as an un-instantiated `T[].to_json`.
function env_from_decl(fd: FuncDecl): MEnv {
  let e: MEnv = env_from_params(fd.params);
  if (fd.receiver_name.len() == 0) {
    return e;
  }
  return e.ebind(fd.receiver_name, fd.receiver_type);
}

// subst_ty replaces every type variable in `tparams` with its concrete
// type from `cts` (same index), handling a bare variable (`T` → i32),
// the array form (`T[]` → i32[]), and a composite of any base
// (`Map[K, V]` → Map[i32, string]) by recursing into each top-level
// argument. Everything else passes through unchanged.
// subst_ty_list substitutes type arguments through a comma-separated list of
// type spellings — the shape ParamDecl.fn_param_types holds. Monomorphisation
// already substitutes `fn_ret`; without the same treatment here a clone of
// `apply[T](g: (T) => i32)` would keep `"T"` as its fn param type and the wasm
// funcref signature would fall back to i32 for a position the clone knows.
function subst_ty_list(list: string, tparams: string[], cts: string[]): string {
  if (list.len() == 0) {
    return "";
  }
  return subst_ty_join(split_top_commas(list), ",", tparams, cts);
}

function subst_ty_join(parts: string[], sep: string, tparams: string[], cts: string[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < parts.len()) {
    if (i > 0) {
      out = out + sep;
    }
    out = out + subst_ty(parts[i], tparams, cts);
    i = i + 1;
  }
  return out;
}

// subst_ty_each is subst_ty over a list of spellings — the type arguments a
// call writes, which a clone substitutes like its annotations.
function subst_ty_each(tys: string[], tparams: string[], cts: string[]): string[] {
  let out: string[] = [];
  for t in tys {
    out = out.append(subst_ty(t, tparams, cts));
  }
  return out;
}

pub function subst_ty(name: string, tparams: string[], cts: string[]): string {
  let k: i32 = tp_index(name, tparams);
  if (k >= 0) {
    return cts[k];
  }
  // A function type's parameter list spells a consuming slot `own T`, and
  // the variable sits behind the mode.
  if (name.len() > 4 && slice_unchecked(name, 0, 4) == "own ") {
    return "own " + subst_ty(slice_unchecked(name, 4, name.len()) + "", tparams, cts);
  }
  if (spelling_is_view(name)) {
    return "[" + subst_ty(slice_unchecked(name, 1, name.len() - 1) + "", tparams, cts) + "]";
  }
  if (type_ends_arr(name)) {
    return subst_ty(slice_unchecked(name, 0, name.len() - 2), tparams, cts) + "[]";
  }
  // A callable `(P, Q) => R` substitutes through its parameters and result;
  // the tuple arm below would read it as a malformed tuple. A spelling that
  // substitutes to itself is handed back verbatim.
  if (name.len() > 0 && name[0] == b'(' && util.contains(name, "=>")) {
    let fref: TypeRef = parse_type_ref(name);
    if (fref.is_fn) {
      let parts: string[] = [];
      let changed: boolean = false;
      for a in fref.args {
        let sp: string = render_type_ref(a);
        let sub: string = subst_ty(sp, tparams, cts);
        if (sub != sp) {
          changed = true;
        }
        parts = parts.append(sub);
      }
      if (!changed) {
        return name;
      }
      let out: string = "(";
      let i: i32 = 0;
      while (i + 1 < parts.len()) {
        if (i > 0) {
          out = out + ", ";
        }
        out = out + parts[i];
        i = i + 1;
      }
      return out + ") => " + parts[parts.len() - 1];
    }
  }
  if (util.is_tuple_type_name(name) && slice_unchecked(name, name.len() - 1, name.len()) == ")") {
    return "(" + subst_ty_join(split_top_commas(slice_unchecked(name, 1, name.len() - 1)), ", ", tparams, cts) + ")";
  }
  let lb: i32 = first_bracket(name);
  if (lb > 0 && slice_unchecked(name, name.len() - 1, name.len()) == "]") {
    return slice_unchecked(name, 0, lb) + "[" + subst_ty_join(split_top_commas(slice_unchecked(name, lb + 1, name.len() - 1)), ", ", tparams, cts) + "]";
  }
  // A projection `Base::Name` substitutes through its base: `H::Item` at
  // H = SBox is `SBox::Item`, which resolve_proj_in_type can then resolve.
  let ps: i32 = name.len() - 1;
  while (ps > 0 && ident_byte(name[ps] as i32)) {
    ps = ps - 1;
  }
  if (ps > 1 && ps < name.len() - 1 && name[ps] == b':' && name[ps - 1] == b':') {
    return subst_ty(slice_unchecked(name, 0, ps - 1) + "", tparams, cts) + slice_unchecked(name, ps - 1, name.len());
  }
  return name;
}

// subst_expr substitutes a type-parameter NAME used as a value-level
// identifier with its concrete type. The only place a type parameter `T`
// appears as an expression is the OBJECT of an associated call — `T.default()`
// in a monomorphised generic body — so substituting any matching ExprIdent
// rewrites it to `Concrete.default()`, which then resolves like any associated
// call (issue #2779 item 3). Struct-literal TYPE names are left alone (the
// struct-literal monomorphiser, ms_expr, mangles `Box` → `Box__C`).
//
// Every COMPOSITE shape recurses. The list used to stop at ExprIndex, so a
// `T.zero()` inside an array literal, a tuple, a slice or a lambda kept the
// type-parameter name into the clone and the module fell off the IR path
// ("function value T not defined"). It cannot reuse astwalk.map_expr, which
// exists for exactly this: astwalk imports parser, so the dependency would
// cycle. Only ExprMapLit / ExprFString stay out, and only because Par.verbatim
// builds them for `-fmt` alone — the compile path never sees one.
function subst_expr(e: ast.Expr, tparams: string[], cts: string[]): ast.Expr {
  match (e) {
    ast.ExprIdent(id) => {
      let k: i32 = tp_index(id.name, tparams);
      if (k >= 0) {
        return ast.ExprIdent { name: cts[k], line: id.line, col: id.col, ty: id.ty };
      }
      return e;
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { obj: subst_expr(fa.obj, tparams, cts), field: fa.field, line: fa.line, col: fa.col, ty: fa.ty };
    },
    ast.ExprCall(c) => {
      // A defaulted generic field `T.default()` where `T` substitutes to a
      // PRIMITIVE has no associated impl to dispatch to in the IR path —
      // emit the primitive's zero literal directly (i32→0, string→"",
      // boolean→false, f64→0.0), exactly as the concrete struct-default
      // path does for a scalar field. This lets a generic `@derive(Default)`
      // over a primitive (`Box[i32].default()`) lower through the IR path
      // (the native compiler resolves the same `T.default()` via the
      // primitive `Default` impl — see #2864).
      match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
          match (cfa.obj) {
            ast.ExprIdent(oid) => {
              if (c.args.len() == 0) {
                let pk: i32 = tp_index(oid.name, tparams);
                if (pk >= 0) {
                  // T.default() on a primitive → the primitive's zero
                  // literal (see above).
                  if (cfa.field == "default" && dv_is_scalar(cts[pk])) {
                    return dv_default_expr(cts[pk]);
                  }
                  // T.zero() / T.one() (std/num's additive / multiplicative
                  // identities) on a NUMERIC primitive have no associated
                  // impl to dispatch to in the IR path either — emit the
                  // identity literal directly (i32→0/1, f64→0.0/1.0),
                  // exactly as the `default` case does, so a generic
                  // reducer `sum[T: Add + Zero](xs): T { let acc = T.zero(); … }`
                  // lowers through the IR path instead of bailing to the AST
                  // emitter (the native compiler resolves the same call via
                  // the primitive Zero / One impl).
                  if (cfa.field == "zero" && dv_is_num_scalar(cts[pk])) {
                    return dv_num_identity_expr(cts[pk], false);
                  }
                  if (cfa.field == "one" && dv_is_num_scalar(cts[pk])) {
                    return dv_num_identity_expr(cts[pk], true);
                  }
                }
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
      let na: ast.Expr[] = [];
      let ci: i32 = 0;
      while (ci < c.args.len()) {
        na = na.append(subst_expr(c.args[ci], tparams, cts));
        ci = ci + 1;
      }
      return ast.ExprCall { callee: subst_expr(c.callee, tparams, cts), args: na, line: c.line, col: c.col, type_args: subst_ty_each(c.type_args, tparams, cts), ty: c.ty };
    },
    ast.ExprStructLit(sl) => {
      let nv: ast.Expr[] = [];
      let si: i32 = 0;
      while (si < sl.field_values.len()) {
        nv = nv.append(subst_expr(sl.field_values[si], tparams, cts));
        si = si + 1;
      }
      let nb: ast.Expr = sl.base;
      if (sl.has_base) {
        nb = subst_expr(sl.base, tparams, cts);
      }
      return ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nb, line: sl.line, col: sl.col, written: subst_ty(sl.written, tparams, cts) };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: subst_expr(b.left, tparams, cts), right: subst_expr(b.right, tparams, cts), line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: subst_expr(u.operand, tparams, cts), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { array: subst_expr(ix.array, tparams, cts), index: subst_expr(ix.index, tparams, cts), unchecked: ix.unchecked, ty: ix.ty, line: ix.line, col: ix.col };
    },
    ast.ExprSlice(sl2) => {
      return ast.ExprSlice { ...sl2, array: subst_expr(sl2.array, tparams, cts), start: subst_expr(sl2.start, tparams, cts), end: subst_expr(sl2.end, tparams, cts) };
    },
    ast.ExprArray(ar) => {
      let ne: ast.Expr[] = [];
      let ai: i32 = 0;
      while (ai < ar.elements.len()) {
        ne = ne.append(subst_expr(ar.elements[ai], tparams, cts));
        ai = ai + 1;
      }
      return ast.ExprArray { ...ar, elements: ne };
    },
    ast.ExprTuple(tp) => {
      let nt: ast.Expr[] = [];
      let ti: i32 = 0;
      while (ti < tp.elements.len()) {
        nt = nt.append(subst_expr(tp.elements[ti], tparams, cts));
        ti = ti + 1;
      }
      return ast.ExprTuple { ...tp, elements: nt };
    },
    ast.ExprLambda(lm) => {
      // A lambda's own parameter and return annotations name the type var too
      // (`(s: ast.Stmt, a: T) => a`): left as `T`, its lifted body would have
      // an untyped `a` and return it without the array retain a typed
      // parameter gets, so the clone's caller would release a count that was
      // never added.
      let lps: ast.ParamDecl[] = [];
      for lpd in lm.params {
        lps = lps.append(ast.ParamDecl { ...lpd, type_name: subst_ty(lpd.type_name, tparams, cts), fn_ret: subst_ty(lpd.fn_ret, tparams, cts), fn_param_types: subst_ty_list(lpd.fn_param_types, tparams, cts) });
      }
      // Capture types were checked in the generic declaration's scope.
      // The clone must resolve them again against its substituted bindings.
      return ast.ExprLambda { ...lm, params: lps, ret_type: subst_ty(lm.ret_type, tparams, cts), ret_fn_ret: subst_ty(lm.ret_fn_ret, tparams, cts), ret_fn_param_types: subst_ty_list(lm.ret_fn_param_types, tparams, cts), body: subst_stmts(lm.body, tparams, cts), captures: [], captures_known: false };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// subst_stmts rewrites `let x: T` type annotations to the concrete type in a
// cloned generic body, AND substitutes type-parameter names appearing as
// expression objects (`T.default()` → `Concrete.default()`, via subst_expr).
function subst_stmts(stmts: ast.Stmt[], tparams: string[], cts: string[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    let st: ast.Stmt = stmts[i];
    match (st) {
      ast.StmtVar(v) => {
        out = out.append(ast.StmtVar { name: v.name, type_name: subst_ty(v.type_name, tparams, cts), init: subst_expr(v.init, tparams, cts), line: v.line, col: v.col, fn_ret: subst_ty(v.fn_ret, tparams, cts), fn_param_types: subst_ty_list(v.fn_param_types, tparams, cts) });
      },
      ast.StmtReturn(r) => {
        out = out.append(ast.StmtReturn { value: subst_expr(r.value, tparams, cts), line: r.line, col: r.col });
      },
      ast.StmtExpr(x) => {
        out = out.append(ast.StmtExpr { value: subst_expr(x.value, tparams, cts), line: x.line });
      },
      ast.StmtAssign(a) => {
        out = out.append(ast.StmtAssign { target: a.target, value: subst_expr(a.value, tparams, cts), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col });
      },
      ast.StmtIf(f) => {
        out = out.append(ast.StmtIf { ...f, cond: subst_expr(f.cond, tparams, cts), then_body: subst_stmts(f.then_body, tparams, cts), else_body: subst_stmts(f.else_body, tparams, cts) });
      },
      ast.StmtWhile(w) => {
        out = out.append(ast.StmtWhile { cond: subst_expr(w.cond, tparams, cts), body: subst_stmts(w.body, tparams, cts), label: w.label, line: w.line, is_loop: w.is_loop });
      },
      ast.StmtFor(fr) => {
        out = out.append(ast.StmtFor { var_name: fr.var_name, iter: subst_expr(fr.iter, tparams, cts), body: subst_stmts(fr.body, tparams, cts), label: fr.label, line: fr.line });
      },
      ast.StmtMatch(m) => {
        let arms: ast.MatchArm[] = [];
        let j: i32 = 0;
        while (j < m.arms.len()) {
          arms = arms.append(ast.MatchArm { pattern: m.arms[j].pattern, body: subst_stmts(m.arms[j].body, tparams, cts), line: m.arms[j].line, col: m.arms[j].col, guard: subst_expr(m.arms[j].guard, tparams, cts), has_guard: m.arms[j].has_guard, alt_cont: false });
          j = j + 1;
        }
        out = out.append(ast.StmtMatch { ...m, scrutinee: subst_expr(m.scrutinee, tparams, cts), arms: arms });
      },
      ast.StmtDefer(d) => {
        out = out.append(ast.StmtDefer { ...d, action: subst_stmts([d.action], tparams, cts)[0] });
      },
      _ => {
        out = out.append(st);
      }
    }
    i = i + 1;
  }
  return out;
}

// retarget_self_lit_expr rewrites every bare-base struct literal `base { .. }`
// in a cloned struct-method body to the concrete clone name `mang`. A struct's
// own method that constructs its struct WITHOUT explicit type arguments (the
// `next` of an `impl[T] Iterator[T] for ArrayIter[T]`: `return Some((v,
// ArrayIter { xs: self.xs, idx: .. }))`) is building the SAME instantiation as
// the receiver — `Self` in value position. ms_expr can't infer that key
// (mono_infer has no field-access / struct typing for `self.xs`), so resolve it
// structurally here, mirroring the `Self`-in-types resolution that
// to_concrete_struct_ty does for the return / param types. Nested values are
// walked so a struct literal inside a tuple / call / array is retargeted too.
function retarget_self_lit_expr(e: ast.Expr, base: string, mang: string): ast.Expr {
  match (e) {
    ast.ExprStructLit(sl) => {
      let nv: ast.Expr[] = [];
      let si: i32 = 0;
      while (si < sl.field_values.len()) {
        nv = nv.append(retarget_self_lit_expr(sl.field_values[si], base, mang));
        si = si + 1;
      }
      let nb: ast.Expr = sl.base;
      if (sl.has_base) {
        nb = retarget_self_lit_expr(sl.base, base, mang);
      }
      let tn: string = sl.type_name;
      if (tn == base) {
        tn = mang;
      }
      return ast.ExprStructLit { type_name: tn, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nb, line: sl.line, col: sl.col, written: sl.written };
    },
    ast.ExprCall(c) => {
      let na: ast.Expr[] = [];
      let ci: i32 = 0;
      while (ci < c.args.len()) {
        na = na.append(retarget_self_lit_expr(c.args[ci], base, mang));
        ci = ci + 1;
      }
      return ast.ExprCall { callee: retarget_self_lit_expr(c.callee, base, mang), args: na, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprTuple(t) => {
      let ne: ast.Expr[] = [];
      let ti: i32 = 0;
      while (ti < t.elements.len()) {
        ne = ne.append(retarget_self_lit_expr(t.elements[ti], base, mang));
        ti = ti + 1;
      }
      return ast.ExprTuple { elements: ne, line: t.line, col: t.col };
    },
    ast.ExprArray(a) => {
      let ne2: ast.Expr[] = [];
      let ai: i32 = 0;
      while (ai < a.elements.len()) {
        ne2 = ne2.append(retarget_self_lit_expr(a.elements[ai], base, mang));
        ai = ai + 1;
      }
      return ast.ExprArray { ...a, elements: ne2 };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: retarget_self_lit_expr(b.left, base, mang), right: retarget_self_lit_expr(b.right, base, mang), line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: retarget_self_lit_expr(u.operand, base, mang), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { array: retarget_self_lit_expr(ix.array, base, mang), index: retarget_self_lit_expr(ix.index, base, mang), unchecked: ix.unchecked, ty: ix.ty, line: ix.line, col: ix.col };
    },
    ast.ExprSlice(sl2) => {
      return ast.ExprSlice { ...sl2, array: retarget_self_lit_expr(sl2.array, base, mang), start: retarget_self_lit_expr(sl2.start, base, mang), end: retarget_self_lit_expr(sl2.end, base, mang) };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { obj: retarget_self_lit_expr(fa.obj, base, mang), field: fa.field, line: fa.line, col: fa.col, ty: fa.ty };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// retarget_self_lit_stmts walks a cloned struct-method body, applying
// retarget_self_lit_expr to every contained expression.
function retarget_self_lit_stmts(stmts: ast.Stmt[], base: string, mang: string): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    let st: ast.Stmt = stmts[i];
    match (st) {
      ast.StmtVar(v) => {
        out = out.append(ast.StmtVar { name: v.name, type_name: v.type_name, init: retarget_self_lit_expr(v.init, base, mang), line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types });
      },
      ast.StmtReturn(r) => {
        out = out.append(ast.StmtReturn { value: retarget_self_lit_expr(r.value, base, mang), line: r.line, col: r.col });
      },
      ast.StmtExpr(x) => {
        out = out.append(ast.StmtExpr { value: retarget_self_lit_expr(x.value, base, mang), line: x.line });
      },
      ast.StmtAssign(a) => {
        out = out.append(ast.StmtAssign { target: a.target, value: retarget_self_lit_expr(a.value, base, mang), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col });
      },
      ast.StmtIf(f) => {
        out = out.append(ast.StmtIf { ...f, cond: retarget_self_lit_expr(f.cond, base, mang), then_body: retarget_self_lit_stmts(f.then_body, base, mang), else_body: retarget_self_lit_stmts(f.else_body, base, mang) });
      },
      ast.StmtWhile(w) => {
        out = out.append(ast.StmtWhile { cond: retarget_self_lit_expr(w.cond, base, mang), body: retarget_self_lit_stmts(w.body, base, mang), label: w.label, line: w.line, is_loop: w.is_loop });
      },
      ast.StmtFor(fr) => {
        out = out.append(ast.StmtFor { var_name: fr.var_name, iter: retarget_self_lit_expr(fr.iter, base, mang), body: retarget_self_lit_stmts(fr.body, base, mang), label: fr.label, line: fr.line });
      },
      ast.StmtMatch(m) => {
        let arms: ast.MatchArm[] = [];
        let j: i32 = 0;
        while (j < m.arms.len()) {
          arms = arms.append(ast.MatchArm { pattern: m.arms[j].pattern, body: retarget_self_lit_stmts(m.arms[j].body, base, mang), line: m.arms[j].line, col: m.arms[j].col, guard: retarget_self_lit_expr(m.arms[j].guard, base, mang), has_guard: m.arms[j].has_guard, alt_cont: false });
          j = j + 1;
        }
        out = out.append(ast.StmtMatch { ...m, scrutinee: retarget_self_lit_expr(m.scrutinee, base, mang), arms: arms });
      },
      _ => {
        out = out.append(st);
      }
    }
    i = i + 1;
  }
  return out;
}

// bound_substitutions extends the instantiation (tparams -> cts) with the type
// variables a BOUND pins. For each bounded parameter already bound to a
// concrete type, the impl of the bound's trait for that type gives the trait's
// own arguments, and those line up with what the bound wrote at each position.
// A parametric impl (`impl[T] Iterator[T] for ArrayIter[T]`) writes them in its
// own parameters, so its `for` type is matched against the concrete one first.
function bound_substitutions(fd: FuncDecl, tparams: string[], cts: string[], impls: ImplInfo[]): (string[], string[]) {
  let ns: string[] = tparams;
  let ts: string[] = cts;
  let k: i32 = 0;
  while (k < tparams.len() && k < fd.bound_traits.len() && k < cts.len()) {
    for entry in split_plus_bounds(fd.bound_traits[k]) {
      let (n2, t2) = bound_entry_substitutions(entry, cts[k], impls, ns, ts);
      ns = n2;
      ts = t2;
    }
    k = k + 1;
  }
  return (ns, ts);
}

// One bound entry (`Iterator[T]`) against the concrete type its parameter took.
function bound_entry_substitutions(entry: string, concrete: string, impls: ImplInfo[], names: string[], types: string[]): (string[], string[]) {
  let bref: TypeRef = parse_type_ref(entry);
  if (bref.args.len() == 0) {
    return (names, types);
  }
  let tr_name: string = util.base_type_name(entry);
  let cref: TypeRef = parse_type_ref(concrete);
  for im in impls {
    if (im.trait_name != tr_name) {
      continue;
    }
    if (util.base_type_name(im.impl_type) != util.base_type_name(concrete)) {
      continue;
    }
    let iref: TypeRef = parse_type_ref(im.trait_ref);
    if (iref.args.len() != bref.args.len()) {
      continue;
    }
    // The impl's own parameters, read off its `for` type.
    let pn: string[] = [];
    let pt: string[] = [];
    let (pn2, pt2) = ref_bind(parse_type_ref(im.impl_type), cref, im.all_type_params, pn, pt);
    let ns: string[] = names;
    let ts: string[] = types;
    let j: i32 = 0;
    while (j < bref.args.len()) {
      let got: string = subst_ty(render_type_ref(iref.args[j]), pn2, pt2);
      let (n3, t3) = ref_bind(bref.args[j], parse_type_ref(got), [], ns, ts);
      ns = n3;
      ts = t3;
      j = j + 1;
    }
    return (ns, ts);
  }
  return (names, types);
}

// ref_bind matches a type-variable PATTERN against a concrete spelling,
// recording each variable the pattern's leaves name. A leaf binds when it is
// one of `vars`, or — for a function's own erased parameters, which no list
// records — when it spells like one. A shape that does not line up contributes
// nothing; first binding wins, so an outer round is never overwritten.
function ref_bind(pattern: TypeRef, actual: TypeRef, vars: string[], names: string[], types: string[]): (string[], string[]) {
  let ns: string[] = names;
  let ts: string[] = types;
  if (pattern.array_depth > 0) {
    if (actual.array_depth != pattern.array_depth) {
      return (ns, ts);
    }
    return ref_bind(elem_type_ref(pattern), elem_type_ref(actual), vars, ns, ts);
  }
  if (pattern.args.len() == 0) {
    let leaf: string = pattern.base;
    let binds: boolean = util.index_of_str(vars, leaf) >= 0;
    if (vars.len() == 0) {
      binds = looks_type_var(leaf);
    }
    if (binds && tp_index(leaf, ns) < 0) {
      ns = ns.append(leaf);
      ts = ts.append(render_type_ref(actual));
    }
    return (ns, ts);
  }
  if (pattern.base != actual.base || pattern.args.len() != actual.args.len()) {
    return (ns, ts);
  }
  let i: i32 = 0;
  while (i < pattern.args.len()) {
    let (n2, t2) = ref_bind(pattern.args[i], actual.args[i], vars, ns, ts);
    ns = n2;
    ts = t2;
    i = i + 1;
  }
  return (ns, ts);
}

// split_plus_bounds splits a `+`-joined bound spelling into its entries, each
// AS WRITTEN — `Iterator[T] + Clone` gives both, type arguments intact.
pub function split_plus_bounds(bound: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i <= bound.len()) {
    if (i == bound.len() || bound[i] == b'+') {
      if (i > start) {
        out = out.append(slice_unchecked(bound, start, i) + "");
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

// clone_bg builds the `f__<key>` clone of bounded-generic func `fd`,
// substituting each type variable with its concrete type (the `__`-
// joined `key`, split back into per-parameter pieces) across params +
// return + body annotations. A projection through a type parameter
// (`H::Item`) names a concrete base only once substituted, so the
// signature's projections resolve here rather than at parse time.
function clone_bg(fd: FuncDecl, key: string, impls: ImplInfo[]): FuncDecl {
  let tparams: string[] = fd.type_params;
  // A single type parameter's key IS the one concrete type, verbatim —
  // never split it. A multi-param key is joined by infer_inst with ';'
  // (split_inst_key), so a per-param module-mangled value (`iter__ArrayIter[i32]`,
  // from an Iterator-bounded reducer `sum_iter[T: Add, I: Iterator[T]]` over
  // `iter.of(xs)`) keeps its embedded '__' intact — split_dunder would have
  // split it into the wrong arity and bound `I` to the bogus "iter".
  let cts: string[] = [key];
  if (tparams.len() != 1) {
    cts = split_inst_key(key);
  }
  // A type variable that no PARAMETER spells — the T of
  // `nth[T, I: Iterator[T]](it: I, n: i32): Option[T]`, which lives only in
  // the bound and the return — is absent from the key, because the key is
  // what the arguments pinned. What says what it is, is the IMPL the bound
  // resolved to: `impl Iterator[i32] for Range` reads T off position 0.
  // Without it the clone keeps a `T` naming nothing, so its return resolves
  // to `Option[unknown]` and every reader downstream is left guessing.
  let (btp, bct) = bound_substitutions(fd, tparams, cts, impls);
  return instantiate_func(fd, fd.name + "__" + sanitize_key(key), btp, bct, impls);
}

// instantiate_func is `fd` renamed to `name` with each of `tparams` replaced by
// the matching spelling in `cts` across params, return and body annotations.
pub function instantiate_func(fd: FuncDecl, name: string, tparams: string[], cts: string[], impls: ImplInfo[]): FuncDecl {
  let nparams: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < fd.params.len()) {
    nparams = nparams.append(ast.ParamDecl { name: fd.params[i].name, type_name: resolve_proj_in_type(subst_ty(fd.params[i].type_name, tparams, cts), impls), own: fd.params[i].own, has_default: fd.params[i].has_default, default_value: fd.params[i].default_value, fn_ret: subst_ty(fd.params[i].fn_ret, tparams, cts), fn_param_types: subst_ty_list(fd.params[i].fn_param_types, tparams, cts) });
    i = i + 1;
  }
  // The clone is an INSTANTIATION: every `T` has been replaced by the
  // concrete type, so it has no type params — and bound_traits, which runs
  // parallel to them, goes too. Keeping the generic's bounds here left the
  // clone declaring bounds indexed against parameters it no longer has.
  // The count goes with them: a reader asks either field whether a
  // declaration is a template (semsource.generic_decl).
  let notp: string[] = [];
  return FuncDecl {
    ...fd,
    name: name,
    receiver_name: "",
    receiver_type: "",
    type_params: notp,
    all_type_params: [],
    bound_traits: notp,
    params: nparams,
    ret_type: resolve_proj_in_type(subst_ty(fd.ret_type, tparams, cts), impls),
    ret_fn_ret: subst_ty(fd.ret_fn_ret, tparams, cts),
    ret_fn_param_types: subst_ty_list(fd.ret_fn_param_types, tparams, cts),
    body: subst_stmts(fd.body, tparams, cts),
  };
}

// ---- generic array-method monomorphisation (slice 1) ----------------
// A generic array-receiver method `(xs: T[]) m(args): R` (std/array's
// `concat` etc.) has no struct to instantiate and is skipped by both
// monomorphize_module (receiver methods are skipped) and
// monomorphize_structs (an array is not a generic struct), so its `T`
// stays a free var. The legacy AST array-method dispatch then typed the
// receiver as i32 and mis-dispatched `i32.m`. register_array_method_generics
// folds such a method into a
// bounded free generic `__arrm_m[T](xs: T[], args): R` (receiver as
// arg0) and DROPS the method decl; mono_expr's array-method arm rewrites
// each `xs.m(ys)` call to `__arrm_m(xs, ys)`, and the existing
// free-generic worklist clones one concrete `__arrm_m__<elem>` per
// element type — so generic array methods use the proven free-generic
// monomorphiser instead of that i32 mis-dispatch.

// looks_type_var reports whether `s` is a type variable: the `0_<name>`
// spelling rename_type_vars_module gives every one. Exact, since no type an
// identifier can name starts with a digit.
pub function looks_type_var(s: string): boolean {
  if (s.len() < 3 || s[0] != b'0' || s[1] != b'_' || s[2] >= b'0' && s[2] <= b'9') {
    return false;
  }
  let i: i32 = 2;
  while (i < s.len()) {
    if (!tv_word_char(s[i] as i32)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// array_method_element reads one array or view element without erasing
// a view nested inside that element.
pub function array_method_element(spelling: string): string {
  if (type_ends_arr(spelling)) {
    return elem_spelling(spelling);
  }
  if (spelling_is_view(spelling)) {
    return render_type_ref(parse_type_ref(spelling).args[0]);
  }
  return "";
}

// The generic array-method path accepts a method
// (`receiver_name` set) whose receiver is `<var>[]` or `[<var>]` for one type
// variable. Closure ("fn") params ARE allowed (`reduce` / `sort_by` /
// `filter` / `any` / `all` / `find`) and so are the method's OWN
// (unbounded) type params (`map[U]` / `flat_map[U]` / `fold[A]` /
// `zip[U]`): the receiver alone fixes the monomorphised `T`, while an
// unbounded extra type variable (`U` / `A`) is ERASED by the self-host's
// uniform 8-byte ABI exactly as it is in the free function — its
// result-element width is driven by the CALL SITE's annotation
// (`let ys: string[] = xs.map(f)`), not by cloning the body, so the
// folded body's delegation to the free `map` / `flat_map` / `fold` /
// `zip` (all of which already lower on IR) carries it through.
//
// A BOUNDED RECEIVER — `(xs: T[]) max[T: cmp.Ord]()`, whose body calls
// trait methods on the receiver element (`xs[i].cmp(m)`) — re-declares the
// receiver var `T` in `fd.type_params` (only BOUNDED params land there;
// unbounded `U`/`A` are erased). That is folded too: the receiver still
// fixes the monomorphised `T`, and substituting `T := <elem>` makes
// `xs[i].cmp(m)` resolve by ordinary concrete-type dispatch — exactly the
// path the equivalent free generic `max[T: cmp.Ord](xs: T[])` already uses.
// What stays excluded is a bounded EXTRA type param (a bounded `U` not
// fixed by the receiver): `fd.type_params` may hold the receiver let alone.
function is_concrete_array_method(fd: FuncDecl): boolean {
  let elem: string = array_method_element(fd.receiver_type);
  return fd.receiver_name.len() > 0 && elem.len() > 0
    && type_str_vars(elem, []).len() == 0;
}

pub function concrete_array_method_name(receiver: string, method: string): string {
  let elem: string = array_method_element(receiver);
  if (elem.len() == 0) {
    return "";
  }
  let prefix: string = "__carrm_";
  if (spelling_is_view(receiver)) {
    prefix = "__cviewm_";
  }
  return prefix + sanitize_key(elem) + "__" + method;
}

function is_concrete_array_fold(fd: FuncDecl): boolean {
  return fd.receiver_name.len() == 0
    && (util.str_has_prefix(fd.name, "__carrm_") || util.str_has_prefix(fd.name, "__cviewm_"));
}

function concrete_array_method_at(funcs: MFns, receiver: string, method: string): i32 {
  if (funcs.array_concrete.len() == 0) {
    return 0 - 1;
  }
  let name: string = concrete_array_method_name(receiver, method);
  for at in funcs.array_concrete {
    if (funcs.decls[at].name == name) {
      return at;
    }
  }
  return 0 - 1;
}

function is_generic_array_method(fd: FuncDecl): boolean {
  if (fd.receiver_name.len() == 0) {
    return false;
  }
  let elem: string = array_method_element(fd.receiver_type);
  if (!looks_type_var(elem)) {
    return false;
  }
  // The only bounded type param permitted is the receiver element var
  // itself (a bounded receiver); any other bounded param can't be erased
  // and isn't fixed by the receiver, so it can't use this fold.
  let k: i32 = 0;
  while (k < fd.type_params.len()) {
    if (fd.type_params[k] != elem) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// register_array_method_generics rewrites each generic array-receiver
// method into a bounded free generic `__arrm_<name>[T]` with the
// receiver folded to a leading param, and drops the original method. A
// concrete receiver gets a free function keyed by its element and namespace.
// View methods have separate names throughout both lowering paths. A
// no-op when none is present (the compiler's own sources call the free
// `concat(xs, ys)` form, never `xs.concat(ys)`, so the byte-identical
// bootstrap fixpoint is preserved). Runs before monomorphize_module so
// the folded body's free `concat(xs, other)` call is rewritten too.
pub function register_array_method_generics(mod: Module): Module {
  let any_am: boolean = false;
  let ci: i32 = 0;
  while (ci < mod.funcs.len()) {
    if (is_generic_array_method(mod.funcs[ci]) || is_concrete_array_method(mod.funcs[ci])) {
      any_am = true;
    }
    ci = ci + 1;
  }
  if (!any_am) {
    return mod;
  }

  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (is_concrete_array_method(fd)) {
      let params: ast.ParamDecl[] = [ast.ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: fd.receiver_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
      for param in fd.params {
        params = params.append(param);
      }
      out = out.append(FuncDecl { ...fd, name: concrete_array_method_name(fd.receiver_type, fd.name), receiver_name: "", receiver_type: "", params: params });
    } else if (is_generic_array_method(fd)) {
      let elem: string = array_method_element(fd.receiver_type);
      let tps: string[] = [elem + ""];
      let prefix: string = "__arrm_";
      if (spelling_is_view(fd.receiver_type)) {
        prefix = "__viewm_";
      }
      // Fold the receiver into a leading param named after the
      // receiver, so the body's references to it resolve normally.
      let nparams: ast.ParamDecl[] = [ast.ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: fd.receiver_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
      let j: i32 = 0;
      while (j < fd.params.len()) {
        nparams = nparams.append(fd.params[j]);
        j = j + 1;
      }
      out = out.append(FuncDecl {
        stdlib: fd.stdlib, no_inline: false,
        name: prefix + fd.name,
        receiver_name: "", receiver_type: "", receiver_own: false,
        type_params: tps,
        params: nparams,
        ret_type: fd.ret_type,
        body: fd.body, line: fd.line, col: fd.col,
        import_iface: fd.import_iface, import_wit: fd.import_wit, all_type_params: tps, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
        is_pub: true,
        is_const: false, ret_fn_ret: fd.ret_fn_ret, ret_fn_param_types: fd.ret_fn_param_types, is_package: false, module: fd.module, impl_trait: fd.impl_trait, dyn_traits: fd.dyn_traits, streams: fd.streams,
      });
    } else {
      out = out.append(fd);
    }
    i = i + 1;
  }
  return Module { ...mod, funcs: out };
}

// ---- generic map-method monomorphisation (the Map sibling of the array
// fold above) ------------------------------------------------------------
// A generic map-receiver method `(m: Map[K, V]) verb(args): R` (core/map's
// `merge` / `extend` / `entries` / `contains_value` / …) is skipped by
// monomorphize_module (receiver methods) and monomorphize_structs (Map is a
// built-in, not a generic struct), so its `K` / `V` stay free vars. The body's
// map ops then read the key-kind off the unsubstituted `Map[K, V]` type, where
// map_key_kind_of (whose key is the type VARIABLE `K`, not an integer) DEFAULTS to string —
// miscompiling an i32-keyed map (the integer key is dereferenced as a string
// pointer → SIGSEGV). register_map_method_generics folds such a method into a
// free generic `__mapm_<verb>[K, V](m: Map[K, V], args): R` (receiver as arg0,
// the receiver's type-vars as the clone's type params) and DROPS the method;
// mono_expr's map-method arm rewrites each `m.verb(args)` call to
// `__mapm_verb(m, args)`, so the proven free-generic worklist clones one
// concrete `__mapm_verb__<K>;<V>` per key/value pair — with `subst_ty`
// substituting `Map[K,V] → Map[i32,i32]`, so the cloned body's key-kind is
// correct. Mirrors register_array_method_generics exactly.

// map_receiver_typevars returns the type-variable arguments of a `Map[K, V]`
// receiver type (e.g. ["K", "V"]), or [] if the receiver isn't a Map whose
// args are all type variables. The args must ALL be type vars — a partially
// concrete `Map[i32, V]` isn't a generic the worklist can key on.
function map_receiver_typevars(recv: string): string[] {
  let none: string[] = [];
  if (recv.len() < 5 || slice_unchecked(recv, 0, 4) != "Map[" || slice_unchecked(recv, recv.len() - 1, recv.len()) != "]") {
    return none;
  }
  // split_top_commas splits on ", " (consuming the space), so each part is
  // already trimmed — the normalised spelling every receiver type carries.
  let parts: string[] = split_top_commas(slice_unchecked(recv, 4, recv.len() - 1));
  let out: string[] = [];
  let i: i32 = 0;
  while (i < parts.len()) {
    let tv: string = parts[i];
    if (!looks_type_var(tv)) {
      return none;
    }
    out = out.append(tv);
    i = i + 1;
  }
  return out;
}

// is_generic_map_method gates the map-method fold: a method whose receiver is
// `Map[<vars>]`, with no bounded type params other than the receiver's own
// vars (closure / value params are allowed, exactly as the array path permits
// `reduce` / `sort_by`). A 2-tuple-returning verb (`get_or_insert`) is folded
// like any other — whether its tuple-with-Map result then lowers is the
// lowering side's concern, not the fold's.
function is_generic_map_method(fd: FuncDecl): boolean {
  if (fd.receiver_name.len() == 0) {
    return false;
  }
  let tvs: string[] = map_receiver_typevars(fd.receiver_type);
  if (tvs.len() == 0) {
    return false;
  }
  // Every bounded type param must be one of the receiver's vars (the receiver
  // fixes them); an extra bounded param isn't fixed by the receiver.
  let k: i32 = 0;
  while (k < fd.type_params.len()) {
    if (!str_in(tvs, fd.type_params[k])) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// register_map_method_generics folds each generic map-receiver method into a
// free generic `__mapm_<name>[<vars>]`, receiver folded to a leading param,
// and drops the original. A no-op when none is present — the compiler's own
// sources never call the generic core/map verbs, so the byte-identical
// bootstrap fixpoint is preserved. Runs before monomorphize_module so the
// folded body's own free calls rewrite too.
pub function register_map_method_generics(mod: Module): Module {
  let any_mm: boolean = false;
  let ci: i32 = 0;
  while (ci < mod.funcs.len()) {
    if (is_generic_map_method(mod.funcs[ci])) {
      any_mm = true;
    }
    ci = ci + 1;
  }
  if (!any_mm) {
    return mod;
  }

  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (is_generic_map_method(fd)) {
      let tps: string[] = map_receiver_typevars(fd.receiver_type);
      let nparams: ast.ParamDecl[] = [ast.ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: fd.receiver_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
      let j: i32 = 0;
      while (j < fd.params.len()) {
        nparams = nparams.append(fd.params[j]);
        j = j + 1;
      }
      out = out.append(FuncDecl {
        stdlib: fd.stdlib, no_inline: false,
        name: "__mapm_" + fd.name,
        receiver_name: "", receiver_type: "", receiver_own: false,
        type_params: tps,
        params: nparams,
        ret_type: fd.ret_type,
        body: fd.body, line: fd.line, col: fd.col,
        import_iface: fd.import_iface, import_wit: fd.import_wit, all_type_params: tps, bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
        is_pub: true,
        is_const: false, ret_fn_ret: fd.ret_fn_ret, ret_fn_param_types: fd.ret_fn_param_types, is_package: false, module: fd.module, impl_trait: fd.impl_trait, dyn_traits: fd.dyn_traits, streams: fd.streams,
      });
    } else {
      out = out.append(fd);
    }
    i = i + 1;
  }
  return Module { ...mod, funcs: out };
}

// ---- generic-struct method type parameters (the third sibling of the
// array + map folds above) -----------------------------------------------
// A method on a generic struct may introduce type parameters of its OWN,
// independent of the receiver's: `(b: Box[T]) map[U](f: (T) => U): Box[U]`.
// monomorphize_structs clones the method once per RECEIVER instantiation and
// drops its own type params, so `U` survives into the clone as a free var —
// and `to_concrete_struct_ty` then mangles the return `Box[U]` to `Box__U`
// against a throwaway accumulator, so nothing ever generates that struct or
// its methods. The module bailed on `call to unknown symbol Box__U.get`
// (#6007).
//
// The fix is the fold the array and map paths already use: hoist such a
// method into a free generic `__smm_<Base>_<name>[<recv vars>, <own vars>]`
// with the receiver as arg0, drop the method, and let the proven free-generic
// worklist clone it per (receiver, own) instantiation. The receiver var binds
// from the receiver argument's type, the own var from the argument bound to
// it — so the clone's return is the CONCRETE `Box[i32]` / `Box[boolean]`,
// which monomorphize_structs (running after) mangles like any other.
//
// The method's own vars are UNBOUNDED, so they are erased from
// `fd.type_params` and cannot be read back off the decl; they are recovered
// from the signature instead — every type var in the params + return that the
// receiver does not fix is one of them.

// collect_tvars appends every generic type variable in a type spelling to
// `acc` (first-appearance order, deduped), recursing through array / tuple /
// bracketed-generic structure the same way subst_ty substitutes it. A
// fn-typed param is coarsened to the bare tag "fn" by the parser, so a var
// that appears only in a closure's RETURN is collected from `fn_ret` by the
// caller, not from here.
function collect_tvars(name: string, acc: string[]): string[] {
  if (looks_type_var(name)) {
    if (str_in(acc, name)) {
      return acc;
    }
    return acc.append(name);
  }
  if (type_ends_arr(name)) {
    return collect_tvars(slice_unchecked(name, 0, name.len() - 2), acc);
  }
  if (util.is_tuple_type_name(name) && slice_unchecked(name, name.len() - 1, name.len()) == ")") {
    let tparts: string[] = split_top_commas(slice_unchecked(name, 1, name.len() - 1));
    let tcur: string[] = acc;
    let tj: i32 = 0;
    while (tj < tparts.len()) {
      tcur = collect_tvars(tparts[tj], tcur);
      tj = tj + 1;
    }
    return tcur;
  }
  let lb: i32 = first_bracket(name);
  if (lb > 0 && slice_unchecked(name, name.len() - 1, name.len()) == "]") {
    let parts: string[] = split_top_commas(slice_unchecked(name, lb + 1, name.len() - 1));
    let cur: string[] = acc;
    let j: i32 = 0;
    while (j < parts.len()) {
      cur = collect_tvars(parts[j], cur);
      j = j + 1;
    }
    return cur;
  }
  return acc;
}

// struct_receiver_typevars returns the type-variable arguments of a
// `Base[T, …]` receiver whose args are ALL type vars, or []. The struct
// sibling of map_receiver_typevars — a partially concrete `Box[i32]` receiver
// is not a generic the worklist can key on.
pub function struct_receiver_typevars(recv: string): string[] {
  let none: string[] = [];
  let lb: i32 = first_bracket(recv);
  if (lb <= 0) {
    return none;
  }
  if (slice_unchecked(recv, recv.len() - 1, recv.len()) != "]") {
    return none;
  }
  let parts: string[] = split_top_commas(slice_unchecked(recv, lb + 1, recv.len() - 1));
  let out: string[] = [];
  let i: i32 = 0;
  while (i < parts.len()) {
    if (!looks_type_var(parts[i])) {
      return none;
    }
    out = out.append(parts[i]);
    i = i + 1;
  }
  return out;
}

// smm_own_typevars returns the method's OWN type vars: every var in its
// params (type_name + the fn_ret of a closure param) and return type that is
// not one of the receiver's.
function smm_own_typevars(fd: FuncDecl, recv_vars: string[]): string[] {
  let all: string[] = [];
  let i: i32 = 0;
  while (i < fd.params.len()) {
    all = collect_tvars(fd.params[i].type_name, all);
    all = collect_tvars(fd.params[i].fn_ret, all);
    i = i + 1;
  }
  all = collect_tvars(fd.ret_type, all);
  let own: string[] = [];
  let j: i32 = 0;
  while (j < all.len()) {
    if (!str_in(recv_vars, all[j])) {
      own = own.append(all[j]);
    }
    j = j + 1;
  }
  return own;
}

// is_generic_method_own_tps gates the fold: a method whose receiver is
// `Base[<vars>]` for a generic struct or enum declared in this module, which
// introduces at least one type var of its own.
//
// Unlike the array fold, a type param the RECEIVER does not fix is allowed:
// the fold binds it from the call's arguments, and the clone substitutes it
// with a concrete type, so a trait bound on it is discharged by ordinary
// concrete dispatch — the same argument the array path makes for a bounded
// receiver var. Every param must still be a var the SIGNATURE mentions;
// anything else (a phantom bound on a var that appears nowhere) has no
// argument to bind it and would leave the dropped method dangling.
function is_generic_method_own_tps(fd: FuncDecl, structs: StructDecl[], enums: EnumDecl[]): boolean {
  if (fd.receiver_name.len() == 0) {
    return false;
  }
  let recv_vars: string[] = struct_receiver_typevars(fd.receiver_type);
  if (recv_vars.len() == 0) {
    return false;
  }
  let base: string = strip_struct_base(fd.receiver_type);
  let si: i32 = 0;
  let found: boolean = false;
  while (si < structs.len()) {
    if (structs[si].name == base && structs[si].type_params.len() == recv_vars.len()) {
      found = true;
    }
    si = si + 1;
  }
  let ei: i32 = 0;
  while (ei < enums.len()) {
    if (enums[ei].name == base && enums[ei].type_params.len() == recv_vars.len()) {
      found = true;
    }
    ei = ei + 1;
  }
  if (!found) {
    return false;
  }
  let own: string[] = smm_own_typevars(fd, recv_vars);
  let k: i32 = 0;
  while (k < fd.type_params.len()) {
    let tp: string = fd.type_params[k];
    if (!str_in(recv_vars, tp) && !str_in(own, tp)) {
      return false;
    }
    k = k + 1;
  }
  return own.len() > 0;
}

// smm_name is the folded free generic's name: `__smm_<Base>_<method>`. The
// base is part of the name because two generic structs may both declare a
// `map` — unlike the array / map folds, whose receiver is a single built-in.
function smm_name(base: string, method: string): string {
  return "__smm_" + base + "_" + method;
}

// smm_any reports whether ANY fold for the method name `field` exists. The
// call-site arms consult this before inferring the receiver's type, so a
// program with no such fold — every program the compiler and the stdlib
// contain — answers without inferring anything. The test is a SUFFIX match,
// not equality (`__smm_Box_get_or` answers for `or` as well as for `get_or`),
// which is why MFns keeps the fold NAMES rather than a set of field names.
function smm_any(fns: MFns, field: string): boolean {
  let sfx: string = "_" + field;
  let i: i32 = 0;
  while (i < fns.smm.len()) {
    let n: string = fns.smm[i];
    if (n.len() > 6 + sfx.len() && slice_unchecked(n, n.len() - sfx.len(), n.len()) == sfx) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// register_struct_method_generics folds each generic-struct or generic-enum
// method that has its own type params into a free generic (receiver as arg0,
// receiver vars + own vars as the type params) and drops the original. A
// no-op when none is present — the stdlib's only generic structs are `Set[T]`
// and `iter.ArrayIter[T]`, neither of which declares a method var the
// receiver does not fix, and its generic enums declare no methods, so the
// byte-identical bootstrap fixpoint is preserved. Runs before
// monomorphize_module so the folded body's own generic calls rewrite too, and
// before monomorphize_structs / monomorphize_enums so the clones it leaves
// behind carry concrete `Box[i32]` annotations for those passes to mangle.
pub function register_struct_method_generics(mod: Module): Module {
  let any_sm: boolean = false;
  let ci: i32 = 0;
  while (ci < mod.funcs.len()) {
    if (is_generic_method_own_tps(mod.funcs[ci], mod.structs, mod.enums)) {
      any_sm = true;
    }
    ci = ci + 1;
  }
  if (!any_sm) {
    return mod;
  }

  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (is_generic_method_own_tps(fd, mod.structs, mod.enums)) {
      let recv_vars: string[] = struct_receiver_typevars(fd.receiver_type);
      let tps: string[] = recv_vars;
      let bnames: string[] = [];
      let bi2: i32 = 0;
      while (bi2 < recv_vars.len()) {
        bnames = bnames.append("");
        bi2 = bi2 + 1;
      }
      let own: string[] = smm_own_typevars(fd, recv_vars);
      let oi: i32 = 0;
      while (oi < own.len()) {
        tps = tps.append(own[oi]);
        bnames = bnames.append("");
        oi = oi + 1;
      }
      let nparams: ast.ParamDecl[] = [ast.ParamDecl { name: fd.receiver_name, type_name: fd.receiver_type, own: fd.receiver_own, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
      let j: i32 = 0;
      while (j < fd.params.len()) {
        nparams = nparams.append(fd.params[j]);
        j = j + 1;
      }
      out = out.append(FuncDecl {
        stdlib: fd.stdlib, no_inline: false,
        name: smm_name(strip_struct_base(fd.receiver_type), fd.name),
        receiver_name: "", receiver_type: "", receiver_own: false,
        type_params: tps,
        params: nparams,
        ret_type: fd.ret_type,
        body: fd.body, line: fd.line, col: fd.col,
        import_iface: fd.import_iface, import_wit: fd.import_wit, all_type_params: tps, bound_traits: bnames, fip: false, fbip: false, fip_allowance: 0, async: fd.async,
        is_pub: true,
        is_const: fd.is_const, ret_fn_ret: fd.ret_fn_ret, ret_fn_param_types: fd.ret_fn_param_types, is_package: false, module: fd.module, impl_trait: fd.impl_trait, dyn_traits: fd.dyn_traits, streams: fd.streams,
      });
    } else {
      out = out.append(fd);
    }
    i = i + 1;
  }
  return Module { ...mod, funcs: out };
}

// monomorphize_module expands trait-bounded generics. Non-generic
// bodies + top stmts get their bounded-generic call sites rewritten to
// mangled clone names; the clones are then generated per instantiation
// (a worklist covers clones that call other bounded generics).
// promote_erased_forwarders closes the promotion loop's clause (d) across
// functions. An erased generic that only hands a bare-var-typed parameter on to
// a bounded generic (`fold_stmt_own[T](st, acc: T, v)` calling the promoted
// `fold_stmt_nodes`) would otherwise instantiate the callee at the type
// VARIABLE — a clone keyed `T`, erased inside, with the ownership blindness the
// clause exists to remove. Promote the forwarder instead, to a fixpoint (a newly
// promoted function is a bounded callee for its own callers), whenever every
// erased var is bindable from its params.
function promote_erased_forwarders(funcs: FuncDecl[]): FuncDecl[] {
  let out: FuncDecl[] = funcs;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let gnames: string[] = [];
    let gi: i32 = 0;
    while (gi < out.len()) {
      if (out[gi].receiver_name.len() == 0 && out[gi].type_params.len() > 0) {
        gnames = gnames.append(out[gi].name);
      }
      gi = gi + 1;
    }
    let i: i32 = 0;
    while (i < out.len()) {
      let fd: FuncDecl = out[i];
      if (fd.receiver_type.len() == 0 && fd.receiver_name.len() == 0 && fd.all_type_params.len() > fd.type_params.len()) {
        let evars: string[] = erased_vars_of(fd);
        if (evars.len() > 0 && erased_vars_bindable(fd.params, evars)) {
          let scan: FwdScan = FwdScan { params: fd.params, evars: evars, gnames: gnames, hit: false };
          for st in fd.body {
            scan = astwalk.fold_stmt_nodes(st, scan, fwd_scan_stmt, fwd_scan_expr, astwalk.descend_all);
          }
          if (scan.hit) {
            let tps: string[] = fd.type_params;
            let bts: string[] = fd.bound_traits;
            for ev in evars {
              tps = tps.append(ev);
              bts = bts.append("");
            }
            out = out.with(i, FuncDecl { ...fd, type_params: tps, bound_traits: bts });
            changed = true;
          }
        }
      }
      i = i + 1;
    }
  }
  return out;
}

// promote_value_named promotes an erased generic that some body names as a
// value (`let g: (i32) => i32 = ident`, `apply(ident, 3)`): a value's type is
// its declaration's, variables and all, so only a clone keyed by the callable
// the reference is wanted at has a type. A variable the signature does not
// spell could never be bound there, so such a template stays erased and the
// checker's E040 stands.
function promote_value_named(funcs: FuncDecl[], top_stmts: ast.Stmt[]): FuncDecl[] {
  let names: string[] = [];
  let at: i32[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: FuncDecl = funcs[i];
    if (fd.receiver_type.len() == 0 && fd.receiver_name.len() == 0 && fd.all_type_params.len() > fd.type_params.len() && signature_vars_complete(fd)) {
      names = names.append(fd.name);
      at = at.append(i);
    }
    i = i + 1;
  }
  if (names.len() == 0) {
    return funcs;
  }
  let scan: ValScan = ValScan { names: names, refs: __alloc_i32(names.len()), callee_refs: __alloc_i32(names.len()) };
  for fd in funcs {
    for st in fd.body {
      scan = astwalk.fold_stmt_nodes(st, scan, val_scan_stmt, val_scan_expr, astwalk.descend_all);
    }
  }
  for st in top_stmts {
    scan = astwalk.fold_stmt_nodes(st, scan, val_scan_stmt, val_scan_expr, astwalk.descend_all);
  }
  let out: FuncDecl[] = funcs;
  let k: i32 = 0;
  while (k < names.len()) {
    if (scan.refs[k] > scan.callee_refs[k]) {
      let fd: FuncDecl = funcs[at[k]];
      let tps: string[] = fd.type_params;
      let bts: string[] = fd.bound_traits;
      for v in fd.all_type_params {
        if (!util.has_str(tps, v)) {
          tps = tps.append(v);
          bts = bts.append("");
        }
      }
      out = out.with(at[k], FuncDecl { ...fd, type_params: tps, bound_traits: bts });
    }
    k = k + 1;
  }
  return out;
}

// signature_vars_complete: every type variable of `fd` is spelled by a
// parameter or the result, the positions a callable type binds.
function signature_vars_complete(fd: FuncDecl): boolean {
  let spelled: string[] = type_str_vars(fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types), []);
  for p in fd.params {
    spelled = type_str_vars(param_spelling(p), spelled);
  }
  for v in fd.all_type_params {
    if (!util.has_str(spelled, v)) {
      return false;
    }
  }
  return true;
}

// ValScan counts, per name, every reference and every reference as a call's
// callee; the difference is the references in value position.
struct ValScan { names: string[], refs: i32[], callee_refs: i32[] }

function val_scan_stmt(st: ast.Stmt, own acc: ValScan): ValScan {
  return acc;
}

function val_scan_expr(e: ast.Expr, own acc: ValScan): ValScan {
  match (e) {
    ast.ExprIdent(id) => {
      let k: i32 = util.index_of_str(acc.names, id.name);
      if (k >= 0) {
        return ValScan { ...acc, refs: acc.refs.with(k, acc.refs[k] + 1) };
      }
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(m) = fa.obj {
        let k: i32 = util.index_of_str(acc.names, m.name + "." + fa.field);
        if (k >= 0) {
          return ValScan { ...acc, refs: acc.refs.with(k, acc.refs[k] + 1) };
        }
      }
    },
    ast.ExprCall(c) => {
      let name: string = "";
      if let ast.ExprIdent(cid) = c.callee {
        name = cid.name;
      }
      if let ast.ExprFieldAccess(cfa) = c.callee {
        if let ast.ExprIdent(cm) = cfa.obj {
          name = cm.name + "." + cfa.field;
        }
      }
      let k: i32 = util.index_of_str(acc.names, name);
      if (k >= 0) {
        return ValScan { ...acc, callee_refs: acc.callee_refs.with(k, acc.callee_refs[k] + 1) };
      }
    },
    _ => {}
  }
  return acc;
}

struct FwdScan { params: ast.ParamDecl[], evars: string[], gnames: string[], hit: boolean }

function fwd_scan_stmt(st: ast.Stmt, own acc: FwdScan): FwdScan {
  return acc;
}

// fwd_scan_expr marks the scan when a call to a bounded generic passes a bare
// identifier naming one of the function's own erased-var-typed parameters.
function fwd_scan_expr(e: ast.Expr, own acc: FwdScan): FwdScan {
  if (acc.hit) {
    return acc;
  }
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (!util.has_str(acc.gnames, cid.name)) {
            return acc;
          }
          for arg in c.args {
            match (arg) {
              ast.ExprIdent(aid) => {
                let pi: i32 = 0;
                while (pi < acc.params.len()) {
                  if (acc.params[pi].name == aid.name && util.has_str(acc.evars, acc.params[pi].type_name)) {
                    return FwdScan { ...acc, hit: true };
                  }
                  pi = pi + 1;
                }
              },
              _ => {}
            }
          }
          return acc;
        },
        _ => {
          return acc;
        }
      }
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

// erased_vars_of lists the type variables of `fd`'s signature that are not in
// its bounded set — the ones the parser left erased.
function erased_vars_of(fd: FuncDecl): string[] {
  let vs: string[] = type_str_vars(fd.ret_type, []);
  for pd in fd.params {
    vs = type_str_vars(pd.type_name, vs);
  }
  let out: string[] = [];
  for v in vs {
    if (!util.has_str(fd.type_params, v)) {
      out = out.append(v);
    }
  }
  return out;
}

// erased_vars_bindable: every var is bindable from some param — the same test
// as clause (b) of the promotion loop, so the clone's key is complete.
function erased_vars_bindable(params: ast.ParamDecl[], vars: string[]): boolean {
  for v in vars {
    let ok: boolean = false;
    for pd in params {
      if (token_at_paren_depth0(pd.type_name, v) || token_in_tuple_param(pd.type_name, v)) {
        ok = true;
      }
    }
    if (!ok) {
      return false;
    }
  }
  return true;
}

// monomorphize_all runs the four monomorphisation passes. A generic promoted
// because a fn-typed param binds its var is only as cloneable as its call
// sites are inferable: a function value whose type no declaration spells
// (`fs[i]`, a match arm) keys nothing, and the call would name the dropped
// template. Such a template is left erased, as it was before the fn-param
// binding promoted it, and the passes run again. The scan reads the result of
// all four, so a call from a generic-struct method (rewritten by
// monomorphize_structs) or a top-level statement is judged as it ends up.
pub function monomorphize_all(mod: Module): Module {
  let candidates: string[] = [];
  for fd in mod.funcs {
    if (is_bg_template(fd) && fn_param_promoted(fd)) {
      candidates = candidates.append(fd.name);
    }
  }
  let erased: string[] = [];
  let out: Module = monomorphize_chain(mod, erased);
  let stranded: string[] = stranded_names(out, candidates, erased);
  while (stranded.len() > 0) {
    erased = util.append_all(erased, stranded);
    out = monomorphize_chain(mod, erased);
    stranded = stranded_names(out, candidates, erased);
  }
  return out;
}

function monomorphize_chain(mod: Module, erased: string[]): Module {
  return monomorphize_enum_structs(monomorphize_enums(monomorphize_structs(monomorphize_module(mod, erased))));
}

// The candidates a call in the monomorphised module still names bare: every
// clone has a mangled name, so a bare one is the dropped template.
function stranded_names(mod: Module, candidates: string[], erased: string[]): string[] {
  let out: string[] = [];
  if (candidates.len() == 0) {
    return out;
  }
  // Only a free reference can name a dropped template. A parameter or local
  // with the same spelling belongs to its lexical scope, including captures
  // and names introduced by patterns. Keep reads before a later shadow.
  let refs: string[] = astwalk.collect_free_idents([], mod.top_stmts, []);
  for fd in mod.funcs {
    let bound: string[] = hl_param_names(fd.params);
    if (fd.receiver_name.len() > 0) {
      bound = bound.append(fd.receiver_name);
    }
    refs = astwalk.collect_free_idents(bound, fd.body, refs);
  }
  let used: util.NameIndex = util.name_index(refs);
  for name in candidates {
    if (util.has_str(erased, name)) {
      continue;
    }
    if (used.find(name) >= 0) {
      out = out.append(name);
    }
  }
  return out;
}

// Every var promoted rather than declared bounded, and one that only a
// fn-typed param binds: no plain param does, and the return is no clause
// (b′) binding either, so clause (d) or (e) is what promoted it.
function fn_param_promoted(fd: FuncDecl): boolean {
  for b in fd.bound_traits {
    if (b.len() > 0) {
      return false;
    }
  }
  for v in fd.type_params {
    let plain: boolean = false;
    for pd in fd.params {
      if (token_at_paren_depth0(pd.type_name, v) || token_in_tuple_param(pd.type_name, v)) {
        plain = true;
      }
    }
    if (plain || feeds_user_parametric(fd.ret_type, v) || feeds_map_typearg(fd.ret_type, v)) {
      continue;
    }
    if (has_fn_param_arg_var(fd.params, v) || has_fn_param_ret_var(fd.params, v)) {
      return true;
    }
  }
  return false;
}

function erase_promotions(funcs: FuncDecl[], erased: string[]): FuncDecl[] {
  if (erased.len() == 0) {
    return funcs;
  }
  let out: FuncDecl[] = [];
  for fd in funcs {
    if (util.has_str(erased, fd.name) && is_bg_template(fd)) {
      out = out.append(FuncDecl { ...fd, type_params: [], bound_traits: [] });
    } else {
      out = out.append(fd);
    }
  }
  return out;
}

function monomorphize_module(mod: Module, erased: string[]): Module {
  let funcs: FuncDecl[] = erase_promotions(promote_value_named(promote_erased_forwarders(mod.funcs), mod.top_stmts), erased);
  // Concrete array methods also need their receiver calls folded.
  let any_bg: boolean = false;
  let bi: i32 = 0;
  while (bi < funcs.len()) {
    if (funcs[bi].receiver_name.len() == 0 && funcs[bi].type_params.len() > 0 || is_concrete_array_fold(funcs[bi])) {
      any_bg = true;
    }
    bi = bi + 1;
  }
  if (!any_bg) {
    return Module { ...mod, funcs: funcs };
  }

  let ins: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let fns: MFns = mfns_of(funcs, mod.structs, mod.enums, mod.impls);
  // Rewrite call sites in every NON-generic function body. A bounded
  // generic's body is rewritten per clone instead; the template itself is
  // passed through so monomorphize_structs can still clone it from a
  // generic-struct METHOD clone, and is dropped there. A generic struct's
  // method is generic in the struct's params, so its body is likewise
  // rewritten only per struct instantiation (env concrete), never here
  // where `k: K` would key a clone on the variable.
  let rewritten: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: FuncDecl = funcs[i];
    if (is_bg_template(fd) || is_gstruct_method(fd, mod.structs)) {
      rewritten = rewritten.append(fd);
    } else {
      let env: MEnv = env_from_decl(fd);
      let rb: RStmts = mono_stmts(fd.body, env, fns, ins, fn_tag_spelling(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types));
      ins = rb.rins3;
      rewritten = rewritten.append(FuncDecl { ...fd, body: rb.rstmts });
    }
    i = i + 1;
  }
  // Rewrite top-level stmts too.
  let topenv: MEnv = MEnv { mnames: [], mtypes: [] };
  let tr: RStmts = mono_stmts(mod.top_stmts, topenv, fns, ins, "");
  ins = tr.rins3;

  // Worklist: generate clones; a clone's own body may call bounded
  // generics, adding new instantiations.
  let done: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let wi: i32 = 0;
  while (wi < ins.inames.len()) {
    let nm: string = ins.inames[wi];
    let ct: string = ins.itypes[wi];
    if (done.ihas(nm, ct)) {
      wi = wi + 1;
      continue;
    }
    done = done.iadd(nm, ct);
    let gi: i32 = bg_find(fns, nm);
    if (gi >= 0) {
      let cl: FuncDecl = clone_bg(funcs[gi], ct, mod.impls);
      // Rewrite the clone's body so any bounded-generic calls it
      // makes resolve too (and enqueue their instantiations).
      let cenv: MEnv = env_from_params(cl.params);
      let crb: RStmts = mono_stmts(cl.body, cenv, fns, ins, fn_tag_spelling(cl.ret_type, cl.ret_fn_ret, cl.ret_fn_param_types));
      ins = crb.rins3;
      // The receiver is cleared: a lifted closure is a free function.
      rewritten = rewritten.append(FuncDecl { ...cl, receiver_name: "", receiver_type: "", body: crb.rstmts });
    }
    wi = wi + 1;
  }

  return Module { ...mod, funcs: rewritten, top_stmts: tr.rstmts };
}

// is_bg_template: a bounded-generic free function — the template the
// monomorphiser clones per instantiation and never emits itself.
function is_bg_template(fd: FuncDecl): boolean {
  return fd.receiver_name.len() == 0 && fd.type_params.len() > 0;
}

// is_gstruct_method: a method (or receiver-less associated fn) of a generic
// struct declared in `structs` — cloned per struct instantiation by
// monomorphize_structs.
function is_gstruct_method(fd: FuncDecl, structs: StructDecl[]): boolean {
  if (fd.receiver_type.len() == 0) {
    return false;
  }
  let base: string = strip_struct_base(fd.receiver_type);
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == base && structs[i].type_params.len() > 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// drop_bg_templates removes the bounded-generic templates once no pass can
// instantiate them further.
function drop_bg_templates(funcs: FuncDecl[]): FuncDecl[] {
  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (!is_bg_template(funcs[i])) {
      out = out.append(funcs[i]);
    }
    i = i + 1;
  }
  return out;
}

// has_func_named reports whether either list already holds a function
// called `name` — a clone monomorphize_module produced, or one this pass did.
function has_func_named(a: FuncDecl[], b: FuncDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  let j: i32 = 0;
  while (j < b.len()) {
    if (b[j].name == name) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

// ---- generic-struct monomorphisation --------------------------------
// The self-host historically erased generic struct type parameters: a
// `Box[i32]` and a `Box[string]` shared one untyped "Box" shape. That's
// fine when the type argument is a heap value (its runtime shape drives
// method dispatch) but breaks for a primitive/string `T`, because then
// `self.v` has static type "T" and `self.v.to_string()` can't be
// dispatched (no shape header on a raw i32). This pass clones each
// generic struct per concrete instantiation (`Box[i32]` -> `Box__i32`
// with `v: i32`), re-points its @derive- and `impl`-synthesised methods
// at the clone, and rewrites every annotation + struct literal to the
// mangled name — so the field types are concrete and dispatch resolves
// statically (the same `f__<key>` scheme the function monomorphiser
// uses). A no-op when no struct is generic (the self-host source +
// stdlib use none), which keeps the byte-identical fixpoint.

// TyIns threads a rewritten type string alongside the running
// instantiation accumulator.
struct TyIns { ty: string, mins: Insts }

// FRes threads a rewritten function alongside the accumulator.
struct FRes { ffn: FuncDecl, fins: Insts }

// gstruct_index returns the index of the generic struct named `base` in
// `gstructs`, or -1.
function gstruct_index(gstructs: StructDecl[], base: string): i32 {
  let i: i32 = 0;
  while (i < gstructs.len()) {
    if (gstructs[i].name == base) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// strip_struct_base returns a (possibly generic) receiver/struct type's
// base name: `Box` / `Box[T]` / `Box[i32]` all yield "Box".
function strip_struct_base(ty: string): string {
  let lb: i32 = first_bracket(ty);
  if (lb > 0) {
    return slice_unchecked(ty, 0, lb) + "";
  }
  return ty;
}

// mg_ty mangles a generic-struct reference inside a type string to its
// monomorphised clone name (`Box[i32]` -> `Box__i32`), recursing through
// an array suffix, a tuple element, a callable's parameters and result, and
// nested generic arguments, recording each instantiation it discovers.
// Non-generic types pass through unchanged.
function mg_ty(ty: string, gstructs: StructDecl[], ins: Insts): TyIns {
  // A callable's parameter list spells a consuming slot `own T`, and the
  // type sits behind the mode.
  if (ty.len() > 4 && slice_unchecked(ty, 0, 4) == "own ") {
    let o: TyIns = mg_ty(slice_unchecked(ty, 4, ty.len()) + "", gstructs, ins);
    return TyIns { ty: "own " + o.ty, mins: o.mins };
  }
  if (type_ends_arr(ty)) {
    let r: TyIns = mg_ty(slice_unchecked(ty, 0, ty.len() - 2), gstructs, ins);
    return TyIns { ty: r.ty + "[]", mins: r.mins };
  }
  // A callable spelling `(P, Q) => R`: the generic struct can sit in any of
  // the parameters or in the result, and the bracket arm below would read
  // `(i32) => Slot[i32]` as the base `(i32) => Slot` and hand it back
  // unmangled. A GROUPED callable — `((i32) => i32)`, what an array of
  // functions peels to — parses as a one-element tuple and belongs to the
  // arm after this one, which keeps the parens that distinguish it.
  // Rebuilding canonicalises the spelling, so a signature that mangles to
  // itself is handed back verbatim rather than respelled.
  if (ty.len() > 0 && ty[0] == b'(' && util.contains(ty, "=>")) {
    let fref: TypeRef = parse_type_ref(ty);
    if (fref.is_fn) {
      let fcur: Insts = ins;
      let fout: string = "";
      let fchanged: boolean = false;
      let fi: i32 = 0;
      while (fi + 1 < fref.args.len()) {
        let psp: string = render_type_ref(fref.args[fi]);
        let pm: TyIns = mg_ty(psp, gstructs, fcur);
        fcur = pm.mins;
        if (pm.ty != psp) {
          fchanged = true;
        }
        if (fi > 0) {
          fout = fout + ", ";
        }
        fout = fout + pm.ty;
        fi = fi + 1;
      }
      let rsp: string = render_type_ref(fref.args[fref.args.len() - 1]);
      let rm: TyIns = mg_ty(rsp, gstructs, fcur);
      fcur = rm.mins;
      if (rm.ty != rsp) {
        fchanged = true;
      }
      if (!fchanged) {
        return TyIns { ty: ty, mins: fcur };
      }
      return TyIns { ty: "(" + fout + ") => " + rm.ty, mins: fcur };
    }
  }
  if (util.is_tuple_type_name(ty) && slice_unchecked(ty, ty.len() - 1, ty.len()) == ")") {
    let tps: string[] = split_top_commas(slice_unchecked(ty, 1, ty.len() - 1));
    let tcur: Insts = ins;
    let tnin2: string = "";
    let tk: i32 = 0;
    while (tk < tps.len()) {
      let tpr: TyIns = mg_ty(tps[tk], gstructs, tcur);
      tcur = tpr.mins;
      if (tk > 0) {
        tnin2 = tnin2 + ", ";
      }
      tnin2 = tnin2 + tpr.ty;
      tk = tk + 1;
    }
    return TyIns { ty: "(" + tnin2 + ")", mins: tcur };
  }
  let lb: i32 = first_bracket(ty);
  if (lb > 0 && slice_unchecked(ty, ty.len() - 1, ty.len()) == "]") {
    let base: str = slice_unchecked(ty, 0, lb);
    let inner: str = slice_unchecked(ty, lb + 1, ty.len() - 1);
    let parts: string[] = split_top_commas(inner);
    // Register the instantiation only when the annotation supplies exactly
    // as many arguments as the struct declares. A mismatch skips
    // registration so clone/subst never see a short key — mirrors native's
    // `len(sl.TypeArgs) != len(gen.TypeParams)` gate in internal/oracle/monomorph.
    // Without it the short key reaches subst_ty, whose `cts[k]` indexes past
    // the supplied arguments and aborts the compiler.
    let gsi: i32 = gstruct_index(gstructs, base);
    if (gsi >= 0 && parts.len() == gstructs[gsi].type_params.len()) {
      let cur: Insts = ins;
      let key: string = "";
      let j: i32 = 0;
      while (j < parts.len()) {
        let pr: TyIns = mg_ty(parts[j], gstructs, cur);
        cur = pr.mins;
        if (j > 0) {
          key = key + "__";
        }
        key = key + pr.ty;
        j = j + 1;
      }
      cur = cur.iadd(base, key);
      return TyIns { ty: base + "__" + sanitize_key(key), mins: cur };
    }
    // A NON-generic-struct generic base — a built-in `Option`/`Result` or a
    // user generic ENUM (`Opt[Box[i32]]`). The base itself isn't mangled
    // here (the enum pass, which runs after, keys it), but recurse into its
    // args so a NESTED generic-struct argument is monomorphised to its clone
    // name (`Opt[Box[i32]]` -> `Opt[Box__i32]`); the enum pass then sees a
    // plain nominal arg it can key. Args with no generic struct pass through
    // unchanged. Only fires when a generic struct exists in the module (the
    // whole pass is a no-op otherwise), so it is fixpoint-safe.
    let cur2: Insts = ins;
    let ninner: string = "";
    let k: i32 = 0;
    while (k < parts.len()) {
      let pr2: TyIns = mg_ty(parts[k], gstructs, cur2);
      cur2 = pr2.mins;
      if (k > 0) {
        ninner = ninner + ", ";
      }
      ninner = ninner + pr2.ty;
      k = k + 1;
    }
    return TyIns { ty: base + "[" + ninner + "]", mins: cur2 };
  }
  return TyIns { ty: ty, mins: ins };
}

// mg_ty_list is mg_ty over the comma-separated list a callable's
// `fn_param_types` holds, threading the instantiation accumulator so a generic
// struct named ONLY inside a callable's signature is still registered.
function mg_ty_list(list: string, gstructs: StructDecl[], ins: Insts): TyIns {
  if (list.len() == 0) {
    return TyIns { ty: "", mins: ins };
  }
  let parts: string[] = split_top_commas(list);
  let cur: Insts = ins;
  let out: string = "";
  let i: i32 = 0;
  while (i < parts.len()) {
    let r: TyIns = mg_ty(parts[i], gstructs, cur);
    cur = r.mins;
    if (i > 0) {
      out = out + ",";
    }
    out = out + r.ty;
    i = i + 1;
  }
  return TyIns { ty: out, mins: cur };
}

// to_concrete_struct_ty resolves a method's substituted type string to
// the concrete clone name: a bare base anywhere in it (`Box` from a @derive
// method's `other: Box` param, or inside its `Result[Box, string]`) becomes
// the mangled name directly; an arg form (`Box[i32]`, from a parametric
// `impl[T]`) goes through mg_ty.
function to_concrete_struct_ty(ty: string, base: string, mang: string, gstructs: StructDecl[]): string {
  let fresh: Insts = Insts { inames: [], itypes: [], iargs: [] };
  return mg_ty(replace_ident(ty, base, mang, true), gstructs, fresh).ty;
}

// to_concrete_struct_ty over a callable's comma-separated parameter list.
function to_concrete_struct_ty_list(list: string, base: string, mang: string, gstructs: StructDecl[]): string {
  if (list.len() == 0) {
    return "";
  }
  let parts: string[] = split_top_commas(list);
  let out: string = "";
  let i: i32 = 0;
  while (i < parts.len()) {
    if (i > 0) {
      out = out + ",";
    }
    out = out + to_concrete_struct_ty(parts[i], base, mang, gstructs);
    i = i + 1;
  }
  return out;
}

// infer_lit_key infers the concrete instantiation key for a struct
// literal of generic struct `gd` from its field values — unifying each
// value's inferred type against the field's declared type, exactly the
// way a call's arguments pin its type parameters. Returns "" if any type
// parameter is left unbound (the literal then stays erased).
function infer_lit_key(gd: StructDecl, fnames: string[], fvals: ast.Expr[], env: MEnv, funcs: MFns): string {
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  let fi: i32 = 0;
  while (fi < gd.fields.len()) {
    let fname: string = gd.fields[fi].name;
    let vi: i32 = 0;
    while (vi < fnames.len()) {
      if (fnames[vi] == fname) {
        let ct: string = mono_infer(fvals[vi], env, funcs);
        if (ct.len() > 0) {
          binds = bind_unify(gd.fields[fi].type_name, ct, gd.type_params, binds, funcs);
        }
      }
      vi = vi + 1;
    }
    fi = fi + 1;
  }
  let key: string = "";
  let k: i32 = 0;
  while (k < gd.type_params.len()) {
    let b: string = binds.elook(gd.type_params[k]);
    if (b.len() == 0) {
      return "";
    }
    if (k > 0) {
      key = key + "__";
    }
    key = key + b;
    k = k + 1;
  }
  return key;
}

// ms_expr rewrites a struct literal of a generic struct to its mangled
// clone name (inferring the key from field values) and recurses through
// every sub-expression, threading the instantiation accumulator.
function ms_expr(e: ast.Expr, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  match (e) {
    ast.ExprBinary(b) => {
      let l: RExpr = ms_expr(b.left, env, gstructs, funcs, ins);
      let r: RExpr = ms_expr(b.right, env, gstructs, funcs, l.rins);
      return RExpr { rexpr: ast.ExprBinary { op: b.op, left: l.rexpr, right: r.rexpr, line: b.line, col: b.col, ty: b.ty }, rins: r.rins };
    },
    ast.ExprUnary(u) => {
      let o: RExpr = ms_expr(u.operand, env, gstructs, funcs, ins);
      return RExpr { rexpr: ast.ExprUnary { op: u.op, operand: o.rexpr, line: u.line, col: u.col, ty: u.ty }, rins: o.rins };
    },
    ast.ExprCall(c) => {
      return ms_call(c, env, gstructs, funcs, ins);
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < a.elements.len()) {
        let re: RExpr = ms_expr(a.elements[i], env, gstructs, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprArray { ...a, elements: els }, rins: cur };
    },
    ast.ExprTuple(t) => {
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < t.elements.len()) {
        let re: RExpr = ms_expr(t.elements[i], env, gstructs, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprTuple { elements: els, line: t.line, col: t.col }, rins: cur };
    },
    ast.ExprIndex(ix) => {
      let ar: RExpr = ms_expr(ix.array, env, gstructs, funcs, ins);
      let idx: RExpr = ms_expr(ix.index, env, gstructs, funcs, ar.rins);
      // `ty` PROPAGATES where `unchecked` is dropped, and the asymmetry is
      // deliberate: dropping the bounds-elide mark is conservative (the
      // clone keeps its bounds check), but dropping the typed-IR tag is
      // NOT — the lowering then falls back to a structural walk
      // that misses exactly the shapes the tag exists to cover, and the
      // clone lowers an f64 element as a 4-byte i32 read. The tag stays
      // valid across cloning because annotation runs on the ERASED form,
      // so a bare type parameter stamps "" and only concrete tags survive
      // to be copied — the same reason subst_expr already carries it.
      return RExpr { rexpr: ast.ExprIndex { array: ar.rexpr, index: idx.rexpr, unchecked: false, ty: ix.ty, line: ix.line, col: ix.col }, rins: idx.rins };
    },
    ast.ExprSlice(sl) => {
      let ar: RExpr = ms_expr(sl.array, env, gstructs, funcs, ins);
      let st: RExpr = ms_expr(sl.start, env, gstructs, funcs, ar.rins);
      let en: RExpr = ms_expr(sl.end, env, gstructs, funcs, st.rins);
      return RExpr { rexpr: ast.ExprSlice { ...sl, array: ar.rexpr, start: st.rexpr, end: en.rexpr }, rins: en.rins };
    },
    ast.ExprFieldAccess(fa) => {
      let o: RExpr = ms_expr(fa.obj, env, gstructs, funcs, ins);
      return RExpr { rexpr: ast.ExprFieldAccess { obj: o.rexpr, field: fa.field, line: fa.line, col: fa.col, ty: fa.ty }, rins: o.rins };
    },
    ast.ExprIdent(id) => {
      // A type parameter substituted into an associated call's object
      // (subst_expr) can be an applied generic struct, `Box[string].f()`,
      // which names its clone.
      if (first_bracket(id.name) > 0 && gstruct_index(gstructs, strip_struct_base(id.name)) >= 0) {
        let mt: TyIns = mg_ty(id.name, gstructs, ins);
        return RExpr { rexpr: ast.ExprIdent { ...id, name: mt.ty }, rins: mt.mins };
      }
      return RExpr { rexpr: e, rins: ins };
    },
    ast.ExprStructLit(s) => {
      return ms_struct_lit(s, "", env, gstructs, funcs, ins);
    },
    ast.ExprLambda(lm) => {
      return ms_lambda(lm, "", env, gstructs, funcs, ins);
    },
    _ => {
      return RExpr { rexpr: e, rins: ins };
    }
  }
  return RExpr { rexpr: e, rins: ins };
}

// ms_lambda rewrites a lambda's annotations and body. Its `return`s are bound
// to `dest` when one is given — a value-position if/match is a lambda called
// at once, and the binding it initializes is its arms' result — and else to
// the result type the lambda declares.
function ms_lambda(lm: ast.ExprLambda, dest: string, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  let rt: TyIns = mg_ty(lm.ret_type, gstructs, ins);
  let rdest: string = dest;
  if (rdest.len() == 0 && !mono_ty_mentions_var(lm.ret_type)) {
    rdest = rt.ty;
  }
  let bodyr: RStmts = ms_stmts(lm.body, env, gstructs, funcs, rt.mins, rdest);
  let nparams: ast.ParamDecl[] = [];
  let pcur: Insts = bodyr.rins3;
  let pi: i32 = 0;
  while (pi < lm.params.len()) {
    let pt: TyIns = mg_ty(lm.params[pi].type_name, gstructs, pcur);
    pcur = pt.mins;
    let pr: TyIns = mg_ty(lm.params[pi].fn_ret, gstructs, pcur);
    pcur = pr.mins;
    let pl: TyIns = mg_ty_list(lm.params[pi].fn_param_types, gstructs, pcur);
    pcur = pl.mins;
    nparams = nparams.append(ast.ParamDecl { ...lm.params[pi], type_name: pt.ty, fn_ret: pr.ty, fn_param_types: pl.ty });
    pi = pi + 1;
  }
  // The lambda's own callable RESULT lives in the same sidecar pair
  // FuncDecl carries, and the `...lm` spread would copy it verbatim.
  let lrr: TyIns = mg_ty(lm.ret_fn_ret, gstructs, pcur);
  pcur = lrr.mins;
  let lrl: TyIns = mg_ty_list(lm.ret_fn_param_types, gstructs, pcur);
  pcur = lrl.mins;
  for cap in lm.captures {
    pcur = mg_ty(typeinfo.spelling(cap.ty), gstructs, pcur).mins;
  }
  function struct_clone(t: typeinfo.Type): string {
    if let typeinfo.TypeStruct(_) = t {
      let sp: string = typeinfo.spelling(t);
      let m: string = mg_ty(sp, gstructs, pcur).ty;
      if (m != sp) {
        return m;
      }
    }
    return "";
  }
  let caps: ast.TypedBinding[] = [];
  for cap in lm.captures {
    caps = caps.append(ast.TypedBinding { name: cap.name, ty: typeinfo.renamed_nominals(cap.ty, struct_clone) });
  }
  return RExpr { rexpr: ast.ExprLambda { ...lm, params: nparams, ret_type: rt.ty, ret_fn_ret: lrr.ty, ret_fn_param_types: lrl.ty, body: bodyr.rstmts, use_infer: false, captures: caps }, rins: pcur };
}

// ms_struct_lit rewrites a struct literal of a generic struct to its mangled
// clone. `dest` is the mangled type the literal is bound to, or "": a
// destination naming a clone of the literal's struct fixes the instantiation,
// as it does in the checker, so an untyped field literal (`a: 3`) cannot key an
// `i32` clone for a `Same[i64]` slot. Without one the key is inferred from the
// field values.
function ms_struct_lit(s: ast.ExprStructLit, dest: string, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  let cur: Insts = ins;
  // A written instantiation (`Stack[i32] { items: [] }`) names the clone the
  // way an annotation does; the field values need not bind every parameter.
  let lit_dest: string = dest;
  if (s.written.len() > 0 && !mono_ty_mentions_var(s.written)) {
    let wm: TyIns = mg_ty(s.written, gstructs, cur);
    cur = wm.mins;
    lit_dest = wm.ty;
  }
  let vals: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < s.field_values.len()) {
    let fdest: string = "";
    let fty: string = lit_field_decl_type(funcs.structs, s.type_name, s.field_names[i]);
    if (fty.len() > 0 && !mono_ty_mentions_var(fty)) {
      let fm: TyIns = mg_ty(fty, gstructs, cur);
      cur = fm.mins;
      fdest = fm.ty;
    }
    let rv: RExpr = ms_expr_to(s.field_values[i], fdest, env, gstructs, funcs, cur);
    cur = rv.rins;
    vals = vals.append(rv.rexpr);
    i = i + 1;
  }
  let rb: RExpr = ms_expr(s.base, env, gstructs, funcs, cur);
  cur = rb.rins;
  let tn: string = s.type_name;
  let gi: i32 = gstruct_index(gstructs, s.type_name);
  if (gi >= 0 && is_clone_of(lit_dest, s.type_name)) {
    tn = lit_dest;
  } else if (gi >= 0) {
    let key: string = infer_lit_key(gstructs[gi], s.field_names, vals, env, funcs);
    if (key.len() > 0) {
      tn = s.type_name + "__" + sanitize_key(key);
      cur = cur.iadd(s.type_name, key);
    }
  }
  // An instance takes no type arguments, so the written ones are spent.
  let written: string = s.written;
  if (tn != s.type_name) {
    written = "";
  }
  return RExpr { rexpr: ast.ExprStructLit { type_name: tn, field_names: s.field_names, field_values: vals, has_base: s.has_base, base: rb.rexpr, line: s.line, col: s.col, written: written }, rins: cur };
}

// lit_field_decl_type is the declared type of field `field` of the
// non-generic struct `name`, or "": a generic struct's field names a type
// variable the literal's own instantiation settles.
function lit_field_decl_type(structs: StructDecl[], name: string, field: string): string {
  for sd in structs {
    if (sd.name == name && sd.type_params.len() == 0) {
      for f in sd.fields {
        if (f.name == field) {
          return f.type_name;
        }
      }
      return "";
    }
  }
  return "";
}

// is_clone_of: `mangled` names a monomorphised clone of generic struct `base`.
function is_clone_of(mangled: string, base: string): boolean {
  let pfx: string = base + "__";
  return mangled.len() > pfx.len() && util.str_has_prefix(mangled, pfx);
}

// ms_expr_to is ms_expr for an expression bound to the mangled type `dest`: a
// generic struct literal takes its instantiation from `dest`, and so does each
// element of an array literal bound to `dest`'s array type and each arm of a
// value-position if/match.
function ms_expr_to(e: ast.Expr, dest: string, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  if (dest.len() == 0) {
    return ms_expr(e, env, gstructs, funcs, ins);
  }
  if let ast.ExprStructLit(s) = e {
    return ms_struct_lit(s, dest, env, gstructs, funcs, ins);
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lm) = c.callee {
      if (c.args.len() == 0 && lm.params.len() == 0) {
        let rl: RExpr = ms_lambda(lm, dest, env, gstructs, funcs, ins);
        return RExpr { rexpr: ast.ExprCall { ...c, callee: rl.rexpr }, rins: rl.rins };
      }
    }
  }
  if let ast.ExprArray(a) = e {
    if (type_ends_arr(dest)) {
      let el: string = slice_unchecked(dest, 0, dest.len() - 2) + "";
      let els: ast.Expr[] = [];
      let cur: Insts = ins;
      for x in a.elements {
        let re: RExpr = ms_expr_to(x, el, env, gstructs, funcs, cur);
        cur = re.rins;
        els = els.append(re.rexpr);
      }
      return RExpr { rexpr: ast.ExprArray { ...a, elements: els }, rins: cur };
    }
  }
  return ms_expr(e, env, gstructs, funcs, ins);
}

// ms_call rewrites a call's callee and arguments. An argument to a plain
// function or to a method of a non-generic receiver is bound to that
// parameter's declared type when the type names no type variable.
function ms_call(c: ast.ExprCall, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  let rc: RExpr = ms_expr(c.callee, env, gstructs, funcs, ins);
  let cur: Insts = rc.rins;
  let fname: string = "";
  if let ast.ExprIdent(cid) = c.callee {
    if (env.elook(cid.name).len() == 0) {
      fname = cid.name;
    }
  }
  let mdecl: i32 = method_decl_at(c.callee, env, funcs);
  // `xs.append(x)` and `xs.with(i, x)` type their element argument by the
  // receiver's element, as the checker does, so a generic-struct literal
  // written there keys its clone from the array when its field values
  // cannot (a closure-typed field has no spelling to infer from).
  let elem_dest: string = "";
  let elem_at: i32 = 0 - 1;
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (fa.field == "append" || fa.field == "with") {
      let rt: string = mono_infer(fa.obj, env, funcs);
      if (type_ends_arr(rt)) {
        let el: string = slice_unchecked(rt, 0, rt.len() - 2) + "";
        if (!mono_ty_mentions_var(el)) {
          let em: TyIns = mg_ty(el, gstructs, cur);
          cur = em.mins;
          elem_dest = em.ty;
          elem_at = 0;
          if (fa.field == "with") {
            elem_at = 1;
          }
        }
      }
    }
  }
  let nargs: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < c.args.len()) {
    let dest: string = "";
    let pty: string = "";
    if (fname.len() > 0) {
      pty = func_param_type_at(funcs.decls, fname, i);
    } else if (mdecl >= 0 && i < funcs.decls[mdecl].params.len()) {
      pty = funcs.decls[mdecl].params[i].type_name;
    }
    if (pty.len() > 0 && !mono_ty_mentions_var(pty)) {
      let pm: TyIns = mg_ty(pty, gstructs, cur);
      cur = pm.mins;
      dest = pm.ty;
    }
    if (i == elem_at) {
      dest = elem_dest;
    }
    let ra: RExpr = ms_expr_to(c.args[i], dest, env, gstructs, funcs, cur);
    cur = ra.rins;
    nargs = nargs.append(ra.rexpr);
    i = i + 1;
  }
  // A written type argument names the clone its argument's type does.
  let targs: string[] = [];
  for ta in c.type_args {
    if (ta.len() > 0 && !mono_ty_mentions_var(ta)) {
      let tm: TyIns = mg_ty(ta, gstructs, cur);
      cur = tm.mins;
      targs = targs.append(tm.ty);
    } else {
      targs = targs.append(ta);
    }
  }
  return RExpr { rexpr: ast.ExprCall { callee: rc.rexpr, args: nargs, line: c.line, col: c.col, type_args: targs, ty: c.ty }, rins: cur };
}

// method_decl_at is the index in funcs.decls of the method `recv.m` names,
// for a receiver whose type the monomorphiser can read, or -1.
function method_decl_at(callee: ast.Expr, env: MEnv, funcs: MFns): i32 {
  if let ast.ExprFieldAccess(fa) = callee {
    let rt: string = mono_infer(fa.obj, env, funcs);
    if (rt.len() == 0) {
      return 0 - 1;
    }
    let i: i32 = 0;
    while (i < funcs.decls.len()) {
      let d: FuncDecl = funcs.decls[i];
      if (d.name == fa.field && d.receiver_name.len() > 0 && d.receiver_type == rt && d.all_type_params.len() == 0) {
        return i;
      }
      i = i + 1;
    }
  }
  return 0 - 1;
}

// retype_assoc_ctor rewrites a receiver-less associated call on a GENERIC
// struct base — `Box.default()` — to its monomorphised name
// `Box__Inner.default()` when the destination pins the instantiation
// (`let b: Box[Inner] = Box.default()`). A receiver-less constructor has no
// arguments to infer its type params from, so the instantiation is taken from
// the mangled destination `dest`, at the position the function's declared
// result puts Self (assoc_ctor_concrete); the matching method clone is
// `<concrete>.<method>`. The generic-struct guard keeps a plain `mod.func()`
// untouched. Other inits pass through.
function retype_assoc_ctor(init: ast.Expr, dest: string, gstructs: StructDecl[], funcs: MFns): ast.Expr {
  match (init) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          match (fa.obj) {
            ast.ExprIdent(oid) => {
              if (gstruct_index(gstructs, oid.name) >= 0) {
                let concrete: string = assoc_ctor_concrete(oid.name, fa.field, dest, funcs);
                let pfx: string = oid.name + "__";
                if (concrete.len() > pfx.len() && util.str_has_prefix(concrete, pfx)) {
                  return ast.ExprCall { callee: ast.ExprFieldAccess { obj: ast.ExprIdent { name: concrete, line: oid.line, col: oid.col, ty: "" }, field: fa.field, line: fa.line, col: fa.col, ty: fa.ty }, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
                }
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return init;
}

// assoc_ctor_concrete is the struct clone a receiver-less associated call
// `base.method()` builds when its result lands in `dest`: `dest` itself when
// the call answers Self, else what sits in Self's place in the declared
// result, so `Result[Box, string]` against `Result[Box__i32, string]` is
// `Box__i32`.
function assoc_ctor_concrete(base: string, method: string, dest: string, funcs: MFns): string {
  let ret: string = "";
  for fd in funcs.decls {
    if (fd.name == method && fd.receiver_name.len() == 0 && strip_struct_base(fd.receiver_type) == base) {
      ret = fd.ret_type;
    }
  }
  if (ret.len() == 0 || strip_struct_base(ret) == base) {
    return dest;
  }
  let binds: MEnv = bind_unify(drop_type_args(ret, base), dest, [base], MEnv { mnames: [], mtypes: [] }, funcs);
  return binds.elook(base);
}

// drop_type_args respells every `name[...]` in a type string as a bare
// `name`.
function drop_type_args(ty: string, name: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < ty.len()) {
    let at_name: boolean = i + name.len() <= ty.len() && slice_unchecked(ty, i, i + name.len()) == name
      && (i == 0 || !ident_byte(ty[i - 1] as i32));
    if (at_name && i + name.len() < ty.len() && ty[i + name.len()] == b'[') {
      out = out + name;
      let depth: i32 = 0;
      let j: i32 = i + name.len();
      while (j < ty.len()) {
        if (ty[j] == b'[') {
          depth = depth + 1;
        } else if (ty[j] == b']') {
          depth = depth - 1;
          if (depth == 0) {
            break;
          }
        }
        j = j + 1;
      }
      i = j + 1;
    } else {
      out = out + slice_unchecked(ty, i, i + 1);
      i = i + 1;
    }
  }
  return out;
}

// ms_var_ty is the type a `let` binds in the monomorphiser's env, so a later
// literal can infer its own type arguments from the local's fields: its
// annotation, else the instantiation its generic struct literal was given, else
// the concrete type any other init produces (a call returning `P[string]` or
// `Result[P[string], string]`).
function ms_var_ty(ann: string, init: ast.Expr, ninit: ast.Expr, env: MEnv, gstructs: StructDecl[], funcs: MFns): string {
  if (ann.len() > 0) {
    return ann;
  }
  match (init) {
    ast.ExprStructLit(sl) => {
      if (gstruct_index(gstructs, sl.type_name) < 0) {
        return "";
      }
      match (ninit) {
        ast.ExprStructLit(nsl) => {
          // A literal whose key could not be inferred keeps the bare generic
          // name, which is a type variable's spelling rather than a type.
          if (nsl.type_name != sl.type_name) {
            return nsl.type_name;
          }
        },
        _ => {}
      }
      return "";
    },
    _ => {}
  }
  // A bare number literal's width is still open (the checker settles it at
  // a later use), so it binds nothing here.
  if (number_literal_tree(init)) {
    return "";
  }
  let t: string = mono_infer(ninit, env, funcs);
  // A variant construction (`Some(x)`, a generic enum's `Leaf(x)`) names no
  // declaration mono_infer can read a type from.
  if (t.len() == 0) {
    if let ast.ExprCall(sc) = ninit {
      let scn: string = "";
      match (sc.callee) {
        ast.ExprIdent(sid) => {
          scn = sid.name;
        },
        ast.ExprFieldAccess(sfa) => {
          scn = sfa.field;
        },
        _ => {}
      }
      if (sc.args.len() == 1 && scn == "Some") {
        let pt: string = mono_infer(sc.args[0], env, funcs);
        if (pt.len() > 0 && !number_literal_tree(sc.args[0])) {
          t = "Option[" + pt + "]";
        }
      } else if (!any_number_literal(sc.args)) {
        t = variant_ctor_spelling(sc.callee, sc.args, env, funcs);
      }
    }
  }
  if (ms_concrete_ty(t, gstructs, funcs)) {
    return t;
  }
  return "";
}

function any_number_literal(es: ast.Expr[]): boolean {
  let i: i32 = 0;
  while (i < es.len()) {
    if (number_literal_tree(es[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// ms_concrete_ty: `t` names a type with no type variable in it and no generic
// struct left uninstantiated — a bare `P` is a type variable's spelling.
function ms_concrete_ty(t: string, gstructs: StructDecl[], funcs: MFns): boolean {
  if (t.len() == 0 || mono_ty_mentions_var(t)) {
    return false;
  }
  let i: i32 = 0;
  let n: i32 = t.len();
  while (i < n) {
    if (tv_word_char(t[i] as i32)) {
      let start: i32 = i;
      while (i < n && tv_word_char(t[i] as i32)) {
        i = i + 1;
      }
      let tok: string = slice_unchecked(t, start, i) + "";
      if (gstruct_index(gstructs, tok) >= 0 && (i >= n || t[i] != b'[')) {
        return false;
      }
    } else {
      i = i + 1;
    }
  }
  return true;
}

// ms_elem_ty: the element type an array of type `t` binds a `for` variable
// to, when it is concrete (ms_concrete_ty); "" otherwise.
function ms_elem_ty(t: string, gstructs: StructDecl[], funcs: MFns): string {
  if (!type_ends_arr(t)) {
    return "";
  }
  let el: string = elem_spelling(t);
  if (ms_concrete_ty(el, gstructs, funcs)) {
    return el;
  }
  return "";
}

// ms_stmt rewrites one statement: generic-struct annotations on a `let`
// go through mg_ty, struct literals through ms_expr, threading env+ins.
function ms_stmt(st: ast.Stmt, env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts, ret_ty: string): RStmtOne {
  match (st) {
    ast.StmtVar(v) => {
      let ta: TyIns = mg_ty(v.type_name, gstructs, ins);
      let iv: RExpr = ms_expr_to(v.init, ta.ty, env, gstructs, funcs, ta.mins);
      // A receiver-less associated constructor `Box.default()` bound to a
      // generic-struct annotation takes its instantiation from that
      // annotation: rewrite it to `Box__Inner.default()`.
      let ninit: ast.Expr = retype_assoc_ctor(iv.rexpr, ta.ty, gstructs, funcs);
      let vr: TyIns = mg_ty(v.fn_ret, gstructs, iv.rins);
      let vl: TyIns = mg_ty_list(v.fn_param_types, gstructs, vr.mins);
      return RStmtOne { rstmt: ast.StmtVar { name: v.name, type_name: ta.ty, init: ninit, line: v.line, col: v.col, fn_ret: vr.ty, fn_param_types: vl.ty }, renv: env.ebind(v.name, ms_var_ty(ta.ty, v.init, ninit, env, gstructs, funcs)), rins2: vl.mins };
    },
    ast.StmtReturn(r) => {
      let rv: RExpr = ms_expr_to(r.value, ret_ty, env, gstructs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtReturn { value: retype_assoc_ctor(rv.rexpr, ret_ty, gstructs, funcs), line: r.line, col: r.col }, renv: env, rins2: rv.rins };
    },
    ast.StmtExpr(x) => {
      let xv: RExpr = ms_expr(x.value, env, gstructs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtExpr { value: xv.rexpr, line: 0 }, renv: env, rins2: xv.rins };
    },
    ast.StmtAssign(a) => {
      let av: RExpr = ms_expr(a.value, env, gstructs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtAssign { target: a.target, value: av.rexpr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, renv: env, rins2: av.rins };
    },
    ast.StmtIf(f) => {
      let cv: RExpr = ms_expr(f.cond, env, gstructs, funcs, ins);
      let tb: RStmts = ms_stmts(f.then_body, env, gstructs, funcs, cv.rins, ret_ty);
      let eb: RStmts = ms_stmts(f.else_body, env, gstructs, funcs, tb.rins3, ret_ty);
      return RStmtOne { rstmt: ast.StmtIf { cond: cv.rexpr, then_body: tb.rstmts, else_body: eb.rstmts, line: 0, else_chained: false, sugar: no_match_sugar(), origin: "" }, renv: env, rins2: eb.rins3 };
    },
    ast.StmtWhile(w) => {
      let cv: RExpr = ms_expr(w.cond, env, gstructs, funcs, ins);
      let wb: RStmts = ms_stmts(w.body, env, gstructs, funcs, cv.rins, ret_ty);
      return RStmtOne { rstmt: ast.StmtWhile { cond: cv.rexpr, body: wb.rstmts, label: w.label, line: w.line, is_loop: w.is_loop }, renv: env, rins2: wb.rins3 };
    },
    ast.StmtFor(fr) => {
      let it: RExpr = ms_expr(fr.iter, env, gstructs, funcs, ins);
      let benv: MEnv = env.ebind(fr.var_name, ms_elem_ty(mono_infer(it.rexpr, env, funcs), gstructs, funcs));
      let fb: RStmts = ms_stmts(fr.body, benv, gstructs, funcs, it.rins, ret_ty);
      return RStmtOne { rstmt: ast.StmtFor { var_name: fr.var_name, iter: it.rexpr, body: fb.rstmts, label: fr.label, line: fr.line }, renv: env, rins2: fb.rins3 };
    },
    ast.StmtMatch(m) => {
      let sv: RExpr = ms_expr(m.scrutinee, env, gstructs, funcs, ins);
      let arms: ast.MatchArm[] = [];
      let cur: Insts = sv.rins;
      let i: i32 = 0;
      let sty: string = mono_infer(sv.rexpr, env, funcs);
      while (i < m.arms.len()) {
        let ab: RStmts = ms_stmts(m.arms[i].body, mono_arm_env(env, m.arms[i].pattern, sty, funcs), gstructs, funcs, cur, ret_ty);
        cur = ab.rins3;
        arms = arms.append(ast.MatchArm { pattern: m.arms[i].pattern, body: ab.rstmts, line: m.arms[i].line, col: m.arms[i].col, guard: m.arms[i].guard, has_guard: m.arms[i].has_guard, alt_cont: false });
        i = i + 1;
      }
      return RStmtOne { rstmt: ast.StmtMatch { ...m, scrutinee: sv.rexpr, arms: arms }, renv: env, rins2: cur };
    },
    _ => {
      return RStmtOne { rstmt: st, renv: env, rins2: ins };
    }
  }
  return RStmtOne { rstmt: st, renv: env, rins2: ins };
}

// ms_stmts walks a statement list, threading the (block-local) env. `ret_ty`
// is the enclosing function's concrete (mangled) return type, used to retype a
// `return <generic struct literal>` whose instantiation the field values can't
// supply; "" at top-level / for non-struct returns (a no-op there).
function ms_stmts(stmts: ast.Stmt[], env: MEnv, gstructs: StructDecl[], funcs: MFns, ins: Insts, ret_ty: string): RStmts {
  let out: ast.Stmt[] = [];
  let e2: MEnv = env;
  let cur: Insts = ins;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let rs: RStmtOne = ms_stmt(stmts[i], e2, gstructs, funcs, cur, ret_ty);
    out = out.append(rs.rstmt);
    e2 = rs.renv;
    cur = rs.rins2;
    i = i + 1;
  }
  return RStmts { rstmts: out, rins3: cur };
}

// ms_func rewrites a non-generic function's param/return/receiver
// annotations and body, recording any generic-struct instantiation used.
function ms_func(fn: FuncDecl, gstructs: StructDecl[], funcs: MFns, ins: Insts): FRes {
  let cur: Insts = ins;
  let nparams: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < fn.params.len()) {
    let pt: TyIns = mg_ty(fn.params[i].type_name, gstructs, cur);
    cur = pt.mins;
    let pr: TyIns = mg_ty(fn.params[i].fn_ret, gstructs, cur);
    cur = pr.mins;
    let pl: TyIns = mg_ty_list(fn.params[i].fn_param_types, gstructs, cur);
    cur = pl.mins;
    nparams = nparams.append(ast.ParamDecl { ...fn.params[i], type_name: pt.ty, fn_ret: pr.ty, fn_param_types: pl.ty });
    i = i + 1;
  }
  let rt: TyIns = mg_ty(fn.ret_type, gstructs, cur);
  cur = rt.mins;
  let rfr: TyIns = mg_ty(fn.ret_fn_ret, gstructs, rt.mins);
  cur = rfr.mins;
  let rfl: TyIns = mg_ty_list(fn.ret_fn_param_types, gstructs, cur);
  cur = rfl.mins;
  let rcv: TyIns = mg_ty(fn.receiver_type, gstructs, cur);
  cur = rcv.mins;
  let br: RStmts = ms_stmts(fn.body, env_from_decl(fn), gstructs, funcs, cur, rt.ty);
  cur = br.rins3;
  return FRes {
    ffn: FuncDecl { ...fn, receiver_type: rcv.ty, params: nparams, ret_type: rt.ty, ret_fn_ret: rfr.ty, ret_fn_param_types: rfl.ty, body: br.rstmts },
    fins: cur,
  };
}

// clone_struct_method builds the per-instantiation clone of a generic
// struct's method (a @derive-synthesised one with a bare `Box` receiver,
// or a parametric-`impl` one with a `Box[T]` receiver + type params),
// substituting the type variables and re-pointing receiver/params/return
// at the mangled clone name. The body's `let T` annotations are
// substituted; its literal display strings (baked from the original
// struct's name at synth time) stay intact.
function clone_struct_method(m: FuncDecl, base: string, key: string, gstructs: StructDecl[], structs: StructDecl[], enums: EnumDecl[]): FuncDecl {
  // Substitute with the generic STRUCT's type params (not the method's, which
  // a synthesized method like default() leaves empty). The struct's params are
  // the ones a method body refers to — e.g. a derived default()'s
  // `T.default()`; subst_stmts rewrites both `let x: T` annotations and the
  // `T.default()` object. A parametric-impl method's own type params match the
  // struct's, so this is equivalent for those.
  let gsi: i32 = gstruct_index(gstructs, base);
  let tparams: string[] = m.type_params;
  if (gsi >= 0) {
    tparams = gstructs[gsi].type_params;
  }
  let cts: string[] = split_key(key, tparams.len(), structs, enums);
  let mang: string = base + "__" + sanitize_key(key);
  // finalize_impl_method (at parse time) bakes the BARE source struct name
  // into a generic impl method's `Self` positions, but the struct is
  // registered module-prefixed (`iter__ArrayIter`). Normalise the bare base
  // back to the prefixed `base` so to_concrete_struct_ty / mg_ty can mangle a
  // nested `Self` instantiation (`Option[(i32, ArrayIter[i32])]` ->
  // `Option[(i32, iter__ArrayIter__i32)]`) in the clone's return / params.
  let bsegs: string[] = split_dunder(base);
  let bare_base: string = bsegs[bsegs.len() - 1];
  let nparams: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < m.params.len()) {
    let psrc: string = replace_struct_ident(m.params[i].type_name, bare_base, base);
    let pt: string = to_concrete_struct_ty(subst_ty(psrc, tparams, cts), base, mang, gstructs);
    nparams = nparams.append(ast.ParamDecl { ...m.params[i], type_name: pt, fn_ret: to_concrete_struct_ty(subst_ty(m.params[i].fn_ret, tparams, cts), base, mang, gstructs), fn_param_types: to_concrete_struct_ty_list(subst_ty_list(m.params[i].fn_param_types, tparams, cts), base, mang, gstructs) });
    i = i + 1;
  }
  let rsrc: string = replace_struct_ident(m.ret_type, bare_base, base);
  let rt: string = to_concrete_struct_ty(subst_ty(rsrc, tparams, cts), base, mang, gstructs);
  let notp: string[] = [];
  return FuncDecl { ...m, receiver_type: mang, type_params: notp, all_type_params: [], params: nparams, ret_type: rt, ret_fn_ret: to_concrete_struct_ty(subst_ty(m.ret_fn_ret, tparams, cts), base, mang, gstructs), ret_fn_param_types: to_concrete_struct_ty_list(subst_ty_list(m.ret_fn_param_types, tparams, cts), base, mang, gstructs), body: retarget_self_lit_stmts(subst_stmts(m.body, tparams, cts), base, mang), bound_traits: [] };
}

// monomorphize_structs clones every generic struct (and its methods) per
// concrete instantiation, rewriting all references to the mangled name.
// See the section comment above. Runs after function monomorphisation so
// it also sees the concrete `Box[i32]` annotations those clones produce.
// A generic enum whose templates name a generic struct (`A(Box[U])`) is left
// as written, and so are the generic structs and bounded generics: only the
// enum pass knows `U`, and monomorphize_enum_structs instantiates what it
// substitutes.
pub function monomorphize_structs(mod: Module): Module {
  return ms_module(mod);
}

// monomorphize_enum_structs runs after monomorphize_enums: it clones the
// generic structs the enum clones name (`A__i32(Box[i32])`), and is a no-op
// when monomorphize_structs deferred nothing.
pub function monomorphize_enum_structs(mod: Module): Module {
  return ms_module(mod);
}

// The generic enums whose variant payloads or method signatures name a
// generic struct.
function ms_deferred_enums(mod: Module, gstructs: StructDecl[]): string[] {
  let out: string[] = [];
  for sd in mod.structs {
    if (sd.enum_owner.len() == 0 || genum_index(mod.enums, sd.enum_owner) < 0 || str_in(out, sd.enum_owner)) {
      continue;
    }
    if (mod.enums[genum_index(mod.enums, sd.enum_owner)].type_params.len() == 0) {
      continue;
    }
    for f in sd.fields {
      if (ms_names_gstruct(f.type_name, gstructs) || ms_names_gstruct(f.fn_ret, gstructs) || ms_names_gstruct(f.fn_param_types, gstructs)) {
        out = out.append(sd.enum_owner);
        break;
      }
    }
  }
  for fd in mod.funcs {
    let owner: string = strip_struct_base(fd.receiver_type);
    if (fd.receiver_type.len() == 0 || genum_index(mod.enums, owner) < 0 || str_in(out, owner)) {
      continue;
    }
    if (mod.enums[genum_index(mod.enums, owner)].type_params.len() == 0) {
      continue;
    }
    let names: boolean = ms_names_gstruct(fd.ret_type, gstructs) || ms_names_gstruct(fd.ret_fn_ret, gstructs);
    for p in fd.params {
      if (ms_names_gstruct(p.type_name, gstructs) || ms_names_gstruct(p.fn_ret, gstructs)) {
        names = true;
      }
    }
    if (names) {
      out = out.append(owner);
    }
  }
  return out;
}

function ms_names_gstruct(ty: string, gstructs: StructDecl[]): boolean {
  if (ty.len() == 0) {
    return false;
  }
  return mg_ty_list(ty, gstructs, Insts { inames: [], itypes: [], iargs: [] }).mins.inames.len() > 0;
}

// A deferred generic enum's variant struct or method.
function ms_deferred_owner(sd_owner: string, receiver_type: string, deferred: string[]): boolean {
  if (sd_owner.len() > 0) {
    return str_in(deferred, sd_owner);
  }
  return receiver_type.len() > 0 && str_in(deferred, strip_struct_base(receiver_type));
}

function struct_named(structs: StructDecl[], name: string): boolean {
  for sd in structs {
    if (sd.name == name) {
      return true;
    }
  }
  return false;
}

function ms_module(mod: Module): Module {
  let gstructs: StructDecl[] = [];
  let gi: i32 = 0;
  while (gi < mod.structs.len()) {
    if (mod.structs[gi].type_params.len() > 0) {
      gstructs = gstructs.append(mod.structs[gi]);
    }
    gi = gi + 1;
  }
  if (gstructs.len() == 0) {
    return Module { ...mod, funcs: drop_bg_templates(mod.funcs) };
  }
  // Retained enum templates still need the generic record schemas they name
  // after enum cloning. Concrete enum clones are processed normally below.
  let deferred: string[] = ms_deferred_enums(mod, gstructs);
  let keep: boolean = deferred.len() > 0;

  let ins: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let sfns: MFns = mfns_of(mod.funcs, mod.structs, mod.enums, mod.impls);

  // Phase 1: rewrite all references; drop the generic decls unless a
  // deferred enum's templates still name them.
  let nstructs: StructDecl[] = [];
  let si: i32 = 0;
  while (si < mod.structs.len()) {
    let sd: StructDecl = mod.structs[si];
    if (keep && (sd.type_params.len() > 0 || ms_deferred_owner(sd.enum_owner, "", deferred))) {
      nstructs = nstructs.append(sd);
    } else if (sd.type_params.len() == 0) {
      let nf: StructFieldDecl[] = [];
      let fj: i32 = 0;
      while (fj < sd.fields.len()) {
        let ft: TyIns = mg_ty(sd.fields[fj].type_name, gstructs, ins);
        let ffr: TyIns = mg_ty(sd.fields[fj].fn_ret, gstructs, ft.mins);
        let ffl: TyIns = mg_ty_list(sd.fields[fj].fn_param_types, gstructs, ffr.mins);
        ins = ffl.mins;
        nf = nf.append(StructFieldDecl { name: sd.fields[fj].name, type_name: ft.ty, fn_ret: ffr.ty, fn_param_types: ffl.ty });
        fj = fj + 1;
      }
      nstructs = nstructs.append(StructDecl { name: sd.name, fields: nf, type_params: [], derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume, variant_field_names: sd.variant_field_names, is_pub: sd.is_pub, is_package: false });
    }
    si = si + 1;
  }

  let nfuncs: FuncDecl[] = [];
  let fi2: i32 = 0;
  while (fi2 < mod.funcs.len()) {
    let fn: FuncDecl = mod.funcs[fi2];
    let rbase: string = strip_struct_base(fn.receiver_type);
    if (keep && (gstruct_index(gstructs, rbase) >= 0 || is_bg_template(fn) || ms_deferred_owner("", fn.receiver_type, deferred))) {
      nfuncs = nfuncs.append(fn);
    } else if (fn.receiver_type.len() > 0 && gstruct_index(gstructs, rbase) >= 0) {} else if (is_bg_template(fn)) {} else {
      // generic-struct method OR receiver-less associated fn (a derived
      // `default()`, receiver_name "") — dropped here, cloned in phase 2.
      // cloned on demand in phase 2; dropped.
      let fr: FRes = ms_func(fn, gstructs, sfns, ins);
      ins = fr.fins;
      nfuncs = nfuncs.append(fr.ffn);
    }
    fi2 = fi2 + 1;
  }

  let topenv: MEnv = MEnv { mnames: [], mtypes: [] };
  let tr: RStmts = ms_stmts(mod.top_stmts, topenv, gstructs, sfns, ins, "");
  ins = tr.rins3;

  // Phase 2: generate clones; a worklist covers clones whose own field
  // types / method bodies reference further instantiations. The same
  // worklist carries the bounded-generic instantiations a method clone's
  // body makes (`__om_insert(m.root, k, v)` under `OrdMap__i32__i32`):
  // those are cloned here from the templates monomorphize_module passed
  // through, and a clone's own annotations feed back struct instantiations.
  let done: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let wi: i32 = 0;
  while (wi < ins.inames.len()) {
    let base: string = ins.inames[wi];
    let key: string = ins.itypes[wi];
    if (done.ihas(base, key)) {
      wi = wi + 1;
      continue;
    }
    done = done.iadd(base, key);
    let idx: i32 = gstruct_index(gstructs, base);
    if (idx < 0) {
      let bgi: i32 = bg_find(sfns, base);
      if (bgi >= 0 && !has_func_named(mod.funcs, nfuncs, base + "__" + sanitize_key(key))) {
        let bcl: FuncDecl = clone_bg(sfns.decls[bgi], key, mod.impls);
        let bcr: RStmts = mono_stmts(bcl.body, env_from_params(bcl.params), sfns, ins, fn_tag_spelling(bcl.ret_type, bcl.ret_fn_ret, bcl.ret_fn_param_types));
        ins = bcr.rins3;
        let bfr: FRes = ms_func(FuncDecl { ...bcl, body: bcr.rstmts }, gstructs, sfns, ins);
        ins = bfr.fins;
        nfuncs = nfuncs.append(bfr.ffn);
      }
    }
    // monomorphize_structs already cloned what it saw.
    if (idx >= 0 && struct_named(mod.structs, base + "__" + sanitize_key(key))) {
      idx = 0 - 1;
    }
    if (idx >= 0) {
      let gd: StructDecl = gstructs[idx];
      let cts: string[] = split_key(key, gd.type_params.len(), mod.structs, mod.enums);
      let mang: string = base + "__" + sanitize_key(key);
      let cf: StructFieldDecl[] = [];
      let cfi: i32 = 0;
      while (cfi < gd.fields.len()) {
        let subbed: string = subst_ty(gd.fields[cfi].type_name, gd.type_params, cts);
        let ft2: TyIns = mg_ty(subbed, gstructs, ins);
        let gfr: TyIns = mg_ty(subst_ty(gd.fields[cfi].fn_ret, gd.type_params, cts), gstructs, ft2.mins);
        let gfl: TyIns = mg_ty_list(subst_ty_list(gd.fields[cfi].fn_param_types, gd.type_params, cts), gstructs, gfr.mins);
        ins = gfl.mins;
        cf = cf.append(StructFieldDecl { name: gd.fields[cfi].name, type_name: ft2.ty, fn_ret: gfr.ty, fn_param_types: gfl.ty });
        cfi = cfi + 1;
      }
      nstructs = nstructs.append(StructDecl { name: mang, fields: cf, type_params: [], derives: gd.derives, line: gd.line, col: gd.col, enum_owner: gd.enum_owner, must_consume: gd.must_consume, variant_field_names: gd.variant_field_names, is_pub: true, is_package: false });
      let mi: i32 = 0;
      while (mi < mod.funcs.len()) {
        let mm: FuncDecl = mod.funcs[mi];
        if (mm.receiver_type.len() > 0 && strip_struct_base(mm.receiver_type) == base) {
          let clm: FuncDecl = clone_struct_method(mm, base, key, gstructs, mod.structs, mod.enums);
          let menv: MEnv = env_from_decl(clm);
          let mr: RStmts = mono_stmts(clm.body, menv, sfns, ins, fn_tag_spelling(clm.ret_type, clm.ret_fn_ret, clm.ret_fn_param_types));
          ins = mr.rins3;
          let br2: RStmts = ms_stmts(mr.rstmts, menv, gstructs, sfns, ins, clm.ret_type);
          ins = br2.rins3;
          nfuncs = nfuncs.append(FuncDecl { ...clm, body: br2.rstmts });
        }
        mi = mi + 1;
      }
    }
    wi = wi + 1;
  }

  return Module { ...mod, funcs: nfuncs, structs: nstructs, top_stmts: tr.rstmts };
}

// ---- generic-enum monomorphisation ----------------------------------
// Clone each supported concrete enum instantiation (`Opt[i32]` becomes
// `Opt__i32` with `Sm__i32(i32)`), rewriting constructions, match patterns
// and annotations. Methods and derives get matching clones. A method's own
// type parameters have already been folded into a free generic by
// register_struct_method_generics. me_mono_enums excludes keys this pass
// cannot represent; those remain for typed lowering.
// Generic declarations, variants and methods remain as templates for partial
// inference. Each clone records its original type spelling so typed lowering
// can complete absent arguments using nominal identity and exact payload
// types, without interpreting a generated name as source type information.

// genum_index returns the index of the generic EnumDecl named `name`, or -1.
function genum_index(enums: EnumDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < enums.len()) {
    if (enums[i].name == name && enums[i].type_params.len() > 0) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// genum_owner_of_variant returns the index of the monomorphisable generic
// enum whose variant list contains `vname`, or -1. (Variant names are
// effectively global in the desugared struct table, so a bare `Sm`
// construction resolves to its enum this way.)
function genum_owner_of_variant(enums: EnumDecl[], vname: string): i32 {
  let i: i32 = 0;
  while (i < enums.len()) {
    if (enums[i].type_params.len() > 0) {
      let vn: string[] = enums[i].variant_names;
      let j: i32 = 0;
      while (j < vn.len()) {
        if (vn[j] == vname) {
          return i;
        }
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

// is_simple_key reports whether an instantiation key is a `__`-join of
// simple nominal tokens (no `[`, no space) — the in-scope shape. A
// composite key (`Box[i32]`, a tuple) is rejected so the instantiation
// is left un-monomorphised rather than producing a malformed symbol.
function is_simple_key(key: string): boolean {
  if (key.len() == 0) {
    return false;
  }
  if (util.contains(key, "[")) {
    return false;
  }
  if (util.contains(key, " ")) {
    return false;
  }
  if (util.contains(key, "(")) {
    return false;
  }
  return true;
}

// genum_single_arg returns the single top-level type argument of a
// `Base[arg]` spelling (the in-scope nested shape has exactly one), or "".
function genum_single_arg(ty: string): string {
  let lb: i32 = first_bracket(ty);
  if (lb <= 0) {
    return "";
  }
  if (slice_unchecked(ty, ty.len() - 1, ty.len()) != "]") {
    return "";
  }
  let parts: string[] = split_top_commas(slice_unchecked(ty, lb + 1, ty.len() - 1));
  if (parts.len() != 1) {
    return "";
  }
  return parts[0];
}

// genum_key_from_anno extracts the instantiation key from a type spelling
// `Base[arg, …]` when Base == base, else "". A single-type-param enum may
// take a NESTED generic-enum arg (`Opt[Opt[i32]]` → key `Opt__i32`), keyed
// recursively via ge_targ_mangle; a multi-param enum keeps the pre-existing
// scope — every arg must be a simple nominal, since the `__` join is
// ambiguous once an arg is itself composite.
function genum_key_from_anno(ty: string, base: string, enums: EnumDecl[]): string {
  let lb: i32 = first_bracket(ty);
  if (lb <= 0) {
    return "";
  }
  if (slice_unchecked(ty, ty.len() - 1, ty.len()) != "]") {
    return "";
  }
  if (slice_unchecked(ty, 0, lb) != base) {
    return "";
  }
  let parts: string[] = split_top_commas(slice_unchecked(ty, lb + 1, ty.len() - 1));
  // The clone loop zips this key against the enum's DECLARED type parameters,
  // so a spelling that supplies a different number of arguments would index
  // past the key's pieces and abort. Refusing here means no instantiation is
  // recorded, so clone/subst never see a short key — the enum half of native's
  // `len(args) != len(gen.TypeParams)` gate in internal/oracle/monomorph.
  let gei: i32 = genum_index(enums, base);
  if (gei >= 0 && parts.len() != enums[gei].type_params.len()) {
    return "";
  }
  // `Opt[T]` inside a template names no instantiation.
  for p in parts {
    if (mono_ty_mentions_var(p)) {
      return "";
    }
  }
  if (parts.len() == 1) {
    return ge_targ_mangle(parts[0], enums);
  }
  let key: string = "";
  let j: i32 = 0;
  while (j < parts.len()) {
    if (j > 0) {
      key = key + "__";
    }
    let p: string = parts[j];
    if (first_bracket(p) >= 0) {
      return "";
    }
    if (util.contains(p, " ")) {
      return "";
    }
    if (util.contains(p, "(")) {
      return "";
    }
    key = key + p;
    j = j + 1;
  }
  return key;
}

// GEInst describes a recognised generic-enum instantiation derived from a
// type spelling: ok, the base enum name, the `__`-joined key, and the
// mangled enum name `Base__key`.
struct GEInst { ok: boolean, base: string, key: string, mang: string }

// ge_inst_of recognises a type spelling as a monomorphisable generic-enum
// instantiation (`Opt[i32]` → ok, base "Opt", key "i32", mang "Opt__i32").
// A bare base / non-generic / composite-key spelling yields ok=false.
function ge_inst_of(ty: string, enums: EnumDecl[]): GEInst {
  let lb: i32 = first_bracket(ty);
  if (lb <= 0) {
    return GEInst { ok: false, base: "", key: "", mang: "" };
  }
  if (slice_unchecked(ty, ty.len() - 1, ty.len()) != "]") {
    return GEInst { ok: false, base: "", key: "", mang: "" };
  }
  let base: str = slice_unchecked(ty, 0, lb);
  if (genum_index(enums, base) < 0) {
    return GEInst { ok: false, base: "", key: "", mang: "" };
  }
  let key: string = genum_key_from_anno(ty, base, enums);
  if (key.len() == 0) {
    return GEInst { ok: false, base: "", key: "", mang: "" };
  }
  return GEInst { ok: true, base: base + "", key: key, mang: base + "__" + key };
}

// fn_key_sanitize maps a fn type spelling into a token safe to embed in a `__`
// symbol name — every char outside [A-Za-z0-9_] becomes '_'. Mirrors native's
// `sanitize` (internal/oracle/monomorph/monomorph.go) so a fn type argument
// (`(i32) => i32`) keys to `_i32_____i32` instead of dragging its parens /
// spaces / `=>` into an unassemblable symbol. (The sibling `sanitize_key`
// above handles only bracket/comma keys and is shared with fn/struct mangling,
// so a fn-only transform stays out of its reach.)
function fn_key_sanitize(s: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    let alnum: boolean = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95;
    if (alnum) {
      out = out + slice_unchecked(s, i, i + 1);
    } else {
      out = out + "_";
    }
    i = i + 1;
  }
  return out;
}

// pk_is_fn_spelling reports whether `t` is a single-parameter-list function
// type spelling — `(...) => R` with no depth-1 comma (a top-level comma is a
// tuple, not a param list).
// Lets ge_targ_mangle admit a fn type arg as a
// (sanitised) monomorphisation key.
function pk_is_fn_spelling(t: string): boolean {
  let n: i32 = t.len();
  if (n < 5) {
    return false;
  }
  if (t[0] != b'(') {
    return false;
  }
  let depth: i32 = 0;
  let i: i32 = 0;
  let close: i32 = 0 - 1;
  while (i < n) {
    let ch: i32 = t[i] as i32;
    if (ch == 40 || ch == 91) {
      depth = depth + 1;
    } else if (ch == 41 || ch == 93) {
      depth = depth - 1;
      if (depth == 0 && ch == 41) {
        close = i;
        i = n;
      }
    } else if (ch == 44 && depth == 1) {
      return false;
    }
    i = i + 1;
  }
  if (close < 0) {
    return false;
  }
  let j: i32 = close + 1;
  while (j < n && t[j] == b' ') {
    j = j + 1;
  }
  if (j + 1 >= n) {
    return false;
  }
  return t[j] == b'=' && t[j + 1] == b'>';
}

// fn_spelling_ret returns the result-type spelling of a fn type
// (`(i32) => Opt[i32]` → `Opt[i32]`), or "" when `t` is not a fn spelling. The
// coarsening below stores it on a variant fn field's fn_ret, matching how the
// parser records a source-written fn field (type_name "fn" + fn_ret).
function fn_spelling_ret(t: string): string {
  if (!pk_is_fn_spelling(t)) {
    return "";
  }
  let n: i32 = t.len();
  let depth: i32 = 0;
  let i: i32 = 0;
  let close: i32 = 0 - 1;
  while (i < n) {
    let ch: i32 = t[i] as i32;
    if (ch == 40 || ch == 91) {
      depth = depth + 1;
    } else if (ch == 41 || ch == 93) {
      depth = depth - 1;
      if (depth == 0 && ch == 41) {
        close = i;
        i = n;
      }
    }
    i = i + 1;
  }
  let j: i32 = close + 1;
  while (j < n && t[j] == b' ') {
    j = j + 1;
  }
  j = j + 2;  // skip "=>"
  while (j < n && t[j] == b' ') {
    j = j + 1;
  }
  return slice_unchecked(t, j, n) + "";
}

// ge_targ_mangle mangles ONE generic-enum type argument to its `__` symbol
// form: a simple nominal (`i32`, `string`, a bare struct `P`) passes through;
// a NESTED monomorphisable generic-enum arg (`Opt[i32]`) recurses to its
// mangled clone name (`Opt__i32`); a fn type (`(i32) => i32`) sanitises to a
// symbol-safe token (native parity), a tuple to native's `tup_…` name, and an
// array to its element's name suffixed `_arr` (`u8[]` → `u8_arr`).
// Returns "" for an arg this pass still can't key (a generic struct, a
// non-generic enum, or a tuple holding one), so the enclosing instantiation
// bails cleanly.
function ge_targ_mangle(arg: string, enums: EnumDecl[]): string {
  if (arg.len() == 0) {
    return "";
  }
  if (pk_is_fn_spelling(arg)) {
    return fn_key_sanitize(arg);
  }
  if (type_ends_arr(arg)) {
    let elem: string = ge_targ_mangle(slice_unchecked(arg, 0, arg.len() - 2) + "", enums);
    if (elem.len() == 0) {
      return "";
    }
    return elem + "_arr";
  }
  if (arg[0] == b'(') {
    return ge_tuple_mangle(arg);
  }
  let lb: i32 = first_bracket(arg);
  if (lb < 0) {
    if (util.contains(arg, " ")) {
      return "";
    }
    if (util.contains(arg, "(")) {
      return "";
    }
    return arg;
  }
  let gi: GEInst = ge_inst_of(arg, enums);
  if (gi.ok) {
    return gi.mang;
  }
  return "";
}

// keyed_by_mangle: a spelling whose key is a mangled token rather than the
// spelling itself (a fn type, a tuple or an array), so a clone's field types
// must read the spelling back.
function keyed_by_mangle(t: string): boolean {
  return t.len() > 0 && (t[0] == b'(' || type_ends_arr(t));
}

// ge_tuple_mangle names a tuple type argument as native's mangleArg does:
// `tup`, then each element after a `_`, an array element suffixed `_arr`.
// Only nominal elements, arrays and tuples of them are named. A tuple holding
// a generic enum gets no name, so the enclosing instantiation bails; the enum
// inside it is still collected and rewritten through the tuple's elements.
function ge_tuple_mangle(arg: string): string {
  if (arg.len() < 2 || arg[0] != b'(' || arg[arg.len() - 1] != b')') {
    return "";
  }
  let parts: string[] = split_top_commas(slice_unchecked(arg, 1, arg.len() - 1));
  if (parts.len() < 2) {
    return "";
  }
  let out: string = "tup";
  for p in parts {
    let m: string = ge_tuple_elem_mangle(p);
    if (m.len() == 0) {
      return "";
    }
    out = out + "_" + m;
  }
  return out;
}

function ge_tuple_elem_mangle(e: string): string {
  if (type_ends_arr(e)) {
    let m: string = ge_tuple_elem_mangle(slice_unchecked(e, 0, e.len() - 2) + "");
    if (m.len() == 0) {
      return "";
    }
    return m + "_arr";
  }
  if (e.len() > 0 && e[0] == b'(') {
    return ge_tuple_mangle(e);
  }
  if (e.len() == 0 || first_bracket(e) >= 0 || util.contains(e, " ")) {
    return "";
  }
  return e;
}

// A type reference's own spelling, without its array suffixes or `own` mode:
// what names a generic-enum instantiation at that level.
function me_ref_spelling(t: TypeRef): string {
  return spelling_without_own(render_type_ref(TypeRef { ...t, array_depth: 0 }));
}

// me_rewrite_ty rewrites every generic-enum instantiation a type spelling
// names, at any depth — an array or tuple element, a function's parameter or
// result, a generic argument — to its mangled clone name (`(Opt[i32], i32)` →
// `(Opt__i32, i32)`). A spelling that names none is returned as written.
function me_rewrite_ty(ty: string, enums: EnumDecl[]): string {
  if (ty.len() == 0) {
    return ty;
  }
  let t: TypeRef = parse_type_ref(ty);
  let out: string = render_type_ref(me_rewrite_ref(t, enums));
  if (out == render_type_ref(t)) {
    return ty;
  }
  return out;
}

function me_rewrite_ref(t: TypeRef, enums: EnumDecl[]): TypeRef {
  let gi: GEInst = ge_inst_of(me_ref_spelling(t), enums);
  if (gi.ok) {
    let base: string = gi.mang;
    if (spelling_is_own(t.base)) {
      base = "own " + base;
    }
    return TypeRef { base: base, args: [], array_depth: t.array_depth, is_tuple: false, is_fn: false, is_view: false };
  }
  let args: TypeRef[] = [];
  for a in t.args {
    args = args.append(me_rewrite_ref(a, enums));
  }
  return TypeRef { ...t, args: args };
}

// A function type's parameter sidecar, comma-separated.
function me_rewrite_list(list: string, enums: EnumDecl[]): string {
  if (list.len() == 0) {
    return list;
  }
  let out: string = "";
  let changed: boolean = false;
  for seg in split_top_commas(list) {
    let r: string = me_rewrite_ty(seg, enums);
    if (r != seg) {
      changed = true;
    }
    if (out.len() > 0) {
      out = out + ", ";
    }
    out = out + r;
  }
  if (!changed) {
    return list;
  }
  return out;
}

// A declared slot's type and its function-type sidecars, rewritten.
struct MeSlot { ty: string, fn_ret: string, fn_params: string }

function me_rewrite_slot(ty: string, fn_ret: string, fn_params: string, enums: EnumDecl[]): MeSlot {
  return MeSlot { ty: me_rewrite_ty(ty, enums), fn_ret: me_rewrite_ty(fn_ret, enums), fn_params: me_rewrite_list(fn_params, enums) };
}

// me_collect_anno records every instantiation a type spelling names, at the
// depths me_rewrite_ty rewrites (`Opt[Opt[i32]]` enqueues both `Opt[Opt[i32]]`
// and the inner `Opt[i32]`), so every clone a rewritten spelling references
// gets generated in phase 2.
function me_collect_anno(ty: string, enums: EnumDecl[], ins: Insts): Insts {
  if (ty.len() == 0) {
    return ins;
  }
  return me_collect_ref(parse_type_ref(ty), enums, ins);
}

function me_collect_ref(t: TypeRef, enums: EnumDecl[], ins: Insts): Insts {
  let spelled: string = me_ref_spelling(t);
  let gi: GEInst = ge_inst_of(spelled, enums);
  let cur: Insts = ins;
  if (gi.ok) {
    cur = cur.iadd_arg(gi.base, gi.key, genum_single_arg(spelled));
  }
  for a in t.args {
    cur = me_collect_ref(a, enums, cur);
  }
  return cur;
}

function me_collect_slot(ty: string, fn_ret: string, fn_params: string, enums: EnumDecl[], ins: Insts): Insts {
  let cur: Insts = me_collect_anno(ty, enums, me_collect_anno(fn_ret, enums, ins));
  if (fn_params.len() == 0) {
    return cur;
  }
  for seg in split_top_commas(fn_params) {
    cur = me_collect_anno(seg, enums, cur);
  }
  return cur;
}

// variant_struct_index returns the index of the desugared variant struct
// named `vname` owned by enum `owner`, or -1.
function variant_struct_index(structs: StructDecl[], vname: string, owner: string): i32 {
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == vname && structs[i].enum_owner == owner) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// me_infer_variant_key infers the instantiation key for a variant
// construction `V(args)` of generic enum `ed`: first from the expected
// annotation (`let o: Opt[i32] = Sm(5)`), then from the payload argument
// types unified against the variant struct's field types (`Sm(5)` → T=i32).
// Returns "" (leave generic) if unresolved or composite.
function me_infer_variant_key(ed: EnumDecl, vname: string, args: ast.Expr[], expected: string, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: MFns): string {
  let fromAnno: string = genum_key_from_anno(expected, ed.name, enums);
  if (fromAnno.len() > 0) {
    return fromAnno;
  }
  if (variant_struct_index(structs, vname, ed.name) < 0) {
    return "";
  }
  let binds: MEnv = me_variant_binds(ed, vname, args, env, structs, funcs);
  let key: string = "";
  let j: i32 = 0;
  while (j < ed.type_params.len()) {
    let b: string = binds.elook(ed.type_params[j]);
    if (b.len() == 0) {
      return "";
    }
    if (j > 0) {
      key = key + "__";
    }
    key = key + b;
    j = j + 1;
  }
  // A single-param fn, tuple or array instantiation (`Has(f)` with f:
  // (i32) => i32, the binding carrying the full spelling): name it with the
  // token ge_targ_mangle produces for the annotated path, so the inferred
  // and annotated spellings of one instantiation share a clone (#5298
  // follow-up). The caller recovers the raw spelling for iargs from
  // me_variant_bound.
  if (ed.type_params.len() == 1 && keyed_by_mangle(key)) {
    return ge_targ_mangle(key, enums);
  }
  if (!is_simple_key(key)) {
    return "";
  }
  return key;
}

// The enum's type parameters bound by unifying each payload arg's inferred
// type against the variant's declared field type.
function me_variant_binds(ed: EnumDecl, vname: string, args: ast.Expr[], env: MEnv, structs: StructDecl[], funcs: MFns): MEnv {
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  let vidx: i32 = variant_struct_index(structs, vname, ed.name);
  if (vidx < 0) {
    return binds;
  }
  let fields: StructFieldDecl[] = structs[vidx].fields;
  let fi: i32 = 0;
  while (fi < fields.len() && fi < args.len()) {
    let at: string = mono_infer(args[fi], env, funcs);
    if (at.len() > 0) {
      binds = bind_unify(fields[fi].type_name, at, ed.type_params, binds, funcs);
    }
    fi = fi + 1;
  }
  return binds;
}

// struct_lit_spelling is a struct literal's type: a generic struct written
// bare has its parameters bound from the field values (`One { v: 7, .. }` is
// `One[i32]`), and stays bare while one is unbound.
function struct_lit_spelling(sl: ast.ExprStructLit, env: MEnv, funcs: MFns): string {
  let si: i32 = gstruct_index(funcs.structs, sl.type_name);
  if (si < 0 || funcs.structs[si].type_params.len() == 0 || funcs.structs[si].enum_owner.len() > 0) {
    return sl.type_name;
  }
  let sd: StructDecl = funcs.structs[si];
  let binds: MEnv = MEnv { mnames: [], mtypes: [] };
  let k: i32 = 0;
  while (k < sl.field_names.len() && k < sl.field_values.len()) {
    for f in sd.fields {
      if (f.name == sl.field_names[k]) {
        let at: string = mono_infer(sl.field_values[k], env, funcs);
        if (at.len() > 0) {
          binds = bind_unify(f.type_name, at, sd.type_params, binds, funcs);
        }
      }
    }
    k = k + 1;
  }
  let whole: string = bound_spelling(sd.name, sd.type_params, binds);
  if (whole.len() == 0) {
    return sl.type_name;
  }
  return whole;
}

// Candidate name for a bare or enum-qualified construction. Callers verify
// enum membership; bindings win over bare variants and a path's type head.
function ctor_variant_name(callee: ast.Expr, enums: EnumDecl[], env: MEnv, funcs: MFns): string {
  match (callee) {
    ast.ExprIdent(cid) => {
      if (str_list_contains(env.mnames, cid.name)) {
        return "";
      }
      if (genum_owner_of_variant(enums, cid.name) >= 0 || cid.name == "Some" || cid.name == "Ok" || cid.name == "Err") {
        if (fda_known_func(cid.name, funcs.decls)) {
          return "";
        }
      }
      return cid.name;
    },
    ast.ExprFieldAccess(cfa) => {
      if let ast.ExprIdent(oid) = cfa.obj {
        if (!str_list_contains(env.mnames, oid.name) && genum_index(enums, oid.name) >= 0) {
          return cfa.field;
        }
      }
    },
    _ => {}
  }
  return "";
}

// bound_spelling: `Name[a, b]` from bindings of every one of `tparams`; ""
// when any is unbound.
function bound_spelling(name: string, tparams: string[], binds: MEnv): string {
  let out: string = name + "[";
  let j: i32 = 0;
  while (j < tparams.len()) {
    let b: string = binds.elook(tparams[j]);
    if (b.len() == 0) {
      return "";
    }
    if (j > 0) {
      out = out + ", ";
    }
    out = out + b;
    j = j + 1;
  }
  return out + "]";
}

// variant_ctor_spelling: the `Enum[..]` type of a generic enum's variant
// construction `callee(args)`, its parameters bound from the payload types;
// "" when the callee is not a variant or a parameter stays unbound.
function variant_ctor_spelling(callee: ast.Expr, args: ast.Expr[], env: MEnv, funcs: MFns): string {
  let vname: string = ctor_variant_name(callee, funcs.enums, env, funcs);
  if (vname.len() == 0) {
    return "";
  }
  let owner: i32 = genum_owner_of_variant(funcs.enums, vname);
  if (owner < 0) {
    return "";
  }
  let ed: EnumDecl = funcs.enums[owner];
  return bound_spelling(ed.name, ed.type_params, me_variant_binds(ed, vname, args, env, funcs.structs, funcs));
}

// The spelling a single-param enum's inferred construction binds its type
// parameter to, from whichever field names it; "" for any other enum.
function me_variant_bound(ed: EnumDecl, vname: string, args: ast.Expr[], env: MEnv, structs: StructDecl[], funcs: MFns): string {
  if (ed.type_params.len() != 1) {
    return "";
  }
  return me_variant_binds(ed, vname, args, env, structs, funcs).elook(ed.type_params[0]);
}

// me_variant_field_expectations: the expected type of each payload arg of a
// resolved variant construction `V(args)` of enum `ed` — the variant's
// declared field types with the enum's params substituted by the
// instantiation's type arguments. Those come from the annotation's original
// spelling when it names the enum, else from the single-param arg spelling
// `carg`, else from the multi-param key, one piece per parameter. Empty
// when the arguments cannot be recovered (the args then carry no expectation,
// exactly as an unresolved construction).
function me_variant_field_expectations(ed: EnumDecl, vname: string, expected: string, key: string, carg: string, structs: StructDecl[], enums: EnumDecl[]): string[] {
  let none: string[] = [];
  let cts: string[] = type_args_of(expected);
  if (cts.len() != ed.type_params.len() || strip_struct_base(expected) != ed.name) {
    cts = [carg];
    if (ed.type_params.len() != 1) {
      cts = split_key(key, ed.type_params.len(), structs, enums);
    }
  }
  if (cts.len() != ed.type_params.len()) {
    return none;
  }
  let vidx: i32 = variant_struct_index(structs, vname, ed.name);
  if (vidx < 0) {
    return none;
  }
  let fields: StructFieldDecl[] = structs[vidx].fields;
  let out: string[] = [];
  let fi: i32 = 0;
  while (fi < fields.len()) {
    out = out.append(subst_ty(fields[fi].type_name, ed.type_params, cts));
    fi = fi + 1;
  }
  return out;
}

// me_env_from_params seeds an MEnv with a function's parameter types (the
// ORIGINAL spellings, so a `match` on a param recovers its `Opt[i32]`).
function me_env_from_params(params: ast.ParamDecl[]): MEnv {
  let e: MEnv = MEnv { mnames: [], mtypes: [] };
  let i: i32 = 0;
  while (i < params.len()) {
    let pt: string = params[i].type_name;
    // A fn-typed param coarsens to "fn" with its shape in the sidecars; bind
    // the callable spelling so me_scrutinee_type can recover a `match (f(x))`
    // scrutinee's generic-enum return type and rewrite its arms (mirrors the
    // me_bind_pat_vars fn-payload encoding). Otherwise the scrutinee typed ""
    // and the arms stayed un-mangled → wrong variant.
    if (pt == "fn" && params[i].fn_ret.len() > 0) {
      pt = fn_tag_spelling(pt, params[i].fn_ret, params[i].fn_param_types);
    }
    e = e.ebind(params[i].name, pt);
    i = i + 1;
  }
  return e;
}

// me_expr rewrites generic-enum variant constructions to their mangled
// clone names and recurses through every sub-expression. `expected` is the
// type the expression flows into (a let annotation / return type), used to
// pin a unit / ambiguous variant's instantiation; "" when unknown.
function me_expr(e: ast.Expr, expected: string, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: MFns, ins: Insts): RExpr {
  match (e) {
    ast.ExprBinary(b) => {
      let l: RExpr = me_expr(b.left, "", env, enums, structs, funcs, ins);
      let r: RExpr = me_expr(b.right, "", env, enums, structs, funcs, l.rins);
      return RExpr { rexpr: ast.ExprBinary { op: b.op, left: l.rexpr, right: r.rexpr, line: b.line, col: b.col, ty: b.ty }, rins: r.rins };
    },
    ast.ExprUnary(u) => {
      let o: RExpr = me_expr(u.operand, "", env, enums, structs, funcs, ins);
      return RExpr { rexpr: ast.ExprUnary { op: u.op, operand: o.rexpr, line: u.line, col: u.col, ty: u.ty }, rins: o.rins };
    },
    ast.ExprCall(c) => {
      // A variant construction `V(args)` (bare ident) or `Enum.V(args)`
      // (qualified). The qualified form is only a construction when the
      // object names a generic enum — otherwise `s.len()` (a method call,
      // structurally identical: ExprCall over ExprFieldAccess) would be
      // mis-read as constructing a variant named `len`.
      let vname: string = ctor_variant_name(c.callee, enums, env, funcs);
      // A variant construction whose instantiation resolves (from the
      // annotation or the payload args) flows each payload's DECLARED
      // field type, instantiated, into the corresponding arg — so a
      // nested payload-less variant (`Node(Leaf, k, v, Leaf, 1)` under
      // `Tree[K, V]`, `Sm(Nn)` under `Opt[Opt[i32]]`) is pinned even
      // though it has nothing of its own to infer from.
      let owner: i32 = 0 - 1;
      if (vname.len() > 0) {
        owner = genum_owner_of_variant(enums, vname);
      }
      let key: string = "";
      let carg: string = "";
      let fexps: string[] = [];
      if (owner >= 0) {
        key = me_infer_variant_key(enums[owner], vname, c.args, expected, env, enums, structs, funcs);
        if (key.len() > 0) {
          // The original single-arg spelling, for the clone's field
          // types. From the annotation when present; else for an
          // INFERRED mangled key (a fn or a tuple) the payload arg's
          // full spelling; else the key IS the arg spelling (a
          // nominal key).
          carg = genum_single_arg(expected);
          if (carg.len() == 0) {
            let bound: string = me_variant_bound(enums[owner], vname, c.args, env, structs, funcs);
            if (keyed_by_mangle(bound)) {
              carg = bound;
            }
          }
          if (carg.len() == 0) {
            carg = key;
          }
          fexps = me_variant_field_expectations(enums[owner], vname, expected, key, carg, structs, enums);
        }
      }
      // A plain function call `f(args)` — a callee ident that is NOT a
      // generic-enum variant construction — pins each bare unit-variant
      // argument from the callee's declared PARAMETER type (`get(Non)` with
      // `get(o: Opt[i32])` flows `Opt[i32]` into `Non`). This is the
      // call-site analogue of `let o: Opt[i32] = Non`; without it the bare
      // `Non` stayed un-rewritten, then monomorphize_enums dropped the
      // generic `Non` struct and the dangling reference bailed the module
      // (#5247).
      let calleeFn: string = "";
      if (owner < 0) {
        if let ast.ExprIdent(cid) = c.callee {
          if (!str_list_contains(env.mnames, cid.name)) {
            calleeFn = cid.name;
          }
        }
      }
      let nargs: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < c.args.len()) {
        let ae: string = "";
        if (i < fexps.len()) {
          ae = fexps[i];
        } else if (calleeFn.len() > 0) {
          ae = func_param_type_at(funcs.decls, calleeFn, i);
        }
        let ra: RExpr = me_expr(c.args[i], ae, env, enums, structs, funcs, cur);
        cur = ra.rins;
        nargs = nargs.append(ra.rexpr);
        i = i + 1;
      }
      if (key.len() > 0) {
        cur = cur.iadd_arg(enums[owner].name, key, carg);
        let mv: string = vname + "__" + key;
        return RExpr { rexpr: ast.ExprCall { callee: ast.ExprIdent { name: mv, line: c.line, col: c.col, ty: "" }, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: cur };
      }
      let rc: RExpr = me_expr(c.callee, "", env, enums, structs, funcs, cur);
      return RExpr { rexpr: ast.ExprCall { callee: rc.rexpr, args: nargs, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty }, rins: rc.rins };
    },
    ast.ExprIdent(id) => {
      // A bare unit-variant construction `Nn` — needs the expected
      // annotation to pin its instantiation (no payload to infer from).
      let owner: i32 = genum_owner_of_variant(enums, id.name);
      if (owner >= 0 && !str_list_contains(env.mnames, id.name) && !fda_known_func(id.name, funcs.decls)) {
        let key: string = genum_key_from_anno(expected, enums[owner].name, enums);
        if (key.len() > 0) {
          let nins: Insts = ins.iadd_arg(enums[owner].name, key, genum_single_arg(expected));
          return RExpr { rexpr: ast.ExprIdent { name: id.name + "__" + key, line: id.line, col: id.col, ty: id.ty }, rins: nins };
        }
      }
      return RExpr { rexpr: e, rins: ins };
    },
    ast.ExprArray(a) => {
      // An array literal flowing into `Opt[i32][]` propagates the ELEMENT
      // expected type (`Opt[i32]`) to each element, so a unit-variant
      // element (`Nn`, no payload to infer from) still pins its
      // instantiation. Strip one `[]` off the expected array type.
      let elexp: string = "";
      if (type_ends_arr(expected)) {
        elexp = slice_unchecked(expected, 0, expected.len() - 2) + "";
      }
      let nels: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < a.elements.len()) {
        let re: RExpr = me_expr(a.elements[i], elexp, env, enums, structs, funcs, cur);
        cur = re.rins;
        nels = nels.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprArray { ...a, elements: nels }, rins: cur };
    },
    ast.ExprTuple(t) => {
      let nels: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < t.elements.len()) {
        let re: RExpr = me_expr(t.elements[i], "", env, enums, structs, funcs, cur);
        cur = re.rins;
        nels = nels.append(re.rexpr);
        i = i + 1;
      }
      return RExpr { rexpr: ast.ExprTuple { elements: nels, line: t.line, col: t.col }, rins: cur };
    },
    ast.ExprIndex(ix) => {
      let ar: RExpr = me_expr(ix.array, "", env, enums, structs, funcs, ins);
      let ir: RExpr = me_expr(ix.index, "", env, enums, structs, funcs, ar.rins);
      // Carries `ty` for the same reason as mono_expr's ExprIndex arm.
      return RExpr { rexpr: ast.ExprIndex { array: ar.rexpr, index: ir.rexpr, unchecked: false, ty: ix.ty, line: ix.line, col: ix.col }, rins: ir.rins };
    },
    ast.ExprSlice(sl) => {
      let ar: RExpr = me_expr(sl.array, "", env, enums, structs, funcs, ins);
      let st: RExpr = me_expr(sl.start, "", env, enums, structs, funcs, ar.rins);
      let en: RExpr = me_expr(sl.end, "", env, enums, structs, funcs, st.rins);
      return RExpr { rexpr: ast.ExprSlice { ...sl, array: ar.rexpr, start: st.rexpr, end: en.rexpr }, rins: en.rins };
    },
    ast.ExprStructLit(s) => {
      let nvals: ast.Expr[] = [];
      let cur: Insts = ins;
      let i: i32 = 0;
      while (i < s.field_values.len()) {
        // Propagate the declared field type as the expected type so a
        // generic-enum field set to a unit / payload-less variant
        // (`S { o: Nn }` where `o: Opt[i32]`) pins its instantiation
        // from the field annotation rather than staying generic.
        let fexp: string = me_field_type_of(structs, s.type_name, s.field_names[i]);
        let rv: RExpr = me_expr(s.field_values[i], fexp, env, enums, structs, funcs, cur);
        cur = rv.rins;
        nvals = nvals.append(rv.rexpr);
        i = i + 1;
      }
      let rb: RExpr = me_expr(s.base, "", env, enums, structs, funcs, cur);
      return RExpr { rexpr: ast.ExprStructLit { type_name: s.type_name, field_names: s.field_names, field_values: nvals, has_base: s.has_base, base: rb.rexpr, line: s.line, col: s.col, written: s.written }, rins: rb.rins };
    },
    ast.ExprFieldAccess(fa) => {
      // A QUALIFIED unit-variant value `Enum.Variant` (no call) flowing
      // into a generic-enum type: pin its instantiation from `expected`
      // and rewrite to the mangled bare form, mirroring the bare-ident
      // arm — so `get(Opt.Non)` with `get(o: Opt[i32])` instantiates from
      // the callee's parameter type (flowed in as `expected`) instead of
      // staying generic and dangling once monomorphize_enums drops the
      // generic variant struct (#5247 follow-up; the bare `get(Non)` form
      // is pinned in the ExprIdent arm). The payloaded `Enum.Variant(args)`
      // form is a call, handled in the ExprCall arm above.
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          if (!str_list_contains(env.mnames, oid.name) && genum_index(enums, oid.name) >= 0) {
            let owner: i32 = genum_owner_of_variant(enums, fa.field);
            if (owner >= 0) {
              let key: string = genum_key_from_anno(expected, enums[owner].name, enums);
              if (key.len() > 0) {
                let nins: Insts = ins.iadd_arg(enums[owner].name, key, genum_single_arg(expected));
                return RExpr { rexpr: ast.ExprIdent { name: fa.field + "__" + key, line: fa.line, col: fa.col, ty: "" }, rins: nins };
              }
            }
          }
        },
        _ => {}
      }
      let ob: RExpr = me_expr(fa.obj, "", env, enums, structs, funcs, ins);
      return RExpr { rexpr: ast.ExprFieldAccess { obj: ob.rexpr, field: fa.field, line: fa.line, col: fa.col, ty: fa.ty }, rins: ob.rins };
    },
    ast.ExprLambda(lm) => {
      let lb: RStmts = me_stmts(lm.body, bind_params(env, lm.params), lm.ret_type, enums, structs, funcs, ins);
      let lins: Insts = me_collect_slot(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types, enums, lb.rins3);
      for lp in lm.params {
        lins = me_collect_slot(lp.type_name, lp.fn_ret, lp.fn_param_types, enums, lins);
      }
      let lret: MeSlot = me_rewrite_slot(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types, enums);
      function enum_clone(t: typeinfo.Type): string {
        if let typeinfo.TypeUnion(_) = t {
          let sp: string = typeinfo.spelling(t);
          let m: string = me_rewrite_ty(sp, enums);
          if (m != sp) {
            return m;
          }
        }
        return "";
      }
      let caps: ast.TypedBinding[] = [];
      for cap in lm.captures {
        lins = me_collect_anno(typeinfo.spelling(cap.ty), enums, lins);
        caps = caps.append(ast.TypedBinding { name: cap.name, ty: typeinfo.renamed_nominals(cap.ty, enum_clone) });
      }
      return RExpr { rexpr: ast.ExprLambda { ...lm, params: me_rewrite_params(lm.params, enums), ret_type: lret.ty, ret_fn_ret: lret.fn_ret, ret_fn_param_types: lret.fn_params, body: lb.rstmts, captures: caps }, rins: lins };
    },
    _ => {
      return RExpr { rexpr: e, rins: ins };
    }
  }
  return RExpr { rexpr: e, rins: ins };
}

// me_rewrite_match_arms rewrites each variant pattern of a `match` whose
// scrutinee is a known generic-enum instantiation (base, key) to the
// mangled clone variant (`Sm` → `Sm__i32`), leaving wildcards and
// non-owned variants untouched. Arm bodies are walked separately.
function me_rewrite_arm_pattern(pat: ast.Pattern, ed: EnumDecl, key: string): ast.Pattern {
  match (pat) {
    ast.PatVariant(pv) => {
      let simple: string = pv.type_name;
      let k: i32 = 0;
      while (k < pv.type_name.len()) {
        if (pv.type_name[k] == b'.') {
          simple = slice_unchecked(pv.type_name, k + 1, pv.type_name.len()) + "";
        }
        k = k + 1;
      }
      let vn: string[] = ed.variant_names;
      let j: i32 = 0;
      while (j < vn.len()) {
        if (vn[j] == simple) {
          return ast.PatVariant { ...pv, type_name: simple + "__" + key };
        }
        j = j + 1;
      }
      return pat;
    },
    _ => {
      return pat;
    }
  }
  return pat;
}

// me_field_type_of returns the declared type of field `fname` on the struct
// named `sname` (stripped of any generic args), or "".
function me_field_type_of(structs: StructDecl[], sname: string, fname: string): string {
  let base: string = strip_struct_base(sname);
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == base) {
      let fs: StructFieldDecl[] = structs[i].fields;
      let j: i32 = 0;
      while (j < fs.len()) {
        if (fs[j].name == fname) {
          return fs[j].type_name;
        }
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return "";
}

// me_field_spelling_of is me_field_type_of with a function-typed field's `fn`
// tag expanded from its sidecars, the spelling an expected-type position reads.
function me_field_spelling_of(structs: StructDecl[], sname: string, fname: string): string {
  let base: string = strip_struct_base(sname);
  for sd in structs {
    if (sd.name == base) {
      for f in sd.fields {
        if (f.name == fname) {
          return fn_tag_spelling(f.type_name, f.fn_ret, f.fn_param_types);
        }
      }
    }
  }
  return "";
}

// me_fn_ret_spelling returns the return-type spelling of an encoded fn-value
// binding (`fn => Fut[i32]` → `Fut[i32]`), or "" when `t` is not one. The
// binding is produced by me_bind_pat_vars for a fn-typed enum payload; splitting
// on the LAST ` => ` yields the final result type (#4722).
function me_fn_ret_spelling(t: string): string {
  let last: i32 = 0 - 1;
  let i: i32 = 0;
  while (i + 4 <= t.len()) {
    if (slice_unchecked(t, i, i + 4) == " => ") {
      last = i;
    }
    i = i + 1;
  }
  if (last < 0) {
    return "";
  }
  return slice_unchecked(t, last + 4, t.len()) + "";
}

// me_scrutinee_type recovers the (original-spelling) type of a match scrutinee
// or for-loop iterable, so its generic-enum instantiation can be read: an
// ident / param / for-loop var via the env, a call result via the callee's
// declared return type, an index `a[i]` via the array's element type, a struct
// literal via its type name, and a field access `s.o` via the field's declared
// type (so `match (s.o)` over a generic-enum-typed field rewrites its arms).
// "" when it can't be determined (the arms then stay un-rewritten).
// me_tuple_elem_type returns the element type spelling at position `field` (a
// numeric tuple index like "0" / "1") of a tuple type `ty` ("(T0, T1, …)"), or
// "" if `ty` isn't a tuple, `field` isn't numeric, or the index is out of
// range. The split is bracket/paren-depth aware so a nested generic / tuple
// element (`(Opt[i32], Map[i32, i32])`) isn't split at its inner commas. Lets
// me_scrutinee_type type a match scrutinee that is a tuple element
// (`match (t.0)`) over a generic-enum element so its arms rewrite.
function me_tuple_elem_type(ty: string, field: string): string {
  if (ty.len() < 2 || ty[0] != b'(') {
    return "";
  }
  if (field.len() == 0) {
    return "";
  }
  let idx: i32 = 0;
  let fi: i32 = 0;
  while (fi < field.len()) {
    if (field[fi] < b'0' || field[fi] > b'9') {
      return "";
    }
    idx = idx * 10 + (field[fi] as i32 - 48);
    fi = fi + 1;
  }
  let inner: string = slice_unchecked(ty, 1, ty.len() - 1) + "";
  let depth: i32 = 0;
  let start: i32 = 0;
  let cur: i32 = 0;
  let i: i32 = 0;
  while (i <= inner.len()) {
    if (i == inner.len() || inner[i] == b',' && depth == 0) {
      if (cur == idx) {
        let seg: string = slice_unchecked(inner, start, i) + "";
        let s2: i32 = 0;
        while (s2 < seg.len() && seg[s2] == b' ') {
          s2 = s2 + 1;
        }
        return slice_unchecked(seg, s2, seg.len()) + "";
      }
      cur = cur + 1;
      start = i + 1;
    } else {
      if (inner[i] == b'[' || inner[i] == b'(') {
        depth = depth + 1;
      }
      if (inner[i] == b']' || inner[i] == b')') {
        depth = depth - 1;
      }
    }
    i = i + 1;
  }
  return "";
}

function me_scrutinee_type(e: ast.Expr, env: MEnv, enums: EnumDecl[], structs: StructDecl[], funcs: MFns): string {
  match (e) {
    ast.ExprIdent(id) => {
      return env.elook(id.name);
    },
    ast.ExprStructLit(s) => {
      return s.type_name;
    },
    ast.ExprCall(c) => {
      // A variant construction (`match (Has(f))`, `let t = Tree.Leaf(s)`):
      // infer its instantiation from the payload args and return the
      // original-spelling type (`Opt[(i32) => i32]`, `Pair[string, i32]`),
      // so ge_inst_of derives the same key the construction rewrite used
      // and the arms rewrite to the mangled variants (#5298 follow-up).
      let vgn: string = ctor_variant_name(c.callee, enums, env, funcs);
      let vgo: i32 = 0 - 1;
      if (vgn.len() > 0) {
        vgo = genum_owner_of_variant(enums, vgn);
      }
      if (vgo >= 0 && me_infer_variant_key(enums[vgo], vgn, c.args, "", env, enums, structs, funcs).len() > 0) {
        return bound_spelling(enums[vgo].name, enums[vgo].type_params, me_variant_binds(enums[vgo], vgn, c.args, env, structs, funcs));
      }
      match (c.callee) {
        ast.ExprIdent(cid) => {
          // A match-bound fn payload (`cont`, bound by me_bind_pat_vars
          // to `fn => Fut[i32]`): calling it yields that return type, so
          // a nested `match (cont(tok))` over a recursive generic enum
          // recovers its instantiation and rewrites its arms (#4722).
          // Otherwise a top-level function's return type, its type
          // params bound from the arguments (`whole[C](c: C): C`).
          let fr: string = me_fn_ret_spelling(env.elook(cid.name));
          if (fr.len() > 0) {
            return fr;
          }
          let crt: string = call_ret_type(funcs, cid.name, c.args, env);
          if (crt.len() > 0) {
            return crt;
          }
          return func_ret_of(funcs.decls, cid.name);
        },
        ast.ExprFieldAccess(cfa) => {
          // A METHOD call `recv.method(args)` as the scrutinee: resolve
          // the receiver's type and return the method's declared return
          // type, so `match (s.find(k))` over a generic-enum-returning
          // method recovers its instantiation and rewrites its arms.
          // Without this the method scrutinee resolved "" (only a free
          // function's return was recovered), so the arms stayed
          // un-mangled against the concrete enum and the match read the
          // wrong variant.
          let rt: string = me_scrutinee_type(cfa.obj, env, enums, structs, funcs);
          if (rt.len() > 0) {
            let rbase: string = strip_struct_base(rt);
            let mi: i32 = 0;
            while (mi < funcs.decls.len()) {
              if (funcs.decls[mi].name == cfa.field && funcs.decls[mi].receiver_type.len() > 0
                && strip_struct_base(funcs.decls[mi].receiver_type) == rbase) {
                return funcs.decls[mi].ret_type;
              }
              mi = mi + 1;
            }
          }
          return "";
        },
        _ => {
          return "";
        }
      }
      return "";
    },
    ast.ExprIndex(ix) => {
      let at: string = me_scrutinee_type(ix.array, env, enums, structs, funcs);
      if (type_ends_arr(at)) {
        return slice_unchecked(at, 0, at.len() - 2) + "";
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      let ot: string = me_scrutinee_type(fa.obj, env, enums, structs, funcs);
      if (ot.len() == 0) {
        return "";
      }
      // A tuple-element access `t.N`: the element's type, so `match (t.0)`
      // over a generic-enum element recovers its instantiation. Falls
      // through to the struct-field lookup for a named field.
      let te: string = me_tuple_elem_type(ot, fa.field);
      if (te.len() > 0) {
        return te;
      }
      return me_field_type_of(structs, ot, fa.field);
    },
    _ => {
      return "";
    }
  }
  return "";
}

// me_bind_pat_vars binds a match arm's payload variable(s) to their concrete
// types in the arm-body env, so a nested match on a bound value recovers its
// instantiation. Each binding takes the matched variant's declared field type
// with the enum's params substituted by the scrutinee's concrete args (`cts`,
// original spellings, one per param): for `Opt[T] { Sm(T) }` the field is `T`
// → `cts[0]`, but for `E[U] { A(Opt[U]) }` the field is `Opt[U]` → `Opt[i32]`,
// so a nested `match (o)` sees the real `Opt[i32]` rather than a bare `i32`.
function me_bind_pat_vars(pat: ast.Pattern, ed: EnumDecl, cts: string[], structs: StructDecl[], env: MEnv): MEnv {
  match (pat) {
    ast.PatVariant(pv) => {
      let simple: string = pv.type_name;
      let k: i32 = 0;
      while (k < pv.type_name.len()) {
        if (pv.type_name[k] == b'.') {
          simple = slice_unchecked(pv.type_name, k + 1, pv.type_name.len()) + "";
        }
        k = k + 1;
      }
      let vidx: i32 = variant_struct_index(structs, simple, ed.name);
      if (vidx < 0) {
        return env;
      }
      let fs: StructFieldDecl[] = structs[vidx].fields;
      // Ordered payload variables: the primary binding, then extras.
      let names: string[] = [];
      if (pv.binding.len() > 0) {
        names = names.append(pv.binding);
      }
      let bi: i32 = 0;
      while (bi < pv.extra_bindings.len()) {
        if (pv.extra_bindings[bi].len() > 0) {
          names = names.append(pv.extra_bindings[bi]);
        }
        bi = bi + 1;
      }
      let e: MEnv = env;
      let ni: i32 = 0;
      while (ni < names.len() && ni < fs.len()) {
        // A fn-typed payload (`Pending(i32, (i32) => Future[T])`) binds
        // to an encoded fn spelling `fn => <ret>` carrying its
        // (substituted) return type, so me_scrutinee_type can recover a
        // nested `match (cont(tok))`'s enum instantiation and rewrite its
        // arms (#4722). A non-fn payload binds to its substituted type.
        if (fs[ni].type_name == "fn" && fs[ni].fn_ret.len() > 0) {
          e = e.ebind(names[ni], "fn => " + subst_ty(fs[ni].fn_ret, ed.type_params, cts));
        } else {
          e = e.ebind(names[ni], subst_ty(fs[ni].type_name, ed.type_params, cts));
        }
        ni = ni + 1;
      }
      return e;
    },
    _ => {
      return env;
    }
  }
  return env;
}

// me_stmt mirrors mono_stmt for the enum pass: it rewrites generic-enum
// annotations, variant constructions, and `match` arm patterns, threading
// the var-type env (original spellings) and the enclosing return type.
function me_stmt(st: ast.Stmt, env: MEnv, ret_ty: string, enums: EnumDecl[], structs: StructDecl[], funcs: MFns, ins: Insts): RStmtOne {
  match (st) {
    ast.StmtVar(v) => {
      let iv: RExpr = me_expr(v.init, v.type_name, env, enums, structs, funcs, ins);
      let cins: Insts = me_collect_slot(v.type_name, v.fn_ret, v.fn_param_types, enums, iv.rins);
      let nslot: MeSlot = me_rewrite_slot(v.type_name, v.fn_ret, v.fn_param_types, enums);
      // Track the var's type for a later `match`: the annotation if
      // present, else the init's recovered type (a call result, so
      // `let o = wrap(4); match (o)` resolves like `match (wrap(4))`).
      let vty: string = v.type_name;
      // A fn-typed local coarsens to "fn" (its return type is dropped
      // from the annotation); recover the FULL spelling from the init
      // lambda's declared params + return type ("(i32) => i32"), so
      // `match (f(x))` recovers a generic-enum return (me_fn_ret_spelling
      // splits on the LAST " => ", so the full spelling parses the same
      // as the old "fn => <ret>" encoding) AND a variant construction
      // `Has(f)` can infer + sanitise an fn instantiation key (#5298
      // follow-up — the coarse encoding was rejected by is_simple_key,
      // so the inline construct-and-match shape stayed generic and
      // SIGSEGV'd). Falls back to the old encoding when a param type is
      // unrecoverable.
      if (vty == "fn") {
        match (v.init) {
          ast.ExprLambda(lm) => {
            if (lm.ret_type.len() > 0) {
              let lfs: string = "";
              let lfok: boolean = true;
              let lfi: i32 = 0;
              while (lfi < lm.params.len()) {
                if (lm.params[lfi].type_name.len() == 0) {
                  lfok = false;
                }
                if (lfi > 0) {
                  lfs = lfs + ", ";
                }
                lfs = lfs + lm.params[lfi].type_name;
                lfi = lfi + 1;
              }
              if (lfok) {
                vty = "(" + lfs + ") => " + lm.ret_type;
              } else {
                vty = "fn => " + lm.ret_type;
              }
            }
          },
          _ => {}
        }
      }
      if (vty.len() == 0) {
        vty = me_scrutinee_type(v.init, env, enums, structs, funcs);
      }
      return RStmtOne { rstmt: ast.StmtVar { name: v.name, type_name: nslot.ty, init: iv.rexpr, line: v.line, col: v.col, fn_ret: nslot.fn_ret, fn_param_types: nslot.fn_params }, renv: env.ebind(v.name, vty), rins2: cins };
    },
    ast.StmtReturn(r) => {
      let rv: RExpr = me_expr(r.value, ret_ty, env, enums, structs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtReturn { value: rv.rexpr, line: r.line, col: r.col }, renv: env, rins2: rv.rins };
    },
    ast.StmtExpr(x) => {
      let xv: RExpr = me_expr(x.value, "", env, enums, structs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtExpr { value: xv.rexpr, line: 0 }, renv: env, rins2: xv.rins };
    },
    ast.StmtAssign(a) => {
      let av: RExpr = me_expr(a.value, env.elook(a.target), env, enums, structs, funcs, ins);
      return RStmtOne { rstmt: ast.StmtAssign { target: a.target, value: av.rexpr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }, renv: env, rins2: av.rins };
    },
    ast.StmtIf(f) => {
      let cv: RExpr = me_expr(f.cond, "", env, enums, structs, funcs, ins);
      let tb: RStmts = me_stmts(f.then_body, env, ret_ty, enums, structs, funcs, cv.rins);
      let eb: RStmts = me_stmts(f.else_body, env, ret_ty, enums, structs, funcs, tb.rins3);
      return RStmtOne { rstmt: ast.StmtIf { cond: cv.rexpr, then_body: tb.rstmts, else_body: eb.rstmts, line: 0, else_chained: false, sugar: no_match_sugar(), origin: "" }, renv: env, rins2: eb.rins3 };
    },
    ast.StmtWhile(w) => {
      let cv: RExpr = me_expr(w.cond, "", env, enums, structs, funcs, ins);
      let wb: RStmts = me_stmts(w.body, env, ret_ty, enums, structs, funcs, cv.rins);
      return RStmtOne { rstmt: ast.StmtWhile { cond: cv.rexpr, body: wb.rstmts, label: w.label, line: w.line, is_loop: w.is_loop }, renv: env, rins2: wb.rins3 };
    },
    ast.StmtFor(fr) => {
      let it: RExpr = me_expr(fr.iter, "", env, enums, structs, funcs, ins);
      // Bind the loop variable to the iterable's ELEMENT type so a `match`
      // in the body recovers a generic-enum element's instantiation
      // (`for o in xs` over `Opt[i32][]` → o: `Opt[i32]`). Strip one `[]`
      // off the iterable's tracked type.
      let itty: string = me_scrutinee_type(fr.iter, env, enums, structs, funcs);
      let elty: string = "";
      if (type_ends_arr(itty)) {
        elty = slice_unchecked(itty, 0, itty.len() - 2) + "";
      }
      let benv: MEnv = env.ebind(fr.var_name, elty);
      let fb: RStmts = me_stmts(fr.body, benv, ret_ty, enums, structs, funcs, it.rins);
      return RStmtOne { rstmt: ast.StmtFor { var_name: fr.var_name, iter: it.rexpr, body: fb.rstmts, label: fr.label, line: fr.line }, renv: env, rins2: fb.rins3 };
    },
    ast.StmtMatch(m) => {
      let sv: RExpr = me_expr(m.scrutinee, "", env, enums, structs, funcs, ins);
      let cur: Insts = sv.rins;
      // Recover the scrutinee's generic-enum instantiation: an annotated
      // ident / param / for-loop var, a call result (the callee's return
      // type), or an index into a generic-enum array.
      let sty: string = me_scrutinee_type(m.scrutinee, env, enums, structs, funcs);
      let gi: GEInst = ge_inst_of(sty, enums);
      let arms: ast.MatchArm[] = [];
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let npat: ast.Pattern = m.arms[i].pattern;
        // armenv binds this arm's payload variable(s) so a NESTED match
        // on the bound value recovers its instantiation: each binding
        // takes its declared field type under the scrutinee's
        // original-spelling type args (`Sm(n)` over `Opt[Opt[i32]]` →
        // n: `Opt[i32]`; `Bin(l, k, v, r, s)` over `OrdNode[i32,
        // string]` → l: `OrdNode[i32, string]`, k: i32, v: string).
        let armenv: MEnv = mono_arm_env(env, m.arms[i].pattern, sty, funcs);
        if (gi.ok) {
          let gidx: i32 = genum_index(enums, gi.base);
          if (gidx >= 0) {
            npat = me_rewrite_arm_pattern(m.arms[i].pattern, enums[gidx], gi.key);
            cur = cur.iadd_arg(gi.base, gi.key, genum_single_arg(sty));
            let cts: string[] = type_args_of(sty);
            if (cts.len() == enums[gidx].type_params.len()) {
              armenv = me_bind_pat_vars(m.arms[i].pattern, enums[gidx], cts, structs, armenv);
            }
          }
        }
        let gv: RExpr = me_expr(m.arms[i].guard, "", armenv, enums, structs, funcs, cur);
        cur = gv.rins;
        let ab: RStmts = me_stmts(m.arms[i].body, armenv, ret_ty, enums, structs, funcs, cur);
        cur = ab.rins3;
        arms = arms.append(ast.MatchArm { pattern: npat, body: ab.rstmts, line: m.arms[i].line, col: m.arms[i].col, guard: gv.rexpr, has_guard: m.arms[i].has_guard, alt_cont: false });
        i = i + 1;
      }
      return RStmtOne { rstmt: ast.StmtMatch { ...m, scrutinee: sv.rexpr, arms: arms }, renv: env, rins2: cur };
    },
    _ => {
      return RStmtOne { rstmt: st, renv: env, rins2: ins };
    }
  }
  return RStmtOne { rstmt: st, renv: env, rins2: ins };
}

// me_stmts walks a statement list, threading the block-local env.
function me_stmts(stmts: ast.Stmt[], env: MEnv, ret_ty: string, enums: EnumDecl[], structs: StructDecl[], funcs: MFns, ins: Insts): RStmts {
  let out: ast.Stmt[] = [];
  let e2: MEnv = env;
  let cur: Insts = ins;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let rs: RStmtOne = me_stmt(stmts[i], e2, ret_ty, enums, structs, funcs, cur);
    out = out.append(rs.rstmt);
    e2 = rs.renv;
    cur = rs.rins2;
    i = i + 1;
  }
  return RStmts { rstmts: out, rins3: cur };
}

// me_rewrite_params rewrites each parameter's generic-enum type annotation.
function me_rewrite_params(params: ast.ParamDecl[], enums: EnumDecl[]): ast.ParamDecl[] {
  let out: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < params.len()) {
    let p: ast.ParamDecl = params[i];
    let slot: MeSlot = me_rewrite_slot(p.type_name, p.fn_ret, p.fn_param_types, enums);
    out = out.append(ast.ParamDecl { ...p, type_name: slot.ty, fn_ret: slot.fn_ret, fn_param_types: slot.fn_params });
    i = i + 1;
  }
  return out;
}

// clone_enum_method builds the per-instantiation clone of a generic enum's
// method: the enum's type variables substituted with `cts`, the receiver
// re-pointed at the clone `mname`, and the body rewritten by me_stmts under
// an environment that types the receiver as the instantiation, so its
// variant constructions and match arms mangle to the clone's variants. The
// variables are the receiver's own spelling (`Opt[X]`) when it has one; a
// derived method's bare `Opt` receiver falls back to the declaration's, and
// the bare `Opt` a derived signature spells for its own enum reads as the
// instantiation.
function clone_enum_method(m: FuncDecl, ed: EnumDecl, cts: string[], mname: string, mod: Module, efns: MFns, ins: Insts): FRes {
  let tps: string[] = struct_receiver_typevars(m.receiver_type);
  if (tps.len() != cts.len()) {
    tps = ed.type_params;
  }
  let recv: string = ed.name + "[";
  let ci: i32 = 0;
  while (ci < cts.len()) {
    if (ci > 0) {
      recv = recv + ", ";
    }
    recv = recv + cts[ci];
    ci = ci + 1;
  }
  recv = recv + "]";
  let cur: Insts = ins;
  let nparams: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < m.params.len()) {
    let p: ast.ParamDecl = m.params[i];
    let pt: string = enum_self_ty(subst_ty(p.type_name, tps, cts), ed.name, recv);
    let pr: string = enum_self_ty(subst_ty(p.fn_ret, tps, cts), ed.name, recv);
    let pps: string = subst_ty_list(p.fn_param_types, tps, cts);
    cur = me_collect_slot(pt, pr, pps, mod.enums, cur);
    nparams = nparams.append(ast.ParamDecl { ...p, type_name: pt, fn_ret: pr, fn_param_types: pps });
    i = i + 1;
  }
  let rt: string = enum_self_ty(subst_ty(m.ret_type, tps, cts), ed.name, recv);
  cur = me_collect_anno(rt, mod.enums, cur);
  let rfr: string = enum_self_ty(subst_ty(m.ret_fn_ret, tps, cts), ed.name, recv);
  let rfps: string = subst_ty_list(m.ret_fn_param_types, tps, cts);
  cur = me_collect_slot("", rfr, rfps, mod.enums, cur);
  let env: MEnv = me_env_from_params(nparams);
  if (m.receiver_name.len() > 0) {
    env = env.ebind(m.receiver_name, recv);
  }
  let rb: RStmts = me_stmts(subst_stmts(m.body, tps, cts), env, rt, mod.enums, mod.structs, efns, cur);
  let notp: string[] = [];
  let fn: FuncDecl = FuncDecl {
    ...m, receiver_type: mname, type_params: notp, all_type_params: [], bound_traits: [],
    params: me_rewrite_params(nparams, mod.enums),
    ret_type: me_rewrite_ty(rt, mod.enums),
    ret_fn_ret: me_rewrite_ty(rfr, mod.enums),
    ret_fn_param_types: me_rewrite_list(rfps, mod.enums),
    body: rb.rstmts,
  };
  return FRes { ffn: fn, fins: rb.rins3 };
}

// enum_self_ty reads a bare `Opt` (or `Opt[]`) in a generic enum's own
// method signature as the instantiation `recv` being cloned.
function enum_self_ty(ty: string, name: string, recv: string): string {
  if (ty == name) {
    return recv;
  }
  if (ty == name + "[]") {
    return recv + "[]";
  }
  return ty;
}

// Derived methods spell their generic enum without arguments. Once retained
// beside concrete clones, that declaration must expose its variables as a
// template rather than offering an erased body as a concrete function.
function enum_method_template(m: FuncDecl, ed: EnumDecl): FuncDecl {
  if (m.receiver_type != ed.name || ed.type_params.len() == 0) {
    return m;
  }
  let recv: string = ed.name + "[" + subst_ty_join(ed.type_params, ",", [], []) + "]";
  let params: ast.ParamDecl[] = [];
  for p in m.params {
    params = params.append(ast.ParamDecl { ...p, type_name: enum_self_ty(p.type_name, ed.name, recv) });
  }
  return FuncDecl { ...m, receiver_type: recv, params: params, ret_type: enum_self_ty(m.ret_type, ed.name, recv), all_type_params: ed.type_params };
}

// The generic enums with a use the pass cannot key: a spelling `Opt[(Opt[i32],
// i32)]` whose argument has no clone name. Such an enum is left out of the
// pass entirely, declaration, variants and methods erased as before, because
// a clone beside the generic original is unsound on the AST lowering, which
// dispatches an enum's methods by name. A spelling that mentions a type
// variable (`List[T]` inside `enum List[T]`, `Opt[U]` inside `enum E[U]`, or
// one in an erased generic) belongs to a template, not a use: the template's
// instantiation keys it.
struct MeUses { enums: EnumDecl[], bases: string[] }

function me_use_spelling(ty: string, own u: MeUses): MeUses {
  if (ty.len() == 0) {
    return u;
  }
  return me_use_ref(parse_type_ref(ty), u);
}

function me_use_ref(r: TypeRef, own u: MeUses): MeUses {
  if (!r.is_tuple && !r.is_fn && r.args.len() > 0) {
    let t: string = me_ref_spelling(r);
    let base: string = slice_unchecked(t, 0, first_bracket(t)) + "";
    if (genum_index(u.enums, base) >= 0 && !str_in(u.bases, base) && !mono_ty_mentions_var(t) && genum_key_from_anno(t, base, u.enums).len() == 0) {
      u = MeUses { ...u, bases: u.bases.append(base) };
    }
  }
  for a in r.args {
    u = me_use_ref(a, u);
  }
  return u;
}

// A function type's parameter list rides beside the coarse `fn` tag as a
// comma-separated sidecar, each entry possibly `own`-prefixed.
function me_use_list(list: string, own u: MeUses): MeUses {
  if (list.len() == 0) {
    return u;
  }
  for seg in split_top_commas(list) {
    u = me_use_spelling(spelling_without_own(seg), u);
  }
  return u;
}

// A declared slot: its type, and the result and parameter sidecars of a
// function type.
function me_use_slot(ty: string, fn_ret: string, fn_params: string, own u: MeUses): MeUses {
  u = me_use_spelling(ty, u);
  u = me_use_spelling(fn_ret, u);
  return me_use_list(fn_params, u);
}

function me_use_stmt(st: ast.Stmt, own u: MeUses): MeUses {
  if let ast.StmtVar(v) = st {
    return me_use_slot(v.type_name, v.fn_ret, v.fn_param_types, u);
  }
  return u;
}

function me_use_expr(e: ast.Expr, own u: MeUses): MeUses {
  if let ast.ExprLambda(lm) = e {
    for p in lm.params {
      u = me_use_slot(p.type_name, p.fn_ret, p.fn_param_types, u);
    }
    return me_use_slot(lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types, u);
  }
  return u;
}

function me_unkeyable_bases(mod: Module): string[] {
  let u: MeUses = MeUses { enums: mod.enums, bases: [] };
  for fd in mod.funcs {
    for p in fd.params {
      u = me_use_slot(p.type_name, p.fn_ret, p.fn_param_types, u);
    }
    u = me_use_slot(fd.ret_type, fd.ret_fn_ret, fd.ret_fn_param_types, u);
    for st in fd.body {
      u = astwalk.fold_stmt_nodes(st, u, me_use_stmt, me_use_expr, astwalk.descend_all);
    }
  }
  for st in mod.top_stmts {
    u = astwalk.fold_stmt_nodes(st, u, me_use_stmt, me_use_expr, astwalk.descend_all);
  }
  for sd in mod.structs {
    for f in sd.fields {
      u = me_use_slot(f.type_name, f.fn_ret, f.fn_param_types, u);
    }
  }
  return u.bases;
}

// The enums the pass monomorphises: every generic one without an unkeyable
// use. A non-generic enum passes through untouched either way.
function me_mono_enums(mod: Module): EnumDecl[] {
  let unkeyable: string[] = me_unkeyable_bases(mod);
  let out: EnumDecl[] = [];
  for ed in mod.enums {
    if (!str_in(unkeyable, ed.name)) {
      out = out.append(ed);
    }
  }
  return out;
}

pub function monomorphize_enums(mod: Module): Module {
  // Nothing to do unless there is a monomorphisable generic enum.
  let menums: EnumDecl[] = me_mono_enums(mod);
  let any: boolean = false;
  let ei: i32 = 0;
  while (ei < menums.len()) {
    if (menums[ei].type_params.len() > 0) {
      any = true;
    }
    ei = ei + 1;
  }
  if (!any) {
    return mod;
  }
  let mmod: Module = Module { ...mod, enums: menums };

  let ins: Insts = Insts { inames: [], itypes: [], iargs: [] };
  let efns: MFns = mfns_of(mod.funcs, mod.structs, menums, mod.impls);

  // Phase 1: rewrite references in every function (body + param/ret types)
  // and the top-level statements, accumulating instantiations.
  let nfuncs: FuncDecl[] = [];
  // Generic methods are held aside while concrete clones are produced, then
  // retained as templates for partial instances resolved by typed lowering.
  let held: FuncDecl[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let fn: FuncDecl = mod.funcs[fi];
    let owner: string = "";
    if (fn.receiver_type.len() > 0 && genum_index(menums, strip_struct_base(fn.receiver_type)) >= 0) {
      owner = strip_struct_base(fn.receiver_type);
    }
    let env: MEnv = me_env_from_params(fn.params);
    if (fn.receiver_name.len() > 0) {
      env = env.ebind(fn.receiver_name, fn.receiver_type);
    }
    let rb: RStmts = me_stmts(fn.body, env, fn.ret_type, menums, mod.structs, efns, ins);
    ins = rb.rins3;
    ins = me_collect_slot(fn.ret_type, fn.ret_fn_ret, fn.ret_fn_param_types, menums, ins);
    for fp in fn.params {
      ins = me_collect_slot(fp.type_name, fp.fn_ret, fp.fn_param_types, menums, ins);
    }
    let fret: MeSlot = me_rewrite_slot(fn.ret_type, fn.ret_fn_ret, fn.ret_fn_param_types, menums);
    let rfn: FuncDecl = FuncDecl {
      ...fn,
      params: me_rewrite_params(fn.params, menums),
      ret_type: fret.ty, ret_fn_ret: fret.fn_ret, ret_fn_param_types: fret.fn_params, body: rb.rstmts,
    };
    if (owner.len() > 0) {
      held = held.append(enum_method_template(rfn, menums[genum_index(menums, owner)]));
    } else {
      nfuncs = nfuncs.append(rfn);
    }
    fi = fi + 1;
  }
  let topenv: MEnv = MEnv { mnames: [], mtypes: [] };
  let tr: RStmts = me_stmts(mod.top_stmts, topenv, "", menums, mod.structs, efns, ins);
  ins = tr.rins3;

  // Phase 1b: collect instantiations referenced by STRUCT FIELD types — a
  // (non-generic) struct with a generic-enum-typed field (`struct S { o:
  // Opt[i32] }`) must clone `Opt__i32` too, else the passthrough field below
  // refers to a missing clone. A bare type-param field (`T`, on a
  // generic enum's own variant struct) yields no instantiation, so this is a
  // no-op there.
  let sfi: i32 = 0;
  while (sfi < mod.structs.len()) {
    let sfd: StructFieldDecl[] = mod.structs[sfi].fields;
    let sfj: i32 = 0;
    while (sfj < sfd.len()) {
      ins = me_collect_slot(sfd[sfj].type_name, sfd[sfj].fn_ret, sfd[sfj].fn_param_types, menums, ins);
      sfj = sfj + 1;
    }
    sfi = sfi + 1;
  }

  // Phase 2: generate a concrete enum + variant structs per instantiation.
  let cl_enums: EnumDecl[] = [];
  let cl_structs: StructDecl[] = [];
  // Instantiated templates keep their original field spellings below.
  let instantiated: string[] = [];
  let wi: i32 = 0;
  while (wi < ins.inames.len()) {
    let base: string = ins.inames[wi];
    let key: string = ins.itypes[wi];
    let gidx: i32 = genum_index(menums, base);
    if (gidx >= 0) {
      let ed: EnumDecl = menums[gidx];
      // A single-type-param enum substitutes T with the ORIGINAL arg
      // spelling (`iargs`), not the mangled key: for a nominal / nested
      // clone the two coincide (`i32`, `Opt[i32]` → me_rewrite_ty gives
      // `Opt__i32` == the key), but a fn-keyed clone's key is LOSSILY
      // sanitised (`_i32_____i32`), so only iargs recovers the real field
      // type `(i32) => i32`. A multi-param key splits one piece per
      // parameter (split_key; iargs is unused there).
      let cts: string[] = [ins.iargs[wi]];
      if (ed.type_params.len() != 1) {
        cts = split_key(key, ed.type_params.len(), mod.structs, menums);
      }
      let mname: string = base + "__" + key;
      let nvn: string[] = [];
      let vi2: i32 = 0;
      while (vi2 < ed.variant_names.len()) {
        let vn0: string = ed.variant_names[vi2];
        nvn = nvn.append(vn0 + "__" + key);
        // Clone the variant's desugared struct with substituted payloads.
        let vidx: i32 = variant_struct_index(mod.structs, vn0, base);
        if (vidx >= 0) {
          let vs: StructDecl = mod.structs[vidx];
          let nf: StructFieldDecl[] = [];
          let fj2: i32 = 0;
          while (fj2 < vs.fields.len()) {
            // Substitute the payload's type params, then mangle a
            // resulting generic-enum reference to its clone name and
            // enqueue it — a variant whose payload is another generic
            // enum in the param (`enum E[U] { A(Opt[U]) }` → after
            // subst `A(Opt[i32])`) must reference `Opt__i32` and have
            // it cloned (the enqueue extends this worklist). A plain
            // payload (`i32`, a struct) passes through unchanged.
            let subbed: string = subst_ty(vs.fields[fj2].type_name, ed.type_params, cts);
            ins = me_collect_anno(subbed, menums, ins);
            // A fn-payload field carries its return spelling on fn_ret
            // (`(i32) => Fut[T]` → fn_ret "Fut[T]"). Substitute + mangle
            // it the same way as the payload type so the clone's field
            // reads the instantiated enum (`Fut__i32`) — the source
            // me_scrutinee_type recovers to rewrite a nested match's
            // arms (#4722). Empty (non-fn) fn_ret stays empty.
            let sub_ret: string = subst_ty(vs.fields[fj2].fn_ret, ed.type_params, cts);
            ins = me_collect_anno(sub_ret, menums, ins);
            let f_ty: string = me_rewrite_ty(subbed, menums);
            let f_ret: string = me_rewrite_ty(sub_ret, menums);
            // A type-param substituted to a fn spelling (`T` → `(i32)
            // => i32`, #5298) must be COARSENED to the parser's fn
            // field shape — type_name "fn" with the result on fn_ret —
            // so the IR path recognises it as a fn payload (a raw
            // spelling in type_name trips the per-function IR
            // eligibility, bailing the whole function).
            let f_ptys: string = "";
            let pts: string[] = [];
            if (vs.fields[fj2].fn_param_types.len() > 0) {
              pts = split_top_commas(vs.fields[fj2].fn_param_types);
            }
            for pt0 in pts {
              let pt: string = subst_ty(pt0, ed.type_params, cts);
              ins = me_collect_anno(pt, menums, ins);
              if (f_ptys.len() > 0) {
                f_ptys = f_ptys + ",";
              }
              f_ptys = f_ptys + me_rewrite_ty(pt, menums);
            }
            if (pk_is_fn_spelling(f_ty)) {
              f_ret = me_rewrite_ty(fn_spelling_ret(f_ty), menums);
              ins = me_collect_anno(f_ret, menums, ins);
              // The coarsening drops the parameter half too, so take
              // it off the spelling before it goes (#5986).
              f_ptys = fn_spelling_params(f_ty);
              f_ty = "fn";
            }
            nf = nf.append(StructFieldDecl { name: vs.fields[fj2].name, type_name: f_ty, fn_ret: f_ret, fn_param_types: f_ptys });
            fj2 = fj2 + 1;
          }
          cl_structs = cl_structs.append(StructDecl { name: vn0 + "__" + key, fields: nf, type_params: [], derives: vs.derives, line: vs.line, col: vs.col, enum_owner: mname, must_consume: vs.must_consume, variant_field_names: vs.variant_field_names, is_pub: true, is_package: false });
        }
        vi2 = vi2 + 1;
      }
      cl_enums = cl_enums.append(EnumDecl { name: mname, variant_names: nvn, type_params: [], line: ed.line, col: ed.col, must_consume: ed.must_consume, try_marker: ed.try_marker, is_pub: true, is_package: false, module: ed.module, instance: ed.name + "[" + subst_ty_join(cts, ",", [], []) + "]" });
      let mi: i32 = 0;
      while (mi < mod.funcs.len()) {
        let mm: FuncDecl = mod.funcs[mi];
        if (mm.receiver_type.len() > 0 && strip_struct_base(mm.receiver_type) == base) {
          let cm: FRes = clone_enum_method(mm, ed, cts, mname, mmod, efns, ins);
          ins = cm.fins;
          nfuncs = nfuncs.append(cm.ffn);
        }
        mi = mi + 1;
      }
      if (!str_in(instantiated, base)) {
        instantiated = instantiated.append(base);
      }
    }
    wi = wi + 1;
  }

  // Keep generic declarations as typed schema templates beside their clones.
  // A constructor can leave arguments open until a later use completes them;
  // deleting its declaration here would lose both its payload and identity.
  let out_enums: EnumDecl[] = [];
  let oei: i32 = 0;
  while (oei < mod.enums.len()) {
    out_enums = out_enums.append(mod.enums[oei]);
    oei = oei + 1;
  }
  let k2: i32 = 0;
  while (k2 < cl_enums.len()) {
    out_enums = out_enums.append(cl_enums[k2]);
    k2 = k2 + 1;
  }

  let out_structs: StructDecl[] = [];
  let osi: i32 = 0;
  while (osi < mod.structs.len()) {
    let sd: StructDecl = mod.structs[osi];
    if (sd.enum_owner.len() > 0 && str_in(instantiated, sd.enum_owner)) {
      out_structs = out_structs.append(sd);
    }
    if (sd.enum_owner.len() == 0 || !str_in(instantiated, sd.enum_owner)) {
      // Rewrite a kept struct's generic-enum-typed fields to the mangled
      // clone (`o: Opt[i32]` -> `o: Opt__i32`), matching the clones phase 2
      // generated; non-generic-enum field types pass through unchanged.
      let rf: StructFieldDecl[] = [];
      let rfj: i32 = 0;
      while (rfj < sd.fields.len()) {
        let fslot: MeSlot = me_rewrite_slot(sd.fields[rfj].type_name, sd.fields[rfj].fn_ret, sd.fields[rfj].fn_param_types, menums);
        rf = rf.append(StructFieldDecl { name: sd.fields[rfj].name, type_name: fslot.ty, fn_ret: fslot.fn_ret, fn_param_types: fslot.fn_params });
        rfj = rfj + 1;
      }
      out_structs = out_structs.append(StructDecl { name: sd.name, fields: rf, type_params: sd.type_params, derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume, variant_field_names: sd.variant_field_names, is_pub: sd.is_pub, is_package: false });
    }
    osi = osi + 1;
  }
  let k3: i32 = 0;
  while (k3 < cl_structs.len()) {
    out_structs = out_structs.append(cl_structs[k3]);
    k3 = k3 + 1;
  }
  let hi: i32 = 0;
  while (hi < held.len()) {
    nfuncs = nfuncs.append(held[hi]);
    hi = hi + 1;
  }

  return Module { ...mod, funcs: nfuncs, structs: out_structs, top_stmts: tr.rstmts, enums: out_enums };
}

// str_in reports membership of `s` in `xs`.
function str_in(xs: string[], s: string): boolean {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == s) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// ---- defer lowering -------------------------------------------------
// `defer ACTION;` runs ACTION when the enclosing function exits — at every
// return path and at falloff, in LIFO order, and only if the defer
// statement was actually reached (a per-defer flag). The return value is
// captured before the deferred actions run. lower_defers_module eliminates
// every StmtDefer (rewriting to flag-sets + per-exit cleanup) so the
// backends never emit one. Mirrors the Go IR's ast.Defer + IsActive local.

// dl_itoa renders a non-negative i32 as decimal (flag indices). parser.fern
// has no i32_to_string, so build digits via 1-char string slices.
function dl_itoa(n: i32): string {
  if (n == 0) {
    return "0";
  }
  let digits: string = "0123456789";
  let s: string = "";
  let x: i32 = n;
  while (x > 0) {
    let d: i32 = x % 10;
    s = slice_unchecked(digits, d, d + 1) + s;
    x = x / 10;
  }
  return s;
}

struct DeferAcc { stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[] }

// is_value_local_name reports whether `name` is the local a value-position
// desugar stores its result into (`__tm<line>_<col>_r` and its siblings, see
// IfChain.value_local) — a declaration the compiler writes, never the source.
pub function is_value_local_name(name: string): boolean {
  let n: i32 = name.len();
  if (n < 6 || slice_unchecked(name, n - 2, n) != "_r") {
    return false;
  }
  let head: str = slice_unchecked(name, 0, 4);
  return head == "__tm" || head == "__sm" || head == "__nt" || head == "__na";
}

// is_value_block reports whether `e` is a value-position `{ … }` block.
// parse_primary builds one as an immediately-invoked zero-parameter lambda (the
// general value-block form and the if- / match-expression desugars), and the lowering
// INLINES its statements into the enclosing function — so a `defer` inside one
// is NOT in a scope of its own. That is also native's rule: a block expression
// is neither a function nor a loop, so its defer belongs to the innermost
// enclosing loop body if there is one and to the function otherwise (#6852).
// Every other lambda is a boundary here: it owns its own defer scope and is
// lowered after lambda lifting.
// is_value_block reports the shape the parser emits desugaring an
// if-/match-expression or a comprehension: a zero-arg call of a zero-param
// lambda, which the lowering INLINES rather than calling. Three passes and the
// checker need to tell one from an ordinary lambda — an ordinary lambda is a
// scope boundary, a value block is not — so the test lives in one place.
pub function is_value_block(c: ast.ExprCall): boolean {
  if (c.args.len() != 0) {
    return false;
  }
  match (c.callee) {
    ast.ExprLambda(l) => {
      if (l.params.len() != 0) {
        return false;
      }
      return is_value_block_origin(l.origin);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// mkclo_body names the hoisted body a lambda-lift closure marker carries, or
// "" for any other name. lift.lift_inline_closures writes the marker as a
// call of `__mkclo$<body>`; the checker types the box it builds and the
// semantic source boundary produces it, so the spelling lives in one place.
pub function mkclo_body(name: string): string {
  let marker: string = "__mkclo$";
  if (name.len() <= marker.len() || slice_unchecked(name, 0, marker.len()) != marker) {
    return "";
  }
  return slice_unchecked(name, marker.len(), name.len()) + "";
}

// is_written_lambda_origin reports whether a lambda with this origin is one the
// PROGRAMMER wrote. A bare lambda carries no origin; a nested `function`
// declaration and a `use` callback each desugar to one the programmer did
// write, so both are admitted. The rest — a value block, an if- or
// match-expression, a comprehension — are IIFEs the parser synthesised, with no
// counterpart in the native AST.
//
// ORIGIN_IIFE_SCOPED belongs to neither group: the defer lowering stamps it
// after the checker has run, so no checker rule ever sees it.
pub function is_written_lambda_origin(origin: string): boolean {
  return origin.len() == 0 || origin == ast.ORIGIN_NESTED_FN || origin == ORIGIN_USE;
}

// is_value_block_origin reports whether `origin` names one of the desugars that
// produce an inlined value block. Every pass that rebuilds an ExprLambda does so
// by spread, so the marker survives to the consumers that need it.
pub function is_value_block_origin(origin: string): boolean {
  if (origin == ORIGIN_BLOCK) {
    return true;
  }
  if (origin == ORIGIN_MATCH_EXPR) {
    return true;
  }
  if (origin == ORIGIN_IF_EXPR) {
    return true;
  }
  if (origin == ORIGIN_ARR_COMP) {
    return true;
  }
  if (origin == ORIGIN_MAP_COMP) {
    return true;
  }
  return false;
}

// dl_vb_rebuild puts `body` back into the value block `c` came from.
function dl_vb_rebuild(c: ast.ExprCall, body: ast.Stmt[]): ast.Expr {
  match (c.callee) {
    ast.ExprLambda(l) => {
      let lam: ast.Expr = ast.ExprLambda { ...l, body: body };
      return ast.ExprCall { callee: lam, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    _ => {
      return ast.ExprCall { callee: c.callee, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    }
  }
  return e_unknown("value block");
}

// dl_expr_kids / dl_expr_with_kids are the generic expression traversal every
// rewriting walk in this file shares, through map_expr_kids below: kids in
// EVALUATION order, and a rebuild from a same-length, same-order replacement
// list. An ExprLambda has no kids — its body is statements, and it is a scope
// boundary for the walks that care — so a walk reaches a lambda body only by
// matching ExprLambda itself.
function dl_expr_kids(e: ast.Expr): ast.Expr[] {
  match (e) {
    ast.ExprBinary(b) => {
      return [b.left, b.right];
    },
    ast.ExprUnary(u) => {
      return [u.operand];
    },
    ast.ExprCall(c) => {
      let out: ast.Expr[] = [c.callee];
      let i: i32 = 0;
      while (i < c.args.len()) {
        out = out.append(c.args[i]);
        i = i + 1;
      }
      return out;
    },
    ast.ExprArray(a) => {
      return a.elements;
    },
    ast.ExprTuple(t) => {
      return t.elements;
    },
    ast.ExprIndex(x) => {
      return [x.array, x.index];
    },
    ast.ExprSlice(sl) => {
      return [sl.array, sl.start, sl.end];
    },
    ast.ExprStructLit(s) => {
      let out: ast.Expr[] = [s.base];
      let i: i32 = 0;
      while (i < s.field_values.len()) {
        out = out.append(s.field_values[i]);
        i = i + 1;
      }
      return out;
    },
    ast.ExprFieldAccess(fa) => {
      return [fa.obj];
    },
    ast.ExprMapLit(m) => {
      let out: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < m.keys.len()) {
        out = out.append(m.keys[i]);
        i = i + 1;
      }
      let j: i32 = 0;
      while (j < m.vals.len()) {
        out = out.append(m.vals[j]);
        j = j + 1;
      }
      return out;
    },
    ast.ExprFString(f) => {
      return f.exprs;
    },
    _ => {
      let none: ast.Expr[] = [];
      return none;
    }
  }
  let none2: ast.Expr[] = [];
  return none2;
}

// dl_stmts_have_defer reports whether `stmts` contain a `defer` anywhere the
// defer pass would rewrite — including inside a value block, which is where the
// statement-only walks used to miss one. Read-only and short-circuiting: it is
// what keeps the rebuilding walks off a defer-free function.
function dl_stmts_have_defer(stmts: ast.Stmt[]): boolean {
  let i: i32 = 0;
  while (i < stmts.len()) {
    if (dl_stmt_has_defer(stmts[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// dl_stmts_have_defer_deep is the pre-scan for the SCOPE-aware pass: unlike
// dl_stmts_have_defer it also reports a defer sitting inside a lambda body —
// the early-out in lower_defers_func has to, or a function whose only defer is
// in a lambda is returned unchanged and that lambda is never lowered (#7174).
// "Shallow or lambda-borne" unions to "a StmtDefer anywhere in the subtree",
// which is the spine's whole-subtree walk verbatim — the shallow/deep split
// constrains only the shallow half.
function dl_stmts_have_defer_deep(stmts: ast.Stmt[]): boolean {
  function vs(st: ast.Stmt, own hit: boolean): boolean {
    if (hit) {
      return true;
    }
    match (st) {
      ast.StmtDefer(_) => {
        return true;
      },
      _ => {
        return false;
      }
    }
    return false;
  }
  function ve(e: ast.Expr, own hit: boolean): boolean {
    return hit;
  }
  let hit: boolean = false;
  for st in stmts {
    hit = astwalk.fold_stmt_nodes(st, hit, vs, ve, astwalk.descend_all);
  }
  return hit;
}

function dl_stmt_has_defer(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtDefer(_) => {
      return true;
    },
    ast.StmtVar(v) => {
      return dl_expr_has_defer(v.init);
    },
    ast.StmtReturn(r) => {
      return dl_expr_has_defer(r.value);
    },
    ast.StmtExpr(x) => {
      return dl_expr_has_defer(x.value);
    },
    ast.StmtAssign(a) => {
      return dl_expr_has_defer(a.value);
    },
    ast.StmtIf(f) => {
      return dl_expr_has_defer(f.cond) || dl_stmts_have_defer(f.then_body) || dl_stmts_have_defer(f.else_body);
    },
    ast.StmtWhile(w) => {
      return dl_expr_has_defer(w.cond) || dl_stmts_have_defer(w.body);
    },
    ast.StmtFor(fr) => {
      return dl_expr_has_defer(fr.iter) || dl_stmts_have_defer(fr.body);
    },
    ast.StmtMatch(m) => {
      if (dl_expr_has_defer(m.scrutinee)) {
        return true;
      }
      let i: i32 = 0;
      while (i < m.arms.len()) {
        if (dl_expr_has_defer(m.arms[i].guard)) {
          return true;
        }
        if (dl_stmts_have_defer(m.arms[i].body)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function dl_exprs_have_defer(es: ast.Expr[]): boolean {
  let i: i32 = 0;
  while (i < es.len()) {
    if (dl_expr_has_defer(es[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function dl_expr_has_defer(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            return dl_stmts_have_defer(l.body);
          },
          _ => {}
        }
      }
      if (dl_expr_has_defer(c.callee)) {
        return true;
      }
      return dl_exprs_have_defer(c.args);
    },
    ast.ExprBinary(b) => {
      return dl_expr_has_defer(b.left) || dl_expr_has_defer(b.right);
    },
    ast.ExprUnary(u) => {
      return dl_expr_has_defer(u.operand);
    },
    ast.ExprArray(a) => {
      return dl_exprs_have_defer(a.elements);
    },
    ast.ExprTuple(t) => {
      return dl_exprs_have_defer(t.elements);
    },
    ast.ExprIndex(x) => {
      return dl_expr_has_defer(x.array) || dl_expr_has_defer(x.index);
    },
    ast.ExprSlice(sl) => {
      return dl_expr_has_defer(sl.array) || dl_expr_has_defer(sl.start) || dl_expr_has_defer(sl.end);
    },
    ast.ExprStructLit(s) => {
      return dl_expr_has_defer(s.base) || dl_exprs_have_defer(s.field_values);
    },
    ast.ExprFieldAccess(fa) => {
      return dl_expr_has_defer(fa.obj);
    },
    ast.ExprMapLit(m) => {
      return dl_exprs_have_defer(m.keys) || dl_exprs_have_defer(m.vals);
    },
    ast.ExprFString(f) => {
      return dl_exprs_have_defer(f.exprs);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function dl_expr_with_kids(e: ast.Expr, kids: ast.Expr[]): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: kids[0], right: kids[1], line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: kids[0], line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      let i: i32 = 1;
      while (i < kids.len()) {
        args = args.append(kids[i]);
        i = i + 1;
      }
      return ast.ExprCall { callee: kids[0], args: args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      return ast.ExprArray { ...a, elements: kids };
    },
    ast.ExprTuple(t) => {
      return ast.ExprTuple { elements: kids, line: t.line, col: t.col };
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex { array: kids[0], index: kids[1], unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: kids[0], start: kids[1], end: kids[2] };
    },
    ast.ExprStructLit(s) => {
      let vals: ast.Expr[] = [];
      let i: i32 = 1;
      while (i < kids.len()) {
        vals = vals.append(kids[i]);
        i = i + 1;
      }
      return ast.ExprStructLit { type_name: s.type_name, field_names: s.field_names, field_values: vals, has_base: s.has_base, base: kids[0], line: s.line, col: s.col, written: s.written };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { obj: kids[0], field: fa.field, line: fa.line, col: fa.col, ty: fa.ty };
    },
    ast.ExprMapLit(m) => {
      let ks: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < m.keys.len()) {
        ks = ks.append(kids[i]);
        i = i + 1;
      }
      let vs: ast.Expr[] = [];
      let j: i32 = m.keys.len();
      while (j < kids.len()) {
        vs = vs.append(kids[j]);
        j = j + 1;
      }
      return ast.ExprMapLit { keys: ks, vals: vs, line: m.line, col: m.col };
    },
    ast.ExprFString(f) => {
      return ast.ExprFString { lits: f.lits, exprs: kids, is_expr: f.is_expr, line: f.line, col: f.col };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// map_expr_kids rebuilds `e` with `f` applied to each direct sub-expression,
// leaving a leaf (and an ExprLambda, which has none) untouched. Every walk that
// wants "recurse into the kids and rebuild" goes through here.
function map_expr_kids(e: ast.Expr, f: (ast.Expr) => ast.Expr): ast.Expr {
  let kids: ast.Expr[] = dl_expr_kids(e);
  if (kids.len() == 0) {
    return e;
  }
  let nk: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < kids.len()) {
    nk = nk.append(f(kids[i]));
    i = i + 1;
  }
  return dl_expr_with_kids(e, nk);
}

// dl_while / dl_for rebuild a loop around a rewritten body, keeping the
// label and line the plain s_while / s_for constructors drop — a
// `break outer` inside a defer-using function has to still find its loop.
function dl_while(w: ast.StmtWhile, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtWhile { cond: w.cond, body: body, label: w.label, line: w.line, is_loop: w.is_loop };
}

function dl_for(fr: ast.StmtFor, body: ast.Stmt[]): ast.Stmt {
  return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: body, label: fr.label, line: fr.line };
}

// dl_iter_cleanup builds one loop body's per-iteration cleanup: for the
// actions that body registered (indices [start, end)), in reverse source
// order, `if (__dfa<i>) { ACTION; __dfa<i> = false; }`. Clearing the flag is
// what makes the run count per iteration — the next iteration re-arms, and
// the function-exit replay skips an iteration that already ended. An
// errdefer only clears: leaving the body normally is not an error exit, and
// a rollback armed in an earlier iteration must not fire for a later
// iteration's failure.
function dl_iter_cleanup(actions: ast.Stmt[], flags: i32[], start: i32, end: i32): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = end - 1;
  while (i >= start) {
    let name: string = "__dfa" + dl_itoa(i);
    let body1: ast.Stmt[] = [];
    if (flags[i] == 0) {
      body1 = body1.append(actions[i]);
    }
    body1 = body1.append(s_assign(name, e_bool(false)));
    let noelse: ast.Stmt[] = [];
    out = out.append(s_if(e_ident(name), body1, noelse));
    i = i - 1;
  }
  return out;
}

// DeferEdges is dl_expand_loop_edges' output: the rewritten statements, and
// how far into the action list the walk has passed an arming write.
struct DeferEdges { stmts: ast.Stmt[], armed: i32 }

// dl_arm_index returns the action index an assignment ARMS (`__dfa<i> = true`),
// or -1 for anything else — including dl_iter_cleanup's own `__dfa<i> = false`.
// Indices below `from` have already been passed, so the scan starts there.
function dl_arm_index(a: ast.StmtAssign, from: i32, end: i32): i32 {
  let armed: boolean = false;
  match (a.value) {
    ast.ExprBool(b) => {
      armed = b.value;
    },
    _ => {}
  }
  if (!armed) {
    return 0 - 1;
  }
  let i: i32 = from;
  while (i < end) {
    if (a.target == "__dfa" + dl_itoa(i)) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// dl_expand_loop_edges inserts the per-iteration cleanup before every `break` /
// `continue` that leaves this loop body — the body's other exit edges, next to
// the tail. An unlabelled edge at this level targets this loop; a labelled one
// targets it from anywhere inside, nested loops included. Nested loops are only
// REWRITTEN when this loop is labelled, since an unlabelled edge in there leaves
// the nested body, which ran its own cleanup already; they are still walked, so
// the arming writes inside them count.
//
// An edge replays only the actions armed EARLIER in the body (`armed`), not the
// body's whole [start, end) range. A defer the edge has not reached yet cannot
// be pending — every edge out of the body clears its flags, so each iteration
// starts with all of them at 0 — and its action names locals that need not exist
// at the edge. The range-for desugar puts exactly such an edge at the top of
// every loop it builds (`if (i >= $hi) break;`), ahead of the whole body (#6860).
// DeferEdgeExpr is dl_edges_expr's output: the rewritten expression and how far
// the arming writes inside it have advanced.
struct DeferEdgeExpr { expr: ast.Expr, armed: i32 }

// dl_edges_expr is dl_expand_loop_edges over the value blocks inside `e`. Their
// statements run inline in this loop body, so an arming write there advances
// `armed` and a `break` / `continue` there is an edge out of this iteration.
function dl_edges_expr(e: ast.Expr, actions: ast.Stmt[], flags: i32[], start: i32, armed0: i32, label: string, own_level: boolean): DeferEdgeExpr {
  match (e) {
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            let vb: DeferEdges = dl_expand_loop_edges(l.body, actions, flags, start, armed0, label, own_level);
            return DeferEdgeExpr { expr: dl_vb_rebuild(c, vb.stmts), armed: vb.armed };
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  let kids: ast.Expr[] = dl_expr_kids(e);
  if (kids.len() == 0) {
    return DeferEdgeExpr { expr: e, armed: armed0 };
  }
  let out: ast.Expr[] = [];
  let armed: i32 = armed0;
  let i: i32 = 0;
  while (i < kids.len()) {
    let r: DeferEdgeExpr = dl_edges_expr(kids[i], actions, flags, start, armed, label, own_level);
    out = out.append(r.expr);
    armed = r.armed;
    i = i + 1;
  }
  return DeferEdgeExpr { expr: dl_expr_with_kids(e, out), armed: armed };
}

function dl_expand_loop_edges(stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[], start: i32, armed0: i32, label: string, own_level: boolean): DeferEdges {
  let out: ast.Stmt[] = [];
  let armed: i32 = armed0;
  let end: i32 = actions.len();
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtAssign(a) => {
        let ave: DeferEdgeExpr = dl_edges_expr(a.value, actions, flags, start, armed, label, own_level);
        armed = ave.armed;
        let ast: ast.StmtAssign = ast.StmtAssign { target: a.target, value: ave.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
        let ax: i32 = dl_arm_index(ast, armed, end);
        if (ax >= 0) {
          armed = ax + 1;
        }
        out = out.append(ast);
      },
      ast.StmtVar(v) => {
        let vve: DeferEdgeExpr = dl_edges_expr(v.init, actions, flags, start, armed, label, own_level);
        armed = vve.armed;
        out = out.append(ast.StmtVar { name: v.name, type_name: v.type_name, init: vve.expr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types });
      },
      ast.StmtExpr(x) => {
        let xve: DeferEdgeExpr = dl_edges_expr(x.value, actions, flags, start, armed, label, own_level);
        armed = xve.armed;
        out = out.append(ast.StmtExpr { value: xve.expr, line: x.line });
      },
      ast.StmtReturn(r) => {
        let rve: DeferEdgeExpr = dl_edges_expr(r.value, actions, flags, start, armed, label, own_level);
        armed = rve.armed;
        out = out.append(ast.StmtReturn { value: rve.expr, line: r.line, col: r.col });
      },
      ast.StmtBreak(b) => {
        if (own_level && b.label.len() == 0 || label.len() > 0 && b.label == label) {
          let cb: ast.Stmt[] = dl_iter_cleanup(actions, flags, start, armed);
          let kb: i32 = 0;
          while (kb < cb.len()) {
            out = out.append(cb[kb]);
            kb = kb + 1;
          }
        }
        out = out.append(stmts[i]);
      },
      ast.StmtContinue(c) => {
        if (own_level && c.label.len() == 0 || label.len() > 0 && c.label == label) {
          let cc: ast.Stmt[] = dl_iter_cleanup(actions, flags, start, armed);
          let kc: i32 = 0;
          while (kc < cc.len()) {
            out = out.append(cc[kc]);
            kc = kc + 1;
          }
        }
        out = out.append(stmts[i]);
      },
      ast.StmtIf(f) => {
        let ce: DeferEdgeExpr = dl_edges_expr(f.cond, actions, flags, start, armed, label, own_level);
        armed = ce.armed;
        let tr: DeferEdges = dl_expand_loop_edges(f.then_body, actions, flags, start, armed, label, own_level);
        let er: DeferEdges = dl_expand_loop_edges(f.else_body, actions, flags, start, armed, label, own_level);
        if (tr.armed > armed) {
          armed = tr.armed;
        }
        if (er.armed > armed) {
          armed = er.armed;
        }
        out = out.append(s_if(ce.expr, tr.stmts, er.stmts));
      },
      ast.StmtMatch(m) => {
        let se: DeferEdgeExpr = dl_edges_expr(m.scrutinee, actions, flags, start, armed, label, own_level);
        armed = se.armed;
        let arms: ast.MatchArm[] = [];
        let ai: i32 = 0;
        while (ai < m.arms.len()) {
          let ge: DeferEdgeExpr = dl_edges_expr(m.arms[ai].guard, actions, flags, start, armed, label, own_level);
          let ar: DeferEdges = dl_expand_loop_edges(m.arms[ai].body, actions, flags, start, ge.armed, label, own_level);
          if (ar.armed > armed) {
            armed = ar.armed;
          }
          arms = arms.append(ast.MatchArm { pattern: m.arms[ai].pattern, body: ar.stmts, line: m.arms[ai].line, col: m.arms[ai].col, guard: ge.expr, has_guard: m.arms[ai].has_guard, alt_cont: false });
          ai = ai + 1;
        }
        out = out.append(s_match(se.expr, arms));
      },
      ast.StmtWhile(w) => {
        let wce: DeferEdgeExpr = dl_edges_expr(w.cond, actions, flags, start, armed, label, own_level);
        armed = wce.armed;
        let wl: ast.StmtWhile = ast.StmtWhile { cond: wce.expr, body: w.body, label: w.label, line: w.line, is_loop: w.is_loop };
        let wr: DeferEdges = dl_expand_loop_edges(w.body, actions, flags, start, armed, label, false);
        if (wr.armed > armed) {
          armed = wr.armed;
        }
        if (label.len() == 0) {
          out = out.append(dl_while(wl, w.body));
        } else {
          out = out.append(dl_while(wl, wr.stmts));
        }
      },
      ast.StmtFor(fr) => {
        let fie: DeferEdgeExpr = dl_edges_expr(fr.iter, actions, flags, start, armed, label, own_level);
        armed = fie.armed;
        let fl: ast.StmtFor = ast.StmtFor { var_name: fr.var_name, iter: fie.expr, body: fr.body, label: fr.label, line: fr.line };
        let fr2: DeferEdges = dl_expand_loop_edges(fr.body, actions, flags, start, armed, label, false);
        if (fr2.armed > armed) {
          armed = fr2.armed;
        }
        if (label.len() == 0) {
          out = out.append(dl_for(fl, fr.body));
        } else {
          out = out.append(dl_for(fl, fr2.stmts));
        }
      },
      _ => {
        out = out.append(stmts[i]);
      }
    }
    i = i + 1;
  }
  return DeferEdges { stmts: out, armed: armed };
}

// dl_loop_body wires one loop body up for per-iteration cleanup: the
// actions it registered are indices [start, end), and every edge out of
// the body — the tail, a `break`, a `continue` — replays them. The tail is
// past every arming write, so it replays the whole range.
function dl_loop_body(body: ast.Stmt[], actions: ast.Stmt[], flags: i32[], start: i32, label: string): ast.Stmt[] {
  let end: i32 = actions.len();
  if (end <= start) {
    return body;
  }
  let r: DeferEdges = dl_expand_loop_edges(body, actions, flags, start, start, label, true);
  let out: ast.Stmt[] = r.stmts;
  let cleanup: ast.Stmt[] = dl_iter_cleanup(actions, flags, start, end);
  let i: i32 = 0;
  while (i < cleanup.len()) {
    out = out.append(cleanup[i]);
    i = i + 1;
  }
  return out;
}

// dl_collect_stmt(s) rebuild the body with each `defer ACTION` replaced by
// `__dfa<i> = true`, accumulating the actions (index = position in the list)
// and a parallel `flags` list (0 = plain defer, 1 = errdefer). Recurses
// through nested blocks so a conditional defer gets its flag set only when
// its branch runs. A loop body additionally gets its own defers replayed on
// every edge out of the body (dl_loop_body), so each iteration's action runs
// at the end of that iteration.
function dl_collect_stmts(stmts: ast.Stmt[], actions: ast.Stmt[], flags: i32[]): DeferAcc {
  let out: ast.Stmt[] = [];
  let acc: ast.Stmt[] = actions;
  let afl: i32[] = flags;
  let i: i32 = 0;
  while (i < stmts.len()) {
    let r: DeferAcc = dl_collect_stmt(stmts[i], acc, afl);
    let j: i32 = 0;
    while (j < r.stmts.len()) {
      out = out.append(r.stmts[j]);
      j = j + 1;
    }
    acc = r.actions;
    afl = r.flags;
    i = i + 1;
  }
  return DeferAcc { stmts: out, actions: acc, flags: afl };
}

// DeferExprAcc is dl_collect_expr's output: the rewritten expression and the
// accumulator the value blocks inside it added to.
struct DeferExprAcc { expr: ast.Expr, actions: ast.Stmt[], flags: i32[] }

// dl_collect_expr registers the defers written inside `e`'s value blocks with
// the ENCLOSING function's accumulator, replacing each with its arming write —
// the expression half of dl_collect_stmt.
function dl_collect_expr(e: ast.Expr, actions: ast.Stmt[], flags: i32[]): DeferExprAcc {
  match (e) {
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            let vb: DeferAcc = dl_collect_stmts(l.body, actions, flags);
            return DeferExprAcc { expr: dl_vb_rebuild(c, vb.stmts), actions: vb.actions, flags: vb.flags };
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  let kids: ast.Expr[] = dl_expr_kids(e);
  if (kids.len() == 0) {
    return DeferExprAcc { expr: e, actions: actions, flags: flags };
  }
  let out: ast.Expr[] = [];
  let acc: ast.Stmt[] = actions;
  let afl: i32[] = flags;
  let i: i32 = 0;
  while (i < kids.len()) {
    let r: DeferExprAcc = dl_collect_expr(kids[i], acc, afl);
    out = out.append(r.expr);
    acc = r.actions;
    afl = r.flags;
    i = i + 1;
  }
  return DeferExprAcc { expr: dl_expr_with_kids(e, out), actions: acc, flags: afl };
}

function dl_collect_stmt(st: ast.Stmt, actions: ast.Stmt[], flags: i32[]): DeferAcc {
  match (st) {
    ast.StmtDefer(d) => {
      let setflag: ast.Stmt = s_assign("__dfa" + dl_itoa(actions.len()), e_bool(true));
      let one: ast.Stmt[] = [setflag];
      return DeferAcc { stmts: one, actions: actions.append(d.action), flags: flags.append(d.on_error) };
    },
    ast.StmtVar(v) => {
      let ir: DeferExprAcc = dl_collect_expr(v.init, actions, flags);
      let one: ast.Stmt[] = [ast.StmtVar { name: v.name, type_name: v.type_name, init: ir.expr, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }];
      return DeferAcc { stmts: one, actions: ir.actions, flags: ir.flags };
    },
    ast.StmtReturn(r) => {
      let vr: DeferExprAcc = dl_collect_expr(r.value, actions, flags);
      let one: ast.Stmt[] = [ast.StmtReturn { value: vr.expr, line: r.line, col: r.col }];
      return DeferAcc { stmts: one, actions: vr.actions, flags: vr.flags };
    },
    ast.StmtExpr(x) => {
      let xr: DeferExprAcc = dl_collect_expr(x.value, actions, flags);
      let one: ast.Stmt[] = [ast.StmtExpr { value: xr.expr, line: x.line }];
      return DeferAcc { stmts: one, actions: xr.actions, flags: xr.flags };
    },
    ast.StmtAssign(a) => {
      let ar: DeferExprAcc = dl_collect_expr(a.value, actions, flags);
      let one: ast.Stmt[] = [ast.StmtAssign { target: a.target, value: ar.expr, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }];
      return DeferAcc { stmts: one, actions: ar.actions, flags: ar.flags };
    },
    ast.StmtIf(f) => {
      let cr: DeferExprAcc = dl_collect_expr(f.cond, actions, flags);
      let tr: DeferAcc = dl_collect_stmts(f.then_body, cr.actions, cr.flags);
      let er: DeferAcc = dl_collect_stmts(f.else_body, tr.actions, tr.flags);
      let one: ast.Stmt[] = [s_if(cr.expr, tr.stmts, er.stmts)];
      return DeferAcc { stmts: one, actions: er.actions, flags: er.flags };
    },
    ast.StmtWhile(w) => {
      // The condition is not part of the loop BODY, so a defer written in
      // one belongs to the function, not to the iteration — it registers
      // ahead of `wstart`, matching native's bodyDeferIdxs(n.Body).
      let cw: DeferExprAcc = dl_collect_expr(w.cond, actions, flags);
      let wstart: i32 = cw.actions.len();
      let br: DeferAcc = dl_collect_stmts(w.body, cw.actions, cw.flags);
      let wl: ast.StmtWhile = ast.StmtWhile { cond: cw.expr, body: w.body, label: w.label, line: w.line, is_loop: w.is_loop };
      let one: ast.Stmt[] = [dl_while(wl, dl_loop_body(br.stmts, br.actions, br.flags, wstart, w.label))];
      return DeferAcc { stmts: one, actions: br.actions, flags: br.flags };
    },
    ast.StmtFor(fr) => {
      let itr: DeferExprAcc = dl_collect_expr(fr.iter, actions, flags);
      let fstart: i32 = itr.actions.len();
      let br: DeferAcc = dl_collect_stmts(fr.body, itr.actions, itr.flags);
      let fl: ast.StmtFor = ast.StmtFor { var_name: fr.var_name, iter: itr.expr, body: fr.body, label: fr.label, line: fr.line };
      let one: ast.Stmt[] = [dl_for(fl, dl_loop_body(br.stmts, br.actions, br.flags, fstart, fr.label))];
      return DeferAcc { stmts: one, actions: br.actions, flags: br.flags };
    },
    ast.StmtMatch(m) => {
      let sr: DeferExprAcc = dl_collect_expr(m.scrutinee, actions, flags);
      let arms: ast.MatchArm[] = [];
      let acc: ast.Stmt[] = sr.actions;
      let afl: i32[] = sr.flags;
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let gr: DeferExprAcc = dl_collect_expr(m.arms[i].guard, acc, afl);
        let ar: DeferAcc = dl_collect_stmts(m.arms[i].body, gr.actions, gr.flags);
        arms = arms.append(ast.MatchArm { pattern: m.arms[i].pattern, body: ar.stmts, line: m.arms[i].line, col: m.arms[i].col, guard: gr.expr, has_guard: m.arms[i].has_guard, alt_cont: false });
        acc = ar.actions;
        afl = ar.flags;
        i = i + 1;
      }
      let one: ast.Stmt[] = [s_match(sr.expr, arms)];
      return DeferAcc { stmts: one, actions: acc, flags: afl };
    },
    _ => {
      let one: ast.Stmt[] = [st];
      return DeferAcc { stmts: one, actions: actions, flags: flags };
    }
  }
}

// dl_cleanup_kind builds the LIFO cleanup for one kind: for i = n-1 .. 0,
// `if (__dfa<i>) { action_i }`, restricted to actions whose on_error flag
// equals `want` (0 = plain defer, 1 = errdefer). With every flag 0 (no
// errdefer) `want = 0` reproduces the original all-actions cleanup, so a
// defer-only function lowers byte-identically.
function dl_cleanup_kind(actions: ast.Stmt[], flags: i32[], want: i32): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = actions.len() - 1;
  while (i >= 0) {
    if (flags[i] == want) {
      let body1: ast.Stmt[] = [actions[i]];
      let noelse: ast.Stmt[] = [];
      out = out.append(s_if(e_ident("__dfa" + dl_itoa(i)), body1, noelse));
    }
    i = i - 1;
  }
  return out;
}

// dl_is_err_value reports whether a return value is statically a None/Err —
// the failure variant — so an `errdefer` should fire on this return. `None`
// is a bare ident; `Err(x)` is a call to the `Err` constructor. (`?`
// propagation is not visible to this parse-time pass — same scope as the
// self-host's plain `defer`, which also only fires on explicit returns.)
function dl_is_err_value(e: ast.Expr): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == "None";
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return cid.name == "Err";
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
}

// dl_expand_returns replaces each `return E` with
// `__defret = E; <cleanup_all>; [<cleanup_err> if E is None/Err]; return __defret;`
// (the value is captured before the deferred actions run). cleanup_all (plain
// defers) runs on every return; cleanup_err (errdefers) runs only when the
// returned value is a None/Err. A bare/void return runs cleanup_all only.
function dl_expand_returns(stmts: ast.Stmt[], cleanup_all: ast.Stmt[], cleanup_err: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    let ex: ast.Stmt[] = dl_expand_return_stmt(stmts[i], cleanup_all, cleanup_err);
    let j: i32 = 0;
    while (j < ex.len()) {
      out = out.append(ex[j]);
      j = j + 1;
    }
    i = i + 1;
  }
  return out;
}

// dl_expand_returns_vb expands the returns of a value block's body. Its LAST
// statement is the block's VALUE, not an exit — lower_value_block rewrites that
// `return tail` into a store — so only the leading statements, which the same
// lowering runs inline, carry real function returns.
function dl_expand_returns_vb(body: ast.Stmt[], cleanup_all: ast.Stmt[], cleanup_err: ast.Stmt[]): ast.Stmt[] {
  if (body.len() == 0) {
    return body;
  }
  let lead: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < body.len() - 1) {
    lead = lead.append(body[i]);
    i = i + 1;
  }
  return dl_expand_returns(lead, cleanup_all, cleanup_err).append(body[body.len() - 1]);
}

// dl_return_expr expands the `return`s written inside `e`'s value blocks: a
// value block is inlined into the enclosing function, so a return there is a
// real function return and needs the cleanup spliced in front of it.
function dl_return_expr(e: ast.Expr, cleanup_all: ast.Stmt[], cleanup_err: ast.Stmt[]): ast.Expr {
  match (e) {
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        match (c.callee) {
          ast.ExprLambda(l) => {
            return dl_vb_rebuild(c, dl_expand_returns_vb(l.body, cleanup_all, cleanup_err));
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  let kids: ast.Expr[] = dl_expr_kids(e);
  if (kids.len() == 0) {
    return e;
  }
  let out: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < kids.len()) {
    out = out.append(dl_return_expr(kids[i], cleanup_all, cleanup_err));
    i = i + 1;
  }
  return dl_expr_with_kids(e, out);
}

function dl_expand_return_stmt(st: ast.Stmt, cleanup_all: ast.Stmt[], cleanup_err: ast.Stmt[]): ast.Stmt[] {
  match (st) {
    ast.StmtReturn(r) => {
      let rv: ast.Expr = dl_return_expr(r.value, cleanup_all, cleanup_err);
      let isvoid: boolean = false;
      match (rv) {
        ast.ExprUnknown(_) => {
          isvoid = true;
        },
        _ => {}
      }
      let out: ast.Stmt[] = [];
      if (!isvoid) {
        out = out.append(s_assign("__defret", rv));
      }
      let i: i32 = 0;
      while (i < cleanup_all.len()) {
        out = out.append(cleanup_all[i]);
        i = i + 1;
      }
      if (!isvoid && dl_is_err_value(rv)) {
        let k: i32 = 0;
        while (k < cleanup_err.len()) {
          out = out.append(cleanup_err[k]);
          k = k + 1;
        }
      }
      if (isvoid) {
        out = out.append(s_return(rv));
      } else {
        out = out.append(s_return(e_ident("__defret")));
      }
      return out;
    },
    ast.StmtVar(v) => {
      let one: ast.Stmt[] = [ast.StmtVar { name: v.name, type_name: v.type_name, init: dl_return_expr(v.init, cleanup_all, cleanup_err), line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types }];
      return one;
    },
    ast.StmtExpr(x) => {
      let one: ast.Stmt[] = [ast.StmtExpr { value: dl_return_expr(x.value, cleanup_all, cleanup_err), line: x.line }];
      return one;
    },
    ast.StmtAssign(a) => {
      let one: ast.Stmt[] = [ast.StmtAssign { target: a.target, value: dl_return_expr(a.value, cleanup_all, cleanup_err), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }];
      return one;
    },
    ast.StmtIf(f) => {
      let one: ast.Stmt[] = [s_if(dl_return_expr(f.cond, cleanup_all, cleanup_err), dl_expand_returns(f.then_body, cleanup_all, cleanup_err), dl_expand_returns(f.else_body, cleanup_all, cleanup_err))];
      return one;
    },
    ast.StmtWhile(w) => {
      let wl: ast.StmtWhile = ast.StmtWhile { cond: dl_return_expr(w.cond, cleanup_all, cleanup_err), body: w.body, label: w.label, line: w.line, is_loop: w.is_loop };
      let one: ast.Stmt[] = [dl_while(wl, dl_expand_returns(w.body, cleanup_all, cleanup_err))];
      return one;
    },
    ast.StmtFor(fr) => {
      let fl: ast.StmtFor = ast.StmtFor { var_name: fr.var_name, iter: dl_return_expr(fr.iter, cleanup_all, cleanup_err), body: fr.body, label: fr.label, line: fr.line };
      let one: ast.Stmt[] = [dl_for(fl, dl_expand_returns(fr.body, cleanup_all, cleanup_err))];
      return one;
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let i: i32 = 0;
      while (i < m.arms.len()) {
        arms = arms.append(ast.MatchArm { pattern: m.arms[i].pattern, body: dl_expand_returns(m.arms[i].body, cleanup_all, cleanup_err), line: m.arms[i].line, col: m.arms[i].col, guard: dl_return_expr(m.arms[i].guard, cleanup_all, cleanup_err), has_guard: m.arms[i].has_guard, alt_cont: false });
        i = i + 1;
      }
      let one: ast.Stmt[] = [s_match(dl_return_expr(m.scrutinee, cleanup_all, cleanup_err), arms)];
      return one;
    },
    _ => {
      let one: ast.Stmt[] = [st];
      return one;
    }
  }
}

// CapLift records a capturing recursive local that was lambda-lifted: its
// (now top-level) name and the ordered list of enclosing names it
// captured. hoist_local_funcs_module uses it to rewrite the *enclosing*
// body's calls `f(args)` → `f(args, cap1, …)`; the recursive calls inside
// the lifted body are rewritten at lift time.
pub struct CapLift { name: string, caps: string[] }

function hl_no_lifts(): CapLift[] {
  let e: CapLift[] = [];

  return e;
}

function hl_append_lifts(a: CapLift[], b: CapLift[]): CapLift[] {
  let out: CapLift[] = a;
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

function hl_param_names(params: ast.ParamDecl[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < params.len()) {
    out = out.append(params[i].name);
    i = i + 1;
  }
  return out;
}

function hl_append_str(a: string[], b: string[]): string[] {
  let out: string[] = a;
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

// hl_collect_var_names collects the `let` names a statement subtree declares —
// deliberately ONLY let names, not for-binders or pattern binders, and
// deliberately not into lambda bodies: it feeds hl_capture_list's shadow list,
// where an inner lambda's locals would suppress a capture the lift needs. The
// statement spine is that stop spelled once — a lambda body is reachable only
// through expression descent.
function hl_collect_var_names(stmts: ast.Stmt[]): string[] {
  function vs(st: ast.Stmt, own acc: string[]): string[] {
    match (st) {
      ast.StmtVar(v) => {
        return acc.append(v.name);
      },
      _ => {
        return acc;
      }
    }
    return acc;
  }
  let out: string[] = [];
  for st in stmts {
    out = astwalk.fold_stmt_spine(st, out, vs);
  }
  return out;
}

// NestedFn is a nested `function` declaration and the nested functions of the
// same statement list its body names.
pub struct NestedFn { name: string, lam: ast.ExprLambda, refs: string[] }

function hl_add_nested_fn(st: ast.Stmt, own acc: NestedFn[]): NestedFn[] {
  if let ast.StmtVar(v) = st {
    if let ast.ExprLambda(lam) = v.init {
      if (ast.var_binds_itself(v)) {
        return acc.append(NestedFn { name: v.name, lam: lam, refs: [] });
      }
    }
  }
  return acc;
}

function hl_link(found: NestedFn[]): NestedFn[] {
  let out: NestedFn[] = [];
  for sb in found {
    let refs: string[] = [];
    for other in found {
      if (!util.has_str(refs, other.name) && stmts_mention(sb.lam.body, other.name)) {
        refs = refs.append(other.name);
      }
    }
    out = out.append(NestedFn { ...sb, refs: refs });
  }
  return out;
}

// nested_fns returns the nested functions declared directly in `stmts`.
pub function nested_fns(stmts: ast.Stmt[]): NestedFn[] {
  let found: NestedFn[] = [];
  for st in stmts {
    found = hl_add_nested_fn(st, found);
  }
  return hl_link(found);
}

function hl_refs(sibs: NestedFn[], name: string): string[] {
  for sb in sibs {
    if (sb.name == name) {
      return sb.refs;
    }
  }
  let none: string[] = [];
  return none;
}

// hl_reach returns the siblings reachable from `from` through one or more
// references.
function hl_reach(sibs: NestedFn[], from: string): string[] {
  let seen: string[] = hl_refs(sibs, from);
  let i: i32 = 0;
  while (i < seen.len()) {
    for r in hl_refs(sibs, seen[i]) {
      if (!util.has_str(seen, r)) {
        seen = seen.append(r);
      }
    }
    i = i + 1;
  }
  return seen;
}

// nested_fn_cycle returns the siblings on a reference cycle through `name`,
// itself included and in declaration order, or none when no cycle passes
// through it. A forward reference that closes no cycle stays undefined, as in
// native's checkBlock (detectMutualRecSCCs).
pub function nested_fn_cycle(sibs: NestedFn[], name: string): string[] {
  let out: string[] = [];
  let reach: string[] = hl_reach(sibs, name);
  if (!util.has_str(reach, name)) {
    return out;
  }
  for sb in sibs {
    if (sb.name == name || util.has_str(reach, sb.name) && util.has_str(hl_reach(sibs, sb.name), name)) {
      out = out.append(sb.name);
    }
  }
  return out;
}

// hl_has_rec_local reports whether a statement list, or one hl_rewrite reaches
// from it (a nested block's, or the body of a lambda a `let` holds), holds a
// nested function on a reference cycle. A body with none is left untouched, so
// the self-host's own sources (which use none) pass through byte-for-byte,
// keeping the stage-2 fixpoint intact.
function hl_has_rec_local(stmts: ast.Stmt[]): boolean {
  if (hl_list_has_cycle(stmts)) {
    return true;
  }
  function vs(st: ast.Stmt, own hit: boolean): boolean {
    return hit || hl_owned_lists_have_cycle(st);
  }
  for st in stmts {
    if (astwalk.fold_stmt_spine(st, false, vs)) {
      return true;
    }
  }
  return false;
}

// hl_owned_lists_have_cycle checks the statement lists `st` owns directly; the
// spine reaches the ones nested deeper. It enters no expression, so a lambda a
// `let` holds is searched here.
function hl_owned_lists_have_cycle(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtVar(v) => {
      if let ast.ExprLambda(lam) = v.init {
        return hl_has_rec_local(lam.body);
      }
      return false;
    },
    ast.StmtIf(f) => {
      return hl_list_has_cycle(f.then_body) || hl_list_has_cycle(f.else_body);
    },
    ast.StmtWhile(w) => {
      return hl_list_has_cycle(w.body);
    },
    ast.StmtFor(fr) => {
      return hl_list_has_cycle(fr.body);
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        if (hl_list_has_cycle(arm.body)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function hl_list_has_cycle(stmts: ast.Stmt[]): boolean {
  let sibs: NestedFn[] = nested_fns(stmts);
  for sb in sibs {
    if (nested_fn_cycle(sibs, sb.name).len() > 0) {
      return true;
    }
  }
  return false;
}

// hl_capture_list returns the ordered, de-duplicated list of enclosing names a
// lifted lambda captures — the extra parameters the lambda-lift appends. The
// functions lifted with it (`lifted`) are called directly, not captured.
function hl_capture_list(lam: ast.ExprLambda, lifted: string[], enclosing: string[]): string[] {
  let shadow: string[] = hl_param_names(lam.params);
  shadow = hl_append_str(shadow, hl_collect_var_names(lam.body));
  let caps: string[] = [];
  let i: i32 = 0;
  while (i < enclosing.len()) {
    let e: string = enclosing[i];
    if (!util.has_str(lifted, e) && !util.has_str(shadow, e) && !util.has_str(caps, e)) {
      if (stmts_mention(lam.body, e)) {
        caps = caps.append(e);
      }
    }
    i = i + 1;
  }
  return caps;
}

// hl_cycle_captures is the union of the captures of every function on a cycle:
// each one passes all of them along, since any call around the cycle can reach
// a member that reads one.
function hl_cycle_captures(sibs: NestedFn[], cycle: string[], enclosing: string[]): string[] {
  let caps: string[] = [];
  for sb in sibs {
    if (util.has_str(cycle, sb.name)) {
      for c in hl_capture_list(sb.lam, cycle, enclosing) {
        if (!util.has_str(caps, c)) {
          caps = caps.append(c);
        }
      }
    }
  }
  return caps;
}

// rw_call_of is the capture-threading rewrite's ONLY changed node: a direct
// call of the lifted function gains that function's captures as trailing ident
// arguments. Every other node is rebuilt verbatim around its rewritten
// children, which is map_expr's contract, so nothing else is spelled here.
//
// Using map_expr also stops the rebuild LOSING fields. The hand-written walk
// rebuilt through the e_* / s_* constructor helpers, which take only the
// children and fill the rest with defaults — so a binary or unary inside a
// lifted body came back with line 0, col 0 and an empty `ty`, and a `while`
// came back with no label and is_loop false. The functional update map_expr
// and map_stmt use carries all of them through untouched.
function rw_call_of(x: ast.Expr, fname: string, caps: string[]): ast.Expr {
  match (x) {
    ast.ExprCall(c) => {
      let is_target: boolean = false;
      match (c.callee) {
        ast.ExprIdent(id) => {
          if (id.name == fname) {
            is_target = true;
          }
        },
        _ => {}
      }
      if (!is_target) {
        return x;
      }
      let new_args: ast.Expr[] = c.args;
      for cp in caps {
        new_args = new_args.append(e_ident(cp));
      }
      return ast.ExprCall { ...c, args: new_args };
    },
    _ => {
      return x;
    }
  }
  return x;
}

// rw_call_stmts appends `caps` (as ident arguments) to every call of `fname`
// in a statement list. Used by the lambda-lift to thread a lifted function's
// captured variables through its call sites.
function rw_call_stmts(stmts: ast.Stmt[], fname: string, caps: string[]): ast.Stmt[] {
  function rw(x: ast.Expr): ast.Expr {
    return rw_call_of(x, fname, caps);
  }
  return astwalk.map_stmts(stmts, rw);
}

// The names a lift can capture at a point in a body, and what the front end
// can already tell of their types: a parameter's or a `let`'s written type, or
// the syntactic type of an unannotated `let`'s initialiser. A lifted function's
// capture parameter takes that type, "" when nothing is known.
struct HlScope { names: string[], env: MEnv, fns: MFns }

// The scope a lambda's body sees: the enclosing names and its own.
function hl_lambda_scope(sc: HlScope, lam: ast.ExprLambda): HlScope {
  let names: string[] = hl_append_str(hl_append_str(sc.names, hl_param_names(lam.params)), hl_collect_var_names(lam.body));
  let pe: MEnv = me_env_from_params(lam.params);
  let env: MEnv = MEnv { mnames: hl_append_str(sc.env.mnames, pe.mnames), mtypes: hl_append_str(sc.env.mtypes, pe.mtypes) };
  return HlScope { ...sc, names: names, env: env };
}

function hl_var_type(v: ast.StmtVar, sc: HlScope): string {
  if (v.type_name.len() > 0) {
    return v.type_name;
  }
  return mono_infer(v.init, sc.env, sc.fns);
}

// A function type's spelling is the coarse `fn` tag plus sidecars a bare type
// name cannot carry, so such a capture stays untyped.
function hl_cap_type(sc: HlScope, name: string): string {
  let t: string = sc.env.elook(name);
  if (t == "fn" || util.contains(t, "=>")) {
    return "";
  }
  return t;
}

function hl_rewrite_match(m: ast.StmtMatch, sc: HlScope, hoisted: FuncDecl[]): (ast.Stmt[], FuncDecl[], CapLift[]) {
  let arms: ast.MatchArm[] = [];
  let acc: FuncDecl[] = hoisted;
  let acc_lifts: CapLift[] = hl_no_lifts();
  let a: i32 = 0;
  while (a < m.arms.len()) {
    let (ar_stmts, ar_hoisted, ar_lifts) = hl_rewrite(m.arms[a].body, sc, acc);
    acc = ar_hoisted;
    acc_lifts = hl_append_lifts(acc_lifts, ar_lifts);
    arms = arms.append(ast.MatchArm { pattern: m.arms[a].pattern, body: ar_stmts, line: m.arms[a].line, col: m.arms[a].col, guard: m.arms[a].guard, has_guard: m.arms[a].has_guard, alt_cont: false });
    a = a + 1;
  }
  return ([s_match_at(m.scrutinee, arms, m.line, m.col)], acc, acc_lifts);
}

// hl_rewrite lifts the nested functions on a reference cycle out of a
// statement list. A body with none is returned verbatim (the precheck) — so only
// functions that actually use the feature are ever rebuilt.
function hl_rewrite(stmts: ast.Stmt[], outer: HlScope, hoisted: FuncDecl[]): (ast.Stmt[], FuncDecl[], CapLift[]) {
  if (!hl_has_rec_local(stmts)) {
    return (stmts, hoisted, hl_no_lifts());
  }
  let out: ast.Stmt[] = [];
  let acc: FuncDecl[] = hoisted;
  let acc_lifts: CapLift[] = hl_no_lifts();
  let sc: HlScope = outer;
  let sibs: NestedFn[] = nested_fns(stmts);
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtVar(v) => {
        // A nested function on a reference cycle (`let f = <lambda
        // mentioning f>`, or siblings calling each other) is lifted out;
        // everything else passes through as the ORIGINAL stmts[i]
        // (re-wrapping the unwrapped payload via `[v]` would drop it).
        let did_lift: boolean = false;
        match (v.init) {
          ast.ExprLambda(lam) => {
            let cycle: string[] = nested_fn_cycle(sibs, v.name);
            if (cycle.len() > 0) {
              did_lift = true;
              // Captured enclosing names become trailing
              // parameters (lambda-lifting); a capture-free
              // local just keeps its parameter list. A capture this
              // function only forwards around the cycle, under a name
              // its own body rebinds, gets a parameter name of its own.
              let caps: string[] = hl_cycle_captures(sibs, cycle, sc.names);
              let own_names: string[] = hl_append_str(hl_param_names(lam.params), hl_collect_var_names(lam.body));
              let fwd: string[] = [];
              let new_params: ast.ParamDecl[] = lam.params;
              let ci: i32 = 0;
              while (ci < caps.len()) {
                let pname: string = caps[ci];
                if (util.has_str(own_names, pname)) {
                  pname = "__cap_" + pname;
                }
                fwd = fwd.append(pname);
                new_params = new_params.append(ast.ParamDecl { name: pname, type_name: hl_cap_type(sc, caps[ci]), own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" });
                ci = ci + 1;
              }
              // Hoist nested recursive locals first; inside the
              // lifted function the captures are in scope as params.
              let inner_encl: string[] = hl_param_names(new_params);
              inner_encl = hl_append_str(inner_encl, hl_collect_var_names(lam.body));
              let inner: HlScope = HlScope { ...sc, names: inner_encl, env: me_env_from_params(new_params) };
              let (ir_stmts, ir_hoisted, ir_lifts) = hl_rewrite(lam.body, inner, acc);
              acc = ir_hoisted;
              acc_lifts = hl_append_lifts(acc_lifts, ir_lifts);
              // Thread the captures through the calls around the cycle.
              let lifted_body: ast.Stmt[] = ir_stmts;
              if (caps.len() > 0) {
                for member in cycle {
                  lifted_body = rw_call_stmts(lifted_body, member, fwd);
                }
              }
              let notp: string[] = [];
              acc = acc.append(FuncDecl {
                stdlib: "", no_inline: false,
                name: v.name, receiver_name: "", receiver_type: "", receiver_own: false,
                type_params: notp, params: new_params, ret_type: lam.ret_type,
                body: lifted_body, line: v.line, col: v.col,
                import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
                is_pub: true,
                is_const: false, ret_fn_ret: lam.ret_fn_ret, ret_fn_param_types: lam.ret_fn_param_types, is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [],
              });
              if (caps.len() > 0) {
                acc_lifts = acc_lifts.append(CapLift { name: v.name, caps: caps });
              }
            }
          },
          _ => {}
        }
        if (!did_lift) {
          let kept: ast.Stmt = stmts[i];
          if let ast.ExprLambda(lam) = v.init {
            // A lambda left in place still lifts the cycles in its own body.
            let (lb_stmts, lb_hoisted, lb_lifts) = hl_rewrite(lam.body, hl_lambda_scope(sc, lam), acc);
            if (lb_hoisted.len() > acc.len()) {
              kept = ast.StmtVar { ...v, init: ast.ExprLambda { ...lam, body: lb_stmts } };
            }
            acc = lb_hoisted;
            acc_lifts = hl_append_lifts(acc_lifts, lb_lifts);
          }
          sc = HlScope { ...sc, env: sc.env.ebind(v.name, hl_var_type(v, sc)) };
          out = out.append(kept);
        }
      },
      ast.StmtIf(f) => {
        let (tr_stmts, tr_hoisted, tr_lifts) = hl_rewrite(f.then_body, sc, acc);
        acc = tr_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, tr_lifts);
        let (er_stmts, er_hoisted, er_lifts) = hl_rewrite(f.else_body, sc, acc);
        acc = er_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, er_lifts);
        out = out.append(s_if(f.cond, tr_stmts, er_stmts));
      },
      ast.StmtWhile(w) => {
        let (wr_stmts, wr_hoisted, wr_lifts) = hl_rewrite(w.body, sc, acc);
        acc = wr_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, wr_lifts);
        out = out.append(s_while(w.cond, wr_stmts));
      },
      ast.StmtFor(fr) => {
        let (fr2_stmts, fr2_hoisted, fr2_lifts) = hl_rewrite(fr.body, sc, acc);
        acc = fr2_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, fr2_lifts);
        out = out.append(s_for(fr.var_name, fr.iter, fr2_stmts));
      },
      ast.StmtMatch(m) => {
        let (mr_stmts, mr_hoisted, mr_lifts) = hl_rewrite_match(m, sc, acc);
        acc = mr_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, mr_lifts);
        let km: i32 = 0;
        while (km < mr_stmts.len()) {
          out = out.append(mr_stmts[km]);
          km = km + 1;
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        let (dr_stmts, dr_hoisted, dr_lifts) = hl_rewrite(one, sc, acc);
        acc = dr_hoisted;
        acc_lifts = hl_append_lifts(acc_lifts, dr_lifts);
        if (dr_stmts.len() >= 1) {
          out = out.append(s_defer(dr_stmts[0]));
        }
      },
      _ => {
        out = out.append(stmts[i]);
      }
    }
    i = i + 1;
  }
  return (out, acc, acc_lifts);
}

// hl_apply_lifts rewrites a (host) statement list's calls to each
// lambda-lifted function, appending that function's captured names as
// trailing arguments — the external counterpart to the recursive-call
// rewrite done at lift time.
function hl_apply_lifts(stmts: ast.Stmt[], lifts: CapLift[]): ast.Stmt[] {
  let out: ast.Stmt[] = stmts;
  let i: i32 = 0;
  while (i < lifts.len()) {
    if (lifts[i].caps.len() > 0) {
      out = rw_call_stmts(out, lifts[i].name, lifts[i].caps);
    }
    i = i + 1;
  }
  return out;
}

pub function hoist_local_funcs_module(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let hoisted: FuncDecl[] = [];
  let fns: MFns = mfns_of(mod.funcs, mod.structs, mod.enums, mod.impls);
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fn: FuncDecl = mod.funcs[i];
    let encl: string[] = hl_param_names(fn.params);
    encl = hl_append_str(encl, hl_collect_var_names(fn.body));
    let env: MEnv = me_env_from_params(fn.params);
    if (fn.receiver_name.len() > 0) {
      env = env.ebind(fn.receiver_name, fn.receiver_type);
    }
    let (r_stmts, r_hoisted, r_lifts) = hl_rewrite(fn.body, HlScope { names: encl, env: env, fns: fns }, hoisted);
    let h: i32 = hoisted.len();
    hoisted = r_hoisted;
    while (h < hoisted.len()) {
      hoisted = hoisted.with(h, FuncDecl { ...hoisted[h], module: fn.module });
      h = h + 1;
    }
    // Rewrite this body's calls to any lambda-lifted function so the
    // captures are passed at the (now top-level) call sites.
    let fn_body: ast.Stmt[] = hl_apply_lifts(r_stmts, r_lifts);
    funcs = funcs.append(FuncDecl { ...fn, body: fn_body });
    i = i + 1;
  }
  let tencl: string[] = hl_collect_var_names(mod.top_stmts);
  let tenv: MEnv = MEnv { mnames: [], mtypes: [] };
  let (tr_stmts, tr_hoisted, tr_lifts) = hl_rewrite(mod.top_stmts, HlScope { names: tencl, env: tenv, fns: fns }, hoisted);
  hoisted = tr_hoisted;
  let top_body: ast.Stmt[] = hl_apply_lifts(tr_stmts, tr_lifts);
  let j: i32 = 0;
  while (j < hoisted.len()) {
    funcs = funcs.append(hoisted[j]);
    j = j + 1;
  }
  return Module { ...mod, funcs: funcs, top_stmts: top_body };
}

// ---- lifting the bindings a deferred action names ---------------------------

// A deferred action is replayed at the exits of the scope that registered it,
// and a binding declared in a block INSIDE that scope has no slot there: the
// interpreter read whatever the name last meant and the semantic lowering
// refused the whole function ("unbound name is not a semantic value"). The
// lift below moves such a declaration to the top of the scope and leaves its
// initialiser behind as an assignment, so the slot spans the replay while the
// value still arrives where the block put it. Lexical resolution has already
// given every declaration a unique symbol, so the lift cannot shadow anything.
//
// DeferHoist is the statement half of the walk: the rewritten statements, and
// the declarations lifted out of the blocks inside them.
struct DeferHoist { stmts: ast.Stmt[], decls: ast.Stmt[] }

// DeferHoistExpr is the expression half. A value block's body is lifted the
// same way — every backend inlines one into the enclosing function, so its
// declarations belong to that function's scope.
struct DeferHoistExpr { expr: ast.Expr, decls: ast.Stmt[] }

// Every annotation can be lifted: ExprZero names the type and reaches each
// engine as the constant zero of it, so a struct, an enum, a tuple and a cell
// lift like a scalar. A declaration with NO annotation still cannot — the
// desugar runs before the checker and has nothing to name.
function dl_zeroable(t: string): boolean {
  return t.len() > 0 && !is_destr_marker(t);
}

// The value a lifted declaration starts at. Nothing reads the slot before the
// assignment left at the declaration site: a replay whose block never ran is
// behind a flag that never armed. A reference type's zero is the null word, so
// the lift costs a slot and not a box — the `[]` and `""` this used to write
// allocated one per call of the function that declared the binding.
function dl_zero_of(t: string): ast.Expr {
  return ast.ExprZero { type_name: t, line: 0, col: 0 };
}

function dl_add_name(own acc: string[], name: string): string[] {
  if (name.len() == 0 || util.has_str(acc, name)) {
    return acc;
  }
  return acc.append(name);
}

// An action names a binding by writing it as much as by reading it: an
// assignment carries its target as a string, which no expression walk sees.
function dl_name_stmt(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtAssign(a) = st {
    return dl_add_name(acc, a.target);
  }
  return acc;
}

function dl_name_expr(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprIdent(id) = e {
    return dl_add_name(acc, id.name);
  }
  return acc;
}

function dl_name_descend(e: ast.Expr): boolean {
  return true;
}

function dl_action_names(actions: ast.Stmt[]): string[] {
  let acc: string[] = [];
  for a in actions {
    acc = astwalk.fold_stmt_nodes(a, acc, dl_name_stmt, dl_name_expr, dl_name_descend);
  }
  return acc;
}

function dl_hoist_stmts(stmts: ast.Stmt[], want: string[], nested: boolean): DeferHoist {
  let out: ast.Stmt[] = [];
  let decls: ast.Stmt[] = [];
  for st in stmts {
    let r: DeferHoist = dl_hoist_stmt(st, want, nested);
    out = util.append_all(out, r.stmts);
    decls = util.append_all(decls, r.decls);
  }
  return DeferHoist { stmts: out, decls: decls };
}

function dl_hoist_var(v: ast.StmtVar, want: string[], nested: boolean): DeferHoist {
  let ir: DeferHoistExpr = dl_hoist_expr(v.init, want);
  if (!nested || !util.has_str(want, v.name) || !dl_zeroable(v.type_name)) {
    let kept: ast.Stmt[] = [ast.StmtVar { ...v, init: ir.expr }];
    return DeferHoist { stmts: kept, decls: ir.decls };
  }
  let lifted: ast.Stmt[] = [s_var(v.name, v.type_name, dl_zero_of(v.type_name))];
  let one: ast.Stmt[] = [s_assign_at(v.name, ir.expr, v.line, v.col, v.line, v.col)];
  return DeferHoist { stmts: one, decls: util.append_all(lifted, ir.decls) };
}

// A `defer`'s own action is not walked: it is replayed as written, and a
// declaration inside it belongs to the replay, not to this scope.
function dl_hoist_stmt(st: ast.Stmt, want: string[], nested: boolean): DeferHoist {
  match (st) {
    ast.StmtVar(v) => {
      return dl_hoist_var(v, want, nested);
    },
    ast.StmtIf(f) => {
      let cr: DeferHoistExpr = dl_hoist_expr(f.cond, want);
      let tr: DeferHoist = dl_hoist_stmts(f.then_body, want, true);
      let er: DeferHoist = dl_hoist_stmts(f.else_body, want, true);
      let one: ast.Stmt[] = [s_if(cr.expr, tr.stmts, er.stmts)];
      return DeferHoist { stmts: one, decls: util.append_all(util.append_all(cr.decls, tr.decls), er.decls) };
    },
    ast.StmtWhile(w) => {
      let cw: DeferHoistExpr = dl_hoist_expr(w.cond, want);
      let br: DeferHoist = dl_hoist_stmts(w.body, want, true);
      let one: ast.Stmt[] = [dl_while(ast.StmtWhile { ...w, cond: cw.expr }, br.stmts)];
      return DeferHoist { stmts: one, decls: util.append_all(cw.decls, br.decls) };
    },
    ast.StmtFor(fr) => {
      let itr: DeferHoistExpr = dl_hoist_expr(fr.iter, want);
      let br: DeferHoist = dl_hoist_stmts(fr.body, want, true);
      let one: ast.Stmt[] = [dl_for(ast.StmtFor { ...fr, iter: itr.expr }, br.stmts)];
      return DeferHoist { stmts: one, decls: util.append_all(itr.decls, br.decls) };
    },
    ast.StmtMatch(m) => {
      return dl_hoist_match(m, want);
    },
    ast.StmtReturn(r) => {
      let vr: DeferHoistExpr = dl_hoist_expr(r.value, want);
      let one: ast.Stmt[] = [ast.StmtReturn { ...r, value: vr.expr }];
      return DeferHoist { stmts: one, decls: vr.decls };
    },
    ast.StmtExpr(x) => {
      let xr: DeferHoistExpr = dl_hoist_expr(x.value, want);
      let one: ast.Stmt[] = [ast.StmtExpr { ...x, value: xr.expr }];
      return DeferHoist { stmts: one, decls: xr.decls };
    },
    ast.StmtAssign(a) => {
      let ar: DeferHoistExpr = dl_hoist_expr(a.value, want);
      let one: ast.Stmt[] = [ast.StmtAssign { ...a, value: ar.expr }];
      return DeferHoist { stmts: one, decls: ar.decls };
    },
    ast.StmtBreak(_) => {},
    ast.StmtContinue(_) => {},
    ast.StmtUnknown(_) => {},
    ast.StmtDefer(_) => {}
  }
  let same: ast.Stmt[] = [st];
  let none: ast.Stmt[] = [];
  return DeferHoist { stmts: same, decls: none };
}

function dl_hoist_match(m: ast.StmtMatch, want: string[]): DeferHoist {
  let sr: DeferHoistExpr = dl_hoist_expr(m.scrutinee, want);
  let decls: ast.Stmt[] = sr.decls;
  let arms: ast.MatchArm[] = [];
  for a in m.arms {
    let gr: DeferHoistExpr = dl_hoist_expr(a.guard, want);
    let ar: DeferHoist = dl_hoist_stmts(a.body, want, true);
    arms = arms.append(ast.MatchArm { ...a, guard: gr.expr, body: ar.stmts });
    decls = util.append_all(util.append_all(decls, gr.decls), ar.decls);
  }
  let one: ast.Stmt[] = [s_match(sr.expr, arms)];
  return DeferHoist { stmts: one, decls: decls };
}

function dl_hoist_expr(e: ast.Expr, want: string[]): DeferHoistExpr {
  if let ast.ExprCall(c) = e {
    if (is_value_block(c)) {
      if let ast.ExprLambda(l) = c.callee {
        let vb: DeferHoist = dl_hoist_stmts(l.body, want, true);
        return DeferHoistExpr { expr: dl_vb_rebuild(c, vb.stmts), decls: vb.decls };
      }
    }
  }
  let kids: ast.Expr[] = dl_expr_kids(e);
  let none: ast.Stmt[] = [];
  if (kids.len() == 0) {
    return DeferHoistExpr { expr: e, decls: none };
  }
  let out: ast.Expr[] = [];
  let decls: ast.Stmt[] = none;
  for k in kids {
    let r: DeferHoistExpr = dl_hoist_expr(k, want);
    out = out.append(r.expr);
    decls = util.append_all(decls, r.decls);
  }
  return DeferHoistExpr { expr: dl_expr_with_kids(e, out), decls: decls };
}

// The shared return temp every expanded `return` writes before the cleanup
// runs. It carries the scope's return type, started at that type's zero; a
// scope with no spelled return type (a lambda whose result is inferred) keeps
// an untyped `0`.
function dl_defret_decl(ret: string, fn_ret: string, fn_param_types: string): ast.Stmt {
  if (!dl_zeroable(ret)) {
    return s_var("__defret", "", e_number("0", "", false));
  }
  return ast.StmtVar { name: "__defret", type_name: ret, init: dl_zero_of(ret), line: 0, col: 0, fn_ret: fn_ret, fn_param_types: fn_param_types };
}

function dl_param_names(params: ast.ParamDecl[]): string[] {
  let out: string[] = [];
  for p in params {
    out = out.append(p.name);
  }
  return out;
}

function dl_count_str(xs: string[], name: string): i32 {
  let n: i32 = 0;
  for x in xs {
    if (x == name) {
      n = n + 1;
    }
  }
  return n;
}

function dl_name_keep(e: ast.Expr, own acc: string[]): string[] {
  return acc;
}

// The lift merges a block's binding with the scope's, so it is sound only for
// a name the scope declares ONCE. Lexical resolution gives every declaration a
// unique symbol and the compiled path runs it first, but the interpreter
// evaluates the parse-time tree, where
// two blocks can each write `let items`. Lifting both would give them one slot.
// The count reaches into value blocks and lambda bodies, so a name declared
// there counts as well — over-approximating, which costs a lift that would
// have been sound rather than making an unsound one.
function dl_hoistable(want: string[], src: ast.Stmt[], params: string[]): string[] {
  let bound: string[] = [];
  for p in params {
    bound = astwalk.append_bound_name(bound, p);
  }
  for st in src {
    bound = astwalk.fold_stmt_nodes(st, bound, astwalk.binders_of, dl_name_keep, dl_name_descend);
  }
  let out: string[] = [];
  for w in want {
    if (dl_count_str(bound, w) < 2) {
      out = out.append(w);
    }
  }
  return out;
}

// dl_hoist_scope is the pass over one scope: collect what its defers name,
// lift the declarations that answer, and put them in front of the body.
function dl_hoist_scope(src: ast.Stmt[], params: string[]): ast.Stmt[] {
  let empty: ast.Stmt[] = [];
  let emptyf: i32[] = [];
  let probe: DeferAcc = dl_collect_stmts(src, empty, emptyf);
  if (probe.actions.len() == 0) {
    return src;
  }
  let want: string[] = dl_hoistable(dl_action_names(probe.actions), src, params);
  if (want.len() == 0) {
    return src;
  }
  let h: DeferHoist = dl_hoist_stmts(src, want, false);
  if (h.decls.len() == 0) {
    return src;
  }
  return util.append_all(h.decls, h.stmts);
}

pub function lower_defers_func(fn: FuncDecl): FuncDecl {
  // The walks below REBUILD every expression they pass, and on a function with
  // no `defer` they throw the copy away. This pre-scan allocates nothing, so
  // the rebuild is confined to the functions that need it. It looks INSIDE
  // lambda bodies too, because a function whose only defer sits in one still
  // has work to do — see dl_stmts_have_defer_deep.
  if (!dl_stmts_have_defer_deep(fn.body)) {
    return fn;
  }
  let pnames: string[] = [];
  for p in fn.params {
    pnames = pnames.append(p.name);
  }
  if (fn.receiver_name.len() > 0) {
    pnames = pnames.append(fn.receiver_name);
  }
  return FuncDecl { ...fn, body: lower_defers_body(fn.body, pnames, fn.ret_type, fn.ret_fn_ret, fn.ret_fn_param_types) };
}

// lower_defers_body is the per-SCOPE half of the pass. An ordinary lambda body
// is a scope of its own — its defers run when IT returns, not when the
// enclosing function does — so each is lowered here first, with its own
// `__defret` / `__dfaN` locals, and only then is the enclosing body collected.
//
// A VALUE BLOCK is excluded: despite matching the same shape (a zero-arg call
// of a zero-param lambda) it is not a call at all but the desugar of an
// if-/match-expression or comprehension, which the lowering inlines. Lowering one as
// a scope would put `__defret` locals inside it.
// Its defers belong to the
// enclosing function, which is why dl_expr_has_defer looks through one.
//
// Doing this at parse time also puts the replayed actions in front of the lift's
// capture rewrite. Lowering only after lambda lifting left
// an assignment inside a deferred action writing a stack local instead of the
// captured env slot — the deferred code ran and its result was discarded
// (#7174).
function lower_defers_body(body0: ast.Stmt[], params: string[], ret: string, fn_ret: string, fn_param_types: string): ast.Stmt[] {
  // Inner scopes first: each ordinary lambda in `body0` is lowered on its own
  // before this scope collects, so the collect below sees no lambda defers.
  let src: ast.Stmt[] = dl_lower_lambda_bodies(body0);
  if (!dl_stmts_have_defer(src)) {
    return src;
  }
  src = dl_hoist_scope(src, params);
  let empty: ast.Stmt[] = [];
  let emptyf: i32[] = [];
  let cr: DeferAcc = dl_collect_stmts(src, empty, emptyf);
  if (cr.actions.len() == 0) {
    return src;
  }
  // cleanup_all = plain defers (every return + falloff); cleanup_err =
  // errdefers (only on a None/Err return). For a defer-only function
  // cleanup_err is empty and this is byte-identical to the old lowering.
  let cleanup: ast.Stmt[] = dl_cleanup_kind(cr.actions, cr.flags, 0);
  let cleanup_err: ast.Stmt[] = dl_cleanup_kind(cr.actions, cr.flags, 1);
  let expanded: ast.Stmt[] = dl_expand_returns(cr.stmts, cleanup, cleanup_err);
  let body: ast.Stmt[] = [];
  // The shared return temp, which a void return never writes, and a
  // boolean flag per defer.
  if (ret != "void") {
    body = body.append(dl_defret_decl(ret, fn_ret, fn_param_types));
  }
  let i: i32 = 0;
  while (i < cr.actions.len()) {
    body = body.append(s_var("__dfa" + dl_itoa(i), "boolean", e_bool(false)));
    i = i + 1;
  }
  // `?`-edge cleanup markers (#4334): the try operator is lowered long after
  // this parse-time pass (in semsource), so its implicit early return
  // can't be expanded here like a StmtReturn. Instead, embed both cleanup
  // lists in the body behind never-true guards; semsource recognises the
  // guard idents and replays the guarded statements at the `?` failure edge
  // (plain defers first, then errdefers — native's TryOp order). The guards
  // are ordinary always-false flags, so on any consumer that does NOT know
  // the markers these blocks are dead code and the lowering is behaviourally
  // unchanged.
  body = body.append(s_var(DFA_TRYALL, "boolean", e_bool(false)));
  body = body.append(s_var(DFA_TRYERR, "boolean", e_bool(false)));
  let k: i32 = 0;
  while (k < expanded.len()) {
    body = body.append(expanded[k]);
    k = k + 1;
  }
  // Falloff cleanup (a function that returns on every path leaves this
  // unreachable; a void function that falls off runs it).
  let c: i32 = 0;
  while (c < cleanup.len()) {
    body = body.append(cleanup[c]);
    c = c + 1;
  }
  let noelse: ast.Stmt[] = [];
  body = body.append(s_if(e_ident(DFA_TRYALL), cleanup, noelse));
  body = body.append(s_if(e_ident(DFA_TRYERR), cleanup_err, noelse));
  return body;
}

// dl_lower_lambda_bodies lowers the defers of every ORDINARY lambda in `stmts`,
// each as its own scope. A value block's callee lambda is skipped — it is an
// inlined if-/match-expression desugar, not a call, so its defers belong to the
// enclosing function — but the walk still enters it to reach ordinary lambdas
// nested inside.
function dl_lower_lambda_bodies(stmts: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(dl_ll_stmt(stmts[i]));
    i = i + 1;
  }
  return out;
}

// dl_ll_stmt carries the walk through one statement: its own expressions via
// dl_ll_expr, and any statement list it encloses via dl_lower_lambda_bodies.
function dl_ll_stmt(st: ast.Stmt): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { ...v, init: dl_ll_expr(v.init) };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { ...r, value: dl_ll_expr(r.value) };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { ...x, value: dl_ll_expr(x.value) };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { ...a, value: dl_ll_expr(a.value) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: dl_ll_expr(f.cond), then_body: dl_lower_lambda_bodies(f.then_body), else_body: dl_lower_lambda_bodies(f.else_body) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, cond: dl_ll_expr(w.cond), body: dl_lower_lambda_bodies(w.body) };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { ...fo, iter: dl_ll_expr(fo.iter), body: dl_lower_lambda_bodies(fo.body) };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let g: ast.Expr = m.arms[i].guard;
        if (m.arms[i].has_guard) {
          g = dl_ll_expr(m.arms[i].guard);
        }
        arms = arms.append(ast.MatchArm { ...m.arms[i], body: dl_lower_lambda_bodies(m.arms[i].body), guard: g });
        i = i + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: dl_ll_expr(m.scrutinee), arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: dl_ll_stmt(d.action) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function dl_ll_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, body: lower_defers_body(lm.body, dl_param_names(lm.params), lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types) };
    },
    ast.ExprCall(c) => {
      if (is_value_block(c)) {
        return dl_vb_rebuild(c, dl_lower_lambda_bodies(vb_body(c)));
      }
      // A hand-written IIFE carrying a defer becomes its own scope, and is
      // stamped so the lowering calls it instead of inlining it (#7192). The
      // ExprLambda arm below does the scoping either way; the stamp is
      // what tells the two apart afterwards.
      if (dl_is_source_iife(c)) {
        match (c.callee) {
          ast.ExprLambda(lm) => {
            if (dl_stmts_have_defer(lm.body)) {
              let scoped: ast.Expr = ast.ExprLambda { ...lm, origin: ORIGIN_IIFE_SCOPED, body: lower_defers_body(lm.body, dl_param_names(lm.params), lm.ret_type, lm.ret_fn_ret, lm.ret_fn_param_types) };
              return ast.ExprCall { ...c, callee: scoped };
            }
          },
          _ => {}
        }
      }
      return dl_ll_expr_kids(e);
    },
    _ => {
      return dl_ll_expr_kids(e);
    }
  }
  return e;
}

// dl_is_source_iife reports a zero-arg call of a zero-param lambda the
// programmer wrote — the shape a value block shares, minus the marker.
function dl_is_source_iife(c: ast.ExprCall): boolean {
  if (c.args.len() != 0) {
    return false;
  }
  match (c.callee) {
    ast.ExprLambda(lm) => {
      if (lm.params.len() != 0) {
        return false;
      }
      return !is_value_block_origin(lm.origin);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// vb_body is the statement list of a value block's callee lambda.
pub function vb_body(c: ast.ExprCall): ast.Stmt[] {
  match (c.callee) {
    ast.ExprLambda(l) => {
      return l.body;
    },
    _ => {
      let none: ast.Stmt[] = [];
      return none;
    }
  }
  let none2: ast.Stmt[] = [];
  return none2;
}

function dl_ll_expr_kids(e: ast.Expr): ast.Expr {
  return map_expr_kids(e, dl_ll_expr);
}

pub function lower_defers_module(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    funcs = funcs.append(lower_defers_func(mod.funcs[i]));
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs };
}

// ---- automatic resource-handle drop (P5 slice 3) --------------------
// Mirrors the Go internal/oracle/ir/insert_resource_drops.go. For each owned local
// (`own R`, or a bare R) of a WIT-bound resource that is not moved, insert `defer __resource_drop_R(slot);` right after
// the declaration — the fused defer expansion then runs it on every exit path
// (see drop_slot_name for the slot) — and synthesize one body-less
// `@import("<iface>","[resource-drop]<wit>")` drop
// function per dropped resource (which the world-driven composer wires).
// Borrowed handles are never dropped. Sound over complete: the ONLY occurrence
// that does not move a handle is a call argument bound to a `borrow` parameter;
// everything else moves it and leaves the drop to the consumer, because leaking
// is safe and a double drop is not.

function resource_drop_fn_name(res: string): string {
  return "__resource_drop_" + res;
}

// name_in_list is a local membership test (contains_str lives in other modules).
// name_in_list -> util.has_str (SH-020).

// handle_resource_of returns R for an owned-handle spelling — "own R", or a
// bare R that names a registered resource — else "".
function handle_resource_of(type_name: string, resources: ResourceDecl[]): string {
  if (type_name.len() >= 4 && slice_unchecked(type_name, 0, 4) == "own ") {
    return slice_unchecked(type_name, 4, type_name.len()) + "";
  }
  for rd in resources {
    if (rd.name == type_name) {
      return type_name;
    }
  }
  return "";
}

// is_reserved_enum_name reports whether `name` is one of the enums the
// front-end injects as built-ins (see checker.go's builtinEnumDecls). A
// user `enum` declaration shadowing one of these is E010.
pub function is_reserved_enum_name(name: string): boolean {
  return name == "Option" || name == "Result" || name == "IoError" || name == "JsonValue" || name == "Body";
}

// reserved_enum_tparams is the type parameters of the built-in enum `name`,
// pinned against builtinEnumDecls by the parity test in internal/check/checker.
pub function reserved_enum_tparams(name: string): string[] {
  if (name == "Option") {
    return ["T"];
  }
  if (name == "Result") {
    return ["T", "E"];
  }
  let none: string[] = [];
  return none;
}

// is_reserved_struct_name reports whether `name` is one of the structs the
// front end injects as built-ins (checker.go's builtinStructDecls). A user
// `struct` declaration shadowing one of these is E010, the struct half of the
// rule is_reserved_enum_name above carries for enums.
//
// A LIST rather than an `||` chain: at 27 names the chain stops reading,
// and it gives the parity test in internal/check/checker one thing to compare
// against builtinStructDecls() so the two cannot drift.
pub function is_reserved_struct_name(name: string): boolean {
  let reserved: string[] = [
    "BodySource", "BytesWriter", "Cell", "ChunkProducer", "Date", "DateTime", "DirEntry", "Duration", "FileStat",
    "FsStat", "HeaderMap", "HttpRequest", "HttpResponse", "Instant", "Map",
    "MapIter", "ProcessResult",
    "Reader", "Span", "Stream", "Time", "TimeZone", "Url", "WinSize", "Writer",
    "Zoned",
  ];
  return util.index_of_str(reserved, name) >= 0;
}

// reserved_struct_tparams is the type parameters of a generic built-in struct
// (builtinStructDecls again, pinned by the same parity test); empty otherwise.
pub function reserved_struct_tparams(name: string): string[] {
  if (name == "Cell") {
    return ["T"];
  }
  if (name == "Map") {
    return ["K", "V"];
  }
  if (name == "MapIter") {
    return ["K", "V"];
  }
  let none: string[] = [];
  return none;
}

// user_struct_tparams is the type parameters of the user struct `name` (an
// enum variant is not one); `found` is false when there is none.
function user_struct_tparams(mod: Module, name: string): (boolean, string[]) {
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return (true, sd.type_params);
    }
  }
  let none: string[] = [];
  return (false, none);
}

// union_alias_errors lists the E016 messages the Go checker reports while
// desugaring a union alias into an enum; the alias desugars only when the list
// is empty. A desugared alias can still be refused as E006, which
// alias_redeclares_enum reports.
pub function union_alias_errors(mod: Module, al: TypeAlias): string[] {
  let out: string[] = [];
  let (named_struct, _) = user_struct_tparams(mod, al.name);
  if (named_struct || is_reserved_struct_name(al.name)) {
    return out.append("union \"" + al.name + "\" collides with a struct of the same name");
  }
  let seen: string[] = [];
  let mi: i32 = 0;
  while (mi < al.variants.len()) {
    let m: string = al.variants[mi];
    let given: i32 = alias_member_arity(al, mi);
    mi = mi + 1;
    if (util.has_str(seen, m)) {
      out = out.append("duplicate member \"" + m + "\" in union " + al.name);
      continue;
    }
    seen = seen.append(m);
    let (found, tps) = user_struct_tparams(mod, m);
    if (!found && is_reserved_struct_name(m)) {
      found = true;
      tps = reserved_struct_tparams(m);
    }
    if (!found) {
      out = out.append("union " + al.name + " member \"" + m + "\" does not name a struct in scope");
    } else if (tps.len() == 0 && given > 0) {
      out = out.append("union " + al.name + " member \"" + m + "\" is not generic but was given " + util.i32_to_string(given) + " type argument(s)");
    } else if (tps.len() != given) {
      let params: string = "";
      for tp in tps {
        if (params.len() > 0) {
          params = params + ", ";
        }
        params = params + tp;
      }
      out = out.append("union " + al.name + " member \"" + m + "\" takes " + util.i32_to_string(tps.len()) + " type argument(s), got " + util.i32_to_string(given) + "; a generic struct member needs them supplied (e.g. `type " + al.name + "[" + params + "] = " + m + "[" + params + "] | …`)");
    }
  }
  return out;
}

// alias_member_arity is how many type arguments member `i` of `al` is written
// with.
function alias_member_arity(al: TypeAlias, i: i32): i32 {
  if (i >= al.variant_args.len() || al.variant_args[i].len() == 0) {
    return 0;
  }
  return split_top_commas(al.variant_args[i]).len();
}

// desugar_union_aliases rewrites each alias that spells type parameters or
// member arguments (`type Tree[T] = Leaf[T] | Lit;`) into the generic enum
// the Go checker desugars every union into: one variant per member, whose
// payload is the member type. A plain alias stays a struct-union, and an
// alias the checker refuses (union_alias_errors, alias_redeclares_enum) stays
// an alias for it to report.
pub function desugar_union_aliases(mod: Module): Module {
  let aliases: TypeAlias[] = [];
  let enums: EnumDecl[] = mod.enums;
  let structs: StructDecl[] = mod.structs;
  let i: i32 = 0;
  while (i < mod.aliases.len()) {
    let al: TypeAlias = mod.aliases[i];
    if (!alias_spells_args(al) || !alias_registers(mod, i)) {
      aliases = aliases.append(al);
      i = i + 1;
      continue;
    }
    let vi: i32 = 0;
    while (vi < al.variants.len()) {
      let member: string = al.variants[vi];
      let payload: string = member;
      if (vi < al.variant_args.len() && al.variant_args[vi].len() > 0) {
        payload = member + "[" + al.variant_args[vi] + "]";
      }
      structs = structs.append(StructDecl { name: member, fields: [StructFieldDecl { name: "__ev", type_name: payload, fn_ret: "", fn_param_types: "" }], type_params: [], derives: [], line: 0, col: 0, enum_owner: al.name, must_consume: false, variant_field_names: [], is_pub: true, is_package: false });
      vi = vi + 1;
    }
    enums = enums.append(EnumDecl { name: al.name, variant_names: al.variants, type_params: al.type_params, line: al.line, col: al.col, must_consume: false, try_marker: false, is_pub: al.is_pub, is_package: al.is_package, module: al.module, instance: "" });
    i = i + 1;
  }
  return Module { ...mod, aliases: aliases, structs: structs, enums: enums };
}

function alias_spells_args(al: TypeAlias): boolean {
  if (al.type_params.len() > 0) {
    return true;
  }
  for a in al.variant_args {
    if (a.len() > 0) {
      return true;
    }
  }
  return false;
}

// alias_redeclares_enum reports whether mod.aliases[idx] desugars into an enum
// whose name is already an enum's: a user or built-in enum, or an earlier alias
// that registers. The Go checker adds desugared unions after the declared
// enums, so the alias is the one refused, as E006, whatever the source order.
pub function alias_redeclares_enum(mod: Module, idx: i32): boolean {
  let al: TypeAlias = mod.aliases[idx];
  if (union_alias_errors(mod, al).len() > 0) {
    return false;
  }
  if (is_reserved_enum_name(al.name)) {
    return true;
  }
  for ed in mod.enums {
    if (ed.name == al.name) {
      return true;
    }
  }
  let j: i32 = 0;
  while (j < idx) {
    if (mod.aliases[j].name == al.name && alias_registers(mod, j)) {
      return true;
    }
    j = j + 1;
  }
  return false;
}

// alias_registers reports whether mod.aliases[idx] becomes an enum.
pub function alias_registers(mod: Module, idx: i32): boolean {
  return union_alias_errors(mod, mod.aliases[idx]).len() == 0 && !alias_redeclares_enum(mod, idx);
}

// resource_collision names what an earlier declaration makes resources[idx]'s
// name already mean — "resource", "struct" or "enum" (a union alias that
// registers is an enum, and a built-in counts as declared) — or "" when the name is free. The Go checker registers only the free ones.
pub function resource_collision(mod: Module, idx: i32): string {
  let name: string = mod.resources[idx].name;
  let j: i32 = 0;
  while (j < idx) {
    if (mod.resources[j].name == name) {
      return "resource";
    }
    j = j + 1;
  }
  if (is_reserved_struct_name(name)) {
    return "struct";
  }
  for sd in mod.structs {
    if (sd.name == name && sd.enum_owner.len() == 0) {
      return "struct";
    }
  }
  if (is_reserved_enum_name(name)) {
    return "enum";
  }
  for ed in mod.enums {
    if (ed.name == name) {
      return "enum";
    }
  }
  let ai: i32 = 0;
  while (ai < mod.aliases.len()) {
    if (mod.aliases[ai].name == name && alias_registers(mod, ai)) {
      return "enum";
    }
    ai = ai + 1;
  }
  return "";
}

// registered_resources is mod.resources less the declarations
// resource_collision refuses, so a colliding name keeps its other meaning.
pub function registered_resources(mod: Module): ResourceDecl[] {
  let out: ResourceDecl[] = [];
  let i: i32 = 0;
  while (i < mod.resources.len()) {
    if (resource_collision(mod, i).len() == 0) {
      out = out.append(mod.resources[i]);
    }
    i = i + 1;
  }
  return out;
}

function resource_binding_iface(resources: ResourceDecl[], name: string): string {
  let i: i32 = 0;
  while (i < resources.len()) {
    if (resources[i].name == name) {
      return resources[i].iface;
    }
    i = i + 1;
  }
  return "";
}

function resource_binding_wit(resources: ResourceDecl[], name: string): string {
  let i: i32 = 0;
  while (i < resources.len()) {
    if (resources[i].name == name) {
      return resources[i].wit;
    }
    i = i + 1;
  }
  return "";
}

// callee_param_is_borrow reports whether function `fname`'s parameter at
// position `pos` is a borrowed handle (`borrow …`) — the one argument position
// that does not move the handle passed to it.
function callee_param_is_borrow(funcs: FuncDecl[], fname: string, pos: i32): boolean {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == fname) {
      if (pos < funcs[i].params.len()) {
        let tn: string = funcs[i].params[pos].type_name;
        return tn.len() >= 7 && slice_unchecked(tn, 0, 7) == "borrow ";
      }
      return false;
    }
    i = i + 1;
  }
  return false;
}

// moves_net_of is the moves-handle walk's expression contribution, counted
// rather than short-circuited: an identifier reading `name` adds one, and a
// call subtracts back each immediate argument that is `name` bound to a
// `borrow` parameter — the positions the hand-written walk expressed by not
// recursing into them, and the Go movedHandles by *ast.Ident pointer identity.
// The spine visits the call before its arguments, so a subtraction can land
// before the count it cancels; only the final sum is read.
function moves_net_of(e: ast.Expr, funcs: FuncDecl[], name: string, acc: i32): i32 {
  match (e) {
    ast.ExprIdent(id) => {
      if (id.name == name) {
        return acc + 1;
      }
      return acc;
    },
    ast.ExprCall(c) => {
      let cname: string = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          cname = cid.name;
        },
        _ => {}
      }
      if (cname.len() == 0) {
        return acc;
      }
      let i: i32 = 0;
      while (i < c.args.len()) {
        match (c.args[i]) {
          ast.ExprIdent(aid) => {
            if (aid.name == name && callee_param_is_borrow(funcs, cname, i)) {
              acc = acc - 1;
            }
          },
          _ => {}
        }
        i = i + 1;
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

// moves_target_of is the statement half: an assignment's TARGET is a use of
// the name carried on the statement, which the expression visitor is never
// handed.
function moves_target_of(st: ast.Stmt, name: string, acc: i32): i32 {
  match (st) {
    ast.StmtAssign(a) => {
      if (a.target == name) {
        return acc + 1;
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

// stmts_move_handle reports whether `name` occurs anywhere other than as a
// call argument bound to a `borrow` parameter — a return, an alias, an
// assignment, a struct/array/tuple/closure capture, an argument to an
// unresolvable callee. Any such occurrence leaves the net count positive.
function stmts_move_handle(stmts: ast.Stmt[], funcs: FuncDecl[], name: string): boolean {
  function ve(e: ast.Expr, own acc: i32): i32 {
    return moves_net_of(e, funcs, name, acc);
  }
  function vs(st: ast.Stmt, own acc: i32): i32 {
    return moves_target_of(st, name, acc);
  }
  let net: i32 = 0;
  for st in stmts {
    net = astwalk.fold_stmt_nodes(st, net, vs, ve, astwalk.descend_all);
  }
  return net > 0;
}

// kept_handle_res returns the resource a declaration's owned handle is
// auto-dropped through, or "" when it is not an owned handle, its resource has
// no WIT binding to drop through, or the handle is moved. `body` is the WHOLE
// enclosing function body — a nested declaration's uses can be anywhere.
function kept_handle_res(v: ast.StmtVar, body: ast.Stmt[], resources: ResourceDecl[], funcs: FuncDecl[]): string {
  let res: string = handle_resource_of(v.type_name, resources);
  if (res.len() == 0) {
    return "";
  }
  if (resource_binding_iface(resources, res).len() == 0) {
    return "";
  }
  if (stmts_move_handle(body, funcs, v.name)) {
    return "";
  }
  return res;
}

// insert_drop_defers inserts `defer __resource_drop_R(h);` after every kept
// owned-handle declaration, recursing into nested blocks (the Go
// insertDefersInStmt). The defer is armed where the declaration is, so a block
// that never runs drops nothing.
function insert_drop_defers(stmts: ast.Stmt[], body: ast.Stmt[], resources: ResourceDecl[], funcs: FuncDecl[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    let s: ast.Stmt = stmts[i];
    let ns: ast.Stmt = s;
    match (s) {
      ast.StmtIf(f) => {
        ns = ast.StmtIf { ...f, then_body: insert_drop_defers(f.then_body, body, resources, funcs), else_body: insert_drop_defers(f.else_body, body, resources, funcs) };
      },
      ast.StmtWhile(w) => {
        ns = ast.StmtWhile { ...w, body: insert_drop_defers(w.body, body, resources, funcs) };
      },
      ast.StmtFor(fr) => {
        ns = ast.StmtFor { ...fr, body: insert_drop_defers(fr.body, body, resources, funcs) };
      },
      ast.StmtMatch(m) => {
        let arms: ast.MatchArm[] = [];
        let k: i32 = 0;
        while (k < m.arms.len()) {
          arms = arms.append(ast.MatchArm { ...m.arms[k], body: insert_drop_defers(m.arms[k].body, body, resources, funcs) });
          k = k + 1;
        }
        ns = ast.StmtMatch { ...m, arms: arms };
      },
      _ => {}
    }
    out = out.append(ns);
    match (s) {
      ast.StmtVar(v) => {
        let res: string = kept_handle_res(v, body, resources, funcs);
        if (res.len() > 0) {
          out = out.append(s_defer(s_expr(e_call(e_ident(resource_drop_fn_name(res)), [e_ident(v.name)]))));
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

// collect_dropped_resources gathers the resources the insertion drops through,
// in first-seen order — one synthesized `[resource-drop]` import func each.
function collect_dropped_resources(stmts: ast.Stmt[], body: ast.Stmt[], resources: ResourceDecl[], funcs: FuncDecl[], res_acc: string[]): string[] {
  let res_out: string[] = res_acc;
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtVar(v) => {
        let res: string = kept_handle_res(v, body, resources, funcs);
        if (res.len() > 0 && !util.has_str(res_out, res)) {
          res_out = res_out.append(res);
        }
      },
      ast.StmtIf(f) => {
        res_out = collect_dropped_resources(f.then_body, body, resources, funcs, res_out);
        res_out = collect_dropped_resources(f.else_body, body, resources, funcs, res_out);
      },
      ast.StmtWhile(w) => {
        res_out = collect_dropped_resources(w.body, body, resources, funcs, res_out);
      },
      ast.StmtFor(fr) => {
        res_out = collect_dropped_resources(fr.body, body, resources, funcs, res_out);
      },
      ast.StmtMatch(m) => {
        let k: i32 = 0;
        while (k < m.arms.len()) {
          res_out = collect_dropped_resources(m.arms[k].body, body, resources, funcs, res_out);
          k = k + 1;
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return res_out;
}

// Prepare deferred cleanup: infer return types and insert resource drops.
// Keep each action at its registration site until the consumer resolves its
// lexical bindings. Expanding earlier loses which shadowed local an action
// reads when cleanup moves outside the declaration's block.
// The return-type fixpoint must finish before the body rewrites because it
// reads sibling signatures. IR lowering resolves bindings before expansion;
// the interpreter expands defers at its own entry.
pub function lower_defers_prepass_module(mod: Module): Module {
  // (1) Ret-type inference (was infer_ret_types_module, which keeps its
  // standalone form for emit_module_ir_gated_sub's idempotent re-run): stamp
  // inferred ret_types with a 3-pass fixpoint over the funcs list, so a
  // call to a later-inferred function resolves.
  let funcs: FuncDecl[] = mod.funcs;
  let pass: i32 = 0;
  while (pass < 3) {
    let pi: i32 = 0;
    while (pi < funcs.len()) {
      let pfd: FuncDecl = funcs[pi];
      if (pfd.ret_type == "" && pfd.body.len() > 0 && pfd.receiver_type.len() == 0 && pfd.all_type_params.len() == 0) {
        let inferred: string = irt_infer_func(pfd, funcs, mod.structs);
        if (inferred != "") {
          funcs = irt_set_ret(funcs, pi, inferred);
        }
      }
      pi = pi + 1;
    }
    pass = pass + 1;
  }
  // (2) Per function: resource-drop insertion, skipped without resources.
  let resources: ResourceDecl[] = registered_resources(mod);
  let has_res: boolean = resources.len() > 0;
  let out_funcs: FuncDecl[] = [];
  let needed: string[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let f: FuncDecl = funcs[i];
    if (!has_res || f.import_iface.len() > 0) {
      out_funcs = out_funcs.append(f);
      i = i + 1;
      continue;
    }
    needed = collect_dropped_resources(f.body, f.body, resources, funcs, needed);
    let nbody: ast.Stmt[] = insert_drop_defers(f.body, f.body, resources, funcs);
    out_funcs = out_funcs.append(FuncDecl { ...f, body: nbody });
    i = i + 1;
  }
  let no_tp: string[] = [];
  let no_body: ast.Stmt[] = [];
  let k: i32 = 0;
  while (k < needed.len()) {
    let rn: string = needed[k];
    let iface2: string = resource_binding_iface(resources, rn);
    let wit2: string = resource_binding_wit(resources, rn);
    let hp: ast.ParamDecl[] = [ast.ParamDecl { name: "h", type_name: "own " + rn, own: true, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
    out_funcs = out_funcs.append(lower_defers_func(FuncDecl {
      stdlib: "", no_inline: false,
      name: resource_drop_fn_name(rn), receiver_name: "", receiver_type: "", receiver_own: false,
      type_params: no_tp, params: hp, ret_type: "void", body: no_body,
      line: 0, col: 0, import_iface: iface2, import_wit: "[resource-drop]" + wit2, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
      is_pub: true,
      is_const: false, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [],
    }));
    k = k + 1;
  }
  return Module { ...mod, funcs: out_funcs };
}

// ---------------------------------------------------------------------------
// Range-for desugaring.
//
// `for i in LOW..HIGH` parses to a StmtFor whose iter is the synthetic
// `__range(LOW, HIGH)` call (see parse_stmt). No consumer knows `__range` —
// left untouched, it is a `call __fn___range` (a link error) or a
// mis-evaluated iter. So we desugar the `__range` for-iter into a counting
// while-loop built from existing nodes:
//
//     let i = LOW - 1;
//     let $hi_<var> = HIGH;          // HIGH evaluated once (`0..f()` calls f once)
//     while (true) {
//         i = i + 1;                 // increment at the TOP so a user `continue`
//         if (i >= $hi_<var>) break; // (which jumps to the while header) still
//         <body>                     // advances the counter — break/continue work
//     }
//
// The closed form `LOW..=HIGH` (spelled `__range_incl`) cannot test `i > hi`
// after the increment: when HIGH is its type's maximum the increment wraps and
// the test never holds (#10359). It runs on a flag instead, cleared on the
// round that reaches HIGH:
//
//     let i = LOW;
//     let $hi_<var> = HIGH;
//     let $go_<var> = i <= $hi_<var>;
//     i = i - 1;
//     while ($go_<var>) {
//         i = i + 1;
//         $go_<var> = i != $hi_<var>;
//         <body>
//     }
//
// Empty / reversed ranges (`5..5`, `9..3`) run zero iterations. The helpers
// return BARE Stmt[] (never a struct wrapping a fresh array) to avoid the
// native RC free-list reclaim that corrupts a freshly-built array placed in a
// struct-literal field (cf. #2759).
//
// This runs in desugar_prepass_module (inside module_with_builtins),
// interp.eval_module and ssa.build_func. module_with_builtins feeds the IR
// emit, and module_with_builtins_typed, which runs the same prepass, feeds the
// semantic substitution, so EVERY consumer sees the while-loop.
function iter_range_args(iter: ast.Expr): ast.Expr[] {
  if (range_call_name(iter) == "") {
    return [];
  }
  if let ast.ExprCall(c) = iter {
    return c.args;
  }
  return [];
}

// The synthetic range call's name, or "" when the iter is not one: `__range`
// for `LOW..HIGH` and `__range_incl` for `LOW..=HIGH`.
function range_call_name(iter: ast.Expr): string {
  if let ast.ExprCall(c) = iter {
    if (c.args.len() != 2) {
      return "";
    }
    if let ast.ExprIdent(id) = c.callee {
      if (id.name == "__range" || id.name == "__range_incl") {
        return id.name;
      }
    }
  }
  return "";
}

// The type the desugared counter is declared at: a bound's literal suffix —
// the checker writes one onto untyped bounds when the loop variable settles
// wider or narrower than i32 — else i32.
function range_bound_type(bounds: ast.Expr[]): string {
  for bound in bounds {
    let t: string = literal_suffix_of(bound);
    if (t.len() > 0) {
      return t;
    }
  }
  return "i32";
}

function literal_suffix_of(e: ast.Expr): string {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float || n.suffix == "char") {
        return "";
      }
      return n.suffix;
    },
    ast.ExprUnary(u) => {
      if (u.op == "-" || u.op == "+") {
        return literal_suffix_of(u.operand);
      }
      return "";
    },
    ast.ExprBinary(b) => {
      if (b.op != "+" && b.op != "-" && b.op != "*" && b.op != "/" && b.op != "%") {
        return "";
      }
      let l: string = literal_suffix_of(b.left);
      if (l.len() > 0) {
        return l;
      }
      return literal_suffix_of(b.right);
    },
    _ => {
      return "";
    }
  }
  return "";
}

// The closed-form loop: see the flag shape above.
function inclusive_range_loop(fr: ast.StmtFor, dbody: ast.Stmt[], ivar: ast.Stmt, hivar: ast.Stmt, hi_name: string): ast.Stmt[] {
  let v: string = fr.var_name;
  let go_name: string = "$go_" + v;
  let one: ast.Expr = e_number("1", "", false);
  let govar: ast.Stmt = s_var(go_name, "boolean", e_binary("<=", e_ident(v), e_ident(hi_name)));
  let back: ast.Stmt = s_assign(v, e_binary("-", e_ident(v), one));
  let incr: ast.Stmt = s_assign(v, e_binary("+", e_ident(v), one));
  let last: ast.Stmt = s_assign(go_name, e_binary("!=", e_ident(v), e_ident(hi_name)));
  let wbody: ast.Stmt[] = [incr, last];
  for st in dbody {
    wbody = wbody.append(st);
  }
  return [ivar, hivar, govar, back, with_loop_label(s_while(e_ident(go_name), wbody), fr.label)];
}

// dr_expr rewrites the range-fors living inside an EXPRESSION — in practice a
// lambda body, which is a statement list no statement walk reaches. The generic
// descent uses dl_expr_kids / dl_expr_with_kids so only the lambda case is
// spelled out; those two report no children for a lambda precisely because a
// lambda's children are statements, not expressions.
function dr_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, body: desugar_ranges_block(lm.body) };
    },
    _ => {
      return dr_expr_kids(e);
    }
  }
  return e;
}

function dr_expr_kids(e: ast.Expr): ast.Expr {
  return map_expr_kids(e, dr_expr);
}

pub function desugar_ranges_block(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < body.len()) {
    let r: ast.Stmt[] = desugar_ranges_one(body[i]);
    let j: i32 = 0;
    while (j < r.len()) {
      out = out.append(r[j]);
      j = j + 1;
    }
    i = i + 1;
  }
  return out;
}

function desugar_ranges_one(st: ast.Stmt): ast.Stmt[] {
  match (st) {
    ast.StmtFor(fr) => {
      let dbody: ast.Stmt[] = desugar_ranges_block(fr.body);
      let rargs: ast.Expr[] = iter_range_args(fr.iter);
      if (rargs.len() == 2) {
        let hi_name: string = "$hi_" + fr.var_name;
        let rty: string = range_bound_type(rargs);
        let hivar: ast.Stmt = s_var(hi_name, rty, rargs[1]);
        if (range_call_name(fr.iter) == "__range_incl") {
          return inclusive_range_loop(fr, dbody, s_var(fr.var_name, rty, rargs[0]), hivar, hi_name);
        }
        let ivar: ast.Stmt = s_var(fr.var_name, rty, e_binary("-", rargs[0], e_number("1", "", false)));
        let incr: ast.Stmt = s_assign(fr.var_name, e_binary("+", e_ident(fr.var_name), e_number("1", "", false)));
        let brk: ast.Stmt = s_if(e_binary(">=", e_ident(fr.var_name), e_ident(hi_name)), [s_break()], []);
        let wbody: ast.Stmt[] = [incr, brk];
        let k: i32 = 0;
        while (k < dbody.len()) {
          wbody = wbody.append(dbody[k]);
          k = k + 1;
        }
        // The source label names this loop, so a `break outer` or
        // `continue outer` inside it still finds a loop carrying it.
        return [ivar, hivar, with_loop_label(s_while(e_bool(true), wbody), fr.label)];
      }
      return [ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: dbody, label: fr.label, line: fr.line }];
    },
    ast.StmtIf(f) => {
      return [ast.StmtIf { ...f, cond: f.cond, then_body: desugar_ranges_block(f.then_body), else_body: desugar_ranges_block(f.else_body) }];
    },
    ast.StmtWhile(w) => {
      return [ast.StmtWhile { cond: w.cond, body: desugar_ranges_block(w.body), label: w.label, line: w.line, is_loop: w.is_loop }];
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let a: i32 = 0;
      while (a < m.arms.len()) {
        arms = arms.append(ast.MatchArm { pattern: m.arms[a].pattern, body: desugar_ranges_block(m.arms[a].body), line: m.arms[a].line, col: m.arms[a].col, guard: m.arms[a].guard, has_guard: m.arms[a].has_guard, alt_cont: false });
        a = a + 1;
      }
      return [ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: arms }];
    },
    ast.StmtDefer(d) => {
      // The action is a block, an expression or an assignment
      // (defer_action), each of which desugars to one statement.
      return [ast.StmtDefer { action: desugar_ranges_one(d.action)[0], on_error: d.on_error, line: d.line }];
    },
    ast.StmtVar(v) => {
      // The statement forms whose EXPRESSIONS can hold a lambda. Without these
      // the `_` arm returned them untouched and a range-for in a lambda body
      // survived as an undesugared `__range` call, which the interpreter has
      // no function for (#7174).
      return [ast.StmtVar { ...v, init: dr_expr(v.init) }];
    },
    ast.StmtReturn(r2) => {
      return [ast.StmtReturn { ...r2, value: dr_expr(r2.value) }];
    },
    ast.StmtExpr(x) => {
      return [ast.StmtExpr { ...x, value: dr_expr(x.value) }];
    },
    ast.StmtAssign(a) => {
      return [ast.StmtAssign { ...a, value: dr_expr(a.value) }];
    },
    _ => {
      return [st];
    }
  }
  return [st];
}

pub function desugar_ranges_func(fd: FuncDecl): FuncDecl {
  return FuncDecl { ...fd, body: desugar_ranges_body(fd.body) };
}

// desugar_ranges_body: a function body with no range `for` keeps its
// statements as parsed.
function desugar_ranges_body(body: ast.Stmt[]): ast.Stmt[] {
  if (!has_range_for(body)) {
    return body;
  }
  return desugar_ranges_block(body);
}

// has_range_for walks every statement desugar_ranges_block reaches, lambda
// bodies included, and more: a narrower walk would leave a range loop as a
// `__range` call.
function has_range_for(stmts: ast.Stmt[]): boolean {
  let found: boolean = false;
  for st in stmts {
    found = astwalk.fold_stmt_nodes(st, found, range_for_at, keep_flag, astwalk.descend_all);
  }
  return found;
}

function range_for_at(st: ast.Stmt, own acc: boolean): boolean {
  if let ast.StmtFor(fr) = st {
    return acc || range_call_name(fr.iter) != "";
  }
  return acc;
}

pub function desugar_ranges_module(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    funcs = funcs.append(desugar_ranges_func(mod.funcs[i]));
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs, top_stmts: desugar_ranges_block(mod.top_stmts) };
}

// desugar_prepass_module fuses the three leading whole-module DESUGAR passes —
// resolve_labels_module, fill_default_args_module, desugar_ranges_module — into a
// single traversal that rebuilds the module ONCE instead of three times (#4394
// lever 3: the front-end composes ~14 allocating module rebuilds before the
// checker, and under partially-freeing RC each rebuild is resident cost). All
// three are pre-analysis LOCAL body rewrites — each maps func→func by rewriting
// only the statement body, never the signature list — so applying them in order
// per function is byte-identical to running them as three separate module passes:
//
//   * resolve_labels_block is purely local (labeled break/continue within a body).
//   * fda_stmts reads the funcs list only for callee SIGNATURES (fda_lookup_params
//     touches name / receiver_type / params, never bodies), and none of the three
//     passes alters a signature, so the ORIGINAL mod.funcs is the same signature
//     view the sequential fill_default_args pass saw post-resolve_labels.
//   * desugar_ranges_block is purely local (for-range → while), and the unlabeled
//     breaks it introduces run AFTER resolve_labels here exactly as in the
//     sequential order, so they are (correctly) never label-resolved.
//
// The fill-default-args guard (module_has_default_params / module_has_named_args)
// is likewise unaffected by resolve_labels (which adds/removes no default params
// ---------------------------------------------------------------------------
// Record-form variant patterns.
//
// `Rect { h, w }` binds each of the variant's fields to a local of the same
// name, in any order. The layout is the positional one (`__ev`, `__ev1`, …), so
// the pattern is equivalent to the positional pattern that lists the variant's
// fields in DECLARATION order — which is what this pass rewrites it to, before
// the checker or any backend sees it. See docs/NAMED-FIELD-VARIANTS.md.

// variant_field_names_of returns the record-form field names declared for the
// variant struct `name`, or [] when the name is unknown, is a plain struct, or
// is a positional / payloadless variant. A qualified spelling (`mod.Rect`) is
// matched on its last segment too, so a pre-bundle pattern resolves.
function variant_field_names_of(structs: StructDecl[], name: string): string[] {
  let bare: string = name;
  let c: i32 = 0;
  while (c < name.len()) {
    if (name[c] == b'.') {
      bare = slice_unchecked(name, c + 1, name.len()) + "";
    }
    c = c + 1;
  }
  let i: i32 = 0;
  while (i < structs.len()) {
    if (structs[i].name == name || structs[i].name == bare) {
      if (structs[i].variant_field_names.len() > 0) {
        return structs[i].variant_field_names;
      }
    }
    i = i + 1;
  }
  let empty: string[] = [];
  return empty;
}

// record_fields_cover reports whether a record pattern names each of the
// variant's declared fields exactly once — the condition for reordering it into
// declaration order.
pub function record_fields_cover(decl_names: string[], pat_names: string[]): boolean {
  if (pat_names.len() == 0 || decl_names.len() != pat_names.len()) {
    return false;
  }
  let d: i32 = 0;
  while (d < decl_names.len()) {
    let hits: i32 = 0;
    let q: i32 = 0;
    while (q < pat_names.len()) {
      if (pat_names[q] == decl_names[d]) {
        hits = hits + 1;
      }
      q = q + 1;
    }
    if (hits != 1) {
      return false;
    }
    d = d + 1;
  }
  return true;
}

// record_pattern_renames reports whether a record pattern binds any field to a
// local of a different name (`Rect { w: a }`) — the form native rejects.
pub function record_pattern_renames(pv: ast.PatVariant): boolean {
  if (pv.field_names.len() == 0) {
    return false;
  }
  if (pv.binding != pv.field_names[0]) {
    return true;
  }
  let r: i32 = 1;
  while (r < pv.field_names.len()) {
    if (r - 1 >= pv.extra_bindings.len()) {
      return true;
    }
    if (pv.extra_bindings[r - 1] != pv.field_names[r]) {
      return true;
    }
    r = r + 1;
  }
  return false;
}

// rebind_record_positional rewrites a record-form PatVariant into its positional
// equivalent unconditionally: the bindings become the variant's fields in
// declaration order and field_names is cleared. Only valid once the pattern is
// known to cover `decl_names` (record_fields_cover).
pub function rebind_record_positional(pv: ast.PatVariant, decl_names: string[]): ast.PatVariant {
  let extra: string[] = [];
  let k: i32 = 1;
  while (k < decl_names.len()) {
    extra = extra.append(decl_names[k]);
    k = k + 1;
  }
  let no_names: string[] = [];
  return ast.PatVariant { ...pv, binding: decl_names[0], extra_bindings: extra, field_names: no_names };
}

// resolve_record_pattern settles one record-form PatVariant against the
// variant's declared fields. The pattern is returned UNCHANGED — keeping the
// field names for the checker to report (E015) — when it names a field the
// variant does not have, names one twice, leaves one unbound, or renames one;
// a resolved pattern carries no field names, so re-running is a no-op.
pub function resolve_record_pattern(pv: ast.PatVariant, decl_names: string[]): ast.PatVariant {
  if (pv.field_names.len() == 0 || decl_names.len() == 0) {
    return pv;
  }
  if (!record_fields_cover(decl_names, pv.field_names)) {
    return pv;
  }
  if (record_pattern_renames(pv)) {
    return pv;
  }
  return rebind_record_positional(pv, decl_names);
}

function rvf_pattern(pat: ast.Pattern, structs: StructDecl[]): ast.Pattern {
  match (pat) {
    ast.PatVariant(pv) => {
      let np: ast.PatVariant = resolve_record_pattern(pv, variant_field_names_of(structs, pv.type_name));
      let nested: ast.Pattern[] = [];
      let i: i32 = 0;
      while (i < np.nested.len()) {
        nested = nested.append(rvf_pattern(np.nested[i], structs));
        i = i + 1;
      }
      return ast.PatVariant { ...np, nested: nested };
    },
    _ => {
      return pat;
    }
  }
  return pat;
}

// rvf_expr recurses only to reach ExprLambda bodies — a value-position `match`
// is desugared into an immediately-invoked closure, so a record pattern can sit
// arbitrarily deep inside an expression.
function rvf_expr(e: ast.Expr, structs: StructDecl[]): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: rvf_expr(b.left, structs), right: rvf_expr(b.right, structs), line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: rvf_expr(u.operand, structs), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < c.args.len()) {
        args = args.append(rvf_expr(c.args[i], structs));
        i = i + 1;
      }
      return ast.ExprCall { callee: rvf_expr(c.callee, structs), args: args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      let j: i32 = 0;
      while (j < a.elements.len()) {
        els = els.append(rvf_expr(a.elements[j], structs));
        j = j + 1;
      }
      return ast.ExprArray { ...a, elements: els };
    },
    ast.ExprTuple(t) => {
      let tels: ast.Expr[] = [];
      let k: i32 = 0;
      while (k < t.elements.len()) {
        tels = tels.append(rvf_expr(t.elements[k], structs));
        k = k + 1;
      }
      return ast.ExprTuple { elements: tels, line: t.line, col: t.col };
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex { array: rvf_expr(x.array, structs), index: rvf_expr(x.index, structs), unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: rvf_expr(sl.array, structs), start: rvf_expr(sl.start, structs), end: rvf_expr(sl.end, structs) };
    },
    ast.ExprStructLit(st) => {
      let vals: ast.Expr[] = [];
      let v: i32 = 0;
      while (v < st.field_values.len()) {
        vals = vals.append(rvf_expr(st.field_values[v], structs));
        v = v + 1;
      }
      let nbase: ast.Expr = st.base;
      if (st.has_base) {
        nbase = rvf_expr(st.base, structs);
      }
      return ast.ExprStructLit { type_name: st.type_name, field_names: st.field_names, field_values: vals, has_base: st.has_base, base: nbase, line: st.line, col: st.col, written: st.written };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { obj: rvf_expr(fa.obj, structs), field: fa.field, line: fa.line, col: fa.col, ty: fa.ty };
    },
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, body: rvf_block(lm.body, structs) };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function rvf_stmt(st: ast.Stmt, structs: StructDecl[]): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { name: v.name, type_name: v.type_name, init: rvf_expr(v.init, structs), line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: rvf_expr(r.value, structs), line: r.line, col: r.col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: rvf_expr(x.value, structs), line: x.line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: rvf_expr(f.cond, structs), then_body: rvf_block(f.then_body, structs), else_body: rvf_block(f.else_body, structs) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: rvf_expr(w.cond, structs), body: rvf_block(w.body, structs), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { target: a.target, value: rvf_expr(a.value, structs), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: rvf_expr(fr.iter, structs), body: rvf_block(fr.body, structs), label: fr.label, line: fr.line };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: rvf_stmt(d.action, structs), on_error: d.on_error, line: d.line };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let a: i32 = 0;
      while (a < m.arms.len()) {
        arms = arms.append(ast.MatchArm { pattern: rvf_pattern(m.arms[a].pattern, structs), body: rvf_block(m.arms[a].body, structs), line: m.arms[a].line, col: m.arms[a].col, guard: rvf_expr(m.arms[a].guard, structs), has_guard: m.arms[a].has_guard, alt_cont: false });
        a = a + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: rvf_expr(m.scrutinee, structs), arms: arms };
    },
    _ => {
      return st;
    }
  }
  return st;
}

function rvf_block(stmts: ast.Stmt[], structs: StructDecl[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(rvf_stmt(stmts[i], structs));
    i = i + 1;
  }
  return out;
}

// resolve_variant_fields_module rewrites every record-form variant pattern in
// the module into its positional equivalent. A module declaring no record-form
// variant cannot contain a resolvable one, so the whole traversal is skipped —
// which is every module the compiler bootstraps itself from, leaving their trees
// (and the fixpoint) untouched. Idempotent: a resolved pattern carries no field
// names, so running it again is a no-op — the driver runs it once per parsed
// module and once more on the bundle, where a cross-module variant resolves.
pub function resolve_variant_fields_module(mod: Module): Module {
  let any: boolean = false;
  let s: i32 = 0;
  while (s < mod.structs.len()) {
    if (mod.structs[s].variant_field_names.len() > 0) {
      any = true;
    }
    s = s + 1;
  }
  if (!any) {
    return mod;
  }
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    funcs = funcs.append(FuncDecl { ...fd, body: rvf_block(fd.body, mod.structs) });
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs, top_stmts: rvf_block(mod.top_stmts, mod.structs) };
}

// or named args), so it is evaluated once on the incoming module and gates the
// per-body fda step — reproducing fill_default_args_module's early-return.
pub function desugar_prepass_module(raw: Module): Module {
  // `f[Name](x)` parses as an index until the names are known; the checker
  // settles it on its own route, and the stack-IR route settles it here.
  let mod: Module = retag_type_arg_indexes(raw);
  let need_fda: boolean = module_has_default_params(mod) || module_has_named_args(mod);
  let none: string[] = [];
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    let body: ast.Stmt[] = fd.body;
    if (has_labeled_jump(body)) {
      body = resolve_labels_block(body, none);
    }
    if (need_fda) {
      body = fda_stmts(body, mod.funcs);
    }
    body = desugar_ranges_body(body);
    funcs = funcs.append(FuncDecl { ...fd, body: body });
    i = i + 1;
  }
  let tops: ast.Stmt[] = resolve_labels_block(mod.top_stmts, none);
  if (need_fda) {
    tops = fda_stmts(tops, mod.funcs);
  }
  tops = desugar_ranges_block(tops);
  return Module { ...mod, funcs: funcs, top_stmts: tops };
}

// ---------------------------------------------------------------------------
// Default-argument filling.
//
// `function f(a: i32, b: i32 = 128)` declares an optional parameter. A call
// that omits the trailing argument — `f(5)` — is rewritten to the complete
// positional call `f(5, 128)` here, so the checker, the IR lowering, the SSA
// backend, and the interpreter all see a full argument list and need no
// knowledge of defaults. Mirrors the native compiler's internal/check/defaultargs.
//
// The rewriter follows rw_call_stmts exactly — only the
// ExprCall arm differs: instead of appending captured names, it appends the
// callee's declared defaults for the omitted trailing parameters. A module
// with no defaulted parameter is returned verbatim (the precheck), so
// default-free programs — including the self-host's own sources — are
// byte-identical and the fixpoint holds.
function module_has_default_params(mod: Module): boolean {
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let ps: ast.ParamDecl[] = mod.funcs[fi].params;
    let pi: i32 = 0;
    while (pi < ps.len()) {
      if (ps[pi].has_default) {
        return true;
      }
      pi = pi + 1;
    }
    fi = fi + 1;
  }
  return false;
}

// fda_lookup_params returns the parameter list of the free function named
// `name`, or an empty list (a method — called via field access, not a bare
// ident — or a builtin never matches).
function fda_lookup_params(name: string, funcs: FuncDecl[]): ast.ParamDecl[] {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].receiver_type.len() == 0 && funcs[i].name == name) {
      return funcs[i].params;
    }
    i = i + 1;
  }
  let none: ast.ParamDecl[] = [];
  return none;
}

// ---- named-argument resolution (mirrors internal/check/defaultargs) ----
// A named argument `name = value` is parsed into a synthetic
// `ExprBinary("__named_arg", <name ident>, value)` marker. These helpers
// recognise, inspect, and resolve those markers against a callee's
// parameter list, turning a mixed positional/named call into a plain
// positional one with defaults filled — so every later pass and backend
// sees an ordinary `Args` list (the same contract the native pass gives
// the Go checker).

function fda_is_named_marker(e: ast.Expr): boolean {
  match (e) {
    ast.ExprBinary(b) => {
      return b.op == "__named_arg";
    },
    _ => {
      return false;
    }
  }
  return false;
}

function fda_marker_name(e: ast.Expr): string {
  match (e) {
    ast.ExprBinary(b) => {
      match (b.left) {
        ast.ExprIdent(id) => {
          return id.name;
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
  return "";
}

function fda_marker_value(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return b.right;
    },
    _ => {
      return e;
    }
  }
  return e;
}

function fda_args_have_named(args: ast.Expr[]): boolean {
  let i: i32 = 0;
  while (i < args.len()) {
    if (fda_is_named_marker(args[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function fda_named_lookup(names: string[], vals: ast.Expr[], want: string): i32 {
  let i: i32 = 0;
  while (i < names.len()) {
    if (names[i] == want) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// fda_resolve_named rebuilds a positional argument list from a call whose
// args mix leading positionals and trailing `name = value` markers. Each
// parameter takes, in order: the matching leading positional, else a named
// value for its name, else its default. A still-unfilled required param
// gets its (empty) default_value placeholder — the same shape an omitted
// required positional arg leaves, so the checker's arity path reports it.
function fda_resolve_named(params: ast.ParamDecl[], args: ast.Expr[]): ast.Expr[] {
  let posvals: ast.Expr[] = [];
  let nnames: string[] = [];
  let nvals: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < args.len()) {
    if (fda_is_named_marker(args[i])) {
      nnames = nnames.append(fda_marker_name(args[i]));
      nvals = nvals.append(fda_marker_value(args[i]));
    } else {
      posvals = posvals.append(args[i]);
    }
    i = i + 1;
  }
  let out: ast.Expr[] = [];
  let pi: i32 = 0;
  while (pi < params.len()) {
    if (pi < posvals.len()) {
      out = out.append(posvals[pi]);
    } else {
      let ni: i32 = fda_named_lookup(nnames, nvals, params[pi].name);
      if (ni >= 0) {
        out = out.append(nvals[ni]);
      } else {
        out = out.append(params[pi].default_value);
      }
    }
    pi = pi + 1;
  }
  // Surplus positional args (more than params) — keep them so an arity
  // error still surfaces rather than silently dropping arguments.
  let j: i32 = params.len();
  while (j < posvals.len()) {
    out = out.append(posvals[j]);
    j = j + 1;
  }
  return out;
}

// stmts_have_named detects whether a module contains any named-argument
// marker, so fill_default_args_module runs the resolving walk even for a
// module with no default-valued parameters (named args and defaults are
// independent features).
//
// A marker is an ExprBinary node, so the marker check alone is the whole
// contribution: the spine reaches every expression, and only the total's
// sign is read.
function fda_named_count_of(e: ast.Expr, own acc: i32): i32 {
  if (fda_is_named_marker(e)) {
    return acc + 1;
  }
  return acc;
}

function stmts_have_named(stmts: ast.Stmt[]): boolean {
  let n: i32 = 0;
  for st in stmts {
    n = astwalk.fold_stmt(st, n, fda_named_count_of);
  }
  return n > 0;
}

function module_has_named_args(mod: Module): boolean {
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    if (stmts_have_named(mod.funcs[fi].body)) {
      return true;
    }
    fi = fi + 1;
  }
  return stmts_have_named(mod.top_stmts);
}

// fda_call_of resolves ONE call's arguments: it fills omitted trailing
// defaults from the callee's parameter list, and reorders a mixed
// positional/named list into a plain positional one. ExprCall is the only
// node it changes; map_expr rebuilds every other verbatim around its
// rewritten children.
//
// map_expr is post-order, so `c` arrives with its callee and args already
// rewritten — the order the hand-written walk used, which matters because a
// default_value is spliced in AFTER the arguments beside it are resolved.
// Rewriting never turns an ident callee into something else, so the callee
// this tests is the one the old walk tested.
function fda_call_of(x: ast.Expr, funcs: FuncDecl[]): ast.Expr {
  match (x) {
    ast.ExprCall(c) => {
      let new_args: ast.Expr[] = c.args;
      let has_named: boolean = fda_args_have_named(new_args);
      // A call whose named arguments do not resolve is left exactly as
      // written, markers included: fda_call_error names it (E077 / E004)
      // and the checker types a marker as its value, so the diagnostic
      // is the only thing that changes.
      if (has_named) {
        let (err_code, err_msg) = fda_call_error(c, funcs);
        if (err_code.len() > 0) {
          return x;
        }
      }
      match (c.callee) {
        ast.ExprIdent(id) => {
          let params: ast.ParamDecl[] = fda_lookup_params(id.name, funcs);
          if (has_named) {
            new_args = fda_resolve_named(params, new_args);
          } else if (params.len() > new_args.len()) {
            let ok: boolean = true;
            let k: i32 = new_args.len();
            while (k < params.len()) {
              if (!params[k].has_default) {
                ok = false;
              }
              k = k + 1;
            }
            if (ok) {
              let j: i32 = new_args.len();
              while (j < params.len()) {
                new_args = new_args.append(params[j].default_value);
                j = j + 1;
              }
            }
          }
        },
        _ => {}
      }
      return ast.ExprCall { ...c, args: new_args };
    },
    _ => {
      return x;
    }
  }
  return x;
}

function fda_stmts(stmts: ast.Stmt[], funcs: FuncDecl[]): ast.Stmt[] {
  function rw(x: ast.Expr): ast.Expr {
    return fda_call_of(x, funcs);
  }
  return astwalk.map_stmts(stmts, rw);
}

// ---- default-argument diagnostics (mirrors internal/check/defaultargs) ----

// default_nonconst_reason reports the first sub-expression that stops a
// parameter default from being a constant expression, as the reason text E076
// prints, and whether one was found. A WHITELIST of literal / unary / binary,
// as native's nonConstReason is: a default is pasted into the CALL SITE, so a
// name inside it resolves in the caller's scope (#8445), and a node this
// function does not know about is refused rather than accepted. A
// cast is an ExprUnary whose op is `as_<type>`, refused before its operand.
pub function default_nonconst_reason(e: ast.Expr): (string, boolean) {
  match (e) {
    ast.ExprNumber(n) => {
      return ("", false);
    },
    ast.ExprString(st) => {
      return ("", false);
    },
    ast.ExprBool(b) => {
      return ("", false);
    },
    ast.ExprIdent(id) => {
      return ("reads \"" + id.name + "\"", true);
    },
    ast.ExprUnary(u) => {
      if (is_cast_op(u.op)) {
        return ("is a cast", true);
      }
      return default_nonconst_reason(u.operand);
    },
    ast.ExprBinary(b) => {
      let (lwhy, lbad) = default_nonconst_reason(b.left);
      if (lbad) {
        return (lwhy, true);
      }
      return default_nonconst_reason(b.right);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          return ("calls \"" + id.name + "\"", true);
        },
        _ => {
          return ("is a call", true);
        }
      }
      return ("is a call", true);
    },
    ast.ExprFieldAccess(fa) => {
      return ("is a field access", true);
    },
    ast.ExprIndex(ix) => {
      return ("is an index", true);
    },
    ast.ExprLambda(lm) => {
      return ("is a lambda", true);
    },
    ast.ExprStructLit(sl) => {
      return ("is a struct literal", true);
    },
    ast.ExprArray(al) => {
      return ("is an array literal", true);
    },
    ast.ExprTuple(tl) => {
      return ("is a tuple literal", true);
    },
    ast.ExprSlice(sl) => {
      return ("is not a constant expression", true);
    },
    ast.ExprMapLit(ml) => {
      return ("is not a constant expression", true);
    },
    ast.ExprFString(fs) => {
      return ("is not a constant expression", true);
    },
    ast.ExprUnknown(uk) => {
      // An ExprUnknown is a node the parser already refused — an
      // out-of-range float literal becomes one, and so does every `;` / `@`
      // sentinel. parse_unknown_errors_module walks parameter defaults and
      // reports each with its own P001 / P002 / P005, so E076 has nothing
      // left to say: a second complaint about the same token would name a
      // rule the author did not break. Native agrees by a different route —
      // its bad float stays a FloatLit, which nonConstReason counts as
      // constant.
      return ("", false);
    },
    ast.ExprZero(_) => {
      return ("", false);
    }
  }
  return ("is not a constant expression", true);
}

// fda_const_value is the value expression of the top-level const `name`, with
// ok false when the module declares no such const.
function fda_const_value(name: string, funcs: FuncDecl[]): (ast.Expr, boolean) {
  for fd in funcs {
    if (fd.is_const && fd.receiver_type.len() == 0 && fd.name == name && fd.body.len() == 1) {
      match (fd.body[0]) {
        ast.StmtReturn(r) => {
          return (r.value, true);
        },
        _ => {}
      }
    }
  }
  return (ast.ExprBool { value: false, line: 0, col: 0 }, false);
}

// fda_fold_consts substitutes every top-level const a default names with the
// const's value, as native's constfold does ahead of Fill, so `= LIMIT`
// reaches the E076 whitelist and the call site as the literal it stands for
// rather than as a name the caller's scope resolves. Only the shapes the
// whitelist admits are entered; a const naming another const is followed to a
// bounded depth, past which the name is left for E076 to refuse.
function fda_fold_consts(e: ast.Expr, funcs: FuncDecl[], depth: i32): ast.Expr {
  if (depth > 16) {
    return e;
  }
  match (e) {
    ast.ExprIdent(id) => {
      let (v, ok) = fda_const_value(id.name, funcs);
      if (ok) {
        return fda_fold_consts(v, funcs, depth + 1);
      }
      return e;
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { ...u, operand: fda_fold_consts(u.operand, funcs, depth) };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { ...b, left: fda_fold_consts(b.left, funcs, depth), right: fda_fold_consts(b.right, funcs, depth) };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// fda_fold_default_consts is fda_fold_consts over every parameter default in
// the module.
function fda_fold_default_consts(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    let params: ast.ParamDecl[] = [];
    for param in fd.params {
      if (param.has_default) {
        params = params.append(ast.ParamDecl { ...param, default_value: fda_fold_consts(param.default_value, mod.funcs, 0) });
      } else {
        params = params.append(param);
      }
    }
    funcs = funcs.append(FuncDecl { ...fd, params: params });
  }
  return Module { ...mod, funcs: funcs };
}

// fda_decl_diags is E076 for every parameter default that is not a constant
// expression, reported at the declaration, where the author can act on it.
function fda_decl_diags(mod: Module): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    for param in fd.params {
      if (param.has_default) {
        let (why, bad) = default_nonconst_reason(param.default_value);
        if (bad) {
          out = out.append(util.Diag { code: "E076", message: "default value for parameter \"" + param.name + "\" " + why + ": a default must be a constant expression, because it is evaluated at each call site rather than inside " + fd.name, line: ast.expr_line(param.default_value), col: ast.expr_col(param.default_value) });
        }
      }
    }
  }
  return out;
}

function fda_known_func(name: string, funcs: FuncDecl[]): boolean {
  for fd in funcs {
    if (fd.receiver_type.len() == 0 && fd.name == name) {
      return true;
    }
  }
  return false;
}

function fda_param_index(params: ast.ParamDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < params.len()) {
    if (params[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// fda_call_error is the diagnostic a call carrying named arguments draws, as
// (code, message), with an empty code when it resolves. The rules and their
// wording are native Fill's, in its order: E077 for a callee that is not a
// named free function, a positional argument after a named one, a name no
// parameter has, or a parameter given twice; E004 for too many positionals
// or a required parameter nothing supplied.
function fda_call_error(c: ast.ExprCall, funcs: FuncDecl[]): (string, string) {
  let callee: string = "";
  match (c.callee) {
    ast.ExprIdent(id) => {
      callee = id.name;
    },
    _ => {
      return ("E077", "named arguments are only supported on direct calls to named functions");
    }
  }
  if (!fda_known_func(callee, funcs)) {
    return ("E077", "named arguments are not supported for call to \"" + callee + "\"");
  }
  let params: ast.ParamDecl[] = fda_lookup_params(callee, funcs);
  let filled: boolean[] = [];
  let k: i32 = 0;
  while (k < params.len()) {
    filled = filled.append(false);
    k = k + 1;
  }
  let pos: i32 = 0;
  let seen_named: boolean = false;
  let i: i32 = 0;
  while (i < c.args.len()) {
    if (fda_is_named_marker(c.args[i])) {
      seen_named = true;
      let name: string = fda_marker_name(c.args[i]);
      let idx: i32 = fda_param_index(params, name);
      if (idx < 0) {
        return ("E077", "\"" + callee + "\" has no parameter named \"" + name + "\"");
      }
      if (filled[idx]) {
        return ("E077", "duplicate argument for parameter \"" + name + "\"");
      }
      filled = filled.with(idx, true);
    } else {
      if (seen_named) {
        return ("E077", "positional argument after named argument");
      }
      if (pos >= params.len()) {
        return ("E004", "function \"" + callee + "\" expects " + util.i32_to_string(params.len()) + " argument(s), got more");
      }
      filled = filled.with(pos, true);
      pos = pos + 1;
    }
    i = i + 1;
  }
  let pi: i32 = 0;
  while (pi < params.len()) {
    if (!filled[pi] && !params[pi].has_default) {
      return ("E004", "missing argument for parameter \"" + params[pi].name + "\" of \"" + callee + "\"");
    }
    pi = pi + 1;
  }
  return ("", "");
}

// FdaAcc carries the module's function table beside the diagnostics the walk
// below collects, so the fold visitor reaches both without a closure.
struct FdaAcc { funcs: FuncDecl[], diags: util.Diag[] }

function fda_call_diag_of(e: ast.Expr, own acc: FdaAcc): FdaAcc {
  match (e) {
    ast.ExprCall(c) => {
      if (!fda_args_have_named(c.args)) {
        return acc;
      }
      let (code, msg) = fda_call_error(c, acc.funcs);
      if (code.len() == 0) {
        return acc;
      }
      return FdaAcc { ...acc, diags: acc.diags.append(util.Diag { code: code, message: msg, line: c.line, col: c.col }) };
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

// fda_call_diags collects fda_call_error over every call in the module, at
// the call's own position.
function fda_call_diags(mod: Module): util.Diag[] {
  let none: util.Diag[] = [];
  let acc: FdaAcc = FdaAcc { funcs: mod.funcs, diags: none };
  for fd in mod.funcs {
    for st in fd.body {
      acc = astwalk.fold_stmt(st, acc, fda_call_diag_of);
    }
  }
  for st in mod.top_stmts {
    acc = astwalk.fold_stmt(st, acc, fda_call_diag_of);
  }
  return acc.diags;
}

// fill_default_args_with_diags is native constfold-then-Fill over parameter
// defaults: every top-level const a default names is replaced by its value,
// then the E076 declaration check runs, and a module holding one is returned
// as written — a default carrying a free name must not be pasted anywhere;
// then every call's named arguments are reordered and its omitted trailing
// defaults filled, with the calls that do not resolve left as written and
// named by their diagnostic.
pub function fill_default_args_with_diags(raw: Module): (Module, util.Diag[]) {
  let none: util.Diag[] = [];
  raw = retag_type_arg_indexes(raw);
  if (!module_has_default_params(raw)) {
    if (!module_has_named_args(raw)) {
      return (raw, none);
    }
    return (fda_fill(raw), fda_call_diags(raw));
  }
  let mod: Module = fda_fold_default_consts(raw);
  let decl_diags: util.Diag[] = fda_decl_diags(mod);
  if (decl_diags.len() > 0) {
    return (raw, decl_diags);
  }
  return (fda_fill(mod), fda_call_diags(mod));
}

// retag_type_arg_indexes turns `f[Box](x)` into a call carrying one written
// type argument once `f` is known to name a generic function and `Box` a type.
// The parser takes a lone name in the bracket as an index, since `xs[i](x)` is
// the same shape; native settles it in the checker (retagIndexAsTypeArgs).
function retag_type_arg_indexes(mod: Module): Module {
  let generics: string[] = [];
  let types: string[] = [];
  for fd in mod.funcs {
    if (fd.all_type_params.len() > 0 && fd.receiver_type.len() == 0) {
      generics = generics.append(fd.name);
    }
  }
  if (generics.len() == 0) {
    return mod;
  }
  let any_site: boolean = rta_has_index_call(mod.top_stmts);
  for fd in mod.funcs {
    if (!any_site && rta_has_index_call(fd.body)) {
      any_site = true;
    }
  }
  if (!any_site) {
    return mod;
  }
  for sd in mod.structs {
    types = types.append(sd.name);
  }
  for ed in mod.enums {
    types = types.append(ed.name);
  }
  for rd in mod.resources {
    types = types.append(rd.name);
  }
  // A module const is a value in the bracket, as native's const folding
  // makes it before the retag (#10427).
  let consts: string[] = [];
  for fd in mod.funcs {
    if (fd.is_const) {
      consts = consts.append(fd.name);
    }
  }
  // Most bodies hold no `f[Name](…)` at all; rebuilding them would copy the
  // whole module for nothing.
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    if (!rta_has_index_call(fd.body)) {
      funcs = funcs.append(fd);
      continue;
    }
    let shadow: string[] = astwalk.collect_bound_stmts(fd.body, consts);
    for pd in fd.params {
      shadow = shadow.append(pd.name);
    }
    // Unbounded type parameters are erased from the decl, but every name
    // the signature's types mention is a type or one of them.
    let ftypes: string[] = types;
    if (fd.all_type_params.len() > 0) {
      for pd in fd.params {
        ftypes = rta_type_names(pd.type_name, ftypes);
      }
      ftypes = rta_type_names(fd.ret_type, ftypes);
    }
    function rw(x: ast.Expr): ast.Expr {
      return rta_call_of(x, generics, ftypes, shadow);
    }
    funcs = funcs.append(FuncDecl { ...fd, body: astwalk.map_stmts(fd.body, rw) });
  }
  if (!rta_has_index_call(mod.top_stmts)) {
    return Module { ...mod, funcs: funcs };
  }
  let top_shadow: string[] = astwalk.collect_bound_stmts(mod.top_stmts, consts);
  function top_rw(x: ast.Expr): ast.Expr {
    return rta_call_of(x, generics, types, top_shadow);
  }
  return Module { ...mod, funcs: funcs, top_stmts: astwalk.map_stmts(mod.top_stmts, top_rw) };
}

function rta_has_index_call(stmts: ast.Stmt[]): boolean {
  let found: boolean = false;
  for st in stmts {
    found = astwalk.fold_stmt_nodes(st, found, rta_skip_stmt, rta_index_call_of, astwalk.descend_all);
  }
  return found;
}

function rta_skip_stmt(st: ast.Stmt, own acc: boolean): boolean {
  return acc;
}

function rta_index_call_of(e: ast.Expr, own acc: boolean): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIndex(ix) = c.callee {
      match (ix.index) {
        ast.ExprIdent(_) => {
          return true;
        },
        ast.ExprIndex(_) => {
          return true;
        },
        _ => {}
      }
    }
  }
  return acc;
}

function rta_type_names(ty: string, acc: string[]): string[] {
  let start: i32 = 0 - 1;
  let i: i32 = 0;
  while (i <= ty.len()) {
    let word: boolean = i < ty.len() && lexer.is_alnum(ty[i] as i32);
    if (word && start < 0) {
      start = i;
    }
    if (!word && start >= 0) {
      acc = acc.append(slice_unchecked(ty, start, i) + "");
      start = 0 - 1;
    }
    i = i + 1;
  }
  return acc;
}

function rta_call_of(x: ast.Expr, generics: string[], types: string[], shadow: string[]): ast.Expr {
  if let ast.ExprCall(c) = x {
    if (c.type_args.len() > 0) {
      return x;
    }
    if let ast.ExprIndex(ix) = c.callee {
      let targ: string = rta_type_spelling(ix.index, types, shadow);
      if (targ.len() > 0) {
        let fname: string = rta_callee_name(ix.array, shadow);
        if (fname.len() > 0 && util.has_str(generics, fname)) {
          return ast.ExprCall { ...c, callee: ix.array, type_args: [targ] };
        }
      }
    }
  }
  return x;
}

// rta_type_spelling is the type an index operand spells — a type name, or a
// generic one instantiated the same way (`W[Q]`) — or "" when it is a value.
function rta_type_spelling(e: ast.Expr, types: string[], shadow: string[]): string {
  if let ast.ExprIdent(id) = e {
    if (util.has_str(types, id.name) && !util.has_str(shadow, id.name)) {
      return id.name;
    }
    return "";
  }
  if let ast.ExprIndex(ix) = e {
    let head: string = rta_type_spelling(ix.array, types, shadow);
    let arg: string = rta_type_spelling(ix.index, types, shadow);
    if (head.len() > 0 && arg.len() > 0) {
      return head + "[" + arg + "]";
    }
  }
  return "";
}

// rta_callee_name is the declaration name an indexed callee would resolve
// to: a bare name, or `mod.f` for a module-qualified one, as a flattened
// bundle names an imported function; "" when a value shadows it.
function rta_callee_name(callee: ast.Expr, shadow: string[]): string {
  if let ast.ExprIdent(fid) = callee {
    if (util.has_str(shadow, fid.name)) {
      return "";
    }
    return fid.name;
  }
  if let ast.ExprFieldAccess(fa) = callee {
    if let ast.ExprIdent(mid) = fa.obj {
      if (util.has_str(shadow, mid.name)) {
        return "";
      }
      return mid.name + "." + fa.field;
    }
  }
  return "";
}

function fda_fill(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    funcs = funcs.append(FuncDecl { ...fd, body: fda_stmts(fd.body, mod.funcs) });
    i = i + 1;
  }
  return Module { ...mod, funcs: funcs, top_stmts: fda_stmts(mod.top_stmts, mod.funcs) };
}

// lower_stream_signatures rewrites each async import's `stream[T]` result and
// parameters to `T[]`, which is what its callers see: the import collects a
// result stream into an array and writes an array argument out as a stream.
// The rewritten slots are recorded in `streams` for the wasm emitter.
pub function lower_stream_signatures(mod: Module): Module {
  let funcs: FuncDecl[] = [];
  for f in mod.funcs {
    if (f.async && f.import_iface.len() > 0) {
      funcs = funcs.append(lower_stream_signature(f));
    } else {
      funcs = funcs.append(f);
    }
  }
  return Module { ...mod, funcs: funcs };
}

function lower_stream_signature(f: FuncDecl): FuncDecl {
  let slots: i32[] = [];
  let ret: string = f.ret_type;
  if (stream_elem(ret).len() > 0) {
    ret = stream_elem(ret) + "[]";
    slots = slots.append(0 - 1);
  }
  let params: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < f.params.len()) {
    let p: ast.ParamDecl = f.params[i];
    if (stream_elem(p.type_name).len() > 0) {
      p = ast.ParamDecl { ...p, type_name: stream_elem(p.type_name) + "[]" };
      slots = slots.append(i);
    }
    params = params.append(p);
    i = i + 1;
  }
  return FuncDecl { ...f, ret_type: ret, params: params, streams: slots };
}

// stream_elem is T for a `stream[T]` spelling, else "".
pub function stream_elem(t: string): string {
  let pre: string = "stream[";
  if (t.len() <= pre.len() + 1 || slice_unchecked(t, 0, pre.len()) != pre || t[t.len() - 1] != b']') {
    return "";
  }
  let bytes: u8[] = [];
  let i: i32 = pre.len();
  while (i < t.len() - 1) {
    bytes = bytes.append(t[i]);
    i = i + 1;
  }
  return string_from_bytes_unchecked(bytes);
}

pub function fill_default_args_module(mod: Module): Module {
  let (filled, diags) = fill_default_args_with_diags(mod);
  return filled;
}

// ---- return-type inference -----------------------------------------
// An unannotated function (ret_type == "") gets its return type inferred
// from its `return` expressions, so call sites tag the result correctly
// (e.g. `greet().len()` needs `greet` to be known to return string).
// Mirrors the native checker's inferReturnType. The self-host's own
// sources are fully annotated, so every function keeps ret_type != ""
// and this pass is byte-identical for them (fixpoint-safe). It BAILS
// (leaves "") on anything it can't pin down — locals, recursion,
// conflicting or complex returns — preserving the prior behaviour for
// those rather than guessing.

function irt_param_type(params: ast.ParamDecl[], name: string): string {
  let i: i32 = 0;
  while (i < params.len()) {
    if (params[i].name == name) {
      return params[i].type_name;
    }
    i = i + 1;
  }
  return "";
}

function irt_func_ret(funcs: FuncDecl[], name: string): string {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_type.len() == 0) {
      return funcs[i].ret_type;
    }
    i = i + 1;
  }
  return "";
}

// stamp_lambda_ret gives an UNANNOTATED lambda the return type its binding's
// declared fn type names (`let f: () => f64 = () => …`). A lambda that already
// carries an explicit `: R`, a non-lambda init, or an empty spelling all pass
// through unchanged, so this only ever fills a hole.
function stamp_lambda_ret(e: ast.Expr, fn_ret: string): ast.Expr {
  if (fn_ret.len() == 0) {
    return e;
  }
  match (e) {
    ast.ExprLambda(lm) => {
      if (lm.ret_type.len() > 0) {
        return e;
      }
      return ast.ExprLambda { ...lm, ret_type: fn_ret };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// stamp_value_block_ret gives a value-block IIFE the WIDTH its binding declares.
// `if` / `match` in value position desugar to a 0-arg IIFE whose ret_type
// if_expr_rt guesses from the arms' syntax alone, and an arm that CALLS anything
// is unguessable there — the classifier has no function table, so it falls to
// "i32" (see if_expr_rt's ExprCall arm). The IIFE is then labelled i32 while its
// body computes i64, and because that tag is non-empty infer_ret_types_module
// never revisits the lambda, so nothing downstream recovers the width and the
// module bails off the IR path.
//
// The binding's annotation is the authority the guess lacks, and outranks it
// the same way stamp_lambda_ret's does: the block's value IS the binding's, so
// the checker holds the arms to that type either way, and a `None` arm or a
// struct literal is as unguessable as a call. A coarse fn tag is left alone —
// its signature lives in sidecars the lambda has none of — and so is a
// spelling naming a type variable, which the instantiation substitutes later.
function stamp_value_block_ret(e: ast.Expr, decl_ty: string): ast.Expr {
  // `let xs: i64[] = [ <value block>, … ]` — the annotation names the ELEMENT
  // type, so each element gets the same treatment the scalar binding gets.
  // Without it a wide value block in an element position kept if_expr_rt's
  // guess: `[match (a +? b) { Some(v) => v, None => id(<i64>) }]` reads both
  // arms as i32 (a CALL is unguessable at parse time), labels the IIFE i32,
  // and the i64 `return` inside the lifted body then bails the module (#6593).
  if (decl_ty.len() > 2 && slice_unchecked(decl_ty, decl_ty.len() - 2, decl_ty.len()) == "[]") {
    let elem_ty: string = slice_unchecked(decl_ty, 0, decl_ty.len() - 2) + "";
    match (e) {
      ast.ExprArray(al) => {
        let nels: ast.Expr[] = [];
        let ai: i32 = 0;
        while (ai < al.elements.len()) {
          nels = nels.append(stamp_value_block_ret(al.elements[ai], elem_ty));
          ai = ai + 1;
        }
        return ast.ExprArray { ...al, elements: nels };
      },
      _ => {
        return e;
      }
    }
  }
  if (decl_ty.len() == 0 || is_coarse_fn_tag(decl_ty) || collect_tvars(decl_ty, []).len() > 0) {
    return e;
  }
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return e;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 0 || lm.ret_type == decl_ty) {
            return e;
          }
          let nl: ast.Expr = ast.ExprLambda { ...lm, ret_type: decl_ty };
          return ast.ExprCall { callee: nl, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
        },
        _ => {
          return e;
        }
      }
    },
    _ => {
      return e;
    }
  }
  return e;
}

// irt_method_ret returns the declared return type of `<recv_type>.<name>`, or ""
// when no such method is declared. The sibling of irt_func_ret, which filters to
// receiver-LESS functions and so can never answer a method call.
function irt_method_ret(funcs: FuncDecl[], recv_type: string, name: string): string {
  let base: string = recv_type;
  let b: i32 = 0;
  while (b < base.len()) {
    if (base[b] == b'[') {
      base = slice_unchecked(base, 0, b) + "";
      b = base.len();
    }
    b = b + 1;
  }
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_type.len() > 0) {
      let rb: string = funcs[i].receiver_type;
      let r2: i32 = 0;
      while (r2 < rb.len()) {
        if (rb[r2] == b'[') {
          rb = slice_unchecked(rb, 0, r2) + "";
          r2 = rb.len();
        }
        r2 = r2 + 1;
      }
      if (rb == base) {
        return funcs[i].ret_type;
      }
    }
    i = i + 1;
  }
  return "";
}

function irt_is_cmp(op: string): boolean {
  return op == "<" || op == "<=" || op == ">" || op == ">="
    || op == "==" || op == "!=" || op == "&&" || op == "||";
}

function irt_is_option(s: string): boolean {
  return s.len() >= 7 && slice_unchecked(s, 0, 7) == "Option[";
}

// irt_guess returns the inferred type-name string for a return expression,
// or "" if it can't be determined.
function irt_guess(e: ast.Expr, params: ast.ParamDecl[], funcs: FuncDecl[], structs: StructDecl[]): string {
  match (e) {
    ast.ExprNumber(n) => {
      // Suffix first, magnitude second — the same rule if_expr_rt and
      // mono_infer already apply. Reading a literal by value alone calls
      // `2147484197u32` i64 (past i32-max, well inside u32-max), and reading it
      // by neither left every wide literal looking like an i32 (#6468).
      if (n.is_float) {
        return "f64";
      }
      if (n.suffix.len() > 0) {
        return n.suffix;
      }
      if (literal_is_i64(n.text)) {
        return "i64";
      }
      return "i32";
    },
    ast.ExprString(_) => {
      return "string";
    },
    ast.ExprBool(_) => {
      return "boolean";
    },
    ast.ExprIdent(id) => {
      return irt_param_type(params, id.name);
    },
    ast.ExprBinary(b) => {
      if (irt_is_cmp(b.op)) {
        return "boolean";
      }
      return irt_guess(b.left, params, funcs, structs);
    },
    ast.ExprStructLit(s) => {
      return s.type_name;
    },
    ast.ExprArray(al) => {
      // A non-empty array literal infers `T[]` from its first element
      // (#5326): without this an unannotated array-returning function never
      // enters the `*_ret_fns_of` registries, so a `let a = f()` binding
      // left the slot's element kind untracked and a[i] silently took the
      // 4-byte default stride — a wrong-value miscompile for f64/string
      // elements on the self-host IR path.
      if (al.elements.len() == 0) {
        return "";
      }
      let el: string = irt_guess(al.elements[0], params, funcs, structs);
      if (el == "") {
        return "";
      }
      return el + "[]";
    },
    ast.ExprTuple(tl) => {
      // A tuple literal is the tuple of its elements' types, spelled the way
      // render_type_ref spells one, so an unannotated `const T = (3, "a")`
      // is typed like its annotated form (#7987).
      let parts: string = "";
      let ti: i32 = 0;
      while (ti < tl.elements.len()) {
        let tt: string = irt_guess(tl.elements[ti], params, funcs, structs);
        if (tt == "") {
          return "";
        }
        if (ti > 0) {
          parts = parts + ", ";
        }
        parts = parts + tt;
        ti = ti + 1;
      }
      return "(" + parts + ")";
    },
    ast.ExprIndex(ix) => {
      // `a[i]` yields the element type of whatever `a` infers to. Reached for
      // a LIFTED lambda (`() => a[1]`, `() => mk()[1]`), whose synthesised
      // FuncDecl carries ret_type "" — without this the inference bailed, the
      // function defaulted to returning i32, and an f64 body failed the wasm
      // validator inside the lifted function itself ("expected i32, found
      // f64"). No slot table is needed: a capture arrives as a PARAM of the
      // lifted function, so irt_param_type names it, and a call source is
      // named by irt_func_ret — the two sources irt_guess already has.
      let at: string = irt_guess(ix.array, params, funcs, structs);
      if (at.len() >= 3 && slice_unchecked(at, at.len() - 2, at.len()) == "[]") {
        return slice_unchecked(at, 0, at.len() - 2) + "";
      }
      // A SLICE source spells `[T]`, not `T[]` — indexing one still
      // yields T. Both spellings reach here because a slice can be
      // indexed directly (`a[0:2][1]`).
      if (at.len() >= 3 && at[0] == b'[' && at[at.len() - 1] == b']') {
        return slice_unchecked(at, 1, at.len() - 1) + "";
      }
      return "";
    },
    ast.ExprSlice(sl) => {
      // `a[i:j]` over a `T[]` yields the slice type `[T]` (the spelling the
      // checker uses — `let xs: [f64] = a[0:2];`). A slice of a slice keeps
      // that spelling.
      let st2: string = irt_guess(sl.array, params, funcs, structs);
      if (st2.len() >= 3 && slice_unchecked(st2, st2.len() - 2, st2.len()) == "[]") {
        return "[" + slice_unchecked(st2, 0, st2.len() - 2) + "]";
      }
      if (st2.len() >= 3 && st2[0] == b'[' && st2[st2.len() - 1] == b']') {
        return st2;
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      // `t.N` on a tuple — the same lifted-lambda case (`() => t.0` over a
      // captured tuple). me_tuple_elem_type already decodes a "(T0, T1)"
      // spelling depth-aware; reuse it rather than write a second decoder. A
      // non-numeric field is a struct field, which needs a struct table this
      // pass does not have, so it stays "" and the inference bails as before.
      let ot: string = irt_guess(fa.obj, params, funcs, structs);
      if (ot.len() == 0) {
        return "";
      }
      let tel: string = me_tuple_elem_type(ot, fa.field);
      if (tel.len() > 0) {
        return tel;
      }
      // Not a tuple index — a STRUCT field. me_field_type_of already
      // resolves a declared field's type; reuse it rather than add a
      // second lookup. "" for an unknown struct/field keeps the bail.
      return me_field_type_of(structs, ot, fa.field);
    },
    ast.ExprUnary(u) => {
      // `-x` / `+x` keep the operand's type; `!x` is boolean; an `as T` cast
      // names T directly. Without this a lifted `() => -a[1]` inferred "" and
      // the lambda defaulted to returning i32.
      if (u.op == "!") {
        return "boolean";
      }
      if (u.op == "-" || u.op == "+") {
        return irt_guess(u.operand, params, funcs, structs);
      }
      if (u.op == "as_f64" || u.op == "as_float") {
        return "f64";
      }
      if (u.op == "as_f32") {
        return "f32";
      }
      if (u.op == "as_i32") {
        return "i32";
      }
      if (u.op == "as_i64") {
        return "i64";
      }
      if (u.op == "as_u8") {
        return "u8";
      }
      if (u.op == "as_u32") {
        return "u32";
      }
      if (u.op == "as_u64") {
        return "u64";
      }
      return "";
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (cid.name == "Some") {
            if (c.args.len() == 1) {
              let inner: string = irt_guess(c.args[0], params, funcs, structs);
              if (inner != "") {
                return "Option[" + inner + "]";
              }
            }
            return "Option";
          }
          if (cid.name == "None") {
            return "Option";
          }
          // Result needs both type arguments which a single Ok/Err
          // return can't supply; leave it to an annotation.
          if (cid.name == "Ok" || cid.name == "Err") {
            return "";
          }
          // An ERASED-GENERIC PASSTHROUGH (`id[T](x: T): T`) returns
          // its argument, so its result type is that argument's — the
          // declared return is the type var `T`, which names nothing on
          // its own. Without this, `id(902i64)` inferred "T" and the
          // width was lost (#6468).
          let pth: i32 = irt_passthrough_arg_index(funcs, cid.name);
          if (pth >= 0 && pth < c.args.len()) {
            return irt_guess(c.args[pth], params, funcs, structs);
          }
          return irt_func_ret(funcs, cid.name);
        },
        ast.ExprFieldAccess(mfa) => {
          // A METHOD call `recv.m()` — resolve the receiver's type, then
          // the declared method return. irt_func_ret only sees
          // receiver-less functions, so without this a lifted
          // `() => p.scaled()` inferred "" and defaulted to i32.
          let rt2: string = irt_guess(mfa.obj, params, funcs, structs);
          if (rt2.len() == 0) {
            return "";
          }
          return irt_method_ret(funcs, rt2, mfa.field);
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
}

// irt_passthrough_arg_index returns the parameter position an ERASED-GENERIC
// passthrough returns unchanged — the `id[T](x: T): T` shape, where the declared
// return spelling is the same type var as a parameter's — or -1. An unbounded
// type param is erased rather than monomorphised, so `T` survives into the
// signature and names no type; the argument at that position is what the call
// actually yields.
function irt_passthrough_arg_index(funcs: FuncDecl[], name: string): i32 {
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].name == name && funcs[i].receiver_type.len() == 0 && funcs[i].all_type_params.len() > 0) {
      let p: i32 = 0;
      while (p < funcs[i].params.len()) {
        if (funcs[i].params[p].type_name.len() > 0 && funcs[i].params[p].type_name == funcs[i].ret_type) {
          return p;
        }
        p = p + 1;
      }
      return 0 - 1;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function irt_unify(a: string, b: string): string {
  if (a == b) {
    return a;
  }
  if (irt_is_option(a) && b == "Option") {
    return a;
  }
  if (irt_is_option(b) && a == "Option") {
    return b;
  }
  return "";
}

function irt_collect_returns(stmts: ast.Stmt[], acc: ast.Expr[]): ast.Expr[] {
  let out: ast.Expr[] = acc;
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = irt_collect_stmt(stmts[i], out);
    i = i + 1;
  }
  return out;
}

function irt_collect_stmt(st: ast.Stmt, acc: ast.Expr[]): ast.Expr[] {
  match (st) {
    ast.StmtReturn(r) => {
      return acc.append(r.value);
    },
    ast.StmtIf(f) => {
      let a: ast.Expr[] = irt_collect_returns(f.then_body, acc);
      return irt_collect_returns(f.else_body, a);
    },
    ast.StmtWhile(w) => {
      return irt_collect_returns(w.body, acc);
    },
    ast.StmtFor(fr) => {
      return irt_collect_returns(fr.body, acc);
    },
    ast.StmtMatch(m) => {
      let a: ast.Expr[] = acc;
      let i: i32 = 0;
      while (i < m.arms.len()) {
        a = irt_collect_returns(m.arms[i].body, a);
        i = i + 1;
      }
      return a;
    },
    _ => {
      return acc;
    }
  }
}

// irt_infer_func unifies the inferred types of every return in fd, or "" if
// any return can't be determined or they conflict (a bare `return;` value is
// ExprUnknown -> "" -> bail, so void / mixed functions keep their void type).
// irt_payload_of resolves the PAYLOAD type a `Some(n)` / `Ok(n)` arm binds, from
// the scrutinee's inferred type. A checked operator (`a +? b`) infers to its
// OPERAND type rather than to an `Option[…]` spelling — that is the form the
// corpus reaches this through — while an explicit `Option[X]` / `Result[X, …]`
// is stripped to X. "" when neither applies.
function irt_payload_of(scrut_ty: string): string {
  if (scrut_ty.len() == 0) {
    return "";
  }
  let b: i32 = 0;
  while (b < scrut_ty.len()) {
    if (scrut_ty[b] == b'[') {
      let inner: string = slice_unchecked(scrut_ty, b + 1, scrut_ty.len() - 1) + "";
      let c: i32 = 0;
      while (c < inner.len()) {
        if (inner[c] == b',') {
          return slice_unchecked(inner, 0, c) + "";
        }
        c = c + 1;
      }
      return inner;
    }
    b = b + 1;
  }
  if (irt_is_scalar_ty(scrut_ty)) {
    return scrut_ty;
  }
  return "";
}

function irt_is_scalar_ty(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u32" || t == "u64" || t == "u8"
    || t == "usize" || t == "f64" || t == "f32";
}

// irt_arm_bindings collects the payload bindings a match introduces, as
// pseudo-parameters typed from their scrutinee. irt_guess resolves an ident
// against parameters only, so `match (a +? b) { Some(n) => n, … }` inferred
// nothing for `n`, and a lifted value block returning it kept the parser's
// syntax-only i32 guess (#6468).
function irt_arm_bindings(stmts: ast.Stmt[], params: ast.ParamDecl[], funcs: FuncDecl[], structs: StructDecl[], acc: ast.ParamDecl[]): ast.ParamDecl[] {
  let out: ast.ParamDecl[] = acc;
  let i: i32 = 0;
  while (i < stmts.len()) {
    match (stmts[i]) {
      ast.StmtMatch(m) => {
        let st: string = irt_payload_of(irt_guess(m.scrutinee, params, funcs, structs));
        let a: i32 = 0;
        while (a < m.arms.len()) {
          match (m.arms[a].pattern) {
            ast.PatVariant(pv) => {
              if (st.len() > 0 && pv.binding.len() > 0 && pv.binding != "_") {
                out = out.append(ast.ParamDecl { name: pv.binding, type_name: st, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" });
              }
            },
            _ => {}
          }
          out = irt_arm_bindings(m.arms[a].body, params, funcs, structs, out);
          a = a + 1;
        }
      },
      ast.StmtIf(f) => {
        out = irt_arm_bindings(f.then_body, params, funcs, structs, out);
        out = irt_arm_bindings(f.else_body, params, funcs, structs, out);
      },
      ast.StmtWhile(w) => {
        out = irt_arm_bindings(w.body, params, funcs, structs, out);
      },
      ast.StmtFor(fr) => {
        out = irt_arm_bindings(fr.body, params, funcs, structs, out);
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

function irt_infer_func(fd: FuncDecl, funcs: FuncDecl[], structs: StructDecl[]): string {
  let empty: ast.Expr[] = [];
  let rets: ast.Expr[] = irt_collect_returns(fd.body, empty);
  if (rets.len() == 0) {
    return "";
  }
  let scope: ast.ParamDecl[] = irt_arm_bindings(fd.body, fd.params, funcs, structs, fd.params);
  let unified: string = "";
  let i: i32 = 0;
  while (i < rets.len()) {
    let g: string = irt_guess(rets[i], scope, funcs, structs);
    if (g == "") {
      return "";
    }
    if (unified == "") {
      unified = g;
    } else {
      unified = irt_unify(unified, g);
      if (unified == "") {
        return "";
      }
    }
    i = i + 1;
  }
  return unified;
}

function irt_set_ret(funcs: FuncDecl[], idx: i32, rt: string): FuncDecl[] {
  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (i == idx) {
      let f: FuncDecl = funcs[i];
      out = out.append(FuncDecl { ...f, ret_type: rt });
    } else {
      out = out.append(funcs[i]);
    }
    i = i + 1;
  }
  return out;
}

// infer_ret_types_module stamps an inferred ret_type on each unannotated
// plain (non-method, non-generic) function. A few passes let a call to a
// function inferred later in the list resolve.
pub function infer_ret_types_module(mod: Module): Module {
  let funcs: FuncDecl[] = mod.funcs;
  let pass: i32 = 0;
  while (pass < 3) {
    let i: i32 = 0;
    while (i < funcs.len()) {
      let fd: FuncDecl = funcs[i];
      if (fd.ret_type == "" && fd.body.len() > 0 && fd.receiver_type.len() == 0 && fd.all_type_params.len() == 0) {
        let inferred: string = irt_infer_func(fd, funcs, mod.structs);
        if (inferred != "") {
          funcs = irt_set_ret(funcs, i, inferred);
        }
      } else if (fd.ret_type == "i32" && fd.body.len() > 0 && fd.receiver_type.len() == 0
        && fd.all_type_params.len() == 0 && fd.name.len() > 6 && slice_unchecked(fd.name, 0, 6) == "__lam_") {
        // A LIFTED value-block lambda carries the parser's syntax-only tag,
        // not an author's annotation — `if_expr_rt` has no function table, so
        // an arm that calls anything falls to its "i32" default. Here the
        // table exists, so a 64-bit body WIDENS that guess. Only `__lam_`
        // names are eligible (they are synthesised, never written), and only
        // narrow -> wide: the tag exists to stop contradicting the body, and
        // narrowing one would be the contradiction in the other direction.
        let winf: string = irt_infer_func(fd, funcs, mod.structs);
        if (winf == "i64" || winf == "u64" || winf == "f64") {
          funcs = irt_set_ret(funcs, i, winf);
        }
      }
      i = i + 1;
    }
    pass = pass + 1;
  }
  return Module { ...mod, funcs: funcs };
}

// ===================================================================
// #4380 lever 3: syntactic bounds-check elision for len-bounded loops.
//
// A purely syntactic pass that marks array-index READS `arr[i]` inside a loop
// guarded by `i < arr.len()` as Unchecked, so the lowering drops the
// per-iteration bounds check + the per-access `len` reload (op_arr_get_nc).
// internal/syntax/parser/bounds_elide.go is the native pass it grew from; the
// self-host one also takes a field path, a length bound to a local, and a
// guard that is one conjunct of the condition. No type info is
// consulted: the IR honours the flag ONLY on the true array path, so marking a
// string / map index is a harmless no-op there.
//
// Self-host specifics vs the native pass:
//   - There is no C-style-for AST node (parse_for_stmt desugars it to
//     `while (true) { … if (!(cond)) break … }` at parse time), so only an
//     EXPLICIT `while (i < arr.len())` guard is matched. The self-host code
//     the pass targets uses that idiom near-universally.
//   - Index WRITES desugar to `__set_index(arr, i, v)` calls, never ExprIndex,
//     so every `arr[i]` ExprIndex is a read — no write target to mis-mark.
//   - Closures capture by value and the checker forbids assigning a captured
//     variable (E049), so a lambda body can never mutate the outer `i` / rebind
//     `arr`. The safety walks below therefore recurse through statements only
//     (assignments are always statements; the only expr carrying statements is
//     a lambda, which cannot touch the outer bindings).
//
// An access is marked only when `0 <= i < arr.len()` is syntactically provable:
//   - one top-level `&&` conjunct of the guard is `i < P.len()` or `i < n`
//     (strict `<`, `i` and `n` bare idents, `P` a field path such as `xs` or
//     `r.items` rooted at an ident other than `i`) — the upper bound. A bare `n`
//     counts only when the nearest earlier statement at the same level binding
//     it is `let n = P.len()`, and nothing between that and the loop assigns or
//     rebinds `n` or `P`'s root;
//   - `i` starts at a non-negative integer literal in an earlier statement at
//     the same level that nothing between it and the loop assigns or rebinds,
//     and every assignment to `i` in the body is
//     `i = i + <non-negative int literal>` — so `i` is monotonic non-decreasing
//     and never drops below 0 (the check also guards NEGATIVE indices);
//   - `P`'s root is never reassigned and none of `i`, `n` or the root is
//     rebound (shadowed) in the body — so the length and the binding stay
//     invariant. Fields and elements are immutable after construction (E048,
//     E056), so reassigning the root is the only way to change `P`;
//   - the access precedes the first statement that assigns `i` (a read after an
//     increment could reach the length), or sits in the guard to the right of
//     the bounding conjunct, which it is evaluated only after.
// Accesses inside a lambda / defer body are never marked: that code runs later,
// when `i` may have advanced past `len`.

// arr is the bounded path and root the ident it is rooted at; bound names the
// local holding its length instead, when the guard does not call `.len()`.
struct LenLoopMatch { ok: boolean, idx: string, arr: string, root: string, bound: string }

// LenPath is the `P` of a `P.len()`: its spelling and the ident it is rooted at.
struct LenPath { path: string, root: string }

// elide_len_bounded_body is the pass entry: it rewrites a function body,
// returning a copy with in-bounds `arr[i]` reads marked. Called where
// semsource builds a declaration's body — after every AST transform — so no
// later pass
// clobbers the flag and the transform sites all default it to false.
pub function elide_len_bounded_body(stmts: ast.Stmt[]): ast.Stmt[] {
  // Recurse into nested statement lists first, so inner loops are handled in
  // place; then elide while-loops at THIS level (each reads its preceding
  // statements for `i`'s start value and a cached length).
  let lowered: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    lowered = lowered.append(elb_recurse_stmt(stmts[i]));
    i = i + 1;
  }
  let out: ast.Stmt[] = [];
  let p: i32 = 0;
  while (p < lowered.len()) {
    let st: ast.Stmt = lowered[p];
    match (st) {
      ast.StmtWhile(w) => {
        st = elb_try_while(w, lowered, p);
      },
      _ => {}
    }
    out = out.append(st);
    p = p + 1;
  }
  return out;
}

// elb_recurse_stmt rebuilds one statement with elide_len_bounded_body applied to
// each nested statement list (does NOT descend into lambda bodies — they are
// lifted to their own FuncDecls before lowering, each processed separately).
function elb_recurse_stmt(st: ast.Stmt): ast.Stmt {
  match (st) {
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: f.cond, then_body: elide_len_bounded_body(f.then_body), else_body: elide_len_bounded_body(f.else_body) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: w.cond, body: elide_len_bounded_body(w.body), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: fr.iter, body: elide_len_bounded_body(fr.body), label: fr.label, line: fr.line };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let arm: ast.MatchArm = m.arms[i];
        arms = arms.append(ast.MatchArm { ...arm, body: elide_len_bounded_body(arm.body) });
        i = i + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: m.scrutinee, arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { action: elb_recurse_stmt(d.action), on_error: d.on_error, line: d.line };
    },
    _ => {
      return st;
    }
  }
  return st;
}

// elb_try_while checks the invariants for the while-loop at stmts[p] and, when
// they hold, returns the loop with its qualifying reads marked. The statements
// before it are where `i`'s start value and a cached length come from.
function elb_try_while(w: ast.StmtWhile, stmts: ast.Stmt[], p: i32): ast.Stmt {
  let same: ast.Stmt = ast.StmtWhile { cond: w.cond, body: w.body, label: w.label, line: w.line, is_loop: w.is_loop };
  let m: LenLoopMatch = elb_loop_match(w.cond);
  if (!m.ok) {
    return same;
  }
  let lp: LenPath = LenPath { path: m.arr, root: m.root };
  if (m.bound != "") {
    lp = elb_len_local(stmts, p, m.bound);
    if (lp.path == "" || elb_assigns_stmts(w.body, m.bound) || elb_binds_stmts(w.body, m.bound)) {
      return same;
    }
  }
  if (lp.root == m.idx || elb_assigns_stmts(w.body, lp.root)) {
    return same;
  }
  if (elb_binds_stmts(w.body, m.idx) || elb_binds_stmts(w.body, lp.root)) {
    return same;
  }
  if (!elb_idx_monotonic_stmts(w.body, m.idx)) {
    return same;
  }
  if (!elb_starts_nonneg(stmts, p, m.idx)) {
    return same;
  }
  let nb: ast.Stmt[] = [];
  let i: i32 = 0;
  let stop: boolean = false;
  while (i < w.body.len()) {
    let st: ast.Stmt = w.body[i];
    if (!stop && elb_assigns_stmt(st, m.idx)) {
      stop = true;
    }
    if (!stop) {
      st = elb_mark_stmt(st, m.idx, lp.path);
    }
    nb = nb.append(st);
    i = i + 1;
  }
  let cond: ast.Expr = elb_mark_cond(w.cond, m, lp.path).e;
  return ast.StmtWhile { cond: cond, body: nb, label: w.label, line: w.line, is_loop: w.is_loop };
}

// elb_loop_match finds the bounding conjunct `IDX < P.len()` or `IDX < N` along
// the top-level `&&` chain of a loop guard and returns (IDX, P) or (IDX, N).
function elb_loop_match(cond: ast.Expr): LenLoopMatch {
  match (cond) {
    ast.ExprBinary(b) => {
      if (b.op == "&&") {
        let l: LenLoopMatch = elb_loop_match(b.left);
        if (l.ok) {
          return l;
        }
        return elb_loop_match(b.right);
      }
      if (b.op == "<") {
        match (b.left) {
          ast.ExprIdent(li) => {
            let lp: LenPath = elb_len_path(b.right);
            if (lp.path != "") {
              return LenLoopMatch { ok: true, idx: li.name, arr: lp.path, root: lp.root, bound: "" };
            }
            match (b.right) {
              ast.ExprIdent(ni) => {
                if (ni.name != li.name) {
                  return LenLoopMatch { ok: true, idx: li.name, arr: "", root: "", bound: ni.name };
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  return LenLoopMatch { ok: false, idx: "", arr: "", root: "", bound: "" };
}

// elb_len_path returns the path of a `P.len()` length expression, or an empty
// one. Fern has no free `len(A)` function (that idiom is E001), so only the
// method form is matched.
function elb_len_path(e: ast.Expr): LenPath {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field == "len" && c.args.len() == 0) {
            return LenPath { path: elb_path(fa.obj), root: elb_path_root(fa.obj) };
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return LenPath { path: "", root: "" };
}

// elb_path spells a field path rooted at a bare ident (`xs`, `r.items`), or ""
// for any other expression.
function elb_path(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    ast.ExprFieldAccess(fa) => {
      let base: string = elb_path(fa.obj);
      if (base != "") {
        return base + "." + fa.field;
      }
    },
    _ => {}
  }
  return "";
}

function elb_path_root(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    ast.ExprFieldAccess(fa) => {
      return elb_path_root(fa.obj);
    },
    _ => {}
  }
  return "";
}

// elb_len_local resolves a loop bound `n` to the path of the nearest earlier
// statement at this level binding it, when that is `let n = P.len()` and no
// statement between it and the loop at stmts[p] assigns `n` or assigns or
// rebinds `P`'s root.
function elb_len_local(stmts: ast.Stmt[], p: i32, n: string): LenPath {
  let none: LenPath = LenPath { path: "", root: "" };
  let q: i32 = p - 1;
  while (q >= 0) {
    match (stmts[q]) {
      ast.StmtVar(v) => {
        if (v.name == n) {
          let lp: LenPath = elb_len_path(v.init);
          if (lp.path == "") {
            return none;
          }
          let k: i32 = q + 1;
          while (k < p) {
            if (elb_assigns_stmt(stmts[k], n) || elb_assigns_stmt(stmts[k], lp.root) || elb_binds_stmts([stmts[k]], lp.root)) {
              return none;
            }
            k = k + 1;
          }
          return lp;
        }
      },
      _ => {}
    }
    q = q - 1;
  }
  return none;
}

// elb_starts_nonneg proves `idx`'s entry value is a non-negative integer
// literal: the nearest earlier statement at this level that binds or assigns
// `idx` is `let idx = v` / `idx = v` with v such a literal.
function elb_starts_nonneg(stmts: ast.Stmt[], p: i32, idx: string): boolean {
  let q: i32 = p - 1;
  while (q >= 0) {
    let st: ast.Stmt = stmts[q];
    match (st) {
      ast.StmtVar(v) => {
        if (v.name == idx) {
          return elb_is_nonneg_int(v.init);
        }
      },
      ast.StmtAssign(a) => {
        if (a.target == idx) {
          return elb_is_nonneg_int(a.value);
        }
      },
      _ => {}
    }
    if (elb_assigns_stmt(st, idx) || elb_binds_stmts([st], idx)) {
      return false;
    }
    q = q - 1;
  }
  return false;
}

// elb_is_nonneg_int reports whether e is a non-negative integer literal. The
// lexer tokenises `-1` as unary-minus over `1`, so a bare integer ExprNumber is
// always non-negative; the leading-digit guard is a redundant extra check.
function elb_is_nonneg_int(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      if (n.is_float) {
        return false;
      }
      if (n.text.len() == 0) {
        return false;
      }
      let c0: i32 = n.text[0] as i32;
      return c0 >= 48 && c0 <= 57;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// elb_assigns_stmts / elb_assigns_stmt report whether any `name = …` assignment
// appears in the statement subtree. Assignments are always statements (the only
// expr that carries statements is a lambda, which cannot assign the outer name),
// so the walk follows the statement spine: statement lists at every depth, lambda
// bodies never.
function elb_assigns_stmt(st: ast.Stmt, name: string): boolean {
  function vs(s: ast.Stmt, own hit: boolean): boolean {
    if (hit) {
      return true;
    }
    match (s) {
      ast.StmtAssign(a) => {
        return a.target == name;
      },
      _ => {
        return false;
      }
    }
    return false;
  }
  return astwalk.fold_stmt_spine(st, false, vs);
}

function elb_assigns_stmts(stmts: ast.Stmt[], name: string): boolean {
  for st in stmts {
    if (elb_assigns_stmt(st, name)) {
      return true;
    }
  }
  return false;
}

// elb_binds_stmts reports whether the statement subtree rebinds (declares /
// shadows / iterates) `name` via a `let`, a `for` loop variable, or a match-arm
// pattern binding. It uses the shared binder collector, which WIDENS the guard
// onto binders the hand-written walk never matched: a comma-joined destructure
// binder ("i,x" against "i") and a match arm's `@` whole-value binder now
// refuse the elision too — the safe direction for a gate.
function elb_binds_stmts(stmts: ast.Stmt[], name: string): boolean {
  return util.has_str(astwalk.collect_bound_stmts(stmts, []), name);
}

// elb_idx_monotonic_stmts / _stmt report whether EVERY assignment to `idx` in
// the subtree is `idx = idx + <non-negative int literal>` (keeps idx monotonic
// non-decreasing). Any other shape fails.
function elb_idx_monotonic_stmts(stmts: ast.Stmt[], idx: string): boolean {
  function vs(s: ast.Stmt, own ok: boolean): boolean {
    if (!ok) {
      return false;
    }
    match (s) {
      ast.StmtAssign(a) => {
        if (a.target == idx) {
          return elb_is_monotonic_incr(a.value, idx);
        }
        return true;
      },
      _ => {
        return true;
      }
    }
    return true;
  }
  let ok: boolean = true;
  for st in stmts {
    ok = astwalk.fold_stmt_spine(st, ok, vs);
  }
  return ok;
}

function elb_is_monotonic_incr(v: ast.Expr, idx: string): boolean {
  match (v) {
    ast.ExprBinary(b) => {
      if (b.op == "+") {
        match (b.left) {
          ast.ExprIdent(li) => {
            if (li.name == idx) {
              return elb_is_nonneg_int(b.right);
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  return false;
}

// elb_mark_stmt / elb_mark_stmts / elb_mark_expr rebuild the subtree, setting
// `unchecked` on every `arr[idx]` read (`idx` the exact ident, the array the
// exact path `arr`). They do
// NOT descend into lambda bodies or defer actions — that code runs later, when
// idx may have advanced past len.
function elb_mark_stmts(stmts: ast.Stmt[], idx: string, arr: string): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(elb_mark_stmt(stmts[i], idx, arr));
    i = i + 1;
  }
  return out;
}

function elb_mark_stmt(st: ast.Stmt, idx: string, arr: string): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      return ast.StmtVar { name: v.name, type_name: v.type_name, init: elb_mark_expr(v.init, idx, arr), line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: elb_mark_expr(r.value, idx, arr), line: r.line, col: r.col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: elb_mark_expr(x.value, idx, arr), line: x.line };
    },
    ast.StmtAssign(a) => {
      return ast.StmtAssign { target: a.target, value: elb_mark_expr(a.value, idx, arr), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: elb_mark_expr(f.cond, idx, arr), then_body: elb_mark_stmts(f.then_body, idx, arr), else_body: elb_mark_stmts(f.else_body, idx, arr) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: elb_mark_expr(w.cond, idx, arr), body: elb_mark_stmts(w.body, idx, arr), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: elb_mark_expr(fr.iter, idx, arr), body: elb_mark_stmts(fr.body, idx, arr), label: fr.label, line: fr.line };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let i: i32 = 0;
      while (i < m.arms.len()) {
        let arm: ast.MatchArm = m.arms[i];
        arms = arms.append(ast.MatchArm { ...arm, body: elb_mark_stmts(arm.body, idx, arr), guard: elb_mark_expr(arm.guard, idx, arr) });
        i = i + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: elb_mark_expr(m.scrutinee, idx, arr), arms: arms };
    },
    _ => {
      return st;
    }
  }
  return st;
}

// elb_mark_cond marks the reads a loop guard makes once its bounding conjunct
// has held: everything to the right of that conjunct along the `&&` chain.
// `past` reports whether the conjunct has been evaluated, and held, by the time
// the expression yields true.
struct CondMark { e: ast.Expr, past: boolean }

function elb_mark_cond(c: ast.Expr, m: LenLoopMatch, arr: string): CondMark {
  match (c) {
    ast.ExprBinary(b) => {
      if (b.op == "&&") {
        let l: CondMark = elb_mark_cond(b.left, m, arr);
        if (l.past) {
          return CondMark { e: ast.ExprBinary { op: b.op, left: l.e, right: elb_mark_expr(b.right, m.idx, arr), line: b.line, col: b.col, ty: b.ty }, past: true };
        }
        let r: CondMark = elb_mark_cond(b.right, m, arr);
        return CondMark { e: ast.ExprBinary { op: b.op, left: b.left, right: r.e, line: b.line, col: b.col, ty: b.ty }, past: r.past };
      }
    },
    _ => {}
  }
  let g: LenLoopMatch = elb_loop_match(c);
  return CondMark { e: c, past: g.ok && g.idx == m.idx && g.arr == m.arr && g.bound == m.bound };
}

function elb_mark_expr(e: ast.Expr, idx: string, arr: string): ast.Expr {
  match (e) {
    ast.ExprIndex(ix) => {
      let mark: boolean = ix.unchecked;
      match (ix.index) {
        ast.ExprIdent(iid) => {
          if (iid.name == idx && elb_path(ix.array) == arr) {
            mark = true;
          }
        },
        _ => {}
      }
      return ast.ExprIndex { array: elb_mark_expr(ix.array, idx, arr), index: elb_mark_expr(ix.index, idx, arr), unchecked: mark, ty: ix.ty, line: ix.line, col: ix.col };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: elb_mark_expr(b.left, idx, arr), right: elb_mark_expr(b.right, idx, arr), line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: elb_mark_expr(u.operand, idx, arr), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprCall(c) => {
      let na: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < c.args.len()) {
        na = na.append(elb_mark_expr(c.args[i], idx, arr));
        i = i + 1;
      }
      return ast.ExprCall { callee: elb_mark_expr(c.callee, idx, arr), args: na, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      let ne: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < a.elements.len()) {
        ne = ne.append(elb_mark_expr(a.elements[i], idx, arr));
        i = i + 1;
      }
      return ast.ExprArray { ...a, elements: ne };
    },
    ast.ExprTuple(t) => {
      let ne: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < t.elements.len()) {
        ne = ne.append(elb_mark_expr(t.elements[i], idx, arr));
        i = i + 1;
      }
      return ast.ExprTuple { elements: ne, line: t.line, col: t.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: elb_mark_expr(sl.array, idx, arr), start: elb_mark_expr(sl.start, idx, arr), end: elb_mark_expr(sl.end, idx, arr) };
    },
    ast.ExprStructLit(sl) => {
      let nv: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < sl.field_values.len()) {
        nv = nv.append(elb_mark_expr(sl.field_values[i], idx, arr));
        i = i + 1;
      }
      let nbase: ast.Expr = sl.base;
      if (sl.has_base) {
        nbase = elb_mark_expr(sl.base, idx, arr);
      }
      return ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col, written: sl.written };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { obj: elb_mark_expr(fa.obj, idx, arr), field: fa.field, line: fa.line, col: fa.col, ty: fa.ty };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// erase_view_spelling rewrites a type spelling to what the lowering sees: each
// bare `str` becomes `string` and each `[T]` view becomes `T[]`, since a view
// lowers to exactly the box it borrows from.
pub function erase_view_spelling(ty: string): string {
  return fold_view_spelling(erase_str_names(ty));
}

// A prefix `[` opens a view; after a name it opens generic arguments, and an
// empty `[]` after a type is an array suffix.
function view_opens_at(ty: string, i: i32): boolean {
  if (i + 1 < ty.len() && ty[i + 1] == b']') {
    return false;
  }
  if (i == 0) {
    return true;
  }
  let prev: u8 = ty[i - 1];
  return prev == b'(' || prev == b'[' || prev == b',' || prev == b' ';
}

// fold_view_spelling folds every `[T]` in a spelling to `T[]`, innermost
// first: `[u8][]` is `u8[][]` and `([u8], i32)` is `(u8[], i32)`.
function fold_view_spelling(ty: string): string {
  let i: i32 = 0;
  while (i < ty.len()) {
    if (ty[i] == b'[' && view_opens_at(ty, i)) {
      let close: i32 = matching_bracket(ty, i);
      if (close < 0) {
        return ty;
      }
      let inner: string = fold_view_spelling(slice_unchecked(ty, i + 1, close) + "");
      return slice_unchecked(ty, 0, i) + inner + "[]" + fold_view_spelling(slice_unchecked(ty, close + 1, ty.len()) + "");
    }
    i = i + 1;
  }
  return ty;
}

// A qualified `str.Foo` or a projection `X::str` is a different name and stays.
function erase_str_names(ty: string): string {
  let out: string = "";
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < ty.len()) {
    if (!ident_byte(ty[i] as i32)) {
      i = i + 1;
      continue;
    }
    let j: i32 = i;
    while (j < ty.len() && ident_byte(ty[j] as i32)) {
      j = j + 1;
    }
    let qualified: boolean = i > 0 && (ty[i - 1] == b'.' || ty[i - 1] == b':') || j < ty.len() && (ty[j] == b'.' || ty[j] == b':');
    if (j - i == 3 && !qualified && slice_unchecked(ty, i, j) == "str") {
      out = out + slice_unchecked(ty, start, i) + "string";
      start = j;
    }
    i = j;
  }
  if (start == 0) {
    return ty;
  }
  return out + slice_unchecked(ty, start, ty.len());
}

// receiver_base is the name a method is keyed by on its receiver: the base
// type, with `str` spelled `string` as the lowering spells it.
pub function receiver_base(receiver: string): string {
  return util.base_type_name(erase_view_spelling(receiver));
}

// decl_key is the symbol a declaration is called by: a free function's name,
// and a method's `<receiver_base>.<name>`, since two types may declare one
// method name. Contracts and dyn dispatch arms are keyed by it.
pub function decl_key(fd: FuncDecl): string {
  if (fd.receiver_type.len() == 0) {
    return fd.name;
  }
  return receiver_base(fd.receiver_type) + "." + fd.name;
}

// receiver_namespace is the name a method declaration is keyed by against
// the others: every owned-array receiver shares `Array` and every view
// receiver `slice`, whatever the element, as native keys them.
pub function receiver_namespace(receiver: string): string {
  let r: TypeRef = parse_type_ref(receiver);
  if (r.array_depth > 0) {
    return "Array";
  }
  if (r.is_view) {
    return "slice";
  }
  return receiver_base(receiver);
}

function erase_view_list(tys: string[]): string[] {
  let out: string[] = [];
  for t in tys {
    out = out.append(erase_view_spelling(t));
  }
  return out;
}

function erase_view_params(ps: ast.ParamDecl[]): ast.ParamDecl[] {
  let out: ast.ParamDecl[] = [];
  for p in ps {
    out = out.append(ast.ParamDecl { ...p, type_name: erase_view_spelling(p.type_name), fn_ret: erase_view_spelling(p.fn_ret), fn_param_types: erase_view_spelling(p.fn_param_types) });
  }
  return out;
}

function erase_view_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprCall(c) => {
      return ast.ExprCall { ...c, type_args: erase_view_list(c.type_args), ty: erase_view_spelling(c.ty) };
    },
    ast.ExprArray(a) => {
      return ast.ExprArray { ...a, elem_ty: erase_view_spelling(a.elem_ty) };
    },
    ast.ExprStructLit(sl) => {
      return ast.ExprStructLit { ...sl, type_name: erase_view_spelling(sl.type_name), written: erase_view_spelling(sl.written) };
    },
    ast.ExprZero(z) => {
      return ast.ExprZero { ...z, type_name: erase_view_spelling(z.type_name) };
    },
    ast.ExprUnary(u) => {
      // A cast carries its target in the operator: `as T`.
      let op: string = u.op;
      if (op.len() > 3 && slice_unchecked(op, 0, 3) == "as ") {
        op = erase_view_spelling(op);
      }
      return ast.ExprUnary { ...u, op: op, ty: erase_view_spelling(u.ty) };
    },
    ast.ExprLambda(lm) => {
      return ast.ExprLambda { ...lm, params: erase_view_params(lm.params), ret_type: erase_view_spelling(lm.ret_type), ret_fn_ret: erase_view_spelling(lm.ret_fn_ret), ret_fn_param_types: erase_view_spelling(lm.ret_fn_param_types) };
    },
    ast.ExprIdent(id) => {
      return ast.ExprIdent { ...id, ty: erase_view_spelling(id.ty) };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { ...b, ty: erase_view_spelling(b.ty) };
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { ...ix, ty: erase_view_spelling(ix.ty) };
    },
    ast.ExprSlice(sl2) => {
      return ast.ExprSlice { ...sl2, ty: erase_view_spelling(sl2.ty) };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, ty: erase_view_spelling(fa.ty) };
    },
    _ => {
      return e;
    }
  }
  return e;
}

function erase_view_stmt(st: ast.Stmt): ast.Stmt[] {
  if let ast.StmtVar(v) = st {
    return [ast.StmtVar { ...v, type_name: erase_view_spelling(v.type_name), fn_ret: erase_view_spelling(v.fn_ret), fn_param_types: erase_view_spelling(v.fn_param_types) }];
  }
  return [st];
}

// spells_view reports whether erasing `ty` can change it: a `[` that opens
// a view, or the identifier `str` on its own. A qualified `str.Foo` passes
// too, and the erasure then leaves it alone.
function spells_view(ty: string): boolean {
  let i: i32 = 0;
  let n: i32 = ty.len();
  while (i < n) {
    let b: u8 = ty[i];
    if (b == b'[' && view_opens_at(ty, i)) {
      return true;
    }
    if (b == b's' && i + 2 < n && ty[i + 1] == b't' && ty[i + 2] == b'r'
      && (i == 0 || !ident_byte(ty[i - 1] as i32)) && (i + 3 == n || !ident_byte(ty[i + 3] as i32))) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function spells_view_any(tys: string[]): boolean {
  for t in tys {
    if (spells_view(t)) {
      return true;
    }
  }
  return false;
}

function spells_view_params(ps: ast.ParamDecl[]): boolean {
  for p in ps {
    if (spells_view(p.type_name) || spells_view(p.fn_ret) || spells_view(p.fn_param_types)) {
      return true;
    }
  }
  return false;
}

// spells_view_stmt and spells_view_expr read the spellings erase_view_stmt
// and erase_view_expr rewrite, and nothing else.
function spells_view_stmt(st: ast.Stmt, own found: boolean): boolean {
  if (found) {
    return true;
  }
  if let ast.StmtVar(v) = st {
    return spells_view(v.type_name) || spells_view(v.fn_ret) || spells_view(v.fn_param_types);
  }
  return false;
}

function spells_view_expr(e: ast.Expr, own found: boolean): boolean {
  if (found) {
    return true;
  }
  match (e) {
    ast.ExprCall(c) => {
      return spells_view_any(c.type_args) || spells_view(c.ty);
    },
    ast.ExprArray(a) => {
      return spells_view(a.elem_ty);
    },
    ast.ExprStructLit(sl) => {
      return spells_view(sl.type_name) || spells_view(sl.written);
    },
    ast.ExprZero(z) => {
      return spells_view(z.type_name);
    },
    ast.ExprUnary(u) => {
      return u.op.len() > 3 && slice_unchecked(u.op, 0, 3) == "as " && spells_view(u.op) || spells_view(u.ty);
    },
    ast.ExprLambda(lm) => {
      return spells_view_params(lm.params) || spells_view(lm.ret_type) || spells_view(lm.ret_fn_ret) || spells_view(lm.ret_fn_param_types);
    },
    ast.ExprIdent(id) => {
      return spells_view(id.ty);
    },
    ast.ExprBinary(b) => {
      return spells_view(b.ty);
    },
    ast.ExprIndex(ix) => {
      return spells_view(ix.ty);
    },
    ast.ExprSlice(sl2) => {
      return spells_view(sl2.ty);
    },
    ast.ExprFieldAccess(fa) => {
      return spells_view(fa.ty);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// A body that spells no view and no `str` is handed back as it is: the
// rewrite would rebuild every node of it to change nothing.
function erase_view_body(body: ast.Stmt[]): ast.Stmt[] {
  let found: boolean = false;
  for st in body {
    found = astwalk.fold_stmt_nodes(st, found, spells_view_stmt, spells_view_expr, astwalk.descend_all);
  }
  if (!found) {
    return body;
  }
  return astwalk.splice_stmts(astwalk.map_stmts(body, erase_view_expr), erase_view_stmt);
}

function erase_view_funcs(fds: FuncDecl[]): FuncDecl[] {
  let out: FuncDecl[] = [];
  for fd in fds {
    out = out.append(FuncDecl { ...fd, receiver_type: erase_view_spelling(fd.receiver_type), params: erase_view_params(fd.params), ret_type: erase_view_spelling(fd.ret_type), ret_fn_ret: erase_view_spelling(fd.ret_fn_ret), ret_fn_param_types: erase_view_spelling(fd.ret_fn_param_types), body: erase_view_body(fd.body) });
  }
  return out;
}

pub function erase_view_structs(sds: StructDecl[]): StructDecl[] {
  let out: StructDecl[] = [];
  for sd in sds {
    out = out.append(erase_view_struct(sd));
  }
  return out;
}

function erase_view_struct(sd: StructDecl): StructDecl {
  let fields: StructFieldDecl[] = [];
  for f in sd.fields {
    fields = fields.append(StructFieldDecl { ...f, type_name: erase_view_spelling(f.type_name), fn_ret: erase_view_spelling(f.fn_ret), fn_param_types: erase_view_spelling(f.fn_param_types) });
  }
  return StructDecl { ...sd, fields: fields };
}

// erase_view_module is the self-host's view erasure, the mirror of native's
// ir.eraseStr at LowerWith: the checker and the typed lowering see every `str`
// and `[T]` as a view, and to the AST lowering each is the box it lowers to.
pub function erase_view_module(mod: Module): Module {
  let structs: StructDecl[] = erase_view_structs(mod.structs);
  let aliases: TypeAlias[] = [];
  for al in mod.aliases {
    aliases = aliases.append(TypeAlias { ...al, variants: erase_view_list(al.variants), variant_args: erase_view_list(al.variant_args) });
  }
  let impls: ImplInfo[] = [];
  for im in mod.impls {
    impls = impls.append(ImplInfo { ...im, impl_type: erase_view_spelling(im.impl_type), trait_spelling: erase_view_spelling(im.trait_spelling), trait_ref: erase_view_spelling(im.trait_ref), assoc_values: erase_view_list(im.assoc_values) });
  }
  let reqs: TraitReq[] = [];
  for tr in mod.trait_reqs {
    reqs = reqs.append(TraitReq { ...tr, req_sigs: erase_view_funcs(tr.req_sigs), assoc_sigs: erase_view_funcs(tr.assoc_sigs), default_sigs: erase_view_funcs(tr.default_sigs) });
  }
  let tdecls: TraitDecl[] = [];
  for td in mod.trait_decls {
    tdecls = tdecls.append(TraitDecl { ...td, methods: erase_view_funcs(td.methods) });
  }
  return Module { ...mod, funcs: erase_view_funcs(mod.funcs), structs: structs, aliases: aliases, top_stmts: erase_view_body(mod.top_stmts), impls: impls, trait_reqs: reqs, trait_decls: tdecls };
}

// module_with_builtins is the module the AST lowering reads: the typed one
// below with every `str` erased.
pub function module_with_builtins(mod: Module): Module {
  return erase_view_module(module_with_builtins_typed(mod));
}

// module_with_builtins_typed keeps each `str` as written, for the typed
// lowering, which holds a view as a type of its own. Its erasure lines up
// with module_with_builtins declaration for declaration.
pub function module_with_builtins_typed(mod: Module): Module {
  // Prepare defaults, ranges, return types and resource drops before generic
  // specialization. Deferred actions retain their source scopes until the
  // IR consumer resolves binding identities and expands cleanup.
  let mono: Module = monomorphize_all(register_struct_method_generics(register_map_method_generics(register_array_method_generics(lower_defers_prepass_module(hoist_local_funcs_module(desugar_prepass_module(mod)))))));
  return Module { ...mono, structs: inject_builtin_enums(mono.structs) };
}

// ---- type-variable respelling -------------------------------------------
// Every later stage reads types as SPELLINGS, so a type variable must never be
// spelled like a concrete type: `PMap[K, V]` taken at a user `struct K`
// substitutes `K := K`, and the clone is then indistinguishable from its
// template (#9577). rename_type_vars_module, the last step of the compile-path
// parse, respells every declaration's type variables `0_<name>`. No identifier
// starts with a digit, so looks_type_var is exact on the result;
// util.show_type_vars turns the spelling back for a diagnostic, and
// written_type_vars_module for the printer.

function tvar_spelling(name: string): string {
  if (looks_type_var(name)) {
    return name;
  }
  return "0_" + name;
}

// desugar_trait_params makes a parameter whose type names a trait an anonymous
// type parameter bounded by it: `f(d: Driver)` becomes `f[T_d: Driver](d: T_d)`
// and is monomorphised like any generic. `dyn Driver` is the dynamic form, so
// a bare trait in a parameter type has no other meaning. `traits` holds the
// spellings that name a trait in this module: its own traits bare, an import's
// as `alias.Trait`. `spelled` names the new parameter in the `0_` spelling, for
// a module whose type variables have already been respelled.
pub function desugar_trait_params(mod: Module, traits: string[], spelled: boolean): Module {
  if (traits.len() == 0) {
    return mod;
  }
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    funcs = funcs.append(desugar_fn_trait_params(fd, traits, spelled));
  }
  return Module { ...mod, funcs: funcs };
}

function desugar_fn_trait_params(fd: FuncDecl, traits: string[], spelled: boolean): FuncDecl {
  // A trait's methods are not generic, so an impl's method keeps a
  // trait-typed parameter as written, and it is no type there (E064).
  if (fd.impl_trait.len() > 0) {
    return fd;
  }
  let params: ast.ParamDecl[] = [];
  let type_params: string[] = fd.type_params;
  let bound_traits: string[] = fd.bound_traits;
  let all_type_params: string[] = fd.all_type_params;
  for p in fd.params {
    // The trait itself, with or without type arguments: an array of it or
    // any other shape is not a trait reference.
    let tr: TypeRef = parse_type_ref(p.type_name);
    if (tr.array_depth > 0 || tr.is_tuple || tr.is_fn || tr.is_view || !str_list_contains(traits, tr.base) || str_list_contains(all_type_params, tr.base)) {
      params = params.append(p);
      continue;
    }
    let tp: string = fresh_trait_param("T_" + p.name, all_type_params, spelled);
    type_params = type_params.append(tp);
    bound_traits = bound_traits.append(p.type_name);
    all_type_params = all_type_params.append(tp);
    params = params.append(ast.ParamDecl { ...p, type_name: tp });
  }
  return FuncDecl { ...fd, params: params, type_params: type_params, bound_traits: bound_traits, all_type_params: all_type_params };
}

// is_platform_param reports whether parameter `i` of `fd` is its platform:
// std/platform's trait as written, the type parameter bounded by it that
// `plat: platform.Platform` desugars to, or the host platform itself. `qual`
// is what the module imports std/platform as, "" when the names are already
// mangled (`platform__Host`).
pub function is_platform_param(fd: FuncDecl, i: i32, qual: string): boolean {
  let t: string = fd.params[i].type_name;
  for name in ["Host", "Platform"] {
    if (t == "platform__" + name || t == "platform." + name || qual.len() > 0 && t == qual + "." + name) {
      return true;
    }
  }
  let k: i32 = util.index_of_str(fd.type_params, t);
  if (k < 0 || k >= fd.bound_traits.len()) {
    return false;
  }
  for b in split_plus_bounds(fd.bound_traits[k]) {
    if (trait_simple_name(b) == "Platform") {
      return true;
    }
  }
  return false;
}

// trait_simple_name is a trait bound's name less its module qualifier, in
// either spelling (`platform.Platform`, `platform__Platform`), and its type
// arguments.
pub function trait_simple_name(b: string): string {
  let base: string = util.base_type_name(b);
  let i: i32 = base.len();
  while (i > 0) {
    if (base[i - 1] == b'.') {
      return slice_unchecked(base, i, base.len()) + "";
    }
    if (i >= 2 && base[i - 1] == b'_' && base[i - 2] == b'_') {
      return slice_unchecked(base, i, base.len()) + "";
    }
    i = i - 1;
  }
  return base;
}

// trait_decl_names is the name of every trait in `traits`.
pub function trait_decl_names(traits: TraitDecl[]): string[] {
  let out: string[] = [];
  for t in traits {
    out = out.append(t.name);
  }
  return out;
}

// fresh_trait_param is `want`, or `want` with a number appended, whichever no
// type parameter in `taken` already uses under either spelling.
function fresh_trait_param(want: string, taken: string[], spelled: boolean): string {
  let name: string = want;
  let n: i32 = 1;
  while (str_list_contains(taken, name) || str_list_contains(taken, "0_" + name)) {
    name = want + util.i32_to_string(n);
    n = n + 1;
  }
  if (spelled) {
    return "0_" + name;
  }
  return name;
}

function rename_type_vars_module(mod: Module): Module {
  return respell_type_vars_module(mod, false);
}

// written_type_vars_module is the inverse: every type variable back to the
// name it was written as, for a printer handed a compile-path parse.
pub function written_type_vars_module(mod: Module): Module {
  return respell_type_vars_module(mod, true);
}

function respell_type_vars_module(mod: Module, written: boolean): Module {
  let mvals: string[] = module_value_names(mod);
  let funcs: FuncDecl[] = [];
  for fd in mod.funcs {
    let fvars: string[] = fn_type_vars(fd, mod, written);
    funcs = funcs.append(rename_fn_type_vars(fd, fvars, tvar_respellings(fvars, written), mvals));
  }
  let structs: StructDecl[] = [];
  for sd in mod.structs {
    let svars: string[] = sd.type_params;
    if (sd.enum_owner.len() > 0) {
      svars = decl_type_params(sd.enum_owner, mod);
    }
    structs = structs.append(rename_struct_type_vars(sd, svars, tvar_respellings(svars, written)));
  }
  let enums: EnumDecl[] = [];
  for ed in mod.enums {
    enums = enums.append(EnumDecl { ...ed, type_params: tvar_respellings(ed.type_params, written) });
  }
  let impls: ImplInfo[] = [];
  for im in mod.impls {
    let none: string[] = [];
    let ivars: string[] = add_tvars(add_tvars(none, im.all_type_params), im.type_params);
    impls = impls.append(rename_impl_type_vars(im, ivars, tvar_respellings(ivars, written)));
  }
  return Module { ...mod, funcs: funcs, structs: structs, enums: enums, impls: impls };
}

// module_value_names is every module-level name the checker resolves as a
// value or a qualifier: a const, a function used as a value, a variant, and an
// enum, struct or alias qualifying a variant or an associated call. A type
// variable of the same name does not reach those positions (#10427).
function module_value_names(mod: Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    if (fd.receiver_type.len() == 0) {
      out = out.append(fd.name);
    }
  }
  for sd in mod.structs {
    out = out.append(sd.name);
  }
  for ed in mod.enums {
    out = out.append(ed.name);
  }
  for al in mod.aliases {
    out = out.append(al.name);
  }
  return out;
}

// tvar_respellings maps each variable to its reserved spelling, or with
// `written` back to the name it was written as.
function tvar_respellings(vars: string[], written: boolean): string[] {
  let out: string[] = [];
  for v in vars {
    if (!written) {
      out = out.append(tvar_spelling(v));
    } else if (looks_type_var(v)) {
      out = out.append(slice_unchecked(v, 2, v.len()) + "");
    } else {
      out = out.append(v);
    }
  }
  return out;
}

function add_tvars(acc: string[], vars: string[]): string[] {
  let out: string[] = acc;
  for v in vars {
    if (!str_in(out, v)) {
      out = out.append(v);
    }
  }
  return out;
}

// decl_type_params is the declared parameter list of the struct or enum `name`.
function decl_type_params(name: string, mod: Module): string[] {
  for ed in mod.enums {
    if (ed.name == name) {
      return ed.type_params;
    }
  }
  for sd in mod.structs {
    if (sd.name == name) {
      return sd.type_params;
    }
  }
  let none: string[] = [];
  return none;
}

// fn_type_vars is every type variable `fd` is written in: its declared
// parameters, the implicit ones a generic receiver binds, and — for a derived
// method, whose receiver is spelled bare — its type's own parameters. Once
// respelled, a receiver's variables are read straight off its spelling.
function fn_type_vars(fd: FuncDecl, mod: Module, respelled: boolean): string[] {
  let none: string[] = [];
  let vars: string[] = add_tvars(add_tvars(none, fd.all_type_params), fd.type_params);
  if (fd.receiver_type.len() == 0) {
    return vars;
  }
  if (first_bracket(fd.receiver_type) < 0) {
    vars = add_tvars(vars, decl_type_params(fd.receiver_type, mod));
  }
  if (respelled) {
    return type_str_vars(fd.receiver_type, vars);
  }
  return add_tvars(vars, receiver_type_vars(parse_type_ref(fd.receiver_type), mod));
}

// receiver_type_vars collects a receiver's implicit type variables: the
// single-uppercase leaves that name no type of the declaring module, which is
// the visibility question native's collectFreeTypeVars asks. Another module's
// type is only ever written qualified.
function receiver_type_vars(r: TypeRef, mod: Module): string[] {
  let out: string[] = [];
  if (r.args.len() == 0 && !r.is_tuple && !r.is_fn) {
    let leaf: string = r.base;
    let letter: boolean = leaf.len() == 1 && leaf[0] >= b'A' && leaf[0] <= b'Z';
    if (letter && !names_module_type(leaf, mod)) {
      out = out.append(leaf);
    }
    return out;
  }
  for a in r.args {
    out = add_tvars(out, receiver_type_vars(a, mod));
  }
  return out;
}

function names_module_type(name: string, mod: Module): boolean {
  for sd in mod.structs {
    if (sd.name == name) {
      return true;
    }
  }
  for ed in mod.enums {
    if (ed.name == name) {
      return true;
    }
  }
  for al in mod.aliases {
    if (al.name == name) {
      return true;
    }
  }
  return false;
}

function rename_ty_list(list: string[], vars: string[], cts: string[]): string[] {
  let out: string[] = [];
  for t in list {
    out = out.append(subst_ty(t, vars, cts));
  }
  return out;
}

// rename_bounds respells each `+`-joined entry of a bound list.
function rename_bounds(bounds: string[], vars: string[], cts: string[]): string[] {
  let out: string[] = [];
  for b in bounds {
    let joined: string = "";
    for entry in split_plus_bounds(b) {
      if (joined.len() > 0) {
        joined = joined + "+";
      }
      joined = joined + subst_ty(entry, vars, cts);
    }
    out = out.append(joined);
  }
  return out;
}

function rename_param_type_vars(pd: ast.ParamDecl, vars: string[], cts: string[]): ast.ParamDecl {
  let dv: ast.Expr = pd.default_value;
  if (pd.has_default) {
    dv = astwalk.map_expr(dv, (e: ast.Expr): ast.Expr => rename_tv_expr(e, vars, cts));
  }
  return ast.ParamDecl { ...pd, type_name: subst_ty(pd.type_name, vars, cts), fn_ret: subst_ty(pd.fn_ret, vars, cts), fn_param_types: subst_ty_list(pd.fn_param_types, vars, cts), default_value: dv };
}

function rename_fn_type_vars(fd: FuncDecl, vars: string[], cts: string[], mvals: string[]): FuncDecl {
  if (vars.len() == 0) {
    return fd;
  }
  let values: string[] = [];
  for v in vars {
    if (str_in(mvals, v)) {
      values = values.append(v);
    }
  }
  if (fd.receiver_name.len() > 0) {
    values = values.append(fd.receiver_name);
  }
  for pd in fd.params {
    values = astwalk.append_bound_name(values, pd.name);
  }
  let sc: TvScope = TvScope { vars: vars, cts: cts, values: values };
  let params: ast.ParamDecl[] = [];
  for pd in fd.params {
    let rp: ast.ParamDecl = rename_param_type_vars(pd, vars, cts);
    if (rp.has_default) {
      rp = ast.ParamDecl { ...rp, default_value: tv_obj_in(rp.default_value, sc) };
    }
    params = params.append(rp);
  }
  return FuncDecl {
    ...fd, receiver_type: subst_ty(fd.receiver_type, vars, cts), type_params: rename_ty_list(fd.type_params, vars, cts),
    all_type_params: rename_ty_list(fd.all_type_params, vars, cts), bound_traits: rename_bounds(fd.bound_traits, vars, cts), params: params,
    ret_type: subst_ty(fd.ret_type, vars, cts), ret_fn_ret: subst_ty(fd.ret_fn_ret, vars, cts), ret_fn_param_types: subst_ty_list(fd.ret_fn_param_types, vars, cts),
    body: tv_obj_body(rename_tv_stmts(fd.body, vars, cts), sc),
  };
}

function rename_struct_type_vars(sd: StructDecl, vars: string[], cts: string[]): StructDecl {
  if (vars.len() == 0) {
    return sd;
  }
  let fields: StructFieldDecl[] = [];
  for f in sd.fields {
    fields = fields.append(StructFieldDecl { ...f, type_name: subst_ty(f.type_name, vars, cts), fn_ret: subst_ty(f.fn_ret, vars, cts), fn_param_types: subst_ty_list(f.fn_param_types, vars, cts) });
  }
  return StructDecl { ...sd, fields: fields, type_params: rename_ty_list(sd.type_params, vars, cts) };
}

function rename_impl_type_vars(im: ImplInfo, vars: string[], cts: string[]): ImplInfo {
  if (vars.len() == 0) {
    return im;
  }
  return ImplInfo {
    ...im, impl_type: subst_ty(im.impl_type, vars, cts), type_params: rename_ty_list(im.type_params, vars, cts),
    all_type_params: rename_ty_list(im.all_type_params, vars, cts), bounds: rename_bounds(im.bounds, vars, cts),
    trait_ref: subst_ty(im.trait_ref, vars, cts), assoc_values: rename_ty_list(im.assoc_values, vars, cts),
  };
}

// rename_tv_stmts respells a body: every expression through astwalk.map_expr,
// then the statement-level annotations the expression walk does not reach.
function rename_tv_stmts(stmts: ast.Stmt[], vars: string[], cts: string[]): ast.Stmt[] {
  return rename_tv_annots(astwalk.map_stmts(stmts, (e: ast.Expr): ast.Expr => rename_tv_expr(e, vars, cts)), vars, cts);
}

// rename_tv_expr respells the type spellings one expression node carries;
// map_expr supplies the recursion.
function rename_tv_expr(e: ast.Expr, vars: string[], cts: string[]): ast.Expr {
  match (e) {
    ast.ExprIdent(id) => {
      return ast.ExprIdent { ...id, ty: subst_ty(id.ty, vars, cts) };
    },
    ast.ExprCall(c) => {
      return ast.ExprCall { ...c, type_args: rename_ty_list(c.type_args, vars, cts), ty: subst_ty(c.ty, vars, cts) };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { ...b, ty: subst_ty(b.ty, vars, cts) };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { ...u, ty: subst_ty(u.ty, vars, cts) };
    },
    ast.ExprIndex(ix) => {
      return ast.ExprIndex { ...ix, ty: subst_ty(ix.ty, vars, cts) };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, ty: subst_ty(sl.ty, vars, cts) };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { ...fa, ty: subst_ty(fa.ty, vars, cts) };
    },
    ast.ExprArray(ar) => {
      return ast.ExprArray { ...ar, elem_ty: subst_ty(ar.elem_ty, vars, cts) };
    },
    ast.ExprZero(z) => {
      return ast.ExprZero { ...z, type_name: subst_ty(z.type_name, vars, cts) };
    },
    ast.ExprStructLit(sl) => {
      return ast.ExprStructLit { ...sl, type_name: subst_ty(sl.type_name, vars, cts), written: subst_ty(sl.written, vars, cts) };
    },
    ast.ExprLambda(lm) => {
      let lps: ast.ParamDecl[] = [];
      for lpd in lm.params {
        lps = lps.append(rename_param_type_vars(lpd, vars, cts));
      }
      return ast.ExprLambda {
        ...lm, params: lps, ret_type: subst_ty(lm.ret_type, vars, cts), ret_fn_ret: subst_ty(lm.ret_fn_ret, vars, cts),
        ret_fn_param_types: subst_ty_list(lm.ret_fn_param_types, vars, cts), body: rename_tv_annots(lm.body, vars, cts),
      };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// A type variable also reaches two expression positions: the object of
// `T.default()`, and the bracket of `f[T](x)`, which parses as an index until
// retag_type_arg_indexes settles it as a type argument. A value binding of the
// same name shadows it in both, and so does a module-level name the checker
// resolves in either position (module_value_names), so that respelling walks
// the body with the value names in scope. TvScope is the
// walk's accumulator: the declaration's variables, their respellings, and the
// value names bound so far.
struct TvScope { vars: string[], cts: string[], values: string[] }

function tv_shadow(sc: TvScope, names: string[]): TvScope {
  let values: string[] = sc.values;
  for n in names {
    values = values.append(n);
  }
  return TvScope { ...sc, values: values };
}

// A `let` binds from the next statement on; its own initializer still sees
// the variable it shadows.
function tv_obj_body(stmts: ast.Stmt[], sc: TvScope): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let cur: TvScope = sc;
  for st in stmts {
    let (ns, na, nh) = astwalk.map_stmt_acc(st, cur, tv_obj_stmt, tv_obj_expr);
    out = out.append(ns);
    if let ast.StmtVar(v) = st {
      cur = tv_shadow(cur, astwalk.append_bound_name([], v.name));
    }
  }
  return out;
}

function tv_obj_in(e: ast.Expr, sc: TvScope): ast.Expr {
  let (out, a, h) = astwalk.map_expr_acc(e, sc, tv_obj_stmt, tv_obj_expr);
  return out;
}

// tv_obj_ident is the respelled identifier when `e` names a type variable no
// value shadows, else `e`.
function tv_obj_ident(e: ast.Expr, sc: TvScope): ast.Expr {
  if let ast.ExprIdent(id) = e {
    let k: i32 = tp_index(id.name, sc.vars);
    if (k >= 0 && !str_in(sc.values, id.name)) {
      return ast.ExprIdent { ...id, name: sc.cts[k] };
    }
  }
  return e;
}

// tv_obj_expr owns the two variable positions and the lambda scope boundary;
// the shared spine owns every other container.
function tv_obj_expr(e: ast.Expr, sc: TvScope): (ast.Expr, TvScope, boolean) {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(_) = fa.obj {
        return (ast.ExprFieldAccess { ...fa, obj: tv_obj_ident(fa.obj, sc) }, sc, true);
      }
      return (e, sc, false);
    },
    ast.ExprIndex(ix) => {
      if let ast.ExprIdent(_) = ix.index {
        return (ast.ExprIndex { ...ix, array: tv_obj_in(ix.array, sc), index: tv_obj_ident(ix.index, sc) }, sc, true);
      }
      return (e, sc, false);
    },
    ast.ExprLambda(lm) => {
      let names: string[] = [];
      for lp in lm.params {
        names = astwalk.append_bound_name(names, lp.name);
      }
      return (ast.ExprLambda { ...lm, body: tv_obj_body(lm.body, tv_shadow(sc, names)) }, sc, true);
    },
    _ => {
      return (e, sc, false);
    }
  }
  return (e, sc, false);
}

// tv_obj_stmt owns the statements that open a scope, so a binder inside one
// does not leak past it.
function tv_obj_stmt(st: ast.Stmt, sc: TvScope): (ast.Stmt, TvScope, boolean) {
  match (st) {
    ast.StmtIf(f) => {
      return (ast.StmtIf { ...f, cond: tv_obj_in(f.cond, sc), then_body: tv_obj_body(f.then_body, sc), else_body: tv_obj_body(f.else_body, sc) }, sc, true);
    },
    ast.StmtWhile(w) => {
      return (ast.StmtWhile { ...w, cond: tv_obj_in(w.cond, sc), body: tv_obj_body(w.body, sc) }, sc, true);
    },
    ast.StmtFor(fo) => {
      return (ast.StmtFor { ...fo, iter: tv_obj_in(fo.iter, sc), body: tv_obj_body(fo.body, tv_shadow(sc, astwalk.append_bound_name([], fo.var_name))) }, sc, true);
    },
    ast.StmtMatch(mt) => {
      let arms: ast.MatchArm[] = [];
      for arm in mt.arms {
        let asc: TvScope = tv_shadow(sc, astwalk.pattern_binders(arm.pattern, []));
        let g: ast.Expr = arm.guard;
        if (arm.has_guard) {
          g = tv_obj_in(arm.guard, asc);
        }
        arms = arms.append(ast.MatchArm { ...arm, guard: g, body: tv_obj_body(arm.body, asc) });
      }
      return (ast.StmtMatch { ...mt, scrutinee: tv_obj_in(mt.scrutinee, sc), arms: arms }, sc, true);
    },
    _ => {
      return (st, sc, false);
    }
  }
  return (st, sc, false);
}

// rename_tv_annots respells the `let x: T` annotations of a block and of the
// blocks it encloses. A destructure's marker channel is not a type.
function rename_tv_annots(stmts: ast.Stmt[], vars: string[], cts: string[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in stmts {
    out = out.append(rename_tv_annot(st, vars, cts));
  }
  return out;
}

function rename_tv_annot(st: ast.Stmt, vars: string[], cts: string[]): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      if (is_destr_marker(v.type_name)) {
        return st;
      }
      return ast.StmtVar { ...v, type_name: subst_ty(v.type_name, vars, cts), fn_ret: subst_ty(v.fn_ret, vars, cts), fn_param_types: subst_ty_list(v.fn_param_types, vars, cts) };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, then_body: rename_tv_annots(f.then_body, vars, cts), else_body: rename_tv_annots(f.else_body, vars, cts) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { ...w, body: rename_tv_annots(w.body, vars, cts) };
    },
    ast.StmtFor(fo) => {
      return ast.StmtFor { ...fo, body: rename_tv_annots(fo.body, vars, cts) };
    },
    ast.StmtMatch(mt) => {
      let arms: ast.MatchArm[] = [];
      for arm in mt.arms {
        arms = arms.append(ast.MatchArm { ...arm, body: rename_tv_annots(arm.body, vars, cts) });
      }
      return ast.StmtMatch { ...mt, arms: arms };
    },
    ast.StmtDefer(d) => {
      return ast.StmtDefer { ...d, action: rename_tv_annot(d.action, vars, cts) };
    },
    _ => {
      return st;
    }
  }
  return st;
}

// parse_impl_block yields the parser plus the desugared receiver-method
// FuncDecls produced from an `impl Trait for Type { … }` block, along
// with the metadata parse_module needs to synthesise inherited trait
// default methods after every trait declaration has been seen:
// trait_name (simple, qualifier stripped), impl_type, the impl's bounded
// type params, and the method names the impl explicitly provided.

// TraitDefault is one trait method that carries a `{ … }` default body
// (abstract signatures are dropped). `trait_name` is the simple trait
// name; `method` is the parsed method (params[0] = self for a receiver
// method, `Self` still spelled in its types). An impl of the trait that
// omits the method inherits a copy via finalize_impl_method.
pub struct TraitDefault { trait_name: string, method: FuncDecl }

// ImplInfo is the per-impl metadata parse_module retains so it can
// synthesise inherited defaults after the full module is parsed (a trait
// may be declared after the impl that depends on it).
// trait_spelling is the trait name AS WRITTEN, qualifier included
// (`async.Driver`). `trait_name` is the resolved simple name, which is what
// parse_module matches against the trait's default methods and what the
// emitter needs — so the spelling is kept beside it rather than replacing it.
// Empty for an inherent impl, which has no trait.
// bounds runs PARALLEL to type_params: both halves reach the synthesised
// default through finalize_impl_method, so the bound cannot be left behind
// as a local of the parse (#7224).
// all_type_params is every parameter the impl declares; type_params is only
// the BOUNDED ones. The two differ for `impl[T] Trait for Box[T]`, whose T
// drives no monomorphisation but is what an associated-type binding
// (`type Ok = T;`) is written in — see assoc_binding_for.
// trait_ref is the trait reference with its type ARGUMENTS intact
// (`Iterator[i32]`), which is what says what a generic trait was implemented
// AT. `trait_name` has them stripped, so the two cannot be folded together.
// trait_module is the bundle prefix of the module that declares the trait, as
// TraitReq.module is (flatten sets it; "" for the entry's own traits).
pub struct ImplInfo { trait_name: string, impl_type: string, type_params: string[], all_type_params: string[], bounds: string[], method_names: string[], trait_spelling: string, trait_ref: string, assoc_names: string[], assoc_values: string[], trait_module: string }

// impl_trait_key spells the trait an impl implements the way flatten spells a
// derive or a dyn trait: `module.Name`, or bare for one the entry declares.
pub function impl_trait_key(im: ImplInfo): string {
  if (im.trait_module.len() == 0) {
    return im.trait_name;
  }
  return im.trait_module + "." + im.trait_name;
}

// MethodClaim is claim_method_name's answer: the (possibly renamed) function,
// and the claim table extended with the key it took.
struct MethodClaim { fn: FuncDecl, keys: string[], traits: string[] }

// claim_method_name registers the flat `<Type>.<name>` symbol key `fd` will be
// emitted under, and renames `fd` when a DIFFERENT trait already claimed that
// key. Every backend labels a method `<base receiver type>.<name>`, so two
// traits each providing `scale` for `P` would otherwise emit `P.scale` twice.
// The FIRST claimant keeps the plain name — that is the name every call site
// resolves to — and a later distinct-trait provider is interposed with its
// trait (`P.B.scale`), mirroring native's mangleMethodName. A second provider
// from the SAME trait, and an inherent redeclaration, keep the colliding name
// so the checker still reports E006. `keys` / `traits` run parallel: the key,
// and the trait that claimed it ("" for an inherent method). Every receiver
// method leaves with `impl_trait` set to `tname`, renamed or not, so a later
// rename (flatten's `<ns>.<m>` interposition) cannot lose which trait it is for.
function claim_method_name(fd0: FuncDecl, tname: string, keys: string[], traits: string[]): MethodClaim {
  if (fd0.receiver_type.len() == 0) {
    return MethodClaim { fn: fd0, keys: keys, traits: traits };
  }
  let fd: FuncDecl = FuncDecl { ...fd0, impl_trait: tname };
  let base: string = util.base_type_name(fd.receiver_type);
  let key: string = base + "." + fd.name;
  let at: i32 = util.index_of_str(keys, key);
  if (at < 0) {
    return MethodClaim { fn: fd, keys: keys.append(key), traits: traits.append(tname) };
  }
  if (tname.len() == 0 || traits[at] == tname) {
    return MethodClaim { fn: fd, keys: keys, traits: traits };
  }
  let renamed: string = tname + "." + fd.name;
  let rkey: string = base + "." + renamed;
  if (util.index_of_str(keys, rkey) >= 0) {
    return MethodClaim { fn: fd, keys: keys, traits: traits };
  }
  let renamed_fd: FuncDecl = FuncDecl { ...fd, name: renamed };
  return MethodClaim { fn: renamed_fd, keys: keys.append(rkey), traits: traits.append(tname) };
}

// ---- which method a `dyn` call reaches ----
//
// resolve_dyn_traits records on each method the traits whose `dyn` dispatch
// calls it, and dyn_arm_matches reads that back. Every dispatcher needs the
// same answer — the compiled backends through the arms semsource.dyn_arms
// picks, the AST interpreter through dyn_provider_name — so the rule lives
// here once rather than once per engine.

// resolve_dyn_traits recomputes every method's dyn_traits. A method answers the
// trait it was written for. An impl of trait T for a type also routes T's
// dispatch, for each method T or a supertrait of T declares, to the type's
// method written for the declaring trait, or else to its inherent method of
// that name: that is how `impl Display for i32 {}` adopts `i32.to_string`, and
// how `dyn Num` reaches the `add` of `impl Add for i32`. It runs on each parsed
// module and again on the bundle, where an impl can adopt a method another
// module declares.
pub function resolve_dyn_traits(mod: Module): Module {
  let bases: string[] = [];
  let served: string[][] = [];
  for fd in mod.funcs {
    let own: string[] = [];
    let base: string = "";
    if (fd.receiver_name.len() > 0 && !ends_with_array_brackets(fd.receiver_type)) {
      base = receiver_base(fd.receiver_type);
      if (fd.impl_trait.len() > 0) {
        own = own.append(fd.impl_trait);
      }
    }
    bases = bases.append(base);
    served = served.append(own);
  }
  let ix: util.NameIndex = util.name_index(bases);
  for im in mod.impls {
    if (im.trait_name.len() > 0 && !ends_with_array_brackets(im.impl_type)) {
      let bn: string = receiver_base(im.impl_type);
      for ri in trait_closure(mod.trait_reqs, im.trait_name, im.trait_module) {
        let req: TraitReq = mod.trait_reqs[ri];
        for m in req.provided {
          let at: i32 = answering_method(mod.funcs, ix, bn, m, req.trait_name);
          if (at >= 0 && !str_list_contains(served[at], im.trait_name)) {
            served = served.with(at, served[at].append(im.trait_name));
          }
        }
      }
    }
  }
  let out: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    if (fd.dyn_traits.len() > 0 || served[i].len() > 0) {
      fd = FuncDecl { ...fd, dyn_traits: served[i], streams: [] };
    }
    out = out.append(fd);
    i = i + 1;
  }
  return Module { ...mod, funcs: out };
}

function ends_with_array_brackets(t: string): boolean {
  let n: i32 = t.len();
  return n >= 2 && slice_unchecked(t, n - 2, n) == "[]";
}

// answering_method is the index of the method receiver base `bn` answers `m`
// with for trait `tn`: the one written for `tn`, else the inherent one, else -1.
// A method's name may carry the `<Trait>.` or `<ns>.` prefix a claim gave it.
function answering_method(funcs: FuncDecl[], ix: util.NameIndex, bn: string, m: string, tn: string): i32 {
  let inherent: i32 = 0 - 1;
  let i: i32 = ix.chain(bn);
  while (i >= 0) {
    if (ix.names[i] == bn && derive_simple_name(funcs[i].name) == m) {
      if (funcs[i].impl_trait == tn) {
        return i;
      }
      if (funcs[i].impl_trait.len() == 0 && inherent < 0) {
        inherent = i;
      }
    }
    i = ix.next[i];
  }
  return inherent;
}

// trait_closure is the index in `reqs` of trait `tn` and of every trait it
// extends, transitively. A trait with no record contributes nothing.
function trait_closure(reqs: TraitReq[], tn: string, module: string): i32[] {
  let out: i32[] = [];
  let first: i32 = trait_req_index(reqs, tn, module);
  if (first >= 0) {
    out = out.append(first);
  }
  let k: i32 = 0;
  while (k < out.len()) {
    let r: TraitReq = reqs[out[k]];
    for sup in r.supertraits {
      let at: i32 = trait_req_index(reqs, util.base_type_name(sup), r.module);
      if (at >= 0 && util.index_of_i32(out, at) < 0) {
        out = out.append(at);
      }
    }
    k = k + 1;
  }
  return out;
}

// trait_req_index finds trait `tn`'s record, preferring the one `module`
// declares when two modules declare a trait of that simple name.
function trait_req_index(reqs: TraitReq[], tn: string, module: string): i32 {
  let any: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < reqs.len()) {
    if (reqs[i].trait_name == tn) {
      if (reqs[i].module == module) {
        return i;
      }
      if (any < 0) {
        any = i;
      }
    }
    i = i + 1;
  }
  return any;
}

// dyn_trait_set splits a `dyn Trait` type spelling into its trait names:
// "dyn B" -> ["B"], "dyn A + B" -> ["A", "B"]. Non-dyn spellings yield none.
pub function dyn_trait_set(ty: string): string[] {
  let out: string[] = [];
  if (ty.len() <= 4 || slice_unchecked(ty, 0, 4) != "dyn ") {
    return out;
  }
  let start: i32 = 4;
  let depth: i32 = 0;
  let i: i32 = 4;
  while (i <= ty.len()) {
    // A `+` inside brackets joins an associated-type pin or generic
    // argument (`dyn Holder[Item = i32]`), not the trait set.
    if (i < ty.len() && ty[i] == b'[') {
      depth = depth + 1;
    }
    if (i < ty.len() && ty[i] == b']') {
      depth = depth - 1;
    }
    if (i == ty.len() || depth == 0 && ty[i] == b'+') {
      let part: string = util.trim(slice_unchecked(ty, start, i) + "");
      if (part.len() > 0) {
        out = out.append(part);
      }
      start = i + 1;
    }
    i = i + 1;
  }
  return out;
}

// dyn_arm_matches reports whether `fd` is the definition a `dyn` dispatch on
// `method`, over a trait object spanning `traits`, calls for fd's own receiver
// type: a method of that name which answers one of the traits (dyn_traits). Its
// flat name may carry the `<Trait>.` or `<ns>.` prefix a claim gave it, so a
// same-named method another trait or no trait owns is never an arm. With no
// trait set (the lowerer could not resolve one) every receiver method of that
// name matches.
//
// An ASSOCIATED function is never an arm — it has no receiver to dispatch on.
// finalize_impl_method still gives it the impl type as its receiver_type and
// only leaves receiver_name empty, so the receiver NAME is what excludes it
// (#7398).
pub function dyn_arm_matches(fd: FuncDecl, traits: string[], method: string): boolean {
  if (fd.receiver_name.len() == 0) {
    return false;
  }
  if (traits.len() == 0) {
    return fd.name == method;
  }
  if (derive_simple_name(fd.name) != method) {
    return false;
  }
  for t in traits {
    if (str_list_contains(fd.dyn_traits, derive_simple_name(util.base_type_name(t)))) {
      return true;
    }
  }
  return false;
}

// dyn_provider_name names the flat symbol a `recv_type` receiver answers `method`
// with when it is reached through a trait object spanning `traits`, and `method`
// itself when no definition matches.
pub function dyn_provider_name(funcs: FuncDecl[], recv_type: string, traits: string[], method: string): string {
  if (recv_type.len() == 0) {
    return method;
  }
  let i: i32 = 0;
  while (i < funcs.len()) {
    let fd: FuncDecl = funcs[i];
    if (util.base_type_name(fd.receiver_type) == recv_type
      && dyn_arm_matches(fd, traits, method)) {
      return fd.name;
    }
    i = i + 1;
  }
  return method;
}

// str_list_contains reports whether `xs` holds `want`.
function str_list_contains(xs: string[], want: string): boolean {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == want) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// ============ @derive synthesis (structs) ============
// Mirrors the Go checker's synthEq / synthDisplay / synthOrd so a
// self-host-compiled program gets the same field-wise methods. Structs
// only for now — enums desugar to struct-unions here, so enum @derive
// is a follow-up. See docs/TRAITS.md.

// derive_simple_name returns a (possibly qualified) trait name's simple
// name (after the last `.`): `cmp.Display` → "Display".
pub function derive_simple_name(name: string): string {
  let last_dot: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < name.len()) {
    if (name[i] == b'.') {
      last_dot = i;
    }
    i = i + 1;
  }
  if (last_dot >= 0) {
    return slice_unchecked(name, last_dot + 1, name.len()) + "";
  }
  return name;
}

// self_field / other_field build `self.f` / `other.f`.
function dv_self_field(f: string): ast.Expr {
  return e_field_access(e_ident("self"), f);
}

function dv_other_field(f: string): ast.Expr {
  return e_field_access(e_ident("other"), f);
}

// dv_call0 / dv_call1 build `recv.m()` / `recv.m(arg)`.
function dv_call0(recv: ast.Expr, m: string): ast.Expr {
  let noargs: ast.Expr[] = [];
  return e_call(e_field_access(recv, m), noargs);
}

function dv_call1(recv: ast.Expr, m: string, arg: ast.Expr): ast.Expr {
  let args: ast.Expr[] = [arg];
  return e_call(e_field_access(recv, m), args);
}

// synth_struct_display: `to_string` rendering `Name { f: …, … }` — the
// exact format the Go synthDisplay emits (so the differential oracle
// agrees).
function synth_struct_display(sd: StructDecl): FuncDecl {
  let expr: ast.Expr = e_string(sd.name + " {");
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let sep: string = " ";
    if (i > 0) {
      sep = ", ";
    }
    expr = e_binary("+", expr, e_string(sep + sd.fields[i].name + ": "));
    expr = e_binary("+", expr, dv_call0(dv_self_field(sd.fields[i].name), "to_string"));
    i = i + 1;
  }
  if (sd.fields.len() == 0) {
    expr = e_binary("+", expr, e_string("}"));
  } else {
    expr = e_binary("+", expr, e_string(" }"));
  }
  let body: ast.Stmt[] = [s_return(expr)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "to_string", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Display", dyn_traits: [], streams: [] };
}

// dv_debug_render builds the Debug rendering of a single value of static
// type `t`. Unlike the native checker — which routes every field through a
// `Debug` trait method — the self-host has no trait-impl methods on
// primitives (it discards `impl` bodies; `__fn_i32__to_debug` would be
// undefined), so it renders type-directed, matching the native output:
//   * `string`  → quoted: `"\"" + v + "\""` (so a dump is unambiguous).
//   * numeric / boolean scalar → `v.to_string()` (a built-in, as derived
//     Display uses).
//   * anything else (a nominal struct/enum) → `v.to_debug()`, composing
//     through its own derived Debug.
// (Strings with embedded quotes/backslashes aren't escaped here — the
// native `impl Debug for string` does, a small self-host fidelity gap.)
function dv_is_debug_scalar(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64"
    || t == "f32" || t == "f64" || t == "boolean";
}

function dv_debug_render(value: ast.Expr, t: string): ast.Expr {
  if (t == "string") {
    return e_binary("+", e_binary("+", e_string("\""), value), e_string("\""));
  }
  if (dv_is_debug_scalar(t)) {
    return dv_call0(value, "to_string");
  }
  return dv_call0(value, "to_debug");
}

// synth_struct_debug: `to_debug` rendering the structural `Name { f: …, …
// }` form — the Debug sibling of synth_struct_display. The one difference
// from the derived Display is that a string field renders QUOTED
// (`name: "hi"`), via dv_debug_render. Mirrors the Go synthDebug output.
function synth_struct_debug(sd: StructDecl): FuncDecl {
  let expr: ast.Expr = e_string(sd.name + " {");
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let sep: string = " ";
    if (i > 0) {
      sep = ", ";
    }
    expr = e_binary("+", expr, e_string(sep + sd.fields[i].name + ": "));
    expr = e_binary("+", expr, dv_debug_render(dv_self_field(sd.fields[i].name), sd.fields[i].type_name));
    i = i + 1;
  }
  if (sd.fields.len() == 0) {
    expr = e_binary("+", expr, e_string("}"));
  } else {
    expr = e_binary("+", expr, e_string(" }"));
  }
  let body: ast.Stmt[] = [s_return(expr)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "to_debug", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Debug", dyn_traits: [], streams: [] };
}

// synth_struct_eq: field-wise `<f-eq> && …` (true for an empty struct),
// where a scalar field compares with the primitive `==` and a nominal field
// delegates to its own derived `.eq()` — see dv_eq_expr.
function synth_struct_eq(sd: StructDecl): FuncDecl {
  let expr: ast.Expr = e_bool(true);
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let cm: ast.Expr = dv_eq_expr(sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dv_other_field(sd.fields[i].name));
    if (i == 0) {
      expr = cm;
    } else {
      expr = e_binary("&&", expr, cm);
    }
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_return(expr)];
  let notp: string[] = [];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "other", type_name: sd.name, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
  return FuncDecl { stdlib: "", no_inline: false, name: "eq", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: params, ret_type: "boolean", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Eq", dyn_traits: [], streams: [] };
}

// synth_struct_ord: lexicographic `cmp` — first non-zero field cmp wins.
function synth_struct_ord(sd: StructDecl): FuncDecl {
  let stmts: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let vn: string = "__c" + dl_itoa(i);
    let cs: ast.Stmt[] = dv_cmp_stmts(vn, sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dv_other_field(sd.fields[i].name));
    let k: i32 = 0;
    while (k < cs.len()) {
      stmts = stmts.append(cs[k]);
      k = k + 1;
    }
    let cond: ast.Expr = e_binary("!=", e_ident(vn), e_number("0", "", false));
    let thenb: ast.Stmt[] = [s_return(e_ident(vn))];
    let elseb: ast.Stmt[] = [];
    stmts = stmts.append(s_if(cond, thenb, elseb));
    i = i + 1;
  }
  stmts = stmts.append(s_return(e_number("0", "", false)));
  let notp: string[] = [];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "other", type_name: sd.name, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
  return FuncDecl { stdlib: "", no_inline: false, name: "cmp", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: params, ret_type: "i32", body: stmts, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Ord", dyn_traits: [], streams: [] };
}

// synth_struct_hash: field-wise `h = h * 31 + self.f.hash()` fold from a
// seed of 17, mirroring the Go synthHash so the differential oracle
// agrees. Pairs with the derived `eq` under `a == b ⇒ a.hash() ==
// b.hash()`.
function synth_struct_hash(sd: StructDecl): FuncDecl {
  let stmts: ast.Stmt[] = [s_var("__h", "i32", e_number("17", "", false))];
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let fs: ast.Stmt[] = dv_hash_stmts("__h", sd.fields[i].type_name, dv_self_field(sd.fields[i].name), dl_itoa(i));
    let k: i32 = 0;
    while (k < fs.len()) {
      stmts = stmts.append(fs[k]);
      k = k + 1;
    }
    i = i + 1;
  }
  stmts = stmts.append(s_return(e_ident("__h")));
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "hash", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_type: "i32", body: stmts, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Hash", dyn_traits: [], streams: [] };
}

// synth_struct_json: field-wise `to_json` rendering a struct as a JSON
// object `{"f":<f.to_json()>,...}`, mirroring the Go synthJson so the
// differential oracle agrees. Field names need no escaping (identifiers).
function synth_struct_json(sd: StructDecl): FuncDecl {
  let expr: ast.Expr = e_string("{");
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    let sep: string = "";
    if (i > 0) {
      sep = ",";
    }
    expr = e_binary("+", expr, e_string(sep + "\"" + sd.fields[i].name + "\":"));
    expr = e_binary("+", expr, dv_call0(dv_self_field(sd.fields[i].name), "to_json"));
    i = i + 1;
  }
  expr = e_binary("+", expr, e_string("}"));
  let body: ast.Stmt[] = [s_return(expr)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "to_json", receiver_name: "self", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Json", dyn_traits: [], streams: [] };
}

// fromjson_container names the container a FromJson field's type is —
// "array" for `E[]`, "option" for `Option[E]` — and "" for any other type;
// fromjson_elem is the type the field's decoder is called on: the
// container's element, else the field type itself.
pub function fromjson_container(t: string): string {
  if (t.len() > 2 && slice_unchecked(t, t.len() - 2, t.len()) == "[]") {
    return "array";
  }
  if (t.len() > 8 && slice_unchecked(t, 0, 7) == "Option[" && t[t.len() - 1] == b']') {
    return "option";
  }
  return "";
}

pub function fromjson_elem(t: string): string {
  let c: string = fromjson_container(t);
  if (c == "array") {
    return slice_unchecked(t, 0, t.len() - 2) + "";
  }
  if (c == "option") {
    return slice_unchecked(t, 7, t.len() - 1) + "";
  }
  return t;
}

// synth_from_json_value builds a struct's derived `from_json_value(v:
// JsonValue): Result[Self, string]`: one nested match per field, reading
// the field with std/json's `from_json_field` (`from_json_optional_field`
// for an `Option`, `None` when the field is missing or null) and decoding
// it through the field type's own `from_json_value`, an array through
// `from_json_array[E]` and an Option through `from_json_option[E]`. A
// field's shape error comes back prefixed with the field's name
// (`from_json_at`); the innermost arm returns `Ok(Self { … })`. The
// `json.*` calls resolve through the `@derive(json.FromJson)` site's own
// `import "std/json"` — modload rewrites them to the flat `json__*`.
// Mirrors the native synthFromJsonValue.
function synth_from_json_value(sd: StructDecl): FuncDecl {
  let fnames: string[] = [];
  let fvals: ast.Expr[] = [];
  let k: i32 = 0;
  while (k < sd.fields.len()) {
    fnames = fnames.append(sd.fields[k].name);
    fvals = fvals.append(e_ident("__fj_" + sd.fields[k].name));
    k = k + 1;
  }
  let lit: ast.Expr = e_struct_lit(sd.name, fnames, fvals, 0, 0);
  let body: ast.Stmt[] = [s_return(e_call(e_ident("Ok"), [lit]))];
  let fi: i32 = sd.fields.len() - 1;
  while (fi >= 0) {
    let fname: string = sd.fields[fi].name;
    let fty: string = sd.fields[fi].type_name;
    let value: string = "__fj_v_" + fname;
    let ebind: string = "__fj_e_" + fname;
    let cont: string = fromjson_container(fty);
    let elem: string = fromjson_elem(fty);
    let getter: string = "from_json_field";
    if (cont == "option") {
      getter = "from_json_optional_field";
    }
    let decode: ast.Expr = e_call(e_field_access(e_ident(elem), "from_json_value"), [e_ident(value)]);
    if (cont == "array") {
      decode = ast.ExprCall { callee: e_field_access(e_ident("json"), "from_json_array"), args: [e_ident(value)], line: 0, col: 0, type_args: [elem], ty: "" };
    }
    if (cont == "option") {
      decode = ast.ExprCall { callee: e_field_access(e_ident("json"), "from_json_option"), args: [e_ident(value)], line: 0, col: 0, type_args: [elem], ty: "" };
    }
    let at_err: ast.Expr = e_call(e_ident("Err"), [e_call(e_field_access(e_ident("json"), "from_json_at"), [e_string(fname), e_ident(ebind)])]);
    let inner_arms: ast.MatchArm[] = [];
    inner_arms = inner_arms.append(ast.MatchArm { pattern: p_variant("Ok", "__fj_" + fname), body: body, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    inner_arms = inner_arms.append(ast.MatchArm { pattern: p_variant("Err", ebind), body: [s_return(at_err)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    let inner: ast.Stmt = s_match(decode, inner_arms);
    let outer_arms: ast.MatchArm[] = [];
    outer_arms = outer_arms.append(ast.MatchArm { pattern: p_variant("Ok", value), body: [inner], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    outer_arms = outer_arms.append(ast.MatchArm { pattern: p_variant("Err", ebind), body: [s_return(e_call(e_ident("Err"), [e_ident(ebind)]))], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    body = [s_match(e_call(e_field_access(e_ident("json"), getter), [e_ident("v"), e_string(fname)]), outer_arms)];
    fi = fi - 1;
  }
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "v", type_name: "JsonValue", own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
  let notp: string[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "from_json_value", receiver_name: "", receiver_type: sd.name, receiver_own: false, type_params: notp, params: params, ret_type: "Result[" + sd.name + ", string]", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "FromJson", dyn_traits: [], streams: [] };
}

// synth_from_json_text builds the derived `from_json(s: string):
// Result[Self, string]`: `json.decode[Self](s)` under the type's own name.
function synth_from_json_text(sd: StructDecl): FuncDecl {
  let self_ty: string = sd.name;
  if (sd.type_params.len() > 0) {
    let tps: string = "";
    let ti: i32 = 0;
    while (ti < sd.type_params.len()) {
      if (ti > 0) {
        tps = tps + ", ";
      }
      tps = tps + sd.type_params[ti];
      ti = ti + 1;
    }
    self_ty = sd.name + "[" + tps + "]";
  }
  let call: ast.Expr = ast.ExprCall { callee: e_field_access(e_ident("json"), "decode"), args: [e_ident("s")], line: 0, col: 0, type_args: [self_ty], ty: "" };
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "s", type_name: "string", own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
  let notp: string[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "from_json", receiver_name: "", receiver_type: sd.name, receiver_own: false, type_params: notp, params: params, ret_type: "Result[" + sd.name + ", string]", body: [s_return(call)], line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "FromJson", dyn_traits: [], streams: [] };
}

// synth_enum_display: variant-wise `to_string` rendering `Variant(p, …)`,
// `Variant { f: p, … }` or `Variant` — the shapes the Go synthEnumDisplay emits.
function synth_enum_display(ename: string, variants: StructDecl[]): FuncDecl {
  let arms: ast.MatchArm[] = [];
  let i: i32 = 0;
  while (i < variants.len()) {
    let v: StructDecl = variants[i];
    if (v.fields.len() > 0) {
      // A record-form variant renders `Rect { w: 3, h: 4 }`, a positional
      // one `Rect(3, 4)`: every payload, as the Go synthEnumDisplay does.
      let named: boolean = v.variant_field_names.len() == v.fields.len();
      let e: ast.Expr = e_string(v.name + "(");
      if (named) {
        e = e_string(v.name + " { ");
      }
      let dj: i32 = 0;
      while (dj < v.fields.len()) {
        if (dj > 0) {
          e = e_binary("+", e, e_string(", "));
        }
        if (named) {
          e = e_binary("+", e, e_string(v.variant_field_names[dj] + ": "));
        }
        e = e_binary("+", e, dv_call0(e_ident("__p" + dl_itoa(dj)), "to_string"));
        dj = dj + 1;
      }
      if (named) {
        e = e_binary("+", e, e_string(" }"));
      } else {
        e = e_binary("+", e, e_string(")"));
      }
      arms = arms.append(ast.MatchArm { pattern: p_variant_n(v.name, "__p", v.fields.len()), body: [s_return(e)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    } else {
      arms = arms.append(ast.MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_string(v.name))], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    }
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_string(""))];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "to_string", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Display", dyn_traits: [], streams: [] };
}

// synth_enum_debug: `to_debug` rendering `Variant` / `Variant(<debug
// payload>)` — the Debug sibling of synth_enum_display. The payload is
// rendered type-directed (a string payload is quoted) via dv_debug_render.
// Like synth_enum_display this covers payload-less and single-payload
// variants. Mirrors the Go synthEnumDebug output.
function synth_enum_debug(ename: string, variants: StructDecl[]): FuncDecl {
  let arms: ast.MatchArm[] = [];
  let i: i32 = 0;
  while (i < variants.len()) {
    let v: StructDecl = variants[i];
    if (v.fields.len() > 0) {
      // Every payload, comma-separated (`Rect(2, 3)`), matching the Go
      // synthEnumDebug.
      let e: ast.Expr = e_string(v.name + "(");
      let dj: i32 = 0;
      while (dj < v.fields.len()) {
        if (dj > 0) {
          e = e_binary("+", e, e_string(", "));
        }
        e = e_binary("+", e, dv_debug_render(e_ident("__p" + dl_itoa(dj)), v.fields[dj].type_name));
        dj = dj + 1;
      }
      e = e_binary("+", e, e_string(")"));
      arms = arms.append(ast.MatchArm { pattern: p_variant_n(v.name, "__p", v.fields.len()), body: [s_return(e)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    } else {
      arms = arms.append(ast.MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_string(v.name))], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    }
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_string(""))];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "to_debug", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Debug", dyn_traits: [], streams: [] };
}

// synth_enum_eq: match self, then match other — same variant compares
// the payload (`__s0.eq(__o0)`), any other variant is unequal. Mirrors
// the Go synthEnumEq.
function synth_enum_eq(ename: string, variants: StructDecl[]): FuncDecl {
  let arms: ast.MatchArm[] = [];
  let i: i32 = 0;
  while (i < variants.len()) {
    let v: StructDecl = variants[i];
    let inner: ast.MatchArm[] = [];
    if (v.fields.len() > 0) {
      // EVERY payload must match, not just the first — `Rect(2, 3) ==
      // Rect(2, 9)` was true before this.
      let eqx: ast.Expr = dv_eq_expr(v.fields[0].type_name, e_ident("__s0"), e_ident("__o0"));
      let qj: i32 = 1;
      while (qj < v.fields.len()) {
        eqx = e_binary("&&", eqx, dv_eq_expr(v.fields[qj].type_name, e_ident("__s" + dl_itoa(qj)), e_ident("__o" + dl_itoa(qj))));
        qj = qj + 1;
      }
      inner = inner.append(ast.MatchArm { pattern: p_variant_n(v.name, "__o", v.fields.len()), body: [s_return(eqx)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
      inner = inner.append(ast.MatchArm { pattern: p_wildcard(), body: [s_return(e_bool(false))], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
      arms = arms.append(ast.MatchArm { pattern: p_variant_n(v.name, "__s", v.fields.len()), body: [s_match(e_ident("other"), inner)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    } else {
      inner = inner.append(ast.MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_bool(true))], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
      inner = inner.append(ast.MatchArm { pattern: p_wildcard(), body: [s_return(e_bool(false))], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
      arms = arms.append(ast.MatchArm { pattern: p_variant(v.name, ""), body: [s_match(e_ident("other"), inner)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    }
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_bool(false))];
  let notp: string[] = [];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "other", type_name: ename, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
  return FuncDecl { stdlib: "", no_inline: false, name: "eq", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: params, ret_type: "boolean", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Eq", dyn_traits: [], streams: [] };
}

// synth_enum_ord: variant-wise `cmp` — a variant declared earlier sorts
// before one declared later (by index); within the same variant the
// payloads are compared lexicographically, first non-zero winning.
// Mirrors the Go synthEnumOrd.
function synth_enum_ord(ename: string, variants: StructDecl[]): FuncDecl {
  let arms: ast.MatchArm[] = [];
  let i: i32 = 0;
  while (i < variants.len()) {
    let vi: StructDecl = variants[i];
    let inner: ast.MatchArm[] = [];
    let j: i32 = 0;
    while (j < variants.len()) {
      let vj: StructDecl = variants[j];
      let obn: i32 = vj.fields.len();
      let ibody: ast.Stmt[] = [];
      if (j < i) {
        ibody = [s_return(e_number("1", "", false))];
      } else {
        if (j > i) {
          ibody = [s_return(e_binary("-", e_number("0", "", false), e_number("1", "", false)))];
        } else {
          if (vi.fields.len() > 0) {
            // Lexicographic over ALL payloads: the first non-zero
            // comparison wins. Only the first was compared before,
            // so `Rect(2, 3) < Rect(2, 9)` was false.
            let cstmts: ast.Stmt[] = [];
            let emptyb: ast.Stmt[] = [];
            let cj: i32 = 0;
            while (cj < vi.fields.len()) {
              let cn: string = "__c" + dl_itoa(cj);
              let cs1: ast.Stmt[] = dv_cmp_stmts(cn, vi.fields[cj].type_name, e_ident("__s" + dl_itoa(cj)), e_ident("__o" + dl_itoa(cj)));
              let ck: i32 = 0;
              while (ck < cs1.len()) {
                cstmts = cstmts.append(cs1[ck]);
                ck = ck + 1;
              }
              cstmts = cstmts.append(s_if(e_binary("!=", e_ident(cn), e_number("0", "", false)), [s_return(e_ident(cn))], emptyb));
              cj = cj + 1;
            }
            cstmts = cstmts.append(s_return(e_number("0", "", false)));
            ibody = cstmts;
          } else {
            ibody = [s_return(e_number("0", "", false))];
          }
        }
      }
      inner = inner.append(ast.MatchArm { pattern: p_variant_n(vj.name, "__o", obn), body: ibody, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
      j = j + 1;
    }
    arms = arms.append(ast.MatchArm { pattern: p_variant_n(vi.name, "__s", vi.fields.len()), body: [s_match(e_ident("other"), inner)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_number("0", "", false))];
  let notp: string[] = [];
  let params: ast.ParamDecl[] = [ast.ParamDecl { name: "other", type_name: ename, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" }];
  return FuncDecl { stdlib: "", no_inline: false, name: "cmp", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: params, ret_type: "i32", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Ord", dyn_traits: [], streams: [] };
}

// synth_enum_hash: variant-wise `hash` — seed the accumulator with the
// variant's tag (17 + declaration index) so distinct variants hash
// apart, then fold EVERY payload (`__p0`, `__p1`, …) through `h = h * 31 +
// <payload>.hash()`. Mirrors the Go synthEnumHash.
function synth_enum_hash(ename: string, variants: StructDecl[]): FuncDecl {
  let arms: ast.MatchArm[] = [];
  let i: i32 = 0;
  while (i < variants.len()) {
    let v: StructDecl = variants[i];
    let stmts: ast.Stmt[] = [s_var("__h", "i32", e_number(dl_itoa(17 + i), "", false))];
    // Fold EVERY payload, so two variants differing only past the first
    // no longer collide (`Rect(2, 3)` and `Rect(2, 9)` hashed equal before).
    let hj: i32 = 0;
    while (hj < v.fields.len()) {
      let fs: ast.Stmt[] = dv_hash_stmts("__h", v.fields[hj].type_name, e_ident("__p" + dl_itoa(hj)), dl_itoa(i) + "_" + dl_itoa(hj));
      let k: i32 = 0;
      while (k < fs.len()) {
        stmts = stmts.append(fs[k]);
        k = k + 1;
      }
      hj = hj + 1;
    }
    stmts = stmts.append(s_return(e_ident("__h")));
    arms = arms.append(ast.MatchArm { pattern: p_variant_n(v.name, "__p", v.fields.len()), body: stmts, line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_number("0", "", false))];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "hash", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_type: "i32", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Hash", dyn_traits: [], streams: [] };
}

// synth_enum_json: variant-wise `to_json` — a unit variant renders as
// its name as a JSON string (`"Empty"`); a payload variant as a single-
// key object (`{"Circle":<__p0.to_json()>}`), and a MULTI-payload variant as
// a JSON array under that key (`{"Rect":[2,3]}`). Externally-tagged, matching
// the Go synthEnumJson.
function synth_enum_json(ename: string, variants: StructDecl[]): FuncDecl {
  let arms: ast.MatchArm[] = [];
  let i: i32 = 0;
  while (i < variants.len()) {
    let v: StructDecl = variants[i];
    if (v.fields.len() > 0) {
      // One payload renders bare (`{"Circle":5}`); two or more render as a
      // JSON ARRAY (`{"Rect":[2,3]}`), matching the Go synthEnumJson.
      let e: ast.Expr = e_string("{\"" + v.name + "\":");
      if (v.fields.len() > 1) {
        e = e_binary("+", e, e_string("["));
      }
      let pj: i32 = 0;
      while (pj < v.fields.len()) {
        if (pj > 0) {
          e = e_binary("+", e, e_string(","));
        }
        e = e_binary("+", e, dv_call0(e_ident("__p" + dl_itoa(pj)), "to_json"));
        pj = pj + 1;
      }
      if (v.fields.len() > 1) {
        e = e_binary("+", e, e_string("]"));
      }
      e = e_binary("+", e, e_string("}"));
      arms = arms.append(ast.MatchArm { pattern: p_variant_n(v.name, "__p", v.fields.len()), body: [s_return(e)], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    } else {
      arms = arms.append(ast.MatchArm { pattern: p_variant(v.name, ""), body: [s_return(e_string("\"" + v.name + "\""))], line: 0, col: 0, guard: e_bool(true), has_guard: false, alt_cont: false });
    }
    i = i + 1;
  }
  let body: ast.Stmt[] = [s_match(e_ident("self"), arms), s_return(e_string(""))];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "to_json", receiver_name: "self", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_type: "string", body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Json", dyn_traits: [], streams: [] };
}

// enum_default_derivable reports whether an enum has a derivable default: it
// has at least one variant, and every payload of its FIRST variant is itself
// default-derivable. Mirrors the Go synthEnumDefault's gate.
function enum_default_derivable(variants: StructDecl[]): boolean {
  if (variants.len() == 0) {
    return false;
  }
  let v0: StructDecl = variants[0];
  let i: i32 = 0;
  while (i < v0.fields.len()) {
    if (!dv_default_derivable(v0.fields[i].type_name)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// synth_enum_default: the associated function `function default(): Self {
// return <FirstVariant>(<dv>, …); }` — an enum defaults to its first variant,
// each payload defaulted. Receiver-less (empty receiver_name), so it lowers
// via the associated-function IR path; a unit first variant builds a bare
// variant value, a payload one a variant construction. Mirrors the Go
// synthEnumDefault.
function synth_enum_default(ename: string, variants: StructDecl[]): FuncDecl {
  let v0: StructDecl = variants[0];
  let value: ast.Expr = e_ident(v0.name);
  if (v0.fields.len() > 0) {
    let args: ast.Expr[] = [];
    let i: i32 = 0;
    while (i < v0.fields.len()) {
      args = args.append(dv_default_expr(v0.fields[i].type_name));
      i = i + 1;
    }
    value = e_call(e_ident(v0.name), args);
  }
  let body: ast.Stmt[] = [s_return(value)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  return FuncDecl { stdlib: "", no_inline: false, name: "default", receiver_name: "", receiver_type: ename, receiver_own: false, type_params: notp, params: noparams, ret_type: ename, body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Default", dyn_traits: [], streams: [] };
}

// synth_enum_derives appends the derivable enum methods. Display, Eq,
// Ord, Hash, Json, and Default are supported (Ord uses variant-declaration
// order then a lexicographic payload compare; Hash seeds with the variant
// tag; Json is externally tagged; Default is the first variant defaulted —
// the only associated/receiver-less one).
function synth_enum_derives(ename: string, declared: StructDecl[], derives: string[], funcs: FuncDecl[]): FuncDecl[] {
  // A derive reads each field by the box it lowers to: a `str` payload
  // derives exactly as a `string` one.
  let variants: StructDecl[] = [];
  for vd in declared {
    variants = variants.append(erase_view_struct(vd));
  }
  let di: i32 = 0;
  while (di < derives.len()) {
    let kind: string = derive_simple_name(derives[di]);
    if (kind == "Display") {
      funcs = funcs.append(synth_enum_display(ename, variants));
    }
    if (kind == "Debug") {
      funcs = funcs.append(synth_enum_debug(ename, variants));
    }
    if (kind == "Eq") {
      funcs = funcs.append(synth_enum_eq(ename, variants));
    }
    if (kind == "Ord") {
      funcs = funcs.append(synth_enum_ord(ename, variants));
    }
    if (kind == "Hash") {
      funcs = funcs.append(synth_enum_hash(ename, variants));
    }
    if (kind == "Json") {
      funcs = funcs.append(synth_enum_json(ename, variants));
    }
    if (kind == "Default") {
      if (enum_default_derivable(declared)) {
        funcs = funcs.append(synth_enum_default(ename, variants));
      }
    }
    di = di + 1;
  }
  return funcs;
}

// ---- @derive(Default) -------------------------------------------------
// `Default.default()` is an ASSOCIATED function (no `self`): `Type.default()`
// builds a type's zero value. For a concrete struct the field types are
// concrete, so each field's default is either a scalar zero literal or a
// nominal field's own `Type.default()` (a plain associated call — item 1's
// IR path resolves it). Mirrors the Go synthDefault / defaultDeriveExpr.

// dv_is_scalar reports whether a type is a primitive scalar whose default
// is a zero literal: i32/i64/u8/u32/u64 → 0, f32/f64 → 0.0, boolean → false,
// string → "". The Go side asks this of the TYPE (every NumberType is a
// scalar), so a width missing here is a divergence, not a conservative
// omission: `u8` was, and `T.default()` at `T = u8` emitted a `u8.default()`
// call naming a type that is not a value.
function dv_is_scalar(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64"
    || t == "f32" || t == "f64" || t == "boolean" || t == "string";
}

// dv_default_derivable reports whether a field type has a derivable
// default: a scalar, or a bare NOMINAL name (a struct/enum whose own
// `default()` supplies the value). An array / map / generic / tuple /
// function shape — anything carrying `[`, `]`, `(`, `)`, `,` or a space —
// has no derived default (mirroring the Go defaultDeriveExpr's ok=false).
function dv_default_derivable(t: string): boolean {
  if (dv_is_scalar(t)) {
    return true;
  }
  // Native derives no default for a `str` view.
  if (t.len() == 0 || t == "str") {
    return false;
  }
  let i: i32 = 0;
  while (i < t.len()) {
    let c: i32 = t[i] as i32;
    // [ ] ( ) , space → a non-nominal shape.
    if (c == 91 || c == 93 || c == 40 || c == 41 || c == 44 || c == 32) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// dv_default_expr builds the default value for a field of type `t`: a
// scalar zero literal, or `T.default()` (an associated call, no receiver)
// for a nominal type that delegates to its own derived default.
function dv_default_expr(t: string): ast.Expr {
  if (t == "string") {
    return e_string("");
  }
  if (t == "boolean") {
    return e_bool(false);
  }
  if (t == "f32" || t == "f64") {
    return e_number("0.0", "", true);
  }
  if (dv_is_scalar(t)) {
    return e_number("0", "", false);
  }
  let noargs: ast.Expr[] = [];
  return e_call(e_field_access(e_ident(t), "default"), noargs);
}

// dv_eq_expr builds the equality test for one derived-`eq` field/payload.
// A SCALAR (`dv_is_scalar`) compares with the primitive `==`, so the derive
// needs no `Eq` impl for that type — which matters on the self-host, whose
// loader skips `core`/`std` imports, leaving `core/cmp`'s primitive `i32.eq`
// (etc.) unavailable; a `.eq()` call there would bail the module to the AST
// emitter. A nominal field delegates to its own (local, derived) `.eq()`.
// `==` matches `core/cmp`'s scalar `eq` exactly (`self == other`), so the
// native/self-host differential oracle still agrees.
function dv_eq_expr(ty: string, lhs: ast.Expr, rhs: ast.Expr): ast.Expr {
  if (dv_is_scalar(ty)) {
    return e_binary("==", lhs, rhs);
  }
  return dv_call1(lhs, "eq", rhs);
}

// dv_cmp_stmts builds the statements that compute the three-way comparison of
// one derived-`cmp` field/payload into the i32 local `vn`. A field the ordering
// OPERATORS handle — a numeric scalar or a string — inlines core/cmp's Ord body
// (`vn = -1 / 1 / 0` via `<` / `>`), so the derive needs no `Ord` impl for that
// type, which the self-host loader (local + builtin only, no core/std) does not
// provide. A nominal field delegates to its own (local, derived) `.cmp()`. The
// inline form is character-for-character core/cmp's own `cmp` for those types,
// so the differential oracle still agrees.
function dv_cmp_stmts(vn: string, ty: string, lhs: ast.Expr, rhs: ast.Expr): ast.Stmt[] {
  if (dv_is_num_scalar(ty) || ty == "string") {
    let neg1: ast.Expr = e_binary("-", e_number("0", "", false), e_number("1", "", false));
    let out: ast.Stmt[] = [s_var(vn, "i32", e_number("0", "", false))];
    out = out.append(s_if(e_binary("<", lhs, rhs), [s_assign(vn, neg1)], []));
    out = out.append(s_if(e_binary(">", lhs, rhs), [s_assign(vn, e_number("1", "", false))], []));
    return out;
  }
  return [s_var(vn, "i32", dv_call1(lhs, "cmp", rhs))];
}

// dv_hash_stmts builds the statements that fold one field/payload's hash into
// the i32 accumulator `hv` via `h = h * 31 + <field hash>`. A SCALAR inlines
// its own hash — numeric: the value (cast to i32 for non-i32 widths); boolean:
// 0 / 1; string: an FNV-style per-byte `h = h*31 + ch` fold — so the derive
// needs NO `impl Hash for <primitive>`. The stdin-only self-host drivers
// (wasm_ir_run / asm_run, which parse a single source with no core/cmp loaded)
// don't provide those impls, so a primitive `.hash()` call would resolve to an
// unknown function and BAIL the whole module (the exact gap
// that kept struct/enum Map keys off the wasm self-host hash map — #2671). A
// NOMINAL field/payload delegates to its own (local, derived) `.hash()`. The
// only law the Map relies on is `a == b ⇒ a.hash() == b.hash()`, which the
// value-wise fold preserves; the absolute hash need not match core/cmp's mix.
// `sfx` disambiguates the per-string loop variable across fields. Mirrors the
// inline-primitive approach dv_cmp_stmts takes for `Ord`.
function dv_hash_stmts(hv: string, ty: string, recv: ast.Expr, sfx: string): ast.Stmt[] {
  let mul: ast.Expr = e_binary("*", e_ident(hv), e_number("31", "", false));
  if (ty == "string") {
    // h = h * 31; let i = 0; while (i < recv.len()) { h = h*31 + (recv[i] as i32); i = i+1; }
    //
    // The byte is cast, not widened implicitly: an index into a string is
    // u8 and the accumulator is i32, which is a mixed-SIGNEDNESS binop the
    // checker rejects. The numeric-scalar arm below has always cast for the
    // same reason; this one did not, and nothing noticed while the checker
    // let mixed signedness through. Value-identical either way.
    let iv: string = "__hsi" + sfx;
    let body: ast.Stmt[] = [s_assign(hv, e_binary(
      "+",
      e_binary("*", e_ident(hv), e_number("31", "", false)),
      e_unary("as_i32", e_index(recv, e_ident(iv), 0, 0)),
    ))];
    body = body.append(s_assign(iv, e_binary("+", e_ident(iv), e_number("1", "", false))));
    let out: ast.Stmt[] = [s_assign(hv, mul)];
    out = out.append(s_var(iv, "i32", e_number("0", "", false)));
    out = out.append(s_while(e_binary("<", e_ident(iv), dv_call0(recv, "len")), body));
    return out;
  }
  if (ty == "boolean") {
    // h = h * 31; if (recv) { h = h + 1; }
    let t: ast.Stmt[] = [s_assign(hv, e_binary("+", e_ident(hv), e_number("1", "", false)))];
    return [s_assign(hv, mul), s_if(recv, t, [])];
  }
  if (dv_is_num_scalar(ty)) {
    let v: ast.Expr = recv;
    if (ty != "i32") {
      v = e_unary("as_i32", recv);
    }
    return [s_assign(hv, e_binary("+", mul, v))];
  }
  // Nominal struct/enum field: delegate to its own derived `.hash()`.
  return [s_assign(hv, e_binary("+", mul, dv_call0(recv, "hash")))];
}

// dv_is_num_scalar reports whether `t` is a numeric scalar — the subset of
// dv_is_scalar (excluding string / boolean) that std/num's Zero / One are
// impl'd for, so a `T.zero()` / `T.one()` on such a `T` can lower to a literal.
function dv_is_num_scalar(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u32" || t == "u64"
    || t == "f32" || t == "f64";
}

// dv_num_identity_expr builds the additive (`one=false` → 0 / 0.0) or
// multiplicative (`one=true` → 1 / 1.0) identity literal for a numeric scalar
// type — the `T.zero()` / `T.one()` counterpart to dv_default_expr's scalar
// zero.
function dv_num_identity_expr(t: string, one: boolean): ast.Expr {
  if (t == "f32" || t == "f64") {
    if (one) {
      return e_number("1.0", "", true);
    }
    return e_number("0.0", "", true);
  }
  if (one) {
    return e_number("1", "", false);
  }
  return e_number("0", "", false);
}

// struct_default_derivable reports whether EVERY field of `sd` has a
// derivable default (so the whole struct does). The Go checker is the
// strict gate; here we simply skip synthesis when a field isn't
// derivable, leaving `Type.default()` unresolved — the same end state as
// the Go path's error (no default method synthesised).
function struct_default_derivable(sd: StructDecl): boolean {
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    if (!dv_default_derivable(sd.fields[i].type_name)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// synth_struct_default: the associated function `function default(): Self
// { return Name { f0: <dv>, … }; }` — receiver-less (empty receiver_name),
// so it lowers via the associated-function IR path (item 1). Mirrors the
// Go synthDefault.
function synth_struct_default(sd: StructDecl): FuncDecl {
  let fnames: string[] = [];
  let fvals: ast.Expr[] = [];
  let i: i32 = 0;
  while (i < sd.fields.len()) {
    fnames = fnames.append(sd.fields[i].name);
    fvals = fvals.append(dv_default_expr(sd.fields[i].type_name));
    i = i + 1;
  }
  let lit: ast.Expr = e_struct_lit(sd.name, fnames, fvals, 0, 0);
  let body: ast.Stmt[] = [s_return(lit)];
  let notp: string[] = [];
  let noparams: ast.ParamDecl[] = [];
  // Like the other derived struct methods, default() carries NO function-level
  // type params (an empty list keeps monomorphize_module from treating it as a
  // generic free function). When the struct is generic, the struct-method
  // monomorphiser clones it per instantiation and substitutes `T` using the
  // STRUCT's type params (clone_struct_method) — so a generic body's
  // `T.default()` becomes `Concrete.default()`.
  return FuncDecl { stdlib: "", no_inline: false, name: "default", receiver_name: "", receiver_type: sd.name, receiver_own: false, type_params: notp, params: noparams, ret_type: sd.name, body: body, line: 0, col: 0, import_iface: "", import_wit: "", all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false, is_const: false, is_pub: true, ret_fn_ret: "", ret_fn_param_types: "", is_package: false, module: "", impl_trait: "Default", dyn_traits: [], streams: [] };
}

// synth_derives appends the synthesised methods for each derivable trait
// (`Eq` / `Display` / `Ord` / `Hash` / `Json` / `FromJson` / `Default`)
// named in `derives` for struct `sd` onto `funcs`. Non-derivable / unknown
// trait names are ignored (the Go checker is the strict gate). `Default`
// and `FromJson` synthesise associated (receiver-less) functions; `Default`
// only when every field is itself default-derivable.
function synth_derives(declared: StructDecl, derives: string[], funcs: FuncDecl[], has_json_import: boolean): FuncDecl[] {
  // A derive reads each field by the box it lowers to: a `str` field
  // derives exactly as a `string` one.
  let sd: StructDecl = erase_view_struct(declared);
  let di: i32 = 0;
  while (di < derives.len()) {
    let kind: string = derive_simple_name(derives[di]);
    if (kind == "Display") {
      funcs = funcs.append(synth_struct_display(sd));
    }
    if (kind == "Debug") {
      funcs = funcs.append(synth_struct_debug(sd));
    }
    if (kind == "Eq") {
      funcs = funcs.append(synth_struct_eq(sd));
    }
    if (kind == "Ord") {
      funcs = funcs.append(synth_struct_ord(sd));
    }
    if (kind == "Hash") {
      funcs = funcs.append(synth_struct_hash(sd));
    }
    if (kind == "Json") {
      funcs = funcs.append(synth_struct_json(sd));
    }
    // A derived decoder calls std/json's readers, so it is only
    // synthesised when std/json is imported (native's `json__json_parse
    // in prog.Funcs` gate); the checker reports the missing import.
    if (kind == "FromJson" && has_json_import) {
      funcs = funcs.append(synth_from_json_value(sd));
      funcs = funcs.append(synth_from_json_text(sd));
    }
    if (kind == "Default") {
      if (struct_default_derivable(declared)) {
        funcs = funcs.append(synth_struct_default(sd));
      }
    }
    di = di + 1;
  }
  return funcs;
}

// imports_have_std_json reports whether the module's parsed imports include
// std/json — the precondition for synthesising a `@derive(FromJson)` struct's
// decoder (whose body calls std/json's field readers). Imports
// are conventionally at the top of a module, so they are already accumulated
// by the time a `@derive` struct decl is reached in parse_module.
function imports_have_std_json(imports: Import[]): boolean {
  let i: i32 = 0;
  while (i < imports.len()) {
    if (imports[i].path == "std/json") {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// parse_derive_attr consumes `@derive(Trait, mod.Trait, …)` (the `@` is
// at the cursor) and returns the (possibly qualified) trait names.
function parse_derive_attr(p: Par): (string[], Par) {
  let derives: string[] = [];
  p = p.advance();  // `@`
  if (p.peek_ident() == "derive") {
    p = p.advance();
  }
  if (p.peek_punct() == "(") {
    p = p.advance();
    while (!p.at_end()) {
      if (p.peek_punct() == ")") {
        break;
      }
      let tn: string = p.peek_ident();
      if (tn.len() == 0) {
        p = p.advance();
        continue;
      }
      p = p.advance();
      while (p.at_path_sep()) {
        p = p.advance();
        let seg: string = p.peek_ident();
        if (seg.len() > 0) {
          tn = tn + "." + seg;
          p = p.advance();
        }
      }
      derives = derives.append(tn);
      if (p.peek_punct() == ",") {
        p = p.advance();
      }
    }
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
  }
  return (derives, p);
}

// parse_import_attr consumes `@import("wasi:iface@x.y.z", "wit-func-name")`
// (the `@` is at the cursor) and returns the interface + WIT function strings
// that bind the following body-less function to a WIT import (bring-your-own
// WIT, P4 — docs/WIT-BRING-YOUR-OWN.md). `is_import` is false when the
// attribute after `@` is not `import`, so the caller falls back to @derive.
function parse_import_attr(p: Par): (string, string, boolean, Par) {
  p = p.advance();  // `@`
  if (p.peek_keyword() != "import") {
    return ("", "", false, p);
  }
  p = p.advance();  // `import`
  let iface: string = "";
  let wit: string = "";
  if (p.peek_punct() == "(") {
    p = p.advance();
    match (p.peek()) {
      lexer.TokString(s) => {
        iface = s.value;
        p = p.advance();
      },
      _ => {}
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
    match (p.peek()) {
      lexer.TokString(s) => {
        wit = s.value;
        p = p.advance();
      },
      _ => {}
    }
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
  }
  return (iface, wit, true, p);
}

// parse_export_attr consumes `@export("wasi:iface@x.y.z", "wit-name")` (the `@`
// is at the cursor) and returns the (iface, name) pair that binds the following
// function to a WIT export (P6 — docs/WIT-BRING-YOUR-OWN.md). Reuses
// the shared (iface, wit, …, Par) tuple shape.
function parse_export_attr(p: Par): (string, string, boolean, Par) {
  p = p.advance();  // `@`
  if (p.peek_ident() != "export") {
    return ("", "", false, p);
  }
  p = p.advance();  // `export`
  let iface: string = "";
  let wit: string = "";
  if (p.peek_punct() == "(") {
    p = p.advance();
    match (p.peek()) {
      lexer.TokString(s) => {
        iface = s.value;
        p = p.advance();
      },
      _ => {}
    }
    if (p.peek_punct() == ",") {
      p = p.advance();
    }
    match (p.peek()) {
      lexer.TokString(s) => {
        wit = s.value;
        p = p.advance();
      },
      _ => {}
    }
    if (p.peek_punct() == ")") {
      p = p.advance();
    }
  }
  return (iface, wit, true, p);
}

// yields the parsed resource name plus the advanced parser.

// parse_resource_decl_name consumes `resource Name;` (the contextual `resource`
// identifier is at the cursor) and returns the parser plus `Name`. The optional
// `@import` WIT binding is attached by parse_module. See ResourceDecl and
// docs/WIT-BRING-YOUR-OWN.md (P5).
function parse_resource_decl_name(p: Par): (string, Par) {
  p = p.advance();  // `resource`
  let name: string = p.peek_ident();
  if (name.len() > 0) {  // Name
    p = p.advance();
  }
  if (p.peek_punct() == ";") {
    p = p.advance();
  }
  return (name, p);
}

// parse_impl_decl consumes `impl Trait for Type { <function>… }`.
// Each method is desugared into an ordinary receiver-method
// FuncDecl — its first `self: Self` parameter becomes the receiver
// with `Self` rewritten to the concrete `for` type — so the rest
// of the self-host pipeline (which already dispatches methods by
// receiver type) handles trait impls with no further changes.
// The trait name is parsed and discarded: the self-host resolves
// `obj.method()` by the receiver's concrete type, not via the
// trait. Mirrors the Go parser's impl desugaring (docs/TRAITS.md).
function parse_impl_decl(p: Par): (FuncDecl[], string, string, string[], string[], string[], string, ImplDecl, ast.Stmt[], Par) {
  let out: FuncDecl[] = [];
  let impl_bad: ast.Stmt[] = [];
  let method_names: string[] = [];
  let iline: i32 = p.peek_line();
  let icol: i32 = p.peek_col();
  p = p.advance();  // `impl`
  // Parametric impl: `impl[T: Bound] Trait for Box[T] { … }`. Collect
  // the impl's type-parameter names (bounded ones drive
  // monomorphisation; unbounded are erased) so each desugared method
  // carries them — the `for` type (`Box[T]`) keeps `T`, and the
  // emitter strips the generic args to the base struct name `Box`.
  // See docs/TRAITS.md.
  // Consumed through the shared list parser; the BOUNDED names are what drives
  // monomorphisation, and the whole list with its bounds is what the formatter
  // needs — `impl[T: cmp.Eq]` reprinted as `impl` drops the constraint.
  let (impl_tpl, impl_tp_p) = parse_type_param_list(p);
  p = impl_tp_p;
  let impl_tps: string[] = [];
  // Parallel to impl_tps. finalize_impl_method merges both halves into every
  // method of the block, so a name kept without its bound gives a method that
  // still declares `T` and reads back unbounded.
  let impl_tbs: string[] = [];
  let itpi: i32 = 0;
  while (itpi < impl_tpl.tnames.len()) {
    if (impl_tpl.tbounds[itpi].len() > 0) {
      impl_tps = impl_tps.append(impl_tpl.tnames[itpi]);
      impl_tbs = impl_tbs.append(impl_tpl.tbounds[itpi]);
    }
    itpi = itpi + 1;
  }
  // First name after `impl` (possibly `mod.Name`). For a trait impl
  // (`impl Trait for Type`) it's the trait; for an inherent impl
  // (`impl Type { … }`, #2700) there is no `for` and this name IS the
  // impl type, with no trait.
  // parse_type_name resolves `mod.Name` to the bare `Name`, which is right
  // for everything downstream and wrong for anyone reporting what the source
  // said. Read the qualifier off the tokens BEFORE it is consumed.
  let first_spelling: string = "";
  if (p.peek_ident().len() > 0 && (p.peek_punct_at(1) == "." || p.peek_punct_at(1) == "::") && p.peek_ident_at(2).len() > 0) {
    first_spelling = p.peek_ident() + p.peek_punct_at(1) + p.peek_ident_at(2);
  }
  // parse_type_name admits a keyword, which a built-in type name is; a trait
  // name never is, so a keyword followed by `for` is refused below.
  let first_is_kw: boolean = p.peek_ident().len() == 0 && p.peek_keyword().len() > 0;
  let first_at: Par = p;
  let (tnr_name, tnr_fn_ret, tnr_p) = parse_type_name(p);
  p = tnr_p;
  let first_name: string = tnr_name;
  let trait_spelling: string = "";
  let trait_name: string = "";
  let impl_type: string = "";
  if (p.peek_keyword() == "for") {
    if (first_is_kw) {
      impl_bad = impl_bad.append(decl_sentinel(first_at, "malformed impl: its trait name could not be read (a keyword such as `use`, `type` or `match` cannot be a name)"));
    }
    p = p.advance();
    // Trait name retained so parse_module can match the impl against
    // the trait's default methods.
    trait_name = first_name;
    trait_spelling = first_spelling;
    let (ity_name, ity_fn_ret, ity_p) = parse_type_name(p);
    p = ity_p;
    impl_type = ity_name;
  } else {
    // Inherent impl: the first name is the type; receiver-less methods
    // are associated functions (`Type.f(args)`), `self`-taking ones are
    // ordinary methods.
    impl_type = first_name;
  }
  if (p.peek_punct() == "{") {
    p = p.advance();
  }
  // Associated-type bindings this impl fixes (`type Item = i32;`), parallel
  // arrays name -> bound type spelling. `Self` in the bound type resolves to
  // the impl type, as it does in a method signature.
  let assoc_names: string[] = [];
  let assoc_values: string[] = [];
  while (!p.at_end()) {
    if (p.peek_punct() == "}") {
      break;
    }
    let kw: string = p.peek_keyword();
    if (kw == "pub") {
      p = p.advance();
      kw = p.peek_keyword();
    }
    if (kw == "type") {
      p = p.advance();
      let ab_name: string = p.peek_ident();
      if (ab_name.len() > 0) {
        p = p.advance();
      } else {
        impl_bad = impl_bad.append(decl_sentinel(p, "malformed associated type binding: its name could not be read (a keyword such as `type` or `match` cannot be a name)"));
      }
      if (p.peek_punct() == "=") {
        p = p.advance();
      }
      let (ab_ty, ab_fnret, ab_p) = parse_type_name(p);
      p = ab_p;
      if (p.peek_punct() == ";") {
        p = p.advance();
      }
      if (ab_name.len() > 0) {
        assoc_names = assoc_names.append(ab_name);
        assoc_values = assoc_values.append(subst_self(ab_ty, impl_type));
      }
      continue;
    }
    if (kw != "function") {
      impl_bad = impl_bad.append(decl_sentinel(p, "unexpected token in an impl body: expected `function` or `type`"));
      p = skip_body_item(p.advance());
      continue;
    }
    let (fr_func, fr_p) = parse_func_decl(p);
    p = fr_p;
    if (fr_func.name.len() == 0) {
      p = skip_body_item(p);
    }
    let m: FuncDecl = fr_func;
    // finalize_impl_method does the receiver-peel / associated-function
    // encoding, the `Self` -> impl_type rewrite, and the bounded-type-
    // param merge (shared with trait default-method synthesis).
    out = out.append(finalize_impl_method(m, impl_type, impl_tps, impl_tbs));
    method_names = method_names.append(m.name);
  }
  if (p.peek_punct() == "}") {
    p = p.advance();
  }
  // Strip generic args from the trait ref (`Greet[i32]` -> `Greet`) before
  // reducing to the simple name, so a generic-trait impl matches its trait
  // declaration for default-method synthesis (parse_module compares against
  // the trait decl's bracket-free simple name). Without the strip,
  // `impl Greet[i32] for P` records trait_name "Greet[i32]", never matches
  // the `Greet` trait, and its default methods are never synthesised (#4340).
  return (out, derive_simple_name(strip_struct_base(trait_name)), impl_type, impl_tps, impl_tbs, method_names, trait_spelling, ImplDecl { trait_ref: trait_name, type_ref: impl_type, type_params: impl_tpl.tnames, bounds: impl_tpl.tbounds, methods: out, line: iline, col: icol, assoc_names: assoc_names, assoc_values: assoc_values }, impl_bad, p);
}

// finalize_impl_method turns a parsed impl/trait-default method `m` into
// the receiver-method (or associated-function) FuncDecl the rest of the
// pipeline consumes: `Self` -> impl_type across params + return, the
// leading `self` peeled into the receiver (a method whose first param
// isn't `self` is an associated function with an empty receiver_name),
// and the impl's bounded type params merged in. Shared by parse_impl_decl
// (written methods) and trait default-method synthesis in parse_module.
function ident_byte(b: i32): boolean {
  return b >= 97 && b <= 122 || b >= 65 && b <= 90 || b >= 48 && b <= 57 || b == 95;
}

// is_builtin_generic_base reports whether `b` is a built-in generic type
// constructor whose instantiations are NOT cloned by the struct/enum
// monomorphiser — `Option` / `Result` (uniform leak-only boxes) and `Map`
// (built-in K/V dispatch). A type param appearing only as their argument
// (`find[T](…): Option[T]`) does not need promotion: the uniform 8-byte ABI
// already handles it, exactly as the historical erasure did.
function is_builtin_generic_base(b: string): boolean {
  return b == "Option" || b == "Result" || b == "Map";
}

// enclosing_bracket_base returns the base identifier of the INNERMOST `[ … ]`
// that encloses position `pos` in `ty` — `Box` for the `T` in `Box[T]`,
// `Option` for the `T` in `Box[Option[T]]` — or "" if `pos` is not inside any
// bracket. Found by scanning left from `pos`, balancing `]`/`[`, until the
// first unmatched `[`; the base is the identifier immediately preceding it.
function enclosing_bracket_base(ty: string, pos: i32): string {
  let bal: i32 = 0;
  let i: i32 = pos - 1;
  while (i >= 0) {
    let c: u8 = ty[i];
    if (c == b']') {
      bal = bal + 1;
    } else if (c == b'[') {
      if (bal == 0) {
        let st: i32 = i;
        while (st > 0 && ident_byte(ty[st - 1] as i32)) {
          st = st - 1;
        }
        return slice_unchecked(ty, st, i) + "";
      }
      bal = bal - 1;
    }
    i = i - 1;
  }
  return "";
}

// feeds_user_parametric reports whether the type-param `name` appears as a
// bracketed type-ARGUMENT to a USER parametric type in `ty` — i.e. inside
// `Base[ … name … ]` where `Base` is a user generic struct/enum (NOT a
// built-in: see is_builtin_generic_base, and NOT the array marker `T[]`, whose
// `[` is preceded by the element and encloses nothing). Such an occurrence
// means a struct/enum clone needs `name`'s concrete value, so the unbounded
// param must be promoted to the monomorphiser. `ArrayIter[T]` matches;
// `Option[T]` / `Map[K, V]` / bare `T` / `T[]` do not. The base checked is the
// INNERMOST enclosing bracket (`Box[Option[T]]` -> base `Option`, no promote).
function feeds_user_parametric(ty: string, name: string): boolean {
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + nl < ty.len() && ident_byte(ty[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        let b: string = enclosing_bracket_base(ty, i);
        if (b.len() > 0 && !is_builtin_generic_base(b)) {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

// feeds_map_typearg reports whether `name` appears as a bracketed type-ARGUMENT
// to a `Map[...]` (key or value position) in `ty`. feeds_user_parametric
// EXCLUDES the built-in `Map` base (a Map needs no struct clone) — but a generic
// body's map ops DO need the concrete K/V to pick the key-kind / value-is-ptr,
// so a `Map`-feeding type var must be promoted to the monomorphiser too, else
// the erased body defaults to string-key dispatch and miscompiles an i32-keyed
// map. This is the Map-codegen sibling of feeds_user_parametric's struct-clone
// rule. The base checked is the INNERMOST enclosing bracket.
function feeds_map_typearg(ty: string, name: string): boolean {
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + nl < ty.len() && ident_byte(ty[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        if (enclosing_bracket_base(ty, i) == "Map") {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

// feeds_wide_container reports whether `name` appears as a type-arg of a BUILTIN
// container in `ty` — `name[]` (array element), `Option[name]`, or a `Result[…]`
// arg. feeds_user_parametric EXCLUDES these builtin bases (they need
// no user-struct clone and are erased-safe on the register backends). But on
// WASM an erased container's box LAYOUT shifts with payload width (an `Option`
// is 8B/@4 for i32 vs 16B/@8 for i64/f64; an array stride is 4 vs 8), so a wide
// value returned in an erased container can't be read back unambiguously.
// Promoting the type let (paired with a bare-scalar param, below) monomorphises
// the fn to a CONCRETE container, which the IR path already lowers on every
// backend. Non-wasm backends just gain a clone.
//
// `Result[…]` is included, but the caller's `all_tps.len() == 1` guard is what
// keeps THIS clause SOUND: a Result matched here is only promoted when `name` is
// the fn's ONLY type param, so the clone is fully concrete — `okr[T](x: T):
// Result[T, string]` → `okr__i64(x: i64): Result[i64, string]` (concrete Err arm),
// or `Result[T, T]` → `Result[i64, i64]`. The genuinely two-typevar
// `okg[T, E](x: T): Result[T, E]` (`all_tps.len() == 2`) is handled by the SEPARATE
// clause (c′) via result_two_bare_vars, which promotes BOTH vars so neither is
// stranded erased on the Err arm — T binds from the arg, E from the call-site
// return annotation (infer_inst_ret). It is NOT reached through this single-var
// path (the all_tps.len() == 1 guard excludes it), so the two paths stay disjoint.
function feeds_wide_container(ty: string, name: string): boolean {
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let nxt: i32 = i + nl;
      let next_ok: boolean = true;
      if (nxt < ty.len() && ident_byte(ty[nxt] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        // `name[]` — an array element.
        if (nxt + 1 < ty.len() && ty[nxt] == b'[' && ty[nxt + 1] == b']') {
          return true;
        }
        let b: string = enclosing_bracket_base(ty, i);
        if (b == "Option" || b == "Result") {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

// all_bare_scalar_bound reports whether EVERY type let in `tps` is bound by some
// param whose type is exactly that var. It is what makes the multi-var half of
// clause (c'') safe: a var not bound this way would survive erased in the clone
// (the stranded-sibling hazard clause (c) guards against with all_tps.len() == 1).
function all_bare_scalar_bound(params: ast.ParamDecl[], tps: string[]): boolean {
  let i: i32 = 0;
  while (i < tps.len()) {
    if (!has_bare_scalar_param(params, tps[i])) {
      return false;
    }
    i = i + 1;
  }
  return tps.len() > 0;
}

// ret_mentions_any reports whether `ret_type` references ANY of `tps` — the
// clause (c'') requirement that the return be fully concrete, checked across the
// whole set rather than one var at a time.
function ret_mentions_any(ret_type: string, tps: string[]): boolean {
  let i: i32 = 0;
  while (i < tps.len()) {
    if (type_mentions_var(ret_type, tps[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// type_mentions_var reports whether the type spelling `ty` references the type
// variable `name` anywhere, as a whole identifier — the word-boundary scan
// feeds_wide_container does, without its container test. Used by clause (c'') to
// require a return type that is fully CONCRETE.
function type_mentions_var(ty: string, name: string): boolean {
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    if (i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let nxt: i32 = i + nl;
      let next_ok: boolean = true;
      if (nxt < ty.len() && ident_byte(ty[nxt] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

// has_bare_scalar_param reports whether some param's type is EXACTLY `name` — a
// bare-typevar SCALAR param (`x: T`), the shape that carries a wide i64/f64 value
// through an erased-generic call. Distinguishes `some1[T](x: T): Option[T]` /
// `dup[T](x: T): T[]` (promote) from `map[T,U](xs: T[], …)` (an ARRAY param — the
// wide value is behind an i32 array pointer, not a bare scalar, so it never trips the
// erased-wide gate and must stay erased to avoid over-monomorphising the stdlib).
// has_bare_array_param reports whether some param's type is EXACTLY `name[]` — a
// bare-typevar ARRAY param (`xs: T[]`). The element sibling of
// has_bare_scalar_param: the erasure is in the element, not the value.
function has_bare_array_param(params: ast.ParamDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < params.len()) {
    if (params[i].type_name == name + "[]" || params[i].type_name == "[" + name + "]") {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// body_binds_bare_var reports whether `stmts` declares a local whose type is a
// still-erased type variable, or assigns to a parameter typed as one — the two
// bindings clause (d) of the promotion loop fires on.
function body_binds_bare_var(stmts: ast.Stmt[], params: ast.ParamDecl[], tps: string[], bounded: string[]): boolean {
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (util.index_of_str(tps, v.type_name) >= 0 && util.index_of_str(bounded, v.type_name) < 0) {
          return true;
        }
      },
      ast.StmtAssign(a) => {
        let pi: i32 = 0;
        while (pi < params.len()) {
          if (params[pi].name == a.target && util.index_of_str(tps, params[pi].type_name) >= 0
            && util.index_of_str(bounded, params[pi].type_name) < 0) {
            return true;
          }
          pi = pi + 1;
        }
      },
      ast.StmtIf(f) => {
        if (body_binds_bare_var(f.then_body, params, tps, bounded)) {
          return true;
        }
        if (body_binds_bare_var(f.else_body, params, tps, bounded)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_binds_bare_var(w.body, params, tps, bounded)) {
          return true;
        }
      },
      ast.StmtFor(fr) => {
        if (body_binds_bare_var(fr.body, params, tps, bounded)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (body_binds_bare_var(arm.body, params, tps, bounded)) {
            return true;
          }
        }
      },
      ast.StmtDefer(d) => {
        let one: ast.Stmt[] = [d.action];
        if (body_binds_bare_var(one, params, tps, bounded)) {
          return true;
        }
      },
      _ => {}
    }
  }
  return false;
}

function erased_only(tps: string[], bounded: string[]): string[] {
  let out: string[] = [];
  for t in tps {
    if (util.index_of_str(bounded, t) < 0) {
      out = out.append(t);
    }
  }
  return out;
}

struct ParScan { vars: string[], hit: boolean }

// body_feeds_user_parametric reports whether any type the body spells feeds one
// of `vars` to a user generic type — feeds_user_parametric over every annotation,
// struct literal, zero value, lambda signature and explicit type argument.
function body_feeds_user_parametric(stmts: ast.Stmt[], vars: string[]): boolean {
  if (vars.len() == 0) {
    return false;
  }
  let scan: ParScan = ParScan { vars: vars, hit: false };
  for st in stmts {
    scan = astwalk.fold_stmt_nodes(st, scan, par_scan_stmt, par_scan_expr, astwalk.descend_all);
  }
  return scan.hit;
}

function spelled_feeds(t: string, vars: string[]): boolean {
  for v in vars {
    if (feeds_user_parametric(t, v)) {
      return true;
    }
  }
  return false;
}

function par_scan_stmt(st: ast.Stmt, own acc: ParScan): ParScan {
  if (acc.hit) {
    return acc;
  }
  if let ast.StmtVar(v) = st {
    if (spelled_feeds(v.type_name, acc.vars) || spelled_feeds(v.fn_ret, acc.vars) || spelled_feeds(v.fn_param_types, acc.vars)) {
      return ParScan { ...acc, hit: true };
    }
  }
  return acc;
}

function par_scan_expr(e: ast.Expr, own acc: ParScan): ParScan {
  if (acc.hit) {
    return acc;
  }
  let hit: boolean = false;
  match (e) {
    ast.ExprStructLit(sl) => {
      hit = spelled_feeds(sl.type_name, acc.vars) || spelled_feeds(sl.written, acc.vars);
    },
    ast.ExprZero(z) => {
      hit = spelled_feeds(z.type_name, acc.vars);
    },
    ast.ExprCall(c) => {
      for t in c.type_args {
        if (spelled_feeds(t, acc.vars)) {
          hit = true;
        }
      }
    },
    ast.ExprLambda(lm) => {
      hit = spelled_feeds(lm.ret_type, acc.vars) || spelled_feeds(lm.ret_fn_ret, acc.vars) || spelled_feeds(lm.ret_fn_param_types, acc.vars);
      for lp in lm.params {
        if (spelled_feeds(lp.type_name, acc.vars) || spelled_feeds(lp.fn_ret, acc.vars) || spelled_feeds(lp.fn_param_types, acc.vars)) {
          hit = true;
        }
      }
    },
    _ => {}
  }
  if (hit) {
    return ParScan { ...acc, hit: true };
  }
  return acc;
}

// has_fn_param_arg_var reports whether some fn-typed param declares `name` in an
// ARGUMENT position — the `T` of `keep: (T) => boolean`. parse_decl_type
// coarsens such a param to the flat "fn" tag and keeps the real spelling in the
// sidecars, which is why token_at_paren_depth0 cannot see it: it scans
// `type_name`, and there the position does not exist.
// all_fn_param_bound reports whether EVERY let in `tps` is reachable through
// some fn-typed param — in an argument position or as its declared result. It
// is the no-stranded-sibling test for clause (c-fn): promoting a set this holds
// of leaves nothing erased behind, the same argument clause (c′) makes for the
// two-var Result shape.
function all_fn_param_bound(params: ast.ParamDecl[], tps: string[]): boolean {
  let i: i32 = 0;
  while (i < tps.len()) {
    if (!has_fn_param_arg_var(params, tps[i]) && !has_fn_param_ret_var(params, tps[i])) {
      return false;
    }
    i = i + 1;
  }
  return tps.len() > 0;
}

// has_fn_param_ret_var is the result-position sibling of has_fn_param_arg_var:
// the `U` of `f: (T) => U` or `f: (T) => U[]` (flat_map's shape), which
// parse_decl_type keeps in the fn_ret sidecar.
function has_fn_param_ret_var(params: ast.ParamDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < params.len()) {
    if (is_fn_contract_tag(params[i].type_name) && type_mentions_var(params[i].fn_ret, name)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function has_fn_param_arg_var(params: ast.ParamDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < params.len()) {
    if (is_fn_contract_tag(params[i].type_name) && params[i].fn_param_types.len() > 0) {
      for seg in split_top_commas(params[i].fn_param_types) {
        if (token_at_paren_depth0(strip_ws(seg), name)) {
          return true;
        }
      }
    }
    i = i + 1;
  }
  return false;
}

function has_bare_scalar_param(params: ast.ParamDecl[], name: string): boolean {
  let i: i32 = 0;
  while (i < params.len()) {
    if (params[i].type_name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// has_any_bare_scalar_param reports whether SOME param's type is EXACTLY one of
// the given type params — the bare-scalar param that carries a wide i64/f64 value
// into an erased-generic call (the trigger for the wasm box-layout ambiguity).
// The two-typevar sibling of has_bare_scalar_param (used by result_two_bare_vars'
// promotion clause, where either of the pair may be the wide-carrying param).
function has_any_bare_scalar_param(params: ast.ParamDecl[], tps: string[]): boolean {
  let i: i32 = 0;
  while (i < tps.len()) {
    if (has_bare_scalar_param(params, tps[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// strip_ws trims ASCII spaces/tabs off both ends of `s` — used to normalise a
// split type-arg (`Result[T, E]`'s second arg is ` E` before trimming).
function strip_ws(s: string): string {
  let a: i32 = 0;
  let b: i32 = s.len();
  while (a < b && (s[a] == b' ' || s[a] == b'\t')) {
    a = a + 1;
  }
  while (b > a && (s[b - 1] == b' ' || s[b - 1] == b'\t')) {
    b = b - 1;
  }
  return slice_unchecked(s, a, b) + "";
}

// result_two_bare_vars reports whether `ret_type` is exactly `Result[A, B]` whose
// two top-level args are the function's two unbounded type params, in either order
// — the `okg[T, E](x: T): Result[T, E]` shape. Requires BARE let args: a nested
// `Result[Option[T], E]` arg is not a bare var name and so does not match, which
// is what guarantees the clone is fully concrete once both vars bind (T from the
// scalar arg, E from the call-site annotation). This is the two-var closer for the
// erased-wide Result gap that the all_tps.len() == 1 clause (c) deliberately left open.
function result_two_bare_vars(ret_type: string, unbounded_tps: string[]): boolean {
  if (unbounded_tps.len() != 2) {
    return false;
  }
  let n: i32 = ret_type.len();
  if (n < 9 || slice_unchecked(ret_type, 0, 7) != "Result[" || ret_type[n - 1] != b']') {
    return false;
  }
  let inner: string = slice_unchecked(ret_type, 7, n - 1) + "";
  let depth: i32 = 0;
  let ci: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < inner.len() && ci < 0) {
    let c: u8 = inner[i];
    if (c == b'[') {
      depth = depth + 1;
    } else if (c == b']') {
      depth = depth - 1;
    } else if (c == b',' && depth == 0) {  // at the top level
      ci = i;
    }
    i = i + 1;
  }
  if (ci < 0) {
    return false;
  }
  let a: string = strip_ws(slice_unchecked(inner, 0, ci) + "");
  let b: string = strip_ws(slice_unchecked(inner, ci + 1, inner.len()) + "");
  let t0: string = unbounded_tps[0];
  let t1: string = unbounded_tps[1];
  return a == t0 && b == t1 || a == t1 && b == t0;
}

// token_at_paren_depth0 reports whether `name` appears as a standalone
// identifier token at PAREN nesting depth 0 in `ty` — the positions a param
// type lets `bind_unify` recover a type param from a call argument (`T`,
// `T[]`, `Box[T]`; brackets `[]` are unified, so they don't gate). A token
// inside `(`…`)` (a function-type or tuple param like `(T) => boolean`) is NOT
// reached by bind_unify, so it does not make the param bind the type variable.
function token_at_paren_depth0(ty: string, name: string): boolean {
  let pdepth: i32 = 0;
  let i: i32 = 0;
  let nl: i32 = name.len();
  if (nl == 0) {
    return false;
  }
  while (i < ty.len()) {
    let c: i32 = ty[i] as i32;
    if (c == 40) {  // '('
      pdepth = pdepth + 1;
      i = i + 1;
      continue;
    }
    if (c == 41) {  // ')'
      pdepth = pdepth - 1;
      i = i + 1;
      continue;
    }
    if (pdepth == 0 && i + nl <= ty.len() && slice_unchecked(ty, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + nl < ty.len() && ident_byte(ty[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

// token_in_tuple_param reports whether `name` appears as a standalone token
// inside a TUPLE (or tuple-array) parameter type — `(K, V)` / `(K, V)[]`. A
// function type `(T) => U` ends at its result (not `)`), so the start-`(`/end-
// `)` shape check excludes it. bind_unify now destructures tuple parens, so a
// var in this position binds from the call argument — the tuple sibling of
// token_at_paren_depth0. Over-broadness is safe: if bind_unify can't recover the
// var, infer_inst leaves it unbound and the call simply stays generic.
function token_in_tuple_param(ty: string, name: string): boolean {
  if (name.len() == 0) {
    return false;
  }
  let t: string = ty;
  while (type_ends_arr(t)) {  // strip array markers
    t = slice_unchecked(t, 0, t.len() - 2) + "";
  }
  if (t.len() < 2 || slice_unchecked(t, 0, 1) != "(" || slice_unchecked(t, t.len() - 1, t.len()) != ")") {
    return false;
  }
  let inner: str = slice_unchecked(t, 1, t.len() - 1);
  let i: i32 = 0;
  let nl: i32 = name.len();
  while (i < inner.len()) {
    if (i + nl <= inner.len() && slice_unchecked(inner, i, i + nl) == name) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(inner[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + nl < inner.len() && ident_byte(inner[i + nl] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

// replace_struct_ident rewrites every standalone `from` identifier token in a
// type string to `to` (identifier-boundary aware, like subst_self). Used to
// normalise a finalize-baked BARE struct name (`ArrayIter`, the source spelling
// substituted into a generic impl method's `Self` positions at parse time)
// back to the module-prefixed registered name (`iter__ArrayIter`) BEFORE the
// struct monomorphiser mangles it — otherwise mg_ty cannot match the bare base
// against the prefixed gstructs entry and the clone's return/param type keeps a
// dangling `ArrayIter[i32]` that never lowers. The boundary check skips the
// `ArrayIter` inside an already-prefixed `iter__ArrayIter` (preceded by `_`).
function replace_struct_ident(ty: string, from: string, to: string): string {
  return replace_ident(ty, from, to, false);
}

// replace_ident is replace_struct_ident's walk; `bare_only` leaves an
// occurrence applied to type arguments (`from[...]`) alone.
function replace_ident(ty: string, from: string, to: string, bare_only: boolean): string {
  if (ty.len() == 0 || from.len() == 0 || from == to) {
    return ty;
  }
  let out: string = "";
  let i: i32 = 0;
  let fl: i32 = from.len();
  while (i < ty.len()) {
    if (i + fl <= ty.len() && slice_unchecked(ty, i, i + fl) == from) {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + fl < ty.len() && (ident_byte(ty[i + fl] as i32) || bare_only && ty[i + fl] == b'[')) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        out = out + to;
        i = i + fl;
        continue;
      }
    }
    out = out + slice_unchecked(ty, i, i + 1);
    i = i + 1;
  }
  return out;
}

// subst_self rewrites every standalone `Self` token in a type string to
// impl_type, INCLUDING nested (Option[(T, Self)] -> Option[(T, ArrayIter[T])]).
// pub so the checker's E021 signature comparison (#4347) can apply the SAME
// substitution to a trait's required signature that finalize_impl_method
// applied to the impl method — a consistent rewrite means a conforming impl
// compares equal while a genuine arity / type mismatch surfaces.
pub function subst_self(ty: string, impl_type: string): string {
  if (ty.len() == 0) {
    return ty;
  }
  let out: string = "";
  let i: i32 = 0;
  while (i < ty.len()) {
    if (i + 4 <= ty.len() && slice_unchecked(ty, i, i + 4) == "Self") {
      let prev_ok: boolean = true;
      if (i > 0 && ident_byte(ty[i - 1] as i32)) {
        prev_ok = false;
      }
      let next_ok: boolean = true;
      if (i + 4 < ty.len() && ident_byte(ty[i + 4] as i32)) {
        next_ok = false;
      }
      if (prev_ok && next_ok) {
        out = out + impl_type;
        i = i + 4;
        continue;
      }
    }
    out = out + slice_unchecked(ty, i, i + 1);
    i = i + 1;
  }
  return out;
}

pub function finalize_impl_method(m: FuncDecl, impl_type: string, impl_tps: string[], impl_tbs: string[]): FuncDecl {
  let rt: string = subst_self(m.ret_type, impl_type);
  let mtps: string[] = m.type_params;
  // bound_traits is allowed to run short of type_params — a promoted unbounded
  // param contributes no entry — so pad before appending, or the impl's bounds
  // land on the method's own type params.
  let mtbs: string[] = m.bound_traits;
  while (mtbs.len() < m.type_params.len()) {
    mtbs = mtbs.append("");
  }
  let ti: i32 = 0;
  while (ti < impl_tps.len()) {
    mtps = mtps.append(impl_tps[ti]);
    mtbs = mtbs.append(impl_tbs[ti]);
    ti = ti + 1;
  }
  let has_self: boolean = false;
  if (m.params.len() > 0) {
    // An untyped `self` stays a parameter, for check_decl_names to refuse.
    if (m.params[0].name == "self" && m.params[0].type_name.len() > 0) {
      has_self = true;
    }
  }
  if (!has_self) {
    // Associated function: keep ALL params (none is a receiver),
    // rewrite `Self` -> impl_type across them, emit with empty receiver.
    let aparams: ast.ParamDecl[] = [];
    let ai: i32 = 0;
    while (ai < m.params.len()) {
      let apt: string = m.params[ai].type_name;
      apt = subst_self(apt, impl_type);
      aparams = aparams.append(ast.ParamDecl { name: m.params[ai].name, type_name: apt, own: m.params[ai].own, has_default: m.params[ai].has_default, default_value: m.params[ai].default_value, fn_ret: m.params[ai].fn_ret, fn_param_types: m.params[ai].fn_param_types });
      ai = ai + 1;
    }
    return FuncDecl { ...m, receiver_name: "", receiver_type: impl_type, type_params: mtps, bound_traits: mtbs, params: aparams, ret_type: rt };
  }
  // Receiver method: peel the first param (`self`) into the receiver
  // and rewrite `Self` -> impl_type across the remaining params.
  let rname: string = "self";
  let newparams: ast.ParamDecl[] = [];
  let i: i32 = 0;
  while (i < m.params.len()) {
    if (i == 0) {
      rname = m.params[i].name;
    } else {
      let pt: string = m.params[i].type_name;
      pt = subst_self(pt, impl_type);
      newparams = newparams.append(ast.ParamDecl { name: m.params[i].name, type_name: pt, own: m.params[i].own, has_default: m.params[i].has_default, default_value: m.params[i].default_value, fn_ret: m.params[i].fn_ret, fn_param_types: m.params[i].fn_param_types });
    }
    i = i + 1;
  }
  return FuncDecl { ...m, receiver_name: rname, receiver_type: impl_type, receiver_own: m.params[0].own, type_params: mtps, bound_traits: mtbs, params: newparams, ret_type: rt };
}

// parse_trait_decl consumes a `trait Name { <method>; … }` block. The
// self-host doesn't validate conformance (dispatch is by receiver type),
// so abstract signatures carry no weight and are dropped — but a method
// with a `{ … }` DEFAULT body is retained: parse_module synthesises a
// copy onto every impl of the trait that omits it (Self-host parity with
// the Go checker's synthesizeTraitDefaults — see docs/TRAITS.md). Each
// method parses with the ordinary parse_func_decl machinery (no receiver
// clause; its first parameter is `self: Self`); an abstract one ends at
// `;` and so comes back with an empty body, which we skip.
function parse_trait_decl(p: Par): (TraitDefault[], TraitReq, TraitDecl, ast.Stmt[], Par) {
  let defaults: TraitDefault[] = [];
  let trait_bad: ast.Stmt[] = [];
  let required: string[] = [];
  let required_sigs: FuncDecl[] = [];
  let assoc_sigs: FuncDecl[] = [];
  let provided: string[] = [];
  let default_sigs: FuncDecl[] = [];
  let supertraits: string[] = [];
  // The written form, for the formatter: every method in source order (an
  // empty body marks an abstract one), the supertraits with any `mod.`
  // qualifier intact, and the decl's own position.
  let decl_methods: FuncDecl[] = [];
  let decl_supers: string[] = [];
  // Associated types declared by the trait (`type Item;`), referenced in
  // method signatures as `Self::Item` and bound by each impl with
  // `type Item = …`. See docs/ASSOCIATED-TYPES.md.
  let assoc_types: string[] = [];
  let tline: i32 = p.peek_line();
  let tcol: i32 = p.peek_col();
  p = p.advance();  // `trait`
  let tname: string = p.peek_ident();
  if (tname.len() > 0) {  // name
    p = p.advance();
  }
  let simple: string = derive_simple_name(tname);
  // Optional generic type parameters: `trait Greet[T] { … }`. Native
  // parses these via parseTypeParamList; the self-host erases traits
  // (dispatch is by receiver type) and monomorphises a default method
  // through the IMPL's type params in finalize_impl_method, so the
  // trait's declared params carry no weight — but they MUST be consumed
  // here or `[T]` and the trait body spill back into parse_module as a
  // stray array literal + orphan block, losing default methods (#4340).
  // Consumed through the shared list parser, which also keeps the names for
  // the formatter — printing the block without them leaves every `T` in the
  // method signatures unbound.
  let (trait_tps, trait_tp_p) = parse_type_param_list(p);
  p = trait_tp_p;
  // Optional supertrait clause `: Trait (+ Trait)*` (each possibly
  // `mod.Trait`). Dispatch is still by receiver type, but the supertrait
  // NAMES are retained for the E021 conformance check (#4347): an
  // `impl B for T` where `trait B: A` also requires an `impl A for T`.
  // See docs/TRAITS.md.
  if (p.peek_punct() == ":") {
    p = p.advance();
    let go_sup: boolean = true;
    while (go_sup && !p.at_end()) {
      let sup_name: string = "";
      let sup_written: string = "";
      if (p.peek_ident().len() > 0) {
        sup_name = p.peek_ident();
        sup_written = sup_name;
        p = p.advance();
      }
      if (p.at_path_sep()) {
        p = p.advance();
        if (p.peek_ident().len() > 0) {
          sup_name = p.peek_ident();
          sup_written = sup_written + "." + sup_name;
          p = p.advance();
        }
      }
      if (sup_name.len() > 0) {
        supertraits = supertraits.append(derive_simple_name(sup_name));
        decl_supers = decl_supers.append(sup_written);
      }
      if (p.peek_punct() == "+") {
        p = p.advance();
      } else {
        go_sup = false;
      }
    }
  }
  if (p.peek_punct() == "{") {
    p = p.advance();
    while (!p.at_end()) {
      if (p.peek_punct() == "}") {
        break;
      }
      if (p.peek_keyword() == "type") {
        p = p.advance();
        let at_name: string = p.peek_ident();
        if (at_name.len() > 0) {
          p = p.advance();
          assoc_types = assoc_types.append(at_name);
        } else {
          trait_bad = trait_bad.append(decl_sentinel(p, "malformed associated type declaration: its name could not be read (a keyword such as `type` or `match` cannot be a name)"));
        }
        if (p.peek_punct() == ";") {
          p = p.advance();
        }
        continue;
      }
      if (p.peek_keyword() == "function") {
        let (fr_func, fr_p) = parse_func_decl(p);
        p = fr_p;
        // check_decl_names reports the nameless method; the rest of its
        // signature is skipped so it does not read as stray tokens.
        if (fr_func.name.len() == 0) {
          p = skip_body_item(p);
        }
        decl_methods = decl_methods.append(fr_func);
        provided = provided.append(fr_func.name);
        if (fr_func.params.len() == 0 || fr_func.params[0].name != "self") {
          assoc_sigs = assoc_sigs.append(fr_func);
        }
        // A non-empty body marks a default method. (An empty `{}`
        // body is indistinguishable from an abstract `;` here and
        // is treated as abstract — it would synthesise a no-op.)
        if (fr_func.body.len() > 0) {
          defaults = defaults.append(TraitDefault { trait_name: simple, method: fr_func });
          default_sigs = default_sigs.append(FuncDecl { ...fr_func, body: [] });
        } else {
          // Abstract (body-less) signature: a REQUIRED method every
          // impl must provide (#4347 E021). Bodied defaults above are
          // NOT required (synthesised onto omitting impls). The full
          // decl is kept in req_sigs (parallel to required) for the
          // signature-mismatch check.
          required = required.append(fr_func.name);
          required_sigs = required_sigs.append(fr_func);
        }
      } else {
        trait_bad = trait_bad.append(decl_sentinel(p, "unexpected token in a trait body: expected `function` or `type`"));
        p = skip_body_item(p.advance());
      }
    }
    if (p.peek_punct() == "}") {
      p = p.advance();
    }
  }
  return (defaults, TraitReq { trait_name: simple, methods: required, req_sigs: required_sigs, supertraits: supertraits, assoc_sigs: assoc_sigs, provided: provided, assoc_types: assoc_types, module: "", default_sigs: default_sigs }, TraitDecl { name: tname, type_params: trait_tps.tnames, supertraits: decl_supers, methods: decl_methods, line: tline, col: tcol, is_pub: false, assoc_types: assoc_types, is_package: false }, trait_bad, p);
}

// skip_decl_modifier consumes a contextual declaration modifier `name`
// when it sits directly before the keyword `before` (`async` before
// `function`, `opaque` before `struct`) and returns the cursor past it.
// Anywhere else the cursor comes back untouched, so both names stay usable
// as ordinary identifiers — the rule the native parser uses. Callers
// compare `.pos` to tell a match from a miss.
function skip_decl_modifier(p: Par, name: string, before: string): Par {
  if (p.peek_ident() != name) {
    return p;
  }
  let probe: Par = p.advance();
  if (probe.peek_keyword() != before) {
    return p;
  }
  return probe;
}

// ============ numeric-literal settling (#6654) ============
//
// An integer literal written in a float position — `let x: f64 = 1;` — is an
// UNSETTLED literal, not an i32: the destination decides its type. The native
// checker resolves that with `settleNumeric`, which restamps the literal AST
// node against the declared type before any comparison happens.
//
// The self-host had no counterpart, and the cost landed twice: the checker read
// the literal as i32 and rejected seven ordinary shapes native accepts, and the
// IR lowerer — which re-infers float-ness bottom-up from the expression, with no
// destination hint — emitted an INTEGER constant into the float slot, so the
// same programs computed wrong answers wherever they were not rejected first.
//
// Settling on the AST fixes both at once: `is_float` is what `check_expr` and
// every `expr_is_f64` predicate read, so restamping the literal here means
// neither has to learn about destinations. It runs at the shared parse entry,
// the resolve_labels_module precedent, so every driver and backend sees settled
// literals without opting in.
//
// SCOPE: same-module destinations. Imports are unresolved at parse time, so a
// float parameter or field declared in ANOTHER module is not settled against —
// that shape still behaves as it did before this pass existed.

// is_float_type_name reports whether a declared type name denotes a float
// scalar. `float` is the unsuffixed spelling; f32 is f64-shaped downstream.
function is_float_type_name(t: string): boolean {
  return t == "f64" || t == "f32" || t == "float";
}

// is_unsettled_int_literal reports whether `e` is an integer literal whose type
// the destination is still free to choose — a bare `1`, or a unary `-`/`+` or a
// binary `+ - * /` built ONLY from such literals.
//
// The "only" is essential. Native settles a binary just once, before its
// float width is known, so a subtree that ALREADY carries a float is left
// alone: `let f: f64 = 1 + 2.5;` is E009 there, not a silent widening of the
// i32 operand. A literal with an explicit integer suffix (`1i64`) is settled
// already and is likewise not a candidate.
function is_unsettled_int_literal(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return !n.is_float && n.suffix.len() == 0 && !is_unit_literal(n);
    },
    ast.ExprUnary(u) => {
      if (u.op != "-" && u.op != "+") {
        return false;
      }
      return is_unsettled_int_literal(u.operand);
    },
    ast.ExprBinary(b) => {
      if (b.op != "+" && b.op != "-" && b.op != "*" && b.op != "/") {
        return false;
      }
      return is_unsettled_int_literal(b.left) && is_unsettled_int_literal(b.right);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// settle_float_expr stamps `is_float` across an unsettled integer literal
// standing in a float destination, and fans the same settle into the branches of
// a value-position if / match (#6679) — native's settleFloat has `*ast.IfExpr` /
// `*ast.MatchExpr` / `*ast.BlockExpr` arms doing exactly that.
//
// Every other expression — including a mixed `1 + 2.5` and an i32 local — comes
// back untouched, so it still draws the error native gives it.
function settle_float_expr(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprCall(_) => {
      return settle_float_value_branches(e);
    },
    _ => {}
  }
  if (!is_unsettled_int_literal(e)) {
    return e;
  }
  match (e) {
    ast.ExprNumber(n) => {
      return ast.ExprNumber { text: n.text, suffix: n.suffix, raw: n.raw, is_float: true, line: n.line, col: n.col };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: settle_float_expr(u.operand), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: settle_float_expr(b.left), right: settle_float_expr(b.right), line: b.line, col: b.col, ty: b.ty };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// A value-position if / match is desugared by the parser into an immediately-
// invoked closure — `((): RT => { … })()` — with RT read off the arms, so
// the literal in `let x: f64 = if (c) { 1 } else { 2 }` sits one level below the
// destination with nothing to settle against. Settling the BRANCHES is enough
// for both readers: the checker types the arms, and the lowering reads
// the IIFE's float-ness off its first branch's returned value.
//
// The settle is all-or-nothing across the branches. For a branch whose type this
// pass cannot see (an i32 local, a call) the untouched tree is returned, because
// settling only SOME arms is worse than settling none: expr_is_f64 classifies
// the whole IIFE by the first branch, so a float first arm beside an i32 second
// arm reads that arm's integer bits as a double. Left alone, the checker's
// E003 / E031 names the problem instead.

// settled_branch_value returns a value branch's result — its body's trailing
// `return E`, which is where parse_branch_body puts a branch's value (native's
// BlockExpr tail) — with a flag for a body that yields none.
function settled_branch_value(body: ast.Stmt[]): (ast.Expr, boolean) {
  if (body.len() > 0) {
    match (body[body.len() - 1]) {
      ast.StmtReturn(r) => {
        return (r.value, true);
      },
      _ => {}
    }
  }
  return (ast.ExprUnknown { kind: "no-branch-value", line: 0, col: 0 }, false);
}

// float_settleable reports whether a branch result can stand in a float slot
// without a type the parser cannot see: an unsettled integer literal (which
// this pass stamps), a literal that is already float, or a nested value-position
// if/match whose own branches are settleable — `if (c) { if (d) { 1 } else { 2 } }
// else { 3 }`, which native reaches by recursing settleFloat through the arms.
function float_settleable(e: ast.Expr): boolean {
  if (is_unsettled_int_literal(e)) {
    return true;
  }
  match (e) {
    ast.ExprNumber(n) => {
      return n.is_float;
    },
    ast.ExprUnary(u) => {
      if (u.op != "-" && u.op != "+") {
        return false;
      }
      return float_settleable(u.operand);
    },
    ast.ExprBinary(b) => {
      if (b.op != "+" && b.op != "-" && b.op != "*" && b.op != "/") {
        return false;
      }
      return float_settleable(b.left) && float_settleable(b.right);
    },
    ast.ExprCall(_) => {
      return value_branches_float_settleable(e);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// value_branches_float_settleable reports whether `e` is the desugared value
// if/match AND every one of its branches is settleable.
function value_branches_float_settleable(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return false;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 0 || lm.body.len() != 1) {
            return false;
          }
          match (lm.body[0]) {
            ast.StmtIf(f) => {
              return if_branches_float_settleable(f);
            },
            ast.StmtMatch(m) => {
              return match_arms_float_settleable(m);
            },
            _ => {
              return false;
            }
          }
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// settle_branch_body rebuilds a branch body with its trailing return value
// settled, leaving any leading statements alone.
function settle_branch_body(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < body.len()) {
    let keep: ast.Stmt = body[i];
    if (i == body.len() - 1) {
      match (body[i]) {
        ast.StmtReturn(r) => {
          keep = s_return_at(settle_float_expr(r.value), r.line, r.col);
        },
        _ => {}
      }
    }
    out = out.append(keep);
    i = i + 1;
  }
  return out;
}

// if_branches_float_settleable / settle_if_branches walk an if (and its
// `else if` chain, which is an else body holding one StmtIf). An if with no
// else yields no value and is left alone.
function if_branches_float_settleable(f: ast.StmtIf): boolean {
  let (tv, t_ok) = settled_branch_value(f.then_body);
  if (!t_ok || !float_settleable(tv)) {
    return false;
  }
  if (f.else_body.len() == 1) {
    match (f.else_body[0]) {
      ast.StmtIf(nf) => {
        return if_branches_float_settleable(nf);
      },
      _ => {}
    }
  }
  let (ev, e_ok) = settled_branch_value(f.else_body);
  return e_ok && float_settleable(ev);
}

function settle_if_branches(f: ast.StmtIf): ast.Stmt {
  let nelse: ast.Stmt[] = [];
  let chained: boolean = false;
  if (f.else_body.len() == 1) {
    match (f.else_body[0]) {
      ast.StmtIf(nf) => {
        nelse = nelse.append(settle_if_branches(nf));
        chained = true;
      },
      _ => {}
    }
  }
  if (!chained) {
    nelse = settle_branch_body(f.else_body);
  }
  return s_if(f.cond, settle_branch_body(f.then_body), nelse);
}

function match_arms_float_settleable(m: ast.StmtMatch): boolean {
  if (m.arms.len() == 0) {
    return false;
  }
  let a: i32 = 0;
  while (a < m.arms.len()) {
    let (av, a_ok) = settled_branch_value(m.arms[a].body);
    if (!a_ok || !float_settleable(av)) {
      return false;
    }
    a = a + 1;
  }
  return true;
}

function settle_match_arms(m: ast.StmtMatch): ast.Stmt {
  let arms: ast.MatchArm[] = [];
  let a: i32 = 0;
  while (a < m.arms.len()) {
    arms = arms.append(ast.MatchArm { pattern: m.arms[a].pattern, body: settle_branch_body(m.arms[a].body), line: m.arms[a].line, col: m.arms[a].col, guard: m.arms[a].guard, has_guard: m.arms[a].has_guard, alt_cont: false });
    a = a + 1;
  }
  return s_match_origin(m.scrutinee, arms, m.line, m.col, m.origin);
}

// settle_float_value_branches settles the desugared value if/match — a 0-arg
// call of a 0-param lambda whose body is a single StmtIf / StmtMatch, the shape
// the E031 pass and the lowering both key on. Anything else, and any
// branch set that is not wholly settleable, comes back untouched.
function settle_float_value_branches(e: ast.Expr): ast.Expr {
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() != 0) {
        return e;
      }
      match (c.callee) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 0 || lm.body.len() != 1) {
            return e;
          }
          if (!value_branches_float_settleable(e)) {
            return e;
          }
          let nbody: ast.Stmt[] = [];
          match (lm.body[0]) {
            ast.StmtIf(f) => {
              nbody = nbody.append(settle_if_branches(f));
            },
            ast.StmtMatch(m) => {
              nbody = nbody.append(settle_match_arms(m));
            },
            _ => {
              return e;
            }
          }
          if (nbody.len() == 0) {
            return e;
          }
          let nlam: ast.Expr = ast.ExprLambda { ...lm, body: nbody };
          return ast.ExprCall { callee: nlam, args: c.args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
        },
        _ => {
          return e;
        }
      }
    },
    _ => {}
  }
  return e;
}

// settle_to_type settles `e` against the destination type `t`: a float scalar
// settles the expression, an array settles each element of an array literal,
// a tuple settles each element of a tuple literal. Any other destination — and
// any expression that is not the matching literal form — is returned untouched.
function settle_to_type(e: ast.Expr, t: TypeRef): ast.Expr {
  if (t.array_depth > 0) {
    let inner: TypeRef = elem_type_ref(t);
    match (e) {
      ast.ExprArray(a) => {
        let els: ast.Expr[] = [];
        let ei: i32 = 0;
        while (ei < a.elements.len()) {
          els = els.append(settle_to_type(a.elements[ei], inner));
          ei = ei + 1;
        }
        // Stamp the destination's element type on the literal: this is
        // the array's LAYOUT (slot width / stride), and reading it off
        // the first element's expression shape mis-sized `[1, 2]` in an
        // i64[] destination to a 4-byte stride on wasm (#4366). Native
        // stamps the same fact as ast.ArrayLit.ElemType.
        return ast.ExprArray { ...a, elements: els, elem_ty: render_type_ref(inner) };
      },
      _ => {
        return e;
      }
    }
    return e;
  }
  if (t.is_tuple) {
    match (e) {
      ast.ExprTuple(tu) => {
        let tels: ast.Expr[] = [];
        let ti: i32 = 0;
        while (ti < tu.elements.len()) {
          if (ti < t.args.len()) {
            tels = tels.append(settle_to_type(tu.elements[ti], t.args[ti]));
          } else {
            tels = tels.append(tu.elements[ti]);
          }
          ti = ti + 1;
        }
        return ast.ExprTuple { elements: tels, line: tu.line, col: tu.col };
      },
      _ => {
        return e;
      }
    }
    return e;
  }
  if (is_float_type_name(t.base)) {
    return settle_float_expr(e);
  }
  return e;
}

// settle_to_name is settle_to_type against a declared type NAME, the spelling
// every decl in the AST carries. An empty name is "no annotation" and settles
// nothing.
pub function settle_to_name(e: ast.Expr, type_name: string): ast.Expr {
  if (type_name.len() == 0) {
    return e;
  }
  return settle_to_type(e, parse_type_ref(type_name));
}

// Destination lookups over the module's own declarations. A call to a function
// this module does not declare, or a literal of a struct it does not declare,
// finds nothing and settles nothing.

// SettleFns is the module's function decls with a name index over them — the
// MFns idiom for this pass, whose destination lookup below runs once per call
// expression in the module and scanned every decl each time. The index travels
// with the decls so the two cannot be built from different arrays.
struct SettleFns {
  decls: FuncDecl[],
  // head[b] is the first decl in bucket b (-1 when empty); next[i] chains to
  // the next decl in the same bucket, ascending, so a chain walk answers with
  // the decl the scan reached first.
  head: i32[],
  next: i32[],
}

// settle_buckets is the index's bucket count: prime, and sized to the ~4,700
// decls of a whole-compiler module rather than mfns_buckets' generic few.
function settle_buckets(): i32 {
  return 4093;
}

function settle_fns_of(decls: FuncDecl[]): SettleFns {
  let head: i32[] = [];
  let b: i32 = 0;
  let nb: i32 = settle_buckets();
  while (b < nb) {
    head = head.append(0 - 1);
    b = b + 1;
  }
  let next: i32[] = [];
  let j: i32 = 0;
  while (j < decls.len()) {
    next = next.append(0 - 1);
    j = j + 1;
  }
  let k: i32 = decls.len() - 1;
  while (k >= 0) {
    let bk: i32 = util.hash_bucket(decls[k].name, nb);
    next = next.with(k, head[bk]);
    head = head.with(bk, k);
    k = k - 1;
  }
  return SettleFns { decls: decls, head: head, next: next };
}

// settle_param_type_names lists a decl's declared parameter type names.
function settle_param_type_names(f: FuncDecl): string[] {
  let out: string[] = [];
  let pi: i32 = 0;
  while (pi < f.params.len()) {
    out = out.append(f.params[pi].type_name);
    pi = pi + 1;
  }
  return out;
}

// settle_param_types returns the declared parameter type names of the
// receiver-less function `name`, or an empty list when there is no such function.
function settle_param_types(fns: SettleFns, name: string): string[] {
  let i: i32 = fns.head[util.hash_bucket(name, settle_buckets())];
  while (i >= 0) {
    let f: FuncDecl = fns.decls[i];
    if (f.name == name && f.receiver_name.len() == 0) {
      return settle_param_type_names(f);
    }
    i = fns.next[i];
  }
  return [];
}

// settle_method_param_types returns the declared parameter type names of the
// method `name` on receiver type `recv_type`, or an empty list when the receiver
// type is unknown ("") or declares no such method.
function settle_method_param_types(fns: SettleFns, recv_type: string, name: string): string[] {
  if (recv_type.len() == 0) {
    return [];
  }
  let i: i32 = fns.head[util.hash_bucket(name, settle_buckets())];
  while (i >= 0) {
    let f: FuncDecl = fns.decls[i];
    if (f.name == name && f.receiver_type == recv_type) {
      return settle_param_type_names(f);
    }
    i = fns.next[i];
  }
  return [];
}

// settle_field_type returns the declared type name of field `field` on struct
// `type_name`, or "" when either is unknown.
function settle_field_type(structs: StructDecl[], type_name: string, field: string): string {
  let i: i32 = 0;
  while (i < structs.len()) {
    let sd: StructDecl = structs[i];
    if (sd.name == type_name) {
      let fi: i32 = 0;
      while (fi < sd.fields.len()) {
        if (sd.fields[fi].name == field) {
          return sd.fields[fi].type_name;
        }
        fi = fi + 1;
      }
      return "";
    }
    i = i + 1;
  }
  return "";
}

// settle_local_type returns the declared type name bound to local `name` by the
// enclosing scope's annotations (parameters and annotated `let`s), or "".
function settle_local_type(names: string[], types: string[], name: string): string {
  let i: i32 = names.len() - 1;
  while (i >= 0) {
    if (names[i] == name) {
      return types[i];
    }
    i = i - 1;
  }
  return "";
}

// settle_expr rebuilds `e` with every nested destination settled: a call's
// arguments against the callee's declared parameter types, a struct literal's
// field values against the struct's declared field types. Sub-expressions are
// walked so a destination nested anywhere inside is reached.
//
// A METHOD call settles only when the receiver is a local or parameter carrying
// a type ANNOTATION (`names`/`types`) — that spelling names the receiver type
// outright, so the method resolves without the inference this pass does without.
// An inferred receiver settles nothing, as before.
function settle_expr(e: ast.Expr, names: string[], types: string[], fns: SettleFns, structs: StructDecl[]): ast.Expr {
  match (e) {
    ast.ExprBinary(b) => {
      return ast.ExprBinary { op: b.op, left: settle_expr(b.left, names, types, fns, structs), right: settle_expr(b.right, names, types, fns, structs), line: b.line, col: b.col, ty: b.ty };
    },
    ast.ExprUnary(u) => {
      return ast.ExprUnary { op: u.op, operand: settle_expr(u.operand, names, types, fns, structs), line: u.line, col: u.col, ty: u.ty };
    },
    ast.ExprCall(c) => {
      let ptypes: string[] = [];
      match (c.callee) {
        ast.ExprIdent(id) => {
          ptypes = settle_param_types(fns, id.name);
        },
        ast.ExprFieldAccess(mfa) => {
          match (mfa.obj) {
            ast.ExprIdent(rid) => {
              ptypes = settle_method_param_types(fns, settle_local_type(names, types, rid.name), mfa.field);
            },
            _ => {
              ptypes = [];
            }
          }
        },
        _ => {
          ptypes = [];
        }
      }
      let args: ast.Expr[] = [];
      let ai: i32 = 0;
      while (ai < c.args.len()) {
        let arg: ast.Expr = settle_expr(c.args[ai], names, types, fns, structs);
        if (ai < ptypes.len()) {
          arg = settle_to_name(arg, ptypes[ai]);
        }
        args = args.append(arg);
        ai = ai + 1;
      }
      return ast.ExprCall { callee: settle_expr(c.callee, names, types, fns, structs), args: args, line: c.line, col: c.col, type_args: c.type_args, ty: c.ty };
    },
    ast.ExprArray(a) => {
      let els: ast.Expr[] = [];
      let i: i32 = 0;
      while (i < a.elements.len()) {
        els = els.append(settle_expr(a.elements[i], names, types, fns, structs));
        i = i + 1;
      }
      return ast.ExprArray { ...a, elements: els };
    },
    ast.ExprTuple(t) => {
      let tels: ast.Expr[] = [];
      let ti: i32 = 0;
      while (ti < t.elements.len()) {
        tels = tels.append(settle_expr(t.elements[ti], names, types, fns, structs));
        ti = ti + 1;
      }
      return ast.ExprTuple { elements: tels, line: t.line, col: t.col };
    },
    ast.ExprIndex(x) => {
      return ast.ExprIndex { array: settle_expr(x.array, names, types, fns, structs), index: settle_expr(x.index, names, types, fns, structs), unchecked: x.unchecked, ty: x.ty, line: x.line, col: x.col };
    },
    ast.ExprSlice(sl) => {
      return ast.ExprSlice { ...sl, array: settle_expr(sl.array, names, types, fns, structs), start: settle_expr(sl.start, names, types, fns, structs), end: settle_expr(sl.end, names, types, fns, structs) };
    },
    ast.ExprStructLit(sl) => {
      let vals: ast.Expr[] = [];
      let vi: i32 = 0;
      while (vi < sl.field_values.len()) {
        let v: ast.Expr = settle_expr(sl.field_values[vi], names, types, fns, structs);
        if (vi < sl.field_names.len()) {
          v = settle_to_name(v, settle_field_type(structs, sl.type_name, sl.field_names[vi]));
        }
        vals = vals.append(v);
        vi = vi + 1;
      }
      let base: ast.Expr = sl.base;
      if (sl.has_base) {
        base = settle_expr(sl.base, names, types, fns, structs);
      }
      return ast.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: vals, has_base: sl.has_base, base: base, line: sl.line, col: sl.col, written: sl.written };
    },
    ast.ExprFieldAccess(fa) => {
      return ast.ExprFieldAccess { obj: settle_expr(fa.obj, names, types, fns, structs), field: fa.field, line: fa.line, col: fa.col, ty: fa.ty };
    },
    ast.ExprLambda(lm) => {
      // The body sees the enclosing annotated locals plus the lambda's
      // own params — the scope check_expr and annotate_expr build for a
      // lambda body (checker.fern:7484, :13025). A lambda captures the
      // enclosing binding lexically, so a captured local's annotation is
      // the one that names its type; dropping it leaves a method call on
      // a captured receiver unresolved and its arguments unsettled.
      // Params are appended last, and settle_local_type scans from the
      // end, so a param shadows an enclosing local of the same name.
      let lnames: string[] = names;
      let ltypes: string[] = types;
      let lpi: i32 = 0;
      while (lpi < lm.params.len()) {
        lnames = lnames.append(lm.params[lpi].name);
        ltypes = ltypes.append(lm.params[lpi].type_name);
        lpi = lpi + 1;
      }
      return ast.ExprLambda { ...lm, body: settle_block(lm.body, lm.ret_type, lnames, ltypes, fns, structs) };
    },
    _ => {
      return e;
    }
  }
  return e;
}

// settle_stmt rebuilds `st` with its own destinations settled — an annotated
// `let`'s init, a `return`'s value against `ret_type`, an assignment's value
// against the target local's annotation — and recurses through every statement
// container. `names`/`types` carry the annotated locals in scope.
function settle_stmt(st: ast.Stmt, ret_type: string, names: string[], types: string[], fns: SettleFns, structs: StructDecl[]): ast.Stmt {
  match (st) {
    ast.StmtVar(v) => {
      let init: ast.Expr = settle_to_name(settle_expr(v.init, names, types, fns, structs), v.type_name);
      return ast.StmtVar { name: v.name, type_name: v.type_name, init: init, line: v.line, col: v.col, fn_ret: v.fn_ret, fn_param_types: v.fn_param_types };
    },
    ast.StmtReturn(r) => {
      return ast.StmtReturn { value: settle_to_name(settle_expr(r.value, names, types, fns, structs), ret_type), line: r.line, col: r.col };
    },
    ast.StmtAssign(a) => {
      let val: ast.Expr = settle_to_name(settle_expr(a.value, names, types, fns, structs), settle_local_type(names, types, a.target));
      return ast.StmtAssign { target: a.target, value: val, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
    },
    ast.StmtExpr(x) => {
      return ast.StmtExpr { value: settle_expr(x.value, names, types, fns, structs), line: x.line };
    },
    ast.StmtIf(f) => {
      return ast.StmtIf { ...f, cond: settle_expr(f.cond, names, types, fns, structs), then_body: settle_block(f.then_body, ret_type, names, types, fns, structs), else_body: settle_block(f.else_body, ret_type, names, types, fns, structs) };
    },
    ast.StmtWhile(w) => {
      return ast.StmtWhile { cond: settle_expr(w.cond, names, types, fns, structs), body: settle_block(w.body, ret_type, names, types, fns, structs), label: w.label, line: w.line, is_loop: w.is_loop };
    },
    ast.StmtFor(fr) => {
      return ast.StmtFor { var_name: fr.var_name, iter: settle_expr(fr.iter, names, types, fns, structs), body: settle_block(fr.body, ret_type, names, types, fns, structs), label: fr.label, line: fr.line };
    },
    ast.StmtMatch(m) => {
      let arms: ast.MatchArm[] = [];
      let ai: i32 = 0;
      while (ai < m.arms.len()) {
        let a: ast.MatchArm = m.arms[ai];
        arms = arms.append(ast.MatchArm { ...a, body: settle_block(a.body, ret_type, names, types, fns, structs) });
        ai = ai + 1;
      }
      return ast.StmtMatch { ...m, scrutinee: settle_expr(m.scrutinee, names, types, fns, structs), arms: arms };
    },
    ast.StmtDefer(dd) => {
      return ast.StmtDefer { action: settle_stmt(dd.action, ret_type, names, types, fns, structs), on_error: dd.on_error, line: dd.line };
    },
    _ => {
      return st;
    }
  }
  return st;
}

// settle_block settles a statement list, extending the annotated-local scope as
// each annotated `let` is passed. Shadowing works out because settle_local_type
// scans from the end.
function settle_block(stmts: ast.Stmt[], ret_type: string, names: string[], types: string[], fns: SettleFns, structs: StructDecl[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  let i: i32 = 0;
  while (i < stmts.len()) {
    out = out.append(settle_stmt(stmts[i], ret_type, names, types, fns, structs));
    match (stmts[i]) {
      ast.StmtVar(v) => {
        if (v.type_name.len() > 0) {
          names = names.append(v.name);
          types = types.append(v.type_name);
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return out;
}

// settle_module restamps every unsettled integer literal in `mod` that stands in
// a float destination the module itself declares. Idempotent: a settled literal
// is left alone, so re-running after a merge only settles what the wider
// signature set newly reaches.
pub function settle_module(mod: Module): Module {
  let fns: SettleFns = settle_fns_of(mod.funcs);
  let funcs: FuncDecl[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: FuncDecl = mod.funcs[i];
    let names: string[] = [];
    let types: string[] = [];
    let pi: i32 = 0;
    while (pi < fd.params.len()) {
      names = names.append(fd.params[pi].name);
      types = types.append(fd.params[pi].type_name);
      pi = pi + 1;
    }
    if (fd.receiver_name.len() > 0) {
      names = names.append(fd.receiver_name);
      types = types.append(fd.receiver_type);
    }
    funcs = funcs.append(FuncDecl { ...fd, body: settle_block(fd.body, fd.ret_type, names, types, fns, mod.structs) });
    i = i + 1;
  }
  let nonames: string[] = [];
  return Module { ...mod, funcs: funcs, top_stmts: settle_block(mod.top_stmts, "", nonames, nonames, fns, mod.structs) };
}

// ConstTable is the value each const written without a type stands for, in
// declaration order. Native's constfold keeps such a const's literal untyped
// and substitutes it at every reference, so `const K = 9; let x: i64 = K;`
// reads 9 at i64 as a written literal would; references are replaced by the
// value here for the same reason. A const referenced from another module is
// replaced when flatten merges it, so Module.inferred_consts carries the names.
pub struct ConstTable { names: string[], values: ast.Expr[] }

// inferred_const_table extends `t` with every const in `funcs` written without
// a type, each value already carrying the earlier ones'.
pub function inferred_const_table(funcs: FuncDecl[], names: string[], t: ConstTable): ConstTable {
  let out: ConstTable = t;
  for fd in funcs {
    if (fd.is_const && util.has_str(names, fd.name) && fd.body.len() == 1) {
      if let ast.StmtReturn(r) = fd.body[0] {
        out = ConstTable { names: out.names.append(fd.name), values: out.values.append(astwalk.substitute_consts_expr(r.value, out.names, out.values)) };
      }
    }
  }
  return out;
}

// substitute_const_refs replaces every reference to a const in `t` that no
// local binding shadows. A const's initialiser sees only the consts declared
// before it, so a forward reference stays for the checker's const rule.
pub function substitute_const_refs(mod: Module, t: ConstTable): Module {
  if (t.names.len() == 0) {
    return mod;
  }
  let funcs: FuncDecl[] = [];
  let earlier: string[] = [];
  for fd in mod.funcs {
    if (fd.is_const) {
      let seen: ConstTable = const_table_within(t, earlier);
      funcs = funcs.append(FuncDecl { ...fd, body: astwalk.substitute_consts(fd.body, [], seen.names, seen.values) });
      earlier = earlier.append(fd.name);
      continue;
    }
    let bound: string[] = [];
    let params: ast.ParamDecl[] = [];
    for p in fd.params {
      params = params.append(ast.ParamDecl { ...p, default_value: astwalk.substitute_consts_expr(p.default_value, t.names, t.values) });
      bound = astwalk.append_bound_name(bound, p.name);
    }
    if (fd.receiver_name.len() > 0) {
      bound = bound.append(fd.receiver_name);
    }
    funcs = funcs.append(FuncDecl { ...fd, params: params, body: astwalk.substitute_consts(fd.body, bound, t.names, t.values) });
  }
  return Module { ...mod, funcs: funcs, top_stmts: astwalk.substitute_consts(mod.top_stmts, [], t.names, t.values) };
}

// const_table_within keeps the entries of `t` named in `names`.
function const_table_within(t: ConstTable, names: string[]): ConstTable {
  let out: ConstTable = ConstTable { names: [], values: [] };
  let i: i32 = 0;
  for n in t.names {
    if (util.has_str(names, n)) {
      out = ConstTable { names: out.names.append(n), values: out.values.append(t.values[i]) };
    }
    i = i + 1;
  }
  return out;
}

// unannotated_const_names lists the consts written without a type.
function unannotated_const_names(funcs: FuncDecl[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    if (fd.is_const && fd.ret_type == "") {
      out = out.append(fd.name);
    }
  }
  return out;
}

// settle_const_types gives a `const` written without a type its value's type,
// so its own declaration is typed. Consts settle in declaration order, each one
// visible to the next, so `const B = A * 2` reads A's type. A value it cannot
// type keeps "" and draws E070.
function settle_const_types(funcs: FuncDecl[], structs: StructDecl[]): FuncDecl[] {
  let known: ast.ParamDecl[] = [];
  let out: FuncDecl[] = [];
  for fd in funcs {
    let f: FuncDecl = fd;
    if (f.is_const && f.ret_type == "" && f.body.len() == 1) {
      if let ast.StmtReturn(r) = f.body[0] {
        f = FuncDecl { ...f, ret_type: irt_guess(r.value, known, funcs, structs) };
      }
    }
    if (f.is_const && f.ret_type.len() > 0) {
      known = known.append(ast.ParamDecl { name: f.name, type_name: f.ret_type, own: false, has_default: false, default_value: e_unknown(""), fn_ret: "", fn_param_types: "" });
    }
    out = out.append(f);
  }
  return out;
}

pub function parse_module(toks: lexer.Token[]): Module {
  let (m, t, im, fl, ih) = parse_module_flagged(toks, false);
  return m;
}

// parse_module_verbatim is `-fmt`'s entry: the same parse, with the type
// canonicalisations that lose a written spelling switched off (Par.verbatim),
// and the print-only decls the Module has no room for alongside it. What it
// returns is for PRINTING only — a `[T]` annotation and a `(T) => R` param type
// reach it spelled as written, which every compile-path `type_name == "fn"`
// dispatch would misread.
pub function parse_module_verbatim(toks: lexer.Token[]): ParsedFmt {
  let (m, t, im, fl, ih) = parse_module_flagged(toks, true);
  return ParsedFmt { pmod: m, ptraits: t, pimpls: im, pflines: fl, pinline: ih, pspans: block_spans(toks) };
}

// record_field_lines appends one FieldLines entry, and is a no-op outside a
// verbatim parse: nothing but the formatter reads the list, and the compile path
// runs on every module the compiler loads.
function record_field_lines(acc: FieldLines[], verbatim: boolean, name: string, decl_line: i32, lines: i32[]): FieldLines[] {
  if (!verbatim) {
    return acc;
  }
  return acc.append(FieldLines { name: name, decl_line: decl_line, lines: lines });
}

function parse_module_flagged(toks: lexer.Token[], verbatim: boolean): (Module, TraitDecl[], ImplDecl[], FieldLines[], FunctionInlineHint[]) {
  let p: Par = Par { toks: toks, pos: 0, no_struct: false, map_kind: 0 - 1, structnames: scan_struct_names(toks), verbatim: verbatim, depth: 0, type_errs: [], todos: [] };
  let funcs: FuncDecl[] = [];
  let trait_defaults: TraitDefault[] = [];
  let trait_reqs: TraitReq[] = [];
  let impl_infos: ImplInfo[] = [];
  let structs: StructDecl[] = [];
  let aliases: TypeAlias[] = [];
  let imports: Import[] = [];
  let top_stmts: ast.Stmt[] = [];
  let enums: EnumDecl[] = [];
  let resources: ResourceDecl[] = [];
  let exports: ExportBinding[] = [];
  let traits: TraitDecl[] = [];
  let impl_decls: ImplDecl[] = [];
  let flines: FieldLines[] = [];
  let inline_hints: FunctionInlineHint[] = [];
  let has_inline_hint: boolean = false;
  let inline_never: boolean = false;
  // Claimed `<Type>.<name>` method symbol keys, and the trait that claimed
  // each — see claim_method_name, which keeps the emitted symbol namespace
  // injective when two traits provide one method for one type.
  let mth_keys: string[] = [];
  let mth_traits: string[] = [];
  while (!p.at_end()) {
    let kw: string = p.peek_keyword();
    // Strip `pub` and re-read the keyword so `pub function`, `pub struct`
    // and `pub type` all dispatch correctly. The modifier is CAPTURED for
    // functions (stamped onto the FuncDecl below, like `async` / `fip`) so
    // the cross-module export rule can see it; struct / type / enum
    // visibility is not carried yet, so those stay unrestricted.
    let decl_pub: boolean = false;
    let decl_package: boolean = false;
    if (kw == "pub") {
      p = p.advance();
      let (mpk, mpk_p) = consume_pub_package(p);
      p = mpk_p;
      kw = p.peek_keyword();
      decl_pub = !mpk;
      decl_package = mpk;
    }
    // `@derive(Trait, …)` attribute on the following struct/enum.
    // Synthesise the field-wise trait methods (structs); enum
    // derive is a follow-up. See docs/TRAITS.md.
    if (p.peek_punct() == "@") {
      // `@import("iface", "wit-func")` binds the following body-less
      // function to a WIT import (P4). A probe past `@` distinguishes it
      // from `@derive`, which keeps the original cursor.
      let probe: Par = p.advance();
      if (probe.peek_keyword() == "import") {
        let (iar_iface, iar_wit, iar_is_import, iar_p) = parse_import_attr(p);
        p = iar_p;
        let ik: string = p.peek_keyword();
        if (ik == "pub") {
          p = p.advance();
          let (ik_pk, ik_pk_p) = consume_pub_package(p);
          p = ik_pk_p;
          ik = p.peek_keyword();
          decl_pub = !ik_pk;
          decl_package = ik_pk;
        }
        // `@import(iface, wit) async function …` — the Preview-3 async
        // import. Same contextual rule as the top-level probe.
        let i_async: boolean = false;
        let ia_p: Par = skip_decl_modifier(p, "async", "function");
        if (ia_p.pos != p.pos) {
          p = ia_p;
          ik = "function";
          i_async = true;
        }
        if (ik == "function") {
          let (ifr_func, ifr_p) = parse_func_decl(p);
          p = ifr_p;
          if (verbatim && has_inline_hint) {
            inline_hints = inline_hints.append(FunctionInlineHint { line: ifr_func.line, col: ifr_func.col, never: inline_never });
          }
          has_inline_hint = false;
          let ifn: FuncDecl = FuncDecl { ...ifr_func, import_iface: iar_iface, import_wit: iar_wit, async: i_async, is_pub: decl_pub, is_package: decl_package };
          funcs = funcs.append(ifn);
        } else if (p.peek_ident() == "resource" && p.advance().peek_ident().len() > 0) {
          // `@import(iface, wit) resource Name;` binds a WIT resource
          // handle type to its WIT identity (P5). Record it so
          // lower_defers_prepass_module can synthesize the [resource-drop].
          let rnr_line: i32 = p.peek_line();
          let rnr_col: i32 = p.peek_col();
          let (rnr_name, rnr_p) = parse_resource_decl_name(p);
          p = rnr_p;
          resources = resources.append(ResourceDecl { name: rnr_name, iface: iar_iface, wit: iar_wit, line: rnr_line, col: rnr_col });
        } else {
          top_stmts = top_stmts.append(decl_sentinel(p, "@import only applies to a function or resource declaration"));
        }
        continue;
      }
      if (probe.peek_ident() == "export") {
        // `@export("iface", "wit-name") function f(…) {…}` binds a
        // function to a WIT export (P6 — docs/WIT-BRING-YOUR-OWN.md).
        // The function is parsed normally; the binding is recorded on
        // Module.exports so the wasm emitter surfaces a core export
        // `iface#wit-name` the Go composer lifts.
        let (ear_iface, ear_wit, ear_is_import, ear_p) = parse_export_attr(p);
        p = ear_p;
        let xk: string = p.peek_keyword();
        if (xk == "pub") {
          p = p.advance();
          let (xk_pk, xk_pk_p) = consume_pub_package(p);
          p = xk_pk_p;
          xk = p.peek_keyword();
          decl_pub = !xk_pk;
          decl_package = xk_pk;
        }
        if (xk == "function") {
          let (xfr_func, xfr_p) = parse_func_decl(p);
          p = xfr_p;
          if (verbatim && has_inline_hint) {
            inline_hints = inline_hints.append(FunctionInlineHint { line: xfr_func.line, col: xfr_func.col, never: inline_never });
          }
          has_inline_hint = false;
          funcs = funcs.append(FuncDecl { ...xfr_func, is_pub: decl_pub, is_package: decl_package });
          exports = exports.append(ExportBinding { func_name: xfr_func.name, iface: ear_iface, wit: ear_wit, c_abi: false });
        }
        continue;
      }
      if (probe.peek_ident() == "inline" || probe.peek_ident() == "noinline") {
        // `@noinline` also reaches the declaration (no_inline), for
        // inline_tiny_leaves; the formatter keeps both hints.
        has_inline_hint = true;
        inline_never = probe.peek_ident() == "noinline";
        p = probe.advance();
        continue;
      }
      if (probe.peek_ident() == "try") {
        // `@try` marker (docs/TRY.md): stamp the following enum decl
        // so lowering can tell a `?`-able enum from any other
        // two-variant one. Enum-only; `@try` before anything else
        // stays parse-tolerated (dropped), as `@must_consume` does —
        // native rejects that shape and the self-host only compiles
        // native-valid programs.
        p = probe.advance();  // consume `try`
        let tmk: string = p.peek_keyword();
        if (tmk == "pub") {
          p = p.advance();
          let (tm_pk, tm_pk_p) = consume_pub_package(p);
          p = tm_pk_p;
          tmk = p.peek_keyword();
          decl_pub = !tm_pk;
          decl_package = tm_pk;
        }
        if (tmk == "enum") {
          let tmeline: i32 = p.peek_line();
          let tmecol: i32 = p.peek_col();
          let (tme_name, tme_variants, tme_type_params, tme_vlines, tme_p) = parse_enum_decl(p);
          p = tme_p;
          flines = record_field_lines(flines, verbatim, tme_name, tmeline, tme_vlines);
          enums = enums.append(EnumDecl { name: tme_name, variant_names: enum_variant_names(tme_variants), type_params: tme_type_params, line: tmeline, col: tmecol, must_consume: false, try_marker: true, is_pub: decl_pub, is_package: decl_package, module: "", instance: "" });
          let tmei: i32 = 0;
          while (tmei < tme_variants.len()) {
            structs = structs.append(tme_variants[tmei]);
            tmei = tmei + 1;
          }
          continue;
        }
        continue;
      }
      if (probe.peek_ident() == "must_consume") {
        // `@must_consume` marker (docs/MUST-CONSUME.md): stamp
        // the following struct/enum decl so the checker's E067
        // obligation walk sees the mark. `@must_consume` before
        // anything other than a struct/enum decl stays
        // parse-tolerated (dropped) — the native parser rejects
        // that shape, and the self-host only compiles
        // native-valid programs.
        p = probe.advance();  // consume `must_consume`
        let mck: string = p.peek_keyword();
        if (mck == "pub") {
          p = p.advance();
          let (mck_pk, mck_pk_p) = consume_pub_package(p);
          p = mck_pk_p;
          mck = p.peek_keyword();
          decl_pub = !mck_pk;
          decl_package = mck_pk;
        }
        let mco_p: Par = skip_decl_modifier(p, "opaque", "struct");
        if (mco_p.pos != p.pos) {
          p = mco_p;
          mck = "struct";
        }
        if (mck == "struct") {
          let (mcs_decl, mcs_lines, mcs_p) = parse_struct_decl(p);
          p = mcs_p;
          flines = record_field_lines(flines, verbatim, mcs_decl.name, mcs_decl.line, mcs_lines);
          structs = structs.append(StructDecl { ...mcs_decl, must_consume: true, is_pub: decl_pub, is_package: decl_package });
          continue;
        }
        if (mck == "enum") {
          let mceline: i32 = p.peek_line();
          let mcecol: i32 = p.peek_col();
          let (mce_name, mce_variants, mce_type_params, mce_vlines, mce_p) = parse_enum_decl(p);
          p = mce_p;
          flines = record_field_lines(flines, verbatim, mce_name, mceline, mce_vlines);
          enums = enums.append(EnumDecl { name: mce_name, variant_names: enum_variant_names(mce_variants), type_params: mce_type_params, line: mceline, col: mcecol, must_consume: true, try_marker: false, is_pub: decl_pub, is_package: decl_package, module: "", instance: "" });
          let mcei: i32 = 0;
          while (mcei < mce_variants.len()) {
            structs = structs.append(mce_variants[mcei]);
            mcei = mcei + 1;
          }
          continue;
        }
        continue;
      }
      let (dr_derives, dr_p) = parse_derive_attr(p);
      p = dr_p;
      let dk: string = p.peek_keyword();
      if (dk == "pub") {
        p = p.advance();
        let (dk_pk, dk_pk_p) = consume_pub_package(p);
        p = dk_pk_p;
        dk = p.peek_keyword();
        decl_pub = !dk_pk;
        decl_package = dk_pk;
      }
      let do_p: Par = skip_decl_modifier(p, "opaque", "struct");
      if (do_p.pos != p.pos) {
        p = do_p;
        dk = "struct";
      }
      if (dk == "struct") {
        let (dsr_decl, dsr_lines, dsr_p) = parse_struct_decl(p);
        p = dsr_p;
        flines = record_field_lines(flines, verbatim, dsr_decl.name, dsr_decl.line, dsr_lines);
        structs = structs.append(StructDecl { ...dsr_decl, derives: dr_derives, is_pub: decl_pub, is_package: decl_package });
        funcs = synth_derives(dsr_decl, dr_derives, funcs, imports_have_std_json(imports));
        continue;
      }
      if (dk == "enum") {
        let deline: i32 = p.peek_line();
        let decol: i32 = p.peek_col();
        let (denr_name, denr_variants, denr_type_params, denr_vlines, denr_p) = parse_enum_decl(p);
        p = denr_p;
        flines = record_field_lines(flines, verbatim, denr_name, deline, denr_vlines);
        enums = enums.append(EnumDecl { name: denr_name, variant_names: enum_variant_names(denr_variants), type_params: denr_type_params, line: deline, col: decol, must_consume: false, try_marker: false, is_pub: decl_pub, is_package: decl_package, module: "", instance: "" });
        let dei: i32 = 0;
        while (dei < denr_variants.len()) {
          structs = structs.append(StructDecl { ...denr_variants[dei], derives: dr_derives });
          dei = dei + 1;
        }
        // Synthesise variant-wise Display / Eq methods on the
        // enum type; they dispatch via the enum-method fallback.
        funcs = synth_enum_derives(denr_name, denr_variants, dr_derives, funcs);
        continue;
      }
      continue;
    }
    // `fip` / `fbip` are contextual modifiers on a function decl (`fip
    // function …` / `pub fbip(1) function …`), each with an optional
    // graded allowance `(n)`. All three bits are stamped: which keyword
    // was written, and the allowance, because the two consumers ask
    // different questions of them — the checker's E053 walk relaxes its
    // constructor rule for `fbip` and for a graded `fip(n)`, and the
    // IR-level E068 verification (irfipverify.fern) owns the count.
    // Recognised only when the whole modifier shape is directly followed
    // by `function`, so both names stay usable as ordinary identifiers
    // everywhere else — the same rule the native parser uses.
    // `async` is a contextual modifier on a function decl (`async
    // function …` / `pub async function …`): the WASI Preview-3
    // component-model-async export surface. It is STAMPED, not dropped —
    // `-fmt` reprints it, so losing the bit here would have the formatter
    // silently delete a marker that changes what a `-target wasm32-wasi -emit core-module`
    // build exports. Probed before the fip/fbip shape below, which then
    // reads `function` and no-ops; native treats the two as alternatives
    // the same way.
    let decl_async: boolean = false;
    let async_p: Par = skip_decl_modifier(p, "async", "function");
    if (async_p.pos != p.pos) {
      p = async_p;
      kw = "function";
      decl_async = true;
    }
    let decl_fip: boolean = false;
    let decl_fbip: boolean = false;
    let decl_fip_allowance: i32 = 0;
    let fm_name: string = p.peek_ident();
    if (fm_name == "fip" || fm_name == "fbip") {
      let fm_probe: Par = p.advance();
      let fm_grade: i32 = 0;
      if (fm_probe.peek_punct() == "(") {
        // Graded allowance `(n)`: a single integer literal, then `)`.
        let fm_num: Par = fm_probe.advance();
        if (fm_num.peek_is_literal()) {
          let fm_close: Par = fm_num.advance();
          if (fm_close.peek_punct() == ")") {
            fm_grade = util.digits_to_i32(fm_num.peek_number_text());
            fm_probe = fm_close.advance();
          }
        }
      }
      if (fm_probe.peek_keyword() == "function") {
        p = fm_probe;
        kw = "function";
        decl_fip = fm_name == "fip";
        decl_fbip = fm_name == "fbip";
        decl_fip_allowance = fm_grade;
      }
    }
    // `opaque` is a contextual modifier on a struct decl (`pub opaque
    // struct …`): the type name is exported, its representation is
    // private outside the declaring module. Enforcing that (native's
    // E021) needs the per-decl module provenance the self-host checker
    // does not carry, so the mark is parse-tolerated and dropped too —
    // accepting more than native, the sound direction for a compiler
    // that only ever sees native-valid programs.
    let opaque_p: Par = skip_decl_modifier(p, "opaque", "struct");
    if (opaque_p.pos != p.pos) {
      p = opaque_p;
      kw = "struct";
    }
    if (kw == "function") {
      let (fr_func, fr_p) = parse_func_decl(p);
      p = fr_p;
      // The nameless declaration is still recorded for the declaration gate to
      // report; the tokens it could not read are skipped.
      if (fr_func.name.len() == 0) {
        p = sync_to_top_level(p);
      }
      if (verbatim && has_inline_hint) {
        inline_hints = inline_hints.append(FunctionInlineHint { line: fr_func.line, col: fr_func.col, never: inline_never });
      }
      let fr_pub: FuncDecl = FuncDecl { ...fr_func, is_pub: decl_pub, is_package: decl_package, no_inline: has_inline_hint && inline_never };
      has_inline_hint = false;
      let fr_out: FuncDecl = fr_pub;
      if (decl_fip || decl_fbip) {
        fr_out = FuncDecl { ...fr_pub, fip: decl_fip, fbip: decl_fbip, fip_allowance: decl_fip_allowance };
      } else if (decl_async) {
        fr_out = FuncDecl { ...fr_pub, async: true };
      }
      // A free-standing receiver method (`function (p: P) scale()`) is an
      // INHERENT claim on `P.scale`: a trait impl later in the module is
      // a second provider, not a redeclaration.
      let fr_cl: MethodClaim = claim_method_name(fr_out, "", mth_keys, mth_traits);
      mth_keys = fr_cl.keys;
      mth_traits = fr_cl.traits;
      funcs = funcs.append(fr_cl.fn);
      continue;
    }
    if (kw == "struct") {
      let (sr_decl, sr_lines, sr_p) = parse_struct_decl(p);
      p = sr_p;
      flines = record_field_lines(flines, verbatim, sr_decl.name, sr_decl.line, sr_lines);
      structs = structs.append(StructDecl { ...sr_decl, is_pub: decl_pub, is_package: decl_package });
      continue;
    }
    if (kw == "type") {
      let (tr_alias, tr_p) = parse_type_alias(p);
      p = tr_p;
      aliases = aliases.append(TypeAlias { ...tr_alias, is_pub: decl_pub, is_package: decl_package });
      continue;
    }
    if (kw == "enum") {
      let eline: i32 = p.peek_line();
      let ecol: i32 = p.peek_col();
      let (enr_name, enr_variants, enr_type_params, enr_vlines, enr_p) = parse_enum_decl(p);
      p = enr_p;
      flines = record_field_lines(flines, verbatim, enr_name, eline, enr_vlines);
      enums = enums.append(EnumDecl { name: enr_name, variant_names: enum_variant_names(enr_variants), type_params: enr_type_params, line: eline, col: ecol, must_consume: false, try_marker: false, is_pub: decl_pub, is_package: decl_package, module: "", instance: "" });
      let ei: i32 = 0;
      while (ei < enr_variants.len()) {
        structs = structs.append(enr_variants[ei]);
        ei = ei + 1;
      }
      continue;
    }
    if (kw == "const") {
      // `const NAME: T = EXPR;` desugars to a zero-arg function
      // `function NAME(): T { return EXPR; }`; a bare reference
      // to NAME is lowered to a call (see emit_expr ExprIdent).
      let (cr_func, cr_p) = parse_const_decl(p);
      p = cr_p;
      funcs = funcs.append(FuncDecl { ...cr_func, is_pub: decl_pub, is_package: decl_package });
      continue;
    }
    if (kw == "import") {
      let (ir_imp, ir_bad, ir_p) = parse_import(p);
      p = ir_p;
      // An empty path with no diagnostic is `import "";`, which the loader reports.
      if (ir_imp.path.len() > 0 || ir_bad.len() == 0) {
        imports = imports.append(ir_imp);
      }
      for b in ir_bad {
        top_stmts = top_stmts.append(b);
      }
      continue;
    }
    // `pub use "path".{names…};` — a re-export directive. Recorded as a
    // re-export Import so the loader pulls in the target module and the
    // bundler redirects `facade.name` to the target's mangled symbol.
    if (kw == "use") {
      let (ur_imp, ur_bad, ur_p) = parse_pubuse(p);
      p = ur_p;
      if (ur_imp.path.len() > 0 || ur_bad.len() == 0) {
        imports = imports.append(ur_imp);
      }
      for b in ur_bad {
        top_stmts = top_stmts.append(b);
      }
      continue;
    }
    if (kw == "trait") {
      let (tpr_defaults, tpr_req, tpr_decl, tpr_bad, tpr_p) = parse_trait_decl(p);
      p = tpr_p;
      for b in tpr_bad {
        top_stmts = top_stmts.append(b);
      }
      traits = traits.append(TraitDecl { ...tpr_decl, is_pub: decl_pub, is_package: decl_package });
      let tdi: i32 = 0;
      while (tdi < tpr_defaults.len()) {
        trait_defaults = trait_defaults.append(tpr_defaults[tdi]);
        tdi = tdi + 1;
      }
      // Retain the trait's required (abstract) method set for E021 (#4347).
      // Retain a trait's requirement record when it has abstract methods
      // OR supertraits — a supertrait-only trait (`trait Num: Add + …{}`)
      // has no methods but still drives the E021 supertrait-impl check —
      // OR defaults, which a `dyn` of the trait calls.
      if (tpr_req.methods.len() > 0 || tpr_req.supertraits.len() > 0 || tpr_req.assoc_sigs.len() > 0 || tpr_req.default_sigs.len() > 0) {
        trait_reqs = trait_reqs.append(tpr_req);
      }
      continue;
    }
    if (kw == "impl") {
      let (imr_funcs, imr_trait_name, imr_impl_type, imr_type_params, imr_bounds, imr_method_names, imr_trait_spelling, imr_decl, imr_bad, imr_p) = parse_impl_decl(p);
      p = imr_p;
      for b in imr_bad {
        top_stmts = top_stmts.append(b);
      }
      impl_decls = impl_decls.append(imr_decl);
      // Under verbatim the methods live on the ImplDecl alone: adding them
      // to `funcs` too would print each one twice, once inside its block
      // and once as the free-standing receiver method it desugars to.
      let mi: i32 = 0;
      while (mi < imr_funcs.len() && !p.verbatim) {
        let im_cl: MethodClaim = claim_method_name(imr_funcs[mi], imr_trait_name, mth_keys, mth_traits);
        mth_keys = im_cl.keys;
        mth_traits = im_cl.traits;
        funcs = funcs.append(im_cl.fn);
        mi = mi + 1;
      }
      impl_infos = impl_infos.append(ImplInfo { trait_name: imr_trait_name, impl_type: imr_impl_type, type_params: imr_type_params, all_type_params: imr_decl.type_params, bounds: imr_bounds, method_names: imr_method_names, trait_spelling: imr_trait_spelling, trait_ref: imr_decl.trait_ref, assoc_names: imr_decl.assoc_names, assoc_values: imr_decl.assoc_values, trait_module: "" });
      continue;
    }
    // `resource Name;` — a top-level WIT resource-handle declaration (P5).
    // `resource` is a contextual identifier (not a keyword), so dispatch
    // here when it's followed by a name. Recorded (with an empty WIT binding
    // when no `@import` preceded it). See docs/WIT-BRING-YOUR-OWN.md.
    if (p.peek_ident() == "resource") {
      let pr: Par = p.advance();
      if (pr.peek_ident().len() > 0) {
        let rnr2_line: i32 = p.peek_line();
        let rnr2_col: i32 = p.peek_col();
        let (rnr2_name, rnr2_p) = parse_resource_decl_name(p);
        p = rnr2_p;
        resources = resources.append(ResourceDecl { name: rnr2_name, iface: "", wit: "", line: rnr2_line, col: rnr2_col });
        continue;
      }
    }
    let (stmtR_stmt, stmtR_p) = parse_stmt(p);
    // Guarantee forward progress: if a malformed top-level token (e.g.
    // a reserved keyword where a declaration / statement is expected)
    // leaves the cursor un-advanced, skip it rather than spin forever.
    if (stmtR_p.pos == p.pos) {
      p = p.advance();
      continue;
    }
    p = stmtR_p;
    top_stmts = top_stmts.append(stmtR_stmt);
  }
  // Synthesise inherited trait default methods now that the whole module
  // is parsed (a trait may be declared after the impl that uses it). For
  // each impl, every default of its trait that the impl did not provide
  // becomes a receiver method on the impl type — the same desugaring a
  // written method gets. Self-host parity with the Go checker's
  // synthesizeTraitDefaults (see docs/TRAITS.md). A trait from another module
  // is flatten.inherit_trait_defaults' job, once that module is renamed.
  let iii: i32 = 0;
  while (iii < impl_infos.len() && !verbatim) {
    let info: ImplInfo = impl_infos[iii];
    let ddi: i32 = 0;
    while (ddi < trait_defaults.len()) {
      let td: TraitDefault = trait_defaults[ddi];
      if (td.trait_name == info.trait_name) {
        if (!str_list_contains(info.method_names, td.method.name)) {
          let td_cl: MethodClaim = claim_method_name(finalize_impl_method(td.method, info.impl_type, info.type_params, info.bounds), info.trait_name, mth_keys, mth_traits);
          mth_keys = td_cl.keys;
          mth_traits = td_cl.traits;
          funcs = funcs.append(td_cl.fn);
        }
      }
      ddi = ddi + 1;
    }
    iii = iii + 1;
  }
  // Resolve loop labels here, at the single shared parse entry, so every
  // driver/backend pipeline sees break/continue tags already baked in (the
  // per-driver prep pipelines diverge, so doing it here is the universal spot).
  // Idempotent: re-running on already-resolved tags recomputes the same depth.
  //
  // settle_module follows the same reasoning: an integer literal in a float
  // destination is restamped here, at the one shared entry, so the checker and
  // every backend read a literal that already carries its settled type (#6654).
  // resolve_assoc_projections runs FIRST of the module passes: settle_module
  // and the variant-field resolver both read declared type spellings, and a
  // `Self::Item` left unresolved would reach them as an unknown nominal.
  for te in p.type_errs {
    top_stmts = top_stmts.append(te);
  }
  match (unclosed_brace(toks)) {
    Some(ub) => {
      top_stmts = top_stmts.append(ub);
    },
    None => {}
  }
  let parsed: Module = Module { funcs: funcs, structs: structs, aliases: aliases, imports: imports, top_stmts: top_stmts, enums: enums, resources: resources, exports: exports, impls: impl_infos, trait_reqs: trait_reqs, trait_decls: traits, inferred_consts: [], todo_sites: p.todos };
  if (!verbatim) {
    let inferred: string[] = unannotated_const_names(funcs);
    let nothing: string[] = [];
    parsed = substitute_const_refs(parsed, inferred_const_table(funcs, inferred, ConstTable { names: nothing, values: [] }));
    parsed = Module { ...parsed, funcs: settle_const_types(parsed.funcs, structs), inferred_consts: inferred };
    parsed = desugar_union_aliases(desugar_trait_params(parsed, trait_decl_names(traits), false));
  }
  let settled: Module = settle_module(resolve_variant_fields_module(resolve_labels_module(resolve_assoc_projections(parsed))));
  if (!verbatim) {
    settled = resolve_dyn_traits(rename_type_vars_module(settled));
  }
  return (settled, traits, impl_decls, flines, inline_hints);
}

// unclosed_brace is a `decl:` sentinel at the end of the input when the input
// ends inside a `{`, naming the innermost one left open — native's P001
// `expected "}"`. Every block parser closes a block whose `}` it cannot find
// without complaint, so the token stream is the one place a missing `}` is
// visible whichever construct it belongs to (#11315). A stream that stops at
// a lex error never reached the end, and the lex error is its diagnostic.
function unclosed_brace(toks: lexer.Token[]): Option[ast.Stmt] {
  if (toks.len() == 0) {
    return None;
  }
  let end_line: i32 = 0;
  let end_col: i32 = 0;
  if let lexer.TokEof(e) = toks[toks.len() - 1] {
    end_line = e.line;
    end_col = e.col;
  } else {
    return None;
  }
  let open_lines: i32[] = [];
  let open_cols: i32[] = [];
  let depth: i32 = 0;
  for t in toks {
    if let lexer.TokPunct(x) = t {
      if (x.text == "{") {
        open_lines = push_at(open_lines, depth, x.line);
        open_cols = push_at(open_cols, depth, x.col);
        depth = depth + 1;
      } else if (x.text == "}" && depth > 0) {
        depth = depth - 1;
      }
    }
  }
  if (depth == 0) {
    return None;
  }
  let at: string = util.i32_to_string(open_lines[depth - 1]) + ":" + util.i32_to_string(open_cols[depth - 1]);
  return Some(s_unknown_at("decl:expected \"}\" before the end of the input, to close the \"{\" at " + at, end_line, end_col));
}

// push_at writes v at index i of a stack whose live part is xs[0..i], growing
// it when i is past the end.
function push_at(xs: i32[], i: i32, v: i32): i32[] {
  if (i < xs.len()) {
    return xs.with(i, v);
  }
  return xs.append(v);
}

// merge_module flat-concatenates `into`'s decls with `from`'s:
// funcs + structs + aliases are appended. top_stmts and the
// imports list of `into` are preserved unchanged — top-level
// stmts from imported modules don't run, and resolved imports
// don't replicate. Used by callers that want to feed a multi-
// source build through the rest of the pipeline as a single
// Module (a stand-in for real cross-file namespace resolution
// until that lands).
pub function merge_module(into: Module, from: Module): Module {
  let nfuncs: FuncDecl[] = into.funcs;
  let fi: i32 = 0;
  while (fi < from.funcs.len()) {
    nfuncs = nfuncs.append(from.funcs[fi]);
    fi = fi + 1;
  }
  let nstructs: StructDecl[] = into.structs;
  let si: i32 = 0;
  while (si < from.structs.len()) {
    nstructs = nstructs.append(from.structs[si]);
    si = si + 1;
  }
  let naliases: TypeAlias[] = into.aliases;
  let ai: i32 = 0;
  while (ai < from.aliases.len()) {
    naliases = naliases.append(from.aliases[ai]);
    ai = ai + 1;
  }
  let nresources: ResourceDecl[] = into.resources;
  let ri: i32 = 0;
  while (ri < from.resources.len()) {
    nresources = nresources.append(from.resources[ri]);
    ri = ri + 1;
  }
  let nexports: ExportBinding[] = into.exports;
  let xi: i32 = 0;
  while (xi < from.exports.len()) {
    nexports = nexports.append(from.exports[xi]);
    xi = xi + 1;
  }
  let nimpls: ImplInfo[] = into.impls;
  let nii: i32 = 0;
  while (nii < from.impls.len()) {
    nimpls = nimpls.append(from.impls[nii]);
    nii = nii + 1;
  }
  let ntdecls: TraitDecl[] = into.trait_decls;
  let tdi2: i32 = 0;
  while (tdi2 < from.trait_decls.len()) {
    ntdecls = ntdecls.append(from.trait_decls[tdi2]);
    tdi2 = tdi2 + 1;
  }
  let ntreqs: TraitReq[] = into.trait_reqs;
  let nti: i32 = 0;
  while (nti < from.trait_reqs.len()) {
    ntreqs = ntreqs.append(from.trait_reqs[nti]);
    nti = nti + 1;
  }
  return resolve_assoc_projections(Module { ...into, funcs: nfuncs, structs: nstructs, aliases: naliases, enums: concat_enums(into.enums, from.enums), resources: nresources, exports: nexports, impls: nimpls, trait_reqs: ntreqs, trait_decls: ntdecls });
}

// merge_module_prefixed adds `from`'s decls to `into` with
// each decl's name renamed to `prefix + "." + name`. Models
// flat-namespace cross-file imports — a call site like
// `parser.parse_module(…)` resolves to a function literally
// named `"parser.parse_module"` in the merged module.
pub function merge_module_prefixed(into: Module, from: Module, prefix: string): Module {
  let nfuncs: FuncDecl[] = into.funcs;
  let fi: i32 = 0;
  while (fi < from.funcs.len()) {
    let fd: FuncDecl = from.funcs[fi];
    nfuncs = nfuncs.append(FuncDecl { ...fd, name: prefix + "." + fd.name, is_pub: true });
    fi = fi + 1;
  }
  let nstructs: StructDecl[] = into.structs;
  let si: i32 = 0;
  while (si < from.structs.len()) {
    let sd: StructDecl = from.structs[si];
    nstructs = nstructs.append(StructDecl { name: prefix + "." + sd.name, fields: sd.fields, type_params: sd.type_params, derives: sd.derives, line: sd.line, col: sd.col, enum_owner: sd.enum_owner, must_consume: sd.must_consume, variant_field_names: sd.variant_field_names, is_pub: true, is_package: false });
    si = si + 1;
  }
  let naliases: TypeAlias[] = into.aliases;
  let ai: i32 = 0;
  while (ai < from.aliases.len()) {
    let ad: TypeAlias = from.aliases[ai];
    naliases = naliases.append(TypeAlias { ...ad, name: prefix + "." + ad.name, is_pub: true, is_package: false });
    ai = ai + 1;
  }
  let nresources: ResourceDecl[] = into.resources;
  let ri: i32 = 0;
  while (ri < from.resources.len()) {
    let rd: ResourceDecl = from.resources[ri];
    nresources = nresources.append(ResourceDecl { ...rd, name: prefix + "." + rd.name });
    ri = ri + 1;
  }
  let nexports: ExportBinding[] = into.exports;
  let xi: i32 = 0;
  while (xi < from.exports.len()) {
    let xb: ExportBinding = from.exports[xi];
    nexports = nexports.append(ExportBinding { func_name: prefix + "." + xb.func_name, iface: xb.iface, wit: xb.wit, c_abi: xb.c_abi });
    xi = xi + 1;
  }
  let nimpls: ImplInfo[] = into.impls;
  let nii: i32 = 0;
  while (nii < from.impls.len()) {
    nimpls = nimpls.append(from.impls[nii]);
    nii = nii + 1;
  }
  let ntdecls: TraitDecl[] = into.trait_decls;
  let tdi2: i32 = 0;
  while (tdi2 < from.trait_decls.len()) {
    ntdecls = ntdecls.append(from.trait_decls[tdi2]);
    tdi2 = tdi2 + 1;
  }
  let ntreqs: TraitReq[] = into.trait_reqs;
  let nti: i32 = 0;
  while (nti < from.trait_reqs.len()) {
    ntreqs = ntreqs.append(from.trait_reqs[nti]);
    nti = nti + 1;
  }
  return resolve_assoc_projections(Module { ...into, funcs: nfuncs, structs: nstructs, aliases: naliases, enums: concat_enums(into.enums, from.enums), resources: nresources, exports: nexports, impls: nimpls, trait_reqs: ntreqs, trait_decls: ntdecls });
}

// =================== VALIDATION ====================

function main(): i32 {
  let rc: i32 = check_operator_precedence();
  if (rc != 0) {
    return rc;
  }
  rc = check_if_and_while();
  if (rc != 0) {
    return rc;
  }
  rc = check_compound_assignment();
  if (rc != 0) {
    return rc;
  }
  rc = check_slice_expressions();
  if (rc != 0) {
    return rc;
  }
  rc = check_module_functions();
  if (rc != 0) {
    return rc;
  }
  rc = check_struct_declarations();
  if (rc != 0) {
    return rc;
  }
  rc = check_struct_literals();
  if (rc != 0) {
    return rc;
  }
  rc = check_type_aliases();
  if (rc != 0) {
    return rc;
  }
  rc = check_match_statements();
  if (rc != 0) {
    return rc;
  }
  rc = check_var_annotations();
  if (rc != 0) {
    return rc;
  }
  rc = check_receiver_methods();
  if (rc != 0) {
    return rc;
  }
  rc = check_imports();
  if (rc != 0) {
    return rc;
  }
  rc = check_for_in_loops();
  if (rc != 0) {
    return rc;
  }
  rc = check_tuples();
  if (rc != 0) {
    return rc;
  }
  rc = check_break_and_continue();
  if (rc != 0) {
    return rc;
  }
  rc = check_generics();
  if (rc != 0) {
    return rc;
  }
  rc = check_lambdas();
  if (rc != 0) {
    return rc;
  }
  rc = check_fstrings();
  if (rc != 0) {
    return rc;
  }
  rc = check_qualified_names();
  if (rc != 0) {
    return rc;
  }
  rc = check_struct_patterns();
  if (rc != 0) {
    return rc;
  }

  return 0;
}

function check_operator_precedence(): i32 {
  // Source under test:
  //   let x = 1 + 2 * 3;        // x = 7
  //   let y = (1 + 2) * 3;      // y = 9
  //   return x + y;             // returns 16
  let src: string = "let x = 1 + 2 * 3; let y = (1 + 2) * 3; return x + y;";
  let toks: lexer.Token[] = lexer.tokenize(src);
  let prog: ast.Stmt[] = parse_program(toks);
  if (prog.len() != 3) {
    return 1;
  }

  // Stmt 0: let x = 1 + 2 * 3   →   StmtVar { name: "x", init: ExprBinary "+", fn_ret: "" }
  match (prog[0]) {
    ast.StmtVar(s0) => {
      if (s0.name != "x") {
        return 100;
      }
      match (s0.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 101;
          }
          // Right side should be `2 * 3` (binary with op "*").
          match (b.right) {
            ast.ExprBinary(rb) => {
              if (rb.op != "*") {
                return 102;
              }
            },
            _ => {
              return 103;
            }
          }
          // Left side should be number 1.
          match (b.left) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 104;
              }
            },
            _ => {
              return 105;
            }
          }
        },
        _ => {
          return 106;
        }
      }
    },
    _ => {
      return 107;
    }
  }

  // Stmt 1: let y = (1 + 2) * 3   →  StmtVar { name: "y", init: ExprBinary "*", fn_ret: "" }
  match (prog[1]) {
    ast.StmtVar(s1) => {
      if (s1.name != "y") {
        return 200;
      }
      match (s1.init) {
        ast.ExprBinary(b) => {
          if (b.op != "*") {
            return 201;
          }
          // Left side is the grouped `1 + 2` — should
          // be a `+` binary thanks to the parens.
          match (b.left) {
            ast.ExprBinary(lb) => {
              if (lb.op != "+") {
                return 202;
              }
            },
            _ => {
              return 203;
            }
          }
        },
        _ => {
          return 204;
        }
      }
    },
    _ => {
      return 205;
    }
  }

  // Stmt 2: return x + y   →  StmtReturn { value: ExprBinary "+" }
  match (prog[2]) {
    ast.StmtReturn(s2) => {
      match (s2.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 300;
          }
          match (b.left) {
            ast.ExprIdent(id) => {
              if (id.name != "x") {
                return 301;
              }
            },
            _ => {
              return 302;
            }
          }
          match (b.right) {
            ast.ExprIdent(id) => {
              if (id.name != "y") {
                return 303;
              }
            },
            _ => {
              return 304;
            }
          }
        },
        _ => {
          return 305;
        }
      }
    },
    _ => {
      return 306;
    }
  }

  return 0;
}

function check_if_and_while(): i32 {
  // If-statement parse: `if (x < 0) { let a = 1; } else { let b = 2; }`
  // should produce a single StmtIf with one stmt in each branch.
  let src2: string = "if (x < 0) { let a = 1; } else { let b = 2; }";
  let prog2: ast.Stmt[] = parse_program(lexer.tokenize(src2));
  if (prog2.len() != 1) {
    return 400;
  }
  match (prog2[0]) {
    ast.StmtIf(ifs) => {
      // cond: ExprBinary `<`.
      match (ifs.cond) {
        ast.ExprBinary(b) => {
          if (b.op != "<") {
            return 401;
          }
        },
        _ => {
          return 402;
        }
      }
      if (ifs.then_body.len() != 1) {
        return 403;
      }
      if (ifs.else_body.len() != 1) {
        return 404;
      }
    },
    _ => {
      return 405;
    }
  }

  // Else-less if: ensure else_body is empty.
  let src3: string = "if (true) { return 1; }";
  let prog3: ast.Stmt[] = parse_program(lexer.tokenize(src3));
  match (prog3[0]) {
    ast.StmtIf(ifs) => {
      if (ifs.else_body.len() != 0) {
        return 500;
      }
    },
    _ => {
      return 501;
    }
  }

  // While loop: `while (i < 5) { i = i + 1; }` → one StmtWhile
  // with cond ExprBinary `<` and a single-stmt body (StmtAssign).
  let src4: string = "while (i < 5) { i = i + 1; }";
  let prog4: ast.Stmt[] = parse_program(lexer.tokenize(src4));
  if (prog4.len() != 1) {
    return 600;
  }
  match (prog4[0]) {
    ast.StmtWhile(w) => {
      match (w.cond) {
        ast.ExprBinary(b) => {
          if (b.op != "<") {
            return 601;
          }
        },
        _ => {
          return 602;
        }
      }
      if (w.body.len() != 1) {
        return 603;
      }
      match (w.body[0]) {
        ast.StmtAssign(a) => {
          if (a.target != "i") {
            return 604;
          }
          match (a.value) {
            ast.ExprBinary(b) => {
              if (b.op != "+") {
                return 605;
              }
            },
            _ => {
              return 606;
            }
          }
        },
        _ => {
          return 607;
        }
      }
    },
    _ => {
      return 608;
    }
  }

  return 0;
}

function check_compound_assignment(): i32 {
  // Compound assignment desugar: `x += 1;` should parse as a
  // StmtAssign whose RHS is an ExprBinary("+", ExprIdent("x"),
  // ExprNumber("1")). Confirms the desugar fires.
  let srcC: string = "x += 1;";
  let progC: ast.Stmt[] = parse_program(lexer.tokenize(srcC));
  if (progC.len() != 1) {
    return 700;
  }
  match (progC[0]) {
    ast.StmtAssign(a) => {
      if (a.target != "x") {
        return 701;
      }
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 702;
          }
          match (b.left) {
            ast.ExprIdent(id) => {
              if (id.name != "x") {
                return 703;
              }
            },
            _ => {
              return 704;
            }
          }
          match (b.right) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 705;
              }
            },
            _ => {
              return 706;
            }
          }
        },
        _ => {
          return 707;
        }
      }
    },
    _ => {
      return 708;
    }
  }

  // `s *= 2;` → same shape with op `*`.
  let srcD: string = "s *= 2;";
  match (parse_program(lexer.tokenize(srcD))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "*") {
            return 720;
          }
        },
        _ => {
          return 721;
        }
      }
    },
    _ => {
      return 722;
    }
  }

  // Bitwise / shift compounds desugar the same way: `m &= 6;` → op `&`,
  // `f <<= 3;` → op `<<`. Mirrors the native parser's compoundOps set.
  let srcBwAnd: string = "m &= 6;";
  match (parse_program(lexer.tokenize(srcBwAnd))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "&") {
            return 730;
          }
        },
        _ => {
          return 731;
        }
      }
    },
    _ => {
      return 732;
    }
  }
  let srcBwShl: string = "f <<= 3;";
  match (parse_program(lexer.tokenize(srcBwShl))[0]) {
    ast.StmtAssign(a) => {
      match (a.value) {
        ast.ExprBinary(b) => {
          if (b.op != "<<") {
            return 733;
          }
        },
        _ => {
          return 734;
        }
      }
    },
    _ => {
      return 735;
    }
  }

  return 0;
}

function check_slice_expressions(): i32 {
  // Slice parsing: `s[1:4]` → ExprSlice with three subtrees.
  let srcS: string = "let t = s[1:4]; return 0;";
  let progS: ast.Stmt[] = parse_program(lexer.tokenize(srcS));
  match (progS[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprSlice(sl) => {
          match (sl.start) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 650;
              }
            },
            _ => {
              return 651;
            }
          }
          match (sl.end) {
            ast.ExprNumber(n) => {
              if (n.text != "4") {
                return 652;
              }
            },
            _ => {
              return 653;
            }
          }
        },
        _ => {
          return 654;
        }
      }
    },
    _ => {
      return 655;
    }
  }

  // Open-ended slice `s[1:]` — the omitted high bound sets `open_end`
  // and leaves `end` an unevaluated placeholder. It used to desugar to
  // `s.len()`, which put a SECOND copy of the base expression in the
  // tree and evaluated it twice; this now mirrors the Go parser, which
  // leaves High nil and lets the lowering supply the length.
  //
  // The base is asserted to appear exactly once, as `sl.array`.
  let srcOS: string = "let t = s[1:]; return 0;";
  let progOS: ast.Stmt[] = parse_program(lexer.tokenize(srcOS));
  match (progOS[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprSlice(sl) => {
          if (!sl.open_end) {
            return 658;
          }
          match (sl.start) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 656;
              }
            },
            _ => {
              return 657;
            }
          }
          match (sl.array) {
            ast.ExprIdent(id) => {
              if (id.name != "s") {
                return 660;
              }
            },
            _ => {
              return 661;
            }
          }
          // The placeholder must not be a call: a `.len()` here
          // is the duplicated base coming back.
          match (sl.end) {
            ast.ExprCall(_) => {
              return 663;
            },
            _ => {}
          }
        },
        _ => {
          return 664;
        }
      }
    },
    _ => {
      return 665;
    }
  }

  return 0;
}

function check_module_functions(): i32 {
  // parse_module: two function decls, no top-level stmts.
  let src5: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
  let mod: Module = parse_module(lexer.tokenize(src5));
  if (mod.funcs.len() != 2) {
    return 700;
  }
  if (mod.top_stmts.len() != 0) {
    return 701;
  }
  // add: name, 2 params, ret type i32.
  if (mod.funcs[0].name != "add") {
    return 702;
  }
  if (mod.funcs[0].params.len() != 2) {
    return 703;
  }
  if (mod.funcs[0].params[0].name != "x") {
    return 704;
  }
  if (mod.funcs[0].params[0].type_name != "i32") {
    return 705;
  }
  if (mod.funcs[0].ret_type != "i32") {
    return 706;
  }
  if (mod.funcs[0].body.len() != 1) {
    return 707;
  }
  // main: name, 0 params, ret type i32.
  if (mod.funcs[1].name != "main") {
    return 708;
  }
  if (mod.funcs[1].params.len() != 0) {
    return 709;
  }
  if (mod.funcs[1].ret_type != "i32") {
    return 710;
  }

  return 0;
}

function check_struct_declarations(): i32 {
  // parse_module: struct decls.
  let srcSt: string = "struct Point { x: i32, y: i32 } struct Empty { } function main(): i32 { return 0; }";
  let modSt: Module = parse_module(lexer.tokenize(srcSt));
  if (modSt.structs.len() != 2) {
    return 720;
  }
  if (modSt.structs[0].name != "Point") {
    return 721;
  }
  if (modSt.structs[0].fields.len() != 2) {
    return 722;
  }
  if (modSt.structs[0].fields[0].name != "x") {
    return 723;
  }
  if (modSt.structs[0].fields[0].type_name != "i32") {
    return 724;
  }
  if (modSt.structs[0].fields[1].name != "y") {
    return 725;
  }
  if (modSt.structs[1].name != "Empty") {
    return 726;
  }
  if (modSt.structs[1].fields.len() != 0) {
    return 727;
  }
  if (modSt.funcs.len() != 1) {
    return 728;
  }
  if (modSt.funcs[0].name != "main") {
    return 729;
  }

  // A trailing comma after the last struct field must NOT produce a phantom
  // empty-named field (it did — breaking struct-literal field matching in the
  // SSA build_func for any struct written with a trailing comma, e.g. Ctx).
  let srcTc: string = "struct Tc { a: i32, b: i32, } function main(): i32 { return 0; }";
  let modTc: Module = parse_module(lexer.tokenize(srcTc));
  if (modTc.structs.len() != 1) {
    return 730;
  }
  if (modTc.structs[0].fields.len() != 2) {
    return 731;
  }
  if (modTc.structs[0].fields[1].name != "b") {
    return 732;
  }

  return 0;
}

function check_struct_literals(): i32 {
  // Struct literal: `let p = Point { x: 3, y: 4 };`
  let srcL: string = "let p = Point { x: 3, y: 4 }; return 0;";
  let progL: ast.Stmt[] = parse_program(lexer.tokenize(srcL));
  match (progL[0]) {
    ast.StmtVar(v) => {
      if (v.name != "p") {
        return 800;
      }
      match (v.init) {
        ast.ExprStructLit(sl) => {
          if (sl.type_name != "Point") {
            return 801;
          }
          if (sl.field_names.len() != 2) {
            return 802;
          }
          if (sl.field_names[0] != "x") {
            return 803;
          }
          if (sl.field_names[1] != "y") {
            return 804;
          }
          match (sl.field_values[0]) {
            ast.ExprNumber(n) => {
              if (n.text != "3") {
                return 805;
              }
            },
            _ => {
              return 806;
            }
          }
        },
        _ => {
          return 807;
        }
      }
    },
    _ => {
      return 808;
    }
  }

  // Field access: `p.x`
  let srcF: string = "return p.x;";
  let progF: ast.Stmt[] = parse_program(lexer.tokenize(srcF));
  match (progF[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "x") {
            return 810;
          }
          match (fa.obj) {
            ast.ExprIdent(id) => {
              if (id.name != "p") {
                return 811;
              }
            },
            _ => {
              return 812;
            }
          }
        },
        _ => {
          return 813;
        }
      }
    },
    _ => {
      return 814;
    }
  }

  // Chained: `Point { x: 1, y: 2 }.x` should parse as
  // ExprFieldAccess { obj: ExprStructLit{...}, field: "x" }.
  let srcCh: string = "return Point { x: 1, y: 2 }.x;";
  let progCh: ast.Stmt[] = parse_program(lexer.tokenize(srcCh));
  match (progCh[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "x") {
            return 820;
          }
          match (fa.obj) {
            ast.ExprStructLit(sl) => {
              if (sl.type_name != "Point") {
                return 821;
              }
            },
            _ => {
              return 822;
            }
          }
        },
        _ => {
          return 823;
        }
      }
    },
    _ => {
      return 824;
    }
  }

  return 0;
}

function check_type_aliases(): i32 {
  // parse_module: union type aliases.
  //   pub type Shape = Circle | Square | Triangle;
  //   pub type Cell  = Empty | Wall;
  let srcTy: string = "pub type Shape = Circle | Square | Triangle; pub type Cell = Empty | Wall; struct Circle { r: i32 } function main(): i32 { return 0; }";
  let modTy: Module = parse_module(lexer.tokenize(srcTy));
  if (modTy.aliases.len() != 2) {
    return 830;
  }
  if (modTy.aliases[0].name != "Shape") {
    return 831;
  }
  if (modTy.aliases[0].variants.len() != 3) {
    return 832;
  }
  if (modTy.aliases[0].variants[0] != "Circle") {
    return 833;
  }
  if (modTy.aliases[0].variants[1] != "Square") {
    return 834;
  }
  if (modTy.aliases[0].variants[2] != "Triangle") {
    return 835;
  }
  if (modTy.aliases[1].name != "Cell") {
    return 836;
  }
  if (modTy.aliases[1].variants.len() != 2) {
    return 837;
  }
  if (modTy.aliases[1].variants[0] != "Empty") {
    return 838;
  }
  if (modTy.aliases[1].variants[1] != "Wall") {
    return 839;
  }
  // Struct + func still parse alongside aliases.
  if (modTy.structs.len() != 1) {
    return 840;
  }
  if (modTy.structs[0].name != "Circle") {
    return 841;
  }
  if (modTy.funcs.len() != 1) {
    return 842;
  }
  if (modTy.funcs[0].name != "main") {
    return 843;
  }
  // A parameterised alias, or one with an argumented member, desugars into
  // a generic enum whose variant payloads are the members, with the type
  // variable respelled as every compile-path declaration's is; `-fmt`'s
  // parse keeps the alias with its parameters and arguments as written.
  let srcGen: string = "struct Leaf[T] { v: T } struct Lit { v: i32 } type Tree[T] = Leaf[T] | Lit; type Slot = Leaf[i32] | Lit; function main(): i32 { return 0; }";
  let modGen: Module = parse_module(lexer.tokenize(srcGen));
  if (modGen.aliases.len() != 0 || modGen.enums.len() != 2) {
    return 844;
  }
  if (modGen.enums[0].name != "Tree" || modGen.enums[0].type_params.len() != 1 || modGen.enums[0].type_params[0] != "0_T") {
    return 845;
  }
  if (modGen.enums[0].variant_names.len() != 2 || modGen.enums[0].variant_names[0] != "Leaf" || modGen.enums[0].variant_names[1] != "Lit") {
    return 846;
  }
  let leaf_payload: string = "";
  let lit_payload: string = "";
  let slot_payload: string = "";
  for sd in modGen.structs {
    if (sd.enum_owner == "Tree" && sd.name == "Leaf") {
      leaf_payload = sd.fields[0].type_name;
    }
    if (sd.enum_owner == "Tree" && sd.name == "Lit") {
      lit_payload = sd.fields[0].type_name;
    }
    if (sd.enum_owner == "Slot" && sd.name == "Leaf") {
      slot_payload = sd.fields[0].type_name;
    }
  }
  if (leaf_payload != "Leaf[0_T]" || lit_payload != "Lit" || slot_payload != "Leaf[i32]") {
    return 847;
  }
  if (modGen.enums[1].name != "Slot" || modGen.enums[1].type_params.len() != 0) {
    return 848;
  }
  let fmtGen: Module = parse_module_verbatim(lexer.tokenize(srcGen)).pmod;
  if (fmtGen.aliases.len() != 2 || fmtGen.enums.len() != 0) {
    return 849;
  }
  if (fmtGen.aliases[0].type_params.len() != 1 || fmtGen.aliases[0].type_params[0] != "T") {
    return 850;
  }
  if (fmtGen.aliases[0].variant_args.len() != 2 || fmtGen.aliases[0].variant_args[0] != "T" || fmtGen.aliases[0].variant_args[1] != "") {
    return 851;
  }
  if (fmtGen.aliases[1].variant_args[0] != "i32") {
    return 852;
  }
  // A member at the wrong arity leaves the alias for the checker's E016.
  let srcBad: string = "struct Leaf[T] { v: T } struct Lit { v: i32 } type Tree = Leaf | Lit; function main(): i32 { return 0; }";
  let modBad: Module = parse_module(lexer.tokenize(srcBad));
  if (modBad.aliases.len() != 1 || modBad.enums.len() != 0) {
    return 853;
  }

  // Single-variant alias is allowed (it's just a type-rename).
  let srcTy2: string = "type Id = Inner;";
  let modTy2: Module = parse_module(lexer.tokenize(srcTy2));
  if (modTy2.aliases.len() != 1) {
    return 850;
  }
  if (modTy2.aliases[0].name != "Id") {
    return 851;
  }
  if (modTy2.aliases[0].variants.len() != 1) {
    return 852;
  }
  if (modTy2.aliases[0].variants[0] != "Inner") {
    return 853;
  }

  return 0;
}

function check_match_statements(): i32 {
  // Match statement: variant + wildcard arms with bindings.
  //   match (e) {
  //       Circle(c) => { return 1; },
  //       Square(_) => { return 2; },
  //       _ => { return 3; }
  //   }
  let srcMa: string = "match (e) { Circle(c) => { return 1; }, Square(_) => { return 2; }, _ => { return 3; } }";
  let progMa: ast.Stmt[] = parse_program(lexer.tokenize(srcMa));
  if (progMa.len() != 1) {
    return 900;
  }
  match (progMa[0]) {
    ast.StmtMatch(m) => {
      match (m.scrutinee) {
        ast.ExprIdent(id) => {
          if (id.name != "e") {
            return 901;
          }
        },
        _ => {
          return 902;
        }
      }
      if (m.arms.len() != 3) {
        return 903;
      }
      // Arm 0: Circle(c) => { return 1; }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Circle") {
            return 904;
          }
          if (pv.binding != "c") {
            return 905;
          }
        },
        _ => {
          return 906;
        }
      }
      if (m.arms[0].body.len() != 1) {
        return 907;
      }
      // Arm 1: Square(_) => { return 2; }
      match (m.arms[1].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Square") {
            return 908;
          }
          if (pv.binding != "_") {
            return 909;
          }
        },
        _ => {
          return 910;
        }
      }
      // Arm 2: _ => { return 3; }
      match (m.arms[2].pattern) {
        ast.PatWildcard(_) => {},
        _ => {
          return 911;
        }
      }
    },
    _ => {
      return 912;
    }
  }

  // Bare variant pattern (no parens, no binding): `Foo => { ... }`.
  let srcMb: string = "match (x) { Foo => { return 1; }, _ => { return 0; } }";
  let progMb: ast.Stmt[] = parse_program(lexer.tokenize(srcMb));
  match (progMb[0]) {
    ast.StmtMatch(m) => {
      if (m.arms.len() != 2) {
        return 920;
      }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "Foo") {
            return 921;
          }
          if (pv.binding != "") {
            return 922;
          }
        },
        _ => {
          return 923;
        }
      }
    },
    _ => {
      return 924;
    }
  }

  return 0;
}

function check_var_annotations(): i32 {
  // Var type annotation — user type (Shape).
  let srcTV: string = "let sh: Shape = c; return 0;";
  let progTV: ast.Stmt[] = parse_program(lexer.tokenize(srcTV));
  match (progTV[0]) {
    ast.StmtVar(v) => {
      if (v.name != "sh") {
        return 930;
      }
      if (v.type_name != "Shape") {
        return 931;
      }
    },
    _ => {
      return 932;
    }
  }

  // Var type annotation — primitive (i32).
  let srcTI: string = "let n: i32 = 7; return 0;";
  let progTI: ast.Stmt[] = parse_program(lexer.tokenize(srcTI));
  match (progTI[0]) {
    ast.StmtVar(v) => {
      if (v.name != "n") {
        return 940;
      }
      if (v.type_name != "i32") {
        return 941;
      }
    },
    _ => {
      return 942;
    }
  }

  // Var without annotation — type_name stays empty.
  let srcTU: string = "let x = 42; return 0;";
  let progTU: ast.Stmt[] = parse_program(lexer.tokenize(srcTU));
  match (progTU[0]) {
    ast.StmtVar(v) => {
      if (v.name != "x") {
        return 950;
      }
      if (v.type_name != "") {
        return 951;
      }
    },
    _ => {
      return 952;
    }
  }

  return 0;
}

function check_receiver_methods(): i32 {
  // Receiver method — `function (p: Par) advance(): Par { … }`.
  // Captures the receiver name + type alongside the method
  // name; the param list and return type behave normally.
  let srcRM: string = "function (p: Par) advance(n: i32): Par { return p; }";
  let modRM: Module = parse_module(lexer.tokenize(srcRM));
  if (modRM.funcs.len() != 1) {
    return 960;
  }
  if (modRM.funcs[0].name != "advance") {
    return 961;
  }
  if (modRM.funcs[0].receiver_name != "p") {
    return 962;
  }
  if (modRM.funcs[0].receiver_type != "Par") {
    return 963;
  }
  if (modRM.funcs[0].params.len() != 1) {
    return 964;
  }
  if (modRM.funcs[0].params[0].name != "n") {
    return 965;
  }
  if (modRM.funcs[0].ret_type != "Par") {
    return 966;
  }

  // Plain function — receiver fields stay empty.
  let srcRP: string = "function add(a: i32, b: i32): i32 { return a + b; }";
  let modRP: Module = parse_module(lexer.tokenize(srcRP));
  if (modRP.funcs.len() != 1) {
    return 970;
  }
  if (modRP.funcs[0].name != "add") {
    return 971;
  }
  if (modRP.funcs[0].receiver_name != "") {
    return 972;
  }
  if (modRP.funcs[0].receiver_type != "") {
    return 973;
  }

  // Receiver method with zero-arg param list — still parses
  // cleanly. `function (s: Scope) is_empty(): boolean { … }`.
  let srcR0: string = "function (s: Scope) is_empty(): boolean { return false; }";
  let modR0: Module = parse_module(lexer.tokenize(srcR0));
  if (modR0.funcs.len() != 1) {
    return 980;
  }
  if (modR0.funcs[0].name != "is_empty") {
    return 981;
  }
  if (modR0.funcs[0].receiver_name != "s") {
    return 982;
  }
  if (modR0.funcs[0].receiver_type != "Scope") {
    return 983;
  }
  if (modR0.funcs[0].params.len() != 0) {
    return 984;
  }

  return 0;
}

function check_imports(): i32 {
  // Top-level imports: `import "./lexer"; import "./parser";`.
  // Both get captured into mod.imports as Import entries.
  let srcIm: string = "import \"./lexer\"; import \"./parser\"; function main(): i32 { return 0; }";
  let modIm: Module = parse_module(lexer.tokenize(srcIm));
  if (modIm.imports.len() != 2) {
    return 990;
  }
  if (modIm.imports[0].path != "./lexer") {
    return 991;
  }
  if (modIm.imports[1].path != "./parser") {
    return 992;
  }
  if (modIm.funcs.len() != 1) {
    return 993;
  }
  if (modIm.funcs[0].name != "main") {
    return 994;
  }

  // Module without imports — list stays empty.
  let srcIp: string = "function main(): i32 { return 0; }";
  let modIp: Module = parse_module(lexer.tokenize(srcIp));
  if (modIp.imports.len() != 0) {
    return 1000;
  }

  return 0;
}

function check_for_in_loops(): i32 {
  // For-in loop: `for x in arr { … }` parses as StmtFor with
  // var_name + iter + body.
  let srcFor: string = "for x in arr { let y = x + 1; }";
  let progFor: ast.Stmt[] = parse_program(lexer.tokenize(srcFor));
  if (progFor.len() != 1) {
    return 1010;
  }
  match (progFor[0]) {
    ast.StmtFor(fs) => {
      if (fs.var_name != "x") {
        return 1011;
      }
      match (fs.iter) {
        ast.ExprIdent(id) => {
          if (id.name != "arr") {
            return 1012;
          }
        },
        _ => {
          return 1013;
        }
      }
      if (fs.body.len() != 1) {
        return 1014;
      }
    },
    _ => {
      return 1015;
    }
  }

  // For-in with array literal as iter.
  let srcFor2: string = "for n in [1, 2, 3] { n; }";
  let progFor2: ast.Stmt[] = parse_program(lexer.tokenize(srcFor2));
  match (progFor2[0]) {
    ast.StmtFor(fs) => {
      if (fs.var_name != "n") {
        return 1020;
      }
      match (fs.iter) {
        ast.ExprArray(a) => {
          if (a.elements.len() != 3) {
            return 1021;
          }
        },
        _ => {
          return 1022;
        }
      }
    },
    _ => {
      return 1023;
    }
  }

  return 0;
}

function check_tuples(): i32 {
  // Tuple literal: `(1, 2, 3)` parses as ExprTuple with 3
  // elements. Single-arg paren stays grouping.
  let srcTu: string = "let t = (1, 2, 3); return 0;";
  let progTu: ast.Stmt[] = parse_program(lexer.tokenize(srcTu));
  match (progTu[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprTuple(t) => {
          if (t.elements.len() != 3) {
            return 1030;
          }
          match (t.elements[0]) {
            ast.ExprNumber(n) => {
              if (n.text != "1") {
                return 1031;
              }
            },
            _ => {
              return 1032;
            }
          }
        },
        _ => {
          return 1033;
        }
      }
    },
    _ => {
      return 1034;
    }
  }

  // Grouping stays grouping when there's no comma.
  let srcGr: string = "let g = (1 + 2); return 0;";
  let progGr: ast.Stmt[] = parse_program(lexer.tokenize(srcGr));
  match (progGr[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 1040;
          }
        },
        _ => {
          return 1041;
        }
      }
    },
    _ => {
      return 1042;
    }
  }

  // Tuple with heterogeneous elements (number + string).
  let srcTH: string = "let t = (1, \"hi\"); return 0;";
  let progTH: ast.Stmt[] = parse_program(lexer.tokenize(srcTH));
  match (progTH[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprTuple(t) => {
          if (t.elements.len() != 2) {
            return 1050;
          }
          match (t.elements[1]) {
            ast.ExprString(s) => {
              if (s.value != "hi") {
                return 1051;
              }
            },
            _ => {
              return 1052;
            }
          }
        },
        _ => {
          return 1053;
        }
      }
    },
    _ => {
      return 1054;
    }
  }

  // Postfix on a tuple literal: `(1, 2, 3).0` parses as
  // ExprFieldAccess(ExprTuple(…), "0"). The postfix loop is
  // now shared across primary shapes so this round-trips.
  let srcTp: string = "return (10, 20, 30).1;";
  let progTp: ast.Stmt[] = parse_program(lexer.tokenize(srcTp));
  match (progTp[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "1") {
            return 1055;
          }
          match (fa.obj) {
            ast.ExprTuple(t) => {
              if (t.elements.len() != 3) {
                return 1056;
              }
            },
            _ => {
              return 1057;
            }
          }
        },
        _ => {
          return 1058;
        }
      }
    },
    _ => {
      return 1059;
    }
  }

  return 0;
}

function check_break_and_continue(): i32 {
  // break / continue stmts.
  let srcBC: string = "while (true) { if (x > 10) { break; } if (x < 0) { continue; } }";
  let progBC: ast.Stmt[] = parse_program(lexer.tokenize(srcBC));
  if (progBC.len() != 1) {
    return 1060;
  }
  match (progBC[0]) {
    ast.StmtWhile(w) => {
      if (w.body.len() != 2) {
        return 1061;
      }
      match (w.body[0]) {
        ast.StmtIf(ifs) => {
          match (ifs.then_body[0]) {
            ast.StmtBreak(_) => {},
            _ => {
              return 1062;
            }
          }
        },
        _ => {
          return 1063;
        }
      }
      match (w.body[1]) {
        ast.StmtIf(ifs) => {
          match (ifs.then_body[0]) {
            ast.StmtContinue(_) => {},
            _ => {
              return 1064;
            }
          }
        },
        _ => {
          return 1065;
        }
      }
    },
    _ => {
      return 1066;
    }
  }

  return 0;
}

function check_generics(): i32 {
  // Generic type-name parsing — `Map[K, V]` in a param
  // captures the full spelling as a single string.
  let srcGT: string = "function lookup(m: Map[string, i32], k: string): i32 { return 0; }";
  let modGT: Module = parse_module(lexer.tokenize(srcGT));
  if (modGT.funcs.len() != 1) {
    return 1080;
  }
  if (modGT.funcs[0].params[0].type_name != "Map[string, i32]") {
    return 1081;
  }
  if (modGT.funcs[0].params[1].type_name != "string") {
    return 1082;
  }

  // Generic ret_type spelling captured through parse_type_name.
  let srcGR: string = "function fresh(): Map[string, i32] { return null; }";
  let modGR: Module = parse_module(lexer.tokenize(srcGR));
  if (modGR.funcs[0].ret_type != "Map[string, i32]") {
    return 1083;
  }

  // Generic struct field type.
  let srcGS: string = "struct Cache { entries: Map[string, i32] } function main(): i32 { return 0; }";
  let modGS: Module = parse_module(lexer.tokenize(srcGS));
  if (modGS.structs.len() != 1) {
    return 1084;
  }
  if (modGS.structs[0].fields[0].type_name != "Map[string, i32]") {
    return 1085;
  }

  // BOUNDED type params are recorded on FuncDecl.type_params for the
  // monomorphiser; UNBOUNDED ones stay erased (empty). See docs/TRAITS.md.
  let srcBT: string = "function same[T: Eq + Display](a: T, b: T): i32 { return 0; }";
  let modBT: Module = parse_module(lexer.tokenize(srcBT));
  if (modBT.funcs[0].type_params.len() != 1) {
    return 1086;
  }
  // The compile path respells a type variable `0_<name>` so no type can
  // share its spelling (#9577); `-fmt`'s verbatim parse keeps it as written.
  if (modBT.funcs[0].type_params[0] != "0_T") {
    return 1087;
  }
  // The bound list is consumed; the param type stays the bare variable.
  if (modBT.funcs[0].params[0].type_name != "0_T") {
    return 1088;
  }
  if (parse_module_verbatim(lexer.tokenize(srcBT)).pmod.funcs[0].params[0].type_name != "T") {
    return 1001;
  }
  // A receiver's single-letter argument is a variable only when this module
  // declares no type of that name.
  let srcRV: string = "struct K { v: i32 } struct Box[T] { x: T } function (b: Box[K]) key(): K { return b.x; } function (b: Box[U]) val(): U { return b.x; }";
  let modRV: Module = parse_module(lexer.tokenize(srcRV));
  if (modRV.funcs[0].receiver_type != "Box[K]") {
    return 1002;
  }
  if (modRV.funcs[1].receiver_type != "Box[0_U]" || modRV.funcs[1].ret_type != "0_U") {
    return 1003;
  }
  let srcUT: string = "function id[T](x: T): T { return x; }";
  let modUT: Module = parse_module(lexer.tokenize(srcUT));
  if (modUT.funcs[0].type_params.len() != 0) {
    return 1089;
  }

  // Module merge — flat-concatenate decls from a "main"
  // module with an "imported" module's decls.
  let mainSrc: string = "import \"./greet\"; function main(): i32 { return hello(); }";
  let greetSrc: string = "pub function hello(): i32 { return 42; }";
  let mainMod: Module = parse_module(lexer.tokenize(mainSrc));
  let greetMod: Module = parse_module(lexer.tokenize(greetSrc));
  let merged: Module = merge_module(mainMod, greetMod);
  if (merged.funcs.len() != 2) {
    return 1090;
  }
  // Order: mainMod.funcs first, then greetMod.funcs appended.
  if (merged.funcs[0].name != "main") {
    return 1091;
  }
  if (merged.funcs[1].name != "hello") {
    return 1092;
  }
  // imports + top_stmts come from `into` only.
  if (merged.imports.len() != 1) {
    return 1093;
  }

  // Prefixed merge — same imports but each decl renamed to
  // `prefix.name`. Models cross-file flat-namespace
  // resolution: `parser.parse_module` → function literally
  // named "parser.parse_module".
  let pSrc: string = "pub function parse_module(): i32 { return 1; } pub struct Token { v: i32 }";
  let pMod: Module = parse_module(lexer.tokenize(pSrc));
  let withImp: Module = merge_module_prefixed(mainMod, pMod, "parser");
  if (withImp.funcs.len() != 2) {
    return 1094;
  }
  if (withImp.funcs[1].name != "parser.parse_module") {
    return 1095;
  }
  if (withImp.structs.len() != 1) {
    return 1096;
  }
  if (withImp.structs[0].name != "parser.Token") {
    return 1097;
  }

  // Generic var-annotation.
  let srcGV: string = "let m: Map[string, i32] = a; return 0;";
  let progGV: ast.Stmt[] = parse_program(lexer.tokenize(srcGV));
  match (progGV[0]) {
    ast.StmtVar(v) => {
      if (v.type_name != "Map[string, i32]") {
        return 1086;
      }
    },
    _ => {
      return 1087;
    }
  }

  return 0;
}

function check_lambdas(): i32 {
  // Lambda expression: `(x: i32): i32 => { return x + 1; }`.
  let srcLm: string = "let f = (x: i32): i32 => { return x + 1; }; return 0;";
  let progLm: ast.Stmt[] = parse_program(lexer.tokenize(srcLm));
  match (progLm[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 1) {
            return 1070;
          }
          if (lm.params[0].name != "x") {
            return 1071;
          }
          if (lm.params[0].type_name != "i32") {
            return 1072;
          }
          if (lm.ret_type != "i32") {
            return 1073;
          }
          if (lm.body.len() != 1) {
            return 1074;
          }
        },
        _ => {
          return 1075;
        }
      }
    },
    _ => {
      return 1076;
    }
  }

  return 0;
}

function check_fstrings(): i32 {
  // f-string desugar: `return f"x={x}";` lowers to
  //   "x=" + (x).to_string()
  // i.e. ExprBinary("+", ExprString("x="),
  //        ExprCall{ callee: ExprFieldAccess{ obj: ExprIdent("x"),
  //                                            field: "to_string" } }).
  let srcFs: string = "return f\"x={x}\";";
  let progFs: ast.Stmt[] = parse_program(lexer.tokenize(srcFs));
  match (progFs[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprBinary(b) => {
          if (b.op != "+") {
            return 1100;
          }
          match (b.left) {
            ast.ExprString(s) => {
              if (s.value != "x=") {
                return 1101;
              }
            },
            _ => {
              return 1102;
            }
          }
          match (b.right) {
            ast.ExprCall(call) => {
              match (call.callee) {
                ast.ExprFieldAccess(fa) => {
                  if (fa.field != "to_string") {
                    return 1103;
                  }
                  match (fa.obj) {
                    ast.ExprIdent(id) => {
                      if (id.name != "x") {
                        return 1104;
                      }
                    },
                    _ => {
                      return 1105;
                    }
                  }
                },
                _ => {
                  return 1106;
                }
              }
            },
            _ => {
              return 1107;
            }
          }
        },
        _ => {
          return 1108;
        }
      }
    },
    _ => {
      return 1109;
    }
  }

  // Empty f-string desugars to the empty string literal.
  match (parse_program(lexer.tokenize("return f\"\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprString(s) => {
          if (s.value != "") {
            return 1110;
          }
        },
        _ => {
          return 1111;
        }
      }
    },
    _ => {
      return 1112;
    }
  }

  // Literal-only f-string desugars to a single string literal.
  match (parse_program(lexer.tokenize("return f\"hi\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprString(s) => {
          if (s.value != "hi") {
            return 1113;
          }
        },
        _ => {
          return 1114;
        }
      }
    },
    _ => {
      return 1115;
    }
  }

  return 0;
}

function check_qualified_names(): i32 {
  // Qualified type names in struct fields: `lexer.Token` (and the
  // array form `lexer.Token[]`). Before the parse_type_name fix
  // the stray `.` stalled the field loop and the parser spun until
  // OOM — fatal for parsing parser.fern's own source. Assert the
  // field type-name strings round-trip the qualifier (and the
  // unqualified array form still works).
  let srcQ: string = "struct Par { toks: lexer.Token[], cur: parser.Node, n: i32 } function main(): i32 { return 0; }";
  let modQ: Module = parse_module(lexer.tokenize(srcQ));
  if (modQ.structs.len() != 1) {
    return 1120;
  }
  if (modQ.structs[0].name != "Par") {
    return 1121;
  }
  if (modQ.structs[0].fields.len() != 3) {
    return 1122;
  }
  if (modQ.structs[0].fields[0].type_name != "lexer.Token[]") {
    return 1123;
  }
  if (modQ.structs[0].fields[1].type_name != "parser.Node") {
    return 1124;
  }
  if (modQ.structs[0].fields[2].type_name != "i32") {
    return 1125;
  }
  if (modQ.funcs.len() != 1) {
    return 1126;
  }

  // Qualified type as a param + return type.
  let srcQ2: string = "function f(t: lexer.Token): lexer.Token { return t; }";
  let modQ2: Module = parse_module(lexer.tokenize(srcQ2));
  if (modQ2.funcs.len() != 1) {
    return 1130;
  }
  if (modQ2.funcs[0].params.len() != 1) {
    return 1131;
  }
  if (modQ2.funcs[0].params[0].type_name != "lexer.Token") {
    return 1132;
  }
  if (modQ2.funcs[0].ret_type != "lexer.Token") {
    return 1133;
  }

  // Qualified variant patterns in a match: `lexer.TokNumber(n)`.
  // Before the parse_pattern fix the stray `.` stalled the arm loop
  // and the parser spun until OOM — fatal for parsing parser.fern's
  // own `match (t) { lexer.TokX(x) => … }` statements.
  let srcM: string = "match (t) { lexer.TokNumber(n) => { x = 1; }, _ => { x = 0; } }";
  let progM: ast.Stmt[] = parse_program(lexer.tokenize(srcM));
  if (progM.len() != 1) {
    return 1140;
  }
  match (progM[0]) {
    ast.StmtMatch(m) => {
      if (m.arms.len() != 2) {
        return 1141;
      }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "lexer.TokNumber") {
            return 1142;
          }
          if (pv.binding != "n") {
            return 1143;
          }
        },
        _ => {
          return 1144;
        }
      }
      match (m.arms[1].pattern) {
        ast.PatWildcard(_) => {},
        _ => {
          return 1145;
        }
      }
    },
    _ => {
      return 1146;
    }
  }

  return 0;
}

function check_struct_patterns(): i32 {
  // Struct-pattern parameters, both spellings (#7306). The pattern head
  // desugars to a holder param of the annotated type plus a leading
  // struct-destructure StmtVar, so it reuses the existing lowering.
  //
  // Its marker carries `@pp;` ahead of the `@sd:` tag. That is the ONE
  // thing separating this prelude from the `let Point { x, y } = p;` a
  // programmer writes over a parameter, which is otherwise identical —
  // same binding list, same `@sd:` tag, same holder initialiser — and
  // without it `-fmt` folded the body's own destructure into the
  // signature (#7523). Pinning the full marker here is what keeps the two
  // distinguishable.
  //
  // The NAMED-function assertion is the essential one: before this
  // landed the parser took `{ x, y }` for the function BODY, so the failure
  // surfaced as `E070 missing return type` pointing at a signature that has
  // one. Pinning ret_type here is what makes that misparse impossible to
  // reintroduce silently.
  let srcSP: string = "function f(Point { x, y }: Point): i32 { return x * 10 + y; }";
  let modSP: Module = parse_module(lexer.tokenize(srcSP));
  if (modSP.funcs.len() != 1) {
    return 1150;
  }
  if (modSP.funcs[0].name != "f") {
    return 1151;
  }
  if (modSP.funcs[0].ret_type != "i32") {
    return 1152;
  }
  if (modSP.funcs[0].params.len() != 1) {
    return 1153;
  }
  let spHolder: string = modSP.funcs[0].params[0].name;
  if (spHolder.len() < 9 || slice_unchecked(spHolder, 0, 9) != "__ptuple_") {
    return 1154;
  }
  if (modSP.funcs[0].params[0].type_name != "Point") {
    return 1155;
  }
  if (modSP.funcs[0].body.len() != 2) {
    return 1156;
  }
  match (modSP.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "x,y") {
        return 1157;
      }
      if (v.type_name != "@pp;@sd:Point:x,y") {
        return 1158;
      }
      match (v.init) {
        ast.ExprIdent(id) => {
          if (id.name != spHolder) {
            return 1159;
          }
        },
        _ => {
          return 1160;
        }
      }
    },
    _ => {
      return 1161;
    }
  }

  // A field renamed on binding: `y` binds under its own name, `x` under `a`.
  // The marker keeps the FIELD names, the StmtVar name the BINDINGS.
  let srcSPR: string = "function g(Point { x: a, y }: Point): i32 { return a; }";
  let modSPR: Module = parse_module(lexer.tokenize(srcSPR));
  if (modSPR.funcs.len() != 1) {
    return 1165;
  }
  match (modSPR.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "a,y") {
        return 1166;
      }
      if (v.type_name != "@pp;@sd:Point:x,y") {
        return 1167;
      }
    },
    _ => {
      return 1168;
    }
  }

  // `w @ <pattern>` names the whole value: the binder BECOMES the holder,
  // so the body reads the argument under the name the source wrote.
  let srcSPA: string = "function h(w @ Point { x, y }: Point): i32 { return w.x + x + y; }";
  let modSPA: Module = parse_module(lexer.tokenize(srcSPA));
  if (modSPA.funcs.len() != 1) {
    return 1170;
  }
  if (modSPA.funcs[0].params.len() != 1) {
    return 1171;
  }
  if (modSPA.funcs[0].params[0].name != "w") {
    return 1172;
  }
  match (modSPA.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.type_name != "@pp;@sd:Point:x,y") {
        return 1173;
      }
      match (v.init) {
        ast.ExprIdent(id) => {
          if (id.name != "w") {
            return 1174;
          }
        },
        _ => {
          return 1175;
        }
      }
    },
    _ => {
      return 1176;
    }
  }

  // The LAMBDA spelling with a struct-destructuring parameter, in both
  // body forms. It needs first_param_looks_typed to tell
  // `(Point { x, y }: Point) => …` from a parenthesised struct literal.
  let srcSPL: string = "function main(): i32 { let f = (Point { x, y }: Point): i32 => { return x * 10 + y; }; let g = (Point { x, y }: Point) => x + y; return 0; }";
  let modSPL: Module = parse_module(lexer.tokenize(srcSPL));
  if (modSPL.funcs.len() != 1) {
    return 1180;
  }
  if (modSPL.funcs[0].body.len() != 3) {
    return 1181;
  }
  match (modSPL.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 1) {
            return 1182;
          }
          if (lm.ret_type != "i32") {
            return 1183;
          }
          if (lm.body.len() != 2) {
            return 1184;
          }
          match (lm.body[0]) {
            ast.StmtVar(dv) => {
              if (dv.name != "x,y") {
                return 1185;
              }
              if (dv.type_name != "@pp;@sd:Point:x,y") {
                return 1186;
              }
              match (dv.init) {
                ast.ExprIdent(id) => {
                  if (id.name != lm.params[0].name) {
                    return 1187;
                  }
                },
                _ => {
                  return 1188;
                }
              }
            },
            _ => {
              return 1189;
            }
          }
        },
        _ => {
          return 1190;
        }
      }
    },
    _ => {
      return 1191;
    }
  }
  match (modSPL.funcs[0].body[1]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 1) {
            return 1192;
          }
          if (lm.body.len() != 2) {
            return 1193;
          }
          match (lm.body[0]) {
            ast.StmtVar(dv) => {
              if (dv.type_name != "@pp;@sd:Point:x,y") {
                return 1194;
              }
            },
            _ => {
              return 1195;
            }
          }
        },
        _ => {
          return 1196;
        }
      }
    },
    _ => {
      return 1197;
    }
  }

  // A parenthesised struct LITERAL is NOT a parameter list: its colons sit
  // inside the braces, so nothing follows the `}` that could annotate a
  // pattern. It must still parse as a grouped expression.
  let srcSPN: string = "let q = (Point { x: 1, y: 2 });";
  let progSPN: ast.Stmt[] = parse_program(lexer.tokenize(srcSPN));
  if (progSPN.len() != 1) {
    return 1198;
  }
  match (progSPN[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprStructLit(_) => {},
        _ => {
          return 1199;
        }
      }
    },
    _ => {
      return 1200;
    }
  }

  return 0;
}

// subst_impl_params rewrites a PARAMETRIC impl's associated-type binding into
// the projection base's own type arguments: `type Ok = T;` on
// `impl[T] Carrier for Box[T]` is `i32` for a `Box[i32]` base. The impl's
// parameters are the bracket args of its `for` type, so unifying those against
// the base's positionally recovers each one. Only args the impl actually
// DECLARES as parameters are substituted — a concrete arg (`Pair[T, i32]`)
// names a real type and must survive. A concrete impl declares none and its
// binding is returned unchanged.
function subst_impl_params(im: ImplInfo, base: string, bound: string): string {
  if (im.all_type_params.len() == 0) {
    return bound;
  }
  let pats: string[] = type_args_of(im.impl_type);
  let args: string[] = type_args_of(base);
  if (pats.len() == 0 || pats.len() != args.len()) {
    return bound;
  }
  let ps: string[] = [];
  let cs: string[] = [];
  let k: i32 = 0;
  while (k < pats.len()) {
    if (tp_index(pats[k], im.all_type_params) >= 0) {
      ps = ps.append(pats[k]);
      cs = cs.append(args[k]);
    }
    k = k + 1;
  }
  if (ps.len() == 0) {
    return bound;
  }
  return subst_ty(bound, ps, cs);
}

// assoc_binding_for returns the type an impl bound for `base::name`, or "" when
// no impl on `base` binds that associated type. `base` is the full spelling
// (`Box[i32]`), matched on its base NAME so a parametric impl's `for` type
// (`Box[T]`) is found, and the binding is then substituted through the base's
// type arguments.
function assoc_binding_for(impls: ImplInfo[], base: string, name: string): string {
  let bare: string = util.base_type_name(base);
  for im in impls {
    if (util.base_type_name(im.impl_type) == bare) {
      let i: i32 = 0;
      while (i < im.assoc_names.len()) {
        if (im.assoc_names[i] == name && i < im.assoc_values.len()) {
          return subst_impl_params(im, base, im.assoc_values[i]);
        }
        i = i + 1;
      }
    }
  }
  return "";
}

// resolve_proj_in_type rewrites every `Base::Name` projection in the type
// spelling `t` to the type the impl of `Base` bound for `Name`. Types are
// spellings here, so a projection nested in a generic argument
// (`Option[IntBox::Item]`) is reached by the same scan rather than needing a
// tree walk. A projection whose base binds nothing is left as written — the
// E021 conformance pass is what reports that, and rewriting it to something
// invented would bury the diagnostic. See docs/ASSOCIATED-TYPES.md.
pub function resolve_proj_in_type(t: string, impls: ImplInfo[]): string {
  if (!util.contains(t, "::")) {
    return t;
  }
  let out: string = "";
  let i: i32 = 0;
  while (i < t.len()) {
    if (i + 1 < t.len() && t[i] == b':' && t[i + 1] == b':') {
      // The base is the identifier already emitted; the associated name
      // is the identifier that follows the separator. A generic base
      // carries its arguments (`Box[i32]::Ok`), so step back over the
      // bracket group before the name in front of it.
      let bs: i32 = out.len();
      if (bs > 0 && out[bs - 1] == b']') {
        let depth: i32 = 0;
        let j: i32 = bs;
        while (j > 0) {
          j = j - 1;
          if (out[j] == b']') {
            depth = depth + 1;
          }
          if (out[j] == b'[') {
            depth = depth - 1;
            if (depth == 0) {
              bs = j;
              j = 0;
            }
          }
        }
      }
      while (bs > 0 && ident_byte(out[bs - 1] as i32)) {
        bs = bs - 1;
      }
      let base: string = slice_unchecked(out, bs, out.len()) + "";
      let ns: i32 = i + 2;
      let ne: i32 = ns;
      while (ne < t.len() && ident_byte(t[ne] as i32)) {
        ne = ne + 1;
      }
      let nm: string = slice_unchecked(t, ns, ne) + "";
      let bound: string = assoc_binding_for(impls, base, nm);
      if (base.len() > 0 && nm.len() > 0 && bound.len() > 0) {
        out = slice_unchecked(out, 0, bs) + bound;
        i = ne;
        continue;
      }
    }
    out = out + (slice_unchecked(t, i, i + 1) + "");
    i = i + 1;
  }
  return out;
}

// resolve_assoc_projections rewrites every associated-type projection in the
// module's signatures and struct fields to the bound type, so nothing
// downstream — checker, lowering, backends — ever sees one. The bindings are
// syntactic (`type Item = i32;` on the impl), so unlike native this needs no
// inference and runs in the parser.
pub function resolve_assoc_projections(mod: Module): Module {
  let any: boolean = false;
  for im in mod.impls {
    if (im.assoc_names.len() > 0) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  let fs: FuncDecl[] = [];
  for f in mod.funcs {
    let ps: ast.ParamDecl[] = [];
    for pd in f.params {
      ps = ps.append(ast.ParamDecl { ...pd, type_name: resolve_proj_in_type(pd.type_name, mod.impls) });
    }
    fs = fs.append(FuncDecl {
      ...f,
      params: ps,
      ret_type: resolve_proj_in_type(f.ret_type, mod.impls),
      receiver_type: resolve_proj_in_type(f.receiver_type, mod.impls),
    });
  }
  let sds: StructDecl[] = [];
  for sd in mod.structs {
    let flds: StructFieldDecl[] = [];
    for fd in sd.fields {
      flds = flds.append(StructFieldDecl { ...fd, type_name: resolve_proj_in_type(fd.type_name, mod.impls) });
    }
    sds = sds.append(StructDecl { ...sd, fields: flds });
  }
  return Module { ...mod, funcs: fs, structs: sds };
}
