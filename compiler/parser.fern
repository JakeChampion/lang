            }
          }
          match (b.right) {
            ast.ExprCall(call) => {
              match (call.callee) {
                ast.ExprFieldAccess(fa) => {
                  if (fa.field != "to_string") {
                    return 1103;
                  }
                  match (fa.obj) {
                    ast.ExprIdent(id) => {
                      if (id.name != "x") {
                        return 1104;
                      }
                    },
                    _ => {
                      return 1105;
                    }
                  }
                },
                _ => {
                  return 1106;
                }
              }
            },
            _ => {
              return 1107;
            }
          }
        },
        _ => {
          return 1108;
        }
      }
    },
    _ => {
      return 1109;
    }
  }

  match (parse_program(lexer.tokenize("return f\"\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprString(s) => {
          if (s.value != "") {
            return 1110;
          }
        },
        _ => {
          return 1111;
        }
      }
    },
    _ => {
      return 1112;
    }
  }

  match (parse_program(lexer.tokenize("return f\"hi\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprString(s) => {
          if (s.value != "hi") {
            return 1113;
          }
        },
        _ => {
          return 1114;
        }
      }
    },
    _ => {
      return 1115;
    }
  }

  match (parse_program(lexer.tokenize("return f\"{x} {x y} {x)}\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprUnknown(u) => {
          if (u.kind != "f-string interpolation: unexpected trailing tokens after expression") {
            return 1116;
          }
          if (u.line != 1 || u.col != 17) {
            return 1117;
          }
        },
        _ => {
          return 1118;
        }
      }
    },
    _ => {
      return 1119;
    }
  }

  match (parse_program(lexer.tokenize("return f\"{x + @} {x y}\";"))[0]) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprBinary(b) => {
          if (!holds_sentinel(b.right)) {
            return 1127;
          }
        },
        _ => {
          return 1128;
        }
      }
    },
    _ => {
      return 1129;
    }
  }

  return 0;
}

function check_qualified_names(): i32 {
  let srcQ: string = "struct Par { toks: lexer.Token[], cur: parser.Node, n: i32 } function main(): i32 { return 0; }";
  let modQ: Module = parse_module(lexer.tokenize(srcQ));
  if (modQ.structs.len() != 1) {
    return 1120;
  }
  if (modQ.structs[0].name != "Par") {
    return 1121;
  }
  if (modQ.structs[0].fields.len() != 3) {
    return 1122;
  }
  if (modQ.structs[0].fields[0].type_name != "lexer.Token[]") {
    return 1123;
  }
  if (modQ.structs[0].fields[1].type_name != "parser.Node") {
    return 1124;
  }
  if (modQ.structs[0].fields[2].type_name != "i32") {
    return 1125;
  }
  if (modQ.funcs.len() != 1) {
    return 1126;
  }

  let srcQ2: string = "function f(t: lexer.Token): lexer.Token { return t; }";
  let modQ2: Module = parse_module(lexer.tokenize(srcQ2));
  if (modQ2.funcs.len() != 1) {
    return 1130;
  }
  if (modQ2.funcs[0].params.len() != 1) {
    return 1131;
  }
  if (modQ2.funcs[0].params[0].type_name != "lexer.Token") {
    return 1132;
  }
  if (modQ2.funcs[0].ret_type != "lexer.Token") {
    return 1133;
  }

  let srcM: string = "match (t) { lexer.TokNumber(n) => { x = 1; }, _ => { x = 0; } }";
  let progM: ast.Stmt[] = parse_program(lexer.tokenize(srcM));
  if (progM.len() != 1) {
    return 1140;
  }
  match (progM[0]) {
    ast.StmtMatch(m) => {
      if (m.arms.len() != 2) {
        return 1141;
      }
      match (m.arms[0].pattern) {
        ast.PatVariant(pv) => {
          if (pv.type_name != "lexer.TokNumber") {
            return 1142;
          }
          if (pv.binding != "n") {
            return 1143;
          }
        },
        _ => {
          return 1144;
        }
      }
      match (m.arms[1].pattern) {
        ast.PatWildcard(_) => {},
        _ => {
          return 1145;
        }
      }
    },
    _ => {
      return 1146;
    }
  }

  return 0;
}

function check_struct_patterns(): i32 {
  let srcSP: string = "function f(Point { x, y }: Point): i32 { return x * 10 + y; }";
  let modSP: Module = parse_module(lexer.tokenize(srcSP));
  if (modSP.funcs.len() != 1) {
    return 1150;
  }
  if (modSP.funcs[0].name != "f") {
    return 1151;
  }
  if (modSP.funcs[0].ret_type != "i32") {
    return 1152;
  }
  if (modSP.funcs[0].params.len() != 1) {
    return 1153;
  }
  let spHolder: string = modSP.funcs[0].params[0].name;
  if (spHolder.len() < 9 || slice_unchecked(spHolder, 0, 9) != "__ptuple_") {
    return 1154;
  }
  if (modSP.funcs[0].params[0].type_name != "Point") {
    return 1155;
  }
  if (modSP.funcs[0].body.len() != 2) {
    return 1156;
  }
  match (modSP.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "x,y") {
        return 1157;
      }
      if (v.type_name != "@pp;@sd:Point:x,y") {
        return 1158;
      }
      match (v.init) {
        ast.ExprIdent(id) => {
          if (id.name != spHolder) {
            return 1159;
          }
        },
        _ => {
          return 1160;
        }
      }
    },
    _ => {
      return 1161;
    }
  }

  let srcSPR: string = "function g(Point { x: a, y }: Point): i32 { return a; }";
  let modSPR: Module = parse_module(lexer.tokenize(srcSPR));
  if (modSPR.funcs.len() != 1) {
    return 1165;
  }
  match (modSPR.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.name != "a,y") {
        return 1166;
      }
      if (v.type_name != "@pp;@sd:Point:x,y") {
        return 1167;
      }
    },
    _ => {
      return 1168;
    }
  }

  let srcSPA: string = "function h(w @ Point { x, y }: Point): i32 { return w.x + x + y; }";
  let modSPA: Module = parse_module(lexer.tokenize(srcSPA));
  if (modSPA.funcs.len() != 1) {
    return 1170;
  }
  if (modSPA.funcs[0].params.len() != 1) {
    return 1171;
  }
  if (modSPA.funcs[0].params[0].name != "w") {
    return 1172;
  }
  match (modSPA.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      if (v.type_name != "@pp;@sd:Point:x,y") {
        return 1173;
      }
      match (v.init) {
        ast.ExprIdent(id) => {
          if (id.name != "w") {
            return 1174;
          }
        },
        _ => {
          return 1175;
        }
      }
    },
    _ => {
      return 1176;
    }
  }

  let srcSPL: string = "function main(): i32 { let f = (Point { x, y }: Point): i32 => { return x * 10 + y; }; let g = (Point { x, y }: Point) => x + y; return 0; }";
  let modSPL: Module = parse_module(lexer.tokenize(srcSPL));
  if (modSPL.funcs.len() != 1) {
    return 1180;
  }
  if (modSPL.funcs[0].body.len() != 3) {
    return 1181;
  }
  match (modSPL.funcs[0].body[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 1) {
            return 1182;
          }
          if (lm.ret_type != "i32") {
            return 1183;
          }
          if (lm.body.len() != 2) {
            return 1184;
          }
          match (lm.body[0]) {
            ast.StmtVar(dv) => {
              if (dv.name != "x,y") {
                return 1185;
              }
              if (dv.type_name != "@pp;@sd:Point:x,y") {
                return 1186;
              }
              match (dv.init) {
                ast.ExprIdent(id) => {
                  if (id.name != lm.params[0].name) {
                    return 1187;
                  }
                },
                _ => {
                  return 1188;
                }
              }
            },
            _ => {
              return 1189;
            }
          }
        },
        _ => {
          return 1190;
        }
      }
    },
    _ => {
      return 1191;
    }
  }
  match (modSPL.funcs[0].body[1]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprLambda(lm) => {
          if (lm.params.len() != 1) {
            return 1192;
          }
          if (lm.body.len() != 2) {
            return 1193;
          }
          match (lm.body[0]) {
            ast.StmtVar(dv) => {
              if (dv.type_name != "@pp;@sd:Point:x,y") {
                return 1194;
              }
            },
            _ => {
              return 1195;
            }
          }
        },
        _ => {
          return 1196;
        }
      }
    },
    _ => {
      return 1197;
    }
  }

  let srcSPN: string = "let q = (Point { x: 1, y: 2 });";
  let progSPN: ast.Stmt[] = parse_program(lexer.tokenize(srcSPN));
  if (progSPN.len() != 1) {
    return 1198;
  }
  match (progSPN[0]) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprStructLit(_) => {},
        _ => {
          return 1199;
        }
      }
    },
    _ => {
      return 1200;
    }
  }

  return 0;
}

function subst_impl_params(im: ImplInfo, base: string, bound: string): string {
  if (im.all_type_params.len() == 0) {
    return bound;
  }
  let pats: string[] = type_args_of(im.impl_type);
  let args: string[] = type_args_of(base);
  if (pats.len() == 0 || pats.len() != args.len()) {
    return bound;
  }
  let ps: string[] = [];
  let cs: string[] = [];
  let k: i32 = 0;
  while (k < pats.len()) {
    if (tp_index(pats[k], im.all_type_params) >= 0) {
      ps = ps.append(pats[k]);
      cs = cs.append(args[k]);
    }
    k = k + 1;
  }
  if (ps.len() == 0) {
    return bound;
  }
  return subst_ty(bound, ps, cs);
}

function assoc_binding_for(impls: ImplInfo[], base: string, name: string): string {
  let bare: string = util.base_type_name(base);
  for im in impls {
    if (util.base_type_name(im.impl_type) == bare) {
      let i: i32 = 0;
      while (i < im.assoc_names.len()) {
        if (im.assoc_names[i] == name && i < im.assoc_values.len()) {
          return subst_impl_params(im, base, im.assoc_values[i]);
        }
        i = i + 1;
      }
    }
  }
  return "";
}

pub function resolve_proj_in_type(t: string, impls: ImplInfo[]): string {
  if (!util.contains(t, "::")) {
    return t;
  }
  let out: string = "";
  let i: i32 = 0;
  while (i < t.len()) {
    if (i + 1 < t.len() && t[i] == b':' && t[i + 1] == b':') {
      let bs: i32 = out.len();
      if (bs > 0 && out[bs - 1] == b']') {
        let depth: i32 = 0;
        let j: i32 = bs;
        while (j > 0) {
          j = j - 1;
          if (out[j] == b']') {
            depth = depth + 1;
          }
          if (out[j] == b'[') {
            depth = depth - 1;
            if (depth == 0) {
              bs = j;
              j = 0;
            }
          }
        }
      }
      while (bs > 0 && ident_byte(out[bs - 1] as i32)) {
        bs = bs - 1;
      }
      let base: string = slice_unchecked(out, bs, out.len()) + "";
      let ns: i32 = i + 2;
      let ne: i32 = ns;
      while (ne < t.len() && ident_byte(t[ne] as i32)) {
        ne = ne + 1;
      }
      let nm: string = slice_unchecked(t, ns, ne) + "";
      let bound: string = assoc_binding_for(impls, base, nm);
      if (base.len() > 0 && nm.len() > 0 && bound.len() > 0) {
        out = slice_unchecked(out, 0, bs) + bound;
        i = ne;
        continue;
      }
    }
    out = out + (slice_unchecked(t, i, i + 1) + "");
    i = i + 1;
  }
  return out;
}

pub function resolve_assoc_projections(mod: Module): Module {
  let any: boolean = false;
  for im in mod.impls {
    if (im.assoc_names.len() > 0) {
      any = true;
    }
  }
  if (!any) {
    return mod;
  }
  let fs: FuncDecl[] = [];
  for f in mod.funcs {
    let ps: ast.ParamDecl[] = [];
    for pd in f.params {
      ps = ps.append(ast.ParamDecl { ...pd, type_name: resolve_proj_in_type(pd.type_name, mod.impls) });
    }
    fs = fs.append(FuncDecl {
      ...f,
      params: ps,
      ret_type: resolve_proj_in_type(f.ret_type, mod.impls),
      receiver_type: resolve_proj_in_type(f.receiver_type, mod.impls),
    });
  }
  let sds: StructDecl[] = [];
  for sd in mod.structs {
    let flds: StructFieldDecl[] = [];
    for fd in sd.fields {
      flds = flds.append(StructFieldDecl { ...fd, type_name: resolve_proj_in_type(fd.type_name, mod.impls) });
    }
    sds = sds.append(StructDecl { ...sd, fields: flds });
  }
  return Module { ...mod, funcs: fs, structs: sds };
}
