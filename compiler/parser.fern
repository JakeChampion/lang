struct ParamDestr { names: string, marker: string, synth: string, line: i32, col: i32 }

pub struct FuncDecl { stdlib: string, no_inline: boolean, name: string, receiver_name: string, receiver_type: string, receiver_own: boolean, type_params: string[], params: ast.ParamDecl[], ret_type: string, body: ast.Stmt[], line: i32, col: i32, import_iface: string, import_wit: string, all_type_params: string[], bound_traits: string[], fip: boolean, fbip: boolean, fip_allowance: i32, async: boolean, is_const: boolean, is_pub: boolean, is_package: boolean, ret_fn_ret: string, ret_fn_param_types: string, module: string, impl_trait: string, dyn_traits: string[], streams: i32[] }

pub struct StructFieldDecl { name: string, type_name: string, fn_ret: string, fn_param_types: string }

pub struct StructDecl { name: string, fields: StructFieldDecl[], type_params: string[], derives: string[], line: i32, col: i32, enum_owner: string, must_consume: boolean, variant_field_names: string[], is_pub: boolean, is_package: boolean, opaque: boolean, module: string }

pub struct TypeAlias { name: string, variants: string[], variant_args: string[], variant_lines: i32[], type_params: string[], line: i32, col: i32, is_pub: boolean, is_package: boolean, module: string }

pub struct Import { path: string, is_reexport: boolean, reexport_names: string[], alias: string, line: i32, col: i32, resolved: string }

pub function warn_unresolved_imports(mod: Module, driver: string): boolean {
  if (mod.imports.len() == 0) {
    return false;
  }
  let paths: string = "";
  let i: i32 = 0;
  while (i < mod.imports.len()) {
    if (i > 0) {
      paths = paths + ", ";
    }
    paths = paths + "\"" + mod.imports[i].path + "\"";
    i = i + 1;
  }
  eprint("warning: " + driver + " has no module loader; UNRESOLVED imports: " + paths);
  eprint("warning: any verdict below (ir/refused, exit code, eligibility bail) describes a BROKEN program, not the language.");
  eprint("warning: to judge this program use a loading driver: `fern <prog> <stdlib-root>`, or asm_load_run.");
  if (envflag.on("FERN_STRICT_IMPORTS")) {
    eprint("error: FERN_STRICT_IMPORTS refuses an unresolvable-import run");
    exit(3);
  }
  return true;
}

pub struct TodoSite { line: i32, col: i32 }

pub struct ModuleSight { module: string, imports: string[], reaches: string[] }

pub struct Module { funcs: FuncDecl[], structs: StructDecl[], aliases: TypeAlias[], imports: Import[], top_stmts: ast.Stmt[], enums: EnumDecl[], resources: ResourceDecl[], exports: ExportBinding[], impls: ImplInfo[], trait_reqs: TraitReq[], trait_decls: TraitDecl[], inferred_consts: string[], todo_sites: TodoSite[], sights: ModuleSight[] }

pub function with_stdlib_origin(mod: Module, path: string): Module {
  if (!util.is_stdlib_path(path)) {
    return mod;
  }
  path = util.without_fern_ext(path);
  let funcs: FuncDecl[] = [];
  for f in mod.funcs {
    funcs = funcs.append(FuncDecl { ...f, stdlib: path });
  }
  return Module { ...mod, funcs: funcs };
}

pub struct TraitReq { trait_name: string, type_params: string[], methods: string[], req_sigs: FuncDecl[], supertraits: string[], assoc_sigs: FuncDecl[], provided: string[], assoc_types: string[], module: string, default_sigs: FuncDecl[], visible_from: string[] }

pub struct TraitDecl { name: string, type_params: string[], supertraits: string[], methods: FuncDecl[], line: i32, col: i32, is_pub: boolean, is_package: boolean, assoc_types: string[] }

pub struct ImplDecl { trait_ref: string, type_ref: string, type_params: string[], bounds: string[], methods: FuncDecl[], line: i32, col: i32, assoc_names: string[], assoc_values: string[] }

pub struct FieldLines { name: string, decl_line: i32, lines: i32[] }

pub struct FunctionInlineHint { line: i32, col: i32, never: boolean }

pub struct ParsedFmt { pmod: Module, ptraits: TraitDecl[], pimpls: ImplDecl[], pflines: FieldLines[], pinline: FunctionInlineHint[], pspans: BlockSpans }

pub struct BlockSpans { opens: i32[], firsts: i32[], closes: i32[] }

function token_line(t: lexer.Token): i32 {
  match (t) {
    lexer.TokEof(x) => {
      return x.line;
    },
    lexer.TokNumber(x) => {
      return x.line;
    },
    lexer.TokIdent(x) => {
      return x.line;
    },
    lexer.TokKeyword(x) => {
      return x.line;
    },
    lexer.TokPunct(x) => {
      return x.line;
    },
    lexer.TokString(x) => {
      return x.line;
    },
    lexer.TokError(x) => {
      return x.line;
    },
    lexer.TokFString(x) => {
      return x.line;
    }
  }
  return 0;
}

function opens_non_block(t: lexer.Token): boolean {
  if let lexer.TokKeyword(k) = t {
    return k.name == "match" || k.name == "struct" || k.name == "enum" || k.name == "trait" || k.name == "impl";
  }
  return false;
}

function block_spans(toks: lexer.Token[]): BlockSpans {
  let opens: i32[] = [];
  let firsts: i32[] = [];
  let closes: i32[] = [];
  let stack: i32[] = [];
  let sp: i32 = 0;
  let nest: i32 = 0;
  let skip_at: i32 = -1;
  let i: i32 = 0;
  while (i < toks.len()) {
    if (skip_at < 0 && opens_non_block(toks[i])) {
      skip_at = nest;
    }
    if let lexer.TokPunct(x) = toks[i] {
      if (x.text == "(" || x.text == "[") {
        nest = nest + 1;
      } else if (x.text == ")" || x.text == "]") {
        nest = nest - 1;
      } else if (x.text == ";" && skip_at == nest) {
        skip_at = -1;
      } else if (x.text == "{") {
        let at: i32 = -1;
        if (skip_at == nest) {
          skip_at = -1;
        } else {
          let first: i32 = 0;
          if (i + 1 < toks.len()) {
            first = token_line(toks[i + 1]);
          }
          at = opens.len();
          opens = opens.append(x.line);
          firsts = firsts.append(first);
          closes = closes.append(0);
        }
        if (sp < stack.len()) {
          stack = stack.with(sp, at);
        } else {
          stack = stack.append(at);
        }
        sp = sp + 1;
      } else if (x.text == "}" && sp > 0) {
        sp = sp - 1;
        if (stack[sp] >= 0) {
          closes = closes.with(stack[sp], x.line);
        }
      }
    }
    i = i + 1;
  }
  return BlockSpans { opens: opens, firsts: firsts, closes: closes };
}

pub struct ResourceDecl { name: string, iface: string, wit: string, line: i32, col: i32 }

pub struct ExportBinding { func_name: string, iface: string, wit: string, c_abi: boolean }

pub struct EnumDecl { name: string, variant_names: string[], type_params: string[], line: i32, col: i32, must_consume: boolean, try_marker: boolean, is_pub: boolean, is_package: boolean, module: string, instance: string, visible_from: string[] }

function enum_variant_names(variants: StructDecl[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < variants.len()) {
    out = out.append(variants[i].name);
    i = i + 1;
  }
  return out;
}

function concat_enums(a: EnumDecl[], b: EnumDecl[]): EnumDecl[] {
  let out: EnumDecl[] = a;
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

function e_number(text: string, suffix: string, is_float: boolean): ast.Expr {
  return ast.ExprNumber { text: text, suffix: suffix, raw: "", is_float: is_float, line: 0, col: 0 };
}

function e_spelled_at(text: string, suffix: string, raw: string, is_float: boolean, line: i32, col: i32): ast.Expr {
  return ast.ExprNumber { text: text, suffix: suffix, raw: raw, is_float: is_float, line: line, col: col };
}

function e_unit_at(line: i32, col: i32): ast.Expr {
  return ast.ExprNumber { text: "0", suffix: "", raw: "()", is_float: false, line: line, col: col };
}

pub function discard_name(name: string, line: i32, col: i32, nth: i32): string {
  if (name != "_") {
    return name;
  }
  return "__discard_" + util.i32_to_string(line) + "_" + util.i32_to_string(col) + "_" + util.i32_to_string(nth);
}

pub function is_unit_literal(n: ast.ExprNumber): boolean {
  return n.raw == "()";
}

pub function is_quoted_literal(n: ast.ExprNumber): boolean {
  return n.raw.len() > 0 && (n.raw[0] == b'\'' || n.raw.len() > 1 && n.raw[0] == b'b' && n.raw[1] == b'\'');
}

pub function is_cast_op(op: string): boolean {
  return op.len() > 3 && slice_unchecked(op, 0, 3) == "as_";
}

pub const BARE_RETURN: string = "bare-return";

pub const REPORTED: string = "reported";

pub function bare_return(e: ast.Expr): boolean {
  if let ast.ExprUnknown(u) = e {
    return u.kind == BARE_RETURN;
  }
  return is_unit_expr(e);
}

pub function is_unit_expr(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return is_unit_literal(n);
    },
    _ => {
      return false;
    }
  }
  return false;
}

