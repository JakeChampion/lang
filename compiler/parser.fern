function synth_enum_ord(ename: string, self_ty: string, variants: StructDecl[]): FuncDecl {
  let arms: ast.MatchArm[] = [];
  for i in 0..variants.len() {
    let vi = variants[i];
    let inner: ast.MatchArm[] = [];
    for j in 0..variants.len() {
      let vj = variants[j];
      let obn = vj.fields.len();
      let ibody: ast.Stmt[] = [];
      if (j < i) {
        ibody = [s_return(e_number("1", "", false))];
      } else {
        if (j > i) {
          ibody = [s_return(e_binary("-", e_number("0", "", false), e_number("1", "", false)))];
        } else {
          if (vi.fields.len() > 0) {
            let cstmts: ast.Stmt[] = [];
